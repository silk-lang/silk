//! The edges a revisable semantic store records from its units to what they consumed.
//!
//! # When to use
//! Use [`DependencyGraph`] in every semantic store. A store that a later source revision can
//! update records into it; a one-shot store's graph records nothing and allocates nothing, since
//! [`record`], [`startRun`] and [`finishRun`] return at once.
//!
//! # Details
//! A unit is one interned query key. A dependee is something a unit consumes: a source file, or
//! a typed source input, or another unit's result. Each consumption is one edge, linked into its depender's list of
//! consumed dependees, and from the first invalidation on into its dependee's list of dependers.
//!
//! An update marks every depender of a changed source file or input outdated, and then every
//! transitive depender of an outdated unit's result. Outdated means unverified, not stale: the
//! marking bounds which units a demand must verify, and every unit outside it stays current
//! without a check.
//!
//! The graph counts revisions. A changed dependee records the revision it changed in, and a unit
//! records the revision its answer was last verified in and the one it last changed in. A rerun
//! whose answer has the same fingerprint as the one it replaces keeps its changed revision, so
//! the units that read it can still be verified: an outdated unit is current again when no
//! dependee changed after it was last verified, checking its dependees in the order it consumed
//! them and bringing each unit result up to date first.
//!
//! # Gotchas
//! Units use stable declaration handles. Semantic reconciliation observes handle survival before
//! cache reuse; input changes seed this graph without a blanket changed-module sweep.

import semantic.ContentHash {ContentHash}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.core.option {Option}
import silk.core.ownership {Copy}
import silk.num.u32
import silk.num.usize
import silk.collections.list {List}

/// Where a unit stands against the store's current revision.
pub enum UnitState {
  /// Never completed, or its last run did not complete.
  Absent,
  /// Its result reflects the current revision.
  UpToDate,
  /// Something it consumed changed, so it reruns on its next demand.
  Outdated,
}

/// One thing a unit can consume.
pub union Dependee {
  /// The presence and exact bytes of one module, by the store's module ordinal.
  SourceFile {pub module: usize},
  /// One typed consumed source input; module remains visible to source discovery.
  SourceInput {pub input: usize, pub module: usize},
  /// The completed result of another unit.
  UnitResult {pub unit: usize},
}

impl Copy for Dependee {}

struct UnitRecord {
  state: UnitState,
  // The newest edge this unit recorded, or `u32.MAX`.
  firstEdge: u32,
  // The run whose edges the unit currently holds, for recording deduplication.
  runId: u32,
  // The traversal that last visited this unit.
  visited: u32,
  // The revisions in which the unit's answer was last verified and last changed.
  verifiedAt: u32,
  changedAt: u32,
  // The exact hash of the unit's last completed answer, when it has one.
  fingerprinted: bool,
  fingerprint: ContentHash,
}

impl Copy for UnitRecord {}

enum DependeeKind { File, Input, Result }

struct DependeeRecord {
  // The newest edge that consumes this dependee, or `u32.MAX`; kept once the graph is `linked`.
  head: u32,
  // The unit and run that last recorded this dependee.
  lastUnit: u32,
  lastRun: u32,
  // The dependee's key: a module ordinal for a source file, otherwise a unit.
  kind: DependeeKind,
  subject: u32,
  module: u32,
  // The revision in which a source file or input last changed.
  changedAt: u32,
}

impl Copy for DependeeRecord {}

// One consumption. `nextOfDepender` links the depender's consumed dependees. A free edge has no
// dependee and chains the free list through `nextOfDepender`.
struct Edge {
  dependee: u32,
  nextOfDepender: u32,
}

impl Copy for Edge {}

// The dependee side of the edge at the same index: `next` and `prev` link the dependee's dependers.
// Only an invalidation walks them, and a store that is never revised in its process, as a command
// line build's is not, never invalidates, so they are built on the first one (`link`).
struct Link {
  depender: u32,
  next: u32,
  prev: u32,
}

impl Copy for Link {}

/// What one revisable store recorded, with its update counters.
pub struct DependencyGraph {
  // Whether this store can be revised; a one-shot store's recorder does nothing.
  recording: bool,
  units: List<UnitRecord>,
  dependees: List<DependeeRecord>,
  // Dependee indices by module ordinal and by unit, or `u32.MAX`.
  sourceInputs: List<u32>,
  sourceFiles: List<u32>,
  unitResults: List<u32>,
  edges: List<Edge>,
  // The dependee side of each edge once `linked`; empty before.
  links: List<Link>,
  linked: bool,
  free: u32,
  runs: u32,
  traversals: u32,
  revision: u32,
  pending: List<u32>,
  edgesRecorded: usize,
  edgesDeduplicated: usize,
  markedOutdated: usize,
  fingerprinted: usize,
  unchanged: usize,
  verified: usize,
  // The unit whose records a capture collects (`beginCapture`), or `u32.MAX`, and what it has
  // recorded since, repeats included.
  capturing: u32,
  captured: List<Dependee>,
}

/// One open capture: the unit the enclosing capture collected for, and where this one began.
pub struct Capture {
  outer: u32,
  start: usize,
}

impl Copy for Capture {}

/// The counters of one graph, for `silk build --stats`.
pub struct Counters {
  pub units: usize,
  pub dependees: usize,
  pub edges: usize,
  pub freeEdges: usize,
  pub edgesRecorded: usize,
  pub edgesDeduplicated: usize,
  pub markedOutdated: usize,
  /// Completed runs whose answer has an exact fingerprint.
  pub fingerprinted: usize,
  /// Reruns whose answer hashed equal to the answer they replaced.
  pub unchanged: usize,
  /// Outdated units verified current without rerunning.
  pub verified: usize,
  /// Bytes held by the graph's tables, by capacity.
  pub bytes: usize,
}

/// Creates an empty graph that records when `recording` is true, for a store that can be revised.
pub fn make(recording: bool) -> DependencyGraph {
  return DependencyGraph {
    recording: recording,
    units: List<UnitRecord>.make(),
    dependees: List<DependeeRecord>.make(),
    sourceInputs: List<u32>.make(),
    sourceFiles: List<u32>.make(),
    unitResults: List<u32>.make(),
    edges: List<Edge>.make(),
    links: List<Link>.make(),
    linked: false,
    free: u32.MAX,
    runs: 0,
    traversals: 0,
    revision: 0,
    pending: List<u32>.make(),
    edgesRecorded: usize.ZERO,
    edgesDeduplicated: usize.ZERO,
    markedOutdated: usize.ZERO,
    fingerprinted: usize.ZERO,
    unchanged: usize.ZERO,
    verified: usize.ZERO,
    capturing: u32.MAX,
    captured: List<Dependee>.make(),
  }
}

effect fn unitSlot(graph: &mut DependencyGraph, unit: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  while List.length(&graph.units) <= unit {
    run List.append(&mut graph.units, UnitRecord {state: UnitState.Absent, firstEdge: u32.MAX, runId: u32.MAX, visited: 0, verifiedAt: 0, changedAt: 0,
      fingerprinted: false, fingerprint: ContentHash {high: 0, low: 0}})
  }
  return ()
}

/// Whether this graph records, that is, whether its store can be revised.
pub fn recording(graph: &DependencyGraph) -> bool {
  return graph.recording
}

/// Whether a completed answer of `unit` reflects the current revision. Every completed answer of
/// a store that is never revised does.
pub fn current(graph: &DependencyGraph, unit: usize) -> bool {
  if !graph.recording { return true }
  return state(graph, unit) == UnitState.UpToDate
}

/// The state of `unit`; a unit the graph never saw is absent.
pub fn state(graph: &DependencyGraph, unit: usize) -> UnitState {
  if unit >= List.length(&graph.units) { return UnitState.Absent }
  return List.get(&graph.units, unit).state
}

fn subjectOf(dependee: Dependee) -> usize {
  return match &dependee {
    Dependee.SourceFile {module} => module
    Dependee.SourceInput {input, ..} => input
    Dependee.UnitResult {unit} => unit
  }
}

fn kindOf(dependee: Dependee) -> DependeeKind {
  return match &dependee {
    Dependee.SourceFile {..} => DependeeKind.File
    Dependee.SourceInput {..} => DependeeKind.Input
    Dependee.UnitResult {..} => DependeeKind.Result
  }
}

effect fn dependeeIndex(graph: &mut DependencyGraph, dependee: Dependee) -> usize ! OutOfMemoryError ? &mut Allocator {
  let found = knownDependee(&graph.*, dependee)
  if found != usize.MAX { return found }
  let table = subjectOf(dependee)
  let kind = kindOf(dependee)
  let module = match &dependee { Dependee.SourceInput {module, ..} => module _ => usize.ZERO }
  let created = List.length(&graph.dependees)
  run List.append(&mut graph.dependees, DependeeRecord {head: u32.MAX, lastUnit: u32.MAX, lastRun: u32.MAX,
    kind: kind, subject: usize.toU32(table), module: usize.toU32(module), changedAt: 0})
  if kind == DependeeKind.Input {
    while List.length(&graph.sourceInputs) <= table { run List.append(&mut graph.sourceInputs, u32.MAX) }
    List.set(&mut graph.sourceInputs, table, usize.toU32(created))
  } else if kind == DependeeKind.File {
    while List.length(&graph.sourceFiles) <= table { run List.append(&mut graph.sourceFiles, u32.MAX) }
    List.set(&mut graph.sourceFiles, table, usize.toU32(created))
  } else {
    while List.length(&graph.unitResults) <= table { run List.append(&mut graph.unitResults, u32.MAX) }
    List.set(&mut graph.unitResults, table, usize.toU32(created))
  }
  return created
}

// The dependee record of `dependee` when one exists, or `usize.MAX`.
fn knownDependee(graph: &DependencyGraph, dependee: Dependee) -> usize {
  let table = subjectOf(dependee)
  let mut found = u32.MAX
  if kindOf(dependee) == DependeeKind.Input {
    if table < List.length(&graph.sourceInputs) { found = List.get(&graph.sourceInputs, table) }
  } else if kindOf(dependee) == DependeeKind.File {
    if table < List.length(&graph.sourceFiles) { found = List.get(&graph.sourceFiles, table) }
  } else if table < List.length(&graph.unitResults) {
    found = List.get(&graph.unitResults, table)
  }
  if found == u32.MAX { return usize.MAX }
  return u32.toUsize(found)
}

/// Starts a run of `unit`: removes the edges its previous run recorded, so the run records a
/// fresh set. Edges are never diffed against the previous set.
pub effect fn startRun(graph: &mut DependencyGraph, unit: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  if !graph.recording { return () }
  run unitSlot(&mut graph.*, unit)
  let mut edge = List.get(&graph.units, unit).firstEdge
  while edge != u32.MAX {
    let at = u32.toUsize(edge)
    let removed = List.get(&graph.edges, at)
    if graph.linked { unlink(&mut graph.*, at) }
    let free = graph.free
    let mut edges = List.asMutSlice(&mut graph.edges)
    edges[at] = Edge {dependee: u32.MAX, nextOfDepender: free}
    graph.free = edge
    edge = removed.nextOfDepender
  }
  graph.runs = graph.runs + 1
  let runs = graph.runs
  let mut units = List.asMutSlice(&mut graph.units)
  units[unit].firstEdge = u32.MAX
  units[unit].runId = runs
  return ()
}

// Removes one edge from its dependee's list of dependers.
fn unlink(graph: &mut DependencyGraph, at: usize) -> () {
  let dependee = List.get(&graph.edges, at).dependee
  let removed = List.get(&graph.links, at)
  let mut links = List.asMutSlice(&mut graph.links)
  if removed.next != u32.MAX { links[u32.toUsize(removed.next)].prev = removed.prev }
  if removed.prev != u32.MAX {
    links[u32.toUsize(removed.prev)].next = removed.next
  } else {
    let mut dependees = List.asMutSlice(&mut graph.dependees)
    dependees[u32.toUsize(dependee)].head = removed.next
  }
  links[at] = Link {depender: u32.MAX, next: u32.MAX, prev: u32.MAX}
  return ()
}

// Puts the edge at `at`, of `depender`, first in its dependee's list of dependers.
fn linkEdge(graph: &mut DependencyGraph, at: usize, depender: u32) -> () {
  let target = u32.toUsize(List.get(&graph.edges, at).dependee)
  let head = List.get(&graph.dependees, target).head
  let created = usize.toU32(at)
  let mut links = List.asMutSlice(&mut graph.links)
  links[at] = Link {depender: depender, next: head, prev: u32.MAX}
  if head != u32.MAX { links[u32.toUsize(head)].prev = created }
  let mut dependees = List.asMutSlice(&mut graph.dependees)
  dependees[target].head = created
  return ()
}

// Builds the dependee side of every edge, once, before the first invalidation walks it.
effect fn link(graph: &mut DependencyGraph) -> () ! OutOfMemoryError ? &mut Allocator {
  if graph.linked { return () }
  let count = List.length(&graph.edges)
  run List.reserveExact(&mut graph.links, count)
  while List.length(&graph.links) < count {
    run List.append(&mut graph.links, Link {depender: u32.MAX, next: u32.MAX, prev: u32.MAX})
  }
  let mut unit = usize.ZERO
  while unit < List.length(&graph.units) {
    let mut edge = List.get(&graph.units, unit).firstEdge
    while edge != u32.MAX {
      linkEdge(&mut graph.*, u32.toUsize(edge), usize.toU32(unit))
      edge = List.get(&graph.edges, u32.toUsize(edge)).nextOfDepender
    }
    unit = unit + usize.ONE
  }
  graph.linked = true
  return ()
}

/// Records that the running `unit` consumed `dependee`. A repeat within one run records nothing.
pub effect fn record(graph: &mut DependencyGraph, unit: usize, dependee: Dependee) -> () ! OutOfMemoryError ? &mut Allocator {
  if !graph.recording { return () }
  if usize.toU32(unit) == graph.capturing { run List.append(&mut graph.captured, dependee) }
  run unitSlot(&mut graph.*, unit)
  let target = run dependeeIndex(&mut graph.*, dependee)
  let owner = List.get(&graph.units, unit)
  let known = List.get(&graph.dependees, target)
  if known.lastUnit == usize.toU32(unit) && known.lastRun == owner.runId {
    graph.edgesDeduplicated = graph.edgesDeduplicated + usize.ONE
    return ()
  }
  let edge = Edge {dependee: usize.toU32(target), nextOfDepender: owner.firstEdge}
  let mut at = List.length(&graph.edges)
  if graph.free != u32.MAX {
    at = u32.toUsize(graph.free)
    graph.free = List.get(&graph.edges, at).nextOfDepender
    List.set(&mut graph.edges, at, edge)
  } else {
    if graph.linked { run List.append(&mut graph.links, Link {depender: u32.MAX, next: u32.MAX, prev: u32.MAX}) }
    run List.append(&mut graph.edges, edge)
  }
  let created = usize.toU32(at)
  if graph.linked { linkEdge(&mut graph.*, at, usize.toU32(unit)) }
  let mut dependees = List.asMutSlice(&mut graph.dependees)
  dependees[target].lastUnit = usize.toU32(unit)
  dependees[target].lastRun = owner.runId
  let mut units = List.asMutSlice(&mut graph.units)
  units[unit].firstEdge = created
  graph.edgesRecorded = graph.edgesRecorded + usize.ONE
  return ()
}

/// Completes a run of `unit`: its result reflects the current revision. `fingerprint` is the
/// exact hash of the answer, absent when the answer has none; it replaces the previous run's.
/// Returns whether the previous run's answer had the same fingerprint, so this run changed nothing.
pub effect fn finishRun(graph: &mut DependencyGraph, unit: usize, fingerprint: Option<ContentHash>) -> bool
! OutOfMemoryError ? &mut Allocator {
  if !graph.recording { return false }
  run unitSlot(&mut graph.*, unit)
  let previous = List.get(&graph.units, unit)
  let mut unchanged = false
  let revision = graph.revision
  let mut units = List.asMutSlice(&mut graph.units)
  units[unit].state = UnitState.UpToDate
  units[unit].verifiedAt = revision
  match &fingerprint {
    Option<ContentHash>.Some {value} => {
      unchanged = previous.fingerprinted && ContentHash.equals(previous.fingerprint, value)
      units[unit].fingerprinted = true
      units[unit].fingerprint = value
      graph.fingerprinted = graph.fingerprinted + usize.ONE
    }
    Option<ContentHash>.None => { units[unit].fingerprinted = false }
  }
  if unchanged {
    graph.unchanged = graph.unchanged + usize.ONE
  } else {
    let mut changed = List.asMutSlice(&mut graph.units)
    changed[unit].changedAt = revision
  }
  return unchanged
}

/// The fingerprint of `unit`'s last completed answer, absent when it has none.
pub fn fingerprintOf(graph: &DependencyGraph, unit: usize) -> Option<ContentHash> {
  if unit >= List.length(&graph.units) { return Option<ContentHash>.none() }
  let record = List.get(&graph.units, unit)
  if !record.fingerprinted { return Option<ContentHash>.none() }
  return Option<ContentHash>.some(record.fingerprint)
}

/// The newest edge `unit` recorded, or `usize.MAX`.
pub fn firstEdgeOf(graph: &DependencyGraph, unit: usize) -> usize {
  if unit >= List.length(&graph.units) { return usize.MAX }
  return edgeOrNone(List.get(&graph.units, unit).firstEdge)
}

/// The edge its depender recorded before `edge`, or `usize.MAX`.
pub fn nextEdgeOf(graph: &DependencyGraph, edge: usize) -> usize {
  return edgeOrNone(List.get(&graph.edges, edge).nextOfDepender)
}

fn edgeOrNone(edge: u32) -> usize {
  if edge == u32.MAX { return usize.MAX }
  return u32.toUsize(edge)
}

/// Starts a traversal in which every unit is unvisited.
pub fn beginTraversal(graph: &mut DependencyGraph) -> () {
  graph.traversals = graph.traversals + 1
  return ()
}

/// Marks `unit` visited in the current traversal, and reports whether it was unvisited. A unit
/// the graph never saw cannot be visited.
pub fn visit(graph: &mut DependencyGraph, unit: usize) -> bool {
  if unit >= List.length(&graph.units) { return false }
  if List.get(&graph.units, unit).visited == graph.traversals { return false }
  let traversal = graph.traversals
  let mut units = List.asMutSlice(&mut graph.units)
  units[unit].visited = traversal
  return true
}

/// The dependee one edge consumes.
pub fn dependeeOf(graph: &DependencyGraph, edge: usize) -> Dependee {
  let record = List.get(&graph.dependees, u32.toUsize(List.get(&graph.edges, edge).dependee))
  if record.kind == DependeeKind.Input { return Dependee.SourceInput {input: u32.toUsize(record.subject), module: u32.toUsize(record.module)} }
  if record.kind == DependeeKind.File { return Dependee.SourceFile {module: u32.toUsize(record.subject)} }
  return Dependee.UnitResult {unit: u32.toUsize(record.subject)}
}

/// Marks every depender of a changed source file outdated, and every transitive depender of those.
pub effect fn sourceChanged(graph: &mut DependencyGraph, module: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  return run changed(&mut graph.*, Dependee.SourceFile {module: module})
}

/// Invalidates only consumers of this changed typed observation.
pub effect fn inputChanged(graph: &mut DependencyGraph, input: usize, module: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  return run changed(&mut graph.*, Dependee.SourceInput {input: input, module: module})
}

effect fn changed(graph: &mut DependencyGraph, dependee: Dependee) -> () ! OutOfMemoryError ? &mut Allocator {
  let target = knownDependee(&graph.*, dependee)
  if target == usize.MAX { return () }
  run link(&mut graph.*)
  let revision = graph.revision
  let mut stamped = List.asMutSlice(&mut graph.dependees)
  stamped[target].changedAt = revision
  let mut edge = List.get(&graph.dependees, target).head
  while edge != u32.MAX {
    let current = List.get(&graph.links, u32.toUsize(edge))
    run markOutdated(&mut graph.*, u32.toUsize(current.depender))
    edge = current.next
  }
  return ()
}

/// Marks `unit` outdated, and every transitive depender of its result.
pub effect fn markOutdated(graph: &mut DependencyGraph, unit: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  // Reserve before the first state mutation: retry cannot skip a half-propagated unit.
  // Each edge can be enqueued at most once as each current unit changes state once.
  run link(&mut graph.*)
  run List.reserve(&mut graph.pending, List.length(&graph.edges) + usize.ONE)
  run List.append(&mut graph.pending, usize.toU32(unit))
  while List.length(&graph.pending) > usize.ZERO {
    let last = List.length(&graph.pending) - usize.ONE
    let changed = u32.toUsize(List.remove(&mut graph.pending, last))
    // An absent unit has no result to pass on; an outdated one already passed it on.
    if state(&graph.*, changed) == UnitState.UpToDate {
      let mut units = List.asMutSlice(&mut graph.units)
      units[changed].state = UnitState.Outdated
      graph.markedOutdated = graph.markedOutdated + usize.ONE
      let result = knownDependee(&graph.*, Dependee.UnitResult {unit: changed})
      if result != usize.MAX {
        let mut edge = List.get(&graph.dependees, result).head
        while edge != u32.MAX {
          let current = List.get(&graph.links, u32.toUsize(edge))
          run List.append(&mut graph.pending, current.depender)
          edge = current.next
        }
      }
    }
  }
  return ()
}

/// Starts collecting every dependee `unit` records, a repeat its run already holds included, so a
/// computation whose result is reused by another unit can record the same edges there.
pub fn beginCapture(graph: &mut DependencyGraph, unit: usize) -> Capture {
  let mark = Capture {outer: graph.capturing, start: List.length(&graph.captured)}
  graph.capturing = u32.MAX
  if graph.recording && unit != usize.MAX { graph.capturing = usize.toU32(unit) }
  return mark
}

/// Ends the capture `mark` began and returns what its unit recorded meanwhile. An enclosing
/// capture of the same unit keeps those records too.
pub effect fn endCapture(graph: &mut DependencyGraph, mark: Capture) -> List<Dependee> ! OutOfMemoryError ? &mut Allocator {
  let listed = List.asSlice(&graph.captured)
  let mut recorded = List<Dependee>.make()
  run List.reserveExact(&mut recorded, listed.length - mark.start)
  let mut at = mark.start
  while at < listed.length {
    run List.append(&mut recorded, listed[at])
    at = at + usize.ONE
  }
  if mark.outer != graph.capturing { List.truncate(&mut graph.captured, mark.start) }
  graph.capturing = mark.outer
  return move recorded
}

/// The store's current revision.
pub fn revision(graph: &DependencyGraph) -> u32 {
  return graph.revision
}

/// Starts a new revision: dependees changed from now on change after every unit verified so far.
pub fn beginRevision(graph: &mut DependencyGraph) -> () {
  graph.revision = graph.revision + 1
  return ()
}

/// Whether one edge of `unit` consumed a source file or input that changed after the unit was
/// last verified. A unit result edge never has; its unit's changed revision decides instead.
pub fn edgeChanged(graph: &DependencyGraph, unit: usize, edge: usize) -> bool {
  let record = List.get(&graph.dependees, u32.toUsize(List.get(&graph.edges, edge).dependee))
  if record.kind == DependeeKind.Result { return false }
  return record.changedAt > List.get(&graph.units, unit).verifiedAt
}

/// Whether `dependee`'s answer changed after `unit` was last verified.
pub fn resultChanged(graph: &DependencyGraph, unit: usize, dependee: usize) -> bool {
  if dependee >= List.length(&graph.units) { return true }
  return List.get(&graph.units, dependee).changedAt > List.get(&graph.units, unit).verifiedAt
}

/// Marks an outdated `unit` current: every dependee it consumed was verified unchanged.
pub fn markVerified(graph: &mut DependencyGraph, unit: usize) -> () {
  let revision = graph.revision
  let mut units = List.asMutSlice(&mut graph.units)
  units[unit].state = UnitState.UpToDate
  units[unit].verifiedAt = revision
  graph.verified = graph.verified + usize.ONE
  return ()
}

/// Copies the graph's counters and table sizes.
pub fn counters(graph: &DependencyGraph) -> Counters {
  let mut freeEdges = usize.ZERO
  let mut edge = graph.free
  while edge != u32.MAX {
    freeEdges = freeEdges + usize.ONE
    edge = List.get(&graph.edges, u32.toUsize(edge)).nextOfDepender
  }
  let bytes = List.capacity(&graph.units) * 48 + List.capacity(&graph.dependees) * 28
    + List.capacity(&graph.sourceInputs) * 4 + List.capacity(&graph.sourceFiles) * 4 + List.capacity(&graph.unitResults) * 4
    + List.capacity(&graph.edges) * 8 + List.capacity(&graph.links) * 12
  return Counters {
    units: List.length(&graph.units),
    dependees: List.length(&graph.dependees),
    edges: List.length(&graph.edges) - freeEdges,
    freeEdges: freeEdges,
    edgesRecorded: graph.edgesRecorded,
    edgesDeduplicated: graph.edgesDeduplicated,
    markedOutdated: graph.markedOutdated,
    fingerprinted: graph.fingerprinted,
    unchanged: graph.unchanged,
    verified: graph.verified,
    bytes: bytes,
  }
}
