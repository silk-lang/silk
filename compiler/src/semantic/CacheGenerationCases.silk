//! Generation root selections authorize exact answers and only their live packs.
import CompilerBug
import semantic.CacheGeneration as Generations {Generation, Selection, Requirements, Placement, LeafHandle, Certificate}
import semantic.CacheSegments as Segments {Segment, SealedSegment, Descriptor, Observation, Node, Edge, Reference, Root}
import semantic.ContentHash {ContentHash}
import semantic.RuntimeEncoding as Encoding
import silk.collections.bytes {Bytes}
import silk.collections.list {List}
import silk.collections.slice {Slice}
import silk.core.effect {Effect}
import silk.core.option {Option}
import silk.mem.frozen {Frozen}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.num.usize
import silk.testing.testing {Testing, AssertionError}

effect fn addRoot(segment: &mut Segment, key: &[u8], pack: &[u8]) -> ()
! OutOfMemoryError ? &mut Allocator {
  if segment.nodes.length() == usize.ZERO {
    run List<Node>.append(&mut segment.nodes, Node {edges: List<Edge>.make()})
  }
  let mut packs = List<ContentHash>.make()
  run List<ContentHash>.append(&mut packs, ContentHash.of(pack))
  run List<Root>.append(&mut segment.roots, Root {key: run Bytes.copy(key),
    node: Reference {segment: usize.ZERO, index: usize.ZERO}, answer: run Bytes.copy(b"answer"), packs: move packs})
}
effect fn sealed(segment: Segment, parents: &[Frozen<SealedSegment>]) -> Frozen<SealedSegment>
! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  match move run Segments.seal(move segment, parents) {
    Option<SealedSegment>.Some {value} => { return run Frozen<SealedSegment>.make(move value) }
    _ => { run Testing.expect(false, "fixture segment must seal") return CompilerBug.panic(b"unreachable assertion") }
  }
}
effect fn selected(descriptor: &Descriptor, root: usize) -> Selection
! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut selection = match move run Generations.selection(descriptor) {
    Option<Selection>.Some {value} => move value
    _ => { run Testing.expect(false, "fixture selection must be bounded") return Selection {segment: descriptor.digest, roots: Bytes.make()} }
  }
  run Testing.expect(Generations.setSelected(&mut selection, descriptor, root, true), "fixture root must exist")
  return move selection
}

test effect fn generationSelectionsReplaceAnswersAndPinOnlyActivePacks() -> ()
! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run authority() |> Effect.provideMut<Allocator>(&mut allocator)
}
effect fn authority() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut old = run Segments.make(1, b"target")
  run addRoot(&mut old, b"changed", b"obsolete-pack")
  run addRoot(&mut old, b"retained", b"live-pack")
  let oldOwner = run sealed(move old, &[])
  let oldDescriptor = Segments.descriptor(Frozen<SealedSegment>.get(&oldOwner))
  let mut segments = List<Frozen<SealedSegment>>.make()
  run List<Frozen<SealedSegment>>.append(&mut segments, move oldOwner)
  let mut fresh = run Segments.make(2, b"target")
  run List<Descriptor>.append(&mut fresh.imports, oldDescriptor)
  run addRoot(&mut fresh, b"changed", b"live-pack")
  let freshOwner = run sealed(move fresh, List<Frozen<SealedSegment>>.asSlice(&segments))
  let freshDescriptor = Segments.descriptor(Frozen<SealedSegment>.get(&freshOwner))
  run List<Frozen<SealedSegment>>.append(&mut segments, move freshOwner)
  let mut catalog = List<Descriptor>.make()
  run List<Descriptor>.append(&mut catalog, oldDescriptor)
  run List<Descriptor>.append(&mut catalog, freshDescriptor)
  let mut selections = List<Selection>.make()
  run List<Selection>.append(&mut selections, run selected(&oldDescriptor, 1))
  run List<Selection>.append(&mut selections, run selected(&freshDescriptor, 0))
  let mut generation = Generation {stamp: run Bytes.copy(b"target"), catalog: move catalog, selections: move selections, placements: List<Placement>.make(), certificate: Option<Certificate>.none()}
  let encoded = match move run Generations.encode(&generation) {
    Option<Bytes>.Some {value} => move value
    _ => { run Testing.expect(false, "valid generation must encode") return () }
  }
  let decoded = match move run Generations.decode(Bytes.asSlice(&encoded), b"target") {
    Option<Generation>.Some {value} => move value
    _ => { run Testing.expect(false, "generation must round trip") return () }
  }
  match move run Generations.admit(&decoded, List<Frozen<SealedSegment>>.asSlice(&segments)) {
    Option<Requirements>.Some {value} => {
      run Testing.expect(value.roots == 2 && value.packs.length() == 1, "two selected answers share one live pack")
      run Testing.expect(ContentHash.equals(List<ContentHash>.get(&value.packs, 0), ContentHash.of(b"live-pack")),
        "a replaced answer cannot pin its obsolete pack")
    }
    _ => { run Testing.expect(false, "authenticated root selection must admit") }
  }
  let selectedRoots = List<Selection>.asMutSlice(&mut generation.selections)
  run Testing.expect(Generations.setSelected(&mut selectedRoots[0], &oldDescriptor, 0, true), "old root can be represented")
  match move run Generations.admit(&generation, List<Frozen<SealedSegment>>.asSlice(&segments)) {
    Option<Requirements>.None => {}
    _ => { run Testing.expect(false, "duplicate exact selected keys reject rather than choosing a stale answer") }
  }
  run Testing.expect(Generations.setSelected(&mut List<Selection>.asMutSlice(&mut generation.selections)[0], &oldDescriptor, 0, false), "restore exact selection")
  let changedCatalog = List<Descriptor>.asMutSlice(&mut generation.catalog)
  changedCatalog[0].nodes = 2
  match move run Generations.admit(&generation, List<Frozen<SealedSegment>>.asSlice(&segments)) {
    Option<Requirements>.None => {}
    _ => { run Testing.expect(false, "catalog counts must match sealed segment authority") }
  }
  let restoredCatalog = List<Descriptor>.asMutSlice(&mut generation.catalog)
  restoredCatalog[0].nodes = oldDescriptor.nodes
  let mut substitute = run Segments.make(1, b"target")
  run addRoot(&mut substitute, b"changed", b"substituted-pack")
  run addRoot(&mut substitute, b"retained", b"live-pack")
  let substituteOwner = run sealed(move substitute, &[])
  List<Frozen<SealedSegment>>.set(&mut segments, 0, move substituteOwner)
  match move run Generations.admit(&generation, List<Frozen<SealedSegment>>.asSlice(&segments)) {
    Option<Requirements>.None => {}
    _ => { run Testing.expect(false, "same-shape changed content cannot borrow another segment's descriptor") }
  }
}

test effect fn generationCodecRejectsWrongStampDamageAndAmbiguousSelections() -> ()
! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run malformed() |> Effect.provideMut<Allocator>(&mut allocator)
}
effect fn malformed() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let descriptor = Descriptor {digest: ContentHash.of(b"segment"), serial: 1, leaves: 0, nodes: 1, roots: 1}
  let mut catalog = List<Descriptor>.make()
  run List<Descriptor>.append(&mut catalog, descriptor)
  let mut selections = List<Selection>.make()
  run List<Selection>.append(&mut selections, run selected(&descriptor, 0))
  let mut generation = Generation {stamp: run Bytes.copy(b"stamp"), catalog: move catalog, selections: move selections, placements: List<Placement>.make(), certificate: Option<Certificate>.none()}
  let mut bytes = match move run Generations.encode(&generation) {
    Option<Bytes>.Some {value} => move value
    _ => { run Testing.expect(false, "fixture shape must encode") return () }
  }
  match move run Generations.decode(Bytes.asSlice(&bytes), b"other") {
    Option<Generation>.None => {} _ => { run Testing.expect(false, "generation policy stamp must match") }
  }
  let full = Bytes.asSlice(&bytes)
  match move run Generations.decode(Slice.view<u8>(full, usize.ZERO, full.length - usize.ONE), b"stamp") {
    Option<Generation>.None => {} _ => { run Testing.expect(false, "truncated seal must reject") }
  }
  let damaged = Bytes.asMutSlice(&mut bytes)
  damaged[0] = 255
  match move run Generations.decode(Bytes.asSlice(&bytes), b"stamp") {
    Option<Generation>.None => {} _ => { run Testing.expect(false, "damaged descriptor must reject") }
  }
  let entries = List<Selection>.asMutSlice(&mut generation.selections)
  let extraBits = Bytes.asMutSlice(&mut entries[0].roots)
  extraBits[0] = 3
  run Testing.expect(!Generations.validShape(&generation), "unused selection bits must be zero")
  let restored = List<Selection>.asMutSlice(&mut generation.selections)
  let restoredBits = Bytes.asMutSlice(&mut restored[0].roots)
  restoredBits[0] = 1
  run List<Selection>.append(&mut generation.selections, run selected(&descriptor, 0))
  run Testing.expect(!Generations.validShape(&generation), "duplicate selection segments must reject")
  List<Selection>.clear(&mut generation.selections)
  let catalogEntries = List<Descriptor>.asMutSlice(&mut generation.catalog)
  catalogEntries[0].serial = 2
  run List<Descriptor>.append(&mut generation.catalog, descriptor)
  run Testing.expect(!Generations.validShape(&generation), "duplicate or non-topological catalog entries must reject")
}


effect fn observed(serial: u64, fileDigest: &[u8], inputDigest: &[u8], position: usize) -> Segment
! OutOfMemoryError ? &mut Allocator {
  let mut segment = run Segments.make(serial, b"target")
  run List<Observation>.append(&mut segment.leaves, Observation {key: run Bytes.copy(b"file"),
    digest: ContentHash.of(fileDigest), text: ContentHash.of(b""), position: usize.MAX,
    file: Option<Reference>.none(), selector: 0, input: false})
  run List<Observation>.append(&mut segment.leaves, Observation {key: run Bytes.copy(b"Body"),
    digest: ContentHash.of(inputDigest), text: ContentHash.of(b"tokens"), position: position,
    file: Option<Reference>.some(Reference {segment: 0, index: 0}), selector: 1, input: true})
  return move segment
}

test effect fn generationPlacementAdvancesOnlyEquivalentInputEvidence() -> ()
! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run placementClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn placementClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let old = run sealed(run observed(1, b"before", b"same body", 3), &[])
  let fresh = run sealed(run observed(2, b"after", b"same body", 17), &[])
  let different = run sealed(run observed(3, b"after", b"different body", 17), &[])
  let oldDescriptor = Segments.descriptor(Frozen<SealedSegment>.get(&old))
  let freshDescriptor = Segments.descriptor(Frozen<SealedSegment>.get(&fresh))
  let differentDescriptor = Segments.descriptor(Frozen<SealedSegment>.get(&different))
  let mut segments = List<Frozen<SealedSegment>>.make()
  run List<Frozen<SealedSegment>>.append(&mut segments, move old)
  run List<Frozen<SealedSegment>>.append(&mut segments, move fresh)
  run List<Frozen<SealedSegment>>.append(&mut segments, move different)
  let mut catalog = List<Descriptor>.make()
  run List<Descriptor>.append(&mut catalog, oldDescriptor)
  run List<Descriptor>.append(&mut catalog, freshDescriptor)
  run List<Descriptor>.append(&mut catalog, differentDescriptor)
  let from = LeafHandle {segment: oldDescriptor.digest, index: 1}
  let into = LeafHandle {segment: freshDescriptor.digest, index: 1}
  let changed = LeafHandle {segment: differentDescriptor.digest, index: 1}
  let mut placements = List<Placement>.make()
  run List<Placement>.append(&mut placements, Placement {source: from, target: into})
  let mut generation = Generation {stamp: run Bytes.copy(b"target"), catalog: move catalog,
    selections: List<Selection>.make(), placements: move placements, certificate: Option<Certificate>.none()}
  let encoded = match move run Generations.encode(&generation) {
    Option<Bytes>.Some {value} => move value _ => { run Testing.expect(false, "placement generation encodes") return () }
  }
  let decoded = match move run Generations.decode(Bytes.asSlice(&encoded), b"target") {
    Option<Generation>.Some {value} => move value _ => { run Testing.expect(false, "placement generation decodes") return () }
  }
  match move run Generations.admit(&decoded, List<Frozen<SealedSegment>>.asSlice(&segments)) {
    Option<Requirements>.Some {..} => {} _ => { run Testing.expect(false, "unchanged input can acquire a validated new position") }
  }
  match move Generations.placement(&decoded, from) {
    Option<LeafHandle>.Some {value} => {
      run Testing.expect(ContentHash.equals(value.segment, into.segment) && value.index == into.index, "placement resolves directly to new evidence")
    }
    _ => { run Testing.expect(false, "placement must remain in the descriptor") }
  }
  match move Generations.placement(&decoded, LeafHandle {segment: oldDescriptor.digest, index: 0}) {
    Option<LeafHandle>.None => {} _ => { run Testing.expect(false, "whole-file dependencies keep their original observation") }
  }
  match move Segments.observation(Frozen<SealedSegment>.get(&List<Frozen<SealedSegment>>.asSlice(&segments)[0]), 1) {
    Option<Segments.ObservationView>.Some {value} => { run Testing.expect(value.position == 3, "old immutable observation remains unchanged") }
    _ => { run Testing.expect(false, "old observation remains readable") }
  }
  let changedPlacements = List<Placement>.asMutSlice(&mut generation.placements)
  changedPlacements[0].target = changed
  match move run Generations.admit(&generation, List<Frozen<SealedSegment>>.asSlice(&segments)) {
    Option<Requirements>.None => {} _ => { run Testing.expect(false, "placement cannot substitute a different expected input digest") }
  }
  let restoredPlacements = List<Placement>.asMutSlice(&mut generation.placements)
  restoredPlacements[0].target = into
  run List<Placement>.append(&mut generation.placements, Placement {source: into, target: changed})
  run Testing.expect(!Generations.validShape(&generation), "placement chains are refused rather than replayed across edits")
  List<Placement>.clear(&mut generation.placements)
  run List<Placement>.append(&mut generation.placements, Placement {
    source: LeafHandle {segment: oldDescriptor.digest, index: 0}, target: LeafHandle {segment: freshDescriptor.digest, index: 0}})
  match move run Generations.admit(&generation, List<Frozen<SealedSegment>>.asSlice(&segments)) {
    Option<Requirements>.None => {} _ => { run Testing.expect(false, "a whole-file dependency cannot be relabeled as current") }
  }
}


test effect fn generationCertificatesDescribeOnlyDisjointSelectedGuardEvidence() -> ()
! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run certificateClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn certificateClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut first = run observed(1, b"current file", b"body", 2)
  run addRoot(&mut first, b"exact", b"pack")
  run addRoot(&mut first, b"positioned", b"pack")
  let firstOwner = run sealed(move first, &[])
  let firstDescriptor = Segments.descriptor(Frozen<SealedSegment>.get(&firstOwner))
  let mut changed = run observed(2, b"current file", b"changed", 2)
  let leaves = List<Observation>.asMutSlice(&mut changed.leaves)
  leaves[1].digest = ContentHash {high: 0, low: 0}
  let changedOwner = run sealed(move changed, &[])
  let changedDescriptor = Segments.descriptor(Frozen<SealedSegment>.get(&changedOwner))
  let mut owners = List<Frozen<SealedSegment>>.make()
  run List<Frozen<SealedSegment>>.append(&mut owners, move firstOwner)
  run List<Frozen<SealedSegment>>.append(&mut owners, move changedOwner)
  let mut catalog = List<Descriptor>.make()
  run List<Descriptor>.append(&mut catalog, firstDescriptor)
  run List<Descriptor>.append(&mut catalog, changedDescriptor)
  let mut all = run selected(&firstDescriptor, 0)
  run Testing.expect(Generations.setSelected(&mut all, &firstDescriptor, 1, true), "both fixture roots selected")
  let mut selections = List<Selection>.make()
  run List<Selection>.append(&mut selections, move all)
  let mut exact = List<Selection>.make()
  run List<Selection>.append(&mut exact, run selected(&firstDescriptor, 0))
  let mut positioned = List<Selection>.make()
  run List<Selection>.append(&mut positioned, run selected(&firstDescriptor, 1))
  let mut anchors = List<LeafHandle>.make()
  run List<LeafHandle>.append(&mut anchors, LeafHandle {segment: firstDescriptor.digest, index: 0})
  let mut generation = Generation {stamp: run Bytes.copy(b"target"), catalog: move catalog, selections: move selections,
    placements: List<Placement>.make(), certificate: Option<Certificate>.some(Certificate {
      context: run Bytes.copy(b"checked-source-context-v1"), exact: move exact, positionOnly: move positioned, anchors: move anchors})}
  let bytes = match move run Generations.encode(&generation) {
    Option<Bytes>.Some {value} => move value _ => { run Testing.expect(false, "certificate shape encodes") return () }
  }
  let decoded = match move run Generations.decode(Bytes.asSlice(&bytes), b"target") {
    Option<Generation>.Some {value} => move value _ => { run Testing.expect(false, "certificate shape decodes") return () }
  }
  match &decoded.certificate {
    Option<Certificate>.Some {value} => {
      run Testing.expect(Generations.selected(&List<Selection>.asSlice(&value.exact)[0], 0)
        && !Generations.selected(&List<Selection>.asSlice(&value.exact)[0], 1)
        && Generations.selected(&List<Selection>.asSlice(&value.positionOnly)[0], 1),
        "exact and positional guard dispositions remain distinct")
      run Testing.expect(Encoding.equals(Bytes.asSlice(&value.context), b"checked-source-context-v1"), "exact context is preserved for semantic validation")
    }
    _ => { run Testing.expect(false, "explicit certificate is retained") }
  }
  match move run Generations.admit(&decoded, List<Frozen<SealedSegment>>.asSlice(&owners)) {
    Option<Requirements>.Some {..} => {} _ => { run Testing.expect(false, "admitted anchors and selected guard subsets are structurally valid") }
  }
  if let Option<Certificate>.Some {value} = &mut generation.certificate {
    run Testing.expect(Generations.setSelected(&mut List<Selection>.asMutSlice(&mut value.positionOnly)[0], &firstDescriptor, 0, true), "overlap fixture")
  }
  run Testing.expect(!Generations.validShape(&generation), "one root cannot claim both exact and positional dispositions")
  if let Option<Certificate>.Some {value} = &mut generation.certificate {
    run Testing.expect(Generations.setSelected(&mut List<Selection>.asMutSlice(&mut value.positionOnly)[0], &firstDescriptor, 0, false), "restore disjoint dispositions")
  }
  run Testing.expect(Generations.setSelected(&mut List<Selection>.asMutSlice(&mut generation.selections)[0], &firstDescriptor, 1, false), "withdraw an answer")
  run Testing.expect(!Generations.validShape(&generation), "a certificate cannot reauthorize a withdrawn root")
  run Testing.expect(Generations.setSelected(&mut List<Selection>.asMutSlice(&mut generation.selections)[0], &firstDescriptor, 1, true), "restore selection")
  if let Option<Certificate>.Some {value} = &mut generation.certificate {
    List<LeafHandle>.set(&mut value.anchors, 0, LeafHandle {segment: changedDescriptor.digest, index: 1})
  }
  match move run Generations.admit(&generation, List<Frozen<SealedSegment>>.asSlice(&owners)) {
    Option<Requirements>.None => {} _ => { run Testing.expect(false, "a changed-input sentinel is not a validated current anchor") }
  }
  generation.certificate = Option<Certificate>.none()
  match move run Generations.admit(&generation, List<Frozen<SealedSegment>>.asSlice(&owners)) {
    Option<Requirements>.Some {..} => {} _ => { run Testing.expect(false, "uncertified selected answers remain available for normal dependency validation") }
  }
}
