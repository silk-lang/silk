//! Generation root selections authorize exact answers and only their live packs.
import CompilerBug
import semantic.CacheGeneration as Generations {Generation, Selection, Requirements}
import semantic.CacheSegments as Segments {Segment, SealedSegment, Descriptor, Node, Edge, Reference, Root}
import semantic.ContentHash {ContentHash}
import silk.collections.bytes {Bytes}
import silk.collections.list {List}
import silk.collections.slice {Slice}
import silk.core.effect {Effect}
import silk.core.option {Option}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.num.usize
import silk.testing.testing {Testing, AssertionError}

effect fn addRoot(segment: &mut Segment, key: &[u8], pack: &[u8]) -> ()
! OutOfMemoryError ? &mut Allocator {
  if segment.nodes.length() == usize.ZERO {
    run List<Node>.append(&mut segment.nodes, Node {edges: List<Edge>.make()})
  }
  let mut packs = List<ContentHash>.make()
  run List<ContentHash>.append(&mut packs, ContentHash.of(pack))
  run List<Root>.append(&mut segment.roots, Root {key: run Bytes.copy(key),
    node: Reference {segment: usize.ZERO, index: usize.ZERO}, answer: run Bytes.copy(b"answer"), packs: move packs})
}
effect fn sealed(segment: Segment, parents: &[SealedSegment]) -> SealedSegment
! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  match move run Segments.seal(move segment, parents) {
    Option<SealedSegment>.Some {value} => { return move value }
    _ => { run Testing.expect(false, "fixture segment must seal") return CompilerBug.panic(b"unreachable assertion") }
  }
}
effect fn selected(descriptor: &Descriptor, root: usize) -> Selection
! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut selection = match move run Generations.selection(descriptor) {
    Option<Selection>.Some {value} => move value
    _ => { run Testing.expect(false, "fixture selection must be bounded") return Selection {segment: descriptor.digest, roots: Bytes.make()} }
  }
  run Testing.expect(Generations.setSelected(&mut selection, descriptor, root, true), "fixture root must exist")
  return move selection
}

test effect fn generationSelectionsReplaceAnswersAndPinOnlyActivePacks() -> ()
! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run authority() |> Effect.provideMut<Allocator>(&mut allocator)
}
effect fn authority() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut old = run Segments.make(1, b"target")
  run addRoot(&mut old, b"changed", b"obsolete-pack")
  run addRoot(&mut old, b"retained", b"live-pack")
  let oldOwner = run sealed(move old, &[])
  let oldDescriptor = Segments.descriptor(&oldOwner)
  let mut segments = List<SealedSegment>.make()
  run List<SealedSegment>.append(&mut segments, move oldOwner)
  let mut fresh = run Segments.make(2, b"target")
  run List<Descriptor>.append(&mut fresh.imports, oldDescriptor)
  run addRoot(&mut fresh, b"changed", b"live-pack")
  let freshOwner = run sealed(move fresh, List<SealedSegment>.asSlice(&segments))
  let freshDescriptor = Segments.descriptor(&freshOwner)
  run List<SealedSegment>.append(&mut segments, move freshOwner)
  let mut catalog = List<Descriptor>.make()
  run List<Descriptor>.append(&mut catalog, oldDescriptor)
  run List<Descriptor>.append(&mut catalog, freshDescriptor)
  let mut selections = List<Selection>.make()
  run List<Selection>.append(&mut selections, run selected(&oldDescriptor, 1))
  run List<Selection>.append(&mut selections, run selected(&freshDescriptor, 0))
  let mut generation = Generation {stamp: run Bytes.copy(b"target"), catalog: move catalog, selections: move selections}
  let encoded = match move run Generations.encode(&generation) {
    Option<Bytes>.Some {value} => move value
    _ => { run Testing.expect(false, "valid generation must encode") return () }
  }
  let decoded = match move run Generations.decode(Bytes.asSlice(&encoded), b"target") {
    Option<Generation>.Some {value} => move value
    _ => { run Testing.expect(false, "generation must round trip") return () }
  }
  match move run Generations.admit(&decoded, List<SealedSegment>.asSlice(&segments)) {
    Option<Requirements>.Some {value} => {
      run Testing.expect(value.roots == 2 && value.packs.length() == 1, "two selected answers share one live pack")
      run Testing.expect(ContentHash.equals(List<ContentHash>.get(&value.packs, 0), ContentHash.of(b"live-pack")),
        "a replaced answer cannot pin its obsolete pack")
    }
    _ => { run Testing.expect(false, "authenticated root selection must admit") }
  }
  let selectedRoots = List<Selection>.asMutSlice(&mut generation.selections)
  run Testing.expect(Generations.setSelected(&mut selectedRoots[0], &oldDescriptor, 0, true), "old root can be represented")
  match move run Generations.admit(&generation, List<SealedSegment>.asSlice(&segments)) {
    Option<Requirements>.None => {}
    _ => { run Testing.expect(false, "duplicate exact selected keys reject rather than choosing a stale answer") }
  }
  run Testing.expect(Generations.setSelected(&mut List<Selection>.asMutSlice(&mut generation.selections)[0], &oldDescriptor, 0, false), "restore exact selection")
  let changedCatalog = List<Descriptor>.asMutSlice(&mut generation.catalog)
  changedCatalog[0].nodes = 2
  match move run Generations.admit(&generation, List<SealedSegment>.asSlice(&segments)) {
    Option<Requirements>.None => {}
    _ => { run Testing.expect(false, "catalog counts must match sealed segment authority") }
  }
  let restoredCatalog = List<Descriptor>.asMutSlice(&mut generation.catalog)
  restoredCatalog[0].nodes = oldDescriptor.nodes
  let mut substitute = run Segments.make(1, b"target")
  run addRoot(&mut substitute, b"changed", b"substituted-pack")
  run addRoot(&mut substitute, b"retained", b"live-pack")
  let substituteOwner = run sealed(move substitute, &[])
  List<SealedSegment>.set(&mut segments, 0, move substituteOwner)
  match move run Generations.admit(&generation, List<SealedSegment>.asSlice(&segments)) {
    Option<Requirements>.None => {}
    _ => { run Testing.expect(false, "same-shape changed content cannot borrow another segment's descriptor") }
  }
}

test effect fn generationCodecRejectsWrongStampDamageAndAmbiguousSelections() -> ()
! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run malformed() |> Effect.provideMut<Allocator>(&mut allocator)
}
effect fn malformed() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let descriptor = Descriptor {digest: ContentHash.of(b"segment"), serial: 1, leaves: 0, nodes: 1, roots: 1}
  let mut catalog = List<Descriptor>.make()
  run List<Descriptor>.append(&mut catalog, descriptor)
  let mut selections = List<Selection>.make()
  run List<Selection>.append(&mut selections, run selected(&descriptor, 0))
  let mut generation = Generation {stamp: run Bytes.copy(b"stamp"), catalog: move catalog, selections: move selections}
  let mut bytes = match move run Generations.encode(&generation) {
    Option<Bytes>.Some {value} => move value
    _ => { run Testing.expect(false, "fixture shape must encode") return () }
  }
  match move run Generations.decode(Bytes.asSlice(&bytes), b"other") {
    Option<Generation>.None => {} _ => { run Testing.expect(false, "generation policy stamp must match") }
  }
  let full = Bytes.asSlice(&bytes)
  match move run Generations.decode(Slice.view<u8>(full, usize.ZERO, full.length - usize.ONE), b"stamp") {
    Option<Generation>.None => {} _ => { run Testing.expect(false, "truncated seal must reject") }
  }
  let damaged = Bytes.asMutSlice(&mut bytes)
  damaged[0] = 255
  match move run Generations.decode(Bytes.asSlice(&bytes), b"stamp") {
    Option<Generation>.None => {} _ => { run Testing.expect(false, "damaged descriptor must reject") }
  }
  let entries = List<Selection>.asMutSlice(&mut generation.selections)
  let extraBits = Bytes.asMutSlice(&mut entries[0].roots)
  extraBits[0] = 3
  run Testing.expect(!Generations.validShape(&generation), "unused selection bits must be zero")
  let restored = List<Selection>.asMutSlice(&mut generation.selections)
  let restoredBits = Bytes.asMutSlice(&mut restored[0].roots)
  restoredBits[0] = 1
  run List<Selection>.append(&mut generation.selections, run selected(&descriptor, 0))
  run Testing.expect(!Generations.validShape(&generation), "duplicate selection segments must reject")
  List<Selection>.clear(&mut generation.selections)
  let catalogEntries = List<Descriptor>.asMutSlice(&mut generation.catalog)
  catalogEntries[0].serial = 2
  run List<Descriptor>.append(&mut generation.catalog, descriptor)
  run Testing.expect(!Generations.validShape(&generation), "duplicate or non-topological catalog entries must reject")
}
