//! Structural dictionary roundtrips preserve semantic identity and reject invalid wire references.

import semantic.BodyTypes
import semantic.BodyWire
import semantic.DeclarationId {DeclarationId, OwnerStep}
import semantic.ModuleId {ModuleId, InvalidModulePath}
import semantic.Types {Types, TypeTable}
import semantic.Type {Type, Argument, Binding}
import semantic.Lifetime {Lifetime}
import semantic.Specialization {Application, Target, ScopeBinding, StaticSlot}
import semantic.StaticValue {Value as StaticData, IntegerType, FloatType, Sign}
import semantic.StaticValue
import hir.Hir {OwnerKind, Access}
import silk.collections.bytes {Bytes}
import silk.collections.list {List}
import silk.collections.slice {Slice}
import silk.mem.interned {Interned}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.core.effect {Effect}
import silk.core.option {Option}
import silk.testing.testing {Testing, AssertionError}
import silk.num.usize
import silk.num.u64

effect fn declaration() -> DeclarationId ! InvalidModulePath | OutOfMemoryError ? &mut Allocator {
  let module = run ModuleId.make(b"capsule-source", b"dictionary-tests", b"nested/source")
  let mut owners = List<OwnerStep>.make()
  run List<OwnerStep>.append(&mut owners, OwnerStep {kind: OwnerKind.Struct, name: Option<Bytes>.some(run Bytes.copy(b"Container")), occurrence: 2})
  run List<OwnerStep>.append(&mut owners, OwnerStep {kind: OwnerKind.Function, name: Option<Bytes>.some(run Bytes.copy(b"apply")), occurrence: 3})
  return run DeclarationId.fromParts(move module, move owners)
}

effect fn roundtripClaims() -> () ! InvalidModulePath | OutOfMemoryError | AssertionError<'static>
? &mut Allocator | &mut Types {
  let owner = run declaration()
  let integer = run Types.intern(Type.Primitive {name: run Bytes.copy(b"i32")})
  let region = run Types.internLifetime(Lifetime.Local {declaration: DeclarationId.copy(&owner), ordinal: 19, binder: 2})
  let otherRegion = run Types.internLifetime(Lifetime.Local {declaration: DeclarationId.copy(&owner), ordinal: 19, binder: 3})
  let mut atoms = List<Interned<Lifetime>>.make()
  run List<Interned<Lifetime>>.append(&mut atoms, Interned<Lifetime>.clone(&region))
  run List<Interned<Lifetime>>.append(&mut atoms, Interned<Lifetime>.clone(&otherRegion))
  let meeting = run Lifetime.meet(List<Interned<Lifetime>>.asSlice(&atoms))
  let reference = run Types.intern(Type.Reference {referent: Interned<Type>.clone(&integer), access: Access.Mutable, lifetime: move meeting})
  let parameter = run Types.internLifetime(Lifetime.Parameter {declaration: DeclarationId.copy(&owner), ordinal: 7})
  let mut arguments = List<Argument>.make()
  run List<Argument>.append(&mut arguments, Argument.Type {value: Interned<Type>.clone(&reference)})
  run List<Argument>.append(&mut arguments, Argument.Lifetime {value: Interned<Lifetime>.clone(&parameter)})
  let mut ordinals = List<usize>.make()
  run List<usize>.append(&mut ordinals, 1)
  run List<usize>.append(&mut ordinals, 7)
  let staticValue = run Interned<StaticData>.make(StaticData.Integer {ty: IntegerType.U64, sign: Sign.Positive, magnitude: 0xfedcba9876543210})
  let mut statics = List<StaticSlot>.make()
  run List<StaticSlot>.append(&mut statics, StaticSlot {ordinal: 11, value: Interned<StaticData>.clone(&staticValue)})
  let mut scopes = List<ScopeBinding>.make()
  let mut scopeArguments = List<Argument>.make()
  run List<Argument>.append(&mut scopeArguments, Argument.Type {value: Interned<Type>.clone(&integer)})
  let mut scopeOrdinals = List<usize>.make()
  run List<usize>.append(&mut scopeOrdinals, 4)
  run List<ScopeBinding>.append(&mut scopes, ScopeBinding {owner: run Types.internDeclaration(DeclarationId.copy(&owner)), arguments: move scopeArguments, argumentOrdinals: move scopeOrdinals, statics: List<StaticSlot>.make()})
  let application = run Types.internApplication(Application {target: Target.Named {declaration: DeclarationId.copy(&owner)}, arguments: move arguments, argumentOrdinals: move ordinals, scopes: move scopes, statics: move statics})
  let binding = Binding {declaration: run Types.internDeclaration(DeclarationId.copy(&owner)), ordinal: 7, value: Argument.Lifetime {value: Interned<Lifetime>.clone(&parameter)}}
  let mut encoded = BodyWire.writer()
  let mut encoder = BodyTypes.encoder()
  run BodyTypes.writeType(&mut encoder, &mut encoded, &reference)
  let repeatedAt = Bytes.length(&encoded.bytes)
  run BodyTypes.writeType(&mut encoder, &mut encoded, &reference)
  run BodyTypes.writeLifetime(&mut encoder, &mut encoded, &otherRegion)
  run BodyTypes.writeApplication(&mut encoder, &mut encoded, &application)
  run BodyTypes.writeBinding(&mut encoder, &mut encoded, &binding)
  let floatBits = run Interned<StaticData>.make(StaticData.Float {ty: FloatType.F64, bits: 0x7ff8000000000042})
  run BodyTypes.writeStaticData(&mut encoder, &mut encoded, &floatBits)
  run Testing.expect(!encoded.failed, "supported complete type/application identities encode")
  let bytes = Bytes.asSlice(&encoded.bytes)
  let mut input = BodyWire.reader(bytes)
  let mut decoder = BodyTypes.decoder()
  let mut imported = TypeTable.make()
  let firstDecoded = run BodyTypes.readType(&mut decoder, bytes, &mut input) |> Effect.provideMut<Types>(&mut imported)
  let repeatedDecoded = run BodyTypes.readType(&mut decoder, bytes, &mut input) |> Effect.provideMut<Types>(&mut imported)
  let different = run BodyTypes.readLifetime(&mut decoder, bytes, &mut input) |> Effect.provideMut<Types>(&mut imported)
  let recovered = run BodyTypes.readApplication(&mut decoder, bytes, &mut input) |> Effect.provideMut<Types>(&mut imported)
  let recoveredBinding = run BodyTypes.readBinding(&mut decoder, bytes, &mut input) |> Effect.provideMut<Types>(&mut imported)
  let recoveredFloat = run BodyTypes.readStaticData(&mut decoder, bytes, &mut input) |> Effect.provideMut<Types>(&mut imported)
  run Testing.expect(BodyWire.finished(bytes, &input), "complete dictionary input is consumed")
  if let Option<Interned<Type>>.Some {value: first} = move firstDecoded {
    run Testing.expect(run Type.equalsShared(&reference, &first), "separate interning tables preserve referent/access/local owner and binder identity")
    if let Option<Interned<Type>>.Some {value: repeated} = move repeatedDecoded {
      run Testing.expect(Interned<Type>.same(&first, &repeated), "dictionary references resolve to the earlier imported handle")
    } else { run Testing.expect(false, "repeated type decodes") }
  } else { run Testing.expect(false, "reference type decodes") }
  if let Option<Interned<Lifetime>>.Some {value} = move different {
    run Testing.expect(Lifetime.equalsShared(&value, &otherRegion) && !Lifetime.equalsShared(&value, &region), "different local inference binders remain different regions")
  } else { run Testing.expect(false, "local region decodes") }
  if let Option<Interned<Application>>.Some {value} = move recovered {
    run Testing.expect(run Application.equals(Interned<Application>.get(&application), Interned<Application>.get(&value)), "application retains original argument ordinals, lexical scopes, static bits and declaration chain")
  } else { run Testing.expect(false, "application decodes") }
  if let Option<Binding>.Some {value} = move recoveredBinding {
    run Testing.expect(value.ordinal == 7 && DeclarationId.equals(Interned<DeclarationId>.get(&value.declaration), &owner), "binding retains owner and original ordinal")
  } else { run Testing.expect(false, "binding decodes") }
  if let Option<Interned<StaticData>>.Some {value} = move recoveredFloat {
    run Testing.expect(run StaticValue.equals(&floatBits, &value), "floating static values preserve NaN payload bits rather than numeric conversion")
  } else { run Testing.expect(false, "floating static value decodes") }
  // An otherwise valid reference is not meaningful in an unrelated capsule's empty dictionary.
  let orphan = Slice.view<u8>(bytes, repeatedAt, 16)
  let mut orphanReader = BodyWire.reader(orphan)
  let mut orphanDictionary = BodyTypes.decoder()
  let missing = run BodyTypes.readType(&mut orphanDictionary, orphan, &mut orphanReader)
  run Testing.expect(orphanReader.failed && match &missing { Option<Interned<Type>>.None => true _ => false }, "cross-capsule dictionary references fail closed")
}

effect fn rejectionClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let mut unknown = BodyWire.writer()
  run BodyWire.word(&mut unknown, 0)
  run BodyWire.word(&mut unknown, 999)
  let mut input = BodyWire.reader(Bytes.asSlice(&unknown.bytes))
  let mut decoder = BodyTypes.decoder()
  let missing = run BodyTypes.readType(&mut decoder, Bytes.asSlice(&unknown.bytes), &mut input)
  run Testing.expect(input.failed && match &missing { Option<Interned<Type>>.None => true _ => false }, "unknown structural tags cannot create a type")
  let original = run Types.intern(Type.Unit)
  let mut output = BodyWire.writer()
  let mut encoder = BodyTypes.encoder()
  run BodyTypes.writeType(&mut encoder, &mut output, &original)
  let truncated = Slice.view<u8>(Bytes.asSlice(&output.bytes), usize.ZERO, Bytes.length(&output.bytes) - usize.ONE)
  let mut partial = BodyWire.reader(truncated)
  let mut partialTypes = BodyTypes.decoder()
  let absent = run BodyTypes.readType(&mut partialTypes, truncated, &mut partial)
  run Testing.expect(partial.failed && match &absent { Option<Interned<Type>>.None => true _ => false }, "truncated definitions do not publish dictionary entries")
  let mut deep = BodyWire.writer()
  let mut at = usize.ZERO
  while at < BodyWire.DEPTH_LIMIT + usize.ONE {
    run BodyWire.word(&mut deep, 0)
    run BodyWire.word(&mut deep, 6)
    at = at + usize.ONE
  }
  run BodyWire.word(&mut deep, 0)
  run BodyWire.word(&mut deep, 1)
  at = usize.ZERO
  while at < BodyWire.DEPTH_LIMIT + usize.ONE {
    run BodyWire.word(&mut deep, 0)
    run BodyWire.word(&mut deep, 0)
    run BodyWire.word(&mut deep, 0)
    at = at + usize.ONE
  }
  let mut recursive = BodyWire.reader(Bytes.asSlice(&deep.bytes))
  let mut recursiveTypes = BodyTypes.decoder()
  let refused = run BodyTypes.readType(&mut recursiveTypes, Bytes.asSlice(&deep.bytes), &mut recursive)
  run Testing.expect(recursive.failed && recursive.depth == usize.ZERO && match &refused { Option<Interned<Type>>.None => true _ => false }, "deep but bounded bytes fail at the structural recursion budget and unwind")
  let element = run Types.intern(Type.Primitive {name: run Bytes.copy(b"u8")})
  let array = run Types.intern(Type.Array {element: move element, extent: run Bytes.copy(b"0")})
  let admitted = StaticValue.aggregate(move array, Option<usize>.none(), List<Interned<StaticData>>.make())
  if let Option<StaticData>.Some {value} = move admitted {
    let held = run Interned<StaticData>.make(move value)
    let mut unsupported = BodyWire.writer()
    let mut unsupportedTypes = BodyTypes.encoder()
    run BodyTypes.writeStaticData(&mut unsupportedTypes, &mut unsupported, &held)
    run Testing.expect(unsupported.failed, "private aggregate admission is unsupported rather than invented from layout")
  } else { run Testing.expect(false, "fixture creates a valid admitted empty array") }
}

test effect fn portableBodyDictionariesPreserveCompleteBindings() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut types = TypeTable.make()
  return run roundtripClaims() |> Effect.provideMut<Types>(&mut types) |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn portableBodyDictionariesRefuseMalformedAndPrivateEvidence() -> ()
! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut types = TypeTable.make()
  return run rejectionClaims() |> Effect.provideMut<Types>(&mut types) |> Effect.provideMut<Allocator>(&mut allocator)
}
