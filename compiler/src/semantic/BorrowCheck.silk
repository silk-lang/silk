/// What checking one body's loans and moves established.
pub enum Outcome {
  /// Every loan in the body is free of conflicts, and no moved place is used.
  Clear,
  /// An access conflicts with a live loan or uses a moved place, or a loop repeats with different
  /// moved places.
  Conflict,
  /// The body uses a form outside this slice; nothing is proved or rejected.
  NotChecked,
}

/// The outcome of checking one body. For a conflict, `access` is the rejected access or loop and
/// `earlier` the borrow or move it conflicts with, if any; otherwise `code` and `access` are unused.
///
/// Its spans count from the checked body's anchor, like the body's origins.
pub struct Verdict {
  pub outcome: Outcome
  /// For a clear body, `Checked` when [`regionClosed`] and nothing is pending, `Regions` otherwise;
  /// for an unchecked one, the reason.
  pub status: BorrowStatus
  pub code: RejectionCode
  pub access: Location
  pub earlier: Option<Location>
  /// Every conflict the body reports, the one above included, ordered by span as the bootstrap
  /// lists them; empty unless the body reports more than one.
  pub reports: List<Report>
}

/// One reported conflict: the rejected access and, when `related`, the borrow or move it conflicts
/// with at `earlier`.
pub struct Report {
  pub code: RejectionCode
  pub access: Location
  pub related: bool
  pub earlier: Location
}

impl Copy for Report {}

// Records a conflict unless one with the same code and span was already found.
effect fn addReport(reports: &mut List<Report>, report: Report) -> () ! OutOfMemoryError ? &mut Allocator {
  let found = List<Report>.asSlice(&reports.*)
  let mut at = usize.ZERO
  while at < found.length {
    if found[at].code == report.code && found[at].access.start == report.access.start && found[at].access.end == report.access.end {
      return ()
    }
    at = at + usize.ONE
  }
  run List<Report>.append(&mut reports.*, report)
  return ()
}

// The reports ordered by span, earlier first; reports with one span keep the order they were found.
effect fn bySpan(reports: &[Report]) -> List<Report> ! OutOfMemoryError ? &mut Allocator {
  let mut sorted = List<Report>.make()
  let mut at = usize.ZERO
  while at < reports.length {
    run List<Report>.append(&mut sorted, reports[at])
    let mut slot = List<Report>.length(&sorted) - usize.ONE
    while slot > usize.ZERO {
      let mut items = List<Report>.asMutSlice(&mut sorted)
      let previous = items[slot - usize.ONE]
      let current = items[slot]
      let later = previous.access.start > current.access.start
        || (previous.access.start == current.access.start && previous.access.end > current.access.end)
      if !later { break }
      items[slot - usize.ONE] = current
      items[slot] = previous
      slot = slot - usize.ONE
    }
    at = at + usize.ONE
  }
  return move sorted
}

fn verdict(outcome: Outcome, status: BorrowStatus) -> Verdict {
  return Verdict {outcome: outcome, status: status, code: RejectionCode.Unsupported, access: Location.make(usize.ZERO, usize.ZERO),
    earlier: Option<Location>.none(), reports: List<Report>.make()}
}

// The kind of one place step. Each kind numbers its own steps, so no field, element or member
// ordinal can stand for another kind of step.
enum StepKind {
  Field,
  Element,
  // A union member or variant payload; distinct members of one union are disjoint places.
  Member,
  // The step from a reference to its referent. A place through a reference names the referent's
  // storage, so a reborrow is a loan of that place (BORROW-005).
  Referent,
  // An index step whose value is unknown; it overlaps every element step.
  AnyElement,
  // A held loan replicated into every array element, never a source access path.
  RepeatedElement,
}

struct Step {
  kind: StepKind
  ordinal: usize
}

impl Copy for Step {}

fn fieldStep(index: usize) -> Step {
  return Step {kind: StepKind.Field, ordinal: index}
}

fn elementStep(index: usize) -> Step {
  return Step {kind: StepKind.Element, ordinal: index}
}

fn memberStep(tag: usize) -> Step {
  return Step {kind: StepKind.Member, ordinal: tag}
}

fn referent() -> Step {
  return Step {kind: StepKind.Referent, ordinal: usize.ZERO}
}

fn anyElement() -> Step {
  return Step {kind: StepKind.AnyElement, ordinal: usize.ZERO}
}

fn sameStep(left: Step, right: Step) -> bool {
  return left.kind == right.kind && left.ordinal == right.ordinal
}

// Whether `inner` lies behind a reference stored at `outer`: `outer`'s steps are a strict prefix of
// `inner`'s and the next step dereferences. Replacing the reference leaves its old referent alone.
fn behind(outer: &Place, inner: &Place) -> bool {
  if outer.root != inner.root {
    return false
  }
  let first = List<Step>.asSlice(&outer.steps)
  let second = List<Step>.asSlice(&inner.steps)
  if first.length >= second.length || second[first.length].kind != StepKind.Referent {
    return false
  }
  let mut at = usize.ZERO
  while at < first.length {
    if !sameStep(first[at], second[at]) {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

// Only a whole local whose actual type is a shared reference proves that consuming this
// descriptor cannot consume its referent. Projected, hidden and opaque places need their own
// type evidence; a shared loan alone says nothing about the descriptor's access.
fn sharedLocalDescriptor(locals: &[Local], place: &Place) -> bool {
  if place.root >= locals.length || List<Step>.length(&place.steps) != usize.ZERO { return false }
  return Shared<Type>.with<bool>(&locals[place.root].ty, fn(ty: &Type) -> bool {
    return match &ty.* {
      Type.Reference {access, ..} => access == Access.Shared
      _ => false
    }
  })
}

// A body local and its static projection path: field ordinals, or `anyElement` for an index.
struct Place {
  root: usize
  steps: List<Step>
}

struct Interval {
  from: usize
  to: usize
  definition: usize
  read: usize
  cleanup: bool
}

impl Copy for Interval {}

// How exactly the walk knows which values carry this loan. A conflict with an inexact loan leaves
// the body imprecise instead of rejecting it, except a `Stored` one.
// - `Stored`: a retaining local holder took the loan by a field store. The loan itself flows exactly,
//   so it is still rejected once required past its storage end, and its region proof is typing's
//   relation from the stored loan's region into the field's: the holder's region keeps every loan it
//   ever held, which over-approximates, and a requirement before the store is vacuous for this loan,
//   whose creation does not reach it. A call that cannot map it exactly leaves it `Unknown`.
// - `Alternatives`: the loan is one of a complete union of possible source loans. Every source must
//   satisfy a region proof, but a conflict with one possible source cannot establish a definite rejection.
// - `Unknown`: no complete mapping, so the loan cannot participate in region proofs.
enum LoanPrecision { Exact, Stored, Alternatives, Unknown }

// Whether region proofs may use a loan: its sources are exact, held by a field store, or a complete
// union of alternatives.
fn provable(precision: LoanPrecision) -> bool {
  return precision == LoanPrecision.Exact || precision == LoanPrecision.Stored || precision == LoanPrecision.Alternatives
}

struct Loan {
  place: Place
  exclusive: bool
  origin: Location
  // Evaluation-point ranges in which a value carrying this loan is in flight.
  intervals: List<Interval>
  // How exactly the walk knows which values carry this loan.
  precision: LoanPrecision
  // The regions typing gave the borrow, or none when the borrow has no typed node of its own.
  regions: List<Shared<Lifetime>>
  // Whether the loan borrows a place rooted in a body local, so its region is a body region even
  // when typing recorded none.
  local: bool
  // Storage provenance is separate from inner lifetime atoms retained by the borrowed type.
  borrowed: Option<Shared<Lifetime>>
  parent: Option<Shared<Lifetime>>
  crossed: bool
  created: usize
  // Whether the loan's value reached a call or callable that can keep it in a universal region, one
  // chosen before the body runs; it must then outlive the body wherever its creation reaches (R3
  // amendment 4).
  escapes: bool
  // The match subject node whose borrowed arm bindings hold this loan, or `usize.MAX`: accesses
  // through those bindings reach the subject place without conflicting with it (MATCH-002).
  binder: usize
  // The local an `effect` block binds when this loan is one of the block's own captures, taken by
  // the block's initializer, or `usize.MAX`.
  block: usize
  // A point the loan stays live to whether or not a holder uses it there, or `usize.MAX`: an unrun
  // `effect` block keeps its own captures to its scope end (EFFECT-OWN-001).
  until: usize
  // The referent of the reference the borrow is typed as, or none, and a call then judges a carried
  // loan by its whole operand.
  referent: Option<Shared<Type>>
  // Whether a result keeps the loan only because typing requires its region to outlive a caller
  // region the result names (`outlivesResult`): where the return-slot refutation decides that
  // relation, the walk leaves the loan's conflicts to it.
  bound: bool
}

enum Kind {
  Read,
  // A complete or projected replacement: it reinitializes the place.
  Write,
  // A transfer of ownership out of the place: it leaves the place without an owner.
  Move,
  // An explicit `drop`: it ends the place's remaining parts, so a part moved earlier is no use.
  Drop,
  SharedBorrow,
  ExclusiveBorrow,
  // A `match &mut` scrutinee: like a write it conflicts with every loan, but it replaces nothing.
  Update,
  // A `match place` scrutinee reads the tag of an owner whose payload parts may have moved: it
  // conflicts with every loan, and only a move of the owner or an ancestor is a use after move.
  Inspect,
  // Ends the remaining storage of one scope owner after its observing cleanup.
  End,
  // Ends the validity of a hidden owner's loans while its storage lives on: a temporary a viewing
  // binding keeps beyond its statement (BORROW-006).
  Expire,
}

struct Event {
  point: usize
  place: Place
  kind: Kind
  span: Location
  // The accessed place itself, which a loan conflict reports (OWN0011): the operand of a `move`,
  // otherwise `span`.
  target: Location
  // The loan this access creates, or `usize.MAX`.
  loan: usize
  // For a replacement, whether its right-hand side moves out of the target: 0 no, 1 yes, 2 only
  // through an unknown index.
  consumesTarget: usize
  // The place match whose binding this access goes through, or `usize.MAX` (see `Path`).
  refiner: usize
  refinedDepth: usize
  // The subjects of the borrowing matches whose bindings this access goes through.
  binders: List<usize>
}

struct Point {
  next: List<usize>
  // A holder local read here, or `usize.MAX`.
  uses: usize
  // The path within `uses` this read reaches, or `usize.MAX` when it may reach all of it.
  read: usize
  // The exact path within `uses` whose old value this point overwrites, or `usize.MAX`: what was
  // held within it is not read here.
  written: usize
  // A holder local bound here, or `usize.MAX`.
  defines: usize
  // A local whose binding initializes it here, or `usize.MAX`.
  initializes: usize
  // The access recorded here, or `usize.MAX`.
  event: usize
  span: Location
}

struct Frame {
  exit: usize
  // The index of the frame's loop in `Walker.loops`.
  repeat: usize
  scopes: usize
}

// A loop: the point before it, its header, the sources of its back edges, the end of its points,
// and the span the bootstrap reports for an incompatible header.
struct Loop {
  before: usize
  header: usize
  sources: List<usize>
  end: usize
  span: Location
}

impl Copy for Frame {}

// A loan carried by a value, and the point from which it is in flight.
struct Carry {
  loan: usize
  since: usize
  // The operand of the consuming node that carried the loan to it, or `usize.MAX`.
  operand: usize
  // A read carries only definitions reaching that read, even after a later join or call.
  definition: usize
  read: usize
  // Where in the carrying value the loan is held: a `Walker.paths` entry naming the sub-place the
  // loan lies somewhere within (entry 0 is the whole value), or `usize.MAX` when that is unknown.
  field: usize
  // Whether the sub-place `field` names is the loan's own reference, only moved, copied or placed
  // since the borrow: no projection, call or read through it, so it is still typed as the borrow.
  direct: bool
}

impl Copy for Carry {}

struct Flow {
  at: usize
  carried: List<Carry>
}

// The written place a node names: its root local, whether it is reached through a reference, its
// projection path with a `referent` step per dereference, and the index operands to evaluate
// first, in order.
struct Path {
  root: usize
  through: bool
  steps: List<Step>
  indexes: List<NodeId>
  // The subject node of the innermost `match place` whose binding names this place, or
  // `usize.MAX`, and how many leading steps name that subject. The binding denotes the payload
  // the match selected only until the subject place is written or moved (MATCH-001).
  refiner: usize
  refinedDepth: usize
  // The subjects of the borrowing matches whose bindings name this place, outermost first.
  binders: List<usize>
}

// A holding exists when any recorded source definition reaches its corresponding read.
struct HoldingSource {
  definition: usize
  read: usize
}
impl Copy for HoldingSource {}

struct Holding {
  loan: usize
  holder: usize
  point: usize
  // Range in Walker.holdingSources; an empty range denotes an unconditional fresh loan.
  sources: usize
  sourceCount: usize
  // Where in the holder's value the loan is held, as `Carry.field` and `Carry.direct`.
  field: usize
  direct: bool
  // Whether the place that held the loan was overwritten: no later read of the holder reaches the
  // loan, yet a value read from that place still carries it, as typing relates the holder's whole
  // region to every loan it ever held there.
  shadowed: bool
  // Whether the loan reached this holder only through a value read from a shadowed place. The
  // holder's later reads need it only when that value was read after the loan's storage ended.
  inherited: bool
}

impl Copy for Holding {}

// The roots a lexical scope releases on every path out of it. A statement scope holds only the
// hidden owners of the temporaries its statement, condition, guard or short-circuit operand
// borrows (BORROW-006); bindings belong to the nearest enclosing ordinary scope. `expiring` roots
// stop being valid here while their storage and cleanup stay with an enclosing scope.
struct Scope {
  roots: List<usize>
  expiring: List<usize>
  statement: bool
}

/// The borrowed regions an initialized owner can observe during cleanup. Structural cleanup
/// observes only hook-bearing components, rather than every field of an aggregate.
pub struct LoanCleanup {
  pub regions: List<Shared<Lifetime>>
  pub unknown: bool
}

// Cleanup seen before a later definition in the same loop cannot observe that definition with
// the walk's forward-only interval recording. Keep that body unchecked until this is modeled.
struct LoopCleanup {
  holder: usize
  repeat: usize
}

impl Copy for LoopCleanup {}

// These are pending local validity requirements. They may keep a carried source live; they
// cannot prove their own validity and are never actual-parent or universal-premise edges.
struct RetentionEdge {
  source: usize
  extent: usize
}
impl Copy for RetentionEdge {}

fn retentionOrdinal(region: &Shared<Lifetime>, owner: &DeclarationId) -> usize {
  return Shared<Lifetime>.with<usize>(region, fn(value: &Lifetime) -> usize {
    if let Lifetime.Local {declaration, ordinal} = &value.* {
      if DeclarationId.equals(&declaration, owner) { return ordinal }
    }
    return usize.MAX
  })
}

effect fn localRetentionEdges(owner: &DeclarationId, obligations: &[SafetyObligation]) -> List<RetentionEdge>
! OutOfMemoryError ? &mut Allocator {
  let mut edges = List<RetentionEdge>.make()
  let mut at = usize.ZERO
  while at < obligations.length {
    if let SafetyObligation.RegionRelation {offered, wanted, inferredStatic, ..} = &obligations[at] {
      let pending = match &inferredStatic { Option<Shared<Lifetime>>.Some {..} => true _ => false }
      if !pending {
        let source = retentionOrdinal(&offered, owner)
        let extent = retentionOrdinal(&wanted, owner)
        if source != usize.MAX && extent != usize.MAX && source != extent {
          run List<RetentionEdge>.append(&mut edges, RetentionEdge {source: source, extent: extent})
        }
      }
    }
    at = at + usize.ONE
  }
  return move edges
}

fn retentionListed(values: &[usize], value: usize) -> bool {
  let mut at = usize.ZERO
  while at < values.length {
    if values[at] == value { return true }
    at = at + usize.ONE
  }
  return false
}

// A retained inner atom does not name this loan's own borrowed storage. Require both the actual
// outer borrow identity and its recorded region, and leave empty/unknown mappings untouched.
fn requiredLoan(loan: &Loan, owner: &DeclarationId, required: &[usize]) -> bool {
  if let Option<Shared<Lifetime>>.Some {value: borrowed} = &loan.borrowed {
    let ordinal = retentionOrdinal(&borrowed, owner)
    if ordinal != usize.MAX && retentionListed(required, ordinal) {
      let regions = List<Shared<Lifetime>>.asSlice(&loan.regions)
      let mut at = usize.ZERO
      while at < regions.length {
        if Lifetime.equalsShared(&regions[at], &borrowed) { return true }
        at = at + usize.ONE
      }
    }
  }
  return false
}

// Only retaining results with an unmatched actual local source need this closure. The finite
// goals are still separately checked against availability by localRelationsProved.
effect fn requiredRetainedRegions(loans: &[Loan], carried: &[Carry], named: &[Shared<Lifetime>],
  owner: &DeclarationId, edges: &[RetentionEdge]) -> List<usize> ! OutOfMemoryError ? &mut Allocator {
  let mut required = List<usize>.make()
  if edges.length == usize.ZERO { return move required }
  let mut missing = false
  let mut at = usize.ZERO
  while at < carried.length {
    let loan = &loans[carried[at].loan]
    if let Option<Shared<Lifetime>>.Some {value: borrowed} = &loan.borrowed {
      if retentionOrdinal(&borrowed, owner) != usize.MAX
        && !sharesAtom(List<Shared<Lifetime>>.asSlice(&loan.regions), named) { missing = true }
    }
    at = at + usize.ONE
  }
  if !missing { return move required }
  return run retentionClosure(named, owner, edges)
}

// Only a structural set of required ordinals; no source presence or proof is established here.
// Both the eager caller and C's guarded snapshot supply their own unmatched-source gate.
effect fn retentionClosure(named: &[Shared<Lifetime>], owner: &DeclarationId, edges: &[RetentionEdge]) -> List<usize>
! OutOfMemoryError ? &mut Allocator {
  let mut required = List<usize>.make()
  let mut at = usize.ZERO
  while at < named.length {
    let count = Lifetime.atomCount(&named[at])
    let mut part = usize.ZERO
    while part < count {
      let atom = Lifetime.atomAt(&named[at], part)
      let ordinal = retentionOrdinal(&atom, owner)
      if ordinal != usize.MAX && !retentionListed(List<usize>.asSlice(&required), ordinal) {
        run List<usize>.append(&mut required, ordinal)
      }
      part = part + usize.ONE
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < List<usize>.length(&required) {
    let entries = List<usize>.asSlice(&required)
    let extent = entries[at]
    let mut edge = usize.ZERO
    while edge < edges.length {
      if edges[edge].extent == extent && !retentionListed(List<usize>.asSlice(&required), edges[edge].source) {
        run List<usize>.append(&mut required, edges[edge].source)
      }
      edge = edge + usize.ONE
    }
    at = at + usize.ONE
  }
  return move required
}

// A write through a reference into storage the caller holds, or into a local, and the lifetime
// parameters of the body or a named enclosing declaration that its target's type names.
struct StoreWindow {
  span: Location
  regions: List<Shared<Lifetime>>
  // The local written, or `usize.MAX` for a write through a reference.
  holder: usize
}

// Immutable policy evidence for the accepted owned-storage escape refutation. Window
// production owns actual encounter/applicability; these predicates never resolve addresses.
struct EscapeSources<'proof> {
  loans: &'proof [Loan]
  activity: Option<&'proof [SourceTruth]>
  stores: &'proof [StoreWindow]
  returns: &'proof [StoreWindow]
  sealed: &'proof [Location]
  unheld: &'proof [Location]
  escaping: &'proof [usize]
}

struct EscapeResult {
  loan: usize
  unresolved: bool
}

struct SourceEscapeWindow {
  evaluation: SourceGraph.EvalId
  point: SourceControl.PointId
  returned: bool
  window: StoreWindow
}

struct SourceEscapeSite {
  evaluation: SourceGraph.EvalId
  active: SourceAtom
  span: Location
  sealed: bool
}

struct SourceEscapingLocal {
  evaluation: SourceGraph.EvalId
  point: SourceControl.PointId
  local: usize
}

struct SourceEscapeInventory {
  windows: List<SourceEscapeWindow>
  sites: List<SourceEscapeSite>
  escaping: List<SourceEscapingLocal>
}

fn escapeSources<'proof>(walker: &'proof Walker) -> EscapeSources<'proof> {
  return EscapeSources {loans: List<Loan>.asSlice(&walker.loans), activity: Option<&[SourceTruth]>.none(),
    stores: List<StoreWindow>.asSlice(&walker.stores), returns: List<StoreWindow>.asSlice(&walker.returns),
    sealed: List<Location>.asSlice(&walker.sealed), unheld: List<Location>.asSlice(&walker.unheld),
    escaping: List<usize>.asSlice(&walker.escaping)}
}

fn sourceEscapeSources<'proof>(settled: &'proof SourceSettledLoans, stores: &'proof [StoreWindow],
  returns: &'proof [StoreWindow], sealed: &'proof [Location], unheld: &'proof [Location], escaping: &'proof [usize])
  -> EscapeSources<'proof> {
  return EscapeSources {loans: List<Loan>.asSlice(&settled.loans),
    activity: Option<&[SourceTruth]>.some(List<SourceTruth>.asSlice(&settled.activity)), stores: stores, returns: returns,
    sealed: sealed, unheld: unheld, escaping: escaping}
}

// A whole-value hold `finish` gave a result: the loan and the result node. Only a call its
// signature `described` bounds where in the result the loan can lie.
struct WholeHold {
  loan: usize
  result: NodeId
  described: bool
}

// A signature-retained source after a concrete call/construction point. The source predicate is
// the actual paired definition/read of that carry, not a union of unrelated reaching alternatives.
enum CallerSource { Absent, Actual, Unknown }

struct CallerRetention {
  loan: usize
  point: usize
  definition: usize
  read: usize
}

struct Walker {
  callerRetentions: List<CallerRetention>
  // The Supplied atoms this body's own selected application binds its region parameters to.
  // They name caller regions valid for the whole invocation; every other Supplied atom stays open.
  supplied: List<Shared<Lifetime>>
  // Per local, whether it is an `effect` block's value not yet used: one never run or used keeps
  // the loans of its captures until its scope ends (EFFECT-OWN-001), as the bootstrap's fallback
  // end does. An unrun `effect fn` call's argument loans end at the call, as they do there.
  unrun: List<bool>
  points: List<Point>
  loans: List<Loan>
  events: List<Event>
  frames: List<Frame>
  loops: List<Loop>
  // Per local, the loans it holds; empty for a local that holds none.
  held: List<List<usize>>
  definitions: List<Holding>
  holdingSources: List<HoldingSource>
  scopes: List<Scope>
  localCount: usize
  cleanup: List<LoanCleanup>
  loopCleanup: List<LoopCleanup>
  exit: usize
  // The point before the body's first evaluation, where no place is moved and no loan is live.
  entry: usize
  outside: bool
  // Why the walk left the checked slice, once `outside` is set.
  reason: BorrowStatus
  // The binding roots of the consuming matches whose guards are being walked, innermost last.
  guarded: List<usize>
  // The first move or drop of a guarded binding root: a guard consumed a provisional binding.
  guardConsumed: Option<Location>
  // How lowering keeps the temporaries of the binding initializer or `let` subject being walked.
  retention: Retention
  // Pending finite requirements used only to retain carried sources, never to prove ancestry.
  requirements: List<RetentionEdge>
  // Whether typing retained no capture contents, so body loan regions are related only by
  // equality, the facts the body's types imply, and `retentionRelations`.
  settled: bool
  // Open relations used only to conservatively retain possible source loans, never proof premises.
  retentionRelations: List<ImpliedGroup>
  // Every whole-value hold of a loan a result took, for narrowing a later read within it.
  wholeHolds: List<WholeHold>
  // Atoms of the local regions a retained open contents bound names: values of unknown regions
  // enter them, so no symbolic proof relates them to a universal target.
  openContents: List<Shared<Lifetime>>
  // Loans a call result dropped because it names only caller regions, which a body region cannot
  // outlive. A proof that such a loan's region outlives a universal region contradicts the drop:
  // the walk no longer sees where the loan goes, so it must be free of conflicts wherever its
  // creation reaches, as an escaping loan is.
  unretained: List<usize>
  // Whether a captured loan with no typed region reached a callable that can store through a type
  // parameter this walk cannot see. The walk continues, so a definite conflict among exact loans
  // still rejects, but the body is never Checked: where the callable stores it is unknown.
  storing: bool
  // The status of the first anonymous body this one constructs that the borrow check did not close,
  // or `Checked`. Nothing reports an anonymous body on its own, so this body claims no more.
  inherited: BorrowStatus
  // The loans a constructed callable carries whose body may store them where it can write.
  storable: List<usize>
  // Atoms of the regions an unretained loan's proof walks, once an access conflicts with a loan
  // that proof grounds on after the drop: none of them outlives a universal region.
  contested: List<Shared<Lifetime>>
  // Each `match place` and the point after its subject access, where it selects its arm.
  refinements: List<Refinement>
  // The binding slots of borrowed destructuring `let`s: each keeps its loan until its scope ends.
  lexicalHolders: List<usize>
  // The field paths `Carry.field` names; entry 0 is the empty path of a whole value.
  paths: List<List<Step>>
  // The writes through a reference and into locals: each statement's span and the universal
  // lifetime parameters its target's type names (`escapingOwnedLoan`).
  stores: List<StoreWindow>
  // The `return` statements whose value's type names a universal lifetime parameter: the caller's
  // result slot, which `escapingOwnedLoan` reads only when no other conflict decides the body.
  returns: List<StoreWindow>
  // The calls whose result can retain no region: a returned value never holds what reaches them.
  sealed: List<Location>
  // The operands of direct calls whose result can hold nothing they carry (typing's `retained`): a
  // region goal admitted inside one relates the operand to the call's binder, which the callee's
  // signature keeps apart from its result, so no requirement on the result reaches the operand.
  unheld: List<Location>
  // The locals whose value a write through a reference stores.
  escaping: List<usize>
}

// A `match place` at `subject` selects the variant its bindings refine at point `test`.
struct Refinement {
  subject: usize
  test: usize
}

impl Copy for Refinement {}

// How lowering keeps a binding's temporaries (BORROW-006). It keeps every temporary of a viewing
// binding's initializer, and of a borrowing destructuring `let`'s subject, for the binding's scope;
// only a borrowed array of a viewing binding stays valid that long.
enum Retention {
  // The temporaries end with their statement, arm or operand.
  None,
  // Storage and cleanup end with the scope; every temporary but a borrowed array expires with its
  // statement.
  Arrays,
  // Storage and cleanup end with the scope; every temporary expires with its statement. A binding
  // typed by a type parameter may view at an instance, so its temporaries are kept this way too.
  Storage,
}

fn flowAt(at: usize) -> Flow {
  return Flow {at: at, carried: List<Carry>.make()}
}

effect fn copyBinders(binders: &[usize]) -> List<usize> ! OutOfMemoryError ? &mut Allocator {
  let mut copied = List<usize>.make()
  let mut at = usize.ZERO
  while at < binders.length {
    run List<usize>.append(&mut copied, binders[at])
    at = at + usize.ONE
  }
  return move copied
}

effect fn copySteps(steps: &[Step]) -> List<Step> ! OutOfMemoryError ? &mut Allocator {
  let mut copied = List<Step>.make()
  let mut at = usize.ZERO
  while at < steps.length {
    run List<Step>.append(&mut copied, steps[at])
    at = at + usize.ONE
  }
  return move copied
}

effect fn newPoint(walker: &mut Walker, from: usize) -> usize ! OutOfMemoryError ? &mut Allocator {
  let created = List<Point>.length(&walker.points)
  run List<Point>.append(&mut walker.points, Point {next: List<usize>.make(), uses: usize.MAX, read: usize.MAX, written: usize.MAX, defines: usize.MAX, initializes: usize.MAX, event: usize.MAX, span: Location.make(usize.ZERO, usize.ZERO)})
  run edge(&mut walker.*, from, created)
  return created
}

effect fn backEdge(walker: &mut Walker, repeat: usize, from: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  if from == usize.MAX {
    return ()
  }
  let mut loops = List<Loop>.asMutSlice(&mut walker.loops)
  run List<usize>.append(&mut loops[repeat].sources, from)
  let header = loops[repeat].header
  run edge(&mut walker.*, from, header)
  return ()
}

effect fn edge(walker: &mut Walker, from: usize, to: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  if from == usize.MAX || to == usize.MAX {
    return ()
  }
  let mut points = List<Point>.asMutSlice(&mut walker.points)
  run List<usize>.append(&mut points[from].next, to)
  return ()
}

// Ends the flight of carried loans at `at`, where their value is consumed.
effect fn consume(walker: &mut Walker, carried: &[Carry], at: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut index = usize.ZERO
  while index < carried.length {
    let carry = carried[index]
    let mut loans = List<Loan>.asMutSlice(&mut walker.loans)
    run List<Interval>.append(&mut loans[carry.loan].intervals, Interval {from: carry.since, to: at, definition: carry.definition, read: carry.read, cleanup: false})
    index = index + usize.ONE
  }
  return ()
}

effect fn appendCarried(target: &mut List<Carry>, source: &[Carry]) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < source.length {
    run List<Carry>.append(&mut target.*, source[at])
    at = at + usize.ONE
  }
  return ()
}

// Whether a carried loan borrows storage this body owns.
fn carriesLocal(walker: &Walker, carried: &[Carry]) -> bool {
  let loans = List<Loan>.asSlice(&walker.loans)
  let mut at = usize.ZERO
  while at < carried.length {
    if loans[carried[at].loan].local { return true }
    at = at + usize.ONE
  }
  return false
}

// The steps of the path `field` names.
effect fn copyPath(walker: &Walker, field: usize) -> List<Step> ! OutOfMemoryError ? &mut Allocator {
  let paths = List<List<Step>>.asSlice(&walker.paths)
  return run copySteps(List<Step>.asSlice(&paths[field]))
}

// Names `steps` as a field path; the empty path is entry 0.
effect fn internPath(walker: &mut Walker, steps: List<Step>) -> usize ! OutOfMemoryError ? &mut Allocator {
  if List<Step>.length(&steps) == usize.ZERO { return usize.ZERO }
  let index = List<List<Step>>.length(&walker.paths)
  run List<List<Step>>.append(&mut walker.paths, move steps)
  return index
}

// The path within its holder a read of `path` reaches: a read through a reference reaches the
// reference, which may lead anywhere its loans do.
effect fn readPath(walker: &mut Walker, path: &Path) -> usize ! OutOfMemoryError ? &mut Allocator {
  let steps = List<Step>.asSlice(&path.steps)
  let mut reached = List<Step>.make()
  let mut at = usize.ZERO
  while at < steps.length && steps[at].kind != StepKind.Referent {
    run List<Step>.append(&mut reached, steps[at])
    at = at + usize.ONE
  }
  return run internPath(&mut walker.*, move reached)
}

// Whether `steps` names one exact place: no computed index and no step through a reference.
fn exactPath(steps: &[Step]) -> bool {
  let mut at = usize.ZERO
  while at < steps.length {
    if steps[at].kind == StepKind.AnyElement || steps[at].kind == StepKind.RepeatedElement
      || steps[at].kind == StepKind.Referent { return false }
    at = at + usize.ONE
  }
  return true
}

// Whether two sub-places of one value may overlap: one contains the other. A computed index may
// name any element, and an unknown path may be anywhere.
fn pathsOverlap(walker: &Walker, left: usize, right: usize) -> bool {
  if left == usize.MAX || right == usize.MAX { return true }
  let paths = List<List<Step>>.asSlice(&walker.paths)
  let first = List<Step>.asSlice(&paths[left])
  let second = List<Step>.asSlice(&paths[right])
  let mut at = usize.ZERO
  while at < first.length && at < second.length {
    let indexed = (first[at].kind == StepKind.AnyElement || second[at].kind == StepKind.AnyElement
      || first[at].kind == StepKind.RepeatedElement || second[at].kind == StepKind.RepeatedElement)
      && (first[at].kind == StepKind.Element || first[at].kind == StepKind.AnyElement || first[at].kind == StepKind.RepeatedElement)
      && (second[at].kind == StepKind.Element || second[at].kind == StepKind.AnyElement || second[at].kind == StepKind.RepeatedElement)
    if !indexed && (first[at].kind != second[at].kind || first[at].ordinal != second[at].ordinal) { return false }
    at = at + usize.ONE
  }
  return true
}

// Whether overwriting the exact sub-place `written` discards a loan held at `field`: the loan lies
// within that place, so it left with the old value. A computed index may name another element, so
// a write through one discards nothing.
effect fn discards(walker: &Walker, written: &[Step], field: usize) -> bool ! OutOfMemoryError ? &mut Allocator {
  if field == usize.MAX || !exactPath(written) { return false }
  let held = run copyPath(walker, field)
  return pathContains(written, List<Step>.asSlice(&held))
}

// The path of `prefix` followed by the path `field` names: where a loan held somewhere within
// `field` lies once its value is stored at `prefix`. A loan whose field is unknown lies somewhere
// within `prefix`, so a read that contains `prefix` forwards it, and a narrower read that may reach
// it still carries it, unattributed: an unknown field errs toward rejection. A computed index
// leaves the element unknown, so the path is unknown too.
effect fn prefixedPath(walker: &mut Walker, prefix: &[Step], field: usize) -> usize ! OutOfMemoryError ? &mut Allocator {
  if field == usize.MAX && prefix.length == usize.ZERO { return usize.MAX }
  let mut steps = List<Step>.make()
  let mut at = usize.ZERO
  while at < prefix.length {
    if prefix[at].kind == StepKind.AnyElement || prefix[at].kind == StepKind.Referent { return usize.MAX }
    run List<Step>.append(&mut steps, prefix[at])
    at = at + usize.ONE
  }
  if field != usize.MAX {
    let tail = run copyPath(&walker.*, field)
    let listed = List<Step>.asSlice(&tail)
    at = usize.ZERO
    while at < listed.length {
      run List<Step>.append(&mut steps, listed[at])
      at = at + usize.ONE
    }
  }
  return run internPath(&mut walker.*, move steps)
}

// The path `field` names without its first `count` steps.
effect fn strippedPath(walker: &mut Walker, field: usize, count: usize) -> usize ! OutOfMemoryError ? &mut Allocator {
  let held = run copyPath(&walker.*, field)
  let listed = List<Step>.asSlice(&held)
  let mut steps = List<Step>.make()
  let mut at = count
  while at < listed.length {
    run List<Step>.append(&mut steps, listed[at])
    at = at + usize.ONE
  }
  return run internPath(&mut walker.*, move steps)
}

// Whether a read of the sub-place `read` contains the sub-place `held` a loan lies somewhere within,
// so the value read holds the loan. Elements are one place to a computed index.
fn pathContains(read: &[Step], held: &[Step]) -> bool {
  if read.length > held.length { return false }
  let mut at = usize.ZERO
  while at < read.length {
    let left = read[at]
    let right = held[at]
    if right.kind == StepKind.AnyElement { return false }
    let anyElement = left.kind == StepKind.AnyElement && right.kind == StepKind.Element
    if !anyElement && (left.kind != right.kind || left.ordinal != right.ordinal) { return false }
    at = at + usize.ONE
  }
  return true
}

// Selecting any element of a repeated value carries the same nested loans. Unlike
// pathContains (also used by writes), this does not claim the selection replaces every copy.
fn readContains(read: &[Step], held: &[Step]) -> bool {
  if read.length > held.length { return false }
  let mut at = usize.ZERO
  while at < read.length {
    let left = read[at]
    let right = held[at]
    if right.kind == StepKind.AnyElement { return false }
    let selectedRepeat = right.kind == StepKind.RepeatedElement
      && (left.kind == StepKind.Element || left.kind == StepKind.AnyElement)
    let anyElement = left.kind == StepKind.AnyElement && right.kind == StepKind.Element
    if !selectedRepeat && !anyElement && !sameStep(left, right) { return false }
    at = at + usize.ONE
  }
  return true
}

// Record each crossing; its proof later follows the actual storage parent.
fn cross(walker: &mut Walker, carried: &[Carry]) -> () {
  let mut loans = List<Loan>.asMutSlice(&mut walker.loans)
  let mut at = usize.ZERO
  while at < carried.length {
    if !loans[carried[at].loan].local { loans[carried[at].loan].crossed = true }
    at = at + usize.ONE
  }
  return ()
}

// Ends the loans one path carries at its end `end` and restarts them at the join `joined`. Points
// are numbered in creation order, not by path, so a joined value's carries restart at the join. A
// path that ends at `usize.MAX` never reaches the join.
effect fn rejoin(walker: &mut Walker, carried: &[Carry], end: usize, joined: usize, onward: &mut List<Carry>) -> ()
! OutOfMemoryError ? &mut Allocator {
  if end == usize.MAX {
    return ()
  }
  cross(&mut walker.*, carried)
  run consume(&mut walker.*, carried, end)
  let mut at = usize.ZERO
  while at < carried.length {
    run List<Carry>.append(&mut onward.*, Carry {loan: carried[at].loan, since: joined, operand: usize.MAX, definition: carried[at].definition, read: carried[at].read, field: carried[at].field, direct: carried[at].direct})
    at = at + usize.ONE
  }
  return ()
}

// Appends the loans one operand carries, marked with that operand's position.
effect fn appendOperand(target: &mut List<Carry>, source: &[Carry], operand: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < source.length {
    run List<Carry>.append(&mut target.*, Carry {loan: source[at].loan, since: source[at].since, operand: operand, definition: source[at].definition, read: source[at].read, field: source[at].field, direct: source[at].direct})
    at = at + usize.ONE
  }
  return ()
}

// Whether a value of `ty` can retain an alias loan, including static regions; unknown counts as retained.
effect fn retains(ty: &Shared<Type>, owner: &DeclarationId) -> bool ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut regions = List<Shared<Lifetime>>.make()
  let known = run bodyRetainedRegions(ty, owner, &mut regions)
  return !known || List<Shared<Lifetime>>.length(&regions) > usize.ZERO
}

// Appends the regions a value of `ty` can retain; `false` when they are unknown.
effect fn retainedBy(ty: &Shared<Type>, owner: &DeclarationId, regions: &mut List<Shared<Lifetime>>) -> bool
! OutOfMemoryError ? &mut Allocator {
  let representations = List<Option<Shared<Type>>>.make()
  return run Type.retainedRegions(ty, owner, List<Option<Shared<Type>>>.asSlice(&representations), &mut regions.*, true)
}

fn expressionType(nodes: &[Node], id: NodeId) -> Option<Shared<Type>> {
  if let NodeKind.Expression {ty, ..} = &nodes[id.index].kind {
    return Option<Shared<Type>>.some(Shared<Type>.clone(&ty))
  }
  return Option<Shared<Type>>.none()
}

// Whether `id`'s value can retain a non-static region; a statement node retains nothing. A callable
// value may hold capture loans its type does not name, so it always counts as retaining.
effect fn nodeRetains(nodes: &[Node], id: NodeId, owner: &DeclarationId) -> bool ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let found = expressionType(nodes, id)
  if let Option<Shared<Type>>.Some {value} = move found {
    if Shared<Type>.with<bool>(&value, callableValue) {
      return true
    }
    let retained = run retains(&value, owner)
    return retained
  }
  return false
}

// Whether a type is a fixed array, whose aggregate operands are its elements.
fn arrayType(node: &Type) -> bool {
  return match &node.* {
    Type.Array {..} => true
    _ => false
  }
}

// Whether `id` is a slice view, whose elements lie behind it rather than in its own storage.
fn sliceValue(nodes: &[Node], id: NodeId) -> bool {
  if let Option<Shared<Type>>.Some {value} = move expressionType(nodes, id) {
    return Shared<Type>.with<bool>(&value, fn(node: &Type) -> bool {
      return match &node.* {
        Type.Slice {..} => true
        _ => false
      }
    })
  }
  return false
}

// Reads the written place of `id`, or a path with root `usize.MAX` when it names no place.
effect fn pathOf(nodes: &[Node], id: NodeId) -> Path ! OutOfMemoryError ? &mut Allocator {
  let mut path = Path {root: usize.MAX, through: false, steps: List<Step>.make(), indexes: List<NodeId>.make(), refiner: usize.MAX, refinedDepth: usize.ZERO, binders: List<usize>.make()}
  run extendPath(nodes, id, usize.MAX, &mut path)
  return move path
}

// Reads the place `id` names when the value of `base`, which names no place, is held by its hidden
// owner (BORROW-006): `base`'s projections, indexes and dereferences extend that owner's root.
effect fn temporaryPath(nodes: &[Node], id: NodeId, base: NodeId) -> Path ! OutOfMemoryError ? &mut Allocator {
  let mut path = Path {root: usize.MAX, through: false, steps: List<Step>.make(), indexes: List<NodeId>.make(), refiner: usize.MAX, refinedDepth: usize.ZERO, binders: List<usize>.make()}
  run extendPath(nodes, id, base.index, &mut path)
  return move path
}

// The innermost operand of a place expression's projections, indexes and dereferences.
fn projectedBase(nodes: &[Node], id: NodeId) -> NodeId {
  if let NodeKind.Expression {form, ..} = &nodes[id.index].kind {
    return match &form {
      Expression.Field {value, ..} => projectedBase(nodes, value)
      Expression.Index {value, ..} => projectedBase(nodes, value)
      Expression.Dereference {value} => projectedBase(nodes, value)
      _ => id
    }
  }
  return id
}

// The root of a temporary's hidden owner, keyed by the node that produces the temporary. It
// follows the match subject roots, so it overlaps no local or subject.
fn temporaryRoot(nodes: &[Node], base: usize) -> usize {
  return usize.MAX / 4 + nodes.length + base
}

// The holder of the loan a borrowing match at `subject` lends its arm bindings: a slot after the
// temporaries' with no storage of its own, so only uses of the bindings keep its loan live.
fn bindingsRoot(nodes: &[Node], subject: usize) -> usize {
  return usize.MAX / 4 + nodes.length + nodes.length + subject
}

// Whether `root` is a temporary's hidden owner.
fn temporary(nodes: &[Node], root: usize) -> bool {
  return root >= usize.MAX / 4 + nodes.length && root < usize.MAX / 4 + nodes.length + nodes.length
}

/// Which storage the loan walk ends beside the locals, by holder slot: slot `n` is the subject of a
/// match at node `n`, and slot `nodes.length + n` the hidden owner of the temporary node `n` a
/// borrow lends or a projection reads (BORROW-006). Their cleanup is observed like a local's.
pub effect fn storageNodes(nodes: &[Node]) -> List<bool> ! OutOfMemoryError ? &mut Allocator {
  let mut owning = List<bool>.make()
  let mut at = usize.ZERO
  while at < nodes.length + nodes.length {
    run List<bool>.append(&mut owning, false)
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < nodes.length {
    let mut owned = usize.MAX
    if let NodeKind.Expression {form, ..} = &nodes[at].kind {
      match &form {
        Expression.Match {subject, ..} => { owned = subject.index }
        Expression.Borrow {value, ..} => {
          let path = run pathOf(nodes, value)
          if path.root == usize.MAX { owned = nodes.length + projectedBase(nodes, value).index }
        }
        // A projection out of a value with no place may read it through its hidden owner.
        Expression.Field {..} => {
          let path = run pathOf(nodes, NodeId {index: at})
          if path.root == usize.MAX { owned = nodes.length + projectedBase(nodes, NodeId {index: at}).index }
        }
        Expression.Index {..} => {
          let path = run pathOf(nodes, NodeId {index: at})
          if path.root == usize.MAX { owned = nodes.length + projectedBase(nodes, NodeId {index: at}).index }
        }
        _ => {}
      }
    }
    if owned != usize.MAX {
      let mut marked = List<bool>.asMutSlice(&mut owning)
      marked[owned] = true
    }
    at = at + usize.ONE
  }
  return move owning
}

effect fn extendPath(nodes: &[Node], id: NodeId, temporary: usize, path: &mut Path) -> () ! OutOfMemoryError ? &mut Allocator {
  if id.index == temporary {
    path.root = temporaryRoot(nodes, temporary)
    return ()
  }
  if let NodeKind.Expression {form, ..} = &nodes[id.index].kind {
    match &form {
      Expression.Local {local} => {
        path.root = local.index
        return ()
      }
      Expression.Field {value, index, ..} => {
        run extendPath(nodes, value, temporary, &mut path.*)
        if path.root != usize.MAX {
          run List<Step>.append(&mut path.steps, fieldStep(index))
        }
        return ()
      }
      Expression.Index {value, index, element} => {
        run extendPath(nodes, value, temporary, &mut path.*)
        if path.root != usize.MAX {
          // A slice's elements live in its referent: indexing one reads through the slice as `.*`
          // does, so it reads the holder and keeps the loans it holds live.
          if sliceValue(nodes, value) {
            run List<Step>.append(&mut path.steps, referent())
            path.through = true
          }
          // A literal in-bounds index of a fixed array names its static element, the component a
          // move of it leaves; any other index may name every element.
          let mut step = anyElement()
          if element != usize.MAX { step = elementStep(element) }
          run List<Step>.append(&mut path.steps, step)
          run List<NodeId>.append(&mut path.indexes, index)
        }
        return ()
      }
      Expression.Dereference {value} => {
        run extendPath(nodes, value, temporary, &mut path.*)
        if path.root != usize.MAX {
          run List<Step>.append(&mut path.steps, referent())
          path.through = true
        }
        return ()
      }
      Expression.PatternBinding {subject, path: steps, access, ..} => {
        run bindingPath(nodes, subject, List<PlaceStep>.asSlice(&steps), access, &mut path.*)
        return ()
      }
      _ => {}
    }
  }
  return ()
}

fn guardedRoot(guarded: &[usize], root: usize) -> bool {
  let mut at = usize.ZERO
  while at < guarded.length {
    if guarded[at] == root { return true }
    at = at + usize.ONE
  }
  return false
}

// The root of the parts a match subject holds when it is not a place of this body: the subject was
// copied, consumed or evaluated into storage of its own, so it overlaps no local.
fn subjectRoot(subject: NodeId) -> usize {
  return usize.MAX / 4 + subject.index
}

// The place a pattern binding names. A place-addressing binding (`match place`, `&`, `&mut`) is a
// projection of the subject's own place; a copied or moved binding, or a binding of a subject with no
// place, is a projection of the subject's own storage. The subject's index operands were evaluated
// with the match, so the binding re-evaluates none.
effect fn bindingPath(nodes: &[Node], subject: NodeId, steps: &[PlaceStep], access: BindingAccess, path: &mut Path) -> ()
! OutOfMemoryError ? &mut Allocator {
  if access == BindingAccess.Place || access == BindingAccess.Shared || access == BindingAccess.Exclusive {
    let base = run pathOf(nodes, subject)
    if base.root != usize.MAX {
      path.root = base.root
      path.through = base.through
      path.refiner = base.refiner
      path.refinedDepth = base.refinedDepth
      if access == BindingAccess.Place {
        path.refiner = subject.index
        path.refinedDepth = List<Step>.length(&base.steps)
      }
      path.steps = move base.steps
      path.binders = move base.binders
    }
    // A borrowed binding reaches what its match lends to the arm: the subject place, or the
    // storage a subject with no place borrows.
    if access != BindingAccess.Place { run List<usize>.append(&mut path.binders, subject.index) }
  }
  if path.root == usize.MAX {
    path.root = subjectRoot(subject)
  }
  let mut at = usize.ZERO
  while at < steps.length {
    match &steps[at] {
      PlaceStep.Member {tag, ..} => { run List<Step>.append(&mut path.steps, memberStep(tag)) }
      PlaceStep.VariantField {tag, field} => {
        run List<Step>.append(&mut path.steps, memberStep(tag))
        run List<Step>.append(&mut path.steps, fieldStep(field))
      }
      PlaceStep.Field {index} => { run List<Step>.append(&mut path.steps, fieldStep(index)) }
      PlaceStep.Element {index} => { run List<Step>.append(&mut path.steps, elementStep(index)) }
    }
    at = at + usize.ONE
  }
  return ()
}

// The overlap of two places: 0 disjoint, 1 overlapping, 2 decided only by an unknown index.
fn overlap(left: &Place, right: &Place) -> usize {
  if left.root != right.root {
    return usize.ZERO
  }
  let first = List<Step>.asSlice(&left.steps)
  let second = List<Step>.asSlice(&right.steps)
  let mut unknown = false
  let mut at = usize.ZERO
  while at < first.length && at < second.length {
    if first[at].kind == StepKind.AnyElement || second[at].kind == StepKind.AnyElement {
      unknown = true
    } else if !sameStep(first[at], second[at]) {
      return usize.ZERO
    }
    at = at + usize.ONE
  }
  if unknown {
    return 2
  }
  return usize.ONE
}

// Whether an access through the bindings of `binders` reaches `loan`'s place by the loan itself.
fn lentTo(loan: &Loan, binders: &List<usize>) -> bool {
  if loan.binder == usize.MAX { return false }
  let through = List<usize>.asSlice(binders)
  let mut at = usize.ZERO
  while at < through.length {
    if through[at] == loan.binder { return true }
    at = at + usize.ONE
  }
  return false
}

// Whether a place names no element by an unknown index.
fn determined(place: &Place) -> bool {
  let steps = List<Step>.asSlice(&place.steps)
  let mut at = usize.ZERO
  while at < steps.length {
    if steps[at].kind == StepKind.AnyElement { return false }
    at = at + usize.ONE
  }
  return true
}

// Whether an access may replace the value of its place: a write, a move or drop, or an exclusive
// borrow or update, through which a callee or a later store can replace it.
fn replaces(kind: Kind) -> bool {
  return kind == Kind.Write || kind == Kind.Move || kind == Kind.Drop || kind == Kind.ExclusiveBorrow || kind == Kind.Update
}

// Whether `written` may name the first `depth` steps of `used`, or a prefix of them: replacing it
// replaces the subject a refined binding of `used` was selected from. An unknown index may name
// the refined element.
fn coversRefined(written: &Place, used: &Place, depth: usize) -> bool {
  if written.root != used.root { return false }
  let first = List<Step>.asSlice(&written.steps)
  let second = List<Step>.asSlice(&used.steps)
  if first.length > depth || depth > second.length { return false }
  let mut at = usize.ZERO
  while at < first.length {
    let indexed = first[at].kind == StepKind.AnyElement
      && (second[at].kind == StepKind.Element || second[at].kind == StepKind.AnyElement)
    if !indexed && !sameStep(first[at], second[at]) { return false }
    at = at + usize.ONE
  }
  return true
}

// The points control can reach from point `from` without passing `test`, where the match selects
// its variant again. Back edges count: a later iteration of a loop in the arm reaches it.
effect fn reachableAvoiding(points: &[Point], from: usize, test: usize) -> List<bool> ! OutOfMemoryError ? &mut Allocator {
  let mut seen = List<bool>.make()
  let mut at = usize.ZERO
  while at < points.length {
    run List<bool>.append(&mut seen, false)
    at = at + usize.ONE
  }
  let mut pending = List<usize>.make()
  run List<usize>.append(&mut pending, from)
  while List<usize>.length(&pending) > usize.ZERO {
    let last = List<usize>.length(&pending) - usize.ONE
    let point = List<usize>.remove(&mut pending, last)
    let next = List<usize>.asSlice(&points[point].next)
    let mut successor = usize.ZERO
    while successor < next.length {
      let target = next[successor]
      if !List<bool>.asSlice(&seen)[target] {
        let mut marked = List<bool>.asMutSlice(&mut seen)
        marked[target] = true
        if target != test { run List<usize>.append(&mut pending, target) }
      }
      successor = successor + usize.ONE
    }
  }
  return move seen
}

// The points one replacement reaches before its match selects again, computed once per pair.
struct ReplacementReach {
  source: usize
  test: usize
  seen: List<bool>
}

// Whether `loan` is live at `point` by its `until`: the point lies on a path from where the loan is
// taken to that end.
effect fn liveUntil(points: &[Point], reaches: &mut List<ReplacementReach>, loan: &Loan, point: usize) -> bool
! OutOfMemoryError ? &mut Allocator {
  let taken = run reachesAvoiding(points, &mut reaches.*, loan.created, point, usize.MAX)
  if !taken { return false }
  return run reachesAvoiding(points, &mut reaches.*, point, loan.until, usize.MAX)
}

// Whether control can pass from replacement point `from` to point `to` without passing `test`.
effect fn reachesAvoiding(points: &[Point], reaches: &mut List<ReplacementReach>, from: usize, to: usize, test: usize) -> bool
! OutOfMemoryError ? &mut Allocator {
  let known = List<ReplacementReach>.asSlice(&reaches.*)
  let mut at = usize.ZERO
  while at < known.length {
    if known[at].source == from && known[at].test == test { return List<bool>.asSlice(&known[at].seen)[to] }
    at = at + usize.ONE
  }
  let seen = run reachableAvoiding(points, from, test)
  let reached = List<bool>.asSlice(&seen)[to]
  run List<ReplacementReach>.append(&mut reaches.*, ReplacementReach {source: from, test: test, seen: move seen})
  return reached
}

// The point where the `match place` at `subject` selects its variant, or `usize.MAX`.
fn refinementTest(refinements: &[Refinement], subject: usize) -> usize {
  let mut at = usize.ZERO
  while at < refinements.length {
    if refinements[at].subject == subject { return refinements[at].test }
    at = at + usize.ONE
  }
  return usize.MAX
}

// Every access kind, for the codes an access can report.
effect fn everyKind() -> List<Kind> ! OutOfMemoryError ? &mut Allocator {
  let mut kinds = List<Kind>.make()
  run List<Kind>.append(&mut kinds, Kind.Read)
  run List<Kind>.append(&mut kinds, Kind.Write)
  run List<Kind>.append(&mut kinds, Kind.Move)
  run List<Kind>.append(&mut kinds, Kind.Drop)
  run List<Kind>.append(&mut kinds, Kind.SharedBorrow)
  run List<Kind>.append(&mut kinds, Kind.ExclusiveBorrow)
  run List<Kind>.append(&mut kinds, Kind.Update)
  run List<Kind>.append(&mut kinds, Kind.Inspect)
  run List<Kind>.append(&mut kinds, Kind.End)
  run List<Kind>.append(&mut kinds, Kind.Expire)
  return move kinds
}

// The code for a use of a loan's view after the loan expired.
fn expiredCode() -> RejectionCode {
  return RejectionCode.ExpiredLifetime
}

/// The codes loan liveness reports: every code an access conflicting with a live loan reports, and
/// the code of a use after a loan expired. A body that is not borrow-checked has not had its loan
/// lifetimes proved, so these are the codes it may be missing; its moves are checked regardless.
pub effect fn livenessCodes() -> List<RejectionCode> ! OutOfMemoryError ? &mut Allocator {
  let mut codes = List<RejectionCode>.make()
  run List<RejectionCode>.append(&mut codes, expiredCode())
  let every = run everyKind()
  let kinds = List<Kind>.asSlice(&every)
  let mut at = usize.ZERO
  while at < kinds.length {
    let mut exclusive = 0
    while exclusive < 2 {
      if let Option<RejectionCode>.Some {value} = move conflictCode(kinds[at], exclusive == 1) {
        let listed = List<RejectionCode>.asSlice(&codes)
        let mut seen = false
        let mut look = usize.ZERO
        while look < listed.length {
          if listed[look] == value { seen = true }
          look = look + usize.ONE
        }
        if !seen { run List<RejectionCode>.append(&mut codes, value) }
      }
      exclusive = exclusive + 1
    }
    at = at + usize.ONE
  }
  return move codes
}

fn conflictCode(kind: Kind, exclusive: bool) -> Option<RejectionCode> {
  if kind == Kind.ExclusiveBorrow || (kind == Kind.SharedBorrow && exclusive) {
    return Option<RejectionCode>.some(RejectionCode.LoanConflict)
  }
  if kind == Kind.Write || kind == Kind.Move || kind == Kind.Drop || kind == Kind.Update || kind == Kind.Inspect
    || (kind == Kind.Read && exclusive) {
    return Option<RejectionCode>.some(RejectionCode.AccessDuringLoan)
  }
  return Option<RejectionCode>.none()
}

// Records an access to a written place at a fresh point after `at`.
effect fn access(walker: &mut Walker, path: &Path, kind: Kind, span: Location, at: usize, loan: usize) -> usize
! OutOfMemoryError ? &mut Allocator {
  if (kind == Kind.Move || kind == Kind.Drop) && guardedRoot(List<usize>.asSlice(&walker.guarded), path.root) {
    if let Option<Location>.None = &walker.guardConsumed { walker.guardConsumed = Option<Location>.some(span) }
  }
  let point = run newPoint(&mut walker.*, at)
  let holder = holderOf(&walker.*, path.root)
  let read = run readPath(&mut walker.*, path)
  if kind != Kind.Write && kind != Kind.End && kind != Kind.Expire { usedEffect(&mut walker.*, holder) }
  let mut points = List<Point>.asMutSlice(&mut walker.points)
  points[point].event = List<Event>.length(&walker.events)
  points[point].span = span
  // Record reads independently of the definitions seen so far: a later loop assignment can
  // reach this access through the back edge. Slots with no eventual loans have no liveness bit.
  if kind != Kind.Write && kind != Kind.End && kind != Kind.Expire {
    points[point].uses = holder
    points[point].read = read
  }
  if (kind == Kind.Move || kind == Kind.Drop || kind == Kind.End) && List<Step>.length(&path.steps) == usize.ZERO {
    points[point].defines = holder
  }
  run List<Event>.append(
    &mut walker.events,
    Event {
      point: point,
      place: Place {root: path.root, steps: run copySteps(List<Step>.asSlice(&path.steps))},
      kind: kind,
      span: span,
      target: span,
      loan: loan,
      consumesTarget: usize.ZERO,
      refiner: path.refiner,
      refinedDepth: path.refinedDepth,
      binders: run copyBinders(List<usize>.asSlice(&path.binders)),
    },
  )
  return point
}

// A read of a holder local at a fresh point, reaching the path `read` within it: the value carries
// the loans it holds.
effect fn useHolder(walker: &mut Walker, root: usize, read: usize, span: Location, at: usize) -> Flow ! OutOfMemoryError ? &mut Allocator {
  let point = run newPoint(&mut walker.*, at)
  let mut carried = List<Carry>.make()
  let local = holderOf(&walker.*, root)
  usedEffect(&mut walker.*, local)
  let mut points = List<Point>.asMutSlice(&mut walker.points)
  points[point].uses = local
  points[point].read = read
  points[point].span = span
  if !holds(&walker.*, root) { return Flow {at: point, carried: move carried} }
  let held = List<List<usize>>.asSlice(&walker.held)
  let definitions = List<usize>.asSlice(&held[local])
  let all = List<Holding>.asSlice(&walker.definitions)
  let mut at = usize.ZERO
  while at < definitions.length {
    let definition = definitions[at]
    run List<Carry>.append(&mut carried, Carry {loan: all[definition].loan, since: point, operand: usize.MAX, definition: definition, read: point, field: all[definition].field, direct: all[definition].direct})
    at = at + usize.ONE
  }
  return Flow {at: point, carried: move carried}
}

// The loans a read of `path` carries, each with where the value read holds it: a loan's field is
// kept only when the read contains where the loan is held, which a read through a reference reaches
// past its `Referent` step. The reference's own loan is held by the whole reference, which no such
// read contains. Anything else keeps an unknown field, which nothing forwards, except a read strictly
// within a call result's whole-value hold whose `declared` field type the loan provably cannot reach
// (`unreachableField`): that part of the result holds none of it.
effect fn attributeRead(nodes: &[Node], owner: &DeclarationId, walker: &mut Walker, path: &Path, carried: &[Carry],
  declared: &DeclaredRead) -> List<Carry>
! OutOfMemoryError ? &mut Allocator {
  let steps = List<Step>.asSlice(&path.steps)
  let mut read = List<Carry>.make()
  let mut index = usize.ZERO
  while index < carried.length {
    let mut carry = carried[index]
    let mut held = true
    if carry.field != usize.MAX {
      let heldPath = run copyPath(&walker.*, carry.field)
      let heldSteps = List<Step>.asSlice(&heldPath)
      if readContains(steps, heldSteps) {
        carry.field = run strippedPath(&mut walker.*, carry.field, steps.length)
      } else {
        carry.field = usize.MAX
        carry.direct = false
        if !path.through && disjointFields(steps, heldSteps) { held = false }
        if held && !path.through && declared.known && pathContains(heldSteps, steps)
          && !reborrowedByCarried(List<Loan>.asSlice(&walker.loans), carried, index) {
          held = !run unreachableField(nodes, owner, &walker.*, carry, List<Shared<Lifetime>>.asSlice(&declared.regions))
        }
      }
    }
    if held { run List<Carry>.append(&mut read, carry) }
    index = index + usize.ONE
  }
  return move read
}

// Different declared record fields store disjoint values, even when their lifetime arguments
// happen to be equal. Unknown elements and reference boundaries provide no such separation.
fn disjointFields(read: &[Step], held: &[Step]) -> bool {
  let mut at = usize.ZERO
  while at < read.length && at < held.length {
    if read[at].kind == StepKind.Field && held[at].kind == StepKind.Field
      && read[at].ordinal != held[at].ordinal { return true }
    if !sameStep(read[at], held[at]) || read[at].kind == StepKind.Referent { return false }
    at = at + usize.ONE
  }
  return false
}

// Whether another carried loan reborrows the loan `carried[index]` carries, so it stays live with it.
fn reborrowedByCarried(loans: &[Loan], carried: &[Carry], index: usize) -> bool {
  if let Option<Shared<Lifetime>>.Some {value: borrowed} = &loans[carried[index].loan].borrowed {
    let mut at = usize.ZERO
    while at < carried.length {
      if at != index {
        if let Option<Shared<Lifetime>>.Some {value: parent} = &loans[carried[at].loan].parent {
          if meetMember(&parent, &borrowed) { return true }
        }
      }
      at = at + usize.ONE
    }
  }
  return false
}

// Whether the loan `carry` carries provably lies in no part of a call result typed by `named`: the
// same test `finish` applies to a whole result, with the field's declared regions in place of the
// result's. The loan is exact, all its regions are body regions that no named region shares, it is
// no retained source outlives requirements need, and the facts every call that holds it implies
// (the body's open relations and the well-formedness of the call's argument and result types) lead
// none of its regions to a named region or outside the body. A hold no signature describes, such
// as a callable invocation's or a built value's, decides nothing.
effect fn unreachableField(nodes: &[Node], owner: &DeclarationId, walker: &Walker, carry: Carry, named: &[Shared<Lifetime>]) -> bool
! OutOfMemoryError ? &mut Allocator {
  let loans = List<Loan>.asSlice(&walker.loans)
  let loan = &loans[carry.loan]
  let regionsOf = List<Shared<Lifetime>>.asSlice(&loan.regions)
  if loan.precision != LoanPrecision.Exact || regionsOf.length == usize.ZERO || !bodyRegions(regionsOf, owner) || sharesAtom(regionsOf, named) {
    return false
  }
  let mut single = List<Carry>.make()
  run List<Carry>.append(&mut single, carry)
  let required = run requiredRetainedRegions(loans, List<Carry>.asSlice(&single), named, owner,
    List<RetentionEdge>.asSlice(&walker.requirements))
  if requiredLoan(loan, owner, List<usize>.asSlice(&required)) { return false }
  let mut implied = Implied {groups: List<ImpliedGroup>.make(), known: walker.settled}
  let holds = List<WholeHold>.asSlice(&walker.wholeHolds)
  let mut found = false
  let mut at = usize.ZERO
  while at < holds.length {
    if holds[at].loan == carry.loan {
      if !holds[at].described { return false }
      found = true
      let facts = run signatureImplied(nodes, List<ImpliedGroup>.asSlice(&walker.retentionRelations), walker.settled, holds[at].result)
      if !facts.known { implied.known = false }
      let groups = List<ImpliedGroup>.asSlice(&facts.groups)
      let mut group = usize.ZERO
      while group < groups.length {
        let mut members = List<Shared<Lifetime>>.make()
        run appendAllAtoms(&mut members, List<Shared<Lifetime>>.asSlice(&groups[group].members))
        let mut container = List<Shared<Lifetime>>.make()
        run appendAllAtoms(&mut container, List<Shared<Lifetime>>.asSlice(&groups[group].container))
        run List<ImpliedGroup>.append(&mut implied.groups, ImpliedGroup {container: move container, members: move members})
        group = group + usize.ONE
      }
    }
    at = at + usize.ONE
  }
  if !found || !implied.known { return false }
  return !run mayOutlive(&implied, regionsOf, named, owner)
}

// Where a reference to the sub-place `borrowed` of a holder holds a loan the holder holds at
// `field`: behind its `Referent` step, at the rest of the loan's path, when the borrowed place
// contains it. A loan the borrowed place does not contain travels with the reference unreachable.
effect fn referencedPath(walker: &mut Walker, borrowed: &[Step], field: usize) -> usize ! OutOfMemoryError ? &mut Allocator {
  if field == usize.MAX { return usize.MAX }
  let held = run copyPath(&walker.*, field)
  let listed = List<Step>.asSlice(&held)
  if !readContains(borrowed, listed) { return usize.MAX }
  let mut steps = List<Step>.make()
  run List<Step>.append(&mut steps, referent())
  let mut at = borrowed.length
  while at < listed.length {
    run List<Step>.append(&mut steps, listed[at])
    at = at + usize.ONE
  }
  return run internPath(&mut walker.*, move steps)
}

// Marks the replacement recorded at `point` when a move recorded since event `since` overlaps its
// target; the bootstrap then reports the whole `statement`.
fn markConsumedTarget(walker: &mut Walker, since: usize, point: usize, statement: Location) -> () {
  let recorded = List<Point>.asSlice(&walker.points)[point].event
  let mut events = List<Event>.asMutSlice(&mut walker.events)
  let mut at = since
  while at < recorded {
    if events[at].kind == Kind.Move || events[at].kind == Kind.Drop {
      let shared = overlap(&events[at].place, &events[recorded].place)
      if shared == usize.ONE || (shared != usize.ZERO && events[recorded].consumesTarget == usize.ZERO) {
        events[recorded].consumesTarget = shared
        events[recorded].span = statement
        events[recorded].target = statement
      }
    }
    at = at + usize.ONE
  }
  return ()
}

// An access to a place behind a reference. Reaching it reads the root holder, whose loans the
// result carries, and the access is recorded at the referent place.
effect fn throughReference(walker: &mut Walker, path: &Path, kind: Kind, span: Location, at: usize) -> Flow ! OutOfMemoryError ? &mut Allocator {
  let read = run readPath(&mut walker.*, path)
  let used = run useHolder(&mut walker.*, path.root, read, span, at)
  let point = run access(&mut walker.*, path, kind, span, used.at, usize.MAX)
  return Flow {at: point, carried: move used.carried}
}

// A use of a borrowed match binding: each match whose binding names `path` holds its loan through
// the use, so the loan lives exactly as long as its bindings do. The value read carries no such
// loan: a borrow of the binding lends the subject place itself.
effect fn useBinders(nodes: &[Node], walker: &mut Walker, path: &Path, span: Location, at: usize) -> usize ! OutOfMemoryError ? &mut Allocator {
  let binders = List<usize>.asSlice(&path.binders)
  let mut current = at
  let mut index = usize.ZERO
  while index < binders.length {
    let root = bindingsRoot(nodes, binders[index])
    if holds(&walker.*, root) {
      let holder = holderOf(&walker.*, root)
      current = run newPoint(&mut walker.*, current)
      let mut points = List<Point>.asMutSlice(&mut walker.points)
      points[current].uses = holder
      points[current].span = span
    }
    index = index + usize.ONE
  }
  return current
}

fn lexicalHolder(walker: &Walker, root: usize) -> bool {
  let holders = List<usize>.asSlice(&walker.lexicalHolders)
  let mut at = usize.ZERO
  while at < holders.length {
    if holders[at] == root { return true }
    at = at + usize.ONE
  }
  return false
}

// The reference a subject with no place dereferences or indexes as a slice beneath its field and
// index steps, or the subject itself when it does neither. Evaluating that reference and then `indexes`, the index
// operands of the steps above it, innermost first, evaluates the whole subject.
effect fn viewedReference(nodes: &[Node], subject: NodeId, indexes: &mut List<NodeId>) -> NodeId ! OutOfMemoryError ? &mut Allocator {
  let mut current = subject
  let mut reference = subject
  let mut steps = List<NodeId>.make()
  let mut walking = true
  while walking {
    walking = false
    if let NodeKind.Expression {form, ..} = &nodes[current.index].kind {
      match &form {
        Expression.Field {value, ..} => {
          current = value
          walking = true
        }
        Expression.Index {value, index, ..} => {
          run List<NodeId>.append(&mut steps, index)
          // A slice's elements live in its referent, so indexing it reads through it as `.*` does.
          if sliceValue(nodes, value) {
            reference = value
          } else {
            current = value
            walking = true
          }
        }
        Expression.Dereference {value} => { reference = value }
        _ => {}
      }
    }
  }
  if reference.index != subject.index {
    let walked = List<NodeId>.asSlice(&steps)
    let mut at = walked.length
    while at > usize.ZERO {
      at = at - usize.ONE
      run List<NodeId>.append(&mut indexes.*, walked[at])
    }
  }
  return reference
}

// Where a write to `target` is reported: the target place, or the reference a dereferenced target
// writes through, as the bootstrap reports them.
fn writtenSpan(nodes: &[Node], target: NodeId) -> Location {
  if let NodeKind.Expression {form: Expression.Dereference {value}, ..} = &nodes[target.index].kind {
    return nodes[value.index].origin.location
  }
  return nodes[target.index].origin.location
}

// Leaves the checked slice; the first reason is the one reported.
fn leave(walker: &mut Walker, reason: BorrowStatus) -> () {
  if !walker.outside {
    walker.outside = true
    walker.reason = reason
  }
  return ()
}

fn holderOf(walker: &Walker, root: usize) -> usize {
  if root >= usize.MAX / 4 {
    return walker.localCount + root - usize.MAX / 4
  }
  return root
}

// An `effect` block's value that is used is no longer held to the end of its scope.
fn usedEffect(walker: &mut Walker, local: usize) -> () {
  if local < List<bool>.length(&walker.unrun) {
    let mut unrun = List<bool>.asMutSlice(&mut walker.unrun)
    unrun[local] = false
  }
  return ()
}

fn holds(walker: &Walker, root: usize) -> bool {
  let local = holderOf(walker, root)
  let held = List<List<usize>>.asSlice(&walker.held)
  return local < held.length && List<usize>.length(&held[local]) > usize.ZERO
}

// Evaluates a place's index operands in order; each index value is consumed when it is read.
effect fn indexes(nodes: &[Node], locals: &[Local], owner: &DeclarationId, walker: &mut Walker, path: &Path, at: usize) -> usize
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let operands = List<NodeId>.asSlice(&path.indexes)
  let mut current = at
  let mut index = usize.ZERO
  while index < operands.length {
    let flow = run visit(nodes, locals, owner, &mut walker.*, operands[index], current)
    let point = run newPoint(&mut walker.*, flow.at)
    run consume(&mut walker.*, List<Carry>.asSlice(&flow.carried), point)
    current = point
    index = index + usize.ONE
  }
  return current
}

// Creates a loan of a written place at a fresh point, carried by the borrowing value. A reborrow
// through a reference is a loan of the referent place (BORROW-005): while it lives, an access
// through the parent reference conflicts with it as with any loan of that place.
effect fn borrow(nodes: &[Node], locals: &[Local], owner: &DeclarationId, walker: &mut Walker, place: NodeId, exclusive: bool, span: Location,
  node: usize, at: usize) -> Flow
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut path = run pathOf(nodes, place)
  let mut source = run borrowedPlaceLifetime(nodes, place)
  let mut current = at
  if path.root == usize.MAX {
    // A borrow of a value with no place lends its hidden owner (BORROW-006).
    let base = projectedBase(nodes, place)
    current = run holdTemporary(nodes, locals, owner, &mut walker.*, base, at)
    path = run temporaryPath(nodes, place, base)
  }
  // A slice borrow reborrows its backing storage; it never lends the local descriptor slot.
  // Reference reborrows already have an explicit typed Dereference from checkBorrowOperand.
  if node != usize.MAX && sliceValue(nodes, place) && sliceValue(nodes, NodeId {index: node}) {
    run List<Step>.append(&mut path.steps, referent())
    path.through = true
    source = run descriptorLifetime(nodes, place)
  }
  let mut evaluated = run indexes(nodes, locals, owner, &mut walker.*, &path, current)
  // A reference to a whole holder, or a reborrow through one, reaches what its loans borrow, so
  // the holder's loans travel with the reference: the parent loan outlives every reborrow of it,
  // and borrowing a callable to invoke it keeps its capture loans live.
  evaluated = run useBinders(nodes, &mut walker.*, &path, span, evaluated)
  let mut carried = List<Carry>.make()
  if holds(&walker.*, path.root) {
    let read = run readPath(&mut walker.*, &path)
    let used = run useHolder(&mut walker.*, path.root, read, span, evaluated)
    let travelling = List<Carry>.asSlice(&used.carried)
    let mut index = usize.ZERO
    while index < travelling.length {
      let mut carry = travelling[index]
      carry.field = run referencedPath(&mut walker.*, List<Step>.asSlice(&path.steps), carry.field)
      carry.direct = carry.direct && carry.field != usize.MAX
      run List<Carry>.append(&mut carried, carry)
      index = index + usize.ONE
    }
    evaluated = used.at
  }
  return run takeLoan(nodes, owner, &mut walker.*, &path, exclusive, span, node, move source, evaluated, move carried)
}

fn loanLifetime(ty: &Type) -> Option<Shared<Lifetime>> {
  return match &ty.* {
    Type.Reference {lifetime, ..} => Option<Shared<Lifetime>>.some(Shared<Lifetime>.clone(&lifetime))
    Type.Slice {lifetime, ..} => Option<Shared<Lifetime>>.some(Shared<Lifetime>.clone(&lifetime))
    _ => Option<Shared<Lifetime>>.none()
  }
}

fn nodeLoanLifetime(nodes: &[Node], node: NodeId) -> Option<Shared<Lifetime>> {
  if let Option<Shared<Type>>.Some {value} = move expressionType(nodes, node) {
    return Shared<Type>.with<Option<Shared<Lifetime>>>(&value, loanLifetime)
  }
  return Option<Shared<Lifetime>>.none()
}

// The meet of the descriptors that reach the borrowed storage, not a lifetime mentioned by a
// nested field's type. A reborrow through several references is valid only while each of them
// is. A shared descriptor is Copy, so its referent stays valid for its own lifetime whatever
// path reached it: the chain ends at the first shared one, and a shared reborrow through shared
// references keeps the innermost lifetime. A reference to a descriptor slot is bounded by the
// slot's place instead.
effect fn borrowedPlaceLifetime(nodes: &[Node], node: NodeId) -> Option<Shared<Lifetime>> ! OutOfMemoryError ? &mut Allocator {
  let mut chain = List<Shared<Lifetime>>.make()
  run placeDescriptors(nodes, node, &mut chain)
  return run descriptorMeet(List<Shared<Lifetime>>.asSlice(&chain))
}

// The bound of a reborrow of the storage `descriptor` itself views, such as a slice reborrow.
effect fn descriptorLifetime(nodes: &[Node], descriptor: NodeId) -> Option<Shared<Lifetime>> ! OutOfMemoryError ? &mut Allocator {
  let mut chain = List<Shared<Lifetime>>.make()
  run descriptorChain(nodes, descriptor, &mut chain)
  return run descriptorMeet(List<Shared<Lifetime>>.asSlice(&chain))
}

effect fn descriptorMeet(chain: &[Shared<Lifetime>]) -> Option<Shared<Lifetime>> ! OutOfMemoryError ? &mut Allocator {
  if chain.length == usize.ZERO { return Option<Shared<Lifetime>>.none() }
  return Option<Shared<Lifetime>>.some(run Lifetime.meet(chain))
}

effect fn placeDescriptors(nodes: &[Node], node: NodeId, chain: &mut List<Shared<Lifetime>>) -> () ! OutOfMemoryError ? &mut Allocator {
  return match &nodes[node.index].kind {
    NodeKind.Expression {form: Expression.Dereference {value}, ..} => run descriptorChain(nodes, value, &mut chain.*)
    NodeKind.Expression {form: Expression.Field {value, ..}, ..} => run placeDescriptors(nodes, value, &mut chain.*)
    NodeKind.Expression {form: Expression.Index {value, ..}, ..} => {
      if sliceValue(nodes, value) { return run descriptorChain(nodes, value, &mut chain.*) }
      return run placeDescriptors(nodes, value, &mut chain.*)
    }
    NodeKind.Expression {form: Expression.PatternBinding {subject, access, ..}, ..} => {
      if access == BindingAccess.Shared || access == BindingAccess.Exclusive { return run placeDescriptors(nodes, subject, &mut chain.*) }
      return ()
    }
    _ => ()
  }
}

// Appends one descriptor's lifetime and, unless it is shared, the descriptors its own place is
// reached through.
effect fn descriptorChain(nodes: &[Node], descriptor: NodeId, chain: &mut List<Shared<Lifetime>>) -> () ! OutOfMemoryError ? &mut Allocator {
  if let Option<Shared<Lifetime>>.Some {value} = move nodeLoanLifetime(nodes, descriptor) {
    run List<Shared<Lifetime>>.append(&mut chain.*, move value)
    if !sharedDescriptor(nodes, descriptor) { run placeDescriptors(nodes, descriptor, &mut chain.*) }
  }
  return ()
}

fn sharedDescriptor(nodes: &[Node], node: NodeId) -> bool {
  if let Option<Shared<Type>>.Some {value} = move expressionType(nodes, node) {
    return Shared<Type>.with<bool>(&value, fn(ty: &Type) -> bool {
      return match &ty.* {
        Type.Reference {access, ..} => access == Access.Shared
        Type.Slice {access, ..} => access == Access.Shared
        _ => false
      }
    })
  }
  return false
}

// Evaluates `base`, a value with no place, into its hidden owner and returns the point after it.
// The owner holds the loans that value carries and ends with the innermost statement, arm,
// condition, guard or short-circuit operand that evaluates it. In the initializer of a binding that
// can hold a view, lowering keeps every temporary for the binding's scope, so the owner's storage
// and cleanup end there; only a borrowed array stays valid that long, and any other temporary's
// loans expire with its statement (BORROW-006).
effect fn holdTemporary(nodes: &[Node], locals: &[Local], owner: &DeclarationId, walker: &mut Walker, base: NodeId, at: usize) -> usize
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let flow = run visit(nodes, locals, owner, &mut walker.*, base, at)
  let root = temporaryRoot(nodes, base.index)
  let point = run newPoint(&mut walker.*, flow.at)
  let holder = holderOf(&walker.*, root)
  let mut initialized = List<Point>.asMutSlice(&mut walker.points)
  initialized[point].initializes = root
  initialized[point].defines = holder
  let retention = walker.retention
  run registerTemporary(&mut walker.*, root, retention != Retention.None)
  if retention == Retention.Storage || (retention == Retention.Arrays && !arrayValue(nodes, base)) {
    let at = List<Scope>.length(&walker.scopes) - usize.ONE
    let mut scopes = List<Scope>.asMutSlice(&mut walker.scopes)
    run List<usize>.append(&mut scopes[at].expiring, root)
  }
  if List<Carry>.length(&flow.carried) > usize.ZERO {
    run consume(&mut walker.*, List<Carry>.asSlice(&flow.carried), point)
    let retained = run nodeRetains(nodes, base, owner)
    if retained {
      run hold(&mut walker.*, root, List<Carry>.asSlice(&flow.carried), point, true)
    }
  }
  return point
}

// Whether `id` is a fixed array value.
fn arrayValue(nodes: &[Node], id: NodeId) -> bool {
  if let Option<Shared<Type>>.Some {value} = move expressionType(nodes, id) {
    return Shared<Type>.with<bool>(&value, fn(node: &Type) -> bool {
      return match &node.* {
        Type.Array {..} => true
        _ => false
      }
    })
  }
  return false
}

// A captured exclusive descriptor's referent, reborrowed by the environment it was read into
// (CAPTURE-002). The loan's regions are the descriptor's, which the field keeps.
effect fn reborrowReferent(nodes: &[Node], owner: &DeclarationId, walker: &mut Walker, operand: NodeId, exclusive: bool, at: usize) -> Flow
! OutOfMemoryError ? &mut Allocator {
  let mut path = run pathOf(nodes, operand)
  if path.root == usize.MAX || path.through || List<Step>.length(&path.steps) > usize.ZERO {
    leave(&mut walker.*, BorrowStatus.StoredLoans)
    return flowAt(at)
  }
  run List<Step>.append(&mut path.steps, referent())
  path.through = true
  let span = nodes[operand.index].origin.location
  let source = nodeLoanLifetime(nodes, operand)
  return run takeLoan(nodes, owner, &mut walker.*, &path, exclusive, span, operand.index, move source, at, List<Carry>.make())
}

// The referent of a borrow typed as a reference.
fn loanReferent(value: &Type) -> Option<Shared<Type>> {
  return match &value.* {
    Type.Reference {referent, ..} => Option<Shared<Type>>.some(Shared<Type>.clone(&referent))
    _ => Option<Shared<Type>>.none()
  }
}

// Actual loan declarations/events projected onto the source graph's reserved occurrences.
// No held-value list or policy-selected result participates in creating these identities.
struct SourceOwnership {
  loans: List<Loan>
  events: List<Event>
  acquisitions: List<SourceInputAcquisition>
  views: List<SourceMatchView>
  observations: List<SourceOwnerObservation>
}

struct SourceOwnerObservation {
  owner: SourceVisit.OwnerId
  storage: SourceGraph.Storage
  evaluation: SourceGraph.EvalId
  point: SourceControl.PointId
  action: SourceVisit.OwnerAction
  descriptor: usize
  hidden: bool
}
impl Copy for SourceOwnerObservation {}

// Open body goals enlarge retention eligibility only. Declared premises remain separate
// inputs to the final proof; neither this context nor a source-policy decision adds a premise.
struct RetentionContext {
  requirements: List<RetentionEdge>
  relations: List<ImpliedGroup>
  openContents: List<Shared<Lifetime>>
  settled: bool
}

effect fn retentionContext(owner: &DeclarationId, pending: bool, obligations: &[SafetyObligation])
  -> RetentionContext ! OutOfMemoryError ? &mut Allocator {
  let mut requirements = List<RetentionEdge>.make()
  if pending { requirements = run localRetentionEdges(owner, obligations) }
  // Open relations enlarge the possible source-retention graph only. The separately supplied
  // declared `premises` remain the sole assumptions for the region proof. Retained capture
  // contents make this retention summary incomplete.
  let mut retentionRelations = List<ImpliedGroup>.make()
  let mut openContents = List<Shared<Lifetime>>.make()
  let mut settled = true
  let mut obligation = usize.ZERO
  while obligation < obligations.length {
    match &obligations[obligation] {
      SafetyObligation.RegionRelation {offered, wanted, ..} => {
        let mut members = List<Shared<Lifetime>>.make()
        run appendAtoms(&mut members, &offered)
        let mut container = List<Shared<Lifetime>>.make()
        run appendAtoms(&mut container, &wanted)
        run List<ImpliedGroup>.append(&mut retentionRelations, ImpliedGroup {container: move container, members: move members})
      }
      SafetyObligation.Contents {region, ..} => {
        settled = false
        run appendAtoms(&mut openContents, &region)
      }
      _ => ()
    }
    obligation = obligation + usize.ONE
  }
  return RetentionContext {requirements: move requirements, relations: move retentionRelations,
    openContents: move openContents, settled: settled}
}

// All runtime identities are reserved before the sole source-domain/Flow emission. The
// returned traversal is consumed by Builder.reserve after its ownership handler inventory
// has been read; no placeholder checker or second traversal is involved.
struct SourceReservedBody {
  context: RetentionContext
  traversal: SourceVisit.Reservation
  ownership: SourceOwnership
  access: SourceAccessProjection
  escapes: SourceEscapeInventory
}

effect fn sourceReserveBody<'body>(prepared: &PreparedSources.SourcePreparation<'body>, cleanup: &[LoanCleanup])
  -> SourceReservedBody ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let context = run retentionContext(prepared.body.owner, prepared.body.pending, prepared.body.obligations)
  let mut traversal = run SourceVisit.reserve(prepared)
  // Construction inputs are physically activated here exactly once. Implicit references
  // acquire at input.usePoint even if another argument never completes the operation.
  let ownership = run sourceDeclaredLoans(prepared, &mut traversal)
  run sourceResultUses(prepared, &mut traversal, &ownership, cleanup)
  let results = run SourceResults.reserve(prepared, &traversal)
  let stores = run SourceStores.reserve(prepared, &traversal, &results)
  run SourceGraph.Skeleton.installStores(&mut traversal.skeleton, prepared, move stores)
  // The graph owns compound result activation and retains empty/incomplete contributors.
  // BC supplies semantic terminal directives; it does not reconstruct contract routes.
  run SourceGraph.Skeleton.installResults(&mut traversal.skeleton, prepared, move results)
  let access = run sourceAccessEvents(prepared, &traversal, cleanup)
  let escapes = run sourceEscapeInventory(prepared, &traversal)
  return SourceReservedBody {context: move context, traversal: move traversal, ownership: move ownership,
    access: move access, escapes: move escapes}
}

// An actual borrowed match view either acquires a place loan or holds loans of its already
// evaluated descriptor. Its authority and subject stay separate from canonical address proofs.
union SourceViewOrigin {
  Acquired {loan: usize},
  Carried {operand: SourceOperand},
}

struct SourceMatchView {
  origin: SourceViewOrigin
  record: usize
  result: SourceGraph.EvalId
  source: SourceGraph.EvalId
  scope: SourceVisit.ScopeId
  point: SourceControl.PointId
  extents: List<SourceViewExtent>
}

struct SourceViewExtent {
  from: SourceControl.PointId
  to: SourceControl.PointId
}
impl Copy for SourceViewExtent {}

// A view holds an existing source loan or its own authored acquisition. Neither form is a
// physical definition of a descriptor; repeated view sites keep their independent scopes.
struct SourceViewHold {
  loan: usize
  source: SourceGraph.EvalId
  scope: SourceVisit.ScopeId
  point: SourceControl.PointId
  active: SourceAtom
  extents: List<SourceViewExtent>
}
struct SourceViewHolds {
  holds: List<SourceViewHold>
  missing: SourceAtom
}

struct SourceViewProjection {
  loan: usize
  live: List<SourceAtom>
  ends: List<SourceAtom>
  required: List<SourceAtom>
  occupied: List<SourceAtom>
  survives: List<SourceAtom>
  released: List<SourceAtom>
}

struct SourceInputAcquisition {
  result: SourceGraph.EvalId
  input: SourceGraph.EvalId
  acquisition: SourceGraph.EvalId
  map: PreparedSources.MapId
  loan: usize
}
impl Copy for SourceInputAcquisition {}

// Access syntax is independent of the source histories a read later attributes. In particular,
// these paths do not assert that a call-returned descriptor addresses its loan's original place.
struct SourceAccessEvent {
  evaluation: SourceGraph.EvalId
  event: Event
}
struct SourceAccessRefusal {
  point: SourceControl.PointId
  reason: BorrowStatus
}
struct SourceGuardConsumption {
  subject: SourceGraph.EvalId
  point: SourceControl.PointId
  span: Location
}
struct SourceReplacementAccess {
  event: usize
  rhs: List<bool>
  statement: Location
}
struct SourceAccessProjection {
  events: List<SourceAccessEvent>
  refusals: List<SourceAccessRefusal>
  guardConsumed: List<SourceGuardConsumption>
  refinements: List<Refinement>
  replacements: List<SourceReplacementAccess>
}

struct SourceAccessPrelude {
  guard: Option<Location>
  outside: Option<BorrowStatus>
  unresolved: bool
}

struct SourceRuntimeEvents {
  events: List<Event>
  uncertain: List<bool>
  unresolved: bool
}

struct MoveInitialization {
  point: usize
  root: usize
}
impl Copy for MoveInitialization {}

struct SourceMoveProjection {
  loops: List<Loop>
  initialized: List<MoveInitialization>
  moves: List<usize>
  reach: Reach
  width: usize
  unresolved: bool
}

enum MoveAccess { None, Unknown, Conflict }

// Geometry of a genuinely reaching move. The caller retains diagnostic ordering and the
// exact source event; this classifier neither chooses a reaching source nor assumes ID order.
fn movedAccess(event: &Event, source: &Event) -> MoveAccess {
  let shared = overlap(&source.place, &event.place)
  if shared == usize.ZERO { return MoveAccess.None }
  let ends = event.kind == Kind.Drop && covers(&event.place, &source.place)
    && List<Step>.length(&event.place.steps) < List<Step>.length(&source.place.steps)
  if ends || (event.kind == Kind.Write && covers(&event.place, &source.place)) { return MoveAccess.None }
  // Inspecting an owner's tag does not read its moved payload. A write behind a moved
  // descriptor still uses that descriptor, and a dynamic index can hit an exact moved slot.
  let partial = event.kind == Kind.Inspect && !covers(&source.place, &event.place)
  let used = shared == usize.ONE && (event.kind != Kind.Write || behind(&source.place, &event.place)) && !partial
  if used || (shared == 2 && !partial && determined(&source.place)) { return MoveAccess.Conflict }
  if !partial { return MoveAccess.Unknown }
  return MoveAccess.None
}

struct LoanAccessOverlap {
  overlap: usize
  indexed: bool
}
impl Copy for LoanAccessOverlap {}

fn loanAccessOverlap(locals: &[Local], loan: &Loan, event: &Event) -> LoanAccessOverlap {
  let mut shared = overlap(&loan.place, &event.place)
  let mut indexed = shared == 2
  if shared != usize.ZERO && behind(&event.place, &loan.place) {
    // Replacing a descriptor leaves its referent untouched. Consuming a known shared
    // descriptor does too; the exact same local dereference boundary is still mandatory.
    indexed = false
    if event.kind == Kind.Write { shared = usize.ZERO }
    else if event.kind == Kind.Move || event.kind == Kind.Drop {
      shared = 2
      if loan.precision == LoanPrecision.Exact && sharedLocalDescriptor(locals, &event.place) { shared = usize.ZERO }
    }
  }
  return LoanAccessOverlap {overlap: shared, indexed: indexed}
}

fn preciseLoanConflict(loan: &Loan, selected: LoanAccessOverlap, caller: CallerSource) -> bool {
  return (selected.overlap == usize.ONE || selected.indexed) && (loan.precision == LoanPrecision.Exact
    || (loan.precision == LoanPrecision.Stored && caller == CallerSource.Actual))
}

// Runtime applicability belongs to the event's own point. For example, an argument borrow
// occurs before a later never argument even when the enclosing result cannot complete.
// Stable point ordering preserves the caller's ordering of coincident actual events.
effect fn sourceRuntimeEvents<'body>(graph: &SourceGraph.Graph<'body>, events: List<Event>)
  -> SourceRuntimeEvents ! OutOfMemoryError ? &mut Allocator {
  let mut pending = move events
  let mut result = SourceRuntimeEvents {events: List<Event>.make(), uncertain: List<bool>.make(), unresolved: false}
  let points = List<SourceControl.Point>.asSlice(&SourceGraph.Graph.control(graph).points)
  while List<Event>.length(&pending) != usize.ZERO {
    let event = match move List<Event>.pop(&mut pending) {
      Option<Event>.Some {value} => move value
      _ => { return CompilerBug.panic(b"runtime event projection lost an actual event") }
    }
    if event.point >= points.length { return CompilerBug.panic(b"runtime event has no actual CFG point") }
    let active = SourceGraph.Graph.truth(graph, points[event.point].reachable)
    if active == SourceTruth.False { continue }
    let uncertain = active == SourceTruth.Undefined
    if uncertain { result.unresolved = true }
    let existing = List<Event>.asSlice(&result.events)
    let mut at = usize.ZERO
    while at < existing.length && existing[at].point < event.point { at = at + usize.ONE }
    run List<Event>.insert(&mut result.events, at, move event)
    run List<bool>.insert(&mut result.uncertain, at, uncertain)
  }
  return move result
}

effect fn sourceAccessEvent(events: &mut List<SourceAccessEvent>, evaluation: SourceGraph.EvalId,
  point: SourceControl.PointId, path: &Path, kind: Kind, span: Location, target: Location) -> ()
! OutOfMemoryError ? &mut Allocator {
  if path.root == usize.MAX { CompilerBug.panic(b"ownership access has no actual place root") }
  run List<SourceAccessEvent>.append(&mut events.*, SourceAccessEvent {evaluation: evaluation,
    event: Event {point: point.index, place: Place {root: path.root, steps: run copySteps(List<Step>.asSlice(&path.steps))},
      kind: kind, span: span, target: target, loan: usize.MAX, consumesTarget: usize.ZERO,
      refiner: path.refiner, refinedDepth: path.refinedDepth, binders: run copyBinders(List<usize>.asSlice(&path.binders))}})
  return ()
}

fn sourceAccessInput(actual: &SourceVisit.Visit, ordinal: usize, node: NodeId) -> SourceVisit.Input {
  let inputs = List<SourceVisit.Input>.asSlice(&actual.inputs)
  if ordinal >= inputs.length || inputs[ordinal].node.index != node.index {
    return CompilerBug.panic(b"ownership access lost its actual ordered input")
  }
  return inputs[ordinal]
}

// The moves in a replacement's RHS belong to that actual evaluation subtree, not to every
// earlier event or every evaluation of the same typed NodeId. A pattern binding's retained
// subject is an address dependency; reading it does not execute the subject expression again.
effect fn sourceAccessSubtree<'body>(prepared: &PreparedSources.SourcePreparation<'body>, reservation: &SourceVisit.Reservation,
  root: SourceGraph.EvalId) -> List<bool> ! OutOfMemoryError ? &mut Allocator {
  let mut selected = List<bool>.make()
  let mut at = usize.ZERO
  while at < List<SourceGraph.Evaluation>.length(&reservation.skeleton.evaluations) {
    run List<bool>.append(&mut selected, false)
    at = at + usize.ONE
  }
  let mut pending = List<SourceGraph.EvalId>.make()
  run List<SourceGraph.EvalId>.append(&mut pending, root)
  while List<SourceGraph.EvalId>.length(&pending) != usize.ZERO {
    let current = match move List<SourceGraph.EvalId>.pop(&mut pending) {
      Option<SourceGraph.EvalId>.Some {value} => value
      _ => { return CompilerBug.panic(b"ownership access subtree lost its pending occurrence") }
    }
    if List<bool>.asSlice(&selected)[current.index] { continue }
    List<bool>.asMutSlice(&mut selected)[current.index] = true
    let actual = SourceVisit.occurrence(reservation, current)
    if let NodeKind.Expression {form: Expression.PatternBinding {..}, ..} = &prepared.body.nodes[actual.node.index].kind {
      continue
    }
    let inputs = List<SourceVisit.Input>.asSlice(&actual.inputs)
    let mut at = usize.ZERO
    while at < inputs.length {
      run List<SourceGraph.EvalId>.append(&mut pending, inputs[at].evaluation)
      at = at + usize.ONE
    }
  }
  return move selected
}

fn sourceConsumedTarget(events: &mut List<SourceAccessEvent>, written: usize, rhs: &[bool], statement: Location,
  activity: &[SourceTruth]) -> () {
  let all = List<SourceAccessEvent>.asMutSlice(&mut events.*)
  let mut at = usize.ZERO
  while at < all.length {
    if all[at].event.point >= activity.length { CompilerBug.panic(b"replacement access has no actual source activity") }
    if activity[all[at].event.point] != SourceTruth.False && rhs[all[at].evaluation.index]
      && (all[at].event.kind == Kind.Move || all[at].event.kind == Kind.Drop) {
      let mut shared = overlap(&all[at].event.place, &all[written].event.place)
      if shared != usize.ZERO && activity[all[at].event.point] == SourceTruth.Undefined { shared = 2 }
      if shared == usize.ONE || (shared != usize.ZERO && all[written].event.consumesTarget == usize.ZERO) {
        all[written].event.consumesTarget = shared
        all[written].event.span = statement
        all[written].event.target = statement
      }
    }
    at = at + usize.ONE
  }
  return ()
}

// RHS subtrees include structurally reserved unreachable branches. Their move geometry is
// settled only after the sole source solve, using the move's own actual point applicability.
effect fn sourceSettleReplacements<'body>(graph: &SourceGraph.Graph<'body>, projection: &mut SourceAccessProjection)
  -> () ! OutOfMemoryError ? &mut Allocator {
  let points = List<SourceControl.Point>.asSlice(&SourceGraph.Graph.control(graph).points)
  let mut activity = List<SourceTruth>.make()
  let mut at = usize.ZERO
  while at < points.length {
    run List<SourceTruth>.append(&mut activity, SourceGraph.Graph.truth(graph, points[at].reachable))
    at = at + usize.ONE
  }
  let replacements = List<SourceReplacementAccess>.asSlice(&projection.replacements)
  at = usize.ZERO
  while at < replacements.length {
    let replacement = &replacements[at]
    sourceConsumedTarget(&mut projection.events, replacement.event, List<bool>.asSlice(&replacement.rhs),
      replacement.statement, List<SourceTruth>.asSlice(&activity))
    at = at + usize.ONE
  }
  return ()
}

// A consuming guard sees the provisional owner acquired by THIS match occurrence. Neither
// a repeated guard NodeId nor a binding's retained subject dependency executes another guard.
// Keep the actual access point so the final diagnostic pass uses the one CFG's applicability.
effect fn sourceGuardConsumptions<'body>(prepared: &PreparedSources.SourcePreparation<'body>, reservation: &SourceVisit.Reservation,
  events: &[SourceAccessEvent]) -> List<SourceGuardConsumption> ! OutOfMemoryError ? &mut Allocator {
  let mut consumed = List<SourceGuardConsumption>.make()
  let visits = List<SourceVisit.Visit>.asSlice(&reservation.visits)
  let subjects = List<SourceVisit.Subject>.asSlice(&reservation.subjects)
  let mut at = usize.ZERO
  while at < visits.length {
    let actual = &visits[at]
    if let NodeKind.Expression {form: Expression.Match {subject, access, arms, ..}, ..} = &prepared.body.nodes[actual.node.index].kind {
      let owning = match &access { SubjectAccess.Place {..} => false _ => true }
      if owning {
        let source = sourceAccessInput(actual, usize.ZERO, subject)
        let mut retained = Option<SourceGraph.EvalId>.none()
        let mut each = usize.ZERO
        while each < subjects.length {
          if subjects[each].site.index == actual.node.index && subjects[each].source.index == source.evaluation.index {
            if let Option<SourceGraph.EvalId>.Some {..} = retained {
              return CompilerBug.panic(b"consuming guard has duplicate actual subject acquisitions")
            }
            if !subjects[each].owned { return CompilerBug.panic(b"consuming guard lost its subject owner") }
            retained = Option<SourceGraph.EvalId>.some(subjects[each].evaluation)
          }
          each = each + usize.ONE
        }
        let evaluation = match retained {
          Option<SourceGraph.EvalId>.Some {value} => value
          _ => { return CompilerBug.panic(b"consuming guard has no actual subject acquisition") }
        }
        let root = sourceTemporaryRoot(prepared, reservation, evaluation)
        let written = List<MatchArm>.asSlice(&arms)
        let selected = List<SourceVisit.ArmResult>.asSlice(&actual.armInputs)
        if selected.length != written.length { return CompilerBug.panic(b"consuming guard lost its actual arm coordinates") }
        let inputs = List<SourceVisit.Input>.asSlice(&actual.inputs)
        each = usize.ZERO
        while each < selected.length {
          if let Option<usize>.Some {value: guard} = selected[each].guard {
            let node = match written[each].guard {
              Option<NodeId>.Some {value} => value
              _ => { return CompilerBug.panic(b"actual guard coordinate has no written guard") }
            }
            if guard >= inputs.length || inputs[guard].node.index != node.index {
              return CompilerBug.panic(b"consuming guard names another actual input occurrence")
            }
            let subtree = run sourceAccessSubtree(prepared, reservation, inputs[guard].evaluation)
            let contained = List<bool>.asSlice(&subtree)
            let mut event = usize.ZERO
            while event < events.length {
              let use = &events[event]
              if contained[use.evaluation.index] && use.event.place.root == root
                && (use.event.kind == Kind.Move || use.event.kind == Kind.Drop) {
                run List<SourceGuardConsumption>.append(&mut consumed, SourceGuardConsumption {
                  subject: evaluation, point: SourceControl.PointId {index: use.event.point}, span: use.event.span})
              }
              event = event + usize.ONE
            }
          } else if let Option<NodeId>.Some {..} = written[each].guard {
            return CompilerBug.panic(b"written guard has no actual arm input coordinate")
          }
          each = each + usize.ONE
        }
      }
    }
    at = at + usize.ONE
  }
  return move consumed
}

// Project authored accesses onto reserved runtime points, including a match's subject use
// before its guards and arms. Loan acquisition and owner exits have their own semantic
// handlers. Holding/cleanup effects and store-policy refusals are separate consumers of
// these events; this inventory alone is not a completed ownership proof.
effect fn sourceAccessEvents<'body>(prepared: &PreparedSources.SourcePreparation<'body>, reservation: &SourceVisit.Reservation,
  cleanup: &[LoanCleanup]) -> SourceAccessProjection ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut projection = SourceAccessProjection {events: List<SourceAccessEvent>.make(), refusals: List<SourceAccessRefusal>.make(),
    guardConsumed: List<SourceGuardConsumption>.make(), refinements: run sourceRefinements(prepared, reservation),
    replacements: List<SourceReplacementAccess>.make()}
  let nodes = prepared.body.nodes
  let visits = List<SourceVisit.Visit>.asSlice(&reservation.visits)
  let mut at = usize.ZERO
  while at < visits.length {
    let actual = &visits[at]
    let span = nodes[actual.node.index].origin.location
    let shape = run shapeOf(nodes, actual.node)
    match move shape {
      Shape.Outside {reason} => {
        run List<SourceAccessRefusal>.append(&mut projection.refusals,
          SourceAccessRefusal {point: actual.entry, reason: reason})
      }
      Shape.ReadPlace => {
        if actual.access == SourceVisit.Access.Value {
          let written = run pathOf(nodes, actual.node)
          let mut owned = written.root != usize.MAX
          if !owned {
            let base = projectedBase(nodes, actual.node)
            let descriptor = prepared.body.locals.length + nodes.length + base.index
            owned = descriptor < cleanup.length
              && (cleanup[descriptor].unknown || List<Shared<Lifetime>>.length(&cleanup[descriptor].regions) != usize.ZERO)
          }
          if owned {
            let path = run sourceAuthoredPath(prepared, reservation, SourceVisit.Input {node: actual.node,
              evaluation: actual.evaluation, usePoint: actual.execute, access: actual.access, read: Option<PreparedSources.InputRead>.none()})
            run sourceAccessEvent(&mut projection.events, actual.evaluation, actual.execute, &path, Kind.Read, span, span)
          }
        }
      }
      Shape.Move {value, consumed} => {
        if consumed {
          let written = run pathOf(nodes, value)
          if written.root == usize.MAX || written.through {
            run List<SourceAccessRefusal>.append(&mut projection.refusals,
              SourceAccessRefusal {point: actual.entry, reason: BorrowStatus.StoredLoans})
          } else {
            let path = run sourceAuthoredPath(prepared, reservation, sourceAccessInput(actual, usize.ZERO, value))
            run sourceAccessEvent(&mut projection.events, actual.evaluation, actual.execute, &path, Kind.Move, span, nodes[value.index].origin.location)
          }
        }
      }
      Shape.Drop {value, consumed} => {
        if consumed {
          let written = run pathOf(nodes, value)
          if written.root == usize.MAX || written.through {
            run List<SourceAccessRefusal>.append(&mut projection.refusals,
              SourceAccessRefusal {point: actual.entry, reason: BorrowStatus.StoredLoans})
          } else {
            let path = run sourceAuthoredPath(prepared, reservation, sourceAccessInput(actual, usize.ZERO, value))
            run sourceAccessEvent(&mut projection.events, actual.evaluation, actual.execute, &path, Kind.Drop, span, span)
          }
        }
      }
      Shape.Assignment {local, value} => {
        let path = Path {root: local, through: false, steps: List<Step>.make(), indexes: List<NodeId>.make(),
          refiner: usize.MAX, refinedDepth: usize.ZERO, binders: List<usize>.make()}
        let target = Location {start: span.start, end: span.start + usize.ONE}
        let event = List<SourceAccessEvent>.length(&projection.events)
        run sourceAccessEvent(&mut projection.events, actual.evaluation, actual.execute, &path, Kind.Write, target, target)
        let rhs = run sourceAccessSubtree(prepared, reservation, sourceAccessInput(actual, usize.ZERO, value).evaluation)
        run List<SourceReplacementAccess>.append(&mut projection.replacements,
          SourceReplacementAccess {event: event, rhs: move rhs, statement: span})
      }
      Shape.PlaceAssignment {target, value} => {
        let written = run pathOf(nodes, target)
        if written.root == usize.MAX {
          run List<SourceAccessRefusal>.append(&mut projection.refusals,
            SourceAccessRefusal {point: actual.entry, reason: BorrowStatus.StoredLoans})
        } else {
          let path = run sourceAuthoredPath(prepared, reservation, sourceAccessInput(actual, usize.ZERO, target))
          let mut targetSpan = writtenSpan(nodes, target)
          if !path.through && List<Step>.length(&path.steps) == usize.ZERO { targetSpan = nodes[target.index].origin.location }
          let event = List<SourceAccessEvent>.length(&projection.events)
          run sourceAccessEvent(&mut projection.events, actual.evaluation, actual.execute, &path, Kind.Write, targetSpan, targetSpan)
          if !path.through {
            let rhs = run sourceAccessSubtree(prepared, reservation, sourceAccessInput(actual, usize.ONE, value).evaluation)
            run List<SourceReplacementAccess>.append(&mut projection.replacements,
              SourceReplacementAccess {event: event, rhs: move rhs, statement: span})
          }
        }
      }
      Shape.Displace {target, value} => {
        let written = run pathOf(nodes, target)
        if written.root == usize.MAX || (!written.through && run nodeRetains(nodes, target, prepared.body.owner)) {
          run List<SourceAccessRefusal>.append(&mut projection.refusals,
            SourceAccessRefusal {point: actual.entry, reason: BorrowStatus.StoredLoans})
        } else {
          let path = run sourceAuthoredPath(prepared, reservation, sourceAccessInput(actual, usize.ZERO, target))
          let read = match actual.displaced {
            Option<SourceGraph.EvalId>.Some {value} => value
            _ => { return CompilerBug.panic(b"replacement access has no actual displaced read") }
          }
          let evaluations = List<SourceGraph.Evaluation>.asSlice(&reservation.skeleton.evaluations)
          let targetSpan = writtenSpan(nodes, target)
          run sourceAccessEvent(&mut projection.events, actual.evaluation, evaluations[read.index].point, &path, Kind.Read, targetSpan, targetSpan)
          let event = List<SourceAccessEvent>.length(&projection.events)
          run sourceAccessEvent(&mut projection.events, actual.evaluation, evaluations[actual.evaluation.index].point, &path, Kind.Write, targetSpan, targetSpan)
          if !path.through {
            let rhs = run sourceAccessSubtree(prepared, reservation, sourceAccessInput(actual, usize.ONE, value).evaluation)
            run List<SourceReplacementAccess>.append(&mut projection.replacements,
              SourceReplacementAccess {event: event, rhs: move rhs, statement: span})
          }
        }
      }
      Shape.Match {subject, access, ..} => {
        let input = sourceAccessInput(actual, usize.ZERO, subject)
        let written = run pathOf(nodes, subject)
        if access == Scrutinee.Moved && (written.root == usize.MAX || written.through) {
          run List<SourceAccessRefusal>.append(&mut projection.refusals,
            SourceAccessRefusal {point: actual.entry, reason: BorrowStatus.StoredLoans})
        } else if access != Scrutinee.Value && written.root != usize.MAX {
          let kind = match access {
            Scrutinee.Moved => Kind.Move
            Scrutinee.Exclusive => Kind.Update
            Scrutinee.Place => Kind.Inspect
            _ => Kind.Read
          }
          let path = run sourceAuthoredPath(prepared, reservation, input)
          let subjectSpan = nodes[subject.index].origin.location
          // The subject is inspected/moved before any guard or arm, even when no arm
          // completes. Borrowed-view acquisition still requires its producer authority.
          run sourceAccessEvent(&mut projection.events, actual.evaluation, input.usePoint,
            &path, kind, subjectSpan, subjectSpan)
        }
      }
      _ => ()
    }
    at = at + usize.ONE
  }
  projection.guardConsumed = run sourceGuardConsumptions(prepared, reservation, List<SourceAccessEvent>.asSlice(&projection.events))
  return move projection
}

// The old checker stopped recording after its first refusal; structural source reservation
// deliberately does not. Retain that diagnostic boundary without truncating actual execution.
// A definite earlier consuming guard still wins; uncertain or unreachable later inventory
// cannot manufacture a guard rejection or certify that the whole body was checked.
fn sourcePrelude(guards: &[SourceGuardConsumption], refusals: &[SourceAccessRefusal], activity: &[SourceTruth])
  -> SourceAccessPrelude {
  let mut result = SourceAccessPrelude {guard: Option<Location>.none(), outside: Option<BorrowStatus>.none(), unresolved: false}
  let mut first = usize.MAX
  let mut at = usize.ZERO
  while at < refusals.length {
    let point = refusals[at].point.index
    if point >= activity.length { return CompilerBug.panic(b"source refusal has no actual encounter point") }
    if activity[point] != SourceTruth.False {
      if activity[point] == SourceTruth.Undefined { result.unresolved = true }
      if point < first {
        first = point
        result.outside = Option<BorrowStatus>.some(refusals[at].reason)
      }
    }
    at = at + usize.ONE
  }
  let mut consumed = usize.MAX
  at = usize.ZERO
  while at < guards.length {
    let point = guards[at].point.index
    if point >= activity.length { return CompilerBug.panic(b"consuming guard has no actual access point") }
    if point < first {
      if activity[point] == SourceTruth.Undefined { result.unresolved = true }
      if activity[point] == SourceTruth.True && point < consumed {
        consumed = point
        result.guard = Option<Location>.some(guards[at].span)
      }
    }
    at = at + usize.ONE
  }
  return move result
}

fn sourceGuardVerdict(span: Location) -> Verdict {
  return Verdict {outcome: Outcome.Conflict, status: BorrowStatus.Regions, code: RejectionCode.GuardConsumesPattern,
    access: span, earlier: Option<Location>.none(), reports: List<Report>.make()}
}

// Event numbering is not point numbering: several actual input acquisitions may occur at
// one use point. The eventual conflict/region consumers must inspect the entire point row.
effect fn sourceEventsAt(events: &[Event], pointCount: usize) -> List<List<usize>>
! OutOfMemoryError ? &mut Allocator {
  let mut rows = List<List<usize>>.make()
  let mut at = usize.ZERO
  while at < pointCount {
    run List<List<usize>>.append(&mut rows, List<usize>.make())
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < events.length {
    if events[at].point >= pointCount { return CompilerBug.panic(b"ownership event names a foreign CFG point") }
    run List<usize>.append(&mut List<List<usize>>.asMutSlice(&mut rows)[events[at].point], at)
    at = at + usize.ONE
  }
  return move rows
}

// Written operand order is supplied by the operation, never recovered by sorting ValueIds.
// A root denotes the actual physical value family (including an implicit reference input),
// not its selected/original contract parameter coordinate.
struct SourceOperand {
  node: NodeId
  evaluation: SourceGraph.EvalId
  root: PreparedSources.EndpointId
  ordinal: usize
}
impl Copy for SourceOperand {}

struct SourceCarryCase {
  source: SourceGraph.InputCase
  field: usize
}

// One actual component/leaf observation. Histories remain cases of that observation. The
// second written use of the same value gets another position, even for the same loan.
struct SourceCarryPosition {
  node: NodeId
  root: PreparedSources.EndpointId
  value: SourceGraph.ValueId
  leaf: SourceGraph.LeafId
  loan: usize
  operand: usize
  since: usize
  quality: SourceQuality
  cases: List<SourceCarryCase>
}

struct SourceObservation {
  positions: List<SourceCarryPosition>
  // Entry, Expression, LoanFree and Unknown remain actual inputs. None is a fake Loan, nor
  // can an empty Borrow projection stand for complete source coverage.
  other: List<SourceGraph.Input>
  unknown: SourceAtom
}

// Every effect retains its actual source history and operation applicability. Definition and
// read identities belong to SourceFlow; they must never index the old eager Holding table.
struct SourceEffectSource {
  value: SourceGraph.ValueId
  leaf: SourceGraph.LeafId
  loan: usize
  definition: Option<SourceControl.DefinitionId>
  read: Option<SourceControl.ReadId>
}
impl Copy for SourceEffectSource {}

struct SourceRetentionEffect {
  source: SourceEffectSource
  point: usize
  caller: SourceAtom
  independent: SourceAtom
  storing: SourceAtom
}

struct SourceRetentionCases {
  sources: List<SourceEffectSource>
  decisions: List<SourcePolicy.RetentionOutput>
}

// Coordinates in the exact producer-stage kept record. These do not identify a physical
// source or canonical destination; the graph's reserved candidate supplies those separately.
struct SourceKeptSlot {
  operand: usize
  slot: usize
}
impl Copy for SourceKeptSlot {}

struct SourceReadExclusion {
  excluded: SourceAtom
  missing: SourceAtom
}
impl Copy for SourceReadExclusion {}

struct SourceStoreFacts {
  permitted: bool
  empty: bool
  complete: bool
}
impl Copy for SourceStoreFacts {}

struct SourceStoreDecision {
  eligible: SourceAtom
  missing: SourceAtom
}

struct KeptOrigins {
  regions: List<Shared<Lifetime>>
  reached: List<usize>
}

// Caller retention starts at an actual operation, while independent escape reasons retain
// their original global constraint. Neither table is indexed by historical Holding order.
struct SourceCallerRetention {
  source: SourceEffectSource
  operation: usize
  present: SourceAtom
  missing: SourceAtom
}

struct SourceOperationReach {
  point: usize
  at: List<SourceAtom>
}

struct SourceCallerProjection {
  retentions: List<SourceCallerRetention>
  operations: List<SourceOperationReach>
  independent: List<SourceAtom>
  independentMissing: List<SourceAtom>
  aggregate: List<SourceAtom>
  storing: SourceAtom
  missing: SourceAtom
}

struct SourceCallerEvidence {
  present: SourceAtom
  missing: SourceAtom
}
impl Copy for SourceCallerEvidence {}

// One record per real SourceFlow definition, not one definition per Borrow alternative.
// Entry, LoanFree, Expression and unavailable definitions remain in the same inventory.
// Histories remain paired InputCases under each source; their numeric order is immaterial.
struct SourceStorageDefinition {
  definition: SourceGraph.DefinitionView
  inputs: List<SourceGraph.Input>
  loans: List<SourceStoredLoan>
  unknown: SourceAtom
  missing: SourceAtom
}

// Membership is captured while raw graph leaves are available. It does not replace the
// original InputCases above, which still authenticate each copied definition/read history.
struct SourceStoredLoan {
  leaf: SourceGraph.LeafId
  loan: usize
  active: SourceAtom
}
impl Copy for SourceStoredLoan {}

struct SourceStorageProjection {
  definitions: List<SourceStorageDefinition>
  reads: List<SourceGraph.ReadView>
}

struct SourceIntervalEffect {
  source: SourceEffectSource
  from: usize
  to: usize
  cleanup: bool
  active: SourceAtom
}

struct SourceIntervalProjection {
  source: SourceEffectSource
  from: usize
  to: usize
  cleanup: bool
  evidence: SourceCallerEvidence
}

// Every bit names an original Flow.DefinitionId. Multiple Borrow alternatives can occupy
// that same definition; neither alternative histories nor virtual components add bits.
struct SourceLoanOccupancy {
  loan: usize
  width: usize
  entering: List<u64>
  leaving: List<u64>
  unresolved: bool
}

struct SourceControlProjection {
  entry: usize
  points: List<Point>
  unresolved: bool
}

struct SourceLoanNeeds {
  required: List<u64>
  liveOut: List<u64>
  unresolved: bool
}

struct SourceLoanAvailability {
  points: List<u64>
  unresolved: bool
}

struct SourceHolderRequest {
  owner: Option<SourceVisit.OwnerId>
  evaluation: SourceGraph.EvalId
  root: PreparedSources.EndpointId
  point: SourceControl.PointId
  active: SourceAtom
}
impl Copy for SourceHolderRequest {}

struct SourceHolderUse {
  request: usize
  storage: SourceGraph.Storage
  active: SourceAtom
}
impl Copy for SourceHolderUse {}

struct SourceHolderProjection {
  requests: List<SourceHolderRequest>
  uses: List<SourceHolderUse>
  missing: SourceAtom
}

struct SourceHolderLiveness {
  liveOut: List<u64>
  unresolved: bool
}

// The diagnostic owner needs to distinguish a value in flight from a required holder read.
// Caller evidence stays separate because Stored conflict precision depends on its provenance.
struct SourceLiveAt {
  flight: CallerSource
  held: CallerSource
  view: CallerSource
  caller: CallerSource
}

struct SourceAccessDecision {
  reported: bool
  unresolved: bool
}

struct SourceLoanFlow {
  occupancy: SourceLoanOccupancy
  needs: SourceLoanNeeds
  holders: SourceHolderLiveness
}

struct SourceConflictProjection {
  conflict: Option<Verdict>
  contested: List<Shared<Lifetime>>
  unresolved: bool
}

struct SourceRequiredUse {
  evidence: CallerSource
  span: Location
}

struct SourceStaleDefinition {
  evidence: CallerSource
  definition: Option<SourceControl.DefinitionId>
}

struct SourceRegionInput<'input, 'body> {
  graph: &'input SourceGraph.Graph<'body>
  control: &'input SourceControlProjection
  owners: &'input [SourceVisit.Owner]
  storage: &'input SourceStorageProjection
  events: &'input SourceRuntimeEvents
  intervals: &'input [SourceIntervalProjection]
  views: &'input [SourceViewProjection]
  viewMissing: SourceAtom
}

// Inputs to the existing availability propagation: real carriers and paired copy reads.
// `preserves` is a projection of kills, not an independently solved reaching relation.
struct AvailabilitySource {
  definition: usize
  read: usize
}
impl Copy for AvailabilitySource {}

struct AvailabilityCarrier {
  point: usize
  selected: bool
  unpaired: bool
  sources: List<AvailabilitySource>
}

struct AvailabilityProjection {
  carriers: List<AvailabilityCarrier>
  preserves: List<u64>
  flight: List<bool>
  unresolved: bool
}

struct SourceCrossingEffect {
  source: SourceEffectSource
  active: SourceAtom
}

struct SourceEscapeEffect {
  source: SourceEffectSource
  active: SourceAtom
}

struct SourceWholeHold {
  loan: usize
  result: NodeId
  active: SourceAtom
  described: SourceAtom
}
impl Copy for SourceWholeHold {}

struct SourceImpliedGroup {
  group: ImpliedGroup
  active: SourceAtom
}

struct SourceRegionVertex {
  region: Shared<Lifetime>
  reached: SourceAtom
}

struct SourceJoinEffects {
  intervals: List<SourceIntervalEffect>
  crossings: List<SourceCrossingEffect>
}

fn sourceQuality(cell: SourceGraph.Cell) -> SourceQuality {
  return SourceQuality {present: cell.present, stored: cell.stored, alternatives: cell.alternatives}
}

fn sourceEffectSource(position: &SourceCarryPosition, actual: &SourceCarryCase) -> SourceEffectSource {
  return SourceEffectSource {value: position.value, leaf: position.leaf, loan: position.loan,
    definition: actual.source.definition, read: actual.source.read}
}

// This conversion is only for immutable place/type predicates such as keptSink. It deliberately
// carries no legacy Holding identity: source effects retain the typed pair above instead.
fn sourcePredicateCarry(position: &SourceCarryPosition, actual: &SourceCarryCase) -> Carry {
  return Carry {loan: position.loan, since: position.since, operand: position.operand,
    definition: usize.MAX, read: usize.MAX, field: actual.field, direct: actual.source.direct}
}

// Shape component order, not endpoint allocation order, determines a physical scan. Only
// frozen inline children participate; following a reference would invent captured contents.
effect fn sourceComponents<'body>(prepared: &PreparedSources.SourcePreparation<'body>,
  root: PreparedSources.EndpointId) -> List<PreparedSources.EndpointId>
! OutOfMemoryError ? &mut Allocator {
  let endpoints = List<PreparedSources.Endpoint>.asSlice(&prepared.endpoints)
  let shapes = List<PreparedSources.Shape>.asSlice(&prepared.shapes)
  let mut pending = List<PreparedSources.EndpointId>.make()
  let mut ordered = List<PreparedSources.EndpointId>.make()
  run List<PreparedSources.EndpointId>.append(&mut pending, root)
  while List<PreparedSources.EndpointId>.length(&pending) > usize.ZERO {
    let endpoint = List<PreparedSources.EndpointId>.remove(&mut pending,
      List<PreparedSources.EndpointId>.length(&pending) - usize.ONE)
    if endpoint.index >= endpoints.length { CompilerBug.panic(b"source observation names an absent component") }
    let prior = List<PreparedSources.EndpointId>.asSlice(&ordered)
    let mut at = usize.ZERO
    while at < prior.length {
      if prior[at].index == endpoint.index { CompilerBug.panic(b"source observation repeats an inline component") }
      at = at + usize.ONE
    }
    run List<PreparedSources.EndpointId>.append(&mut ordered, endpoint)
    if endpoints[endpoint.index].shape.index >= shapes.length { CompilerBug.panic(b"source observation has no prepared shape") }
    let components = List<PreparedSources.Component>.asSlice(&shapes[endpoints[endpoint.index].shape.index].components)
    at = components.length
    while at > usize.ZERO {
      at = at - usize.ONE
      if components[at].inline {
        let mut found = usize.MAX
        let mut each = usize.ZERO
        while each < endpoints.length {
          let child = match endpoints[each].parent { Option<PreparedSources.EndpointId>.Some {value} => value.index == endpoint.index _ => false }
          if child && SourceGraph.sameSelector(&endpoints[each].selector, &components[at].selector) {
            if found != usize.MAX { CompilerBug.panic(b"source observation has duplicate prepared children") }
            found = each
          }
          each = each + usize.ONE
        }
        if found == usize.MAX { CompilerBug.panic(b"source observation lost a prepared inline child") }
        run List<PreparedSources.EndpointId>.append(&mut pending, PreparedSources.EndpointId {index: found})
      }
    }
  }
  return move ordered
}

// Translate a *physical* placement into the existing slot classifier's path vocabulary.
// Unknown placement stays MAX. A contract channel never becomes an owned field by ordinal.
effect fn sourceField(endpoints: &[PreparedSources.Endpoint], root: PreparedSources.EndpointId,
  child: PreparedSources.EndpointId, paths: &mut List<List<Step>>) -> usize
! OutOfMemoryError ? &mut Allocator {
  let mut reverse = List<PreparedSources.EndpointId>.make()
  let mut current = child
  let mut remaining = endpoints.length
  while current.index != root.index && remaining > usize.ZERO {
    if current.index >= endpoints.length { CompilerBug.panic(b"source carry names an absent placement") }
    run List<PreparedSources.EndpointId>.append(&mut reverse, current)
    match endpoints[current.index].parent {
      Option<PreparedSources.EndpointId>.Some {value} => { current = value }
      _ => { CompilerBug.panic(b"source carry placement does not belong to its physical operand") }
    }
    remaining = remaining - usize.ONE
  }
  if remaining == usize.ZERO { CompilerBug.panic(b"source carry has cyclic placement ancestry") }
  let ancestry = List<PreparedSources.EndpointId>.asSlice(&reverse)
  let mut steps = List<Step>.make()
  let mut at = ancestry.length
  while at > usize.ZERO {
    at = at - usize.ONE
    if !run sourceSelectorSteps(&endpoints[ancestry[at].index].selector, &mut steps) { return usize.MAX }
  }
  if List<Step>.length(&steps) == usize.ZERO { return usize.ZERO }
  let field = List<List<Step>>.length(&paths.*)
  run List<List<Step>>.append(&mut paths.*, move steps)
  return field
}

effect fn sourceSelectorSteps(selector: &PreparedSources.Selector, steps: &mut List<Step>) -> bool
! OutOfMemoryError ? &mut Allocator {
  match &selector.* {
    PreparedSources.Selector.Field {ordinal} => run List<Step>.append(&mut steps.*, fieldStep(ordinal))
    PreparedSources.Selector.Member {declaration, member, payload} => {
      if DeclarationId.kind(&declaration) == OwnerKind.Union {
        run List<Step>.append(&mut steps.*, memberStep(member))
        run List<Step>.append(&mut steps.*, fieldStep(payload))
      } else {
        if payload != usize.ZERO { CompilerBug.panic(b"record carry has a union payload coordinate") }
        run List<Step>.append(&mut steps.*, fieldStep(member))
      }
    }
    PreparedSources.Selector.Variant {ordinal} => run List<Step>.append(&mut steps.*, memberStep(ordinal))
    PreparedSources.Selector.Index {class} => {
      let step = match &class {
        PreparedSources.IndexClass.Exact {index} => elementStep(index)
        PreparedSources.IndexClass.Remainder => anyElement()
      }
      run List<Step>.append(&mut steps.*, step)
    }
    PreparedSources.Selector.Identity => ()
    _ => { return false }
  }
  return true
}

struct SourceResultPlacement {
  field: usize
  whole: bool
}

fn sourcePlacementStep(steps: &[SourceResults.PlacementStep], position: SourceResults.Position) -> usize {
  let mut found = usize.MAX
  let mut at = usize.ZERO
  while at < steps.length {
    if SourceResults.samePosition(steps[at].position, position) {
      if found != usize.MAX { return CompilerBug.panic(b"result placement repeats its root/current position") }
      found = at
    }
    at = at + usize.ONE
  }
  if found == usize.MAX { return CompilerBug.panic(b"result placement lost its root/current step") }
  return found
}

// One finite path summary per position: absent, one exact path, or MAX. Joining alternative
// histories never turns them into additional operand positions or unfolds a recursive path.
fn sourceMergeField(paths: &[List<Step>], current: &mut Option<usize>, offered: usize) -> bool {
  let prior = match current.* {
    Option<usize>.Some {value} => value
    _ => { current.* = Option<usize>.some(offered) return true }
  }
  if prior == usize.MAX || prior == offered { return false }
  let mut same = false
  if offered != usize.MAX {
    let left = List<Step>.asSlice(&paths[prior])
    let right = List<Step>.asSlice(&paths[offered])
    same = left.length == right.length
    let mut at = usize.ZERO
    while same && at < left.length {
      same = sameStep(left[at], right[at])
      at = at + usize.ONE
    }
  }
  if same { return false }
  current.* = Option<usize>.some(usize.MAX)
  return true
}

effect fn sourceSelectedField(shapes: &[PreparedSources.Shape], roots: &[SourceResults.Position],
  targets: &[SourceResults.Position], steps: &[SourceResults.PlacementStep], selected: SourceResults.Position,
  prefix: usize, paths: &mut List<List<Step>>) -> usize ! OutOfMemoryError ? &mut Allocator {
  let mut target = false
  let mut root = false
  let mut at = usize.ZERO
  while at < targets.length {
    if SourceResults.samePosition(targets[at], selected) { target = true }
    at = at + usize.ONE
  }
  let entry = SourceResults.Position {output: selected.output, projection: selected.projection,
    root: selected.root, current: selected.root}
  at = usize.ZERO
  while at < roots.length {
    if SourceResults.samePosition(roots[at], entry) { root = true }
    at = at + usize.ONE
  }
  if !target || !root { return CompilerBug.panic(b"result policy substituted another continuation root or target") }
  let mut incoming = List<Option<usize>>.make()
  at = usize.ZERO
  while at < steps.length {
    run List<Option<usize>>.append(&mut incoming, Option<usize>.none())
    at = at + usize.ONE
  }
  let first = sourcePlacementStep(steps, entry)
  List<Option<usize>>.asMutSlice(&mut incoming)[first] = Option<usize>.some(prefix)
  let mut pending = List<usize>.make()
  run List<usize>.append(&mut pending, first)
  let mut result = Option<usize>.none()
  at = usize.ZERO
  while at < List<usize>.length(&pending) {
    let index = List<usize>.asSlice(&pending)[at]
    let current = &steps[index]
    let input = match List<Option<usize>>.asSlice(&incoming)[index] {
      Option<usize>.Some {value} => value
      _ => { return CompilerBug.panic(b"selected result worklist has no incoming path") }
    }
    if current.component.shape.index >= shapes.length { CompilerBug.panic(b"selected result has no authored component shape") }
    let components = List<PreparedSources.Component>.asSlice(&shapes[current.component.shape.index].components)
    if current.component.ordinal >= components.length { CompilerBug.panic(b"selected result has no authored component") }
    let component = &components[current.component.ordinal]
    let mut field = usize.MAX
    if input != usize.MAX && component.inline {
      let mut path = run copySteps(List<Step>.asSlice(&List<List<Step>>.asSlice(&paths.*)[input]))
      if run sourceSelectorSteps(&component.selector, &mut path) {
        field = usize.ZERO
        if List<Step>.length(&path) != usize.ZERO {
          field = List<List<Step>>.length(&paths.*)
          run List<List<Step>>.append(&mut paths.*, move path)
        }
      }
    }
    if SourceResults.samePosition(current.position, selected) {
      drop sourceMergeField(List<List<Step>>.asSlice(&paths.*), &mut result, field)
    }
    let next = List<SourceResults.Position>.asSlice(&current.next)
    let mut each = usize.ZERO
    while each < next.length {
      if next[each].root.index != selected.root.index { CompilerBug.panic(b"selected result crossed continuation roots") }
      let following = sourcePlacementStep(steps, next[each])
      if sourceMergeField(List<List<Step>>.asSlice(&paths.*),
        &mut List<Option<usize>>.asMutSlice(&mut incoming)[following], field) {
        run List<usize>.append(&mut pending, following)
      }
      each = each + usize.ONE
    }
    at = at + usize.ONE
  }
  return match result {
    Option<usize>.Some {value} => value
    _ => { return CompilerBug.panic(b"selected result target has no root-qualified placement") }
  }
}

effect fn sourceResultPlacement<'body>(builder: &SourceGraph.Builder<'body>, port: SourceGraph.PolicyPort,
  root: PreparedSources.EndpointId, paths: &mut List<List<Step>>) -> SourceResultPlacement
! OutOfMemoryError ? &mut Allocator {
  let target = SourceGraph.Builder.value(builder, port.target)
  let prepared = SourceGraph.Builder.preparation(builder)
  let endpoints = List<PreparedSources.Endpoint>.asSlice(&prepared.endpoints)
  match port.authority {
    SourceGraph.TransferAuthority.OperationResult {candidate, position} => {
      let placement = run SourceResults.outputPlacement(prepared, candidate)
      if placement.root.index != root.index || target.evaluation.index != candidate.result.index
        || target.endpoint.index != candidate.target.index || target.phase != SourceGraph.ValuePhase.Output {
        return CompilerBug.panic(b"result policy changed its actual output placement")
      }
      let prefix = run sourceField(endpoints, root, candidate.target, &mut paths.*)
      match &placement.suffix {
        SourceResults.PlacementSuffix.Whole => {
          if let Option<SourceResults.Position>.Some {..} = position { CompilerBug.panic(b"whole output has a selected result position") }
          if let Option<SourceGraph.ResidualSubject>.Some {..} = target.subject { CompilerBug.panic(b"whole output has a residual result subject") }
          return SourceResultPlacement {field: prefix, whole: prefix == usize.ZERO}
        }
        SourceResults.PlacementSuffix.Selected {roots, targets, steps} => {
          let selected = match position {
            Option<SourceResults.Position>.Some {value} => value
            _ => { return CompilerBug.panic(b"selected result policy lost its continuation position") }
          }
          let subject = match target.subject {
            Option<SourceGraph.ResidualSubject>.Some {value} => value
            _ => { return CompilerBug.panic(b"selected result policy published the whole anchor") }
          }
          let matching = match subject.position {
            Option<SourceResults.Position>.Some {value} => SourceResults.samePosition(value, selected)
            _ => false
          }
          let base = SourceGraph.Builder.value(builder, subject.base)
          let continued = &List<PreparedSources.ContractContinuation>.asSlice(&prepared.contractContinuations)[selected.current.index]
          if !matching || subject.state.index != continued.outputState.index
            || base.endpoint.index != candidate.target.index || base.evaluation.index != candidate.result.index
            || base.phase != SourceGraph.ValuePhase.Output {
            return CompilerBug.panic(b"selected result subject lost its exact anchor and root/current identity")
          }
          if let Option<SourceGraph.ResidualSubject>.Some {..} = base.subject { CompilerBug.panic(b"selected result anchor is another selected subject") }
          let field = run sourceSelectedField(List<PreparedSources.Shape>.asSlice(&prepared.shapes),
            List<SourceResults.Position>.asSlice(&roots), List<SourceResults.Position>.asSlice(&targets),
            List<SourceResults.PlacementStep>.asSlice(&steps), selected, prefix, &mut paths.*)
          return SourceResultPlacement {field: field, whole: false}
        }
      }
    }
    _ => {
      // Ordinary physical results keep their actual inline path. A virtual read result
      // requires explicit selected placement authority; its anchor is not that evidence.
      if let Option<SourceGraph.ResidualSubject>.Some {..} = target.subject {
        return CompilerBug.panic(b"virtual read result has no actual selected placement authority")
      }
      let field = run sourceField(endpoints, root, target.endpoint, &mut paths.*)
      return SourceResultPlacement {field: field, whole: field == usize.ZERO}
    }
  }
}

// Summary lanes and received writes have their own explicit observations. They must never
// win a physical operand lookup merely because their endpoint and evaluation coincide.
fn sourcePhysicalValue(value: SourceGraph.Value) -> bool {
  if let Option<SourceGraph.ResidualSubject>.Some {..} = value.subject { return false }
  if let Option<usize>.Some {..} = value.summary { return false }
  if let Option<usize>.Some {..} = value.writeHolder { return false }
  return value.phase != SourceGraph.ValuePhase.Transport
}

fn sourceSameSummary(left: Option<usize>, right: Option<usize>) -> bool {
  return match left {
    Option<usize>.Some {value} => match right { Option<usize>.Some {value: other} => value == other _ => false }
    _ => match right { Option<usize>.None => true _ => false }
  }
}

fn sourceSameReadLane(definition: SourceGraph.DefinitionView, read: SourceGraph.ReadView) -> bool {
  return sourceSameStorage(definition.storage, read.storage) && sourceSameSummary(definition.summary, read.summary)
}

// A selected value is supplied by an actual read or physical operand lookup. This helper
// does not recover an observation from a write target with the same endpoint.
effect fn sourceObserveValue<'body>(builder: &mut SourceGraph.Builder<'body>, observed: &mut SourceObservation,
  actual: SourceOperand, id: SourceGraph.ValueId, paths: &mut List<List<Step>>, loans: usize,
  present: &mut List<SourceAtom>, summaries: bool) -> () ! OutOfMemoryError ? &mut Allocator {
  let evaluation = SourceGraph.Builder.evaluation(&builder.*, actual.evaluation)
  let unknown = observed.unknown
  let mut inputs = run SourceGraph.Builder.inputs(&mut builder.*, id)
  while List<SourceGraph.Input>.length(&inputs) > usize.ZERO {
    let input = List<SourceGraph.Input>.remove(&mut inputs, usize.ZERO)
    run List<SourceAtom>.append(&mut present.*, input.quality.present)
    let mut loan = usize.MAX
    let mut unresolved = false
    match &SourceGraph.Builder.leaf(&builder.*, input.leaf).kind {
      SourceGraph.SourceLeaf.Borrow {loan: index, ..} => { loan = index }
      SourceGraph.SourceLeaf.Unknown {..} => { unresolved = true }
      _ => ()
    }
    if loan == usize.MAX {
      if unresolved {
        let present: [SourceAtom; 1] = [input.quality.present]
        let empty = List<SourceAtom>.make()
        run SourceProgram.rule(&mut builder.rules, unknown, &present, List<SourceAtom>.asSlice(&empty))
      }
      run List<SourceGraph.Input>.append(&mut observed.other, move input)
    } else {
      if loan >= loans { CompilerBug.panic(b"source carry names an absent actual loan") }
      let mut cases = List<SourceCarryCase>.make()
      let mut histories = move input.cases
      let mut removed = false
      while List<SourceGraph.InputCase>.length(&histories) > usize.ZERO {
        let history = List<SourceGraph.InputCase>.remove(&mut histories, usize.ZERO)
        let mut field = run sourceField(List<PreparedSources.Endpoint>.asSlice(
          &SourceGraph.Builder.preparation(&builder.*).endpoints), actual.root, history.placement, &mut paths.*)
        if let Option<SourceControl.DefinitionId>.Some {value: definition} = history.definition {
          if let Option<usize>.Some {..} = SourceGraph.Builder.definition(&builder.*, definition).summary {
            if !summaries { removed = true continue }
            // The final placement names B; it never recovers the original summary A.
            // The explicit read handler attributes A/B before using a precise field.
            field = usize.MAX
            if SourceGraph.Builder.value(&builder.*, id).phase != SourceGraph.ValuePhase.Input {
              let present: [SourceAtom; 1] = [history.quality.present]
              let empty = List<SourceAtom>.make()
              run SourceProgram.rule(&mut builder.rules, unknown, &present, List<SourceAtom>.asSlice(&empty))
            }
          }
        }
        run List<SourceCarryCase>.append(&mut cases, SourceCarryCase {source: move history, field: field})
      }
      let mut quality = sourceQuality(input.quality)
      if removed {
        if List<SourceCarryCase>.length(&cases) == usize.ZERO { continue }
        let mut present = List<SourceAtom>.make()
        let mut stored = List<SourceAtom>.make()
        let mut alternatives = List<SourceAtom>.make()
        let retained = List<SourceCarryCase>.asSlice(&cases)
        let mut at = usize.ZERO
        while at < retained.length {
          run List<SourceAtom>.append(&mut present, retained[at].source.quality.present)
          run List<SourceAtom>.append(&mut stored, retained[at].source.quality.stored)
          run List<SourceAtom>.append(&mut alternatives, retained[at].source.quality.alternatives)
          at = at + usize.ONE
        }
        quality = SourceQuality {present: run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&present)),
          stored: run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&stored)),
          alternatives: run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&alternatives))}
      }
      run List<SourceCarryPosition>.append(&mut observed.positions, SourceCarryPosition {
        node: actual.node, root: actual.root, value: id, leaf: input.leaf, loan: loan, operand: actual.ordinal, since: evaluation.point.index,
        quality: quality, cases: move cases})
    }
  }
  return ()
}

// Collect without solving or sampling Truth. Each supplied operand is scanned in prepared
// component order, then stable leaf order; case alternatives do not multiply scan positions.
effect fn sourceObserve<'body>(builder: &mut SourceGraph.Builder<'body>, operands: &[SourceOperand],
  phase: SourceGraph.ValuePhase, paths: &mut List<List<Step>>, loans: usize) -> SourceObservation
! OutOfMemoryError ? &mut Allocator {
  let unknown = SourceProgram.atom(&mut builder.rules)
  let mut observed = SourceObservation {positions: List<SourceCarryPosition>.make(),
    other: List<SourceGraph.Input>.make(), unknown: unknown}
  let mut operand = usize.ZERO
  while operand < operands.length {
    let actual = operands[operand]
    let components = run sourceComponents(SourceGraph.Builder.preparation(&builder.*), actual.root)
    let ordered = List<PreparedSources.EndpointId>.asSlice(&components)
    let mut component = usize.ZERO
    while component < ordered.length {
      let endpoint = ordered[component]
      {
        let values = SourceGraph.Builder.values(&builder.*)
        let mut value = usize.ZERO
        while value < values.length {
          let physical = sourcePhysicalValue(values[value])
          if physical && values[value].phase == phase && values[value].evaluation.index == actual.evaluation.index
            && values[value].endpoint.index == endpoint.index { break }
          value = value + usize.ONE
        }
        let evaluation = SourceGraph.Builder.evaluation(&builder.*, actual.evaluation)
        let completed = List<SourceControl.Point>.asSlice(&builder.reaching.points)[evaluation.point.index].reachable
        let mut present = List<SourceAtom>.make()
        if value < values.length {
          let id = SourceGraph.ValueId {index: value}
          run sourceObserveValue(&mut builder.*, &mut observed, actual, id, &mut paths.*, loans, &mut present, true)
        }
        // A completed physical component needs an actual source, including explicit
        // LoanFree for loan-free values. An empty candidate row, or candidates all absent
        // after solving, supplies no complete-source proof. Residual subjects above do not
        // discharge this physical component's obligation.
        let reached: [SourceAtom; 1] = [completed]
        run SourceProgram.rule(&mut builder.rules, unknown, &reached, List<SourceAtom>.asSlice(&present))
      }
      component = component + usize.ONE
    }
    operand = operand + usize.ONE
  }
  return move observed
}

// Attribute the supported exact-component read before finish observes it. A is the actual
// definition's canonical held component; B is the actual alias/local read's canonical
// component. The final consumer Copy is applied exactly once. InputCase.placement is already
// post-transfer and cannot stand for either original A or the selected address B.
//
// Summary Flow pairs retain their original prefix A independently from the requested B.
// A narrower read keeps unknown placement; an unknown whole holding remains MAX even for
// a whole read. Unsupported mapping remains present with a separate coverage obligation.
effect fn sourceAttributeRead<'body>(builder: &mut SourceGraph.Builder<'body>, observation: &mut SourceObservation,
  paths: &mut List<List<Step>>) -> SourceAtom ! OutOfMemoryError ? &mut Allocator {
  let empty = List<SourceAtom>.make()
  let none = List<SourceAtom>.asSlice(&empty)
  let mut gaps = List<SourceAtom>.make()
  let positions = List<SourceCarryPosition>.asMutSlice(&mut observation.positions)
  let mut position = usize.ZERO
  while position < positions.length {
    let actual = SourceGraph.Builder.value(&builder.*, positions[position].value)
    if actual.phase != SourceGraph.ValuePhase.Input {
      return CompilerBug.panic(b"read attribution observed a published or transport value")
    }
    if let Option<SourceGraph.ResidualSubject>.Some {..} = actual.subject {
      return CompilerBug.panic(b"virtual read attribution lacks an actual selected component")
    }
    let point = SourceGraph.Builder.evaluation(&builder.*, actual.evaluation).point
    let histories = List<SourceCarryCase>.asMutSlice(&mut positions[position].cases)
    if histories.length == usize.ZERO { run List<SourceAtom>.append(&mut gaps, positions[position].quality.present) }
    let mut history = usize.ZERO
    while history < histories.length {
      let paired = match histories[history].source.definition {
        Option<SourceControl.DefinitionId>.Some {value: definition} => match histories[history].source.read {
          Option<SourceControl.ReadId>.Some {value: read} => {
            let source = SourceGraph.Builder.definition(&builder.*, definition)
            let requested = SourceGraph.Builder.read(&builder.*, read)
            requested.point.index == point.index && sourceSameReadLane(source, requested)
          }
          _ => false
        }
        _ => false
      }
      let mut covered = List<SourceAtom>.make()
      let mut field = usize.MAX
      if paired {
        let definition = match histories[history].source.definition {
          Option<SourceControl.DefinitionId>.Some {value} => value
          _ => { return CompilerBug.panic(b"paired read lost its definition identity") }
        }
        let read = match histories[history].source.read {
          Option<SourceControl.ReadId>.Some {value} => value
          _ => { return CompilerBug.panic(b"paired read lost its read identity") }
        }
        if let Option<SourceAtom>.Some {value: reaches} = sourceFlowPair(&builder.reaching, definition, read) {
          let original = SourceGraph.Builder.definition(&builder.*, definition)
          let placements = run SourceGraph.Builder.readPlacements(&builder.*, positions[position].value, read)
          let alternatives = List<SourceGraph.ReadPlacement>.asSlice(&placements)
          let mut at = usize.ZERO
          while at < alternatives.length {
            let placement = alternatives[at]
            if placement.consumer.index != positions[position].value.index
              || placement.read.index != read.index || placement.result.index != actual.evaluation.index {
              return CompilerBug.panic(b"read placement belongs to another actual consumer")
            }
            let requested = SourceGraph.Builder.read(&builder.*, read)
            let selected = SourceGraph.Builder.read(&builder.*, placement.original)
            if sourcePlacementStorage(original, requested, selected, placement,
              List<PreparedSources.Endpoint>.asSlice(&SourceGraph.Builder.preparation(&builder.*).endpoints)) {
              let prepared = SourceGraph.Builder.preparation(&builder.*)
              let maps = List<PreparedSources.SelectionMap>.asSlice(&prepared.maps)
              if placement.map.index >= maps.length { return CompilerBug.panic(b"read placement has no final consumer map") }
              let map = &maps[placement.map.index]
              if map.kind != PreparedSources.MapKind.Copy || map.target.index != actual.endpoint.index {
                return CompilerBug.panic(b"read placement substituted its final component copy")
              }
              if let Option<usize>.None = placement.alias {
                if placement.operand.index != actual.evaluation.index || map.source.index != selected.storage.endpoint.index {
                  return CompilerBug.panic(b"direct local read substituted its selected canonical component")
                }
              }
              let attributed = run sourceReadField(List<PreparedSources.Endpoint>.asSlice(&prepared.endpoints),
                SourceGraph.Builder.summaries(&builder.*), original, placement, positions[position].root, map.target, &mut paths.*)
              if attributed.supported {
                field = attributed.field
                let proof: [SourceAtom; 2] = [reaches, placement.active]
                run List<SourceAtom>.append(&mut covered, run SourcePolicy.conjunction(&mut builder.rules, &proof, none))
              }
            }
            at = at + usize.ONE
          }
        }
      }
      let known = run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&covered))
      let observed: [SourceAtom; 1] = [histories[history].source.quality.present]
      let supported: [SourceAtom; 1] = [known]
      run List<SourceAtom>.append(&mut gaps, run SourcePolicy.conjunction(&mut builder.rules, &observed, &supported))
      histories[history].field = field
      // Preserve actual directness, paired identities and source quality. SummaryRead has
      // already made the summary indirect; attribution creates no new physical operand.
      history = history + usize.ONE
    }
    position = position + usize.ONE
  }
  let missing = run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&gaps))
  let incomplete: [SourceAtom; 2] = [observation.unknown, missing]
  observation.unknown = run SourcePolicy.disjunction(&mut builder.rules, &incomplete)
  return missing
}

effect fn sourceBarrier(observation: &SourceObservation, state: &mut SourcePolicy.LoanState,
  active: SourceAtom, rules: &mut SourceProgram) -> List<SourceQuality> ! OutOfMemoryError ? &mut Allocator {
  let positions = List<SourceCarryPosition>.asSlice(&observation.positions)
  let mut inputs = List<SourcePolicy.LoanInput>.make()
  let empty = List<SourceAtom>.make()
  let mut at = usize.ZERO
  while at < positions.length {
    let arriving = positions[at].quality
    let gates: [SourceAtom; 2] = [active, arriving.present]
    let present = run SourcePolicy.conjunction(&mut rules.*, &gates, List<SourceAtom>.asSlice(&empty))
    run List<SourcePolicy.LoanInput>.append(&mut inputs,
      SourcePolicy.LoanInput {loan: positions[at].loan,
        quality: SourceQuality {present: present, stored: arriving.stored, alternatives: arriving.alternatives}})
    at = at + usize.ONE
  }
  return run SourcePolicy.LoanState.barrier(&mut state.*, &mut rules.*, List<SourcePolicy.LoanInput>.asSlice(&inputs))
}

// The operation guard is the exact reserved execute/use/cleanup point. A never-returning
// operation can consume an input even though its result evaluation has no reachable output.
effect fn sourceConsume(observation: &SourceObservation, point: usize, active: SourceAtom,
  rules: &mut SourceProgram, intervals: &mut List<SourceIntervalEffect>) -> ()
! OutOfMemoryError ? &mut Allocator {
  let positions = List<SourceCarryPosition>.asSlice(&observation.positions)
  let empty = List<SourceAtom>.make()
  let mut at = usize.ZERO
  while at < positions.length {
    let cases = List<SourceCarryCase>.asSlice(&positions[at].cases)
    let mut each = usize.ZERO
    while each < cases.length {
      let guards: [SourceAtom; 2] = [active, cases[each].source.quality.present]
      let present = run SourcePolicy.conjunction(&mut rules.*, &guards, List<SourceAtom>.asSlice(&empty))
      run List<SourceIntervalEffect>.append(&mut intervals.*, SourceIntervalEffect {
        source: sourceEffectSource(&positions[at], &cases[each]), from: positions[at].since, to: point,
        cleanup: false, active: present})
      each = each + usize.ONE
    }
    at = at + usize.ONE
  }
  return ()
}

// The structural arm-result transfer already restarts the value at the join. Ownership only
// records the old flight and actual nonlocal crossings; it adds neither a CFG edge nor a
// second copy of the joined sources. Noncompletion is the original absent arm-result edge.
effect fn sourceRejoin(observation: &SourceObservation, loans: &[Loan], completed: usize,
  active: SourceAtom, rules: &mut SourceProgram) -> SourceJoinEffects
! OutOfMemoryError ? &mut Allocator {
  let mut effects = SourceJoinEffects {intervals: List<SourceIntervalEffect>.make(), crossings: List<SourceCrossingEffect>.make()}
  if completed == usize.MAX { return move effects }
  run sourceConsume(observation, completed, active, &mut rules.*, &mut effects.intervals)
  let positions = List<SourceCarryPosition>.asSlice(&observation.positions)
  let empty = List<SourceAtom>.make()
  let none = List<SourceAtom>.asSlice(&empty)
  let mut at = usize.ZERO
  while at < positions.length {
    if !loans[positions[at].loan].local {
      let histories = List<SourceCarryCase>.asSlice(&positions[at].cases)
      let mut each = usize.ZERO
      while each < histories.length {
        let present: [SourceAtom; 2] = [active, histories[each].source.quality.present]
        run List<SourceCrossingEffect>.append(&mut effects.crossings, SourceCrossingEffect {
          source: sourceEffectSource(&positions[at], &histories[each]),
          active: run SourcePolicy.conjunction(&mut rules.*, &present, none)})
        each = each + usize.ONE
      }
    }
    at = at + usize.ONE
  }
  return move effects
}

// Classify each paired history before completing parent closure. The unchanged keptSink
// predicate preserves Same/Unknown slot behavior and never manufactures located evidence.
effect fn sourceRetainedSinks(observation: &SourceObservation, snapshot: &[SourceQuality], loans: &[Loan],
  paths: &[List<Step>], owner: &DeclarationId, sinks: &[OperandSink], only: usize,
  point: usize, active: SourceAtom, rules: &mut SourceProgram) -> SourceRetentionCases
! OutOfMemoryError ? &mut Allocator {
  let positions = List<SourceCarryPosition>.asSlice(&observation.positions)
  if snapshot.length != positions.length { CompilerBug.panic(b"retention lost its input observation version") }
  let empty = List<SourceAtom>.make()
  let none = List<SourceAtom>.asSlice(&empty)
  let yes = run sourceBoolean(&mut rules.*, true)
  let mut inputs = List<SourcePolicy.RetentionInput>.make()
  let mut carries = List<Carry>.make()
  let mut sources = List<SourceEffectSource>.make()
  let mut at = usize.ZERO
  while at < positions.length {
    let position = &positions[at]
    let cases = List<SourceCarryCase>.asSlice(&position.cases)
    let mut each = usize.ZERO
    while each < cases.length {
      let carry = sourcePredicateCarry(position, &cases[each])
      let mut operand = only
      if operand == usize.MAX { operand = position.operand }
      let mut located = false
      let mut initial = CallSink.Local
      if operand < sinks.length { initial = keptSink(paths, &loans[position.loan], owner, carry, &sinks[operand], &mut located) }
      let sink = match initial {
        CallSink.Local => SourcePolicy.Sink.Local
        CallSink.Universal => SourcePolicy.Sink.Universal
        CallSink.Unknown => SourcePolicy.Sink.Unknown
      }
      let guards: [SourceAtom; 2] = [active, cases[each].source.quality.present]
      let present = run SourcePolicy.conjunction(&mut rules.*, &guards, none)
      let quality = SourceQuality {present: present, stored: snapshot[at].stored, alternatives: snapshot[at].alternatives}
      run List<SourcePolicy.RetentionInput>.append(&mut inputs, SourcePolicy.RetentionInput {
        quality: quality, initial: sink, local: loans[position.loan].local, located: located,
        knownField: carry.field != usize.MAX, actualPoint: point != usize.MAX})
      run List<Carry>.append(&mut carries, carry)
      run List<SourceEffectSource>.append(&mut sources, sourceEffectSource(position, &cases[each]))
      each = each + usize.ONE
    }
    at = at + usize.ONE
  }
  let actual = List<Carry>.asSlice(&carries)
  let mut parents = List<SourceParentEdge>.make()
  at = usize.ZERO
  while at < actual.length {
    if let Option<Shared<Lifetime>>.Some {value: parent} = &loans[actual[at].loan].parent {
      let mut candidate = usize.ZERO
      while candidate < actual.length {
        if only != usize.MAX || actual[at].operand == actual[candidate].operand {
          if let Option<Shared<Lifetime>>.Some {value: borrowed} = &loans[actual[candidate].loan].borrowed {
            if meetMember(&parent, &borrowed) {
              run List<SourceParentEdge>.append(&mut parents,
                SourceParentEdge {child: at, parent: candidate, applicable: yes})
            }
          }
        }
        candidate = candidate + usize.ONE
      }
    }
    at = at + usize.ONE
  }
  let decisions = run SourcePolicy.retention(&mut rules.*, List<SourcePolicy.RetentionInput>.asSlice(&inputs),
    List<SourceParentEdge>.asSlice(&parents))
  return SourceRetentionCases {sources: move sources, decisions: move decisions}
}

effect fn sourceKeepCarried(observation: &SourceObservation, snapshot: &[SourceQuality], loans: &[Loan],
  paths: &[List<Step>], owner: &DeclarationId, sinks: &[OperandSink], only: usize,
  point: usize, active: SourceAtom, rules: &mut SourceProgram) -> List<SourceRetentionEffect>
! OutOfMemoryError ? &mut Allocator {
  let classified = run sourceRetainedSinks(observation, snapshot, loans, paths, owner, sinks, only, point, active, &mut rules.*)
  let decisions = List<SourcePolicy.RetentionOutput>.asSlice(&classified.decisions)
  let mut effects = List<SourceRetentionEffect>.make()
  let mut at = usize.ZERO
  while at < decisions.length {
    run List<SourceRetentionEffect>.append(&mut effects, SourceRetentionEffect {
      source: List<SourceEffectSource>.asSlice(&classified.sources)[at], point: point, caller: decisions[at].caller,
      independent: decisions[at].independentEscape, storing: decisions[at].storing})
    at = at + usize.ONE
  }
  return move effects
}

enum SourceSlotCoverage { Complete, Empty, Missing }

fn sourceSlotCoverage(slot: &PreparedSources.SlotSelection) -> SourceSlotCoverage {
  return match &slot.coverage {
    PreparedSources.SlotCoverage.Exact => SourceSlotCoverage.Complete
    PreparedSources.SlotCoverage.EmptyArray {..} => SourceSlotCoverage.Empty
    _ => SourceSlotCoverage.Missing
  }
}

// Original and physical paths are frozen separately. A complete opaque original can have
// a concrete physical inline frontier; an unfinished prefix in either coordinate stays a gap.
fn sourceKeptCoverage(retention: &PreparedSources.Retention, coordinate: SourceKeptSlot) -> SourceSlotCoverage {
  let operands = List<PreparedSources.RetentionOperand>.asSlice(&retention.operands)
  let mut found = false
  let mut result = SourceSlotCoverage.Missing
  let mut at = usize.ZERO
  while at < operands.length {
    if operands[at].operand == coordinate.operand {
      let slots = List<PreparedSources.RetentionSlot>.asSlice(&operands[at].slots)
      let mut each = usize.ZERO
      while each < slots.length {
        if slots[each].slot == coordinate.slot {
          if found { return CompilerBug.panic(b"retained slot has duplicate original coordinates") }
          found = true
          let original = sourceSlotCoverage(&slots[each].original)
          let physical = sourceSlotCoverage(&slots[each].physical)
          if original == SourceSlotCoverage.Empty || physical == SourceSlotCoverage.Empty { result = SourceSlotCoverage.Empty }
          else if original == SourceSlotCoverage.Complete && physical == SourceSlotCoverage.Complete { result = SourceSlotCoverage.Complete }
        }
        each = each + usize.ONE
      }
    }
    at = at + usize.ONE
  }
  return result
}

// The selected source and destination slots are the actual recorded KeptSlots, not inferred
// contract/result routes. This is semantic pair eligibility only: the caller must separately
// bind the reserved canonical write, original source history and selected address authority.
// Incomplete structural/read evidence stays visible even when an eligibility test says drop.
effect fn sourceKeptSlotFacts(retention: &PreparedSources.Retention, sourceSlot: SourceKeptSlot,
  targetSlot: SourceKeptSlot, position: &SourceCarryPosition, history: &SourceCarryCase,
  destination: &SourceCarryPosition, targetHistory: &SourceCarryCase, loans: &[Loan], paths: &[List<Step>],
  owner: &DeclarationId, edges: &[RetentionEdge], named: &[Shared<Lifetime>]) -> SourceStoreFacts
! OutOfMemoryError ? &mut Allocator {
  if position.loan >= loans.length || destination.loan >= loans.length || position.operand != sourceSlot.operand
    || destination.operand != targetSlot.operand { return CompilerBug.panic(b"kept-slot decision lost its actual operand or loan") }
  let complete = Shared<SourceRetention>.with<bool>(&retention.source, fn(source: &SourceRetention) -> bool {
    return match source.coverage { SourceRetentionCoverage.Complete => true _ => false }
  })
  let original = sourceKeptCoverage(retention, sourceSlot)
  let target = sourceKeptCoverage(retention, targetSlot)
  let carry = sourcePredicateCarry(position, history)
  let lent = sourcePredicateCarry(destination, targetHistory)
  let origins = run keptOrigins(&loans[position.loan], owner, edges)
  let permitted = Shared<List<KeptRegions>>.with<bool>(&retention.recorded, fn(values: &List<KeptRegions>) -> bool {
    let entries = List<KeptRegions>.asSlice(values)
    if sourceSlot.operand >= entries.length || targetSlot.operand >= entries.length {
      return CompilerBug.panic(b"selected retained operand is absent from its original record")
    }
    let sources = List<KeptSlot>.asSlice(&entries[sourceSlot.operand].slots)
    let destinations = List<KeptSlot>.asSlice(&entries[targetSlot.operand].slots)
    if sourceSlot.slot >= sources.length || targetSlot.slot >= destinations.length {
      return CompilerBug.panic(b"selected retained slot is absent from its original record")
    }
    return keptSlotIn(&sources[sourceSlot.slot], &loans[position.loan], carry, paths, owner,
      List<Shared<Lifetime>>.asSlice(&origins.regions), List<usize>.asSlice(&origins.reached), named)
      && destinationSlotKeeps(&sources[sourceSlot.slot], &destinations[targetSlot.slot], paths, lent, named)
  })
  return SourceStoreFacts {permitted: permitted,
    empty: original == SourceSlotCoverage.Empty || target == SourceSlotCoverage.Empty,
    complete: complete && original != SourceSlotCoverage.Missing && target != SourceSlotCoverage.Missing}
}

effect fn sourceKeptSlotDecision(facts: SourceStoreFacts, history: &SourceCarryCase,
  targetHistory: &SourceCarryCase, active: SourceAtom, exclusion: SourceReadExclusion,
  rules: &mut SourceProgram) -> SourceStoreDecision ! OutOfMemoryError ? &mut Allocator {
  let empty = List<SourceAtom>.make()
  let none = List<SourceAtom>.asSlice(&empty)
  let actual: [SourceAtom; 3] = [active, history.source.quality.present, targetHistory.source.quality.present]
  let present = run SourcePolicy.conjunction(&mut rules.*, &actual, none)
  let no = SourceProgram.atom(&mut rules.*)
  let mut eligible = no
  if facts.permitted && !facts.empty {
    let positive: [SourceAtom; 1] = [present]
    let excluded: [SourceAtom; 1] = [exclusion.excluded]
    eligible = run SourcePolicy.conjunction(&mut rules.*, &positive, &excluded)
  }
  let mut missing = no
  if !facts.complete { missing = present }
  let unknownRead: [SourceAtom; 2] = [present, exclusion.missing]
  let gaps: [SourceAtom; 2] = [missing, run SourcePolicy.conjunction(&mut rules.*, &unknownRead, none)]
  return SourceStoreDecision {eligible: eligible, missing: run SourcePolicy.disjunction(&mut rules.*, &gaps)}
}

struct SourceStoreEffects {
  intervals: List<SourceIntervalEffect>
  refusal: SourceAtom
  missing: SourceAtom
}

// Only a retained address's exact descriptor Value/leaf is observed here. Its paired
// history is checked below; another descriptor in the same region cannot stand in for it.
effect fn sourceRetainedDescriptor<'body>(builder: &mut SourceGraph.Builder<'body>,
  address: SourceGraph.RetainedAddress, operand: SourceOperand, paths: &mut List<List<Step>>,
  loans: usize) -> SourceObservation ! OutOfMemoryError ? &mut Allocator {
  let unknown = SourceProgram.atom(&mut builder.rules)
  let mut result = SourceObservation {positions: List<SourceCarryPosition>.make(), other: List<SourceGraph.Input>.make(), unknown: unknown}
  let actual = SourceGraph.Builder.value(&builder.*, address.descriptor)
  let evaluation = SourceGraph.Builder.evaluation(&builder.*, actual.evaluation)
  let mut inputs = run SourceGraph.Builder.inputs(&mut builder.*, address.descriptor)
  let mut covered = List<SourceAtom>.make()
  while List<SourceGraph.Input>.length(&inputs) > usize.ZERO {
    let input = List<SourceGraph.Input>.remove(&mut inputs, usize.ZERO)
    if input.leaf.index == address.leaf.index {
      let loan = match &SourceGraph.Builder.leaf(&builder.*, input.leaf).kind {
        SourceGraph.SourceLeaf.Borrow {loan, ..} => loan
        _ => usize.MAX
      }
      if loan == usize.MAX {
        run List<SourceGraph.Input>.append(&mut result.other, move input)
      } else {
        if loan >= loans { return CompilerBug.panic(b"retained descriptor lost its actual loan") }
        let mut cases = List<SourceCarryCase>.make()
        let mut histories = move input.cases
        while List<SourceGraph.InputCase>.length(&histories) > usize.ZERO {
          let history = List<SourceGraph.InputCase>.remove(&mut histories, usize.ZERO)
          if history.direct == address.direct && sourceDefinitionMatches(history.definition, address.definition)
            && sourceReadMatches(history.read, address.read) {
            let endpoints = List<PreparedSources.Endpoint>.asSlice(&SourceGraph.Builder.preparation(&builder.*).endpoints)
            let mut current = history.placement
            let mut remaining = endpoints.length
            while current.index != operand.root.index && remaining > usize.ZERO {
              match endpoints[current.index].parent {
                Option<PreparedSources.EndpointId>.Some {value} => { current = value }
                _ => { break }
              }
              remaining = remaining - usize.ONE
            }
            let mut field = usize.MAX
            if current.index == operand.root.index {
              field = run sourceField(endpoints, operand.root, history.placement, &mut paths.*)
              run List<SourceAtom>.append(&mut covered, history.quality.present)
            }
            run List<SourceCarryCase>.append(&mut cases, SourceCarryCase {source: move history, field: field})
          }
        }
        run List<SourceCarryPosition>.append(&mut result.positions, SourceCarryPosition {
          node: operand.node, root: operand.root, value: address.descriptor, leaf: input.leaf,
          loan: loan, operand: operand.ordinal, since: evaluation.point.index,
          quality: sourceQuality(input.quality), cases: move cases})
      }
    }
  }
  let actual: [SourceAtom; 1] = [address.active]
  run SourceProgram.rule(&mut builder.rules, unknown, &actual, List<SourceAtom>.asSlice(&covered))
  return move result
}

// Reference-holder refusal observes only the reserved current read. It cannot use the
// postwrite Output (which would make the candidate itself prove that the holder has loans).
effect fn sourceReferenceHeld<'body>(builder: &mut SourceGraph.Builder<'body>, id: usize)
  -> SourceCallerEvidence ! OutOfMemoryError ? &mut Allocator {
  let mut reads = List<SourceControl.ReadId>.make()
  let components = List<SourceGraph.WriteComponent>.asSlice(&SourceGraph.Builder.writeHolder(&builder.*, id).components)
  let mut at = usize.ZERO
  while at < components.length {
    run List<SourceControl.ReadId>.append(&mut reads, components[at].read)
    at = at + usize.ONE
  }
  let mut held = List<SourceAtom>.make()
  let mut gaps = List<SourceAtom>.make()
  at = usize.ZERO
  while at < List<SourceControl.ReadId>.length(&reads) {
    let read = SourceGraph.Builder.read(&builder.*, List<SourceControl.ReadId>.asSlice(&reads)[at])
    let value = SourceGraph.Builder.value(&builder.*, read.value)
    if value.phase != SourceGraph.ValuePhase.Input { return CompilerBug.panic(b"reference holder refusal observed its new write") }
    let inputs = run SourceGraph.Builder.inputs(&mut builder.*, read.value)
    let sources = List<SourceGraph.Input>.asSlice(&inputs)
    let mut covered = List<SourceAtom>.make()
    let mut each = usize.ZERO
    while each < sources.length {
      run List<SourceAtom>.append(&mut covered, sources[each].quality.present)
      match &SourceGraph.Builder.leaf(&builder.*, sources[each].leaf).kind {
        SourceGraph.SourceLeaf.Borrow {..} => run List<SourceAtom>.append(&mut held, sources[each].quality.present)
        SourceGraph.SourceLeaf.Unknown {..} => run List<SourceAtom>.append(&mut gaps, sources[each].quality.present)
        _ => ()
      }
      each = each + usize.ONE
    }
    let reached: [SourceAtom; 1] = [List<SourceControl.Point>.asSlice(&builder.reaching.points)[read.point.index].reachable]
    let missing = SourceProgram.atom(&mut builder.rules)
    run SourceProgram.rule(&mut builder.rules, missing, &reached, List<SourceAtom>.asSlice(&covered))
    run List<SourceAtom>.append(&mut gaps, missing)
    at = at + usize.ONE
  }
  return SourceCallerEvidence {present: run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&held)),
    missing: run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&gaps))}
}

// Whole-holder use observes every OLD physical component under holder.active. Summary
// histories are observed once through the root read, not again for each child snapshot.
effect fn sourceObserveWriteHolder<'body>(builder: &mut SourceGraph.Builder<'body>, id: usize,
  paths: &mut List<List<Step>>, loans: usize) -> SourceObservation ! OutOfMemoryError ? &mut Allocator {
  let holder = SourceGraph.Builder.writeHolder(&builder.*, id)
  let storage = holder.storage
  let execution = holder.execution
  let evaluation = SourceGraph.Builder.evaluation(&builder.*, execution)
  let node = match evaluation.site { SourceGraph.EvaluationSite.Node {node} => node
    _ => { return CompilerBug.panic(b"whole-holder observation has no executing operation") } }
  let mut reads = List<SourceControl.ReadId>.make()
  let components = List<SourceGraph.WriteComponent>.asSlice(&holder.components)
  let mut at = usize.ZERO
  while at < components.length { run List<SourceControl.ReadId>.append(&mut reads, components[at].read) at = at + usize.ONE }
  let unknown = SourceProgram.atom(&mut builder.rules)
  let mut observation = SourceObservation {positions: List<SourceCarryPosition>.make(), other: List<SourceGraph.Input>.make(), unknown: unknown}
  let mut roots = usize.ZERO
  at = usize.ZERO
  while at < List<SourceControl.ReadId>.length(&reads) {
    let read = SourceGraph.Builder.read(&builder.*, List<SourceControl.ReadId>.asSlice(&reads)[at])
    let value = SourceGraph.Builder.value(&builder.*, read.value)
    if value.phase != SourceGraph.ValuePhase.Input || value.evaluation.index != execution.index
      || read.point.index != evaluation.point.index || !sourcePhysicalValue(value) {
      return CompilerBug.panic(b"whole-holder snapshot substituted a received write or another observation")
    }
    let whole = sourceSameStorage(storage, read.storage)
    if whole { roots = roots + usize.ONE }
    let operand = SourceOperand {node: node, evaluation: execution, root: storage.endpoint, ordinal: usize.MAX}
    let mut present = List<SourceAtom>.make()
    run sourceObserveValue(&mut builder.*, &mut observation, operand, read.value, &mut paths.*, loans, &mut present, whole)
    let reached: [SourceAtom; 1] = [List<SourceControl.Point>.asSlice(&builder.reaching.points)[read.point.index].reachable]
    run SourceProgram.rule(&mut builder.rules, unknown, &reached, List<SourceAtom>.asSlice(&present))
    at = at + usize.ONE
  }
  if roots != usize.ONE { return CompilerBug.panic(b"whole-holder summary observation lost its single actual root read") }
  return move observation
}

fn sourceReadTarget<'body>(builder: &SourceGraph.Builder<'body>, read: SourceGraph.ReadView, target: SourceGraph.ValueId) -> bool {
  if read.value.index == target.index { return true }
  if let Option<usize>.Some {value: summary} = read.summary {
    let reads = SourceGraph.Builder.summaryReads(builder)
    let mut at = usize.ZERO
    while at < reads.length {
      if reads[at].read.index == read.id.index && reads[at].summary == summary && reads[at].target.index == target.index { return true }
      at = at + usize.ONE
    }
  }
  return false
}

// A whole-holder prewrite read observes Input, never the Output that includes the new
// weak write. Its genuine paired definitions keep prior loans live only when a slot was
// accepted. Weak storage publication itself belongs to the sole source-flow reservation.
effect fn sourceUseWriteHolder<'body>(builder: &mut SourceGraph.Builder<'body>, id: usize,
  state: &mut SourcePolicy.LoanState, loans: &[Loan], paths: &mut List<List<Step>>,
  holders: &mut SourceHolderProjection, effects: &mut SourceStoreEffects) -> ()
! OutOfMemoryError ? &mut Allocator {
  let holder = SourceGraph.Builder.writeHolder(&builder.*, id)
  let storage = holder.storage
  let active = holder.active
  let execution = holder.execution
  let at = SourceGraph.Builder.evaluation(&builder.*, execution)
  let observation = run sourceObserveWriteHolder(&mut builder.*, id, &mut paths.*, loans.length)
  drop run sourceBarrier(&observation, &mut state.*, active, &mut builder.rules)
  let empty = List<SourceAtom>.make()
  let none = List<SourceAtom>.asSlice(&empty)
  let unknown: [SourceAtom; 2] = [active, observation.unknown]
  let gaps: [SourceAtom; 2] = [effects.missing, run SourcePolicy.conjunction(&mut builder.rules, &unknown, none)]
  effects.missing = run SourcePolicy.disjunction(&mut builder.rules, &gaps)
  let request = List<SourceHolderRequest>.length(&holders.requests)
  run List<SourceHolderRequest>.append(&mut holders.requests, SourceHolderRequest {
    owner: Option<SourceVisit.OwnerId>.none(), evaluation: execution, root: storage.endpoint, point: at.point, active: active})
  run List<SourceHolderUse>.append(&mut holders.uses, SourceHolderUse {request: request, storage: storage, active: active})
  let positions = List<SourceCarryPosition>.asSlice(&observation.positions)
  let mut position = usize.ZERO
  while position < positions.length {
    let histories = List<SourceCarryCase>.asSlice(&positions[position].cases)
    let mut each = usize.ZERO
    while each < histories.length {
      let history = &histories[each]
      let gates: [SourceAtom; 2] = [active, history.source.quality.present]
      let present = run SourcePolicy.conjunction(&mut builder.rules, &gates, none)
      let mut authenticated = false
      if let Option<SourceControl.DefinitionId>.Some {value: definition} = history.source.definition {
        if let Option<SourceControl.ReadId>.Some {value: read} = history.source.read {
          let original = SourceGraph.Builder.definition(&builder.*, definition)
          let current = SourceGraph.Builder.read(&builder.*, read)
          if sourceReadTarget(&builder.*, current, positions[position].value) && current.point.index == at.point.index
            && sourceSameReadLane(original, current) {
            if let Option<SourceAtom>.Some {value: pair} = sourceFlowPair(&builder.reaching, definition, read) {
              let paired: [SourceAtom; 2] = [present, pair]
              run List<SourceIntervalEffect>.append(&mut effects.intervals, SourceIntervalEffect {
                source: sourceEffectSource(&positions[position], history), from: original.point.index, to: at.point.index,
                cleanup: false, active: run SourcePolicy.conjunction(&mut builder.rules, &paired, none)})
              authenticated = true
            }
          }
        }
      }
      if !authenticated {
        let missing: [SourceAtom; 2] = [effects.missing, present]
        effects.missing = run SourcePolicy.disjunction(&mut builder.rules, &missing)
      }
      each = each + usize.ONE
    }
    position = position + usize.ONE
  }
  return ()
}

// The inventory already resolved Immediate Run's actual receiver chain. Resolve only its
// frozen original declaration here; never search for a runtime occurrence by typed NodeId.
// Runtime input order is Visit.inputs position, independent of Value/port allocation order.
effect fn sourceStoreOperands<'body>(builder: &SourceGraph.Builder<'body>, operation: usize)
  -> List<SourceOperand> ! OutOfMemoryError ? &mut Allocator {
  let operations = List<SourceStores.Operation>.asSlice(&SourceGraph.Builder.stores(builder).operations)
  if operation >= operations.length { return CompilerBug.panic(b"retained policy has no actual executing operation") }
  let actual = &operations[operation]
  let origin = SourceGraph.Builder.evaluation(builder, actual.originating)
  let site = match origin.site { SourceGraph.EvaluationSite.Node {node} => node
    _ => { return CompilerBug.panic(b"retained invocation originated at a body parameter") } }
  let prepared = SourceGraph.Builder.preparation(builder)
  let retention = &List<PreparedSources.Retention>.asSlice(&prepared.retentions)[actual.retention.index]
  if retention.site.index != site.index { return CompilerBug.panic(b"retained inputs lost their actual originating stage") }
  let rows = List<PreparedSources.Operation>.asSlice(&prepared.operations)
  let mut row = usize.MAX
  let mut at = usize.ZERO
  while at < rows.length {
    if rows[at].site.index == site.index {
      if row != usize.MAX { return CompilerBug.panic(b"retained originating stage has duplicate prepared operations") }
      row = at
    }
    at = at + usize.ONE
  }
  if row == usize.MAX { return CompilerBug.panic(b"retained originating stage has no prepared operation") }
  let routes = List<PreparedSources.InputRoute>.asSlice(&rows[row].inputs)
  let maps = List<PreparedSources.SelectionMap>.asSlice(&prepared.maps)
  let endpoints = List<PreparedSources.Endpoint>.asSlice(&prepared.endpoints)
  let inputs = List<SourceStores.Input>.asSlice(&actual.inputs)
  let mut ordered = List<usize>.make()
  at = usize.ZERO
  while at < inputs.length {
    let mut position = usize.ZERO
    while position < List<usize>.length(&ordered)
      && inputs[List<usize>.asSlice(&ordered)[position]].position < inputs[at].position { position = position + usize.ONE }
    if position < List<usize>.length(&ordered)
      && inputs[List<usize>.asSlice(&ordered)[position]].position == inputs[at].position {
      return CompilerBug.panic(b"retained stage repeated one actual operand position")
    }
    run List<usize>.insert(&mut ordered, position, at)
    at = at + usize.ONE
  }
  let mut result = List<SourceOperand>.make()
  let order = List<usize>.asSlice(&ordered)
  at = usize.ZERO
  while at < order.length {
    let input = &inputs[order[at]]
    if input.route >= routes.length { return CompilerBug.panic(b"retained input substituted another original route") }
    let root = maps[routes[input.route].map.index].source
    let node = match &endpoints[root.index].root {
      PreparedSources.Root.Node {node, role: PreparedSources.EndpointRole.Value} => node
      _ => { return CompilerBug.panic(b"retained input has no actual physical value root") }
    }
    let observed = SourceGraph.Builder.evaluation(builder, input.actual.evaluation)
    let same = match observed.site { SourceGraph.EvaluationSite.Node {node: actual} => actual.index == node.index _ => false }
    if !same || input.actual.node.index != node.index {
      return CompilerBug.panic(b"retained physical input changed its actual evaluation")
    }
    run List<SourceOperand>.append(&mut result, SourceOperand {node: node, evaluation: input.actual.evaluation,
      root: root, ordinal: input.operand})
    at = at + usize.ONE
  }
  return move result
}

// Select one reserved placement family for the unchanged destinationField decision.
// A nonselected alternative is a grounded drop, not missing coverage. Exact placement wins
// at the selected component; ancestor/unknown holdings use their distinct summary lanes.
effect fn sourceWriteMatches<'body>(builder: &SourceGraph.Builder<'body>, candidate: SourceGraph.RetainedWrite,
  field: usize, paths: &mut List<List<Step>>) -> bool ! OutOfMemoryError ? &mut Allocator {
  let holder = SourceGraph.Builder.writeHolder(builder, candidate.holder).storage
  let address = SourceGraph.Builder.retainedAddresses(builder)[candidate.address]
  let endpoints = List<PreparedSources.Endpoint>.asSlice(&SourceGraph.Builder.preparation(builder).endpoints)
  let exact = run sourceField(endpoints, holder.endpoint, address.storage.endpoint, &mut paths.*)
  let mut merged = Option<usize>.some(field)
  drop sourceMergeField(List<List<Step>>.asSlice(&paths.*), &mut merged, exact)
  let same = field != usize.MAX && exact != usize.MAX
    && match merged { Option<usize>.Some {value} => value != usize.MAX _ => false }
  let summary = match candidate.summary {
    Option<usize>.Some {value} => SourceGraph.Builder.summaries(builder)[value]
    _ => { return same }
  }
  if summary.unknown { return field == usize.MAX && sourceSameStorage(summary.prefix, holder) }
  if field == usize.MAX || same { return false }
  let prefix = run sourceField(endpoints, holder.endpoint, summary.prefix.endpoint, &mut paths.*)
  merged = Option<usize>.some(field)
  drop sourceMergeField(List<List<Step>>.asSlice(&paths.*), &mut merged, prefix)
  return prefix != usize.MAX && match merged { Option<usize>.Some {value} => value != usize.MAX _ => false }
}

effect fn sourceWriteCovered<'body>(builder: &SourceGraph.Builder<'body>, candidate: SourceGraph.RetainedWrite,
  field: usize, paths: &mut List<List<Step>>) -> bool ! OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < SourceGraph.Builder.policyCount(builder) {
    let port = SourceGraph.Builder.policy(builder, at)
    if let SourceGraph.TransferAuthority.RetainedWrite {candidate: id} = port.authority {
      let other = SourceGraph.Builder.writeCandidate(builder, id)
      if other.operation == candidate.operation && other.sourceInput == candidate.sourceInput
        && other.sourceSlot == candidate.sourceSlot && other.address == candidate.address
        && other.source.index == candidate.source.index && other.holder == candidate.holder {
        if run sourceWriteMatches(builder, other, field, &mut paths.*) { return true }
      }
    }
    at = at + usize.ONE
  }
  return false
}

// This handler owns only the executing call's declared slots. Callable-environment writes
// require their separate authority. Observe the exact original inputs once in runtime order;
// policy histories do not add physical operands or re-run an acquisition.
effect fn sourceStoreIntoLent<'body>(builder: &mut SourceGraph.Builder<'body>, operation: usize,
  state: &mut SourcePolicy.LoanState, loans: &[Loan], locals: &[Local], paths: &mut List<List<Step>>,
  owner: &DeclarationId, edges: &[RetentionEdge], holders: &mut SourceHolderProjection)
  -> SourceStoreEffects ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let operands = run sourceStoreOperands(&builder.*, operation)
  let observation = run sourceObserve(&mut builder.*, List<SourceOperand>.asSlice(&operands),
    SourceGraph.ValuePhase.Output, &mut paths.*, loans.length)
  let no = SourceProgram.atom(&mut builder.rules)
  let mut effects = SourceStoreEffects {intervals: List<SourceIntervalEffect>.make(), refusal: no, missing: no}
  let empty = List<SourceAtom>.make()
  let none = List<SourceAtom>.asSlice(&empty)
  let mut used = List<usize>.make()
  let count = SourceGraph.Builder.policyCount(&builder.*)
  let execution = List<SourceStores.Operation>.asSlice(&SourceGraph.Builder.stores(&builder.*).operations)[operation].execute
  let reached = List<SourceControl.Point>.asSlice(&builder.reaching.points)[execution.index].reachable
  let incomplete: [SourceAtom; 2] = [reached, observation.unknown]
  effects.missing = run SourcePolicy.conjunction(&mut builder.rules, &incomplete, none)
  let positions = List<SourceCarryPosition>.asSlice(&observation.positions)
  let mut policy = usize.ZERO
  while policy < count {
    let port = SourceGraph.Builder.policy(&builder.*, policy)
    if let SourceGraph.TransferAuthority.RetainedWrite {candidate: id} = port.authority {
      let candidate = SourceGraph.Builder.writeCandidate(&builder.*, id)
      if candidate.operation == operation {
        if port.terminal || port.outputDirect || port.source.index != candidate.source.index || port.target.index != candidate.target.index {
          return CompilerBug.panic(b"retained policy changed its actual indirect write")
        }
        let address = SourceGraph.Builder.retainedAddresses(&builder.*)[candidate.address]
        let inventory = &List<SourceStores.Operation>.asSlice(&SourceGraph.Builder.stores(&builder.*).operations)[operation]
        let retention = inventory.retention
        let inputs = List<SourceStores.Input>.asSlice(&inventory.inputs)
        let source = &inputs[candidate.sourceInput]
        let destination = &inputs[address.input]
        let sourceSlot = SourceKeptSlot {operand: source.operand,
          slot: List<SourceStores.Slot>.asSlice(&source.slots)[candidate.sourceSlot].slot}
        let target = &List<SourceStores.Slot>.asSlice(&destination.slots)[address.slot]
        let targetSlot = SourceKeptSlot {operand: destination.operand, slot: target.slot}
        let selected = &List<PreparedSources.Selection>.asSlice(&SourceGraph.Builder.preparation(&builder.*).selections)[target.physical.index]
        let operand = SourceOperand {node: destination.actual.node, evaluation: destination.actual.evaluation,
          root: selected.root, ordinal: destination.operand}
        let actualSource = source.actual.evaluation
        let canonical = SourceGraph.Builder.writeHolder(&builder.*, candidate.holder).storage
        let root = match &List<PreparedSources.Endpoint>.asSlice(&SourceGraph.Builder.preparation(&builder.*).endpoints)[canonical.endpoint.index].root {
          PreparedSources.Root.Local {local, role: PreparedSources.EndpointRole.Storage} => local.index
          _ => usize.MAX
        }
        let activeGates: [SourceAtom; 3] = [port.active, candidate.active, address.active]
        let active = run SourcePolicy.conjunction(&mut builder.rules, &activeGates, none)
        let presentGates: [SourceAtom; 2] = [active, port.quality.present]
        let present = run SourcePolicy.conjunction(&mut builder.rules, &presentGates, none)
        let mut kept = List<SourceAtom>.make()
        let mut gaps = List<SourceAtom>.make()
        let mut matched = List<SourceAtom>.make()
        let borrowed = match &SourceGraph.Builder.leaf(&builder.*, port.leaf).kind {
          SourceGraph.SourceLeaf.Borrow {..} => true
          SourceGraph.SourceLeaf.LoanFree {..} => false
          _ => { run List<SourceAtom>.append(&mut gaps, present) false }
        }
        if borrowed {
          let descriptor = run sourceRetainedDescriptor(&mut builder.*, address, operand, &mut paths.*, loans.length)
          let unknown: [SourceAtom; 2] = [present, descriptor.unknown]
          run List<SourceAtom>.append(&mut gaps, run SourcePolicy.conjunction(&mut builder.rules, &unknown, none))
          let targets = List<SourceCarryPosition>.asSlice(&descriptor.positions)
          let mut position = usize.ZERO
          while position < positions.length {
            let incoming = &positions[position]
            if incoming.value.index == port.source.index && incoming.leaf.index == port.leaf.index
              && incoming.operand == sourceSlot.operand
              && SourceGraph.Builder.value(&builder.*, incoming.value).evaluation.index == actualSource.index {
              let histories = List<SourceCarryCase>.asSlice(&incoming.cases)
              let mut each = usize.ZERO
              while each < histories.length {
                let history = &histories[each]
                if history.source.direct == port.direct && sourceDefinitionMatches(history.source.definition, port.definition)
                  && sourceReadMatches(history.source.read, port.read) {
                  run List<SourceAtom>.append(&mut matched, history.source.quality.present)
                  let exclusion = run sourceReadExclusion(&mut builder.*, sourceEffectSource(incoming, history), active, &mut paths.*)
                  run List<SourceAtom>.append(&mut gaps, exclusion.missing)
                  let mut target = usize.ZERO
                  while target < targets.length {
                    let lent = &targets[target]
                    let loan = &loans[lent.loan]
                    if loan.exclusive && loan.place.root < locals.length && loans[incoming.loan].place.root != loan.place.root {
                      if root != loan.place.root {
                        let unresolved: [SourceAtom; 2] = [present, lent.quality.present]
                        run List<SourceAtom>.append(&mut gaps, run SourcePolicy.conjunction(&mut builder.rules, &unresolved, none))
                      } else {
                        let ty = localType(locals, root)
                        let mut named = List<Shared<Lifetime>>.make()
                        run Type.regionAtoms(&ty, &mut named)
                        if run retains(&ty, owner) {
                          let cases = List<SourceCarryCase>.asSlice(&lent.cases)
                          let mut which = usize.ZERO
                          while which < cases.length {
                            let record = &List<PreparedSources.Retention>.asSlice(&SourceGraph.Builder.preparation(&builder.*).retentions)[retention.index]
                            let facts = run sourceKeptSlotFacts(record, sourceSlot, targetSlot, incoming, history, lent, &cases[which],
                              loans, List<List<Step>>.asSlice(&paths.*), owner, edges, List<Shared<Lifetime>>.asSlice(&named))
                            let field = run destinationField(&record.recorded, loans, &mut paths.*, sourcePredicateCarry(lent, &cases[which]), targetSlot.slot)
                            let decision = run sourceKeptSlotDecision(facts, history, &cases[which], active, exclusion, &mut builder.rules)
                            run List<SourceAtom>.append(&mut gaps, decision.missing)
                            if Shared<Type>.with<bool>(&ty, referenceType) {
                              // The legacy reference-holder branch never publishes a store.
                              // A positive prewrite holding refuses; absent source coverage is
                              // recorded below rather than inferred from an empty loan list.
                              let held = run sourceReferenceHeld(&mut builder.*, candidate.holder)
                              let holds: [SourceAtom; 2] = [decision.eligible, held.present]
                              let refused: [SourceAtom; 2] = [effects.refusal, run SourcePolicy.conjunction(&mut builder.rules, &holds, none)]
                              effects.refusal = run SourcePolicy.disjunction(&mut builder.rules, &refused)
                              let unknown: [SourceAtom; 2] = [decision.eligible, held.missing]
                              run List<SourceAtom>.append(&mut gaps, run SourcePolicy.conjunction(&mut builder.rules, &unknown, none))
                            } else {
                              if run sourceWriteMatches(&builder.*, candidate, field, &mut paths.*) {
                                run List<SourceAtom>.append(&mut kept, decision.eligible)
                              } else if !run sourceWriteCovered(&builder.*, candidate, field, &mut paths.*) {
                                run List<SourceAtom>.append(&mut gaps, decision.eligible)
                              }
                            }
                            which = which + usize.ONE
                          }
                        }
                      }
                    }
                    target = target + usize.ONE
                  }
                }
                each = each + usize.ONE
              }
            }
            position = position + usize.ONE
          }
          let unmatched: [SourceAtom; 1] = [present]
          let missing = SourceProgram.atom(&mut builder.rules)
          run SourceProgram.rule(&mut builder.rules, missing, &unmatched, List<SourceAtom>.asSlice(&matched))
          run List<SourceAtom>.append(&mut gaps, missing)
        }
        let accepted = run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&kept))
        // Store indirection changes directness only. It does not make an Exact loan Stored.
        run SourceGraph.Builder.bindPolicy(&mut builder.*, port.id, accepted, port.quality.stored, port.quality.alternatives)
        let missing: [SourceAtom; 2] = [effects.missing, run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&gaps))]
        effects.missing = run SourcePolicy.disjunction(&mut builder.rules, &missing)
        if !listsIndex(List<usize>.asSlice(&used), candidate.holder) { run List<usize>.append(&mut used, candidate.holder) }
      }
    }
    policy = policy + usize.ONE
  }
  let actual = List<usize>.asSlice(&used)
  let mut at = usize.ZERO
  while at < actual.length {
    run sourceUseWriteHolder(&mut builder.*, actual[at], &mut state.*, loans, &mut paths.*, &mut holders.*, &mut effects)
    at = at + usize.ONE
  }
  // The committed address inventory is positive evidence, not complete source-case demand.
  // An empty candidate family cannot discharge a nonempty selector request.
  at = usize.ZERO
  while at < SourceGraph.Builder.retainedRequests(&builder.*).length {
    let requests = SourceGraph.Builder.retainedRequests(&builder.*)
    let status = SourceGraph.Builder.retainedStatus(&builder.*)[at]
    if requests[at].operation == operation {
      let active = requests[at].active
      let unresolved = if status.empty { status.missing } else { active }
      let gaps: [SourceAtom; 2] = [effects.missing, unresolved]
      effects.missing = run SourcePolicy.disjunction(&mut builder.rules, &gaps)
    }
    at = at + usize.ONE
  }
  return move effects
}

// This lookup reads the sole emitted reaching relation. A missing pair is not a proof of
// absence, and allocation order says nothing about whether a definition supplied a read.
fn sourceFlowPair(control: &SourceControl.Reaching, definition: SourceControl.DefinitionId,
  read: SourceControl.ReadId) -> Option<SourceAtom> {
  let pairs = List<SourceControl.Pair>.asSlice(&control.pairs)
  let mut selected = Option<SourceAtom>.none()
  let mut at = usize.ZERO
  while at < pairs.length {
    if pairs[at].definition.index == definition.index && pairs[at].read.index == read.index {
      if let Option<SourceAtom>.Some {..} = selected {
        return CompilerBug.panic(b"caller source has duplicate structural definition/read pairs")
      }
      selected = Option<SourceAtom>.some(pairs[at].active)
    }
    at = at + usize.ONE
  }
  return selected
}

// A copied operand retains the original read identity. Attribute that original consumer,
// never the copied value's placement or a same-point endpoint. A/B below are exact canonical
// components under the same owner/acquisition; ancestor summaries need separate authority.
effect fn sourceReadExclusion<'body>(builder: &mut SourceGraph.Builder<'body>, source: SourceEffectSource,
  active: SourceAtom, paths: &mut List<List<Step>>) -> SourceReadExclusion ! OutOfMemoryError ? &mut Allocator {
  let no = SourceProgram.atom(&mut builder.rules)
  let evidence = run sourceCallerEvidence(&mut builder.*, source, active)
  let definition = match source.definition {
    Option<SourceControl.DefinitionId>.Some {value} => value
    _ => {
      // A genuine unpaired creation has no prior held/read path to exclude. Its source
      // identity is still authenticated above; absent IDs alone do not prove a fresh loan.
      return SourceReadExclusion {excluded: no, missing: evidence.missing}
    }
  }
  let read = match source.read {
    Option<SourceControl.ReadId>.Some {value} => value
    _ => { return SourceReadExclusion {excluded: no, missing: active} }
  }
  if definition.index >= SourceGraph.Builder.definitionCount(&builder.*)
    || read.index >= SourceGraph.Builder.readCount(&builder.*) {
    return SourceReadExclusion {excluded: no, missing: active}
  }
  let original = SourceGraph.Builder.definition(&builder.*, definition)
  let requested = SourceGraph.Builder.read(&builder.*, read)
  let pair = match sourceFlowPair(&builder.reaching, definition, read) {
    Option<SourceAtom>.Some {value} => value
    _ => { return SourceReadExclusion {excluded: no, missing: active} }
  }
  let placements = run SourceGraph.Builder.readPlacementsByRead(&builder.*, read)
  let actual = List<SourceGraph.ReadPlacement>.asSlice(&placements)
  let empty = List<SourceAtom>.make()
  let none = List<SourceAtom>.asSlice(&empty)
  let mut covered = List<SourceAtom>.make()
  let mut excluded = List<SourceAtom>.make()
  let mut overlaps = List<SourceAtom>.make()
  let mut at = usize.ZERO
  while at < actual.length {
    let placement = actual[at]
    let consumer = SourceGraph.Builder.value(&builder.*, placement.consumer)
    if placement.read.index != read.index || consumer.phase != SourceGraph.ValuePhase.Input
      || consumer.evaluation.index != placement.result.index
      || SourceGraph.Builder.evaluation(&builder.*, consumer.evaluation).point.index != requested.point.index {
      return CompilerBug.panic(b"copied read attribution substituted its original consumer")
    }
    let mut held = usize.MAX
    let mut used = usize.MAX
    {
      let prepared = SourceGraph.Builder.preparation(&builder.*)
      let endpoints = List<PreparedSources.Endpoint>.asSlice(&prepared.endpoints)
      let maps = List<PreparedSources.SelectionMap>.asSlice(&prepared.maps)
      if placement.map.index >= maps.length || maps[placement.map.index].kind != PreparedSources.MapKind.Copy
        || maps[placement.map.index].target.index != consumer.endpoint.index {
        return CompilerBug.panic(b"copied read attribution lost its actual final Copy")
      }
      if let Option<SourceGraph.Storage>.Some {value: from} = sourceStorageRoot(endpoints, original.storage) {
        if let Option<SourceGraph.Storage>.Some {value: to} = sourceStorageRoot(endpoints, placement.storage) {
          if sourceSameStorage(from, to) && sourcePlacementStorage(original, requested,
            SourceGraph.Builder.read(&builder.*, placement.original), placement, endpoints) {
            held = run sourceField(endpoints, from.endpoint, original.storage.endpoint, &mut paths.*)
            used = run sourceField(endpoints, to.endpoint, placement.storage.endpoint, &mut paths.*)
          }
        }
      }
    }
    if held != usize.MAX && used != usize.MAX {
      let disjoint = excludedTransferPaths(List<Step>.asSlice(&List<List<Step>>.asSlice(&paths.*)[held]),
        List<Step>.asSlice(&List<List<Step>>.asSlice(&paths.*)[used]))
      let inputs = run SourceGraph.Builder.inputs(&mut builder.*, placement.consumer)
      let inputs = List<SourceGraph.Input>.asSlice(&inputs)
      let mut input = usize.ZERO
      while input < inputs.length {
        if inputs[input].leaf.index == source.leaf.index {
          let histories = List<SourceGraph.InputCase>.asSlice(&inputs[input].cases)
          let mut history = usize.ZERO
          while history < histories.length {
            if sourceDefinitionMatches(histories[history].definition, source.definition)
              && sourceReadMatches(histories[history].read, source.read) {
              let authentic: [SourceAtom; 4] = [evidence.present, pair, placement.active, histories[history].quality.present]
              let present = run SourcePolicy.conjunction(&mut builder.rules, &authentic, none)
              run List<SourceAtom>.append(&mut covered, present)
              if disjoint { run List<SourceAtom>.append(&mut excluded, present) }
              else { run List<SourceAtom>.append(&mut overlaps, present) }
            }
            history = history + usize.ONE
          }
        }
        input = input + usize.ONE
      }
    }
    at = at + usize.ONE
  }
  let sourcePresent: [SourceAtom; 1] = [evidence.present]
  let uncovered = run SourcePolicy.conjunction(&mut builder.rules, &sourcePresent, List<SourceAtom>.asSlice(&covered))
  let gaps: [SourceAtom; 2] = [evidence.missing, uncovered]
  let missing = run SourcePolicy.disjunction(&mut builder.rules, &gaps)
  let candidates = run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&excluded))
  let possibleOverlap = run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&overlaps))
  let positive: [SourceAtom; 1] = [candidates]
  let negative: [SourceAtom; 2] = [missing, possibleOverlap]
  return SourceReadExclusion {excluded: run SourcePolicy.conjunction(&mut builder.rules, &positive, &negative), missing: missing}
}

// Summary A and selected B share their canonical owner, but occupy different Flow
// components. The original read ID authenticates B; the summary ID authenticates A.
fn sourcePlacementStorage(definition: SourceGraph.DefinitionView, read: SourceGraph.ReadView,
  original: SourceGraph.ReadView, placement: SourceGraph.ReadPlacement,
  endpoints: &[PreparedSources.Endpoint]) -> bool {
  if !sourceSameReadLane(definition, read) || placement.read.index != read.id.index
    || placement.original.index != original.id.index || !sourceSameSummary(placement.summary, read.summary)
    || !sourceSameStorage(original.storage, placement.storage) { return false }
  if let Option<usize>.Some {..} = original.summary { return false }
  if let Option<usize>.None = read.summary {
    return original.id.index == read.id.index && sourceSameStorage(definition.storage, placement.storage)
  }
  if let Option<SourceGraph.Storage>.Some {value: held} = sourceStorageRoot(endpoints, definition.storage) {
    if let Option<SourceGraph.Storage>.Some {value: used} = sourceStorageRoot(endpoints, placement.storage) {
      return sourceSameStorage(held, used)
    }
  }
  return false
}

struct SourceReadField { supported: bool, field: usize }

// Attribute original held A through the selected B and then the final Copy once. A
// narrower read of an ancestor summary remains present with unknown result placement.
effect fn sourceReadField(endpoints: &[PreparedSources.Endpoint], summaries: &[SourceGraph.SummaryStorage],
  definition: SourceGraph.DefinitionView, placement: SourceGraph.ReadPlacement, root: PreparedSources.EndpointId,
  target: PreparedSources.EndpointId, paths: &mut List<List<Step>>) -> SourceReadField
! OutOfMemoryError ? &mut Allocator {
  let output = run sourceField(endpoints, root, target, &mut paths.*)
  if output == usize.MAX { return SourceReadField {supported: false, field: usize.MAX} }
  let summary = match definition.summary {
    Option<usize>.Some {value} => value
    _ => { return SourceReadField {supported: true, field: output} }
  }
  if summary >= summaries.length || !sourceSameStorage(summaries[summary].prefix, definition.storage) {
    return CompilerBug.panic(b"read summary changed its original held prefix")
  }
  if summaries[summary].unknown { return SourceReadField {supported: true, field: usize.MAX} }
  let owner = match sourceStorageRoot(endpoints, definition.storage) {
    Option<SourceGraph.Storage>.Some {value} => value
    _ => { return SourceReadField {supported: false, field: usize.MAX} }
  }
  let held = run sourceField(endpoints, owner.endpoint, definition.storage.endpoint, &mut paths.*)
  let used = run sourceField(endpoints, owner.endpoint, placement.storage.endpoint, &mut paths.*)
  if held == usize.MAX || used == usize.MAX { return SourceReadField {supported: false, field: usize.MAX} }
  let all = List<List<Step>>.asSlice(&paths.*)
  let a = List<Step>.asSlice(&all[held])
  let b = List<Step>.asSlice(&all[used])
  if !readContains(b, a) {
    return SourceReadField {supported: !excludedTransferPaths(a, b), field: usize.MAX}
  }
  let mut placed = run copySteps(List<Step>.asSlice(&all[output]))
  let mut at = b.length
  while at < a.length { run List<Step>.append(&mut placed, a[at]) at = at + usize.ONE }
  let field = List<List<Step>>.length(&paths.*)
  run List<List<Step>>.append(&mut paths.*, move placed)
  return SourceReadField {supported: true, field: field}
}

fn sourceSameStorage(left: SourceGraph.Storage, right: SourceGraph.Storage) -> bool {
  if left.endpoint.index != right.endpoint.index { return false }
  return match left.temporary {
    Option<SourceGraph.EvalId>.Some {value} => match right.temporary {
      Option<SourceGraph.EvalId>.Some {value: other} => value.index == other.index
      _ => false
    }
    _ => match right.temporary { Option<SourceGraph.EvalId>.None => true _ => false }
  }
}

// Canonical whole-owner ancestry stops at every address/channel boundary. Keeping a holder
// through a field use does not turn a returned reference's provenance into its storage owner.
fn sourceStorageRoot(endpoints: &[PreparedSources.Endpoint], storage: SourceGraph.Storage) -> Option<SourceGraph.Storage> {
  let mut current = storage.endpoint
  let mut remaining = endpoints.length
  while current.index < endpoints.length && remaining > usize.ZERO {
    let endpoint = &endpoints[current.index]
    match endpoint.parent {
      Option<PreparedSources.EndpointId>.Some {value} => {
        match &endpoint.selector {
          PreparedSources.Selector.Field {..} | PreparedSources.Selector.Member {..}
            | PreparedSources.Selector.Variant {..} | PreparedSources.Selector.Index {..} => { current = value }
          _ => { return Option<SourceGraph.Storage>.none() }
        }
      }
      _ => {
        let valid = match &endpoint.root {
          PreparedSources.Root.Local {role, ..} => role == PreparedSources.EndpointRole.Storage
            && match storage.temporary { Option<SourceGraph.EvalId>.None => true _ => false }
          PreparedSources.Root.Node {role, ..} => role == PreparedSources.EndpointRole.Storage
            && match storage.temporary { Option<SourceGraph.EvalId>.Some {..} => true _ => false }
          _ => false
        }
        if valid { return Option<SourceGraph.Storage>.some(SourceGraph.Storage {endpoint: current, temporary: storage.temporary}) }
        return Option<SourceGraph.Storage>.none()
      }
    }
    remaining = remaining - usize.ONE
  }
  return Option<SourceGraph.Storage>.none()
}

fn sourceOwnerStorage<'body>(builder: &SourceGraph.Builder<'body>, owner: &SourceVisit.Owner,
  storage: SourceGraph.Storage) -> bool {
  let endpoints = List<PreparedSources.Endpoint>.asSlice(&SourceGraph.Builder.preparation(builder).endpoints)
  let endpoint = &endpoints[storage.endpoint.index]
  return match owner.root {
    SourceVisit.OwnerRoot.Local {local} => match &endpoint.root {
      PreparedSources.Root.Local {local: actual, role} => actual.index == local.index && role == PreparedSources.EndpointRole.Storage
        && match storage.temporary { Option<SourceGraph.EvalId>.None => true _ => false }
      _ => false
    }
    SourceVisit.OwnerRoot.Temporary {evaluation} | SourceVisit.OwnerRoot.Subject {evaluation, ..} => {
      let same = match storage.temporary { Option<SourceGraph.EvalId>.Some {value} => value.index == evaluation.index _ => false }
      if !same { return false }
      let actual = SourceGraph.Builder.evaluation(builder, evaluation)
      return match actual.site {
        SourceGraph.EvaluationSite.Node {node} => match &endpoint.root {
          PreparedSources.Root.Node {node: stored, role} => stored.index == node.index && role == PreparedSources.EndpointRole.Storage
          _ => false
        }
        _ => false
      }
    }
  }
}

// Retain requests even when no canonical address exists. Whole-holder demand is independent
// of which loans the selected output carries, including a LoanFree selected field. Exact alias
// nodes license address-only uses; existing reads license only their actual Copy placement.
effect fn sourceHolderProjection<'body>(builder: &mut SourceGraph.Builder<'body>, owners: &[SourceVisit.Owner],
  storage: &SourceStorageProjection, requests: List<SourceHolderRequest>) -> SourceHolderProjection
! OutOfMemoryError ? &mut Allocator {
  let mut result = SourceHolderProjection {requests: move requests, uses: List<SourceHolderUse>.make(), missing: SourceProgram.atom(&mut builder.rules)}
  let all = List<SourceHolderRequest>.asSlice(&result.requests)
  let definitions = List<SourceStorageDefinition>.asSlice(&storage.definitions)
  let reads = List<SourceGraph.ReadView>.asSlice(&storage.reads)
  let empty = List<SourceAtom>.make()
  let none = List<SourceAtom>.asSlice(&empty)
  let mut gaps = List<SourceAtom>.make()
  let mut at = usize.ZERO
  while at < all.length {
    let request = all[at]
    let reachable = List<SourceControl.Point>.asSlice(&builder.reaching.points)[request.point.index].reachable
    let guards: [SourceAtom; 2] = [request.active, reachable]
    let active = run SourcePolicy.conjunction(&mut builder.rules, &guards, none)
    let mut covered = List<SourceAtom>.make()
    if let Option<SourceVisit.OwnerId>.Some {value: owner} = request.owner {
      if owner.index >= owners.length { CompilerBug.panic(b"whole-holder use lost its actual owner") }
      let mut each = usize.ZERO
      while each < definitions.length {
        if let Option<SourceGraph.Storage>.Some {value: root} = sourceStorageRoot(
          List<PreparedSources.Endpoint>.asSlice(&SourceGraph.Builder.preparation(&builder.*).endpoints), definitions[each].definition.storage) {
          if sourceOwnerStorage(&builder.*, &owners[owner.index], root) {
            run List<SourceHolderUse>.append(&mut result.uses, SourceHolderUse {request: at, storage: root, active: active})
            run List<SourceAtom>.append(&mut covered, active)
          }
        }
        each = each + usize.ONE
      }
    } else {
      let mut alias = usize.ZERO
      while alias < SourceGraph.Builder.aliases(&builder.*).length {
        let aliases = SourceGraph.Builder.aliases(&builder.*)
        if aliases[alias].evaluation.index == request.evaluation.index && aliases[alias].endpoint.index == request.root.index {
          if let Option<SourceGraph.Storage>.Some {value: root} = sourceStorageRoot(
            List<PreparedSources.Endpoint>.asSlice(&SourceGraph.Builder.preparation(&builder.*).endpoints), aliases[alias].storage) {
            let guards: [SourceAtom; 2] = [active, aliases[alias].active]
            let present = run SourcePolicy.conjunction(&mut builder.rules, &guards, none)
            run List<SourceHolderUse>.append(&mut result.uses, SourceHolderUse {request: at, storage: root, active: present})
            // Positive address proofs supply uses, but this inventory does not certify that
            // every possible address history has been enumerated. Read/owner coverage below
            // remains necessary until the graph exposes the demand's completeness evidence.
          }
        }
        alias = alias + usize.ONE
      }
      let components = run sourceComponents(SourceGraph.Builder.preparation(&builder.*), request.root)
      let parts = List<PreparedSources.EndpointId>.asSlice(&components)
      let mut readCoverage = List<SourceAtom>.make()
      let mut component = usize.ZERO
      while component < parts.length {
        let mut componentCoverage = List<SourceAtom>.make()
        let mut value = usize.ZERO
        while value < SourceGraph.Builder.values(&builder.*).length {
          let actual = SourceGraph.Builder.value(&builder.*, SourceGraph.ValueId {index: value})
          let physical = sourcePhysicalValue(actual)
          if physical && actual.endpoint.index == parts[component].index && actual.phase == SourceGraph.ValuePhase.Input && actual.evaluation.index == request.evaluation.index {
            let mut read = usize.ZERO
            while read < reads.length {
              if reads[read].point.index == SourceGraph.Builder.evaluation(&builder.*, request.evaluation).point.index {
                let placements = run SourceGraph.Builder.readPlacements(&builder.*, SourceGraph.ValueId {index: value}, reads[read].id)
                let candidates = List<SourceGraph.ReadPlacement>.asSlice(&placements)
                let mut each = usize.ZERO
                while each < candidates.length {
                  if let Option<SourceGraph.Storage>.Some {value: root} = sourceStorageRoot(
                    List<PreparedSources.Endpoint>.asSlice(&SourceGraph.Builder.preparation(&builder.*).endpoints), candidates[each].storage) {
                    let guards: [SourceAtom; 2] = [active, candidates[each].active]
                    let present = run SourcePolicy.conjunction(&mut builder.rules, &guards, none)
                    run List<SourceHolderUse>.append(&mut result.uses, SourceHolderUse {request: at, storage: root, active: present})
                    run List<SourceAtom>.append(&mut componentCoverage, present)
                  }
                  each = each + usize.ONE
                }
              }
              read = read + usize.ONE
            }
          }
          value = value + usize.ONE
        }
        run List<SourceAtom>.append(&mut readCoverage,
          run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&componentCoverage)))
        component = component + usize.ONE
      }
      if parts.length > usize.ZERO {
        run List<SourceAtom>.append(&mut covered,
          run SourcePolicy.conjunction(&mut builder.rules, List<SourceAtom>.asSlice(&readCoverage), none))
      }
    }
    let present = run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&covered))
    let included: [SourceAtom; 1] = [active]
    let excluded: [SourceAtom; 1] = [present]
    run List<SourceAtom>.append(&mut gaps, run SourcePolicy.conjunction(&mut builder.rules, &included, &excluded))
    at = at + usize.ONE
  }
  result.missing = run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&gaps))
  return move result
}

// Capture symbolic source membership only after structural reservation has closed. This
// does not emit a definition, choose a reaching predecessor, or turn a Borrow leaf into a
// storage owner. Availability later uses this record's real ID with Graph.control().
effect fn sourceStorageProjection<'body>(builder: &mut SourceGraph.Builder<'body>) -> SourceStorageProjection
! OutOfMemoryError ? &mut Allocator {
  let mut definitions = List<SourceStorageDefinition>.make()
  let mut reads = List<SourceGraph.ReadView>.make()
  let empty = List<SourceAtom>.make()
  let none = List<SourceAtom>.asSlice(&empty)
  let mut at = usize.ZERO
  while at < SourceGraph.Builder.definitionCount(&builder.*) {
    let definition = SourceGraph.Builder.definition(&builder.*, SourceControl.DefinitionId {index: at})
    if definition.id.index != at { CompilerBug.panic(b"ownership definition projection changed a real Flow identity") }
    let inputs = run SourceGraph.Builder.inputs(&mut builder.*, definition.value)
    let reachable = List<SourceControl.Point>.asSlice(&builder.reaching.points)[definition.point.index].reachable
    let guards: [SourceAtom; 2] = [definition.active, reachable]
    let active = run SourcePolicy.conjunction(&mut builder.rules, &guards, none)
    let sources = List<SourceGraph.Input>.asSlice(&inputs)
    let mut present = List<SourceAtom>.make()
    let mut unknown = List<SourceAtom>.make()
    let mut gaps = List<SourceAtom>.make()
    let mut loans = List<SourceStoredLoan>.make()
    let mut each = usize.ZERO
    while each < sources.length {
      if sources[each].value.index != definition.value.index {
        CompilerBug.panic(b"ownership definition projection substituted another written value")
      }
      run List<SourceAtom>.append(&mut present, sources[each].quality.present)
      let kind = &SourceGraph.Builder.leaf(&builder.*, sources[each].leaf).kind
      if let SourceGraph.SourceLeaf.Borrow {loan, ..} = &kind.* {
        let observed: [SourceAtom; 2] = [active, sources[each].quality.present]
        run List<SourceStoredLoan>.append(&mut loans, SourceStoredLoan {leaf: sources[each].leaf,
          loan: loan, active: run SourcePolicy.conjunction(&mut builder.rules, &observed, none)})
      }
      if let SourceGraph.SourceLeaf.Unknown {..} = &kind.* {
        let observed: [SourceAtom; 2] = [active, sources[each].quality.present]
        run List<SourceAtom>.append(&mut unknown, run SourcePolicy.conjunction(&mut builder.rules, &observed, none))
      }
      if List<SourceGraph.InputCase>.length(&sources[each].cases) == usize.ZERO {
        let unsupported: [SourceAtom; 2] = [active, sources[each].quality.present]
        run List<SourceAtom>.append(&mut gaps, run SourcePolicy.conjunction(&mut builder.rules, &unsupported, none))
      }
      each = each + usize.ONE
    }
    let covered = run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&present))
    let applies: [SourceAtom; 1] = [active]
    let absent: [SourceAtom; 1] = [covered]
    // A retained clear is an empty definition in its own summary lane. The original
    // covering write supplies applicability; absence here means no summary contents.
    // It is neither an Unknown value nor a manufactured LoanFree leaf.
    match definition.clears {
      Option<SourceControl.DefinitionId>.Some {value: original} => {
        if let Option<usize>.None = definition.summary {
          return CompilerBug.panic(b"physical storage definition acquired a summary clear")
        }
        let clearing = SourceGraph.Builder.definition(&builder.*, original)
        if sources.length != usize.ZERO || clearing.point.index != definition.point.index {
          return CompilerBug.panic(b"summary clear acquired contents or another execution point")
        }
      }
      _ => run List<SourceAtom>.append(&mut gaps, run SourcePolicy.conjunction(&mut builder.rules, &applies, &absent))
    }
    run List<SourceStorageDefinition>.append(&mut definitions, SourceStorageDefinition {
      definition: definition, inputs: move inputs, loans: move loans,
      unknown: run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&unknown)),
      missing: run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&gaps))})
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < SourceGraph.Builder.readCount(&builder.*) {
    let read = SourceGraph.Builder.read(&builder.*, SourceControl.ReadId {index: at})
    if read.id.index != at { CompilerBug.panic(b"ownership read projection changed a real Flow identity") }
    run List<SourceGraph.ReadView>.append(&mut reads, read)
    at = at + usize.ONE
  }
  // Uninitialized End/Move definitions are deliberately retained. Their Unknown source is
  // relevant when observed, not a global failure merely because dead storage has ended.
  return SourceStorageProjection {definitions: move definitions, reads: move reads}
}

// Authenticate the exact history retained by the operation, not the contents of its holder
// at a later event. The graph already includes every intervening copy and source decision.
effect fn sourceCallerEvidence<'body>(builder: &mut SourceGraph.Builder<'body>, source: SourceEffectSource,
  active: SourceAtom) -> SourceCallerEvidence ! OutOfMemoryError ? &mut Allocator {
  let no = SourceProgram.atom(&mut builder.rules)
  let unavailable = SourceCallerEvidence {present: no, missing: active}
  if source.value.index >= SourceGraph.Builder.values(&builder.*).length { return unavailable }
  let borrowed = match &SourceGraph.Builder.leaf(&builder.*, source.leaf).kind {
    SourceGraph.SourceLeaf.Borrow {loan, ..} => loan == source.loan
    _ => false
  }
  if !borrowed { return unavailable }
  let mut paired = run sourceBoolean(&mut builder.rules, true)
  match source.definition {
    Option<SourceControl.DefinitionId>.Some {value: definition} => {
      let read = match source.read {
        Option<SourceControl.ReadId>.Some {value} => value
        _ => { return unavailable }
      }
      if definition.index >= SourceGraph.Builder.definitionCount(&builder.*)
        || read.index >= SourceGraph.Builder.readCount(&builder.*) { return unavailable }
      let written = SourceGraph.Builder.definition(&builder.*, definition)
      let observed = SourceGraph.Builder.read(&builder.*, read)
      if !sourceSameReadLane(written, observed) { return unavailable }
      paired = match sourceFlowPair(&builder.reaching, definition, read) {
        Option<SourceAtom>.Some {value} => value
        _ => { return unavailable }
      }
    }
    _ => {
      if let Option<SourceControl.ReadId>.Some {..} = source.read { return unavailable }
      // An unpaired case is accepted only below, from the real Borrow leaf at the actual
      // value. The two absent IDs themselves are never a fresh-loan witness.
    }
  }
  let inputs = run SourceGraph.Builder.inputs(&mut builder.*, source.value)
  let all = List<SourceGraph.Input>.asSlice(&inputs)
  let empty = List<SourceAtom>.make()
  let none = List<SourceAtom>.asSlice(&empty)
  let mut found = false
  let mut candidates = List<SourceAtom>.make()
  let mut at = usize.ZERO
  while at < all.length {
    if all[at].value.index == source.value.index && all[at].leaf.index == source.leaf.index {
      let cases = List<SourceGraph.InputCase>.asSlice(&all[at].cases)
      let mut each = usize.ZERO
      while each < cases.length {
        if sourceDefinitionMatches(cases[each].definition, source.definition)
          && sourceReadMatches(cases[each].read, source.read) {
          let guards: [SourceAtom; 3] = [active, paired, cases[each].quality.present]
          run List<SourceAtom>.append(&mut candidates, run SourcePolicy.conjunction(&mut builder.rules, &guards, none))
          found = true
        }
        each = each + usize.ONE
      }
    }
    at = at + usize.ONE
  }
  if !found { return unavailable }
  return SourceCallerEvidence {present: run SourcePolicy.disjunction(&mut builder.rules,
    List<SourceAtom>.asSlice(&candidates)), missing: no}
}

// Freeze interval authentication before the sole solve. In particular, a copied carrier's
// interval belongs to its original paired read, not whichever definition occupies its owner
// at the consumer. Fresh acquisitions must still have an actual unpaired Borrow source case.
effect fn sourceIntervalProjection<'body>(builder: &mut SourceGraph.Builder<'body>,
  intervals: &[SourceIntervalEffect]) -> List<SourceIntervalProjection>
! OutOfMemoryError ? &mut Allocator {
  let mut projected = List<SourceIntervalProjection>.make()
  let count = List<SourceControl.Point>.length(&builder.reaching.points)
  let mut at = usize.ZERO
  while at < intervals.length {
    let interval = &intervals[at]
    let mut evidence = SourceCallerEvidence {present: SourceProgram.atom(&mut builder.rules), missing: interval.active}
    if interval.from < count && interval.to < count {
      evidence = run sourceCallerEvidence(&mut builder.*, interval.source, interval.active)
    }
    run List<SourceIntervalProjection>.append(&mut projected, SourceIntervalProjection {
      source: interval.source, from: interval.from, to: interval.to, cleanup: interval.cleanup, evidence: evidence})
    at = at + usize.ONE
  }
  return move projected
}

fn sourceTruthAnd(left: SourceTruth, right: SourceTruth) -> SourceTruth {
  if left == SourceTruth.False || right == SourceTruth.False { return SourceTruth.False }
  if left == SourceTruth.True && right == SourceTruth.True { return SourceTruth.True }
  return SourceTruth.Undefined
}

fn sourceStoredMembership<'body>(graph: &SourceGraph.Graph<'body>, definition: &SourceStorageDefinition,
  loan: usize) -> SourceTruth {
  let members = List<SourceStoredLoan>.asSlice(&definition.loans)
  let mut found = SourceTruth.False
  let mut at = usize.ZERO
  while at < members.length {
    if members[at].loan == loan {
      let active = SourceGraph.Graph.truth(graph, members[at].active)
      if active == SourceTruth.True { return SourceTruth.True }
      if active == SourceTruth.Undefined { found = SourceTruth.Undefined }
    }
    at = at + usize.ONE
  }
  return found
}

fn sourceIncludeDefinition(words: &mut List<u64>, width: usize, point: usize,
  definition: SourceControl.DefinitionId) -> () {
  let mut all = List<u64>.asMutSlice(&words.*)
  let slot = point * width + wordOf(definition.index)
  all[slot] = u64.bitOr(all[slot], maskOf(definition.index))
}

// Project the solved control relation; this deliberately has no transfer or fixed-point loop.
// Unknown membership remains a possible carrier and prevents a final ownership proof. A
// LoanFree/Unknown tombstone does not become an invented definition for any particular loan.
effect fn sourceLoanOccupancy<'body>(graph: &SourceGraph.Graph<'body>, storage: &SourceStorageProjection,
  loan: usize) -> SourceLoanOccupancy ! OutOfMemoryError ? &mut Allocator {
  let control = SourceGraph.Graph.control(graph)
  let points = List<SourceControl.Point>.asSlice(&control.points)
  let definitions = List<SourceStorageDefinition>.asSlice(&storage.definitions)
  if definitions.length != SourceGraph.Graph.definitionCount(graph) {
    return CompilerBug.panic(b"ownership occupancy lost actual Flow definitions")
  }
  let width = (definitions.length + 63) / 64
  let mut result = SourceLoanOccupancy {loan: loan, width: width, entering: List<u64>.make(),
    leaving: List<u64>.make(), unresolved: false}
  let mut at = usize.ZERO
  while at < points.length * width {
    run List<u64>.append(&mut result.entering, 0)
    run List<u64>.append(&mut result.leaving, 0)
    at = at + usize.ONE
  }
  let mut each = usize.ZERO
  while each < definitions.length {
    let definition = definitions[each].definition
    let actual = SourceGraph.Graph.definition(graph, definition.id)
    if definition.id.index != each || actual.point.index != definition.point.index
      || actual.value.index != definition.value.index || !sourceSameStorage(actual.storage, definition.storage)
      || !sourceSameSummary(actual.summary, definition.summary)
      || !sourceDefinitionMatches(actual.clears, definition.clears) {
      return CompilerBug.panic(b"ownership occupancy substituted a real definition identity")
    }
    let membership = sourceStoredMembership(graph, &definitions[each], loan)
    at = usize.ZERO
    while at < points.length {
      let point = SourceControl.PointId {index: at}
      let entering = sourceTruthAnd(membership, SourceGraph.Graph.truth(graph,
        SourceControl.Reaching.enters(control, point, definition.id)))
      let leaving = sourceTruthAnd(membership, SourceGraph.Graph.truth(graph,
        SourceControl.Reaching.leaves(control, point, definition.id)))
      if entering != SourceTruth.False { sourceIncludeDefinition(&mut result.entering, width, at, definition.id) }
      if leaving != SourceTruth.False { sourceIncludeDefinition(&mut result.leaving, width, at, definition.id) }
      if entering == SourceTruth.Undefined || leaving == SourceTruth.Undefined { result.unresolved = true }
      if (entering != SourceTruth.False || leaving != SourceTruth.False)
        && SourceGraph.Graph.truth(graph, definitions[each].missing) != SourceTruth.False { result.unresolved = true }
      at = at + usize.ONE
    }
    each = each + usize.ONE
  }
  return move result
}

// Materialize adjacency for the existing ownership solvers from the one source CFG. The
// event projection supplies diagnostics separately; no synthetic ownership points are added.
effect fn sourceControlProjection<'body>(graph: &SourceGraph.Graph<'body>, entry: SourceControl.PointId)
  -> SourceControlProjection ! OutOfMemoryError ? &mut Allocator {
  let control = SourceGraph.Graph.control(graph)
  let actual = List<SourceControl.Point>.asSlice(&control.points)
  if entry.index >= actual.length { return CompilerBug.panic(b"ownership projection lost the actual CFG entry") }
  let mut result = SourceControlProjection {entry: entry.index, points: List<Point>.make(), unresolved: false}
  let mut at = usize.ZERO
  while at < actual.length {
    run List<Point>.append(&mut result.points, Point {next: List<usize>.make(), uses: usize.MAX,
      read: usize.MAX, written: usize.MAX, defines: usize.MAX, initializes: usize.MAX, event: usize.MAX,
      span: Location.make(usize.ZERO, usize.ZERO)})
    at = at + usize.ONE
  }
  let edges = List<SourceControl.Edge>.asSlice(&control.edges)
  at = usize.ZERO
  while at < edges.length {
    let edge = edges[at]
    let active = sourceTruthAnd(SourceGraph.Graph.truth(graph, edge.active),
      SourceGraph.Graph.truth(graph, actual[edge.from.index].reachable))
    if active != SourceTruth.False {
      run List<usize>.append(&mut List<Point>.asMutSlice(&mut result.points)[edge.from.index].next, edge.to.index)
    }
    if active == SourceTruth.Undefined { result.unresolved = true }
    at = at + usize.ONE
  }
  return move result
}

// The existing move solver consumes actual loop backedges and owner acquisitions on the
// same CFG. Completion bounds the body's structural interval; its early-allocated exit
// cannot stand in for that boundary. Multiple owners at one point remain separate roots.
effect fn sourceMoveProjection<'body>(graph: &SourceGraph.Graph<'body>, control: &SourceControlProjection,
  owners: &[SourceVisit.Owner], loops: &[SourceVisit.Loop], runtime: &SourceRuntimeEvents) -> SourceMoveProjection
! OutOfMemoryError ? &mut Allocator {
  let points = List<Point>.asSlice(&control.points)
  let actualPoints = List<SourceControl.Point>.asSlice(&SourceGraph.Graph.control(graph).points)
  let prepared = SourceGraph.Graph.preparation(graph)
  let mut result = SourceMoveProjection {loops: List<Loop>.make(), initialized: List<MoveInitialization>.make(),
    moves: List<usize>.make(), reach: Reach {entering: List<u64>.make(), leaving: List<u64>.make()},
    width: usize.ZERO, unresolved: control.unresolved || runtime.unresolved}
  let mut at = usize.ZERO
  while at < owners.length {
    let point = owners[at].initialized.index
    if point >= points.length { return CompilerBug.panic(b"move initialization has no actual owner acquisition point") }
    let root = match owners[at].root {
      SourceVisit.OwnerRoot.Local {local} => local.index
      _ => prepared.body.locals.length + at
    }
    run List<MoveInitialization>.append(&mut result.initialized, MoveInitialization {point: point, root: root})
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < loops.length {
    let repeat = &loops[at]
    if repeat.before.index >= points.length || repeat.header.index >= points.length
      || repeat.completed.index >= points.length || repeat.completed.index < repeat.header.index {
      return CompilerBug.panic(b"ownership loop lost its actual completion interval")
    }
    let active = SourceGraph.Graph.truth(graph, actualPoints[repeat.header.index].reachable)
    if active != SourceTruth.False {
      if active == SourceTruth.Undefined { result.unresolved = true }
      let mut sources = List<usize>.make()
      let backedges = List<SourceControl.PointId>.asSlice(&repeat.backedges)
      let mut each = usize.ZERO
      while each < backedges.length {
        let point = backedges[each].index
        if point >= points.length { return CompilerBug.panic(b"ownership loop backedge has no actual point") }
        // The solved projection already removed impossible edges. A possible edge remains
        // conservative and makes the whole move result unresolved through control above.
        if listsIndex(List<usize>.asSlice(&points[point].next), repeat.header.index) {
          run List<usize>.append(&mut sources, point)
        }
        each = each + usize.ONE
      }
      run List<Loop>.append(&mut result.loops, Loop {before: repeat.before.index, header: repeat.header.index,
        sources: move sources, end: repeat.completed.index + usize.ONE, span: prepared.body.nodes[repeat.node.index].origin.location})
    }
    at = at + usize.ONE
  }
  let events = List<Event>.asSlice(&runtime.events)
  at = usize.ZERO
  while at < events.length {
    if events[at].kind == Kind.Move || events[at].kind == Kind.Drop { run List<usize>.append(&mut result.moves, at) }
    at = at + usize.ONE
  }
  result.width = (List<usize>.length(&result.moves) + 63) / 64
  if result.width != usize.ZERO {
    result.reach = run reaching(points, List<MoveInitialization>.asSlice(&result.initialized), events,
      List<Loop>.asSlice(&result.loops), List<usize>.asSlice(&result.moves), result.width)
  }
  return move result
}

// Field-sensitive needs use the original paired read. A copied value can remain in flight
// after its old owner is overwritten; that interval does not keep the old storage occupied.
// Whole-holder conflict uses are a separate canonical-owner demand, not output source facts.
effect fn sourceLivenessBounds<'body>(graph: &SourceGraph.Graph<'body>, storage: &SourceStorageProjection,
  occupancy: &SourceLoanOccupancy) -> List<u64> ! OutOfMemoryError ? &mut Allocator {
  let points = List<SourceControl.Point>.asSlice(&SourceGraph.Graph.control(graph).points)
  let definitions = List<SourceStorageDefinition>.asSlice(&storage.definitions)
  let width = occupancy.width
  let mut bound = List<u64>.make()
  let mut at = usize.ZERO
  while at < points.length * width { run List<u64>.append(&mut bound, 0) at = at + usize.ONE }
  at = usize.ZERO
  while at < points.length {
    let mut each = usize.ZERO
    while each < definitions.length {
      let definition = definitions[each].definition
      // Definite absence is a kill. An active strong redefinition also starts a new instance
      // of this static definition on a back edge, just as the existing bound table does.
      let rebound = definition.point.index == at && definition.write == SourceControl.Write.Strong
        && SourceGraph.Graph.truth(graph, definition.active) == SourceTruth.True
      if rebound || !reaches(List<u64>.asSlice(&occupancy.leaving), width, at, each) {
        sourceIncludeDefinition(&mut bound, width, at, definition.id)
      }
      each = each + usize.ONE
    }
    at = at + usize.ONE
  }
  return move bound
}

effect fn sourceLoanNeeds<'body>(graph: &SourceGraph.Graph<'body>, control: &SourceControlProjection,
  storage: &SourceStorageProjection, occupancy: &SourceLoanOccupancy, intervals: &[SourceIntervalProjection],
  views: &[SourceViewProjection], created: usize, flow: &mut IntervalFlow) -> SourceLoanNeeds ! OutOfMemoryError ? &mut Allocator {
  let points = List<Point>.asSlice(&control.points)
  let definitions = List<SourceStorageDefinition>.asSlice(&storage.definitions)
  let mut used = List<u64>.make()
  let mut required = List<u64>.make()
  let mut unresolved = control.unresolved || occupancy.unresolved
  let width = occupancy.width
  let mut at = usize.ZERO
  while at < points.length * width {
    run List<u64>.append(&mut used, 0)
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < (points.length + 63) / 64 { run List<u64>.append(&mut required, 0) at = at + usize.ONE }
  if created < points.length {
    let active = SourceGraph.Graph.truth(graph,
      List<SourceControl.Point>.asSlice(&SourceGraph.Graph.control(graph).points)[created].reachable)
    if active != SourceTruth.False { drop includeRegionPoint(&mut required, created) }
    if active == SourceTruth.Undefined { unresolved = true }
  } else { unresolved = true }
  let bound = run sourceLivenessBounds(graph, storage, occupancy)
  at = usize.ZERO
  while at < intervals.length {
    let interval = &intervals[at]
    if interval.source.loan == occupancy.loan {
      let present = SourceGraph.Graph.truth(graph, interval.evidence.present)
      if SourceGraph.Graph.truth(graph, interval.evidence.missing) != SourceTruth.False
        || present == SourceTruth.Undefined { unresolved = true }
      if present != SourceTruth.False {
        if interval.from >= points.length || interval.to >= points.length {
          unresolved = true
        } else {
          if let Option<SourceControl.DefinitionId>.Some {value: definition} = interval.source.definition {
            if let Option<SourceControl.ReadId>.Some {value: read} = interval.source.read {
              let actual = SourceGraph.Graph.read(graph, read)
              sourceIncludeDefinition(&mut used, width, actual.point.index, definition)
            } else { unresolved = true }
          }
          if interval.from <= interval.to {
            let endpoint = run intervalEndpoint(points, interval.to, &mut flow.*)
            let reached = List<List<u64>>.asSlice(&flow.reaching)
            let paths = List<u64>.asSlice(&reached[endpoint])
            let mut point = interval.from
            while point <= interval.to {
              if u64.bitAnd(paths[wordOf(point)], maskOf(point)) != 0 { drop includeRegionPoint(&mut required, point) }
              point = point + usize.ONE
            }
          }
        }
      }
    }
    at = at + usize.ONE
  }
  let liveOut = run solveLiveness(points, width, List<u64>.asSlice(&used), List<u64>.asSlice(&bound))
  // A borrowed view has no physical descriptor definition. Its actual binding/extent
  // requirements still constrain this loan before any release or region intersection.
  at = usize.ZERO
  while at < views.length {
    if views[at].loan == occupancy.loan {
      let demands = List<SourceAtom>.asSlice(&views[at].required)
      if demands.length != points.length { return CompilerBug.panic(b"view requirements belong to another CFG") }
      let mut point = usize.ZERO
      while point < points.length {
        let needed = SourceGraph.Graph.truth(graph, demands[point])
        if needed != SourceTruth.False { drop includeRegionPoint(&mut required, point) }
        if needed == SourceTruth.Undefined { unresolved = true }
        point = point + usize.ONE
      }
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < points.length {
    let mut each = usize.ZERO
    while each < definitions.length {
      if reaches(List<u64>.asSlice(&occupancy.entering), width, at, each)
        && reaches(List<u64>.asSlice(&occupancy.leaving), width, at, each)
        && reaches(List<u64>.asSlice(&liveOut), width, at, each) {
        drop includeRegionPoint(&mut required, at)
      }
      each = each + usize.ONE
    }
    at = at + usize.ONE
  }
  return SourceLoanNeeds {required: move required, liveOut: move liveOut, unresolved: unresolved}
}

// Whole-holder uses retain every reaching definition of that canonical owner for conflicts.
// They do not add source cases to the selected result or field-sensitive region requirements.
effect fn sourceHolderLiveness<'body>(graph: &SourceGraph.Graph<'body>, control: &SourceControlProjection,
  storage: &SourceStorageProjection, occupancy: &SourceLoanOccupancy, holders: &SourceHolderProjection)
  -> SourceHolderLiveness ! OutOfMemoryError ? &mut Allocator {
  let points = List<Point>.asSlice(&control.points)
  let definitions = List<SourceStorageDefinition>.asSlice(&storage.definitions)
  let requests = List<SourceHolderRequest>.asSlice(&holders.requests)
  let uses = List<SourceHolderUse>.asSlice(&holders.uses)
  let endpoints = List<PreparedSources.Endpoint>.asSlice(&SourceGraph.Graph.preparation(graph).endpoints)
  let mut unresolved = control.unresolved || occupancy.unresolved
    || SourceGraph.Graph.truth(graph, holders.missing) != SourceTruth.False
  let mut used = List<u64>.make()
  let mut at = usize.ZERO
  while at < points.length * occupancy.width { run List<u64>.append(&mut used, 0) at = at + usize.ONE }
  at = usize.ZERO
  while at < uses.length {
    let demand = uses[at]
    if demand.request >= requests.length { return CompilerBug.panic(b"holder liveness lost its actual use") }
    let point = requests[demand.request].point.index
    let active = SourceGraph.Graph.truth(graph, demand.active)
    if active == SourceTruth.Undefined { unresolved = true }
    if active != SourceTruth.False {
      let mut each = usize.ZERO
      while each < definitions.length {
        if let Option<SourceGraph.Storage>.Some {value: root} = sourceStorageRoot(endpoints, definitions[each].definition.storage) {
          if sourceSameStorage(root, demand.storage)
            && reaches(List<u64>.asSlice(&occupancy.entering), occupancy.width, point, each) {
            sourceIncludeDefinition(&mut used, occupancy.width, point, definitions[each].definition.id)
          }
        }
        each = each + usize.ONE
      }
    }
    at = at + usize.ONE
  }
  let bound = run sourceLivenessBounds(graph, storage, occupancy)
  return SourceHolderLiveness {liveOut: run solveLiveness(points, occupancy.width,
    List<u64>.asSlice(&used), List<u64>.asSlice(&bound)), unresolved: unresolved}
}

fn sourceLiveJoin(left: CallerSource, right: CallerSource) -> CallerSource {
  if left == CallerSource.Actual || right == CallerSource.Actual { return CallerSource.Actual }
  if left == CallerSource.Unknown || right == CallerSource.Unknown { return CallerSource.Unknown }
  return CallerSource.Absent
}

fn sourceLiveActivity(value: CallerSource, activity: SourceTruth) -> CallerSource {
  if activity == SourceTruth.False || value == CallerSource.Absent { return CallerSource.Absent }
  if activity == SourceTruth.Undefined { return CallerSource.Unknown }
  return value
}

// The bits still name real Flow definitions. Requiring both sides of the event preserves
// the old rebind exclusion: a future read of the replacement does not keep its old value.
// The existing liveness solver uses possible CFG edges, so its unresolved projection may
// contribute an unchecked obligation but cannot by itself ground a conflict.
fn sourceHeldAt(control: &SourceControlProjection, occupancy: &SourceLoanOccupancy, liveOut: &[u64],
  unresolved: bool, point: usize) -> CallerSource {
  let count = List<Point>.length(&control.points)
  if point >= count || liveOut.length != count * occupancy.width
    || List<u64>.length(&occupancy.entering) != liveOut.length
    || List<u64>.length(&occupancy.leaving) != liveOut.length {
    return CompilerBug.panic(b"holder conflict liveness belongs to another CFG or definition inventory")
  }
  let uncertain = unresolved || control.unresolved || occupancy.unresolved
  let mut word = usize.ZERO
  while word < occupancy.width {
    let slot = point * occupancy.width + word
    let carried = u64.bitAnd(List<u64>.asSlice(&occupancy.entering)[slot], List<u64>.asSlice(&occupancy.leaving)[slot])
    if u64.bitAnd(carried, liveOut[slot]) != 0 {
      if uncertain { return CallerSource.Unknown }
      return CallerSource.Actual
    }
    word = word + usize.ONE
  }
  if uncertain { return CallerSource.Unknown }
  return CallerSource.Absent
}

// Independent escape is the pre-caller snapshot. Aggregated Loan.escapes may constrain
// availability but is never substituted here for an operation reaching this particular access.
effect fn sourceIndependentAt(control: &SourceControlProjection, independent: CallerSource,
  loan: &Loan, point: usize, paths: &mut List<ReplacementReach>) -> CallerSource
! OutOfMemoryError ? &mut Allocator {
  if independent == CallerSource.Absent { return CallerSource.Absent }
  let points = List<Point>.asSlice(&control.points)
  if point >= points.length || loan.created >= points.length { return CallerSource.Unknown }
  if !run reachesAvoiding(points, &mut paths.*, loan.created, point, usize.MAX) { return CallerSource.Absent }
  if control.unresolved { return CallerSource.Unknown }
  return independent
}

// Common event query for the eventual conflict walk. Ordinary accesses retain whole-holder
// use; storage ends retain exact field-sensitive requirements and actual completion paths.
// Each reason remains distinguishable for diagnostic precedence and later-use attribution.
effect fn sourceLoanLiveAt<'body>(graph: &SourceGraph.Graph<'body>, control: &SourceControlProjection,
  settled: &SourceSettledLoans, callers: &SourceCallerProjection, occupancy: &SourceLoanOccupancy,
  needs: &SourceLoanNeeds, holders: &SourceHolderLiveness, intervals: &[SourceIntervalProjection],
  views: &[SourceViewProjection], viewMissing: SourceAtom, point: usize, storageEnd: bool,
  paths: &mut List<ReplacementReach>) -> SourceLiveAt ! OutOfMemoryError ? &mut Allocator {
  let loans = List<Loan>.asSlice(&settled.loans)
  let activities = List<SourceTruth>.asSlice(&settled.activity)
  let independent = List<CallerSource>.asSlice(&settled.independent)
  let index = occupancy.loan
  if index >= loans.length || activities.length != loans.length || independent.length != loans.length {
    return CompilerBug.panic(b"event liveness lost its settled loan acquisition")
  }
  if activities[index] == SourceTruth.False {
    return SourceLiveAt {flight: CallerSource.Absent, held: CallerSource.Absent,
      view: CallerSource.Absent, caller: CallerSource.Absent}
  }
  let loan = &loans[index]
  let flight = run sourceFlight(graph, control, intervals, index, point, storageEnd)
  let mut held = CallerSource.Absent
  if storageEnd { held = sourceHeldAt(control, occupancy, List<u64>.asSlice(&needs.liveOut), needs.unresolved, point) }
  else { held = sourceHeldAt(control, occupancy, List<u64>.asSlice(&holders.liveOut), holders.unresolved, point) }
  held = sourceLiveJoin(held, run sourceIndependentAt(control, independent[index], loan, point, &mut paths.*))
  if loan.until != usize.MAX {
    let points = List<Point>.asSlice(&control.points)
    if loan.until >= points.length || loan.created >= points.length || point >= points.length {
      held = sourceLiveJoin(held, CallerSource.Unknown)
    } else if run liveUntil(points, &mut paths.*, loan, point) {
      let mut actual = CallerSource.Actual
      if control.unresolved { actual = CallerSource.Unknown }
      held = sourceLiveJoin(held, actual)
    }
  }
  let mut view = sourceViewAt(graph, views, index, point, storageEnd)
  if SourceGraph.Graph.truth(graph, viewMissing) != SourceTruth.False { view = sourceLiveJoin(view, CallerSource.Unknown) }
  let caller = sourceCallerAt(graph, callers, index, point)
  return SourceLiveAt {flight: sourceLiveActivity(flight, activities[index]),
    held: sourceLiveActivity(held, activities[index]), view: sourceLiveActivity(view, activities[index]),
    caller: sourceLiveActivity(caller, activities[index])}
}

fn sourceLiveEvidence(live: &SourceLiveAt) -> CallerSource {
  return sourceLiveJoin(sourceLiveJoin(live.flight, live.held), sourceLiveJoin(live.view, live.caller))
}

// One ordinary access against one actual acquisition. The caller visits loans in their
// reserved order and stops after a reported conflict, preserving the accepted diagnostic
// precedence. Storage ends have their separate stale-definition/required-use classifier.
effect fn sourceAccessLoan<'input, 'body, 'proof>(input: &SourceRegionInput<'input, 'body>,
  settled: &SourceSettledLoans, callers: &SourceCallerProjection, occupancy: &SourceLoanOccupancy,
  needs: &SourceLoanNeeds, holders: &SourceHolderLiveness, regions: &RegionSources<'proof>,
  chains: &[UnretainedChain], event: &Event, uncertain: bool, returnedEscape: bool,
  paths: &mut List<ReplacementReach>, contested: &mut List<Shared<Lifetime>>, reports: &mut List<Report>)
  -> SourceAccessDecision ! OutOfMemoryError ? &mut Allocator {
  let loans = List<Loan>.asSlice(&settled.loans)
  let index = occupancy.loan
  if index >= loans.length { return CompilerBug.panic(b"access classification lost its actual loan") }
  if event.kind == Kind.End || event.kind == Kind.Expire {
    return CompilerBug.panic(b"ordinary source access classifier received a storage end")
  }
  let loan = &loans[index]
  let mut result = SourceAccessDecision {reported: false, unresolved: false}
  if index == event.loan || (loan.bound && returnedEscape) || lentTo(loan, &event.binders) { return move result }
  let code = match conflictCode(event.kind, loan.exclusive) {
    Option<RejectionCode>.Some {value} => value
    _ => { return move result }
  }
  let selected = loanAccessOverlap(SourceGraph.Graph.preparation(input.graph).body.locals, loan, event)
  if selected.overlap == usize.ZERO { return move result }
  let live = run sourceLoanLiveAt(input.graph, input.control, settled, callers, occupancy, needs, holders,
    input.intervals, input.views, input.viewMissing, event.point, false, &mut paths.*)
  let evidence = sourceLiveEvidence(&live)
  if evidence != CallerSource.Actual {
    if !run sourceContestedAt(input.graph, input.control, regions, chains, index, event.point,
      &mut paths.*, &mut contested.*) { result.unresolved = true }
    if evidence == CallerSource.Unknown { result.unresolved = true }
    return move result
  }
  if uncertain || !preciseLoanConflict(loan, selected, live.caller) {
    result.unresolved = true
    return move result
  }
  run addReport(&mut reports.*, Report {code: code, access: event.target, related: true, earlier: loan.origin})
  result.reported = true
  // A mutation of body storage can also leave an existing local descriptor expired. A
  // match-view binding reports its subject conflict only, as in the accepted classifier.
  if (event.kind == Kind.Write || event.kind == Kind.Move || event.kind == Kind.Drop)
    && loan.local && loan.binder == usize.MAX {
    let required = run sourceExpiredUse(input.graph, input.control, input.storage, index, event, true)
    if required.evidence == CallerSource.Unknown { result.unresolved = true }
    if required.evidence == CallerSource.Actual
      && (required.span.start != event.span.start || required.span.end != event.span.end) {
      run addReport(&mut reports.*, Report {code: expiredCode(), access: required.span, related: true, earlier: loan.origin})
    }
  }
  return move result
}

// Locate a genuine later read for OWN0019, in the accepted wraparound point order. The
// original consumer supplies its span even if another value now carries that read's history.
// Exact canonical components are supported here; missing/ancestor placement cannot invent a
// required use. The handler's coverage obligation remains separate from this positive query.
effect fn sourceExpiredUse<'body>(graph: &SourceGraph.Graph<'body>, control: &SourceControlProjection,
  storage: &SourceStorageProjection, loan: usize, event: &Event, localOnly: bool) -> SourceRequiredUse
! OutOfMemoryError ? &mut Allocator {
  let points = List<Point>.asSlice(&control.points)
  if event.point >= points.length { return CompilerBug.panic(b"expired source use has no actual end point") }
  let definitions = List<SourceStorageDefinition>.asSlice(&storage.definitions)
  let reads = List<SourceGraph.ReadView>.asSlice(&storage.reads)
  let sourcePoints = List<SourceControl.Point>.asSlice(&SourceGraph.Graph.control(graph).points)
  let prepared = SourceGraph.Graph.preparation(graph)
  let endpoints = List<PreparedSources.Endpoint>.asSlice(&prepared.endpoints)
  let maps = List<PreparedSources.SelectionMap>.asSlice(&prepared.maps)
  let mut result = SourceRequiredUse {evidence: CallerSource.Absent, span: event.span}
  let mut step = usize.ONE
  while step < points.length {
    let point = (event.point + step) % points.length
    if run pathReaches(points, event.point, point) {
      let mut read = usize.ZERO
      while read < reads.length {
        let requested = reads[read]
        if requested.id.index != read { return CompilerBug.panic(b"required read projection changed a real Flow identity") }
        if requested.point.index == point {
          let placements = run SourceGraph.Graph.readPlacementsByRead(graph, requested.id)
          let placements = List<SourceGraph.ReadPlacement>.asSlice(&placements)
          let mut at = usize.ZERO
          while at < placements.length {
            let placement = placements[at]
            let consumer = SourceGraph.Graph.value(graph, placement.consumer)
            let evaluation = SourceGraph.Graph.evaluation(graph, consumer.evaluation)
            if placement.read.index != read || consumer.phase != SourceGraph.ValuePhase.Input
              || placement.result.index != consumer.evaluation.index || evaluation.point.index != point
              || placement.map.index >= maps.length || maps[placement.map.index].kind != PreparedSources.MapKind.Copy
              || maps[placement.map.index].target.index != consumer.endpoint.index {
              return CompilerBug.panic(b"required read lost its original actual consumer")
            }
            let mut owned = false
            if let Option<SourceGraph.Storage>.Some {value: root} = sourceStorageRoot(endpoints, placement.storage) {
              owned = !localOnly || match &endpoints[root.endpoint.index].root {
                PreparedSources.Root.Local {role: PreparedSources.EndpointRole.Storage, ..} => true
                _ => false
              }
            }
            if owned && sourceSameStorage(SourceGraph.Graph.read(graph, placement.original).storage, placement.storage)
              && sourceSameSummary(requested.summary, placement.summary) {
              let mut definition = usize.ZERO
              while definition < definitions.length {
                let actual = &definitions[definition]
                if actual.definition.id.index != definition { return CompilerBug.panic(b"required read substituted another Flow definition") }
                if sourcePlacementStorage(actual.definition, requested, SourceGraph.Graph.read(graph, placement.original), placement, endpoints) {
                  let member = sourceStoredMembership(graph, actual, loan)
                  if member != SourceTruth.False {
                    if let Option<SourceAtom>.Some {value: pair} = sourceFlowPair(SourceGraph.Graph.control(graph),
                      actual.definition.id, requested.id) {
                      let active = sourceTruthAnd(member, sourceTruthAnd(SourceGraph.Graph.truth(graph, pair),
                        sourceTruthAnd(SourceGraph.Graph.truth(graph, placement.active), SourceGraph.Graph.truth(graph, sourcePoints[point].reachable))))
                      if active != SourceTruth.False {
                        if active == SourceTruth.Undefined || control.unresolved { result.evidence = CallerSource.Unknown }
                        else {
                          if let SourceGraph.EvaluationSite.Node {node} = evaluation.site {
                            return SourceRequiredUse {evidence: CallerSource.Actual, span: prepared.body.nodes[node.index].origin.location}
                          }
                          result.evidence = CallerSource.Unknown
                        }
                      }
                    }
                  }
                }
                definition = definition + usize.ONE
              }
            }
            at = at + usize.ONE
          }
        }
        read = read + usize.ONE
      }
    }
    step = step + usize.ONE
  }
  return move result
}

// The accepted readKeeping path query, bounded by this exact canonical component's real
// strong definitions. Weak conditional writes do not manufacture a replacement. Possible
// activity or CFG edges remain unresolved instead of certifying a path through a rebind.
effect fn sourceReadKeeping<'body>(graph: &SourceGraph.Graph<'body>, control: &SourceControlProjection,
  storage: &SourceStorageProjection, original: SourceGraph.DefinitionView, from: usize, to: usize, created: usize)
  -> CallerSource ! OutOfMemoryError ? &mut Allocator {
  let points = List<Point>.asSlice(&control.points)
  if from >= points.length || to >= points.length || created >= points.length { return CallerSource.Unknown }
  let mut rebound = List<bool>.make()
  let mut at = usize.ZERO
  while at < points.length { run List<bool>.append(&mut rebound, false) at = at + usize.ONE }
  let definitions = List<SourceStorageDefinition>.asSlice(&storage.definitions)
  let actualPoints = List<SourceControl.Point>.asSlice(&SourceGraph.Graph.control(graph).points)
  let mut uncertain = control.unresolved
  at = usize.ZERO
  while at < definitions.length {
    let definition = definitions[at].definition
    if definition.point.index >= points.length { return CompilerBug.panic(b"canonical rebind has no actual defining point") }
    if definition.write == SourceControl.Write.Strong && sourceSameStorage(definition.storage, original.storage)
      && sourceSameSummary(definition.summary, original.summary) {
      let active = sourceTruthAnd(SourceGraph.Graph.truth(graph, definition.active),
        SourceGraph.Graph.truth(graph, actualPoints[definition.point.index].reachable))
      if active == SourceTruth.True { List<bool>.asMutSlice(&mut rebound)[definition.point.index] = true }
      if active == SourceTruth.Undefined { uncertain = true }
    }
    at = at + usize.ONE
  }
  if !run readKeeping(points, from, to, created, List<bool>.asSlice(&rebound)) { return CallerSource.Absent }
  if uncertain { return CallerSource.Unknown }
  return CallerSource.Actual
}

// A later physical definition can copy an expired value from an earlier read. Keep that
// exact paired source history, and require a future use of the actual new definition.
// No per-leaf definitions, canonical addresses from result loans, or old Holding IDs appear.
effect fn sourceStaleDefinition<'body>(graph: &SourceGraph.Graph<'body>, control: &SourceControlProjection,
  storage: &SourceStorageProjection, occupancy: &SourceLoanOccupancy, needs: &SourceLoanNeeds,
  loan: &Loan, end: usize) -> SourceStaleDefinition ! OutOfMemoryError ? &mut Allocator {
  let definitions = List<SourceStorageDefinition>.asSlice(&storage.definitions)
  let points = List<Point>.asSlice(&control.points)
  let live = List<u64>.asSlice(&needs.liveOut)
  if end >= points.length || occupancy.width != (definitions.length + 63) / 64
    || live.length != points.length * occupancy.width {
    return CompilerBug.panic(b"stale source query lost its actual liveness inventory")
  }
  let mut result = SourceStaleDefinition {evidence: CallerSource.Absent, definition: Option<SourceControl.DefinitionId>.none()}
  if needs.unresolved || occupancy.unresolved || control.unresolved { result.evidence = CallerSource.Unknown }
  let mut at = usize.ZERO
  while at < definitions.length {
    let held = &definitions[at]
    if held.definition.id.index != at || held.definition.point.index >= points.length {
      return CompilerBug.panic(b"stale source query changed an actual definition identity")
    }
    if reaches(live, occupancy.width, held.definition.point.index, at) {
      let members = List<SourceStoredLoan>.asSlice(&held.loans)
      let inputs = List<SourceGraph.Input>.asSlice(&held.inputs)
      let mut member = usize.ZERO
      while member < members.length {
        if members[member].loan == occupancy.loan {
          let present = SourceGraph.Graph.truth(graph, members[member].active)
          if present != SourceTruth.False {
            let mut input = usize.ZERO
            while input < inputs.length {
              if inputs[input].leaf.index == members[member].leaf.index {
                let histories = List<SourceGraph.InputCase>.asSlice(&inputs[input].cases)
                let mut history = usize.ZERO
                while history < histories.length {
                  let source = &histories[history]
                  let mut active = sourceTruthAnd(present, SourceGraph.Graph.truth(graph, source.quality.present))
                  if active != SourceTruth.False {
                    if let Option<SourceControl.DefinitionId>.Some {value: original} = source.definition {
                      if let Option<SourceControl.ReadId>.Some {value: read} = source.read {
                        let old = SourceGraph.Graph.definition(graph, original)
                        let observed = SourceGraph.Graph.read(graph, read)
                        if sourceSameReadLane(old, observed) {
                          if let Option<SourceAtom>.Some {value: pair} = sourceFlowPair(SourceGraph.Graph.control(graph), original, read) {
                            active = sourceTruthAnd(active, SourceGraph.Graph.truth(graph, pair))
                            if active != SourceTruth.False {
                              let keeping = run sourceReadKeeping(graph, control, storage, old,
                                end, observed.point.index, loan.created)
                              if keeping != CallerSource.Absent {
                                if keeping == CallerSource.Actual && active == SourceTruth.True
                                  && !needs.unresolved && !occupancy.unresolved {
                                  return SourceStaleDefinition {evidence: CallerSource.Actual,
                                    definition: Option<SourceControl.DefinitionId>.some(held.definition.id)}
                                }
                                result.evidence = CallerSource.Unknown
                              }
                            }
                          } else { result.evidence = CallerSource.Unknown }
                        } else { result.evidence = CallerSource.Unknown }
                      } else { result.evidence = CallerSource.Unknown }
                    } else if let Option<SourceControl.ReadId>.Some {..} = source.read { result.evidence = CallerSource.Unknown }
                  }
                  history = history + usize.ONE
                }
              }
              input = input + usize.ONE
            }
          }
        }
        member = member + usize.ONE
      }
    }
    at = at + usize.ONE
  }
  return move result
}

// A stale definition reports its actual defining operation before looking for a later use.
// The stored Value can have been evaluated earlier; it never supplies the writer's span.
effect fn sourceDefinitionUse<'body>(graph: &SourceGraph.Graph<'body>, control: &SourceControlProjection,
  storage: &SourceStorageProjection, id: SourceControl.DefinitionId, fallback: Location)
  -> SourceRequiredUse ! OutOfMemoryError ? &mut Allocator {
  let definition = SourceGraph.Graph.definition(graph, id)
  let prepared = SourceGraph.Graph.preparation(graph)
  if let Option<SourceGraph.EvalId>.Some {value: writer} = definition.writer {
    let actual = SourceGraph.Graph.evaluation(graph, writer)
    if actual.point.index != definition.point.index { return CompilerBug.panic(b"stale definition lost its actual writer point") }
    if let SourceGraph.EvaluationSite.Node {node} = actual.site {
      let span = prepared.body.nodes[node.index].origin.location
      if span.end > span.start { return SourceRequiredUse {evidence: CallerSource.Actual, span: span} }
    } else { return CompilerBug.panic(b"body-entry definition acquired a node writer") }
  }
  let points = List<Point>.asSlice(&control.points)
  let reads = List<SourceGraph.ReadView>.asSlice(&storage.reads)
  let maps = List<PreparedSources.SelectionMap>.asSlice(&prepared.maps)
  let actualPoints = List<SourceControl.Point>.asSlice(&SourceGraph.Graph.control(graph).points)
  let mut result = SourceRequiredUse {evidence: CallerSource.Absent, span: fallback}
  let mut step = usize.ONE
  while step < points.length {
    let point = (definition.point.index + step) % points.length
    if run pathReaches(points, definition.point.index, point) {
      let mut at = usize.ZERO
      while at < reads.length {
        let read = reads[at]
        if read.point.index == point && sourceSameReadLane(definition, read) {
          if let Option<SourceAtom>.Some {value: pair} = sourceFlowPair(SourceGraph.Graph.control(graph), id, read.id) {
            let paired = sourceTruthAnd(SourceGraph.Graph.truth(graph, pair), SourceGraph.Graph.truth(graph, actualPoints[point].reachable))
            if paired != SourceTruth.False {
              let placements = run SourceGraph.Graph.readPlacementsByRead(graph, read.id)
              let placements = List<SourceGraph.ReadPlacement>.asSlice(&placements)
              let mut each = usize.ZERO
              while each < placements.length {
                let placement = placements[each]
                let consumer = SourceGraph.Graph.value(graph, placement.consumer)
                let evaluation = SourceGraph.Graph.evaluation(graph, consumer.evaluation)
                if placement.read.index != read.id.index || consumer.phase != SourceGraph.ValuePhase.Input
                  || consumer.evaluation.index != placement.result.index || evaluation.point.index != point
                  || placement.map.index >= maps.length || maps[placement.map.index].kind != PreparedSources.MapKind.Copy
                  || maps[placement.map.index].target.index != consumer.endpoint.index {
                  return CompilerBug.panic(b"stale definition use lost its original read consumer")
                }
                if sourcePlacementStorage(definition, read, SourceGraph.Graph.read(graph, placement.original), placement,
                  List<PreparedSources.Endpoint>.asSlice(&prepared.endpoints)) {
                  let active = sourceTruthAnd(paired, SourceGraph.Graph.truth(graph, placement.active))
                  if active != SourceTruth.False {
                    if active == SourceTruth.Undefined || control.unresolved { result.evidence = CallerSource.Unknown }
                    else if let SourceGraph.EvaluationSite.Node {node} = evaluation.site {
                      return SourceRequiredUse {evidence: CallerSource.Actual, span: prepared.body.nodes[node.index].origin.location}
                    } else { result.evidence = CallerSource.Unknown }
                  }
                }
                each = each + usize.ONE
              }
            }
          }
        }
        at = at + usize.ONE
      }
    }
    step = step + usize.ONE
  }
  return move result
}

fn sourceTemporaryOwner(owners: &[SourceVisit.Owner], locals: usize, root: usize) -> bool {
  if root < locals || root - locals >= owners.length { return false }
  return match owners[root - locals].root { SourceVisit.OwnerRoot.Temporary {..} => true _ => false }
}

// A storage end retains field-sensitive needs, current flight and copied stale histories.
// Unknown acquisition/control evidence cannot become a concrete expiration diagnostic.
effect fn sourceEndLoan<'input, 'body>(input: &SourceRegionInput<'input, 'body>, settled: &SourceSettledLoans,
  callers: &SourceCallerProjection, occupancy: &SourceLoanOccupancy, needs: &SourceLoanNeeds,
  holders: &SourceHolderLiveness, event: &Event, uncertain: bool, returnedEscape: bool,
  paths: &mut List<ReplacementReach>, reports: &mut List<Report>) -> SourceAccessDecision
! OutOfMemoryError ? &mut Allocator {
  let loans = List<Loan>.asSlice(&settled.loans)
  let activities = List<SourceTruth>.asSlice(&settled.activity)
  let index = occupancy.loan
  if index >= loans.length || activities.length != loans.length { return CompilerBug.panic(b"storage end lost its actual loan") }
  if event.kind != Kind.End && event.kind != Kind.Expire { return CompilerBug.panic(b"storage-end classifier received an ordinary access") }
  let loan = &loans[index]
  let mut result = SourceAccessDecision {reported: false, unresolved: false}
  if !loan.local || (loan.bound && returnedEscape) || !covers(&event.place, &loan.place)
    || activities[index] == SourceTruth.False { return move result }
  let live = run sourceLoanLiveAt(input.graph, input.control, settled, callers, occupancy, needs, holders,
    input.intervals, input.views, input.viewMissing, event.point, true, &mut paths.*)
  let evidence = sourceLiveEvidence(&live)
  let mut stale = SourceStaleDefinition {evidence: CallerSource.Absent, definition: Option<SourceControl.DefinitionId>.none()}
  if evidence != CallerSource.Actual {
    stale = run sourceStaleDefinition(input.graph, input.control, input.storage, occupancy, needs, loan, event.point)
  }
  if evidence != CallerSource.Actual && stale.evidence != CallerSource.Actual {
    result.unresolved = evidence == CallerSource.Unknown || stale.evidence == CallerSource.Unknown
    return move result
  }
  if uncertain || activities[index] != SourceTruth.True
    || loan.precision == LoanPrecision.Alternatives || loan.precision == LoanPrecision.Unknown {
    result.unresolved = true
    return move result
  }
  let mut required = SourceRequiredUse {evidence: CallerSource.Absent, span: event.span}
  if stale.evidence == CallerSource.Actual {
    let definition = match stale.definition {
      Option<SourceControl.DefinitionId>.Some {value} => value
      _ => { return CompilerBug.panic(b"actual stale source has no physical definition") }
    }
    required = run sourceDefinitionUse(input.graph, input.control, input.storage, definition, event.span)
  } else if live.flight != CallerSource.Actual || sourceTemporaryOwner(input.owners,
    SourceGraph.Graph.preparation(input.graph).body.locals.length, loan.place.root) {
    required = run sourceExpiredUse(input.graph, input.control, input.storage, index, event, false)
  }
  result.unresolved = required.evidence == CallerSource.Unknown
  run addReport(&mut reports.*, Report {code: expiredCode(), access: required.span, related: true, earlier: loan.origin})
  result.reported = true
  return move result
}

// Freeze the diagnostic walk's per-loan views from the solved graph. Every occupancy bit
// still names a real Flow definition, and every liveness query uses the shared actual CFG.
effect fn sourceLoanFlows<'input, 'body>(input: &SourceRegionInput<'input, 'body>, settled: &SourceSettledLoans,
  holders: &SourceHolderProjection, intervals: &mut IntervalFlow) -> List<SourceLoanFlow>
! OutOfMemoryError ? &mut Allocator {
  let loans = List<Loan>.asSlice(&settled.loans)
  let mut result = List<SourceLoanFlow>.make()
  let mut at = usize.ZERO
  while at < loans.length {
    let occupancy = run sourceLoanOccupancy(input.graph, input.storage, at)
    let needs = run sourceLoanNeeds(input.graph, input.control, input.storage, &occupancy,
      input.intervals, input.views, loans[at].created, &mut intervals.*)
    let kept = run sourceHolderLiveness(input.graph, input.control, input.storage, &occupancy, holders)
    run List<SourceLoanFlow>.append(&mut result, SourceLoanFlow {occupancy: move occupancy, needs: move needs, holders: move kept})
    at = at + usize.ONE
  }
  return move result
}

// The complete access-order classifier, after guard/escape/outside precedence has been
// decided by the body owner. It reports genuine conflicts and unresolved evidence only;
// absence of a conflict never discharges source coverage or retained region obligations.
effect fn sourceConflicts<'input, 'body, 'proof>(input: &SourceRegionInput<'input, 'body>,
  settled: &SourceSettledLoans, callers: &SourceCallerProjection, flow: &[SourceLoanFlow],
  moves: &SourceMoveProjection, refinements: &[Refinement], regions: &RegionSources<'proof>,
  chains: &[UnretainedChain], returnedEscape: bool) -> SourceConflictProjection
! OutOfMemoryError ? &mut Allocator {
  let events = List<Event>.asSlice(&input.events.events)
  let uncertain = List<bool>.asSlice(&input.events.uncertain)
  let loans = List<Loan>.asSlice(&settled.loans)
  if uncertain.length != events.length || flow.length != loans.length {
    return CompilerBug.panic(b"source conflict projection lost its actual event or loan inventory")
  }
  let mut result = SourceConflictProjection {conflict: Option<Verdict>.none(), contested: List<Shared<Lifetime>>.make(),
    unresolved: settled.unresolved || input.events.unresolved || input.control.unresolved || moves.unresolved}
  let points = List<Point>.asSlice(&input.control.points)
  let loops = List<Loop>.asSlice(&moves.loops)
  let initialized = List<MoveInitialization>.asSlice(&moves.initialized)
  let moved = List<usize>.asSlice(&moves.moves)
  let mut reports = List<Report>.make()
  let mut paths = List<ReplacementReach>.make()
  let mut checkedLoops = usize.ZERO
  let mut stopped = false
  let mut at = usize.ZERO
  while at <= events.length {
    while checkedLoops < loops.length && (at == events.length || loops[checkedLoops].header < events[at].point) {
      let repeat = &loops[checkedLoops]
      let repeats = run refinementRepeats(points, refinements, events, repeat, &mut paths)
      let compatible = moves.width == usize.ZERO || compatibleHeader(initialized, events, moved, &moves.reach, moves.width, repeat)
      if !compatible || !repeats {
        if moves.unresolved { result.unresolved = true }
        else {
          if List<Report>.length(&reports) == usize.ZERO {
            result.conflict = Option<Verdict>.some(Verdict {outcome: Outcome.Conflict, status: BorrowStatus.Regions,
              code: RejectionCode.IncompatibleLoopHeader, access: repeat.span, earlier: Option<Location>.none(), reports: List<Report>.make()})
          }
          stopped = true
          break
        }
      }
      checkedLoops = checkedLoops + usize.ONE
    }
    if stopped || at == events.length { break }
    let event = &events[at]
    if event.consumesTarget == usize.ONE && !uncertain[at] {
      if List<Report>.length(&reports) == usize.ZERO {
        result.conflict = Option<Verdict>.some(Verdict {outcome: Outcome.Conflict, status: BorrowStatus.Regions,
          code: RejectionCode.OverlappingAssignment, access: event.span, earlier: Option<Location>.none(), reports: List<Report>.make()})
      }
      break
    }
    if event.consumesTarget != usize.ZERO { result.unresolved = true }
    let mut bit = usize.ZERO
    while event.kind != Kind.End && event.kind != Kind.Expire && bit < moved.length {
      if moveReachesEvent(events, initialized, moved, &moves.reach, moves.width, bit, at) {
        let classification = movedAccess(event, &events[moved[bit]])
        if classification == MoveAccess.Conflict {
          if moves.unresolved || uncertain[at] || uncertain[moved[bit]] { result.unresolved = true }
          else {
            if List<Report>.length(&reports) == usize.ZERO {
              result.conflict = Option<Verdict>.some(Verdict {outcome: Outcome.Conflict, status: BorrowStatus.Regions,
                code: RejectionCode.UseAfterMove, access: event.span, earlier: Option<Location>.some(events[moved[bit]].span),
                reports: List<Report>.make()})
            }
            stopped = true
            break
          }
        }
        if classification == MoveAccess.Unknown { result.unresolved = true }
      }
      bit = bit + usize.ONE
    }
    if stopped { break }
    if event.refiner != usize.MAX && event.kind != Kind.End && event.kind != Kind.Expire {
      let test = refinementTest(refinements, event.refiner)
      if test == usize.MAX { result.unresolved = true }
      let mut source = usize.ZERO
      while test != usize.MAX && source < events.length {
        let written = &events[source]
        if replaces(written.kind) && coversRefined(&written.place, &event.place, event.refinedDepth)
          && run reachesAvoiding(points, &mut paths, written.point, event.point, test) {
          if input.control.unresolved || uncertain[at] || uncertain[source] { result.unresolved = true }
          else {
            if List<Report>.length(&reports) == usize.ZERO {
              run List<Report>.append(&mut reports, Report {code: RejectionCode.ExtractionBoundary, access: event.span,
                related: true, earlier: written.span})
            }
            break
          }
        }
        source = source + usize.ONE
      }
    }
    let mut loan = usize.ZERO
    while loan < loans.length {
      let actual = &flow[loan]
      if actual.occupancy.loan != loan { return CompilerBug.panic(b"source conflict projection reordered loan identities") }
      let ended = event.kind == Kind.End || event.kind == Kind.Expire
      let mut decision = SourceAccessDecision {reported: false, unresolved: false}
      if ended {
        decision = run sourceEndLoan(input, settled, callers, &actual.occupancy, &actual.needs, &actual.holders,
          event, uncertain[at], returnedEscape, &mut paths, &mut reports)
      } else {
        decision = run sourceAccessLoan(input, settled, callers, &actual.occupancy, &actual.needs, &actual.holders,
          regions, chains, event, uncertain[at], returnedEscape, &mut paths, &mut result.contested, &mut reports)
      }
      if decision.unresolved { result.unresolved = true }
      if decision.reported && !ended { break }
      loan = loan + usize.ONE
    }
    at = at + usize.ONE
  }
  if List<Report>.length(&reports) != usize.ZERO {
    let first = List<Report>.asSlice(&reports)[usize.ZERO]
    let mut listed = List<Report>.make()
    if List<Report>.length(&reports) > usize.ONE { listed = run bySpan(List<Report>.asSlice(&reports)) }
    let mut earlier = Option<Location>.none()
    if first.related { earlier = Option<Location>.some(first.earlier) }
    result.conflict = Option<Verdict>.some(Verdict {outcome: Outcome.Conflict, status: BorrowStatus.Regions,
      code: first.code, access: first.access, earlier: move earlier, reports: move listed})
  }
  return move result
}

fn sourceRefutedOr(settled: &SourceSettledLoans, escaping: usize, otherwise: Verdict) -> Verdict {
  if escaping == usize.MAX { return move otherwise }
  let loans = List<Loan>.asSlice(&settled.loans)
  let activity = List<SourceTruth>.asSlice(&settled.activity)
  if escaping >= loans.length || activity.length != loans.length || activity[escaping] != SourceTruth.True
    || !ownedStorageLoan(&loans[escaping]) {
    return CompilerBug.panic(b"escape refutation has no actual precise owned loan")
  }
  return Verdict {outcome: Outcome.Conflict, status: BorrowStatus.Regions, code: RejectionCode.UnsatisfiedLifetimeBound,
    access: loans[escaping].origin, earlier: Option<Location>.none(), reports: List<Report>.make()}
}

// Terminal proof classification owns the original body obligations and premises. Current C
// has no external request producer: an incoming outcome cannot bypass an internal Outlives
// or Contents predicate merely by naming its ordinal, even when stamped by this graph.
// The operation driver must supply every missing-source gate before its single solve.
effect fn sourceProofVerdict<'input, 'body>(input: &SourceRegionInput<'input, 'body>, settled: &SourceSettledLoans,
  conflicts: SourceConflictProjection, missing: SourceAtom, inherited: BorrowStatus,
  openContents: &[Shared<Lifetime>], relations: &[ImpliedGroup], returnedEscape: usize,
  outcomes: &[SourceGraph.SourceOutcome]) -> Verdict ! OutOfMemoryError ? &mut Allocator {
  if let Option<Verdict>.Some {value} = move conflicts.conflict { return move value }
  if settled.storing != SourceTruth.False {
    return sourceRefutedOr(settled, returnedEscape, verdict(Outcome.NotChecked, BorrowStatus.StoredLoans))
  }
  let prepared = SourceGraph.Graph.preparation(input.graph)
  let actual = List<SourceControl.Point>.asSlice(&SourceGraph.Graph.control(input.graph).points)
  if input.control.entry >= actual.length { return CompilerBug.panic(b"terminal source check lost its actual entry") }
  if SourceGraph.Graph.truth(input.graph, actual[input.control.entry].reachable) != SourceTruth.True
    || SourceGraph.Graph.truth(input.graph, missing) != SourceTruth.False
    || conflicts.unresolved || settled.unresolved || input.control.unresolved || input.events.unresolved {
    return sourceRefutedOr(settled, returnedEscape, verdict(Outcome.NotChecked, BorrowStatus.Imprecise))
  }
  if inherited != BorrowStatus.Checked {
    return sourceRefutedOr(settled, returnedEscape, verdict(Outcome.NotChecked, inherited))
  }
  if prepared.body.coverage != PreparedSources.Coverage.Complete || outcomes.length != usize.ZERO {
    return sourceRefutedOr(settled, returnedEscape, verdict(Outcome.NotChecked, BorrowStatus.Regions))
  }
  let sources = sourceRegionSources(settled, prepared.body.supplied,
    List<Shared<Lifetime>>.asSlice(&conflicts.contested), openContents, relations)
  let mut symbolic = List<SymbolicRegion>.make()
  let crossings = run crossedRegionsProved(&sources, prepared.body.owner, prepared.body.premises, &mut symbolic)
  let mut proved = !prepared.body.pending && crossings
  if !proved {
    proved = run sourceLocalRelationsProved(input, &sources, prepared.body.owner, prepared.body.obligations,
      prepared.body.premises, &mut symbolic, !crossings)
  }
  if proved && run regionClosed(prepared.body.owner, prepared.body.supplied, prepared.body.locals, prepared.body.nodes) {
    return sourceRefutedOr(settled, returnedEscape, verdict(Outcome.Clear, BorrowStatus.Checked))
  }
  return sourceRefutedOr(settled, returnedEscape, verdict(Outcome.Clear, BorrowStatus.Regions))
}

// Build the existing availability solver's inputs from original definitions and paired source
// cases. A copy is licensed by its actual input history; occupying the same region or appearing
// earlier in the definition inventory supplies no copy edge.
effect fn sourceAvailabilityProjection<'body>(graph: &SourceGraph.Graph<'body>, storage: &SourceStorageProjection,
  occupancy: &SourceLoanOccupancy, intervals: &[SourceIntervalProjection], views: &[SourceViewProjection]) -> AvailabilityProjection
! OutOfMemoryError ? &mut Allocator {
  let control = SourceGraph.Graph.control(graph)
  let pointCount = List<SourceControl.Point>.length(&control.points)
  let definitions = List<SourceStorageDefinition>.asSlice(&storage.definitions)
  let mut projection = AvailabilityProjection {carriers: List<AvailabilityCarrier>.make(),
    preserves: List<u64>.make(), flight: List<bool>.make(), unresolved: occupancy.unresolved}
  let leaving = List<u64>.asSlice(&occupancy.leaving)
  let mut at = usize.ZERO
  while at < leaving.length {
    run List<u64>.append(&mut projection.preserves, leaving[at])
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < pointCount { run List<bool>.append(&mut projection.flight, false) at = at + usize.ONE }
  at = usize.ZERO
  while at < views.length {
    if views[at].loan == occupancy.loan {
      let held = List<SourceAtom>.asSlice(&views[at].occupied)
      if held.length != pointCount { return CompilerBug.panic(b"view occupancy belongs to another CFG") }
      let mut point = usize.ZERO
      while point < pointCount {
        let active = SourceGraph.Graph.truth(graph, held[point])
        if active != SourceTruth.False { List<bool>.asMutSlice(&mut projection.flight)[point] = true }
        if active == SourceTruth.Undefined { projection.unresolved = true }
        point = point + usize.ONE
      }
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < intervals.length {
    let interval = &intervals[at]
    if interval.source.loan == occupancy.loan {
      let active = SourceGraph.Graph.truth(graph, interval.evidence.present)
      if active == SourceTruth.Undefined || SourceGraph.Graph.truth(graph, interval.evidence.missing) != SourceTruth.False {
        projection.unresolved = true
      }
      if active != SourceTruth.False {
        if interval.from >= pointCount || interval.to >= pointCount { projection.unresolved = true }
        else {
          let mut point = interval.from
          while point <= interval.to {
            List<bool>.asMutSlice(&mut projection.flight)[point] = true
            point = point + usize.ONE
          }
        }
      }
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < definitions.length {
    let definition = &definitions[at]
    let mut carrier = AvailabilityCarrier {point: definition.definition.point.index,
      selected: sourceStoredMembership(graph, definition, occupancy.loan) != SourceTruth.False,
      unpaired: false, sources: List<AvailabilitySource>.make()}
    let inputs = List<SourceGraph.Input>.asSlice(&definition.inputs)
    let members = List<SourceStoredLoan>.asSlice(&definition.loans)
    let mut each = usize.ZERO
    while each < inputs.length {
      let mut membership = SourceTruth.False
      let mut member = usize.ZERO
      while member < members.length {
        if members[member].loan == occupancy.loan && members[member].leaf.index == inputs[each].leaf.index {
          let active = SourceGraph.Graph.truth(graph, members[member].active)
          if active == SourceTruth.True || (active == SourceTruth.Undefined && membership == SourceTruth.False) { membership = active }
        }
        member = member + usize.ONE
      }
      let cases = List<SourceGraph.InputCase>.asSlice(&inputs[each].cases)
      let mut history = usize.ZERO
      while history < cases.length {
        let source = &cases[history]
        let active = sourceTruthAnd(membership, SourceGraph.Graph.truth(graph, source.quality.present))
        if active == SourceTruth.Undefined { projection.unresolved = true }
        if active != SourceTruth.False {
          match source.definition {
            Option<SourceControl.DefinitionId>.Some {value: origin} => {
              if let Option<SourceControl.ReadId>.Some {value: read} = source.read {
                if origin.index >= definitions.length || read.index >= SourceGraph.Graph.readCount(graph) {
                  projection.unresolved = true
                } else {
                  let written = SourceGraph.Graph.definition(graph, origin)
                  let observed = SourceGraph.Graph.read(graph, read)
                  if !sourceSameReadLane(written, observed) { projection.unresolved = true }
                  else if let Option<SourceAtom>.Some {value: pair} = sourceFlowPair(control, origin, read) {
                    let paired = sourceTruthAnd(active, SourceGraph.Graph.truth(graph, pair))
                    if paired == SourceTruth.Undefined { projection.unresolved = true }
                    if paired != SourceTruth.False {
                      run List<AvailabilitySource>.append(&mut carrier.sources,
                        AvailabilitySource {definition: origin.index, read: observed.point.index})
                    }
                  } else { projection.unresolved = true }
                }
              } else { projection.unresolved = true }
            }
            _ => match source.read {
              Option<SourceControl.ReadId>.None => { carrier.unpaired = true }
              _ => { projection.unresolved = true }
            }
          }
        }
        history = history + usize.ONE
      }
      each = each + usize.ONE
    }
    run List<AvailabilityCarrier>.append(&mut projection.carriers, move carrier)
    at = at + usize.ONE
  }
  return move projection
}

// The source path supplies actual events and the projected carrier histories to the one
// accepted availability algorithm. Initialization and unreachable points retain their separate
// must-mask and creation proofs; neither is inferred from current loan occupancy.
effect fn sourceLoanAvailable(control: &SourceControlProjection, events: &SourceRuntimeEvents,
  projection: &AvailabilityProjection, occupancy: &SourceLoanOccupancy, loan: &Loan,
  sourceBound: bool, initialized: usize, storage: &RegionAvailability) -> SourceLoanAvailability
! OutOfMemoryError ? &mut Allocator {
  let points = List<Point>.asSlice(&control.points)
  let mut result = SourceLoanAvailability {points: List<u64>.make(), unresolved:
    control.unresolved || events.unresolved || projection.unresolved || occupancy.unresolved}
  let words = (points.length + 63) / 64
  let mut at = usize.ZERO
  while at < words { run List<u64>.append(&mut result.points, u64.bitNot(0)) at = at + usize.ONE }
  if loan.created >= points.length {
    result.unresolved = true
    return move result
  }
  run propagateAvailability(points, List<Event>.asSlice(&events.events), control.entry, loan, sourceBound,
    initialized != usize.MAX, List<u64>.asSlice(&occupancy.entering), occupancy.width, projection, &mut result.points)
  if initialized != usize.MAX {
    let masks = List<List<u64>>.asSlice(&storage.masks)
    if initialized >= masks.length { return CompilerBug.panic(b"source availability lost its actual initialization mask") }
    let valid = List<u64>.asSlice(&masks[initialized])
    if valid.length != words { return CompilerBug.panic(b"initialization mask belongs to another CFG") }
    let mut own = List<u64>.asMutSlice(&mut result.points)
    at = usize.ZERO
    while at < words { own[at] = u64.bitAnd(own[at], valid[at]) at = at + usize.ONE }
  }
  run unreachableAvailable(points, loan.created, &mut result.points)
  return move result
}

// Owner identity, not a region match or a source leaf's creation order, selects initialization.
// Several owners may initialize at one point; the old singleton Point.initializes slot is not
// used by this projection. Repeated initialization of a local keeps the existing refusal.
effect fn sourceInitializedOwnedRegion(control: &SourceControlProjection, owners: &[SourceVisit.Owner],
  localCount: usize, loan: &Loan, region: &Shared<Lifetime>, storage: &mut RegionAvailability,
  flow: &mut IntervalFlow) -> usize ! OutOfMemoryError ? &mut Allocator {
  if control.unresolved || !initializedOwnedSource(loan, region) { return usize.MAX }
  let mut initialized = usize.MAX
  let mut at = usize.ZERO
  while at < owners.length {
    let root = match owners[at].root {
      SourceVisit.OwnerRoot.Local {local} => local.index
      _ => localCount + at
    }
    if root == loan.place.root {
      if initialized != usize.MAX { return usize.MAX }
      initialized = owners[at].initialized.index
    }
    at = at + usize.ONE
  }
  if initialized == usize.MAX { return usize.MAX }
  return run initializedStorageRegion(List<Point>.asSlice(&control.points), control.entry, loan.place.root,
    initialized, &mut storage.*, &mut flow.*)
}

// Release is usable only after this loan's own requirements fit its own availability. The
// parent/escape gates are shared with the accepted checker, and uncertain occupancy cannot
// establish absence. Definite Flow kills and authenticated interval ends are the only ends.
effect fn sourceReleasedLoanPoints<'body>(graph: &SourceGraph.Graph<'body>, control: &SourceControlProjection,
  occupancy: &SourceLoanOccupancy, needs: &SourceLoanNeeds, intervals: &[SourceIntervalProjection],
  views: &[SourceViewProjection], loans: &[Loan], available: &[u64]) -> List<u64> ! OutOfMemoryError ? &mut Allocator {
  let points = List<Point>.asSlice(&control.points)
  let required = List<u64>.asSlice(&needs.required)
  let words = (points.length + 63) / 64
  let mut unavailable = List<u64>.make()
  let mut at = usize.ZERO
  while at < words { run List<u64>.append(&mut unavailable, 0) at = at + usize.ONE }
  if needs.unresolved || occupancy.unresolved || control.unresolved || available.length != words
    || required.length != words || occupancy.loan >= loans.length { return move unavailable }
  let loan = &loans[occupancy.loan]
  if !loanMayRelease(loans, occupancy.loan) || loan.created >= points.length { return move unavailable }
  at = usize.ZERO
  while at < words {
    if u64.bitAnd(required[at], u64.bitNot(available[at])) != 0 { return move unavailable }
    at = at + usize.ONE
  }
  let mut occupied = List<bool>.make()
  let mut ends = List<bool>.make()
  at = usize.ZERO
  while at < points.length {
    let mut carries = at == loan.created || u64.bitAnd(required[wordOf(at)], maskOf(at)) != 0
    let mut survives = false
    let mut ended = false
    let mut word = usize.ZERO
    while word < occupancy.width {
      let incoming = List<u64>.asSlice(&occupancy.entering)[at * occupancy.width + word]
      let outgoing = List<u64>.asSlice(&occupancy.leaving)[at * occupancy.width + word]
      if incoming != 0 || outgoing != 0 { carries = true }
      if outgoing != 0 { survives = true }
      if u64.bitAnd(incoming, u64.bitNot(outgoing)) != 0 { ended = true }
      word = word + usize.ONE
    }
    let mut each = usize.ZERO
    while each < intervals.length {
      let interval = &intervals[each]
      if interval.source.loan == occupancy.loan && interval.to == at && interval.from <= interval.to
        && SourceGraph.Graph.truth(graph, interval.evidence.present) == SourceTruth.True { ended = true }
      each = each + usize.ONE
    }
    each = usize.ZERO
    while each < views.length {
      if views[each].loan == occupancy.loan {
        let occupied = List<SourceAtom>.asSlice(&views[each].occupied)
        let remaining = List<SourceAtom>.asSlice(&views[each].survives)
        let released = List<SourceAtom>.asSlice(&views[each].released)
        if occupied.length != points.length || remaining.length != points.length || released.length != points.length {
          return CompilerBug.panic(b"view release belongs to another CFG")
        }
        let held = SourceGraph.Graph.truth(graph, occupied[at])
        let kept = SourceGraph.Graph.truth(graph, remaining[at])
        let end = SourceGraph.Graph.truth(graph, released[at])
        // An uncertain view cannot authorize release, including a view with no later read.
        if held == SourceTruth.Undefined || kept == SourceTruth.Undefined || end == SourceTruth.Undefined {
          return move unavailable
        }
        if held == SourceTruth.True { carries = true }
        if kept == SourceTruth.True { survives = true }
        if end == SourceTruth.True { ended = true }
      }
      each = each + usize.ONE
    }
    run List<bool>.append(&mut occupied, carries)
    run List<bool>.append(&mut ends, ended && !survives)
    at = at + usize.ONE
  }
  return run releasedInstancePoints(points, control.entry, loan.created,
    List<bool>.asSlice(&occupied), List<bool>.asSlice(&ends))
}

// Flight classification retains the accepted strict interval endpoints. Cleanup and storage
// ends additionally require paths on the same CFG; a source case is authenticated independently
// of whether the source's old owner still contains it at the consuming event.
effect fn sourceFlight<'body>(graph: &SourceGraph.Graph<'body>, control: &SourceControlProjection,
  intervals: &[SourceIntervalProjection], loan: usize, point: usize, storageEnd: bool) -> CallerSource
! OutOfMemoryError ? &mut Allocator {
  let points = List<Point>.asSlice(&control.points)
  if point >= points.length { return CallerSource.Unknown }
  let reachable = SourceGraph.Graph.truth(graph,
    List<SourceControl.Point>.asSlice(&SourceGraph.Graph.control(graph).points)[point].reachable)
  if reachable == SourceTruth.False { return CallerSource.Absent }
  let mut result = CallerSource.Absent
  let mut at = usize.ZERO
  while at < intervals.length {
    let interval = &intervals[at]
    if interval.source.loan == loan && interval.from < point && point < interval.to {
      let present = sourceTruthAnd(reachable, SourceGraph.Graph.truth(graph, interval.evidence.present))
      if SourceGraph.Graph.truth(graph, interval.evidence.missing) != SourceTruth.False { result = CallerSource.Unknown }
      if present != SourceTruth.False {
        if interval.from >= points.length || interval.to >= points.length { result = CallerSource.Unknown }
        else if storageEnd || interval.cleanup {
          let before = run pathReaches(points, interval.from, point)
          if before && run pathReaches(points, point, interval.to) {
            if present == SourceTruth.True && !control.unresolved { return CallerSource.Actual }
            result = CallerSource.Unknown
          }
        } else {
          if present == SourceTruth.True { return CallerSource.Actual }
          result = CallerSource.Unknown
        }
      }
    }
    at = at + usize.ONE
  }
  return result
}

// Bind the accepted region solver to actual graph-backed loan requirements and validity.
// Every loan is checked against its own availability before release or region intersection;
// universal domains keep their universal requirements and do not gain a finite-source proof.
effect fn sourceRegionPoints<'input, 'body, 'proof>(input: &SourceRegionInput<'input, 'body>,
  sources: &RegionSources<'proof>, owner: &DeclarationId, region: &Shared<Lifetime>,
  regions: &mut List<RegionPoints>, premises: &[RegionBound], symbolic: &mut List<SymbolicRegion>,
  flow: &mut IntervalFlow, storage: &mut RegionAvailability) -> usize ! OutOfMemoryError ? &mut Allocator {
  if input.control.unresolved || input.events.unresolved
    || SourceGraph.Graph.truth(input.graph, input.viewMissing) != SourceTruth.False { return usize.MAX }
  let existing = List<RegionPoints>.asSlice(&regions.*)
  let mut at = usize.ZERO
  while at < existing.length {
    if Lifetime.equalsShared(&existing[at].region, region) { return at }
    at = at + usize.ONE
  }
  let domain = regionDomain(region, owner, sources.supplied)
  if domain == RegionDomain.Unknown { return usize.MAX }
  let mut selected = List<usize>.make()
  if domain == RegionDomain.Local {
    at = usize.ZERO
    while at < sources.loans.length {
      let activity = regionLoanActivity(sources, at)
      if activity == SourceTruth.False {
        at = at + usize.ONE
        continue
      }
      if regionsCarry(List<Shared<Lifetime>>.asSlice(&sources.loans[at].regions), region, owner, sources.supplied) {
        if activity != SourceTruth.True || !provable(sources.loans[at].precision) { return usize.MAX }
        run List<usize>.append(&mut selected, at)
      }
      at = at + usize.ONE
    }
    if List<usize>.length(&selected) == usize.ZERO
      && !proofContains(List<Shared<Lifetime>>.asSlice(&storage.choices), region) { return usize.MAX }
  }
  let pointCount = List<Point>.length(&input.control.points)
  let words = (pointCount + 63) / 64
  let mut required = List<u64>.make()
  let mut available = List<u64>.make()
  let mut incoming = List<u64>.make()
  at = usize.ZERO
  while at < words {
    let mut initial: u64 = 0
    if domain == RegionDomain.Universal { initial = u64.bitNot(0) }
    run List<u64>.append(&mut required, initial)
    run List<u64>.append(&mut available, u64.bitNot(0))
    run List<u64>.append(&mut incoming, 0)
    at = at + usize.ONE
  }
  let chosen = List<usize>.asSlice(&selected)
  at = usize.ZERO
  while at < chosen.length {
    let index = chosen[at]
    let loan = &sources.loans[index]
    if loan.created >= pointCount { return usize.MAX }
    let occupancy = run sourceLoanOccupancy(input.graph, input.storage, index)
    let needs = run sourceLoanNeeds(input.graph, input.control, input.storage, &occupancy, input.intervals,
      input.views, loan.created, &mut flow.*)
    let carriers = run sourceAvailabilityProjection(input.graph, input.storage, &occupancy, input.intervals, input.views)
    let universalBound = run loanParentBoundProved(sources, owner, loan, premises, &mut symbolic.*)
    let finiteBound = !loan.local && proofContains(List<Shared<Lifetime>>.asSlice(&storage.finiteParents), region)
    let initialized = run sourceInitializedOwnedRegion(input.control, input.owners,
      SourceGraph.Graph.preparation(input.graph).body.locals.length, loan, region, &mut storage.*, &mut flow.*)
    let own = run sourceLoanAvailable(input.control, input.events, &carriers, &occupancy, loan,
      universalBound || finiteBound, initialized, &storage.*)
    if needs.unresolved || own.unresolved { return usize.MAX }
    let ownWords = List<u64>.asSlice(&own.points)
    let neededWords = List<u64>.asSlice(&needs.required)
    if !regionSourceFits(neededWords, ownWords) { return usize.MAX }
    let released = run sourceReleasedLoanPoints(input.graph, input.control, &occupancy, &needs,
      input.intervals, input.views, sources.loans, ownWords)
    mergeRegionSource(&mut required, &mut available, neededWords, ownWords, List<u64>.asSlice(&released))
    at = at + usize.ONE
  }
  let index = List<RegionPoints>.length(&regions.*)
  run List<RegionPoints>.append(&mut regions.*, RegionPoints {region: Shared<Lifetime>.clone(region),
    required: move required, available: move available, incoming: move incoming})
  return index
}

// Complete retained-region drivers for the graph projection. These install the original
// finite parent edges and reuse the accepted universal gates and requirement worklist.
effect fn sourceFiniteCrossingsProved<'input, 'body, 'proof>(input: &SourceRegionInput<'input, 'body>,
  sources: &RegionSources<'proof>, owner: &DeclarationId, premises: &[RegionBound], symbolic: &mut List<SymbolicRegion>,
  regions: &mut List<RegionPoints>, edges: &mut List<RegionEdge>, flow: &mut IntervalFlow, storage: &mut RegionAvailability) -> bool
! OutOfMemoryError ? &mut Allocator {
  let roots = match move run finiteCrossingRoots(sources, owner, premises, &mut symbolic.*) {
    Option<List<SymbolicRoot>>.Some {value} => move value
    _ => { return false }
  }
  let mut at = usize.ZERO
  let entries = List<SymbolicRoot>.asSlice(&roots)
  // Record only the complete, grounded parent graph. Every edge is installed below before
  // solving; these finite facts never enter the universal-source cache.
  at = usize.ZERO
  while at < entries.length {
    run List<Shared<Lifetime>>.append(&mut storage.finiteParents, Shared<Lifetime>.clone(&entries[at].region))
    at = at + usize.ONE
  }
  let mut indices = List<usize>.make()
  at = usize.ZERO
  while at < entries.length {
    let index = run sourceRegionPoints(input, sources, owner, &entries[at].region,
      &mut regions.*, premises, &mut symbolic.*, &mut flow.*, &mut storage.*)
    if index == usize.MAX { return false }
    run List<usize>.append(&mut indices, index)
    at = at + usize.ONE
  }
  return run installFiniteParentEdges(entries, List<usize>.asSlice(&indices), &mut regions.*, &mut edges.*)
}

effect fn sourceLocalRelationsProved<'input, 'body, 'proof>(input: &SourceRegionInput<'input, 'body>,
  sources: &RegionSources<'proof>, owner: &DeclarationId, obligations: &[SafetyObligation],
  premises: &[RegionBound], symbolic: &mut List<SymbolicRegion>, finiteCrossings: bool) -> bool
! OutOfMemoryError ? &mut Allocator {
  let loans = sources.loans
  let mut at = usize.ZERO
  while at < loans.length {
    let activity = regionLoanActivity(sources, at)
    if activity == SourceTruth.Undefined || (activity == SourceTruth.True && !provable(loans[at].precision)) { return false }
    at = at + usize.ONE
  }
  let mut regions = List<RegionPoints>.make()
  let mut edges = List<RegionEdge>.make()
  let mut flow = emptyIntervalFlow()
  let mut storage = emptyRegionAvailability()
  if !run recordRegionChoices(owner, obligations, &mut storage) { return false }
  if finiteCrossings && !run sourceFiniteCrossingsProved(input, sources, owner, premises, &mut symbolic.*,
    &mut regions, &mut edges, &mut flow, &mut storage) { return false }
  at = usize.ZERO
  while at < obligations.length {
    match &obligations[at] {
      SafetyObligation.RegionRelation {offered, wanted, inferredStatic, ..} => {
        if let Option<Shared<Lifetime>>.Some {..} = &inferredStatic { return false }
        // A meet offers a lifetime only while every constituent offers it. Decompose only
        // this offered side; every constituent still needs its own provenance and finite proof.
        let count = Lifetime.atomCount(&offered)
        if count == usize.ZERO { return false }
        let mut atom = usize.ZERO
        while atom < count {
          let member = Lifetime.atomAt(&offered, atom)
          let step = run regionRelationStep(sources, owner, &member, &wanted, count, premises, &mut symbolic.*)
          if step == RegionRelationStep.Unproved { return false }
          if step == RegionRelationStep.Finite {
            let source = run sourceRegionPoints(input, sources, owner, &wanted, &mut regions, premises, &mut symbolic.*, &mut flow, &mut storage)
            let target = run sourceRegionPoints(input, sources, owner, &member, &mut regions, premises, &mut symbolic.*, &mut flow, &mut storage)
            if source == usize.MAX || target == usize.MAX { return false }
            run List<RegionEdge>.append(&mut edges, RegionEdge {shorter: source, longer: target})
          }
          atom = atom + usize.ONE
        }
      }
      SafetyObligation.Contents {origin, subject, region} => {
        if !finiteCaptureContents(owner, origin, &subject, &region) { return false }
      }
      SafetyObligation.UnprovedImpliedBound => { return false }
      _ => ()
    }
    at = at + usize.ONE
  }
  return run solveRegionRequirements(&mut regions, List<RegionEdge>.asSlice(&edges))
}

// Operation applicability is an ownership effect on the existing CFG. It is emitted into
// the same rule program as source presence; no graph or reaching-definition pass is rebuilt.
// A subsequent replacement cannot undo a retention that already observed a real source.
effect fn sourceOperationReach(control: &SourceControl.Reaching, point: usize, rules: &mut SourceProgram)
  -> SourceOperationReach ! OutOfMemoryError ? &mut Allocator {
  let points = List<SourceControl.Point>.asSlice(&control.points)
  if point >= points.length { return CompilerBug.panic(b"caller retention has no actual operation point") }
  let mut reached = List<SourceAtom>.make()
  let mut at = usize.ZERO
  while at < points.length {
    run List<SourceAtom>.append(&mut reached, SourceProgram.atom(&mut rules.*))
    at = at + usize.ONE
  }
  let values = List<SourceAtom>.asSlice(&reached)
  let empty = List<SourceAtom>.make()
  let none = List<SourceAtom>.asSlice(&empty)
  let seed: [SourceAtom; 1] = [points[point].reachable]
  run SourceProgram.rule(&mut rules.*, values[point], &seed, none)
  let edges = List<SourceControl.Edge>.asSlice(&control.edges)
  at = usize.ZERO
  while at < edges.length {
    let edge = edges[at]
    let traversed: [SourceAtom; 3] = [values[edge.from.index], edge.active, points[edge.to.index].reachable]
    run SourceProgram.rule(&mut rules.*, values[edge.to.index], &traversed, none)
    at = at + usize.ONE
  }
  return SourceOperationReach {point: point, at: move reached}
}

effect fn sourceViewExtents(extents: &[SourceViewExtent]) -> List<SourceViewExtent>
! OutOfMemoryError ? &mut Allocator {
  let mut copied = List<SourceViewExtent>.make()
  let mut at = usize.ZERO
  while at < extents.length { run List<SourceViewExtent>.append(&mut copied, extents[at]) at = at + usize.ONE }
  return move copied
}

// Capture the genuine loan sources of a rvalue descriptor at the original subject use.
// A returned-reference lifetime route is not an address witness, and no owned subject,
// reference acquisition or storage definition is created for this hold.
effect fn sourceViewHolds<'body>(builder: &mut SourceGraph.Builder<'body>, views: &[SourceMatchView],
  loanCount: usize, paths: &mut List<List<Step>>) -> SourceViewHolds ! OutOfMemoryError ? &mut Allocator {
  let mut held = List<SourceViewHold>.make()
  let mut missing = List<SourceAtom>.make()
  let empty = List<SourceAtom>.make()
  let none = List<SourceAtom>.asSlice(&empty)
  let mut at = usize.ZERO
  while at < views.length {
    let view = &views[at]
    let points = List<SourceControl.Point>.asSlice(&builder.reaching.points)
    if view.point.index >= points.length { return CompilerBug.panic(b"match view hold has no actual use point") }
    let active = points[view.point.index].reachable
    match &view.origin {
      SourceViewOrigin.Acquired {loan} => {
        if loan >= loanCount { return CompilerBug.panic(b"match view names an undeclared acquisition") }
        run List<SourceViewHold>.append(&mut held, SourceViewHold {loan: loan, source: view.source,
          scope: view.scope, point: view.point, active: active,
          extents: run sourceViewExtents(List<SourceViewExtent>.asSlice(&view.extents))})
      }
      SourceViewOrigin.Carried {operand} => {
        let operands: [SourceOperand; 1] = [operand]
        let observed = run sourceObserve(&mut builder.*, &operands, SourceGraph.ValuePhase.Output, &mut paths.*, loanCount)
        let unknown: [SourceAtom; 2] = [active, observed.unknown]
        run List<SourceAtom>.append(&mut missing, run SourcePolicy.conjunction(&mut builder.rules, &unknown, none))
        let positions = List<SourceCarryPosition>.asSlice(&observed.positions)
        let mut position = usize.ZERO
        while position < positions.length {
          let loan = positions[position].loan
          let mut prior = usize.ZERO
          while prior < position && positions[prior].loan != loan { prior = prior + usize.ONE }
          if prior == position {
            let mut present = List<SourceAtom>.make()
            let mut each = position
            while each < positions.length {
              if positions[each].loan == loan {
                let histories = List<SourceCarryCase>.asSlice(&positions[each].cases)
                if histories.length == usize.ZERO {
                  let gap: [SourceAtom; 2] = [active, positions[each].quality.present]
                  run List<SourceAtom>.append(&mut missing, run SourcePolicy.conjunction(&mut builder.rules, &gap, none))
                }
                let mut history = usize.ZERO
                while history < histories.length {
                  let evidence = run sourceCallerEvidence(&mut builder.*, sourceEffectSource(&positions[each], &histories[history]), active)
                  run List<SourceAtom>.append(&mut present, evidence.present)
                  run List<SourceAtom>.append(&mut missing, evidence.missing)
                  history = history + usize.ONE
                }
              }
              each = each + usize.ONE
            }
            run List<SourceViewHold>.append(&mut held, SourceViewHold {loan: loan, source: view.source,
              scope: view.scope, point: view.point,
              active: run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&present)),
              extents: run sourceViewExtents(List<SourceViewExtent>.asSlice(&view.extents))})
          }
          position = position + usize.ONE
        }
      }
    }
    at = at + usize.ONE
  }
  return SourceViewHolds {holds: move held,
    missing: run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&missing))}
}

// Match-view liveness is one ordinary backwards use equation on the existing Flow. Its
// bit names the real view loan, never a synthetic storage definition. Emitting the equation
// into the same Program preserves per-point Undefined evidence until the sole graph solve.
effect fn sourceViewProjection(control: &SourceControl.Reaching, views: &[SourceViewHold],
  events: &[Event], exits: &[SourceVisit.ScopeExit], rules: &mut SourceProgram)
  -> List<SourceViewProjection> ! OutOfMemoryError ? &mut Allocator {
  let points = List<SourceControl.Point>.asSlice(&control.points)
  let edges = List<SourceControl.Edge>.asSlice(&control.edges)
  let empty = List<SourceAtom>.make()
  let none = List<SourceAtom>.asSlice(&empty)
  let mut projected = List<SourceViewProjection>.make()
  let mut view = usize.ZERO
  while view < views.length {
    let actual = &views[view]
    let mut prior = usize.ZERO
    while prior < view {
      if views[prior].loan == actual.loan && views[prior].source.index == actual.source.index
        && views[prior].point.index == actual.point.index { return CompilerBug.panic(b"view loan requirements were projected twice") }
      prior = prior + usize.ONE
    }
    if actual.point.index >= points.length { return CompilerBug.panic(b"view loan has no actual acquisition point") }
    let mut before = List<SourceAtom>.make()
    let mut after = List<SourceAtom>.make()
    let mut live = List<SourceAtom>.make()
    let mut ends = List<SourceAtom>.make()
    let mut required = List<SourceAtom>.make()
    let mut arriving = List<SourceAtom>.make()
    let mut occupied = List<SourceAtom>.make()
    let mut survives = List<SourceAtom>.make()
    let mut released = List<SourceAtom>.make()
    let mut at = usize.ZERO
    while at < points.length {
      run List<SourceAtom>.append(&mut before, SourceProgram.atom(&mut rules.*))
      run List<SourceAtom>.append(&mut after, SourceProgram.atom(&mut rules.*))
      run List<SourceAtom>.append(&mut live, SourceProgram.atom(&mut rules.*))
      run List<SourceAtom>.append(&mut ends, SourceProgram.atom(&mut rules.*))
      run List<SourceAtom>.append(&mut required, SourceProgram.atom(&mut rules.*))
      run List<SourceAtom>.append(&mut arriving, SourceProgram.atom(&mut rules.*))
      run List<SourceAtom>.append(&mut occupied, SourceProgram.atom(&mut rules.*))
      run List<SourceAtom>.append(&mut survives, SourceProgram.atom(&mut rules.*))
      run List<SourceAtom>.append(&mut released, SourceProgram.atom(&mut rules.*))
      at = at + usize.ONE
    }
    let ins = List<SourceAtom>.asSlice(&before)
    let outs = List<SourceAtom>.asSlice(&after)
    let active = actual.active
    let acquired = run sourceOperationReach(control, actual.point.index, &mut rules.*)
    let reaches = List<SourceAtom>.asSlice(&acquired.at)
    at = usize.ZERO
    while at < events.length {
      let event = &events[at]
      if listsIndex(List<usize>.asSlice(&event.binders), actual.source.index) {
        if event.point >= points.length { return CompilerBug.panic(b"view binding use has no actual event point") }
        let used: [SourceAtom; 2] = [active, points[event.point].reachable]
        run SourceProgram.rule(&mut rules.*, ins[event.point], &used, none)
      }
      at = at + usize.ONE
    }
    at = usize.ZERO
    while at < points.length {
      let mut killed = at == actual.point.index
      let mut exited = false
      let mut exit = usize.ZERO
      while exit < exits.length {
        if exits[exit].scope.index == actual.scope.index && exits[exit].point.index == at {
          killed = true
          exited = true
        }
        exit = exit + usize.ONE
      }
      // A real view retains its source until its actual scope exits, independently of
      // whether a binding is read again. These are view lifetime equations in the same
      // Program, not extra storage definitions or a second reaching relation.
      let arriving: [SourceAtom; 2] = [List<SourceAtom>.asSlice(&arriving)[at], points[at].reachable]
      if at != actual.point.index {
        run SourceProgram.rule(&mut rules.*, List<SourceAtom>.asSlice(&occupied)[at], &arriving, none)
        if exited {
          run SourceProgram.rule(&mut rules.*, List<SourceAtom>.asSlice(&released)[at], &arriving, none)
        } else {
          run SourceProgram.rule(&mut rules.*, List<SourceAtom>.asSlice(&survives)[at], &arriving, none)
        }
      }
      if !killed {
        let onward: [SourceAtom; 1] = [outs[at]]
        run SourceProgram.rule(&mut rules.*, ins[at], &onward, none)
      }
      let held: [SourceAtom; 4] = [active, outs[at], reaches[at], points[at].reachable]
      run SourceProgram.rule(&mut rules.*, List<SourceAtom>.asSlice(&live)[at], &held, none)
      run SourceProgram.rule(&mut rules.*, List<SourceAtom>.asSlice(&ends)[at], &held, none)
      let needed: [SourceAtom; 4] = [active, ins[at], reaches[at], points[at].reachable]
      run SourceProgram.rule(&mut rules.*, List<SourceAtom>.asSlice(&required)[at], &needed, none)
      run SourceProgram.rule(&mut rules.*, List<SourceAtom>.asSlice(&required)[at], &held, none)
      at = at + usize.ONE
    }
    let created: [SourceAtom; 1] = [active]
    run SourceProgram.rule(&mut rules.*, List<SourceAtom>.asSlice(&required)[actual.point.index], &created, none)
    run SourceProgram.rule(&mut rules.*, List<SourceAtom>.asSlice(&occupied)[actual.point.index], &created, none)
    run SourceProgram.rule(&mut rules.*, List<SourceAtom>.asSlice(&survives)[actual.point.index], &created, none)
    at = usize.ZERO
    while at < edges.length {
      let edge = edges[at]
      let next: [SourceAtom; 3] = [ins[edge.to.index], edge.active, points[edge.from.index].reachable]
      run SourceProgram.rule(&mut rules.*, outs[edge.from.index], &next, none)
      let carried: [SourceAtom; 3] = [List<SourceAtom>.asSlice(&survives)[edge.from.index],
        edge.active, points[edge.from.index].reachable]
      run SourceProgram.rule(&mut rules.*, List<SourceAtom>.asSlice(&arriving)[edge.to.index], &carried, none)
      at = at + usize.ONE
    }
    let extents = List<SourceViewExtent>.asSlice(&actual.extents)
    let mut extent = usize.ZERO
    while extent < extents.length {
      let interval = extents[extent]
      if interval.from.index >= points.length || interval.to.index >= points.length {
        return CompilerBug.panic(b"view lifetime extent lost its actual arm or scope endpoint")
      }
      let started = run sourceOperationReach(control, interval.from.index, &mut rules.*)
      let forward = List<SourceAtom>.asSlice(&started.at)
      let reverse = run sourceEndpointReach(control, interval.to.index, &mut rules.*)
      let backward = List<SourceAtom>.asSlice(&reverse)
      at = interval.from.index
      while at <= interval.to.index {
        let needed: [SourceAtom; 4] = [active, forward[at], backward[at], points[at].reachable]
        run SourceProgram.rule(&mut rules.*, List<SourceAtom>.asSlice(&required)[at], &needed, none)
        if interval.from.index < at && at < interval.to.index {
          // Ordinary accesses retain the accepted strict interval. An owner end additionally
          // owes both actual paths, as flightEnds does; an unreachable completion is no end.
          let ordinary: [SourceAtom; 3] = [active, forward[at], points[at].reachable]
          run SourceProgram.rule(&mut rules.*, List<SourceAtom>.asSlice(&live)[at], &ordinary, none)
          run SourceProgram.rule(&mut rules.*, List<SourceAtom>.asSlice(&ends)[at], &needed, none)
        }
        at = at + usize.ONE
      }
      extent = extent + usize.ONE
    }
    run List<SourceViewProjection>.append(&mut projected, SourceViewProjection {
      loan: actual.loan, live: move live, ends: move ends, required: move required,
      occupied: move occupied, survives: move survives, released: move released})
    view = view + usize.ONE
  }
  return move projected
}

// The symbolic counterpart of intervalEndpoint, using only the retained Flow's edges and
// rule atoms. No new CFG, reaching definitions or additional solve is constructed here.
effect fn sourceEndpointReach(control: &SourceControl.Reaching, endpoint: usize, rules: &mut SourceProgram)
  -> List<SourceAtom> ! OutOfMemoryError ? &mut Allocator {
  let points = List<SourceControl.Point>.asSlice(&control.points)
  if endpoint >= points.length { return CompilerBug.panic(b"view interval has no actual endpoint") }
  let mut reached = List<SourceAtom>.make()
  let mut at = usize.ZERO
  while at < points.length {
    run List<SourceAtom>.append(&mut reached, SourceProgram.atom(&mut rules.*))
    at = at + usize.ONE
  }
  let values = List<SourceAtom>.asSlice(&reached)
  let empty = List<SourceAtom>.make()
  let none = List<SourceAtom>.asSlice(&empty)
  let seed: [SourceAtom; 1] = [points[endpoint].reachable]
  run SourceProgram.rule(&mut rules.*, values[endpoint], &seed, none)
  let edges = List<SourceControl.Edge>.asSlice(&control.edges)
  at = usize.ZERO
  while at < edges.length {
    let edge = edges[at]
    let previous: [SourceAtom; 3] = [values[edge.to.index], edge.active, points[edge.from.index].reachable]
    run SourceProgram.rule(&mut rules.*, values[edge.from.index], &previous, none)
    at = at + usize.ONE
  }
  return move reached
}

fn sourceViewAt<'body>(graph: &SourceGraph.Graph<'body>, views: &[SourceViewProjection],
  loan: usize, point: usize, storageEnd: bool) -> CallerSource {
  let mut result = CallerSource.Absent
  let mut at = usize.ZERO
  while at < views.length {
    if views[at].loan == loan {
      let mut states = List<SourceAtom>.asSlice(&views[at].live)
      if storageEnd { states = List<SourceAtom>.asSlice(&views[at].ends) }
      if point >= states.length { return CompilerBug.panic(b"view liveness queried at a foreign point") }
      let active = SourceGraph.Graph.truth(graph, states[point])
      if active == SourceTruth.True { return CallerSource.Actual }
      if active == SourceTruth.Undefined { result = CallerSource.Unknown }
    }
    at = at + usize.ONE
  }
  return result
}

// Preserve the independent snapshot before adding any caller escape. Aggregate escape is
// for conservative region availability only; event diagnostics use sourceCallerAt below.
effect fn sourceCallerProjection<'body>(builder: &mut SourceGraph.Builder<'body>, independent: &[SourceCallerEvidence],
  effects: &[SourceRetentionEffect]) -> SourceCallerProjection ! OutOfMemoryError ? &mut Allocator {
  let mut snapshot = List<SourceAtom>.make()
  let mut independentMissing = List<SourceAtom>.make()
  let mut missing = List<SourceAtom>.make()
  let mut storing = List<SourceAtom>.make()
  let mut loan = usize.ZERO
  while loan < independent.length {
    let mut reasons = List<SourceAtom>.make()
    let mut gaps = List<SourceAtom>.make()
    run List<SourceAtom>.append(&mut reasons, independent[loan].present)
    run List<SourceAtom>.append(&mut gaps, independent[loan].missing)
    let mut each = usize.ZERO
    while each < effects.length {
      if effects[each].source.loan == loan {
        let evidence = run sourceCallerEvidence(&mut builder.*, effects[each].source, effects[each].independent)
        run List<SourceAtom>.append(&mut reasons, evidence.present)
        run List<SourceAtom>.append(&mut gaps, evidence.missing)
      }
      each = each + usize.ONE
    }
    run List<SourceAtom>.append(&mut snapshot, run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&reasons)))
    let gap = run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&gaps))
    run List<SourceAtom>.append(&mut independentMissing, gap)
    run List<SourceAtom>.append(&mut missing, gap)
    loan = loan + usize.ONE
  }
  let mut retentions = List<SourceCallerRetention>.make()
  let mut operations = List<SourceOperationReach>.make()
  let mut at = usize.ZERO
  while at < effects.length {
    let effect = &effects[at]
    if effect.source.loan >= independent.length { return CompilerBug.panic(b"caller retention names an undeclared loan") }
    let mut operation = usize.ZERO
    while operation < List<SourceOperationReach>.length(&operations)
      && List<SourceOperationReach>.asSlice(&operations)[operation].point != effect.point {
      operation = operation + usize.ONE
    }
    if operation == List<SourceOperationReach>.length(&operations) {
      run List<SourceOperationReach>.append(&mut operations,
        run sourceOperationReach(&builder.reaching, effect.point, &mut builder.rules))
    }
    let evidence = run sourceCallerEvidence(&mut builder.*, effect.source, effect.caller)
    run List<SourceCallerRetention>.append(&mut retentions, SourceCallerRetention {
      source: effect.source, operation: operation, present: evidence.present, missing: evidence.missing})
    run List<SourceAtom>.append(&mut missing, evidence.missing)
    let stored = run sourceCallerEvidence(&mut builder.*, effect.source, effect.storing)
    run List<SourceAtom>.append(&mut storing, stored.present)
    run List<SourceAtom>.append(&mut missing, stored.missing)
    at = at + usize.ONE
  }
  let mut aggregate = List<SourceAtom>.make()
  loan = usize.ZERO
  while loan < independent.length {
    let mut reasons = List<SourceAtom>.make()
    run List<SourceAtom>.append(&mut reasons, List<SourceAtom>.asSlice(&snapshot)[loan])
    run List<SourceAtom>.append(&mut reasons, List<SourceAtom>.asSlice(&independentMissing)[loan])
    let retained = List<SourceCallerRetention>.asSlice(&retentions)
    at = usize.ZERO
    while at < retained.length {
      if retained[at].source.loan == loan {
        run List<SourceAtom>.append(&mut reasons, retained[at].present)
        run List<SourceAtom>.append(&mut reasons, retained[at].missing)
      }
      at = at + usize.ONE
    }
    run List<SourceAtom>.append(&mut aggregate, run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&reasons)))
    loan = loan + usize.ONE
  }
  return SourceCallerProjection {retentions: move retentions, operations: move operations, independent: move snapshot, independentMissing: move independentMissing,
    aggregate: move aggregate, storing: run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&storing)),
    missing: run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&missing))}
}

fn sourceCallerTruth(present: SourceTruth, missing: SourceTruth, reaches: SourceTruth) -> CallerSource {
  if reaches == SourceTruth.False { return CallerSource.Absent }
  if present == SourceTruth.True && reaches == SourceTruth.True { return CallerSource.Actual }
  if present != SourceTruth.False || missing != SourceTruth.False { return CallerSource.Unknown }
  return CallerSource.Absent
}

fn sourceCallerAt<'body>(graph: &SourceGraph.Graph<'body>, projection: &SourceCallerProjection,
  loan: usize, point: usize) -> CallerSource {
  let retentions = List<SourceCallerRetention>.asSlice(&projection.retentions)
  let operations = List<SourceOperationReach>.asSlice(&projection.operations)
  let mut result = CallerSource.Absent
  let mut at = usize.ZERO
  while at < retentions.length {
    let retained = &retentions[at]
    if retained.source.loan == loan {
      if retained.operation >= operations.length { return CallerSource.Unknown }
      let reached = List<SourceAtom>.asSlice(&operations[retained.operation].at)
      if point >= reached.length { return CallerSource.Unknown }
      let selected = sourceCallerTruth(SourceGraph.Graph.truth(graph, retained.present),
        SourceGraph.Graph.truth(graph, retained.missing), SourceGraph.Graph.truth(graph, reached[point]))
      if selected == CallerSource.Actual { return CallerSource.Actual }
      if selected == CallerSource.Unknown { result = CallerSource.Unknown }
    }
    at = at + usize.ONE
  }
  return result
}

// This is a terminal projection of the last immutable P version and ordered input effects.
// No value in it is fed back into an earlier observation or result decision.
struct SourceLoanPolicy {
  quality: SourceQuality
  bound: SourceAtom
  crossed: SourceAtom
  storable: SourceAtom
}

struct SourceLoanEffect {
  loan: usize
  evidence: SourceCallerEvidence
}

struct SourceLoanPolicies {
  loans: List<SourceLoanPolicy>
  unretained: List<SourceLoanEffect>
  callers: SourceCallerProjection
  storing: SourceAtom
  missing: SourceAtom
}

struct SourceSettledLoans {
  loans: List<Loan>
  activity: List<SourceTruth>
  // Kept in actual observation order, including repeated genuine occurrences.
  unretained: List<usize>
  storable: List<usize>
  independent: List<CallerSource>
  storing: SourceTruth
  unresolved: bool
}

// Retain the exact paired source histories before solving. Written/capture escape belongs
// to the independent snapshot; later operation retention is aggregated only by its owner.
effect fn sourceLoanPolicies<'body>(builder: &mut SourceGraph.Builder<'body>, state: &SourcePolicy.LoanState,
  loans: &[Loan], results: &[SourcePositionResult], crossings: &[SourceCrossingEffect],
  written: &[SourceEscapeEffect], captures: &[SourceCaptureEffect], retention: &[SourceRetentionEffect])
  -> SourceLoanPolicies ! OutOfMemoryError ? &mut Allocator {
  let mut check = usize.ZERO
  while check < crossings.length {
    if crossings[check].source.loan >= loans.length { return CompilerBug.panic(b"crossing names an undeclared loan") }
    check = check + usize.ONE
  }
  check = usize.ZERO
  while check < written.length {
    if written[check].source.loan >= loans.length { return CompilerBug.panic(b"written escape names an undeclared loan") }
    check = check + usize.ONE
  }
  check = usize.ZERO
  while check < captures.length {
    if captures[check].source.loan >= loans.length { return CompilerBug.panic(b"capture effect names an undeclared loan") }
    check = check + usize.ONE
  }
  let mut projected = List<SourceLoanPolicy>.make()
  let mut independent = List<SourceCallerEvidence>.make()
  let mut unretained = List<SourceLoanEffect>.make()
  let mut missing = List<SourceAtom>.make()
  let mut storing = List<SourceAtom>.make()
  let empty = List<SourceAtom>.make()
  let none = List<SourceAtom>.asSlice(&empty)
  let mut loan = usize.ZERO
  while loan < loans.length {
    if loans[loan].created >= List<SourceControl.Point>.length(&builder.reaching.points) {
      return CompilerBug.panic(b"terminal policy lost the actual loan acquisition")
    }
    let active = List<SourceControl.Point>.asSlice(&builder.reaching.points)[loans[loan].created].reachable
    let mut bounds = List<SourceAtom>.make()
    let mut crossed = List<SourceAtom>.make()
    let mut escapes = List<SourceAtom>.make()
    let mut escapeGaps = List<SourceAtom>.make()
    let mut storable = List<SourceAtom>.make()
    if loans[loan].bound { run List<SourceAtom>.append(&mut bounds, active) }
    if loans[loan].crossed { run List<SourceAtom>.append(&mut crossed, active) }
    if loans[loan].escapes { run List<SourceAtom>.append(&mut escapes, active) }
    let mut at = usize.ZERO
    while at < results.length {
      if results[at].source.loan == loan {
        let evidence = run sourceCallerEvidence(&mut builder.*, results[at].source, results[at].decision.bound)
        run List<SourceAtom>.append(&mut bounds, evidence.present)
        run List<SourceAtom>.append(&mut missing, evidence.missing)
        run List<SourceAtom>.append(&mut missing, results[at].missing)
      }
      at = at + usize.ONE
    }
    at = usize.ZERO
    while at < crossings.length {
      if crossings[at].source.loan == loan {
        let evidence = run sourceCallerEvidence(&mut builder.*, crossings[at].source, crossings[at].active)
        run List<SourceAtom>.append(&mut crossed, evidence.present)
        run List<SourceAtom>.append(&mut missing, evidence.missing)
      }
      at = at + usize.ONE
    }
    at = usize.ZERO
    while at < written.length {
      if written[at].source.loan == loan {
        let evidence = run sourceCallerEvidence(&mut builder.*, written[at].source, written[at].active)
        run List<SourceAtom>.append(&mut escapes, evidence.present)
        run List<SourceAtom>.append(&mut escapeGaps, evidence.missing)
      }
      at = at + usize.ONE
    }
    at = usize.ZERO
    while at < captures.length {
      if captures[at].source.loan == loan {
        let escape = run sourceCallerEvidence(&mut builder.*, captures[at].source, captures[at].escape)
        let store = run sourceCallerEvidence(&mut builder.*, captures[at].source, captures[at].storing)
        let mayStore = run sourceCallerEvidence(&mut builder.*, captures[at].source, captures[at].storable)
        run List<SourceAtom>.append(&mut escapes, escape.present)
        run List<SourceAtom>.append(&mut escapeGaps, escape.missing)
        run List<SourceAtom>.append(&mut storing, store.present)
        run List<SourceAtom>.append(&mut storable, mayStore.present)
        run List<SourceAtom>.append(&mut missing, store.missing)
        run List<SourceAtom>.append(&mut missing, mayStore.missing)
      }
      at = at + usize.ONE
    }
    let bounds = run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&bounds))
    let crossed = run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&crossed))
    let storable = run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&storable))
    let boundGate: [SourceAtom; 2] = [active, bounds]
    let crossGate: [SourceAtom; 2] = [active, crossed]
    let storeGate: [SourceAtom; 2] = [active, storable]
    run List<SourceLoanPolicy>.append(&mut projected, SourceLoanPolicy {
      quality: SourcePolicy.LoanState.quality(state, loan, active),
      bound: run SourcePolicy.conjunction(&mut builder.rules, &boundGate, none),
      crossed: run SourcePolicy.conjunction(&mut builder.rules, &crossGate, none),
      storable: run SourcePolicy.conjunction(&mut builder.rules, &storeGate, none)})
    run List<SourceCallerEvidence>.append(&mut independent, SourceCallerEvidence {
      present: run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&escapes)),
      missing: run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&escapeGaps))})
    loan = loan + usize.ONE
  }
  let mut at = usize.ZERO
  while at < results.length {
    if results[at].source.loan >= loans.length { return CompilerBug.panic(b"result effect names an undeclared loan") }
    let mut prior = usize.ZERO
    while prior < at && (results[prior].result.index != results[at].result.index || results[prior].position != results[at].position) {
      prior = prior + usize.ONE
    }
    if prior == at {
      // Alternative histories are one actual position. A later genuine position remains a
      // separate entry even when it retains the same loan, value or authored NodeId.
      let mut dropped = List<SourceAtom>.make()
      let mut gaps = List<SourceAtom>.make()
      let mut each = at
      while each < results.length {
        if results[each].result.index == results[at].result.index && results[each].position == results[at].position {
          if results[each].source.loan != results[at].source.loan
            || results[each].source.value.index != results[at].source.value.index
            || results[each].source.leaf.index != results[at].source.leaf.index {
            return CompilerBug.panic(b"terminal result histories cross-paired physical positions")
          }
          let evidence = run sourceCallerEvidence(&mut builder.*, results[each].source, results[each].decision.unretained)
          run List<SourceAtom>.append(&mut dropped, evidence.present)
          run List<SourceAtom>.append(&mut gaps, evidence.missing)
        }
        each = each + usize.ONE
      }
      let evidence = SourceCallerEvidence {
        present: run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&dropped)),
        missing: run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&gaps))}
      run List<SourceLoanEffect>.append(&mut unretained, SourceLoanEffect {loan: results[at].source.loan, evidence: evidence})
      run List<SourceAtom>.append(&mut missing, evidence.missing)
    }
    at = at + usize.ONE
  }
  let callers = run sourceCallerProjection(&mut builder.*, List<SourceCallerEvidence>.asSlice(&independent), retention)
  run List<SourceAtom>.append(&mut storing, callers.storing)
  run List<SourceAtom>.append(&mut missing, callers.missing)
  return SourceLoanPolicies {loans: move projected, unretained: move unretained, callers: move callers,
    storing: run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&storing)),
    missing: run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&missing))}
}

fn sourceSettledPrecision(before: LoanPrecision, stored: SourceTruth, alternatives: SourceTruth) -> LoanPrecision {
  if before == LoanPrecision.Unknown || stored == SourceTruth.Undefined || alternatives == SourceTruth.Undefined {
    return LoanPrecision.Unknown
  }
  let hasStored = before == LoanPrecision.Stored || stored == SourceTruth.True
  let hasAlternatives = before == LoanPrecision.Alternatives || alternatives == SourceTruth.True
  if hasStored && hasAlternatives { return LoanPrecision.Unknown }
  if hasStored { return LoanPrecision.Stored }
  if hasAlternatives { return LoanPrecision.Alternatives }
  return LoanPrecision.Exact
}

// Consume the real loan catalog without compacting or recreating identities. Undefined and
// missing evidence stays separate from conservative availability flags and cannot certify.
effect fn sourceSettleLoans<'body>(graph: &SourceGraph.Graph<'body>, loans: List<Loan>, policies: &SourceLoanPolicies)
  -> SourceSettledLoans ! OutOfMemoryError ? &mut Allocator {
  let activity = run sourceAcquisitionActivity(graph, List<Loan>.asSlice(&loans))
  let mut result = SourceSettledLoans {loans: move loans, activity: move activity,
    unretained: List<usize>.make(), storable: List<usize>.make(), independent: List<CallerSource>.make(),
    storing: SourceGraph.Graph.truth(graph, policies.storing),
    unresolved: SourceGraph.Graph.truth(graph, policies.missing) != SourceTruth.False}
  let projected = List<SourceLoanPolicy>.asSlice(&policies.loans)
  let escapes = List<SourceAtom>.asSlice(&policies.callers.aggregate)
  let independent = List<SourceAtom>.asSlice(&policies.callers.independent)
  let independentMissing = List<SourceAtom>.asSlice(&policies.callers.independentMissing)
  let states = List<SourceTruth>.asSlice(&result.activity)
  if projected.length != states.length || escapes.length != states.length
    || independent.length != states.length || independentMissing.length != states.length {
    return CompilerBug.panic(b"terminal loan policy lost reserved identity order")
  }
  if result.storing == SourceTruth.Undefined { result.unresolved = true }
  let mut at = usize.ZERO
  while at < states.length {
    let active = states[at]
    let independentSource = sourceCallerTruth(SourceGraph.Graph.truth(graph, independent[at]),
      SourceGraph.Graph.truth(graph, independentMissing[at]), active)
    run List<CallerSource>.append(&mut result.independent, independentSource)
    if active != SourceTruth.False {
      let stored = SourceGraph.Graph.truth(graph, projected[at].quality.stored)
      let alternatives = SourceGraph.Graph.truth(graph, projected[at].quality.alternatives)
      let bound = SourceGraph.Graph.truth(graph, projected[at].bound)
      let crossed = SourceGraph.Graph.truth(graph, projected[at].crossed)
      let escape = SourceGraph.Graph.truth(graph, escapes[at])
      let storable = SourceGraph.Graph.truth(graph, projected[at].storable)
      if active == SourceTruth.Undefined || stored == SourceTruth.Undefined || alternatives == SourceTruth.Undefined
        || bound == SourceTruth.Undefined || crossed == SourceTruth.Undefined || escape == SourceTruth.Undefined
        || storable == SourceTruth.Undefined || independentSource == CallerSource.Unknown { result.unresolved = true }
      let mut actual = List<Loan>.asMutSlice(&mut result.loans)
      actual[at].precision = sourceSettledPrecision(actual[at].precision, stored, alternatives)
      // Unknown bound must not suppress an otherwise grounded ownership diagnostic.
      actual[at].bound = bound == SourceTruth.True
      actual[at].crossed = crossed != SourceTruth.False
      actual[at].escapes = escape != SourceTruth.False
      if storable != SourceTruth.False { run List<usize>.append(&mut result.storable, at) }
    }
    at = at + usize.ONE
  }
  let dropped = List<SourceLoanEffect>.asSlice(&policies.unretained)
  at = usize.ZERO
  while at < dropped.length {
    let entry = &dropped[at]
    if entry.loan >= states.length { return CompilerBug.panic(b"unretained result names an undeclared loan") }
    let present = sourceTruthAnd(states[entry.loan], SourceGraph.Graph.truth(graph, entry.evidence.present))
    if present == SourceTruth.True { run List<usize>.append(&mut result.unretained, entry.loan) }
    if present == SourceTruth.Undefined
      || sourceTruthAnd(states[entry.loan], SourceGraph.Graph.truth(graph, entry.evidence.missing)) != SourceTruth.False {
      result.unresolved = true
    }
    at = at + usize.ONE
  }
  return move result
}

struct SourceCleanupEffects {
  intervals: List<SourceIntervalEffect>
  refusal: SourceAtom
  missing: SourceAtom
}

struct SourceCaptureEffect {
  source: SourceEffectSource
  point: usize
  escape: SourceAtom
  storing: SourceAtom
  storable: SourceAtom
}

struct SourceConstructionEffects {
  captures: List<SourceCaptureEffect>
  inherited: BorrowStatus
  active: SourceAtom
}

struct SourceDeferredEffects {
  retention: List<SourceRetentionEffect>
  missing: SourceAtom
}

// Dispatch immediately after this actual argument finishes, before visiting the next
// operand. Taking a batch after all argument policies would observe the wrong loan version.
// The captured callee has no argument-retention judgment, and construction never writes
// any destination that only a future invocation can lend.
effect fn sourceDeferInput<'body>(builder: &mut SourceGraph.Builder<'body>, actual: &SourceVisit.Visit,
  input: usize, acquired: &[SourceInputAcquisition], state: &mut SourcePolicy.LoanState,
  loans: &[Loan], paths: &mut List<List<Step>>) -> SourceDeferredEffects
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let prepared = SourceGraph.Builder.preparation(&builder.*)
  let nodes = prepared.body.nodes
  let owner = prepared.body.owner
  let arguments = match move run shapeOf(nodes, actual.node) {
    Shape.Defer {arguments, ..} => move arguments
    _ => { return CompilerBug.panic(b"deferred input dispatch selected another semantic handler") }
  }
  let inputs = List<SourceVisit.Input>.asSlice(&actual.inputs)
  if input >= inputs.length { return CompilerBug.panic(b"deferred dispatch lost its actual input position") }
  let selected = inputs[input]
  let no = SourceProgram.atom(&mut builder.rules)
  let ordinal = match selected.read {
    Option<PreparedSources.InputRead>.Some {value: PreparedSources.InputRead.Argument {ordinal}} => ordinal
    Option<PreparedSources.InputRead>.Some {value: PreparedSources.InputRead.Receiver} => {
      return SourceDeferredEffects {retention: List<SourceRetentionEffect>.make(), missing: no}
    }
    _ => { return CompilerBug.panic(b"deferred input has no actual operand coordinate") }
  }
  let arguments = List<NodeId>.asSlice(&arguments)
  if ordinal >= arguments.length || arguments[ordinal].index != selected.node.index {
    return CompilerBug.panic(b"deferred argument changed its actual occurrence")
  }
  let observation = run sourceCallInput(&mut builder.*, actual, selected, ordinal, acquired, &mut paths.*, loans.length)
  let active = List<SourceControl.Point>.asSlice(&builder.reaching.points)[selected.usePoint.index].reachable
  let sinks = run operandSinks(nodes, actual.node, arguments, owner)
  let snapshot = run sourceBarrier(&observation, &mut state.*, active, &mut builder.rules)
  let retention = run sourceKeepCarried(&observation, List<SourceQuality>.asSlice(&snapshot), loans,
    List<List<Step>>.asSlice(&paths.*), owner, List<OperandSink>.asSlice(&sinks), ordinal,
    selected.usePoint.index, active, &mut builder.rules)
  let gates: [SourceAtom; 2] = [active, observation.unknown]
  let empty = List<SourceAtom>.make()
  return SourceDeferredEffects {retention: move retention,
    missing: run SourcePolicy.conjunction(&mut builder.rules, &gates, List<SourceAtom>.asSlice(&empty))}
}

// Construction holds captures at their real placement. Its closed-contract classifier is
// used solely for the non-storing exemption: it does not publish invocation caller retention
// or write a destination which a future call might lend.
effect fn sourceConstruct(nodes: &[Node], owner: &DeclarationId, loans: &[Loan], paths: &[List<Step>],
  observation: &SourceObservation, state: &mut SourcePolicy.LoanState, values: &[NodeId], staged: bool,
  holdable: &[CaptureHold], body: BorrowStatus, result: NodeId, point: usize, active: SourceAtom,
  rules: &mut SourceProgram) -> SourceConstructionEffects
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let stores = body != BorrowStatus.Checked
  let hasBase = match &nodes[result.index].kind { NodeKind.Expression {form: Expression.StagedCallable {..}, ..} => true _ => false }
  let closed = match &nodes[result.index].kind {
    NodeKind.Expression {form: Expression.StagedCallable {retention, ..}, ..} => retention.closed
    NodeKind.Expression {form: Expression.Aggregate {section: Option<SectionRetention>.Some {value}, ..}, ..} => value.closed
    _ => false
  }
  let mut sinks = List<OperandSink>.make()
  if staged && closed { sinks = run operandSinks(nodes, result, values, owner) }
  let entries = List<OperandSink>.asSlice(&sinks)
  let snapshot = run sourceBarrier(observation, &mut state.*, active, &mut rules.*)
  let classified = run sourceRetainedSinks(observation, List<SourceQuality>.asSlice(&snapshot), loans, paths,
    owner, entries, usize.MAX, usize.MAX, active, &mut rules.*)
  let decisions = List<SourcePolicy.RetentionOutput>.asSlice(&classified.decisions)
  let mut stored = List<Shared<Lifetime>>.make()
  let mut opaque = false
  if let Option<Shared<Type>>.Some {value} = move expressionType(nodes, result) {
    run Type.callableStoredRegions(&value, &mut stored)
    opaque = run Type.contractNamesTypeParameter(&value)
  }
  let mut at = usize.ZERO
  while at < values.length {
    run storedRegionsOf(nodes, values[at], &mut stored)
    if let Option<Shared<Type>>.Some {value} = move expressionType(nodes, values[at]) {
      if !(hasBase && at == usize.ZERO) && run Type.namesTypeParameter(&value) { opaque = true }
    }
    at = at + usize.ONE
  }
  let universal = universalRegions(&stored, owner)
  let empty = List<SourceAtom>.make()
  let none = List<SourceAtom>.asSlice(&empty)
  let no = SourceProgram.atom(&mut rules.*)
  let positions = List<SourceCarryPosition>.asSlice(&observation.positions)
  let mut effects = List<SourceCaptureEffect>.make()
  let mut classifiedCase = usize.ZERO
  at = usize.ZERO
  while at < positions.length {
    let position = &positions[at]
    let loan = &loans[position.loan]
    let cases = List<SourceCarryCase>.asSlice(&position.cases)
    let mut each = usize.ZERO
    while each < cases.length {
      let actual = &cases[each]
      let presentInputs: [SourceAtom; 2] = [active, actual.source.quality.present]
      let present = run SourcePolicy.conjunction(&mut rules.*, &presentInputs, none)
      let quality = SourcePolicy.LoanState.quality(&state.*, position.loan, present)
      let mut escaping = List<SourceAtom>.make()
      let mut storing = List<SourceAtom>.make()
      // The original opaque pass precedes the universal/CaptureHold pass. Neither pass
      // changes precision, so both inspect this construction's barrier version.
      if opaque {
        if universalRegions(&loan.regions, owner) { run List<SourceAtom>.append(&mut escaping, present) }
        else if List<Shared<Lifetime>>.length(&loan.regions) == usize.ZERO && !loan.local {
          run List<SourceAtom>.append(&mut storing, present)
        }
      }
      let mut nonstoring = no
      if closed && !(hasBase && position.operand == usize.ZERO) && position.operand < entries.length
        && !entries[position.operand].undescribed && List<SlotSink>.length(&entries[position.operand].slots) != usize.ZERO {
        let held: [SourceAtom; 1] = [present]
        let nonlocal: [SourceAtom; 2] = [decisions[classifiedCase].universal, decisions[classifiedCase].unknown]
        nonstoring = run SourcePolicy.conjunction(&mut rules.*, &held, &nonlocal)
      }
      let mut hold = CaptureHold.Any
      if position.operand < holdable.length { hold = holdable[position.operand] }
      if universal {
        let mut admitted = present
        if !opaque {
          let held: [SourceAtom; 1] = [present]
          let excluded: [SourceAtom; 1] = [nonstoring]
          admitted = run SourcePolicy.conjunction(&mut rules.*, &held, &excluded)
        }
        if universalRegions(&loan.regions, owner) {
          if hold != CaptureHold.Never { run List<SourceAtom>.append(&mut escaping, admitted) }
        } else if hold == CaptureHold.Any {
          if stores || opaque || !typedLocally(&loan.regions, owner) || !ownedStoragePlace(loan) {
            run List<SourceAtom>.append(&mut storing, admitted)
          } else {
            // OwnedStorageLoan accepts Exact and Stored only. The observation's A bit is
            // used here, never a final mutable precision sampled after unrelated cleanup.
            let lost: [SourceAtom; 2] = [admitted, quality.alternatives]
            run List<SourceAtom>.append(&mut storing, run SourcePolicy.conjunction(&mut rules.*, &lost, none))
          }
        }
      }
      let mut storable = no
      if stores && hold != CaptureHold.Never { storable = present }
      run List<SourceCaptureEffect>.append(&mut effects, SourceCaptureEffect {
        source: sourceEffectSource(position, actual), point: point,
        escape: run SourcePolicy.disjunction(&mut rules.*, List<SourceAtom>.asSlice(&escaping)),
        storing: run SourcePolicy.disjunction(&mut rules.*, List<SourceAtom>.asSlice(&storing)), storable: storable})
      classifiedCase = classifiedCase + usize.ONE
      each = each + usize.ONE
    }
    at = at + usize.ONE
  }
  return SourceConstructionEffects {captures: move effects, inherited: body, active: active}
}

// Cleanup's read is retained from its actual OwnerExit. The diagnostic cause node can be
// another expression entirely; it never chooses the cleanup type or canonical storage.
effect fn sourceCleanup<'body>(builder: &mut SourceGraph.Builder<'body>, actual: SourceOwnerObservation,
  state: &mut SourcePolicy.LoanState, loans: &[Loan], paths: &mut List<List<Step>>, cleanup: &[LoanCleanup])
  -> SourceCleanupEffects ! OutOfMemoryError ? &mut Allocator {
  if actual.action != SourceVisit.OwnerAction.Cleanup {
    return CompilerBug.panic(b"cleanup dispatch selected an owner use or end")
  }
  let evaluated = SourceGraph.Builder.evaluation(&builder.*, actual.evaluation)
  if evaluated.point.index != actual.point.index || evaluated.role != SourceGraph.EvaluationRole.Cleanup {
    return CompilerBug.panic(b"cleanup dispatch left its actual owner exit")
  }
  let node = match evaluated.site { SourceGraph.EvaluationSite.Node {node} => node
    _ => { return CompilerBug.panic(b"cleanup observation has no actual exit cause") } }
  let active = List<SourceControl.Point>.asSlice(&builder.reaching.points)[actual.point.index].reachable
  let operands: [SourceOperand; 1] = [SourceOperand {node: node, evaluation: actual.evaluation,
    root: actual.storage.endpoint, ordinal: usize.MAX}]
  let observation = run sourceObserve(&mut builder.*, &operands, SourceGraph.ValuePhase.Input, &mut paths.*, loans.length)
  let mut effects = run sourceObserveCleanup(&mut builder.*, &observation, &mut state.*, loans, cleanup,
    actual.descriptor, actual.storage, actual.hidden, actual.point.index, active)
  // A nonobserving destructor has no source demand. An observing cleanup cannot certify
  // missing contents merely because no Borrow happened to be enumerated in the Input.
  if actual.descriptor < cleanup.length {
    let descriptor = &cleanup[actual.descriptor]
    if descriptor.unknown || List<Shared<Lifetime>>.length(&descriptor.regions) != usize.ZERO {
      let empty = List<SourceAtom>.make()
      let gates: [SourceAtom; 2] = [active, observation.unknown]
      let missing: [SourceAtom; 2] = [effects.missing,
        run SourcePolicy.conjunction(&mut builder.rules, &gates, List<SourceAtom>.asSlice(&empty))]
      effects.missing = run SourcePolicy.disjunction(&mut builder.rules, &missing)
    }
  }
  return move effects
}

// Cleanup observes the source graph's actual read of initialized storage at this exit. It
// never scans definitions created at unrelated points or uses a Loan ID as an owner witness.
// The caller separately records the original loop-cleanup marker and refusal frontier.
effect fn sourceObserveCleanup<'body>(builder: &mut SourceGraph.Builder<'body>, observation: &SourceObservation,
  state: &mut SourcePolicy.LoanState, loans: &[Loan], cleanup: &[LoanCleanup], holder: usize,
  storage: SourceGraph.Storage, hidden: bool, point: usize, active: SourceAtom) -> SourceCleanupEffects
! OutOfMemoryError ? &mut Allocator {
  let refusal = SourceProgram.atom(&mut builder.rules)
  let mut effects = SourceCleanupEffects {intervals: List<SourceIntervalEffect>.make(), refusal: refusal,
    missing: SourceProgram.atom(&mut builder.rules)}
  if holder >= cleanup.length { return move effects }
  let descriptor = &cleanup[holder]
  let observed = List<Shared<Lifetime>>.asSlice(&descriptor.regions)
  if !descriptor.unknown && observed.length == usize.ZERO { return move effects }
  let empty = List<SourceAtom>.make()
  let none = List<SourceAtom>.asSlice(&empty)
  let yes = run sourceBoolean(&mut builder.rules, true)
  let everything = run sourceBoolean(&mut builder.rules, descriptor.unknown && hidden)
  let components = run sourceComponents(SourceGraph.Builder.preparation(&builder.*), storage.endpoint)
  let owned = List<PreparedSources.EndpointId>.asSlice(&components)
  let positions = List<SourceCarryPosition>.asSlice(&observation.positions)
  // The barrier is common to all real definitions observed at this exit. Alternative paired
  // histories do not sequentially contaminate one another's incoming precision version.
  drop run sourceBarrier(observation, &mut state.*, active, &mut builder.rules)
  let mut at = usize.ZERO
  while at < positions.length {
    let position = &positions[at]
    let named = List<Shared<Lifetime>>.asSlice(&loans[position.loan].regions)
    let namedEmpty = run sourceBoolean(&mut builder.rules, named.length == usize.ZERO)
    let shares = run sourceBoolean(&mut builder.rules, sharesAtom(named, observed))
    let cases = List<SourceCarryCase>.asSlice(&position.cases)
    let mut losses = List<SourcePolicy.Precision>.make()
    let mut each = usize.ZERO
    while each < cases.length {
      let actual = &cases[each]
      let guards: [SourceAtom; 2] = [active, actual.source.quality.present]
      let present = run SourcePolicy.conjunction(&mut builder.rules, &guards, none)
      if descriptor.unknown && !hidden {
        let held: [SourceAtom; 1] = [present]
        run SourceProgram.rule(&mut builder.rules, refusal, &held, none)
      } else {
        let definition = match actual.source.definition {
          Option<SourceControl.DefinitionId>.Some {value} => SourceGraph.Builder.definition(&builder.*, value)
          _ => { return CompilerBug.panic(b"cleanup source has no actual storage definition") }
        }
        let read = match actual.source.read {
          Option<SourceControl.ReadId>.Some {value} => SourceGraph.Builder.read(&builder.*, value)
          _ => { return CompilerBug.panic(b"cleanup source has no paired storage read") }
        }
        let sameOwner = match definition.storage.temporary {
          Option<SourceGraph.EvalId>.Some {value} => match read.storage.temporary {
            Option<SourceGraph.EvalId>.Some {value: other} => value.index == other.index
            _ => false
          }
          _ => match read.storage.temporary { Option<SourceGraph.EvalId>.None => true _ => false }
        }
        let expectedOwner = match storage.temporary {
          Option<SourceGraph.EvalId>.Some {value} => match read.storage.temporary {
            Option<SourceGraph.EvalId>.Some {value: other} => value.index == other.index
            _ => false
          }
          _ => match read.storage.temporary { Option<SourceGraph.EvalId>.None => true _ => false }
        }
        let mut matching = false
        let mut component = usize.ZERO
        while component < owned.length {
          if owned[component].index == read.storage.endpoint.index { matching = true }
          component = component + usize.ONE
        }
        if read.point.index != point || definition.storage.endpoint.index != read.storage.endpoint.index
          || !sameOwner || !expectedOwner || !matching {
          CompilerBug.panic(b"cleanup cross-paired a definition and another storage read")
        }
        let decision = run SourcePolicy.cleanup(&mut builder.rules, &SourcePolicy.CleanupInput {
          observed: present, matchingHolder: yes, everything: everything, namedEmpty: namedEmpty, shares: shares})
        run List<SourceIntervalEffect>.append(&mut effects.intervals, SourceIntervalEffect {
          source: sourceEffectSource(position, actual), from: definition.point.index, to: point,
          cleanup: true, active: decision.interval})
        run List<SourcePolicy.Precision>.append(&mut losses,
          SourcePolicy.Precision {stored: decision.addStored, alternatives: decision.addAlternatives})
      }
      each = each + usize.ONE
    }
    drop run SourcePolicy.LoanState.finishPosition(&mut state.*, &mut builder.rules, position.loan,
      List<SourcePolicy.Precision>.asSlice(&losses))
    at = at + usize.ONE
  }
  return move effects
}

// Hidden owners use one dense identity per actual owner acquisition. A reused typed NodeId
// does not merge its two temporary lifecycles. These roots belong to this projection only.
fn sourceTemporaryRoot<'body>(prepared: &PreparedSources.SourcePreparation<'body>, reservation: &SourceVisit.Reservation,
  evaluation: SourceGraph.EvalId) -> usize {
  let owners = List<SourceVisit.Owner>.asSlice(&reservation.owners)
  let mut at = usize.ZERO
  while at < owners.length {
    let actual = match owners[at].root {
      SourceVisit.OwnerRoot.Temporary {evaluation} => Option<SourceGraph.EvalId>.some(evaluation)
      SourceVisit.OwnerRoot.Subject {evaluation, ..} => Option<SourceGraph.EvalId>.some(evaluation)
      SourceVisit.OwnerRoot.Local {..} => Option<SourceGraph.EvalId>.none()
    }
    if let Option<SourceGraph.EvalId>.Some {value} = actual {
      if value.index == evaluation.index { return prepared.body.locals.length + at }
    }
    at = at + usize.ONE
  }
  return CompilerBug.panic(b"source borrow has no actual temporary owner acquisition")
}

// Follow the recorded operand occurrences through the written projection. This is structural
// identity only; a reference boundary remains in Path and still owes its descriptor proof.
fn sourcePlaceBase<'body>(prepared: &PreparedSources.SourcePreparation<'body>, reservation: &SourceVisit.Reservation,
  input: SourceVisit.Input) -> SourceVisit.Input {
  let mut current = input
  let mut remaining = List<SourceVisit.Visit>.length(&reservation.visits) + usize.ONE
  while remaining > usize.ZERO {
    let projected = match &prepared.body.nodes[current.node.index].kind {
      NodeKind.Expression {form: Expression.Field {value, ..}, ..} => Option<NodeId>.some(value)
      NodeKind.Expression {form: Expression.Index {value, ..}, ..} => Option<NodeId>.some(value)
      NodeKind.Expression {form: Expression.Dereference {value}, ..} => Option<NodeId>.some(value)
      _ => Option<NodeId>.none()
    }
    match projected {
      Option<NodeId>.Some {value} => {
        let actual = SourceVisit.occurrence(reservation, current.evaluation)
        let inputs = List<SourceVisit.Input>.asSlice(&actual.inputs)
        if inputs.length == usize.ZERO || inputs[usize.ZERO].node.index != value.index {
          return CompilerBug.panic(b"source place projection lost its actual operand occurrence")
        }
        current = inputs[usize.ZERO]
      }
      Option<NodeId>.None => { return current }
    }
    remaining = remaining - usize.ONE
  }
  return CompilerBug.panic(b"source place occurrence chain is cyclic")
}

// A producer route and an authored borrow each own exactly one acquisition. PrepareEffect
// shares its Construction routes and is not a second acquisition or physical transfer.
union SourceBorrowKind {
  Authored {record: usize},
  Construction {record: usize, route: usize},
  Invocation {record: usize, route: usize},
  MatchView {record: usize},
}
impl Copy for SourceBorrowKind {}
struct SourceBorrowSite {
  visit: usize
  point: usize
  kind: SourceBorrowKind
}
impl Copy for SourceBorrowSite {}

// Stable ordering is actual acquisition order, before later operands, rather than the order
// in which completed parent expressions happen to be enumerated. Equal points preserve the
// producer's written route order; alternative histories never create extra acquisitions.
effect fn sourceBorrowOrder(sites: &mut List<SourceBorrowSite>, site: SourceBorrowSite) -> ()
! OutOfMemoryError ? &mut Allocator {
  run List<SourceBorrowSite>.append(&mut sites.*, site)
  let mut at = List<SourceBorrowSite>.length(&sites.*) - usize.ONE
  while at > usize.ZERO {
    let all = List<SourceBorrowSite>.asMutSlice(&mut sites.*)
    if all[at - usize.ONE].point <= all[at].point { break }
    let previous = all[at - usize.ONE]
    all[at - usize.ONE] = all[at]
    all[at] = previous
    at = at - usize.ONE
  }
  return ()
}

fn sourceCreatesReference(route: &PreparedSources.InputRoute) -> bool {
  return route.transport == PreparedSources.Transport.BorrowShared
    || route.transport == PreparedSources.Transport.BorrowMutable
}

// Bindings refer to an already evaluated subject. Rebase binder markers through those
// exact inputs so two executions of the same typed match never lend through one another.
effect fn sourcePathBinders<'body>(prepared: &PreparedSources.SourcePreparation<'body>, reservation: &SourceVisit.Reservation,
  input: SourceVisit.Input, binders: &mut List<usize>) -> () ! OutOfMemoryError ? &mut Allocator {
  let base = sourcePlaceBase(prepared, reservation, input)
  if let NodeKind.Expression {form: Expression.PatternBinding {subject, access, ..}, ..} = &prepared.body.nodes[base.node.index].kind {
    if access == BindingAccess.Place || access == BindingAccess.Shared || access == BindingAccess.Exclusive {
      let actual = SourceVisit.occurrence(reservation, base.evaluation)
      let inputs = List<SourceVisit.Input>.asSlice(&actual.inputs)
      if inputs.length != usize.ONE || inputs[0].node.index != subject.index {
        return CompilerBug.panic(b"view binding lost its actual subject input")
      }
      let source = run pathOf(prepared.body.nodes, subject)
      if source.root != usize.MAX { run sourcePathBinders(prepared, reservation, inputs[0], &mut binders.*) }
      if access != BindingAccess.Place { run List<usize>.append(&mut binders.*, inputs[0].evaluation.index) }
    }
  }
  return ()
}

// Rebase the nearest place refinement to its actual subject inspection. Borrowed bindings
// inherit their subject's refinement; only a place binding introduces its own test marker.
effect fn sourcePathRefiner<'body>(prepared: &PreparedSources.SourcePreparation<'body>, reservation: &SourceVisit.Reservation,
  input: SourceVisit.Input) -> usize ! OutOfMemoryError ? &mut Allocator {
  let base = sourcePlaceBase(prepared, reservation, input)
  if let NodeKind.Expression {form: Expression.PatternBinding {subject, access, ..}, ..} = &prepared.body.nodes[base.node.index].kind {
    if access == BindingAccess.Place || access == BindingAccess.Shared || access == BindingAccess.Exclusive {
      let actual = SourceVisit.occurrence(reservation, base.evaluation)
      let inputs = List<SourceVisit.Input>.asSlice(&actual.inputs)
      if inputs.length != usize.ONE || inputs[0].node.index != subject.index {
        return CompilerBug.panic(b"refined binding lost its actual subject occurrence")
      }
      let source = run pathOf(prepared.body.nodes, subject)
      if source.root != usize.MAX {
        if access == BindingAccess.Place { return inputs[0].evaluation.index }
        return run sourcePathRefiner(prepared, reservation, inputs[0])
      }
    }
  }
  return usize.MAX
}

// The test is the actual whole-subject inspection before the first guard/binding. Repeated
// evaluations of one typed subject have distinct markers and cannot refresh each other.
effect fn sourceRefinements<'body>(prepared: &PreparedSources.SourcePreparation<'body>, reservation: &SourceVisit.Reservation)
  -> List<Refinement> ! OutOfMemoryError ? &mut Allocator {
  let mut result = List<Refinement>.make()
  let visits = List<SourceVisit.Visit>.asSlice(&reservation.visits)
  let mut at = usize.ZERO
  while at < visits.length {
    if let NodeKind.Expression {form: Expression.Match {subject, access, ..}, ..} = &prepared.body.nodes[visits[at].node.index].kind {
      if scrutineeOf(&access) == Scrutinee.Place {
        let path = run pathOf(prepared.body.nodes, subject)
        if path.root != usize.MAX {
          let input = sourceAccessInput(&visits[at], usize.ZERO, subject)
          let prior = List<Refinement>.asSlice(&result)
          let mut each = usize.ZERO
          while each < prior.length {
            if prior[each].subject == input.evaluation.index {
              return CompilerBug.panic(b"one actual subject inspection has two refinement tests")
            }
            each = each + usize.ONE
          }
          run List<Refinement>.append(&mut result, Refinement {subject: input.evaluation.index, test: input.usePoint.index})
        }
      }
    }
    at = at + usize.ONE
  }
  return move result
}

// Authored address syntax retains its actual hidden/subject owner occurrence. This does not
// resolve a descriptor to the storage it addresses; referent steps remain explicit.
effect fn sourceAuthoredPath<'body>(prepared: &PreparedSources.SourcePreparation<'body>, reservation: &SourceVisit.Reservation,
  input: SourceVisit.Input) -> Path ! OutOfMemoryError ? &mut Allocator {
  let nodes = prepared.body.nodes
  let mut path = run pathOf(nodes, input.node)
  if path.root == usize.MAX {
    let base = sourcePlaceBase(prepared, reservation, input)
    path = run temporaryPath(nodes, input.node, base.node)
    path.root = sourceTemporaryRoot(prepared, reservation, base.evaluation)
  }
  let base = sourcePlaceBase(prepared, reservation, input)
  if let NodeKind.Expression {form: Expression.PatternBinding {subject, ..}, ..} = &nodes[base.node.index].kind {
    if path.root == subjectRoot(subject) {
      let actual = SourceVisit.occurrence(reservation, base.evaluation)
      let inputs = List<SourceVisit.Input>.asSlice(&actual.inputs)
      if inputs.length != usize.ONE || inputs[0].node.index != subject.index {
        CompilerBug.panic(b"pattern borrow lost its retained subject occurrence")
      }
      path.root = sourceTemporaryRoot(prepared, reservation, inputs[0].evaluation)
    }
  }
  path.binders = List<usize>.make()
  run sourcePathBinders(prepared, reservation, input, &mut path.binders)
  path.refiner = run sourcePathRefiner(prepared, reservation, input)
  return move path
}

// Extends the actual written operand by its producer-selected physical component path. This
// never uses selected/original parameter coordinates to infer the storage being borrowed.
effect fn sourceInputPath<'body>(prepared: &PreparedSources.SourcePreparation<'body>, reservation: &SourceVisit.Reservation,
  input: SourceVisit.Input, endpoint: PreparedSources.EndpointId) -> Path ! OutOfMemoryError ? &mut Allocator {
  let mut path = run sourceAuthoredPath(prepared, reservation, input)
  let endpoints = List<PreparedSources.Endpoint>.asSlice(&prepared.endpoints)
  let mut ancestry = List<PreparedSources.EndpointId>.make()
  let mut current = endpoint
  let mut remaining = endpoints.length
  while remaining > usize.ZERO {
    if current.index >= endpoints.length { CompilerBug.panic(b"producer borrow names an absent source endpoint") }
    match endpoints[current.index].parent {
      Option<PreparedSources.EndpointId>.Some {value} => {
        run List<PreparedSources.EndpointId>.append(&mut ancestry, current)
        current = value
      }
      Option<PreparedSources.EndpointId>.None => { break }
    }
    remaining = remaining - usize.ONE
  }
  if remaining == usize.ZERO { CompilerBug.panic(b"producer borrow component ancestry is cyclic") }
  let authentic = match &endpoints[current.index].root {
    PreparedSources.Root.Node {node, role} => node.index == input.node.index && role == PreparedSources.EndpointRole.Storage
    _ => false
  }
  if !authentic { CompilerBug.panic(b"producer borrow is not based on its actual operand storage") }
  let steps = List<PreparedSources.EndpointId>.asSlice(&ancestry)
  let mut at = steps.length
  while at > usize.ZERO {
    at = at - usize.ONE
    match &endpoints[steps[at].index].selector {
      PreparedSources.Selector.Field {ordinal} => run List<Step>.append(&mut path.steps, fieldStep(ordinal))
      PreparedSources.Selector.Member {declaration, member, payload} => {
        if DeclarationId.kind(&declaration) == OwnerKind.Union {
          run List<Step>.append(&mut path.steps, memberStep(member))
          run List<Step>.append(&mut path.steps, fieldStep(payload))
        } else {
          if payload != usize.ZERO { CompilerBug.panic(b"record source component has a union payload coordinate") }
          run List<Step>.append(&mut path.steps, fieldStep(member))
        }
      }
      PreparedSources.Selector.Variant {ordinal} => run List<Step>.append(&mut path.steps, memberStep(ordinal))
      PreparedSources.Selector.Index {class} => {
        let step = match &class {
          PreparedSources.IndexClass.Exact {index} => elementStep(index)
          PreparedSources.IndexClass.Remainder => anyElement()
        }
        run List<Step>.append(&mut path.steps, step)
      }
      PreparedSources.Selector.Referent => {
        run List<Step>.append(&mut path.steps, referent())
        path.through = true
      }
      _ => { CompilerBug.panic(b"contract/opaque selection cannot authenticate producer borrow storage") }
    }
  }
  return move path
}

// The parent's descriptor chain is actual physical path evidence. A shared boundary stops
// dependence on outer descriptors, exactly as descriptorChain does for a written projection.
effect fn sourceInputParent<'body>(prepared: &PreparedSources.SourcePreparation<'body>, input: SourceVisit.Input,
  endpoint: PreparedSources.EndpointId) -> Option<Shared<Lifetime>> ! OutOfMemoryError ? &mut Allocator {
  let mut chain = List<Shared<Lifetime>>.make()
  run placeDescriptors(prepared.body.nodes, input.node, &mut chain)
  let endpoints = List<PreparedSources.Endpoint>.asSlice(&prepared.endpoints)
  let shapes = List<PreparedSources.Shape>.asSlice(&prepared.shapes)
  let mut ancestry = List<PreparedSources.EndpointId>.make()
  let mut current = endpoint
  let mut remaining = endpoints.length
  while remaining > usize.ZERO {
    match endpoints[current.index].parent {
      Option<PreparedSources.EndpointId>.Some {value} => {
        run List<PreparedSources.EndpointId>.append(&mut ancestry, current)
        current = value
      }
      Option<PreparedSources.EndpointId>.None => { break }
    }
    remaining = remaining - usize.ONE
  }
  if remaining == usize.ZERO { CompilerBug.panic(b"producer descriptor ancestry is cyclic") }
  let steps = List<PreparedSources.EndpointId>.asSlice(&ancestry)
  let mut at = steps.length
  while at > usize.ZERO {
    at = at - usize.ONE
    if let PreparedSources.Selector.Referent = &endpoints[steps[at].index].selector {
      let parent = match endpoints[steps[at].index].parent {
        Option<PreparedSources.EndpointId>.Some {value} => value
        _ => { return CompilerBug.panic(b"producer reference boundary has no actual descriptor") }
      }
      let ty = &shapes[endpoints[parent.index].shape.index].ty
      let shared = Shared<Type>.with<bool>(ty, fn(value: &Type) -> bool {
        return match &value.* { Type.Reference {access, ..} => access == Access.Shared Type.Slice {access, ..} => access == Access.Shared _ => false }
      })
      if shared { chain = List<Shared<Lifetime>>.make() }
      if let Option<Shared<Lifetime>>.Some {value} = move Shared<Type>.with<Option<Shared<Lifetime>>>(ty, loanLifetime) {
        run List<Shared<Lifetime>>.append(&mut chain, move value)
      }
    }
  }
  return run descriptorMeet(List<Shared<Lifetime>>.asSlice(&chain))
}

// The structural visitor has already placed every exit action on the one CFG. End is a
// storage definition as well as an ownership event; Expire limits a loan's validity without
// inventing destruction of storage which lowering still keeps. Cleanup/Use get their own
// policy observation and are not accidentally turned into an additional End.
effect fn sourceOwnerEnds<'body>(prepared: &PreparedSources.SourcePreparation<'body>,
  reservation: &mut SourceVisit.Reservation, ownership: &mut SourceOwnership, active: SourceAtom) -> ()
! OutOfMemoryError ? &mut Allocator {
  let owners = List<SourceVisit.Owner>.asSlice(&reservation.owners)
  let exits = List<SourceVisit.OwnerExit>.asSlice(&reservation.ownerExits)
  let endpoints = List<PreparedSources.Endpoint>.asSlice(&prepared.endpoints)
  let mut at = usize.ZERO
  while at < exits.length {
    let ended = &exits[at]
    {
      if ended.owner.index >= owners.length || ended.cause.index >= prepared.body.nodes.length {
        CompilerBug.panic(b"source owner exit lost its actual lifecycle identity")
      }
      let owner = &owners[ended.owner.index]
      let mut root = usize.MAX
      let mut endpoint = usize.MAX
      let mut temporary = Option<SourceGraph.EvalId>.none()
      let mut each = usize.ZERO
      while each < endpoints.length {
        let whole = match endpoints[each].parent { Option<PreparedSources.EndpointId>.None => true _ => false }
        let matches = match owner.root {
          SourceVisit.OwnerRoot.Local {local} => match &endpoints[each].root {
            PreparedSources.Root.Local {local: actual, role} => local.index == actual.index && role == PreparedSources.EndpointRole.Storage
            _ => false
          }
          SourceVisit.OwnerRoot.Subject {node: subject, ..} => match &endpoints[each].root {
            PreparedSources.Root.Node {node, role} => node.index == subject.index && role == PreparedSources.EndpointRole.Storage
            _ => false
          }
          SourceVisit.OwnerRoot.Temporary {evaluation} => {
            let actual = SourceVisit.occurrence(&reservation.*, evaluation)
            match &endpoints[each].root {
              PreparedSources.Root.Node {node, role} => node.index == actual.node.index && role == PreparedSources.EndpointRole.Storage
              _ => false
            }
          }
        }
        if whole && matches {
          if endpoint != usize.MAX { CompilerBug.panic(b"source owner has duplicate prepared storage roots") }
          endpoint = each
        }
        each = each + usize.ONE
      }
      match owner.root {
        SourceVisit.OwnerRoot.Local {local} => { root = local.index }
        SourceVisit.OwnerRoot.Subject {evaluation, ..} => {
          root = prepared.body.locals.length + ended.owner.index
          temporary = Option<SourceGraph.EvalId>.some(evaluation)
        }
        SourceVisit.OwnerRoot.Temporary {evaluation} => {
          root = prepared.body.locals.length + ended.owner.index
          temporary = Option<SourceGraph.EvalId>.some(evaluation)
        }
      }
      if endpoint == usize.MAX { CompilerBug.panic(b"source owner end has no actual prepared storage") }
      if ended.action == SourceVisit.OwnerAction.Use || ended.action == SourceVisit.OwnerAction.Cleanup {
        let read = match ended.read {
          Option<SourceGraph.EvalId>.Some {value} => value
          _ => { return CompilerBug.panic(b"owner observation has no reserved current-point read") }
        }
        let evaluated = List<SourceGraph.Evaluation>.asSlice(&reservation.skeleton.evaluations)[read.index]
        if evaluated.point.index != ended.point.index || evaluated.role != SourceGraph.EvaluationRole.Cleanup {
          CompilerBug.panic(b"owner observation moved away from its actual exit point")
        }
        let storage = SourceGraph.Storage {endpoint: PreparedSources.EndpointId {index: endpoint}, temporary: temporary}
        drop run SourceGraph.Skeleton.observeStorage(&mut reservation.skeleton, prepared, storage, read)
        let descriptor = match owner.root {
          SourceVisit.OwnerRoot.Local {local} => local.index
          SourceVisit.OwnerRoot.Subject {node, ..} => prepared.body.locals.length + node.index
          SourceVisit.OwnerRoot.Temporary {evaluation} => {
            let actual = SourceVisit.occurrence(&reservation.*, evaluation)
            prepared.body.locals.length + prepared.body.nodes.length + actual.node.index
          }
        }
        run List<SourceOwnerObservation>.append(&mut ownership.observations, SourceOwnerObservation {
          owner: ended.owner, storage: storage, evaluation: read, point: ended.point, action: ended.action,
          descriptor: descriptor, hidden: root >= prepared.body.locals.length})
        at = at + usize.ONE
        continue
      }
      let origin = prepared.body.nodes[ended.cause.index].origin
      let mut kind = Kind.Expire
      if ended.action == SourceVisit.OwnerAction.End {
        kind = Kind.End
        let evaluation = run SourceGraph.Skeleton.evaluate(&mut reservation.skeleton, ended.cause,
          SourceGraph.EvaluationRole.Cleanup, ended.point)
        run SourceGraph.Skeleton.endOwner(&mut reservation.skeleton, endpoints,
          PreparedSources.EndpointId {index: endpoint}, temporary, evaluation, origin, active)
      }
      let event = Event {point: ended.point.index, place: Place {root: root, steps: List<Step>.make()},
        kind: kind, span: origin.location, target: origin.location, loan: usize.MAX, consumesTarget: usize.ZERO,
        refiner: usize.MAX, refinedDepth: usize.ZERO, binders: List<usize>.make()}
      // Preserve the actual event order even though acquisition and lifecycle facts are
      // projected in separate passes. Alternative CFG exits remain distinct events.
      let events = List<Event>.asSlice(&ownership.events)
      let mut position = usize.ZERO
      while position < events.length && events[position].point <= event.point { position = position + usize.ONE }
      run List<Event>.insert(&mut ownership.events, position, move event)
    }
    at = at + usize.ONE
  }
  return ()
}

// Same descriptor boundary as viewedReference, with the actual input occurrence retained.
// Index operands already have their own traversal visits and are never evaluated again.
fn sourceViewedInput<'body>(prepared: &PreparedSources.SourcePreparation<'body>, reservation: &SourceVisit.Reservation,
  subject: SourceVisit.Input) -> SourceVisit.Input {
  let mut current = subject
  let mut remaining = List<SourceVisit.Visit>.length(&reservation.visits) + usize.ONE
  while remaining > usize.ZERO {
    let mut selected = Option<NodeId>.none()
    let mut descriptor = false
    if let NodeKind.Expression {form, ..} = &prepared.body.nodes[current.node.index].kind {
      match &form {
        Expression.Field {value, ..} => { selected = Option<NodeId>.some(value) }
        Expression.Index {value, ..} => {
          selected = Option<NodeId>.some(value)
          descriptor = sliceValue(prepared.body.nodes, value)
        }
        Expression.Dereference {value} => {
          selected = Option<NodeId>.some(value)
          descriptor = true
        }
        _ => ()
      }
    }
    let next = match selected { Option<NodeId>.Some {value} => value _ => { return subject } }
    let actual = SourceVisit.occurrence(reservation, current.evaluation)
    current = sourceAccessInput(actual, usize.ZERO, next)
    if descriptor { return current }
    remaining = remaining - usize.ONE
  }
  return CompilerBug.panic(b"viewed descriptor occurrence chain is cyclic")
}

// MatchView licenses a place acquisition or an observation of an existing rvalue source.
// Neither emits a source-value seed; binding use does not manufacture a descriptor value.
effect fn sourceMatchViewLoan<'body>(prepared: &PreparedSources.SourcePreparation<'body>, reservation: &SourceVisit.Reservation,
  actual: &SourceVisit.Visit, record: usize, ownership: &mut SourceOwnership) -> () ! OutOfMemoryError ? &mut Allocator {
  let views = List<PreparedSources.MatchView>.asSlice(&prepared.matchViews)
  if record >= views.length || views[record].site.index != actual.node.index {
    return CompilerBug.panic(b"match loan has no matching prepared view")
  }
  let view = &views[record]
  let endpoints = List<PreparedSources.Endpoint>.asSlice(&prepared.endpoints)
  let selections = List<PreparedSources.Selection>.asSlice(&prepared.selections)
  if view.source.index >= endpoints.length || view.selection.index >= selections.length {
    return CompilerBug.panic(b"match view names an absent source selection")
  }
  let selected = &selections[view.selection.index]
  let accepts = List<PreparedSources.EndpointId>.asSlice(&selected.accepts)
  if selected.site.index != actual.node.index || selected.root.index != view.source.index
    || accepts.length != usize.ONE || accepts[0].index != view.source.index
    || List<PreparedSources.MapId>.length(&selected.maps) != usize.ZERO {
    return CompilerBug.panic(b"match view is not its exact singleton subject selection")
  }
  if let NodeKind.Expression {form: Expression.Match {subject, access, arms, syntax, ..}, ..} = &prepared.body.nodes[actual.node.index].kind {
    let mode = scrutineeOf(&access)
    if mode != Scrutinee.Shared && mode != Scrutinee.Exclusive {
      return CompilerBug.panic(b"nonborrowed match attempted a view acquisition")
    }
    let authentic = match &endpoints[view.source.index].root {
      PreparedSources.Root.Node {node, role} => node.index == subject.index && role == PreparedSources.EndpointRole.Storage
      _ => false
    }
    if !authentic { return CompilerBug.panic(b"match view is not its original subject storage") }
    if let Option<PreparedSources.EndpointId>.Some {..} = endpoints[view.source.index].parent {
      return CompilerBug.panic(b"match view source is not the original whole subject")
    }
    let input = sourceAccessInput(actual, usize.ZERO, subject)
    let subjects = List<SourceVisit.Subject>.asSlice(&reservation.subjects)
    let mut scoped = usize.MAX
    let mut at = usize.ZERO
    while at < subjects.length {
      if subjects[at].site.index == actual.node.index && subjects[at].source.index == input.evaluation.index {
        if scoped != usize.MAX { return CompilerBug.panic(b"match view has duplicate actual subject occurrences") }
        scoped = at
      }
      at = at + usize.ONE
    }
    if scoped == usize.MAX || subjects[scoped].owned || subjects[scoped].evaluation.index != input.evaluation.index {
      return CompilerBug.panic(b"match view lost its actual borrowed subject")
    }
    let written = run pathOf(prepared.body.nodes, subject)
    let mut origin = Option<SourceViewOrigin>.none()
    if written.root == usize.MAX {
      let viewed = sourceViewedInput(prepared, reservation, input)
      let mut root = Option<PreparedSources.EndpointId>.none()
      at = usize.ZERO
      while at < endpoints.length {
        let matches = match &endpoints[at].root {
          PreparedSources.Root.Node {node, role} => node.index == viewed.node.index && role == PreparedSources.EndpointRole.Value
          _ => false
        }
        let whole = match endpoints[at].parent { Option<PreparedSources.EndpointId>.None => true _ => false }
        if matches && whole {
          if let Option<PreparedSources.EndpointId>.Some {..} = root { return CompilerBug.panic(b"viewed value has duplicate actual roots") }
          root = Option<PreparedSources.EndpointId>.some(PreparedSources.EndpointId {index: at})
        }
        at = at + usize.ONE
      }
      let root = match root { Option<PreparedSources.EndpointId>.Some {value} => value _ => { return CompilerBug.panic(b"viewed reference has no prepared value root") } }
      origin = Option<SourceViewOrigin>.some(SourceViewOrigin.Carried {operand: SourceOperand {
        node: viewed.node, evaluation: viewed.evaluation, root: root, ordinal: usize.MAX}})
    } else {
      let path = run sourceInputPath(prepared, reservation, input, view.source)
      let exclusive = mode == Scrutinee.Exclusive && (syntax != MatchSyntax.Match || armLoanMatchesAccess())
      let parent = run borrowedPlaceLifetime(prepared.body.nodes, subject)
      let span = prepared.body.nodes[subject.index].origin.location
      let loan = List<Loan>.length(&ownership.loans)
      let mut acquired = run loanTyped(prepared.body.owner, &path, exclusive, span,
        Option<Shared<Type>>.none(), move parent, input.usePoint.index)
      acquired.binder = input.evaluation.index
      run List<Loan>.append(&mut ownership.loans, move acquired)
      let mut kind = Kind.SharedBorrow
      if exclusive { kind = Kind.ExclusiveBorrow }
      run List<Event>.append(&mut ownership.events, Event {point: input.usePoint.index,
        place: Place {root: path.root, steps: run copySteps(List<Step>.asSlice(&path.steps))}, kind: kind,
        span: span, target: span, loan: loan, consumesTarget: usize.ZERO, refiner: path.refiner,
        refinedDepth: path.refinedDepth, binders: run copyBinders(List<usize>.asSlice(&path.binders))})
      origin = Option<SourceViewOrigin>.some(SourceViewOrigin.Acquired {loan: loan})
    }
    let mut extents = List<SourceViewExtent>.make()
    let declared = List<MatchArm>.asSlice(&arms)
    let intervals = List<SourceVisit.ArmResult>.asSlice(&actual.armInputs)
    if intervals.length != declared.length { return CompilerBug.panic(b"match view lost its actual arm intervals") }
    at = usize.ZERO
    while at < declared.length {
      let binds = List<NodeId>.length(&declared[at].bindings) != usize.ZERO
      if (syntax == MatchSyntax.Match && armLoanSpansArm()) || (syntax == MatchSyntax.IfLet && binds) {
        run List<SourceViewExtent>.append(&mut extents,
          SourceViewExtent {from: intervals[at].entry, to: intervals[at].completed})
      }
      at = at + usize.ONE
    }
    if syntax == MatchSyntax.Let && declared.length > usize.ZERO && List<NodeId>.length(&declared[0].bindings) != usize.ZERO {
      let exits = List<SourceVisit.ScopeExit>.asSlice(&reservation.exits)
      at = usize.ZERO
      while at < exits.length {
        if exits[at].scope.index == subjects[scoped].scope.index {
          run List<SourceViewExtent>.append(&mut extents, SourceViewExtent {from: input.usePoint, to: exits[at].point})
        }
        at = at + usize.ONE
      }
    }
    let origin = match move origin { Option<SourceViewOrigin>.Some {value} => move value _ => { return CompilerBug.panic(b"match view has no authored or carried source") } }
    run List<SourceMatchView>.append(&mut ownership.views, SourceMatchView {
      origin: move origin, record: record, result: actual.evaluation, source: input.evaluation,
      scope: subjects[scoped].scope, point: input.usePoint, extents: move extents})
    return ()
  }
  return CompilerBug.panic(b"prepared match view belongs to another expression")
}

// Reserve all real reference creations first, without observing any policy-selected source.
// Activating each Construction once also avoids executing future invocation destination writes.
effect fn sourceDeclaredLoans<'body>(prepared: &PreparedSources.SourcePreparation<'body>, reservation: &mut SourceVisit.Reservation)
  -> SourceOwnership ! OutOfMemoryError ? &mut Allocator {
  let mut ownership = SourceOwnership {loans: List<Loan>.make(), events: List<Event>.make(),
    acquisitions: List<SourceInputAcquisition>.make(), views: List<SourceMatchView>.make(),
    observations: List<SourceOwnerObservation>.make()}
  let nodes = prepared.body.nodes
  let authored = List<PreparedSources.Borrow>.asSlice(&prepared.borrows)
  let views = List<PreparedSources.MatchView>.asSlice(&prepared.matchViews)
  let constructions = List<PreparedSources.Construction>.asSlice(&prepared.constructions)
  let operations = List<PreparedSources.Operation>.asSlice(&prepared.operations)
  let maps = List<PreparedSources.SelectionMap>.asSlice(&prepared.maps)
  let endpoints = List<PreparedSources.Endpoint>.asSlice(&prepared.endpoints)
  let shapes = List<PreparedSources.Shape>.asSlice(&prepared.shapes)
  let active = SourceProgram.atom(&mut reservation.skeleton.rules)
  run SourceProgram.fact(&mut reservation.skeleton.rules, active)
  let count = List<SourceVisit.Visit>.length(&reservation.visits)
  let mut sites = List<SourceBorrowSite>.make()
  let mut at = usize.ZERO
  while at < count {
    let actual = &List<SourceVisit.Visit>.asSlice(&reservation.visits)[at]
    if let NodeKind.Expression {form: Expression.Borrow {..}, ..} = &nodes[actual.node.index].kind {
      let mut found = usize.MAX
      let mut each = usize.ZERO
      while each < authored.length {
        if authored[each].site.index == actual.node.index {
          if found != usize.MAX { CompilerBug.panic(b"authored source borrow has duplicate preparation records") }
          found = each
        }
        each = each + usize.ONE
      }
      if found == usize.MAX { CompilerBug.panic(b"authored source borrow has no prepared reference maps") }
      run sourceBorrowOrder(&mut sites, SourceBorrowSite {visit: at, point: actual.execute.index,
        kind: SourceBorrowKind.Authored {record: found}})
    }
    if let NodeKind.Expression {form: Expression.Match {subject, access, ..}, ..} = &nodes[actual.node.index].kind {
      let mode = scrutineeOf(&access)
      if mode == Scrutinee.Shared || mode == Scrutinee.Exclusive {
        let mut record = usize.MAX
        let mut each = usize.ZERO
        while each < views.length {
          if views[each].site.index == actual.node.index {
            if record != usize.MAX { return CompilerBug.panic(b"match view has duplicate prepared acquisitions") }
            record = each
          }
          each = each + usize.ONE
        }
        if record == usize.MAX { return CompilerBug.panic(b"borrowed match has no prepared view authority") }
        let input = sourceAccessInput(actual, usize.ZERO, subject)
        run sourceBorrowOrder(&mut sites, SourceBorrowSite {visit: at, point: input.usePoint.index,
          kind: SourceBorrowKind.MatchView {record: record}})
      }
    }
    let mut each = usize.ZERO
    while each < constructions.length {
      if constructions[each].site.index == actual.node.index {
        let inputs = List<PreparedSources.InputRoute>.asSlice(&constructions[each].inputs)
        let mut route = usize.ZERO
        while route < inputs.length {
          if sourceCreatesReference(&inputs[route]) {
            let input = SourceVisit.routeInput(prepared, actual, &inputs[route])
            run sourceBorrowOrder(&mut sites, SourceBorrowSite {visit: at, point: input.usePoint.index,
              kind: SourceBorrowKind.Construction {record: each, route: route}})
          }
          route = route + usize.ONE
        }
      }
      each = each + usize.ONE
    }
    each = usize.ZERO
    while each < operations.length {
      if operations[each].site.index == actual.node.index && operations[each].phase != PreparedSources.OperationPhase.PrepareEffect {
        let inputs = List<PreparedSources.InputRoute>.asSlice(&operations[each].inputs)
        let mut route = usize.ZERO
        while route < inputs.length {
          if sourceCreatesReference(&inputs[route]) {
            let input = SourceVisit.routeInput(prepared, actual, &inputs[route])
            run sourceBorrowOrder(&mut sites, SourceBorrowSite {visit: at, point: input.usePoint.index,
              kind: SourceBorrowKind.Invocation {record: each, route: route}})
          }
          route = route + usize.ONE
        }
      }
      each = each + usize.ONE
    }
    at = at + usize.ONE
  }
  let ordered = List<SourceBorrowSite>.asSlice(&sites)
  at = usize.ZERO
  while at < ordered.length {
    let site = ordered[at]
    let actual = &List<SourceVisit.Visit>.asSlice(&reservation.visits)[site.visit]
    let evaluation = actual.evaluation
    if let SourceBorrowKind.MatchView {record} = site.kind {
      run sourceMatchViewLoan(prepared, &reservation.*, actual, record, &mut ownership)
      at = at + usize.ONE
      continue
    }
    let mut input = Option<SourceVisit.Input>.none()
    let mut route = Option<&PreparedSources.InputRoute>.none()
    let mut map = PreparedSources.MapId {index: usize.MAX}
    match site.kind {
      SourceBorrowKind.MatchView {..} => { return CompilerBug.panic(b"match view entered descriptor acquisition") }
      SourceBorrowKind.Authored {record} => {
        let operands = List<SourceVisit.Input>.asSlice(&actual.inputs)
        if operands.length != usize.ONE { CompilerBug.panic(b"authored borrow lost its actual operand") }
        input = Option<SourceVisit.Input>.some(operands[usize.ZERO])
        map = authored[record].map
      }
      SourceBorrowKind.Construction {record, route: index} => {
        let selected = &List<PreparedSources.InputRoute>.asSlice(&constructions[record].inputs)[index]
        input = Option<SourceVisit.Input>.some(SourceVisit.routeInput(prepared, actual, selected))
        map = selected.map
        route = Option<&PreparedSources.InputRoute>.some(selected)
      }
      SourceBorrowKind.Invocation {record, route: index} => {
        let selected = &List<PreparedSources.InputRoute>.asSlice(&operations[record].inputs)[index]
        input = Option<SourceVisit.Input>.some(SourceVisit.routeInput(prepared, actual, selected))
        map = selected.map
        route = Option<&PreparedSources.InputRoute>.some(selected)
      }
    }
    let input = match input { Option<SourceVisit.Input>.Some {value} => value _ => { return CompilerBug.panic(b"source acquisition has no actual input") } }
    let physical = &maps[map.index]
    let mut path = run sourceInputPath(prepared, &reservation.*, input, physical.source)
    let mut parent = run sourceInputParent(prepared, input, physical.source)
    if let SourceBorrowKind.Authored {..} = site.kind {
      if sliceValue(nodes, input.node) && sliceValue(nodes, actual.node) {
        run List<Step>.append(&mut path.steps, referent())
        path.through = true
        parent = run descriptorLifetime(nodes, input.node)
      }
    }
    let descriptor = &shapes[endpoints[physical.target.index].shape.index].ty
    let exclusive = Shared<Type>.with<bool>(descriptor, fn(value: &Type) -> bool {
      return match &value.* { Type.Reference {access, ..} => access == Access.Mutable Type.Slice {access, ..} => access == Access.Mutable _ => false }
    })
    let loan = List<Loan>.length(&ownership.loans)
    let span = physical.origin.location
    run List<Loan>.append(&mut ownership.loans, run loanTyped(prepared.body.owner, &path, exclusive, span,
      Option<Shared<Type>>.some(Shared<Type>.clone(descriptor)), move parent, site.point))
    let mut kind = Kind.SharedBorrow
    if exclusive { kind = Kind.ExclusiveBorrow }
    run List<Event>.append(&mut ownership.events, Event {point: site.point,
      place: Place {root: path.root, steps: run copySteps(List<Step>.asSlice(&path.steps))}, kind: kind,
      span: span, target: span, loan: loan, consumesTarget: usize.ZERO, refiner: path.refiner,
      refinedDepth: path.refinedDepth, binders: run copyBinders(List<usize>.asSlice(&path.binders))})
    match site.kind {
      SourceBorrowKind.Authored {record} => {
        drop run SourceGraph.Skeleton.borrow(&mut reservation.skeleton, prepared, &authored[record],
          input.evaluation, evaluation, loan, active)
      }
      _ => {
        let selected = match route { Option<&PreparedSources.InputRoute>.Some {value} => value _ => { return CompilerBug.panic(b"producer reference has no physical input route") } }
        let acquisition = run SourceGraph.Skeleton.evaluate(&mut reservation.skeleton, actual.node,
          SourceGraph.EvaluationRole.Capture, input.usePoint)
        run List<SourceInputAcquisition>.append(&mut ownership.acquisitions,
          SourceInputAcquisition {result: evaluation, input: input.evaluation, acquisition: acquisition, map: selected.map, loan: loan})
        drop run SourceGraph.Skeleton.input(&mut reservation.skeleton, endpoints, maps, selected,
          input.evaluation, evaluation, Option<SourceGraph.ReferenceAcquisition>.some(
            SourceGraph.ReferenceAcquisition {evaluation: acquisition, loan: loan}), active)
      }
    }
    at = at + usize.ONE
  }
  // Existing descriptors are transferred once at their actual producer route. The matching
  // PrepareEffect operation is metadata for later execution, not another placement. Borrow
  // routes were activated above together with their real loan and are never copied again.
  at = usize.ZERO
  while at < count {
    let actual = &List<SourceVisit.Visit>.asSlice(&reservation.visits)[at]
    let mut each = usize.ZERO
    while each < constructions.length {
      if constructions[each].site.index == actual.node.index {
        run sourceValueInputs(prepared, &mut reservation.skeleton, actual,
          List<PreparedSources.InputRoute>.asSlice(&constructions[each].inputs), active)
      }
      each = each + usize.ONE
    }
    each = usize.ZERO
    while each < operations.length {
      if operations[each].site.index == actual.node.index && operations[each].phase != PreparedSources.OperationPhase.PrepareEffect {
        run sourceValueInputs(prepared, &mut reservation.skeleton, actual,
          List<PreparedSources.InputRoute>.asSlice(&operations[each].inputs), active)
      }
      each = each + usize.ONE
    }
    at = at + usize.ONE
  }
  run sourceOwnerEnds(prepared, &mut reservation.*, &mut ownership, active)
  return move ownership
}

effect fn sourceValueInputs<'body>(prepared: &PreparedSources.SourcePreparation<'body>, skeleton: &mut SourceGraph.Skeleton,
  actual: &SourceVisit.Visit, inputs: &[PreparedSources.InputRoute], active: SourceAtom) -> ()
! OutOfMemoryError ? &mut Allocator {
  let endpoints = List<PreparedSources.Endpoint>.asSlice(&prepared.endpoints)
  let maps = List<PreparedSources.SelectionMap>.asSlice(&prepared.maps)
  let mut at = usize.ZERO
  while at < inputs.length {
    if !sourceCreatesReference(&inputs[at]) {
      let input = SourceVisit.routeInput(prepared, actual, &inputs[at])
      drop run SourceGraph.Skeleton.input(&mut skeleton.*, endpoints, maps, &inputs[at], input.evaluation,
        actual.evaluation, Option<SourceGraph.ReferenceAcquisition>.none(), active)
    }
    at = at + usize.ONE
  }
  return ()
}

// Store/return windows are original typing-policy evidence, independent of canonical
// address proofs. Record them at the actual encounter where the accepted handler records
// its goal, before its operands. Finish's sealed/unheld sites use its explicit directive.
// Reservation alone establishes no active escape; settlement still owes point truth and
// the first checker-refusal boundary for these actual occurrences.
effect fn sourceEscapeInventory<'body>(prepared: &PreparedSources.SourcePreparation<'body>, reservation: &SourceVisit.Reservation)
  -> SourceEscapeInventory ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut inventory = SourceEscapeInventory {windows: List<SourceEscapeWindow>.make(),
    sites: List<SourceEscapeSite>.make(), escaping: List<SourceEscapingLocal>.make()}
  let visits = List<SourceVisit.Visit>.asSlice(&reservation.visits)
  let nodes = prepared.body.nodes
  let mut at = usize.ZERO
  while at < visits.length {
    let actual = &visits[at]
    let span = nodes[actual.node.index].origin.location
    let mut written = Option<Shared<Type>>.none()
    let mut holder = usize.MAX
    let mut returned = false
    let shape = run shapeOf(nodes, actual.node)
    match move shape {
      Shape.Binding {local, ..} | Shape.Assignment {local, ..} => {
        written = Option<Shared<Type>>.some(localType(prepared.body.locals, local))
        holder = local
      }
      Shape.PlaceAssignment {target, value} => {
        let path = run pathOf(nodes, target)
        if path.through {
          written = expressionType(nodes, target)
          let source = run pathOf(nodes, movedOperand(nodes, value))
          if source.root < prepared.body.locals.length && !source.through {
            run List<SourceEscapingLocal>.append(&mut inventory.escaping, SourceEscapingLocal {
              evaluation: actual.evaluation, point: actual.entry, local: source.root})
          }
        } else if path.root < prepared.body.locals.length {
          written = Option<Shared<Type>>.some(localType(prepared.body.locals, path.root))
          holder = path.root
        }
      }
      Shape.Exit {value} => {
        if let NodeKind.Return {..} = &nodes[actual.node.index].kind {
          if let Option<NodeId>.Some {value: operand} = value {
            written = expressionType(nodes, operand)
            returned = true
          }
        }
      }
      _ => ()
    }
    if let Option<Shared<Type>>.Some {value} = move written {
      if let Option<StoreWindow>.Some {value: window} = move run storeWindow(prepared.body.owner, &value, span, holder) {
        run List<SourceEscapeWindow>.append(&mut inventory.windows, SourceEscapeWindow {
          evaluation: actual.evaluation, point: actual.entry, returned: returned, window: move window})
      }
    }
    at = at + usize.ONE
  }
  let results = List<SourceGraph.ResultUse>.asSlice(&reservation.skeleton.results)
  let evaluations = List<SourceGraph.Evaluation>.asSlice(&reservation.skeleton.evaluations)
  at = usize.ZERO
  while at < results.length {
    let directive = &results[at]
    let node = match evaluations[directive.evaluation.index].site {
      SourceGraph.EvaluationSite.Node {node} => node
      _ => { return CompilerBug.panic(b"escape result window has no actual expression") }
    }
    if !run nodeRetains(nodes, node, prepared.body.owner) {
      run List<SourceEscapeSite>.append(&mut inventory.sites, SourceEscapeSite {evaluation: directive.evaluation,
        active: directive.active, span: nodes[node.index].origin.location, sealed: true})
    }
    if let NodeKind.Expression {form: Expression.DirectCall {arguments, ..}, ..} = &nodes[node.index].kind {
      let inputs = List<NodeId>.asSlice(&arguments)
      let mut each = usize.ZERO
      while each < inputs.length {
        if !retainedOperand(nodes, node, each) {
          run List<SourceEscapeSite>.append(&mut inventory.sites, SourceEscapeSite {evaluation: directive.evaluation,
            active: directive.active, span: nodes[inputs[each].index].origin.location, sealed: false})
        }
        each = each + usize.ONE
      }
    }
    at = at + usize.ONE
  }
  return move inventory
}

// The owner of finish explicitly marks its terminal publication before reserve/emit. The
// graph never guesses this semantic boundary from a Select, Place or Copy map. In particular,
// a construction and a match join are physical operations without a finish policy barrier.
effect fn sourceResultUses<'body>(prepared: &PreparedSources.SourcePreparation<'body>, reservation: &mut SourceVisit.Reservation,
  ownership: &SourceOwnership, cleanup: &[LoanCleanup]) -> () ! OutOfMemoryError ? &mut Allocator | &mut Types {
  if List<SourceGraph.ResultUse>.length(&reservation.skeleton.results) != usize.ZERO {
    CompilerBug.panic(b"ownership result directives were emitted twice")
  }
  let visits = List<SourceVisit.Visit>.asSlice(&reservation.visits)
  let acquired = List<SourceInputAcquisition>.asSlice(&ownership.acquisitions)
  let nodes = prepared.body.nodes
  let mut at = usize.ZERO
  while at < visits.length {
    let actual = &visits[at]
    let mut kind = Option<SourceGraph.ResultKind>.none()
    let shape = run shapeOf(nodes, actual.node)
    match move shape {
      Shape.Operands {..} => { kind = Option<SourceGraph.ResultKind>.some(SourceGraph.ResultKind.Physical) }
      Shape.ShortCircuit {..} => { kind = Option<SourceGraph.ResultKind>.some(SourceGraph.ResultKind.Physical) }
      Shape.Call {exact, signature, ..} => {
        let mut selected = SourceGraph.ResultKind.Physical
        if signature && !exact { selected = SourceGraph.ResultKind.Declared }
        kind = Option<SourceGraph.ResultKind>.some(move selected)
      }
      Shape.Invoke {..} => { kind = Option<SourceGraph.ResultKind>.some(SourceGraph.ResultKind.Declared) }
      Shape.ReadPlace => {
        if actual.access == SourceVisit.Access.Value {
          let path = run pathOf(nodes, actual.node)
          if path.root == usize.MAX {
            let base = projectedBase(nodes, actual.node)
            // Cleanup descriptors are immutable type metadata indexed by producer node;
            // this index does not identify or merge the actual temporary acquisitions.
            let descriptor = prepared.body.locals.length + nodes.length + base.index
            let hidden = descriptor < cleanup.length
              && (cleanup[descriptor].unknown || List<Shared<Lifetime>>.length(&cleanup[descriptor].regions) != usize.ZERO)
            if hidden {
              if run nodeRetains(nodes, actual.node, prepared.body.owner) {
                kind = Option<SourceGraph.ResultKind>.some(SourceGraph.ResultKind.Read {read: actual.evaluation})
              }
            } else {
              // Rvalue projections evaluate their physical operand; they do not acquire
              // an owned holder merely to classify the returned component.
              kind = Option<SourceGraph.ResultKind>.some(SourceGraph.ResultKind.Physical)
            }
          } else if (path.through || List<Step>.length(&path.steps) != usize.ZERO)
            && run nodeRetains(nodes, actual.node, prepared.body.owner) {
            kind = Option<SourceGraph.ResultKind>.some(SourceGraph.ResultKind.Read {read: actual.evaluation})
          }
        }
      }
      Shape.Displace {target, ..} => {
        let path = run pathOf(nodes, target)
        if path.root != usize.MAX && path.through && run nodeRetains(nodes, target, prepared.body.owner) {
          let read = match actual.displaced {
            Option<SourceGraph.EvalId>.Some {value} => value
            _ => { return CompilerBug.panic(b"retained replacement has no actual displaced read") }
          }
          kind = Option<SourceGraph.ResultKind>.some(SourceGraph.ResultKind.Read {read: read})
        }
      }
      _ => ()
    }
    if let Option<SourceGraph.ResultKind>.Some {value} = move kind {
      let mut sources = List<SourceGraph.EvalId>.make()
      let inputs = List<SourceVisit.Input>.asSlice(&actual.inputs)
      let mut each = usize.ZERO
      while each < inputs.length {
        run List<SourceGraph.EvalId>.append(&mut sources, inputs[each].evaluation)
        let mut borrowed = usize.ZERO
        while borrowed < acquired.length {
          if acquired[borrowed].result.index == actual.evaluation.index
            && acquired[borrowed].input.index == inputs[each].evaluation.index {
            run List<SourceGraph.EvalId>.append(&mut sources, acquired[borrowed].acquisition)
          }
          borrowed = borrowed + usize.ONE
        }
        each = each + usize.ONE
      }
      let active = SourceControl.Flow.reachable(&reservation.skeleton.flow, actual.execute)
      run List<SourceGraph.ResultUse>.append(&mut reservation.skeleton.results, SourceGraph.ResultUse {
        evaluation: actual.evaluation, active: active, kind: move value, sources: move sources})
    }
    at = at + usize.ONE
  }
  return ()
}

// Declaration-time loan facts, independent of eager carries or traversal. Both source and
// ownership projections must retain these exact typed regions, parent descriptor and place.
effect fn loanAt(nodes: &[Node], owner: &DeclarationId, path: &Path, exclusive: bool, span: Location, node: usize,
  parent: Option<Shared<Lifetime>>, point: usize) -> Loan ! OutOfMemoryError ? &mut Allocator {
  let mut typed = Option<Shared<Type>>.none()
  if node != usize.MAX { typed = expressionType(nodes, NodeId {index: node}) }
  return run loanTyped(owner, path, exclusive, span, move typed, move parent, point)
}

// Implicit producer references name their actual descriptor endpoint's type, not the enclosing
// Callable/Effect result. The declaration facts are otherwise identical to an authored borrow.
effect fn loanTyped(owner: &DeclarationId, path: &Path, exclusive: bool, span: Location,
  typed: Option<Shared<Type>>, parent: Option<Shared<Lifetime>>, point: usize) -> Loan
! OutOfMemoryError ? &mut Allocator {
  let mut regions = List<Shared<Lifetime>>.make()
  let mut borrowed = Option<Shared<Lifetime>>.none()
  let mut viewed = Option<Shared<Type>>.none()
  if let Option<Shared<Type>>.Some {value} = move typed {
    borrowed = Shared<Type>.with<Option<Shared<Lifetime>>>(&value, loanLifetime)
    let known = run retainedBy(&value, owner, &mut regions)
    if !known { regions = List<Shared<Lifetime>>.make() }
    viewed = Shared<Type>.with<Option<Shared<Type>>>(&value, loanReferent)
  }
  return Loan {
    place: Place {root: path.root, steps: run copySteps(List<Step>.asSlice(&path.steps))},
    exclusive: exclusive,
    origin: span,
    intervals: List<Interval>.make(),
    precision: LoanPrecision.Exact,
    regions: move regions,
    local: !path.through,
    borrowed: move borrowed,
    parent: move parent,
    crossed: false,
    created: point,
    escapes: false,
    binder: usize.MAX,
    block: usize.MAX,
    until: usize.MAX,
    referent: move viewed,
    bound: false,
  }
}

// Records a new loan of `path` at a fresh point after `at`; the borrowing value carries it after
// `carried`. `node` is the expression whose type names the loan's regions, or `usize.MAX`.
effect fn takeLoan(nodes: &[Node], owner: &DeclarationId, walker: &mut Walker, path: &Path, exclusive: bool, span: Location, node: usize,
  parent: Option<Shared<Lifetime>>, at: usize, carried: List<Carry>) -> Flow
! OutOfMemoryError ? &mut Allocator {
  let mut onward = move carried
  let loan = run loanAt(nodes, owner, path, exclusive, span, node, move parent, usize.MAX)
  let created = List<Loan>.length(&walker.loans)
  run List<Loan>.append(&mut walker.loans, move loan)
  let mut kind = Kind.SharedBorrow
  if exclusive {
    kind = Kind.ExclusiveBorrow
  }
  let point = run access(&mut walker.*, path, kind, span, at, created)
  let mut loans = List<Loan>.asMutSlice(&mut walker.loans)
  loans[created].created = point
  run List<Carry>.append(&mut onward, Carry {loan: created, since: point, operand: usize.MAX, definition: usize.MAX, read: usize.MAX, field: usize.ZERO, direct: true})
  return Flow {at: point, carried: move onward}
}

// Reads or moves a written place. An access rooted at a holder uses the holder, so its loans stay
// live through the access, and the accessed value carries them: a whole holder's move takes them to
// the new owner, and a part read out of it may hold them too (a reference field, for instance).
effect fn place(nodes: &[Node], locals: &[Local], owner: &DeclarationId, walker: &mut Walker, path: &Path, kind: Kind, span: Location, at: usize) -> Flow
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let evaluated = run indexes(nodes, locals, owner, &mut walker.*, path, at)
  let lent = run useBinders(nodes, &mut walker.*, path, span, evaluated)
  if path.through {
    let reached = run throughReference(&mut walker.*, path, kind, span, lent)
    return move reached
  }
  if holds(&walker.*, path.root) {
    let read = run readPath(&mut walker.*, path)
    let used = run useHolder(&mut walker.*, path.root, read, span, lent)
    let accessed = run access(&mut walker.*, path, kind, span, used.at, usize.MAX)
    return Flow {at: accessed, carried: move used.carried}
  }
  let point = run access(&mut walker.*, path, kind, span, lent, usize.MAX)
  return flowAt(point)
}

effect fn operandPlacements(nodes: &[Node], result: NodeId, places: &[usize], member: usize)
  -> List<List<Step>> ! OutOfMemoryError ? &mut Allocator {
  // An aggregate places each operand at its field, at its element of an array, or at its field of the
  // constructed variant's payload.
  let mut placed = List<List<Step>>.make()
  let elements = match move expressionType(nodes, result) {
    Option<Shared<Type>>.Some {value} => Shared<Type>.with<bool>(&value, arrayType)
    Option<Shared<Type>>.None => false
  }
  let mut index = usize.ZERO
  while index < places.length {
    let mut steps = List<Step>.make()
    if member != usize.MAX { run List<Step>.append(&mut steps, memberStep(member)) }
    if elements {
      let mut step = Step {kind: StepKind.RepeatedElement, ordinal: usize.ZERO}
      if places[index] != usize.MAX { step = elementStep(places[index]) }
      run List<Step>.append(&mut steps, step)
    } else {
      run List<Step>.append(&mut steps, fieldStep(places[index]))
    }
    run List<List<Step>>.append(&mut placed, move steps)
    index = index + usize.ONE
  }
  return move placed
}

// Evaluates operands in order and consumes everything they carry at one fresh point. A variant's
// operands lie within its `member` payload; any other aggregate's `member` is `usize.MAX`.
effect fn operands(nodes: &[Node], locals: &[Local], owner: &DeclarationId, walker: &mut Walker, values: &[NodeId], places: &[usize], member: usize,
  result: NodeId, at: usize) -> Flow
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut carried = List<Carry>.make()
  let mut current = at
  let mut index = usize.ZERO
  while index < values.length {
    let flow = run visit(nodes, locals, owner, &mut walker.*, values[index], current)
    run appendOperand(&mut carried, List<Carry>.asSlice(&flow.carried), index)
    current = flow.at
    index = index + usize.ONE
  }
  let placed = run operandPlacements(nodes, result, places, member)
  run keepWrittenOperands(nodes, owner, &mut walker.*, result, values, List<Carry>.asSlice(&carried))
  let untyped = List<NodeId>.make()
  let noSinks = List<OperandSink>.make()
  return run finish(nodes, owner, &mut walker.*, result, current, &carried, false, Forwarding.Operands, List<List<Step>>.asSlice(&placed), List<NodeId>.asSlice(&untyped), List<OperandSink>.asSlice(&noSinks))
}

// The type operand `operand` of call or record literal `result` has under the generic arguments the
// source wrote for it: the call's parameter type, or the literal's field type.
effect fn writtenOperandType(nodes: &[Node], result: NodeId, operand: usize) -> Option<Shared<Type>>
! OutOfMemoryError ? &mut Allocator {
  // An immediate run's operands are those of the call it executes.
  if let NodeKind.Expression {form: Expression.Run {value, access}, ..} = &nodes[result.index].kind {
    if access == RunAccess.Immediate { return run writtenOperandType(nodes, value, operand) }
  }
  return match &nodes[result.index].kind {
    NodeKind.Expression {form: Expression.DirectCall {written, ..}, ..} => {
      let chosen = List<Shared<Type>>.asSlice(&written)
      if operand < chosen.length { return Option<Shared<Type>>.some(Shared<Type>.clone(&chosen[operand])) }
      return Option<Shared<Type>>.none()
    }
    NodeKind.Expression {form: Expression.Aggregate {written, ..}, ..} => {
      let chosen = List<Shared<Type>>.asSlice(&written)
      if operand < chosen.length { return Option<Shared<Type>>.some(Shared<Type>.clone(&chosen[operand])) }
      return Option<Shared<Type>>.none()
    }
    _ => Option<Shared<Type>>.none()
  }
}

// A call or literal types each operand with the regions its written generic arguments chose: an
// operand typed there only at universal lifetime parameters must stay valid for them, so every
// loan it carries outlives the body wherever its creation reaches, its own borrow and those of a
// local reference it reborrows through alike. A loan of a body local is the region proof's to
// refute, since no universal region can outlive it.
effect fn keepWrittenOperands(nodes: &[Node], owner: &DeclarationId, walker: &mut Walker, result: NodeId, operands: &[NodeId],
  carried: &[Carry]) -> () ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut at = usize.ZERO
  while at < carried.length {
    if let Option<Shared<Type>>.Some {value: typed} = move run writtenOperandType(nodes, result, carried[at].operand) {
      if run universallyTyped(&typed, owner) {
        let mut all = List<Loan>.asMutSlice(&mut walker.loans)
        if !all[carried[at].loan].local { all[carried[at].loan].escapes = true }
      }
    }
    at = at + usize.ONE
  }
  return ()
}

// Written universal arguments are independent escape reasons. Preserve their paired
// actual sources; they never acquire caller-retention provenance from a later operation.
effect fn sourceKeepWritten(nodes: &[Node], owner: &DeclarationId, result: NodeId,
  observation: &SourceObservation, loans: &[Loan], active: SourceAtom, rules: &mut SourceProgram)
  -> List<SourceEscapeEffect> ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut effects = List<SourceEscapeEffect>.make()
  let positions = List<SourceCarryPosition>.asSlice(&observation.positions)
  let empty = List<SourceAtom>.make()
  let mut at = usize.ZERO
  while at < positions.length {
    if let Option<Shared<Type>>.Some {value: typed} = move run writtenOperandType(nodes, result, positions[at].operand) {
      if run universallyTyped(&typed, owner) && !loans[positions[at].loan].local {
        let cases = List<SourceCarryCase>.asSlice(&positions[at].cases)
        let mut each = usize.ZERO
        while each < cases.length {
          let gates: [SourceAtom; 2] = [active, cases[each].source.quality.present]
          run List<SourceEscapeEffect>.append(&mut effects, SourceEscapeEffect {
            source: sourceEffectSource(&positions[at], &cases[each]),
            active: run SourcePolicy.conjunction(&mut rules.*, &gates, List<SourceAtom>.asSlice(&empty))})
          each = each + usize.ONE
        }
      }
    }
    at = at + usize.ONE
  }
  return move effects
}

// Which local loans a result that names only caller regions keeps exactly (see `finish`).
enum Forwarding {
  // None: the result's type decides what it holds, as for a call.
  None,
  // Every operand loan: the result is built from its operands.
  Operands,
  // The loans a place read found held where it reads (`Carry.field` known).
  Matched,
}

// Known result borrows also retain their actual reborrow ancestors. Follow only the borrowed
// atom and parent recorded when each loan was taken, never an inner retained atom or a typing
// obligation. Shared inference atoms describe possible sources, so the closure is a union;
// it does not establish exact retention. Existing Unknown precision remains Unknown.
effect fn retainedParents(loans: &[Loan], carried: &[Carry], named: &[Shared<Lifetime>]) -> List<bool>
! OutOfMemoryError ? &mut Allocator {
  let mut supported = List<bool>.make()
  let mut pending = List<usize>.make()
  let mut at = usize.ZERO
  while at < carried.length {
    let mut seed = false
    if let Option<Shared<Lifetime>>.Some {value} = &loans[carried[at].loan].borrowed {
      seed = proofContains(named, &value)
    }
    run List<bool>.append(&mut supported, seed)
    if seed { run List<usize>.append(&mut pending, at) }
    at = at + usize.ONE
  }
  let mut next = usize.ZERO
  while next < List<usize>.length(&pending) {
    let queue = List<usize>.asSlice(&pending)
    let child = &loans[carried[queue[next]].loan]
    if let Option<Shared<Lifetime>>.Some {value: parent} = &child.parent {
      at = usize.ZERO
      while at < carried.length {
        let seen = List<bool>.asSlice(&supported)
        if !seen[at] {
          if let Option<Shared<Lifetime>>.Some {value: borrowed} = &loans[carried[at].loan].borrowed {
            if meetMember(&parent, &borrowed) {
              let mut marked = List<bool>.asMutSlice(&mut supported)
              marked[at] = true
              run List<usize>.append(&mut pending, at)
            }
          }
        }
        at = at + usize.ONE
      }
    }
    next = next + usize.ONE
  }
  return move supported
}

// Whether `region` is a meet of this body's regions with universal ones. Such a meet is valid only
// while each of its local constituents is, and the universal ones outlive the body, so its local
// constituents carry every finite requirement it has: a binding that held a parameter's reference
// and is then assigned a borrow types the borrow under that meet.
fn localMeet(region: &Shared<Lifetime>, owner: &DeclarationId, supplied: &[Shared<Lifetime>]) -> bool {
  let count = Lifetime.atomCount(region)
  if count <= usize.ONE { return false }
  let mut local = false
  let mut at = usize.ZERO
  while at < count {
    let domain = regionDomain(&Lifetime.atomAt(region, at), owner, supplied)
    if domain == RegionDomain.Unknown { return false }
    if domain == RegionDomain.Local { local = true }
    at = at + usize.ONE
  }
  return local
}

// Whether `region` is `named` itself or a local constituent of `named`, a `localMeet`.
fn carriesRegion(named: &Shared<Lifetime>, region: &Shared<Lifetime>, owner: &DeclarationId, supplied: &[Shared<Lifetime>]) -> bool {
  if Lifetime.equalsShared(named, region) { return true }
  return localMeet(named, owner, supplied) && meetMember(named, region)
}

// Whether one of `regions` carries `region` (`carriesRegion`).
fn regionsCarry(regions: &[Shared<Lifetime>], region: &Shared<Lifetime>, owner: &DeclarationId, supplied: &[Shared<Lifetime>]) -> bool {
  let mut at = usize.ZERO
  while at < regions.length {
    if carriesRegion(&regions[at], region, owner, supplied) { return true }
    at = at + usize.ONE
  }
  return false
}

// Whether some constituent of the meet `bound` is a region local to `owner`'s body.
fn meetHoldsLocal(bound: &Shared<Lifetime>, owner: &DeclarationId) -> bool {
  let count = Lifetime.atomCount(bound)
  let mut at = usize.ZERO
  while at < count {
    if regionLocal(&Lifetime.atomAt(bound, at), owner) { return true }
    at = at + usize.ONE
  }
  return false
}

// Whether `atom` is one of the descriptor lifetimes a reborrow's parent meet is made of.
fn meetMember(bound: &Shared<Lifetime>, atom: &Shared<Lifetime>) -> bool {
  let count = Lifetime.atomCount(bound)
  let mut at = usize.ZERO
  while at < count {
    let member = Lifetime.atomAt(bound, at)
    if Lifetime.equalsShared(&member, atom) { return true }
    at = at + usize.ONE
  }
  return false
}

// A complete known result must account for each local atom with an already-carried exact
// actual source. An inner atom in some unrelated loan's type is not that source's identity.
fn completeLocalResultSources(loans: &[Loan], carried: &[Carry], named: &[Shared<Lifetime>], owner: &DeclarationId,
  supplied: &[Shared<Lifetime>]) -> bool {
  let mut source = usize.ZERO
  while source < carried.length {
    if loans[carried[source].loan].precision != LoanPrecision.Exact { return false }
    source = source + usize.ONE
  }
  let mut local = false
  let mut at = usize.ZERO
  while at < named.length {
    let domain = regionDomain(&named[at], owner, supplied)
    if domain == RegionDomain.Unknown { return false }
    if domain == RegionDomain.Local {
      local = true
      let mut found = false
      source = usize.ZERO
      while source < carried.length {
        let loan = &loans[carried[source].loan]
        if loan.precision == LoanPrecision.Exact {
          if let Option<Shared<Lifetime>>.Some {value: borrowed} = &loan.borrowed {
            if Lifetime.equalsShared(&borrowed, &named[at])
              && proofContains(List<Shared<Lifetime>>.asSlice(&loan.regions), &borrowed) { found = true }
          }
        }
        source = source + usize.ONE
      }
      if !found { return false }
    }
    at = at + usize.ONE
  }
  return local
}

// Only a fresh exact borrow of owned storage can be released by the complete-source
// proof. Reborrow ancestry, required sources, and any previous uncertainty remain authoritative.
fn unneededOwnedLoan(loan: &Loan, owner: &DeclarationId, named: &[Shared<Lifetime>], required: &[usize], ancestor: bool) -> bool {
  if !loan.local || loan.precision != LoanPrecision.Exact || ancestor || requiredLoan(loan, owner, required) { return false }
  if let Option<Shared<Lifetime>>.Some {..} = &loan.parent { return false }
  let regions = List<Shared<Lifetime>>.asSlice(&loan.regions)
  if regions.length != usize.ONE { return false }
  if let Option<Shared<Lifetime>>.Some {value: borrowed} = &loan.borrowed {
    return retentionOrdinal(&borrowed, owner) != usize.MAX && Lifetime.equalsShared(&regions[0], &borrowed)
      && !proofContains(named, &borrowed)
  }
  return false
}

// Read the same source component as Semantic.resultSourceAtoms: a shared reference supplies
// its outer access region, while other shapes require complete stored-region evidence. Knowing
// an outer reference never authenticates an unknown referent or any loan within that referent.
effect fn declaredSourceRegions(nodes: &[Node], source: NodeId, owner: &DeclarationId, regions: &mut List<Shared<Lifetime>>) -> bool
! OutOfMemoryError ? &mut Allocator | &mut Types {
  if let Option<Shared<Type>>.Some {value} = move expressionType(nodes, source) {
    if let Type.Reference {access, lifetime, ..} = move run Type.copy(&value) {
      if access == Access.Shared {
        run appendAtoms(&mut regions.*, &lifetime)
        return true
      }
    }
  }
  return run resultRegions(nodes, source, owner, &mut regions.*)
}

// Preserve an exact finite source only when the declared signature permits this operand
// to supply the result and its authenticated region is the loan's actual borrowed region.
// Reborrow ancestors follow their authenticated parent edges within that same operand.
// Neither an unrelated inner atom nor prior Alternatives/Unknown can acquire this evidence.
effect fn declaredResultLoans(nodes: &[Node], result: NodeId, carried: &[Carry], loans: &[Loan], owner: &DeclarationId)
-> List<bool> ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut call = result
  if let NodeKind.Expression {form: Expression.Run {value, access}, ..} = &nodes[result.index].kind {
    if access == RunAccess.Immediate { call = value }
  }
  let mut proven = List<bool>.make()
  let mut index = usize.ZERO
  while index < carried.length {
    let carry = &carried[index]
    let loan = &loans[carry.loan]
    let mut exact = false
    if loan.precision == LoanPrecision.Exact && carry.field != usize.MAX {
      if let NodeKind.Expression {form: Expression.DirectCall {arguments, resultBorrows, ..}, ..} = &nodes[call.index].kind {
        let operands = List<NodeId>.asSlice(&arguments)
        let selected = List<ResultBorrow>.asSlice(&resultBorrows)
        let mut at = usize.ZERO
        while carry.operand < operands.length && at < selected.length {
          if selected[at].argument.index == operands[carry.operand].index {
            let mut named = List<Shared<Lifetime>>.make()
            if run declaredSourceRegions(nodes, selected[at].argument, owner, &mut named) {
              let regions = List<Shared<Lifetime>>.asSlice(&named)
              let actual = List<Shared<Lifetime>>.asSlice(&loan.regions)
              if regions.length == usize.ONE && actual.length == usize.ONE {
                if let Option<Shared<Lifetime>>.Some {value: borrowed} = &loan.borrowed {
                  exact = Lifetime.equalsShared(&regions[0], &borrowed) && Lifetime.equalsShared(&actual[0], &borrowed)
                }
              }
            }
          }
          at = at + usize.ONE
        }
      }
    }
    run List<bool>.append(&mut proven, exact)
    index = index + usize.ONE
  }
  let mut changed = true
  while changed {
    changed = false
    index = usize.ZERO
    while index < carried.length {
      if List<bool>.asSlice(&proven)[index] {
        if let Option<Shared<Lifetime>>.Some {value: parent} = &loans[carried[index].loan].parent {
          let mut ancestor = usize.ZERO
          while ancestor < carried.length {
            let loan = &loans[carried[ancestor].loan]
            if !List<bool>.asSlice(&proven)[ancestor] && carried[ancestor].operand == carried[index].operand
              && loan.precision == LoanPrecision.Exact {
              if let Option<Shared<Lifetime>>.Some {value: borrowed} = &loan.borrowed {
                if meetMember(&parent, &borrowed) {
                  let mut marked = List<bool>.asMutSlice(&mut proven)
                  marked[ancestor] = true
                  changed = true
                }
              }
            }
            ancestor = ancestor + usize.ONE
          }
        }
      }
      index = index + usize.ONE
    }
  }
  return move proven
}

// Place an authenticated source at each complete result field path the signature can return it in.
// This mapping must not be reconstructed from inferred output atoms: sibling binders may coincide.
effect fn declaredResultCarries(nodes: &[Node], result: NodeId, walker: &mut Walker, carry: Carry, point: usize,
  onward: &mut List<Carry>) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut call = result
  if let NodeKind.Expression {form: Expression.Run {value, access}, ..} = &nodes[result.index].kind {
    if access == RunAccess.Immediate { call = value }
  }
  if let NodeKind.Expression {form: Expression.DirectCall {arguments, resultBorrows, ..}, ..} = &nodes[call.index].kind {
    let operands = List<NodeId>.asSlice(&arguments)
    let sources = List<ResultBorrow>.asSlice(&resultBorrows)
    let mut at = usize.ZERO
    while carry.operand < operands.length && at < sources.length {
      if sources[at].argument.index == operands[carry.operand].index {
        let mut path = List<Step>.make()
        let fields = List<usize>.asSlice(&sources[at].fields)
        let mut step = usize.ZERO
        while step < fields.length {
          run List<Step>.append(&mut path, fieldStep(fields[step]))
          step = step + usize.ONE
        }
        let field = run internPath(&mut walker.*, move path)
        run List<Carry>.append(&mut onward.*, Carry {loan: carry.loan, since: point, operand: usize.MAX,
          definition: carry.definition, read: carry.read, field: field, direct: false})
      }
      at = at + usize.ONE
    }
  }
  return ()
}

// Records the operands of the direct call `result` whose loans its result cannot hold.
effect fn recordUnheld(nodes: &[Node], walker: &mut Walker, result: NodeId) -> () ! OutOfMemoryError ? &mut Allocator {
  if let NodeKind.Expression {form: Expression.DirectCall {arguments, ..}, ..} = &nodes[result.index].kind {
    let operands = List<NodeId>.asSlice(&arguments)
    let mut at = usize.ZERO
    while at < operands.length {
      if !retainedOperand(nodes, result, at) {
        run List<Location>.append(&mut walker.unheld, nodes[operands[at].index].origin.location)
      }
      at = at + usize.ONE
    }
  }
  return ()
}

// Whether `site` lies in an operand whose loans its call's result cannot hold (`Walker.unheld`). A
// `return` or a store nested in that operand sends its own value elsewhere, so a site inside one is
// decided there, not by the call.
fn unheldSite<'proof>(sources: &EscapeSources<'proof>, site: Location) -> bool {
  let unheld = sources.unheld
  let mut at = usize.ZERO
  while at < unheld.length {
    if within(site, unheld[at]) && !nestedWindow(sources.returns, site, unheld[at])
      && !nestedWindow(sources.stores, site, unheld[at]) { return true }
    at = at + usize.ONE
  }
  return false
}

fn within(inner: Location, outer: Location) -> bool {
  return inner.start >= outer.start && inner.end <= outer.end
}

// Whether one of `windows` lies within `operand` and holds `site`.
fn nestedWindow(windows: &[StoreWindow], site: Location, operand: Location) -> bool {
  let mut at = usize.ZERO
  while at < windows.length {
    if within(windows[at].span, operand) && within(site, windows[at].span) { return true }
    at = at + usize.ONE
  }
  return false
}

// Whether a direct call's result can hold what its operand `operand` carries: typing lists the
// arguments the callee's signature lets its result retain. Any other result, and a loan carried by
// no single operand, may hold it.
fn retainedOperand(nodes: &[Node], result: NodeId, operand: usize) -> bool {
  if let NodeKind.Expression {form: Expression.DirectCall {arguments, retained, ..}, ..} = &nodes[result.index].kind {
    let operands = List<NodeId>.asSlice(&arguments)
    if operand >= operands.length { return true }
    let listed = List<NodeId>.asSlice(&retained)
    let mut at = usize.ZERO
    while at < listed.length {
      if listed[at].index == operands[operand].index { return true }
      at = at + usize.ONE
    }
    return false
  }
  return true
}

// Whether typing requires one of `regions` to outlive one of `named`: a relation offers a region of
// the loan and wants a region of the result.
fn outlivesResult(relations: &[ImpliedGroup], regions: &[Shared<Lifetime>], named: &[Shared<Lifetime>]) -> bool {
  let mut at = usize.ZERO
  while at < relations.length {
    if sharesAtom(List<Shared<Lifetime>>.asSlice(&relations[at].members), regions)
      && sharesAtom(List<Shared<Lifetime>>.asSlice(&relations[at].container), named) { return true }
    at = at + usize.ONE
  }
  return false
}


// Operation-wide facts are sampled before the per-carry loop. The loan supplied to
// resultDecision is sampled at that carry, after all preceding carries' effects.
struct ResultFacts {
  stores: bool
  known: bool
  outside: bool
  forwarding: Forwarding
  placedCount: usize
  naming: usize
  several: bool
  complete: bool
  retained: bool
  declared: bool
  ancestor: bool
}

// Explicit effects of the result policy. Keeping a source never repairs prior precision.
struct ResultDecision {
  kept: bool
  precision: LoanPrecision
  bound: bool
  unretained: bool
  declared: bool
  whole: bool
  described: bool
}

// One actual physical operand/component/loan position. Histories are already normalized by
// SourceAnalysis; quality names the operation's pre-result observation, not final-body state.
struct SourceResultInput {
  loan: usize
  operand: usize
  quality: SourceQuality
}
impl Copy for SourceResultInput {}

struct SourceResultSnapshot {
  required: List<SourceAtom>
  parents: List<SourceAtom>
  naming: SourceNaming
  complete: SourceAtom
}

// One paired history at a physical position. The incoming precision is the position's P
// version, shared by its histories; field/direct/read evidence must not be unioned first.
struct SourceResultCase {
  quality: SourceQuality
  operand: usize
  retained: bool
  field: usize
  wholeField: bool
  declared: SourceAtom
}

struct SourceResultFacts {
  stores: bool
  known: bool
  outside: bool
  forwarding: Forwarding
  placedCount: usize
  // These retain the actual operation-wide implied/whole-hold observation gates.
  impliedKnown: SourceAtom
  mayOutlive: SourceAtom
  hasTyped: bool
}

// A reserved result transfer and its exact incoming history. The port comes from Builder;
// declared is independently authenticated by original ResultBorrow/descriptor provenance.
// Merely having a ContractRoute never supplies that predicate.
struct SourceResultRoute {
  position: usize
  history: usize
  policy: usize
  field: usize
  wholeField: bool
  declared: SourceAtom
}

struct SourceResultEffect {
  source: SourceEffectSource
  policy: usize
  target: SourceGraph.ValueId
  field: usize
  direct: bool
  quality: SourceQuality
  whole: SourceAtom
  described: SourceAtom
}

struct SourcePositionResult {
  result: SourceGraph.EvalId
  position: usize
  source: SourceEffectSource
  decision: SourcePolicy.ResultOutput
  missing: SourceAtom
}

struct SourceResultScan {
  inputs: List<SourcePositionResult>
  outputs: List<SourceResultEffect>
  missing: SourceAtom
}

struct SourceFinishEffects {
  retention: List<SourceRetentionEffect>
  written: List<SourceEscapeEffect>
  intervals: List<SourceIntervalEffect>
  inputResults: List<SourcePositionResult>
  results: List<SourceResultEffect>
  wholeHolds: List<SourceWholeHold>
  sealed: List<Location>
  unheld: List<Location>
  missing: SourceAtom
}

fn sourceNodeValueRoot<'body>(prepared: &PreparedSources.SourcePreparation<'body>, node: NodeId)
  -> PreparedSources.EndpointId {
  let endpoints = List<PreparedSources.Endpoint>.asSlice(&prepared.endpoints)
  let mut found = usize.MAX
  let mut at = usize.ZERO
  while at < endpoints.length {
    let whole = match endpoints[at].parent { Option<PreparedSources.EndpointId>.None => true _ => false }
    let matches = match &endpoints[at].root {
      PreparedSources.Root.Node {node: actual, role: PreparedSources.EndpointRole.Value} => actual.index == node.index
      _ => false
    }
    if whole && matches {
      if found != usize.MAX { return CompilerBug.panic(b"actual value has duplicate prepared physical roots") }
      found = at
    }
    at = at + usize.ONE
  }
  if found == usize.MAX { return CompilerBug.panic(b"actual value has no prepared physical root") }
  return PreparedSources.EndpointId {index: found}
}

// Ordinary aggregates and short-circuit operators finish their actual written operands.
// Shape supplies ownership forwarding/placement; authentic graph transfers supply publication.
// A repeated array's one physical input stays one input, with RepeatedElement placement.
effect fn sourceFinishOperands<'body>(builder: &mut SourceGraph.Builder<'body>, actual: &SourceVisit.Visit,
  directive: &SourceGraph.ResultUse, state: &mut SourcePolicy.LoanState, loans: &[Loan], paths: &mut List<List<Step>>,
  context: &RetentionContext) -> SourceFinishEffects ! OutOfMemoryError ? &mut Allocator | &mut Types {
  if directive.evaluation.index != actual.evaluation.index {
    return CompilerBug.panic(b"operand finish substituted another actual result")
  }
  match directive.kind {
    SourceGraph.ResultKind.Physical => ()
    _ => { return CompilerBug.panic(b"operand finish requires its physical result directive") }
  }
  let nodes = SourceGraph.Builder.preparation(&builder.*).body.nodes
  let owner = SourceGraph.Builder.preparation(&builder.*).body.owner
  let supplied = SourceGraph.Builder.preparation(&builder.*).body.supplied
  let mut values = List<NodeId>.make()
  let mut placed = List<List<Step>>.make()
  let mut forwarding = Forwarding.None
  match move run shapeOf(nodes, actual.node) {
    Shape.Operands {values: inputs, places, member} => {
      values = move inputs
      placed = run operandPlacements(nodes, actual.node, List<usize>.asSlice(&places), member)
      forwarding = Forwarding.Operands
    }
    Shape.ShortCircuit {left, right} => {
      run List<NodeId>.append(&mut values, left)
      run List<NodeId>.append(&mut values, right)
    }
    _ => { return CompilerBug.panic(b"operand finish selected another ownership handler") }
  }
  let written = List<NodeId>.asSlice(&values)
  let inputs = List<SourceVisit.Input>.asSlice(&actual.inputs)
  if inputs.length != written.length { return CompilerBug.panic(b"operand finish lost its actual written input order") }
  let mut operands = List<SourceOperand>.make()
  let mut at = usize.ZERO
  while at < inputs.length {
    let input = sourceAccessInput(actual, at, written[at])
    let mut admitted = false
    let sources = List<SourceGraph.EvalId>.asSlice(&directive.sources)
    let mut each = usize.ZERO
    while each < sources.length {
      if sources[each].index == input.evaluation.index { admitted = true }
      each = each + usize.ONE
    }
    if !admitted { return CompilerBug.panic(b"operand result directive omitted a genuine physical input") }
    let root = sourceNodeValueRoot(SourceGraph.Builder.preparation(&builder.*), input.node)
    run List<SourceOperand>.append(&mut operands, SourceOperand {
      node: input.node, evaluation: input.evaluation, root: root, ordinal: at})
    at = at + usize.ONE
  }
  let observation = run sourceObserve(&mut builder.*, List<SourceOperand>.asSlice(&operands),
    SourceGraph.ValuePhase.Output, &mut paths.*, loans.length)
  let root = sourceNodeValueRoot(SourceGraph.Builder.preparation(&builder.*), actual.node)
  let untyped = List<NodeId>.make()
  let sinks = List<OperandSink>.make()
  return run sourceFinish(&mut builder.*, &observation, &mut state.*, loans, &mut paths.*, nodes, owner,
    supplied, List<RetentionEdge>.asSlice(&context.requirements), List<ImpliedGroup>.asSlice(&context.relations),
    context.settled, actual.node, actual.evaluation, root, actual.execute.index, directive.active, false,
    forwarding, List<List<Step>>.asSlice(&placed), List<NodeId>.asSlice(&untyped), List<OperandSink>.asSlice(&sinks))
}

// Joining observations preserves physical operand/component order. Alternative source
// histories remain inside their original positions and never become additional operands.
effect fn sourceAppendObservation(target: &mut SourceObservation, incoming: SourceObservation,
  rules: &mut SourceProgram) -> () ! OutOfMemoryError ? &mut Allocator {
  let unknown: [SourceAtom; 2] = [target.unknown, incoming.unknown]
  target.unknown = run SourcePolicy.disjunction(&mut rules.*, &unknown)
  let mut positions = move incoming.positions
  while List<SourceCarryPosition>.length(&positions) != usize.ZERO {
    run List<SourceCarryPosition>.append(&mut target.positions, List<SourceCarryPosition>.remove(&mut positions, usize.ZERO))
  }
  let mut other = move incoming.other
  while List<SourceGraph.Input>.length(&other) != usize.ZERO {
    run List<SourceGraph.Input>.append(&mut target.other, List<SourceGraph.Input>.remove(&mut other, usize.ZERO))
  }
  return ()
}

// This path is relative to a genuine producer-created descriptor. Its referent mapping is
// retained at acquisition; adding Referent here is a carry placement, never an address proof.
effect fn sourceReferenceContents(observation: &mut SourceObservation, paths: &mut List<List<Step>>) -> ()
! OutOfMemoryError ? &mut Allocator {
  let positions = List<SourceCarryPosition>.asMutSlice(&mut observation.positions)
  let mut at = usize.ZERO
  while at < positions.length {
    let cases = List<SourceCarryCase>.asMutSlice(&mut positions[at].cases)
    let mut each = usize.ZERO
    while each < cases.length {
      if cases[each].field != usize.MAX {
        let mut steps = List<Step>.make()
        run List<Step>.append(&mut steps, referent())
        let old = List<Step>.asSlice(&List<List<Step>>.asSlice(&paths.*)[cases[each].field])
        let mut step = usize.ZERO
        while step < old.length { run List<Step>.append(&mut steps, old[step]) step = step + usize.ONE }
        cases[each].field = List<List<Step>>.length(&paths.*)
        run List<List<Step>>.append(&mut paths.*, move steps)
      } else { cases[each].source.direct = false }
      each = each + usize.ONE
    }
    at = at + usize.ONE
  }
  return ()
}

fn sourceVisitAt(visits: &[SourceVisit.Visit], evaluation: SourceGraph.EvalId) -> &SourceVisit.Visit {
  let mut found = usize.MAX
  let mut at = usize.ZERO
  while at < visits.length {
    if visits[at].evaluation.index == evaluation.index {
      if found != usize.MAX { return CompilerBug.panic(b"ownership dispatch has duplicate actual visits") }
      found = at
    }
    at = at + usize.ONE
  }
  if found == usize.MAX { return CompilerBug.panic(b"ownership dispatch lost its actual visit") }
  return &visits[found]
}

// Observe an input once, then the descriptor that this actual operation acquired from it.
// The source graph's published enclosing result is deliberately not used for acquisition.
effect fn sourceCallInput<'body>(builder: &mut SourceGraph.Builder<'body>, actual: &SourceVisit.Visit,
  input: SourceVisit.Input, ordinal: usize, acquired: &[SourceInputAcquisition], paths: &mut List<List<Step>>,
  loans: usize) -> SourceObservation ! OutOfMemoryError ? &mut Allocator {
  let root = sourceNodeValueRoot(SourceGraph.Builder.preparation(&builder.*), input.node)
  let operands: [SourceOperand; 1] = [SourceOperand {node: input.node, evaluation: input.evaluation, root: root, ordinal: ordinal}]
  let mut observation = run sourceObserve(&mut builder.*, &operands, SourceGraph.ValuePhase.Output, &mut paths.*, loans)
  let mut selected = usize.MAX
  let mut at = usize.ZERO
  while at < acquired.length {
    if acquired[at].result.index == actual.evaluation.index && acquired[at].input.index == input.evaluation.index {
      if selected != usize.MAX { return CompilerBug.panic(b"call input has two implicit descriptor acquisitions") }
      selected = at
    }
    at = at + usize.ONE
  }
  if selected != usize.MAX {
    let borrowed = acquired[selected]
    let maps = List<PreparedSources.SelectionMap>.asSlice(&SourceGraph.Builder.preparation(&builder.*).maps)
    let descriptor = maps[borrowed.map.index].target
    let acquisition = SourceGraph.Builder.evaluation(&builder.*, borrowed.acquisition)
    if acquisition.point.index != input.usePoint.index || borrowed.loan >= loans {
      return CompilerBug.panic(b"implicit call descriptor moved past its original input use")
    }
    run sourceReferenceContents(&mut observation, &mut paths.*)
    let inputs: [SourceOperand; 1] = [SourceOperand {node: input.node, evaluation: borrowed.acquisition,
      root: descriptor, ordinal: ordinal}]
    let descriptor = run sourceObserve(&mut builder.*, &inputs, SourceGraph.ValuePhase.Output, &mut paths.*, loans)
    let positions = List<SourceCarryPosition>.asSlice(&descriptor.positions)
    at = usize.ZERO
    while at < positions.length {
      if positions[at].loan != borrowed.loan { return CompilerBug.panic(b"implicit descriptor acquired another input's loan") }
      at = at + usize.ONE
    }
    run sourceAppendObservation(&mut observation, move descriptor, &mut builder.rules)
  }
  return move observation
}

struct SourceCallEffects {
  finished: SourceFinishEffects
  stored: SourceStoreEffects
  inputs: SourceObservation
  callee: Option<usize>
}

// Ordinary calls and callable invocations share the post-arguments finish barrier. A Run
// uses the actual originating occurrence retained by Stores, never the last matching NodeId.
// ThroughExclusive consumes the returned input histories separately from declared slot writes.
effect fn sourceCall<'body>(builder: &mut SourceGraph.Builder<'body>, visits: &[SourceVisit.Visit], actual: &SourceVisit.Visit,
  directive: &SourceGraph.ResultUse, acquired: &[SourceInputAcquisition], state: &mut SourcePolicy.LoanState,
  loans: &[Loan], paths: &mut List<List<Step>>, context: &RetentionContext, holders: &mut SourceHolderProjection)
  -> SourceCallEffects ! OutOfMemoryError ? &mut Allocator | &mut Types {
  if actual.evaluation.index != directive.evaluation.index { return CompilerBug.panic(b"call dispatch changed its actual result") }
  let nodes = SourceGraph.Builder.preparation(&builder.*).body.nodes
  let locals = SourceGraph.Builder.preparation(&builder.*).body.locals
  let owner = SourceGraph.Builder.preparation(&builder.*).body.owner
  let supplied = SourceGraph.Builder.preparation(&builder.*).body.supplied
  let mut arguments = List<NodeId>.make()
  let mut typed = List<NodeId>.make()
  let mut callee = Option<NodeId>.none()
  let mut stores = false
  match move run shapeOf(nodes, actual.node) {
    Shape.Call {arguments: values, exact, signature, ..} => {
      arguments = move values
      stores = exact
      if signature { typed = run copyIds(List<NodeId>.asSlice(&arguments)) }
    }
    Shape.Invoke {callee: target, arguments: values, ..} => {
      arguments = move values
      callee = Option<NodeId>.some(target)
    }
    _ => { return CompilerBug.panic(b"call dispatch selected another ownership handler") }
  }
  let mut originating = actual.evaluation
  let mut storedOperation = usize.MAX
  let operations = List<SourceStores.Operation>.asSlice(&SourceGraph.Builder.stores(&builder.*).operations)
  let mut at = usize.ZERO
  while at < operations.length {
    if operations[at].evaluation.index == actual.evaluation.index {
      if storedOperation != usize.MAX { return CompilerBug.panic(b"actual call has duplicate retained-write operations") }
      storedOperation = at
      originating = operations[at].originating
    }
    at = at + usize.ONE
  }
  let origin = sourceVisitAt(visits, originating)
  let inputs = List<SourceVisit.Input>.asSlice(&origin.inputs)
  let args = List<NodeId>.asSlice(&arguments)
  let no = SourceProgram.atom(&mut builder.rules)
  let mut observation = SourceObservation {positions: List<SourceCarryPosition>.make(), other: List<SourceGraph.Input>.make(), unknown: no}
  let mut seen = List<usize>.make()
  let mut receiver = Option<usize>.none()
  at = usize.ZERO
  while at < inputs.length {
    let input = inputs[at]
    let ordinal = match input.read {
      Option<PreparedSources.InputRead>.Some {value: PreparedSources.InputRead.Argument {ordinal}} => ordinal
      Option<PreparedSources.InputRead>.Some {value: PreparedSources.InputRead.Receiver} => {
        match callee { Option<NodeId>.Some {..} => args.length _ => usize.ZERO }
      }
      _ => { return CompilerBug.panic(b"call input has no actual argument or receiver coordinate") }
    }
    let expected = if ordinal < args.length { args[ordinal] } else {
      match callee { Option<NodeId>.Some {value} => value _ => { return CompilerBug.panic(b"call input names an absent argument") } }
    }
    if input.node.index != expected.index || listsIndex(List<usize>.asSlice(&seen), ordinal) {
      return CompilerBug.panic(b"call input changed or repeated its actual operand coordinate")
    }
    run List<usize>.append(&mut seen, ordinal)
    if ordinal == args.length { receiver = Option<usize>.some(ordinal) }
    let observed = run sourceCallInput(&mut builder.*, origin, input, ordinal, acquired, &mut paths.*, loans.length)
    run sourceAppendObservation(&mut observation, move observed, &mut builder.rules)
    at = at + usize.ONE
  }
  let expected = args.length + match callee { Option<NodeId>.Some {..} => usize.ONE _ => usize.ZERO }
  if List<usize>.length(&seen) != expected { return CompilerBug.panic(b"call dispatch omitted an actual operand") }
  let sinks = run operandSinks(nodes, actual.node, args, owner)
  let placed = List<List<Step>>.make()
  let root = sourceNodeValueRoot(SourceGraph.Builder.preparation(&builder.*), actual.node)
  let finished = run sourceFinish(&mut builder.*, &observation, &mut state.*, loans, &mut paths.*, nodes, owner,
    supplied, List<RetentionEdge>.asSlice(&context.requirements), List<ImpliedGroup>.asSlice(&context.relations),
    context.settled, actual.node, actual.evaluation, root, actual.execute.index, directive.active, stores,
    Forwarding.None, List<List<Step>>.asSlice(&placed), List<NodeId>.asSlice(&typed), List<OperandSink>.asSlice(&sinks))
  let mut stored = SourceStoreEffects {intervals: List<SourceIntervalEffect>.make(), refusal: no, missing: no}
  if storedOperation != usize.MAX {
    stored = run sourceStoreIntoLent(&mut builder.*, storedOperation, &mut state.*, loans, locals, &mut paths.*, owner,
      List<RetentionEdge>.asSlice(&context.requirements), &mut holders.*)
  }
  return SourceCallEffects {finished: move finished, stored: move stored, inputs: move observation, callee: receiver}
}

// One finish operation on the reserved CFG. Retention observes its independent pre-result
// version; consume runs at execute even when no successful result completes. The source graph
// owns output transport, and the ordered result scan only binds its already-reserved ports.
//
// A Read directive owns one joined incoming component family. Observe that actual Input,
// attribute its canonical placement, then run the ordinary result policy at the separately
// reserved result/use point. Historical definitions never become separate operands, and a
// displaced read does not borrow the enclosing result's successful-completion identity.
effect fn sourceFinishRead<'body>(builder: &mut SourceGraph.Builder<'body>, directive: &SourceGraph.ResultUse,
  readRoot: PreparedSources.EndpointId, outputRoot: PreparedSources.EndpointId, point: usize,
  state: &mut SourcePolicy.LoanState, loans: &[Loan], paths: &mut List<List<Step>>, nodes: &[Node],
  owner: &DeclarationId, supplied: &[Shared<Lifetime>], requirements: &[RetentionEdge], relations: &[ImpliedGroup],
  settled: bool) -> SourceFinishEffects ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let read = match &directive.kind {
    SourceGraph.ResultKind.Read {read} => read
    _ => { return CompilerBug.panic(b"read finish requires its explicit semantic result directive") }
  }
  let source = SourceGraph.Builder.evaluation(&builder.*, read)
  let produced = SourceGraph.Builder.evaluation(&builder.*, directive.evaluation)
  let operand = match source.site {
    SourceGraph.EvaluationSite.Node {node} => node
    _ => { return CompilerBug.panic(b"read finish cannot attribute an entry parameter as an execution") }
  }
  let result = match produced.site {
    SourceGraph.EvaluationSite.Node {node} => node
    _ => { return CompilerBug.panic(b"read finish has no actual result expression") }
  }
  let inputs: [SourceOperand; 1] = [SourceOperand {node: operand, evaluation: read, root: readRoot, ordinal: usize.MAX}]
  let mut observation = run sourceObserve(&mut builder.*, &inputs, SourceGraph.ValuePhase.Input, &mut paths.*, loans.length)
  drop run sourceAttributeRead(&mut builder.*, &mut observation, &mut paths.*)
  let unplaced = List<List<Step>>.make()
  let untyped = List<NodeId>.make()
  let sinks = List<OperandSink>.make()
  return run sourceFinish(&mut builder.*, &observation, &mut state.*, loans, &mut paths.*, nodes, owner,
    supplied, requirements, relations, settled, result, directive.evaluation, outputRoot, point, directive.active,
    false, Forwarding.Matched, List<List<Step>>.asSlice(&unplaced), List<NodeId>.asSlice(&untyped),
    List<OperandSink>.asSlice(&sinks))
}

effect fn sourceFinish<'body>(builder: &mut SourceGraph.Builder<'body>, observation: &SourceObservation,
  state: &mut SourcePolicy.LoanState, loans: &[Loan], paths: &mut List<List<Step>>, nodes: &[Node],
  owner: &DeclarationId, supplied: &[Shared<Lifetime>], requirements: &[RetentionEdge], relations: &[ImpliedGroup],
  settled: bool, result: NodeId, evaluation: SourceGraph.EvalId, root: PreparedSources.EndpointId,
  point: usize, active: SourceAtom, stores: bool, forwarding: Forwarding, placed: &[List<Step>],
  typed: &[NodeId], sinks: &[OperandSink]) -> SourceFinishEffects
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let retained = run nodeRetains(nodes, result, owner)
  let written = run sourceKeepWritten(nodes, owner, result, observation, loans, active, &mut builder.rules)
  let observed = run sourceBarrier(observation, &mut state.*, active, &mut builder.rules)
  let snapshot = List<SourceQuality>.asSlice(&observed)
  let retention = run sourceKeepCarried(observation, snapshot, loans, List<List<Step>>.asSlice(&paths.*),
    owner, sinks, usize.MAX, point, active, &mut builder.rules)
  let empty = List<SourceAtom>.make()
  let unknown: [SourceAtom; 2] = [active, observation.unknown]
  let mut effects = SourceFinishEffects {retention: move retention, written: move written, intervals: List<SourceIntervalEffect>.make(),
    inputResults: List<SourcePositionResult>.make(),
    results: List<SourceResultEffect>.make(), wholeHolds: List<SourceWholeHold>.make(),
    sealed: List<Location>.make(), unheld: List<Location>.make(),
    missing: run SourcePolicy.conjunction(&mut builder.rules, &unknown, List<SourceAtom>.asSlice(&empty))}
  if !retained { run List<Location>.append(&mut effects.sealed, nodes[result.index].origin.location) }
  if let NodeKind.Expression {form: Expression.DirectCall {arguments, ..}, ..} = &nodes[result.index].kind {
    let operands = List<NodeId>.asSlice(&arguments)
    let mut at = usize.ZERO
    while at < operands.length {
      if !retainedOperand(nodes, result, at) {
        run List<Location>.append(&mut effects.unheld, nodes[operands[at].index].origin.location)
      }
      at = at + usize.ONE
    }
  }
  run sourceConsume(observation, point, active, &mut builder.rules, &mut effects.intervals)
  let declared = run sourceDeclaredSnapshot(&mut builder.*, observation, snapshot, loans, nodes, result)
  let declarations = List<SourceAtom>.asSlice(&declared)
  let routes = run sourceFinishRoutes(&mut builder.*, observation, declarations, nodes, result, evaluation, root, &mut paths.*)
  if !retained {
    // Even a non-retaining result has explicit policy obligations. Every Borrow output is
    // bound absent; authentic non-Borrow sources were preserved by sourceFinishRoutes.
    let no = SourceProgram.atom(&mut builder.rules)
    let list = List<SourceResultRoute>.asSlice(&routes)
    let mut at = usize.ZERO
    while at < list.length {
      let mut prior = usize.ZERO
      while prior < at && list[prior].policy != list[at].policy { prior = prior + usize.ONE }
      if prior == at {
        let port = SourceGraph.Builder.policy(&builder.*, list[at].policy)
        run SourceGraph.Builder.bindPolicy(&mut builder.*, port.id, no, no, no)
      }
      at = at + usize.ONE
    }
    return move effects
  }
  let mut regions = List<Shared<Lifetime>>.make()
  let known = run resultRegions(nodes, result, owner, &mut regions)
  let named = List<Shared<Lifetime>>.asSlice(&regions)
  let mut implied = noImplied()
  // This is immutable type evidence. Its use below remains gated by the symbolic unnamed
  // snapshot; computing it does not assert that any candidate source is actually present.
  if known && !stores && typed.length != usize.ZERO {
    implied = run callImplied(nodes, relations, settled, typed, result)
  }
  let no = SourceProgram.atom(&mut builder.rules)
  let facts = SourceResultFacts {stores: stores, known: known, outside: known && externalRegions(named, owner),
    forwarding: forwarding, placedCount: placed.length, impliedKnown: run sourceBoolean(&mut builder.rules, implied.known),
    mayOutlive: no, hasTyped: typed.length != usize.ZERO}
  let produced = SourceGraph.Builder.evaluation(&builder.*, evaluation)
  let completed = List<SourceControl.Point>.asSlice(&builder.reaching.points)[produced.point.index].reachable
  let scanned = run sourceFinishPositions(&mut builder.*, observation, &mut state.*, snapshot, loans, nodes, owner,
    supplied, requirements, relations, result, evaluation, named, &facts, &implied, declarations, placed, completed,
    List<SourceResultRoute>.asSlice(&routes))
  let missing: [SourceAtom; 2] = [effects.missing, scanned.missing]
  effects.missing = run SourcePolicy.disjunction(&mut builder.rules, &missing)
  effects.inputResults = move scanned.inputs
  effects.results = move scanned.outputs
  let finished = List<SourceResultEffect>.asSlice(&effects.results)
  let mut at = usize.ZERO
  while at < finished.length {
    run List<SourceWholeHold>.append(&mut effects.wholeHolds, SourceWholeHold {
      loan: finished[at].source.loan, result: result, active: finished[at].whole, described: finished[at].described})
    at = at + usize.ONE
  }
  return move effects
}

fn sourceDefinitionMatches(left: Option<SourceControl.DefinitionId>, right: Option<SourceControl.DefinitionId>) -> bool {
  return match left {
    Option<SourceControl.DefinitionId>.Some {value} => match right { Option<SourceControl.DefinitionId>.Some {value: other} => value.index == other.index _ => false }
    _ => match right { Option<SourceControl.DefinitionId>.None => true _ => false }
  }
}

fn sourceReadMatches(left: Option<SourceControl.ReadId>, right: Option<SourceControl.ReadId>) -> bool {
  return match left {
    Option<SourceControl.ReadId>.Some {value} => match right { Option<SourceControl.ReadId>.Some {value: other} => value.index == other.index _ => false }
    _ => match right { Option<SourceControl.ReadId>.None => true _ => false }
  }
}

// Only the original DirectCall (or its immediate Run) can make the declared-source claim.
// Matching the actual operand position also handles two evaluations of a reused NodeId.
fn sourceDeclaredArgument(nodes: &[Node], result: NodeId, position: &SourceCarryPosition) -> bool {
  let mut call = result
  if let NodeKind.Expression {form: Expression.Run {value, access}, ..} = &nodes[result.index].kind {
    if access == RunAccess.Immediate { call = value }
  }
  if let NodeKind.Expression {form: Expression.DirectCall {arguments, resultBorrows, ..}, ..} = &nodes[call.index].kind {
    let operands = List<NodeId>.asSlice(&arguments)
    if position.operand >= operands.length || operands[position.operand].index != position.node.index { return false }
    let declared = List<ResultBorrow>.asSlice(&resultBorrows)
    let mut at = usize.ZERO
    while at < declared.length {
      if declared[at].argument.index == position.node.index { return true }
      at = at + usize.ONE
    }
  }
  return false
}

// Snapshot Exact and an actual outer descriptor are independent requirements. A known region
// name or an arbitrary contract route cannot turn a nested content source into that descriptor.
effect fn sourceDeclaredSnapshot<'body>(builder: &mut SourceGraph.Builder<'body>, observation: &SourceObservation,
  snapshot: &[SourceQuality], loans: &[Loan], nodes: &[Node], result: NodeId) -> List<SourceAtom>
! OutOfMemoryError ? &mut Allocator {
  let positions = List<SourceCarryPosition>.asSlice(&observation.positions)
  if snapshot.length != positions.length { CompilerBug.panic(b"declared result lost its input snapshot") }
  let yes = run sourceBoolean(&mut builder.rules, true)
  let no = SourceProgram.atom(&mut builder.rules)
  let empty = List<SourceAtom>.make()
  let none = List<SourceAtom>.asSlice(&empty)
  let mut inputs = List<SourceParentInput>.make()
  let mut parents = List<SourceParentEdge>.make()
  let mut at = usize.ZERO
  while at < positions.length {
    let position = &positions[at]
    let actual = SourceGraph.Builder.value(&builder.*, position.value)
    let mut seed = no
    if sourceDeclaredArgument(nodes, result, position) && actual.endpoint.index == position.root.index {
      let prepared = SourceGraph.Builder.preparation(&builder.*)
      let endpoints = List<PreparedSources.Endpoint>.asSlice(&prepared.endpoints)
      let shapes = List<PreparedSources.Shape>.asSlice(&prepared.shapes)
      let outer = match &shapes[endpoints[actual.endpoint.index].shape.index].state {
        PreparedSources.ShapeState.Reference => true
        PreparedSources.ShapeState.Slice => true
        _ => false
      }
      if outer {
        if let Option<SourceGraph.ReferenceOrigin>.Some {value: origin} = SourceGraph.Builder.referenceOrigin(&builder.*, position.leaf) {
          let descriptor = SourceGraph.Builder.value(&builder.*, origin.descriptor)
          let created = match &SourceGraph.Builder.leaf(&builder.*, origin.leaf).kind {
            SourceGraph.SourceLeaf.Borrow {loan, ..} => loan == position.loan
            _ => false
          }
          if created && descriptor.endpoint.index == SourceGraph.Builder.leaf(&builder.*, position.leaf).endpoint.index {
            seed = yes
          }
        }
      }
    }
    let present: [SourceAtom; 1] = [snapshot[at].present]
    let lost: [SourceAtom; 2] = [snapshot[at].stored, snapshot[at].alternatives]
    let exact = run SourcePolicy.conjunction(&mut builder.rules, &present, &lost)
    run List<SourceParentInput>.append(&mut inputs,
      SourceParentInput {present: snapshot[at].present, seed: seed, eligible: exact})
    if let Option<Shared<Lifetime>>.Some {value: parent} = &loans[position.loan].parent {
      let mut candidate = usize.ZERO
      while candidate < positions.length {
        if positions[candidate].operand == position.operand {
          if let Option<Shared<Lifetime>>.Some {value: borrowed} = &loans[positions[candidate].loan].borrowed {
            if meetMember(&parent, &borrowed) {
              run List<SourceParentEdge>.append(&mut parents,
                SourceParentEdge {child: at, parent: candidate, applicable: yes})
            }
          }
        }
        candidate = candidate + usize.ONE
      }
    }
    at = at + usize.ONE
  }
  return run SourcePolicy.parents(&mut builder.rules, yes,
    List<SourceParentInput>.asSlice(&inputs), List<SourceParentEdge>.asSlice(&parents))
}

// Declared output placement follows ResultBorrow's complete field path, never an equal result
// lifetime. The ordinary output route and this indirect declared route remain distinct cases.
fn sourceDeclaredField(nodes: &[Node], result: NodeId, operand: NodeId, field: usize, paths: &[List<Step>]) -> bool {
  if field == usize.MAX || field >= paths.length { return false }
  let mut call = result
  if let NodeKind.Expression {form: Expression.Run {value, access}, ..} = &nodes[result.index].kind {
    if access == RunAccess.Immediate { call = value }
  }
  if let NodeKind.Expression {form: Expression.DirectCall {resultBorrows, ..}, ..} = &nodes[call.index].kind {
    let declared = List<ResultBorrow>.asSlice(&resultBorrows)
    let actual = List<Step>.asSlice(&paths[field])
    let mut at = usize.ZERO
    while at < declared.length {
      let fields = List<usize>.asSlice(&declared[at].fields)
      if declared[at].argument.index == operand.index && fields.length == actual.length {
        let mut each = usize.ZERO
        while each < fields.length && actual[each].kind == StepKind.Field && actual[each].ordinal == fields[each] {
          each = each + usize.ONE
        }
        if each == fields.length { return true }
      }
      at = at + usize.ONE
    }
  }
  return false
}

// Bind source identities to the graph's actual result transfers. This enumerates existing
// ports only; it cannot invent a contract edge or choose a source from equal region names.
effect fn sourceFinishRoutes<'body>(builder: &mut SourceGraph.Builder<'body>, observation: &SourceObservation,
  declarations: &[SourceAtom], nodes: &[Node], result: NodeId, evaluation: SourceGraph.EvalId,
  root: PreparedSources.EndpointId, paths: &mut List<List<Step>>) -> List<SourceResultRoute>
! OutOfMemoryError ? &mut Allocator {
  let positions = List<SourceCarryPosition>.asSlice(&observation.positions)
  if declarations.length != positions.length { CompilerBug.panic(b"result routes lost the declared-source snapshot") }
  let no = SourceProgram.atom(&mut builder.rules)
  let mut routes = List<SourceResultRoute>.make()
  let count = SourceGraph.Builder.policyCount(&builder.*)
  let mut at = usize.ZERO
  while at < count {
    let port = SourceGraph.Builder.policy(&builder.*, at)
    let target = SourceGraph.Builder.value(&builder.*, port.target)
    if port.terminal && target.evaluation.index == evaluation.index {
      let borrowed = match &SourceGraph.Builder.leaf(&builder.*, port.leaf).kind { SourceGraph.SourceLeaf.Borrow {..} => true _ => false }
      if !borrowed {
        // These are genuine caller/expression/loan-free/unknown sources. They follow their
        // authenticated route and never enter a Borrow count or global Loan precision state.
        run SourceGraph.Builder.bindPolicy(&mut builder.*, port.id,
          port.quality.present, port.quality.stored, port.quality.alternatives)
      } else {
        let mut position = usize.MAX
        let mut candidate = usize.ZERO
        while candidate < positions.length {
          if positions[candidate].value.index == port.source.index && positions[candidate].leaf.index == port.leaf.index {
            if position != usize.MAX { CompilerBug.panic(b"result port erased two distinct written input positions") }
            position = candidate
          }
          candidate = candidate + usize.ONE
        }
        if position == usize.MAX { CompilerBug.panic(b"result port has no actual input observation") }
        let placement = run sourceResultPlacement(&builder.*, port, root, &mut paths.*)
        let field = placement.field
        let mut declaration = no
        if let Option<PreparedSources.ContractRouteId>.Some {..} = port.contract {
          if sourceDeclaredField(nodes, result, positions[position].node, field, List<List<Step>>.asSlice(&paths.*)) {
            if port.outputDirect { CompilerBug.panic(b"declared result route manufactured a direct descriptor") }
            declaration = declarations[position]
          }
        }
        let histories = List<SourceCarryCase>.asSlice(&positions[position].cases)
        let mut found = false
        let mut history = usize.ZERO
        while history < histories.length {
          let actual = &histories[history].source
          if actual.direct == port.direct && sourceDefinitionMatches(actual.definition, port.definition)
            && sourceReadMatches(actual.read, port.read) {
            run List<SourceResultRoute>.append(&mut routes,
              SourceResultRoute {position: position, history: history, policy: at, field: field,
                wholeField: placement.whole, declared: declaration})
            found = true
          }
          history = history + usize.ONE
        }
        if !found { CompilerBug.panic(b"result port omitted its exact incoming source history") }
      }
    }
    at = at + usize.ONE
  }
  return move routes
}

// Finish's per-carry loop over actual positions. Snapshot predicates are emitted before this
// loop; every alternative history sees the same pre-version, then one advance publishes its
// joined effects. A later real operand of the same loan observes that advance.
effect fn sourceFinishPositions<'body>(builder: &mut SourceGraph.Builder<'body>, observation: &SourceObservation,
  state: &mut SourcePolicy.LoanState, observed: &[SourceQuality], loans: &[Loan], nodes: &[Node],
  owner: &DeclarationId, supplied: &[Shared<Lifetime>], requirements: &[RetentionEdge], relations: &[ImpliedGroup],
  result: NodeId, evaluation: SourceGraph.EvalId, named: &[Shared<Lifetime>], facts: &SourceResultFacts, implied: &Implied, declared: &[SourceAtom],
  placed: &[List<Step>], completed: SourceAtom, routes: &[SourceResultRoute])
  -> SourceResultScan ! OutOfMemoryError ? &mut Allocator {
  let positions = List<SourceCarryPosition>.asSlice(&observation.positions)
  if observed.length != positions.length || declared.length != positions.length {
    CompilerBug.panic(b"result scan lost its pre-operation observation")
  }
  let mut inputs = List<SourceResultInput>.make()
  let mut at = usize.ZERO
  while at < positions.length {
    run List<SourceResultInput>.append(&mut inputs,
      SourceResultInput {loan: positions[at].loan, operand: positions[at].operand, quality: observed[at]})
    at = at + usize.ONE
  }
  let mut snapshot = run sourceResultSnapshot(nodes, owner, supplied, loans, List<SourceResultInput>.asSlice(&inputs),
    named, requirements, result, facts.known, facts.stores, facts.outside, &mut builder.rules)
  let empty = List<SourceAtom>.make()
  let none = List<SourceAtom>.asSlice(&empty)
  // Unknown is a real source alternative. Omitting it from Borrow count cannot certify an
  // all-source release; its possible applicability blocks the completed-source predicate.
  let complete: [SourceAtom; 1] = [snapshot.complete]
  let unknown: [SourceAtom; 1] = [observation.unknown]
  snapshot.complete = run SourcePolicy.conjunction(&mut builder.rules, &complete, &unknown)
  let mut effects = List<SourceResultEffect>.make()
  let mut inputEffects = List<SourcePositionResult>.make()
  let mut gaps = List<SourceAtom>.make()
  at = usize.ZERO
  while at < positions.length {
    let position = &positions[at]
    let histories = List<SourceCarryCase>.asSlice(&position.cases)
    let mut losses = List<SourcePolicy.Precision>.make()
    if histories.length == usize.ZERO {
      let unsupported: [SourceAtom; 2] = [completed, observed[at].present]
      run List<SourceAtom>.append(&mut gaps, run SourcePolicy.conjunction(&mut builder.rules, &unsupported, none))
    }
    let mut history = usize.ZERO
    while history < histories.length {
      let actual = &histories[history]
      // Input decisions are independent of whether a result route was enumerated. They
      // observe one immutable pre-position P; publication cannot erase their side effects.
      let present: [SourceAtom; 3] = [completed, observed[at].present, actual.source.quality.present]
      let applicable = run SourcePolicy.conjunction(&mut builder.rules, &present, none)
      let before = SourcePolicy.LoanState.quality(&state.*, position.loan, applicable)
      let source = SourceResultCase {quality: before, operand: position.operand,
        retained: retainedOperand(nodes, result, position.operand), field: actual.field,
        wholeField: sourceWholePlacement(facts.forwarding, position.operand, actual.field, placed), declared: declared[at]}
      let mut impliedKnown = SourceProgram.atom(&mut builder.rules)
      if facts.known && !facts.stores && facts.hasTyped && implied.known {
        let gate: [SourceAtom; 2] = [snapshot.naming.unnamed, facts.impliedKnown]
        impliedKnown = run SourcePolicy.conjunction(&mut builder.rules, &gate, none)
      }
      let localFacts = SourceResultFacts {stores: facts.stores, known: facts.known, outside: facts.outside,
        forwarding: facts.forwarding, placedCount: facts.placedCount, impliedKnown: impliedKnown,
        mayOutlive: run sourceBoolean(&mut builder.rules,
          run mayOutlive(implied, List<Shared<Lifetime>>.asSlice(&loans[position.loan].regions), named, owner)),
        hasTyped: facts.hasTyped}
      let decision = run sourceResultDecision(&loans[position.loan], &source, &localFacts, &snapshot, at,
        owner, named, relations, &mut builder.rules)
      let loss = SourcePolicy.Precision {stored: decision.addStored, alternatives: decision.addAlternatives}
      run List<SourcePolicy.Precision>.append(&mut losses, loss)
      let caseLoss: [SourcePolicy.Precision; 1] = [loss]
      let afterCase = run SourcePolicy.advance(&mut builder.rules,
        SourcePolicy.Precision {stored: before.stored, alternatives: before.alternatives}, &caseLoss)
      let mut publications = List<SourceAtom>.make()
      let mut route = usize.ZERO
      while route < routes.length {
        let output = &routes[route]
        if output.position == at && output.history == history {
          let port = SourceGraph.Builder.policy(&builder.*, output.policy)
          if port.source.index != position.value.index || port.leaf.index != position.leaf.index
            || port.direct != actual.source.direct
            || !sourceDefinitionMatches(port.definition, actual.source.definition)
            || !sourceReadMatches(port.read, actual.source.read) {
            CompilerBug.panic(b"result policy cross-paired its physical input and reserved route")
          }
          let target = SourceGraph.Builder.value(&builder.*, port.target)
          let evaluation = SourceGraph.Builder.evaluation(&builder.*, target.evaluation)
          let produced = List<SourceControl.Point>.asSlice(&builder.reaching.points)[evaluation.point.index].reachable
          // A declared carry publishes only at the independently authenticated ResultBorrow
          // field. That admission is source provenance, never a returned referent address.
          let declaredOutput: [SourceAtom; 1] = [decision.declared]
          let ordinary = run SourcePolicy.conjunction(&mut builder.rules, none, &declaredOutput)
          let choices: [SourceAtom; 2] = [ordinary, output.declared]
          let permitted = run SourcePolicy.disjunction(&mut builder.rules, &choices)
          let authority: [SourceAtom; 4] = [produced, port.active, port.quality.present, permitted]
          let published = run SourcePolicy.conjunction(&mut builder.rules, &authority, none)
          run List<SourceAtom>.append(&mut publications, published)
          let retained: [SourceAtom; 2] = [decision.kept, published]
          let kept = run SourcePolicy.conjunction(&mut builder.rules, &retained, none)
          let wholeField = run sourceBoolean(&mut builder.rules, output.wholeField)
          let held: [SourceAtom; 3] = [decision.whole, kept, wholeField]
          let whole = run SourcePolicy.conjunction(&mut builder.rules, &held, none)
          run List<SourceResultEffect>.append(&mut effects, SourceResultEffect {
            source: sourceEffectSource(position, actual), policy: output.policy, target: port.target,
            field: output.field, direct: port.outputDirect, whole: whole, described: decision.described,
            quality: SourceQuality {present: kept, stored: afterCase.stored, alternatives: afterCase.alternatives}})
        }
        route = route + usize.ONE
      }
      let missing = run sourceResultCoverage(&mut builder.rules, decision.kept, List<SourceAtom>.asSlice(&publications))
      run List<SourceAtom>.append(&mut gaps, missing)
      run List<SourcePositionResult>.append(&mut inputEffects, SourcePositionResult {
        result: evaluation, position: at, source: sourceEffectSource(position, actual), decision: move decision, missing: missing})
      history = history + usize.ONE
    }
    drop run SourcePolicy.LoanState.finishPosition(&mut state.*, &mut builder.rules, position.loan,
      List<SourcePolicy.Precision>.asSlice(&losses))
    at = at + usize.ONE
  }
  // A port may have several paired predecessor histories. Bind its union once, after those
  // histories have all decided; binding one history must not erase another possible output.
  let decisions = List<SourceResultEffect>.asSlice(&effects)
  at = usize.ZERO
  while at < decisions.length {
    let policy = decisions[at].policy
    let mut prior = usize.ZERO
    while prior < at && decisions[prior].policy != policy { prior = prior + usize.ONE }
    if prior == at {
      let mut kept = List<SourceAtom>.make()
      let mut stored = List<SourceAtom>.make()
      let mut alternatives = List<SourceAtom>.make()
      let mut each = at
      while each < decisions.length {
        if decisions[each].policy == policy {
          run List<SourceAtom>.append(&mut kept, decisions[each].quality.present)
          let store: [SourceAtom; 2] = [decisions[each].quality.present, decisions[each].quality.stored]
          let alternate: [SourceAtom; 2] = [decisions[each].quality.present, decisions[each].quality.alternatives]
          run List<SourceAtom>.append(&mut stored, run SourcePolicy.conjunction(&mut builder.rules, &store, none))
          run List<SourceAtom>.append(&mut alternatives, run SourcePolicy.conjunction(&mut builder.rules, &alternate, none))
        }
        each = each + usize.ONE
      }
      let port = SourceGraph.Builder.policy(&builder.*, policy)
      let kept = run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&kept))
      let stored = run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&stored))
      let alternatives = run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&alternatives))
      run SourceGraph.Builder.bindPolicy(&mut builder.*, port.id, kept, stored, alternatives)
    }
    at = at + usize.ONE
  }
  return SourceResultScan {inputs: move inputEffects, outputs: move effects,
    missing: run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&gaps))}
}

// This is the owning finish handler's original pre-placement, before any declared output
// expansion. It does not assert that a source can reach a result or manufacture a port.
fn sourceWholePlacement(forwarding: Forwarding, operand: usize, field: usize, placed: &[List<Step>]) -> bool {
  if forwarding == Forwarding.Matched { return field == usize.ZERO }
  if operand < placed.length { return field == usize.ZERO && List<Step>.length(&placed[operand]) == usize.ZERO }
  return true
}

// Missing output authority is not a source-policy drop. In particular zero candidate ports
// cannot erase a retained input's effects or certify that its source is absent.
effect fn sourceResultCoverage(rules: &mut SourceProgram, kept: SourceAtom, publications: &[SourceAtom]) -> SourceAtom
! OutOfMemoryError ? &mut Allocator {
  let published = run SourcePolicy.disjunction(&mut rules.*, publications)
  let retained: [SourceAtom; 1] = [kept]
  let available: [SourceAtom; 1] = [published]
  return run SourcePolicy.conjunction(&mut rules.*, &retained, &available)
}

effect fn sourceBoolean(rules: &mut SourceProgram, value: bool) -> SourceAtom
! OutOfMemoryError ? &mut Allocator {
  let result = SourceProgram.atom(rules)
  if value { run SourceProgram.fact(rules, result) }
  return result
}

// The ResultDecision predicates which depend only on immutable loan/type/placement evidence
// retain their original helpers. Conditional source, precision and operation state become
// rules; no possible/undefined witness is sampled as a Boolean in this translation.
effect fn sourceResultDecision(loan: &Loan, actual: &SourceResultCase, facts: &SourceResultFacts,
  snapshot: &SourceResultSnapshot, position: usize, owner: &DeclarationId,
  named: &[Shared<Lifetime>], relations: &[ImpliedGroup], rules: &mut SourceProgram)
  -> SourcePolicy.ResultOutput ! OutOfMemoryError ? &mut Allocator {
  let required = List<SourceAtom>.asSlice(&snapshot.required)
  let parents = List<SourceAtom>.asSlice(&snapshot.parents)
  if position >= required.length || position >= parents.length {
    return CompilerBug.panic(b"result policy has no source-position snapshot")
  }
  let no = SourceProgram.atom(rules)
  let empty = List<SourceAtom>.make()
  let none = List<SourceAtom>.asSlice(&empty)
  let regions = List<Shared<Lifetime>>.asSlice(&loan.regions)
  let shared = run sourceBoolean(rules, sharesAtom(regions, named))
  let names: [SourceAtom; 2] = [shared, required[position]]
  let mut namedSource = no
  if regions.length != usize.ZERO { namedSource = run SourcePolicy.disjunction(rules, &names) }
  let mut placedSeveral = no
  if facts.forwarding == Forwarding.Operands && actual.operand < facts.placedCount {
    let placed: [SourceAtom; 2] = [snapshot.naming.several, namedSource]
    placedSeveral = run SourcePolicy.conjunction(rules, &placed, none)
  }
  let sameOperand = run SourceNaming.operand(&snapshot.naming, rules, actual.operand)
  let single: [SourceAtom; 2] = [sameOperand, namedSource]
  let notSeveral: [SourceAtom; 1] = [snapshot.naming.several]
  let namedSingle = run SourcePolicy.conjunction(rules, &single, &notSeveral)
  let mut mayRelease = false
  if loan.local && regions.length == usize.ONE {
    if let Option<Shared<Lifetime>>.None = &loan.parent {
      if let Option<Shared<Lifetime>>.Some {value: borrowed} = &loan.borrowed {
        mayRelease = retentionOrdinal(&borrowed, owner) != usize.MAX
          && Lifetime.equalsShared(&regions[0], &borrowed) && !proofContains(named, &borrowed)
      }
    }
  }
  let mut unneeded = no
  if mayRelease {
    let present: [SourceAtom; 1] = [actual.quality.present]
    let blocked: [SourceAtom; 4] = [actual.quality.stored, actual.quality.alternatives, parents[position], required[position]]
    unneeded = run SourcePolicy.conjunction(rules, &present, &blocked)
  }
  let mut alternatives = no
  if facts.known {
    let ambiguous: [SourceAtom; 2] = [snapshot.naming.several, namedSource]
    let ambiguousSource = run SourcePolicy.conjunction(rules, &ambiguous, none)
    let reasons: [SourceAtom; 2] = [ambiguousSource, parents[position]]
    alternatives = run SourcePolicy.disjunction(rules, &reasons)
  }
  let forwarded = facts.forwarding == Forwarding.Operands
    || (facts.forwarding == Forwarding.Matched && actual.field != usize.MAX)
  let input = SourcePolicy.ResultInput {quality: actual.quality,
    stores: run sourceBoolean(rules, facts.stores), retained: run sourceBoolean(rules, actual.retained), required: required[position],
    known: run sourceBoolean(rules, facts.known), outside: run sourceBoolean(rules, facts.outside),
    forwarded: run sourceBoolean(rules, forwarded), local: run sourceBoolean(rules, loan.local),
    matched: run sourceBoolean(rules, facts.forwarding == Forwarding.Matched),
    outlivesResult: run sourceBoolean(rules, outlivesResult(relations, regions, named)), declared: actual.declared,
    body: run sourceBoolean(rules, bodyRegions(regions, owner)), complete: snapshot.complete, unneeded: unneeded,
    placedSeveral: placedSeveral, namedSingle: namedSingle, impliedKnown: facts.impliedKnown,
    ancestor: parents[position], mayOutlive: facts.mayOutlive, alternatives: alternatives,
    wholeField: run sourceBoolean(rules, actual.wholeField),
    forwardingNone: run sourceBoolean(rules, facts.forwarding == Forwarding.None), hasTyped: run sourceBoolean(rules, facts.hasTyped)}
  return run SourcePolicy.result(rules, &input)
}

// Emits the original source-dependent snapshot guards into the common program. Metadata-only
// predicates keep their existing implementation; actual presence and quality remain atoms.
effect fn sourceResultSnapshot(nodes: &[Node], owner: &DeclarationId, supplied: &[Shared<Lifetime>],
  loans: &[Loan], inputs: &[SourceResultInput], named: &[Shared<Lifetime>], edges: &[RetentionEdge],
  result: NodeId, known: bool, stores: bool, outside: bool, rules: &mut SourceProgram) -> SourceResultSnapshot
! OutOfMemoryError ? &mut Allocator {
  let yes = SourceProgram.atom(rules)
  let no = SourceProgram.atom(rules)
  run SourceProgram.fact(rules, yes)
  let empty = List<SourceAtom>.make()
  let none = List<SourceAtom>.asSlice(&empty)
  let missing = SourceProgram.atom(rules)
  let mut at = usize.ZERO
  while at < inputs.length {
    let loan = &loans[inputs[at].loan]
    if let Option<Shared<Lifetime>>.Some {value: borrowed} = &loan.borrowed {
      if retentionOrdinal(&borrowed, owner) != usize.MAX
        && !sharesAtom(List<Shared<Lifetime>>.asSlice(&loan.regions), named) {
        let actual: [SourceAtom; 1] = [inputs[at].quality.present]
        run SourceProgram.rule(rules, missing, &actual, none)
      }
    }
    at = at + usize.ONE
  }
  let mut closure = List<usize>.make()
  if known && !stores && edges.length != usize.ZERO { closure = run retentionClosure(named, owner, edges) }
  let mut required = List<SourceAtom>.make()
  let mut namingInputs = List<SourceNamingInput>.make()
  at = usize.ZERO
  while at < inputs.length {
    let input = inputs[at]
    let loan = &loans[input.loan]
    let regions = List<Shared<Lifetime>>.asSlice(&loan.regions)
    let needed = SourceProgram.atom(rules)
    if requiredLoan(loan, owner, List<usize>.asSlice(&closure)) {
      let actual: [SourceAtom; 2] = [missing, input.quality.present]
      run SourceProgram.rule(rules, needed, &actual, none)
    }
    run List<SourceAtom>.append(&mut required, needed)
    let mut retained = no
    if retainedOperand(nodes, result, input.operand) { retained = yes }
    let heldInputs: [SourceAtom; 2] = [retained, needed]
    let held = run SourcePolicy.disjunction(rules, &heldInputs)
    let names = SourceProgram.atom(rules)
    if regions.length == usize.ZERO || sharesAtom(regions, named) {
      let matches: [SourceAtom; 1] = [held]
      run SourceProgram.rule(rules, names, &matches, none)
    }
    let throughRequired: [SourceAtom; 1] = [needed]
    run SourceProgram.rule(rules, names, &throughRequired, none)
    let mut unnamed = no
    if bodyRegions(regions, owner) { unnamed = held }
    run List<SourceNamingInput>.append(&mut namingInputs,
      SourceNamingInput {present: input.quality.present, names: names, unnamed: unnamed, operand: input.operand})
    at = at + usize.ONE
  }
  let naming = run SourcePolicy.naming(rules, List<SourceNamingInput>.asSlice(&namingInputs))
  let mut parentGate = no
  if known && !stores { parentGate = naming.multiple }
  let mut parentInputs = List<SourceParentInput>.make()
  let mut parentEdges = List<SourceParentEdge>.make()
  at = usize.ZERO
  while at < inputs.length {
    let loan = &loans[inputs[at].loan]
    let mut seed = no
    if let Option<Shared<Lifetime>>.Some {value: borrowed} = &loan.borrowed {
      if proofContains(named, &borrowed) { seed = yes }
    }
    run List<SourceParentInput>.append(&mut parentInputs,
      SourceParentInput {present: inputs[at].quality.present, seed: seed, eligible: yes})
    if let Option<Shared<Lifetime>>.Some {value: parent} = &loan.parent {
      let mut candidate = usize.ZERO
      while candidate < inputs.length {
        if let Option<Shared<Lifetime>>.Some {value: borrowed} = &loans[inputs[candidate].loan].borrowed {
          if meetMember(&parent, &borrowed) {
            run List<SourceParentEdge>.append(&mut parentEdges,
              SourceParentEdge {child: at, parent: candidate, applicable: yes})
          }
        }
        candidate = candidate + usize.ONE
      }
    }
    at = at + usize.ONE
  }
  let parents = run SourcePolicy.parents(rules, parentGate, List<SourceParentInput>.asSlice(&parentInputs),
    List<SourceParentEdge>.asSlice(&parentEdges))
  let mut qualities = List<SourceQuality>.make()
  at = usize.ZERO
  while at < inputs.length {
    run List<SourceQuality>.append(&mut qualities, inputs[at].quality)
    at = at + usize.ONE
  }
  let mut requirements = List<SourceRequirement>.make()
  let mut domainsKnown = true
  at = usize.ZERO
  while at < named.length {
    let domain = regionDomain(&named[at], owner, supplied)
    if domain == RegionDomain.Unknown { domainsKnown = false }
    if domain == RegionDomain.Local {
      let mut candidates = List<usize>.make()
      let mut input = usize.ZERO
      while input < inputs.length {
        let loan = &loans[inputs[input].loan]
        if let Option<Shared<Lifetime>>.Some {value: borrowed} = &loan.borrowed {
          if Lifetime.equalsShared(&borrowed, &named[at])
            && proofContains(List<Shared<Lifetime>>.asSlice(&loan.regions), &borrowed) {
            run List<usize>.append(&mut candidates, input)
          }
        }
        input = input + usize.ONE
      }
      run List<SourceRequirement>.append(&mut requirements, SourceRequirement {candidates: move candidates})
    }
    at = at + usize.ONE
  }
  let unnamedOperand = run SourceNaming.operand(&naming, rules, usize.MAX)
  let mut originalGate = no
  if known && !stores && !outside { originalGate = naming.multiple }
  let positive: [SourceAtom; 1] = [originalGate]
  let negative: [SourceAtom; 2] = [naming.several, unnamedOperand]
  let completeGate = run SourcePolicy.conjunction(rules, &positive, &negative)
  let complete = run SourcePolicy.completeSources(rules, completeGate, domainsKnown,
    List<SourceQuality>.asSlice(&qualities), List<SourceRequirement>.asSlice(&requirements))
  return SourceResultSnapshot {required: move required, parents: move parents, naming: move naming, complete: complete}
}

effect fn resultDecision(loan: &Loan, carry: Carry, facts: &ResultFacts, owner: &DeclarationId,
  named: &[Shared<Lifetime>], requiredSources: &[usize], relations: &[ImpliedGroup], implied: &Implied, field: usize, hasTyped: bool) -> ResultDecision
! OutOfMemoryError ? &mut Allocator {
  let mut precision = loan.precision
  let mut bound = false
  let mut kept = true
  let mut exact = false
  let mut dropped = false
  if facts.stores {
    exact = true
  } else if !facts.retained && !requiredLoan(loan, owner, requiredSources) {
    kept = false
  } else if facts.known {
    let regionsOf = List<Shared<Lifetime>>.asSlice(&loan.regions)
    let forwarded = facts.forwarding == Forwarding.Operands
      || (facts.forwarding == Forwarding.Matched && carry.field != usize.MAX)
    if facts.outside && forwarded && loan.local {
      // A value built from its operands holds their loans, as does a value read from where a
      // loan is held, and a loan of storage this body owns cannot outlive a caller region
      // whatever typing related: the result keeps it exactly so the walk reports where it
      // escapes (OWN0019).
      exact = true
    } else if facts.outside && loan.local && facts.forwarding != Forwarding.Matched
      && outlivesResult(relations, regionsOf, named) {
      // A call or `run` result that can retain the loan holds a loan of storage this body owns
      // when typing requires the loan's own region to outlive a region the result names:
      // typing bound the result to caller regions only, which no solution lets the loan
      // outlive. The result keeps it exactly, as when the binding names the loan's own
      // region, so the walk reports where it escapes (OWN0019) rather than leaving the
      // relation unproved, unless the return-slot refutation decides it (`Loan.bound`). A
      // value read from where the loan lies somewhere within is not that result: it may be a
      // part the loan does not reach.
      exact = true
      bound = true
    } else if facts.declared {
      // An authenticated declared source survives filtering by instantiated result atoms.
      // Owned-storage escape and bound diagnostics above retain their original precedence.
      exact = true
    } else if facts.outside && (loan.local || bodyRegions(regionsOf, owner)) {
      kept = false
      dropped = true
    } else if facts.complete && unneededOwnedLoan(loan, owner, named, requiredSources, facts.ancestor) {
      kept = false
    } else if facts.several && facts.forwarding == Forwarding.Operands && carry.operand < facts.placedCount
      && regionsOf.length > usize.ZERO && (sharesAtom(regionsOf, named) || requiredLoan(loan, owner, requiredSources)) {
      // A value built from its operands holds each operand's loans exactly where it places
      // them, however many of them name a result region; only a call's result leaves open
      // which of them it retains.
      exact = true
    } else if !facts.several && facts.naming == carry.operand && regionsOf.length > usize.ZERO
      && (sharesAtom(regionsOf, named) || requiredLoan(loan, owner, requiredSources)) {
      exact = true
    } else if implied.known && loan.precision == LoanPrecision.Exact
      && !facts.ancestor && !requiredLoan(loan, owner, requiredSources)
      && bodyRegions(regionsOf, owner) && !run mayOutlive(implied, regionsOf, named, owner) {
      kept = false
    }
  }
  if kept {
    if !exact {
      let regionsOf = List<Shared<Lifetime>>.asSlice(&loan.regions)
      let ancestor = facts.ancestor
      let alternatives = facts.known && ((facts.several && regionsOf.length > usize.ZERO
        && (sharesAtom(regionsOf, named) || requiredLoan(loan, owner, requiredSources))) || ancestor)
      if alternatives {
        // All possible operands are retained. Preserve prior uncertainty: a later call
        // cannot repair a mapping already lost at another operation.
        if loan.precision == LoanPrecision.Exact { precision = LoanPrecision.Alternatives }
        else if loan.precision == LoanPrecision.Stored { precision = LoanPrecision.Unknown }
      } else {
        precision = LoanPrecision.Unknown
      }
    }
  }
  let declared = !facts.stores && facts.declared
  return ResultDecision {kept: kept, precision: precision, bound: bound, unretained: dropped,
    declared: declared, whole: kept && !declared && field == usize.ZERO && facts.forwarding != Forwarding.Matched,
    described: !facts.stores && facts.forwarding == Forwarding.None && hasTyped}
}

// Consumes carried loans at a fresh point for `result`, which keeps carrying the loans it can
// retain (VIEW-002), so a returned view holds its source loan through its last use. Typing gives the
// result its instantiated regions, with the callee's bounds, type arguments and elisions applied:
// - A result whose regions are all static or enclosing/own lifetime parameters, or that is one
//   of its type parameters, holds no loan of a body local or with a body region, which cannot
//   outlive them; the region slice proves that relation. A result that `forwards` its operands'
//   values (an aggregate or an operator) is the exception for a loan of storage the body owns:
//   the value still holds it, so it keeps flowing exactly and its storage end reports the escape.
//   So is a call or `run` result that can retain such a loan when typing requires the loan's
//   region to outlive a result region: typing's binding to caller regions then demands what no
//   solution gives.
//   A read place does not forward: reading through a borrow of a local carries that borrow's
//   loan, which a value copied out of it does not hold.
// - When exactly one operand's loans name a result region, the result may hold them: a conflict
//   rejects.
// - A declared result preserves authenticated finite sources, including reborrow ancestors,
//   through shared views and stored inputs. This proof precedes inference of call atoms.
// - Other operands naming a known result form a complete union of possible source loans.
//   The region proof must check all of them, while a conflict with one remains imprecise:
//   sharing a fresh call atom does not prove which operand the result actually retains.
// - Other undecided retention stays unknown, including callable capture loans whose regions
//   the result type does not name. Unknown retention cannot participate in a region proof.
// - A loan whose regions are all body regions, of a call whose signature types it, is not held when
//   none of them can outlive a result region. Typing relates two body regions only by equality or
//   a meet, which shares an atom, or by a region relation it leaves open, so a callee can reach a
//   result region only through those relations and the outlives facts its parameter and result
//   types imply: a reference's or slice's referent outlives its region, and a nominal's arguments
//   may outlive one another. If they lead the loan's regions to a result region, or to a region
//   from outside the body, whose premises the walk does not read, the loan stays carried,
//   approximately. Retained capture contents relate regions in ways the walk does not describe, so
//   a body with them keeps every such loan.
// - A direct call's result holds no loan an operand carries when the callee's declared signature,
//   with its lifetime binders distinct, relates none of that argument's regions to a region its
//   result names, through its bounds and the bounds its types imply (typing's `retained`). The
//   callee's body is proved against that signature, so typing's region relations cannot route the
//   loan into the result, whatever atoms they share; a loan the region requirements need stays.
// A `stores` result keeps every operand, as the Effect an `effect fn` call constructs does, so it
// keeps all their loans exactly whatever regions its type names.
effect fn finish(nodes: &[Node], owner: &DeclarationId, walker: &mut Walker, result: NodeId, at: usize, carried: &List<Carry>,
  stores: bool, forwarding: Forwarding, placed: &[List<Step>], typed: &[NodeId], sinks: &[OperandSink]) -> Flow
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let point = run newPoint(&mut walker.*, at)
  let mut onward = List<Carry>.make()
  if !run nodeRetains(nodes, result, owner) {
    run List<Location>.append(&mut walker.sealed, nodes[result.index].origin.location)
  }
  run recordUnheld(nodes, &mut walker.*, result)
  // A loan a call can keep in a universal region must outlive the body; one that reaches a call this
  // walk cannot describe leaves the body unchecked.
  run keepCarried(&mut walker.*, owner, List<Carry>.asSlice(carried), sinks, usize.MAX, point)
  if List<Carry>.length(carried) > usize.ZERO {
    run consume(&mut walker.*, List<Carry>.asSlice(carried), point)
    let retained = run nodeRetains(nodes, result, owner)
    if retained {
      let mut regions = List<Shared<Lifetime>>.make()
      let known = run resultRegions(nodes, result, owner, &mut regions)
      let named = List<Shared<Lifetime>>.asSlice(&regions)
      let outside = known && externalRegions(named, owner)
      let loans = List<Carry>.asSlice(carried)
      let mut parents = List<bool>.make()
      if known && !stores && loans.length > usize.ONE {
        parents = run retainedParents(List<Loan>.asSlice(&walker.loans), loans, named)
      }
      let supported = List<bool>.asSlice(&parents)
      let declared = run declaredResultLoans(nodes, result, loans, List<Loan>.asSlice(&walker.loans), owner)
      let declaredSources = List<bool>.asSlice(&declared)
      let mut required = List<usize>.make()
      if known && !stores {
        required = run requiredRetainedRegions(List<Loan>.asSlice(&walker.loans), loans, named, owner,
          List<RetentionEdge>.asSlice(&walker.requirements))
      }
      let requiredSources = List<usize>.asSlice(&required)
      // The one operand whose loans may name a result region, or `usize.MAX`.
      let mut naming = usize.MAX
      let mut several = false
      // Whether a loan has body regions that no result region shares.
      let mut unnamed = false
      let mut index = usize.ZERO
      while index < loans.length {
        let all = List<Loan>.asSlice(&walker.loans)
        let regionsOf = List<Shared<Lifetime>>.asSlice(&all[loans[index].loan].regions)
        // A loan the result cannot hold names none of its regions.
        let held = retainedOperand(nodes, result, loans[index].operand) || requiredLoan(&all[loans[index].loan], owner, requiredSources)
        if held && (regionsOf.length == usize.ZERO || sharesAtom(regionsOf, named)
          || requiredLoan(&all[loans[index].loan], owner, requiredSources)) {
          if naming == usize.MAX {
            naming = loans[index].operand
          } else if naming != loans[index].operand {
            several = true
          }
        } else if held && bodyRegions(regionsOf, owner) {
          unnamed = true
        }
        index = index + usize.ONE
      }
      let complete = known && !stores && !outside && !several && naming != usize.MAX && loans.length > usize.ONE
        && completeLocalResultSources(List<Loan>.asSlice(&walker.loans), loans, named, owner, List<Shared<Lifetime>>.asSlice(&walker.supplied))
      let mut implied = noImplied()
      if unnamed && known && !stores && typed.length > usize.ZERO {
        implied = run callImplied(nodes, List<ImpliedGroup>.asSlice(&walker.retentionRelations), walker.settled, typed, result)
      }
      index = usize.ZERO
      while index < loans.length {
        let loan = loans[index].loan
        // Where the result holds the loan: where a read found it, under its operand's place in a
        // built aggregate, or somewhere within the whole result.
        let mut field = usize.ZERO
        let mut direct = false
        if forwarding == Forwarding.Matched {
          field = loans[index].field
          direct = loans[index].direct
        } else if loans[index].operand < placed.length {
          field = run prefixedPath(&mut walker.*, List<Step>.asSlice(&placed[loans[index].operand]), loans[index].field)
          direct = loans[index].direct
        }
        direct = direct && field != usize.MAX
        let facts = ResultFacts {stores: stores, known: known, outside: outside, forwarding: forwarding,
          placedCount: placed.length, naming: naming, several: several, complete: complete,
          retained: retainedOperand(nodes, result, loans[index].operand),
          declared: index < declaredSources.length && declaredSources[index],
          ancestor: index < supported.length && supported[index]}
        let decision = run resultDecision(&List<Loan>.asSlice(&walker.loans)[loan], loans[index], &facts,
          owner, named, requiredSources, List<ImpliedGroup>.asSlice(&walker.retentionRelations), &implied, field, typed.length > usize.ZERO)
        let mut all = List<Loan>.asMutSlice(&mut walker.loans)
        if decision.bound { all[loan].bound = true }
        all[loan].precision = decision.precision
        if decision.kept {
          if decision.declared {
            run declaredResultCarries(nodes, result, &mut walker.*, loans[index], point, &mut onward)
          } else {
            run List<Carry>.append(&mut onward, Carry {loan: loan, since: point, operand: usize.MAX, definition: loans[index].definition, read: loans[index].read, field: field, direct: direct})
          }
          if decision.whole {
            run List<WholeHold>.append(&mut walker.wholeHolds, WholeHold {loan: loan, result: result,
              described: decision.described})
          }
        }
        if decision.unretained { run List<usize>.append(&mut walker.unretained, loan) }
        index = index + usize.ONE
      }
    }
  }
  return Flow {at: point, carried: move onward}
}

// The regions a field or pattern binding read holds as its place is declared, the subject's type
// instantiated into the field's declared type before typing fits the read's own type to its use;
// unknown for any other read, or when the declared type's regions are unknown.
struct DeclaredRead {
  known: bool
  regions: List<Shared<Lifetime>>
}

effect fn declaredRead(nodes: &[Node], read: NodeId, owner: &DeclarationId) -> DeclaredRead
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut regions = List<Shared<Lifetime>>.make()
  let mut known = false
  if let NodeKind.Expression {form, ..} = &nodes[read.index].kind {
    if let Expression.Field {declared, ..} = &form {
      known = run bodyRetainedRegions(&declared, owner, &mut regions)
    } else if let Expression.PatternBinding {declared, ..} = &form {
      known = run bodyRetainedRegions(&declared, owner, &mut regions)
    }
  }
  return DeclaredRead {known: known, regions: move regions}
}

// The regions `result`'s value can retain; `false` when they are unknown, as for a callable, whose
// capture loans its type does not name. A type parameter bound outside the body, by the checked
// declaration or by one enclosing it (a method's impl, an anonymous body's enclosing function),
// retains no region of the body, alone or inside the result: it is instantiated before the body runs
// with a type that cannot name a region the body creates, and safe code obtains a value of it only as
// such a value. A region the body itself binds, a loan region or an invocation binder, is not erased.
effect fn resultRegions(nodes: &[Node], result: NodeId, owner: &DeclarationId, regions: &mut List<Shared<Lifetime>>) -> bool
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let found = expressionType(nodes, result)
  if let Option<Shared<Type>>.Some {value} = move found {
    if Shared<Type>.with<bool>(&value, callableValue) {
      return false
    }
    return run bodyRetainedRegions(&value, owner, &mut regions.*)
  }
  return false
}

// Types chosen outside this body cannot name one of its fresh loan regions. Apply the same
// parametricity proof to holders and projections as to call results.
effect fn bodyRetainedRegions(
  value: &Shared<Type>,
  owner: &DeclarationId,
  regions: &mut List<Shared<Lifetime>>
) -> bool
  ! OutOfMemoryError
  ? &mut Allocator | &mut Types {
  // Type parameters bound outside the body stand for types chosen before it runs, so they are
  // read as retaining nothing; what remains is the regions the result can hold of this body.
  let mut bindings = List<Binding>.make()
  let mut depth = DeclarationId.ownerCount(owner)
  while depth > usize.ZERO {
    let binder = run Shared<DeclarationId>.make(run DeclarationId.enclosing(owner, depth))
    let mut types = List<usize>.make()
    let mut lifetimes = List<usize>.make()
    let mut rows = List<usize>.make()
    let declaration = DeclarationId.copyShared(&binder)
    run Type.collectOwned(value, &declaration, &mut types, &mut lifetimes, &mut rows)
    let ordinals = List<usize>.asSlice(&types)
    let mut at = usize.ZERO
    while at < ordinals.length {
      run List<
        Binding
      >.append(
        &mut bindings,
        Binding {
          declaration: Shared<DeclarationId>.clone(&binder),
          ordinal: ordinals[at],
          value: Argument.Type { value: run Types.intern(Type.Unit) },
        }
      )
      at = at + usize.ONE
    }
    depth = depth - usize.ONE
  }
  if List<Binding>.length(&bindings) == usize.ZERO {
    return run retainedBy(value, owner, &mut regions.*)
  }
  let erased = run Type.applyBindings(value, List<Binding>.asSlice(&bindings), true)
  return run retainedBy(&erased, owner, &mut regions.*)
}

// Whether every atom is static or a parameter chosen outside this body. A result promising
// only these regions cannot retain owned body storage. Static source loans still remain live:
// their region is external too, so the filter does not erase them as fresh body loans.
fn externalRegions(regions: &[Shared<Lifetime>], owner: &DeclarationId) -> bool {
  let mut at = usize.ZERO
  while at < regions.length {
    let parameter = Lifetime.allAtoms(&regions[at], fn(atom: &Lifetime) -> bool {
      return match &atom.* {
        Lifetime.Static => true
        Lifetime.Parameter {declaration, ..} => DeclarationId.isPrefixOf(&declaration, owner)
        _ => false
      }
    })
    if !parameter {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

// Whether `regions` is known and every atom of it is a body region of the checked declaration, as
// typing gives a fresh borrow, even a reborrow through a reference parameter.
fn bodyRegions(regions: &[Shared<Lifetime>], owner: &DeclarationId) -> bool {
  if regions.length == usize.ZERO {
    return false
  }
  let mut at = usize.ZERO
  while at < regions.length {
    let local = Lifetime.allAtoms(&regions[at], fn(atom: &Lifetime) -> bool {
      return match &atom.* {
        Lifetime.Local {declaration, ..} => DeclarationId.equals(&declaration, owner)
        _ => false
      }
    })
    if !local {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

// The outlives facts a call's argument and result types imply by being well formed, which its
// callee may assume: a reference's or slice's referent outlives its region, and the arguments of
// a nominal may outlive one another by its declared bounds, so they are taken as one class. `known`
// is false when a type has a form this summary does not describe.
struct Implied {
  groups: List<ImpliedGroup>
  known: bool
}

// The atoms of one well-formedness fact: every member outlives every container atom, or, with no
// container, the members of one nominal may outlive one another.
struct ImpliedGroup {
  container: List<Shared<Lifetime>>
  members: List<Shared<Lifetime>>
}

// What a dropped loan's region proof can ground on: the loans naming a region the proof walks,
// and those regions. The walk past the drop cannot see where the dropped loan goes, so an access
// that conflicts with any of these loans after the drop contests every one of these regions.
struct UnretainedChain {
  dropped: usize
  loans: List<usize>
  regions: List<Shared<Lifetime>>
  unresolved: bool
}

fn noImplied() -> Implied {
  return Implied {groups: List<ImpliedGroup>.make(), known: false}
}

// The facts a direct call `result` implies, exactly: the body's open region relations and the
// outlives bounds its callee's signature implies (`impliedSignatureBounds`), which typing proved of
// the call. An immediate run implies those of the call it executes; any other node, nothing known.
effect fn signatureImplied(nodes: &[Node], premises: &[ImpliedGroup], settled: bool, result: NodeId) -> Implied
! OutOfMemoryError ? &mut Allocator {
  let mut call = result
  if let NodeKind.Expression {form: Expression.Run {value, access}, ..} = &nodes[result.index].kind {
    if access == RunAccess.Immediate { call = value }
  }
  if let NodeKind.Expression {form: Expression.DirectCall {implied: stated, ..}, ..} = &nodes[call.index].kind {
    let mut implied = Implied {groups: List<ImpliedGroup>.make(), known: settled}
    let mut premise = usize.ZERO
    while premise < premises.length {
      let mut members = List<Shared<Lifetime>>.make()
      run appendAllAtoms(&mut members, List<Shared<Lifetime>>.asSlice(&premises[premise].members))
      let mut container = List<Shared<Lifetime>>.make()
      run appendAllAtoms(&mut container, List<Shared<Lifetime>>.asSlice(&premises[premise].container))
      run List<ImpliedGroup>.append(&mut implied.groups, ImpliedGroup {container: move container, members: move members})
      premise = premise + usize.ONE
    }
    let facts = List<ImpliedOutlives>.asSlice(&stated)
    let mut fact = usize.ZERO
    while fact < facts.length {
      let mut members = List<Shared<Lifetime>>.make()
      run appendAllAtoms(&mut members, List<Shared<Lifetime>>.asSlice(&facts[fact].longer))
      let mut container = List<Shared<Lifetime>>.make()
      run appendAllAtoms(&mut container, List<Shared<Lifetime>>.asSlice(&facts[fact].shorter))
      run List<ImpliedGroup>.append(&mut implied.groups, ImpliedGroup {container: move container, members: move members})
      fact = fact + usize.ONE
    }
    return move implied
  }
  return noImplied()
}

// The facts a call implies: the body's open region relations and the well-formedness of the
// types of `arguments` and `result`.
effect fn callImplied(nodes: &[Node], premises: &[ImpliedGroup], settled: bool, arguments: &[NodeId], result: NodeId) -> Implied
! OutOfMemoryError ? &mut Allocator {
  let mut implied = Implied {groups: List<ImpliedGroup>.make(), known: settled}
  let mut premise = usize.ZERO
  while premise < premises.length {
    let mut members = List<Shared<Lifetime>>.make()
    run appendAllAtoms(&mut members, List<Shared<Lifetime>>.asSlice(&premises[premise].members))
    let mut container = List<Shared<Lifetime>>.make()
    run appendAllAtoms(&mut container, List<Shared<Lifetime>>.asSlice(&premises[premise].container))
    run List<ImpliedGroup>.append(&mut implied.groups, ImpliedGroup {container: move container, members: move members})
    premise = premise + usize.ONE
  }
  let mut atoms = List<Shared<Lifetime>>.make()
  let mut index = usize.ZERO
  while index <= arguments.length {
    let mut typed = Option<Shared<Type>>.none()
    if index < arguments.length { typed = expressionType(nodes, arguments[index]) } else { typed = expressionType(nodes, result) }
    if let Option<Shared<Type>>.Some {value} = move typed {
      run implies(&value, &mut implied, &mut atoms)
    } else {
      implied.known = false
    }
    index = index + usize.ONE
  }
  return move implied
}

effect fn appendAtoms(target: &mut List<Shared<Lifetime>>, region: &Shared<Lifetime>) -> () ! OutOfMemoryError ? &mut Allocator {
  let count = Lifetime.atomCount(region)
  let mut at = usize.ZERO
  while at < count {
    run List<Shared<Lifetime>>.append(&mut target.*, Lifetime.atomAt(region, at))
    at = at + usize.ONE
  }
  return ()
}

effect fn appendAllAtoms(target: &mut List<Shared<Lifetime>>, atoms: &[Shared<Lifetime>]) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < atoms.length {
    run List<Shared<Lifetime>>.append(&mut target.*, Shared<Lifetime>.clone(&atoms[at]))
    at = at + usize.ONE
  }
  return ()
}

// Records the facts `ty` implies and appends every atom it names to `atoms`.
effect fn implies(ty: &Shared<Type>, implied: &mut Implied, atoms: &mut List<Shared<Lifetime>>) -> ()
! OutOfMemoryError ? &mut Allocator {
  match move run Type.copy(ty) {
    Type.Primitive {..} => {}
    Type.Unit => {}
    // A type parameter bound outside the body names no body region (see `bodyRetainedRegions`).
    Type.Parameter {..} => {}
    Type.String {lifetime} => {
      run appendAtoms(&mut atoms.*, &lifetime)
    }
    Type.Reference {referent, lifetime, ..} => {
      run contained(&referent, &lifetime, &mut implied.*, &mut atoms.*)
    }
    Type.Slice {element, lifetime, ..} => {
      run contained(&element, &lifetime, &mut implied.*, &mut atoms.*)
    }
    Type.Array {element, ..} => {
      run implies(&element, &mut implied.*, &mut atoms.*)
    }
    Type.Nominal {arguments, ..} => {
      let mut inner = List<Shared<Lifetime>>.make()
      let listed = List<Argument>.asSlice(&arguments)
      let mut at = usize.ZERO
      while at < listed.length {
        match &listed[at] {
          Argument.Type {value} => {
            run implies(&value, &mut implied.*, &mut inner)
          }
          Argument.Lifetime {value} => {
            run appendAtoms(&mut inner, &value)
          }
          Argument.Row {..} => {
            implied.known = false
          }
        }
        at = at + usize.ONE
      }
      run appendAllAtoms(&mut atoms.*, List<Shared<Lifetime>>.asSlice(&inner))
      run List<ImpliedGroup>.append(&mut implied.groups, ImpliedGroup {container: List<Shared<Lifetime>>.make(), members: move inner})
    }
    _ => {
      implied.known = false
    }
  }
  return ()
}

// Records that every atom `inside` names outlives `region`.
effect fn contained(inside: &Shared<Type>, region: &Shared<Lifetime>, implied: &mut Implied, atoms: &mut List<Shared<Lifetime>>) -> ()
! OutOfMemoryError ? &mut Allocator {
  let mut inner = List<Shared<Lifetime>>.make()
  run implies(inside, &mut implied.*, &mut inner)
  let mut container = List<Shared<Lifetime>>.make()
  run appendAtoms(&mut container, region)
  run appendAllAtoms(&mut atoms.*, List<Shared<Lifetime>>.asSlice(&inner))
  run appendAllAtoms(&mut atoms.*, List<Shared<Lifetime>>.asSlice(&container))
  run List<ImpliedGroup>.append(&mut implied.groups, ImpliedGroup {container: move container, members: move inner})
  return ()
}

fn containsAtom(atoms: &[Shared<Lifetime>], atom: &Shared<Lifetime>) -> bool {
  let mut at = usize.ZERO
  while at < atoms.length {
    if Lifetime.equalsShared(&atoms[at], atom) {
      return true
    }
    at = at + usize.ONE
  }
  return false
}

// Whether a loan with body regions `from` may outlive a region of `named` through the facts
// `implied` records: the atoms the facts reach from `from` include one of `named`, or one from
// outside the body, whose premises are not read here.
effect fn mayOutlive(implied: &Implied, from: &[Shared<Lifetime>], named: &[Shared<Lifetime>], owner: &DeclarationId) -> bool
! OutOfMemoryError ? &mut Allocator {
  let mut reached = List<Shared<Lifetime>>.make()
  let mut at = usize.ZERO
  while at < from.length {
    run appendAtoms(&mut reached, &from[at])
    at = at + usize.ONE
  }
  let groups = List<ImpliedGroup>.asSlice(&implied.groups)
  let mut changed = true
  while changed {
    changed = false
    let mut group = usize.ZERO
    while group < groups.length {
      let members = List<Shared<Lifetime>>.asSlice(&groups[group].members)
      let mut entered = false
      let mut member = usize.ZERO
      while !entered && member < members.length {
        entered = containsAtom(List<Shared<Lifetime>>.asSlice(&reached), &members[member])
        member = member + usize.ONE
      }
      if entered {
        let mut targets = List<Shared<Lifetime>>.asSlice(&groups[group].container)
        if targets.length == usize.ZERO {
          targets = members
        }
        let mut target = usize.ZERO
        while target < targets.length {
          if !containsAtom(List<Shared<Lifetime>>.asSlice(&reached), &targets[target]) {
            run List<Shared<Lifetime>>.append(&mut reached, Shared<Lifetime>.clone(&targets[target]))
            changed = true
          }
          target = target + usize.ONE
        }
      }
      group = group + usize.ONE
    }
  }
  let atoms = List<Shared<Lifetime>>.asSlice(&reached)
  return !bodyRegions(atoms, owner) || sharesAtom(atoms, named)
}

effect fn sourceRegionVertex(vertices: &mut List<SourceRegionVertex>, region: &Shared<Lifetime>, rules: &mut SourceProgram)
  -> SourceAtom ! OutOfMemoryError ? &mut Allocator {
  let all = List<SourceRegionVertex>.asSlice(&vertices.*)
  let mut at = usize.ZERO
  while at < all.length {
    if Lifetime.equalsShared(&all[at].region, region) { return all[at].reached }
    at = at + usize.ONE
  }
  let reached = SourceProgram.atom(&mut rules.*)
  run List<SourceRegionVertex>.append(&mut vertices.*, SourceRegionVertex {region: Shared<Lifetime>.clone(region), reached: reached})
  return reached
}

// The same finite mayOutlive closure, with each signature group's actual earlier hold as
// its applicability. Reserving a possible type relation never makes that relation a fact.
effect fn sourceMayOutlive(groups: &[SourceImpliedGroup], from: &[Shared<Lifetime>], named: &[Shared<Lifetime>],
  owner: &DeclarationId, rules: &mut SourceProgram) -> SourceAtom ! OutOfMemoryError ? &mut Allocator {
  let mut vertices = List<SourceRegionVertex>.make()
  let empty = List<SourceAtom>.make()
  let none = List<SourceAtom>.asSlice(&empty)
  let mut at = usize.ZERO
  while at < from.length {
    let count = Lifetime.atomCount(&from[at])
    let mut each = usize.ZERO
    while each < count {
      let region = Lifetime.atomAt(&from[at], each)
      let seed = run sourceRegionVertex(&mut vertices, &region, &mut rules.*)
      run SourceProgram.fact(&mut rules.*, seed)
      each = each + usize.ONE
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < groups.length {
    let members = List<Shared<Lifetime>>.asSlice(&groups[at].group.members)
    let mut targets = List<Shared<Lifetime>>.asSlice(&groups[at].group.container)
    if targets.length == usize.ZERO { targets = members }
    let mut member = usize.ZERO
    while member < members.length {
      let entered = run sourceRegionVertex(&mut vertices, &members[member], &mut rules.*)
      let mut target = usize.ZERO
      while target < targets.length {
        let reached = run sourceRegionVertex(&mut vertices, &targets[target], &mut rules.*)
        let premise: [SourceAtom; 2] = [entered, groups[at].active]
        run SourceProgram.rule(&mut rules.*, reached, &premise, none)
        target = target + usize.ONE
      }
      member = member + usize.ONE
    }
    at = at + usize.ONE
  }
  let result = SourceProgram.atom(&mut rules.*)
  let all = List<SourceRegionVertex>.asSlice(&vertices)
  at = usize.ZERO
  while at < all.length {
    let singleton: [Shared<Lifetime>; 1] = [Shared<Lifetime>.clone(&all[at].region)]
    if !bodyRegions(&singleton, owner) || sharesAtom(&singleton, named) {
      let reached: [SourceAtom; 1] = [all[at].reached]
      run SourceProgram.rule(&mut rules.*, result, &reached, none)
    }
    at = at + usize.ONE
  }
  return result
}

// A caller supplies ONLY earlier whole-hold effects, at this read's observation version.
// No hold, any undescribed/unknown applicable hold, a possible reborrow, or an unresolved
// precision/source guard prevents the universal release proof.
effect fn sourceUnreachableField(nodes: &[Node], owner: &DeclarationId, loans: &[Loan], observation: &SourceObservation,
  snapshot: &[SourceQuality], position: usize, requirements: &[RetentionEdge], relations: &[ImpliedGroup], settled: bool,
  prior: &[SourceWholeHold], named: &[Shared<Lifetime>], rules: &mut SourceProgram) -> SourceAtom
! OutOfMemoryError ? &mut Allocator {
  let no = SourceProgram.atom(&mut rules.*)
  let positions = List<SourceCarryPosition>.asSlice(&observation.positions)
  if position >= positions.length || snapshot.length != positions.length {
    return CompilerBug.panic(b"field release has no actual read observation")
  }
  let loan = &loans[positions[position].loan]
  let regions = List<Shared<Lifetime>>.asSlice(&loan.regions)
  if !settled || regions.length == usize.ZERO || !bodyRegions(regions, owner) || sharesAtom(regions, named) { return no }
  let mut missing = false
  if let Option<Shared<Lifetime>>.Some {value: borrowed} = &loan.borrowed {
    missing = retentionOrdinal(&borrowed, owner) != usize.MAX && !sharesAtom(regions, named)
  }
  if missing {
    let reached = run retentionClosure(named, owner, requirements)
    if requiredLoan(loan, owner, List<usize>.asSlice(&reached)) { return no }
  }
  let empty = List<SourceAtom>.make()
  let none = List<SourceAtom>.asSlice(&empty)
  let blocked = SourceProgram.atom(&mut rules.*)
  let found = SourceProgram.atom(&mut rules.*)
  let mut groups = List<SourceImpliedGroup>.make()
  let mut at = usize.ZERO
  while at < prior.length {
    if prior[at].loan == positions[position].loan {
      let applicable: [SourceAtom; 1] = [prior[at].active]
      run SourceProgram.rule(&mut rules.*, found, &applicable, none)
      let described: [SourceAtom; 1] = [prior[at].described]
      run SourceProgram.rule(&mut rules.*, blocked, &applicable, &described)
      let mut facts = run signatureImplied(nodes, relations, settled, prior[at].result)
      if !facts.known { run SourceProgram.rule(&mut rules.*, blocked, &applicable, none) }
      while List<ImpliedGroup>.length(&facts.groups) != usize.ZERO {
        run List<SourceImpliedGroup>.append(&mut groups, SourceImpliedGroup {
          group: List<ImpliedGroup>.remove(&mut facts.groups, usize.ZERO), active: prior[at].active})
      }
    }
    at = at + usize.ONE
  }
  if let Option<Shared<Lifetime>>.Some {value: borrowed} = &loan.borrowed {
    at = usize.ZERO
    while at < positions.length {
      if at != position {
        if let Option<Shared<Lifetime>>.Some {value: parent} = &loans[positions[at].loan].parent {
          if meetMember(&parent, &borrowed) {
            let child: [SourceAtom; 1] = [snapshot[at].present]
            run SourceProgram.rule(&mut rules.*, blocked, &child, none)
          }
        }
      }
      at = at + usize.ONE
    }
  }
  let possible = run sourceMayOutlive(List<SourceImpliedGroup>.asSlice(&groups), regions, named, owner, &mut rules.*)
  let quality = snapshot[position]
  let required: [SourceAtom; 2] = [quality.present, found]
  let forbidden: [SourceAtom; 5] = [quality.stored, quality.alternatives, blocked, possible, observation.unknown]
  return run SourcePolicy.conjunction(&mut rules.*, &required, &forbidden)
}

// Whether any atom of `left` is an atom of `right`.
fn sharesAtom(left: &[Shared<Lifetime>], right: &[Shared<Lifetime>]) -> bool {
  let mut first = usize.ZERO
  while first < left.length {
    let leftCount = Lifetime.atomCount(&left[first])
    let mut leftAt = usize.ZERO
    while leftAt < leftCount {
      let atom = Lifetime.atomAt(&left[first], leftAt)
      let mut second = usize.ZERO
      while second < right.length {
        let rightCount = Lifetime.atomCount(&right[second])
        let mut rightAt = usize.ZERO
        while rightAt < rightCount {
          let other = Lifetime.atomAt(&right[second], rightAt)
          if Lifetime.equalsShared(&atom, &other) {
            return true
          }
          rightAt = rightAt + usize.ONE
        }
        second = second + usize.ONE
      }
      leftAt = leftAt + usize.ONE
    }
    first = first + usize.ONE
  }
  return false
}

effect fn fieldIndexes(fields: &[AggregateField]) -> List<usize> ! OutOfMemoryError ? &mut Allocator {
  let mut indexes = List<usize>.make()
  let mut at = usize.ZERO
  while at < fields.length {
    run List<usize>.append(&mut indexes, fields[at].index)
    at = at + usize.ONE
  }
  return move indexes
}

// Where each field, in evaluation order, can have what it carries stored, from per-ordinal answers.
// A field typing recorded no answer for can hold anywhere.
effect fn fieldHoldable(fields: &[AggregateField], holdable: &[CaptureHold]) -> List<CaptureHold> ! OutOfMemoryError ? &mut Allocator {
  let mut ordered = List<CaptureHold>.make()
  let mut at = usize.ZERO
  while at < fields.length {
    let mut hold = CaptureHold.Any
    if fields[at].index < holdable.length { hold = holdable[fields[at].index] }
    run List<CaptureHold>.append(&mut ordered, hold)
    at = at + usize.ONE
  }
  return move ordered
}

effect fn fieldValues(fields: &[AggregateField]) -> List<NodeId> ! OutOfMemoryError ? &mut Allocator {
  let mut values = List<NodeId>.make()
  let mut at = usize.ZERO
  while at < fields.length {
    run List<NodeId>.append(&mut values, fields[at].value)
    at = at + usize.ONE
  }
  return move values
}

// The referent captures of an environment, each naming the position of its field's operand.
effect fn referentOperands(fields: &[AggregateField], referents: &[ReferentCapture]) -> List<ReferentCapture>
! OutOfMemoryError ? &mut Allocator {
  let mut operands = List<ReferentCapture>.make()
  let mut at = usize.ZERO
  while at < referents.length {
    let mut position = usize.ZERO
    while position < fields.length && fields[position].index != referents[at].field {
      position = position + usize.ONE
    }
    run List<ReferentCapture>.append(&mut operands, ReferentCapture {field: position, access: referents[at].access})
    at = at + usize.ONE
  }
  return move operands
}

effect fn single(value: NodeId) -> List<NodeId> ! OutOfMemoryError ? &mut Allocator {
  let mut values = List<NodeId>.make()
  run List<NodeId>.append(&mut values, value)
  return move values
}

effect fn copyIds(values: &[NodeId]) -> List<NodeId> ! OutOfMemoryError ? &mut Allocator {
  let mut copied = List<NodeId>.make()
  let mut at = usize.ZERO
  while at < values.length {
    run List<NodeId>.append(&mut copied, values[at])
    at = at + usize.ONE
  }
  return move copied
}

// A call's arguments in order. A shared or mutable receiver pass borrows the receiver place for the
// whole call; a taking receiver pass moves it.
effect fn call(nodes: &[Node], locals: &[Local], owner: &DeclarationId, walker: &mut Walker, arguments: &[NodeId], receiver: usize, exact: bool,
  signature: bool, result: NodeId, at: usize) -> Flow
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut carried = List<Carry>.make()
  let mut current = at
  let mut index = usize.ZERO
  while index < arguments.length {
    let argument = arguments[index]
    let mut handled = false
    if index == usize.ZERO && receiver != usize.ZERO {
      let path = run pathOf(nodes, argument)
      if path.root != usize.MAX && !isBorrow(nodes, argument) {
        let span = nodes[argument.index].origin.location
        let mut flow = flowAt(current)
        if receiver == 3 {
          flow = run place(nodes, locals, owner, &mut walker.*, &path, Kind.Read, span, current)
        } else {
          flow = run borrow(nodes, locals, owner, &mut walker.*, argument, receiver == 2, span, usize.MAX, current)
        }
        run appendOperand(&mut carried, List<Carry>.asSlice(&flow.carried), index)
        current = flow.at
        handled = true
      }
    }
    if !handled {
      let flow = run visit(nodes, locals, owner, &mut walker.*, argument, current)
      run appendOperand(&mut carried, List<Carry>.asSlice(&flow.carried), index)
      current = flow.at
    }
    index = index + usize.ONE
  }
  let mut typed = List<NodeId>.make()
  if signature {
    typed = run copyIds(arguments)
  }
  run keepWrittenOperands(nodes, owner, &mut walker.*, result, arguments, List<Carry>.asSlice(&carried))
  let sinks = run operandSinks(nodes, result, arguments, owner)
  let unplaced = List<List<Step>>.make()
  let called = run finish(nodes, owner, &mut walker.*, result, current, &carried, exact, Forwarding.None, List<List<Step>>.asSlice(&unplaced), List<NodeId>.asSlice(&typed), List<OperandSink>.asSlice(&sinks))
  let lent = run storeIntoLent(nodes, locals, owner, &mut walker.*, result, arguments, List<Carry>.asSlice(&carried),
    nodes[result.index].origin.location, called.at)
  // The callee may invoke a closure an argument carries, whether passed by value, by reference, or
  // within a holder, so its storable loans reach the call as that closure's do.
  let stored = run storeThroughExclusive(locals, owner, &mut walker.*, List<Carry>.asSlice(&carried), List<Carry>.asSlice(&carried),
    nodes[result.index].origin.location, lent)
  return Flow {at: stored, carried: move called.carried}
}

// A call can keep an operand's loans in the caller regions its signature lets it write (`KeptRegions`,
// R3 amendment 4). A body holder the call lends exclusively, whose type names such a region, may
// receive through that `&mut` each loan lying in an operand slot whose contract can store there,
// including a view shortened under an outlives bound or copied from another holder. It holds
// those from the call on, as a field store into it would: an access to their referents conflicts
// with them while the holder lives, and a value read from the holder carries them. A holder that is
// a reference holding body loans may reach body storage the walk cannot place, so such a store
// leaves the body unchecked; a reference this body was passed reaches caller storage, which the
// region proof answers for.
effect fn storeIntoLent(nodes: &[Node], locals: &[Local], owner: &DeclarationId, walker: &mut Walker, result: NodeId, arguments: &[NodeId],
  carried: &[Carry], span: Location, at: usize) -> usize
! OutOfMemoryError ? &mut Allocator | &mut Types {
  if carried.length == usize.ZERO || walker.outside || at == usize.MAX { return at }
  let recorded = match move callKept(nodes, result) {
    Option<Shared<List<KeptRegions>>>.Some {value} => move value
    _ => { return at }
  }
  let mut holders = List<usize>.make()
  let mut index = usize.ZERO
  let loans = List<Loan>.asSlice(&walker.loans)
  while index < carried.length {
    let lent = loans[carried[index].loan].place.root
    if loans[carried[index].loan].exclusive && lent < walker.localCount && !listsIndex(List<usize>.asSlice(&holders), lent) {
      run List<usize>.append(&mut holders, lent)
    }
    index = index + usize.ONE
  }
  let mut point = at
  let roots = List<usize>.asSlice(&holders)
  let mut holder = usize.ZERO
  while holder < roots.length {
    let root = roots[holder]
    let ty = localType(locals, root)
    let mut named = List<Shared<Lifetime>>.make()
    run Type.regionAtoms(&ty, &mut named)
    let mut received = List<Carry>.make()
    if run retains(&ty, owner) {
      index = usize.ZERO
      while index < carried.length {
        let operand = carried[index].operand
        let loan = carried[index].loan
        if List<Loan>.asSlice(&walker.loans)[loan].place.root != root && operand < arguments.length {
          let mut target = usize.ZERO
          while target < carried.length {
            let destination = carried[target]
            let targetLoan = &List<Loan>.asSlice(&walker.loans)[destination.loan]
            if targetLoan.exclusive && targetLoan.place.root == root {
              let count = Shared<List<KeptRegions>>.with<usize>(&recorded, fn(values: &List<KeptRegions>) -> usize {
                let entries = List<KeptRegions>.asSlice(values)
                if destination.operand >= entries.length { return usize.ZERO }
                return List<KeptSlot>.length(&entries[destination.operand].slots)
              })
              let mut slot = usize.ZERO
              while slot < count {
                if run keptIn(&recorded, operand, &List<Loan>.asSlice(&walker.loans)[loan], carried[index],
                  List<List<Step>>.asSlice(&walker.paths), excludedTransferRead(&walker.*, carried[index]), owner,
                  List<RetentionEdge>.asSlice(&walker.requirements), List<Shared<Lifetime>>.asSlice(&named), destination, slot) {
                  let mut carry = carried[index]
                  carry.field = run destinationField(&recorded, List<Loan>.asSlice(&walker.loans), &mut walker.paths, destination, slot)
                  carry.direct = false
                  run List<Carry>.append(&mut received, carry)
                }
                slot = slot + usize.ONE
              }
            }
            target = target + usize.ONE
          }
        }
        index = index + usize.ONE
      }
    }
    if List<Carry>.length(&received) > usize.ZERO {
      if Shared<Type>.with<bool>(&ty, referenceType) {
        if holds(&walker.*, root) {
          leave(&mut walker.*, BorrowStatus.StoredLoans)
          return point
        }
      } else {
        // The new definition replaces the holder's earlier ones, so it holds what they did, once
        // per retained position: re-holding earlier holdings would double them at each call.
        let used = run useHolder(&mut walker.*, root, usize.MAX, span, point)
        let mut carrying = List<Carry>.make()
        run appendCarried(&mut carrying, List<Carry>.asSlice(&used.carried))
        run appendCarried(&mut carrying, List<Carry>.asSlice(&received))
        run hold(&mut walker.*, root, List<Carry>.asSlice(&carrying), used.at, true)
        point = used.at
      }
    }
    holder = holder + usize.ONE
  }
  return point
}

// Whether this particular loan can occupy a parameter slot that can store into the destination's
// regions. KeptSlot.kept records the destination regions reached under the declared bounds, not
// just the source's region. A projected value may carry a loan typed at an earlier region: compare
// the slot's referent and access, not that original region's spelling. Loans of a receiver's storage
// cannot occupy its stored reference slots merely because both travel through the same operand.
effect fn keptIn(recorded: &Shared<List<KeptRegions>>, operand: usize, loan: &Loan, carry: Carry, paths: &[List<Step>],
  excluded: bool, owner: &DeclarationId,
  edges: &[RetentionEdge], named: &[Shared<Lifetime>], destination: Carry, target: usize) -> bool ! OutOfMemoryError ? &mut Allocator {
  if excluded { return false }
  let origins = run keptOrigins(loan, owner, edges)
  return Shared<List<KeptRegions>>.with<bool>(recorded, fn(values: &List<KeptRegions>) -> bool {
    let entries = List<KeptRegions>.asSlice(values)
    if operand >= entries.length { return false }
    let slots = List<KeptSlot>.asSlice(&entries[operand].slots)
    let mut at = usize.ZERO
    while at < slots.length {
      if keptSlotIn(&slots[at], loan, carry, paths, owner, List<Shared<Lifetime>>.asSlice(&origins.regions),
        List<usize>.asSlice(&origins.reached), named)
        && destinationKeeps(entries, &slots[at], paths, destination, target, named) { return true }
      at = at + usize.ONE
    }
    return false
  })
}

// Immutable source-to-extent closure shared by eager classification and a selected C slot.
// These regions decide eligibility only; they never pair sources or establish an address.
effect fn keptOrigins(loan: &Loan, owner: &DeclarationId, edges: &[RetentionEdge]) -> KeptOrigins
! OutOfMemoryError ? &mut Allocator {
  let mut source = List<Shared<Lifetime>>.make()
  if let Option<Shared<Lifetime>>.Some {value} = &loan.borrowed {
    run List<Shared<Lifetime>>.append(&mut source, Shared<Lifetime>.clone(&value))
  } else {
    run appendAllAtoms(&mut source, List<Shared<Lifetime>>.asSlice(&loan.regions))
  }
  // A prior store or coercion can shorten the loan into this source position. Follow only the
  // finite requirements in their source-to-extent direction; they retain a loan, never prove it.
  let mut reached = List<usize>.make()
  let origins = List<Shared<Lifetime>>.asSlice(&source)
  let mut at = usize.ZERO
  while at < origins.length {
    let ordinal = retentionOrdinal(&origins[at], owner)
    if ordinal != usize.MAX && !retentionListed(List<usize>.asSlice(&reached), ordinal) {
      run List<usize>.append(&mut reached, ordinal)
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < List<usize>.length(&reached) {
    let origin = List<usize>.asSlice(&reached)[at]
    let mut edge = usize.ZERO
    while edge < edges.length {
      if edges[edge].source == origin && !retentionListed(List<usize>.asSlice(&reached), edges[edge].extent) {
        run List<usize>.append(&mut reached, edges[edge].extent)
      }
      edge = edge + usize.ONE
    }
    at = at + usize.ONE
  }
  return KeptOrigins {regions: move source, reached: move reached}
}

// One explicitly selected original KeptSlot. Preparation only freezes this coordinate;
// ownership retains the mayHoldLoan, directed-retention and exact source-path judgments.
fn keptSlotIn(slot: &KeptSlot, loan: &Loan, carry: Carry, paths: &[List<Step>], owner: &DeclarationId,
  source: &[Shared<Lifetime>], reached: &[usize], named: &[Shared<Lifetime>]) -> bool {
  let mut fits = true
  if let Option<Shared<Type>>.Some {value: referent} = &loan.referent {
    fits = Type.mayHoldLoan(slot.view, &slot.referent, slot.exclusive, &referent, loan.exclusive)
  }
  let sources = List<Shared<Lifetime>>.asSlice(&slot.source)
  let mut enters = sharesAtom(source, sources)
  let mut each = usize.ZERO
  while !enters && each < sources.length {
    let ordinal = retentionOrdinal(&sources[each], owner)
    enters = ordinal != usize.MAX && retentionListed(reached, ordinal)
    each = each + usize.ONE
  }
  if carry.direct && carry.field != usize.MAX {
    let matched = transferSlotPath(List<Step>.asSlice(&paths[carry.field]), List<KeptStep>.asSlice(&slot.path), slot.view)
    if matched != SlotPath.Unknown { enters = matched == SlotPath.Same }
  }
  return fits && enters && sharesAtom(List<Shared<Lifetime>>.asSlice(&slot.kept), named)
}

// Inferred regions can coincide even when the holder cannot contain this source value. Match
// the eligible source to a slot reached through a loan of this particular destination, retaining
// both its directed region eligibility and its referent/access contract. Opaque source storage
// can contain loans its outer type does not describe, so only known views constrain the contents.
fn destinationKeeps(entries: &[KeptRegions], source: &KeptSlot, paths: &[List<Step>], destination: Carry, targetIndex: usize,
  named: &[Shared<Lifetime>]) -> bool {
  let slots = List<KeptSlot>.asSlice(&entries[destination.operand].slots)
  let target = &slots[targetIndex]
  return destinationSlotKeeps(source, target, paths, destination, named)
}

fn destinationSlotKeeps(source: &KeptSlot, target: &KeptSlot, paths: &[List<Step>], destination: Carry,
  named: &[Shared<Lifetime>]) -> bool {
  return destinationSlot(paths, destination, target)
    && sharesAtom(List<Shared<Lifetime>>.asSlice(&target.source), named)
    && sharesAtom(List<Shared<Lifetime>>.asSlice(&source.kept), List<Shared<Lifetime>>.asSlice(&target.source))
    && (!source.view || Type.mayHoldLoan(target.view, &target.referent, target.exclusive, &source.referent, source.exclusive))
}

// Translate the contract slot through the actual exclusive loan. Keep the known storage prefix
// before opaque or indirect contents: replacing that prefix drops all of those contents, while a
// narrower write cannot claim to reset them. Never infer which eligible slot the callee writes.
effect fn destinationField(recorded: &Shared<List<KeptRegions>>, loans: &[Loan], paths: &mut List<List<Step>>, destination: Carry, slot: usize) -> usize
! OutOfMemoryError ? &mut Allocator {
  if !destination.direct || destination.field == usize.MAX { return usize.MAX }
  let lent = run copySteps(List<Step>.asSlice(&List<List<Step>>.asSlice(&paths.*)[destination.field]))
  let prefix = List<Step>.asSlice(&lent)
  if !exactPath(prefix) { return usize.MAX }
  let loan = &loans[destination.loan]
  if !exactPath(List<Step>.asSlice(&loan.place.steps)) { return usize.MAX }
  let mut path = run copySteps(List<Step>.asSlice(&loan.place.steps))
  let count = Shared<List<KeptRegions>>.with<usize>(recorded, fn(values: &List<KeptRegions>) -> usize {
    return List<KeptStep>.length(&List<KeptSlot>.asSlice(&List<KeptRegions>.asSlice(values)[destination.operand].slots)[slot].path)
  })
  let mut at = prefix.length
  if at >= count { return usize.MAX }
  let boundary = Shared<List<KeptRegions>>.with<KeptStep>(recorded, fn(values: &List<KeptRegions>) -> KeptStep {
    return List<KeptStep>.asSlice(&List<KeptSlot>.asSlice(&List<KeptRegions>.asSlice(values)[destination.operand].slots)[slot].path)[at]
  })
  if boundary.kind != KeptStepKind.Referent { return usize.MAX }
  at = at + usize.ONE
  while at < count {
    let step = Shared<List<KeptRegions>>.with<KeptStep>(recorded, fn(values: &List<KeptRegions>) -> KeptStep {
      return List<KeptStep>.asSlice(&List<KeptSlot>.asSlice(&List<KeptRegions>.asSlice(values)[destination.operand].slots)[slot].path)[at]
    })
    if step.kind != KeptStepKind.Field { break }
    run List<Step>.append(&mut path, fieldStep(step.index))
    at = at + usize.ONE
  }
  if List<Step>.length(&path) == usize.ZERO { return usize.ZERO }
  let field = List<List<Step>>.length(&paths.*)
  run List<List<Step>>.append(&mut paths.*, move path)
  return field
}

// A lent reference is not itself writable holder contents. Known aggregate paths locate that
// reference within the operand; contents begin at its Referent step. Opaque ancestors and unknown
// paths can reach storage we cannot place, so they remain possible destinations.
fn destinationSlot(paths: &[List<Step>], carry: Carry, slot: &KeptSlot) -> bool {
  let target = List<KeptStep>.asSlice(&slot.path)
  if !carry.direct || carry.field == usize.MAX { return !slot.view || target.length != usize.ZERO }
  let lent = List<Step>.asSlice(&paths[carry.field])
  let mut at = usize.ZERO
  while at < lent.length {
    if at >= target.length { return !slot.view }
    if target[at].kind != KeptStepKind.Field || lent[at].kind == StepKind.Referent
      || lent[at].kind == StepKind.AnyElement || lent[at].kind == StepKind.RepeatedElement { return true }
    if lent[at].kind != StepKind.Field || target[at].index != lent[at].ordinal { return false }
    at = at + usize.ONE
  }
  if at == target.length { return !slot.view }
  return target[at].kind == KeptStepKind.Referent || target[at].kind == KeptStepKind.Unknown
}

// A holder read can keep sibling loans live without passing their references as the value read.
// Restrict only the transfer: the ordinary holder liveness and field-release policy are unchanged.
fn excludedTransferRead(walker: &Walker, carry: Carry) -> bool {
  if carry.definition == usize.MAX || carry.read == usize.MAX { return false }
  let definitions = List<Holding>.asSlice(&walker.definitions)
  let points = List<Point>.asSlice(&walker.points)
  let field = definitions[carry.definition].field
  let read = points[carry.read].read
  if field == usize.MAX || read == usize.MAX { return false }
  let paths = List<List<Step>>.asSlice(&walker.paths)
  let held = List<Step>.asSlice(&paths[field])
  let used = List<Step>.asSlice(&paths[read])
  return excludedTransferPaths(held, used)
}

// A known sibling difference excludes transfer only before every indirect/unknown element
// boundary. This is a path predicate, never a region-equality or read-ID-only inference.
fn excludedTransferPaths(held: &[Step], used: &[Step]) -> bool {
  let mut at = usize.ZERO
  while at < held.length && at < used.length {
    if held[at].kind == StepKind.Referent || used[at].kind == StepKind.Referent
      || held[at].kind == StepKind.AnyElement || used[at].kind == StepKind.AnyElement
      || held[at].kind == StepKind.RepeatedElement || used[at].kind == StepKind.RepeatedElement { return false }
    if held[at].kind == used[at].kind && held[at].ordinal != used[at].ordinal { return true }
    at = at + usize.ONE
  }
  return false
}

enum SlotPath { Unknown, Same, Different }

// A direct carried reference occupies exactly this source sub-place, even if parameter coercion
// shortened its region. Opaque slots may contain it below their prefix. Reference and unknown
// element/union boundaries leave region correspondence to decide: they cannot prove field identity.
fn transferSlotPath(loan: &[Step], slot: &[KeptStep], view: bool) -> SlotPath {
  let mut at = usize.ZERO
  while at < slot.length {
    if slot[at].kind == KeptStepKind.Unknown || slot[at].kind == KeptStepKind.Referent
      || slot[at].kind == KeptStepKind.Element { return SlotPath.Unknown }
    if at >= loan.length { return SlotPath.Different }
    if loan[at].kind == StepKind.Referent || loan[at].kind == StepKind.AnyElement
      || loan[at].kind == StepKind.RepeatedElement { return SlotPath.Unknown }
    if loan[at].kind != StepKind.Field || loan[at].ordinal != slot[at].index { return SlotPath.Different }
    at = at + usize.ONE
  }
  if view && loan.length != slot.length { return SlotPath.Different }
  return SlotPath.Same
}

// An invoked callable whose body may store a loan it carries stores it wherever it can write
// (CAPTURE-002, ANON-OWN-001): into a holder it reaches through an exclusive capture or a `&mut`
// argument. Neither its signature nor typing records which, so each body-local holder the
// invocation lends exclusively, whose type can retain a region, retains every such loan from the
// invocation on, as a field store into it would. A holder that is a reference holding body loans may
// reach body storage the walk cannot place, so such a store leaves the body unchecked; a reference
// this body was passed reaches caller storage, which the region proof answers for only where it sees
// the store, so a loan of body storage that may go there keeps the body from being Checked.
effect fn storeThroughExclusive(locals: &[Local], owner: &DeclarationId, walker: &mut Walker, carried: &[Carry], stored: &[Carry],
  span: Location, at: usize) -> usize
! OutOfMemoryError ? &mut Allocator | &mut Types {
  if stored.length == usize.ZERO || walker.outside || at == usize.MAX { return at }
  let mut holders = List<usize>.make()
  let mut index = usize.ZERO
  let loans = List<Loan>.asSlice(&walker.loans)
  while index < carried.length {
    let lent = loans[carried[index].loan].place.root
    if loans[carried[index].loan].exclusive && lent < walker.localCount && !listsIndex(List<usize>.asSlice(&holders), lent) {
      run List<usize>.append(&mut holders, lent)
    }
    index = index + usize.ONE
  }
  let mut point = at
  let roots = List<usize>.asSlice(&holders)
  let mut holder = usize.ZERO
  while holder < roots.length {
    let root = roots[holder]
    let ty = localType(locals, root)
    let mut kept = List<Carry>.make()
    if run retains(&ty, owner) {
      index = usize.ZERO
      while index < stored.length {
        let loan = stored[index].loan
        if listsIndex(List<usize>.asSlice(&walker.storable), loan) && List<Loan>.asSlice(&walker.loans)[loan].place.root != root {
          let mut carry = stored[index]
          carry.field = usize.MAX
          carry.direct = false
          run List<Carry>.append(&mut kept, carry)
        }
        index = index + usize.ONE
      }
    }
    if List<Carry>.length(&kept) > usize.ZERO {
      if Shared<Type>.with<bool>(&ty, referenceType) {
        if holds(&walker.*, root) {
          leave(&mut walker.*, BorrowStatus.StoredLoans)
          return point
        }
      } else {
        let used = run useHolder(&mut walker.*, root, usize.MAX, span, point)
        let mut carrying = move used.carried
        run appendCarried(&mut carrying, List<Carry>.asSlice(&kept))
        run hold(&mut walker.*, root, List<Carry>.asSlice(&carrying), used.at, false)
        point = used.at
      }
    }
    holder = holder + usize.ONE
  }
  return point
}

// Constructs a callable or section from its captured operands, in order (CAPTURE-001). A borrowed capture's
// loan begins here and travels with the callable value, so it stays live while the callable can
// still be invoked (CALLABLE-003); a moved capture leaves its place here (CAPTURE-002). A captured
// exclusive descriptor is read into its field and its referent reborrowed with the access the body
// needs through it. A section copies or takes its base callable's environment, so it carries the
// loans that callee holds.
effect fn construct(nodes: &[Node], locals: &[Local], owner: &DeclarationId, walker: &mut Walker, values: &[NodeId],
  referents: &[ReferentCapture], staged: bool, holdable: &[CaptureHold], body: BorrowStatus, result: NodeId, at: usize) -> Flow
! OutOfMemoryError ? &mut Allocator | &mut Types {
  // A body the borrow check did not close may store a loan it carries anywhere it can write.
  let stores = body != BorrowStatus.Checked
  let hasBase = match &nodes[result.index].kind {
    NodeKind.Expression {form: Expression.StagedCallable {..}, ..} => true
    _ => false
  }
  let mut carried = List<Carry>.make()
  // The value each carried loan entered through, in step with `carried`.
  let mut sources = List<usize>.make()
  let mut current = at
  let mut index = usize.ZERO
  while index < values.length {
    let flow = run visit(nodes, locals, owner, &mut walker.*, values[index], current)
    run appendCarried(&mut carried, List<Carry>.asSlice(&flow.carried))
    current = flow.at
    let mut captured = usize.ZERO
    while captured < referents.length {
      if referents[captured].field == index {
        let reborrow = run reborrowReferent(nodes, owner, &mut walker.*, values[index], referents[captured].access == Access.Mutable, current)
        run appendCarried(&mut carried, List<Carry>.asSlice(&reborrow.carried))
        current = reborrow.at
      }
      captured = captured + usize.ONE
    }
    while List<usize>.length(&sources) < List<Carry>.length(&carried) { run List<usize>.append(&mut sources, index) }
    index = index + usize.ONE
  }
  // The loans travel with the callable whatever regions its type names: holding them longer is
  // conservative, and the region slice proves the environment's own regions. A loan the callable can
  // store, through a capture or an argument that names a universal region where it can store, must
  // outlive the body (R3 amendment 4).
  // A capture or contract parameter naming a type parameter can store through an instantiation or
  // conformance this walk cannot see. The body's callers choose that type, so it names no body
  // region: a loan typed only at body regions can be stored through it only where the callable's
  // own body admits a relation from a body region to one the type names, which a body the borrow
  // check closed never does. Such a loan of a closed body stays with the callable as any other
  // capture's loan does, held by what an invocation lends exclusively (see `storeThroughExclusive`);
  // one a body that is not Checked carries (`stores`), or one with no typed region, leaves the
  // body unchecked. A loan typed at a universal region may reach caller storage through it, so it
  // escapes. The walk still
  // continues: a definite conflict among exact loans rejects whatever the callable stores. A staged
  // callable's callee stores only through the contract its stage exposes.
  // Construction really holds each capture, but has not executed a destination write.
  // A closed selected contract can prove a capture non-storing; every other capture keeps
  // the existing conservative policy. The classification never creates caller retention.
  let closed = match &nodes[result.index].kind {
    NodeKind.Expression {form: Expression.StagedCallable {retention, ..}, ..} => retention.closed
    NodeKind.Expression {form: Expression.Aggregate {section: Option<SectionRetention>.Some {value}, ..}, ..} => value.closed
    _ => false
  }
  let mut sinks = List<OperandSink>.make()
  if staged && closed { sinks = run operandSinks(nodes, result, values, owner) }
  let entries = List<OperandSink>.asSlice(&sinks)
  let captured = List<Carry>.asSlice(&carried)
  let entered = List<usize>.asSlice(&sources)
  let mut supplied = List<Carry>.make()
  index = usize.ZERO
  while index < captured.length {
    let mut carry = captured[index]
    carry.operand = entered[index]
    run List<Carry>.append(&mut supplied, carry)
    index = index + usize.ONE
  }
  let classification = run retainedSinks(List<Loan>.asSlice(&walker.loans), List<List<Step>>.asSlice(&walker.paths),
    owner, List<Carry>.asSlice(&supplied), entries, usize.MAX)
  let decisions = List<CallSink>.asSlice(&classification.sinks)
  let mut nonstoring = List<bool>.make()
  index = usize.ZERO
  while index < captured.length {
    let operand = entered[index]
    run List<bool>.append(&mut nonstoring, closed && !(hasBase && operand == usize.ZERO)
      && operand < entries.length && !entries[operand].undescribed
      && List<SlotSink>.length(&entries[operand].slots) != usize.ZERO && decisions[index] == CallSink.Local)
    index = index + usize.ONE
  }
  let mut stored = List<Shared<Lifetime>>.make()
  let mut opaque = false
  if let Option<Shared<Type>>.Some {value} = move expressionType(nodes, result) {
    run Type.callableStoredRegions(&value, &mut stored)
    opaque = run Type.contractNamesTypeParameter(&value)
  }
  index = usize.ZERO
  while index < values.length {
    run storedRegionsOf(nodes, values[index], &mut stored)
    if let Option<Shared<Type>>.Some {value} = move expressionType(nodes, values[index]) {
      if !(hasBase && index == usize.ZERO) && run Type.namesTypeParameter(&value) { opaque = true }
    }
    index = index + usize.ONE
  }
  if opaque {
    let captured = List<Carry>.asSlice(&carried)
    let mut held = usize.ZERO
    while held < captured.length {
      let mut all = List<Loan>.asMutSlice(&mut walker.loans)
      if universalRegions(&all[captured[held].loan].regions, owner) {
        all[captured[held].loan].escapes = true
      } else if List<Shared<Lifetime>>.length(&all[captured[held].loan].regions) == usize.ZERO && !all[captured[held].loan].local {
        walker.storing = true
      }
      held = held + usize.ONE
    }
  }
  if universalRegions(&stored, owner) {
    // Whether the callable's body stores a capture is not visible here: a loan typed at a universal
    // region escapes. A capture whose type no position the callable can write admits is never
    // stored, so the loans it carries stay in the environment. A loan of storage the body owns
    // (`ownedStorageLoan`), typed only at body regions (`typedLocally`), stays with a callable whose
    // body the borrow check closed and whose types name no type parameter: that storage ends within
    // the body, so no region proof shows its region outlives a universal one, and a slot whose region
    // names only universal regions never admits it. A reborrow through a reference is not such a
    // loan: its region may be proved to outlive the reference's. Any other loan leaves the body
    // unchecked: an unclosed body (`stores`) may store it anywhere it can write, and an
    // instantiation (`opaque`) may hold it where no region shows.
    let captured = List<Carry>.asSlice(&carried)
    let entered = List<usize>.asSlice(&sources)
    let mut unchecked = false
    let mut held = usize.ZERO
    while held < captured.length {
      // Closing the selected inference can still leave a caller type parameter opaque.
      // Its possible instantiations retain the conservative capture policy below.
      if !opaque && List<bool>.asSlice(&nonstoring)[held] { held = held + usize.ONE  continue }
      let mut all = List<Loan>.asMutSlice(&mut walker.loans)
      let mut hold = CaptureHold.Any
      if held < entered.length && entered[held] < holdable.length { hold = holdable[entered[held]] }
      if universalRegions(&all[captured[held].loan].regions, owner) {
        if hold != CaptureHold.Never { all[captured[held].loan].escapes = true }
      } else if hold == CaptureHold.Any && (stores || opaque || !typedLocally(&all[captured[held].loan].regions, owner)
        || !ownedStorageLoan(&all[captured[held].loan])) {
        unchecked = true
      }
      held = held + usize.ONE
    }
    // The walk keeps going: a definite conflict among exact loans, including one a closure it carries
    // stores where an exclusive capture reaches, still rejects, and the body is never Checked.
    if unchecked { walker.storing = true }
  }
  // A loan that entered through a capture no position the callable can write admits is never
  // stored by its body either.
  if stores {
    let captured = List<Carry>.asSlice(&carried)
    let entered = List<usize>.asSlice(&sources)
    index = usize.ZERO
    while index < captured.length {
      let stays = index < entered.length && entered[index] < holdable.length && holdable[entered[index]] == CaptureHold.Never
      if !stays && !listsIndex(List<usize>.asSlice(&walker.storable), captured[index].loan) {
        run List<usize>.append(&mut walker.storable, captured[index].loan)
      }
      index = index + usize.ONE
    }
    // Nothing reports an anonymous body on its own: what it does with its captures, its own locals
    // or any service its requirement row names is proved only by its own check. This body therefore
    // claims no more than the bodies it constructs, for the same reason, and the walk goes on.
    if walker.inherited == BorrowStatus.Checked { walker.inherited = body }
  }
  let point = run newPoint(&mut walker.*, current)
  return Flow {at: point, carried: move carried}
}

// Appends the regions a captured value can store into, when typing recorded its type. A captured
// callable stores only through what its contract's parameters reach.
effect fn storedRegionsOf(nodes: &[Node], node: NodeId, stored: &mut List<Shared<Lifetime>>) -> () ! OutOfMemoryError ? &mut Allocator {
  if let Option<Shared<Type>>.Some {value} = move expressionType(nodes, node) { run Type.callableStoredRegions(&value, &mut stored.*) }
  return ()
}

// An invocation of a callable value (CALLABLE-002). A pipeline's input is evaluated before the
// callee. Reading the callee keeps the loans its environment holds live for the whole call
// (CALLABLE-003). A `mut fn` callee is accessed exclusively for the call; a `once fn` callee is
// already a typed move of its place, so a second invocation uses a moved place.
effect fn invoke(nodes: &[Node], locals: &[Local], owner: &DeclarationId, walker: &mut Walker, callee: NodeId, arguments: &[NodeId],
  pipeline: bool, exclusive: bool, result: NodeId, at: usize) -> Flow
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut carried = List<Carry>.make()
  let mut current = at
  let mut first = usize.ZERO
  if pipeline && arguments.length > usize.ZERO {
    let input = run visit(nodes, locals, owner, &mut walker.*, arguments[0], current)
    run appendOperand(&mut carried, List<Carry>.asSlice(&input.carried), usize.ZERO)
    current = input.at
    first = usize.ONE
  }
  let target = run calleeAccess(nodes, locals, owner, &mut walker.*, callee, exclusive, current)
  run appendOperand(&mut carried, List<Carry>.asSlice(&target.carried), arguments.length)
  current = target.at
  let mut index = first
  while index < arguments.length {
    let flow = run visit(nodes, locals, owner, &mut walker.*, arguments[index], current)
    run appendOperand(&mut carried, List<Carry>.asSlice(&flow.carried), index)
    current = flow.at
    index = index + usize.ONE
  }
  let untyped = List<NodeId>.make()
  let sinks = run operandSinks(nodes, result, arguments, owner)
  let unplaced = List<List<Step>>.make()
  let invoked = run finish(nodes, owner, &mut walker.*, result, current, &carried, false, Forwarding.None, List<List<Step>>.asSlice(&unplaced), List<NodeId>.asSlice(&untyped), List<OperandSink>.asSlice(&sinks))
  let transferred = run storeIntoLent(nodes, locals, owner, &mut walker.*, result, arguments, List<Carry>.asSlice(&carried),
    nodes[result.index].origin.location, invoked.at)
  // The callable stores what its environment holds, not the loan this invocation takes of it.
  let callee = run pathOf(nodes, callee)
  let mut environment = List<Carry>.make()
  let lent = List<Carry>.asSlice(&target.carried)
  index = usize.ZERO
  while index < lent.length {
    if List<Loan>.asSlice(&walker.loans)[lent[index].loan].place.root != callee.root || callee.root == usize.MAX {
      run List<Carry>.append(&mut environment, lent[index])
    }
    index = index + usize.ONE
  }
  let stored = run storeThroughExclusive(locals, owner, &mut walker.*, List<Carry>.asSlice(&carried), List<Carry>.asSlice(&environment),
    nodes[result.index].origin.location, transferred)
  return Flow {at: stored, carried: move invoked.carried}
}

// Constructs the Effect an `effect fn` value's invocation promises without calling it (EFF-001). The
// Effect takes its callee as the callee's mode grants: it owns a `once fn` callee, already a typed
// move, and holds a shared or exclusive loan of any other callee place, which carries the callee's
// own loans. Its operands enter the environment by CAPTURE-002. Every loan travels with the Effect
// value, so it stays live until the Effect's last run or drop (EFFECT-OWN-001, EFFECT-OWN-002).
effect fn defer(nodes: &[Node], locals: &[Local], owner: &DeclarationId, walker: &mut Walker, callee: NodeId, arguments: &[NodeId],
  pipeline: bool, mode: CallableMode, result: NodeId, at: usize) -> Flow
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut carried = List<Carry>.make()
  let mut current = at
  let mut first = usize.ZERO
  let sinks = run operandSinks(nodes, result, arguments, owner)
  let kept = List<OperandSink>.asSlice(&sinks)
  if pipeline && arguments.length > usize.ZERO {
    let input = run visit(nodes, locals, owner, &mut walker.*, arguments[0], current)
    run keepCarried(&mut walker.*, owner, List<Carry>.asSlice(&input.carried), kept, usize.ZERO, input.at)
    run appendCarried(&mut carried, List<Carry>.asSlice(&input.carried))
    current = input.at
    first = usize.ONE
  }
  let target = run capturedCallee(nodes, locals, owner, &mut walker.*, callee, mode, current)
  run appendCarried(&mut carried, List<Carry>.asSlice(&target.carried))
  current = target.at
  let mut index = first
  while index < arguments.length {
    let flow = run visit(nodes, locals, owner, &mut walker.*, arguments[index], current)
    run keepCarried(&mut walker.*, owner, List<Carry>.asSlice(&flow.carried), kept, index, flow.at)
    run appendCarried(&mut carried, List<Carry>.asSlice(&flow.carried))
    current = flow.at
    index = index + usize.ONE
  }
  let point = run newPoint(&mut walker.*, current)
  return Flow {at: point, carried: move carried}
}

// The callee a constructed Effect retains: a borrow of a shared or `mut fn` callee place, otherwise
// the callee's value.
effect fn capturedCallee(nodes: &[Node], locals: &[Local], owner: &DeclarationId, walker: &mut Walker, callee: NodeId, mode: CallableMode, at: usize) -> Flow
! OutOfMemoryError ? &mut Allocator | &mut Types {
  if mode == CallableMode.Once {
    return run visit(nodes, locals, owner, &mut walker.*, callee, at)
  }
  let path = run pathOf(nodes, callee)
  if path.root == usize.MAX {
    return run visit(nodes, locals, owner, &mut walker.*, callee, at)
  }
  let span = nodes[callee.index].origin.location
  return run borrow(nodes, locals, owner, &mut walker.*, callee, mode == CallableMode.Mutable, span, usize.MAX, at)
}

// The callee of an invocation. A shared or consuming callee is an ordinary read or move of its
// value. A `mut fn` callee written as a place is borrowed exclusively for the call, which reads its
// held loans, so another live loan of that place conflicts with the invocation.
effect fn calleeAccess(nodes: &[Node], locals: &[Local], owner: &DeclarationId, walker: &mut Walker, callee: NodeId, exclusive: bool, at: usize) -> Flow
! OutOfMemoryError ? &mut Allocator | &mut Types {
  if !exclusive {
    return run visit(nodes, locals, owner, &mut walker.*, callee, at)
  }
  let path = run pathOf(nodes, callee)
  if path.root == usize.MAX {
    return run visit(nodes, locals, owner, &mut walker.*, callee, at)
  }
  let span = nodes[callee.index].origin.location
  return run borrow(nodes, locals, owner, &mut walker.*, callee, true, span, usize.MAX, at)
}

fn isBorrow(nodes: &[Node], id: NodeId) -> bool {
  if let NodeKind.Expression {form, ..} = &nodes[id.index].kind {
    if let Expression.Borrow {..} = &form {
      return true
    }
  }
  return false
}

// Whether a node constructs a callable value from its captures: a closure or an `effect` block.
fn isCallable(nodes: &[Node], id: NodeId) -> bool {
  if let NodeKind.Expression {form, ..} = &nodes[id.index].kind {
    if let Expression.Callable {..} = &form {
      return true
    }
  }
  return false
}

// Whether a type is an Effect type.
fn effectType(ty: &Type) -> bool {
  return match &ty.* {
    Type.Effect {..} => true
    Type.EffectComposite {..} => true
    Type.EffectJoin {..} => true
    _ => false
  }
}

// Whether a callable value of this type is an Effect: an `effect` block's value, or an Effect an
// `effect fn` call constructs.
fn effectBlock(ty: &Type) -> bool {
  return match &ty.* {
    Type.CallableValue {contract, ..} => Shared<Type>.with<bool>(&contract, effectType)
    _ => false
  }
}

// Whether a type is a reference, whose referent's storage another place owns.
fn referenceType(ty: &Type) -> bool {
  return match &ty.* {
    Type.Reference {..} => true
    _ => false
  }
}

// Whether a local of this type is a callable value in any of its typed forms.
fn callableValue(ty: &Type) -> bool {
  return match &ty.* {
    Type.Callable {..} => true
    Type.CallableValue {..} => true
    Type.CallableSchema {..} => true
    Type.CallableStage {..} => true
    Type.CallableResult {..} => true
    Type.CallableOrigin {..} => true
    Type.CallableWitnessResult {..} => true
    Type.CallableView {..} => true
    _ => false
  }
}

fn localType(locals: &[Local], local: usize) -> Shared<Type> {
  return Shared<Type>.clone(&locals[local].ty)
}

// The node shape `visit` dispatches on, read without holding a borrow of the node across calls.
union Shape {
  Leaf,
  Outside {reason: BorrowStatus},
  ReadPlace,
  Borrow {access: Access, value: NodeId},
  Move {value: NodeId, consumed: bool},
  // `places` are the field or element indexes of an aggregate's operands, in order; usize.MAX
  // denotes all repeated elements. Empty for any other value built from operands.
  Operands {values: List<NodeId>, places: List<usize>, member: usize},
  // `&&` or `||`: the right operand runs on one path, and its temporaries end with it.
  ShortCircuit {left: NodeId, right: NodeId},
  PassThrough {value: NodeId},
  // `signature` marks a call to a declaration or interface operation, whose written signature
  // types its arguments and result.
  Call {arguments: List<NodeId>, receiver: usize, exact: bool, signature: bool},
  Invoke {callee: NodeId, arguments: List<NodeId>, pipeline: bool, exclusive: bool},
  // `referents` name their operands by position.
  // `holdable` says, per value, where the callable could store a loan it carries; empty when typing
  // recorded nothing, which lets every value be stored anywhere. `body` is the status of the callable's
  // own anonymous body, `Checked` for one with none.
  Construct {values: List<NodeId>, referents: List<ReferentCapture>, staged: bool, holdable: List<CaptureHold>, body: BorrowStatus},
  Defer {callee: NodeId, arguments: List<NodeId>, pipeline: bool, mode: CallableMode},
  Binding {local: usize, initializer: NodeId, mutable: bool},
  Assignment {local: usize, value: NodeId},
  PlaceAssignment {target: NodeId, value: NodeId},
  Displace {target: NodeId, value: NodeId},
  Exit {value: Option<NodeId>},
  Drop {value: NodeId, consumed: bool},
  Branch {condition: NodeId, thenBranch: NodeId, elseBranch: Option<NodeId>},
  While {condition: NodeId, body: NodeId},
  Break,
  Continue,
  // A statement that failed to check in a rejected body. No edge leaves it, so no move or loan
  // crosses a statement whose effects are unknown. When it surely let a path continue, the
  // statement after it resumes from the body's entry and the statements after it are still
  // checked among themselves; otherwise they stay unreached, as after a `return`.
  Recovered {resumes: bool},
  Block {statements: List<NodeId>},
  Match {subject: NodeId, access: Scrutinee, arms: List<ArmShape>, syntax: MatchSyntax},
}

// How a match reaches its subject, read from `SubjectAccess` without holding the node.
enum Scrutinee {
  // A bare match copies the subject; `match move` of a value with no place consumes it.
  Value,
  // `match move` of a place moves it.
  Moved,
  // `match &` reads the subject place.
  Shared,
  // `match &mut` updates it.
  Exclusive,
  // `match place` inspects its tag.
  Place,
}

struct ArmShape {
  guard: Option<NodeId>
  result: NodeId
  // Whether the arm's pattern declares a binding.
  binds: bool
}

fn scrutineeOf(access: &SubjectAccess) -> Scrutinee {
  return match &access.* {
    SubjectAccess.Copy => Scrutinee.Value
    SubjectAccess.Consume {consumed} => {
      if hasPlace(&consumed) {
        return Scrutinee.Moved
      }
      return Scrutinee.Value
    }
    SubjectAccess.Place {access: binding} => {
      if binding == BindingAccess.Shared {
        return Scrutinee.Shared
      }
      if binding == BindingAccess.Exclusive {
        return Scrutinee.Exclusive
      }
      return Scrutinee.Place
    }
  }
}

effect fn armShapes(arms: &[MatchArm]) -> List<ArmShape> ! OutOfMemoryError ? &mut Allocator {
  let mut shapes = List<ArmShape>.make()
  let mut at = usize.ZERO
  while at < arms.length {
    run List<ArmShape>.append(&mut shapes, ArmShape {guard: copyNode(&arms[at].guard), result: arms[at].result,
      binds: List<NodeId>.length(&arms[at].bindings) > usize.ZERO})
    at = at + usize.ONE
  }
  return move shapes
}

effect fn shapeOf(nodes: &[Node], id: NodeId) -> Shape ! OutOfMemoryError ? &mut Allocator {
  return match &nodes[id.index].kind {
    NodeKind.Expression {form, ty} => {
      // A named function's section is an aggregate of its captured operands (CALLABLE-001).
      if let Expression.Aggregate {fields, section, ..} = &form {
        if Shared<Type>.with<bool>(&ty, callableValue) {
          return Shape.Construct {values: run fieldValues(List<AggregateField>.asSlice(&fields)), referents: List<ReferentCapture>.make(), holdable: List<CaptureHold>.make(),
            staged: match &section { Option<SectionRetention>.Some {..} => true _ => false }, body: BorrowStatus.Checked}
        }
      }
      // An immediate run is exactly the one call it executes (EFF-003): the Effect that call
      // constructs is a temporary only this run consumes, so its operands are the call's arguments
      // and the run node is the call's result (EFFECT-OWN-001, BORROW-004).
      if let Expression.Run {value, access} = &form {
        if access == RunAccess.Immediate {
          if let NodeKind.Expression {form: operand, ..} = &nodes[value.index].kind {
            // Running an `effect fn` value's invocation in place invokes that value (CALLABLE-002).
            if let Expression.CallableCall {callee, mode, arguments, pipeline, ..} = &operand {
              return Shape.Invoke {callee: callee, arguments: run copyIds(List<NodeId>.asSlice(&arguments)), pipeline: pipeline,
                exclusive: mode == CallableMode.Mutable}
            }
            // The run's result is the call's success value, which stores none of its operands
            // beyond what its own type retains.
            if let Expression.DirectCall {arguments, receiverPass, ..} = &operand {
              return Shape.Call {arguments: run copyIds(List<NodeId>.asSlice(&arguments)), receiver: receiverOf(&receiverPass), exact: false,
                signature: true}
            }
            if let Expression.InterfaceCall {arguments, receiverPass, ..} = &operand {
              return Shape.Call {arguments: run copyIds(List<NodeId>.asSlice(&arguments)), receiver: receiverOf(&receiverPass), exact: false,
                signature: true}
            }
            // A drive retains its operands in an opaque Effect until activation. Only this
            // immediate run can consume all operand/capture loans at the S2 call point.
            if let Expression.StorageCall {operation, arguments, ..} = &operand {
              if operation == StorageOperation.ExecutionDrive {
                return Shape.Call {arguments: run copyIds(List<NodeId>.asSlice(&arguments)), receiver: usize.ZERO, exact: false,
                  signature: false}
              }
            }
            return run expressionShape(&operand)
          }
        }
      }
      return run expressionShape(&form)
    }
    NodeKind.LocalBinding {local, initializer} => Shape.Binding {local: local.index, initializer: initializer, mutable: false}
    NodeKind.MutableBinding {local, initializer} => Shape.Binding {local: local.index, initializer: initializer, mutable: true}
    NodeKind.Assignment {local, value} => Shape.Assignment {local: local.index, value: value}
    NodeKind.PlaceAssignment {target, value} => Shape.PlaceAssignment {target: target, value: value}
    NodeKind.Return {value} => Shape.Exit {value: copyNode(&value)}
    NodeKind.Fail {value} => Shape.Exit {value: Option<NodeId>.some(value)}
    NodeKind.Drop {value, consumed} => Shape.Drop {value: value, consumed: hasPlace(&consumed)}
    NodeKind.Branch {condition, thenBranch, elseBranch, ..} => Shape.Branch {condition: condition, thenBranch: thenBranch, elseBranch: copyNode(&elseBranch)}
    NodeKind.While {condition, body} => Shape.While {condition: condition, body: body}
    NodeKind.Break => Shape.Break
    NodeKind.Continue => Shape.Continue
    NodeKind.Recovered {resumes} => Shape.Recovered {resumes: resumes}
    NodeKind.Block {statements, ..} => Shape.Block {statements: run copyIds(List<NodeId>.asSlice(&statements))}
  }
}

fn copyNode(value: &Option<NodeId>) -> Option<NodeId> {
  if let Option<NodeId>.Some {value: node} = &value.* {
    return Option<NodeId>.some(node)
  }
  return Option<NodeId>.none()
}

// The receiver pass of a call: 0 none, 1 shared, 2 mutable, 3 taking.
fn receiverOf(value: &Option<ReceiverPass>) -> usize {
  if let Option<ReceiverPass>.Some {value: pass} = &value.* {
    if pass == ReceiverPass.Shared {
      return usize.ONE
    }
    if pass == ReceiverPass.Mutable {
      return 2
    }
    return 3
  }
  return usize.ZERO
}

fn hasPlace(consumed: &Option<ConsumedPlace>) -> bool {
  return match &consumed.* {
    Option<ConsumedPlace>.Some {..} => true
    Option<ConsumedPlace>.None => false
  }
}

effect fn expressionShape(form: &Expression) -> Shape ! OutOfMemoryError ? &mut Allocator {
  return match &form.* {
    Expression.Local {..} => Shape.ReadPlace
    Expression.Field {..} => Shape.ReadPlace
    Expression.Index {..} => Shape.ReadPlace
    Expression.Dereference {..} => Shape.ReadPlace
    Expression.Borrow {access, value} => Shape.Borrow {access: access, value: value}
    Expression.Move {value, consumed} => Shape.Move {value: value, consumed: hasPlace(&consumed)}
    Expression.PointerWeaken {value} => Shape.PassThrough {value: value}
    Expression.ArraySlice {value, ..} => Shape.PassThrough {value: value}
    Expression.SliceLength {value} => Shape.Operands {values: run single(value), places: List<usize>.make(), member: usize.MAX}
    Expression.ArrayLength {value, ..} => Shape.Operands {values: run single(value), places: List<usize>.make(), member: usize.MAX}
    Expression.ArrayRepeat {value, count} => {
      if count == usize.ZERO { return Shape.Drop {value: value, consumed: false} }
      let mut places = List<usize>.make()
      let mut element = usize.MAX
      if count == usize.ONE { element = usize.ZERO }
      run List<usize>.append(&mut places, element)
      return Shape.Operands {values: run single(value), places: move places, member: usize.MAX}
    }
    Expression.EnumValue {value} => Shape.Operands {values: run single(value), places: List<usize>.make(), member: usize.MAX}
    Expression.UnionInject {value, ..} => Shape.Operands {values: run single(value), places: List<usize>.make(), member: usize.MAX}
    Expression.UnionWiden {value} => Shape.Operands {values: run single(value), places: List<usize>.make(), member: usize.MAX}
    Expression.ConcretePrefix {operand, ..} => Shape.Operands {values: run single(operand), places: List<usize>.make(), member: usize.MAX}
    Expression.CompileError {message} => Shape.Operands {values: run single(message), places: List<usize>.make(), member: usize.MAX}
    Expression.ConcreteInfix {operator, left, right} => {
      if operator == InfixOperator.And || operator == InfixOperator.Or {
        return Shape.ShortCircuit {left: left, right: right}
      }
      let mut values = run single(left)
      run List<NodeId>.append(&mut values, right)
      return Shape.Operands {values: move values, places: List<usize>.make(), member: usize.MAX}
    }
    Expression.Aggregate {fields, ..} => Shape.Operands {
      values: run fieldValues(List<AggregateField>.asSlice(&fields)), places: run fieldIndexes(List<AggregateField>.asSlice(&fields)), member: usize.MAX,
    }
    Expression.VariantConstruct {tag, fields} => Shape.Operands {
      values: run fieldValues(List<AggregateField>.asSlice(&fields)), places: run fieldIndexes(List<AggregateField>.asSlice(&fields)), member: tag,
    }
    // An `effect fn` call's Effect stores exactly its written arguments (EFFECT-OWN-001).
    Expression.DirectCall {arguments, receiverPass, constructs, ..} => Shape.Call {
      arguments: run copyIds(List<NodeId>.asSlice(&arguments)), receiver: receiverOf(&receiverPass), exact: constructs, signature: true,
    }
    Expression.InterfaceCall {arguments, receiverPass, isEffect, ..} => Shape.Call {
      arguments: run copyIds(List<NodeId>.asSlice(&arguments)), receiver: receiverOf(&receiverPass), exact: isEffect, signature: true,
    }
    Expression.ForeignCall {arguments, ..} => Shape.Call {
      arguments: run copyIds(List<NodeId>.asSlice(&arguments)), receiver: usize.ZERO, exact: false, signature: false,
    }
    Expression.IntrinsicCall {arguments, ..} => Shape.Call {
      arguments: run copyIds(List<NodeId>.asSlice(&arguments)), receiver: usize.ZERO, exact: false, signature: false,
    }
    Expression.Integer {..} => Shape.Leaf
    Expression.Float {..} => Shape.Leaf
    Expression.Text {..} => Shape.Leaf
    Expression.Boolean {..} => Shape.Leaf
    Expression.Unit => Shape.Leaf
    Expression.Embedded {..} => Shape.Leaf
    Expression.EnumMember {..} => Shape.Leaf
    Expression.Constant {..} => Shape.Leaf
    Expression.ForeignStatic {..} => Shape.Leaf
    Expression.ForeignAddress {..} => Shape.Leaf
    // An anonymous body that stores one captured loan where another capture reaches needs a
    // relation between two body regions, which no premise of its own proves, so a body the borrow
    // check closed stores none (ANON-OWN-001).
    Expression.Callable {fields, referents, holdable, body, ..} => Shape.Construct {
      values: run fieldValues(List<AggregateField>.asSlice(&fields)),
      referents: run referentOperands(List<AggregateField>.asSlice(&fields), List<ReferentCapture>.asSlice(&referents)), staged: false,
      holdable: run fieldHoldable(List<AggregateField>.asSlice(&fields), List<CaptureHold>.asSlice(&holdable)),
      body: Shared<TypedBody>.with<BorrowStatus>(&body, TypedBody.borrowStatus),
    }
    Expression.StagedCallable {callee, arguments, ..} => {
      let mut values = run single(callee)
      let supplied = List<NodeId>.asSlice(&arguments)
      let mut at = usize.ZERO
      while at < supplied.length {
        run List<NodeId>.append(&mut values, supplied[at])
        at = at + usize.ONE
      }
      return Shape.Construct {values: move values, referents: List<ReferentCapture>.make(), staged: true, holdable: List<CaptureHold>.make(), body: BorrowStatus.Checked}
    }
    Expression.CallableCall {callee, mode, arguments, pipeline, constructs, ..} => {
      // Invoking an `effect fn` value without running it constructs an Effect that stores its
      // operands (EFF-001).
      if constructs {
        return Shape.Defer {callee: callee, arguments: run copyIds(List<NodeId>.asSlice(&arguments)), pipeline: pipeline, mode: mode}
      }
      return Shape.Invoke {callee: callee, arguments: run copyIds(List<NodeId>.asSlice(&arguments)), pipeline: pipeline,
        exclusive: mode == CallableMode.Mutable}
    }
    // A stored Effect's run invokes the Effect value with the access its contract grants
    // (EFFECT-OWN-002): a shared Effect is read, a `mut Effect` place is borrowed exclusively, and a
    // `once Effect` operand is already a typed move. The loans its environment holds stay live
    // through the run (EFFECT-OWN-001, CALLABLE-003).
    Expression.Run {value, access} => Shape.Invoke {callee: value, arguments: List<NodeId>.make(), pipeline: false,
      exclusive: access == RunAccess.Exclusive}
    Expression.Match {subject, access, arms, syntax, ..} => Shape.Match {
      subject: subject, access: scrutineeOf(&access), arms: run armShapes(List<MatchArm>.asSlice(&arms)), syntax: syntax,
    }
    Expression.PatternBinding {..} => Shape.ReadPlace
    // A storage primitive whose contract names every region its result reaches is a call to that
    // contract; `unsafe` discharges only its memory obligations, never an aliasing one. Each result
    // that views or reaches an operand names that operand's region, so the call's retention rules
    // hold its loans.
    // `sharedWithMut` is such a call: it consumes its two callbacks, whose capture loans are live
    // through it, and the `&mut T` it lends comes from the runtime conflict check (SHARED-004), not
    // from a place this body holds. Callback result retention is checked against that invocation's
    // contract; Semantic.buildFrom judges every reached callback's suspension and notification
    // escapes with localSharedEscapes before emission (OWN0016, SHARED-003), even if this body is
    // region-closed and Checked. Notifications have the same independent gate; see
    // SemanticLoweringCases.localSharedAccessRejectsEveryReachedEscape's exact OWN0016 spans.
    // Current and relinquish have no operands or capture loans. `executionFromAllocation` consumes its
    // allocation, body, readiness state and endpoint; typing proves the last three
    // `Intrinsic.Detached` (EXEC-004), so the package retains no loan of the caller beyond what its
    // `Intrinsic.Execution<A>` result names. `slotAddress` consumes its slot, and its `*mut T` result
    // names no region, so it holds no loan: the address keeps no storage alive, and every access
    // through it is `unsafe` and proves its own validity.
    Expression.StorageCall {operation, arguments, ..} => {
      // `replace` writes its place operand and yields the value it displaces.
      if operation == StorageOperation.Replace {
        let operands = List<NodeId>.asSlice(&arguments)
        return Shape.Displace {target: operands[usize.ZERO], value: operands[usize.ONE]}
      }
      // A delayed drive's empty native environment does not prove the loans it stores; lowering
      // runs only an immediate drive, so such a body is never emitted (EXEC-002).
      if operation == StorageOperation.ExecutionDrive {
        return Shape.Outside {reason: BorrowStatus.StoredLoans}
      }
      if contractCall(operation) {
        return Shape.Call {arguments: run copyIds(List<NodeId>.asSlice(&arguments)), receiver: usize.ZERO, exact: false, signature: false}
      }
      // Only `replace` and a stored drive have no contract call, and both are handled above.
      return Shape.Outside {reason: BorrowStatus.StoredLoans}
    }
  }
}

// Whether a storage primitive is checked as a call to its catalog contract. The match is
// exhaustive, so a new primitive is classified before the walk accepts it.
fn contractCall(operation: StorageOperation) -> bool {
  return match operation {
    StorageOperation.RawBufferFrom => true
    StorageOperation.RawBufferSlot => true
    StorageOperation.RawBufferCount => true
    StorageOperation.RawBufferRead => true
    StorageOperation.RawBufferCopy => true
    StorageOperation.RawBufferFill => true
    StorageOperation.RawBufferView => true
    StorageOperation.RawBufferViewMut => true
    StorageOperation.SlotWrite => true
    StorageOperation.SlotTake => true
    StorageOperation.SlotDrop => true
    StorageOperation.SlotCopy => true
    StorageOperation.SlotAddress => true
    StorageOperation.SharedLayout => true
    StorageOperation.SharedFromAllocation => true
    StorageOperation.SharedClone => true
    StorageOperation.SharedWithMut => true
    StorageOperation.LayoutOf => true
    StorageOperation.SystemAllocationAcquire => true
    StorageOperation.StringUtf8Bytes => true
    StorageOperation.StringFromUtf8Unchecked => true
    StorageOperation.StringByteLength => true
    StorageOperation.Replace => false
    StorageOperation.ExecutionLayout => true
    StorageOperation.ExecutionFromAllocation => true
    StorageOperation.ExecutionDrive => false
    StorageOperation.Relinquish => true
    StorageOperation.ExecutionCurrent => true
    StorageOperation.ExecutionRefOf => true
    StorageOperation.ExecutionLoad => true
    StorageOperation.ExecutionStore => true
    StorageOperation.ExecutionNotify => true
    StorageOperation.ExecutionLive => true
  }
}


// The walk keeps lexical roots in acquisition order. Every outgoing edge replays the same
// reverse order; only the normal walk changes the stack used while constructing sibling paths.
effect fn registerRoot(walker: &mut Walker, root: usize) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run registerTemporary(&mut walker.*, root, true)
  return ()
}

// Registers a root in the innermost scope, or in the innermost scope that is not a statement's
// when `lexical`.
effect fn registerTemporary(walker: &mut Walker, root: usize, lexical: bool) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut at = List<Scope>.length(&walker.scopes) - usize.ONE
  while lexical && at > usize.ZERO && List<Scope>.asSlice(&walker.scopes)[at].statement {
    at = at - usize.ONE
  }
  let mut scopes = List<Scope>.asMutSlice(&mut walker.scopes)
  run List<usize>.append(&mut scopes[at].roots, root)
  return ()
}

effect fn releaseScopes(walker: &mut Walker, keep: usize, span: Location, at: usize) -> usize
  ! OutOfMemoryError
  ? &mut Allocator {
  if at == usize.MAX {
    return at
  }

  // Copy identities before mutating the graph: no view into Walker stays borrowed across a
  // mutable borrow of the complete walk.
  let mut releasing = List<usize>.make()
  let mut expiring = List<bool>.make()
  let scopes = List<Scope>.asSlice(&walker.scopes)
  let mut scope = scopes.length
  while scope > keep {
    scope = scope - usize.ONE
    let ended = List<usize>.asSlice(&scopes[scope].expiring)
    let mut index = ended.length
    while index > usize.ZERO {
      index = index - usize.ONE
      run List<usize>.append(&mut releasing, ended[index])
      run List<bool>.append(&mut expiring, true)
    }
    let roots = List<usize>.asSlice(&scopes[scope].roots)
    index = roots.length
    while index > usize.ZERO {
      index = index - usize.ONE
      run List<usize>.append(&mut releasing, roots[index])
      run List<bool>.append(&mut expiring, false)
    }
  }
  let roots = List<usize>.asSlice(&releasing)
  let expires = List<bool>.asSlice(&expiring)
  let mut current = at
  let mut index = usize.ZERO
  while index < roots.length {
    let root = roots[index]
    let path = Path {
      root: root,
      through: false,
      steps: List<Step>.make(),
      indexes: List<NodeId>.make(),
      refiner: usize.MAX,
      refinedDepth: usize.ZERO,
      binders: List<usize>.make(),
    }
    if expires[index] {
      current = run access(&mut walker.*, &path, Kind.Expire, span, current, usize.MAX)
    } else {
      let holder = holderOf(&walker.*, root)
      if lexicalHolder(&walker.*, root) {
        // A borrowed destructuring `let` lends its subject until its bindings' scope ends.
        current = run newPoint(&mut walker.*, current)
        let mut points = List<Point>.asMutSlice(&mut walker.points)
        points[current].uses = holder
        points[current].span = span
      } else if holder < List<bool>.length(&walker.unrun) && List<bool>.asSlice(&walker.unrun)[holder] {
        // An `effect` block's value that is never run or used keeps the loans of its own captures
        // to its scope end (EFFECT-OWN-001); what it holds through a captured value follows that
        // value's own uses, and one that is used holds its captures through its last use.
        current = run newPoint(&mut walker.*, current)
        let mut loans = List<Loan>.asMutSlice(&mut walker.loans)
        let mut loan = usize.ZERO
        while loan < loans.length {
          if loans[loan].block == holder { loans[loan].until = current }
          loan = loan + usize.ONE
        }
      }
      current = run observeCleanup(&mut walker.*, holder, root >= usize.MAX / 4, span, current)
      current = run access(&mut walker.*, &path, Kind.End, span, current, usize.MAX)
    }
    index = index + usize.ONE
  }
  return current
}

// Whether the cleanup of `holder`'s value can observe a loan: its type runs a hook that names a
// borrowed region, or one whose regions are unknown.
fn observingCleanup(walker: &Walker, holder: usize) -> bool {
  let available = List<LoanCleanup>.asSlice(&walker.cleanup)
  if holder >= available.length { return false }
  return available[holder].unknown || List<Shared<Lifetime>>.length(&available[holder].regions) > usize.ZERO
}

// Cleanup uses just the initialized definitions whose named regions the hook can observe.
// It is not a whole-holder read: a Drop in an unrelated field cannot extend every other loan. A
// hidden owner's cleanup that observes unknown regions (`hidden`) uses every loan the owner holds:
// it ends within the body, where the hook may observe any of them.
effect fn observeCleanup(walker: &mut Walker, holder: usize, hidden: bool, span: Location, at: usize) -> usize
  ! OutOfMemoryError
  ? &mut Allocator {
  let available = List<LoanCleanup>.asSlice(&walker.cleanup)
  if holder >= available.length {
    return at
  }
  let repeat = outermostOpenLoop(&walker.*)
  if (available[holder].unknown || List<Shared<Lifetime>>.length(&available[holder].regions) > usize.ZERO)
    && repeat != usize.MAX {
    let recorded = List<LoopCleanup>.asSlice(&walker.loopCleanup)
    let mut index = usize.ZERO
    while index < recorded.length && (recorded[index].holder != holder || recorded[index].repeat != repeat) {
      index = index + usize.ONE
    }
    if index == recorded.length {
      run List<LoopCleanup>.append(&mut walker.loopCleanup, LoopCleanup {holder: holder, repeat: repeat})
    }
  }
  let mut unknownHeld = false
  if available[holder].unknown && holder < List<List<usize>>.length(&walker.held) {
    let held = List<List<usize>>.asSlice(&walker.held)
    unknownHeld = List<usize>.length(&held[holder]) > usize.ZERO
  }
  if unknownHeld && !hidden {
    leave(&mut walker.*, BorrowStatus.StoredLoans)
    return at
  }
  let everything = unknownHeld && hidden
  if !everything && List<Shared<Lifetime>>.length(&available[holder].regions) == usize.ZERO {
    return at
  }
  let point = run newPoint(&mut walker.*, at)
  let mut points = List<Point>.asMutSlice(&mut walker.points)
  points[point].span = span
  let cleanup = List<LoanCleanup>.asSlice(&walker.cleanup)
  let observed = List<Shared<Lifetime>>.asSlice(&cleanup[holder].regions)
  let definitions = List<Holding>.asSlice(&walker.definitions)
  let mut index = usize.ZERO
  while index < definitions.length {
    let definition = definitions[index]
    if definition.holder == holder {
      let mut loans = List<Loan>.asMutSlice(&mut walker.loans)
      let named = List<Shared<Lifetime>>.asSlice(&loans[definition.loan].regions)
      if everything || named.length == usize.ZERO || sharesAtom(named, observed) {
        if named.length == usize.ZERO {
          loans[definition.loan].precision = LoanPrecision.Unknown
        }
        run List<
          Interval
        >.append(
          &mut loans[definition.loan].intervals,
          Interval {
            from: definition.point,
            to: point,
            definition: index,
            read: point,
            cleanup: true
          }
        )
      }
    }
    index = index + usize.ONE
  }
  return point
}

// Visits one node from point `at` and returns the point after it, or `usize.MAX` when no path
// continues, with the loans its value carries.
effect fn visit(
  nodes: &[Node],
  locals: &[Local],
  owner: &DeclarationId,
  walker: &mut Walker,
  id: NodeId,
  at: usize
) -> Flow
  ! OutOfMemoryError
  ? &mut Allocator | &mut Types {
  let flow = run visitNode(nodes, locals, owner, &mut walker.*, id, at)
  if
    !walker.outside && flow.at != usize.MAX {
    let mut runs = false
    if let NodeKind.Expression { form: Expression.Run { .. }, .. } = &nodes[id.index].kind {
      runs = true
    }
    if runs {
      let failed = run releaseScopes(
        &mut walker.*,
        usize.ZERO,
        nodes[id.index].origin.location,
        flow.at
      )
      let exit = walker.exit
      run edge(&mut walker.*, failed, exit)
    }
  }
  // An expression of type `never` does not complete: no path continues past it, so the code after
  // it is unreachable and never borrow-checked, as after a `return`.
  if !walker.outside && flow.at != usize.MAX && neverValue(nodes, id) {
    run consume(&mut walker.*, List<Carry>.asSlice(&flow.carried), flow.at)
    return flowAt(usize.MAX)
  }
  return move flow
}

fn neverValue(nodes: &[Node], id: NodeId) -> bool {
  if let NodeKind.Expression {ty, ..} = &nodes[id.index].kind {
    return Shared<Type>.with<bool>(&ty, uninhabited)
  }
  return false
}

fn uninhabited(ty: &Type) -> bool {
  return match &ty.* {
    Type.Union {members} => List<Shared<Type>>.length(&members) == usize.ZERO
    _ => false
  }
}

effect fn visitNode(nodes: &[Node], locals: &[Local], owner: &DeclarationId, walker: &mut Walker, id: NodeId, at: usize) -> Flow
! OutOfMemoryError ? &mut Allocator | &mut Types {
  if walker.outside || at == usize.MAX {
    return flowAt(at)
  }
  let span = nodes[id.index].origin.location
  let shape = run shapeOf(nodes, id)
  match move shape {
    Shape.Leaf => {
      return flowAt(at)
    }
    Shape.Outside {reason} => {
      leave(&mut walker.*, reason)
      return flowAt(at)
    }
    Shape.ReadPlace => {
      let mut path = run pathOf(nodes, id)
      let mut current = at
      if path.root == usize.MAX {
        // Lowering drops a temporary that needs cleanup at the end of its statement, or of a
        // viewing binding's scope when that binding's initializer retains it. A projection out of
        // one whose cleanup can observe a loan is read through its hidden owner, which
        // `holdTemporary` registers in that same scope, so the owner holds the loan until the
        // cleanup (BORROW-006).
        let base = projectedBase(nodes, id)
        if !observingCleanup(&walker.*, holderOf(&walker.*, temporaryRoot(nodes, base.index))) {
          return run readValue(nodes, locals, owner, &mut walker.*, id, at)
        }
        current = run holdTemporary(nodes, locals, owner, &mut walker.*, base, at)
        path = run temporaryPath(nodes, id, base)
      }
      let flow = run place(nodes, locals, owner, &mut walker.*, &path, Kind.Read, span, current)
      if path.through || List<Step>.length(&path.steps) > usize.ZERO {
        // A read through or out of a holder copies a value; one that retains a region would carry
        // the holder's loan onward.
        if List<Carry>.length(&flow.carried) > usize.ZERO || (path.through && holds(&walker.*, path.root)) {
          let retained = run nodeRetains(nodes, id, owner)
          if retained {
            let declared = run declaredRead(nodes, id, owner)
            let read = run attributeRead(nodes, owner, &mut walker.*, &path, List<Carry>.asSlice(&flow.carried), &declared)
            let unplaced = List<List<Step>>.make()
            let untyped = List<NodeId>.make()
            let noSinks = List<OperandSink>.make()
            return run finish(nodes, owner, &mut walker.*, id, flow.at, &read, false, Forwarding.Matched, List<List<Step>>.asSlice(&unplaced), List<NodeId>.asSlice(&untyped), List<OperandSink>.asSlice(&noSinks))
          }
        }
        let point = run newPoint(&mut walker.*, flow.at)
        // Overwritten holdings describe the holder's historical type, not the source of this
        // scalar read. Retained-value reads above still carry that history. An inherited holding
        // is a distinct value and remains a possible source until its own place is overwritten.
        let mut selected = List<Carry>.make()
        let carried = List<Carry>.asSlice(&flow.carried)
        let definitions = List<Holding>.asSlice(&walker.definitions)
        let mut index = usize.ZERO
        while index < carried.length {
          let carry = carried[index]
          if carry.definition == usize.MAX || !definitions[carry.definition].shadowed {
            run List<Carry>.append(&mut selected, carry)
          }
          index = index + usize.ONE
        }
        run consume(&mut walker.*, List<Carry>.asSlice(&selected), point)
        return flowAt(point)
      }
      return move flow
    }
    Shape.Borrow {access, value} => {
      return run borrow(nodes, locals, owner, &mut walker.*, value, access == Access.Mutable, span, id.index, at)
    }
    Shape.Move {value, consumed} => {
      if consumed {
        let path = run pathOf(nodes, value)
        if path.root == usize.MAX || path.through {
          leave(&mut walker.*, BorrowStatus.StoredLoans)
          return flowAt(at)
        }
        let moved = run place(nodes, locals, owner, &mut walker.*, &path, Kind.Move, span, at)
        let event = List<Point>.asSlice(&walker.points)[moved.at].event
        let mut events = List<Event>.asMutSlice(&mut walker.events)
        events[event].target = nodes[value.index].origin.location
        return move moved
      }
      return run visit(nodes, locals, owner, &mut walker.*, value, at)
    }
    Shape.Operands {values, places, member} => {
      return run operands(nodes, locals, owner, &mut walker.*, List<NodeId>.asSlice(&values), List<usize>.asSlice(&places), member, id, at)
    }
    Shape.ShortCircuit {left, right} => {
      let mut carried = List<Carry>.make()
      let first = run visit(nodes, locals, owner, &mut walker.*, left, at)
      run appendOperand(&mut carried, List<Carry>.asSlice(&first.carried), usize.ZERO)
      let second = run settled(nodes, locals, owner, &mut walker.*, right, first.at)
      run appendOperand(&mut carried, List<Carry>.asSlice(&second.carried), usize.ONE)
      // The left operand alone can decide the result, so the path that skips the right operand
      // joins it: a right operand that never completes does not end the expression.
      let mut reached = second.at
      if first.at != usize.MAX {
        reached = run newPoint(&mut walker.*, second.at)
        run edge(&mut walker.*, first.at, reached)
      }
      let untyped = List<NodeId>.make()
      let noSinks = List<OperandSink>.make()
      let unplaced = List<List<Step>>.make()
      return run finish(nodes, owner, &mut walker.*, id, reached, &carried, false, Forwarding.None, List<List<Step>>.asSlice(&unplaced), List<NodeId>.asSlice(&untyped), List<OperandSink>.asSlice(&noSinks))
    }
    Shape.PassThrough {value} => {
      return run visit(nodes, locals, owner, &mut walker.*, value, at)
    }
    Shape.Call {arguments, receiver, exact, signature} => {
      return run call(nodes, locals, owner, &mut walker.*, List<NodeId>.asSlice(&arguments), receiver, exact, signature, id, at)
    }
    Shape.Construct {values, referents, staged, holdable, body} => {
      return run construct(nodes, locals, owner, &mut walker.*, List<NodeId>.asSlice(&values), List<ReferentCapture>.asSlice(&referents), staged,
        List<CaptureHold>.asSlice(&holdable), body, id, at)
    }
    Shape.Invoke {callee, arguments, pipeline, exclusive} => {
      return run invoke(nodes, locals, owner, &mut walker.*, callee, List<NodeId>.asSlice(&arguments), pipeline, exclusive, id, at)
    }
    Shape.Defer {callee, arguments, pipeline, mode} => {
      return run defer(nodes, locals, owner, &mut walker.*, callee, List<NodeId>.asSlice(&arguments), pipeline, mode, id, at)
    }
    Shape.Binding {local, initializer, mutable} => {
      let declared = localType(locals, local)
      run recordStore(&mut walker.*, owner, &declared, span, local)
      walker.retention = Retention.None
      if Shared<Type>.with<bool>(&declared, Type.holdsView) {
        walker.retention = Retention.Arrays
      } else if Type.hasOpenRuntimeParameters(&declared) {
        walker.retention = Retention.Storage
      }
      let firstLoan = List<Loan>.length(&walker.loans)
      let flow = run visit(nodes, locals, owner, &mut walker.*, initializer, at)
      walker.retention = Retention.None
      let point = run newPoint(&mut walker.*, flow.at)
      let mut initialized = List<Point>.asMutSlice(&mut walker.points)
      initialized[point].initializes = local
      initialized[point].defines = local
      // A binding retains its initializer's value here, which is where a loan it carries is retained.
      initialized[point].span = nodes[initializer.index].origin.location
      run registerRoot(&mut walker.*, local)
      if isCallable(nodes, initializer) && Shared<Type>.with<bool>(&declared, effectBlock) && local < List<bool>.length(&walker.unrun) {
        let mut unrun = List<bool>.asMutSlice(&mut walker.unrun)
        unrun[local] = true
        // The loans this initializer took are the block's own captures.
        let mut loans = List<Loan>.asMutSlice(&mut walker.loans)
        let mut loan = firstLoan
        while loan < loans.length {
          loans[loan].block = local
          loan = loan + usize.ONE
        }
      }
      if List<Carry>.length(&flow.carried) > usize.ZERO {
        // A binding whose written type names only universal regions, chosen before the body runs,
        // keeps what it is given valid for them: its loans outlive the body wherever their creation
        // reaches. An inferred type may name a parameter's region without requiring it.
        if locals[local].written && run universallyTyped(&declared, owner) {
          let given = List<Carry>.asSlice(&flow.carried)
          let mut all = List<Loan>.asMutSlice(&mut walker.loans)
          let mut each = usize.ZERO
          while each < given.length {
            all[given[each].loan].escapes = true
            each = each + usize.ONE
          }
        }
        run consume(&mut walker.*, List<Carry>.asSlice(&flow.carried), point)
        let ty = localType(locals, local)
        let callable = Shared<Type>.with<bool>(&ty, callableValue)
        let retained = callable || run retains(&ty, owner)
        if retained {
          // A `mut fn` is invoked through a mutable binding. Its capture loans stay held until the
          // local's last use even if it is replaced, and a replacement that carries loans leaves.
          if mutable && !callable {
            cross(&mut walker.*, List<Carry>.asSlice(&flow.carried))
          }
          run hold(&mut walker.*, local, List<Carry>.asSlice(&flow.carried), point, true)
        }
      }
      return flowAt(point)
    }
    Shape.Assignment {local, value} => {
      run recordStore(&mut walker.*, owner, &localType(locals, local), span, local)
      // The written binding is the statement's first token.
      let target = Location {start: span.start, end: span.start + usize.ONE}
      return run replace(nodes, locals, owner, &mut walker.*, local, value, span, target, at)
    }
    Shape.PlaceAssignment {target, value} => {
      let path = run pathOf(nodes, target)
      if path.through {
        if let Option<Shared<Type>>.Some {value: written} = move expressionType(nodes, target) {
          run recordStore(&mut walker.*, owner, &written, span, usize.MAX)
        }
        let source = run pathOf(nodes, movedOperand(nodes, value))
        if source.root < walker.localCount && !source.through { run List<usize>.append(&mut walker.escaping, source.root) }
      } else if path.root < walker.localCount {
        run recordStore(&mut walker.*, owner, &localType(locals, path.root), span, path.root)
      }
      if path.root != usize.MAX && !path.through && List<Step>.length(&path.steps) == usize.ZERO {
        return run replace(nodes, locals, owner, &mut walker.*, path.root, value, span, nodes[target.index].origin.location, at)
      }
      if path.root == usize.MAX {
        leave(&mut walker.*, BorrowStatus.StoredLoans)
        return flowAt(at)
      }
      let evaluated = run indexes(nodes, locals, owner, &mut walker.*, &path, at)
      let since = List<Event>.length(&walker.events)
      let flow = run visit(nodes, locals, owner, &mut walker.*, value, evaluated)
      // Storage behind a reference may outlive this body whatever regions its type names, so a
      // loan of storage this body owns stored there is left unchecked rather than consumed.
      if path.through && carriesLocal(&walker.*, List<Carry>.asSlice(&flow.carried)) {
        leave(&mut walker.*, BorrowStatus.StoredLoans)
        return flowAt(flow.at)
      }
      if List<Carry>.length(&flow.carried) > usize.ZERO {
        let retained = run nodeRetains(nodes, target, owner)
        if retained {
          if path.through {
            leave(&mut walker.*, BorrowStatus.StoredLoans)
            return flowAt(flow.at)
          }
          let carried = List<Carry>.asSlice(&flow.carried)
          let mut loans = List<Loan>.asMutSlice(&mut walker.loans)
          let mut index = usize.ZERO
          while index < carried.length {
            // A field store keeps an exact loan's flow but not its region relation.
            let stored = loans[carried[index].loan].precision
            if stored == LoanPrecision.Exact { loans[carried[index].loan].precision = LoanPrecision.Stored }
            else if stored == LoanPrecision.Alternatives { loans[carried[index].loan].precision = LoanPrecision.Unknown }
            index = index + usize.ONE
          }
        }
      }
      let targetSpan = writtenSpan(nodes, target)
      let mut point = usize.MAX
      if path.through {
        let reached = run throughReference(&mut walker.*, &path, Kind.Write, targetSpan, flow.at)
        run consume(&mut walker.*, List<Carry>.asSlice(&reached.carried), reached.at)
        point = reached.at
      } else {
        point = run access(&mut walker.*, &path, Kind.Write, targetSpan, flow.at, usize.MAX)
        markConsumedTarget(&mut walker.*, since, point, span)
      }
      run consume(&mut walker.*, List<Carry>.asSlice(&flow.carried), point)
      if !path.through && run nodeRetains(nodes, target, owner) {
        // The written place's old value leaves, and with it every loan held within that place.
        let used = run useHolder(&mut walker.*, path.root, usize.MAX, targetSpan, point)
        if exactPath(List<Step>.asSlice(&path.steps)) {
          let written = run internPath(&mut walker.*, run copySteps(List<Step>.asSlice(&path.steps)))
          let mut points = List<Point>.asMutSlice(&mut walker.points)
          points[used.at].written = written
        }
        let mut carrying = List<Carry>.make()
        let mut discarded = List<Carry>.make()
        let previous = List<Carry>.asSlice(&used.carried)
        let mut index = usize.ZERO
        while index < previous.length {
          let shadowed = previous[index].definition != usize.MAX
            && List<Holding>.asSlice(&walker.definitions)[previous[index].definition].shadowed
          if shadowed || run discards(&walker.*, List<Step>.asSlice(&path.steps), previous[index].field) {
            run List<Carry>.append(&mut discarded, previous[index])
          } else {
            run List<Carry>.append(&mut carrying, previous[index])
          }
          index = index + usize.ONE
        }
        let stored = List<Carry>.asSlice(&flow.carried)
        index = usize.ZERO
        while index < stored.length {
          let mut moved = stored[index]
          moved.field = run prefixedPath(&mut walker.*, List<Step>.asSlice(&path.steps), stored[index].field)
          moved.direct = moved.direct && moved.field != usize.MAX
          run List<Carry>.append(&mut carrying, moved)
          index = index + usize.ONE
        }
        run hold(&mut walker.*, path.root, List<Carry>.asSlice(&carrying), used.at, true)
        run shadow(&mut walker.*, path.root, List<Carry>.asSlice(&discarded), used.at)
        return flowAt(used.at)
      }
      return flowAt(point)
    }
    // `replace` is `let old = place; place = value` with nothing in between: the value is evaluated,
    // then the place is read and written at the call.
    Shape.Displace {target, value} => {
      let path = run pathOf(nodes, target)
      if path.root == usize.MAX {
        leave(&mut walker.*, BorrowStatus.StoredLoans)
        return flowAt(at)
      }
      // A displaced value that retains a region carries what its place held: through a reference,
      // what that reference reaches, as a read through it does. A local holder's definitions would
      // have to move to the displaced value, which this walk does not model.
      let retained = run nodeRetains(nodes, target, owner)
      if retained && !path.through {
        leave(&mut walker.*, BorrowStatus.StoredLoans)
        return flowAt(at)
      }
      let evaluated = run indexes(nodes, locals, owner, &mut walker.*, &path, at)
      let since = List<Event>.length(&walker.events)
      let flow = run visit(nodes, locals, owner, &mut walker.*, value, evaluated)
      let targetSpan = writtenSpan(nodes, target)
      let mut point = usize.MAX
      if path.through {
        // Storing a loan behind a reference is a retaining write through a referent.
        if retained && List<Carry>.length(&flow.carried) > usize.ZERO {
          leave(&mut walker.*, BorrowStatus.StoredLoans)
          return flowAt(flow.at)
        }
        let read = run throughReference(&mut walker.*, &path, Kind.Read, targetSpan, flow.at)
        let written = run throughReference(&mut walker.*, &path, Kind.Write, targetSpan, read.at)
        run consume(&mut walker.*, List<Carry>.asSlice(&written.carried), written.at)
        point = written.at
        run consume(&mut walker.*, List<Carry>.asSlice(&flow.carried), point)
        if retained {
          let untyped = List<NodeId>.make()
          let noSinks = List<OperandSink>.make()
          let unplaced = List<List<Step>>.make()
          return run finish(nodes, owner, &mut walker.*, id, point, &read.carried, false, Forwarding.None, List<List<Step>>.asSlice(&unplaced), List<NodeId>.asSlice(&untyped), List<OperandSink>.asSlice(&noSinks))
        }
        run consume(&mut walker.*, List<Carry>.asSlice(&read.carried), point)
        return flowAt(point)
      }
      // Reading a part of a holder uses the holder, as every read rooted at one does.
      let mut reading = flow.at
      if holds(&walker.*, path.root) {
        let read = run readPath(&mut walker.*, &path)
        let used = run useHolder(&mut walker.*, path.root, read, targetSpan, reading)
        run consume(&mut walker.*, List<Carry>.asSlice(&used.carried), used.at)
        reading = used.at
      }
      let read = run access(&mut walker.*, &path, Kind.Read, targetSpan, reading, usize.MAX)
      point = run access(&mut walker.*, &path, Kind.Write, targetSpan, read, usize.MAX)
      markConsumedTarget(&mut walker.*, since, point, span)
      run consume(&mut walker.*, List<Carry>.asSlice(&flow.carried), point)
      return flowAt(point)
    }
    Shape.Exit {value} => {
      let mut flow = flowAt(at)
      let mut required = span
      if let Option<NodeId>.Some {value: operand} = &value {
        // A returned value is stored in the caller's result slot, typed at the body's lifetime
        // parameters its result names, as a write through a reference is (`storedGoal`).
        if let NodeKind.Return {..} = &nodes[id.index].kind {
          if let Option<Shared<Type>>.Some {value: returned} = move expressionType(nodes, operand) {
            if let Option<StoreWindow>.Some {value: window} = move run storeWindow(owner, &returned, span, usize.MAX) {
              run List<StoreWindow>.append(&mut walker.returns, move window)
            }
          }
        }
        flow = run visit(nodes, locals, owner, &mut walker.*, operand, at)
        if let NodeKind.Return {..} = &nodes[id.index].kind {
          required = nodes[operand.index].origin.location
        }
      }
      let current = run releaseScopes(&mut walker.*, usize.ZERO, required, flow.at)
      let exit = run newPoint(&mut walker.*, current)
      let mut points = List<Point>.asMutSlice(&mut walker.points)
      points[exit].span = required
      run consume(&mut walker.*, List<Carry>.asSlice(&flow.carried), exit)
      cross(&mut walker.*, List<Carry>.asSlice(&flow.carried))
      let target = walker.exit
      run edge(&mut walker.*, exit, target)
      return flowAt(usize.MAX)
    }
    Shape.Drop {value, consumed} => {
      if consumed {
        let path = run pathOf(nodes, value)
        if path.root == usize.MAX || path.through {
          leave(&mut walker.*, BorrowStatus.StoredLoans)
          return flowAt(at)
        }
        let flow = run place(nodes, locals, owner, &mut walker.*, &path, Kind.Drop, span, at)
        let point = run newPoint(&mut walker.*, flow.at)
        run consume(&mut walker.*, List<Carry>.asSlice(&flow.carried), point)
        return flowAt(point)
      }
      let flow = run visit(nodes, locals, owner, &mut walker.*, value, at)
      let point = run newPoint(&mut walker.*, flow.at)
      run consume(&mut walker.*, List<Carry>.asSlice(&flow.carried), point)
      return flowAt(point)
    }
    Shape.Branch {condition, thenBranch, elseBranch} => {
      let tested = run settled(nodes, locals, owner, &mut walker.*, condition, at)
      let split = run newPoint(&mut walker.*, tested.at)
      run consume(&mut walker.*, List<Carry>.asSlice(&tested.carried), split)
      let taken = run visit(nodes, locals, owner, &mut walker.*, thenBranch, split)
      let mut other = flowAt(split)
      if let Option<NodeId>.Some {value: alternative} = &elseBranch {
        other = run visit(nodes, locals, owner, &mut walker.*, alternative, split)
      }
      // When neither arm completes, nothing follows the branch.
      if taken.at == usize.MAX && other.at == usize.MAX {
        return flowAt(usize.MAX)
      }
      let joined = run newPoint(&mut walker.*, taken.at)
      run edge(&mut walker.*, other.at, joined)
      let mut onward = List<Carry>.make()
      // `if` is a statement: its branches cannot yield a loan-carrying result. These consumes
      // may coincide with the last End; value-producing match arms instead consume after End.
      run rejoin(&mut walker.*, List<Carry>.asSlice(&taken.carried), taken.at, joined, &mut onward)
      run rejoin(&mut walker.*, List<Carry>.asSlice(&other.carried), other.at, joined, &mut onward)
      return Flow {at: joined, carried: move onward}
    }
    Shape.While {condition, body} => {
      let header = run newPoint(&mut walker.*, at)
      let exit = run newPoint(&mut walker.*, usize.MAX)
      let repeat = List<Loop>.length(&walker.loops)
      run List<Loop>.append(&mut walker.loops, Loop {before: at, header: header, sources: List<usize>.make(), end: usize.ZERO, span: span})
      // A `break` or `continue` in the condition belongs to the enclosing loop (TRANSFER-001), as
      // lowering evaluates the condition before it enters this loop's targets, so the condition is
      // walked before this loop's frame is pushed.
      let tested = run settled(nodes, locals, owner, &mut walker.*, condition, header)
      if tested.at == usize.MAX {
        let mut loops = List<Loop>.asMutSlice(&mut walker.loops)
        loops[repeat].end = List<Point>.length(&walker.points)
        return flowAt(usize.MAX)
      }
      // Only the checked literal supplies a feasible-edge fact. Evaluate the condition normally;
      // calls, local reads and other runtime expressions retain both alternatives.
      let mut enters = true
      let mut skips = true
      if let NodeKind.Expression {form: Expression.Boolean {value}, ..} = &nodes[condition.index].kind {
        enters = value
        skips = !value
      }
      run List<Frame>.append(&mut walker.frames, Frame {exit: exit, repeat: repeat, scopes: List<Scope>.length(&walker.scopes)})
      let split = run newPoint(&mut walker.*, tested.at)
      run consume(&mut walker.*, List<Carry>.asSlice(&tested.carried), split)
      if skips { run edge(&mut walker.*, split, exit) }
      let mut repeated = flowAt(usize.MAX)
      if enters { repeated = run visit(nodes, locals, owner, &mut walker.*, body, split) }
      run backEdge(&mut walker.*, repeat, repeated.at)
      let mut loops = List<Loop>.asMutSlice(&mut walker.loops)
      loops[repeat].end = List<Point>.length(&walker.points)
      let enclosing = List<Frame>.length(&walker.frames) - usize.ONE
      List<Frame>.truncate(&mut walker.frames, enclosing)
      if List<Carry>.length(&repeated.carried) > usize.ZERO {
        leave(&mut walker.*, BorrowStatus.StoredLoans)
      }
      if !skips {
        // A literal-true loop completes only through an actual break path. Do not revive code
        // after a returning or endlessly repeating body through its unattached exit point.
        let mut paths = List<ReplacementReach>.make()
        if !run reachesAvoiding(List<Point>.asSlice(&walker.points), &mut paths, split, exit, usize.MAX) { return flowAt(usize.MAX) }
      }
      return flowAt(exit)
    }
    Shape.Break => {
      let frames = List<Frame>.asSlice(&walker.frames)
      if frames.length == usize.ZERO {
        leave(&mut walker.*, BorrowStatus.Awaiting)
        return flowAt(usize.MAX)
      }
      let frame = frames[frames.length - usize.ONE]
      let released = run releaseScopes(&mut walker.*, frame.scopes, span, at)
      run edge(&mut walker.*, released, frame.exit)
      return flowAt(usize.MAX)
    }
    Shape.Recovered {resumes} => {
      if !resumes { return flowAt(usize.MAX) }
      let entry = walker.entry
      return flowAt(run newPoint(&mut walker.*, entry))
    }
    Shape.Continue => {
      let frames = List<Frame>.asSlice(&walker.frames)
      if frames.length == usize.ZERO {
        leave(&mut walker.*, BorrowStatus.Awaiting)
        return flowAt(usize.MAX)
      }
      let frame = frames[frames.length - usize.ONE]
      let released = run releaseScopes(&mut walker.*, frame.scopes, span, at)
      run backEdge(&mut walker.*, frame.repeat, released)
      return flowAt(usize.MAX)
    }
    Shape.Match {subject, access, arms, syntax} => {
      return run matchArms(nodes, locals, owner, &mut walker.*, subject, access, List<ArmShape>.asSlice(&arms), syntax, id, at)
    }
    Shape.Block {statements} => {
      let enclosing = List<Scope>.length(&walker.scopes)
      run List<Scope>.append(&mut walker.scopes, Scope {roots: List<usize>.make(), expiring: List<usize>.make(), statement: false})
      let list = List<NodeId>.asSlice(&statements)
      let mut flow = flowAt(at)
      let retention = walker.retention
      let mut index = usize.ZERO
      while index < list.length {
        // A statement's temporaries end with it (BORROW-006); a statement of a nested block is
        // never a binding initializer of an enclosing one.
        let statement = List<Scope>.length(&walker.scopes)
        run List<Scope>.append(&mut walker.scopes, Scope {roots: List<usize>.make(), expiring: List<usize>.make(), statement: true})
        walker.retention = Retention.None
        flow = run visit(nodes, locals, owner, &mut walker.*, list[index], flow.at)
        let ended = run releaseScopes(&mut walker.*, statement, nodes[list[index].index].origin.location, flow.at)
        List<Scope>.truncate(&mut walker.scopes, statement)
        flow.at = ended
        if index + usize.ONE < list.length && flow.at != usize.MAX {
          let point = run newPoint(&mut walker.*, flow.at)
          run consume(&mut walker.*, List<Carry>.asSlice(&flow.carried), point)
          flow = flowAt(point)
        }
        index = index + usize.ONE
      }
      walker.retention = retention
      let released = run releaseScopes(&mut walker.*, enclosing, span, flow.at)
      List<Scope>.truncate(&mut walker.scopes, enclosing)
      return Flow {at: released, carried: move flow.carried}
    }
  }
}

// A whole replacement observes displaced cleanup, then kills the earlier holder definitions
// and installs the new carried loans (ASSIGN-002). An access conflict is reported at the written
// `target`; a target the value moves out of is reported over the whole statement `span`.
effect fn replace(nodes: &[Node], locals: &[Local], owner: &DeclarationId, walker: &mut Walker, local: usize, value: NodeId, span: Location, target: Location,
  at: usize) -> Flow
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let since = List<Event>.length(&walker.events)
  let flow = run visit(nodes, locals, owner, &mut walker.*, value, at)
  let ty = localType(locals, local)
  let callable = Shared<Type>.with<bool>(&ty, callableValue)
  if callable && List<Carry>.length(&flow.carried) > usize.ZERO {
    // Replacing an exact callable environment needs its representation transfer proof. Do not
    // silently discard the new capture loans while retaining the old environment's bound.
    leave(&mut walker.*, BorrowStatus.StoredLoans)
    return flowAt(flow.at)
  }
  let mut retained = false
  if List<Carry>.length(&flow.carried) > usize.ZERO {
    retained = run retains(&ty, owner)
  }
  let path = Path {root: local, through: false, steps: List<Step>.make(), indexes: List<NodeId>.make(), refiner: usize.MAX, refinedDepth: usize.ZERO, binders: List<usize>.make()}
  let cleaned = run observeCleanup(&mut walker.*, local, false, span, flow.at)
  let point = run access(&mut walker.*, &path, Kind.Write, target, cleaned, usize.MAX)
  markConsumedTarget(&mut walker.*, since, point, span)
  run consume(&mut walker.*, List<Carry>.asSlice(&flow.carried), point)
  // A replaced `mut fn` keeps its capture loans until the local's last use, as bound.
  if !callable {
    let mut points = List<Point>.asMutSlice(&mut walker.points)
    points[point].defines = local
    if retained {
      cross(&mut walker.*, List<Carry>.asSlice(&flow.carried))
      run hold(&mut walker.*, local, List<Carry>.asSlice(&flow.carried), point, true)
    }
  }
  return flowAt(point)
}

// The extent and kind of a borrowing match's loan of its subject place (MATCH-001), pending the
// language decision. Spanning the arm holds the loan through every point of the selected arm, guard
// included, whether or not the arm binds; otherwise it ends at the arm's last binding use. Matching
// the access lends `&mut` exclusively; otherwise the owner may still be read beside an idle
// exclusive binding. These agree with the bootstrap's `armLoan`, which governs `match` alone. An
// `if let` lends through its whole taken body when it binds, and a destructuring `let` until its
// bindings' scope ends, each exclusively for `&mut` (PATT-009).
fn armLoanSpansArm() -> bool { return false }

fn armLoanMatchesAccess() -> bool { return false }

// A match (MATCH-001): the subject is accessed once as its form declares, then the arms are tried
// in written order. A pattern that does not select the value, or a guard that answers false, goes on
// to the next arm; every selected arm joins after the match. A borrowing match's bindings are
// projections of the subject place (MATCH-002): a slot of the match holds a loan of that place, which
// every use of a binding uses, so writing, moving or exclusively borrowing the place other than
// through a binding conflicts while a binding is still used. What the bindings retain is the region
// slice's to prove.
effect fn matchArms(nodes: &[Node], locals: &[Local], owner: &DeclarationId, walker: &mut Walker, subject: NodeId, access: Scrutinee,
  arms: &[ArmShape], syntax: MatchSyntax, result: NodeId, at: usize) -> Flow ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let span = nodes[subject.index].origin.location
  let mut flow = flowAt(at)
  // Whether the subject's carried loans are placed within its own value.
  let mut attributed = false
  let path = run pathOf(nodes, subject)
  // A borrowing destructuring `let` keeps its subject's temporaries for its bindings' scope.
  let retention = walker.retention
  if syntax == MatchSyntax.Let && (access == Scrutinee.Shared || access == Scrutinee.Exclusive || access == Scrutinee.Place) {
    walker.retention = Retention.Storage
  }
  if access == Scrutinee.Moved {
    if path.root == usize.MAX || path.through {
      leave(&mut walker.*, BorrowStatus.StoredLoans)
      return flowAt(at)
    }
    let moved = run place(nodes, locals, owner, &mut walker.*, &path, Kind.Move, span, at)
    // The subject is read whole, so no loan it holds is within a narrower read.
    let whole = DeclaredRead {known: false, regions: List<Shared<Lifetime>>.make()}
    flow = Flow {at: moved.at, carried: run attributeRead(nodes, owner, &mut walker.*, &path, List<Carry>.asSlice(&moved.carried), &whole)}
    attributed = true
  } else if (access == Scrutinee.Exclusive || access == Scrutinee.Place) && path.root != usize.MAX {
    let mut kind = Kind.Inspect
    if access == Scrutinee.Exclusive {
      kind = Kind.Update
    }
    flow = run place(nodes, locals, owner, &mut walker.*, &path, kind, span, at)
  } else if (access == Scrutinee.Shared || access == Scrutinee.Exclusive) && path.root == usize.MAX {
    // Projecting a reference value names no place; the reference carries the loans of the storage
    // the subject is, which its bindings view.
    let mut indexes = List<NodeId>.make()
    let reference = run viewedReference(nodes, subject, &mut indexes)
    flow = run visit(nodes, locals, owner, &mut walker.*, reference, at)
    let operands = List<NodeId>.asSlice(&indexes)
    let mut operand = usize.ZERO
    while operand < operands.length {
      let indexed = run visit(nodes, locals, owner, &mut walker.*, operands[operand], flow.at)
      run consume(&mut walker.*, List<Carry>.asSlice(&indexed.carried), indexed.at)
      flow.at = indexed.at
      operand = operand + usize.ONE
    }
  } else {
    flow = run visit(nodes, locals, owner, &mut walker.*, subject, at)
    attributed = true
  }
  walker.retention = retention
  let mut armLoan = usize.MAX
  // The loans a borrowed subject with no place carries, such as the argument loans a returned
  // reference keeps: its bindings view that storage, so they hold the loans as an arm loan.
  let mut viewed = List<usize>.make()
  if (access == Scrutinee.Shared || access == Scrutinee.Exclusive) && path.root == usize.MAX
    && List<Carry>.length(&flow.carried) > usize.ZERO {
    let lent = run newPoint(&mut walker.*, flow.at)
    run hold(&mut walker.*, bindingsRoot(nodes, subject.index), List<Carry>.asSlice(&flow.carried), lent, false)
    let carried = List<Carry>.asSlice(&flow.carried)
    let mut at = usize.ZERO
    while at < carried.length {
      run List<usize>.append(&mut viewed, carried[at].loan)
      at = at + usize.ONE
    }
    flow.at = lent
    if syntax == MatchSyntax.Let && arms.length > usize.ZERO && arms[usize.ZERO].binds {
      run List<usize>.append(&mut walker.lexicalHolders, bindingsRoot(nodes, subject.index))
      run registerRoot(&mut walker.*, bindingsRoot(nodes, subject.index))
    }
  }
  if (access == Scrutinee.Shared || access == Scrutinee.Exclusive) && path.root != usize.MAX {
    // An `if let` or destructuring `let` lends as its subject is borrowed (PATT-009).
    let exclusive = access == Scrutinee.Exclusive && (syntax != MatchSyntax.Match || armLoanMatchesAccess())
    let parent = run borrowedPlaceLifetime(nodes, subject)
    let loaned = run takeLoan(nodes, owner, &mut walker.*, &path, exclusive, span, usize.MAX, move parent, flow.at, List<Carry>.make())
    let mut loans = List<Loan>.asMutSlice(&mut walker.loans)
    armLoan = loans.length - usize.ONE
    loans[armLoan].binder = subject.index
    let lent = run newPoint(&mut walker.*, loaned.at)
    run hold(&mut walker.*, bindingsRoot(nodes, subject.index), List<Carry>.asSlice(&loaned.carried), lent, false)
    run consume(&mut walker.*, List<Carry>.asSlice(&loaned.carried), lent)
    flow.at = lent
    if syntax == MatchSyntax.Let && arms.length > usize.ZERO && arms[usize.ZERO].binds {
      // Its bindings belong to the enclosing block (PATT-008), which keeps the loan to its end.
      run List<usize>.append(&mut walker.lexicalHolders, bindingsRoot(nodes, subject.index))
      run registerRoot(&mut walker.*, bindingsRoot(nodes, subject.index))
    }
  }
  let tested = run newPoint(&mut walker.*, flow.at)
  if access == Scrutinee.Place && path.root != usize.MAX {
    run List<Refinement>.append(&mut walker.refinements, Refinement {subject: subject.index, test: tested})
  }
  if List<Carry>.length(&flow.carried) > usize.ZERO {
    // Bindings of a subject that carries a loan would hold it, where the subject's value holds it
    // when that value was moved or computed; loans an accessed place carries are its holder's.
    let retained = run nodeRetains(nodes, subject, owner)
    if retained {
      run hold(&mut walker.*, subjectRoot(subject), List<Carry>.asSlice(&flow.carried), tested, attributed)
    }
    run consume(&mut walker.*, List<Carry>.asSlice(&flow.carried), tested)
  }
  let enclosing = List<Scope>.length(&walker.scopes)
  // A destructuring let's bindings belong to its enclosing block (PATT-008), rather than the
  // synthetic arm used by typing. Match and if-let bindings end on their selected arm path.
  if syntax != MatchSyntax.Let {
    run List<Scope>.append(&mut walker.scopes, Scope {roots: List<usize>.make(), expiring: List<usize>.make(), statement: false})
  }
  run registerRoot(&mut walker.*, subjectRoot(subject))
  // The subject's own storage is bound here, so moves of its parts in an earlier iteration of an
  // enclosing loop do not reach this one.
  let mut points = List<Point>.asMutSlice(&mut walker.points)
  points[tested].initializes = subjectRoot(subject)
  let mut ends = List<usize>.make()
  // Whether some arm completes; when none does, nothing follows the match.
  let mut completes = false
  // The referent loans the selected arms' results carry to the join.
  let mut joining = List<Carry>.make()
  let mut rejected = List<usize>.make()
  run List<usize>.append(&mut rejected, tested)
  let mut index = usize.ZERO
  while index < arms.length {
    let entry = run newPoint(&mut walker.*, usize.MAX)
    let earlier = List<usize>.asSlice(&rejected)
    let mut from = usize.ZERO
    while from < earlier.length {
      run edge(&mut walker.*, earlier[from], entry)
      from = from + usize.ONE
    }
    List<usize>.truncate(&mut rejected, usize.ZERO)
    run List<usize>.append(&mut rejected, entry)
    let mut selected = entry
    if let Option<NodeId>.Some {value: guard} = &arms[index].guard {
      // A consuming match's bindings are parts of the subject's own storage until the guard holds.
      let consuming = access == Scrutinee.Moved || access == Scrutinee.Value
      if consuming { run List<usize>.append(&mut walker.guarded, subjectRoot(subject)) }
      let checked = run settled(nodes, locals, owner, &mut walker.*, guard, entry)
      if consuming { drop List<usize>.pop(&mut walker.guarded) }
      selected = run newPoint(&mut walker.*, checked.at)
      run consume(&mut walker.*, List<Carry>.asSlice(&checked.carried), selected)
      run List<usize>.append(&mut rejected, selected)
    }
    let taken = run visit(nodes, locals, owner, &mut walker.*, arms[index].result, selected)
    let released = run releaseScopes(&mut walker.*, enclosing, nodes[result.index].origin.location, taken.at)
    if released != usize.MAX { completes = true }
    let point = run newPoint(&mut walker.*, released)
    // An `if let` body that binds holds the loan throughout (PATT-009).
    let spans = (syntax == MatchSyntax.Match && armLoanSpansArm()) || (syntax == MatchSyntax.IfLet && arms[index].binds)
    if spans {
      // Every point of the arm, guard included, lies between its entry and its end.
      let mut loans = List<Loan>.asMutSlice(&mut walker.loans)
      if armLoan != usize.MAX {
        run List<Interval>.append(&mut loans[armLoan].intervals,
          Interval {from: entry, to: point, definition: usize.MAX, read: usize.MAX, cleanup: false})
      }
      let lent = List<usize>.asSlice(&viewed)
      let mut at = usize.ZERO
      while at < lent.length {
        run List<Interval>.append(&mut loans[lent[at]].intervals,
          Interval {from: entry, to: point, definition: usize.MAX, read: usize.MAX, cleanup: false})
        at = at + usize.ONE
      }
    }
    if List<Carry>.length(&taken.carried) > usize.ZERO {
      // A loan carried out of an arm is joined across the arms.
      let retained = run nodeRetains(nodes, result, owner)
      if retained {
        if taken.at != usize.MAX {
          cross(&mut walker.*, List<Carry>.asSlice(&taken.carried))
          run appendCarried(&mut joining, List<Carry>.asSlice(&taken.carried))
        }
      }
    }
    run consume(&mut walker.*, List<Carry>.asSlice(&taken.carried), point)
    run List<usize>.append(&mut ends, point)
    index = index + usize.ONE
  }
  let joined = run newPoint(&mut walker.*, usize.MAX)
  let selected = List<usize>.asSlice(&ends)
  index = usize.ZERO
  while index < selected.length {
    run edge(&mut walker.*, selected[index], joined)
    index = index + usize.ONE
  }
  let carried = List<Carry>.asSlice(&joining)
  let mut onward = List<Carry>.make()
  index = usize.ZERO
  while index < carried.length {
    run List<Carry>.append(&mut onward, Carry {loan: carried[index].loan, since: joined, operand: usize.MAX, definition: carried[index].definition, read: carried[index].read, field: carried[index].field, direct: carried[index].direct})
    index = index + usize.ONE
  }
  List<Scope>.truncate(&mut walker.scopes, enclosing)
  if !completes { return flowAt(usize.MAX) }
  return Flow {at: joined, carried: move onward}
}

// Visits an operand whose temporaries end with it, before control flow depends on its value: a
// condition, a guard or a short-circuit right operand (BORROW-006). Lowering never keeps them for a
// binding, so they never extend to an enclosing scope.
effect fn settled(nodes: &[Node], locals: &[Local], owner: &DeclarationId, walker: &mut Walker, id: NodeId, at: usize) -> Flow
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let scope = List<Scope>.length(&walker.scopes)
  run List<Scope>.append(&mut walker.scopes, Scope {roots: List<usize>.make(), expiring: List<usize>.make(), statement: true})
  let retention = walker.retention
  walker.retention = Retention.None
  let flow = run visit(nodes, locals, owner, &mut walker.*, id, at)
  walker.retention = retention
  let ended = run releaseScopes(&mut walker.*, scope, nodes[id.index].origin.location, flow.at)
  List<Scope>.truncate(&mut walker.scopes, scope)
  return Flow {at: ended, carried: move flow.carried}
}

// A field, index or dereference of a value that is not a written place: its operand is evaluated
// and consumed by the projection. A field selects the same carried source paths as a named holder
// read, including disjoint sibling fields. Whole-value or unknown paths remain conservative unless
// the field's declared type proves that the loan cannot reach it (`unreachableField`).
effect fn readValue(nodes: &[Node], locals: &[Local], owner: &DeclarationId, walker: &mut Walker, id: NodeId, at: usize) -> Flow
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut values = List<NodeId>.make()
  if let NodeKind.Expression {form, ..} = &nodes[id.index].kind {
    match &form {
      Expression.Field {value, ..} => {
        let subject = run visit(nodes, locals, owner, &mut walker.*, value, at)
        let declared = run declaredRead(nodes, id, owner)
        // Reuse the same field mapping as a named holder read. The synthetic temporary path
        // describes only this projection; no storage or lifetime extension is introduced.
        let path = run temporaryPath(nodes, id, value)
        let selected = run attributeRead(nodes, owner, &mut walker.*, &path, List<Carry>.asSlice(&subject.carried), &declared)
        let mut carried = List<Carry>.make()
        run appendOperand(&mut carried, List<Carry>.asSlice(&selected), usize.ZERO)
        // The extracted value forwards each selected source at its residual field path.
        // An empty prefix preserves that path across successive rvalue projections.
        let mut placed = List<List<Step>>.make()
        run List<List<Step>>.append(&mut placed, List<Step>.make())
        let untyped = List<NodeId>.make()
        let noSinks = List<OperandSink>.make()
        return run finish(nodes, owner, &mut walker.*, id, subject.at, &carried, false, Forwarding.Operands,
          List<List<Step>>.asSlice(&placed), List<NodeId>.asSlice(&untyped), List<OperandSink>.asSlice(&noSinks))
      }
      Expression.Dereference {value} => { run List<NodeId>.append(&mut values, value) }
      Expression.Index {value, index, ..} => {
        run List<NodeId>.append(&mut values, value)
        run List<NodeId>.append(&mut values, index)
      }
      _ => {}
    }
  }
  let unplaced = List<usize>.make()
  return run operands(nodes, locals, owner, &mut walker.*, List<NodeId>.asSlice(&values), List<usize>.asSlice(&unplaced), usize.MAX, id, at)
}

// The outermost loop still being walked, its condition included, or `usize.MAX` outside every
// loop. A loop's `end` is set once its body has been walked.
fn outermostOpenLoop(walker: &Walker) -> usize {
  let loops = List<Loop>.asSlice(&walker.loops)
  let mut at = usize.ZERO
  while at < loops.length {
    if loops[at].end == usize.ZERO { return at }
    at = at + usize.ONE
  }
  return usize.MAX
}

// Makes `local` hold the loans its initializer carries from point `at`.
// Records that `root` holds `carried` from `at`. An `attributed` hold keeps each loan's field path,
// relative to the root's value; any other forgets it, so no field read forwards the loan.
effect fn hold(walker: &mut Walker, root: usize, carried: &[Carry], at: usize, attributed: bool) -> () ! OutOfMemoryError ? &mut Allocator {
  let local = holderOf(&walker.*, root)
  let mut unseenCleanup = false
  if carried.length > usize.ZERO {
    let observed = List<LoopCleanup>.asSlice(&walker.loopCleanup)
    let loops = List<Loop>.asSlice(&walker.loops)
    let mut index = usize.ZERO
    while index < observed.length {
      if observed[index].holder == local && loops[observed[index].repeat].end == usize.ZERO { unseenCleanup = true }
      index = index + usize.ONE
    }
  }
  if unseenCleanup { leave(&mut walker.*, BorrowStatus.StoredLoans) }
  while List<List<usize>>.length(&walker.held) <= local {
    run List<List<usize>>.append(&mut walker.held, List<usize>.make())
  }
  let mut index = usize.ZERO
  while index < carried.length {
    let inherited = shadowedSource(&walker.*, carried[index].definition)
    let mut previous = usize.ZERO
    let mut seen = false
    while previous < index {
      if sameHoldingPosition(&walker.*, carried[previous], carried[index], attributed)
        && shadowedSource(&walker.*, carried[previous].definition) == inherited { seen = true }
      previous = previous + usize.ONE
    }
    if !seen {
      let definition = List<Holding>.length(&walker.definitions)
      let mut field = usize.MAX
      let mut direct = false
      if attributed {
        field = carried[index].field
        direct = carried[index].direct && field != usize.MAX
      }
      let sources = List<HoldingSource>.length(&walker.holdingSources)
      let mut unconditional = false
      let mut each = index
      while each < carried.length {
        if sameHoldingPosition(&walker.*, carried[each], carried[index], attributed)
          && shadowedSource(&walker.*, carried[each].definition) == inherited {
          if carried[each].definition == usize.MAX { unconditional = true }
          else {
            let recorded = List<HoldingSource>.asSlice(&walker.holdingSources)
            let mut source = sources
            let mut duplicate = false
            while source < recorded.length {
              if recorded[source].definition == carried[each].definition && recorded[source].read == carried[each].read { duplicate = true }
              source = source + usize.ONE
            }
            if !duplicate {
              run List<HoldingSource>.append(&mut walker.holdingSources, HoldingSource {definition: carried[each].definition, read: carried[each].read})
            }
          }
        }
        each = each + usize.ONE
      }
      let mut sourceCount = List<HoldingSource>.length(&walker.holdingSources) - sources
      if unconditional {
        List<HoldingSource>.truncate(&mut walker.holdingSources, sources)
        sourceCount = usize.ZERO
      }
      run List<Holding>.append(&mut walker.definitions, Holding {loan: carried[index].loan, holder: local, point: at,
        sources: sources, sourceCount: sourceCount, field: field, direct: direct, shadowed: false, inherited: inherited})
      let mut held = List<List<usize>>.asMutSlice(&mut walker.held)
      run List<usize>.append(&mut held[local], definition)
    }
    index = index + usize.ONE
  }
  let mut points = List<Point>.asMutSlice(&mut walker.points)
  points[at].defines = local
  return ()
}

// One destination position may receive the same loan from several conditional source definitions.
// Compact their predicates, never their truth: neither an obsolete nor an alternative source may
// replace the other. Inherited shadow values remain separate from ordinary value holdings.
fn sameHoldingPosition(walker: &Walker, left: Carry, right: Carry, attributed: bool) -> bool {
  if left.loan != right.loan { return false }
  if !attributed { return true }
  if (left.direct && left.field != usize.MAX) != (right.direct && right.field != usize.MAX) { return false }
  if left.field == right.field { return true }
  if left.field == usize.MAX || right.field == usize.MAX { return false }
  let paths = List<List<Step>>.asSlice(&walker.paths)
  let a = List<Step>.asSlice(&paths[left.field])
  let b = List<Step>.asSlice(&paths[right.field])
  return pathContains(a, b) && pathContains(b, a)
}

fn holdingSourceReaches(walker: &Walker, holding: Holding, definitions: &[u64], width: usize) -> bool {
  if holding.sourceCount == usize.ZERO { return true }
  let sources = List<HoldingSource>.asSlice(&walker.holdingSources)
  let mut at = holding.sources
  while at < holding.sources + holding.sourceCount {
    if width != usize.ZERO && reaches(definitions, width, sources[at].read, sources[at].definition) { return true }
    at = at + usize.ONE
  }
  return false
}

// Whether a carried loan was read from a shadowed place, or from a value that was.
fn shadowedSource(walker: &Walker, definition: usize) -> bool {
  if definition == usize.MAX { return false }
  let source = List<Holding>.asSlice(&walker.definitions)[definition]
  return source.shadowed || source.inherited
}

// Records that `root`, bound at `at`, still holds `carried` in a place that was overwritten there.
effect fn shadow(walker: &mut Walker, root: usize, carried: &[Carry], at: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  let local = holderOf(&walker.*, root)
  let mut index = usize.ZERO
  while index < carried.length {
    let definition = List<Holding>.length(&walker.definitions)
    let sources = List<HoldingSource>.length(&walker.holdingSources)
    let mut sourceCount = usize.ZERO
    if carried[index].definition != usize.MAX {
      run List<HoldingSource>.append(&mut walker.holdingSources, HoldingSource {definition: carried[index].definition, read: carried[index].read})
      sourceCount = usize.ONE
    }
    run List<Holding>.append(&mut walker.definitions, Holding {loan: carried[index].loan, holder: local, point: at,
      sources: sources, sourceCount: sourceCount, field: carried[index].field, direct: false, shadowed: true, inherited: false})
    let mut held = List<List<usize>>.asMutSlice(&mut walker.held)
    run List<usize>.append(&mut held[local], definition)
    index = index + usize.ONE
  }
  return ()
}

effect fn inFlight(walker: &Walker, loan: &Loan, point: usize, definitions: &[u64], width: usize) -> bool
! OutOfMemoryError ? &mut Allocator {
  let intervals = List<Interval>.asSlice(&loan.intervals)
  let mut at = usize.ZERO
  while at < intervals.length {
    let interval = intervals[at]
    if interval.from < point && point < interval.to
      && (interval.definition == usize.MAX || reaches(definitions, width, interval.read, interval.definition)) {
      if !interval.cleanup { return true }
      let before = run pathReaches(List<Point>.asSlice(&walker.points), interval.from, point)
      if before && run pathReaches(List<Point>.asSlice(&walker.points), point, interval.to) { return true }
    }
    at = at + usize.ONE
  }
  return false
}

fn wordOf(bit: usize) -> usize { return bit / 64 }

fn maskOf(bit: usize) -> u64 { return u64.shiftLeft(1, usize.toU64(bit % 64)) }

// Backward liveness of holdings: bit `d` of `out[p]` is set when holding `d`'s holder is read on
// some path after point `p`, before it is bound again. With `fields`, only a read that may reach
// where `d` holds its loan counts, so a read of one field leaves a loan held in another field dead,
// an overwrite of the place that held it does not read it, and a shadowed holding is never read. A
// storage end needs only the loans a
// later read reaches (OWN0019); an access conflicts with every loan its holder's later use keeps,
// as BORROW-008 retains the whole holder (OWN0010, OWN0011).
effect fn liveness(walker: &Walker, width: usize, fields: bool) -> List<u64> ! OutOfMemoryError ? &mut Allocator {
  let points = List<Point>.asSlice(&walker.points)
  let all = List<Holding>.asSlice(&walker.definitions)
  let held = List<List<usize>>.asSlice(&walker.held)
  let mut used = List<u64>.make()
  let mut bound = List<u64>.make()
  let mut at = usize.ZERO
  while at < points.length * width {
    run List<u64>.append(&mut used, 0)
    run List<u64>.append(&mut bound, 0)
    at = at + usize.ONE
  }
  let mut point = usize.ZERO
  while point < points.length {
    if points[point].defines < held.length {
      let holdings = List<usize>.asSlice(&held[points[point].defines])
      let mut index = usize.ZERO
      while index < holdings.length {
        let mut words = List<u64>.asMutSlice(&mut bound)
        let slot = point * width + wordOf(holdings[index])
        words[slot] = u64.bitOr(words[slot], maskOf(holdings[index]))
        index = index + usize.ONE
      }
    }
    if points[point].uses < held.length {
      let holdings = List<usize>.asSlice(&held[points[point].uses])
      let mut index = usize.ZERO
      while index < holdings.length {
        if !fields || (!all[holdings[index]].shadowed && pathsOverlap(walker, points[point].read, all[holdings[index]].field)
          && !overwrites(walker, points[point].written, all[holdings[index]].field)) {
          let mut words = List<u64>.asMutSlice(&mut used)
          let slot = point * width + wordOf(holdings[index])
          words[slot] = u64.bitOr(words[slot], maskOf(holdings[index]))
        }
        index = index + usize.ONE
      }
    }
    point = point + usize.ONE
  }
  return run solveLiveness(points, width, List<u64>.asSlice(&used), List<u64>.asSlice(&bound))
}

// The same backward solver serves eager holdings during migration and actual Flow definitions
// in the replacement projection. Its inputs describe uses and kills, never new reaching facts.
effect fn solveLiveness(points: &[Point], width: usize, used: &[u64], bound: &[u64]) -> List<u64>
! OutOfMemoryError ? &mut Allocator {
  if used.length != points.length * width || bound.length != used.length {
    return CompilerBug.panic(b"liveness tables do not cover the actual CFG")
  }
  let mut liveIn = List<u64>.make()
  let mut liveOut = List<u64>.make()
  let mut at = usize.ZERO
  while at < used.length {
    run List<u64>.append(&mut liveIn, 0)
    run List<u64>.append(&mut liveOut, 0)
    at = at + usize.ONE
  }
  let mut changed = true
  while changed {
    changed = false
    let mut point = points.length
    while point > usize.ZERO {
      point = point - usize.ONE
      let next = List<usize>.asSlice(&points[point].next)
      let mut word = usize.ZERO
      while word < width {
        let mut out = u64.MIN
        let mut successor = usize.ZERO
        while successor < next.length {
          out = u64.bitOr(out, List<u64>.asSlice(&liveIn)[next[successor] * width + word])
          successor = successor + usize.ONE
        }
        let slot = point * width + word
        let entry = u64.bitOr(u64.bitAnd(out, u64.bitNot(bound[slot])), used[slot])
        let mut outs = List<u64>.asMutSlice(&mut liveOut)
        outs[slot] = out
        if List<u64>.asSlice(&liveIn)[slot] != entry {
          let mut ins = List<u64>.asMutSlice(&mut liveIn)
          ins[slot] = entry
          changed = true
        }
        word = word + usize.ONE
      }
    }
  }
  return move liveOut
}

// Whether the exact path `written` contains where a holding holds its loan, so overwriting it
// discards the loan.
fn overwrites(walker: &Walker, written: usize, field: usize) -> bool {
  if written == usize.MAX || field == usize.MAX { return false }
  let paths = List<List<Step>>.asSlice(&walker.paths)
  return pathContains(List<Step>.asSlice(&paths[written]), List<Step>.asSlice(&paths[field]))
}

fn heldLive(walker: &Walker, loan: usize, liveOut: &[u64], definitions: &[u64], width: usize, point: usize) -> bool {
  let all = List<Holding>.asSlice(&walker.definitions)
  let points = List<Point>.asSlice(&walker.points)
  let mut at = usize.ZERO
  while at < all.length {
    // A point that binds the holder again ends its earlier definitions there: the holder's later
    // reads see the new value, and cleanup of the old one is observed before the binding.
    let rebound = point < points.length && points[point].defines == all[at].holder && all[at].point != point
    if all[at].loan == loan && !all[at].inherited && !rebound && reaches(definitions, width, point, at) && reaches(liveOut, width, point, at) { return true }
    at = at + usize.ONE
  }
  return false
}

// A holder has one definition per binding/replacement. A definition copied from a holder read
// exists only if its source reached that read; overwriting or consuming the holder kills its
// earlier definitions. This includes back edges, whose local bindings create new definitions.
effect fn reachingHoldings(walker: &Walker, width: usize) -> Reach
  ! OutOfMemoryError
  ? &mut Allocator {
  let points = List<Point>.asSlice(&walker.points)
  let all = List<Holding>.asSlice(&walker.definitions)
  let mut entering = List<u64>.make()
  let mut leaving = List<u64>.make()
  let mut at = usize.ZERO
  while at < points.length * width {
    run List<u64>.append(&mut entering, 0)
    run List<u64>.append(&mut leaving, 0)
    at = at + usize.ONE
  }
  let mut changed = true
  while changed {
    changed = false
    let mut point = usize.ZERO
    while point < points.length {
      let mut word = usize.ZERO
      while word < width {
        let mut outs = List<u64>.asMutSlice(&mut leaving)
        outs[point * width + word] = List<u64>.asSlice(&entering)[point * width + word]
        word = word + usize.ONE
      }
      let mut bit = usize.ZERO
      while bit < all.length {
        let slot = point * width + wordOf(bit)
        let mut outs = List<u64>.asMutSlice(&mut leaving)
        if points[point].defines == all[bit].holder {
          outs[slot] = u64.bitAnd(outs[slot], u64.bitNot(maskOf(bit)))
        }
        if all[bit].point == point
          && holdingSourceReaches(walker, all[bit], List<u64>.asSlice(&entering), width) {
          outs[slot] = u64.bitOr(outs[slot], maskOf(bit))
        }
        bit = bit + usize.ONE
      }
      let next = List<usize>.asSlice(&points[point].next)
      let mut successor = usize.ZERO
      while successor < next.length {
        word = usize.ZERO
        while word < width {
          let slot = next[successor] * width + word
          let current = List<u64>.asSlice(&entering)[slot]
          let merged = u64.bitOr(current, List<u64>.asSlice(&leaving)[point * width + word])
          if merged != current {
            let mut ins = List<u64>.asMutSlice(&mut entering)
            ins[slot] = merged
            changed = true
          }
          word = word + usize.ONE
        }
        successor = successor + usize.ONE
      }
      point = point + usize.ONE
    }
  }
  return Reach { entering: move entering, leaving: move leaving }
}

// Graph reachability, used at storage ends rather than treating sibling arms as one numeric
// interval. The ordinary conflict walk keeps its compact interval test.
effect fn pathReaches(points: &[Point], from: usize, to: usize) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  if from == usize.MAX || to == usize.MAX {
    return false
  }
  let mut seen = List<bool>.make()
  let mut at = usize.ZERO
  while at < points.length {
    run List<bool>.append(&mut seen, false)
    at = at + usize.ONE
  }
  let mut queue = List<usize>.make()
  run List<usize>.append(&mut queue, from)
  let mut visited = List<bool>.asMutSlice(&mut seen)
  visited[from] = true
  at = usize.ZERO
  while at < List<usize>.length(&queue) {
    let point = List<usize>.asSlice(&queue)[at]
    if point == to {
      return true
    }
    let next = List<usize>.asSlice(&points[point].next)
    let mut index = usize.ZERO
    while index < next.length {
      let mut visited = List<bool>.asMutSlice(&mut seen)
      if
        !visited[next[index]] {
        visited[next[index]] = true
        run List<usize>.append(&mut queue, next[index])
      }
      index = index + usize.ONE
    }
    at = at + usize.ONE
  }
  return false
}

effect fn flightEnds(
  walker: &Walker,
  loan: &Loan,
  point: usize,
  definitions: &[u64],
  width: usize
) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  let intervals = List<Interval>.asSlice(&loan.intervals)
  let mut at = usize.ZERO
  while at < intervals.length {
    let interval = intervals[at]
    if interval.to != point && interval.from < point && point < interval.to
      && (interval.definition == usize.MAX
      || reaches(definitions, width, interval.read, interval.definition)) {
      let arrived = run pathReaches(List<Point>.asSlice(&walker.points), interval.from, point)
      if arrived && run pathReaches(List<Point>.asSlice(&walker.points), point, interval.to) {
        return true
      }
    }
    at = at + usize.ONE
  }
  return false
}

// Report the first authentic required holder read beyond the storage end. A carried arm/return
// result instead reports its retention boundary, as LIFE-001 and BORROW-008 require. Points are
// numbered in creation order, so a read the end reaches only around a loop's back edge was created
// before it: the scan continues from the first point once the later ones are exhausted.
effect fn expiredUse(
  walker: &Walker,
  loan: usize,
  event: &Event,
  definitions: &[u64],
  definitionWidth: usize,
  localOnly: bool
) -> Location
  ! OutOfMemoryError
  ? &mut Allocator {
  let points = List<Point>.asSlice(&walker.points)
  let all = List<Holding>.asSlice(&walker.definitions)
  let mut step = usize.ONE
  while step < points.length {
    let point = (event.point + step) % points.length
    let mut at = usize.ZERO
    while at < all.length {
      if all[at].loan == loan && points[point].uses == all[at].holder && !all[at].shadowed && !all[at].inherited
        && (!localOnly || all[at].holder < walker.localCount)
        && pathsOverlap(walker, points[point].read, all[at].field)
        && !overwrites(walker, points[point].written, all[at].field)
        && reaches(definitions, definitionWidth, point, at)
        && run pathReaches(List<Point>.asSlice(&walker.points), event.point, point) {
        return points[point].span
      }
      at = at + usize.ONE
    }
    step = step + usize.ONE
  }
  return event.span
}

// A holding of `loan` a later read needs, whose value was read out of another holder after the
// storage end at `end`, on a path that neither borrows again nor binds that holder again: the holder
// still held the loan there, so the value carries storage that has ended (OWN0019). A shadowed
// holding's place is read no more by its holder's own reads, but a value read from the place still
// carries its loans.
effect fn staleHolding(walker: &Walker, loan: usize, end: usize, live: &[u64], definitions: &[u64], width: usize) -> usize ! OutOfMemoryError ? &mut Allocator {
  let all = List<Holding>.asSlice(&walker.definitions)
  let created = List<Loan>.asSlice(&walker.loans)[loan].created
  let mut at = usize.ZERO
  while at < all.length {
    if all[at].loan == loan && !all[at].shadowed && reaches(live, width, all[at].point, at) {
      let sources = List<HoldingSource>.asSlice(&walker.holdingSources)
      let mut source = all[at].sources
      while source < all[at].sources + all[at].sourceCount {
        if reaches(definitions, width, sources[source].read, sources[source].definition) {
          let points = List<Point>.asSlice(&walker.points)
          let holder = all[sources[source].definition].holder
          let mut rebound = List<bool>.make()
          let mut point = usize.ZERO
          while point < points.length {
            run List<bool>.append(&mut rebound, points[point].defines == holder)
            point = point + usize.ONE
          }
          if run readKeeping(points, end, sources[source].read, created, List<bool>.asSlice(&rebound)) { return at }
        }
        source = source + usize.ONE
      }
    }
    at = at + usize.ONE
  }
  return usize.MAX
}

// Whether `to` is reachable from `from` on a path through neither `created` nor a point that binds
// `holder` again.
effect fn readKeeping(points: &[Point], from: usize, to: usize, created: usize, rebound: &[bool]) -> bool ! OutOfMemoryError ? &mut Allocator {
  if from == usize.MAX || to == usize.MAX { return false }
  if rebound.length != points.length { return CompilerBug.panic(b"source-preserving path lost its actual rebinding points") }
  let mut seen = List<bool>.make()
  let mut at = usize.ZERO
  while at < points.length {
    run List<bool>.append(&mut seen, false)
    at = at + usize.ONE
  }
  let mut pending = List<usize>.make()
  run List<usize>.append(&mut pending, from)
  while List<usize>.length(&pending) > usize.ZERO {
    let last = List<usize>.length(&pending) - usize.ONE
    let point = List<usize>.remove(&mut pending, last)
    let next = List<usize>.asSlice(&points[point].next)
    let mut successor = usize.ZERO
    while successor < next.length {
      let target = next[successor]
      if target == to { return true }
      if !List<bool>.asSlice(&seen)[target] && target != created && !rebound[target] {
        let mut marked = List<bool>.asMutSlice(&mut seen)
        marked[target] = true
        run List<usize>.append(&mut pending, target)
      }
      successor = successor + usize.ONE
    }
  }
  return false
}

// Where `holding` retains its loan: the binding that retains it, as the bootstrap reports a value
// that retains expired storage; otherwise the first read of its holder that reaches the loan after
// it is bound, or `fallback`.
effect fn holdingUse(walker: &Walker, holding: usize, fallback: Location, definitions: &[u64], width: usize) -> Location
! OutOfMemoryError ? &mut Allocator {
  let points = List<Point>.asSlice(&walker.points)
  let held = List<Holding>.asSlice(&walker.definitions)[holding]
  let retained = points[held.point].span
  if retained.end > retained.start { return retained }
  let mut step = usize.ONE
  while step < points.length {
    let point = (held.point + step) % points.length
    if points[point].uses == held.holder && pathsOverlap(walker, points[point].read, held.field)
      && reaches(definitions, width, point, holding) && run pathReaches(List<Point>.asSlice(&walker.points), held.point, point) {
      return points[point].span
    }
    step = step + usize.ONE
  }
  return fallback
}

// Whether a write of `written` replaces all of `moved`: same root, and a prefix of its path that
// names no unknown element.
fn covers(written: &Place, moved: &Place) -> bool {
  if written.root != moved.root {
    return false
  }
  let first = List<Step>.asSlice(&written.steps)
  let second = List<Step>.asSlice(&moved.steps)
  if first.length > second.length {
    return false
  }
  let mut at = usize.ZERO
  while at < first.length {
    if first[at].kind == StepKind.AnyElement || !sameStep(first[at], second[at]) {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

fn isBackEdge(loops: &[Loop], from: usize, to: usize) -> bool {
  let mut at = usize.ZERO
  while at < loops.length {
    if loops[at].header == to {
      let sources = List<usize>.asSlice(&loops[at].sources)
      let mut index = usize.ZERO
      while index < sources.length {
        if sources[index] == from {
          return true
        }
        index = index + usize.ONE
      }
    }
    at = at + usize.ONE
  }
  return false
}

// Reaching moves along forward edges: bit `m` of `entering[p]` (and `leaving[p]`) is set when move
// event `moves[m]` reaches point `p` in the same loop iteration, on a path that neither rebinds nor
// replaces its place. Repetition is checked separately at each loop header.
struct Reach {
  entering: List<u64>
  leaving: List<u64>
}

effect fn moveInitializations(points: &[Point]) -> List<MoveInitialization> ! OutOfMemoryError ? &mut Allocator {
  let mut result = List<MoveInitialization>.make()
  let mut at = usize.ZERO
  while at < points.length {
    if points[at].initializes != usize.MAX {
      run List<MoveInitialization>.append(&mut result, MoveInitialization {point: at, root: points[at].initializes})
    }
    at = at + usize.ONE
  }
  return move result
}

fn moveInitialized(initialized: &[MoveInitialization], point: usize, root: usize) -> bool {
  let mut at = usize.ZERO
  while at < initialized.length {
    if initialized[at].point == point && initialized[at].root == root { return true }
    at = at + usize.ONE
  }
  return false
}

effect fn reaching(points: &[Point], initialized: &[MoveInitialization], events: &[Event], loops: &[Loop], moves: &[usize], width: usize) -> Reach
! OutOfMemoryError ? &mut Allocator {
  let rows = run sourceEventsAt(events, points.length)
  let mut entering = List<u64>.make()
  let mut leaving = List<u64>.make()
  let mut at = usize.ZERO
  while at < points.length * width {
    run List<u64>.append(&mut entering, 0)
    run List<u64>.append(&mut leaving, 0)
    at = at + usize.ONE
  }
  let mut changed = true
  while changed {
    changed = false
    let mut point = usize.ZERO
    while point < points.length {
      let mut word = usize.ZERO
      while word < width {
        let mut outs = List<u64>.asMutSlice(&mut leaving)
        outs[point * width + word] = List<u64>.asSlice(&entering)[point * width + word]
        word = word + usize.ONE
      }
      let recorded = List<usize>.asSlice(&List<List<usize>>.asSlice(&rows)[point])
      let mut bit = usize.ZERO
      while bit < moves.length {
        let moved = &events[moves[bit]].place
        let slot = point * width + wordOf(bit)
        let mut outs = List<u64>.asMutSlice(&mut leaving)
        if moveInitialized(initialized, point, moved.root) {
          outs[slot] = u64.bitAnd(outs[slot], u64.bitNot(maskOf(bit)))
        }
        // Preserve the order within an actual point. Multiple acquisition/access events
        // share its flow frontier; none may disappear behind a singleton Point.event.
        let mut each = usize.ZERO
        while each < recorded.length {
          let event = recorded[each]
          if events[event].kind == Kind.Write && covers(&events[event].place, moved) {
            outs[slot] = u64.bitAnd(outs[slot], u64.bitNot(maskOf(bit)))
          }
          if event == moves[bit] { outs[slot] = u64.bitOr(outs[slot], maskOf(bit)) }
          each = each + usize.ONE
        }
        bit = bit + usize.ONE
      }
      let next = List<usize>.asSlice(&points[point].next)
      let mut successor = usize.ZERO
      while successor < next.length {
        if !isBackEdge(loops, point, next[successor]) {
          word = usize.ZERO
          while word < width {
            let slot = next[successor] * width + word
            let current = List<u64>.asSlice(&entering)[slot]
            let merged = u64.bitOr(current, List<u64>.asSlice(&leaving)[point * width + word])
            if merged != current {
              let mut ins = List<u64>.asMutSlice(&mut entering)
              ins[slot] = merged
              changed = true
            }
            word = word + usize.ONE
          }
        }
        successor = successor + usize.ONE
      }
      point = point + usize.ONE
    }
  }
  return Reach {entering: move entering, leaving: move leaving}
}

// Whether `place` is moved in state `state` of point `point`: some reaching move names exactly it.
fn movedIn(events: &[Event], moves: &[usize], state: &[u64], width: usize, point: usize, place: &Place) -> bool {
  let mut bit = usize.ZERO
  while bit < moves.length {
    if reaches(state, width, point, bit) && samePlace(&events[moves[bit]].place, place) {
      return true
    }
    bit = bit + usize.ONE
  }
  return false
}

// A point may contain several ordered ownership events. Start with its incoming move
// state, then apply only the preceding events at that point; later writes cannot clear a
// move before this access, and an earlier move cannot disappear behind the shared point.
fn moveReachesEvent(events: &[Event], initialized: &[MoveInitialization], moves: &[usize], reach: &Reach,
  width: usize, bit: usize, at: usize) -> bool {
  let point = events[at].point
  let source = moves[bit]
  let place = &events[source].place
  let mut present = reaches(List<u64>.asSlice(&reach.entering), width, point, bit)
  if moveInitialized(initialized, point, place.root) { present = false }
  let mut before = usize.ZERO
  while before < at {
    if events[before].point == point {
      if events[before].kind == Kind.Write && covers(&events[before].place, place) { present = false }
      if before == source { present = true }
    }
    before = before + usize.ONE
  }
  return present
}

fn samePlace(left: &Place, right: &Place) -> bool {
  return left.root == right.root && overlap(left, right) == usize.ONE
    && List<Step>.length(&left.steps) == List<Step>.length(&right.steps)
}

// Whether `local` is bound inside the loop, so it has no owner state at the header.
fn boundInside(initialized: &[MoveInitialization], repeat: &Loop, local: usize) -> bool {
  let mut at = usize.ZERO
  while at < initialized.length {
    if initialized[at].root == local && initialized[at].point >= repeat.header && initialized[at].point < repeat.end {
      return true
    }
    at = at + usize.ONE
  }
  return false
}

// Whether a loop repeats with every `match place` refinement it uses intact: a write in the body
// to the subject of a match outside the loop invalidates a binding the next iteration uses (the
// bootstrap's `OWN0005` otherwise).
effect fn refinementRepeats(points: &[Point], refinements: &[Refinement], events: &[Event], repeat: &Loop, reaches: &mut List<ReplacementReach>) -> bool
! OutOfMemoryError ? &mut Allocator {
  let mut use = usize.ZERO
  while use < events.length {
    let used = &events[use]
    if used.refiner != usize.MAX && used.point >= repeat.header && used.point < repeat.end
      && used.kind != Kind.End && used.kind != Kind.Expire {
      let test = refinementTest(refinements, used.refiner)
      if test != usize.MAX && (test < repeat.header || test >= repeat.end) {
        let mut source = usize.ZERO
        while source < events.length {
          let written = &events[source]
          if written.point >= repeat.header && written.point < repeat.end
            && replaces(written.kind)
            && coversRefined(&written.place, &used.place, used.refinedDepth)
            && run reachesAvoiding(points, &mut reaches.*, written.point, used.point, test) {
            return false
          }
          source = source + usize.ONE
        }
      }
    }
    use = use + usize.ONE
  }
  return true
}

// Whether a loop repeats with the same moved places of its outer locals as it enters with
// (the bootstrap's `OWN0005` otherwise).
fn compatibleHeader(initialized: &[MoveInitialization], events: &[Event], moves: &[usize], reach: &Reach, width: usize, repeat: &Loop) -> bool {
  if repeat.before == usize.MAX {
    return true
  }
  let leaving = List<u64>.asSlice(&reach.leaving)
  let sources = List<usize>.asSlice(&repeat.sources)
  let mut bit = usize.ZERO
  while bit < moves.length {
    let place = &events[moves[bit]].place
    if !boundInside(initialized, repeat, place.root) {
      let entered = movedIn(events, moves, leaving, width, repeat.before, place)
      let mut index = usize.ZERO
      while index < sources.length {
        if movedIn(events, moves, leaving, width, sources[index], place) != entered {
          return false
        }
        index = index + usize.ONE
      }
    }
    bit = bit + usize.ONE
  }
  return true
}

fn reaches(entering: &[u64], width: usize, point: usize, bit: usize) -> bool {
  return u64.bitAnd(entering[point * width + wordOf(bit)], maskOf(bit)) != 0
}

/// Checks the loans of one typed body.
///
/// # Details
///
/// `owner` is the body's declaration, `locals` and `nodes` its typed locals and nodes, and `root`
/// its root node. `supplied` lists the Supplied atoms of the body's own selected application (see
/// `regionDomain`). Conflicts and uses of moved places are reported in evaluation order; the first
/// one is returned.
pub effect fn check(owner: &DeclarationId, supplied: &[Shared<Lifetime>], locals: &[Local], nodes: &[Node], root: NodeId, pending: bool,
  obligations: &[SafetyObligation], premises: &[RegionBound], cleanup: List<LoanCleanup>) -> Verdict
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let context = run retentionContext(owner, pending, obligations)
  let mut unrun = List<bool>.make()
  let mut declared = usize.ZERO
  while declared < locals.length {
    run List<bool>.append(&mut unrun, false)
    declared = declared + usize.ONE
  }
  let mut walker = Walker {
    callerRetentions: List<CallerRetention>.make(),
    unrun: move unrun,
    points: List<Point>.make(),
    loans: List<Loan>.make(),
    events: List<Event>.make(),
    frames: List<Frame>.make(),
    loops: List<Loop>.make(),
    held: List<List<usize>>.make(),
    definitions: List<Holding>.make(), holdingSources: List<HoldingSource>.make(),
    scopes: List<Scope>.make(),
    localCount: locals.length,
    cleanup: move cleanup,
    loopCleanup: List<LoopCleanup>.make(),
    exit: usize.ZERO,
    entry: usize.ZERO,
    outside: false,
    reason: BorrowStatus.Regions,
    guarded: List<usize>.make(),
    guardConsumed: Option<Location>.none(),
    retention: Retention.None, requirements: move context.requirements,
    settled: context.settled,
    retentionRelations: move context.relations, wholeHolds: List<WholeHold>.make(),
    openContents: move context.openContents,
    unretained: List<usize>.make(), contested: List<Shared<Lifetime>>.make(), storing: false, inherited: BorrowStatus.Checked, storable: List<usize>.make(),
    refinements: List<Refinement>.make(),
    lexicalHolders: List<usize>.make(),
    paths: List<List<Step>>.make(),
    stores: List<StoreWindow>.make(),
    returns: List<StoreWindow>.make(),
    sealed: List<Location>.make(),
    unheld: List<Location>.make(),
    escaping: List<usize>.make(),
    supplied: run copiedRegions(supplied),
  }
  run List<List<Step>>.append(&mut walker.paths, List<Step>.make())
  run List<Scope>.append(&mut walker.scopes, Scope {roots: List<usize>.make(), expiring: List<usize>.make(), statement: false})
  walker.exit = run newPoint(&mut walker, usize.MAX)
  let entry = run newPoint(&mut walker, usize.MAX)
  walker.entry = entry
  let mut initialized = entry
  let mut parameter = usize.ZERO
  while parameter < locals.length {
    let mut bound = false
    let mut node = usize.ZERO
    while node < nodes.length {
      match &nodes[node].kind {
        NodeKind.LocalBinding {local, ..} => { if local.index == parameter { bound = true } }
        NodeKind.MutableBinding {local, ..} => { if local.index == parameter { bound = true } }
        _ => {}
      }
      node = node + usize.ONE
    }
    if !bound {
      run registerRoot(&mut walker, parameter)
      // Parameters and capture aliases already own their storage on entry. Record that
      // initialization just like a binding, so a branch-local descriptor does not become
      // the lower bound of its owner's availability in the finite region proof.
      initialized = run newPoint(&mut walker, initialized)
      let mut points = List<Point>.asMutSlice(&mut walker.points)
      points[initialized].initializes = parameter
    }
    parameter = parameter + usize.ONE
  }
  let flow = run visit(nodes, locals, owner, &mut walker, root, initialized)
  // A guard may inspect its arm's bindings but not consume them: a later arm still receives the
  // unchanged payload when the guard is false (MATCH-002).
  if let Option<Location>.Some {value: consumed} = &walker.guardConsumed {
    return sourceGuardVerdict(consumed)
  }
  // A loan of storage this body owns cannot outlive the body, so a retained relation that requires
  // its region to outlive a universal region is refuted, reported at the borrow as the bootstrap
  // reports the unsatisfied region bound (SEM0212). The walk records every loan even where it leaves
  // the body unchecked, and this refutation reads only loans and relations, not their flow.
  let escape = run escapingOwnedLoan(&escapeSources(&walker), owner, obligations, false)
  let escaping = escape.loan
  if escaping != usize.MAX {
    let all = List<Loan>.asSlice(&walker.loans)
    return Verdict {outcome: Outcome.Conflict, status: BorrowStatus.Regions, code: RejectionCode.UnsatisfiedLifetimeBound,
      access: all[escaping].origin, earlier: Option<Location>.none(), reports: List<Report>.make()}
  }
  // A returned value is stored in the caller's result slot, so the same refutation holds for goals
  // admitted inside a `return`. It decides a body only where the walk itself finds no conflict: the
  // walk reports a loan of body storage a returned value holds where it escapes (OWN0019).
  let mut returnedEscape = usize.MAX
  if List<StoreWindow>.length(&walker.returns) > usize.ZERO {
    let escape = run escapingOwnedLoan(&escapeSources(&walker), owner, obligations, true)
    returnedEscape = escape.loan
  }
  if walker.outside {
    return refutedOr(&walker, returnedEscape, verdict(Outcome.NotChecked, walker.reason))
  }
  let released = run releaseScopes(&mut walker, usize.ZERO, nodes[root.index].origin.location, flow.at)
  if walker.outside { return refutedOr(&walker, returnedEscape, verdict(Outcome.NotChecked, walker.reason)) }
  if released != usize.MAX {
    // Body statements produce no implicit escaping value. Explicit returns consume their value
    // after scope release; this statement tail may coincide with the final End safely.
    cross(&mut walker, List<Carry>.asSlice(&flow.carried))
    run consume(&mut walker, List<Carry>.asSlice(&flow.carried), released)
  }
  let exit = walker.exit
  run edge(&mut walker, released, exit)
  let definitionWidth = (List<Holding>.length(&walker.definitions) + 63) / 64
  let mut definitions = Reach {entering: List<u64>.make(), leaving: List<u64>.make()}
  // Holdings a later read of their field needs, and holdings any later use of their holder keeps.
  let mut liveOut = List<u64>.make()
  let mut keptOut = List<u64>.make()
  if definitionWidth > usize.ZERO {
    definitions = run reachingHoldings(&walker, definitionWidth)
    liveOut = run liveness(&walker, definitionWidth, true)
    keptOut = run liveness(&walker, definitionWidth, false)
  }
  let callerSources = run callerHoldingSources(&walker, List<u64>.asSlice(&definitions.entering), definitionWidth)
  let independentEscapes = run retainCallerSources(&mut walker, List<CallerSource>.asSlice(&callerSources),
    List<u64>.asSlice(&definitions.entering), definitionWidth)
  let events = List<Event>.asSlice(&walker.events)
  let loans = List<Loan>.asSlice(&walker.loans)
  let mut moves = List<usize>.make()
  let mut at = usize.ZERO
  while at < events.length {
    if events[at].kind == Kind.Move || events[at].kind == Kind.Drop {
      run List<usize>.append(&mut moves, at)
    }
    at = at + usize.ONE
  }
  let moved = List<usize>.asSlice(&moves)
  let moveWidth = (moved.length + 63) / 64
  let initialized = run moveInitializations(List<Point>.asSlice(&walker.points))
  let mut reach = Reach {entering: List<u64>.make(), leaving: List<u64>.make()}
  if moveWidth > usize.ZERO {
    reach = run reaching(List<Point>.asSlice(&walker.points), List<MoveInitialization>.asSlice(&initialized),
      events, List<Loop>.asSlice(&walker.loops), moved, moveWidth)
  }
  let loops = List<Loop>.asSlice(&walker.loops)
  let mut replacementReaches = List<ReplacementReach>.make()
  let mut contested = List<Shared<Lifetime>>.make()
  let mut chains = List<UnretainedChain>.make()
  let unretained = List<usize>.asSlice(&walker.unretained)
  let mut dropped = usize.ZERO
  while dropped < unretained.length {
    run List<UnretainedChain>.append(&mut chains, run unretainedChain(&regionSources(&walker), owner, unretained[dropped]))
    dropped = dropped + usize.ONE
  }
  let mut checkedLoops = usize.ZERO
  let mut unknown = false
  // The conflicts found so far, in the order found. After the first, the walk goes on to report the
  // other accesses that conflict with a live loan and the storage they leave expired, as the
  // bootstrap's loan and lifetime analyses report every one; any other kind of conflict found later
  // ends the walk unreported.
  let mut reports = List<Report>.make()
  let mut stopped = false
  at = usize.ZERO
  while at <= events.length {
    // A loop header is checked in evaluation order, before the first access after it.
    while checkedLoops < loops.length && (at == events.length || loops[checkedLoops].header < events[at].point) {
      let repeats = run refinementRepeats(List<Point>.asSlice(&walker.points), List<Refinement>.asSlice(&walker.refinements),
        events, &loops[checkedLoops], &mut replacementReaches)
      if (moveWidth > usize.ZERO && !compatibleHeader(List<MoveInitialization>.asSlice(&initialized), events, moved, &reach, moveWidth, &loops[checkedLoops])) || !repeats {
        let span = loops[checkedLoops].span
        if List<Report>.length(&reports) == usize.ZERO {
          return Verdict {outcome: Outcome.Conflict, status: BorrowStatus.Regions, code: RejectionCode.IncompatibleLoopHeader, access: span, earlier: Option<Location>.none(), reports: List<Report>.make()}
        }
        stopped = true
        break
      }
      checkedLoops = checkedLoops + usize.ONE
    }
    if stopped || at == events.length {
      break
    }
    let event = &events[at]
    if event.consumesTarget == usize.ONE {
      if List<Report>.length(&reports) == usize.ZERO {
        return Verdict {outcome: Outcome.Conflict, status: BorrowStatus.Regions, code: RejectionCode.OverlappingAssignment, access: event.span,
          earlier: Option<Location>.none(), reports: List<Report>.make()}
      }
      break
    }
    if event.consumesTarget != usize.ZERO {
      unknown = true
    }
    let mut bit = usize.ZERO
    while event.kind != Kind.End && event.kind != Kind.Expire && bit < moved.length {
      let source = &events[moved[bit]]
      if reaches(List<u64>.asSlice(&reach.entering), moveWidth, event.point, bit) {
        let classification = movedAccess(event, source)
        if classification == MoveAccess.Conflict {
          if List<Report>.length(&reports) == usize.ZERO {
            return Verdict {outcome: Outcome.Conflict, status: BorrowStatus.Regions, code: RejectionCode.UseAfterMove, access: event.span,
              earlier: Option<Location>.some(source.span), reports: List<Report>.make()}
          }
          stopped = true
          break
        }
        if classification == MoveAccess.Unknown { unknown = true }
      }
      bit = bit + usize.ONE
    }
    if stopped {
      break
    }
    // A `match place` binding names the payload its match selected. Once the subject place is
    // replaced, the binding no longer denotes a place of it, as the bootstrap reports (OWN0002).
    if event.refiner != usize.MAX && event.kind != Kind.End && event.kind != Kind.Expire {
      let test = refinementTest(List<Refinement>.asSlice(&walker.refinements), event.refiner)
      let mut source = usize.ZERO
      while test != usize.MAX && source < events.length {
        let written = &events[source]
        if replaces(written.kind)
          && coversRefined(&written.place, &event.place, event.refinedDepth)
          && run reachesAvoiding(List<Point>.asSlice(&walker.points), &mut replacementReaches, written.point, event.point, test) {
          // The same write also meets the subject's loans, which the bootstrap reports beside it.
          if List<Report>.length(&reports) == usize.ZERO {
            run List<Report>.append(&mut reports, Report {code: RejectionCode.ExtractionBoundary, access: event.span,
              related: true, earlier: written.span})
          }
          break
        }
        source = source + usize.ONE
      }
    }
    let mut index = usize.ZERO
    while index < loans.length {
      // A loan kept only by a typing relation the return-slot refutation decides is reported there
      // (SEM0212), at its borrow, rather than where the walk finds it.
      let deferred = loans[index].bound && returnedEscape != usize.MAX
      if (event.kind == Kind.End || event.kind == Kind.Expire) && loans[index].local && !deferred && covers(&event.place, &loans[index].place) {
        let carried = run flightEnds(&walker, &loans[index], event.point, List<u64>.asSlice(&definitions.entering), definitionWidth)
        let mut held = definitionWidth > usize.ZERO
          && heldLive(&walker, index, List<u64>.asSlice(&liveOut), List<u64>.asSlice(&definitions.entering), definitionWidth, event.point)
        if !held && List<bool>.asSlice(&independentEscapes)[index] {
          held = run reachesAvoiding(List<Point>.asSlice(&walker.points), &mut replacementReaches, loans[index].created, event.point, usize.MAX)
        }
        let caller = run callerRetentionAt(&walker, index, event.point, List<CallerSource>.asSlice(&callerSources),
          List<u64>.asSlice(&definitions.entering), definitionWidth, &mut replacementReaches)
        if caller == CallerSource.Actual { held = true }
        if !held && loans[index].until != usize.MAX {
          held = run liveUntil(List<Point>.asSlice(&walker.points), &mut replacementReaches, &loans[index], event.point)
        }
        let mut stale = usize.MAX
        if !carried && !held && definitionWidth > usize.ZERO {
          stale = run staleHolding(&walker, index, event.point, List<u64>.asSlice(&liveOut), List<u64>.asSlice(&definitions.entering), definitionWidth)
        }
        if !carried && !held && stale == usize.MAX && caller == CallerSource.Unknown { unknown = true }
        if carried || held || stale != usize.MAX {
          if loans[index].precision == LoanPrecision.Alternatives || loans[index].precision == LoanPrecision.Unknown { unknown = true } else {
            // A temporary's view carried past its owner is reported where it is first used after
            // that, as the bootstrap reports a statement temporary, unless nothing uses it again.
            let mut required = event.span
            if stale != usize.MAX {
              required = run holdingUse(&walker, stale, event.span, List<u64>.asSlice(&definitions.entering), definitionWidth)
            } else if !carried || temporary(nodes, loans[index].place.root) {
              required = run expiredUse(&walker, index, event, List<u64>.asSlice(&definitions.entering), definitionWidth, false)
            }
            run addReport(&mut reports, Report {code: expiredCode(), access: required, related: true, earlier: loans[index].origin})
          }
        }
      } else if index != event.loan && !deferred && !lentTo(&loans[index], &event.binders) {
        let code = conflictCode(event.kind, loans[index].exclusive)
        if let Option<RejectionCode>.Some {value} = move code {
          let selected = loanAccessOverlap(locals, &loans[index], event)
          let shared = selected.overlap
          if shared != usize.ZERO {
            let mut live = run inFlight(&walker, &loans[index], event.point, List<u64>.asSlice(&definitions.entering), definitionWidth)
            if !live && definitionWidth > usize.ZERO {
              live = heldLive(&walker, index, List<u64>.asSlice(&keptOut), List<u64>.asSlice(&definitions.entering), definitionWidth, event.point)
            }
            // Written/capture/opaque escape reasons retain their original global constraint.
            // A new concrete caller retention instead starts at the operation that retains it;
            // a sibling or returned arm cannot extend it onto an unrelated access path.
            if !live && List<bool>.asSlice(&independentEscapes)[index] {
              live = run reachesAvoiding(List<Point>.asSlice(&walker.points), &mut replacementReaches, loans[index].created, event.point, usize.MAX)
            }
            let caller = run callerRetentionAt(&walker, index, event.point, List<CallerSource>.asSlice(&callerSources),
              List<u64>.asSlice(&definitions.entering), definitionWidth, &mut replacementReaches)
            if caller == CallerSource.Actual { live = true }
            // An unrun `effect` block's own capture is live from where it is taken to the block's
            // scope end.
            if !live && loans[index].until != usize.MAX {
              live = run liveUntil(List<Point>.asSlice(&walker.points), &mut replacementReaches, &loans[index], event.point)
            }
            // A loan a dropped loan's proof grounds on is used, through the dropped loan, wherever
            // that loan's creation reaches.
            let grounding = List<UnretainedChain>.asSlice(&chains)
            let mut chain = usize.ZERO
            while !live && chain < grounding.length {
              if listsIndex(List<usize>.asSlice(&grounding[chain].loans), index)
                && run reachesAvoiding(List<Point>.asSlice(&walker.points), &mut replacementReaches, loans[grounding[chain].dropped].created, event.point, usize.MAX) {
                run appendAllAtoms(&mut contested, List<Shared<Lifetime>>.asSlice(&grounding[chain].regions))
              }
              chain = chain + usize.ONE
            }
            if !live && caller == CallerSource.Unknown { unknown = true }
            if live {
              // An approximate loan's conflict is not a proof either way: the body answers
              // `imprecise`, which is unchecked, never `Checked`.
              if preciseLoanConflict(&loans[index], selected, caller) {
                run addReport(&mut reports, Report {code: value, access: event.target, related: true, earlier: loans[index].origin})
                // A write, move or drop of body storage leaves a view its borrow made expired, which
                // the view's next use reports (OWN0019), as the bootstrap's lifetime analysis
                // invalidates a borrow's origin. A match binding's loan is not such an origin.
                if (event.kind == Kind.Write || event.kind == Kind.Move || event.kind == Kind.Drop)
                  && loans[index].local && loans[index].binder == usize.MAX {
                  // Only a local that holds the view reads it again; a match's bindings view their
                  // subject's place, which the access itself reports.
                  let use = run expiredUse(&walker, index, event, List<u64>.asSlice(&definitions.entering), definitionWidth, true)
                  if use.start != event.span.start || use.end != event.span.end {
                    run addReport(&mut reports, Report {code: expiredCode(), access: use, related: true, earlier: loans[index].origin})
                  }
                }
                break
              }
              unknown = true
            }
          }
        }
      }
      index = index + usize.ONE
    }
    at = at + usize.ONE
  }
  if List<Report>.length(&reports) > usize.ZERO {
    let first = List<Report>.asSlice(&reports)[usize.ZERO]
    let mut listed = List<Report>.make()
    if List<Report>.length(&reports) > usize.ONE { listed = run bySpan(List<Report>.asSlice(&reports)) }
    let mut earlier = Option<Location>.none()
    if first.related { earlier = Option<Location>.some(first.earlier) }
    return Verdict {outcome: Outcome.Conflict, status: BorrowStatus.Regions, code: first.code, access: first.access, earlier: move earlier,
      reports: move listed}
  }
  if walker.storing {
    return refutedOr(&walker, returnedEscape, verdict(Outcome.NotChecked, BorrowStatus.StoredLoans))
  }
  if unknown {
    return refutedOr(&walker, returnedEscape, verdict(Outcome.NotChecked, BorrowStatus.Imprecise))
  }
  if walker.inherited != BorrowStatus.Checked {
    return refutedOr(&walker, returnedEscape, verdict(Outcome.NotChecked, walker.inherited))
  }
  walker.contested = move contested
  let mut symbolic = List<SymbolicRegion>.make()
  let crossingsProved = run crossedRegionsProved(&regionSources(&walker), owner, premises, &mut symbolic)
  let mut relationsProved = !pending && crossingsProved
  if !relationsProved {
    relationsProved = run localRelationsProved(&walker, owner, obligations, premises, &mut symbolic,
      List<u64>.asSlice(&liveOut), List<u64>.asSlice(&definitions.entering), definitionWidth, !crossingsProved)
  }
  if relationsProved && run regionClosed(owner, supplied, locals, nodes) {
    return refutedOr(&walker, returnedEscape, verdict(Outcome.Clear, BorrowStatus.Checked))
  }
  return refutedOr(&walker, returnedEscape, verdict(Outcome.Clear, BorrowStatus.Regions))
}

// A caller retains the value read into its operand, not its holder's historical type. Shadow
// definitions remain in the region proof, but cannot supply that value. A copied alias follows
// each paired source/read; a read before replacement therefore survives replacement of its source.
// Holdings only refer to previously recorded definitions. Unknown or unavailable provenance stays
// Unknown rather than becoming evidence that the loan is absent.
effect fn callerHoldingSources(walker: &Walker, definitions: &[u64], width: usize) -> List<CallerSource>
! OutOfMemoryError ? &mut Allocator {
  let holdings = List<Holding>.asSlice(&walker.definitions)
  let sources = List<HoldingSource>.asSlice(&walker.holdingSources)
  let mut states = List<CallerSource>.make()
  if List<CallerRetention>.length(&walker.callerRetentions) == usize.ZERO { return move states }
  let mut at = usize.ZERO
  while at < holdings.length {
    let holding = holdings[at]
    let mut state = CallerSource.Unknown
    if holding.field != usize.MAX {
      if holding.shadowed { state = CallerSource.Absent }
      else if holding.sourceCount == usize.ZERO { state = CallerSource.Actual }
      else if holding.sources <= sources.length && holding.sourceCount <= sources.length - holding.sources {
        state = CallerSource.Absent
        let mut each = holding.sources
        while each < holding.sources + holding.sourceCount {
          let source = sources[each]
          let selected = callerSource(walker, List<CallerSource>.asSlice(&states), definitions, width, source.definition, source.read)
          if selected == CallerSource.Actual { state = CallerSource.Actual }
          else if selected == CallerSource.Unknown && state != CallerSource.Actual { state = CallerSource.Unknown }
          each = each + usize.ONE
        }
      }
    }
    run List<CallerSource>.append(&mut states, state)
    at = at + usize.ONE
  }
  return move states
}

fn callerSource(walker: &Walker, sources: &[CallerSource], definitions: &[u64], width: usize,
  definition: usize, read: usize) -> CallerSource {
  // Only a fresh borrow introduces this unconditional pair; every copy/transform preserves it
  // or replaces it with a recorded Holding/read pair.
  if definition == usize.MAX && read == usize.MAX { return CallerSource.Actual }
  if definition >= sources.length || width == usize.ZERO || read >= List<Point>.length(&walker.points) {
    return CallerSource.Unknown
  }
  if !reaches(definitions, width, read, definition) { return CallerSource.Absent }
  return sources[definition]
}

// Preserve independent escape reasons separately from location-qualified caller retention.
// The aggregate flag remains conservative for region availability/release proofs. Event conflicts
// use the returned independent reasons or callerRetentionAt, never that aggregate flag alone.
// No later overwrite can cancel a call that already retained a real source.
effect fn retainCallerSources(walker: &mut Walker, sources: &[CallerSource], definitions: &[u64], width: usize) -> List<bool>
! OutOfMemoryError ? &mut Allocator {
  let mut independent = List<bool>.make()
  let original = List<Loan>.asSlice(&walker.loans)
  let mut at = usize.ZERO
  while at < original.length {
    run List<bool>.append(&mut independent, original[at].escapes)
    at = at + usize.ONE
  }
  let retained = List<CallerRetention>.asSlice(&walker.callerRetentions)
  at = usize.ZERO
  while at < retained.length {
    let source = &retained[at]
    if callerSource(&walker.*, sources, definitions, width, source.definition, source.read) != CallerSource.Absent {
      let mut loans = List<Loan>.asMutSlice(&mut walker.loans)
      loans[source.loan].escapes = true
    }
    at = at + usize.ONE
  }
  return move independent
}

// Both Exact and Stored caller-retained conflicts need the operation to reach the access. The
// source definition is authenticated at the operand read: Move may consume it before the call.
// Unknown source evidence can require an unchecked result, never a concrete conflict by itself.
effect fn callerRetentionAt(walker: &Walker, loan: usize, point: usize, sources: &[CallerSource], definitions: &[u64], width: usize,
  replacements: &mut List<ReplacementReach>) -> CallerSource ! OutOfMemoryError ? &mut Allocator {
  let retained = List<CallerRetention>.asSlice(&walker.callerRetentions)
  let mut result = CallerSource.Absent
  let mut at = usize.ZERO
  while at < retained.length {
    let source = &retained[at]
    if source.loan == loan && run reachesAvoiding(List<Point>.asSlice(&walker.points), &mut replacements.*, source.point, point, usize.MAX) {
      let selected = callerSource(walker, sources, definitions, width, source.definition, source.read)
      if selected == CallerSource.Actual { return CallerSource.Actual }
      if selected == CallerSource.Unknown { result = CallerSource.Unknown }
    }
    at = at + usize.ONE
  }
  return result
}

// The SEM0212 refutation of the loan at `escaping` (`escapingOwnedLoan`), or `otherwise` when
// `escaping` is `usize.MAX`.
fn refutedOr(walker: &Walker, escaping: usize, otherwise: Verdict) -> Verdict {
  if escaping == usize.MAX { return move otherwise }
  let all = List<Loan>.asSlice(&walker.loans)
  return Verdict {outcome: Outcome.Conflict, status: BorrowStatus.Regions, code: RejectionCode.UnsatisfiedLifetimeBound,
    access: all[escaping].origin, earlier: Option<Location>.none(), reports: List<Report>.make()}
}

// R3 uses the Walker's points and edges. Required sets over-approximate its exact loan flow;
// available sets under-approximate storage validity. A successful inclusion is a proof. A failed
// inclusion in this conservative slice stays pending: the exact End/access walk above owns
// OWN0019/conflict diagnostics. Unknown mappings cannot upgrade a body; a complete union of
// possible loans can prove safety only when every possible source satisfies the proof.
// `required` holds the region's own requirement and every point propagated into it; `incoming` only
// the points propagated from other regions. A local region's own requirement was checked loan by
// loan against that loan's validity; propagated points must lie where every loan of the region is
// valid.
// Immutable source/provenance inputs to the accepted universal and parent predicates.
// The source consumer supplies its projected loans and policy effects directly; no Walker or
// historical Holding identity is required by these proofs.
struct RegionSources<'proof> {
  loans: &'proof [Loan]
  // None belongs only to the eager walk, which omits unexecuted acquisitions. The source
  // projection supplies one immutable truth per reserved loan, retaining every original ID.
  activity: Option<&'proof [SourceTruth]>
  supplied: &'proof [Shared<Lifetime>]
  contested: &'proof [Shared<Lifetime>]
  openContents: &'proof [Shared<Lifetime>]
  retentionRelations: &'proof [ImpliedGroup]
}

fn regionSources<'proof>(walker: &'proof Walker) -> RegionSources<'proof> {
  return RegionSources {loans: List<Loan>.asSlice(&walker.loans), activity: Option<&[SourceTruth]>.none(), supplied: List<Shared<Lifetime>>.asSlice(&walker.supplied),
    contested: List<Shared<Lifetime>>.asSlice(&walker.contested), openContents: List<Shared<Lifetime>>.asSlice(&walker.openContents),
    retentionRelations: List<ImpliedGroup>.asSlice(&walker.retentionRelations)}
}

fn sourceRegionSources<'proof>(settled: &'proof SourceSettledLoans, supplied: &'proof [Shared<Lifetime>],
  contested: &'proof [Shared<Lifetime>], openContents: &'proof [Shared<Lifetime>],
  retentionRelations: &'proof [ImpliedGroup]) -> RegionSources<'proof> {
  return RegionSources {loans: List<Loan>.asSlice(&settled.loans),
    activity: Option<&[SourceTruth]>.some(List<SourceTruth>.asSlice(&settled.activity)),
    supplied: supplied, contested: contested, openContents: openContents, retentionRelations: retentionRelations}
}

fn regionLoanActivity<'proof>(sources: &RegionSources<'proof>, index: usize) -> SourceTruth {
  if index >= sources.loans.length { return CompilerBug.panic(b"region provenance names a foreign loan") }
  if let Option<&[SourceTruth]>.Some {value} = sources.activity {
    if value.length != sources.loans.length { return CompilerBug.panic(b"region activity lost reserved loan identities") }
    return value[index]
  }
  return SourceTruth.True
}

// Reach at the acquisition itself is authoritative. An implicit input borrow remains active
// even when a later argument prevents the operation from publishing its descriptor/result.
effect fn sourceAcquisitionActivity<'body>(graph: &SourceGraph.Graph<'body>, loans: &[Loan])
  -> List<SourceTruth> ! OutOfMemoryError ? &mut Allocator {
  let points = List<SourceControl.Point>.asSlice(&SourceGraph.Graph.control(graph).points)
  let mut result = List<SourceTruth>.make()
  let mut at = usize.ZERO
  while at < loans.length {
    let point = loans[at].created
    if point >= points.length { return CompilerBug.panic(b"reserved loan has no actual acquisition point") }
    run List<SourceTruth>.append(&mut result, SourceGraph.Graph.truth(graph, points[point].reachable))
    at = at + usize.ONE
  }
  return move result
}

struct RegionPoints {
  region: Shared<Lifetime>
  required: List<u64>
  incoming: List<u64>
  available: List<u64>
}

struct RegionEdge {
  shorter: usize
  longer: usize
}

impl Copy for RegionEdge {}

enum RegionDomain { Universal, Local, Unknown }

fn suppliedAtom(region: &Shared<Lifetime>) -> bool {
  return Shared<Lifetime>.with<bool>(region, fn(atom: &Lifetime) -> bool {
    return match &atom.* { Lifetime.Supplied {..} => true _ => false }
  })
}

// Whether `region` is a borrow region of `owner`'s body.
fn regionLocal(region: &Shared<Lifetime>, owner: &DeclarationId) -> bool {
  return Shared<Lifetime>.with<bool>(region, fn(atom: &Lifetime) -> bool {
    if let Lifetime.Local {declaration, ..} = &atom.* { return DeclarationId.equals(&declaration, owner) }
    return false
  })
}

effect fn copiedRegions(regions: &[Shared<Lifetime>]) -> List<Shared<Lifetime>> ! OutOfMemoryError ? &mut Allocator {
  let mut copied = List<Shared<Lifetime>>.make()
  let mut at = usize.ZERO
  while at < regions.length {
    run List<Shared<Lifetime>>.append(&mut copied, Shared<Lifetime>.clone(&regions[at]))
    at = at + usize.ONE
  }
  return move copied
}

// A Supplied atom is universal only when it is one of the body's own application regions: it then
// names a caller region valid for the whole invocation, as the parameter it binds does. Supplied
// atoms carry no owner, so one from any other numbering stays unknown; the caller passes none
// when the body may hold such an atom.
fn regionDomain(region: &Shared<Lifetime>, owner: &DeclarationId, supplied: &[Shared<Lifetime>]) -> RegionDomain {
  if suppliedAtom(region) {
    if proofContains(supplied, region) { return RegionDomain.Universal }
    return RegionDomain.Unknown
  }
  return Shared<Lifetime>.with<RegionDomain>(region, fn(atom: &Lifetime) -> RegionDomain {
    return match &atom.* {
      Lifetime.Static => RegionDomain.Universal
      Lifetime.Parameter {declaration, ..} => {
        let kind = DeclarationId.kind(&declaration)
        if DeclarationId.equals(&declaration, owner)
          || (DeclarationId.isPrefixOf(&declaration, owner) && kind != OwnerKind.Anonymous && kind != OwnerKind.EffectBlock) {
          return RegionDomain.Universal
        }
        return RegionDomain.Unknown
      }
      Lifetime.Local {declaration, ..} => {
        if DeclarationId.equals(&declaration, owner) { return RegionDomain.Local }
        return RegionDomain.Unknown
      }
      _ => RegionDomain.Unknown
    }
  })
}

// The enclosing Walker bounds construction, retention and escape of the capture. This witness
// covers only finite uses in the direct nested invocation; it is never a universal premise.
fn capturedFiniteSource(region: &Shared<Lifetime>, owner: &DeclarationId) -> bool {
  let kind = DeclarationId.kind(owner)
  if kind != OwnerKind.Anonymous && kind != OwnerKind.EffectBlock { return false }
  return Shared<Lifetime>.with<bool>(region, fn(atom: &Lifetime) -> bool {
    if let Lifetime.Local {declaration, ..} = &atom.* {
      return DeclarationId.kind(&declaration) == OwnerKind.Function
        && DeclarationId.ownerCount(&declaration) + usize.ONE == DeclarationId.ownerCount(owner)
        && DeclarationId.isPrefixOf(&declaration, owner)
    }
    return false
  })
}

// Cache completed provenance proofs by their target. Cyclic graphs are grounded separately;
// a currently visited node is never installed here as an assumed proof or a failed result.
struct SymbolicRegion {
  offered: Shared<Lifetime>
  wanted: Shared<Lifetime>
  proved: bool
}

effect fn appendNewAtoms(target: &mut List<Shared<Lifetime>>, region: &Shared<Lifetime>) -> () ! OutOfMemoryError ? &mut Allocator {
  let count = Lifetime.atomCount(region)
  let mut at = usize.ZERO
  while at < count {
    let atom = Lifetime.atomAt(region, at)
    if !proofContains(List<Shared<Lifetime>>.asSlice(&target.*), &atom) {
      run List<Shared<Lifetime>>.append(&mut target.*, move atom)
    }
    at = at + usize.ONE
  }
  return ()
}

// Walks a dropped loan's provenance as symbolicParentsProved does: from its own regions through
// every loan naming a non-universal walked region to that loan's parent, and through every source
// a retention relation lets into a walked region.
effect fn unretainedChain<'proof>(sources: &RegionSources<'proof>, owner: &DeclarationId, dropped: usize) -> UnretainedChain
! OutOfMemoryError ? &mut Allocator {
  let loans = sources.loans
  let relations = sources.retentionRelations
  let active = regionLoanActivity(sources, dropped)
  let mut chain = UnretainedChain {dropped: dropped, loans: List<usize>.make(), regions: List<Shared<Lifetime>>.make(),
    unresolved: active == SourceTruth.Undefined}
  if active != SourceTruth.True { return move chain }
  run List<usize>.append(&mut chain.loans, dropped)
  let named = List<Shared<Lifetime>>.asSlice(&loans[dropped].regions)
  let mut at = usize.ZERO
  while at < named.length {
    run appendNewAtoms(&mut chain.regions, &named[at])
    at = at + usize.ONE
  }
  let mut next = usize.ZERO
  while next < List<Shared<Lifetime>>.length(&chain.regions) {
    let walked = List<Shared<Lifetime>>.asSlice(&chain.regions)
    let region = Shared<Lifetime>.clone(&walked[next])
    if regionDomain(&region, owner, sources.supplied) != RegionDomain.Universal {
      at = usize.ZERO
      while at < loans.length {
        if proofContains(List<Shared<Lifetime>>.asSlice(&loans[at].regions), &region) {
          let activity = regionLoanActivity(sources, at)
          if activity != SourceTruth.True {
            if activity == SourceTruth.Undefined { chain.unresolved = true }
            at = at + usize.ONE
            continue
          }
          if !listsIndex(List<usize>.asSlice(&chain.loans), at) { run List<usize>.append(&mut chain.loans, at) }
          if let Option<Shared<Lifetime>>.Some {value: parent} = &loans[at].parent { run appendNewAtoms(&mut chain.regions, &parent) }
        }
        at = at + usize.ONE
      }
      at = usize.ZERO
      while at < relations.length {
        if proofContains(List<Shared<Lifetime>>.asSlice(&relations[at].container), &region) {
          let members = List<Shared<Lifetime>>.asSlice(&relations[at].members)
          let mut member = usize.ZERO
          while member < members.length {
            run appendNewAtoms(&mut chain.regions, &members[member])
            member = member + usize.ONE
          }
        }
        at = at + usize.ONE
      }
    }
    next = next + usize.ONE
  }
  return move chain
}

// Called only after the event geometry conflicts and no ordinary live source was found.
// This records the same contested regions as the eager classifier; it never manufactures
// liveness or reports a conflict merely because a dropped proof names the loan's region.
effect fn sourceContestedAt<'body, 'proof>(graph: &SourceGraph.Graph<'body>, control: &SourceControlProjection,
  sources: &RegionSources<'proof>, chains: &[UnretainedChain], loan: usize, point: usize,
  paths: &mut List<ReplacementReach>, contested: &mut List<Shared<Lifetime>>) -> bool ! OutOfMemoryError ? &mut Allocator {
  let points = List<SourceControl.Point>.asSlice(&SourceGraph.Graph.control(graph).points)
  if point >= points.length { return CompilerBug.panic(b"contested source event has no actual control point") }
  let active = sourceTruthAnd(regionLoanActivity(sources, loan), SourceGraph.Graph.truth(graph, points[point].reachable))
  if active == SourceTruth.False { return true }
  if active != SourceTruth.True || control.unresolved { return false }
  let mut complete = true
  let mut at = usize.ZERO
  while at < chains.length {
    let chain = &chains[at]
    if chain.unresolved { complete = false }
    if listsIndex(List<usize>.asSlice(&chain.loans), loan) {
      let dropped = regionLoanActivity(sources, chain.dropped)
      if dropped == SourceTruth.Undefined { complete = false }
      if dropped == SourceTruth.True && run reachesAvoiding(List<Point>.asSlice(&control.points), &mut paths.*,
        sources.loans[chain.dropped].created, point, usize.MAX) {
        run appendAllAtoms(&mut contested.*, List<Shared<Lifetime>>.asSlice(&chain.regions))
      }
    }
    at = at + usize.ONE
  }
  return complete
}

fn listsIndex(indices: &[usize], index: usize) -> bool {
  let mut at = usize.ZERO
  while at < indices.length {
    if indices[at] == index { return true }
    at = at + usize.ONE
  }
  return false
}

fn proofContains(regions: &[Shared<Lifetime>], region: &Shared<Lifetime>) -> bool {
  let mut at = usize.ZERO
  while at < regions.length {
    if Lifetime.equalsShared(&regions[at], region) { return true }
    at = at + usize.ONE
  }
  return false
}

// Whether the caller's 2a check (`checkDeclaredRegions`) already proved a universal relation:
// one whose whole offered side is a single declared region. A constituent of a meet that also
// holds a local atom has had no such proof, and neither has a Supplied atom, which 2a leaves
// pending; those must pass `universalRegionProved`.
fn declaredRelationProved(offered: &Shared<Lifetime>, wanted: &Shared<Lifetime>, constituents: usize) -> bool {
  return constituents == usize.ONE && !suppliedAtom(offered) && !suppliedAtom(wanted)
}

// Only authenticated scalar universals participate here. Premises come from the header proof,
// never the retained obligation list. Meets and outside-owner atoms remain pending.
effect fn universalRegionProved(owner: &DeclarationId, supplied: &[Shared<Lifetime>], offered: &Shared<Lifetime>, wanted: &Shared<Lifetime>,
  premises: &[RegionBound]) -> bool ! OutOfMemoryError ? &mut Allocator {
  if regionDomain(offered, owner, supplied) != RegionDomain.Universal || regionDomain(wanted, owner, supplied) != RegionDomain.Universal { return false }
  if Lifetime.equalsShared(offered, wanted) { return true }
  if Shared<Lifetime>.with<bool>(offered, fn(value: &Lifetime) -> bool {
    return match &value.* { Lifetime.Static => true _ => false }
  }) { return true }
  let mut reached = List<Shared<Lifetime>>.make()
  run List<Shared<Lifetime>>.append(&mut reached, Shared<Lifetime>.clone(wanted))
  let mut next = usize.ZERO
  while next < List<Shared<Lifetime>>.length(&reached) {
    let entries = List<Shared<Lifetime>>.asSlice(&reached)
    let current = Shared<Lifetime>.clone(&entries[next])
    if Lifetime.equalsShared(offered, &current) { return true }
    let mut at = usize.ZERO
    while at < premises.length {
      let premise = &premises[at]
      if regionDomain(&premise.longer, owner, supplied) == RegionDomain.Universal
        && regionDomain(&premise.shorter, owner, supplied) == RegionDomain.Universal
        && Lifetime.equalsShared(&premise.shorter, &current)
        && !proofContains(List<Shared<Lifetime>>.asSlice(&reached), &premise.longer) {
        run List<Shared<Lifetime>>.append(&mut reached, Shared<Lifetime>.clone(&premise.longer))
      }
      at = at + usize.ONE
    }
    next = next + usize.ONE
  }
  return false
}

fn cachedSymbolicRegion(owner: &DeclarationId, offered: &Shared<Lifetime>, wanted: &Shared<Lifetime>,
  cache: &[SymbolicRegion]) -> Option<bool> {
  let shorterLocal = regionLocal(wanted, owner)
  let mut at = usize.ZERO
  while at < cache.length {
    let sameTarget = Lifetime.equalsShared(&cache[at].wanted, wanted)
      || (shorterLocal && regionLocal(&cache[at].wanted, owner))
    if sameTarget && Lifetime.equalsShared(&cache[at].offered, offered) { return Option<bool>.some(cache[at].proved) }
    at = at + usize.ONE
  }
  return Option<bool>.none()
}

// A node in an authenticated actual-parent graph; grounding alone grants no point validity.
struct SymbolicRoot {
  region: Shared<Lifetime>
  parents: List<usize>
  grounded: bool
}

effect fn symbolicRootIndex(roots: &mut List<SymbolicRoot>, region: &Shared<Lifetime>) -> usize
! OutOfMemoryError ? &mut Allocator {
  let entries = List<SymbolicRoot>.asSlice(&roots.*)
  let mut at = usize.ZERO
  while at < entries.length {
    if Lifetime.equalsShared(&entries[at].region, region) { return at }
    at = at + usize.ONE
  }
  let selected = List<SymbolicRoot>.length(&roots.*)
  run List<SymbolicRoot>.append(&mut roots.*, SymbolicRoot {
    region: Shared<Lifetime>.clone(region), parents: List<usize>.make(), grounded: false,
  })
  return selected
}

// All parent paths must stay inside this complete provenance graph or end at a sufficient
// universal. Each reachable component must also reach a real root; a root elsewhere in the graph
// cannot justify an ungrounded sibling cycle. Static cycles from reassigning a reborrow may be
// grounded by the original reference, without assuming the cycle itself is a source of validity.
effect fn symbolicParentsProved<'proof>(sources: &RegionSources<'proof>, owner: &DeclarationId, offered: &Shared<Lifetime>,
  wanted: &Shared<Lifetime>, premises: &[RegionBound], cache: &mut List<SymbolicRegion>) -> bool
! OutOfMemoryError ? &mut Allocator {
  let mut roots = List<SymbolicRoot>.make()
  drop run symbolicRootIndex(&mut roots, offered)
  let loans = sources.loans
  let mut next = usize.ZERO
  while next < List<SymbolicRoot>.length(&roots) {
    let entries = List<SymbolicRoot>.asSlice(&roots)
    let region = Shared<Lifetime>.clone(&entries[next].region)
    // A contested region is used past the body by a loan the walk dropped, after a conflicting
    // access: it outlives no universal region.
    if regionDomain(wanted, owner, sources.supplied) == RegionDomain.Universal
      && proofContains(sources.contested, &region) { return false }
    let mut parents = List<usize>.make()
    let mut grounded = false
    let mut found = false
    let mut at = usize.ZERO
    while at < loans.length {
      let loan = &loans[at]
      let activity = regionLoanActivity(sources, at)
      if activity == SourceTruth.False {
        at = at + usize.ONE
        continue
      }
      if proofContains(List<Shared<Lifetime>>.asSlice(&loan.regions), &region) {
        found = true
        if activity != SourceTruth.True { return false }
        if loan.local || !provable(loan.precision) { return false }
        if let Option<Shared<Lifetime>>.Some {value: borrowed} = &loan.borrowed {
          if !Lifetime.equalsShared(&borrowed, &region) { return false }
        } else { return false }
        if let Option<Shared<Lifetime>>.Some {value: bound} = &loan.parent {
          // A reborrow through several descriptors is bounded by their meet: every atom must
          // reach the target, and any one sufficient atom grounds this storage.
          let count = Lifetime.atomCount(&bound)
          if count == usize.ZERO { return false }
          let mut atom = usize.ZERO
          while atom < count {
            let parent = Lifetime.atomAt(&bound, atom)
            let domain = regionDomain(&parent, owner, sources.supplied)
            if domain == RegionDomain.Universal {
              if regionDomain(wanted, owner, sources.supplied) == RegionDomain.Universal
                && !run universalRegionProved(owner, sources.supplied, &parent, wanted, premises) { return false }
              grounded = true
            } else if domain == RegionDomain.Local {
              let known = cachedSymbolicRegion(owner, &parent, wanted, List<SymbolicRegion>.asSlice(&cache.*))
              if let Option<bool>.Some {value} = move known {
                if !value { return false }
                grounded = true
              } else {
                let index = run symbolicRootIndex(&mut roots, &parent)
                run List<usize>.append(&mut parents, index)
              }
            } else { return false }
            atom = atom + usize.ONE
          }
        } else { return false }
      }
      at = at + usize.ONE
    }
    if !found { return false }
    // An open contents bound lets values of unknown regions into this region.
    if proofContains(sources.openContents, &region) { return false }
    // A value can also enter this region without a loan, through a region relation such as a
    // passed reference meeting a fresh borrow in one call region. Each such source must itself
    // reach the target; it never grounds this region, so its own loans must still be found.
    let relations = sources.retentionRelations
    let mut relation = usize.ZERO
    while relation < relations.length {
      if proofContains(List<Shared<Lifetime>>.asSlice(&relations[relation].container), &region) {
        let members = List<Shared<Lifetime>>.asSlice(&relations[relation].members)
        let mut member = usize.ZERO
        while member < members.length {
          let source = &members[member]
          if !Lifetime.equalsShared(source, &region) {
            let domain = regionDomain(source, owner, sources.supplied)
            if domain == RegionDomain.Universal {
              if regionDomain(wanted, owner, sources.supplied) == RegionDomain.Universal
                && !run universalRegionProved(owner, sources.supplied, source, wanted, premises) { return false }
            } else if domain == RegionDomain.Local {
              let known = cachedSymbolicRegion(owner, source, wanted, List<SymbolicRegion>.asSlice(&cache.*))
              if let Option<bool>.Some {value} = move known {
                if !value { return false }
              } else {
                drop run symbolicRootIndex(&mut roots, source)
              }
            } else { return false }
          }
          member = member + usize.ONE
        }
      }
      relation = relation + usize.ONE
    }
    let mut recorded = List<SymbolicRoot>.asMutSlice(&mut roots)
    recorded[next].parents = move parents
    recorded[next].grounded = grounded
    next = next + usize.ONE
  }
  if !groundRegionParents(&mut roots) { return false }
  let entries = List<SymbolicRoot>.asSlice(&roots)
  let mut at = usize.ZERO
  while at < entries.length {
    run List<SymbolicRegion>.append(&mut cache.*, SymbolicRegion {
      offered: Shared<Lifetime>.clone(&entries[at].region), wanted: Shared<Lifetime>.clone(wanted), proved: true,
    })
    at = at + usize.ONE
  }
  return true
}

fn groundRegionParents(roots: &mut List<SymbolicRoot>) -> bool {
  let mut changed = true
  while changed {
    changed = false
    let mut at = usize.ZERO
    while at < List<SymbolicRoot>.length(&roots.*) {
      let entries = List<SymbolicRoot>.asSlice(&roots.*)
      let mut grounded = entries[at].grounded
      if !grounded {
        let parents = List<usize>.asSlice(&entries[at].parents)
        let mut parent = usize.ZERO
        while parent < parents.length {
          if entries[parents[parent]].grounded { grounded = true }
          parent = parent + usize.ONE
        }
        if grounded {
          let mut recorded = List<SymbolicRoot>.asMutSlice(&mut roots.*)
          recorded[at].grounded = true
          changed = true
        }
      }
      at = at + usize.ONE
    }
  }
  let entries = List<SymbolicRoot>.asSlice(&roots.*)
  let mut at = usize.ZERO
  while at < entries.length {
    if !entries[at].grounded { return false }
    at = at + usize.ONE
  }
  return true
}

// A local target asks only for a source valid throughout the finite body. A universal target
// retains its exact identity. Inner retained atoms never stand in for outer storage provenance.
effect fn symbolicRegionProved<'proof>(sources: &RegionSources<'proof>, owner: &DeclarationId,
  offered: &Shared<Lifetime>, wanted: &Shared<Lifetime>, premises: &[RegionBound], cache: &mut List<SymbolicRegion>) -> bool
! OutOfMemoryError ? &mut Allocator {
  let longer = regionDomain(offered, owner, sources.supplied)
  let shorter = regionDomain(wanted, owner, sources.supplied)
  if longer == RegionDomain.Unknown || shorter == RegionDomain.Unknown { return false }
  if longer == RegionDomain.Universal {
    if shorter == RegionDomain.Local { return true }
    return run universalRegionProved(owner, sources.supplied, offered, wanted, premises)
  }
  if let Option<bool>.Some {value} = move cachedSymbolicRegion(owner, offered, wanted, List<SymbolicRegion>.asSlice(&cache.*)) {
    return value
  }
  let proved = run symbolicParentsProved(sources, owner, offered, wanted, premises, &mut cache.*)
  if !proved {
    run List<SymbolicRegion>.append(&mut cache.*, SymbolicRegion {
      offered: Shared<Lifetime>.clone(offered), wanted: Shared<Lifetime>.clone(wanted), proved: false,
    })
  }
  return proved
}

// The actual parent bounds this loan's chosen outer lifetime. Such an external source is
// valid throughout the body independently of when its descriptor or this loan was created.
effect fn loanParentBoundProved<'proof>(sources: &RegionSources<'proof>, owner: &DeclarationId, loan: &Loan,
  premises: &[RegionBound], cache: &mut List<SymbolicRegion>) -> bool
! OutOfMemoryError ? &mut Allocator {
  if loan.local || !provable(loan.precision) { return false }
  if let Option<Shared<Lifetime>>.Some {value: borrowed} = &loan.borrowed {
    if let Option<Shared<Lifetime>>.Some {value: parent} = &loan.parent {
      // A meet of descriptor lifetimes offers the borrow only while each of them does.
      let count = Lifetime.atomCount(&parent)
      if count == usize.ZERO { return false }
      let mut atom = usize.ZERO
      while atom < count {
        let member = Lifetime.atomAt(&parent, atom)
        if !run symbolicRegionProved(sources, owner, &member, &borrowed, premises, &mut cache.*) { return false }
        atom = atom + usize.ONE
      }
      return true
    }
  }
  return false
}

effect fn crossedRegionsProved<'proof>(sources: &RegionSources<'proof>, owner: &DeclarationId, premises: &[RegionBound],
  cache: &mut List<SymbolicRegion>) -> bool ! OutOfMemoryError ? &mut Allocator {
  let loans = sources.loans
  let mut at = usize.ZERO
  while at < loans.length {
    let loan = &loans[at]
    let activity = regionLoanActivity(sources, at)
    if activity == SourceTruth.False {
      at = at + usize.ONE
      continue
    }
    if activity != SourceTruth.True { return false }
    if loan.crossed && !run loanParentBoundProved(sources, owner, loan, premises, &mut cache.*) { return false }
    at = at + usize.ONE
  }
  return true
}

// Finite crossings may end at owned storage, but every actual parent path must be accounted
// for and grounded. These edges become point-set requirements, never symbolic premises or a
// universal-source cache entry. A type's inner atom cannot identify its outer source loan.
effect fn finiteParentRoots<'proof>(sources: &RegionSources<'proof>, owner: &DeclarationId, roots: &mut List<SymbolicRoot>) -> bool
! OutOfMemoryError ? &mut Allocator {
  let loans = sources.loans
  let supplied = sources.supplied
  let mut next = usize.ZERO
  while next < List<SymbolicRoot>.length(&roots.*) {
    let entries = List<SymbolicRoot>.asSlice(&roots.*)
    let region = Shared<Lifetime>.clone(&entries[next].region)
    if !regionLocal(&region, owner) { return false }
    let mut parents = List<usize>.make()
    let mut grounded = false
    let mut found = false
    let mut at = usize.ZERO
    while at < loans.length {
      let loan = &loans[at]
      let activity = regionLoanActivity(sources, at)
      if activity == SourceTruth.False {
        at = at + usize.ONE
        continue
      }
      if regionsCarry(List<Shared<Lifetime>>.asSlice(&loan.regions), &region, owner, supplied) {
        found = true
        if activity != SourceTruth.True { return false }
        if !provable(loan.precision) { return false }
        if let Option<Shared<Lifetime>>.Some {value: borrowed} = &loan.borrowed {
          if !carriesRegion(&borrowed, &region, owner, supplied) { return false }
        } else { return false }
        if loan.local {
          if let Option<Shared<Lifetime>>.Some {..} = &loan.parent { return false }
          grounded = true
        } else if let Option<Shared<Lifetime>>.Some {value: bound} = &loan.parent {
          let count = Lifetime.atomCount(&bound)
          if count == usize.ZERO { return false }
          let mut atom = usize.ZERO
          while atom < count {
            let parent = Lifetime.atomAt(&bound, atom)
            let domain = regionDomain(&parent, owner, supplied)
            if domain == RegionDomain.Universal {
              grounded = true
            } else if domain == RegionDomain.Local {
              let index = run symbolicRootIndex(&mut roots.*, &parent)
              run List<usize>.append(&mut parents, index)
            } else { return false }
            atom = atom + usize.ONE
          }
        } else { return false }
      }
      at = at + usize.ONE
    }
    if !found { return false }
    let mut recorded = List<SymbolicRoot>.asMutSlice(&mut roots.*)
    recorded[next].parents = move parents
    recorded[next].grounded = grounded
    next = next + usize.ONE
  }
  return groundRegionParents(&mut roots.*)
}

effect fn finiteCrossingRoots<'proof>(sources: &RegionSources<'proof>, owner: &DeclarationId,
  premises: &[RegionBound], symbolic: &mut List<SymbolicRegion>) -> Option<List<SymbolicRoot>>
! OutOfMemoryError ? &mut Allocator {
  let mut roots = List<SymbolicRoot>.make()
  let loans = sources.loans
  let mut at = usize.ZERO
  while at < loans.length {
    let loan = &loans[at]
    let activity = regionLoanActivity(sources, at)
    if activity == SourceTruth.False {
      at = at + usize.ONE
      continue
    }
    if activity != SourceTruth.True { return Option<List<SymbolicRoot>>.none() }
    if loan.crossed && !run loanParentBoundProved(sources, owner, loan, premises, &mut symbolic.*) {
      if let Option<Shared<Lifetime>>.Some {value: borrowed} = &loan.borrowed {
        if localMeet(&borrowed, owner, sources.supplied) {
          // The meet's local constituents carry its finite requirements; its universal ones
          // outlive the body.
          let mut atom = usize.ZERO
          while atom < Lifetime.atomCount(&borrowed) {
            let member = Lifetime.atomAt(&borrowed, atom)
            if regionLocal(&member, owner) { drop run symbolicRootIndex(&mut roots, &member) }
            atom = atom + usize.ONE
          }
        } else {
          drop run symbolicRootIndex(&mut roots, &borrowed)
        }
      } else { return Option<List<SymbolicRoot>>.none() }
    }
    at = at + usize.ONE
  }
  if !run finiteParentRoots(sources, owner, &mut roots) { return Option<List<SymbolicRoot>>.none() }
  return Option<List<SymbolicRoot>>.some(move roots)
}

effect fn finiteCrossingsProved(walker: &Walker, owner: &DeclarationId, premises: &[RegionBound],
  symbolic: &mut List<SymbolicRegion>, liveOut: &[u64],
  definitions: &[u64], definitionWidth: usize, regions: &mut List<RegionPoints>, edges: &mut List<RegionEdge>, flow: &mut IntervalFlow, storage: &mut RegionAvailability) -> bool
! OutOfMemoryError ? &mut Allocator {
  let roots = match move run finiteCrossingRoots(&regionSources(walker), owner, premises, &mut symbolic.*) {
    Option<List<SymbolicRoot>>.Some {value} => move value
    _ => { return false }
  }
  let mut at = usize.ZERO
  let entries = List<SymbolicRoot>.asSlice(&roots)
  // Record only the complete, grounded parent graph. Every edge is installed below before
  // solving; these finite facts never enter the universal-source cache.
  at = usize.ZERO
  while at < entries.length {
    run List<Shared<Lifetime>>.append(&mut storage.finiteParents, Shared<Lifetime>.clone(&entries[at].region))
    at = at + usize.ONE
  }
  let mut indices = List<usize>.make()
  at = usize.ZERO
  while at < entries.length {
    let index = run regionPoints(walker, owner, &entries[at].region, liveOut,
      definitions, definitionWidth, &mut regions.*, premises, &mut symbolic.*, &mut flow.*, &mut storage.*)
    if index == usize.MAX { return false }
    run List<usize>.append(&mut indices, index)
    at = at + usize.ONE
  }
  return run installFiniteParentEdges(entries, List<usize>.asSlice(&indices), &mut regions.*, &mut edges.*)
}

effect fn installFiniteParentEdges(entries: &[SymbolicRoot], mapped: &[usize],
  regions: &mut List<RegionPoints>, edges: &mut List<RegionEdge>) -> bool ! OutOfMemoryError ? &mut Allocator {
  if entries.length != mapped.length { return CompilerBug.panic(b"finite parent bindings lost an actual source region") }
  let mut at = usize.ZERO
  while at < entries.length {
    let parents = List<usize>.asSlice(&entries[at].parents)
    let mut parent = usize.ZERO
    while parent < parents.length {
      let source = mapped[at]
      let target = mapped[parents[parent]]
      if source == target {
        // Ordinary identity goals need no propagation. An actual reborrow parent sharing its
        // atom is different: require all own points in the shared availability intersection.
        // Later incoming points already receive that check in the ordinary worklist.
        requireSharedParentPoints(&mut regions.*, source)
      } else {
        run List<RegionEdge>.append(&mut edges.*, RegionEdge {shorter: source, longer: target})
      }
      parent = parent + usize.ONE
    }
    at = at + usize.ONE
  }
  return true
}

fn requireSharedParentPoints(regions: &mut List<RegionPoints>, index: usize) -> () {
  let mut entries = List<RegionPoints>.asMutSlice(&mut regions.*)
  let count = List<u64>.length(&entries[index].required)
  let mut word = usize.ZERO
  while word < count {
    let needed = List<u64>.asSlice(&entries[index].required)
    let value = needed[word]
    let mut propagated = List<u64>.asMutSlice(&mut entries[index].incoming)
    propagated[word] = u64.bitOr(propagated[word], value)
    word = word + usize.ONE
  }
  return ()
}

fn includeRegionPoint(bits: &mut List<u64>, point: usize) -> bool {
  let words = List<u64>.asMutSlice(&mut bits.*)
  let word = wordOf(point)
  let before = words[word]
  words[word] = u64.bitOr(before, maskOf(point))
  return before != words[word]
}

fn excludeRegionPoint(bits: &mut List<u64>, point: usize) -> bool {
  let words = List<u64>.asMutSlice(&mut bits.*)
  let word = wordOf(point)
  let before = words[word]
  words[word] = u64.bitAnd(before, u64.bitNot(maskOf(point)))
  return before != words[word]
}

// Availability is a storage-validity must fact, separate from the actual loan's activity.
// An authenticated universal parent or complete finite parent graph can establish validity
// independently of this descriptor. Finite parent edges still bound every required point by
// the actual storage. Without either witness, creation remains the conservative lower bound on
// every path from entry; a point no path from creation reaches is available (`unreachableAvailable`).
// Real referent ends, writes, moves and drops still propagate exclusions along the CFG; neither
// the symbolic escape proof nor the Walker's conflict/liveness checks are bypassed.
// The eager caller supplies the same carrier contract while the atomic source migration is
// staged. The propagation below is shared; the source caller never runs reachingHoldings.
effect fn localAvailable(walker: &Walker, entry: usize, index: usize, loan: &Loan, sourceBound: bool, ownedStart: bool,
  definitions: &[u64], definitionWidth: usize, available: &mut List<u64>) -> ()
! OutOfMemoryError ? &mut Allocator {
  let points = List<Point>.asSlice(&walker.points)
  let held = List<Holding>.asSlice(&walker.definitions)
  let histories = List<HoldingSource>.asSlice(&walker.holdingSources)
  let mut projection = AvailabilityProjection {carriers: List<AvailabilityCarrier>.make(),
    preserves: List<u64>.make(), flight: List<bool>.make(), unresolved: false}
  let mut at = usize.ZERO
  while at < points.length {
    run List<bool>.append(&mut projection.flight, withinInterval(loan, at))
    at = at + usize.ONE
  }
  if definitionWidth == usize.ZERO {
    return run propagateAvailability(points, List<Event>.asSlice(&walker.events), entry, loan, sourceBound,
      ownedStart, definitions, definitionWidth, &projection, &mut available.*)
  }
  at = usize.ZERO
  while at < points.length * definitionWidth {
    run List<u64>.append(&mut projection.preserves, 0)
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < held.length {
    let mut sources = List<AvailabilitySource>.make()
    let mut each = held[at].sources
    while each < held[at].sources + held[at].sourceCount {
      run List<AvailabilitySource>.append(&mut sources, AvailabilitySource {
        definition: histories[each].definition, read: histories[each].read})
      each = each + usize.ONE
    }
    run List<AvailabilityCarrier>.append(&mut projection.carriers, AvailabilityCarrier {
      point: held[at].point, selected: held[at].loan == index, unpaired: held[at].sourceCount == usize.ZERO,
      sources: move sources})
    let mut point = usize.ZERO
    while point < points.length {
      if points[point].defines != held[at].holder || held[at].point == point {
        sourceIncludeDefinition(&mut projection.preserves, definitionWidth, point, SourceControl.DefinitionId {index: at})
      }
      point = point + usize.ONE
    }
    at = at + usize.ONE
  }
  return run propagateAvailability(points, List<Event>.asSlice(&walker.events), entry, loan, sourceBound,
    ownedStart, definitions, definitionWidth, &projection, &mut available.*)
}

// Accepted availability algorithm, parameterized only by its actual carrier/kill/history
// inventory. The caller supplies the same CFG and keeps the source-bound and own-loan gates.
effect fn propagateAvailability(points: &[Point], events: &[Event], entry: usize, loan: &Loan,
  sourceBound: bool, ownedStart: bool, definitions: &[u64], definitionWidth: usize,
  projection: &AvailabilityProjection, available: &mut List<u64>) -> ()
! OutOfMemoryError ? &mut Allocator {
  let mut entered = List<usize>.make()
  // The entry belongs to the supplied CFG; its numeric ID is not an availability fact.
  if !sourceBound && !ownedStart && loan.created != entry && excludeRegionPoint(&mut available.*, entry) {
    run List<usize>.append(&mut entered, entry)
  }
  let mut at = usize.ZERO
  while at < List<usize>.length(&entered) {
    let point = List<usize>.asSlice(&entered)[at]
    let next = List<usize>.asSlice(&points[point].next)
    let mut edge = usize.ZERO
    while edge < next.length {
      if next[edge] != loan.created && excludeRegionPoint(&mut available.*, next[edge]) {
        run List<usize>.append(&mut entered, next[edge])
      }
      edge = edge + usize.ONE
    }
    at = at + usize.ONE
  }
  let mut queue = List<usize>.make()
  at = usize.ZERO
  while at < events.length {
    let event = &events[at]
    let ends = event.kind == Kind.End || event.kind == Kind.Expire || event.kind == Kind.Write
      || event.kind == Kind.Move || event.kind == Kind.Drop
    // Ending or replacing the descriptor does not end an independently bounded referent, and
    // ending a descriptor's storage never ends what it refers to: a reborrow through a reference
    // a scope or statement ends stays bounded by the loan that reference carries. Actual referent
    // events still invalidate availability, and Walker conflicts are unchanged.
    let storageEnds = event.kind == Kind.End || event.kind == Kind.Expire
    let descriptorOnly = (event.kind == Kind.Write || storageEnds || sourceBound) && behind(&event.place, &loan.place)
    if ends && !descriptorOnly && event.point != loan.created && overlap(&event.place, &loan.place) != usize.ZERO
      && excludeRegionPoint(&mut available.*, event.point) {
      run List<usize>.append(&mut queue, event.point)
    }
    at = at + usize.ONE
  }
  // A referent event invalidates the loan only along paths that still hold it: each invalidated point
  // carries the holdings that still hold the loan on some path from the event. A holding ends where
  // its holder is bound again; a copy of a carried holding, or a binding of the loan while it is in
  // flight, joins them. Past a point where none is left and no value carrying the loan is in flight,
  // nothing on that path can hold it again without its creation, so no later requirement on that
  // path depends on this storage.
  let width = definitionWidth
  if width == usize.ZERO || loan.escapes || loan.until != usize.MAX {
    at = usize.ZERO
    while at < List<usize>.length(&queue) {
      let point = List<usize>.asSlice(&queue)[at]
      let next = List<usize>.asSlice(&points[point].next)
      let mut edge = usize.ZERO
      while edge < next.length {
        if next[edge] != loan.created && excludeRegionPoint(&mut available.*, next[edge]) {
          run List<usize>.append(&mut queue, next[edge])
        }
        edge = edge + usize.ONE
      }
      at = at + usize.ONE
    }
    return ()
  }
  let all = List<AvailabilityCarrier>.asSlice(&projection.carriers)
  let mut carried = List<u64>.make()
  at = usize.ZERO
  while at < points.length * width { run List<u64>.append(&mut carried, 0) at = at + usize.ONE }
  // Seed each event with the holdings of this loan that reach it.
  at = usize.ZERO
  while at < List<usize>.length(&queue) {
    let point = List<usize>.asSlice(&queue)[at]
    let mut held = usize.ZERO
    while held < all.length {
      if all[held].selected && reaches(definitions, width, point, held) {
        let mut words = List<u64>.asMutSlice(&mut carried)
        let slot = point * width + wordOf(held)
        words[slot] = u64.bitOr(words[slot], maskOf(held))
      }
      held = held + usize.ONE
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < List<usize>.length(&queue) {
    let point = List<usize>.asSlice(&queue)[at]
    let next = List<usize>.asSlice(&points[point].next)
    let flowing = List<bool>.asSlice(&projection.flight)[point]
    let mut edge = usize.ZERO
    while edge < next.length {
      let target = next[edge]
      if target != loan.created {
        let landing = List<bool>.asSlice(&projection.flight)[target]
        let mut grew = false
        let mut holds = false
        let mut held = usize.ZERO
        while held < all.length {
          let incoming = u64.bitAnd(List<u64>.asSlice(&carried)[point * width + wordOf(held)], maskOf(held)) != 0
          let rebound = !reaches(List<u64>.asSlice(&projection.preserves), width, target, held)
          let mut copied = false
          if all[held].selected && all[held].point == target {
            copied = all[held].unpaired && (flowing || landing)
            let sources = List<AvailabilitySource>.asSlice(&all[held].sources)
            let mut source = usize.ZERO
            while source < sources.length {
              let origin = sources[source].definition
              if reaches(definitions, width, sources[source].read, origin)
                && u64.bitAnd(List<u64>.asSlice(&carried)[point * width + wordOf(origin)], maskOf(origin)) != 0 { copied = true }
              source = source + usize.ONE
            }
          }
          if (incoming && !rebound) || copied {
            holds = true
            let slot = target * width + wordOf(held)
            let before = List<u64>.asSlice(&carried)[slot]
            let mut words = List<u64>.asMutSlice(&mut carried)
            words[slot] = u64.bitOr(before, maskOf(held))
            if words[slot] != before { grew = true }
          }
          held = held + usize.ONE
        }
        if holds || landing {
          let excluded = excludeRegionPoint(&mut available.*, target)
          if excluded || grew { run List<usize>.append(&mut queue, target) }
        }
      }
      edge = edge + usize.ONE
    }
    at = at + usize.ONE
  }
  return ()
}

// Whether a value carrying `loan` may be in flight at `point`: within one of its intervals.
fn withinInterval(loan: &Loan, point: usize) -> bool {
  let intervals = List<Interval>.asSlice(&loan.intervals)
  let mut at = usize.ZERO
  while at < intervals.length {
    if intervals[at].from <= point && point <= intervals[at].to { return true }
    at = at + usize.ONE
  }
  return false
}

// A loan is live only at points its creation reaches, so a point no path from its creation reaches
// places no validity requirement on it: such a point is available to the loan, whatever region
// requirement arrives there.
effect fn unreachableAvailable(points: &[Point], created: usize, available: &mut List<u64>) -> ()
! OutOfMemoryError ? &mut Allocator {
  let mut reached = List<u64>.make()
  let mut word = usize.ZERO
  while word < List<u64>.length(&available.*) {
    run List<u64>.append(&mut reached, 0)
    word = word + usize.ONE
  }
  let mut queue = List<usize>.make()
  drop includeRegionPoint(&mut reached, created)
  run List<usize>.append(&mut queue, created)
  let mut at = usize.ZERO
  while at < List<usize>.length(&queue) {
    let point = List<usize>.asSlice(&queue)[at]
    let next = List<usize>.asSlice(&points[point].next)
    let mut edge = usize.ZERO
    while edge < next.length {
      if includeRegionPoint(&mut reached, next[edge]) { run List<usize>.append(&mut queue, next[edge]) }
      edge = edge + usize.ONE
    }
    at = at + usize.ONE
  }
  let reachedWords = List<u64>.asSlice(&reached)
  let mut words = List<u64>.asMutSlice(&mut available.*)
  word = usize.ZERO
  while word < words.length {
    words[word] = u64.bitOr(words[word], u64.bitNot(reachedWords[word]))
    word = word + usize.ONE
  }
  return ()
}

// One lazy reverse CFG and one cached point set per consuming endpoint, scoped to this
// body's region proof. Traversal includes all edges, including back edges; numeric source
// ordering never decides whether a branch can reach its consumer.
struct IntervalFlow {
  offsets: List<usize>
  predecessors: List<usize>
  endpoints: List<usize>
  reaching: List<List<u64>>
}

fn emptyIntervalFlow() -> IntervalFlow {
  return IntervalFlow {offsets: List<usize>.make(), predecessors: List<usize>.make(),
    endpoints: List<usize>.make(), reaching: List<List<u64>>.make()}
}

effect fn intervalPredecessors(points: &[Point], flow: &mut IntervalFlow) -> ()
! OutOfMemoryError ? &mut Allocator {
  if List<usize>.length(&flow.offsets) > usize.ZERO { return () }
  let mut at = usize.ZERO
  while at <= points.length { run List<usize>.append(&mut flow.offsets, usize.ZERO) at = at + usize.ONE }
  at = usize.ZERO
  while at < points.length {
    let next = List<usize>.asSlice(&points[at].next)
    let mut edge = usize.ZERO
    while edge < next.length {
      let mut offsets = List<usize>.asMutSlice(&mut flow.offsets)
      offsets[next[edge] + usize.ONE] = offsets[next[edge] + usize.ONE] + usize.ONE
      edge = edge + usize.ONE
    }
    at = at + usize.ONE
  }
  at = usize.ONE
  while at <= points.length {
    let mut offsets = List<usize>.asMutSlice(&mut flow.offsets)
    offsets[at] = offsets[at] + offsets[at - usize.ONE]
    at = at + usize.ONE
  }
  let offsets = List<usize>.asSlice(&flow.offsets)
  let edgeCount = offsets[points.length]
  at = usize.ZERO
  while at < edgeCount { run List<usize>.append(&mut flow.predecessors, usize.ZERO) at = at + usize.ONE }
  let mut cursor = List<usize>.make()
  at = usize.ZERO
  while at < points.length { run List<usize>.append(&mut cursor, offsets[at]) at = at + usize.ONE }
  at = usize.ZERO
  while at < points.length {
    let next = List<usize>.asSlice(&points[at].next)
    let mut edge = usize.ZERO
    while edge < next.length {
      let mut positions = List<usize>.asMutSlice(&mut cursor)
      let index = positions[next[edge]]
      positions[next[edge]] = index + usize.ONE
      let mut predecessors = List<usize>.asMutSlice(&mut flow.predecessors)
      predecessors[index] = at
      edge = edge + usize.ONE
    }
    at = at + usize.ONE
  }
  return ()
}

effect fn intervalEndpoint(points: &[Point], endpoint: usize, flow: &mut IntervalFlow) -> usize
! OutOfMemoryError ? &mut Allocator {
  let ends = List<usize>.asSlice(&flow.endpoints)
  let mut at = usize.ZERO
  while at < ends.length { if ends[at] == endpoint { return at } at = at + usize.ONE }
  run intervalPredecessors(points, &mut flow.*)
  let mut reached = List<u64>.make()
  let words = (points.length + 63) / 64
  at = usize.ZERO
  while at < words { run List<u64>.append(&mut reached, 0) at = at + usize.ONE }
  drop includeRegionPoint(&mut reached, endpoint)
  let mut pending = List<usize>.make()
  run List<usize>.append(&mut pending, endpoint)
  at = usize.ZERO
  while at < List<usize>.length(&pending) {
    let point = List<usize>.asSlice(&pending)[at]
    let offsets = List<usize>.asSlice(&flow.offsets)
    let predecessors = List<usize>.asSlice(&flow.predecessors)
    let mut edge = offsets[point]
    while edge < offsets[point + usize.ONE] {
      let previous = predecessors[edge]
      if includeRegionPoint(&mut reached, previous) { run List<usize>.append(&mut pending, previous) }
      edge = edge + usize.ONE
    }
    at = at + usize.ONE
  }
  let index = List<usize>.length(&flow.endpoints)
  run List<usize>.append(&mut flow.endpoints, endpoint)
  run List<List<u64>>.append(&mut flow.reaching, move reached)
  return index
}

// An owned place can exist before a fresh loan is taken. Keep this storage fact separate from
// actual loan activity and from the universal-source proof. Each cached mask is a must fact:
// any entry path avoiding the root's initialization excludes every point it reaches.
struct RegionAvailability {
  roots: List<usize>
  masks: List<List<u64>>
  finiteParents: List<Shared<Lifetime>>
  // Authenticated body-scoped choices have no storage source of their own. Every later
  // relation still constrains them through the same graph as actual source regions.
  choices: List<Shared<Lifetime>>
}

fn emptyRegionAvailability() -> RegionAvailability {
  return RegionAvailability {roots: List<usize>.make(), masks: List<List<u64>>.make(),
    finiteParents: List<Shared<Lifetime>>.make(), choices: List<Shared<Lifetime>>.make()}
}

fn initializedOwnedSource(loan: &Loan, region: &Shared<Lifetime>) -> bool {
  if !loan.local || !provable(loan.precision) { return false }
  if let Option<Shared<Lifetime>>.Some {..} = &loan.parent { return false }
  // A direct borrow can be shortened to a meet. Each actual constituent still names this
  // same initialized storage; an unrelated nested lifetime does not. Authenticate membership
  // in both the sole retained lifetime and the borrow itself before using the root's must-mask.
  let named = List<Shared<Lifetime>>.asSlice(&loan.regions)
  if named.length != usize.ONE || (!Lifetime.equalsShared(&named[0], region) && !meetMember(&named[0], region)) { return false }
  if let Option<Shared<Lifetime>>.Some {value: borrowed} = &loan.borrowed {
    if !Lifetime.equalsShared(&borrowed, region) && !meetMember(&borrowed, region) { return false }
  } else { return false }
  return true
}

effect fn initializedOwnedRegion(points: &[Point], entry: usize, loan: &Loan, region: &Shared<Lifetime>,
  storage: &mut RegionAvailability, flow: &mut IntervalFlow) -> usize
! OutOfMemoryError ? &mut Allocator {
  if !initializedOwnedSource(loan, region) { return usize.MAX }
  let roots = List<usize>.asSlice(&storage.roots)
  let mut at = usize.ZERO
  while at < roots.length { if roots[at] == loan.place.root { return at } at = at + usize.ONE }
  let mut initialized = usize.MAX
  at = usize.ZERO
  while at < points.length {
    if points[at].initializes == loan.place.root {
      if initialized != usize.MAX { return usize.MAX }
      initialized = at
    }
    at = at + usize.ONE
  }
  if initialized == usize.MAX { return usize.MAX }
  return run initializedStorageRegion(points, entry, loan.place.root, initialized, &mut storage.*, &mut flow.*)
}

// The initializer is an actual storage-owner occurrence. The common must-mask still rejects
// cycles through initialization and every path from entry which avoids that initialization.
effect fn initializedStorageRegion(points: &[Point], entry: usize, root: usize, initialized: usize,
  storage: &mut RegionAvailability, flow: &mut IntervalFlow) -> usize
! OutOfMemoryError ? &mut Allocator {
  if initialized >= points.length || entry >= points.length { return usize.MAX }
  let roots = List<usize>.asSlice(&storage.roots)
  let mut at = usize.ZERO
  while at < roots.length { if roots[at] == root { return at } at = at + usize.ONE }
  // This proof authenticates one storage instance. A root rebound around a CFG cycle keeps
  // the creation lower bound; a new iteration must not revive an earlier escaped loan.
  let endpoint = run intervalEndpoint(points, initialized, &mut flow.*)
  let reached = List<List<u64>>.asSlice(&flow.reaching)
  let paths = List<u64>.asSlice(&reached[endpoint])
  let successors = List<usize>.asSlice(&points[initialized].next)
  at = usize.ZERO
  while at < successors.length {
    if u64.bitAnd(paths[wordOf(successors[at])], maskOf(successors[at])) != 0 { return usize.MAX }
    at = at + usize.ONE
  }
  let mut available = List<u64>.make()
  let words = (points.length + 63) / 64
  at = usize.ZERO
  while at < words { run List<u64>.append(&mut available, u64.bitNot(0)) at = at + usize.ONE }
  let mut pending = List<usize>.make()
  if initialized != entry && excludeRegionPoint(&mut available, entry) {
    run List<usize>.append(&mut pending, entry)
  }
  at = usize.ZERO
  while at < List<usize>.length(&pending) {
    let point = List<usize>.asSlice(&pending)[at]
    let next = List<usize>.asSlice(&points[point].next)
    let mut edge = usize.ZERO
    while edge < next.length {
      if next[edge] != initialized && excludeRegionPoint(&mut available, next[edge]) {
        run List<usize>.append(&mut pending, next[edge])
      }
      edge = edge + usize.ONE
    }
    at = at + usize.ONE
  }
  let index = List<usize>.length(&storage.roots)
  run List<usize>.append(&mut storage.roots, root)
  run List<List<u64>>.append(&mut storage.masks, move available)
  return index
}

// Points after this particular owned loan has ceased to inhabit any value on every path
// that created it. Paths that never created the loan impose no source-instance requirement at
// a join with a released path. A later creation or carrier reactivates the source. This is not
// storage availability: the loan's own uses must first pass the unmodified storage proof.
// Unknown sources, outward retention and parent dependencies cannot use this local release fact.
effect fn releasedLoanPoints(walker: &Walker, index: usize, definitions: &[u64], width: usize,
  needed: &[u64]) -> List<u64> ! OutOfMemoryError ? &mut Allocator {
  let points = List<Point>.asSlice(&walker.points)
  let loans = List<Loan>.asSlice(&walker.loans)
  let loan = &loans[index]
  let mut released = List<u64>.make()
  let words = (points.length + 63) / 64
  let mut at = usize.ZERO
  while at < words { run List<u64>.append(&mut released, 0) at = at + usize.ONE }
  if !loanMayRelease(loans, index) { return move released }
  let held = List<Holding>.asSlice(&walker.definitions)
  let mut occupied = List<bool>.make()
  let mut ends = List<bool>.make()
  let intervals = List<Interval>.asSlice(&loan.intervals)
  at = usize.ZERO
  while at < points.length {
    let mut carries = at == loan.created || u64.bitAnd(needed[wordOf(at)], maskOf(at)) != 0
    let mut survives = false
    let mut ended = false
    let mut each = usize.ZERO
    while each < held.length {
      if held[each].loan == index && !held[each].shadowed {
        // Incoming definitions protect the value until its overwrite; a newly bound definition
        // protects it from that point onward. Inherited values remain independent real carriers.
        let enters = width != usize.ZERO && reaches(definitions, width, at, each)
        let binds = held[each].point == at && holdingSourceReaches(walker, held[each], definitions, width)
        if enters || binds { carries = true }
        if (enters && points[at].defines != held[each].holder) || binds { survives = true }
        if enters && points[at].defines == held[each].holder && !binds { ended = true }
      }
      each = each + usize.ONE
    }
    each = usize.ZERO
    while each < intervals.length {
      let interval = intervals[each]
      if interval.to == at && interval.from <= interval.to
        && (interval.definition == usize.MAX || (width != usize.ZERO && reaches(definitions, width, interval.read, interval.definition))) { ended = true }
      each = each + usize.ONE
    }
    run List<bool>.append(&mut occupied, carries)
    run List<bool>.append(&mut ends, ended && !survives)
    at = at + usize.ONE
  }
  return run releasedInstancePoints(points, walker.entry, loan.created,
    List<bool>.asSlice(&occupied), List<bool>.asSlice(&ends))
}

fn loanMayRelease(loans: &[Loan], index: usize) -> bool {
  let loan = &loans[index]
  if !ownedStorageLoan(loan) || loan.escapes || loan.until != usize.MAX { return false }
  // A parent can still be needed through a child whose carrier has a different loan identity.
  // Keep its full availability constraint unless all such dependencies are accounted for.
  let mut at = usize.ZERO
  while at < loans.length {
    if at != index {
      if let Option<Shared<Lifetime>>.Some {value: parent} = &loans[at].parent {
        let named = List<Shared<Lifetime>>.asSlice(&loan.regions)
        let mut each = usize.ZERO
        while each < named.length {
          let mut atom = usize.ZERO
          while atom < Lifetime.atomCount(&named[each]) {
            if meetMember(&parent, &Lifetime.atomAt(&named[each], atom)) { return false }
            atom = atom + usize.ONE
          }
          each = each + usize.ONE
        }
      }
    }
    at = at + usize.ONE
  }
  return true
}

// Shared source-instance state machine. Callers must authenticate actual occupancy and ends,
// preserve the owned/escape/parent gates, and check each loan's own needs before using release.
effect fn releasedInstancePoints(points: &[Point], entry: usize, created: usize,
  occupied: &[bool], ends: &[bool]) -> List<u64> ! OutOfMemoryError ? &mut Allocator {
  if entry >= points.length || created >= points.length || occupied.length != points.length || ends.length != points.length {
    return CompilerBug.panic(b"loan release tables do not cover the actual CFG")
  }
  let mut released = List<u64>.make()
  let words = (points.length + 63) / 64
  let mut word = usize.ZERO
  while word < words { run List<u64>.append(&mut released, 0) word = word + usize.ONE }
  // Bit 1: this path has not created the loan; bit 2: it still carries the source;
  // bit 4: it created and released the source. Joins keep every incoming possibility.
  let mut states = List<u64>.make()
  let mut at = usize.ZERO
  while at < points.length { run List<u64>.append(&mut states, 0) at = at + usize.ONE }
  let mut initial = List<u64>.asMutSlice(&mut states)
  initial[entry] = 1
  let mut changed = true
  while changed {
    changed = false
    at = usize.ZERO
    while at < points.length {
      let incoming = List<u64>.asSlice(&states)[at]
      if incoming != 0 {
        let mut outgoing = incoming
        if at == created { outgoing = 2 }
        else if occupied[at] {
          outgoing = u64.bitOr(u64.bitAnd(incoming, 1), 2)
        }
        // Only a recorded consumption or replacement can terminate an instance. Mere absence
        // of a carrier is not release evidence, including on a cycle before initialization.
        if ends[at] && u64.bitAnd(outgoing, 2) != 0 {
          outgoing = u64.bitOr(u64.bitAnd(outgoing, 1), 4)
        }
        let next = List<usize>.asSlice(&points[at].next)
        let mut edge = usize.ZERO
        while edge < next.length {
          let mut entries = List<u64>.asMutSlice(&mut states)
          let before = entries[next[edge]]
          entries[next[edge]] = u64.bitOr(before, outgoing)
          if entries[next[edge]] != before { changed = true }
          edge = edge + usize.ONE
        }
      }
      at = at + usize.ONE
    }
  }
  at = usize.ZERO
  while at < points.length {
    let state = List<u64>.asSlice(&states)[at]
    // A concrete release must reach the point; absence before any source was created is not
    // evidence that initialization, a write, or a storage end can be ignored.
    if !occupied[at] && u64.bitAnd(state, 4) != 0 && u64.bitAnd(state, 2) == 0 {
      drop includeRegionPoint(&mut released, at)
    }
    at = at + usize.ONE
  }
  return move released
}

// A local atom names the loans typing gave it: usually one borrow, but every fresh borrow of one call
// shares the call's region, and a borrow of a value retains the regions its type names. The atom
// checks each loan's own requirement against that loan's availability. Its required set is their
// union; incoming requirements must fit their availability intersection. An atom no
// loan names remains pending unless typing authenticated it as an unconstrained call-prefix
// choice. A loan typed under a `localMeet` names each of the meet's local constituents. Outside-owner,
// invocation and supplied terms and unknown mappings remain pending.
effect fn regionPoints(walker: &Walker, owner: &DeclarationId, region: &Shared<Lifetime>,
  liveOut: &[u64], definitions: &[u64], definitionWidth: usize,
  regions: &mut List<RegionPoints>, premises: &[RegionBound], symbolic: &mut List<SymbolicRegion>, flow: &mut IntervalFlow, storage: &mut RegionAvailability) -> usize
! OutOfMemoryError ? &mut Allocator {
  let existing = List<RegionPoints>.asSlice(&regions.*)
  let mut at = usize.ZERO
  while at < existing.length {
    if Lifetime.equalsShared(&existing[at].region, region) { return at }
    at = at + usize.ONE
  }
  let domain = regionDomain(region, owner, List<Shared<Lifetime>>.asSlice(&walker.supplied))
  if domain == RegionDomain.Unknown { return usize.MAX }
  let loans = List<Loan>.asSlice(&walker.loans)
  let mut selected = List<usize>.make()
  if domain == RegionDomain.Local {
    at = usize.ZERO
    while at < loans.length {
      if regionsCarry(List<Shared<Lifetime>>.asSlice(&loans[at].regions), region, owner, List<Shared<Lifetime>>.asSlice(&walker.supplied)) {
        if !provable(loans[at].precision) { return usize.MAX }
        run List<usize>.append(&mut selected, at)
      }
      at = at + usize.ONE
    }
    if List<usize>.length(&selected) == usize.ZERO
      && !proofContains(List<Shared<Lifetime>>.asSlice(&storage.choices), region) { return usize.MAX }
  }
  let pointCount = List<Point>.length(&walker.points)
  let words = (pointCount + 63) / 64
  let mut required = List<u64>.make()
  let mut available = List<u64>.make()
  at = usize.ZERO
  while at < words {
    let mut initial: u64 = 0
    if domain == RegionDomain.Universal { initial = u64.bitNot(0) }
    run List<u64>.append(&mut required, initial)
    run List<u64>.append(&mut available, u64.bitNot(0))
    at = at + usize.ONE
  }
  let chosen = List<usize>.asSlice(&selected)
  let mut index = usize.ZERO
  while index < chosen.length {
    let loan = &loans[chosen[index]]
    if loan.created >= pointCount { return usize.MAX }
    // Each loan's requirement must lie within its own validity. Its exclusions propagate on their
    // own set: a point another loan of the atom already excluded must not stop this loan's
    // propagation before its own creation point.
    let mut own = List<u64>.make()
    let mut needed = List<u64>.make()
    at = usize.ZERO
    while at < words {
      run List<u64>.append(&mut own, u64.bitNot(0))
      run List<u64>.append(&mut needed, 0)
      at = at + usize.ONE
    }
    let universalBound = run loanParentBoundProved(&regionSources(walker), owner, loan, premises, &mut symbolic.*)
    // Each nonlocal member of this graph has authenticated outer provenance. Its finite
    // parent edges constrain all incoming and own requirements to the actual source storage.
    let finiteBound = !loan.local && proofContains(List<Shared<Lifetime>>.asSlice(&storage.finiteParents), region)
    let sourceBound = universalBound || finiteBound
    let initialized = run initializedOwnedRegion(List<Point>.asSlice(&walker.points), walker.entry, loan, region, &mut storage.*, &mut flow.*)
    run localAvailable(walker, walker.entry, chosen[index], loan, sourceBound, initialized != usize.MAX, definitions, definitionWidth, &mut own)
    if initialized != usize.MAX {
      let masks = List<List<u64>>.asSlice(&storage.masks)
      let valid = List<u64>.asSlice(&masks[initialized])
      let mut ownWords = List<u64>.asMutSlice(&mut own)
      let mut word = usize.ZERO
      while word < words { ownWords[word] = u64.bitAnd(ownWords[word], valid[word]) word = word + usize.ONE }
    }
    drop includeRegionPoint(&mut needed, loan.created)
    let intervals = List<Interval>.asSlice(&loan.intervals)
    at = usize.ZERO
    while at < intervals.length {
      let interval = intervals[at]
      if interval.from >= pointCount || interval.to >= pointCount { return usize.MAX }
      if interval.definition == usize.MAX || reaches(definitions, definitionWidth, interval.read, interval.definition) {
        // An abandoned branch cannot carry this interval to its consumer. Cleanup observers
        // have their own intervals, and heldLive below still supplies loop-carried requirements.
        if interval.from <= interval.to {
          let endpoint = run intervalEndpoint(List<Point>.asSlice(&walker.points), interval.to, &mut flow.*)
          let reached = List<List<u64>>.asSlice(&flow.reaching)
          let paths = List<u64>.asSlice(&reached[endpoint])
          let mut point = interval.from
          while point <= interval.to {
            if u64.bitAnd(paths[wordOf(point)], maskOf(point)) != 0 { drop includeRegionPoint(&mut needed, point) }
            point = point + usize.ONE
          }
        }
      }
      at = at + usize.ONE
    }
    if definitionWidth > usize.ZERO {
      at = usize.ZERO
      while at < pointCount {
        if heldLive(walker, chosen[index], liveOut, definitions, definitionWidth, at) {
          drop includeRegionPoint(&mut needed, at)
        }
        at = at + usize.ONE
      }
    }
    run unreachableAvailable(List<Point>.asSlice(&walker.points), loan.created, &mut own)
    let ownWords = List<u64>.asSlice(&own)
    let neededWords = List<u64>.asSlice(&needed)
    if !regionSourceFits(neededWords, ownWords) { return usize.MAX }
    // Incoming graph requirements can outlast this particular source instance. They constrain
    // its storage only while that instance can still inhabit a value; concrete release on every
    // creating path makes the source irrelevant there. Own uses were checked above, and the
    // release mask excludes their points, surviving holdings, parents and open-ended retention.
    // Keep every relation edge and requirement: other live sources still restrict the intersection.
    let released = run releasedLoanPoints(walker, chosen[index], definitions, definitionWidth, neededWords)
    mergeRegionSource(&mut required, &mut available, neededWords, ownWords, List<u64>.asSlice(&released))
    index = index + usize.ONE
  }
  let mut propagated = List<u64>.make()
  at = usize.ZERO
  while at < words {
    run List<u64>.append(&mut propagated, 0)
    at = at + usize.ONE
  }
  let position = List<RegionPoints>.length(&regions.*)
  run List<RegionPoints>.append(&mut regions.*, RegionPoints {region: Shared<Lifetime>.clone(region),
    required: move required, incoming: move propagated, available: move available})
  return position
}

// Own-source inclusion always precedes release: another loan's validity cannot satisfy it.
fn regionSourceFits(required: &[u64], available: &[u64]) -> bool {
  if required.length != available.length { return false }
  let mut word = usize.ZERO
  while word < required.length {
    if u64.bitAnd(required[word], u64.bitNot(available[word])) != 0 { return false }
    word = word + usize.ONE
  }
  return true
}

fn mergeRegionSource(required: &mut List<u64>, available: &mut List<u64>, needed: &[u64], own: &[u64], released: &[u64]) -> () {
  let mut all = List<u64>.asMutSlice(&available.*)
  let mut gathered = List<u64>.asMutSlice(&required.*)
  if all.length != gathered.length || needed.length != all.length || own.length != all.length || released.length != all.length
    || !regionSourceFits(needed, own) { CompilerBug.panic(b"region source must satisfy its own needs before release") }
  let mut word = usize.ZERO
  while word < all.length {
    all[word] = u64.bitAnd(all[word], u64.bitOr(own[word], released[word]))
    gathered[word] = u64.bitOr(gathered[word], needed[word])
    word = word + usize.ONE
  }
}

// Whether `loan` is an exact loan of storage the body owns: rooted in a local or a temporary's
// hidden owner, which ends with its statement, with no reference step and no parent region, so no
// reborrow of storage reached through a reference. A field store keeps its carriers exact
// (`LoanPrecision.Stored`), and what it borrows is unchanged.
fn ownedStorageLoan(loan: &Loan) -> bool {
  if loan.precision != LoanPrecision.Exact && loan.precision != LoanPrecision.Stored { return false }
  return ownedStoragePlace(loan)
}

fn ownedStoragePlace(loan: &Loan) -> bool {
  if !loan.local { return false }
  if let Option<Shared<Lifetime>>.Some {..} = &loan.parent { return false }
  let steps = List<Step>.asSlice(&loan.place.steps)
  let mut at = usize.ZERO
  while at < steps.length {
    if steps[at].kind == StepKind.Referent { return false }
    at = at + usize.ONE
  }
  return true
}

// Records a write, through a reference or into the local `holder`, whose target's type names a
// lifetime parameter of the body or a named enclosing declaration.
effect fn recordStore(walker: &mut Walker, owner: &DeclarationId, written: &Shared<Type>, span: Location, holder: usize) -> ()
! OutOfMemoryError ? &mut Allocator | &mut Types {
  if let Option<StoreWindow>.Some {value} = move run storeWindow(owner, written, span, holder) {
    run List<StoreWindow>.append(&mut walker.stores, move value)
  }
  return ()
}

// The window of a write at `span` whose target's type is `written`: the universal lifetime
// parameters that type names, or none when it names none.
effect fn storeWindow(owner: &DeclarationId, written: &Shared<Type>, span: Location, holder: usize) -> Option<StoreWindow>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut atoms = List<Shared<Lifetime>>.make()
  run Type.regionAtoms(written, &mut atoms)
  let mut regions = List<Shared<Lifetime>>.make()
  let named = List<Shared<Lifetime>>.asSlice(&atoms)
  let mut at = usize.ZERO
  while at < named.length {
    let parameter = Shared<Lifetime>.with<bool>(&named[at], fn(value: &Lifetime) -> bool {
      return match &value.* { Lifetime.Parameter {..} => true _ => false }
    })
    if parameter && regionDomain(&named[at], owner, List<Shared<Lifetime>>.asSlice(&regions)) == RegionDomain.Universal && !proofContains(List<Shared<Lifetime>>.asSlice(&regions), &named[at]) {
      run List<Shared<Lifetime>>.append(&mut regions, Shared<Lifetime>.clone(&named[at]))
    }
    at = at + usize.ONE
  }
  if List<Shared<Lifetime>>.length(&regions) == usize.ZERO { return Option<StoreWindow>.none() }
  return Option<StoreWindow>.some(StoreWindow {span: span, regions: move regions, holder: holder})
}

// The operand a `move` takes, or `id` itself.
fn movedOperand(nodes: &[Node], id: NodeId) -> NodeId {
  if let NodeKind.Expression {form: Expression.Move {value, ..}, ..} = &nodes[id.index].kind { return movedOperand(nodes, value) }
  return id
}

// Whether `listed` holds `local`.
fn listsLocal(listed: &[usize], local: usize) -> bool {
  let mut at = usize.ZERO
  while at < listed.length {
    if listed[at] == local { return true }
    at = at + usize.ONE
  }
  return false
}

// Whether a goal into `wanted`, admitted at `site`, belongs to a recorded write whose target's type
// names `wanted`: a write through a reference, or one into a local whose value a write through a
// reference stores; with `returned`, also a value a `return` stores in the caller's result slot. A local has one region, so every value written into it must outlive what the
// stored value must.
fn storedGoal<'proof>(sources: &EscapeSources<'proof>, wanted: &Shared<Lifetime>, site: Location, returned: bool) -> bool {
  if returned && windowGoal(sources, sources.returns, wanted, site)
    && !sealedSite(sources, sources.returns, site) { return true }
  return windowGoal(sources, sources.stores, wanted, site)
}

// Whether `site` lies in the operand of a call inside a returned value whose result can retain no
// region: what reaches that call, such as a borrow passed to an inner call whose region typing
// relates to the caller's but whose value only a length or a count reads, never reaches the
// returned value, so a goal admitted there is no requirement of the result slot. Only the innermost
// `return` holding the site decides: a `return` nested in the call's operand returns its own value,
// which the call's result never receives.
fn sealedSite<'proof>(sources: &EscapeSources<'proof>, windows: &[StoreWindow], site: Location) -> bool {
  let mut inner = usize.MAX
  let mut window = usize.ZERO
  while window < windows.length {
    if site.start >= windows[window].span.start && site.end <= windows[window].span.end
      && (inner == usize.MAX || (windows[window].span.start >= windows[inner].span.start
        && windows[window].span.end <= windows[inner].span.end)) {
      inner = window
    }
    window = window + usize.ONE
  }
  if inner == usize.MAX { return false }
  let returned = windows[inner].span
  let sealed = sources.sealed
  let mut at = usize.ZERO
  while at < sealed.length {
    if site.start >= sealed[at].start && site.end <= sealed[at].end
      && sealed[at].start >= returned.start && sealed[at].end <= returned.end { return true }
    at = at + usize.ONE
  }
  return false
}

// Whether one of `windows` admits a goal into `wanted` at `site` (`storedGoal`).
fn windowGoal<'proof>(sources: &EscapeSources<'proof>, windows: &[StoreWindow], wanted: &Shared<Lifetime>, site: Location) -> bool {
  let mut at = usize.ZERO
  while at < windows.length {
    if site.start >= windows[at].span.start && site.end <= windows[at].span.end
      && proofContains(List<Shared<Lifetime>>.asSlice(&windows[at].regions), wanted)
      && (windows[at].holder == usize.MAX || listsLocal(sources.escaping, windows[at].holder)) { return true }
    at = at + usize.ONE
  }
  return false
}

// The first loan of storage this body owns whose region the retained relations require to outlive
// a lifetime parameter of the body or a named enclosing declaration, or `usize.MAX`. The relations
// are the body's region goals: each offered region must outlive its wanted one. A seed is a goal
// admitted inside a write whose target's type names its single wanted parameter (`storedGoal`), or,
// with `returned`, inside a `return`: the value is stored in caller storage typed at that parameter,
// directly, as the caller's result, or through a local whose value is, so every atom of its offered side must outlive it. A goal into a single atom so required passes the requirement on to
// its offered atoms. Other goals are not seeds: a call's region binding need not be minimal, so a
// goal it admits into a universal region may be longer than any solution needs, and a goal into
// 'static may be an Effect environment that a run in this body uses only finitely. A goal into a
// meet requires only the meet, so it passes nothing on, and a provisional goal waiting on an
// inferred 'static is no requirement yet. A goal admitted inside an operand its call's result cannot
// hold (`unheldSite`) relates the operand only to the call's binder, which the callee's signature
// keeps apart from its result, so it is neither a seed nor passes a requirement on; a loan made
// there may be typed at that binder, so the result's requirements are none of its own. Owned storage
// ends with the body at the latest, so a loan of it so required is never valid.
effect fn escapingOwnedLoan<'proof>(sources: &EscapeSources<'proof>, owner: &DeclarationId, obligations: &[SafetyObligation], returned: bool) -> EscapeResult
! OutOfMemoryError ? &mut Allocator {
  let mut required = List<Shared<Lifetime>>.make()
  let mut changed = true
  while changed {
    changed = false
    let mut at = usize.ZERO
    while at < obligations.length {
      if let SafetyObligation.RegionRelation {origin, offered, wanted, inferredStatic} = &obligations[at] {
        let provisional = match &inferredStatic { Option<Shared<Lifetime>>.Some {..} => true _ => false }
        if !provisional && !unheldSite(sources, origin.location) && Lifetime.atomCount(&wanted) == usize.ONE
          && (storedGoal(sources, &wanted, origin.location, returned) || proofContains(List<Shared<Lifetime>>.asSlice(&required), &wanted)) {
          let count = Lifetime.atomCount(&offered)
          let mut atom = usize.ZERO
          while atom < count {
            let member = Lifetime.atomAt(&offered, atom)
            if regionLocal(&member, owner) && !proofContains(List<Shared<Lifetime>>.asSlice(&required), &member) {
              run List<Shared<Lifetime>>.append(&mut required, move member)
              changed = true
            }
            atom = atom + usize.ONE
          }
        }
      }
      at = at + usize.ONE
    }
  }
  let held = List<Shared<Lifetime>>.asSlice(&required)
  if held.length == usize.ZERO { return EscapeResult {loan: usize.MAX, unresolved: false} }
  let loans = sources.loans
  let mut unresolved = false
  let mut index = usize.ZERO
  while index < loans.length {
    let mut active = SourceTruth.True
    if let Option<&[SourceTruth]>.Some {value} = sources.activity {
      if value.length != loans.length { return CompilerBug.panic(b"escape refutation lost actual loan activity") }
      active = value[index]
    }
    if active == SourceTruth.False { index = index + usize.ONE continue }
    if ownedStorageLoan(&loans[index]) && !unheldSite(sources, loans[index].origin) {
      let regions = List<Shared<Lifetime>>.asSlice(&loans[index].regions)
      let mut at = usize.ZERO
      while at < regions.length {
        if proofContains(held, &regions[at]) {
          if active == SourceTruth.True { return EscapeResult {loan: index, unresolved: unresolved} }
          unresolved = true
        }
        at = at + usize.ONE
      }
    }
    index = index + usize.ONE
  }
  return EscapeResult {loan: usize.MAX, unresolved: unresolved}
}

enum RegionRelationStep { Satisfied, Finite, Unproved }

// The universal/captured/meet gates are shared by both staging callers. Finite returns only
// a request to the point-set proof, never a shortcut based on equal regions or equal masks.
effect fn regionRelationStep<'proof>(sources: &RegionSources<'proof>, owner: &DeclarationId,
  member: &Shared<Lifetime>, wanted: &Shared<Lifetime>, count: usize, premises: &[RegionBound],
  symbolic: &mut List<SymbolicRegion>) -> RegionRelationStep ! OutOfMemoryError ? &mut Allocator {
  let longer = regionDomain(member, owner, sources.supplied)
  if Lifetime.atomCount(wanted) > usize.ONE
    && (meetMember(wanted, member) || (longer == RegionDomain.Universal && meetHoldsLocal(wanted, owner))) {
    return RegionRelationStep.Satisfied
  }
  let shorter = regionDomain(wanted, owner, sources.supplied)
  if longer == RegionDomain.Local && shorter == RegionDomain.Universal {
    if !run symbolicRegionProved(sources, owner, member, wanted, premises, &mut symbolic.*) { return RegionRelationStep.Unproved }
  } else if shorter == RegionDomain.Local && (longer == RegionDomain.Universal
    || (longer == RegionDomain.Unknown && capturedFiniteSource(member, owner))) {
    // Captured locals remain Unknown for outward goals. Only this recorded finite use in
    // the nested invocation is covered; its enclosing construction still owns the capture.
  } else if longer == RegionDomain.Universal && shorter == RegionDomain.Universal {
    if !declaredRelationProved(member, wanted, count)
      && !run universalRegionProved(owner, sources.supplied, member, wanted, premises) { return RegionRelationStep.Unproved }
  } else { return RegionRelationStep.Finite }
  return RegionRelationStep.Satisfied
}

// Worklist edges point shorter -> longer (§4.3). Keeping a boundary's edge active everywhere
// over-approximates its location-sensitive requirements. Failed inclusions therefore stay pending
// until that finer proof exists; successful inclusions discharge the complete original relation.
effect fn recordRegionChoices(owner: &DeclarationId, obligations: &[SafetyObligation], storage: &mut RegionAvailability)
  -> bool ! OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < obligations.length {
    if let SafetyObligation.RegionChoice {origin, region} = &obligations[at] {
      if !Shared<Lifetime>.with<bool>(&region, fn(value: &Lifetime) -> bool {
        return match &value.* {
          Lifetime.Local {declaration, ordinal} => DeclarationId.equals(&declaration, owner) && ordinal == origin.node
          _ => false
        }
      }) { return false }
      if !proofContains(List<Shared<Lifetime>>.asSlice(&storage.choices), &region) {
        run List<Shared<Lifetime>>.append(&mut storage.choices, Shared<Lifetime>.clone(&region))
      }
    }
    at = at + usize.ONE
  }
  return true
}

effect fn localRelationsProved(walker: &Walker, owner: &DeclarationId, obligations: &[SafetyObligation],
  premises: &[RegionBound], symbolic: &mut List<SymbolicRegion>,
  liveOut: &[u64], definitions: &[u64], definitionWidth: usize, finiteCrossings: bool) -> bool
! OutOfMemoryError ? &mut Allocator {
  let loans = List<Loan>.asSlice(&walker.loans)
  let mut at = usize.ZERO
  while at < loans.length {
    if !provable(loans[at].precision) { return false }
    at = at + usize.ONE
  }
  let mut regions = List<RegionPoints>.make()
  let mut edges = List<RegionEdge>.make()
  let mut flow = emptyIntervalFlow()
  let mut storage = emptyRegionAvailability()
  if !run recordRegionChoices(owner, obligations, &mut storage) { return false }
  if finiteCrossings && !run finiteCrossingsProved(walker, owner, premises, &mut symbolic.*, liveOut,
    definitions, definitionWidth, &mut regions, &mut edges, &mut flow, &mut storage) { return false }
  at = usize.ZERO
  while at < obligations.length {
    match &obligations[at] {
      SafetyObligation.RegionRelation {offered, wanted, inferredStatic, ..} => {
        if let Option<Shared<Lifetime>>.Some {..} = &inferredStatic { return false }
        // A meet offers a lifetime only while every constituent offers it. Decompose only
        // this offered side; every constituent still needs its own provenance and finite proof.
        let count = Lifetime.atomCount(&offered)
        if count == usize.ZERO { return false }
        let mut atom = usize.ZERO
        while atom < count {
          let member = Lifetime.atomAt(&offered, atom)
          let step = run regionRelationStep(&regionSources(walker), owner, &member, &wanted, count, premises, &mut symbolic.*)
          if step == RegionRelationStep.Unproved { return false }
          if step == RegionRelationStep.Finite {
            let source = run regionPoints(walker, owner, &wanted, liveOut, definitions, definitionWidth, &mut regions, premises, &mut symbolic.*, &mut flow, &mut storage)
            let target = run regionPoints(walker, owner, &member, liveOut, definitions, definitionWidth, &mut regions, premises, &mut symbolic.*, &mut flow, &mut storage)
            if source == usize.MAX || target == usize.MAX { return false }
            run List<RegionEdge>.append(&mut edges, RegionEdge {shorter: source, longer: target})
          }
          atom = atom + usize.ONE
        }
      }
      SafetyObligation.Contents {origin, subject, region} => {
        if !finiteCaptureContents(owner, origin, &subject, &region) { return false }
      }
      SafetyObligation.UnprovedImpliedBound => { return false }
      _ => ()
    }
    at = at + usize.ONE
  }
  return run solveRegionRequirements(&mut regions, List<RegionEdge>.asSlice(&edges))
}

// A type chosen before this invocation cannot contain a region created inside it. This proves
// only the recorded finite capture use, never a declared Contents premise or an outward bound.
fn finiteCaptureContents(owner: &DeclarationId, origin: Origin, subject: &Shared<Type>, region: &Shared<Lifetime>) -> bool {
  let local = Shared<Lifetime>.with<bool>(region, fn(value: &Lifetime) -> bool {
    return match &value.* {
      Lifetime.Local {declaration, ordinal} => DeclarationId.equals(&declaration, owner) && ordinal == origin.node
      _ => false
    }
  })
  if !local { return false }
  return Shared<Type>.with<bool>(subject, fn(value: &Type) -> bool {
    return match &value.* {
      Type.Parameter {declaration, ..} => DeclarationId.equals(&declaration, owner) || namedEnclosing(&declaration, owner)
      _ => false
    }
  })
}

effect fn solveRegionRequirements(regions: &mut List<RegionPoints>, links: &[RegionEdge]) -> bool
! OutOfMemoryError ? &mut Allocator {
  // Each region's own requirement reaches every region that must outlive it. One that returns to its
  // origin through a cycle of relations, as two regions related both ways do, was already checked
  // loan by loan there; checking it again against every loan of the origin would refuse a loan
  // whose own validity ends before another loan of the same region is still needed.
  let count = List<RegionPoints>.length(&regions.*)
  let mut own = List<List<u64>>.make()
  let mut at = usize.ZERO
  while at < count {
    let entries = List<RegionPoints>.asSlice(&regions.*)
    let mut words = List<u64>.make()
    let required = List<u64>.asSlice(&entries[at].required)
    let mut word = usize.ZERO
    while word < required.length { run List<u64>.append(&mut words, required[word]) word = word + usize.ONE }
    run List<List<u64>>.append(&mut own, move words)
    at = at + usize.ONE
  }
  let mut origin = usize.ZERO
  while origin < count {
    let mut reached = List<bool>.make()
    at = usize.ZERO
    while at < count { run List<bool>.append(&mut reached, at == origin) at = at + usize.ONE }
    let mut queue = List<usize>.make()
    run List<usize>.append(&mut queue, origin)
    let mut next = usize.ZERO
    while next < List<usize>.length(&queue) {
      let source = List<usize>.asSlice(&queue)[next]
      let mut edge = usize.ZERO
      while edge < links.length {
        let link = links[edge]
        if link.shorter == source && link.longer < count && !List<bool>.asSlice(&reached)[link.longer] {
          let mut marked = List<bool>.asMutSlice(&mut reached)
          marked[link.longer] = true
          run List<usize>.append(&mut queue, link.longer)
        }
        edge = edge + usize.ONE
      }
      next = next + usize.ONE
    }
    let sourceWords = List<u64>.asSlice(&List<List<u64>>.asSlice(&own)[origin])
    let flags = List<bool>.asSlice(&reached)
    at = usize.ZERO
    while at < count {
      if at != origin && flags[at] {
        let mut entries = List<RegionPoints>.asMutSlice(&mut regions.*)
        let mut word = usize.ZERO
        while word < sourceWords.length {
          let mut words = List<u64>.asMutSlice(&mut entries[at].required)
          words[word] = u64.bitOr(words[word], sourceWords[word])
          let mut arrived = List<u64>.asMutSlice(&mut entries[at].incoming)
          arrived[word] = u64.bitOr(arrived[word], sourceWords[word])
          word = word + usize.ONE
        }
      }
      at = at + usize.ONE
    }
    origin = origin + usize.ONE
  }
  let solved = List<RegionPoints>.asSlice(&regions.*)
  at = usize.ZERO
  while at < solved.length {
    let arrivedWords = List<u64>.asSlice(&solved[at].incoming)
    let available = List<u64>.asSlice(&solved[at].available)
    let mut word = usize.ZERO
    while word < arrivedWords.length {
      if u64.bitAnd(arrivedWords[word], u64.bitNot(available[word])) != 0 { return false }
      word = word + usize.ONE
    }
    at = at + usize.ONE
  }
  return true
}

/// Whether every region a body's locals and values name is closed for this body: `'static`, a
/// universal region chosen before the body runs, or a loan region of the body itself, so its loans
/// and their scopes are the whole region proof.
///
/// # Details
///
/// Storage-end events prove local validity on every outgoing path. Reaching definitions and
/// backward liveness decide which holder loans are required; in-flight joins and cleanup use the
/// graph's actual paths. A referent loan crossing a boundary remains external to this local proof.
/// Universal regions are the lifetime parameters of this declaration and of every named declaration
/// enclosing it (an impl's parameters in a method, an enclosing function's in an anonymous body),
/// and an anonymous body's invocation binders. A local region of an enclosing named body is a capture
/// dependency: the enclosing body bounds its formation and retention with its own points, and
/// this body proves only its own uses (R3 amendment 4). Owned body storage cannot outlive the
/// body. An inferred region can satisfy a universal bound only through the separate symbolic
/// source proof; classifying its atoms here does not prove that bound. A callable contract's
/// invocation binders describe future calls, so a nested callable's own parameters are closed
/// wherever its value is held, as in an Effect application that carries it, and an invocation
/// region is closed where it occurs only inside the callables a type holds. A parent's binder in
/// an escaped child's contract is not the child's own and stays open. Exact callable lifetime and
/// row application arguments are selection metadata; Type.bodyRegionAtoms still checks their
/// contracts, captures and type evidence. A Supplied atom is closed only when it is one of
/// `supplied`, the body's own selected application regions; any other remains open. Callee
/// contracts and outside-body type parameters cannot smuggle in a fresh body-local region.
pub effect fn regionClosed(owner: &DeclarationId, supplied: &[Shared<Lifetime>], locals: &[Local], nodes: &[Node]) -> bool ! OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < locals.length {
    if !run typeRegionClosed(&locals[at].ty, owner, supplied) {
      return false
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < nodes.length {
    if let NodeKind.Expression {ty, ..} = &nodes[at].kind {
      if !run typeRegionClosed(&ty, owner, supplied) {
        return false
      }
    }
    at = at + usize.ONE
  }
  return true
}

// Whether `declaration` is a named declaration enclosing `owner`: an impl around a method, or the
// function around an anonymous body. An enclosing anonymous body's own binders and locals stay open,
// so a literal nested in another literal proves nothing about its enclosing literal.
fn namedEnclosing(declaration: &DeclarationId, owner: &DeclarationId) -> bool {
  let kind = DeclarationId.kind(declaration)
  return kind != OwnerKind.Anonymous && kind != OwnerKind.EffectBlock && DeclarationId.isPrefixOf(declaration, owner)
}

// Where a call can keep a loan one operand carries: `Local` also when the operand holds none of it.
fn keptSink(paths: &[List<Step>], loan: &Loan, owner: &DeclarationId, carry: Carry, sink: &OperandSink, located: &mut bool) -> CallSink {
  let origin = loan.origin
  // An operand whose type names only `'static` holds no loan of the body unless typing gave that
  // loan a `'static` region; one the walk carries into it otherwise is not part of its value.
  let regions = List<Shared<Lifetime>>.asSlice(&loan.regions)
  if !sink.holds && (regions.length == usize.ZERO || !staticRegions(&loan.regions)) { return CallSink.Local }
  let mut kept = sink.whole
  let mut approximate = sink.wholeApproximate
  let mut own = origin.start == sink.span.start && origin.end == sink.span.end
  if let Option<Shared<Lifetime>>.Some {value: region} = &sink.view {
    let typed = List<Shared<Lifetime>>.asSlice(&loan.regions)
    let mut at = usize.ZERO
    while !own && at < typed.length {
      own = Lifetime.equalsShared(&typed[at], &region)
      at = at + usize.ONE
    }
  }
  let mut positioned = false
  if own {
    kept = sink.outer
    approximate = sink.outerApproximate
  } else {
    positioned = narrowSlots(paths, carry, loan, sink, &mut kept, &mut approximate)
  }
  // A structural slot is the actual destination of this carried value after coercion. Without
  // that correspondence, local region names alone cannot establish a universal retention path.
  if !own && !positioned && kept == CallSink.Universal && typedLocally(&loan.regions, owner) { kept = CallSink.Unknown }
  // An approximate channel's universal region may be longer than any binding needs: only a loan
  // typing gave a universal region is held to it, and any other leaves the body unchecked.
  if kept != CallSink.Universal && approximate == CallSink.Universal {
    if universalRegions(&loan.regions, owner) {
      kept = CallSink.Universal
    } else {
      kept = CallSink.Unknown
    }
  } else if kept == CallSink.Local && approximate == CallSink.Unknown {
    kept = CallSink.Unknown
  }
  located.* = positioned || (own && carry.direct && carry.field == usize.ZERO)
  return kept
}

// Completed classifications and their actual-slot witnesses share carry order. Parent
// closure may promote a sink, but never manufactures a structural-slot witness.
struct RetainedSinks {
  sinks: List<CallSink>
  located: List<bool>
}

// Classifies operand retention without mutating loans. A reborrow keeps its parent's storage
// borrowed while it lives, so a loan of body storage
// that the parent regions of an escaping loan reach among those its operand carries escapes with
// it, wherever typing placed it. Any other loan that reaches a call this walk cannot describe keeps
// the body from being Checked; the walk goes on, so a definite conflict among exact loans, such as
// an escaping loan of body storage that ends, still rejects it. Each carry is judged by
// `sinks[only]`, or by its own operand's sink when `only` is `usize.MAX`; a carry with no sink is
// kept nowhere.
effect fn retainedSinks(loans: &[Loan], paths: &[List<Step>], owner: &DeclarationId, carries: &[Carry], sinks: &[OperandSink], only: usize) -> RetainedSinks
! OutOfMemoryError ? &mut Allocator {
  let mut kept = List<CallSink>.make()
  let mut escaping = List<usize>.make()
  let mut located = List<bool>.make()
  let mut at = usize.ZERO
  while at < carries.length {
    let mut operand = only
    if operand == usize.MAX { operand = carries[at].operand }
    let mut decided = CallSink.Local
    let mut exactSlot = false
    if operand < sinks.length { decided = keptSink(paths, &loans[carries[at].loan], owner, carries[at], &sinks[operand], &mut exactSlot) }
    run List<bool>.append(&mut located, exactSlot)
    run List<CallSink>.append(&mut kept, decided)
    if decided == CallSink.Universal { run List<usize>.append(&mut escaping, at) }
    at = at + usize.ONE
  }
  let mut reached = List<bool>.make()
  at = usize.ZERO
  while at < carries.length {
    run List<bool>.append(&mut reached, List<CallSink>.asSlice(&kept)[at] == CallSink.Universal)
    at = at + usize.ONE
  }
  let mut next = usize.ZERO
  while next < List<usize>.length(&escaping) {
    let child = List<usize>.asSlice(&escaping)[next]
    if let Option<Shared<Lifetime>>.Some {value: parent} = &loans[carries[child].loan].parent {
      at = usize.ZERO
      while at < carries.length {
        let seen = List<bool>.asSlice(&reached)[at]
        if !seen && (only != usize.MAX || carries[at].operand == carries[child].operand) {
          if let Option<Shared<Lifetime>>.Some {value: borrowed} = &loans[carries[at].loan].borrowed {
            if meetMember(&parent, &borrowed) {
              let mut marked = List<bool>.asMutSlice(&mut reached)
              marked[at] = true
              run List<usize>.append(&mut escaping, at)
              // Storage this body owns cannot outlive it. A reborrow through a reference keeps its
              // own judgment: the region proof bounds the caller storage it reaches.
              if loans[carries[at].loan].local {
                let mut decisions = List<CallSink>.asMutSlice(&mut kept)
                decisions[at] = CallSink.Universal
              }
            }
          }
        }
        at = at + usize.ONE
      }
    }
    next = next + usize.ONE
  }
  return RetainedSinks {sinks: move kept, located: move located}
}

// Apply the completed retention decision at the original call point, before result
// consumption/classification. Parent closure observes the pre-effect loan state; precise
// caller sources are validated later against the operand read's reaching definitions.
effect fn keepCarried(walker: &mut Walker, owner: &DeclarationId, carries: &[Carry], sinks: &[OperandSink], only: usize, point: usize) -> ()
! OutOfMemoryError ? &mut Allocator {
  let kept = run retainedSinks(List<Loan>.asSlice(&walker.loans), List<List<Step>>.asSlice(&walker.paths), owner, carries, sinks, only)
  let decisions = List<CallSink>.asSlice(&kept.sinks)
  let mut at = usize.ZERO
  while at < carries.length {
    if decisions[at] == CallSink.Universal {
      let mut all = List<Loan>.asMutSlice(&mut walker.loans)
      // Stored preserves exact source flow, but only a known actual signature slot authenticates
      // its retention beyond this point. Alternatives and Unknown never gain this evidence.
      if List<bool>.asSlice(&kept.located)[at] && carries[at].field != usize.MAX && point != usize.MAX
        && (all[carries[at].loan].precision == LoanPrecision.Exact || all[carries[at].loan].precision == LoanPrecision.Stored) {
        run List<CallerRetention>.append(&mut walker.callerRetentions, CallerRetention {
          loan: carries[at].loan, point: point, definition: carries[at].definition, read: carries[at].read})
      } else {
        all[carries[at].loan].escapes = true
      }
    } else if decisions[at] == CallSink.Unknown {
      walker.storing = true
    }
    at = at + usize.ONE
  }
  return ()
}

// A known value path identifies the slot carrying a loan even after region shortening or
// projection changes its referent type. Unknown paths retain the whole-operand judgment unless
// the reference's own type rules out a slot; opaque contents never establish an exact position.
fn narrowSlots(paths: &[List<Step>], carry: Carry, loan: &Loan, sink: &OperandSink, kept: &mut CallSink, approximate: &mut CallSink) -> bool {
  let slots = List<SlotSink>.asSlice(&sink.slots)
  if sink.undescribed || slots.length == usize.ZERO { return false }
  let mut occupied = false
  let mut positioned = false
  let mut uncertain = false
  let mut precise = CallSink.Local
  let mut wider = CallSink.Local
  let mut at = usize.ZERO
  while at < slots.length {
    let mut matched = SlotPath.Unknown
    if carry.field != usize.MAX {
      matched = transferSlotPath(List<Step>.asSlice(&paths[carry.field]), List<KeptStep>.asSlice(&slots[at].path), slots[at].view)
    }
    let mut fits = matched == SlotPath.Same
    if matched == SlotPath.Unknown {
      if !carry.direct { return false }
      if let Option<Shared<Type>>.Some {value: referent} = &loan.referent {
        fits = Type.mayHoldLoan(slots[at].view, &slots[at].referent, slots[at].exclusive, &referent, loan.exclusive)
      }
    }
    if fits {
      occupied = true
      if matched == SlotPath.Same && slots[at].view { positioned = true }
      if matched == SlotPath.Unknown || !slots[at].view { uncertain = true }
      let mut slotKept = slots[at].kept
      let mut slotApproximate = slots[at].approximate
      if !slots[at].view {
        slotKept = sink.whole
        slotApproximate = sink.wholeApproximate
      }
      precise = joinSinks(precise, slotKept)
      wider = joinSinks(wider, slotApproximate)
    }
    at = at + usize.ONE
  }
  if !occupied { return false }
  kept.* = precise
  approximate.* = wider
  return positioned && !uncertain
}

// The longer of two sinks: unknown over universal over local.
fn joinSinks(left: CallSink, right: CallSink) -> CallSink {
  if left == CallSink.Unknown || right == CallSink.Unknown { return CallSink.Unknown }
  if left == CallSink.Universal || right == CallSink.Universal { return CallSink.Universal }
  return CallSink.Local
}

// Whether a region atom is chosen before the body runs and outlives it: `'static`, or a lifetime
// parameter of the body or of a named declaration enclosing it.
fn universalAtom(region: &Lifetime, owner: &DeclarationId) -> bool {
  return match &region.* {
    Lifetime.Static => true
    Lifetime.Parameter {declaration, ..} => DeclarationId.equals(&declaration, owner) || namedEnclosing(&declaration, owner)
    _ => false
  }
}

// Whether any of `regions` outlives the body: an intersection does only when every member does.
fn universalRegions(regions: &List<Shared<Lifetime>>, owner: &DeclarationId) -> bool {
  let named = List<Shared<Lifetime>>.asSlice(regions)
  let mut at = usize.ZERO
  while at < named.length {
    if Lifetime.allAtoms(&named[at], fn(atom: &Lifetime) -> bool { return universalAtom(atom, owner) }) { return true }
    at = at + usize.ONE
  }
  return false
}

// Whether `value` names regions and every one of them is a lifetime parameter that outlives the
// body. A value typed at 'static keeps only what is valid for 'static, which a body loan never is.
effect fn universallyTyped(value: &Shared<Type>, owner: &DeclarationId) -> bool ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut atoms = List<Shared<Lifetime>>.make()
  run Type.regionAtoms(value, &mut atoms)
  let named = List<Shared<Lifetime>>.asSlice(&atoms)
  if named.length == usize.ZERO { return false }
  let mut at = usize.ZERO
  while at < named.length {
    let parameter = Shared<Lifetime>.with<bool>(&named[at], fn(atom: &Lifetime) -> bool {
      return match &atom.* { Lifetime.Parameter {..} => universalAtom(atom, owner) _ => false }
    })
    if !parameter { return false }
    at = at + usize.ONE
  }
  return true
}

// Whether typing gave a loan regions, none of which outlives the body.
fn typedLocally(regions: &List<Shared<Lifetime>>, owner: &DeclarationId) -> bool {
  return List<Shared<Lifetime>>.length(regions) != usize.ZERO && !universalRegions(regions, owner)
}

// Whether every one of `regions` is `'static`.
fn staticRegions(regions: &List<Shared<Lifetime>>) -> bool {
  let named = List<Shared<Lifetime>>.asSlice(regions)
  let mut at = usize.ZERO
  while at < named.length {
    if !Lifetime.allAtoms(&named[at], fn(atom: &Lifetime) -> bool { return match &atom.* { Lifetime.Static => true _ => false } }) { return false }
    at = at + usize.ONE
  }
  return true
}

// Where a call can keep an operand once it returns: in storage that outlives the caller's body, only
// within it, or somewhere this walk has no record to tell.
enum CallSink { Local, Universal, Unknown }

// What a call can keep of one operand (R3 amendment 4). `whole` answers for loans the operand
// carries in; `outer` answers for the loan the operand's own borrow creates, which the callee holds
// only as the reference it receives.
struct OperandSink {
  outer: CallSink
  whole: CallSink
  // Where a channel the analysis only approximates can also keep the operand (KeptRegions).
  outerApproximate: CallSink
  wholeApproximate: CallSink
  span: Location
  // Whether the operand's type can hold a loan of the body: it names a region other than `'static`
  // or a type parameter, or typing recorded none.
  holds: bool
  // The operand's own region when it is a view: a carried loan typed at it is the view's own borrow,
  // made earlier as when a call returns a view of its argument, so it is judged as `outer`.
  view: Option<Shared<Lifetime>>
  // Where the callee can keep a loan by where it lies in the operand (`KeptSlot`), or none.
  slots: List<SlotSink>
  // Whether the call could not describe the operand at all.
  undescribed: bool
}

// One `KeptSlot` of an operand: whether a loan can lie there and where the callee keeps it then. An
// opaque slot keeps a loan wherever the whole operand does.
struct SlotSink {
  path: List<KeptStep>
  view: bool
  referent: Shared<Type>
  exclusive: bool
  kept: CallSink
  approximate: CallSink
}

// An approximate channel's sink: unknown where the call could not describe the operand at all.
fn approximateSink(regions: &List<Shared<Lifetime>>, undescribed: bool, owner: &DeclarationId) -> CallSink {
  if undescribed { return CallSink.Unknown }
  return regionSink(regions, owner)
}

fn regionSink(regions: &List<Shared<Lifetime>>, owner: &DeclarationId) -> CallSink {
  if universalRegions(regions, owner) { return CallSink.Universal }
  return CallSink.Local
}

// What a call recorded it can keep of its operands, or none for a call this walk cannot see into.
// An immediate run walks as the call it executes.
fn callKept(nodes: &[Node], call: NodeId) -> Option<Shared<List<KeptRegions>>> {
  return match &nodes[call.index].kind {
    NodeKind.Expression {form: Expression.Run {value, access}, ..} => {
      if access == RunAccess.Immediate { return callKept(nodes, value) }
      return Option<Shared<List<KeptRegions>>>.none()
    }
    NodeKind.Expression {form: Expression.StagedCallable {retention, ..}, ..} => Option<Shared<List<KeptRegions>>>.some(Shared<List<KeptRegions>>.clone(&retention.kept))
    NodeKind.Expression {form: Expression.DirectCall {kept, ..}, ..} => Option<Shared<List<KeptRegions>>>.some(Shared<List<KeptRegions>>.clone(&kept))
    NodeKind.Expression {form: Expression.InterfaceCall {kept, ..}, ..} => Option<Shared<List<KeptRegions>>>.some(Shared<List<KeptRegions>>.clone(&kept))
    NodeKind.Expression {form: Expression.CallableCall {kept, ..}, ..} => Option<Shared<List<KeptRegions>>>.some(Shared<List<KeptRegions>>.clone(&kept))
    NodeKind.Expression {form: Expression.Aggregate {section, ..}, ..} => match &section {
      Option<SectionRetention>.Some {value} => Option<Shared<List<KeptRegions>>>.some(Shared<List<KeptRegions>>.clone(&value.kept))
      Option<SectionRetention>.None => Option<Shared<List<KeptRegions>>>.none()
    }
    _ => Option<Shared<List<KeptRegions>>>.none()
  }
}

effect fn operandSinks(nodes: &[Node], call: NodeId, arguments: &[NodeId], owner: &DeclarationId) -> List<OperandSink>
! OutOfMemoryError ? &mut Allocator {
  let mut sinks = List<OperandSink>.make()
  let recorded = callKept(nodes, call)
  // A call with no record, an intrinsic or foreign one, can keep an operand only in storage
  // another operand reaches, so it is undescribed only when some operand names a universal region
  // where it can store; a callable operand stores only where its contract's parameters reach. Its signature is fixed, and a loan of the body never has the body's type
  // parameter as its type.
  let mut reaches = false
  let mut at = usize.ZERO
  while at < arguments.length {
    let mut stored = List<Shared<Lifetime>>.make()
    if let Option<Shared<Type>>.Some {value} = move expressionType(nodes, arguments[at]) {
      run Type.callableStoredRegions(&value, &mut stored)
    }
    if universalRegions(&stored, owner) { reaches = true }
    at = at + usize.ONE
  }
  let mut unrecorded = CallSink.Local
  if reaches { unrecorded = CallSink.Unknown }
  at = usize.ZERO
  while at < arguments.length {
    // A stage captures a suffix of its selected signature. The base callable occupies value 0,
    // but is not a parameter of that signature and has no corresponding entry.
    let mut position = at
    if let NodeKind.Expression {form: Expression.StagedCallable {retention, ..}, ..} = &nodes[call.index].kind {
      position = usize.MAX
      if at != usize.ZERO { position = retention.first + at - usize.ONE }
    }
    if let NodeKind.Expression {form: Expression.Aggregate {section, ..}, ..} = &nodes[call.index].kind {
      if let Option<SectionRetention>.Some {value} = &section { position = value.first + at }
    }
    let span = nodes[arguments[at].index].origin.location
    let mut holds = true
    let mut view = Option<Shared<Lifetime>>.none()
    if let Option<Shared<Type>>.Some {value} = move expressionType(nodes, arguments[at]) {
      view = Type.viewRegion(&value)
      let mut named = List<Shared<Lifetime>>.make()
      run Type.regionAtoms(&value, &mut named)
      let generic = run Type.namesTypeParameter(&value)
      holds = generic || !staticRegions(&named)
    }
    let mut sink = OperandSink {outer: unrecorded, whole: unrecorded, outerApproximate: unrecorded, wholeApproximate: unrecorded,
      span: span, holds: holds, view: Option<Shared<Lifetime>>.none(), slots: List<SlotSink>.make(), undescribed: false}
    if let Option<Shared<List<KeptRegions>>>.Some {value: kept} = &recorded {
      let listed = Shared<List<KeptRegions>>.with<usize>(&kept, fn(values: &List<KeptRegions>) -> usize { return List<KeptRegions>.length(values) })
      if position < listed {
        sink = Shared<List<KeptRegions>>.with<OperandSink>(&kept, fn(values: &List<KeptRegions>) -> OperandSink {
          let entries = List<KeptRegions>.asSlice(values)
          return OperandSink {outer: regionSink(&entries[position].outer, owner), whole: regionSink(&entries[position].whole, owner),
            outerApproximate: approximateSink(&entries[position].outerApproximate, entries[position].undescribed, owner),
            wholeApproximate: approximateSink(&entries[position].wholeApproximate, entries[position].undescribed, owner),
            span: span, holds: holds, view: Option<Shared<Lifetime>>.none(), slots: List<SlotSink>.make(),
            undescribed: entries[position].undescribed}
        })
        let count = Shared<List<KeptRegions>>.with<usize>(&kept, fn(values: &List<KeptRegions>) -> usize {
          let entries = List<KeptRegions>.asSlice(values)
          return List<KeptSlot>.length(&entries[position].slots)
        })
        let mut index = usize.ZERO
        while index < count {
          let mut slot = Shared<List<KeptRegions>>.with<SlotSink>(&kept, fn(values: &List<KeptRegions>) -> SlotSink {
            let entries = List<KeptRegions>.asSlice(values)
            let listed = List<KeptSlot>.asSlice(&entries[position].slots)
            return SlotSink {path: List<KeptStep>.make(), view: listed[index].view, referent: Shared<Type>.clone(&listed[index].referent), exclusive: listed[index].exclusive,
              kept: regionSink(&listed[index].kept, owner), approximate: approximateSink(&listed[index].keptApproximate, entries[position].undescribed, owner)}
          })
          let length = Shared<List<KeptRegions>>.with<usize>(&kept, fn(values: &List<KeptRegions>) -> usize {
            return List<KeptStep>.length(&List<KeptSlot>.asSlice(&List<KeptRegions>.asSlice(values)[position].slots)[index].path)
          })
          let mut step = usize.ZERO
          while step < length {
            let value = Shared<List<KeptRegions>>.with<KeptStep>(&kept, fn(values: &List<KeptRegions>) -> KeptStep {
              return List<KeptStep>.asSlice(&List<KeptSlot>.asSlice(&List<KeptRegions>.asSlice(values)[position].slots)[index].path)[step]
            })
            run List<KeptStep>.append(&mut slot.path, value)
            step = step + usize.ONE
          }
          run List<SlotSink>.append(&mut sink.slots, move slot)
          index = index + usize.ONE
        }
      }
    }
    sink.view = move view
    run List<OperandSink>.append(&mut sinks, move sink)
    at = at + usize.ONE
  }
  return move sinks
}

// Whether any of `atoms` is an invocation region.
fn anyInvocationAtom(atoms: &[Shared<Lifetime>]) -> bool {
  let mut at = usize.ZERO
  while at < atoms.length {
    if Shared<Lifetime>.with<bool>(&atoms[at], fn(region: &Lifetime) -> bool { return match &region.* { Lifetime.Invocation {..} => true _ => false } }) { return true }
    at = at + usize.ONE
  }
  return false
}

// Whether `declaration` is one of the callable values a type holds (`Type.appendCallableTargets`).
fn namesTarget(targets: &[DeclarationId], declaration: &DeclarationId) -> bool {
  let mut at = usize.ZERO
  while at < targets.length {
    if DeclarationId.equals(&targets[at], declaration) { return true }
    at = at + usize.ONE
  }
  return false
}

effect fn typeRegionClosed(ty: &Shared<Type>, owner: &DeclarationId, supplied: &[Shared<Lifetime>]) -> bool ! OutOfMemoryError ? &mut Allocator {
  let mut atoms = List<Shared<Lifetime>>.make()
  run Type.bodyRegionAtoms(ty, &mut atoms)
  let listed = List<Shared<Lifetime>>.asSlice(&atoms)
  let kind = DeclarationId.kind(owner)
  let anonymous = kind == OwnerKind.Anonymous || kind == OwnerKind.EffectBlock
  let callable = Shared<Type>.with<bool>(ty, callableValue)
  let mut nested = List<DeclarationId>.make()
  run Type.appendCallableTargets(ty, &mut nested)
  let targets = List<DeclarationId>.asSlice(&nested)
  // An invocation region describes a callable's future calls only inside that callable: one the type
  // names outside every callable it holds is open.
  let mut outside = List<Shared<Lifetime>>.make()
  run Type.regionAtomsOutsideCallables(ty, &mut outside)
  let invocationOutside = anyInvocationAtom(List<Shared<Lifetime>>.asSlice(&outside))
  let mut at = usize.ZERO
  while at < listed.length {
    if suppliedAtom(&listed[at]) {
      if !proofContains(supplied, &listed[at]) { return false }
      at = at + usize.ONE
      continue
    }
    let closed = Shared<Lifetime>.with<bool>(&listed[at], fn(region: &Lifetime) -> bool {
      return match &region.* {
        Lifetime.Static => true
        Lifetime.Local {declaration, ..} => DeclarationId.equals(&declaration, owner) || namedEnclosing(&declaration, owner)
        Lifetime.Parameter {declaration, ..} => DeclarationId.isPrefixOf(&declaration, owner)
          || (callable && DeclarationId.isPrefixOf(owner, &declaration))
          || (DeclarationId.isPrefixOf(owner, &declaration) && namesTarget(targets, &declaration))
        Lifetime.Invocation {..} => anonymous || callable || !invocationOutside
        _ => false
      }
    })
    if !closed { return false }
    at = at + usize.ONE
  }
  return true
}


test effect fn regionWorklistPropagatesThroughCycles() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run regionWorklistClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn regionWorklistClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut regions = List<RegionPoints>.make()
  let mut at = usize.ZERO
  while at < 3 {
    let mut required = List<u64>.make()
    let mut available = List<u64>.make()
    let mut seed: u64 = 0
    let mut permitted: u64 = 2
    if at == 2 { seed = 2 }
    if at == usize.ZERO { permitted = 0 }
    let mut propagated = List<u64>.make()
    run List<u64>.append(&mut required, seed)
    run List<u64>.append(&mut propagated, 0)
    run List<u64>.append(&mut available, permitted)
    // The set solver uses opaque region indices; domain authentication is tested by source Cases.
    run List<RegionPoints>.append(&mut regions, RegionPoints {
      region: run Shared<Lifetime>.make(Lifetime.Invocation {ordinal: at}), required: move required, incoming: move propagated,
      available: move available})
    at = at + usize.ONE
  }
  let mut edges = List<RegionEdge>.make()
  run List<RegionEdge>.append(&mut edges, RegionEdge {shorter: 1, longer: 0})
  run List<RegionEdge>.append(&mut edges, RegionEdge {shorter: 2, longer: 1})
  run List<RegionEdge>.append(&mut edges, RegionEdge {shorter: 1, longer: 2})
  let impossible = run solveRegionRequirements(&mut regions, List<RegionEdge>.asSlice(&edges))
  run Testing.expect(!impossible, "a required point reaches an unavailable region through a transitive cycle")
  let solved = List<RegionPoints>.asSlice(&regions)
  let first = List<u64>.asSlice(&solved[usize.ZERO].required)
  let required = first[usize.ZERO]
  run Testing.expect(required == 2, "requirements propagate from shorter to longer even after its first queue visit")
  let mut entries = List<RegionPoints>.asMutSlice(&mut regions)
  let mut permitted = List<u64>.asMutSlice(&mut entries[usize.ZERO].available)
  permitted[usize.ZERO] = 2
  let possible = run solveRegionRequirements(&mut regions, List<RegionEdge>.asSlice(&edges))
  run Testing.expect(possible, "the same obligations are proved when all propagated points are available")

  // A's own seed was checked loan by loan: returning through A <-> B must not
  // check it against A's aggregate availability. A foreign seed still must fit.
  // Each solve mutates required/incoming, so the two controls start from fresh state.
  let mut foreign = usize.ZERO
  while foreign < 2 {
    let mut cycle = List<RegionPoints>.make()
    let mut region = usize.ZERO
    while region < 2 {
      let mut seed: u64 = 2
      let mut permitted: u64 = 0
      if region == usize.ONE {
        seed = 0
        if foreign == usize.ONE { seed = 4 }
        permitted = 2
      }
      let mut required = List<u64>.make()
      let mut incoming = List<u64>.make()
      let mut available = List<u64>.make()
      run List<u64>.append(&mut required, seed)
      run List<u64>.append(&mut incoming, 0)
      run List<u64>.append(&mut available, permitted)
      run List<RegionPoints>.append(&mut cycle, RegionPoints {
        region: run Shared<Lifetime>.make(Lifetime.Invocation {ordinal: region}),
        required: move required, incoming: move incoming, available: move available})
      region = region + usize.ONE
    }
    let mut relations = List<RegionEdge>.make()
    run List<RegionEdge>.append(&mut relations, RegionEdge {shorter: 0, longer: 1})
    run List<RegionEdge>.append(&mut relations, RegionEdge {shorter: 1, longer: 0})
    let proved = run solveRegionRequirements(&mut cycle, List<RegionEdge>.asSlice(&relations))
    if foreign == usize.ZERO {
      run Testing.expect(proved, "a region's own requirement cannot invalidate it by returning through a cycle")
    } else {
      run Testing.expect(!proved, "a foreign requirement still fails when the cycle reaches an unavailable point")
    }
    foreign = foreign + usize.ONE
  }
  return ()
}

test effect fn regionWrappedIntervalRequiresLiveHolderPoints() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run wrappedRegionClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn wrappedRegionClaims() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let module = run ModuleId.make(b"test", b"r3", b"loop.silk")
  let owner = run DeclarationId.fromParts(move module, List<OwnerStep>.make())
  let region = run Shared<Lifetime>.make(Lifetime.Local {declaration: DeclarationId.copy(&owner), ordinal: 0})
  let mut walker = Walker {
    callerRetentions: List<CallerRetention>.make(),
    unrun: List<bool>.make(), points: List<Point>.make(), loans: List<Loan>.make(), events: List<Event>.make(),
    frames: List<Frame>.make(), loops: List<Loop>.make(), held: List<List<usize>>.make(),
    definitions: List<Holding>.make(), holdingSources: List<HoldingSource>.make(), scopes: List<Scope>.make(), localCount: 1,
    cleanup: List<LoanCleanup>.make(), loopCleanup: List<LoopCleanup>.make(), exit: 0, entry: 1,
    outside: false, reason: BorrowStatus.Regions, guarded: List<usize>.make(),
    guardConsumed: Option<Location>.none(), retention: Retention.None, requirements: List<RetentionEdge>.make(),
    settled: true, retentionRelations: List<ImpliedGroup>.make(), wholeHolds: List<WholeHold>.make(), openContents: List<Shared<Lifetime>>.make(), unretained: List<usize>.make(), contested: List<Shared<Lifetime>>.make(), storing: false, inherited: BorrowStatus.Checked, storable: List<usize>.make(),
    refinements: List<Refinement>.make(), lexicalHolders: List<usize>.make(),
    paths: List<List<Step>>.make(),
    stores: List<StoreWindow>.make(),
    returns: List<StoreWindow>.make(),
    sealed: List<Location>.make(),
    unheld: List<Location>.make(),
    escaping: List<usize>.make(),
    supplied: List<Shared<Lifetime>>.make(),
  }
  run List<List<Step>>.append(&mut walker.paths, List<Step>.make())
  let mut at = usize.ZERO
  while at < 5 { drop run newPoint(&mut walker, usize.MAX) at = at + 1 }
  run edge(&mut walker, 1, 2)
  run edge(&mut walker, 2, 3)
  run edge(&mut walker, 3, 4)
  run edge(&mut walker, 4, 2)
  run edge(&mut walker, 4, 0)
  let mut intervals = List<Interval>.make()
  run List<Interval>.append(&mut intervals, Interval {from: 4, to: 2, definition: 0, read: 2, cleanup: false})
  let mut named = List<Shared<Lifetime>>.make()
  run List<Shared<Lifetime>>.append(&mut named, Shared<Lifetime>.clone(&region))
  run List<Loan>.append(&mut walker.loans, Loan {
    place: Place {root: 0, steps: List<Step>.make()}, exclusive: false,
    origin: Location.make(0, 1), intervals: move intervals, precision: LoanPrecision.Exact,
    regions: move named, local: true, borrowed: Option<Shared<Lifetime>>.some(Shared<Lifetime>.clone(&region)),
    parent: Option<Shared<Lifetime>>.none(), crossed: false, created: 1, escapes: false, binder: usize.MAX, block: usize.MAX, until: usize.MAX,
    referent: Option<Shared<Type>>.none(), bound: false,
  })
  run List<Holding>.append(&mut walker.definitions, Holding {loan: 0, holder: 0, point: 4, sources: usize.ZERO, sourceCount: usize.ZERO, field: usize.MAX, direct: false,
    shadowed: false, inherited: false})
  // A definition created at the bottom of the loop reaches the next header read. There is no
  // numeric interior in [4, 2]; only heldLive supplies points 2 and 3 to the region requirement.
  let mut definitions = List<u64>.make()
  let mut live = List<u64>.make()
  at = usize.ZERO
  while at < 5 {
    let mut present: u64 = 0
    if at == 2 || at == 3 { present = 1 }
    run List<u64>.append(&mut definitions, present)
    run List<u64>.append(&mut live, present)
    at = at + 1
  }
  let mut regions = List<RegionPoints>.make()
  let premises = List<RegionBound>.make()
  let mut symbolic = List<SymbolicRegion>.make()
  let mut flow = emptyIntervalFlow()
  let mut storage = emptyRegionAvailability()
  let found = run regionPoints(&walker, &owner, &region, 
    List<u64>.asSlice(&live), List<u64>.asSlice(&definitions), 1, &mut regions,
    List<RegionBound>.asSlice(&premises), &mut symbolic, &mut flow, &mut storage)
  run Testing.expect(found != usize.MAX, "the exact loop holder has available storage")
  let entries = List<RegionPoints>.asSlice(&regions)
  let required = List<u64>.asSlice(&entries[found].required)
  run Testing.expect(u64.bitAnd(required[0], 12) == 12,
    "wrapped intervals retain their back-edge holder points; removing heldLive loses this requirement")
  return ()
}

test effect fn symbolicRegionRootsRequireEveryParent() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run symbolicRootClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn symbolicTestLoan(region: &Shared<Lifetime>, parent: &Shared<Lifetime>, local: bool) -> Loan
! OutOfMemoryError ? &mut Allocator {
  let mut regions = List<Shared<Lifetime>>.make()
  run List<Shared<Lifetime>>.append(&mut regions, Shared<Lifetime>.clone(region))
  return Loan {place: Place {root: 0, steps: List<Step>.make()}, exclusive: false,
    origin: Location.make(0, 1), intervals: List<Interval>.make(), precision: LoanPrecision.Exact,
    regions: move regions, local: local, borrowed: Option<Shared<Lifetime>>.some(Shared<Lifetime>.clone(region)),
    parent: Option<Shared<Lifetime>>.some(Shared<Lifetime>.clone(parent)), crossed: true, created: 1, escapes: false, binder: usize.MAX, block: usize.MAX, until: usize.MAX,
    referent: Option<Shared<Type>>.none(), bound: false}
}

effect fn symbolicRootClaims() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let module = run ModuleId.make(b"test", b"r3", b"symbolic.silk")
  let mut owners = List<OwnerStep>.make()
  run List<OwnerStep>.append(&mut owners, OwnerStep {kind: OwnerKind.Function,
    name: Option<Bytes>.some(run Bytes.copy(b"caller")), occurrence: 0})
  let owner = run DeclarationId.fromParts(move module, move owners)
  let first = run Shared<Lifetime>.make(Lifetime.Local {declaration: DeclarationId.copy(&owner), ordinal: 0})
  let second = run Shared<Lifetime>.make(Lifetime.Local {declaration: DeclarationId.copy(&owner), ordinal: 1})
  let a = run Shared<Lifetime>.make(Lifetime.Parameter {declaration: DeclarationId.copy(&owner), ordinal: 0})
  let b = run Shared<Lifetime>.make(Lifetime.Parameter {declaration: DeclarationId.copy(&owner), ordinal: 1})
  let mut walker = Walker {
    callerRetentions: List<CallerRetention>.make(),
    unrun: List<bool>.make(), points: List<Point>.make(), loans: List<Loan>.make(), events: List<Event>.make(),
    frames: List<Frame>.make(), loops: List<Loop>.make(), held: List<List<usize>>.make(),
    definitions: List<Holding>.make(), holdingSources: List<HoldingSource>.make(), scopes: List<Scope>.make(), localCount: 1,
    cleanup: List<LoanCleanup>.make(), loopCleanup: List<LoopCleanup>.make(), exit: 0, entry: 1,
    outside: false, reason: BorrowStatus.Regions, guarded: List<usize>.make(),
    guardConsumed: Option<Location>.none(), retention: Retention.None, requirements: List<RetentionEdge>.make(),
    settled: true, retentionRelations: List<ImpliedGroup>.make(), wholeHolds: List<WholeHold>.make(), openContents: List<Shared<Lifetime>>.make(), unretained: List<usize>.make(), contested: List<Shared<Lifetime>>.make(), storing: false, inherited: BorrowStatus.Checked, storable: List<usize>.make(),
    refinements: List<Refinement>.make(), lexicalHolders: List<usize>.make(),
    paths: List<List<Step>>.make(),
    stores: List<StoreWindow>.make(),
    returns: List<StoreWindow>.make(),
    sealed: List<Location>.make(),
    unheld: List<Location>.make(),
    escaping: List<usize>.make(),
    supplied: List<Shared<Lifetime>>.make(),
  }
  run List<List<Step>>.append(&mut walker.paths, List<Step>.make())
  let premises = List<RegionBound>.make()
  run List<Loan>.append(&mut walker.loans, run symbolicTestLoan(&first, &second, false))
  run List<Loan>.append(&mut walker.loans, run symbolicTestLoan(&second, &first, false))
  let mut cache = List<SymbolicRegion>.make()
  run Testing.expect(!run symbolicRegionProved(&regionSources(&walker), &owner, &first, &a, List<RegionBound>.asSlice(&premises), &mut cache),
    "an ungrounded reborrow cycle cannot establish a caller lifetime")
  run List<Loan>.append(&mut walker.loans, run symbolicTestLoan(&second, &a, false))
  cache = List<SymbolicRegion>.make()
  run Testing.expect(run symbolicRegionProved(&regionSources(&walker), &owner, &first, &a, List<RegionBound>.asSlice(&premises), &mut cache),
    "a reborrow cycle is proved when every branch stays grounded in the matching universal parent")
  // Reservation may name a root that never acquired a loan. Its stable ID is not proof.
  let mut activity = List<SourceTruth>.make()
  run List<SourceTruth>.append(&mut activity, SourceTruth.True)
  run List<SourceTruth>.append(&mut activity, SourceTruth.True)
  run List<SourceTruth>.append(&mut activity, SourceTruth.False)
  {
    let mut reserved = regionSources(&walker)
    reserved.activity = Option<&[SourceTruth]>.some(List<SourceTruth>.asSlice(&activity))
    cache = List<SymbolicRegion>.make()
    run Testing.expect(!run symbolicRegionProved(&reserved, &owner, &first, &a, List<RegionBound>.asSlice(&premises), &mut cache),
      "an unreachable reserved acquisition cannot ground an otherwise cyclic parent graph")
    let mut roots = List<SymbolicRoot>.make()
    drop run symbolicRootIndex(&mut roots, &first)
    run Testing.expect(!run finiteParentRoots(&reserved, &owner, &mut roots),
      "the finite parent graph also excludes an unreachable grounding acquisition")
  }
  let mut states = List<SourceTruth>.asMutSlice(&mut activity)
  states[2] = SourceTruth.Undefined
  {
    let mut reserved = regionSources(&walker)
    reserved.activity = Option<&[SourceTruth]>.some(List<SourceTruth>.asSlice(&activity))
    cache = List<SymbolicRegion>.make()
    run Testing.expect(!run symbolicRegionProved(&reserved, &owner, &first, &a, List<RegionBound>.asSlice(&premises), &mut cache),
      "unresolved acquisition activity supplies no universal parent proof")
  }
  let mut alternatives = List<Loan>.asMutSlice(&mut walker.loans)
  alternatives[2].precision = LoanPrecision.Alternatives
  cache = List<SymbolicRegion>.make()
  run Testing.expect(run symbolicRegionProved(&regionSources(&walker), &owner, &first, &a, List<RegionBound>.asSlice(&premises), &mut cache),
    "a complete possible-source union proves a bound only through all of its roots")
  let mut unresolved = List<Loan>.asMutSlice(&mut walker.loans)
  unresolved[2].precision = LoanPrecision.Unknown
  cache = List<SymbolicRegion>.make()
  run Testing.expect(!run symbolicRegionProved(&regionSources(&walker), &owner, &first, &a, List<RegionBound>.asSlice(&premises), &mut cache),
    "unknown retention cannot acquire a proof from another complete branch")
  let mut exact = List<Loan>.asMutSlice(&mut walker.loans)
  exact[2].precision = LoanPrecision.Exact
  cache = List<SymbolicRegion>.make()
  run Testing.expect(!run symbolicRegionProved(&regionSources(&walker), &owner, &first, &b, List<RegionBound>.asSlice(&premises), &mut cache),
    "a cached proof for one universal does not prove another universal")
  run List<Loan>.append(&mut walker.loans, run symbolicTestLoan(&first, &b, false))
  cache = List<SymbolicRegion>.make()
  run Testing.expect(!run symbolicRegionProved(&regionSources(&walker), &owner, &first, &a, List<RegionBound>.asSlice(&premises), &mut cache),
    "every loan sharing an inference region must have a sufficient parent")
  let mut activeRoot = List<SourceTruth>.asMutSlice(&mut activity)
  activeRoot[2] = SourceTruth.True
  run List<SourceTruth>.append(&mut activity, SourceTruth.False)
  {
    let mut reserved = regionSources(&walker)
    reserved.activity = Option<&[SourceTruth]>.some(List<SourceTruth>.asSlice(&activity))
    cache = List<SymbolicRegion>.make()
    run Testing.expect(run symbolicRegionProved(&reserved, &owner, &first, &a, List<RegionBound>.asSlice(&premises), &mut cache),
      "an unreachable contradictory sibling is excluded without renumbering the active root")
    let chain = run unretainedChain(&reserved, &owner, 0)
    run Testing.expect(!chain.unresolved && !listsIndex(List<usize>.asSlice(&chain.loans), 3)
      && !proofContains(List<Shared<Lifetime>>.asSlice(&chain.regions), &b),
      "an unreachable sibling cannot add its foreign parent to a dropped loan's contested provenance")
  }
  let mut possibleSibling = List<SourceTruth>.asMutSlice(&mut activity)
  possibleSibling[3] = SourceTruth.Undefined
  {
    let mut reserved = regionSources(&walker)
    reserved.activity = Option<&[SourceTruth]>.some(List<SourceTruth>.asSlice(&activity))
    cache = List<SymbolicRegion>.make()
    run Testing.expect(!run symbolicRegionProved(&reserved, &owner, &first, &a, List<RegionBound>.asSlice(&premises), &mut cache),
      "a possible contradictory sibling is an unresolved obligation, not an absent source")
    let chain = run unretainedChain(&reserved, &owner, 0)
    run Testing.expect(chain.unresolved,
      "a dropped-source chain retains the unresolved activity of a possible ancestor")
  }
  let mut changed = List<Loan>.asMutSlice(&mut walker.loans)
  changed[3].parent = Option<Shared<Lifetime>>.some(Shared<Lifetime>.clone(&a))
  cache = List<SymbolicRegion>.make()
  run Testing.expect(run symbolicRegionProved(&regionSources(&walker), &owner, &first, &a, List<RegionBound>.asSlice(&premises), &mut cache),
    "a shared region is proved when every one of its parents reaches the requested universal")
  let mut owned = List<Loan>.asMutSlice(&mut walker.loans)
  owned[3].local = true
  cache = List<SymbolicRegion>.make()
  run Testing.expect(!run symbolicRegionProved(&regionSources(&walker), &owner, &first, &a, List<RegionBound>.asSlice(&premises), &mut cache),
    "owned storage cannot acquire a universal validity bound from a named parent")
  let mut restored = List<Loan>.asMutSlice(&mut walker.loans)
  restored[3].local = false
  let third = run Shared<Lifetime>.make(Lifetime.Local {declaration: DeclarationId.copy(&owner), ordinal: 2})
  run List<Loan>.append(&mut walker.loans, run symbolicTestLoan(&first, &third, false))
  run List<Loan>.append(&mut walker.loans, run symbolicTestLoan(&third, &third, false))
  cache = List<SymbolicRegion>.make()
  run Testing.expect(!run symbolicRegionProved(&regionSources(&walker), &owner, &first, &a, List<RegionBound>.asSlice(&premises), &mut cache),
    "a grounded branch cannot justify another branch that ends in an ungrounded cycle")
  return ()
}


test effect fn retainedParentClosureUsesActualBorrowProvenance() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run retainedParentClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn retainedParentClaims() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let module = run ModuleId.make(b"test", b"r3", b"retained-parent.silk")
  let mut owners = List<OwnerStep>.make()
  run List<OwnerStep>.append(&mut owners, OwnerStep {kind: OwnerKind.Function,
    name: Option<Bytes>.some(run Bytes.copy(b"caller")), occurrence: 0})
  let owner = run DeclarationId.fromParts(move module, move owners)
  let a = run Shared<Lifetime>.make(Lifetime.Local {declaration: DeclarationId.copy(&owner), ordinal: 0})
  let b = run Shared<Lifetime>.make(Lifetime.Local {declaration: DeclarationId.copy(&owner), ordinal: 1})
  let c = run Shared<Lifetime>.make(Lifetime.Local {declaration: DeclarationId.copy(&owner), ordinal: 2})
  let universal = run Shared<Lifetime>.make(Lifetime.Parameter {declaration: DeclarationId.copy(&owner), ordinal: 0})
  let mut loans = List<Loan>.make()
  run List<Loan>.append(&mut loans, run symbolicTestLoan(&a, &universal, false))
  let mut shelf = run symbolicTestLoan(&b, &universal, true)
  shelf.parent = Option<Shared<Lifetime>>.none()
  run List<Shared<Lifetime>>.append(&mut shelf.regions, Shared<Lifetime>.clone(&a))
  run List<Loan>.append(&mut loans, move shelf)
  run List<Loan>.append(&mut loans, run symbolicTestLoan(&c, &a, false))
  run List<Loan>.append(&mut loans, run symbolicTestLoan(&a, &universal, false))
  let mut carried = List<Carry>.make()
  let mut at = usize.ZERO
  while at < 4 {
    run List<Carry>.append(&mut carried, Carry {loan: at, since: 0, operand: at,
      definition: usize.MAX, read: usize.MAX, field: usize.MAX, direct: false})
    at = at + usize.ONE
  }
  let mut result = List<Shared<Lifetime>>.make()
  run List<Shared<Lifetime>>.append(&mut result, Shared<Lifetime>.clone(&b))
  let owned = run retainedParents(List<Loan>.asSlice(&loans), List<Carry>.asSlice(&carried),
    List<Shared<Lifetime>>.asSlice(&result))
  let included = List<bool>.asSlice(&owned)
  run Testing.expect(!included[0] && included[1] && !included[2] && !included[3],
    "an owned outer borrow's retained inner atom is not an actual parent edge (Shelf guard)")
  result = List<Shared<Lifetime>>.make()
  run List<Shared<Lifetime>>.append(&mut result, Shared<Lifetime>.clone(&c))
  let child = run retainedParents(List<Loan>.asSlice(&loans), List<Carry>.asSlice(&carried),
    List<Shared<Lifetime>>.asSlice(&result))
  let ancestors = List<bool>.asSlice(&child)
  run Testing.expect(ancestors[0] && !ancestors[1] && ancestors[2] && ancestors[3],
    "every carried source sharing the actual parent atom remains in the possible-source union")
  return ()
}


test effect fn capturedFiniteSourcesAuthenticateExactDirectOwners() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run capturedFiniteOwnerClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn capturedTestOwner(path: &[u8], depth: usize) -> DeclarationId
! InvalidModulePath | OutOfMemoryError ? &mut Allocator {
  let module = run ModuleId.make(b"test", b"r3", path)
  let mut owners = List<OwnerStep>.make()
  run List<OwnerStep>.append(&mut owners, OwnerStep {kind: OwnerKind.Function,
    name: Option<Bytes>.some(run Bytes.copy(b"sameName")), occurrence: usize.ZERO})
  let mut at = usize.ZERO
  while at < depth {
    run List<OwnerStep>.append(&mut owners, OwnerStep {kind: OwnerKind.Anonymous,
      name: Option<Bytes>.none(), occurrence: usize.ZERO})
    at = at + usize.ONE
  }
  return run DeclarationId.fromParts(move module, move owners)
}

effect fn capturedFiniteOwnerClaims() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let owner = run capturedTestOwner(b"capture.silk", usize.ZERO)
  let child = run capturedTestOwner(b"capture.silk", usize.ONE)
  let grandchild = run capturedTestOwner(b"capture.silk", 2)
  let foreign = run capturedTestOwner(b"other.silk", usize.ZERO)
  let local = run Shared<Lifetime>.make(Lifetime.Local {declaration: DeclarationId.copy(&owner), ordinal: 0})
  let unrelated = run Shared<Lifetime>.make(Lifetime.Local {declaration: move foreign, ordinal: 0})
  let nested = run Shared<Lifetime>.make(Lifetime.Local {declaration: DeclarationId.copy(&child), ordinal: 0})
  run Testing.expect(capturedFiniteSource(&local, &child),
    "the direct enclosing named function authenticates its captured local")
  run Testing.expect(!capturedFiniteSource(&unrelated, &child),
    "a same-spelled function and local ordinal in another module are not the captured source")
  run Testing.expect(!capturedFiniteSource(&local, &grandchild) && !capturedFiniteSource(&nested, &grandchild),
    "unsupported anonymous-in-anonymous nesting cannot inherit a finite-source witness")
  run Testing.expect(regionDomain(&local, &child, List<Shared<Lifetime>>.asSlice(&List<Shared<Lifetime>>.make())) == RegionDomain.Unknown,
    "finite capture coverage is directional and never a universal lifetime classification")
  return ()
}

test effect fn suppliedRegionsAreUniversalOnlyWhenTheBodysOwn() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run suppliedRegionClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn suppliedRegionClaims() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let owner = run capturedTestOwner(b"supplied.silk", usize.ZERO)
  let own = run Shared<Lifetime>.make(Lifetime.Supplied {ordinal: 0})
  let other = run Shared<Lifetime>.make(Lifetime.Supplied {ordinal: 1})
  let declared = run Shared<Lifetime>.make(Lifetime.Parameter {declaration: DeclarationId.copy(&owner), ordinal: 0})
  let alsoDeclared = run Shared<Lifetime>.make(Lifetime.Parameter {declaration: DeclarationId.copy(&owner), ordinal: 1})
  let forever = run Shared<Lifetime>.make(Lifetime.Static)
  let mut supplied = List<Shared<Lifetime>>.make()
  run List<Shared<Lifetime>>.append(&mut supplied, Shared<Lifetime>.clone(&own))
  let listed = List<Shared<Lifetime>>.asSlice(&supplied)
  let none = List<Shared<Lifetime>>.make()
  run Testing.expect(regionDomain(&own, &owner, listed) == RegionDomain.Universal
    && regionDomain(&other, &owner, listed) == RegionDomain.Unknown
    && regionDomain(&own, &owner, List<Shared<Lifetime>>.asSlice(&none)) == RegionDomain.Unknown,
    "only a Supplied atom of the body's own application is universal; any other numbering stays unknown")
  run Testing.expect(declaredRelationProved(&declared, &alsoDeclared, usize.ONE)
    && !declaredRelationProved(&own, &declared, usize.ONE) && !declaredRelationProved(&declared, &own, usize.ONE)
    && !declaredRelationProved(&declared, &alsoDeclared, 2),
    "the declared-region check proves neither a Supplied side nor a meet constituent")
  let mut both = List<Shared<Lifetime>>.make()
  run List<Shared<Lifetime>>.append(&mut both, Shared<Lifetime>.clone(&own))
  run List<Shared<Lifetime>>.append(&mut both, Shared<Lifetime>.clone(&other))
  let bothListed = List<Shared<Lifetime>>.asSlice(&both)
  let mut premises = List<RegionBound>.make()
  run List<RegionBound>.append(&mut premises, RegionBound {longer: Shared<Lifetime>.clone(&declared), shorter: Shared<Lifetime>.clone(&alsoDeclared)})
  let bounds = List<RegionBound>.asSlice(&premises)
  let itself = run universalRegionProved(&owner, bothListed, &own, &own, bounds)
  let fromStatic = run universalRegionProved(&owner, bothListed, &forever, &own, bounds)
  let toOther = run universalRegionProved(&owner, bothListed, &own, &other, bounds)
  let toStatic = run universalRegionProved(&owner, bothListed, &own, &forever, bounds)
  let toDeclared = run universalRegionProved(&owner, bothListed, &own, &declared, bounds)
  run Testing.expect(itself && fromStatic && !toOther && !toStatic && !toDeclared,
    "a Supplied region outlives only itself: no premise relates it to another Supplied, 'static or a declared region")
  return ()
}

test effect fn requiredRetentionKeepsNamespacesAndOuterLoansDistinct() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run requiredRetentionClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn requiredRetentionClaims() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let module = run ModuleId.make(b"test", b"r3", b"requirements.silk")
  let owner = run DeclarationId.fromParts(move module, List<OwnerStep>.make())
  let otherModule = run ModuleId.make(b"test", b"r3", b"other-requirements.silk")
  let other = run DeclarationId.fromParts(move otherModule, List<OwnerStep>.make())
  let source = run Shared<Lifetime>.make(Lifetime.Local {declaration: DeclarationId.copy(&owner), ordinal: 0})
  let extent = run Shared<Lifetime>.make(Lifetime.Local {declaration: DeclarationId.copy(&owner), ordinal: 1})
  let foreign = run Shared<Lifetime>.make(Lifetime.Local {declaration: DeclarationId.copy(&other), ordinal: 0})
  let universal = run Shared<Lifetime>.make(Lifetime.Parameter {declaration: DeclarationId.copy(&owner), ordinal: 0})
  run Testing.expect(retentionOrdinal(&foreign, &owner) == usize.MAX, "a matching ordinal in a different owner is not a local requirement")
  run Testing.expect(retentionOrdinal(&universal, &owner) == usize.MAX, "a parameter is not a local requirement")
  let mut obligations = List<SafetyObligation>.make()
  run List<SafetyObligation>.append(&mut obligations, retentionTestRelation(&source, &extent, false))
  run List<SafetyObligation>.append(&mut obligations, retentionTestRelation(&foreign, &extent, false))
  run List<SafetyObligation>.append(&mut obligations, retentionTestRelation(&source, &universal, false))
  run List<SafetyObligation>.append(&mut obligations, retentionTestRelation(&source, &extent, true))
  let admitted = run localRetentionEdges(&owner, List<SafetyObligation>.asSlice(&obligations))
  run Testing.expect(List<RetentionEdge>.length(&admitted) == 1,
    "foreign, outward and unresolved inferred-static relations cannot supply finite retention edges")
  let mut required = List<usize>.make()
  run List<usize>.append(&mut required, 0)
  let mut outer = run symbolicTestLoan(&extent, &universal, false)
  run List<Shared<Lifetime>>.append(&mut outer.regions, Shared<Lifetime>.clone(&source))
  run Testing.expect(!requiredLoan(&outer, &owner, List<usize>.asSlice(&required)),
    "an inner retained atom does not turn its outer storage loan into the required source")
  let actual = run symbolicTestLoan(&source, &universal, false)
  run Testing.expect(requiredLoan(&actual, &owner, List<usize>.asSlice(&required)), "the actual outer source remains required")
  let mut unknown = run symbolicTestLoan(&source, &universal, false)
  unknown.regions = List<Shared<Lifetime>>.make()
  run Testing.expect(!requiredLoan(&unknown, &owner, List<usize>.asSlice(&required)), "an empty region mapping supplies no retention evidence")
  let mut loans = List<Loan>.make()
  run List<Loan>.append(&mut loans, move actual)
  let mut carried = List<Carry>.make()
  run List<Carry>.append(&mut carried, Carry {loan: 0, since: 1, operand: 0, definition: usize.MAX, read: usize.MAX, field: usize.MAX, direct: false})
  let mut named = List<Shared<Lifetime>>.make()
  run List<Shared<Lifetime>>.append(&mut named, Shared<Lifetime>.clone(&extent))
  let mut edges = List<RetentionEdge>.make()
  run List<RetentionEdge>.append(&mut edges, RetentionEdge {source: 0, extent: 1})
  run List<RetentionEdge>.append(&mut edges, RetentionEdge {source: 1, extent: 0})
  let closure = run requiredRetainedRegions(List<Loan>.asSlice(&loans), List<Carry>.asSlice(&carried),
    List<Shared<Lifetime>>.asSlice(&named), &owner, List<RetentionEdge>.asSlice(&edges))
  run Testing.expect(retentionListed(List<usize>.asSlice(&closure), 0), "a local validity cycle retains the source without proving availability")
  return ()
}

fn retentionTestRelation(source: &Shared<Lifetime>, extent: &Shared<Lifetime>, unresolved: bool) -> SafetyObligation {
  let mut inferred = Option<Shared<Lifetime>>.none()
  if unresolved { inferred = Option<Shared<Lifetime>>.some(Shared<Lifetime>.clone(source)) }
  return SafetyObligation.RegionRelation {origin: Origin {node: 0, location: Location.make(0, 1)},
    offered: Shared<Lifetime>.clone(source), wanted: Shared<Lifetime>.clone(extent), inferredStatic: move inferred}
}

test effect fn finiteContentsAuthenticateSubjectAndCaptureSite() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run finiteContentsClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn finiteContentsClaims() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let owner = run capturedTestOwner(b"contents.silk", 0)
  let child = run capturedTestOwner(b"contents.silk", 1)
  let nested = run capturedTestOwner(b"contents.silk", 2)
  let foreign = run capturedTestOwner(b"other-contents.silk", 0)
  let parameter = run Types.intern(Type.Parameter {declaration: DeclarationId.copy(&owner), ordinal: 0})
  let unrelated = run Types.intern(Type.Parameter {declaration: move foreign, ordinal: 0})
  let anonymous = run Types.intern(Type.Parameter {declaration: DeclarationId.copy(&child), ordinal: 0})
  let concrete = run Types.intern(Type.Unit)
  let local = run Shared<Lifetime>.make(Lifetime.Local {declaration: DeclarationId.copy(&owner), ordinal: 3})
  let captured = run Shared<Lifetime>.make(Lifetime.Local {declaration: DeclarationId.copy(&child), ordinal: 3})
  let nestedLocal = run Shared<Lifetime>.make(Lifetime.Local {declaration: DeclarationId.copy(&nested), ordinal: 3})
  let fixed = run Shared<Lifetime>.make(Lifetime.Static)
  let origin = Origin {node: 3, location: Location.make(0, 1)}
  let otherSite = Origin {node: 4, location: Location.make(0, 1)}
  run Testing.expect(finiteCaptureContents(&owner, origin, &parameter, &local), "the invocation's parameter covers its finite capture use")
  run Testing.expect(finiteCaptureContents(&child, origin, &parameter, &captured), "a named enclosing function's type parameter remains available in the anonymous invocation")
  run Testing.expect(!finiteCaptureContents(&owner, origin, &unrelated, &local), "a same-ordinal foreign type parameter supplies no evidence")
  run Testing.expect(!finiteCaptureContents(&owner, otherSite, &parameter, &local), "a different capture origin is not this finite obligation")
  run Testing.expect(!finiteCaptureContents(&owner, origin, &parameter, &captured), "the target must belong to the checked body")
  run Testing.expect(!finiteCaptureContents(&owner, origin, &parameter, &fixed), "finite availability never proves T:static")
  run Testing.expect(!finiteCaptureContents(&owner, origin, &concrete, &local), "arbitrary concrete contents require their separate loan proof")
  run Testing.expect(!finiteCaptureContents(&nested, origin, &anonymous, &nestedLocal), "an enclosing anonymous owner's parameters do not gain a nested-body rule")
  return ()
}

test effect fn descriptorReleaseRequiresCompleteExactSources() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run descriptorSourceClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn descriptorSourceClaims() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let owner = run capturedTestOwner(b"descriptor.silk", 0)
  let other = run capturedTestOwner(b"other-descriptor.silk", 0)
  let inner = run Shared<Lifetime>.make(Lifetime.Local {declaration: DeclarationId.copy(&owner), ordinal: 0})
  let outer = run Shared<Lifetime>.make(Lifetime.Local {declaration: DeclarationId.copy(&owner), ordinal: 1})
  let foreign = run Shared<Lifetime>.make(Lifetime.Local {declaration: move other, ordinal: 1})
  let mut descriptor = run symbolicTestLoan(&outer, &inner, true)
  descriptor.parent = Option<Shared<Lifetime>>.none()
  let mut named = List<Shared<Lifetime>>.make()
  run List<Shared<Lifetime>>.append(&mut named, Shared<Lifetime>.clone(&inner))
  let mut required = List<usize>.make()
  run Testing.expect(unneededOwnedLoan(&descriptor, &owner, List<Shared<Lifetime>>.asSlice(&named), List<usize>.asSlice(&required), false),
    "an exact unmatched descriptor is eligible only after a separate complete-source proof")
  run Testing.expect(!unneededOwnedLoan(&descriptor, &owner, List<Shared<Lifetime>>.asSlice(&named), List<usize>.asSlice(&required), true),
    "an actual ancestor of a retained source cannot be released")
  run List<usize>.append(&mut required, 1)
  run Testing.expect(!unneededOwnedLoan(&descriptor, &owner, List<Shared<Lifetime>>.asSlice(&named), List<usize>.asSlice(&required), false),
    "a source required by an outer-to-inner goal remains retained")
  required = List<usize>.make()
  descriptor.precision = LoanPrecision.Unknown
  run Testing.expect(!unneededOwnedLoan(&descriptor, &owner, List<Shared<Lifetime>>.asSlice(&named), List<usize>.asSlice(&required), false), "prior Unknown is never repaired by descriptor release")
  descriptor.precision = LoanPrecision.Alternatives
  run Testing.expect(!unneededOwnedLoan(&descriptor, &owner, List<Shared<Lifetime>>.asSlice(&named), List<usize>.asSlice(&required), false), "prior Alternatives remains a possible source")
  let mut unrelated = run symbolicTestLoan(&foreign, &inner, true)
  unrelated.parent = Option<Shared<Lifetime>>.none()
  run Testing.expect(!unneededOwnedLoan(&unrelated, &owner, List<Shared<Lifetime>>.asSlice(&named), List<usize>.asSlice(&required), false), "a foreign owner with the same ordinal supplies no local descriptor proof")
  let mut loans = List<Loan>.make()
  run List<Loan>.append(&mut loans, run symbolicTestLoan(&inner, &inner, true))
  let mut carried = List<Carry>.make()
  run List<Carry>.append(&mut carried, Carry {loan: 0, since: 1, operand: 0, definition: usize.MAX, read: usize.MAX, field: usize.MAX, direct: false})
  run Testing.expect(completeLocalResultSources(List<Loan>.asSlice(&loans), List<Carry>.asSlice(&carried), List<Shared<Lifetime>>.asSlice(&named), &owner, List<Shared<Lifetime>>.asSlice(&List<Shared<Lifetime>>.make())), "the exact actual source covers this local result")
  let mut listed = List<Loan>.asMutSlice(&mut loans)
  listed[0].precision = LoanPrecision.Unknown
  run Testing.expect(!completeLocalResultSources(List<Loan>.asSlice(&loans), List<Carry>.asSlice(&carried), List<Shared<Lifetime>>.asSlice(&named), &owner, List<Shared<Lifetime>>.asSlice(&List<Shared<Lifetime>>.make())), "an unknown source cannot make result provenance complete")
  let mut exact = List<Loan>.asMutSlice(&mut loans)
  exact[0].precision = LoanPrecision.Exact
  exact[0].borrowed = Option<Shared<Lifetime>>.some(Shared<Lifetime>.clone(&outer))
  run Testing.expect(!completeLocalResultSources(List<Loan>.asSlice(&loans), List<Carry>.asSlice(&carried), List<Shared<Lifetime>>.asSlice(&named), &owner, List<Shared<Lifetime>>.asSlice(&List<Shared<Lifetime>>.make())), "a retained inner atom alone does not identify the actual source loan")
  return ()
}

test effect fn finiteParentsRequireGroundingAndLiveStorage() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run finiteParentClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn finiteParentClaims() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let owner = run capturedTestOwner(b"finite-parents.silk", 0)
  let foreignOwner = run capturedTestOwner(b"foreign-parents.silk", 0)
  let first = run Shared<Lifetime>.make(Lifetime.Local {declaration: DeclarationId.copy(&owner), ordinal: 0})
  let second = run Shared<Lifetime>.make(Lifetime.Local {declaration: DeclarationId.copy(&owner), ordinal: 1})
  let third = run Shared<Lifetime>.make(Lifetime.Local {declaration: DeclarationId.copy(&owner), ordinal: 2})
  let foreign = run Shared<Lifetime>.make(Lifetime.Local {declaration: move foreignOwner, ordinal: 0})
  let universal = run Shared<Lifetime>.make(Lifetime.Parameter {declaration: DeclarationId.copy(&owner), ordinal: 0})
  let mut walker = Walker {
    callerRetentions: List<CallerRetention>.make(),
    unrun: List<bool>.make(), points: List<Point>.make(), loans: List<Loan>.make(), events: List<Event>.make(),
    frames: List<Frame>.make(), loops: List<Loop>.make(), held: List<List<usize>>.make(),
    definitions: List<Holding>.make(), holdingSources: List<HoldingSource>.make(), scopes: List<Scope>.make(), localCount: 2,
    cleanup: List<LoanCleanup>.make(), loopCleanup: List<LoopCleanup>.make(), exit: 0, entry: 1,
    outside: false, reason: BorrowStatus.Regions, guarded: List<usize>.make(),
    guardConsumed: Option<Location>.none(), retention: Retention.None, requirements: List<RetentionEdge>.make(),
    settled: true, retentionRelations: List<ImpliedGroup>.make(), wholeHolds: List<WholeHold>.make(), openContents: List<Shared<Lifetime>>.make(), unretained: List<usize>.make(), contested: List<Shared<Lifetime>>.make(), storing: false, inherited: BorrowStatus.Checked, storable: List<usize>.make(),
    refinements: List<Refinement>.make(), lexicalHolders: List<usize>.make(),
    paths: List<List<Step>>.make(),
    stores: List<StoreWindow>.make(),
    returns: List<StoreWindow>.make(),
    sealed: List<Location>.make(),
    unheld: List<Location>.make(),
    escaping: List<usize>.make(),
    supplied: List<Shared<Lifetime>>.make(),
  }
  run List<List<Step>>.append(&mut walker.paths, List<Step>.make())
  let mut at = usize.ZERO
  while at < 5 { drop run newPoint(&mut walker, usize.MAX) at = at + usize.ONE }
  run edge(&mut walker, 1, 2)
  run edge(&mut walker, 2, 3)
  run edge(&mut walker, 3, 4)
  run edge(&mut walker, 4, 0)
  let mut root = run symbolicTestLoan(&first, &universal, true)
  root.parent = Option<Shared<Lifetime>>.none()
  root.crossed = false
  run List<Loan>.append(&mut walker.loans, move root)
  let mut child = run symbolicTestLoan(&second, &first, false)
  child.place.root = 1
  run List<Step>.append(&mut child.place.steps, referent())
  child.created = 2
  run List<Interval>.append(&mut child.intervals, Interval {from: 2, to: 3, definition: usize.MAX, read: usize.MAX, cleanup: false})
  run List<Loan>.append(&mut walker.loans, move child)
  run List<Event>.append(&mut walker.events, Event {point: 3, place: Place {root: 0, steps: List<Step>.make()},
    kind: Kind.End, span: Location.make(0, 1), target: Location.make(0, 1), loan: usize.MAX, consumesTarget: 0,
    refiner: usize.MAX, refinedDepth: 0, binders: List<usize>.make()})
  let emptyGoals = List<SafetyObligation>.make()
  let premises = List<RegionBound>.make()
  let words = List<u64>.make()
  let mut symbolic = List<SymbolicRegion>.make()
  run Testing.expect(!run localRelationsProved(&walker, &owner, List<SafetyObligation>.asSlice(&emptyGoals),
    List<RegionBound>.asSlice(&premises), &mut symbolic,  List<u64>.asSlice(&words),
    List<u64>.asSlice(&words), 0, true),
    "a crossed child's required point must fit its owned parent's availability even with no typing goals")
  let mut descriptor = List<Event>.asMutSlice(&mut walker.events)
  descriptor[0].place.root = 1
  run Testing.expect(run localRelationsProved(&walker, &owner, List<SafetyObligation>.asSlice(&emptyGoals),
    List<RegionBound>.asSlice(&premises), &mut symbolic,  List<u64>.asSlice(&words),
    List<u64>.asSlice(&words), 0, true),
    "ending a temporary descriptor preserves a finite child whose actual owned source stays alive")
  let mut referentEnd = List<Event>.asMutSlice(&mut walker.events)
  run List<Step>.append(&mut referentEnd[0].place.steps, referent())
  run Testing.expect(!run localRelationsProved(&walker, &owner, List<SafetyObligation>.asSlice(&emptyGoals),
    List<RegionBound>.asSlice(&premises), &mut symbolic,  List<u64>.asSlice(&words),
    List<u64>.asSlice(&words), 0, true),
    "a finite parent proof never ignores an actual referent end")
  List<Event>.clear(&mut walker.events)
  run Testing.expect(run localRelationsProved(&walker, &owner, List<SafetyObligation>.asSlice(&emptyGoals),
    List<RegionBound>.asSlice(&premises), &mut symbolic,  List<u64>.asSlice(&words),
    List<u64>.asSlice(&words), 0, true),
    "the finite crossing is proved when the actual owned parent remains valid")
  run Testing.expect(!run symbolicRegionProved(&regionSources(&walker), &owner, &second, &universal,
    List<RegionBound>.asSlice(&premises), &mut symbolic),
    "finite success never installs a universal-source proof for owned storage")
  let mut shared = List<Loan>.asMutSlice(&mut walker.loans)
  shared[1].borrowed = Option<Shared<Lifetime>>.some(Shared<Lifetime>.clone(&first))
  let mut names = List<Shared<Lifetime>>.asMutSlice(&mut shared[1].regions)
  names[0] = Shared<Lifetime>.clone(&first)
  run Testing.expect(run localRelationsProved(&walker, &owner, List<SafetyObligation>.asSlice(&emptyGoals),
    List<RegionBound>.asSlice(&premises), &mut symbolic,  List<u64>.asSlice(&words),
    List<u64>.asSlice(&words), 0, true),
    "a shared parent atom remains grounded in its live owned source before the reborrow is created")
  run List<Event>.append(&mut walker.events, Event {point: 3, place: Place {root: 0, steps: List<Step>.make()},
    kind: Kind.End, span: Location.make(0, 1), target: Location.make(0, 1), loan: usize.MAX, consumesTarget: 0,
    refiner: usize.MAX, refinedDepth: 0, binders: List<usize>.make()})
  run Testing.expect(!run localRelationsProved(&walker, &owner, List<SafetyObligation>.asSlice(&emptyGoals),
    List<RegionBound>.asSlice(&premises), &mut symbolic,  List<u64>.asSlice(&words),
    List<u64>.asSlice(&words), 0, true),
    "a shared parent atom cannot erase the requirement to check every source's availability")
  List<Event>.clear(&mut walker.events)
  let mut restored = List<Loan>.asMutSlice(&mut walker.loans)
  restored[1].borrowed = Option<Shared<Lifetime>>.some(Shared<Lifetime>.clone(&second))
  let mut original = List<Shared<Lifetime>>.asMutSlice(&mut restored[1].regions)
  original[0] = Shared<Lifetime>.clone(&second)
  // Duplicate child regions retain every actual parent path, including an ungrounded sibling.
  run List<Loan>.append(&mut walker.loans, run symbolicTestLoan(&second, &third, false))
  run List<Loan>.append(&mut walker.loans, run symbolicTestLoan(&third, &third, false))
  let mut roots = List<SymbolicRoot>.make()
  drop run symbolicRootIndex(&mut roots, &second)
  run Testing.expect(!run finiteParentRoots(&regionSources(&walker), &owner, &mut roots),
    "a grounded branch cannot justify another source trapped in an ungrounded cycle")
  let mut grounded = List<Loan>.asMutSlice(&mut walker.loans)
  grounded[3].local = true
  grounded[3].parent = Option<Shared<Lifetime>>.none()
  roots = List<SymbolicRoot>.make()
  drop run symbolicRootIndex(&mut roots, &second)
  run Testing.expect(run finiteParentRoots(&regionSources(&walker), &owner, &mut roots),
    "all actual parents of a duplicated region can be grounded separately")
  let mut uncertain = List<Loan>.asMutSlice(&mut walker.loans)
  uncertain[3].precision = LoanPrecision.Unknown
  roots = List<SymbolicRoot>.make()
  drop run symbolicRootIndex(&mut roots, &second)
  run Testing.expect(!run finiteParentRoots(&regionSources(&walker), &owner, &mut roots),
    "one Unknown actual source blocks the complete finite parent proof")
  let mut changed = List<Loan>.asMutSlice(&mut walker.loans)
  changed[3].precision = LoanPrecision.Exact
  changed[2].parent = Option<Shared<Lifetime>>.some(Shared<Lifetime>.clone(&foreign))
  roots = List<SymbolicRoot>.make()
  drop run symbolicRootIndex(&mut roots, &second)
  run Testing.expect(!run finiteParentRoots(&regionSources(&walker), &owner, &mut roots),
    "an equal ordinal in a foreign owner is not a local parent")
  let mut innerOnly = List<Loan>.asMutSlice(&mut walker.loans)
  innerOnly[2].parent = Option<Shared<Lifetime>>.some(Shared<Lifetime>.clone(&first))
  innerOnly[2].borrowed = Option<Shared<Lifetime>>.some(Shared<Lifetime>.clone(&third))
  roots = List<SymbolicRoot>.make()
  drop run symbolicRootIndex(&mut roots, &second)
  run Testing.expect(!run finiteParentRoots(&regionSources(&walker), &owner, &mut roots),
    "a stored inner atom alone cannot supply actual outer loan identity")
  return ()
}


test effect fn intervalRequirementsKeepReachableEndsAndCleanup() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run intervalRequirementClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn intervalTestProved(walker: &Walker, owner: &DeclarationId, region: &Shared<Lifetime>) -> bool
! OutOfMemoryError ? &mut Allocator {
  let words = List<u64>.make()
  let premises = List<RegionBound>.make()
  let mut regions = List<RegionPoints>.make()
  let mut symbolic = List<SymbolicRegion>.make()
  let mut flow = emptyIntervalFlow()
  let mut storage = emptyRegionAvailability()
  let found = run regionPoints(walker, owner, region, 
    List<u64>.asSlice(&words), List<u64>.asSlice(&words), 0, &mut regions,
    List<RegionBound>.asSlice(&premises), &mut symbolic, &mut flow, &mut storage)
  return found != usize.MAX
}

effect fn intervalRequirementClaims() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let owner = run capturedTestOwner(b"interval-paths.silk", 0)
  let region = run Shared<Lifetime>.make(Lifetime.Local {declaration: DeclarationId.copy(&owner), ordinal: 0})
  let universal = run Shared<Lifetime>.make(Lifetime.Parameter {declaration: DeclarationId.copy(&owner), ordinal: 0})
  let mut walker = Walker {
    callerRetentions: List<CallerRetention>.make(),
    unrun: List<bool>.make(), points: List<Point>.make(), loans: List<Loan>.make(), events: List<Event>.make(),
    frames: List<Frame>.make(), loops: List<Loop>.make(), held: List<List<usize>>.make(),
    definitions: List<Holding>.make(), holdingSources: List<HoldingSource>.make(), scopes: List<Scope>.make(), localCount: 1,
    cleanup: List<LoanCleanup>.make(), loopCleanup: List<LoopCleanup>.make(), exit: 0, entry: 1,
    outside: false, reason: BorrowStatus.Regions, guarded: List<usize>.make(),
    guardConsumed: Option<Location>.none(), retention: Retention.None, requirements: List<RetentionEdge>.make(),
    settled: true, retentionRelations: List<ImpliedGroup>.make(), wholeHolds: List<WholeHold>.make(), openContents: List<Shared<Lifetime>>.make(), unretained: List<usize>.make(), contested: List<Shared<Lifetime>>.make(), storing: false, inherited: BorrowStatus.Checked, storable: List<usize>.make(),
    refinements: List<Refinement>.make(), lexicalHolders: List<usize>.make(),
    paths: List<List<Step>>.make(),
    stores: List<StoreWindow>.make(),
    returns: List<StoreWindow>.make(),
    sealed: List<Location>.make(),
    unheld: List<Location>.make(),
    escaping: List<usize>.make(),
    supplied: List<Shared<Lifetime>>.make(),
  }
  run List<List<Step>>.append(&mut walker.paths, List<Step>.make())
  let mut at = usize.ZERO
  while at < 5 { drop run newPoint(&mut walker, usize.MAX) at = at + usize.ONE }
  run edge(&mut walker, 1, 2)
  run edge(&mut walker, 2, 0)
  run edge(&mut walker, 1, 3)
  run edge(&mut walker, 3, 4)
  run edge(&mut walker, 4, 0)
  let mut loan = run symbolicTestLoan(&region, &universal, true)
  loan.parent = Option<Shared<Lifetime>>.none()
  loan.crossed = false
  run List<Interval>.append(&mut loan.intervals, Interval {from: 1, to: 4, definition: usize.MAX, read: usize.MAX, cleanup: false})
  run List<Loan>.append(&mut walker.loans, move loan)
  run List<Event>.append(&mut walker.events, Event {point: 2, place: Place {root: 0, steps: List<Step>.make()},
    kind: Kind.End, span: Location.make(0, 1), target: Location.make(0, 1), loan: usize.MAX, consumesTarget: 0,
    refiner: usize.MAX, refinedDepth: 0, binders: List<usize>.make()})
  run Testing.expect(run intervalTestProved(&walker, &owner, &region),
    "an early-exit storage end cannot reach this interval's consumer and is not its requirement")
  run edge(&mut walker, 2, 3)
  run Testing.expect(!run intervalTestProved(&walker, &owner, &region),
    "the same storage end remains required when its branch reaches the consuming point")
  let mut direct = List<Point>.asMutSlice(&mut walker.points)
  List<usize>.clear(&mut direct[2].next)
  run edge(&mut walker, 2, 0)
  run edge(&mut walker, 2, 1)
  run Testing.expect(!run intervalTestProved(&walker, &owner, &region),
    "a back edge that reaches the consumer cannot be pruned as an abandoned branch")
  let mut restored = List<Point>.asMutSlice(&mut walker.points)
  List<usize>.clear(&mut restored[2].next)
  run edge(&mut walker, 2, 0)
  let mut observed = List<Loan>.asMutSlice(&mut walker.loans)
  run List<Interval>.append(&mut observed[0].intervals, Interval {from: 2, to: 2, definition: usize.MAX, read: usize.MAX, cleanup: true})
  run Testing.expect(!run intervalTestProved(&walker, &owner, &region),
    "an abandoned call does not erase a cleanup observer's independent requirement")
  return ()
}

test effect fn ownedInitializationRequiresEveryPathAndPreservesEnds() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run ownedInitializationClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn initializedRelationProved(walker: &Walker, owner: &DeclarationId,
  shorter: &Shared<Lifetime>, longer: &Shared<Lifetime>) -> bool
! OutOfMemoryError ? &mut Allocator {
  let words = List<u64>.make()
  let premises = List<RegionBound>.make()
  let mut regions = List<RegionPoints>.make()
  let mut symbolic = List<SymbolicRegion>.make()
  let mut flow = emptyIntervalFlow()
  let mut storage = emptyRegionAvailability()
  let first = run regionPoints(walker, owner, shorter, 
    List<u64>.asSlice(&words), List<u64>.asSlice(&words), 0, &mut regions,
    List<RegionBound>.asSlice(&premises), &mut symbolic, &mut flow, &mut storage)
  let second = run regionPoints(walker, owner, longer, 
    List<u64>.asSlice(&words), List<u64>.asSlice(&words), 0, &mut regions,
    List<RegionBound>.asSlice(&premises), &mut symbolic, &mut flow, &mut storage)
  if first == usize.MAX || second == usize.MAX { return false }
  let mut edges = List<RegionEdge>.make()
  run List<RegionEdge>.append(&mut edges, RegionEdge {shorter: first, longer: second})
  return run solveRegionRequirements(&mut regions, List<RegionEdge>.asSlice(&edges))
}

effect fn ownedInitializationClaims() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let owner = run capturedTestOwner(b"owned-initialization.silk", 0)
  let shorter = run Shared<Lifetime>.make(Lifetime.Local {declaration: DeclarationId.copy(&owner), ordinal: 0})
  let longer = run Shared<Lifetime>.make(Lifetime.Local {declaration: DeclarationId.copy(&owner), ordinal: 1})
  let mut walker = Walker {
    callerRetentions: List<CallerRetention>.make(),
    unrun: List<bool>.make(), points: List<Point>.make(), loans: List<Loan>.make(), events: List<Event>.make(),
    frames: List<Frame>.make(), loops: List<Loop>.make(), held: List<List<usize>>.make(),
    definitions: List<Holding>.make(), holdingSources: List<HoldingSource>.make(), scopes: List<Scope>.make(), localCount: 2,
    cleanup: List<LoanCleanup>.make(), loopCleanup: List<LoopCleanup>.make(), exit: 0, entry: 1,
    outside: false, reason: BorrowStatus.Regions, guarded: List<usize>.make(),
    guardConsumed: Option<Location>.none(), retention: Retention.None, requirements: List<RetentionEdge>.make(),
    settled: true, retentionRelations: List<ImpliedGroup>.make(), wholeHolds: List<WholeHold>.make(), openContents: List<Shared<Lifetime>>.make(), unretained: List<usize>.make(), contested: List<Shared<Lifetime>>.make(), storing: false, inherited: BorrowStatus.Checked, storable: List<usize>.make(),
    refinements: List<Refinement>.make(), lexicalHolders: List<usize>.make(),
    paths: List<List<Step>>.make(),
    stores: List<StoreWindow>.make(),
    returns: List<StoreWindow>.make(),
    sealed: List<Location>.make(),
    unheld: List<Location>.make(),
    escaping: List<usize>.make(),
    supplied: List<Shared<Lifetime>>.make(),
  }
  run List<List<Step>>.append(&mut walker.paths, List<Step>.make())
  let mut at = usize.ZERO
  while at < 6 { drop run newPoint(&mut walker, usize.MAX) at = at + usize.ONE }
  at = usize.ONE
  while at < 5 { run edge(&mut walker, at, at + usize.ONE) at = at + usize.ONE }
  run edge(&mut walker, 5, 0)
  let mut first = run symbolicTestLoan(&shorter, &shorter, true)
  first.parent = Option<Shared<Lifetime>>.none()
  first.crossed = false
  first.created = 2
  let mut second = run symbolicTestLoan(&longer, &longer, true)
  second.parent = Option<Shared<Lifetime>>.none()
  second.crossed = false
  second.created = 4
  second.place.root = 1
  run List<Loan>.append(&mut walker.loans, move first)
  run List<Loan>.append(&mut walker.loans, move second)
  let mut initialized = List<Point>.asMutSlice(&mut walker.points)
  initialized[1].initializes = 1
  run Testing.expect(run initializedRelationProved(&walker, &owner, &shorter, &longer),
    "an initialized owned source covers an earlier argument before its fresh borrow")
  let mut alternatives = List<Loan>.asMutSlice(&mut walker.loans)
  alternatives[1].precision = LoanPrecision.Alternatives
  run Testing.expect(run initializedRelationProved(&walker, &owner, &shorter, &longer),
    "an explicitly known alternative retains its actual initialized storage mask")
  let mut third = run symbolicTestLoan(&longer, &longer, true)
  third.parent = Option<Shared<Lifetime>>.none()
  third.crossed = false
  third.precision = LoanPrecision.Alternatives
  third.created = 4
  third.place.root = 2
  run List<Loan>.append(&mut walker.loans, move third)
  let mut thirdStorage = List<Point>.asMutSlice(&mut walker.points)
  thirdStorage[2].initializes = 2
  let mut uses = List<Loan>.asMutSlice(&mut walker.loans)
  run List<Interval>.append(&mut uses[0].intervals, Interval {from: 2, to: 5, definition: usize.MAX, read: usize.MAX, cleanup: false})
  run Testing.expect(run initializedRelationProved(&walker, &owner, &shorter, &longer),
    "every known alternative contributes its own initialized storage mask")
  run List<Event>.append(&mut walker.events, Event {point: 5,
    place: Place {root: 2, steps: List<Step>.make()}, kind: Kind.End,
    span: Location.make(0, 1), target: Location.make(0, 1), loan: usize.MAX, consumesTarget: 0,
    refiner: usize.MAX, refinedDepth: 0, binders: List<usize>.make()})
  run Testing.expect(!run initializedRelationProved(&walker, &owner, &shorter, &longer),
    "ending one alternative rejects an incoming requirement even while the other remains alive")
  List<Event>.clear(&mut walker.events)
  drop List<Loan>.pop(&mut walker.loans)
  let mut originalUses = List<Loan>.asMutSlice(&mut walker.loans)
  List<Interval>.clear(&mut originalUses[0].intervals)
  let mut originalStorage = List<Point>.asMutSlice(&mut walker.points)
  originalStorage[2].initializes = usize.MAX
  let mut unknown = List<Loan>.asMutSlice(&mut walker.loans)
  unknown[1].precision = LoanPrecision.Unknown
  run Testing.expect(!run initializedRelationProved(&walker, &owner, &shorter, &longer),
    "Unknown provenance cannot acquire availability from a matching initialization")
  let mut restoredPrecision = List<Loan>.asMutSlice(&mut walker.loans)
  restoredPrecision[1].precision = LoanPrecision.Exact
  let mut delayed = List<Point>.asMutSlice(&mut walker.points)
  delayed[1].initializes = usize.MAX
  delayed[3].initializes = 1
  // The later borrow at 4 cannot be live at the earlier loan's points 2 and 3, which its creation
  // never reaches: a value of a region observed at a point carries only loans whose creation
  // reaches that point, so those points place no validity requirement on its storage.
  run Testing.expect(run initializedRelationProved(&walker, &owner, &shorter, &longer),
    "a requirement at points the later borrow's creation never reaches needs no storage there")
  run edge(&mut walker, 5, 2)
  run Testing.expect(!run initializedRelationProved(&walker, &owner, &shorter, &longer),
    "storage is not available before its initialization where the later borrow's creation reaches")
  let mut looped = List<Point>.asMutSlice(&mut walker.points)
  drop List<usize>.pop(&mut looped[5].next)
  run edge(&mut walker, 2, 4)
  run Testing.expect(!run initializedRelationProved(&walker, &owner, &shorter, &longer),
    "one path bypassing initialization also excludes the later borrow's own required point")
  let mut restored = List<Point>.asMutSlice(&mut walker.points)
  restored[1].initializes = 1
  restored[3].initializes = usize.MAX
  run List<Event>.append(&mut walker.events, Event {point: 2,
    place: Place {root: 1, steps: List<Step>.make()}, kind: Kind.End,
    span: Location.make(0, 1), target: Location.make(0, 1), loan: usize.MAX, consumesTarget: 0,
    refiner: usize.MAX, refinedDepth: 0, binders: List<usize>.make()})
  run Testing.expect(run initializedRelationProved(&walker, &owner, &shorter, &longer),
    "a storage end the later borrow's creation never reaches places no requirement on that borrow")
  run edge(&mut walker, 5, 2)
  run Testing.expect(!run initializedRelationProved(&walker, &owner, &shorter, &longer),
    "initialization does not erase an actual storage end the later fresh borrow's creation reaches")
  let mut ended = List<Point>.asMutSlice(&mut walker.points)
  drop List<usize>.pop(&mut ended[5].next)
  List<Event>.clear(&mut walker.events)
  let mut cycling = List<Point>.asMutSlice(&mut walker.points)
  cycling[1].initializes = usize.MAX
  cycling[3].initializes = 1
  List<usize>.clear(&mut cycling[1].next)
  run edge(&mut walker, 1, 3)
  run edge(&mut walker, 3, 2)
  run Testing.expect(run initializedRelationProved(&walker, &owner, &shorter, &longer),
    "a rebinding on a CFG cycle the later borrow's creation never reaches places no requirement on that borrow")
  run edge(&mut walker, 5, 2)
  run Testing.expect(!run initializedRelationProved(&walker, &owner, &shorter, &longer),
    "a root rebound on a CFG cycle the later borrow's creation reaches cannot revive storage for an earlier loan")
  // Meet constituents keep the same owned-storage must proof. An incoming requirement at
  // the join also covers the path that never created this fresh borrow.
  List<Point>.clear(&mut walker.points)
  List<Loan>.clear(&mut walker.loans)
  List<Event>.clear(&mut walker.events)
  walker.localCount = 3
  at = usize.ZERO
  while at < 6 { drop run newPoint(&mut walker, usize.MAX) at = at + usize.ONE }
  at = usize.ONE
  while at < 5 { run edge(&mut walker, at, at + usize.ONE) at = at + usize.ONE }
  run edge(&mut walker, 5, 0)
  run edge(&mut walker, 2, 5)
  let extra = run Shared<Lifetime>.make(Lifetime.Local {declaration: DeclarationId.copy(&owner), ordinal: 2})
  let mut members = List<Shared<Lifetime>>.make()
  run List<Shared<Lifetime>>.append(&mut members, Shared<Lifetime>.clone(&longer))
  run List<Shared<Lifetime>>.append(&mut members, Shared<Lifetime>.clone(&extra))
  let meet = run Lifetime.meet(List<Shared<Lifetime>>.asSlice(&members))
  let mut demand = run symbolicTestLoan(&shorter, &shorter, true)
  demand.parent = Option<Shared<Lifetime>>.none()
  demand.created = 2
  run List<Interval>.append(&mut demand.intervals, Interval {from: 2, to: 5, definition: usize.MAX, read: usize.MAX, cleanup: false})
  let mut member = run symbolicTestLoan(&meet, &meet, true)
  member.parent = Option<Shared<Lifetime>>.none()
  member.created = 4
  member.place.root = 1
  let mut companion = run symbolicTestLoan(&longer, &longer, true)
  companion.parent = Option<Shared<Lifetime>>.none()
  companion.created = 4
  companion.place.root = 2
  run List<Loan>.append(&mut walker.loans, move demand)
  run List<Loan>.append(&mut walker.loans, move member)
  run List<Loan>.append(&mut walker.loans, move companion)
  let mut beforeSplit = List<Point>.asMutSlice(&mut walker.points)
  beforeSplit[1].initializes = 1
  beforeSplit[2].initializes = 2
  run Testing.expect(run initializedRelationProved(&walker, &owner, &shorter, &longer),
    "an actual meet member uses its owned storage initialized before the branch")
  let mut onlyBranch = List<Point>.asMutSlice(&mut walker.points)
  onlyBranch[1].initializes = usize.MAX
  onlyBranch[3].initializes = 1
  run Testing.expect(!run initializedRelationProved(&walker, &owner, &shorter, &longer),
    "one contributing meet member still excludes an incoming join use on the path bypassing initialization")
  let mut allPaths = List<Point>.asMutSlice(&mut walker.points)
  allPaths[1].initializes = 1
  allPaths[3].initializes = usize.MAX
  let mut unrelatedBorrow = List<Loan>.asMutSlice(&mut walker.loans)
  unrelatedBorrow[1].borrowed = Option<Shared<Lifetime>>.some(Shared<Lifetime>.clone(&extra))
  run Testing.expect(!run initializedRelationProved(&walker, &owner, &shorter, &longer),
    "membership in retained lifetimes alone cannot authenticate a different borrowed atom")
  let mut actualBorrow = List<Loan>.asMutSlice(&mut walker.loans)
  actualBorrow[1].borrowed = Option<Shared<Lifetime>>.some(Shared<Lifetime>.clone(&meet))
  run List<Event>.append(&mut walker.events, Event {point: 5,
    place: Place {root: 1, steps: List<Step>.make()}, kind: Kind.End,
    span: Location.make(0, 1), target: Location.make(0, 1), loan: usize.MAX, consumesTarget: 0,
    refiner: usize.MAX, refinedDepth: 0, binders: List<usize>.make()})
  run Testing.expect(!run initializedRelationProved(&walker, &owner, &shorter, &longer),
    "a contributing meet member's End still rejects incoming use while the other source remains alive")

  // Traversal reserves entry at zero. An unrelated point numbered one is not a
  // substitute, and the actual creation still stops the lower-bound exclusion.
  List<Point>.clear(&mut walker.points)
  List<Event>.clear(&mut walker.events)
  at = usize.ZERO
  while at < 3 { drop run newPoint(&mut walker, usize.MAX) at = at + usize.ONE }
  run edge(&mut walker, 0, 1)
  run edge(&mut walker, 0, 2)
  let mut actualEntryLoan = run symbolicTestLoan(&longer, &longer, true)
  actualEntryLoan.parent = Option<Shared<Lifetime>>.none()
  actualEntryLoan.created = 2
  actualEntryLoan.place.root = 1
  let mut actualAvailable = List<u64>.make()
  run List<u64>.append(&mut actualAvailable, u64.bitNot(0))
  let noDefinitions = List<u64>.make()
  run localAvailable(&walker, 0, 0, &actualEntryLoan, false, false,
    List<u64>.asSlice(&noDefinitions), 0, &mut actualAvailable)
  let actualMask = List<u64>.asSlice(&actualAvailable)[0]
  run Testing.expect(u64.bitAnd(actualMask, maskOf(0)) == 0
    && u64.bitAnd(actualMask, maskOf(1)) == 0 && u64.bitAnd(actualMask, maskOf(2)) != 0,
    "storage validity excludes the actual entry and bypass paths while stopping at this loan's creation")
  List<Point>.asMutSlice(&mut walker.points)[1].initializes = 1
  let mut actualStorage = emptyRegionAvailability()
  let mut actualFlow = emptyIntervalFlow()
  let initializedAt = run initializedOwnedRegion(List<Point>.asSlice(&walker.points), 0,
    &actualEntryLoan, &longer, &mut actualStorage, &mut actualFlow)
  run Testing.expect(initializedAt != usize.MAX,
    "an actual owner initialization is retained independently of whether every path reaches it")
  let initMask = List<u64>.asSlice(&List<List<u64>>.asSlice(&actualStorage.masks)[initializedAt])[0]
  run Testing.expect(u64.bitAnd(initMask, maskOf(0)) == 0 && u64.bitAnd(initMask, maskOf(2)) == 0,
    "one actual entry path bypassing initialization still prevents must-availability at creation")
  return ()
}


test effect fn offeredMeetRequiresEverySource() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run offeredMeetClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn offeredMeetRelationProved(walker: &Walker, owner: &DeclarationId,
  offered: &Shared<Lifetime>, wanted: &Shared<Lifetime>) -> bool
! OutOfMemoryError ? &mut Allocator {
  let words = List<u64>.make()
  let premises = List<RegionBound>.make()
  let mut symbolic = List<SymbolicRegion>.make()
  let mut obligations = List<SafetyObligation>.make()
  run List<SafetyObligation>.append(&mut obligations, retentionTestRelation(offered, wanted, false))
  return run localRelationsProved(walker, owner, List<SafetyObligation>.asSlice(&obligations),
    List<RegionBound>.asSlice(&premises), &mut symbolic,
    List<u64>.asSlice(&words), List<u64>.asSlice(&words), 0, false)
}

effect fn offeredMeetClaims() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let owner = run capturedTestOwner(b"offered-meet.silk", 0)
  let first = run Shared<Lifetime>.make(Lifetime.Local {declaration: DeclarationId.copy(&owner), ordinal: 0})
  let second = run Shared<Lifetime>.make(Lifetime.Local {declaration: DeclarationId.copy(&owner), ordinal: 1})
  let wanted = run Shared<Lifetime>.make(Lifetime.Local {declaration: DeclarationId.copy(&owner), ordinal: 2})
  let universal = run Shared<Lifetime>.make(Lifetime.Parameter {declaration: DeclarationId.copy(&owner), ordinal: 0})
  let mut walker = Walker {
    callerRetentions: List<CallerRetention>.make(),
    unrun: List<bool>.make(), points: List<Point>.make(), loans: List<Loan>.make(), events: List<Event>.make(),
    frames: List<Frame>.make(), loops: List<Loop>.make(), held: List<List<usize>>.make(),
    definitions: List<Holding>.make(), holdingSources: List<HoldingSource>.make(), scopes: List<Scope>.make(), localCount: 3,
    cleanup: List<LoanCleanup>.make(), loopCleanup: List<LoopCleanup>.make(), exit: 0, entry: 1,
    outside: false, reason: BorrowStatus.Regions, guarded: List<usize>.make(),
    guardConsumed: Option<Location>.none(), retention: Retention.None, requirements: List<RetentionEdge>.make(),
    settled: true, retentionRelations: List<ImpliedGroup>.make(), wholeHolds: List<WholeHold>.make(), openContents: List<Shared<Lifetime>>.make(), unretained: List<usize>.make(), contested: List<Shared<Lifetime>>.make(), storing: false, inherited: BorrowStatus.Checked, storable: List<usize>.make(),
    refinements: List<Refinement>.make(), lexicalHolders: List<usize>.make(),
    paths: List<List<Step>>.make(),
    stores: List<StoreWindow>.make(),
    returns: List<StoreWindow>.make(),
    sealed: List<Location>.make(),
    unheld: List<Location>.make(),
    escaping: List<usize>.make(),
    supplied: List<Shared<Lifetime>>.make(),
  }
  run List<List<Step>>.append(&mut walker.paths, List<Step>.make())
  let mut at = usize.ZERO
  while at < 4 { drop run newPoint(&mut walker, usize.MAX) at = at + usize.ONE }
  run edge(&mut walker, 1, 2)
  run edge(&mut walker, 2, 3)
  run edge(&mut walker, 3, 0)
  let mut one = run symbolicTestLoan(&first, &universal, false)
  one.created = 1
  let mut two = run symbolicTestLoan(&second, &universal, false)
  two.created = 1
  two.place.root = 1
  let mut consumer = run symbolicTestLoan(&wanted, &universal, false)
  consumer.created = 3
  consumer.place.root = 2
  run List<Loan>.append(&mut walker.loans, move one)
  run List<Loan>.append(&mut walker.loans, move two)
  run List<Loan>.append(&mut walker.loans, move consumer)
  let mut members = List<Shared<Lifetime>>.make()
  run List<Shared<Lifetime>>.append(&mut members, Shared<Lifetime>.clone(&first))
  run List<Shared<Lifetime>>.append(&mut members, Shared<Lifetime>.clone(&second))
  let offered = run Lifetime.meet(List<Shared<Lifetime>>.asSlice(&members))
  run Testing.expect(run offeredMeetRelationProved(&walker, &owner, &offered, &wanted),
    "both known source regions cover the finite consumer of their meet")
  run List<Event>.append(&mut walker.events, Event {point: 2,
    place: Place {root: 1, steps: List<Step>.make()}, kind: Kind.End,
    span: Location.make(0, 1), target: Location.make(0, 1), loan: usize.MAX, consumesTarget: 0,
    refiner: usize.MAX, refinedDepth: 0, binders: List<usize>.make()})
  run Testing.expect(!run offeredMeetRelationProved(&walker, &owner, &offered, &wanted),
    "one ended source prevents the meet from covering a later consumer")
  List<Event>.clear(&mut walker.events)
  let missing = run Shared<Lifetime>.make(Lifetime.Local {declaration: DeclarationId.copy(&owner), ordinal: 3})
  run List<Shared<Lifetime>>.append(&mut members, move missing)
  let incomplete = run Lifetime.meet(List<Shared<Lifetime>>.asSlice(&members))
  run Testing.expect(!run offeredMeetRelationProved(&walker, &owner, &incomplete, &wanted),
    "a known member never hides another member with no authenticated loan mapping")
  let mut restored = List<Loan>.asMutSlice(&mut walker.loans)
  restored[1].precision = LoanPrecision.Unknown
  run Testing.expect(!run offeredMeetRelationProved(&walker, &owner, &offered, &wanted),
    "a known member never hides another member's unknown loan mapping")
  let mut exact = List<Loan>.asMutSlice(&mut walker.loans)
  exact[1].precision = LoanPrecision.Exact
  exact[1].parent = Option<Shared<Lifetime>>.none()
  exact[1].local = true
  run Testing.expect(!run offeredMeetRelationProved(&walker, &owner, &offered, &universal),
    "one function-local constituent cannot acquire the other member's universal parent")
  return ()
}


test effect fn regionChoicesKeepEverySourceConstraint() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run regionChoiceClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn choiceRelationsProved(walker: &Walker, owner: &DeclarationId, obligations: &[SafetyObligation]) -> bool
! OutOfMemoryError ? &mut Allocator {
  let words = List<u64>.make()
  let premises = List<RegionBound>.make()
  let mut symbolic = List<SymbolicRegion>.make()
  return run localRelationsProved(walker, owner, obligations, List<RegionBound>.asSlice(&premises),
    &mut symbolic,  List<u64>.asSlice(&words),
    List<u64>.asSlice(&words), 0, false)
}

effect fn regionChoiceClaims() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let owner = run capturedTestOwner(b"region-choices.silk", 0)
  let source = run Shared<Lifetime>.make(Lifetime.Local {declaration: DeclarationId.copy(&owner), ordinal: 0})
  let choice = run Shared<Lifetime>.make(Lifetime.Local {declaration: DeclarationId.copy(&owner), ordinal: 1})
  let useRegion = run Shared<Lifetime>.make(Lifetime.Local {declaration: DeclarationId.copy(&owner), ordinal: 2})
  let universal = run Shared<Lifetime>.make(Lifetime.Parameter {declaration: DeclarationId.copy(&owner), ordinal: 0})
  let mut walker = Walker {
    callerRetentions: List<CallerRetention>.make(),
    unrun: List<bool>.make(), points: List<Point>.make(), loans: List<Loan>.make(), events: List<Event>.make(),
    frames: List<Frame>.make(), loops: List<Loop>.make(), held: List<List<usize>>.make(),
    definitions: List<Holding>.make(), holdingSources: List<HoldingSource>.make(), scopes: List<Scope>.make(), localCount: 3,
    cleanup: List<LoanCleanup>.make(), loopCleanup: List<LoopCleanup>.make(), exit: 0, entry: 1,
    outside: false, reason: BorrowStatus.Regions, guarded: List<usize>.make(),
    guardConsumed: Option<Location>.none(), retention: Retention.None, requirements: List<RetentionEdge>.make(),
    settled: true, retentionRelations: List<ImpliedGroup>.make(), wholeHolds: List<WholeHold>.make(), openContents: List<Shared<Lifetime>>.make(), unretained: List<usize>.make(), contested: List<Shared<Lifetime>>.make(), storing: false, inherited: BorrowStatus.Checked, storable: List<usize>.make(),
    refinements: List<Refinement>.make(), lexicalHolders: List<usize>.make(),
    paths: List<List<Step>>.make(),
    stores: List<StoreWindow>.make(),
    returns: List<StoreWindow>.make(),
    sealed: List<Location>.make(),
    unheld: List<Location>.make(),
    escaping: List<usize>.make(),
    supplied: List<Shared<Lifetime>>.make(),
  }
  run List<List<Step>>.append(&mut walker.paths, List<Step>.make())
  let mut at = usize.ZERO
  while at < 4 { drop run newPoint(&mut walker, usize.MAX) at = at + usize.ONE }
  run edge(&mut walker, 1, 2)
  run edge(&mut walker, 2, 3)
  run edge(&mut walker, 3, 0)
  let mut producer = run symbolicTestLoan(&source, &universal, false)
  producer.created = 1
  let mut consumer = run symbolicTestLoan(&useRegion, &universal, false)
  consumer.created = 3
  consumer.place.root = 1
  run List<Loan>.append(&mut walker.loans, move producer)
  run List<Loan>.append(&mut walker.loans, move consumer)
  let mut obligations = List<SafetyObligation>.make()
  run List<SafetyObligation>.append(&mut obligations, retentionTestRelation(&choice, &useRegion, false))
  run Testing.expect(!run choiceRelationsProved(&walker, &owner, List<SafetyObligation>.asSlice(&obligations)),
    "an unmapped local atom remains unproved without a typing witness")
  run List<SafetyObligation>.append(&mut obligations, SafetyObligation.RegionChoice {
    origin: Origin {node: 1, location: Location.make(0, 1)}, region: Shared<Lifetime>.clone(&choice)})
  run Testing.expect(run choiceRelationsProved(&walker, &owner, List<SafetyObligation>.asSlice(&obligations)),
    "an authenticated unconstrained choice can cover this finite consumer")
  run List<SafetyObligation>.append(&mut obligations, retentionTestRelation(&source, &choice, false))
  run Testing.expect(run choiceRelationsProved(&walker, &owner, List<SafetyObligation>.asSlice(&obligations)),
    "a later source relation constrains the same choice")
  run List<Event>.append(&mut walker.events, Event {point: 2,
    place: Place {root: 0, steps: List<Step>.make()}, kind: Kind.End,
    span: Location.make(0, 1), target: Location.make(0, 1), loan: usize.MAX, consumesTarget: 0,
    refiner: usize.MAX, refinedDepth: 0, binders: List<usize>.make()})
  run Testing.expect(!run choiceRelationsProved(&walker, &owner, List<SafetyObligation>.asSlice(&obligations)),
    "consumer requirements cross the choice and still fail beyond its actual source's end")
  List<Event>.clear(&mut walker.events)
  List<SafetyObligation>.truncate(&mut obligations, 1)
  run List<SafetyObligation>.append(&mut obligations, SafetyObligation.RegionChoice {
    origin: Origin {node: 0, location: Location.make(0, 1)}, region: Shared<Lifetime>.clone(&choice)})
  run Testing.expect(!run choiceRelationsProved(&walker, &owner, List<SafetyObligation>.asSlice(&obligations)),
    "the choice witness must name its actual origin")
  List<SafetyObligation>.clear(&mut obligations)
  run List<SafetyObligation>.append(&mut obligations, SafetyObligation.RegionChoice {
    origin: Origin {node: 1, location: Location.make(0, 1)}, region: Shared<Lifetime>.clone(&choice)})
  run List<SafetyObligation>.append(&mut obligations, retentionTestRelation(&choice, &universal, false))
  run Testing.expect(!run choiceRelationsProved(&walker, &owner, List<SafetyObligation>.asSlice(&obligations)),
    "a body-scoped choice is never a universal premise")
  return ()
}

test effect fn accessProjectionKeepsSharedPointsAndActualReplacementOperands() -> ()
! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run sourceAccessClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn sourceAccessClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut events = List<SourceAccessEvent>.make()
  let mut path = Path {root: 0, through: false, steps: List<Step>.make(), indexes: List<NodeId>.make(),
    refiner: usize.MAX, refinedDepth: 0, binders: List<usize>.make()}
  run List<Step>.append(&mut path.steps, anyElement())
  let target = Location.make(8, 9)
  let statement = Location.make(8, 15)
  run sourceAccessEvent(&mut events, SourceGraph.EvalId {index: 0}, SourceControl.PointId {index: 0},
    &path, Kind.Move, Location.make(2, 4), Location.make(3, 4))
  List<Step>.asMutSlice(&mut path.steps)[0] = elementStep(4)
  run sourceAccessEvent(&mut events, SourceGraph.EvalId {index: 1}, SourceControl.PointId {index: 0},
    &path, Kind.Drop, Location.make(5, 7), Location.make(5, 7))
  run sourceAccessEvent(&mut events, SourceGraph.EvalId {index: 2}, SourceControl.PointId {index: 1},
    &path, Kind.Write, target, target)
  let mut rhs = List<bool>.make()
  run List<bool>.append(&mut rhs, false)
  run List<bool>.append(&mut rhs, false)
  run List<bool>.append(&mut rhs, false)
  let actualActivity: [SourceTruth; 2] = [SourceTruth.True, SourceTruth.True]
  sourceConsumedTarget(&mut events, 2, List<bool>.asSlice(&rhs), statement, &actualActivity)
  run Testing.expect(List<SourceAccessEvent>.asSlice(&events)[2].event.consumesTarget == 0
    && List<SourceAccessEvent>.asSlice(&events)[2].event.span.end == 9,
    "an earlier overlapping move outside this actual RHS cannot widen the replacement diagnostic")
  List<bool>.asMutSlice(&mut rhs)[1] = true
  let absentActivity: [SourceTruth; 2] = [SourceTruth.False, SourceTruth.True]
  sourceConsumedTarget(&mut events, 2, List<bool>.asSlice(&rhs), statement, &absentActivity)
  run Testing.expect(List<SourceAccessEvent>.asSlice(&events)[2].event.consumesTarget == 0
    && List<SourceAccessEvent>.asSlice(&events)[2].event.span.end == 9,
    "an unreachable RHS move cannot consume or widen a reachable assignment target")
  let possibleActivity: [SourceTruth; 2] = [SourceTruth.Undefined, SourceTruth.True]
  sourceConsumedTarget(&mut events, 2, List<bool>.asSlice(&rhs), statement, &possibleActivity)
  run Testing.expect(List<SourceAccessEvent>.asSlice(&events)[2].event.consumesTarget == 2,
    "possible RHS execution cannot turn an exact geometric overlap into a concrete conflict")
  List<SourceAccessEvent>.asMutSlice(&mut events)[2].event.consumesTarget = 0
  List<bool>.asMutSlice(&mut rhs)[1] = false
  List<bool>.asMutSlice(&mut rhs)[0] = true
  sourceConsumedTarget(&mut events, 2, List<bool>.asSlice(&rhs), statement, &actualActivity)
  run Testing.expect(List<SourceAccessEvent>.asSlice(&events)[2].event.consumesTarget == 2
    && List<SourceAccessEvent>.asSlice(&events)[2].event.target.end == 15,
    "an actual RHS move through an unknown index preserves the uncertain overlapping-assignment gate and statement span")
  List<bool>.asMutSlice(&mut rhs)[1] = true
  sourceConsumedTarget(&mut events, 2, List<bool>.asSlice(&rhs), statement, &actualActivity)
  run Testing.expect(List<SourceAccessEvent>.asSlice(&events)[2].event.consumesTarget == 1,
    "a definite RHS overlap dominates an uncertain one")
  let mut projected = List<Event>.make()
  while List<SourceAccessEvent>.length(&events) != usize.ZERO {
    if let Option<SourceAccessEvent>.Some {value} = move List<SourceAccessEvent>.pop(&mut events) {
      run List<Event>.insert(&mut projected, 0, move value.event)
    }
  }
  let rows = run sourceEventsAt(List<Event>.asSlice(&projected), 3)
  let all = List<List<usize>>.asSlice(&rows)
  run Testing.expect(List<usize>.length(&all[0]) == 2 && List<usize>.asSlice(&all[0])[0] == 0
    && List<usize>.asSlice(&all[0])[1] == 1 && List<usize>.asSlice(&all[1])[0] == 2
    && List<usize>.length(&all[2]) == 0,
    "all events at one actual CFG point survive indexing, while an empty point gains no event")
  let mut points = List<Point>.make()
  let mut at = usize.ZERO
  while at < 4 {
    run List<Point>.append(&mut points, Point {next: List<usize>.make(), uses: usize.MAX, read: usize.MAX,
      written: usize.MAX, defines: usize.MAX, initializes: usize.MAX, event: usize.MAX, span: target})
    at = at + usize.ONE
  }
  let allPoints = List<Point>.asMutSlice(&mut points)
  run List<usize>.append(&mut allPoints[0].next, 1)
  run List<usize>.append(&mut allPoints[1].next, 2)
  run List<usize>.append(&mut allPoints[2].next, 0)
  run List<usize>.append(&mut allPoints[2].next, 3)
  allPoints[3].initializes = 0
  let mut sources = List<usize>.make()
  run List<usize>.append(&mut sources, 2)
  let mut loops = List<Loop>.make()
  run List<Loop>.append(&mut loops, Loop {before: 0, header: 0, sources: move sources, end: 4, span: target})
  let moves: [usize; 2] = [0, 1]
  let initialized = run moveInitializations(List<Point>.asSlice(&points))
  let reached = run reaching(List<Point>.asSlice(&points), List<MoveInitialization>.asSlice(&initialized),
    List<Event>.asSlice(&projected), List<Loop>.asSlice(&loops), &moves, 1)
  run Testing.expect(reaches(List<u64>.asSlice(&reached.entering), 1, 1, 0)
    && reaches(List<u64>.asSlice(&reached.entering), 1, 1, 1),
    "each move at a shared actual point reaches the next point without a singleton event slot")
  run Testing.expect(reaches(List<u64>.asSlice(&reached.leaving), 1, 1, 0)
    && !reaches(List<u64>.asSlice(&reached.leaving), 1, 1, 1),
    "an exact field replacement kills its moved part but cannot clear an unknown-index move")
  run Testing.expect(!reaches(List<u64>.asSlice(&reached.entering), 1, 0, 0)
    && !reaches(List<u64>.asSlice(&reached.leaving), 1, 3, 0),
    "loop backedges remain excluded from forward move propagation and initialization clears the owner's moves")
  let uses: [u64; 4] = [0, 0, 0, 3]
  let kills: [u64; 4] = [0, 1, 0, 0]
  let live = run solveLiveness(List<Point>.asSlice(&points), 1, &uses, &kills)
  run Testing.expect(!reaches(List<u64>.asSlice(&live), 1, 0, 0)
    && reaches(List<u64>.asSlice(&live), 1, 0, 1)
    && reaches(List<u64>.asSlice(&live), 1, 1, 0),
    "a killed definition stops backward demand while a sibling definition stays live across the same cycle")
  let occupied: [bool; 4] = [true, false, false, false]
  let noEnds: [bool; 4] = [false, false, false, false]
  let absent = run releasedInstancePoints(List<Point>.asSlice(&points), 0, 0, &occupied, &noEnds)
  run Testing.expect(u64.bitAnd(List<u64>.asSlice(&absent)[0], maskOf(3)) == 0,
    "mere absence after creation cannot establish release")
  let explicitEnds: [bool; 4] = [false, true, false, false]
  let ended = run releasedInstancePoints(List<Point>.asSlice(&points), 0, 0, &occupied, &explicitEnds)
  run Testing.expect(u64.bitAnd(List<u64>.asSlice(&ended)[0], maskOf(3)) != 0,
    "an explicit end releases every created instance before the exit despite recreation on the backedge")
  run List<usize>.append(&mut List<Point>.asMutSlice(&mut points)[0].next, 3)
  let joined = run releasedInstancePoints(List<Point>.asSlice(&points), 0, 0, &occupied, &explicitEnds)
  run Testing.expect(u64.bitAnd(List<u64>.asSlice(&joined)[0], maskOf(3)) == 0,
    "a creating path bypassing the end prevents release at the join")
  let mut endpoints = List<PreparedSources.Endpoint>.make()
  let origin = Origin {node: 0, location: target}
  run List<PreparedSources.Endpoint>.append(&mut endpoints, PreparedSources.Endpoint {
    root: PreparedSources.Root.Node {node: NodeId {index: 0}, role: PreparedSources.EndpointRole.Storage},
    parent: Option<PreparedSources.EndpointId>.none(), selector: PreparedSources.Selector.Identity,
    shape: PreparedSources.ShapeId {index: 0}, origin: origin})
  run List<PreparedSources.Endpoint>.append(&mut endpoints, PreparedSources.Endpoint {
    root: PreparedSources.Root.Node {node: NodeId {index: 0}, role: PreparedSources.EndpointRole.Storage},
    parent: Option<PreparedSources.EndpointId>.some(PreparedSources.EndpointId {index: 0}),
    selector: PreparedSources.Selector.Field {ordinal: 0}, shape: PreparedSources.ShapeId {index: 0}, origin: origin})
  run List<PreparedSources.Endpoint>.append(&mut endpoints, PreparedSources.Endpoint {
    root: PreparedSources.Root.Node {node: NodeId {index: 0}, role: PreparedSources.EndpointRole.Storage},
    parent: Option<PreparedSources.EndpointId>.some(PreparedSources.EndpointId {index: 1}),
    selector: PreparedSources.Selector.Referent, shape: PreparedSources.ShapeId {index: 0}, origin: origin})
  let owned = sourceStorageRoot(List<PreparedSources.Endpoint>.asSlice(&endpoints), SourceGraph.Storage {
    endpoint: PreparedSources.EndpointId {index: 1}, temporary: Option<SourceGraph.EvalId>.some(SourceGraph.EvalId {index: 7})})
  let canonical = match owned {
    Option<SourceGraph.Storage>.Some {value} => sourceSameStorage(value, SourceGraph.Storage {
      endpoint: PreparedSources.EndpointId {index: 0}, temporary: Option<SourceGraph.EvalId>.some(SourceGraph.EvalId {index: 7})})
    _ => false
  }
  let crossed = sourceStorageRoot(List<PreparedSources.Endpoint>.asSlice(&endpoints), SourceGraph.Storage {
    endpoint: PreparedSources.EndpointId {index: 2}, temporary: Option<SourceGraph.EvalId>.some(SourceGraph.EvalId {index: 7})})
  let refused = match crossed { Option<SourceGraph.Storage>.None => true _ => false }
  run Testing.expect(canonical && refused,
    "whole-holder ancestry preserves the actual acquisition and cannot cross a referent into its descriptor owner")
  let control = SourceControlProjection {entry: 0, points: move points, unresolved: false}
  let mut occupancy = SourceLoanOccupancy {loan: 0, width: 1, entering: List<u64>.make(),
    leaving: List<u64>.make(), unresolved: false}
  at = usize.ZERO
  while at < 4 {
    run List<u64>.append(&mut occupancy.entering, 1)
    run List<u64>.append(&mut occupancy.leaving, 1)
    at = at + usize.ONE
  }
  List<u64>.asMutSlice(&mut occupancy.leaving)[1] = 0
  run Testing.expect(sourceHeldAt(&control, &occupancy, List<u64>.asSlice(&live), false, 1) == CallerSource.Absent
    && sourceHeldAt(&control, &occupancy, List<u64>.asSlice(&live), false, 2) == CallerSource.Actual,
    "a replacement's future read cannot keep the discarded source live, while a surviving real definition does")
  run Testing.expect(sourceHeldAt(&control, &occupancy, List<u64>.asSlice(&live), true, 2) == CallerSource.Unknown
    && sourceLiveJoin(CallerSource.Unknown, CallerSource.Actual) == CallerSource.Actual
    && sourceLiveActivity(CallerSource.Actual, SourceTruth.Undefined) == CallerSource.Unknown,
    "possible liveness alone cannot ground a conflict; independent actual evidence wins only for an actual acquisition")
  let rebound: [bool; 4] = [false, true, false, false]
  let unchanged: [bool; 4] = [false, false, false, false]
  run Testing.expect(!run readKeeping(List<Point>.asSlice(&control.points), 0, 2, 3, &rebound)
    && run readKeeping(List<Point>.asSlice(&control.points), 0, 1, 3, &rebound),
    "a rebind stops the original source, while the read at that same point still precedes its replacement")
  run Testing.expect(!run readKeeping(List<Point>.asSlice(&control.points), 0, 2, 1, &unchanged)
    && run readKeeping(List<Point>.asSlice(&control.points), 0, 2, 3, &unchanged),
    "a stale source path cannot cross its loan's reacquisition even when no holder is rebound")
  // Reuse this CFG with a second owner. One owner's acquisition cannot clear the other,
  // while two genuine acquisitions at the same actual point must both take effect.
  List<Event>.asMutSlice(&mut projected)[1].place.root = 1
  let mut initialized = run moveInitializations(List<Point>.asSlice(&control.points))
  let separate = run reaching(List<Point>.asSlice(&control.points), List<MoveInitialization>.asSlice(&initialized),
    List<Event>.asSlice(&projected), List<Loop>.asSlice(&loops), &moves, 1)
  run Testing.expect(!reaches(List<u64>.asSlice(&separate.leaving), 1, 3, 0)
    && reaches(List<u64>.asSlice(&separate.leaving), 1, 3, 1),
    "initializing one owner preserves a different owner's reaching move")
  run List<MoveInitialization>.append(&mut initialized, MoveInitialization {point: 3, root: 1})
  let together = run reaching(List<Point>.asSlice(&control.points), List<MoveInitialization>.asSlice(&initialized),
    List<Event>.asSlice(&projected), List<Loop>.asSlice(&loops), &moves, 1)
  run Testing.expect(!reaches(List<u64>.asSlice(&together.leaving), 1, 3, 0)
    && !reaches(List<u64>.asSlice(&together.leaving), 1, 3, 1),
    "all actual owners initialized at one CFG point clear their own moves")
  run Testing.expect(moveReachesEvent(List<Event>.asSlice(&projected), List<MoveInitialization>.asSlice(&initialized),
      &moves, &together, 1, 0, 1)
    && !moveReachesEvent(List<Event>.asSlice(&projected), List<MoveInitialization>.asSlice(&initialized),
      &moves, &together, 1, 1, 0),
    "a coincident access sees a preceding move but cannot see a later move at that same point")
  List<Event>.asMutSlice(&mut projected)[2].point = 0
  List<Event>.asMutSlice(&mut projected)[2].place.root = 1
  path.root = 1
  let mut afterWrite = List<SourceAccessEvent>.make()
  run sourceAccessEvent(&mut afterWrite, SourceGraph.EvalId {index: 3}, SourceControl.PointId {index: 0},
    &path, Kind.Read, target, target)
  if let Option<SourceAccessEvent>.Some {value} = move List<SourceAccessEvent>.pop(&mut afterWrite) {
    run List<Event>.append(&mut projected, move value.event)
  }
  run Testing.expect(moveReachesEvent(List<Event>.asSlice(&projected), List<MoveInitialization>.asSlice(&initialized),
      &moves, &together, 1, 1, 2)
    && !moveReachesEvent(List<Event>.asSlice(&projected), List<MoveInitialization>.asSlice(&initialized),
      &moves, &together, 1, 1, 3),
    "a coincident write clears a move only for the access that follows the write")
  let guards: [SourceGuardConsumption; 2] = [
    SourceGuardConsumption {subject: SourceGraph.EvalId {index: 1}, point: SourceControl.PointId {index: 3}, span: statement},
    SourceGuardConsumption {subject: SourceGraph.EvalId {index: 0}, point: SourceControl.PointId {index: 1}, span: target}]
  let refusals: [SourceAccessRefusal; 1] = [SourceAccessRefusal {point: SourceControl.PointId {index: 2}, reason: BorrowStatus.StoredLoans}]
  let present: [SourceTruth; 4] = [SourceTruth.True, SourceTruth.True, SourceTruth.True, SourceTruth.True]
  let before = sourcePrelude(&guards, &refusals, &present)
  run Testing.expect(match &before.guard { Option<Location>.Some {value} => value.end == target.end _ => false },
    "a genuine guard consumption before the first refusal keeps precedence even when inventory order differs")
  let absent: [SourceTruth; 4] = [SourceTruth.True, SourceTruth.False, SourceTruth.True, SourceTruth.True]
  let stopped = sourcePrelude(&guards, &refusals, &absent)
  run Testing.expect(match &stopped.guard { Option<Location>.None => true _ => false },
    "a guard reached only after the checker refusal cannot replace that earlier unsupported result")
  let late: [SourceTruth; 4] = [SourceTruth.True, SourceTruth.False, SourceTruth.False, SourceTruth.True]
  let resumed = sourcePrelude(&guards, &refusals, &late)
  run Testing.expect(match &resumed.guard { Option<Location>.Some {value} => value.end == statement.end _ => false },
    "an unreachable refusal cannot hide a genuinely reached later consuming guard")
  let maybe: [SourceTruth; 4] = [SourceTruth.True, SourceTruth.Undefined, SourceTruth.True, SourceTruth.True]
  let pending = sourcePrelude(&guards, &refusals, &maybe)
  run Testing.expect(pending.unresolved && match &pending.guard { Option<Location>.None => true _ => false },
    "uncertain guard execution stays unresolved and cannot manufacture a concrete rejection")
  return run sourceViewClaims()
}

// This fixture checks activity and branch equations, not prepared MatchView authorship.
// A possible binding use must remain Unknown, a sibling use of another actual subject must
// not lend this view, and noncompletion must not erase the preceding arm's ordinary extent.
effect fn sourceViewClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut rules = SourceProgram.make()
  let yes = run sourceBoolean(&mut rules, true)
  let maybe = SourceProgram.atom(&mut rules)
  let empty = List<SourceAtom>.make()
  let none = List<SourceAtom>.asSlice(&empty)
  let negated: [SourceAtom; 1] = [maybe]
  run SourceProgram.rule(&mut rules, maybe, none, &negated)
  let mut flow = SourceControl.Flow.make()
  let entry = run SourceControl.Flow.point(&mut flow, &mut rules)
  let acquired = run SourceControl.Flow.point(&mut flow, &mut rules)
  let branch = run SourceControl.Flow.point(&mut flow, &mut rules)
  let binding = run SourceControl.Flow.point(&mut flow, &mut rules)
  let sibling = run SourceControl.Flow.point(&mut flow, &mut rules)
  let ended = run SourceControl.Flow.point(&mut flow, &mut rules)
  let never = run SourceControl.Flow.point(&mut flow, &mut rules)
  run SourceProgram.fact(&mut rules, SourceControl.Flow.reachable(&flow, entry))
  run SourceControl.Flow.edge(&mut flow, entry, acquired, yes)
  run SourceControl.Flow.edge(&mut flow, acquired, branch, yes)
  run SourceControl.Flow.edge(&mut flow, branch, binding, maybe)
  run SourceControl.Flow.edge(&mut flow, branch, sibling, yes)
  run SourceControl.Flow.edge(&mut flow, binding, ended, yes)
  run SourceControl.Flow.edge(&mut flow, sibling, ended, yes)
  run SourceControl.Flow.edge(&mut flow, ended, acquired, yes)
  let control = run SourceControl.Flow.emit(move flow, &mut rules)
  let mut events = List<Event>.make()
  let mut at = usize.ZERO
  while at < 2 {
    let mut binders = List<usize>.make()
    run List<usize>.append(&mut binders, 31 + at)
    run List<Event>.append(&mut events, Event {point: binding.index + at,
      place: Place {root: 0, steps: List<Step>.make()}, kind: Kind.Read,
      span: Location.make(0, 1), target: Location.make(0, 1), loan: usize.MAX, consumesTarget: 0,
      refiner: usize.MAX, refinedDepth: 0, binders: move binders})
    at = at + usize.ONE
  }
  let mut views = List<SourceViewHold>.make()
  run List<SourceViewHold>.append(&mut views, SourceViewHold {
    loan: 0, active: yes, source: SourceGraph.EvalId {index: 31},
    scope: SourceVisit.ScopeId {index: 0}, point: acquired, extents: List<SourceViewExtent>.make()})
  let mut extent = List<SourceViewExtent>.make()
  run List<SourceViewExtent>.append(&mut extent, SourceViewExtent {from: acquired, to: never})
  run List<SourceViewHold>.append(&mut views, SourceViewHold {
    loan: 1, active: yes, source: SourceGraph.EvalId {index: 77},
    scope: SourceVisit.ScopeId {index: 0}, point: acquired, extents: move extent})
  run List<SourceViewHold>.append(&mut views, SourceViewHold {
    loan: 2, active: maybe, source: SourceGraph.EvalId {index: 88},
    scope: SourceVisit.ScopeId {index: 0}, point: acquired, extents: List<SourceViewExtent>.make()})
  let exits: [SourceVisit.ScopeExit; 1] = [SourceVisit.ScopeExit {scope: SourceVisit.ScopeId {index: 0},
    point: ended, cause: NodeId {index: 0}, kind: SourceVisit.ExitKind.Normal}]
  let projected = run sourceViewProjection(&control, List<SourceViewHold>.asSlice(&views),
    List<Event>.asSlice(&events), &exits, &mut rules)
  let result = run SourceProgram.solve(&rules)
  let all = List<SourceViewProjection>.asSlice(&projected)
  let ordinary = List<SourceAtom>.asSlice(&all[0].live)
  run Testing.expect(SourceSolution.truth(&result, ordinary[branch.index]) == SourceTruth.Undefined,
    "an unresolved binding-use edge remains unresolved view liveness at its predecessor")
  run Testing.expect(SourceSolution.truth(&result, ordinary[sibling.index]) == SourceTruth.False
    && SourceSolution.truth(&result, ordinary[entry.index]) == SourceTruth.False,
    "another actual subject's use and the next acquisition on a backedge cannot keep this view live")
  run Testing.expect(SourceSolution.truth(&result, List<SourceAtom>.asSlice(&all[1].live)[branch.index]) == SourceTruth.True
    && SourceSolution.truth(&result, List<SourceAtom>.asSlice(&all[1].ends)[branch.index]) == SourceTruth.False,
    "a view's ordinary arm extent survives later noncompletion without inventing a reachable owner-end path")
  run Testing.expect(SourceSolution.truth(&result, List<SourceAtom>.asSlice(&all[0].occupied)[sibling.index]) == SourceTruth.True
    && SourceSolution.truth(&result, List<SourceAtom>.asSlice(&all[0].released)[ended.index]) == SourceTruth.True
    && SourceSolution.truth(&result, List<SourceAtom>.asSlice(&all[0].survives)[ended.index]) == SourceTruth.False,
    "a view still retains its source after its last binding read and ends only at its actual scope exit")
  run Testing.expect(SourceSolution.truth(&result, List<SourceAtom>.asSlice(&all[0].occupied)[entry.index]) == SourceTruth.False
    && SourceSolution.truth(&result, List<SourceAtom>.asSlice(&all[0].released)[never.index]) == SourceTruth.False,
    "neither pre-acquisition absence nor unreachable completion is an actual view release")
  run Testing.expect(SourceSolution.truth(&result, List<SourceAtom>.asSlice(&all[2].occupied)[sibling.index]) == SourceTruth.Undefined
    && SourceSolution.truth(&result, List<SourceAtom>.asSlice(&all[2].released)[ended.index]) == SourceTruth.Undefined,
    "unresolved carried-view activity cannot certify either absence or release")
  return ()
}

test effect fn resultPlacementKeepsContinuationRootsAndStopsAtBoundaries() -> ()
! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run sourcePlacementClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn sourcePlacementClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  // The classifier consumes prepared component coordinates only; it performs no type
  // queries. Two continuation roots can reach the same current state at different depths.
  let ty = run Shared<Type>.make(Type.Unit)
  let mut components = List<PreparedSources.Component>.make()
  run List<PreparedSources.Component>.append(&mut components, PreparedSources.Component {
    selector: PreparedSources.Selector.Field {ordinal: 7}, ty: Shared<Type>.clone(&ty), inline: true,
    representation: Option<PreparedSources.RepresentationId>.none()})
  run List<PreparedSources.Component>.append(&mut components, PreparedSources.Component {
    selector: PreparedSources.Selector.Field {ordinal: 8}, ty: Shared<Type>.clone(&ty), inline: true,
    representation: Option<PreparedSources.RepresentationId>.none()})
  run List<PreparedSources.Component>.append(&mut components, PreparedSources.Component {
    selector: PreparedSources.Selector.Referent, ty: Shared<Type>.clone(&ty), inline: false,
    representation: Option<PreparedSources.RepresentationId>.none()})
  let mut shapes = List<PreparedSources.Shape>.make()
  run List<PreparedSources.Shape>.append(&mut shapes, PreparedSources.Shape {context: PreparedSources.ShapeContext.Body,
    ty: move ty, state: PreparedSources.ShapeState.Inline, components: move components})
  let mut paths = List<List<Step>>.make()
  run List<List<Step>>.append(&mut paths, List<Step>.make())
  let direct = SourceResults.Position {output: PreparedSources.MapId {index: 0}, projection: PreparedSources.ContractProjectionId {index: 0},
    root: PreparedSources.ContractContinuationId {index: 1}, current: PreparedSources.ContractContinuationId {index: 1}}
  let first = SourceResults.Position {output: direct.output, projection: direct.projection,
    root: PreparedSources.ContractContinuationId {index: 0}, current: PreparedSources.ContractContinuationId {index: 0}}
  let nested = SourceResults.Position {output: direct.output, projection: direct.projection, root: first.root, current: direct.current}
  let mut next = List<SourceResults.Position>.make()
  run List<SourceResults.Position>.append(&mut next, nested)
  let mut steps = List<SourceResults.PlacementStep>.make()
  run List<SourceResults.PlacementStep>.append(&mut steps, SourceResults.PlacementStep {position: direct,
    state: PreparedSources.ResidualStateId {index: 1}, component: PreparedSources.ComponentId {shape: PreparedSources.ShapeId {index: 0}, ordinal: 1},
    next: List<SourceResults.Position>.make()})
  run List<SourceResults.PlacementStep>.append(&mut steps, SourceResults.PlacementStep {position: first,
    state: PreparedSources.ResidualStateId {index: 0}, component: PreparedSources.ComponentId {shape: PreparedSources.ShapeId {index: 0}, ordinal: 0}, next: move next})
  run List<SourceResults.PlacementStep>.append(&mut steps, SourceResults.PlacementStep {position: nested,
    state: PreparedSources.ResidualStateId {index: 1}, component: PreparedSources.ComponentId {shape: PreparedSources.ShapeId {index: 0}, ordinal: 1},
    next: List<SourceResults.Position>.make()})
  let roots: [SourceResults.Position; 2] = [direct, first]
  let targets: [SourceResults.Position; 2] = [direct, nested]
  let shallow = run sourceSelectedField(List<PreparedSources.Shape>.asSlice(&shapes), &roots, &targets,
    List<SourceResults.PlacementStep>.asSlice(&steps), direct, 0, &mut paths)
  let deep = run sourceSelectedField(List<PreparedSources.Shape>.asSlice(&shapes), &roots, &targets,
    List<SourceResults.PlacementStep>.asSlice(&steps), nested, 0, &mut paths)
  let shallowPath = List<Step>.asSlice(&List<List<Step>>.asSlice(&paths)[shallow])
  let deepPath = List<Step>.asSlice(&List<List<Step>>.asSlice(&paths)[deep])
  run Testing.expect(shallowPath.length == 1 && sameStep(shallowPath[0], fieldStep(8))
    && deepPath.length == 2 && sameStep(deepPath[0], fieldStep(7)) && sameStep(deepPath[1], fieldStep(8)),
    "equal current states under distinct roots retain different exact selected output paths")
  let same = run copySteps(shallowPath)
  List<SourceResults.PlacementStep>.asMutSlice(&mut steps)[1].component.ordinal = 2
  let boundary = run sourceSelectedField(List<PreparedSources.Shape>.asSlice(&shapes), &roots, &targets,
    List<SourceResults.PlacementStep>.asSlice(&steps), nested, 0, &mut paths)
  run Testing.expect(boundary == usize.MAX,
    "a selected path through a noninline referent cannot become an owned field or whole anchor")
  let mut joined = Option<usize>.some(shallow)
  let duplicate = List<List<Step>>.length(&paths)
  run List<List<Step>>.append(&mut paths, move same)
  run Testing.expect(!sourceMergeField(List<List<Step>>.asSlice(&paths), &mut joined, duplicate),
    "alternate histories of an equal physical path do not become ambiguous placement or additional inputs")
  return ()
}

test effect fn resultSnapshotsCountActualSourcesAndRetainUnresolvedGuards() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run sourceSnapshotClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn sourceSnapshotClaims() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let module = run ModuleId.make(b"test", b"source", b"result-snapshot.silk")
  let owner = run DeclarationId.fromParts(move module, List<OwnerStep>.make())
  let first = run Shared<Lifetime>.make(Lifetime.Local {declaration: DeclarationId.copy(&owner), ordinal: 0})
  let second = run Shared<Lifetime>.make(Lifetime.Local {declaration: DeclarationId.copy(&owner), ordinal: 1})
  let caller = run Shared<Lifetime>.make(Lifetime.Parameter {declaration: DeclarationId.copy(&owner), ordinal: 0})
  let mut loans = List<Loan>.make()
  run List<Loan>.append(&mut loans, run symbolicTestLoan(&first, &caller, true))
  run List<Loan>.append(&mut loans, run symbolicTestLoan(&second, &first, true))
  let mut nodes = List<Node>.make()
  let unit = run Shared<Type>.make(Type.Unit)
  let ty = run Shared<Type>.make(Type.Reference {referent: move unit, access: Access.Shared,
    lifetime: Shared<Lifetime>.clone(&first)})
  run List<Node>.append(&mut nodes, Node {origin: Origin {node: 0, location: Location.make(0, 1)},
    kind: NodeKind.Expression {ty: move ty, form: Expression.Local {local: LocalId {index: 0}}}})
  let mut named = List<Shared<Lifetime>>.make()
  run List<Shared<Lifetime>>.append(&mut named, Shared<Lifetime>.clone(&first))
  let emptyRegions = List<Shared<Lifetime>>.make()
  let edges: [RetentionEdge; 1] = [RetentionEdge {source: 1, extent: 0}]
  let mut rules = SourceProgram.make()
  let yes = SourceProgram.atom(&mut rules)
  let no = SourceProgram.atom(&mut rules)
  let unresolved = SourceProgram.atom(&mut rules)
  let opposite = SourceProgram.atom(&mut rules)
  run SourceProgram.fact(&mut rules, yes)
  let none = List<SourceAtom>.make()
  let notOpposite: [SourceAtom; 1] = [opposite]
  let notUnresolved: [SourceAtom; 1] = [unresolved]
  run SourceProgram.rule(&mut rules, unresolved, List<SourceAtom>.asSlice(&none), &notOpposite)
  run SourceProgram.rule(&mut rules, opposite, List<SourceAtom>.asSlice(&none), &notUnresolved)
  let mut statuses = List<SourceAtom>.make()
  run List<SourceAtom>.append(&mut statuses, no)
  run List<SourceAtom>.append(&mut statuses, yes)
  run List<SourceAtom>.append(&mut statuses, unresolved)
  let mut snapshots = List<SourceResultSnapshot>.make()
  let mut decisions = List<SourcePolicy.ResultOutput>.make()
  let mut missingResults = List<SourceAtom>.make()
  let noRelations = List<ImpliedGroup>.make()
  let states = List<SourceAtom>.asSlice(&statuses)
  let mut at = usize.ZERO
  while at < states.length {
    let inputs: [SourceResultInput; 2] = [
      SourceResultInput {loan: 0, operand: 0, quality: SourceQuality {present: yes, stored: no, alternatives: no}},
      SourceResultInput {loan: 1, operand: 0, quality: SourceQuality {present: states[at], stored: no, alternatives: no}},
    ]
    let snapshot = run sourceResultSnapshot(List<Node>.asSlice(&nodes),
      &owner, List<Shared<Lifetime>>.asSlice(&emptyRegions), List<Loan>.asSlice(&loans), &inputs,
      List<Shared<Lifetime>>.asSlice(&named), &edges, NodeId {index: 0}, true, false, false, &mut rules)
    let actual = SourceResultCase {quality: inputs[1].quality, operand: 0, retained: false,
      field: 0, wholeField: true, declared: no}
    let facts = SourceResultFacts {known: true, stores: false, outside: false, forwarding: Forwarding.Operands,
      placedCount: 1, impliedKnown: no, mayOutlive: no, hasTyped: false}
    let decision = run sourceResultDecision(
      &List<Loan>.asSlice(&loans)[1], &actual, &facts, &snapshot, 1, &owner,
      List<Shared<Lifetime>>.asSlice(&named), List<ImpliedGroup>.asSlice(&noRelations), &mut rules)
    run List<SourceAtom>.append(&mut missingResults,
      run sourceResultCoverage(&mut rules, decision.kept, List<SourceAtom>.asSlice(&none)))
    run List<SourcePolicy.ResultOutput>.append(&mut decisions, move decision)
    run List<SourceResultSnapshot>.append(&mut snapshots, move snapshot)
    at = at + usize.ONE
  }
  // A conditional signature edge may complete a transitive route only on histories where
  // that earlier whole hold applies. The second, definite edge cannot erase that guard.
  let mut guardedGroups = List<SourceImpliedGroup>.make()
  let mut firstMembers = List<Shared<Lifetime>>.make()
  run List<Shared<Lifetime>>.append(&mut firstMembers, Shared<Lifetime>.clone(&first))
  let mut firstTargets = List<Shared<Lifetime>>.make()
  run List<Shared<Lifetime>>.append(&mut firstTargets, Shared<Lifetime>.clone(&second))
  run List<SourceImpliedGroup>.append(&mut guardedGroups, SourceImpliedGroup {
    group: ImpliedGroup {members: move firstMembers, container: move firstTargets}, active: unresolved})
  let mut secondMembers = List<Shared<Lifetime>>.make()
  run List<Shared<Lifetime>>.append(&mut secondMembers, Shared<Lifetime>.clone(&second))
  let mut secondTargets = List<Shared<Lifetime>>.make()
  run List<Shared<Lifetime>>.append(&mut secondTargets, Shared<Lifetime>.clone(&caller))
  run List<SourceImpliedGroup>.append(&mut guardedGroups, SourceImpliedGroup {
    group: ImpliedGroup {members: move secondMembers, container: move secondTargets}, active: yes})
  let origin: [Shared<Lifetime>; 1] = [Shared<Lifetime>.clone(&first)]
  let conditionalEscape = run sourceMayOutlive(List<SourceImpliedGroup>.asSlice(&guardedGroups), &origin,
    List<Shared<Lifetime>>.asSlice(&emptyRegions), &owner, &mut rules)
  {
    let mut groups = List<SourceImpliedGroup>.asMutSlice(&mut guardedGroups)
    groups[0].active = no
  }
  let absentEscape = run sourceMayOutlive(List<SourceImpliedGroup>.asSlice(&guardedGroups), &origin,
    List<Shared<Lifetime>>.asSlice(&emptyRegions), &owner, &mut rules)
  let solved = run SourceProgram.solve(&rules)
  run Testing.expect(SourceSolution.truth(&solved, conditionalEscape) == SourceTruth.Undefined
    && SourceSolution.truth(&solved, absentEscape) == SourceTruth.False,
    "field-release implication preserves unresolved and absent earlier whole-hold applicability through transitive paths")
  let results = List<SourceResultSnapshot>.asSlice(&snapshots)
  run Testing.expect(SourceSolution.truth(&solved, List<SourceAtom>.asSlice(&results[0].required)[1]) == SourceTruth.False
    && SourceSolution.truth(&solved, List<SourceAtom>.asSlice(&results[0].parents)[0]) == SourceTruth.False
    && SourceSolution.truth(&solved, results[0].complete) == SourceTruth.False,
    "a nonreaching historical definition supplies neither the missing-source gate nor the second actual carry")
  run Testing.expect(SourceSolution.truth(&solved, List<SourceAtom>.asSlice(&results[1].required)[1]) == SourceTruth.True
    && SourceSolution.truth(&solved, List<SourceAtom>.asSlice(&results[1].parents)[0]) == SourceTruth.True
    && SourceSolution.truth(&solved, results[1].complete) == SourceTruth.True,
    "the genuine second source activates pending retention and the original multiple-source snapshot guards")
  run Testing.expect(SourceSolution.truth(&solved, List<SourceAtom>.asSlice(&results[2].required)[1]) == SourceTruth.Undefined
    && SourceSolution.truth(&solved, results[2].complete) == SourceTruth.Undefined,
    "unresolved source applicability remains unresolved instead of selecting an eager complete-source proof")
  let retained = List<SourcePolicy.ResultOutput>.asSlice(&decisions)
  let missing = List<SourceAtom>.asSlice(&missingResults)
  run Testing.expect(SourceSolution.truth(&solved, missing[0]) == SourceTruth.False
    && SourceSolution.truth(&solved, missing[1]) == SourceTruth.True
    && SourceSolution.truth(&solved, missing[2]) == SourceTruth.Undefined,
    "zero result candidates remain missing coverage for retained or unresolved inputs, distinct from a grounded absent-source decision")
  run Testing.expect(SourceSolution.truth(&solved, retained[0].kept) == SourceTruth.False
    && SourceSolution.truth(&solved, retained[1].kept) == SourceTruth.True
    && SourceSolution.truth(&solved, retained[1].addStored) == SourceTruth.False
    && SourceSolution.truth(&solved, retained[1].addAlternatives) == SourceTruth.False
    && SourceSolution.truth(&solved, retained[2].kept) == SourceTruth.Undefined,
    "the result policy consumes actual required-source evidence without preserving a killed source or downgrading its proved placement")
  return ()
}

test effect fn sourceRetentionUsesPairedCasesAndOperationPoint() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run sourceRetentionClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn sourceRetentionClaims() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let owner = run capturedTestOwner(b"source-retention.silk", 0)
  let region = run Shared<Lifetime>.make(Lifetime.Local {declaration: DeclarationId.copy(&owner), ordinal: 0})
  let parent = run Shared<Lifetime>.make(Lifetime.Static)
  let mut loans = List<Loan>.make()
  run List<Loan>.append(&mut loans, run symbolicTestLoan(&region, &parent, true))
  let mut rules = SourceProgram.make()
  let yes = run sourceBoolean(&mut rules, true)
  let no = SourceProgram.atom(&mut rules)
  let quality = SourceQuality {present: yes, stored: no, alternatives: no}
  let mut cases = List<SourceCarryCase>.make()
  let mut each = usize.ZERO
  while each < 2 {
    run List<SourceCarryCase>.append(&mut cases, SourceCarryCase {field: 0,
      source: SourceGraph.InputCase {source: Option<SourceGraph.ValueId>.none(),
        placement: PreparedSources.EndpointId {index: 0}, direct: each == usize.ZERO,
        definition: Option<SourceControl.DefinitionId>.some(SourceControl.DefinitionId {index: 3 + each}),
        read: Option<SourceControl.ReadId>.some(SourceControl.ReadId {index: 5}),
        map: Option<PreparedSources.MapId>.none(), direction: SourceGraph.MapDirection.Forward,
        address: Option<SourceGraph.EvalId>.none(), contract: Option<PreparedSources.ContractRouteId>.none(),
        quality: SourceGraph.Cell {present: yes, stored: no, alternatives: no}}})
    each = each + usize.ONE
  }
  let mut positions = List<SourceCarryPosition>.make()
  run List<SourceCarryPosition>.append(&mut positions, SourceCarryPosition {
    node: NodeId {index: 0}, root: PreparedSources.EndpointId {index: 0}, value: SourceGraph.ValueId {index: 2}, leaf: SourceGraph.LeafId {index: 0}, loan: 0,
    operand: 0, since: 8, quality: quality, cases: move cases})
  let observation = SourceObservation {positions: move positions, other: List<SourceGraph.Input>.make(), unknown: no}
  let mut paths = List<List<Step>>.make()
  run List<List<Step>>.append(&mut paths, List<Step>.make())
  let mut slots = List<SlotSink>.make()
  run List<SlotSink>.append(&mut slots, SlotSink {path: List<KeptStep>.make(), view: true,
    referent: run Shared<Type>.make(Type.Unit), exclusive: false, kept: CallSink.Universal, approximate: CallSink.Local})
  let mut sinks = List<OperandSink>.make()
  run List<OperandSink>.append(&mut sinks, OperandSink {outer: CallSink.Local, whole: CallSink.Unknown,
    outerApproximate: CallSink.Local, wholeApproximate: CallSink.Local, span: Location.make(10, 11),
    holds: true, view: Option<Shared<Lifetime>>.none(), slots: move slots, undescribed: false})
  let mut state = run SourcePolicy.LoanState.make(&mut rules, 1)
  // An earlier operand can complete although a later operand prevents this operation from
  // executing. Its potential Q losses must not enter P through this skipped observation.
  let mut skippedPositions = List<SourceCarryPosition>.make()
  run List<SourceCarryPosition>.append(&mut skippedPositions, SourceCarryPosition {
    node: NodeId {index: 0}, root: PreparedSources.EndpointId {index: 0}, value: SourceGraph.ValueId {index: 2},
    leaf: SourceGraph.LeafId {index: 0}, loan: 0, operand: 0, since: 8,
    quality: SourceQuality {present: yes, stored: yes, alternatives: yes}, cases: List<SourceCarryCase>.make()})
  let skipped = SourceObservation {positions: move skippedPositions, other: List<SourceGraph.Input>.make(), unknown: no}
  let skippedSnapshot = run sourceBarrier(&skipped, &mut state, no, &mut rules)
  let snapshot = run sourceBarrier(&observation, &mut state, yes, &mut rules)
  let kept = run sourceKeepCarried(&observation, List<SourceQuality>.asSlice(&snapshot), List<Loan>.asSlice(&loans),
    List<List<Step>>.asSlice(&paths), &owner, List<OperandSink>.asSlice(&sinks), usize.MAX, 9, yes, &mut rules)
  let absent = run sourceKeepCarried(&observation, List<SourceQuality>.asSlice(&snapshot), List<Loan>.asSlice(&loans),
    List<List<Step>>.asSlice(&paths), &owner, List<OperandSink>.asSlice(&sinks), usize.MAX, 9, no, &mut rules)
  let mut intervals = List<SourceIntervalEffect>.make()
  run sourceConsume(&observation, 9, yes, &mut rules, &mut intervals)
  let noNodes = List<Node>.make()
  let noEdges = List<RetentionEdge>.make()
  let noRelations = List<ImpliedGroup>.make()
  let noHolds = List<SourceWholeHold>.make()
  let noRegions = List<Shared<Lifetime>>.make()
  let noPriorRelease = run sourceUnreachableField(List<Node>.asSlice(&noNodes), &owner, List<Loan>.asSlice(&loans),
    &observation, List<SourceQuality>.asSlice(&snapshot), 0, List<RetentionEdge>.asSlice(&noEdges),
    List<ImpliedGroup>.asSlice(&noRelations), true, List<SourceWholeHold>.asSlice(&noHolds),
    List<Shared<Lifetime>>.asSlice(&noRegions), &mut rules)
  // Reserve IDs in a different order from execution. The early read supplies the call;
  // its holder is then replaced before an event. A sibling branch never executes the call.
  let mut control = SourceControl.Flow.make()
  let entry = run SourceControl.Flow.point(&mut control, &mut rules)
  let readPoint = run SourceControl.Flow.point(&mut control, &mut rules)
  let callPoint = run SourceControl.Flow.point(&mut control, &mut rules)
  let sibling = run SourceControl.Flow.point(&mut control, &mut rules)
  let replacePoint = run SourceControl.Flow.point(&mut control, &mut rules)
  let eventPoint = run SourceControl.Flow.point(&mut control, &mut rules)
  let uncertainPoint = run SourceControl.Flow.point(&mut control, &mut rules)
  let undefined = SourceProgram.atom(&mut rules)
  let denied: [SourceAtom; 1] = [undefined]
  let none = List<SourceAtom>.make()
  run SourceProgram.rule(&mut rules, undefined, List<SourceAtom>.asSlice(&none), &denied)
  run SourceProgram.fact(&mut rules, SourceControl.Flow.reachable(&control, entry))
  run SourceControl.Flow.edge(&mut control, entry, readPoint, yes)
  run SourceControl.Flow.edge(&mut control, readPoint, callPoint, yes)
  run SourceControl.Flow.edge(&mut control, entry, sibling, yes)
  run SourceControl.Flow.edge(&mut control, callPoint, replacePoint, yes)
  run SourceControl.Flow.edge(&mut control, replacePoint, eventPoint, yes)
  run SourceControl.Flow.edge(&mut control, eventPoint, uncertainPoint, undefined)
  let component = SourceControl.ComponentId {index: 0}
  let lateRead = run SourceControl.Flow.read(&mut control, eventPoint, component)
  let earlyRead = run SourceControl.Flow.read(&mut control, readPoint, component)
  drop run SourceControl.Flow.define(&mut control, replacePoint, component, yes, SourceControl.Write.Strong)
  let original = run SourceControl.Flow.define(&mut control, entry, component, yes, SourceControl.Write.Strong)
  let reaching = run SourceControl.Flow.emit(move control, &mut rules)
  let before = match sourceFlowPair(&reaching, original, earlyRead) {
    Option<SourceAtom>.Some {value} => value
    _ => { return CompilerBug.panic(b"caller test lost its original early read pair") }
  }
  let after = match sourceFlowPair(&reaching, original, lateRead) {
    Option<SourceAtom>.Some {value} => value
    _ => { return CompilerBug.panic(b"caller test lost its killed late read pair") }
  }
  let retainedReach = run sourceOperationReach(&reaching, callPoint.index, &mut rules)
  let solved = run SourceProgram.solve(&rules)
  let reached = List<SourceAtom>.asSlice(&retainedReach.at)
  run Testing.expect(sourceCallerTruth(SourceSolution.truth(&solved, before), SourceTruth.False,
    SourceSolution.truth(&solved, reached[eventPoint.index])) == CallerSource.Actual
    && sourceCallerTruth(SourceSolution.truth(&solved, after), SourceTruth.False,
      SourceSolution.truth(&solved, reached[eventPoint.index])) == CallerSource.Absent,
    "caller retention authenticates its operand read before replacement, not the holder at the later access or ID order")
  run Testing.expect(sourceCallerTruth(SourceSolution.truth(&solved, before), SourceTruth.False,
    SourceSolution.truth(&solved, reached[sibling.index])) == CallerSource.Absent,
    "an actual source retained on one branch does not keep a loan live on a sibling branch")
  run Testing.expect(sourceCallerTruth(SourceSolution.truth(&solved, before), SourceTruth.False,
    SourceSolution.truth(&solved, reached[uncertainPoint.index])) == CallerSource.Unknown
    && sourceCallerTruth(SourceTruth.False, SourceTruth.True, SourceTruth.True) == CallerSource.Unknown,
    "unresolved operation applicability and missing source evidence cannot become a concrete conflict or an absence proof")
  run Testing.expect(!sourceSameStorage(SourceGraph.Storage {endpoint: PreparedSources.EndpointId {index: 0},
    temporary: Option<SourceGraph.EvalId>.some(SourceGraph.EvalId {index: 0})},
    SourceGraph.Storage {endpoint: PreparedSources.EndpointId {index: 0},
      temporary: Option<SourceGraph.EvalId>.some(SourceGraph.EvalId {index: 1})}),
    "repeated temporary acquisitions with equal endpoint paths are distinct canonical storage")
  run Testing.expect(SourceSolution.truth(&solved, noPriorRelease) == SourceTruth.False,
    "an exact body source with no prior whole hold cannot gain an empty universal field-release proof")
  let skippedQuality = List<SourceQuality>.asSlice(&skippedSnapshot)[0]
  run Testing.expect(SourceSolution.truth(&solved, skippedQuality.present) == SourceTruth.False
    && SourceSolution.truth(&solved, skippedQuality.stored) == SourceTruth.False
    && SourceSolution.truth(&solved, skippedQuality.alternatives) == SourceTruth.False,
    "an operation that does not execute imports no precision loss from an earlier completed operand")
  let actual = List<SourceRetentionEffect>.asSlice(&kept)
  let inactive = List<SourceRetentionEffect>.asSlice(&absent)
  let flights = List<SourceIntervalEffect>.asSlice(&intervals)
  run Testing.expect(actual.length == 2 && inactive.length == 2 && flights.length == 2,
    "two paired histories keep their own evidence without becoming two physical policy inputs")
  each = usize.ZERO
  while each < actual.length {
    run Testing.expect(SourceSolution.truth(&solved, actual[each].caller) == SourceTruth.True
      && SourceSolution.truth(&solved, actual[each].independent) == SourceTruth.False
      && SourceSolution.truth(&solved, actual[each].storing) == SourceTruth.False,
      "Same view slots locate both direct and indirect sources before caller-retention effects")
    run Testing.expect(SourceSolution.truth(&solved, inactive[each].caller) == SourceTruth.False
      && SourceSolution.truth(&solved, inactive[each].independent) == SourceTruth.False
      && SourceSolution.truth(&solved, inactive[each].storing) == SourceTruth.False,
      "an inactive actual operation cannot publish retention from an otherwise present source")
    let paired = match actual[each].source.definition {
      Option<SourceControl.DefinitionId>.Some {value} => value.index == 3 + each
      _ => false
    }
    let read = match actual[each].source.read { Option<SourceControl.ReadId>.Some {value} => value.index == 5 _ => false }
    run Testing.expect(paired && read && actual[each].point == 9
      && flights[each].from == 8 && flights[each].to == 9
      && SourceSolution.truth(&solved, flights[each].active) == SourceTruth.True,
      "retention and consumption preserve their exact definition/read and execution coordinates")
    each = each + usize.ONE
  }
  return ()
}
