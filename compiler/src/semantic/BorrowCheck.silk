/// What checking one body's loans and moves established.
pub enum Outcome {
  /// Every loan in the body is free of conflicts, and no moved place is used.
  Clear,
  /// An access conflicts with a live loan or uses a moved place, or a loop repeats with different
  /// moved places.
  Conflict,
  /// The body uses a form outside this slice; nothing is proved or rejected.
  NotChecked,
}

/// The outcome of checking one body. For a conflict, `access` is the rejected access or loop and
/// `earlier` the borrow or move it conflicts with, if any; otherwise `code` and `access` are unused.
///
/// Its spans count from the checked body's anchor, like the body's origins.
pub struct Verdict {
  pub outcome: Outcome
  /// For a clear body, `Checked` when [`regionClosed`] and nothing is pending, `Regions` otherwise;
  /// for an unchecked one, the reason.
  pub status: BorrowStatus
  pub code: RejectionCode
  pub access: Location
  pub earlier: Option<Location>
  /// Every conflict the body reports, the one above included, ordered by span as the bootstrap
  /// lists them; empty unless the body reports more than one.
  pub reports: List<Report>
}

/// One reported conflict: the rejected access and, when `related`, the borrow or move it conflicts
/// with at `earlier`.
pub struct Report {
  pub code: RejectionCode
  pub access: Location
  pub related: bool
  pub earlier: Location
}

impl Copy for Report {}

// Records a conflict unless one with the same code and span was already found.
effect fn addReport(reports: &mut List<Report>, report: Report) -> () ! OutOfMemoryError ? &mut Allocator {
  let found = List<Report>.asSlice(&reports.*)
  let mut at = usize.ZERO
  while at < found.length {
    if found[at].code == report.code && found[at].access.start == report.access.start && found[at].access.end == report.access.end {
      return ()
    }
    at = at + usize.ONE
  }
  run List<Report>.append(&mut reports.*, report)
  return ()
}

// The reports ordered by span, earlier first; reports with one span keep the order they were found.
effect fn bySpan(reports: &[Report]) -> List<Report> ! OutOfMemoryError ? &mut Allocator {
  let mut sorted = List<Report>.make()
  let mut at = usize.ZERO
  while at < reports.length {
    run List<Report>.append(&mut sorted, reports[at])
    let mut slot = List<Report>.length(&sorted) - usize.ONE
    while slot > usize.ZERO {
      let mut items = List<Report>.asMutSlice(&mut sorted)
      let previous = items[slot - usize.ONE]
      let current = items[slot]
      let later = previous.access.start > current.access.start
        || (previous.access.start == current.access.start && previous.access.end > current.access.end)
      if !later { break }
      items[slot - usize.ONE] = current
      items[slot] = previous
      slot = slot - usize.ONE
    }
    at = at + usize.ONE
  }
  return move sorted
}

fn verdict(outcome: Outcome, status: BorrowStatus) -> Verdict {
  return Verdict {outcome: outcome, status: status, code: RejectionCode.Unsupported, access: Location.make(usize.ZERO, usize.ZERO),
    earlier: Option<Location>.none(), reports: List<Report>.make()}
}

// The kind of one place step. Each kind numbers its own steps, so no field, element or member
// ordinal can stand for another kind of step.
enum StepKind {
  Field,
  Element,
  // A union member or variant payload; distinct members of one union are disjoint places.
  Member,
  // The step from a reference to its referent. A place through a reference names the referent's
  // storage, so a reborrow is a loan of that place (BORROW-005).
  Referent,
  // An index step whose value is unknown; it overlaps every element step.
  AnyElement,
  // A held loan replicated into every array element, never a source access path.
  RepeatedElement,
}

struct Step {
  kind: StepKind
  ordinal: usize
}

impl Copy for Step {}

fn fieldStep(index: usize) -> Step {
  return Step {kind: StepKind.Field, ordinal: index}
}

fn elementStep(index: usize) -> Step {
  return Step {kind: StepKind.Element, ordinal: index}
}

fn memberStep(tag: usize) -> Step {
  return Step {kind: StepKind.Member, ordinal: tag}
}

fn referent() -> Step {
  return Step {kind: StepKind.Referent, ordinal: usize.ZERO}
}

fn anyElement() -> Step {
  return Step {kind: StepKind.AnyElement, ordinal: usize.ZERO}
}

fn sameStep(left: Step, right: Step) -> bool {
  return left.kind == right.kind && left.ordinal == right.ordinal
}

// Whether `inner` lies behind a reference stored at `outer`: `outer`'s steps are a strict prefix of
// `inner`'s and the next step dereferences. Replacing the reference leaves its old referent alone.
fn behind(outer: &Place, inner: &Place) -> bool {
  if outer.root != inner.root {
    return false
  }
  let first = List<Step>.asSlice(&outer.steps)
  let second = List<Step>.asSlice(&inner.steps)
  if first.length >= second.length || second[first.length].kind != StepKind.Referent {
    return false
  }
  let mut at = usize.ZERO
  while at < first.length {
    if !sameStep(first[at], second[at]) {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

// Only a whole local whose actual type is a shared reference proves that consuming this
// descriptor cannot consume its referent. Projected, hidden and opaque places need their own
// type evidence; a shared loan alone says nothing about the descriptor's access.
fn sharedLocalDescriptor(locals: &[Local], place: &Place) -> bool {
  if place.root >= locals.length || List<Step>.length(&place.steps) != usize.ZERO { return false }
  return Shared<Type>.with<bool>(&locals[place.root].ty, fn(ty: &Type) -> bool {
    return match &ty.* {
      Type.Reference {access, ..} => access == Access.Shared
      _ => false
    }
  })
}

// A body local and its static projection path: field ordinals, or `anyElement` for an index.
struct Place {
  root: usize
  steps: List<Step>
}

struct Interval {
  from: usize
  to: usize
  definition: usize
  read: usize
  cleanup: bool
}

impl Copy for Interval {}

// How exactly the walk knows which values carry this loan. A conflict with an inexact loan leaves
// the body imprecise instead of rejecting it, except a `Stored` one.
// - `Stored`: a retaining local holder took the loan by a field store. The loan itself flows exactly,
//   so it is still rejected once required past its storage end, and its region proof is typing's
//   relation from the stored loan's region into the field's: the holder's region keeps every loan it
//   ever held, which over-approximates, and a requirement before the store is vacuous for this loan,
//   whose creation does not reach it. A call that cannot map it exactly leaves it `Unknown`.
// - `Alternatives`: the loan is one of a complete union of possible source loans. Every source must
//   satisfy a region proof, but a conflict with one possible source cannot establish a definite rejection.
// - `Unknown`: no complete mapping, so the loan cannot participate in region proofs.
enum LoanPrecision { Exact, Stored, Alternatives, Unknown }

// Whether region proofs may use a loan: its sources are exact, held by a field store, or a complete
// union of alternatives.
fn provable(precision: LoanPrecision) -> bool {
  return precision == LoanPrecision.Exact || precision == LoanPrecision.Stored || precision == LoanPrecision.Alternatives
}

struct Loan {
  place: Place
  exclusive: bool
  origin: Location
  // Evaluation-point ranges in which a value carrying this loan is in flight.
  intervals: List<Interval>
  // How exactly the walk knows which values carry this loan.
  precision: LoanPrecision
  // The regions typing gave the borrow, or none when the borrow has no typed node of its own.
  regions: List<Shared<Lifetime>>
  // Whether the loan borrows a place rooted in a body local, so its region is a body region even
  // when typing recorded none.
  local: bool
  // Storage provenance is separate from inner lifetime atoms retained by the borrowed type.
  borrowed: Option<Shared<Lifetime>>
  parent: Option<Shared<Lifetime>>
  crossed: bool
  created: usize
  // Whether the loan's value reached a call or callable that can keep it in a universal region, one
  // chosen before the body runs; it must then outlive the body wherever its creation reaches (R3
  // amendment 4).
  escapes: bool
  // The match subject node whose borrowed arm bindings hold this loan, or `usize.MAX`: accesses
  // through those bindings reach the subject place without conflicting with it (MATCH-002).
  binder: usize
  // The local an `effect` block binds when this loan is one of the block's own captures, taken by
  // the block's initializer, or `usize.MAX`.
  block: usize
  // A point the loan stays live to whether or not a holder uses it there, or `usize.MAX`: an unrun
  // `effect` block keeps its own captures to its scope end (EFFECT-OWN-001).
  until: usize
  // The referent of the reference the borrow is typed as, or none, and a call then judges a carried
  // loan by its whole operand.
  referent: Option<Shared<Type>>
  // Whether a result keeps the loan only because typing requires its region to outlive a caller
  // region the result names (`outlivesResult`): where the return-slot refutation decides that
  // relation, the walk leaves the loan's conflicts to it.
  bound: bool
}

enum Kind {
  Read,
  // A complete or projected replacement: it reinitializes the place.
  Write,
  // A transfer of ownership out of the place: it leaves the place without an owner.
  Move,
  // An explicit `drop`: it ends the place's remaining parts, so a part moved earlier is no use.
  Drop,
  SharedBorrow,
  ExclusiveBorrow,
  // A `match &mut` scrutinee: like a write it conflicts with every loan, but it replaces nothing.
  Update,
  // A `match place` scrutinee reads the tag of an owner whose payload parts may have moved: it
  // conflicts with every loan, and only a move of the owner or an ancestor is a use after move.
  Inspect,
  // Ends the remaining storage of one scope owner after its observing cleanup.
  End,
  // Ends the validity of a hidden owner's loans while its storage lives on: a temporary a viewing
  // binding keeps beyond its statement (BORROW-006).
  Expire,
}

struct Event {
  point: usize
  place: Place
  kind: Kind
  span: Location
  // The accessed place itself, which a loan conflict reports (OWN0011): the operand of a `move`,
  // otherwise `span`.
  target: Location
  // The loan this access creates, or `usize.MAX`.
  loan: usize
  // For a replacement, whether its right-hand side moves out of the target: 0 no, 1 yes, 2 only
  // through an unknown index.
  consumesTarget: usize
  // The place match whose binding this access goes through, or `usize.MAX` (see `Path`).
  refiner: usize
  refinedDepth: usize
  // The subjects of the borrowing matches whose bindings this access goes through.
  binders: List<usize>
}

struct Point {
  next: List<usize>
  // A holder local read here, or `usize.MAX`.
  uses: usize
  // The path within `uses` this read reaches, or `usize.MAX` when it may reach all of it.
  read: usize
  // The exact path within `uses` whose old value this point overwrites, or `usize.MAX`: what was
  // held within it is not read here.
  written: usize
  // A holder local bound here, or `usize.MAX`.
  defines: usize
  // A local whose binding initializes it here, or `usize.MAX`.
  initializes: usize
  // The access recorded here, or `usize.MAX`.
  event: usize
  span: Location
}

// A loop: the point before it, its header, the sources of its back edges, the end of its points,
// and the span the bootstrap reports for an incompatible header.
struct Loop {
  before: usize
  header: usize
  sources: List<usize>
  end: usize
  span: Location
}

// Immutable placement used by kept-slot predicates. Source histories stay in SourceCarryCase.
struct SourceSlotValue {
  loan: usize
  operand: usize
  field: usize
  direct: bool
}

impl Copy for SourceSlotValue {}

// The written place a node names: its root local, whether it is reached through a reference, its
// projection path with a `referent` step per dereference, and the index operands to evaluate
// first, in order.
struct Path {
  root: usize
  through: bool
  steps: List<Step>
  indexes: List<NodeId>
  // The subject node of the innermost `match place` whose binding names this place, or
  // `usize.MAX`, and how many leading steps name that subject. The binding denotes the payload
  // the match selected only until the subject place is written or moved (MATCH-001).
  refiner: usize
  refinedDepth: usize
  // The subjects of the borrowing matches whose bindings name this place, outermost first.
  binders: List<usize>
}

// A holding exists when any recorded source definition reaches its corresponding read.

// The roots a lexical scope releases on every path out of it. A statement scope holds only the
// hidden owners of the temporaries its statement, condition, guard or short-circuit operand
// borrows (BORROW-006); bindings belong to the nearest enclosing ordinary scope. `expiring` roots
// stop being valid here while their storage and cleanup stay with an enclosing scope.

/// The borrowed regions an initialized owner can observe during cleanup. Structural cleanup
/// observes only hook-bearing components, rather than every field of an aggregate.
pub struct LoanCleanup {
  pub regions: List<Shared<Lifetime>>
  pub unknown: bool
}

// Cleanup seen before a later definition in the same loop cannot observe that definition with
// the walk's forward-only interval recording. Keep that body unchecked until this is modeled.

// These are pending local validity requirements. They may keep a carried source live; they
// cannot prove their own validity and are never actual-parent or universal-premise edges.
struct RetentionEdge {
  source: usize
  extent: usize
}
impl Copy for RetentionEdge {}

fn retentionOrdinal(region: &Shared<Lifetime>, owner: &DeclarationId) -> usize {
  return Shared<Lifetime>.with<usize>(region, fn(value: &Lifetime) -> usize {
    if let Lifetime.Local {declaration, ordinal} = &value.* {
      if DeclarationId.equals(&declaration, owner) { return ordinal }
    }
    return usize.MAX
  })
}

effect fn localRetentionEdges(owner: &DeclarationId, obligations: &[SafetyObligation]) -> List<RetentionEdge>
! OutOfMemoryError ? &mut Allocator {
  let mut edges = List<RetentionEdge>.make()
  let mut at = usize.ZERO
  while at < obligations.length {
    if let SafetyObligation.RegionRelation {offered, wanted, inferredStatic, ..} = &obligations[at] {
      let pending = match &inferredStatic { Option<Shared<Lifetime>>.Some {..} => true _ => false }
      if !pending {
        let source = retentionOrdinal(&offered, owner)
        let extent = retentionOrdinal(&wanted, owner)
        if source != usize.MAX && extent != usize.MAX && source != extent {
          run List<RetentionEdge>.append(&mut edges, RetentionEdge {source: source, extent: extent})
        }
      }
    }
    at = at + usize.ONE
  }
  return move edges
}

fn retentionListed(values: &[usize], value: usize) -> bool {
  let mut at = usize.ZERO
  while at < values.length {
    if values[at] == value { return true }
    at = at + usize.ONE
  }
  return false
}

// A retained inner atom does not name this loan's own borrowed storage. Require both the actual
// outer borrow identity and its recorded region, and leave empty/unknown mappings untouched.
fn requiredLoan(loan: &Loan, owner: &DeclarationId, required: &[usize]) -> bool {
  if let Option<Shared<Lifetime>>.Some {value: borrowed} = &loan.borrowed {
    let ordinal = retentionOrdinal(&borrowed, owner)
    if ordinal != usize.MAX && retentionListed(required, ordinal) {
      let regions = List<Shared<Lifetime>>.asSlice(&loan.regions)
      let mut at = usize.ZERO
      while at < regions.length {
        if Lifetime.equalsShared(&regions[at], &borrowed) { return true }
        at = at + usize.ONE
      }
    }
  }
  return false
}

// Only a structural set of required ordinals; no source presence or proof is established here.
// The guarded source snapshot supplies the exact unmatched-source gate.
effect fn retentionClosure(named: &[Shared<Lifetime>], owner: &DeclarationId, edges: &[RetentionEdge]) -> List<usize>
! OutOfMemoryError ? &mut Allocator {
  let mut required = List<usize>.make()
  let mut at = usize.ZERO
  while at < named.length {
    let count = Lifetime.atomCount(&named[at])
    let mut part = usize.ZERO
    while part < count {
      let atom = Lifetime.atomAt(&named[at], part)
      let ordinal = retentionOrdinal(&atom, owner)
      if ordinal != usize.MAX && !retentionListed(List<usize>.asSlice(&required), ordinal) {
        run List<usize>.append(&mut required, ordinal)
      }
      part = part + usize.ONE
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < List<usize>.length(&required) {
    let entries = List<usize>.asSlice(&required)
    let extent = entries[at]
    let mut edge = usize.ZERO
    while edge < edges.length {
      if edges[edge].extent == extent && !retentionListed(List<usize>.asSlice(&required), edges[edge].source) {
        run List<usize>.append(&mut required, edges[edge].source)
      }
      edge = edge + usize.ONE
    }
    at = at + usize.ONE
  }
  return move required
}

// A write through a reference into storage the caller holds, or into a local, and the lifetime
// parameters of the body or a named enclosing declaration that its target's type names.
struct StoreWindow {
  span: Location
  regions: List<Shared<Lifetime>>
  // The local written, or `usize.MAX` for a write through a reference.
  holder: usize
}

// Immutable policy evidence for the accepted owned-storage escape refutation. Window
// production owns actual encounter/applicability; these predicates never resolve addresses.
struct EscapeSources<'proof> {
  loans: &'proof [Loan]
  geometry: &'proof [SourceSettledGeometry]
  activity: &'proof [SourceTruth]
  precision: &'proof [LoanPrecision]
  stores: &'proof [StoreWindow]
  returns: &'proof [StoreWindow]
  sealed: &'proof [Location]
  unheld: &'proof [Location]
  escaping: &'proof [usize]
}

struct EscapeResult {
  loan: usize
  unresolved: bool
}

struct SourceEscapeWindow {
  dispatch: usize
  evaluation: SourceGraph.EvalId
  point: SourceControl.PointId
  returned: bool
  window: StoreWindow
}

struct SourceEscapeSite {
  dispatch: usize
  evaluation: SourceGraph.EvalId
  active: SourceAtom
  span: Location
  sealed: bool
}

struct SourceEscapingLocal {
  dispatch: usize
  evaluation: SourceGraph.EvalId
  point: SourceControl.PointId
  local: usize
}

struct SourceEscapeInventory {
  windows: List<SourceEscapeWindow>
  sites: List<SourceEscapeSite>
  escaping: List<SourceEscapingLocal>
}

// A whole-value hold `finish` gave a result: the loan and the result node. Only a call its
// signature `described` bounds where in the result the loan can lie.

// A signature-retained source after a concrete call/construction point. The source predicate is
// the actual paired definition/read of that carry, not a union of unrelated reaching alternatives.
enum CallerSource { Absent, Actual, Unknown }

// A `match place` at `subject` selects the variant its bindings refine at point `test`.
struct Refinement {
  subject: usize
  test: usize
}

impl Copy for Refinement {}

// How lowering keeps a binding's temporaries (BORROW-006). It keeps every temporary of a viewing
// binding's initializer, and of a borrowing destructuring `let`'s subject, for the binding's scope;
// only a borrowed array of a viewing binding stays valid that long.

effect fn copyBinders(binders: &[usize]) -> List<usize> ! OutOfMemoryError ? &mut Allocator {
  let mut copied = List<usize>.make()
  let mut at = usize.ZERO
  while at < binders.length {
    run List<usize>.append(&mut copied, binders[at])
    at = at + usize.ONE
  }
  return move copied
}

effect fn copySteps(steps: &[Step]) -> List<Step> ! OutOfMemoryError ? &mut Allocator {
  let mut copied = List<Step>.make()
  let mut at = usize.ZERO
  while at < steps.length {
    run List<Step>.append(&mut copied, steps[at])
    at = at + usize.ONE
  }
  return move copied
}

// Whether `steps` names one exact place: no computed index and no step through a reference.
fn exactPath(steps: &[Step]) -> bool {
  let mut at = usize.ZERO
  while at < steps.length {
    if steps[at].kind == StepKind.AnyElement || steps[at].kind == StepKind.RepeatedElement
      || steps[at].kind == StepKind.Referent { return false }
    at = at + usize.ONE
  }
  return true
}

// Whether a read of the sub-place `read` contains the sub-place `held` a loan lies somewhere within,
// so the value read holds the loan. Elements are one place to a computed index.
fn pathContains(read: &[Step], held: &[Step]) -> bool {
  if read.length > held.length { return false }
  let mut at = usize.ZERO
  while at < read.length {
    let left = read[at]
    let right = held[at]
    if right.kind == StepKind.AnyElement { return false }
    let anyElement = left.kind == StepKind.AnyElement && right.kind == StepKind.Element
    if !anyElement && (left.kind != right.kind || left.ordinal != right.ordinal) { return false }
    at = at + usize.ONE
  }
  return true
}

// Selecting any element of a repeated value carries the same nested loans. Unlike
// pathContains (also used by writes), this does not claim the selection replaces every copy.
fn readContains(read: &[Step], held: &[Step]) -> bool {
  if read.length > held.length { return false }
  let mut at = usize.ZERO
  while at < read.length {
    let left = read[at]
    let right = held[at]
    if right.kind == StepKind.AnyElement { return false }
    let selectedRepeat = right.kind == StepKind.RepeatedElement
      && (left.kind == StepKind.Element || left.kind == StepKind.AnyElement)
    let anyElement = left.kind == StepKind.AnyElement && right.kind == StepKind.Element
    if !selectedRepeat && !anyElement && !sameStep(left, right) { return false }
    at = at + usize.ONE
  }
  return true
}

// Whether a value of `ty` can retain an alias loan, including static regions; unknown counts as retained.
effect fn retains(ty: &Shared<Type>, owner: &DeclarationId) -> bool ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut regions = List<Shared<Lifetime>>.make()
  let known = run bodyRetainedRegions(ty, owner, &mut regions)
  return !known || List<Shared<Lifetime>>.length(&regions) > usize.ZERO
}

// Appends the regions a value of `ty` can retain; `false` when they are unknown.
effect fn retainedBy(ty: &Shared<Type>, owner: &DeclarationId, regions: &mut List<Shared<Lifetime>>) -> bool
! OutOfMemoryError ? &mut Allocator {
  let representations = List<Option<Shared<Type>>>.make()
  return run Type.retainedRegions(ty, owner, List<Option<Shared<Type>>>.asSlice(&representations), &mut regions.*, true)
}

fn expressionType(nodes: &[Node], id: NodeId) -> Option<Shared<Type>> {
  if let NodeKind.Expression {ty, ..} = &nodes[id.index].kind {
    return Option<Shared<Type>>.some(Shared<Type>.clone(&ty))
  }
  return Option<Shared<Type>>.none()
}

// Whether `id`'s value can retain a non-static region; a statement node retains nothing. A callable
// value may hold capture loans its type does not name, so it always counts as retaining.
effect fn nodeRetains(nodes: &[Node], id: NodeId, owner: &DeclarationId) -> bool ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let found = expressionType(nodes, id)
  if let Option<Shared<Type>>.Some {value} = move found {
    if Shared<Type>.with<bool>(&value, callableValue) {
      return true
    }
    let retained = run retains(&value, owner)
    return retained
  }
  return false
}

// Whether a type is a fixed array, whose aggregate operands are its elements.
fn arrayType(node: &Type) -> bool {
  return match &node.* {
    Type.Array {..} => true
    _ => false
  }
}

// Whether `id` is a slice view, whose elements lie behind it rather than in its own storage.
fn sliceValue(nodes: &[Node], id: NodeId) -> bool {
  if let Option<Shared<Type>>.Some {value} = move expressionType(nodes, id) {
    return Shared<Type>.with<bool>(&value, fn(node: &Type) -> bool {
      return match &node.* {
        Type.Slice {..} => true
        _ => false
      }
    })
  }
  return false
}

// Reads the written place of `id`, or a path with root `usize.MAX` when it names no place.
effect fn pathOf(nodes: &[Node], id: NodeId) -> Path ! OutOfMemoryError ? &mut Allocator {
  let mut path = Path {root: usize.MAX, through: false, steps: List<Step>.make(), indexes: List<NodeId>.make(), refiner: usize.MAX, refinedDepth: usize.ZERO, binders: List<usize>.make()}
  run extendPath(nodes, id, usize.MAX, &mut path)
  return move path
}

// Reads the place `id` names when the value of `base`, which names no place, is held by its hidden
// owner (BORROW-006): `base`'s projections, indexes and dereferences extend that owner's root.
effect fn temporaryPath(nodes: &[Node], id: NodeId, base: NodeId) -> Path ! OutOfMemoryError ? &mut Allocator {
  let mut path = Path {root: usize.MAX, through: false, steps: List<Step>.make(), indexes: List<NodeId>.make(), refiner: usize.MAX, refinedDepth: usize.ZERO, binders: List<usize>.make()}
  run extendPath(nodes, id, base.index, &mut path)
  return move path
}

// The innermost operand of a place expression's projections, indexes and dereferences.
fn projectedBase(nodes: &[Node], id: NodeId) -> NodeId {
  if let NodeKind.Expression {form, ..} = &nodes[id.index].kind {
    return match &form {
      Expression.Field {value, ..} => projectedBase(nodes, value)
      Expression.Index {value, ..} => projectedBase(nodes, value)
      Expression.Dereference {value} => projectedBase(nodes, value)
      _ => id
    }
  }
  return id
}

// The root of a temporary's hidden owner, keyed by the node that produces the temporary. It
// follows the match subject roots, so it overlaps no local or subject.
fn temporaryRoot(nodes: &[Node], base: usize) -> usize {
  return usize.MAX / 4 + nodes.length + base
}

/// Which storage the loan walk ends beside the locals, by holder slot: slot `n` is the subject of a
/// match at node `n`, and slot `nodes.length + n` the hidden owner of the temporary node `n` a
/// borrow lends or a projection reads (BORROW-006). Their cleanup is observed like a local's.
pub effect fn storageNodes(nodes: &[Node]) -> List<bool> ! OutOfMemoryError ? &mut Allocator {
  let mut owning = List<bool>.make()
  let mut at = usize.ZERO
  while at < nodes.length + nodes.length {
    run List<bool>.append(&mut owning, false)
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < nodes.length {
    let mut owned = usize.MAX
    if let NodeKind.Expression {form, ..} = &nodes[at].kind {
      match &form {
        Expression.Match {subject, ..} => { owned = subject.index }
        Expression.Borrow {value, ..} => {
          let path = run pathOf(nodes, value)
          if path.root == usize.MAX { owned = nodes.length + projectedBase(nodes, value).index }
        }
        // A projection out of a value with no place may read it through its hidden owner.
        Expression.Field {..} => {
          let path = run pathOf(nodes, NodeId {index: at})
          if path.root == usize.MAX { owned = nodes.length + projectedBase(nodes, NodeId {index: at}).index }
        }
        Expression.Index {..} => {
          let path = run pathOf(nodes, NodeId {index: at})
          if path.root == usize.MAX { owned = nodes.length + projectedBase(nodes, NodeId {index: at}).index }
        }
        _ => {}
      }
    }
    if owned != usize.MAX {
      let mut marked = List<bool>.asMutSlice(&mut owning)
      marked[owned] = true
    }
    at = at + usize.ONE
  }
  return move owning
}

effect fn extendPath(nodes: &[Node], id: NodeId, temporary: usize, path: &mut Path) -> () ! OutOfMemoryError ? &mut Allocator {
  if id.index == temporary {
    path.root = temporaryRoot(nodes, temporary)
    return ()
  }
  if let NodeKind.Expression {form, ..} = &nodes[id.index].kind {
    match &form {
      Expression.Local {local} => {
        path.root = local.index
        return ()
      }
      Expression.Field {value, index, ..} => {
        run extendPath(nodes, value, temporary, &mut path.*)
        if path.root != usize.MAX {
          run List<Step>.append(&mut path.steps, fieldStep(index))
        }
        return ()
      }
      Expression.Index {value, index, element} => {
        run extendPath(nodes, value, temporary, &mut path.*)
        if path.root != usize.MAX {
          // A slice's elements live in its referent: indexing one reads through the slice as `.*`
          // does, so it reads the holder and keeps the loans it holds live.
          if sliceValue(nodes, value) {
            run List<Step>.append(&mut path.steps, referent())
            path.through = true
          }
          // A literal in-bounds index of a fixed array names its static element, the component a
          // move of it leaves; any other index may name every element.
          let mut step = anyElement()
          if element != usize.MAX { step = elementStep(element) }
          run List<Step>.append(&mut path.steps, step)
          run List<NodeId>.append(&mut path.indexes, index)
        }
        return ()
      }
      Expression.Dereference {value} => {
        run extendPath(nodes, value, temporary, &mut path.*)
        if path.root != usize.MAX {
          run List<Step>.append(&mut path.steps, referent())
          path.through = true
        }
        return ()
      }
      Expression.PatternBinding {subject, path: steps, access, ..} => {
        run bindingPath(nodes, subject, List<PlaceStep>.asSlice(&steps), access, &mut path.*)
        return ()
      }
      _ => {}
    }
  }
  return ()
}

// The root of the parts a match subject holds when it is not a place of this body: the subject was
// copied, consumed or evaluated into storage of its own, so it overlaps no local.
fn subjectRoot(subject: NodeId) -> usize {
  return usize.MAX / 4 + subject.index
}

// The place a pattern binding names. A place-addressing binding (`match place`, `&`, `&mut`) is a
// projection of the subject's own place; a copied or moved binding, or a binding of a subject with no
// place, is a projection of the subject's own storage. The subject's index operands were evaluated
// with the match, so the binding re-evaluates none.
effect fn bindingPath(nodes: &[Node], subject: NodeId, steps: &[PlaceStep], access: BindingAccess, path: &mut Path) -> ()
! OutOfMemoryError ? &mut Allocator {
  if access == BindingAccess.Place || access == BindingAccess.Shared || access == BindingAccess.Exclusive {
    let base = run pathOf(nodes, subject)
    if base.root != usize.MAX {
      path.root = base.root
      path.through = base.through
      path.refiner = base.refiner
      path.refinedDepth = base.refinedDepth
      if access == BindingAccess.Place {
        path.refiner = subject.index
        path.refinedDepth = List<Step>.length(&base.steps)
      }
      path.steps = move base.steps
      path.binders = move base.binders
    }
    // A borrowed binding reaches what its match lends to the arm: the subject place, or the
    // storage a subject with no place borrows.
    if access != BindingAccess.Place { run List<usize>.append(&mut path.binders, subject.index) }
  }
  if path.root == usize.MAX {
    path.root = subjectRoot(subject)
  }
  let mut at = usize.ZERO
  while at < steps.length {
    match &steps[at] {
      PlaceStep.Member {tag, ..} => { run List<Step>.append(&mut path.steps, memberStep(tag)) }
      PlaceStep.VariantField {tag, field} => {
        run List<Step>.append(&mut path.steps, memberStep(tag))
        run List<Step>.append(&mut path.steps, fieldStep(field))
      }
      PlaceStep.Field {index} => { run List<Step>.append(&mut path.steps, fieldStep(index)) }
      PlaceStep.Element {index} => { run List<Step>.append(&mut path.steps, elementStep(index)) }
    }
    at = at + usize.ONE
  }
  return ()
}

// The overlap of two places: 0 disjoint, 1 overlapping, 2 decided only by an unknown index.
fn overlap(left: &Place, right: &Place) -> usize {
  if left.root != right.root {
    return usize.ZERO
  }
  let first = List<Step>.asSlice(&left.steps)
  let second = List<Step>.asSlice(&right.steps)
  let mut unknown = false
  let mut at = usize.ZERO
  while at < first.length && at < second.length {
    if first[at].kind == StepKind.AnyElement || second[at].kind == StepKind.AnyElement {
      unknown = true
    } else if !sameStep(first[at], second[at]) {
      return usize.ZERO
    }
    at = at + usize.ONE
  }
  if unknown {
    return 2
  }
  return usize.ONE
}

// Whether an access through the bindings of `binders` reaches `loan`'s place by the loan itself.
fn lentTo(loan: &Loan, binders: &List<usize>) -> bool {
  if loan.binder == usize.MAX { return false }
  let through = List<usize>.asSlice(binders)
  let mut at = usize.ZERO
  while at < through.length {
    if through[at] == loan.binder { return true }
    at = at + usize.ONE
  }
  return false
}

// Whether a place names no element by an unknown index.
fn determined(place: &Place) -> bool {
  let steps = List<Step>.asSlice(&place.steps)
  let mut at = usize.ZERO
  while at < steps.length {
    if steps[at].kind == StepKind.AnyElement { return false }
    at = at + usize.ONE
  }
  return true
}

// Whether an access may replace the value of its place: a write, a move or drop, or an exclusive
// borrow or update, through which a callee or a later store can replace it.
fn replaces(kind: Kind) -> bool {
  return kind == Kind.Write || kind == Kind.Move || kind == Kind.Drop || kind == Kind.ExclusiveBorrow || kind == Kind.Update
}

// Whether `written` may name the first `depth` steps of `used`, or a prefix of them: replacing it
// replaces the subject a refined binding of `used` was selected from. An unknown index may name
// the refined element.
fn coversRefined(written: &Place, used: &Place, depth: usize) -> bool {
  if written.root != used.root { return false }
  let first = List<Step>.asSlice(&written.steps)
  let second = List<Step>.asSlice(&used.steps)
  if first.length > depth || depth > second.length { return false }
  let mut at = usize.ZERO
  while at < first.length {
    let indexed = first[at].kind == StepKind.AnyElement
      && (second[at].kind == StepKind.Element || second[at].kind == StepKind.AnyElement)
    if !indexed && !sameStep(first[at], second[at]) { return false }
    at = at + usize.ONE
  }
  return true
}

// The points control can reach from point `from` without passing `test`, where the match selects
// its variant again. Back edges count: a later iteration of a loop in the arm reaches it.
effect fn reachableAvoiding(points: &[Point], from: usize, test: usize) -> List<bool> ! OutOfMemoryError ? &mut Allocator {
  let mut seen = List<bool>.make()
  let mut at = usize.ZERO
  while at < points.length {
    run List<bool>.append(&mut seen, false)
    at = at + usize.ONE
  }
  let mut pending = List<usize>.make()
  run List<usize>.append(&mut pending, from)
  while List<usize>.length(&pending) > usize.ZERO {
    let last = List<usize>.length(&pending) - usize.ONE
    let point = List<usize>.remove(&mut pending, last)
    let next = List<usize>.asSlice(&points[point].next)
    let mut successor = usize.ZERO
    while successor < next.length {
      let target = next[successor]
      if !List<bool>.asSlice(&seen)[target] {
        let mut marked = List<bool>.asMutSlice(&mut seen)
        marked[target] = true
        if target != test { run List<usize>.append(&mut pending, target) }
      }
      successor = successor + usize.ONE
    }
  }
  return move seen
}

// The points one replacement reaches before its match selects again, computed once per pair.
struct ReplacementReach {
  source: usize
  test: usize
  seen: List<bool>
}

// Whether `loan` is live at `point` by its `until`: the point lies on a path from where the loan is
// taken to that end.
effect fn liveUntil(points: &[Point], reaches: &mut List<ReplacementReach>, loan: &Loan, point: usize) -> bool
! OutOfMemoryError ? &mut Allocator {
  let taken = run reachesAvoiding(points, &mut reaches.*, loan.created, point, usize.MAX)
  if !taken { return false }
  return run reachesAvoiding(points, &mut reaches.*, point, loan.until, usize.MAX)
}

// Whether control can pass from replacement point `from` to point `to` without passing `test`.
effect fn reachesAvoiding(points: &[Point], reaches: &mut List<ReplacementReach>, from: usize, to: usize, test: usize) -> bool
! OutOfMemoryError ? &mut Allocator {
  let known = List<ReplacementReach>.asSlice(&reaches.*)
  let mut at = usize.ZERO
  while at < known.length {
    if known[at].source == from && known[at].test == test { return List<bool>.asSlice(&known[at].seen)[to] }
    at = at + usize.ONE
  }
  let seen = run reachableAvoiding(points, from, test)
  let reached = List<bool>.asSlice(&seen)[to]
  run List<ReplacementReach>.append(&mut reaches.*, ReplacementReach {source: from, test: test, seen: move seen})
  return reached
}

// The point where the `match place` at `subject` selects its variant, or `usize.MAX`.
fn refinementTest(refinements: &[Refinement], subject: usize) -> usize {
  let mut at = usize.ZERO
  while at < refinements.length {
    if refinements[at].subject == subject { return refinements[at].test }
    at = at + usize.ONE
  }
  return usize.MAX
}

// Every access kind, for the codes an access can report.
effect fn everyKind() -> List<Kind> ! OutOfMemoryError ? &mut Allocator {
  let mut kinds = List<Kind>.make()
  run List<Kind>.append(&mut kinds, Kind.Read)
  run List<Kind>.append(&mut kinds, Kind.Write)
  run List<Kind>.append(&mut kinds, Kind.Move)
  run List<Kind>.append(&mut kinds, Kind.Drop)
  run List<Kind>.append(&mut kinds, Kind.SharedBorrow)
  run List<Kind>.append(&mut kinds, Kind.ExclusiveBorrow)
  run List<Kind>.append(&mut kinds, Kind.Update)
  run List<Kind>.append(&mut kinds, Kind.Inspect)
  run List<Kind>.append(&mut kinds, Kind.End)
  run List<Kind>.append(&mut kinds, Kind.Expire)
  return move kinds
}

// The code for a use of a loan's view after the loan expired.
fn expiredCode() -> RejectionCode {
  return RejectionCode.ExpiredLifetime
}

/// The codes loan liveness reports: every code an access conflicting with a live loan reports, and
/// the code of a use after a loan expired. A body that is not borrow-checked has not had its loan
/// lifetimes proved, so these are the codes it may be missing; its moves are checked regardless.
pub effect fn livenessCodes() -> List<RejectionCode> ! OutOfMemoryError ? &mut Allocator {
  let mut codes = List<RejectionCode>.make()
  run List<RejectionCode>.append(&mut codes, expiredCode())
  let every = run everyKind()
  let kinds = List<Kind>.asSlice(&every)
  let mut at = usize.ZERO
  while at < kinds.length {
    let mut exclusive = 0
    while exclusive < 2 {
      if let Option<RejectionCode>.Some {value} = move conflictCode(kinds[at], exclusive == 1) {
        let listed = List<RejectionCode>.asSlice(&codes)
        let mut seen = false
        let mut look = usize.ZERO
        while look < listed.length {
          if listed[look] == value { seen = true }
          look = look + usize.ONE
        }
        if !seen { run List<RejectionCode>.append(&mut codes, value) }
      }
      exclusive = exclusive + 1
    }
    at = at + usize.ONE
  }
  return move codes
}

fn conflictCode(kind: Kind, exclusive: bool) -> Option<RejectionCode> {
  if kind == Kind.ExclusiveBorrow || (kind == Kind.SharedBorrow && exclusive) {
    return Option<RejectionCode>.some(RejectionCode.LoanConflict)
  }
  if kind == Kind.Write || kind == Kind.Move || kind == Kind.Drop || kind == Kind.Update || kind == Kind.Inspect
    || (kind == Kind.Read && exclusive) {
    return Option<RejectionCode>.some(RejectionCode.AccessDuringLoan)
  }
  return Option<RejectionCode>.none()
}

// Different declared record fields store disjoint values, even when their lifetime arguments
// happen to be equal. Unknown elements and reference boundaries provide no such separation.
fn disjointFields(read: &[Step], held: &[Step]) -> bool {
  let mut at = usize.ZERO
  while at < read.length && at < held.length {
    if read[at].kind == StepKind.Field && held[at].kind == StepKind.Field
      && read[at].ordinal != held[at].ordinal { return true }
    if !sameStep(read[at], held[at]) || read[at].kind == StepKind.Referent { return false }
    at = at + usize.ONE
  }
  return false
}

// Where a write to `target` is reported: the target place, or the reference a dereferenced target
// writes through, as the bootstrap reports them.
fn writtenSpan(nodes: &[Node], target: NodeId) -> Location {
  if let NodeKind.Expression {form: Expression.Dereference {value}, ..} = &nodes[target.index].kind {
    return nodes[value.index].origin.location
  }
  return nodes[target.index].origin.location
}

fn loanLifetime(ty: &Type) -> Option<Shared<Lifetime>> {
  return match &ty.* {
    Type.Reference {lifetime, ..} => Option<Shared<Lifetime>>.some(Shared<Lifetime>.clone(&lifetime))
    Type.Slice {lifetime, ..} => Option<Shared<Lifetime>>.some(Shared<Lifetime>.clone(&lifetime))
    _ => Option<Shared<Lifetime>>.none()
  }
}

fn nodeLoanLifetime(nodes: &[Node], node: NodeId) -> Option<Shared<Lifetime>> {
  if let Option<Shared<Type>>.Some {value} = move expressionType(nodes, node) {
    return Shared<Type>.with<Option<Shared<Lifetime>>>(&value, loanLifetime)
  }
  return Option<Shared<Lifetime>>.none()
}

// The meet of the descriptors that reach the borrowed storage, not a lifetime mentioned by a
// nested field's type. A reborrow through several references is valid only while each of them
// is. A shared descriptor is Copy, so its referent stays valid for its own lifetime whatever
// path reached it: the chain ends at the first shared one, and a shared reborrow through shared
// references keeps the innermost lifetime. A reference to a descriptor slot is bounded by the
// slot's place instead.
effect fn borrowedPlaceLifetime(nodes: &[Node], node: NodeId) -> Option<Shared<Lifetime>> ! OutOfMemoryError ? &mut Allocator {
  let mut chain = List<Shared<Lifetime>>.make()
  run placeDescriptors(nodes, node, &mut chain)
  return run descriptorMeet(List<Shared<Lifetime>>.asSlice(&chain))
}

// The bound of a reborrow of the storage `descriptor` itself views, such as a slice reborrow.
effect fn descriptorLifetime(nodes: &[Node], descriptor: NodeId) -> Option<Shared<Lifetime>> ! OutOfMemoryError ? &mut Allocator {
  let mut chain = List<Shared<Lifetime>>.make()
  run descriptorChain(nodes, descriptor, &mut chain)
  return run descriptorMeet(List<Shared<Lifetime>>.asSlice(&chain))
}

effect fn descriptorMeet(chain: &[Shared<Lifetime>]) -> Option<Shared<Lifetime>> ! OutOfMemoryError ? &mut Allocator {
  if chain.length == usize.ZERO { return Option<Shared<Lifetime>>.none() }
  return Option<Shared<Lifetime>>.some(run Lifetime.meet(chain))
}

effect fn placeDescriptors(nodes: &[Node], node: NodeId, chain: &mut List<Shared<Lifetime>>) -> () ! OutOfMemoryError ? &mut Allocator {
  return match &nodes[node.index].kind {
    NodeKind.Expression {form: Expression.Dereference {value}, ..} => run descriptorChain(nodes, value, &mut chain.*)
    NodeKind.Expression {form: Expression.Field {value, ..}, ..} => run placeDescriptors(nodes, value, &mut chain.*)
    NodeKind.Expression {form: Expression.Index {value, ..}, ..} => {
      if sliceValue(nodes, value) { return run descriptorChain(nodes, value, &mut chain.*) }
      return run placeDescriptors(nodes, value, &mut chain.*)
    }
    NodeKind.Expression {form: Expression.PatternBinding {subject, access, ..}, ..} => {
      if access == BindingAccess.Shared || access == BindingAccess.Exclusive { return run placeDescriptors(nodes, subject, &mut chain.*) }
      return ()
    }
    _ => ()
  }
}

// Appends one descriptor's lifetime and, unless it is shared, the descriptors its own place is
// reached through.
effect fn descriptorChain(nodes: &[Node], descriptor: NodeId, chain: &mut List<Shared<Lifetime>>) -> () ! OutOfMemoryError ? &mut Allocator {
  if let Option<Shared<Lifetime>>.Some {value} = move nodeLoanLifetime(nodes, descriptor) {
    run List<Shared<Lifetime>>.append(&mut chain.*, move value)
    if !sharedDescriptor(nodes, descriptor) { run placeDescriptors(nodes, descriptor, &mut chain.*) }
  }
  return ()
}

fn sharedDescriptor(nodes: &[Node], node: NodeId) -> bool {
  if let Option<Shared<Type>>.Some {value} = move expressionType(nodes, node) {
    return Shared<Type>.with<bool>(&value, fn(ty: &Type) -> bool {
      return match &ty.* {
        Type.Reference {access, ..} => access == Access.Shared
        Type.Slice {access, ..} => access == Access.Shared
        _ => false
      }
    })
  }
  return false
}

// The referent of a borrow typed as a reference.
fn loanReferent(value: &Type) -> Option<Shared<Type>> {
  return match &value.* {
    Type.Reference {referent, ..} => Option<Shared<Type>>.some(Shared<Type>.clone(&referent))
    _ => Option<Shared<Type>>.none()
  }
}

// Actual loan declarations/events projected onto the source graph's reserved occurrences.
// No held-value list or policy-selected result participates in creating these identities.
struct SourceOwnership {
  encounters: List<usize>
  loans: List<Loan>
  events: List<Event>
  geometry: List<SourceAccessRefusal>
  geometryDemands: List<SourceAcquisitionGeometry>
  places: List<SourceLoanGeometry>
  geometryRefusals: List<SourceGeometryRefusal>
  eventGates: List<SourceEventGate>
  acquisitions: List<SourceInputAcquisition>
  views: List<SourceMatchView>
  observations: List<SourceOwnerObservation>
}

struct SourceOwnerObservation {
  owner: SourceVisit.OwnerId
  storage: SourceGraph.Storage
  evaluation: SourceGraph.EvalId
  point: SourceControl.PointId
  action: SourceVisitOwnerAction
  descriptor: usize
  hidden: bool
}
impl Copy for SourceOwnerObservation {}

// Open body goals enlarge retention eligibility only. Declared premises remain separate
// inputs to the final proof; neither this context nor a source-policy decision adds a premise.
struct RetentionContext {
  requirements: List<RetentionEdge>
  relations: List<ImpliedGroup>
  openContents: List<Shared<Lifetime>>
  settled: bool
}

effect fn retentionContext(owner: &DeclarationId, pending: bool, obligations: &[SafetyObligation])
  -> RetentionContext ! OutOfMemoryError ? &mut Allocator {
  let mut requirements = List<RetentionEdge>.make()
  if pending { requirements = run localRetentionEdges(owner, obligations) }
  // Open relations enlarge the possible source-retention graph only. The separately supplied
  // declared `premises` remain the sole assumptions for the region proof. Retained capture
  // contents make this retention summary incomplete.
  let mut retentionRelations = List<ImpliedGroup>.make()
  let mut openContents = List<Shared<Lifetime>>.make()
  let mut settled = true
  let mut obligation = usize.ZERO
  while obligation < obligations.length {
    match &obligations[obligation] {
      SafetyObligation.RegionRelation {offered, wanted, ..} => {
        let mut members = List<Shared<Lifetime>>.make()
        run appendAtoms(&mut members, &offered)
        let mut container = List<Shared<Lifetime>>.make()
        run appendAtoms(&mut container, &wanted)
        run List<ImpliedGroup>.append(&mut retentionRelations, ImpliedGroup {container: move container, members: move members})
      }
      SafetyObligation.Contents {region, ..} => {
        settled = false
        run appendAtoms(&mut openContents, &region)
      }
      _ => ()
    }
    obligation = obligation + usize.ONE
  }
  return RetentionContext {requirements: move requirements, relations: move retentionRelations,
    openContents: move openContents, settled: settled}
}

// All runtime identities are reserved before the sole source-domain/Flow emission. The
// returned traversal is consumed by Builder.reserve after its ownership handler inventory
// has been read; no placeholder checker or second traversal is involved.
struct SourceReservedBody {
  context: RetentionContext
  traversal: SourceVisit.Reservation
  ownership: SourceOwnership
  access: SourceAccessProjection
  escapes: SourceEscapeInventory
}

effect fn sourceReserveBody<'body>(prepared: &PreparedSources.SourcePreparation<'body>, cleanup: &[LoanCleanup])
  -> SourceReservedBody ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let context = run retentionContext(prepared.body.owner, prepared.body.pending, prepared.body.obligations)
  let mut traversal = run SourceVisit.reserve(prepared)
  // Construction inputs are physically activated here exactly once. Implicit references
  // acquire at input.usePoint even if another argument never completes the operation.
  let ownership = run sourceDeclaredLoans(prepared, &mut traversal)
  let results = run SourceResults.reserve(prepared, &traversal)
  let stores = run SourceStores.reserve(prepared, &traversal, &results)
  run sourceResultUses(prepared, &mut traversal, &ownership, cleanup, &stores)
  run SourceGraphSkeleton.installStores(&mut traversal.skeleton, prepared, move stores)
  // The graph owns compound result activation and retains empty/incomplete contributors.
  // BC supplies semantic terminal directives; it does not reconstruct contract routes.
  run SourceGraphSkeleton.installResults(&mut traversal.skeleton, prepared, move results)
  let access = run sourceAccessEvents(prepared, &traversal, cleanup)
  let escapes = run sourceEscapeInventory(prepared, &traversal)
  return SourceReservedBody {context: move context, traversal: move traversal, ownership: move ownership,
    access: move access, escapes: move escapes}
}

struct SourceBodyTail {
  input: SourceVisit.Input
  point: SourceControl.PointId
}

fn sourceBodyTail(reservation: &SourceVisit.Reservation, root: NodeId) -> SourceBodyTail {
  let trace = List<SourceVisitDispatch>.asSlice(&reservation.dispatch)
  if trace.length == usize.ZERO { return CompilerBug.panic(b"body has no actual dispatch") }
  let evaluation = match trace[0] { SourceVisitDispatch.Enter {evaluation} => evaluation
    _ => { return CompilerBug.panic(b"body dispatch does not start at its actual root") } }
  let actual = sourceVisitAt(List<SourceVisit.Visit>.asSlice(&reservation.visits), evaluation)
  if actual.node.index != root.index { return CompilerBug.panic(b"body dispatch changed its original root") }
  let scopes = List<SourceVisit.Scope>.asSlice(&reservation.scopes)
  let exits = List<SourceVisit.ScopeExit>.asSlice(&reservation.exits)
  let mut completion = Option<SourceControl.PointId>.none()
  let mut at = usize.ZERO
  while at < exits.length {
    if scopes[exits[at].scope.index].kind == SourceVisitScopeKind.Body && exits[at].kind == SourceVisitExitKind.Normal {
      if let Option<SourceControl.PointId>.Some {..} = completion { return CompilerBug.panic(b"body has duplicate normal scope completion") }
      completion = Option<SourceControl.PointId>.some(exits[at].point)
    }
    at = at + usize.ONE
  }
  let completed = match completion { Option<SourceControl.PointId>.Some {value} => value
    _ => { return CompilerBug.panic(b"body has no actual normal scope completion") } }
  return SourceBodyTail {input: SourceVisit.Input {node: root, evaluation: evaluation,
    usePoint: actual.execute, completed: actual.completed, access: actual.access, read: Option<PreparedSourcesInputRead>.none()}, point: completed}
}

effect fn sourceViewEvent(events: &mut List<Event>, event: &Event) -> () ! OutOfMemoryError ? &mut Allocator {
  run List<Event>.append(&mut events.*, Event {point: event.point,
    place: Place {root: event.place.root, steps: run copySteps(List<Step>.asSlice(&event.place.steps))},
    kind: event.kind, span: event.span, target: event.target, loan: event.loan, consumesTarget: event.consumesTarget,
    refiner: event.refiner, refinedDepth: event.refinedDepth, binders: run copyBinders(List<usize>.asSlice(&event.binders))})
  return ()
}

/// Prepare the actual body once, retaining one solved graph for classification.
// This consumes the prepared package once,
// emits the sole Flow once, binds actual dispatch decisions, and solves that same Program.
// Preparation and classification share the same immutable source evidence.
pub effect fn prepare<'body>(prepared: PreparedSources.SourcePreparation<'body>, cleanup: List<LoanCleanup>)
  -> Analysis<'body> ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut reserved = run sourceReserveBody(&prepared, List<LoanCleanup>.asSlice(&cleanup))
  let tail = sourceBodyTail(&reserved.traversal, prepared.body.root)
  let mut builder = run SourceGraphBuilder.reserve(move prepared, move reserved.traversal.skeleton)
  let mut paths = List<List<Step>>.make()
  run List<List<Step>>.append(&mut paths, List<Step>.make())
  run sourceResolveLoanGeometry(&mut builder, &mut reserved.ownership,
    List<SourceVisit.Owner>.asSlice(&reserved.traversal.owners), &mut paths)
  run sourceResolveAccessGeometry(&mut builder, &mut reserved.access,
    List<SourceVisit.Owner>.asSlice(&reserved.traversal.owners), &mut paths)
  let holders = SourceHolderProjection {reads: List<SourceSemanticRead>.make(), requests: List<SourceHolderRequest>.make(), uses: List<SourceHolderUse>.make(),
    missing: SourceProgram.atom(&mut builder.rules)}
  let dispatched = run sourceDispatchPolicies(&mut builder, List<SourceVisit.Visit>.asSlice(&reserved.traversal.visits),
    List<SourceVisitDispatch>.asSlice(&reserved.traversal.dispatch), List<SourceVisit.OwnerExit>.asSlice(&reserved.traversal.ownerExits),
    List<SourceVisit.Owner>.asSlice(&reserved.traversal.owners), List<SourceVisit.Subject>.asSlice(&reserved.traversal.subjects),
    &reserved.ownership, &reserved.access, move tail, List<LoanCleanup>.asSlice(&cleanup), &reserved.context, &mut paths, move holders)
  let held = run sourceViewHolds(&mut builder, List<SourceMatchView>.asSlice(&reserved.ownership.views),
    List<Loan>.length(&reserved.ownership.loans), &mut paths)
  let mut events = List<Event>.make()
  let mut eventGates = List<SourceEventGate>.make()
  let ownGates = List<SourceEventGate>.asSlice(&reserved.ownership.eventGates)
  let mut gate = usize.ZERO
  while gate < ownGates.length { run List<SourceEventGate>.append(&mut eventGates, ownGates[gate]) gate = gate + usize.ONE }
  let own = List<Event>.asSlice(&reserved.ownership.events)
  let access = List<SourceAccessEvent>.asSlice(&reserved.access.events)
  let mut at = usize.ZERO
  while at < own.length { run sourceViewEvent(&mut events, &own[at]) at = at + usize.ONE }
  at = usize.ZERO
  while at < access.length {
    if let Option<SourceAtom>.Some {value} = access[at].gate {
      run List<SourceEventGate>.append(&mut eventGates, SourceEventGate {event: List<Event>.length(&events), active: value})
    }
    run sourceViewEvent(&mut events, &access[at].event)
    at = at + usize.ONE
  }
  let views = run sourceViewProjection(&builder.reaching, List<SourceViewHold>.asSlice(&held.holds),
    List<Event>.asSlice(&events), List<SourceEventGate>.asSlice(&eventGates),
    List<SourceVisit.ScopeExit>.asSlice(&reserved.traversal.exits), &mut builder.rules)
  let projection = run sourceSolveProjection(move builder, move reserved.ownership, move dispatched.policy,
    move reserved.access, move reserved.traversal.owners, List<SourceVisit.Loop>.asSlice(&reserved.traversal.loops),
    List<SourceVisit.OwnerExit>.asSlice(&reserved.traversal.ownerExits), reserved.traversal.entry,
    move dispatched.holders, List<SourceBlockBinding>.asSlice(&dispatched.blocks),
    List<SourceVisitDispatch>.asSlice(&reserved.traversal.dispatch), List<SourceVisit.Visit>.asSlice(&reserved.traversal.visits),
    move views, held.missing)
  return Analysis<'body> {projection: move projection, context: move reserved.context,
    escapes: move reserved.escapes, snapshots: move dispatched.snapshots, refusals: move dispatched.refusals,
    inherited: move dispatched.constructions}
}

// An actual borrowed match view either acquires a place loan or holds loans of its already
// evaluated descriptor. Its authority and subject stay separate from canonical address proofs.
union SourceViewOrigin {
  Acquired {loan: usize},
  Carried {operand: SourceOperand},
}

struct SourceMatchView {
  origin: SourceViewOrigin
  record: usize
  result: SourceGraph.EvalId
  source: SourceGraph.EvalId
  scope: SourceVisit.ScopeId
  point: SourceControl.PointId
  extents: List<SourceViewExtent>
}

struct SourceViewExtent {
  from: SourceControl.PointId
  to: SourceControl.PointId
}
impl Copy for SourceViewExtent {}

// A view holds an existing source loan or its own authored acquisition. Neither form is a
// physical definition of a descriptor; repeated view sites keep their independent scopes.
struct SourceViewHold {
  loan: usize
  source: SourceGraph.EvalId
  scope: SourceVisit.ScopeId
  point: SourceControl.PointId
  active: SourceAtom
  extents: List<SourceViewExtent>
}
struct SourceViewHolds {
  holds: List<SourceViewHold>
  missing: SourceAtom
}

union SourceLifetimeOrigin {
  MatchView {source: SourceGraph.EvalId, point: SourceControl.PointId},
  CallableBinding {definition: SourceControl.DefinitionId, owner: SourceVisit.OwnerId},
}

// Lifetime evidence is separate from physical source occupancy. Both variants retain
// their actual acquisition authority; neither manufactures a descriptor or Flow definition.
struct SourceLifetimeProjection {
  origin: SourceLifetimeOrigin
  loan: usize
  live: List<SourceAtom>
  ends: List<SourceAtom>
  required: List<SourceAtom>
  occupied: List<SourceAtom>
  survives: List<SourceAtom>
  released: List<SourceAtom>
}

union SourceInputAcquisitionKind {
  Reference,
  CaptureReborrow {descriptor: SourceGraph.ValueId},
}
impl Copy for SourceInputAcquisitionKind {}

struct SourceInputAcquisition {
  result: SourceGraph.EvalId
  input: SourceGraph.EvalId
  acquisition: SourceGraph.EvalId
  map: PreparedSources.MapId
  loan: usize
  kind: SourceInputAcquisitionKind
}
impl Copy for SourceInputAcquisition {}

// Access syntax is independent of the source histories a read later attributes. In particular,
// these paths do not assert that a call-returned descriptor addresses its loan's original place.
struct SourceAccessEvent {
  evaluation: SourceGraph.EvalId
  event: Event
  original: usize
  gate: Option<SourceAtom>
  activity: SourceTruth
}

struct SourceGeometryAddress {
  evaluation: SourceGraph.EvalId
  root: PreparedSources.EndpointId
  selected: PreparedSources.EndpointId
}
impl Copy for SourceGeometryAddress {}

struct SourceGeometryRefusal {
  dispatch: usize
  point: SourceControl.PointId
  missing: SourceAtom
}

struct SourceAccessGeometry {
  evaluation: SourceGraph.EvalId
  address: SourceGeometryAddress
  dispatch: usize
}
impl Copy for SourceAccessGeometry {}

struct SourceGeometryPlace {
  place: Place
  active: SourceAtom
}

struct SourceLoanGeometry {
  alternatives: List<SourceGeometryPlace>
  missing: SourceAtom
}

struct SourceAcquisitionGeometry {
  address: SourceGeometryAddress
  dispatch: usize
  event: Event
  suffix: List<Step>
}

struct SourceSettledPlace {
  place: Place
  activity: SourceTruth
}

struct SourceSettledGeometry {
  alternatives: List<SourceSettledPlace>
  unresolved: bool
}

struct SourceEventGate {
  event: usize
  active: SourceAtom
}
impl Copy for SourceEventGate {}
// Diagnostic encounters follow the actual visitor trace, not allocation order of CFG
// points or Value IDs. Input completion is before that operand's cleanup.
union SourceEncounter {
  Enter,
  Finish,
  Input {evaluation: SourceGraph.EvalId},
}

fn sourceEncounter(trace: &[SourceVisitDispatch], evaluation: SourceGraph.EvalId, encounter: SourceEncounter,
  visits: &[SourceVisit.Visit]) -> usize {
  let mut found = usize.MAX
  let mut at = usize.ZERO
  while at < trace.length {
    let mut selected = false
    match &encounter {
      SourceEncounter.Enter => {
        selected = match trace[at] {
          SourceVisitDispatch.Enter {evaluation: actual} => actual.index == evaluation.index _ => false }
      }
      SourceEncounter.Finish => {
        selected = match trace[at] {
          SourceVisitDispatch.Finish {evaluation: actual} => actual.index == evaluation.index _ => false }
      }
      SourceEncounter.Input {evaluation: operand} => match trace[at] {
        SourceVisitDispatch.InputComplete {evaluation: actual, input} => {
          if actual.index == evaluation.index {
            let visit = sourceVisitAt(visits, actual)
            let inputs = List<SourceVisit.Input>.asSlice(&visit.inputs)
            selected = input < inputs.length && inputs[input].evaluation.index == operand.index
          }
        }
        _ => ()
      }
    }
    if selected {
      if found != usize.MAX { return CompilerBug.panic(b"ownership encounter has duplicate actual trace actions") }
      found = at
    }
    at = at + usize.ONE
  }
  if found == usize.MAX { return CompilerBug.panic(b"ownership encounter has no actual trace action") }
  return found
}

struct SourceAccessRefusal {
  uncertain: bool
  dispatch: usize
  point: SourceControl.PointId
  reason: BorrowStatus
}
struct SourceGuardConsumption {
  dispatch: usize
  subject: SourceGraph.EvalId
  point: SourceControl.PointId
  span: Location
}
struct SourceReplacementAccess {
  event: usize
  rhs: List<bool>
  statement: Location
}
struct SourceAccessProjection {
  events: List<SourceAccessEvent>
  geometry: List<SourceAccessGeometry>
  geometryMissing: Option<SourceAtom>
  geometryRefusals: List<SourceGeometryRefusal>
  refusals: List<SourceAccessRefusal>
  guardConsumed: List<SourceGuardConsumption>
  refinements: List<Refinement>
  replacements: List<SourceReplacementAccess>
}

struct SourceAccessPrelude {
  cutoff: usize
  guard: Option<Location>
  outside: Option<BorrowStatus>
  unresolved: bool
}

struct SourceRuntimeEvents {
  events: List<Event>
  uncertain: List<bool>
  unresolved: bool
}

struct MoveInitialization {
  point: usize
  root: usize
}
impl Copy for MoveInitialization {}

struct SourceMoveProjection {
  loops: List<Loop>
  initialized: List<MoveInitialization>
  moves: List<usize>
  reach: Reach
  width: usize
  unresolved: bool
}

enum MoveAccess { None, Unknown, Conflict }

// Geometry of a genuinely reaching move. The caller retains diagnostic ordering and the
// exact source event; this classifier neither chooses a reaching source nor assumes ID order.
fn movedAccess(event: &Event, source: &Event) -> MoveAccess {
  let shared = overlap(&source.place, &event.place)
  if shared == usize.ZERO { return MoveAccess.None }
  let ends = event.kind == Kind.Drop && covers(&event.place, &source.place)
    && List<Step>.length(&event.place.steps) < List<Step>.length(&source.place.steps)
  if ends || (event.kind == Kind.Write && covers(&event.place, &source.place)) { return MoveAccess.None }
  // Inspecting an owner's tag does not read its moved payload. A write behind a moved
  // descriptor still uses that descriptor, and a dynamic index can hit an exact moved slot.
  let partial = event.kind == Kind.Inspect && !covers(&source.place, &event.place)
  let used = shared == usize.ONE && (event.kind != Kind.Write || behind(&source.place, &event.place)) && !partial
  if used || (shared == 2 && !partial && determined(&source.place)) { return MoveAccess.Conflict }
  if !partial { return MoveAccess.Unknown }
  return MoveAccess.None
}

struct LoanAccessOverlap {
  overlap: usize
  indexed: bool
}
impl Copy for LoanAccessOverlap {}

fn loanPlaceAccessOverlap(locals: &[Local], loan: &Loan, place: &Place, event: &Event) -> LoanAccessOverlap {
  let mut shared = overlap(place, &event.place)
  let mut indexed = shared == 2
  if shared != usize.ZERO && behind(&event.place, place) {
    // Replacing a descriptor leaves its referent untouched. Consuming a known shared
    // descriptor does too; the exact same local dereference boundary is still mandatory.
    indexed = false
    if event.kind == Kind.Write { shared = usize.ZERO }
    else if event.kind == Kind.Move || event.kind == Kind.Drop {
      shared = 2
      if loan.precision == LoanPrecision.Exact && sharedLocalDescriptor(locals, &event.place) { shared = usize.ZERO }
    }
  }
  return LoanAccessOverlap {overlap: shared, indexed: indexed}
}

fn preciseLoanConflict(loan: &Loan, selected: LoanAccessOverlap, caller: CallerSource) -> bool {
  return (selected.overlap == usize.ONE || selected.indexed) && (loan.precision == LoanPrecision.Exact
    || (loan.precision == LoanPrecision.Stored && caller == CallerSource.Actual))
}

// Runtime applicability belongs to the event's own point. For example, an argument borrow
// occurs before a later never argument even when the enclosing result cannot complete.
// Stable point ordering preserves the caller's ordering of coincident actual events.
effect fn sourceRuntimeEvents<'body>(graph: &SourceGraphGraph<'body>, events: List<Event>, gates: &[SourceEventGate])
  -> SourceRuntimeEvents ! OutOfMemoryError ? &mut Allocator {
  let mut pending = move events
  let mut result = SourceRuntimeEvents {events: List<Event>.make(), uncertain: List<bool>.make(), unresolved: false}
  let points = List<SourceControl.Point>.asSlice(&SourceGraphGraph.control(graph).points)
  while List<Event>.length(&pending) != usize.ZERO {
    let original = List<Event>.length(&pending) - usize.ONE
    let event = match move List<Event>.pop(&mut pending) {
      Option<Event>.Some {value} => move value
      _ => { return CompilerBug.panic(b"runtime event projection lost an actual event") }
    }
    if event.point >= points.length { return CompilerBug.panic(b"runtime event has no actual CFG point") }
    let mut active = SourceGraphGraph.truth(graph, points[event.point].reachable)
    let mut gate = usize.ZERO
    while gate < gates.length {
      if gates[gate].event == original { active = sourceTruthAnd(active, SourceGraphGraph.truth(graph, gates[gate].active)) }
      gate = gate + usize.ONE
    }
    if active == SourceTruth.False { continue }
    let uncertain = active == SourceTruth.Undefined
    if uncertain { result.unresolved = true }
    let existing = List<Event>.asSlice(&result.events)
    let mut at = usize.ZERO
    while at < existing.length && existing[at].point < event.point { at = at + usize.ONE }
    run List<Event>.insert(&mut result.events, at, move event)
    run List<bool>.insert(&mut result.uncertain, at, uncertain)
  }
  return move result
}

effect fn sourceAccessEvent(events: &mut List<SourceAccessEvent>, evaluation: SourceGraph.EvalId,
  point: SourceControl.PointId, path: &Path, kind: Kind, span: Location, target: Location) -> ()
! OutOfMemoryError ? &mut Allocator {
  let original = List<SourceAccessEvent>.length(&events.*)
  run List<SourceAccessEvent>.append(&mut events.*, SourceAccessEvent {evaluation: evaluation,
    original: original, gate: Option<SourceAtom>.none(), activity: SourceTruth.True,
    event: Event {point: point.index, place: Place {root: path.root, steps: run copySteps(List<Step>.asSlice(&path.steps))},
      kind: kind, span: span, target: target, loan: usize.MAX, consumesTarget: usize.ZERO,
      refiner: path.refiner, refinedDepth: path.refinedDepth, binders: run copyBinders(List<usize>.asSlice(&path.binders))}})
  return ()
}

fn sourceAccessInput(actual: &SourceVisit.Visit, ordinal: usize, node: NodeId) -> SourceVisit.Input {
  let inputs = List<SourceVisit.Input>.asSlice(&actual.inputs)
  if ordinal >= inputs.length || inputs[ordinal].node.index != node.index {
    return CompilerBug.panic(b"ownership access lost its actual ordered input")
  }
  return inputs[ordinal]
}

// A borrowed rvalue binding has an actual selected address, but owns no Subject.
// Retain its occurrence now and resolve only canonical graph alternatives after reserve.
effect fn sourceRequireGeometry<'body>(prepared: &PreparedSources.SourcePreparation<'body>, reservation: &SourceVisit.Reservation,
  input: SourceVisit.Input, evaluation: SourceGraph.EvalId, projection: &mut SourceAccessProjection,
  path: &Path, point: SourceControl.PointId, dispatch: usize) -> bool ! OutOfMemoryError ? &mut Allocator {
  if path.root != usize.MAX { return true }
  if let Option<SourceGeometryAddress>.Some {value} = sourceDeferredAddress(prepared, reservation, input) {
    run List<SourceAccessGeometry>.append(&mut projection.geometry,
      SourceAccessGeometry {evaluation: evaluation, address: value, dispatch: dispatch})
    return true
  }
  run List<SourceAccessRefusal>.append(&mut projection.refusals,
    SourceAccessRefusal {uncertain: false, dispatch: dispatch, point: point, reason: BorrowStatus.Regions})
  return false
}

fn sourceDeferredAddress<'body>(prepared: &PreparedSources.SourcePreparation<'body>, reservation: &SourceVisit.Reservation,
  input: SourceVisit.Input) -> Option<SourceGeometryAddress> {
  let base = sourcePlaceBase(prepared, reservation, input)
  let borrowed = match &prepared.body.nodes[base.node.index].kind {
    NodeKind.Expression {form: Expression.PatternBinding {access, ..}, ..} =>
      access == BindingAccess.Shared || access == BindingAccess.Exclusive
    _ => false
  }
  if !borrowed { return Option<SourceGeometryAddress>.none() }
  let endpoints = List<PreparedSources.Endpoint>.asSlice(&prepared.endpoints)
  let mut selected = Option<PreparedSources.EndpointId>.none()
  let mut at = usize.ZERO
  while at < endpoints.length {
    let actual = match &endpoints[at].root {
      PreparedSourcesRoot.Node {node, category} => category == PreparedSourcesEndpointRole.Storage && node.index == input.node.index
      _ => false
    }
    if actual { if let Option<PreparedSources.EndpointId>.None = endpoints[at].parent {
      if let Option<PreparedSources.EndpointId>.Some {..} = selected { return CompilerBug.panic(b"deferred address has duplicate storage roots") }
      selected = Option<PreparedSources.EndpointId>.some(PreparedSources.EndpointId {index: at})
    } }
    at = at + usize.ONE
  }
  let root = match selected { Option<PreparedSources.EndpointId>.Some {value} => value
    _ => { return CompilerBug.panic(b"borrowed binding has no prepared address root") } }
  return Option<SourceGeometryAddress>.some(SourceGeometryAddress {evaluation: input.evaluation, root: root, selected: root})
}

effect fn sourceAcquisitionGeometry<'body>(prepared: &PreparedSources.SourcePreparation<'body>, reservation: &SourceVisit.Reservation,
  input: SourceVisit.Input, selected: PreparedSources.EndpointId, point: SourceControl.PointId, dispatch: usize,
  loan: usize, kind: Kind, span: Location, path: &Path, suffix: List<Step>, ownership: &mut SourceOwnership)
  -> () ! OutOfMemoryError ? &mut Allocator {
  let event = Event {point: point.index, place: Place {root: path.root, steps: run copySteps(List<Step>.asSlice(&path.steps))},
    kind: kind, span: span, target: span, loan: loan, consumesTarget: usize.ZERO, refiner: path.refiner,
    refinedDepth: path.refinedDepth, binders: run copyBinders(List<usize>.asSlice(&path.binders))}
  if path.root != usize.MAX { run List<Event>.append(&mut ownership.events, move event) return () }
  if let Option<SourceGeometryAddress>.Some {value: address} = sourceDeferredAddress(prepared, reservation, input) {
    let mut address = address
    let endpoints = List<PreparedSources.Endpoint>.asSlice(&prepared.endpoints)
    let mut current = selected
    let mut remaining = endpoints.length
    while current.index != address.root.index && remaining != usize.ZERO {
      current = match endpoints[current.index].parent { Option<PreparedSources.EndpointId>.Some {value} => value
        _ => { return CompilerBug.panic(b"acquisition selection is outside its actual operand storage") } }
      remaining = remaining - usize.ONE
    }
    if remaining == usize.ZERO { return CompilerBug.panic(b"acquisition address ancestry is cyclic") }
    address.selected = selected
    run List<SourceAcquisitionGeometry>.append(&mut ownership.geometryDemands, SourceAcquisitionGeometry {
      address: address, dispatch: dispatch, event: move event, suffix: move suffix})
  } else {
    run List<SourceAccessRefusal>.append(&mut ownership.geometry, SourceAccessRefusal {
      uncertain: false, dispatch: dispatch, point: point, reason: BorrowStatus.Regions})
  }
  return ()
}

// Canonical alternatives keep the original loan ID. Their access events carry the same
// guarded geometry; no alias creates a loan, source, owner or evaluation.
effect fn sourceResolveLoanGeometry<'body>(builder: &mut SourceGraphBuilder<'body>, ownership: &mut SourceOwnership,
  owners: &[SourceVisit.Owner], paths: &mut List<List<Step>>) -> () ! OutOfMemoryError ? &mut Allocator {
  if List<SourceLoanGeometry>.length(&ownership.places) != usize.ZERO { return CompilerBug.panic(b"loan geometry resolved twice") }
  let loans = List<Loan>.asSlice(&ownership.loans)
  let demands = List<SourceAcquisitionGeometry>.asSlice(&ownership.geometryDemands)
  let mut loan = usize.ZERO
  while loan < loans.length {
    let point = SourceControl.PointId {index: loans[loan].created}
    let active = List<SourceControl.Point>.asSlice(&builder.reaching.points)[point.index].reachable
    let mut geometry = SourceLoanGeometry {alternatives: List<SourceGeometryPlace>.make(), missing: SourceProgram.atom(&mut builder.rules)}
    if loans[loan].place.root != usize.MAX {
      run List<SourceGeometryPlace>.append(&mut geometry.alternatives, SourceGeometryPlace {
        place: Place {root: loans[loan].place.root, steps: run copySteps(List<Step>.asSlice(&loans[loan].place.steps))}, active: active})
    } else {
      let mut selected = usize.MAX
      let mut at = usize.ZERO
      while at < demands.length {
        if demands[at].event.loan == loan {
          if selected != usize.MAX { return CompilerBug.panic(b"actual loan has duplicate canonical geometry demands") }
          selected = at
        }
        at = at + usize.ONE
      }
      if selected == usize.MAX { geometry.missing = active }
      else {
        let demand = &demands[selected]
        if demand.event.point != point.index { return CompilerBug.panic(b"loan geometry left its actual acquisition point") }
        geometry = run sourceResolveAddress(&mut builder.*, demand.address, point, owners, &mut paths.*)
        run List<SourceGeometryRefusal>.append(&mut ownership.geometryRefusals, SourceGeometryRefusal {
          dispatch: demand.dispatch, point: point, missing: geometry.missing})
        let alternatives = List<SourceGeometryPlace>.asMutSlice(&mut geometry.alternatives)
        at = usize.ZERO
        while at < alternatives.length {
          let suffix = List<Step>.asSlice(&demand.suffix)
          let mut step = usize.ZERO
          while step < suffix.length { run List<Step>.append(&mut alternatives[at].place.steps, suffix[step]) step = step + usize.ONE }
          let mut before = usize.ZERO
          let events = List<Event>.asSlice(&ownership.events)
          while before < events.length {
            if events[before].point > point.index || (events[before].point == point.index
              && events[before].loan != usize.MAX && events[before].loan > loan) { break }
            before = before + usize.ONE
          }
          let gates = List<SourceEventGate>.asMutSlice(&mut ownership.eventGates)
          let mut gate = usize.ZERO
          while gate < gates.length { if gates[gate].event >= before { gates[gate].event = gates[gate].event + usize.ONE } gate = gate + usize.ONE }
          run List<SourceEventGate>.append(&mut ownership.eventGates, SourceEventGate {event: before, active: alternatives[at].active})
          run List<Event>.insert(&mut ownership.events, before, Event {point: point.index,
            place: Place {root: alternatives[at].place.root, steps: run copySteps(List<Step>.asSlice(&alternatives[at].place.steps))},
            kind: demand.event.kind, span: demand.event.span, target: demand.event.target, loan: loan, consumesTarget: usize.ZERO,
            refiner: demand.event.refiner, refinedDepth: demand.event.refinedDepth,
            binders: run copyBinders(List<usize>.asSlice(&demand.event.binders))})
          at = at + usize.ONE
        }
      }
    }
    run List<SourceLoanGeometry>.append(&mut ownership.places, move geometry)
    loan = loan + usize.ONE
  }
  return ()
}

effect fn sourceCanonicalPlace<'body>(builder: &SourceGraphBuilder<'body>, storage: SourceGraph.Storage,
  owners: &[SourceVisit.Owner], paths: &mut List<List<Step>>) -> Option<Place> ! OutOfMemoryError ? &mut Allocator {
  let prepared = SourceGraphBuilder.preparation(builder)
  let endpoints = List<PreparedSources.Endpoint>.asSlice(&prepared.endpoints)
  let owner = match sourceStorageRoot(endpoints, storage) { Option<SourceGraph.Storage>.Some {value} => value
    _ => { return Option<Place>.none() } }
  let mut root = usize.MAX
  match &endpoints[owner.endpoint.index].root {
    PreparedSourcesRoot.Local {local, category: endpointCategory} if endpointCategory == PreparedSourcesEndpointRole.Storage => {
      if let Option<SourceGraph.EvalId>.Some {..} = owner.temporary { return CompilerBug.panic(b"canonical local acquired a temporary identity") }
      root = local.index
    }
    _ => {
      let mut at = usize.ZERO
      while at < owners.length {
        if sourceOwnerStorage(builder, &owners[at], owner) {
          if root != usize.MAX { return CompilerBug.panic(b"canonical storage names duplicate owner acquisitions") }
          root = prepared.body.locals.length + at
        }
        at = at + usize.ONE
      }
    }
  }
  if root == usize.MAX { return Option<Place>.none() }
  let field = run sourceField(endpoints, owner.endpoint, storage.endpoint, &mut paths.*)
  if field == usize.MAX { return Option<Place>.none() }
  return Option<Place>.some(Place {root: root,
    steps: run copySteps(List<Step>.asSlice(&List<List<Step>>.asSlice(&paths.*)[field]))})
}

// A selection's coverage is exhaustive evidence; positive aliases supply only its
// canonical alternatives. Every alternative retains its own carrier missing gate.
effect fn sourceResolveAddress<'body>(builder: &mut SourceGraphBuilder<'body>, address: SourceGeometryAddress,
  point: SourceControl.PointId, owners: &[SourceVisit.Owner], paths: &mut List<List<Step>>) -> SourceLoanGeometry
! OutOfMemoryError ? &mut Allocator {
  let empty = List<SourceAtom>.make()
  let none = List<SourceAtom>.asSlice(&empty)
  let active = List<SourceControl.Point>.asSlice(&builder.reaching.points)[point.index].reachable
  let coverage = run sourceSelectionCoverage(&mut builder.*, address.evaluation, address.root, true, active)
  let mut result = SourceLoanGeometry {alternatives: List<SourceGeometryPlace>.make(), missing: coverage.missing}
  let mut gaps = List<SourceAtom>.make()
  run List<SourceAtom>.append(&mut gaps, coverage.missing)
  if !coverage.matched { run List<SourceAtom>.append(&mut gaps, active) }
  let mut present = List<SourceAtom>.make()
  let mut at = usize.ZERO
  while at < SourceGraphBuilder.aliases(&builder.*).length {
    let aliasEvaluation = SourceGraphBuilder.aliases(&builder.*)[at].evaluation
    let aliasEndpoint = SourceGraphBuilder.aliases(&builder.*)[at].endpoint
    let aliasActive = SourceGraphBuilder.aliases(&builder.*)[at].active
    let aliasStorage = SourceGraphBuilder.aliases(&builder.*)[at].storage
    if aliasEvaluation.index == address.evaluation.index && aliasEndpoint.index == address.selected.index {
      let demanded: [SourceAtom; 2] = [active, aliasActive]
      let missing = SourceGraphBuilder.aliasMissing(&builder.*, at)
      let incomplete: [SourceAtom; 3] = [active, aliasActive, missing]
      run List<SourceAtom>.append(&mut gaps, run SourcePolicy.conjunction(&mut builder.rules, &incomplete, none))
      let required: [SourceAtom; 3] = [active, aliasActive, coverage.complete]
      let excluded: [SourceAtom; 1] = [missing]
      let accepted = run SourcePolicy.conjunction(&mut builder.rules, &required, &excluded)
      match move run sourceCanonicalPlace(&builder.*, aliasStorage, owners, &mut paths.*) {
        Option<Place>.Some {value} => {
          run List<SourceAtom>.append(&mut present, accepted)
          run List<SourceGeometryPlace>.append(&mut result.alternatives, SourceGeometryPlace {place: move value, active: accepted})
        }
        _ => { run List<SourceAtom>.append(&mut gaps, run SourcePolicy.conjunction(&mut builder.rules, &demanded, none)) }
      }
    }
    at = at + usize.ONE
  }
  let required: [SourceAtom; 1] = [active]
  run List<SourceAtom>.append(&mut gaps, run SourcePolicy.conjunction(&mut builder.rules, &required, List<SourceAtom>.asSlice(&present)))
  result.missing = run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&gaps))
  return move result
}

effect fn sourceResolveAccessGeometry<'body>(builder: &mut SourceGraphBuilder<'body>, access: &mut SourceAccessProjection,
  owners: &[SourceVisit.Owner], paths: &mut List<List<Step>>) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut recorded = Intrinsic.replace(access.events, List<SourceAccessEvent>.make())
  let mut gaps = List<SourceAtom>.make()
  while List<SourceAccessEvent>.length(&recorded) != usize.ZERO {
    let event = List<SourceAccessEvent>.remove(&mut recorded, usize.ZERO)
    if event.event.place.root != usize.MAX { run List<SourceAccessEvent>.append(&mut access.events, move event) continue }
    let demands = List<SourceAccessGeometry>.asSlice(&access.geometry)
    let mut demand = usize.MAX
    let mut at = usize.ZERO
    while at < demands.length {
      if demands[at].evaluation.index == event.evaluation.index {
        if demand != usize.MAX { return CompilerBug.panic(b"deferred access has duplicate occurrence demands") }
        demand = at
      }
      at = at + usize.ONE
    }
    if demand == usize.MAX { return CompilerBug.panic(b"unowned access has no deferred address demand") }
    let point = SourceControl.PointId {index: event.event.point}
    let resolved = run sourceResolveAddress(&mut builder.*, demands[demand].address, point, owners, &mut paths.*)
    run List<SourceAtom>.append(&mut gaps, resolved.missing)
    run List<SourceGeometryRefusal>.append(&mut access.geometryRefusals, SourceGeometryRefusal {
      dispatch: demands[demand].dispatch, point: point, missing: resolved.missing})
    let mut alternatives = move resolved.alternatives
    while List<SourceGeometryPlace>.length(&alternatives) != usize.ZERO {
      let geometry = List<SourceGeometryPlace>.remove(&mut alternatives, usize.ZERO)
      run List<SourceAccessEvent>.append(&mut access.events, SourceAccessEvent {
        evaluation: event.evaluation, original: event.original, gate: Option<SourceAtom>.some(geometry.active), activity: SourceTruth.Undefined,
        event: Event {point: event.event.point, place: move geometry.place, kind: event.event.kind,
          span: event.event.span, target: event.event.target, loan: event.event.loan, consumesTarget: event.event.consumesTarget,
          refiner: event.event.refiner, refinedDepth: event.event.refinedDepth,
          binders: run copyBinders(List<usize>.asSlice(&event.event.binders))}})
    }
  }
  access.geometryMissing = Option<SourceAtom>.some(run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&gaps)))
  return ()
}

// The moves in a replacement's RHS belong to that actual evaluation subtree, not to every
// earlier event or every evaluation of the same typed NodeId. A pattern binding's retained
// subject is an address dependency; reading it does not execute the subject expression again.
effect fn sourceAccessSubtree<'body>(prepared: &PreparedSources.SourcePreparation<'body>, reservation: &SourceVisit.Reservation,
  root: SourceGraph.EvalId) -> List<bool> ! OutOfMemoryError ? &mut Allocator {
  let mut selected = List<bool>.make()
  let mut at = usize.ZERO
  while at < List<SourceGraph.Evaluation>.length(&reservation.skeleton.evaluations) {
    run List<bool>.append(&mut selected, false)
    at = at + usize.ONE
  }
  let mut pending = List<SourceGraph.EvalId>.make()
  run List<SourceGraph.EvalId>.append(&mut pending, root)
  while List<SourceGraph.EvalId>.length(&pending) != usize.ZERO {
    let current = match move List<SourceGraph.EvalId>.pop(&mut pending) {
      Option<SourceGraph.EvalId>.Some {value} => value
      _ => { return CompilerBug.panic(b"ownership access subtree lost its pending occurrence") }
    }
    if List<bool>.asSlice(&selected)[current.index] { continue }
    if true {
      let mut mutated = List<bool>.asMutSlice(&mut selected)
      mutated[current.index] = true
    }
    let actual = SourceVisit.occurrence(reservation, current)
    if let NodeKind.Expression {form: Expression.PatternBinding {..}, ..} = &prepared.body.nodes[actual.node.index].kind {
      continue
    }
    let inputs = List<SourceVisit.Input>.asSlice(&actual.inputs)
    let mut at = usize.ZERO
    while at < inputs.length {
      run List<SourceGraph.EvalId>.append(&mut pending, inputs[at].evaluation)
      at = at + usize.ONE
    }
  }
  return move selected
}

fn sourceConsumedTarget(events: &mut List<SourceAccessEvent>, written: usize, rhs: &[bool], statement: Location,
  activity: &[SourceTruth]) -> () {
  let all = List<SourceAccessEvent>.asMutSlice(&mut events.*)
  let mut at = usize.ZERO
  while at < all.length {
    if all[at].event.point >= activity.length { CompilerBug.panic(b"replacement access has no actual source activity") }
    let present = sourceTruthAnd(activity[all[at].event.point], all[at].activity)
    let writtenActive = sourceTruthAnd(activity[all[written].event.point], all[written].activity)
    if present != SourceTruth.False && writtenActive != SourceTruth.False && rhs[all[at].evaluation.index]
      && (all[at].event.kind == Kind.Move || all[at].event.kind == Kind.Drop) {
      let mut shared = overlap(&all[at].event.place, &all[written].event.place)
      if shared != usize.ZERO && (present == SourceTruth.Undefined || writtenActive == SourceTruth.Undefined) { shared = 2 }
      if shared == usize.ONE || (shared != usize.ZERO && all[written].event.consumesTarget == usize.ZERO) {
        all[written].event.consumesTarget = shared
        all[written].event.span = statement
        all[written].event.target = statement
      }
    }
    at = at + usize.ONE
  }
  return ()
}

// RHS subtrees include structurally reserved unreachable branches. Their move geometry is
// settled only after the sole source solve, using the move's own actual point applicability.
effect fn sourceSettleReplacements<'body>(graph: &SourceGraphGraph<'body>, projection: &mut SourceAccessProjection)
  -> () ! OutOfMemoryError ? &mut Allocator {
  let points = List<SourceControl.Point>.asSlice(&SourceGraphGraph.control(graph).points)
  let mut activity = List<SourceTruth>.make()
  let mut at = usize.ZERO
  while at < points.length {
    run List<SourceTruth>.append(&mut activity, SourceGraphGraph.truth(graph, points[at].reachable))
    at = at + usize.ONE
  }
  let events = List<SourceAccessEvent>.asMutSlice(&mut projection.events)
  at = usize.ZERO
  while at < events.length {
    if let Option<SourceAtom>.Some {value} = events[at].gate { events[at].activity = SourceGraphGraph.truth(graph, value) }
    at = at + usize.ONE
  }
  let replacements = List<SourceReplacementAccess>.asSlice(&projection.replacements)
  at = usize.ZERO
  while at < replacements.length {
    let replacement = &replacements[at]
    let mut event = usize.ZERO
    while event < List<SourceAccessEvent>.length(&projection.events) {
      if List<SourceAccessEvent>.asSlice(&projection.events)[event].original == replacement.event {
        sourceConsumedTarget(&mut projection.events, event, List<bool>.asSlice(&replacement.rhs),
          replacement.statement, List<SourceTruth>.asSlice(&activity))
      }
      event = event + usize.ONE
    }
    at = at + usize.ONE
  }
  return ()
}

// A consuming guard sees the provisional owner acquired by THIS match occurrence. Neither
// a repeated guard NodeId nor a binding's retained subject dependency executes another guard.
// Keep the actual access point so the final diagnostic pass uses the one CFG's applicability.
effect fn sourceGuardConsumptions<'body>(prepared: &PreparedSources.SourcePreparation<'body>, reservation: &SourceVisit.Reservation,
  events: &[SourceAccessEvent]) -> List<SourceGuardConsumption> ! OutOfMemoryError ? &mut Allocator {
  let mut consumed = List<SourceGuardConsumption>.make()
  let visits = List<SourceVisit.Visit>.asSlice(&reservation.visits)
  let subjects = List<SourceVisit.Subject>.asSlice(&reservation.subjects)
  let mut at = usize.ZERO
  while at < visits.length {
    let actual = &visits[at]
    if let NodeKind.Expression {form: Expression.Match {subject, access, arms, ..}, ..} = &prepared.body.nodes[actual.node.index].kind {
      let owning = match &access { SubjectAccess.Place {..} => false _ => true }
      if owning {
        let source = sourceAccessInput(actual, usize.ZERO, subject)
        let mut retained = Option<SourceGraph.EvalId>.none()
        let mut each = usize.ZERO
        while each < subjects.length {
          if subjects[each].site.index == actual.node.index && subjects[each].source.index == source.evaluation.index {
            if let Option<SourceGraph.EvalId>.Some {..} = retained {
              return CompilerBug.panic(b"consuming guard has duplicate actual subject acquisitions")
            }
            if !subjects[each].owned { return CompilerBug.panic(b"consuming guard lost its subject owner") }
            retained = Option<SourceGraph.EvalId>.some(subjects[each].evaluation)
          }
          each = each + usize.ONE
        }
        let evaluation = match retained {
          Option<SourceGraph.EvalId>.Some {value} => value
          _ => { return CompilerBug.panic(b"consuming guard has no actual subject acquisition") }
        }
        let root = match sourceTemporaryRoot(prepared, reservation, evaluation) {
          Option<usize>.Some {value} => value
          _ => { return CompilerBug.panic(b"owned consuming subject lost its actual acquisition") }
        }
        let written = List<MatchArm>.asSlice(&arms)
        let selected = List<SourceVisit.ArmResult>.asSlice(&actual.armInputs)
        if selected.length != written.length { return CompilerBug.panic(b"consuming guard lost its actual arm coordinates") }
        let inputs = List<SourceVisit.Input>.asSlice(&actual.inputs)
        each = usize.ZERO
        while each < selected.length {
          if let Option<usize>.Some {value: guard} = selected[each].guard {
            let node = match written[each].guard {
              Option<NodeId>.Some {value} => value
              _ => { return CompilerBug.panic(b"actual guard coordinate has no written guard") }
            }
            if guard >= inputs.length || inputs[guard].node.index != node.index {
              return CompilerBug.panic(b"consuming guard names another actual input occurrence")
            }
            let subtree = run sourceAccessSubtree(prepared, reservation, inputs[guard].evaluation)
            let contained = List<bool>.asSlice(&subtree)
            let mut event = usize.ZERO
            while event < events.length {
              let use = &events[event]
              if contained[use.evaluation.index] && use.event.place.root == root
                && (use.event.kind == Kind.Move || use.event.kind == Kind.Drop) {
                run List<SourceGuardConsumption>.append(&mut consumed, SourceGuardConsumption {
                  dispatch: sourceEncounter(List<SourceVisitDispatch>.asSlice(&reservation.dispatch), use.evaluation, SourceEncounter.Finish, visits),
                  subject: evaluation, point: SourceControl.PointId {index: use.event.point}, span: use.event.span})
              }
              event = event + usize.ONE
            }
          } else if let Option<NodeId>.Some {..} = written[each].guard {
            return CompilerBug.panic(b"written guard has no actual arm input coordinate")
          }
          each = each + usize.ONE
        }
      }
    }
    at = at + usize.ONE
  }
  return move consumed
}

// Dereference evaluates its descriptor as a Value for physical source transport. When
// that operand names an authored place, the enclosing semantic access reads through it;
// evaluating the descriptor is not an additional whole-place ownership access.
effect fn sourceSemanticRead(nodes: &[Node], visits: &[SourceVisit.Visit], actual: &SourceVisit.Visit)
  -> bool ! OutOfMemoryError ? &mut Allocator {
  if actual.access != SourceVisitAccess.Value { return false }
  let path = run pathOf(nodes, actual.node)
  if path.root == usize.MAX { return true }
  let mut at = usize.ZERO
  while at < visits.length {
    let parent = &visits[at]
    if let NodeKind.Expression {form: Expression.Dereference {value}, ..} = &nodes[parent.node.index].kind {
      let inputs = List<SourceVisit.Input>.asSlice(&parent.inputs)
      if inputs.length != usize.ONE || inputs[0].node.index != value.index {
        return CompilerBug.panic(b"dereference access lost its actual descriptor operand")
      }
      if inputs[0].evaluation.index == actual.evaluation.index {
        if value.index != actual.node.index || inputs[0].access != SourceVisitAccess.Value {
          return CompilerBug.panic(b"descriptor access changed its actual value occurrence")
        }
        return false
      }
    }
    at = at + usize.ONE
  }
  return true
}

// Project authored accesses onto reserved runtime points, including a match's subject use
// before its guards and arms. Loan acquisition and owner exits have their own semantic
// handlers. Holding/cleanup effects and store-policy refusals are separate consumers of
// these events; this inventory alone is not a completed ownership proof.
effect fn sourceAccessEvents<'body>(prepared: &PreparedSources.SourcePreparation<'body>, reservation: &SourceVisit.Reservation,
  cleanup: &[LoanCleanup]) -> SourceAccessProjection ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut projection = SourceAccessProjection {events: List<SourceAccessEvent>.make(),
    geometry: List<SourceAccessGeometry>.make(), geometryMissing: Option<SourceAtom>.none(),
    geometryRefusals: List<SourceGeometryRefusal>.make(), refusals: List<SourceAccessRefusal>.make(),
    guardConsumed: List<SourceGuardConsumption>.make(), refinements: run sourceRefinements(prepared, reservation),
    replacements: List<SourceReplacementAccess>.make()}
  let nodes = prepared.body.nodes
  let visits = List<SourceVisit.Visit>.asSlice(&reservation.visits)
  let mut at = usize.ZERO
  while at < visits.length {
    let actual = &visits[at]
    let span = nodes[actual.node.index].origin.location
    let entered = sourceEncounter(List<SourceVisitDispatch>.asSlice(&reservation.dispatch), actual.evaluation, SourceEncounter.Enter, visits)
    let finished = sourceEncounter(List<SourceVisitDispatch>.asSlice(&reservation.dispatch), actual.evaluation, SourceEncounter.Finish, visits)
    let shape = run shapeOf(nodes, actual.node)
    match move shape {
      Shape.Outside {reason} => {
        run List<SourceAccessRefusal>.append(&mut projection.refusals,
          SourceAccessRefusal {uncertain: false, dispatch: entered, point: actual.entry, reason: reason})
      }
      Shape.ReadPlace => {
        if run sourceSemanticRead(nodes, visits, actual) {
          let written = run pathOf(nodes, actual.node)
          let mut owned = written.root != usize.MAX
          if !owned {
            let base = projectedBase(nodes, actual.node)
            let descriptor = prepared.body.locals.length + nodes.length + base.index
            owned = descriptor < cleanup.length
              && (cleanup[descriptor].unknown || List<Shared<Lifetime>>.length(&cleanup[descriptor].regions) != usize.ZERO)
          }
          if owned {
            let path = run sourceAuthoredPath(prepared, reservation, SourceVisit.Input {node: actual.node,
              evaluation: actual.evaluation, usePoint: actual.execute, completed: actual.execute, access: actual.access, read: Option<PreparedSourcesInputRead>.none()})
            if !run sourceRequireGeometry(prepared, reservation, SourceVisit.Input {node: actual.node,
              evaluation: actual.evaluation, usePoint: actual.execute, completed: actual.completed,
              access: actual.access, read: Option<PreparedSourcesInputRead>.none()}, actual.evaluation,
              &mut projection, &path, actual.execute, finished) { at = at + usize.ONE continue }
            run sourceAccessEvent(&mut projection.events, actual.evaluation, actual.execute, &path, Kind.Read, span, span)
          }
        }
      }
      Shape.Move {value, consumed} => {
        if consumed {
          let written = run pathOf(nodes, value)
          if written.root == usize.MAX || written.through {
            run List<SourceAccessRefusal>.append(&mut projection.refusals,
              SourceAccessRefusal {uncertain: false, dispatch: entered, point: actual.entry, reason: BorrowStatus.StoredLoans})
          } else {
            let path = run sourceAuthoredPath(prepared, reservation, sourceAccessInput(actual, usize.ZERO, value))
            if !run sourceRequireGeometry(prepared, reservation, sourceAccessInput(actual, usize.ZERO, value), actual.evaluation, &mut projection, &path, actual.execute, finished) { at = at + usize.ONE continue }
            run sourceAccessEvent(&mut projection.events, actual.evaluation, actual.execute, &path, Kind.Move, span, nodes[value.index].origin.location)
          }
        }
      }
      Shape.Drop {value, consumed} => {
        if consumed {
          let written = run pathOf(nodes, value)
          if written.root == usize.MAX || written.through {
            run List<SourceAccessRefusal>.append(&mut projection.refusals,
              SourceAccessRefusal {uncertain: false, dispatch: entered, point: actual.entry, reason: BorrowStatus.StoredLoans})
          } else {
            let path = run sourceAuthoredPath(prepared, reservation, sourceAccessInput(actual, usize.ZERO, value))
            if !run sourceRequireGeometry(prepared, reservation, sourceAccessInput(actual, usize.ZERO, value), actual.evaluation, &mut projection, &path, actual.execute, finished) { at = at + usize.ONE continue }
            run sourceAccessEvent(&mut projection.events, actual.evaluation, actual.execute, &path, Kind.Drop, span, span)
          }
        }
      }
      Shape.Assignment {local, value} => {
        let path = Path {root: local, through: false, steps: List<Step>.make(), indexes: List<NodeId>.make(),
          refiner: usize.MAX, refinedDepth: usize.ZERO, binders: List<usize>.make()}
        let target = Location {start: span.start, end: span.start + usize.ONE}
        let event = List<SourceAccessEvent>.length(&projection.events)
        run sourceAccessEvent(&mut projection.events, actual.evaluation, actual.execute, &path, Kind.Write, target, target)
        let rhs = run sourceAccessSubtree(prepared, reservation, sourceAccessInput(actual, usize.ZERO, value).evaluation)
        run List<SourceReplacementAccess>.append(&mut projection.replacements,
          SourceReplacementAccess {event: event, rhs: move rhs, statement: span})
      }
      Shape.PlaceAssignment {target, value} => {
        let written = run pathOf(nodes, target)
        if written.root == usize.MAX {
          run List<SourceAccessRefusal>.append(&mut projection.refusals,
            SourceAccessRefusal {uncertain: false, dispatch: entered, point: actual.entry, reason: BorrowStatus.StoredLoans})
        } else {
          let path = run sourceAuthoredPath(prepared, reservation, sourceAccessInput(actual, usize.ZERO, target))
          if !run sourceRequireGeometry(prepared, reservation, sourceAccessInput(actual, usize.ZERO, target), actual.evaluation, &mut projection, &path, actual.execute, finished) { at = at + usize.ONE continue }
          let mut targetSpan = writtenSpan(nodes, target)
          if !path.through && List<Step>.length(&path.steps) == usize.ZERO { targetSpan = nodes[target.index].origin.location }
          let event = List<SourceAccessEvent>.length(&projection.events)
          run sourceAccessEvent(&mut projection.events, actual.evaluation, actual.execute, &path, Kind.Write, targetSpan, targetSpan)
          if !path.through {
            let rhs = run sourceAccessSubtree(prepared, reservation, sourceAccessInput(actual, usize.ONE, value).evaluation)
            run List<SourceReplacementAccess>.append(&mut projection.replacements,
              SourceReplacementAccess {event: event, rhs: move rhs, statement: span})
          }
        }
      }
      Shape.Displace {target, value} => {
        let written = run pathOf(nodes, target)
        if written.root == usize.MAX || (!written.through && run nodeRetains(nodes, target, prepared.body.owner)) {
          run List<SourceAccessRefusal>.append(&mut projection.refusals,
            SourceAccessRefusal {uncertain: false, dispatch: entered, point: actual.entry, reason: BorrowStatus.StoredLoans})
        } else {
          let path = run sourceAuthoredPath(prepared, reservation, sourceAccessInput(actual, usize.ZERO, target))
          if !run sourceRequireGeometry(prepared, reservation, sourceAccessInput(actual, usize.ZERO, target), actual.evaluation, &mut projection, &path, actual.execute, finished) { at = at + usize.ONE continue }
          let read = match actual.displaced {
            Option<SourceGraph.EvalId>.Some {value: displaced} => displaced
            _ => { return CompilerBug.panic(b"replacement access has no actual displaced read") }
          }
          let evaluations = List<SourceGraph.Evaluation>.asSlice(&reservation.skeleton.evaluations)
          let targetSpan = writtenSpan(nodes, target)
          run sourceAccessEvent(&mut projection.events, actual.evaluation, evaluations[read.index].point, &path, Kind.Read, targetSpan, targetSpan)
          let event = List<SourceAccessEvent>.length(&projection.events)
          run sourceAccessEvent(&mut projection.events, actual.evaluation, evaluations[actual.evaluation.index].point, &path, Kind.Write, targetSpan, targetSpan)
          if !path.through {
            let rhs = run sourceAccessSubtree(prepared, reservation, sourceAccessInput(actual, usize.ONE, value).evaluation)
            run List<SourceReplacementAccess>.append(&mut projection.replacements,
              SourceReplacementAccess {event: event, rhs: move rhs, statement: span})
          }
        }
      }
      Shape.Match {subject, access, ..} => {
        let input = sourceAccessInput(actual, usize.ZERO, subject)
        let written = run pathOf(nodes, subject)
        if access == Scrutinee.Moved && (written.root == usize.MAX || written.through) {
          run List<SourceAccessRefusal>.append(&mut projection.refusals,
            SourceAccessRefusal {uncertain: false, dispatch: entered, point: actual.entry, reason: BorrowStatus.StoredLoans})
        } else if access != Scrutinee.Value && written.root != usize.MAX {
          let kind = match access {
            Scrutinee.Moved => Kind.Move
            Scrutinee.Exclusive => Kind.Update
            Scrutinee.Place => Kind.Inspect
            _ => Kind.Read
          }
          let path = run sourceAuthoredPath(prepared, reservation, input)
          if !run sourceRequireGeometry(prepared, reservation, input, actual.evaluation, &mut projection, &path, input.usePoint,
            sourceEncounter(List<SourceVisitDispatch>.asSlice(&reservation.dispatch), actual.evaluation,
              SourceEncounter.Input {evaluation: input.evaluation}, visits)) { at = at + usize.ONE continue }
          let subjectSpan = nodes[subject.index].origin.location
          // The subject is inspected/moved before any guard or arm, even when no arm
          // completes. Borrowed-view acquisition still requires its producer authority.
          run sourceAccessEvent(&mut projection.events, actual.evaluation, input.usePoint,
            &path, kind, subjectSpan, subjectSpan)
        }
      }
      _ => ()
    }
    at = at + usize.ONE
  }
  projection.guardConsumed = run sourceGuardConsumptions(prepared, reservation, List<SourceAccessEvent>.asSlice(&projection.events))
  return move projection
}

// The old checker stopped recording after its first refusal; structural source reservation
// deliberately does not. Retain that diagnostic boundary without truncating actual execution.
// A definite earlier consuming guard still wins; uncertain or unreachable later inventory
// cannot manufacture a guard rejection or certify that the whole body was checked.
fn sourcePrelude(guards: &[SourceGuardConsumption], refusals: &[SourceAccessRefusal], activity: &[SourceTruth])
  -> SourceAccessPrelude {
  let mut result = SourceAccessPrelude {cutoff: usize.MAX, guard: Option<Location>.none(), outside: Option<BorrowStatus>.none(), unresolved: false}
  let mut first = usize.MAX
  let mut at = usize.ZERO
  while at < refusals.length {
    let point = refusals[at].point.index
    if point >= activity.length { return CompilerBug.panic(b"source refusal has no actual encounter point") }
    if activity[point] != SourceTruth.False {
      if refusals[at].dispatch < first {
        first = refusals[at].dispatch
        result.cutoff = first
        result.outside = Option<BorrowStatus>.some(refusals[at].reason)
      }
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < refusals.length {
    if refusals[at].dispatch <= first && (refusals[at].uncertain || activity[refusals[at].point.index] == SourceTruth.Undefined) { result.unresolved = true }
    at = at + usize.ONE
  }
  let mut consumed = usize.MAX
  at = usize.ZERO
  while at < guards.length {
    let point = guards[at].point.index
    if point >= activity.length { return CompilerBug.panic(b"consuming guard has no actual access point") }
    if guards[at].dispatch < first {
      if activity[point] == SourceTruth.Undefined { result.unresolved = true }
      if activity[point] == SourceTruth.True && guards[at].dispatch < consumed {
        consumed = guards[at].dispatch
        result.guard = Option<Location>.some(guards[at].span)
      }
    }
    at = at + usize.ONE
  }
  return move result
}

fn sourceGuardVerdict(span: Location) -> Verdict {
  return Verdict {outcome: Outcome.Conflict, status: BorrowStatus.Regions, code: RejectionCode.GuardConsumesPattern,
    access: span, earlier: Option<Location>.none(), reports: List<Report>.make()}
}

// Event numbering is not point numbering: several actual input acquisitions may occur at
// one use point. The eventual conflict/region consumers must inspect the entire point row.
effect fn sourceEventsAt(events: &[Event], pointCount: usize) -> List<List<usize>>
! OutOfMemoryError ? &mut Allocator {
  let mut rows = List<List<usize>>.make()
  let mut at = usize.ZERO
  while at < pointCount {
    run List<List<usize>>.append(&mut rows, List<usize>.make())
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < events.length {
    if events[at].point >= pointCount { return CompilerBug.panic(b"ownership event names a foreign CFG point") }
    run List<usize>.append(&mut List<List<usize>>.asMutSlice(&mut rows)[events[at].point], at)
    at = at + usize.ONE
  }
  return move rows
}

// Written operand order is supplied by the operation, never recovered by sorting ValueIds.
// A root denotes the actual physical value family (including an implicit reference input),
// not its selected/original contract parameter coordinate.
struct SourceOperand {
  node: NodeId
  evaluation: SourceGraph.EvalId
  root: PreparedSources.EndpointId
  ordinal: usize
}
impl Copy for SourceOperand {}

struct SourceCarryCase {
  source: SourceGraph.InputCase
  // Exact current publication before semantic field selection. Equal raw cells may
  // carry different placements, so a field result cannot pair by cell alone.
  publication: Option<usize>
  // Authenticated arrival before a read's semantic exclusion. It pairs a dropped
  // history with its real terminal port so that the port is bound false, not omitted.
  observed: SourceAtom
  field: usize
}

fn sourceCase(source: SourceGraph.InputCase, field: usize) -> SourceCarryCase {
  let observed = source.quality.present
  return SourceCarryCase {source: move source, publication: Option<usize>.none(), observed: observed, field: field}
}

// One actual component/leaf observation. Histories remain cases of that observation. The
// second written use of the same value gets another position, even for the same loan.
struct SourceCarryPosition {
  node: NodeId
  root: PreparedSources.EndpointId
  value: SourceGraph.ValueId
  leaf: SourceGraph.LeafId
  loan: usize
  operand: usize
  since: usize
  quality: SourceQuality
  cases: List<SourceCarryCase>
}

struct SourceObservation {
  positions: List<SourceCarryPosition>
  // Entry, Expression, LoanFree and Unknown remain actual inputs. None is a fake Loan, nor
  // can an empty Borrow projection stand for complete source coverage.
  other: List<SourceGraph.Input>
  unknown: SourceAtom
}

// Every effect retains its actual source history and operation applicability. Definition and
// read identities belong to the actual SourceFlow definitions and reads.
struct SourceEffectSource {
  case: usize
  category: SourceGraphSourceRole
  value: SourceGraph.ValueId
  leaf: SourceGraph.LeafId
  loan: usize
  definition: Option<SourceControl.DefinitionId>
  read: Option<SourceControl.ReadId>
}
impl Copy for SourceEffectSource {}

struct SourceRetentionEffect {
  source: SourceEffectSource
  point: usize
  caller: SourceAtom
  independent: SourceAtom
  storing: SourceAtom
}

struct SourceRetentionCases {
  sources: List<SourceEffectSource>
  decisions: List<SourcePolicy.RetentionOutput>
}

// Coordinates in the exact producer-stage kept record. These do not identify a physical
// source or canonical destination; the graph's reserved candidate supplies those separately.
struct SourceKeptSlot {
  operand: usize
  slot: usize
}
impl Copy for SourceKeptSlot {}

struct SourceReadExclusion {
  excluded: SourceAtom
  missing: SourceAtom
}
impl Copy for SourceReadExclusion {}

// Historical read attribution is separate from the current semantic placement. A
// reference acquisition observes a whole holder without creating a Copy map.
struct SourceReadAncestry {
  excluded: SourceAtom
  overlapping: SourceAtom
  missing: SourceAtom
  other: SourceAtom
}
impl Copy for SourceReadAncestry {}

struct SourceReadAncestries {
  indices: List<usize>
  cases: List<SourceReadAncestry>
}

struct SourceStoreFacts {
  permitted: bool
  empty: bool
  complete: bool
}
impl Copy for SourceStoreFacts {}

struct SourceStoreDecision {
  eligible: SourceAtom
  missing: SourceAtom
}

struct KeptOrigins {
  regions: List<Shared<Lifetime>>
  reached: List<usize>
}

// Caller retention starts at an actual operation, while independent escape reasons retain
// their original global constraint; both retain actual graph identities.
struct SourceCallerRetention {
  source: SourceEffectSource
  operation: usize
  present: SourceAtom
  missing: SourceAtom
}

struct SourceOperationReach {
  point: usize
  at: List<SourceAtom>
}

struct SourceCallerProjection {
  retentions: List<SourceCallerRetention>
  operations: List<SourceOperationReach>
  independent: List<SourceAtom>
  independentMissing: List<SourceAtom>
  aggregate: List<SourceAtom>
  storing: SourceAtom
  missing: SourceAtom
}

struct SourceCallerEvidence {
  present: SourceAtom
  missing: SourceAtom
}
impl Copy for SourceCallerEvidence {}

// One record per real SourceFlow definition, not one definition per Borrow alternative.
// Entry, LoanFree, Expression and unavailable definitions remain in the same inventory.
// Histories remain paired InputCases under each source; their numeric order is immaterial.
struct SourceStorageDefinition {
  definition: SourceGraph.DefinitionView
  inputs: List<SourceGraph.Input>
  loans: List<SourceStoredLoan>
  unknown: SourceAtom
  missing: SourceAtom
}

// Membership is captured while raw graph leaves are available. It does not replace the
// original InputCases above, which still authenticate each copied definition/read history.
struct SourceStoredLoan {
  leaf: SourceGraph.LeafId
  loan: usize
  active: SourceAtom
}
impl Copy for SourceStoredLoan {}

struct SourceStorageProjection {
  definitions: List<SourceStorageDefinition>
  reads: List<SourceGraph.ReadView>
}

struct SourceIntervalEffect {
  source: SourceEffectSource
  from: usize
  to: usize
  cleanup: bool
  holder: bool
  active: SourceAtom
}

struct SourceIntervalProjection {
  source: SourceEffectSource
  from: usize
  to: usize
  cleanup: bool
  holder: bool
  evidence: SourceCallerEvidence
}

// Every bit names an original Flow.DefinitionId. Multiple Borrow alternatives can occupy
// that same definition; neither alternative histories nor virtual components add bits.
struct SourceLoanOccupancy {
  loan: usize
  width: usize
  entering: List<u64>
  leaving: List<u64>
  // Immutable traits of real definition lanes; they never change reaching occupancy.
  inherited: List<u64>
  shadowed: List<u64>
  unresolved: bool
}

struct SourceControlProjection {
  entry: usize
  points: List<Point>
  unresolved: bool
}

struct SourceLoanNeeds {
  required: List<u64>
  liveOut: List<u64>
  unresolved: bool
}

struct SourceLoanAvailability {
  points: List<u64>
  unresolved: bool
}

struct SourceHolderRequest {
  dispatch: usize
  owner: Option<SourceVisit.OwnerId>
  evaluation: SourceGraph.EvalId
  root: PreparedSources.EndpointId
  point: SourceControl.PointId
  active: SourceAtom
}
impl Copy for SourceHolderRequest {}

struct SourceHolderUse {
  request: usize
  storage: SourceGraph.Storage
  active: SourceAtom
}
impl Copy for SourceHolderUse {}

// A semantic holder use owns its location and selected path. Physical descriptor
// transport alone is not a read occurrence for expiration diagnostics.
union SourceSemanticReadOrigin {
  Drop {observation: usize},
  Reference {observation: usize},
  Through {observation: usize},
  Flight {observation: usize},
  Move {observation: usize},
  Field {observation: usize},
  Write {holder: usize},
  Copy {placement: SourceGraph.ReadPlacement},
}
impl Copy for SourceSemanticReadOrigin {}

struct SourceSemanticRead {
  source: SourceEffectSource
  origin: SourceSemanticReadOrigin
  owner: SourceGraph.Storage
  selected: Option<SourceGraph.Storage>
  written: Option<SourceGraph.Storage>
  storage: SourceGraph.Storage
  held: SourceGraphOwnershipPlacement
  evaluation: SourceGraph.EvalId
  point: usize
  span: Location
  supported: bool
  required: bool
  active: SourceAtom
  pair: Option<SourceAtom>
}

struct SourceHolderProjection {
  reads: List<SourceSemanticRead>
  requests: List<SourceHolderRequest>
  uses: List<SourceHolderUse>
  missing: SourceAtom
}

struct SourceHolderLiveness {
  liveOut: List<u64>
  unresolved: bool
}

// The diagnostic owner needs to distinguish a value in flight from a required holder read.
// Caller evidence stays separate because Stored conflict precision depends on its provenance.
struct SourceLiveAt {
  flight: CallerSource
  held: CallerSource
  view: CallerSource
  caller: CallerSource
}

struct SourceAccessDecision {
  reported: bool
  unresolved: bool
}

struct SourceLoanFlow {
  occupancy: SourceLoanOccupancy
  needs: SourceLoanNeeds
  holders: SourceHolderLiveness
}

struct SourceConflictProjection {
  conflict: Option<Verdict>
  contested: List<Shared<Lifetime>>
  unresolved: bool
}

struct SourceRequiredUse {
  evidence: CallerSource
  span: Location
}

struct SourceStaleDefinition {
  evidence: CallerSource
  definition: Option<SourceControl.DefinitionId>
}

struct SourceRegionInput<'input, 'body> {
  graph: &'input SourceGraphGraph<'body>
  control: &'input SourceControlProjection
  owners: &'input [SourceVisit.Owner]
  geometry: &'input [SourceSettledGeometry]
  storage: &'input SourceStorageProjection
  events: &'input SourceRuntimeEvents
  intervals: &'input [SourceIntervalProjection]
  reads: &'input [SourceSemanticRead]
  views: &'input [SourceLifetimeProjection]
  viewMissing: SourceAtom
}

// Per-loan graph facts are projected once, without interpreting region relations. The
// common finite proof below applies source/parent bounds, initialization and own-source
// inclusion before it may use a release mask. IDs retain the original loan inventory.
struct RegionLoanProjection {
  geometry: SourceSettledGeometry
  occupancy: SourceLoanOccupancy
  needs: SourceLoanNeeds
  carriers: AvailabilityProjection
  released: List<u64>
}

struct RegionInput<'input> {
  control: &'input SourceControlProjection
  owners: &'input [SourceVisit.Owner]
  localCount: usize
  events: &'input SourceRuntimeEvents
  loans: &'input [Option<RegionLoanProjection>]
  unresolved: bool
}

// Inputs to the existing availability propagation: real carriers and paired copy reads.
// `preserves` is a projection of kills, not an independently solved reaching relation.
struct AvailabilitySource {
  definition: usize
  read: usize
}
impl Copy for AvailabilitySource {}

struct AvailabilityCarrier {
  point: usize
  selected: bool
  unpaired: bool
  sources: List<AvailabilitySource>
}

struct AvailabilityProjection {
  carriers: List<AvailabilityCarrier>
  preserves: List<u64>
  flight: List<bool>
  unresolved: bool
}

struct SourceCrossingEffect {
  source: SourceEffectSource
  active: SourceAtom
}

struct SourceEscapeEffect {
  source: SourceEffectSource
  active: SourceAtom
}

struct SourceWholeHold {
  loan: usize
  result: NodeId
  active: SourceAtom
  described: SourceAtom
}
impl Copy for SourceWholeHold {}

struct SourceImpliedGroup {
  group: ImpliedGroup
  active: SourceAtom
}

struct SourceRegionVertex {
  region: Shared<Lifetime>
  reached: SourceAtom
}

struct SourceJoinEffects {
  intervals: List<SourceIntervalEffect>
  crossings: List<SourceCrossingEffect>
}

fn sourceQuality(cell: SourceGraph.Cell) -> SourceQuality {
  return SourceQuality {present: cell.present, stored: cell.stored, alternatives: cell.alternatives}
}

fn sourceEffectSource(position: &SourceCarryPosition, actual: &SourceCarryCase) -> SourceEffectSource {
  return SourceEffectSource {case: actual.source.case, category: actual.source.category, value: position.value, leaf: position.leaf, loan: position.loan,
    definition: actual.source.definition, read: actual.source.read}
}

// Keep slot geometry separate from the actual source history used by policy effects.
fn sourceSlotValue(position: &SourceCarryPosition, actual: &SourceCarryCase) -> SourceSlotValue {
  return SourceSlotValue {loan: position.loan, operand: position.operand,
    field: actual.field, direct: actual.source.direct && actual.field != usize.MAX}
}

// Shape component order, not endpoint allocation order, determines a physical scan. Only
// frozen inline children participate; following a reference would invent captured contents.
effect fn sourceComponents<'body>(prepared: &PreparedSources.SourcePreparation<'body>,
  root: PreparedSources.EndpointId) -> List<PreparedSources.EndpointId>
! OutOfMemoryError ? &mut Allocator {
  let endpoints = List<PreparedSources.Endpoint>.asSlice(&prepared.endpoints)
  let shapes = List<PreparedSources.Shape>.asSlice(&prepared.shapes)
  let mut pending = List<PreparedSources.EndpointId>.make()
  let mut ordered = List<PreparedSources.EndpointId>.make()
  run List<PreparedSources.EndpointId>.append(&mut pending, root)
  while List<PreparedSources.EndpointId>.length(&pending) > usize.ZERO {
    let last = List<PreparedSources.EndpointId>.length(&pending) - usize.ONE
    let endpoint = List<PreparedSources.EndpointId>.remove(&mut pending, last)
    if endpoint.index >= endpoints.length { CompilerBug.panic(b"source observation names an absent component") }
    let prior = List<PreparedSources.EndpointId>.asSlice(&ordered)
    let mut at = usize.ZERO
    while at < prior.length {
      if prior[at].index == endpoint.index { CompilerBug.panic(b"source observation repeats an inline component") }
      at = at + usize.ONE
    }
    run List<PreparedSources.EndpointId>.append(&mut ordered, endpoint)
    if endpoints[endpoint.index].shape.index >= shapes.length { CompilerBug.panic(b"source observation has no prepared shape") }
    let components = List<PreparedSources.Component>.asSlice(&shapes[endpoints[endpoint.index].shape.index].components)
    at = components.length
    while at > usize.ZERO {
      at = at - usize.ONE
      if components[at].inline {
        let mut found = usize.MAX
        let mut each = usize.ZERO
        while each < endpoints.length {
          let child = match endpoints[each].parent { Option<PreparedSources.EndpointId>.Some {value} => value.index == endpoint.index _ => false }
          if child && SourceGraph.sameSelector(&endpoints[each].selector, &components[at].selector) {
            if found != usize.MAX { CompilerBug.panic(b"source observation has duplicate prepared children") }
            found = each
          }
          each = each + usize.ONE
        }
        if found == usize.MAX { CompilerBug.panic(b"source observation lost a prepared inline child") }
        run List<PreparedSources.EndpointId>.append(&mut pending, PreparedSources.EndpointId {index: found})
      }
    }
  }
  return move ordered
}

// Translate a *physical* placement into the existing slot classifier's path vocabulary.
// Unknown placement stays MAX. A contract channel never becomes an owned field by ordinal.
effect fn sourceField(endpoints: &[PreparedSources.Endpoint], root: PreparedSources.EndpointId,
  child: PreparedSources.EndpointId, paths: &mut List<List<Step>>) -> usize
! OutOfMemoryError ? &mut Allocator {
  let mut reverse = List<PreparedSources.EndpointId>.make()
  let mut current = child
  let mut remaining = endpoints.length
  while current.index != root.index && remaining > usize.ZERO {
    if current.index >= endpoints.length { CompilerBug.panic(b"source carry names an absent placement") }
    run List<PreparedSources.EndpointId>.append(&mut reverse, current)
    match endpoints[current.index].parent {
      Option<PreparedSources.EndpointId>.Some {value} => { current = value }
      _ => { CompilerBug.panic(b"source carry placement does not belong to its physical operand") }
    }
    remaining = remaining - usize.ONE
  }
  if remaining == usize.ZERO { CompilerBug.panic(b"source carry has cyclic placement ancestry") }
  let ancestry = List<PreparedSources.EndpointId>.asSlice(&reverse)
  let mut steps = List<Step>.make()
  let mut at = ancestry.length
  while at > usize.ZERO {
    at = at - usize.ONE
    if !run sourceSelectorSteps(&endpoints[ancestry[at].index].selector, &mut steps) { return usize.MAX }
  }
  if List<Step>.length(&steps) == usize.ZERO { return usize.ZERO }
  let field = List<List<Step>>.length(&paths.*)
  run List<List<Step>>.append(&mut paths.*, move steps)
  return field
}

effect fn sourceSelectorSteps(selector: &PreparedSourcesSelector, steps: &mut List<Step>) -> bool
! OutOfMemoryError ? &mut Allocator {
  match &selector.* {
    PreparedSourcesSelector.Field {ordinal} => run List<Step>.append(&mut steps.*, fieldStep(ordinal))
    PreparedSourcesSelector.Member {declaration, member, payload} => {
      if Shared<DeclarationId>.with<OwnerKind>(&declaration, DeclarationId.kind) == OwnerKind.Union {
        run List<Step>.append(&mut steps.*, memberStep(member))
        run List<Step>.append(&mut steps.*, fieldStep(payload))
      } else {
        if payload != usize.ZERO { CompilerBug.panic(b"record carry has a union payload coordinate") }
        run List<Step>.append(&mut steps.*, fieldStep(member))
      }
    }
    PreparedSourcesSelector.Variant {ordinal} => run List<Step>.append(&mut steps.*, memberStep(ordinal))
    PreparedSourcesSelector.Index {class} => {
      let step = match &class {
        PreparedSourcesIndexClass.Exact {index} => elementStep(index)
        PreparedSourcesIndexClass.Remainder => anyElement()
      }
      run List<Step>.append(&mut steps.*, step)
    }
    PreparedSourcesSelector.Identity => ()
    _ => { return false }
  }
  return true
}

struct SourceResultPlacement {
  field: usize
  whole: bool
}

fn sourcePlacementStep(steps: &[SourceResults.PlacementStep], position: SourceResultsPosition) -> usize {
  let mut found = usize.MAX
  let mut at = usize.ZERO
  while at < steps.length {
    if SourceResults.samePosition(steps[at].position, position) {
      if found != usize.MAX { return CompilerBug.panic(b"result placement repeats its root/current position") }
      found = at
    }
    at = at + usize.ONE
  }
  if found == usize.MAX { return CompilerBug.panic(b"result placement lost its root/current step") }
  return found
}

// One finite path summary per position: absent, one exact path, or MAX. Joining alternative
// histories never turns them into additional operand positions or unfolds a recursive path.
fn sourceMergeField(paths: &[List<Step>], current: &mut Option<usize>, offered: usize) -> bool {
  let prior = match current.* {
    Option<usize>.Some {value} => value
    _ => { current.* = Option<usize>.some(offered) return true }
  }
  if prior == usize.MAX || prior == offered { return false }
  let mut same = false
  if offered != usize.MAX {
    let left = List<Step>.asSlice(&paths[prior])
    let right = List<Step>.asSlice(&paths[offered])
    same = left.length == right.length
    let mut at = usize.ZERO
    while same && at < left.length {
      same = sameStep(left[at], right[at])
      at = at + usize.ONE
    }
  }
  if same { return false }
  current.* = Option<usize>.some(usize.MAX)
  return true
}

effect fn sourceSelectedField(shapes: &[PreparedSources.Shape], roots: &[SourceResultsPosition],
  targets: &[SourceResultsPosition], steps: &[SourceResults.PlacementStep], selected: SourceResultsPosition,
  prefix: usize, paths: &mut List<List<Step>>) -> usize ! OutOfMemoryError ? &mut Allocator {
  let mut target = false
  let mut root = false
  let mut at = usize.ZERO
  while at < targets.length {
    if SourceResults.samePosition(targets[at], selected) { target = true }
    at = at + usize.ONE
  }
  let entry = SourceResults.positionRoot(selected)
  at = usize.ZERO
  while at < roots.length {
    if SourceResults.samePosition(roots[at], entry) { root = true }
    at = at + usize.ONE
  }
  if !target || !root { return CompilerBug.panic(b"result policy substituted another continuation root or target") }
  let mut incoming = List<Option<usize>>.make()
  at = usize.ZERO
  while at < steps.length {
    run List<Option<usize>>.append(&mut incoming, Option<usize>.none())
    at = at + usize.ONE
  }
  let first = sourcePlacementStep(steps, entry)
  if true {
    let mut mutated = List<Option<usize>>.asMutSlice(&mut incoming)
    mutated[first] = Option<usize>.some(prefix)
  }
  let mut pending = List<usize>.make()
  run List<usize>.append(&mut pending, first)
  let mut result = Option<usize>.none()
  at = usize.ZERO
  while at < List<usize>.length(&pending) {
    let index = List<usize>.asSlice(&pending)[at]
    let current = &steps[index]
    let input = match List<Option<usize>>.asSlice(&incoming)[index] {
      Option<usize>.Some {value} => value
      _ => { return CompilerBug.panic(b"selected result worklist has no incoming path") }
    }
    if current.component.shape.index >= shapes.length { CompilerBug.panic(b"selected result has no authored component shape") }
    let components = List<PreparedSources.Component>.asSlice(&shapes[current.component.shape.index].components)
    if current.component.ordinal >= components.length { CompilerBug.panic(b"selected result has no authored component") }
    let component = &components[current.component.ordinal]
    let mut field = usize.MAX
    if input != usize.MAX && component.inline {
      let mut path = run copySteps(List<Step>.asSlice(&List<List<Step>>.asSlice(&paths.*)[input]))
      if run sourceSelectorSteps(&component.selector, &mut path) {
        field = usize.ZERO
        if List<Step>.length(&path) != usize.ZERO {
          field = List<List<Step>>.length(&paths.*)
          run List<List<Step>>.append(&mut paths.*, move path)
        }
      }
    }
    if SourceResults.samePosition(current.position, selected) {
      drop sourceMergeField(List<List<Step>>.asSlice(&paths.*), &mut result, field)
    }
    let next = List<SourceResultsPosition>.asSlice(&current.next)
    let mut each = usize.ZERO
    while each < next.length {
      if !SourceResults.samePosition(SourceResults.positionRoot(next[each]), entry) {
        CompilerBug.panic(b"selected result crossed continuation roots or descriptor proofs")
      }
      let following = sourcePlacementStep(steps, next[each])
      if sourceMergeField(List<List<Step>>.asSlice(&paths.*),
        &mut List<Option<usize>>.asMutSlice(&mut incoming)[following], field) {
        run List<usize>.append(&mut pending, following)
      }
      each = each + usize.ONE
    }
    at = at + usize.ONE
  }
  return match result {
    Option<usize>.Some {value} => value
    _ => { return CompilerBug.panic(b"selected result target has no root-qualified placement") }
  }
}

effect fn sourceResultPlacement<'body>(builder: &SourceGraphBuilder<'body>, port: SourceGraph.PolicyPort,
  root: PreparedSources.EndpointId, paths: &mut List<List<Step>>) -> SourceResultPlacement
! OutOfMemoryError ? &mut Allocator {
  let target = SourceGraphBuilder.value(builder, port.target)
  let prepared = SourceGraphBuilder.preparation(builder)
  let endpoints = List<PreparedSources.Endpoint>.asSlice(&prepared.endpoints)
  match port.authority {
    SourceGraphTransferAuthority.OperationResult {candidate, position} => {
      let placement = run SourceResults.outputPlacement(prepared, candidate)
      if placement.root.index != root.index || target.evaluation.index != candidate.result.index
        || target.endpoint.index != candidate.target.index || target.phase != SourceGraphValuePhase.Output {
        return CompilerBug.panic(b"result policy changed its actual output placement")
      }
      let prefix = run sourceField(endpoints, root, candidate.target, &mut paths.*)
      match &placement.suffix {
        SourceResultsPlacementSuffix.Whole => {
          if let Option<SourceResultsPosition>.Some {..} = position { CompilerBug.panic(b"whole output has a selected result position") }
          if let Option<SourceGraph.ResidualSubject>.Some {..} = target.subject { CompilerBug.panic(b"whole output has a residual result subject") }
          return SourceResultPlacement {field: prefix, whole: prefix == usize.ZERO}
        }
        SourceResultsPlacementSuffix.Selected {roots, targets, steps} => {
          let selected = match position {
            Option<SourceResultsPosition>.Some {value} => value
            _ => { return CompilerBug.panic(b"selected result policy lost its continuation position") }
          }
          let subject = match target.subject {
            Option<SourceGraph.ResidualSubject>.Some {value} => value
            _ => { return CompilerBug.panic(b"selected result policy published the whole anchor") }
          }
          let matching = match subject.position {
            Option<SourceResultsPosition>.Some {value} => SourceResults.samePosition(value, selected)
            _ => false
          }
          let base = SourceGraphBuilder.value(builder, subject.base)
          let state = SourceResults.positionState(prepared, selected)
          if !matching || subject.state.index != state.index
            || base.endpoint.index != candidate.target.index || base.evaluation.index != candidate.result.index
            || base.phase != SourceGraphValuePhase.Output {
            return CompilerBug.panic(b"selected result subject lost its exact anchor and root/current identity")
          }
          if let Option<SourceGraph.ResidualSubject>.Some {..} = base.subject { CompilerBug.panic(b"selected result anchor is another selected subject") }
          let field = run sourceSelectedField(List<PreparedSources.Shape>.asSlice(&prepared.shapes),
            List<SourceResultsPosition>.asSlice(&roots), List<SourceResultsPosition>.asSlice(&targets),
            List<SourceResults.PlacementStep>.asSlice(&steps), selected, prefix, &mut paths.*)
          return SourceResultPlacement {field: field, whole: false}
        }
      }
    }
    _ => {
      // Ordinary physical results keep their actual inline path. A virtual read result
      // requires explicit selected placement authority; its anchor is not that evidence.
      if let Option<SourceGraph.ResidualSubject>.Some {..} = target.subject {
        return CompilerBug.panic(b"virtual read result has no actual selected placement authority")
      }
      let field = run sourceField(endpoints, root, target.endpoint, &mut paths.*)
      return SourceResultPlacement {field: field, whole: field == usize.ZERO}
    }
  }
}

// Summary lanes and received writes have their own explicit observations. They must never
// win a physical operand lookup merely because their endpoint and evaluation coincide.
fn sourcePhysicalValue(value: SourceGraph.Value) -> bool {
  if let Option<SourceGraph.ResidualSubject>.Some {..} = value.subject { return false }
  if let Option<usize>.Some {..} = value.summary { return false }
  if let Option<usize>.Some {..} = value.writeHolder { return false }
  return value.phase != SourceGraphValuePhase.Transport
}

fn sourceSameSummary(left: Option<usize>, right: Option<usize>) -> bool {
  return match left {
    Option<usize>.Some {value} => match right { Option<usize>.Some {value: other} => value == other _ => false }
    _ => match right { Option<usize>.None => true _ => false }
  }
}

fn sourceSameReadLane(definition: SourceGraph.DefinitionView, read: SourceGraph.ReadView) -> bool {
  return sourceSameStorage(definition.storage, read.storage) && sourceSameSummary(definition.summary, read.summary)
}

fn sourceSameField(paths: &[List<Step>], left: usize, right: usize) -> bool {
  if left == right { return true }
  if left == usize.MAX || right == usize.MAX { return false }
  let a = List<Step>.asSlice(&paths[left])
  let b = List<Step>.asSlice(&paths[right])
  if a.length != b.length { return false }
  let mut at = usize.ZERO
  while at < a.length {
    if !sameStep(a[at], b[at]) { return false }
    at = at + usize.ONE
  }
  return true
}

// Splitting one history by finite publication alternatives does not add an operand. Every
// attribute still belongs to the same actual source case; its Q is gated with that case.
effect fn sourceGatedCase(source: &SourceGraph.InputCase, active: SourceAtom, rules: &mut SourceProgram)
  -> SourceGraph.InputCase ! OutOfMemoryError ? &mut Allocator {
  let empty = List<SourceAtom>.make()
  let presenceGates: [SourceAtom; 2] = [source.quality.present, active]
  let present = run SourcePolicy.conjunction(&mut rules.*, &presenceGates, List<SourceAtom>.asSlice(&empty))
  let stored: [SourceAtom; 2] = [present, source.quality.stored]
  let alternatives: [SourceAtom; 2] = [present, source.quality.alternatives]
  return SourceGraph.InputCase {case: source.case, category: source.category, source: source.source, placement: source.placement, direct: source.direct,
    definition: source.definition, read: source.read, map: source.map, direction: source.direction,
    address: source.address, contract: source.contract, quality: SourceGraph.Cell {present: present,
      stored: run SourcePolicy.conjunction(&mut rules.*, &stored, List<SourceAtom>.asSlice(&empty)),
      alternatives: run SourcePolicy.conjunction(&mut rules.*, &alternatives, List<SourceAtom>.asSlice(&empty))}}
}

fn sourcePublicationCase(value: SourceGraph.ValueId, leaf: SourceGraph.LeafId, history: &SourceGraph.InputCase,
  actual: SourceGraph.ValueId, actualLeaf: SourceGraph.LeafId, category: SourceGraphSourceRole, direct: bool,
  definition: Option<SourceControl.DefinitionId>, read: Option<SourceControl.ReadId>) -> bool {
  return value.index == actual.index && leaf.index == actualLeaf.index && history.category == category && history.direct == direct
    && sourceDefinitionMatches(history.definition, definition) && sourceReadMatches(history.read, read)
}

fn sourceUnknownPlacement(placement: SourceGraphOwnershipPlacement) -> bool {
  return match placement { SourceGraphOwnershipPlacement.Unknown => true _ => false }
}

// Inline storage ancestry and immutable ownership suffixes are separate coordinates.
// Only the suffix may cross Referent; no semantic channel becomes a held path.
effect fn sourceOwnershipField<'body>(builder: &SourceGraphBuilder<'body>, root: PreparedSources.EndpointId,
  placement: SourceGraphOwnershipPlacement, paths: &mut List<List<Step>>) -> SourceReadField
! OutOfMemoryError ? &mut Allocator {
  let prepared = SourceGraphBuilder.preparation(builder)
  let anchor = match placement {
    SourceGraphOwnershipPlacement.Unknown => { return SourceReadField {supported: true, field: usize.MAX} }
    SourceGraphOwnershipPlacement.Known {anchor, ..} => anchor
    SourceGraphOwnershipPlacement.Position {anchor, ..} => anchor
  }
  let endpoints = List<PreparedSources.Endpoint>.asSlice(&prepared.endpoints)
  let mut current = anchor
  let mut remaining = endpoints.length
  while current.index != root.index && current.index < endpoints.length && remaining != usize.ZERO {
    match endpoints[current.index].parent { Option<PreparedSources.EndpointId>.Some {value} => { current = value }
      _ => { return SourceReadField {supported: false, field: usize.MAX} } }
    remaining = remaining - usize.ONE
  }
  if current.index != root.index { return SourceReadField {supported: false, field: usize.MAX} }
  let inlineField = run sourceField(endpoints, root, anchor, &mut paths.*)
  if inlineField == usize.MAX { return SourceReadField {supported: false, field: usize.MAX} }
  if let SourceGraphOwnershipPlacement.Position {position, offset, ..} = placement {
    let positions = SourceGraphBuilder.ownershipPositions(builder)
    if position.index >= positions.length { return CompilerBug.panic(b"ownership position lost its frozen occurrence") }
    let tail = List<SourceGraph.OwnershipPositionStep>.asSlice(&positions[position.index].steps)
    if offset > tail.length { return CompilerBug.panic(b"ownership position skipped past its atomic semantic path") }
    let mut steps = run copySteps(List<Step>.asSlice(&List<List<Step>>.asSlice(&paths.*)[inlineField]))
    let mut at = offset
    while at < tail.length {
      if tail[at].endpoint.index >= endpoints.length { return CompilerBug.panic(b"ownership position lost its authored selector") }
      let selector = &endpoints[tail[at].endpoint.index].selector
      match tail[at].part {
        SourceGraphOwnershipStepPart.Selector => {
          let before = List<Step>.length(&steps)
          match &selector.* {
            PreparedSourcesSelector.Referent => run List<Step>.append(&mut steps, referent())
            _ => { if !run sourceSelectorSteps(selector, &mut steps) {
              return SourceReadField {supported: false, field: usize.MAX}
            } }
          }
          if List<Step>.length(&steps) != before + usize.ONE {
            return CompilerBug.panic(b"ownership atomic selector changed its semantic step count")
          }
        }
        SourceGraphOwnershipStepPart.NominalMember => {
          match &selector.* {
            PreparedSourcesSelector.Member {declaration, member, payload} => {
              if Shared<DeclarationId>.with<OwnerKind>(&declaration, DeclarationId.kind) != OwnerKind.Union {
                return CompilerBug.panic(b"ownership nominal position substituted a record field")
              }
              let step = match tail[at].part {
                SourceGraphOwnershipStepPart.NominalMember => memberStep(member)
                _ => fieldStep(payload)
              }
              run List<Step>.append(&mut steps, step)
            }
            _ => { return CompilerBug.panic(b"ownership nominal position has no authored member") }
          }
        }
        SourceGraphOwnershipStepPart.NominalPayload => {
          match &selector.* {
            PreparedSourcesSelector.Member {declaration, member, payload} => {
              if Shared<DeclarationId>.with<OwnerKind>(&declaration, DeclarationId.kind) != OwnerKind.Union {
                return CompilerBug.panic(b"ownership nominal position substituted a record field")
              }
              let step = match tail[at].part {
                SourceGraphOwnershipStepPart.NominalMember => memberStep(member)
                _ => fieldStep(payload)
              }
              run List<Step>.append(&mut steps, step)
            }
            _ => { return CompilerBug.panic(b"ownership nominal position has no authored member") }
          }
        }
      }
      at = at + usize.ONE
    }
    if List<Step>.length(&steps) == usize.ZERO { return SourceReadField {supported: true, field: usize.ZERO} }
    let result = List<List<Step>>.length(&paths.*)
    run List<List<Step>>.append(&mut paths.*, move steps)
    return SourceReadField {supported: true, field: result}
  }
  let suffix = match placement { SourceGraphOwnershipPlacement.Known {suffix, ..} => suffix
    _ => { return CompilerBug.panic(b"known ownership placement lost its suffix") } }
  let tail = match suffix { Option<SourceGraph.OwnershipSuffix>.Some {value} => value
    _ => { return SourceReadField {supported: true, field: inlineField} } }
  let mut reversed = List<PreparedSources.EndpointId>.make()
  current = tail.endpoint
  remaining = endpoints.length
  while current.index != tail.root.index && current.index < endpoints.length && remaining != usize.ZERO {
    run List<PreparedSources.EndpointId>.append(&mut reversed, current)
    match endpoints[current.index].parent { Option<PreparedSources.EndpointId>.Some {value} => { current = value }
      _ => { return SourceReadField {supported: false, field: usize.MAX} } }
    remaining = remaining - usize.ONE
  }
  if current.index != tail.root.index { return SourceReadField {supported: false, field: usize.MAX} }
  let mut steps = run copySteps(List<Step>.asSlice(&List<List<Step>>.asSlice(&paths.*)[inlineField]))
  let all = List<PreparedSources.EndpointId>.asSlice(&reversed)
  let mut at = all.length
  while at != usize.ZERO {
    at = at - usize.ONE
    let selector = &endpoints[all[at].index].selector
    match &selector.* {
      PreparedSourcesSelector.Referent => run List<Step>.append(&mut steps, referent())
      _ => { if !run sourceSelectorSteps(selector, &mut steps) { return SourceReadField {supported: false, field: usize.MAX} } }
    }
  }
  if List<Step>.length(&steps) == usize.ZERO { return SourceReadField {supported: true, field: usize.ZERO} }
  let field = List<List<Step>>.length(&paths.*)
  run List<List<Step>>.append(&mut paths.*, move steps)
  return SourceReadField {supported: true, field: field}
}

// The retained boundary authenticates occurrence ancestry. Extract only its written Step
// suffix here; place bindings expand their subject path rather than honoring a temporary cut.
effect fn sourceReferenceSuffix(nodes: &[Node], source: NodeId, boundary: NodeId, steps: &mut List<Step>)
  -> bool ! OutOfMemoryError ? &mut Allocator {
  let base = run pathOf(nodes, boundary)
  if base.root != usize.MAX {
    let selected = run pathOf(nodes, source)
    if selected.root != base.root { return false }
    let prefix = List<Step>.asSlice(&base.steps)
    let full = List<Step>.asSlice(&selected.steps)
    if full.length < prefix.length { return false }
    let mut at = usize.ZERO
    while at < prefix.length {
      if !sameStep(prefix[at], full[at]) { return false }
      at = at + usize.ONE
    }
    while at < full.length {
      run List<Step>.append(&mut steps.*, full[at])
      at = at + usize.ONE
    }
    return true
  }
  let relative = run temporaryPath(nodes, source, boundary)
  if relative.root != temporaryRoot(nodes, boundary.index) { return false }
  run sourceAppendEffects<Step>(&mut steps.*, move relative.steps)
  return true
}

// A reborrow observes the descriptor's canonical holder, but its borrowed place continues
// through that descriptor. Keep that authored suffix separate from canonical storage.
effect fn sourceReferenceBorrowedField<'body>(builder: &SourceGraphBuilder<'body>, candidate: SourceGraph.ReferenceHolding,
  paths: &mut List<List<Step>>) -> SourceReadField ! OutOfMemoryError ? &mut Allocator {
  let observation = SourceGraphBuilder.referenceObservations(builder)[candidate.observation]
  let origin = SourceGraphBuilder.reference(builder, candidate.reference)
  if observation.reference != candidate.reference {
    return CompilerBug.panic(b"reference borrowed path changed its actual acquisition")
  }
  let prepared = SourceGraphBuilder.preparation(builder)
  let endpoints = List<PreparedSources.Endpoint>.asSlice(&prepared.endpoints)
  let prefix = run sourceField(endpoints, observation.owner.endpoint, observation.storage.endpoint, &mut paths.*)
  if prefix == usize.MAX { return SourceReadField {supported: false, field: usize.MAX} }
  let mut borrowed = run copySteps(List<Step>.asSlice(&List<List<Step>>.asSlice(&paths.*)[prefix]))
  let source = match SourceGraphBuilder.evaluation(builder, origin.source).site {
    SourceGraphEvaluationSite.Node {node} => node
    _ => { return CompilerBug.panic(b"reference borrowed path lost its actual source node") }
  }
  if let Option<SourceGraph.ThroughDescriptor>.Some {value: descriptor} = origin.ownership {
    let boundary = match SourceGraphBuilder.evaluation(builder, descriptor.evaluation).site {
      SourceGraphEvaluationSite.Node {node} => node
      _ => { return CompilerBug.panic(b"reference holder boundary has no actual descriptor node") }
    }
    if !run sourceReferenceSuffix(prepared.body.nodes, source, boundary, &mut borrowed) {
      return SourceReadField {supported: false, field: usize.MAX}
    }
    // Producer-selected components follow the written source node. They are the exact
    // source member of this acquisition map, never a result or contract path guess.
    let maps = List<PreparedSources.SelectionMap>.asSlice(&prepared.maps)
    let mut component = maps[origin.map.index].source
    let mut ancestry = List<PreparedSources.EndpointId>.make()
    let mut remaining = endpoints.length
    while remaining > usize.ZERO {
      if component.index >= endpoints.length {
        return CompilerBug.panic(b"reference borrowed component names an absent endpoint")
      }
      match endpoints[component.index].parent {
        Option<PreparedSources.EndpointId>.Some {value} => {
          run List<PreparedSources.EndpointId>.append(&mut ancestry, component)
          component = value
        }
        _ => { break }
      }
      remaining = remaining - usize.ONE
    }
    if remaining == usize.ZERO { return CompilerBug.panic(b"reference borrowed component ancestry is cyclic") }
    let authentic = match &endpoints[component.index].root {
      PreparedSourcesRoot.Node {node, category} => node.index == source.index && category == PreparedSourcesEndpointRole.Storage
      _ => false
    }
    if !authentic { return CompilerBug.panic(b"reference borrowed component changed its original source") }
    let selected = List<PreparedSources.EndpointId>.asSlice(&ancestry)
    let mut at = selected.length
    while at > usize.ZERO {
      at = at - usize.ONE
      let selector = &endpoints[selected[at].index].selector
      if let PreparedSourcesSelector.Referent = &selector.* {
        run List<Step>.append(&mut borrowed, referent())
      } else if !run sourceSelectorSteps(selector, &mut borrowed) {
        return SourceReadField {supported: false, field: usize.MAX}
      }
    }
  }
  // Authored slice reborrows cross their descriptor without an explicit typed Index.
  // Match the same source/result rule used when declaring this one actual loan.
  let acquisition = SourceGraphBuilder.evaluation(builder, SourceGraphBuilder.value(builder, origin.descriptor).evaluation)
  if let SourceGraphEvaluationSite.Node {node} = acquisition.site {
    if let NodeKind.Expression {form: Expression.Borrow {value, ..}, ..} = &prepared.body.nodes[node.index].kind {
      if value.index == source.index && sliceValue(prepared.body.nodes, source) && sliceValue(prepared.body.nodes, node) {
        run List<Step>.append(&mut borrowed, referent())
      }
    }
  }
  if List<Step>.length(&borrowed) == usize.ZERO { return SourceReadField {supported: true, field: usize.ZERO} }
  let field = List<List<Step>>.length(&paths.*)
  run List<List<Step>>.append(&mut paths.*, move borrowed)
  return SourceReadField {supported: true, field: field}
}

effect fn sourceReferenceField<'body>(builder: &SourceGraphBuilder<'body>, candidate: SourceGraph.ReferenceHolding,
  storage: SourceGraph.Storage, held: SourceGraphOwnershipPlacement, paths: &mut List<List<Step>>)
  -> SourceReadField ! OutOfMemoryError ? &mut Allocator {
  let observation = SourceGraphBuilder.referenceObservations(builder)[candidate.observation]
  let endpoints = List<PreparedSources.Endpoint>.asSlice(&SourceGraphBuilder.preparation(builder).endpoints)
  let owner = match sourceStorageRoot(endpoints, storage) { Option<SourceGraph.Storage>.Some {value} => value
    _ => { return SourceReadField {supported: false, field: usize.MAX} } }
  if !sourceSameStorage(owner, observation.owner) { return SourceReadField {supported: false, field: usize.MAX} }
  let originalField = run sourceOwnershipField(builder, owner.endpoint, held, &mut paths.*)
  if !originalField.supported || originalField.field == usize.MAX { return originalField }
  let borrowed = run sourceReferenceBorrowedField(builder, candidate, &mut paths.*)
  if !borrowed.supported { return borrowed }
  let all = List<List<Step>>.asSlice(&paths.*)
  let a = List<Step>.asSlice(&all[originalField.field])
  let b = List<Step>.asSlice(&all[borrowed.field])
  if !readContains(b, a) { return SourceReadField {supported: true, field: usize.MAX} }
  let mut steps = List<Step>.make()
  run List<Step>.append(&mut steps, referent())
  let mut at = b.length
  while at < a.length { run List<Step>.append(&mut steps, a[at]) at = at + usize.ONE }
  let field = List<List<Step>>.length(&paths.*)
  run List<List<Step>>.append(&mut paths.*, move steps)
  return SourceReadField {supported: true, field: field}
}

struct SourceOriginField {
  root: PreparedSources.EndpointId
  field: SourceReadField
}
impl Copy for SourceOriginField {}

// Apply original A/B exactly once. Current publication anchors never recover original A.
// A canonical summary can reach a Field Output through the retained alias read.
// This authenticates that existing path; it does not create an Input read directive
// or apply a second finish policy to the original operand.
effect fn sourceFieldReadOrigin<'body>(builder: &SourceGraphBuilder<'body>, reading: usize,
  category: SourceGraphSourceRole, root: PreparedSources.EndpointId, paths: &mut List<List<Step>>)
  -> SourceOriginField ! OutOfMemoryError ? &mut Allocator {
  let row = SourceGraphBuilder.fieldReads(builder)[reading]
  let definition = SourceGraphBuilder.definition(builder, row.definition)
  let read = SourceGraphBuilder.read(builder, row.read)
  let original = SourceGraphBuilder.read(builder, row.original)
  let summary = SourceGraphBuilder.summaries(builder)[row.summary]
  let publication = SourceGraphBuilder.summaryReads(builder)[row.summaryRead]
  let directive = &SourceGraphBuilder.resultUses(builder)[row.result]
  let selection = &SourceGraphBuilder.selectionUses(builder)[row.selection]
  let alias = SourceGraphBuilder.aliases(builder)[row.alias]
  let canonical = SourceGraphBuilder.value(builder, row.canonical)
  let transport = SourceGraphBuilder.value(builder, row.transport)
  let output = SourceGraphBuilder.value(builder, row.output)
  let prepared = SourceGraphBuilder.preparation(builder)
  let maps = List<PreparedSources.SelectionMap>.asSlice(&prepared.maps)
  let map = &maps[row.map.index]
  let selectedMap = match selection.value {
    Option<PreparedSources.MapId>.Some {value} => value
    _ => { return CompilerBug.panic(b"Field read origin lost its actual value selection") }
  }
  let physical = match directive.kind { SourceGraphResultKind.Physical => true _ => false }
  let ordinaryRead = match original.summary { Option<usize>.None => true _ => false }
  if !physical || !ordinaryRead || row.root.index != root.index || row.category != category
    || publication.summary != row.summary || publication.original.index != row.original.index
    || publication.read.index != row.read.index || publication.target.index != row.canonical.index
    || !sourceSameSummary(definition.summary, Option<usize>.some(row.summary))
    || !sourceSameReadLane(definition, read) || !sourceSameStorage(definition.storage, summary.prefix)
    || !sourceSameStorage(original.storage, row.storage) || !sourceSameStorage(alias.storage, row.storage)
    || !SourceGraph.sameOwnershipPlacement(summary.placement, row.held)
    || directive.evaluation.index != selection.result.index || output.evaluation.index != directive.evaluation.index
    || canonical.evaluation.index != output.evaluation.index || transport.evaluation.index != output.evaluation.index
    || canonical.phase != SourceGraphValuePhase.Input || transport.phase != SourceGraphValuePhase.Transport
    || output.phase != SourceGraphValuePhase.Output || !sourcePhysicalValue(output)
    || alias.evaluation.index != selection.operand.index || alias.endpoint.index != map.source.index
    || transport.endpoint.index != map.source.index || output.endpoint.index != map.target.index
    || maps[selectedMap.index].target.index != root.index || map.kind != PreparedSourcesMapKind.Copy
    || read.point.index != SourceGraphBuilder.evaluation(builder, output.evaluation).point.index
    || original.point.index != read.point.index {
    return CompilerBug.panic(b"Field read origin changed its original summary or selected canonical read")
  }
  let stored = SourceGraphBuilder.case(builder, row.storageCase)
  let summarized = SourceGraphBuilder.case(builder, row.summaryCase)
  let transported = SourceGraphBuilder.case(builder, row.transportCase)
  let copied = SourceGraphBuilder.case(builder, row.case)
  let summarySource = match summarized.source { Option<SourceGraph.CellView>.Some {value} => value.id
    _ => { return CompilerBug.panic(b"Field summary publication lost its paired storage Case") } }
  let transportSource = match transported.source { Option<SourceGraph.CellView>.Some {value} => value.id
    _ => { return CompilerBug.panic(b"Field alias transport lost its canonical Input Case") } }
  let copySource = match copied.source { Option<SourceGraph.CellView>.Some {value} => value.id
    _ => { return CompilerBug.panic(b"Field output lost its actual alias transport Case") } }
  let summaryAuthority = match summarized.authority {
    SourceGraphTransferAuthority.SummaryRead {reading: actual} => actual == row.summaryRead
    _ => false
  }
  let identity = match transported.authority { SourceGraphTransferAuthority.SameComponent => true _ => false }
  let copy = match copied.authority {
    SourceGraphTransferAuthority.Physical {map: actual, direction, ..} => actual.index == row.map.index
      && direction == SourceGraphMapDirection.Forward
    _ => false
  }
  if !summaryAuthority || !identity || !copy || summarySource != stored.target.id
    || transportSource != summarized.target.id || copySource != transported.target.id
    || summarized.target.value.index != row.canonical.index || transported.target.value.index != row.transport.index
    || copied.target.value.index != row.output.index
    || !sourceDefinitionMatches(stored.definition, Option<SourceControl.DefinitionId>.some(row.definition))
    || !sourceReadMatches(stored.read, Option<SourceControl.ReadId>.some(row.read)) {
    return CompilerBug.panic(b"Field read origin changed its exact canonical Case chain")
  }
  let cells: [SourceGraph.CellView; 4] = [stored.target, summarized.target, transported.target, copied.target]
  let mut at = usize.ZERO
  while at < cells.length {
    let cell = cells[at]
    if cell.category != row.category || cell.leaf.index != row.leaf.index || cell.direct != row.direct
      || !sourceDefinitionMatches(cell.definition, Option<SourceControl.DefinitionId>.some(row.definition))
      || !sourceReadMatches(cell.read, Option<SourceControl.ReadId>.some(row.read)) {
      return CompilerBug.panic(b"Field read origin substituted another raw history")
    }
    at = at + usize.ONE
  }
  if let Option<SourceAtom>.None = sourceFlowPair(&builder.reaching, row.definition, row.read) {
    return SourceOriginField {root: root, field: SourceReadField {supported: false, field: usize.MAX}}
  }
  return SourceOriginField {root: root,
    field: run sourceReadPlacementField(builder, definition, row.storage, root, map.target, &mut paths.*)}
}

// An admitted exact retained write defines placement at its destination. Its installed
// Flow definition is independent of the raw witness carried by the incoming source.
effect fn sourceRetainedWriteOrigin<'body>(builder: &SourceGraphBuilder<'body>, writing: usize,
  category: SourceGraphSourceRole, root: PreparedSources.EndpointId, paths: &mut List<List<Step>>)
  -> SourceOriginField ! OutOfMemoryError ? &mut Allocator {
  let row = SourceGraphBuilder.retainedWritePublications(builder)[writing]
  let candidate = SourceGraphBuilder.writeCandidate(builder, row.candidate)
  let holder = SourceGraphBuilder.writeHolder(builder, row.holder)
  let component = List<SourceGraph.WriteComponent>.asSlice(&holder.components)[row.component]
  let address = SourceGraphBuilder.retainedAddresses(builder)[candidate.address]
  let installed = SourceGraphBuilder.definition(builder, row.definition)
  let target = SourceGraphBuilder.value(builder, row.target)
  let execution = SourceGraphBuilder.evaluation(builder, holder.execution)
  let writer = match installed.writer { Option<SourceGraph.EvalId>.Some {value} => value
    _ => { return CompilerBug.panic(b"retained publication lost its installed writer") } }
  if !sourceSameSummary(candidate.summary, Option<usize>.none())
    || !sourceSameSummary(installed.summary, Option<usize>.none())
    || !sourceSameSummary(target.summary, Option<usize>.none())
    || !sourceSameSummary(target.writeHolder, Option<usize>.some(row.holder))
    || row.category != category || row.owner.endpoint.index != root.index
    || candidate.holder != row.holder || candidate.source.index != row.source.index || candidate.target.index != row.target.index
    || !sourceSameStorage(holder.storage, row.owner) || !sourceSameStorage(address.storage, row.storage)
    || !sourceSameStorage(component.storage, row.storage) || !sourceSameStorage(installed.storage, row.storage)
    || component.definition.index != row.definition.index || component.value.index != row.target.index
    || installed.value.index != row.target.index || writer.index != holder.execution.index
    || installed.point.index != execution.point.index || installed.write != SourceControlWrite.Weak
    || target.phase != SourceGraphValuePhase.Output || target.evaluation.index != holder.execution.index
    || target.endpoint.index != row.storage.endpoint.index || row.direct {
    return CompilerBug.panic(b"retained publication changed its actual destination definition")
  }
  let actual = SourceGraphBuilder.case(builder, row.case)
  let source = match actual.source { Option<SourceGraph.CellView>.Some {value} => value
    _ => { return CompilerBug.panic(b"retained publication substituted a seed for its source") } }
  let authority = match actual.authority {
    SourceGraphTransferAuthority.RetainedWrite {candidate: original} => original == row.candidate
    _ => false
  }
  if !authority || source.value.index != row.source.index || actual.target.value.index != row.target.index
    || source.category != row.sourceCategory || actual.target.category != row.category
    || source.leaf.index != row.leaf.index || actual.target.leaf.index != row.leaf.index
    || source.direct != row.sourceDirect || actual.target.direct != row.direct
    || !sourceDefinitionMatches(source.definition, row.sourceDefinition)
    || !sourceDefinitionMatches(actual.target.definition, row.sourceDefinition)
    || !sourceReadMatches(source.read, row.sourceRead) || !sourceReadMatches(actual.target.read, row.sourceRead)
    || !sourceDefinitionMatches(actual.definition, Option<SourceControl.DefinitionId>.none())
    || !sourceReadMatches(actual.read, Option<SourceControl.ReadId>.none()) {
    return CompilerBug.panic(b"retained publication changed its admitted Case or carried witness")
  }
  return SourceOriginField {root: root, field: run sourceOwnershipField(builder, root,
    SourceGraphOwnershipPlacement.Known {anchor: row.storage.endpoint, suffix: Option<SourceGraph.OwnershipSuffix>.none()}, &mut paths.*)}
}

effect fn sourceOwnershipOriginField<'body>(builder: &SourceGraphBuilder<'body>, origin: SourceGraphOwnershipOrigin,
  paths: &mut List<List<Step>>) -> SourceOriginField ! OutOfMemoryError ? &mut Allocator {
  let placement = match origin {
    SourceGraphOwnershipOrigin.Read {placement, ..} => placement
    SourceGraphOwnershipOrigin.OperationReset {root, ..} => {
      return SourceOriginField {root: root, field: SourceReadField {supported: true, field: usize.ZERO}}
    }
    SourceGraphOwnershipOrigin.OrdinaryReset {root, ..} => {
      return SourceOriginField {root: root, field: SourceReadField {supported: true, field: usize.ZERO}}
    }
    SourceGraphOwnershipOrigin.FieldRead {reading, category, root, ..} => {
      return run sourceFieldReadOrigin(builder, reading, category, root, &mut paths.*)
    }
    SourceGraphOwnershipOrigin.RetainedWrite {writing, category, root, ..} => {
      return run sourceRetainedWriteOrigin(builder, writing, category, root, &mut paths.*)
    }
    SourceGraphOwnershipOrigin.FieldResult {recipe, root, ..} => {
      let selected = SourceGraphBuilder.fieldResultRecipes(builder)[recipe]
      if selected.root.index != root.index {
        return CompilerBug.panic(b"field ownership origin changed its actual result root")
      }
      return SourceOriginField {root: root,
        field: run sourceOwnershipField(builder, root, selected.placement, &mut paths.*)}
    }
    SourceGraphOwnershipOrigin.ThroughReset {root, ..} => {
      return SourceOriginField {root: root, field: SourceReadField {supported: true, field: usize.ZERO}}
    }
    SourceGraphOwnershipOrigin.RvalueDereference {root, ..} => {
      return SourceOriginField {root: root, field: SourceReadField {supported: true, field: usize.ZERO}}
    }
    SourceGraphOwnershipOrigin.CaptureReborrow {origin: capturedOrigin, case, ..} => {
      let acquisition = SourceGraphBuilder.captureReborrows(builder)[capturedOrigin]
      let seed = SourceGraphBuilder.case(builder, case)
      let descriptor = SourceGraphBuilder.value(builder, acquisition.descriptor)
      if seed.target.value.index != acquisition.descriptor.index || seed.target.leaf.index != acquisition.leaf.index
        || seed.target.category != SourceGraphSourceRole.Ownership || !seed.target.direct
        || descriptor.evaluation.index != acquisition.acquisition.index || descriptor.phase != SourceGraphValuePhase.Output {
        return CompilerBug.panic(b"capture reborrow ownership origin changed its actual seed")
      }
      return SourceOriginField {root: descriptor.endpoint, field: SourceReadField {supported: true, field: usize.ZERO}}
    }
    SourceGraphOwnershipOrigin.Move {candidate, storage, held, source, target, definition, read, ..} => {
      let actual = SourceGraphBuilder.moveHoldings(builder)[candidate]
      if actual.source.index != source.index || actual.target.index != target.index
        || actual.definition.index != definition.index || actual.read.index != read.index
        || !sourceSameStorage(actual.storage, storage) || !SourceGraph.sameOwnershipPlacement(actual.held, held) {
        return CompilerBug.panic(b"Move ownership origin changed its original holder history")
      }
      let observation = SourceGraphBuilder.moveObservations(builder)[actual.observation]
      // Selected Move preserves A unchanged, independently of selected B/result shape.
      return SourceOriginField {root: SourceGraphBuilder.value(builder, target).endpoint,
        field: run sourceOwnershipField(builder, observation.owner.endpoint, held, &mut paths.*)}
    }
    SourceGraphOwnershipOrigin.Reference {candidate, storage, held, source, target, ..} => {
      let actual = SourceGraphBuilder.referenceHoldings(builder)[candidate]
      if actual.source.index != source.index || actual.target.index != target.index {
        return CompilerBug.panic(b"reference ownership origin changed its actual acquisition")
      }
      return SourceOriginField {root: SourceGraphBuilder.value(builder, target).endpoint,
        field: run sourceReferenceField(builder, actual, storage, held, &mut paths.*)}
    }
  }
  let originalDefinition = match origin { SourceGraphOwnershipOrigin.Read {definition, ..} => definition
    _ => { return CompilerBug.panic(b"read ownership origin changed kind") } }
  let definition = SourceGraphBuilder.definition(builder, originalDefinition)
  let read = SourceGraphBuilder.read(builder, placement.read)
  let original = SourceGraphBuilder.read(builder, placement.original)
  let consumer = SourceGraphBuilder.value(builder, placement.consumer)
  let prepared = SourceGraphBuilder.preparation(builder)
  let endpoints = List<PreparedSources.Endpoint>.asSlice(&prepared.endpoints)
  let maps = List<PreparedSources.SelectionMap>.asSlice(&prepared.maps)
  if let Option<usize>.None = definition.summary {
    return CompilerBug.panic(b"summary publication lost its original summary definition")
  }
  if placement.map.index >= maps.length { return CompilerBug.panic(b"summary publication has no original Copy") }
  let map = &maps[placement.map.index]
  if consumer.phase != SourceGraphValuePhase.Input || consumer.evaluation.index != placement.result.index
    || consumer.endpoint.index != map.target.index || map.kind != PreparedSourcesMapKind.Copy {
    return CompilerBug.panic(b"summary publication changed its original input consumer")
  }
  let absent = SourceOriginField {root: map.target, field: SourceReadField {supported: false, field: usize.MAX}}
  if !sourcePlacementStorage(definition, read, original, placement, endpoints) {
    return absent
  }
  if let Option<SourceAtom>.None = sourceFlowPair(&builder.reaching, originalDefinition, placement.read) {
    return absent
  }
  return SourceOriginField {root: map.target, field: run sourceReadField(builder, definition,
    placement, map.target, map.target, &mut paths.*)}
}

struct SourcePublicationRows {
  origin: usize
  publications: List<usize>
  gaps: List<usize>
}

fn sourcePublicationOrigin(rows: &[SourcePublicationRows], origin: usize) -> usize {
  let mut lower = usize.ZERO
  let mut upper = rows.length
  while lower < upper {
    let middle = lower + (upper - lower) / 2
    if rows[middle].origin < origin { lower = middle + usize.ONE }
    else { upper = middle }
  }
  if lower >= rows.length { return CompilerBug.panic(b"publication row lost its retained origin") }
  if rows[lower].origin != origin { return CompilerBug.panic(b"publication row lost its retained origin") }
  return lower
}

// Group only immutable row ordinals. Origins and each origin's publication/gap rows
// retain their original order; applicability and placement still belong to the consumer.
effect fn sourcePublicationRows<'body>(builder: &SourceGraphBuilder<'body>, value: SourceGraph.ValueId,
  leaf: SourceGraph.LeafId, history: &SourceGraph.InputCase) -> List<SourcePublicationRows>
! OutOfMemoryError ? &mut Allocator {
  let origins = run SourceGraphBuilder.ownershipPublicationOrigins(builder, value)
  let ordered = List<usize>.asSlice(&origins)
  let mut result = List<SourcePublicationRows>.make()
  let mut at = usize.ZERO
  while at < ordered.length {
    run List<SourcePublicationRows>.append(&mut result, SourcePublicationRows {
      origin: ordered[at], publications: List<usize>.make(), gaps: List<usize>.make()})
    at = at + usize.ONE
  }
  let publications = SourceGraphBuilder.ownershipPublicationsAt(builder, value)
  at = usize.ZERO
  while at < publications.length {
    let ordinal = publications[at]
    let row = SourceGraphBuilder.ownershipPublications(builder)[ordinal]
    if sourcePublicationCase(value, leaf, history, row.value, row.leaf, row.category, row.direct, row.definition, row.read) {
      let origin = sourcePublicationOrigin(List<SourcePublicationRows>.asSlice(&result), row.origin)
      let rows = List<SourcePublicationRows>.asMutSlice(&mut result)
      run List<usize>.append(&mut rows[origin].publications, ordinal)
    }
    at = at + usize.ONE
  }
  let gaps = SourceGraphBuilder.ownershipPublicationGapsAt(builder, value)
  at = usize.ZERO
  while at < gaps.length {
    let ordinal = gaps[at]
    let row = SourceGraphBuilder.ownershipPublicationGaps(builder)[ordinal]
    if sourcePublicationCase(value, leaf, history, row.value, row.leaf, row.category, row.direct, row.definition, row.read) {
      let origin = sourcePublicationOrigin(List<SourcePublicationRows>.asSlice(&result), row.origin)
      let rows = List<SourcePublicationRows>.asMutSlice(&mut result)
      run List<usize>.append(&mut rows[origin].gaps, ordinal)
    }
    at = at + usize.ONE
  }
  return move result
}

// Attribute a copied summary from its retained origin, including copies whose current
// physical definition is no longer a summary. Unsupported branches remain missing even
// beside a supported publication of the same current cell.
effect fn sourcePublishedCases<'body>(builder: &mut SourceGraphBuilder<'body>, value: SourceGraph.ValueId,
  leaf: SourceGraph.LeafId, history: &SourceGraph.InputCase, root: PreparedSources.EndpointId,
  paths: &mut List<List<Step>>, cases: &mut List<SourceCarryCase>, unknown: SourceAtom, summaries: bool)
  -> SourceAtom ! OutOfMemoryError ? &mut Allocator {
  let empty = List<SourceAtom>.make()
  let none = List<SourceAtom>.asSlice(&empty)
  let mut provenance = List<SourceAtom>.make()
  let originRows = run sourcePublicationRows(&builder.*, value, leaf, history)
  let mut originCursor = usize.ZERO
  while originCursor < List<SourcePublicationRows>.length(&originRows) {
    let selected = &List<SourcePublicationRows>.asSlice(&originRows)[originCursor]
    let origin = selected.origin
    let publications = List<usize>.asSlice(&selected.publications)
    let missingRows = List<usize>.asSlice(&selected.gaps)
    let original = SourceGraphBuilder.ownershipOrigins(&builder.*)[origin]
    let mut arriving = List<SourceAtom>.make()
    let mut at = usize.ZERO
    while at < publications.length {
      let ordinal = publications[at]
      let row = SourceGraphBuilder.ownershipPublications(&builder.*)[ordinal]
      run List<SourceAtom>.append(&mut arriving, row.active)
      at = at + usize.ONE
    }
    at = usize.ZERO
    while at < missingRows.length {
      let ordinal = missingRows[at]
      let row = SourceGraphBuilder.ownershipPublicationGaps(&builder.*)[ordinal]
      run List<SourceAtom>.append(&mut arriving, row.active)
      at = at + usize.ONE
    }
    if List<SourceAtom>.length(&arriving) == usize.ZERO { originCursor = originCursor + usize.ONE continue }
    let arrived = run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&arriving))
    run List<SourceAtom>.append(&mut provenance, arrived)
    if !summaries { originCursor = originCursor + usize.ONE continue }
    let originField = run sourceOwnershipOriginField(&builder.*, original, &mut paths.*)
    let field = originField.field
    let initialRoot = originField.root
    let mut supported = List<SourceAtom>.make()
    let mut gaps = List<SourceAtom>.make()
    if let SourceGraphOwnershipOrigin.Read {placement, ..} = original {
      let selectedAddress = run sourceSelectionCoverage(&mut builder.*, placement.result, initialRoot, false, arrived)
      run List<SourceAtom>.append(&mut gaps, selectedAddress.missing)
      if let Option<usize>.Some {value: alias} = placement.alias {
        let incomplete: [SourceAtom; 2] = [arrived, SourceGraphBuilder.aliasMissing(&builder.*, alias)]
        run List<SourceAtom>.append(&mut gaps, run SourcePolicy.conjunction(&mut builder.rules, &incomplete, none))
      }
    }
    if let SourceGraphOwnershipOrigin.FieldRead {reading, ..} = original {
      let read = SourceGraphBuilder.fieldReads(&builder.*)[reading]
      let evaluation = SourceGraphBuilder.resultUses(&builder.*)[read.result].evaluation
      let selectedAddress = run sourceSelectionCoverage(&mut builder.*, evaluation, read.root, false, arrived)
      run List<SourceAtom>.append(&mut gaps, selectedAddress.missing)
      let incomplete: [SourceAtom; 2] = [arrived, SourceGraphBuilder.aliasMissing(&builder.*, read.alias)]
      run List<SourceAtom>.append(&mut gaps, run SourcePolicy.conjunction(&mut builder.rules, &incomplete, none))
    }
    at = usize.ZERO
    while at < publications.length {
      let ordinal = publications[at]
      let row = SourceGraphBuilder.ownershipPublications(&builder.*)[ordinal]
      if field.supported {
        let initial = run sourceOwnershipField(&builder.*, initialRoot, row.initial, &mut paths.*)
        let selected = initial.supported && sourceSameField(List<List<Step>>.asSlice(&paths.*), field.field, initial.field)
        if selected {
          let mapped = run sourceOwnershipField(&builder.*, root, row.placement, &mut paths.*)
          if mapped.supported {
            run List<SourceAtom>.append(&mut supported, row.active)
            let mut retained = sourceCase(run sourceGatedCase(history, row.active, &mut builder.rules), mapped.field)
            retained.publication = Option<usize>.some(ordinal)
            run List<SourceCarryCase>.append(&mut cases.*, move retained)
          }
        }
      }
      at = at + usize.ONE
    }
    at = usize.ZERO
    while at < missingRows.length {
      let ordinal = missingRows[at]
      let row = SourceGraphBuilder.ownershipPublicationGaps(&builder.*)[ordinal]
      if field.supported {
        let initial = run sourceOwnershipField(&builder.*, initialRoot, row.initial, &mut paths.*)
        let selected = initial.supported && sourceSameField(List<List<Step>>.asSlice(&paths.*), field.field, initial.field)
        if selected { run List<SourceAtom>.append(&mut gaps, row.active) }
      }
      at = at + usize.ONE
    }
    let active: [SourceAtom; 1] = [arrived]
    run List<SourceAtom>.append(&mut gaps, run SourcePolicy.conjunction(&mut builder.rules,
      &active, List<SourceAtom>.asSlice(&supported)))
    let missing = run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&gaps))
    let incomplete: [SourceAtom; 2] = [history.quality.present, missing]
    run SourceProgram.rule(&mut builder.rules, unknown, &incomplete, none)
    run List<SourceCarryCase>.append(&mut cases.*, sourceCase(run sourceGatedCase(history, missing, &mut builder.rules), usize.MAX))
    originCursor = originCursor + usize.ONE
  }
  return run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&provenance))
}

// Ordinary writes receive the exact installed component, independently of the RHS finish
// scan. A handler authorizes retaining or dropping it at its actual writer occurrence.
struct SourceOrdinaryUse {
  writer: SourceGraph.EvalId
  active: SourceAtom
  retained: bool
}
impl Copy for SourceOrdinaryUse {}

fn sourceDisposition<'body>(builder: &SourceGraphBuilder<'body>, definition: Option<SourceControl.DefinitionId>)
  -> SourceGraphSummaryDisposition {
  if let Option<SourceControl.DefinitionId>.Some {value} = definition {
    if let Option<usize>.Some {value: summary} = SourceGraphBuilder.definition(builder, value).summary {
      return SourceGraphBuilder.summaries(builder)[summary].disposition
    }
  }
  return SourceGraphSummaryDisposition.Ordinary
}

fn sourceSettledDisposition<'body>(graph: &SourceGraphGraph<'body>, definition: Option<SourceControl.DefinitionId>)
  -> SourceGraphSummaryDisposition {
  if let Option<SourceControl.DefinitionId>.Some {value} = definition {
    if let Option<usize>.Some {value: summary} = SourceGraphGraph.definition(graph, value).summary {
      return SourceGraphGraph.summaries(graph)[summary].disposition
    }
  }
  return SourceGraphSummaryDisposition.Ordinary
}

fn sourceCopiedDisposition(disposition: SourceGraphSummaryDisposition) -> SourceGraphSummaryDisposition {
  return match disposition { SourceGraphSummaryDisposition.Ordinary => SourceGraphSummaryDisposition.Ordinary
    SourceGraphSummaryDisposition.Shadowed => SourceGraphSummaryDisposition.Inherited
    SourceGraphSummaryDisposition.Inherited => SourceGraphSummaryDisposition.Inherited }
}

effect fn sourceOrdinaryMatches<'body>(builder: &SourceGraphBuilder<'body>, candidate: SourceGraph.OrdinarySummaryWrite,
  root: SourceGraph.Storage, field: usize, disposition: SourceGraphSummaryDisposition, paths: &mut List<List<Step>>) -> bool
! OutOfMemoryError ? &mut Allocator {
  let summary = SourceGraphBuilder.summaries(builder)[candidate.summary]
  if summary.disposition != disposition { return false }
  let endpoints = List<PreparedSources.Endpoint>.asSlice(&SourceGraphBuilder.preparation(builder).endpoints)
  let owner = match sourceStorageRoot(endpoints, summary.prefix) {
    Option<SourceGraph.Storage>.Some {value} => value _ => { return false }
  }
  if !sourceSameStorage(owner, root) { return false }
  if sourceUnknownPlacement(summary.placement) { return field == usize.MAX && sourceSameStorage(summary.prefix, root) }
  if field == usize.MAX { return false }
  let selected = run sourceOwnershipField(builder, root.endpoint, summary.placement, &mut paths.*)
  return selected.supported && sourceSameField(List<List<Step>>.asSlice(&paths.*), field, selected.field)
}

// Bind every reserved ordinary-summary port, and separately inspect every original write.
// Empty candidate/port families cannot erase a copied history. Only the exact publication
// of held-A selects a canonical summary; opaque MAX never becomes a physical component.
effect fn sourceOrdinarySummaries<'body>(builder: &mut SourceGraphBuilder<'body>, uses: &[SourceOrdinaryUse],
  paths: &mut List<List<Step>>) -> SourceAtom ! OutOfMemoryError ? &mut Allocator {
  let no = SourceProgram.atom(&mut builder.rules)
  let empty = List<SourceAtom>.make()
  let none = List<SourceAtom>.asSlice(&empty)
  let mut admitted = List<SourceAtom>.make()
  let missing = SourceProgram.atom(&mut builder.rules)
  let mut at = usize.ZERO
  while at < SourceGraphBuilder.policyCount(&builder.*) {
    run List<SourceAtom>.append(&mut admitted, SourceProgram.atom(&mut builder.rules))
    at = at + usize.ONE
  }
  let mut index = usize.ZERO
  while index < SourceGraphBuilder.definitionCount(&builder.*) {
    let definition = SourceGraphBuilder.definition(&builder.*, SourceControl.DefinitionId {index: index})
    index = index + usize.ONE
    if let Option<usize>.Some {..} = definition.summary { continue }
    let writer = match definition.writer { Option<SourceGraph.EvalId>.Some {value} => value _ => { continue } }
    let installed = SourceGraphBuilder.value(&builder.*, definition.value)
    if let Option<usize>.Some {..} = installed.writeHolder { continue }
    let point = SourceGraphBuilder.evaluation(&builder.*, writer).point
    if point.index != definition.point.index { return CompilerBug.panic(b"ordinary policy changed its actual writer point") }
    let reached = List<SourceControl.Point>.asSlice(&builder.reaching.points)[point.index].reachable
    let root = sourceStorageRoot(List<PreparedSources.Endpoint>.asSlice(&SourceGraphBuilder.preparation(&builder.*).endpoints), definition.storage)
    let mut use = Option<SourceOrdinaryUse>.none()
    at = usize.ZERO
    while at < uses.length {
      if uses[at].writer.index == writer.index {
        if let Option<SourceOrdinaryUse>.Some {..} = use { return CompilerBug.panic(b"ordinary writer has duplicate policy owners") }
        use = Option<SourceOrdinaryUse>.some(uses[at])
      }
      at = at + usize.ONE
    }
    // Raw installed histories are intentional here; storage occupancy uses the graph's
    // definition projection after these histories have been redirected to summary lanes.
    let mut inputs = run SourceGraphBuilder.inputs(&mut builder.*, definition.value)
    while List<SourceGraph.Input>.length(&inputs) != usize.ZERO {
      let input = List<SourceGraph.Input>.remove(&mut inputs, usize.ZERO)
      let borrow = match &SourceGraphBuilder.leaf(&builder.*, input.leaf).kind { SourceGraphSourceLeaf.Borrow {..} => true _ => false }
      if !borrow { continue }
      let mut histories = move input.cases
      while List<SourceGraph.InputCase>.length(&histories) != usize.ZERO {
        let history = List<SourceGraph.InputCase>.remove(&mut histories, usize.ZERO)
        let mut cases = List<SourceCarryCase>.make()
        let unknown = SourceProgram.atom(&mut builder.rules)
        let observedRoot = match root { Option<SourceGraph.Storage>.Some {value} => value.endpoint _ => installed.endpoint }
        let provenance = run sourcePublishedCases(&mut builder.*, definition.value, input.leaf, &history,
          observedRoot, &mut paths.*, &mut cases, unknown, true)
        let activeGates: [SourceAtom; 3] = [reached, history.quality.present, provenance]
        let active = run SourcePolicy.conjunction(&mut builder.rules, &activeGates, none)
        let selected = match use {
          Option<SourceOrdinaryUse>.Some {value} => value
          _ => { let absent: [SourceAtom; 1] = [active]
            run SourceProgram.rule(&mut builder.rules, missing, &absent, none) continue }
        }
        if !selected.retained { continue }
        let root = match root { Option<SourceGraph.Storage>.Some {value} => value
          _ => { let absent: [SourceAtom; 2] = [active, selected.active]
            run SourceProgram.rule(&mut builder.rules, missing, &absent, none) continue } }
        let mut redirected = List<SourceAtom>.make()
        let suppressions = SourceGraphBuilder.fieldReholdSuppressions(&builder.*)
        let mut suppression = usize.ZERO
        while suppression < suppressions.length {
          let row = suppressions[suppression]
          if row.original.index == definition.id.index {
            let observation = SourceGraphBuilder.fieldReholdObservations(&builder.*)[row.observation]
            if !SourceAtom.same(row.active, observation.active) { return CompilerBug.panic(b"ordinary redirect changed its actual field observation") }
            run List<SourceAtom>.append(&mut redirected, row.active)
          }
          suppression = suppression + usize.ONE
        }
        let replaced = run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&redirected))
        let unsupported: [SourceAtom; 3] = [active, selected.active, unknown]
        let rebound: [SourceAtom; 1] = [replaced]
        // This operation's Field cases retain their own complete-source obligation.
        // The suppressed ordinary write is not a second placement/publication demand.
        run SourceProgram.rule(&mut builder.rules, missing, &unsupported, &rebound)
        let mut covered = List<SourceAtom>.make()
        run List<SourceAtom>.append(&mut covered, replaced)
        let mapped = List<SourceCarryCase>.asSlice(&cases)
        let mut each = usize.ZERO
        while each < mapped.length {
          let mut placement = List<SourceAtom>.make()
          run List<SourceAtom>.append(&mut placement, replaced)
          at = usize.ZERO
          while at < SourceGraphBuilder.policyCount(&builder.*) {
            let port = SourceGraphBuilder.policy(&builder.*, at)
            if let SourceGraphTransferAuthority.OrdinarySummary {candidate: ordinal} = port.authority {
              let candidate = SourceGraphBuilder.ordinarySummaries(&builder.*)[ordinal]
              if candidate.original.index == definition.id.index && candidate.source.index == definition.value.index {
                if candidate.writer.index != writer.index || port.terminal || port.source.index != candidate.source.index
                  || port.target.index != candidate.target.index || !sourceSameStorage(candidate.storage, definition.storage) {
                  return CompilerBug.panic(b"ordinary summary policy changed its original definition")
                }
                let incoming = run SourceGraphBuilder.policyCases(&builder.*, port.id)
                if port.leaf.index == input.leaf.index && port.category == history.category && port.direct == history.direct
                  && sourceDefinitionMatches(port.definition, history.definition) && sourceReadMatches(port.read, history.read)
                  && sourcePolicyCase(List<SourceGraph.InputCase>.asSlice(&incoming), &history)
                  && run sourceOrdinaryMatches(&builder.*, candidate, root, mapped[each].field,
                    sourceCopiedDisposition(sourceDisposition(&builder.*, history.definition)), &mut paths.*) {
                  let gates: [SourceAtom; 6] = [active, selected.active, mapped[each].source.quality.present,
                    candidate.active, port.active, port.quality.present]
                  let excluded: [SourceAtom; 1] = [unknown]
                  let accepted = run SourcePolicy.conjunction(&mut builder.rules, &gates, &excluded)
                  let installed: [SourceAtom; 1] = [accepted]
                  run SourceProgram.rule(&mut builder.rules, List<SourceAtom>.asSlice(&admitted)[at], &installed, none)
                  run List<SourceAtom>.append(&mut placement, accepted)
                  run List<SourceAtom>.append(&mut covered, accepted)
                }
              }
            }
            at = at + usize.ONE
          }
          let required: [SourceAtom; 3] = [active, selected.active, mapped[each].source.quality.present]
          run SourceProgram.rule(&mut builder.rules, missing, &required, List<SourceAtom>.asSlice(&placement))
          each = each + usize.ONE
        }
        let required: [SourceAtom; 2] = [active, selected.active]
        run SourceProgram.rule(&mut builder.rules, missing, &required, List<SourceAtom>.asSlice(&covered))
      }
    }
  }
  at = usize.ZERO
  while at < SourceGraphBuilder.policyCount(&builder.*) {
    let port = SourceGraphBuilder.policy(&builder.*, at)
    if let SourceGraphTransferAuthority.OrdinarySummary {..} = port.authority {
      if let SourceGraphSourceLeaf.Unknown {..} = &SourceGraphBuilder.leaf(&builder.*, port.leaf).kind {
        let unknown: [SourceAtom; 2] = [port.active, port.quality.present]
        run SourceProgram.rule(&mut builder.rules, missing, &unknown, none)
      }
      // Indirect summary storage preserves Q; it never promotes Exact to Stored.
      run SourceGraphBuilder.bindPolicy(&mut builder.*, port.id, List<SourceAtom>.asSlice(&admitted)[at],
        no, no)
    }
    at = at + usize.ONE
  }
  return missing
}

// Preserve the original prefixedPath rule independently of physical storage geometry.
// An unknown RHS can become the known written prefix; an unknown prefix cannot.
effect fn sourcePrefixedField(prefix: &[Step], field: usize, paths: &mut List<List<Step>>) -> usize
! OutOfMemoryError ? &mut Allocator {
  if field == usize.MAX && prefix.length == usize.ZERO { return usize.MAX }
  let mut result = List<Step>.make()
  let mut at = usize.ZERO
  while at < prefix.length {
    if prefix[at].kind == StepKind.AnyElement || prefix[at].kind == StepKind.Referent { return usize.MAX }
    run List<Step>.append(&mut result, prefix[at])
    at = at + usize.ONE
  }
  if field != usize.MAX {
    let tail = List<Step>.asSlice(&List<List<Step>>.asSlice(&paths.*)[field])
    at = usize.ZERO
    while at < tail.length { run List<Step>.append(&mut result, tail[at]) at = at + usize.ONE }
  }
  if List<Step>.length(&result) == usize.ZERO { return usize.ZERO }
  let index = List<List<Step>>.length(&paths.*)
  run List<List<Step>>.append(&mut paths.*, move result)
  return index
}

struct SourceFieldPlacement {
  matched: bool
  active: SourceAtom
}

// Old A is authenticated by the actual prewrite definition/read pair. RHS A is either
// its genuine physical placement or one exact publication with its original tag selected.
// Neither an available Unknown candidate nor indirection supplies a missing known path.
effect fn sourceFieldPlacement<'body>(builder: &mut SourceGraphBuilder<'body>,
  candidate: SourceGraph.FieldReholdCandidate, leaf: SourceGraph.LeafId, history: &SourceGraph.InputCase,
  paths: &mut List<List<Step>>) -> SourceFieldPlacement ! OutOfMemoryError ? &mut Allocator {
  let no = SourceProgram.atom(&mut builder.rules)
  let unsupported = SourceFieldPlacement {matched: false, active: no}
  let observation = SourceGraphBuilder.fieldReholdObservations(&builder.*)[candidate.observation]
  let request = SourceGraphBuilder.fieldReholdRequests(&builder.*)[observation.request]
  let written = run sourceOwnershipField(&builder.*, observation.owner.endpoint,
    SourceGraphOwnershipPlacement.Known {anchor: observation.storage.endpoint, suffix: Option<SourceGraph.OwnershipSuffix>.none()}, &mut paths.*)
  let placed = run sourceOwnershipField(&builder.*, observation.owner.endpoint, candidate.placement, &mut paths.*)
  if !written.supported || written.field == usize.MAX || !placed.supported { return move unsupported }
  let prefix = run copySteps(List<Step>.asSlice(&List<List<Step>>.asSlice(&paths.*)[written.field]))
  let mut expected = usize.MAX
  let mut disposition = SourceGraphSummaryDisposition.Ordinary
  let mut active = history.quality.present
  match candidate.origin {
    SourceGraphFieldReholdOrigin.Old {fieldRead, definition, read, storage, held, disposition: originalDisposition} => {
      let reading = SourceGraphBuilder.fieldReholdReads(&builder.*)[fieldRead]
      let original = SourceGraphBuilder.definition(&builder.*, definition)
      let actual = SourceGraphBuilder.read(&builder.*, read)
      if reading.observation != candidate.observation || reading.value.index != candidate.source.index
        || !sourceDefinitionMatches(history.definition, Option<SourceControl.DefinitionId>.some(definition))
        || !sourceReadMatches(history.read, Option<SourceControl.ReadId>.some(read))
        || !sourceSameStorage(original.storage, storage) || !sourceSameReadLane(original, actual)
        || !sourceAcquisitionHistory(SourceGraphBuilder.summaryReads(&builder.*), reading.read, history) {
        return CompilerBug.panic(b"field rehold substituted another old owner history")
      }
      let originalHeld = match original.summary {
        Option<usize>.Some {value} => SourceGraphBuilder.summaries(&builder.*)[value].placement
        _ => SourceGraphOwnershipPlacement.Known {anchor: storage.endpoint, suffix: Option<SourceGraph.OwnershipSuffix>.none()}
      }
      if originalDisposition != sourceDisposition(&builder.*, history.definition) {
        return CompilerBug.panic(b"field rehold changed its incoming disposition")
      }
      if !SourceGraph.sameOwnershipPlacement(originalHeld, held) { return move unsupported }
      let originalField = run sourceOwnershipField(&builder.*, observation.owner.endpoint, originalHeld, &mut paths.*)
      if !originalField.supported { return move unsupported }
      expected = originalField.field
      let discarded = expected != usize.MAX && exactPath(List<Step>.asSlice(&prefix))
        && pathContains(List<Step>.asSlice(&prefix), List<Step>.asSlice(&List<List<Step>>.asSlice(&paths.*)[expected]))
      disposition = originalDisposition
      if originalDisposition == SourceGraphSummaryDisposition.Shadowed || discarded {
        disposition = SourceGraphSummaryDisposition.Shadowed
      }
      let pair = match sourceFlowPair(&builder.reaching, definition, read) {
        Option<SourceAtom>.Some {value} => value
        _ => { return CompilerBug.panic(b"field rehold lost its old definition/read pair") }
      }
      let gates: [SourceAtom; 2] = [active, pair]
      let empty = List<SourceAtom>.make()
      active = run SourcePolicy.conjunction(&mut builder.rules, &gates, List<SourceAtom>.asSlice(&empty))
    }
    SourceGraphFieldReholdOrigin.Rhs {publication, held} => {
      let root = List<PreparedSources.SelectionMap>.asSlice(&SourceGraphBuilder.preparation(&builder.*).maps)[request.map.index].source
      let value = SourceGraphBuilder.value(&builder.*, candidate.source)
      if value.evaluation.index != request.source.index || value.phase != SourceGraphValuePhase.Output || !sourcePhysicalValue(value) {
        return CompilerBug.panic(b"field rehold changed its actual RHS occurrence")
      }
      let field = run sourceOwnershipField(&builder.*, root, held, &mut paths.*)
      if !field.supported { return move unsupported }
      match publication {
        Option<usize>.Some {value: publicationIndex} => {
          let row = SourceGraphBuilder.ownershipPublications(&builder.*)[publicationIndex]
          if !sourcePublicationCase(candidate.source, leaf, history, row.value, row.leaf,
            row.category, row.direct, row.definition, row.read) || !SourceGraph.sameOwnershipPlacement(row.placement, held) {
            return CompilerBug.panic(b"field RHS substituted another ownership publication")
          }
          let original = run sourceOwnershipOriginField(&builder.*, SourceGraphBuilder.ownershipOrigins(&builder.*)[row.origin], &mut paths.*)
          let initial = run sourceOwnershipField(&builder.*, original.root, row.initial, &mut paths.*)
          if !original.field.supported || !initial.supported
            || !sourceSameField(List<List<Step>>.asSlice(&paths.*), original.field.field, initial.field) { return move unsupported }
          let gates: [SourceAtom; 2] = [active, row.active]
          let empty = List<SourceAtom>.make()
          active = run SourcePolicy.conjunction(&mut builder.rules, &gates, List<SourceAtom>.asSlice(&empty))
        }
        _ => {
          if history.category != SourceGraphSourceRole.Physical { return move unsupported }
          let original = run sourceOwnershipField(&builder.*, root,
            SourceGraphOwnershipPlacement.Known {anchor: history.placement, suffix: Option<SourceGraph.OwnershipSuffix>.none()}, &mut paths.*)
          if !original.supported || !sourceSameField(List<List<Step>>.asSlice(&paths.*), original.field, field.field) { return move unsupported }
        }
      }
      expected = run sourcePrefixedField(List<Step>.asSlice(&prefix), field.field, &mut paths.*)
      disposition = sourceCopiedDisposition(sourceDisposition(&builder.*, history.definition))
    }
  }
  return SourceFieldPlacement {matched: disposition == candidate.disposition
    && sourceSameField(List<List<Step>>.asSlice(&paths.*), expected, placed.field), active: active}
}

// All reserved ports are settled, even for unaccepted operations. Coverage is independently
// per original incoming Case, so absent placement alternatives cannot become a drop proof.
effect fn sourceFieldReholds<'body>(builder: &mut SourceGraphBuilder<'body>, paths: &mut List<List<Step>>)
  -> SourceAtom ! OutOfMemoryError ? &mut Allocator {
  let no = SourceProgram.atom(&mut builder.rules)
  let empty = List<SourceAtom>.make()
  let none = List<SourceAtom>.asSlice(&empty)
  let mut at = usize.ZERO
  while at < SourceGraphBuilder.policyCount(&builder.*) {
    let port = SourceGraphBuilder.policy(&builder.*, at)
    if let SourceGraphTransferAuthority.FieldRehold {candidate: ordinal} = port.authority {
      let candidate = SourceGraphBuilder.fieldReholdCandidates(&builder.*)[ordinal]
      let summary = SourceGraphBuilder.summaries(&builder.*)[candidate.summary]
      let installed = SourceGraphBuilder.definition(&builder.*, candidate.definition)
      let observation = SourceGraphBuilder.fieldReholdObservations(&builder.*)[candidate.observation]
      let request = SourceGraphBuilder.fieldReholdRequests(&builder.*)[observation.request]
      if port.terminal || port.outputRole != SourceGraphSourceRole.Ownership
        || port.source.index != candidate.source.index || port.target.index != candidate.target.index
        || installed.value.index != candidate.target.index || !sourceSameSummary(installed.summary, Option<usize>.some(candidate.summary))
        || installed.point.index != SourceGraphBuilder.evaluation(&builder.*, request.execution).point.index
        || summary.disposition != candidate.disposition || !SourceGraph.sameOwnershipPlacement(summary.placement, candidate.placement) {
        return CompilerBug.panic(b"field policy changed its actual semantic definition")
      }
      let incoming = run SourceGraphBuilder.policyCases(&builder.*, port.id)
      let cases = List<SourceGraph.InputCase>.asSlice(&incoming)
      let mut admitted = List<SourceAtom>.make()
      let mut each = usize.ZERO
      while each < cases.length {
        let history = &cases[each]
        if history.case != candidate.case { each = each + usize.ONE continue }
        if history.category != port.category || history.direct != port.direct
          || !sourceDefinitionMatches(history.definition, port.definition) || !sourceReadMatches(history.read, port.read) {
          return CompilerBug.panic(b"field policy changed its exact original Case")
        }
        if let SourceGraphSourceLeaf.Borrow {..} = &SourceGraphBuilder.leaf(&builder.*, port.leaf).kind {
          let placement = run sourceFieldPlacement(&mut builder.*, candidate, port.leaf, history, &mut paths.*)
          if placement.matched {
            let semantic = SourceGraphBuilder.observationCase(&builder.*, history.case).semantic.present
            let gates: [SourceAtom; 5] = [candidate.active, port.active, port.quality.present, placement.active, semantic]
            let kept = run SourcePolicy.conjunction(&mut builder.rules, &gates, none)
            run List<SourceAtom>.append(&mut admitted, kept)
            let mut row = usize.ZERO
            while row < SourceGraphBuilder.fieldReholdCaseCoverage(&builder.*).length {
              let obligation = SourceGraphBuilder.fieldReholdCaseCoverage(&builder.*)[row]
              if obligation.observation == candidate.observation && obligation.case == history.case {
                if obligation.source.index != candidate.source.index || obligation.leaf.index != port.leaf.index
                  || obligation.category != history.category || obligation.direct != history.direct
                  || !sourceDefinitionMatches(obligation.definition, history.definition) || !sourceReadMatches(obligation.read, history.read) {
                  return CompilerBug.panic(b"field coverage substituted another source history")
                }
                let required: [SourceAtom; 2] = [obligation.active, kept]
                run SourceProgram.rule(&mut builder.rules, obligation.covered, &required, none)
              }
              row = row + usize.ONE
            }
          }
        }
        each = each + usize.ONE
      }
      let kept = run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&admitted))
      run SourceGraphBuilder.bindPolicy(&mut builder.*, port.id, kept, no, no)
    }
    at = at + usize.ONE
  }
  let mut missing = List<SourceAtom>.make()
  at = usize.ZERO
  while at < SourceGraphBuilder.fieldReholdCaseCoverage(&builder.*).length {
    let obligation = SourceGraphBuilder.fieldReholdCaseCoverage(&builder.*)[at]
    let projected = SourceGraphBuilder.observationCase(&builder.*, obligation.case)
    let masked: [SourceAtom; 2] = [obligation.active, projected.masked]
    run SourceProgram.rule(&mut builder.rules, obligation.covered, &masked, none)
    let nonholding = match &SourceGraphBuilder.leaf(&builder.*, obligation.leaf).kind {
      SourceGraphSourceLeaf.Borrow {..} => false
      SourceGraphSourceLeaf.Unknown {..} => false _ => true }
    if let Option<bool>.Some {value: constructed} = obligation.construction {
      if !constructed || nonholding {
        let handled: [SourceAtom; 2] = [obligation.active, projected.semantic.present]
        run SourceProgram.rule(&mut builder.rules, obligation.covered, &handled, none)
      }
    }
    run List<SourceAtom>.append(&mut missing, obligation.missing)
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < SourceGraphBuilder.fieldReholdCoverage(&builder.*).length {
    run List<SourceAtom>.append(&mut missing, SourceGraphBuilder.fieldReholdCoverage(&builder.*)[at].missing)
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < SourceGraphBuilder.ownershipMirrorCoverage(&builder.*).length {
    let row = SourceGraphBuilder.ownershipMirrorCoverage(&builder.*)[at]
    if let SourceGraphOwnershipMirrorOrigin.Field {..} = row.origin { run List<SourceAtom>.append(&mut missing, row.missing) }
    at = at + usize.ONE
  }
  return run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&missing))
}

// Shared acquisition Inputs may contain several canonical reads. Only this exact read,
// or a summary paired with it, belongs to one acquisition observation. Filter before
// aggregating quality or Unknown so another temporary cannot become this holder's source.
fn sourceAcquisitionHistory(summaries: &[SourceGraph.SummaryRead], original: SourceControl.ReadId,
  history: &SourceGraph.InputCase) -> bool {
  let read = match history.read { Option<SourceControl.ReadId>.Some {value} => value _ => { return false } }
  if read.index == original.index { return true }
  let mut at = usize.ZERO
  while at < summaries.length {
    if summaries[at].original.index == original.index && summaries[at].read.index == read.index { return true }
    at = at + usize.ONE
  }
  return false
}

effect fn sourceObservedInputs<'body>(builder: &mut SourceGraphBuilder<'body>, value: SourceGraph.ValueId,
  read: Option<SourceControl.ReadId>) -> List<SourceGraph.Input> ! OutOfMemoryError ? &mut Allocator {
  let mut inputs = run SourceGraphBuilder.observationInputs(&mut builder.*, value)
  let original = match read { Option<SourceControl.ReadId>.Some {value: selectedRead} => selectedRead _ => { return move inputs } }
  let mut selected = List<SourceGraph.Input>.make()
  while List<SourceGraph.Input>.length(&inputs) != usize.ZERO {
    let mut input = List<SourceGraph.Input>.remove(&mut inputs, usize.ZERO)
    let mut cases = List<SourceGraph.InputCase>.make()
    let mut present = List<SourceAtom>.make()
    let mut stored = List<SourceAtom>.make()
    let mut alternatives = List<SourceAtom>.make()
    while List<SourceGraph.InputCase>.length(&input.cases) != usize.ZERO {
      let history = List<SourceGraph.InputCase>.remove(&mut input.cases, usize.ZERO)
      if sourceAcquisitionHistory(SourceGraphBuilder.summaryReads(&builder.*), original, &history) {
        run List<SourceAtom>.append(&mut present, history.quality.present)
        run List<SourceAtom>.append(&mut stored, history.quality.stored)
        run List<SourceAtom>.append(&mut alternatives, history.quality.alternatives)
        run List<SourceGraph.InputCase>.append(&mut cases, move history)
      }
    }
    if List<SourceGraph.InputCase>.length(&cases) != usize.ZERO {
      input.cases = move cases
      input.quality = SourceGraph.Cell {
        present: run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&present)),
        stored: run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&stored)),
        alternatives: run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&alternatives))}
      run List<SourceGraph.Input>.append(&mut selected, move input)
    }
  }
  return move selected
}

// A selected value is supplied by an actual read or physical operand lookup. This helper
// does not recover an observation from a write target with the same endpoint.
effect fn sourceObserveValue<'body>(builder: &mut SourceGraphBuilder<'body>, observed: &mut SourceObservation,
  actual: SourceOperand, id: SourceGraph.ValueId, paths: &mut List<List<Step>>, loans: usize,
  present: &mut List<SourceAtom>, summaries: bool, read: Option<SourceControl.ReadId>) -> () ! OutOfMemoryError ? &mut Allocator {
  let evaluation = SourceGraphBuilder.evaluation(&builder.*, actual.evaluation)
  let unknown = observed.unknown
  let mut inputs = run sourceObservedInputs(&mut builder.*, id, read)
  while List<SourceGraph.Input>.length(&inputs) > usize.ZERO {
    let input = List<SourceGraph.Input>.remove(&mut inputs, usize.ZERO)
    run List<SourceAtom>.append(&mut present.*, input.quality.present)
    let cases = List<SourceGraph.InputCase>.asSlice(&input.cases)
    let mut each = usize.ZERO
    while each < cases.length {
      let projected = SourceGraphBuilder.observationCase(&builder.*, cases[each].case)
      // An explicitly normalized physical history is handled content, not an unknown
      // empty read. It contributes no ownership quality or additional carry position.
      run List<SourceAtom>.append(&mut present.*, projected.masked)
      each = each + usize.ONE
    }
    let mut loan = usize.MAX
    let mut unresolved = false
    match &SourceGraphBuilder.leaf(&builder.*, input.leaf).kind {
      SourceGraphSourceLeaf.Borrow {loan: index, ..} => { loan = index }
      SourceGraphSourceLeaf.Unknown {..} => { unresolved = true }
      _ => ()
    }
    if loan == usize.MAX {
      if unresolved {
        let present: [SourceAtom; 1] = [input.quality.present]
        let empty = List<SourceAtom>.make()
        run SourceProgram.rule(&mut builder.rules, unknown, &present, List<SourceAtom>.asSlice(&empty))
      }
      run List<SourceGraph.Input>.append(&mut observed.other, move input)
    } else {
      if loan >= loans { CompilerBug.panic(b"source carry names an absent actual loan") }
      let mut cases = List<SourceCarryCase>.make()
      let mut histories = move input.cases
      let mut removed = false
      while List<SourceGraph.InputCase>.length(&histories) > usize.ZERO {
        let history = List<SourceGraph.InputCase>.remove(&mut histories, usize.ZERO)
        let mut field = run sourceField(List<PreparedSources.Endpoint>.asSlice(
          &SourceGraphBuilder.preparation(&builder.*).endpoints), actual.root, history.placement, &mut paths.*)
        let mut summary = false
        if let Option<SourceControl.DefinitionId>.Some {value: definition} = history.definition {
          if let Option<usize>.Some {..} = SourceGraphBuilder.definition(&builder.*, definition).summary {
            summary = true
            // The final placement names B; it never recovers the original summary A.
            // The explicit read handler attributes A/B before using a precise field.
            field = usize.MAX
          }
        }
        if SourceGraphBuilder.value(&builder.*, id).phase == SourceGraphValuePhase.Input {
          if summary && !summaries { removed = true continue }
          run List<SourceCarryCase>.append(&mut cases, sourceCase(move history, field))
        } else {
          let provenance = run sourcePublishedCases(&mut builder.*, id, input.leaf, &history,
            actual.root, &mut paths.*, &mut cases, unknown, summaries)
          let present: [SourceAtom; 1] = [history.quality.present]
          let copied: [SourceAtom; 1] = [provenance]
          let ordinary = run SourcePolicy.conjunction(&mut builder.rules, &present, &copied)
          if summary || history.category == SourceGraphSourceRole.Ownership {
            if summaries {
              let missing: [SourceAtom; 1] = [ordinary]
              let empty = List<SourceAtom>.make()
              run SourceProgram.rule(&mut builder.rules, unknown, &missing, List<SourceAtom>.asSlice(&empty))
              run List<SourceCarryCase>.append(&mut cases, sourceCase(run sourceGatedCase(&history, ordinary, &mut builder.rules), usize.MAX))
            }
          } else {
            run List<SourceCarryCase>.append(&mut cases, sourceCase(run sourceGatedCase(&history, ordinary, &mut builder.rules), field))
          }
          removed = true
        }
      }
      let mut quality = sourceQuality(input.quality)
      if removed {
        if List<SourceCarryCase>.length(&cases) == usize.ZERO { continue }
        let mut present = List<SourceAtom>.make()
        let mut stored = List<SourceAtom>.make()
        let mut alternatives = List<SourceAtom>.make()
        let retained = List<SourceCarryCase>.asSlice(&cases)
        let mut at = usize.ZERO
        while at < retained.length {
          run List<SourceAtom>.append(&mut present, retained[at].source.quality.present)
          run List<SourceAtom>.append(&mut stored, retained[at].source.quality.stored)
          run List<SourceAtom>.append(&mut alternatives, retained[at].source.quality.alternatives)
          at = at + usize.ONE
        }
        quality = SourceQuality {present: run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&present)),
          stored: run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&stored)),
          alternatives: run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&alternatives))}
      }
      run List<SourceCarryPosition>.append(&mut observed.positions, SourceCarryPosition {
        node: actual.node, root: actual.root, value: id, leaf: input.leaf, loan: loan, operand: actual.ordinal, since: evaluation.point.index,
        quality: quality, cases: move cases})
    }
  }
  return ()
}

// Collect without solving or sampling Truth. Each supplied operand is scanned in prepared
// component order, then stable leaf order; case alternatives do not multiply scan positions.
effect fn sourceObserve<'body>(builder: &mut SourceGraphBuilder<'body>, operands: &[SourceOperand],
  phase: SourceGraphValuePhase, paths: &mut List<List<Step>>, loans: usize, wholeOwner: bool,
  completion: Option<usize>) -> SourceObservation
! OutOfMemoryError ? &mut Allocator {
  let mut complete = Option<SourceAtom>.none()
  if let Option<usize>.Some {value: demand} = completion {
    if phase != SourceGraphValuePhase.Output || wholeOwner || operands.length != usize.ONE {
      return CompilerBug.panic(b"whole ownership completion changed its semantic operand observation")
    }
    let actual = operands[usize.ZERO]
    let exact = sourceOrdinaryResultDemand(&builder.*, actual.evaluation, actual.root, false, Forwarding.None)
    match exact {
      Option<usize>.Some {value} => {
        if value != demand { return CompilerBug.panic(b"semantic operand completion belongs to another result demand") }
      }
      _ => { return CompilerBug.panic(b"semantic operand completion lacks its actual whole result") }
    }
    complete = Option<SourceAtom>.some(SourceGraphBuilder.ordinaryResultDemands(&builder.*)[demand].completion)
  }
  let unknown = SourceProgram.atom(&mut builder.rules)
  let mut observed = SourceObservation {positions: List<SourceCarryPosition>.make(),
    other: List<SourceGraph.Input>.make(), unknown: unknown}
  let mut operand = usize.ZERO
  while operand < operands.length {
    let actual = operands[operand]
    let components = run sourceComponents(SourceGraphBuilder.preparation(&builder.*), actual.root)
    let ordered = List<PreparedSources.EndpointId>.asSlice(&components)
    let mut component = usize.ZERO
    while component < ordered.length {
      let endpoint = ordered[component]
      if true {
        let values = SourceGraphBuilder.values(&builder.*)
        let mut value = usize.ZERO
        while value < values.length {
          let physical = sourcePhysicalValue(values[value])
          if physical && values[value].phase == phase && values[value].evaluation.index == actual.evaluation.index
            && values[value].endpoint.index == endpoint.index { break }
          value = value + usize.ONE
        }
        let evaluation = SourceGraphBuilder.evaluation(&builder.*, actual.evaluation)
        let completed = List<SourceControl.Point>.asSlice(&builder.reaching.points)[evaluation.point.index].reachable
        let mut present = List<SourceAtom>.make()
        if value < values.length {
          let id = SourceGraph.ValueId {index: value}
          run sourceObserveValue(&mut builder.*, &mut observed, actual, id, &mut paths.*, loans, &mut present,
            !wholeOwner || endpoint.index == actual.root.index, Option<SourceControl.ReadId>.none())
        }
        // Physical observations require an actual component source. Only the explicit
        // whole-result semantic consumer can instead use universal finish completion.
        // This affects empty inventory alone: existing Unknown/publication gaps above
        // remain independent, and completion never enters source or position quality.
        let mut covered = move present
        if let Option<SourceAtom>.Some {value: semantic} = complete {
          run List<SourceAtom>.append(&mut covered, semantic)
        }
        let reached: [SourceAtom; 1] = [completed]
        run SourceProgram.rule(&mut builder.rules, unknown, &reached, List<SourceAtom>.asSlice(&covered))
      }
      component = component + usize.ONE
    }
    operand = operand + usize.ONE
  }
  return move observed
}

// Attribute the supported exact-component read before finish observes it. A is the actual
// definition's canonical held component; B is the actual alias/local read's canonical
// component. The final consumer Copy is applied exactly once. InputCase.placement is already
// post-transfer and cannot stand for either original A or the selected address B.
//
// Summary Flow pairs retain their original prefix A independently from the requested B.
// A narrower read keeps unknown placement; an unknown whole holding remains MAX even for
// a whole read. Unsupported mapping remains present with a separate coverage obligation.
effect fn sourceAttributeRead<'body>(builder: &mut SourceGraphBuilder<'body>, observation: &mut SourceObservation,
  through: bool, paths: &mut List<List<Step>>, nodes: &[Node], owner: &DeclarationId,
  loans: &[Loan], snapshot: &[SourceQuality], declared: &DeclaredRead, requirements: &[RetentionEdge],
  relations: &[ImpliedGroup], settled: bool, prior: &[SourceWholeHold]) -> SourceAtom ! OutOfMemoryError ? &mut Allocator {
  let empty = List<SourceAtom>.make()
  let none = List<SourceAtom>.asSlice(&empty)
  let mut gaps = List<SourceAtom>.make()
  let positions = List<SourceCarryPosition>.asMutSlice(&mut observation.positions)
  if snapshot.length != positions.length { return CompilerBug.panic(b"read attribution lost its immutable precision snapshot") }
  let mut position = usize.ZERO
  while position < positions.length {
    let actual = SourceGraphBuilder.value(&builder.*, positions[position].value)
    if actual.phase != SourceGraphValuePhase.Input {
      return CompilerBug.panic(b"read attribution observed a published or transport value")
    }
    if let Option<SourceGraph.ResidualSubject>.Some {..} = actual.subject {
      return CompilerBug.panic(b"virtual read attribution lacks an actual selected component")
    }
    let point = SourceGraphBuilder.evaluation(&builder.*, actual.evaluation).point
    let selection = run sourceSelectionCoverage(&mut builder.*, actual.evaluation, positions[position].root,
      false, positions[position].quality.present)
    run List<SourceAtom>.append(&mut gaps, selection.missing)
    let histories = List<SourceCarryCase>.asSlice(&positions[position].cases)
    let mut attributedCases = List<SourceCarryCase>.make()
    if histories.length == usize.ZERO { run List<SourceAtom>.append(&mut gaps, positions[position].quality.present) }
    let mut history = usize.ZERO
    while history < histories.length {
      let mut paired = false
      if let Option<SourceControl.DefinitionId>.Some {value: definition} = histories[history].source.definition {
        if let Option<SourceControl.ReadId>.Some {value: read} = histories[history].source.read {
          let source = SourceGraphBuilder.definition(&builder.*, definition)
          let requested = SourceGraphBuilder.read(&builder.*, read)
          paired = requested.point.index == point.index && sourceSameReadLane(source, requested)
        }
      }
      let mut covered = List<SourceAtom>.make()
      if paired {
        let definition = match histories[history].source.definition {
          Option<SourceControl.DefinitionId>.Some {value} => value
          _ => { return CompilerBug.panic(b"paired read lost its definition identity") }
        }
        let read = match histories[history].source.read {
          Option<SourceControl.ReadId>.Some {value} => value
          _ => { return CompilerBug.panic(b"paired read lost its read identity") }
        }
        if let Option<SourceAtom>.Some {value: reaches} = sourceFlowPair(&builder.reaching, definition, read) {
          let original = SourceGraphBuilder.definition(&builder.*, definition)
          let placements = run SourceGraphBuilder.readPlacements(&builder.*, positions[position].value, read)
          let alternatives = List<SourceGraph.ReadPlacement>.asSlice(&placements)
          let mut at = usize.ZERO
          while at < alternatives.length {
            let placement = alternatives[at]
            if placement.consumer.index != positions[position].value.index
              || placement.read.index != read.index || placement.result.index != actual.evaluation.index {
              return CompilerBug.panic(b"read placement belongs to another actual consumer")
            }
            let requested = SourceGraphBuilder.read(&builder.*, read)
            let selected = SourceGraphBuilder.read(&builder.*, placement.original)
            if sourcePlacementStorage(original, requested, selected, placement,
              List<PreparedSources.Endpoint>.asSlice(&SourceGraphBuilder.preparation(&builder.*).endpoints)) {
              let prepared = SourceGraphBuilder.preparation(&builder.*)
              let maps = List<PreparedSources.SelectionMap>.asSlice(&prepared.maps)
              if placement.map.index >= maps.length { return CompilerBug.panic(b"read placement has no final consumer map") }
              let map = &maps[placement.map.index]
              if map.kind != PreparedSourcesMapKind.Copy || map.target.index != actual.endpoint.index {
                return CompilerBug.panic(b"read placement substituted its final component copy")
              }
              if let Option<usize>.None = placement.alias {
                if placement.operand.index != actual.evaluation.index || map.source.index != selected.storage.endpoint.index {
                  return CompilerBug.panic(b"direct local read substituted its selected canonical component")
                }
              }
              let attributed = run sourceReadField(&builder.*, original, placement, positions[position].root, map.target, &mut paths.*)
              let disjoint = !through && run sourceReadDisjoint(&builder.*, original, placement, &mut paths.*)
              if attributed.supported {
                let mut proof = List<SourceAtom>.make()
                run List<SourceAtom>.append(&mut proof, reaches)
                run List<SourceAtom>.append(&mut proof, placement.active)
                if selection.matched { run List<SourceAtom>.append(&mut proof, selection.complete) }
                let mut excludedSources = List<SourceAtom>.make()
                if let Option<usize>.Some {value: alias} = placement.alias {
                  let missing = SourceGraphBuilder.aliasMissing(&builder.*, alias)
                  run List<SourceAtom>.append(&mut excludedSources, missing)
                  let guards: [SourceAtom; 3] = [histories[history].source.quality.present, placement.active, missing]
                  run List<SourceAtom>.append(&mut gaps, run SourcePolicy.conjunction(&mut builder.rules, &guards, none))
                }
                let supported = run SourcePolicy.conjunction(&mut builder.rules,
                  List<SourceAtom>.asSlice(&proof), List<SourceAtom>.asSlice(&excludedSources))
                run List<SourceAtom>.append(&mut covered, supported)
                let mut released = SourceProgram.atom(&mut builder.rules)
                if !through && declared.known && !disjoint
                  && run sourceReadAncestor(&builder.*, original, placement, &mut paths.*) {
                  let release = run sourceReadFlightRelease(&mut builder.*, placement, &histories[history].source,
                    positions[position].loan, snapshot[position], &mut paths.*, nodes, owner, loans,
                    requirements, relations, settled, prior, List<Shared<Lifetime>>.asSlice(&declared.regions))
                  released = release.released
                  let missing: [SourceAtom; 3] = [supported, histories[history].source.quality.present, release.missing]
                  run List<SourceAtom>.append(&mut gaps, run SourcePolicy.conjunction(&mut builder.rules, &missing, none))
                }
                let selected: [SourceAtom; 2] = [supported, run sourceBoolean(&mut builder.rules, !disjoint)]
                let excluded: [SourceAtom; 1] = [released]
                let retained = run SourcePolicy.conjunction(&mut builder.rules, &selected, &excluded)
                let mut carry = sourceCase(run sourceGatedCase(&histories[history].source, retained, &mut builder.rules), attributed.field)
                let original: [SourceAtom; 2] = [histories[history].observed, supported]
                carry.observed = run SourcePolicy.conjunction(&mut builder.rules, &original, none)
                run List<SourceCarryCase>.append(&mut attributedCases, move carry)
              }
            }
            at = at + usize.ONE
          }
        }
      }
      let known = run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&covered))
      let observed: [SourceAtom; 1] = [histories[history].source.quality.present]
      let supported: [SourceAtom; 1] = [known]
      let missing = run SourcePolicy.conjunction(&mut builder.rules, &observed, &supported)
      run List<SourceAtom>.append(&mut gaps, missing)
      let mut carry = sourceCase(run sourceGatedCase(&histories[history].source, missing, &mut builder.rules), usize.MAX)
      let original: [SourceAtom; 1] = [histories[history].observed]
      carry.observed = run SourcePolicy.conjunction(&mut builder.rules, &original, &supported)
      run List<SourceCarryCase>.append(&mut attributedCases, move carry)
      // Each alternative keeps its own field and proof. In particular, a later inactive
      // placement cannot overwrite the field selected by an earlier active one. Splitting
      // histories never adds a policy position or changes their paired raw identities.
      history = history + usize.ONE
    }
    positions[position].cases = move attributedCases
    // A proven sibling drop removes this history from the selected value, while its
    // observed raw Case remains available to bind the terminal port false.
    let cases = List<SourceCarryCase>.asSlice(&positions[position].cases)
    let mut present = List<SourceAtom>.make()
    let mut stored = List<SourceAtom>.make()
    let mut alternatives = List<SourceAtom>.make()
    let mut each = usize.ZERO
    while each < cases.length {
      run List<SourceAtom>.append(&mut present, cases[each].source.quality.present)
      run List<SourceAtom>.append(&mut stored, cases[each].source.quality.stored)
      run List<SourceAtom>.append(&mut alternatives, cases[each].source.quality.alternatives)
      each = each + usize.ONE
    }
    positions[position].quality = SourceQuality {
      present: run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&present)),
      stored: run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&stored)),
      alternatives: run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&alternatives))}
    position = position + usize.ONE
  }
  let missing = run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&gaps))
  let incomplete: [SourceAtom; 2] = [observation.unknown, missing]
  observation.unknown = run SourcePolicy.disjunction(&mut builder.rules, &incomplete)
  return missing
}

// Attribute a physical value's held paths before its field projection finishes. The
// release proof sees one immutable observation and only whole holds already encountered.
// Keep excluded histories in their original positions for terminal-port correspondence;
// their selected Q is false, so they contribute neither effects nor result multiplicity.
effect fn sourceSelectFields(nodes: &[Node], owner: &DeclarationId, path: &Path, declared: &DeclaredRead,
  observation: &mut SourceObservation, state: &mut SourceLoanState, loans: &[Loan],
  paths: &mut List<List<Step>>, context: &RetentionContext, prior: &[SourceWholeHold],
  active: SourceAtom, rules: &mut SourceProgram) -> () ! OutOfMemoryError ? &mut Allocator {
  let snapshot = run sourceBarrier(&observation.*, &mut state.*, active, &mut rules.*)
  let mut release = List<SourceAtom>.make()
  let count = List<SourceCarryPosition>.length(&observation.positions)
  let mut at = usize.ZERO
  while at < count {
    let mut excluded = SourceProgram.atom(&mut rules.*)
    if !path.through && declared.known {
      excluded = run sourceUnreachableField(nodes, owner, loans, &observation.*,
        List<SourceQuality>.asSlice(&snapshot), at, List<RetentionEdge>.asSlice(&context.requirements),
        List<ImpliedGroup>.asSlice(&context.relations), context.settled, prior,
        List<Shared<Lifetime>>.asSlice(&declared.regions), &mut rules.*)
    }
    run List<SourceAtom>.append(&mut release, excluded)
    at = at + usize.ONE
  }
  let steps = List<Step>.asSlice(&path.steps)
  let positions = List<SourceCarryPosition>.asMutSlice(&mut observation.positions)
  let empty = List<SourceAtom>.make()
  let none = List<SourceAtom>.asSlice(&empty)
  at = usize.ZERO
  while at < positions.length {
    let cases = List<SourceCarryCase>.asMutSlice(&mut positions[at].cases)
    let mut each = usize.ZERO
    while each < cases.length {
      let field = cases[each].field
      if field != usize.MAX {
        if field >= List<List<Step>>.length(&paths.*) { return CompilerBug.panic(b"field projection lost its held path") }
        let held = List<Step>.asSlice(&List<List<Step>>.asSlice(&paths.*)[field])
        if readContains(steps, held) {
          let mut suffix = List<Step>.make()
          let mut step = steps.length
          while step < held.length { run List<Step>.append(&mut suffix, held[step]) step = step + usize.ONE }
          cases[each].field = List<List<Step>>.length(&paths.*)
          run List<List<Step>>.append(&mut paths.*, move suffix)
        } else {
          let disjoint = !path.through && disjointFields(steps, held)
          let ancestor = !path.through && declared.known && pathContains(held, steps)
          let mut excluded = SourceProgram.atom(&mut rules.*)
          if disjoint { run SourceProgram.fact(&mut rules.*, excluded) }
          else if ancestor { excluded = List<SourceAtom>.asSlice(&release)[at] }
          let forbidden: [SourceAtom; 1] = [excluded]
          let keep = run SourcePolicy.conjunction(&mut rules.*, none, &forbidden)
          cases[each].source = run sourceGatedCase(&cases[each].source, keep, &mut rules.*)
          cases[each].field = usize.MAX
        }
      }
      each = each + usize.ONE
    }
    let mut present = List<SourceAtom>.make()
    let mut stored = List<SourceAtom>.make()
    let mut alternatives = List<SourceAtom>.make()
    each = usize.ZERO
    while each < cases.length {
      run List<SourceAtom>.append(&mut present, cases[each].source.quality.present)
      run List<SourceAtom>.append(&mut stored, cases[each].source.quality.stored)
      run List<SourceAtom>.append(&mut alternatives, cases[each].source.quality.alternatives)
      each = each + usize.ONE
    }
    positions[at].quality = SourceQuality {
      present: run SourcePolicy.disjunction(&mut rules.*, List<SourceAtom>.asSlice(&present)),
      stored: run SourcePolicy.disjunction(&mut rules.*, List<SourceAtom>.asSlice(&stored)),
      alternatives: run SourcePolicy.disjunction(&mut rules.*, List<SourceAtom>.asSlice(&alternatives))}
    at = at + usize.ONE
  }
  return ()
}

effect fn sourceBarrier(observation: &SourceObservation, state: &mut SourceLoanState,
  active: SourceAtom, rules: &mut SourceProgram) -> List<SourceQuality> ! OutOfMemoryError ? &mut Allocator {
  let positions = List<SourceCarryPosition>.asSlice(&observation.positions)
  let mut inputs = List<SourcePolicy.LoanInput>.make()
  let empty = List<SourceAtom>.make()
  let mut at = usize.ZERO
  while at < positions.length {
    let arriving = positions[at].quality
    let gates: [SourceAtom; 2] = [active, arriving.present]
    let present = run SourcePolicy.conjunction(&mut rules.*, &gates, List<SourceAtom>.asSlice(&empty))
    run List<SourcePolicy.LoanInput>.append(&mut inputs,
      SourcePolicy.LoanInput {loan: positions[at].loan,
        quality: SourceQuality {present: present, stored: arriving.stored, alternatives: arriving.alternatives}})
    at = at + usize.ONE
  }
  return run SourceLoanState.barrier(&mut state.*, &mut rules.*, List<SourcePolicy.LoanInput>.asSlice(&inputs))
}

// The operation guard is the exact reserved execute/use/cleanup point. A never-returning
// operation can consume an input even though its result evaluation has no reachable output.
effect fn sourceConsume(observation: &SourceObservation, point: usize, active: SourceAtom,
  rules: &mut SourceProgram, intervals: &mut List<SourceIntervalEffect>) -> ()
! OutOfMemoryError ? &mut Allocator {
  let positions = List<SourceCarryPosition>.asSlice(&observation.positions)
  let empty = List<SourceAtom>.make()
  let mut at = usize.ZERO
  while at < positions.length {
    let cases = List<SourceCarryCase>.asSlice(&positions[at].cases)
    let mut each = usize.ZERO
    while each < cases.length {
      let guards: [SourceAtom; 2] = [active, cases[each].source.quality.present]
      let present = run SourcePolicy.conjunction(&mut rules.*, &guards, List<SourceAtom>.asSlice(&empty))
      run List<SourceIntervalEffect>.append(&mut intervals.*, SourceIntervalEffect {
        source: sourceEffectSource(&positions[at], &cases[each]), from: positions[at].since, to: point,
        cleanup: false, holder: false, active: present})
      each = each + usize.ONE
    }
    at = at + usize.ONE
  }
  return ()
}

// The structural arm-result transfer already restarts the value at the join. Ownership only
// records the old flight and actual nonlocal crossings; it adds neither a CFG edge nor a
// second copy of the joined sources. Noncompletion is the original absent arm-result edge.
effect fn sourceRejoin(observation: &SourceObservation, loans: &[Loan], completed: usize,
  active: SourceAtom, rules: &mut SourceProgram) -> SourceJoinEffects
! OutOfMemoryError ? &mut Allocator {
  let mut effects = SourceJoinEffects {intervals: List<SourceIntervalEffect>.make(), crossings: List<SourceCrossingEffect>.make()}
  if completed == usize.MAX { return move effects }
  run sourceConsume(observation, completed, active, &mut rules.*, &mut effects.intervals)
  let positions = List<SourceCarryPosition>.asSlice(&observation.positions)
  let empty = List<SourceAtom>.make()
  let none = List<SourceAtom>.asSlice(&empty)
  let mut at = usize.ZERO
  while at < positions.length {
    if !loans[positions[at].loan].local {
      let histories = List<SourceCarryCase>.asSlice(&positions[at].cases)
      let mut each = usize.ZERO
      while each < histories.length {
        let present: [SourceAtom; 2] = [active, histories[each].source.quality.present]
        run List<SourceCrossingEffect>.append(&mut effects.crossings, SourceCrossingEffect {
          source: sourceEffectSource(&positions[at], &histories[each]),
          active: run SourcePolicy.conjunction(&mut rules.*, &present, none)})
        each = each + usize.ONE
      }
    }
    at = at + usize.ONE
  }
  return move effects
}

// Classify each paired history before completing parent closure. The unchanged keptSink
// predicate preserves Same/Unknown slot behavior and never manufactures located evidence.
effect fn sourceRetainedSinks(observation: &SourceObservation, snapshot: &[SourceQuality], loans: &[Loan],
  paths: &[List<Step>], owner: &DeclarationId, sinks: &[OperandSink], only: usize,
  point: usize, active: SourceAtom, rules: &mut SourceProgram) -> SourceRetentionCases
! OutOfMemoryError ? &mut Allocator {
  let positions = List<SourceCarryPosition>.asSlice(&observation.positions)
  if snapshot.length != positions.length { CompilerBug.panic(b"retention lost its input observation version") }
  let empty = List<SourceAtom>.make()
  let none = List<SourceAtom>.asSlice(&empty)
  let yes = run sourceBoolean(&mut rules.*, true)
  let mut inputs = List<SourcePolicy.RetentionInput>.make()
  let mut carries = List<SourceSlotValue>.make()
  let mut sources = List<SourceEffectSource>.make()
  let mut at = usize.ZERO
  while at < positions.length {
    let position = &positions[at]
    let cases = List<SourceCarryCase>.asSlice(&position.cases)
    let mut each = usize.ZERO
    while each < cases.length {
      let carry = sourceSlotValue(position, &cases[each])
      let mut operand = only
      if operand == usize.MAX { operand = position.operand }
      let mut located = false
      let mut initial = CallSink.Local
      if operand < sinks.length { initial = keptSink(paths, &loans[position.loan], owner, carry, &sinks[operand], &mut located) }
      let sink = match initial {
        CallSink.Local => SourceSink.Local
        CallSink.Universal => SourceSink.Universal
        CallSink.Unknown => SourceSink.Unknown
      }
      let guards: [SourceAtom; 2] = [active, cases[each].source.quality.present]
      let present = run SourcePolicy.conjunction(&mut rules.*, &guards, none)
      let quality = SourceQuality {present: present, stored: snapshot[at].stored, alternatives: snapshot[at].alternatives}
      run List<SourcePolicy.RetentionInput>.append(&mut inputs, SourcePolicy.RetentionInput {
        quality: quality, initial: sink, local: loans[position.loan].local, located: located,
        knownField: carry.field != usize.MAX, actualPoint: point != usize.MAX})
      run List<SourceSlotValue>.append(&mut carries, carry)
      run List<SourceEffectSource>.append(&mut sources, sourceEffectSource(position, &cases[each]))
      each = each + usize.ONE
    }
    at = at + usize.ONE
  }
  let actual = List<SourceSlotValue>.asSlice(&carries)
  let mut parents = List<SourceParentEdge>.make()
  at = usize.ZERO
  while at < actual.length {
    if let Option<Shared<Lifetime>>.Some {value: parent} = &loans[actual[at].loan].parent {
      let mut candidate = usize.ZERO
      while candidate < actual.length {
        if only != usize.MAX || actual[at].operand == actual[candidate].operand {
          if let Option<Shared<Lifetime>>.Some {value: borrowed} = &loans[actual[candidate].loan].borrowed {
            if meetMember(&parent, &borrowed) {
              run List<SourceParentEdge>.append(&mut parents,
                SourceParentEdge {child: at, parent: candidate, applicable: yes})
            }
          }
        }
        candidate = candidate + usize.ONE
      }
    }
    at = at + usize.ONE
  }
  let decisions = run SourcePolicy.retention(&mut rules.*, List<SourcePolicy.RetentionInput>.asSlice(&inputs),
    List<SourceParentEdge>.asSlice(&parents))
  return SourceRetentionCases {sources: move sources, decisions: move decisions}
}

effect fn sourceKeepCarried(observation: &SourceObservation, snapshot: &[SourceQuality], loans: &[Loan],
  paths: &[List<Step>], owner: &DeclarationId, sinks: &[OperandSink], only: usize,
  point: usize, active: SourceAtom, rules: &mut SourceProgram) -> List<SourceRetentionEffect>
! OutOfMemoryError ? &mut Allocator {
  let classified = run sourceRetainedSinks(observation, snapshot, loans, paths, owner, sinks, only, point, active, &mut rules.*)
  let decisions = List<SourcePolicy.RetentionOutput>.asSlice(&classified.decisions)
  let mut effects = List<SourceRetentionEffect>.make()
  let mut at = usize.ZERO
  while at < decisions.length {
    run List<SourceRetentionEffect>.append(&mut effects, SourceRetentionEffect {
      source: List<SourceEffectSource>.asSlice(&classified.sources)[at], point: point, caller: decisions[at].caller,
      independent: decisions[at].independentEscape, storing: decisions[at].storing})
    at = at + usize.ONE
  }
  return move effects
}

enum SourceSlotCoverage { Complete, Empty, Missing }

fn sourceSlotCoverage(slot: &PreparedSources.SlotSelection) -> SourceSlotCoverage {
  return match &slot.coverage {
    PreparedSourcesSlotCoverage.Exact => SourceSlotCoverage.Complete
    PreparedSourcesSlotCoverage.EmptyArray {..} => SourceSlotCoverage.Empty
    _ => SourceSlotCoverage.Missing
  }
}

// Original and physical paths are frozen separately. A complete opaque original can have
// a concrete physical inline frontier; an unfinished prefix in either coordinate stays a gap.
fn sourceKeptCoverage(retention: &PreparedSources.Retention, coordinate: SourceKeptSlot) -> SourceSlotCoverage {
  let operands = List<PreparedSources.RetentionOperand>.asSlice(&retention.operands)
  let mut found = false
  let mut result = SourceSlotCoverage.Missing
  let mut at = usize.ZERO
  while at < operands.length {
    if operands[at].operand == coordinate.operand {
      let slots = List<PreparedSources.RetentionSlot>.asSlice(&operands[at].slots)
      let mut each = usize.ZERO
      while each < slots.length {
        if slots[each].slot == coordinate.slot {
          if found { return CompilerBug.panic(b"retained slot has duplicate original coordinates") }
          found = true
          let original = sourceSlotCoverage(&slots[each].original)
          let physical = sourceSlotCoverage(&slots[each].physical)
          if original == SourceSlotCoverage.Empty || physical == SourceSlotCoverage.Empty { result = SourceSlotCoverage.Empty }
          else if original == SourceSlotCoverage.Complete && physical == SourceSlotCoverage.Complete { result = SourceSlotCoverage.Complete }
        }
        each = each + usize.ONE
      }
    }
    at = at + usize.ONE
  }
  return result
}

// The selected source and destination slots are the actual recorded KeptSlots, not inferred
// contract/result routes. This is semantic pair eligibility only: the caller must separately
// bind the reserved canonical write, original source history and selected address authority.
// Incomplete structural/read evidence stays visible even when an eligibility test says drop.
effect fn sourceKeptSlotFacts(retention: &PreparedSources.Retention, sourceSlot: SourceKeptSlot,
  targetSlot: SourceKeptSlot, position: &SourceCarryPosition, history: &SourceCarryCase,
  destination: &SourceCarryPosition, targetHistory: &SourceCarryCase, loans: &[Loan], paths: &[List<Step>],
  owner: &DeclarationId, edges: &[RetentionEdge], named: &[Shared<Lifetime>]) -> SourceStoreFacts
! OutOfMemoryError ? &mut Allocator {
  if position.loan >= loans.length || destination.loan >= loans.length || position.operand != sourceSlot.operand
    || destination.operand != targetSlot.operand { return CompilerBug.panic(b"kept-slot decision lost its actual operand or loan") }
  let complete = Shared<SourceRetention>.with<bool>(&retention.source, fn(source: &SourceRetention) -> bool {
    return match source.coverage { SourceRetentionCoverage.Complete => true _ => false }
  })
  let original = sourceKeptCoverage(retention, sourceSlot)
  let target = sourceKeptCoverage(retention, targetSlot)
  let carry = sourceSlotValue(position, history)
  let lent = sourceSlotValue(destination, targetHistory)
  let origins = run keptOrigins(&loans[position.loan], owner, edges)
  let permitted = Shared<List<KeptRegions>>.with<bool>(&retention.recorded, fn(values: &List<KeptRegions>) -> bool {
    let entries = List<KeptRegions>.asSlice(values)
    if sourceSlot.operand >= entries.length || targetSlot.operand >= entries.length {
      return CompilerBug.panic(b"selected retained operand is absent from its original record")
    }
    let sources = List<KeptSlot>.asSlice(&entries[sourceSlot.operand].slots)
    let destinations = List<KeptSlot>.asSlice(&entries[targetSlot.operand].slots)
    if sourceSlot.slot >= sources.length || targetSlot.slot >= destinations.length {
      return CompilerBug.panic(b"selected retained slot is absent from its original record")
    }
    return keptSlotIn(&sources[sourceSlot.slot], &loans[position.loan], carry, paths, owner,
      List<Shared<Lifetime>>.asSlice(&origins.regions), List<usize>.asSlice(&origins.reached), named)
      && destinationSlotKeeps(&sources[sourceSlot.slot], &destinations[targetSlot.slot], paths, lent, named)
  })
  return SourceStoreFacts {permitted: permitted,
    empty: original == SourceSlotCoverage.Empty || target == SourceSlotCoverage.Empty,
    complete: complete && original != SourceSlotCoverage.Missing && target != SourceSlotCoverage.Missing}
}

effect fn sourceKeptSlotDecision(facts: SourceStoreFacts, history: &SourceCarryCase,
  targetHistory: &SourceCarryCase, active: SourceAtom, exclusion: SourceReadExclusion,
  rules: &mut SourceProgram) -> SourceStoreDecision ! OutOfMemoryError ? &mut Allocator {
  let empty = List<SourceAtom>.make()
  let none = List<SourceAtom>.asSlice(&empty)
  let actual: [SourceAtom; 3] = [active, history.source.quality.present, targetHistory.source.quality.present]
  let present = run SourcePolicy.conjunction(&mut rules.*, &actual, none)
  let no = SourceProgram.atom(&mut rules.*)
  let mut eligible = no
  if facts.permitted && !facts.empty {
    let positive: [SourceAtom; 1] = [present]
    let excluded: [SourceAtom; 1] = [exclusion.excluded]
    eligible = run SourcePolicy.conjunction(&mut rules.*, &positive, &excluded)
  }
  let mut missing = no
  if !facts.complete { missing = present }
  let unknownRead: [SourceAtom; 2] = [present, exclusion.missing]
  let gaps: [SourceAtom; 2] = [missing, run SourcePolicy.conjunction(&mut rules.*, &unknownRead, none)]
  return SourceStoreDecision {eligible: eligible, missing: run SourcePolicy.disjunction(&mut rules.*, &gaps)}
}

struct SourceStoreEffects {
  intervals: List<SourceIntervalEffect>
  refusal: SourceAtom
  missing: SourceAtom
}

fn sourceSameAddressRequest(left: SourceGraphAddressRequest, right: SourceGraphAddressRequest) -> bool {
  return match left {
    SourceGraphAddressRequest.Selection {selection} => match right {
      SourceGraphAddressRequest.Selection {selection: other} => selection == other _ => false }
    SourceGraphAddressRequest.Retained {request} => match right {
      SourceGraphAddressRequest.Retained {request: other} => request == other _ => false }
    SourceGraphAddressRequest.Invocation {request} => match right {
      SourceGraphAddressRequest.Invocation {request: other} => request == other _ => false }
  }
}

// Coverage is an exhaustive Case obligation for this exact request. Positive aliases are
// deliberately absent from this lookup; an unrelated successful address cannot cover it.
effect fn sourceAddressMissing<'body>(builder: &mut SourceGraphBuilder<'body>, request: SourceGraphAddressRequest,
  active: SourceAtom) -> SourceAtom ! OutOfMemoryError ? &mut Allocator {
  let coverage = SourceGraphBuilder.addressCoverage(&builder.*)
  let mut selected = Option<SourceAtom>.none()
  let mut at = usize.ZERO
  while at < coverage.length {
    if sourceSameAddressRequest(coverage[at].request, request) {
      if let Option<SourceAtom>.Some {..} = selected { return CompilerBug.panic(b"address obligation has duplicate coverage rows") }
      selected = Option<SourceAtom>.some(coverage[at].missing)
    }
    at = at + usize.ONE
  }
  let missing = match selected { Option<SourceAtom>.Some {value} => value _ => { return active } }
  let empty = List<SourceAtom>.make()
  let gates: [SourceAtom; 2] = [active, missing]
  return run SourcePolicy.conjunction(&mut builder.rules, &gates, List<SourceAtom>.asSlice(&empty))
}

struct SourceSelectionCoverage {
  matched: bool
  complete: SourceAtom
  missing: SourceAtom
}

// Select only the actual final place/value family at this occurrence. Each matching
// partition keeps its own missing obligation; another partition's aliases cannot hide it.
effect fn sourceSelectionCoverage<'body>(builder: &mut SourceGraphBuilder<'body>, evaluation: SourceGraph.EvalId,
  root: PreparedSources.EndpointId, place: bool, active: SourceAtom) -> SourceSelectionCoverage
! OutOfMemoryError ? &mut Allocator {
  let empty = List<SourceAtom>.make()
  let none = List<SourceAtom>.asSlice(&empty)
  let mut matching = false
  let mut covered = List<SourceAtom>.make()
  let mut gaps = List<SourceAtom>.make()
  let mut at = usize.ZERO
  while at < SourceGraphBuilder.selectionUses(&builder.*).length {
    let use = &SourceGraphBuilder.selectionUses(&builder.*)[at]
    let mut endpoint = Option<PreparedSources.MapId>.none()
    if place { endpoint = use.place } else { endpoint = use.value }
    let selected = match endpoint {
      Option<PreparedSources.MapId>.Some {value} =>
        List<PreparedSources.SelectionMap>.asSlice(&SourceGraphBuilder.preparation(&builder.*).maps)[value.index].target.index == root.index
      _ => false
    }
    if use.result.index == evaluation.index && selected {
      matching = true
      let gates: [SourceAtom; 2] = [active, use.active]
      let applies = run SourcePolicy.conjunction(&mut builder.rules, &gates, none)
      let mut found = false
      let mut row = usize.ZERO
      while row < SourceGraphBuilder.addressCoverage(&builder.*).length {
        let coverage = SourceGraphBuilder.addressCoverage(&builder.*)[row]
        if sourceSameAddressRequest(coverage.request, SourceGraphAddressRequest.Selection {selection: at}) {
          if found { return CompilerBug.panic(b"selected holder has duplicate coverage rows") }
          found = true
          let positive: [SourceAtom; 2] = [applies, coverage.active]
          let negative: [SourceAtom; 1] = [coverage.missing]
          run List<SourceAtom>.append(&mut covered, run SourcePolicy.conjunction(&mut builder.rules, &positive, &negative))
          let incomplete: [SourceAtom; 2] = [applies, coverage.missing]
          run List<SourceAtom>.append(&mut gaps, run SourcePolicy.conjunction(&mut builder.rules, &incomplete, none))
          let required: [SourceAtom; 1] = [applies]
          let present: [SourceAtom; 1] = [coverage.active]
          run List<SourceAtom>.append(&mut gaps, run SourcePolicy.conjunction(&mut builder.rules, &required, &present))
        }
        row = row + usize.ONE
      }
      if !found { run List<SourceAtom>.append(&mut gaps, applies) }
    }
    at = at + usize.ONE
  }
  let missing = run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&gaps))
  let present = run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&covered))
  let positive: [SourceAtom; 1] = [present]
  let negative: [SourceAtom; 1] = [missing]
  return SourceSelectionCoverage {matched: matching,
    complete: run SourcePolicy.conjunction(&mut builder.rules, &positive, &negative), missing: missing}
}

// A descriptor case is supplied by a discriminated graph address proof. It carries no
// retained-slot or invocation authority of its own; those remain with the owning handler.
struct SourceDescriptorCase {
  category: SourceGraphSourceRole
  descriptor: SourceGraph.ValueId
  leaf: SourceGraph.LeafId
  definition: Option<SourceControl.DefinitionId>
  read: Option<SourceControl.ReadId>
  direct: bool
  active: SourceAtom
}

// Observe exactly the proof's descriptor Value/leaf and paired history. This does not
// derive an address from result provenance, a summary transport, or a loan's region.
effect fn sourceAddressDescriptor<'body>(builder: &mut SourceGraphBuilder<'body>,
  address: SourceDescriptorCase, operand: SourceOperand, paths: &mut List<List<Step>>,
  loans: usize) -> SourceObservation ! OutOfMemoryError ? &mut Allocator {
  if address.category != SourceGraphSourceRole.Physical {
    return CompilerBug.panic(b"ownership publication cannot authenticate a physical descriptor")
  }
  let unknown = SourceProgram.atom(&mut builder.rules)
  let mut result = SourceObservation {positions: List<SourceCarryPosition>.make(), other: List<SourceGraph.Input>.make(), unknown: unknown}
  let actualValue = SourceGraphBuilder.value(&builder.*, address.descriptor)
  let evaluation = SourceGraphBuilder.evaluation(&builder.*, actualValue.evaluation)
  let mut inputs = run SourceGraphBuilder.inputs(&mut builder.*, address.descriptor)
  let mut covered = List<SourceAtom>.make()
  while List<SourceGraph.Input>.length(&inputs) > usize.ZERO {
    let input = List<SourceGraph.Input>.remove(&mut inputs, usize.ZERO)
    if input.leaf.index == address.leaf.index {
      let loan = match &SourceGraphBuilder.leaf(&builder.*, input.leaf).kind {
        SourceGraphSourceLeaf.Borrow {loan, ..} => loan
        _ => usize.MAX
      }
      if loan == usize.MAX {
        run List<SourceGraph.Input>.append(&mut result.other, move input)
      } else {
        if loan >= loans { return CompilerBug.panic(b"retained descriptor lost its actual loan") }
        let mut cases = List<SourceCarryCase>.make()
        let mut histories = move input.cases
        while List<SourceGraph.InputCase>.length(&histories) > usize.ZERO {
          let history = List<SourceGraph.InputCase>.remove(&mut histories, usize.ZERO)
          if history.category == address.category && history.direct == address.direct && sourceDefinitionMatches(history.definition, address.definition)
            && sourceReadMatches(history.read, address.read) {
            let endpoints = List<PreparedSources.Endpoint>.asSlice(&SourceGraphBuilder.preparation(&builder.*).endpoints)
            let mut current = history.placement
            let mut remaining = endpoints.length
            while current.index != operand.root.index && remaining > usize.ZERO {
              match endpoints[current.index].parent {
                Option<PreparedSources.EndpointId>.Some {value} => { current = value }
                _ => { break }
              }
              remaining = remaining - usize.ONE
            }
            let mut field = usize.MAX
            if current.index == operand.root.index {
              field = run sourceField(endpoints, operand.root, history.placement, &mut paths.*)
              run List<SourceAtom>.append(&mut covered, history.quality.present)
            }
            run List<SourceCarryCase>.append(&mut cases, sourceCase(move history, field))
          }
        }
        run List<SourceCarryPosition>.append(&mut result.positions, SourceCarryPosition {
          node: operand.node, root: operand.root, value: address.descriptor, leaf: input.leaf,
          loan: loan, operand: operand.ordinal, since: evaluation.point.index,
          quality: sourceQuality(input.quality), cases: move cases})
      }
    }
  }
  let actual: [SourceAtom; 1] = [address.active]
  run SourceProgram.rule(&mut builder.rules, unknown, &actual, List<SourceAtom>.asSlice(&covered))
  return move result
}

// A store handler's address table is frozen before policy binding. Several write ports
// can name the same exact address row; its raw descriptor observation is independent of
// those decisions. Retain it once, on first use, without merging distinct address gates.
struct SourceAddressObservations {
  indices: List<Option<usize>>
  observations: List<SourceObservation>
}

effect fn sourceAddressObservations(count: usize) -> SourceAddressObservations
! OutOfMemoryError ? &mut Allocator {
  let mut indices = List<Option<usize>>.make()
  let mut at = usize.ZERO
  while at < count {
    run List<Option<usize>>.append(&mut indices, Option<usize>.none())
    at = at + usize.ONE
  }
  return SourceAddressObservations {indices: move indices, observations: List<SourceObservation>.make()}
}

effect fn sourceStoredDescriptor<'body>(builder: &mut SourceGraphBuilder<'body>,
  retained: &mut SourceAddressObservations, ordinal: usize, address: SourceDescriptorCase,
  operand: SourceOperand, paths: &mut List<List<Step>>, loans: usize) -> usize
! OutOfMemoryError ? &mut Allocator {
  let indices = List<Option<usize>>.asSlice(&retained.indices)
  if ordinal >= indices.length { return CompilerBug.panic(b"store descriptor lost its original address row") }
  if let Option<usize>.Some {value} = indices[ordinal] { return value }
  let observation = run sourceAddressDescriptor(&mut builder.*, move address, operand, &mut paths.*, loans)
  let index = List<SourceObservation>.length(&retained.observations)
  run List<SourceObservation>.append(&mut retained.observations, move observation)
  let mutable = List<Option<usize>>.asMutSlice(&mut retained.indices)
  mutable[ordinal] = Option<usize>.some(index)
  return index
}

// Reference-holder refusal observes only the reserved current read. It cannot use the
// postwrite Output (which would make the candidate itself prove that the holder has loans).
effect fn sourceReferenceHeld<'body>(builder: &mut SourceGraphBuilder<'body>, id: usize)
  -> SourceCallerEvidence ! OutOfMemoryError ? &mut Allocator {
  let mut reads = List<SourceControl.ReadId>.make()
  let components = List<SourceGraph.WriteComponent>.asSlice(&SourceGraphBuilder.writeHolder(&builder.*, id).components)
  let mut at = usize.ZERO
  while at < components.length {
    run List<SourceControl.ReadId>.append(&mut reads, components[at].read)
    at = at + usize.ONE
  }
  let mut held = List<SourceAtom>.make()
  let mut gaps = List<SourceAtom>.make()
  at = usize.ZERO
  while at < List<SourceControl.ReadId>.length(&reads) {
    let read = SourceGraphBuilder.read(&builder.*, List<SourceControl.ReadId>.asSlice(&reads)[at])
    let value = SourceGraphBuilder.value(&builder.*, read.value)
    if value.phase != SourceGraphValuePhase.Input { return CompilerBug.panic(b"reference holder refusal observed its new write") }
    let inputs = run SourceGraphBuilder.observationInputs(&mut builder.*, read.value)
    let sources = List<SourceGraph.Input>.asSlice(&inputs)
    let mut covered = List<SourceAtom>.make()
    let mut each = usize.ZERO
    while each < sources.length {
      run List<SourceAtom>.append(&mut covered, sources[each].quality.present)
      let histories = List<SourceGraph.InputCase>.asSlice(&sources[each].cases)
      let mut history = usize.ZERO
      while history < histories.length {
        run List<SourceAtom>.append(&mut covered, SourceGraphBuilder.observationCase(&builder.*, histories[history].case).masked)
        history = history + usize.ONE
      }
      match &SourceGraphBuilder.leaf(&builder.*, sources[each].leaf).kind {
        SourceGraphSourceLeaf.Borrow {..} => run List<SourceAtom>.append(&mut held, sources[each].quality.present)
        SourceGraphSourceLeaf.Unknown {..} => run List<SourceAtom>.append(&mut gaps, sources[each].quality.present)
        _ => ()
      }
      each = each + usize.ONE
    }
    let reached: [SourceAtom; 1] = [List<SourceControl.Point>.asSlice(&builder.reaching.points)[read.point.index].reachable]
    let missing = SourceProgram.atom(&mut builder.rules)
    run SourceProgram.rule(&mut builder.rules, missing, &reached, List<SourceAtom>.asSlice(&covered))
    run List<SourceAtom>.append(&mut gaps, missing)
    at = at + usize.ONE
  }
  return SourceCallerEvidence {present: run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&held)),
    missing: run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&gaps))}
}

// Whole-holder use observes every OLD physical component under holder.active. Summary
// histories are observed once through the root read, not again for each child snapshot.
effect fn sourceObserveWriteHolder<'body>(builder: &mut SourceGraphBuilder<'body>, id: usize,
  paths: &mut List<List<Step>>, loans: usize) -> SourceObservation ! OutOfMemoryError ? &mut Allocator {
  let holder = SourceGraphBuilder.writeHolder(&builder.*, id)
  let storage = holder.storage
  let execution = holder.execution
  let evaluation = SourceGraphBuilder.evaluation(&builder.*, execution)
  let node = match evaluation.site { SourceGraphEvaluationSite.Node {node} => node
    _ => { return CompilerBug.panic(b"whole-holder observation has no executing operation") } }
  let mut reads = List<SourceControl.ReadId>.make()
  let components = List<SourceGraph.WriteComponent>.asSlice(&holder.components)
  let mut at = usize.ZERO
  while at < components.length { run List<SourceControl.ReadId>.append(&mut reads, components[at].read) at = at + usize.ONE }
  let unknown = SourceProgram.atom(&mut builder.rules)
  let mut observation = SourceObservation {positions: List<SourceCarryPosition>.make(), other: List<SourceGraph.Input>.make(), unknown: unknown}
  let mut roots = usize.ZERO
  at = usize.ZERO
  while at < List<SourceControl.ReadId>.length(&reads) {
    let read = SourceGraphBuilder.read(&builder.*, List<SourceControl.ReadId>.asSlice(&reads)[at])
    let value = SourceGraphBuilder.value(&builder.*, read.value)
    if value.phase != SourceGraphValuePhase.Input || value.evaluation.index != execution.index
      || read.point.index != evaluation.point.index || !sourcePhysicalValue(value) {
      return CompilerBug.panic(b"whole-holder snapshot substituted a received write or another observation")
    }
    let whole = sourceSameStorage(storage, read.storage)
    if whole { roots = roots + usize.ONE }
    let operand = SourceOperand {node: node, evaluation: execution, root: storage.endpoint, ordinal: usize.MAX}
    let mut present = List<SourceAtom>.make()
    run sourceObserveValue(&mut builder.*, &mut observation, operand, read.value, &mut paths.*, loans, &mut present, whole,
      Option<SourceControl.ReadId>.none())
    let reached: [SourceAtom; 1] = [List<SourceControl.Point>.asSlice(&builder.reaching.points)[read.point.index].reachable]
    run SourceProgram.rule(&mut builder.rules, unknown, &reached, List<SourceAtom>.asSlice(&present))
    at = at + usize.ONE
  }
  if roots != usize.ONE { return CompilerBug.panic(b"whole-holder summary observation lost its single actual root read") }
  return move observation
}

effect fn sourceReferenceCaseField<'body>(builder: &SourceGraphBuilder<'body>, candidate: SourceGraph.ReferenceHolding,
  history: &SourceGraph.InputCase, paths: &mut List<List<Step>>) -> SourceReadField ! OutOfMemoryError ? &mut Allocator {
  let original = SourceGraphBuilder.referenceReads(builder)[candidate.referenceRead]
  if original.observation != candidate.observation || original.value.index != candidate.source.index
    || !sourceAcquisitionHistory(SourceGraphBuilder.summaryReads(builder), original.read, history) {
    return CompilerBug.panic(b"reference holding changed its acquisition read history")
  }
  let definition = match history.definition { Option<SourceControl.DefinitionId>.Some {value} => value
    _ => { return SourceReadField {supported: false, field: usize.MAX} } }
  let read = match history.read { Option<SourceControl.ReadId>.Some {value} => value
    _ => { return SourceReadField {supported: false, field: usize.MAX} } }
  let written = SourceGraphBuilder.definition(builder, definition)
  let reading = SourceGraphBuilder.read(builder, read)
  if !sourceSameReadLane(written, reading) { return SourceReadField {supported: false, field: usize.MAX} }
  if let Option<SourceAtom>.None = sourceFlowPair(&builder.reaching, definition, read) {
    return SourceReadField {supported: false, field: usize.MAX}
  }
  let held = match written.summary {
    Option<usize>.Some {value} => SourceGraphBuilder.summaries(builder)[value].placement
    _ => SourceGraphOwnershipPlacement.Known {anchor: written.storage.endpoint, suffix: Option<SourceGraph.OwnershipSuffix>.none()}
  }
  return run sourceReferenceField(builder, candidate, written.storage, held, &mut paths.*)
}

// Every incoming acquisition Case owes its own disposition, even when no frozen known
// suffix candidate exists. Observer completeness and a positive fresh descriptor cannot
// discharge this obligation. Unknown is selected only for the original semantic MAX.
effect fn sourceReferenceBindings<'body>(builder: &mut SourceGraphBuilder<'body>, acquisition: SourceGraph.EvalId,
  paths: &mut List<List<Step>>) -> SourceAtom ! OutOfMemoryError ? &mut Allocator {
  let no = SourceProgram.atom(&mut builder.rules)
  let empty = List<SourceAtom>.make()
  let none = List<SourceAtom>.asSlice(&empty)
  let mut portIndex = usize.ZERO
  while portIndex < SourceGraphBuilder.policyCount(&builder.*) {
    let port = SourceGraphBuilder.policy(&builder.*, portIndex)
    if let SourceGraphTransferAuthority.ReferenceHolding {candidate: ordinal} = port.authority {
      let candidate = SourceGraphBuilder.referenceHoldings(&builder.*)[ordinal]
      if SourceGraphBuilder.value(&builder.*, candidate.target).evaluation.index == acquisition.index {
        if port.terminal || port.outputRole != SourceGraphSourceRole.Ownership
          || port.source.index != candidate.source.index || port.target.index != candidate.target.index {
          return CompilerBug.panic(b"reference holding changed its ownership publication authority")
        }
        let mut admitted = List<SourceAtom>.make()
        let incoming = run SourceGraphBuilder.policyCases(&builder.*, port.id)
        let cases = List<SourceGraph.InputCase>.asSlice(&incoming)
        let mut each = usize.ZERO
        while each < cases.length {
          let history = &cases[each]
          if history.category != port.category || history.direct != port.direct
            || !sourceDefinitionMatches(history.definition, port.definition) || !sourceReadMatches(history.read, port.read) {
            return CompilerBug.panic(b"reference policy substituted another raw source history")
          }
          let mut covered = false
          let mut keep = false
          match &SourceGraphBuilder.leaf(&builder.*, port.leaf).kind {
            SourceGraphSourceLeaf.Borrow {..} => {
              let expected = run sourceReferenceCaseField(&builder.*, candidate, history, &mut paths.*)
              let root = SourceGraphBuilder.value(&builder.*, candidate.target).endpoint
              let placed = run sourceOwnershipField(&builder.*, root, candidate.placement, &mut paths.*)
              keep = expected.supported && placed.supported
                && sourceSameField(List<List<Step>>.asSlice(&paths.*), expected.field, placed.field)
              covered = keep
            }
            SourceGraphSourceLeaf.Unknown {..} => ()
            SourceGraphSourceLeaf.Entry {..} => { covered = true }
            SourceGraphSourceLeaf.Expression {..} => { covered = true }
            SourceGraphSourceLeaf.LoanFree {..} => { covered = true }
          }
          let gates: [SourceAtom; 4] = [candidate.active, port.active, port.quality.present,
            SourceGraphBuilder.observationCase(&builder.*, history.case).semantic.present]
          let active = run SourcePolicy.conjunction(&mut builder.rules, &gates, none)
          if keep { run List<SourceAtom>.append(&mut admitted, active) }
          let mut found = false
          let mut row = usize.ZERO
          while row < SourceGraphBuilder.referenceHoldingCoverage(&builder.*).length {
            let obligation = SourceGraphBuilder.referenceHoldingCoverage(&builder.*)[row]
            if obligation.referenceRead == candidate.referenceRead && obligation.case == history.case {
              if obligation.reference != candidate.reference || obligation.observation != candidate.observation
                || obligation.source.index != port.source.index || obligation.leaf.index != port.leaf.index
                || obligation.category != history.category || obligation.direct != history.direct
                || !sourceDefinitionMatches(obligation.definition, history.definition)
                || !sourceReadMatches(obligation.read, history.read) {
                return CompilerBug.panic(b"reference coverage changed its exact predecessor Case")
              }
              found = true
              if covered {
                let handled: [SourceAtom; 2] = [obligation.active, active]
                run SourceProgram.rule(&mut builder.rules, obligation.covered, &handled, none)
              }
            }
            row = row + usize.ONE
          }
          if !found { return CompilerBug.panic(b"reference holding omitted an incoming Case obligation") }
          each = each + usize.ONE
        }
        let kept = run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&admitted))
        run SourceGraphBuilder.bindPolicy(&mut builder.*, port.id, kept, no, no)
      }
    }
    portIndex = portIndex + usize.ONE
  }
  let mut gaps = List<SourceAtom>.make()
  let mut row = usize.ZERO
  while row < SourceGraphBuilder.referenceHoldingCoverage(&builder.*).length {
    let obligation = SourceGraphBuilder.referenceHoldingCoverage(&builder.*)[row]
    let reference = SourceGraphBuilder.reference(&builder.*, obligation.reference)
    if SourceGraphBuilder.value(&builder.*, reference.descriptor).evaluation.index == acquisition.index {
      let masked: [SourceAtom; 2] = [obligation.active, SourceGraphBuilder.observationCase(&builder.*, obligation.case).masked]
      run SourceProgram.rule(&mut builder.rules, obligation.covered, &masked, none)
      run List<SourceAtom>.append(&mut gaps, obligation.missing)
    }
    row = row + usize.ONE
  }
  run List<SourceAtom>.append(&mut gaps, no)
  return run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&gaps))
}

// Move/Field observations justify a finite mirror recipe for an original physical writer.
// They never activate that earlier writer or replace its own exact incoming Case.
fn sourceSameMirrorOrigin(left: SourceGraphOwnershipMirrorOrigin, right: SourceGraphOwnershipMirrorOrigin) -> bool {
  return match left {
    SourceGraphOwnershipMirrorOrigin.Move {moveRead} => match right {
      SourceGraphOwnershipMirrorOrigin.Move {moveRead: other} => moveRead == other _ => false }
    SourceGraphOwnershipMirrorOrigin.Field {fieldRead, case} => match right {
      SourceGraphOwnershipMirrorOrigin.Field {fieldRead: other, case: original} => fieldRead == other && case == original _ => false }
  }
}

fn sourceMirrorOwner<'body>(builder: &SourceGraphBuilder<'body>, origin: SourceGraphOwnershipMirrorOrigin) -> SourceGraph.Storage {
  return match origin {
    SourceGraphOwnershipMirrorOrigin.Move {moveRead} => {
      let reading = SourceGraphBuilder.moveReads(builder)[moveRead]
      return SourceGraphBuilder.moveObservations(builder)[reading.observation].owner
    }
    SourceGraphOwnershipMirrorOrigin.Field {fieldRead, ..} => {
      let reading = SourceGraphBuilder.fieldReholdReads(builder)[fieldRead]
      return SourceGraphBuilder.fieldReholdObservations(builder)[reading.observation].owner
    }
  }
}

effect fn sourceOwnershipMirrors<'body>(builder: &mut SourceGraphBuilder<'body>, paths: &mut List<List<Step>>) -> ()
! OutOfMemoryError ? &mut Allocator {
  let no = SourceProgram.atom(&mut builder.rules)
  let empty = List<SourceAtom>.make()
  let none = List<SourceAtom>.asSlice(&empty)
  let mut at = usize.ZERO
  while at < SourceGraphBuilder.policyCount(&builder.*) {
    let port = SourceGraphBuilder.policy(&builder.*, at)
    if let SourceGraphTransferAuthority.OwnershipMirror {candidate: ordinal, ..} = port.authority {
      let candidate = SourceGraphBuilder.ownershipMirrors(&builder.*)[ordinal]
      let original = SourceGraphBuilder.definition(&builder.*, candidate.original)
      let installed = SourceGraphBuilder.definition(&builder.*, candidate.definition)
      let owner = sourceMirrorOwner(&builder.*, candidate.origin)
      let acquisition = SourceGraphBuilder.read(&builder.*, candidate.read)
      let summary = SourceGraphBuilder.summaries(&builder.*)[candidate.summary]
      if port.terminal || port.category != SourceGraphSourceRole.Physical || port.outputRole != SourceGraphSourceRole.Ownership
        || port.source.index != candidate.source.index || port.target.index != candidate.target.index
        || original.value.index != candidate.source.index || installed.value.index != candidate.target.index
        || original.point.index != installed.point.index
        || SourceGraphBuilder.evaluation(&builder.*, candidate.writer).point.index != original.point.index
        || !sourceSameStorage(original.storage, candidate.storage) || !sourceSameReadLane(original, acquisition)
        || !sourceSameSummary(installed.summary, Option<usize>.some(candidate.summary))
        || !SourceGraph.sameOwnershipPlacement(summary.placement, candidate.placement)
        || summary.disposition != SourceGraphSummaryDisposition.Ordinary {
        return CompilerBug.panic(b"ownership mirror changed its original writer or acquisition proof")
      }
      if let Option<usize>.Some {..} = original.summary {
        return CompilerBug.panic(b"ownership mirror substituted an ownership definition for physical storage")
      }
      if let Option<SourceAtom>.None = sourceFlowPair(&builder.reaching, candidate.original, candidate.read) {
        return CompilerBug.panic(b"ownership mirror lost its actual acquisition pair")
      }
      let expected = run sourceOwnershipField(&builder.*, owner.endpoint,
        SourceGraphOwnershipPlacement.Known {anchor: candidate.storage.endpoint, suffix: Option<SourceGraph.OwnershipSuffix>.none()}, &mut paths.*)
      let placed = run sourceOwnershipField(&builder.*, owner.endpoint, candidate.placement, &mut paths.*)
      let matched = expected.supported && placed.supported
        && sourceSameField(List<List<Step>>.asSlice(&paths.*), expected.field, placed.field)
      let incoming = run SourceGraphBuilder.policyCases(&builder.*, port.id)
      let cases = List<SourceGraph.InputCase>.asSlice(&incoming)
      let mut admitted = List<SourceAtom>.make()
      let mut each = usize.ZERO
      while each < cases.length {
        let history = &cases[each]
        if history.case != candidate.sourceCase { each = each + usize.ONE continue }
        if history.category != port.category || history.direct != port.direct
          || !sourceDefinitionMatches(history.definition, port.definition) || !sourceReadMatches(history.read, port.read) {
          return CompilerBug.panic(b"ownership mirror substituted acquisition history for its writer Case")
        }
        let mut keep = false
        let mut covered = false
        match &SourceGraphBuilder.leaf(&builder.*, port.leaf).kind {
          SourceGraphSourceLeaf.Borrow {..} => { keep = matched covered = matched }
          SourceGraphSourceLeaf.Unknown {..} => ()
          _ => { covered = true }
        }
        let guards: [SourceAtom; 4] = [candidate.active, port.active, port.quality.present, history.quality.present]
        let active = run SourcePolicy.conjunction(&mut builder.rules, &guards, none)
        if keep { run List<SourceAtom>.append(&mut admitted, active) }
        let mut found = false
        let mut row = usize.ZERO
        while row < SourceGraphBuilder.ownershipMirrorCoverage(&builder.*).length {
          let obligation = SourceGraphBuilder.ownershipMirrorCoverage(&builder.*)[row]
          if sourceSameMirrorOrigin(obligation.origin, candidate.origin) && obligation.acquisitionCase == candidate.acquisitionCase
            && obligation.original.index == candidate.original.index
            && obligation.case == history.case {
            if obligation.source.index != port.source.index || obligation.leaf.index != port.leaf.index
              || obligation.category != history.category || obligation.direct != history.direct
              || !sourceDefinitionMatches(obligation.definition, history.definition)
              || !sourceReadMatches(obligation.read, history.read) {
              return CompilerBug.panic(b"ownership mirror coverage changed its original writer Case")
            }
            found = true
            if covered { let handled: [SourceAtom; 2] = [obligation.active, active]
              run SourceProgram.rule(&mut builder.rules, obligation.covered, &handled, none) }
          }
          row = row + usize.ONE
        }
        if !found { return CompilerBug.panic(b"ownership mirror omitted writer Case coverage") }
        each = each + usize.ONE
      }
      let kept = run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&admitted))
      run SourceGraphBuilder.bindPolicy(&mut builder.*, port.id, kept, no, no)
    }
    at = at + usize.ONE
  }
  return ()
}

// Selected Move publishes the original A unchanged. Construction eligibility restricts
// only this finite recipe; every later or unresolved history remains in Flow and coverage.
effect fn sourceMoveHoldings<'body>(builder: &mut SourceGraphBuilder<'body>, evaluation: SourceGraph.EvalId,
  paths: &mut List<List<Step>>) -> SourceAtom ! OutOfMemoryError ? &mut Allocator {
  let no = SourceProgram.atom(&mut builder.rules)
  let empty = List<SourceAtom>.make()
  let none = List<SourceAtom>.asSlice(&empty)
  let mut portIndex = usize.ZERO
  while portIndex < SourceGraphBuilder.policyCount(&builder.*) {
    let port = SourceGraphBuilder.policy(&builder.*, portIndex)
    if let SourceGraphTransferAuthority.MoveHolding {candidate: ordinal} = port.authority {
      let candidate = SourceGraphBuilder.moveHoldings(&builder.*)[ordinal]
      let request = SourceGraphBuilder.selectedMoves(&builder.*)[candidate.request]
      if request.result.index == evaluation.index {
        let reading = SourceGraphBuilder.moveReads(&builder.*)[candidate.moveRead]
        let observation = SourceGraphBuilder.moveObservations(&builder.*)[candidate.observation]
        let written = SourceGraphBuilder.definition(&builder.*, candidate.definition)
        let read = SourceGraphBuilder.read(&builder.*, candidate.read)
        if port.terminal || port.outputRole != SourceGraphSourceRole.Ownership
          || port.source.index != candidate.source.index || port.target.index != candidate.target.index
          || request.target.index != candidate.target.index || reading.value.index != candidate.source.index
          || reading.observation != candidate.observation || observation.request != candidate.request
          || !sourceSameStorage(written.storage, candidate.storage) || !sourceSameReadLane(written, read) {
          return CompilerBug.panic(b"Move holding changed its original acquisition or semantic publication")
        }
        let held = match written.summary {
          Option<usize>.Some {value} => SourceGraphBuilder.summaries(&builder.*)[value].placement
          _ => SourceGraphOwnershipPlacement.Known {anchor: written.storage.endpoint, suffix: Option<SourceGraph.OwnershipSuffix>.none()}
        }
        if !SourceGraph.sameOwnershipPlacement(held, candidate.held) {
          return CompilerBug.panic(b"Move holding substituted a different original A")
        }
        let reaches = match sourceFlowPair(&builder.reaching, candidate.definition, candidate.read) {
          Option<SourceAtom>.Some {value} => value
          _ => { return CompilerBug.panic(b"Move holding lost its actual definition/read pair") }
        }
        let expected = run sourceOwnershipField(&builder.*, observation.owner.endpoint, held, &mut paths.*)
        let outputRoot = SourceGraphBuilder.value(&builder.*, candidate.target).endpoint
        let placed = run sourceOwnershipField(&builder.*, outputRoot, candidate.placement, &mut paths.*)
        let matched = expected.supported && placed.supported
          && sourceSameField(List<List<Step>>.asSlice(&paths.*), expected.field, placed.field)
        let incoming = run SourceGraphBuilder.policyCases(&builder.*, port.id)
        let cases = List<SourceGraph.InputCase>.asSlice(&incoming)
        let mut admitted = List<SourceAtom>.make()
        let mut each = usize.ZERO
        while each < cases.length {
          let history = &cases[each]
          if history.category != port.category || history.direct != port.direct
            || !sourceDefinitionMatches(history.definition, port.definition) || !sourceReadMatches(history.read, port.read)
            || !sourceDefinitionMatches(history.definition, Option<SourceControl.DefinitionId>.some(candidate.definition))
            || !sourceReadMatches(history.read, Option<SourceControl.ReadId>.some(candidate.read))
            || !sourceAcquisitionHistory(SourceGraphBuilder.summaryReads(&builder.*), reading.read, history) {
            return CompilerBug.panic(b"Move policy changed its exact acquisition history")
          }
          let mut found = false
          let mut row = usize.ZERO
          while row < SourceGraphBuilder.moveHoldingCoverage(&builder.*).length {
            let obligation = SourceGraphBuilder.moveHoldingCoverage(&builder.*)[row]
            if obligation.moveRead == candidate.moveRead && obligation.case == history.case {
              if obligation.observation != candidate.observation || obligation.request != candidate.request
                || obligation.source.index != port.source.index || obligation.leaf.index != port.leaf.index
                || obligation.category != history.category || obligation.direct != history.direct
                || !sourceDefinitionMatches(obligation.definition, history.definition)
                || !sourceReadMatches(obligation.read, history.read) {
                return CompilerBug.panic(b"Move coverage changed its incoming Case")
              }
              found = true
              let constructed = match obligation.construction { Option<bool>.Some {value} => value _ => false }
              let mut keep = false
              let mut covered = false
              if constructed {
                match &SourceGraphBuilder.leaf(&builder.*, port.leaf).kind {
                  SourceGraphSourceLeaf.Borrow {..} => { keep = matched covered = matched }
                  SourceGraphSourceLeaf.Unknown {..} => ()
                  _ => { covered = true }
                }
              }
              let gates: [SourceAtom; 6] = [candidate.active, port.active, port.quality.present,
                SourceGraphBuilder.observationCase(&builder.*, history.case).semantic.present, reaches, obligation.active]
              let active = run SourcePolicy.conjunction(&mut builder.rules, &gates, none)
              if keep { run List<SourceAtom>.append(&mut admitted, active) }
              if covered { let handled: [SourceAtom; 1] = [active]
                run SourceProgram.rule(&mut builder.rules, obligation.covered, &handled, none) }
            }
            row = row + usize.ONE
          }
          if !found { return CompilerBug.panic(b"Move holding omitted exact incoming coverage") }
          each = each + usize.ONE
        }
        let kept = run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&admitted))
        run SourceGraphBuilder.bindPolicy(&mut builder.*, port.id, kept, no, no)
      }
    }
    portIndex = portIndex + usize.ONE
  }
  let mut gaps = List<SourceAtom>.make()
  let mut row = usize.ZERO
  while row < SourceGraphBuilder.moveHoldingCoverage(&builder.*).length {
    let obligation = SourceGraphBuilder.moveHoldingCoverage(&builder.*)[row]
    let request = SourceGraphBuilder.selectedMoves(&builder.*)[obligation.request]
    if request.result.index == evaluation.index {
      let masked: [SourceAtom; 2] = [obligation.active, SourceGraphBuilder.observationCase(&builder.*, obligation.case).masked]
      run SourceProgram.rule(&mut builder.rules, obligation.covered, &masked, none)
      // A proved later definition has no retrospective recipe. Missing construction
      // authority is distinct and must not discharge even an otherwise empty candidate.
      if let Option<bool>.Some {value: constructed} = obligation.construction {
        let noHolding = match &SourceGraphBuilder.leaf(&builder.*, obligation.leaf).kind {
          SourceGraphSourceLeaf.Entry {..} => true
          SourceGraphSourceLeaf.Expression {..} => true
          SourceGraphSourceLeaf.LoanFree {..} => true
          _ => false
        }
        if !constructed || noHolding { let observed: [SourceAtom; 1] = [obligation.active]
          run SourceProgram.rule(&mut builder.rules, obligation.covered, &observed, none) }
      }
      run List<SourceAtom>.append(&mut gaps, obligation.missing)
    }
    row = row + usize.ONE
  }
  row = usize.ZERO
  while row < SourceGraphBuilder.ownershipMirrorCoverage(&builder.*).length {
    let coverage = SourceGraphBuilder.ownershipMirrorCoverage(&builder.*)[row]
    if let SourceGraphOwnershipMirrorOrigin.Move {moveRead} = coverage.origin {
      let reading = SourceGraphBuilder.moveReads(&builder.*)[moveRead]
      let observation = SourceGraphBuilder.moveObservations(&builder.*)[reading.observation]
      if SourceGraphBuilder.selectedMoves(&builder.*)[observation.request].result.index == evaluation.index {
        run List<SourceAtom>.append(&mut gaps, coverage.missing)
      }
    }
    row = row + usize.ONE
  }
  row = usize.ZERO
  while row < SourceGraphBuilder.moveCoverage(&builder.*).length {
    let coverage = SourceGraphBuilder.moveCoverage(&builder.*)[row]
    if SourceGraphBuilder.selectedMoves(&builder.*)[coverage.request].result.index == evaluation.index {
      let active: [SourceAtom; 2] = [coverage.active, coverage.missing]
      run List<SourceAtom>.append(&mut gaps, run SourcePolicy.conjunction(&mut builder.rules, &active, none))
    }
    row = row + usize.ONE
  }
  run List<SourceAtom>.append(&mut gaps, no)
  return run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&gaps))
}

// Reference observations are real acquisition-point reads. Several alias proofs for the
// same canonical owner are alternatives of one use, not additional scan positions. Their
// union gates this positive use only; ReferenceCoverage independently retains every gap.
effect fn sourceReferenceAcquisition<'body>(builder: &mut SourceGraphBuilder<'body>, acquisition: SourceGraph.EvalId,
  state: &mut SourceDispatchProjection, loans: &[Loan], paths: &mut List<List<Step>>) -> ()
! OutOfMemoryError ? &mut Allocator {
  let publication = run sourceReferenceBindings(&mut builder.*, acquisition, &mut paths.*)
  run sourceDispatchMissing(&mut state.*, publication, &mut builder.rules)
  let evaluation = SourceGraphBuilder.evaluation(&builder.*, acquisition)
  let node = match evaluation.site { SourceGraphEvaluationSite.Node {node} => node
    _ => { return CompilerBug.panic(b"reference acquisition has no actual expression") } }
  let empty = List<SourceAtom>.make()
  let none = List<SourceAtom>.asSlice(&empty)
  let mut found = false
  let mut reference = usize.ZERO
  while reference < SourceGraphBuilder.referenceCoverage(&builder.*).length {
    let coverage = SourceGraphBuilder.referenceCoverage(&builder.*)[reference]
    let origin = SourceGraphBuilder.reference(&builder.*, coverage.reference)
    if SourceGraphBuilder.value(&builder.*, origin.descriptor).evaluation.index == acquisition.index {
      found = true
      let gaps: [SourceAtom; 2] = [coverage.active, coverage.missing]
      let missing = run SourcePolicy.conjunction(&mut builder.rules, &gaps, none)
      run sourceDispatchMissing(&mut state.*, missing, &mut builder.rules)
      let mut at = usize.ZERO
      while at < SourceGraphBuilder.referenceObservations(&builder.*).length {
        let selected = SourceGraphBuilder.referenceObservations(&builder.*)[at]
        if selected.reference != coverage.reference { at = at + usize.ONE continue }
        if selected.acquisition.index != acquisition.index {
          return CompilerBug.panic(b"reference observation changed its actual acquisition")
        }
        let mut prior = usize.ZERO
        while prior < at {
          let earlier = SourceGraphBuilder.referenceObservations(&builder.*)[prior]
          if earlier.reference == selected.reference && sourceSameStorage(earlier.owner, selected.owner) { break }
          prior = prior + usize.ONE
        }
        if prior < at { at = at + usize.ONE continue }
        let mut active = List<SourceAtom>.make()
        let mut reads = List<SourceGraph.ReferenceRead>.make()
        let mut alias = at
        while alias < SourceGraphBuilder.referenceObservations(&builder.*).length {
          let alternative = SourceGraphBuilder.referenceObservations(&builder.*)[alias]
          if alternative.reference == selected.reference && sourceSameStorage(alternative.owner, selected.owner) {
            run List<SourceAtom>.append(&mut active, alternative.active)
            let recorded = SourceGraphBuilder.referenceReads(&builder.*)
            let mut each = usize.ZERO
            while each < recorded.length {
              if recorded[each].observation == alias {
                let previous = List<SourceGraph.ReferenceRead>.asSlice(&reads)
                let mut seen = usize.ZERO
                while seen < previous.length && previous[seen].read.index != recorded[each].read.index { seen = seen + usize.ONE }
                if seen == previous.length { run List<SourceGraph.ReferenceRead>.append(&mut reads, recorded[each]) }
              }
              each = each + usize.ONE
            }
          }
          alias = alias + usize.ONE
        }
        let used = run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&active))
        let unknown = SourceProgram.atom(&mut builder.rules)
        let mut observed = SourceObservation {positions: List<SourceCarryPosition>.make(), other: List<SourceGraph.Input>.make(), unknown: unknown}
        let mut roots = usize.ZERO
        let mut each = usize.ZERO
        while each < List<SourceGraph.ReferenceRead>.length(&reads) {
          let actual = List<SourceGraph.ReferenceRead>.asSlice(&reads)[each]
          let read = SourceGraphBuilder.read(&builder.*, actual.read)
          let value = SourceGraphBuilder.value(&builder.*, actual.value)
          if value.phase != SourceGraphValuePhase.Input || !sourcePhysicalValue(value)
            || value.evaluation.index != acquisition.index || read.point.index != evaluation.point.index
            || read.value.index != actual.value.index || !sourceSameStorage(read.storage, actual.storage) {
            return CompilerBug.panic(b"reference contents substituted another read or descriptor publication")
          }
          let whole = sourceSameStorage(actual.storage, selected.owner)
          if whole { roots = roots + usize.ONE }
          let operand = SourceOperand {node: node, evaluation: acquisition, root: selected.owner.endpoint, ordinal: usize.MAX}
          let mut present = List<SourceAtom>.make()
          run sourceObserveValue(&mut builder.*, &mut observed, operand, actual.value, &mut paths.*, loans.length,
            &mut present, whole, Option<SourceControl.ReadId>.some(actual.read))
          let required: [SourceAtom; 1] = [used]
          run SourceProgram.rule(&mut builder.rules, unknown, &required, List<SourceAtom>.asSlice(&present))
          each = each + usize.ONE
        }
        if roots != usize.ONE {
          let required: [SourceAtom; 1] = [used]
          run SourceProgram.rule(&mut builder.rules, unknown, &required, none)
        }
        let no = SourceProgram.atom(&mut builder.rules)
        let mut effects = SourceStoreEffects {intervals: List<SourceIntervalEffect>.make(), refusal: no, missing: no}
        let span = SourceGraphBuilder.preparation(&builder.*).body.nodes[node.index].origin.location
        run sourceRecordReadAlternatives(&mut builder.*, &observed, SourceSemanticReadOrigin.Reference {observation: at},
          acquisition, span, used,
          &mut paths.*, &mut state.holders)
        run sourceUseObservedHolder(&mut builder.*, &observed, selected.owner, acquisition, Option<SourceVisit.OwnerId>.none(), used,
          &mut state.policy.state, &mut state.holders, &mut effects)
        run sourceDispatchMissing(&mut state.*, effects.missing, &mut builder.rules)
        run sourceAppendEffects<SourceIntervalEffect>(&mut state.policy.intervals, move effects.intervals)
        at = at + usize.ONE
      }
    }
    reference = reference + usize.ONE
  }
  if !found {
    let active = List<SourceControl.Point>.asSlice(&builder.reaching.points)[evaluation.point.index].reachable
    run sourceDispatchMissing(&mut state.*, active, &mut builder.rules)
  }
  return ()
}

fn sourceReadTarget<'body>(builder: &SourceGraphBuilder<'body>, read: SourceGraph.ReadView, target: SourceGraph.ValueId) -> bool {
  if read.value.index == target.index { return true }
  if let Option<usize>.Some {value: summary} = read.summary {
    let reads = SourceGraphBuilder.summaryReads(builder)
    let mut at = usize.ZERO
    while at < reads.length {
      if reads[at].read.index == read.id.index && reads[at].summary == summary && reads[at].target.index == target.index { return true }
      at = at + usize.ONE
    }
  }
  return false
}

// A whole-holder prewrite read observes Input, never the Output that includes the new
// weak write. Its genuine paired definitions keep prior loans live only when a slot was
// accepted. Weak storage publication itself belongs to the sole source-flow reservation.
effect fn sourceUseWriteHolder<'body>(builder: &mut SourceGraphBuilder<'body>, id: usize,
  state: &mut SourceLoanState, loans: &[Loan], paths: &mut List<List<Step>>,
  holders: &mut SourceHolderProjection, effects: &mut SourceStoreEffects) -> ()
! OutOfMemoryError ? &mut Allocator {
  let holder = SourceGraphBuilder.writeHolder(&builder.*, id)
  let storage = holder.storage
  let active = holder.active
  let execution = holder.execution
  let observation = run sourceObserveWriteHolder(&mut builder.*, id, &mut paths.*, loans.length)
  let node = match SourceGraphBuilder.evaluation(&builder.*, execution).site {
    SourceGraphEvaluationSite.Node {node} => node
    _ => { return CompilerBug.panic(b"write-holder read has no actual invocation") }
  }
  let span = SourceGraphBuilder.preparation(&builder.*).body.nodes[node.index].origin.location
  run sourceRecordHolderRead(&mut builder.*, &observation, SourceSemanticReadOrigin.Write {holder: id}, storage,
    Option<SourceGraph.Storage>.none(), Option<SourceGraph.Storage>.none(), execution, span, active, &mut paths.*, &mut holders.*)
  run sourceUseObservedHolder(&mut builder.*, &observation, storage, execution, Option<SourceVisit.OwnerId>.none(), active,
    &mut state.*, &mut holders.*, &mut effects.*)
  return ()
}

// Each semantic use retains its own observation B even when precision processing
// shares the owner's current Input with another alias. Membership is an exact read
// (or its summary read), never merely a matching loan, field or canonical root.
fn sourceSemanticReadMatches<'body>(builder: &SourceGraphBuilder<'body>, origin: SourceSemanticReadOrigin,
  value: SourceGraph.ValueId, history: &SourceGraph.InputCase) -> bool {
  let summaries = SourceGraphBuilder.summaryReads(builder)
  match origin {
    SourceSemanticReadOrigin.Reference {observation} => {
      let reads = SourceGraphBuilder.referenceReads(builder)
      let mut at = usize.ZERO
      while at < reads.length {
        if reads[at].observation == observation && sourceAcquisitionHistory(summaries, reads[at].read, history) { return true }
        at = at + usize.ONE
      }
    }
    SourceSemanticReadOrigin.Through {observation} => {
      let reads = SourceGraphBuilder.throughFlightReads(builder)
      let mut at = usize.ZERO
      while at < reads.length {
        if reads[at].observation == observation && sourceAcquisitionHistory(summaries, reads[at].read, history) { return true }
        at = at + usize.ONE
      }
    }
    SourceSemanticReadOrigin.Flight {observation} => {
      let reads = SourceGraphBuilder.readFlightReads(builder)
      let mut at = usize.ZERO
      while at < reads.length {
        if reads[at].observation == observation && sourceAcquisitionHistory(summaries, reads[at].read, history) { return true }
        at = at + usize.ONE
      }
    }
    SourceSemanticReadOrigin.Drop {observation} => {
      let reads = SourceGraphBuilder.dropReads(builder)
      let mut at = usize.ZERO
      while at < reads.length {
        if reads[at].observation == observation && sourceAcquisitionHistory(summaries, reads[at].read, history) { return true }
        at = at + usize.ONE
      }
    }
    SourceSemanticReadOrigin.Move {observation} => {
      let reads = SourceGraphBuilder.moveReads(builder)
      let mut at = usize.ZERO
      while at < reads.length {
        if reads[at].observation == observation && sourceAcquisitionHistory(summaries, reads[at].read, history) { return true }
        at = at + usize.ONE
      }
    }
    SourceSemanticReadOrigin.Field {observation} => {
      let reads = SourceGraphBuilder.fieldReholdReads(builder)
      let mut at = usize.ZERO
      while at < reads.length {
        if reads[at].observation == observation && sourceAcquisitionHistory(summaries, reads[at].read, history) { return true }
        at = at + usize.ONE
      }
    }
    SourceSemanticReadOrigin.Write {holder} => {
      let reads = List<SourceGraph.WriteComponent>.asSlice(&SourceGraphBuilder.writeHolder(builder, holder).components)
      let mut at = usize.ZERO
      while at < reads.length {
        if sourceAcquisitionHistory(summaries, reads[at].read, history) { return true }
        at = at + usize.ONE
      }
    }
    SourceSemanticReadOrigin.Copy {placement} => {
      return placement.consumer.index == value.index && sourceReadMatches(history.read,
        Option<SourceControl.ReadId>.some(placement.read))
    }
  }
  return false
}

// This is the accepted pathsOverlap predicate. MAX here is an explicitly unknown
// held path or a whole-holder read, not a replacement for unsupported geometry.
fn sourceSemanticPathsOverlap(paths: &[List<Step>], left: usize, right: usize) -> bool {
  if left == usize.MAX || right == usize.MAX { return true }
  let first = List<Step>.asSlice(&paths[left])
  let second = List<Step>.asSlice(&paths[right])
  let mut at = usize.ZERO
  while at < first.length && at < second.length {
    let indexed = (first[at].kind == StepKind.AnyElement || second[at].kind == StepKind.AnyElement
      || first[at].kind == StepKind.RepeatedElement || second[at].kind == StepKind.RepeatedElement)
      && (first[at].kind == StepKind.Element || first[at].kind == StepKind.AnyElement || first[at].kind == StepKind.RepeatedElement)
      && (second[at].kind == StepKind.Element || second[at].kind == StepKind.AnyElement || second[at].kind == StepKind.RepeatedElement)
    if !indexed && !sameStep(first[at], second[at]) { return false }
    at = at + usize.ONE
  }
  return true
}

// Decode original held A and the semantic read/write paths exactly once, before the
// path arena is consumed. Keep the structural coordinates alongside the predicate.
effect fn sourceRecordHolderRead<'body>(builder: &mut SourceGraphBuilder<'body>, observed: &SourceObservation,
  origin: SourceSemanticReadOrigin, owner: SourceGraph.Storage, selected: Option<SourceGraph.Storage>,
  written: Option<SourceGraph.Storage>, evaluation: SourceGraph.EvalId, span: Location, active: SourceAtom,
  paths: &mut List<List<Step>>, holders: &mut SourceHolderProjection) -> () ! OutOfMemoryError ? &mut Allocator {
  let point = SourceGraphBuilder.evaluation(&builder.*, evaluation).point.index
  let mut used = SourceReadField {supported: true, field: usize.MAX}
  let mut replaced = SourceReadField {supported: true, field: usize.MAX}
  if let Option<SourceGraph.Storage>.Some {value} = selected {
    used = run sourceOwnershipField(&builder.*, owner.endpoint,
      SourceGraphOwnershipPlacement.Known {anchor: value.endpoint, suffix: Option<SourceGraph.OwnershipSuffix>.none()}, &mut paths.*)
  }
  if let Option<SourceGraph.Storage>.Some {value} = written {
    replaced = run sourceOwnershipField(&builder.*, owner.endpoint,
      SourceGraphOwnershipPlacement.Known {anchor: value.endpoint, suffix: Option<SourceGraph.OwnershipSuffix>.none()}, &mut paths.*)
  }
  let positions = List<SourceCarryPosition>.asSlice(&observed.positions)
  let mut position = usize.ZERO
  while position < positions.length {
    let histories = List<SourceCarryCase>.asSlice(&positions[position].cases)
    let mut each = usize.ZERO
    while each < histories.length {
      let history = &histories[each]
      if !sourceSemanticReadMatches(&builder.*, origin, positions[position].value, &history.source) {
        each = each + usize.ONE continue
      }
      let source = sourceEffectSource(&positions[position], history)
      let mut storage = owner
      let mut held = SourceGraphOwnershipPlacement.Unknown
      let mut supported = false
      if let Option<SourceControl.DefinitionId>.Some {value: definition} = source.definition {
        if let Option<SourceControl.ReadId>.Some {value: read} = source.read {
          let original = SourceGraphBuilder.definition(&builder.*, definition)
          let current = SourceGraphBuilder.read(&builder.*, read)
          storage = original.storage
          held = match original.summary {
            Option<usize>.Some {value} => SourceGraphBuilder.summaries(&builder.*)[value].placement
            _ => SourceGraphOwnershipPlacement.Known {anchor: storage.endpoint, suffix: Option<SourceGraph.OwnershipSuffix>.none()}
          }
          let root = sourceStorageRoot(List<PreparedSources.Endpoint>.asSlice(&SourceGraphBuilder.preparation(&builder.*).endpoints), storage)
          let sameOwner = match root { Option<SourceGraph.Storage>.Some {value} => sourceSameStorage(value, owner) _ => false }
          supported = sameOwner && sourceSameReadLane(original, current) && current.point.index == point
        }
      }
      let mut required = true
      if supported {
        let field = run sourceOwnershipField(&builder.*, owner.endpoint, held, &mut paths.*)
        supported = field.supported && used.supported && replaced.supported
        if supported {
          let all = List<List<Step>>.asSlice(&paths.*)
          required = sourceSemanticPathsOverlap(all, used.field, field.field)
          if replaced.field != usize.MAX && field.field != usize.MAX
            && exactPath(List<Step>.asSlice(&all[replaced.field]))
            && pathContains(List<Step>.asSlice(&all[replaced.field]), List<Step>.asSlice(&all[field.field])) {
            required = false
          }
        }
      }
      let raw = SourceGraphBuilder.case(&builder.*, source.case).target
      if raw.value.index != source.value.index || raw.leaf.index != source.leaf.index || raw.category != source.category
        || raw.direct != history.source.direct || !sourceDefinitionMatches(raw.definition, source.definition)
        || !sourceReadMatches(raw.read, source.read) {
        return CompilerBug.panic(b"semantic holder read changed its actual incoming Case")
      }
      let leaf = match &SourceGraphBuilder.leaf(&builder.*, source.leaf).kind {
        SourceGraphSourceLeaf.Borrow {loan, ..} => loan == source.loan
        _ => false
      }
      if !leaf { return CompilerBug.panic(b"semantic holder read changed its original loan") }
      let gates: [SourceAtom; 2] = [active, history.source.quality.present]
      let empty = List<SourceAtom>.make()
      run List<SourceSemanticRead>.append(&mut holders.reads, SourceSemanticRead {
        source: source, origin: origin, owner: owner, selected: selected, written: written, storage: storage, held: held,
        evaluation: evaluation, point: point, span: span, supported: supported, required: required,
        active: run SourcePolicy.conjunction(&mut builder.rules, &gates, List<SourceAtom>.asSlice(&empty)),
        pair: Option<SourceAtom>.none()})
      each = each + usize.ONE
    }
    position = position + usize.ONE
  }
  return ()
}

// Precision may join one canonical owner, but diagnostic reads keep each original
// selected B and alias gate independently.
effect fn sourceRecordReadAlternatives<'body>(builder: &mut SourceGraphBuilder<'body>, observed: &SourceObservation,
  origin: SourceSemanticReadOrigin, evaluation: SourceGraph.EvalId, span: Location, active: SourceAtom,
  paths: &mut List<List<Step>>, holders: &mut SourceHolderProjection) -> () ! OutOfMemoryError ? &mut Allocator {
  let empty = List<SourceAtom>.make()
  let none = List<SourceAtom>.asSlice(&empty)
  match origin {
    SourceSemanticReadOrigin.Reference {observation} => {
      let original = SourceGraphBuilder.referenceObservations(&builder.*)[observation]
      let mut at = usize.ZERO
      while at < SourceGraphBuilder.referenceObservations(&builder.*).length {
        let row = SourceGraphBuilder.referenceObservations(&builder.*)[at]
        if row.reference == original.reference && sourceSameStorage(row.owner, original.owner) {
          let gates: [SourceAtom; 2] = [active, row.active]
          let used = run SourcePolicy.conjunction(&mut builder.rules, &gates, none)
          run sourceRecordHolderRead(&mut builder.*, observed, SourceSemanticReadOrigin.Reference {observation: at},
            row.owner, Option<SourceGraph.Storage>.some(row.storage), Option<SourceGraph.Storage>.none(), evaluation, span, used, &mut paths.*, &mut holders.*)
        }
        at = at + usize.ONE
      }
    }
    SourceSemanticReadOrigin.Through {observation} => {
      let original = SourceGraphBuilder.throughFlightObservations(&builder.*)[observation]
      let mut at = usize.ZERO
      while at < SourceGraphBuilder.throughFlightObservations(&builder.*).length {
        let row = SourceGraphBuilder.throughFlightObservations(&builder.*)[at]
        if row.request == original.request && sourceSameStorage(row.owner, original.owner) {
          let gates: [SourceAtom; 2] = [active, row.active]
          let used = run SourcePolicy.conjunction(&mut builder.rules, &gates, none)
          run sourceRecordHolderRead(&mut builder.*, observed, SourceSemanticReadOrigin.Through {observation: at},
            row.owner, Option<SourceGraph.Storage>.some(row.storage), Option<SourceGraph.Storage>.none(), evaluation, span, used, &mut paths.*, &mut holders.*)
        }
        at = at + usize.ONE
      }
    }
    SourceSemanticReadOrigin.Flight {observation} => {
      let original = SourceGraphBuilder.readFlightObservations(&builder.*)[observation]
      let mut at = usize.ZERO
      while at < SourceGraphBuilder.readFlightObservations(&builder.*).length {
        let row = SourceGraphBuilder.readFlightObservations(&builder.*)[at]
        if row.evaluation.index == original.evaluation.index && sourceSameStorage(row.owner, original.owner) {
          let gates: [SourceAtom; 2] = [active, row.active]
          let used = run SourcePolicy.conjunction(&mut builder.rules, &gates, none)
          run sourceRecordHolderRead(&mut builder.*, observed, SourceSemanticReadOrigin.Flight {observation: at},
            row.owner, Option<SourceGraph.Storage>.some(row.storage), Option<SourceGraph.Storage>.none(), evaluation, span, used, &mut paths.*, &mut holders.*)
        }
        at = at + usize.ONE
      }
    }
    SourceSemanticReadOrigin.Drop {observation} => {
      let original = SourceGraphBuilder.dropObservations(&builder.*)[observation]
      let mut at = usize.ZERO
      while at < SourceGraphBuilder.dropObservations(&builder.*).length {
        let row = SourceGraphBuilder.dropObservations(&builder.*)[at]
        if row.request == original.request && sourceSameStorage(row.owner, original.owner) {
          let gates: [SourceAtom; 2] = [active, row.active]
          let used = run SourcePolicy.conjunction(&mut builder.rules, &gates, none)
          run sourceRecordHolderRead(&mut builder.*, observed, SourceSemanticReadOrigin.Drop {observation: at},
            row.owner, Option<SourceGraph.Storage>.some(row.storage), Option<SourceGraph.Storage>.none(), evaluation, span, used, &mut paths.*, &mut holders.*)
        }
        at = at + usize.ONE
      }
    }
    SourceSemanticReadOrigin.Move {observation} => {
      let original = SourceGraphBuilder.moveObservations(&builder.*)[observation]
      let mut at = usize.ZERO
      while at < SourceGraphBuilder.moveObservations(&builder.*).length {
        let row = SourceGraphBuilder.moveObservations(&builder.*)[at]
        if row.request == original.request && sourceSameStorage(row.owner, original.owner) {
          let gates: [SourceAtom; 2] = [active, row.active]
          let used = run SourcePolicy.conjunction(&mut builder.rules, &gates, none)
          run sourceRecordHolderRead(&mut builder.*, observed, SourceSemanticReadOrigin.Move {observation: at},
            row.owner, Option<SourceGraph.Storage>.some(row.storage), Option<SourceGraph.Storage>.none(), evaluation, span, used, &mut paths.*, &mut holders.*)
        }
        at = at + usize.ONE
      }
    }
    SourceSemanticReadOrigin.Field {observation} => {
      let original = SourceGraphBuilder.fieldReholdObservations(&builder.*)[observation]
      let mut at = usize.ZERO
      while at < SourceGraphBuilder.fieldReholdObservations(&builder.*).length {
        let row = SourceGraphBuilder.fieldReholdObservations(&builder.*)[at]
        if row.request == original.request && sourceSameStorage(row.owner, original.owner) {
          let gates: [SourceAtom; 2] = [active, row.active]
          let used = run SourcePolicy.conjunction(&mut builder.rules, &gates, none)
          run sourceRecordHolderRead(&mut builder.*, observed, SourceSemanticReadOrigin.Field {observation: at},
            row.owner, Option<SourceGraph.Storage>.none(), Option<SourceGraph.Storage>.some(row.storage), evaluation, span, used, &mut paths.*, &mut holders.*)
        }
        at = at + usize.ONE
      }
    }
    _ => { return CompilerBug.panic(b"semantic read alternatives require an actual observation family") }
  }
  return ()
}

// Resolve only already-emitted Flow pairs. One immutable index serves every semantic
// read; neither this projection nor the diagnostic recomputes reaching definitions.
effect fn sourceSemanticReadPairs<'body>(builder: &SourceGraphBuilder<'body>, reads: &mut List<SourceSemanticRead>)
  -> () ! OutOfMemoryError ? &mut Allocator {
  let index = run sourceFlowPairIndex(&builder.reaching)
  let rows = List<SourceSemanticRead>.asMutSlice(&mut reads.*)
  let mut at = usize.ZERO
  while at < rows.length {
    if let Option<SourceControl.DefinitionId>.Some {value: definition} = rows[at].source.definition {
      if let Option<SourceControl.ReadId>.Some {value: read} = rows[at].source.read {
        rows[at].pair = sourceIndexedFlowPair(&builder.reaching, &index, definition, read)
      }
    }
    if let Option<SourceAtom>.None = rows[at].pair { rows[at].supported = false }
    at = at + usize.ONE
  }
  return ()
}

// Canonical holder liveness comes from its actual current read and the sole Flow pair.
// Both an owner exit and an accepted weak write use this same attribution; output contents
// and later definitions cannot stand in for the original pre-use holding.
effect fn sourceUseObservedHolder<'body>(builder: &mut SourceGraphBuilder<'body>, observation: &SourceObservation,
  storage: SourceGraph.Storage, execution: SourceGraph.EvalId, owner: Option<SourceVisit.OwnerId>, active: SourceAtom,
  state: &mut SourceLoanState, holders: &mut SourceHolderProjection, effects: &mut SourceStoreEffects) -> ()
! OutOfMemoryError ? &mut Allocator {
  let at = SourceGraphBuilder.evaluation(&builder.*, execution)
  drop run sourceBarrier(observation, &mut state.*, active, &mut builder.rules)
  let empty = List<SourceAtom>.make()
  let none = List<SourceAtom>.asSlice(&empty)
  let unknown: [SourceAtom; 2] = [active, observation.unknown]
  let gaps: [SourceAtom; 2] = [effects.missing, run SourcePolicy.conjunction(&mut builder.rules, &unknown, none)]
  effects.missing = run SourcePolicy.disjunction(&mut builder.rules, &gaps)
  let request = List<SourceHolderRequest>.length(&holders.requests)
  run List<SourceHolderRequest>.append(&mut holders.requests, SourceHolderRequest {
    dispatch: usize.MAX, owner: owner, evaluation: execution, root: storage.endpoint, point: at.point, active: active})
  run List<SourceHolderUse>.append(&mut holders.uses, SourceHolderUse {request: request, storage: storage, active: active})
  let positions = List<SourceCarryPosition>.asSlice(&observation.positions)
  let mut position = usize.ZERO
  while position < positions.length {
    let histories = List<SourceCarryCase>.asSlice(&positions[position].cases)
    let mut each = usize.ZERO
    while each < histories.length {
      let history = &histories[each]
      let gates: [SourceAtom; 2] = [active, history.source.quality.present]
      let present = run SourcePolicy.conjunction(&mut builder.rules, &gates, none)
      let mut authenticated = false
      if let Option<SourceControl.DefinitionId>.Some {value: definition} = history.source.definition {
        if let Option<SourceControl.ReadId>.Some {value: read} = history.source.read {
          let original = SourceGraphBuilder.definition(&builder.*, definition)
          let current = SourceGraphBuilder.read(&builder.*, read)
          let canonical = sourceStorageRoot(List<PreparedSources.Endpoint>.asSlice(&SourceGraphBuilder.preparation(&builder.*).endpoints), current.storage)
          let sameOwner = match canonical { Option<SourceGraph.Storage>.Some {value} => sourceSameStorage(value, storage) _ => false }
          if sourceReadTarget(&builder.*, current, positions[position].value) && current.point.index == at.point.index
            && sourceSameReadLane(original, current) && sameOwner {
            if let Option<SourceAtom>.Some {value: pair} = sourceFlowPair(&builder.reaching, definition, read) {
              let paired: [SourceAtom; 2] = [present, pair]
              run List<SourceIntervalEffect>.append(&mut effects.intervals, SourceIntervalEffect {
                source: sourceEffectSource(&positions[position], history), from: original.point.index, to: at.point.index,
                cleanup: false, holder: true, active: run SourcePolicy.conjunction(&mut builder.rules, &paired, none)})
              authenticated = true
            }
          }
        }
      }
      if !authenticated {
        let missing: [SourceAtom; 2] = [effects.missing, present]
        effects.missing = run SourcePolicy.disjunction(&mut builder.rules, &missing)
      }
      each = each + usize.ONE
    }
    position = position + usize.ONE
  }
  return ()
}

// The inventory already resolved Immediate Run's actual receiver chain. Resolve only its
// frozen original declaration here; never search for a runtime occurrence by typed NodeId.
// Runtime input order is Visit.inputs position, independent of Value/port allocation order.
effect fn sourceStoreOperands<'body>(builder: &SourceGraphBuilder<'body>, operation: usize)
  -> List<SourceOperand> ! OutOfMemoryError ? &mut Allocator {
  let operations = List<SourceStores.Operation>.asSlice(&SourceGraphBuilder.stores(builder).operations)
  if operation >= operations.length { return CompilerBug.panic(b"retained policy has no actual executing operation") }
  let actual = &operations[operation]
  let origin = SourceGraphBuilder.evaluation(builder, actual.originating)
  let site = match origin.site { SourceGraphEvaluationSite.Node {node} => node
    _ => { return CompilerBug.panic(b"retained invocation originated at a body parameter") } }
  let prepared = SourceGraphBuilder.preparation(builder)
  let retention = &List<PreparedSources.Retention>.asSlice(&prepared.retentions)[actual.retention.index]
  if retention.site.index != site.index { return CompilerBug.panic(b"retained inputs lost their actual originating stage") }
  let rows = List<PreparedSources.Operation>.asSlice(&prepared.operations)
  let mut row = usize.MAX
  let mut at = usize.ZERO
  while at < rows.length {
    if rows[at].site.index == site.index {
      if row != usize.MAX { return CompilerBug.panic(b"retained originating stage has duplicate prepared operations") }
      row = at
    }
    at = at + usize.ONE
  }
  if row == usize.MAX { return CompilerBug.panic(b"retained originating stage has no prepared operation") }
  let routes = List<PreparedSources.InputRoute>.asSlice(&rows[row].inputs)
  let maps = List<PreparedSources.SelectionMap>.asSlice(&prepared.maps)
  let endpoints = List<PreparedSources.Endpoint>.asSlice(&prepared.endpoints)
  let inputs = List<SourceStores.Input>.asSlice(&actual.inputs)
  let mut ordered = List<usize>.make()
  at = usize.ZERO
  while at < inputs.length {
    let mut position = usize.ZERO
    while position < List<usize>.length(&ordered)
      && inputs[List<usize>.asSlice(&ordered)[position]].position < inputs[at].position { position = position + usize.ONE }
    if position < List<usize>.length(&ordered)
      && inputs[List<usize>.asSlice(&ordered)[position]].position == inputs[at].position {
      return CompilerBug.panic(b"retained stage repeated one actual operand position")
    }
    run List<usize>.insert(&mut ordered, position, at)
    at = at + usize.ONE
  }
  let mut result = List<SourceOperand>.make()
  let order = List<usize>.asSlice(&ordered)
  at = usize.ZERO
  while at < order.length {
    let input = &inputs[order[at]]
    if input.route >= routes.length { return CompilerBug.panic(b"retained input substituted another original route") }
    let root = maps[routes[input.route].map.index].source
    let node = match &endpoints[root.index].root {
      PreparedSourcesRoot.Node {node, category: endpointCategory} if endpointCategory == PreparedSourcesEndpointRole.Value => node
      _ => { return CompilerBug.panic(b"retained input has no actual physical value root") }
    }
    let observed = SourceGraphBuilder.evaluation(builder, input.actual.evaluation)
    let same = match observed.site { SourceGraphEvaluationSite.Node {node: evaluatedNode} => evaluatedNode.index == node.index _ => false }
    if !same || input.actual.node.index != node.index {
      return CompilerBug.panic(b"retained physical input changed its actual evaluation")
    }
    run List<SourceOperand>.append(&mut result, SourceOperand {node: node, evaluation: input.actual.evaluation,
      root: root, ordinal: input.operand})
    at = at + usize.ONE
  }
  return move result
}

// Select one reserved placement family for the unchanged destinationField decision.
// A nonselected alternative is a grounded drop, not missing coverage. Exact placement wins
// at the selected component; ancestor/unknown holdings use their distinct summary lanes.
effect fn sourceWriteMatches<'body>(builder: &SourceGraphBuilder<'body>, candidate: SourceGraph.RetainedWrite,
  field: usize, disposition: SourceGraphSummaryDisposition, paths: &mut List<List<Step>>) -> bool ! OutOfMemoryError ? &mut Allocator {
  let holder = SourceGraphBuilder.writeHolder(builder, candidate.holder).storage
  let address = SourceGraphBuilder.retainedAddresses(builder)[candidate.address]
  let endpoints = List<PreparedSources.Endpoint>.asSlice(&SourceGraphBuilder.preparation(builder).endpoints)
  let exact = run sourceField(endpoints, holder.endpoint, address.storage.endpoint, &mut paths.*)
  let mut merged = Option<usize>.some(field)
  drop sourceMergeField(List<List<Step>>.asSlice(&paths.*), &mut merged, exact)
  let same = field != usize.MAX && exact != usize.MAX
    && match merged { Option<usize>.Some {value} => value != usize.MAX _ => false }
  let summary = match candidate.summary {
    Option<usize>.Some {value} => SourceGraphBuilder.summaries(builder)[value]
    _ => { return same && disposition == SourceGraphSummaryDisposition.Ordinary }
  }
  if summary.disposition != disposition { return false }
  if sourceUnknownPlacement(summary.placement) { return field == usize.MAX && sourceSameStorage(summary.prefix, holder) }
  if field == usize.MAX || (same && disposition == SourceGraphSummaryDisposition.Ordinary) { return false }
  let selected = run sourceOwnershipField(builder, holder.endpoint, summary.placement, &mut paths.*)
  if !selected.supported { return false }
  let prefix = selected.field
  merged = Option<usize>.some(field)
  drop sourceMergeField(List<List<Step>>.asSlice(&paths.*), &mut merged, prefix)
  return prefix != usize.MAX && match merged { Option<usize>.Some {value} => value != usize.MAX _ => false }
}

effect fn sourceWriteCovered<'body>(builder: &SourceGraphBuilder<'body>, candidate: SourceGraph.RetainedWrite,
  field: usize, disposition: SourceGraphSummaryDisposition, paths: &mut List<List<Step>>) -> bool ! OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < SourceGraphBuilder.policyCount(builder) {
    let port = SourceGraphBuilder.policy(builder, at)
    if let SourceGraphTransferAuthority.RetainedWrite {candidate: id} = port.authority {
      let other = SourceGraphBuilder.writeCandidate(builder, id)
      if other.operation == candidate.operation && other.sourceInput == candidate.sourceInput
        && other.sourceSlot == candidate.sourceSlot && other.address == candidate.address
        && other.source.index == candidate.source.index && other.holder == candidate.holder {
        if run sourceWriteMatches(builder, other, field, disposition, &mut paths.*) { return true }
      }
    }
    at = at + usize.ONE
  }
  return false
}

// Each canonical alternative retains its own applicability. A missing geometry is a
// separate obligation and cannot make a root comparison true by using the MAX sentinel.
effect fn sourceDifferentRoot(geometry: &SourceLoanGeometry, root: usize, rules: &mut SourceProgram) -> SourceAtom
! OutOfMemoryError ? &mut Allocator {
  let mut choices = List<SourceAtom>.make()
  let places = List<SourceGeometryPlace>.asSlice(&geometry.alternatives)
  let mut at = usize.ZERO
  while at < places.length {
    if places[at].place.root != root { run List<SourceAtom>.append(&mut choices, places[at].active) }
    at = at + usize.ONE
  }
  return run SourcePolicy.disjunction(&mut rules.*, List<SourceAtom>.asSlice(&choices))
}

// The descriptor proof selects this write's canonical holder. Other alternatives of
// the same loan are not mismatches; absence of any applicable matching root remains a gap.
effect fn sourceTargetGeometry(geometry: &SourceLoanGeometry, root: usize, locals: usize,
  active: SourceAtom, rules: &mut SourceProgram) -> SourceAtom ! OutOfMemoryError ? &mut Allocator {
  let mut matching = List<SourceAtom>.make()
  let mut relevant = List<SourceAtom>.make()
  let places = List<SourceGeometryPlace>.asSlice(&geometry.alternatives)
  let mut at = usize.ZERO
  while at < places.length {
    if places[at].place.root < locals { run List<SourceAtom>.append(&mut relevant, places[at].active) }
    if places[at].place.root == root { run List<SourceAtom>.append(&mut matching, places[at].active) }
    at = at + usize.ONE
  }
  let present: [SourceAtom; 2] = [active, run SourcePolicy.disjunction(&mut rules.*, List<SourceAtom>.asSlice(&relevant))]
  return run SourcePolicy.conjunction(&mut rules.*, &present, List<SourceAtom>.asSlice(&matching))
}

union SourceDestinationPolicy {
  CallBody,
  Retained { retention: PreparedSources.RetentionId, slot: usize },
}
impl Copy for SourceDestinationPolicy {}

fn sourceDestinationSlot<'body>(builder: &SourceGraphBuilder<'body>, policy: SourceDestinationPolicy,
  position: &SourceCarryPosition, history: &SourceCarryCase, paths: &[List<Step>]) -> bool {
  return match policy {
    SourceDestinationPolicy.CallBody => true
    SourceDestinationPolicy.Retained {retention, slot} => {
      let record = &List<PreparedSources.Retention>.asSlice(&SourceGraphBuilder.preparation(builder).retentions)[retention.index]
      let carry = sourceSlotValue(position, history)
      return Shared<List<KeptRegions>>.with<bool>(&record.recorded, fn(values: &List<KeptRegions>) -> bool {
        let entries = List<KeptRegions>.asSlice(values)
        if carry.operand >= entries.length { return CompilerBug.panic(b"destination demand lost its original operand") }
        let slots = List<KeptSlot>.asSlice(&entries[carry.operand].slots)
        if slot >= slots.length { return CompilerBug.panic(b"destination demand lost its original slot") }
        return destinationSlot(paths, carry, &slots[slot])
      })
    }
  }
}

// Address coverage belongs to a possible destination, not every structurally reserved
// descriptor. Both store policies can write only through an exclusive body-local loan.
// Retained slots additionally use the original destinationSlot predicate. This is only
// applicability: no alias, address coverage or source-pair evidence is discharged here.
// Unknown contents and unresolved geometry keep the demand possibly active.
effect fn sourceDestinationDemand<'body>(builder: &mut SourceGraphBuilder<'body>, observation: &SourceObservation,
  operand: SourceOperand, policy: SourceDestinationPolicy, loans: &[Loan], geometry: &[SourceLoanGeometry],
  locals: usize, paths: &[List<Step>]) -> SourceAtom ! OutOfMemoryError ? &mut Allocator {
  let mut demands = List<SourceAtom>.make()
  run List<SourceAtom>.append(&mut demands, observation.unknown)
  let empty = List<SourceAtom>.make()
  let none = List<SourceAtom>.asSlice(&empty)
  let positions = List<SourceCarryPosition>.asSlice(&observation.positions)
  let mut at = usize.ZERO
  while at < positions.length {
    let position = &positions[at]
    if position.operand == operand.ordinal && position.root.index == operand.root.index
      && SourceGraphBuilder.value(&builder.*, position.value).evaluation.index == operand.evaluation.index
      && loans[position.loan].exclusive {
      let places = &geometry[position.loan]
      let mut local = List<SourceAtom>.make()
      run List<SourceAtom>.append(&mut local, places.missing)
      let alternatives = List<SourceGeometryPlace>.asSlice(&places.alternatives)
      let mut each = usize.ZERO
      while each < alternatives.length {
        if alternatives[each].place.root < locals { run List<SourceAtom>.append(&mut local, alternatives[each].active) }
        each = each + usize.ONE
      }
      let possible = run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&local))
      let histories = List<SourceCarryCase>.asSlice(&position.cases)
      each = usize.ZERO
      while each < histories.length {
        if sourceDestinationSlot(&builder.*, policy, position, &histories[each], paths) {
          let required: [SourceAtom; 2] = [histories[each].source.quality.present, possible]
          run List<SourceAtom>.append(&mut demands, run SourcePolicy.conjunction(&mut builder.rules, &required, none))
        }
        each = each + usize.ONE
      }
    }
    at = at + usize.ONE
  }
  return run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&demands))
}

// A borrowed pattern receiver has an actual address demand even when its authored
// syntax has no local root. A literal receiver has no descriptor holder to exclude.
effect fn sourceReceiverOutside<'body>(builder: &mut SourceGraphBuilder<'body>, operand: SourceOperand,
  point: SourceControl.PointId, geometry: &SourceLoanGeometry, owners: &[SourceVisit.Owner], paths: &mut List<List<Step>>)
  -> SourceCallerEvidence ! OutOfMemoryError ? &mut Allocator {
  let prepared = SourceGraphBuilder.preparation(&builder.*)
  let path = run pathOf(prepared.body.nodes, operand.node)
  let base = projectedBase(prepared.body.nodes, operand.node)
  let borrowed = match &prepared.body.nodes[base.index].kind {
    NodeKind.Expression {form: Expression.PatternBinding {access, ..}, ..} => access == BindingAccess.Shared || access == BindingAccess.Exclusive
    _ => false
  }
  let localCount = prepared.body.locals.length
  let no = SourceProgram.atom(&mut builder.rules)
  if !borrowed || path.root < localCount {
    let mut present = no
    if path.root == usize.MAX {
      present = run sourceBoolean(&mut builder.rules, true)
    } else {
      present = run sourceDifferentRoot(geometry, path.root, &mut builder.rules)
    }
    return SourceCallerEvidence {present: present, missing: no}
  }
  let endpoints = List<PreparedSources.Endpoint>.asSlice(&SourceGraphBuilder.preparation(&builder.*).endpoints)
  let mut rootCandidate = Option<PreparedSources.EndpointId>.none()
  let mut at = usize.ZERO
  while at < endpoints.length {
    let selected = match &endpoints[at].root {
      PreparedSourcesRoot.Node {node, category: endpointCategory} if endpointCategory == PreparedSourcesEndpointRole.Storage => node.index == operand.node.index
      _ => false
    }
    if selected { if let Option<PreparedSources.EndpointId>.None = endpoints[at].parent {
      if let Option<PreparedSources.EndpointId>.Some {..} = rootCandidate { return CompilerBug.panic(b"receiver has duplicate actual storage roots") }
      rootCandidate = Option<PreparedSources.EndpointId>.some(PreparedSources.EndpointId {index: at})
    } }
    at = at + usize.ONE
  }
  let root = match rootCandidate { Option<PreparedSources.EndpointId>.Some {value} => value
    _ => { return CompilerBug.panic(b"borrowed receiver has no prepared storage root") } }
  let selected = run sourceResolveAddress(&mut builder.*, SourceGeometryAddress {
    evaluation: operand.evaluation, root: root, selected: root}, point, owners, &mut paths.*)
  let places = List<SourceGeometryPlace>.asSlice(&selected.alternatives)
  let empty = List<SourceAtom>.make()
  let mut choices = List<SourceAtom>.make()
  at = usize.ZERO
  while at < places.length {
    let different = run sourceDifferentRoot(geometry, places[at].place.root, &mut builder.rules)
    let gates: [SourceAtom; 2] = [places[at].active, different]
    run List<SourceAtom>.append(&mut choices, run SourcePolicy.conjunction(&mut builder.rules, &gates, List<SourceAtom>.asSlice(&empty)))
    at = at + usize.ONE
  }
  return SourceCallerEvidence {present: run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&choices)), missing: selected.missing}
}

// This handler owns only the executing call's declared slots. Callable-environment writes
// require their separate authority. Observe the exact original inputs once in runtime order;
// policy histories do not add physical operands or re-run an acquisition.
effect fn sourceStoreIntoLent<'body>(builder: &mut SourceGraphBuilder<'body>, operation: usize,
  loans: &[Loan], geometry: &[SourceLoanGeometry], locals: &[Local], paths: &mut List<List<Step>>,
  owner: &DeclarationId, edges: &[RetentionEdge], used: &mut List<usize>, ancestry: &SourceReadAncestries)
  -> SourceStoreEffects ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let operands = run sourceStoreOperands(&builder.*, operation)
  let observation = run sourceObserve(&mut builder.*, List<SourceOperand>.asSlice(&operands),
    SourceGraphValuePhase.Output, &mut paths.*, loans.length, false, Option<usize>.none())
  let no = SourceProgram.atom(&mut builder.rules)
  let mut effects = SourceStoreEffects {intervals: List<SourceIntervalEffect>.make(), refusal: no, missing: no}
  let empty = List<SourceAtom>.make()
  let none = List<SourceAtom>.asSlice(&empty)
  let count = SourceGraphBuilder.policyCount(&builder.*)
  let execution = List<SourceStores.Operation>.asSlice(&SourceGraphBuilder.stores(&builder.*).operations)[operation].execute
  let reached = List<SourceControl.Point>.asSlice(&builder.reaching.points)[execution.index].reachable
  let incomplete: [SourceAtom; 2] = [reached, observation.unknown]
  effects.missing = run SourcePolicy.conjunction(&mut builder.rules, &incomplete, none)
  let positions = List<SourceCarryPosition>.asSlice(&observation.positions)
  let mut readInputs = List<SourceReadInputs>.make()
  let mut descriptors = run sourceAddressObservations(SourceGraphBuilder.retainedAddresses(&builder.*).length)
  let mut policy = usize.ZERO
  while policy < count {
    let port = SourceGraphBuilder.policy(&builder.*, policy)
    if let SourceGraphTransferAuthority.RetainedWrite {candidate: id} = port.authority {
      let candidate = SourceGraphBuilder.writeCandidate(&builder.*, id)
      if candidate.operation == operation {
        let policyCases = run SourceGraphBuilder.policyCases(&builder.*, port.id)
        let projected = run sourcePolicyObservation(&mut builder.*, port.id, Option<usize>.none())
        if port.terminal || port.outputDirect || port.source.index != candidate.source.index || port.target.index != candidate.target.index {
          return CompilerBug.panic(b"retained policy changed its actual indirect write")
        }
        let address = SourceGraphBuilder.retainedAddresses(&builder.*)[candidate.address]
        let inventory = &List<SourceStores.Operation>.asSlice(&SourceGraphBuilder.stores(&builder.*).operations)[operation]
        let retention = inventory.retention
        let inputs = List<SourceStores.Input>.asSlice(&inventory.inputs)
        let source = &inputs[candidate.sourceInput]
        let destination = &inputs[address.input]
        let sourceSlot = SourceKeptSlot {operand: source.operand,
          slot: List<SourceStores.Slot>.asSlice(&source.slots)[candidate.sourceSlot].slot}
        let target = &List<SourceStores.Slot>.asSlice(&destination.slots)[address.slot]
        let targetSlot = SourceKeptSlot {operand: destination.operand, slot: target.slot}
        let selected = &List<PreparedSources.Selection>.asSlice(&SourceGraphBuilder.preparation(&builder.*).selections)[target.physical.index]
        let operand = SourceOperand {node: destination.actual.node, evaluation: destination.actual.evaluation,
          root: selected.root, ordinal: destination.operand}
        let actualSource = source.actual.evaluation
        let canonical = SourceGraphBuilder.writeHolder(&builder.*, candidate.holder).storage
        let root = match &List<PreparedSources.Endpoint>.asSlice(&SourceGraphBuilder.preparation(&builder.*).endpoints)[canonical.endpoint.index].root {
          PreparedSourcesRoot.Local {local, category: endpointCategory} if endpointCategory == PreparedSourcesEndpointRole.Storage => local.index
          _ => usize.MAX
        }
        let activeGates: [SourceAtom; 3] = [port.active, candidate.active, address.active]
        let active = run SourcePolicy.conjunction(&mut builder.rules, &activeGates, none)
        let presentGates: [SourceAtom; 2] = [active, projected.quality.present]
        let present = run SourcePolicy.conjunction(&mut builder.rules, &presentGates, none)
        let mut kept = List<SourceAtom>.make()
        let mut gaps = List<SourceAtom>.make()
        let mut matched = List<SourceAtom>.make()
        let mut borrowed = false
        match &SourceGraphBuilder.leaf(&builder.*, port.leaf).kind {
          SourceGraphSourceLeaf.Borrow {..} => { borrowed = true }
          SourceGraphSourceLeaf.Entry {..} => ()
          SourceGraphSourceLeaf.Expression {..} => ()
          SourceGraphSourceLeaf.LoanFree {..} => ()
          SourceGraphSourceLeaf.Unknown {..} => { run List<SourceAtom>.append(&mut gaps, present) }
        }
        if borrowed {
          let descriptorId = run sourceStoredDescriptor(&mut builder.*, &mut descriptors, candidate.address, SourceDescriptorCase {
            category: address.category, descriptor: address.descriptor, leaf: address.leaf, definition: address.definition,
            read: address.read, direct: address.direct, active: address.active}, operand, &mut paths.*, loans.length)
          let descriptor = &List<SourceObservation>.asSlice(&descriptors.observations)[descriptorId]
          let unknown: [SourceAtom; 2] = [present, descriptor.unknown]
          run List<SourceAtom>.append(&mut gaps, run SourcePolicy.conjunction(&mut builder.rules, &unknown, none))
          let targets = List<SourceCarryPosition>.asSlice(&descriptor.positions)
          let mut position = usize.ZERO
          while position < positions.length {
            let incoming = &positions[position]
            if incoming.value.index == port.source.index && incoming.leaf.index == port.leaf.index
              && incoming.operand == sourceSlot.operand
              && SourceGraphBuilder.value(&builder.*, incoming.value).evaluation.index == actualSource.index {
              let histories = List<SourceCarryCase>.asSlice(&incoming.cases)
              let mut each = usize.ZERO
              while each < histories.length {
                let history = &histories[each]
                if history.source.category == port.category && history.source.direct == port.direct && sourceDefinitionMatches(history.source.definition, port.definition)
                  && sourceReadMatches(history.source.read, port.read)
                  && sourcePolicyCase(List<SourceGraph.InputCase>.asSlice(&policyCases), &history.source) {
                  run List<SourceAtom>.append(&mut matched, history.source.quality.present)
                  let exclusion = run sourceReadExclusion(&mut builder.*, &mut readInputs, ancestry, sourceEffectSource(incoming, history), active, &mut paths.*)
                  run List<SourceAtom>.append(&mut gaps, exclusion.missing)
                  let mut target = usize.ZERO
                  while target < targets.length {
                    let lent = &targets[target]
                    let loan = &loans[lent.loan]
                    if loan.exclusive {
                      let needed: [SourceAtom; 2] = [present, lent.quality.present]
                      let demanded = run SourcePolicy.conjunction(&mut builder.rules, &needed, none)
                      run List<SourceAtom>.append(&mut gaps, run sourceTargetGeometry(&geometry[lent.loan], root, locals.length, demanded, &mut builder.rules))
                    }
                    let places = List<SourceGeometryPlace>.asSlice(&geometry[lent.loan].alternatives)
                    let mut placed = usize.ZERO
                    while placed < places.length {
                      let targetPlace = &places[placed]
                      if loan.exclusive && targetPlace.place.root < locals.length && root == targetPlace.place.root {
                        let different = run sourceDifferentRoot(&geometry[incoming.loan], targetPlace.place.root, &mut builder.rules)
                        let gates: [SourceAtom; 3] = [active, targetPlace.active, different]
                        let placedActive = run SourcePolicy.conjunction(&mut builder.rules, &gates, none)
                        let ty = localType(locals, root)
                        let mut named = List<Shared<Lifetime>>.make()
                        run Type.regionAtoms(&ty, &mut named)
                        if run retains(&ty, owner) {
                          let cases = List<SourceCarryCase>.asSlice(&lent.cases)
                          let mut which = usize.ZERO
                          while which < cases.length {
                            let record = &List<PreparedSources.Retention>.asSlice(&SourceGraphBuilder.preparation(&builder.*).retentions)[retention.index]
                            let facts = run sourceKeptSlotFacts(record, sourceSlot, targetSlot, incoming, history, lent, &cases[which],
                              loans, List<List<Step>>.asSlice(&paths.*), owner, edges, List<Shared<Lifetime>>.asSlice(&named))
                            let field = run destinationPlaceField(&record.recorded, &targetPlace.place, &mut paths.*, sourceSlotValue(lent, &cases[which]), targetSlot.slot)
                            let decision = run sourceKeptSlotDecision(facts, history, &cases[which], placedActive, exclusion, &mut builder.rules)
                            run List<SourceAtom>.append(&mut gaps, decision.missing)
                            if Shared<Type>.with<bool>(&ty, referenceType) {
                              // The legacy reference-holder branch never publishes a store.
                              // A positive prewrite holding refuses; absent source coverage is
                              // recorded below rather than inferred from an empty loan list.
                              let held = run sourceReferenceHeld(&mut builder.*, candidate.holder)
                              let holds: [SourceAtom; 2] = [decision.eligible, held.present]
                              let refused: [SourceAtom; 2] = [effects.refusal, run SourcePolicy.conjunction(&mut builder.rules, &holds, none)]
                              effects.refusal = run SourcePolicy.disjunction(&mut builder.rules, &refused)
                              let unknown: [SourceAtom; 2] = [decision.eligible, held.missing]
                              run List<SourceAtom>.append(&mut gaps, run SourcePolicy.conjunction(&mut builder.rules, &unknown, none))
                            } else {
                              let disposition = sourceCopiedDisposition(sourceDisposition(&builder.*, history.source.definition))
                              if run sourceWriteMatches(&builder.*, candidate, field, disposition, &mut paths.*) {
                                run List<SourceAtom>.append(&mut kept, decision.eligible)
                              } else if !run sourceWriteCovered(&builder.*, candidate, field, disposition, &mut paths.*) {
                                run List<SourceAtom>.append(&mut gaps, decision.eligible)
                              }
                            }
                            which = which + usize.ONE
                          }
                        }
                      }
                      placed = placed + usize.ONE
                    }
                    target = target + usize.ONE
                  }
                }
                each = each + usize.ONE
              }
            }
            position = position + usize.ONE
          }
          let unmatched: [SourceAtom; 1] = [present]
          let missing = SourceProgram.atom(&mut builder.rules)
          run SourceProgram.rule(&mut builder.rules, missing, &unmatched, List<SourceAtom>.asSlice(&matched))
          run List<SourceAtom>.append(&mut gaps, missing)
        }
        let accepted = run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&kept))
        // Store indirection changes directness only. It does not make an Exact loan Stored.
        run SourceGraphBuilder.bindPolicy(&mut builder.*, port.id, accepted, no, no)
        let portMissing = run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&gaps))
        let missing: [SourceAtom; 2] = [effects.missing, portMissing]
        effects.missing = run SourcePolicy.disjunction(&mut builder.rules, &missing)
        if !listsIndex(List<usize>.asSlice(&used.*), candidate.holder) { run List<usize>.append(&mut used.*, candidate.holder) }
      }
    }
    policy = policy + usize.ONE
  }
  // Demand the exact request's exhaustive coverage only for possible destinations.
  // A complete shared-only observation is not a writable holder. Missing source or
  // geometry evidence remains a demand; an empty candidate family proves nothing.
  let mut at = usize.ZERO
  while at < SourceGraphBuilder.retainedRequests(&builder.*).length {
    let requests = SourceGraphBuilder.retainedRequests(&builder.*)
    let status = SourceGraphBuilder.retainedStatus(&builder.*)[at]
    if requests[at].operation == operation {
      let active = requests[at].active
      let evaluation = requests[at].operand
      let retention = requests[at].retention
      let inventory = &List<SourceStores.Operation>.asSlice(&SourceGraphBuilder.stores(&builder.*).operations)[operation]
      let input = &List<SourceStores.Input>.asSlice(&inventory.inputs)[requests[at].input]
      let ordinal = input.operand
      let slot = List<SourceStores.Slot>.asSlice(&input.slots)[requests[at].slot].slot
      let mut selected = Option<SourceOperand>.none()
      let actual = List<SourceOperand>.asSlice(&operands)
      let mut index = usize.ZERO
      while index < actual.length {
        if actual[index].ordinal == ordinal && actual[index].evaluation.index == evaluation.index {
          if let Option<SourceOperand>.Some {..} = selected { return CompilerBug.panic(b"retained demand repeated its actual operand") }
          selected = Option<SourceOperand>.some(actual[index])
        }
        index = index + usize.ONE
      }
      let operand = match selected { Option<SourceOperand>.Some {value} => value
        _ => { return CompilerBug.panic(b"retained demand lost its actual operand") } }
      let destination = run sourceDestinationDemand(&mut builder.*, &observation, operand,
        SourceDestinationPolicy.Retained {retention: retention, slot: slot}, loans, geometry, locals.length,
        List<List<Step>>.asSlice(&paths.*))
      let required: [SourceAtom; 2] = [active, destination]
      let demanded = run SourcePolicy.conjunction(&mut builder.rules, &required, none)
      let unresolved = run sourceAddressMissing(&mut builder.*, SourceGraphAddressRequest.Retained {request: at}, demanded)
      let incomplete: [SourceAtom; 2] = [demanded, status.missing]
      let structural = run SourcePolicy.conjunction(&mut builder.rules, &incomplete, none)
      let gaps: [SourceAtom; 3] = [effects.missing, unresolved, structural]
      effects.missing = run SourcePolicy.disjunction(&mut builder.rules, &gaps)
    }
    at = at + usize.ONE
  }
  return move effects
}

// Storable is a per-loan effect of an already encountered construction. Authenticate that
// capture's original source snapshot; later constructions cannot affect an earlier call.
effect fn sourceStorable<'body>(builder: &mut SourceGraphBuilder<'body>, loan: usize,
  captures: &[SourceCaptureEffect]) -> SourceCallerEvidence ! OutOfMemoryError ? &mut Allocator {
  let mut present = List<SourceAtom>.make()
  let mut missing = List<SourceAtom>.make()
  let mut at = usize.ZERO
  while at < captures.length {
    if captures[at].source.loan == loan {
      let evidence = run sourceCallerEvidence(&mut builder.*, captures[at].source, captures[at].storable)
      run List<SourceAtom>.append(&mut present, evidence.present)
      run List<SourceAtom>.append(&mut missing, evidence.missing)
    }
    at = at + usize.ONE
  }
  return SourceCallerEvidence {
    present: run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&present)),
    missing: run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&missing))}
}

// The body of an invoked callable can store its environment through an exclusive body
// holder. This is independent of declared KeptSlots. Every candidate is an actual reserved
// indirect write to one opaque whole-owner summary, never a physical field approximation.
struct SourceInvocationOperand {
  operand: SourceOperand
  read: PreparedSourcesInputRead
  usePoint: SourceControl.PointId
  receiver: bool
}
impl Copy for SourceInvocationOperand {}

effect fn sourceInvocationOperand(values: &mut List<SourceInvocationOperand>, value: SourceInvocationOperand)
  -> () ! OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  let previous = List<SourceInvocationOperand>.asSlice(&values.*)
  while at < previous.length {
    if previous[at].operand.ordinal == value.operand.ordinal && previous[at].operand.root.index == value.operand.root.index {
      if previous[at].operand.evaluation.index != value.operand.evaluation.index
        || previous[at].usePoint.index != value.usePoint.index || !SourceGraph.sameInputRead(previous[at].read, value.read) {
        return CompilerBug.panic(b"invocation input routes disagree on an actual physical occurrence")
      }
      return ()
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < previous.length && previous[at].operand.ordinal <= value.operand.ordinal { at = at + usize.ONE }
  run List<SourceInvocationOperand>.insert(&mut values.*, at, value)
  return ()
}

// Store sources are the current runtime input/receiver, even when finish used the original
// arguments of an immediately executed Effect. No creation/current source identity is assumed.
effect fn sourceInvocationOperands<'body>(builder: &SourceGraphBuilder<'body>, operation: usize)
  -> List<SourceInvocationOperand> ! OutOfMemoryError ? &mut Allocator {
  let prepared = SourceGraphBuilder.preparation(builder)
  let actual = &List<SourceResults.Operation>.asSlice(&SourceGraphBuilder.operationResults(builder).operations)[operation]
  let routes = List<PreparedSources.InputRoute>.asSlice(&List<PreparedSources.Operation>.asSlice(&prepared.operations)[actual.prepared].inputs)
  let maps = List<PreparedSources.SelectionMap>.asSlice(&prepared.maps)
  let inputs = List<SourceResults.Input>.asSlice(&actual.inputs)
  let mut result = List<SourceInvocationOperand>.make()
  let mut at = usize.ZERO
  while at < inputs.length {
    let selected = inputs[at]
    let route = &routes[selected.route]
    run sourceInvocationOperand(&mut result, SourceInvocationOperand {
      operand: SourceOperand {node: selected.actual.node, evaluation: selected.actual.evaluation,
        root: maps[route.map.index].source, ordinal: selected.position}, read: route.read,
      usePoint: selected.actual.usePoint, receiver: SourceGraph.sameInputRead(route.read, PreparedSourcesInputRead.Receiver)})
    at = at + usize.ONE
  }
  if let Option<SourceResults.Receiver>.Some {value} = &actual.receiver {
    run sourceInvocationOperand(&mut result, SourceInvocationOperand {
      operand: SourceOperand {node: value.actual.node, evaluation: value.actual.evaluation,
        root: value.endpoint, ordinal: value.position}, read: PreparedSourcesInputRead.Receiver,
      usePoint: value.actual.usePoint, receiver: true})
  }
  return move result
}

// An invocation needs destination address evidence only if its original store policy
// can receive a distinct storable loan there. This uses the current operand histories,
// before any candidate admission; absent aliases or write ports never prove absence.
effect fn sourceInvocationDestinationDemand<'body>(builder: &mut SourceGraphBuilder<'body>,
  observation: &SourceObservation, operand: SourceOperand, current: &[SourceInvocationOperand],
  environmentOnly: bool, execute: SourceControl.PointId, captures: &[SourceCaptureEffect],
  loans: &[Loan], geometry: &[SourceLoanGeometry], owners: &[SourceVisit.Owner], locals: &[Local],
  owner: &DeclarationId, paths: &mut List<List<Step>>) -> SourceAtom
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let destination = run sourceDestinationDemand(&mut builder.*, observation, operand,
    SourceDestinationPolicy.CallBody, loans, geometry, locals.length, List<List<Step>>.asSlice(&paths.*))
  let empty = List<SourceAtom>.make()
  let none = List<SourceAtom>.asSlice(&empty)
  let mut choices = List<SourceAtom>.make()
  run List<SourceAtom>.append(&mut choices, observation.unknown)
  let positions = List<SourceCarryPosition>.asSlice(&observation.positions)
  let mut target = usize.ZERO
  while target < positions.length {
    let lent = &positions[target]
    if lent.operand == operand.ordinal && lent.root.index == operand.root.index
      && SourceGraphBuilder.value(&builder.*, lent.value).evaluation.index == operand.evaluation.index
      && loans[lent.loan].exclusive {
      let targetHistories = List<SourceCarryCase>.asSlice(&lent.cases)
      let mut targetPresence = List<SourceAtom>.make()
      let mut history = usize.ZERO
      while history < targetHistories.length {
        run List<SourceAtom>.append(&mut targetPresence, targetHistories[history].source.quality.present)
        let unresolved: [SourceAtom; 2] = [targetHistories[history].source.quality.present, geometry[lent.loan].missing]
        run List<SourceAtom>.append(&mut choices, run SourcePolicy.conjunction(&mut builder.rules, &unresolved, none))
        history = history + usize.ONE
      }
      let targetPresent = run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&targetPresence))
      let alternatives = List<SourceGeometryPlace>.asSlice(&geometry[lent.loan].alternatives)
      let mut placed = usize.ZERO
      while placed < alternatives.length {
        let place = &alternatives[placed]
        if place.place.root < locals.length {
          let ty = localType(locals, place.place.root)
          if run retains(&ty, owner) {
            let mut source = usize.ZERO
            while source < positions.length {
              let incoming = &positions[source]
              let mut admitted = List<SourceAtom>.make()
              let mut input = usize.ZERO
              while input < current.length {
                let selected = current[input]
                if selected.operand.ordinal == incoming.operand && selected.operand.root.index == incoming.root.index
                  && selected.operand.evaluation.index == SourceGraphBuilder.value(&builder.*, incoming.value).evaluation.index {
                  if !environmentOnly {
                    run List<SourceAtom>.append(&mut admitted, run sourceBoolean(&mut builder.rules, true))
                  } else if selected.receiver {
                    let outside = run sourceReceiverOutside(&mut builder.*, selected.operand, execute,
                      &geometry[incoming.loan], owners, &mut paths.*)
                    run List<SourceAtom>.append(&mut admitted, outside.present)
                    run List<SourceAtom>.append(&mut admitted, outside.missing)
                  }
                }
                input = input + usize.ONE
              }
              let environment = run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&admitted))
              let storable = run sourceStorable(&mut builder.*, incoming.loan, captures)
              let storage: [SourceAtom; 2] = [storable.present, storable.missing]
              let possible = run SourcePolicy.disjunction(&mut builder.rules, &storage)
              let different = run sourceDifferentRoot(&geometry[incoming.loan], place.place.root, &mut builder.rules)
              let roots: [SourceAtom; 2] = [different, geometry[incoming.loan].missing]
              let distinct = run SourcePolicy.disjunction(&mut builder.rules, &roots)
              let sources = List<SourceCarryCase>.asSlice(&incoming.cases)
              // The history pair contributes only these independent positive presences.
              // Factor their disjunctions before the shared guards instead of reserving
              // the same guarded conjunction for every Cartesian pair.
              let mut sourcePresence = List<SourceAtom>.make()
              let mut each = usize.ZERO
              while each < sources.length {
                run List<SourceAtom>.append(&mut sourcePresence, sources[each].source.quality.present)
                each = each + usize.ONE
              }
              let sourcePresent = run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&sourcePresence))
              let gates: [SourceAtom; 6] = [targetPresent, place.active, sourcePresent, environment, possible, distinct]
              run List<SourceAtom>.append(&mut choices, run SourcePolicy.conjunction(&mut builder.rules, &gates, none))
              source = source + usize.ONE
            }
          }
        }
        placed = placed + usize.ONE
      }
    }
    target = target + usize.ONE
  }
  let required: [SourceAtom; 2] = [destination,
    run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&choices))]
  return run SourcePolicy.conjunction(&mut builder.rules, &required, none)
}

effect fn sourceThroughExclusive<'body>(builder: &mut SourceGraphBuilder<'body>, evaluation: SourceGraph.EvalId,
  state: &mut SourceLoanState, captures: &[SourceCaptureEffect],
  loans: &[Loan], geometry: &[SourceLoanGeometry], owners: &[SourceVisit.Owner], locals: &[Local], owner: &DeclarationId, paths: &mut List<List<Step>>,
  used: &mut List<usize>, effects: &mut SourceStoreEffects) -> ()
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let no = SourceProgram.atom(&mut builder.rules)
  let mut operation = usize.MAX
  let operations = List<SourceResults.Operation>.asSlice(&SourceGraphBuilder.operationResults(&builder.*).operations)
  let mut at = usize.ZERO
  while at < operations.length {
    if operations[at].evaluation.index == evaluation.index {
      if operation != usize.MAX { return CompilerBug.panic(b"invocation policy has duplicate actual operations") }
      operation = at
    }
    at = at + usize.ONE
  }
  if operation == usize.MAX { return CompilerBug.panic(b"invocation policy lost its actual operation") }
  let actual = &List<SourceResults.Operation>.asSlice(&SourceGraphBuilder.operationResults(&builder.*).operations)[operation]
  let execute = actual.execute
  let environmentOnly = match &actual.plan {
    SourceResultsPlan.NamedInvoke {..} => false
    SourceResultsPlan.CallableInvoke {..} => true
    SourceResultsPlan.ExecuteEffect {..} => true
    SourceResultsPlan.PrepareEffect {..} => { return CompilerBug.panic(b"construction acquired invocation store policy") }
  }
  // This operation-wide mode is identical for every incoming position and port.
  // Keep its truth separate from each receiver's actual outside evidence below.
  let environmentBase = run sourceBoolean(&mut builder.rules, !environmentOnly)
  let selected = run sourceInvocationOperands(&builder.*, operation)
  let mut operands = List<SourceOperand>.make()
  let current = List<SourceInvocationOperand>.asSlice(&selected)
  at = usize.ZERO
  while at < current.length {
    run List<SourceOperand>.append(&mut operands, current[at].operand)
    at = at + usize.ONE
  }
  let observation = run sourceObserve(&mut builder.*, List<SourceOperand>.asSlice(&operands),
    SourceGraphValuePhase.Output, &mut paths.*, loans.length, false, Option<usize>.none())
  let reached = List<SourceControl.Point>.asSlice(&builder.reaching.points)[execute.index].reachable
  // This imports current Q into the current prefix P only. It performs no finish,
  // keepCarried judgment, result publication, or additional operand evaluation.
  drop run sourceBarrier(&observation, &mut state.*, reached, &mut builder.rules)
  let empty = List<SourceAtom>.make()
  let none = List<SourceAtom>.asSlice(&empty)
  let unknown: [SourceAtom; 2] = [reached, observation.unknown]
  let inputMissing = run SourcePolicy.conjunction(&mut builder.rules, &unknown, none)
  let gaps: [SourceAtom; 2] = [effects.missing, inputMissing]
  effects.missing = run SourcePolicy.disjunction(&mut builder.rules, &gaps)
  let positions = List<SourceCarryPosition>.asSlice(&observation.positions)
  let mut descriptors = run sourceAddressObservations(SourceGraphBuilder.invocationAddresses(&builder.*).length)
  let count = SourceGraphBuilder.policyCount(&builder.*)
  let mut policy = usize.ZERO
  while policy < count {
    let port = SourceGraphBuilder.policy(&builder.*, policy)
    if let SourceGraphTransferAuthority.InvocationWrite {candidate: id} = port.authority {
      let candidate = SourceGraphBuilder.invocationWrite(&builder.*, id)
      if candidate.operation == operation {
        let policyCases = run SourceGraphBuilder.policyCases(&builder.*, port.id)
        let projected = run sourcePolicyObservation(&mut builder.*, port.id, Option<usize>.none())
        let address = SourceGraphBuilder.invocationAddresses(&builder.*)[candidate.address]
        let request = &SourceGraphBuilder.invocationRequests(&builder.*)[address.request]
        let selected = List<PreparedSources.Selection>.asSlice(&SourceGraphBuilder.preparation(&builder.*).selections)[request.selection.index].root
        let actual = SourceGraphBuilder.evaluation(&builder.*, request.operand)
        let node = match actual.site { SourceGraphEvaluationSite.Node {node} => node
          _ => { return CompilerBug.panic(b"invocation descriptor lost its actual operand") } }
        let operand = SourceOperand {node: node, evaluation: request.operand, root: selected, ordinal: usize.MAX}
        let holder = SourceGraphBuilder.writeHolder(&builder.*, candidate.holder)
        let summary = &SourceGraphBuilder.summaries(&builder.*)[candidate.summary]
        let summaryDisposition = summary.disposition
        if port.terminal || port.outputDirect || port.source.index != candidate.source.index
          || port.target.index != candidate.target.index || !sourceUnknownPlacement(summary.placement)
          || !sourceSameStorage(summary.prefix, holder.storage) || holder.execution.index != request.execution.index {
          return CompilerBug.panic(b"invocation body policy changed its actual opaque write")
        }
        let root = match &List<PreparedSources.Endpoint>.asSlice(&SourceGraphBuilder.preparation(&builder.*).endpoints)[holder.storage.endpoint.index].root {
          PreparedSourcesRoot.Local {local, category: endpointCategory} if endpointCategory == PreparedSourcesEndpointRole.Storage => local.index
          _ => usize.MAX
        }
        let gates: [SourceAtom; 4] = [port.active, candidate.active, address.active, projected.quality.present]
        let present = run SourcePolicy.conjunction(&mut builder.rules, &gates, none)
        let mut kept = List<SourceAtom>.make()
        let mut gaps = List<SourceAtom>.make()
        let mut matched = List<SourceAtom>.make()
        let mut borrowed = false
        match &SourceGraphBuilder.leaf(&builder.*, port.leaf).kind {
          SourceGraphSourceLeaf.Borrow {..} => { borrowed = true }
          SourceGraphSourceLeaf.Entry {..} => ()
          SourceGraphSourceLeaf.Expression {..} => ()
          SourceGraphSourceLeaf.LoanFree {..} => ()
          SourceGraphSourceLeaf.Unknown {..} => { run List<SourceAtom>.append(&mut gaps, present) }
        }
        if borrowed {
          let descriptorId = run sourceStoredDescriptor(&mut builder.*, &mut descriptors, candidate.address, SourceDescriptorCase {
            category: address.category, descriptor: address.descriptor, leaf: address.leaf, definition: address.definition,
            read: address.read, direct: address.direct, active: address.active}, operand, &mut paths.*, loans.length)
          let descriptor = &List<SourceObservation>.asSlice(&descriptors.observations)[descriptorId]
          let targets = List<SourceCarryPosition>.asSlice(&descriptor.positions)
          let unresolved: [SourceAtom; 2] = [present, descriptor.unknown]
          run List<SourceAtom>.append(&mut gaps, run SourcePolicy.conjunction(&mut builder.rules, &unresolved, none))
          let mut position = usize.ZERO
          while position < positions.length {
            let incoming = &positions[position]
            let mut actualInput = false
            let mut environment = environmentBase
            let mut input = usize.ZERO
            while input < current.length {
              let selected = current[input]
              if selected.operand.ordinal == incoming.operand && selected.operand.root.index == incoming.root.index
                && selected.operand.evaluation.index == candidate.operand.index
                && selected.usePoint.index == candidate.usePoint.index && SourceGraph.sameInputRead(selected.read, candidate.read) {
                actualInput = true
                if environmentOnly && selected.receiver {
                  let outside = run sourceReceiverOutside(&mut builder.*, selected.operand, execute,
                    &geometry[incoming.loan], owners, &mut paths.*)
                  environment = outside.present
                  let unknown: [SourceAtom; 2] = [present, outside.missing]
                  run List<SourceAtom>.append(&mut gaps, run SourcePolicy.conjunction(&mut builder.rules, &unknown, none))
                }
              }
              input = input + usize.ONE
            }
            if incoming.value.index == port.source.index && incoming.leaf.index == port.leaf.index
              && actualInput
              && SourceGraphBuilder.value(&builder.*, incoming.value).evaluation.index == candidate.operand.index {
              let histories = List<SourceCarryCase>.asSlice(&incoming.cases)
              let mut each = usize.ZERO
              while each < histories.length {
                let history = &histories[each]
                if history.source.category == port.category && history.source.direct == port.direct && sourceDefinitionMatches(history.source.definition, port.definition)
                  && sourceReadMatches(history.source.read, port.read)
                  && sourcePolicyCase(List<SourceGraph.InputCase>.asSlice(&policyCases), &history.source) {
                  run List<SourceAtom>.append(&mut matched, history.source.quality.present)
                  let storable = run sourceStorable(&mut builder.*, incoming.loan, captures)
                  let unknown: [SourceAtom; 3] = [present, history.source.quality.present, storable.missing]
                  run List<SourceAtom>.append(&mut gaps, run SourcePolicy.conjunction(&mut builder.rules, &unknown, none))
                  let mut target = usize.ZERO
                  while target < targets.length {
                    let lent = &targets[target]
                    let loan = &loans[lent.loan]
                    if loan.exclusive {
                      let needed: [SourceAtom; 4] = [present, history.source.quality.present, lent.quality.present, environment]
                      let demanded = run SourcePolicy.conjunction(&mut builder.rules, &needed, none)
                      run List<SourceAtom>.append(&mut gaps, run sourceTargetGeometry(&geometry[lent.loan], root, locals.length, demanded, &mut builder.rules))
                    }
                    let places = List<SourceGeometryPlace>.asSlice(&geometry[lent.loan].alternatives)
                    let mut placed = usize.ZERO
                    while placed < places.length {
                      let targetPlace = &places[placed]
                      if loan.exclusive && targetPlace.place.root < locals.length && root == targetPlace.place.root {
                        let different = run sourceDifferentRoot(&geometry[incoming.loan], targetPlace.place.root, &mut builder.rules)
                        let cases = List<SourceCarryCase>.asSlice(&lent.cases)
                        let mut which = usize.ZERO
                        while which < cases.length {
                          let guards: [SourceAtom; 7] = [present, history.source.quality.present, storable.present, cases[which].source.quality.present,
                            environment, targetPlace.active, different]
                          let eligible = run SourcePolicy.conjunction(&mut builder.rules, &guards, none)
                          let ty = localType(locals, root)
                          if run retains(&ty, owner) {
                            if Shared<Type>.with<bool>(&ty, referenceType) {
                              let held = run sourceReferenceHeld(&mut builder.*, candidate.holder)
                              let holds: [SourceAtom; 2] = [eligible, held.present]
                              let refused: [SourceAtom; 2] = [effects.refusal, run SourcePolicy.conjunction(&mut builder.rules, &holds, none)]
                              effects.refusal = run SourcePolicy.disjunction(&mut builder.rules, &refused)
                              let unknown: [SourceAtom; 2] = [eligible, held.missing]
                              run List<SourceAtom>.append(&mut gaps, run SourcePolicy.conjunction(&mut builder.rules, &unknown, none))
                            } else if summaryDisposition == sourceCopiedDisposition(sourceDisposition(&builder.*, history.source.definition)) {
                              run List<SourceAtom>.append(&mut kept, eligible)
                            }
                          }
                          which = which + usize.ONE
                        }
                      }
                      placed = placed + usize.ONE
                    }
                    target = target + usize.ONE
                  }
                }
                each = each + usize.ONE
              }
            }
            position = position + usize.ONE
          }
          let absent = SourceProgram.atom(&mut builder.rules)
          let required: [SourceAtom; 1] = [present]
          run SourceProgram.rule(&mut builder.rules, absent, &required, List<SourceAtom>.asSlice(&matched))
          run List<SourceAtom>.append(&mut gaps, absent)
        }
        let accepted = run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&kept))
        run SourceGraphBuilder.bindPolicy(&mut builder.*, port.id, accepted, no, no)
        let missing: [SourceAtom; 2] = [effects.missing, run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&gaps))]
        effects.missing = run SourcePolicy.disjunction(&mut builder.rules, &missing)
        if !listsIndex(List<usize>.asSlice(&used.*), candidate.holder) { run List<usize>.append(&mut used.*, candidate.holder) }
      }
    }
    policy = policy + usize.ONE
  }
  // Body-store destinations use the current invocation operand, including a Run's
  // current receiver. Original capture arguments cannot stand in for that observation.
  at = usize.ZERO
  while at < SourceGraphBuilder.invocationRequests(&builder.*).length {
    let request = &SourceGraphBuilder.invocationRequests(&builder.*)[at]
    if request.operation == operation {
      let active = request.active
      let structural = request.missing
      let evaluation = request.operand
      let usePoint = request.usePoint
      let root = List<PreparedSources.Selection>.asSlice(&SourceGraphBuilder.preparation(&builder.*).selections)[request.selection.index].root
      let read = List<PreparedSources.InvocationView>.asSlice(&SourceGraphBuilder.preparation(&builder.*).invocationViews)[request.view].read
      let mut selected = Option<SourceOperand>.none()
      let mut index = usize.ZERO
      while index < current.length {
        let input = current[index]
        if input.operand.evaluation.index == evaluation.index && input.operand.root.index == root.index
          && input.usePoint.index == usePoint.index && SourceGraph.sameInputRead(input.read, read) {
          if let Option<SourceOperand>.Some {..} = selected { return CompilerBug.panic(b"invocation demand repeated its actual operand") }
          selected = Option<SourceOperand>.some(input.operand)
        }
        index = index + usize.ONE
      }
      let operand = match selected { Option<SourceOperand>.Some {value} => value
        _ => { return CompilerBug.panic(b"invocation demand lost its actual operand") } }
      let destination = run sourceInvocationDestinationDemand(&mut builder.*, &observation, operand,
        current, environmentOnly, execute, captures, loans, geometry, owners, locals, owner, &mut paths.*)
      let required: [SourceAtom; 2] = [active, destination]
      let demanded = run SourcePolicy.conjunction(&mut builder.rules, &required, none)
      let coverage = run sourceAddressMissing(&mut builder.*, SourceGraphAddressRequest.Invocation {request: at}, demanded)
      let incomplete: [SourceAtom; 2] = [demanded, structural]
      let missing = run SourcePolicy.conjunction(&mut builder.rules, &incomplete, none)
      let gaps: [SourceAtom; 3] = [effects.missing, coverage, missing]
      effects.missing = run SourcePolicy.disjunction(&mut builder.rules, &gaps)
    }
    at = at + usize.ONE
  }
  return ()
}

// This lookup reads the sole emitted reaching relation. A missing pair is not a proof of
// absence, and allocation order says nothing about whether a definition supplied a read.
fn sourceFlowPair(control: &SourceControlReaching, definition: SourceControl.DefinitionId,
  read: SourceControl.ReadId) -> Option<SourceAtom> {
  let pairs = List<SourceControl.Pair>.asSlice(&control.pairs)
  let mut selected = Option<SourceAtom>.none()
  let mut at = usize.ZERO
  while at < pairs.length {
    if pairs[at].definition.index == definition.index && pairs[at].read.index == read.index {
      if let Option<SourceAtom>.Some {..} = selected {
        return CompilerBug.panic(b"caller source has duplicate structural definition/read pairs")
      }
      selected = Option<SourceAtom>.some(pairs[at].active)
    }
    at = at + usize.ONE
  }
  return selected
}

// A private index over the already-reserved pair rows, not another reaching relation.
// Bucket chains retain original row order; duplicate validation remains at lookup.
struct SourceFlowPairIndex {
  heads: List<usize>
  next: List<usize>
}

fn sourceFlowPairBucket(definition: SourceControl.DefinitionId, read: SourceControl.ReadId, width: usize) -> usize {
  let left = usize.wrappingMultiply(definition.index, 2654435761)
  let right = usize.wrappingMultiply(read.index, 2246822519)
  return usize.bitXor(left, right) % width
}

effect fn sourceFlowPairIndex(control: &SourceControlReaching) -> SourceFlowPairIndex
! OutOfMemoryError ? &mut Allocator {
  let pairs = List<SourceControl.Pair>.asSlice(&control.pairs)
  let width = pairs.length * 2 + usize.ONE
  let mut result = SourceFlowPairIndex {heads: List<usize>.make(), next: List<usize>.make()}
  let mut at = usize.ZERO
  while at < width {
    run List<usize>.append(&mut result.heads, usize.MAX)
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < pairs.length {
    run List<usize>.append(&mut result.next, usize.MAX)
    at = at + usize.ONE
  }
  // Prepending in reverse preserves the full scan's original pair order, including
  // duplicates. Do not validate or discard any row merely while building the index.
  at = pairs.length
  while at > usize.ZERO {
    at = at - usize.ONE
    let bucket = sourceFlowPairBucket(pairs[at].definition, pairs[at].read, width)
    let heads = List<usize>.asMutSlice(&mut result.heads)
    let next = List<usize>.asMutSlice(&mut result.next)
    next[at] = heads[bucket]
    heads[bucket] = at
  }
  return move result
}

fn sourceIndexedFlowPair(control: &SourceControlReaching, index: &SourceFlowPairIndex,
  definition: SourceControl.DefinitionId, read: SourceControl.ReadId) -> Option<SourceAtom> {
  let pairs = List<SourceControl.Pair>.asSlice(&control.pairs)
  let heads = List<usize>.asSlice(&index.heads)
  let next = List<usize>.asSlice(&index.next)
  let mut selected = Option<SourceAtom>.none()
  let mut at = heads[sourceFlowPairBucket(definition, read, heads.length)]
  while at != usize.MAX {
    if pairs[at].definition.index == definition.index && pairs[at].read.index == read.index {
      if let Option<SourceAtom>.Some {..} = selected {
        return CompilerBug.panic(b"caller source has duplicate structural definition/read pairs")
      }
      selected = Option<SourceAtom>.some(pairs[at].active)
    }
    at = next[at]
  }
  return selected
}

effect fn sourceNewReadAncestry(rules: &mut SourceProgram) -> SourceReadAncestry ! OutOfMemoryError ? &mut Allocator {
  return SourceReadAncestry {excluded: SourceProgram.atom(&mut rules.*),
    overlapping: SourceProgram.atom(&mut rules.*), missing: SourceProgram.atom(&mut rules.*),
    other: SourceProgram.atom(&mut rules.*)}
}

effect fn sourceCarryReadAncestry(rules: &mut SourceProgram, target: SourceReadAncestry,
  source: SourceReadAncestry, active: SourceAtom) -> () ! OutOfMemoryError ? &mut Allocator {
  let excluded: [SourceAtom; 2] = [active, source.excluded]
  let overlapping: [SourceAtom; 2] = [active, source.overlapping]
  let missing: [SourceAtom; 2] = [active, source.missing]
  let other: [SourceAtom; 2] = [active, source.other]
  let empty = List<SourceAtom>.make()
  let none = List<SourceAtom>.asSlice(&empty)
  run SourceProgram.rule(&mut rules.*, target.excluded, &excluded, none)
  run SourceProgram.rule(&mut rules.*, target.overlapping, &overlapping, none)
  run SourceProgram.rule(&mut rules.*, target.missing, &missing, none)
  run SourceProgram.rule(&mut rules.*, target.other, &other, none)
  return ()
}

// Authenticate the acquisition Case itself. B is the selected place in the original
// holder, before its first Referent; the component read is A, not the read marker B.
// The carried Referent suffix is a later placement and must not enter this predicate.
effect fn sourceReferenceReadExclusion<'body>(builder: &SourceGraphBuilder<'body>,
  edge: SourceGraph.CaseView, ordinal: usize, paths: &mut List<List<Step>>) -> Option<bool>
! OutOfMemoryError ? &mut Allocator {
  let candidate = SourceGraphBuilder.referenceHoldings(builder)[ordinal]
  let reading = SourceGraphBuilder.referenceReads(builder)[candidate.referenceRead]
  let observation = SourceGraphBuilder.referenceObservations(builder)[candidate.observation]
  let previous = match edge.source { Option<SourceGraph.CellView>.Some {value} => value
    _ => { return CompilerBug.panic(b"reference read attribution has no original acquisition Case") } }
  let target = edge.target
  if candidate.observation != reading.observation || candidate.reference != observation.reference
    || candidate.source.index != reading.value.index || previous.value.index != candidate.source.index
    || target.value.index != candidate.target.index || target.category != SourceGraphSourceRole.Ownership
    || previous.leaf.index != target.leaf.index
    || !sourceDefinitionMatches(previous.definition, target.definition)
    || !sourceReadMatches(previous.read, target.read) {
    return CompilerBug.panic(b"reference read attribution changed its actual source history")
  }
  let definition = match previous.definition { Option<SourceControl.DefinitionId>.Some {value} => value
    _ => { return Option<bool>.none() } }
  let read = match previous.read { Option<SourceControl.ReadId>.Some {value} => value
    _ => { return Option<bool>.none() } }
  let mut exact = read.index == reading.read.index
  let summaries = SourceGraphBuilder.summaryReads(builder)
  let mut at = usize.ZERO
  while at < summaries.length {
    if summaries[at].original.index == reading.read.index && summaries[at].read.index == read.index { exact = true }
    at = at + usize.ONE
  }
  if !exact { return CompilerBug.panic(b"reference read attribution substituted another acquisition read") }
  let written = SourceGraphBuilder.definition(builder, definition)
  let requested = SourceGraphBuilder.read(builder, read)
  if !sourceSameReadLane(written, requested) { return Option<bool>.none() }
  let endpoints = List<PreparedSources.Endpoint>.asSlice(&SourceGraphBuilder.preparation(builder).endpoints)
  let owner = match sourceStorageRoot(endpoints, written.storage) {
    Option<SourceGraph.Storage>.Some {value} => value
    _ => { return Option<bool>.none() }
  }
  if !sourceSameStorage(owner, observation.owner) { return Option<bool>.none() }
  let mut held = SourceReadField {supported: true, field: usize.MAX}
  match written.summary {
    Option<usize>.Some {value} => {
      held = run sourceOwnershipField(builder, owner.endpoint,
        SourceGraphBuilder.summaries(builder)[value].placement, &mut paths.*)
    }
    _ => {
      let field = run sourceField(endpoints, owner.endpoint, written.storage.endpoint, &mut paths.*)
      held = SourceReadField {supported: field != usize.MAX, field: field}
    }
  }
  let used = run sourceField(endpoints, owner.endpoint, observation.storage.endpoint, &mut paths.*)
  if !held.supported || used == usize.MAX { return Option<bool>.none() }
  // An authenticated semantic MAX cannot prove sibling exclusion. This is not a
  // fallback for a missing path: sourceOwnershipField explicitly marked it supported.
  if held.field == usize.MAX { return Option<bool>.some(false) }
  let all = List<List<Step>>.asSlice(&paths.*)
  return Option<bool>.some(excludedTransferPaths(List<Step>.asSlice(&all[held.field]), List<Step>.asSlice(&all[used])))
}

// Build once over immutable Case/cell identities, before policy dispatch. Only histories
// naming actual acquisition reads need this additional attribution. Local read boundaries
// stop propagation; unsupported predecessors stay separate from a grounded alternative.
effect fn sourceReadAncestries<'body>(builder: &mut SourceGraphBuilder<'body>, paths: &mut List<List<Step>>)
  -> SourceReadAncestries ! OutOfMemoryError ? &mut Allocator {
  let mut reads = List<bool>.make()
  let mut at = usize.ZERO
  while at < SourceGraphBuilder.readCount(&builder.*) {
    run List<bool>.append(&mut reads, false)
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < SourceGraphBuilder.referenceReads(&builder.*).length {
    let read = SourceGraphBuilder.referenceReads(&builder.*)[at].read
    let mut selected = List<bool>.asMutSlice(&mut reads)
    selected[read.index] = true
    at = at + usize.ONE
  }
  if true {
    let summaries = SourceGraphBuilder.summaryReads(&builder.*)
    at = usize.ZERO
    while at < summaries.length {
      if List<bool>.asSlice(&reads)[summaries[at].original.index] {
        let mut selected = List<bool>.asMutSlice(&mut reads)
        selected[summaries[at].read.index] = true
      }
      at = at + usize.ONE
    }
  }
  let count = SourceGraphBuilder.caseCount(&builder.*)
  let mut result = SourceReadAncestries {indices: List<usize>.make(), cases: List<SourceReadAncestry>.make()}
  let mut cellIndices = List<usize>.make()
  let mut joined = List<SourceReadAncestry>.make()
  at = usize.ZERO
  while at < count {
    let edge = SourceGraphBuilder.case(&builder.*, at)
    let mut selected = false
    if let Option<SourceControl.ReadId>.Some {value} = edge.target.read {
      selected = List<bool>.asSlice(&reads)[value.index]
    }
    let borrowed = match &SourceGraphBuilder.leaf(&builder.*, edge.target.leaf).kind {
      SourceGraphSourceLeaf.Borrow {..} => true
      _ => false
    }
    if borrowed {
      if selected {
        while List<usize>.length(&cellIndices) <= edge.target.id {
          run List<usize>.append(&mut cellIndices, usize.MAX)
        }
        if List<usize>.asSlice(&cellIndices)[edge.target.id] == usize.MAX {
          let mut selectedCells = List<usize>.asMutSlice(&mut cellIndices)
          selectedCells[edge.target.id] = List<SourceReadAncestry>.length(&joined)
          run List<SourceReadAncestry>.append(&mut joined, run sourceNewReadAncestry(&mut builder.rules))
        }
      }
    } else { selected = false }
    let mut index = usize.MAX
    if selected {
      index = List<SourceReadAncestry>.length(&result.cases)
      run List<SourceReadAncestry>.append(&mut result.cases, run sourceNewReadAncestry(&mut builder.rules))
    }
    run List<usize>.append(&mut result.indices, index)
    at = at + usize.ONE
  }
  let pairs = run sourceFlowPairIndex(&builder.reaching)
  let empty = List<SourceAtom>.make()
  let none = List<SourceAtom>.asSlice(&empty)
  at = usize.ZERO
  while at < count {
    let index = List<usize>.asSlice(&result.indices)[at]
    if index != usize.MAX {
      let edge = SourceGraphBuilder.case(&builder.*, at)
      let row = List<SourceReadAncestry>.asSlice(&result.cases)[index]
      let applies: [SourceAtom; 2] = [edge.active, SourceGraphBuilder.observationCase(&builder.*, at).semantic.present]
      let active = run SourcePolicy.conjunction(&mut builder.rules, &applies, none)
      let mut carried = false
      if let SourceGraphTransferAuthority.ReferenceHolding {candidate} = edge.authority {
        let decision = run sourceReferenceReadExclusion(&builder.*, edge, candidate, &mut paths.*)
        let mut output = row.missing
        if let Option<bool>.Some {value} = decision {
          output = row.overlapping
          if value { output = row.excluded }
        }
        let mut pair = Option<SourceAtom>.none()
        if let Option<SourceControl.DefinitionId>.Some {value: definition} = edge.target.definition {
          if let Option<SourceControl.ReadId>.Some {value: read} = edge.target.read {
            pair = sourceIndexedFlowPair(&builder.reaching, &pairs, definition, read)
          }
        }
        match pair {
          Option<SourceAtom>.Some {value} => {
            let authentic: [SourceAtom; 2] = [active, value]
            run SourceProgram.rule(&mut builder.rules, output, &authentic, none)
            let absent: [SourceAtom; 1] = [value]
            let applicable: [SourceAtom; 1] = [active]
            run SourceProgram.rule(&mut builder.rules, row.missing, &applicable, &absent)
          }
          _ => {
            let applicable: [SourceAtom; 1] = [active]
            run SourceProgram.rule(&mut builder.rules, row.missing, &applicable, none)
          }
        }
        carried = true
      } else if let Option<SourceGraph.CellView>.Some {value: previous} = edge.source {
        let boundary = match edge.definition { Option<SourceControl.DefinitionId>.Some {..} => true _ => false }
          || match edge.read { Option<SourceControl.ReadId>.Some {..} => true _ => false }
        if !boundary && previous.id < List<usize>.length(&cellIndices)
          && previous.leaf.index == edge.target.leaf.index
          && sourceDefinitionMatches(previous.definition, edge.target.definition)
          && sourceReadMatches(previous.read, edge.target.read) {
          let source = List<usize>.asSlice(&cellIndices)[previous.id]
          if source != usize.MAX {
            run sourceCarryReadAncestry(&mut builder.rules, row, List<SourceReadAncestry>.asSlice(&joined)[source], active)
            carried = true
          }
        }
      }
      if !carried {
        let applicable: [SourceAtom; 1] = [active]
        run SourceProgram.rule(&mut builder.rules, row.other, &applicable, none)
      }
      let target = List<usize>.asSlice(&cellIndices)[edge.target.id]
      run sourceCarryReadAncestry(&mut builder.rules, List<SourceReadAncestry>.asSlice(&joined)[target], row, active)
    }
    at = at + usize.ONE
  }
  return move result
}

// Read attribution revisits the same frozen consumer for many policy histories.
// Cache only its immutable input inventory; each history still checks its own witness,
// semantic Case quality, placement and applicability below.
struct SourceReadInputs {
  value: SourceGraph.ValueId
  inputs: List<SourceGraph.Input>
}

effect fn sourceReadInputs<'body>(builder: &mut SourceGraphBuilder<'body>,
  cached: &mut List<SourceReadInputs>, value: SourceGraph.ValueId) -> usize ! OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < List<SourceReadInputs>.length(&cached.*) {
    if List<SourceReadInputs>.asSlice(&cached.*)[at].value.index == value.index { return at }
    at = at + usize.ONE
  }
  let inputs = run SourceGraphBuilder.observationInputs(&mut builder.*, value)
  run List<SourceReadInputs>.append(&mut cached.*, SourceReadInputs {value: value, inputs: move inputs})
  return at
}

// A copied operand retains the original read identity. Attribute its actual Copy
// consumer or acquisition Case, never the current placement or a same-point endpoint.
effect fn sourceReadExclusion<'body>(builder: &mut SourceGraphBuilder<'body>, cached: &mut List<SourceReadInputs>, ancestry: &SourceReadAncestries, source: SourceEffectSource,
  active: SourceAtom, paths: &mut List<List<Step>>) -> SourceReadExclusion ! OutOfMemoryError ? &mut Allocator {
  let no = SourceProgram.atom(&mut builder.rules)
  let evidence = run sourceCallerEvidence(&mut builder.*, source, active)
  let definition = match source.definition {
    Option<SourceControl.DefinitionId>.Some {value} => value
    _ => {
      // A genuine unpaired creation has no prior held/read path to exclude. Its source
      // identity is still authenticated above; absent IDs alone do not prove a fresh loan.
      return SourceReadExclusion {excluded: no, missing: evidence.missing}
    }
  }
  let read = match source.read {
    Option<SourceControl.ReadId>.Some {value} => value
    _ => { return SourceReadExclusion {excluded: no, missing: active} }
  }
  if definition.index >= SourceGraphBuilder.definitionCount(&builder.*)
    || read.index >= SourceGraphBuilder.readCount(&builder.*) {
    return SourceReadExclusion {excluded: no, missing: active}
  }
  let original = SourceGraphBuilder.definition(&builder.*, definition)
  let requested = SourceGraphBuilder.read(&builder.*, read)
  let pair = match sourceFlowPair(&builder.reaching, definition, read) {
    Option<SourceAtom>.Some {value} => value
    _ => { return SourceReadExclusion {excluded: no, missing: active} }
  }
  let placements = run SourceGraphBuilder.readPlacementsByRead(&builder.*, read)
  let actual = List<SourceGraph.ReadPlacement>.asSlice(&placements)
  let empty = List<SourceAtom>.make()
  let none = List<SourceAtom>.asSlice(&empty)
  let mut covered = List<SourceAtom>.make()
  let mut excluded = List<SourceAtom>.make()
  let mut overlaps = List<SourceAtom>.make()
  let mut at = usize.ZERO
  while at < actual.length {
    let placement = actual[at]
    let consumer = SourceGraphBuilder.value(&builder.*, placement.consumer)
    if placement.read.index != read.index || consumer.phase != SourceGraphValuePhase.Input
      || consumer.evaluation.index != placement.result.index
      || SourceGraphBuilder.evaluation(&builder.*, consumer.evaluation).point.index != requested.point.index {
      return CompilerBug.panic(b"copied read attribution substituted its original consumer")
    }
    let mut held = usize.MAX
    let mut used = usize.MAX
    if true {
      let prepared = SourceGraphBuilder.preparation(&builder.*)
      let endpoints = List<PreparedSources.Endpoint>.asSlice(&prepared.endpoints)
      let maps = List<PreparedSources.SelectionMap>.asSlice(&prepared.maps)
      if placement.map.index >= maps.length || maps[placement.map.index].kind != PreparedSourcesMapKind.Copy
        || maps[placement.map.index].target.index != consumer.endpoint.index {
        return CompilerBug.panic(b"copied read attribution lost its actual final Copy")
      }
      if let Option<SourceGraph.Storage>.Some {value: from} = sourceStorageRoot(endpoints, original.storage) {
        if let Option<SourceGraph.Storage>.Some {value: to} = sourceStorageRoot(endpoints, placement.storage) {
          if sourceSameStorage(from, to) && sourcePlacementStorage(original, requested,
            SourceGraphBuilder.read(&builder.*, placement.original), placement, endpoints) {
            if let Option<usize>.Some {value: summary} = original.summary {
              let originalField = run sourceOwnershipField(&builder.*, from.endpoint,
                SourceGraphBuilder.summaries(&builder.*)[summary].placement, &mut paths.*)
              if originalField.supported { held = originalField.field }
            } else { held = run sourceField(endpoints, from.endpoint, original.storage.endpoint, &mut paths.*) }
            used = run sourceField(endpoints, to.endpoint, placement.storage.endpoint, &mut paths.*)
          }
        }
      }
    }
    if held != usize.MAX && used != usize.MAX {
      let disjoint = excludedTransferPaths(List<Step>.asSlice(&List<List<Step>>.asSlice(&paths.*)[held]),
        List<Step>.asSlice(&List<List<Step>>.asSlice(&paths.*)[used]))
      let inputIndex = run sourceReadInputs(&mut builder.*, &mut cached.*, placement.consumer)
      let inputs = List<SourceGraph.Input>.asSlice(&List<SourceReadInputs>.asSlice(&cached.*)[inputIndex].inputs)
      let mut input = usize.ZERO
      while input < inputs.length {
        if inputs[input].leaf.index == source.leaf.index {
          let histories = List<SourceGraph.InputCase>.asSlice(&inputs[input].cases)
          let mut history = usize.ZERO
          while history < histories.length {
            if histories[history].category == source.category && sourceDefinitionMatches(histories[history].definition, source.definition)
              && sourceReadMatches(histories[history].read, source.read) {
              let authentic: [SourceAtom; 4] = [evidence.present, pair, placement.active, histories[history].quality.present]
              let present = run SourcePolicy.conjunction(&mut builder.rules, &authentic, none)
              run List<SourceAtom>.append(&mut covered, present)
              if disjoint { run List<SourceAtom>.append(&mut excluded, present) }
              else { run List<SourceAtom>.append(&mut overlaps, present) }
            }
            history = history + usize.ONE
          }
        }
        input = input + usize.ONE
      }
    }
    at = at + usize.ONE
  }
  let copyCoverage = run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&covered))
  let mut inheritedMissing = no
  if source.case >= List<usize>.length(&ancestry.indices) {
    return CompilerBug.panic(b"historical read attribution lost its actual Case ordinal")
  }
  let index = List<usize>.asSlice(&ancestry.indices)[source.case]
  if index != usize.MAX {
    let row = List<SourceReadAncestry>.asSlice(&ancestry.cases)[index]
    let grounded: [SourceAtom; 2] = [row.excluded, row.overlapping]
    let known: [SourceAtom; 2] = [evidence.present, run SourcePolicy.disjunction(&mut builder.rules, &grounded)]
    run List<SourceAtom>.append(&mut covered, run SourcePolicy.conjunction(&mut builder.rules, &known, none))
    let disjoint: [SourceAtom; 2] = [evidence.present, row.excluded]
    let overlapping: [SourceAtom; 2] = [evidence.present, row.overlapping]
    run List<SourceAtom>.append(&mut excluded, run SourcePolicy.conjunction(&mut builder.rules, &disjoint, none))
    run List<SourceAtom>.append(&mut overlaps, run SourcePolicy.conjunction(&mut builder.rules, &overlapping, none))
    let unsupported: [SourceAtom; 2] = [evidence.present, row.missing]
    let other: [SourceAtom; 2] = [evidence.present, row.other]
    let copied: [SourceAtom; 1] = [copyCoverage]
    let alternatives: [SourceAtom; 2] = [
      run SourcePolicy.conjunction(&mut builder.rules, &unsupported, none),
      run SourcePolicy.conjunction(&mut builder.rules, &other, &copied),
    ]
    inheritedMissing = run SourcePolicy.disjunction(&mut builder.rules, &alternatives)
  }
  let sourcePresent: [SourceAtom; 1] = [evidence.present]
  let uncovered = run SourcePolicy.conjunction(&mut builder.rules, &sourcePresent, List<SourceAtom>.asSlice(&covered))
  let gaps: [SourceAtom; 3] = [evidence.missing, uncovered, inheritedMissing]
  let missing = run SourcePolicy.disjunction(&mut builder.rules, &gaps)
  let candidates = run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&excluded))
  let possibleOverlap = run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&overlaps))
  let positive: [SourceAtom; 1] = [candidates]
  let negative: [SourceAtom; 2] = [missing, possibleOverlap]
  return SourceReadExclusion {excluded: run SourcePolicy.conjunction(&mut builder.rules, &positive, &negative), missing: missing}
}

// Summary A and selected B share their canonical owner, but occupy different Flow
// components. The original read ID authenticates B; the summary ID authenticates A.
fn sourcePlacementStorage(definition: SourceGraph.DefinitionView, read: SourceGraph.ReadView,
  original: SourceGraph.ReadView, placement: SourceGraph.ReadPlacement,
  endpoints: &[PreparedSources.Endpoint]) -> bool {
  if !sourceSameReadLane(definition, read) || placement.read.index != read.id.index
    || placement.original.index != original.id.index || !sourceSameSummary(placement.summary, read.summary)
    || !sourceSameStorage(original.storage, placement.storage) { return false }
  if let Option<usize>.Some {..} = original.summary { return false }
  if let Option<usize>.None = read.summary {
    return original.id.index == read.id.index && sourceSameStorage(definition.storage, placement.storage)
  }
  if let Option<SourceGraph.Storage>.Some {value: held} = sourceStorageRoot(endpoints, definition.storage) {
    if let Option<SourceGraph.Storage>.Some {value: used} = sourceStorageRoot(endpoints, placement.storage) {
      return sourceSameStorage(held, used)
    }
  }
  return false
}

struct SourceReadField {
  supported: bool
  field: usize
}
impl Copy for SourceReadField {}

// The read policy excludes declared sibling fields before every Referent boundary.
// Transfer-slot exclusions are a different predicate and cannot stand in for this one.
effect fn sourceReadDisjoint<'body>(builder: &SourceGraphBuilder<'body>, definition: SourceGraph.DefinitionView,
  placement: SourceGraph.ReadPlacement, paths: &mut List<List<Step>>) -> bool ! OutOfMemoryError ? &mut Allocator {
  let summary = match definition.summary { Option<usize>.Some {value} => value _ => { return false } }
  let prepared = SourceGraphBuilder.preparation(builder)
  let endpoints = List<PreparedSources.Endpoint>.asSlice(&prepared.endpoints)
  let owner = match sourceStorageRoot(endpoints, definition.storage) {
    Option<SourceGraph.Storage>.Some {value} => value _ => { return false }
  }
  let held = run sourceOwnershipField(builder, owner.endpoint, SourceGraphBuilder.summaries(builder)[summary].placement, &mut paths.*)
  let used = run sourceField(endpoints, owner.endpoint, placement.storage.endpoint, &mut paths.*)
  if !held.supported || held.field == usize.MAX || used == usize.MAX { return false }
  let all = List<List<Step>>.asSlice(&paths.*)
  return disjointFields(List<Step>.asSlice(&all[used]), List<Step>.asSlice(&all[held.field]))
}

effect fn sourceReadAncestor<'body>(builder: &SourceGraphBuilder<'body>, definition: SourceGraph.DefinitionView,
  placement: SourceGraph.ReadPlacement, paths: &mut List<List<Step>>) -> bool ! OutOfMemoryError ? &mut Allocator {
  let summary = match definition.summary { Option<usize>.Some {value} => value _ => { return false } }
  let prepared = SourceGraphBuilder.preparation(builder)
  let endpoints = List<PreparedSources.Endpoint>.asSlice(&prepared.endpoints)
  let owner = match sourceStorageRoot(endpoints, definition.storage) {
    Option<SourceGraph.Storage>.Some {value} => value _ => { return false }
  }
  let held = run sourceOwnershipField(builder, owner.endpoint, SourceGraphBuilder.summaries(builder)[summary].placement, &mut paths.*)
  let used = run sourceField(endpoints, owner.endpoint, placement.storage.endpoint, &mut paths.*)
  if !held.supported || held.field == usize.MAX || used == usize.MAX { return false }
  let all = List<List<Step>>.asSlice(&paths.*)
  let a = List<Step>.asSlice(&all[held.field])
  let b = List<Step>.asSlice(&all[used])
  return !readContains(b, a) && pathContains(a, b)
}

struct SourceReadRelease {
  released: SourceAtom
  missing: SourceAtom
}

// A selected component cannot prove the absence of a sibling reborrow. These reads
// observe the exact original consumer's whole owner without adding finish positions,
// holder uses, or precision updates. Only the selected carry is eligible for release.
effect fn sourceReadFlightRelease<'body>(builder: &mut SourceGraphBuilder<'body>, placement: SourceGraph.ReadPlacement,
  history: &SourceGraph.InputCase, loan: usize, quality: SourceQuality, paths: &mut List<List<Step>>,
  nodes: &[Node], owner: &DeclarationId, loans: &[Loan], requirements: &[RetentionEdge], relations: &[ImpliedGroup],
  settled: bool, prior: &[SourceWholeHold], named: &[Shared<Lifetime>]) -> SourceReadRelease
! OutOfMemoryError ? &mut Allocator {
  let no = SourceProgram.atom(&mut builder.rules)
  let mut selected = usize.MAX
  let rows = SourceGraphBuilder.readFlightObservations(&builder.*)
  let mut at = usize.ZERO
  while at < rows.length {
    let row = rows[at]
    if row.original.index == placement.original.index && row.consumer.index == placement.consumer.index
      && row.map.index == placement.map.index && sourceSameSummary(row.alias, placement.alias) {
      if selected != usize.MAX { return CompilerBug.panic(b"read flight duplicated an actual consumer") }
      selected = at
    }
    at = at + usize.ONE
  }
  if selected == usize.MAX { return SourceReadRelease {released: no, missing: history.quality.present} }
  let row = rows[selected]
  let evaluation = SourceGraphBuilder.evaluation(&builder.*, row.evaluation)
  let consumer = SourceGraphBuilder.value(&builder.*, row.consumer)
  if row.evaluation.index != placement.result.index || consumer.phase != SourceGraphValuePhase.Input
    || consumer.evaluation.index != row.evaluation.index || !sourceSameStorage(row.storage, placement.storage) {
    return CompilerBug.panic(b"read flight changed its original selected occurrence")
  }
  let node = match evaluation.site { SourceGraphEvaluationSite.Node {node} => node
    _ => { return CompilerBug.panic(b"read flight has no actual consumer expression") } }
  let coverage = SourceGraphBuilder.readFlightCoverage(&builder.*)[selected]
  if coverage.observation != selected { return CompilerBug.panic(b"read flight coverage names another owner") }
  let empty = List<SourceAtom>.make()
  let none = List<SourceAtom>.asSlice(&empty)
  let unknown = SourceProgram.atom(&mut builder.rules)
  let mut observed = SourceObservation {positions: List<SourceCarryPosition>.make(), other: List<SourceGraph.Input>.make(), unknown: unknown}
  let mut roots = usize.ZERO
  at = usize.ZERO
  while at < SourceGraphBuilder.readFlightReads(&builder.*).length {
    let actual = SourceGraphBuilder.readFlightReads(&builder.*)[at]
    if actual.observation == selected {
      let read = SourceGraphBuilder.read(&builder.*, actual.read)
      let value = SourceGraphBuilder.value(&builder.*, actual.value)
      if value.phase != SourceGraphValuePhase.Input || !sourcePhysicalValue(value)
        || value.evaluation.index != row.evaluation.index || read.point.index != evaluation.point.index
        || read.value.index != actual.value.index || !sourceSameStorage(read.storage, actual.storage) {
        return CompilerBug.panic(b"read flight substituted a different point or publication")
      }
      let whole = sourceSameStorage(actual.storage, row.owner)
      if whole { roots = roots + usize.ONE }
      let operand = SourceOperand {node: node, evaluation: row.evaluation, root: row.owner.endpoint, ordinal: usize.MAX}
      let mut present = List<SourceAtom>.make()
      run sourceObserveValue(&mut builder.*, &mut observed, operand, actual.value, &mut paths.*, loans.length,
        &mut present, whole, Option<SourceControl.ReadId>.some(actual.read))
      let required: [SourceAtom; 1] = [actual.active]
      run SourceProgram.rule(&mut builder.rules, unknown, &required, List<SourceAtom>.asSlice(&present))
    }
    at = at + usize.ONE
  }
  if roots != usize.ONE {
    let required: [SourceAtom; 1] = [row.active]
    run SourceProgram.rule(&mut builder.rules, unknown, &required, none)
  }
  let incomplete: [SourceAtom; 2] = [coverage.missing, observed.unknown]
  let missing = run SourcePolicy.disjunction(&mut builder.rules, &incomplete)
  let blocked = SourceProgram.atom(&mut builder.rules)
  if let Option<Shared<Lifetime>>.Some {value: borrowed} = &loans[loan].borrowed {
    let positions = List<SourceCarryPosition>.asSlice(&observed.positions)
    at = usize.ZERO
    while at < positions.length {
      if let Option<Shared<Lifetime>>.Some {value: parent} = &loans[positions[at].loan].parent {
        if meetMember(&parent, &borrowed) {
          let cases = List<SourceCarryCase>.asSlice(&positions[at].cases)
          let mut each = usize.ZERO
          while each < cases.length {
            // The whole-flight read has another ReadId. Only the original holding's
            // definition, loan and role identify the selected carry within this owner.
            let same = positions[at].loan == loan && cases[each].source.category == history.category
              && sourceDefinitionMatches(cases[each].source.definition, history.definition)
            if !same {
              let present: [SourceAtom; 1] = [cases[each].source.quality.present]
              run SourceProgram.rule(&mut builder.rules, blocked, &present, none)
            }
            each = each + usize.ONE
          }
        }
      }
      at = at + usize.ONE
    }
  }
  let proof = run sourceUnreachableLoan(nodes, owner, loans, loan, quality, blocked, missing,
    requirements, relations, settled, prior, named, &mut builder.rules)
  let required: [SourceAtom; 3] = [row.active, history.quality.present, proof]
  return SourceReadRelease {released: run SourcePolicy.conjunction(&mut builder.rules, &required, none), missing: missing}
}

// Attribute original held A through the selected B and then the final Copy once. A
// narrower read of an ancestor summary remains present with unknown result placement.
effect fn sourceReadField<'body>(builder: &SourceGraphBuilder<'body>,
  definition: SourceGraph.DefinitionView, placement: SourceGraph.ReadPlacement, root: PreparedSources.EndpointId,
  target: PreparedSources.EndpointId, paths: &mut List<List<Step>>) -> SourceReadField
! OutOfMemoryError ? &mut Allocator {
  return run sourceReadPlacementField(builder, definition, placement.storage, root, target, &mut paths.*)
}

// Attribution consumes the original canonical A/B after the caller authenticates its
// actual read correspondence. Input observations and Field-output publication share
// this calculation without substituting one kind of consumer for the other.
effect fn sourceReadPlacementField<'body>(builder: &SourceGraphBuilder<'body>,
  definition: SourceGraph.DefinitionView, storage: SourceGraph.Storage, root: PreparedSources.EndpointId,
  target: PreparedSources.EndpointId, paths: &mut List<List<Step>>) -> SourceReadField
! OutOfMemoryError ? &mut Allocator {
  let prepared = SourceGraphBuilder.preparation(builder)
  let summaries = SourceGraphBuilder.summaries(builder)
  let endpoints = List<PreparedSources.Endpoint>.asSlice(&prepared.endpoints)
  let output = run sourceField(endpoints, root, target, &mut paths.*)
  if output == usize.MAX { return SourceReadField {supported: false, field: usize.MAX} }
  let summary = match definition.summary {
    Option<usize>.Some {value} => value
    _ => { return SourceReadField {supported: true, field: output} }
  }
  if summary >= summaries.length || !sourceSameStorage(summaries[summary].prefix, definition.storage) {
    return CompilerBug.panic(b"read summary changed its original held prefix")
  }
  if sourceUnknownPlacement(summaries[summary].placement) { return SourceReadField {supported: true, field: usize.MAX} }
  let owner = match sourceStorageRoot(endpoints, definition.storage) {
    Option<SourceGraph.Storage>.Some {value} => value
    _ => { return SourceReadField {supported: false, field: usize.MAX} }
  }
  let held = run sourceOwnershipField(builder, owner.endpoint, summaries[summary].placement, &mut paths.*)
  let used = run sourceField(endpoints, owner.endpoint, storage.endpoint, &mut paths.*)
  if !held.supported || held.field == usize.MAX || used == usize.MAX { return SourceReadField {supported: false, field: usize.MAX} }
  let all = List<List<Step>>.asSlice(&paths.*)
  let a = List<Step>.asSlice(&all[held.field])
  let b = List<Step>.asSlice(&all[used])
  if !readContains(b, a) {
    return SourceReadField {supported: true, field: usize.MAX}
  }
  let mut placed = run copySteps(List<Step>.asSlice(&all[output]))
  let mut at = b.length
  while at < a.length { run List<Step>.append(&mut placed, a[at]) at = at + usize.ONE }
  let field = List<List<Step>>.length(&paths.*)
  run List<List<Step>>.append(&mut paths.*, move placed)
  return SourceReadField {supported: true, field: field}
}

fn sourceSameStorage(left: SourceGraph.Storage, right: SourceGraph.Storage) -> bool {
  if left.endpoint.index != right.endpoint.index { return false }
  return match left.temporary {
    Option<SourceGraph.EvalId>.Some {value} => match right.temporary {
      Option<SourceGraph.EvalId>.Some {value: other} => value.index == other.index
      _ => false
    }
    _ => match right.temporary { Option<SourceGraph.EvalId>.None => true _ => false }
  }
}

// Canonical whole-owner ancestry stops at every address/channel boundary. Keeping a holder
// through a field use does not turn a returned reference's provenance into its storage owner.
fn sourceStorageRoot(endpoints: &[PreparedSources.Endpoint], storage: SourceGraph.Storage) -> Option<SourceGraph.Storage> {
  let mut current = storage.endpoint
  let mut remaining = endpoints.length
  while current.index < endpoints.length && remaining > usize.ZERO {
    let endpoint = &endpoints[current.index]
    match endpoint.parent {
      Option<PreparedSources.EndpointId>.Some {value} => {
        match &endpoint.selector {
          PreparedSourcesSelector.Field {..} => { current = value }
          PreparedSourcesSelector.Member {..} => { current = value }
          PreparedSourcesSelector.Variant {..} => { current = value }
          PreparedSourcesSelector.Index {..} => { current = value }
          _ => { return Option<SourceGraph.Storage>.none() }
        }
      }
      _ => {
        let valid = match &endpoint.root {
          PreparedSourcesRoot.Local {category, ..} => category == PreparedSourcesEndpointRole.Storage
            && match storage.temporary { Option<SourceGraph.EvalId>.None => true _ => false }
          PreparedSourcesRoot.Node {category, ..} => category == PreparedSourcesEndpointRole.Storage
            && match storage.temporary { Option<SourceGraph.EvalId>.Some {..} => true _ => false }
          _ => false
        }
        if valid { return Option<SourceGraph.Storage>.some(SourceGraph.Storage {endpoint: current, temporary: storage.temporary}) }
        return Option<SourceGraph.Storage>.none()
      }
    }
    remaining = remaining - usize.ONE
  }
  return Option<SourceGraph.Storage>.none()
}

fn sourceOwnerStorage<'body>(builder: &SourceGraphBuilder<'body>, owner: &SourceVisit.Owner,
  storage: SourceGraph.Storage) -> bool {
  let endpoints = List<PreparedSources.Endpoint>.asSlice(&SourceGraphBuilder.preparation(builder).endpoints)
  let endpoint = &endpoints[storage.endpoint.index]
  return match owner.root {
    SourceVisitOwnerRoot.Local {local} => match &endpoint.root {
      PreparedSourcesRoot.Local {local: actual, category} => actual.index == local.index && category == PreparedSourcesEndpointRole.Storage
        && match storage.temporary { Option<SourceGraph.EvalId>.None => true _ => false }
      _ => false
    }
    SourceVisitOwnerRoot.Temporary {evaluation} => {
      let same = match storage.temporary { Option<SourceGraph.EvalId>.Some {value} => value.index == evaluation.index _ => false }
      if !same { return false }
      let actual = SourceGraphBuilder.evaluation(builder, evaluation)
      return match actual.site {
        SourceGraphEvaluationSite.Node {node} => match &endpoint.root {
          PreparedSourcesRoot.Node {node: stored, category} => stored.index == node.index && category == PreparedSourcesEndpointRole.Storage
          _ => false
        }
        _ => false
      }
    }
    SourceVisitOwnerRoot.Subject {evaluation, ..} => {
      let same = match storage.temporary { Option<SourceGraph.EvalId>.Some {value} => value.index == evaluation.index _ => false }
      if !same { return false }
      let actual = SourceGraphBuilder.evaluation(builder, evaluation)
      return match actual.site {
        SourceGraphEvaluationSite.Node {node} => match &endpoint.root {
          PreparedSourcesRoot.Node {node: stored, category} => stored.index == node.index && category == PreparedSourcesEndpointRole.Storage
          _ => false
        }
        _ => false
      }
    }
  }
}

// Retain requests even when no canonical address exists. Whole-holder demand is independent
// of which loans the selected output carries, including a LoanFree selected field. Exact alias
// nodes license address-only uses; existing reads license only their actual Copy placement.
effect fn sourceHolderProjection<'body>(builder: &mut SourceGraphBuilder<'body>, owners: &[SourceVisit.Owner],
  storage: &SourceStorageProjection, requests: List<SourceHolderRequest>) -> SourceHolderProjection
! OutOfMemoryError ? &mut Allocator {
  let mut result = SourceHolderProjection {reads: List<SourceSemanticRead>.make(), requests: move requests, uses: List<SourceHolderUse>.make(), missing: SourceProgram.atom(&mut builder.rules)}
  let all = List<SourceHolderRequest>.asSlice(&result.requests)
  let definitions = List<SourceStorageDefinition>.asSlice(&storage.definitions)
  let reads = List<SourceGraph.ReadView>.asSlice(&storage.reads)
  let empty = List<SourceAtom>.make()
  let none = List<SourceAtom>.asSlice(&empty)
  let mut gaps = List<SourceAtom>.make()
  let mut at = usize.ZERO
  while at < all.length {
    let request = all[at]
    let reachable = List<SourceControl.Point>.asSlice(&builder.reaching.points)[request.point.index].reachable
    let guards: [SourceAtom; 2] = [request.active, reachable]
    let active = run SourcePolicy.conjunction(&mut builder.rules, &guards, none)
    let mut covered = List<SourceAtom>.make()
    if let Option<SourceVisit.OwnerId>.Some {value: owner} = request.owner {
      if owner.index >= owners.length { CompilerBug.panic(b"whole-holder use lost its actual owner") }
      let mut each = usize.ZERO
      while each < definitions.length {
        if let Option<SourceGraph.Storage>.Some {value: root} = sourceStorageRoot(
          List<PreparedSources.Endpoint>.asSlice(&SourceGraphBuilder.preparation(&builder.*).endpoints), definitions[each].definition.storage) {
          if sourceOwnerStorage(&builder.*, &owners[owner.index], root) {
            run List<SourceHolderUse>.append(&mut result.uses, SourceHolderUse {request: at, storage: root, active: active})
            run List<SourceAtom>.append(&mut covered, active)
          }
        }
        each = each + usize.ONE
      }
    } else {
      let selected = run sourceSelectionCoverage(&mut builder.*, request.evaluation, request.root, true, active)
      run List<SourceAtom>.append(&mut gaps, selected.missing)
      if selected.matched { run List<SourceAtom>.append(&mut covered, selected.complete) }
      let mut alias = usize.ZERO
      while alias < SourceGraphBuilder.aliases(&builder.*).length {
        let aliases = SourceGraphBuilder.aliases(&builder.*)
        if aliases[alias].evaluation.index == request.evaluation.index && aliases[alias].endpoint.index == request.root.index {
          if let Option<SourceGraph.Storage>.Some {value: root} = sourceStorageRoot(
            List<PreparedSources.Endpoint>.asSlice(&SourceGraphBuilder.preparation(&builder.*).endpoints), aliases[alias].storage) {
            let guards: [SourceAtom; 3] = [active, aliases[alias].active, selected.complete]
            let missing: [SourceAtom; 1] = [SourceGraphBuilder.aliasMissing(&builder.*, alias)]
            let present = run SourcePolicy.conjunction(&mut builder.rules, &guards, &missing)
            run List<SourceHolderUse>.append(&mut result.uses, SourceHolderUse {request: at, storage: root, active: present})
          }
        }
        alias = alias + usize.ONE
      }
      let components = run sourceComponents(SourceGraphBuilder.preparation(&builder.*), request.root)
      let readSelection = run sourceSelectionCoverage(&mut builder.*, request.evaluation, request.root, false, active)
      run List<SourceAtom>.append(&mut gaps, readSelection.missing)
      let parts = List<PreparedSources.EndpointId>.asSlice(&components)
      let mut readCoverage = List<SourceAtom>.make()
      let mut component = usize.ZERO
      while component < parts.length {
        let mut componentCoverage = List<SourceAtom>.make()
        let mut value = usize.ZERO
        while value < SourceGraphBuilder.values(&builder.*).length {
          let actual = SourceGraphBuilder.value(&builder.*, SourceGraph.ValueId {index: value})
          let physical = sourcePhysicalValue(actual)
          if physical && actual.endpoint.index == parts[component].index && actual.phase == SourceGraphValuePhase.Input && actual.evaluation.index == request.evaluation.index {
            let mut read = usize.ZERO
            while read < reads.length {
              if reads[read].point.index == SourceGraphBuilder.evaluation(&builder.*, request.evaluation).point.index {
                let placements = run SourceGraphBuilder.readPlacements(&builder.*, SourceGraph.ValueId {index: value}, reads[read].id)
                let candidates = List<SourceGraph.ReadPlacement>.asSlice(&placements)
                let mut each = usize.ZERO
                while each < candidates.length {
                  if let Option<SourceGraph.Storage>.Some {value: root} = sourceStorageRoot(
                    List<PreparedSources.Endpoint>.asSlice(&SourceGraphBuilder.preparation(&builder.*).endpoints), candidates[each].storage) {
                    let mut guards = List<SourceAtom>.make()
                    run List<SourceAtom>.append(&mut guards, active)
                    run List<SourceAtom>.append(&mut guards, candidates[each].active)
                    if selected.matched { run List<SourceAtom>.append(&mut guards, selected.complete) }
                    if readSelection.matched { run List<SourceAtom>.append(&mut guards, readSelection.complete) }
                    let mut excluded = List<SourceAtom>.make()
                    if let Option<usize>.Some {value: selectedAlias} = candidates[each].alias {
                      let missing = SourceGraphBuilder.aliasMissing(&builder.*, selectedAlias)
                      run List<SourceAtom>.append(&mut excluded, missing)
                      let unsupported: [SourceAtom; 3] = [active, candidates[each].active, missing]
                      run List<SourceAtom>.append(&mut gaps, run SourcePolicy.conjunction(&mut builder.rules, &unsupported, none))
                    }
                    let present = run SourcePolicy.conjunction(&mut builder.rules,
                      List<SourceAtom>.asSlice(&guards), List<SourceAtom>.asSlice(&excluded))
                    run List<SourceHolderUse>.append(&mut result.uses, SourceHolderUse {request: at, storage: root, active: present})
                    run List<SourceAtom>.append(&mut componentCoverage, present)
                  }
                  each = each + usize.ONE
                }
              }
              read = read + usize.ONE
            }
          }
          value = value + usize.ONE
        }
        run List<SourceAtom>.append(&mut readCoverage,
          run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&componentCoverage)))
        component = component + usize.ONE
      }
      if parts.length > usize.ZERO {
        run List<SourceAtom>.append(&mut covered,
          run SourcePolicy.conjunction(&mut builder.rules, List<SourceAtom>.asSlice(&readCoverage), none))
      }
    }
    let present = run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&covered))
    let included: [SourceAtom; 1] = [active]
    let excluded: [SourceAtom; 1] = [present]
    run List<SourceAtom>.append(&mut gaps, run SourcePolicy.conjunction(&mut builder.rules, &included, &excluded))
    at = at + usize.ONE
  }
  result.missing = run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&gaps))
  return move result
}

// Capture symbolic source membership only after structural reservation has closed. This
// does not emit a definition, choose a reaching predecessor, or turn a Borrow leaf into a
// storage owner. Availability later uses this record's real ID with Graph.control().
effect fn sourceStorageProjection<'body>(builder: &mut SourceGraphBuilder<'body>) -> SourceStorageProjection
! OutOfMemoryError ? &mut Allocator {
  let mut definitions = List<SourceStorageDefinition>.make()
  let mut reads = List<SourceGraph.ReadView>.make()
  let empty = List<SourceAtom>.make()
  let none = List<SourceAtom>.asSlice(&empty)
  let mut at = usize.ZERO
  while at < SourceGraphBuilder.definitionCount(&builder.*) {
    let definition = SourceGraphBuilder.definition(&builder.*, SourceControl.DefinitionId {index: at})
    if definition.id.index != at { CompilerBug.panic(b"ownership definition projection changed a real Flow identity") }
    let projected = run SourceGraphBuilder.definitionInputs(&mut builder.*, definition.id)
    let inputs = move projected.inputs
    let reachable = List<SourceControl.Point>.asSlice(&builder.reaching.points)[definition.point.index].reachable
    let guards: [SourceAtom; 2] = [definition.active, reachable]
    let active = run SourcePolicy.conjunction(&mut builder.rules, &guards, none)
    let sources = List<SourceGraph.Input>.asSlice(&inputs)
    let mut present = List<SourceAtom>.make()
    // Redirected histories occupy their bound summary definitions, not this physical one.
    // Their evidence covers legitimate empty content without inventing a LoanFree leaf.
    run List<SourceAtom>.append(&mut present, projected.redirected)
    let mut unknown = List<SourceAtom>.make()
    let mut gaps = List<SourceAtom>.make()
    let mut loans = List<SourceStoredLoan>.make()
    let mut each = usize.ZERO
    while each < sources.length {
      if sources[each].value.index != definition.value.index {
        CompilerBug.panic(b"ownership definition projection substituted another written value")
      }
      run List<SourceAtom>.append(&mut present, sources[each].quality.present)
      let kind = &SourceGraphBuilder.leaf(&builder.*, sources[each].leaf).kind
      let borrowedLoan = match &kind.* {
        SourceGraphSourceLeaf.Borrow {loan, ..} => Option<usize>.some(loan)
        _ => Option<usize>.none()
      }
      let unknownSource = match &kind.* {
        SourceGraphSourceLeaf.Unknown {..} => true
        _ => false
      }
      if let Option<usize>.Some {value: loan} = borrowedLoan {
        let observed: [SourceAtom; 2] = [active, sources[each].quality.present]
        run List<SourceStoredLoan>.append(&mut loans, SourceStoredLoan {leaf: sources[each].leaf,
          loan: loan, active: run SourcePolicy.conjunction(&mut builder.rules, &observed, none)})
      }
      if unknownSource {
        let observed: [SourceAtom; 2] = [active, sources[each].quality.present]
        run List<SourceAtom>.append(&mut unknown, run SourcePolicy.conjunction(&mut builder.rules, &observed, none))
      }
      if List<SourceGraph.InputCase>.length(&sources[each].cases) == usize.ZERO {
        let unsupported: [SourceAtom; 2] = [active, sources[each].quality.present]
        run List<SourceAtom>.append(&mut gaps, run SourcePolicy.conjunction(&mut builder.rules, &unsupported, none))
      }
      each = each + usize.ONE
    }
    let covered = run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&present))
    let applies: [SourceAtom; 1] = [active]
    let absent: [SourceAtom; 1] = [covered]
    // A retained clear is an empty definition in its own summary lane. The original
    // covering write supplies applicability; absence here means no summary contents.
    // It is neither an Unknown value nor a manufactured LoanFree leaf.
    match definition.clears {
      Option<SourceControl.DefinitionId>.Some {value: original} => {
        if let Option<usize>.None = definition.summary {
          return CompilerBug.panic(b"physical storage definition acquired a summary clear")
        }
        let clearing = SourceGraphBuilder.definition(&builder.*, original)
        if sources.length != usize.ZERO || clearing.point.index != definition.point.index {
          return CompilerBug.panic(b"summary clear acquired contents or another execution point")
        }
      }
      _ => {
        let mut fieldClear = false
        let clears = SourceGraphBuilder.fieldReholdClears(&builder.*)
        let mut clear = usize.ZERO
        while clear < clears.length {
          let row = clears[clear]
          if row.definition.index == definition.id.index {
            let observation = SourceGraphBuilder.fieldReholdObservations(&builder.*)[row.observation]
            let request = SourceGraphBuilder.fieldReholdRequests(&builder.*)[observation.request]
            let value = SourceGraphBuilder.value(&builder.*, definition.value)
            let writer = match definition.writer { Option<SourceGraph.EvalId>.Some {value: writtenAt} => writtenAt
              _ => { return CompilerBug.panic(b"field clear omitted its actual writer") } }
            if fieldClear || sources.length != usize.ZERO || definition.write != SourceControlWrite.Strong
              || !sourceSameSummary(definition.summary, Option<usize>.some(row.summary))
              || !sourceSameSummary(value.summary, definition.summary) || value.phase != SourceGraphValuePhase.Output
              || writer.index != request.execution.index || value.evaluation.index != writer.index
              || definition.point.index != SourceGraphBuilder.evaluation(&builder.*, writer).point.index
              || !SourceAtom.same(definition.active, observation.active) {
              return CompilerBug.panic(b"field clear substituted contents or another semantic rebind")
            }
            fieldClear = true
          }
          clear = clear + usize.ONE
        }
        if !fieldClear { run List<SourceAtom>.append(&mut gaps, run SourcePolicy.conjunction(&mut builder.rules, &applies, &absent)) }
      }
    }
    run List<SourceStorageDefinition>.append(&mut definitions, SourceStorageDefinition {
      definition: definition, inputs: move inputs, loans: move loans,
      unknown: run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&unknown)),
      missing: run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&gaps))})
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < SourceGraphBuilder.readCount(&builder.*) {
    let read = SourceGraphBuilder.read(&builder.*, SourceControl.ReadId {index: at})
    if read.id.index != at { CompilerBug.panic(b"ownership read projection changed a real Flow identity") }
    run List<SourceGraph.ReadView>.append(&mut reads, read)
    at = at + usize.ONE
  }
  // Uninitialized End/Move definitions are deliberately retained. Their Unknown source is
  // relevant when observed, not a global failure merely because dead storage has ended.
  return SourceStorageProjection {definitions: move definitions, reads: move reads}
}

// Authenticate the exact history retained by the operation, not the contents of its holder
// at a later event. The graph already includes every intervening copy and source decision.
effect fn sourceCallerEvidence<'body>(builder: &mut SourceGraphBuilder<'body>, source: SourceEffectSource,
  active: SourceAtom) -> SourceCallerEvidence ! OutOfMemoryError ? &mut Allocator {
  let no = SourceProgram.atom(&mut builder.rules)
  let unavailable = SourceCallerEvidence {present: no, missing: active}
  if source.value.index >= SourceGraphBuilder.values(&builder.*).length { return unavailable }
  let borrowed = match &SourceGraphBuilder.leaf(&builder.*, source.leaf).kind {
    SourceGraphSourceLeaf.Borrow {loan, ..} => loan == source.loan
    _ => false
  }
  if !borrowed { return unavailable }
  let mut paired = run sourceBoolean(&mut builder.rules, true)
  match source.definition {
    Option<SourceControl.DefinitionId>.Some {value: definition} => {
      let read = match source.read {
        Option<SourceControl.ReadId>.Some {value} => value
        _ => { return unavailable }
      }
      if definition.index >= SourceGraphBuilder.definitionCount(&builder.*)
        || read.index >= SourceGraphBuilder.readCount(&builder.*) { return unavailable }
      let written = SourceGraphBuilder.definition(&builder.*, definition)
      let observed = SourceGraphBuilder.read(&builder.*, read)
      if !sourceSameReadLane(written, observed) { return unavailable }
      paired = match sourceFlowPair(&builder.reaching, definition, read) {
        Option<SourceAtom>.Some {value} => value
        _ => { return unavailable }
      }
    }
    _ => {
      if let Option<SourceControl.ReadId>.Some {..} = source.read { return unavailable }
      // An unpaired case is accepted only below, from the real Borrow leaf at the actual
      // value. The two absent IDs themselves are never a fresh-loan witness.
    }
  }
  // appendInputCases names each incoming Case once, using its target cell's retained
  // witness. The source already keeps that ordinal, so do not rebuild every other
  // leaf/history at this Value merely to find the same immutable correspondence.
  if source.case >= SourceGraphBuilder.caseCount(&builder.*) { return unavailable }
  let actual = SourceGraphBuilder.case(&builder.*, source.case).target
  if actual.value.index != source.value.index || actual.leaf.index != source.leaf.index
    || actual.category != source.category || !sourceDefinitionMatches(actual.definition, source.definition)
    || !sourceReadMatches(actual.read, source.read) { return unavailable }
  let observed = SourceGraphBuilder.observationCase(&builder.*, source.case)
  let empty = List<SourceAtom>.make()
  let none = List<SourceAtom>.asSlice(&empty)
  let mut candidates = List<SourceAtom>.make()
  let guards: [SourceAtom; 3] = [active, paired, observed.semantic.present]
  run List<SourceAtom>.append(&mut candidates, run SourcePolicy.conjunction(&mut builder.rules, &guards, none))
  return SourceCallerEvidence {present: run SourcePolicy.disjunction(&mut builder.rules,
    List<SourceAtom>.asSlice(&candidates)), missing: no}
}

// Freeze interval authentication before the sole solve. In particular, a copied carrier's
// interval belongs to its original paired read, not whichever definition occupies its owner
// at the consumer. Fresh acquisitions must still have an actual unpaired Borrow source case.
effect fn sourceIntervalProjection<'body>(builder: &mut SourceGraphBuilder<'body>,
  intervals: &[SourceIntervalEffect]) -> List<SourceIntervalProjection>
! OutOfMemoryError ? &mut Allocator {
  let mut projected = List<SourceIntervalProjection>.make()
  let count = List<SourceControl.Point>.length(&builder.reaching.points)
  let mut at = usize.ZERO
  while at < intervals.length {
    let interval = &intervals[at]
    let mut evidence = SourceCallerEvidence {present: SourceProgram.atom(&mut builder.rules), missing: interval.active}
    if interval.from < count && interval.to < count {
      evidence = run sourceCallerEvidence(&mut builder.*, interval.source, interval.active)
    }
    run List<SourceIntervalProjection>.append(&mut projected, SourceIntervalProjection {
      source: interval.source, from: interval.from, to: interval.to, cleanup: interval.cleanup, holder: interval.holder, evidence: evidence})
    at = at + usize.ONE
  }
  return move projected
}

fn sourceTruthAnd(left: SourceTruth, right: SourceTruth) -> SourceTruth {
  if left == SourceTruth.False || right == SourceTruth.False { return SourceTruth.False }
  if left == SourceTruth.True && right == SourceTruth.True { return SourceTruth.True }
  return SourceTruth.Undefined
}

fn sourceStoredMembership<'body>(graph: &SourceGraphGraph<'body>, definition: &SourceStorageDefinition,
  loan: usize) -> SourceTruth {
  let members = List<SourceStoredLoan>.asSlice(&definition.loans)
  let mut found = SourceTruth.False
  let mut at = usize.ZERO
  while at < members.length {
    if members[at].loan == loan {
      let active = SourceGraphGraph.truth(graph, members[at].active)
      if active == SourceTruth.True { return SourceTruth.True }
      if active == SourceTruth.Undefined { found = SourceTruth.Undefined }
    }
    at = at + usize.ONE
  }
  return found
}

fn sourceIncludeDefinition(words: &mut List<u64>, width: usize, point: usize,
  definition: SourceControl.DefinitionId) -> () {
  let mut all = List<u64>.asMutSlice(&mut words.*)
  let slot = point * width + wordOf(definition.index)
  all[slot] = u64.bitOr(all[slot], maskOf(definition.index))
}

// Project the solved control relation; this deliberately has no transfer or fixed-point loop.
// Unknown membership remains a possible carrier and prevents a final ownership proof. A
// LoanFree/Unknown tombstone does not become an invented definition for any particular loan.
effect fn sourceLoanOccupancy<'body>(graph: &SourceGraphGraph<'body>, storage: &SourceStorageProjection,
  loan: usize) -> SourceLoanOccupancy ! OutOfMemoryError ? &mut Allocator {
  let control = SourceGraphGraph.control(graph)
  let points = List<SourceControl.Point>.asSlice(&control.points)
  let definitions = List<SourceStorageDefinition>.asSlice(&storage.definitions)
  if definitions.length != SourceGraphGraph.definitionCount(graph) {
    return CompilerBug.panic(b"ownership occupancy lost actual Flow definitions")
  }
  let width = (definitions.length + 63) / 64
  let mut result = SourceLoanOccupancy {loan: loan, width: width, entering: List<u64>.make(),
    leaving: List<u64>.make(), inherited: List<u64>.make(), shadowed: List<u64>.make(), unresolved: false}
  let mut at = usize.ZERO
  while at < points.length * width {
    run List<u64>.append(&mut result.entering, 0)
    run List<u64>.append(&mut result.leaving, 0)
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < width {
    run List<u64>.append(&mut result.inherited, 0)
    run List<u64>.append(&mut result.shadowed, 0)
    at = at + usize.ONE
  }
  let mut each = usize.ZERO
  while each < definitions.length {
    let definition = definitions[each].definition
    let disposition = sourceSettledDisposition(graph, Option<SourceControl.DefinitionId>.some(definition.id))
    if disposition == SourceGraphSummaryDisposition.Inherited { sourceIncludeDefinition(&mut result.inherited, width, 0, definition.id) }
    if disposition == SourceGraphSummaryDisposition.Shadowed { sourceIncludeDefinition(&mut result.shadowed, width, 0, definition.id) }
    let actual = SourceGraphGraph.definition(graph, definition.id)
    if definition.id.index != each || actual.point.index != definition.point.index
      || actual.value.index != definition.value.index || !sourceSameStorage(actual.storage, definition.storage)
      || !sourceSameSummary(actual.summary, definition.summary)
      || !sourceDefinitionMatches(actual.clears, definition.clears) {
      return CompilerBug.panic(b"ownership occupancy substituted a real definition identity")
    }
    let membership = sourceStoredMembership(graph, &definitions[each], loan)
    at = usize.ZERO
    while at < points.length {
      let point = SourceControl.PointId {index: at}
      let entering = sourceTruthAnd(membership, SourceGraphGraph.truth(graph,
        SourceControlReaching.enters(control, point, definition.id)))
      let leaving = sourceTruthAnd(membership, SourceGraphGraph.truth(graph,
        SourceControlReaching.leaves(control, point, definition.id)))
      if entering != SourceTruth.False { sourceIncludeDefinition(&mut result.entering, width, at, definition.id) }
      if leaving != SourceTruth.False { sourceIncludeDefinition(&mut result.leaving, width, at, definition.id) }
      if entering == SourceTruth.Undefined || leaving == SourceTruth.Undefined { result.unresolved = true }
      if (entering != SourceTruth.False || leaving != SourceTruth.False)
        && SourceGraphGraph.truth(graph, definitions[each].missing) != SourceTruth.False { result.unresolved = true }
      at = at + usize.ONE
    }
    each = each + usize.ONE
  }
  return move result
}

// Materialize adjacency for the existing ownership solvers from the one source CFG. The
// event projection supplies diagnostics separately; no synthetic ownership points are added.
effect fn sourceControlProjection<'body>(graph: &SourceGraphGraph<'body>, entry: SourceControl.PointId)
  -> SourceControlProjection ! OutOfMemoryError ? &mut Allocator {
  let control = SourceGraphGraph.control(graph)
  let actual = List<SourceControl.Point>.asSlice(&control.points)
  if entry.index >= actual.length { return CompilerBug.panic(b"ownership projection lost the actual CFG entry") }
  let mut result = SourceControlProjection {entry: entry.index, points: List<Point>.make(), unresolved: false}
  let mut at = usize.ZERO
  while at < actual.length {
    run List<Point>.append(&mut result.points, Point {next: List<usize>.make(), uses: usize.MAX,
      read: usize.MAX, written: usize.MAX, defines: usize.MAX, initializes: usize.MAX, event: usize.MAX,
      span: Location.make(usize.ZERO, usize.ZERO)})
    at = at + usize.ONE
  }
  let edges = List<SourceControl.Edge>.asSlice(&control.edges)
  at = usize.ZERO
  while at < edges.length {
    let edge = edges[at]
    let active = sourceTruthAnd(SourceGraphGraph.truth(graph, edge.active),
      SourceGraphGraph.truth(graph, actual[edge.from.index].reachable))
    if active != SourceTruth.False {
      run List<usize>.append(&mut List<Point>.asMutSlice(&mut result.points)[edge.from.index].next, edge.to.index)
    }
    if active == SourceTruth.Undefined { result.unresolved = true }
    at = at + usize.ONE
  }
  return move result
}

// The existing move solver consumes actual loop backedges and owner acquisitions on the
// same CFG. Completion bounds the body's structural interval; its early-allocated exit
// cannot stand in for that boundary. Multiple owners at one point remain separate roots.
effect fn sourceMoveProjection<'body>(graph: &SourceGraphGraph<'body>, control: &SourceControlProjection,
  owners: &[SourceVisit.Owner], loops: &[SourceVisit.Loop], runtime: &SourceRuntimeEvents) -> SourceMoveProjection
! OutOfMemoryError ? &mut Allocator {
  let points = List<Point>.asSlice(&control.points)
  let actualPoints = List<SourceControl.Point>.asSlice(&SourceGraphGraph.control(graph).points)
  let prepared = SourceGraphGraph.preparation(graph)
  let mut result = SourceMoveProjection {loops: List<Loop>.make(), initialized: List<MoveInitialization>.make(),
    moves: List<usize>.make(), reach: Reach {entering: List<u64>.make(), leaving: List<u64>.make()},
    width: usize.ZERO, unresolved: control.unresolved || runtime.unresolved}
  let mut at = usize.ZERO
  while at < owners.length {
    let point = owners[at].initialized.index
    if point >= points.length { return CompilerBug.panic(b"move initialization has no actual owner acquisition point") }
    let root = match owners[at].root {
      SourceVisitOwnerRoot.Local {local} => local.index
      _ => prepared.body.locals.length + at
    }
    run List<MoveInitialization>.append(&mut result.initialized, MoveInitialization {point: point, root: root})
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < loops.length {
    let repeat = &loops[at]
    if repeat.before.index >= points.length || repeat.header.index >= points.length
      || repeat.completed.index >= points.length || repeat.completed.index < repeat.header.index {
      return CompilerBug.panic(b"ownership loop lost its actual completion interval")
    }
    let active = SourceGraphGraph.truth(graph, actualPoints[repeat.header.index].reachable)
    if active != SourceTruth.False {
      if active == SourceTruth.Undefined { result.unresolved = true }
      let mut sources = List<usize>.make()
      let backedges = List<SourceControl.PointId>.asSlice(&repeat.backedges)
      let mut each = usize.ZERO
      while each < backedges.length {
        let point = backedges[each].index
        if point >= points.length { return CompilerBug.panic(b"ownership loop backedge has no actual point") }
        // The solved projection already removed impossible edges. A possible edge remains
        // conservative and makes the whole move result unresolved through control above.
        if listsIndex(List<usize>.asSlice(&points[point].next), repeat.header.index) {
          run List<usize>.append(&mut sources, point)
        }
        each = each + usize.ONE
      }
      run List<Loop>.append(&mut result.loops, Loop {before: repeat.before.index, header: repeat.header.index,
        sources: move sources, end: repeat.completed.index + usize.ONE, span: prepared.body.nodes[repeat.node.index].origin.location})
    }
    at = at + usize.ONE
  }
  let events = List<Event>.asSlice(&runtime.events)
  at = usize.ZERO
  while at < events.length {
    if events[at].kind == Kind.Move || events[at].kind == Kind.Drop { run List<usize>.append(&mut result.moves, at) }
    at = at + usize.ONE
  }
  result.width = (List<usize>.length(&result.moves) + 63) / 64
  if result.width != usize.ZERO {
    result.reach = run reaching(points, List<MoveInitialization>.asSlice(&result.initialized), events,
      List<Loop>.asSlice(&result.loops), List<usize>.asSlice(&result.moves), result.width)
  }
  return move result
}

// Field-sensitive needs use the original paired read. A copied value can remain in flight
// after its old owner is overwritten; that interval does not keep the old storage occupied.
// Whole-holder conflict uses are a separate canonical-owner demand, not output source facts.
effect fn sourceLivenessBounds<'body>(graph: &SourceGraphGraph<'body>, storage: &SourceStorageProjection,
  occupancy: &SourceLoanOccupancy) -> List<u64> ! OutOfMemoryError ? &mut Allocator {
  let points = List<SourceControl.Point>.asSlice(&SourceGraphGraph.control(graph).points)
  let definitions = List<SourceStorageDefinition>.asSlice(&storage.definitions)
  let width = occupancy.width
  let mut bound = List<u64>.make()
  let mut at = usize.ZERO
  while at < points.length * width { run List<u64>.append(&mut bound, 0) at = at + usize.ONE }
  at = usize.ZERO
  while at < points.length {
    let mut each = usize.ZERO
    while each < definitions.length {
      let definition = definitions[each].definition
      // Definite absence is a kill. An active strong redefinition also starts a new instance
      // of this static definition on a back edge, just as the existing bound table does.
      let rebound = definition.point.index == at && definition.write == SourceControlWrite.Strong
        && SourceGraphGraph.truth(graph, definition.active) == SourceTruth.True
      if rebound || !reaches(List<u64>.asSlice(&occupancy.leaving), width, at, each) {
        sourceIncludeDefinition(&mut bound, width, at, definition.id)
      }
      each = each + usize.ONE
    }
    at = at + usize.ONE
  }
  return move bound
}

effect fn sourceLoanNeeds<'body>(graph: &SourceGraphGraph<'body>, control: &SourceControlProjection,
  storage: &SourceStorageProjection, occupancy: &SourceLoanOccupancy, intervals: &[SourceIntervalProjection],
  views: &[SourceLifetimeProjection], created: usize, flow: &mut IntervalFlow) -> SourceLoanNeeds ! OutOfMemoryError ? &mut Allocator {
  let points = List<Point>.asSlice(&control.points)
  let definitions = List<SourceStorageDefinition>.asSlice(&storage.definitions)
  let mut used = List<u64>.make()
  let mut required = List<u64>.make()
  let mut unresolved = control.unresolved || occupancy.unresolved
  let width = occupancy.width
  let mut at = usize.ZERO
  while at < points.length * width {
    run List<u64>.append(&mut used, 0)
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < (points.length + 63) / 64 { run List<u64>.append(&mut required, 0) at = at + usize.ONE }
  if created < points.length {
    let active = SourceGraphGraph.truth(graph,
      List<SourceControl.Point>.asSlice(&SourceGraphGraph.control(graph).points)[created].reachable)
    if active != SourceTruth.False { drop includeRegionPoint(&mut required, created) }
    if active == SourceTruth.Undefined { unresolved = true }
  } else { unresolved = true }
  let bound = run sourceLivenessBounds(graph, storage, occupancy)
  at = usize.ZERO
  while at < intervals.length {
    let interval = &intervals[at]
    if interval.source.loan == occupancy.loan && (!interval.holder
      || sourceSettledDisposition(graph, interval.source.definition) != SourceGraphSummaryDisposition.Shadowed) {
      let present = SourceGraphGraph.truth(graph, interval.evidence.present)
      if SourceGraphGraph.truth(graph, interval.evidence.missing) != SourceTruth.False
        || present == SourceTruth.Undefined { unresolved = true }
      if present != SourceTruth.False {
        if interval.from >= points.length || interval.to >= points.length {
          unresolved = true
        } else {
          if let Option<SourceControl.DefinitionId>.Some {value: definition} = interval.source.definition {
            if let Option<SourceControl.ReadId>.Some {value: read} = interval.source.read {
              let actual = SourceGraphGraph.read(graph, read)
              sourceIncludeDefinition(&mut used, width, actual.point.index, definition)
            } else { unresolved = true }
          }
          if !interval.holder { run includeIntervalRequirements(points, interval.from, interval.to, &mut flow.*, &mut required) }
        }
      }
    }
    at = at + usize.ONE
  }
  let liveOut = run solveLiveness(points, width, List<u64>.asSlice(&used), List<u64>.asSlice(&bound))
  // A borrowed view has no physical descriptor definition. Its actual binding/extent
  // requirements still constrain this loan before any release or region intersection.
  at = usize.ZERO
  while at < views.length {
    if views[at].loan == occupancy.loan {
      let demands = List<SourceAtom>.asSlice(&views[at].required)
      if demands.length != points.length { return CompilerBug.panic(b"view requirements belong to another CFG") }
      let mut point = usize.ZERO
      while point < points.length {
        let needed = SourceGraphGraph.truth(graph, demands[point])
        if needed != SourceTruth.False { drop includeRegionPoint(&mut required, point) }
        if needed == SourceTruth.Undefined { unresolved = true }
        point = point + usize.ONE
      }
    }
    at = at + usize.ONE
  }
  includeLiveRequirements(points.length, definitions.length, occupancy,
    List<u64>.asSlice(&liveOut), &mut required)
  return SourceLoanNeeds {required: move required, liveOut: move liveOut, unresolved: unresolved}
}

// Numeric intervals contribute only paths that can reach their actual consumer. A
// wrapped interval has no numeric interior; the paired holder liveness contributes it.
effect fn includeIntervalRequirements(points: &[Point], from: usize, to: usize,
  flow: &mut IntervalFlow, required: &mut List<u64>) -> () ! OutOfMemoryError ? &mut Allocator {
  if from >= points.length || to >= points.length { CompilerBug.panic(b"interval belongs to another CFG") }
  if from <= to {
    let endpoint = run intervalEndpoint(points, to, &mut flow.*)
    let reached = List<List<u64>>.asSlice(&flow.reaching)
    let paths = List<u64>.asSlice(&reached[endpoint])
    let mut point = from
    while point <= to {
      if u64.bitAnd(paths[wordOf(point)], maskOf(point)) != 0 { drop includeRegionPoint(&mut required.*, point) }
      point = point + usize.ONE
    }
  }
  return ()
}

fn includeLiveRequirements(pointCount: usize, definitionCount: usize, occupancy: &SourceLoanOccupancy,
  liveOut: &[u64], required: &mut List<u64>) -> () {
  let mut at = usize.ZERO
  while at < pointCount {
    let mut each = usize.ZERO
    while each < definitionCount {
      if reaches(List<u64>.asSlice(&occupancy.entering), occupancy.width, at, each)
        && reaches(List<u64>.asSlice(&occupancy.leaving), occupancy.width, at, each)
        && reaches(liveOut, occupancy.width, at, each) {
        drop includeRegionPoint(&mut required.*, at)
      }
      each = each + usize.ONE
    }
    at = at + usize.ONE
  }
}

// Whole-holder uses retain every reaching definition of that canonical owner for conflicts.
// They do not add source cases to the selected result or field-sensitive region requirements.
effect fn sourceHolderLiveness<'body>(graph: &SourceGraphGraph<'body>, control: &SourceControlProjection,
  storage: &SourceStorageProjection, occupancy: &SourceLoanOccupancy, holders: &SourceHolderProjection)
  -> SourceHolderLiveness ! OutOfMemoryError ? &mut Allocator {
  let points = List<Point>.asSlice(&control.points)
  let definitions = List<SourceStorageDefinition>.asSlice(&storage.definitions)
  let requests = List<SourceHolderRequest>.asSlice(&holders.requests)
  let uses = List<SourceHolderUse>.asSlice(&holders.uses)
  let endpoints = List<PreparedSources.Endpoint>.asSlice(&SourceGraphGraph.preparation(graph).endpoints)
  let mut unresolved = control.unresolved || occupancy.unresolved
    || SourceGraphGraph.truth(graph, holders.missing) != SourceTruth.False
  let mut used = List<u64>.make()
  let mut at = usize.ZERO
  while at < points.length * occupancy.width { run List<u64>.append(&mut used, 0) at = at + usize.ONE }
  at = usize.ZERO
  while at < uses.length {
    let demand = uses[at]
    if demand.request >= requests.length { return CompilerBug.panic(b"holder liveness lost its actual use") }
    let point = requests[demand.request].point.index
    let active = SourceGraphGraph.truth(graph, demand.active)
    if active == SourceTruth.Undefined { unresolved = true }
    if active != SourceTruth.False {
      let mut each = usize.ZERO
      while each < definitions.length {
        if let Option<SourceGraph.Storage>.Some {value: root} = sourceStorageRoot(endpoints, definitions[each].definition.storage) {
          if sourceSameStorage(root, demand.storage)
            && reaches(List<u64>.asSlice(&occupancy.entering), occupancy.width, point, each) {
            sourceIncludeDefinition(&mut used, occupancy.width, point, definitions[each].definition.id)
          }
        }
        each = each + usize.ONE
      }
    }
    at = at + usize.ONE
  }
  let bound = run sourceLivenessBounds(graph, storage, occupancy)
  return SourceHolderLiveness {liveOut: run solveLiveness(points, occupancy.width,
    List<u64>.asSlice(&used), List<u64>.asSlice(&bound)), unresolved: unresolved}
}

fn sourceLiveJoin(left: CallerSource, right: CallerSource) -> CallerSource {
  if left == CallerSource.Actual || right == CallerSource.Actual { return CallerSource.Actual }
  if left == CallerSource.Unknown || right == CallerSource.Unknown { return CallerSource.Unknown }
  return CallerSource.Absent
}

fn sourceLiveActivity(value: CallerSource, activity: SourceTruth) -> CallerSource {
  if activity == SourceTruth.False || value == CallerSource.Absent { return CallerSource.Absent }
  if activity == SourceTruth.Undefined { return CallerSource.Unknown }
  return value
}

// The bits still name real Flow definitions. Requiring both sides of the event preserves
// the old rebind exclusion: a future read of the replacement does not keep its old value.
// The existing liveness solver uses possible CFG edges, so its unresolved projection may
// contribute an unchecked obligation but cannot by itself ground a conflict.
fn sourceHeldAt(control: &SourceControlProjection, occupancy: &SourceLoanOccupancy, liveOut: &[u64],
  unresolved: bool, point: usize) -> CallerSource {
  let count = List<Point>.length(&control.points)
  if point >= count || liveOut.length != count * occupancy.width
    || List<u64>.length(&occupancy.entering) != liveOut.length
    || List<u64>.length(&occupancy.leaving) != liveOut.length || List<u64>.length(&occupancy.inherited) != occupancy.width {
    return CompilerBug.panic(b"holder conflict liveness belongs to another CFG or definition inventory")
  }
  let uncertain = unresolved || control.unresolved || occupancy.unresolved
  let mut word = usize.ZERO
  while word < occupancy.width {
    let slot = point * occupancy.width + word
    let carried = u64.bitAnd(List<u64>.asSlice(&occupancy.entering)[slot], List<u64>.asSlice(&occupancy.leaving)[slot])
    if u64.bitAnd(u64.bitAnd(carried, liveOut[slot]), u64.bitNot(List<u64>.asSlice(&occupancy.inherited)[word])) != 0 {
      if uncertain { return CallerSource.Unknown }
      return CallerSource.Actual
    }
    word = word + usize.ONE
  }
  if uncertain { return CallerSource.Unknown }
  return CallerSource.Absent
}

// Independent escape is the pre-caller snapshot. Aggregated Loan.escapes may constrain
// availability but is never substituted here for an operation reaching this particular access.
effect fn sourceIndependentAt(control: &SourceControlProjection, independent: CallerSource,
  loan: &Loan, point: usize, paths: &mut List<ReplacementReach>) -> CallerSource
! OutOfMemoryError ? &mut Allocator {
  if independent == CallerSource.Absent { return CallerSource.Absent }
  let points = List<Point>.asSlice(&control.points)
  if point >= points.length || loan.created >= points.length { return CallerSource.Unknown }
  if !run reachesAvoiding(points, &mut paths.*, loan.created, point, usize.MAX) { return CallerSource.Absent }
  if control.unresolved { return CallerSource.Unknown }
  return independent
}

// Common event query for the eventual conflict walk. Ordinary accesses retain whole-holder
// use; storage ends retain exact field-sensitive requirements and actual completion paths.
// Each reason remains distinguishable for diagnostic precedence and later-use attribution.
effect fn sourceLoanLiveAt<'body>(graph: &SourceGraphGraph<'body>, control: &SourceControlProjection,
  settled: &SourceSettledLoans, callers: &SourceCallerProjection, occupancy: &SourceLoanOccupancy,
  needs: &SourceLoanNeeds, holders: &SourceHolderLiveness, intervals: &[SourceIntervalProjection],
  views: &[SourceLifetimeProjection], viewMissing: SourceAtom, point: usize, storageEnd: bool,
  paths: &mut List<ReplacementReach>) -> SourceLiveAt ! OutOfMemoryError ? &mut Allocator {
  let loans = List<Loan>.asSlice(&settled.loans)
  let activities = List<SourceTruth>.asSlice(&settled.activity)
  let independent = List<CallerSource>.asSlice(&settled.independent)
  let index = occupancy.loan
  if index >= loans.length || activities.length != loans.length || independent.length != loans.length {
    return CompilerBug.panic(b"event liveness lost its settled loan acquisition")
  }
  if activities[index] == SourceTruth.False {
    return SourceLiveAt {flight: CallerSource.Absent, held: CallerSource.Absent,
      view: CallerSource.Absent, caller: CallerSource.Absent}
  }
  let loan = &loans[index]
  let flight = run sourceFlight(graph, control, intervals, index, point, storageEnd)
  let mut held = CallerSource.Absent
  if storageEnd { held = sourceHeldAt(control, occupancy, List<u64>.asSlice(&needs.liveOut), needs.unresolved, point) }
  else { held = sourceHeldAt(control, occupancy, List<u64>.asSlice(&holders.liveOut), holders.unresolved, point) }
  held = sourceLiveJoin(held, run sourceIndependentAt(control, independent[index], loan, point, &mut paths.*))
  if loan.until != usize.MAX {
    let points = List<Point>.asSlice(&control.points)
    if loan.until >= points.length || loan.created >= points.length || point >= points.length {
      held = sourceLiveJoin(held, CallerSource.Unknown)
    } else if run liveUntil(points, &mut paths.*, loan, point) {
      let mut actual = CallerSource.Actual
      if control.unresolved { actual = CallerSource.Unknown }
      held = sourceLiveJoin(held, actual)
    }
  }
  let mut view = sourceViewAt(graph, views, index, point, storageEnd)
  if SourceGraphGraph.truth(graph, viewMissing) != SourceTruth.False { view = sourceLiveJoin(view, CallerSource.Unknown) }
  let caller = sourceCallerAt(graph, callers, index, point)
  return SourceLiveAt {flight: sourceLiveActivity(flight, activities[index]),
    held: sourceLiveActivity(held, activities[index]), view: sourceLiveActivity(view, activities[index]),
    caller: sourceLiveActivity(caller, activities[index])}
}

fn sourceLiveEvidence(live: &SourceLiveAt) -> CallerSource {
  return sourceLiveJoin(sourceLiveJoin(live.flight, live.held), sourceLiveJoin(live.view, live.caller))
}

// One ordinary access against one actual acquisition. The caller visits loans in their
// reserved order and stops after a reported conflict, preserving the accepted diagnostic
// precedence. Storage ends have their separate stale-definition/required-use classifier.
effect fn sourceAccessLoan<'input, 'body, 'proof>(input: &SourceRegionInput<'input, 'body>,
  settled: &SourceSettledLoans, callers: &SourceCallerProjection, occupancy: &SourceLoanOccupancy,
  needs: &SourceLoanNeeds, holders: &SourceHolderLiveness, regions: &RegionSources<'proof>,
  chains: &[UnretainedChain], place: &Place, event: &Event, uncertain: bool, returnedEscape: bool,
  paths: &mut List<ReplacementReach>, contested: &mut List<Shared<Lifetime>>, reports: &mut List<Report>)
  -> SourceAccessDecision ! OutOfMemoryError ? &mut Allocator {
  let loans = List<Loan>.asSlice(&settled.loans)
  let index = occupancy.loan
  if index >= loans.length { return CompilerBug.panic(b"access classification lost its actual loan") }
  if event.kind == Kind.End || event.kind == Kind.Expire {
    return CompilerBug.panic(b"ordinary source access classifier received a storage end")
  }
  let loan = &loans[index]
  let mut result = SourceAccessDecision {reported: false, unresolved: false}
  if index == event.loan || (loan.bound && returnedEscape) || lentTo(loan, &event.binders) { return move result }
  let code = match conflictCode(event.kind, loan.exclusive) {
    Option<RejectionCode>.Some {value} => value
    _ => { return move result }
  }
  let selected = loanPlaceAccessOverlap(SourceGraphGraph.preparation(input.graph).body.locals, loan, place, event)
  if selected.overlap == usize.ZERO { return move result }
  let live = run sourceLoanLiveAt(input.graph, input.control, settled, callers, occupancy, needs, holders,
    input.intervals, input.views, input.viewMissing, event.point, false, &mut paths.*)
  let evidence = sourceLiveEvidence(&live)
  if evidence != CallerSource.Actual {
    if !run sourceContestedAt(input.graph, input.control, regions, chains, index, event.point,
      &mut paths.*, &mut contested.*) { result.unresolved = true }
    if evidence == CallerSource.Unknown { result.unresolved = true }
    return move result
  }
  if uncertain || !preciseLoanConflict(loan, selected, live.caller) {
    result.unresolved = true
    return move result
  }
  run addReport(&mut reports.*, Report {code: code, access: event.target, related: true, earlier: loan.origin})
  result.reported = true
  // A mutation of body storage can also leave an existing local descriptor expired. A
  // match-view binding reports its subject conflict only, as in the accepted classifier.
  if (event.kind == Kind.Write || event.kind == Kind.Move || event.kind == Kind.Drop)
    && loan.local && loan.binder == usize.MAX {
    let required = run sourceExpiredUse(input.graph, input.control, input.reads, index, event, true)
    if required.evidence == CallerSource.Unknown { result.unresolved = true }
    if required.evidence == CallerSource.Actual
      && (required.span.start != event.span.start || required.span.end != event.span.end) {
      run addReport(&mut reports.*, Report {code: expiredCode(), access: required.span, related: true, earlier: loan.origin})
    }
  }
  return move result
}

// Report the first actual semantic holder read in wraparound CFG point order.
// The owning handler supplied the span, original A/B and any write exclusion;
// incidental descriptor Copy reads are not semantic occurrences.
effect fn sourceExpiredUse<'body>(graph: &SourceGraphGraph<'body>, control: &SourceControlProjection,
  reads: &[SourceSemanticRead], loan: usize, event: &Event, localOnly: bool) -> SourceRequiredUse
! OutOfMemoryError ? &mut Allocator {
  let points = List<Point>.asSlice(&control.points)
  if event.point >= points.length { return CompilerBug.panic(b"expired source use has no actual end point") }
  let sourcePoints = List<SourceControl.Point>.asSlice(&SourceGraphGraph.control(graph).points)
  let endpoints = List<PreparedSources.Endpoint>.asSlice(&SourceGraphGraph.preparation(graph).endpoints)
  let mut result = SourceRequiredUse {evidence: CallerSource.Absent, span: event.span}
  let mut step = usize.ONE
  while step < points.length {
    let point = (event.point + step) % points.length
    if run pathReaches(points, event.point, point) {
      let mut at = usize.ZERO
      while at < reads.length {
        let row = &reads[at]
        if row.point == point && row.source.loan == loan {
          let owned = !localOnly || match &endpoints[row.owner.endpoint.index].root {
            PreparedSourcesRoot.Local {category, ..} if category == PreparedSourcesEndpointRole.Storage => true
            _ => false
          }
          if owned && sourceSettledDisposition(graph, row.source.definition) == SourceGraphSummaryDisposition.Ordinary {
            let mut active = sourceTruthAnd(SourceGraphGraph.truth(graph, row.active),
              SourceGraphGraph.truth(graph, sourcePoints[point].reachable))
            if let Option<SourceAtom>.Some {value: pair} = row.pair {
              active = sourceTruthAnd(active, SourceGraphGraph.truth(graph, pair))
            }
            if active != SourceTruth.False {
              if !row.supported { result.evidence = CallerSource.Unknown }
              else if row.required {
                if active == SourceTruth.Undefined || control.unresolved { result.evidence = CallerSource.Unknown }
                else { return SourceRequiredUse {evidence: CallerSource.Actual, span: row.span} }
              }
            }
          }
        }
        at = at + usize.ONE
      }
    }
    step = step + usize.ONE
  }
  return move result
}

// The accepted readKeeping path query, bounded by this exact canonical component's real
// strong definitions. Weak conditional writes do not manufacture a replacement. Possible
// activity or CFG edges remain unresolved instead of certifying a path through a rebind.
effect fn sourceReadKeeping<'body>(graph: &SourceGraphGraph<'body>, control: &SourceControlProjection,
  storage: &SourceStorageProjection, original: SourceGraph.DefinitionView, from: usize, to: usize, created: usize)
  -> CallerSource ! OutOfMemoryError ? &mut Allocator {
  let points = List<Point>.asSlice(&control.points)
  if from >= points.length || to >= points.length || created >= points.length { return CallerSource.Unknown }
  let mut rebound = List<bool>.make()
  let mut at = usize.ZERO
  while at < points.length { run List<bool>.append(&mut rebound, false) at = at + usize.ONE }
  let definitions = List<SourceStorageDefinition>.asSlice(&storage.definitions)
  let actualPoints = List<SourceControl.Point>.asSlice(&SourceGraphGraph.control(graph).points)
  let mut uncertain = control.unresolved
  at = usize.ZERO
  while at < definitions.length {
    let definition = definitions[at].definition
    if definition.point.index >= points.length { return CompilerBug.panic(b"canonical rebind has no actual defining point") }
    if definition.write == SourceControlWrite.Strong && sourceSameStorage(definition.storage, original.storage)
      && sourceSameSummary(definition.summary, original.summary) {
      let active = sourceTruthAnd(SourceGraphGraph.truth(graph, definition.active),
        SourceGraphGraph.truth(graph, actualPoints[definition.point.index].reachable))
      if active == SourceTruth.True {
        let mut reboundPoints = List<bool>.asMutSlice(&mut rebound)
        reboundPoints[definition.point.index] = true
      }
      if active == SourceTruth.Undefined { uncertain = true }
    }
    at = at + usize.ONE
  }
  if !run readKeeping(points, from, to, created, List<bool>.asSlice(&rebound)) { return CallerSource.Absent }
  if uncertain { return CallerSource.Unknown }
  return CallerSource.Actual
}

// A later physical definition can copy an expired value from an earlier read. Keep that
// exact paired source history, and require a future use of the actual new definition.
// Ownership uses actual definitions and never infers canonical addresses from result loans.
effect fn sourceStaleDefinition<'body>(graph: &SourceGraphGraph<'body>, control: &SourceControlProjection,
  storage: &SourceStorageProjection, occupancy: &SourceLoanOccupancy, needs: &SourceLoanNeeds,
  loan: &Loan, end: usize) -> SourceStaleDefinition ! OutOfMemoryError ? &mut Allocator {
  let definitions = List<SourceStorageDefinition>.asSlice(&storage.definitions)
  let points = List<Point>.asSlice(&control.points)
  let live = List<u64>.asSlice(&needs.liveOut)
  if end >= points.length || occupancy.width != (definitions.length + 63) / 64
    || live.length != points.length * occupancy.width {
    return CompilerBug.panic(b"stale source query lost its actual liveness inventory")
  }
  let mut result = SourceStaleDefinition {evidence: CallerSource.Absent, definition: Option<SourceControl.DefinitionId>.none()}
  if needs.unresolved || occupancy.unresolved || control.unresolved { result.evidence = CallerSource.Unknown }
  let mut at = usize.ZERO
  while at < definitions.length {
    let held = &definitions[at]
    if held.definition.id.index != at || held.definition.point.index >= points.length {
      return CompilerBug.panic(b"stale source query changed an actual definition identity")
    }
    if sourceSettledDisposition(graph, Option<SourceControl.DefinitionId>.some(held.definition.id)) != SourceGraphSummaryDisposition.Shadowed
      && reaches(live, occupancy.width, held.definition.point.index, at) {
      let members = List<SourceStoredLoan>.asSlice(&held.loans)
      let inputs = List<SourceGraph.Input>.asSlice(&held.inputs)
      let mut member = usize.ZERO
      while member < members.length {
        if members[member].loan == occupancy.loan {
          let present = SourceGraphGraph.truth(graph, members[member].active)
          if present != SourceTruth.False {
            let mut input = usize.ZERO
            while input < inputs.length {
              if inputs[input].leaf.index == members[member].leaf.index {
                let histories = List<SourceGraph.InputCase>.asSlice(&inputs[input].cases)
                let mut history = usize.ZERO
                while history < histories.length {
                  let source = &histories[history]
                  let mut active = sourceTruthAnd(present, SourceGraphGraph.truth(graph, source.quality.present))
                  if active != SourceTruth.False {
                    if let Option<SourceControl.DefinitionId>.Some {value: original} = source.definition {
                      if let Option<SourceControl.ReadId>.Some {value: read} = source.read {
                        let old = SourceGraphGraph.definition(graph, original)
                        let observed = SourceGraphGraph.read(graph, read)
                        if sourceSameReadLane(old, observed) {
                          if let Option<SourceAtom>.Some {value: pair} = sourceFlowPair(SourceGraphGraph.control(graph), original, read) {
                            active = sourceTruthAnd(active, SourceGraphGraph.truth(graph, pair))
                            if active != SourceTruth.False {
                              let keeping = run sourceReadKeeping(graph, control, storage, old,
                                end, observed.point.index, loan.created)
                              if keeping != CallerSource.Absent {
                                if keeping == CallerSource.Actual && active == SourceTruth.True
                                  && !needs.unresolved && !occupancy.unresolved {
                                  return SourceStaleDefinition {evidence: CallerSource.Actual,
                                    definition: Option<SourceControl.DefinitionId>.some(held.definition.id)}
                                }
                                result.evidence = CallerSource.Unknown
                              }
                            }
                          } else { result.evidence = CallerSource.Unknown }
                        } else { result.evidence = CallerSource.Unknown }
                      } else { result.evidence = CallerSource.Unknown }
                    } else if let Option<SourceControl.ReadId>.Some {..} = source.read { result.evidence = CallerSource.Unknown }
                  }
                  history = history + usize.ONE
                }
              }
              input = input + usize.ONE
            }
          }
        }
        member = member + usize.ONE
      }
    }
    at = at + usize.ONE
  }
  return move result
}

// A stale definition reports its actual defining operation before looking for a later use.
// The stored Value can have been evaluated earlier; it never supplies the writer's span.
effect fn sourceDefinitionUse<'body>(graph: &SourceGraphGraph<'body>, control: &SourceControlProjection,
  storage: &SourceStorageProjection, id: SourceControl.DefinitionId, fallback: Location)
  -> SourceRequiredUse ! OutOfMemoryError ? &mut Allocator {
  let definition = SourceGraphGraph.definition(graph, id)
  let prepared = SourceGraphGraph.preparation(graph)
  if let Option<SourceGraph.EvalId>.Some {value: writer} = definition.writer {
    let actual = SourceGraphGraph.evaluation(graph, writer)
    if actual.point.index != definition.point.index { return CompilerBug.panic(b"stale definition lost its actual writer point") }
    if let SourceGraphEvaluationSite.Node {node} = actual.site {
      let span = prepared.body.nodes[node.index].origin.location
      if span.end > span.start { return SourceRequiredUse {evidence: CallerSource.Actual, span: span} }
    } else { return CompilerBug.panic(b"body-entry definition acquired a node writer") }
  }
  let points = List<Point>.asSlice(&control.points)
  let reads = List<SourceGraph.ReadView>.asSlice(&storage.reads)
  let maps = List<PreparedSources.SelectionMap>.asSlice(&prepared.maps)
  let actualPoints = List<SourceControl.Point>.asSlice(&SourceGraphGraph.control(graph).points)
  let mut result = SourceRequiredUse {evidence: CallerSource.Absent, span: fallback}
  let mut step = usize.ONE
  while step < points.length {
    let point = (definition.point.index + step) % points.length
    if run pathReaches(points, definition.point.index, point) {
      let mut at = usize.ZERO
      while at < reads.length {
        let read = reads[at]
        if read.point.index == point && sourceSameReadLane(definition, read) {
          if let Option<SourceAtom>.Some {value: pair} = sourceFlowPair(SourceGraphGraph.control(graph), id, read.id) {
            let paired = sourceTruthAnd(SourceGraphGraph.truth(graph, pair), SourceGraphGraph.truth(graph, actualPoints[point].reachable))
            if paired != SourceTruth.False {
              let placementList = run SourceGraphGraph.readPlacementsByRead(graph, read.id)
              let placements = List<SourceGraph.ReadPlacement>.asSlice(&placementList)
              let mut each = usize.ZERO
              while each < placements.length {
                let placement = placements[each]
                let consumer = SourceGraphGraph.value(graph, placement.consumer)
                let evaluation = SourceGraphGraph.evaluation(graph, consumer.evaluation)
                if placement.read.index != read.id.index || consumer.phase != SourceGraphValuePhase.Input
                  || consumer.evaluation.index != placement.result.index || evaluation.point.index != point
                  || placement.map.index >= maps.length || maps[placement.map.index].kind != PreparedSourcesMapKind.Copy
                  || maps[placement.map.index].target.index != consumer.endpoint.index {
                  return CompilerBug.panic(b"stale definition use lost its original read consumer")
                }
                if sourcePlacementStorage(definition, read, SourceGraphGraph.read(graph, placement.original), placement,
                  List<PreparedSources.Endpoint>.asSlice(&prepared.endpoints)) {
                  let active = sourceTruthAnd(paired, SourceGraphGraph.truth(graph, placement.active))
                  if active != SourceTruth.False {
                    if active == SourceTruth.Undefined || control.unresolved { result.evidence = CallerSource.Unknown }
                    else if let SourceGraphEvaluationSite.Node {node} = evaluation.site {
                      return SourceRequiredUse {evidence: CallerSource.Actual, span: prepared.body.nodes[node.index].origin.location}
                    } else { result.evidence = CallerSource.Unknown }
                  }
                }
                each = each + usize.ONE
              }
            }
          }
        }
        at = at + usize.ONE
      }
    }
    step = step + usize.ONE
  }
  return move result
}

fn sourceTemporaryOwner(owners: &[SourceVisit.Owner], locals: usize, root: usize) -> bool {
  if root < locals || root - locals >= owners.length { return false }
  return match owners[root - locals].root { SourceVisitOwnerRoot.Temporary {..} => true _ => false }
}

// A storage end retains field-sensitive needs, current flight and copied stale histories.
// Unknown acquisition/control evidence cannot become a concrete expiration diagnostic.
effect fn sourceEndLoan<'input, 'body>(input: &SourceRegionInput<'input, 'body>, settled: &SourceSettledLoans,
  callers: &SourceCallerProjection, occupancy: &SourceLoanOccupancy, needs: &SourceLoanNeeds,
  holders: &SourceHolderLiveness, place: &Place, event: &Event, uncertain: bool, returnedEscape: bool,
  paths: &mut List<ReplacementReach>, reports: &mut List<Report>) -> SourceAccessDecision
! OutOfMemoryError ? &mut Allocator {
  let loans = List<Loan>.asSlice(&settled.loans)
  let activities = List<SourceTruth>.asSlice(&settled.activity)
  let index = occupancy.loan
  if index >= loans.length || activities.length != loans.length { return CompilerBug.panic(b"storage end lost its actual loan") }
  if event.kind != Kind.End && event.kind != Kind.Expire { return CompilerBug.panic(b"storage-end classifier received an ordinary access") }
  let loan = &loans[index]
  let mut result = SourceAccessDecision {reported: false, unresolved: false}
  if !loan.local || (loan.bound && returnedEscape) || !covers(&event.place, place)
    || activities[index] == SourceTruth.False { return move result }
  let live = run sourceLoanLiveAt(input.graph, input.control, settled, callers, occupancy, needs, holders,
    input.intervals, input.views, input.viewMissing, event.point, true, &mut paths.*)
  let evidence = sourceLiveEvidence(&live)
  let mut stale = SourceStaleDefinition {evidence: CallerSource.Absent, definition: Option<SourceControl.DefinitionId>.none()}
  if evidence != CallerSource.Actual {
    stale = run sourceStaleDefinition(input.graph, input.control, input.storage, occupancy, needs, loan, event.point)
  }
  if evidence != CallerSource.Actual && stale.evidence != CallerSource.Actual {
    result.unresolved = evidence == CallerSource.Unknown || stale.evidence == CallerSource.Unknown
    return move result
  }
  if uncertain || activities[index] != SourceTruth.True
    || loan.precision == LoanPrecision.Alternatives || loan.precision == LoanPrecision.Unknown {
    result.unresolved = true
    return move result
  }
  let mut required = SourceRequiredUse {evidence: CallerSource.Absent, span: event.span}
  if stale.evidence == CallerSource.Actual {
    let definition = match stale.definition {
      Option<SourceControl.DefinitionId>.Some {value} => value
      _ => { return CompilerBug.panic(b"actual stale source has no physical definition") }
    }
    required = run sourceDefinitionUse(input.graph, input.control, input.storage, definition, event.span)
  } else if live.flight != CallerSource.Actual || sourceTemporaryOwner(input.owners,
    SourceGraphGraph.preparation(input.graph).body.locals.length, place.root) {
    required = run sourceExpiredUse(input.graph, input.control, input.reads, index, event, false)
  }
  result.unresolved = required.evidence == CallerSource.Unknown
  run addReport(&mut reports.*, Report {code: expiredCode(), access: required.span, related: true, earlier: loan.origin})
  result.reported = true
  return move result
}

struct SourcePolicyRefusal {
  dispatch: usize
  point: SourceControl.PointId
  reason: BorrowStatus
  active: SourceAtom
}
struct SourceInheritedStatus {
  dispatch: usize
  status: BorrowStatus
  active: SourceAtom
}
struct SourceEscapePrecision {
  dispatch: usize
  qualities: List<SourceQuality>
}
struct SourceDispatchProjection {
  policy: SourcePolicyEffects
  holders: SourceHolderProjection
  outputs: List<SourceResultEffect>
  wholeHolds: List<SourceWholeHold>
  sealed: List<Location>
  unheld: List<Location>
  constructions: List<SourceInheritedStatus>
  blocks: List<SourceBlockBinding>
  ordinary: List<SourceOrdinaryUse>
  snapshots: List<SourceEscapePrecision>
  refusals: List<SourcePolicyRefusal>
}

effect<'env> fn sourceAppendEffects<T: 'env, 'env>(target: &mut List<T>, source: List<T>) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut incoming = move source
  while List<T>.length(&incoming) != usize.ZERO {
    run List<T>.append(&mut target.*, List<T>.remove(&mut incoming, usize.ZERO))
  }
  return ()
}

effect fn sourceDispatchMissing(state: &mut SourceDispatchProjection, missing: SourceAtom,
  rules: &mut SourceProgram) -> () ! OutOfMemoryError ? &mut Allocator {
  let gaps: [SourceAtom; 2] = [state.policy.missing, missing]
  state.policy.missing = run SourcePolicy.disjunction(&mut rules.*, &gaps)
  return ()
}

// Use the same retained ownership boundary as the acquisition's current-holder reads.
// Canonical referent address formation and the new loan's complete path stay separate.
fn sourceBorrowHolderInput<'body>(builder: &SourceGraphBuilder<'body>, visits: &[SourceVisit.Visit],
  input: SourceVisit.Input, acquisition: SourceGraph.EvalId) -> SourceVisit.Input {
  let references = SourceGraphBuilder.referenceCoverage(builder)
  let mut at = usize.ZERO
  while at < references.length {
    let origin = SourceGraphBuilder.reference(builder, references[at].reference)
    if origin.source.index == input.evaluation.index
      && SourceGraphBuilder.value(builder, origin.descriptor).evaluation.index == acquisition.index {
      if let Option<SourceGraph.ThroughDescriptor>.Some {value: descriptor} = origin.ownership {
        let crossing = sourceVisitAt(visits, descriptor.crossing)
        let operands = List<SourceVisit.Input>.asSlice(&crossing.inputs)
        if operands.length == usize.ZERO || operands[0].evaluation.index != descriptor.evaluation.index {
          return CompilerBug.panic(b"borrow holder boundary lost its actual descriptor input")
        }
        return operands[0]
      }
      return input
    }
    at = at + usize.ONE
  }
  return input
}

// A Local has an actual read even under Access.Place, retained by Traversal without an
// ownership Read event. Other selected places use their exact final storage endpoint.
// Neither form invents a current read merely to satisfy whole-holder demand.
effect fn sourceDispatchHolder<'body>(builder: &mut SourceGraphBuilder<'body>, node: NodeId,
  evaluation: SourceGraph.EvalId, point: SourceControl.PointId, place: bool, state: &mut SourceDispatchProjection)
  -> () ! OutOfMemoryError ? &mut Allocator {
  let prepared = SourceGraphBuilder.preparation(&builder.*)
  let local = match &prepared.body.nodes[node.index].kind {
    NodeKind.Expression {form: Expression.Local {..}, ..} => true
    _ => false
  }
  let mut category = PreparedSourcesEndpointRole.Value
  if place && !local { category = PreparedSourcesEndpointRole.Storage }
  let endpoints = List<PreparedSources.Endpoint>.asSlice(&prepared.endpoints)
  let mut root = usize.MAX
  let mut at = usize.ZERO
  while at < endpoints.length {
    let whole = match endpoints[at].parent { Option<PreparedSources.EndpointId>.None => true _ => false }
    let actual = match &endpoints[at].root {
      PreparedSourcesRoot.Node {node: original, category: originalRole} => original.index == node.index && originalRole == category
      _ => false
    }
    if whole && actual {
      if root != usize.MAX { return CompilerBug.panic(b"holder demand has duplicate occurrence roots") }
      root = at
    }
    at = at + usize.ONE
  }
  let active = List<SourceControl.Point>.asSlice(&builder.reaching.points)[point.index].reachable
  if root == usize.MAX {
    return run sourceDispatchMissing(&mut state.*, active, &mut builder.rules)
  }
  run List<SourceHolderRequest>.append(&mut state.policy.holderRequests, SourceHolderRequest {
    dispatch: usize.MAX, owner: Option<SourceVisit.OwnerId>.none(), evaluation: evaluation,
    root: PreparedSources.EndpointId {index: root}, point: point, active: active})
  return ()
}

// A hidden temporary can hide the authored path root without removing the actual
// descriptor crossing. Select its read handler from that retained occurrence, never
// from a positive alias or the projected result's source contents.
fn sourceThroughReadBoundary<'body>(builder: &SourceGraphBuilder<'body>, evaluation: SourceGraph.EvalId,
  point: SourceControl.PointId) -> bool {
  let directives = SourceGraphBuilder.resultUses(builder)
  let mut read = false
  let mut at = usize.ZERO
  while at < directives.length {
    if directives[at].evaluation.index == evaluation.index {
      if let SourceGraphResultKind.Read {read: original} = directives[at].kind {
        if original.index == evaluation.index { read = true }
      }
    }
    at = at + usize.ONE
  }
  if !read { return false }
  let requests = SourceGraphBuilder.throughFlightRequests(builder)
  at = usize.ZERO
  while at < requests.length {
    let request = requests[at]
    if request.operation.index == evaluation.index && request.kind == SourceGraphThroughFlightKind.Read {
      if request.target.index != evaluation.index || request.evaluation.index != evaluation.index
        || SourceGraphBuilder.evaluation(builder, request.evaluation).point.index != point.index {
        return CompilerBug.panic(b"through read boundary changed its actual value occurrence")
      }
      if let Option<SourceGraph.ThroughDescriptor>.Some {..} = request.descriptor { return true }
    }
    at = at + usize.ONE
  }
  return false
}

// A through read uses the holder of its original descriptor, before the first
// Referent. The projected value is not evidence of canonical pointee storage.
// Keep every observation's coverage even when another alias names a valid owner.
effect fn sourceDispatchThroughHolder<'body>(builder: &mut SourceGraphBuilder<'body>,
  evaluation: SourceGraph.EvalId, point: SourceControl.PointId, holders: &mut SourceHolderProjection)
  -> () ! OutOfMemoryError ? &mut Allocator {
  let active = List<SourceControl.Point>.asSlice(&builder.reaching.points)[point.index].reachable
  let empty = List<SourceAtom>.make()
  let none = List<SourceAtom>.asSlice(&empty)
  let mut gaps = List<SourceAtom>.make()
  run List<SourceAtom>.append(&mut gaps, holders.missing)
  let mut covered = List<SourceAtom>.make()
  let mut found = false
  let mut at = usize.ZERO
  while at < SourceGraphBuilder.throughFlightRequests(&builder.*).length {
    let request = SourceGraphBuilder.throughFlightRequests(&builder.*)[at]
    if request.operation.index == evaluation.index && request.kind == SourceGraphThroughFlightKind.Read {
      if found || request.evaluation.index != evaluation.index || request.target.index != evaluation.index
        || SourceGraphBuilder.evaluation(&builder.*, request.evaluation).point.index != point.index {
        return CompilerBug.panic(b"through holder demand changed its actual value-read occurrence")
      }
      found = true
      let missing: [SourceAtom; 2] = [active, request.missing]
      run List<SourceAtom>.append(&mut gaps, run SourcePolicy.conjunction(&mut builder.rules, &missing, none))
      let mut row = usize.ZERO
      while row < SourceGraphBuilder.throughFlightObservations(&builder.*).length {
        let observation = SourceGraphBuilder.throughFlightObservations(&builder.*)[row]
        if observation.request == at {
          let coverage = SourceGraphBuilder.throughFlightCoverage(&builder.*)[row]
          if coverage.observation != row {
            return CompilerBug.panic(b"through holder demand lost its original descriptor coverage")
          }
          let guards: [SourceAtom; 3] = [active, request.active, observation.active]
          let used = run SourcePolicy.conjunction(&mut builder.rules, &guards, none)
          run List<SourceAtom>.append(&mut covered, used)
          let incomplete: [SourceAtom; 2] = [used, coverage.missing]
          run List<SourceAtom>.append(&mut gaps, run SourcePolicy.conjunction(&mut builder.rules, &incomplete, none))
          let holder = List<SourceHolderRequest>.length(&holders.requests)
          run List<SourceHolderRequest>.append(&mut holders.requests, SourceHolderRequest {
            dispatch: usize.MAX, owner: Option<SourceVisit.OwnerId>.none(), evaluation: request.evaluation,
            root: observation.owner.endpoint, point: point, active: used})
          run List<SourceHolderUse>.append(&mut holders.uses, SourceHolderUse {
            request: holder, storage: observation.owner, active: used})
        }
        row = row + usize.ONE
      }
    }
    at = at + usize.ONE
  }
  let required: [SourceAtom; 1] = [active]
  run List<SourceAtom>.append(&mut gaps,
    run SourcePolicy.conjunction(&mut builder.rules, &required, List<SourceAtom>.asSlice(&covered)))
  holders.missing = run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&gaps))
  return ()
}

// Retaining reads and bare Local reads need the same semantic-use record as scalar
// reads. Only the owning Value occurrence reaches here; address operands do not.
effect fn sourceRecordValueRead<'body>(builder: &mut SourceGraphBuilder<'body>, actual: &SourceVisit.Visit,
  active: SourceAtom, paths: &mut List<List<Step>>, loans: usize, holders: &mut SourceHolderProjection)
  -> () ! OutOfMemoryError ? &mut Allocator {
  let nodes = SourceGraphBuilder.preparation(&builder.*).body.nodes
  let span = nodes[actual.node.index].origin.location
  let empty = List<SourceAtom>.make()
  let none = List<SourceAtom>.asSlice(&empty)
  let mut found = false
  let mut at = usize.ZERO
  while at < SourceGraphBuilder.throughFlightObservations(&builder.*).length {
    let row = SourceGraphBuilder.throughFlightObservations(&builder.*)[at]
    let request = SourceGraphBuilder.throughFlightRequests(&builder.*)[row.request]
    if request.operation.index == actual.evaluation.index && request.kind == SourceGraphThroughFlightKind.Read {
      if request.evaluation.index != actual.evaluation.index { return CompilerBug.panic(b"value holder read changed its action") }
      found = true
      let mut prior = usize.ZERO
      while prior < at {
        let earlier = SourceGraphBuilder.throughFlightObservations(&builder.*)[prior]
        if earlier.request == row.request && sourceSameStorage(earlier.owner, row.owner) { break }
        prior = prior + usize.ONE
      }
      if prior == at {
        let observed = run sourceObserveThrough(&mut builder.*, at, &mut paths.*, loans)
        run sourceRecordReadAlternatives(&mut builder.*, &observed.observation, SourceSemanticReadOrigin.Through {observation: at},
          actual.evaluation, span, active, &mut paths.*, &mut holders.*)
      }
    }
    at = at + usize.ONE
  }
  let requests = SourceGraphBuilder.throughFlightRequests(&builder.*)
  let mut request = usize.ZERO
  while request < requests.length {
    if requests[request].operation.index == actual.evaluation.index && requests[request].kind == SourceGraphThroughFlightKind.Read {
      found = true
    }
    request = request + usize.ONE
  }
  if found { return () }
  at = usize.ZERO
  while at < SourceGraphBuilder.readFlightObservations(&builder.*).length {
    let row = SourceGraphBuilder.readFlightObservations(&builder.*)[at]
    if row.evaluation.index == actual.evaluation.index {
      found = true
      let mut prior = usize.ZERO
      while prior < at {
        let earlier = SourceGraphBuilder.readFlightObservations(&builder.*)[prior]
        if earlier.evaluation.index == actual.evaluation.index && sourceSameStorage(earlier.owner, row.owner) { break }
        prior = prior + usize.ONE
      }
      if prior == at {
        let observed = run sourceObserveReadFlight(&mut builder.*, at, &mut paths.*, loans)
        run sourceRecordReadAlternatives(&mut builder.*, &observed.observation, SourceSemanticReadOrigin.Flight {observation: at},
          actual.evaluation, span, active, &mut paths.*, &mut holders.*)
      }
    }
    at = at + usize.ONE
  }
  if found { return () }
  let local = match &nodes[actual.node.index].kind {
    NodeKind.Expression {form: Expression.Local {..}, ..} => true
    _ => false
  }
  if !local { return () }
  // A bare local has no ResultUse, but readLocal retained its genuine incoming Copy.
  // Restrict attribution to that consumer, rather than scanning every physical read.
  let root = sourceNodeValueRoot(SourceGraphBuilder.preparation(&builder.*), actual.node)
  let operands: [SourceOperand; 1] = [SourceOperand {node: actual.node, evaluation: actual.evaluation, root: root, ordinal: usize.MAX}]
  let observed = run sourceObserve(&mut builder.*, &operands, SourceGraphValuePhase.Input, &mut paths.*, loans, false, Option<usize>.none())
  let positions = List<SourceCarryPosition>.asSlice(&observed.positions)
  let mut seen = List<usize>.make()
  at = usize.ZERO
  while at < positions.length {
    let histories = List<SourceCarryCase>.asSlice(&positions[at].cases)
    let mut each = usize.ZERO
    while each < histories.length {
      if let Option<SourceControl.ReadId>.Some {value: read} = histories[each].source.read {
        if !listsIndex(List<usize>.asSlice(&seen), read.index) {
          run List<usize>.append(&mut seen, read.index)
          let placementList = run SourceGraphBuilder.readPlacementsByRead(&builder.*, read)
          let placements = List<SourceGraph.ReadPlacement>.asSlice(&placementList)
          let mut place = usize.ZERO
          while place < placements.length {
            let placement = placements[place]
            let consumer = SourceGraphBuilder.value(&builder.*, placement.consumer)
            if consumer.evaluation.index == actual.evaluation.index && placement.result.index == actual.evaluation.index {
              if let Option<SourceGraph.Storage>.Some {value: owner} = sourceStorageRoot(
                List<PreparedSources.Endpoint>.asSlice(&SourceGraphBuilder.preparation(&builder.*).endpoints), placement.storage) {
                let gates: [SourceAtom; 2] = [active, placement.active]
                let used = run SourcePolicy.conjunction(&mut builder.rules, &gates, none)
                run sourceRecordHolderRead(&mut builder.*, &observed, SourceSemanticReadOrigin.Copy {placement: placement},
                  owner, Option<SourceGraph.Storage>.some(placement.storage), Option<SourceGraph.Storage>.none(),
                  actual.evaluation, span, used, &mut paths.*, &mut holders.*)
              }
            }
            place = place + usize.ONE
          }
        }
      }
      each = each + usize.ONE
    }
    at = at + usize.ONE
  }
  return ()
}

// Consumed places have an actual owner read at the Move execution, before invalidation.
// The operand's earlier address evaluation is not the semantic use of the holder.
effect fn sourceRecordMoveRead<'body>(builder: &mut SourceGraphBuilder<'body>, actual: &SourceVisit.Visit,
  paths: &mut List<List<Step>>, loans: usize, holders: &mut SourceHolderProjection)
  -> () ! OutOfMemoryError ? &mut Allocator {
  let span = SourceGraphBuilder.preparation(&builder.*).body.nodes[actual.node.index].origin.location
  let empty = List<SourceAtom>.make()
  let none = List<SourceAtom>.asSlice(&empty)
  let mut at = usize.ZERO
  while at < SourceGraphBuilder.moveObservations(&builder.*).length {
    let row = SourceGraphBuilder.moveObservations(&builder.*)[at]
    let request = SourceGraphBuilder.selectedMoves(&builder.*)[row.request]
    if request.result.index == actual.evaluation.index {
      let gates: [SourceAtom; 2] = [request.active, row.active]
      let used = run SourcePolicy.conjunction(&mut builder.rules, &gates, none)
      let mut observed = SourceObservation {positions: List<SourceCarryPosition>.make(), other: List<SourceGraph.Input>.make(),
        unknown: SourceProgram.atom(&mut builder.rules)}
      let mut reading = usize.ZERO
      while reading < SourceGraphBuilder.moveReads(&builder.*).length {
        let current = SourceGraphBuilder.moveReads(&builder.*)[reading]
        if current.observation == at {
          let operand = SourceOperand {node: actual.node, evaluation: request.execution, root: row.owner.endpoint, ordinal: usize.MAX}
          let mut present = List<SourceAtom>.make()
          run sourceObserveValue(&mut builder.*, &mut observed, operand, current.value, &mut paths.*, loans, &mut present,
            sourceSameStorage(current.storage, row.owner), Option<SourceControl.ReadId>.some(current.read))
        }
        reading = reading + usize.ONE
      }
      run sourceRecordHolderRead(&mut builder.*, &observed, SourceSemanticReadOrigin.Move {observation: at}, row.owner,
        Option<SourceGraph.Storage>.some(row.storage), Option<SourceGraph.Storage>.none(), request.execution, span, used,
        &mut paths.*, &mut holders.*)
    }
    at = at + usize.ONE
  }
  return ()
}

// A consumed Drop observes current storage at its own action point. The earlier
// operand evaluated an address; it is not the value being destroyed now.
effect fn sourceObserveDrop<'body>(builder: &mut SourceGraphBuilder<'body>, selected: usize,
  paths: &mut List<List<Step>>, loans: usize) -> SourceThroughObservation ! OutOfMemoryError ? &mut Allocator {
  let original = SourceGraphBuilder.dropObservations(&builder.*)[selected]
  let request = SourceGraphBuilder.consumedDrops(&builder.*)[original.request]
  let evaluation = SourceGraphBuilder.evaluation(&builder.*, request.evaluation)
  let node = match evaluation.site { SourceGraphEvaluationSite.Node {node} => node
    _ => { return CompilerBug.panic(b"Drop holder has no actual action expression") } }
  let empty = List<SourceAtom>.make()
  let none = List<SourceAtom>.asSlice(&empty)
  let mut active = List<SourceAtom>.make()
  let mut reads = List<SourceGraph.DropRead>.make()
  let mut at = usize.ZERO
  while at < SourceGraphBuilder.dropObservations(&builder.*).length {
    let row = SourceGraphBuilder.dropObservations(&builder.*)[at]
    if row.request == original.request && sourceSameStorage(row.owner, original.owner) {
      run List<SourceAtom>.append(&mut active, row.active)
      let recorded = SourceGraphBuilder.dropReads(&builder.*)
      let mut each = usize.ZERO
      while each < recorded.length {
        if recorded[each].observation == at {
          let previous = List<SourceGraph.DropRead>.asSlice(&reads)
          let mut seen = usize.ZERO
          while seen < previous.length && previous[seen].read.index != recorded[each].read.index { seen = seen + usize.ONE }
          if seen == previous.length { run List<SourceGraph.DropRead>.append(&mut reads, recorded[each]) }
        }
        each = each + usize.ONE
      }
    }
    at = at + usize.ONE
  }
  let used = run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&active))
  let unknown = SourceProgram.atom(&mut builder.rules)
  let mut observed = SourceObservation {positions: List<SourceCarryPosition>.make(), other: List<SourceGraph.Input>.make(), unknown: unknown}
  let mut roots = usize.ZERO
  at = usize.ZERO
  while at < List<SourceGraph.DropRead>.length(&reads) {
    let actual = List<SourceGraph.DropRead>.asSlice(&reads)[at]
    let read = SourceGraphBuilder.read(&builder.*, actual.read)
    let value = SourceGraphBuilder.value(&builder.*, actual.value)
    if value.phase != SourceGraphValuePhase.Input || !sourcePhysicalValue(value)
      || value.evaluation.index != request.evaluation.index || read.point.index != request.point.index
      || evaluation.point.index != request.point.index || read.value.index != actual.value.index
      || !sourceSameStorage(read.storage, actual.storage) {
      return CompilerBug.panic(b"Drop holder substituted an earlier operand or post-invalidation value")
    }
    let whole = sourceSameStorage(actual.storage, original.owner)
    if whole { roots = roots + usize.ONE }
    let operand = SourceOperand {node: node, evaluation: request.evaluation, root: original.owner.endpoint, ordinal: usize.MAX}
    let mut present = List<SourceAtom>.make()
    run sourceObserveValue(&mut builder.*, &mut observed, operand, actual.value, &mut paths.*, loans,
      &mut present, whole, Option<SourceControl.ReadId>.some(actual.read))
    let required: [SourceAtom; 1] = [used]
    run SourceProgram.rule(&mut builder.rules, unknown, &required, List<SourceAtom>.asSlice(&present))
    at = at + usize.ONE
  }
  if roots != usize.ONE { let required: [SourceAtom; 1] = [used]
    run SourceProgram.rule(&mut builder.rules, unknown, &required, none) }
  return SourceThroughObservation {observation: move observed, active: used}
}

effect fn sourceDrop<'body>(builder: &mut SourceGraphBuilder<'body>, actual: &SourceVisit.Visit,
  state: &mut SourceDispatchProjection, loans: &[Loan], paths: &mut List<List<Step>>) -> ()
! OutOfMemoryError ? &mut Allocator {
  let inputs = List<SourceVisit.Input>.asSlice(&actual.inputs)
  if inputs.length != usize.ONE || inputs[0].access != SourceVisitAccess.Place {
    return CompilerBug.panic(b"consumed Drop lost its actual place operand")
  }
  let active = List<SourceControl.Point>.asSlice(&builder.reaching.points)[actual.execute.index].reachable
  let span = SourceGraphBuilder.preparation(&builder.*).body.nodes[actual.node.index].origin.location
  let empty = List<SourceAtom>.make()
  let none = List<SourceAtom>.asSlice(&empty)
  let mut found = false
  let mut at = usize.ZERO
  while at < SourceGraphBuilder.consumedDrops(&builder.*).length {
    let request = SourceGraphBuilder.consumedDrops(&builder.*)[at]
    if request.evaluation.index == actual.evaluation.index {
      if found || request.point.index != actual.execute.index || request.source.index != inputs[0].evaluation.index {
        return CompilerBug.panic(b"consumed Drop changed its actual owner-read occurrence")
      }
      if true {
        let endpoints = List<PreparedSources.Endpoint>.asSlice(&SourceGraphBuilder.preparation(&builder.*).endpoints)
        let endpoint = &endpoints[request.root.index]
        let original = match &endpoint.root {
          PreparedSourcesRoot.Node {node, category} => node.index == inputs[0].node.index && category == PreparedSourcesEndpointRole.Storage
          _ => false
        }
        if !original || match endpoint.parent { Option<PreparedSources.EndpointId>.Some {..} => true _ => false } {
          return CompilerBug.panic(b"Drop observation changed its original operand storage family")
        }
      }
      found = true
      let coverage = SourceGraphBuilder.dropCoverage(&builder.*)[at]
      if coverage.request != at { return CompilerBug.panic(b"Drop coverage changed its actual request") }
      let gap: [SourceAtom; 3] = [active, coverage.active, coverage.missing]
      run sourceDispatchMissing(&mut state.*, run SourcePolicy.conjunction(&mut builder.rules, &gap, none), &mut builder.rules)
      let mut covered = List<SourceAtom>.make()
      let mut row = usize.ZERO
      while row < SourceGraphBuilder.dropObservations(&builder.*).length {
        let original = SourceGraphBuilder.dropObservations(&builder.*)[row]
        if original.request != at { row = row + usize.ONE continue }
        let mut prior = usize.ZERO
        while prior < row {
          let earlier = SourceGraphBuilder.dropObservations(&builder.*)[prior]
          if earlier.request == at && sourceSameStorage(earlier.owner, original.owner) { break }
          prior = prior + usize.ONE
        }
        if prior == row {
          let observed = run sourceObserveDrop(&mut builder.*, row, &mut paths.*, loans.length)
          let gates: [SourceAtom; 3] = [active, request.active, observed.active]
          let used = run SourcePolicy.conjunction(&mut builder.rules, &gates, none)
          run List<SourceAtom>.append(&mut covered, used)
          let no = SourceProgram.atom(&mut builder.rules)
          let mut effects = SourceStoreEffects {intervals: List<SourceIntervalEffect>.make(), refusal: no, missing: no}
          run sourceRecordReadAlternatives(&mut builder.*, &observed.observation, SourceSemanticReadOrigin.Drop {observation: row},
            request.evaluation, span, used, &mut paths.*, &mut state.holders)
          run sourceUseObservedHolder(&mut builder.*, &observed.observation, original.owner, request.evaluation,
            Option<SourceVisit.OwnerId>.none(), used, &mut state.policy.state, &mut state.holders, &mut effects)
          run sourceConsume(&observed.observation, actual.execute.index, used, &mut builder.rules, &mut effects.intervals)
          run sourceDispatchMissing(&mut state.*, effects.missing, &mut builder.rules)
          run sourceAppendEffects<SourceIntervalEffect>(&mut state.policy.intervals, move effects.intervals)
        }
        row = row + usize.ONE
      }
      let required: [SourceAtom; 2] = [active, request.active]
      run sourceDispatchMissing(&mut state.*, run SourcePolicy.conjunction(&mut builder.rules, &required,
        List<SourceAtom>.asSlice(&covered)), &mut builder.rules)
    }
    at = at + usize.ONE
  }
  if !found { run sourceDispatchMissing(&mut state.*, active, &mut builder.rules) }
  return ()
}

// A semantic consume names the actual operand and boundary supplied by Traversal. In
// particular a settled boundary is after cleanup, while a deferred input use is before it.
fn sourceFlightInput(nodes: &[Node], visits: &[SourceVisit.Visit], input: SourceVisit.Input) -> Option<SourceVisit.Input> {
  let mut selected = input
  let mut remaining = visits.length + usize.ONE
  while remaining > usize.ZERO {
    match &nodes[selected.node.index].kind {
      NodeKind.Expression {..} => { return Option<SourceVisit.Input>.some(selected) }
      NodeKind.Block {statements, ..} => {
        let actual = sourceVisitAt(visits, selected.evaluation)
        let inputs = List<SourceVisit.Input>.asSlice(&actual.inputs)
        if inputs.length != List<NodeId>.length(&statements) { return CompilerBug.panic(b"block flight lost its actual statement occurrences") }
        if inputs.length == usize.ZERO { return Option<SourceVisit.Input>.none() }
        selected = inputs[inputs.length - usize.ONE]
      }
      // Statements have no value result. Their own consumes, stores and exits are handled
      // at their semantic dispatch action; no source leaf is manufactured for an empty flow.
      _ => { return Option<SourceVisit.Input>.none() }
    }
    remaining = remaining - usize.ONE
  }
  return CompilerBug.panic(b"block flight repeats its actual enclosing occurrence")
}

effect fn sourceDispatchConsume<'body>(builder: &mut SourceGraphBuilder<'body>, visits: &[SourceVisit.Visit], input: SourceVisit.Input,
  point: SourceControl.PointId, crossing: bool, state: &mut SourceDispatchProjection,
  loans: &[Loan], paths: &mut List<List<Step>>) -> () ! OutOfMemoryError ? &mut Allocator {
  let input = match sourceFlightInput(SourceGraphBuilder.preparation(&builder.*).body.nodes, visits, input) {
    Option<SourceVisit.Input>.Some {value} => value
    _ => { return () }
  }
  let root = sourceNodeValueRoot(SourceGraphBuilder.preparation(&builder.*), input.node)
  let operand: [SourceOperand; 1] = [SourceOperand {node: input.node, evaluation: input.evaluation,
    root: root, ordinal: usize.ZERO}]
  let observation = run sourceObserve(&mut builder.*, &operand, SourceGraphValuePhase.Output, &mut paths.*, loans.length, false, Option<usize>.none())
  let active = List<SourceControl.Point>.asSlice(&builder.reaching.points)[point.index].reachable
  drop run sourceBarrier(&observation, &mut state.policy.state, active, &mut builder.rules)
  let empty = List<SourceAtom>.make()
  let gates: [SourceAtom; 2] = [active, observation.unknown]
  let missing = run SourcePolicy.conjunction(&mut builder.rules, &gates, List<SourceAtom>.asSlice(&empty))
  run sourceDispatchMissing(&mut state.*, missing, &mut builder.rules)
  if crossing {
    let joined = run sourceRejoin(&observation, loans, point.index, active, &mut builder.rules)
    run sourceAppendEffects<SourceIntervalEffect>(&mut state.policy.intervals, move joined.intervals)
    run sourceAppendEffects<SourceCrossingEffect>(&mut state.policy.crossings, move joined.crossings)
  } else {
    run sourceConsume(&observation, point.index, active, &mut builder.rules, &mut state.policy.intervals)
  }
  return ()
}

// The match tests its subject before any binding, guard or arm. A borrowed rvalue observes
// the exact viewed descriptor occurrence retained by acquisition preparation; it does not
// manufacture a reference result or use the enclosing match's later successful result.
effect fn sourceMatchSubject<'body>(builder: &mut SourceGraphBuilder<'body>, actual: &SourceVisit.Visit,
  views: &[SourceMatchView], state: &mut SourceDispatchProjection,
  loans: &[Loan], paths: &mut List<List<Step>>) -> () ! OutOfMemoryError ? &mut Allocator {
  let inputs = List<SourceVisit.Input>.asSlice(&actual.inputs)
  if inputs.length == usize.ZERO { return CompilerBug.panic(b"match subject lost its actual input") }
  let input = inputs[0]
  let root = sourceNodeValueRoot(SourceGraphBuilder.preparation(&builder.*), input.node)
  let mut operand = SourceOperand {node: input.node, evaluation: input.evaluation, root: root, ordinal: usize.ZERO}
  let mut found = false
  let mut at = usize.ZERO
  while at < views.length {
    if views[at].result.index == actual.evaluation.index {
      if found || views[at].source.index != input.evaluation.index || views[at].point.index != input.usePoint.index {
        return CompilerBug.panic(b"match subject changed its actual view acquisition")
      }
      found = true
      if let SourceViewOrigin.Carried {operand: viewed} = &views[at].origin { operand = viewed }
    }
    at = at + usize.ONE
  }
  let operands: [SourceOperand; 1] = [operand]
  let observation = run sourceObserve(&mut builder.*, &operands, SourceGraphValuePhase.Output, &mut paths.*, loans.length, false, Option<usize>.none())
  let active = List<SourceControl.Point>.asSlice(&builder.reaching.points)[input.usePoint.index].reachable
  drop run sourceBarrier(&observation, &mut state.policy.state, active, &mut builder.rules)
  let empty = List<SourceAtom>.make()
  let unknown: [SourceAtom; 2] = [active, observation.unknown]
  run sourceDispatchMissing(&mut state.*, run SourcePolicy.conjunction(&mut builder.rules, &unknown,
    List<SourceAtom>.asSlice(&empty)), &mut builder.rules)
  run sourceConsume(&observation, input.usePoint.index, active, &mut builder.rules, &mut state.policy.intervals)
  // Physical subject ownership and authored borrowed-view lifetime are already separate
  // reserved relations. A place use still owes the whole canonical holder demand.
  if input.access == SourceVisitAccess.Place {
    run sourceDispatchHolder(&mut builder.*, input.node, input.evaluation, input.usePoint, true, &mut state.*)
  }
  return ()
}

// A materialized temporary owns its actual result at this acquisition, independently of
// later owner-use demands. It consumes that flight once and retains it only by its type.
effect fn sourceTemporaryMaterialization<'body>(builder: &mut SourceGraphBuilder<'body>, actual: &SourceVisit.Visit,
  owners: &[SourceVisit.Owner], state: &mut SourceDispatchProjection, loans: &[Loan], paths: &mut List<List<Step>>) -> ()
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut found = false
  let mut at = usize.ZERO
  while at < owners.length {
    if let SourceVisitOwnerRoot.Temporary {evaluation} = owners[at].root {
      if evaluation.index == actual.evaluation.index {
        let acquired = SourceGraphBuilder.evaluation(&builder.*, evaluation)
        if found || actual.access != SourceVisitAccess.Place || owners[at].initialized.index != acquired.point.index {
          return CompilerBug.panic(b"temporary materialization changed its actual owner acquisition")
        }
        found = true
        let prepared = SourceGraphBuilder.preparation(&builder.*)
        let retained = run nodeRetains(prepared.body.nodes, actual.node, prepared.body.owner)
        let root = sourceNodeValueRoot(prepared, actual.node)
        let operand: [SourceOperand; 1] = [SourceOperand {node: actual.node, evaluation: evaluation, root: root, ordinal: usize.MAX}]
        let observation = run sourceObserve(&mut builder.*, &operand, SourceGraphValuePhase.Output, &mut paths.*, loans.length, false, Option<usize>.none())
        let active = List<SourceControl.Point>.asSlice(&builder.reaching.points)[acquired.point.index].reachable
        drop run sourceBarrier(&observation, &mut state.policy.state, active, &mut builder.rules)
        let empty = List<SourceAtom>.make()
        let gaps: [SourceAtom; 2] = [active, observation.unknown]
        run sourceDispatchMissing(&mut state.*, run SourcePolicy.conjunction(&mut builder.rules, &gaps,
          List<SourceAtom>.asSlice(&empty)), &mut builder.rules)
        run sourceConsume(&observation, acquired.point.index, active, &mut builder.rules, &mut state.policy.intervals)
        run List<SourceOrdinaryUse>.append(&mut state.ordinary, SourceOrdinaryUse {writer: evaluation, active: active, retained: retained})
      }
    }
    at = at + usize.ONE
  }
  return ()
}

// Owned subject snapshots are distinct writers even when their operand was a Local. The
// matching InputComplete authorizes that snapshot; the match/disposal handler owns consume.
effect fn sourceSubjectMaterialization<'body>(builder: &mut SourceGraphBuilder<'body>, actual: &SourceVisit.Visit,
  input: SourceVisit.Input, subjects: &[SourceVisit.Subject], owners: &[SourceVisit.Owner],
  uses: &mut List<SourceOrdinaryUse>) -> () ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut at = usize.ZERO
  while at < subjects.length {
    let subject = subjects[at]
    if subject.owned && subject.site.index == actual.node.index && subject.source.index == input.evaluation.index {
      let acquired = SourceGraphBuilder.evaluation(&builder.*, subject.evaluation)
      if subject.node.index != input.node.index || acquired.category != SourceGraphEvaluationRole.Binding
        || acquired.point.index != input.usePoint.index {
        return CompilerBug.panic(b"subject materialization changed its actual input completion")
      }
      let mut found = false
      let mut owner = usize.ZERO
      while owner < owners.length {
        if let SourceVisitOwnerRoot.Subject {node, evaluation} = owners[owner].root {
          if evaluation.index == subject.evaluation.index {
            if found || node.index != subject.node.index || owners[owner].initialized.index != acquired.point.index {
              return CompilerBug.panic(b"subject materialization changed its physical owner")
            }
            found = true
          }
        }
        owner = owner + usize.ONE
      }
      if !found { return CompilerBug.panic(b"owned subject materialization has no actual owner") }
      let prepared = SourceGraphBuilder.preparation(&builder.*)
      let retained = run nodeRetains(prepared.body.nodes, subject.node, prepared.body.owner)
      let active = List<SourceControl.Point>.asSlice(&builder.reaching.points)[acquired.point.index].reachable
      run List<SourceOrdinaryUse>.append(&mut uses.*, SourceOrdinaryUse {writer: subject.evaluation, active: active, retained: retained})
    }
    at = at + usize.ONE
  }
  return ()
}

// A while body cannot yield a carried value. Its real completion point, not the loop's
// preallocated exit or an absent successful result, guards this inherited refusal.
effect fn sourceLoopResult<'body>(builder: &mut SourceGraphBuilder<'body>, visits: &[SourceVisit.Visit], input: SourceVisit.Input,
  dispatch: usize, state: &mut SourceDispatchProjection, loans: &[Loan], paths: &mut List<List<Step>>)
  -> () ! OutOfMemoryError ? &mut Allocator {
  let completed = input.completed
  let input = match sourceFlightInput(SourceGraphBuilder.preparation(&builder.*).body.nodes, visits, input) {
    Option<SourceVisit.Input>.Some {value} => value
    _ => { return () }
  }
  let root = sourceNodeValueRoot(SourceGraphBuilder.preparation(&builder.*), input.node)
  let operand: [SourceOperand; 1] = [SourceOperand {node: input.node, evaluation: input.evaluation,
    root: root, ordinal: usize.ZERO}]
  let observation = run sourceObserve(&mut builder.*, &operand, SourceGraphValuePhase.Output, &mut paths.*, loans.length, false, Option<usize>.none())
  let active = List<SourceControl.Point>.asSlice(&builder.reaching.points)[completed.index].reachable
  drop run sourceBarrier(&observation, &mut state.policy.state, active, &mut builder.rules)
  let empty = List<SourceAtom>.make()
  let none = List<SourceAtom>.asSlice(&empty)
  let unknown: [SourceAtom; 2] = [active, observation.unknown]
  run sourceDispatchMissing(&mut state.*, run SourcePolicy.conjunction(&mut builder.rules, &unknown, none), &mut builder.rules)
  let mut present = List<SourceAtom>.make()
  let positions = List<SourceCarryPosition>.asSlice(&observation.positions)
  let mut at = usize.ZERO
  while at < positions.length {
    let gates: [SourceAtom; 2] = [active, positions[at].quality.present]
    run List<SourceAtom>.append(&mut present, run SourcePolicy.conjunction(&mut builder.rules, &gates, none))
    at = at + usize.ONE
  }
  run List<SourcePolicyRefusal>.append(&mut state.refusals, SourcePolicyRefusal {dispatch: dispatch,
    point: completed, reason: BorrowStatus.StoredLoans,
    active: run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&present))})
  return ()
}

effect fn sourceCollectFinish(state: &mut SourceDispatchProjection, finished: SourceFinishEffects,
  rules: &mut SourceProgram) -> () ! OutOfMemoryError ? &mut Allocator {
  run sourceDispatchMissing(&mut state.*, finished.missing, &mut rules.*)
  run sourceAppendEffects<SourceRetentionEffect>(&mut state.policy.retention, move finished.retention)
  run sourceAppendEffects<SourceEscapeEffect>(&mut state.policy.written, move finished.written)
  run sourceAppendEffects<SourceIntervalEffect>(&mut state.policy.intervals, move finished.intervals)
  run sourceAppendEffects<SourcePositionResult>(&mut state.policy.results, move finished.inputResults)
  run sourceAppendEffects<SourceResultEffect>(&mut state.outputs, move finished.results)
  run sourceAppendEffects<SourceWholeHold>(&mut state.wholeHolds, move finished.wholeHolds)
  run sourceAppendEffects<Location>(&mut state.sealed, move finished.sealed)
  run sourceAppendEffects<Location>(&mut state.unheld, move finished.unheld)
  return ()
}

// Immediate execution owns its original call's finish and retention judgment. The
// construction occurrence remains in the physical graph, with no second policy pass.
fn sourceInlinedOperation(stores: &SourceStores.Inventory, evaluation: SourceGraph.EvalId) -> bool {
  let operations = List<SourceStores.Operation>.asSlice(&stores.operations)
  let mut at = usize.ZERO
  while at < operations.length {
    if operations[at].originating.index == evaluation.index && operations[at].evaluation.index != evaluation.index { return true }
    at = at + usize.ONE
  }
  return false
}

// Copy immutable directive metadata before mutating its Builder's policy program. This is
// not a new source/input inventory: all evaluation IDs and original order remain unchanged.
effect fn sourceDispatchResult<'body>(builder: &SourceGraphBuilder<'body>, evaluation: SourceGraph.EvalId)
  -> Option<SourceGraph.ResultUse> ! OutOfMemoryError ? &mut Allocator {
  let directives = SourceGraphBuilder.resultUses(builder)
  let mut found = usize.MAX
  let mut at = usize.ZERO
  while at < directives.length {
    if directives[at].evaluation.index == evaluation.index {
      if found != usize.MAX { return CompilerBug.panic(b"one actual handler has duplicate result directives") }
      found = at
    }
    at = at + usize.ONE
  }
  if found == usize.MAX { return Option<SourceGraph.ResultUse>.none() }
  let actual = &directives[found]
  let mut sources = List<SourceGraph.EvalId>.make()
  let inputs = List<SourceGraph.EvalId>.asSlice(&actual.sources)
  at = usize.ZERO
  while at < inputs.length { run List<SourceGraph.EvalId>.append(&mut sources, inputs[at]) at = at + usize.ONE }
  return Option<SourceGraph.ResultUse>.some(SourceGraph.ResultUse {
    evaluation: actual.evaluation, active: actual.active, kind: actual.kind, sources: move sources})
}

// Dispatch follows the retained visitor trace, never point or Value allocation order. It
// preserves per-argument precision observations and cleanup between nested occurrences.
// Unimplemented semantic handlers remain explicit active gaps and leave their policy ports
// unbound; this internal stage cannot be published as a replacement checker prematurely.
effect fn sourceDispatchPolicies<'body>(builder: &mut SourceGraphBuilder<'body>, visits: &[SourceVisit.Visit],
  trace: &[SourceVisitDispatch], exits: &[SourceVisit.OwnerExit], owners: &[SourceVisit.Owner], subjects: &[SourceVisit.Subject],
  ownership: &SourceOwnership, access: &SourceAccessProjection, tail: SourceBodyTail,
  cleanup: &[LoanCleanup], context: &RetentionContext, paths: &mut List<List<Step>>,
  holders: SourceHolderProjection) -> SourceDispatchProjection ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let loans = List<Loan>.asSlice(&ownership.loans)
  let acquired = List<SourceInputAcquisition>.asSlice(&ownership.acquisitions)
  let observations = List<SourceOwnerObservation>.asSlice(&ownership.observations)
  let no = SourceProgram.atom(&mut builder.rules)
  let readAncestry = run sourceReadAncestries(&mut builder.*, &mut paths.*)
  let mut state = SourceDispatchProjection {
    policy: SourcePolicyEffects {state: run SourceLoanState.make(&mut builder.rules, loans.length),
      results: List<SourcePositionResult>.make(), crossings: List<SourceCrossingEffect>.make(), written: List<SourceEscapeEffect>.make(),
      callables: List<SourceCallableBinding>.make(), holderRequests: List<SourceHolderRequest>.make(),
      captures: List<SourceCaptureEffect>.make(), retention: List<SourceRetentionEffect>.make(), intervals: List<SourceIntervalEffect>.make(), missing: no},
    holders: move holders, outputs: List<SourceResultEffect>.make(), wholeHolds: List<SourceWholeHold>.make(),
    sealed: List<Location>.make(), unheld: List<Location>.make(), constructions: List<SourceInheritedStatus>.make(),
    blocks: List<SourceBlockBinding>.make(), ordinary: List<SourceOrdinaryUse>.make(), snapshots: List<SourceEscapePrecision>.make(), refusals: List<SourcePolicyRefusal>.make()}
  let nodes = SourceGraphBuilder.preparation(&builder.*).body.nodes
  let mut at = usize.ZERO
  run sourceOwnershipMirrors(&mut builder.*, &mut paths.*)
  while at < trace.length {
    let before = List<SourcePolicyRefusal>.length(&state.refusals)
    let requested = List<SourceHolderRequest>.length(&state.policy.holderRequests)
    let held = List<SourceHolderRequest>.length(&state.holders.requests)
    match trace[at] {
      SourceVisitDispatch.Enter {evaluation} => {
        let actual = sourceVisitAt(visits, evaluation)
        let active = List<SourceControl.Point>.asSlice(&builder.reaching.points)[actual.entry.index].reachable
        match move run shapeOf(nodes, actual.node) {
          Shape.Outside {reason} => run List<SourcePolicyRefusal>.append(&mut state.refusals,
            SourcePolicyRefusal {dispatch: at, point: actual.entry, reason: reason, active: active})
          _ => ()
        }
      }
      SourceVisitDispatch.InputComplete {evaluation, input} => {
        let actual = sourceVisitAt(visits, evaluation)
        let inputs = List<SourceVisit.Input>.asSlice(&actual.inputs)
        if input >= inputs.length { return CompilerBug.panic(b"dispatch trace lost an actual input completion") }
        let mut borrowing = false
        let mut holderAcquisition = evaluation
        if let Shape.Borrow {value, ..} = move run shapeOf(nodes, actual.node) {
          if input != usize.ZERO || inputs.length != usize.ONE || inputs[0].node.index != value.index {
            return CompilerBug.panic(b"borrow holder demand changed its actual operand")
          }
          borrowing = true
        }
        let mut acquisition = usize.ZERO
        while acquisition < acquired.length {
          if acquired[acquisition].result.index == evaluation.index
            && acquired[acquisition].input.index == inputs[input].evaluation.index {
            if SourceGraphBuilder.evaluation(&builder.*, acquired[acquisition].acquisition).point.index != inputs[input].usePoint.index {
              return CompilerBug.panic(b"implicit borrow holder demand left its acquisition point")
            }
            if let SourceInputAcquisitionKind.Reference = acquired[acquisition].kind {
              run sourceReferenceAcquisition(&mut builder.*, acquired[acquisition].acquisition, &mut state, loans, &mut paths.*)
              holderAcquisition = acquired[acquisition].acquisition
              borrowing = true
            }
          }
          acquisition = acquisition + usize.ONE
        }
        if borrowing {
          let holder = sourceBorrowHolderInput(&builder.*, visits, inputs[input], holderAcquisition)
          run sourceDispatchHolder(&mut builder.*, holder.node, holder.evaluation, inputs[input].usePoint, true, &mut state)
        }
        if input == usize.ZERO {
          if let Shape.Match {subject, ..} = move run shapeOf(nodes, actual.node) {
            if inputs[0].node.index != subject.index { return CompilerBug.panic(b"match subject changed its typed operand") }
            run sourceMatchSubject(&mut builder.*, actual, List<SourceMatchView>.asSlice(&ownership.views),
              &mut state, loans, &mut paths.*)
          }
        }
        run sourceSubjectMaterialization(&mut builder.*, actual, inputs[input], subjects, owners, &mut state.ordinary)
        // Callable replacement refusal precedes the displaced value's cleanup. Its RHS
        // is observed once here; the resulting consume still names the actual write point.
        match move run shapeOf(nodes, actual.node) {
          Shape.Assignment {local, value} => {
            if input != usize.ZERO || inputs.length != usize.ONE || inputs[input].node.index != value.index {
              return CompilerBug.panic(b"whole replacement changed its actual RHS completion")
            }
            run sourceDispatchReplacement(&mut builder.*, actual, inputs[input], local, at, exits,
              observations, &mut state, loans, &mut paths.*)
          }
          Shape.PlaceAssignment {target, value} => {
            if input == usize.ONE {
              let path = run pathOf(nodes, target)
              if path.root < SourceGraphBuilder.preparation(&builder.*).body.locals.length
                && !path.through && List<Step>.length(&path.steps) == usize.ZERO {
                if inputs.length != 2 || inputs[input].node.index != value.index {
                  return CompilerBug.panic(b"whole place replacement changed its actual RHS completion")
                }
                run sourceDispatchReplacement(&mut builder.*, actual, inputs[input], path.root, at, exits,
                  observations, &mut state, loans, &mut paths.*)
              } else {
                run sourcePlaceWrite(&mut builder.*, actual, target, inputs[input], &path, at,
                  &mut state, loans, &mut paths.*)
              }
            }
          }
          Shape.Displace {target, value} => {
            if input == usize.ONE {
              if inputs.length != 2 || inputs[1].node.index != value.index {
                return CompilerBug.panic(b"displacement changed its actual RHS completion")
              }
              run sourceDisplace(&mut builder.*, actual, target, inputs[1], at, &mut state, loans, &mut paths.*)
            }
          }
          _ => ()
        }
        if !sourceInlinedOperation(SourceGraphBuilder.stores(&builder.*), evaluation) {
          if let Shape.Defer {..} = move run shapeOf(nodes, actual.node) {
            let deferred = run sourceDeferInput(&mut builder.*, actual, input, acquired, &mut state.policy.state, loans, &mut paths.*)
            run sourceDispatchMissing(&mut state, deferred.missing, &mut builder.rules)
            run sourceAppendEffects<SourceRetentionEffect>(&mut state.policy.retention, move deferred.retention)
          }
        }
      }
      SourceVisitDispatch.InputSettled {evaluation, input} => {
        let actual = sourceVisitAt(visits, evaluation)
        let inputs = List<SourceVisit.Input>.asSlice(&actual.inputs)
        if input >= inputs.length { return CompilerBug.panic(b"settled dispatch lost its actual input") }
        let mut consume = false
        match move run shapeOf(nodes, actual.node) {
          Shape.Branch {condition, ..} => {
            if input != usize.ZERO || inputs[input].node.index != condition.index {
              return CompilerBug.panic(b"condition cleanup changed its actual input")
            }
            consume = true
          }
          Shape.While {condition, ..} => {
            if input != usize.ZERO || inputs[input].node.index != condition.index {
              return CompilerBug.panic(b"condition cleanup changed its actual input")
            }
            consume = true
          }
          Shape.Block {statements} => {
            if inputs.length != List<NodeId>.length(&statements) { return CompilerBug.panic(b"block dispatch lost a statement") }
            consume = input + usize.ONE < inputs.length
          }
          Shape.Match {..} => {
            let arms = List<SourceVisit.ArmResult>.asSlice(&actual.armInputs)
            let mut arm = usize.ZERO
            while arm < arms.length {
              if let Option<usize>.Some {value} = arms[arm].guard {
                if value == input { consume = true }
              }
              arm = arm + usize.ONE
            }
          }
          _ => ()
        }
        if consume {
          run sourceDispatchConsume(&mut builder.*, visits, inputs[input], inputs[input].completed, false,
            &mut state, loans, &mut paths.*)
        }
      }
      SourceVisitDispatch.TransferComplete {evaluation} => {
        let actual = sourceVisitAt(visits, evaluation)
        if let Shape.Exit {value} = move run shapeOf(nodes, actual.node) {
          let inputs = List<SourceVisit.Input>.asSlice(&actual.inputs)
          if let Option<NodeId>.Some {value: returnedNode} = value {
            if inputs.length != usize.ONE || inputs[0].node.index != returnedNode.index {
              return CompilerBug.panic(b"transfer completion changed its actual returned operand")
            }
            run sourceDispatchConsume(&mut builder.*, visits, inputs[0], actual.completed, true,
              &mut state, loans, &mut paths.*)
          } else if inputs.length != usize.ZERO { return CompilerBug.panic(b"empty transfer acquired an operand") }
        }
      }
      SourceVisitDispatch.ArmComplete {evaluation, arm} => {
        let actual = sourceVisitAt(visits, evaluation)
        let intervals = List<SourceVisit.ArmResult>.asSlice(&actual.armInputs)
        let inputs = List<SourceVisit.Input>.asSlice(&actual.inputs)
        if arm >= intervals.length || intervals[arm].input >= inputs.length {
          return CompilerBug.panic(b"match completion lost its exact arm input")
        }
        let input = inputs[intervals[arm].input]
        if let Shape.Match {arms, ..} = move run shapeOf(nodes, actual.node) {
          let written = List<ArmShape>.asSlice(&arms)
          if intervals.length != written.length || input.node.index != written[arm].result.index {
            return CompilerBug.panic(b"match completion substituted another arm result")
          }
          let retained = run nodeRetains(nodes, actual.node, SourceGraphBuilder.preparation(&builder.*).body.owner)
          run sourceDispatchConsume(&mut builder.*, visits, input, intervals[arm].completed, retained,
            &mut state, loans, &mut paths.*)
        } else { return CompilerBug.panic(b"arm completion selected a non-match handler") }
      }
      SourceVisitDispatch.Finish {evaluation} => {
        if sourceInlinedOperation(SourceGraphBuilder.stores(&builder.*), evaluation) { at = at + usize.ONE continue }
        let actual = sourceVisitAt(visits, evaluation)
        let active = List<SourceControl.Point>.asSlice(&builder.reaching.points)[actual.execute.index].reachable
        let directive = run sourceDispatchResult(&builder.*, evaluation)
        match move run shapeOf(nodes, actual.node) {
          Shape.Borrow {..} => {
            run sourceReferenceAcquisition(&mut builder.*, evaluation, &mut state, loans, &mut paths.*)
          }
          Shape.Operands {..} => {
            let directive = match move directive { Option<SourceGraph.ResultUse>.Some {value} => move value
              _ => { return CompilerBug.panic(b"actual operand handler lost its reserved result directive") } }
            let finished = run sourceFinishOperands(&mut builder.*, actual, &directive, &mut state.policy.state, loans, &mut paths.*, context, List<SourceWholeHold>.asSlice(&state.wholeHolds))
            run sourceCollectFinish(&mut state, move finished, &mut builder.rules)
          }
          Shape.ShortCircuit {..} => {
            let directive = match move directive { Option<SourceGraph.ResultUse>.Some {value} => move value
              _ => { return CompilerBug.panic(b"actual operand handler lost its reserved result directive") } }
            let finished = run sourceFinishOperands(&mut builder.*, actual, &directive, &mut state.policy.state, loans, &mut paths.*, context, List<SourceWholeHold>.asSlice(&state.wholeHolds))
            run sourceCollectFinish(&mut state, move finished, &mut builder.rules)
          }
          Shape.Call {..} => {
            let directive = match move directive { Option<SourceGraph.ResultUse>.Some {value} => move value
              _ => { return CompilerBug.panic(b"actual call handler lost its reserved result directive") } }
            let called = run sourceCall(&mut builder.*, visits, actual, &directive, acquired, &mut state.policy.state,
              loans, List<SourceLoanGeometry>.asSlice(&ownership.places), owners, &mut paths.*, context, List<SourceCaptureEffect>.asSlice(&state.policy.captures), &mut state.holders, &readAncestry)
            run sourceCollectFinish(&mut state, move called.finished, &mut builder.rules)
            run sourceDispatchMissing(&mut state, called.stored.missing, &mut builder.rules)
            run sourceAppendEffects<SourceIntervalEffect>(&mut state.policy.intervals, move called.stored.intervals)
            run List<SourcePolicyRefusal>.append(&mut state.refusals, SourcePolicyRefusal {
              dispatch: at, point: actual.execute, reason: BorrowStatus.StoredLoans, active: called.stored.refusal})
          }
          Shape.Invoke {..} => {
            let directive = match move directive { Option<SourceGraph.ResultUse>.Some {value} => move value
              _ => { return CompilerBug.panic(b"actual call handler lost its reserved result directive") } }
            let called = run sourceCall(&mut builder.*, visits, actual, &directive, acquired, &mut state.policy.state,
              loans, List<SourceLoanGeometry>.asSlice(&ownership.places), owners, &mut paths.*, context, List<SourceCaptureEffect>.asSlice(&state.policy.captures), &mut state.holders, &readAncestry)
            run sourceCollectFinish(&mut state, move called.finished, &mut builder.rules)
            run sourceDispatchMissing(&mut state, called.stored.missing, &mut builder.rules)
            run sourceAppendEffects<SourceIntervalEffect>(&mut state.policy.intervals, move called.stored.intervals)
            run List<SourcePolicyRefusal>.append(&mut state.refusals, SourcePolicyRefusal {
              dispatch: at, point: actual.execute, reason: BorrowStatus.StoredLoans, active: called.stored.refusal})
          }
          Shape.Construct {..} => {
            let constructed = run sourceConstructVisit(&mut builder.*, actual, acquired, &mut state.policy.state, loans, List<SourceLoanGeometry>.asSlice(&ownership.places), &mut paths.*)
            run sourceDispatchMissing(&mut state, constructed.missing, &mut builder.rules)
            let policy = move constructed.policy
            run sourceAppendEffects<SourceCaptureEffect>(&mut state.policy.captures, move policy.captures)
            run List<SourceInheritedStatus>.append(&mut state.constructions, SourceInheritedStatus {
              dispatch: at, status: policy.inherited, active: policy.active})
          }
          Shape.Binding {..} => {
            let bound = run sourceBinding(&mut builder.*, actual, &mut state.policy.state, loans, &mut paths.*)
            run sourceDispatchMissing(&mut state, bound.missing, &mut builder.rules)
            run List<SourceOrdinaryUse>.append(&mut state.ordinary, SourceOrdinaryUse {
              writer: actual.evaluation, active: active, retained: bound.retained})
            run sourceAppendEffects<SourceIntervalEffect>(&mut state.policy.intervals, move bound.intervals)
            run sourceAppendEffects<SourceCrossingEffect>(&mut state.policy.crossings, move bound.crossings)
            run sourceAppendEffects<SourceEscapeEffect>(&mut state.policy.written, move bound.written)
            if let Option<SourceCallableBinding>.Some {value} = bound.callable {
              run List<SourceCallableBinding>.append(&mut state.policy.callables, value)
            }
            if let Option<SourceBlockBinding>.Some {value} = bound.block {
              run List<SourceBlockBinding>.append(&mut state.blocks, value)
            }
          }
          Shape.Assignment {..} => ()
          Shape.Displace {target, ..} => {
            if let Option<SourceGraph.ResultUse>.Some {value: throughDirective} = move directive {
              if run nodeRetains(nodes, target, SourceGraphBuilder.preparation(&builder.*).body.owner) {
                run sourceFinishThrough(&mut builder.*, actual, &throughDirective, &mut state, loans, &mut paths.*, context)
              } else { run sourceScalarResult(&mut builder.*, actual.evaluation) }
            }
          }
          Shape.PlaceAssignment {..} => ()
          Shape.Drop {value, consumed} => {
            let inputs = List<SourceVisit.Input>.asSlice(&actual.inputs)
            if inputs.length != usize.ONE || inputs[0].node.index != value.index {
              return CompilerBug.panic(b"drop dispatch changed its actual operand")
            }
            if consumed {
              run sourceDrop(&mut builder.*, actual, &mut state, loans, &mut paths.*)
            } else {
              run sourceDispatchConsume(&mut builder.*, visits, inputs[0], actual.execute, false, &mut state, loans, &mut paths.*)
            }
          }
          Shape.PassThrough {value} => {
            let inputs = List<SourceVisit.Input>.asSlice(&actual.inputs)
            if inputs.length != usize.ONE || inputs[0].node.index != value.index {
              return CompilerBug.panic(b"forwarded flight changed its actual operand")
            }
            run sourceDispatchConsume(&mut builder.*, visits, inputs[0], actual.completed, false, &mut state, loans, &mut paths.*)
          }
          Shape.Move {value, consumed} => {
            if List<SourceVisit.Input>.length(&actual.inputs) != usize.ONE {
              return CompilerBug.panic(b"move dispatch changed its actual operand count")
            }
            let input = sourceAccessInput(actual, usize.ZERO, value)
            let publication = run sourceMoveHoldings(&mut builder.*, evaluation, &mut paths.*)
            run sourceDispatchMissing(&mut state, publication, &mut builder.rules)
            if consumed {
              let path = run pathOf(nodes, value)
              // The original move returns the holder's flight; it has no finish or consume
              // of its own. A whole-place Copy already transports exactly that source family
              // at the real move read before the same-point uninitializing definition.
              if path.root != usize.MAX && !path.through {
                run sourceRecordMoveRead(&mut builder.*, actual, &mut paths.*, loans.length, &mut state.holders)
                run sourceDispatchHolder(&mut builder.*, input.node, input.evaluation, actual.execute, true, &mut state)
                if List<Step>.length(&path.steps) != usize.ZERO {
                  let requests = SourceGraphBuilder.selectedMoves(&builder.*)
                  let mut request = usize.ZERO
                  while request < requests.length && requests[request].result.index != evaluation.index {
                    request = request + usize.ONE
                  }
                  // Original-A publication and exact physical normalization own their
                  // independent per-Case coverage. A missing request is still an obligation.
                  if request == requests.length { run sourceDispatchMissing(&mut state, active, &mut builder.rules) }
                }
              }
              // Unknown/through paths retain their original Enter refusal in access.prelude.
            } else {
              run sourceDispatchConsume(&mut builder.*, visits, input, actual.completed, false, &mut state, loans, &mut paths.*)
            }
          }
          Shape.Branch {..} => {
            let inputs = List<SourceVisit.Input>.asSlice(&actual.inputs)
            let mut arm = usize.ONE
            while arm < inputs.length {
              run sourceDispatchConsume(&mut builder.*, visits, inputs[arm], inputs[arm].completed, true, &mut state, loans, &mut paths.*)
              arm = arm + usize.ONE
            }
          }
          Shape.While {body, ..} => {
            let inputs = List<SourceVisit.Input>.asSlice(&actual.inputs)
            if inputs.length != 2 || inputs[1].node.index != body.index { return CompilerBug.panic(b"loop result lost its actual body") }
            run sourceLoopResult(&mut builder.*, visits, inputs[1], at, &mut state, loans, &mut paths.*)
          }
          Shape.Block {statements} => {
            let inputs = List<SourceVisit.Input>.asSlice(&actual.inputs)
            if inputs.length != List<NodeId>.length(&statements) { return CompilerBug.panic(b"block result lost its actual last statement") }
            if inputs.length != usize.ZERO {
              run sourceDispatchConsume(&mut builder.*, visits, inputs[inputs.length - usize.ONE], actual.completed, false,
                &mut state, loans, &mut paths.*)
            }
          }
          Shape.ReadPlace => {
            let throughBoundary = sourceThroughReadBoundary(&builder.*, actual.evaluation, actual.execute)
            let mut recordedRead = false
            if let Option<SourceGraph.ResultUse>.Some {value: readDirective} = move directive {
              match readDirective.kind {
                SourceGraphResultKind.Read {read} => {
                  let selected = SourceGraphBuilder.evaluation(&builder.*, read)
                  let node = match selected.site { SourceGraphEvaluationSite.Node {node} => node
                    _ => { return CompilerBug.panic(b"read dispatch selected a body-entry value") } }
                  let root = sourceNodeValueRoot(SourceGraphBuilder.preparation(&builder.*), node)
                  let output = sourceNodeValueRoot(SourceGraphBuilder.preparation(&builder.*), actual.node)
                  let prepared = SourceGraphBuilder.preparation(&builder.*)
                  let owner = prepared.body.owner
                  let supplied = prepared.body.supplied
                  if run nodeRetains(nodes, actual.node, owner) {
                    let finished = run sourceFinishRead(&mut builder.*, &readDirective, root, output, actual.execute.index,
                      &mut state.policy.state, loans, &mut paths.*, nodes, owner, supplied,
                      List<RetentionEdge>.asSlice(&context.requirements), List<ImpliedGroup>.asSlice(&context.relations), context.settled,
                      List<SourceWholeHold>.asSlice(&state.wholeHolds))
                    run sourceCollectFinish(&mut state, move finished, &mut builder.rules)
                  } else {
                    let path = run pathOf(nodes, actual.node)
                    if path.through || throughBoundary {
                      let incomplete = run sourceThroughAction(&mut builder.*, actual.evaluation, SourceGraphThroughFlightKind.Read,
                        actual.execute, Option<SourceControl.PointId>.some(actual.execute), readDirective.active, true,
                        &mut state, loans, &mut paths.*)
                      run sourceCompleteScalarThroughRead(&mut builder.*, actual.node, actual.evaluation, output,
                        readDirective.active, incomplete)
                    } else {
                      run sourceScalarFlight(&mut builder.*, read, actual.execute, nodes[actual.node.index].origin.location, readDirective.active, true, &mut state, loans, &mut paths.*)
                    }
                    recordedRead = true
                    run sourceScalarResult(&mut builder.*, actual.evaluation)
                  }
                }
                SourceGraphResultKind.Physical => {
                  let operands = match &nodes[actual.node.index].kind {
                    NodeKind.Expression {form: Expression.Field {..}, ..} => true
                    NodeKind.Expression {form: Expression.Dereference {..}, ..} => true
                    NodeKind.Expression {form: Expression.Index {..}, ..} => true
                    _ => false
                  }
                  if operands {
                    let finished = run sourceFinishOperands(&mut builder.*, actual, &readDirective,
                      &mut state.policy.state, loans, &mut paths.*, context, List<SourceWholeHold>.asSlice(&state.wholeHolds))
                    run sourceCollectFinish(&mut state, move finished, &mut builder.rules)
                  } else {
                    return CompilerBug.panic(b"physical place read has neither an operand projection nor an owned path")
                  }
                }
                SourceGraphResultKind.Declared => { return CompilerBug.panic(b"place read acquired declared call result authority") }
              }
            }
            if actual.access == SourceVisitAccess.Value {
              let path = run pathOf(nodes, actual.node)
              let mut held = path.root != usize.MAX
              if !held {
                let base = projectedBase(nodes, actual.node)
                let descriptor = SourceGraphBuilder.preparation(&builder.*).body.locals.length + nodes.length + base.index
                held = descriptor < cleanup.length
                  && (cleanup[descriptor].unknown || List<Shared<Lifetime>>.length(&cleanup[descriptor].regions) != usize.ZERO)
              }
              if held {
                if !recordedRead && run sourceSemanticRead(nodes, visits, actual) {
                  run sourceRecordValueRead(&mut builder.*, actual, active, &mut paths.*, loans.length, &mut state.holders)
                }
                if path.through || throughBoundary {
                  run sourceDispatchThroughHolder(&mut builder.*, actual.evaluation, actual.execute, &mut state.holders)
                } else {
                  run sourceDispatchHolder(&mut builder.*, actual.node, actual.evaluation, actual.execute, false, &mut state)
                }
              }
            }
          }
          Shape.Leaf => ()
          Shape.Defer {..} => ()
          Shape.Match {..} => ()
          Shape.Exit {..} => ()
          Shape.Break => ()
          Shape.Continue => ()
          Shape.Outside {..} => ()
          Shape.Recovered {..} => ()
        }
        run sourceTemporaryMaterialization(&mut builder.*, actual, owners, &mut state, loans, &mut paths.*)
      }
      SourceVisitDispatch.OwnerExit {exit} => {
        if exit >= exits.length { return CompilerBug.panic(b"dispatch trace lost its exact owner exit") }
        let actual = &exits[exit]
        // Use is a reserved conditional boundary, not a use of every physical owner.
        // Borrowed lexical views retain their explicit view lifetime; an unrun Effect's
        // own acquisitions need their separate applicability, not a whole-holder demand.
        if actual.action == SourceVisitOwnerAction.Cleanup {
          let mut found = usize.MAX
          let mut each = usize.ZERO
          while each < observations.length {
            let observed = observations[each]
            if observed.owner.index == actual.owner.index && observed.point.index == actual.point.index
              && observed.action == actual.action {
              if found != usize.MAX { return CompilerBug.panic(b"owner exit has duplicate actual observations") }
              found = each
            }
            each = each + usize.ONE
          }
          if found == usize.MAX { return CompilerBug.panic(b"owner exit lost its reserved current read") }
          let cleaned = run sourceCleanup(&mut builder.*, observations[found], &mut state.policy.state, loans, &mut paths.*, cleanup)
          run sourceDispatchMissing(&mut state, cleaned.missing, &mut builder.rules)
          run sourceAppendEffects<SourceIntervalEffect>(&mut state.policy.intervals, move cleaned.intervals)
          run List<SourcePolicyRefusal>.append(&mut state.refusals, SourcePolicyRefusal {
            dispatch: at, point: actual.point, reason: BorrowStatus.StoredLoans, active: cleaned.refusal})
        }
      }
    }
    let holderRequests = List<SourceHolderRequest>.asMutSlice(&mut state.policy.holderRequests)
    let mut request = requested
    while request < holderRequests.length { holderRequests[request].dispatch = at request = request + usize.ONE }
    let requests = List<SourceHolderRequest>.asMutSlice(&mut state.holders.requests)
    request = held
    while request < requests.length { requests[request].dispatch = at request = request + usize.ONE }
    let mut snapshot = before != List<SourcePolicyRefusal>.length(&state.refusals)
    let mut each = usize.ZERO
    let authored = List<SourceAccessRefusal>.asSlice(&access.refusals)
    while each < authored.length { if authored[each].dispatch == at { snapshot = true } each = each + usize.ONE }
    each = usize.ZERO
    let geometry = List<SourceAccessRefusal>.asSlice(&ownership.geometry)
    while each < geometry.length { if geometry[each].dispatch == at { snapshot = true } each = each + usize.ONE }
    each = usize.ZERO
    let deferred = List<SourceAccessGeometry>.asSlice(&access.geometry)
    while each < deferred.length { if deferred[each].dispatch == at { snapshot = true } each = each + usize.ONE }
    each = usize.ZERO
    let acquired = List<SourceAcquisitionGeometry>.asSlice(&ownership.geometryDemands)
    while each < acquired.length { if acquired[each].dispatch == at { snapshot = true } each = each + usize.ONE }
    if snapshot { run sourceEscapePrecision(&mut state, at, loans, &builder.reaching) }
    at = at + usize.ONE
  }
  run sourceDispatchConsume(&mut builder.*, visits, tail.input, tail.point, true, &mut state, loans, &mut paths.*)
  run sourceEscapePrecision(&mut state, usize.MAX, loans, &builder.reaching)
  let fields = run sourceFieldReholds(&mut builder.*, &mut paths.*)
  run sourceDispatchMissing(&mut state, fields, &mut builder.rules)
  let ordinary = run sourceOrdinarySummaries(&mut builder.*, List<SourceOrdinaryUse>.asSlice(&state.ordinary), &mut paths.*)
  run sourceDispatchMissing(&mut state, ordinary, &mut builder.rules)
  return move state
}

// Capture only immutable P versions at actual possible stopping encounters. No source
// inputs are invented or frozen, and no Truth is sampled before the sole graph solve.
effect fn sourceEscapePrecision(state: &mut SourceDispatchProjection, dispatch: usize, loans: &[Loan],
  control: &SourceControlReaching) -> () ! OutOfMemoryError ? &mut Allocator {
  let points = List<SourceControl.Point>.asSlice(&control.points)
  let mut qualities = List<SourceQuality>.make()
  let mut at = usize.ZERO
  while at < loans.length {
    run List<SourceQuality>.append(&mut qualities,
      SourceLoanState.quality(&state.policy.state, at, points[loans[at].created].reachable))
    at = at + usize.ONE
  }
  run List<SourceEscapePrecision>.append(&mut state.snapshots, SourceEscapePrecision {dispatch: dispatch, qualities: move qualities})
  return ()
}

// Ordered handler effects are complete before this consuming boundary. Source facts and
// immutable precision versions are sealed together, then the sole graph solve supplies all
// runtime activity, original definition membership and event applicability.
struct SourcePolicyEffects {
  state: SourceLoanState
  callables: List<SourceCallableBinding>
  holderRequests: List<SourceHolderRequest>
  results: List<SourcePositionResult>
  crossings: List<SourceCrossingEffect>
  written: List<SourceEscapeEffect>
  captures: List<SourceCaptureEffect>
  retention: List<SourceRetentionEffect>
  intervals: List<SourceIntervalEffect>
  missing: SourceAtom
}

struct SourceSolvedProjection<'body> {
  encounters: List<usize>
  graph: SourceGraphGraph<'body>
  control: SourceControlProjection
  storage: SourceStorageProjection
  intervals: List<SourceIntervalProjection>
  policies: SourceLoanPolicies
  loans: SourceSettledLoans
  events: SourceRuntimeEvents
  moves: SourceMoveProjection
  owners: List<SourceVisit.Owner>
  holders: SourceHolderProjection
  views: List<SourceLifetimeProjection>
  viewMissing: SourceAtom
  refusals: List<SourceAccessRefusal>
  guards: List<SourceGuardConsumption>
  refinements: List<Refinement>
  missing: SourceAtom
}

// This boundary takes only completed projections, never a second visitor or a fallback
// checker. Builder.solve requires every reserved policy port to have been bound. The
// owning dispatcher separately retains missing coverage for effects without result ports.
effect fn sourceSolveProjection<'body>(builder: SourceGraphBuilder<'body>, ownership: SourceOwnership,
  effects: SourcePolicyEffects, access: SourceAccessProjection, owners: List<SourceVisit.Owner>,
  loops: &[SourceVisit.Loop], exits: &[SourceVisit.OwnerExit], entry: SourceControl.PointId, holders: SourceHolderProjection,
  blocks: &[SourceBlockBinding], trace: &[SourceVisitDispatch], visits: &[SourceVisit.Visit],
  views: List<SourceLifetimeProjection>, viewMissing: SourceAtom) -> SourceSolvedProjection<'body>
! OutOfMemoryError ? &mut Allocator {
  let mut builder = move builder
  let storage = run sourceStorageProjection(&mut builder)
  let requestedHolders = run sourceHolderProjection(&mut builder, List<SourceVisit.Owner>.asSlice(&owners), &storage, move effects.holderRequests)
  let mut holders = move holders
  let offset = List<SourceHolderRequest>.length(&holders.requests)
  let mut requested = move requestedHolders
  let uses = List<SourceHolderUse>.asMutSlice(&mut requested.uses)
  let mut use = usize.ZERO
  while use < uses.length { uses[use].request = uses[use].request + offset use = use + usize.ONE }
  let holderGaps: [SourceAtom; 2] = [holders.missing, requested.missing]
  holders.missing = run SourcePolicy.disjunction(&mut builder.rules, &holderGaps)
  run sourceAppendEffects<SourceHolderRequest>(&mut holders.requests, move requested.requests)
  run sourceAppendEffects<SourceHolderUse>(&mut holders.uses, move requested.uses)
  run sourceAppendEffects<SourceSemanticRead>(&mut holders.reads, move requested.reads)
  let blockUntil = run sourceBlockLifetimes(&mut builder, blocks, trace, visits, List<SourceVisit.Owner>.asSlice(&owners),
    exits, &holders, List<usize>.asSlice(&ownership.encounters), List<Loan>.asSlice(&ownership.loans))
  let bindings = run sourceCallableLifetimes(&mut builder, &storage, List<SourceCallableBinding>.asSlice(&effects.callables),
    List<SourceVisit.Owner>.asSlice(&owners), exits, &holders, List<Loan>.asSlice(&ownership.loans))
  let mut views = move views
  run sourceAppendEffects<SourceLifetimeProjection>(&mut views, move bindings.projections)
  let missingViews: [SourceAtom; 2] = [viewMissing, bindings.missing]
  let viewMissing = run SourcePolicy.disjunction(&mut builder.rules, &missingViews)
  let intervals = run sourceIntervalProjection(&mut builder, List<SourceIntervalEffect>.asSlice(&effects.intervals))
  let policies = run sourceLoanPolicies(&mut builder, &effects.state, List<Loan>.asSlice(&ownership.loans),
    List<SourcePositionResult>.asSlice(&effects.results), List<SourceCrossingEffect>.asSlice(&effects.crossings),
    List<SourceEscapeEffect>.asSlice(&effects.written), List<SourceCaptureEffect>.asSlice(&effects.captures),
    List<SourceRetentionEffect>.asSlice(&effects.retention))
  let geometryMissing = match access.geometryMissing { Option<SourceAtom>.Some {value} => value
    _ => { return CompilerBug.panic(b"access geometry was not resolved before ownership solve") } }
  let mut acquisitionGaps = List<SourceAtom>.make()
  let geometry = List<SourceLoanGeometry>.asSlice(&ownership.places)
  let mut loan = usize.ZERO
  while loan < geometry.length { run List<SourceAtom>.append(&mut acquisitionGaps, geometry[loan].missing) loan = loan + usize.ONE }
  let acquisitionMissing = run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&acquisitionGaps))
  let gaps: [SourceAtom; 6] = [effects.missing, policies.missing, holders.missing, viewMissing, geometryMissing, acquisitionMissing]
  let missing = run SourcePolicy.disjunction(&mut builder.rules, &gaps)
  run sourceSemanticReadPairs(&builder, &mut holders.reads)
  let graph = run SourceGraphBuilder.solve(move builder)
  let mut loans = run sourceSettleLoans(&graph, move ownership.loans, move ownership.places, &policies)
  sourceSettleBlocks(&graph, List<SourceBlockUntil>.asSlice(&blockUntil), &mut loans)
  let control = run sourceControlProjection(&graph, entry)
  let mut access = move access
  run sourceAppendEffects<SourceAccessRefusal>(&mut access.refusals, move ownership.geometry)
  run sourceAppendEffects<SourceGeometryRefusal>(&mut access.geometryRefusals, move ownership.geometryRefusals)
  let geometryRefusals = List<SourceGeometryRefusal>.asSlice(&access.geometryRefusals)
  let mut refusal = usize.ZERO
  while refusal < geometryRefusals.length {
    let row = &geometryRefusals[refusal]
    let missing = SourceGraphGraph.truth(&graph, row.missing)
    if missing != SourceTruth.False {
      run List<SourceAccessRefusal>.append(&mut access.refusals, SourceAccessRefusal {
        dispatch: row.dispatch, point: row.point, reason: BorrowStatus.Regions, uncertain: missing == SourceTruth.Undefined})
    }
    refusal = refusal + usize.ONE
  }
  run sourceSettleReplacements(&graph, &mut access)
  let mut recordedEvents = move ownership.events
  let mut eventGates = move ownership.eventGates
  let mut accesses = move access.events
  while List<SourceAccessEvent>.length(&accesses) != usize.ZERO {
    let actual = List<SourceAccessEvent>.remove(&mut accesses, usize.ZERO)
    if let Option<SourceAtom>.Some {value} = actual.gate {
      run List<SourceEventGate>.append(&mut eventGates, SourceEventGate {event: List<Event>.length(&recordedEvents), active: value})
    }
    run List<Event>.append(&mut recordedEvents, move actual.event)
  }
  let events = run sourceRuntimeEvents(&graph, move recordedEvents, List<SourceEventGate>.asSlice(&eventGates))
  let moves = run sourceMoveProjection(&graph, &control, List<SourceVisit.Owner>.asSlice(&owners), loops, &events)
  return SourceSolvedProjection<'body> {encounters: move ownership.encounters, graph: move graph, control: move control, storage: move storage,
    intervals: move intervals, policies: move policies, loans: move loans, events: move events, moves: move moves,
    owners: move owners, holders: move holders, views: move views, viewMissing: viewMissing,
    refusals: move access.refusals, guards: move access.guardConsumed, refinements: move access.refinements, missing: missing}
}

// Freeze the diagnostic walk's per-loan views from the solved graph. Every occupancy bit
// still names a real Flow definition, and every liveness query uses the shared actual CFG.
effect fn sourceLoanFlows<'input, 'body>(input: &SourceRegionInput<'input, 'body>, settled: &SourceSettledLoans,
  holders: &SourceHolderProjection, intervals: &mut IntervalFlow) -> List<SourceLoanFlow>
! OutOfMemoryError ? &mut Allocator {
  let loans = List<Loan>.asSlice(&settled.loans)
  let mut result = List<SourceLoanFlow>.make()
  let mut at = usize.ZERO
  while at < loans.length {
    let occupancy = run sourceLoanOccupancy(input.graph, input.storage, at)
    let needs = run sourceLoanNeeds(input.graph, input.control, input.storage, &occupancy,
      input.intervals, input.views, loans[at].created, &mut intervals.*)
    let kept = run sourceHolderLiveness(input.graph, input.control, input.storage, &occupancy, holders)
    run List<SourceLoanFlow>.append(&mut result, SourceLoanFlow {occupancy: move occupancy, needs: move needs, holders: move kept})
    at = at + usize.ONE
  }
  return move result
}

// The complete access-order classifier, after guard/escape/outside precedence has been
// decided by the body owner. It reports genuine conflicts and unresolved evidence only;
// absence of a conflict never discharges source coverage or retained region obligations.
effect fn sourceConflicts<'input, 'body, 'proof>(input: &SourceRegionInput<'input, 'body>,
  settled: &SourceSettledLoans, callers: &SourceCallerProjection, flow: &[SourceLoanFlow],
  moves: &SourceMoveProjection, refinements: &[Refinement], regions: &RegionSources<'proof>,
  chains: &[UnretainedChain], returnedEscape: bool) -> SourceConflictProjection
! OutOfMemoryError ? &mut Allocator {
  let events = List<Event>.asSlice(&input.events.events)
  let uncertain = List<bool>.asSlice(&input.events.uncertain)
  let loans = List<Loan>.asSlice(&settled.loans)
  if uncertain.length != events.length || flow.length != loans.length {
    return CompilerBug.panic(b"source conflict projection lost its actual event or loan inventory")
  }
  let mut result = SourceConflictProjection {conflict: Option<Verdict>.none(), contested: List<Shared<Lifetime>>.make(),
    unresolved: settled.unresolved || input.events.unresolved || input.control.unresolved || moves.unresolved}
  let points = List<Point>.asSlice(&input.control.points)
  let loops = List<Loop>.asSlice(&moves.loops)
  let initialized = List<MoveInitialization>.asSlice(&moves.initialized)
  let moved = List<usize>.asSlice(&moves.moves)
  let mut reports = List<Report>.make()
  let mut paths = List<ReplacementReach>.make()
  let mut checkedLoops = usize.ZERO
  let mut stopped = false
  let mut at = usize.ZERO
  while at <= events.length {
    while checkedLoops < loops.length && (at == events.length || loops[checkedLoops].header < events[at].point) {
      let repeat = &loops[checkedLoops]
      let repeats = run refinementRepeats(points, refinements, events, repeat, &mut paths)
      let compatible = moves.width == usize.ZERO || compatibleHeader(initialized, events, moved, &moves.reach, moves.width, repeat)
      if !compatible || !repeats {
        if moves.unresolved { result.unresolved = true }
        else {
          if List<Report>.length(&reports) == usize.ZERO {
            result.conflict = Option<Verdict>.some(Verdict {outcome: Outcome.Conflict, status: BorrowStatus.Regions,
              code: RejectionCode.IncompatibleLoopHeader, access: repeat.span, earlier: Option<Location>.none(), reports: List<Report>.make()})
          }
          stopped = true
          break
        }
      }
      checkedLoops = checkedLoops + usize.ONE
    }
    if stopped || at == events.length { break }
    let event = &events[at]
    if event.consumesTarget == usize.ONE && !uncertain[at] {
      if List<Report>.length(&reports) == usize.ZERO {
        result.conflict = Option<Verdict>.some(Verdict {outcome: Outcome.Conflict, status: BorrowStatus.Regions,
          code: RejectionCode.OverlappingAssignment, access: event.span, earlier: Option<Location>.none(), reports: List<Report>.make()})
      }
      break
    }
    if event.consumesTarget != usize.ZERO { result.unresolved = true }
    let mut bit = usize.ZERO
    while event.kind != Kind.End && event.kind != Kind.Expire && bit < moved.length {
      if moveReachesEvent(events, initialized, moved, &moves.reach, moves.width, bit, at) {
        let classification = movedAccess(event, &events[moved[bit]])
        if classification == MoveAccess.Conflict {
          if moves.unresolved || uncertain[at] || uncertain[moved[bit]] { result.unresolved = true }
          else {
            if List<Report>.length(&reports) == usize.ZERO {
              result.conflict = Option<Verdict>.some(Verdict {outcome: Outcome.Conflict, status: BorrowStatus.Regions,
                code: RejectionCode.UseAfterMove, access: event.span, earlier: Option<Location>.some(events[moved[bit]].span),
                reports: List<Report>.make()})
            }
            stopped = true
            break
          }
        }
        if classification == MoveAccess.Unknown { result.unresolved = true }
      }
      bit = bit + usize.ONE
    }
    if stopped { break }
    if event.refiner != usize.MAX && event.kind != Kind.End && event.kind != Kind.Expire {
      let test = refinementTest(refinements, event.refiner)
      if test == usize.MAX { result.unresolved = true }
      let mut source = usize.ZERO
      while test != usize.MAX && source < events.length {
        let written = &events[source]
        if replaces(written.kind) && coversRefined(&written.place, &event.place, event.refinedDepth)
          && run reachesAvoiding(points, &mut paths, written.point, event.point, test) {
          if input.control.unresolved || uncertain[at] || uncertain[source] { result.unresolved = true }
          else {
            if List<Report>.length(&reports) == usize.ZERO {
              run List<Report>.append(&mut reports, Report {code: RejectionCode.ExtractionBoundary, access: event.span,
                related: true, earlier: written.span})
            }
            break
          }
        }
        source = source + usize.ONE
      }
    }
    let mut loan = usize.ZERO
    while loan < loans.length {
      let actual = &flow[loan]
      if actual.occupancy.loan != loan { return CompilerBug.panic(b"source conflict projection reordered loan identities") }
      let ended = event.kind == Kind.End || event.kind == Kind.Expire
      let geometry = &List<SourceSettledGeometry>.asSlice(&settled.geometry)[loan]
      if geometry.unresolved { result.unresolved = true }
      let places = List<SourceSettledPlace>.asSlice(&geometry.alternatives)
      let mut placed = usize.ZERO
      let mut reported = false
      while placed < places.length {
        let actualPlace = &places[placed]
        if actualPlace.activity != SourceTruth.False {
          let uncertainPlace = uncertain[at] || actualPlace.activity != SourceTruth.True
          let mut decision = SourceAccessDecision {reported: false, unresolved: false}
          if ended {
            decision = run sourceEndLoan(input, settled, callers, &actual.occupancy, &actual.needs, &actual.holders,
              &actualPlace.place, event, uncertainPlace, returnedEscape, &mut paths, &mut reports)
          } else {
            decision = run sourceAccessLoan(input, settled, callers, &actual.occupancy, &actual.needs, &actual.holders,
              regions, chains, &actualPlace.place, event, uncertainPlace, returnedEscape, &mut paths, &mut result.contested, &mut reports)
          }
          if decision.unresolved { result.unresolved = true }
          if decision.reported { reported = true break }
        }
        placed = placed + usize.ONE
      }
      if reported && !ended { break }
      loan = loan + usize.ONE
    }
    at = at + usize.ONE
  }
  if List<Report>.length(&reports) != usize.ZERO {
    let first = List<Report>.asSlice(&reports)[usize.ZERO]
    let mut listed = List<Report>.make()
    if List<Report>.length(&reports) > usize.ONE { listed = run bySpan(List<Report>.asSlice(&reports)) }
    let mut earlier = Option<Location>.none()
    if first.related { earlier = Option<Location>.some(first.earlier) }
    result.conflict = Option<Verdict>.some(Verdict {outcome: Outcome.Conflict, status: BorrowStatus.Regions,
      code: first.code, access: first.access, earlier: move earlier, reports: move listed})
  }
  return move result
}

fn sourceRefutedOr(settled: &SourceSettledLoans, escaping: usize, otherwise: Verdict) -> Verdict {
  if escaping == usize.MAX { return move otherwise }
  let loans = List<Loan>.asSlice(&settled.loans)
  let activity = List<SourceTruth>.asSlice(&settled.activity)
  if escaping >= loans.length || activity.length != loans.length || activity[escaping] != SourceTruth.True
    || sourceOwnedGeometry(&loans[escaping], &List<SourceSettledGeometry>.asSlice(&settled.geometry)[escaping], false) != SourceTruth.True
    || (loans[escaping].precision != LoanPrecision.Exact && loans[escaping].precision != LoanPrecision.Stored) {
    return CompilerBug.panic(b"escape refutation has no actual precise owned loan")
  }
  return Verdict {outcome: Outcome.Conflict, status: BorrowStatus.Regions, code: RejectionCode.UnsatisfiedLifetimeBound,
    access: loans[escaping].origin, earlier: Option<Location>.none(), reports: List<Report>.make()}
}

// Terminal proof classification owns the original body obligations and premises. Current C
// has no external request producer: an incoming outcome cannot bypass an internal Outlives
// or Contents predicate merely by naming its ordinal, even when stamped by this graph.
// The operation driver must supply every missing-source gate before its single solve.
effect fn sourceProofVerdict<'input, 'body>(input: &SourceRegionInput<'input, 'body>, settled: &SourceSettledLoans,
  conflicts: SourceConflictProjection, missing: SourceAtom, inherited: BorrowStatus,
  openContents: &[Shared<Lifetime>], relations: &[ImpliedGroup], returnedEscape: usize,
  outcomes: &[SourceGraph.SourceOutcome]) -> Verdict ! OutOfMemoryError ? &mut Allocator {
  if let Option<Verdict>.Some {value} = move conflicts.conflict { return move value }
  if settled.storing != SourceTruth.False {
    return sourceRefutedOr(settled, returnedEscape, verdict(Outcome.NotChecked, BorrowStatus.StoredLoans))
  }
  let prepared = SourceGraphGraph.preparation(input.graph)
  let actual = List<SourceControl.Point>.asSlice(&SourceGraphGraph.control(input.graph).points)
  if input.control.entry >= actual.length { return CompilerBug.panic(b"terminal source check lost its actual entry") }
  if SourceGraphGraph.truth(input.graph, actual[input.control.entry].reachable) != SourceTruth.True
    || SourceGraphGraph.truth(input.graph, missing) != SourceTruth.False
    || conflicts.unresolved || settled.unresolved || input.control.unresolved || input.events.unresolved {
    return sourceRefutedOr(settled, returnedEscape, verdict(Outcome.NotChecked, BorrowStatus.Imprecise))
  }
  if inherited != BorrowStatus.Checked {
    return sourceRefutedOr(settled, returnedEscape, verdict(Outcome.NotChecked, inherited))
  }
  if prepared.body.coverage != PreparedSourcesCoverage.Complete || outcomes.length != usize.ZERO {
    return sourceRefutedOr(settled, returnedEscape, verdict(Outcome.NotChecked, BorrowStatus.Regions))
  }
  let sources = sourceRegionSources(settled, prepared.body.supplied,
    List<Shared<Lifetime>>.asSlice(&conflicts.contested), openContents, relations)
  let mut symbolic = List<SymbolicRegion>.make()
  let crossings = run crossedRegionsProved(&sources, prepared.body.owner, prepared.body.premises, &mut symbolic)
  let mut proved = !prepared.body.pending && crossings
  if !proved {
    proved = run sourceLocalRelationsProved(input, &sources, prepared.body.owner, prepared.body.obligations,
      prepared.body.premises, &mut symbolic, !crossings)
  }
  if proved && run regionClosed(prepared.body.owner, prepared.body.supplied, prepared.body.locals, prepared.body.nodes) {
    return sourceRefutedOr(settled, returnedEscape, verdict(Outcome.Clear, BorrowStatus.Checked))
  }
  return sourceRefutedOr(settled, returnedEscape, verdict(Outcome.Clear, BorrowStatus.Regions))
}

/// One ephemeral solved source graph and its ownership projections, consumed by checkPrepared.
pub struct Analysis<'body> {
  projection: SourceSolvedProjection<'body>
  context: RetentionContext
  escapes: SourceEscapeInventory
  snapshots: List<SourceEscapePrecision>
  refusals: List<SourcePolicyRefusal>
  inherited: List<SourceInheritedStatus>
}

impl<'body> Analysis<'body> {
  pub fn sources(self: &Self) -> &SourceGraphGraph<'body> { return &self.projection.graph }
}

struct SourceFinalInventory {
  prelude: SourceAccessPrelude
  activity: List<SourceTruth>
  precision: List<LoanPrecision>
  stores: List<StoreWindow>
  returns: List<StoreWindow>
  sealed: List<Location>
  unheld: List<Location>
  escaping: List<usize>
  inherited: BorrowStatus
  unresolved: bool
}

// Settle only evidence retained at an actual encounter. The first refused encounter cuts
// off later windows/acquisitions and selects its immutable precision version; runtime CFG
// reachability still decides activity independently of this checker boundary.
effect fn sourceFinalInventory<'body>(projection: &SourceSolvedProjection<'body>, inventory: SourceEscapeInventory,
  snapshots: &[SourceEscapePrecision], refusals: &[SourcePolicyRefusal], inherited: &[SourceInheritedStatus])
  -> SourceFinalInventory ! OutOfMemoryError ? &mut Allocator {
  let graph = &projection.graph
  let points = List<SourceControl.Point>.asSlice(&SourceGraphGraph.control(graph).points)
  let mut activity = List<SourceTruth>.make()
  let mut all = List<SourceAccessRefusal>.make()
  let mut unresolved = false
  let mut at = usize.ZERO
  while at < points.length { run List<SourceTruth>.append(&mut activity, SourceGraphGraph.truth(graph, points[at].reachable)) at = at + usize.ONE }
  let authored = List<SourceAccessRefusal>.asSlice(&projection.refusals)
  at = usize.ZERO
  while at < authored.length {
    run List<SourceAccessRefusal>.append(&mut all, SourceAccessRefusal {
      uncertain: authored[at].uncertain, dispatch: authored[at].dispatch, point: authored[at].point, reason: authored[at].reason})
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < refusals.length {
    let active = sourceTruthAnd(SourceGraphGraph.truth(graph, refusals[at].active),
      List<SourceTruth>.asSlice(&activity)[refusals[at].point.index])
    if active != SourceTruth.False {
      run List<SourceAccessRefusal>.append(&mut all, SourceAccessRefusal {
        uncertain: active == SourceTruth.Undefined, dispatch: refusals[at].dispatch, point: refusals[at].point, reason: refusals[at].reason})
    }
    at = at + usize.ONE
  }
  let prelude = sourcePrelude(List<SourceGuardConsumption>.asSlice(&projection.guards),
    List<SourceAccessRefusal>.asSlice(&all), List<SourceTruth>.asSlice(&activity))
  let cutoff = prelude.cutoff
  unresolved = unresolved || prelude.unresolved
  at = usize.ZERO
  while at < refusals.length {
    if refusals[at].dispatch <= cutoff {
      let active = sourceTruthAnd(SourceGraphGraph.truth(graph, refusals[at].active),
        List<SourceTruth>.asSlice(&activity)[refusals[at].point.index])
      // A possible refusal conservatively stops the semantic inventory. Its uncertainty
      // survives the point-only ordering projection: checkPrepared must not use this
      // stopping snapshot to ground an escape/refutation, even when the point is reachable.
      if active == SourceTruth.Undefined { unresolved = true }
    }
    at = at + usize.ONE
  }
  let mut snapshot = usize.MAX
  at = usize.ZERO
  while at < snapshots.length {
    if snapshots[at].dispatch == cutoff {
      if snapshot != usize.MAX { return CompilerBug.panic(b"escape stopping encounter has duplicate precision snapshots") }
      snapshot = at
    }
    at = at + usize.ONE
  }
  if snapshot == usize.MAX { return CompilerBug.panic(b"escape stopping encounter lost its immutable precision snapshot") }
  let qualities = List<SourceQuality>.asSlice(&snapshots[snapshot].qualities)
  let acquired = List<usize>.asSlice(&projection.encounters)
  let states = List<SourceTruth>.asSlice(&projection.loans.activity)
  if qualities.length != states.length || acquired.length != states.length {
    return CompilerBug.panic(b"escape stopping snapshot changed actual loan identities")
  }
  let mut result = SourceFinalInventory {prelude: move prelude, activity: List<SourceTruth>.make(),
    precision: List<LoanPrecision>.make(), stores: List<StoreWindow>.make(), returns: List<StoreWindow>.make(),
    sealed: List<Location>.make(), unheld: List<Location>.make(), escaping: List<usize>.make(),
    inherited: BorrowStatus.Checked, unresolved: unresolved}
  at = usize.ZERO
  while at < states.length {
    let mut active = SourceTruth.False
    if acquired[at] <= cutoff { active = states[at] }
    run List<SourceTruth>.append(&mut result.activity, active)
    let stored = SourceGraphGraph.truth(graph, qualities[at].stored)
    let alternatives = SourceGraphGraph.truth(graph, qualities[at].alternatives)
    run List<LoanPrecision>.append(&mut result.precision, sourceSettledPrecision(LoanPrecision.Exact, stored, alternatives))
    if active == SourceTruth.Undefined || (active == SourceTruth.True
      && (stored == SourceTruth.Undefined || alternatives == SourceTruth.Undefined)) { result.unresolved = true }
    at = at + usize.ONE
  }
  let mut windows = move inventory.windows
  while List<SourceEscapeWindow>.length(&windows) != usize.ZERO {
    let window = List<SourceEscapeWindow>.remove(&mut windows, usize.ZERO)
    if window.dispatch <= cutoff {
      let active = List<SourceTruth>.asSlice(&activity)[window.point.index]
      if active == SourceTruth.True {
        if window.returned { run List<StoreWindow>.append(&mut result.returns, move window.window) }
        else { run List<StoreWindow>.append(&mut result.stores, move window.window) }
      }
      if active == SourceTruth.Undefined { result.unresolved = true }
    }
  }
  let sites = List<SourceEscapeSite>.asSlice(&inventory.sites)
  at = usize.ZERO
  while at < sites.length {
    if sites[at].dispatch <= cutoff {
      let active = SourceGraphGraph.truth(graph, sites[at].active)
      if active == SourceTruth.True {
        if sites[at].sealed { run List<Location>.append(&mut result.sealed, sites[at].span) }
        else { run List<Location>.append(&mut result.unheld, sites[at].span) }
      }
      if active == SourceTruth.Undefined { result.unresolved = true }
    }
    at = at + usize.ONE
  }
  let escaping = List<SourceEscapingLocal>.asSlice(&inventory.escaping)
  at = usize.ZERO
  while at < escaping.length {
    if escaping[at].dispatch <= cutoff {
      let active = List<SourceTruth>.asSlice(&activity)[escaping[at].point.index]
      if active == SourceTruth.True { run List<usize>.append(&mut result.escaping, escaping[at].local) }
      if active == SourceTruth.Undefined { result.unresolved = true }
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < inherited.length {
    if inherited[at].dispatch <= cutoff {
      let active = SourceGraphGraph.truth(graph, inherited[at].active)
      if active == SourceTruth.True && inherited[at].status != BorrowStatus.Checked
        && result.inherited == BorrowStatus.Checked { result.inherited = inherited[at].status }
      if active == SourceTruth.Undefined { result.unresolved = true }
    }
    at = at + usize.ONE
  }
  return move result
}

fn sourceSnapshotRefuted(loans: &[Loan], geometry: &[SourceSettledGeometry], escaping: usize, otherwise: Verdict) -> Verdict {
  if escaping == usize.MAX { return move otherwise }
  if escaping >= loans.length || geometry.length != loans.length
    || sourceOwnedGeometry(&loans[escaping], &geometry[escaping], false) != SourceTruth.True {
    return CompilerBug.panic(b"escape snapshot refutation has no actual owned acquisition")
  }
  return Verdict {outcome: Outcome.Conflict, status: BorrowStatus.Regions, code: RejectionCode.UnsatisfiedLifetimeBound,
    access: loans[escaping].origin, earlier: Option<Location>.none(), reports: List<Report>.make()}
}

// Consume the one analysis. The independent escape snapshot precedes outside handling;
// returned escape is a fallback after ordinary conflict diagnostics. Internal region goals
// and supplied outcomes still go through the complete final proof classifier.
pub effect fn checkPrepared<'body>(analysis: Analysis<'body>, outcomes: &[SourceGraph.SourceOutcome])
  -> Verdict ! OutOfMemoryError ? &mut Allocator {
  let inventory = run sourceFinalInventory(&analysis.projection, move analysis.escapes,
    List<SourceEscapePrecision>.asSlice(&analysis.snapshots), List<SourcePolicyRefusal>.asSlice(&analysis.refusals),
    List<SourceInheritedStatus>.asSlice(&analysis.inherited))
  let projection = &analysis.projection
  let graph = &projection.graph
  let prepared = SourceGraphGraph.preparation(graph)
  let loans = List<Loan>.asSlice(&projection.loans.loans)
  if let Option<Location>.Some {value} = inventory.prelude.guard { return sourceGuardVerdict(value) }
  let snapshot = EscapeSources {loans: loans, geometry: List<SourceSettledGeometry>.asSlice(&projection.loans.geometry), activity: List<SourceTruth>.asSlice(&inventory.activity),
    precision: List<LoanPrecision>.asSlice(&inventory.precision),
    stores: List<StoreWindow>.asSlice(&inventory.stores), returns: List<StoreWindow>.asSlice(&inventory.returns),
    sealed: List<Location>.asSlice(&inventory.sealed), unheld: List<Location>.asSlice(&inventory.unheld),
    escaping: List<usize>.asSlice(&inventory.escaping)}
  let mut returned = usize.MAX
  let mut unresolved = inventory.unresolved
  if !inventory.unresolved {
    let escape = run escapingOwnedLoan(&snapshot, prepared.body.owner, prepared.body.obligations, false)
    unresolved = unresolved || escape.unresolved
    if escape.loan != usize.MAX {
      return sourceSnapshotRefuted(loans, List<SourceSettledGeometry>.asSlice(&projection.loans.geometry), escape.loan, verdict(Outcome.NotChecked, BorrowStatus.Regions))
    }
    if snapshot.returns.length != usize.ZERO {
      let escape = run escapingOwnedLoan(&snapshot, prepared.body.owner, prepared.body.obligations, true)
      returned = escape.loan
      unresolved = unresolved || escape.unresolved
    }
  }
  if let Option<BorrowStatus>.Some {value} = inventory.prelude.outside {
    return sourceSnapshotRefuted(loans, List<SourceSettledGeometry>.asSlice(&projection.loans.geometry), returned, verdict(Outcome.NotChecked, value))
  }
  let input = SourceRegionInput {graph: graph, control: &projection.control,
    owners: List<SourceVisit.Owner>.asSlice(&projection.owners), geometry: List<SourceSettledGeometry>.asSlice(&projection.loans.geometry), storage: &projection.storage, events: &projection.events,
    intervals: List<SourceIntervalProjection>.asSlice(&projection.intervals),
    reads: List<SourceSemanticRead>.asSlice(&projection.holders.reads),
    views: List<SourceLifetimeProjection>.asSlice(&projection.views), viewMissing: projection.viewMissing}
  let empty = List<Shared<Lifetime>>.make()
  let regions = sourceRegionSources(&projection.loans, prepared.body.supplied, List<Shared<Lifetime>>.asSlice(&empty),
    List<Shared<Lifetime>>.asSlice(&analysis.context.openContents), List<ImpliedGroup>.asSlice(&analysis.context.relations))
  let mut chains = List<UnretainedChain>.make()
  let dropped = List<usize>.asSlice(&projection.loans.unretained)
  let mut at = usize.ZERO
  while at < dropped.length {
    run List<UnretainedChain>.append(&mut chains, run unretainedChain(&regions, prepared.body.owner, dropped[at]))
    at = at + usize.ONE
  }
  let mut intervals = emptyIntervalFlow()
  let flows = run sourceLoanFlows(&input, &projection.loans, &projection.holders, &mut intervals)
  let mut conflicts = run sourceConflicts(&input, &projection.loans, &projection.policies.callers,
    List<SourceLoanFlow>.asSlice(&flows), &projection.moves, List<Refinement>.asSlice(&projection.refinements),
    &regions, List<UnretainedChain>.asSlice(&chains), returned != usize.MAX)
  conflicts.unresolved = conflicts.unresolved || unresolved
  return run sourceProofVerdict(&input, &projection.loans, move conflicts, projection.missing, inventory.inherited,
    List<Shared<Lifetime>>.asSlice(&analysis.context.openContents), List<ImpliedGroup>.asSlice(&analysis.context.relations), returned, outcomes)
}

// Build the existing availability solver's inputs from original definitions and paired source
// cases. A copy is licensed by its actual input history; occupying the same region or appearing
// earlier in the definition inventory supplies no copy edge.
effect fn sourceAvailabilityProjection<'body>(graph: &SourceGraphGraph<'body>, storage: &SourceStorageProjection,
  occupancy: &SourceLoanOccupancy, intervals: &[SourceIntervalProjection], views: &[SourceLifetimeProjection]) -> AvailabilityProjection
! OutOfMemoryError ? &mut Allocator {
  let control = SourceGraphGraph.control(graph)
  let pointCount = List<SourceControl.Point>.length(&control.points)
  let definitions = List<SourceStorageDefinition>.asSlice(&storage.definitions)
  let mut projection = AvailabilityProjection {carriers: List<AvailabilityCarrier>.make(),
    preserves: List<u64>.make(), flight: List<bool>.make(), unresolved: occupancy.unresolved}
  let leaving = List<u64>.asSlice(&occupancy.leaving)
  let mut at = usize.ZERO
  while at < leaving.length {
    run List<u64>.append(&mut projection.preserves, leaving[at])
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < pointCount { run List<bool>.append(&mut projection.flight, false) at = at + usize.ONE }
  at = usize.ZERO
  while at < views.length {
    if views[at].loan == occupancy.loan {
      let held = List<SourceAtom>.asSlice(&views[at].occupied)
      if held.length != pointCount { return CompilerBug.panic(b"view occupancy belongs to another CFG") }
      let mut point = usize.ZERO
      while point < pointCount {
        let active = SourceGraphGraph.truth(graph, held[point])
        if active != SourceTruth.False {
          let mut flightPoints = List<bool>.asMutSlice(&mut projection.flight)
          flightPoints[point] = true
        }
        if active == SourceTruth.Undefined { projection.unresolved = true }
        point = point + usize.ONE
      }
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < intervals.length {
    let interval = &intervals[at]
    if !interval.holder && interval.source.loan == occupancy.loan {
      let active = SourceGraphGraph.truth(graph, interval.evidence.present)
      if active == SourceTruth.Undefined || SourceGraphGraph.truth(graph, interval.evidence.missing) != SourceTruth.False {
        projection.unresolved = true
      }
      if active != SourceTruth.False {
        if interval.from >= pointCount || interval.to >= pointCount { projection.unresolved = true }
        else {
          let mut point = interval.from
          while point <= interval.to {
            if true {
              let mut mutated = List<bool>.asMutSlice(&mut projection.flight)
              mutated[point] = true
            }
            point = point + usize.ONE
          }
        }
      }
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < definitions.length {
    let definition = &definitions[at]
    let mut carrier = AvailabilityCarrier {point: definition.definition.point.index,
      selected: sourceSettledDisposition(graph, Option<SourceControl.DefinitionId>.some(definition.definition.id)) != SourceGraphSummaryDisposition.Shadowed
        && sourceStoredMembership(graph, definition, occupancy.loan) != SourceTruth.False,
      unpaired: false, sources: List<AvailabilitySource>.make()}
    if !carrier.selected { run List<AvailabilityCarrier>.append(&mut projection.carriers, move carrier) at = at + usize.ONE continue }
    let inputs = List<SourceGraph.Input>.asSlice(&definition.inputs)
    let members = List<SourceStoredLoan>.asSlice(&definition.loans)
    let mut each = usize.ZERO
    while each < inputs.length {
      let mut membership = SourceTruth.False
      let mut member = usize.ZERO
      while member < members.length {
        if members[member].loan == occupancy.loan && members[member].leaf.index == inputs[each].leaf.index {
          let active = SourceGraphGraph.truth(graph, members[member].active)
          if active == SourceTruth.True || (active == SourceTruth.Undefined && membership == SourceTruth.False) { membership = active }
        }
        member = member + usize.ONE
      }
      let cases = List<SourceGraph.InputCase>.asSlice(&inputs[each].cases)
      let mut history = usize.ZERO
      while history < cases.length {
        let source = &cases[history]
        let active = sourceTruthAnd(membership, SourceGraphGraph.truth(graph, source.quality.present))
        if active == SourceTruth.Undefined { projection.unresolved = true }
        if active != SourceTruth.False {
          match source.definition {
            Option<SourceControl.DefinitionId>.Some {value: origin} => {
              if let Option<SourceControl.ReadId>.Some {value: read} = source.read {
                if origin.index >= definitions.length || read.index >= SourceGraphGraph.readCount(graph) {
                  projection.unresolved = true
                } else {
                  let written = SourceGraphGraph.definition(graph, origin)
                  let observed = SourceGraphGraph.read(graph, read)
                  if !sourceSameReadLane(written, observed) { projection.unresolved = true }
                  else if let Option<SourceAtom>.Some {value: pair} = sourceFlowPair(control, origin, read) {
                    let paired = sourceTruthAnd(active, SourceGraphGraph.truth(graph, pair))
                    if paired == SourceTruth.Undefined { projection.unresolved = true }
                    if paired != SourceTruth.False {
                      run List<AvailabilitySource>.append(&mut carrier.sources,
                        AvailabilitySource {definition: origin.index, read: observed.point.index})
                    }
                  } else { projection.unresolved = true }
                }
              } else { projection.unresolved = true }
            }
            _ => match source.read {
              Option<SourceControl.ReadId>.None => { carrier.unpaired = true }
              _ => { projection.unresolved = true }
            }
          }
        }
        history = history + usize.ONE
      }
      each = each + usize.ONE
    }
    run List<AvailabilityCarrier>.append(&mut projection.carriers, move carrier)
    at = at + usize.ONE
  }
  return move projection
}

// The source path supplies actual events and the projected carrier histories to the one
// accepted availability algorithm. Initialization and unreachable points retain their separate
// must-mask and creation proofs; neither is inferred from current loan occupancy.
effect fn sourceLoanAvailable(control: &SourceControlProjection, events: &SourceRuntimeEvents,
  projection: &AvailabilityProjection, occupancy: &SourceLoanOccupancy, loan: &Loan, place: &Place,
  sourceBound: bool, initialized: usize, storage: &RegionAvailability) -> SourceLoanAvailability
! OutOfMemoryError ? &mut Allocator {
  let points = List<Point>.asSlice(&control.points)
  let mut result = SourceLoanAvailability {points: List<u64>.make(), unresolved:
    control.unresolved || events.unresolved || projection.unresolved || occupancy.unresolved}
  let words = (points.length + 63) / 64
  let mut at = usize.ZERO
  while at < words { run List<u64>.append(&mut result.points, u64.bitNot(0)) at = at + usize.ONE }
  if loan.created >= points.length {
    result.unresolved = true
    return move result
  }
  run propagateAvailability(points, List<Event>.asSlice(&events.events), control.entry, loan, place, sourceBound,
    initialized != usize.MAX, List<u64>.asSlice(&occupancy.entering), occupancy.width, projection, &mut result.points)
  if initialized != usize.MAX {
    let masks = List<List<u64>>.asSlice(&storage.masks)
    if initialized >= masks.length { return CompilerBug.panic(b"source availability lost its actual initialization mask") }
    let valid = List<u64>.asSlice(&masks[initialized])
    if valid.length != words { return CompilerBug.panic(b"initialization mask belongs to another CFG") }
    let mut own = List<u64>.asMutSlice(&mut result.points)
    at = usize.ZERO
    while at < words { own[at] = u64.bitAnd(own[at], valid[at]) at = at + usize.ONE }
  }
  run unreachableAvailable(points, loan.created, &mut result.points)
  return move result
}

// Owner identity, not a region match or a source leaf's creation order, selects initialization.
// Several owners may initialize at one point; the old singleton Point.initializes slot is not
// used by this projection. Repeated initialization of a local keeps the existing refusal.
effect fn sourceInitializedOwnedRegion(control: &SourceControlProjection, owners: &[SourceVisit.Owner],
  localCount: usize, loan: &Loan, place: &Place, region: &Shared<Lifetime>, storage: &mut RegionAvailability,
  flow: &mut IntervalFlow) -> usize ! OutOfMemoryError ? &mut Allocator {
  if control.unresolved || !initializedOwnedSource(loan, region) { return usize.MAX }
  let mut initialized = usize.MAX
  let mut at = usize.ZERO
  while at < owners.length {
    let root = match owners[at].root {
      SourceVisitOwnerRoot.Local {local} => local.index
      _ => localCount + at
    }
    if root == place.root {
      if initialized != usize.MAX { return usize.MAX }
      initialized = owners[at].initialized.index
    }
    at = at + usize.ONE
  }
  if initialized == usize.MAX { return usize.MAX }
  return run initializedStorageRegion(List<Point>.asSlice(&control.points), control.entry, place.root,
    initialized, &mut storage.*, &mut flow.*)
}

// Release is projected independently, but used only after own-source inclusion. The
// parent/escape gates are shared with the accepted checker, and uncertain occupancy cannot
// establish absence. Definite Flow kills and authenticated interval ends are the only ends.
effect fn sourceReleasedLoanPoints<'body>(graph: &SourceGraphGraph<'body>, control: &SourceControlProjection,
  occupancy: &SourceLoanOccupancy, needs: &SourceLoanNeeds, intervals: &[SourceIntervalProjection],
  views: &[SourceLifetimeProjection], loans: &[Loan], geometry: &SourceSettledGeometry) -> List<u64> ! OutOfMemoryError ? &mut Allocator {
  let points = List<Point>.asSlice(&control.points)
  let required = List<u64>.asSlice(&needs.required)
  let words = (points.length + 63) / 64
  let mut unavailable = List<u64>.make()
  let mut at = usize.ZERO
  while at < words { run List<u64>.append(&mut unavailable, 0) at = at + usize.ONE }
  if List<u64>.length(&occupancy.shadowed) != occupancy.width { return CompilerBug.panic(b"release lost its original definition dispositions") }
  if needs.unresolved || occupancy.unresolved || control.unresolved
    || required.length != words || occupancy.loan >= loans.length { return move unavailable }
  let loan = &loans[occupancy.loan]
  if !loanReleasePolicy(loans, occupancy.loan) || (loan.precision != LoanPrecision.Exact && loan.precision != LoanPrecision.Stored)
    || sourceOwnedGeometry(loan, geometry, true) != SourceTruth.True || loan.created >= points.length { return move unavailable }
  let mut occupied = List<bool>.make()
  let mut ends = List<bool>.make()
  at = usize.ZERO
  while at < points.length {
    let mut carries = at == loan.created || u64.bitAnd(required[wordOf(at)], maskOf(at)) != 0
    let mut survives = false
    let mut ended = false
    let mut word = usize.ZERO
    while word < occupancy.width {
      let eligible = u64.bitNot(List<u64>.asSlice(&occupancy.shadowed)[word])
      let incoming = u64.bitAnd(List<u64>.asSlice(&occupancy.entering)[at * occupancy.width + word], eligible)
      let outgoing = u64.bitAnd(List<u64>.asSlice(&occupancy.leaving)[at * occupancy.width + word], eligible)
      if incoming != 0 || outgoing != 0 { carries = true }
      if outgoing != 0 { survives = true }
      if u64.bitAnd(incoming, u64.bitNot(outgoing)) != 0 { ended = true }
      word = word + usize.ONE
    }
    let mut each = usize.ZERO
    while each < intervals.length {
      let interval = &intervals[each]
      if !interval.holder && interval.source.loan == occupancy.loan && interval.to == at && interval.from <= interval.to
        && SourceGraphGraph.truth(graph, interval.evidence.present) == SourceTruth.True { ended = true }
      each = each + usize.ONE
    }
    each = usize.ZERO
    while each < views.length {
      if views[each].loan == occupancy.loan {
        let occupied = List<SourceAtom>.asSlice(&views[each].occupied)
        let remaining = List<SourceAtom>.asSlice(&views[each].survives)
        let released = List<SourceAtom>.asSlice(&views[each].released)
        if occupied.length != points.length || remaining.length != points.length || released.length != points.length {
          return CompilerBug.panic(b"view release belongs to another CFG")
        }
        let held = SourceGraphGraph.truth(graph, occupied[at])
        let kept = SourceGraphGraph.truth(graph, remaining[at])
        let end = SourceGraphGraph.truth(graph, released[at])
        // An uncertain view cannot authorize release, including a view with no later read.
        if held == SourceTruth.Undefined || kept == SourceTruth.Undefined || end == SourceTruth.Undefined {
          return move unavailable
        }
        if held == SourceTruth.True { carries = true }
        if kept == SourceTruth.True { survives = true }
        if end == SourceTruth.True { ended = true }
      }
      each = each + usize.ONE
    }
    run List<bool>.append(&mut occupied, carries)
    run List<bool>.append(&mut ends, ended && !survives)
    at = at + usize.ONE
  }
  return run releasedInstancePoints(points, control.entry, loan.created,
    List<bool>.asSlice(&occupied), List<bool>.asSlice(&ends))
}

// Flight classification retains the accepted strict interval endpoints. Cleanup and storage
// ends additionally require paths on the same CFG; a source case is authenticated independently
// of whether the source's old owner still contains it at the consuming event.
effect fn sourceFlight<'body>(graph: &SourceGraphGraph<'body>, control: &SourceControlProjection,
  intervals: &[SourceIntervalProjection], loan: usize, point: usize, storageEnd: bool) -> CallerSource
! OutOfMemoryError ? &mut Allocator {
  let points = List<Point>.asSlice(&control.points)
  if point >= points.length { return CallerSource.Unknown }
  let reachable = SourceGraphGraph.truth(graph,
    List<SourceControl.Point>.asSlice(&SourceGraphGraph.control(graph).points)[point].reachable)
  if reachable == SourceTruth.False { return CallerSource.Absent }
  let mut result = CallerSource.Absent
  let mut at = usize.ZERO
  while at < intervals.length {
    let interval = &intervals[at]
    if !interval.holder && interval.source.loan == loan && interval.from < point && point < interval.to {
      let present = sourceTruthAnd(reachable, SourceGraphGraph.truth(graph, interval.evidence.present))
      if SourceGraphGraph.truth(graph, interval.evidence.missing) != SourceTruth.False { result = CallerSource.Unknown }
      if present != SourceTruth.False {
        if interval.from >= points.length || interval.to >= points.length { result = CallerSource.Unknown }
        else if storageEnd || interval.cleanup {
          let before = run pathReaches(points, interval.from, point)
          if before && run pathReaches(points, point, interval.to) {
            if present == SourceTruth.True && !control.unresolved { return CallerSource.Actual }
            result = CallerSource.Unknown
          }
        } else {
          if present == SourceTruth.True { return CallerSource.Actual }
          result = CallerSource.Unknown
        }
      }
    }
    at = at + usize.ONE
  }
  return result
}

// Bind the accepted region solver to actual graph-backed loan requirements and validity.
// Every loan is checked against its own availability before release or region intersection;
// universal domains keep their universal requirements and do not gain a finite-source proof.
effect fn projectedRegionPoints<'input, 'proof>(input: &RegionInput<'input>,
  sources: &RegionSources<'proof>, owner: &DeclarationId, region: &Shared<Lifetime>,
  regions: &mut List<RegionPoints>, premises: &[RegionBound], symbolic: &mut List<SymbolicRegion>,
  flow: &mut IntervalFlow, storage: &mut RegionAvailability) -> usize ! OutOfMemoryError ? &mut Allocator {
  if input.control.unresolved || input.events.unresolved || input.unresolved { return usize.MAX }
  let existing = List<RegionPoints>.asSlice(&regions.*)
  let mut at = usize.ZERO
  while at < existing.length {
    if Lifetime.equalsShared(&existing[at].region, region) { return at }
    at = at + usize.ONE
  }
  let domain = regionDomain(region, owner, sources.supplied)
  if domain == RegionDomain.Unknown { return usize.MAX }
  let mut selected = List<usize>.make()
  if domain == RegionDomain.Local {
    at = usize.ZERO
    while at < sources.loans.length {
      let activity = regionLoanActivity(sources, at)
      if activity == SourceTruth.False {
        at = at + usize.ONE
        continue
      }
      if regionsCarry(List<Shared<Lifetime>>.asSlice(&sources.loans[at].regions), region, owner, sources.supplied) {
        if activity != SourceTruth.True || !provable(sources.loans[at].precision) { return usize.MAX }
        run List<usize>.append(&mut selected, at)
      }
      at = at + usize.ONE
    }
    if List<usize>.length(&selected) == usize.ZERO
      && !proofContains(List<Shared<Lifetime>>.asSlice(&storage.choices), region) { return usize.MAX }
  }
  let pointCount = List<Point>.length(&input.control.points)
  let words = (pointCount + 63) / 64
  let mut required = List<u64>.make()
  let mut available = List<u64>.make()
  let mut incoming = List<u64>.make()
  at = usize.ZERO
  while at < words {
    let mut initial: u64 = 0
    if domain == RegionDomain.Universal { initial = u64.bitNot(0) }
    run List<u64>.append(&mut required, initial)
    run List<u64>.append(&mut available, u64.bitNot(0))
    run List<u64>.append(&mut incoming, 0)
    at = at + usize.ONE
  }
  let chosen = List<usize>.asSlice(&selected)
  at = usize.ZERO
  while at < chosen.length {
    let index = chosen[at]
    let loan = &sources.loans[index]
    if loan.created >= pointCount { return usize.MAX }
    if index >= input.loans.length { return CompilerBug.panic(b"region projection lost an original loan") }
    let facts = match &input.loans[index] {
      Option<RegionLoanProjection>.Some {value} => &value
      _ => { return usize.MAX }
    }
    if facts.occupancy.loan != index { return CompilerBug.panic(b"region projection changed its original loan identity") }
    let occupancy = &facts.occupancy
    let needs = &facts.needs
    let carriers = &facts.carriers
    let universalBound = run loanParentBoundProved(sources, owner, loan, premises, &mut symbolic.*)
    let finiteBound = !loan.local && proofContains(List<Shared<Lifetime>>.asSlice(&storage.finiteParents), region)
    if facts.geometry.unresolved { return usize.MAX }
    let places = List<SourceSettledPlace>.asSlice(&facts.geometry.alternatives)
    let mut ownWords = List<u64>.make()
    let mut word = usize.ZERO
    while word < words { run List<u64>.append(&mut ownWords, u64.bitNot(0)) word = word + usize.ONE }
    let mut seen = false
    let mut placed = usize.ZERO
    while placed < places.length {
      if places[placed].activity == SourceTruth.Undefined { return usize.MAX }
      if places[placed].activity == SourceTruth.True {
        seen = true
        let initialized = run sourceInitializedOwnedRegion(input.control, input.owners,
          input.localCount, loan, &places[placed].place, region, &mut storage.*, &mut flow.*)
        let own = run sourceLoanAvailable(input.control, input.events, carriers, occupancy, loan, &places[placed].place,
          universalBound || finiteBound, initialized, &storage.*)
        if needs.unresolved || own.unresolved { return usize.MAX }
        let actual = List<u64>.asSlice(&own.points)
        let joined = List<u64>.asMutSlice(&mut ownWords)
        word = usize.ZERO
        while word < words { joined[word] = u64.bitAnd(joined[word], actual[word]) word = word + usize.ONE }
      }
      placed = placed + usize.ONE
    }
    if !seen { return usize.MAX }
    let neededWords = List<u64>.asSlice(&needs.required)
    if !regionSourceFits(neededWords, List<u64>.asSlice(&ownWords)) { return usize.MAX }
    mergeRegionSource(&mut required, &mut available, neededWords, List<u64>.asSlice(&ownWords), List<u64>.asSlice(&facts.released))
    at = at + usize.ONE
  }
  let index = List<RegionPoints>.length(&regions.*)
  run List<RegionPoints>.append(&mut regions.*, RegionPoints {region: Shared<Lifetime>.clone(region),
    required: move required, available: move available, incoming: move incoming})
  return index
}

// Complete retained-region drivers for the graph projection. These install the original
// finite parent edges and reuse the accepted universal gates and requirement worklist.
effect fn projectedFiniteCrossingsProved<'input, 'proof>(input: &RegionInput<'input>,
  sources: &RegionSources<'proof>, owner: &DeclarationId, premises: &[RegionBound], symbolic: &mut List<SymbolicRegion>,
  regions: &mut List<RegionPoints>, edges: &mut List<RegionEdge>, flow: &mut IntervalFlow, storage: &mut RegionAvailability) -> bool
! OutOfMemoryError ? &mut Allocator {
  let roots = match move run finiteCrossingRoots(sources, owner, premises, &mut symbolic.*) {
    Option<List<SymbolicRoot>>.Some {value} => move value
    _ => { return false }
  }
  let mut at = usize.ZERO
  let entries = List<SymbolicRoot>.asSlice(&roots)
  // Record only the complete, grounded parent graph. Every edge is installed below before
  // solving; these finite facts never enter the universal-source cache.
  at = usize.ZERO
  while at < entries.length {
    run List<Shared<Lifetime>>.append(&mut storage.finiteParents, Shared<Lifetime>.clone(&entries[at].region))
    at = at + usize.ONE
  }
  let mut indices = List<usize>.make()
  at = usize.ZERO
  while at < entries.length {
    let index = run projectedRegionPoints(input, sources, owner, &entries[at].region,
      &mut regions.*, premises, &mut symbolic.*, &mut flow.*, &mut storage.*)
    if index == usize.MAX { return false }
    run List<usize>.append(&mut indices, index)
    at = at + usize.ONE
  }
  return run installFiniteParentEdges(entries, List<usize>.asSlice(&indices), &mut regions.*, &mut edges.*)
}

// Freeze only the actual graph projections. This does not solve or interpret a region
// relation, and does not replace the definition/read pairing inside the source adapters.
effect fn sourceLocalRelationsProved<'input, 'body, 'proof>(input: &SourceRegionInput<'input, 'body>,
  sources: &RegionSources<'proof>, owner: &DeclarationId, obligations: &[SafetyObligation],
  premises: &[RegionBound], symbolic: &mut List<SymbolicRegion>, finiteCrossings: bool) -> bool
! OutOfMemoryError ? &mut Allocator {
  let mut loans = List<Option<RegionLoanProjection>>.make()
  let mut flow = emptyIntervalFlow()
  let mut at = usize.ZERO
  while at < sources.loans.length {
    let activity = regionLoanActivity(sources, at)
    if activity == SourceTruth.Undefined || (activity == SourceTruth.True && !provable(sources.loans[at].precision)) { return false }
    if activity == SourceTruth.True {
      let occupancy = run sourceLoanOccupancy(input.graph, input.storage, at)
      let needs = run sourceLoanNeeds(input.graph, input.control, input.storage, &occupancy,
        input.intervals, input.views, sources.loans[at].created, &mut flow)
      let carriers = run sourceAvailabilityProjection(input.graph, input.storage, &occupancy, input.intervals, input.views)
      let released = run sourceReleasedLoanPoints(input.graph, input.control, &occupancy, &needs,
        input.intervals, input.views, sources.loans, &input.geometry[at])
      run List<Option<RegionLoanProjection>>.append(&mut loans, Option<RegionLoanProjection>.some(
        RegionLoanProjection {geometry: run sourceCopyGeometry(&input.geometry[at]), occupancy: move occupancy, needs: move needs, carriers: move carriers, released: move released}))
    } else { run List<Option<RegionLoanProjection>>.append(&mut loans, Option<RegionLoanProjection>.none()) }
    at = at + usize.ONE
  }
  let projected = RegionInput {control: input.control, owners: input.owners,
    localCount: SourceGraphGraph.preparation(input.graph).body.locals.length,
    events: input.events, loans: List<Option<RegionLoanProjection>>.asSlice(&loans),
    unresolved: SourceGraphGraph.truth(input.graph, input.viewMissing) != SourceTruth.False}
  return run projectedLocalRelationsProved(&projected, sources, owner, obligations, premises, &mut symbolic.*, finiteCrossings)
}

effect fn projectedLocalRelationsProved<'input, 'proof>(input: &RegionInput<'input>,
  sources: &RegionSources<'proof>, owner: &DeclarationId, obligations: &[SafetyObligation],
  premises: &[RegionBound], symbolic: &mut List<SymbolicRegion>, finiteCrossings: bool) -> bool
! OutOfMemoryError ? &mut Allocator {
  let loans = sources.loans
  let mut at = usize.ZERO
  while at < loans.length {
    let activity = regionLoanActivity(sources, at)
    if activity == SourceTruth.Undefined || (activity == SourceTruth.True && !provable(loans[at].precision)) { return false }
    at = at + usize.ONE
  }
  let mut regions = List<RegionPoints>.make()
  let mut edges = List<RegionEdge>.make()
  let mut flow = emptyIntervalFlow()
  let mut storage = emptyRegionAvailability()
  if !run recordRegionChoices(owner, obligations, &mut storage) { return false }
  if finiteCrossings && !run projectedFiniteCrossingsProved(input, sources, owner, premises, &mut symbolic.*,
    &mut regions, &mut edges, &mut flow, &mut storage) { return false }
  at = usize.ZERO
  while at < obligations.length {
    match &obligations[at] {
      SafetyObligation.RegionRelation {offered, wanted, inferredStatic, ..} => {
        if let Option<Shared<Lifetime>>.Some {..} = &inferredStatic { return false }
        // A meet offers a lifetime only while every constituent offers it. Decompose only
        // this offered side; every constituent still needs its own provenance and finite proof.
        let count = Lifetime.atomCount(&offered)
        if count == usize.ZERO { return false }
        let mut atom = usize.ZERO
        while atom < count {
          let member = Lifetime.atomAt(&offered, atom)
          let step = run regionRelationStep(sources, owner, &member, &wanted, count, premises, &mut symbolic.*)
          if step == RegionRelationStep.Unproved { return false }
          if step == RegionRelationStep.Finite {
            let source = run projectedRegionPoints(input, sources, owner, &wanted, &mut regions, premises, &mut symbolic.*, &mut flow, &mut storage)
            let target = run projectedRegionPoints(input, sources, owner, &member, &mut regions, premises, &mut symbolic.*, &mut flow, &mut storage)
            if source == usize.MAX || target == usize.MAX { return false }
            run List<RegionEdge>.append(&mut edges, RegionEdge {shorter: source, longer: target})
          }
          atom = atom + usize.ONE
        }
      }
      SafetyObligation.Contents {origin, subject, region} => {
        if !finiteCaptureContents(owner, origin, &subject, &region) { return false }
      }
      SafetyObligation.UnprovedImpliedBound => { return false }
      _ => ()
    }
    at = at + usize.ONE
  }
  return run solveRegionRequirements(&mut regions, List<RegionEdge>.asSlice(&edges))
}

// Operation applicability is an ownership effect on the existing CFG. It is emitted into
// the same rule program as source presence; no graph or reaching-definition pass is rebuilt.
// A subsequent replacement cannot undo a retention that already observed a real source.
effect fn sourceOperationReach(control: &SourceControlReaching, point: usize, rules: &mut SourceProgram)
  -> SourceOperationReach ! OutOfMemoryError ? &mut Allocator {
  let points = List<SourceControl.Point>.asSlice(&control.points)
  if point >= points.length { return CompilerBug.panic(b"caller retention has no actual operation point") }
  let mut reached = List<SourceAtom>.make()
  let mut at = usize.ZERO
  while at < points.length {
    run List<SourceAtom>.append(&mut reached, SourceProgram.atom(&mut rules.*))
    at = at + usize.ONE
  }
  let values = List<SourceAtom>.asSlice(&reached)
  let empty = List<SourceAtom>.make()
  let none = List<SourceAtom>.asSlice(&empty)
  let seed: [SourceAtom; 1] = [points[point].reachable]
  run SourceProgram.rule(&mut rules.*, values[point], &seed, none)
  let edges = List<SourceControl.Edge>.asSlice(&control.edges)
  at = usize.ZERO
  while at < edges.length {
    let edge = edges[at]
    let traversed: [SourceAtom; 3] = [values[edge.from.index], edge.active, points[edge.to.index].reachable]
    run SourceProgram.rule(&mut rules.*, values[edge.to.index], &traversed, none)
    at = at + usize.ONE
  }
  return SourceOperationReach {point: point, at: move reached}
}

struct SourceCallableLifetimes {
  projections: List<SourceLifetimeProjection>
  missing: SourceAtom
}

// Authenticate original binding contents at their real definition. A later replacement
// never supplies this source evidence. Each paired history remains conditional under its
// acquisition and binding, even when physical Flow no longer carries that definition.
effect fn sourceCallableLifetimes<'body>(builder: &mut SourceGraphBuilder<'body>, storage: &SourceStorageProjection,
  bindings: &[SourceCallableBinding], owners: &[SourceVisit.Owner], exits: &[SourceVisit.OwnerExit],
  holders: &SourceHolderProjection, loans: &[Loan]) -> SourceCallableLifetimes
! OutOfMemoryError ? &mut Allocator {
  let mut result = SourceCallableLifetimes {projections: List<SourceLifetimeProjection>.make(), missing: SourceProgram.atom(&mut builder.rules)}
  let mut gaps = List<SourceAtom>.make()
  let empty = List<SourceAtom>.make()
  let none = List<SourceAtom>.asSlice(&empty)
  let definitions = List<SourceStorageDefinition>.asSlice(&storage.definitions)
  let mut at = usize.ZERO
  while at < bindings.length {
    let binding = bindings[at]
    let active = List<SourceControl.Point>.asSlice(&builder.reaching.points)[binding.point.index].reachable
    let mut owner = usize.MAX
    let mut each = usize.ZERO
    while each < owners.length {
      if owners[each].initialized.index == binding.point.index {
        if let SourceVisitOwnerRoot.Local {local} = owners[each].root {
          if local.index == binding.local {
            if owner != usize.MAX { return CompilerBug.panic(b"callable binding has duplicate actual owners") }
            owner = each
          }
        }
      }
      each = each + usize.ONE
    }
    if owner == usize.MAX { return CompilerBug.panic(b"callable binding lost its actual owner acquisition") }
    let mut found = false
    each = usize.ZERO
    while each < definitions.length {
      let retained = &definitions[each]
      let definition = retained.definition
      let writer = match definition.writer { Option<SourceGraph.EvalId>.Some {value} => value.index == binding.evaluation.index _ => false }
      // Ordinary summary publication redirects these exact binding histories out of the
      // physical lane. Its real same-writer definition must retain the callable's lifetime
      // evidence too; excluding summaries would lose it when the physical value is replaced.
      if writer {
        let endpoints = List<PreparedSources.Endpoint>.asSlice(&SourceGraphBuilder.preparation(&builder.*).endpoints)
        let root = match sourceStorageRoot(endpoints, definition.storage) { Option<SourceGraph.Storage>.Some {value} => value
          _ => { return CompilerBug.panic(b"callable binding definition has no canonical storage") } }
        if !sourceOwnerStorage(&builder.*, &owners[owner], root) || definition.point.index != binding.point.index {
          return CompilerBug.panic(b"callable binding definition changed its actual writer/owner")
        }
        found = true
        run List<SourceAtom>.append(&mut gaps, retained.unknown)
        run List<SourceAtom>.append(&mut gaps, retained.missing)
        let inputs = List<SourceGraph.Input>.asSlice(&retained.inputs)
        let mut input = usize.ZERO
        while input < inputs.length {
          let sourceLoan = match &SourceGraphBuilder.leaf(&builder.*, inputs[input].leaf).kind {
            SourceGraphSourceLeaf.Borrow {loan, ..} => Option<usize>.some(loan)
            _ => Option<usize>.none()
          }
          if let Option<usize>.Some {value: loan} = sourceLoan {
            if loan >= loans.length { return CompilerBug.panic(b"callable binding source names an absent loan") }
            let cases = List<SourceGraph.InputCase>.asSlice(&inputs[input].cases)
            let mut history = usize.ZERO
            while history < cases.length {
              let source = SourceEffectSource {case: cases[history].case, category: cases[history].category, value: inputs[input].value, leaf: inputs[input].leaf, loan: loan,
                definition: cases[history].definition, read: cases[history].read}
              let acquired = List<SourceControl.Point>.asSlice(&builder.reaching.points)[loans[loan].created].reachable
              let initializer = SourceGraphBuilder.evaluation(&builder.*, binding.initializer)
              let initialized = List<SourceControl.Point>.asSlice(&builder.reaching.points)[initializer.point.index].reachable
              let gates: [SourceAtom; 5] = [active, definition.active, acquired, initialized, cases[history].quality.present]
              let observed = run SourcePolicy.conjunction(&mut builder.rules, &gates, none)
              let evidence = run sourceCallerEvidence(&mut builder.*, source, observed)
              run List<SourceAtom>.append(&mut gaps, evidence.missing)
              let projected = run sourceCallableLifetime(&builder.reaching, definition.id, SourceVisit.OwnerId {index: owner},
                owners, exits, holders, root, binding.point, loan, evidence.present, &mut builder.rules)
              run List<SourceLifetimeProjection>.append(&mut result.projections, move projected)
              history = history + usize.ONE
            }
          }
          input = input + usize.ONE
        }
      }
      each = each + usize.ONE
    }
    if !found { run List<SourceAtom>.append(&mut gaps, active) }
    at = at + usize.ONE
  }
  result.missing = run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&gaps))
  return move result
}

// The accepted callable binding lifetime is an ownership relation on the SAME CFG.
// Physical replacement kills current contents normally. Only an authenticated whole-owner
// use can keep this original binding live; owner End and reacquisition stop both directions.
effect fn sourceCallableLifetime(control: &SourceControlReaching, definition: SourceControl.DefinitionId,
  owner: SourceVisit.OwnerId, owners: &[SourceVisit.Owner], exits: &[SourceVisit.OwnerExit],
  holders: &SourceHolderProjection, storage: SourceGraph.Storage, initialized: SourceControl.PointId,
  loan: usize, active: SourceAtom, rules: &mut SourceProgram) -> SourceLifetimeProjection
! OutOfMemoryError ? &mut Allocator {
  let points = List<SourceControl.Point>.asSlice(&control.points)
  let edges = List<SourceControl.Edge>.asSlice(&control.edges)
  let mut before = List<SourceAtom>.make()
  let mut after = List<SourceAtom>.make()
  let mut arriving = List<SourceAtom>.make()
  let mut projection = SourceLifetimeProjection {origin: SourceLifetimeOrigin.CallableBinding {definition: definition, owner: owner},
    loan: loan, live: List<SourceAtom>.make(), ends: List<SourceAtom>.make(), required: List<SourceAtom>.make(),
    occupied: List<SourceAtom>.make(), survives: List<SourceAtom>.make(), released: List<SourceAtom>.make()}
  let empty = List<SourceAtom>.make()
  let none = List<SourceAtom>.asSlice(&empty)
  let mut at = usize.ZERO
  while at < points.length {
    run List<SourceAtom>.append(&mut before, SourceProgram.atom(&mut rules.*))
    run List<SourceAtom>.append(&mut after, SourceProgram.atom(&mut rules.*))
    run List<SourceAtom>.append(&mut arriving, SourceProgram.atom(&mut rules.*))
    run List<SourceAtom>.append(&mut projection.live, SourceProgram.atom(&mut rules.*))
    run List<SourceAtom>.append(&mut projection.ends, SourceProgram.atom(&mut rules.*))
    run List<SourceAtom>.append(&mut projection.required, SourceProgram.atom(&mut rules.*))
    run List<SourceAtom>.append(&mut projection.occupied, SourceProgram.atom(&mut rules.*))
    run List<SourceAtom>.append(&mut projection.survives, SourceProgram.atom(&mut rules.*))
    run List<SourceAtom>.append(&mut projection.released, SourceProgram.atom(&mut rules.*))
    at = at + usize.ONE
  }
  let ins = List<SourceAtom>.asSlice(&before)
  let outs = List<SourceAtom>.asSlice(&after)
  let requests = List<SourceHolderRequest>.asSlice(&holders.requests)
  let uses = List<SourceHolderUse>.asSlice(&holders.uses)
  at = usize.ZERO
  while at < uses.length {
    let demand = uses[at]
    let request = requests[demand.request]
    let sameOwner = match request.owner { Option<SourceVisit.OwnerId>.Some {value} => value.index == owner.index _ => true }
    if sameOwner && sourceSameStorage(demand.storage, storage) {
      let gates: [SourceAtom; 2] = [demand.active, points[request.point.index].reachable]
      run SourceProgram.rule(&mut rules.*, ins[request.point.index], &gates, none)
    }
    at = at + usize.ONE
  }
  let local = match owners[owner.index].root { SourceVisitOwnerRoot.Local {local} => local
    _ => { return CompilerBug.panic(b"callable bound lifetime has no local owner") } }
  at = usize.ZERO
  while at < points.length {
    let mut ended = false
    let mut each = usize.ZERO
    while each < exits.length {
      if exits[each].owner.index == owner.index && exits[each].action == SourceVisitOwnerAction.End && exits[each].point.index == at { ended = true }
      each = each + usize.ONE
    }
    let mut reacquired = at == initialized.index
    each = usize.ZERO
    while each < owners.length {
      if owners[each].initialized.index == at {
        if let SourceVisitOwnerRoot.Local {local: other} = owners[each].root {
          if other.index == local.index { reacquired = true }
        }
      }
      each = each + usize.ONE
    }
    if !reacquired {
      let held: [SourceAtom; 2] = [List<SourceAtom>.asSlice(&arriving)[at], points[at].reachable]
      run SourceProgram.rule(&mut rules.*, List<SourceAtom>.asSlice(&projection.occupied)[at], &held, none)
      if ended { run SourceProgram.rule(&mut rules.*, List<SourceAtom>.asSlice(&projection.released)[at], &held, none) }
      else { run SourceProgram.rule(&mut rules.*, List<SourceAtom>.asSlice(&projection.survives)[at], &held, none) }
    }
    if !ended && !reacquired {
      let onward: [SourceAtom; 1] = [outs[at]]
      run SourceProgram.rule(&mut rules.*, ins[at], &onward, none)
      let needed: [SourceAtom; 3] = [List<SourceAtom>.asSlice(&projection.occupied)[at], outs[at], points[at].reachable]
      run SourceProgram.rule(&mut rules.*, List<SourceAtom>.asSlice(&projection.live)[at], &needed, none)
      run SourceProgram.rule(&mut rules.*, List<SourceAtom>.asSlice(&projection.ends)[at], &needed, none)
    }
    let used: [SourceAtom; 2] = [List<SourceAtom>.asSlice(&projection.occupied)[at], ins[at]]
    run SourceProgram.rule(&mut rules.*, List<SourceAtom>.asSlice(&projection.required)[at], &used, none)
    at = at + usize.ONE
  }
  let created: [SourceAtom; 2] = [active, points[initialized.index].reachable]
  run SourceProgram.rule(&mut rules.*, List<SourceAtom>.asSlice(&projection.occupied)[initialized.index], &created, none)
  run SourceProgram.rule(&mut rules.*, List<SourceAtom>.asSlice(&projection.survives)[initialized.index], &created, none)
  run SourceProgram.rule(&mut rules.*, List<SourceAtom>.asSlice(&projection.required)[initialized.index], &created, none)
  at = usize.ZERO
  while at < edges.length {
    let edge = edges[at]
    let next: [SourceAtom; 3] = [ins[edge.to.index], edge.active, points[edge.from.index].reachable]
    run SourceProgram.rule(&mut rules.*, outs[edge.from.index], &next, none)
    let held: [SourceAtom; 3] = [List<SourceAtom>.asSlice(&projection.survives)[edge.from.index], edge.active, points[edge.to.index].reachable]
    run SourceProgram.rule(&mut rules.*, List<SourceAtom>.asSlice(&arriving)[edge.to.index], &held, none)
    at = at + usize.ONE
  }
  return move projection
}

effect fn sourceViewExtents(extents: &[SourceViewExtent]) -> List<SourceViewExtent>
! OutOfMemoryError ? &mut Allocator {
  let mut copied = List<SourceViewExtent>.make()
  let mut at = usize.ZERO
  while at < extents.length { run List<SourceViewExtent>.append(&mut copied, extents[at]) at = at + usize.ONE }
  return move copied
}

// Capture the genuine loan sources of a rvalue descriptor at the original subject use.
// A returned-reference lifetime route is not an address witness, and no owned subject,
// reference acquisition or storage definition is created for this hold.
effect fn sourceViewHolds<'body>(builder: &mut SourceGraphBuilder<'body>, views: &[SourceMatchView],
  loanCount: usize, paths: &mut List<List<Step>>) -> SourceViewHolds ! OutOfMemoryError ? &mut Allocator {
  let mut held = List<SourceViewHold>.make()
  let mut missing = List<SourceAtom>.make()
  let empty = List<SourceAtom>.make()
  let none = List<SourceAtom>.asSlice(&empty)
  let mut at = usize.ZERO
  while at < views.length {
    let view = &views[at]
    let points = List<SourceControl.Point>.asSlice(&builder.reaching.points)
    if view.point.index >= points.length { return CompilerBug.panic(b"match view hold has no actual use point") }
    let active = points[view.point.index].reachable
    match &view.origin {
      SourceViewOrigin.Acquired {loan} => {
        if loan >= loanCount { return CompilerBug.panic(b"match view names an undeclared acquisition") }
        run List<SourceViewHold>.append(&mut held, SourceViewHold {loan: loan, source: view.source,
          scope: view.scope, point: view.point, active: active,
          extents: run sourceViewExtents(List<SourceViewExtent>.asSlice(&view.extents))})
      }
      SourceViewOrigin.Carried {operand} => {
        let operands: [SourceOperand; 1] = [operand]
        let observed = run sourceObserve(&mut builder.*, &operands, SourceGraphValuePhase.Output, &mut paths.*, loanCount, false, Option<usize>.none())
        let unknown: [SourceAtom; 2] = [active, observed.unknown]
        run List<SourceAtom>.append(&mut missing, run SourcePolicy.conjunction(&mut builder.rules, &unknown, none))
        let positions = List<SourceCarryPosition>.asSlice(&observed.positions)
        let mut position = usize.ZERO
        while position < positions.length {
          let loan = positions[position].loan
          let mut prior = usize.ZERO
          while prior < position && positions[prior].loan != loan { prior = prior + usize.ONE }
          if prior == position {
            let mut present = List<SourceAtom>.make()
            let mut each = position
            while each < positions.length {
              if positions[each].loan == loan {
                let histories = List<SourceCarryCase>.asSlice(&positions[each].cases)
                if histories.length == usize.ZERO {
                  let gap: [SourceAtom; 2] = [active, positions[each].quality.present]
                  run List<SourceAtom>.append(&mut missing, run SourcePolicy.conjunction(&mut builder.rules, &gap, none))
                }
                let mut history = usize.ZERO
                while history < histories.length {
                  let evidence = run sourceCallerEvidence(&mut builder.*, sourceEffectSource(&positions[each], &histories[history]), active)
                  run List<SourceAtom>.append(&mut present, evidence.present)
                  run List<SourceAtom>.append(&mut missing, evidence.missing)
                  history = history + usize.ONE
                }
              }
              each = each + usize.ONE
            }
            run List<SourceViewHold>.append(&mut held, SourceViewHold {loan: loan, source: view.source,
              scope: view.scope, point: view.point,
              active: run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&present)),
              extents: run sourceViewExtents(List<SourceViewExtent>.asSlice(&view.extents))})
          }
          position = position + usize.ONE
        }
      }
    }
    at = at + usize.ONE
  }
  return SourceViewHolds {holds: move held,
    missing: run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&missing))}
}

// Match-view liveness is one ordinary backwards use equation on the existing Flow. Its
// bit names the real view loan, never a synthetic storage definition. Emitting the equation
// into the same Program preserves per-point Undefined evidence until the sole graph solve.
effect fn sourceViewProjection(control: &SourceControlReaching, views: &[SourceViewHold],
  events: &[Event], gates: &[SourceEventGate], exits: &[SourceVisit.ScopeExit], rules: &mut SourceProgram)
  -> List<SourceLifetimeProjection> ! OutOfMemoryError ? &mut Allocator {
  let points = List<SourceControl.Point>.asSlice(&control.points)
  let edges = List<SourceControl.Edge>.asSlice(&control.edges)
  let empty = List<SourceAtom>.make()
  let none = List<SourceAtom>.asSlice(&empty)
  let mut projected = List<SourceLifetimeProjection>.make()
  let mut view = usize.ZERO
  while view < views.length {
    let actual = &views[view]
    let mut prior = usize.ZERO
    while prior < view {
      if views[prior].loan == actual.loan && views[prior].source.index == actual.source.index
        && views[prior].point.index == actual.point.index { return CompilerBug.panic(b"view loan requirements were projected twice") }
      prior = prior + usize.ONE
    }
    if actual.point.index >= points.length { return CompilerBug.panic(b"view loan has no actual acquisition point") }
    let mut before = List<SourceAtom>.make()
    let mut after = List<SourceAtom>.make()
    let mut live = List<SourceAtom>.make()
    let mut ends = List<SourceAtom>.make()
    let mut required = List<SourceAtom>.make()
    let mut arriving = List<SourceAtom>.make()
    let mut occupied = List<SourceAtom>.make()
    let mut survives = List<SourceAtom>.make()
    let mut released = List<SourceAtom>.make()
    let mut at = usize.ZERO
    while at < points.length {
      run List<SourceAtom>.append(&mut before, SourceProgram.atom(&mut rules.*))
      run List<SourceAtom>.append(&mut after, SourceProgram.atom(&mut rules.*))
      run List<SourceAtom>.append(&mut live, SourceProgram.atom(&mut rules.*))
      run List<SourceAtom>.append(&mut ends, SourceProgram.atom(&mut rules.*))
      run List<SourceAtom>.append(&mut required, SourceProgram.atom(&mut rules.*))
      run List<SourceAtom>.append(&mut arriving, SourceProgram.atom(&mut rules.*))
      run List<SourceAtom>.append(&mut occupied, SourceProgram.atom(&mut rules.*))
      run List<SourceAtom>.append(&mut survives, SourceProgram.atom(&mut rules.*))
      run List<SourceAtom>.append(&mut released, SourceProgram.atom(&mut rules.*))
      at = at + usize.ONE
    }
    let ins = List<SourceAtom>.asSlice(&before)
    let outs = List<SourceAtom>.asSlice(&after)
    let active = actual.active
    let acquired = run sourceOperationReach(control, actual.point.index, &mut rules.*)
    let reaches = List<SourceAtom>.asSlice(&acquired.at)
    at = usize.ZERO
    while at < events.length {
      let event = &events[at]
      if listsIndex(List<usize>.asSlice(&event.binders), actual.source.index) {
        if event.point >= points.length { return CompilerBug.panic(b"view binding use has no actual event point") }
        let mut used = List<SourceAtom>.make()
        run List<SourceAtom>.append(&mut used, active)
        run List<SourceAtom>.append(&mut used, points[event.point].reachable)
        let mut gate = usize.ZERO
        while gate < gates.length {
          if gates[gate].event == at { run List<SourceAtom>.append(&mut used, gates[gate].active) }
          gate = gate + usize.ONE
        }
        run SourceProgram.rule(&mut rules.*, ins[event.point], List<SourceAtom>.asSlice(&used), none)
      }
      at = at + usize.ONE
    }
    at = usize.ZERO
    while at < points.length {
      let mut killed = at == actual.point.index
      let mut exited = false
      let mut exit = usize.ZERO
      while exit < exits.length {
        if exits[exit].scope.index == actual.scope.index && exits[exit].point.index == at {
          killed = true
          exited = true
        }
        exit = exit + usize.ONE
      }
      // A real view retains its source until its actual scope exits, independently of
      // whether a binding is read again. These are view lifetime equations in the same
      // Program, not extra storage definitions or a second reaching relation.
      let arriving: [SourceAtom; 2] = [List<SourceAtom>.asSlice(&arriving)[at], points[at].reachable]
      if at != actual.point.index {
        run SourceProgram.rule(&mut rules.*, List<SourceAtom>.asSlice(&occupied)[at], &arriving, none)
        if exited {
          run SourceProgram.rule(&mut rules.*, List<SourceAtom>.asSlice(&released)[at], &arriving, none)
        } else {
          run SourceProgram.rule(&mut rules.*, List<SourceAtom>.asSlice(&survives)[at], &arriving, none)
        }
      }
      if !killed {
        let onward: [SourceAtom; 1] = [outs[at]]
        run SourceProgram.rule(&mut rules.*, ins[at], &onward, none)
      }
      let held: [SourceAtom; 4] = [active, outs[at], reaches[at], points[at].reachable]
      run SourceProgram.rule(&mut rules.*, List<SourceAtom>.asSlice(&live)[at], &held, none)
      run SourceProgram.rule(&mut rules.*, List<SourceAtom>.asSlice(&ends)[at], &held, none)
      let needed: [SourceAtom; 4] = [active, ins[at], reaches[at], points[at].reachable]
      run SourceProgram.rule(&mut rules.*, List<SourceAtom>.asSlice(&required)[at], &needed, none)
      run SourceProgram.rule(&mut rules.*, List<SourceAtom>.asSlice(&required)[at], &held, none)
      at = at + usize.ONE
    }
    let created: [SourceAtom; 1] = [active]
    run SourceProgram.rule(&mut rules.*, List<SourceAtom>.asSlice(&required)[actual.point.index], &created, none)
    run SourceProgram.rule(&mut rules.*, List<SourceAtom>.asSlice(&occupied)[actual.point.index], &created, none)
    run SourceProgram.rule(&mut rules.*, List<SourceAtom>.asSlice(&survives)[actual.point.index], &created, none)
    at = usize.ZERO
    while at < edges.length {
      let edge = edges[at]
      let next: [SourceAtom; 3] = [ins[edge.to.index], edge.active, points[edge.from.index].reachable]
      run SourceProgram.rule(&mut rules.*, outs[edge.from.index], &next, none)
      let carried: [SourceAtom; 3] = [List<SourceAtom>.asSlice(&survives)[edge.from.index],
        edge.active, points[edge.from.index].reachable]
      run SourceProgram.rule(&mut rules.*, List<SourceAtom>.asSlice(&arriving)[edge.to.index], &carried, none)
      at = at + usize.ONE
    }
    let extents = List<SourceViewExtent>.asSlice(&actual.extents)
    let mut extent = usize.ZERO
    while extent < extents.length {
      let interval = extents[extent]
      if interval.from.index >= points.length || interval.to.index >= points.length {
        return CompilerBug.panic(b"view lifetime extent lost its actual arm or scope endpoint")
      }
      let started = run sourceOperationReach(control, interval.from.index, &mut rules.*)
      let forward = List<SourceAtom>.asSlice(&started.at)
      let reverse = run sourceEndpointReach(control, interval.to.index, &mut rules.*)
      let backward = List<SourceAtom>.asSlice(&reverse)
      at = interval.from.index
      while at <= interval.to.index {
        let needed: [SourceAtom; 4] = [active, forward[at], backward[at], points[at].reachable]
        run SourceProgram.rule(&mut rules.*, List<SourceAtom>.asSlice(&required)[at], &needed, none)
        if interval.from.index < at && at < interval.to.index {
          // Ordinary accesses retain the accepted strict interval. An owner end additionally
          // owes both actual paths, as flightEnds does; an unreachable completion is no end.
          let ordinary: [SourceAtom; 3] = [active, forward[at], points[at].reachable]
          run SourceProgram.rule(&mut rules.*, List<SourceAtom>.asSlice(&live)[at], &ordinary, none)
          run SourceProgram.rule(&mut rules.*, List<SourceAtom>.asSlice(&ends)[at], &needed, none)
        }
        at = at + usize.ONE
      }
      extent = extent + usize.ONE
    }
    run List<SourceLifetimeProjection>.append(&mut projected, SourceLifetimeProjection {
      origin: SourceLifetimeOrigin.MatchView {source: actual.source, point: actual.point},
      loan: actual.loan, live: move live, ends: move ends, required: move required,
      occupied: move occupied, survives: move survives, released: move released})
    view = view + usize.ONE
  }
  return move projected
}

// The symbolic counterpart of intervalEndpoint, using only the retained Flow's edges and
// rule atoms. No new CFG, reaching definitions or additional solve is constructed here.
effect fn sourceEndpointReach(control: &SourceControlReaching, endpoint: usize, rules: &mut SourceProgram)
  -> List<SourceAtom> ! OutOfMemoryError ? &mut Allocator {
  let points = List<SourceControl.Point>.asSlice(&control.points)
  if endpoint >= points.length { return CompilerBug.panic(b"view interval has no actual endpoint") }
  let mut reached = List<SourceAtom>.make()
  let mut at = usize.ZERO
  while at < points.length {
    run List<SourceAtom>.append(&mut reached, SourceProgram.atom(&mut rules.*))
    at = at + usize.ONE
  }
  let values = List<SourceAtom>.asSlice(&reached)
  let empty = List<SourceAtom>.make()
  let none = List<SourceAtom>.asSlice(&empty)
  let seed: [SourceAtom; 1] = [points[endpoint].reachable]
  run SourceProgram.rule(&mut rules.*, values[endpoint], &seed, none)
  let edges = List<SourceControl.Edge>.asSlice(&control.edges)
  at = usize.ZERO
  while at < edges.length {
    let edge = edges[at]
    let previous: [SourceAtom; 3] = [values[edge.to.index], edge.active, points[edge.from.index].reachable]
    run SourceProgram.rule(&mut rules.*, values[edge.from.index], &previous, none)
    at = at + usize.ONE
  }
  return move reached
}

fn sourceViewAt<'body>(graph: &SourceGraphGraph<'body>, views: &[SourceLifetimeProjection],
  loan: usize, point: usize, storageEnd: bool) -> CallerSource {
  let mut result = CallerSource.Absent
  let mut at = usize.ZERO
  while at < views.length {
    if views[at].loan == loan {
      let mut states = List<SourceAtom>.asSlice(&views[at].live)
      if storageEnd { states = List<SourceAtom>.asSlice(&views[at].ends) }
      if point >= states.length { return CompilerBug.panic(b"view liveness queried at a foreign point") }
      let active = SourceGraphGraph.truth(graph, states[point])
      if active == SourceTruth.True { return CallerSource.Actual }
      if active == SourceTruth.Undefined { result = CallerSource.Unknown }
    }
    at = at + usize.ONE
  }
  return result
}

// Caller provenance is a separate interpretation of the existing Case graph. The
// graph's raw-history authentication also serves intervals/escape and remains unchanged.
// One row per actual Case prevents an unrelated arrival in the same cell from proving
// that particular operation's source. Predecessor cells fold Actual > Unknown > Absent.
effect fn sourceCallerClasses<'body>(builder: &mut SourceGraphBuilder<'body>) -> List<SourceCallerEvidence>
! OutOfMemoryError ? &mut Allocator {
  let pairs = run sourceFlowPairIndex(&builder.reaching)
  let empty = List<SourceAtom>.make()
  let none = List<SourceAtom>.asSlice(&empty)
  let count = SourceGraphBuilder.caseCount(&builder.*)
  let mut cells = usize.ZERO
  let mut at = usize.ZERO
  while at < count {
    let edge = SourceGraphBuilder.case(&builder.*, at)
    if edge.id != at { return CompilerBug.panic(b"caller ancestry changed an actual Case ordinal") }
    if edge.target.id >= cells { cells = edge.target.id + usize.ONE }
    if let Option<SourceGraph.CellView>.Some {value} = edge.source {
      if value.id >= cells { cells = value.id + usize.ONE }
    }
    at = at + usize.ONE
  }
  let mut joined = List<SourceCallerEvidence>.make()
  let mut possible = List<SourceAtom>.make()
  at = usize.ZERO
  while at < cells {
    let actual = SourceProgram.atom(&mut builder.rules)
    let unknown = SourceProgram.atom(&mut builder.rules)
    let maybe = SourceProgram.atom(&mut builder.rules)
    run List<SourceCallerEvidence>.append(&mut joined, SourceCallerEvidence {present: actual, missing: unknown})
    run List<SourceAtom>.append(&mut possible, maybe)
    let positive: [SourceAtom; 1] = [maybe]
    let negative: [SourceAtom; 1] = [actual]
    run SourceProgram.rule(&mut builder.rules, unknown, &positive, &negative)
    at = at + usize.ONE
  }
  let mut result = List<SourceCallerEvidence>.make()
  at = usize.ZERO
  while at < count {
    let edge = SourceGraphBuilder.case(&builder.*, at)
    let target = edge.target
    let observation = SourceGraphBuilder.observationCase(&builder.*, at)
    let applicable: [SourceAtom; 2] = [edge.active, observation.semantic.present]
    let active = run SourcePolicy.conjunction(&mut builder.rules, &applicable, none)
    let actual = SourceProgram.atom(&mut builder.rules)
    let unknown = SourceProgram.atom(&mut builder.rules)
    let mut absent = false
    let mut unsupported = false
    let mut paired = active
    match edge.definition {
      Option<SourceControl.DefinitionId>.Some {value: definition} => {
        match edge.read {
          Option<SourceControl.ReadId>.Some {value: read} => {
            let original = SourceGraphBuilder.definition(&builder.*, definition)
            let observed = SourceGraphBuilder.read(&builder.*, read)
            let sameSource = match edge.source { Option<SourceGraph.CellView>.Some {value} => value.value.index == original.value.index _ => false }
            if !sameSource || !sourceSameReadLane(original, observed)
              || !sourceDefinitionMatches(target.definition, edge.definition) || !sourceReadMatches(target.read, edge.read) {
              unsupported = true
            } else {
              match sourceIndexedFlowPair(&builder.reaching, &pairs, definition, read) {
                Option<SourceAtom>.Some {value} => {
                  let gates: [SourceAtom; 2] = [active, value]
                  paired = run SourcePolicy.conjunction(&mut builder.rules, &gates, none)
                }
                _ => { unsupported = true }
              }
              if let Option<usize>.Some {value: summary} = original.summary {
                let held = SourceGraphBuilder.summaries(&builder.*)[summary]
                // MAX precedes the Shadowed predicate in the accepted classifier.
                if sourceUnknownPlacement(held.placement) { unsupported = true }
                else if held.disposition == SourceGraphSummaryDisposition.Shadowed { absent = true }
              }
            }
          }
          _ => { unsupported = true }
        }
      }
      _ => { if let Option<SourceControl.ReadId>.Some {..} = edge.read { unsupported = true } }
    }
    if unsupported {
      let gates: [SourceAtom; 1] = [active]
      run SourceProgram.rule(&mut builder.rules, unknown, &gates, none)
    } else if !absent {
      match edge.source {
        Option<SourceGraph.CellView>.Some {value: previous} => {
          if previous.leaf.index != target.leaf.index { return CompilerBug.panic(b"caller ancestry substituted a different actual source") }
          let source = List<SourceCallerEvidence>.asSlice(&joined)[previous.id]
          let known: [SourceAtom; 2] = [paired, source.present]
          let missing: [SourceAtom; 2] = [paired, source.missing]
          run SourceProgram.rule(&mut builder.rules, actual, &known, none)
          run SourceProgram.rule(&mut builder.rules, unknown, &missing, none)
        }
        _ => {
          let fresh = match &SourceGraphBuilder.leaf(&builder.*, target.leaf).kind { SourceGraphSourceLeaf.Borrow {..} => true _ => false }
          let unpaired = match target.definition { Option<SourceControl.DefinitionId>.None => true _ => false }
            && match target.read { Option<SourceControl.ReadId>.None => true _ => false }
          let seed: [SourceAtom; 1] = [paired]
          if fresh && unpaired && target.category == SourceGraphSourceRole.Physical {
            run SourceProgram.rule(&mut builder.rules, actual, &seed, none)
          } else { run SourceProgram.rule(&mut builder.rules, unknown, &seed, none) }
        }
      }
    }
    let selected = List<SourceCallerEvidence>.asSlice(&joined)[target.id]
    let positive: [SourceAtom; 1] = [actual]
    let missing: [SourceAtom; 1] = [unknown]
    run SourceProgram.rule(&mut builder.rules, selected.present, &positive, none)
    run SourceProgram.rule(&mut builder.rules, List<SourceAtom>.asSlice(&possible)[target.id], &missing, none)
    run List<SourceCallerEvidence>.append(&mut result, SourceCallerEvidence {present: actual, missing: unknown})
    at = at + usize.ONE
  }
  return move result
}

// Authenticate the requested output Case before joining its caller classification.
// Raw evidence remains available to every noncaller proof, including copied shadows.
effect fn sourceCallerRetention<'body>(builder: &mut SourceGraphBuilder<'body>, classes: &[SourceCallerEvidence],
  source: SourceEffectSource, active: SourceAtom) -> SourceCallerEvidence ! OutOfMemoryError ? &mut Allocator {
  let raw = run sourceCallerEvidence(&mut builder.*, source, active)
  if source.case >= classes.length { return CompilerBug.panic(b"caller request has no actual Case") }
  let actual = SourceGraphBuilder.case(&builder.*, source.case).target
  if actual.value.index != source.value.index || actual.leaf.index != source.leaf.index || actual.category != source.category
    || !sourceDefinitionMatches(actual.definition, source.definition) || !sourceReadMatches(actual.read, source.read) {
    return CompilerBug.panic(b"caller request changed its exact raw source history")
  }
  let empty = List<SourceAtom>.make()
  let none = List<SourceAtom>.asSlice(&empty)
  let known: [SourceAtom; 2] = [raw.present, classes[source.case].present]
  let unknown: [SourceAtom; 2] = [raw.present, classes[source.case].missing]
  let gaps: [SourceAtom; 2] = [raw.missing, run SourcePolicy.conjunction(&mut builder.rules, &unknown, none)]
  return SourceCallerEvidence {present: run SourcePolicy.conjunction(&mut builder.rules, &known, none),
    missing: run SourcePolicy.disjunction(&mut builder.rules, &gaps)}
}

// Preserve the independent snapshot before adding any caller escape. Aggregate escape is
// for conservative region availability only; event diagnostics use sourceCallerAt below.
effect fn sourceCallerProjection<'body>(builder: &mut SourceGraphBuilder<'body>, independent: &[SourceCallerEvidence],
  effects: &[SourceRetentionEffect]) -> SourceCallerProjection ! OutOfMemoryError ? &mut Allocator {
  let classes = run sourceCallerClasses(&mut builder.*)
  let mut snapshot = List<SourceAtom>.make()
  let mut independentMissing = List<SourceAtom>.make()
  let mut missing = List<SourceAtom>.make()
  let mut storing = List<SourceAtom>.make()
  let mut loan = usize.ZERO
  while loan < independent.length {
    let mut reasons = List<SourceAtom>.make()
    let mut gaps = List<SourceAtom>.make()
    run List<SourceAtom>.append(&mut reasons, independent[loan].present)
    run List<SourceAtom>.append(&mut gaps, independent[loan].missing)
    let mut each = usize.ZERO
    while each < effects.length {
      if effects[each].source.loan == loan {
        let evidence = run sourceCallerEvidence(&mut builder.*, effects[each].source, effects[each].independent)
        run List<SourceAtom>.append(&mut reasons, evidence.present)
        run List<SourceAtom>.append(&mut gaps, evidence.missing)
      }
      each = each + usize.ONE
    }
    run List<SourceAtom>.append(&mut snapshot, run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&reasons)))
    let gap = run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&gaps))
    run List<SourceAtom>.append(&mut independentMissing, gap)
    run List<SourceAtom>.append(&mut missing, gap)
    loan = loan + usize.ONE
  }
  let mut retentions = List<SourceCallerRetention>.make()
  let mut operations = List<SourceOperationReach>.make()
  let mut at = usize.ZERO
  while at < effects.length {
    let retainedEffect = &effects[at]
    if retainedEffect.source.loan >= independent.length { return CompilerBug.panic(b"caller retention names an undeclared loan") }
    let mut operation = usize.ZERO
    while operation < List<SourceOperationReach>.length(&operations)
      && List<SourceOperationReach>.asSlice(&operations)[operation].point != retainedEffect.point {
      operation = operation + usize.ONE
    }
    if operation == List<SourceOperationReach>.length(&operations) {
      run List<SourceOperationReach>.append(&mut operations,
        run sourceOperationReach(&builder.reaching, retainedEffect.point, &mut builder.rules))
    }
    let evidence = run sourceCallerRetention(&mut builder.*, List<SourceCallerEvidence>.asSlice(&classes), retainedEffect.source, retainedEffect.caller)
    run List<SourceCallerRetention>.append(&mut retentions, SourceCallerRetention {
      source: retainedEffect.source, operation: operation, present: evidence.present, missing: evidence.missing})
    run List<SourceAtom>.append(&mut missing, evidence.missing)
    let stored = run sourceCallerEvidence(&mut builder.*, retainedEffect.source, retainedEffect.storing)
    run List<SourceAtom>.append(&mut storing, stored.present)
    run List<SourceAtom>.append(&mut missing, stored.missing)
    at = at + usize.ONE
  }
  let mut aggregate = List<SourceAtom>.make()
  loan = usize.ZERO
  while loan < independent.length {
    let mut reasons = List<SourceAtom>.make()
    run List<SourceAtom>.append(&mut reasons, List<SourceAtom>.asSlice(&snapshot)[loan])
    run List<SourceAtom>.append(&mut reasons, List<SourceAtom>.asSlice(&independentMissing)[loan])
    let retained = List<SourceCallerRetention>.asSlice(&retentions)
    at = usize.ZERO
    while at < retained.length {
      if retained[at].source.loan == loan {
        run List<SourceAtom>.append(&mut reasons, retained[at].present)
        run List<SourceAtom>.append(&mut reasons, retained[at].missing)
      }
      at = at + usize.ONE
    }
    run List<SourceAtom>.append(&mut aggregate, run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&reasons)))
    loan = loan + usize.ONE
  }
  return SourceCallerProjection {retentions: move retentions, operations: move operations, independent: move snapshot, independentMissing: move independentMissing,
    aggregate: move aggregate, storing: run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&storing)),
    missing: run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&missing))}
}

fn sourceCallerTruth(present: SourceTruth, missing: SourceTruth, reaches: SourceTruth) -> CallerSource {
  if reaches == SourceTruth.False { return CallerSource.Absent }
  if present == SourceTruth.True && reaches == SourceTruth.True { return CallerSource.Actual }
  if present != SourceTruth.False || missing != SourceTruth.False { return CallerSource.Unknown }
  return CallerSource.Absent
}

fn sourceCallerAt<'body>(graph: &SourceGraphGraph<'body>, projection: &SourceCallerProjection,
  loan: usize, point: usize) -> CallerSource {
  let retentions = List<SourceCallerRetention>.asSlice(&projection.retentions)
  let operations = List<SourceOperationReach>.asSlice(&projection.operations)
  let mut result = CallerSource.Absent
  let mut at = usize.ZERO
  while at < retentions.length {
    let retained = &retentions[at]
    if retained.source.loan == loan {
      if retained.operation >= operations.length { return CallerSource.Unknown }
      let reached = List<SourceAtom>.asSlice(&operations[retained.operation].at)
      if point >= reached.length { return CallerSource.Unknown }
      let selected = sourceCallerTruth(SourceGraphGraph.truth(graph, retained.present),
        SourceGraphGraph.truth(graph, retained.missing), SourceGraphGraph.truth(graph, reached[point]))
      if selected == CallerSource.Actual { return CallerSource.Actual }
      if selected == CallerSource.Unknown { result = CallerSource.Unknown }
    }
    at = at + usize.ONE
  }
  return result
}

// This is a terminal projection of the last immutable P version and ordered input effects.
// No value in it is fed back into an earlier observation or result decision.
struct SourceLoanPolicy {
  quality: SourceQuality
  bound: SourceAtom
  crossed: SourceAtom
  storable: SourceAtom
}

struct SourceLoanEffect {
  loan: usize
  evidence: SourceCallerEvidence
}

struct SourceLoanPolicies {
  loans: List<SourceLoanPolicy>
  unretained: List<SourceLoanEffect>
  callers: SourceCallerProjection
  storing: SourceAtom
  missing: SourceAtom
}

struct SourceSettledLoans {
  loans: List<Loan>
  geometry: List<SourceSettledGeometry>
  activity: List<SourceTruth>
  // Kept in actual observation order, including repeated genuine occurrences.
  unretained: List<usize>
  storable: List<usize>
  independent: List<CallerSource>
  storing: SourceTruth
  unresolved: bool
}

// Retain the exact paired source histories before solving. Written/capture escape belongs
// to the independent snapshot; later operation retention is aggregated only by its owner.
effect fn sourceLoanPolicies<'body>(builder: &mut SourceGraphBuilder<'body>, state: &SourceLoanState,
  loans: &[Loan], results: &[SourcePositionResult], crossings: &[SourceCrossingEffect],
  written: &[SourceEscapeEffect], captures: &[SourceCaptureEffect], retention: &[SourceRetentionEffect])
  -> SourceLoanPolicies ! OutOfMemoryError ? &mut Allocator {
  let mut check = usize.ZERO
  while check < crossings.length {
    if crossings[check].source.loan >= loans.length { return CompilerBug.panic(b"crossing names an undeclared loan") }
    check = check + usize.ONE
  }
  check = usize.ZERO
  while check < written.length {
    if written[check].source.loan >= loans.length { return CompilerBug.panic(b"written escape names an undeclared loan") }
    check = check + usize.ONE
  }
  check = usize.ZERO
  while check < captures.length {
    if captures[check].source.loan >= loans.length { return CompilerBug.panic(b"capture effect names an undeclared loan") }
    check = check + usize.ONE
  }
  let mut projected = List<SourceLoanPolicy>.make()
  let mut independent = List<SourceCallerEvidence>.make()
  let mut unretained = List<SourceLoanEffect>.make()
  let mut missing = List<SourceAtom>.make()
  let mut storing = List<SourceAtom>.make()
  let empty = List<SourceAtom>.make()
  let none = List<SourceAtom>.asSlice(&empty)
  let mut loan = usize.ZERO
  while loan < loans.length {
    if loans[loan].created >= List<SourceControl.Point>.length(&builder.reaching.points) {
      return CompilerBug.panic(b"terminal policy lost the actual loan acquisition")
    }
    let active = List<SourceControl.Point>.asSlice(&builder.reaching.points)[loans[loan].created].reachable
    let mut boundSources = List<SourceAtom>.make()
    let mut crossedSources = List<SourceAtom>.make()
    let mut escapes = List<SourceAtom>.make()
    let mut escapeGaps = List<SourceAtom>.make()
    let mut storableSources = List<SourceAtom>.make()
    if loans[loan].bound { run List<SourceAtom>.append(&mut boundSources, active) }
    if loans[loan].crossed { run List<SourceAtom>.append(&mut crossedSources, active) }
    if loans[loan].escapes { run List<SourceAtom>.append(&mut escapes, active) }
    let mut at = usize.ZERO
    while at < results.length {
      if results[at].source.loan == loan {
        let evidence = run sourceCallerEvidence(&mut builder.*, results[at].source, results[at].decision.bound)
        run List<SourceAtom>.append(&mut boundSources, evidence.present)
        run List<SourceAtom>.append(&mut missing, evidence.missing)
        run List<SourceAtom>.append(&mut missing, results[at].missing)
      }
      at = at + usize.ONE
    }
    at = usize.ZERO
    while at < crossings.length {
      if crossings[at].source.loan == loan {
        let evidence = run sourceCallerEvidence(&mut builder.*, crossings[at].source, crossings[at].active)
        run List<SourceAtom>.append(&mut crossedSources, evidence.present)
        run List<SourceAtom>.append(&mut missing, evidence.missing)
      }
      at = at + usize.ONE
    }
    at = usize.ZERO
    while at < written.length {
      if written[at].source.loan == loan {
        let evidence = run sourceCallerEvidence(&mut builder.*, written[at].source, written[at].active)
        run List<SourceAtom>.append(&mut escapes, evidence.present)
        run List<SourceAtom>.append(&mut escapeGaps, evidence.missing)
      }
      at = at + usize.ONE
    }
    at = usize.ZERO
    while at < captures.length {
      if captures[at].source.loan == loan {
        let escape = run sourceCallerEvidence(&mut builder.*, captures[at].source, captures[at].escape)
        let store = run sourceCallerEvidence(&mut builder.*, captures[at].source, captures[at].storing)
        let mayStore = run sourceCallerEvidence(&mut builder.*, captures[at].source, captures[at].storable)
        run List<SourceAtom>.append(&mut escapes, escape.present)
        run List<SourceAtom>.append(&mut escapeGaps, escape.missing)
        run List<SourceAtom>.append(&mut storing, store.present)
        run List<SourceAtom>.append(&mut storableSources, mayStore.present)
        run List<SourceAtom>.append(&mut missing, store.missing)
        run List<SourceAtom>.append(&mut missing, mayStore.missing)
      }
      at = at + usize.ONE
    }
    let bounds = run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&boundSources))
    let crossed = run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&crossedSources))
    let storable = run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&storableSources))
    let boundGate: [SourceAtom; 2] = [active, bounds]
    let crossGate: [SourceAtom; 2] = [active, crossed]
    let storeGate: [SourceAtom; 2] = [active, storable]
    run List<SourceLoanPolicy>.append(&mut projected, SourceLoanPolicy {
      quality: SourceLoanState.quality(state, loan, active),
      bound: run SourcePolicy.conjunction(&mut builder.rules, &boundGate, none),
      crossed: run SourcePolicy.conjunction(&mut builder.rules, &crossGate, none),
      storable: run SourcePolicy.conjunction(&mut builder.rules, &storeGate, none)})
    run List<SourceCallerEvidence>.append(&mut independent, SourceCallerEvidence {
      present: run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&escapes)),
      missing: run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&escapeGaps))})
    loan = loan + usize.ONE
  }
  let mut at = usize.ZERO
  while at < results.length {
    if results[at].source.loan >= loans.length { return CompilerBug.panic(b"result effect names an undeclared loan") }
    let mut prior = usize.ZERO
    while prior < at && (results[prior].result.index != results[at].result.index || results[prior].position != results[at].position) {
      prior = prior + usize.ONE
    }
    if prior == at {
      // Alternative histories are one actual position. A later genuine position remains a
      // separate entry even when it retains the same loan, value or authored NodeId.
      let mut dropped = List<SourceAtom>.make()
      let mut gaps = List<SourceAtom>.make()
      let mut each = at
      while each < results.length {
        if results[each].result.index == results[at].result.index && results[each].position == results[at].position {
          if results[each].source.loan != results[at].source.loan
            || results[each].source.value.index != results[at].source.value.index
            || results[each].source.leaf.index != results[at].source.leaf.index {
            return CompilerBug.panic(b"terminal result histories cross-paired physical positions")
          }
          let evidence = run sourceCallerEvidence(&mut builder.*, results[each].source, results[each].decision.unretained)
          run List<SourceAtom>.append(&mut dropped, evidence.present)
          run List<SourceAtom>.append(&mut gaps, evidence.missing)
        }
        each = each + usize.ONE
      }
      let evidence = SourceCallerEvidence {
        present: run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&dropped)),
        missing: run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&gaps))}
      run List<SourceLoanEffect>.append(&mut unretained, SourceLoanEffect {loan: results[at].source.loan, evidence: evidence})
      run List<SourceAtom>.append(&mut missing, evidence.missing)
    }
    at = at + usize.ONE
  }
  let callers = run sourceCallerProjection(&mut builder.*, List<SourceCallerEvidence>.asSlice(&independent), retention)
  run List<SourceAtom>.append(&mut storing, callers.storing)
  run List<SourceAtom>.append(&mut missing, callers.missing)
  return SourceLoanPolicies {loans: move projected, unretained: move unretained, callers: move callers,
    storing: run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&storing)),
    missing: run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&missing))}
}

fn sourceSettledPrecision(before: LoanPrecision, stored: SourceTruth, alternatives: SourceTruth) -> LoanPrecision {
  if before == LoanPrecision.Unknown || stored == SourceTruth.Undefined || alternatives == SourceTruth.Undefined {
    return LoanPrecision.Unknown
  }
  let hasStored = before == LoanPrecision.Stored || stored == SourceTruth.True
  let hasAlternatives = before == LoanPrecision.Alternatives || alternatives == SourceTruth.True
  if hasStored && hasAlternatives { return LoanPrecision.Unknown }
  if hasStored { return LoanPrecision.Stored }
  if hasAlternatives { return LoanPrecision.Alternatives }
  return LoanPrecision.Exact
}

// Consume the real loan catalog without compacting or recreating identities. Undefined and
// missing evidence stays separate from conservative availability flags and cannot certify.
effect fn sourceSettleLoans<'body>(graph: &SourceGraphGraph<'body>, loans: List<Loan>, geometry: List<SourceLoanGeometry>, policies: &SourceLoanPolicies)
  -> SourceSettledLoans ! OutOfMemoryError ? &mut Allocator {
  let activity = run sourceAcquisitionActivity(graph, List<Loan>.asSlice(&loans))
  let mut geometry = move geometry
  if List<SourceLoanGeometry>.length(&geometry) != List<Loan>.length(&loans) { return CompilerBug.panic(b"settled geometry changed the original loan inventory") }
  let mut places = List<SourceSettledGeometry>.make()
  while List<SourceLoanGeometry>.length(&geometry) != usize.ZERO {
    let row = List<SourceLoanGeometry>.remove(&mut geometry, usize.ZERO)
    let mut actual = SourceSettledGeometry {alternatives: List<SourceSettledPlace>.make(),
      unresolved: SourceGraphGraph.truth(graph, row.missing) != SourceTruth.False}
    let mut alternatives = move row.alternatives
    while List<SourceGeometryPlace>.length(&alternatives) != usize.ZERO {
      let alternative = List<SourceGeometryPlace>.remove(&mut alternatives, usize.ZERO)
      let active = SourceGraphGraph.truth(graph, alternative.active)
      if active == SourceTruth.Undefined { actual.unresolved = true }
      run List<SourceSettledPlace>.append(&mut actual.alternatives, SourceSettledPlace {place: move alternative.place, activity: active})
    }
    run List<SourceSettledGeometry>.append(&mut places, move actual)
  }
  let mut result = SourceSettledLoans {loans: move loans, geometry: move places, activity: move activity,
    unretained: List<usize>.make(), storable: List<usize>.make(), independent: List<CallerSource>.make(),
    storing: SourceGraphGraph.truth(graph, policies.storing),
    unresolved: SourceGraphGraph.truth(graph, policies.missing) != SourceTruth.False}
  let projected = List<SourceLoanPolicy>.asSlice(&policies.loans)
  let escapes = List<SourceAtom>.asSlice(&policies.callers.aggregate)
  let independent = List<SourceAtom>.asSlice(&policies.callers.independent)
  let independentMissing = List<SourceAtom>.asSlice(&policies.callers.independentMissing)
  let states = List<SourceTruth>.asSlice(&result.activity)
  if projected.length != states.length || escapes.length != states.length
    || independent.length != states.length || independentMissing.length != states.length {
    return CompilerBug.panic(b"terminal loan policy lost reserved identity order")
  }
  if result.storing == SourceTruth.Undefined { result.unresolved = true }
  let mut at = usize.ZERO
  while at < states.length {
    let active = states[at]
    if active != SourceTruth.False && List<SourceSettledGeometry>.asSlice(&result.geometry)[at].unresolved { result.unresolved = true }
    let independentSource = sourceCallerTruth(SourceGraphGraph.truth(graph, independent[at]),
      SourceGraphGraph.truth(graph, independentMissing[at]), active)
    run List<CallerSource>.append(&mut result.independent, independentSource)
    if active != SourceTruth.False {
      let stored = SourceGraphGraph.truth(graph, projected[at].quality.stored)
      let alternatives = SourceGraphGraph.truth(graph, projected[at].quality.alternatives)
      let bound = SourceGraphGraph.truth(graph, projected[at].bound)
      let crossed = SourceGraphGraph.truth(graph, projected[at].crossed)
      let escape = SourceGraphGraph.truth(graph, escapes[at])
      let storable = SourceGraphGraph.truth(graph, projected[at].storable)
      if active == SourceTruth.Undefined || stored == SourceTruth.Undefined || alternatives == SourceTruth.Undefined
        || bound == SourceTruth.Undefined || crossed == SourceTruth.Undefined || escape == SourceTruth.Undefined
        || storable == SourceTruth.Undefined || independentSource == CallerSource.Unknown { result.unresolved = true }
      let mut actual = List<Loan>.asMutSlice(&mut result.loans)
      actual[at].precision = sourceSettledPrecision(actual[at].precision, stored, alternatives)
      // Unknown bound must not suppress an otherwise grounded ownership diagnostic.
      actual[at].bound = bound == SourceTruth.True
      actual[at].crossed = crossed != SourceTruth.False
      actual[at].escapes = escape != SourceTruth.False
      if storable != SourceTruth.False { run List<usize>.append(&mut result.storable, at) }
    }
    at = at + usize.ONE
  }
  let dropped = List<SourceLoanEffect>.asSlice(&policies.unretained)
  at = usize.ZERO
  while at < dropped.length {
    let entry = &dropped[at]
    if entry.loan >= states.length { return CompilerBug.panic(b"unretained result names an undeclared loan") }
    let present = sourceTruthAnd(states[entry.loan], SourceGraphGraph.truth(graph, entry.evidence.present))
    if present == SourceTruth.True { run List<usize>.append(&mut result.unretained, entry.loan) }
    if present == SourceTruth.Undefined
      || sourceTruthAnd(states[entry.loan], SourceGraphGraph.truth(graph, entry.evidence.missing)) != SourceTruth.False {
      result.unresolved = true
    }
    at = at + usize.ONE
  }
  return move result
}

struct SourceCleanupEffects {
  intervals: List<SourceIntervalEffect>
  refusal: SourceAtom
  missing: SourceAtom
}

struct SourceCaptureEffect {
  source: SourceEffectSource
  point: usize
  escape: SourceAtom
  storing: SourceAtom
  storable: SourceAtom
}

struct SourceConstructionEffects {
  captures: List<SourceCaptureEffect>
  inherited: BorrowStatus
  active: SourceAtom
}

struct SourceDeferredEffects {
  retention: List<SourceRetentionEffect>
  missing: SourceAtom
}

// Dispatch immediately after this actual argument finishes, before visiting the next
// operand. Taking a batch after all argument policies would observe the wrong loan version.
// The captured callee has no argument-retention judgment, and construction never writes
// any destination that only a future invocation can lend.
effect fn sourceDeferInput<'body>(builder: &mut SourceGraphBuilder<'body>, actual: &SourceVisit.Visit,
  input: usize, acquired: &[SourceInputAcquisition], state: &mut SourceLoanState,
  loans: &[Loan], paths: &mut List<List<Step>>) -> SourceDeferredEffects
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let prepared = SourceGraphBuilder.preparation(&builder.*)
  let nodes = prepared.body.nodes
  let owner = prepared.body.owner
  let writtenArguments = match move run shapeOf(nodes, actual.node) {
    Shape.Defer {arguments: deferredArguments, ..} => move deferredArguments
    _ => { return CompilerBug.panic(b"deferred input dispatch selected another semantic handler") }
  }
  let inputs = List<SourceVisit.Input>.asSlice(&actual.inputs)
  if input >= inputs.length { return CompilerBug.panic(b"deferred dispatch lost its actual input position") }
  let selected = inputs[input]
  let no = SourceProgram.atom(&mut builder.rules)
  let ordinal = match selected.read {
    Option<PreparedSourcesInputRead>.Some {value: PreparedSourcesInputRead.Argument {ordinal}} => ordinal
    Option<PreparedSourcesInputRead>.Some {value: PreparedSourcesInputRead.Receiver} => {
      return SourceDeferredEffects {retention: List<SourceRetentionEffect>.make(), missing: no}
    }
    _ => { return CompilerBug.panic(b"deferred input has no actual operand coordinate") }
  }
  let arguments = List<NodeId>.asSlice(&writtenArguments)
  if ordinal >= arguments.length || arguments[ordinal].index != selected.node.index {
    return CompilerBug.panic(b"deferred argument changed its actual occurrence")
  }
  let observation = run sourceCallInput(&mut builder.*, actual, selected, ordinal, acquired, &mut paths.*, loans.length)
  let active = List<SourceControl.Point>.asSlice(&builder.reaching.points)[selected.usePoint.index].reachable
  let sinks = run operandSinks(nodes, actual.node, arguments, owner)
  let snapshot = run sourceBarrier(&observation, &mut state.*, active, &mut builder.rules)
  let retention = run sourceKeepCarried(&observation, List<SourceQuality>.asSlice(&snapshot), loans,
    List<List<Step>>.asSlice(&paths.*), owner, List<OperandSink>.asSlice(&sinks), ordinal,
    selected.usePoint.index, active, &mut builder.rules)
  let gates: [SourceAtom; 2] = [active, observation.unknown]
  let empty = List<SourceAtom>.make()
  return SourceDeferredEffects {retention: move retention,
    missing: run SourcePolicy.conjunction(&mut builder.rules, &gates, List<SourceAtom>.asSlice(&empty))}
}

// Construction holds captures at their real placement. Its closed-contract classifier is
// used solely for the non-storing exemption: it does not publish invocation caller retention
// or write a destination which a future call might lend.
effect fn sourceConstruct(nodes: &[Node], owner: &DeclarationId, loans: &[Loan], geometry: &[SourceLoanGeometry], paths: &[List<Step>],
  observation: &SourceObservation, state: &mut SourceLoanState, values: &[NodeId], staged: bool,
  holdable: &[CaptureHold], body: BorrowStatus, result: NodeId, point: usize, active: SourceAtom,
  rules: &mut SourceProgram) -> SourceConstructionEffects
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let stores = body != BorrowStatus.Checked
  let hasBase = match &nodes[result.index].kind { NodeKind.Expression {form: Expression.StagedCallable {..}, ..} => true _ => false }
  let closed = match &nodes[result.index].kind {
    NodeKind.Expression {form: Expression.StagedCallable {retention, ..}, ..} => retention.closed
    NodeKind.Expression {form: Expression.Aggregate {section: Option<SectionRetention>.Some {value}, ..}, ..} => value.closed
    _ => false
  }
  let mut sinks = List<OperandSink>.make()
  if staged && closed { sinks = run operandSinks(nodes, result, values, owner) }
  let entries = List<OperandSink>.asSlice(&sinks)
  let snapshot = run sourceBarrier(observation, &mut state.*, active, &mut rules.*)
  let classified = run sourceRetainedSinks(observation, List<SourceQuality>.asSlice(&snapshot), loans, paths,
    owner, entries, usize.MAX, usize.MAX, active, &mut rules.*)
  let decisions = List<SourcePolicy.RetentionOutput>.asSlice(&classified.decisions)
  let mut stored = List<Shared<Lifetime>>.make()
  let mut opaque = false
  if let Option<Shared<Type>>.Some {value} = move expressionType(nodes, result) {
    run Type.callableStoredRegions(&value, &mut stored)
    opaque = run Type.contractNamesTypeParameter(&value)
  }
  let mut at = usize.ZERO
  while at < values.length {
    run storedRegionsOf(nodes, values[at], &mut stored)
    if let Option<Shared<Type>>.Some {value} = move expressionType(nodes, values[at]) {
      if !(hasBase && at == usize.ZERO) && run Type.namesTypeParameter(&value) { opaque = true }
    }
    at = at + usize.ONE
  }
  let universal = universalRegions(&stored, owner)
  let empty = List<SourceAtom>.make()
  let none = List<SourceAtom>.asSlice(&empty)
  let no = SourceProgram.atom(&mut rules.*)
  let positions = List<SourceCarryPosition>.asSlice(&observation.positions)
  let mut effects = List<SourceCaptureEffect>.make()
  let mut classifiedCase = usize.ZERO
  at = usize.ZERO
  while at < positions.length {
    let position = &positions[at]
    let loan = &loans[position.loan]
    let cases = List<SourceCarryCase>.asSlice(&position.cases)
    let mut each = usize.ZERO
    while each < cases.length {
      let actual = &cases[each]
      let presentInputs: [SourceAtom; 2] = [active, actual.source.quality.present]
      let present = run SourcePolicy.conjunction(&mut rules.*, &presentInputs, none)
      let quality = SourceLoanState.quality(&state.*, position.loan, present)
      let mut escaping = List<SourceAtom>.make()
      let mut storing = List<SourceAtom>.make()
      // The original opaque pass precedes the universal/CaptureHold pass. Neither pass
      // changes precision, so both inspect this construction's barrier version.
      if opaque {
        if universalRegions(&loan.regions, owner) { run List<SourceAtom>.append(&mut escaping, present) }
        else if List<Shared<Lifetime>>.length(&loan.regions) == usize.ZERO && !loan.local {
          run List<SourceAtom>.append(&mut storing, present)
        }
      }
      let mut nonstoring = no
      if closed && !(hasBase && position.operand == usize.ZERO) && position.operand < entries.length
        && !entries[position.operand].undescribed && List<SlotSink>.length(&entries[position.operand].slots) != usize.ZERO {
        let held: [SourceAtom; 1] = [present]
        let nonlocal: [SourceAtom; 2] = [decisions[classifiedCase].universal, decisions[classifiedCase].unknown]
        nonstoring = run SourcePolicy.conjunction(&mut rules.*, &held, &nonlocal)
      }
      let mut hold = CaptureHold.Any
      if position.operand < holdable.length { hold = holdable[position.operand] }
      if universal {
        let mut admitted = present
        if !opaque {
          let held: [SourceAtom; 1] = [present]
          let excluded: [SourceAtom; 1] = [nonstoring]
          admitted = run SourcePolicy.conjunction(&mut rules.*, &held, &excluded)
        }
        if universalRegions(&loan.regions, owner) {
          if hold != CaptureHold.Never { run List<SourceAtom>.append(&mut escaping, admitted) }
        } else if hold == CaptureHold.Any {
          if stores || opaque || !typedLocally(&loan.regions, owner) {
            run List<SourceAtom>.append(&mut storing, admitted)
          } else {
            // OwnedStorageLoan accepts Exact and Stored only. The observation's A bit is
            // used here, never a final mutable precision sampled after unrelated cleanup.
            let places = List<SourceGeometryPlace>.asSlice(&geometry[position.loan].alternatives)
            let mut alternative = usize.ZERO
            while alternative < places.length {
              let mut bad = admitted
              if ownedPlace(loan, &places[alternative].place) { bad = quality.alternatives }
              let lost: [SourceAtom; 3] = [admitted, places[alternative].active, bad]
              run List<SourceAtom>.append(&mut storing, run SourcePolicy.conjunction(&mut rules.*, &lost, none))
              alternative = alternative + usize.ONE
            }
          }
        }
      }
      let mut storable = no
      if stores && hold != CaptureHold.Never { storable = present }
      run List<SourceCaptureEffect>.append(&mut effects, SourceCaptureEffect {
        source: sourceEffectSource(position, actual), point: point,
        escape: run SourcePolicy.disjunction(&mut rules.*, List<SourceAtom>.asSlice(&escaping)),
        storing: run SourcePolicy.disjunction(&mut rules.*, List<SourceAtom>.asSlice(&storing)), storable: storable})
      classifiedCase = classifiedCase + usize.ONE
      each = each + usize.ONE
    }
    at = at + usize.ONE
  }
  return SourceConstructionEffects {captures: move effects, inherited: body, active: active}
}

struct SourceConstructedEffects {
  policy: SourceConstructionEffects
  missing: SourceAtom
}

// Captures enter in the actual field/operand order. A referent capture adds its genuine
// acquisition after the existing descriptor's contents; it does not replace those contents
// or borrow the enclosing callable result. Physical placement was reserved once already.
effect fn sourceConstructVisit<'body>(builder: &mut SourceGraphBuilder<'body>, actual: &SourceVisit.Visit,
  acquired: &[SourceInputAcquisition], state: &mut SourceLoanState, loans: &[Loan], geometry: &[SourceLoanGeometry],
  paths: &mut List<List<Step>>) -> SourceConstructedEffects ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let nodes = SourceGraphBuilder.preparation(&builder.*).body.nodes
  let owner = SourceGraphBuilder.preparation(&builder.*).body.owner
  let shape = run shapeOf(nodes, actual.node)
  let mut observation = SourceObservation {positions: List<SourceCarryPosition>.make(), other: List<SourceGraph.Input>.make(),
    unknown: SourceProgram.atom(&mut builder.rules)}
  match move shape {
    Shape.Construct {values, staged, holdable, body, ..} => {
      let values = List<NodeId>.asSlice(&values)
      let inputs = List<SourceVisit.Input>.asSlice(&actual.inputs)
      if values.length != inputs.length { return CompilerBug.panic(b"construction lost an actual physical capture input") }
      let mut at = usize.ZERO
      while at < inputs.length {
        let input = inputs[at]
        if input.node.index != values[at].index { return CompilerBug.panic(b"construction reordered its actual capture inputs") }
        let root = sourceNodeValueRoot(SourceGraphBuilder.preparation(&builder.*), input.node)
        let operands: [SourceOperand; 1] = [SourceOperand {node: input.node, evaluation: input.evaluation, root: root, ordinal: at}]
        let incoming = run sourceObserve(&mut builder.*, &operands, SourceGraphValuePhase.Output, &mut paths.*, loans.length, false, Option<usize>.none())
        run sourceAppendObservation(&mut observation, move incoming, &mut builder.rules)
        let mut each = usize.ZERO
        while each < acquired.length {
          let capture = acquired[each]
          if capture.result.index == actual.evaluation.index && capture.input.index == input.evaluation.index {
            let evaluation = SourceGraphBuilder.evaluation(&builder.*, capture.acquisition)
            if evaluation.point.index != input.usePoint.index || capture.loan >= loans.length {
              return CompilerBug.panic(b"capture acquisition moved past a later input")
            }
            let mut target = root
            match capture.kind {
              SourceInputAcquisitionKind.Reference => {
                target = List<PreparedSources.SelectionMap>.asSlice(&SourceGraphBuilder.preparation(&builder.*).maps)[capture.map.index].target
              }
              SourceInputAcquisitionKind.CaptureReborrow {descriptor} => {
                let value = SourceGraphBuilder.value(&builder.*, descriptor)
                if value.evaluation.index != capture.acquisition.index || value.phase != SourceGraphValuePhase.Output {
                  return CompilerBug.panic(b"capture reborrow changed its acquisition descriptor")
                }
                target = value.endpoint
              }
            }
            let descriptors: [SourceOperand; 1] = [SourceOperand {node: input.node, evaluation: capture.acquisition, root: target, ordinal: at}]
            let descriptor = run sourceObserve(&mut builder.*, &descriptors, SourceGraphValuePhase.Output, &mut paths.*, loans.length, false, Option<usize>.none())
            let positions = List<SourceCarryPosition>.asSlice(&descriptor.positions)
            let mut position = usize.ZERO
            while position < positions.length {
              if positions[position].loan != capture.loan { return CompilerBug.panic(b"capture descriptor substituted another acquisition") }
              position = position + usize.ONE
            }
            run sourceAppendObservation(&mut observation, move descriptor, &mut builder.rules)
          }
          each = each + usize.ONE
        }
        at = at + usize.ONE
      }
      let active = List<SourceControl.Point>.asSlice(&builder.reaching.points)[actual.execute.index].reachable
      let policy = run sourceConstruct(nodes, owner, loans, geometry, List<List<Step>>.asSlice(&paths.*), &observation,
        &mut state.*, values, staged, List<CaptureHold>.asSlice(&holdable), body, actual.node, actual.execute.index, active, &mut builder.rules)
      let empty = List<SourceAtom>.make()
      let incomplete: [SourceAtom; 2] = [active, observation.unknown]
      return SourceConstructedEffects {policy: move policy,
        missing: run SourcePolicy.conjunction(&mut builder.rules, &incomplete, List<SourceAtom>.asSlice(&empty))}
    }
    _ => { return CompilerBug.panic(b"capture dispatch selected another ownership handler") }
  }
}

struct SourceBlockCapture {
  loan: usize
  binding: usize
  dispatch: usize
}
impl Copy for SourceBlockCapture {}
struct SourceBlockUntil {
  loan: usize
  local: usize
  dispatch: usize
  point: SourceControl.PointId
  active: SourceAtom
}
impl Copy for SourceBlockUntil {}

// Only acquisitions made by this actual initializer are an Effect block's own captures.
// Existing captured values are excluded: neither region equality nor Loan allocation order
// establishes this relation. Use slots remain inactive until this semantic rule admits them.
effect fn sourceBlockLifetimes<'body>(builder: &mut SourceGraphBuilder<'body>, blocks: &[SourceBlockBinding],
  trace: &[SourceVisitDispatch], visits: &[SourceVisit.Visit], owners: &[SourceVisit.Owner],
  exits: &[SourceVisit.OwnerExit], holders: &SourceHolderProjection, encounters: &[usize], loans: &[Loan])
  -> List<SourceBlockUntil> ! OutOfMemoryError ? &mut Allocator {
  if encounters.length != loans.length { return CompilerBug.panic(b"block capture inventory lost actual acquisitions") }
  let mut captured = List<SourceBlockCapture>.make()
  let mut at = usize.ZERO
  while at < blocks.length {
    let entered = sourceEncounter(trace, blocks[at].initializer, SourceEncounter.Enter, visits)
    let completed = sourceEncounter(trace, blocks[at].initializer, SourceEncounter.Finish, visits)
    let bound = sourceEncounter(trace, blocks[at].evaluation, SourceEncounter.Finish, visits)
    if entered > completed || completed >= bound { return CompilerBug.panic(b"block initializer left its actual binding encounter") }
    let mut loan = usize.ZERO
    while loan < encounters.length {
      if entered <= encounters[loan] && encounters[loan] <= completed {
        run List<SourceBlockCapture>.append(&mut captured, SourceBlockCapture {loan: loan, binding: at, dispatch: bound})
      }
      loan = loan + usize.ONE
    }
    at = at + usize.ONE
  }
  let captures = List<SourceBlockCapture>.asSlice(&captured)
  let requests = List<SourceHolderRequest>.asSlice(&holders.requests)
  let uses = List<SourceHolderUse>.asSlice(&holders.uses)
  let mut result = List<SourceBlockUntil>.make()
  at = usize.ZERO
  while at < trace.length {
    if let SourceVisitDispatch.OwnerExit {exit} = trace[at] {
      if exit >= exits.length { return CompilerBug.panic(b"block scope use lost its actual owner action") }
      let ending = &exits[exit]
      if ending.action == SourceVisitOwnerAction.Use {
        if ending.owner.index >= owners.length { return CompilerBug.panic(b"block use names a foreign owner") }
        let owner = &owners[ending.owner.index]
        let mut each = usize.ZERO
        while each < captures.length {
          let capture = captures[each]
          let binding = blocks[capture.binding]
          let same = match owner.root { SourceVisitOwnerRoot.Local {local} => local.index == binding.local _ => false }
          if same && owner.initialized.index == binding.point.index && capture.dispatch < at {
            let mut used = List<SourceAtom>.make()
            let mut use = usize.ZERO
            while use < uses.length {
              let request = requests[uses[use].request]
              if capture.dispatch < request.dispatch && request.dispatch < at
                && sourceOwnerStorage(&builder.*, owner, uses[use].storage) {
                run List<SourceAtom>.append(&mut used, uses[use].active)
              }
              use = use + usize.ONE
            }
            // A later enclosing initializer can own the same genuine acquisition. Its
            // actual binding supersedes the earlier block association, as in the handler.
            let mut later = usize.ZERO
            while later < captures.length {
              if captures[later].loan == capture.loan && capture.dispatch < captures[later].dispatch
                && captures[later].dispatch < at {
                let rebound = blocks[captures[later].binding]
                run List<SourceAtom>.append(&mut used,
                  List<SourceControl.Point>.asSlice(&builder.reaching.points)[rebound.point.index].reachable)
              }
              later = later + usize.ONE
            }
            // Incomplete address-use attribution cannot certify that the block is unused.
            run List<SourceAtom>.append(&mut used, holders.missing)
            let points = List<SourceControl.Point>.asSlice(&builder.reaching.points)
            let active: [SourceAtom; 3] = [points[binding.point.index].reachable,
              points[loans[capture.loan].created].reachable, points[ending.point.index].reachable]
            run List<SourceBlockUntil>.append(&mut result, SourceBlockUntil {loan: capture.loan, local: binding.local,
              dispatch: at, point: ending.point,
              active: run SourcePolicy.conjunction(&mut builder.rules, &active, List<SourceAtom>.asSlice(&used))})
          }
          each = each + usize.ONE
        }
      }
    }
    at = at + usize.ONE
  }
  return move result
}

// Keep the accepted per-loan `until` semantics. Rows are in actual dispatch order, so
// later genuine unrun scope releases replace earlier ones without sorting PointIds.
// An uncertain activation cannot create a definite liveness conflict or certify a proof.
fn sourceSettleBlocks<'body>(graph: &SourceGraphGraph<'body>, blocks: &[SourceBlockUntil], settled: &mut SourceSettledLoans) -> () {
  let loans = List<Loan>.asMutSlice(&mut settled.loans)
  let mut at = usize.ZERO
  while at < blocks.length {
    let block = blocks[at]
    if block.loan >= loans.length { return CompilerBug.panic(b"block lifetime names an undeclared acquisition") }
    let active = SourceGraphGraph.truth(graph, block.active)
    if active == SourceTruth.True {
      loans[block.loan].block = block.local
      loans[block.loan].until = block.point.index
    }
    if active == SourceTruth.Undefined { settled.unresolved = true }
    at = at + usize.ONE
  }
  return ()
}

struct SourceBlockBinding {
  evaluation: SourceGraph.EvalId
  local: usize
  initializer: SourceGraph.EvalId
  point: SourceControl.PointId
}
impl Copy for SourceBlockBinding {}

struct SourceCallableBinding {
  local: usize
  evaluation: SourceGraph.EvalId
  initializer: SourceGraph.EvalId
  point: SourceControl.PointId
}
impl Copy for SourceCallableBinding {}

struct SourceBindingEffects {
  retained: bool
  block: Option<SourceBlockBinding>
  callable: Option<SourceCallableBinding>
  intervals: List<SourceIntervalEffect>
  crossings: List<SourceCrossingEffect>
  written: List<SourceEscapeEffect>
  missing: SourceAtom
}

// The actual binding consumes its initializer and introduces no result policy. The graph's
// real definition owns its new contents. Written universal types contribute independent
// escape effects; mutable retained noncallables preserve the original crossing predicate.
effect fn sourceBinding<'body>(builder: &mut SourceGraphBuilder<'body>, actual: &SourceVisit.Visit,
  state: &mut SourceLoanState, loans: &[Loan], paths: &mut List<List<Step>>) -> SourceBindingEffects
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let nodes = SourceGraphBuilder.preparation(&builder.*).body.nodes
  let locals = SourceGraphBuilder.preparation(&builder.*).body.locals
  let owner = SourceGraphBuilder.preparation(&builder.*).body.owner
  match move run shapeOf(nodes, actual.node) {
    Shape.Binding {local, initializer, mutable} => {
      let input = sourceAccessInput(actual, usize.ZERO, initializer)
      if List<SourceVisit.Input>.length(&actual.inputs) != usize.ONE || local >= locals.length {
        return CompilerBug.panic(b"binding changed its actual initializer or declared local")
      }
      let root = sourceNodeValueRoot(SourceGraphBuilder.preparation(&builder.*), initializer)
      let operands: [SourceOperand; 1] = [SourceOperand {node: initializer, evaluation: input.evaluation, root: root, ordinal: usize.ZERO}]
      let observation = run sourceObserve(&mut builder.*, &operands, SourceGraphValuePhase.Output, &mut paths.*, loans.length, false, Option<usize>.none())
      let active = List<SourceControl.Point>.asSlice(&builder.reaching.points)[actual.execute.index].reachable
      drop run sourceBarrier(&observation, &mut state.*, active, &mut builder.rules)
      let empty = List<SourceAtom>.make()
      let incomplete: [SourceAtom; 2] = [active, observation.unknown]
      let declared = localType(locals, local)
      let mut block = Option<SourceBlockBinding>.none()
      if isCallable(nodes, initializer) && Shared<Type>.with<bool>(&declared, effectBlock) {
        block = Option<SourceBlockBinding>.some(SourceBlockBinding {evaluation: actual.evaluation, local: local, initializer: input.evaluation, point: actual.execute})
      }
      let callable = Shared<Type>.with<bool>(&declared, callableValue)
      let mut binding = Option<SourceCallableBinding>.none()
      if callable { binding = Option<SourceCallableBinding>.some(SourceCallableBinding {
        local: local, evaluation: actual.evaluation, initializer: input.evaluation, point: actual.execute}) }
      let mut effects = SourceBindingEffects {retained: callable || run retains(&declared, owner), block: block, callable: binding,
        intervals: List<SourceIntervalEffect>.make(), crossings: List<SourceCrossingEffect>.make(),
        written: List<SourceEscapeEffect>.make(), missing: run SourcePolicy.conjunction(&mut builder.rules, &incomplete, List<SourceAtom>.asSlice(&empty))}
      run sourceConsume(&observation, actual.execute.index, active, &mut builder.rules, &mut effects.intervals)
      let escape = locals[local].written && run universallyTyped(&declared, owner)
      let crossing = mutable && !callable && run retains(&declared, owner)
      let positions = List<SourceCarryPosition>.asSlice(&observation.positions)
      let mut at = usize.ZERO
      while at < positions.length {
        let histories = List<SourceCarryCase>.asSlice(&positions[at].cases)
        let mut each = usize.ZERO
        while each < histories.length {
          let source = sourceEffectSource(&positions[at], &histories[each])
          let guards: [SourceAtom; 2] = [active, histories[each].source.quality.present]
          let present = run SourcePolicy.conjunction(&mut builder.rules, &guards, List<SourceAtom>.asSlice(&empty))
          if escape { run List<SourceEscapeEffect>.append(&mut effects.written, SourceEscapeEffect {source: source, active: present}) }
          if crossing && !loans[positions[at].loan].local {
            run List<SourceCrossingEffect>.append(&mut effects.crossings, SourceCrossingEffect {source: source, active: present})
          }
          each = each + usize.ONE
        }
        at = at + usize.ONE
      }
      return move effects
    }
    _ => { return CompilerBug.panic(b"binding dispatch selected another ownership handler") }
  }
}

fn sourceReplacementCleanup<'body>(builder: &SourceGraphBuilder<'body>, actual: &SourceVisit.Visit,
  local: usize, exits: &[SourceVisit.OwnerExit], observations: &[SourceOwnerObservation]) -> bool {
  let index = match actual.prewrite { Option<usize>.Some {value} => value _ => { return false } }
  if index >= exits.length { return CompilerBug.panic(b"replacement cleanup lost its retained exit ordinal") }
  let exit = &exits[index]
  let read = match exit.read { Option<SourceGraph.EvalId>.Some {value} => value
    _ => { return CompilerBug.panic(b"replacement cleanup has no current read") } }
  if exit.action != SourceVisitOwnerAction.Cleanup || exit.cause.index != actual.node.index {
    return CompilerBug.panic(b"replacement cleanup changed its actual lifecycle action")
  }
  let evaluated = SourceGraphBuilder.evaluation(builder, read)
  if evaluated.category != SourceGraphEvaluationRole.Cleanup || evaluated.point.index != exit.point.index {
    return CompilerBug.panic(b"replacement cleanup left its retained read point")
  }
  let endpoints = List<PreparedSources.Endpoint>.asSlice(&SourceGraphBuilder.preparation(builder).endpoints)
  let mut found = false
  let mut at = usize.ZERO
  while at < observations.length {
    let observed = observations[at]
    if observed.evaluation.index == read.index {
      if found || observed.owner.index != exit.owner.index || observed.point.index != exit.point.index
        || observed.action != SourceVisitOwnerAction.Cleanup {
        return CompilerBug.panic(b"replacement cleanup changed its exact owner observation")
      }
      let canonical = match sourceStorageRoot(endpoints, observed.storage) {
        Option<SourceGraph.Storage>.Some {value} => value
        _ => { return CompilerBug.panic(b"replacement cleanup has no canonical local root") }
      }
      let same = match &endpoints[canonical.endpoint.index].root {
        PreparedSourcesRoot.Local {local: owner, category: endpointCategory} if endpointCategory == PreparedSourcesEndpointRole.Storage => owner.index == local
        _ => false
      }
      if !same || !sourceSameStorage(canonical, observed.storage) {
        return CompilerBug.panic(b"replacement cleanup observed another canonical owner")
      }
      found = true
    }
    at = at + usize.ONE
  }
  if !found { return CompilerBug.panic(b"reserved replacement cleanup was not activated") }
  return true
}

// A whole assignment consumes the actual RHS at the replacement point. Its physical
// definition is already in Flow; policy neither recreates it nor reads the killed contents
// as a source. Old-value cleanup uses its explicit prewrite observation; original callable
// bindings retain their separate lifetime relation through actual later owner demands.
effect fn sourceDispatchReplacement<'body>(builder: &mut SourceGraphBuilder<'body>, actual: &SourceVisit.Visit,
  input: SourceVisit.Input, local: usize, dispatch: usize,
  exits: &[SourceVisit.OwnerExit], observations: &[SourceOwnerObservation],
  state: &mut SourceDispatchProjection, loans: &[Loan], paths: &mut List<List<Step>>) -> ()
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let prepared = SourceGraphBuilder.preparation(&builder.*)
  if local >= prepared.body.locals.length { return CompilerBug.panic(b"whole replacement has no actual local owner") }
  let declared = localType(prepared.body.locals, local)
  let callable = Shared<Type>.with<bool>(&declared, callableValue)
  let retained = !callable && run retains(&declared, prepared.body.owner)
  let root = sourceNodeValueRoot(prepared, input.node)
  let operands: [SourceOperand; 1] = [SourceOperand {node: input.node, evaluation: input.evaluation, root: root, ordinal: usize.ZERO}]
  let observation = run sourceObserve(&mut builder.*, &operands, SourceGraphValuePhase.Output, &mut paths.*, loans.length, false, Option<usize>.none())
  let active = List<SourceControl.Point>.asSlice(&builder.reaching.points)[actual.execute.index].reachable
  let observed = List<SourceControl.Point>.asSlice(&builder.reaching.points)[input.usePoint.index].reachable
  drop run sourceBarrier(&observation, &mut state.policy.state, observed, &mut builder.rules)
  let empty = List<SourceAtom>.make()
  let none = List<SourceAtom>.asSlice(&empty)
  let incomplete: [SourceAtom; 2] = [observed, observation.unknown]
  run sourceDispatchMissing(&mut state.*, run SourcePolicy.conjunction(&mut builder.rules, &incomplete, none), &mut builder.rules)
  let mut rejected = List<SourceAtom>.make()
  let positions = List<SourceCarryPosition>.asSlice(&observation.positions)
  if callable {
    let mut at = usize.ZERO
    while at < positions.length {
      let present: [SourceAtom; 2] = [observed, positions[at].quality.present]
      run List<SourceAtom>.append(&mut rejected, run SourcePolicy.conjunction(&mut builder.rules, &present, none))
      at = at + usize.ONE
    }
  }
  let refusal = run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&rejected))
  run List<SourcePolicyRefusal>.append(&mut state.refusals, SourcePolicyRefusal {
    dispatch: dispatch, point: input.usePoint, reason: BorrowStatus.StoredLoans, active: refusal})
  let positive: [SourceAtom; 1] = [active]
  let negative: [SourceAtom; 1] = [refusal]
  let accepted = run SourcePolicy.conjunction(&mut builder.rules, &positive, &negative)
  run List<SourceOrdinaryUse>.append(&mut state.ordinary, SourceOrdinaryUse {
    writer: actual.evaluation, active: accepted, retained: retained})
  if retained {
    let crossing = run sourceRejoin(&observation, loans, actual.execute.index, accepted, &mut builder.rules)
    run sourceAppendEffects<SourceIntervalEffect>(&mut state.policy.intervals, move crossing.intervals)
    run sourceAppendEffects<SourceCrossingEffect>(&mut state.policy.crossings, move crossing.crossings)
  } else {
    run sourceConsume(&observation, actual.execute.index, accepted, &mut builder.rules, &mut state.policy.intervals)
  }
  // Traversal reserves this exact owner exit for every whole local write, including
  // zero-path Place/Exclusive pattern bindings of named storage. Copy/move/rvalue
  // subjects have independent roots and cannot enter this local replacement handler.
  if !sourceReplacementCleanup(&builder.*, actual, local, exits, observations) {
    return CompilerBug.panic(b"whole local replacement omitted its actual prewrite cleanup")
  }
  return ()
}

// A selected assignment's RHS is observed after evaluation, before its write. The original
// through-place refusals and field-store precision losses belong to this observation, not
// to the presence of a destination source port. Nonretaining direct writes need no rehold.
effect fn sourceObserveField<'body>(builder: &mut SourceGraphBuilder<'body>, selected: usize,
  paths: &mut List<List<Step>>, loans: usize) -> SourceThroughObservation ! OutOfMemoryError ? &mut Allocator {
  let original = SourceGraphBuilder.fieldReholdObservations(&builder.*)[selected]
  let request = SourceGraphBuilder.fieldReholdRequests(&builder.*)[original.request]
  let evaluation = SourceGraphBuilder.evaluation(&builder.*, request.execution)
  let node = match evaluation.site { SourceGraphEvaluationSite.Node {node} => node
    _ => { return CompilerBug.panic(b"field rehold holder has no actual action expression") } }
  let empty = List<SourceAtom>.make()
  let none = List<SourceAtom>.asSlice(&empty)
  let mut active = List<SourceAtom>.make()
  let mut gaps = List<SourceAtom>.make()
  run List<SourceAtom>.append(&mut gaps, SourceGraphBuilder.fieldReholdCoverage(&builder.*)[original.request].missing)
  let mut reads = List<SourceGraph.FieldReholdRead>.make()
  let mut at = usize.ZERO
  while at < SourceGraphBuilder.fieldReholdObservations(&builder.*).length {
    let row = SourceGraphBuilder.fieldReholdObservations(&builder.*)[at]
    if row.request == original.request && sourceSameStorage(row.owner, original.owner) {
      run List<SourceAtom>.append(&mut active, row.active)
      let recorded = SourceGraphBuilder.fieldReholdReads(&builder.*)
      let mut each = usize.ZERO
      while each < recorded.length {
        if recorded[each].observation == at {
          let previous = List<SourceGraph.FieldReholdRead>.asSlice(&reads)
          let mut seen = usize.ZERO
          while seen < previous.length && previous[seen].read.index != recorded[each].read.index { seen = seen + usize.ONE }
          if seen == previous.length { run List<SourceGraph.FieldReholdRead>.append(&mut reads, recorded[each]) }
        }
        each = each + usize.ONE
      }
    }
    at = at + usize.ONE
  }
  let used = run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&active))
  let unknown = SourceProgram.atom(&mut builder.rules)
  let mut observed = SourceObservation {positions: List<SourceCarryPosition>.make(), other: List<SourceGraph.Input>.make(), unknown: unknown}
  let mut roots = usize.ZERO
  at = usize.ZERO
  while at < List<SourceGraph.FieldReholdRead>.length(&reads) {
    let actual = List<SourceGraph.FieldReholdRead>.asSlice(&reads)[at]
    let read = SourceGraphBuilder.read(&builder.*, actual.read)
    let value = SourceGraphBuilder.value(&builder.*, actual.value)
    if value.phase != SourceGraphValuePhase.Input || !sourcePhysicalValue(value)
      || value.evaluation.index != request.execution.index || read.point.index != evaluation.point.index
      || read.value.index != actual.value.index || !sourceSameStorage(read.storage, actual.storage) {
      return CompilerBug.panic(b"field rehold holder substituted final referent contents or another action")
    }
    let whole = sourceSameStorage(actual.storage, original.owner)
    if whole { roots = roots + usize.ONE }
    let operand = SourceOperand {node: node, evaluation: request.execution, root: original.owner.endpoint, ordinal: usize.MAX}
    let mut present = List<SourceAtom>.make()
    run sourceObserveValue(&mut builder.*, &mut observed, operand, actual.value, &mut paths.*, loans,
      &mut present, whole, Option<SourceControl.ReadId>.some(actual.read))
    let required: [SourceAtom; 1] = [used]
    run SourceProgram.rule(&mut builder.rules, unknown, &required, List<SourceAtom>.asSlice(&present))
    at = at + usize.ONE
  }
  if roots != usize.ONE { let required: [SourceAtom; 1] = [used]
    run SourceProgram.rule(&mut builder.rules, unknown, &required, none) }
  // The old flight carries A unchanged. Summary inputs initially
  // use MAX until their original semantic placement is explicitly authenticated here.
  let positions = List<SourceCarryPosition>.asMutSlice(&mut observed.positions)
  at = usize.ZERO
  while at < positions.length {
    let histories = List<SourceCarryCase>.asMutSlice(&mut positions[at].cases)
    let mut each = usize.ZERO
    while each < histories.length {
      if let Option<SourceControl.DefinitionId>.Some {value: definition} = histories[each].source.definition {
        let written = SourceGraphBuilder.definition(&builder.*, definition)
        if let Option<usize>.Some {value: summary} = written.summary {
          let field = run sourceOwnershipField(&builder.*, original.owner.endpoint,
            SourceGraphBuilder.summaries(&builder.*)[summary].placement, &mut paths.*)
          if field.supported { histories[each].field = field.field }
          else { run List<SourceAtom>.append(&mut gaps, histories[each].source.quality.present) }
        }
      }
      each = each + usize.ONE
    }
    at = at + usize.ONE
  }
  run List<SourceAtom>.append(&mut gaps, unknown)
  observed.unknown = run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&gaps))
  return SourceThroughObservation {observation: move observed, active: used}
}

// Activate the actual selected retaining write before inspecting its candidate family.
// Every canonical owner is observed once even if several aliases select its written B.
effect fn sourceFieldAction<'body>(builder: &mut SourceGraphBuilder<'body>, actual: &SourceVisit.Visit,
  input: SourceVisit.Input, active: SourceAtom, state: &mut SourceDispatchProjection,
  loans: &[Loan], paths: &mut List<List<Step>>) -> () ! OutOfMemoryError ? &mut Allocator {
  let empty = List<SourceAtom>.make()
  let none = List<SourceAtom>.asSlice(&empty)
  let inputs = List<SourceVisit.Input>.asSlice(&actual.inputs)
  let mut found = false
  let mut at = usize.ZERO
  while at < SourceGraphBuilder.fieldReholdRequests(&builder.*).length {
    let request = SourceGraphBuilder.fieldReholdRequests(&builder.*)[at]
    if request.result.index == actual.evaluation.index {
      if found || inputs.length == usize.ZERO || request.source.index != input.evaluation.index
        || request.address.index != inputs[0].evaluation.index
        || SourceGraphBuilder.evaluation(&builder.*, request.execution).point.index != actual.execute.index {
        return CompilerBug.panic(b"field rehold changed its original RHS, place or execution")
      }
      found = true
      let accepted: [SourceAtom; 2] = [active, request.active]
      run SourceProgram.rule(&mut builder.rules, request.accepted, &accepted, none)
      let mut row = usize.ZERO
      while row < SourceGraphBuilder.fieldReholdObservations(&builder.*).length {
        let observation = SourceGraphBuilder.fieldReholdObservations(&builder.*)[row]
        if observation.request != at { row = row + usize.ONE continue }
        let mut prior = usize.ZERO
        while prior < row {
          let previous = SourceGraphBuilder.fieldReholdObservations(&builder.*)[prior]
          if previous.request == at && sourceSameStorage(previous.owner, observation.owner) { break }
          prior = prior + usize.ONE
        }
        if prior == row {
          let observed = run sourceObserveField(&mut builder.*, row, &mut paths.*, loans.length)
          let gates: [SourceAtom; 2] = [request.accepted, observed.active]
          let used = run SourcePolicy.conjunction(&mut builder.rules, &gates, none)
          let no = SourceProgram.atom(&mut builder.rules)
          let mut effects = SourceStoreEffects {intervals: List<SourceIntervalEffect>.make(), refusal: no, missing: no}
          let target = match SourceGraphBuilder.evaluation(&builder.*, request.address).site {
            SourceGraphEvaluationSite.Node {node} => node
            _ => { return CompilerBug.panic(b"field holder use has no actual written place") }
          }
          let span = writtenSpan(SourceGraphBuilder.preparation(&builder.*).body.nodes, target)
          run sourceRecordReadAlternatives(&mut builder.*, &observed.observation, SourceSemanticReadOrigin.Field {observation: row},
            request.execution, span, used,
            &mut paths.*, &mut state.holders)
          run sourceUseObservedHolder(&mut builder.*, &observed.observation, observation.owner, request.execution,
            Option<SourceVisit.OwnerId>.none(), used, &mut state.policy.state, &mut state.holders, &mut effects)
          run sourceDispatchMissing(&mut state.*, effects.missing, &mut builder.rules)
          run sourceAppendEffects<SourceIntervalEffect>(&mut state.policy.intervals, move effects.intervals)
        }
        row = row + usize.ONE
      }
    }
    at = at + usize.ONE
  }
  if !found { run sourceDispatchMissing(&mut state.*, active, &mut builder.rules) }
  return ()
}

effect fn sourcePlaceWrite<'body>(builder: &mut SourceGraphBuilder<'body>, actual: &SourceVisit.Visit,
  target: NodeId, input: SourceVisit.Input, path: &Path, dispatch: usize,
  state: &mut SourceDispatchProjection, loans: &[Loan], paths: &mut List<List<Step>>) -> ()
! OutOfMemoryError ? &mut Allocator | &mut Types {
  // The original Enter refusal precedes evaluating a target with no supported place.
  if path.root == usize.MAX { return () }
  let prepared = SourceGraphBuilder.preparation(&builder.*)
  let retained = run nodeRetains(prepared.body.nodes, target, prepared.body.owner)
  let root = sourceNodeValueRoot(prepared, input.node)
  let operands: [SourceOperand; 1] = [SourceOperand {node: input.node, evaluation: input.evaluation, root: root, ordinal: usize.ZERO}]
  let observation = run sourceObserve(&mut builder.*, &operands, SourceGraphValuePhase.Output, &mut paths.*, loans.length, false, Option<usize>.none())
  let observed = List<SourceControl.Point>.asSlice(&builder.reaching.points)[input.usePoint.index].reachable
  drop run sourceBarrier(&observation, &mut state.policy.state, observed, &mut builder.rules)
  let empty = List<SourceAtom>.make()
  let none = List<SourceAtom>.asSlice(&empty)
  let incomplete: [SourceAtom; 2] = [observed, observation.unknown]
  run sourceDispatchMissing(&mut state.*, run SourcePolicy.conjunction(&mut builder.rules, &incomplete, none), &mut builder.rules)
  let positions = List<SourceCarryPosition>.asSlice(&observation.positions)
  let mut rejected = List<SourceAtom>.make()
  let mut at = usize.ZERO
  while at < positions.length {
    if path.through && (retained || loans[positions[at].loan].local) {
      let present: [SourceAtom; 2] = [observed, positions[at].quality.present]
      run List<SourceAtom>.append(&mut rejected, run SourcePolicy.conjunction(&mut builder.rules, &present, none))
    }
    at = at + usize.ONE
  }
  let refused = run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&rejected))
  run List<SourcePolicyRefusal>.append(&mut state.refusals, SourcePolicyRefusal {
    dispatch: dispatch, point: input.usePoint, reason: BorrowStatus.StoredLoans, active: refused})
  let executed: [SourceAtom; 1] = [List<SourceControl.Point>.asSlice(&builder.reaching.points)[actual.execute.index].reachable]
  let refusal: [SourceAtom; 1] = [refused]
  let accepted = run SourcePolicy.conjunction(&mut builder.rules, &executed, &refusal)
  if retained && !path.through {
    at = usize.ZERO
    while at < positions.length {
      let present: [SourceAtom; 2] = [accepted, positions[at].quality.present]
      let loss: [SourcePolicy.Precision; 1] = [SourcePolicy.Precision {
        stored: run SourcePolicy.conjunction(&mut builder.rules, &present, none),
        alternatives: SourceProgram.atom(&mut builder.rules)}]
      drop run SourceLoanState.finishPosition(&mut state.policy.state, &mut builder.rules, positions[at].loan, &loss)
      at = at + usize.ONE
    }
  }
  run sourceConsume(&observation, actual.execute.index, accepted, &mut builder.rules, &mut state.policy.intervals)
  run List<SourceOrdinaryUse>.append(&mut state.ordinary, SourceOrdinaryUse {
    writer: actual.evaluation, active: accepted, retained: retained && !path.through})
  if path.through {
    drop run sourceThroughAction(&mut builder.*, actual.evaluation, SourceGraphThroughFlightKind.Write,
      actual.execute, Option<SourceControl.PointId>.some(actual.execute), accepted, false, &mut state.*, loans, &mut paths.*)
  } else if retained {
    run sourceFieldAction(&mut builder.*, actual, input, accepted, &mut state.*, loans, &mut paths.*)
  }
  return ()
}

// Replacement keeps the RHS completion, displaced read and write/result as three distinct
// occurrences. A direct whole nonretaining target needs only its genuine current read;
// through reads use their descriptor holder; selected direct reads use the reserved whole flight.
effect fn sourceDisplace<'body>(builder: &mut SourceGraphBuilder<'body>, actual: &SourceVisit.Visit,
  target: NodeId, input: SourceVisit.Input, dispatch: usize, state: &mut SourceDispatchProjection,
  loans: &[Loan], paths: &mut List<List<Step>>) -> () ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let prepared = SourceGraphBuilder.preparation(&builder.*)
  let nodes = prepared.body.nodes
  let path = run pathOf(nodes, target)
  let retained = run nodeRetains(nodes, target, prepared.body.owner)
  if path.root == usize.MAX || (retained && !path.through) { return () }
  let rhsRoot = sourceNodeValueRoot(prepared, input.node)
  let rhs: [SourceOperand; 1] = [SourceOperand {node: input.node, evaluation: input.evaluation, root: rhsRoot, ordinal: usize.ZERO}]
  let incoming = run sourceObserve(&mut builder.*, &rhs, SourceGraphValuePhase.Output, &mut paths.*, loans.length, false, Option<usize>.none())
  let observed = List<SourceControl.Point>.asSlice(&builder.reaching.points)[input.usePoint.index].reachable
  drop run sourceBarrier(&incoming, &mut state.policy.state, observed, &mut builder.rules)
  let empty = List<SourceAtom>.make()
  let none = List<SourceAtom>.asSlice(&empty)
  let incomplete: [SourceAtom; 2] = [observed, incoming.unknown]
  run sourceDispatchMissing(&mut state.*, run SourcePolicy.conjunction(&mut builder.rules, &incomplete, none), &mut builder.rules)
  let mut rejected = List<SourceAtom>.make()
  if path.through && retained {
    let positions = List<SourceCarryPosition>.asSlice(&incoming.positions)
    let mut at = usize.ZERO
    while at < positions.length {
      let present: [SourceAtom; 2] = [observed, positions[at].quality.present]
      run List<SourceAtom>.append(&mut rejected, run SourcePolicy.conjunction(&mut builder.rules, &present, none))
      at = at + usize.ONE
    }
  }
  let refused = run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&rejected))
  run List<SourcePolicyRefusal>.append(&mut state.refusals, SourcePolicyRefusal {
    dispatch: dispatch, point: input.usePoint, reason: BorrowStatus.StoredLoans, active: refused})
  let read = match actual.displaced { Option<SourceGraph.EvalId>.Some {value} => value
    _ => { return CompilerBug.panic(b"displacement has no actual before-write read") } }
  let reading = SourceGraphBuilder.evaluation(&builder.*, read)
  let written = SourceGraphBuilder.evaluation(&builder.*, actual.evaluation)
  if reading.point.index != actual.execute.index || reading.category != SourceGraphEvaluationRole.Replacement
    || reading.point.index == written.point.index { return CompilerBug.panic(b"displacement collapsed its original read/write occurrences") }
  let refusal: [SourceAtom; 1] = [refused]
  let writeGate: [SourceAtom; 1] = [List<SourceControl.Point>.asSlice(&builder.reaching.points)[written.point.index].reachable]
  let acceptedWrite = run SourcePolicy.conjunction(&mut builder.rules, &writeGate, &refusal)
  run sourceConsume(&incoming, written.point.index, acceptedWrite, &mut builder.rules, &mut state.policy.intervals)
  run List<SourceOrdinaryUse>.append(&mut state.ordinary, SourceOrdinaryUse {
    writer: actual.evaluation, active: acceptedWrite, retained: false})
  if path.through {
    let readGate: [SourceAtom; 1] = [List<SourceControl.Point>.asSlice(&builder.reaching.points)[reading.point.index].reachable]
    let acceptedRead = run SourcePolicy.conjunction(&mut builder.rules, &readGate, &refusal)
    let mut consumeRead = Option<SourceControl.PointId>.none()
    if !retained { consumeRead = Option<SourceControl.PointId>.some(written.point) }
    drop run sourceThroughAction(&mut builder.*, actual.evaluation, SourceGraphThroughFlightKind.Read,
      reading.point, consumeRead, acceptedRead, false, &mut state.*, loans, &mut paths.*)
    drop run sourceThroughAction(&mut builder.*, actual.evaluation, SourceGraphThroughFlightKind.Write,
      written.point, Option<SourceControl.PointId>.some(written.point), acceptedWrite, false, &mut state.*, loans, &mut paths.*)
  } else {
    let readGate: [SourceAtom; 1] = [List<SourceControl.Point>.asSlice(&builder.reaching.points)[reading.point.index].reachable]
    let acceptedRead = run SourcePolicy.conjunction(&mut builder.rules, &readGate, &refusal)
    run sourceScalarFlight(&mut builder.*, read, reading.point, writtenSpan(nodes, target), acceptedRead, false, &mut state.*, loans, &mut paths.*)
  }
  return ()
}

struct SourceThroughObservation {
  observation: SourceObservation
  active: SourceAtom
}

// Direct scalar reads consume canonical owner contents rather than only the selected
// component. Canonical alternatives share actual read IDs and retain every coverage gap.
effect fn sourceObserveReadFlight<'body>(builder: &mut SourceGraphBuilder<'body>, selected: usize,
  paths: &mut List<List<Step>>, loans: usize) -> SourceThroughObservation ! OutOfMemoryError ? &mut Allocator {
  let original = SourceGraphBuilder.readFlightObservations(&builder.*)[selected]
  let evaluation = SourceGraphBuilder.evaluation(&builder.*, original.evaluation)
  let node = match evaluation.site { SourceGraphEvaluationSite.Node {node} => node
    _ => { return CompilerBug.panic(b"scalar read holder has no actual action expression") } }
  let empty = List<SourceAtom>.make()
  let none = List<SourceAtom>.asSlice(&empty)
  let mut active = List<SourceAtom>.make()
  let mut gaps = List<SourceAtom>.make()
  let mut reads = List<SourceGraph.ReadFlightRead>.make()
  let mut at = usize.ZERO
  while at < SourceGraphBuilder.readFlightObservations(&builder.*).length {
    let row = SourceGraphBuilder.readFlightObservations(&builder.*)[at]
    if row.evaluation.index == original.evaluation.index && sourceSameStorage(row.owner, original.owner) {
      run List<SourceAtom>.append(&mut active, row.active)
      let coverage = SourceGraphBuilder.readFlightCoverage(&builder.*)[at]
      if coverage.observation != at { return CompilerBug.panic(b"scalar read coverage changed its exact observation") }
      let required: [SourceAtom; 2] = [row.active, coverage.missing]
      run List<SourceAtom>.append(&mut gaps, run SourcePolicy.conjunction(&mut builder.rules, &required, none))
      let recorded = SourceGraphBuilder.readFlightReads(&builder.*)
      let mut each = usize.ZERO
      while each < recorded.length {
        if recorded[each].observation == at {
          let previous = List<SourceGraph.ReadFlightRead>.asSlice(&reads)
          let mut seen = usize.ZERO
          while seen < previous.length && previous[seen].read.index != recorded[each].read.index { seen = seen + usize.ONE }
          if seen == previous.length { run List<SourceGraph.ReadFlightRead>.append(&mut reads, recorded[each]) }
        }
        each = each + usize.ONE
      }
    }
    at = at + usize.ONE
  }
  let used = run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&active))
  let unknown = SourceProgram.atom(&mut builder.rules)
  let mut observed = SourceObservation {positions: List<SourceCarryPosition>.make(), other: List<SourceGraph.Input>.make(), unknown: unknown}
  let mut roots = usize.ZERO
  at = usize.ZERO
  while at < List<SourceGraph.ReadFlightRead>.length(&reads) {
    let actual = List<SourceGraph.ReadFlightRead>.asSlice(&reads)[at]
    let read = SourceGraphBuilder.read(&builder.*, actual.read)
    let value = SourceGraphBuilder.value(&builder.*, actual.value)
    if value.phase != SourceGraphValuePhase.Input || !sourcePhysicalValue(value)
      || value.evaluation.index != original.evaluation.index || read.point.index != evaluation.point.index
      || read.value.index != actual.value.index || !sourceSameStorage(read.storage, actual.storage) {
      return CompilerBug.panic(b"scalar read holder substituted final referent contents or another action")
    }
    let whole = sourceSameStorage(actual.storage, original.owner)
    if whole { roots = roots + usize.ONE }
    let operand = SourceOperand {node: node, evaluation: original.evaluation, root: original.owner.endpoint, ordinal: usize.MAX}
    let mut present = List<SourceAtom>.make()
    run sourceObserveValue(&mut builder.*, &mut observed, operand, actual.value, &mut paths.*, loans,
      &mut present, whole, Option<SourceControl.ReadId>.some(actual.read))
    let required: [SourceAtom; 1] = [used]
    run SourceProgram.rule(&mut builder.rules, unknown, &required, List<SourceAtom>.asSlice(&present))
    at = at + usize.ONE
  }
  if roots != usize.ONE { let required: [SourceAtom; 1] = [used]
    run SourceProgram.rule(&mut builder.rules, unknown, &required, none) }
  // This flight carries A, not A stripped by descriptor B. Summary inputs initially
  // use MAX until their original semantic placement is explicitly authenticated here.
  let positions = List<SourceCarryPosition>.asMutSlice(&mut observed.positions)
  at = usize.ZERO
  while at < positions.length {
    let histories = List<SourceCarryCase>.asMutSlice(&mut positions[at].cases)
    let mut each = usize.ZERO
    while each < histories.length {
      if let Option<SourceControl.DefinitionId>.Some {value: definition} = histories[each].source.definition {
        let written = SourceGraphBuilder.definition(&builder.*, definition)
        if let Option<usize>.Some {value: summary} = written.summary {
          let field = run sourceOwnershipField(&builder.*, original.owner.endpoint,
            SourceGraphBuilder.summaries(&builder.*)[summary].placement, &mut paths.*)
          if field.supported { histories[each].field = field.field }
          else { run List<SourceAtom>.append(&mut gaps, histories[each].source.quality.present) }
        }
      }
      each = each + usize.ONE
    }
    at = at + usize.ONE
  }
  run List<SourceAtom>.append(&mut gaps, unknown)
  observed.unknown = run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&gaps))
  return SourceThroughObservation {observation: move observed, active: used}
}

effect fn sourceObserveThrough<'body>(builder: &mut SourceGraphBuilder<'body>, selected: usize,
  paths: &mut List<List<Step>>, loans: usize) -> SourceThroughObservation ! OutOfMemoryError ? &mut Allocator {
  let original = SourceGraphBuilder.throughFlightObservations(&builder.*)[selected]
  let request = SourceGraphBuilder.throughFlightRequests(&builder.*)[original.request]
  let evaluation = SourceGraphBuilder.evaluation(&builder.*, request.evaluation)
  let node = match evaluation.site { SourceGraphEvaluationSite.Node {node} => node
    _ => { return CompilerBug.panic(b"through holder has no actual action expression") } }
  let empty = List<SourceAtom>.make()
  let none = List<SourceAtom>.asSlice(&empty)
  let mut active = List<SourceAtom>.make()
  let mut gaps = List<SourceAtom>.make()
  run List<SourceAtom>.append(&mut gaps, request.missing)
  let mut reads = List<SourceGraph.ThroughFlightRead>.make()
  let mut at = usize.ZERO
  while at < SourceGraphBuilder.throughFlightObservations(&builder.*).length {
    let row = SourceGraphBuilder.throughFlightObservations(&builder.*)[at]
    if row.request == original.request && sourceSameStorage(row.owner, original.owner) {
      run List<SourceAtom>.append(&mut active, row.active)
      let coverage = SourceGraphBuilder.throughFlightCoverage(&builder.*)[at]
      if coverage.observation != at { return CompilerBug.panic(b"through coverage changed its exact observation") }
      let required: [SourceAtom; 2] = [row.active, coverage.missing]
      run List<SourceAtom>.append(&mut gaps, run SourcePolicy.conjunction(&mut builder.rules, &required, none))
      let recorded = SourceGraphBuilder.throughFlightReads(&builder.*)
      let mut each = usize.ZERO
      while each < recorded.length {
        if recorded[each].observation == at {
          let previous = List<SourceGraph.ThroughFlightRead>.asSlice(&reads)
          let mut seen = usize.ZERO
          while seen < previous.length && previous[seen].read.index != recorded[each].read.index { seen = seen + usize.ONE }
          if seen == previous.length { run List<SourceGraph.ThroughFlightRead>.append(&mut reads, recorded[each]) }
        }
        each = each + usize.ONE
      }
    }
    at = at + usize.ONE
  }
  let used = run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&active))
  let unknown = SourceProgram.atom(&mut builder.rules)
  let mut observed = SourceObservation {positions: List<SourceCarryPosition>.make(), other: List<SourceGraph.Input>.make(), unknown: unknown}
  let mut roots = usize.ZERO
  at = usize.ZERO
  while at < List<SourceGraph.ThroughFlightRead>.length(&reads) {
    let actual = List<SourceGraph.ThroughFlightRead>.asSlice(&reads)[at]
    let read = SourceGraphBuilder.read(&builder.*, actual.read)
    let value = SourceGraphBuilder.value(&builder.*, actual.value)
    if value.phase != SourceGraphValuePhase.Input || !sourcePhysicalValue(value)
      || value.evaluation.index != request.evaluation.index || read.point.index != evaluation.point.index
      || read.value.index != actual.value.index || !sourceSameStorage(read.storage, actual.storage) {
      return CompilerBug.panic(b"through holder substituted final referent contents or another action")
    }
    let whole = sourceSameStorage(actual.storage, original.owner)
    if whole { roots = roots + usize.ONE }
    let operand = SourceOperand {node: node, evaluation: request.evaluation, root: original.owner.endpoint, ordinal: usize.MAX}
    let mut present = List<SourceAtom>.make()
    run sourceObserveValue(&mut builder.*, &mut observed, operand, actual.value, &mut paths.*, loans,
      &mut present, whole, Option<SourceControl.ReadId>.some(actual.read))
    let required: [SourceAtom; 1] = [used]
    run SourceProgram.rule(&mut builder.rules, unknown, &required, List<SourceAtom>.asSlice(&present))
    at = at + usize.ONE
  }
  if roots != usize.ONE { let required: [SourceAtom; 1] = [used]
    run SourceProgram.rule(&mut builder.rules, unknown, &required, none) }
  // This flight carries A, not A stripped by descriptor B. Summary inputs initially
  // use MAX until their original semantic placement is explicitly authenticated here.
  let positions = List<SourceCarryPosition>.asMutSlice(&mut observed.positions)
  at = usize.ZERO
  while at < positions.length {
    let histories = List<SourceCarryCase>.asMutSlice(&mut positions[at].cases)
    let mut each = usize.ZERO
    while each < histories.length {
      if let Option<SourceControl.DefinitionId>.Some {value: definition} = histories[each].source.definition {
        let written = SourceGraphBuilder.definition(&builder.*, definition)
        if let Option<usize>.Some {value: summary} = written.summary {
          let field = run sourceOwnershipField(&builder.*, original.owner.endpoint,
            SourceGraphBuilder.summaries(&builder.*)[summary].placement, &mut paths.*)
          if field.supported { histories[each].field = field.field }
          else { run List<SourceAtom>.append(&mut gaps, histories[each].source.quality.present) }
        }
      }
      each = each + usize.ONE
    }
    at = at + usize.ONE
  }
  run List<SourceAtom>.append(&mut gaps, unknown)
  observed.unknown = run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&gaps))
  return SourceThroughObservation {observation: move observed, active: used}
}

// A scalar through read produces its computed value only after the complete original
// descriptor-holder action. Its own output and unrelated earlier gaps are not evidence.
effect fn sourceCompleteScalarThroughRead<'body>(builder: &mut SourceGraphBuilder<'body>,
  result: NodeId, evaluation: SourceGraph.EvalId, root: PreparedSources.EndpointId,
  active: SourceAtom, missing: SourceAtom) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < SourceGraphBuilder.throughReadValues(&builder.*).length {
    let candidate = SourceGraphBuilder.throughReadValues(&builder.*)[at]
    let target = SourceGraphBuilder.value(&builder.*, candidate.target)
    if target.evaluation.index == evaluation.index {
      if true {
        let directive = &SourceGraphBuilder.resultUses(&builder.*)[candidate.result]
        let request = SourceGraphBuilder.throughFlightRequests(&builder.*)[candidate.request]
        let selection = &SourceGraphBuilder.selectionUses(&builder.*)[candidate.selection]
        let sameRead = match directive.kind {
          SourceGraphResultKind.Read {read} => read.index == evaluation.index
          _ => false
        }
        let descriptor = match request.descriptor { Option<SourceGraph.ThroughDescriptor>.Some {..} => true _ => false }
        let genuine = match &SourceGraphBuilder.leaf(&builder.*, candidate.leaf).kind {
          SourceGraphSourceLeaf.LoanFree {node} => node.index == result.index
          _ => false
        }
        let map = match selection.value {
          Option<PreparedSources.MapId>.Some {value} => value
          _ => { return CompilerBug.panic(b"scalar through read lost its actual result family") }
        }
        let prepared = SourceGraphBuilder.preparation(&builder.*)
        if !sameRead || !descriptor || !genuine || directive.evaluation.index != evaluation.index
          || !SourceAtom.same(directive.active, active) || request.kind != SourceGraphThroughFlightKind.Read
          || request.operation.index != evaluation.index || request.target.index != evaluation.index
          || request.evaluation.index != evaluation.index || selection.result.index != evaluation.index
          || List<PreparedSources.SelectionMap>.asSlice(&prepared.maps)[map.index].target.index != root.index
          || target.endpoint.index != root.index || target.phase != SourceGraphValuePhase.Output
          || !sourcePhysicalValue(target) {
          return CompilerBug.panic(b"scalar through read changed its original descriptor action")
        }
      }
      let complete: [SourceAtom; 2] = [active, candidate.applicable]
      let incomplete: [SourceAtom; 1] = [missing]
      run SourceProgram.rule(&mut builder.rules, candidate.accepted, &complete, &incomplete)
    }
    at = at + usize.ONE
  }
  return ()
}

effect fn sourceThroughAction<'body>(builder: &mut SourceGraphBuilder<'body>, operation: SourceGraph.EvalId,
  kind: SourceGraphThroughFlightKind, point: SourceControl.PointId, consume: Option<SourceControl.PointId>, active: SourceAtom,
  excludeShadowed: bool, state: &mut SourceDispatchProjection, loans: &[Loan], paths: &mut List<List<Step>>) -> SourceAtom
! OutOfMemoryError ? &mut Allocator {
  let empty = List<SourceAtom>.make()
  let none = List<SourceAtom>.asSlice(&empty)
  let mut missing = List<SourceAtom>.make()
  let mut found = false
  let mut at = usize.ZERO
  while at < SourceGraphBuilder.throughFlightRequests(&builder.*).length {
    let request = SourceGraphBuilder.throughFlightRequests(&builder.*)[at]
    if request.operation.index == operation.index && request.kind == kind {
      if found || SourceGraphBuilder.evaluation(&builder.*, request.evaluation).point.index != point.index {
        return CompilerBug.panic(b"through action changed its retained read/write occurrence")
      }
      found = true
      let gap: [SourceAtom; 2] = [active, request.missing]
      let incomplete = run SourcePolicy.conjunction(&mut builder.rules, &gap, none)
      run List<SourceAtom>.append(&mut missing, incomplete)
      run sourceDispatchMissing(&mut state.*, incomplete, &mut builder.rules)
      let mut row = usize.ZERO
      while row < SourceGraphBuilder.throughFlightObservations(&builder.*).length {
        let original = SourceGraphBuilder.throughFlightObservations(&builder.*)[row]
        if original.request != at { row = row + usize.ONE continue }
        let mut prior = usize.ZERO
        while prior < row {
          let earlier = SourceGraphBuilder.throughFlightObservations(&builder.*)[prior]
          if earlier.request == at && sourceSameStorage(earlier.owner, original.owner) { break }
          prior = prior + usize.ONE
        }
        if prior == row {
          let mut observed = run sourceObserveThrough(&mut builder.*, row, &mut paths.*, loans.length)
          let gates: [SourceAtom; 3] = [active, request.active, observed.active]
          let used = run SourcePolicy.conjunction(&mut builder.rules, &gates, none)
          let no = SourceProgram.atom(&mut builder.rules)
          let mut effects = SourceStoreEffects {intervals: List<SourceIntervalEffect>.make(), refusal: no, missing: no}
          let target = match SourceGraphBuilder.evaluation(&builder.*, request.target).site {
            SourceGraphEvaluationSite.Node {node} => node
            _ => { return CompilerBug.panic(b"through holder use has no actual target") }
          }
          let nodes = SourceGraphBuilder.preparation(&builder.*).body.nodes
          let mut span = writtenSpan(nodes, target)
          // An ordinary value read reports its full actual projection. Replacement
          // reads and writes retain their separate written-target diagnostic span.
          if kind == SourceGraphThroughFlightKind.Read && request.operation.index == request.target.index
            && request.evaluation.index == request.operation.index {
            span = nodes[target.index].origin.location
          }
          run sourceRecordReadAlternatives(&mut builder.*, &observed.observation, SourceSemanticReadOrigin.Through {observation: row},
            request.evaluation, span, used,
            &mut paths.*, &mut state.holders)
          run sourceUseObservedHolder(&mut builder.*, &observed.observation, original.owner, request.evaluation,
            Option<SourceVisit.OwnerId>.none(), used, &mut state.policy.state, &mut state.holders, &mut effects)
          if excludeShadowed { run sourceScalarRead(&mut builder.*, &mut observed.observation) }
          if let Option<SourceControl.PointId>.Some {value: completed} = consume {
            let reached: [SourceAtom; 2] = [used,
              List<SourceControl.Point>.asSlice(&builder.reaching.points)[completed.index].reachable]
            run sourceConsume(&observed.observation, completed.index,
              run SourcePolicy.conjunction(&mut builder.rules, &reached, none), &mut builder.rules, &mut effects.intervals)
          }
          run List<SourceAtom>.append(&mut missing, effects.missing)
          run sourceDispatchMissing(&mut state.*, effects.missing, &mut builder.rules)
          run sourceAppendEffects<SourceIntervalEffect>(&mut state.policy.intervals, move effects.intervals)
        }
        row = row + usize.ONE
      }
    }
    at = at + usize.ONE
  }
  if !found {
    run List<SourceAtom>.append(&mut missing, active)
    run sourceDispatchMissing(&mut state.*, active, &mut builder.rules)
  }
  return run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&missing))
}

// Cleanup's read is retained from its actual OwnerExit. The diagnostic cause node can be
// another expression entirely; it never chooses the cleanup type or canonical storage.
effect fn sourceCleanup<'body>(builder: &mut SourceGraphBuilder<'body>, actual: SourceOwnerObservation,
  state: &mut SourceLoanState, loans: &[Loan], paths: &mut List<List<Step>>, cleanup: &[LoanCleanup])
  -> SourceCleanupEffects ! OutOfMemoryError ? &mut Allocator {
  if actual.action != SourceVisitOwnerAction.Cleanup {
    return CompilerBug.panic(b"cleanup dispatch selected an owner use or end")
  }
  let evaluated = SourceGraphBuilder.evaluation(&builder.*, actual.evaluation)
  if evaluated.point.index != actual.point.index || evaluated.category != SourceGraphEvaluationRole.Cleanup {
    return CompilerBug.panic(b"cleanup dispatch left its actual owner exit")
  }
  let node = match evaluated.site { SourceGraphEvaluationSite.Node {node} => node
    _ => { return CompilerBug.panic(b"cleanup observation has no actual exit cause") } }
  let active = List<SourceControl.Point>.asSlice(&builder.reaching.points)[actual.point.index].reachable
  let operands: [SourceOperand; 1] = [SourceOperand {node: node, evaluation: actual.evaluation,
    root: actual.storage.endpoint, ordinal: usize.MAX}]
  let observation = run sourceObserve(&mut builder.*, &operands, SourceGraphValuePhase.Input, &mut paths.*, loans.length, true, Option<usize>.none())
  let mut effects = run sourceObserveCleanup(&mut builder.*, &observation, &mut state.*, loans, cleanup,
    actual.descriptor, actual.storage, actual.hidden, actual.point.index, active)
  // A nonobserving destructor has no source demand. An observing cleanup cannot certify
  // missing contents merely because no Borrow happened to be enumerated in the Input.
  if actual.descriptor < cleanup.length {
    let descriptor = &cleanup[actual.descriptor]
    if descriptor.unknown || List<Shared<Lifetime>>.length(&descriptor.regions) != usize.ZERO {
      let empty = List<SourceAtom>.make()
      let gates: [SourceAtom; 2] = [active, observation.unknown]
      let missing: [SourceAtom; 2] = [effects.missing,
        run SourcePolicy.conjunction(&mut builder.rules, &gates, List<SourceAtom>.asSlice(&empty))]
      effects.missing = run SourcePolicy.disjunction(&mut builder.rules, &missing)
    }
  }
  return move effects
}

// Cleanup observes the source graph's actual read of initialized storage at this exit. It
// never scans definitions created at unrelated points or uses a Loan ID as an owner witness.
// The caller separately records the original loop-cleanup marker and refusal frontier.
effect fn sourceObserveCleanup<'body>(builder: &mut SourceGraphBuilder<'body>, observation: &SourceObservation,
  state: &mut SourceLoanState, loans: &[Loan], cleanup: &[LoanCleanup], holder: usize,
  storage: SourceGraph.Storage, hidden: bool, point: usize, active: SourceAtom) -> SourceCleanupEffects
! OutOfMemoryError ? &mut Allocator {
  let refusal = SourceProgram.atom(&mut builder.rules)
  let mut effects = SourceCleanupEffects {intervals: List<SourceIntervalEffect>.make(), refusal: refusal,
    missing: SourceProgram.atom(&mut builder.rules)}
  if holder >= cleanup.length { return move effects }
  let descriptor = &cleanup[holder]
  let observed = List<Shared<Lifetime>>.asSlice(&descriptor.regions)
  if !descriptor.unknown && observed.length == usize.ZERO { return move effects }
  let empty = List<SourceAtom>.make()
  let none = List<SourceAtom>.asSlice(&empty)
  let yes = run sourceBoolean(&mut builder.rules, true)
  let everything = run sourceBoolean(&mut builder.rules, descriptor.unknown && hidden)
  let components = run sourceComponents(SourceGraphBuilder.preparation(&builder.*), storage.endpoint)
  let owned = List<PreparedSources.EndpointId>.asSlice(&components)
  let positions = List<SourceCarryPosition>.asSlice(&observation.positions)
  // The barrier is common to all real definitions observed at this exit. Alternative paired
  // histories do not sequentially contaminate one another's incoming precision version.
  drop run sourceBarrier(observation, &mut state.*, active, &mut builder.rules)
  let mut at = usize.ZERO
  while at < positions.length {
    let position = &positions[at]
    let named = List<Shared<Lifetime>>.asSlice(&loans[position.loan].regions)
    let namedEmpty = run sourceBoolean(&mut builder.rules, named.length == usize.ZERO)
    let shares = run sourceBoolean(&mut builder.rules, sharesAtom(named, observed))
    let cases = List<SourceCarryCase>.asSlice(&position.cases)
    let mut losses = List<SourcePolicy.Precision>.make()
    let mut each = usize.ZERO
    while each < cases.length {
      let actual = &cases[each]
      let guards: [SourceAtom; 2] = [active, actual.source.quality.present]
      let present = run SourcePolicy.conjunction(&mut builder.rules, &guards, none)
      if descriptor.unknown && !hidden {
        let held: [SourceAtom; 1] = [present]
        run SourceProgram.rule(&mut builder.rules, refusal, &held, none)
      } else {
        let definition = match actual.source.definition {
          Option<SourceControl.DefinitionId>.Some {value} => SourceGraphBuilder.definition(&builder.*, value)
          _ => { return CompilerBug.panic(b"cleanup source has no actual storage definition") }
        }
        let read = match actual.source.read {
          Option<SourceControl.ReadId>.Some {value} => SourceGraphBuilder.read(&builder.*, value)
          _ => { return CompilerBug.panic(b"cleanup source has no paired storage read") }
        }
        let sameOwner = match definition.storage.temporary {
          Option<SourceGraph.EvalId>.Some {value} => match read.storage.temporary {
            Option<SourceGraph.EvalId>.Some {value: other} => value.index == other.index
            _ => false
          }
          _ => match read.storage.temporary { Option<SourceGraph.EvalId>.None => true _ => false }
        }
        let expectedOwner = match storage.temporary {
          Option<SourceGraph.EvalId>.Some {value} => match read.storage.temporary {
            Option<SourceGraph.EvalId>.Some {value: other} => value.index == other.index
            _ => false
          }
          _ => match read.storage.temporary { Option<SourceGraph.EvalId>.None => true _ => false }
        }
        let mut matching = false
        let mut component = usize.ZERO
        while component < owned.length {
          if owned[component].index == read.storage.endpoint.index { matching = true }
          component = component + usize.ONE
        }
        if read.point.index != point || !sourceSameReadLane(definition, read)
          || !sourceReadTarget(&builder.*, read, position.value) || !sameOwner || !expectedOwner || !matching {
          CompilerBug.panic(b"cleanup cross-paired a definition and another storage read")
        }
        let decision = run SourcePolicy.cleanup(&mut builder.rules, &SourcePolicy.CleanupInput {
          observed: present, matchingHolder: yes, everything: everything, namedEmpty: namedEmpty, shares: shares})
        run List<SourceIntervalEffect>.append(&mut effects.intervals, SourceIntervalEffect {
          source: sourceEffectSource(position, actual), from: definition.point.index, to: point,
          cleanup: true, holder: false, active: decision.interval})
        run List<SourcePolicy.Precision>.append(&mut losses,
          SourcePolicy.Precision {stored: decision.addStored, alternatives: decision.addAlternatives})
      }
      each = each + usize.ONE
    }
    drop run SourceLoanState.finishPosition(&mut state.*, &mut builder.rules, position.loan,
      List<SourcePolicy.Precision>.asSlice(&losses))
    at = at + usize.ONE
  }
  return move effects
}

// Hidden owners use one dense identity per actual owner acquisition. A reused typed NodeId
// does not merge its two temporary lifecycles. These roots belong to this projection only.
fn sourceTemporaryRoot<'body>(prepared: &PreparedSources.SourcePreparation<'body>, reservation: &SourceVisit.Reservation,
  evaluation: SourceGraph.EvalId) -> Option<usize> {
  let owners = List<SourceVisit.Owner>.asSlice(&reservation.owners)
  let mut at = usize.ZERO
  while at < owners.length {
    let actual = match owners[at].root {
      SourceVisitOwnerRoot.Temporary {evaluation: acquired} => Option<SourceGraph.EvalId>.some(acquired)
      SourceVisitOwnerRoot.Subject {evaluation: acquired, ..} => Option<SourceGraph.EvalId>.some(acquired)
      SourceVisitOwnerRoot.Local {..} => Option<SourceGraph.EvalId>.none()
    }
    if let Option<SourceGraph.EvalId>.Some {value} = actual {
      if value.index == evaluation.index { return Option<usize>.some(prepared.body.locals.length + at) }
    }
    at = at + usize.ONE
  }
  return Option<usize>.none()
}

// Follow the recorded operand occurrences through the written projection. This is structural
// identity only; a reference boundary remains in Path and still owes its descriptor proof.
fn sourcePlaceBase<'body>(prepared: &PreparedSources.SourcePreparation<'body>, reservation: &SourceVisit.Reservation,
  input: SourceVisit.Input) -> SourceVisit.Input {
  let mut current = input
  let mut remaining = List<SourceVisit.Visit>.length(&reservation.visits) + usize.ONE
  while remaining > usize.ZERO {
    let projected = match &prepared.body.nodes[current.node.index].kind {
      NodeKind.Expression {form: Expression.Field {value, ..}, ..} => Option<NodeId>.some(value)
      NodeKind.Expression {form: Expression.Index {value, ..}, ..} => Option<NodeId>.some(value)
      NodeKind.Expression {form: Expression.Dereference {value}, ..} => Option<NodeId>.some(value)
      _ => Option<NodeId>.none()
    }
    match projected {
      Option<NodeId>.Some {value} => {
        let actual = SourceVisit.occurrence(reservation, current.evaluation)
        let inputs = List<SourceVisit.Input>.asSlice(&actual.inputs)
        if inputs.length == usize.ZERO || inputs[usize.ZERO].node.index != value.index {
          return CompilerBug.panic(b"source place projection lost its actual operand occurrence")
        }
        current = inputs[usize.ZERO]
      }
      Option<NodeId>.None => { return current }
    }
    remaining = remaining - usize.ONE
  }
  return CompilerBug.panic(b"source place occurrence chain is cyclic")
}

// A producer route and an authored borrow each own exactly one acquisition. PrepareEffect
// shares its Construction routes and is not a second acquisition or physical transfer.
union SourceBorrowKind {
  Authored {record: usize},
  Construction {record: usize, route: usize},
  Invocation {record: usize, route: usize},
  MatchView {record: usize},
  CaptureReborrow {record: usize},
}
impl Copy for SourceBorrowKind {}
struct SourceBorrowSite {
  visit: usize
  point: usize
  kind: SourceBorrowKind
}
impl Copy for SourceBorrowSite {}

// Stable ordering is actual acquisition order, before later operands, rather than the order
// in which completed parent expressions happen to be enumerated. Equal points preserve the
// producer's written route order; alternative histories never create extra acquisitions.
effect fn sourceBorrowOrder(sites: &mut List<SourceBorrowSite>, site: SourceBorrowSite) -> ()
! OutOfMemoryError ? &mut Allocator {
  run List<SourceBorrowSite>.append(&mut sites.*, site)
  let mut at = List<SourceBorrowSite>.length(&sites.*) - usize.ONE
  while at > usize.ZERO {
    let all = List<SourceBorrowSite>.asMutSlice(&mut sites.*)
    if all[at - usize.ONE].point <= all[at].point { break }
    let previous = all[at - usize.ONE]
    all[at - usize.ONE] = all[at]
    all[at] = previous
    at = at - usize.ONE
  }
  return ()
}

fn sourceCreatesReference(route: &PreparedSources.InputRoute) -> bool {
  return route.transport == PreparedSourcesTransport.BorrowShared
    || route.transport == PreparedSourcesTransport.BorrowMutable
}

// Bindings refer to an already evaluated subject. Rebase binder markers through those
// exact inputs so two executions of the same typed match never lend through one another.
effect fn sourcePathBinders<'body>(prepared: &PreparedSources.SourcePreparation<'body>, reservation: &SourceVisit.Reservation,
  input: SourceVisit.Input, binders: &mut List<usize>) -> () ! OutOfMemoryError ? &mut Allocator {
  let base = sourcePlaceBase(prepared, reservation, input)
  if let NodeKind.Expression {form: Expression.PatternBinding {subject, access, ..}, ..} = &prepared.body.nodes[base.node.index].kind {
    if access == BindingAccess.Place || access == BindingAccess.Shared || access == BindingAccess.Exclusive {
      let actual = SourceVisit.occurrence(reservation, base.evaluation)
      let inputs = List<SourceVisit.Input>.asSlice(&actual.inputs)
      if inputs.length != usize.ONE || inputs[0].node.index != subject.index {
        return CompilerBug.panic(b"view binding lost its actual subject input")
      }
      let source = run pathOf(prepared.body.nodes, subject)
      if source.root != usize.MAX { run sourcePathBinders(prepared, reservation, inputs[0], &mut binders.*) }
      if access != BindingAccess.Place { run List<usize>.append(&mut binders.*, inputs[0].evaluation.index) }
    }
  }
  return ()
}

// Rebase the nearest place refinement to its actual subject inspection. Borrowed bindings
// inherit their subject's refinement; only a place binding introduces its own test marker.
effect fn sourcePathRefiner<'body>(prepared: &PreparedSources.SourcePreparation<'body>, reservation: &SourceVisit.Reservation,
  input: SourceVisit.Input) -> usize ! OutOfMemoryError ? &mut Allocator {
  let base = sourcePlaceBase(prepared, reservation, input)
  if let NodeKind.Expression {form: Expression.PatternBinding {subject, access, ..}, ..} = &prepared.body.nodes[base.node.index].kind {
    if access == BindingAccess.Place || access == BindingAccess.Shared || access == BindingAccess.Exclusive {
      let actual = SourceVisit.occurrence(reservation, base.evaluation)
      let inputs = List<SourceVisit.Input>.asSlice(&actual.inputs)
      if inputs.length != usize.ONE || inputs[0].node.index != subject.index {
        return CompilerBug.panic(b"refined binding lost its actual subject occurrence")
      }
      let source = run pathOf(prepared.body.nodes, subject)
      if source.root != usize.MAX {
        if access == BindingAccess.Place { return inputs[0].evaluation.index }
        return run sourcePathRefiner(prepared, reservation, inputs[0])
      }
    }
  }
  return usize.MAX
}

// The test is the actual whole-subject inspection before the first guard/binding. Repeated
// evaluations of one typed subject have distinct markers and cannot refresh each other.
effect fn sourceRefinements<'body>(prepared: &PreparedSources.SourcePreparation<'body>, reservation: &SourceVisit.Reservation)
  -> List<Refinement> ! OutOfMemoryError ? &mut Allocator {
  let mut result = List<Refinement>.make()
  let visits = List<SourceVisit.Visit>.asSlice(&reservation.visits)
  let mut at = usize.ZERO
  while at < visits.length {
    if let NodeKind.Expression {form: Expression.Match {subject, access, ..}, ..} = &prepared.body.nodes[visits[at].node.index].kind {
      if scrutineeOf(&access) == Scrutinee.Place {
        let path = run pathOf(prepared.body.nodes, subject)
        if path.root != usize.MAX {
          let input = sourceAccessInput(&visits[at], usize.ZERO, subject)
          let prior = List<Refinement>.asSlice(&result)
          let mut each = usize.ZERO
          while each < prior.length {
            if prior[each].subject == input.evaluation.index {
              return CompilerBug.panic(b"one actual subject inspection has two refinement tests")
            }
            each = each + usize.ONE
          }
          run List<Refinement>.append(&mut result, Refinement {subject: input.evaluation.index, test: input.usePoint.index})
        }
      }
    }
    at = at + usize.ONE
  }
  return move result
}

// Authored address syntax retains its actual hidden/subject owner occurrence. This does not
// resolve a descriptor to the storage it addresses; referent steps remain explicit.
effect fn sourceAuthoredPath<'body>(prepared: &PreparedSources.SourcePreparation<'body>, reservation: &SourceVisit.Reservation,
  input: SourceVisit.Input) -> Path ! OutOfMemoryError ? &mut Allocator {
  let nodes = prepared.body.nodes
  let mut path = run pathOf(nodes, input.node)
  if path.root == usize.MAX {
    let base = sourcePlaceBase(prepared, reservation, input)
    path = run temporaryPath(nodes, input.node, base.node)
    path.root = match sourceTemporaryRoot(prepared, reservation, base.evaluation) {
      Option<usize>.Some {value} => value _ => usize.MAX
    }
  }
  let base = sourcePlaceBase(prepared, reservation, input)
  if let NodeKind.Expression {form: Expression.PatternBinding {subject, ..}, ..} = &nodes[base.node.index].kind {
    if path.root == subjectRoot(subject) {
      let actual = SourceVisit.occurrence(reservation, base.evaluation)
      let inputs = List<SourceVisit.Input>.asSlice(&actual.inputs)
      if inputs.length != usize.ONE || inputs[0].node.index != subject.index {
        CompilerBug.panic(b"pattern borrow lost its retained subject occurrence")
      }
      path.root = match sourceTemporaryRoot(prepared, reservation, inputs[0].evaluation) {
        Option<usize>.Some {value} => value _ => usize.MAX
      }
    }
  }
  path.binders = List<usize>.make()
  run sourcePathBinders(prepared, reservation, input, &mut path.binders)
  path.refiner = run sourcePathRefiner(prepared, reservation, input)
  return move path
}

// Extends the actual written operand by its producer-selected physical component path. This
// never uses selected/original parameter coordinates to infer the storage being borrowed.
effect fn sourceInputPath<'body>(prepared: &PreparedSources.SourcePreparation<'body>, reservation: &SourceVisit.Reservation,
  input: SourceVisit.Input, endpoint: PreparedSources.EndpointId) -> Path ! OutOfMemoryError ? &mut Allocator {
  let mut path = run sourceAuthoredPath(prepared, reservation, input)
  let endpoints = List<PreparedSources.Endpoint>.asSlice(&prepared.endpoints)
  let mut ancestry = List<PreparedSources.EndpointId>.make()
  let mut current = endpoint
  let mut remaining = endpoints.length
  while remaining > usize.ZERO {
    if current.index >= endpoints.length { CompilerBug.panic(b"producer borrow names an absent source endpoint") }
    match endpoints[current.index].parent {
      Option<PreparedSources.EndpointId>.Some {value} => {
        run List<PreparedSources.EndpointId>.append(&mut ancestry, current)
        current = value
      }
      Option<PreparedSources.EndpointId>.None => { break }
    }
    remaining = remaining - usize.ONE
  }
  if remaining == usize.ZERO { CompilerBug.panic(b"producer borrow component ancestry is cyclic") }
  let authentic = match &endpoints[current.index].root {
    PreparedSourcesRoot.Node {node, category} => node.index == input.node.index && category == PreparedSourcesEndpointRole.Storage
    _ => false
  }
  if !authentic { CompilerBug.panic(b"producer borrow is not based on its actual operand storage") }
  let steps = List<PreparedSources.EndpointId>.asSlice(&ancestry)
  let mut at = steps.length
  while at > usize.ZERO {
    at = at - usize.ONE
    match &endpoints[steps[at].index].selector {
      PreparedSourcesSelector.Field {ordinal} => run List<Step>.append(&mut path.steps, fieldStep(ordinal))
      PreparedSourcesSelector.Member {declaration, member, payload} => {
        if Shared<DeclarationId>.with<OwnerKind>(&declaration, DeclarationId.kind) == OwnerKind.Union {
          run List<Step>.append(&mut path.steps, memberStep(member))
          run List<Step>.append(&mut path.steps, fieldStep(payload))
        } else {
          if payload != usize.ZERO { CompilerBug.panic(b"record source component has a union payload coordinate") }
          run List<Step>.append(&mut path.steps, fieldStep(member))
        }
      }
      PreparedSourcesSelector.Variant {ordinal} => run List<Step>.append(&mut path.steps, memberStep(ordinal))
      PreparedSourcesSelector.Index {class} => {
        let step = match &class {
          PreparedSourcesIndexClass.Exact {index} => elementStep(index)
          PreparedSourcesIndexClass.Remainder => anyElement()
        }
        run List<Step>.append(&mut path.steps, step)
      }
      PreparedSourcesSelector.Referent => {
        run List<Step>.append(&mut path.steps, referent())
        path.through = true
      }
      _ => { CompilerBug.panic(b"contract/opaque selection cannot authenticate producer borrow storage") }
    }
  }
  return move path
}

// The parent's descriptor chain is actual physical path evidence. A shared boundary stops
// dependence on outer descriptors, exactly as descriptorChain does for a written projection.
effect fn sourceInputParent<'body>(prepared: &PreparedSources.SourcePreparation<'body>, input: SourceVisit.Input,
  endpoint: PreparedSources.EndpointId) -> Option<Shared<Lifetime>> ! OutOfMemoryError ? &mut Allocator {
  let mut chain = List<Shared<Lifetime>>.make()
  run placeDescriptors(prepared.body.nodes, input.node, &mut chain)
  let endpoints = List<PreparedSources.Endpoint>.asSlice(&prepared.endpoints)
  let shapes = List<PreparedSources.Shape>.asSlice(&prepared.shapes)
  let mut ancestry = List<PreparedSources.EndpointId>.make()
  let mut current = endpoint
  let mut remaining = endpoints.length
  while remaining > usize.ZERO {
    match endpoints[current.index].parent {
      Option<PreparedSources.EndpointId>.Some {value} => {
        run List<PreparedSources.EndpointId>.append(&mut ancestry, current)
        current = value
      }
      Option<PreparedSources.EndpointId>.None => { break }
    }
    remaining = remaining - usize.ONE
  }
  if remaining == usize.ZERO { CompilerBug.panic(b"producer descriptor ancestry is cyclic") }
  let steps = List<PreparedSources.EndpointId>.asSlice(&ancestry)
  let mut at = steps.length
  while at > usize.ZERO {
    at = at - usize.ONE
    if let PreparedSourcesSelector.Referent = &endpoints[steps[at].index].selector {
      let parent = match endpoints[steps[at].index].parent {
        Option<PreparedSources.EndpointId>.Some {value} => value
        _ => { return CompilerBug.panic(b"producer reference boundary has no actual descriptor") }
      }
      let ty = &shapes[endpoints[parent.index].shape.index].ty
      let shared = Shared<Type>.with<bool>(ty, fn(value: &Type) -> bool {
        return match &value.* { Type.Reference {access, ..} => access == Access.Shared Type.Slice {access, ..} => access == Access.Shared _ => false }
      })
      if shared { chain = List<Shared<Lifetime>>.make() }
      if let Option<Shared<Lifetime>>.Some {value} = move Shared<Type>.with<Option<Shared<Lifetime>>>(ty, loanLifetime) {
        run List<Shared<Lifetime>>.append(&mut chain, move value)
      }
    }
  }
  return run descriptorMeet(List<Shared<Lifetime>>.asSlice(&chain))
}

// The structural visitor has already placed every exit action on the one CFG. End is a
// storage definition as well as an ownership event; Expire limits a loan's validity without
// inventing destruction of storage which lowering still keeps. Cleanup/Use get their own
// policy observation and are not accidentally turned into an additional End.
effect fn sourceOwnerEnds<'body>(prepared: &PreparedSources.SourcePreparation<'body>,
  reservation: &mut SourceVisit.Reservation, ownership: &mut SourceOwnership, active: SourceAtom) -> ()
! OutOfMemoryError ? &mut Allocator {
  let owners = List<SourceVisit.Owner>.asSlice(&reservation.owners)
  let exits = List<SourceVisit.OwnerExit>.asSlice(&reservation.ownerExits)
  let endpoints = List<PreparedSources.Endpoint>.asSlice(&prepared.endpoints)
  let mut at = usize.ZERO
  while at < exits.length {
    let ended = &exits[at]
    if true {
      if ended.owner.index >= owners.length || ended.cause.index >= prepared.body.nodes.length {
        CompilerBug.panic(b"source owner exit lost its actual lifecycle identity")
      }
      let owner = &owners[ended.owner.index]
      let mut root = usize.MAX
      let mut endpoint = usize.MAX
      let mut temporary = Option<SourceGraph.EvalId>.none()
      let mut each = usize.ZERO
      while each < endpoints.length {
        let whole = match endpoints[each].parent { Option<PreparedSources.EndpointId>.None => true _ => false }
        let mut matches = false
        match owner.root {
          SourceVisitOwnerRoot.Local {local} => {
            matches = match &endpoints[each].root {
              PreparedSourcesRoot.Local {local: actual, category} => local.index == actual.index && category == PreparedSourcesEndpointRole.Storage
              _ => false
            }
          }
          SourceVisitOwnerRoot.Subject {node: subject, ..} => {
            matches = match &endpoints[each].root {
              PreparedSourcesRoot.Node {node, category} => node.index == subject.index && category == PreparedSourcesEndpointRole.Storage
              _ => false
            }
          }
          SourceVisitOwnerRoot.Temporary {evaluation} => {
            let actual = SourceVisit.occurrence(&reservation.*, evaluation)
            matches = match &endpoints[each].root {
              PreparedSourcesRoot.Node {node, category} => node.index == actual.node.index && category == PreparedSourcesEndpointRole.Storage
              _ => false
            }
          }
        }
        if whole && matches {
          if endpoint != usize.MAX { CompilerBug.panic(b"source owner has duplicate prepared storage roots") }
          endpoint = each
        }
        each = each + usize.ONE
      }
      match owner.root {
        SourceVisitOwnerRoot.Local {local} => { root = local.index }
        SourceVisitOwnerRoot.Subject {evaluation, ..} => {
          root = prepared.body.locals.length + ended.owner.index
          temporary = Option<SourceGraph.EvalId>.some(evaluation)
        }
        SourceVisitOwnerRoot.Temporary {evaluation} => {
          root = prepared.body.locals.length + ended.owner.index
          temporary = Option<SourceGraph.EvalId>.some(evaluation)
        }
      }
      if endpoint == usize.MAX { CompilerBug.panic(b"source owner end has no actual prepared storage") }
      if ended.action == SourceVisitOwnerAction.Use || ended.action == SourceVisitOwnerAction.Cleanup {
        let read = match ended.read {
          Option<SourceGraph.EvalId>.Some {value} => value
          _ => { return CompilerBug.panic(b"owner observation has no reserved current-point read") }
        }
        let evaluated = List<SourceGraph.Evaluation>.asSlice(&reservation.skeleton.evaluations)[read.index]
        if evaluated.point.index != ended.point.index || evaluated.category != SourceGraphEvaluationRole.Cleanup {
          CompilerBug.panic(b"owner observation moved away from its actual exit point")
        }
        let storage = SourceGraph.Storage {endpoint: PreparedSources.EndpointId {index: endpoint}, temporary: temporary}
        drop run SourceGraphSkeleton.observeStorage(&mut reservation.skeleton, prepared, storage, read)
        let mut descriptor = usize.MAX
        match owner.root {
          SourceVisitOwnerRoot.Local {local} => { descriptor = local.index }
          SourceVisitOwnerRoot.Subject {node, ..} => { descriptor = prepared.body.locals.length + node.index }
          SourceVisitOwnerRoot.Temporary {evaluation} => {
            let actual = SourceVisit.occurrence(&reservation.*, evaluation)
            descriptor = prepared.body.locals.length + prepared.body.nodes.length + actual.node.index
          }
        }
        run List<SourceOwnerObservation>.append(&mut ownership.observations, SourceOwnerObservation {
          owner: ended.owner, storage: storage, evaluation: read, point: ended.point, action: ended.action,
          descriptor: descriptor, hidden: root >= prepared.body.locals.length})
        at = at + usize.ONE
        continue
      }
      let origin = prepared.body.nodes[ended.cause.index].origin
      let mut kind = Kind.Expire
      if ended.action == SourceVisitOwnerAction.End {
        kind = Kind.End
        let evaluation = run SourceGraphSkeleton.evaluate(&mut reservation.skeleton, ended.cause,
          SourceGraphEvaluationRole.Cleanup, ended.point)
        run SourceGraphSkeleton.endOwner(&mut reservation.skeleton, endpoints,
          PreparedSources.EndpointId {index: endpoint}, temporary, evaluation, origin, active)
      }
      let event = Event {point: ended.point.index, place: Place {root: root, steps: List<Step>.make()},
        kind: kind, span: origin.location, target: origin.location, loan: usize.MAX, consumesTarget: usize.ZERO,
        refiner: usize.MAX, refinedDepth: usize.ZERO, binders: List<usize>.make()}
      // Preserve the actual event order even though acquisition and lifecycle facts are
      // projected in separate passes. Alternative CFG exits remain distinct events.
      let events = List<Event>.asSlice(&ownership.events)
      let mut position = usize.ZERO
      while position < events.length && events[position].point <= event.point { position = position + usize.ONE }
      run List<Event>.insert(&mut ownership.events, position, move event)
    }
    at = at + usize.ONE
  }
  return ()
}

// Same descriptor boundary as viewedReference, with the actual input occurrence retained.
// Index operands already have their own traversal visits and are never evaluated again.
fn sourceViewedInput<'body>(prepared: &PreparedSources.SourcePreparation<'body>, reservation: &SourceVisit.Reservation,
  subject: SourceVisit.Input) -> SourceVisit.Input {
  let mut current = subject
  let mut remaining = List<SourceVisit.Visit>.length(&reservation.visits) + usize.ONE
  while remaining > usize.ZERO {
    let mut selected = Option<NodeId>.none()
    let mut descriptor = false
    if let NodeKind.Expression {form, ..} = &prepared.body.nodes[current.node.index].kind {
      match &form {
        Expression.Field {value, ..} => { selected = Option<NodeId>.some(value) }
        Expression.Index {value, ..} => {
          selected = Option<NodeId>.some(value)
          descriptor = sliceValue(prepared.body.nodes, value)
        }
        Expression.Dereference {value} => {
          selected = Option<NodeId>.some(value)
          descriptor = true
        }
        _ => ()
      }
    }
    let next = match selected { Option<NodeId>.Some {value} => value _ => { return subject } }
    let actual = SourceVisit.occurrence(reservation, current.evaluation)
    current = sourceAccessInput(actual, usize.ZERO, next)
    if descriptor { return current }
    remaining = remaining - usize.ONE
  }
  return CompilerBug.panic(b"viewed descriptor occurrence chain is cyclic")
}

// MatchView licenses a place acquisition or an observation of an existing rvalue source.
// Neither emits a source-value seed; binding use does not manufacture a descriptor value.
effect fn sourceMatchViewLoan<'body>(prepared: &PreparedSources.SourcePreparation<'body>, reservation: &SourceVisit.Reservation,
  actual: &SourceVisit.Visit, record: usize, ownership: &mut SourceOwnership) -> () ! OutOfMemoryError ? &mut Allocator {
  let views = List<PreparedSources.MatchView>.asSlice(&prepared.matchViews)
  if record >= views.length || views[record].site.index != actual.node.index {
    return CompilerBug.panic(b"match loan has no matching prepared view")
  }
  let view = &views[record]
  let endpoints = List<PreparedSources.Endpoint>.asSlice(&prepared.endpoints)
  let selections = List<PreparedSources.Selection>.asSlice(&prepared.selections)
  if view.source.index >= endpoints.length || view.selection.index >= selections.length {
    return CompilerBug.panic(b"match view names an absent source selection")
  }
  let selected = &selections[view.selection.index]
  let accepts = List<PreparedSources.EndpointId>.asSlice(&selected.accepts)
  if selected.site.index != actual.node.index || selected.root.index != view.source.index
    || accepts.length != usize.ONE || accepts[0].index != view.source.index
    || List<PreparedSources.MapId>.length(&selected.maps) != usize.ZERO {
    return CompilerBug.panic(b"match view is not its exact singleton subject selection")
  }
  if let NodeKind.Expression {form: Expression.Match {subject, access, arms, syntax, ..}, ..} = &prepared.body.nodes[actual.node.index].kind {
    let mode = scrutineeOf(&access)
    if mode != Scrutinee.Shared && mode != Scrutinee.Exclusive {
      return CompilerBug.panic(b"nonborrowed match attempted a view acquisition")
    }
    let authentic = match &endpoints[view.source.index].root {
      PreparedSourcesRoot.Node {node, category} => node.index == subject.index && category == PreparedSourcesEndpointRole.Storage
      _ => false
    }
    if !authentic { return CompilerBug.panic(b"match view is not its original subject storage") }
    if let Option<PreparedSources.EndpointId>.Some {..} = endpoints[view.source.index].parent {
      return CompilerBug.panic(b"match view source is not the original whole subject")
    }
    let input = sourceAccessInput(actual, usize.ZERO, subject)
    let subjects = List<SourceVisit.Subject>.asSlice(&reservation.subjects)
    let mut scoped = usize.MAX
    let mut at = usize.ZERO
    while at < subjects.length {
      if subjects[at].site.index == actual.node.index && subjects[at].source.index == input.evaluation.index {
        if scoped != usize.MAX { return CompilerBug.panic(b"match view has duplicate actual subject occurrences") }
        scoped = at
      }
      at = at + usize.ONE
    }
    if scoped == usize.MAX || subjects[scoped].owned || subjects[scoped].evaluation.index != input.evaluation.index {
      return CompilerBug.panic(b"match view lost its actual borrowed subject")
    }
    let written = run pathOf(prepared.body.nodes, subject)
    let mut viewOrigin = Option<SourceViewOrigin>.none()
    if written.root == usize.MAX {
      let viewed = sourceViewedInput(prepared, reservation, input)
      let mut rootCandidate = Option<PreparedSources.EndpointId>.none()
      at = usize.ZERO
      while at < endpoints.length {
        let matches = match &endpoints[at].root {
          PreparedSourcesRoot.Node {node, category} => node.index == viewed.node.index && category == PreparedSourcesEndpointRole.Value
          _ => false
        }
        let whole = match endpoints[at].parent { Option<PreparedSources.EndpointId>.None => true _ => false }
        if matches && whole {
          if let Option<PreparedSources.EndpointId>.Some {..} = rootCandidate { return CompilerBug.panic(b"viewed value has duplicate actual roots") }
          rootCandidate = Option<PreparedSources.EndpointId>.some(PreparedSources.EndpointId {index: at})
        }
        at = at + usize.ONE
      }
      let root = match rootCandidate { Option<PreparedSources.EndpointId>.Some {value} => value _ => { return CompilerBug.panic(b"viewed reference has no prepared value root") } }
      viewOrigin = Option<SourceViewOrigin>.some(SourceViewOrigin.Carried {operand: SourceOperand {
        node: viewed.node, evaluation: viewed.evaluation, root: root, ordinal: usize.MAX}})
    } else {
      let path = run sourceInputPath(prepared, reservation, input, view.source)
      let exclusive = mode == Scrutinee.Exclusive && (syntax != MatchSyntax.Match || armLoanMatchesAccess())
      let parent = run borrowedPlaceLifetime(prepared.body.nodes, subject)
      let span = prepared.body.nodes[subject.index].origin.location
      let loan = List<Loan>.length(&ownership.loans)
      let encounter = sourceEncounter(List<SourceVisitDispatch>.asSlice(&reservation.dispatch), actual.evaluation,
        SourceEncounter.Input {evaluation: input.evaluation}, List<SourceVisit.Visit>.asSlice(&reservation.visits))
      run List<usize>.append(&mut ownership.encounters, encounter)
      let mut acquired = run loanTyped(prepared.body.owner, &path, exclusive, span,
        Option<Shared<Type>>.none(), move parent, input.usePoint.index)
      acquired.binder = input.evaluation.index
      run List<Loan>.append(&mut ownership.loans, move acquired)
      let mut kind = Kind.SharedBorrow
      if exclusive { kind = Kind.ExclusiveBorrow }
      let suffix = List<Step>.make()
      run sourceAcquisitionGeometry(prepared, reservation, input, view.source, input.usePoint, encounter,
        loan, kind, span, &path, move suffix, &mut ownership.*)
      viewOrigin = Option<SourceViewOrigin>.some(SourceViewOrigin.Acquired {loan: loan})
    }
    let mut extents = List<SourceViewExtent>.make()
    let declared = List<MatchArm>.asSlice(&arms)
    let intervals = List<SourceVisit.ArmResult>.asSlice(&actual.armInputs)
    if intervals.length != declared.length { return CompilerBug.panic(b"match view lost its actual arm intervals") }
    at = usize.ZERO
    while at < declared.length {
      let binds = List<NodeId>.length(&declared[at].bindings) != usize.ZERO
      if (syntax == MatchSyntax.Match && armLoanSpansArm()) || (syntax == MatchSyntax.IfLet && binds) {
        run List<SourceViewExtent>.append(&mut extents,
          SourceViewExtent {from: intervals[at].entry, to: intervals[at].completed})
      }
      at = at + usize.ONE
    }
    if syntax == MatchSyntax.Let && declared.length > usize.ZERO && List<NodeId>.length(&declared[0].bindings) != usize.ZERO {
      let exits = List<SourceVisit.ScopeExit>.asSlice(&reservation.exits)
      at = usize.ZERO
      while at < exits.length {
        if exits[at].scope.index == subjects[scoped].scope.index {
          run List<SourceViewExtent>.append(&mut extents, SourceViewExtent {from: input.usePoint, to: exits[at].point})
        }
        at = at + usize.ONE
      }
    }
    let origin = match move viewOrigin { Option<SourceViewOrigin>.Some {value} => move value _ => { return CompilerBug.panic(b"match view has no authored or carried source") } }
    run List<SourceMatchView>.append(&mut ownership.views, SourceMatchView {
      origin: move origin, record: record, result: actual.evaluation, source: input.evaluation,
      scope: subjects[scoped].scope, point: input.usePoint, extents: move extents})
    return ()
  }
  return CompilerBug.panic(b"prepared match view belongs to another expression")
}

// Callable.referents is an explicit acquisition request. Its Place map keeps the
// existing descriptor; the new referent loan has separate ownership publication.
effect fn sourceCaptureReborrowLoan<'body>(prepared: &PreparedSources.SourcePreparation<'body>,
  reservation: &mut SourceVisit.Reservation, visit: usize, record: usize, ownership: &mut SourceOwnership,
  active: SourceAtom) -> () ! OutOfMemoryError ? &mut Allocator {
  let row = &List<PreparedSources.CaptureReborrow>.asSlice(&prepared.captureReborrows)[record]
  PreparedSources.validateCaptureReborrow(prepared, row)
  let node = List<SourceVisit.Visit>.asSlice(&reservation.visits)[visit].node
  let result = List<SourceVisit.Visit>.asSlice(&reservation.visits)[visit].evaluation
  if row.site.index != node.index { return CompilerBug.panic(b"capture reborrow changed its construction occurrence") }
  let ordinal = match row.read { PreparedSourcesInputRead.Field {ordinal} => ordinal
    _ => { return CompilerBug.panic(b"capture reborrow lost its field input") } }
  let input = List<SourceVisit.Input>.asSlice(&List<SourceVisit.Visit>.asSlice(&reservation.visits)[visit].inputs)[ordinal]
  let matched = match input.read { Option<PreparedSourcesInputRead>.Some {value} => SourceGraph.sameInputRead(value, row.read)
    _ => false }
  if !matched {
    return CompilerBug.panic(b"capture reborrow changed its actual input")
  }
  let nodes = prepared.body.nodes
  let mut exclusive = false
  match &nodes[node.index].kind {
    NodeKind.Expression {form: Expression.Callable {fields, referents, ..}, ..} => {
      if List<AggregateField>.asSlice(&fields)[ordinal].value.index != input.node.index {
        return CompilerBug.panic(b"capture reborrow substituted another operand")
      }
      exclusive = List<ReferentCapture>.asSlice(&referents)[row.referent].access == Access.Mutable
    }
    _ => { return CompilerBug.panic(b"capture reborrow has no typed callable") }
  }
  let encounter = sourceEncounter(List<SourceVisitDispatch>.asSlice(&reservation.dispatch), result,
    SourceEncounter.Input {evaluation: input.evaluation}, List<SourceVisit.Visit>.asSlice(&reservation.visits))
  let mut path = run pathOf(nodes, input.node)
  // Preserve the original reborrowReferent eligibility. A selected/rvalue descriptor
  // is not permission to fabricate a whole local place or infer its referent address.
  if path.root == usize.MAX || path.through || List<Step>.length(&path.steps) != usize.ZERO {
    run List<SourceAccessRefusal>.append(&mut ownership.geometry, SourceAccessRefusal {
      uncertain: false, dispatch: encounter, point: input.usePoint, reason: BorrowStatus.StoredLoans})
    return ()
  }
  run List<Step>.append(&mut path.steps, referent())
  path.through = true
  let loan = List<Loan>.length(&ownership.loans)
  let span = nodes[input.node.index].origin.location
  run List<usize>.append(&mut ownership.encounters, encounter)
  run List<Loan>.append(&mut ownership.loans, run loanTyped(prepared.body.owner, &path, exclusive, span,
    expressionType(nodes, input.node), nodeLoanLifetime(nodes, input.node), input.usePoint.index))
  let mut kind = Kind.SharedBorrow
  if exclusive { kind = Kind.ExclusiveBorrow }
  run List<Event>.append(&mut ownership.events, Event {point: input.usePoint.index,
    place: Place {root: path.root, steps: run copySteps(List<Step>.asSlice(&path.steps))}, kind: kind,
    span: span, target: span, loan: loan, consumesTarget: usize.ZERO, refiner: path.refiner,
    refinedDepth: path.refinedDepth, binders: run copyBinders(List<usize>.asSlice(&path.binders))})
  let acquisition = run SourceGraphSkeleton.evaluate(&mut reservation.skeleton, node,
    SourceGraphEvaluationRole.Capture, input.usePoint)
  let descriptor = run SourceGraphSkeleton.captureReborrow(&mut reservation.skeleton, prepared, record,
    result, input.evaluation, ordinal, input.usePoint,
    SourceGraph.ReferenceAcquisition {evaluation: acquisition, loan: loan}, active)
  run List<SourceInputAcquisition>.append(&mut ownership.acquisitions, SourceInputAcquisition {
    result: result, input: input.evaluation, acquisition: acquisition, map: row.placement, loan: loan,
    kind: SourceInputAcquisitionKind.CaptureReborrow {descriptor: descriptor}})
  return ()
}

// Reserve all real acquisitions before observing policy-selected source histories.
// Construction placement is not execution of a future invocation destination write.
effect fn sourceDeclaredLoans<'body>(prepared: &PreparedSources.SourcePreparation<'body>, reservation: &mut SourceVisit.Reservation)
  -> SourceOwnership ! OutOfMemoryError ? &mut Allocator {
  let mut ownership = SourceOwnership {encounters: List<usize>.make(), loans: List<Loan>.make(), events: List<Event>.make(), geometry: List<SourceAccessRefusal>.make(),
    geometryDemands: List<SourceAcquisitionGeometry>.make(), places: List<SourceLoanGeometry>.make(),
    geometryRefusals: List<SourceGeometryRefusal>.make(), eventGates: List<SourceEventGate>.make(),
    acquisitions: List<SourceInputAcquisition>.make(), views: List<SourceMatchView>.make(),
    observations: List<SourceOwnerObservation>.make()}
  let nodes = prepared.body.nodes
  let authored = List<PreparedSources.Borrow>.asSlice(&prepared.borrows)
  let views = List<PreparedSources.MatchView>.asSlice(&prepared.matchViews)
  let constructions = List<PreparedSources.Construction>.asSlice(&prepared.constructions)
  let operations = List<PreparedSources.Operation>.asSlice(&prepared.operations)
  let maps = List<PreparedSources.SelectionMap>.asSlice(&prepared.maps)
  let endpoints = List<PreparedSources.Endpoint>.asSlice(&prepared.endpoints)
  let shapes = List<PreparedSources.Shape>.asSlice(&prepared.shapes)
  let active = SourceProgram.atom(&mut reservation.skeleton.rules)
  run SourceProgram.fact(&mut reservation.skeleton.rules, active)
  let count = List<SourceVisit.Visit>.length(&reservation.visits)
  let mut sites = List<SourceBorrowSite>.make()
  let mut at = usize.ZERO
  while at < count {
    let actual = &List<SourceVisit.Visit>.asSlice(&reservation.visits)[at]
    if let NodeKind.Expression {form: Expression.Borrow {..}, ..} = &nodes[actual.node.index].kind {
      let mut found = usize.MAX
      let mut each = usize.ZERO
      while each < authored.length {
        if authored[each].site.index == actual.node.index {
          if found != usize.MAX { CompilerBug.panic(b"authored source borrow has duplicate preparation records") }
          found = each
        }
        each = each + usize.ONE
      }
      if found == usize.MAX { CompilerBug.panic(b"authored source borrow has no prepared reference maps") }
      run sourceBorrowOrder(&mut sites, SourceBorrowSite {visit: at, point: actual.execute.index,
        kind: SourceBorrowKind.Authored {record: found}})
    }
    if let NodeKind.Expression {form: Expression.Match {subject, access, ..}, ..} = &nodes[actual.node.index].kind {
      let mode = scrutineeOf(&access)
      if mode == Scrutinee.Shared || mode == Scrutinee.Exclusive {
        let mut record = usize.MAX
        let mut each = usize.ZERO
        while each < views.length {
          if views[each].site.index == actual.node.index {
            if record != usize.MAX { return CompilerBug.panic(b"match view has duplicate prepared acquisitions") }
            record = each
          }
          each = each + usize.ONE
        }
        if record == usize.MAX { return CompilerBug.panic(b"borrowed match has no prepared view authority") }
        let input = sourceAccessInput(actual, usize.ZERO, subject)
        run sourceBorrowOrder(&mut sites, SourceBorrowSite {visit: at, point: input.usePoint.index,
          kind: SourceBorrowKind.MatchView {record: record}})
      }
    }
    let mut capture = usize.ZERO
    let reborrows = List<PreparedSources.CaptureReborrow>.asSlice(&prepared.captureReborrows)
    while capture < reborrows.length {
      let row = &reborrows[capture]
      if row.site.index == actual.node.index {
        PreparedSources.validateCaptureReborrow(prepared, row)
        let ordinal = match row.read { PreparedSourcesInputRead.Field {ordinal} => ordinal
          _ => { return CompilerBug.panic(b"capture reborrow lost its actual field input") } }
        let inputs = List<SourceVisit.Input>.asSlice(&actual.inputs)
        let matched = ordinal < inputs.length && match inputs[ordinal].read {
          Option<PreparedSourcesInputRead>.Some {value} => SourceGraph.sameInputRead(value, row.read)
          _ => false
        }
        if !matched {
          return CompilerBug.panic(b"capture reborrow lost its actual input occurrence")
        }
        run sourceBorrowOrder(&mut sites, SourceBorrowSite {visit: at, point: inputs[ordinal].usePoint.index,
          kind: SourceBorrowKind.CaptureReborrow {record: capture}})
      }
      capture = capture + usize.ONE
    }
    let mut each = usize.ZERO
    while each < constructions.length {
      if constructions[each].site.index == actual.node.index {
        let inputs = List<PreparedSources.InputRoute>.asSlice(&constructions[each].inputs)
        let mut route = usize.ZERO
        while route < inputs.length {
          if sourceCreatesReference(&inputs[route]) {
            let input = SourceVisit.routeInput(prepared, actual, &inputs[route])
            run sourceBorrowOrder(&mut sites, SourceBorrowSite {visit: at, point: input.usePoint.index,
              kind: SourceBorrowKind.Construction {record: each, route: route}})
          }
          route = route + usize.ONE
        }
      }
      each = each + usize.ONE
    }
    each = usize.ZERO
    while each < operations.length {
      if operations[each].site.index == actual.node.index && operations[each].phase != PreparedSourcesOperationPhase.PrepareEffect {
        let inputs = List<PreparedSources.InputRoute>.asSlice(&operations[each].inputs)
        let mut route = usize.ZERO
        while route < inputs.length {
          if sourceCreatesReference(&inputs[route]) {
            let input = SourceVisit.routeInput(prepared, actual, &inputs[route])
            run sourceBorrowOrder(&mut sites, SourceBorrowSite {visit: at, point: input.usePoint.index,
              kind: SourceBorrowKind.Invocation {record: each, route: route}})
          }
          route = route + usize.ONE
        }
      }
      each = each + usize.ONE
    }
    at = at + usize.ONE
  }
  let ordered = List<SourceBorrowSite>.asSlice(&sites)
  at = usize.ZERO
  while at < ordered.length {
    let site = ordered[at]
    if let SourceBorrowKind.CaptureReborrow {record} = site.kind {
      run sourceCaptureReborrowLoan(prepared, &mut reservation.*, site.visit, record, &mut ownership, active)
      at = at + usize.ONE
      continue
    }
    let actual = &List<SourceVisit.Visit>.asSlice(&reservation.visits)[site.visit]
    let evaluation = actual.evaluation
    if let SourceBorrowKind.MatchView {record} = site.kind {
      run sourceMatchViewLoan(prepared, &reservation.*, actual, record, &mut ownership)
      at = at + usize.ONE
      continue
    }
    let mut inputCandidate = Option<SourceVisit.Input>.none()
    let mut route = Option<&PreparedSources.InputRoute>.none()
    let mut map = PreparedSources.MapId {index: usize.MAX}
    match site.kind {
      SourceBorrowKind.MatchView {..} => { return CompilerBug.panic(b"match view entered descriptor acquisition") }
      SourceBorrowKind.CaptureReborrow {..} => { return CompilerBug.panic(b"capture reborrow entered reference creation") }
      SourceBorrowKind.Authored {record} => {
        let operands = List<SourceVisit.Input>.asSlice(&actual.inputs)
        if operands.length != usize.ONE { CompilerBug.panic(b"authored borrow lost its actual operand") }
        inputCandidate = Option<SourceVisit.Input>.some(operands[usize.ZERO])
        map = authored[record].map
      }
      SourceBorrowKind.Construction {record, route: index} => {
        let selected = &List<PreparedSources.InputRoute>.asSlice(&constructions[record].inputs)[index]
        inputCandidate = Option<SourceVisit.Input>.some(SourceVisit.routeInput(prepared, actual, selected))
        map = selected.map
        route = Option<&PreparedSources.InputRoute>.some(selected)
      }
      SourceBorrowKind.Invocation {record, route: index} => {
        let selected = &List<PreparedSources.InputRoute>.asSlice(&operations[record].inputs)[index]
        inputCandidate = Option<SourceVisit.Input>.some(SourceVisit.routeInput(prepared, actual, selected))
        map = selected.map
        route = Option<&PreparedSources.InputRoute>.some(selected)
      }
    }
    let input = match inputCandidate { Option<SourceVisit.Input>.Some {value} => value _ => { return CompilerBug.panic(b"source acquisition has no actual input") } }
    let physical = &maps[map.index]
    let mut path = run sourceInputPath(prepared, &reservation.*, input, physical.source)
    let mut parent = run sourceInputParent(prepared, input, physical.source)
    if let SourceBorrowKind.Authored {..} = site.kind {
      if sliceValue(nodes, input.node) && sliceValue(nodes, actual.node) {
        run List<Step>.append(&mut path.steps, referent())
        path.through = true
        parent = run descriptorLifetime(nodes, input.node)
      }
    }
    let descriptor = &shapes[endpoints[physical.target.index].shape.index].ty
    let exclusive = Shared<Type>.with<bool>(descriptor, fn(value: &Type) -> bool {
      return match &value.* { Type.Reference {access, ..} => access == Access.Mutable Type.Slice {access, ..} => access == Access.Mutable _ => false }
    })
    let loan = List<Loan>.length(&ownership.loans)
    let encounterKind = match site.kind {
      SourceBorrowKind.Authored {..} => SourceEncounter.Finish
      _ => SourceEncounter.Input {evaluation: input.evaluation}
    }
    let encounter = sourceEncounter(List<SourceVisitDispatch>.asSlice(&reservation.dispatch), actual.evaluation,
      move encounterKind, List<SourceVisit.Visit>.asSlice(&reservation.visits))
    run List<usize>.append(&mut ownership.encounters, encounter)
    let span = physical.origin.location
    run List<Loan>.append(&mut ownership.loans, run loanTyped(prepared.body.owner, &path, exclusive, span,
      Option<Shared<Type>>.some(Shared<Type>.clone(descriptor)), move parent, site.point))
    let mut kind = Kind.SharedBorrow
    if exclusive { kind = Kind.ExclusiveBorrow }
    let mut suffix = List<Step>.make()
    if let SourceBorrowKind.Authored {..} = site.kind {
      if sliceValue(nodes, input.node) && sliceValue(nodes, actual.node) { run List<Step>.append(&mut suffix, referent()) }
    }
    run sourceAcquisitionGeometry(prepared, &reservation.*, input, physical.source,
      SourceControl.PointId {index: site.point}, encounter, loan, kind, span, &path, move suffix, &mut ownership)
    match site.kind {
      SourceBorrowKind.Authored {record} => {
        drop run SourceGraphSkeleton.borrow(&mut reservation.skeleton, prepared, &authored[record],
          input.evaluation, evaluation, loan, active)
      }
      _ => {
        let selected = match route { Option<&PreparedSources.InputRoute>.Some {value} => value _ => { return CompilerBug.panic(b"producer reference has no physical input route") } }
        let acquisition = run SourceGraphSkeleton.evaluate(&mut reservation.skeleton, actual.node,
          SourceGraphEvaluationRole.Capture, input.usePoint)
        run List<SourceInputAcquisition>.append(&mut ownership.acquisitions,
          SourceInputAcquisition {result: evaluation, input: input.evaluation, acquisition: acquisition, map: selected.map, loan: loan,
            kind: SourceInputAcquisitionKind.Reference})
        drop run SourceGraphSkeleton.input(&mut reservation.skeleton, endpoints, maps, selected,
          input.evaluation, evaluation, Option<SourceGraph.ReferenceAcquisition>.some(
            SourceGraph.ReferenceAcquisition {evaluation: acquisition, loan: loan}), active)
      }
    }
    at = at + usize.ONE
  }
  // Existing descriptors are transferred once at their actual producer route. The matching
  // PrepareEffect operation is metadata for later execution, not another placement. Borrow
  // routes were activated above together with their real loan and are never copied again.
  at = usize.ZERO
  while at < count {
    let actual = &List<SourceVisit.Visit>.asSlice(&reservation.visits)[at]
    let mut each = usize.ZERO
    while each < constructions.length {
      if constructions[each].site.index == actual.node.index {
        run sourceValueInputs(prepared, &mut reservation.skeleton, actual,
          List<PreparedSources.InputRoute>.asSlice(&constructions[each].inputs), active)
      }
      each = each + usize.ONE
    }
    each = usize.ZERO
    while each < operations.length {
      if operations[each].site.index == actual.node.index && operations[each].phase != PreparedSourcesOperationPhase.PrepareEffect {
        run sourceValueInputs(prepared, &mut reservation.skeleton, actual,
          List<PreparedSources.InputRoute>.asSlice(&operations[each].inputs), active)
      }
      each = each + usize.ONE
    }
    at = at + usize.ONE
  }
  SourceVisit.referenceObservationBoundaries(prepared, &mut reservation.*)
  run sourceOwnerEnds(prepared, &mut reservation.*, &mut ownership, active)
  return move ownership
}

effect fn sourceValueInputs<'body>(prepared: &PreparedSources.SourcePreparation<'body>, skeleton: &mut SourceGraphSkeleton,
  actual: &SourceVisit.Visit, inputs: &[PreparedSources.InputRoute], active: SourceAtom) -> ()
! OutOfMemoryError ? &mut Allocator {
  let endpoints = List<PreparedSources.Endpoint>.asSlice(&prepared.endpoints)
  let maps = List<PreparedSources.SelectionMap>.asSlice(&prepared.maps)
  let mut at = usize.ZERO
  while at < inputs.length {
    if !sourceCreatesReference(&inputs[at]) {
      let input = SourceVisit.routeInput(prepared, actual, &inputs[at])
      drop run SourceGraphSkeleton.input(&mut skeleton.*, endpoints, maps, &inputs[at], input.evaluation,
        actual.evaluation, Option<SourceGraph.ReferenceAcquisition>.none(), active)
    }
    at = at + usize.ONE
  }
  return ()
}

// Store/return windows are original typing-policy evidence, independent of canonical
// address proofs. Record them at the actual encounter where the accepted handler records
// its goal, before its operands. Finish's sealed/unheld sites use its explicit directive.
// Reservation alone establishes no active escape; settlement still owes point truth and
// the first checker-refusal boundary for these actual occurrences.
effect fn sourceEscapeInventory<'body>(prepared: &PreparedSources.SourcePreparation<'body>, reservation: &SourceVisit.Reservation)
  -> SourceEscapeInventory ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut inventory = SourceEscapeInventory {windows: List<SourceEscapeWindow>.make(),
    sites: List<SourceEscapeSite>.make(), escaping: List<SourceEscapingLocal>.make()}
  let visits = List<SourceVisit.Visit>.asSlice(&reservation.visits)
  let nodes = prepared.body.nodes
  let mut at = usize.ZERO
  while at < visits.length {
    let actual = &visits[at]
    let span = nodes[actual.node.index].origin.location
    let entered = sourceEncounter(List<SourceVisitDispatch>.asSlice(&reservation.dispatch), actual.evaluation, SourceEncounter.Enter, visits)
    let mut written = Option<Shared<Type>>.none()
    let mut holder = usize.MAX
    let mut returned = false
    let shape = run shapeOf(nodes, actual.node)
    match move shape {
      Shape.Binding {local, ..} => {
        written = Option<Shared<Type>>.some(localType(prepared.body.locals, local))
        holder = local
      }
      Shape.Assignment {local, ..} => {
        written = Option<Shared<Type>>.some(localType(prepared.body.locals, local))
        holder = local
      }
      Shape.PlaceAssignment {target, value} => {
        let path = run pathOf(nodes, target)
        if path.through {
          written = expressionType(nodes, target)
          let source = run pathOf(nodes, movedOperand(nodes, value))
          if source.root < prepared.body.locals.length && !source.through {
            run List<SourceEscapingLocal>.append(&mut inventory.escaping, SourceEscapingLocal {
              dispatch: entered, evaluation: actual.evaluation, point: actual.entry, local: source.root})
          }
        } else if path.root < prepared.body.locals.length {
          written = Option<Shared<Type>>.some(localType(prepared.body.locals, path.root))
          holder = path.root
        }
      }
      Shape.Exit {value} => {
        if let NodeKind.Return {..} = &nodes[actual.node.index].kind {
          if let Option<NodeId>.Some {value: operand} = value {
            written = expressionType(nodes, operand)
            returned = true
          }
        }
      }
      _ => ()
    }
    if let Option<Shared<Type>>.Some {value} = move written {
      if let Option<StoreWindow>.Some {value: window} = move run storeWindow(prepared.body.owner, &value, span, holder) {
        run List<SourceEscapeWindow>.append(&mut inventory.windows, SourceEscapeWindow {
          dispatch: entered, evaluation: actual.evaluation, point: actual.entry, returned: returned, window: move window})
      }
    }
    at = at + usize.ONE
  }
  let results = List<SourceGraph.ResultUse>.asSlice(&reservation.skeleton.results)
  let evaluations = List<SourceGraph.Evaluation>.asSlice(&reservation.skeleton.evaluations)
  at = usize.ZERO
  while at < results.length {
    let directive = &results[at]
    let finished = sourceEncounter(List<SourceVisitDispatch>.asSlice(&reservation.dispatch), directive.evaluation, SourceEncounter.Finish, visits)
    let node = match evaluations[directive.evaluation.index].site {
      SourceGraphEvaluationSite.Node {node} => node
      _ => { return CompilerBug.panic(b"escape result window has no actual expression") }
    }
    let scalarRead = match directive.kind { SourceGraphResultKind.Read {..} => true _ => false }
    if !scalarRead && !run nodeRetains(nodes, node, prepared.body.owner) {
      run List<SourceEscapeSite>.append(&mut inventory.sites, SourceEscapeSite {dispatch: finished, evaluation: directive.evaluation,
        active: directive.active, span: nodes[node.index].origin.location, sealed: true})
    }
    if let NodeKind.Expression {form: Expression.DirectCall {arguments, ..}, ..} = &nodes[node.index].kind {
      let inputs = List<NodeId>.asSlice(&arguments)
      let mut each = usize.ZERO
      while each < inputs.length {
        if !retainedOperand(nodes, node, each) {
          run List<SourceEscapeSite>.append(&mut inventory.sites, SourceEscapeSite {dispatch: finished, evaluation: directive.evaluation,
            active: directive.active, span: nodes[inputs[each].index].origin.location, sealed: false})
        }
        each = each + usize.ONE
      }
    }
    at = at + usize.ONE
  }
  return move inventory
}

// The owner of finish explicitly marks its terminal publication before reserve/emit. The
// graph never guesses this semantic boundary from a Select, Place or Copy map. In particular,
// a construction and a match join are physical operations without a finish policy barrier.
effect fn sourceResultUses<'body>(prepared: &PreparedSources.SourcePreparation<'body>, reservation: &mut SourceVisit.Reservation,
  ownership: &SourceOwnership, cleanup: &[LoanCleanup], stores: &SourceStores.Inventory) -> () ! OutOfMemoryError ? &mut Allocator | &mut Types {
  if List<SourceGraph.ResultUse>.length(&reservation.skeleton.results) != usize.ZERO {
    CompilerBug.panic(b"ownership result directives were emitted twice")
  }
  let visits = List<SourceVisit.Visit>.asSlice(&reservation.visits)
  let acquired = List<SourceInputAcquisition>.asSlice(&ownership.acquisitions)
  let nodes = prepared.body.nodes
  let mut at = usize.ZERO
  while at < visits.length {
    let actual = &visits[at]
    if sourceInlinedOperation(stores, actual.evaluation) { at = at + usize.ONE continue }
    let mut kind = Option<SourceGraphResultKind>.none()
    let shape = run shapeOf(nodes, actual.node)
    match move shape {
      Shape.Operands {..} => { kind = Option<SourceGraphResultKind>.some(SourceGraphResultKind.Physical) }
      Shape.ShortCircuit {..} => { kind = Option<SourceGraphResultKind>.some(SourceGraphResultKind.Physical) }
      Shape.Call {exact, signature, ..} => {
        let mut selected = SourceGraphResultKind.Physical
        if signature && !exact { selected = SourceGraphResultKind.Declared }
        kind = Option<SourceGraphResultKind>.some(move selected)
      }
      Shape.Invoke {..} => { kind = Option<SourceGraphResultKind>.some(SourceGraphResultKind.Declared) }
      Shape.ReadPlace => {
        if actual.access == SourceVisitAccess.Value {
          let path = run pathOf(nodes, actual.node)
          if path.root == usize.MAX {
            let base = projectedBase(nodes, actual.node)
            // Cleanup descriptors are immutable type metadata indexed by producer node;
            // this index does not identify or merge the actual temporary acquisitions.
            let descriptor = prepared.body.locals.length + nodes.length + base.index
            let hidden = descriptor < cleanup.length
              && (cleanup[descriptor].unknown || List<Shared<Lifetime>>.length(&cleanup[descriptor].regions) != usize.ZERO)
            if hidden {
              kind = Option<SourceGraphResultKind>.some(SourceGraphResultKind.Read {read: actual.evaluation})
            } else {
              // Rvalue projections evaluate their physical operand; they do not acquire
              // an owned holder merely to classify the returned component.
              kind = Option<SourceGraphResultKind>.some(SourceGraphResultKind.Physical)
            }
          } else if path.through || List<Step>.length(&path.steps) != usize.ZERO {
            kind = Option<SourceGraphResultKind>.some(SourceGraphResultKind.Read {read: actual.evaluation})
          }
        }
      }
      Shape.Displace {target, ..} => {
        let path = run pathOf(nodes, target)
        if path.root != usize.MAX && (path.through || !run nodeRetains(nodes, target, prepared.body.owner)) {
          let read = match actual.displaced {
            Option<SourceGraph.EvalId>.Some {value: displaced} => displaced
            _ => { return CompilerBug.panic(b"replacement has no actual displaced read") }
          }
          kind = Option<SourceGraphResultKind>.some(SourceGraphResultKind.Read {read: read})
        }
      }
      _ => ()
    }
    if let Option<SourceGraphResultKind>.Some {value} = move kind {
      let mut sources = List<SourceGraph.EvalId>.make()
      let inputs = List<SourceVisit.Input>.asSlice(&actual.inputs)
      let mut each = usize.ZERO
      while each < inputs.length {
        run List<SourceGraph.EvalId>.append(&mut sources, inputs[each].evaluation)
        let mut borrowed = usize.ZERO
        while borrowed < acquired.length {
          if acquired[borrowed].result.index == actual.evaluation.index
            && acquired[borrowed].input.index == inputs[each].evaluation.index {
            run List<SourceGraph.EvalId>.append(&mut sources, acquired[borrowed].acquisition)
          }
          borrowed = borrowed + usize.ONE
        }
        each = each + usize.ONE
      }
      let active = SourceControlFlow.reachable(&reservation.skeleton.flow, actual.execute)
      run List<SourceGraph.ResultUse>.append(&mut reservation.skeleton.results, SourceGraph.ResultUse {
        evaluation: actual.evaluation, active: active, kind: move value, sources: move sources})
    }
    at = at + usize.ONE
  }
  return ()
}

// Implicit producer references name their actual descriptor endpoint's type, not the enclosing
// Callable/Effect result. The declaration facts are otherwise identical to an authored borrow.
effect fn loanTyped(owner: &DeclarationId, path: &Path, exclusive: bool, span: Location,
  typed: Option<Shared<Type>>, parent: Option<Shared<Lifetime>>, point: usize) -> Loan
! OutOfMemoryError ? &mut Allocator {
  let mut regions = List<Shared<Lifetime>>.make()
  let mut borrowed = Option<Shared<Lifetime>>.none()
  let mut viewed = Option<Shared<Type>>.none()
  if let Option<Shared<Type>>.Some {value} = move typed {
    borrowed = Shared<Type>.with<Option<Shared<Lifetime>>>(&value, loanLifetime)
    let known = run retainedBy(&value, owner, &mut regions)
    if !known { regions = List<Shared<Lifetime>>.make() }
    viewed = Shared<Type>.with<Option<Shared<Type>>>(&value, loanReferent)
  }
  return Loan {
    place: Place {root: path.root, steps: run copySteps(List<Step>.asSlice(&path.steps))},
    exclusive: exclusive,
    origin: span,
    intervals: List<Interval>.make(),
    precision: LoanPrecision.Exact,
    regions: move regions,
    local: !path.through,
    borrowed: move borrowed,
    parent: move parent,
    crossed: false,
    created: point,
    escapes: false,
    binder: usize.MAX,
    block: usize.MAX,
    until: usize.MAX,
    referent: move viewed,
    bound: false,
  }
}

effect fn operandPlacements(nodes: &[Node], result: NodeId, places: &[usize], member: usize)
  -> List<List<Step>> ! OutOfMemoryError ? &mut Allocator {
  // An aggregate places each operand at its field, at its element of an array, or at its field of the
  // constructed variant's payload.
  let mut placed = List<List<Step>>.make()
  let elements = match move expressionType(nodes, result) {
    Option<Shared<Type>>.Some {value} => Shared<Type>.with<bool>(&value, arrayType)
    Option<Shared<Type>>.None => false
  }
  let mut index = usize.ZERO
  while index < places.length {
    let mut steps = List<Step>.make()
    if member != usize.MAX { run List<Step>.append(&mut steps, memberStep(member)) }
    if elements {
      let mut step = Step {kind: StepKind.RepeatedElement, ordinal: usize.ZERO}
      if places[index] != usize.MAX { step = elementStep(places[index]) }
      run List<Step>.append(&mut steps, step)
    } else {
      run List<Step>.append(&mut steps, fieldStep(places[index]))
    }
    run List<List<Step>>.append(&mut placed, move steps)
    index = index + usize.ONE
  }
  return move placed
}

// The type operand `operand` of call or record literal `result` has under the generic arguments the
// source wrote for it: the call's parameter type, or the literal's field type.
effect fn writtenOperandType(nodes: &[Node], result: NodeId, operand: usize) -> Option<Shared<Type>>
! OutOfMemoryError ? &mut Allocator {
  // An immediate run's operands are those of the call it executes.
  if let NodeKind.Expression {form: Expression.Run {value, access}, ..} = &nodes[result.index].kind {
    if access == RunAccess.Immediate { return run writtenOperandType(nodes, value, operand) }
  }
  return match &nodes[result.index].kind {
    NodeKind.Expression {form: Expression.DirectCall {written, ..}, ..} => {
      let chosen = List<Shared<Type>>.asSlice(&written)
      if operand < chosen.length { return Option<Shared<Type>>.some(Shared<Type>.clone(&chosen[operand])) }
      return Option<Shared<Type>>.none()
    }
    NodeKind.Expression {form: Expression.Aggregate {written, ..}, ..} => {
      let chosen = List<Shared<Type>>.asSlice(&written)
      if operand < chosen.length { return Option<Shared<Type>>.some(Shared<Type>.clone(&chosen[operand])) }
      return Option<Shared<Type>>.none()
    }
    _ => Option<Shared<Type>>.none()
  }
}

// Written universal arguments are independent escape reasons. Preserve their paired
// actual sources; they never acquire caller-retention provenance from a later operation.
effect fn sourceKeepWritten(nodes: &[Node], owner: &DeclarationId, result: NodeId,
  observation: &SourceObservation, loans: &[Loan], active: SourceAtom, rules: &mut SourceProgram)
  -> List<SourceEscapeEffect> ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut effects = List<SourceEscapeEffect>.make()
  let positions = List<SourceCarryPosition>.asSlice(&observation.positions)
  let empty = List<SourceAtom>.make()
  let mut at = usize.ZERO
  while at < positions.length {
    if let Option<Shared<Type>>.Some {value: typed} = move run writtenOperandType(nodes, result, positions[at].operand) {
      if (run universallyTyped(&typed, owner)) && !loans[positions[at].loan].local {
        let cases = List<SourceCarryCase>.asSlice(&positions[at].cases)
        let mut each = usize.ZERO
        while each < cases.length {
          let gates: [SourceAtom; 2] = [active, cases[each].source.quality.present]
          run List<SourceEscapeEffect>.append(&mut effects, SourceEscapeEffect {
            source: sourceEffectSource(&positions[at], &cases[each]),
            active: run SourcePolicy.conjunction(&mut rules.*, &gates, List<SourceAtom>.asSlice(&empty))})
          each = each + usize.ONE
        }
      }
    }
    at = at + usize.ONE
  }
  return move effects
}

// Which local loans a result that names only caller regions keeps exactly (see `finish`).
enum Forwarding {
  // None: the result's type decides what it holds, as for a call.
  None,
  // Every operand loan: the result is built from its operands.
  Operands,
  // The loans a place read found held where it reads (`SourceSlotValue.field` known).
  Matched,
}

// Whether `region` is a meet of this body's regions with universal ones. Such a meet is valid only
// while each of its local constituents is, and the universal ones outlive the body, so its local
// constituents carry every finite requirement it has: a binding that held a parameter's reference
// and is then assigned a borrow types the borrow under that meet.
fn localMeet(region: &Shared<Lifetime>, owner: &DeclarationId, supplied: &[Shared<Lifetime>]) -> bool {
  let count = Lifetime.atomCount(region)
  if count <= usize.ONE { return false }
  let mut local = false
  let mut at = usize.ZERO
  while at < count {
    let domain = regionDomain(&Lifetime.atomAt(region, at), owner, supplied)
    if domain == RegionDomain.Unknown { return false }
    if domain == RegionDomain.Local { local = true }
    at = at + usize.ONE
  }
  return local
}

// Whether `region` is `named` itself or a local constituent of `named`, a `localMeet`.
fn carriesRegion(named: &Shared<Lifetime>, region: &Shared<Lifetime>, owner: &DeclarationId, supplied: &[Shared<Lifetime>]) -> bool {
  if Lifetime.equalsShared(named, region) { return true }
  return localMeet(named, owner, supplied) && meetMember(named, region)
}

// Whether one of `regions` carries `region` (`carriesRegion`).
fn regionsCarry(regions: &[Shared<Lifetime>], region: &Shared<Lifetime>, owner: &DeclarationId, supplied: &[Shared<Lifetime>]) -> bool {
  let mut at = usize.ZERO
  while at < regions.length {
    if carriesRegion(&regions[at], region, owner, supplied) { return true }
    at = at + usize.ONE
  }
  return false
}

// Whether some constituent of the meet `bound` is a region local to `owner`'s body.
fn meetHoldsLocal(bound: &Shared<Lifetime>, owner: &DeclarationId) -> bool {
  let count = Lifetime.atomCount(bound)
  let mut at = usize.ZERO
  while at < count {
    if regionLocal(&Lifetime.atomAt(bound, at), owner) { return true }
    at = at + usize.ONE
  }
  return false
}

// Whether `atom` is one of the descriptor lifetimes a reborrow's parent meet is made of.
fn meetMember(bound: &Shared<Lifetime>, atom: &Shared<Lifetime>) -> bool {
  let count = Lifetime.atomCount(bound)
  let mut at = usize.ZERO
  while at < count {
    let member = Lifetime.atomAt(bound, at)
    if Lifetime.equalsShared(&member, atom) { return true }
    at = at + usize.ONE
  }
  return false
}

// Whether `site` lies in an operand whose loans its call's result cannot hold. A
// `return` or a store nested in that operand sends its own value elsewhere, so a site inside one is
// decided there, not by the call.
fn unheldSite<'proof>(sources: &EscapeSources<'proof>, site: Location) -> bool {
  let unheld = sources.unheld
  let mut at = usize.ZERO
  while at < unheld.length {
    if within(site, unheld[at]) && !nestedWindow(sources.returns, site, unheld[at])
      && !nestedWindow(sources.stores, site, unheld[at]) { return true }
    at = at + usize.ONE
  }
  return false
}

fn within(inner: Location, outer: Location) -> bool {
  return inner.start >= outer.start && inner.end <= outer.end
}

// Whether one of `windows` lies within `operand` and holds `site`.
fn nestedWindow(windows: &[StoreWindow], site: Location, operand: Location) -> bool {
  let mut at = usize.ZERO
  while at < windows.length {
    if within(windows[at].span, operand) && within(site, windows[at].span) { return true }
    at = at + usize.ONE
  }
  return false
}

// Whether a direct call's result can hold what its operand `operand` carries: typing lists the
// arguments the callee's signature lets its result retain. Any other result, and a loan carried by
// no single operand, may hold it.
fn retainedOperand(nodes: &[Node], result: NodeId, operand: usize) -> bool {
  if let NodeKind.Expression {form: Expression.DirectCall {arguments, retained, ..}, ..} = &nodes[result.index].kind {
    let operands = List<NodeId>.asSlice(&arguments)
    if operand >= operands.length { return true }
    let listed = List<NodeId>.asSlice(&retained)
    let mut at = usize.ZERO
    while at < listed.length {
      if listed[at].index == operands[operand].index { return true }
      at = at + usize.ONE
    }
    return false
  }
  return true
}

// Whether typing requires one of `regions` to outlive one of `named`: a relation offers a region of
// the loan and wants a region of the result.
fn outlivesResult(relations: &[ImpliedGroup], regions: &[Shared<Lifetime>], named: &[Shared<Lifetime>]) -> bool {
  let mut at = usize.ZERO
  while at < relations.length {
    if sharesAtom(List<Shared<Lifetime>>.asSlice(&relations[at].members), regions)
      && sharesAtom(List<Shared<Lifetime>>.asSlice(&relations[at].container), named) { return true }
    at = at + usize.ONE
  }
  return false
}

// Operation-wide facts are sampled before the per-carry loop. The loan supplied to
// resultDecision is sampled at that carry, after all preceding carries' effects.

// Explicit effects of the result policy. Keeping a source never repairs prior precision.

// One actual physical operand/component/loan position. Histories are already normalized by
// SourceAnalysis; quality names the operation's pre-result observation, not final-body state.
struct SourceResultInput {
  loan: usize
  operand: usize
  quality: SourceQuality
}
impl Copy for SourceResultInput {}

struct SourceResultSnapshot {
  required: List<SourceAtom>
  parents: List<SourceAtom>
  naming: SourceNaming
  complete: SourceAtom
}

// One paired history at a physical position. The incoming precision is the position's P
// version, shared by its histories; field/direct/read evidence must not be unioned first.
struct SourceResultCase {
  quality: SourceQuality
  operand: usize
  retained: bool
  field: usize
  wholeField: bool
  declared: SourceAtom
}

struct SourceResultFacts {
  stores: bool
  known: bool
  outside: bool
  forwarding: Forwarding
  placedCount: usize
  // These retain the actual operation-wide implied/whole-hold observation gates.
  impliedKnown: SourceAtom
  mayOutlive: SourceAtom
  hasTyped: bool
}

// A reserved result transfer and its exact incoming history. The port comes from Builder;
// declared is independently authenticated by original ResultBorrow/descriptor provenance.
// Merely having a ContractRoute never supplies that predicate.
struct SourceResultRoute {
  position: usize
  history: usize
  policy: usize
  field: usize
  wholeField: bool
  declared: SourceAtom
  active: SourceAtom
  quality: SourceQuality
  reset: Option<SourceAtom>
  ordinary: bool
}

struct SourceResultEffect {
  source: SourceEffectSource
  policy: usize
  target: SourceGraph.ValueId
  field: usize
  direct: bool
  quality: SourceQuality
  whole: SourceAtom
  described: SourceAtom
}

struct SourcePositionResult {
  result: SourceGraph.EvalId
  position: usize
  source: SourceEffectSource
  decision: SourcePolicy.ResultOutput
  missing: SourceAtom
}

struct SourceResultScan {
  inputs: List<SourcePositionResult>
  outputs: List<SourceResultEffect>
  missing: SourceAtom
  ordinaryMissing: SourceAtom
}

struct SourceFinishEffects {
  retention: List<SourceRetentionEffect>
  written: List<SourceEscapeEffect>
  intervals: List<SourceIntervalEffect>
  inputResults: List<SourcePositionResult>
  results: List<SourceResultEffect>
  wholeHolds: List<SourceWholeHold>
  sealed: List<Location>
  unheld: List<Location>
  missing: SourceAtom
}

fn sourceNodeValueRoot<'body>(prepared: &PreparedSources.SourcePreparation<'body>, node: NodeId)
  -> PreparedSources.EndpointId {
  let endpoints = List<PreparedSources.Endpoint>.asSlice(&prepared.endpoints)
  let mut found = usize.MAX
  let mut at = usize.ZERO
  while at < endpoints.length {
    let whole = match endpoints[at].parent { Option<PreparedSources.EndpointId>.None => true _ => false }
    let matches = match &endpoints[at].root {
      PreparedSourcesRoot.Node {node: actual, category} => category == PreparedSourcesEndpointRole.Value && actual.index == node.index
      _ => false
    }
    if whole && matches {
      if found != usize.MAX { return CompilerBug.panic(b"actual value has duplicate prepared physical roots") }
      found = at
    }
    at = at + usize.ONE
  }
  if found == usize.MAX { return CompilerBug.panic(b"actual value has no prepared physical root") }
  return PreparedSources.EndpointId {index: found}
}

// Aggregates, rvalue projections and short-circuit operators finish their written operands.
// Shape supplies ownership forwarding/placement; authentic graph transfers supply publication.
// A repeated array's one physical input stays one input, with RepeatedElement placement.
effect fn sourceFinishOperands<'body>(builder: &mut SourceGraphBuilder<'body>, actual: &SourceVisit.Visit,
  directive: &SourceGraph.ResultUse, state: &mut SourceLoanState, loans: &[Loan], paths: &mut List<List<Step>>,
  context: &RetentionContext, prior: &[SourceWholeHold]) -> SourceFinishEffects ! OutOfMemoryError ? &mut Allocator | &mut Types {
  if directive.evaluation.index != actual.evaluation.index {
    return CompilerBug.panic(b"operand finish substituted another actual result")
  }
  match directive.kind {
    SourceGraphResultKind.Physical => ()
    _ => { return CompilerBug.panic(b"operand finish requires its physical result directive") }
  }
  let nodes = SourceGraphBuilder.preparation(&builder.*).body.nodes
  let owner = SourceGraphBuilder.preparation(&builder.*).body.owner
  let supplied = SourceGraphBuilder.preparation(&builder.*).body.supplied
  let mut values = List<NodeId>.make()
  let mut placed = List<List<Step>>.make()
  let mut forwarding = Forwarding.None
  let mut projection = Option<Path>.none()
  let mut fieldOperand = false
  match move run shapeOf(nodes, actual.node) {
    Shape.Operands {values: inputs, places, member} => {
      values = move inputs
      placed = run operandPlacements(nodes, actual.node, List<usize>.asSlice(&places), member)
      forwarding = Forwarding.Operands
    }
    Shape.ShortCircuit {left, right} => {
      run List<NodeId>.append(&mut values, left)
      run List<NodeId>.append(&mut values, right)
    }
    Shape.ReadPlace => {
      // A field attributes its incoming value before the ordinary operand finish.
      // Dereference/index retain the original unplaced forwarding behavior.
      match &nodes[actual.node.index].kind {
        NodeKind.Expression {form: Expression.Field {value, ..}, ..} => {
          fieldOperand = true
          run List<NodeId>.append(&mut values, value)
          run List<List<Step>>.append(&mut placed, List<Step>.make())
          projection = Option<Path>.some(run temporaryPath(nodes, actual.node, value))
        }
        NodeKind.Expression {form: Expression.Dereference {value}, ..} => {
          run List<NodeId>.append(&mut values, value)
        }
        NodeKind.Expression {form: Expression.Index {value, index, ..}, ..} => {
          run List<NodeId>.append(&mut values, value)
          run List<NodeId>.append(&mut values, index)
        }
        _ => { return CompilerBug.panic(b"rvalue operand finish selected a named place") }
      }
      forwarding = Forwarding.Operands
    }
    _ => { return CompilerBug.panic(b"operand finish selected another ownership handler") }
  }
  let written = List<NodeId>.asSlice(&values)
  let inputs = List<SourceVisit.Input>.asSlice(&actual.inputs)
  if inputs.length != written.length { return CompilerBug.panic(b"operand finish lost its actual written input order") }
  let mut operands = List<SourceOperand>.make()
  let mut at = usize.ZERO
  while at < inputs.length {
    let input = sourceAccessInput(actual, at, written[at])
    let mut admitted = false
    let sources = List<SourceGraph.EvalId>.asSlice(&directive.sources)
    let mut each = usize.ZERO
    while each < sources.length {
      if sources[each].index == input.evaluation.index { admitted = true }
      each = each + usize.ONE
    }
    if !admitted { return CompilerBug.panic(b"operand result directive omitted a genuine physical input") }
    let root = sourceNodeValueRoot(SourceGraphBuilder.preparation(&builder.*), input.node)
    run List<SourceOperand>.append(&mut operands, SourceOperand {
      node: input.node, evaluation: input.evaluation, root: root, ordinal: at})
    at = at + usize.ONE
  }
  let mut completion = Option<usize>.none()
  if fieldOperand {
    let suppliedOperands = List<SourceOperand>.asSlice(&operands)
    if suppliedOperands.length != usize.ONE {
      return CompilerBug.panic(b"Field semantic observation lost its sole actual operand")
    }
    let input = suppliedOperands[usize.ZERO]
    completion = sourceOrdinaryResultDemand(&builder.*, input.evaluation, input.root, false, Forwarding.None)
  }
  let mut observation = run sourceObserve(&mut builder.*, List<SourceOperand>.asSlice(&operands),
    SourceGraphValuePhase.Output, &mut paths.*, loans.length, false, completion)
  if let Option<Path>.Some {value: path} = move projection {
    let declared = run declaredRead(nodes, actual.node, owner)
    run sourceSelectFields(nodes, owner, &path, &declared, &mut observation, &mut state.*, loans,
      &mut paths.*, context, prior, directive.active, &mut builder.rules)
  }
  let root = sourceNodeValueRoot(SourceGraphBuilder.preparation(&builder.*), actual.node)
  let untyped = List<NodeId>.make()
  let sinks = List<OperandSink>.make()
  return run sourceFinish(&mut builder.*, &observation, &mut state.*, loans, &mut paths.*, nodes, owner,
    supplied, List<RetentionEdge>.asSlice(&context.requirements), List<ImpliedGroup>.asSlice(&context.relations),
    context.settled, actual.node, actual.evaluation, root, actual.execute.index, directive.active, false,
    forwarding, List<List<Step>>.asSlice(&placed), List<NodeId>.asSlice(&untyped), List<OperandSink>.asSlice(&sinks))
}

// Joining observations preserves physical operand/component order. Alternative source
// histories remain inside their original positions and never become additional operands.
effect fn sourceAppendObservation(target: &mut SourceObservation, incoming: SourceObservation,
  rules: &mut SourceProgram) -> () ! OutOfMemoryError ? &mut Allocator {
  let unknown: [SourceAtom; 2] = [target.unknown, incoming.unknown]
  target.unknown = run SourcePolicy.disjunction(&mut rules.*, &unknown)
  let mut positions = move incoming.positions
  while List<SourceCarryPosition>.length(&positions) != usize.ZERO {
    run List<SourceCarryPosition>.append(&mut target.positions, List<SourceCarryPosition>.remove(&mut positions, usize.ZERO))
  }
  let mut other = move incoming.other
  while List<SourceGraph.Input>.length(&other) != usize.ZERO {
    run List<SourceGraph.Input>.append(&mut target.other, List<SourceGraph.Input>.remove(&mut other, usize.ZERO))
  }
  return ()
}

fn sourceVisitAt(visits: &[SourceVisit.Visit], evaluation: SourceGraph.EvalId) -> &SourceVisit.Visit {
  let mut found = usize.MAX
  let mut at = usize.ZERO
  while at < visits.length {
    if visits[at].evaluation.index == evaluation.index {
      if found != usize.MAX { return CompilerBug.panic(b"ownership dispatch has duplicate actual visits") }
      found = at
    }
    at = at + usize.ONE
  }
  if found == usize.MAX { return CompilerBug.panic(b"ownership dispatch lost its actual visit") }
  return &visits[found]
}

// An implicitly borrowed input is its actual acquisition descriptor, including the
// separately authenticated held ownership sources. Referent contents are not an extra
// argument, and no prefix is reconstructed from the earlier operand's published value.
effect fn sourceCallInput<'body>(builder: &mut SourceGraphBuilder<'body>, actual: &SourceVisit.Visit,
  input: SourceVisit.Input, ordinal: usize, acquired: &[SourceInputAcquisition], paths: &mut List<List<Step>>,
  loans: usize) -> SourceObservation ! OutOfMemoryError ? &mut Allocator {
  let mut selected = usize.MAX
  let mut at = usize.ZERO
  while at < acquired.length {
    if acquired[at].result.index == actual.evaluation.index && acquired[at].input.index == input.evaluation.index {
      if selected != usize.MAX { return CompilerBug.panic(b"call input has two implicit descriptor acquisitions") }
      selected = at
    }
    at = at + usize.ONE
  }
  if selected == usize.MAX {
    let root = sourceNodeValueRoot(SourceGraphBuilder.preparation(&builder.*), input.node)
    let operands: [SourceOperand; 1] = [SourceOperand {node: input.node, evaluation: input.evaluation, root: root, ordinal: ordinal}]
    return run sourceObserve(&mut builder.*, &operands, SourceGraphValuePhase.Output, &mut paths.*, loans, false, Option<usize>.none())
  }
  let borrowed = acquired[selected]
  if let SourceInputAcquisitionKind.CaptureReborrow {..} = borrowed.kind {
    return CompilerBug.panic(b"call input substituted a callable capture reborrow")
  }
  let maps = List<PreparedSources.SelectionMap>.asSlice(&SourceGraphBuilder.preparation(&builder.*).maps)
  let descriptor = maps[borrowed.map.index].target
  let acquisition = SourceGraphBuilder.evaluation(&builder.*, borrowed.acquisition)
  if acquisition.point.index != input.usePoint.index || borrowed.loan >= loans {
    return CompilerBug.panic(b"implicit call descriptor moved past its original input use")
  }
  let inputs: [SourceOperand; 1] = [SourceOperand {node: input.node, evaluation: borrowed.acquisition, root: descriptor, ordinal: ordinal}]
  let mut observed = run sourceObserve(&mut builder.*, &inputs, SourceGraphValuePhase.Output, &mut paths.*, loans, false, Option<usize>.none())
  let mut gaps = List<SourceAtom>.make()
  run List<SourceAtom>.append(&mut gaps, observed.unknown)
  at = usize.ZERO
  while at < SourceGraphBuilder.referenceCoverage(&builder.*).length {
    let coverage = SourceGraphBuilder.referenceCoverage(&builder.*)[at]
    let reference = SourceGraphBuilder.reference(&builder.*, coverage.reference)
    if SourceGraphBuilder.value(&builder.*, reference.descriptor).evaluation.index == borrowed.acquisition.index {
      run List<SourceAtom>.append(&mut gaps, coverage.missing)
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < SourceGraphBuilder.referenceHoldingCoverage(&builder.*).length {
    let coverage = SourceGraphBuilder.referenceHoldingCoverage(&builder.*)[at]
    let reference = SourceGraphBuilder.reference(&builder.*, coverage.reference)
    if SourceGraphBuilder.value(&builder.*, reference.descriptor).evaluation.index == borrowed.acquisition.index {
      run List<SourceAtom>.append(&mut gaps, coverage.missing)
    }
    at = at + usize.ONE
  }
  observed.unknown = run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&gaps))
  return move observed
}

struct SourceCallEffects {
  finished: SourceFinishEffects
  stored: SourceStoreEffects
}

// Immediate execution retains the original argument positions for finish, while the
// receiver has its own current source precision. Import that actual Q before the result
// snapshot, even when the result inventory has no candidate. This is not another finish
// input or keepCarried operation.
effect fn sourceExecutionReceiver<'body>(builder: &mut SourceGraphBuilder<'body>, evaluation: SourceGraph.EvalId,
  state: &mut SourceLoanState, paths: &mut List<List<Step>>, loanCount: usize) -> SourceAtom
! OutOfMemoryError ? &mut Allocator {
  let operations = List<SourceResults.Operation>.asSlice(&SourceGraphBuilder.operationResults(&builder.*).operations)
  let mut operation = usize.MAX
  let mut at = usize.ZERO
  while at < operations.length {
    if operations[at].evaluation.index == evaluation.index {
      if operation != usize.MAX { return CompilerBug.panic(b"execution receiver has duplicate actual operations") }
      operation = at
    }
    at = at + usize.ONE
  }
  if operation == usize.MAX { return CompilerBug.panic(b"execution receiver lost its actual operation") }
  let execute = operations[operation].execute
  let selected = run sourceInvocationOperands(&builder.*, operation)
  let current = List<SourceInvocationOperand>.asSlice(&selected)
  let mut operands = List<SourceOperand>.make()
  at = usize.ZERO
  while at < current.length {
    if current[at].receiver { run List<SourceOperand>.append(&mut operands, current[at].operand) }
    at = at + usize.ONE
  }
  let active = List<SourceControl.Point>.asSlice(&builder.reaching.points)[execute.index].reachable
  if List<SourceOperand>.length(&operands) == usize.ZERO { return active }
  let observation = run sourceObserve(&mut builder.*, List<SourceOperand>.asSlice(&operands),
    SourceGraphValuePhase.Output, &mut paths.*, loanCount, false, Option<usize>.none())
  drop run sourceBarrier(&observation, &mut state.*, active, &mut builder.rules)
  let empty = List<SourceAtom>.make()
  let unknown: [SourceAtom; 2] = [active, observation.unknown]
  return run SourcePolicy.conjunction(&mut builder.rules, &unknown, List<SourceAtom>.asSlice(&empty))
}

// Ordinary calls and callable invocations share the post-arguments finish barrier. A Run
// uses the actual originating occurrence retained by Stores, never the last matching NodeId.
// Both write families bind before the single whole-holder observation at this execution.
effect fn sourceCall<'body>(builder: &mut SourceGraphBuilder<'body>, visits: &[SourceVisit.Visit], actual: &SourceVisit.Visit,
  directive: &SourceGraph.ResultUse, acquired: &[SourceInputAcquisition], state: &mut SourceLoanState,
  loans: &[Loan], geometry: &[SourceLoanGeometry], owners: &[SourceVisit.Owner], paths: &mut List<List<Step>>, context: &RetentionContext,
  captures: &[SourceCaptureEffect], holders: &mut SourceHolderProjection, ancestry: &SourceReadAncestries)
  -> SourceCallEffects ! OutOfMemoryError ? &mut Allocator | &mut Types {
  if actual.evaluation.index != directive.evaluation.index { return CompilerBug.panic(b"call dispatch changed its actual result") }
  let nodes = SourceGraphBuilder.preparation(&builder.*).body.nodes
  let locals = SourceGraphBuilder.preparation(&builder.*).body.locals
  let owner = SourceGraphBuilder.preparation(&builder.*).body.owner
  let supplied = SourceGraphBuilder.preparation(&builder.*).body.supplied
  let mut arguments = List<NodeId>.make()
  let mut typed = List<NodeId>.make()
  let mut callee = Option<NodeId>.none()
  let mut stores = false
  match move run shapeOf(nodes, actual.node) {
    Shape.Call {arguments: values, exact, signature, ..} => {
      arguments = move values
      stores = exact
      if signature { typed = run copyIds(List<NodeId>.asSlice(&arguments)) }
    }
    Shape.Invoke {callee: target, arguments: values, ..} => {
      arguments = move values
      callee = Option<NodeId>.some(target)
    }
    _ => { return CompilerBug.panic(b"call dispatch selected another ownership handler") }
  }
  let mut originating = actual.evaluation
  let mut storedOperation = usize.MAX
  let operations = List<SourceStores.Operation>.asSlice(&SourceGraphBuilder.stores(&builder.*).operations)
  let mut at = usize.ZERO
  while at < operations.length {
    if operations[at].evaluation.index == actual.evaluation.index {
      if storedOperation != usize.MAX { return CompilerBug.panic(b"actual call has duplicate retained-write operations") }
      storedOperation = at
      originating = operations[at].originating
    }
    at = at + usize.ONE
  }
  let origin = sourceVisitAt(visits, originating)
  let inputs = List<SourceVisit.Input>.asSlice(&origin.inputs)
  let args = List<NodeId>.asSlice(&arguments)
  let no = SourceProgram.atom(&mut builder.rules)
  let mut observation = SourceObservation {positions: List<SourceCarryPosition>.make(), other: List<SourceGraph.Input>.make(), unknown: no}
  let mut seen = List<usize>.make()
  at = usize.ZERO
  while at < inputs.length {
    let input = inputs[at]
    let ordinal = match input.read {
      Option<PreparedSourcesInputRead>.Some {value: PreparedSourcesInputRead.Argument {ordinal}} => ordinal
      Option<PreparedSourcesInputRead>.Some {value: PreparedSourcesInputRead.Receiver} =>
        match callee { Option<NodeId>.Some {..} => args.length _ => usize.ZERO }
      _ => { return CompilerBug.panic(b"call input has no actual argument or receiver coordinate") }
    }
    let mut expectedNode = Option<NodeId>.none()
    if ordinal < args.length { expectedNode = Option<NodeId>.some(args[ordinal]) } else { expectedNode = callee }
    let expected = match expectedNode {
      Option<NodeId>.Some {value} => value
      _ => { return CompilerBug.panic(b"call input names an absent argument") }
    }
    if input.node.index != expected.index || listsIndex(List<usize>.asSlice(&seen), ordinal) {
      return CompilerBug.panic(b"call input changed or repeated its actual operand coordinate")
    }
    run List<usize>.append(&mut seen, ordinal)
    let observed = run sourceCallInput(&mut builder.*, origin, input, ordinal, acquired, &mut paths.*, loans.length)
    run sourceAppendObservation(&mut observation, move observed, &mut builder.rules)
    at = at + usize.ONE
  }
  let expected = args.length + match callee { Option<NodeId>.Some {..} => usize.ONE _ => usize.ZERO }
  if List<usize>.length(&seen) != expected { return CompilerBug.panic(b"call dispatch omitted an actual operand") }
  let sinks = run operandSinks(nodes, actual.node, args, owner)
  let placed = List<List<Step>>.make()
  let root = sourceNodeValueRoot(SourceGraphBuilder.preparation(&builder.*), actual.node)
  let mut currentMissing = no
  if originating.index != actual.evaluation.index {
    currentMissing = run sourceExecutionReceiver(&mut builder.*, actual.evaluation, &mut state.*, &mut paths.*, loans.length)
  }
  let mut finished = run sourceFinish(&mut builder.*, &observation, &mut state.*, loans, &mut paths.*, nodes, owner,
    supplied, List<RetentionEdge>.asSlice(&context.requirements), List<ImpliedGroup>.asSlice(&context.relations),
    context.settled, actual.node, actual.evaluation, root, actual.execute.index, directive.active, stores,
    Forwarding.None, List<List<Step>>.asSlice(&placed), List<NodeId>.asSlice(&typed), List<OperandSink>.asSlice(&sinks))
  let missing: [SourceAtom; 2] = [finished.missing, currentMissing]
  finished.missing = run SourcePolicy.disjunction(&mut builder.rules, &missing)
  let mut stored = SourceStoreEffects {intervals: List<SourceIntervalEffect>.make(), refusal: no, missing: no}
  let mut usedHolders = List<usize>.make()
  if storedOperation != usize.MAX {
    stored = run sourceStoreIntoLent(&mut builder.*, storedOperation, loans, geometry, locals, &mut paths.*, owner,
      List<RetentionEdge>.asSlice(&context.requirements), &mut usedHolders, ancestry)
  }
  if !stores {
    run sourceThroughExclusive(&mut builder.*, actual.evaluation, &mut state.*, captures,
      loans, geometry, owners, locals, owner, &mut paths.*, &mut usedHolders, &mut stored)
  }
  // Retained and invocation writes can name the same canonical holder. The real current
  // read observes all old components once under holder.active, after both families bind.
  let used = List<usize>.asSlice(&usedHolders)
  at = usize.ZERO
  while at < used.length {
    run sourceUseWriteHolder(&mut builder.*, used[at], &mut state.*, loans, &mut paths.*, &mut holders.*, &mut stored)
    at = at + usize.ONE
  }
  return SourceCallEffects {finished: move finished, stored: move stored}
}

// One finish operation on the reserved CFG. Retention observes its independent pre-result
// version; consume runs at execute even when no successful result completes. The source graph
// owns output transport, and the ordered result scan only binds its already-reserved ports.
//
// Alias alternatives can share one actual component Value. Join their histories here;
// enumerating another canonical owner must not manufacture a second finish operand.
effect fn sourceJoinThrough(target: &mut SourceObservation, incoming: SourceThroughObservation,
  rules: &mut SourceProgram) -> () ! OutOfMemoryError ? &mut Allocator {
  let empty = List<SourceAtom>.make()
  let none = List<SourceAtom>.asSlice(&empty)
  let gate = incoming.active
  let observation = move incoming.observation
  let required: [SourceAtom; 2] = [gate, observation.unknown]
  let gaps: [SourceAtom; 2] = [target.unknown, run SourcePolicy.conjunction(&mut rules.*, &required, none)]
  target.unknown = run SourcePolicy.disjunction(&mut rules.*, &gaps)
  let mut positions = move observation.positions
  while List<SourceCarryPosition>.length(&positions) != usize.ZERO {
    let mut position = List<SourceCarryPosition>.remove(&mut positions, usize.ZERO)
    let present: [SourceAtom; 2] = [gate, position.quality.present]
    let stored: [SourceAtom; 2] = [gate, position.quality.stored]
    let alternatives: [SourceAtom; 2] = [gate, position.quality.alternatives]
    position.quality = SourceQuality {present: run SourcePolicy.conjunction(&mut rules.*, &present, none),
      stored: run SourcePolicy.conjunction(&mut rules.*, &stored, none),
      alternatives: run SourcePolicy.conjunction(&mut rules.*, &alternatives, none)}
    let histories = List<SourceCarryCase>.asMutSlice(&mut position.cases)
    let mut at = usize.ZERO
    while at < histories.length {
      histories[at].source = run sourceGatedCase(&histories[at].source, gate, &mut rules.*)
      let observed: [SourceAtom; 2] = [gate, histories[at].observed]
      histories[at].observed = run SourcePolicy.conjunction(&mut rules.*, &observed, none)
      at = at + usize.ONE
    }
    let old = List<SourceCarryPosition>.asMutSlice(&mut target.positions)
    at = usize.ZERO
    while at < old.length && (old[at].value.index != position.value.index || old[at].leaf.index != position.leaf.index) {
      at = at + usize.ONE
    }
    if at == old.length { run List<SourceCarryPosition>.append(&mut target.positions, move position) }
    else {
      if old[at].loan != position.loan || old[at].operand != position.operand || old[at].since != position.since {
        return CompilerBug.panic(b"through alternatives changed their actual finish position")
      }
      let present: [SourceAtom; 2] = [old[at].quality.present, position.quality.present]
      let stored: [SourceAtom; 2] = [old[at].quality.stored, position.quality.stored]
      let alternatives: [SourceAtom; 2] = [old[at].quality.alternatives, position.quality.alternatives]
      old[at].quality = SourceQuality {present: run SourcePolicy.disjunction(&mut rules.*, &present),
        stored: run SourcePolicy.disjunction(&mut rules.*, &stored),
        alternatives: run SourcePolicy.disjunction(&mut rules.*, &alternatives)}
      run sourceAppendEffects<SourceCarryCase>(&mut old[at].cases, move position.cases)
    }
  }
  run sourceAppendEffects<SourceGraph.Input>(&mut target.other, move observation.other)
  return ()
}

// Replace finishes the original pre-Referent holder flight at the later write point.
// The selected destination snapshot supplies physical data, never this ownership flight.
effect fn sourceFinishThrough<'body>(builder: &mut SourceGraphBuilder<'body>, actual: &SourceVisit.Visit,
  directive: &SourceGraph.ResultUse, state: &mut SourceDispatchProjection, loans: &[Loan],
  paths: &mut List<List<Step>>, context: &RetentionContext) -> ()
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let read = match directive.kind { SourceGraphResultKind.Read {read} => read
    _ => { return CompilerBug.panic(b"through replacement has no original read directive") } }
  let sameRead = match actual.displaced { Option<SourceGraph.EvalId>.Some {value} => value.index == read.index _ => false }
  if !sameRead || directive.evaluation.index != actual.evaluation.index {
    return CompilerBug.panic(b"through replacement substituted its displaced read")
  }
  let empty = List<SourceAtom>.make()
  let none = List<SourceAtom>.asSlice(&empty)
  let uses = List<SourceOrdinaryUse>.asSlice(&state.ordinary)
  let mut accepted = List<SourceAtom>.make()
  let mut at = usize.ZERO
  while at < uses.length {
    if uses[at].writer.index == actual.evaluation.index {
      if uses[at].retained || List<SourceAtom>.length(&accepted) != usize.ZERO {
        return CompilerBug.panic(b"through replacement lost its original write policy")
      }
      run List<SourceAtom>.append(&mut accepted, uses[at].active)
    }
    at = at + usize.ONE
  }
  if List<SourceAtom>.length(&accepted) != usize.ONE {
    return CompilerBug.panic(b"through finish preceded its RHS refusal and write policy")
  }
  let activeGates: [SourceAtom; 2] = [directive.active, List<SourceAtom>.asSlice(&accepted)[0]]
  let active = run SourcePolicy.conjunction(&mut builder.rules, &activeGates, none)
  let mut observed = SourceObservation {positions: List<SourceCarryPosition>.make(),
    other: List<SourceGraph.Input>.make(), unknown: SourceProgram.atom(&mut builder.rules)}
  let mut found = false
  at = usize.ZERO
  while at < SourceGraphBuilder.throughFlightRequests(&builder.*).length {
    let request = SourceGraphBuilder.throughFlightRequests(&builder.*)[at]
    if request.operation.index == actual.evaluation.index && request.kind == SourceGraphThroughFlightKind.Read {
      if found || request.evaluation.index != read.index {
        return CompilerBug.panic(b"through finish changed its exact read flight")
      }
      found = true
      let gaps: [SourceAtom; 2] = [observed.unknown, request.missing]
      observed.unknown = run SourcePolicy.disjunction(&mut builder.rules, &gaps)
      let mut row = usize.ZERO
      while row < SourceGraphBuilder.throughFlightObservations(&builder.*).length {
        let original = SourceGraphBuilder.throughFlightObservations(&builder.*)[row]
        if original.request == at {
          let mut prior = usize.ZERO
          while prior < row {
            let earlier = SourceGraphBuilder.throughFlightObservations(&builder.*)[prior]
            if earlier.request == at && sourceSameStorage(earlier.owner, original.owner) { break }
            prior = prior + usize.ONE
          }
          if prior == row {
            let incoming = run sourceObserveThrough(&mut builder.*, row, &mut paths.*, loans.length)
            run sourceJoinThrough(&mut observed, move incoming, &mut builder.rules)
          }
        }
        row = row + usize.ONE
      }
    }
    at = at + usize.ONE
  }
  if !found { let gaps: [SourceAtom; 2] = [observed.unknown, active]
    observed.unknown = run SourcePolicy.disjunction(&mut builder.rules, &gaps) }
  let prepared = SourceGraphBuilder.preparation(&builder.*)
  let nodes = prepared.body.nodes
  let owner = prepared.body.owner
  let supplied = prepared.body.supplied
  let root = sourceNodeValueRoot(prepared, actual.node)
  let point = SourceGraphBuilder.evaluation(&builder.*, actual.evaluation).point
  let unplaced = List<List<Step>>.make()
  let untyped = List<NodeId>.make()
  let sinks = List<OperandSink>.make()
  let finished = run sourceFinish(&mut builder.*, &observed, &mut state.policy.state, loans, &mut paths.*,
    nodes, owner, supplied, List<RetentionEdge>.asSlice(&context.requirements), List<ImpliedGroup>.asSlice(&context.relations),
    context.settled, actual.node, actual.evaluation, root, point.index, active, false, Forwarding.None,
    List<List<Step>>.asSlice(&unplaced), List<NodeId>.asSlice(&untyped), List<OperandSink>.asSlice(&sinks))
  run sourceCollectFinish(&mut state.*, move finished, &mut builder.rules)
  return ()
}

// A scalar place read consumes the original holder flight without invoking result
// retention, declaration admission or escape publication. ReadFlight was reserved at
// this exact read occurrence before Flow emission; aliases of one owner share inputs.
effect fn sourceScalarFlight<'body>(builder: &mut SourceGraphBuilder<'body>, evaluation: SourceGraph.EvalId,
  point: SourceControl.PointId, span: Location, active: SourceAtom, excludeShadowed: bool, state: &mut SourceDispatchProjection,
  loans: &[Loan], paths: &mut List<List<Step>>) -> () ! OutOfMemoryError ? &mut Allocator {
  if SourceGraphBuilder.evaluation(&builder.*, evaluation).point.index != point.index {
    return CompilerBug.panic(b"scalar consume left its actual read point")
  }
  let empty = List<SourceAtom>.make()
  let none = List<SourceAtom>.asSlice(&empty)
  let mut covered = List<SourceAtom>.make()
  let mut at = usize.ZERO
  while at < SourceGraphBuilder.readFlightObservations(&builder.*).length {
    let row = SourceGraphBuilder.readFlightObservations(&builder.*)[at]
    if row.evaluation.index == evaluation.index {
      let mut prior = usize.ZERO
      while prior < at {
        let earlier = SourceGraphBuilder.readFlightObservations(&builder.*)[prior]
        if earlier.evaluation.index == evaluation.index && sourceSameStorage(earlier.owner, row.owner) { break }
        prior = prior + usize.ONE
      }
      if prior == at {
        let mut observed = run sourceObserveReadFlight(&mut builder.*, at, &mut paths.*, loans.length)
        run List<SourceAtom>.append(&mut covered, observed.active)
        let gates: [SourceAtom; 2] = [active, observed.active]
        let used = run SourcePolicy.conjunction(&mut builder.rules, &gates, none)
        let no = SourceProgram.atom(&mut builder.rules)
        let mut effects = SourceStoreEffects {intervals: List<SourceIntervalEffect>.make(), refusal: no, missing: no}
        run sourceRecordReadAlternatives(&mut builder.*, &observed.observation, SourceSemanticReadOrigin.Flight {observation: at},
          evaluation, span, used, &mut paths.*, &mut state.holders)
        run sourceUseObservedHolder(&mut builder.*, &observed.observation, row.owner, evaluation,
          Option<SourceVisit.OwnerId>.none(), used, &mut state.policy.state, &mut state.holders, &mut effects)
        if excludeShadowed { run sourceScalarRead(&mut builder.*, &mut observed.observation) }
        run sourceConsume(&observed.observation, point.index, used, &mut builder.rules, &mut effects.intervals)
        run sourceDispatchMissing(&mut state.*, effects.missing, &mut builder.rules)
        run sourceAppendEffects<SourceIntervalEffect>(&mut state.policy.intervals, move effects.intervals)
      }
    }
    at = at + usize.ONE
  }
  let required: [SourceAtom; 1] = [active]
  let missing = run SourcePolicy.conjunction(&mut builder.rules, &required, List<SourceAtom>.asSlice(&covered))
  run sourceDispatchMissing(&mut state.*, missing, &mut builder.rules)
  return ()
}

// Raw physical descriptor transport remains available to the address graph. A true
// scalar result carries no semantic Borrow and adds no new stored/alternative facts.
effect fn sourceScalarResult<'body>(builder: &mut SourceGraphBuilder<'body>, evaluation: SourceGraph.EvalId)
  -> () ! OutOfMemoryError ? &mut Allocator {
  let no = SourceProgram.atom(&mut builder.rules)
  let mut at = usize.ZERO
  while at < SourceGraphBuilder.policyCount(&builder.*) {
    let port = SourceGraphBuilder.policy(&builder.*, at)
    if port.terminal && SourceGraphBuilder.value(&builder.*, port.target).evaluation.index == evaluation.index {
      let borrowed = match &SourceGraphBuilder.leaf(&builder.*, port.leaf).kind {
        SourceGraphSourceLeaf.Borrow {..} => true _ => false }
      let mut kept = port.quality.present
      if borrowed {
        let projected = run sourcePolicyObservation(&mut builder.*, port.id, Option<usize>.none())
        kept = projected.masked
      }
      run SourceGraphBuilder.bindPolicy(&mut builder.*, port.id, kept, no, no)
    }
    at = at + usize.ONE
  }
  return ()
}

// A scalar read excludes an overwritten Shadowed holding. Inherited copies remain
// distinct values; raw Cases stay available for terminal descriptor policy.
effect fn sourceScalarRead<'body>(builder: &mut SourceGraphBuilder<'body>, observation: &mut SourceObservation) -> ()
! OutOfMemoryError ? &mut Allocator {
  let no = SourceProgram.atom(&mut builder.rules)
  let positions = List<SourceCarryPosition>.asMutSlice(&mut observation.positions)
  let mut at = usize.ZERO
  while at < positions.length {
    let cases = List<SourceCarryCase>.asMutSlice(&mut positions[at].cases)
    let mut present = List<SourceAtom>.make()
    let mut stored = List<SourceAtom>.make()
    let mut alternatives = List<SourceAtom>.make()
    let mut each = usize.ZERO
    while each < cases.length {
      if sourceDisposition(&builder.*, cases[each].source.definition) == SourceGraphSummaryDisposition.Shadowed {
        cases[each].source = run sourceGatedCase(&cases[each].source, no, &mut builder.rules)
      }
      run List<SourceAtom>.append(&mut present, cases[each].source.quality.present)
      run List<SourceAtom>.append(&mut stored, cases[each].source.quality.stored)
      run List<SourceAtom>.append(&mut alternatives, cases[each].source.quality.alternatives)
      each = each + usize.ONE
    }
    positions[at].quality = SourceQuality {
      present: run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&present)),
      stored: run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&stored)),
      alternatives: run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&alternatives))}
    at = at + usize.ONE
  }
  return ()
}

// A Read directive owns one joined incoming component family. Observe that actual Input,
// attribute its canonical placement, then run the ordinary result policy at the separately
// reserved result/use point. Historical definitions never become separate operands, and a
// displaced read does not borrow the enclosing result's successful-completion identity.
effect fn sourceFinishRead<'body>(builder: &mut SourceGraphBuilder<'body>, directive: &SourceGraph.ResultUse,
  readRoot: PreparedSources.EndpointId, outputRoot: PreparedSources.EndpointId, point: usize,
  state: &mut SourceLoanState, loans: &[Loan], paths: &mut List<List<Step>>, nodes: &[Node],
  owner: &DeclarationId, supplied: &[Shared<Lifetime>], requirements: &[RetentionEdge], relations: &[ImpliedGroup],
  settled: bool, prior: &[SourceWholeHold]) -> SourceFinishEffects ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let read = match &directive.kind {
    SourceGraphResultKind.Read {read} => read
    _ => { return CompilerBug.panic(b"read finish requires its explicit semantic result directive") }
  }
  let source = SourceGraphBuilder.evaluation(&builder.*, read)
  let produced = SourceGraphBuilder.evaluation(&builder.*, directive.evaluation)
  let operand = match source.site {
    SourceGraphEvaluationSite.Node {node} => node
    _ => { return CompilerBug.panic(b"read finish cannot attribute an entry parameter as an execution") }
  }
  let result = match produced.site {
    SourceGraphEvaluationSite.Node {node} => node
    _ => { return CompilerBug.panic(b"read finish has no actual result expression") }
  }
  let inputs: [SourceOperand; 1] = [SourceOperand {node: operand, evaluation: read, root: readRoot, ordinal: usize.MAX}]
  let mut observation = run sourceObserve(&mut builder.*, &inputs, SourceGraphValuePhase.Input, &mut paths.*, loans.length, false, Option<usize>.none())
  if !run nodeRetains(nodes, result, owner) { return CompilerBug.panic(b"retaining read finish selected a scalar consumer") }
  let snapshot = run sourceBarrier(&observation, &mut state.*, directive.active, &mut builder.rules)
  let path = run pathOf(nodes, result)
  let declared = run declaredRead(nodes, result, owner)
  drop run sourceAttributeRead(&mut builder.*, &mut observation, path.through, &mut paths.*, nodes, owner,
    loans, List<SourceQuality>.asSlice(&snapshot), &declared, requirements, relations, settled, prior)
  let unplaced = List<List<Step>>.make()
  let untyped = List<NodeId>.make()
  let sinks = List<OperandSink>.make()
  return run sourceFinish(&mut builder.*, &observation, &mut state.*, loans, &mut paths.*, nodes, owner,
    supplied, requirements, relations, settled, result, directive.evaluation, outputRoot, point, directive.active,
    false, Forwarding.Matched, List<List<Step>>.asSlice(&unplaced), List<NodeId>.asSlice(&untyped),
    List<OperandSink>.asSlice(&sinks))
}

// Enumeration coverage is independent of the number of Borrow result ports. Retain each
// actual original contributor and descriptor-case gap, including empty route inventories.
// Complete+empty excludes contract contributors only; it does not assert LoanFree contents.
struct SourceOutputGap {
  active: SourceAtom
  missing: SourceAtom
}
impl Copy for SourceOutputGap {}

// One completed Named call has an independent ordinary whole-ownership demand even
// when it has no candidate or Borrow history. It never substitutes for selected
// provenance, callable channels, or a storing operation.
fn sourceOrdinaryResultDemand<'body>(builder: &SourceGraphBuilder<'body>, evaluation: SourceGraph.EvalId,
  root: PreparedSources.EndpointId, stores: bool, forwarding: Forwarding) -> Option<usize> {
  let demands = SourceGraphBuilder.ordinaryResultDemands(builder)
  let mut selected = Option<usize>.none()
  let mut at = usize.ZERO
  while at < demands.length {
    let demand = demands[at]
    if demand.evaluation.index == evaluation.index {
      if let Option<usize>.Some {..} = selected {
        return CompilerBug.panic(b"ordinary result has duplicate whole-finish demands")
      }
      let operation = &List<SourceResults.Operation>.asSlice(
        &SourceGraphBuilder.operationResults(builder).operations)[demand.operation]
      let directive = &SourceGraphBuilder.resultUses(builder)[demand.result]
      let output = match &operation.plan {
        SourceResultsPlan.NamedInvoke {result, ..} => result
        _ => { return CompilerBug.panic(b"ordinary result changed its named invocation") }
      }
      let prepared = SourceGraphBuilder.preparation(builder)
      let map = &List<PreparedSources.SelectionMap>.asSlice(&prepared.maps)[output.index]
      let endpoint = &List<PreparedSources.Endpoint>.asSlice(&prepared.endpoints)[root.index]
      let declared = match directive.kind { SourceGraphResultKind.Declared => true _ => false }
      let parentless = match endpoint.parent { Option<PreparedSources.EndpointId>.None => true _ => false }
      if stores || forwarding != Forwarding.None || !declared || !parentless
        || List<PreparedSources.Operation>.asSlice(&prepared.operations)[operation.prepared].phase != PreparedSourcesOperationPhase.Invoke
        || operation.evaluation.index != evaluation.index || directive.evaluation.index != evaluation.index
        || demand.output.index != output.index || demand.root.index != root.index || map.target.index != root.index {
        return CompilerBug.panic(b"ordinary result demand changed its actual whole finish")
      }
      selected = Option<usize>.some(at)
    }
    at = at + usize.ONE
  }
  return selected
}

struct SourceResultGaps {
  namedWhole: SourceAtom
  independent: SourceAtom
}

effect fn sourceOperationResultGaps<'body>(builder: &mut SourceGraphBuilder<'body>, evaluation: SourceGraph.EvalId,
  ordinary: Option<usize>) -> SourceResultGaps ! OutOfMemoryError ? &mut Allocator {
  let mut gaps = List<SourceAtom>.make()
  let mut named = List<SourceAtom>.make()
  let mut outputGaps = List<SourceOutputGap>.make()
  let prepared = SourceGraphBuilder.preparation(&builder.*)
  let selections = List<PreparedSources.ContractSelection>.asSlice(&prepared.contractSelections)
  let operations = List<SourceResults.Operation>.asSlice(&SourceGraphBuilder.operationResults(&builder.*).operations)
  let contributors = SourceGraphBuilder.operationContributors(&builder.*)
  let mut at = usize.ZERO
  while at < contributors.length {
    let contributor = contributors[at]
    let actual = &operations[contributor.operation]
    if actual.evaluation.index == evaluation.index {
      let outputs = match &actual.plan { SourceResultsPlan.NamedInvoke {outputs, ..} => List<SourceResults.Output>.asSlice(&outputs)
        _ => { return CompilerBug.panic(b"original result contributor lost its named operation") } }
      let original = &List<SourceResults.Contributor>.asSlice(&outputs[contributor.output].contributors)[contributor.contributor]
      if let PreparedSourcesContractCoverage.Incomplete {..} = &selections[original.selection.index].coverage {
        if run SourceResults.wholeResultContributor(prepared, actual.prepared, outputs[contributor.output].map, original) {
          let mut whole = false
          if let Option<usize>.Some {value: demand} = ordinary {
            whole = SourceGraphBuilder.ordinaryResultDemands(&builder.*)[demand].operation == contributor.operation
          }
          // Inline continuation/member rows are part of this eager whole-call inventory.
          // Their original selections remain incomplete for every actual proof consumer.
          if whole { run List<SourceAtom>.append(&mut named, contributor.active) }
          else { run List<SourceAtom>.append(&mut gaps, contributor.active) }
        }
      }
    }
    at = at + usize.ONE
  }
  let invoked = SourceGraphBuilder.invocationContributors(&builder.*)
  at = usize.ZERO
  while at < invoked.length {
    let contributor = invoked[at]
    if operations[contributor.operation].evaluation.index == evaluation.index {
      if let PreparedSourcesContractCoverage.Incomplete {..} = &selections[contributor.selection.index].coverage {
        run List<SourceAtom>.append(&mut gaps, contributor.active)
      }
    }
    at = at + usize.ONE
  }
  let calls = SourceGraphBuilder.invocationCallContributors(&builder.*)
  let pairs = SourceGraphBuilder.invocationCallPairs(&builder.*)
  at = usize.ZERO
  while at < calls.length {
    let contributor = calls[at]
    let actual = &operations[contributor.operation]
    if actual.evaluation.index == evaluation.index {
      let outputs = match &actual.plan { SourceResultsPlan.CallableInvoke {outputs, ..} => List<SourceResults.Output>.asSlice(&outputs)
        _ => { return CompilerBug.panic(b"callable contributor lost its actual invocation") } }
      let original = &List<SourceResults.Contributor>.asSlice(&outputs[contributor.output].contributors)[contributor.contributor]
      let pair = pairs[contributor.pair]
      if original.selection.index != pair.resultSelection.index || original.projection.index != pair.resultProjection.index
        || !sourceSameContinuation(original.continuation, pair.result) {
        return CompilerBug.panic(b"callable contributor changed its paired original result")
      }
      let resultIncomplete = match &selections[original.selection.index].coverage {
        PreparedSourcesContractCoverage.Incomplete {..} => true _ => false }
      let receiverIncomplete = match &selections[pair.receiverSelection.index].coverage {
        PreparedSourcesContractCoverage.Incomplete {..} => true _ => false }
      if resultIncomplete || receiverIncomplete { run List<SourceAtom>.append(&mut gaps, contributor.active) }
      run List<SourceOutputGap>.append(&mut outputGaps, SourceOutputGap {
        active: contributor.active, missing: pair.outputMissing})
    }
    at = at + usize.ONE
  }
  let missing = SourceGraphBuilder.invocationGaps(&builder.*)
  at = usize.ZERO
  while at < missing.length {
    if operations[missing[at].operation].evaluation.index == evaluation.index {
      run List<SourceAtom>.append(&mut gaps, missing[at].active)
    }
    at = at + usize.ONE
  }
  let outputs = List<SourceOutputGap>.asSlice(&outputGaps)
  let empty = List<SourceAtom>.make()
  at = usize.ZERO
  while at < outputs.length {
    let output: [SourceAtom; 2] = [outputs[at].active, outputs[at].missing]
    run List<SourceAtom>.append(&mut gaps, run SourcePolicy.conjunction(&mut builder.rules, &output, List<SourceAtom>.asSlice(&empty)))
    at = at + usize.ONE
  }
  return SourceResultGaps {
    namedWhole: run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&named)),
    independent: run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&gaps))}
}

// A computed scalar dereference has a value even though ordinary finish retains none
// of its operand's loans. Its producer is admitted only after this exact finish has
// accounted for input, enumeration and route obligations, independently of its output.
effect fn sourceCompleteScalarDereference<'body>(builder: &mut SourceGraphBuilder<'body>,
  result: NodeId, evaluation: SourceGraph.EvalId, root: PreparedSources.EndpointId,
  active: SourceAtom, missing: SourceAtom) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < SourceGraphBuilder.rvalueDereferenceValues(&builder.*).length {
    let candidate = SourceGraphBuilder.rvalueDereferenceValues(&builder.*)[at]
    let target = SourceGraphBuilder.value(&builder.*, candidate.target)
    if target.evaluation.index == evaluation.index {
      if true {
        let directive = &SourceGraphBuilder.resultUses(&builder.*)[candidate.result]
        let selection = &SourceGraphBuilder.selectionUses(&builder.*)[candidate.selection]
        let physical = match directive.kind { SourceGraphResultKind.Physical => true _ => false }
        let genuine = match &SourceGraphBuilder.leaf(&builder.*, candidate.leaf).kind {
          SourceGraphSourceLeaf.LoanFree {node} => node.index == result.index
          _ => false
        }
        let mut operand = false
        let sources = List<SourceGraph.EvalId>.asSlice(&directive.sources)
        let mut each = usize.ZERO
        while each < sources.length {
          if sources[each].index == selection.operand.index { operand = true }
          each = each + usize.ONE
        }
        if !physical || !genuine || !operand || directive.evaluation.index != evaluation.index
          || selection.result.index != evaluation.index || target.endpoint.index != root.index
          || target.phase != SourceGraphValuePhase.Output || !sourcePhysicalValue(target) {
          return CompilerBug.panic(b"scalar dereference finish changed its actual computed result")
        }
      }
      let complete: [SourceAtom; 2] = [active, candidate.applicable]
      let incomplete: [SourceAtom; 1] = [missing]
      run SourceProgram.rule(&mut builder.rules, candidate.accepted, &complete, &incomplete)
    }
    at = at + usize.ONE
  }
  return ()
}

effect fn sourceFinish<'body>(builder: &mut SourceGraphBuilder<'body>, observation: &SourceObservation,
  state: &mut SourceLoanState, loans: &[Loan], paths: &mut List<List<Step>>, nodes: &[Node],
  owner: &DeclarationId, supplied: &[Shared<Lifetime>], requirements: &[RetentionEdge], relations: &[ImpliedGroup],
  settled: bool, result: NodeId, evaluation: SourceGraph.EvalId, root: PreparedSources.EndpointId,
  point: usize, active: SourceAtom, stores: bool, forwarding: Forwarding, placed: &[List<Step>],
  typed: &[NodeId], sinks: &[OperandSink]) -> SourceFinishEffects
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let retained = run nodeRetains(nodes, result, owner)
  let written = run sourceKeepWritten(nodes, owner, result, observation, loans, active, &mut builder.rules)
  let observed = run sourceBarrier(observation, &mut state.*, active, &mut builder.rules)
  let snapshot = List<SourceQuality>.asSlice(&observed)
  let retention = run sourceKeepCarried(observation, snapshot, loans, List<List<Step>>.asSlice(&paths.*),
    owner, sinks, usize.MAX, point, active, &mut builder.rules)
  let empty = List<SourceAtom>.make()
  let unknown: [SourceAtom; 2] = [active, observation.unknown]
  let inputMissing = run SourcePolicy.conjunction(&mut builder.rules, &unknown, List<SourceAtom>.asSlice(&empty))
  let mut effects = SourceFinishEffects {retention: move retention, written: move written, intervals: List<SourceIntervalEffect>.make(),
    inputResults: List<SourcePositionResult>.make(),
    results: List<SourceResultEffect>.make(), wholeHolds: List<SourceWholeHold>.make(),
    sealed: List<Location>.make(), unheld: List<Location>.make(),
    missing: inputMissing}
  let ordinary = sourceOrdinaryResultDemand(&builder.*, evaluation, root, stores, forwarding)
  let enumeration = run sourceOperationResultGaps(&mut builder.*, evaluation, ordinary)
  if !retained { run List<Location>.append(&mut effects.sealed, nodes[result.index].origin.location) }
  if let NodeKind.Expression {form: Expression.DirectCall {arguments, ..}, ..} = &nodes[result.index].kind {
    let operands = List<NodeId>.asSlice(&arguments)
    let mut at = usize.ZERO
    while at < operands.length {
      if !retainedOperand(nodes, result, at) {
        run List<Location>.append(&mut effects.unheld, nodes[operands[at].index].origin.location)
      }
      at = at + usize.ONE
    }
  }
  run sourceConsume(observation, point, active, &mut builder.rules, &mut effects.intervals)
  let declared = run sourceDeclaredSnapshot(&mut builder.*, observation, snapshot, loans, nodes, result)
  let declarations = List<SourceAtom>.asSlice(&declared)
  let mut routeMissing = SourceProgram.atom(&mut builder.rules)
  let routes = run sourceFinishRoutes(&mut builder.*, observation, declarations, nodes, result, evaluation, root,
    retained, &mut paths.*, &mut routeMissing)
  if !retained {
    let missing: [SourceAtom; 4] = [inputMissing, routeMissing, enumeration.independent, enumeration.namedWhole]
    effects.missing = run SourcePolicy.disjunction(&mut builder.rules, &missing)
    run sourceCompleteScalarDereference(&mut builder.*, result, evaluation, root, active, effects.missing)
    return move effects
  }
  let mut regions = List<Shared<Lifetime>>.make()
  let known = run resultRegions(nodes, result, owner, &mut regions)
  let named = List<Shared<Lifetime>>.asSlice(&regions)
  let mut implied = noImplied()
  // This is immutable type evidence. Its use below remains gated by the symbolic unnamed
  // snapshot; computing it does not assert that any candidate source is actually present.
  if known && !stores && typed.length != usize.ZERO {
    implied = run callImplied(nodes, relations, settled, typed, result)
  }
  let no = SourceProgram.atom(&mut builder.rules)
  let facts = SourceResultFacts {stores: stores, known: known, outside: known && externalRegions(named, owner),
    forwarding: forwarding, placedCount: placed.length, impliedKnown: run sourceBoolean(&mut builder.rules, implied.known),
    mayOutlive: no, hasTyped: typed.length != usize.ZERO}
  let produced = SourceGraphBuilder.evaluation(&builder.*, evaluation)
  let completed = List<SourceControl.Point>.asSlice(&builder.reaching.points)[produced.point.index].reachable
  let ordinaryFinish = match ordinary { Option<usize>.Some {..} => true _ => false }
  let scanned = run sourceFinishPositions(&mut builder.*, observation, &mut state.*, snapshot, loans, nodes, owner,
    supplied, requirements, relations, result, evaluation, named, &facts, &implied, declarations, placed, completed,
    List<SourceResultRoute>.asSlice(&routes), ordinaryFinish, &mut paths.*)
  let mut certificate = SourceProgram.atom(&mut builder.rules)
  if let Option<usize>.Some {value: demand} = ordinary {
    let applicable = SourceGraphBuilder.ordinaryResultDemands(&builder.*)[demand].applicable
    let positive: [SourceAtom; 3] = [active, completed, applicable]
    let negative: [SourceAtom; 5] = [inputMissing, routeMissing, enumeration.independent, scanned.missing, scanned.ordinaryMissing]
    // This certificate depends on the complete actual input scan and prepolicy
    // publication prerequisites, never the declared gap or its own output/accepted gate.
    certificate = run SourcePolicy.conjunction(&mut builder.rules, &positive, &negative)
    let completion = SourceGraphBuilder.ordinaryResultDemands(&builder.*)[demand].completion
    let proof: [SourceAtom; 1] = [certificate]
    run SourceProgram.rule(&mut builder.rules, completion, &proof, List<SourceAtom>.asSlice(&empty))
  }
  let namedDemand: [SourceAtom; 1] = [enumeration.namedWhole]
  let alternative: [SourceAtom; 1] = [certificate]
  let namedMissing = run SourcePolicy.conjunction(&mut builder.rules, &namedDemand, &alternative)
  let missing: [SourceAtom; 5] = [inputMissing, routeMissing, enumeration.independent, scanned.missing, namedMissing]
  effects.missing = run SourcePolicy.disjunction(&mut builder.rules, &missing)
  effects.inputResults = move scanned.inputs
  effects.results = move scanned.outputs
  let finished = List<SourceResultEffect>.asSlice(&effects.results)
  let mut at = usize.ZERO
  while at < finished.length {
    run List<SourceWholeHold>.append(&mut effects.wholeHolds, SourceWholeHold {
      loan: finished[at].source.loan, result: result, active: finished[at].whole, described: finished[at].described})
    at = at + usize.ONE
  }
  return move effects
}

fn sourceDefinitionMatches(left: Option<SourceControl.DefinitionId>, right: Option<SourceControl.DefinitionId>) -> bool {
  return match left {
    Option<SourceControl.DefinitionId>.Some {value} => match right { Option<SourceControl.DefinitionId>.Some {value: other} => value.index == other.index _ => false }
    _ => match right { Option<SourceControl.DefinitionId>.None => true _ => false }
  }
}

fn sourceReadMatches(left: Option<SourceControl.ReadId>, right: Option<SourceControl.ReadId>) -> bool {
  return match left {
    Option<SourceControl.ReadId>.Some {value} => match right { Option<SourceControl.ReadId>.Some {value: other} => value.index == other.index _ => false }
    _ => match right { Option<SourceControl.ReadId>.None => true _ => false }
  }
}

// Only the original DirectCall (or its immediate Run) can make the declared-source claim.
// Matching the actual operand position also handles two evaluations of a reused NodeId.
fn sourceDeclaredArgument(nodes: &[Node], result: NodeId, position: &SourceCarryPosition) -> bool {
  let mut call = result
  if let NodeKind.Expression {form: Expression.Run {value, access}, ..} = &nodes[result.index].kind {
    if access == RunAccess.Immediate { call = value }
  }
  if let NodeKind.Expression {form: Expression.DirectCall {arguments, resultBorrows, ..}, ..} = &nodes[call.index].kind {
    let operands = List<NodeId>.asSlice(&arguments)
    if position.operand >= operands.length || operands[position.operand].index != position.node.index { return false }
    let declared = List<ResultBorrow>.asSlice(&resultBorrows)
    let mut at = usize.ZERO
    while at < declared.length {
      if declared[at].argument.index == position.node.index { return true }
      at = at + usize.ONE
    }
  }
  return false
}

fn sourceCaptureRawCell(cell: SourceGraph.InvocationCaptureCell, actual: SourceGraph.CellView) -> bool {
  return cell.cell == actual.id && cell.value.index == actual.value.index && cell.leaf.index == actual.leaf.index
    && cell.category == actual.category && cell.direct == actual.direct
    && sourceDefinitionMatches(cell.definition, actual.definition) && sourceReadMatches(cell.read, actual.read)
}

// A captured reborrow is ownership-only. Its outer descriptor evidence comes from
// the exact original physical capture and paired current Cases, never its loan type.
effect fn sourceCaptureDeclaredSnapshot<'body>(builder: &mut SourceGraphBuilder<'body>, position: &SourceCarryPosition)
  -> SourceAtom ! OutOfMemoryError ? &mut Allocator {
  let mut proofs = List<SourceAtom>.make()
  let empty = List<SourceAtom>.make()
  let none = List<SourceAtom>.asSlice(&empty)
  let histories = List<SourceCarryCase>.asSlice(&position.cases)
  let count = SourceGraphBuilder.captureReborrowDescriptorsAt(&builder.*, position.value).length
  let mut at = usize.ZERO
  while at < count {
    let ordinal = SourceGraphBuilder.captureReborrowDescriptorsAt(&builder.*, position.value)[at]
    let row = SourceGraphBuilder.captureReborrowDescriptors(&builder.*)[ordinal]
    let origin = SourceGraphBuilder.captureReborrows(&builder.*)[row.origin]
    if origin.leaf.index == position.leaf.index && origin.loan == position.loan {
      let current = SourceGraphBuilder.case(&builder.*, row.case).target
      let physical = SourceGraphBuilder.case(&builder.*, row.physicalCase).target
      let original = SourceGraphBuilder.case(&builder.*, row.originalCase).target
      let placement = SourceGraphBuilder.case(&builder.*, row.placementCase)
      let previous = match placement.source { Option<SourceGraph.CellView>.Some {value} => value
        _ => { return CompilerBug.panic(b"captured descriptor placement has no actual predecessor") } }
      let placementId = List<PreparedSources.CaptureReborrow>.asSlice(
        &SourceGraphBuilder.preparation(&builder.*).captureReborrows)[origin.prepared].placement
      let sourceEndpoint = List<PreparedSources.SelectionMap>.asSlice(
        &SourceGraphBuilder.preparation(&builder.*).maps)[placementId.index].source
      let targetEndpoint = List<PreparedSources.SelectionMap>.asSlice(
        &SourceGraphBuilder.preparation(&builder.*).maps)[placementId.index].target
      let originalValue = SourceGraphBuilder.value(&builder.*, original.value)
      let placedValue = SourceGraphBuilder.value(&builder.*, placement.target.value)
      let originalPlacement = match placement.authority {
        SourceGraphTransferAuthority.Physical {map, direction, ..} =>
          map.index == placementId.index && direction == SourceGraphMapDirection.Forward
        _ => false
      }
      if !originalPlacement || !sourceCaptureRawCell(row.current, current) || !sourceCaptureRawCell(row.physical, physical)
        || current.category != SourceGraphSourceRole.Ownership || physical.category != SourceGraphSourceRole.Physical
        || physical.value.index != position.value.index || current.value.index != position.value.index
        || original.category != SourceGraphSourceRole.Physical || previous.id != original.id
        || placement.target.category != SourceGraphSourceRole.Physical
        || originalValue.evaluation.index != origin.source.index || originalValue.endpoint.index != sourceEndpoint.index
        || placedValue.evaluation.index != origin.result.index || placedValue.endpoint.index != targetEndpoint.index {
        return CompilerBug.panic(b"captured reborrow changed its paired outer descriptor history")
      }
      let mut each = usize.ZERO
      while each < histories.length {
        let history = &histories[each]
        if row.case == history.source.case && sourceCaptureCell(row.current, position, history) {
          let raw = SourceGraphBuilder.observationCase(&builder.*, row.physicalCase).raw
          let gates: [SourceAtom; 3] = [row.active, raw.present, history.observed]
          run List<SourceAtom>.append(&mut proofs, run SourcePolicy.conjunction(&mut builder.rules, &gates, none))
        }
        each = each + usize.ONE
      }
    }
    at = at + usize.ONE
  }
  return run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&proofs))
}

// Snapshot Exact and an actual outer descriptor are independent requirements. A known region
// name or an arbitrary contract route cannot turn a nested content source into that descriptor.
effect fn sourceDeclaredSnapshot<'body>(builder: &mut SourceGraphBuilder<'body>, observation: &SourceObservation,
  snapshot: &[SourceQuality], loans: &[Loan], nodes: &[Node], result: NodeId) -> List<SourceAtom>
! OutOfMemoryError ? &mut Allocator {
  let positions = List<SourceCarryPosition>.asSlice(&observation.positions)
  if snapshot.length != positions.length { CompilerBug.panic(b"declared result lost its input snapshot") }
  let yes = run sourceBoolean(&mut builder.rules, true)
  let no = SourceProgram.atom(&mut builder.rules)
  let empty = List<SourceAtom>.make()
  let none = List<SourceAtom>.asSlice(&empty)
  let mut inputs = List<SourceParentInput>.make()
  let mut parents = List<SourceParentEdge>.make()
  let mut at = usize.ZERO
  while at < positions.length {
    let position = &positions[at]
    let actual = SourceGraphBuilder.value(&builder.*, position.value)
    let mut seed = no
    if sourceDeclaredArgument(nodes, result, position) && actual.endpoint.index == position.root.index {
      let prepared = SourceGraphBuilder.preparation(&builder.*)
      let endpoints = List<PreparedSources.Endpoint>.asSlice(&prepared.endpoints)
      let shapes = List<PreparedSources.Shape>.asSlice(&prepared.shapes)
      let outer = match &shapes[endpoints[actual.endpoint.index].shape.index].state {
        PreparedSourcesShapeState.Reference => true
        PreparedSourcesShapeState.Slice => true
        _ => false
      }
      if outer {
        seed = run sourceCaptureDeclaredSnapshot(&mut builder.*, position)
        if let Option<SourceGraph.ReferenceOrigin>.Some {value: origin} = SourceGraphBuilder.referenceOrigin(&builder.*, position.leaf) {
          let descriptor = SourceGraphBuilder.value(&builder.*, origin.descriptor)
          let created = match &SourceGraphBuilder.leaf(&builder.*, origin.leaf).kind {
            SourceGraphSourceLeaf.Borrow {loan, ..} => loan == position.loan
            _ => false
          }
          if created && descriptor.endpoint.index == SourceGraphBuilder.leaf(&builder.*, position.leaf).endpoint.index {
            let histories = List<SourceCarryCase>.asSlice(&position.cases)
            let mut descriptors = List<SourceAtom>.make()
            let mut each = usize.ZERO
            while each < histories.length {
              if histories[each].source.category == SourceGraphSourceRole.Physical {
                let raw = SourceGraphBuilder.observationCase(&builder.*, histories[each].source.case).raw
                run List<SourceAtom>.append(&mut descriptors, raw.present)
              }
              each = each + usize.ONE
            }
            run List<SourceAtom>.append(&mut descriptors, seed)
            seed = run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&descriptors))
          }
        }
      }
    }
    let present: [SourceAtom; 1] = [snapshot[at].present]
    let lost: [SourceAtom; 2] = [snapshot[at].stored, snapshot[at].alternatives]
    let exact = run SourcePolicy.conjunction(&mut builder.rules, &present, &lost)
    run List<SourceParentInput>.append(&mut inputs,
      SourceParentInput {present: snapshot[at].present, seed: seed, eligible: exact})
    if let Option<Shared<Lifetime>>.Some {value: parent} = &loans[position.loan].parent {
      let mut candidate = usize.ZERO
      while candidate < positions.length {
        if positions[candidate].operand == position.operand {
          if let Option<Shared<Lifetime>>.Some {value: borrowed} = &loans[positions[candidate].loan].borrowed {
            if meetMember(&parent, &borrowed) {
              run List<SourceParentEdge>.append(&mut parents,
                SourceParentEdge {child: at, parent: candidate, applicable: yes})
            }
          }
        }
        candidate = candidate + usize.ONE
      }
    }
    at = at + usize.ONE
  }
  return run SourcePolicy.parents(&mut builder.rules, yes,
    List<SourceParentInput>.asSlice(&inputs), List<SourceParentEdge>.asSlice(&parents))
}

// Declared output placement follows ResultBorrow's complete field path, never an equal result
// lifetime. The ordinary output route and this indirect declared route remain distinct cases.
fn sourceDeclaredField(nodes: &[Node], result: NodeId, operand: NodeId, field: usize, paths: &[List<Step>]) -> bool {
  if field == usize.MAX || field >= paths.length { return false }
  let mut call = result
  if let NodeKind.Expression {form: Expression.Run {value, access}, ..} = &nodes[result.index].kind {
    if access == RunAccess.Immediate { call = value }
  }
  if let NodeKind.Expression {form: Expression.DirectCall {resultBorrows, ..}, ..} = &nodes[call.index].kind {
    let declared = List<ResultBorrow>.asSlice(&resultBorrows)
    let actual = List<Step>.asSlice(&paths[field])
    let mut at = usize.ZERO
    while at < declared.length {
      let fields = List<usize>.asSlice(&declared[at].fields)
      if declared[at].argument.index == operand.index && fields.length == actual.length {
        let mut each = usize.ZERO
        while each < fields.length && actual[each].kind == StepKind.Field && actual[each].ordinal == fields[each] {
          each = each + usize.ONE
        }
        if each == fields.length { return true }
      }
      at = at + usize.ONE
    }
  }
  return false
}

fn sourceCaptureCell(cell: SourceGraph.InvocationCaptureCell, position: &SourceCarryPosition, history: &SourceCarryCase) -> bool {
  return cell.value.index == position.value.index && cell.leaf.index == position.leaf.index
    && cell.category == history.source.category && cell.direct == history.source.direct && sourceDefinitionMatches(cell.definition, history.source.definition)
    && sourceReadMatches(cell.read, history.source.read)
}

// A policy's incoming alternatives share one raw cell, but keep distinct Case identities.
// Direct forwarding must name the observed alternative, not merely an equal witness tuple.
fn sourcePolicyCase(cases: &[SourceGraph.InputCase], history: &SourceGraph.InputCase) -> bool {
  let mut at = usize.ZERO
  while at < cases.length {
    if cases[at].case == history.case {
      return cases[at].category == history.category && cases[at].direct == history.direct
        && sourceDefinitionMatches(cases[at].definition, history.definition)
        && sourceReadMatches(cases[at].read, history.read)
    }
    at = at + usize.ONE
  }
  return false
}

fn sourceSameContinuation(left: Option<PreparedSources.ContractContinuationId>, right: Option<PreparedSources.ContractContinuationId>) -> bool {
  return match left {
    Option<PreparedSources.ContractContinuationId>.Some {value} => match right {
      Option<PreparedSources.ContractContinuationId>.Some {value: other} => value.index == other.index
      _ => false
    }
    _ => match right { Option<PreparedSources.ContractContinuationId>.None => true _ => false }
  }
}

// A callable's supplied argument belongs to invocation application A. The graph's paired
// receiver origin B permits its result route, but never supplies named-call ResultBorrow
// evidence or substitutes B's declaration/argument ordinals for A's actual input.
effect fn sourceCallableArgument<'body>(builder: &mut SourceGraphBuilder<'body>, port: SourceGraph.PolicyPort,
  candidate: SourceResults.Candidate, cases: &[SourceGraph.InputCase], position: &SourceCarryPosition, history: &SourceCarryCase) -> Option<SourceAtom>
! OutOfMemoryError ? &mut Allocator {
  if let SourceResultsBinding.CallableArgument {input, inputMap, position: actualPosition, channel, proof,
    pair: pairId, receiverProjection, receiverContinuation, resultRoot} = candidate.binding {
    let pair = SourceGraphBuilder.invocationCallPairs(&builder.*)[pairId]
    if pair.channel != channel || pair.origin != proof || pair.receiverProjection.index != receiverProjection.index
      || !sourceSameContinuation(pair.receiver, receiverContinuation) || !sourceSameContinuation(pair.resultRoot, resultRoot)
      || pair.resultProjection.index != candidate.projection.index || pair.resultSelection.index != candidate.selection.index
      || !sourceSameContinuation(pair.result, candidate.continuation) {
      return CompilerBug.panic(b"callable result policy changed its actual receiver/result pair")
    }
    let prepared = SourceGraphBuilder.preparation(&builder.*)
    let operation = &List<PreparedSources.Operation>.asSlice(&prepared.operations)[candidate.operation]
    let route = &List<PreparedSources.InputRoute>.asSlice(&operation.inputs)[input]
    let member = &List<PreparedSources.SelectionMap>.asSlice(&prepared.maps)[inputMap.index]
    let ordinal = match route.read {
      PreparedSourcesInputRead.Argument {ordinal} => ordinal
      _ => { return CompilerBug.panic(b"supplied callable argument acquired receiver input authority") }
    }
    let operations = List<SourceResults.Operation>.asSlice(&SourceGraphBuilder.operationResults(&builder.*).operations)
    let mut found = false
    let mut at = usize.ZERO
    while at < operations.length {
      let actual = &operations[at]
      if actual.evaluation.index == candidate.result.index {
        let inputs = List<SourceResults.Input>.asSlice(&actual.inputs)
        let mut each = usize.ZERO
        while each < inputs.length {
          if inputs[each].route == input && inputs[each].position == actualPosition
            && inputs[each].actual.evaluation.index == candidate.operand.index
            && inputs[each].actual.usePoint.index == candidate.usePoint.index { found = true }
          each = each + usize.ONE
        }
      }
      at = at + usize.ONE
    }
    if !found || member.source.index != candidate.source.index {
      return CompilerBug.panic(b"callable result policy lost its actual supplied input member")
    }
    let value = SourceGraphBuilder.value(&builder.*, position.value)
    if ordinal != position.operand || value.evaluation.index != candidate.operand.index || value.endpoint.index != candidate.source.index
      || port.source.index != position.value.index || port.leaf.index != position.leaf.index
      || port.category != history.source.category || port.direct != history.source.direct || !sourceDefinitionMatches(port.definition, history.source.definition)
      || !sourceReadMatches(port.read, history.source.read) || !sourcePolicyCase(cases, &history.source) { return Option<SourceAtom>.none() }
    let empty = List<SourceAtom>.make()
    let gates: [SourceAtom; 3] = [port.active, pair.active, history.observed]
    return Option<SourceAtom>.some(run SourcePolicy.conjunction(&mut builder.rules, &gates, List<SourceAtom>.asSlice(&empty)))
  }
  return CompilerBug.panic(b"callable argument policy selected another binding kind")
}

// Ordinary whole ownership names an actual argument occurrence and input-family member;
// the result root is semantic placement, not a physical input-to-output correspondence.
fn sourceOrdinaryResultPair<'body>(builder: &SourceGraphBuilder<'body>, candidate: usize,
  port: SourceGraph.PolicyPort, position: &SourceCarryPosition) -> bool {
  let selected = SourceGraphBuilder.ordinaryResultCandidates(builder)[candidate]
  let demand = SourceGraphBuilder.ordinaryResultDemands(builder)[selected.demand]
  let operation = &List<SourceResults.Operation>.asSlice(
    &SourceGraphBuilder.operationResults(builder).operations)[demand.operation]
  let input = List<SourceResults.Input>.asSlice(&operation.inputs)[selected.input]
  let prepared = SourceGraphBuilder.preparation(builder)
  let route = &List<PreparedSources.InputRoute>.asSlice(
    &List<PreparedSources.Operation>.asSlice(&prepared.operations)[operation.prepared].inputs)[selected.route]
  let map = &List<PreparedSources.SelectionMap>.asSlice(&prepared.maps)[selected.sourceMap.index]
  let source = SourceGraphBuilder.value(builder, selected.source)
  let target = SourceGraphBuilder.value(builder, selected.target)
  let whole = match target.subject { Option<SourceGraph.ResidualSubject>.None => true _ => false }
  let ordinal = match route.read {
    PreparedSourcesInputRead.Argument {ordinal} => ordinal
    _ => { return CompilerBug.panic(b"ordinary named result substituted a receiver for its actual argument") }
  }
  if input.route != selected.route || input.position != selected.position
    || input.actual.evaluation.index != selected.operand.index || input.actual.usePoint.index != selected.usePoint.index
    || source.evaluation.index != selected.operand.index || source.endpoint.index != map.source.index
    || source.phase != SourceGraphValuePhase.Output || target.phase != SourceGraphValuePhase.Output || !whole
    || target.evaluation.index != demand.evaluation.index || target.endpoint.index != demand.root.index
    || selected.root.index != demand.root.index || selected.source.index != port.source.index
    || selected.target.index != port.target.index || port.outputRole != SourceGraphSourceRole.Ownership || port.outputDirect {
    return CompilerBug.panic(b"ordinary result changed its actual input or whole output")
  }
  return ordinal == position.operand && input.actual.node.index == position.node.index
    && selected.source.index == position.value.index
}

fn sourceSemanticResult(authority: SourceGraphTransferAuthority) -> bool {
  return match authority {
    SourceGraphTransferAuthority.OrdinaryResult {..} => true
    SourceGraphTransferAuthority.FieldResult {..} => true
    _ => false
  }
}

// Field policy starts with the original operand history. Its postselection field is
// checked later; neither a common cell nor an equal residual substitutes for the
// exact publication from which that history was observed.
fn sourceFieldResultPair<'body>(builder: &SourceGraphBuilder<'body>, candidate: usize,
  port: SourceGraph.PolicyPort, position: &SourceCarryPosition, history: &SourceCarryCase) -> bool {
  let selected = SourceGraphBuilder.fieldResultCandidates(builder)[candidate]
  let directive = &SourceGraphBuilder.resultUses(builder)[selected.result]
  let selection = &SourceGraphBuilder.selectionUses(builder)[selected.selection]
  let source = SourceGraphBuilder.value(builder, selected.source)
  let target = SourceGraphBuilder.value(builder, selected.target)
  let recipe = match port.authority { SourceGraphTransferAuthority.FieldResult {recipe, ..} => recipe
    _ => { return CompilerBug.panic(b"field result paired another terminal authority") } }
  let physical = match directive.kind { SourceGraphResultKind.Physical => true _ => false }
  let whole = match target.subject { Option<SourceGraph.ResidualSubject>.None => true _ => false }
  let map = match selection.value { Option<PreparedSources.MapId>.Some {value} => value
    _ => { return CompilerBug.panic(b"field result lost its actual value selection") } }
  if !physical || !whole || recipe != selected.recipe || map.index != selected.map.index
    || selection.operand.index != source.evaluation.index || selection.result.index != target.evaluation.index
    || directive.evaluation.index != target.evaluation.index
    || source.phase != SourceGraphValuePhase.Output || target.phase != SourceGraphValuePhase.Output
    || target.endpoint.index != selected.root.index
    || selected.source.index != port.source.index || selected.target.index != port.target.index
    || selected.category != port.category || selected.leaf.index != port.leaf.index || selected.direct != port.direct
    || !sourceDefinitionMatches(selected.definition, port.definition) || !sourceReadMatches(selected.read, port.read)
    || port.outputRole != SourceGraphSourceRole.Ownership {
    return CompilerBug.panic(b"field result changed its actual selection or raw source history")
  }
  if selected.source.index != position.value.index || position.operand != usize.ZERO
    || selected.sourceCase != history.source.case { return false }
  return match selected.origin {
    SourceGraphFieldResultSource.Physical => selected.category == SourceGraphSourceRole.Physical
      && match history.publication { Option<usize>.None => true _ => false }
    SourceGraphFieldResultSource.Publication {publication} => match history.publication {
      Option<usize>.Some {value} => value == publication
      _ => false
    }
  }
}

// Read origins reserve structural initial alternatives before A/B policy selects one.
// Only supported, unequal initials prove a Field candidate inapplicable. Unsupported
// placement remains demanded, even if no observed history can pair with it.
effect fn sourceFieldResultDemand<'body>(builder: &SourceGraphBuilder<'body>, candidate: usize,
  paths: &mut List<List<Step>>) -> bool ! OutOfMemoryError ? &mut Allocator {
  let selected = SourceGraphBuilder.fieldResultCandidates(builder)[candidate]
  if let SourceGraphFieldResultSource.Publication {publication} = selected.origin {
    let row = SourceGraphBuilder.ownershipPublications(builder)[publication]
    if row.value.index != selected.source.index || row.leaf.index != selected.leaf.index
      || row.category != selected.category || row.direct != selected.direct
      || !sourceDefinitionMatches(row.definition, selected.definition)
      || !sourceReadMatches(row.read, selected.read)
      || !SourceGraph.sameOwnershipPlacement(row.placement, selected.initial) {
      return CompilerBug.panic(b"field demand changed its exact predecessor publication")
    }
    let origin = SourceGraphBuilder.ownershipOrigins(builder)[row.origin]
    let original = run sourceOwnershipOriginField(builder, origin, &mut paths.*)
    let initial = run sourceOwnershipField(builder, original.root, row.initial, &mut paths.*)
    if original.field.supported && initial.supported {
      return sourceSameField(List<List<Step>>.asSlice(&paths.*), original.field.field, initial.field)
    }
  }
  return true
}

// A current receiver component is not the original argument by identity. The graph retains
// the exact acquisition/copy and every subsequent descriptor/component Case in its finite
// capture product. Pair those histories without adding another physical finish position.
effect fn sourceResultPair<'body>(builder: &mut SourceGraphBuilder<'body>, port: SourceGraph.PolicyPort,
  cases: &[SourceGraph.InputCase], position: &SourceCarryPosition, history: &SourceCarryCase) -> Option<SourceAtom>
! OutOfMemoryError ? &mut Allocator {
  if let SourceGraphTransferAuthority.OrdinaryResult {candidate} = port.authority {
    if !sourceOrdinaryResultPair(&builder.*, candidate, port, position) { return Option<SourceAtom>.none() }
  }
  if let SourceGraphTransferAuthority.OperationResult {candidate, ..} = port.authority {
    if let SourceResultsBinding.CallableArgument {..} = candidate.binding {
      return run sourceCallableArgument(&mut builder.*, port, candidate, cases, position, history)
    }
  }
  if port.source.index == position.value.index && port.leaf.index == position.leaf.index
    && port.category == history.source.category && port.direct == history.source.direct && sourceDefinitionMatches(port.definition, history.source.definition)
    && sourceReadMatches(port.read, history.source.read) && sourcePolicyCase(cases, &history.source) {
    let empty = List<SourceAtom>.make()
    let gates: [SourceAtom; 2] = [port.active, history.observed]
    return Option<SourceAtom>.some(run SourcePolicy.conjunction(&mut builder.rules, &gates, List<SourceAtom>.asSlice(&empty)))
  }
  let candidate = match port.authority {
    SourceGraphTransferAuthority.OperationResult {candidate, ..} => candidate
    _ => { return Option<SourceAtom>.none() }
  }
  let mut paired = List<SourceAtom>.make()
  let empty = List<SourceAtom>.make()
  let none = List<SourceAtom>.asSlice(&empty)
  if let SourceResultsBinding.DescriptorInput {proof, capture, source: binding, producer, ..} = candidate.binding {
    let inputMap = SourceResults.descriptorMap(binding)
    let count = SourceGraphBuilder.invocationCaptureValues(&builder.*).length
    let mut at = usize.ZERO
    while at < count {
      let current = SourceGraphBuilder.invocationCaptureValues(&builder.*)[at]
      let cell = current.current
      if current.capture == capture && cell.value.index == port.source.index && cell.leaf.index == port.leaf.index
        && cell.category == port.category && cell.direct == port.direct && sourceDefinitionMatches(cell.definition, port.definition)
        && sourceReadMatches(cell.read, port.read) {
        let original = SourceGraphBuilder.invocationCaptureSources(&builder.*)[current.source]
        if original.proof == proof && SourceResults.sameDescriptorSource(original.binding, binding)
          && original.producer.index == producer.index {
          let mut matches = false
          match original.acquisition {
            SourceGraphInvocationCaptureAcquisition.Copy {source} => {
              matches = sourceCaptureCell(source, position, history)
                && SourceGraphBuilder.value(&builder.*, source.value).evaluation.index == original.evaluation.index
            }
            SourceGraphInvocationCaptureAcquisition.CaptureReborrow {origin: id, source} => {
              let acquisition = SourceGraphBuilder.captureReborrows(&builder.*)[id]
              if source.value.index != acquisition.descriptor.index || source.leaf.index != acquisition.leaf.index
                || source.category != SourceGraphSourceRole.Ownership || !source.direct
                || acquisition.result.index != original.producer.index
                || acquisition.acquisition.index != original.evaluation.index {
                return CompilerBug.panic(b"invocation capture changed its reborrow acquisition")
              }
              matches = sourceCaptureCell(source, position, history)
                && SourceGraphBuilder.case(&builder.*, history.source.case).target.id == source.cell
            }
            SourceGraphInvocationCaptureAcquisition.Reference {reference: id} => {
              if let SourceResultsDescriptorSource.Environment {..} = binding {
                return CompilerBug.panic(b"literal Environment placement invented an implicit acquisition")
              }
              let reference = SourceGraphBuilder.reference(&builder.*, id)
              matches = reference.source.index == original.evaluation.index && reference.map.index == inputMap.index
                && reference.descriptor.index == position.value.index && reference.leaf.index == position.leaf.index
                && history.source.category == SourceGraphSourceRole.Physical && history.source.direct
                && match history.source.definition { Option<SourceControl.DefinitionId>.None => true _ => false }
                && match history.source.read { Option<SourceControl.ReadId>.None => true _ => false }
            }
            SourceGraphInvocationCaptureAcquisition.Holding {candidate: heldCandidate, case, inputCase, source, output} => {
              let holding = SourceGraphBuilder.referenceHoldings(&builder.*)[heldCandidate]
              if source.value.index != holding.source.index || output.value.index != holding.target.index
                || output.category != SourceGraphSourceRole.Ownership
                || SourceGraphBuilder.value(&builder.*, source.value).evaluation.index != original.evaluation.index {
                return CompilerBug.panic(b"captured holding changed its actual acquisition cells")
              }
              let mut covered = false
              let rows = SourceGraphBuilder.referenceHoldingCoverage(&builder.*)
              let mut row = usize.ZERO
              while row < rows.length {
                if rows[row].referenceRead == holding.referenceRead && rows[row].case == inputCase {
                  if rows[row].source.index != source.value.index || rows[row].leaf.index != source.leaf.index
                    || rows[row].category != source.category || rows[row].direct != source.direct
                    || !sourceDefinitionMatches(rows[row].definition, source.definition)
                    || !sourceReadMatches(rows[row].read, source.read) {
                    return CompilerBug.panic(b"captured holding changed its original incoming Case")
                  }
                  covered = true
                }
                row = row + usize.ONE
              }
              if !covered { return CompilerBug.panic(b"captured holding has no original acquisition obligation") }
              matches = history.source.case == case && sourceCaptureCell(output, position, history)
            }
          }
          if matches {
            let gates: [SourceAtom; 4] = [port.active, original.active, current.active, history.observed]
            run List<SourceAtom>.append(&mut paired, run SourcePolicy.conjunction(&mut builder.rules, &gates, none))
          }
        }
      }
      at = at + usize.ONE
    }
  }
  if List<SourceAtom>.length(&paired) == usize.ZERO { return Option<SourceAtom>.none() }
  return Option<SourceAtom>.some(run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&paired)))
}

struct SourcePolicyObservation {
  quality: SourceQuality
  masked: SourceAtom
}

// Prepolicy source quality excludes masked arrivals without consulting this port's own
// kept atom. Exact direct forwarding selects its predecessor Case; composite authorities
// retain their separately authenticated source correspondence and the current port union.
effect fn sourcePolicyObservation<'body>(builder: &mut SourceGraphBuilder<'body>, port: SourceGraph.PolicyPortId,
  selected: Option<usize>) -> SourcePolicyObservation ! OutOfMemoryError ? &mut Allocator {
  let incoming = run SourceGraphBuilder.policyObservationCases(&mut builder.*, port)
  let cases = List<SourceGraph.ObservationCase>.asSlice(&incoming)
  let mut present = List<SourceAtom>.make()
  let mut stored = List<SourceAtom>.make()
  let mut alternatives = List<SourceAtom>.make()
  let mut masked = List<SourceAtom>.make()
  let mut found = false
  let mut at = usize.ZERO
  while at < cases.length {
    let matches = match selected { Option<usize>.Some {value} => value == cases[at].case _ => true }
    if matches {
      found = true
      run List<SourceAtom>.append(&mut present, cases[at].semantic.present)
      run List<SourceAtom>.append(&mut stored, cases[at].semantic.stored)
      run List<SourceAtom>.append(&mut alternatives, cases[at].semantic.alternatives)
      run List<SourceAtom>.append(&mut masked, cases[at].masked)
    }
    at = at + usize.ONE
  }
  if let Option<usize>.Some {..} = selected {
    if !found { return CompilerBug.panic(b"semantic policy lost its authenticated predecessor Case") }
  }
  return SourcePolicyObservation {quality: SourceQuality {
    present: run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&present)),
    stored: run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&stored)),
    alternatives: run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&alternatives))},
    masked: run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&masked))}
}

// Bind source identities to the graph's actual result transfers. This enumerates existing
// ports only; it cannot invent a contract edge or choose a source from equal region names.
effect fn sourceFinishRoutes<'body>(builder: &mut SourceGraphBuilder<'body>, observation: &SourceObservation,
  declarations: &[SourceAtom], nodes: &[Node], result: NodeId, evaluation: SourceGraph.EvalId,
  root: PreparedSources.EndpointId, retained: bool, paths: &mut List<List<Step>>, missing: &mut SourceAtom) -> List<SourceResultRoute>
! OutOfMemoryError ? &mut Allocator {
  let positions = List<SourceCarryPosition>.asSlice(&observation.positions)
  if declarations.length != positions.length { CompilerBug.panic(b"result routes lost the declared-source snapshot") }
  let no = SourceProgram.atom(&mut builder.rules)
  let mut routes = List<SourceResultRoute>.make()
  let count = SourceGraphBuilder.policyCount(&builder.*)
  let mut at = usize.ZERO
  while at < count {
    let port = SourceGraphBuilder.policy(&builder.*, at)
    let target = SourceGraphBuilder.value(&builder.*, port.target)
    if port.terminal && target.evaluation.index == evaluation.index {
      let borrowed = match &SourceGraphBuilder.leaf(&builder.*, port.leaf).kind { SourceGraphSourceLeaf.Borrow {..} => true _ => false }
      let ordinary = match port.authority { SourceGraphTransferAuthority.OrdinaryResult {..} => true _ => false }
      let semanticOnly = sourceSemanticResult(port.authority)
      let projected = run sourcePolicyObservation(&mut builder.*, port.id, Option<usize>.none())
      if !borrowed {
        // These are genuine caller/expression/loan-free/unknown sources. They follow their
        // authenticated route and never enter a Borrow count or global Loan precision state.
        // Semantic ownership policy supplies no result-source proof for these inputs.
        let mut kept = port.quality.present
        if semanticOnly { kept = no }
        run SourceGraphBuilder.bindPolicy(&mut builder.*, port.id,
          kept, no, no)
      } else if !retained {
        // A nonretaining result drops every Borrow regardless of its input binding. This
        // grounded policy does not require a fabricated original argument correspondence.
        let mut kept = projected.masked
        if semanticOnly { kept = no }
        run SourceGraphBuilder.bindPolicy(&mut builder.*, port.id, kept, no, no)
      } else {
        let placement = run sourceResultPlacement(&builder.*, port, root, &mut paths.*)
        let ownership = run SourceGraphBuilder.policyOwnershipPlacements(&builder.*, port.id)
        let reset = SourceGraphBuilder.policyOperationOwnershipReset(&builder.*, port.id)
        let ordinaryReset = SourceGraphBuilder.policyOrdinaryOwnershipReset(&builder.*, port.id)
        let fieldPublications = run SourceGraphBuilder.policyFieldResultPublications(&builder.*, port.id)
        let mut fieldDemand = projected.quality.present
        if let SourceGraphTransferAuthority.FieldResult {..} = port.authority {
          let publications = List<SourceGraph.FieldResultPublication>.asSlice(&fieldPublications)
          if publications.length != usize.ZERO {
            let mut demanded = List<SourceAtom>.make()
            let mut publication = usize.ZERO
            while publication < publications.length {
              let row = publications[publication]
              if run sourceFieldResultDemand(&builder.*, row.candidate, &mut paths.*) {
                let gates: [SourceAtom; 2] = [row.sourceActive, row.applicable]
                let empty = List<SourceAtom>.make()
                run List<SourceAtom>.append(&mut demanded,
                  run SourcePolicy.conjunction(&mut builder.rules, &gates, List<SourceAtom>.asSlice(&empty)))
              }
              publication = publication + usize.ONE
            }
            let required = run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&demanded))
            let gates: [SourceAtom; 2] = [projected.quality.present, required]
            let empty = List<SourceAtom>.make()
            fieldDemand = run SourcePolicy.conjunction(&mut builder.rules, &gates, List<SourceAtom>.asSlice(&empty))
          }
        }
        let throughReset = SourceGraphBuilder.policyThroughOwnershipReset(&builder.*, port.id)
        let dereference = SourceGraphBuilder.policyRvalueDereferencePublication(&builder.*, port.id)
        let incoming = run SourceGraphBuilder.policyCases(&builder.*, port.id)
        let argument = match port.authority {
          SourceGraphTransferAuthority.OperationResult {candidate, ..} => match candidate.binding {
            SourceResultsBinding.Argument {..} => true
            SourceResultsBinding.CallableArgument {..} => false
            SourceResultsBinding.DescriptorInput {..} => false
          }
          _ => false
        }
        let mut covered = List<SourceAtom>.make()
        let mut position = usize.ZERO
        while position < positions.length {
          let histories = List<SourceCarryCase>.asSlice(&positions[position].cases)
          let mut history = usize.ZERO
          while history < histories.length {
            let paired = run sourceResultPair(&mut builder.*, port, List<SourceGraph.InputCase>.asSlice(&incoming),
              &positions[position], &histories[history])
            if let Option<SourceAtom>.Some {value: active} = paired {
              let exact = port.source.index == positions[position].value.index
                && sourcePolicyCase(List<SourceGraph.InputCase>.asSlice(&incoming), &histories[history].source)
              let mut selected = Option<usize>.none()
              if exact { selected = Option<usize>.some(histories[history].source.case) }
              let semantic = run sourcePolicyObservation(&mut builder.*, port.id, selected)
              let gates: [SourceAtom; 2] = [active, semantic.quality.present]
              let empty = List<SourceAtom>.make()
              let active = run SourcePolicy.conjunction(&mut builder.rules, &gates, List<SourceAtom>.asSlice(&empty))
              if port.outputRole == SourceGraphSourceRole.Ownership {
                if let SourceGraphTransferAuthority.FieldResult {recipe, ..} = port.authority {
                  if !exact { return CompilerBug.panic(b"field publication changed its original operand Case") }
                  let selected = SourceGraphBuilder.fieldResultRecipes(&builder.*)[recipe]
                  if selected.source.index != port.source.index || selected.target.index != port.target.index
                    || selected.root.index != root.index || target.evaluation.index != evaluation.index {
                    return CompilerBug.panic(b"field publication changed its actual whole result Value")
                  }
                  let publications = List<SourceGraph.FieldResultPublication>.asSlice(&fieldPublications)
                  let mut publication = usize.ZERO
                  while publication < publications.length {
                    let boundary = publications[publication]
                    if sourceFieldResultPair(&builder.*, boundary.candidate, port,
                      &positions[position], &histories[history]) {
                      let candidate = SourceGraphBuilder.fieldResultCandidates(&builder.*)[boundary.candidate]
                      if boundary.sourceCase != candidate.sourceCase || candidate.recipe != recipe
                        || boundary.root.index != root.index
                        || !SourceGraph.sameOwnershipPlacement(boundary.placement, selected.placement)
                        || !SourceGraph.sameOwnershipPlacement(candidate.placement, selected.placement) {
                        return CompilerBug.panic(b"field publication changed its exact incoming placement evidence")
                      }
                      let output = run sourceOwnershipField(&builder.*, root, boundary.placement, &mut paths.*)
                      if output.supported {
                        let gates: [SourceAtom; 3] = [active, boundary.sourceActive, boundary.applicable]
                        let empty = List<SourceAtom>.make()
                        let arrived = run SourcePolicy.conjunction(&mut builder.rules, &gates, List<SourceAtom>.asSlice(&empty))
                        run List<SourceAtom>.append(&mut covered, arrived)
                        // Every authentic candidate is paired here; finish selects its
                        // exact residual/MAX and directness using the original decision.
                        run List<SourceResultRoute>.append(&mut routes, SourceResultRoute {
                          position: position, history: history, policy: at, field: output.field,
                          wholeField: output.field == usize.ZERO, declared: no,
                          active: arrived, quality: semantic.quality,
                          reset: Option<SourceAtom>.some(boundary.accepted), ordinary: false})
                      }
                    }
                    publication = publication + usize.ONE
                  }
                  history = history + usize.ONE
                  continue
                }
                if let Option<SourceGraph.OrdinaryOwnershipReset>.Some {value: boundary} = ordinaryReset {
                  let candidate = SourceGraphBuilder.ordinaryResultCandidates(&builder.*)[boundary.candidate]
                  let demand = SourceGraphBuilder.ordinaryResultDemands(&builder.*)[boundary.demand]
                  if !ordinary || !exact || candidate.demand != boundary.demand
                    || demand.evaluation.index != evaluation.index || demand.root.index != root.index
                    || boundary.root.index != root.index || candidate.source.index != positions[position].value.index
                    || candidate.target.index != port.target.index || port.outputDirect {
                    return CompilerBug.panic(b"ordinary publication changed its exact whole-finish source")
                  }
                  let gates: [SourceAtom; 3] = [active, boundary.sourceActive, boundary.applicable]
                  let empty = List<SourceAtom>.make()
                  let arrived = run SourcePolicy.conjunction(&mut builder.rules, &gates, List<SourceAtom>.asSlice(&empty))
                  run List<SourceAtom>.append(&mut covered, arrived)
                  run List<SourceResultRoute>.append(&mut routes, SourceResultRoute {
                    position: position, history: history, policy: at, field: usize.ZERO,
                    wholeField: true, declared: no, active: arrived, quality: semantic.quality,
                    reset: Option<SourceAtom>.some(boundary.accepted), ordinary: true})
                  history = history + usize.ONE
                  continue
                }
                if let Option<SourceGraph.RvalueDereferencePublication>.Some {value: boundary} = dereference {
                  let candidate = SourceGraphBuilder.rvalueDereferenceResults(&builder.*)[boundary.candidate]
                  let operand = SourceGraphBuilder.value(&builder.*, candidate.source)
                  let physical = match SourceGraphBuilder.resultUses(&builder.*)[candidate.result].kind {
                    SourceGraphResultKind.Physical => true
                    _ => false
                  }
                  if !physical || !exact
                    || SourceGraphBuilder.resultUses(&builder.*)[candidate.result].evaluation.index != evaluation.index
                    || SourceGraphBuilder.selectionUses(&builder.*)[candidate.selection].result.index != evaluation.index
                    || SourceGraphBuilder.selectionUses(&builder.*)[candidate.selection].operand.index != operand.evaluation.index
                    || operand.phase != SourceGraphValuePhase.Output
                    || candidate.source.index != positions[position].value.index || candidate.target.index != port.target.index
                    || candidate.root.index != root.index || boundary.root.index != root.index || port.outputDirect {
                    return CompilerBug.panic(b"rvalue dereference changed its actual operand finish or whole result")
                  }
                  // Unplaced operand forwarding keeps the original decision but places
                  // an ordinary retained loan at field zero, indirectly. This is semantic
                  // ownership publication, not a descriptor-to-referent physical copy.
                  let gates: [SourceAtom; 3] = [active, boundary.sourceActive, boundary.applicable]
                  let empty = List<SourceAtom>.make()
                  let arrived = run SourcePolicy.conjunction(&mut builder.rules, &gates, List<SourceAtom>.asSlice(&empty))
                  run List<SourceAtom>.append(&mut covered, arrived)
                  run List<SourceResultRoute>.append(&mut routes, SourceResultRoute {
                    position: position, history: history, policy: at, field: usize.ZERO,
                    wholeField: true, declared: no, active: arrived, quality: semantic.quality,
                    reset: Option<SourceAtom>.some(boundary.accepted), ordinary: false})
                  history = history + usize.ONE
                  continue
                }
                if let Option<SourceGraph.ThroughOwnershipReset>.Some {value: boundary} = throughReset {
                  let candidate = SourceGraphBuilder.throughResultCandidates(&builder.*)[boundary.candidate]
                  let request = SourceGraphBuilder.throughFlightRequests(&builder.*)[candidate.request]
                  if request.operation.index != evaluation.index || request.kind != SourceGraphThroughFlightKind.Read
                    || candidate.source.index != positions[position].value.index || candidate.target.index != port.target.index
                    || boundary.root.index != root.index || port.outputDirect
                    || !sourceReadMatches(histories[history].source.read, Option<SourceControl.ReadId>.some(candidate.read)) {
                    return CompilerBug.panic(b"through reset changed its original read flight or whole result")
                  }
                  let gates: [SourceAtom; 3] = [active, boundary.sourceActive, boundary.applicable]
                  let empty = List<SourceAtom>.make()
                  let arrived = run SourcePolicy.conjunction(&mut builder.rules, &gates, List<SourceAtom>.asSlice(&empty))
                  run List<SourceAtom>.append(&mut covered, arrived)
                  run List<SourceResultRoute>.append(&mut routes, SourceResultRoute {
                    position: position, history: history, policy: at, field: usize.ZERO,
                    wholeField: true, declared: no, active: arrived, quality: semantic.quality,
                    reset: Option<SourceAtom>.some(boundary.accepted), ordinary: false})
                  history = history + usize.ONE
                  continue
                }
                if let Option<SourceGraph.OperationOwnershipReset>.Some {value: boundary} = reset {
                  // The original finish policy resets an ordinary whole result to field
                  // zero. Its accepted gate is written only after that policy decides;
                  // neither the output Case nor its publication may justify admission.
                  if boundary.root.index != root.index || port.outputDirect {
                    CompilerBug.panic(b"whole result reset changed its output placement")
                  }
                  let gates: [SourceAtom; 3] = [active, boundary.sourceActive, boundary.applicable]
                  let empty = List<SourceAtom>.make()
                  let arrived = run SourcePolicy.conjunction(&mut builder.rules, &gates, List<SourceAtom>.asSlice(&empty))
                  run List<SourceAtom>.append(&mut covered, arrived)
                  run List<SourceResultRoute>.append(&mut routes, SourceResultRoute {
                    position: position, history: history, policy: at, field: usize.ZERO,
                    wholeField: true, declared: no, active: arrived, quality: semantic.quality,
                    reset: Option<SourceAtom>.some(boundary.accepted), ordinary: false})
                  history = history + usize.ONE
                  continue
                }
                // The predecessor placement is available before this port's decision.
                // Reading the target publication's active atom here would depend on
                // our own kept gate and erase a legitimate ownership publication.
                let edges = List<SourceGraph.OwnershipPolicyPlacement>.asSlice(&ownership)
                let mut edge = usize.ZERO
                while edge < edges.length {
                  let before = SourceGraphBuilder.ownershipPublications(&builder.*)[edges[edge].source]
                  let after = SourceGraphBuilder.ownershipPublications(&builder.*)[edges[edge].target]
                  let origin = SourceGraphBuilder.ownershipOrigins(&builder.*)[before.origin]
                  let original = run sourceOwnershipOriginField(&builder.*, origin, &mut paths.*)
                  let initial = run sourceOwnershipField(&builder.*, original.root, before.initial, &mut paths.*)
                  let output = run sourceOwnershipField(&builder.*, root, after.placement, &mut paths.*)
                  if original.field.supported && initial.supported && output.supported
                    && sourceSameField(List<List<Step>>.asSlice(&paths.*), original.field.field, initial.field) {
                    let gates: [SourceAtom; 3] = [active, edges[edge].sourceActive, edges[edge].applicable]
                    let empty = List<SourceAtom>.make()
                    let arrived = run SourcePolicy.conjunction(&mut builder.rules, &gates, List<SourceAtom>.asSlice(&empty))
                    run List<SourceAtom>.append(&mut covered, arrived)
                    run List<SourceResultRoute>.append(&mut routes, SourceResultRoute {
                      position: position, history: history, policy: at, field: output.field,
                      wholeField: output.field == usize.ZERO, declared: no, active: arrived, quality: semantic.quality,
                      reset: Option<SourceAtom>.none(), ordinary: false})
                  }
                  edge = edge + usize.ONE
                }
                history = history + usize.ONE
                continue
              }
              let mut declaration = no
              if argument && sourceDeclaredField(nodes, result, positions[position].node, placement.field, List<List<Step>>.asSlice(&paths.*)) {
                if port.outputDirect { CompilerBug.panic(b"declared result route manufactured a direct descriptor") }
                declaration = declarations[position]
              }
              run List<SourceAtom>.append(&mut covered, active)
              run List<SourceResultRoute>.append(&mut routes,
                SourceResultRoute {position: position, history: history, policy: at, field: placement.field,
                  wholeField: placement.whole, declared: declaration, active: active, quality: semantic.quality,
                  reset: Option<SourceAtom>.none(), ordinary: false})
            }
            history = history + usize.ONE
          }
          position = position + usize.ONE
        }
        // Missing correspondence is an outstanding obligation, never a grounded drop.
        // Bind structurally unmatched ports false so the graph can settle, while retaining
        // their independent active gap. Absence of publication cannot certify the body.
        let guards: [SourceAtom; 2] = [port.active, fieldDemand]
        let unsupported = run SourcePolicy.conjunction(&mut builder.rules, &guards, List<SourceAtom>.asSlice(&covered))
        let gaps: [SourceAtom; 2] = [missing.*, unsupported]
        missing.* = run SourcePolicy.disjunction(&mut builder.rules, &gaps)
        if List<SourceAtom>.length(&covered) == usize.ZERO {
          let mut kept = projected.masked
          if semanticOnly { kept = no }
          run SourceGraphBuilder.bindPolicy(&mut builder.*, port.id, kept, no, no)
        }
      }
    }
    at = at + usize.ONE
  }
  return move routes
}

// Finish's per-carry loop over actual positions. Snapshot predicates are emitted before this
// loop; every alternative history sees the same pre-version, then one advance publishes its
// joined effects. A later real operand of the same loan observes that advance.
effect fn sourceFinishPositions<'body>(builder: &mut SourceGraphBuilder<'body>, observation: &SourceObservation,
  state: &mut SourceLoanState, observed: &[SourceQuality], loans: &[Loan], nodes: &[Node],
  owner: &DeclarationId, supplied: &[Shared<Lifetime>], requirements: &[RetentionEdge], relations: &[ImpliedGroup],
  result: NodeId, evaluation: SourceGraph.EvalId, named: &[Shared<Lifetime>], facts: &SourceResultFacts, implied: &Implied, declared: &[SourceAtom],
  placed: &[List<Step>], completed: SourceAtom, routes: &[SourceResultRoute], ordinaryFinish: bool, paths: &mut List<List<Step>>)
  -> SourceResultScan ! OutOfMemoryError ? &mut Allocator {
  let positions = List<SourceCarryPosition>.asSlice(&observation.positions)
  if observed.length != positions.length || declared.length != positions.length {
    CompilerBug.panic(b"result scan lost its pre-operation observation")
  }
  let mut inputs = List<SourceResultInput>.make()
  let mut at = usize.ZERO
  while at < positions.length {
    run List<SourceResultInput>.append(&mut inputs,
      SourceResultInput {loan: positions[at].loan, operand: positions[at].operand, quality: observed[at]})
    at = at + usize.ONE
  }
  let mut snapshot = run sourceResultSnapshot(nodes, owner, supplied, loans, List<SourceResultInput>.asSlice(&inputs),
    named, requirements, result, facts.known, facts.stores, facts.outside, &mut builder.rules)
  let empty = List<SourceAtom>.make()
  let none = List<SourceAtom>.asSlice(&empty)
  // Unknown is a real source alternative. Omitting it from Borrow count cannot certify an
  // all-source release; its possible applicability blocks the completed-source predicate.
  let complete: [SourceAtom; 1] = [snapshot.complete]
  let unknown: [SourceAtom; 1] = [observation.unknown]
  snapshot.complete = run SourcePolicy.conjunction(&mut builder.rules, &complete, &unknown)
  let mut effects = List<SourceResultEffect>.make()
  let mut inputEffects = List<SourcePositionResult>.make()
  let mut gaps = List<SourceAtom>.make()
  let mut ordinaryGaps = List<SourceAtom>.make()
  at = usize.ZERO
  while at < positions.length {
    let position = &positions[at]
    let histories = List<SourceCarryCase>.asSlice(&position.cases)
    let mut losses = List<SourcePolicy.Precision>.make()
    if histories.length == usize.ZERO {
      let unsupported: [SourceAtom; 2] = [completed, observed[at].present]
      let missing = run SourcePolicy.conjunction(&mut builder.rules, &unsupported, none)
      run List<SourceAtom>.append(&mut gaps, missing)
      if ordinaryFinish { run List<SourceAtom>.append(&mut ordinaryGaps, missing) }
    }
    let mut history = usize.ZERO
    while history < histories.length {
      let actual = &histories[history]
      // Input decisions are independent of whether a result route was enumerated. They
      // observe one immutable pre-position P; publication cannot erase their side effects.
      let present: [SourceAtom; 3] = [completed, observed[at].present, actual.source.quality.present]
      let applicable = run SourcePolicy.conjunction(&mut builder.rules, &present, none)
      let before = SourceLoanState.quality(&state.*, position.loan, applicable)
      let source = SourceResultCase {quality: before, operand: position.operand,
        retained: retainedOperand(nodes, result, position.operand), field: actual.field,
        wholeField: sourceWholePlacement(facts.forwarding, position.operand, actual.field, placed), declared: declared[at]}
      let mut impliedKnown = SourceProgram.atom(&mut builder.rules)
      if facts.known && !facts.stores && facts.hasTyped && implied.known {
        let gate: [SourceAtom; 2] = [snapshot.naming.unnamed, facts.impliedKnown]
        impliedKnown = run SourcePolicy.conjunction(&mut builder.rules, &gate, none)
      }
      let localFacts = SourceResultFacts {stores: facts.stores, known: facts.known, outside: facts.outside,
        forwarding: facts.forwarding, placedCount: facts.placedCount, impliedKnown: impliedKnown,
        mayOutlive: run sourceBoolean(&mut builder.rules,
          run mayOutlive(implied, List<Shared<Lifetime>>.asSlice(&loans[position.loan].regions), named, owner)),
        hasTyped: facts.hasTyped}
      let decision = run sourceResultDecision(&loans[position.loan], &source, &localFacts, &snapshot, at,
        owner, named, relations, &mut builder.rules)
      let loss = SourcePolicy.Precision {stored: decision.addStored, alternatives: decision.addAlternatives}
      run List<SourcePolicy.Precision>.append(&mut losses, loss)
      let caseLoss: [SourcePolicy.Precision; 1] = [loss]
      let afterCase = run SourcePolicy.advance(&mut builder.rules,
        SourcePolicy.Precision {stored: before.stored, alternatives: before.alternatives}, &caseLoss)
      let mut publications = List<SourceAtom>.make()
      let mut ordinaryPublications = List<SourceAtom>.make()
      let mut route = usize.ZERO
      while route < routes.length {
        let output = &routes[route]
        if output.position == at && output.history == history {
          let port = SourceGraphBuilder.policy(&builder.*, output.policy)
          // sourceResultPair already authenticated either this exact physical history or
          // its finite capture-to-current correspondence. Keep that gate on publication.
          let target = SourceGraphBuilder.value(&builder.*, port.target)
          let evaluation = SourceGraphBuilder.evaluation(&builder.*, target.evaluation)
          let produced = List<SourceControl.Point>.asSlice(&builder.reaching.points)[evaluation.point.index].reachable
          // A declared carry publishes only at the independently authenticated ResultBorrow
          // field. That admission is source provenance, never a returned referent address.
          let declaredOutput: [SourceAtom; 1] = [decision.declared]
          let ordinary = run SourcePolicy.conjunction(&mut builder.rules, none, &declaredOutput)
          // A physical target is not evidence that an unknown or reference-held semantic
          // path became that exact component. Keep unsupported publication explicit until
          // the common ownership-placement authority supplies the complete suffix.
          let placement = run sourceForwardedField(facts.forwarding, position.operand, actual.field, placed, &mut paths.*)
          let direct = (facts.forwarding == Forwarding.Matched || position.operand < placed.length)
            && actual.source.direct && placement != usize.MAX
          let physical = facts.forwarding == Forwarding.None
            || sourceSameField(List<List<Step>>.asSlice(&paths.*), placement, output.field)
          let physicalGate: [SourceAtom; 2] = [ordinary,
            run sourceBoolean(&mut builder.rules, physical && (!port.outputDirect || direct))]
          let choices: [SourceAtom; 2] = [run SourcePolicy.conjunction(&mut builder.rules, &physicalGate, none), output.declared]
          let permitted = run SourcePolicy.disjunction(&mut builder.rules, &choices)
          let authority: [SourceAtom; 5] = [produced, port.active, port.quality.present, permitted, output.active]
          let published = run SourcePolicy.conjunction(&mut builder.rules, &authority, none)
          run List<SourceAtom>.append(&mut publications, published)
          let retained: [SourceAtom; 2] = [decision.kept, published]
          let kept = run SourcePolicy.conjunction(&mut builder.rules, &retained, none)
          if ordinaryFinish && output.ordinary {
            // These are the same accepted policy prerequisites, before the reset's
            // accepted atom and output Case. Declared-kept histories cannot certify
            // completeness through an ordinary duplicate.
            let retained: [SourceAtom; 2] = [kept, ordinary]
            run List<SourceAtom>.append(&mut ordinaryPublications,
              run SourcePolicy.conjunction(&mut builder.rules, &retained, none))
          }
          if let Option<SourceAtom>.Some {value: accepted} = output.reset {
            let reset: [SourceAtom; 2] = [kept, ordinary]
            run SourceProgram.rule(&mut builder.rules, accepted, &reset, none)
          }
          let wholeField = run sourceBoolean(&mut builder.rules, output.wholeField)
          let held: [SourceAtom; 3] = [decision.whole, kept, wholeField]
          let whole = run SourcePolicy.conjunction(&mut builder.rules, &held, none)
          let stored: [SourceAtom; 2] = [afterCase.stored, output.quality.stored]
          let alternatives: [SourceAtom; 2] = [afterCase.alternatives, output.quality.alternatives]
          run List<SourceResultEffect>.append(&mut effects, SourceResultEffect {
            source: sourceEffectSource(position, actual), policy: output.policy, target: port.target,
            field: output.field, direct: port.outputDirect && direct,
            whole: whole, described: decision.described,
            quality: SourceQuality {present: kept,
              stored: run SourcePolicy.disjunction(&mut builder.rules, &stored),
              alternatives: run SourcePolicy.disjunction(&mut builder.rules, &alternatives)}})
        }
        route = route + usize.ONE
      }
      let missing = run sourceResultCoverage(&mut builder.rules, decision.kept, List<SourceAtom>.asSlice(&publications))
      run List<SourceAtom>.append(&mut gaps, missing)
      if ordinaryFinish {
        let present: [SourceAtom; 1] = [applicable]
        let retained: [SourceAtom; 1] = [decision.kept]
        let dropped = run SourcePolicy.conjunction(&mut builder.rules, &present, &retained)
        run List<SourceAtom>.append(&mut ordinaryPublications, dropped)
        let handled = run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&ordinaryPublications))
        let covered: [SourceAtom; 1] = [handled]
        run List<SourceAtom>.append(&mut ordinaryGaps,
          run SourcePolicy.conjunction(&mut builder.rules, &present, &covered))
      }
      run List<SourcePositionResult>.append(&mut inputEffects, SourcePositionResult {
        result: evaluation, position: at, source: sourceEffectSource(position, actual), decision: move decision, missing: missing})
      history = history + usize.ONE
    }
    drop run SourceLoanState.finishPosition(&mut state.*, &mut builder.rules, position.loan,
      List<SourcePolicy.Precision>.asSlice(&losses))
    at = at + usize.ONE
  }
  // A port may have several paired predecessor histories. Bind its union once, after those
  // histories have all decided; binding one history must not erase another possible output.
  let decisions = List<SourceResultEffect>.asSlice(&effects)
  at = usize.ZERO
  while at < decisions.length {
    let policy = decisions[at].policy
    let mut prior = usize.ZERO
    while prior < at && decisions[prior].policy != policy { prior = prior + usize.ONE }
    if prior == at {
      let mut keptSources = List<SourceAtom>.make()
      let mut storedSources = List<SourceAtom>.make()
      let mut alternativeSources = List<SourceAtom>.make()
      let mut each = at
      while each < decisions.length {
        if decisions[each].policy == policy {
          run List<SourceAtom>.append(&mut keptSources, decisions[each].quality.present)
          let store: [SourceAtom; 2] = [decisions[each].quality.present, decisions[each].quality.stored]
          let alternate: [SourceAtom; 2] = [decisions[each].quality.present, decisions[each].quality.alternatives]
          run List<SourceAtom>.append(&mut storedSources, run SourcePolicy.conjunction(&mut builder.rules, &store, none))
          run List<SourceAtom>.append(&mut alternativeSources, run SourcePolicy.conjunction(&mut builder.rules, &alternate, none))
        }
        each = each + usize.ONE
      }
      let port = SourceGraphBuilder.policy(&builder.*, policy)
      let projected = run sourcePolicyObservation(&mut builder.*, port.id, Option<usize>.none())
      // Raw source Q already flows through the physical Case. The masked branch adds
      // only kept; feeding its raw Q back as a policy loss would taint semantic arrivals.
      if !sourceSemanticResult(port.authority) { run List<SourceAtom>.append(&mut keptSources, projected.masked) }
      let kept = run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&keptSources))
      let stored = run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&storedSources))
      let alternatives = run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&alternativeSources))
      run SourceGraphBuilder.bindPolicy(&mut builder.*, port.id, kept, stored, alternatives)
    }
    at = at + usize.ONE
  }
  return SourceResultScan {inputs: move inputEffects, outputs: move effects,
    missing: run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&gaps)),
    ordinaryMissing: run SourcePolicy.disjunction(&mut builder.rules, List<SourceAtom>.asSlice(&ordinaryGaps))}
}

effect fn sourceForwardedField(forwarding: Forwarding, operand: usize, field: usize,
  placed: &[List<Step>], paths: &mut List<List<Step>>) -> usize ! OutOfMemoryError ? &mut Allocator {
  if forwarding == Forwarding.Matched { return field }
  if operand >= placed.length { return usize.ZERO }
  if field == usize.MAX { return usize.MAX }
  let mut combined = run copySteps(List<Step>.asSlice(&placed[operand]))
  let suffix = List<Step>.asSlice(&List<List<Step>>.asSlice(&paths.*)[field])
  let mut at = usize.ZERO
  while at < suffix.length { run List<Step>.append(&mut combined, suffix[at]) at = at + usize.ONE }
  let result = List<List<Step>>.length(&paths.*)
  run List<List<Step>>.append(&mut paths.*, move combined)
  return result
}

// This is the owning finish handler's original pre-placement, before any declared output
// expansion. It does not assert that a source can reach a result or manufacture a port.
fn sourceWholePlacement(forwarding: Forwarding, operand: usize, field: usize, placed: &[List<Step>]) -> bool {
  if forwarding == Forwarding.Matched { return field == usize.ZERO }
  if operand < placed.length { return field == usize.ZERO && List<Step>.length(&placed[operand]) == usize.ZERO }
  return true
}

// Missing output authority is not a source-policy drop. In particular zero candidate ports
// cannot erase a retained input's effects or certify that its source is absent.
effect fn sourceResultCoverage(rules: &mut SourceProgram, kept: SourceAtom, publications: &[SourceAtom]) -> SourceAtom
! OutOfMemoryError ? &mut Allocator {
  let published = run SourcePolicy.disjunction(&mut rules.*, publications)
  let retained: [SourceAtom; 1] = [kept]
  let available: [SourceAtom; 1] = [published]
  return run SourcePolicy.conjunction(&mut rules.*, &retained, &available)
}

effect fn sourceBoolean(rules: &mut SourceProgram, value: bool) -> SourceAtom
! OutOfMemoryError ? &mut Allocator {
  let result = SourceProgram.atom(&mut rules.*)
  if value { run SourceProgram.fact(&mut rules.*, result) }
  return result
}

// The ResultDecision predicates which depend only on immutable loan/type/placement evidence
// retain their original helpers. Conditional source, precision and operation state become
// rules; no possible/undefined witness is sampled as a Boolean in this translation.
effect fn sourceResultDecision(loan: &Loan, actual: &SourceResultCase, facts: &SourceResultFacts,
  snapshot: &SourceResultSnapshot, position: usize, owner: &DeclarationId,
  named: &[Shared<Lifetime>], relations: &[ImpliedGroup], rules: &mut SourceProgram)
  -> SourcePolicy.ResultOutput ! OutOfMemoryError ? &mut Allocator {
  let required = List<SourceAtom>.asSlice(&snapshot.required)
  let parents = List<SourceAtom>.asSlice(&snapshot.parents)
  if position >= required.length || position >= parents.length {
    return CompilerBug.panic(b"result policy has no source-position snapshot")
  }
  let no = SourceProgram.atom(&mut rules.*)
  let empty = List<SourceAtom>.make()
  let none = List<SourceAtom>.asSlice(&empty)
  let regions = List<Shared<Lifetime>>.asSlice(&loan.regions)
  let shared = run sourceBoolean(&mut rules.*, sharesAtom(regions, named))
  let names: [SourceAtom; 2] = [shared, required[position]]
  let mut namedSource = no
  if regions.length != usize.ZERO { namedSource = run SourcePolicy.disjunction(&mut rules.*, &names) }
  let mut placedSeveral = no
  if facts.forwarding == Forwarding.Operands && actual.operand < facts.placedCount {
    let placed: [SourceAtom; 2] = [snapshot.naming.several, namedSource]
    placedSeveral = run SourcePolicy.conjunction(&mut rules.*, &placed, none)
  }
  let sameOperand = run SourceNaming.operand(&snapshot.naming, &mut rules.*, actual.operand)
  let single: [SourceAtom; 2] = [sameOperand, namedSource]
  let notSeveral: [SourceAtom; 1] = [snapshot.naming.several]
  let namedSingle = run SourcePolicy.conjunction(&mut rules.*, &single, &notSeveral)
  let unneeded = run sourceUnneededOwnedLoan(loan, owner, named, actual.quality,
    parents[position], required[position], &mut rules.*)
  let mut alternatives = no
  if facts.known {
    let ambiguous: [SourceAtom; 2] = [snapshot.naming.several, namedSource]
    let ambiguousSource = run SourcePolicy.conjunction(&mut rules.*, &ambiguous, none)
    let reasons: [SourceAtom; 2] = [ambiguousSource, parents[position]]
    alternatives = run SourcePolicy.disjunction(&mut rules.*, &reasons)
  }
  let forwarded = facts.forwarding == Forwarding.Operands
    || (facts.forwarding == Forwarding.Matched && actual.field != usize.MAX)
  let input = SourcePolicy.ResultInput {quality: actual.quality,
    stores: run sourceBoolean(&mut rules.*, facts.stores), retained: run sourceBoolean(&mut rules.*, actual.retained), required: required[position],
    known: run sourceBoolean(&mut rules.*, facts.known), outside: run sourceBoolean(&mut rules.*, facts.outside),
    forwarded: run sourceBoolean(&mut rules.*, forwarded), local: run sourceBoolean(&mut rules.*, loan.local),
    matched: run sourceBoolean(&mut rules.*, facts.forwarding == Forwarding.Matched),
    outlivesResult: run sourceBoolean(&mut rules.*, outlivesResult(relations, regions, named)), declared: actual.declared,
    body: run sourceBoolean(&mut rules.*, bodyRegions(regions, owner)), complete: snapshot.complete, unneeded: unneeded,
    placedSeveral: placedSeveral, namedSingle: namedSingle, impliedKnown: facts.impliedKnown,
    ancestor: parents[position], mayOutlive: facts.mayOutlive, alternatives: alternatives,
    wholeField: run sourceBoolean(&mut rules.*, actual.wholeField),
    forwardingNone: run sourceBoolean(&mut rules.*, facts.forwarding == Forwarding.None), hasTyped: run sourceBoolean(&mut rules.*, facts.hasTyped)}
  return run SourcePolicy.result(&mut rules.*, &input)
}

// The immutable descriptor predicate and its actual pre-result precision gates are
// shared by result dispatch and its actor assertions. Completeness is proved separately.
effect fn sourceUnneededOwnedLoan(loan: &Loan, owner: &DeclarationId, named: &[Shared<Lifetime>],
  quality: SourceQuality, ancestor: SourceAtom, required: SourceAtom, rules: &mut SourceProgram)
  -> SourceAtom ! OutOfMemoryError ? &mut Allocator {
  let regions = List<Shared<Lifetime>>.asSlice(&loan.regions)
  let mut mayRelease = false
  if loan.local && regions.length == usize.ONE {
    if let Option<Shared<Lifetime>>.None = &loan.parent {
      if let Option<Shared<Lifetime>>.Some {value: borrowed} = &loan.borrowed {
        mayRelease = retentionOrdinal(&borrowed, owner) != usize.MAX
          && Lifetime.equalsShared(&regions[0], &borrowed) && !proofContains(named, &borrowed)
      }
    }
  }
  let mut unneeded = SourceProgram.atom(&mut rules.*)
  if mayRelease {
    let present: [SourceAtom; 1] = [quality.present]
    let blocked: [SourceAtom; 4] = [quality.stored, quality.alternatives, ancestor, required]
    unneeded = run SourcePolicy.conjunction(&mut rules.*, &present, &blocked)
  }
  return unneeded
}

// Emits the original source-dependent snapshot guards into the common program. Metadata-only
// predicates keep their existing implementation; actual presence and quality remain atoms.
effect fn sourceResultSnapshot(nodes: &[Node], owner: &DeclarationId, supplied: &[Shared<Lifetime>],
  loans: &[Loan], inputs: &[SourceResultInput], named: &[Shared<Lifetime>], edges: &[RetentionEdge],
  result: NodeId, known: bool, stores: bool, outside: bool, rules: &mut SourceProgram) -> SourceResultSnapshot
! OutOfMemoryError ? &mut Allocator {
  let yes = SourceProgram.atom(&mut rules.*)
  let no = SourceProgram.atom(&mut rules.*)
  run SourceProgram.fact(&mut rules.*, yes)
  let empty = List<SourceAtom>.make()
  let none = List<SourceAtom>.asSlice(&empty)
  let missing = SourceProgram.atom(&mut rules.*)
  let mut at = usize.ZERO
  while at < inputs.length {
    let loan = &loans[inputs[at].loan]
    if let Option<Shared<Lifetime>>.Some {value: borrowed} = &loan.borrowed {
      if retentionOrdinal(&borrowed, owner) != usize.MAX
        && !sharesAtom(List<Shared<Lifetime>>.asSlice(&loan.regions), named) {
        let actual: [SourceAtom; 1] = [inputs[at].quality.present]
        run SourceProgram.rule(&mut rules.*, missing, &actual, none)
      }
    }
    at = at + usize.ONE
  }
  let mut closure = List<usize>.make()
  if known && !stores && edges.length != usize.ZERO { closure = run retentionClosure(named, owner, edges) }
  let mut required = List<SourceAtom>.make()
  let mut namingInputs = List<SourceNamingInput>.make()
  at = usize.ZERO
  while at < inputs.length {
    let input = inputs[at]
    let loan = &loans[input.loan]
    let regions = List<Shared<Lifetime>>.asSlice(&loan.regions)
    let needed = SourceProgram.atom(&mut rules.*)
    if requiredLoan(loan, owner, List<usize>.asSlice(&closure)) {
      let actual: [SourceAtom; 2] = [missing, input.quality.present]
      run SourceProgram.rule(&mut rules.*, needed, &actual, none)
    }
    run List<SourceAtom>.append(&mut required, needed)
    let mut retained = no
    if retainedOperand(nodes, result, input.operand) { retained = yes }
    let heldInputs: [SourceAtom; 2] = [retained, needed]
    let held = run SourcePolicy.disjunction(&mut rules.*, &heldInputs)
    let names = SourceProgram.atom(&mut rules.*)
    if regions.length == usize.ZERO || sharesAtom(regions, named) {
      let matches: [SourceAtom; 1] = [held]
      run SourceProgram.rule(&mut rules.*, names, &matches, none)
    }
    let throughRequired: [SourceAtom; 1] = [needed]
    run SourceProgram.rule(&mut rules.*, names, &throughRequired, none)
    let mut unnamed = no
    if bodyRegions(regions, owner) { unnamed = held }
    run List<SourceNamingInput>.append(&mut namingInputs,
      SourceNamingInput {present: input.quality.present, names: names, unnamed: unnamed, operand: input.operand})
    at = at + usize.ONE
  }
  let naming = run SourcePolicy.naming(&mut rules.*, List<SourceNamingInput>.asSlice(&namingInputs))
  let mut parentGate = no
  if known && !stores { parentGate = naming.multiple }
  let mut parentInputs = List<SourceParentInput>.make()
  let mut parentEdges = List<SourceParentEdge>.make()
  at = usize.ZERO
  while at < inputs.length {
    let loan = &loans[inputs[at].loan]
    let mut seed = no
    if let Option<Shared<Lifetime>>.Some {value: borrowed} = &loan.borrowed {
      if proofContains(named, &borrowed) { seed = yes }
    }
    run List<SourceParentInput>.append(&mut parentInputs,
      SourceParentInput {present: inputs[at].quality.present, seed: seed, eligible: yes})
    if let Option<Shared<Lifetime>>.Some {value: parent} = &loan.parent {
      let mut candidate = usize.ZERO
      while candidate < inputs.length {
        if let Option<Shared<Lifetime>>.Some {value: borrowed} = &loans[inputs[candidate].loan].borrowed {
          if meetMember(&parent, &borrowed) {
            run List<SourceParentEdge>.append(&mut parentEdges,
              SourceParentEdge {child: at, parent: candidate, applicable: yes})
          }
        }
        candidate = candidate + usize.ONE
      }
    }
    at = at + usize.ONE
  }
  let parents = run SourcePolicy.parents(&mut rules.*, parentGate, List<SourceParentInput>.asSlice(&parentInputs),
    List<SourceParentEdge>.asSlice(&parentEdges))
  let mut qualities = List<SourceQuality>.make()
  at = usize.ZERO
  while at < inputs.length {
    run List<SourceQuality>.append(&mut qualities, inputs[at].quality)
    at = at + usize.ONE
  }
  let mut requirements = List<SourceRequirement>.make()
  let mut domainsKnown = true
  at = usize.ZERO
  while at < named.length {
    let domain = regionDomain(&named[at], owner, supplied)
    if domain == RegionDomain.Unknown { domainsKnown = false }
    if domain == RegionDomain.Local {
      let mut candidates = List<usize>.make()
      let mut input = usize.ZERO
      while input < inputs.length {
        let loan = &loans[inputs[input].loan]
        if let Option<Shared<Lifetime>>.Some {value: borrowed} = &loan.borrowed {
          if Lifetime.equalsShared(&borrowed, &named[at])
            && proofContains(List<Shared<Lifetime>>.asSlice(&loan.regions), &borrowed) {
            run List<usize>.append(&mut candidates, input)
          }
        }
        input = input + usize.ONE
      }
      run List<SourceRequirement>.append(&mut requirements, SourceRequirement {candidates: move candidates})
    }
    at = at + usize.ONE
  }
  let unnamedOperand = run SourceNaming.operand(&naming, &mut rules.*, usize.MAX)
  let mut originalGate = no
  if known && !stores && !outside { originalGate = naming.multiple }
  let positive: [SourceAtom; 1] = [originalGate]
  let negative: [SourceAtom; 2] = [naming.several, unnamedOperand]
  let completeGate = run SourcePolicy.conjunction(&mut rules.*, &positive, &negative)
  let complete = run SourcePolicy.completeSources(&mut rules.*, completeGate, domainsKnown,
    List<SourceQuality>.asSlice(&qualities), List<SourceRequirement>.asSlice(&requirements))
  return SourceResultSnapshot {required: move required, parents: move parents, naming: move naming, complete: complete}
}

// The regions a field or pattern binding read holds as its place is declared, the subject's type
// instantiated into the field's declared type before typing fits the read's own type to its use;
// unknown for any other read, or when the declared type's regions are unknown.
struct DeclaredRead {
  known: bool
  regions: List<Shared<Lifetime>>
}

effect fn declaredRead(nodes: &[Node], read: NodeId, owner: &DeclarationId) -> DeclaredRead
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut regions = List<Shared<Lifetime>>.make()
  let mut known = false
  if let NodeKind.Expression {form, ..} = &nodes[read.index].kind {
    if let Expression.Field {declared, ..} = &form {
      known = run bodyRetainedRegions(&declared, owner, &mut regions)
    } else if let Expression.PatternBinding {declared, ..} = &form {
      known = run bodyRetainedRegions(&declared, owner, &mut regions)
    }
  }
  return DeclaredRead {known: known, regions: move regions}
}

// The regions `result`'s value can retain; `false` when they are unknown, as for a callable, whose
// capture loans its type does not name. A type parameter bound outside the body, by the checked
// declaration or by one enclosing it (a method's impl, an anonymous body's enclosing function),
// retains no region of the body, alone or inside the result: it is instantiated before the body runs
// with a type that cannot name a region the body creates, and safe code obtains a value of it only as
// such a value. A region the body itself binds, a loan region or an invocation binder, is not erased.
effect fn resultRegions(nodes: &[Node], result: NodeId, owner: &DeclarationId, regions: &mut List<Shared<Lifetime>>) -> bool
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let found = expressionType(nodes, result)
  if let Option<Shared<Type>>.Some {value} = move found {
    if Shared<Type>.with<bool>(&value, callableValue) {
      return false
    }
    return run bodyRetainedRegions(&value, owner, &mut regions.*)
  }
  return false
}

// Types chosen outside this body cannot name one of its fresh loan regions. Apply the same
// parametricity proof to holders and projections as to call results.
effect fn bodyRetainedRegions(
  value: &Shared<Type>,
  owner: &DeclarationId,
  regions: &mut List<Shared<Lifetime>>
) -> bool
  ! OutOfMemoryError
  ? &mut Allocator | &mut Types {
  // Type parameters bound outside the body stand for types chosen before it runs, so they are
  // read as retaining nothing; what remains is the regions the result can hold of this body.
  let mut bindings = List<Binding>.make()
  let mut depth = DeclarationId.ownerCount(owner)
  while depth > usize.ZERO {
    let binder = run Shared<DeclarationId>.make(run DeclarationId.enclosing(owner, depth))
    let mut types = List<usize>.make()
    let mut lifetimes = List<usize>.make()
    let mut rows = List<usize>.make()
    let declaration = DeclarationId.copyShared(&binder)
    run Type.collectOwned(value, &declaration, &mut types, &mut lifetimes, &mut rows)
    let ordinals = List<usize>.asSlice(&types)
    let mut at = usize.ZERO
    while at < ordinals.length {
      run List<
        Binding
      >.append(
        &mut bindings,
        Binding {
          declaration: Shared<DeclarationId>.clone(&binder),
          ordinal: ordinals[at],
          value: Argument.Type { value: run Types.intern(Type.Unit) },
        }
      )
      at = at + usize.ONE
    }
    depth = depth - usize.ONE
  }
  if List<Binding>.length(&bindings) == usize.ZERO {
    return run retainedBy(value, owner, &mut regions.*)
  }
  let erased = run Type.applyBindings(value, List<Binding>.asSlice(&bindings), true)
  return run retainedBy(&erased, owner, &mut regions.*)
}

// Whether every atom is static or a parameter chosen outside this body. A result promising
// only these regions cannot retain owned body storage. Static source loans still remain live:
// their region is external too, so the filter does not erase them as fresh body loans.
fn externalRegions(regions: &[Shared<Lifetime>], owner: &DeclarationId) -> bool {
  let mut at = usize.ZERO
  while at < regions.length {
    let parameter = Lifetime.allAtoms(&regions[at], fn(atom: &Lifetime) -> bool {
      return match &atom.* {
        Lifetime.Static => true
        Lifetime.Parameter {declaration, ..} => DeclarationId.isPrefixOf(&declaration, owner)
        _ => false
      }
    })
    if !parameter {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

// Whether `regions` is known and every atom of it is a body region of the checked declaration, as
// typing gives a fresh borrow, even a reborrow through a reference parameter.
fn bodyRegions(regions: &[Shared<Lifetime>], owner: &DeclarationId) -> bool {
  if regions.length == usize.ZERO {
    return false
  }
  let mut at = usize.ZERO
  while at < regions.length {
    let local = Lifetime.allAtoms(&regions[at], fn(atom: &Lifetime) -> bool {
      return match &atom.* {
        Lifetime.Local {declaration, ..} => DeclarationId.equals(&declaration, owner)
        _ => false
      }
    })
    if !local {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

// The outlives facts a call's argument and result types imply by being well formed, which its
// callee may assume: a reference's or slice's referent outlives its region, and the arguments of
// a nominal may outlive one another by its declared bounds, so they are taken as one class. `known`
// is false when a type has a form this summary does not describe.
struct Implied {
  groups: List<ImpliedGroup>
  known: bool
}

// The atoms of one well-formedness fact: every member outlives every container atom, or, with no
// container, the members of one nominal may outlive one another.
struct ImpliedGroup {
  container: List<Shared<Lifetime>>
  members: List<Shared<Lifetime>>
}

// What a dropped loan's region proof can ground on: the loans naming a region the proof walks,
// and those regions. The walk past the drop cannot see where the dropped loan goes, so an access
// that conflicts with any of these loans after the drop contests every one of these regions.
struct UnretainedChain {
  dropped: usize
  loans: List<usize>
  regions: List<Shared<Lifetime>>
  unresolved: bool
}

fn noImplied() -> Implied {
  return Implied {groups: List<ImpliedGroup>.make(), known: false}
}

// The facts a direct call `result` implies, exactly: the body's open region relations and the
// outlives bounds its callee's signature implies (`impliedSignatureBounds`), which typing proved of
// the call. An immediate run implies those of the call it executes; any other node, nothing known.
effect fn signatureImplied(nodes: &[Node], premises: &[ImpliedGroup], settled: bool, result: NodeId) -> Implied
! OutOfMemoryError ? &mut Allocator {
  let mut call = result
  if let NodeKind.Expression {form: Expression.Run {value, access}, ..} = &nodes[result.index].kind {
    if access == RunAccess.Immediate { call = value }
  }
  if let NodeKind.Expression {form: Expression.DirectCall {implied: stated, ..}, ..} = &nodes[call.index].kind {
    let mut implied = Implied {groups: List<ImpliedGroup>.make(), known: settled}
    let mut premise = usize.ZERO
    while premise < premises.length {
      let mut members = List<Shared<Lifetime>>.make()
      run appendAllAtoms(&mut members, List<Shared<Lifetime>>.asSlice(&premises[premise].members))
      let mut container = List<Shared<Lifetime>>.make()
      run appendAllAtoms(&mut container, List<Shared<Lifetime>>.asSlice(&premises[premise].container))
      run List<ImpliedGroup>.append(&mut implied.groups, ImpliedGroup {container: move container, members: move members})
      premise = premise + usize.ONE
    }
    let facts = List<ImpliedOutlives>.asSlice(&stated)
    let mut fact = usize.ZERO
    while fact < facts.length {
      let mut members = List<Shared<Lifetime>>.make()
      run appendAllAtoms(&mut members, List<Shared<Lifetime>>.asSlice(&facts[fact].longer))
      let mut container = List<Shared<Lifetime>>.make()
      run appendAllAtoms(&mut container, List<Shared<Lifetime>>.asSlice(&facts[fact].shorter))
      run List<ImpliedGroup>.append(&mut implied.groups, ImpliedGroup {container: move container, members: move members})
      fact = fact + usize.ONE
    }
    return move implied
  }
  return noImplied()
}

// The facts a call implies: the body's open region relations and the well-formedness of the
// types of `arguments` and `result`.
effect fn callImplied(nodes: &[Node], premises: &[ImpliedGroup], settled: bool, arguments: &[NodeId], result: NodeId) -> Implied
! OutOfMemoryError ? &mut Allocator {
  let mut implied = Implied {groups: List<ImpliedGroup>.make(), known: settled}
  let mut premise = usize.ZERO
  while premise < premises.length {
    let mut members = List<Shared<Lifetime>>.make()
    run appendAllAtoms(&mut members, List<Shared<Lifetime>>.asSlice(&premises[premise].members))
    let mut container = List<Shared<Lifetime>>.make()
    run appendAllAtoms(&mut container, List<Shared<Lifetime>>.asSlice(&premises[premise].container))
    run List<ImpliedGroup>.append(&mut implied.groups, ImpliedGroup {container: move container, members: move members})
    premise = premise + usize.ONE
  }
  let mut atoms = List<Shared<Lifetime>>.make()
  let mut index = usize.ZERO
  while index <= arguments.length {
    let mut typed = Option<Shared<Type>>.none()
    if index < arguments.length { typed = expressionType(nodes, arguments[index]) } else { typed = expressionType(nodes, result) }
    if let Option<Shared<Type>>.Some {value} = move typed {
      run implies(&value, &mut implied, &mut atoms)
    } else {
      implied.known = false
    }
    index = index + usize.ONE
  }
  return move implied
}

effect fn appendAtoms(target: &mut List<Shared<Lifetime>>, region: &Shared<Lifetime>) -> () ! OutOfMemoryError ? &mut Allocator {
  let count = Lifetime.atomCount(region)
  let mut at = usize.ZERO
  while at < count {
    run List<Shared<Lifetime>>.append(&mut target.*, Lifetime.atomAt(region, at))
    at = at + usize.ONE
  }
  return ()
}

effect fn appendAllAtoms(target: &mut List<Shared<Lifetime>>, atoms: &[Shared<Lifetime>]) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < atoms.length {
    run List<Shared<Lifetime>>.append(&mut target.*, Shared<Lifetime>.clone(&atoms[at]))
    at = at + usize.ONE
  }
  return ()
}

// Records the facts `ty` implies and appends every atom it names to `atoms`.
effect fn implies(ty: &Shared<Type>, implied: &mut Implied, atoms: &mut List<Shared<Lifetime>>) -> ()
! OutOfMemoryError ? &mut Allocator {
  match move run Type.copy(ty) {
    Type.Primitive {..} => {}
    Type.Unit => {}
    // A type parameter bound outside the body names no body region (see `bodyRetainedRegions`).
    Type.Parameter {..} => {}
    Type.String {lifetime} => {
      run appendAtoms(&mut atoms.*, &lifetime)
    }
    Type.Reference {referent, lifetime, ..} => {
      run contained(&referent, &lifetime, &mut implied.*, &mut atoms.*)
    }
    Type.Slice {element, lifetime, ..} => {
      run contained(&element, &lifetime, &mut implied.*, &mut atoms.*)
    }
    Type.Array {element, ..} => {
      run implies(&element, &mut implied.*, &mut atoms.*)
    }
    Type.Nominal {arguments, ..} => {
      let mut inner = List<Shared<Lifetime>>.make()
      let listed = List<Argument>.asSlice(&arguments)
      let mut at = usize.ZERO
      while at < listed.length {
        match &listed[at] {
          Argument.Type {value} => {
            run implies(&value, &mut implied.*, &mut inner)
          }
          Argument.Lifetime {value} => {
            run appendAtoms(&mut inner, &value)
          }
          Argument.Row {..} => {
            implied.known = false
          }
        }
        at = at + usize.ONE
      }
      run appendAllAtoms(&mut atoms.*, List<Shared<Lifetime>>.asSlice(&inner))
      run List<ImpliedGroup>.append(&mut implied.groups, ImpliedGroup {container: List<Shared<Lifetime>>.make(), members: move inner})
    }
    _ => {
      implied.known = false
    }
  }
  return ()
}

// Records that every atom `inside` names outlives `region`.
effect fn contained(inside: &Shared<Type>, region: &Shared<Lifetime>, implied: &mut Implied, atoms: &mut List<Shared<Lifetime>>) -> ()
! OutOfMemoryError ? &mut Allocator {
  let mut inner = List<Shared<Lifetime>>.make()
  run implies(inside, &mut implied.*, &mut inner)
  let mut container = List<Shared<Lifetime>>.make()
  run appendAtoms(&mut container, region)
  run appendAllAtoms(&mut atoms.*, List<Shared<Lifetime>>.asSlice(&inner))
  run appendAllAtoms(&mut atoms.*, List<Shared<Lifetime>>.asSlice(&container))
  run List<ImpliedGroup>.append(&mut implied.groups, ImpliedGroup {container: move container, members: move inner})
  return ()
}

fn containsAtom(atoms: &[Shared<Lifetime>], atom: &Shared<Lifetime>) -> bool {
  let mut at = usize.ZERO
  while at < atoms.length {
    if Lifetime.equalsShared(&atoms[at], atom) {
      return true
    }
    at = at + usize.ONE
  }
  return false
}

// Whether a loan with body regions `from` may outlive a region of `named` through the facts
// `implied` records: the atoms the facts reach from `from` include one of `named`, or one from
// outside the body, whose premises are not read here.
effect fn mayOutlive(implied: &Implied, from: &[Shared<Lifetime>], named: &[Shared<Lifetime>], owner: &DeclarationId) -> bool
! OutOfMemoryError ? &mut Allocator {
  let mut reached = List<Shared<Lifetime>>.make()
  let mut at = usize.ZERO
  while at < from.length {
    run appendAtoms(&mut reached, &from[at])
    at = at + usize.ONE
  }
  let groups = List<ImpliedGroup>.asSlice(&implied.groups)
  let mut changed = true
  while changed {
    changed = false
    let mut group = usize.ZERO
    while group < groups.length {
      let members = List<Shared<Lifetime>>.asSlice(&groups[group].members)
      let mut entered = false
      let mut member = usize.ZERO
      while !entered && member < members.length {
        entered = containsAtom(List<Shared<Lifetime>>.asSlice(&reached), &members[member])
        member = member + usize.ONE
      }
      if entered {
        let mut targets = List<Shared<Lifetime>>.asSlice(&groups[group].container)
        if targets.length == usize.ZERO {
          targets = members
        }
        let mut target = usize.ZERO
        while target < targets.length {
          if !containsAtom(List<Shared<Lifetime>>.asSlice(&reached), &targets[target]) {
            run List<Shared<Lifetime>>.append(&mut reached, Shared<Lifetime>.clone(&targets[target]))
            changed = true
          }
          target = target + usize.ONE
        }
      }
      group = group + usize.ONE
    }
  }
  let atoms = List<Shared<Lifetime>>.asSlice(&reached)
  return !bodyRegions(atoms, owner) || sharesAtom(atoms, named)
}

effect fn sourceRegionVertex(vertices: &mut List<SourceRegionVertex>, region: &Shared<Lifetime>, rules: &mut SourceProgram)
  -> SourceAtom ! OutOfMemoryError ? &mut Allocator {
  let all = List<SourceRegionVertex>.asSlice(&vertices.*)
  let mut at = usize.ZERO
  while at < all.length {
    if Lifetime.equalsShared(&all[at].region, region) { return all[at].reached }
    at = at + usize.ONE
  }
  let reached = SourceProgram.atom(&mut rules.*)
  run List<SourceRegionVertex>.append(&mut vertices.*, SourceRegionVertex {region: Shared<Lifetime>.clone(region), reached: reached})
  return reached
}

// The same finite mayOutlive closure, with each signature group's actual earlier hold as
// its applicability. Reserving a possible type relation never makes that relation a fact.
effect fn sourceMayOutlive(groups: &[SourceImpliedGroup], from: &[Shared<Lifetime>], named: &[Shared<Lifetime>],
  owner: &DeclarationId, rules: &mut SourceProgram) -> SourceAtom ! OutOfMemoryError ? &mut Allocator {
  let mut vertices = List<SourceRegionVertex>.make()
  let empty = List<SourceAtom>.make()
  let none = List<SourceAtom>.asSlice(&empty)
  let mut at = usize.ZERO
  while at < from.length {
    let count = Lifetime.atomCount(&from[at])
    let mut each = usize.ZERO
    while each < count {
      let region = Lifetime.atomAt(&from[at], each)
      let seed = run sourceRegionVertex(&mut vertices, &region, &mut rules.*)
      run SourceProgram.fact(&mut rules.*, seed)
      each = each + usize.ONE
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < groups.length {
    let members = List<Shared<Lifetime>>.asSlice(&groups[at].group.members)
    let mut targets = List<Shared<Lifetime>>.asSlice(&groups[at].group.container)
    if targets.length == usize.ZERO { targets = members }
    let mut member = usize.ZERO
    while member < members.length {
      let entered = run sourceRegionVertex(&mut vertices, &members[member], &mut rules.*)
      let mut target = usize.ZERO
      while target < targets.length {
        let reached = run sourceRegionVertex(&mut vertices, &targets[target], &mut rules.*)
        let premise: [SourceAtom; 2] = [entered, groups[at].active]
        run SourceProgram.rule(&mut rules.*, reached, &premise, none)
        target = target + usize.ONE
      }
      member = member + usize.ONE
    }
    at = at + usize.ONE
  }
  let result = SourceProgram.atom(&mut rules.*)
  let all = List<SourceRegionVertex>.asSlice(&vertices)
  at = usize.ZERO
  while at < all.length {
    let singleton: [Shared<Lifetime>; 1] = [Shared<Lifetime>.clone(&all[at].region)]
    if !bodyRegions(&singleton, owner) || sharesAtom(&singleton, named) {
      let reached: [SourceAtom; 1] = [all[at].reached]
      run SourceProgram.rule(&mut rules.*, result, &reached, none)
    }
    at = at + usize.ONE
  }
  return result
}

// A caller supplies ONLY earlier whole-hold effects, at this read's observation version.
// No hold, any undescribed/unknown applicable hold, a possible reborrow, or an unresolved
// precision/source guard prevents the universal release proof.
effect fn sourceUnreachableField(nodes: &[Node], owner: &DeclarationId, loans: &[Loan], observation: &SourceObservation,
  snapshot: &[SourceQuality], position: usize, requirements: &[RetentionEdge], relations: &[ImpliedGroup], settled: bool,
  prior: &[SourceWholeHold], named: &[Shared<Lifetime>], rules: &mut SourceProgram) -> SourceAtom
! OutOfMemoryError ? &mut Allocator {
  let positions = List<SourceCarryPosition>.asSlice(&observation.positions)
  if position >= positions.length || snapshot.length != positions.length {
    return CompilerBug.panic(b"field release has no actual read observation")
  }
  let loan = &loans[positions[position].loan]
  let empty = List<SourceAtom>.make()
  let none = List<SourceAtom>.asSlice(&empty)
  let blocked = SourceProgram.atom(&mut rules.*)
  let mut at = usize.ZERO
  if let Option<Shared<Lifetime>>.Some {value: borrowed} = &loan.borrowed {
    at = usize.ZERO
    while at < positions.length {
      if at != position {
        if let Option<Shared<Lifetime>>.Some {value: parent} = &loans[positions[at].loan].parent {
          if meetMember(&parent, &borrowed) {
            let child: [SourceAtom; 1] = [snapshot[at].present]
            run SourceProgram.rule(&mut rules.*, blocked, &child, none)
          }
        }
      }
      at = at + usize.ONE
    }
  }
  return run sourceUnreachableLoan(nodes, owner, loans, positions[position].loan, snapshot[position],
    blocked, observation.unknown, requirements, relations, settled, prior, named, &mut rules.*)
}

// The same universal proof serves selected reads and rvalue projections. The caller
// supplies reborrow blockers from its complete, immutable holder observation.
effect fn sourceUnreachableLoan(nodes: &[Node], owner: &DeclarationId, loans: &[Loan], loanIndex: usize,
  quality: SourceQuality, reborrowed: SourceAtom, unknown: SourceAtom, requirements: &[RetentionEdge],
  relations: &[ImpliedGroup], settled: bool, prior: &[SourceWholeHold], named: &[Shared<Lifetime>],
  rules: &mut SourceProgram) -> SourceAtom ! OutOfMemoryError ? &mut Allocator {
  let no = SourceProgram.atom(&mut rules.*)
  let loan = &loans[loanIndex]
  let regions = List<Shared<Lifetime>>.asSlice(&loan.regions)
  if !settled || regions.length == usize.ZERO || !bodyRegions(regions, owner) || sharesAtom(regions, named) { return no }
  let mut missing = false
  if let Option<Shared<Lifetime>>.Some {value: borrowed} = &loan.borrowed {
    missing = retentionOrdinal(&borrowed, owner) != usize.MAX && !sharesAtom(regions, named)
  }
  if missing {
    let reached = run retentionClosure(named, owner, requirements)
    if requiredLoan(loan, owner, List<usize>.asSlice(&reached)) { return no }
  }
  let empty = List<SourceAtom>.make()
  let none = List<SourceAtom>.asSlice(&empty)
  let blocked = SourceProgram.atom(&mut rules.*)
  let child: [SourceAtom; 1] = [reborrowed]
  run SourceProgram.rule(&mut rules.*, blocked, &child, none)
  let found = SourceProgram.atom(&mut rules.*)
  let mut groups = List<SourceImpliedGroup>.make()
  let mut at = usize.ZERO
  while at < prior.length {
    if prior[at].loan == loanIndex {
      let applicable: [SourceAtom; 1] = [prior[at].active]
      run SourceProgram.rule(&mut rules.*, found, &applicable, none)
      let described: [SourceAtom; 1] = [prior[at].described]
      run SourceProgram.rule(&mut rules.*, blocked, &applicable, &described)
      let mut facts = run signatureImplied(nodes, relations, settled, prior[at].result)
      if !facts.known { run SourceProgram.rule(&mut rules.*, blocked, &applicable, none) }
      while List<ImpliedGroup>.length(&facts.groups) != usize.ZERO {
        run List<SourceImpliedGroup>.append(&mut groups, SourceImpliedGroup {
          group: List<ImpliedGroup>.remove(&mut facts.groups, usize.ZERO), active: prior[at].active})
      }
    }
    at = at + usize.ONE
  }
  let possible = run sourceMayOutlive(List<SourceImpliedGroup>.asSlice(&groups), regions, named, owner, &mut rules.*)
  let required: [SourceAtom; 2] = [quality.present, found]
  let forbidden: [SourceAtom; 5] = [quality.stored, quality.alternatives, blocked, possible, unknown]
  return run SourcePolicy.conjunction(&mut rules.*, &required, &forbidden)
}

// Whether any atom of `left` is an atom of `right`.
fn sharesAtom(left: &[Shared<Lifetime>], right: &[Shared<Lifetime>]) -> bool {
  let mut first = usize.ZERO
  while first < left.length {
    let leftCount = Lifetime.atomCount(&left[first])
    let mut leftAt = usize.ZERO
    while leftAt < leftCount {
      let atom = Lifetime.atomAt(&left[first], leftAt)
      let mut second = usize.ZERO
      while second < right.length {
        let rightCount = Lifetime.atomCount(&right[second])
        let mut rightAt = usize.ZERO
        while rightAt < rightCount {
          let other = Lifetime.atomAt(&right[second], rightAt)
          if Lifetime.equalsShared(&atom, &other) {
            return true
          }
          rightAt = rightAt + usize.ONE
        }
        second = second + usize.ONE
      }
      leftAt = leftAt + usize.ONE
    }
    first = first + usize.ONE
  }
  return false
}

effect fn fieldIndexes(fields: &[AggregateField]) -> List<usize> ! OutOfMemoryError ? &mut Allocator {
  let mut indexes = List<usize>.make()
  let mut at = usize.ZERO
  while at < fields.length {
    run List<usize>.append(&mut indexes, fields[at].index)
    at = at + usize.ONE
  }
  return move indexes
}

// Where each field, in evaluation order, can have what it carries stored, from per-ordinal answers.
// A field typing recorded no answer for can hold anywhere.
effect fn fieldHoldable(fields: &[AggregateField], holdable: &[CaptureHold]) -> List<CaptureHold> ! OutOfMemoryError ? &mut Allocator {
  let mut ordered = List<CaptureHold>.make()
  let mut at = usize.ZERO
  while at < fields.length {
    let mut hold = CaptureHold.Any
    if fields[at].index < holdable.length { hold = holdable[fields[at].index] }
    run List<CaptureHold>.append(&mut ordered, hold)
    at = at + usize.ONE
  }
  return move ordered
}

effect fn fieldValues(fields: &[AggregateField]) -> List<NodeId> ! OutOfMemoryError ? &mut Allocator {
  let mut values = List<NodeId>.make()
  let mut at = usize.ZERO
  while at < fields.length {
    run List<NodeId>.append(&mut values, fields[at].value)
    at = at + usize.ONE
  }
  return move values
}

// The referent captures of an environment, each naming the position of its field's operand.
effect fn referentOperands(fields: &[AggregateField], referents: &[ReferentCapture]) -> List<ReferentCapture>
! OutOfMemoryError ? &mut Allocator {
  let mut operands = List<ReferentCapture>.make()
  let mut at = usize.ZERO
  while at < referents.length {
    let mut position = usize.ZERO
    while position < fields.length && fields[position].index != referents[at].field {
      position = position + usize.ONE
    }
    run List<ReferentCapture>.append(&mut operands, ReferentCapture {field: position, access: referents[at].access})
    at = at + usize.ONE
  }
  return move operands
}

effect fn single(value: NodeId) -> List<NodeId> ! OutOfMemoryError ? &mut Allocator {
  let mut values = List<NodeId>.make()
  run List<NodeId>.append(&mut values, value)
  return move values
}

effect fn copyIds(values: &[NodeId]) -> List<NodeId> ! OutOfMemoryError ? &mut Allocator {
  let mut copied = List<NodeId>.make()
  let mut at = usize.ZERO
  while at < values.length {
    run List<NodeId>.append(&mut copied, values[at])
    at = at + usize.ONE
  }
  return move copied
}

// Immutable source-to-extent closure for selected retention slots.
// These regions decide eligibility only; they never pair sources or establish an address.
effect fn keptOrigins(loan: &Loan, owner: &DeclarationId, edges: &[RetentionEdge]) -> KeptOrigins
! OutOfMemoryError ? &mut Allocator {
  let mut source = List<Shared<Lifetime>>.make()
  if let Option<Shared<Lifetime>>.Some {value} = &loan.borrowed {
    run List<Shared<Lifetime>>.append(&mut source, Shared<Lifetime>.clone(&value))
  } else {
    run appendAllAtoms(&mut source, List<Shared<Lifetime>>.asSlice(&loan.regions))
  }
  // A prior store or coercion can shorten the loan into this source position. Follow only the
  // finite requirements in their source-to-extent direction; they retain a loan, never prove it.
  let mut reached = List<usize>.make()
  let origins = List<Shared<Lifetime>>.asSlice(&source)
  let mut at = usize.ZERO
  while at < origins.length {
    let ordinal = retentionOrdinal(&origins[at], owner)
    if ordinal != usize.MAX && !retentionListed(List<usize>.asSlice(&reached), ordinal) {
      run List<usize>.append(&mut reached, ordinal)
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < List<usize>.length(&reached) {
    let origin = List<usize>.asSlice(&reached)[at]
    let mut edge = usize.ZERO
    while edge < edges.length {
      if edges[edge].source == origin && !retentionListed(List<usize>.asSlice(&reached), edges[edge].extent) {
        run List<usize>.append(&mut reached, edges[edge].extent)
      }
      edge = edge + usize.ONE
    }
    at = at + usize.ONE
  }
  return KeptOrigins {regions: move source, reached: move reached}
}

// One explicitly selected original KeptSlot. Preparation only freezes this coordinate;
// ownership retains the mayHoldLoan, directed-retention and exact source-path judgments.
fn keptSlotIn(slot: &KeptSlot, loan: &Loan, carry: SourceSlotValue, paths: &[List<Step>], owner: &DeclarationId,
  source: &[Shared<Lifetime>], reached: &[usize], named: &[Shared<Lifetime>]) -> bool {
  let mut fits = true
  if let Option<Shared<Type>>.Some {value: referent} = &loan.referent {
    fits = Type.mayHoldLoan(slot.view, &slot.referent, slot.exclusive, &referent, loan.exclusive)
  }
  let sources = List<Shared<Lifetime>>.asSlice(&slot.source)
  let mut enters = sharesAtom(source, sources)
  let mut each = usize.ZERO
  while !enters && each < sources.length {
    let ordinal = retentionOrdinal(&sources[each], owner)
    enters = ordinal != usize.MAX && retentionListed(reached, ordinal)
    each = each + usize.ONE
  }
  if carry.direct && carry.field != usize.MAX {
    let matched = transferSlotPath(List<Step>.asSlice(&paths[carry.field]), List<KeptStep>.asSlice(&slot.path), slot.view)
    if matched != SlotPath.Unknown { enters = matched == SlotPath.Same }
  }
  return fits && enters && sharesAtom(List<Shared<Lifetime>>.asSlice(&slot.kept), named)
}

fn destinationSlotKeeps(source: &KeptSlot, target: &KeptSlot, paths: &[List<Step>], destination: SourceSlotValue,
  named: &[Shared<Lifetime>]) -> bool {
  return destinationSlot(paths, destination, target)
    && sharesAtom(List<Shared<Lifetime>>.asSlice(&target.source), named)
    && sharesAtom(List<Shared<Lifetime>>.asSlice(&source.kept), List<Shared<Lifetime>>.asSlice(&target.source))
    && (!source.view || Type.mayHoldLoan(target.view, &target.referent, target.exclusive, &source.referent, source.exclusive))
}

effect fn destinationPlaceField(recorded: &Shared<List<KeptRegions>>, place: &Place, paths: &mut List<List<Step>>, destination: SourceSlotValue, slot: usize) -> usize
! OutOfMemoryError ? &mut Allocator {
  if !destination.direct || destination.field == usize.MAX { return usize.MAX }
  let lent = run copySteps(List<Step>.asSlice(&List<List<Step>>.asSlice(&paths.*)[destination.field]))
  let prefix = List<Step>.asSlice(&lent)
  if !exactPath(prefix) { return usize.MAX }
  if !exactPath(List<Step>.asSlice(&place.steps)) { return usize.MAX }
  let mut path = run copySteps(List<Step>.asSlice(&place.steps))
  let count = Shared<List<KeptRegions>>.with<usize>(recorded, fn(values: &List<KeptRegions>) -> usize {
    return List<KeptStep>.length(&List<KeptSlot>.asSlice(&List<KeptRegions>.asSlice(values)[destination.operand].slots)[slot].path)
  })
  let mut at = prefix.length
  if at >= count { return usize.MAX }
  let boundary = Shared<List<KeptRegions>>.with<KeptStep>(recorded, fn(values: &List<KeptRegions>) -> KeptStep {
    return List<KeptStep>.asSlice(&List<KeptSlot>.asSlice(&List<KeptRegions>.asSlice(values)[destination.operand].slots)[slot].path)[at]
  })
  if boundary.kind != KeptStepKind.Referent { return usize.MAX }
  at = at + usize.ONE
  while at < count {
    let step = Shared<List<KeptRegions>>.with<KeptStep>(recorded, fn(values: &List<KeptRegions>) -> KeptStep {
      return List<KeptStep>.asSlice(&List<KeptSlot>.asSlice(&List<KeptRegions>.asSlice(values)[destination.operand].slots)[slot].path)[at]
    })
    if step.kind != KeptStepKind.Field { break }
    run List<Step>.append(&mut path, fieldStep(step.index))
    at = at + usize.ONE
  }
  if List<Step>.length(&path) == usize.ZERO { return usize.ZERO }
  let field = List<List<Step>>.length(&paths.*)
  run List<List<Step>>.append(&mut paths.*, move path)
  return field
}

// A lent reference is not itself writable holder contents. Known aggregate paths locate that
// reference within the operand; contents begin at its Referent step. Opaque ancestors and unknown
// paths can reach storage we cannot place, so they remain possible destinations.
fn destinationSlot(paths: &[List<Step>], carry: SourceSlotValue, slot: &KeptSlot) -> bool {
  let target = List<KeptStep>.asSlice(&slot.path)
  if !carry.direct || carry.field == usize.MAX { return !slot.view || target.length != usize.ZERO }
  let lent = List<Step>.asSlice(&paths[carry.field])
  let mut at = usize.ZERO
  while at < lent.length {
    if at >= target.length { return !slot.view }
    if target[at].kind != KeptStepKind.Field || lent[at].kind == StepKind.Referent
      || lent[at].kind == StepKind.AnyElement || lent[at].kind == StepKind.RepeatedElement { return true }
    if lent[at].kind != StepKind.Field || target[at].index != lent[at].ordinal { return false }
    at = at + usize.ONE
  }
  if at == target.length { return !slot.view }
  return target[at].kind == KeptStepKind.Referent || target[at].kind == KeptStepKind.Unknown
}

// A known sibling difference excludes transfer only before every indirect/unknown element
// boundary. This is a path predicate, never a region-equality or read-ID-only inference.
fn excludedTransferPaths(held: &[Step], used: &[Step]) -> bool {
  let mut at = usize.ZERO
  while at < held.length && at < used.length {
    if held[at].kind == StepKind.Referent || used[at].kind == StepKind.Referent
      || held[at].kind == StepKind.AnyElement || used[at].kind == StepKind.AnyElement
      || held[at].kind == StepKind.RepeatedElement || used[at].kind == StepKind.RepeatedElement { return false }
    if held[at].kind == used[at].kind && held[at].ordinal != used[at].ordinal { return true }
    at = at + usize.ONE
  }
  return false
}

enum SlotPath { Unknown, Same, Different }

// A direct carried reference occupies exactly this source sub-place, even if parameter coercion
// shortened its region. Opaque slots may contain it below their prefix. Reference and unknown
// element/union boundaries leave region correspondence to decide: they cannot prove field identity.
fn transferSlotPath(loan: &[Step], slot: &[KeptStep], view: bool) -> SlotPath {
  let mut at = usize.ZERO
  while at < slot.length {
    if slot[at].kind == KeptStepKind.Unknown || slot[at].kind == KeptStepKind.Referent
      || slot[at].kind == KeptStepKind.Element { return SlotPath.Unknown }
    if at >= loan.length { return SlotPath.Different }
    if loan[at].kind == StepKind.Referent || loan[at].kind == StepKind.AnyElement
      || loan[at].kind == StepKind.RepeatedElement { return SlotPath.Unknown }
    if loan[at].kind != StepKind.Field || loan[at].ordinal != slot[at].index { return SlotPath.Different }
    at = at + usize.ONE
  }
  if view && loan.length != slot.length { return SlotPath.Different }
  return SlotPath.Same
}

// Appends the regions a captured value can store into, when typing recorded its type. A captured
// callable stores only through what its contract's parameters reach.
effect fn storedRegionsOf(nodes: &[Node], node: NodeId, stored: &mut List<Shared<Lifetime>>) -> () ! OutOfMemoryError ? &mut Allocator {
  if let Option<Shared<Type>>.Some {value} = move expressionType(nodes, node) { run Type.callableStoredRegions(&value, &mut stored.*) }
  return ()
}

// Whether a node constructs a callable value from its captures: a closure or an `effect` block.
fn isCallable(nodes: &[Node], id: NodeId) -> bool {
  if let NodeKind.Expression {form, ..} = &nodes[id.index].kind {
    if let Expression.Callable {..} = &form {
      return true
    }
  }
  return false
}

// Whether a type is an Effect type.
fn effectType(ty: &Type) -> bool {
  return match &ty.* {
    Type.Effect {..} => true
    Type.EffectComposite {..} => true
    Type.EffectJoin {..} => true
    _ => false
  }
}

// Whether a callable value of this type is an Effect: an `effect` block's value, or an Effect an
// `effect fn` call constructs.
fn effectBlock(ty: &Type) -> bool {
  return match &ty.* {
    Type.CallableValue {contract, ..} => Shared<Type>.with<bool>(&contract, effectType)
    _ => false
  }
}

// Whether a type is a reference, whose referent's storage another place owns.
fn referenceType(ty: &Type) -> bool {
  return match &ty.* {
    Type.Reference {..} => true
    _ => false
  }
}

// Whether a local of this type is a callable value in any of its typed forms.
fn callableValue(ty: &Type) -> bool {
  return match &ty.* {
    Type.Callable {..} => true
    Type.CallableValue {..} => true
    Type.CallableSchema {..} => true
    Type.CallableStage {..} => true
    Type.CallableResult {..} => true
    Type.CallableOrigin {..} => true
    Type.CallableWitnessResult {..} => true
    Type.CallableView {..} => true
    _ => false
  }
}

fn localType(locals: &[Local], local: usize) -> Shared<Type> {
  return Shared<Type>.clone(&locals[local].ty)
}

// The node shape `visit` dispatches on, read without holding a borrow of the node across calls.
union Shape {
  Leaf,
  Outside {reason: BorrowStatus},
  ReadPlace,
  Borrow {access: Access, value: NodeId},
  Move {value: NodeId, consumed: bool},
  // `places` are the field or element indexes of an aggregate's operands, in order; usize.MAX
  // denotes all repeated elements. Empty for any other value built from operands.
  Operands {values: List<NodeId>, places: List<usize>, member: usize},
  // `&&` or `||`: the right operand runs on one path, and its temporaries end with it.
  ShortCircuit {left: NodeId, right: NodeId},
  PassThrough {value: NodeId},
  // `signature` marks a call to a declaration or interface operation, whose written signature
  // types its arguments and result.
  Call {arguments: List<NodeId>, receiver: usize, exact: bool, signature: bool},
  Invoke {callee: NodeId, arguments: List<NodeId>, pipeline: bool, exclusive: bool},
  // `referents` name their operands by position.
  // `holdable` says, per value, where the callable could store a loan it carries; empty when typing
  // recorded nothing, which lets every value be stored anywhere. `body` is the status of the callable's
  // own anonymous body, `Checked` for one with none.
  Construct {values: List<NodeId>, referents: List<ReferentCapture>, staged: bool, holdable: List<CaptureHold>, body: BorrowStatus},
  Defer {callee: NodeId, arguments: List<NodeId>, pipeline: bool, mode: CallableMode},
  Binding {local: usize, initializer: NodeId, mutable: bool},
  Assignment {local: usize, value: NodeId},
  PlaceAssignment {target: NodeId, value: NodeId},
  Displace {target: NodeId, value: NodeId},
  Exit {value: Option<NodeId>},
  Drop {value: NodeId, consumed: bool},
  Branch {condition: NodeId, thenBranch: NodeId, elseBranch: Option<NodeId>},
  While {condition: NodeId, body: NodeId},
  Break,
  Continue,
  // A statement that failed to check in a rejected body. No edge leaves it, so no move or loan
  // crosses a statement whose effects are unknown. When it surely let a path continue, the
  // statement after it resumes from the body's entry and the statements after it are still
  // checked among themselves; otherwise they stay unreached, as after a `return`.
  Recovered {resumes: bool},
  Block {statements: List<NodeId>},
  Match {subject: NodeId, access: Scrutinee, arms: List<ArmShape>, syntax: MatchSyntax},
}

// How a match reaches its subject, read from `SubjectAccess` without holding the node.
enum Scrutinee {
  // A bare match copies the subject; `match move` of a value with no place consumes it.
  Value,
  // `match move` of a place moves it.
  Moved,
  // `match &` reads the subject place.
  Shared,
  // `match &mut` updates it.
  Exclusive,
  // `match place` inspects its tag.
  Place,
}

struct ArmShape {
  guard: Option<NodeId>
  result: NodeId
  // Whether the arm's pattern declares a binding.
  binds: bool
}

fn scrutineeOf(access: &SubjectAccess) -> Scrutinee {
  return match &access.* {
    SubjectAccess.Copy => Scrutinee.Value
    SubjectAccess.Consume {consumed} => {
      if hasPlace(&consumed) {
        return Scrutinee.Moved
      }
      return Scrutinee.Value
    }
    SubjectAccess.Place {access: binding} => {
      if binding == BindingAccess.Shared {
        return Scrutinee.Shared
      }
      if binding == BindingAccess.Exclusive {
        return Scrutinee.Exclusive
      }
      return Scrutinee.Place
    }
  }
}

effect fn armShapes(arms: &[MatchArm]) -> List<ArmShape> ! OutOfMemoryError ? &mut Allocator {
  let mut shapes = List<ArmShape>.make()
  let mut at = usize.ZERO
  while at < arms.length {
    run List<ArmShape>.append(&mut shapes, ArmShape {guard: copyNode(&arms[at].guard), result: arms[at].result,
      binds: List<NodeId>.length(&arms[at].bindings) > usize.ZERO})
    at = at + usize.ONE
  }
  return move shapes
}

effect fn shapeOf(nodes: &[Node], id: NodeId) -> Shape ! OutOfMemoryError ? &mut Allocator {
  return match &nodes[id.index].kind {
    NodeKind.Expression {form, ty} => {
      // A named function's section is an aggregate of its captured operands (CALLABLE-001).
      if let Expression.Aggregate {fields, section, ..} = &form {
        if Shared<Type>.with<bool>(&ty, callableValue) {
          return Shape.Construct {values: run fieldValues(List<AggregateField>.asSlice(&fields)), referents: List<ReferentCapture>.make(), holdable: List<CaptureHold>.make(),
            staged: match &section { Option<SectionRetention>.Some {..} => true _ => false }, body: BorrowStatus.Checked}
        }
      }
      // An immediate run is exactly the one call it executes (EFF-003): the Effect that call
      // constructs is a temporary only this run consumes, so its operands are the call's arguments
      // and the run node is the call's result (EFFECT-OWN-001, BORROW-004).
      if let Expression.Run {value, access} = &form {
        if access == RunAccess.Immediate {
          if let NodeKind.Expression {form: operand, ..} = &nodes[value.index].kind {
            // Running an `effect fn` value's invocation in place invokes that value (CALLABLE-002).
            if let Expression.CallableCall {callee, mode, arguments, pipeline, ..} = &operand {
              return Shape.Invoke {callee: callee, arguments: run copyIds(List<NodeId>.asSlice(&arguments)), pipeline: pipeline,
                exclusive: mode == CallableMode.Mutable}
            }
            // The run's result is the call's success value, which stores none of its operands
            // beyond what its own type retains.
            if let Expression.DirectCall {arguments, receiverPass, ..} = &operand {
              return Shape.Call {arguments: run copyIds(List<NodeId>.asSlice(&arguments)), receiver: receiverOf(&receiverPass), exact: false,
                signature: true}
            }
            if let Expression.InterfaceCall {arguments, receiverPass, ..} = &operand {
              return Shape.Call {arguments: run copyIds(List<NodeId>.asSlice(&arguments)), receiver: receiverOf(&receiverPass), exact: false,
                signature: true}
            }
            // A drive retains its operands in an opaque Effect until activation. Only this
            // immediate run can consume all operand/capture loans at the S2 call point.
            if let Expression.StorageCall {operation, arguments, ..} = &operand {
              if operation == StorageOperation.ExecutionDrive {
                return Shape.Call {arguments: run copyIds(List<NodeId>.asSlice(&arguments)), receiver: usize.ZERO, exact: false,
                  signature: false}
              }
            }
            return run expressionShape(&operand)
          }
        }
      }
      return run expressionShape(&form)
    }
    NodeKind.LocalBinding {local, initializer} => Shape.Binding {local: local.index, initializer: initializer, mutable: false}
    NodeKind.MutableBinding {local, initializer} => Shape.Binding {local: local.index, initializer: initializer, mutable: true}
    NodeKind.Assignment {local, value} => Shape.Assignment {local: local.index, value: value}
    NodeKind.PlaceAssignment {target, value} => Shape.PlaceAssignment {target: target, value: value}
    NodeKind.Return {value} => Shape.Exit {value: copyNode(&value)}
    NodeKind.Fail {value} => Shape.Exit {value: Option<NodeId>.some(value)}
    NodeKind.Drop {value, consumed} => Shape.Drop {value: value, consumed: hasPlace(&consumed)}
    NodeKind.Branch {condition, thenBranch, elseBranch, ..} => Shape.Branch {condition: condition, thenBranch: thenBranch, elseBranch: copyNode(&elseBranch)}
    NodeKind.While {condition, body} => Shape.While {condition: condition, body: body}
    NodeKind.Break => Shape.Break
    NodeKind.Continue => Shape.Continue
    NodeKind.Recovered {resumes} => Shape.Recovered {resumes: resumes}
    NodeKind.Block {statements, ..} => Shape.Block {statements: run copyIds(List<NodeId>.asSlice(&statements))}
  }
}

fn copyNode(value: &Option<NodeId>) -> Option<NodeId> {
  if let Option<NodeId>.Some {value: node} = &value.* {
    return Option<NodeId>.some(node)
  }
  return Option<NodeId>.none()
}

// The receiver pass of a call: 0 none, 1 shared, 2 mutable, 3 taking.
fn receiverOf(value: &Option<ReceiverPass>) -> usize {
  if let Option<ReceiverPass>.Some {value: pass} = &value.* {
    if pass == ReceiverPass.Shared {
      return usize.ONE
    }
    if pass == ReceiverPass.Mutable {
      return 2
    }
    return 3
  }
  return usize.ZERO
}

fn hasPlace(consumed: &Option<ConsumedPlace>) -> bool {
  return match &consumed.* {
    Option<ConsumedPlace>.Some {..} => true
    Option<ConsumedPlace>.None => false
  }
}

effect fn expressionShape(form: &Expression) -> Shape ! OutOfMemoryError ? &mut Allocator {
  return match &form.* {
    Expression.Local {..} => Shape.ReadPlace
    Expression.Field {..} => Shape.ReadPlace
    Expression.Index {..} => Shape.ReadPlace
    Expression.Dereference {..} => Shape.ReadPlace
    Expression.Borrow {access, value} => Shape.Borrow {access: access, value: value}
    Expression.Move {value, consumed} => Shape.Move {value: value, consumed: hasPlace(&consumed)}
    Expression.PointerWeaken {value} => Shape.PassThrough {value: value}
    Expression.ArraySlice {value, ..} => Shape.PassThrough {value: value}
    Expression.SliceLength {value} => Shape.Operands {values: run single(value), places: List<usize>.make(), member: usize.MAX}
    Expression.ArrayLength {value, ..} => Shape.Operands {values: run single(value), places: List<usize>.make(), member: usize.MAX}
    Expression.ArrayRepeat {value, count} => {
      if count == usize.ZERO { return Shape.Drop {value: value, consumed: false} }
      let mut places = List<usize>.make()
      let mut element = usize.MAX
      if count == usize.ONE { element = usize.ZERO }
      run List<usize>.append(&mut places, element)
      return Shape.Operands {values: run single(value), places: move places, member: usize.MAX}
    }
    Expression.EnumValue {value} => Shape.Operands {values: run single(value), places: List<usize>.make(), member: usize.MAX}
    Expression.UnionInject {value, ..} => Shape.Operands {values: run single(value), places: List<usize>.make(), member: usize.MAX}
    Expression.UnionWiden {value} => Shape.Operands {values: run single(value), places: List<usize>.make(), member: usize.MAX}
    Expression.ConcretePrefix {operand, ..} => Shape.Operands {values: run single(operand), places: List<usize>.make(), member: usize.MAX}
    Expression.CompileError {message} => Shape.Operands {values: run single(message), places: List<usize>.make(), member: usize.MAX}
    Expression.ConcreteInfix {operator, left, right} => {
      if operator == InfixOperator.And || operator == InfixOperator.Or {
        return Shape.ShortCircuit {left: left, right: right}
      }
      let mut values = run single(left)
      run List<NodeId>.append(&mut values, right)
      return Shape.Operands {values: move values, places: List<usize>.make(), member: usize.MAX}
    }
    Expression.Aggregate {fields, ..} => Shape.Operands {
      values: run fieldValues(List<AggregateField>.asSlice(&fields)), places: run fieldIndexes(List<AggregateField>.asSlice(&fields)), member: usize.MAX,
    }
    Expression.VariantConstruct {tag, fields} => Shape.Operands {
      values: run fieldValues(List<AggregateField>.asSlice(&fields)), places: run fieldIndexes(List<AggregateField>.asSlice(&fields)), member: tag,
    }
    // An `effect fn` call's Effect stores exactly its written arguments (EFFECT-OWN-001).
    Expression.DirectCall {arguments, receiverPass, constructs, ..} => Shape.Call {
      arguments: run copyIds(List<NodeId>.asSlice(&arguments)), receiver: receiverOf(&receiverPass), exact: constructs, signature: true,
    }
    Expression.InterfaceCall {arguments, receiverPass, isEffect, ..} => Shape.Call {
      arguments: run copyIds(List<NodeId>.asSlice(&arguments)), receiver: receiverOf(&receiverPass), exact: isEffect, signature: true,
    }
    Expression.ForeignCall {arguments, ..} => Shape.Call {
      arguments: run copyIds(List<NodeId>.asSlice(&arguments)), receiver: usize.ZERO, exact: false, signature: false,
    }
    Expression.IntrinsicCall {arguments, ..} => Shape.Call {
      arguments: run copyIds(List<NodeId>.asSlice(&arguments)), receiver: usize.ZERO, exact: false, signature: false,
    }
    Expression.Integer {..} => Shape.Leaf
    Expression.Float {..} => Shape.Leaf
    Expression.Text {..} => Shape.Leaf
    Expression.Boolean {..} => Shape.Leaf
    Expression.Unit => Shape.Leaf
    Expression.Embedded {..} => Shape.Leaf
    Expression.EnumMember {..} => Shape.Leaf
    Expression.Constant {..} => Shape.Leaf
    Expression.ForeignStatic {..} => Shape.Leaf
    Expression.ForeignAddress {..} => Shape.Leaf
    // An anonymous body that stores one captured loan where another capture reaches needs a
    // relation between two body regions, which no premise of its own proves, so a body the borrow
    // check closed stores none (ANON-OWN-001).
    Expression.Callable {fields, referents, holdable, body, ..} => Shape.Construct {
      values: run fieldValues(List<AggregateField>.asSlice(&fields)),
      referents: run referentOperands(List<AggregateField>.asSlice(&fields), List<ReferentCapture>.asSlice(&referents)), staged: false,
      holdable: run fieldHoldable(List<AggregateField>.asSlice(&fields), List<CaptureHold>.asSlice(&holdable)),
      body: Shared<TypedBody>.with<BorrowStatus>(&body, TypedBody.borrowStatus),
    }
    Expression.StagedCallable {callee, arguments, ..} => {
      let mut values = run single(callee)
      let supplied = List<NodeId>.asSlice(&arguments)
      let mut at = usize.ZERO
      while at < supplied.length {
        run List<NodeId>.append(&mut values, supplied[at])
        at = at + usize.ONE
      }
      return Shape.Construct {values: move values, referents: List<ReferentCapture>.make(), staged: true, holdable: List<CaptureHold>.make(), body: BorrowStatus.Checked}
    }
    Expression.CallableCall {callee, mode, arguments, pipeline, constructs, ..} => {
      // Invoking an `effect fn` value without running it constructs an Effect that stores its
      // operands (EFF-001).
      if constructs {
        return Shape.Defer {callee: callee, arguments: run copyIds(List<NodeId>.asSlice(&arguments)), pipeline: pipeline, mode: mode}
      }
      return Shape.Invoke {callee: callee, arguments: run copyIds(List<NodeId>.asSlice(&arguments)), pipeline: pipeline,
        exclusive: mode == CallableMode.Mutable}
    }
    // A stored Effect's run invokes the Effect value with the access its contract grants
    // (EFFECT-OWN-002): a shared Effect is read, a `mut Effect` place is borrowed exclusively, and a
    // `once Effect` operand is already a typed move. The loans its environment holds stay live
    // through the run (EFFECT-OWN-001, CALLABLE-003).
    Expression.Run {value, access} => Shape.Invoke {callee: value, arguments: List<NodeId>.make(), pipeline: false,
      exclusive: access == RunAccess.Exclusive}
    Expression.Match {subject, access, arms, syntax, ..} => Shape.Match {
      subject: subject, access: scrutineeOf(&access), arms: run armShapes(List<MatchArm>.asSlice(&arms)), syntax: syntax,
    }
    Expression.PatternBinding {..} => Shape.ReadPlace
    // A storage primitive whose contract names every region its result reaches is a call to that
    // contract; `unsafe` discharges only its memory obligations, never an aliasing one. Each result
    // that views or reaches an operand names that operand's region, so the call's retention rules
    // hold its loans.
    // `sharedWithMut` is such a call: it consumes its two callbacks, whose capture loans are live
    // through it, and the `&mut T` it lends comes from the runtime conflict check (SHARED-004), not
    // from a place this body holds. Callback result retention is checked against that invocation's
    // contract; Semantic.buildFrom judges every reached callback's suspension and notification
    // escapes with localSharedEscapes before emission (OWN0016, SHARED-003), even if this body is
    // region-closed and Checked. Notifications have the same independent gate; see
    // SemanticLoweringCases.localSharedAccessRejectsEveryReachedEscape's exact OWN0016 spans.
    // Current and relinquish have no operands or capture loans. `executionFromAllocation` consumes its
    // allocation, body, readiness state and endpoint; typing proves the last three
    // `Intrinsic.Detached` (EXEC-004), so the package retains no loan of the caller beyond what its
    // `Intrinsic.Execution<A>` result names. `slotAddress` consumes its slot, and its `*mut T` result
    // names no region, so it holds no loan: the address keeps no storage alive, and every access
    // through it is `unsafe` and proves its own validity.
    Expression.StorageCall {operation, arguments, ..} => {
      // `replace` writes its place operand and yields the value it displaces.
      if operation == StorageOperation.Replace {
        let operands = List<NodeId>.asSlice(&arguments)
        return Shape.Displace {target: operands[usize.ZERO], value: operands[usize.ONE]}
      }
      // A delayed drive's empty native environment does not prove the loans it stores; lowering
      // runs only an immediate drive, so such a body is never emitted (EXEC-002).
      if operation == StorageOperation.ExecutionDrive {
        return Shape.Outside {reason: BorrowStatus.StoredLoans}
      }
      if contractCall(operation) {
        return Shape.Call {arguments: run copyIds(List<NodeId>.asSlice(&arguments)), receiver: usize.ZERO, exact: false, signature: false}
      }
      // Only `replace` and a stored drive have no contract call, and both are handled above.
      return Shape.Outside {reason: BorrowStatus.StoredLoans}
    }
  }
}

// Whether a storage primitive is checked as a call to its catalog contract. The match is
// exhaustive, so a new primitive is classified before the walk accepts it.
fn contractCall(operation: StorageOperation) -> bool {
  return match operation {
    StorageOperation.RawBufferFrom => true
    StorageOperation.RawBufferSlot => true
    StorageOperation.RawBufferCount => true
    StorageOperation.RawBufferRead => true
    StorageOperation.RawBufferCopy => true
    StorageOperation.RawBufferFill => true
    StorageOperation.RawBufferView => true
    StorageOperation.RawBufferViewMut => true
    StorageOperation.SlotWrite => true
    StorageOperation.SlotTake => true
    StorageOperation.SlotDrop => true
    StorageOperation.SlotCopy => true
    StorageOperation.SlotAddress => true
    StorageOperation.SharedLayout => true
    StorageOperation.SharedFromAllocation => true
    StorageOperation.SharedClone => true
    StorageOperation.SharedWithMut => true
    StorageOperation.LayoutOf => true
    StorageOperation.SystemAllocationAcquire => true
    StorageOperation.StringUtf8Bytes => true
    StorageOperation.StringFromUtf8Unchecked => true
    StorageOperation.StringByteLength => true
    StorageOperation.Replace => false
    StorageOperation.ExecutionLayout => true
    StorageOperation.ExecutionFromAllocation => true
    StorageOperation.ExecutionDrive => false
    StorageOperation.Relinquish => true
    StorageOperation.ExecutionCurrent => true
    StorageOperation.ExecutionRefOf => true
    StorageOperation.ExecutionLoad => true
    StorageOperation.ExecutionStore => true
    StorageOperation.ExecutionNotify => true
    StorageOperation.ExecutionLive => true
  }
}

// The extent and kind of a borrowing match's loan of its subject place (MATCH-001), pending the
// language decision. Spanning the arm holds the loan through every point of the selected arm, guard
// included, whether or not the arm binds; otherwise it ends at the arm's last binding use. Matching
// the access lends `&mut` exclusively; otherwise the owner may still be read beside an idle
// exclusive binding. These agree with the bootstrap's `armLoan`, which governs `match` alone. An
// `if let` lends through its whole taken body when it binds, and a destructuring `let` until its
// bindings' scope ends, each exclusively for `&mut` (PATT-009).
fn armLoanSpansArm() -> bool { return false }

fn armLoanMatchesAccess() -> bool { return false }

fn wordOf(bit: usize) -> usize { return bit / 64 }

fn maskOf(bit: usize) -> u64 { return u64.shiftLeft(1, usize.toU64(bit % 64)) }

// Backward liveness over actual Flow definitions. Inputs describe uses and kills,
// never new reaching facts.
effect fn solveLiveness(points: &[Point], width: usize, used: &[u64], bound: &[u64]) -> List<u64>
! OutOfMemoryError ? &mut Allocator {
  if used.length != points.length * width || bound.length != used.length {
    return CompilerBug.panic(b"liveness tables do not cover the actual CFG")
  }
  let mut liveIn = List<u64>.make()
  let mut liveOut = List<u64>.make()
  let mut at = usize.ZERO
  while at < used.length {
    run List<u64>.append(&mut liveIn, 0)
    run List<u64>.append(&mut liveOut, 0)
    at = at + usize.ONE
  }
  let mut changed = true
  while changed {
    changed = false
    let mut point = points.length
    while point > usize.ZERO {
      point = point - usize.ONE
      let next = List<usize>.asSlice(&points[point].next)
      let mut word = usize.ZERO
      while word < width {
        let mut out = u64.MIN
        let mut successor = usize.ZERO
        while successor < next.length {
          out = u64.bitOr(out, List<u64>.asSlice(&liveIn)[next[successor] * width + word])
          successor = successor + usize.ONE
        }
        let slot = point * width + word
        let entry = u64.bitOr(u64.bitAnd(out, u64.bitNot(bound[slot])), used[slot])
        let mut outs = List<u64>.asMutSlice(&mut liveOut)
        outs[slot] = out
        if List<u64>.asSlice(&liveIn)[slot] != entry {
          let mut ins = List<u64>.asMutSlice(&mut liveIn)
          ins[slot] = entry
          changed = true
        }
        word = word + usize.ONE
      }
    }
  }
  return move liveOut
}

// Graph reachability, used at storage ends rather than treating sibling arms as one numeric
// interval. The ordinary conflict walk keeps its compact interval test.
effect fn pathReaches(points: &[Point], from: usize, to: usize) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  if from == usize.MAX || to == usize.MAX {
    return false
  }
  let mut seen = List<bool>.make()
  let mut at = usize.ZERO
  while at < points.length {
    run List<bool>.append(&mut seen, false)
    at = at + usize.ONE
  }
  let mut queue = List<usize>.make()
  run List<usize>.append(&mut queue, from)
  let mut visited = List<bool>.asMutSlice(&mut seen)
  visited[from] = true
  at = usize.ZERO
  while at < List<usize>.length(&queue) {
    let point = List<usize>.asSlice(&queue)[at]
    if point == to {
      return true
    }
    let next = List<usize>.asSlice(&points[point].next)
    let mut index = usize.ZERO
    while index < next.length {
      let mut visited = List<bool>.asMutSlice(&mut seen)
      if
        !visited[next[index]] {
        visited[next[index]] = true
        run List<usize>.append(&mut queue, next[index])
      }
      index = index + usize.ONE
    }
    at = at + usize.ONE
  }
  return false
}

// Whether `to` is reachable from `from` on a path through neither `created` nor a point that binds
// `holder` again.
effect fn readKeeping(points: &[Point], from: usize, to: usize, created: usize, rebound: &[bool]) -> bool ! OutOfMemoryError ? &mut Allocator {
  if from == usize.MAX || to == usize.MAX { return false }
  if rebound.length != points.length { return CompilerBug.panic(b"source-preserving path lost its actual rebinding points") }
  let mut seen = List<bool>.make()
  let mut at = usize.ZERO
  while at < points.length {
    run List<bool>.append(&mut seen, false)
    at = at + usize.ONE
  }
  let mut pending = List<usize>.make()
  run List<usize>.append(&mut pending, from)
  while List<usize>.length(&pending) > usize.ZERO {
    let last = List<usize>.length(&pending) - usize.ONE
    let point = List<usize>.remove(&mut pending, last)
    let next = List<usize>.asSlice(&points[point].next)
    let mut successor = usize.ZERO
    while successor < next.length {
      let target = next[successor]
      if target == to { return true }
      if !List<bool>.asSlice(&seen)[target] && target != created && !rebound[target] {
        let mut marked = List<bool>.asMutSlice(&mut seen)
        marked[target] = true
        run List<usize>.append(&mut pending, target)
      }
      successor = successor + usize.ONE
    }
  }
  return false
}

// Whether a write of `written` replaces all of `moved`: same root, and a prefix of its path that
// names no unknown element.
fn covers(written: &Place, moved: &Place) -> bool {
  if written.root != moved.root {
    return false
  }
  let first = List<Step>.asSlice(&written.steps)
  let second = List<Step>.asSlice(&moved.steps)
  if first.length > second.length {
    return false
  }
  let mut at = usize.ZERO
  while at < first.length {
    if first[at].kind == StepKind.AnyElement || !sameStep(first[at], second[at]) {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

fn isBackEdge(loops: &[Loop], from: usize, to: usize) -> bool {
  let mut at = usize.ZERO
  while at < loops.length {
    if loops[at].header == to {
      let sources = List<usize>.asSlice(&loops[at].sources)
      let mut index = usize.ZERO
      while index < sources.length {
        if sources[index] == from {
          return true
        }
        index = index + usize.ONE
      }
    }
    at = at + usize.ONE
  }
  return false
}

// Reaching moves along forward edges: bit `m` of `entering[p]` (and `leaving[p]`) is set when move
// event `moves[m]` reaches point `p` in the same loop iteration, on a path that neither rebinds nor
// replaces its place. Repetition is checked separately at each loop header.
struct Reach {
  entering: List<u64>
  leaving: List<u64>
}

fn moveInitialized(initialized: &[MoveInitialization], point: usize, root: usize) -> bool {
  let mut at = usize.ZERO
  while at < initialized.length {
    if initialized[at].point == point && initialized[at].root == root { return true }
    at = at + usize.ONE
  }
  return false
}

effect fn reaching(points: &[Point], initialized: &[MoveInitialization], events: &[Event], loops: &[Loop], moves: &[usize], width: usize) -> Reach
! OutOfMemoryError ? &mut Allocator {
  let rows = run sourceEventsAt(events, points.length)
  let mut entering = List<u64>.make()
  let mut leaving = List<u64>.make()
  let mut at = usize.ZERO
  while at < points.length * width {
    run List<u64>.append(&mut entering, 0)
    run List<u64>.append(&mut leaving, 0)
    at = at + usize.ONE
  }
  let mut changed = true
  while changed {
    changed = false
    let mut point = usize.ZERO
    while point < points.length {
      let mut word = usize.ZERO
      while word < width {
        let mut outs = List<u64>.asMutSlice(&mut leaving)
        outs[point * width + word] = List<u64>.asSlice(&entering)[point * width + word]
        word = word + usize.ONE
      }
      let recorded = List<usize>.asSlice(&List<List<usize>>.asSlice(&rows)[point])
      let mut bit = usize.ZERO
      while bit < moves.length {
        let moved = &events[moves[bit]].place
        let slot = point * width + wordOf(bit)
        let mut outs = List<u64>.asMutSlice(&mut leaving)
        if moveInitialized(initialized, point, moved.root) {
          outs[slot] = u64.bitAnd(outs[slot], u64.bitNot(maskOf(bit)))
        }
        // Preserve the order within an actual point. Multiple acquisition/access events
        // share its flow frontier; none may disappear behind a singleton Point.event.
        let mut each = usize.ZERO
        while each < recorded.length {
          let event = recorded[each]
          if events[event].kind == Kind.Write && covers(&events[event].place, moved) {
            outs[slot] = u64.bitAnd(outs[slot], u64.bitNot(maskOf(bit)))
          }
          if event == moves[bit] { outs[slot] = u64.bitOr(outs[slot], maskOf(bit)) }
          each = each + usize.ONE
        }
        bit = bit + usize.ONE
      }
      let next = List<usize>.asSlice(&points[point].next)
      let mut successor = usize.ZERO
      while successor < next.length {
        if !isBackEdge(loops, point, next[successor]) {
          word = usize.ZERO
          while word < width {
            let slot = next[successor] * width + word
            let current = List<u64>.asSlice(&entering)[slot]
            let merged = u64.bitOr(current, List<u64>.asSlice(&leaving)[point * width + word])
            if merged != current {
              let mut ins = List<u64>.asMutSlice(&mut entering)
              ins[slot] = merged
              changed = true
            }
            word = word + usize.ONE
          }
        }
        successor = successor + usize.ONE
      }
      point = point + usize.ONE
    }
  }
  return Reach {entering: move entering, leaving: move leaving}
}

// Whether `place` is moved in state `state` of point `point`: some reaching move names exactly it.
fn movedIn(events: &[Event], moves: &[usize], state: &[u64], width: usize, point: usize, place: &Place) -> bool {
  let mut bit = usize.ZERO
  while bit < moves.length {
    if reaches(state, width, point, bit) && samePlace(&events[moves[bit]].place, place) {
      return true
    }
    bit = bit + usize.ONE
  }
  return false
}

// A point may contain several ordered ownership events. Start with its incoming move
// state, then apply only the preceding events at that point; later writes cannot clear a
// move before this access, and an earlier move cannot disappear behind the shared point.
fn moveReachesEvent(events: &[Event], initialized: &[MoveInitialization], moves: &[usize], reach: &Reach,
  width: usize, bit: usize, at: usize) -> bool {
  let point = events[at].point
  let source = moves[bit]
  let place = &events[source].place
  let mut present = reaches(List<u64>.asSlice(&reach.entering), width, point, bit)
  if moveInitialized(initialized, point, place.root) { present = false }
  let mut before = usize.ZERO
  while before < at {
    if events[before].point == point {
      if events[before].kind == Kind.Write && covers(&events[before].place, place) { present = false }
      if before == source { present = true }
    }
    before = before + usize.ONE
  }
  return present
}

fn samePlace(left: &Place, right: &Place) -> bool {
  return left.root == right.root && overlap(left, right) == usize.ONE
    && List<Step>.length(&left.steps) == List<Step>.length(&right.steps)
}

// Whether `local` is bound inside the loop, so it has no owner state at the header.
fn boundInside(initialized: &[MoveInitialization], repeat: &Loop, local: usize) -> bool {
  let mut at = usize.ZERO
  while at < initialized.length {
    if initialized[at].root == local && initialized[at].point >= repeat.header && initialized[at].point < repeat.end {
      return true
    }
    at = at + usize.ONE
  }
  return false
}

// Whether a loop repeats with every `match place` refinement it uses intact: a write in the body
// to the subject of a match outside the loop invalidates a binding the next iteration uses (the
// bootstrap's `OWN0005` otherwise).
effect fn refinementRepeats(points: &[Point], refinements: &[Refinement], events: &[Event], repeat: &Loop, reaches: &mut List<ReplacementReach>) -> bool
! OutOfMemoryError ? &mut Allocator {
  let mut use = usize.ZERO
  while use < events.length {
    let used = &events[use]
    if used.refiner != usize.MAX && used.point >= repeat.header && used.point < repeat.end
      && used.kind != Kind.End && used.kind != Kind.Expire {
      let test = refinementTest(refinements, used.refiner)
      if test != usize.MAX && (test < repeat.header || test >= repeat.end) {
        let mut source = usize.ZERO
        while source < events.length {
          let written = &events[source]
          if written.point >= repeat.header && written.point < repeat.end
            && replaces(written.kind)
            && coversRefined(&written.place, &used.place, used.refinedDepth)
            && run reachesAvoiding(points, &mut reaches.*, written.point, used.point, test) {
            return false
          }
          source = source + usize.ONE
        }
      }
    }
    use = use + usize.ONE
  }
  return true
}

// Whether a loop repeats with the same moved places of its outer locals as it enters with
// (the bootstrap's `OWN0005` otherwise).
fn compatibleHeader(initialized: &[MoveInitialization], events: &[Event], moves: &[usize], reach: &Reach, width: usize, repeat: &Loop) -> bool {
  if repeat.before == usize.MAX {
    return true
  }
  let leaving = List<u64>.asSlice(&reach.leaving)
  let sources = List<usize>.asSlice(&repeat.sources)
  let mut bit = usize.ZERO
  while bit < moves.length {
    let place = &events[moves[bit]].place
    if !boundInside(initialized, repeat, place.root) {
      let entered = movedIn(events, moves, leaving, width, repeat.before, place)
      let mut index = usize.ZERO
      while index < sources.length {
        if movedIn(events, moves, leaving, width, sources[index], place) != entered {
          return false
        }
        index = index + usize.ONE
      }
    }
    bit = bit + usize.ONE
  }
  return true
}

fn reaches(entering: &[u64], width: usize, point: usize, bit: usize) -> bool {
  return u64.bitAnd(entering[point * width + wordOf(bit)], maskOf(bit)) != 0
}

// Region inclusion uses the actual control graph. Required sets over-approximate loan flow;
// available sets under-approximate storage validity. A successful inclusion is a proof. A failed
// inclusion in this conservative slice stays noncertifying: exact End/access evidence owns
// OWN0019/conflict diagnostics. Unknown mappings cannot upgrade a body; a complete union of
// possible loans can prove safety only when every possible source satisfies the proof.
// `required` holds the region's own requirement and every point propagated into it; `incoming` only
// the points propagated from other regions. A local region's own requirement was checked loan by
// loan against that loan's validity; propagated points must lie where every loan of the region is
// valid.
// Immutable source/provenance inputs to the accepted universal and parent predicates.
// The source consumer supplies actual projected loans and policy effects directly.
struct RegionSources<'proof> {
  loans: &'proof [Loan]
  // One immutable truth per reserved loan, retaining every original acquisition ID.
  activity: &'proof [SourceTruth]
  supplied: &'proof [Shared<Lifetime>]
  contested: &'proof [Shared<Lifetime>]
  openContents: &'proof [Shared<Lifetime>]
  retentionRelations: &'proof [ImpliedGroup]
}

fn sourceRegionSources<'proof>(settled: &'proof SourceSettledLoans, supplied: &'proof [Shared<Lifetime>],
  contested: &'proof [Shared<Lifetime>], openContents: &'proof [Shared<Lifetime>],
  retentionRelations: &'proof [ImpliedGroup]) -> RegionSources<'proof> {
  return RegionSources<'proof> {loans: List<Loan>.asSlice(&settled.loans),
    activity: List<SourceTruth>.asSlice(&settled.activity),
    supplied: supplied, contested: contested, openContents: openContents, retentionRelations: retentionRelations}
}

fn regionLoanActivity<'proof>(sources: &RegionSources<'proof>, index: usize) -> SourceTruth {
  if index >= sources.loans.length { return CompilerBug.panic(b"region provenance names a foreign loan") }
  if sources.activity.length != sources.loans.length { return CompilerBug.panic(b"region activity lost reserved loan identities") }
  return sources.activity[index]
}

// Reach at the acquisition itself is authoritative. An implicit input borrow remains active
// even when a later argument prevents the operation from publishing its descriptor/result.
effect fn sourceAcquisitionActivity<'body>(graph: &SourceGraphGraph<'body>, loans: &[Loan])
  -> List<SourceTruth> ! OutOfMemoryError ? &mut Allocator {
  let points = List<SourceControl.Point>.asSlice(&SourceGraphGraph.control(graph).points)
  let mut result = List<SourceTruth>.make()
  let mut at = usize.ZERO
  while at < loans.length {
    let point = loans[at].created
    if point >= points.length { return CompilerBug.panic(b"reserved loan has no actual acquisition point") }
    run List<SourceTruth>.append(&mut result, SourceGraphGraph.truth(graph, points[point].reachable))
    at = at + usize.ONE
  }
  return move result
}

struct RegionPoints {
  region: Shared<Lifetime>
  required: List<u64>
  incoming: List<u64>
  available: List<u64>
}

struct RegionEdge {
  shorter: usize
  longer: usize
}

impl Copy for RegionEdge {}

enum RegionDomain { Universal, Local, Unknown }

fn suppliedAtom(region: &Shared<Lifetime>) -> bool {
  return Shared<Lifetime>.with<bool>(region, fn(atom: &Lifetime) -> bool {
    return match &atom.* { Lifetime.Supplied {..} => true _ => false }
  })
}

// Whether `region` is a borrow region of `owner`'s body.
fn regionLocal(region: &Shared<Lifetime>, owner: &DeclarationId) -> bool {
  return Shared<Lifetime>.with<bool>(region, fn(atom: &Lifetime) -> bool {
    if let Lifetime.Local {declaration, ..} = &atom.* { return DeclarationId.equals(&declaration, owner) }
    return false
  })
}

// A Supplied atom is universal only when it is one of the body's own application regions: it then
// names a caller region valid for the whole invocation, as the parameter it binds does. Supplied
// atoms carry no owner, so one from any other numbering stays unknown; the caller passes none
// when the body may hold such an atom.
fn regionDomain(region: &Shared<Lifetime>, owner: &DeclarationId, supplied: &[Shared<Lifetime>]) -> RegionDomain {
  if suppliedAtom(region) {
    if proofContains(supplied, region) { return RegionDomain.Universal }
    return RegionDomain.Unknown
  }
  return Shared<Lifetime>.with<RegionDomain>(region, fn(atom: &Lifetime) -> RegionDomain {
    return match &atom.* {
      Lifetime.Static => RegionDomain.Universal
      Lifetime.Parameter {declaration, ..} => {
        let kind = DeclarationId.kind(&declaration)
        if DeclarationId.equals(&declaration, owner)
          || (DeclarationId.isPrefixOf(&declaration, owner) && kind != OwnerKind.Anonymous && kind != OwnerKind.EffectBlock) {
          return RegionDomain.Universal
        }
        return RegionDomain.Unknown
      }
      Lifetime.Local {declaration, ..} => {
        if DeclarationId.equals(&declaration, owner) { return RegionDomain.Local }
        return RegionDomain.Unknown
      }
      _ => RegionDomain.Unknown
    }
  })
}

// The enclosing body bounds construction, retention and escape of the capture. This witness
// covers only finite uses in the direct nested invocation; it is never a universal premise.
fn capturedFiniteSource(region: &Shared<Lifetime>, owner: &DeclarationId) -> bool {
  let kind = DeclarationId.kind(owner)
  if kind != OwnerKind.Anonymous && kind != OwnerKind.EffectBlock { return false }
  return Shared<Lifetime>.with<bool>(region, fn(atom: &Lifetime) -> bool {
    if let Lifetime.Local {declaration, ..} = &atom.* {
      return DeclarationId.kind(&declaration) == OwnerKind.Function
        && DeclarationId.ownerCount(&declaration) + usize.ONE == DeclarationId.ownerCount(owner)
        && DeclarationId.isPrefixOf(&declaration, owner)
    }
    return false
  })
}

// Cache completed provenance proofs by their target. Cyclic graphs are grounded separately;
// a currently visited node is never installed here as an assumed proof or a failed result.
struct SymbolicRegion {
  offered: Shared<Lifetime>
  wanted: Shared<Lifetime>
  proved: bool
}

effect fn appendNewAtoms(target: &mut List<Shared<Lifetime>>, region: &Shared<Lifetime>) -> () ! OutOfMemoryError ? &mut Allocator {
  let count = Lifetime.atomCount(region)
  let mut at = usize.ZERO
  while at < count {
    let atom = Lifetime.atomAt(region, at)
    if !proofContains(List<Shared<Lifetime>>.asSlice(&target.*), &atom) {
      run List<Shared<Lifetime>>.append(&mut target.*, move atom)
    }
    at = at + usize.ONE
  }
  return ()
}

// Walks a dropped loan's provenance as symbolicParentsProved does: from its own regions through
// every loan naming a non-universal walked region to that loan's parent, and through every source
// a retention relation lets into a walked region.
effect fn unretainedChain<'proof>(sources: &RegionSources<'proof>, owner: &DeclarationId, dropped: usize) -> UnretainedChain
! OutOfMemoryError ? &mut Allocator {
  let loans = sources.loans
  let relations = sources.retentionRelations
  let active = regionLoanActivity(sources, dropped)
  let mut chain = UnretainedChain {dropped: dropped, loans: List<usize>.make(), regions: List<Shared<Lifetime>>.make(),
    unresolved: active == SourceTruth.Undefined}
  if active != SourceTruth.True { return move chain }
  run List<usize>.append(&mut chain.loans, dropped)
  let named = List<Shared<Lifetime>>.asSlice(&loans[dropped].regions)
  let mut at = usize.ZERO
  while at < named.length {
    run appendNewAtoms(&mut chain.regions, &named[at])
    at = at + usize.ONE
  }
  let mut next = usize.ZERO
  while next < List<Shared<Lifetime>>.length(&chain.regions) {
    let walked = List<Shared<Lifetime>>.asSlice(&chain.regions)
    let region = Shared<Lifetime>.clone(&walked[next])
    if regionDomain(&region, owner, sources.supplied) != RegionDomain.Universal {
      at = usize.ZERO
      while at < loans.length {
        if proofContains(List<Shared<Lifetime>>.asSlice(&loans[at].regions), &region) {
          let activity = regionLoanActivity(sources, at)
          if activity != SourceTruth.True {
            if activity == SourceTruth.Undefined { chain.unresolved = true }
            at = at + usize.ONE
            continue
          }
          if !listsIndex(List<usize>.asSlice(&chain.loans), at) { run List<usize>.append(&mut chain.loans, at) }
          if let Option<Shared<Lifetime>>.Some {value: parent} = &loans[at].parent { run appendNewAtoms(&mut chain.regions, &parent) }
        }
        at = at + usize.ONE
      }
      at = usize.ZERO
      while at < relations.length {
        if proofContains(List<Shared<Lifetime>>.asSlice(&relations[at].container), &region) {
          let members = List<Shared<Lifetime>>.asSlice(&relations[at].members)
          let mut member = usize.ZERO
          while member < members.length {
            run appendNewAtoms(&mut chain.regions, &members[member])
            member = member + usize.ONE
          }
        }
        at = at + usize.ONE
      }
    }
    next = next + usize.ONE
  }
  return move chain
}

// Called only after the event geometry conflicts and no ordinary live source was found.
// This records the same contested regions as the eager classifier; it never manufactures
// liveness or reports a conflict merely because a dropped proof names the loan's region.
effect fn sourceContestedAt<'body, 'proof>(graph: &SourceGraphGraph<'body>, control: &SourceControlProjection,
  sources: &RegionSources<'proof>, chains: &[UnretainedChain], loan: usize, point: usize,
  paths: &mut List<ReplacementReach>, contested: &mut List<Shared<Lifetime>>) -> bool ! OutOfMemoryError ? &mut Allocator {
  let points = List<SourceControl.Point>.asSlice(&SourceGraphGraph.control(graph).points)
  if point >= points.length { return CompilerBug.panic(b"contested source event has no actual control point") }
  let active = sourceTruthAnd(regionLoanActivity(sources, loan), SourceGraphGraph.truth(graph, points[point].reachable))
  if active == SourceTruth.False { return true }
  if active != SourceTruth.True || control.unresolved { return false }
  let mut complete = true
  let mut at = usize.ZERO
  while at < chains.length {
    let chain = &chains[at]
    if chain.unresolved { complete = false }
    if listsIndex(List<usize>.asSlice(&chain.loans), loan) {
      let dropped = regionLoanActivity(sources, chain.dropped)
      if dropped == SourceTruth.Undefined { complete = false }
      if dropped == SourceTruth.True && run reachesAvoiding(List<Point>.asSlice(&control.points), &mut paths.*,
        sources.loans[chain.dropped].created, point, usize.MAX) {
        run appendAllAtoms(&mut contested.*, List<Shared<Lifetime>>.asSlice(&chain.regions))
      }
    }
    at = at + usize.ONE
  }
  return complete
}

fn listsIndex(indices: &[usize], index: usize) -> bool {
  let mut at = usize.ZERO
  while at < indices.length {
    if indices[at] == index { return true }
    at = at + usize.ONE
  }
  return false
}

fn proofContains(regions: &[Shared<Lifetime>], region: &Shared<Lifetime>) -> bool {
  let mut at = usize.ZERO
  while at < regions.length {
    if Lifetime.equalsShared(&regions[at], region) { return true }
    at = at + usize.ONE
  }
  return false
}

// Whether the caller's 2a check (`checkDeclaredRegions`) already proved a universal relation:
// one whose whole offered side is a single declared region. A constituent of a meet that also
// holds a local atom has had no such proof, and neither has a Supplied atom, which 2a leaves
// pending; those must pass `universalRegionProved`.
fn declaredRelationProved(offered: &Shared<Lifetime>, wanted: &Shared<Lifetime>, constituents: usize) -> bool {
  return constituents == usize.ONE && !suppliedAtom(offered) && !suppliedAtom(wanted)
}

// Only authenticated scalar universals participate here. Premises come from the header proof,
// never the retained obligation list. Meets and outside-owner atoms remain pending.
effect fn universalRegionProved(owner: &DeclarationId, supplied: &[Shared<Lifetime>], offered: &Shared<Lifetime>, wanted: &Shared<Lifetime>,
  premises: &[RegionBound]) -> bool ! OutOfMemoryError ? &mut Allocator {
  if regionDomain(offered, owner, supplied) != RegionDomain.Universal || regionDomain(wanted, owner, supplied) != RegionDomain.Universal { return false }
  if Lifetime.equalsShared(offered, wanted) { return true }
  if Shared<Lifetime>.with<bool>(offered, fn(value: &Lifetime) -> bool {
    return match &value.* { Lifetime.Static => true _ => false }
  }) { return true }
  let mut reached = List<Shared<Lifetime>>.make()
  run List<Shared<Lifetime>>.append(&mut reached, Shared<Lifetime>.clone(wanted))
  let mut next = usize.ZERO
  while next < List<Shared<Lifetime>>.length(&reached) {
    let entries = List<Shared<Lifetime>>.asSlice(&reached)
    let current = Shared<Lifetime>.clone(&entries[next])
    if Lifetime.equalsShared(offered, &current) { return true }
    let mut at = usize.ZERO
    while at < premises.length {
      let premise = &premises[at]
      if regionDomain(&premise.longer, owner, supplied) == RegionDomain.Universal
        && regionDomain(&premise.shorter, owner, supplied) == RegionDomain.Universal
        && Lifetime.equalsShared(&premise.shorter, &current)
        && !proofContains(List<Shared<Lifetime>>.asSlice(&reached), &premise.longer) {
        run List<Shared<Lifetime>>.append(&mut reached, Shared<Lifetime>.clone(&premise.longer))
      }
      at = at + usize.ONE
    }
    next = next + usize.ONE
  }
  return false
}

fn cachedSymbolicRegion(owner: &DeclarationId, offered: &Shared<Lifetime>, wanted: &Shared<Lifetime>,
  cache: &[SymbolicRegion]) -> Option<bool> {
  let shorterLocal = regionLocal(wanted, owner)
  let mut at = usize.ZERO
  while at < cache.length {
    let sameTarget = Lifetime.equalsShared(&cache[at].wanted, wanted)
      || (shorterLocal && regionLocal(&cache[at].wanted, owner))
    if sameTarget && Lifetime.equalsShared(&cache[at].offered, offered) { return Option<bool>.some(cache[at].proved) }
    at = at + usize.ONE
  }
  return Option<bool>.none()
}

// A node in an authenticated actual-parent graph; grounding alone grants no point validity.
struct SymbolicRoot {
  region: Shared<Lifetime>
  parents: List<usize>
  grounded: bool
}

effect fn symbolicRootIndex(roots: &mut List<SymbolicRoot>, region: &Shared<Lifetime>) -> usize
! OutOfMemoryError ? &mut Allocator {
  let entries = List<SymbolicRoot>.asSlice(&roots.*)
  let mut at = usize.ZERO
  while at < entries.length {
    if Lifetime.equalsShared(&entries[at].region, region) { return at }
    at = at + usize.ONE
  }
  let selected = List<SymbolicRoot>.length(&roots.*)
  run List<SymbolicRoot>.append(&mut roots.*, SymbolicRoot {
    region: Shared<Lifetime>.clone(region), parents: List<usize>.make(), grounded: false,
  })
  return selected
}

// All parent paths must stay inside this complete provenance graph or end at a sufficient
// universal. Each reachable component must also reach a real root; a root elsewhere in the graph
// cannot justify an ungrounded sibling cycle. Static cycles from reassigning a reborrow may be
// grounded by the original reference, without assuming the cycle itself is a source of validity.
effect fn symbolicParentsProved<'proof>(sources: &RegionSources<'proof>, owner: &DeclarationId, offered: &Shared<Lifetime>,
  wanted: &Shared<Lifetime>, premises: &[RegionBound], cache: &mut List<SymbolicRegion>) -> bool
! OutOfMemoryError ? &mut Allocator {
  let mut roots = List<SymbolicRoot>.make()
  drop run symbolicRootIndex(&mut roots, offered)
  let loans = sources.loans
  let mut next = usize.ZERO
  while next < List<SymbolicRoot>.length(&roots) {
    let entries = List<SymbolicRoot>.asSlice(&roots)
    let region = Shared<Lifetime>.clone(&entries[next].region)
    // A contested region is used past the body by a loan the walk dropped, after a conflicting
    // access: it outlives no universal region.
    if regionDomain(wanted, owner, sources.supplied) == RegionDomain.Universal
      && proofContains(sources.contested, &region) { return false }
    let mut parents = List<usize>.make()
    let mut grounded = false
    let mut found = false
    let mut at = usize.ZERO
    while at < loans.length {
      let loan = &loans[at]
      let activity = regionLoanActivity(sources, at)
      if activity == SourceTruth.False {
        at = at + usize.ONE
        continue
      }
      if proofContains(List<Shared<Lifetime>>.asSlice(&loan.regions), &region) {
        found = true
        if activity != SourceTruth.True { return false }
        if loan.local || !provable(loan.precision) { return false }
        if let Option<Shared<Lifetime>>.Some {value: borrowed} = &loan.borrowed {
          if !Lifetime.equalsShared(&borrowed, &region) { return false }
        } else { return false }
        if let Option<Shared<Lifetime>>.Some {value: bound} = &loan.parent {
          // A reborrow through several descriptors is bounded by their meet: every atom must
          // reach the target, and any one sufficient atom grounds this storage.
          let count = Lifetime.atomCount(&bound)
          if count == usize.ZERO { return false }
          let mut atom = usize.ZERO
          while atom < count {
            let parent = Lifetime.atomAt(&bound, atom)
            let domain = regionDomain(&parent, owner, sources.supplied)
            if domain == RegionDomain.Universal {
              if regionDomain(wanted, owner, sources.supplied) == RegionDomain.Universal
                && !run universalRegionProved(owner, sources.supplied, &parent, wanted, premises) { return false }
              grounded = true
            } else if domain == RegionDomain.Local {
              let known = cachedSymbolicRegion(owner, &parent, wanted, List<SymbolicRegion>.asSlice(&cache.*))
              if let Option<bool>.Some {value} = move known {
                if !value { return false }
                grounded = true
              } else {
                let index = run symbolicRootIndex(&mut roots, &parent)
                run List<usize>.append(&mut parents, index)
              }
            } else { return false }
            atom = atom + usize.ONE
          }
        } else { return false }
      }
      at = at + usize.ONE
    }
    if !found { return false }
    // An open contents bound lets values of unknown regions into this region.
    if proofContains(sources.openContents, &region) { return false }
    // A value can also enter this region without a loan, through a region relation such as a
    // passed reference meeting a fresh borrow in one call region. Each such source must itself
    // reach the target; it never grounds this region, so its own loans must still be found.
    let relations = sources.retentionRelations
    let mut relation = usize.ZERO
    while relation < relations.length {
      if proofContains(List<Shared<Lifetime>>.asSlice(&relations[relation].container), &region) {
        let members = List<Shared<Lifetime>>.asSlice(&relations[relation].members)
        let mut member = usize.ZERO
        while member < members.length {
          let source = &members[member]
          if !Lifetime.equalsShared(source, &region) {
            let domain = regionDomain(source, owner, sources.supplied)
            if domain == RegionDomain.Universal {
              if regionDomain(wanted, owner, sources.supplied) == RegionDomain.Universal
                && !run universalRegionProved(owner, sources.supplied, source, wanted, premises) { return false }
            } else if domain == RegionDomain.Local {
              let known = cachedSymbolicRegion(owner, source, wanted, List<SymbolicRegion>.asSlice(&cache.*))
              if let Option<bool>.Some {value} = move known {
                if !value { return false }
              } else {
                drop run symbolicRootIndex(&mut roots, source)
              }
            } else { return false }
          }
          member = member + usize.ONE
        }
      }
      relation = relation + usize.ONE
    }
    let mut recorded = List<SymbolicRoot>.asMutSlice(&mut roots)
    recorded[next].parents = move parents
    recorded[next].grounded = grounded
    next = next + usize.ONE
  }
  if !groundRegionParents(&mut roots) { return false }
  let entries = List<SymbolicRoot>.asSlice(&roots)
  let mut at = usize.ZERO
  while at < entries.length {
    run List<SymbolicRegion>.append(&mut cache.*, SymbolicRegion {
      offered: Shared<Lifetime>.clone(&entries[at].region), wanted: Shared<Lifetime>.clone(wanted), proved: true,
    })
    at = at + usize.ONE
  }
  return true
}

fn groundRegionParents(roots: &mut List<SymbolicRoot>) -> bool {
  let mut changed = true
  while changed {
    changed = false
    let mut at = usize.ZERO
    while at < List<SymbolicRoot>.length(&roots.*) {
      let entries = List<SymbolicRoot>.asSlice(&roots.*)
      let mut grounded = entries[at].grounded
      if !grounded {
        let parents = List<usize>.asSlice(&entries[at].parents)
        let mut parent = usize.ZERO
        while parent < parents.length {
          if entries[parents[parent]].grounded { grounded = true }
          parent = parent + usize.ONE
        }
        if grounded {
          let mut recorded = List<SymbolicRoot>.asMutSlice(&mut roots.*)
          recorded[at].grounded = true
          changed = true
        }
      }
      at = at + usize.ONE
    }
  }
  let entries = List<SymbolicRoot>.asSlice(&roots.*)
  let mut at = usize.ZERO
  while at < entries.length {
    if !entries[at].grounded { return false }
    at = at + usize.ONE
  }
  return true
}

// A local target asks only for a source valid throughout the finite body. A universal target
// retains its exact identity. Inner retained atoms never stand in for outer storage provenance.
effect fn symbolicRegionProved<'proof>(sources: &RegionSources<'proof>, owner: &DeclarationId,
  offered: &Shared<Lifetime>, wanted: &Shared<Lifetime>, premises: &[RegionBound], cache: &mut List<SymbolicRegion>) -> bool
! OutOfMemoryError ? &mut Allocator {
  let longer = regionDomain(offered, owner, sources.supplied)
  let shorter = regionDomain(wanted, owner, sources.supplied)
  if longer == RegionDomain.Unknown || shorter == RegionDomain.Unknown { return false }
  if longer == RegionDomain.Universal {
    if shorter == RegionDomain.Local { return true }
    return run universalRegionProved(owner, sources.supplied, offered, wanted, premises)
  }
  if let Option<bool>.Some {value} = move cachedSymbolicRegion(owner, offered, wanted, List<SymbolicRegion>.asSlice(&cache.*)) {
    return value
  }
  let proved = run symbolicParentsProved(sources, owner, offered, wanted, premises, &mut cache.*)
  if !proved {
    run List<SymbolicRegion>.append(&mut cache.*, SymbolicRegion {
      offered: Shared<Lifetime>.clone(offered), wanted: Shared<Lifetime>.clone(wanted), proved: false,
    })
  }
  return proved
}

// The actual parent bounds this loan's chosen outer lifetime. Such an external source is
// valid throughout the body independently of when its descriptor or this loan was created.
effect fn loanParentBoundProved<'proof>(sources: &RegionSources<'proof>, owner: &DeclarationId, loan: &Loan,
  premises: &[RegionBound], cache: &mut List<SymbolicRegion>) -> bool
! OutOfMemoryError ? &mut Allocator {
  if loan.local || !provable(loan.precision) { return false }
  if let Option<Shared<Lifetime>>.Some {value: borrowed} = &loan.borrowed {
    if let Option<Shared<Lifetime>>.Some {value: parent} = &loan.parent {
      // A meet of descriptor lifetimes offers the borrow only while each of them does.
      let count = Lifetime.atomCount(&parent)
      if count == usize.ZERO { return false }
      let mut atom = usize.ZERO
      while atom < count {
        let member = Lifetime.atomAt(&parent, atom)
        if !run symbolicRegionProved(sources, owner, &member, &borrowed, premises, &mut cache.*) { return false }
        atom = atom + usize.ONE
      }
      return true
    }
  }
  return false
}

effect fn crossedRegionsProved<'proof>(sources: &RegionSources<'proof>, owner: &DeclarationId, premises: &[RegionBound],
  cache: &mut List<SymbolicRegion>) -> bool ! OutOfMemoryError ? &mut Allocator {
  let loans = sources.loans
  let mut at = usize.ZERO
  while at < loans.length {
    let loan = &loans[at]
    let activity = regionLoanActivity(sources, at)
    if activity == SourceTruth.False {
      at = at + usize.ONE
      continue
    }
    if activity != SourceTruth.True { return false }
    if loan.crossed && !run loanParentBoundProved(sources, owner, loan, premises, &mut cache.*) { return false }
    at = at + usize.ONE
  }
  return true
}

// Finite crossings may end at owned storage, but every actual parent path must be accounted
// for and grounded. These edges become point-set requirements, never symbolic premises or a
// universal-source cache entry. A type's inner atom cannot identify its outer source loan.
effect fn finiteParentRoots<'proof>(sources: &RegionSources<'proof>, owner: &DeclarationId, roots: &mut List<SymbolicRoot>) -> bool
! OutOfMemoryError ? &mut Allocator {
  let loans = sources.loans
  let supplied = sources.supplied
  let mut next = usize.ZERO
  while next < List<SymbolicRoot>.length(&roots.*) {
    let entries = List<SymbolicRoot>.asSlice(&roots.*)
    let region = Shared<Lifetime>.clone(&entries[next].region)
    if !regionLocal(&region, owner) { return false }
    let mut parents = List<usize>.make()
    let mut grounded = false
    let mut found = false
    let mut at = usize.ZERO
    while at < loans.length {
      let loan = &loans[at]
      let activity = regionLoanActivity(sources, at)
      if activity == SourceTruth.False {
        at = at + usize.ONE
        continue
      }
      if regionsCarry(List<Shared<Lifetime>>.asSlice(&loan.regions), &region, owner, supplied) {
        found = true
        if activity != SourceTruth.True { return false }
        if !provable(loan.precision) { return false }
        if let Option<Shared<Lifetime>>.Some {value: borrowed} = &loan.borrowed {
          if !carriesRegion(&borrowed, &region, owner, supplied) { return false }
        } else { return false }
        if loan.local {
          if let Option<Shared<Lifetime>>.Some {..} = &loan.parent { return false }
          grounded = true
        } else if let Option<Shared<Lifetime>>.Some {value: bound} = &loan.parent {
          let count = Lifetime.atomCount(&bound)
          if count == usize.ZERO { return false }
          let mut atom = usize.ZERO
          while atom < count {
            let parent = Lifetime.atomAt(&bound, atom)
            let domain = regionDomain(&parent, owner, supplied)
            if domain == RegionDomain.Universal {
              grounded = true
            } else if domain == RegionDomain.Local {
              let index = run symbolicRootIndex(&mut roots.*, &parent)
              run List<usize>.append(&mut parents, index)
            } else { return false }
            atom = atom + usize.ONE
          }
        } else { return false }
      }
      at = at + usize.ONE
    }
    if !found { return false }
    let mut recorded = List<SymbolicRoot>.asMutSlice(&mut roots.*)
    recorded[next].parents = move parents
    recorded[next].grounded = grounded
    next = next + usize.ONE
  }
  return groundRegionParents(&mut roots.*)
}

effect fn finiteCrossingRoots<'proof>(sources: &RegionSources<'proof>, owner: &DeclarationId,
  premises: &[RegionBound], symbolic: &mut List<SymbolicRegion>) -> Option<List<SymbolicRoot>>
! OutOfMemoryError ? &mut Allocator {
  let mut roots = List<SymbolicRoot>.make()
  let loans = sources.loans
  let mut at = usize.ZERO
  while at < loans.length {
    let loan = &loans[at]
    let activity = regionLoanActivity(sources, at)
    if activity == SourceTruth.False {
      at = at + usize.ONE
      continue
    }
    if activity != SourceTruth.True { return Option<List<SymbolicRoot>>.none() }
    if loan.crossed && !run loanParentBoundProved(sources, owner, loan, premises, &mut symbolic.*) {
      if let Option<Shared<Lifetime>>.Some {value: borrowed} = &loan.borrowed {
        if localMeet(&borrowed, owner, sources.supplied) {
          // The meet's local constituents carry its finite requirements; its universal ones
          // outlive the body.
          let mut atom = usize.ZERO
          while atom < Lifetime.atomCount(&borrowed) {
            let member = Lifetime.atomAt(&borrowed, atom)
            if regionLocal(&member, owner) { drop run symbolicRootIndex(&mut roots, &member) }
            atom = atom + usize.ONE
          }
        } else {
          drop run symbolicRootIndex(&mut roots, &borrowed)
        }
      } else { return Option<List<SymbolicRoot>>.none() }
    }
    at = at + usize.ONE
  }
  if !run finiteParentRoots(sources, owner, &mut roots) { return Option<List<SymbolicRoot>>.none() }
  return Option<List<SymbolicRoot>>.some(move roots)
}

effect fn installFiniteParentEdges(entries: &[SymbolicRoot], mapped: &[usize],
  regions: &mut List<RegionPoints>, edges: &mut List<RegionEdge>) -> bool ! OutOfMemoryError ? &mut Allocator {
  if entries.length != mapped.length { return CompilerBug.panic(b"finite parent bindings lost an actual source region") }
  let mut at = usize.ZERO
  while at < entries.length {
    let parents = List<usize>.asSlice(&entries[at].parents)
    let mut parent = usize.ZERO
    while parent < parents.length {
      let source = mapped[at]
      let target = mapped[parents[parent]]
      if source == target {
        // Ordinary identity goals need no propagation. An actual reborrow parent sharing its
        // atom is different: require all own points in the shared availability intersection.
        // Later incoming points already receive that check in the ordinary worklist.
        requireSharedParentPoints(&mut regions.*, source)
      } else {
        run List<RegionEdge>.append(&mut edges.*, RegionEdge {shorter: source, longer: target})
      }
      parent = parent + usize.ONE
    }
    at = at + usize.ONE
  }
  return true
}

fn requireSharedParentPoints(regions: &mut List<RegionPoints>, index: usize) -> () {
  let mut entries = List<RegionPoints>.asMutSlice(&mut regions.*)
  let count = List<u64>.length(&entries[index].required)
  let mut word = usize.ZERO
  while word < count {
    let needed = List<u64>.asSlice(&entries[index].required)
    let value = needed[word]
    let mut propagated = List<u64>.asMutSlice(&mut entries[index].incoming)
    propagated[word] = u64.bitOr(propagated[word], value)
    word = word + usize.ONE
  }
  return ()
}

fn includeRegionPoint(bits: &mut List<u64>, point: usize) -> bool {
  let words = List<u64>.asMutSlice(&mut bits.*)
  let word = wordOf(point)
  let before = words[word]
  words[word] = u64.bitOr(before, maskOf(point))
  return before != words[word]
}

fn excludeRegionPoint(bits: &mut List<u64>, point: usize) -> bool {
  let words = List<u64>.asMutSlice(&mut bits.*)
  let word = wordOf(point)
  let before = words[word]
  words[word] = u64.bitAnd(before, u64.bitNot(maskOf(point)))
  return before != words[word]
}

// Accepted availability algorithm, parameterized only by its actual carrier/kill/history
// inventory. The caller supplies the same CFG and keeps the source-bound and own-loan gates.
effect fn propagateAvailability(points: &[Point], events: &[Event], entry: usize, loan: &Loan, place: &Place,
  sourceBound: bool, ownedStart: bool, definitions: &[u64], definitionWidth: usize,
  projection: &AvailabilityProjection, available: &mut List<u64>) -> ()
! OutOfMemoryError ? &mut Allocator {
  let mut entered = List<usize>.make()
  // The entry belongs to the supplied CFG; its numeric ID is not an availability fact.
  if !sourceBound && !ownedStart && loan.created != entry && excludeRegionPoint(&mut available.*, entry) {
    run List<usize>.append(&mut entered, entry)
  }
  let mut at = usize.ZERO
  while at < List<usize>.length(&entered) {
    let point = List<usize>.asSlice(&entered)[at]
    let next = List<usize>.asSlice(&points[point].next)
    let mut edge = usize.ZERO
    while edge < next.length {
      if next[edge] != loan.created && excludeRegionPoint(&mut available.*, next[edge]) {
        run List<usize>.append(&mut entered, next[edge])
      }
      edge = edge + usize.ONE
    }
    at = at + usize.ONE
  }
  let mut queue = List<usize>.make()
  at = usize.ZERO
  while at < events.length {
    let event = &events[at]
    let ends = event.kind == Kind.End || event.kind == Kind.Expire || event.kind == Kind.Write
      || event.kind == Kind.Move || event.kind == Kind.Drop
    // Ending or replacing the descriptor does not end an independently bounded referent, and
    // ending a descriptor's storage never ends what it refers to: a reborrow through a reference
    // a scope or statement ends stays bounded by the loan that reference carries. Actual referent
    // events still invalidate availability independently of conflict classification.
    let storageEnds = event.kind == Kind.End || event.kind == Kind.Expire
    let descriptorOnly = (event.kind == Kind.Write || storageEnds || sourceBound) && behind(&event.place, place)
    if ends && !descriptorOnly && event.point != loan.created && overlap(&event.place, place) != usize.ZERO
      && excludeRegionPoint(&mut available.*, event.point) {
      run List<usize>.append(&mut queue, event.point)
    }
    at = at + usize.ONE
  }
  // A referent event invalidates the loan only along paths that still hold it: each invalidated point
  // carries the holdings that still hold the loan on some path from the event. A holding ends where
  // its holder is bound again; a copy of a carried holding, or a binding of the loan while it is in
  // flight, joins them. Past a point where none is left and no value carrying the loan is in flight,
  // nothing on that path can hold it again without its creation, so no later requirement on that
  // path depends on this storage.
  let width = definitionWidth
  if width == usize.ZERO || loan.escapes || loan.until != usize.MAX {
    at = usize.ZERO
    while at < List<usize>.length(&queue) {
      let point = List<usize>.asSlice(&queue)[at]
      let next = List<usize>.asSlice(&points[point].next)
      let mut edge = usize.ZERO
      while edge < next.length {
        if next[edge] != loan.created && excludeRegionPoint(&mut available.*, next[edge]) {
          run List<usize>.append(&mut queue, next[edge])
        }
        edge = edge + usize.ONE
      }
      at = at + usize.ONE
    }
    return ()
  }
  let all = List<AvailabilityCarrier>.asSlice(&projection.carriers)
  let mut carried = List<u64>.make()
  at = usize.ZERO
  while at < points.length * width { run List<u64>.append(&mut carried, 0) at = at + usize.ONE }
  // Seed each event with the holdings of this loan that reach it.
  at = usize.ZERO
  while at < List<usize>.length(&queue) {
    let point = List<usize>.asSlice(&queue)[at]
    let mut held = usize.ZERO
    while held < all.length {
      if all[held].selected && reaches(definitions, width, point, held) {
        let mut words = List<u64>.asMutSlice(&mut carried)
        let slot = point * width + wordOf(held)
        words[slot] = u64.bitOr(words[slot], maskOf(held))
      }
      held = held + usize.ONE
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < List<usize>.length(&queue) {
    let point = List<usize>.asSlice(&queue)[at]
    let next = List<usize>.asSlice(&points[point].next)
    let flowing = List<bool>.asSlice(&projection.flight)[point]
    let mut edge = usize.ZERO
    while edge < next.length {
      let target = next[edge]
      if target != loan.created {
        let landing = List<bool>.asSlice(&projection.flight)[target]
        let mut grew = false
        let mut holds = false
        let mut held = usize.ZERO
        while held < all.length {
          let incoming = u64.bitAnd(List<u64>.asSlice(&carried)[point * width + wordOf(held)], maskOf(held)) != 0
          let rebound = !reaches(List<u64>.asSlice(&projection.preserves), width, target, held)
          let mut copied = false
          if all[held].selected && all[held].point == target {
            copied = all[held].unpaired && (flowing || landing)
            let sources = List<AvailabilitySource>.asSlice(&all[held].sources)
            let mut source = usize.ZERO
            while source < sources.length {
              let origin = sources[source].definition
              if reaches(definitions, width, sources[source].read, origin)
                && u64.bitAnd(List<u64>.asSlice(&carried)[point * width + wordOf(origin)], maskOf(origin)) != 0 { copied = true }
              source = source + usize.ONE
            }
          }
          if (incoming && !rebound) || copied {
            holds = true
            let slot = target * width + wordOf(held)
            let before = List<u64>.asSlice(&carried)[slot]
            let mut words = List<u64>.asMutSlice(&mut carried)
            words[slot] = u64.bitOr(before, maskOf(held))
            if words[slot] != before { grew = true }
          }
          held = held + usize.ONE
        }
        if holds || landing {
          let excluded = excludeRegionPoint(&mut available.*, target)
          if excluded || grew { run List<usize>.append(&mut queue, target) }
        }
      }
      edge = edge + usize.ONE
    }
    at = at + usize.ONE
  }
  return ()
}

// A loan is live only at points its creation reaches, so a point no path from its creation reaches
// places no validity requirement on it: such a point is available to the loan, whatever region
// requirement arrives there.
effect fn unreachableAvailable(points: &[Point], created: usize, available: &mut List<u64>) -> ()
! OutOfMemoryError ? &mut Allocator {
  let mut reached = List<u64>.make()
  let mut word = usize.ZERO
  while word < List<u64>.length(&available.*) {
    run List<u64>.append(&mut reached, 0)
    word = word + usize.ONE
  }
  let mut queue = List<usize>.make()
  drop includeRegionPoint(&mut reached, created)
  run List<usize>.append(&mut queue, created)
  let mut at = usize.ZERO
  while at < List<usize>.length(&queue) {
    let point = List<usize>.asSlice(&queue)[at]
    let next = List<usize>.asSlice(&points[point].next)
    let mut edge = usize.ZERO
    while edge < next.length {
      if includeRegionPoint(&mut reached, next[edge]) { run List<usize>.append(&mut queue, next[edge]) }
      edge = edge + usize.ONE
    }
    at = at + usize.ONE
  }
  let reachedWords = List<u64>.asSlice(&reached)
  let mut words = List<u64>.asMutSlice(&mut available.*)
  word = usize.ZERO
  while word < words.length {
    words[word] = u64.bitOr(words[word], u64.bitNot(reachedWords[word]))
    word = word + usize.ONE
  }
  return ()
}

// One lazy reverse CFG and one cached point set per consuming endpoint, scoped to this
// body's region proof. Traversal includes all edges, including back edges; numeric source
// ordering never decides whether a branch can reach its consumer.
struct IntervalFlow {
  offsets: List<usize>
  predecessors: List<usize>
  endpoints: List<usize>
  reaching: List<List<u64>>
}

fn emptyIntervalFlow() -> IntervalFlow {
  return IntervalFlow {offsets: List<usize>.make(), predecessors: List<usize>.make(),
    endpoints: List<usize>.make(), reaching: List<List<u64>>.make()}
}

effect fn intervalPredecessors(points: &[Point], flow: &mut IntervalFlow) -> ()
! OutOfMemoryError ? &mut Allocator {
  if List<usize>.length(&flow.offsets) > usize.ZERO { return () }
  let mut at = usize.ZERO
  while at <= points.length { run List<usize>.append(&mut flow.offsets, usize.ZERO) at = at + usize.ONE }
  at = usize.ZERO
  while at < points.length {
    let next = List<usize>.asSlice(&points[at].next)
    let mut edge = usize.ZERO
    while edge < next.length {
      let mut offsets = List<usize>.asMutSlice(&mut flow.offsets)
      offsets[next[edge] + usize.ONE] = offsets[next[edge] + usize.ONE] + usize.ONE
      edge = edge + usize.ONE
    }
    at = at + usize.ONE
  }
  at = usize.ONE
  while at <= points.length {
    let mut offsets = List<usize>.asMutSlice(&mut flow.offsets)
    offsets[at] = offsets[at] + offsets[at - usize.ONE]
    at = at + usize.ONE
  }
  let offsets = List<usize>.asSlice(&flow.offsets)
  let edgeCount = offsets[points.length]
  at = usize.ZERO
  while at < edgeCount { run List<usize>.append(&mut flow.predecessors, usize.ZERO) at = at + usize.ONE }
  let mut cursor = List<usize>.make()
  at = usize.ZERO
  while at < points.length { run List<usize>.append(&mut cursor, offsets[at]) at = at + usize.ONE }
  at = usize.ZERO
  while at < points.length {
    let next = List<usize>.asSlice(&points[at].next)
    let mut edge = usize.ZERO
    while edge < next.length {
      let mut positions = List<usize>.asMutSlice(&mut cursor)
      let index = positions[next[edge]]
      positions[next[edge]] = index + usize.ONE
      let mut predecessors = List<usize>.asMutSlice(&mut flow.predecessors)
      predecessors[index] = at
      edge = edge + usize.ONE
    }
    at = at + usize.ONE
  }
  return ()
}

effect fn intervalEndpoint(points: &[Point], endpoint: usize, flow: &mut IntervalFlow) -> usize
! OutOfMemoryError ? &mut Allocator {
  let ends = List<usize>.asSlice(&flow.endpoints)
  let mut at = usize.ZERO
  while at < ends.length { if ends[at] == endpoint { return at } at = at + usize.ONE }
  run intervalPredecessors(points, &mut flow.*)
  let mut reached = List<u64>.make()
  let words = (points.length + 63) / 64
  at = usize.ZERO
  while at < words { run List<u64>.append(&mut reached, 0) at = at + usize.ONE }
  drop includeRegionPoint(&mut reached, endpoint)
  let mut pending = List<usize>.make()
  run List<usize>.append(&mut pending, endpoint)
  at = usize.ZERO
  while at < List<usize>.length(&pending) {
    let point = List<usize>.asSlice(&pending)[at]
    let offsets = List<usize>.asSlice(&flow.offsets)
    let predecessors = List<usize>.asSlice(&flow.predecessors)
    let mut edge = offsets[point]
    while edge < offsets[point + usize.ONE] {
      let previous = predecessors[edge]
      if includeRegionPoint(&mut reached, previous) { run List<usize>.append(&mut pending, previous) }
      edge = edge + usize.ONE
    }
    at = at + usize.ONE
  }
  let index = List<usize>.length(&flow.endpoints)
  run List<usize>.append(&mut flow.endpoints, endpoint)
  run List<List<u64>>.append(&mut flow.reaching, move reached)
  return index
}

// An owned place can exist before a fresh loan is taken. Keep this storage fact separate from
// actual loan activity and from the universal-source proof. Each cached mask is a must fact:
// any entry path avoiding the root's initialization excludes every point it reaches.
struct RegionAvailability {
  roots: List<usize>
  masks: List<List<u64>>
  finiteParents: List<Shared<Lifetime>>
  // Authenticated body-scoped choices have no storage source of their own. Every later
  // relation still constrains them through the same graph as actual source regions.
  choices: List<Shared<Lifetime>>
}

fn emptyRegionAvailability() -> RegionAvailability {
  return RegionAvailability {roots: List<usize>.make(), masks: List<List<u64>>.make(),
    finiteParents: List<Shared<Lifetime>>.make(), choices: List<Shared<Lifetime>>.make()}
}

fn initializedOwnedSource(loan: &Loan, region: &Shared<Lifetime>) -> bool {
  if !loan.local || !provable(loan.precision) { return false }
  if let Option<Shared<Lifetime>>.Some {..} = &loan.parent { return false }
  // A direct borrow can be shortened to a meet. Each actual constituent still names this
  // same initialized storage; an unrelated nested lifetime does not. Authenticate membership
  // in both the sole retained lifetime and the borrow itself before using the root's must-mask.
  let named = List<Shared<Lifetime>>.asSlice(&loan.regions)
  if named.length != usize.ONE || (!Lifetime.equalsShared(&named[0], region) && !meetMember(&named[0], region)) { return false }
  if let Option<Shared<Lifetime>>.Some {value: borrowed} = &loan.borrowed {
    if !Lifetime.equalsShared(&borrowed, region) && !meetMember(&borrowed, region) { return false }
  } else { return false }
  return true
}

// The initializer is an actual storage-owner occurrence. The common must-mask still rejects
// cycles through initialization and every path from entry which avoids that initialization.
effect fn initializedStorageRegion(points: &[Point], entry: usize, root: usize, initialized: usize,
  storage: &mut RegionAvailability, flow: &mut IntervalFlow) -> usize
! OutOfMemoryError ? &mut Allocator {
  if initialized >= points.length || entry >= points.length { return usize.MAX }
  let roots = List<usize>.asSlice(&storage.roots)
  let mut at = usize.ZERO
  while at < roots.length { if roots[at] == root { return at } at = at + usize.ONE }
  // This proof authenticates one storage instance. A root rebound around a CFG cycle keeps
  // the creation lower bound; a new iteration must not revive an earlier escaped loan.
  let endpoint = run intervalEndpoint(points, initialized, &mut flow.*)
  let reached = List<List<u64>>.asSlice(&flow.reaching)
  let paths = List<u64>.asSlice(&reached[endpoint])
  let successors = List<usize>.asSlice(&points[initialized].next)
  at = usize.ZERO
  while at < successors.length {
    if u64.bitAnd(paths[wordOf(successors[at])], maskOf(successors[at])) != 0 { return usize.MAX }
    at = at + usize.ONE
  }
  let mut available = List<u64>.make()
  let words = (points.length + 63) / 64
  at = usize.ZERO
  while at < words { run List<u64>.append(&mut available, u64.bitNot(0)) at = at + usize.ONE }
  let mut pending = List<usize>.make()
  if initialized != entry && excludeRegionPoint(&mut available, entry) {
    run List<usize>.append(&mut pending, entry)
  }
  at = usize.ZERO
  while at < List<usize>.length(&pending) {
    let point = List<usize>.asSlice(&pending)[at]
    let next = List<usize>.asSlice(&points[point].next)
    let mut edge = usize.ZERO
    while edge < next.length {
      if next[edge] != initialized && excludeRegionPoint(&mut available, next[edge]) {
        run List<usize>.append(&mut pending, next[edge])
      }
      edge = edge + usize.ONE
    }
    at = at + usize.ONE
  }
  let index = List<usize>.length(&storage.roots)
  run List<usize>.append(&mut storage.roots, root)
  run List<List<u64>>.append(&mut storage.masks, move available)
  return index
}



fn loanReleasePolicy(loans: &[Loan], index: usize) -> bool {
  let loan = &loans[index]
  if loan.escapes || loan.until != usize.MAX { return false }
  // A parent can still be needed through a child whose carrier has a different loan identity.
  // Keep its full availability constraint unless all such dependencies are accounted for.
  let mut at = usize.ZERO
  while at < loans.length {
    if at != index {
      if let Option<Shared<Lifetime>>.Some {value: parent} = &loans[at].parent {
        let named = List<Shared<Lifetime>>.asSlice(&loan.regions)
        let mut each = usize.ZERO
        while each < named.length {
          let mut atom = usize.ZERO
          while atom < Lifetime.atomCount(&named[each]) {
            if meetMember(&parent, &Lifetime.atomAt(&named[each], atom)) { return false }
            atom = atom + usize.ONE
          }
          each = each + usize.ONE
        }
      }
    }
    at = at + usize.ONE
  }
  return true
}

// Shared source-instance state machine. Callers must authenticate actual occupancy and ends,
// preserve the owned/escape/parent gates, and check each loan's own needs before using release.
effect fn releasedInstancePoints(points: &[Point], entry: usize, created: usize,
  occupied: &[bool], ends: &[bool]) -> List<u64> ! OutOfMemoryError ? &mut Allocator {
  if entry >= points.length || created >= points.length || occupied.length != points.length || ends.length != points.length {
    return CompilerBug.panic(b"loan release tables do not cover the actual CFG")
  }
  let mut released = List<u64>.make()
  let words = (points.length + 63) / 64
  let mut word = usize.ZERO
  while word < words { run List<u64>.append(&mut released, 0) word = word + usize.ONE }
  // Bit 1: this path has not created the loan; bit 2: it still carries the source;
  // bit 4: it created and released the source. Joins keep every incoming possibility.
  let mut states = List<u64>.make()
  let mut at = usize.ZERO
  while at < points.length { run List<u64>.append(&mut states, 0) at = at + usize.ONE }
  let mut initial = List<u64>.asMutSlice(&mut states)
  initial[entry] = 1
  let mut changed = true
  while changed {
    changed = false
    at = usize.ZERO
    while at < points.length {
      let incoming = List<u64>.asSlice(&states)[at]
      if incoming != 0 {
        let mut outgoing = incoming
        if at == created { outgoing = 2 }
        else if occupied[at] {
          outgoing = u64.bitOr(u64.bitAnd(incoming, 1), 2)
        }
        // Only a recorded consumption or replacement can terminate an instance. Mere absence
        // of a carrier is not release evidence, including on a cycle before initialization.
        if ends[at] && u64.bitAnd(outgoing, 2) != 0 {
          outgoing = u64.bitOr(u64.bitAnd(outgoing, 1), 4)
        }
        let next = List<usize>.asSlice(&points[at].next)
        let mut edge = usize.ZERO
        while edge < next.length {
          let mut entries = List<u64>.asMutSlice(&mut states)
          let before = entries[next[edge]]
          entries[next[edge]] = u64.bitOr(before, outgoing)
          if entries[next[edge]] != before { changed = true }
          edge = edge + usize.ONE
        }
      }
      at = at + usize.ONE
    }
  }
  at = usize.ZERO
  while at < points.length {
    let state = List<u64>.asSlice(&states)[at]
    // A concrete release must reach the point; absence before any source was created is not
    // evidence that initialization, a write, or a storage end can be ignored.
    if !occupied[at] && u64.bitAnd(state, 4) != 0 && u64.bitAnd(state, 2) == 0 {
      drop includeRegionPoint(&mut released, at)
    }
    at = at + usize.ONE
  }
  return move released
}

// Own-source inclusion always precedes release: another loan's validity cannot satisfy it.
fn regionSourceFits(required: &[u64], available: &[u64]) -> bool {
  if required.length != available.length { return false }
  let mut word = usize.ZERO
  while word < required.length {
    if u64.bitAnd(required[word], u64.bitNot(available[word])) != 0 { return false }
    word = word + usize.ONE
  }
  return true
}

fn mergeRegionSource(required: &mut List<u64>, available: &mut List<u64>, needed: &[u64], own: &[u64], released: &[u64]) -> () {
  let mut all = List<u64>.asMutSlice(&mut available.*)
  let mut gathered = List<u64>.asMutSlice(&mut required.*)
  if all.length != gathered.length || needed.length != all.length || own.length != all.length || released.length != all.length
    || !regionSourceFits(needed, own) { CompilerBug.panic(b"region source must satisfy its own needs before release") }
  let mut word = usize.ZERO
  while word < all.length {
    all[word] = u64.bitAnd(all[word], u64.bitOr(own[word], released[word]))
    gathered[word] = u64.bitOr(gathered[word], needed[word])
    word = word + usize.ONE
  }
}

// Whether `loan` is an exact loan of storage the body owns: rooted in a local or a temporary's
// hidden owner, which ends with its statement, with no reference step and no parent region, so no
// reborrow of storage reached through a reference. A field store keeps its carriers exact
// (`LoanPrecision.Stored`), and what it borrows is unchanged.
fn sourceOwnedGeometry(loan: &Loan, geometry: &SourceSettledGeometry, universal: bool) -> SourceTruth {
  let places = List<SourceSettledPlace>.asSlice(&geometry.alternatives)
  let mut uncertain = geometry.unresolved
  let mut seen = false
  let mut rejected = false
  let mut at = usize.ZERO
  while at < places.length {
    let active = places[at].activity
    if active != SourceTruth.False {
      if active == SourceTruth.Undefined { uncertain = true }
      if ownedPlace(loan, &places[at].place) {
        if active == SourceTruth.True { if !universal { return SourceTruth.True } seen = true }
      } else { rejected = true }
    }
    at = at + usize.ONE
  }
  if universal && rejected { return SourceTruth.False }
  if uncertain { return SourceTruth.Undefined }
  if universal && seen { return SourceTruth.True }
  return SourceTruth.False
}

effect fn sourceCopyGeometry(geometry: &SourceSettledGeometry) -> SourceSettledGeometry
! OutOfMemoryError ? &mut Allocator {
  let mut result = SourceSettledGeometry {alternatives: List<SourceSettledPlace>.make(), unresolved: geometry.unresolved}
  let places = List<SourceSettledPlace>.asSlice(&geometry.alternatives)
  let mut at = usize.ZERO
  while at < places.length {
    run List<SourceSettledPlace>.append(&mut result.alternatives, SourceSettledPlace {
      place: Place {root: places[at].place.root, steps: run copySteps(List<Step>.asSlice(&places[at].place.steps))}, activity: places[at].activity})
    at = at + usize.ONE
  }
  return move result
}

effect fn regionTestGeometry(place: &Place) -> SourceSettledGeometry ! OutOfMemoryError ? &mut Allocator {
  let mut result = SourceSettledGeometry {alternatives: List<SourceSettledPlace>.make(), unresolved: false}
  run List<SourceSettledPlace>.append(&mut result.alternatives, SourceSettledPlace {
    place: Place {root: place.root, steps: run copySteps(List<Step>.asSlice(&place.steps))}, activity: SourceTruth.True})
  return move result
}





fn ownedPlace(loan: &Loan, place: &Place) -> bool {
  if !loan.local || place.root == usize.MAX { return false }
  if let Option<Shared<Lifetime>>.Some {..} = &loan.parent { return false }
  let steps = List<Step>.asSlice(&place.steps)
  let mut at = usize.ZERO
  while at < steps.length {
    if steps[at].kind == StepKind.Referent { return false }
    at = at + usize.ONE
  }
  return true
}

// The window of a write at `span` whose target's type is `written`: the universal lifetime
// parameters that type names, or none when it names none.
effect fn storeWindow(owner: &DeclarationId, written: &Shared<Type>, span: Location, holder: usize) -> Option<StoreWindow>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut atoms = List<Shared<Lifetime>>.make()
  run Type.regionAtoms(written, &mut atoms)
  let mut regions = List<Shared<Lifetime>>.make()
  let named = List<Shared<Lifetime>>.asSlice(&atoms)
  let mut at = usize.ZERO
  while at < named.length {
    let parameter = Shared<Lifetime>.with<bool>(&named[at], fn(value: &Lifetime) -> bool {
      return match &value.* { Lifetime.Parameter {..} => true _ => false }
    })
    if parameter && regionDomain(&named[at], owner, List<Shared<Lifetime>>.asSlice(&regions)) == RegionDomain.Universal && !proofContains(List<Shared<Lifetime>>.asSlice(&regions), &named[at]) {
      run List<Shared<Lifetime>>.append(&mut regions, Shared<Lifetime>.clone(&named[at]))
    }
    at = at + usize.ONE
  }
  if List<Shared<Lifetime>>.length(&regions) == usize.ZERO { return Option<StoreWindow>.none() }
  return Option<StoreWindow>.some(StoreWindow {span: span, regions: move regions, holder: holder})
}

// The operand a `move` takes, or `id` itself.
fn movedOperand(nodes: &[Node], id: NodeId) -> NodeId {
  if let NodeKind.Expression {form: Expression.Move {value, ..}, ..} = &nodes[id.index].kind { return movedOperand(nodes, value) }
  return id
}

// Whether `listed` holds `local`.
fn listsLocal(listed: &[usize], local: usize) -> bool {
  let mut at = usize.ZERO
  while at < listed.length {
    if listed[at] == local { return true }
    at = at + usize.ONE
  }
  return false
}

// Whether a goal into `wanted`, admitted at `site`, belongs to a recorded write whose target's type
// names `wanted`: a write through a reference, or one into a local whose value a write through a
// reference stores; with `returned`, also a value a `return` stores in the caller's result slot. A local has one region, so every value written into it must outlive what the
// stored value must.
fn storedGoal<'proof>(sources: &EscapeSources<'proof>, wanted: &Shared<Lifetime>, site: Location, returned: bool) -> bool {
  if returned && windowGoal(sources, sources.returns, wanted, site)
    && !sealedSite(sources, sources.returns, site) { return true }
  return windowGoal(sources, sources.stores, wanted, site)
}

// Whether `site` lies in the operand of a call inside a returned value whose result can retain no
// region: what reaches that call, such as a borrow passed to an inner call whose region typing
// relates to the caller's but whose value only a length or a count reads, never reaches the
// returned value, so a goal admitted there is no requirement of the result slot. Only the innermost
// `return` holding the site decides: a `return` nested in the call's operand returns its own value,
// which the call's result never receives.
fn sealedSite<'proof>(sources: &EscapeSources<'proof>, windows: &[StoreWindow], site: Location) -> bool {
  let mut inner = usize.MAX
  let mut window = usize.ZERO
  while window < windows.length {
    if site.start >= windows[window].span.start && site.end <= windows[window].span.end
      && (inner == usize.MAX || (windows[window].span.start >= windows[inner].span.start
        && windows[window].span.end <= windows[inner].span.end)) {
      inner = window
    }
    window = window + usize.ONE
  }
  if inner == usize.MAX { return false }
  let returned = windows[inner].span
  let sealed = sources.sealed
  let mut at = usize.ZERO
  while at < sealed.length {
    if site.start >= sealed[at].start && site.end <= sealed[at].end
      && sealed[at].start >= returned.start && sealed[at].end <= returned.end { return true }
    at = at + usize.ONE
  }
  return false
}

// Whether one of `windows` admits a goal into `wanted` at `site` (`storedGoal`).
fn windowGoal<'proof>(sources: &EscapeSources<'proof>, windows: &[StoreWindow], wanted: &Shared<Lifetime>, site: Location) -> bool {
  let mut at = usize.ZERO
  while at < windows.length {
    if site.start >= windows[at].span.start && site.end <= windows[at].span.end
      && proofContains(List<Shared<Lifetime>>.asSlice(&windows[at].regions), wanted)
      && (windows[at].holder == usize.MAX || listsLocal(sources.escaping, windows[at].holder)) { return true }
    at = at + usize.ONE
  }
  return false
}

// The first loan of storage this body owns whose region the retained relations require to outlive
// a lifetime parameter of the body or a named enclosing declaration, or `usize.MAX`. The relations
// are the body's region goals: each offered region must outlive its wanted one. A seed is a goal
// admitted inside a write whose target's type names its single wanted parameter (`storedGoal`), or,
// with `returned`, inside a `return`: the value is stored in caller storage typed at that parameter,
// directly, as the caller's result, or through a local whose value is, so every atom of its offered side must outlive it. A goal into a single atom so required passes the requirement on to
// its offered atoms. Other goals are not seeds: a call's region binding need not be minimal, so a
// goal it admits into a universal region may be longer than any solution needs, and a goal into
// 'static may be an Effect environment that a run in this body uses only finitely. A goal into a
// meet requires only the meet, so it passes nothing on, and a provisional goal waiting on an
// inferred 'static is no requirement yet. A goal admitted inside an operand its call's result cannot
// hold (`unheldSite`) relates the operand only to the call's binder, which the callee's signature
// keeps apart from its result, so it is neither a seed nor passes a requirement on; a loan made
// there may be typed at that binder, so the result's requirements are none of its own. Owned storage
// ends with the body at the latest, so a loan of it so required is never valid.
effect fn escapingOwnedLoan<'proof>(sources: &EscapeSources<'proof>, owner: &DeclarationId, obligations: &[SafetyObligation], returned: bool) -> EscapeResult
! OutOfMemoryError ? &mut Allocator {
  let mut required = List<Shared<Lifetime>>.make()
  let mut changed = true
  while changed {
    changed = false
    let mut at = usize.ZERO
    while at < obligations.length {
      if let SafetyObligation.RegionRelation {origin, offered, wanted, inferredStatic} = &obligations[at] {
        let provisional = match &inferredStatic { Option<Shared<Lifetime>>.Some {..} => true _ => false }
        if !provisional && !unheldSite(sources, origin.location) && Lifetime.atomCount(&wanted) == usize.ONE
          && (storedGoal(sources, &wanted, origin.location, returned) || proofContains(List<Shared<Lifetime>>.asSlice(&required), &wanted)) {
          let count = Lifetime.atomCount(&offered)
          let mut atom = usize.ZERO
          while atom < count {
            let member = Lifetime.atomAt(&offered, atom)
            if regionLocal(&member, owner) && !proofContains(List<Shared<Lifetime>>.asSlice(&required), &member) {
              run List<Shared<Lifetime>>.append(&mut required, move member)
              changed = true
            }
            atom = atom + usize.ONE
          }
        }
      }
      at = at + usize.ONE
    }
  }
  let held = List<Shared<Lifetime>>.asSlice(&required)
  if held.length == usize.ZERO { return EscapeResult {loan: usize.MAX, unresolved: false} }
  let loans = sources.loans
  let mut unresolved = false
  let mut index = usize.ZERO
  while index < loans.length {
    if sources.activity.length != loans.length { return CompilerBug.panic(b"escape refutation lost actual loan activity") }
    let active = sources.activity[index]
    if active == SourceTruth.False { index = index + usize.ONE continue }
    if sources.precision.length != loans.length { return CompilerBug.panic(b"escape snapshot lost its immutable precision inventory") }
    let precision = sources.precision[index]
    let mut owned = SourceTruth.False
    if precision == LoanPrecision.Exact || precision == LoanPrecision.Stored {
      if sources.geometry.length != loans.length { return CompilerBug.panic(b"escape snapshot lost its original geometry") }
      owned = sourceOwnedGeometry(&loans[index], &sources.geometry[index], false)
    }
    if owned != SourceTruth.False && !unheldSite(sources, loans[index].origin) {
      let regions = List<Shared<Lifetime>>.asSlice(&loans[index].regions)
      let mut at = usize.ZERO
      while at < regions.length {
        if proofContains(held, &regions[at]) {
          if active == SourceTruth.True && owned == SourceTruth.True { return EscapeResult {loan: index, unresolved: unresolved} }
          unresolved = true
        }
        at = at + usize.ONE
      }
    }
    index = index + usize.ONE
  }
  return EscapeResult {loan: usize.MAX, unresolved: unresolved}
}

enum RegionRelationStep { Satisfied, Finite, Unproved }

// The universal/captured/meet gates are shared by both staging callers. Finite returns only
// a request to the point-set proof, never a shortcut based on equal regions or equal masks.
effect fn regionRelationStep<'proof>(sources: &RegionSources<'proof>, owner: &DeclarationId,
  member: &Shared<Lifetime>, wanted: &Shared<Lifetime>, count: usize, premises: &[RegionBound],
  symbolic: &mut List<SymbolicRegion>) -> RegionRelationStep ! OutOfMemoryError ? &mut Allocator {
  let longer = regionDomain(member, owner, sources.supplied)
  if Lifetime.atomCount(wanted) > usize.ONE
    && (meetMember(wanted, member) || (longer == RegionDomain.Universal && meetHoldsLocal(wanted, owner))) {
    return RegionRelationStep.Satisfied
  }
  let shorter = regionDomain(wanted, owner, sources.supplied)
  if longer == RegionDomain.Local && shorter == RegionDomain.Universal {
    if !run symbolicRegionProved(sources, owner, member, wanted, premises, &mut symbolic.*) { return RegionRelationStep.Unproved }
  } else if shorter == RegionDomain.Local && (longer == RegionDomain.Universal
    || (longer == RegionDomain.Unknown && capturedFiniteSource(member, owner))) {
    // Captured locals remain Unknown for outward goals. Only this recorded finite use in
    // the nested invocation is covered; its enclosing construction still owns the capture.
  } else if longer == RegionDomain.Universal && shorter == RegionDomain.Universal {
    if !declaredRelationProved(member, wanted, count)
      && !run universalRegionProved(owner, sources.supplied, member, wanted, premises) { return RegionRelationStep.Unproved }
  } else { return RegionRelationStep.Finite }
  return RegionRelationStep.Satisfied
}

// Worklist edges point shorter -> longer (§4.3). Keeping a boundary's edge active everywhere
// over-approximates its location-sensitive requirements. Failed inclusions therefore stay pending
// until that finer proof exists; successful inclusions discharge the complete original relation.
effect fn recordRegionChoices(owner: &DeclarationId, obligations: &[SafetyObligation], storage: &mut RegionAvailability)
  -> bool ! OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < obligations.length {
    if let SafetyObligation.RegionChoice {origin, region} = &obligations[at] {
      if !Shared<Lifetime>.with<bool>(&region, fn(value: &Lifetime) -> bool {
        return match &value.* {
          Lifetime.Local {declaration, ordinal} => DeclarationId.equals(&declaration, owner) && ordinal == origin.node
          _ => false
        }
      }) { return false }
      if !proofContains(List<Shared<Lifetime>>.asSlice(&storage.choices), &region) {
        run List<Shared<Lifetime>>.append(&mut storage.choices, Shared<Lifetime>.clone(&region))
      }
    }
    at = at + usize.ONE
  }
  return true
}

// A type chosen before this invocation cannot contain a region created inside it. This proves
// only the recorded finite capture use, never a declared Contents premise or an outward bound.
fn finiteCaptureContents(owner: &DeclarationId, origin: Origin, subject: &Shared<Type>, region: &Shared<Lifetime>) -> bool {
  let local = Shared<Lifetime>.with<bool>(region, fn(value: &Lifetime) -> bool {
    return match &value.* {
      Lifetime.Local {declaration, ordinal} => DeclarationId.equals(&declaration, owner) && ordinal == origin.node
      _ => false
    }
  })
  if !local { return false }
  return Shared<Type>.with<bool>(subject, fn(value: &Type) -> bool {
    return match &value.* {
      Type.Parameter {declaration, ..} => DeclarationId.equals(&declaration, owner) || namedEnclosing(&declaration, owner)
      _ => false
    }
  })
}

effect fn solveRegionRequirements(regions: &mut List<RegionPoints>, links: &[RegionEdge]) -> bool
! OutOfMemoryError ? &mut Allocator {
  // Each region's own requirement reaches every region that must outlive it. One that returns to its
  // origin through a cycle of relations, as two regions related both ways do, was already checked
  // loan by loan there; checking it again against every loan of the origin would refuse a loan
  // whose own validity ends before another loan of the same region is still needed.
  let count = List<RegionPoints>.length(&regions.*)
  let mut own = List<List<u64>>.make()
  let mut at = usize.ZERO
  while at < count {
    let entries = List<RegionPoints>.asSlice(&regions.*)
    let mut words = List<u64>.make()
    let required = List<u64>.asSlice(&entries[at].required)
    let mut word = usize.ZERO
    while word < required.length { run List<u64>.append(&mut words, required[word]) word = word + usize.ONE }
    run List<List<u64>>.append(&mut own, move words)
    at = at + usize.ONE
  }
  let mut origin = usize.ZERO
  while origin < count {
    let mut reached = List<bool>.make()
    at = usize.ZERO
    while at < count { run List<bool>.append(&mut reached, at == origin) at = at + usize.ONE }
    let mut queue = List<usize>.make()
    run List<usize>.append(&mut queue, origin)
    let mut next = usize.ZERO
    while next < List<usize>.length(&queue) {
      let source = List<usize>.asSlice(&queue)[next]
      let mut edge = usize.ZERO
      while edge < links.length {
        let link = links[edge]
        if link.shorter == source && link.longer < count && !List<bool>.asSlice(&reached)[link.longer] {
          let mut marked = List<bool>.asMutSlice(&mut reached)
          marked[link.longer] = true
          run List<usize>.append(&mut queue, link.longer)
        }
        edge = edge + usize.ONE
      }
      next = next + usize.ONE
    }
    let sourceWords = List<u64>.asSlice(&List<List<u64>>.asSlice(&own)[origin])
    let flags = List<bool>.asSlice(&reached)
    at = usize.ZERO
    while at < count {
      if at != origin && flags[at] {
        let mut entries = List<RegionPoints>.asMutSlice(&mut regions.*)
        let mut word = usize.ZERO
        while word < sourceWords.length {
          let mut words = List<u64>.asMutSlice(&mut entries[at].required)
          words[word] = u64.bitOr(words[word], sourceWords[word])
          let mut arrived = List<u64>.asMutSlice(&mut entries[at].incoming)
          arrived[word] = u64.bitOr(arrived[word], sourceWords[word])
          word = word + usize.ONE
        }
      }
      at = at + usize.ONE
    }
    origin = origin + usize.ONE
  }
  let solved = List<RegionPoints>.asSlice(&regions.*)
  at = usize.ZERO
  while at < solved.length {
    let arrivedWords = List<u64>.asSlice(&solved[at].incoming)
    let available = List<u64>.asSlice(&solved[at].available)
    let mut word = usize.ZERO
    while word < arrivedWords.length {
      if u64.bitAnd(arrivedWords[word], u64.bitNot(available[word])) != 0 { return false }
      word = word + usize.ONE
    }
    at = at + usize.ONE
  }
  return true
}

/// Whether every region a body's locals and values name is closed for this body: `'static`, a
/// universal region chosen before the body runs, or a loan region of the body itself, so its loans
/// and their scopes are the whole region proof.
///
/// # Details
///
/// Storage-end events prove local validity on every outgoing path. Reaching definitions and
/// backward liveness decide which holder loans are required; in-flight joins and cleanup use the
/// graph's actual paths. A referent loan crossing a boundary remains external to this local proof.
/// Universal regions are the lifetime parameters of this declaration and of every named declaration
/// enclosing it (an impl's parameters in a method, an enclosing function's in an anonymous body),
/// and an anonymous body's invocation binders. A local region of an enclosing named body is a capture
/// dependency: the enclosing body bounds its formation and retention with its own points, and
/// this body proves only its own uses (R3 amendment 4). Owned body storage cannot outlive the
/// body. An inferred region can satisfy a universal bound only through the separate symbolic
/// source proof; classifying its atoms here does not prove that bound. A callable contract's
/// invocation binders describe future calls, so a nested callable's own parameters are closed
/// wherever its value is held, as in an Effect application that carries it, and an invocation
/// region is closed where it occurs only inside the callables a type holds. A parent's binder in
/// an escaped child's contract is not the child's own and stays open. Exact callable lifetime and
/// row application arguments are selection metadata; Type.bodyRegionAtoms still checks their
/// contracts, captures and type evidence. A Supplied atom is closed only when it is one of
/// `supplied`, the body's own selected application regions; any other remains open. Callee
/// contracts and outside-body type parameters cannot smuggle in a fresh body-local region.
pub effect fn regionClosed(owner: &DeclarationId, supplied: &[Shared<Lifetime>], locals: &[Local], nodes: &[Node]) -> bool ! OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < locals.length {
    if !run typeRegionClosed(&locals[at].ty, owner, supplied) {
      return false
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < nodes.length {
    if let NodeKind.Expression {ty, ..} = &nodes[at].kind {
      if !run typeRegionClosed(&ty, owner, supplied) {
        return false
      }
    }
    at = at + usize.ONE
  }
  return true
}

// Whether `declaration` is a named declaration enclosing `owner`: an impl around a method, or the
// function around an anonymous body. An enclosing anonymous body's own binders and locals stay open,
// so a literal nested in another literal proves nothing about its enclosing literal.
fn namedEnclosing(declaration: &DeclarationId, owner: &DeclarationId) -> bool {
  let kind = DeclarationId.kind(declaration)
  return kind != OwnerKind.Anonymous && kind != OwnerKind.EffectBlock && DeclarationId.isPrefixOf(declaration, owner)
}

// Where a call can keep a loan one operand carries: `Local` also when the operand holds none of it.
fn keptSink(paths: &[List<Step>], loan: &Loan, owner: &DeclarationId, carry: SourceSlotValue, sink: &OperandSink, located: &mut bool) -> CallSink {
  let origin = loan.origin
  // An operand whose type names only `'static` holds no loan of the body unless typing gave that
  // loan a `'static` region; one the walk carries into it otherwise is not part of its value.
  let regions = List<Shared<Lifetime>>.asSlice(&loan.regions)
  if !sink.holds && (regions.length == usize.ZERO || !staticRegions(&loan.regions)) { return CallSink.Local }
  let mut kept = sink.whole
  let mut approximate = sink.wholeApproximate
  let mut own = origin.start == sink.span.start && origin.end == sink.span.end
  if let Option<Shared<Lifetime>>.Some {value: region} = &sink.view {
    let typed = List<Shared<Lifetime>>.asSlice(&loan.regions)
    let mut at = usize.ZERO
    while !own && at < typed.length {
      own = Lifetime.equalsShared(&typed[at], &region)
      at = at + usize.ONE
    }
  }
  let mut positioned = false
  if own {
    kept = sink.outer
    approximate = sink.outerApproximate
  } else {
    positioned = narrowSlots(paths, carry, loan, sink, &mut kept, &mut approximate)
  }
  // A structural slot is the actual destination of this carried value after coercion. Without
  // that correspondence, local region names alone cannot establish a universal retention path.
  if !own && !positioned && kept == CallSink.Universal && typedLocally(&loan.regions, owner) { kept = CallSink.Unknown }
  // An approximate channel's universal region may be longer than any binding needs: only a loan
  // typing gave a universal region is held to it, and any other leaves the body unchecked.
  if kept != CallSink.Universal && approximate == CallSink.Universal {
    if universalRegions(&loan.regions, owner) {
      kept = CallSink.Universal
    } else {
      kept = CallSink.Unknown
    }
  } else if kept == CallSink.Local && approximate == CallSink.Unknown {
    kept = CallSink.Unknown
  }
  located.* = positioned || (own && carry.direct && carry.field == usize.ZERO)
  return kept
}

// Completed classifications and their actual-slot witnesses share carry order. Parent
// closure may promote a sink, but never manufactures a structural-slot witness.

// A known value path identifies the slot carrying a loan even after region shortening or
// projection changes its referent type. Unknown paths retain the whole-operand judgment unless
// the reference's own type rules out a slot; opaque contents never establish an exact position.
fn narrowSlots(paths: &[List<Step>], carry: SourceSlotValue, loan: &Loan, sink: &OperandSink, kept: &mut CallSink, approximate: &mut CallSink) -> bool {
  let slots = List<SlotSink>.asSlice(&sink.slots)
  if sink.undescribed || slots.length == usize.ZERO { return false }
  let mut occupied = false
  let mut positioned = false
  let mut uncertain = false
  let mut precise = CallSink.Local
  let mut wider = CallSink.Local
  let mut at = usize.ZERO
  while at < slots.length {
    let mut matched = SlotPath.Unknown
    if carry.field != usize.MAX {
      matched = transferSlotPath(List<Step>.asSlice(&paths[carry.field]), List<KeptStep>.asSlice(&slots[at].path), slots[at].view)
    }
    let mut fits = matched == SlotPath.Same
    if matched == SlotPath.Unknown {
      if !carry.direct { return false }
      if let Option<Shared<Type>>.Some {value: referent} = &loan.referent {
        fits = Type.mayHoldLoan(slots[at].view, &slots[at].referent, slots[at].exclusive, &referent, loan.exclusive)
      }
    }
    if fits {
      occupied = true
      if matched == SlotPath.Same && slots[at].view { positioned = true }
      if matched == SlotPath.Unknown || !slots[at].view { uncertain = true }
      let mut slotKept = slots[at].kept
      let mut slotApproximate = slots[at].approximate
      if !slots[at].view {
        slotKept = sink.whole
        slotApproximate = sink.wholeApproximate
      }
      precise = joinSinks(precise, slotKept)
      wider = joinSinks(wider, slotApproximate)
    }
    at = at + usize.ONE
  }
  if !occupied { return false }
  kept.* = precise
  approximate.* = wider
  return positioned && !uncertain
}

// The longer of two sinks: unknown over universal over local.
fn joinSinks(left: CallSink, right: CallSink) -> CallSink {
  if left == CallSink.Unknown || right == CallSink.Unknown { return CallSink.Unknown }
  if left == CallSink.Universal || right == CallSink.Universal { return CallSink.Universal }
  return CallSink.Local
}

// Whether a region atom is chosen before the body runs and outlives it: `'static`, or a lifetime
// parameter of the body or of a named declaration enclosing it.
fn universalAtom(region: &Lifetime, owner: &DeclarationId) -> bool {
  return match &region.* {
    Lifetime.Static => true
    Lifetime.Parameter {declaration, ..} => DeclarationId.equals(&declaration, owner) || namedEnclosing(&declaration, owner)
    _ => false
  }
}

// Whether any of `regions` outlives the body: an intersection does only when every member does.
fn universalRegions(regions: &List<Shared<Lifetime>>, owner: &DeclarationId) -> bool {
  let named = List<Shared<Lifetime>>.asSlice(regions)
  let mut at = usize.ZERO
  while at < named.length {
    if Lifetime.allAtoms(&named[at], fn(atom: &Lifetime) -> bool { return universalAtom(atom, owner) }) { return true }
    at = at + usize.ONE
  }
  return false
}

// Whether `value` names regions and every one of them is a lifetime parameter that outlives the
// body. A value typed at 'static keeps only what is valid for 'static, which a body loan never is.
effect fn universallyTyped(value: &Shared<Type>, owner: &DeclarationId) -> bool ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut atoms = List<Shared<Lifetime>>.make()
  run Type.regionAtoms(value, &mut atoms)
  let named = List<Shared<Lifetime>>.asSlice(&atoms)
  if named.length == usize.ZERO { return false }
  let mut at = usize.ZERO
  while at < named.length {
    let parameter = Shared<Lifetime>.with<bool>(&named[at], fn(atom: &Lifetime) -> bool {
      return match &atom.* { Lifetime.Parameter {..} => universalAtom(atom, owner) _ => false }
    })
    if !parameter { return false }
    at = at + usize.ONE
  }
  return true
}

// Whether typing gave a loan regions, none of which outlives the body.
fn typedLocally(regions: &List<Shared<Lifetime>>, owner: &DeclarationId) -> bool {
  return List<Shared<Lifetime>>.length(regions) != usize.ZERO && !universalRegions(regions, owner)
}

// Whether every one of `regions` is `'static`.
fn staticRegions(regions: &List<Shared<Lifetime>>) -> bool {
  let named = List<Shared<Lifetime>>.asSlice(regions)
  let mut at = usize.ZERO
  while at < named.length {
    if !Lifetime.allAtoms(&named[at], fn(atom: &Lifetime) -> bool { return match &atom.* { Lifetime.Static => true _ => false } }) { return false }
    at = at + usize.ONE
  }
  return true
}

// Where a call can keep an operand once it returns: in storage that outlives the caller's body, only
// within it, or somewhere this walk has no record to tell.
enum CallSink { Local, Universal, Unknown }

// What a call can keep of one operand (R3 amendment 4). `whole` answers for loans the operand
// carries in; `outer` answers for the loan the operand's own borrow creates, which the callee holds
// only as the reference it receives.
struct OperandSink {
  outer: CallSink
  whole: CallSink
  // Where a channel the analysis only approximates can also keep the operand (KeptRegions).
  outerApproximate: CallSink
  wholeApproximate: CallSink
  span: Location
  // Whether the operand's type can hold a loan of the body: it names a region other than `'static`
  // or a type parameter, or typing recorded none.
  holds: bool
  // The operand's own region when it is a view: a carried loan typed at it is the view's own borrow,
  // made earlier as when a call returns a view of its argument, so it is judged as `outer`.
  view: Option<Shared<Lifetime>>
  // Where the callee can keep a loan by where it lies in the operand (`KeptSlot`), or none.
  slots: List<SlotSink>
  // Whether the call could not describe the operand at all.
  undescribed: bool
}

// One `KeptSlot` of an operand: whether a loan can lie there and where the callee keeps it then. An
// opaque slot keeps a loan wherever the whole operand does.
struct SlotSink {
  path: List<KeptStep>
  view: bool
  referent: Shared<Type>
  exclusive: bool
  kept: CallSink
  approximate: CallSink
}

// An approximate channel's sink: unknown where the call could not describe the operand at all.
fn approximateSink(regions: &List<Shared<Lifetime>>, undescribed: bool, owner: &DeclarationId) -> CallSink {
  if undescribed { return CallSink.Unknown }
  return regionSink(regions, owner)
}

fn regionSink(regions: &List<Shared<Lifetime>>, owner: &DeclarationId) -> CallSink {
  if universalRegions(regions, owner) { return CallSink.Universal }
  return CallSink.Local
}

// What a call recorded it can keep of its operands, or none for a call this walk cannot see into.
// An immediate run walks as the call it executes.
fn callKept(nodes: &[Node], call: NodeId) -> Option<Shared<List<KeptRegions>>> {
  return match &nodes[call.index].kind {
    NodeKind.Expression {form: Expression.Run {value, access}, ..} => {
      if access == RunAccess.Immediate { return callKept(nodes, value) }
      return Option<Shared<List<KeptRegions>>>.none()
    }
    NodeKind.Expression {form: Expression.StagedCallable {retention, ..}, ..} => Option<Shared<List<KeptRegions>>>.some(Shared<List<KeptRegions>>.clone(&retention.kept))
    NodeKind.Expression {form: Expression.DirectCall {kept, ..}, ..} => Option<Shared<List<KeptRegions>>>.some(Shared<List<KeptRegions>>.clone(&kept))
    NodeKind.Expression {form: Expression.InterfaceCall {kept, ..}, ..} => Option<Shared<List<KeptRegions>>>.some(Shared<List<KeptRegions>>.clone(&kept))
    NodeKind.Expression {form: Expression.CallableCall {kept, ..}, ..} => Option<Shared<List<KeptRegions>>>.some(Shared<List<KeptRegions>>.clone(&kept))
    NodeKind.Expression {form: Expression.Aggregate {section, ..}, ..} => match &section {
      Option<SectionRetention>.Some {value} => Option<Shared<List<KeptRegions>>>.some(Shared<List<KeptRegions>>.clone(&value.kept))
      Option<SectionRetention>.None => Option<Shared<List<KeptRegions>>>.none()
    }
    _ => Option<Shared<List<KeptRegions>>>.none()
  }
}

effect fn operandSinks(nodes: &[Node], call: NodeId, arguments: &[NodeId], owner: &DeclarationId) -> List<OperandSink>
! OutOfMemoryError ? &mut Allocator {
  let mut sinks = List<OperandSink>.make()
  let recorded = callKept(nodes, call)
  // A call with no record, an intrinsic or foreign one, can keep an operand only in storage
  // another operand reaches, so it is undescribed only when some operand names a universal region
  // where it can store; a callable operand stores only where its contract's parameters reach. Its signature is fixed, and a loan of the body never has the body's type
  // parameter as its type.
  let mut reaches = false
  let mut at = usize.ZERO
  while at < arguments.length {
    let mut stored = List<Shared<Lifetime>>.make()
    if let Option<Shared<Type>>.Some {value} = move expressionType(nodes, arguments[at]) {
      run Type.callableStoredRegions(&value, &mut stored)
    }
    if universalRegions(&stored, owner) { reaches = true }
    at = at + usize.ONE
  }
  let mut unrecorded = CallSink.Local
  if reaches { unrecorded = CallSink.Unknown }
  at = usize.ZERO
  while at < arguments.length {
    // A stage captures a suffix of its selected signature. The base callable occupies value 0,
    // but is not a parameter of that signature and has no corresponding entry.
    let mut position = at
    if let NodeKind.Expression {form: Expression.StagedCallable {retention, ..}, ..} = &nodes[call.index].kind {
      position = usize.MAX
      if at != usize.ZERO { position = retention.first + at - usize.ONE }
    }
    if let NodeKind.Expression {form: Expression.Aggregate {section, ..}, ..} = &nodes[call.index].kind {
      if let Option<SectionRetention>.Some {value} = &section { position = value.first + at }
    }
    let span = nodes[arguments[at].index].origin.location
    let mut holds = true
    let mut view = Option<Shared<Lifetime>>.none()
    if let Option<Shared<Type>>.Some {value} = move expressionType(nodes, arguments[at]) {
      view = Type.viewRegion(&value)
      let mut named = List<Shared<Lifetime>>.make()
      run Type.regionAtoms(&value, &mut named)
      let generic = run Type.namesTypeParameter(&value)
      holds = generic || !staticRegions(&named)
    }
    let mut sink = OperandSink {outer: unrecorded, whole: unrecorded, outerApproximate: unrecorded, wholeApproximate: unrecorded,
      span: span, holds: holds, view: Option<Shared<Lifetime>>.none(), slots: List<SlotSink>.make(), undescribed: false}
    if let Option<Shared<List<KeptRegions>>>.Some {value: kept} = &recorded {
      let listed = Shared<List<KeptRegions>>.with<usize>(&kept, fn(values: &List<KeptRegions>) -> usize { return List<KeptRegions>.length(values) })
      if position < listed {
        sink = Shared<List<KeptRegions>>.with<OperandSink>(&kept, fn(values: &List<KeptRegions>) -> OperandSink {
          let entries = List<KeptRegions>.asSlice(values)
          return OperandSink {outer: regionSink(&entries[position].outer, owner), whole: regionSink(&entries[position].whole, owner),
            outerApproximate: approximateSink(&entries[position].outerApproximate, entries[position].undescribed, owner),
            wholeApproximate: approximateSink(&entries[position].wholeApproximate, entries[position].undescribed, owner),
            span: span, holds: holds, view: Option<Shared<Lifetime>>.none(), slots: List<SlotSink>.make(),
            undescribed: entries[position].undescribed}
        })
        let count = Shared<List<KeptRegions>>.with<usize>(&kept, fn(values: &List<KeptRegions>) -> usize {
          let entries = List<KeptRegions>.asSlice(values)
          return List<KeptSlot>.length(&entries[position].slots)
        })
        let mut index = usize.ZERO
        while index < count {
          let mut slot = Shared<List<KeptRegions>>.with<SlotSink>(&kept, fn(values: &List<KeptRegions>) -> SlotSink {
            let entries = List<KeptRegions>.asSlice(values)
            let listed = List<KeptSlot>.asSlice(&entries[position].slots)
            return SlotSink {path: List<KeptStep>.make(), view: listed[index].view, referent: Shared<Type>.clone(&listed[index].referent), exclusive: listed[index].exclusive,
              kept: regionSink(&listed[index].kept, owner), approximate: approximateSink(&listed[index].keptApproximate, entries[position].undescribed, owner)}
          })
          let length = Shared<List<KeptRegions>>.with<usize>(&kept, fn(values: &List<KeptRegions>) -> usize {
            return List<KeptStep>.length(&List<KeptSlot>.asSlice(&List<KeptRegions>.asSlice(values)[position].slots)[index].path)
          })
          let mut step = usize.ZERO
          while step < length {
            let value = Shared<List<KeptRegions>>.with<KeptStep>(&kept, fn(values: &List<KeptRegions>) -> KeptStep {
              return List<KeptStep>.asSlice(&List<KeptSlot>.asSlice(&List<KeptRegions>.asSlice(values)[position].slots)[index].path)[step]
            })
            run List<KeptStep>.append(&mut slot.path, value)
            step = step + usize.ONE
          }
          run List<SlotSink>.append(&mut sink.slots, move slot)
          index = index + usize.ONE
        }
      }
    }
    sink.view = move view
    run List<OperandSink>.append(&mut sinks, move sink)
    at = at + usize.ONE
  }
  return move sinks
}

// Whether any of `atoms` is an invocation region.
fn anyInvocationAtom(atoms: &[Shared<Lifetime>]) -> bool {
  let mut at = usize.ZERO
  while at < atoms.length {
    if Shared<Lifetime>.with<bool>(&atoms[at], fn(region: &Lifetime) -> bool { return match &region.* { Lifetime.Invocation {..} => true _ => false } }) { return true }
    at = at + usize.ONE
  }
  return false
}

// Whether `declaration` is one of the callable values a type holds (`Type.appendCallableTargets`).
fn namesTarget(targets: &[DeclarationId], declaration: &DeclarationId) -> bool {
  let mut at = usize.ZERO
  while at < targets.length {
    if DeclarationId.equals(&targets[at], declaration) { return true }
    at = at + usize.ONE
  }
  return false
}

effect fn typeRegionClosed(ty: &Shared<Type>, owner: &DeclarationId, supplied: &[Shared<Lifetime>]) -> bool ! OutOfMemoryError ? &mut Allocator {
  let mut atoms = List<Shared<Lifetime>>.make()
  run Type.bodyRegionAtoms(ty, &mut atoms)
  let listed = List<Shared<Lifetime>>.asSlice(&atoms)
  let kind = DeclarationId.kind(owner)
  let anonymous = kind == OwnerKind.Anonymous || kind == OwnerKind.EffectBlock
  let callable = Shared<Type>.with<bool>(ty, callableValue)
  let mut nested = List<DeclarationId>.make()
  run Type.appendCallableTargets(ty, &mut nested)
  let targets = List<DeclarationId>.asSlice(&nested)
  // An invocation region describes a callable's future calls only inside that callable: one the type
  // names outside every callable it holds is open.
  let mut outside = List<Shared<Lifetime>>.make()
  run Type.regionAtomsOutsideCallables(ty, &mut outside)
  let invocationOutside = anyInvocationAtom(List<Shared<Lifetime>>.asSlice(&outside))
  let mut at = usize.ZERO
  while at < listed.length {
    if suppliedAtom(&listed[at]) {
      if !proofContains(supplied, &listed[at]) { return false }
      at = at + usize.ONE
      continue
    }
    let closed = Shared<Lifetime>.with<bool>(&listed[at], fn(region: &Lifetime) -> bool {
      return match &region.* {
        Lifetime.Static => true
        Lifetime.Local {declaration, ..} => DeclarationId.equals(&declaration, owner) || namedEnclosing(&declaration, owner)
        Lifetime.Parameter {declaration, ..} => DeclarationId.isPrefixOf(&declaration, owner)
          || (callable && DeclarationId.isPrefixOf(owner, &declaration))
          || (DeclarationId.isPrefixOf(owner, &declaration) && namesTarget(targets, &declaration))
        Lifetime.Invocation {..} => anonymous || callable || !invocationOutside
        _ => false
      }
    })
    if !closed { return false }
    at = at + usize.ONE
  }
  return true
}

test effect fn regionWorklistPropagatesThroughCycles() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run regionWorklistClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn regionWorklistClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut regions = List<RegionPoints>.make()
  let mut at = usize.ZERO
  while at < 3 {
    let mut required = List<u64>.make()
    let mut available = List<u64>.make()
    let mut seed: u64 = 0
    let mut permitted: u64 = 2
    if at == 2 { seed = 2 }
    if at == usize.ZERO { permitted = 0 }
    let mut propagated = List<u64>.make()
    run List<u64>.append(&mut required, seed)
    run List<u64>.append(&mut propagated, 0)
    run List<u64>.append(&mut available, permitted)
    // The set solver uses opaque region indices; domain authentication is tested by source Cases.
    run List<RegionPoints>.append(&mut regions, RegionPoints {
      region: run Shared<Lifetime>.make(Lifetime.Invocation {ordinal: at}), required: move required, incoming: move propagated,
      available: move available})
    at = at + usize.ONE
  }
  let mut edges = List<RegionEdge>.make()
  run List<RegionEdge>.append(&mut edges, RegionEdge {shorter: 1, longer: 0})
  run List<RegionEdge>.append(&mut edges, RegionEdge {shorter: 2, longer: 1})
  run List<RegionEdge>.append(&mut edges, RegionEdge {shorter: 1, longer: 2})
  let impossible = run solveRegionRequirements(&mut regions, List<RegionEdge>.asSlice(&edges))
  run Testing.expect(!impossible, "a required point reaches an unavailable region through a transitive cycle")
  let solved = List<RegionPoints>.asSlice(&regions)
  let first = List<u64>.asSlice(&solved[usize.ZERO].required)
  let required = first[usize.ZERO]
  run Testing.expect(required == 2, "requirements propagate from shorter to longer even after its first queue visit")
  let mut entries = List<RegionPoints>.asMutSlice(&mut regions)
  let mut permitted = List<u64>.asMutSlice(&mut entries[usize.ZERO].available)
  permitted[usize.ZERO] = 2
  let possible = run solveRegionRequirements(&mut regions, List<RegionEdge>.asSlice(&edges))
  run Testing.expect(possible, "the same obligations are proved when all propagated points are available")

  // A's own seed was checked loan by loan: returning through A <-> B must not
  // check it against A's aggregate availability. A foreign seed still must fit.
  // Each solve mutates required/incoming, so the two controls start from fresh state.
  let mut foreign = usize.ZERO
  while foreign < 2 {
    let mut cycle = List<RegionPoints>.make()
    let mut region = usize.ZERO
    while region < 2 {
      let mut seed: u64 = 2
      let mut permitted: u64 = 0
      if region == usize.ONE {
        seed = 0
        if foreign == usize.ONE { seed = 4 }
        permitted = 2
      }
      let mut required = List<u64>.make()
      let mut incoming = List<u64>.make()
      let mut available = List<u64>.make()
      run List<u64>.append(&mut required, seed)
      run List<u64>.append(&mut incoming, 0)
      run List<u64>.append(&mut available, permitted)
      run List<RegionPoints>.append(&mut cycle, RegionPoints {
        region: run Shared<Lifetime>.make(Lifetime.Invocation {ordinal: region}),
        required: move required, incoming: move incoming, available: move available})
      region = region + usize.ONE
    }
    let mut relations = List<RegionEdge>.make()
    run List<RegionEdge>.append(&mut relations, RegionEdge {shorter: 0, longer: 1})
    run List<RegionEdge>.append(&mut relations, RegionEdge {shorter: 1, longer: 0})
    let proved = run solveRegionRequirements(&mut cycle, List<RegionEdge>.asSlice(&relations))
    if foreign == usize.ZERO {
      run Testing.expect(proved, "a region's own requirement cannot invalidate it by returning through a cycle")
    } else {
      run Testing.expect(!proved, "a foreign requirement still fails when the cycle reaches an unavailable point")
    }
    foreign = foreign + usize.ONE
  }
  return ()
}

// Small input fixtures for the production region kernel. These contain no eager walk,
// path reconstruction or alternate relation solver. Each mutation below changes the
// concrete CFG, owner occurrence, loan provenance or runtime event under assertion.
struct RegionTestFixture {
  control: SourceControlProjection
  events: SourceRuntimeEvents
  owners: List<SourceVisit.Owner>
  loans: List<Loan>
  activity: List<SourceTruth>
  localCount: usize
  supplied: List<Shared<Lifetime>>
  contested: List<Shared<Lifetime>>
  openContents: List<Shared<Lifetime>>
  retentionRelations: List<ImpliedGroup>
}

fn regionTestFixture(localCount: usize) -> RegionTestFixture {
  return RegionTestFixture {
    control: SourceControlProjection {entry: 1, points: List<Point>.make(), unresolved: false},
    events: SourceRuntimeEvents {events: List<Event>.make(), uncertain: List<bool>.make(), unresolved: false},
    owners: List<SourceVisit.Owner>.make(), loans: List<Loan>.make(), activity: List<SourceTruth>.make(), localCount: localCount,
    supplied: List<Shared<Lifetime>>.make(), contested: List<Shared<Lifetime>>.make(),
    openContents: List<Shared<Lifetime>>.make(), retentionRelations: List<ImpliedGroup>.make()}
}

fn regionTestSources<'proof>(fixture: &'proof RegionTestFixture) -> RegionSources<'proof> {
  return RegionSources<'proof> {loans: List<Loan>.asSlice(&fixture.loans),
    activity: List<SourceTruth>.asSlice(&fixture.activity),
    supplied: List<Shared<Lifetime>>.asSlice(&fixture.supplied), contested: List<Shared<Lifetime>>.asSlice(&fixture.contested),
    openContents: List<Shared<Lifetime>>.asSlice(&fixture.openContents), retentionRelations: List<ImpliedGroup>.asSlice(&fixture.retentionRelations)}
}

effect fn regionTestLoan(fixture: &mut RegionTestFixture, loan: Loan) -> () ! OutOfMemoryError ? &mut Allocator {
  run List<Loan>.append(&mut fixture.loans, move loan)
  run List<SourceTruth>.append(&mut fixture.activity, SourceTruth.True)
  return ()
}

effect fn regionTestPoint(fixture: &mut RegionTestFixture) -> usize ! OutOfMemoryError ? &mut Allocator {
  let point = List<Point>.length(&fixture.control.points)
  run List<Point>.append(&mut fixture.control.points, Point {next: List<usize>.make(), uses: usize.MAX,
    read: usize.MAX, written: usize.MAX, defines: usize.MAX, initializes: usize.MAX, event: usize.MAX, span: Location.make(0, 0)})
  return point
}

effect fn regionTestEdge(fixture: &mut RegionTestFixture, from: usize, to: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut points = List<Point>.asMutSlice(&mut fixture.control.points)
  run List<usize>.append(&mut points[from].next, to)
  return ()
}

effect fn regionTestInitialization(fixture: &mut RegionTestFixture, point: usize, root: usize) -> ()
! OutOfMemoryError ? &mut Allocator {
  let mut owners = List<SourceVisit.Owner>.make()
  let previous = List<SourceVisit.Owner>.asSlice(&fixture.owners)
  let mut at = usize.ZERO
  while at < previous.length {
    if previous[at].initialized.index != point { run List<SourceVisit.Owner>.append(&mut owners, SourceVisit.Owner {root: previous[at].root, scope: previous[at].scope, initialized: previous[at].initialized}) }
    at = at + usize.ONE
  }
  if root != usize.MAX {
    run List<SourceVisit.Owner>.append(&mut owners, SourceVisit.Owner {root: SourceVisitOwnerRoot.Local {local: LocalId {index: root}},
      scope: SourceVisit.ScopeId {index: 0}, initialized: SourceControl.PointId {index: point}})
  }
  fixture.owners = move owners
  return ()
}

fn regionTestInput<'input>(fixture: &'input RegionTestFixture, facts: &'input [Option<RegionLoanProjection>]) -> RegionInput<'input> {
  return RegionInput<'input> {control: &fixture.control, events: &fixture.events,
    owners: List<SourceVisit.Owner>.asSlice(&fixture.owners), localCount: fixture.localCount, loans: facts, unresolved: false}
}

// These cases have direct in-flight observations and no stored definitions. The wrapped
// holder case below instead supplies actual Flow occupancy and the shared liveness solver.
effect fn regionTestProjections(fixture: &RegionTestFixture) -> List<Option<RegionLoanProjection>>
! OutOfMemoryError ? &mut Allocator {
  let points = List<Point>.asSlice(&fixture.control.points)
  let loans = List<Loan>.asSlice(&fixture.loans)
  let mut result = List<Option<RegionLoanProjection>>.make()
  let mut flow = emptyIntervalFlow()
  let mut index = usize.ZERO
  while index < loans.length {
    let loan = &loans[index]
    let mut required = List<u64>.make()
    let mut zero = List<u64>.make()
    let mut word = usize.ZERO
    while word < (points.length + 63) / 64 {
      run List<u64>.append(&mut required, 0)
      run List<u64>.append(&mut zero, 0)
      word = word + usize.ONE
    }
    drop includeRegionPoint(&mut required, loan.created)
    let intervals = List<Interval>.asSlice(&loan.intervals)
    let mut at = usize.ZERO
    while at < intervals.length {
      if intervals[at].definition != usize.MAX || intervals[at].read != usize.MAX {
        CompilerBug.panic(b"direct interval fixture cannot invent a stored source pair")
      }
      run includeIntervalRequirements(points, intervals[at].from, intervals[at].to, &mut flow, &mut required)
      at = at + usize.ONE
    }
    let mut occupied = List<bool>.make()
    let mut ends = List<bool>.make()
    let mut flight = List<bool>.make()
    at = usize.ZERO
    while at < points.length {
      let mut flowing = false
      let mut ended = false
      let mut each = usize.ZERO
      while each < intervals.length {
        if intervals[each].from <= at && at <= intervals[each].to { flowing = true }
        if intervals[each].from <= intervals[each].to && intervals[each].to == at { ended = true }
        each = each + usize.ONE
      }
      run List<bool>.append(&mut occupied, u64.bitAnd(List<u64>.asSlice(&required)[wordOf(at)], maskOf(at)) != 0)
      run List<bool>.append(&mut ends, ended)
      run List<bool>.append(&mut flight, flowing)
      at = at + usize.ONE
    }
    let mut released = move zero
    if (loan.precision == LoanPrecision.Exact || loan.precision == LoanPrecision.Stored)
      && ownedPlace(loan, &loan.place) && loanReleasePolicy(loans, index) {
      released = run releasedInstancePoints(points, fixture.control.entry, loan.created, List<bool>.asSlice(&occupied), List<bool>.asSlice(&ends))
    }
    run List<Option<RegionLoanProjection>>.append(&mut result, Option<RegionLoanProjection>.some(RegionLoanProjection {
      geometry: run regionTestGeometry(&loan.place),
      occupancy: SourceLoanOccupancy {loan: index, width: 0, entering: List<u64>.make(), leaving: List<u64>.make(), inherited: List<u64>.make(), shadowed: List<u64>.make(), unresolved: false},
      needs: SourceLoanNeeds {required: move required, liveOut: List<u64>.make(), unresolved: false},
      carriers: AvailabilityProjection {carriers: List<AvailabilityCarrier>.make(), preserves: List<u64>.make(), flight: move flight, unresolved: false},
      released: move released}))
    index = index + usize.ONE
  }
  return move result
}

effect fn regionTestRelations(fixture: &RegionTestFixture, owner: &DeclarationId,
  obligations: &[SafetyObligation], finiteCrossings: bool) -> bool ! OutOfMemoryError ? &mut Allocator {
  let facts = run regionTestProjections(fixture)
  let input = regionTestInput(fixture, List<Option<RegionLoanProjection>>.asSlice(&facts))
  let premises = List<RegionBound>.make()
  let mut symbolic = List<SymbolicRegion>.make()
  return run projectedLocalRelationsProved(&input, &regionTestSources(fixture), owner, obligations,
    List<RegionBound>.asSlice(&premises), &mut symbolic, finiteCrossings)
}

test effect fn regionWrappedIntervalRequiresLiveHolderPoints() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run wrappedRegionClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn wrappedRegionClaims() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let owner = run capturedTestOwner(b"loop.silk", 0)
  let region = run Shared<Lifetime>.make(Lifetime.Local {declaration: DeclarationId.copy(&owner), ordinal: 0})
  let mut fixture = regionTestFixture(1)
  let mut rules = SourceProgram.make()
  let yes = run sourceBoolean(&mut rules, true)
  let mut runtime = SourceControlFlow.make()
  let mut at = usize.ZERO
  while at < 5 {
    drop run regionTestPoint(&mut fixture)
    drop run SourceControlFlow.point(&mut runtime, &mut rules)
    at = at + usize.ONE
  }
  run regionTestEdge(&mut fixture, 1, 2)
  run regionTestEdge(&mut fixture, 2, 3)
  run regionTestEdge(&mut fixture, 3, 4)
  run regionTestEdge(&mut fixture, 4, 2)
  run regionTestEdge(&mut fixture, 4, 0)
  let points = List<Point>.asSlice(&fixture.control.points)
  at = usize.ZERO
  while at < points.length {
    let next = List<usize>.asSlice(&points[at].next)
    let mut each = usize.ZERO
    while each < next.length {
      run SourceControlFlow.edge(&mut runtime, SourceControl.PointId {index: at}, SourceControl.PointId {index: next[each]}, yes)
      each = each + usize.ONE
    }
    at = at + usize.ONE
  }
  run SourceProgram.fact(&mut rules, SourceControlFlow.reachable(&runtime, SourceControl.PointId {index: 1}))
  let component = SourceControl.ComponentId {index: 0}
  let defined = run SourceControlFlow.define(&mut runtime, SourceControl.PointId {index: 4}, component, yes, SourceControlWrite.Strong)
  let read = run SourceControlFlow.read(&mut runtime, SourceControl.PointId {index: 2}, component)
  // The old value is also observed immediately before the strong rebinding. This
  // makes the interior holder liveness real rather than supplying expected live bits.
  let beforeRebind = run SourceControlFlow.read(&mut runtime, SourceControl.PointId {index: 4}, component)
  let control = run SourceControlFlow.emit(move runtime, &mut rules)
  let solved = run SourceProgram.solve(&rules)
  let mut occupancy = SourceLoanOccupancy {loan: 0, width: 1, entering: List<u64>.make(), leaving: List<u64>.make(), inherited: List<u64>.make(), shadowed: List<u64>.make(), unresolved: false}
  run List<u64>.append(&mut occupancy.inherited, 0)
  run List<u64>.append(&mut occupancy.shadowed, 0)
  let mut carriers = AvailabilityProjection {carriers: List<AvailabilityCarrier>.make(),
    preserves: List<u64>.make(), flight: List<bool>.make(), unresolved: false}
  run List<AvailabilityCarrier>.append(&mut carriers.carriers, AvailabilityCarrier {point: 4,
    selected: true, unpaired: true, sources: List<AvailabilitySource>.make()})
  let mut used = List<u64>.make()
  let mut bound = List<u64>.make()
  at = usize.ZERO
  while at < points.length {
    let point = SourceControl.PointId {index: at}
    let incoming = SourceSolution.truth(&solved, SourceControlReaching.enters(&control, point, defined)) == SourceTruth.True
    let outgoing = SourceSolution.truth(&solved, SourceControlReaching.leaves(&control, point, defined)) == SourceTruth.True
    let mut incomingMask: u64 = 0
    if incoming { incomingMask = maskOf(defined.index) }
    let mut outgoingMask: u64 = 0
    if outgoing { outgoingMask = maskOf(defined.index) }
    run List<u64>.append(&mut occupancy.entering, incomingMask)
    run List<u64>.append(&mut occupancy.leaving, outgoingMask)
    run List<u64>.append(&mut carriers.preserves, outgoingMask)
    run List<bool>.append(&mut carriers.flight, false)
    run List<u64>.append(&mut used, 0)
    let mut boundMask: u64 = 0
    if at == 4 || !outgoing { boundMask = maskOf(defined.index) }
    run List<u64>.append(&mut bound, boundMask)
    at = at + usize.ONE
  }
  let pairs = List<SourceControl.Pair>.asSlice(&control.pairs)
  at = usize.ZERO
  while at < pairs.length {
    if pairs[at].definition.index == defined.index
      && SourceSolution.truth(&solved, pairs[at].active) == SourceTruth.True {
      if pairs[at].read.index == read.index { sourceIncludeDefinition(&mut used, occupancy.width, 2, defined) }
      if pairs[at].read.index == beforeRebind.index { sourceIncludeDefinition(&mut used, occupancy.width, 4, defined) }
    }
    at = at + usize.ONE
  }
  let live = run solveLiveness(points, occupancy.width, List<u64>.asSlice(&used), List<u64>.asSlice(&bound))
  let mut requiredPoints = List<u64>.make()
  run List<u64>.append(&mut requiredPoints, maskOf(1))
  let mut flow = emptyIntervalFlow()
  run includeIntervalRequirements(points, 4, 2, &mut flow, &mut requiredPoints)
  includeLiveRequirements(points.length, 1, &occupancy, List<u64>.asSlice(&live), &mut requiredPoints)
  let mut loan = run symbolicTestLoan(&region, &region, true)
  loan.parent = Option<Shared<Lifetime>>.none()
  loan.crossed = false
  run regionTestLoan(&mut fixture, move loan)
  let mut facts = List<Option<RegionLoanProjection>>.make()
  let mut released = List<u64>.make()
  run List<u64>.append(&mut released, 0)
  run List<Option<RegionLoanProjection>>.append(&mut facts, Option<RegionLoanProjection>.some(RegionLoanProjection {
    geometry: run regionTestGeometry(&List<Loan>.asSlice(&fixture.loans)[0].place),
    occupancy: move occupancy, needs: SourceLoanNeeds {required: move requiredPoints, liveOut: move live, unresolved: false},
    carriers: move carriers,
    released: move released}))
  let input = regionTestInput(&fixture, List<Option<RegionLoanProjection>>.asSlice(&facts))
  let mut regions = List<RegionPoints>.make()
  let premises = List<RegionBound>.make()
  let mut symbolic = List<SymbolicRegion>.make()
  let mut storage = emptyRegionAvailability()
  let found = run projectedRegionPoints(&input, &regionTestSources(&fixture), &owner, &region,
    &mut regions, List<RegionBound>.asSlice(&premises), &mut symbolic, &mut flow, &mut storage)
  run Testing.expect(found != usize.MAX, "the exact loop holder has available storage")
  let entries = List<RegionPoints>.asSlice(&regions)
  let required = List<u64>.asSlice(&entries[found].required)
  run Testing.expect(u64.bitAnd(required[0], 12) == 12,
    "wrapped intervals retain their back-edge holder points through actual paired Flow occupancy and liveness")
  return ()
}

test effect fn symbolicRegionRootsRequireEveryParent() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run symbolicRootClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn symbolicTestLoan(region: &Shared<Lifetime>, parent: &Shared<Lifetime>, local: bool) -> Loan
! OutOfMemoryError ? &mut Allocator {
  let mut regions = List<Shared<Lifetime>>.make()
  run List<Shared<Lifetime>>.append(&mut regions, Shared<Lifetime>.clone(region))
  return Loan {place: Place {root: 0, steps: List<Step>.make()}, exclusive: false,
    origin: Location.make(0, 1), intervals: List<Interval>.make(), precision: LoanPrecision.Exact,
    regions: move regions, local: local, borrowed: Option<Shared<Lifetime>>.some(Shared<Lifetime>.clone(region)),
    parent: Option<Shared<Lifetime>>.some(Shared<Lifetime>.clone(parent)), crossed: true, created: 1, escapes: false, binder: usize.MAX, block: usize.MAX, until: usize.MAX,
    referent: Option<Shared<Type>>.none(), bound: false}
}

effect fn symbolicRootClaims() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let module = run ModuleId.make(b"test", b"r3", b"symbolic.silk")
  let mut owners = List<OwnerStep>.make()
  run List<OwnerStep>.append(&mut owners, OwnerStep {kind: OwnerKind.Function,
    name: Option<Bytes>.some(run Bytes.copy(b"caller")), occurrence: 0})
  let owner = run DeclarationId.fromParts(move module, move owners)
  let first = run Shared<Lifetime>.make(Lifetime.Local {declaration: DeclarationId.copy(&owner), ordinal: 0})
  let second = run Shared<Lifetime>.make(Lifetime.Local {declaration: DeclarationId.copy(&owner), ordinal: 1})
  let a = run Shared<Lifetime>.make(Lifetime.Parameter {declaration: DeclarationId.copy(&owner), ordinal: 0})
  let b = run Shared<Lifetime>.make(Lifetime.Parameter {declaration: DeclarationId.copy(&owner), ordinal: 1})
  let mut fixture = regionTestFixture(1)
  let premises = List<RegionBound>.make()
  run regionTestLoan(&mut fixture, run symbolicTestLoan(&first, &second, false))
  run regionTestLoan(&mut fixture, run symbolicTestLoan(&second, &first, false))
  let mut cache = List<SymbolicRegion>.make()
  run Testing.expect(!run symbolicRegionProved(&regionTestSources(&fixture), &owner, &first, &a, List<RegionBound>.asSlice(&premises), &mut cache),
    "an ungrounded reborrow cycle cannot establish a caller lifetime")
  run regionTestLoan(&mut fixture, run symbolicTestLoan(&second, &a, false))
  cache = List<SymbolicRegion>.make()
  run Testing.expect(run symbolicRegionProved(&regionTestSources(&fixture), &owner, &first, &a, List<RegionBound>.asSlice(&premises), &mut cache),
    "a reborrow cycle is proved when every branch stays grounded in the matching universal parent")
  // Reservation may name a root that never acquired a loan. Its stable ID is not proof.
  let mut activity = List<SourceTruth>.make()
  run List<SourceTruth>.append(&mut activity, SourceTruth.True)
  run List<SourceTruth>.append(&mut activity, SourceTruth.True)
  run List<SourceTruth>.append(&mut activity, SourceTruth.False)
  if true {
    let mut reserved = regionTestSources(&fixture)
    reserved.activity = List<SourceTruth>.asSlice(&activity)
    cache = List<SymbolicRegion>.make()
    run Testing.expect(!run symbolicRegionProved(&reserved, &owner, &first, &a, List<RegionBound>.asSlice(&premises), &mut cache),
      "an unreachable reserved acquisition cannot ground an otherwise cyclic parent graph")
    let mut roots = List<SymbolicRoot>.make()
    drop run symbolicRootIndex(&mut roots, &first)
    run Testing.expect(!run finiteParentRoots(&reserved, &owner, &mut roots),
      "the finite parent graph also excludes an unreachable grounding acquisition")
  }
  let mut states = List<SourceTruth>.asMutSlice(&mut activity)
  states[2] = SourceTruth.Undefined
  if true {
    let mut reserved = regionTestSources(&fixture)
    reserved.activity = List<SourceTruth>.asSlice(&activity)
    cache = List<SymbolicRegion>.make()
    run Testing.expect(!run symbolicRegionProved(&reserved, &owner, &first, &a, List<RegionBound>.asSlice(&premises), &mut cache),
      "unresolved acquisition activity supplies no universal parent proof")
  }
  let mut alternatives = List<Loan>.asMutSlice(&mut fixture.loans)
  alternatives[2].precision = LoanPrecision.Alternatives
  cache = List<SymbolicRegion>.make()
  run Testing.expect(run symbolicRegionProved(&regionTestSources(&fixture), &owner, &first, &a, List<RegionBound>.asSlice(&premises), &mut cache),
    "a complete possible-source union proves a bound only through all of its roots")
  let mut unresolved = List<Loan>.asMutSlice(&mut fixture.loans)
  unresolved[2].precision = LoanPrecision.Unknown
  cache = List<SymbolicRegion>.make()
  run Testing.expect(!run symbolicRegionProved(&regionTestSources(&fixture), &owner, &first, &a, List<RegionBound>.asSlice(&premises), &mut cache),
    "unknown retention cannot acquire a proof from another complete branch")
  let mut exact = List<Loan>.asMutSlice(&mut fixture.loans)
  exact[2].precision = LoanPrecision.Exact
  cache = List<SymbolicRegion>.make()
  run Testing.expect(!run symbolicRegionProved(&regionTestSources(&fixture), &owner, &first, &b, List<RegionBound>.asSlice(&premises), &mut cache),
    "a cached proof for one universal does not prove another universal")
  run regionTestLoan(&mut fixture, run symbolicTestLoan(&first, &b, false))
  cache = List<SymbolicRegion>.make()
  run Testing.expect(!run symbolicRegionProved(&regionTestSources(&fixture), &owner, &first, &a, List<RegionBound>.asSlice(&premises), &mut cache),
    "every loan sharing an inference region must have a sufficient parent")
  let mut activeRoot = List<SourceTruth>.asMutSlice(&mut activity)
  activeRoot[2] = SourceTruth.True
  run List<SourceTruth>.append(&mut activity, SourceTruth.False)
  if true {
    let mut reserved = regionTestSources(&fixture)
    reserved.activity = List<SourceTruth>.asSlice(&activity)
    cache = List<SymbolicRegion>.make()
    run Testing.expect(run symbolicRegionProved(&reserved, &owner, &first, &a, List<RegionBound>.asSlice(&premises), &mut cache),
      "an unreachable contradictory sibling is excluded without renumbering the active root")
    let chain = run unretainedChain(&reserved, &owner, 0)
    run Testing.expect(!chain.unresolved && !listsIndex(List<usize>.asSlice(&chain.loans), 3)
      && !proofContains(List<Shared<Lifetime>>.asSlice(&chain.regions), &b),
      "an unreachable sibling cannot add its foreign parent to a dropped loan's contested provenance")
  }
  let mut possibleSibling = List<SourceTruth>.asMutSlice(&mut activity)
  possibleSibling[3] = SourceTruth.Undefined
  if true {
    let mut reserved = regionTestSources(&fixture)
    reserved.activity = List<SourceTruth>.asSlice(&activity)
    cache = List<SymbolicRegion>.make()
    run Testing.expect(!run symbolicRegionProved(&reserved, &owner, &first, &a, List<RegionBound>.asSlice(&premises), &mut cache),
      "a possible contradictory sibling is an unresolved obligation, not an absent source")
    let chain = run unretainedChain(&reserved, &owner, 0)
    run Testing.expect(chain.unresolved,
      "a dropped-source chain retains the unresolved activity of a possible ancestor")
  }
  let mut changed = List<Loan>.asMutSlice(&mut fixture.loans)
  changed[3].parent = Option<Shared<Lifetime>>.some(Shared<Lifetime>.clone(&a))
  cache = List<SymbolicRegion>.make()
  run Testing.expect(run symbolicRegionProved(&regionTestSources(&fixture), &owner, &first, &a, List<RegionBound>.asSlice(&premises), &mut cache),
    "a shared region is proved when every one of its parents reaches the requested universal")
  let mut owned = List<Loan>.asMutSlice(&mut fixture.loans)
  owned[3].local = true
  cache = List<SymbolicRegion>.make()
  run Testing.expect(!run symbolicRegionProved(&regionTestSources(&fixture), &owner, &first, &a, List<RegionBound>.asSlice(&premises), &mut cache),
    "owned storage cannot acquire a universal validity bound from a named parent")
  let mut restored = List<Loan>.asMutSlice(&mut fixture.loans)
  restored[3].local = false
  let third = run Shared<Lifetime>.make(Lifetime.Local {declaration: DeclarationId.copy(&owner), ordinal: 2})
  run regionTestLoan(&mut fixture, run symbolicTestLoan(&first, &third, false))
  run regionTestLoan(&mut fixture, run symbolicTestLoan(&third, &third, false))
  cache = List<SymbolicRegion>.make()
  run Testing.expect(!run symbolicRegionProved(&regionTestSources(&fixture), &owner, &first, &a, List<RegionBound>.asSlice(&premises), &mut cache),
    "a grounded branch cannot justify another branch that ends in an ungrounded cycle")
  return ()
}

// One local expression supplies the existing non-call retention judgment. The callers
// provide actual loan positions and qualities; sourceResultSnapshot emits every proof rule.
effect fn sourceTestSnapshot(owner: &DeclarationId, loans: &[Loan], inputs: &[SourceResultInput],
  named: &[Shared<Lifetime>], edges: &[RetentionEdge], rules: &mut SourceProgram)
  -> SourceResultSnapshot ! OutOfMemoryError ? &mut Allocator {
  let mut nodes = List<Node>.make()
  let ty = run Shared<Type>.make(Type.Unit)
  run List<Node>.append(&mut nodes, Node {origin: Origin {node: 0, location: Location.make(0, 1)},
    kind: NodeKind.Expression {ty: move ty, form: Expression.Local {local: LocalId {index: 0}}}})
  let supplied = List<Shared<Lifetime>>.make()
  return run sourceResultSnapshot(List<Node>.asSlice(&nodes), owner, List<Shared<Lifetime>>.asSlice(&supplied),
    loans, inputs, named, edges, NodeId {index: 0}, true, false, false, &mut rules.*)
}

test effect fn retainedParentClosureUsesActualBorrowProvenance() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run retainedParentClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn retainedParentClaims() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let module = run ModuleId.make(b"test", b"r3", b"retained-parent.silk")
  let mut owners = List<OwnerStep>.make()
  run List<OwnerStep>.append(&mut owners, OwnerStep {kind: OwnerKind.Function,
    name: Option<Bytes>.some(run Bytes.copy(b"caller")), occurrence: 0})
  let owner = run DeclarationId.fromParts(move module, move owners)
  let a = run Shared<Lifetime>.make(Lifetime.Local {declaration: DeclarationId.copy(&owner), ordinal: 0})
  let b = run Shared<Lifetime>.make(Lifetime.Local {declaration: DeclarationId.copy(&owner), ordinal: 1})
  let c = run Shared<Lifetime>.make(Lifetime.Local {declaration: DeclarationId.copy(&owner), ordinal: 2})
  let universal = run Shared<Lifetime>.make(Lifetime.Parameter {declaration: DeclarationId.copy(&owner), ordinal: 0})
  let mut loans = List<Loan>.make()
  run List<Loan>.append(&mut loans, run symbolicTestLoan(&a, &universal, false))
  let mut shelf = run symbolicTestLoan(&b, &universal, true)
  shelf.parent = Option<Shared<Lifetime>>.none()
  run List<Shared<Lifetime>>.append(&mut shelf.regions, Shared<Lifetime>.clone(&a))
  run List<Loan>.append(&mut loans, move shelf)
  run List<Loan>.append(&mut loans, run symbolicTestLoan(&c, &a, false))
  run List<Loan>.append(&mut loans, run symbolicTestLoan(&a, &universal, false))
  let mut rules = SourceProgram.make()
  let yes = run sourceBoolean(&mut rules, true)
  let no = run sourceBoolean(&mut rules, false)
  let mut inputs = List<SourceResultInput>.make()
  let mut at = usize.ZERO
  while at < 4 {
    run List<SourceResultInput>.append(&mut inputs, SourceResultInput {loan: at, operand: at,
      quality: SourceQuality {present: yes, stored: no, alternatives: no}})
    at = at + usize.ONE
  }
  let edges = List<RetentionEdge>.make()
  let mut result = List<Shared<Lifetime>>.make()
  run List<Shared<Lifetime>>.append(&mut result, Shared<Lifetime>.clone(&b))
  let owned = run sourceTestSnapshot(&owner, List<Loan>.asSlice(&loans), List<SourceResultInput>.asSlice(&inputs),
    List<Shared<Lifetime>>.asSlice(&result), List<RetentionEdge>.asSlice(&edges), &mut rules)
  result = List<Shared<Lifetime>>.make()
  run List<Shared<Lifetime>>.append(&mut result, Shared<Lifetime>.clone(&c))
  let child = run sourceTestSnapshot(&owner, List<Loan>.asSlice(&loans), List<SourceResultInput>.asSlice(&inputs),
    List<Shared<Lifetime>>.asSlice(&result), List<RetentionEdge>.asSlice(&edges), &mut rules)
  let solved = run SourceProgram.solve(&rules)
  let included = List<SourceAtom>.asSlice(&owned.parents)
  let ancestors = List<SourceAtom>.asSlice(&child.parents)
  run Testing.expect(SourceSolution.truth(&solved, included[0]) == SourceTruth.False
    && SourceSolution.truth(&solved, included[1]) == SourceTruth.True
    && SourceSolution.truth(&solved, included[2]) == SourceTruth.False
    && SourceSolution.truth(&solved, included[3]) == SourceTruth.False,
    "an owned outer borrow's retained inner atom is not an actual parent edge (Shelf guard)")
  run Testing.expect(SourceSolution.truth(&solved, ancestors[0]) == SourceTruth.True
    && SourceSolution.truth(&solved, ancestors[1]) == SourceTruth.False
    && SourceSolution.truth(&solved, ancestors[2]) == SourceTruth.True
    && SourceSolution.truth(&solved, ancestors[3]) == SourceTruth.True,
    "every carried source sharing the actual parent atom remains in the possible-source union")
  return ()
}

test effect fn capturedFiniteSourcesAuthenticateExactDirectOwners() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run capturedFiniteOwnerClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn capturedTestOwner(path: &[u8], depth: usize) -> DeclarationId
! InvalidModulePath | OutOfMemoryError ? &mut Allocator {
  let module = run ModuleId.make(b"test", b"r3", path)
  let mut owners = List<OwnerStep>.make()
  run List<OwnerStep>.append(&mut owners, OwnerStep {kind: OwnerKind.Function,
    name: Option<Bytes>.some(run Bytes.copy(b"sameName")), occurrence: usize.ZERO})
  let mut at = usize.ZERO
  while at < depth {
    run List<OwnerStep>.append(&mut owners, OwnerStep {kind: OwnerKind.Anonymous,
      name: Option<Bytes>.none(), occurrence: usize.ZERO})
    at = at + usize.ONE
  }
  return run DeclarationId.fromParts(move module, move owners)
}

effect fn capturedFiniteOwnerClaims() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let owner = run capturedTestOwner(b"capture.silk", usize.ZERO)
  let child = run capturedTestOwner(b"capture.silk", usize.ONE)
  let grandchild = run capturedTestOwner(b"capture.silk", 2)
  let foreign = run capturedTestOwner(b"other.silk", usize.ZERO)
  let local = run Shared<Lifetime>.make(Lifetime.Local {declaration: DeclarationId.copy(&owner), ordinal: 0})
  let unrelated = run Shared<Lifetime>.make(Lifetime.Local {declaration: move foreign, ordinal: 0})
  let nested = run Shared<Lifetime>.make(Lifetime.Local {declaration: DeclarationId.copy(&child), ordinal: 0})
  run Testing.expect(capturedFiniteSource(&local, &child),
    "the direct enclosing named function authenticates its captured local")
  run Testing.expect(!capturedFiniteSource(&unrelated, &child),
    "a same-spelled function and local ordinal in another module are not the captured source")
  run Testing.expect(!capturedFiniteSource(&local, &grandchild) && !capturedFiniteSource(&nested, &grandchild),
    "unsupported anonymous-in-anonymous nesting cannot inherit a finite-source witness")
  run Testing.expect(regionDomain(&local, &child, List<Shared<Lifetime>>.asSlice(&List<Shared<Lifetime>>.make())) == RegionDomain.Unknown,
    "finite capture coverage is directional and never a universal lifetime classification")
  return ()
}

test effect fn suppliedRegionsAreUniversalOnlyWhenTheBodysOwn() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run suppliedRegionClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn suppliedRegionClaims() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let owner = run capturedTestOwner(b"supplied.silk", usize.ZERO)
  let own = run Shared<Lifetime>.make(Lifetime.Supplied {ordinal: 0})
  let other = run Shared<Lifetime>.make(Lifetime.Supplied {ordinal: 1})
  let declared = run Shared<Lifetime>.make(Lifetime.Parameter {declaration: DeclarationId.copy(&owner), ordinal: 0})
  let alsoDeclared = run Shared<Lifetime>.make(Lifetime.Parameter {declaration: DeclarationId.copy(&owner), ordinal: 1})
  let forever = run Shared<Lifetime>.make(Lifetime.Static)
  let mut supplied = List<Shared<Lifetime>>.make()
  run List<Shared<Lifetime>>.append(&mut supplied, Shared<Lifetime>.clone(&own))
  let listed = List<Shared<Lifetime>>.asSlice(&supplied)
  let none = List<Shared<Lifetime>>.make()
  run Testing.expect(regionDomain(&own, &owner, listed) == RegionDomain.Universal
    && regionDomain(&other, &owner, listed) == RegionDomain.Unknown
    && regionDomain(&own, &owner, List<Shared<Lifetime>>.asSlice(&none)) == RegionDomain.Unknown,
    "only a Supplied atom of the body's own application is universal; any other numbering stays unknown")
  run Testing.expect(declaredRelationProved(&declared, &alsoDeclared, usize.ONE)
    && !declaredRelationProved(&own, &declared, usize.ONE) && !declaredRelationProved(&declared, &own, usize.ONE)
    && !declaredRelationProved(&declared, &alsoDeclared, 2),
    "the declared-region check proves neither a Supplied side nor a meet constituent")
  let mut both = List<Shared<Lifetime>>.make()
  run List<Shared<Lifetime>>.append(&mut both, Shared<Lifetime>.clone(&own))
  run List<Shared<Lifetime>>.append(&mut both, Shared<Lifetime>.clone(&other))
  let bothListed = List<Shared<Lifetime>>.asSlice(&both)
  let mut premises = List<RegionBound>.make()
  run List<RegionBound>.append(&mut premises, RegionBound {longer: Shared<Lifetime>.clone(&declared), shorter: Shared<Lifetime>.clone(&alsoDeclared)})
  let bounds = List<RegionBound>.asSlice(&premises)
  let itself = run universalRegionProved(&owner, bothListed, &own, &own, bounds)
  let fromStatic = run universalRegionProved(&owner, bothListed, &forever, &own, bounds)
  let toOther = run universalRegionProved(&owner, bothListed, &own, &other, bounds)
  let toStatic = run universalRegionProved(&owner, bothListed, &own, &forever, bounds)
  let toDeclared = run universalRegionProved(&owner, bothListed, &own, &declared, bounds)
  run Testing.expect(itself && fromStatic && !toOther && !toStatic && !toDeclared,
    "a Supplied region outlives only itself: no premise relates it to another Supplied, 'static or a declared region")
  return ()
}

test effect fn requiredRetentionKeepsNamespacesAndOuterLoansDistinct() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run requiredRetentionClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn requiredRetentionClaims() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let module = run ModuleId.make(b"test", b"r3", b"requirements.silk")
  let owner = run DeclarationId.fromParts(move module, List<OwnerStep>.make())
  let otherModule = run ModuleId.make(b"test", b"r3", b"other-requirements.silk")
  let other = run DeclarationId.fromParts(move otherModule, List<OwnerStep>.make())
  let source = run Shared<Lifetime>.make(Lifetime.Local {declaration: DeclarationId.copy(&owner), ordinal: 0})
  let extent = run Shared<Lifetime>.make(Lifetime.Local {declaration: DeclarationId.copy(&owner), ordinal: 1})
  let foreign = run Shared<Lifetime>.make(Lifetime.Local {declaration: DeclarationId.copy(&other), ordinal: 0})
  let universal = run Shared<Lifetime>.make(Lifetime.Parameter {declaration: DeclarationId.copy(&owner), ordinal: 0})
  run Testing.expect(retentionOrdinal(&foreign, &owner) == usize.MAX, "a matching ordinal in a different owner is not a local requirement")
  run Testing.expect(retentionOrdinal(&universal, &owner) == usize.MAX, "a parameter is not a local requirement")
  let mut obligations = List<SafetyObligation>.make()
  run List<SafetyObligation>.append(&mut obligations, retentionTestRelation(&source, &extent, false))
  run List<SafetyObligation>.append(&mut obligations, retentionTestRelation(&foreign, &extent, false))
  run List<SafetyObligation>.append(&mut obligations, retentionTestRelation(&source, &universal, false))
  run List<SafetyObligation>.append(&mut obligations, retentionTestRelation(&source, &extent, true))
  let admitted = run localRetentionEdges(&owner, List<SafetyObligation>.asSlice(&obligations))
  run Testing.expect(List<RetentionEdge>.length(&admitted) == 1,
    "foreign, outward and unresolved inferred-static relations cannot supply finite retention edges")
  let mut required = List<usize>.make()
  run List<usize>.append(&mut required, 0)
  let mut outer = run symbolicTestLoan(&extent, &universal, false)
  run List<Shared<Lifetime>>.append(&mut outer.regions, Shared<Lifetime>.clone(&source))
  run Testing.expect(!requiredLoan(&outer, &owner, List<usize>.asSlice(&required)),
    "an inner retained atom does not turn its outer storage loan into the required source")
  let actual = run symbolicTestLoan(&source, &universal, false)
  run Testing.expect(requiredLoan(&actual, &owner, List<usize>.asSlice(&required)), "the actual outer source remains required")
  let mut unknown = run symbolicTestLoan(&source, &universal, false)
  unknown.regions = List<Shared<Lifetime>>.make()
  run Testing.expect(!requiredLoan(&unknown, &owner, List<usize>.asSlice(&required)), "an empty region mapping supplies no retention evidence")
  let mut loans = List<Loan>.make()
  run List<Loan>.append(&mut loans, move actual)
  let mut rules = SourceProgram.make()
  let yes = run sourceBoolean(&mut rules, true)
  let no = run sourceBoolean(&mut rules, false)
  let inputs: [SourceResultInput; 1] = [SourceResultInput {loan: 0, operand: 0,
    quality: SourceQuality {present: yes, stored: no, alternatives: no}}]
  let mut named = List<Shared<Lifetime>>.make()
  run List<Shared<Lifetime>>.append(&mut named, Shared<Lifetime>.clone(&extent))
  let mut edges = List<RetentionEdge>.make()
  run List<RetentionEdge>.append(&mut edges, RetentionEdge {source: 0, extent: 1})
  run List<RetentionEdge>.append(&mut edges, RetentionEdge {source: 1, extent: 0})
  let snapshot = run sourceTestSnapshot(&owner, List<Loan>.asSlice(&loans), &inputs,
    List<Shared<Lifetime>>.asSlice(&named), List<RetentionEdge>.asSlice(&edges), &mut rules)
  let solved = run SourceProgram.solve(&rules)
  run Testing.expect(SourceSolution.truth(&solved, List<SourceAtom>.asSlice(&snapshot.required)[0]) == SourceTruth.True,
    "a local validity cycle retains the source without proving availability")
  return ()
}

fn retentionTestRelation(source: &Shared<Lifetime>, extent: &Shared<Lifetime>, unresolved: bool) -> SafetyObligation {
  let mut inferred = Option<Shared<Lifetime>>.none()
  if unresolved { inferred = Option<Shared<Lifetime>>.some(Shared<Lifetime>.clone(source)) }
  return SafetyObligation.RegionRelation {origin: Origin {node: 0, location: Location.make(0, 1)},
    offered: Shared<Lifetime>.clone(source), wanted: Shared<Lifetime>.clone(extent), inferredStatic: move inferred}
}

test effect fn finiteContentsAuthenticateSubjectAndCaptureSite() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run finiteContentsClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn finiteContentsClaims() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let owner = run capturedTestOwner(b"contents.silk", 0)
  let child = run capturedTestOwner(b"contents.silk", 1)
  let nested = run capturedTestOwner(b"contents.silk", 2)
  let foreign = run capturedTestOwner(b"other-contents.silk", 0)
  let parameter = run Types.intern(Type.Parameter {declaration: DeclarationId.copy(&owner), ordinal: 0})
  let unrelated = run Types.intern(Type.Parameter {declaration: move foreign, ordinal: 0})
  let anonymous = run Types.intern(Type.Parameter {declaration: DeclarationId.copy(&child), ordinal: 0})
  let concrete = run Types.intern(Type.Unit)
  let local = run Shared<Lifetime>.make(Lifetime.Local {declaration: DeclarationId.copy(&owner), ordinal: 3})
  let captured = run Shared<Lifetime>.make(Lifetime.Local {declaration: DeclarationId.copy(&child), ordinal: 3})
  let nestedLocal = run Shared<Lifetime>.make(Lifetime.Local {declaration: DeclarationId.copy(&nested), ordinal: 3})
  let fixed = run Shared<Lifetime>.make(Lifetime.Static)
  let origin = Origin {node: 3, location: Location.make(0, 1)}
  let otherSite = Origin {node: 4, location: Location.make(0, 1)}
  run Testing.expect(finiteCaptureContents(&owner, origin, &parameter, &local), "the invocation's parameter covers its finite capture use")
  run Testing.expect(finiteCaptureContents(&child, origin, &parameter, &captured), "a named enclosing function's type parameter remains available in the anonymous invocation")
  run Testing.expect(!finiteCaptureContents(&owner, origin, &unrelated, &local), "a same-ordinal foreign type parameter supplies no evidence")
  run Testing.expect(!finiteCaptureContents(&owner, otherSite, &parameter, &local), "a different capture origin is not this finite obligation")
  run Testing.expect(!finiteCaptureContents(&owner, origin, &parameter, &captured), "the target must belong to the checked body")
  run Testing.expect(!finiteCaptureContents(&owner, origin, &parameter, &fixed), "finite availability never proves T:static")
  run Testing.expect(!finiteCaptureContents(&owner, origin, &concrete, &local), "arbitrary concrete contents require their separate loan proof")
  run Testing.expect(!finiteCaptureContents(&nested, origin, &anonymous, &nestedLocal), "an enclosing anonymous owner's parameters do not gain a nested-body rule")
  return ()
}

test effect fn descriptorReleaseRequiresCompleteExactSources() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run descriptorSourceClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn descriptorSourceClaims() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let owner = run capturedTestOwner(b"descriptor.silk", 0)
  let other = run capturedTestOwner(b"other-descriptor.silk", 0)
  let inner = run Shared<Lifetime>.make(Lifetime.Local {declaration: DeclarationId.copy(&owner), ordinal: 0})
  let outer = run Shared<Lifetime>.make(Lifetime.Local {declaration: DeclarationId.copy(&owner), ordinal: 1})
  let foreign = run Shared<Lifetime>.make(Lifetime.Local {declaration: move other, ordinal: 1})
  let mut descriptor = run symbolicTestLoan(&outer, &inner, true)
  descriptor.parent = Option<Shared<Lifetime>>.none()
  let mut named = List<Shared<Lifetime>>.make()
  run List<Shared<Lifetime>>.append(&mut named, Shared<Lifetime>.clone(&inner))
  let mut rules = SourceProgram.make()
  let yes = run sourceBoolean(&mut rules, true)
  let no = run sourceBoolean(&mut rules, false)
  let exact = SourceQuality {present: yes, stored: no, alternatives: no}
  let unknown = SourceQuality {present: yes, stored: yes, alternatives: yes}
  let alternatives = SourceQuality {present: yes, stored: no, alternatives: yes}
  let names = List<Shared<Lifetime>>.asSlice(&named)
  let releasable = run sourceUnneededOwnedLoan(&descriptor, &owner, names, exact, no, no, &mut rules)
  let ancestor = run sourceUnneededOwnedLoan(&descriptor, &owner, names, exact, yes, no, &mut rules)
  let required = run sourceUnneededOwnedLoan(&descriptor, &owner, names, exact, no, yes, &mut rules)
  let uncertain = run sourceUnneededOwnedLoan(&descriptor, &owner, names, unknown, no, no, &mut rules)
  let alternative = run sourceUnneededOwnedLoan(&descriptor, &owner, names, alternatives, no, no, &mut rules)
  let mut unrelated = run symbolicTestLoan(&foreign, &inner, true)
  unrelated.parent = Option<Shared<Lifetime>>.none()
  let foreignSource = run sourceUnneededOwnedLoan(&unrelated, &owner, names, exact, no, no, &mut rules)
  let mut loans = List<Loan>.make()
  run List<Loan>.append(&mut loans, run symbolicTestLoan(&inner, &inner, true))
  // Two actual component positions share one source and naming operand. This reaches
  // the real multiple-source completeness gate without inventing a second loan.
  let exactInputs: [SourceResultInput; 2] = [SourceResultInput {loan: 0, operand: 0, quality: exact},
    SourceResultInput {loan: 0, operand: 0, quality: exact}]
  let unknownInputs: [SourceResultInput; 2] = [SourceResultInput {loan: 0, operand: 0, quality: unknown},
    SourceResultInput {loan: 0, operand: 0, quality: exact}]
  let edges = List<RetentionEdge>.make()
  let complete = run sourceTestSnapshot(&owner, List<Loan>.asSlice(&loans), &exactInputs, names,
    List<RetentionEdge>.asSlice(&edges), &mut rules)
  let incomplete = run sourceTestSnapshot(&owner, List<Loan>.asSlice(&loans), &unknownInputs, names,
    List<RetentionEdge>.asSlice(&edges), &mut rules)
  if true {
    let mut mutated = List<Loan>.asMutSlice(&mut loans)
    mutated[0].borrowed = Option<Shared<Lifetime>>.some(Shared<Lifetime>.clone(&outer))
  }
  let unrelatedSource = run sourceTestSnapshot(&owner, List<Loan>.asSlice(&loans), &exactInputs, names,
    List<RetentionEdge>.asSlice(&edges), &mut rules)
  let solved = run SourceProgram.solve(&rules)
  run Testing.expect(SourceSolution.truth(&solved, releasable) == SourceTruth.True,
    "an exact unmatched descriptor is eligible only after a separate complete-source proof")
  run Testing.expect(SourceSolution.truth(&solved, ancestor) == SourceTruth.False,
    "an actual ancestor of a retained source cannot be released")
  run Testing.expect(SourceSolution.truth(&solved, required) == SourceTruth.False,
    "a source required by an outer-to-inner goal remains retained")
  run Testing.expect(SourceSolution.truth(&solved, uncertain) == SourceTruth.False, "prior Unknown is never repaired by descriptor release")
  run Testing.expect(SourceSolution.truth(&solved, alternative) == SourceTruth.False, "prior Alternatives remains a possible source")
  run Testing.expect(SourceSolution.truth(&solved, foreignSource) == SourceTruth.False, "a foreign owner with the same ordinal supplies no local descriptor proof")
  run Testing.expect(SourceSolution.truth(&solved, complete.complete) == SourceTruth.True, "the exact actual source covers this local result")
  run Testing.expect(SourceSolution.truth(&solved, incomplete.complete) == SourceTruth.False, "an unknown source cannot make result provenance complete")
  run Testing.expect(SourceSolution.truth(&solved, unrelatedSource.complete) == SourceTruth.False, "a retained inner atom alone does not identify the actual source loan")
  return ()
}

test effect fn finiteParentsRequireGroundingAndLiveStorage() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run finiteParentClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn finiteParentClaims() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let owner = run capturedTestOwner(b"finite-parents.silk", 0)
  let foreignOwner = run capturedTestOwner(b"foreign-parents.silk", 0)
  let first = run Shared<Lifetime>.make(Lifetime.Local {declaration: DeclarationId.copy(&owner), ordinal: 0})
  let second = run Shared<Lifetime>.make(Lifetime.Local {declaration: DeclarationId.copy(&owner), ordinal: 1})
  let third = run Shared<Lifetime>.make(Lifetime.Local {declaration: DeclarationId.copy(&owner), ordinal: 2})
  let foreign = run Shared<Lifetime>.make(Lifetime.Local {declaration: move foreignOwner, ordinal: 0})
  let universal = run Shared<Lifetime>.make(Lifetime.Parameter {declaration: DeclarationId.copy(&owner), ordinal: 0})
  let mut fixture = regionTestFixture(2)
  let mut at = usize.ZERO
  while at < 5 { drop run regionTestPoint(&mut fixture) at = at + usize.ONE }
  run regionTestEdge(&mut fixture, 1, 2)
  run regionTestEdge(&mut fixture, 2, 3)
  run regionTestEdge(&mut fixture, 3, 4)
  run regionTestEdge(&mut fixture, 4, 0)
  let mut root = run symbolicTestLoan(&first, &universal, true)
  root.parent = Option<Shared<Lifetime>>.none()
  root.crossed = false
  run regionTestLoan(&mut fixture, move root)
  let mut child = run symbolicTestLoan(&second, &first, false)
  child.place.root = 1
  run List<Step>.append(&mut child.place.steps, referent())
  child.created = 2
  run List<Interval>.append(&mut child.intervals, Interval {from: 2, to: 3, definition: usize.MAX, read: usize.MAX, cleanup: false})
  run regionTestLoan(&mut fixture, move child)
  run List<Event>.append(&mut fixture.events.events, Event {point: 3, place: Place {root: 0, steps: List<Step>.make()},
    kind: Kind.End, span: Location.make(0, 1), target: Location.make(0, 1), loan: usize.MAX, consumesTarget: 0,
    refiner: usize.MAX, refinedDepth: 0, binders: List<usize>.make()})
  let emptyGoals = List<SafetyObligation>.make()
  let premises = List<RegionBound>.make()
  let mut symbolic = List<SymbolicRegion>.make()
  run Testing.expect(!run regionTestRelations(&fixture, &owner, List<SafetyObligation>.asSlice(&emptyGoals), true),
    "a crossed child's required point must fit its owned parent's availability even with no typing goals")
  let mut descriptor = List<Event>.asMutSlice(&mut fixture.events.events)
  descriptor[0].place.root = 1
  run Testing.expect(run regionTestRelations(&fixture, &owner, List<SafetyObligation>.asSlice(&emptyGoals), true),
    "ending a temporary descriptor preserves a finite child whose actual owned source stays alive")
  let mut referentEnd = List<Event>.asMutSlice(&mut fixture.events.events)
  run List<Step>.append(&mut referentEnd[0].place.steps, referent())
  run Testing.expect(!run regionTestRelations(&fixture, &owner, List<SafetyObligation>.asSlice(&emptyGoals), true),
    "a finite parent proof never ignores an actual referent end")
  List<Event>.clear(&mut fixture.events.events)
  run Testing.expect(run regionTestRelations(&fixture, &owner, List<SafetyObligation>.asSlice(&emptyGoals), true),
    "the finite crossing is proved when the actual owned parent remains valid")
  run Testing.expect(!run symbolicRegionProved(&regionTestSources(&fixture), &owner, &second, &universal,
    List<RegionBound>.asSlice(&premises), &mut symbolic),
    "finite success never installs a universal-source proof for owned storage")
  let mut shared = List<Loan>.asMutSlice(&mut fixture.loans)
  shared[1].borrowed = Option<Shared<Lifetime>>.some(Shared<Lifetime>.clone(&first))
  let mut names = List<Shared<Lifetime>>.asMutSlice(&mut shared[1].regions)
  names[0] = Shared<Lifetime>.clone(&first)
  run Testing.expect(run regionTestRelations(&fixture, &owner, List<SafetyObligation>.asSlice(&emptyGoals), true),
    "a shared parent atom remains grounded in its live owned source before the reborrow is created")
  run List<Event>.append(&mut fixture.events.events, Event {point: 3, place: Place {root: 0, steps: List<Step>.make()},
    kind: Kind.End, span: Location.make(0, 1), target: Location.make(0, 1), loan: usize.MAX, consumesTarget: 0,
    refiner: usize.MAX, refinedDepth: 0, binders: List<usize>.make()})
  run Testing.expect(!run regionTestRelations(&fixture, &owner, List<SafetyObligation>.asSlice(&emptyGoals), true),
    "a shared parent atom cannot erase the requirement to check every source's availability")
  List<Event>.clear(&mut fixture.events.events)
  let mut restored = List<Loan>.asMutSlice(&mut fixture.loans)
  restored[1].borrowed = Option<Shared<Lifetime>>.some(Shared<Lifetime>.clone(&second))
  let mut original = List<Shared<Lifetime>>.asMutSlice(&mut restored[1].regions)
  original[0] = Shared<Lifetime>.clone(&second)
  // Duplicate child regions retain every actual parent path, including an ungrounded sibling.
  run regionTestLoan(&mut fixture, run symbolicTestLoan(&second, &third, false))
  run regionTestLoan(&mut fixture, run symbolicTestLoan(&third, &third, false))
  let mut roots = List<SymbolicRoot>.make()
  drop run symbolicRootIndex(&mut roots, &second)
  run Testing.expect(!run finiteParentRoots(&regionTestSources(&fixture), &owner, &mut roots),
    "a grounded branch cannot justify another source trapped in an ungrounded cycle")
  let mut grounded = List<Loan>.asMutSlice(&mut fixture.loans)
  grounded[3].local = true
  grounded[3].parent = Option<Shared<Lifetime>>.none()
  roots = List<SymbolicRoot>.make()
  drop run symbolicRootIndex(&mut roots, &second)
  run Testing.expect(run finiteParentRoots(&regionTestSources(&fixture), &owner, &mut roots),
    "all actual parents of a duplicated region can be grounded separately")
  let mut uncertain = List<Loan>.asMutSlice(&mut fixture.loans)
  uncertain[3].precision = LoanPrecision.Unknown
  roots = List<SymbolicRoot>.make()
  drop run symbolicRootIndex(&mut roots, &second)
  run Testing.expect(!run finiteParentRoots(&regionTestSources(&fixture), &owner, &mut roots),
    "one Unknown actual source blocks the complete finite parent proof")
  let mut changed = List<Loan>.asMutSlice(&mut fixture.loans)
  changed[3].precision = LoanPrecision.Exact
  changed[2].parent = Option<Shared<Lifetime>>.some(Shared<Lifetime>.clone(&foreign))
  roots = List<SymbolicRoot>.make()
  drop run symbolicRootIndex(&mut roots, &second)
  run Testing.expect(!run finiteParentRoots(&regionTestSources(&fixture), &owner, &mut roots),
    "an equal ordinal in a foreign owner is not a local parent")
  let mut innerOnly = List<Loan>.asMutSlice(&mut fixture.loans)
  innerOnly[2].parent = Option<Shared<Lifetime>>.some(Shared<Lifetime>.clone(&first))
  innerOnly[2].borrowed = Option<Shared<Lifetime>>.some(Shared<Lifetime>.clone(&third))
  roots = List<SymbolicRoot>.make()
  drop run symbolicRootIndex(&mut roots, &second)
  run Testing.expect(!run finiteParentRoots(&regionTestSources(&fixture), &owner, &mut roots),
    "a stored inner atom alone cannot supply actual outer loan identity")
  return ()
}

test effect fn intervalRequirementsKeepReachableEndsAndCleanup() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run intervalRequirementClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn intervalTestProved(fixture: &RegionTestFixture, owner: &DeclarationId, region: &Shared<Lifetime>) -> bool
! OutOfMemoryError ? &mut Allocator {
  let facts = run regionTestProjections(fixture)
  let input = regionTestInput(fixture, List<Option<RegionLoanProjection>>.asSlice(&facts))
  let premises = List<RegionBound>.make()
  let mut regions = List<RegionPoints>.make()
  let mut symbolic = List<SymbolicRegion>.make()
  let mut flow = emptyIntervalFlow()
  let mut storage = emptyRegionAvailability()
  let found = run projectedRegionPoints(&input, &regionTestSources(fixture), owner, region,
    &mut regions, List<RegionBound>.asSlice(&premises), &mut symbolic, &mut flow, &mut storage)
  return found != usize.MAX
}

effect fn intervalRequirementClaims() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let owner = run capturedTestOwner(b"interval-paths.silk", 0)
  let region = run Shared<Lifetime>.make(Lifetime.Local {declaration: DeclarationId.copy(&owner), ordinal: 0})
  let universal = run Shared<Lifetime>.make(Lifetime.Parameter {declaration: DeclarationId.copy(&owner), ordinal: 0})
  let mut fixture = regionTestFixture(1)
  let mut at = usize.ZERO
  while at < 5 { drop run regionTestPoint(&mut fixture) at = at + usize.ONE }
  run regionTestEdge(&mut fixture, 1, 2)
  run regionTestEdge(&mut fixture, 2, 0)
  run regionTestEdge(&mut fixture, 1, 3)
  run regionTestEdge(&mut fixture, 3, 4)
  run regionTestEdge(&mut fixture, 4, 0)
  let mut loan = run symbolicTestLoan(&region, &universal, true)
  loan.parent = Option<Shared<Lifetime>>.none()
  loan.crossed = false
  run List<Interval>.append(&mut loan.intervals, Interval {from: 1, to: 4, definition: usize.MAX, read: usize.MAX, cleanup: false})
  run regionTestLoan(&mut fixture, move loan)
  run List<Event>.append(&mut fixture.events.events, Event {point: 2, place: Place {root: 0, steps: List<Step>.make()},
    kind: Kind.End, span: Location.make(0, 1), target: Location.make(0, 1), loan: usize.MAX, consumesTarget: 0,
    refiner: usize.MAX, refinedDepth: 0, binders: List<usize>.make()})
  run Testing.expect(run intervalTestProved(&fixture, &owner, &region),
    "an early-exit storage end cannot reach this interval's consumer and is not its requirement")
  run regionTestEdge(&mut fixture, 2, 3)
  run Testing.expect(!run intervalTestProved(&fixture, &owner, &region),
    "the same storage end remains required when its branch reaches the consuming point")
  let mut direct = List<Point>.asMutSlice(&mut fixture.control.points)
  List<usize>.clear(&mut direct[2].next)
  run regionTestEdge(&mut fixture, 2, 0)
  run regionTestEdge(&mut fixture, 2, 1)
  run Testing.expect(!run intervalTestProved(&fixture, &owner, &region),
    "a back edge that reaches the consumer cannot be pruned as an abandoned branch")
  let mut restored = List<Point>.asMutSlice(&mut fixture.control.points)
  List<usize>.clear(&mut restored[2].next)
  run regionTestEdge(&mut fixture, 2, 0)
  let mut observed = List<Loan>.asMutSlice(&mut fixture.loans)
  run List<Interval>.append(&mut observed[0].intervals, Interval {from: 2, to: 2, definition: usize.MAX, read: usize.MAX, cleanup: true})
  run Testing.expect(!run intervalTestProved(&fixture, &owner, &region),
    "an abandoned call does not erase a cleanup observer's independent requirement")
  return ()
}

test effect fn ownedInitializationRequiresEveryPathAndPreservesEnds() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run ownedInitializationClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn initializedRelationProved(fixture: &RegionTestFixture, owner: &DeclarationId,
  shorter: &Shared<Lifetime>, longer: &Shared<Lifetime>) -> bool
! OutOfMemoryError ? &mut Allocator {
  let facts = run regionTestProjections(fixture)
  return run initializedGeometryRelationProved(fixture, List<Option<RegionLoanProjection>>.asSlice(&facts), owner, shorter, longer)
}

effect fn initializedGeometryRelationProved(fixture: &RegionTestFixture, facts: &[Option<RegionLoanProjection>], owner: &DeclarationId,
  shorter: &Shared<Lifetime>, longer: &Shared<Lifetime>) -> bool ! OutOfMemoryError ? &mut Allocator {
  let input = regionTestInput(fixture, facts)
  let premises = List<RegionBound>.make()
  let mut regions = List<RegionPoints>.make()
  let mut symbolic = List<SymbolicRegion>.make()
  let mut flow = emptyIntervalFlow()
  let mut storage = emptyRegionAvailability()
  let first = run projectedRegionPoints(&input, &regionTestSources(fixture), owner, shorter,
    &mut regions, List<RegionBound>.asSlice(&premises), &mut symbolic, &mut flow, &mut storage)
  let second = run projectedRegionPoints(&input, &regionTestSources(fixture), owner, longer,
    &mut regions, List<RegionBound>.asSlice(&premises), &mut symbolic, &mut flow, &mut storage)
  if first == usize.MAX || second == usize.MAX { return false }
  let mut edges = List<RegionEdge>.make()
  run List<RegionEdge>.append(&mut edges, RegionEdge {shorter: first, longer: second})
  return run solveRegionRequirements(&mut regions, List<RegionEdge>.asSlice(&edges))
}

effect fn ownedInitializationClaims() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let owner = run capturedTestOwner(b"owned-initialization.silk", 0)
  let shorter = run Shared<Lifetime>.make(Lifetime.Local {declaration: DeclarationId.copy(&owner), ordinal: 0})
  let longer = run Shared<Lifetime>.make(Lifetime.Local {declaration: DeclarationId.copy(&owner), ordinal: 1})
  let mut fixture = regionTestFixture(3)
  let mut at = usize.ZERO
  while at < 6 { drop run regionTestPoint(&mut fixture) at = at + usize.ONE }
  at = usize.ONE
  while at < 5 { run regionTestEdge(&mut fixture, at, at + usize.ONE) at = at + usize.ONE }
  run regionTestEdge(&mut fixture, 5, 0)
  let mut first = run symbolicTestLoan(&shorter, &shorter, true)
  first.parent = Option<Shared<Lifetime>>.none()
  first.crossed = false
  first.created = 2
  let mut second = run symbolicTestLoan(&longer, &longer, true)
  second.parent = Option<Shared<Lifetime>>.none()
  second.crossed = false
  second.created = 4
  second.place.root = 1
  run regionTestLoan(&mut fixture, move first)
  run regionTestLoan(&mut fixture, move second)
  run regionTestInitialization(&mut fixture, 1, 1)
  run Testing.expect(run initializedRelationProved(&fixture, &owner, &shorter, &longer),
    "an initialized owned source covers an earlier argument before its fresh borrow")
  let mut alternatives = List<Loan>.asMutSlice(&mut fixture.loans)
  alternatives[1].precision = LoanPrecision.Alternatives
  run Testing.expect(run initializedRelationProved(&fixture, &owner, &shorter, &longer),
    "an explicitly known alternative retains its actual initialized storage mask")
  // One acquisition may have several canonical places. These are not separate loans:
  // the same needs must fit every active place, and an unresolved place cannot certify.
  let mut wanted = List<Loan>.asMutSlice(&mut fixture.loans)
  run List<Interval>.append(&mut wanted[0].intervals, Interval {from: 2, to: 5, definition: usize.MAX, read: usize.MAX, cleanup: false})
  run regionTestInitialization(&mut fixture, 2, 2)
  run List<Event>.append(&mut fixture.events.events, Event {point: 5,
    place: Place {root: 2, steps: List<Step>.make()}, kind: Kind.End,
    span: Location.make(0, 1), target: Location.make(0, 1), loan: usize.MAX, consumesTarget: 0,
    refiner: usize.MAX, refinedDepth: 0, binders: List<usize>.make()})
  let mut guarded = run regionTestProjections(&fixture)
  if true {
    let mut projectedLoans = List<Option<RegionLoanProjection>>.asMutSlice(&mut guarded)
    if let Option<RegionLoanProjection>.Some {value} = &mut projectedLoans[1] {
      run List<SourceSettledPlace>.append(&mut value.geometry.alternatives, SourceSettledPlace {
        place: Place {root: 2, steps: List<Step>.make()}, activity: SourceTruth.False})
    } else { return CompilerBug.panic(b"geometry control lost the actual region source") }
  }
  run Testing.expect(run initializedGeometryRelationProved(&fixture, List<Option<RegionLoanProjection>>.asSlice(&guarded), &owner, &shorter, &longer),
    "an inactive geometry alternative cannot invalidate the original loan's storage")
  if true {
    let mut projectedLoans = List<Option<RegionLoanProjection>>.asMutSlice(&mut guarded)
    if let Option<RegionLoanProjection>.Some {value} = &mut projectedLoans[1] {
      if true {
        let mut mutated = List<SourceSettledPlace>.asMutSlice(&mut value.geometry.alternatives)
        mutated[1].activity = SourceTruth.Undefined
      }
    }
  }
  run Testing.expect(!run initializedGeometryRelationProved(&fixture, List<Option<RegionLoanProjection>>.asSlice(&guarded), &owner, &shorter, &longer),
    "unresolved canonical geometry cannot certify the same loan's must-availability")
  if true {
    let mut projectedLoans = List<Option<RegionLoanProjection>>.asMutSlice(&mut guarded)
    if let Option<RegionLoanProjection>.Some {value} = &mut projectedLoans[1] {
      if true {
        let mut mutated = List<SourceSettledPlace>.asMutSlice(&mut value.geometry.alternatives)
        mutated[1].activity = SourceTruth.True
      }
    }
  }
  run Testing.expect(!run initializedGeometryRelationProved(&fixture, List<Option<RegionLoanProjection>>.asSlice(&guarded), &owner, &shorter, &longer),
    "an active ended alternative invalidates one loan even when its first canonical place remains alive")
  List<Event>.clear(&mut fixture.events.events)
  List<Interval>.clear(&mut List<Loan>.asMutSlice(&mut fixture.loans)[0].intervals)
  let mut third = run symbolicTestLoan(&longer, &longer, true)
  third.parent = Option<Shared<Lifetime>>.none()
  third.crossed = false
  third.precision = LoanPrecision.Alternatives
  third.created = 4
  third.place.root = 2
  run regionTestLoan(&mut fixture, move third)
  run regionTestInitialization(&mut fixture, 2, 2)
  let mut uses = List<Loan>.asMutSlice(&mut fixture.loans)
  run List<Interval>.append(&mut uses[0].intervals, Interval {from: 2, to: 5, definition: usize.MAX, read: usize.MAX, cleanup: false})
  run Testing.expect(run initializedRelationProved(&fixture, &owner, &shorter, &longer),
    "every known alternative contributes its own initialized storage mask")
  run List<Event>.append(&mut fixture.events.events, Event {point: 5,
    place: Place {root: 2, steps: List<Step>.make()}, kind: Kind.End,
    span: Location.make(0, 1), target: Location.make(0, 1), loan: usize.MAX, consumesTarget: 0,
    refiner: usize.MAX, refinedDepth: 0, binders: List<usize>.make()})
  run Testing.expect(!run initializedRelationProved(&fixture, &owner, &shorter, &longer),
    "ending one alternative rejects an incoming requirement even while the other remains alive")
  List<Event>.clear(&mut fixture.events.events)
  drop List<Loan>.pop(&mut fixture.loans)
  drop List<SourceTruth>.pop(&mut fixture.activity)
  let mut originalUses = List<Loan>.asMutSlice(&mut fixture.loans)
  List<Interval>.clear(&mut originalUses[0].intervals)
  run regionTestInitialization(&mut fixture, 2, usize.MAX)
  let mut unknown = List<Loan>.asMutSlice(&mut fixture.loans)
  unknown[1].precision = LoanPrecision.Unknown
  run Testing.expect(!run initializedRelationProved(&fixture, &owner, &shorter, &longer),
    "Unknown provenance cannot acquire availability from a matching initialization")
  let mut restoredPrecision = List<Loan>.asMutSlice(&mut fixture.loans)
  restoredPrecision[1].precision = LoanPrecision.Exact
  run regionTestInitialization(&mut fixture, 1, usize.MAX)
  run regionTestInitialization(&mut fixture, 3, 1)
  // The later borrow at 4 cannot be live at the earlier loan's points 2 and 3, which its creation
  // never reaches: a value of a region observed at a point carries only loans whose creation
  // reaches that point, so those points place no validity requirement on its storage.
  run Testing.expect(run initializedRelationProved(&fixture, &owner, &shorter, &longer),
    "a requirement at points the later borrow's creation never reaches needs no storage there")
  run regionTestEdge(&mut fixture, 5, 2)
  run Testing.expect(!run initializedRelationProved(&fixture, &owner, &shorter, &longer),
    "storage is not available before its initialization where the later borrow's creation reaches")
  let mut looped = List<Point>.asMutSlice(&mut fixture.control.points)
  drop List<usize>.pop(&mut looped[5].next)
  run regionTestEdge(&mut fixture, 2, 4)
  run Testing.expect(!run initializedRelationProved(&fixture, &owner, &shorter, &longer),
    "one path bypassing initialization also excludes the later borrow's own required point")
  run regionTestInitialization(&mut fixture, 1, 1)
  run regionTestInitialization(&mut fixture, 3, usize.MAX)
  run List<Event>.append(&mut fixture.events.events, Event {point: 2,
    place: Place {root: 1, steps: List<Step>.make()}, kind: Kind.End,
    span: Location.make(0, 1), target: Location.make(0, 1), loan: usize.MAX, consumesTarget: 0,
    refiner: usize.MAX, refinedDepth: 0, binders: List<usize>.make()})
  run Testing.expect(run initializedRelationProved(&fixture, &owner, &shorter, &longer),
    "a storage end the later borrow's creation never reaches places no requirement on that borrow")
  run regionTestEdge(&mut fixture, 5, 2)
  run Testing.expect(!run initializedRelationProved(&fixture, &owner, &shorter, &longer),
    "initialization does not erase an actual storage end the later fresh borrow's creation reaches")
  let mut ended = List<Point>.asMutSlice(&mut fixture.control.points)
  drop List<usize>.pop(&mut ended[5].next)
  List<Event>.clear(&mut fixture.events.events)
  run regionTestInitialization(&mut fixture, 1, usize.MAX)
  run regionTestInitialization(&mut fixture, 3, 1)
  let mut cycling = List<Point>.asMutSlice(&mut fixture.control.points)
  List<usize>.clear(&mut cycling[1].next)
  run regionTestEdge(&mut fixture, 1, 3)
  run regionTestEdge(&mut fixture, 3, 2)
  run Testing.expect(run initializedRelationProved(&fixture, &owner, &shorter, &longer),
    "a rebinding on a CFG cycle the later borrow's creation never reaches places no requirement on that borrow")
  run regionTestEdge(&mut fixture, 5, 2)
  run Testing.expect(!run initializedRelationProved(&fixture, &owner, &shorter, &longer),
    "a root rebound on a CFG cycle the later borrow's creation reaches cannot revive storage for an earlier loan")
  // Meet constituents keep the same owned-storage must proof. An incoming requirement at
  // the join also covers the path that never created this fresh borrow.
  List<Point>.clear(&mut fixture.control.points)
  List<Loan>.clear(&mut fixture.loans)
  List<SourceTruth>.clear(&mut fixture.activity)
  List<SourceVisit.Owner>.clear(&mut fixture.owners)
  List<Event>.clear(&mut fixture.events.events)
  fixture.localCount = 3
  at = usize.ZERO
  while at < 6 { drop run regionTestPoint(&mut fixture) at = at + usize.ONE }
  at = usize.ONE
  while at < 5 { run regionTestEdge(&mut fixture, at, at + usize.ONE) at = at + usize.ONE }
  run regionTestEdge(&mut fixture, 5, 0)
  run regionTestEdge(&mut fixture, 2, 5)
  let extra = run Shared<Lifetime>.make(Lifetime.Local {declaration: DeclarationId.copy(&owner), ordinal: 2})
  let mut members = List<Shared<Lifetime>>.make()
  run List<Shared<Lifetime>>.append(&mut members, Shared<Lifetime>.clone(&longer))
  run List<Shared<Lifetime>>.append(&mut members, Shared<Lifetime>.clone(&extra))
  let meet = run Lifetime.meet(List<Shared<Lifetime>>.asSlice(&members))
  let mut demand = run symbolicTestLoan(&shorter, &shorter, true)
  demand.parent = Option<Shared<Lifetime>>.none()
  demand.created = 2
  run List<Interval>.append(&mut demand.intervals, Interval {from: 2, to: 5, definition: usize.MAX, read: usize.MAX, cleanup: false})
  let mut member = run symbolicTestLoan(&meet, &meet, true)
  member.parent = Option<Shared<Lifetime>>.none()
  member.created = 4
  member.place.root = 1
  let mut companion = run symbolicTestLoan(&longer, &longer, true)
  companion.parent = Option<Shared<Lifetime>>.none()
  companion.created = 4
  companion.place.root = 2
  run regionTestLoan(&mut fixture, move demand)
  run regionTestLoan(&mut fixture, move member)
  run regionTestLoan(&mut fixture, move companion)
  run regionTestInitialization(&mut fixture, 1, 1)
  run regionTestInitialization(&mut fixture, 2, 2)
  run Testing.expect(run initializedRelationProved(&fixture, &owner, &shorter, &longer),
    "an actual meet member uses its owned storage initialized before the branch")
  run regionTestInitialization(&mut fixture, 1, usize.MAX)
  run regionTestInitialization(&mut fixture, 3, 1)
  run Testing.expect(!run initializedRelationProved(&fixture, &owner, &shorter, &longer),
    "one contributing meet member still excludes an incoming join use on the path bypassing initialization")
  run regionTestInitialization(&mut fixture, 1, 1)
  run regionTestInitialization(&mut fixture, 3, usize.MAX)
  let mut unrelatedBorrow = List<Loan>.asMutSlice(&mut fixture.loans)
  unrelatedBorrow[1].borrowed = Option<Shared<Lifetime>>.some(Shared<Lifetime>.clone(&extra))
  run Testing.expect(!run initializedRelationProved(&fixture, &owner, &shorter, &longer),
    "membership in retained lifetimes alone cannot authenticate a different borrowed atom")
  let mut actualBorrow = List<Loan>.asMutSlice(&mut fixture.loans)
  actualBorrow[1].borrowed = Option<Shared<Lifetime>>.some(Shared<Lifetime>.clone(&meet))
  run List<Event>.append(&mut fixture.events.events, Event {point: 5,
    place: Place {root: 1, steps: List<Step>.make()}, kind: Kind.End,
    span: Location.make(0, 1), target: Location.make(0, 1), loan: usize.MAX, consumesTarget: 0,
    refiner: usize.MAX, refinedDepth: 0, binders: List<usize>.make()})
  run Testing.expect(!run initializedRelationProved(&fixture, &owner, &shorter, &longer),
    "a contributing meet member's End still rejects incoming use while the other source remains alive")

  // Traversal reserves entry at zero. An unrelated point numbered one is not a
  // substitute, and the actual creation still stops the lower-bound exclusion.
  List<Point>.clear(&mut fixture.control.points)
  List<SourceVisit.Owner>.clear(&mut fixture.owners)
  List<Event>.clear(&mut fixture.events.events)
  at = usize.ZERO
  while at < 3 { drop run regionTestPoint(&mut fixture) at = at + usize.ONE }
  run regionTestEdge(&mut fixture, 0, 1)
  run regionTestEdge(&mut fixture, 0, 2)
  let mut actualEntryLoan = run symbolicTestLoan(&longer, &longer, true)
  actualEntryLoan.parent = Option<Shared<Lifetime>>.none()
  actualEntryLoan.created = 2
  actualEntryLoan.place.root = 1
  let mut actualAvailable = List<u64>.make()
  run List<u64>.append(&mut actualAvailable, u64.bitNot(0))
  let noDefinitions = List<u64>.make()
  let emptyCarriers = AvailabilityProjection {carriers: List<AvailabilityCarrier>.make(),
    preserves: List<u64>.make(), flight: List<bool>.make(), unresolved: false}
  run propagateAvailability(List<Point>.asSlice(&fixture.control.points), List<Event>.asSlice(&fixture.events.events),
    0, &actualEntryLoan, &actualEntryLoan.place, false, false, List<u64>.asSlice(&noDefinitions), 0, &emptyCarriers, &mut actualAvailable)
  let actualMask = List<u64>.asSlice(&actualAvailable)[0]
  run Testing.expect(u64.bitAnd(actualMask, maskOf(0)) == 0
    && u64.bitAnd(actualMask, maskOf(1)) == 0 && u64.bitAnd(actualMask, maskOf(2)) != 0,
    "storage validity excludes the actual entry and bypass paths while stopping at this loan's creation")
  run regionTestInitialization(&mut fixture, 1, 1)
  let mut actualStorage = emptyRegionAvailability()
  let mut actualFlow = emptyIntervalFlow()
  fixture.control.entry = 0
  let initializedAt = run sourceInitializedOwnedRegion(&fixture.control, List<SourceVisit.Owner>.asSlice(&fixture.owners),
    fixture.localCount, &actualEntryLoan, &actualEntryLoan.place, &longer, &mut actualStorage, &mut actualFlow)
  run Testing.expect(initializedAt != usize.MAX,
    "an actual owner initialization is retained independently of whether every path reaches it")
  let initMask = List<u64>.asSlice(&List<List<u64>>.asSlice(&actualStorage.masks)[initializedAt])[0]
  run Testing.expect(u64.bitAnd(initMask, maskOf(0)) == 0 && u64.bitAnd(initMask, maskOf(2)) == 0,
    "one actual entry path bypassing initialization still prevents must-availability at creation")
  return ()
}

test effect fn offeredMeetRequiresEverySource() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run offeredMeetClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn offeredMeetRelationProved(fixture: &RegionTestFixture, owner: &DeclarationId,
  offered: &Shared<Lifetime>, wanted: &Shared<Lifetime>) -> bool
! OutOfMemoryError ? &mut Allocator {
  let mut obligations = List<SafetyObligation>.make()
  run List<SafetyObligation>.append(&mut obligations, retentionTestRelation(offered, wanted, false))
  return run regionTestRelations(fixture, owner, List<SafetyObligation>.asSlice(&obligations), false)
}

effect fn offeredMeetClaims() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let owner = run capturedTestOwner(b"offered-meet.silk", 0)
  let first = run Shared<Lifetime>.make(Lifetime.Local {declaration: DeclarationId.copy(&owner), ordinal: 0})
  let second = run Shared<Lifetime>.make(Lifetime.Local {declaration: DeclarationId.copy(&owner), ordinal: 1})
  let wanted = run Shared<Lifetime>.make(Lifetime.Local {declaration: DeclarationId.copy(&owner), ordinal: 2})
  let universal = run Shared<Lifetime>.make(Lifetime.Parameter {declaration: DeclarationId.copy(&owner), ordinal: 0})
  let mut fixture = regionTestFixture(3)
  let mut at = usize.ZERO
  while at < 4 { drop run regionTestPoint(&mut fixture) at = at + usize.ONE }
  run regionTestEdge(&mut fixture, 1, 2)
  run regionTestEdge(&mut fixture, 2, 3)
  run regionTestEdge(&mut fixture, 3, 0)
  let mut one = run symbolicTestLoan(&first, &universal, false)
  one.created = 1
  let mut two = run symbolicTestLoan(&second, &universal, false)
  two.created = 1
  two.place.root = 1
  let mut consumer = run symbolicTestLoan(&wanted, &universal, false)
  consumer.created = 3
  consumer.place.root = 2
  run regionTestLoan(&mut fixture, move one)
  run regionTestLoan(&mut fixture, move two)
  run regionTestLoan(&mut fixture, move consumer)
  let mut members = List<Shared<Lifetime>>.make()
  run List<Shared<Lifetime>>.append(&mut members, Shared<Lifetime>.clone(&first))
  run List<Shared<Lifetime>>.append(&mut members, Shared<Lifetime>.clone(&second))
  let offered = run Lifetime.meet(List<Shared<Lifetime>>.asSlice(&members))
  run Testing.expect(run offeredMeetRelationProved(&fixture, &owner, &offered, &wanted),
    "both known source regions cover the finite consumer of their meet")
  run List<Event>.append(&mut fixture.events.events, Event {point: 2,
    place: Place {root: 1, steps: List<Step>.make()}, kind: Kind.End,
    span: Location.make(0, 1), target: Location.make(0, 1), loan: usize.MAX, consumesTarget: 0,
    refiner: usize.MAX, refinedDepth: 0, binders: List<usize>.make()})
  run Testing.expect(!run offeredMeetRelationProved(&fixture, &owner, &offered, &wanted),
    "one ended source prevents the meet from covering a later consumer")
  List<Event>.clear(&mut fixture.events.events)
  let missing = run Shared<Lifetime>.make(Lifetime.Local {declaration: DeclarationId.copy(&owner), ordinal: 3})
  run List<Shared<Lifetime>>.append(&mut members, move missing)
  let incomplete = run Lifetime.meet(List<Shared<Lifetime>>.asSlice(&members))
  run Testing.expect(!run offeredMeetRelationProved(&fixture, &owner, &incomplete, &wanted),
    "a known member never hides another member with no authenticated loan mapping")
  let mut restored = List<Loan>.asMutSlice(&mut fixture.loans)
  restored[1].precision = LoanPrecision.Unknown
  run Testing.expect(!run offeredMeetRelationProved(&fixture, &owner, &offered, &wanted),
    "a known member never hides another member's unknown loan mapping")
  let mut exact = List<Loan>.asMutSlice(&mut fixture.loans)
  exact[1].precision = LoanPrecision.Exact
  exact[1].parent = Option<Shared<Lifetime>>.none()
  exact[1].local = true
  run Testing.expect(!run offeredMeetRelationProved(&fixture, &owner, &offered, &universal),
    "one function-local constituent cannot acquire the other member's universal parent")
  return ()
}

test effect fn regionChoicesKeepEverySourceConstraint() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run regionChoiceClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn choiceRelationsProved(fixture: &RegionTestFixture, owner: &DeclarationId, obligations: &[SafetyObligation]) -> bool
! OutOfMemoryError ? &mut Allocator {
  return run regionTestRelations(fixture, owner, obligations, false)
}

effect fn regionChoiceClaims() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let owner = run capturedTestOwner(b"region-choices.silk", 0)
  let source = run Shared<Lifetime>.make(Lifetime.Local {declaration: DeclarationId.copy(&owner), ordinal: 0})
  let choice = run Shared<Lifetime>.make(Lifetime.Local {declaration: DeclarationId.copy(&owner), ordinal: 1})
  let useRegion = run Shared<Lifetime>.make(Lifetime.Local {declaration: DeclarationId.copy(&owner), ordinal: 2})
  let universal = run Shared<Lifetime>.make(Lifetime.Parameter {declaration: DeclarationId.copy(&owner), ordinal: 0})
  let mut fixture = regionTestFixture(3)
  let mut at = usize.ZERO
  while at < 4 { drop run regionTestPoint(&mut fixture) at = at + usize.ONE }
  run regionTestEdge(&mut fixture, 1, 2)
  run regionTestEdge(&mut fixture, 2, 3)
  run regionTestEdge(&mut fixture, 3, 0)
  let mut producer = run symbolicTestLoan(&source, &universal, false)
  producer.created = 1
  let mut consumer = run symbolicTestLoan(&useRegion, &universal, false)
  consumer.created = 3
  consumer.place.root = 1
  run regionTestLoan(&mut fixture, move producer)
  run regionTestLoan(&mut fixture, move consumer)
  let mut obligations = List<SafetyObligation>.make()
  run List<SafetyObligation>.append(&mut obligations, retentionTestRelation(&choice, &useRegion, false))
  run Testing.expect(!run choiceRelationsProved(&fixture, &owner, List<SafetyObligation>.asSlice(&obligations)),
    "an unmapped local atom remains unproved without a typing witness")
  run List<SafetyObligation>.append(&mut obligations, SafetyObligation.RegionChoice {
    origin: Origin {node: 1, location: Location.make(0, 1)}, region: Shared<Lifetime>.clone(&choice)})
  run Testing.expect(run choiceRelationsProved(&fixture, &owner, List<SafetyObligation>.asSlice(&obligations)),
    "an authenticated unconstrained choice can cover this finite consumer")
  run List<SafetyObligation>.append(&mut obligations, retentionTestRelation(&source, &choice, false))
  run Testing.expect(run choiceRelationsProved(&fixture, &owner, List<SafetyObligation>.asSlice(&obligations)),
    "a later source relation constrains the same choice")
  run List<Event>.append(&mut fixture.events.events, Event {point: 2,
    place: Place {root: 0, steps: List<Step>.make()}, kind: Kind.End,
    span: Location.make(0, 1), target: Location.make(0, 1), loan: usize.MAX, consumesTarget: 0,
    refiner: usize.MAX, refinedDepth: 0, binders: List<usize>.make()})
  run Testing.expect(!run choiceRelationsProved(&fixture, &owner, List<SafetyObligation>.asSlice(&obligations)),
    "consumer requirements cross the choice and still fail beyond its actual source's end")
  List<Event>.clear(&mut fixture.events.events)
  List<SafetyObligation>.truncate(&mut obligations, 1)
  run List<SafetyObligation>.append(&mut obligations, SafetyObligation.RegionChoice {
    origin: Origin {node: 0, location: Location.make(0, 1)}, region: Shared<Lifetime>.clone(&choice)})
  run Testing.expect(!run choiceRelationsProved(&fixture, &owner, List<SafetyObligation>.asSlice(&obligations)),
    "the choice witness must name its actual origin")
  List<SafetyObligation>.clear(&mut obligations)
  run List<SafetyObligation>.append(&mut obligations, SafetyObligation.RegionChoice {
    origin: Origin {node: 1, location: Location.make(0, 1)}, region: Shared<Lifetime>.clone(&choice)})
  run List<SafetyObligation>.append(&mut obligations, retentionTestRelation(&choice, &universal, false))
  run Testing.expect(!run choiceRelationsProved(&fixture, &owner, List<SafetyObligation>.asSlice(&obligations)),
    "a body-scoped choice is never a universal premise")
  return ()
}

test effect fn accessProjectionKeepsSharedPointsAndActualReplacementOperands() -> ()
! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run sourceAccessClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn sourceAccessClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut events = List<SourceAccessEvent>.make()
  let mut path = Path {root: 0, through: false, steps: List<Step>.make(), indexes: List<NodeId>.make(),
    refiner: usize.MAX, refinedDepth: 0, binders: List<usize>.make()}
  run List<Step>.append(&mut path.steps, anyElement())
  let target = Location.make(8, 9)
  let statement = Location.make(8, 15)
  run sourceAccessEvent(&mut events, SourceGraph.EvalId {index: 0}, SourceControl.PointId {index: 0},
    &path, Kind.Move, Location.make(2, 4), Location.make(3, 4))
  if true {
    let mut mutated = List<Step>.asMutSlice(&mut path.steps)
    mutated[0] = elementStep(4)
  }
  run sourceAccessEvent(&mut events, SourceGraph.EvalId {index: 1}, SourceControl.PointId {index: 0},
    &path, Kind.Drop, Location.make(5, 7), Location.make(5, 7))
  run sourceAccessEvent(&mut events, SourceGraph.EvalId {index: 2}, SourceControl.PointId {index: 1},
    &path, Kind.Write, target, target)
  let mut rhs = List<bool>.make()
  run List<bool>.append(&mut rhs, false)
  run List<bool>.append(&mut rhs, false)
  run List<bool>.append(&mut rhs, false)
  let actualActivity: [SourceTruth; 2] = [SourceTruth.True, SourceTruth.True]
  sourceConsumedTarget(&mut events, 2, List<bool>.asSlice(&rhs), statement, &actualActivity)
  run Testing.expect(List<SourceAccessEvent>.asSlice(&events)[2].event.consumesTarget == 0
    && List<SourceAccessEvent>.asSlice(&events)[2].event.span.end == 9,
    "an earlier overlapping move outside this actual RHS cannot widen the replacement diagnostic")
  if true {
    let mut mutated = List<bool>.asMutSlice(&mut rhs)
    mutated[1] = true
  }
  let absentActivity: [SourceTruth; 2] = [SourceTruth.False, SourceTruth.True]
  sourceConsumedTarget(&mut events, 2, List<bool>.asSlice(&rhs), statement, &absentActivity)
  run Testing.expect(List<SourceAccessEvent>.asSlice(&events)[2].event.consumesTarget == 0
    && List<SourceAccessEvent>.asSlice(&events)[2].event.span.end == 9,
    "an unreachable RHS move cannot consume or widen a reachable assignment target")
  let possibleActivity: [SourceTruth; 2] = [SourceTruth.Undefined, SourceTruth.True]
  sourceConsumedTarget(&mut events, 2, List<bool>.asSlice(&rhs), statement, &possibleActivity)
  run Testing.expect(List<SourceAccessEvent>.asSlice(&events)[2].event.consumesTarget == 2,
    "possible RHS execution cannot turn an exact geometric overlap into a concrete conflict")
  if true {
    let mut mutated = List<SourceAccessEvent>.asMutSlice(&mut events)
    mutated[2].event.consumesTarget = 0
  }
  if true {
    let mut mutated = List<bool>.asMutSlice(&mut rhs)
    mutated[1] = false
  }
  if true {
    let mut mutated = List<bool>.asMutSlice(&mut rhs)
    mutated[0] = true
  }
  sourceConsumedTarget(&mut events, 2, List<bool>.asSlice(&rhs), statement, &actualActivity)
  run Testing.expect(List<SourceAccessEvent>.asSlice(&events)[2].event.consumesTarget == 2
    && List<SourceAccessEvent>.asSlice(&events)[2].event.target.end == 15,
    "an actual RHS move through an unknown index preserves the uncertain overlapping-assignment gate and statement span")
  if true {
    let mut mutated = List<bool>.asMutSlice(&mut rhs)
    mutated[1] = true
  }
  sourceConsumedTarget(&mut events, 2, List<bool>.asSlice(&rhs), statement, &actualActivity)
  run Testing.expect(List<SourceAccessEvent>.asSlice(&events)[2].event.consumesTarget == 1,
    "a definite RHS overlap dominates an uncertain one")
  if true {
    let mut mutated = List<bool>.asMutSlice(&mut rhs)
    mutated[0] = false
  }
  if true {
    let mut mutated = List<SourceAccessEvent>.asMutSlice(&mut events)
    mutated[1].activity = SourceTruth.False
  }
  if true {
    let mut mutated = List<SourceAccessEvent>.asMutSlice(&mut events)
    mutated[2].event.consumesTarget = 0
  }
  sourceConsumedTarget(&mut events, 2, List<bool>.asSlice(&rhs), statement, &actualActivity)
  run Testing.expect(List<SourceAccessEvent>.asSlice(&events)[2].event.consumesTarget == 0,
    "a false canonical alias cannot consume the target even at a reachable RHS point")
  if true {
    let mut mutated = List<SourceAccessEvent>.asMutSlice(&mut events)
    mutated[1].activity = SourceTruth.Undefined
  }
  sourceConsumedTarget(&mut events, 2, List<bool>.asSlice(&rhs), statement, &actualActivity)
  run Testing.expect(List<SourceAccessEvent>.asSlice(&events)[2].event.consumesTarget == 2,
    "an unresolved alias cannot ground an overlapping-assignment rejection")
  if true {
    let mut mutated = List<SourceAccessEvent>.asMutSlice(&mut events)
    mutated[1].activity = SourceTruth.True
  }
  sourceConsumedTarget(&mut events, 2, List<bool>.asSlice(&rhs), statement, &actualActivity)
  run Testing.expect(List<SourceAccessEvent>.asSlice(&events)[2].event.consumesTarget == 1,
    "the same actual move grounds the overlap only when its canonical alias is true")
  let mut projected = List<Event>.make()
  while List<SourceAccessEvent>.length(&events) != usize.ZERO {
    if let Option<SourceAccessEvent>.Some {value} = move List<SourceAccessEvent>.pop(&mut events) {
      run List<Event>.insert(&mut projected, 0, move value.event)
    }
  }
  let rows = run sourceEventsAt(List<Event>.asSlice(&projected), 3)
  let all = List<List<usize>>.asSlice(&rows)
  run Testing.expect(List<usize>.length(&all[0]) == 2 && List<usize>.asSlice(&all[0])[0] == 0
    && List<usize>.asSlice(&all[0])[1] == 1 && List<usize>.asSlice(&all[1])[0] == 2
    && List<usize>.length(&all[2]) == 0,
    "all events at one actual CFG point survive indexing, while an empty point gains no event")
  let mut points = List<Point>.make()
  let mut at = usize.ZERO
  while at < 4 {
    run List<Point>.append(&mut points, Point {next: List<usize>.make(), uses: usize.MAX, read: usize.MAX,
      written: usize.MAX, defines: usize.MAX, initializes: usize.MAX, event: usize.MAX, span: target})
    at = at + usize.ONE
  }
  let allPoints = List<Point>.asMutSlice(&mut points)
  run List<usize>.append(&mut allPoints[0].next, 1)
  run List<usize>.append(&mut allPoints[1].next, 2)
  run List<usize>.append(&mut allPoints[2].next, 0)
  run List<usize>.append(&mut allPoints[2].next, 3)
  let mut sources = List<usize>.make()
  run List<usize>.append(&mut sources, 2)
  let mut loops = List<Loop>.make()
  run List<Loop>.append(&mut loops, Loop {before: 0, header: 0, sources: move sources, end: 4, span: target})
  let moves: [usize; 2] = [0, 1]
  let originalInitializations: [MoveInitialization; 1] = [MoveInitialization {point: 3, root: 0}]
  let reached = run reaching(List<Point>.asSlice(&points), &originalInitializations,
    List<Event>.asSlice(&projected), List<Loop>.asSlice(&loops), &moves, 1)
  run Testing.expect(reaches(List<u64>.asSlice(&reached.entering), 1, 1, 0)
    && reaches(List<u64>.asSlice(&reached.entering), 1, 1, 1),
    "each move at a shared actual point reaches the next point without a singleton event slot")
  run Testing.expect(reaches(List<u64>.asSlice(&reached.leaving), 1, 1, 0)
    && !reaches(List<u64>.asSlice(&reached.leaving), 1, 1, 1),
    "an exact field replacement kills its moved part but cannot clear an unknown-index move")
  run Testing.expect(!reaches(List<u64>.asSlice(&reached.entering), 1, 0, 0)
    && !reaches(List<u64>.asSlice(&reached.leaving), 1, 3, 0),
    "loop backedges remain excluded from forward move propagation and initialization clears the owner's moves")
  let uses: [u64; 4] = [0, 0, 0, 3]
  let kills: [u64; 4] = [0, 1, 0, 0]
  let live = run solveLiveness(List<Point>.asSlice(&points), 1, &uses, &kills)
  run Testing.expect(!reaches(List<u64>.asSlice(&live), 1, 0, 0)
    && reaches(List<u64>.asSlice(&live), 1, 0, 1)
    && reaches(List<u64>.asSlice(&live), 1, 1, 0),
    "a killed definition stops backward demand while a sibling definition stays live across the same cycle")
  let occupied: [bool; 4] = [true, false, false, false]
  let noEnds: [bool; 4] = [false, false, false, false]
  let absentControl = run releasedInstancePoints(List<Point>.asSlice(&points), 0, 0, &occupied, &noEnds)
  run Testing.expect(u64.bitAnd(List<u64>.asSlice(&absentControl)[0], maskOf(3)) == 0,
    "mere absence after creation cannot establish release")
  let explicitEnds: [bool; 4] = [false, true, false, false]
  let ended = run releasedInstancePoints(List<Point>.asSlice(&points), 0, 0, &occupied, &explicitEnds)
  run Testing.expect(u64.bitAnd(List<u64>.asSlice(&ended)[0], maskOf(3)) != 0,
    "an explicit end releases every created instance before the exit despite recreation on the backedge")
  run List<usize>.append(&mut List<Point>.asMutSlice(&mut points)[0].next, 3)
  let joined = run releasedInstancePoints(List<Point>.asSlice(&points), 0, 0, &occupied, &explicitEnds)
  run Testing.expect(u64.bitAnd(List<u64>.asSlice(&joined)[0], maskOf(3)) == 0,
    "a creating path bypassing the end prevents release at the join")
  let mut endpoints = List<PreparedSources.Endpoint>.make()
  let origin = Origin {node: 0, location: target}
  run List<PreparedSources.Endpoint>.append(&mut endpoints, PreparedSources.Endpoint {
    root: PreparedSourcesRoot.Node {node: NodeId {index: 0}, category: PreparedSourcesEndpointRole.Storage},
    parent: Option<PreparedSources.EndpointId>.none(), selector: PreparedSourcesSelector.Identity,
    shape: PreparedSources.ShapeId {index: 0}, origin: origin})
  run List<PreparedSources.Endpoint>.append(&mut endpoints, PreparedSources.Endpoint {
    root: PreparedSourcesRoot.Node {node: NodeId {index: 0}, category: PreparedSourcesEndpointRole.Storage},
    parent: Option<PreparedSources.EndpointId>.some(PreparedSources.EndpointId {index: 0}),
    selector: PreparedSourcesSelector.Field {ordinal: 0}, shape: PreparedSources.ShapeId {index: 0}, origin: origin})
  run List<PreparedSources.Endpoint>.append(&mut endpoints, PreparedSources.Endpoint {
    root: PreparedSourcesRoot.Node {node: NodeId {index: 0}, category: PreparedSourcesEndpointRole.Storage},
    parent: Option<PreparedSources.EndpointId>.some(PreparedSources.EndpointId {index: 1}),
    selector: PreparedSourcesSelector.Referent, shape: PreparedSources.ShapeId {index: 0}, origin: origin})
  let owned = sourceStorageRoot(List<PreparedSources.Endpoint>.asSlice(&endpoints), SourceGraph.Storage {
    endpoint: PreparedSources.EndpointId {index: 1}, temporary: Option<SourceGraph.EvalId>.some(SourceGraph.EvalId {index: 7})})
  let canonical = match owned {
    Option<SourceGraph.Storage>.Some {value} => sourceSameStorage(value, SourceGraph.Storage {
      endpoint: PreparedSources.EndpointId {index: 0}, temporary: Option<SourceGraph.EvalId>.some(SourceGraph.EvalId {index: 7})})
    _ => false
  }
  let crossed = sourceStorageRoot(List<PreparedSources.Endpoint>.asSlice(&endpoints), SourceGraph.Storage {
    endpoint: PreparedSources.EndpointId {index: 2}, temporary: Option<SourceGraph.EvalId>.some(SourceGraph.EvalId {index: 7})})
  let refused = match crossed { Option<SourceGraph.Storage>.None => true _ => false }
  run Testing.expect(canonical && refused,
    "whole-holder ancestry preserves the actual acquisition and cannot cross a referent into its descriptor owner")
  let control = SourceControlProjection {entry: 0, points: move points, unresolved: false}
  let mut occupancy = SourceLoanOccupancy {loan: 0, width: 1, entering: List<u64>.make(),
    leaving: List<u64>.make(), inherited: List<u64>.make(), shadowed: List<u64>.make(), unresolved: false}
  run List<u64>.append(&mut occupancy.inherited, 0)
  run List<u64>.append(&mut occupancy.shadowed, 0)
  at = usize.ZERO
  while at < 4 {
    run List<u64>.append(&mut occupancy.entering, 1)
    run List<u64>.append(&mut occupancy.leaving, 1)
    at = at + usize.ONE
  }
  if true {
    let mut mutated = List<u64>.asMutSlice(&mut occupancy.leaving)
    mutated[1] = 0
  }
  run Testing.expect(sourceHeldAt(&control, &occupancy, List<u64>.asSlice(&live), false, 1) == CallerSource.Absent
    && sourceHeldAt(&control, &occupancy, List<u64>.asSlice(&live), false, 2) == CallerSource.Actual,
    "a replacement's future read cannot keep the discarded source live, while a surviving real definition does")
  run Testing.expect(sourceHeldAt(&control, &occupancy, List<u64>.asSlice(&live), true, 2) == CallerSource.Unknown
    && sourceLiveJoin(CallerSource.Unknown, CallerSource.Actual) == CallerSource.Actual
    && sourceLiveActivity(CallerSource.Actual, SourceTruth.Undefined) == CallerSource.Unknown,
    "possible liveness alone cannot ground a conflict; independent actual evidence wins only for an actual acquisition")
  let rebound: [bool; 4] = [false, true, false, false]
  let unchanged: [bool; 4] = [false, false, false, false]
  run Testing.expect(!(run readKeeping(List<Point>.asSlice(&control.points), 0, 2, 3, &rebound))
    && (run readKeeping(List<Point>.asSlice(&control.points), 0, 1, 3, &rebound)),
    "a rebind stops the original source, while the read at that same point still precedes its replacement")
  run Testing.expect(!(run readKeeping(List<Point>.asSlice(&control.points), 0, 2, 1, &unchanged))
    && (run readKeeping(List<Point>.asSlice(&control.points), 0, 2, 3, &unchanged)),
    "a stale source path cannot cross its loan's reacquisition even when no holder is rebound")
  // Reuse this CFG with a second owner. One owner's acquisition cannot clear the other,
  // while two genuine acquisitions at the same actual point must both take effect.
  if true {
    let mut mutated = List<Event>.asMutSlice(&mut projected)
    mutated[1].place.root = 1
  }
  let mut initialized = List<MoveInitialization>.make()
  run List<MoveInitialization>.append(&mut initialized, MoveInitialization {point: 3, root: 0})
  let separate = run reaching(List<Point>.asSlice(&control.points), List<MoveInitialization>.asSlice(&initialized),
    List<Event>.asSlice(&projected), List<Loop>.asSlice(&loops), &moves, 1)
  run Testing.expect(!reaches(List<u64>.asSlice(&separate.leaving), 1, 3, 0)
    && reaches(List<u64>.asSlice(&separate.leaving), 1, 3, 1),
    "initializing one owner preserves a different owner's reaching move")
  run List<MoveInitialization>.append(&mut initialized, MoveInitialization {point: 3, root: 1})
  let together = run reaching(List<Point>.asSlice(&control.points), List<MoveInitialization>.asSlice(&initialized),
    List<Event>.asSlice(&projected), List<Loop>.asSlice(&loops), &moves, 1)
  run Testing.expect(!reaches(List<u64>.asSlice(&together.leaving), 1, 3, 0)
    && !reaches(List<u64>.asSlice(&together.leaving), 1, 3, 1),
    "all actual owners initialized at one CFG point clear their own moves")
  run Testing.expect(moveReachesEvent(List<Event>.asSlice(&projected), List<MoveInitialization>.asSlice(&initialized),
      &moves, &together, 1, 0, 1)
    && !moveReachesEvent(List<Event>.asSlice(&projected), List<MoveInitialization>.asSlice(&initialized),
      &moves, &together, 1, 1, 0),
    "a coincident access sees a preceding move but cannot see a later move at that same point")
  if true {
    let mut mutated = List<Event>.asMutSlice(&mut projected)
    mutated[2].point = 0
  }
  if true {
    let mut mutated = List<Event>.asMutSlice(&mut projected)
    mutated[2].place.root = 1
  }
  path.root = 1
  let mut afterWrite = List<SourceAccessEvent>.make()
  run sourceAccessEvent(&mut afterWrite, SourceGraph.EvalId {index: 3}, SourceControl.PointId {index: 0},
    &path, Kind.Read, target, target)
  if let Option<SourceAccessEvent>.Some {value} = move List<SourceAccessEvent>.pop(&mut afterWrite) {
    run List<Event>.append(&mut projected, move value.event)
  }
  run Testing.expect(moveReachesEvent(List<Event>.asSlice(&projected), List<MoveInitialization>.asSlice(&initialized),
      &moves, &together, 1, 1, 2)
    && !moveReachesEvent(List<Event>.asSlice(&projected), List<MoveInitialization>.asSlice(&initialized),
      &moves, &together, 1, 1, 3),
    "a coincident write clears a move only for the access that follows the write")
  let guards: [SourceGuardConsumption; 2] = [
    SourceGuardConsumption {dispatch: 3, subject: SourceGraph.EvalId {index: 1}, point: SourceControl.PointId {index: 3}, span: statement},
    SourceGuardConsumption {dispatch: 1, subject: SourceGraph.EvalId {index: 0}, point: SourceControl.PointId {index: 1}, span: target}]
  let refusals: [SourceAccessRefusal; 1] = [SourceAccessRefusal {uncertain: false, dispatch: 2, point: SourceControl.PointId {index: 0}, reason: BorrowStatus.StoredLoans}]
  let present: [SourceTruth; 4] = [SourceTruth.True, SourceTruth.True, SourceTruth.True, SourceTruth.True]
  let before = sourcePrelude(&guards, &refusals, &present)
  run Testing.expect(match &before.guard { Option<Location>.Some {value} => value.end == target.end _ => false },
    "actual encounter order keeps an earlier guard ahead of a refusal whose CFG point was allocated first")
  let absent: [SourceTruth; 4] = [SourceTruth.True, SourceTruth.False, SourceTruth.True, SourceTruth.True]
  let stopped = sourcePrelude(&guards, &refusals, &absent)
  run Testing.expect(match &stopped.guard { Option<Location>.None => true _ => false },
    "a guard reached only after the checker refusal cannot replace that earlier unsupported result")
  let late: [SourceTruth; 4] = [SourceTruth.False, SourceTruth.False, SourceTruth.True, SourceTruth.True]
  let resumed = sourcePrelude(&guards, &refusals, &late)
  run Testing.expect(match &resumed.guard { Option<Location>.Some {value} => value.end == statement.end _ => false },
    "an unreachable refusal cannot hide a genuinely reached later consuming guard")
  let maybe: [SourceTruth; 4] = [SourceTruth.True, SourceTruth.Undefined, SourceTruth.True, SourceTruth.True]
  let pending = sourcePrelude(&guards, &refusals, &maybe)
  run Testing.expect(pending.unresolved && match &pending.guard { Option<Location>.None => true _ => false },
    "uncertain guard execution stays unresolved and cannot manufacture a concrete rejection")
  return run sourceViewClaims()
}

// This fixture checks activity and branch equations, not prepared MatchView authorship.
// A possible binding use must remain Unknown, a sibling use of another actual subject must
// not lend this view, and noncompletion must not erase the preceding arm's ordinary extent.
effect fn sourceViewClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut rules = SourceProgram.make()
  let yes = run sourceBoolean(&mut rules, true)
  let maybe = SourceProgram.atom(&mut rules)
  let empty = List<SourceAtom>.make()
  let none = List<SourceAtom>.asSlice(&empty)
  let negated: [SourceAtom; 1] = [maybe]
  run SourceProgram.rule(&mut rules, maybe, none, &negated)
  let mut flow = SourceControlFlow.make()
  let entry = run SourceControlFlow.point(&mut flow, &mut rules)
  let acquired = run SourceControlFlow.point(&mut flow, &mut rules)
  let branch = run SourceControlFlow.point(&mut flow, &mut rules)
  let binding = run SourceControlFlow.point(&mut flow, &mut rules)
  let sibling = run SourceControlFlow.point(&mut flow, &mut rules)
  let ended = run SourceControlFlow.point(&mut flow, &mut rules)
  let never = run SourceControlFlow.point(&mut flow, &mut rules)
  run SourceProgram.fact(&mut rules, SourceControlFlow.reachable(&flow, entry))
  run SourceControlFlow.edge(&mut flow, entry, acquired, yes)
  run SourceControlFlow.edge(&mut flow, acquired, branch, yes)
  run SourceControlFlow.edge(&mut flow, branch, binding, maybe)
  run SourceControlFlow.edge(&mut flow, branch, sibling, yes)
  run SourceControlFlow.edge(&mut flow, binding, ended, yes)
  run SourceControlFlow.edge(&mut flow, sibling, ended, yes)
  run SourceControlFlow.edge(&mut flow, ended, acquired, yes)
  let control = run SourceControlFlow.emit(move flow, &mut rules)
  let mut events = List<Event>.make()
  let mut at = usize.ZERO
  while at < 2 {
    let mut binders = List<usize>.make()
    run List<usize>.append(&mut binders, 31 + at)
    run List<Event>.append(&mut events, Event {point: binding.index + at,
      place: Place {root: 0, steps: List<Step>.make()}, kind: Kind.Read,
      span: Location.make(0, 1), target: Location.make(0, 1), loan: usize.MAX, consumesTarget: 0,
      refiner: usize.MAX, refinedDepth: 0, binders: move binders})
    at = at + usize.ONE
  }
  let mut views = List<SourceViewHold>.make()
  run List<SourceViewHold>.append(&mut views, SourceViewHold {
    loan: 0, active: yes, source: SourceGraph.EvalId {index: 31},
    scope: SourceVisit.ScopeId {index: 0}, point: acquired, extents: List<SourceViewExtent>.make()})
  let mut extent = List<SourceViewExtent>.make()
  run List<SourceViewExtent>.append(&mut extent, SourceViewExtent {from: acquired, to: never})
  run List<SourceViewHold>.append(&mut views, SourceViewHold {
    loan: 1, active: yes, source: SourceGraph.EvalId {index: 77},
    scope: SourceVisit.ScopeId {index: 0}, point: acquired, extents: move extent})
  run List<SourceViewHold>.append(&mut views, SourceViewHold {
    loan: 2, active: maybe, source: SourceGraph.EvalId {index: 88},
    scope: SourceVisit.ScopeId {index: 0}, point: acquired, extents: List<SourceViewExtent>.make()})
  let exits: [SourceVisit.ScopeExit; 1] = [SourceVisit.ScopeExit {scope: SourceVisit.ScopeId {index: 0},
    point: ended, cause: NodeId {index: 0}, kind: SourceVisitExitKind.Normal}]
  let eventGates = List<SourceEventGate>.make()
  let projected = run sourceViewProjection(&control, List<SourceViewHold>.asSlice(&views),
    List<Event>.asSlice(&events), List<SourceEventGate>.asSlice(&eventGates), &exits, &mut rules)
  let result = run SourceProgram.solve(&rules)
  let all = List<SourceLifetimeProjection>.asSlice(&projected)
  let ordinary = List<SourceAtom>.asSlice(&all[0].live)
  run Testing.expect(SourceSolution.truth(&result, ordinary[branch.index]) == SourceTruth.Undefined,
    "an unresolved binding-use edge remains unresolved view liveness at its predecessor")
  run Testing.expect(SourceSolution.truth(&result, ordinary[sibling.index]) == SourceTruth.False
    && SourceSolution.truth(&result, ordinary[entry.index]) == SourceTruth.False,
    "another actual subject's use and the next acquisition on a backedge cannot keep this view live")
  run Testing.expect(SourceSolution.truth(&result, List<SourceAtom>.asSlice(&all[1].live)[branch.index]) == SourceTruth.True
    && SourceSolution.truth(&result, List<SourceAtom>.asSlice(&all[1].ends)[branch.index]) == SourceTruth.False,
    "a view's ordinary arm extent survives later noncompletion without inventing a reachable owner-end path")
  run Testing.expect(SourceSolution.truth(&result, List<SourceAtom>.asSlice(&all[0].occupied)[sibling.index]) == SourceTruth.True
    && SourceSolution.truth(&result, List<SourceAtom>.asSlice(&all[0].released)[ended.index]) == SourceTruth.True
    && SourceSolution.truth(&result, List<SourceAtom>.asSlice(&all[0].survives)[ended.index]) == SourceTruth.False,
    "a view still retains its source after its last binding read and ends only at its actual scope exit")
  run Testing.expect(SourceSolution.truth(&result, List<SourceAtom>.asSlice(&all[0].occupied)[entry.index]) == SourceTruth.False
    && SourceSolution.truth(&result, List<SourceAtom>.asSlice(&all[0].released)[never.index]) == SourceTruth.False,
    "neither pre-acquisition absence nor unreachable completion is an actual view release")
  run Testing.expect(SourceSolution.truth(&result, List<SourceAtom>.asSlice(&all[2].occupied)[sibling.index]) == SourceTruth.Undefined
    && SourceSolution.truth(&result, List<SourceAtom>.asSlice(&all[2].released)[ended.index]) == SourceTruth.Undefined,
    "unresolved carried-view activity cannot certify either absence or release")
  return ()
}

test effect fn callableBindingLifetimeSurvivesPhysicalReplacementAndStopsAtOwnerEnd() -> ()
! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run sourceCallableLifetimeClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn sourceCallableLifetimeClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut rules = SourceProgram.make()
  let yes = run sourceBoolean(&mut rules, true)
  let no = SourceProgram.atom(&mut rules)
  let mut flow = SourceControlFlow.make()
  let entry = run SourceControlFlow.point(&mut flow, &mut rules)
  let bound = run SourceControlFlow.point(&mut flow, &mut rules)
  let replaced = run SourceControlFlow.point(&mut flow, &mut rules)
  let used = run SourceControlFlow.point(&mut flow, &mut rules)
  let ended = run SourceControlFlow.point(&mut flow, &mut rules)
  let after = run SourceControlFlow.point(&mut flow, &mut rules)
  run SourceProgram.fact(&mut rules, SourceControlFlow.reachable(&flow, entry))
  run SourceControlFlow.edge(&mut flow, entry, bound, yes)
  run SourceControlFlow.edge(&mut flow, bound, replaced, yes)
  run SourceControlFlow.edge(&mut flow, replaced, used, yes)
  run SourceControlFlow.edge(&mut flow, used, ended, yes)
  run SourceControlFlow.edge(&mut flow, ended, after, yes)
  let component = SourceControl.ComponentId {index: 0}
  let original = run SourceControlFlow.define(&mut flow, bound, component, yes, SourceControlWrite.Strong)
  drop run SourceControlFlow.define(&mut flow, replaced, component, yes, SourceControlWrite.Strong)
  let control = run SourceControlFlow.emit(move flow, &mut rules)
  let owners: [SourceVisit.Owner; 1] = [SourceVisit.Owner {root: SourceVisitOwnerRoot.Local {local: LocalId {index: 0}},
    scope: SourceVisit.ScopeId {index: 0}, initialized: bound}]
  let owner = SourceVisit.OwnerId {index: 0}
  let exits: [SourceVisit.OwnerExit; 1] = [SourceVisit.OwnerExit {owner: owner, action: SourceVisitOwnerAction.End,
    point: ended, cause: NodeId {index: 0}, read: Option<SourceGraph.EvalId>.none()}]
  let storage = SourceGraph.Storage {endpoint: PreparedSources.EndpointId {index: 0}, temporary: Option<SourceGraph.EvalId>.none()}
  let mut holders = SourceHolderProjection {reads: List<SourceSemanticRead>.make(), requests: List<SourceHolderRequest>.make(), uses: List<SourceHolderUse>.make(), missing: no}
  run List<SourceHolderRequest>.append(&mut holders.requests, SourceHolderRequest {dispatch: 1, owner: Option<SourceVisit.OwnerId>.some(owner),
    evaluation: SourceGraph.EvalId {index: 0}, root: storage.endpoint, point: used, active: yes})
  run List<SourceHolderUse>.append(&mut holders.uses, SourceHolderUse {request: 0, storage: storage, active: yes})
  let projected = run sourceCallableLifetime(&control, original, owner, &owners, &exits, &holders,
    storage, bound, 0, yes, &mut rules)
  let result = run SourceProgram.solve(&rules)
  run Testing.expect(SourceSolution.truth(&result, SourceControlReaching.enters(&control, used, original)) == SourceTruth.False
    && SourceSolution.truth(&result, List<SourceAtom>.asSlice(&projected.live)[replaced.index]) == SourceTruth.True
    && SourceSolution.truth(&result, List<SourceAtom>.asSlice(&projected.required)[used.index]) == SourceTruth.True,
    "a later same-owner use retains the original callable binding without restoring its killed physical source")
  run Testing.expect(SourceSolution.truth(&result, List<SourceAtom>.asSlice(&projected.released)[ended.index]) == SourceTruth.True
    && SourceSolution.truth(&result, List<SourceAtom>.asSlice(&projected.occupied)[after.index]) == SourceTruth.False
    && SourceSolution.truth(&result, List<SourceAtom>.asSlice(&projected.live)[entry.index]) == SourceTruth.False,
    "binding lifetime neither precedes its acquisition nor survives its actual owner end")
  return ()
}

test effect fn resultPlacementKeepsContinuationRootsAndStopsAtBoundaries() -> ()
! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run sourcePlacementClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn sourcePlacementClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  // The classifier consumes prepared component coordinates only; it performs no type
  // queries. Two continuation roots can reach the same current state at different depths.
  let ty = run Shared<Type>.make(Type.Unit)
  let mut components = List<PreparedSources.Component>.make()
  run List<PreparedSources.Component>.append(&mut components, PreparedSources.Component {
    selector: PreparedSourcesSelector.Field {ordinal: 7}, ty: Shared<Type>.clone(&ty), inline: true,
    representation: Option<PreparedSources.RepresentationId>.none()})
  run List<PreparedSources.Component>.append(&mut components, PreparedSources.Component {
    selector: PreparedSourcesSelector.Field {ordinal: 8}, ty: Shared<Type>.clone(&ty), inline: true,
    representation: Option<PreparedSources.RepresentationId>.none()})
  run List<PreparedSources.Component>.append(&mut components, PreparedSources.Component {
    selector: PreparedSourcesSelector.Referent, ty: Shared<Type>.clone(&ty), inline: false,
    representation: Option<PreparedSources.RepresentationId>.none()})
  let mut shapes = List<PreparedSources.Shape>.make()
  run List<PreparedSources.Shape>.append(&mut shapes, PreparedSources.Shape {context: PreparedSourcesShapeContext.Body,
    ty: move ty, state: PreparedSourcesShapeState.Inline, components: move components})
  let mut paths = List<List<Step>>.make()
  run List<List<Step>>.append(&mut paths, List<Step>.make())
  let direct = SourceResultsPosition.Contract {output: PreparedSources.MapId {index: 0}, projection: PreparedSources.ContractProjectionId {index: 0},
    root: PreparedSources.ContractContinuationId {index: 1}, current: PreparedSources.ContractContinuationId {index: 1}}
  let first = SourceResultsPosition.Contract {output: PreparedSources.MapId {index: 0}, projection: PreparedSources.ContractProjectionId {index: 0},
    root: PreparedSources.ContractContinuationId {index: 0}, current: PreparedSources.ContractContinuationId {index: 0}}
  let nested = SourceResultsPosition.Contract {output: PreparedSources.MapId {index: 0}, projection: PreparedSources.ContractProjectionId {index: 0},
    root: PreparedSources.ContractContinuationId {index: 0}, current: PreparedSources.ContractContinuationId {index: 1}}
  let mut next = List<SourceResultsPosition>.make()
  run List<SourceResultsPosition>.append(&mut next, nested)
  let mut steps = List<SourceResults.PlacementStep>.make()
  run List<SourceResults.PlacementStep>.append(&mut steps, SourceResults.PlacementStep {position: direct,
    state: PreparedSources.ResidualStateId {index: 1}, component: PreparedSources.ComponentId {shape: PreparedSources.ShapeId {index: 0}, ordinal: 1},
    next: List<SourceResultsPosition>.make()})
  run List<SourceResults.PlacementStep>.append(&mut steps, SourceResults.PlacementStep {position: first,
    state: PreparedSources.ResidualStateId {index: 0}, component: PreparedSources.ComponentId {shape: PreparedSources.ShapeId {index: 0}, ordinal: 0}, next: move next})
  run List<SourceResults.PlacementStep>.append(&mut steps, SourceResults.PlacementStep {position: nested,
    state: PreparedSources.ResidualStateId {index: 1}, component: PreparedSources.ComponentId {shape: PreparedSources.ShapeId {index: 0}, ordinal: 1},
    next: List<SourceResultsPosition>.make()})
  let roots: [SourceResultsPosition; 2] = [direct, first]
  let targets: [SourceResultsPosition; 2] = [direct, nested]
  let shallow = run sourceSelectedField(List<PreparedSources.Shape>.asSlice(&shapes), &roots, &targets,
    List<SourceResults.PlacementStep>.asSlice(&steps), direct, 0, &mut paths)
  let deep = run sourceSelectedField(List<PreparedSources.Shape>.asSlice(&shapes), &roots, &targets,
    List<SourceResults.PlacementStep>.asSlice(&steps), nested, 0, &mut paths)
  let shallowPath = List<Step>.asSlice(&List<List<Step>>.asSlice(&paths)[shallow])
  let deepPath = List<Step>.asSlice(&List<List<Step>>.asSlice(&paths)[deep])
  run Testing.expect(shallowPath.length == 1 && sameStep(shallowPath[0], fieldStep(8))
    && deepPath.length == 2 && sameStep(deepPath[0], fieldStep(7)) && sameStep(deepPath[1], fieldStep(8)),
    "equal current states under distinct roots retain different exact selected output paths")
  let same = run copySteps(shallowPath)
  if true {
    let mut mutated = List<SourceResults.PlacementStep>.asMutSlice(&mut steps)
    mutated[1].component.ordinal = 2
  }
  let boundary = run sourceSelectedField(List<PreparedSources.Shape>.asSlice(&shapes), &roots, &targets,
    List<SourceResults.PlacementStep>.asSlice(&steps), nested, 0, &mut paths)
  run Testing.expect(boundary == usize.MAX,
    "a selected path through a noninline referent cannot become an owned field or whole anchor")
  let mut joined = Option<usize>.some(shallow)
  let duplicate = List<List<Step>>.length(&paths)
  run List<List<Step>>.append(&mut paths, move same)
  run Testing.expect(!sourceMergeField(List<List<Step>>.asSlice(&paths), &mut joined, duplicate),
    "alternate histories of an equal physical path do not become ambiguous placement or additional inputs")
  return ()
}

test effect fn resultSnapshotsCountActualSourcesAndRetainUnresolvedGuards() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run sourceSnapshotClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn sourceSnapshotClaims() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let module = run ModuleId.make(b"test", b"source", b"result-snapshot.silk")
  let owner = run DeclarationId.fromParts(move module, List<OwnerStep>.make())
  let first = run Shared<Lifetime>.make(Lifetime.Local {declaration: DeclarationId.copy(&owner), ordinal: 0})
  let second = run Shared<Lifetime>.make(Lifetime.Local {declaration: DeclarationId.copy(&owner), ordinal: 1})
  let caller = run Shared<Lifetime>.make(Lifetime.Parameter {declaration: DeclarationId.copy(&owner), ordinal: 0})
  let mut loans = List<Loan>.make()
  run List<Loan>.append(&mut loans, run symbolicTestLoan(&first, &caller, true))
  run List<Loan>.append(&mut loans, run symbolicTestLoan(&second, &first, true))
  let mut nodes = List<Node>.make()
  let unit = run Shared<Type>.make(Type.Unit)
  let ty = run Shared<Type>.make(Type.Reference {referent: move unit, access: Access.Shared,
    lifetime: Shared<Lifetime>.clone(&first)})
  run List<Node>.append(&mut nodes, Node {origin: Origin {node: 0, location: Location.make(0, 1)},
    kind: NodeKind.Expression {ty: move ty, form: Expression.Local {local: LocalId {index: 0}}}})
  let mut named = List<Shared<Lifetime>>.make()
  run List<Shared<Lifetime>>.append(&mut named, Shared<Lifetime>.clone(&first))
  let emptyRegions = List<Shared<Lifetime>>.make()
  let edges: [RetentionEdge; 1] = [RetentionEdge {source: 1, extent: 0}]
  let mut rules = SourceProgram.make()
  let yes = SourceProgram.atom(&mut rules)
  let no = SourceProgram.atom(&mut rules)
  let unresolved = SourceProgram.atom(&mut rules)
  let opposite = SourceProgram.atom(&mut rules)
  run SourceProgram.fact(&mut rules, yes)
  let none = List<SourceAtom>.make()
  let notOpposite: [SourceAtom; 1] = [opposite]
  let notUnresolved: [SourceAtom; 1] = [unresolved]
  run SourceProgram.rule(&mut rules, unresolved, List<SourceAtom>.asSlice(&none), &notOpposite)
  run SourceProgram.rule(&mut rules, opposite, List<SourceAtom>.asSlice(&none), &notUnresolved)
  let mut statuses = List<SourceAtom>.make()
  run List<SourceAtom>.append(&mut statuses, no)
  run List<SourceAtom>.append(&mut statuses, yes)
  run List<SourceAtom>.append(&mut statuses, unresolved)
  let mut snapshots = List<SourceResultSnapshot>.make()
  let mut decisions = List<SourcePolicy.ResultOutput>.make()
  let mut missingResults = List<SourceAtom>.make()
  let noRelations = List<ImpliedGroup>.make()
  let states = List<SourceAtom>.asSlice(&statuses)
  let mut at = usize.ZERO
  while at < states.length {
    let inputs: [SourceResultInput; 2] = [
      SourceResultInput {loan: 0, operand: 0, quality: SourceQuality {present: yes, stored: no, alternatives: no}},
      SourceResultInput {loan: 1, operand: 0, quality: SourceQuality {present: states[at], stored: no, alternatives: no}},
    ]
    let snapshot = run sourceResultSnapshot(List<Node>.asSlice(&nodes),
      &owner, List<Shared<Lifetime>>.asSlice(&emptyRegions), List<Loan>.asSlice(&loans), &inputs,
      List<Shared<Lifetime>>.asSlice(&named), &edges, NodeId {index: 0}, true, false, false, &mut rules)
    let actual = SourceResultCase {quality: inputs[1].quality, operand: 0, retained: false,
      field: 0, wholeField: true, declared: no}
    let facts = SourceResultFacts {known: true, stores: false, outside: false, forwarding: Forwarding.Operands,
      placedCount: 1, impliedKnown: no, mayOutlive: no, hasTyped: false}
    let decision = run sourceResultDecision(
      &List<Loan>.asSlice(&loans)[1], &actual, &facts, &snapshot, 1, &owner,
      List<Shared<Lifetime>>.asSlice(&named), List<ImpliedGroup>.asSlice(&noRelations), &mut rules)
    run List<SourceAtom>.append(&mut missingResults,
      run sourceResultCoverage(&mut rules, decision.kept, List<SourceAtom>.asSlice(&none)))
    run List<SourcePolicy.ResultOutput>.append(&mut decisions, move decision)
    run List<SourceResultSnapshot>.append(&mut snapshots, move snapshot)
    at = at + usize.ONE
  }
  // A conditional signature edge may complete a transitive route only on histories where
  // that earlier whole hold applies. The second, definite edge cannot erase that guard.
  let mut guardedGroups = List<SourceImpliedGroup>.make()
  let mut firstMembers = List<Shared<Lifetime>>.make()
  run List<Shared<Lifetime>>.append(&mut firstMembers, Shared<Lifetime>.clone(&first))
  let mut firstTargets = List<Shared<Lifetime>>.make()
  run List<Shared<Lifetime>>.append(&mut firstTargets, Shared<Lifetime>.clone(&second))
  run List<SourceImpliedGroup>.append(&mut guardedGroups, SourceImpliedGroup {
    group: ImpliedGroup {members: move firstMembers, container: move firstTargets}, active: unresolved})
  let mut secondMembers = List<Shared<Lifetime>>.make()
  run List<Shared<Lifetime>>.append(&mut secondMembers, Shared<Lifetime>.clone(&second))
  let mut secondTargets = List<Shared<Lifetime>>.make()
  run List<Shared<Lifetime>>.append(&mut secondTargets, Shared<Lifetime>.clone(&caller))
  run List<SourceImpliedGroup>.append(&mut guardedGroups, SourceImpliedGroup {
    group: ImpliedGroup {members: move secondMembers, container: move secondTargets}, active: yes})
  let origin: [Shared<Lifetime>; 1] = [Shared<Lifetime>.clone(&first)]
  let conditionalEscape = run sourceMayOutlive(List<SourceImpliedGroup>.asSlice(&guardedGroups), &origin,
    List<Shared<Lifetime>>.asSlice(&emptyRegions), &owner, &mut rules)
  if true {
    let mut groups = List<SourceImpliedGroup>.asMutSlice(&mut guardedGroups)
    groups[0].active = no
  }
  let absentEscape = run sourceMayOutlive(List<SourceImpliedGroup>.asSlice(&guardedGroups), &origin,
    List<Shared<Lifetime>>.asSlice(&emptyRegions), &owner, &mut rules)
  let solved = run SourceProgram.solve(&rules)
  run Testing.expect(SourceSolution.truth(&solved, conditionalEscape) == SourceTruth.Undefined
    && SourceSolution.truth(&solved, absentEscape) == SourceTruth.False,
    "field-release implication preserves unresolved and absent earlier whole-hold applicability through transitive paths")
  let results = List<SourceResultSnapshot>.asSlice(&snapshots)
  run Testing.expect(SourceSolution.truth(&solved, List<SourceAtom>.asSlice(&results[0].required)[1]) == SourceTruth.False
    && SourceSolution.truth(&solved, List<SourceAtom>.asSlice(&results[0].parents)[0]) == SourceTruth.False
    && SourceSolution.truth(&solved, results[0].complete) == SourceTruth.False,
    "a nonreaching historical definition supplies neither the missing-source gate nor the second actual carry")
  run Testing.expect(SourceSolution.truth(&solved, List<SourceAtom>.asSlice(&results[1].required)[1]) == SourceTruth.True
    && SourceSolution.truth(&solved, List<SourceAtom>.asSlice(&results[1].parents)[0]) == SourceTruth.True
    && SourceSolution.truth(&solved, results[1].complete) == SourceTruth.True,
    "the genuine second source activates pending retention and the original multiple-source snapshot guards")
  run Testing.expect(SourceSolution.truth(&solved, List<SourceAtom>.asSlice(&results[2].required)[1]) == SourceTruth.Undefined
    && SourceSolution.truth(&solved, results[2].complete) == SourceTruth.Undefined,
    "unresolved source applicability remains unresolved instead of selecting an eager complete-source proof")
  let retained = List<SourcePolicy.ResultOutput>.asSlice(&decisions)
  let missing = List<SourceAtom>.asSlice(&missingResults)
  run Testing.expect(SourceSolution.truth(&solved, missing[0]) == SourceTruth.False
    && SourceSolution.truth(&solved, missing[1]) == SourceTruth.True
    && SourceSolution.truth(&solved, missing[2]) == SourceTruth.Undefined,
    "zero result candidates remain missing coverage for retained or unresolved inputs, distinct from a grounded absent-source decision")
  run Testing.expect(SourceSolution.truth(&solved, retained[0].kept) == SourceTruth.False
    && SourceSolution.truth(&solved, retained[1].kept) == SourceTruth.True
    && SourceSolution.truth(&solved, retained[1].addStored) == SourceTruth.False
    && SourceSolution.truth(&solved, retained[1].addAlternatives) == SourceTruth.False
    && SourceSolution.truth(&solved, retained[2].kept) == SourceTruth.Undefined,
    "the result policy consumes actual required-source evidence without preserving a killed source or downgrading its proved placement")
  return ()
}

test effect fn sourceRetentionUsesPairedCasesAndOperationPoint() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run sourceRetentionClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn sourceRetentionClaims() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let owner = run capturedTestOwner(b"source-retention.silk", 0)
  let region = run Shared<Lifetime>.make(Lifetime.Local {declaration: DeclarationId.copy(&owner), ordinal: 0})
  let parent = run Shared<Lifetime>.make(Lifetime.Static)
  let mut loans = List<Loan>.make()
  run List<Loan>.append(&mut loans, run symbolicTestLoan(&region, &parent, true))
  let mut rules = SourceProgram.make()
  let yes = run sourceBoolean(&mut rules, true)
  let no = SourceProgram.atom(&mut rules)
  let quality = SourceQuality {present: yes, stored: no, alternatives: no}
  let mut cases = List<SourceCarryCase>.make()
  let mut each = usize.ZERO
  while each < 2 {
    let mut category = SourceGraphSourceRole.Ownership
    if each == usize.ZERO { category = SourceGraphSourceRole.Physical }
    run List<SourceCarryCase>.append(&mut cases, SourceCarryCase {field: 0, observed: yes, publication: Option<usize>.none(),
      source: SourceGraph.InputCase {case: each, category: category, source: Option<SourceGraph.ValueId>.none(),
        placement: PreparedSources.EndpointId {index: 0}, direct: each == usize.ZERO,
        definition: Option<SourceControl.DefinitionId>.some(SourceControl.DefinitionId {index: 3 + each}),
        read: Option<SourceControl.ReadId>.some(SourceControl.ReadId {index: 5}),
        map: Option<PreparedSources.MapId>.none(), direction: SourceGraphMapDirection.Forward,
        address: Option<SourceGraph.EvalId>.none(), contract: Option<PreparedSources.ContractRouteId>.none(),
        quality: SourceGraph.Cell {present: yes, stored: no, alternatives: no}}})
    each = each + usize.ONE
  }
  let mut positions = List<SourceCarryPosition>.make()
  run List<SourceCarryPosition>.append(&mut positions, SourceCarryPosition {
    node: NodeId {index: 0}, root: PreparedSources.EndpointId {index: 0}, value: SourceGraph.ValueId {index: 2}, leaf: SourceGraph.LeafId {index: 0}, loan: 0,
    operand: 0, since: 8, quality: quality, cases: move cases})
  let observation = SourceObservation {positions: move positions, other: List<SourceGraph.Input>.make(), unknown: no}
  let mut paths = List<List<Step>>.make()
  run List<List<Step>>.append(&mut paths, List<Step>.make())
  let mut slots = List<SlotSink>.make()
  run List<SlotSink>.append(&mut slots, SlotSink {path: List<KeptStep>.make(), view: true,
    referent: run Shared<Type>.make(Type.Unit), exclusive: false, kept: CallSink.Universal, approximate: CallSink.Local})
  let mut sinks = List<OperandSink>.make()
  run List<OperandSink>.append(&mut sinks, OperandSink {outer: CallSink.Local, whole: CallSink.Unknown,
    outerApproximate: CallSink.Local, wholeApproximate: CallSink.Local, span: Location.make(10, 11),
    holds: true, view: Option<Shared<Lifetime>>.none(), slots: move slots, undescribed: false})
  let mut state = run SourceLoanState.make(&mut rules, 1)
  // An earlier operand can complete although a later operand prevents this operation from
  // executing. Its potential Q losses must not enter P through this skipped observation.
  let mut skippedPositions = List<SourceCarryPosition>.make()
  run List<SourceCarryPosition>.append(&mut skippedPositions, SourceCarryPosition {
    node: NodeId {index: 0}, root: PreparedSources.EndpointId {index: 0}, value: SourceGraph.ValueId {index: 2},
    leaf: SourceGraph.LeafId {index: 0}, loan: 0, operand: 0, since: 8,
    quality: SourceQuality {present: yes, stored: yes, alternatives: yes}, cases: List<SourceCarryCase>.make()})
  let skipped = SourceObservation {positions: move skippedPositions, other: List<SourceGraph.Input>.make(), unknown: no}
  let skippedSnapshot = run sourceBarrier(&skipped, &mut state, no, &mut rules)
  let snapshot = run sourceBarrier(&observation, &mut state, yes, &mut rules)
  let kept = run sourceKeepCarried(&observation, List<SourceQuality>.asSlice(&snapshot), List<Loan>.asSlice(&loans),
    List<List<Step>>.asSlice(&paths), &owner, List<OperandSink>.asSlice(&sinks), usize.MAX, 9, yes, &mut rules)
  let absent = run sourceKeepCarried(&observation, List<SourceQuality>.asSlice(&snapshot), List<Loan>.asSlice(&loans),
    List<List<Step>>.asSlice(&paths), &owner, List<OperandSink>.asSlice(&sinks), usize.MAX, 9, no, &mut rules)
  let mut intervals = List<SourceIntervalEffect>.make()
  run sourceConsume(&observation, 9, yes, &mut rules, &mut intervals)
  let noNodes = List<Node>.make()
  let noEdges = List<RetentionEdge>.make()
  let noRelations = List<ImpliedGroup>.make()
  let noHolds = List<SourceWholeHold>.make()
  let noRegions = List<Shared<Lifetime>>.make()
  let noPriorRelease = run sourceUnreachableField(List<Node>.asSlice(&noNodes), &owner, List<Loan>.asSlice(&loans),
    &observation, List<SourceQuality>.asSlice(&snapshot), 0, List<RetentionEdge>.asSlice(&noEdges),
    List<ImpliedGroup>.asSlice(&noRelations), true, List<SourceWholeHold>.asSlice(&noHolds),
    List<Shared<Lifetime>>.asSlice(&noRegions), &mut rules)
  // A projected reference keeps its semantic Referent suffix, while a disjoint sibling
  // is absent from the selected value but still identifies the terminal port to drop.
  let contained: [Step; 3] = [fieldStep(7), referent(), fieldStep(2)]
  let siblingPath: [Step; 1] = [fieldStep(8)]
  let selectedPath: [Step; 1] = [fieldStep(7)]
  let containedField = List<List<Step>>.length(&paths)
  run List<List<Step>>.append(&mut paths, run copySteps(&contained))
  let siblingField = List<List<Step>>.length(&paths)
  run List<List<Step>>.append(&mut paths, run copySteps(&siblingPath))
  let originalPosition = &List<SourceCarryPosition>.asSlice(&observation.positions)[0]
  let histories = List<SourceCarryCase>.asSlice(&originalPosition.cases)
  let mut policyCases = List<SourceGraph.InputCase>.make()
  run List<SourceGraph.InputCase>.append(&mut policyCases, run sourceGatedCase(&histories[1].source, yes, &mut rules))
  let mut candidate = run sourceGatedCase(&histories[1].source, yes, &mut rules)
  run Testing.expect(candidate.case == 1 && candidate.category == SourceGraphSourceRole.Ownership
    && sourcePolicyCase(List<SourceGraph.InputCase>.asSlice(&policyCases), &candidate),
    "gating preserves the exact ownership Case for a terminal policy")
  candidate.case = 9
  run Testing.expect(!sourcePolicyCase(List<SourceGraph.InputCase>.asSlice(&policyCases), &candidate),
    "an equal raw witness cannot substitute another incoming Case")
  candidate.case = 1
  candidate.category = SourceGraphSourceRole.Physical
  run Testing.expect(!sourcePolicyCase(List<SourceGraph.InputCase>.asSlice(&policyCases), &candidate),
    "a physical descriptor cannot authenticate an ownership history")
  // One shared Input does not identify its canonical read. The summary belongs only
  // to its retained original read, even when both callers observe this same value/leaf.
  let summaries: [SourceGraph.SummaryRead; 1] = [SourceGraph.SummaryRead {summary: 0,
    original: SourceControl.ReadId {index: 7}, read: SourceControl.ReadId {index: 5},
    target: originalPosition.value, active: yes}]
  run Testing.expect(sourceAcquisitionHistory(&summaries, SourceControl.ReadId {index: 5}, &histories[0].source),
    "an acquisition observes its exact physical read")
  run Testing.expect(sourceAcquisitionHistory(&summaries, SourceControl.ReadId {index: 7}, &histories[0].source),
    "an acquisition observes a summary paired with its original read")
  run Testing.expect(!sourceAcquisitionHistory(&summaries, SourceControl.ReadId {index: 8}, &histories[0].source),
    "a shared Input cannot substitute another canonical acquisition read")
  let mut unpaired = run sourceGatedCase(&histories[0].source, yes, &mut rules)
  unpaired.read = Option<SourceControl.ReadId>.none()
  run Testing.expect(!sourceAcquisitionHistory(&summaries, SourceControl.ReadId {index: 7}, &unpaired),
    "a history without its read cannot certify acquisition contents")
  let mut selectedHistories = List<SourceCarryCase>.make()
  run List<SourceCarryCase>.append(&mut selectedHistories,
    sourceCase(run sourceGatedCase(&histories[0].source, yes, &mut rules), containedField))
  run List<SourceCarryCase>.append(&mut selectedHistories,
    sourceCase(run sourceGatedCase(&histories[1].source, yes, &mut rules), siblingField))
  let mut selectedPositions = List<SourceCarryPosition>.make()
  run List<SourceCarryPosition>.append(&mut selectedPositions, SourceCarryPosition {
    node: originalPosition.node, root: originalPosition.root, value: originalPosition.value, leaf: originalPosition.leaf,
    loan: originalPosition.loan, operand: originalPosition.operand, since: originalPosition.since, quality: quality, cases: move selectedHistories})
  let mut selectedObservation = SourceObservation {positions: move selectedPositions, other: List<SourceGraph.Input>.make(), unknown: no}
  let path = Path {root: usize.MAX, through: false, steps: run copySteps(&selectedPath), indexes: List<NodeId>.make(),
    refiner: usize.MAX, refinedDepth: usize.ZERO, binders: List<usize>.make()}
  let declared = DeclaredRead {known: false, regions: List<Shared<Lifetime>>.make()}
  let context = RetentionContext {requirements: List<RetentionEdge>.make(), relations: List<ImpliedGroup>.make(),
    openContents: List<Shared<Lifetime>>.make(), settled: true}
  run sourceSelectFields(List<Node>.asSlice(&noNodes), &owner, &path, &declared, &mut selectedObservation,
    &mut state, List<Loan>.asSlice(&loans), &mut paths, &context, List<SourceWholeHold>.asSlice(&noHolds), yes, &mut rules)
  // Reserve IDs in a different order from execution. The early read supplies the call;
  // its holder is then replaced before an event. A sibling branch never executes the call.
  let mut control = SourceControlFlow.make()
  let entry = run SourceControlFlow.point(&mut control, &mut rules)
  let readPoint = run SourceControlFlow.point(&mut control, &mut rules)
  let callPoint = run SourceControlFlow.point(&mut control, &mut rules)
  let sibling = run SourceControlFlow.point(&mut control, &mut rules)
  let replacePoint = run SourceControlFlow.point(&mut control, &mut rules)
  let eventPoint = run SourceControlFlow.point(&mut control, &mut rules)
  let uncertainPoint = run SourceControlFlow.point(&mut control, &mut rules)
  let undefined = SourceProgram.atom(&mut rules)
  let denied: [SourceAtom; 1] = [undefined]
  let none = List<SourceAtom>.make()
  run SourceProgram.rule(&mut rules, undefined, List<SourceAtom>.asSlice(&none), &denied)
  run SourceProgram.fact(&mut rules, SourceControlFlow.reachable(&control, entry))
  run SourceControlFlow.edge(&mut control, entry, readPoint, yes)
  run SourceControlFlow.edge(&mut control, readPoint, callPoint, yes)
  run SourceControlFlow.edge(&mut control, entry, sibling, yes)
  run SourceControlFlow.edge(&mut control, callPoint, replacePoint, yes)
  run SourceControlFlow.edge(&mut control, replacePoint, eventPoint, yes)
  run SourceControlFlow.edge(&mut control, eventPoint, uncertainPoint, undefined)
  let component = SourceControl.ComponentId {index: 0}
  let lateRead = run SourceControlFlow.read(&mut control, eventPoint, component)
  let earlyRead = run SourceControlFlow.read(&mut control, readPoint, component)
  drop run SourceControlFlow.define(&mut control, replacePoint, component, yes, SourceControlWrite.Strong)
  let original = run SourceControlFlow.define(&mut control, entry, component, yes, SourceControlWrite.Strong)
  let reaching = run SourceControlFlow.emit(move control, &mut rules)
  let before = match sourceFlowPair(&reaching, original, earlyRead) {
    Option<SourceAtom>.Some {value} => value
    _ => { return CompilerBug.panic(b"caller test lost its original early read pair") }
  }
  let after = match sourceFlowPair(&reaching, original, lateRead) {
    Option<SourceAtom>.Some {value} => value
    _ => { return CompilerBug.panic(b"caller test lost its killed late read pair") }
  }
  let retainedReach = run sourceOperationReach(&reaching, callPoint.index, &mut rules)
  let solved = run SourceProgram.solve(&rules)
  let selected = &List<SourceCarryPosition>.asSlice(&selectedObservation.positions)[0]
  let selectedCases = List<SourceCarryCase>.asSlice(&selected.cases)
  let suffix = List<Step>.asSlice(&List<List<Step>>.asSlice(&paths)[selectedCases[0].field])
  run Testing.expect(suffix.length == 2 && suffix[0].kind == StepKind.Referent
    && suffix[1].kind == StepKind.Field && suffix[1].ordinal == 2
    && SourceSolution.truth(&solved, selectedCases[0].source.quality.present) == SourceTruth.True,
    "field projection strips its selected prefix once and preserves the reference-held suffix")
  run Testing.expect(SourceSolution.truth(&solved, selectedCases[1].source.quality.present) == SourceTruth.False
    && SourceSolution.truth(&solved, selectedCases[1].observed) == SourceTruth.True
    && sourceDefinitionMatches(selectedCases[1].source.definition, histories[1].source.definition)
    && sourceReadMatches(selectedCases[1].source.read, histories[1].source.read)
    && SourceSolution.truth(&solved, selected.quality.present) == SourceTruth.True,
    "a disjoint history drops without erasing its paired port or another history at the same position")
  let reached = List<SourceAtom>.asSlice(&retainedReach.at)
  run Testing.expect(sourceCallerTruth(SourceSolution.truth(&solved, before), SourceTruth.False,
    SourceSolution.truth(&solved, reached[eventPoint.index])) == CallerSource.Actual
    && sourceCallerTruth(SourceSolution.truth(&solved, after), SourceTruth.False,
      SourceSolution.truth(&solved, reached[eventPoint.index])) == CallerSource.Absent,
    "caller retention authenticates its operand read before replacement, not the holder at the later access or ID order")
  run Testing.expect(sourceCallerTruth(SourceSolution.truth(&solved, before), SourceTruth.False,
    SourceSolution.truth(&solved, reached[sibling.index])) == CallerSource.Absent,
    "an actual source retained on one branch does not keep a loan live on a sibling branch")
  run Testing.expect(sourceCallerTruth(SourceSolution.truth(&solved, before), SourceTruth.False,
    SourceSolution.truth(&solved, reached[uncertainPoint.index])) == CallerSource.Unknown
    && sourceCallerTruth(SourceTruth.False, SourceTruth.True, SourceTruth.True) == CallerSource.Unknown,
    "unresolved operation applicability and missing source evidence cannot become a concrete conflict or an absence proof")
  run Testing.expect(!sourceSameStorage(SourceGraph.Storage {endpoint: PreparedSources.EndpointId {index: 0},
    temporary: Option<SourceGraph.EvalId>.some(SourceGraph.EvalId {index: 0})},
    SourceGraph.Storage {endpoint: PreparedSources.EndpointId {index: 0},
      temporary: Option<SourceGraph.EvalId>.some(SourceGraph.EvalId {index: 1})}),
    "repeated temporary acquisitions with equal endpoint paths are distinct canonical storage")
  run Testing.expect(SourceSolution.truth(&solved, noPriorRelease) == SourceTruth.False,
    "an exact body source with no prior whole hold cannot gain an empty universal field-release proof")
  let skippedQuality = List<SourceQuality>.asSlice(&skippedSnapshot)[0]
  run Testing.expect(SourceSolution.truth(&solved, skippedQuality.present) == SourceTruth.False
    && SourceSolution.truth(&solved, skippedQuality.stored) == SourceTruth.False
    && SourceSolution.truth(&solved, skippedQuality.alternatives) == SourceTruth.False,
    "an operation that does not execute imports no precision loss from an earlier completed operand")
  let actual = List<SourceRetentionEffect>.asSlice(&kept)
  let inactive = List<SourceRetentionEffect>.asSlice(&absent)
  let flights = List<SourceIntervalEffect>.asSlice(&intervals)
  run Testing.expect(actual.length == 2 && inactive.length == 2 && flights.length == 2,
    "two paired histories keep their own evidence without becoming two physical policy inputs")
  each = usize.ZERO
  while each < actual.length {
    run Testing.expect(SourceSolution.truth(&solved, actual[each].caller) == SourceTruth.True
      && SourceSolution.truth(&solved, actual[each].independent) == SourceTruth.False
      && SourceSolution.truth(&solved, actual[each].storing) == SourceTruth.False,
      "Same view slots locate both direct and indirect sources before caller-retention effects")
    run Testing.expect(SourceSolution.truth(&solved, inactive[each].caller) == SourceTruth.False
      && SourceSolution.truth(&solved, inactive[each].independent) == SourceTruth.False
      && SourceSolution.truth(&solved, inactive[each].storing) == SourceTruth.False,
      "an inactive actual operation cannot publish retention from an otherwise present source")
    let paired = match actual[each].source.definition {
      Option<SourceControl.DefinitionId>.Some {value} => value.index == 3 + each
      _ => false
    }
    let read = match actual[each].source.read { Option<SourceControl.ReadId>.Some {value} => value.index == 5 _ => false }
    run Testing.expect(paired && read && actual[each].point == 9
      && flights[each].from == 8 && flights[each].to == 9
      && SourceSolution.truth(&solved, flights[each].active) == SourceTruth.True,
      "retention and consumption preserve their exact definition/read and execution coordinates")
    each = each + usize.ONE
  }
  return ()
}
