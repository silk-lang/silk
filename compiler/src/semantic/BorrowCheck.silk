//! Loan conflicts and moved places in one typed body: native borrow checking for loans and moves.
//!
//! # When to use
//! Call [`check`] on a successfully typed, unselected body before it is published. A
//! [`Outcome.Conflict`] rejects the body with `LoanConflict` (the bootstrap's `OWN0010`),
//! `AccessDuringLoan` (`OWN0011`), `UseAfterMove` (`OWN0001`), `OverlappingAssignment` (`OWN0004`)
//! or `IncompatibleLoopHeader` (`OWN0005`), relating the earlier loan or move when there is one.
//!
//! # Details
//! The proof follows `compiler/docs/native-borrow-checking.md` §3 and §4 on the typed body. It
//! numbers evaluation points in evaluation order and links them into a control-flow graph. A loan
//! comes from a written borrow, a shared or mutable receiver pass, or a borrowed capture of a
//! constructed callable or section, which carries it like any value. A place behind a reference
//! names the referent's storage, so a reborrow is a loan of that place and carries the parent
//! reference's loans (BORROW-005). A loan carried by a value
//! stays live until the node that consumes that value, so a call argument's loan lasts for the
//! whole call (BORROW-004). A loan bound by `let` to a reference local stays live while that local
//! is live, by backward liveness over the graph, so loans end at their last use. An access that
//! overlaps a live loan conflicts as in the bootstrap: a shared borrow conflicts with an exclusive
//! loan, an exclusive borrow with any loan, a read with an exclusive loan, and a write or move with
//! any loan. Moves reach forward along the same graph until a binding or a covering replacement;
//! each loop compares the moved places of its outer locals at entry and on every back edge. A match
//! accesses its subject once as its form declares and branches to its arms in order; its bindings
//! are places of the subject (MATCH-001, MATCH-002).
//!
//! # Gotchas
//! A body that runs an Effect or invokes an `effect fn` value, uses a storage primitive, borrows a
//! place that is not rooted in a local, or lets a loan of a body local reach a `let mut` (other than
//! a callable, which holds its capture loans until its last use), an assignment, a return, a branch
//! or match result, or a match binding answers [`Outcome.NotChecked`] with the [`BorrowStatus`]
//! reason: it is neither accepted nor rejected here, since the walk does not yet end a local's
//! storage at its scope. A loan of a referent, storage behind a reference that the body does not
//! own, may cross those boundaries: a joined value restarts its loans at the join, and a replaced
//! holder's loans become approximate. The regions such a value names are the region slice's to
//! prove, so a body where one crossed answers `regions` even when it is clear. A call result that retains a
//! region keeps the loans its instantiated regions can hold: exactly when one operand's loans name
//! them, approximately when several may, and none of a body local when every region is a lifetime
//! parameter of the checked declaration. This trusts each callee's contract; the regions slice
//! proves every body against its own. An overlap that depends on an unknown index, a partial replacement of a moved place, a
//! conflict with an approximate loan, or a move of a reference whose referent is reborrowed is
//! `Imprecise` rather than a conflict, so the stage never rejects a body the bootstrap accepts.
//! `Imprecise` is unchecked like every other reason. A clear body is `Checked` when it is
//! [`regionClosed`], typing left nothing pending and no referent loan crossed a scope boundary;
//! otherwise it answers `Regions`.

import semantic.Types {Types}
import hir.Hir {Access, CallableMode}
import lexer.Span {Span}
import semantic.DeclarationId {DeclarationId}
import semantic.Lifetime {Lifetime}
import semantic.Rejection {RejectionCode}
import semantic.Type {Argument, Binding, Type}
import semantic.TypedBody {
  AggregateField,
  BorrowStatus,
  ConsumedPlace,
  Expression,
  BindingAccess,
  Local,
  MatchArm,
  Node,
  NodeId,
  NodeKind,
  PlaceStep,
  ReceiverPass,
  ReferentCapture,
  RunAccess,
  SubjectAccess,
}
import silk.allocator {Allocator, OutOfMemoryError}
import silk.option {Option}
import silk.ownership {Copy}
import silk.shared {Shared}
import silk.u64
import silk.usize
import silk.vector {Vector}

/// What checking one body's loans and moves established.
pub enum Outcome {
  /// Every loan in the body is free of conflicts, and no moved place is used.
  Clear,
  /// An access conflicts with a live loan or uses a moved place, or a loop repeats with different
  /// moved places.
  Conflict,
  /// The body uses a form outside this slice; nothing is proved or rejected.
  NotChecked,
}

/// The outcome of checking one body. For a conflict, `access` is the rejected access or loop and
/// `earlier` the borrow or move it conflicts with, if any; otherwise `code` and `access` are unused.
///
/// Its spans count from the checked body's anchor, like the body's origins.
pub struct Verdict {
  pub outcome: Outcome
  /// For a clear body, `Checked` when [`regionClosed`] and nothing is pending, `Regions` otherwise;
  /// for an unchecked one, the reason.
  pub status: BorrowStatus
  pub code: RejectionCode
  pub access: Span
  pub earlier: Option<Span>
}

fn verdict(outcome: Outcome, status: BorrowStatus) -> Verdict {
  return Verdict {outcome: outcome, status: status, code: RejectionCode.Unsupported, access: Span.make(usize.ZERO, usize.ZERO),
    earlier: Option<Span>.none()}
}

// An index step whose value is unknown overlaps every element step.
fn anyElement() -> usize {
  return usize.MAX
}

// The step from a reference to its referent. A place through a reference names the referent's
// storage, so a reborrow is a loan of that place (BORROW-005).
fn referent() -> usize {
  return usize.MAX - usize.ONE
}

// Whether `inner` lies behind a reference stored at `outer`: `outer`'s steps are a strict prefix of
// `inner`'s and the next step dereferences. Replacing the reference leaves its old referent alone.
fn behind(outer: &Place, inner: &Place) -> bool {
  if outer.root != inner.root {
    return false
  }
  let first = Vector<usize>.asSlice(&outer.steps)
  let second = Vector<usize>.asSlice(&inner.steps)
  if first.length >= second.length || second[first.length] != referent() {
    return false
  }
  let mut at = usize.ZERO
  while at < first.length {
    if first[at] != second[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

// A body local and its static projection path: field ordinals, or `anyElement` for an index.
struct Place {
  root: usize
  steps: Vector<usize>
}

struct Interval {
  from: usize
  to: usize
}

impl Copy for Interval {}

struct Loan {
  place: Place
  exclusive: bool
  origin: Span
  // Evaluation-point ranges in which a value carrying this loan is in flight.
  intervals: Vector<Interval>
  // The `let` locals that hold this loan.
  holders: Vector<usize>
  // Whether this loan reached a value only because its flow could not be decided exactly; a
  // conflict with it leaves the body imprecise instead of rejecting it.
  approximate: bool
  // The regions typing gave the borrow, or none when the borrow has no typed node of its own.
  regions: Vector<Shared<Lifetime>>
  // Whether the loan borrows a place rooted in a body local, so its region is a body region even
  // when typing recorded none.
  local: bool
}

enum Kind {
  Read,
  // A complete or projected replacement: it reinitializes the place.
  Write,
  // A transfer of ownership out of the place: it leaves the place without an owner.
  Move,
  // An explicit `drop`: it ends the place's remaining parts, so a part moved earlier is no use.
  Drop,
  SharedBorrow,
  ExclusiveBorrow,
  // A `match &mut` scrutinee: like a write it conflicts with every loan, but it replaces nothing.
  Update,
  // A `match place` scrutinee reads the tag of an owner whose payload parts may have moved: it
  // conflicts with every loan, and only a move of the owner or an ancestor is a use after move.
  Inspect,
}

struct Event {
  point: usize
  place: Place
  kind: Kind
  span: Span
  // The loan this access creates, or `usize.MAX`.
  loan: usize
  // For a replacement, whether its right-hand side moves out of the target: 0 no, 1 yes, 2 only
  // through an unknown index.
  consumesTarget: usize
}

struct Point {
  next: Vector<usize>
  // A holder local read here, or `usize.MAX`.
  uses: usize
  // A holder local bound here, or `usize.MAX`.
  defines: usize
  // A local whose binding initializes it here, or `usize.MAX`.
  initializes: usize
  // The access recorded here, or `usize.MAX`.
  event: usize
}

struct Frame {
  exit: usize
  // The index of the frame's loop in `Walker.loops`.
  repeat: usize
}

// A loop: the point before it, its header, the sources of its back edges, the end of its points,
// and the span the bootstrap reports for an incompatible header.
struct Loop {
  before: usize
  header: usize
  sources: Vector<usize>
  end: usize
  span: Span
}

impl Copy for Frame {}

// A loan carried by a value, and the point from which it is in flight.
struct Carry {
  loan: usize
  since: usize
  // The operand of the consuming node that carried the loan to it, or `usize.MAX`.
  operand: usize
}

impl Copy for Carry {}

struct Flow {
  at: usize
  carried: Vector<Carry>
}

// The written place a node names: its root local, whether it is reached through a reference, its
// projection path with a `referent` step per dereference, and the index operands to evaluate
// first, in order.
struct Path {
  root: usize
  through: bool
  steps: Vector<usize>
  indexes: Vector<NodeId>
}

struct Walker {
  points: Vector<Point>
  loans: Vector<Loan>
  events: Vector<Event>
  frames: Vector<Frame>
  loops: Vector<Loop>
  // Per local, the loans it holds; empty for a local that holds none.
  held: Vector<Vector<usize>>
  exit: usize
  outside: bool
  // Why the walk left the checked slice, once `outside` is set.
  reason: BorrowStatus
  // The binding roots of the consuming matches whose guards are being walked, innermost last.
  guarded: Vector<usize>
  // The first move or drop of a guarded binding root: a guard consumed a provisional binding.
  guardConsumed: Option<Span>
  // Whether a referent loan crossed a scope boundary: its region relation is the region slice's
  // to prove, so the body is never `Checked` on the walk alone.
  crossed: bool
}

fn flowAt(at: usize) -> Flow {
  return Flow {at: at, carried: Vector<Carry>.make()}
}

effect fn copySteps(steps: &[usize]) -> Vector<usize> ! OutOfMemoryError ? &mut Allocator {
  let mut copied = Vector<usize>.make()
  let mut at = usize.ZERO
  while at < steps.length {
    run Vector<usize>.append(&mut copied, steps[at])
    at = at + usize.ONE
  }
  return move copied
}

effect fn newPoint(walker: &mut Walker, from: usize) -> usize ! OutOfMemoryError ? &mut Allocator {
  let created = Vector<Point>.length(&walker.points)
  run Vector<Point>.append(&mut walker.points, Point {next: Vector<usize>.make(), uses: usize.MAX, defines: usize.MAX, initializes: usize.MAX, event: usize.MAX})
  run edge(&mut walker.*, from, created)
  return created
}

effect fn backEdge(walker: &mut Walker, repeat: usize, from: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  if from == usize.MAX {
    return ()
  }
  let mut loops = Vector<Loop>.asMutSlice(&mut walker.loops)
  run Vector<usize>.append(&mut loops[repeat].sources, from)
  let header = loops[repeat].header
  run edge(&mut walker.*, from, header)
  return ()
}

effect fn edge(walker: &mut Walker, from: usize, to: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  if from == usize.MAX || to == usize.MAX {
    return ()
  }
  let mut points = Vector<Point>.asMutSlice(&mut walker.points)
  run Vector<usize>.append(&mut points[from].next, to)
  return ()
}

// Ends the flight of carried loans at `at`, where their value is consumed.
effect fn consume(walker: &mut Walker, carried: &[Carry], at: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut index = usize.ZERO
  while index < carried.length {
    let carry = carried[index]
    let mut loans = Vector<Loan>.asMutSlice(&mut walker.loans)
    run Vector<Interval>.append(&mut loans[carry.loan].intervals, Interval {from: carry.since, to: at})
    index = index + usize.ONE
  }
  return ()
}

effect fn appendCarried(target: &mut Vector<Carry>, source: &[Carry]) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < source.length {
    run Vector<Carry>.append(&mut target.*, source[at])
    at = at + usize.ONE
  }
  return ()
}

// Whether every carried loan borrows a referent: storage behind a reference, which the body does
// not own, so no scope end in the body ends it and the value may cross one. A loan of a body local
// may outlive its root's scope there, which the walk does not model yet.
fn referentsOnly(walker: &Walker, carried: &[Carry]) -> bool {
  let loans = Vector<Loan>.asSlice(&walker.loans)
  let mut at = usize.ZERO
  while at < carried.length {
    if loans[carried[at].loan].local {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

// Records that `carried` crosses a scope boundary, when it carries any loan.
fn cross(walker: &mut Walker, carried: &[Carry]) -> () {
  if carried.length > usize.ZERO {
    walker.crossed = true
  }
  return ()
}

// Ends the loans one path carries at its end `end` and restarts them at the join `joined`. Points
// are numbered in creation order, not by path, so a joined value's carries restart at the join. A
// path that ends at `usize.MAX` never reaches the join.
effect fn rejoin(walker: &mut Walker, carried: &[Carry], end: usize, joined: usize, onward: &mut Vector<Carry>) -> ()
! OutOfMemoryError ? &mut Allocator {
  if end == usize.MAX {
    return ()
  }
  cross(&mut walker.*, carried)
  run consume(&mut walker.*, carried, end)
  let mut at = usize.ZERO
  while at < carried.length {
    run Vector<Carry>.append(&mut onward.*, Carry {loan: carried[at].loan, since: joined, operand: usize.MAX})
    at = at + usize.ONE
  }
  return ()
}

// Marks the loans `local` holds approximate. A replaced holder releases the loans of its earlier
// value, but its loans are not tracked per assignment, so each one would stay live wherever the
// holder is: a conflict with one is not decided.
fn approximateHeld(walker: &mut Walker, local: usize) -> () {
  if !holds(&walker.*, local) {
    return ()
  }
  let held = Vector<Vector<usize>>.asSlice(&walker.held)
  let loans = Vector<usize>.asSlice(&held[local])
  let mut all = Vector<Loan>.asMutSlice(&mut walker.loans)
  let mut at = usize.ZERO
  while at < loans.length {
    all[loans[at]].approximate = true
    at = at + usize.ONE
  }
  return ()
}

// Appends the loans one operand carries, marked with that operand's position.
effect fn appendOperand(target: &mut Vector<Carry>, source: &[Carry], operand: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < source.length {
    run Vector<Carry>.append(&mut target.*, Carry {loan: source[at].loan, since: source[at].since, operand: operand})
    at = at + usize.ONE
  }
  return ()
}

// Whether a value of `ty` can retain a non-static region; unknown retention counts as retained.
effect fn retains(ty: &Shared<Type>, owner: &DeclarationId) -> bool ! OutOfMemoryError ? &mut Allocator {
  let mut regions = Vector<Shared<Lifetime>>.make()
  let known = run retainedBy(ty, owner, &mut regions)
  return !known || Vector<Shared<Lifetime>>.length(&regions) > usize.ZERO
}

// Appends the regions a value of `ty` can retain; `false` when they are unknown.
effect fn retainedBy(ty: &Shared<Type>, owner: &DeclarationId, regions: &mut Vector<Shared<Lifetime>>) -> bool
! OutOfMemoryError ? &mut Allocator {
  let representations = Vector<Option<Shared<Type>>>.make()
  return run Type.retainedRegions(ty, owner, Vector<Option<Shared<Type>>>.asSlice(&representations), &mut regions.*)
}

fn expressionType(nodes: &[Node], id: NodeId) -> Option<Shared<Type>> {
  if let NodeKind.Expression {ty, ..} = &nodes[id.index].kind {
    return Option<Shared<Type>>.some(Shared<Type>.clone(&ty))
  }
  return Option<Shared<Type>>.none()
}

// Whether `id`'s value can retain a non-static region; a statement node retains nothing. A callable
// value may hold capture loans its type does not name, so it always counts as retaining.
effect fn nodeRetains(nodes: &[Node], id: NodeId, owner: &DeclarationId) -> bool ! OutOfMemoryError ? &mut Allocator {
  let found = expressionType(nodes, id)
  if let Option<Shared<Type>>.Some {value} = move found {
    if Shared<Type>.with<bool>(&value, callableValue) {
      return true
    }
    let retained = run retains(&value, owner)
    return retained
  }
  return false
}

// Whether `id` is a slice view, whose elements lie behind it rather than in its own storage.
fn sliceValue(nodes: &[Node], id: NodeId) -> bool {
  if let Option<Shared<Type>>.Some {value} = move expressionType(nodes, id) {
    return Shared<Type>.with<bool>(&value, fn(node: &Type) -> bool {
      return match &node.* {
        Type.Slice {..} => true
        _ => false
      }
    })
  }
  return false
}

// Reads the written place of `id`, or a path with root `usize.MAX` when it names no place.
effect fn pathOf(nodes: &[Node], id: NodeId) -> Path ! OutOfMemoryError ? &mut Allocator {
  let mut path = Path {root: usize.MAX, through: false, steps: Vector<usize>.make(), indexes: Vector<NodeId>.make()}
  run extendPath(nodes, id, &mut path)
  return move path
}

effect fn extendPath(nodes: &[Node], id: NodeId, path: &mut Path) -> () ! OutOfMemoryError ? &mut Allocator {
  if let NodeKind.Expression {form, ..} = &nodes[id.index].kind {
    match &form {
      Expression.Local {local} => {
        path.root = local.index
        return ()
      }
      Expression.Field {value, index} => {
        run extendPath(nodes, value, &mut path.*)
        if path.root != usize.MAX {
          run Vector<usize>.append(&mut path.steps, index)
        }
        return ()
      }
      Expression.Index {value, index} => {
        run extendPath(nodes, value, &mut path.*)
        if path.root != usize.MAX {
          // A slice's elements live in its referent: indexing one reads through the slice as `.*`
          // does, so it reads the holder and keeps the loans it holds live.
          if sliceValue(nodes, value) {
            run Vector<usize>.append(&mut path.steps, referent())
            path.through = true
          }
          run Vector<usize>.append(&mut path.steps, anyElement())
          run Vector<NodeId>.append(&mut path.indexes, index)
        }
        return ()
      }
      Expression.Dereference {value} => {
        run extendPath(nodes, value, &mut path.*)
        if path.root != usize.MAX {
          run Vector<usize>.append(&mut path.steps, referent())
          path.through = true
        }
        return ()
      }
      Expression.PatternBinding {subject, path: steps, access} => {
        run bindingPath(nodes, subject, Vector<PlaceStep>.asSlice(&steps), access, &mut path.*)
        return ()
      }
      _ => {}
    }
  }
  return ()
}

// The first step a union member or variant payload adds to a place, offset past every field and
// element ordinal; distinct members of one union are disjoint places.
fn memberStep(tag: usize) -> usize {
  return usize.MAX / 2 + tag
}

fn guardedRoot(guarded: &[usize], root: usize) -> bool {
  let mut at = usize.ZERO
  while at < guarded.length {
    if guarded[at] == root { return true }
    at = at + usize.ONE
  }
  return false
}

// The root of the parts a match subject holds when it is not a place of this body: the subject was
// copied, consumed or evaluated into storage of its own, so it overlaps no local.
fn subjectRoot(subject: NodeId) -> usize {
  return usize.MAX / 4 + subject.index
}

// The place a pattern binding names. A place-addressing binding (`match place`, `&`, `&mut`) is a
// projection of the subject's own place; a copied or moved binding, or a binding of a subject with no
// place, is a projection of the subject's own storage. The subject's index operands were evaluated
// with the match, so the binding re-evaluates none.
effect fn bindingPath(nodes: &[Node], subject: NodeId, steps: &[PlaceStep], access: BindingAccess, path: &mut Path) -> ()
! OutOfMemoryError ? &mut Allocator {
  if access == BindingAccess.Place || access == BindingAccess.Shared || access == BindingAccess.Exclusive {
    let base = run pathOf(nodes, subject)
    if base.root != usize.MAX {
      path.root = base.root
      path.through = base.through
      path.steps = move base.steps
    }
  }
  if path.root == usize.MAX {
    path.root = subjectRoot(subject)
  }
  let mut at = usize.ZERO
  while at < steps.length {
    match &steps[at] {
      PlaceStep.Member {tag, ..} => { run Vector<usize>.append(&mut path.steps, memberStep(tag)) }
      PlaceStep.VariantField {tag, field} => {
        run Vector<usize>.append(&mut path.steps, memberStep(tag))
        run Vector<usize>.append(&mut path.steps, field)
      }
      PlaceStep.Field {index} => { run Vector<usize>.append(&mut path.steps, index) }
      PlaceStep.Element {index} => { run Vector<usize>.append(&mut path.steps, index) }
    }
    at = at + usize.ONE
  }
  return ()
}

// The overlap of two places: 0 disjoint, 1 overlapping, 2 decided only by an unknown index.
fn overlap(left: &Place, right: &Place) -> usize {
  if left.root != right.root {
    return usize.ZERO
  }
  let first = Vector<usize>.asSlice(&left.steps)
  let second = Vector<usize>.asSlice(&right.steps)
  let mut unknown = false
  let mut at = usize.ZERO
  while at < first.length && at < second.length {
    if first[at] == anyElement() || second[at] == anyElement() {
      unknown = true
    } else if first[at] != second[at] {
      return usize.ZERO
    }
    at = at + usize.ONE
  }
  if unknown {
    return 2
  }
  return usize.ONE
}

fn conflictCode(kind: Kind, exclusive: bool) -> Option<RejectionCode> {
  if kind == Kind.ExclusiveBorrow || (kind == Kind.SharedBorrow && exclusive) {
    return Option<RejectionCode>.some(RejectionCode.LoanConflict)
  }
  if kind == Kind.Write || kind == Kind.Move || kind == Kind.Drop || kind == Kind.Update || kind == Kind.Inspect
    || (kind == Kind.Read && exclusive) {
    return Option<RejectionCode>.some(RejectionCode.AccessDuringLoan)
  }
  return Option<RejectionCode>.none()
}

// Records an access to a written place at a fresh point after `at`.
effect fn access(walker: &mut Walker, path: &Path, kind: Kind, span: Span, at: usize, loan: usize) -> usize
! OutOfMemoryError ? &mut Allocator {
  if (kind == Kind.Move || kind == Kind.Drop) && guardedRoot(Vector<usize>.asSlice(&walker.guarded), path.root) {
    if let Option<Span>.None = &walker.guardConsumed { walker.guardConsumed = Option<Span>.some(span) }
  }
  let point = run newPoint(&mut walker.*, at)
  let mut points = Vector<Point>.asMutSlice(&mut walker.points)
  points[point].event = Vector<Event>.length(&walker.events)
  run Vector<Event>.append(
    &mut walker.events,
    Event {
      point: point,
      place: Place {root: path.root, steps: run copySteps(Vector<usize>.asSlice(&path.steps))},
      kind: kind,
      span: span,
      loan: loan,
      consumesTarget: usize.ZERO,
    },
  )
  return point
}

// A read of a holder local at a fresh point: the value carries the loans it holds.
effect fn useHolder(walker: &mut Walker, local: usize, at: usize) -> Flow ! OutOfMemoryError ? &mut Allocator {
  let point = run newPoint(&mut walker.*, at)
  let mut carried = Vector<Carry>.make()
  if !holds(&walker.*, local) {
    // A reference local that holds no loan of this body has no liveness bit.
    return Flow {at: point, carried: move carried}
  }
  let mut points = Vector<Point>.asMutSlice(&mut walker.points)
  points[point].uses = local
  let held = Vector<Vector<usize>>.asSlice(&walker.held)
  let loans = Vector<usize>.asSlice(&held[local])
  let mut at = usize.ZERO
  while at < loans.length {
    run Vector<Carry>.append(&mut carried, Carry {loan: loans[at], since: point, operand: usize.MAX})
    at = at + usize.ONE
  }
  return Flow {at: point, carried: move carried}
}

// Marks the replacement recorded at `point` when a move recorded since event `since` overlaps its
// target; the bootstrap then reports the whole `statement`.
fn markConsumedTarget(walker: &mut Walker, since: usize, point: usize, statement: Span) -> () {
  let recorded = Vector<Point>.asSlice(&walker.points)[point].event
  let mut events = Vector<Event>.asMutSlice(&mut walker.events)
  let mut at = since
  while at < recorded {
    if events[at].kind == Kind.Move || events[at].kind == Kind.Drop {
      let shared = overlap(&events[at].place, &events[recorded].place)
      if shared == usize.ONE || (shared != usize.ZERO && events[recorded].consumesTarget == usize.ZERO) {
        events[recorded].consumesTarget = shared
        events[recorded].span = statement
      }
    }
    at = at + usize.ONE
  }
  return ()
}

// An access to a place behind a reference. Reaching it reads the root holder, whose loans the
// result carries, and the access is recorded at the referent place.
effect fn throughReference(walker: &mut Walker, path: &Path, kind: Kind, span: Span, at: usize) -> Flow ! OutOfMemoryError ? &mut Allocator {
  let used = run useHolder(&mut walker.*, path.root, at)
  let point = run access(&mut walker.*, path, kind, span, used.at, usize.MAX)
  return Flow {at: point, carried: move used.carried}
}

// Leaves the checked slice; the first reason is the one reported.
fn leave(walker: &mut Walker, reason: BorrowStatus) -> () {
  if !walker.outside {
    walker.outside = true
    walker.reason = reason
  }
  return ()
}

fn holds(walker: &Walker, local: usize) -> bool {
  let held = Vector<Vector<usize>>.asSlice(&walker.held)
  return local < held.length && Vector<usize>.length(&held[local]) > usize.ZERO
}

// Evaluates a place's index operands in order; each index value is consumed when it is read.
effect fn indexes(nodes: &[Node], locals: &[Local], owner: &DeclarationId, walker: &mut Walker, path: &Path, at: usize) -> usize
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let operands = Vector<NodeId>.asSlice(&path.indexes)
  let mut current = at
  let mut index = usize.ZERO
  while index < operands.length {
    let flow = run visit(nodes, locals, owner, &mut walker.*, operands[index], current)
    let point = run newPoint(&mut walker.*, flow.at)
    run consume(&mut walker.*, Vector<Carry>.asSlice(&flow.carried), point)
    current = point
    index = index + usize.ONE
  }
  return current
}

// Creates a loan of a written place at a fresh point, carried by the borrowing value. A reborrow
// through a reference is a loan of the referent place (BORROW-005): while it lives, an access
// through the parent reference conflicts with it as with any loan of that place.
effect fn borrow(nodes: &[Node], locals: &[Local], owner: &DeclarationId, walker: &mut Walker, place: NodeId, exclusive: bool, span: Span,
  node: usize, at: usize) -> Flow
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let path = run pathOf(nodes, place)
  if path.root == usize.MAX {
    leave(&mut walker.*, BorrowStatus.StoredLoans)
    return flowAt(at)
  }
  let mut evaluated = run indexes(nodes, locals, owner, &mut walker.*, &path, at)
  // A reference to a whole holder, or a reborrow through one, reaches what its loans borrow, so
  // the holder's loans travel with the reference: the parent loan outlives every reborrow of it,
  // and borrowing a callable to invoke it keeps its capture loans live.
  let mut carried = Vector<Carry>.make()
  if (path.through || Vector<usize>.length(&path.steps) == usize.ZERO) && holds(&walker.*, path.root) {
    let used = run useHolder(&mut walker.*, path.root, evaluated)
    run appendCarried(&mut carried, Vector<Carry>.asSlice(&used.carried))
    evaluated = used.at
  }
  return run takeLoan(nodes, owner, &mut walker.*, &path, exclusive, span, node, evaluated, move carried)
}

// A captured exclusive descriptor's referent, reborrowed by the environment it was read into
// (CAPTURE-002). The loan's regions are the descriptor's, which the field keeps.
effect fn reborrowReferent(nodes: &[Node], owner: &DeclarationId, walker: &mut Walker, operand: NodeId, exclusive: bool, at: usize) -> Flow
! OutOfMemoryError ? &mut Allocator {
  let mut path = run pathOf(nodes, operand)
  if path.root == usize.MAX || path.through || Vector<usize>.length(&path.steps) > usize.ZERO {
    leave(&mut walker.*, BorrowStatus.StoredLoans)
    return flowAt(at)
  }
  run Vector<usize>.append(&mut path.steps, referent())
  path.through = true
  let span = nodes[operand.index].origin.bytes
  return run takeLoan(nodes, owner, &mut walker.*, &path, exclusive, span, operand.index, at, Vector<Carry>.make())
}

// Records a new loan of `path` at a fresh point after `at`; the borrowing value carries it after
// `carried`. `node` is the expression whose type names the loan's regions, or `usize.MAX`.
effect fn takeLoan(nodes: &[Node], owner: &DeclarationId, walker: &mut Walker, path: &Path, exclusive: bool, span: Span, node: usize,
  at: usize, carried: Vector<Carry>) -> Flow
! OutOfMemoryError ? &mut Allocator {
  let mut onward = move carried
  let mut regions = Vector<Shared<Lifetime>>.make()
  if node != usize.MAX {
    let typed = expressionType(nodes, NodeId {index: node})
    if let Option<Shared<Type>>.Some {value} = move typed {
      let known = run retainedBy(&value, owner, &mut regions)
      if !known {
        regions = Vector<Shared<Lifetime>>.make()
      }
    }
  }
  let created = Vector<Loan>.length(&walker.loans)
  run Vector<Loan>.append(
    &mut walker.loans,
    Loan {
      place: Place {root: path.root, steps: run copySteps(Vector<usize>.asSlice(&path.steps))},
      exclusive: exclusive,
      origin: span,
      intervals: Vector<Interval>.make(),
      holders: Vector<usize>.make(),
      approximate: false,
      regions: move regions,
      local: !path.through,
    },
  )
  let mut kind = Kind.SharedBorrow
  if exclusive {
    kind = Kind.ExclusiveBorrow
  }
  let point = run access(&mut walker.*, path, kind, span, at, created)
  run Vector<Carry>.append(&mut onward, Carry {loan: created, since: point, operand: usize.MAX})
  return Flow {at: point, carried: move onward}
}

// Reads or moves a written place. An access rooted at a holder uses the holder, so its loans stay
// live through the access, and the accessed value carries them: a whole holder's move takes them to
// the new owner, and a part read out of it may hold them too (a reference field, for instance).
effect fn place(nodes: &[Node], locals: &[Local], owner: &DeclarationId, walker: &mut Walker, path: &Path, kind: Kind, span: Span, at: usize) -> Flow
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let evaluated = run indexes(nodes, locals, owner, &mut walker.*, path, at)
  if path.through {
    let reached = run throughReference(&mut walker.*, path, kind, span, evaluated)
    return flowAt(reached.at)
  }
  if holds(&walker.*, path.root) {
    let used = run useHolder(&mut walker.*, path.root, evaluated)
    let accessed = run access(&mut walker.*, path, kind, span, used.at, usize.MAX)
    return Flow {at: accessed, carried: move used.carried}
  }
  let point = run access(&mut walker.*, path, kind, span, evaluated, usize.MAX)
  return flowAt(point)
}

// Evaluates operands in order and consumes everything they carry at one fresh point.
effect fn operands(nodes: &[Node], locals: &[Local], owner: &DeclarationId, walker: &mut Walker, values: &[NodeId], result: NodeId, at: usize) -> Flow
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut carried = Vector<Carry>.make()
  let mut current = at
  let mut index = usize.ZERO
  while index < values.length {
    let flow = run visit(nodes, locals, owner, &mut walker.*, values[index], current)
    run appendOperand(&mut carried, Vector<Carry>.asSlice(&flow.carried), index)
    current = flow.at
    index = index + usize.ONE
  }
  return run finish(nodes, owner, &mut walker.*, result, current, &carried, false)
}

// Consumes carried loans at a fresh point for `result`, which keeps carrying the loans it can
// retain (VIEW-002), so a returned view holds its source loan through its last use. Typing gives the
// result its instantiated regions, with the callee's bounds, type arguments and elisions applied:
// - A result whose regions are all lifetime parameters of the checked declaration, or that is one
//   of its type parameters, holds no loan of a body local or with a body region, which cannot
//   outlive them; the region slice proves that relation.
// - When exactly one operand's loans name a result region, the result may hold them: a conflict
//   rejects.
// - Otherwise a loan is carried approximately, and a conflict with it leaves the body imprecise:
//   every fresh borrow of one call shares the call's region, so several operands may name it, and a
//   callable retains its capture loans whatever its type names.
// A `stores` result keeps every operand, as the Effect an `effect fn` call constructs does, so it
// keeps all their loans exactly whatever regions its type names.
effect fn finish(nodes: &[Node], owner: &DeclarationId, walker: &mut Walker, result: NodeId, at: usize, carried: &Vector<Carry>,
  stores: bool) -> Flow
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let point = run newPoint(&mut walker.*, at)
  let mut onward = Vector<Carry>.make()
  if Vector<Carry>.length(carried) > usize.ZERO {
    run consume(&mut walker.*, Vector<Carry>.asSlice(carried), point)
    let retained = run nodeRetains(nodes, result, owner)
    if retained {
      let mut regions = Vector<Shared<Lifetime>>.make()
      let known = run resultRegions(nodes, result, owner, &mut regions)
      let named = Vector<Shared<Lifetime>>.asSlice(&regions)
      let outside = known && callerParameters(named, owner)
      let loans = Vector<Carry>.asSlice(carried)
      // The one operand whose loans may name a result region, or `usize.MAX`.
      let mut naming = usize.MAX
      let mut several = false
      let mut index = usize.ZERO
      while index < loans.length {
        let all = Vector<Loan>.asSlice(&walker.loans)
        let regionsOf = Vector<Shared<Lifetime>>.asSlice(&all[loans[index].loan].regions)
        if regionsOf.length == usize.ZERO || sharesAtom(regionsOf, named) {
          if naming == usize.MAX {
            naming = loans[index].operand
          } else if naming != loans[index].operand {
            several = true
          }
        }
        index = index + usize.ONE
      }
      index = usize.ZERO
      while index < loans.length {
        let loan = loans[index].loan
        let mut all = Vector<Loan>.asMutSlice(&mut walker.loans)
        let mut kept = true
        let mut exact = false
        if stores {
          exact = true
        } else if known {
          let regionsOf = Vector<Shared<Lifetime>>.asSlice(&all[loan].regions)
          if outside && (all[loan].local || bodyRegions(regionsOf, owner)) {
            kept = false
          } else if !several && naming == loans[index].operand && regionsOf.length > usize.ZERO && sharesAtom(regionsOf, named) {
            exact = true
          }
        }
        if kept {
          if !exact {
            all[loan].approximate = true
          }
          run Vector<Carry>.append(&mut onward, Carry {loan: loan, since: point, operand: usize.MAX})
        }
        index = index + usize.ONE
      }
    }
  }
  return Flow {at: point, carried: move onward}
}

// The regions `result`'s value can retain; `false` when they are unknown, as for a callable, whose
// capture loans its type does not name. A type parameter of the checked declaration, alone or
// inside the result, retains no region of its body: its callers instantiate it with types that
// cannot name one, and safe code obtains a value of it only as such a value.
effect fn resultRegions(nodes: &[Node], result: NodeId, owner: &DeclarationId, regions: &mut Vector<Shared<Lifetime>>) -> bool
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let found = expressionType(nodes, result)
  if let Option<Shared<Type>>.Some {value} = move found {
    if Shared<Type>.with<bool>(&value, callableValue) {
      return false
    }
    // The checked declaration's own type parameters stand for caller-chosen types, so they are
    // read as retaining nothing; what remains is the regions the result can hold of this body.
    let mut types = Vector<usize>.make()
    let mut lifetimes = Vector<usize>.make()
    let mut rows = Vector<usize>.make()
    run Type.collectOwned(&value, owner, &mut types, &mut lifetimes, &mut rows)
    let ordinals = Vector<usize>.asSlice(&types)
    if ordinals.length == usize.ZERO {
      return run retainedBy(&value, owner, &mut regions.*)
    }
    let mut bindings = Vector<Binding>.make()
    let shared = run Shared<DeclarationId>.make(DeclarationId.copy(owner))
    let mut at = usize.ZERO
    while at < ordinals.length {
      run Vector<Binding>.append(&mut bindings, Binding {
        declaration: Shared<DeclarationId>.clone(&shared),
        ordinal: ordinals[at],
        value: Argument.Type {value: run Types.intern(Type.Unit)},
      })
      at = at + usize.ONE
    }
    let erased = run Type.applyBindings(&value, Vector<Binding>.asSlice(&bindings), true)
    return run retainedBy(&erased, owner, &mut regions.*)
  }
  return false
}

// Whether every atom of `regions` is a lifetime parameter of the checked declaration itself: no
// `'static`, body region, invocation binder, supplied atom, or binder a call left open.
fn callerParameters(regions: &[Shared<Lifetime>], owner: &DeclarationId) -> bool {
  let mut at = usize.ZERO
  while at < regions.length {
    let parameter = Lifetime.allAtoms(&regions[at], fn(atom: &Lifetime) -> bool {
      return match &atom.* {
        Lifetime.Parameter {declaration, ..} => DeclarationId.equals(&declaration, owner)
        _ => false
      }
    })
    if !parameter {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

// Whether `regions` is known and every atom of it is a body region of the checked declaration, as
// typing gives a fresh borrow, even a reborrow through a reference parameter.
fn bodyRegions(regions: &[Shared<Lifetime>], owner: &DeclarationId) -> bool {
  if regions.length == usize.ZERO {
    return false
  }
  let mut at = usize.ZERO
  while at < regions.length {
    let local = Lifetime.allAtoms(&regions[at], fn(atom: &Lifetime) -> bool {
      return match &atom.* {
        Lifetime.Local {declaration, ..} => DeclarationId.equals(&declaration, owner)
        _ => false
      }
    })
    if !local {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

// Whether any atom of `left` is an atom of `right`.
fn sharesAtom(left: &[Shared<Lifetime>], right: &[Shared<Lifetime>]) -> bool {
  let mut first = usize.ZERO
  while first < left.length {
    let leftCount = Lifetime.atomCount(&left[first])
    let mut leftAt = usize.ZERO
    while leftAt < leftCount {
      let atom = Lifetime.atomAt(&left[first], leftAt)
      let mut second = usize.ZERO
      while second < right.length {
        let rightCount = Lifetime.atomCount(&right[second])
        let mut rightAt = usize.ZERO
        while rightAt < rightCount {
          let other = Lifetime.atomAt(&right[second], rightAt)
          if Lifetime.equalsShared(&atom, &other) {
            return true
          }
          rightAt = rightAt + usize.ONE
        }
        second = second + usize.ONE
      }
      leftAt = leftAt + usize.ONE
    }
    first = first + usize.ONE
  }
  return false
}

effect fn fieldValues(fields: &[AggregateField]) -> Vector<NodeId> ! OutOfMemoryError ? &mut Allocator {
  let mut values = Vector<NodeId>.make()
  let mut at = usize.ZERO
  while at < fields.length {
    run Vector<NodeId>.append(&mut values, fields[at].value)
    at = at + usize.ONE
  }
  return move values
}

// The referent captures of an environment, each naming the position of its field's operand.
effect fn referentOperands(fields: &[AggregateField], referents: &[ReferentCapture]) -> Vector<ReferentCapture>
! OutOfMemoryError ? &mut Allocator {
  let mut operands = Vector<ReferentCapture>.make()
  let mut at = usize.ZERO
  while at < referents.length {
    let mut position = usize.ZERO
    while position < fields.length && fields[position].index != referents[at].field {
      position = position + usize.ONE
    }
    run Vector<ReferentCapture>.append(&mut operands, ReferentCapture {field: position, access: referents[at].access})
    at = at + usize.ONE
  }
  return move operands
}

effect fn single(value: NodeId) -> Vector<NodeId> ! OutOfMemoryError ? &mut Allocator {
  let mut values = Vector<NodeId>.make()
  run Vector<NodeId>.append(&mut values, value)
  return move values
}

effect fn copyIds(values: &[NodeId]) -> Vector<NodeId> ! OutOfMemoryError ? &mut Allocator {
  let mut copied = Vector<NodeId>.make()
  let mut at = usize.ZERO
  while at < values.length {
    run Vector<NodeId>.append(&mut copied, values[at])
    at = at + usize.ONE
  }
  return move copied
}

// A call's arguments in order. A shared or mutable receiver pass borrows the receiver place for the
// whole call; a taking receiver pass moves it.
effect fn call(nodes: &[Node], locals: &[Local], owner: &DeclarationId, walker: &mut Walker, arguments: &[NodeId], receiver: usize, exact: bool,
  result: NodeId, at: usize) -> Flow
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut carried = Vector<Carry>.make()
  let mut current = at
  let mut index = usize.ZERO
  while index < arguments.length {
    let argument = arguments[index]
    let mut handled = false
    if index == usize.ZERO && receiver != usize.ZERO {
      let path = run pathOf(nodes, argument)
      if path.root != usize.MAX && !isBorrow(nodes, argument) {
        let span = nodes[argument.index].origin.bytes
        let mut flow = flowAt(current)
        if receiver == 3 {
          flow = run place(nodes, locals, owner, &mut walker.*, &path, Kind.Read, span, current)
        } else {
          flow = run borrow(nodes, locals, owner, &mut walker.*, argument, receiver == 2, span, usize.MAX, current)
        }
        run appendOperand(&mut carried, Vector<Carry>.asSlice(&flow.carried), index)
        current = flow.at
        handled = true
      }
    }
    if !handled {
      let flow = run visit(nodes, locals, owner, &mut walker.*, argument, current)
      run appendOperand(&mut carried, Vector<Carry>.asSlice(&flow.carried), index)
      current = flow.at
    }
    index = index + usize.ONE
  }
  return run finish(nodes, owner, &mut walker.*, result, current, &carried, exact)
}

// Constructs a callable or section from its captured operands, in order (CAPTURE-001). A borrowed capture's
// loan begins here and travels with the callable value, so it stays live while the callable can
// still be invoked (CALLABLE-003); a moved capture leaves its place here (CAPTURE-002). A captured
// exclusive descriptor is read into its field and its referent reborrowed with the access the body
// needs through it. A section copies or takes its base callable's environment, so it carries the
// loans that callee holds.
effect fn construct(nodes: &[Node], locals: &[Local], owner: &DeclarationId, walker: &mut Walker, values: &[NodeId],
  referents: &[ReferentCapture], at: usize) -> Flow
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut carried = Vector<Carry>.make()
  let mut current = at
  let mut index = usize.ZERO
  while index < values.length {
    let flow = run visit(nodes, locals, owner, &mut walker.*, values[index], current)
    run appendCarried(&mut carried, Vector<Carry>.asSlice(&flow.carried))
    current = flow.at
    let mut captured = usize.ZERO
    while captured < referents.length {
      if referents[captured].field == index {
        let reborrow = run reborrowReferent(nodes, owner, &mut walker.*, values[index], referents[captured].access == Access.Mutable, current)
        run appendCarried(&mut carried, Vector<Carry>.asSlice(&reborrow.carried))
        current = reborrow.at
      }
      captured = captured + usize.ONE
    }
    index = index + usize.ONE
  }
  // The loans travel with the callable whatever regions its type names: holding them longer is
  // conservative, and the region slice proves the environment's own regions.
  let point = run newPoint(&mut walker.*, current)
  return Flow {at: point, carried: move carried}
}

// An invocation of a callable value (CALLABLE-002). A pipeline's input is evaluated before the
// callee. Reading the callee keeps the loans its environment holds live for the whole call
// (CALLABLE-003). A `mut fn` callee is accessed exclusively for the call; a `once fn` callee is
// already a typed move of its place, so a second invocation uses a moved place.
effect fn invoke(nodes: &[Node], locals: &[Local], owner: &DeclarationId, walker: &mut Walker, callee: NodeId, arguments: &[NodeId],
  pipeline: bool, exclusive: bool, result: NodeId, at: usize) -> Flow
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut carried = Vector<Carry>.make()
  let mut current = at
  let mut first = usize.ZERO
  if pipeline && arguments.length > usize.ZERO {
    let input = run visit(nodes, locals, owner, &mut walker.*, arguments[0], current)
    run appendOperand(&mut carried, Vector<Carry>.asSlice(&input.carried), usize.ZERO)
    current = input.at
    first = usize.ONE
  }
  let target = run calleeAccess(nodes, locals, owner, &mut walker.*, callee, exclusive, current)
  run appendOperand(&mut carried, Vector<Carry>.asSlice(&target.carried), arguments.length)
  current = target.at
  let mut index = first
  while index < arguments.length {
    let flow = run visit(nodes, locals, owner, &mut walker.*, arguments[index], current)
    run appendOperand(&mut carried, Vector<Carry>.asSlice(&flow.carried), index)
    current = flow.at
    index = index + usize.ONE
  }
  return run finish(nodes, owner, &mut walker.*, result, current, &carried, false)
}

// Constructs the Effect an `effect fn` value's invocation promises without calling it (EFF-001). The
// Effect takes its callee as the callee's mode grants: it owns a `once fn` callee, already a typed
// move, and holds a shared or exclusive loan of any other callee place, which carries the callee's
// own loans. Its operands enter the environment by CAPTURE-002. Every loan travels with the Effect
// value, so it stays live until the Effect's last run or drop (EFFECT-OWN-001, EFFECT-OWN-002).
effect fn defer(nodes: &[Node], locals: &[Local], owner: &DeclarationId, walker: &mut Walker, callee: NodeId, arguments: &[NodeId],
  pipeline: bool, mode: CallableMode, at: usize) -> Flow
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut carried = Vector<Carry>.make()
  let mut current = at
  let mut first = usize.ZERO
  if pipeline && arguments.length > usize.ZERO {
    let input = run visit(nodes, locals, owner, &mut walker.*, arguments[0], current)
    run appendCarried(&mut carried, Vector<Carry>.asSlice(&input.carried))
    current = input.at
    first = usize.ONE
  }
  let target = run capturedCallee(nodes, locals, owner, &mut walker.*, callee, mode, current)
  run appendCarried(&mut carried, Vector<Carry>.asSlice(&target.carried))
  current = target.at
  let mut index = first
  while index < arguments.length {
    let flow = run visit(nodes, locals, owner, &mut walker.*, arguments[index], current)
    run appendCarried(&mut carried, Vector<Carry>.asSlice(&flow.carried))
    current = flow.at
    index = index + usize.ONE
  }
  let point = run newPoint(&mut walker.*, current)
  return Flow {at: point, carried: move carried}
}

// The callee a constructed Effect retains: a borrow of a shared or `mut fn` callee place, otherwise
// the callee's value.
effect fn capturedCallee(nodes: &[Node], locals: &[Local], owner: &DeclarationId, walker: &mut Walker, callee: NodeId, mode: CallableMode, at: usize) -> Flow
! OutOfMemoryError ? &mut Allocator | &mut Types {
  if mode == CallableMode.Once {
    return run visit(nodes, locals, owner, &mut walker.*, callee, at)
  }
  let path = run pathOf(nodes, callee)
  if path.root == usize.MAX {
    return run visit(nodes, locals, owner, &mut walker.*, callee, at)
  }
  let span = nodes[callee.index].origin.bytes
  return run borrow(nodes, locals, owner, &mut walker.*, callee, mode == CallableMode.Mutable, span, usize.MAX, at)
}

// The callee of an invocation. A shared or consuming callee is an ordinary read or move of its
// value. A `mut fn` callee written as a place is borrowed exclusively for the call, which reads its
// held loans, so another live loan of that place conflicts with the invocation.
effect fn calleeAccess(nodes: &[Node], locals: &[Local], owner: &DeclarationId, walker: &mut Walker, callee: NodeId, exclusive: bool, at: usize) -> Flow
! OutOfMemoryError ? &mut Allocator | &mut Types {
  if !exclusive {
    return run visit(nodes, locals, owner, &mut walker.*, callee, at)
  }
  let path = run pathOf(nodes, callee)
  if path.root == usize.MAX {
    return run visit(nodes, locals, owner, &mut walker.*, callee, at)
  }
  let span = nodes[callee.index].origin.bytes
  return run borrow(nodes, locals, owner, &mut walker.*, callee, true, span, usize.MAX, at)
}

fn isBorrow(nodes: &[Node], id: NodeId) -> bool {
  if let NodeKind.Expression {form, ..} = &nodes[id.index].kind {
    if let Expression.Borrow {..} = &form {
      return true
    }
  }
  return false
}

// Whether a local of this type is a callable value in any of its typed forms.
fn callableValue(ty: &Type) -> bool {
  return match &ty.* {
    Type.Callable {..} => true
    Type.CallableValue {..} => true
    Type.CallableSchema {..} => true
    Type.CallableStage {..} => true
    Type.CallableResult {..} => true
    Type.CallableOrigin {..} => true
    Type.CallableWitnessResult {..} => true
    Type.CallableView {..} => true
    _ => false
  }
}

fn localType(locals: &[Local], local: usize) -> Shared<Type> {
  return Shared<Type>.clone(&locals[local].ty)
}

// The node shape `visit` dispatches on, read without holding a borrow of the node across calls.
union Shape {
  Leaf,
  Outside {reason: BorrowStatus},
  ReadPlace,
  Borrow {access: Access, value: NodeId},
  Move {value: NodeId, consumed: bool},
  Operands {values: Vector<NodeId>},
  PassThrough {value: NodeId},
  Call {arguments: Vector<NodeId>, receiver: usize, exact: bool},
  Invoke {callee: NodeId, arguments: Vector<NodeId>, pipeline: bool, exclusive: bool},
  // `referents` name their operands by position.
  Construct {values: Vector<NodeId>, referents: Vector<ReferentCapture>},
  Defer {callee: NodeId, arguments: Vector<NodeId>, pipeline: bool, mode: CallableMode},
  Binding {local: usize, initializer: NodeId, mutable: bool},
  Assignment {local: usize, value: NodeId},
  PlaceAssignment {target: NodeId, value: NodeId},
  Exit {value: Option<NodeId>},
  Drop {value: NodeId, consumed: bool},
  Branch {condition: NodeId, thenBranch: NodeId, elseBranch: Option<NodeId>},
  While {condition: NodeId, body: NodeId},
  Break,
  Continue,
  Block {statements: Vector<NodeId>},
  Match {subject: NodeId, access: Scrutinee, arms: Vector<ArmShape>},
}

// How a match reaches its subject, read from `SubjectAccess` without holding the node.
enum Scrutinee {
  // A bare match copies the subject; `match move` of a value with no place consumes it.
  Value,
  // `match move` of a place moves it.
  Moved,
  // `match &` reads the subject place.
  Shared,
  // `match &mut` updates it.
  Exclusive,
  // `match place` inspects its tag.
  Place,
}

struct ArmShape {
  guard: Option<NodeId>
  result: NodeId
}

fn scrutineeOf(access: &SubjectAccess) -> Scrutinee {
  return match &access.* {
    SubjectAccess.Copy => Scrutinee.Value
    SubjectAccess.Consume {consumed} => {
      if hasPlace(&consumed) {
        return Scrutinee.Moved
      }
      return Scrutinee.Value
    }
    SubjectAccess.Place {access: binding} => {
      if binding == BindingAccess.Shared {
        return Scrutinee.Shared
      }
      if binding == BindingAccess.Exclusive {
        return Scrutinee.Exclusive
      }
      return Scrutinee.Place
    }
  }
}

effect fn armShapes(arms: &[MatchArm]) -> Vector<ArmShape> ! OutOfMemoryError ? &mut Allocator {
  let mut shapes = Vector<ArmShape>.make()
  let mut at = usize.ZERO
  while at < arms.length {
    run Vector<ArmShape>.append(&mut shapes, ArmShape {guard: copyNode(&arms[at].guard), result: arms[at].result})
    at = at + usize.ONE
  }
  return move shapes
}

effect fn shapeOf(nodes: &[Node], id: NodeId) -> Shape ! OutOfMemoryError ? &mut Allocator {
  return match &nodes[id.index].kind {
    NodeKind.Expression {form, ty} => {
      // A named function's section is an aggregate of its captured operands (CALLABLE-001).
      if let Expression.Aggregate {fields} = &form {
        if Shared<Type>.with<bool>(&ty, callableValue) {
          return Shape.Construct {values: run fieldValues(Vector<AggregateField>.asSlice(&fields)), referents: Vector<ReferentCapture>.make()}
        }
      }
      // An immediate run is exactly the one call it executes (EFF-003): the Effect that call
      // constructs is a temporary only this run consumes, so its operands are the call's arguments
      // and the run node is the call's result (EFFECT-OWN-001, BORROW-004).
      if let Expression.Run {value, access} = &form {
        if access == RunAccess.Immediate {
          if let NodeKind.Expression {form: operand, ..} = &nodes[value.index].kind {
            // Running an `effect fn` value's invocation in place invokes that value (CALLABLE-002).
            if let Expression.CallableCall {callee, mode, arguments, pipeline, ..} = &operand {
              return Shape.Invoke {callee: callee, arguments: run copyIds(Vector<NodeId>.asSlice(&arguments)), pipeline: pipeline,
                exclusive: mode == CallableMode.Mutable}
            }
            // The run's result is the call's success value, which stores none of its operands
            // beyond what its own type retains.
            if let Expression.DirectCall {arguments, receiverPass, ..} = &operand {
              return Shape.Call {arguments: run copyIds(Vector<NodeId>.asSlice(&arguments)), receiver: receiverOf(&receiverPass), exact: false}
            }
            if let Expression.InterfaceCall {arguments, receiverPass, ..} = &operand {
              return Shape.Call {arguments: run copyIds(Vector<NodeId>.asSlice(&arguments)), receiver: receiverOf(&receiverPass), exact: false}
            }
            return run expressionShape(&operand)
          }
        }
      }
      return run expressionShape(&form)
    }
    NodeKind.LocalBinding {local, initializer} => Shape.Binding {local: local.index, initializer: initializer, mutable: false}
    NodeKind.MutableBinding {local, initializer} => Shape.Binding {local: local.index, initializer: initializer, mutable: true}
    NodeKind.Assignment {local, value} => Shape.Assignment {local: local.index, value: value}
    NodeKind.PlaceAssignment {target, value} => Shape.PlaceAssignment {target: target, value: value}
    NodeKind.Return {value} => Shape.Exit {value: copyNode(&value)}
    NodeKind.Fail {value} => Shape.Exit {value: Option<NodeId>.some(value)}
    NodeKind.Drop {value, consumed} => Shape.Drop {value: value, consumed: hasPlace(&consumed)}
    NodeKind.Branch {condition, thenBranch, elseBranch, ..} => Shape.Branch {condition: condition, thenBranch: thenBranch, elseBranch: copyNode(&elseBranch)}
    NodeKind.While {condition, body} => Shape.While {condition: condition, body: body}
    NodeKind.Break => Shape.Break
    NodeKind.Continue => Shape.Continue
    NodeKind.Block {statements, ..} => Shape.Block {statements: run copyIds(Vector<NodeId>.asSlice(&statements))}
  }
}

fn copyNode(value: &Option<NodeId>) -> Option<NodeId> {
  if let Option<NodeId>.Some {value: node} = &value.* {
    return Option<NodeId>.some(node)
  }
  return Option<NodeId>.none()
}

// The receiver pass of a call: 0 none, 1 shared, 2 mutable, 3 taking.
fn receiverOf(value: &Option<ReceiverPass>) -> usize {
  if let Option<ReceiverPass>.Some {value: pass} = &value.* {
    if pass == ReceiverPass.Shared {
      return usize.ONE
    }
    if pass == ReceiverPass.Mutable {
      return 2
    }
    return 3
  }
  return usize.ZERO
}

fn hasPlace(consumed: &Option<ConsumedPlace>) -> bool {
  return match &consumed.* {
    Option<ConsumedPlace>.Some {..} => true
    Option<ConsumedPlace>.None => false
  }
}

effect fn expressionShape(form: &Expression) -> Shape ! OutOfMemoryError ? &mut Allocator {
  return match &form.* {
    Expression.Local {..} => Shape.ReadPlace
    Expression.Field {..} => Shape.ReadPlace
    Expression.Index {..} => Shape.ReadPlace
    Expression.Dereference {..} => Shape.ReadPlace
    Expression.Borrow {access, value} => Shape.Borrow {access: access, value: value}
    Expression.Move {value, consumed} => Shape.Move {value: value, consumed: hasPlace(&consumed)}
    Expression.PointerWeaken {value} => Shape.PassThrough {value: value}
    Expression.ArraySlice {value, ..} => Shape.PassThrough {value: value}
    Expression.SliceLength {value} => Shape.Operands {values: run single(value)}
    Expression.ArrayLength {value, ..} => Shape.Operands {values: run single(value)}
    Expression.EnumValue {value} => Shape.Operands {values: run single(value)}
    Expression.UnionInject {value, ..} => Shape.Operands {values: run single(value)}
    Expression.UnionWiden {value} => Shape.Operands {values: run single(value)}
    Expression.ConcretePrefix {operand, ..} => Shape.Operands {values: run single(operand)}
    Expression.CompileError {message} => Shape.Operands {values: run single(message)}
    Expression.ConcreteInfix {left, right, ..} => {
      let mut values = run single(left)
      run Vector<NodeId>.append(&mut values, right)
      return Shape.Operands {values: move values}
    }
    Expression.Aggregate {fields} => Shape.Operands {values: run fieldValues(Vector<AggregateField>.asSlice(&fields))}
    Expression.VariantConstruct {fields, ..} => Shape.Operands {values: run fieldValues(Vector<AggregateField>.asSlice(&fields))}
    // An `effect fn` call's Effect stores exactly its written arguments (EFFECT-OWN-001).
    Expression.DirectCall {arguments, receiverPass, constructs, ..} => Shape.Call {
      arguments: run copyIds(Vector<NodeId>.asSlice(&arguments)), receiver: receiverOf(&receiverPass), exact: constructs,
    }
    Expression.InterfaceCall {arguments, receiverPass, isEffect, ..} => Shape.Call {
      arguments: run copyIds(Vector<NodeId>.asSlice(&arguments)), receiver: receiverOf(&receiverPass), exact: isEffect,
    }
    Expression.ForeignCall {arguments, ..} => Shape.Call {
      arguments: run copyIds(Vector<NodeId>.asSlice(&arguments)), receiver: usize.ZERO, exact: false,
    }
    Expression.IntrinsicCall {arguments, ..} => Shape.Call {
      arguments: run copyIds(Vector<NodeId>.asSlice(&arguments)), receiver: usize.ZERO, exact: false,
    }
    Expression.Integer {..} => Shape.Leaf
    Expression.Float {..} => Shape.Leaf
    Expression.Text {..} => Shape.Leaf
    Expression.Boolean {..} => Shape.Leaf
    Expression.Unit => Shape.Leaf
    Expression.Embedded {..} => Shape.Leaf
    Expression.EnumMember {..} => Shape.Leaf
    Expression.Constant {..} => Shape.Leaf
    Expression.ForeignStatic {..} => Shape.Leaf
    Expression.ForeignAddress {..} => Shape.Leaf
    Expression.Callable {fields, referents, ..} => Shape.Construct {
      values: run fieldValues(Vector<AggregateField>.asSlice(&fields)),
      referents: run referentOperands(Vector<AggregateField>.asSlice(&fields), Vector<ReferentCapture>.asSlice(&referents)),
    }
    Expression.StagedCallable {callee, arguments, ..} => {
      let mut values = run single(callee)
      let supplied = Vector<NodeId>.asSlice(&arguments)
      let mut at = usize.ZERO
      while at < supplied.length {
        run Vector<NodeId>.append(&mut values, supplied[at])
        at = at + usize.ONE
      }
      return Shape.Construct {values: move values, referents: Vector<ReferentCapture>.make()}
    }
    Expression.CallableCall {callee, mode, arguments, pipeline, constructs, ..} => {
      // Invoking an `effect fn` value without running it constructs an Effect that stores its
      // operands (EFF-001).
      if constructs {
        return Shape.Defer {callee: callee, arguments: run copyIds(Vector<NodeId>.asSlice(&arguments)), pipeline: pipeline, mode: mode}
      }
      return Shape.Invoke {callee: callee, arguments: run copyIds(Vector<NodeId>.asSlice(&arguments)), pipeline: pipeline,
        exclusive: mode == CallableMode.Mutable}
    }
    // A stored Effect's run invokes the Effect value with the access its contract grants
    // (EFFECT-OWN-002): a shared Effect is read, a `mut Effect` place is borrowed exclusively, and a
    // `once Effect` operand is already a typed move. The loans its environment holds stay live
    // through the run (EFFECT-OWN-001, CALLABLE-003).
    Expression.Run {value, access} => Shape.Invoke {callee: value, arguments: Vector<NodeId>.make(), pipeline: false,
      exclusive: access == RunAccess.Exclusive}
    Expression.Match {subject, access, arms, ..} => Shape.Match {
      subject: subject, access: scrutineeOf(&access), arms: run armShapes(Vector<MatchArm>.asSlice(&arms)),
    }
    Expression.PatternBinding {..} => Shape.ReadPlace
    Expression.StorageCall {..} => Shape.Outside {reason: BorrowStatus.Storage}
  }
}

// Visits one node from point `at` and returns the point after it, or `usize.MAX` when no path
// continues, with the loans its value carries.
effect fn visit(nodes: &[Node], locals: &[Local], owner: &DeclarationId, walker: &mut Walker, id: NodeId, at: usize) -> Flow
! OutOfMemoryError ? &mut Allocator | &mut Types {
  if walker.outside {
    return flowAt(at)
  }
  let span = nodes[id.index].origin.bytes
  let shape = run shapeOf(nodes, id)
  match move shape {
    Shape.Leaf => {
      return flowAt(at)
    }
    Shape.Outside {reason} => {
      leave(&mut walker.*, reason)
      return flowAt(at)
    }
    Shape.ReadPlace => {
      let path = run pathOf(nodes, id)
      if path.root == usize.MAX {
        return run readValue(nodes, locals, owner, &mut walker.*, id, at)
      }
      let flow = run place(nodes, locals, owner, &mut walker.*, &path, Kind.Read, span, at)
      if path.through || Vector<usize>.length(&path.steps) > usize.ZERO {
        // A read through or out of a holder copies a value; one that retains a region would carry
        // the holder's loan onward.
        if Vector<Carry>.length(&flow.carried) > usize.ZERO || (path.through && holds(&walker.*, path.root)) {
          let retained = run nodeRetains(nodes, id, owner)
          if retained {
            leave(&mut walker.*, BorrowStatus.StoredLoans)
          }
        }
        let point = run newPoint(&mut walker.*, flow.at)
        run consume(&mut walker.*, Vector<Carry>.asSlice(&flow.carried), point)
        return flowAt(point)
      }
      return move flow
    }
    Shape.Borrow {access, value} => {
      return run borrow(nodes, locals, owner, &mut walker.*, value, access == Access.Mutable, span, id.index, at)
    }
    Shape.Move {value, consumed} => {
      if consumed {
        let path = run pathOf(nodes, value)
        if path.root == usize.MAX || path.through {
          leave(&mut walker.*, BorrowStatus.StoredLoans)
          return flowAt(at)
        }
        return run place(nodes, locals, owner, &mut walker.*, &path, Kind.Move, span, at)
      }
      return run visit(nodes, locals, owner, &mut walker.*, value, at)
    }
    Shape.Operands {values} => {
      return run operands(nodes, locals, owner, &mut walker.*, Vector<NodeId>.asSlice(&values), id, at)
    }
    Shape.PassThrough {value} => {
      return run visit(nodes, locals, owner, &mut walker.*, value, at)
    }
    Shape.Call {arguments, receiver, exact} => {
      return run call(nodes, locals, owner, &mut walker.*, Vector<NodeId>.asSlice(&arguments), receiver, exact, id, at)
    }
    Shape.Construct {values, referents} => {
      return run construct(nodes, locals, owner, &mut walker.*, Vector<NodeId>.asSlice(&values), Vector<ReferentCapture>.asSlice(&referents), at)
    }
    Shape.Invoke {callee, arguments, pipeline, exclusive} => {
      return run invoke(nodes, locals, owner, &mut walker.*, callee, Vector<NodeId>.asSlice(&arguments), pipeline, exclusive, id, at)
    }
    Shape.Defer {callee, arguments, pipeline, mode} => {
      return run defer(nodes, locals, owner, &mut walker.*, callee, Vector<NodeId>.asSlice(&arguments), pipeline, mode, at)
    }
    Shape.Binding {local, initializer, mutable} => {
      let flow = run visit(nodes, locals, owner, &mut walker.*, initializer, at)
      let point = run newPoint(&mut walker.*, flow.at)
      let mut initialized = Vector<Point>.asMutSlice(&mut walker.points)
      initialized[point].initializes = local
      if Vector<Carry>.length(&flow.carried) > usize.ZERO {
        run consume(&mut walker.*, Vector<Carry>.asSlice(&flow.carried), point)
        let ty = localType(locals, local)
        let callable = Shared<Type>.with<bool>(&ty, callableValue)
        let retained = callable || run retains(&ty, owner)
        if retained {
          // A `mut fn` is invoked through a mutable binding. Its capture loans stay held until the
          // local's last use even if it is replaced, and a replacement that carries loans leaves.
          if mutable && !callable {
            if !referentsOnly(&walker.*, Vector<Carry>.asSlice(&flow.carried)) {
              leave(&mut walker.*, BorrowStatus.StoredLoans)
              return flowAt(point)
            }
            cross(&mut walker.*, Vector<Carry>.asSlice(&flow.carried))
          }
          run hold(&mut walker.*, local, Vector<Carry>.asSlice(&flow.carried), point)
        }
      }
      return flowAt(point)
    }
    Shape.Assignment {local, value} => {
      return run replace(nodes, locals, owner, &mut walker.*, local, value, span, at)
    }
    Shape.PlaceAssignment {target, value} => {
      let path = run pathOf(nodes, target)
      if path.root != usize.MAX && !path.through && Vector<usize>.length(&path.steps) == usize.ZERO {
        return run replace(nodes, locals, owner, &mut walker.*, path.root, value, span, at)
      }
      if path.root == usize.MAX {
        leave(&mut walker.*, BorrowStatus.StoredLoans)
        return flowAt(at)
      }
      let evaluated = run indexes(nodes, locals, owner, &mut walker.*, &path, at)
      let since = Vector<Event>.length(&walker.events)
      let flow = run visit(nodes, locals, owner, &mut walker.*, value, evaluated)
      if Vector<Carry>.length(&flow.carried) > usize.ZERO {
        let retained = run nodeRetains(nodes, target, owner)
        if retained {
          leave(&mut walker.*, BorrowStatus.StoredLoans)
          return flowAt(flow.at)
        }
      }
      let targetSpan = nodes[target.index].origin.bytes
      let mut point = usize.MAX
      if path.through {
        let reached = run throughReference(&mut walker.*, &path, Kind.Write, targetSpan, flow.at)
        run consume(&mut walker.*, Vector<Carry>.asSlice(&reached.carried), reached.at)
        point = reached.at
      } else {
        point = run access(&mut walker.*, &path, Kind.Write, targetSpan, flow.at, usize.MAX)
        markConsumedTarget(&mut walker.*, since, point, span)
      }
      run consume(&mut walker.*, Vector<Carry>.asSlice(&flow.carried), point)
      return flowAt(point)
    }
    Shape.Exit {value} => {
      let mut current = at
      if let Option<NodeId>.Some {value: operand} = &value {
        let flow = run visit(nodes, locals, owner, &mut walker.*, operand, at)
        // A returned value may carry referent loans out of the body, whose regions typing related
        // to the result; a loan of a body local would outlive its root.
        if !referentsOnly(&walker.*, Vector<Carry>.asSlice(&flow.carried)) {
          leave(&mut walker.*, BorrowStatus.StoredLoans)
          return flowAt(usize.MAX)
        }
        if flow.at != usize.MAX {
          cross(&mut walker.*, Vector<Carry>.asSlice(&flow.carried))
          run consume(&mut walker.*, Vector<Carry>.asSlice(&flow.carried), flow.at)
        }
        current = flow.at
      }
      let exit = walker.exit
      run edge(&mut walker.*, current, exit)
      return flowAt(usize.MAX)
    }
    Shape.Drop {value, consumed} => {
      if consumed {
        let path = run pathOf(nodes, value)
        if path.root == usize.MAX || path.through {
          leave(&mut walker.*, BorrowStatus.StoredLoans)
          return flowAt(at)
        }
        let flow = run place(nodes, locals, owner, &mut walker.*, &path, Kind.Drop, span, at)
        let point = run newPoint(&mut walker.*, flow.at)
        run consume(&mut walker.*, Vector<Carry>.asSlice(&flow.carried), point)
        return flowAt(point)
      }
      let flow = run visit(nodes, locals, owner, &mut walker.*, value, at)
      let point = run newPoint(&mut walker.*, flow.at)
      run consume(&mut walker.*, Vector<Carry>.asSlice(&flow.carried), point)
      return flowAt(point)
    }
    Shape.Branch {condition, thenBranch, elseBranch} => {
      let tested = run visit(nodes, locals, owner, &mut walker.*, condition, at)
      let split = run newPoint(&mut walker.*, tested.at)
      run consume(&mut walker.*, Vector<Carry>.asSlice(&tested.carried), split)
      let taken = run visit(nodes, locals, owner, &mut walker.*, thenBranch, split)
      let mut other = flowAt(split)
      if let Option<NodeId>.Some {value: alternative} = &elseBranch {
        other = run visit(nodes, locals, owner, &mut walker.*, alternative, split)
      }
      if !referentsOnly(&walker.*, Vector<Carry>.asSlice(&taken.carried)) || !referentsOnly(&walker.*, Vector<Carry>.asSlice(&other.carried)) {
        leave(&mut walker.*, BorrowStatus.StoredLoans)
        return flowAt(usize.MAX)
      }
      let joined = run newPoint(&mut walker.*, taken.at)
      run edge(&mut walker.*, other.at, joined)
      let mut onward = Vector<Carry>.make()
      run rejoin(&mut walker.*, Vector<Carry>.asSlice(&taken.carried), taken.at, joined, &mut onward)
      run rejoin(&mut walker.*, Vector<Carry>.asSlice(&other.carried), other.at, joined, &mut onward)
      return Flow {at: joined, carried: move onward}
    }
    Shape.While {condition, body} => {
      let header = run newPoint(&mut walker.*, at)
      let exit = run newPoint(&mut walker.*, usize.MAX)
      let repeat = Vector<Loop>.length(&walker.loops)
      run Vector<Loop>.append(&mut walker.loops, Loop {before: at, header: header, sources: Vector<usize>.make(), end: usize.ZERO, span: span})
      run Vector<Frame>.append(&mut walker.frames, Frame {exit: exit, repeat: repeat})
      let tested = run visit(nodes, locals, owner, &mut walker.*, condition, header)
      let split = run newPoint(&mut walker.*, tested.at)
      run consume(&mut walker.*, Vector<Carry>.asSlice(&tested.carried), split)
      run edge(&mut walker.*, split, exit)
      let repeated = run visit(nodes, locals, owner, &mut walker.*, body, split)
      run backEdge(&mut walker.*, repeat, repeated.at)
      let mut loops = Vector<Loop>.asMutSlice(&mut walker.loops)
      loops[repeat].end = Vector<Point>.length(&walker.points)
      let enclosing = Vector<Frame>.length(&walker.frames) - usize.ONE
      Vector<Frame>.truncate(&mut walker.frames, enclosing)
      if Vector<Carry>.length(&repeated.carried) > usize.ZERO {
        leave(&mut walker.*, BorrowStatus.StoredLoans)
      }
      return flowAt(exit)
    }
    Shape.Break => {
      let frames = Vector<Frame>.asSlice(&walker.frames)
      if frames.length == usize.ZERO {
        leave(&mut walker.*, BorrowStatus.Awaiting)
        return flowAt(usize.MAX)
      }
      let frame = frames[frames.length - usize.ONE]
      run edge(&mut walker.*, at, frame.exit)
      return flowAt(usize.MAX)
    }
    Shape.Continue => {
      let frames = Vector<Frame>.asSlice(&walker.frames)
      if frames.length == usize.ZERO {
        leave(&mut walker.*, BorrowStatus.Awaiting)
        return flowAt(usize.MAX)
      }
      let frame = frames[frames.length - usize.ONE]
      run backEdge(&mut walker.*, frame.repeat, at)
      return flowAt(usize.MAX)
    }
    Shape.Match {subject, access, arms} => {
      return run matchArms(nodes, locals, owner, &mut walker.*, subject, access, Vector<ArmShape>.asSlice(&arms), id, at)
    }
    Shape.Block {statements} => {
      let list = Vector<NodeId>.asSlice(&statements)
      let mut current = at
      let mut index = usize.ZERO
      while index < list.length {
        let flow = run visit(nodes, locals, owner, &mut walker.*, list[index], current)
        if index + usize.ONE == list.length {
          return move flow
        }
        current = flow.at
        if Vector<Carry>.length(&flow.carried) > usize.ZERO {
          let point = run newPoint(&mut walker.*, flow.at)
          run consume(&mut walker.*, Vector<Carry>.asSlice(&flow.carried), point)
          current = point
        }
        index = index + usize.ONE
      }
      return flowAt(current)
    }
  }
}

// Replaces a whole local with a new value. A replaced holder's earlier loans are not released
// exactly, since its loans are not tracked per assignment, so they and the new value's referent
// loans become approximate; a loan of a body local stored this way leaves the walk.
effect fn replace(nodes: &[Node], locals: &[Local], owner: &DeclarationId, walker: &mut Walker, local: usize, value: NodeId, span: Span,
  at: usize) -> Flow
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let since = Vector<Event>.length(&walker.events)
  let flow = run visit(nodes, locals, owner, &mut walker.*, value, at)
  let ty = localType(locals, local)
  let mut retained = false
  if Vector<Carry>.length(&flow.carried) > usize.ZERO {
    retained = run retains(&ty, owner)
    if retained && !referentsOnly(&walker.*, Vector<Carry>.asSlice(&flow.carried)) {
      leave(&mut walker.*, BorrowStatus.StoredLoans)
      return flowAt(flow.at)
    }
  }
  let path = Path {root: local, through: false, steps: Vector<usize>.make(), indexes: Vector<NodeId>.make()}
  let point = run access(&mut walker.*, &path, Kind.Write, span, flow.at, usize.MAX)
  markConsumedTarget(&mut walker.*, since, point, span)
  run consume(&mut walker.*, Vector<Carry>.asSlice(&flow.carried), point)
  // A replaced `mut fn` keeps its capture loans until the local's last use, as bound.
  if !Shared<Type>.with<bool>(&ty, callableValue) {
    approximateHeld(&mut walker.*, local)
    if retained {
      cross(&mut walker.*, Vector<Carry>.asSlice(&flow.carried))
      run hold(&mut walker.*, local, Vector<Carry>.asSlice(&flow.carried), point)
      approximateHeld(&mut walker.*, local)
    }
  }
  return flowAt(point)
}

// A match (MATCH-001): the subject is accessed once as its form declares, then the arms are tried
// in written order. A pattern that does not select the value, or a guard that answers false, goes on
// to the next arm; every selected arm joins after the match. As in the bootstrap, a borrowing match
// holds no loan across its arms: its bindings are projections of the subject place, so an access to
// them is an access to that place, and what they retain is the region slice's to prove.
effect fn matchArms(nodes: &[Node], locals: &[Local], owner: &DeclarationId, walker: &mut Walker, subject: NodeId, access: Scrutinee,
  arms: &[ArmShape], result: NodeId, at: usize) -> Flow ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let span = nodes[subject.index].origin.bytes
  let mut flow = flowAt(at)
  let path = run pathOf(nodes, subject)
  if access == Scrutinee.Moved {
    if path.root == usize.MAX || path.through {
      leave(&mut walker.*, BorrowStatus.StoredLoans)
      return flowAt(at)
    }
    flow = run place(nodes, locals, owner, &mut walker.*, &path, Kind.Move, span, at)
  } else if (access == Scrutinee.Exclusive || access == Scrutinee.Place) && path.root != usize.MAX {
    let mut kind = Kind.Inspect
    if access == Scrutinee.Exclusive {
      kind = Kind.Update
    }
    flow = run place(nodes, locals, owner, &mut walker.*, &path, kind, span, at)
  } else {
    flow = run visit(nodes, locals, owner, &mut walker.*, subject, at)
  }
  let tested = run newPoint(&mut walker.*, flow.at)
  if Vector<Carry>.length(&flow.carried) > usize.ZERO {
    // Bindings of a subject that carries a loan would hold it.
    let retained = run nodeRetains(nodes, subject, owner)
    if retained {
      leave(&mut walker.*, BorrowStatus.StoredLoans)
      return flowAt(tested)
    }
    run consume(&mut walker.*, Vector<Carry>.asSlice(&flow.carried), tested)
  }
  // The subject's own storage is bound here, so moves of its parts in an earlier iteration of an
  // enclosing loop do not reach this one.
  let mut points = Vector<Point>.asMutSlice(&mut walker.points)
  points[tested].initializes = subjectRoot(subject)
  let mut ends = Vector<usize>.make()
  // The referent loans the selected arms' results carry to the join.
  let mut joining = Vector<Carry>.make()
  let mut rejected = Vector<usize>.make()
  run Vector<usize>.append(&mut rejected, tested)
  let mut index = usize.ZERO
  while index < arms.length {
    let entry = run newPoint(&mut walker.*, usize.MAX)
    let earlier = Vector<usize>.asSlice(&rejected)
    let mut from = usize.ZERO
    while from < earlier.length {
      run edge(&mut walker.*, earlier[from], entry)
      from = from + usize.ONE
    }
    Vector<usize>.truncate(&mut rejected, usize.ZERO)
    run Vector<usize>.append(&mut rejected, entry)
    let mut selected = entry
    if let Option<NodeId>.Some {value: guard} = &arms[index].guard {
      // A consuming match's bindings are parts of the subject's own storage until the guard holds.
      let consuming = access == Scrutinee.Moved || access == Scrutinee.Value
      if consuming { run Vector<usize>.append(&mut walker.guarded, subjectRoot(subject)) }
      let checked = run visit(nodes, locals, owner, &mut walker.*, guard, entry)
      if consuming { drop Vector<usize>.pop(&mut walker.guarded) }
      selected = run newPoint(&mut walker.*, checked.at)
      run consume(&mut walker.*, Vector<Carry>.asSlice(&checked.carried), selected)
      run Vector<usize>.append(&mut rejected, selected)
    }
    let taken = run visit(nodes, locals, owner, &mut walker.*, arms[index].result, selected)
    let point = run newPoint(&mut walker.*, taken.at)
    if Vector<Carry>.length(&taken.carried) > usize.ZERO {
      // A loan carried out of an arm is joined across the arms.
      let retained = run nodeRetains(nodes, result, owner)
      if retained {
        if !referentsOnly(&walker.*, Vector<Carry>.asSlice(&taken.carried)) {
          leave(&mut walker.*, BorrowStatus.StoredLoans)
          return flowAt(usize.MAX)
        }
        if taken.at != usize.MAX {
          cross(&mut walker.*, Vector<Carry>.asSlice(&taken.carried))
          run appendCarried(&mut joining, Vector<Carry>.asSlice(&taken.carried))
        }
      }
    }
    run consume(&mut walker.*, Vector<Carry>.asSlice(&taken.carried), point)
    run Vector<usize>.append(&mut ends, point)
    index = index + usize.ONE
  }
  let joined = run newPoint(&mut walker.*, usize.MAX)
  let selected = Vector<usize>.asSlice(&ends)
  index = usize.ZERO
  while index < selected.length {
    run edge(&mut walker.*, selected[index], joined)
    index = index + usize.ONE
  }
  let carried = Vector<Carry>.asSlice(&joining)
  let mut onward = Vector<Carry>.make()
  index = usize.ZERO
  while index < carried.length {
    run Vector<Carry>.append(&mut onward, Carry {loan: carried[index].loan, since: joined, operand: usize.MAX})
    index = index + usize.ONE
  }
  return Flow {at: joined, carried: move onward}
}

// A field, index or dereference of a value that is not a written place: its operand is evaluated
// and consumed by the projection.
effect fn readValue(nodes: &[Node], locals: &[Local], owner: &DeclarationId, walker: &mut Walker, id: NodeId, at: usize) -> Flow
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut values = Vector<NodeId>.make()
  if let NodeKind.Expression {form, ..} = &nodes[id.index].kind {
    match &form {
      Expression.Field {value, ..} => { run Vector<NodeId>.append(&mut values, value) }
      Expression.Dereference {value} => { run Vector<NodeId>.append(&mut values, value) }
      Expression.Index {value, index} => {
        run Vector<NodeId>.append(&mut values, value)
        run Vector<NodeId>.append(&mut values, index)
      }
      _ => {}
    }
  }
  return run operands(nodes, locals, owner, &mut walker.*, Vector<NodeId>.asSlice(&values), id, at)
}

// Makes `local` hold the loans its initializer carries from point `at`.
effect fn hold(walker: &mut Walker, local: usize, carried: &[Carry], at: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  while Vector<Vector<usize>>.length(&walker.held) <= local {
    run Vector<Vector<usize>>.append(&mut walker.held, Vector<usize>.make())
  }
  let mut held = Vector<Vector<usize>>.asMutSlice(&mut walker.held)
  let mut index = usize.ZERO
  while index < carried.length {
    run Vector<usize>.append(&mut held[local], carried[index].loan)
    let mut loans = Vector<Loan>.asMutSlice(&mut walker.loans)
    run Vector<usize>.append(&mut loans[carried[index].loan].holders, local)
    index = index + usize.ONE
  }
  let mut points = Vector<Point>.asMutSlice(&mut walker.points)
  points[at].defines = local
  return ()
}

fn inFlight(loan: &Loan, point: usize) -> bool {
  let intervals = Vector<Interval>.asSlice(&loan.intervals)
  let mut at = usize.ZERO
  while at < intervals.length {
    if intervals[at].from < point && point < intervals[at].to {
      return true
    }
    at = at + usize.ONE
  }
  return false
}

fn wordOf(bit: usize) -> usize { return bit / 64 }

fn maskOf(bit: usize) -> u64 { return u64.shiftLeft(1, usize.toU64(bit % 64)) }

// Backward liveness of holder locals: bit `h` of `out[p]` is set when holder `h` is read on some
// path after point `p` before it is bound again.
effect fn liveness(walker: &Walker, bits: &[usize], width: usize) -> Vector<u64> ! OutOfMemoryError ? &mut Allocator {
  let points = Vector<Point>.asSlice(&walker.points)
  let mut liveIn = Vector<u64>.make()
  let mut liveOut = Vector<u64>.make()
  let mut at = usize.ZERO
  while at < points.length * width {
    run Vector<u64>.append(&mut liveIn, 0)
    run Vector<u64>.append(&mut liveOut, 0)
    at = at + usize.ONE
  }
  let mut changed = true
  while changed {
    changed = false
    let mut point = points.length
    while point > usize.ZERO {
      point = point - usize.ONE
      let next = Vector<usize>.asSlice(&points[point].next)
      let mut word = usize.ZERO
      while word < width {
        let mut out = u64.MIN
        let mut successor = usize.ZERO
        while successor < next.length {
          out = u64.bitOr(out, Vector<u64>.asSlice(&liveIn)[next[successor] * width + word])
          successor = successor + usize.ONE
        }
        let mut entry = out
        if points[point].defines != usize.MAX {
          let bit = bits[points[point].defines]
          if wordOf(bit) == word { entry = u64.bitAnd(entry, u64.bitNot(maskOf(bit))) }
        }
        if points[point].uses != usize.MAX {
          let bit = bits[points[point].uses]
          if wordOf(bit) == word { entry = u64.bitOr(entry, maskOf(bit)) }
        }
        let slot = point * width + word
        let mut outs = Vector<u64>.asMutSlice(&mut liveOut)
        outs[slot] = out
        if Vector<u64>.asSlice(&liveIn)[slot] != entry {
          let mut ins = Vector<u64>.asMutSlice(&mut liveIn)
          ins[slot] = entry
          changed = true
        }
        word = word + usize.ONE
      }
    }
  }
  return move liveOut
}

fn heldLive(loan: &Loan, bits: &[usize], liveOut: &[u64], width: usize, point: usize) -> bool {
  let holders = Vector<usize>.asSlice(&loan.holders)
  let mut at = usize.ZERO
  while at < holders.length {
    let bit = bits[holders[at]]
    if u64.bitAnd(liveOut[point * width + wordOf(bit)], maskOf(bit)) != 0 {
      return true
    }
    at = at + usize.ONE
  }
  return false
}

// Whether a write of `written` replaces all of `moved`: same root, and a prefix of its path that
// names no unknown element.
fn covers(written: &Place, moved: &Place) -> bool {
  if written.root != moved.root {
    return false
  }
  let first = Vector<usize>.asSlice(&written.steps)
  let second = Vector<usize>.asSlice(&moved.steps)
  if first.length > second.length {
    return false
  }
  let mut at = usize.ZERO
  while at < first.length {
    if first[at] == anyElement() || first[at] != second[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

fn isBackEdge(walker: &Walker, from: usize, to: usize) -> bool {
  let loops = Vector<Loop>.asSlice(&walker.loops)
  let mut at = usize.ZERO
  while at < loops.length {
    if loops[at].header == to {
      let sources = Vector<usize>.asSlice(&loops[at].sources)
      let mut index = usize.ZERO
      while index < sources.length {
        if sources[index] == from {
          return true
        }
        index = index + usize.ONE
      }
    }
    at = at + usize.ONE
  }
  return false
}

// Reaching moves along forward edges: bit `m` of `entering[p]` (and `leaving[p]`) is set when move
// event `moves[m]` reaches point `p` in the same loop iteration, on a path that neither rebinds nor
// replaces its place. Repetition is checked separately at each loop header.
struct Reach {
  entering: Vector<u64>
  leaving: Vector<u64>
}

effect fn reaching(walker: &Walker, moves: &[usize], width: usize) -> Reach ! OutOfMemoryError ? &mut Allocator {
  let points = Vector<Point>.asSlice(&walker.points)
  let events = Vector<Event>.asSlice(&walker.events)
  let mut entering = Vector<u64>.make()
  let mut leaving = Vector<u64>.make()
  let mut at = usize.ZERO
  while at < points.length * width {
    run Vector<u64>.append(&mut entering, 0)
    run Vector<u64>.append(&mut leaving, 0)
    at = at + usize.ONE
  }
  let mut changed = true
  while changed {
    changed = false
    let mut point = usize.ZERO
    while point < points.length {
      let mut word = usize.ZERO
      while word < width {
        let mut outs = Vector<u64>.asMutSlice(&mut leaving)
        outs[point * width + word] = Vector<u64>.asSlice(&entering)[point * width + word]
        word = word + usize.ONE
      }
      let recorded = points[point].event
      let mut bit = usize.ZERO
      while bit < moves.length {
        let moved = &events[moves[bit]].place
        let mut kill = points[point].initializes == moved.root
        if recorded != usize.MAX && events[recorded].kind == Kind.Write && covers(&events[recorded].place, moved) {
          kill = true
        }
        let slot = point * width + wordOf(bit)
        let mut outs = Vector<u64>.asMutSlice(&mut leaving)
        if kill {
          outs[slot] = u64.bitAnd(outs[slot], u64.bitNot(maskOf(bit)))
        }
        if recorded == moves[bit] {
          outs[slot] = u64.bitOr(outs[slot], maskOf(bit))
        }
        bit = bit + usize.ONE
      }
      let next = Vector<usize>.asSlice(&points[point].next)
      let mut successor = usize.ZERO
      while successor < next.length {
        if !isBackEdge(walker, point, next[successor]) {
          word = usize.ZERO
          while word < width {
            let slot = next[successor] * width + word
            let current = Vector<u64>.asSlice(&entering)[slot]
            let merged = u64.bitOr(current, Vector<u64>.asSlice(&leaving)[point * width + word])
            if merged != current {
              let mut ins = Vector<u64>.asMutSlice(&mut entering)
              ins[slot] = merged
              changed = true
            }
            word = word + usize.ONE
          }
        }
        successor = successor + usize.ONE
      }
      point = point + usize.ONE
    }
  }
  return Reach {entering: move entering, leaving: move leaving}
}

// Whether `place` is moved in state `state` of point `point`: some reaching move names exactly it.
fn movedIn(events: &[Event], moves: &[usize], state: &[u64], width: usize, point: usize, place: &Place) -> bool {
  let mut bit = usize.ZERO
  while bit < moves.length {
    if reaches(state, width, point, bit) && samePlace(&events[moves[bit]].place, place) {
      return true
    }
    bit = bit + usize.ONE
  }
  return false
}

fn samePlace(left: &Place, right: &Place) -> bool {
  return left.root == right.root && overlap(left, right) == usize.ONE
    && Vector<usize>.length(&left.steps) == Vector<usize>.length(&right.steps)
}

// Whether `local` is bound inside the loop, so it has no owner state at the header.
fn boundInside(walker: &Walker, repeat: &Loop, local: usize) -> bool {
  let points = Vector<Point>.asSlice(&walker.points)
  let mut point = repeat.header
  while point < repeat.end {
    if points[point].initializes == local {
      return true
    }
    point = point + usize.ONE
  }
  return false
}

// Whether a loop repeats with the same moved places of its outer locals as it enters with
// (the bootstrap's `OWN0005` otherwise).
fn compatibleHeader(walker: &Walker, events: &[Event], moves: &[usize], reach: &Reach, width: usize, repeat: &Loop) -> bool {
  if repeat.before == usize.MAX {
    return true
  }
  let leaving = Vector<u64>.asSlice(&reach.leaving)
  let sources = Vector<usize>.asSlice(&repeat.sources)
  let mut bit = usize.ZERO
  while bit < moves.length {
    let place = &events[moves[bit]].place
    if !boundInside(walker, repeat, place.root) {
      let entered = movedIn(events, moves, leaving, width, repeat.before, place)
      let mut index = usize.ZERO
      while index < sources.length {
        if movedIn(events, moves, leaving, width, sources[index], place) != entered {
          return false
        }
        index = index + usize.ONE
      }
    }
    bit = bit + usize.ONE
  }
  return true
}

fn reaches(entering: &[u64], width: usize, point: usize, bit: usize) -> bool {
  return u64.bitAnd(entering[point * width + wordOf(bit)], maskOf(bit)) != 0
}

/// Checks the loans of one typed body.
///
/// # Details
///
/// `owner` is the body's declaration, `locals` and `nodes` its typed locals and nodes, and `root`
/// its root node. Conflicts and uses of moved places are reported in evaluation order; the first
/// one is returned.
pub effect fn check(owner: &DeclarationId, locals: &[Local], nodes: &[Node], root: NodeId, pending: bool) -> Verdict
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut walker = Walker {
    points: Vector<Point>.make(),
    loans: Vector<Loan>.make(),
    events: Vector<Event>.make(),
    frames: Vector<Frame>.make(),
    loops: Vector<Loop>.make(),
    held: Vector<Vector<usize>>.make(),
    exit: usize.ZERO,
    outside: false,
    reason: BorrowStatus.Regions,
    guarded: Vector<usize>.make(),
    guardConsumed: Option<Span>.none(),
    crossed: false,
  }
  walker.exit = run newPoint(&mut walker, usize.MAX)
  let entry = run newPoint(&mut walker, usize.MAX)
  let flow = run visit(nodes, locals, owner, &mut walker, root, entry)
  // A guard may inspect its arm's bindings but not consume them: a later arm still receives the
  // unchanged payload when the guard is false (MATCH-002).
  if let Option<Span>.Some {value: consumed} = &walker.guardConsumed {
    return Verdict {outcome: Outcome.Conflict, status: BorrowStatus.Regions, code: RejectionCode.GuardConsumesPattern,
      access: consumed, earlier: Option<Span>.none()}
  }
  if walker.outside {
    return verdict(Outcome.NotChecked, walker.reason)
  }
  if !referentsOnly(&walker, Vector<Carry>.asSlice(&flow.carried)) {
    return verdict(Outcome.NotChecked, BorrowStatus.StoredLoans)
  }
  if flow.at != usize.MAX {
    cross(&mut walker, Vector<Carry>.asSlice(&flow.carried))
    run consume(&mut walker, Vector<Carry>.asSlice(&flow.carried), flow.at)
  }
  // Exit carries no events: scope-end storage ends are not modeled yet, so a `run`'s failure path
  // needs no edge to it. The regions slice adds both.
  let exit = walker.exit
  run edge(&mut walker, flow.at, exit)
  let mut bits = Vector<usize>.make()
  let mut count = usize.ZERO
  let mut local = usize.ZERO
  while local < locals.length {
    run Vector<usize>.append(&mut bits, count)
    if holds(&walker, local) {
      count = count + usize.ONE
    }
    local = local + usize.ONE
  }
  let width = (count + 63) / 64
  let mut liveOut = Vector<u64>.make()
  if width > usize.ZERO {
    liveOut = run liveness(&walker, Vector<usize>.asSlice(&bits), width)
  }
  let events = Vector<Event>.asSlice(&walker.events)
  let loans = Vector<Loan>.asSlice(&walker.loans)
  let mut moves = Vector<usize>.make()
  let mut at = usize.ZERO
  while at < events.length {
    if events[at].kind == Kind.Move || events[at].kind == Kind.Drop {
      run Vector<usize>.append(&mut moves, at)
    }
    at = at + usize.ONE
  }
  let moved = Vector<usize>.asSlice(&moves)
  let moveWidth = (moved.length + 63) / 64
  let mut reach = Reach {entering: Vector<u64>.make(), leaving: Vector<u64>.make()}
  if moveWidth > usize.ZERO {
    reach = run reaching(&walker, moved, moveWidth)
  }
  let loops = Vector<Loop>.asSlice(&walker.loops)
  let mut probe = verdict(Outcome.NotChecked, BorrowStatus.Imprecise)
  let mut checkedLoops = usize.ZERO
  let mut unknown = false
  at = usize.ZERO
  while at <= events.length {
    // A loop header is checked in evaluation order, before the first access after it.
    while checkedLoops < loops.length && (at == events.length || loops[checkedLoops].header < events[at].point) {
      if moveWidth > usize.ZERO && !compatibleHeader(&walker, events, moved, &reach, moveWidth, &loops[checkedLoops]) {
        let span = loops[checkedLoops].span
        return Verdict {outcome: Outcome.Conflict, status: BorrowStatus.Regions, code: RejectionCode.IncompatibleLoopHeader, access: span, earlier: Option<Span>.none()}
      }
      checkedLoops = checkedLoops + usize.ONE
    }
    if at == events.length {
      break
    }
    let event = &events[at]
    if event.consumesTarget == usize.ONE {
      return Verdict {outcome: Outcome.Conflict, status: BorrowStatus.Regions, code: RejectionCode.OverlappingAssignment, access: event.span,
        earlier: Option<Span>.none()}
    }
    if event.consumesTarget != usize.ZERO {
      if !unknown { probe = Verdict {outcome: Outcome.Conflict, status: BorrowStatus.Regions, code: RejectionCode.OverlappingAssignment, access: event.span, earlier: Option<Span>.none()} }
      unknown = true
    }
    let mut bit = usize.ZERO
    while bit < moved.length {
      let source = &events[moved[bit]]
      if reaches(Vector<u64>.asSlice(&reach.entering), moveWidth, event.point, bit) {
        let shared = overlap(&source.place, &event.place)
        if shared != usize.ZERO {
          // A replacement of the whole moved place reinitializes it, and a drop of an owner ends
          // the parts that remain after a part was moved out.
          let ends = event.kind == Kind.Drop && covers(&event.place, &source.place)
            && Vector<usize>.length(&event.place.steps) < Vector<usize>.length(&source.place.steps)
          if !ends && (event.kind != Kind.Write || !covers(&event.place, &source.place)) {
            // Inspecting the tag of an owner reads none of its moved parts.
            let partial = event.kind == Kind.Inspect && !covers(&source.place, &event.place)
            // A write behind a moved reference uses the reference to reach its referent.
            if shared == usize.ONE && (event.kind != Kind.Write || behind(&source.place, &event.place)) && !partial {
              return Verdict {outcome: Outcome.Conflict, status: BorrowStatus.Regions, code: RejectionCode.UseAfterMove, access: event.span, earlier: Option<Span>.some(source.span)}
            }
            // A partial replacement of a moved place, or an overlap decided by an unknown index.
            if !partial {
              if !unknown { probe = Verdict {outcome: Outcome.Conflict, status: BorrowStatus.Regions, code: RejectionCode.UseAfterMove, access: event.span, earlier: Option<Span>.some(source.span)} }
              unknown = true
            }
          }
        }
      }
      bit = bit + usize.ONE
    }
    let mut index = usize.ZERO
    while index < loans.length {
      if index != event.loan {
        let code = conflictCode(event.kind, loans[index].exclusive)
        if let Option<RejectionCode>.Some {value} = move code {
          let mut shared = overlap(&loans[index].place, &event.place)
          if shared != usize.ZERO && behind(&event.place, &loans[index].place) {
            // Replacing a reference leaves the referent it lent untouched. Moving or dropping it
            // while its referent is reborrowed is not decided here.
            if event.kind == Kind.Write {
              shared = usize.ZERO
            } else if event.kind == Kind.Move || event.kind == Kind.Drop {
              shared = 2
            }
          }
          if shared != usize.ZERO {
            let mut live = inFlight(&loans[index], event.point)
            if !live && width > usize.ZERO {
              live = heldLive(&loans[index], Vector<usize>.asSlice(&bits), Vector<u64>.asSlice(&liveOut), width, event.point)
            }
            if live {
              // An approximate loan's conflict is not a proof either way: the body answers
              // `imprecise`, which is unchecked, never `Checked`.
              if shared == usize.ONE && !loans[index].approximate {
                return Verdict {outcome: Outcome.Conflict, status: BorrowStatus.Regions, code: value, access: event.span, earlier: Option<Span>.some(loans[index].origin)}
              }
              if !unknown {
                let mut cause = RejectionCode.AmbiguousLifetime
                if loans[index].approximate { cause = RejectionCode.Unsupported }
                probe = Verdict {outcome: Outcome.Conflict, status: BorrowStatus.Regions, code: cause, access: event.span, earlier: Option<Span>.some(loans[index].origin)}
              }
              unknown = true
            }
          }
        }
      }
      index = index + usize.ONE
    }
    at = at + usize.ONE
  }
  if unknown {
    return move probe
  }
  if !pending && !walker.crossed && run regionClosed(owner, locals, nodes) {
    return verdict(Outcome.Clear, BorrowStatus.Checked)
  }
  return verdict(Outcome.Clear, BorrowStatus.Regions)
}

/// Whether every region a body's locals and values name is `'static` or a loan region of the body
/// itself, so its loans and their scopes are the whole region proof.
///
/// # Details
///
/// In a body the walk clears, no loan outlives its root's scope: a loan stays live past the
/// expression that creates it only through a `let` holder, which is bound after its root in the
/// same or a nested scope and released before it. A read out of a holder (a field, an index or a
/// binding of a match on it) carries the holder's loans, so a holder bound from it is again bound
/// later in the same or a nested scope. Every value that would carry a loan of a body local across
/// a scope boundary (a block, branch or arm result, a carrying subject, a return, an assignment or
/// a `let mut` holder) leaves the walk with `stored-loans`. A referent loan that crosses one marks
/// the body crossed, which is never `Checked`. A lifetime parameter, invocation lifetime
/// or supplied region names validity outside the body, which the region slices prove later. A call
/// result keeps an operand's region only by naming it: an interface operation's witness must keep
/// exactly the regions the operation names (`witnessLifetimeEnvironments` in
/// SemanticConformanceCases), so a result typed by an open parameter keeps no loan of this body.
pub effect fn regionClosed(owner: &DeclarationId, locals: &[Local], nodes: &[Node]) -> bool ! OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < locals.length {
    if !run typeRegionClosed(&locals[at].ty, owner) {
      return false
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < nodes.length {
    if let NodeKind.Expression {ty, ..} = &nodes[at].kind {
      if !run typeRegionClosed(&ty, owner) {
        return false
      }
    }
    at = at + usize.ONE
  }
  return true
}

effect fn typeRegionClosed(ty: &Shared<Type>, owner: &DeclarationId) -> bool ! OutOfMemoryError ? &mut Allocator {
  let mut atoms = Vector<Shared<Lifetime>>.make()
  run Type.regionAtoms(ty, &mut atoms)
  let listed = Vector<Shared<Lifetime>>.asSlice(&atoms)
  let mut at = usize.ZERO
  while at < listed.length {
    let local = Shared<Lifetime>.with<bool>(&listed[at], fn(region: &Lifetime) -> bool {
      return match &region.* {
        Lifetime.Static => true
        Lifetime.Local {declaration, ..} => DeclarationId.equals(&declaration, owner)
        _ => false
      }
    })
    if !local {
      return false
    }
    at = at + usize.ONE
  }
  return true
}
