          &resolver.*, module, cursor, expression, span, receiver, &target.declaration))
      }
      if target.explicitSyntax {
        if let Option<Shared<Rejection>>.Some {value: unproven} = move run unprovenExplicitConformanceRejection(
          &mut resolver.*, module, &inference, &freshOwner, &target.declaration,
          originalBinderCount, explicitOrdinals, List<Binding>.asSlice(&inferred), unresolvedAt, span) {
          return Result<BodyNodeId, Shared<Rejection>>.failResult(move unproven)
        }
