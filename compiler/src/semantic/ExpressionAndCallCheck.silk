      return run bodyRejection(&resolver.*, module, RejectionCode.Undetermined, span)
    }
    at = at + usize.ONE
  }
  let waiting = List<DeferredLambda>.asSlice(&deferredLambdas)
  let mut waitingAt = usize.ZERO
  while waitingAt < waiting.length {
    let noCaptures = List<Interned<Type>>.make()
    let argument = run checkInferredCallArgument(&mut resolver.*, &mut owner.*, &mut request.*,
      &mut dependencies.*, module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*,
      &mut requiredBodies.*, waiting[waitingAt].argument, &waiting[waitingAt].parameter, &inference,
      List<Interned<Type>>.asSlice(&noCaptures), &freshOwner, List<Interned<DeclarationId>>.asSlice(&variables), explicitOrdinals,
      target.explicitSyntax, &mut inferred, expression, span, constraints, contractBody, staticBody, unsafeAllowed)
    match move argument {
      Result<BodyNodeId, Shared<Rejection>>.Success {value: node} => {
        List<BodyNodeId>.set(&mut typedArguments, waiting[waitingAt].slot, node)
      }
      Result<BodyNodeId, Shared<Rejection>>.Failure {error} => {
        return Result<BodyNodeId, Shared<Rejection>>.failResult(move error)
      }
    }
    waitingAt = waitingAt + usize.ONE
  }
