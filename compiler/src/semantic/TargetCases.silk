test effect fn frozenTargetRequiresExplicitSelection() -> ()
! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let input = ProfileInput.make()
  let attempted = run Effect.result(InitialProfile.freeze(&input))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let missing = match move attempted {
    Result<InitialProfile, ProfileProblem | OutOfMemoryError>.Failure {error} => match move error {
      ProfileProblem {kind, field} => kind == ProfileProblemKind.InvalidInput && field == ProfileField.Target
      OutOfMemoryError {} => false
    }
    Result<InitialProfile, ProfileProblem | OutOfMemoryError>.Success {value: _} => false
  }
  run Testing.expect(missing, "a missing target is rejected without host inference")
  return ()
}

test effect fn frozenTargetDefinesPointerSizedRangesWithoutChangingTypeIdentity() -> ()
! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let wasm = MachineTarget.resolve(b"wasm32-unknown-unknown")
  let native = MachineTarget.resolve(b"x86_64-unknown-linux-gnu")
  if let Option<MachineTarget>.Some {value: wasmTarget} = move wasm {
    if let Option<MachineTarget>.Some {value: nativeTarget} = move native {
      let usizeName = run Bytes.copy(b"usize")
        |> Effect.provideMut<Allocator>(&mut allocator)
      let u64Name = run Bytes.copy(b"u64")
        |> Effect.provideMut<Allocator>(&mut allocator)
      let usizeType = run Types.intern(Type.Primitive {name: move usizeName})
        |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
      let u64Type = run Types.intern(Type.Primitive {name: move u64Name})
        |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
      let sameType = run Type.equalsShared(&usizeType, &u64Type)
        |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
      run Testing.expect(
        MachineTarget.pointerBits(&wasmTarget) == 32 && MachineTarget.pointerBits(&nativeTarget) == 64 && MachineTarget.fitsUsize(
          &wasmTarget,
          b"4294967295",
        ) && !MachineTarget.fitsUsize(&wasmTarget, b"4294967296") && MachineTarget.fitsUsize(
          &nativeTarget,
          b"4294967296",
        ) && !MachineTarget.fitsIsize(&wasmTarget, false, b"2147483648") && !MachineTarget.fitsUsize(
          &nativeTarget,
          b"18446744073709551616",
        ) && !sameType,
        "pointer-sized ranges follow the target while usize and u64 remain distinct",
      )
    } else {
      run Testing.expect(false, "native target resolves")
    }
  } else {
    run Testing.expect(false, "wasm target resolves")
  }
  return ()
}

test effect fn frozenTargetRejectsUnsupportedLogicalChoices() -> ()
! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut input = ProfileInput.make()
  input.target = Option<Bytes>.some(
    run Bytes.copy(b"aarch64-apple-darwin")
      |> Effect.provideMut<Allocator>(&mut allocator),
  )
  input.cpu = Option<Bytes>.some(
    run Bytes.copy(b"unknown")
      |> Effect.provideMut<Allocator>(&mut allocator),
  )
  let badCpu = run Effect.result(InitialProfile.freeze(&input))
    |> Effect.provideMut<Allocator>(&mut allocator)
  input.cpu = Option<Bytes>.none()
  input.libc = Option<Bytes>.some(
    run Bytes.copy(b"gnu")
      |> Effect.provideMut<Allocator>(&mut allocator),
  )
  let badLibc = run Effect.result(InitialProfile.freeze(&input))
    |> Effect.provideMut<Allocator>(&mut allocator)
  input.libc = Option<Bytes>.none()
  run appendProfileName(&mut input.sanitizers, b"address")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run appendProfileName(&mut input.sanitizers, b"thread")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let badSanitizers = run Effect.result(InitialProfile.freeze(&input))
    |> Effect.provideMut<Allocator>(&mut allocator)
  input.sanitizers = Vector<Bytes>.make()
  run appendProfileName(&mut input.sanitizers, b"memory")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let unknownSanitizer = run Effect.result(InitialProfile.freeze(&input))
    |> Effect.provideMut<Allocator>(&mut allocator)
  input.sanitizers = Vector<Bytes>.make()
  input.target = Option<Bytes>.some(
    run Bytes.copy(b"wasm32-unknown-unknown")
      |> Effect.provideMut<Allocator>(&mut allocator),
  )
  input.link = Option<Bytes>.some(
    run Bytes.copy(b"dynamic")
      |> Effect.provideMut<Allocator>(&mut allocator),
  )
  let nativeOnlyWasm = run Effect.result(InitialProfile.freeze(&input))
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    profileFailure(move badCpu, ProfileField.Cpu) && profileFailure(move badLibc, ProfileField.Libc) && profileFailure(
      move badSanitizers,
      ProfileField.Sanitizers,
    ) && profileInvalid(move unknownSanitizer, ProfileField.Sanitizers) && profileFailure(
      move nativeOnlyWasm,
      ProfileField.Target,
    ),
    "invalid CPU, libc, sanitizer, and native-only WebAssembly choices are rejected",
  )
  return ()
}

fn profileFailure(
  result: Result<InitialProfile, ProfileProblem | OutOfMemoryError>,
  field: ProfileField,
) -> bool {
  return match move result {
    Result<InitialProfile, ProfileProblem | OutOfMemoryError>.Failure {error} => match move error {
      ProfileProblem {kind, field: rejected} => kind == ProfileProblemKind.UnsupportedCombination && rejected == field
      OutOfMemoryError {} => false
    }
    Result<InitialProfile, ProfileProblem | OutOfMemoryError>.Success {value: _} => false
  }
}

fn profileInvalid(
  result: Result<InitialProfile, ProfileProblem | OutOfMemoryError>,
  field: ProfileField,
) -> bool {
  return match move result {
    Result<InitialProfile, ProfileProblem | OutOfMemoryError>.Failure {error} => match move error {
      ProfileProblem {kind, field: rejected} => kind == ProfileProblemKind.InvalidInput && rejected == field
      OutOfMemoryError {} => false
    }
    Result<InitialProfile, ProfileProblem | OutOfMemoryError>.Success {value: _} => false
  }
}

effect fn appendProfileName(values: &mut Vector<Bytes>, name: &[u8]) -> ()
! OutOfMemoryError
? &mut Allocator {
  return run Vector<Bytes>.append(move values, run Bytes.copy(name))
}

test effect fn frozenTargetNormalizesUnorderedSetsAndSealsQueries() -> ()
! OutOfMemoryError | ProfileProblem | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let mut first = ProfileInput.make()
  let mut second = ProfileInput.make()
  first.target = Option<Bytes>.some(
    run Bytes.copy(b"x86_64-unknown-linux-gnu")
      |> Effect.provideMut<Allocator>(&mut allocator),
  )
  second.target = Option<Bytes>.some(
    run Bytes.copy(b"x86_64-unknown-linux-gnu")
      |> Effect.provideMut<Allocator>(&mut allocator),
  )
  run appendProfileName(&mut first.cpuFeatures, b"avx2")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run appendProfileName(&mut first.cpuFeatures, b"aes")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run appendProfileName(&mut second.cpuFeatures, b"aes")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run appendProfileName(&mut second.cpuFeatures, b"avx2")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run appendProfileName(&mut second.cpuFeatures, b"avx2")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run appendProfileName(&mut first.sanitizers, b"undefined")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run appendProfileName(&mut first.sanitizers, b"address")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run appendProfileName(&mut second.sanitizers, b"address")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run appendProfileName(&mut second.sanitizers, b"undefined")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let left = run InitialProfile.freeze(&first)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let right = run InitialProfile.freeze(&second)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let avx = InitialProfile.contains(&left, b"cpu-features", b"avx")
  let invalid = InitialProfile.text(&left, b"host")
  let same = InitialProfile.sameIdentity(&left, &right)
  let hasAvx = match move avx {
    Option<bool>.Some {value} => value
    Option<bool>.None => false
  }
  let invalidKey = match move invalid {
    Option<&[u8]>.None => true
    Option<&[u8]>.Some {value: _} => false
  }
  let schemas = Vector<RegisteredShape>.make()
  let firstFinal = run FinalProfile.publish(
    move left,
    Vector<RegisteredShape>.asSlice(&schemas),
    Vector<FinalEntry>.make(), Vector<DeclarationId>.asSlice(&Vector<DeclarationId>.make()))
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let secondFinal = run FinalProfile.publish(
    move right,
    Vector<RegisteredShape>.asSlice(&schemas),
    Vector<FinalEntry>.make(), Vector<DeclarationId>.asSlice(&Vector<DeclarationId>.make()))
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut complete = false
  if let Result<FinalProfile, FinalProblem>.Success {value: firstProfile} = move firstFinal {
    if let Result<FinalProfile, FinalProblem>.Success {value: secondProfile} = move secondFinal {
      let libc = FinalProfile.text(&firstProfile, b"libc")
      let debug = FinalProfile.flag(&firstProfile, b"debug")
      let unsupported = FinalProfile.contains(&firstProfile, b"host", b"x")
      let stable = run FinalProfile.sameIdentity(&firstProfile, &secondProfile)
        |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
      let linuxLibc = match move libc {
        Option<&[u8]>.Some {value} => value.length == 3 && value[0] == 103
        Option<&[u8]>.None => false
      }
      let debugEnabled = match move debug {
        Option<bool>.Some {value} => value
        Option<bool>.None => false
      }
      let closed = match move unsupported {
        Option<bool>.None => true
        Option<bool>.Some {value: _} => false
      }
      complete = stable && linuxLibc && debugEnabled && closed
    }
  }
  run Testing.expect(
    same && hasAvx && invalidKey && complete,
    "unordered sets normalize identically and arbitrary profile keys stay unavailable",
  )
  return ()
}

struct AnswerView {
  success: bool
  dependencies: usize
}

effect fn suppliedInteger(name: &[u8], decimal: &[u8], tier: BindingTier, provenance: BindingProvenance) -> SuppliedBinding
! OutOfMemoryError ? &mut Allocator {
  return SuppliedBinding {
    package: run Bytes.copy(b"example"),
    module: run Bytes.copy(b"registered-parameters.silk"),
    parameter: run Bytes.copy(name),
    value: BindingInput.Integer {decimal: run Bytes.copy(decimal)},
    provenance: move provenance,
    tier: tier,
  }
}

fn makeSemantic(revision: Revision) -> Semantic {
  return Semantic.traced(move revision, MachineTarget.forId(TargetId.Aarch64AppleDarwin), Option<FinalProfile>.none())
}

fn inspect(answer: &Result<Answer, NoRejection>) -> AnswerView {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: _} => AnswerView {
        success: true,
        dependencies: Vector.length(&value.dependencies),
      }
      Outcome.Rejected {diagnostic: _} => AnswerView {
        success: false,
        dependencies: Vector.length(&value.dependencies),
      }
    }
    Result<Answer, NoRejection>.Failure {error: _} => AnswerView {
      success: false,
      dependencies: usize.ZERO,
    }
  }
}

fn rejection(answer: &Result<Answer, NoRejection>) -> Option<Shared<Rejection>> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Rejected {diagnostic} => Option<Shared<Rejection>>.some(
        Shared<Rejection>.clone(&diagnostic),
      )
      Outcome.Success {value: _} => Option<Shared<Rejection>>.none()
    }
    Result<Answer, NoRejection>.Failure {error: _} => Option<Shared<Rejection>>.none()
  }
}

fn sameBytes(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

fn starts(events: &[SemanticEvent], family: Family) -> usize {
  let mut count = usize.ZERO
  let mut at = usize.ZERO
  while at < events.length {
    if events[at].kind == EventKind.Start && events[at].family == family {
      count = count + usize.ONE
    }
    at = at + usize.ONE
  }
  return count
}

effect fn module(path: string) -> ModuleId ! InvalidModulePath | OutOfMemoryError ? &mut Allocator {
  return run ModuleId.make(b"memory", b"example", String.utf8Bytes(path))
}

effect fn present(text: string) -> Option<Bytes> ! OutOfMemoryError ? &mut Allocator {
  return Option<Bytes>.some(run Bytes.copy(String.utf8Bytes(text)))
}

fn rejectsWith(answer: &Shared<Result<Answer, NoRejection>>, code: RejectionCode) -> bool {
  let found = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(answer, rejection)
  if let Option<Shared<Rejection>>.Some {value} = move found {
    return Shared<Rejection>.with<bool>(
      &value,
      fn(diagnostic: &Rejection) -> bool {
        return diagnostic.code == code
      },
    )
  }
  return false
}

// Elided and spelled invocation binders give the same callable contract across declarations.
fn sameMagnitude(value: u64, digits: &[u8]) -> bool {
  if value == 0 { return digits.length == usize.ONE && digits[0] == 48 }
  let mut remaining = value
  let mut at = digits.length
  while remaining > 0 {
    if at == usize.ZERO { return false }
    at = at - usize.ONE
    if digits[at] != u64.toU8(48 + u64.remainder(remaining, 10)) { return false }
    remaining = u64.divide(remaining, 10)
  }
  return at == usize.ZERO
}

fn constantInteger(answer: &Result<Answer, NoRejection>, digits: &[u8]) -> bool {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Initializer {value: found}} => Shared<StaticData>.with<bool>(
        &found,
        fn(constant: &StaticData) -> bool {
          return match & constant.* {
            StaticData.Integer {sign, magnitude, ..} => sign == StaticSign.Positive && sameMagnitude(magnitude, digits)
            _ => false
          }
        },
      )
      _ => false
    }
    Result<Answer, NoRejection>.Failure {error: _} => false
  }
}

fn constantTrue(answer: &Result<Answer, NoRejection>) -> bool {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Initializer {value: found}} => Shared<StaticData>.with<bool>(
        &found,
        fn(constant: &StaticData) -> bool {
          return match & constant.* {
            StaticData.Boolean {value: truth} => truth
            _ => false
          }
        },
      )
      _ => false
    }
    Result<Answer, NoRejection>.Failure {error: _} => false
  }
}

fn constantText(answer: &Result<Answer, NoRejection>, expected: &[u8]) -> bool {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Initializer {value: found}} => Shared<StaticData>.with<bool>(
        &found,
        fn(constant: &StaticData) -> bool {
          return match & constant.* {
            StaticData.Text {bytes} => sameBytes(Bytes.asSlice(&bytes), expected)
            _ => false
          }
        },
      )
      _ => false
    }
    Result<Answer, NoRejection>.Failure {error: _} => false
  }
}


fn sourceEnumCaseMatches(case: &BindingEnumMember, name: &[u8], ordinal: usize, magnitude: u64) -> bool {
  if !sameBytes(Bytes.asSlice(&case.name), name) { return false }
  return Shared<StaticData>.with<bool>(&case.value, fn(value: &StaticData) -> bool {
    return match &value.* {
      StaticData.Enum {member, representation, sign, magnitude: actual, ..} =>
        member == ordinal && representation == StaticIntegerType.U8 &&
        sign == StaticSign.Positive && actual == magnitude
      _ => false
    }
  })
}

fn sourceFieldIsU8(shape: &BindingShape) -> bool {
  return match &shape.* {
    BindingShape.Integer {kind, bits} => kind == StaticIntegerType.U8 && bits == 8
    _ => false
  }
}

effect fn resolvedParameterShapeClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | RegistrationClosed | ConflictingPackageSource | ProfileProblem | AssertionError<'static>
? &mut Allocator | &mut Types {
  let entry = run module("registered-shapes.silk")
  let source = run present("""
pub param card: Card
pub struct Card { pub code: u8 }
pub enum Choice { Open, Closed }
pub union Maybe { None, Some { pub value: bool } }
pub param choice: Choice
pub param maybe: Maybe
pub param cells: [u16; 1 + 2]
""")
  let revision = run Revision.publish(&Revision.make(), &entry, &source)
  let mut semantic = makeSemantic(move revision)
  let mut request = Request.make()
  run Request.registerSchemaModule(&mut request, &entry)
  let selected = MachineTarget.resolve(b"x86_64-unknown-linux-gnu")
  if let Option<MachineTarget>.Some {value: target} = move selected {
    let result = run ProfileShape.registered(&mut semantic, &mut request, &target)
    let mut record = false
    let mut enumeration = false
    let mut optional = false
    let mut array = false
    let mut resourceRejected = false
    if let Result<ProfileRegistered, ProfileShapeProblem>.Success {value: shapes} = move result {
      let listed = Vector<RegisteredShape>.asSlice(&shapes.schemas)
      let mut at = usize.ZERO
      while at < listed.length {
        let name = Shared<ParameterSchema>.with<u8>(&listed[at].schema, fn(value: &ParameterSchema) -> u8 {
          if DeclarationId.named(&value.declaration, b"card") { return 1 }
          if DeclarationId.named(&value.declaration, b"choice") { return 2 }
          if DeclarationId.named(&value.declaration, b"maybe") { return 3 }
          if DeclarationId.named(&value.declaration, b"cells") { return 4 }
          return 0
        })
        if name == 1 {
          if let BindingShape.Record {fields} = &listed[at].shape {
            let members = Vector<BindingNamedShape>.asSlice(&fields)
            if members.length == usize.ONE {
              let field = &members[usize.ZERO]
              let fieldType = Shared<Type>.with<bool>(&field.ty, fn(value: &Type) -> bool {
                return match &value.* {
                  Type.Primitive {name: primitive} => sameBytes(Bytes.asSlice(&primitive), b"u8")
                  _ => false
                }
              })
              let child = Box<BindingShape>.get(&field.value)
              let fieldShape = sourceFieldIsU8(&child[usize.ZERO])
              record = sameBytes(Bytes.asSlice(&field.name), b"code") && fieldType && fieldShape
            }
          }
        } else if name == 2 {
          if let BindingShape.Enum {canonical, members} = &listed[at].shape {
            let cases = Vector<BindingEnumMember>.asSlice(&members)
            enumeration = sameBytes(Bytes.asSlice(&canonical), b"example/registered-shapes.silk/Choice") &&
              cases.length == 2 &&
              sourceEnumCaseMatches(&cases[usize.ZERO], b"Open", usize.ZERO, 0) &&
              sourceEnumCaseMatches(&cases[1], b"Closed", usize.ONE, 1)
          }
        } else if name == 3 {
          if let BindingShape.Optional {absent, present, ..} = &listed[at].shape { optional = absent == 0 && present == 1 }
        } else if name == 4 {
          if let BindingShape.Array {length, ..} = &listed[at].shape { array = length == 3 }
        }
        at = at + usize.ONE
      }
      let mut input = ProfileInput.make()
      input.target = Option<Bytes>.some(run Bytes.copy(b"x86_64-unknown-linux-gnu"))
      let facts = run InitialProfile.freeze(&input)
      let keys = Vector<RegisteredParameter>.asSlice(&shapes.parameters)
      let mut candidates = Vector<FinalEntry>.make()
      let mut keyAt = usize.ZERO
      while keyAt < keys.length {
        run Vector<FinalEntry>.append(&mut candidates, FinalEntry {
          declaration: DeclarationId.copy(&keys[keyAt].identity),
          value: run Shared<StaticData>.make(StaticData.Unit),
          origin: FinalOrigin.Default {span: Span.make(usize.ZERO, usize.ZERO)},
        })
        keyAt = keyAt + usize.ONE
      }
      let attempted = run FinalProfile.publish(move facts, listed, move candidates, Vector<DeclarationId>.asSlice(&Vector<DeclarationId>.make()))
      resourceRejected = match move attempted {
        Result<FinalProfile, FinalProblem>.Failure {error} => error == FinalProblem.ResourceSafetyNotChecked
        _ => false
      }
    }
    run Testing.expect(record && enumeration && optional && array && resourceRejected, "source shapes resolve, but unproved nominal resource safety blocks final publication")
  } else {
    run Testing.expect(false, "the selected target resolves")
  }
  return ()
}

test effect fn profileRegisteredShapesResolveSourceMembers() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | RegistrationClosed | ConflictingPackageSource | ProfileProblem | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run resolvedParameterShapeClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn recursiveParameterShapeClaim() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | RegistrationClosed | ConflictingPackageSource | AssertionError<'static>
? &mut Allocator | &mut Types {
  let entry = run module("recursive-shape.silk")
  let source = run present("""
pub struct Node { pub next: Node }
pub param root: Node
""")
  let revision = run Revision.publish(&Revision.make(), &entry, &source)
  let mut semantic = makeSemantic(move revision)
  let mut request = Request.make()
  run Request.registerSchemaModule(&mut request, &entry)
  let target = MachineTarget.forId(TargetId.X8664UnknownLinuxGnu)
  let resolved = run ProfileShape.registered(&mut semantic, &mut request, &target)
  let rejects = match move resolved {
    Result<ProfileRegistered, ProfileShapeProblem>.Failure {error} => error == ProfileShapeProblem.RecursiveShape
    _ => false
  }
  run Testing.expect(rejects, "registered recursive value schema rejects before a partial shape escapes")
  return ()
}

test effect fn profileRegisteredShapeCycleRejects() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | RegistrationClosed | ConflictingPackageSource | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run recursiveParameterShapeClaim() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

fn currentBindingOrigin(profile: &FinalProfile) -> bool {
  let entries = FinalProfile.entries(profile)
  if entries.length != usize.ONE { return false }
  return match &entries[usize.ZERO].origin {
    FinalOrigin.Binding {ordinal, ..} => ordinal == usize.ZERO
    _ => false
  }
}

fn currentDefaultOrigin(profile: &FinalProfile) -> bool {
  let entries = FinalProfile.entries(profile)
  if entries.length != usize.ONE { return false }
  return match &entries[usize.ZERO].origin {
    FinalOrigin.Default {span} => span.end > span.start
    _ => false
  }
}

effect fn finalProfileSelectionClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | RegistrationClosed | ConflictingPackageSource | ProfileProblem | AssertionError<'static>
? &mut Allocator | &mut Types {
  let entry = run module("registered-parameters.silk")
  let source = run present("""
pub param workers: u32 = 2
""")
  let revision = run Revision.publish(&Revision.make(), &entry, &source)
  let target = MachineTarget.forId(TargetId.X8664UnknownLinuxGnu)
  let mut semantic = Semantic.traced(move revision, target, Option<FinalProfile>.none())
  let mut request = Request.make()
  run Request.registerSchemaModule(&mut request, &entry)
  let resolved = run ProfileShape.registered(&mut semantic, &mut request, &target)
  if let Result<ProfileRegistered, ProfileShapeProblem>.Success {value: registered} = move resolved {
    let keys = Vector<RegisteredParameter>.asSlice(&registered.parameters)
    if keys.length == usize.ONE {
      let mut firstInput = ProfileInput.make()
      firstInput.target = Option<Bytes>.some(run Bytes.copy(b"x86_64-unknown-linux-gnu"))
      let firstFacts = run InitialProfile.freeze(&firstInput)
      let mut secondInput = ProfileInput.make()
      secondInput.target = Option<Bytes>.some(run Bytes.copy(b"x86_64-unknown-linux-gnu"))
      let secondFacts = run InitialProfile.freeze(&secondInput)
      let mut supplied = Vector<SuppliedBinding>.make()
      run Vector<SuppliedBinding>.append(&mut supplied, run suppliedInteger(b"workers", b"2", BindingTier.Override, BindingProvenance.Literal))
      let first = run assembleProfile(move firstFacts, &mut semantic, &mut request, &registered, move supplied)
      let second = run assembleProfile(move secondFacts, &mut semantic, &mut request, &registered, Vector<SuppliedBinding>.make())
      let mut correct = false
      if let Result<FinalProfile, FinalAssemblyProblem>.Success {value: overrideProfile} = move first {
        if let Result<FinalProfile, FinalAssemblyProblem>.Success {value: defaultProfile} = move second {
          let entries = FinalProfile.entries(&overrideProfile)
          if entries.length == usize.ONE {
            let selected = Shared<StaticData>.with<bool>(&entries[usize.ZERO].value, fn(value: &StaticData) -> bool {
              return match &value.* {
                StaticData.Integer {ty, magnitude, ..} => ty == StaticIntegerType.U32 && magnitude == 2
                _ => false
              }
            })
            let currentOrigin = match &entries[usize.ZERO].origin {
              FinalOrigin.Binding {ordinal, ..} => ordinal == usize.ZERO
              _ => false
            }
            let defaultEntries = FinalProfile.entries(&defaultProfile)
            let defaultOrigin = defaultEntries.length == usize.ONE && match &defaultEntries[usize.ZERO].origin {
              FinalOrigin.Default {span} => span.end > span.start
              _ => false
            }
            let defaultValue = defaultEntries.length == usize.ONE && Shared<StaticData>.with<bool>(
              &defaultEntries[usize.ZERO].value,
              fn(value: &StaticData) -> bool {
                return match &value.* {
                  StaticData.Integer {ty, magnitude, ..} => ty == StaticIntegerType.U32 && magnitude == 2
                  _ => false
                }
              },
            )
            let equalProfiles = run FinalProfile.sameIdentity(&overrideProfile, &defaultProfile)
            correct = selected && currentOrigin && defaultOrigin && defaultValue && equalProfiles &&
              FinalProfile.deferredStatus(&overrideProfile, FinalDeferredGap.BootstrapDomain) == FinalDeferredStatus.BootstrapDomainNotChecked
            let currentRevision = run Revision.publish(&Revision.make(), &entry, &source)
            let mut currentSemantic = Semantic.traced(
              move currentRevision, target, Option<FinalProfile>.some(move overrideProfile),
            )
            let firstCurrent = match move Semantic.profile(&currentSemantic) {
              Option<&FinalProfile>.Some {value: active} => currentBindingOrigin(active)
              Option<&FinalProfile>.None => false
            }
            run Semantic.reviseProfile(&mut currentSemantic, Option<FinalProfile>.some(move defaultProfile))
            let secondCurrent = match move Semantic.profile(&currentSemantic) {
              Option<&FinalProfile>.Some {value: active} => currentDefaultOrigin(active)
              Option<&FinalProfile>.None => false
            }
            correct = correct && firstCurrent && secondCurrent
          }
        }
      }
      let mut missingInput = ProfileInput.make()
      missingInput.target = Option<Bytes>.some(run Bytes.copy(b"x86_64-unknown-linux-gnu"))
      let missingFacts = run InitialProfile.freeze(&missingInput)
      let incomplete = run FinalProfile.publish(
        move missingFacts,
        Vector<RegisteredShape>.asSlice(&registered.schemas),
        Vector<FinalEntry>.make(), Vector<DeclarationId>.asSlice(&Vector<DeclarationId>.make()))
      let noPartial = match move incomplete {
        Result<FinalProfile, FinalProblem>.Failure {error} => error == FinalProblem.MissingParameter
        _ => false
      }
      run Testing.expect(correct && noPartial, "override selection keeps current origins and never publishes a partial profile")
    } else {
      run Testing.expect(false, "one registered parameter is available")
    }
  } else {
    run Testing.expect(false, "registered parameter shape resolves")
  }
  return ()
}

test effect fn finalProfileSelectsBindingsAndRetainsOrigins() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | RegistrationClosed | ConflictingPackageSource | ProfileProblem | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run finalProfileSelectionClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn profileAssemblyTargetClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | RegistrationClosed | ConflictingPackageSource | ProfileProblem | AssertionError<'static>
? &mut Allocator | &mut Types {
  let entry = run module("target-default.silk")
  let source = run present("""
pub param bits: u32 = Intrinsic.targetPointerBits()
""")
  let nativeTarget = MachineTarget.forId(TargetId.X8664UnknownLinuxGnu)
  let nativeRevision = run Revision.publish(&Revision.make(), &entry, &source)
  let mut nativeSemantic = Semantic.traced(move nativeRevision, nativeTarget, Option<FinalProfile>.none())
  let mut nativeRequest = Request.make()
  run Request.registerSchemaModule(&mut nativeRequest, &entry)
  let nativeRegistered = run ProfileShape.registered(&mut nativeSemantic, &mut nativeRequest, &nativeTarget)
  let mut nativeInput = ProfileInput.make()
  nativeInput.target = Option<Bytes>.some(run Bytes.copy(b"x86_64-unknown-linux-gnu"))
  let nativeFacts = run InitialProfile.freeze(&nativeInput)
  if let Result<ProfileRegistered, ProfileShapeProblem>.Success {value: nativeShapes} = move nativeRegistered {
    let assembled = run assembleProfile(
      move nativeFacts, &mut nativeSemantic, &mut nativeRequest, &nativeShapes,
      Vector<SuppliedBinding>.make(),
    )
    let mut nativeBits = false
    if let Result<FinalProfile, FinalAssemblyProblem>.Success {value: profile} = move assembled {
      let entries = FinalProfile.entries(&profile)
      nativeBits = entries.length == usize.ONE && Shared<StaticData>.with<bool>(
        &entries[usize.ZERO].value,
        fn(value: &StaticData) -> bool {
          return match &value.* {
            StaticData.Integer {ty, magnitude, ..} => ty == StaticIntegerType.U32 && magnitude == 64
            _ => false
          }
        },
      )
    }
    run Testing.expect(nativeBits, "a source default observes its supplied native target")
    let beforeMismatch = starts(Semantic.eventLog(&nativeSemantic), Family.ParameterDefault)
    let mut wasmInput = ProfileInput.make()
    wasmInput.target = Option<Bytes>.some(run Bytes.copy(b"wasm32-unknown-unknown"))
    let wrongFacts = run InitialProfile.freeze(&wasmInput)
    let mismatched = run assembleProfile(
      move wrongFacts, &mut nativeSemantic, &mut nativeRequest, &nativeShapes,
      Vector<SuppliedBinding>.make(),
    )
    let rejected = match move mismatched {
      Result<FinalProfile, FinalAssemblyProblem>.Failure {error} => match move error {
        FinalAssemblyProblem.InputMismatch => true
        _ => false
      }
      _ => false
    }
    run Testing.expect(
      rejected && starts(Semantic.eventLog(&nativeSemantic), Family.ParameterDefault) == beforeMismatch,
      "changed target facts reject before a cached native default can be reused",
    )
    let mut changedInput = ProfileInput.make()
    changedInput.target = Option<Bytes>.some(run Bytes.copy(b"x86_64-unknown-linux-gnu"))
    changedInput.debug = Option<bool>.some(false)
    let changedFacts = run InitialProfile.freeze(&changedInput)
    let changed = run assembleProfile(
      move changedFacts, &mut nativeSemantic, &mut nativeRequest, &nativeShapes,
      Vector<SuppliedBinding>.make(),
    )
    let changedRejected = match move changed {
      Result<FinalProfile, FinalAssemblyProblem>.Failure {error} => match move error {
        FinalAssemblyProblem.InputMismatch => true
        _ => false
      }
      _ => false
    }
    run Testing.expect(
      changedRejected && starts(Semantic.eventLog(&nativeSemantic), Family.ParameterDefault) == beforeMismatch,
      "changed same-target facts also reject before cached default reuse",
    )
    let wasmTarget = MachineTarget.forId(TargetId.Wasm32UnknownUnknown)
    let wasmRevision = run Revision.publish(&Revision.make(), &entry, &source)
    let mut wasmSemantic = Semantic.traced(move wasmRevision, wasmTarget, Option<FinalProfile>.none())
    let mut wasmRequest = Request.make()
    run Request.registerSchemaModule(&mut wasmRequest, &entry)
    let wasmRegistered = run ProfileShape.registered(&mut wasmSemantic, &mut wasmRequest, &wasmTarget)
    if let Result<ProfileRegistered, ProfileShapeProblem>.Success {value: wasmShapes} = move wasmRegistered {
      let wasmFacts = run InitialProfile.freeze(&wasmInput)
      let wasmProfile = run assembleProfile(
        move wasmFacts, &mut wasmSemantic, &mut wasmRequest, &wasmShapes,
        Vector<SuppliedBinding>.make(),
      )
      let mut wasmBits = false
      if let Result<FinalProfile, FinalAssemblyProblem>.Success {value: profile} = move wasmProfile {
        let entries = FinalProfile.entries(&profile)
        wasmBits = entries.length == usize.ONE && Shared<StaticData>.with<bool>(
          &entries[usize.ZERO].value,
          fn(value: &StaticData) -> bool {
            return match &value.* {
              StaticData.Integer {ty, magnitude, ..} => ty == StaticIntegerType.U32 && magnitude == 32
              _ => false
            }
          },
        )
      }
      run Testing.expect(wasmBits, "the same source default observes a wasm32 target in its own store")
    } else {
      run Testing.expect(false, "the wasm schema resolves")
    }
  } else {
    run Testing.expect(false, "the native schema resolves")
  }
  return ()
}

test effect fn profileAssemblyRejectsMismatchedTargetFacts() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | RegistrationClosed | ConflictingPackageSource | ProfileProblem | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run profileAssemblyTargetClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn skippedSourceDefaultClaim() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | RegistrationClosed | ConflictingPackageSource | ProfileProblem | AssertionError<'static>
? &mut Allocator | &mut Types {
  let entry = run module("registered-parameters.silk")
  let source = run present("""
pub param workers: u32 = 1 / 0
""")
  let revision = run Revision.publish(&Revision.make(), &entry, &source)
  let target = MachineTarget.forId(TargetId.X8664UnknownLinuxGnu)
  let mut semantic = Semantic.traced(move revision, target, Option<FinalProfile>.none())
  let mut request = Request.make()
  run Request.registerSchemaModule(&mut request, &entry)
  let resolved = run ProfileShape.registered(&mut semantic, &mut request, &target)
  if let Result<ProfileRegistered, ProfileShapeProblem>.Success {value: registered} = move resolved {
    let keys = Vector<RegisteredParameter>.asSlice(&registered.parameters)
    if keys.length == usize.ONE {
      let mut unregistered = Request.make()
      let denied = run Semantic.demandParameterDefault(&mut semantic, &mut unregistered, &keys[usize.ZERO].identity)
      let mut input = ProfileInput.make()
      input.target = Option<Bytes>.some(run Bytes.copy(b"x86_64-unknown-linux-gnu"))
      let firstFacts = run InitialProfile.freeze(&input)
      let mut overrides = Vector<SuppliedBinding>.make()
      run Vector<SuppliedBinding>.append(&mut overrides, run suppliedInteger(b"workers", b"2", BindingTier.Override, BindingProvenance.Literal))
      let selected = run assembleProfile(move firstFacts, &mut semantic, &mut request, &registered, move overrides)
      let overrideAccepted = match move selected {
        Result<FinalProfile, FinalAssemblyProblem>.Success {value} => FinalProfile.entries(&value).length == usize.ONE &&
          starts(Semantic.eventLog(&semantic), Family.ParameterDefault) == usize.ZERO
        _ => false
      }
      let secondFacts = run InitialProfile.freeze(&input)
      let attempted = run assembleProfile(
        move secondFacts, &mut semantic, &mut request, &registered, Vector<SuppliedBinding>.make(),
      )
      let defaultRejected = match move attempted {
        Result<FinalProfile, FinalAssemblyProblem>.Failure {error: FinalAssemblyProblem.Default {rejection}} =>
          Shared<Rejection>.with<bool>(&rejection, fn(value: &Rejection) -> bool {
            return value.code == RejectionCode.StaticViolation
          })
        _ => false
      }
      run Testing.expect(
        rejectsWith(&denied, RejectionCode.UnregisteredParameter) && overrideAccepted && defaultRejected,
        "an override skips the failing source default and an unregistered default rejects",
      )
      let mut retriedBindings = Vector<SuppliedBinding>.make()
      run Vector<SuppliedBinding>.append(&mut retriedBindings, run suppliedInteger(b"workers", b"3", BindingTier.Override, BindingProvenance.Literal))
      let retried = run assembleProfile(run InitialProfile.freeze(&input), &mut semantic, &mut request, &registered, move retriedBindings)
      let retryAccepted = match move retried {
        Result<FinalProfile, FinalAssemblyProblem>.Success {value} => profileIntegerAt(&value, 3) && currentBindingOrigin(&value)
        _ => false
      }
      run Testing.expect(retryAccepted, "a failed profile publication retries with the changed binding and current origin")
    } else {
      run Testing.expect(false, "the source registers one parameter")
    }
  } else {
    run Testing.expect(false, "the source parameter shape resolves")
  }
  return ()
}

test effect fn finalProfileSkipsOverriddenSourceDefault() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | RegistrationClosed | ConflictingPackageSource | ProfileProblem | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run skippedSourceDefaultClaim() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn deferredPredicateClaim() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | RegistrationClosed | ConflictingPackageSource | ProfileProblem | AssertionError<'static>
? &mut Allocator | &mut Types {
  let entry = run module("validated-parameter.silk")
  let source = run present("""
pub param workers: u32 = 1 where workers > 0
""")
  let revision = run Revision.publish(&Revision.make(), &entry, &source)
  let mut semantic = makeSemantic(move revision)
  let mut request = Request.make()
  run Request.registerSchemaModule(&mut request, &entry)
  let target = MachineTarget.forId(TargetId.X8664UnknownLinuxGnu)
  let resolved = run ProfileShape.registered(&mut semantic, &mut request, &target)
  let mut rejected = false
  if let Result<ProfileRegistered, ProfileShapeProblem>.Success {value: registered} = move resolved {
    let keys = Vector<RegisteredParameter>.asSlice(&registered.parameters)
    if keys.length == usize.ONE {
      let mut input = ProfileInput.make()
      input.target = Option<Bytes>.some(run Bytes.copy(b"x86_64-unknown-linux-gnu"))
      let facts = run InitialProfile.freeze(&input)
      let mut values = Vector<FinalEntry>.make()
      run Vector<FinalEntry>.append(&mut values, FinalEntry {
        declaration: DeclarationId.copy(&keys[usize.ZERO].identity),
        value: run Shared<StaticData>.make(StaticData.Integer {ty: StaticIntegerType.U32, sign: StaticSign.Positive, magnitude: 1}),
        origin: FinalOrigin.Default {span: Span.make(usize.ZERO, usize.ONE)},
      })
      let result = run FinalProfile.publish(move facts, Vector<RegisteredShape>.asSlice(&registered.schemas), move values, Vector<DeclarationId>.asSlice(&Vector<DeclarationId>.make()))
      rejected = match move result {
        Result<FinalProfile, FinalProblem>.Failure {error} => error == FinalProblem.PredicateNotChecked
        _ => false
      }
    }
  }
  run Testing.expect(rejected, "an unevaluated final predicate cannot publish a profile")
  return ()
}

test effect fn finalProfileDefersPredicatesLoudly() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | RegistrationClosed | ConflictingPackageSource | ProfileProblem | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run deferredPredicateClaim() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

fn parameterDefaultIs(answer: &Result<Answer, NoRejection>, expected: u64) -> bool {
  return match &answer.* {
    Result<Answer, NoRejection>.Success {value} => match &value.outcome {
      Outcome.Success {value: Value.ParameterDefault {value: data, ..}} => Shared<StaticData>.with<bool>(
        &data, fn(value: &StaticData) -> bool {
          return match &value.* {
            StaticData.Integer {magnitude, ..} => magnitude == expected
            _ => false
          }
        },
      )
      _ => false
    }
    _ => false
  }
}

effect fn missingParameterReplayClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | RegistrationClosed | ConflictingPackageSource | AssertionError<'static>
? &mut Allocator | &mut Types {
  let entry = run module("missing-parameter.silk")
  let firstSource = run present("""pub param workers: u32 = 2
""")
  let first = run Revision.publish(&Revision.make(), &entry, &firstSource)
  let mut warm = makeSemantic(run Revision.copy(&first))
  let mut request = Request.make()
  run Request.registerSchemaModule(&mut request, &entry)
  let missing = run Semantic.demandParameterSchema(&mut warm, &mut request, &entry, b"later")
  run Testing.expect(rejectsWith(&missing, RejectionCode.UnknownName), "a registered missing parameter records its negative name observation")
  let changedSource = run present("""pub param workers: u32 = 2
pub param later: u32 = 7
""")
  let changed = run Revision.publish(&first, &entry, &changedSource)
  run Semantic.update(&mut warm, run Revision.copy(&changed))
  let mut fresh = makeSemantic(move changed)
  let mut again = Request.make()
  let mut cold = Request.make()
  run Request.registerSchemaModule(&mut again, &entry)
  run Request.registerSchemaModule(&mut cold, &entry)
  let current = run Semantic.demandParameterSchema(&mut warm, &mut again, &entry, b"later")
  let reverse = run Semantic.demandParameterSchema(&mut fresh, &mut cold, &entry, b"workers")
  let freshLater = run Semantic.demandParameterSchema(&mut fresh, &mut cold, &entry, b"later")
  let selected = Shared<Result<Answer, NoRejection>>.with<Option<Shared<ParameterSchema>>>(&current, schemaHeader)
  let freshSelected = Shared<Result<Answer, NoRejection>>.with<Option<Shared<ParameterSchema>>>(&freshLater, schemaHeader)
  let registered = run Semantic.demandRegisteredParameters(&mut warm, &mut again)
  if let Result<Vector<RegisteredParameter>, Shared<Rejection>>.Success {value: listed} = move registered {
    let keys = Vector<RegisteredParameter>.asSlice(&listed)
    if keys.length == 2 {
      let identity = &keys[usize.ONE].identity
      let warmDefault = run Semantic.demandParameterDefault(&mut warm, &mut again, identity)
      let freshDefault = run Semantic.demandParameterDefault(&mut fresh, &mut cold, identity)
      run Testing.expect(Shared<Result<Answer, NoRejection>>.with<bool>(&warmDefault, fn(answer: &Result<Answer, NoRejection>) -> bool {
        return parameterDefaultIs(answer, 7)
      }) && Shared<Result<Answer, NoRejection>>.with<bool>(&freshDefault, fn(answer: &Result<Answer, NoRejection>) -> bool {
        return parameterDefaultIs(answer, 7)
      }), "missing-to-present replay agrees on the newly available parameter value")
    } else { run Testing.expect(false, "both registered parameters are listed") }
  } else { run Testing.expect(false, "the registered parameter list resolves") }
  run Testing.expect(agreesWithFresh(&current, &freshLater), "the newly present parameter schema agrees with a fresh store of the same revision")
  run Testing.expect(match move selected {
    Option<Shared<ParameterSchema>>.Some {value: _} => true
    _ => false
  }, "the missing parameter becomes present")
  run Testing.expect(match move freshSelected {
    Option<Shared<ParameterSchema>>.Some {value: _} => true
    _ => false
  }, "reversed fresh schema demands agree with warm name replay")
  drop reverse
  return ()
}

test effect fn registeredMissingParameterBecomesPresent() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | RegistrationClosed | ConflictingPackageSource | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run missingParameterReplayClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

// U9: registration and source defaults are selected again for every assembly request.
effect fn reuseProfile(
  semantic: &mut Semantic,
  request: &mut Request,
  supplied: Vector<SuppliedBinding>,
) -> Result<FinalProfile, FinalAssemblyProblem>
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | ProfileProblem | AssertionError<'static>
? &mut Allocator | &mut Types {
  let target = MachineTarget.forId(TargetId.X8664UnknownLinuxGnu)
  let shapes = run ProfileShape.registered(&mut semantic.*, &mut request.*, &target)
  if let Result<ProfileRegistered, ProfileShapeProblem>.Success {value: registered} = move shapes {
    let mut input = ProfileInput.make()
    input.target = Option<Bytes>.some(run Bytes.copy(b"x86_64-unknown-linux-gnu"))
    let initial = run InitialProfile.freeze(&input)
    return run assembleProfile(move initial, &mut semantic.*, &mut request.*, &registered, move supplied)
  }
  run Testing.expect(false, "the registered source has complete parameter shapes")
  return Result<FinalProfile, FinalAssemblyProblem>.failResult(FinalAssemblyProblem.Profile {error: FinalProblem.MissingParameter})
}

fn profileIntegerAt(profile: &FinalProfile, magnitude: u64) -> bool {
  let entries = FinalProfile.entries(profile)
  return entries.length == usize.ONE && Shared<StaticData>.with<bool>(&entries[usize.ZERO].value,
    fn(value: &StaticData) -> bool {
      return match &value.* {
        StaticData.Integer {ty, magnitude: actual, ..} => ty == StaticIntegerType.U32 && actual == magnitude
        _ => false
      }
    },
  )
}

effect fn profileRevisionReplayClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | RegistrationClosed | ConflictingPackageSource | ProfileProblem | AssertionError<'static>
? &mut Allocator | &mut Types {
  let entry = run module("reuse-parameters.silk")
  let helper = run module("defaults.silk")
  let text = """import defaults { count }
pub param workers: u32 = count()
"""
  let source = run present(text)
  let helperSource = run present("""pub static fn count() -> u32 { return 2 }
""")
  let first = run Revision.publish(&Revision.make(), &entry, &source)
  let revision = run Revision.publish(&first, &helper, &helperSource)
  let target = MachineTarget.forId(TargetId.X8664UnknownLinuxGnu)
  let mut semantic = Semantic.traced(run Revision.copy(&revision), target, Option<FinalProfile>.none())
  let mut deniedRequest = Request.make()
  let denied = run Semantic.demandParameterSchema(&mut semantic, &mut deniedRequest, &entry, b"workers")
  run Testing.expect(rejectsWith(&denied, RejectionCode.UnregisteredParameter), "missing registration is observed before a cached schema")
  let mut request = Request.make()
  run Request.registerSchemaModule(&mut request, &entry)
  let original = run reuseProfile(&mut semantic, &mut request, Vector<SuppliedBinding>.make())
  let initial = match move original {
    Result<FinalProfile, FinalAssemblyProblem>.Success {value} => move value
    _ => { run Testing.expect(false, "a newly registered default publishes" )
      return () }
  }
  let mut supplied = Vector<SuppliedBinding>.make()
  let mut binding = run suppliedInteger(b"workers", b"2", BindingTier.Override, BindingProvenance.Literal)
  binding.module = run Bytes.copy(b"reuse-parameters.silk")
  run Vector<SuppliedBinding>.append(&mut supplied, move binding)
  let mut boundRequest = Request.make()
  run Request.registerSchemaModule(&mut boundRequest, &entry)
  let bound = run reuseProfile(&mut semantic, &mut boundRequest, move supplied)
  if let Result<FinalProfile, FinalAssemblyProblem>.Success {value} = move bound {
    let equal = run FinalProfile.sameIdentity(&initial, &value)
    run Testing.expect(equal && currentBindingOrigin(&value),
      "equal binding and default values share identity with this request's binding origin")
  } else { run Testing.expect(false, "the equal override publishes") }
  let mut unregistered = Request.make()
  let lost = run Semantic.demandParameterSchema(&mut semantic, &mut unregistered, &entry, b"workers")
  run Testing.expect(rejectsWith(&lost, RejectionCode.UnregisteredParameter), "a prior registered success cannot hide a missing registration")
  let movedText = """// Current header origin.
import defaults { count }
pub param workers: u32 = count()
"""
  let movedSource = run present(movedText)
  let edited = run Revision.publish(&revision, &entry, &movedSource)
  run Semantic.update(&mut semantic, run Revision.copy(&edited))
  let mut currentRequest = Request.make()
  run Request.registerSchemaModule(&mut currentRequest, &entry)
  let current = run reuseProfile(&mut semantic, &mut currentRequest, Vector<SuppliedBinding>.make())
  if let Result<FinalProfile, FinalAssemblyProblem>.Success {value} = move current {
    let entries = FinalProfile.entries(&value)
    let oldEntries = FinalProfile.entries(&initial)
    let currentSpan = entries.length == usize.ONE && oldEntries.length == usize.ONE && match &entries[usize.ZERO].origin {
      FinalOrigin.Default {span} => match &oldEntries[usize.ZERO].origin {
        FinalOrigin.Default {span: previous} => span.start > previous.start && span.end > previous.end
        _ => false
      }
      _ => false
    }
    let equal = run FinalProfile.sameIdentity(&initial, &value)
    run Testing.expect(equal && currentSpan,
      "equal default values use current source spans after a header moves")
  } else { run Testing.expect(false, "the moved default publishes") }
  let changedHelper = run present("""pub static fn count() -> u32 { return 3 }
""")
  let changed = run Revision.publish(&edited, &helper, &changedHelper)
  run Semantic.update(&mut semantic, run Revision.copy(&changed))
  let mut fresh = Semantic.traced(run Revision.copy(&changed), target, Option<FinalProfile>.none())
  let mut warmRequest = Request.make()
  let mut freshRequest = Request.make()
  run Request.registerSchemaModule(&mut warmRequest, &entry)
  run Request.registerSchemaModule(&mut freshRequest, &entry)
  let warmProfile = run reuseProfile(&mut semantic, &mut warmRequest, Vector<SuppliedBinding>.make())
  let freshProfile = run reuseProfile(&mut fresh, &mut freshRequest, Vector<SuppliedBinding>.make())
  if let Result<FinalProfile, FinalAssemblyProblem>.Success {value: warm} = move warmProfile {
    if let Result<FinalProfile, FinalAssemblyProblem>.Success {value: cold} = move freshProfile {
      let equal = run FinalProfile.sameIdentity(&warm, &cold)
      let unchanged = run FinalProfile.sameIdentity(&initial, &warm)
      run Testing.expect(profileIntegerAt(&warm, 3) && equal &&
        !unchanged && Semantic.requestDemanded(&mut semantic, &warmRequest, Family.Body, &helper),
        "an edited default helper changes the profile equally in warm and fresh stores")
    } else { run Testing.expect(false, "the fresh changed default publishes") }
  } else { run Testing.expect(false, "the warm changed default publishes") }
  return ()
}

test effect fn profileRevisionReplaySeparatesIdentityFromRegistrationAndOrigins() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | RegistrationClosed | ConflictingPackageSource | ProfileProblem | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run profileRevisionReplayClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

fn parameterPresence(answer: &Result<Answer, NoRejection>, hasDefault: bool, hasValidation: bool) -> bool {
  return match &answer.* {
    Result<Answer, NoRejection>.Success {value} => match &value.outcome {
      Outcome.Success {value: Value.ParameterSchema {schema}} => Shared<ParameterSchema>.with<bool>(&schema,
        fn(selected: &ParameterSchema) -> bool {
          return selected.hasDefault == hasDefault && selected.hasValidation == hasValidation
        })
      _ => false
    }
    _ => false
  }
}

effect fn parameterPresenceReplayClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | RegistrationClosed | ConflictingPackageSource | AssertionError<'static>
? &mut Allocator | &mut Types {
  let entry = run module("parameter-presence.silk")
  let original = run present("pub param workers: u32 = 1\n")
  let first = run Revision.publish(&Revision.make(), &entry, &original)
  let mut warm = makeSemantic(run Revision.copy(&first))
  let mut initialRequest = Request.make()
  run Request.registerSchemaModule(&mut initialRequest, &entry)
  let initial = run Semantic.demandParameterSchema(&mut warm, &mut initialRequest, &entry, b"workers")
  run Testing.expect(Shared<Result<Answer, NoRejection>>.with<bool>(&initial,
    fn(answer: &Result<Answer, NoRejection>) -> bool { return parameterPresence(answer, true, false) }),
    "the original parameter has a default but no predicate")
  let withPredicate = run present("pub param workers: u32 = 1 where workers > 0\n")
  let second = run Revision.publish(&first, &entry, &withPredicate)
  run Semantic.update(&mut warm, run Revision.copy(&second))
  let mut warmRequest = Request.make()
  run Request.registerSchemaModule(&mut warmRequest, &entry)
  let validated = run Semantic.demandParameterSchema(&mut warm, &mut warmRequest, &entry, b"workers")
  let mut fresh = makeSemantic(run Revision.copy(&second))
  let mut freshRequest = Request.make()
  run Request.registerSchemaModule(&mut freshRequest, &entry)
  let freshValidated = run Semantic.demandParameterSchema(&mut fresh, &mut freshRequest, &entry, b"workers")
  run Testing.expect(Shared<Result<Answer, NoRejection>>.with<bool>(&validated,
    fn(answer: &Result<Answer, NoRejection>) -> bool { return parameterPresence(answer, true, true) })
      && agreesWithFresh(&validated, &freshValidated),
    "adding a predicate changes the warm and fresh parameter schema")
  let withoutBody = run present("pub param workers: u32\n")
  let third = run Revision.publish(&second, &entry, &withoutBody)
  run Semantic.update(&mut warm, run Revision.copy(&third))
  let mut lastRequest = Request.make()
  run Request.registerSchemaModule(&mut lastRequest, &entry)
  let plain = run Semantic.demandParameterSchema(&mut warm, &mut lastRequest, &entry, b"workers")
  let mut freshPlain = makeSemantic(move third)
  let mut freshLast = Request.make()
  run Request.registerSchemaModule(&mut freshLast, &entry)
  let cold = run Semantic.demandParameterSchema(&mut freshPlain, &mut freshLast, &entry, b"workers")
  run Testing.expect(Shared<Result<Answer, NoRejection>>.with<bool>(&plain,
    fn(answer: &Result<Answer, NoRejection>) -> bool { return parameterPresence(answer, false, false) })
      && agreesWithFresh(&plain, &cold),
    "removing default and predicate changes the warm and fresh parameter schema")
  return ()
}

test effect fn parameterBodyPresenceReplaysAtItsDeclaration() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | RegistrationClosed | ConflictingPackageSource | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run parameterPresenceReplayClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

fn profileBodyStarts(events: &[SemanticEvent]) -> usize {
  let mut count = usize.ZERO
  let mut at = usize.ZERO
  while at < events.length {
    if events[at].kind == EventKind.Start && events[at].family == Family.Body { count = count + usize.ONE }
    at = at + usize.ONE
  }
  return count
}

effect fn sealedProfileQueryClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | ProfileProblem | AssertionError<'static>
? &mut Allocator | &mut Types {
  let entry = run module("profile-queries.silk")
  let source = run present("""
static fn choose() -> u32 {
  static if Intrinsic.profileFlag("debug") { return 7 } else { return 9 }
}
const selected: u32 = choose()
const debug: bool = Intrinsic.profileFlag("debug")
const libc: string<'static> = Intrinsic.profileText("libc")
const avx: bool = Intrinsic.profileContains("cpu-features", "avx")
""")
  let revision = run Revision.publish(&Revision.make(), &entry, &source)
  let target = MachineTarget.forId(TargetId.X8664UnknownLinuxGnu)
  let emptySchemas = Vector<RegisteredShape>.make()
  let mut enabledInput = ProfileInput.make()
  enabledInput.target = Option<Bytes>.some(run Bytes.copy(b"x86_64-unknown-linux-gnu"))
  run Vector<Bytes>.append(&mut enabledInput.cpuFeatures, run Bytes.copy(b"avx"))
  let enabledFacts = run InitialProfile.freeze(&enabledInput)
  let enabled = run FinalProfile.publish(
    move enabledFacts, Vector<RegisteredShape>.asSlice(&emptySchemas),
    Vector<FinalEntry>.make(), Vector<DeclarationId>.asSlice(&Vector<DeclarationId>.make()))
  let initial = match move enabled {
    Result<FinalProfile, FinalProblem>.Success {value} => move value
    Result<FinalProfile, FinalProblem>.Failure {error: _} => {
      run Testing.expect(false, "a complete empty-schema profile publishes")
      return ()
    }
  }
  let mut semantic = Semantic.traced(run Revision.copy(&revision), target, Option<FinalProfile>.some(move initial))
  let mut firstRequest = Request.make()
  let chooseBody = run Semantic.demandBody(&mut semantic, &mut firstRequest, &entry, b"choose")
  let debug = run Semantic.demandInitializer(&mut semantic, &mut firstRequest, &entry, b"debug")
  let selected = run Semantic.demandInitializer(&mut semantic, &mut firstRequest, &entry, b"selected")
  let libc = run Semantic.demandInitializer(&mut semantic, &mut firstRequest, &entry, b"libc")
  let avx = run Semantic.demandInitializer(&mut semantic, &mut firstRequest, &entry, b"avx")
  let selectedValue = Shared<Result<Answer, NoRejection>>.with<bool>(
    &selected,
    fn(answer: &Result<Answer, NoRejection>) -> bool { return constantInteger(answer, b"7") },
  )
  let libcValue = Shared<Result<Answer, NoRejection>>.with<bool>(
    &libc,
    fn(answer: &Result<Answer, NoRejection>) -> bool { return constantText(answer, b"gnu") },
  )
  let avxValue = Shared<Result<Answer, NoRejection>>.with<bool>(&avx, constantTrue)
  let profileDemand = Semantic.requestDemanded(&mut semantic, &firstRequest, Family.ProfileInput, &entry)
  run Testing.expect(
    Shared<Result<Answer, NoRejection>>.with<AnswerView>(&chooseBody, inspect).success,
    "the static-if function has a checked body under the active profile",
  )
  run Testing.expect(
    Shared<Result<Answer, NoRejection>>.with<bool>(&debug, constantTrue),
    "profileFlag returns the frozen debug fact",
  )
  run Testing.expect(libcValue, "profileText returns the frozen libc fact")
  run Testing.expect(avxValue, "profileContains returns CPU-feature membership")
  run Testing.expect(profileDemand, "profile queries record a logical dependency")
  run Testing.expect(
    Shared<Result<Answer, NoRejection>>.with<AnswerView>(&selected, inspect).success,
    "the profile static-if initializer evaluates",
  )
  run Testing.expect(selectedValue, "the profile flag selects the active static-if arm")
  let appended = run present("""
static fn choose() -> u32 {
  static if Intrinsic.profileFlag("debug") { return 7 } else { return 9 }
}
const selected: u32 = choose()
const debug: bool = Intrinsic.profileFlag("debug")
const libc: string<'static> = Intrinsic.profileText("libc")
const avx: bool = Intrinsic.profileContains("cpu-features", "avx")
fn unrelated() -> u32 { return 2 }
""")
  let changedSource = run Revision.publish(&revision, &entry, &appended)
  run Semantic.update(&mut semantic, run Revision.copy(&changedSource))
  let mut replayRequest = Request.make()
  let beforeReplay = profileBodyStarts(Semantic.eventLog(&semantic))
  let replayedBody = run Semantic.demandBody(&mut semantic, &mut replayRequest, &entry, b"choose")
  run Testing.expect(Shared<Result<Answer, NoRejection>>.with<AnswerView>(&replayedBody, inspect).success &&
    profileBodyStarts(Semantic.eventLog(&semantic)) == beforeReplay &&
    Semantic.requestDemanded(&mut semantic, &replayRequest, Family.ProfileInput, &entry),
    "an unrelated declaration edit reuses the selected body while retaining its logical profile dependency")
  let refreshed = run Semantic.demandInitializer(&mut semantic, &mut replayRequest, &entry, b"selected")
  run Testing.expect(
    Shared<Result<Answer, NoRejection>>.with<bool>(&refreshed, fn(answer: &Result<Answer, NoRejection>) -> bool {
      return constantInteger(answer, b"7")
    }),
    "the original profile initializer observes the current source before profile-only replay",
  )
  let freshFacts = run InitialProfile.freeze(&enabledInput)
  let freshEnabled = run FinalProfile.publish(
    move freshFacts, Vector<RegisteredShape>.asSlice(&emptySchemas),
    Vector<FinalEntry>.make(), Vector<DeclarationId>.asSlice(&Vector<DeclarationId>.make()))
  if let Result<FinalProfile, FinalProblem>.Success {value: freshProfile} = move freshEnabled {
    let mut freshChanged = Semantic.traced(move changedSource, target, Option<FinalProfile>.some(move freshProfile))
    let mut freshChangedRequest = Request.make()
    let freshBody = run Semantic.demandBody(&mut freshChanged, &mut freshChangedRequest, &entry, b"choose")
    run Testing.expect(agreesWithFresh(&replayedBody, &freshBody), "the replayed profile body agrees with a fresh store of the same revision")
  } else { run Testing.expect(false, "the fresh enabled profile publishes") }

  let mut disabledInput = ProfileInput.make()
  disabledInput.target = Option<Bytes>.some(run Bytes.copy(b"x86_64-unknown-linux-gnu"))
  disabledInput.debug = Option<bool>.some(false)
  run Vector<Bytes>.append(&mut disabledInput.cpuFeatures, run Bytes.copy(b"avx"))
  let disabledFacts = run InitialProfile.freeze(&disabledInput)
  let disabled = run FinalProfile.publish(
    move disabledFacts, Vector<RegisteredShape>.asSlice(&emptySchemas),
    Vector<FinalEntry>.make(), Vector<DeclarationId>.asSlice(&Vector<DeclarationId>.make()))
  if let Result<FinalProfile, FinalProblem>.Success {value} = move disabled {
    run Semantic.reviseProfile(&mut semantic, Option<FinalProfile>.some(move value))
    let mut secondRequest = Request.make()
    let changed = run Semantic.demandInitializer(&mut semantic, &mut secondRequest, &entry, b"selected")
    run Testing.expect(
      Shared<Result<Answer, NoRejection>>.with<bool>(&changed, fn(answer: &Result<Answer, NoRejection>) -> bool {
        return constantInteger(answer, b"9")
      }),
      "a changed profile changes static-if selection",
    )
    let beforeReuse = starts(Semantic.eventLog(&semantic), Family.Initializer)
    let originalFacts = run InitialProfile.freeze(&enabledInput)
    let original = run FinalProfile.publish(
      move originalFacts, Vector<RegisteredShape>.asSlice(&emptySchemas),
      Vector<FinalEntry>.make(), Vector<DeclarationId>.asSlice(&Vector<DeclarationId>.make()))
    if let Result<FinalProfile, FinalProblem>.Success {value: repeated} = move original {
      run Semantic.reviseProfile(&mut semantic, Option<FinalProfile>.some(move repeated))
      let mut thirdRequest = Request.make()
      let reused = run Semantic.demandInitializer(&mut semantic, &mut thirdRequest, &entry, b"selected")
      run Testing.expect(
        Shared<Result<Answer, NoRejection>>.with<bool>(&reused, fn(answer: &Result<Answer, NoRejection>) -> bool {
          return constantInteger(answer, b"7")
        }) && starts(Semantic.eventLog(&semantic), Family.Initializer) == beforeReuse,
        "equal profile content reuses the original logical query scope",
      )
    } else {
      run Testing.expect(false, "the repeated profile publishes")
    }
  } else {
    run Testing.expect(false, "the changed profile publishes")
  }
  return ()
}

test effect fn sealedProfileQueriesSelectStaticIf() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | ProfileProblem | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run sealedProfileQueryClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

fn checkedBody(answer: &Result<Answer, NoRejection>) -> Option<Shared<TypedBody>> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Body {body}} => Option<Shared<TypedBody>>.some(
        Shared<TypedBody>.clone(&body),
      )
      _ => Option<Shared<TypedBody>>.none()
    }
    Result<Answer, NoRejection>.Failure {error: _} => Option<Shared<TypedBody>>.none()
  }
}

fn offsetOf(text: string, needle: string, occurrence: usize) -> usize {
  let haystack = String.utf8Bytes(text)
  let wanted = String.utf8Bytes(needle)
  let mut seen = usize.ZERO
  let mut at = usize.ZERO
  while at + wanted.length <= haystack.length {
    let mut matched = true
    let mut inner = usize.ZERO
    while inner < wanted.length {
      if haystack[at + inner] != wanted[inner] {
        matched = false
      }
      inner = inner + usize.ONE
    }
    if matched {
      if seen == occurrence {
        return at
      }
      seen = seen + usize.ONE
    }
    at = at + usize.ONE
  }
  return usize.MAX
}

// A completed rejection with `code` whose nonempty span starts at `start`.
fn rejectsFrom(answer: &Shared<Result<Answer, NoRejection>>, code: RejectionCode, start: usize) -> bool {
  let found = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(answer, rejection)
  if let Option<Shared<Rejection>>.Some {value} = move found {
    return Shared<Rejection>.with<bool>(
      &value,
      fn(diagnostic: &Rejection) -> bool {
        return diagnostic.code == code && diagnostic.span.start == start && diagnostic.span.end > start
      },
    )
  }
  return false
}

fn reads(events: &[SourceEvent], module: &ModuleId) -> usize {
  let mut count = usize.ZERO
  let mut at = usize.ZERO
  while at < events.length {
    if events[at].kind == SourceEventKind.SourceRead && ModuleId.equals(&events[at].module, module) {
      count = count + usize.ONE
    }
    at = at + usize.ONE
  }
  return count
}

fn schemaHeader(answer: &Result<Answer, NoRejection>) -> Option<Shared<ParameterSchema>> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.ParameterSchema {schema}} => Option<Shared<ParameterSchema>>.some(
        Shared<ParameterSchema>.clone(&schema),
      )
      _ => Option<Shared<ParameterSchema>>.none()
    }
    Result<Answer, NoRejection>.Failure {error: _} => Option<Shared<ParameterSchema>>.none()
  }
}

fn oneOverride(value: &Vector<CheckedBinding>) -> bool {
  let values = Vector<CheckedBinding>.asSlice(value)
  if values.length != usize.ONE || bindingOrdinal(&values[usize.ZERO]) != usize.ONE { return false }
  let selected = bindingValue(&values[usize.ZERO])
  return Shared<StaticData>.with<bool>(&selected, fn(value: &StaticData) -> bool {
    return match &value.* {
      StaticData.Integer {ty, sign, magnitude} => ty == StaticIntegerType.U32 && sign == StaticSign.Positive && magnitude == 7
      _ => false
    }
  })
}

fn interleavedConflictAt(error: &BindingError) -> bool {
  let earlier = match &error.previous {
    Option<usize>.Some {value} => value == 0
    Option<usize>.None => false
  }
  return error.code == BindingIssue.SameTierConflict && error.ordinal == 2 && earlier
}

effect fn bindingBatchClaims(schema: Shared<ParameterSchema>) -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let registered = RegisteredShape {
    schema: move schema,
    shape: BindingShape.Integer {kind: StaticIntegerType.U32, bits: 32},
  }
  let mut schemas = Vector<RegisteredShape>.make()
  run Vector<RegisteredShape>.append(&mut schemas, move registered)
  let mut losing = Vector<SuppliedBinding>.make()
  run Vector<SuppliedBinding>.append(&mut losing, run suppliedInteger(b"workers", b"7", BindingTier.Override, BindingProvenance.Literal))
  run Vector<SuppliedBinding>.append(&mut losing, run suppliedInteger(b"workers", b"4294967296", BindingTier.Project, BindingProvenance.Literal))
  let invalid = run prepareBindings(move losing, Vector<RegisteredShape>.asSlice(&schemas))
  let invalidLoses = match move invalid {
    Result<Vector<CheckedBinding>, BindingError>.Failure {error} => error.code == BindingIssue.WrongType && error.ordinal == 1
    _ => false
  }
  let mut duplicates = Vector<SuppliedBinding>.make()
  run Vector<SuppliedBinding>.append(&mut duplicates, run suppliedInteger(b"workers", b"7", BindingTier.Override, BindingProvenance.Literal))
  run Vector<SuppliedBinding>.append(&mut duplicates, run suppliedInteger(b"workers", b"7", BindingTier.Override, BindingProvenance.Literal))
  let conflict = run prepareBindings(move duplicates, Vector<RegisteredShape>.asSlice(&schemas))
  let equalConflict = match move conflict {
    Result<Vector<CheckedBinding>, BindingError>.Failure {error} => error.code == BindingIssue.SameTierConflict && error.ordinal == 1
    _ => false
  }
  let mut interleaved = Vector<SuppliedBinding>.make()
  run Vector<SuppliedBinding>.append(&mut interleaved, run suppliedInteger(b"workers", b"3", BindingTier.Project, BindingProvenance.Literal))
  run Vector<SuppliedBinding>.append(&mut interleaved, run suppliedInteger(b"workers", b"7", BindingTier.Override, BindingProvenance.Literal))
  run Vector<SuppliedBinding>.append(&mut interleaved, run suppliedInteger(b"workers", b"4", BindingTier.Project, BindingProvenance.Literal))
  let hidden = run prepareBindings(move interleaved, Vector<RegisteredShape>.asSlice(&schemas))
  let interleavedConflict = match move hidden {
    Result<Vector<CheckedBinding>, BindingError>.Failure {error} => interleavedConflictAt(&error)
    _ => false
  }
  let mut poisoned = Vector<SuppliedBinding>.make()
  run Vector<SuppliedBinding>.append(&mut poisoned, run suppliedInteger(b"unknown", b"7", BindingTier.Project, BindingProvenance.Literal))
  run Vector<SuppliedBinding>.append(&mut poisoned, run suppliedInteger(b"workers", b"7", BindingTier.Override, BindingProvenance.Secret))
  let forbidden = run prepareBindings(move poisoned, Vector<RegisteredShape>.asSlice(&schemas))
  let provenanceFirst = match move forbidden {
    Result<Vector<CheckedBinding>, BindingError>.Failure {error} => error.code == BindingIssue.ProhibitedProvenance && error.ordinal == 1
    _ => false
  }
  let mut absent = Vector<SuppliedBinding>.make()
  run Vector<SuppliedBinding>.append(&mut absent, run suppliedInteger(b"unknown", b"7", BindingTier.Project, BindingProvenance.Literal))
  let notRegistered = run prepareBindings(move absent, Vector<RegisteredShape>.asSlice(&schemas))
  let unknown = match move notRegistered {
    Result<Vector<CheckedBinding>, BindingError>.Failure {error} => error.code == BindingIssue.UnknownParameter && error.ordinal == 0
    _ => false
  }
  let mut aliased = Vector<SuppliedBinding>.make()
  run Vector<SuppliedBinding>.append(&mut aliased, SuppliedBinding {
    package: run Bytes.copy(b"example"),
    module: run Bytes.copy(b"Alias"),
    parameter: run Bytes.copy(b"workers"),
    value: BindingInput.Integer {decimal: run Bytes.copy(b"7")},
    provenance: BindingProvenance.Literal,
    tier: BindingTier.Project,
  })
  let viaAlias = run prepareBindings(move aliased, Vector<RegisteredShape>.asSlice(&schemas))
  let canonical = match move viaAlias {
    Result<Vector<CheckedBinding>, BindingError>.Failure {error} => error.code == BindingIssue.UnknownParameter && error.ordinal == 0
    _ => false
  }
  let mut ranked = Vector<SuppliedBinding>.make()
  run Vector<SuppliedBinding>.append(&mut ranked, run suppliedInteger(b"workers", b"3", BindingTier.Project, BindingProvenance.Literal))
  run Vector<SuppliedBinding>.append(&mut ranked, run suppliedInteger(b"workers", b"7", BindingTier.Override, BindingProvenance.Literal))
  let selected = run prepareBindings(move ranked, Vector<RegisteredShape>.asSlice(&schemas))
  let higherWins = match move selected {
    Result<Vector<CheckedBinding>, BindingError>.Success {value} => oneOverride(&value)
    _ => false
  }
  run Testing.expect(invalidLoses && equalConflict && interleavedConflict && provenanceFirst && unknown && higherWins, "binding batch validates before precedence and keeps the winning origin")
  run Testing.expect(canonical, "bindings use canonical identity rather than import aliases")
  return ()
}

effect fn privateBindingClaim(schema: Shared<ParameterSchema>) -> bool ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut schemas = Vector<RegisteredShape>.make()
  run Vector<RegisteredShape>.append(&mut schemas, RegisteredShape {
    schema: move schema,
    shape: BindingShape.Boolean,
  })
  let mut supplied = Vector<SuppliedBinding>.make()
  run Vector<SuppliedBinding>.append(&mut supplied, SuppliedBinding {
    package: run Bytes.copy(b"example"),
    module: run Bytes.copy(b"registered-parameters.silk"),
    parameter: run Bytes.copy(b"local"),
    value: BindingInput.Boolean {value: true},
    provenance: BindingProvenance.Literal,
    tier: BindingTier.Project,
  })
  let answer = run prepareBindings(move supplied, Vector<RegisteredShape>.asSlice(&schemas))
  return match move answer {
    Result<Vector<CheckedBinding>, BindingError>.Failure {error} => error.code == BindingIssue.PrivateParameter && error.ordinal == 0
    _ => false
  }
}

fn bodyHasIntrinsic(body: &TypedBody, wanted: IntrinsicPrimitive, arguments: usize) -> bool {
  let nodes = TypedBody.nodeSlice(body)
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {form: BodyExpression.IntrinsicCall {member, arguments: checked}, ..} = &nodes[at].kind {
      if intrinsicIsPrimitive(member, wanted) && Vector<BodyNodeId>.length(&checked) == arguments { return true }
    }
    at = at + usize.ONE
  }
  return false
}

test effect fn staticBodiesSelectSealedIntrinsicMembersWithCheckedTypes() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let entry = run module("static-intrinsics.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """static fn bits() -> u32 { let value = Intrinsic.targetPointerBits() return value }
static fn length() -> usize { return Intrinsic.staticTextByteLength("abc") }
static fn libc() -> string<'static> { return Intrinsic.profileText("libc") }
static fn debug() -> bool { return Intrinsic.profileFlag("debug") }
static fn address() -> bool { return Intrinsic.profileContains("sanitizers", "address") }
fn invalid() -> u32 { return Intrinsic.targetPointerBits() }
"""
  let source = run present(text) |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&Revision.make(), &entry, &source)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut semantic = makeSemantic(move revision)
  let mut request = Request.make()
  let bits = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"bits")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let length = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"length")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let invalid = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"invalid")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let libc = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"libc")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let debug = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"debug")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let address = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"address")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let selectedBits = Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(&bits, checkedBody)
  let selectedLength = Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(&length, checkedBody)
  let selectedLibc = Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(&libc, checkedBody)
  let selectedDebug = Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(&debug, checkedBody)
  let selectedAddress = Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(&address, checkedBody)
  let mut valid = false
  if let Option<Shared<TypedBody>>.Some {value: bitsBody} = move selectedBits {
    if let Option<Shared<TypedBody>>.Some {value: lengthBody} = move selectedLength {
      valid = Shared<TypedBody>.with<bool>(&bitsBody, fn(body: &TypedBody) -> bool {
        return bodyHasIntrinsic(body, IntrinsicPrimitive.TargetPointerBits, usize.ZERO)
      }) && Shared<TypedBody>.with<bool>(&lengthBody, fn(body: &TypedBody) -> bool {
        return bodyHasIntrinsic(body, IntrinsicPrimitive.StaticTextByteLength, usize.ONE)
      })
    }
  }
  let mut profileValid = false
  if let Option<Shared<TypedBody>>.Some {value: libcBody} = move selectedLibc {
    if let Option<Shared<TypedBody>>.Some {value: debugBody} = move selectedDebug {
      if let Option<Shared<TypedBody>>.Some {value: addressBody} = move selectedAddress {
        profileValid = Shared<TypedBody>.with<bool>(&libcBody, fn(body: &TypedBody) -> bool {
          return bodyHasIntrinsic(body, IntrinsicPrimitive.ProfileText, usize.ONE)
        }) && Shared<TypedBody>.with<bool>(&debugBody, fn(body: &TypedBody) -> bool {
          return bodyHasIntrinsic(body, IntrinsicPrimitive.ProfileFlag, usize.ONE)
        }) && Shared<TypedBody>.with<bool>(&addressBody, fn(body: &TypedBody) -> bool {
          return bodyHasIntrinsic(body, IntrinsicPrimitive.ProfileContains, 2)
        })
      }
    }
  }
  valid = valid && profileValid
  run Testing.expect(
    valid && rejectsFrom(&invalid, RejectionCode.StaticPhaseViolation, offsetOf(text, "Intrinsic.targetPointerBits()", 1)),
    "static calls retain sealed member identity while runtime calls are rejected",
  )
  return ()
}

effect fn registeredParameterClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | RegistrationClosed | ConflictingPackageSource | AssertionError<'static>
? &mut Allocator | &mut Types {
  let entry = run module("registered-parameters.silk")
  let source = run present(
    "pub param workers: u32 = 1\nparam local: bool = false\nparam missing: bool\npub param borrowed: &u32\n",
  )
  let revision = run Revision.publish(&Revision.make(), &entry, &source)
  let mut semantic = makeSemantic(move revision)
  let mut absent = Request.make()
  let denied = run Semantic.demandParameterSchema(&mut semantic, &mut absent, &entry, b"workers")
  run Testing.expect(
    rejectsWith(&denied, RejectionCode.UnregisteredParameter) && reads(Semantic.sourceEvents(&semantic), &entry) == usize.ZERO,
    "unregistered schemas reject before reading their source",
  )
  let mut request = Request.make()
  run Request.registerSchemaModule(&mut request, &entry)
  run Request.registerSchemaModule(&mut request, &entry)
  run Testing.expect(Request.registeredSchemaModules(&request).length == usize.ONE, "registration is canonical and idempotent")
  let conflicting = run ModuleId.make(b"different-source", b"example", b"registered-parameters.silk")
  let duplicatePackage = run Effect.result(Request.registerSchemaModule(&mut request, &conflicting))
  let rejectedPackage = match move duplicatePackage {
    Result<(), RegistrationClosed | ConflictingPackageSource | OutOfMemoryError>.Failure {error} => match move error {
      ConflictingPackageSource {} => true
      _ => false
    }
    _ => false
  }
  run Testing.expect(rejectedPackage && Request.registeredSchemaModules(&request).length == usize.ONE, "unequal sources cannot claim one package identity")
  let public = run Semantic.demandParameterSchema(&mut semantic, &mut request, &entry, b"workers")
  let late = run ModuleId.make(b"source", b"example", b"late.silk")
  let afterDemand = run Effect.result(Request.registerSchemaModule(&mut request, &late))
  let closed = match move afterDemand {
    Result<(), RegistrationClosed | ConflictingPackageSource | OutOfMemoryError>.Failure {error} => match move error {
      RegistrationClosed {} => true
      _ => false
    }
    _ => false
  }
  run Testing.expect(closed, "schema registration closes at the first semantic demand")
  let private = run Semantic.demandParameterSchema(&mut semantic, &mut request, &entry, b"local")
  let missing = run Semantic.demandParameterSchema(&mut semantic, &mut request, &entry, b"missing")
  let borrowed = run Semantic.demandParameterSchema(&mut semantic, &mut request, &entry, b"borrowed")
  let publicHeader = Shared<Result<Answer, NoRejection>>.with<Option<Shared<ParameterSchema>>>(&public, schemaHeader)
  let privateHeader = Shared<Result<Answer, NoRejection>>.with<Option<Shared<ParameterSchema>>>(&private, schemaHeader)
  let mut valid = false
  if let Option<Shared<ParameterSchema>>.Some {value: selected} = move publicHeader {
    valid = Shared<ParameterSchema>.with<bool>(&selected, fn(schema: &ParameterSchema) -> bool {
      return schema.isPublic && schema.hasDefault && DeclarationId.named(&schema.declaration, b"workers")
    })
  }
  if let Option<Shared<ParameterSchema>>.Some {value: selected} = move privateHeader {
    valid = valid && Shared<ParameterSchema>.with<bool>(&selected, fn(schema: &ParameterSchema) -> bool {
      return !schema.isPublic && schema.hasDefault && DeclarationId.named(&schema.declaration, b"local")
    })
  } else {
    valid = false
  }
  run Testing.expect(
    valid && rejectsWith(&missing, RejectionCode.InvalidParameterSchema) &&
    rejectsWith(&borrowed, RejectionCode.InvalidParameterSchema),
    "registered headers retain identity and reject missing private defaults or address-bearing types",
  )
  let mut schemas = Vector<Shared<ParameterSchema>>.make()
  let visibleSchema = Shared<Result<Answer, NoRejection>>.with<Option<Shared<ParameterSchema>>>(&public, schemaHeader)
  let hiddenSchema = Shared<Result<Answer, NoRejection>>.with<Option<Shared<ParameterSchema>>>(&private, schemaHeader)
  if let Option<Shared<ParameterSchema>>.Some {value} = move visibleSchema {
    run Vector<Shared<ParameterSchema>>.append(&mut schemas, move value)
  }
  if let Option<Shared<ParameterSchema>>.Some {value} = move hiddenSchema {
    run Vector<Shared<ParameterSchema>>.append(&mut schemas, move value)
  }
  let listed = Vector<Shared<ParameterSchema>>.asSlice(&schemas)
  if listed.length > usize.ZERO {
    run bindingBatchClaims(Shared<ParameterSchema>.clone(&listed[usize.ZERO]))
    if listed.length > usize.ONE {
      let privateRejected = run privateBindingClaim(Shared<ParameterSchema>.clone(&listed[usize.ONE]))
      run Testing.expect(privateRejected, "binding batch rejects a private parameter")
    }
  } else { run Testing.expect(false, "the public parameter supplies a binding schema") }
  let discovered = run Semantic.demandRegisteredParameters(&mut semantic, &mut request)
  let complete = match move discovered {
    Result<Vector<RegisteredParameter>, Shared<Rejection>>.Success {value} => Vector<RegisteredParameter>.length(&value) == 4
    Result<Vector<RegisteredParameter>, Shared<Rejection>>.Failure {error: _} => false
  }
  run Testing.expect(complete && reads(Semantic.sourceEvents(&semantic), &entry) == usize.ONE, "explicit registration enumerates all headers with one source read")
  return ()
}

test effect fn profileBindingRegisteredHeaders() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | RegistrationClosed | ConflictingPackageSource | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run registeredParameterClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

fn acceptedInteger(binding: AcceptedBinding) -> bool {
  return match move binding.value {
    BindingInput.Integer {decimal} => Bytes.asSlice(&decimal).length == 2
    _ => false
  }
}

effect fn bindingProvenanceClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let secret = SuppliedBinding {
    package: run Bytes.copy(b"example@1"),
    module: run Bytes.copy(b"config.silk"),
    parameter: run Bytes.copy(b"token"),
    value: BindingInput.String {text: run Bytes.copy(b"must-never-leak")},
    provenance: BindingProvenance.Secret,
    tier: BindingTier.Override,
  }
  let rejected = admitBinding(move secret)
  let noValue = match move rejected {
    Result<AcceptedBinding, ProhibitedProvenance>.Failure {error: _} => true
    _ => false
  }
  let physical = admitBinding(run suppliedInteger(b"workers", b"2", BindingTier.Project, BindingProvenance.PhysicalSupply))
  let runtime = admitBinding(run suppliedInteger(b"workers", b"3", BindingTier.Project, BindingProvenance.Runtime))
  let noPhysical = match move physical {
    Result<AcceptedBinding, ProhibitedProvenance>.Failure {error: _} => true
    _ => false
  }
  let noRuntime = match move runtime {
    Result<AcceptedBinding, ProhibitedProvenance>.Failure {error: _} => true
    _ => false
  }
  let literal = SuppliedBinding {
    package: run Bytes.copy(b"example@1"),
    module: run Bytes.copy(b"config.silk"),
    parameter: run Bytes.copy(b"workers"),
    value: BindingInput.Integer {decimal: run Bytes.copy(b"42")},
    provenance: BindingProvenance.Literal,
    tier: BindingTier.Project,
  }
  let accepted = admitBinding(move literal)
  let allowed = match move accepted {
    Result<AcceptedBinding, ProhibitedProvenance>.Success {value: binding} => acceptedInteger(move binding)
    _ => false
  }
  let translated = admitBinding(run suppliedInteger(
    b"workers", b"42", BindingTier.Project,
    BindingProvenance.TranslatedPublic {translator: run Bytes.copy(b"public-config@1")},
  ))
  let publicValue = match move translated {
    Result<AcceptedBinding, ProhibitedProvenance>.Success {value: binding} => acceptedInteger(move binding)
    _ => false
  }
  run Testing.expect(noValue && noPhysical && noRuntime && allowed && publicValue, "only literal and identified public translations enter semantic binding work")
  return ()
}

test effect fn profileBindingProvenance() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run bindingProvenanceClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn bindingShapeClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let positive = BindingInput.Integer {decimal: run Bytes.copy(b"127")}
  let overflow = BindingInput.Integer {decimal: run Bytes.copy(b"128")}
  let minimum = BindingInput.Integer {decimal: run Bytes.copy(b"-128")}
  let negativeZero = BindingInput.Integer {decimal: run Bytes.copy(b"-0")}
  let narrow = BindingShape.Integer {kind: StaticIntegerType.I8, bits: 8}
  run Testing.expect(
    bindingFits(&positive, &narrow) && bindingFits(&minimum, &narrow) &&
    !bindingFits(&overflow, &narrow) && bindingFits(&negativeZero, &narrow),
    "integer binding uses exact decimal range and accepts negative zero as zero",
  )
  let widest = BindingShape.Integer {kind: StaticIntegerType.U64, bits: 64}
  let maximum = BindingInput.Integer {decimal: run Bytes.copy(b"18446744073709551615")}
  let beyond = BindingInput.Integer {decimal: run Bytes.copy(b"18446744073709551616")}
  run Testing.expect(bindingFits(&maximum, &widest) && !bindingFits(&beyond, &widest), "integer binding preserves the full u64 range without numeric rounding")
  let mut invalidUtf8 = run Bytes.zeroed(1)
  let mut invalidBytes = Bytes.asMutSlice(&mut invalidUtf8)
  invalidBytes[usize.ZERO] = u8.toU8(255)
  let text = BindingShape.String
  let invalidText = BindingInput.String {text: move invalidUtf8}
  let validText = BindingInput.String {text: run Bytes.copy(b"hello")}
  run Testing.expect(bindingFits(&validText, &text) && !bindingFits(&invalidText, &text), "string binding accepts only UTF-8")
  // Wire matching reads names; U8 fills each member's canonical static enum value.
  let mut cases = Vector<BindingEnumMember>.make()
  run Vector<BindingEnumMember>.append(&mut cases, BindingEnumMember {
    name: run Bytes.copy(b"Open"), value: run Shared<StaticData>.make(StaticData.Unit),
  })
  run Vector<BindingEnumMember>.append(&mut cases, BindingEnumMember {
    name: run Bytes.copy(b"Closed"), value: run Shared<StaticData>.make(StaticData.Unit),
  })
  let enumeration = BindingShape.Enum {canonical: run Bytes.copy(b"pkg@1/mod.silk/Choice"), members: move cases}
  let selected = BindingInput.Enum {nominal: run Bytes.copy(b"pkg@1/mod.silk/Choice"), member: run Bytes.copy(b"Closed")}
  let wrongType = BindingInput.Enum {nominal: run Bytes.copy(b"pkg@1/mod.silk/Other"), member: run Bytes.copy(b"Closed")}
  let wrongCase = BindingInput.Enum {nominal: run Bytes.copy(b"pkg@1/mod.silk/Choice"), member: run Bytes.copy(b"Missing")}
  run Testing.expect(
    bindingFits(&selected, &enumeration) && !bindingFits(&wrongType, &enumeration) && !bindingFits(&wrongCase, &enumeration),
    "enum binding checks canonical type identity and member spelling",
  )
  let boolType = run Types.intern(Type.Primitive {name: run Bytes.copy(b"bool")})
  let optional = BindingShape.Optional {
    absent: 0, present: 1, elementType: Shared<Type>.clone(&boolType),
    element: run Box<BindingShape>.make(BindingShape.Boolean),
  }
  let none = BindingInput.None
  let some = BindingInput.Some {value: run Box<BindingInput>.make(BindingInput.Boolean {value: true})}
  let badSome = BindingInput.Some {value: run Box<BindingInput>.make(BindingInput.Integer {decimal: run Bytes.copy(b"1")})}
  run Testing.expect(
    bindingFits(&none, &optional) && bindingFits(&some, &optional) && !bindingFits(&badSome, &optional),
    "structural optional checks both variants and payload type",
  )
  let mut values = Vector<Box<BindingInput>>.make()
  run Vector<Box<BindingInput>>.append(&mut values, run Box<BindingInput>.make(BindingInput.Boolean {value: true}))
  run Vector<Box<BindingInput>>.append(&mut values, run Box<BindingInput>.make(BindingInput.Boolean {value: false}))
  let array = BindingInput.Array {values: move values}
  let pair = BindingShape.Array {length: 2, elementType: Shared<Type>.clone(&boolType), element: run Box<BindingShape>.make(BindingShape.Boolean)}
  let triple = BindingShape.Array {length: 3, elementType: Shared<Type>.clone(&boolType), element: run Box<BindingShape>.make(BindingShape.Boolean)}
  run Testing.expect(bindingFits(&array, &pair) && !bindingFits(&array, &triple), "array binding checks exact length")
  let borrowed = run Types.intern(Type.Reference {
    referent: Shared<Type>.clone(&boolType), access: Access.Shared,
    lifetime: run Shared<Lifetime>.make(Lifetime.Static),
  })
  let borrowedArray = run Types.intern(Type.Array {element: Shared<Type>.clone(&borrowed), extent: run Bytes.copy(b"1")})
  let forgedChild = BindingShape.Array {
    length: 1, elementType: Shared<Type>.clone(&borrowed),
    element: run Box<BindingShape>.make(BindingShape.Boolean),
  }
  let wrongRoot = !run bindingCorrespondsToType(&boolType, &narrow)
  let wrongChild = !run bindingCorrespondsToType(&borrowedArray, &forgedChild)
  run Testing.expect(
    wrongRoot && wrongChild,
    "schema type correspondence rejects a mismatched root and a borrowed aggregate child",
  )
  let mut fields = Vector<BindingNamedShape>.make()
  run Vector<BindingNamedShape>.append(&mut fields, BindingNamedShape {name: run Bytes.copy(b"first"), ty: Shared<Type>.clone(&boolType), value: run Box<BindingShape>.make(BindingShape.Boolean)})
  run Vector<BindingNamedShape>.append(&mut fields, BindingNamedShape {name: run Bytes.copy(b"second"), ty: Shared<Type>.clone(&boolType), value: run Box<BindingShape>.make(BindingShape.Boolean)})
  let record = BindingShape.Record {fields: move fields}
  let mut reversed = Vector<BindingField>.make()
  run Vector<BindingField>.append(&mut reversed, BindingField {name: run Bytes.copy(b"second"), value: run Box<BindingInput>.make(BindingInput.Boolean {value: true})})
  run Vector<BindingField>.append(&mut reversed, BindingField {name: run Bytes.copy(b"first"), value: run Box<BindingInput>.make(BindingInput.Boolean {value: false})})
  let correct = BindingInput.Record {fields: move reversed}
  let mut duplicate = Vector<BindingField>.make()
  run Vector<BindingField>.append(&mut duplicate, BindingField {name: run Bytes.copy(b"first"), value: run Box<BindingInput>.make(BindingInput.Boolean {value: true})})
  run Vector<BindingField>.append(&mut duplicate, BindingField {name: run Bytes.copy(b"first"), value: run Box<BindingInput>.make(BindingInput.Boolean {value: false})})
  let repeated = BindingInput.Record {fields: move duplicate}
  run Testing.expect(bindingFits(&correct, &record) && !bindingFits(&repeated, &record), "record binding ignores field order but rejects duplicates")
  return ()
}

test effect fn profileBindingPortableShapes() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run bindingShapeClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}
