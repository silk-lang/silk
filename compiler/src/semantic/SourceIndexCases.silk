effect fn module(path: string) -> ModuleId ! InvalidModulePath | OutOfMemoryError ? &mut Allocator {
  return run ModuleId.make(b"memory", b"example", String.utf8Bytes(path))
}

effect fn present(text: string) -> Option<Bytes> ! OutOfMemoryError ? &mut Allocator {
  return Option<Bytes>.some(run Bytes.copy(String.utf8Bytes(text)))
}

effect fn revisionClaims() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static>
? &mut Allocator {
  let entry = run module("entry.silk")
  let unused = run module("unused.silk")
  let start = Revision.make()
  let source = run present("pub fn entry() -> i32 { return 1 }\n")
  let first = run Revision.publish(&start, &entry, &source)
  let oldEntry = run Revision.observe(&first, &entry)
  let oldUnused = run Revision.observe(&first, &unused)
  let cloned = run Observation.copy(&oldEntry)
  run Testing.expect(
    Observation.equals(&oldEntry, &cloned),
    "cloned observations compare without reentrant shared access",
  )
  let copiedRevision = run Revision.copy(&first)
  run Testing.expect(
    Observation.matches(&oldEntry, &copiedRevision),
    "copied revisions retain exact source content",
  )
  let republished = run Revision.publish(&first, &entry, &source)
  let equalEntry = run Revision.observe(&republished, &entry)
  run Testing.expect(
    Observation.equals(&oldEntry, &equalEntry) && Observation.matches(&oldEntry, &republished),
    "independently published equal bytes remain the same observation",
  )
  let independentCopy = run Observation.copyContent(&oldEntry)
  if let Option<Bytes>.Some {value} = move independentCopy {
    let mut writable = move value
    let mut view = Bytes.asMutSlice(&mut writable)
    view[31] = 51
    run Testing.expect(
      Observation.matches(&oldEntry, &first),
      "mutating a returned byte copy cannot change held content",
    )
  } else {
    run Testing.expect(false, "present observation returns an independent byte copy")
  }
  run Testing.expect(Observation.isPresent(&oldEntry), "present source captured")
  run Testing.expect(!Observation.isPresent(&oldUnused), "unlisted source is absent")
  let added = run present("pub fn unused() -> i32 { return 2 }\n")
  let second = run Revision.publish(&first, &unused, &added)
  run Testing.expect(Observation.matches(&oldEntry, &second), "unrelated source keeps observation")
  run Testing.expect(!Observation.matches(&oldUnused, &second), "absent source becomes present")
  let heldUnused = run Revision.observe(&first, &unused)
  run Testing.expect(!Observation.isPresent(&heldUnused), "held revision stays absent")
  let removed = run Revision.publish(&first, &entry, &Option<Bytes>.none())
  let absentEntry = run Revision.observe(&removed, &entry)
  run Testing.expect(
    !Observation.isPresent(&absentEntry) && !Observation.matches(&oldEntry, &removed),
    "explicit absence replaces bytes only in new revision",
  )
  let changed = run present("pub fn entry() -> i32 { return 3 }\n")
  let third = run Revision.publish(&second, &entry, &changed)
  run Testing.expect(
    !Observation.matches(&oldEntry, &third),
    "changed source invalidates old bytes",
  )
  let oldBytes = run Observation.copyContent(&oldEntry)
  if let Option<Bytes>.Some {value} = move oldBytes {
    run Testing.expect(Bytes.asSlice(&value)[31] == 49, "held bytes still spell the old literal")
  } else {
    run Testing.expect(false, "held bytes must be present")
  }
  return ()
}

test effect fn holdsExactRevisionMappings() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run revisionClaims()
    |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn indexClaims() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static>
? &mut Allocator {
  let firstId = run module("first.silk")
  let secondId = run module("second.silk")
  let text = "import missing as Ghost\nfn same() -> i32 { return 1 }\nfn same() -> i32 { return 2 }\n"
  let firstBytes = run Bytes.copy(String.utf8Bytes(text))
  let secondBytes = run Bytes.copy(String.utf8Bytes(text))
  let first = run SourceUnit.parse(&firstId, usize.ONE, move firstBytes)
  let second = run SourceUnit.parse(&secondId, usize.ONE, move secondBytes)
  let index = run ModuleIndex.build(&first, true)
  let other = run ModuleIndex.build(&second, false)
  run Testing.expect(
    SourceUnit.diagnosticCount(&first) == usize.ZERO,
    "valid source has no syntax errors",
  )
  run Testing.expect(ModuleIndex.listDeclarations(&index).length == 3, "all declarations indexed")
  run Testing.expect(ModuleIndex.listCollisions(&index).length == 1, "duplicate name has collision")
  let declarations = ModuleIndex.listDeclarations(&index)
  let elsewhere = ModuleIndex.listDeclarations(&other)
  run Testing.expect(
    declarations[1].ambiguous && declarations[2].ambiguous,
    "same-key occurrence is ambiguous",
  )
  run Testing.expect(
    !DeclarationId.equals(&declarations[1].identity, &elsewhere[1].identity),
    "equal local HIR positions in different modules have distinct identities",
  )
  let again = run SourceUnit.parse(&firstId, usize.ONE, run Bytes.copy(String.utf8Bytes(text)))
  let rebuilt = run ModuleIndex.build(&again, false)
  let rebuiltDeclarations = ModuleIndex.listDeclarations(&rebuilt)
  run Testing.expect(
    DeclarationId.equals(&declarations[2].identity, &rebuiltDeclarations[2].identity)
      && DeclarationId.hash(&declarations[2].identity) == DeclarationId.hash(&rebuiltDeclarations[2].identity)
      && !DeclarationId.equals(&declarations[1].identity, &rebuiltDeclarations[2].identity),
    "separately built identities of one declaration compare equal by content, and siblings stay distinct",
  )
  let matched = ModuleIndex.matchesDeclaration(&index, 1, &index, 2)
  run Testing.expect(!matched && !ModuleIndex.matchesPrototype(&index, 1, &index, 2),
    "ambiguous occurrence is not matched by a local ordinal")
  let nested = run SourceUnit.parse(
    &firstId,
    usize.ONE,
    run Bytes.copy(
      b"service twin { effect fn field(self: &Self) -> i32 }\nservice twin { effect fn field(self: &Self) -> i32 }\n",
    ),
  )
  let nestedIndex = run ModuleIndex.build(&nested, true)
  run Testing.expect(SourceUnit.diagnosticCount(&nested) == usize.ZERO, "nested fixture parses")
  let nestedItems = ModuleIndex.listDeclarations(&nestedIndex)
  run Testing.expect(nestedItems.length == 4, "nested authored declarations are indexed")
  let nestedMatch = ModuleIndex.matchesDeclaration(&nestedIndex, 1, &nestedIndex, 1)
  run Testing.expect(!nestedMatch && !ModuleIndex.matchesPrototype(&nestedIndex, 1, &nestedIndex, 1),
    "ambiguous parent makes its child unstable")
  let same = run ModuleIndex.observeName(&index, b"same")
  let absent = run ModuleIndex.observeName(&index, b"unknown")
  let imported = run ModuleIndex.observeName(&index, b"Ghost")
  run Testing.expect(NameObservation.listMembers(&same).length == 2, "complete duplicate bucket")
  run Testing.expect(
    NameObservation.listMembers(&absent).length == 0,
    "negative bucket is complete",
  )
  run Testing.expect(
    NameObservation.listMembers(&imported).length == 1,
    "import alias indexed as syntax",
  )
  let hybrid = run SourceUnit.parse(
    &firstId,
    usize.ONE,
    run Bytes.copy(b"pub import model.User as Tree { User as Person }\n"),
  )
  run Testing.expect(SourceUnit.diagnosticCount(&hybrid) == usize.ZERO, "hybrid import parses")
  let hybridIndex = run ModuleIndex.build(&hybrid, false)
  let namespace = run ModuleIndex.observeName(&hybridIndex, b"Tree")
  let selected = run ModuleIndex.observeName(&hybridIndex, b"Person")
  let defaultName = run ModuleIndex.observeName(&hybridIndex, b"User")
  run Testing.expect(
    NameObservation.listMembers(&namespace).length == 1 && NameObservation.listMembers(&selected).length == 1 && NameObservation.listMembers(
      &defaultName,
    ).length == usize.ZERO,
    "hybrid import keeps the explicit namespace and selected aliases only",
  )
  let shiftedImport = run SourceUnit.parse(
    &firstId,
    2,
    run Bytes.copy(b"pub import model.User as Tree { Guest as Friend, User as Person }\n"),
  )
  let shiftedIndex = run ModuleIndex.build(&shiftedImport, false)
  run Testing.expect(!ModuleIndex.matchesName(&hybridIndex, &shiftedIndex, b"Person")
      && ModuleIndex.matchesName(&hybridIndex, &shiftedIndex, b"Tree"),
    "a shifted import member ordinal changes only its written name bucket")
  let later = run SourceUnit.parse(
    &firstId,
    2,
    run Bytes.copy(b"fn unknown() -> i32 { return 3 }\n"),
  )
  let laterIndex = run ModuleIndex.build(&later, false)
  let appeared = run ModuleIndex.observeName(&laterIndex, b"unknown")
  let oldElsewhere = run ModuleIndex.observeName(&index, b"elsewhere")
  let stillAbsent = run ModuleIndex.observeName(&laterIndex, b"elsewhere")
  run Testing.expect(
    !NameObservation.equals(&absent, &appeared),
    "new name invalidates negative bucket",
  )
  run Testing.expect(
    NameObservation.equals(&oldElsewhere, &stillAbsent),
    "unchanged negative bucket survives source edit",
  )
  run Testing.expect(!ModuleIndex.matchesName(&index, &laterIndex, b"unknown")
      && ModuleIndex.matchesName(&index, &laterIndex, b"elsewhere"),
    "index comparison distinguishes changed and still-empty candidate buckets")
  let collision = ModuleIndex.listCollisions(&index)[usize.ZERO]
  let source = SourceUnit.bytes(&first)
  run Testing.expect(
    collision.span.start == 57 && collision.span.end == 61 && source[57] == 115 && source[60] == 101,
    "collision span addresses the second name",
  )
  let damaged = run SourceUnit.parse(
    &firstId,
    usize.ONE,
    run Bytes.copy(b"fn work( -> () { return () }\n"),
  )
  run Testing.expect(
    SourceUnit.diagnosticCount(&damaged) > usize.ZERO,
    "damaged syntax is retained",
  )
  let damagedIndex = run ModuleIndex.build(&damaged, false)
  run Testing.expect(
    ModuleIndex.listDeclarations(&damagedIndex).length == 1,
    "damaged declaration keeps identity",
  )
  let diagnostic = SourceUnit.diagnostic(&damaged, usize.ZERO)
  let damagedBytes = SourceUnit.bytes(&damaged)
  run Testing.expect(
    diagnostic.span.start == 9 && diagnostic.span.end == 9 && damagedBytes[9] == 45 && damagedBytes[10] == 62,
    "missing-token span sits before the retained arrow bytes",
  )
  return ()
}

test effect fn indexesNamesWithoutSemanticWork() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run indexClaims()
    |> Effect.provideMut<Allocator>(&mut allocator)
}

fn wasPresent(answer: &Result<SourceResult, NoRejection>) -> bool {
  return match & answer.* {
    Result<SourceResult, NoRejection>.Success {value} => match & value {
      SourceResult.Present {slot: _, observation: ignored} => true
      SourceResult.Absent {observation: _} => false
    }
    Result<SourceResult, NoRejection>.Failure {error: _} => false
  }
}

fn firstSlot(answer: &Result<SourceResult, NoRejection>) -> bool {
  return match & answer.* {
    Result<SourceResult, NoRejection>.Success {value} => match & value {
      SourceResult.Present {slot, observation: _} => slot == usize.ZERO
      SourceResult.Absent {observation: ignored} => false
    }
    Result<SourceResult, NoRejection>.Failure {error: ignored} => false
  }
}

struct PublicationAllocator {
  armed: bool
  rejected: bool
}

impl PublicationAllocator {
  effect fn allocate(self: &mut Self, layout: Layout) -> Intrinsic.Allocation ! OutOfMemoryError {
    if self.armed {
      self.armed = false
      self.rejected = true
      fail OutOfMemoryError {}
    }
    let element = Layout.of<SourceSlot>()
    if layout.bytes == element.bytes * 4 && layout.alignment == element.alignment {
      self.armed = true
    }
    let mut system = Allocator.systemAllocatorProvider()
    return run Allocator.allocate(move layout)
      |> Effect.provideMut<Allocator>(&mut system)
  }
}

impl Allocator for PublicationAllocator {
  allocate: PublicationAllocator.allocate
}

struct RevisionParseAllocator {
  targetBytes: usize
  rejected: bool
}

impl RevisionParseAllocator {
  effect fn allocate(self: &mut Self, layout: Layout) -> Intrinsic.Allocation ! OutOfMemoryError {
    if layout.bytes == self.targetBytes && layout.alignment == 1 {
      self.rejected = true
      fail OutOfMemoryError {}
    }
    let mut system = Allocator.systemAllocatorProvider()
    return run Allocator.allocate(move layout)
      |> Effect.provideMut<Allocator>(&mut system)
  }
}

impl Allocator for RevisionParseAllocator {
  allocate: RevisionParseAllocator.allocate
}

fn bucketSize(observation: &NameObservation) -> usize {
  return NameObservation.listMembers(observation).length
}

fn hasMagnitude(index: &SourceIndex, cursor: &AuthoredCursor, expected: &[u8]) -> bool {
  let mut at = usize.ZERO
  while at < 256 {
    let found = SourceIndex.authoredNode(index, cursor, HirId {index: at})
    if let Option<Node>.Some {value: node} = move found {
      if let Node.IntegerLiteral {magnitude, ..} = move node {
        let text = SourceIndex.authoredText(index, cursor, magnitude)
        if let Option<&[u8]>.Some {value} = move text {
          if value.length == expected.length {
            let mut same = true
            let mut byte = usize.ZERO
            while byte < value.length {
              if value[byte] != expected[byte] { same = false }
              byte = byte + usize.ONE
            }
            if same { return true }
          }
        }
      }
    } else {
      break
    }
    at = at + usize.ONE
  }
  return false
}

effect fn queryClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator {
  let entry = run module("entry.silk")
  let source = run present("import missing as Missing\nfn entry() -> i32 { return 1 }\n")
  let revision = run Revision.publish(&Revision.make(), &entry, &source)
  let mut index = SourceIndex.make(run Revision.copy(&revision))
  let first = run SourceIndex.demand(&mut index, &entry)
  let again = run SourceIndex.demand(&mut index, &entry)
  run Testing.expect(
    Shared<Result<SourceResult, NoRejection>>.with<bool>(&first, wasPresent),
    "requested module indexed",
  )
  run Testing.expect(
    Shared<Result<SourceResult, NoRejection>>.with<bool>(&again, wasPresent),
    "completed query reused",
  )
  let borrowed = SourceIndex.source(&index, &again, &entry)
  if let Option<&IndexedSource>.Some {value} = move borrowed {
    run Testing.expect(
      ModuleIndex.listDeclarations(IndexedSource.moduleIndex(value)).length == 2,
      "cache hit borrows the one retained syntax index",
    )
  } else {
    run Testing.expect(false, "present cache hit retains an indexed source")
  }
  let imported = run SourceIndex.observeName(&mut index, &again, &entry, b"Missing")
  let absent = run SourceIndex.observeName(&mut index, &again, &entry, b"Unknown")
  if let Option<Shared<NameObservation>>.Some {value} = move imported {
    run Testing.expect(
      Shared<NameObservation>.with<usize>(&value, bucketSize) == 1,
      "cached answer exposes import binding bucket",
    )
  } else {
    run Testing.expect(false, "present source has a name bucket")
  }
  if let Option<Shared<NameObservation>>.Some {value} = move absent {
    run Testing.expect(
      Shared<NameObservation>.with<usize>(&value, bucketSize) == 0,
      "cached answer exposes negative bucket",
    )
  } else {
    run Testing.expect(false, "present source has an empty name bucket")
  }
  let events = SourceIndex.eventLog(&index)
  run Testing.expect(events.length == 3, "a hit and name buckets record no events")
  run Testing.expect(
    events[0].kind == EventKind.QueryStart && events[1].kind == EventKind.SourceRead && events[1].present && ModuleId.equals(
      &events[1].module,
      &entry,
    ),
    "only entry source is read on miss",
  )
  run Testing.expect(events[2].kind == EventKind.QueryFinish, "hit has no provider read")
  let second = run module("second.silk")
  let secondSource = run present("""
    pub fn second() -> i32 { return 2 }
    """)
  let added = run Revision.publish(&revision, &second, &secondSource)
  let addedChanges = run SourceIndex.revise(&mut index, move added)
  run Testing.expect(Vector<SourceChange>.length(&addedChanges) == usize.ZERO, "a newly published module that was never loaded changes no loaded source")
  let secondAnswer = run SourceIndex.demand(&mut index, &second)
  let retained = run SourceIndex.demand(&mut index, &entry)
  let retainedEvents = SourceIndex.eventLog(&index)
  run Testing.expect(
    Shared<Result<SourceResult, NoRejection>>.with<bool>(&secondAnswer, wasPresent) && Shared<Result<SourceResult, NoRejection>>.with<bool>(&retained, firstSlot) && retainedEvents.length == 3 && retainedEvents[1].kind == EventKind.SourceRead && ModuleId.equals(&retainedEvents[1].module, &second) && retainedEvents[2].kind == EventKind.QueryFinish,
    "loading a second module retains the first parsed source and its completed query",
  )
  let owned = run SourceIndex.authoredCursor(&mut index, &again, &entry)
  if let Option<AuthoredCursor>.Some {value: cursor} = move owned {
    run Testing.expect(hasMagnitude(&index, &cursor, b"1") && SourceIndex.eventLog(&index).length == 3,
      "short HIR reads reuse the completed source without another read")
    let changedSource = run present("fn entry() -> i32 { return 23 }\n")
    let changedRevision = run Revision.publish(&Revision.make(), &entry, &changedSource)
    let edits = run SourceIndex.revise(&mut index, move changedRevision)
    run Testing.expect(Vector<SourceChange>.length(&edits) == 2, "an edited module and a loaded module the revision drops are both changed")
    let changes = Vector<SourceChange>.asSlice(&edits)
    let mut indexedNow = false
    let mut at = usize.ZERO
    while at < changes.length {
      if ModuleId.equals(&changes[at].module, &entry) {
        let loaded = SourceIndex.source(&index, &changes[at].current, &entry)
        indexedNow = match move loaded {
          Option<&IndexedSource>.Some {..} => true
          Option<&IndexedSource>.None => false
        }
      }
      at = at + usize.ONE
    }
    run Testing.expect(indexedNow, "revision reindexes a changed loaded source before returning")
    run Testing.expect(!hasMagnitude(&index, &cursor, b"1"),
      "an owned cursor cannot read a replaced source revision")
    let reindexedEvents = SourceIndex.eventLog(&index).length
    let changedAnswer = run SourceIndex.demand(&mut index, &entry)
    run Testing.expect(SourceIndex.eventLog(&index).length == reindexedEvents,
      "a demand after revision reuses the already indexed source")
    let changed = run SourceIndex.authoredCursor(&mut index, &changedAnswer, &entry)
    if let Option<AuthoredCursor>.Some {value: newCursor} = move changed {
      run Testing.expect(hasMagnitude(&index, &newCursor, b"23"),
        "a new cursor sees the revised HIR")
      let sameBytesRevision = run Revision.publish(&Revision.make(), &entry, &changedSource)
      let unchanged = run SourceIndex.revise(&mut index, move sameBytesRevision)
      run Testing.expect(Vector<SourceChange>.length(&unchanged) == usize.ZERO, "equal bytes change no loaded source")
      run Testing.expect(!hasMagnitude(&index, &newCursor, b"23"),
        "revision replacement invalidates a cursor even when source bytes agree")
    } else {
      run Testing.expect(false, "revised present source has a cursor")
    }
  } else {
    run Testing.expect(false, "present source has an owned cursor")
  }
  return ()
}

test effect fn loadedSourcesReportUndemandedSyntaxErrors() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run syntaxClaims()
    |> Effect.provideMut<Allocator>(&mut allocator)
}

// A loaded module is parsed whole, so a damaged declaration nothing demands still reports its
// parser diagnostic; a store that loaded nothing reports none (MODULE-004).
effect fn syntaxClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator {
  let entry = run module("damaged.silk")
  let text = "fn damaged(value: i32 next: i32) -> i32 { return 0 }\nfn fine() -> i32 { return 1 }\n"
  let revision = run Revision.publish(&Revision.make(), &entry, &run present(text))
  let mut index = SourceIndex.make(move revision)
  let unloaded = run SourceIndex.syntaxProblems(&index)
  run Testing.expect(Vector<SyntaxProblem>.length(&unloaded) == usize.ZERO, "a source nothing loaded reports nothing")
  let answer = run SourceIndex.demand(&mut index, &entry)
  drop answer
  let problems = run SourceIndex.syntaxProblems(&index)
  let listed = Vector<SyntaxProblem>.asSlice(&problems)
  let insertion = String.utf8Bytes("fn damaged(value: i32 ").length
  run Testing.expect(
    listed.length == usize.ONE && listed[usize.ZERO].code == CauseCode.MissingToken
      && listed[usize.ZERO].span.start == insertion && listed[usize.ZERO].span.end == insertion
      && ModuleId.equals(&listed[usize.ZERO].module, &entry),
    "the missing comma of an undemanded declaration is one zero-width MissingToken in its module",
  )
  return ()
}

test effect fn readsOnlyDemandedSources() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run queryClaims()
    |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn foreignAnswerClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator {
  let entry = run module("entry.silk")
  let firstBytes = run present("pub fn first() -> i32 { return 1 }\n")
  let secondBytes = run present("pub fn second() -> i32 { return 2 }\n")
  let firstRevision = run Revision.publish(&Revision.make(), &entry, &firstBytes)
  let secondRevision = run Revision.publish(&Revision.make(), &entry, &secondBytes)
  run Testing.expect(
    Revision.revisionNumber(&firstRevision) == Revision.revisionNumber(&secondRevision),
    "independent revisions deliberately share a number",
  )
  let mut first = SourceIndex.make(move firstRevision)
  let mut second = SourceIndex.make(move secondRevision)
  let answer = run SourceIndex.demand(&mut first, &entry)
  let own = run SourceIndex.demand(&mut second, &entry)
  run Testing.expect(
    Shared<Result<SourceResult, NoRejection>>.with<bool>(&answer, firstSlot) && Shared<
      Result<SourceResult, NoRejection>,
    >.with<
      bool,
    >(&own, firstSlot),
    "independent stores deliberately share a source slot",
  )
  let foreignSource = SourceIndex.source(&second, &answer, &entry)
  run Testing.expect(
    match move foreignSource {
      Option<&IndexedSource>.None => true
      Option<&IndexedSource>.Some {value: ignored} => false
    },
    "foreign answer does not borrow different retained bytes",
  )
  let cursor = run SourceIndex.authoredCursor(&mut first, &answer, &entry)
  if let Option<AuthoredCursor>.Some {value} = move cursor {
    let foreignNode = SourceIndex.authoredNode(&second, &value, HirId {index: usize.ZERO})
    run Testing.expect(
      match move foreignNode {
        Option<Node>.None => true
        Option<Node>.Some {value: ignored} => false
      },
      "a foreign cursor cannot borrow another store with the same revision and slot",
    )
  } else {
    run Testing.expect(false, "the present source provides a cursor")
  }
  let foreignName = run Effect.result(
    SourceIndex.observeName(&mut second, &answer, &entry, b"first"),
  )
  run Testing.expect(
    match move foreignName {
      Result<Option<Shared<NameObservation>>, RevisionMismatch | OutOfMemoryError>.Failure {error} => match move error {
        RevisionMismatch {} => true
        OutOfMemoryError {} => false
      }
      Result<Option<Shared<NameObservation>>, RevisionMismatch | OutOfMemoryError>.Success {
        value: ignored,
      } => false
    },
    "foreign answer cannot observe a different name bucket",
  )
  return ()
}

test effect fn rejectsCrossStorePresentAnswer() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run foreignAnswerClaims()
    |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn publicationFailureClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | AssertionError<'static> {
  let mut system = Allocator.systemAllocatorProvider()
  let entry = run module("entry.silk")
    |> Effect.provideMut<Allocator>(&mut system)
  let bytes = run present("pub fn entry() -> i32 { return 1 }\n")
    |> Effect.provideMut<Allocator>(&mut system)
  let revision = run Revision.publish(&Revision.make(), &entry, &bytes)
    |> Effect.provideMut<Allocator>(&mut system)
  let mut index = SourceIndex.make(move revision)
  let mut allocator = PublicationAllocator {armed: false, rejected: false}
  let attempted = run Effect.result(SourceIndex.demand(&mut index, &entry))
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    match move attempted {
      Result<Shared<Result<SourceResult, NoRejection>>, Cycle | OutOfMemoryError>.Failure {error} => match move error {
        OutOfMemoryError {} => true
        Cycle {} => false
      }
      Result<Shared<Result<SourceResult, NoRejection>>, Cycle | OutOfMemoryError>.Success {
        value: ignored,
      } => false
    } && allocator.rejected && SourceIndex.fingerprintBytesHashed(&index) == usize.ZERO,
    "allocation after retained-source append rejects publication",
  )
  let retried = run SourceIndex.demand(&mut index, &entry)
    |> Effect.provideMut<Allocator>(&mut system)
  run Testing.expect(
    Shared<Result<SourceResult, NoRejection>>.with<bool>(&retried, firstSlot)
      && SourceIndex.fingerprintBytesHashed(&index) > usize.ZERO,
    "retry reuses the first source slot and counts only its published fingerprints",
  )
  let events = SourceIndex.eventLog(&index)
  run Testing.expect(
    events.length == 5 && events[0].kind == EventKind.QueryStart && events[1].kind == EventKind.SourceRead && events[2].kind == EventKind.QueryStart && events[3].kind == EventKind.SourceRead && events[4].kind == EventKind.QueryFinish,
    "failed publication leaves no completion and retry rereads once",
  )
  return ()
}

test effect fn rollsBackUnpublishedSource() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | AssertionError<'static> {
  return run publicationFailureClaims()
}

effect fn revisionParseFailureClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | AssertionError<'static> {
  let mut system = Allocator.systemAllocatorProvider()
  let entry = run module("entry.silk") |> Effect.provideMut<Allocator>(&mut system)
  let first = run present("fn entry() -> i32 { return 1 }\n")
    |> Effect.provideMut<Allocator>(&mut system)
  let initial = run Revision.publish(&Revision.make(), &entry, &first)
    |> Effect.provideMut<Allocator>(&mut system)
  let mut index = SourceIndex.make(move initial)
  let answer = run SourceIndex.demand(&mut index, &entry)
    |> Effect.provideMut<Allocator>(&mut system)
  let cursor = run SourceIndex.authoredCursor(&mut index, &answer, &entry)
    |> Effect.provideMut<Allocator>(&mut system)
  let editedText = "fn entry() -> i32 { return 123456789 }\n// unique changed-source parse allocation\n"
  let edited = run present(editedText) |> Effect.provideMut<Allocator>(&mut system)
  let revision = run Revision.publish(&Revision.make(), &entry, &edited)
    |> Effect.provideMut<Allocator>(&mut system)
  let mut fault = RevisionParseAllocator {
    targetBytes: String.utf8Bytes(editedText).length,
    rejected: false,
  }
  let attemptedRevision = run Revision.copy(&revision)
    |> Effect.provideMut<Allocator>(&mut system)
  let attempted = run Effect.result(SourceIndex.revise(&mut index, move attemptedRevision))
    |> Effect.provideMut<Allocator>(&mut fault)
  let failed = match move attempted {
    Result<Vector<SourceChange>, OutOfMemoryError>.Failure {error: _} => true
    Result<Vector<SourceChange>, OutOfMemoryError>.Success {value: ignored} => false
  }
  let mut oldCursorValid = false
  if let Option<AuthoredCursor>.Some {value} = &cursor {
    oldCursorValid = hasMagnitude(&index, &value, b"1")
  }
  let oldAnswer = SourceIndex.source(&index, &answer, &entry)
  let oldAnswerValid = match move oldAnswer {
    Option<&IndexedSource>.Some {..} => true
    Option<&IndexedSource>.None => false
  }
  run Testing.expect(failed && fault.rejected && oldCursorValid && oldAnswerValid
      && SourceIndex.eventLog(&index).length == 3,
    "failed eager parsing keeps old revision, cursor, completed answer, and event log")
  let changes = run SourceIndex.revise(&mut index, move revision)
    |> Effect.provideMut<Allocator>(&mut system)
  let entries = Vector<SourceChange>.asSlice(&changes)
  run Testing.expect(entries.length == 1 && SourceIndex.slotCount(&index) == 2,
    "retry of the same revision reports and reindexes its changed source")
  if entries.length == 1 {
    let current = SourceIndex.source(&index, &entries[0].current, &entry)
    let currentValid = match move current {
      Option<&IndexedSource>.Some {..} => true
      Option<&IndexedSource>.None => false
    }
    let selected = run SourceIndex.authoredCursor(&mut index, &entries[0].current, &entry)
      |> Effect.provideMut<Allocator>(&mut system)
    let mut hasNewBody = false
    if let Option<AuthoredCursor>.Some {value} = move selected {
      hasNewBody = hasMagnitude(&index, &value, b"123456789")
    }
    run Testing.expect(currentValid && hasNewBody,
      "retried answer authenticates the changed parsed body")
  }
  return ()
}

test effect fn failedRevisionParsingCanRetrySameRevision() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | AssertionError<'static> {
  return run revisionParseFailureClaims()
}

// Identity must survive offsets, unrelated bindings, declaration reordering and static selection.
// A body edit must invalidate content without renaming the literal or changing its written header.
effect fn anonymousIdentityClaims() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static>
? &mut Allocator {
  let id = run module("anonymous.silk")
  let first = run SourceUnit.parse(&id, usize.ONE, run Bytes.copy(b"""
fn owner() -> () {
  let outer = fn(value: i32) -> i32 {
    let inner = fn(item: i32) -> i32 { return item }
    return value
  }
  let pending = effect {
    let nested = effect fn() -> i32 { return 1 }
    return 2
  }
  static if true {
    let selected = fn(value: i32) -> i32 { return value }
  } else {
    let unselected = fn(value: i32) -> i32 { return value }
  }
  let after = fn(value: i32) -> i32 { return value }
  let deferred = effect fn() -> i32 { return 3 }
}
fn other() -> () { let own = fn(value: i32) -> i32 { return value } }
"""))
  let second = run SourceUnit.parse(&id, 2, run Bytes.copy(b"""
fn other() -> () { let own = fn(value: i32) -> i32 { return value } }

fn owner() -> () {
  let unrelated = 10
  let outer = fn(value: i32) -> i32 {
    let inner = fn(item: i32) -> i32 { return item }
    return value
  }
  let pending = effect {
    let nested = effect fn() -> i32 { return 1 }
    return 2
  }
  static if false {
    let selected = fn(value: i32) -> i32 { return value }
  } else {
    let unselected = fn(value: i32) -> i32 { return value }
  }
  let after = fn(value: i32) -> i32 { return value + 1 }
  let deferred = effect fn() -> i32 { return 3 }
}
"""))
  run Testing.expect(SourceUnit.diagnosticCount(&first) == usize.ZERO && SourceUnit.diagnosticCount(&second) == usize.ZERO, "identity fixtures parse")
  let index = run ModuleIndex.build(&first, false)
  let revised = run ModuleIndex.build(&second, false)
  let before = ModuleIndex.listDeclarations(&index)
  let after = ModuleIndex.listDeclarations(&revised)
  run Testing.expect(before.length == 11 && after.length == 11, "named and literal declarations are indexed")
  let expectedKinds = [OwnerKind.Anonymous, OwnerKind.Anonymous, OwnerKind.EffectBlock, OwnerKind.EffectBlock, OwnerKind.Anonymous, OwnerKind.Anonymous, OwnerKind.Anonymous, OwnerKind.EffectBlock]
  let expectedOccurrences: [usize; 8] = [0, 0, 0, 0, 1, 2, 3, 1]
  let mut at = usize.ZERO
  while at < 8 {
    let identity = &before[at + usize.ONE].identity
    let last = DeclarationId.ownerCount(identity) - usize.ONE
    run Testing.expect(DeclarationId.ownerKind(identity, last) == expectedKinds[at]
      && DeclarationId.ownerOccurrence(identity, last) == expectedOccurrences[at], "literal kind and abstract-body ordinal")
    run Testing.expect(!DeclarationId.ownerNamed(identity, last), "literal owner steps have no name")
    run Testing.expect(DeclarationId.equals(&before[at + usize.ONE].identity, &after[at + 3].identity), "identity survives revision and declaration order")
    run Testing.expect(!before[at + usize.ONE].ambiguous, "same-kind literals are identified by ordinals")
    at = at + usize.ONE
  }
  run Testing.expect(DeclarationId.ownerCount(&before[2].identity) == 3 && DeclarationId.ownerCount(&before[4].identity) == 3, "nested literals have their literal owner in the chain")
  run Testing.expect(DeclarationId.ownerOccurrence(&before[10].identity, usize.ONE) == usize.ZERO, "another named owner starts its own count")
  let oldBody = run Fingerprint.body(&first.authored, before[5].local)
  let newBody = run Fingerprint.body(&second.authored, after[7].local)
  run Testing.expect(RuntimeEncoding.equals(Vector<u8>.asSlice(&oldBody), Vector<u8>.asSlice(&newBody)), "static selection leaves literal content stable")
  let bindingName = run ModuleIndex.observeName(&index, b"outer")
  run Testing.expect(NameObservation.listMembers(&bindingName).length == usize.ZERO, "literal declarations add no module name candidates")
  let oldHeader = run Fingerprint.header(&first.authored, before[7].local)
  let newHeader = run Fingerprint.header(&second.authored, after[9].local)
  run Testing.expect(RuntimeEncoding.equals(Vector<u8>.asSlice(&oldHeader), Vector<u8>.asSlice(&newHeader)), "anonymous written header excludes its body")
  let changedBody = run Fingerprint.body(&first.authored, before[7].local)
  let revisedBody = run Fingerprint.body(&second.authored, after[9].local)
  run Testing.expect(!RuntimeEncoding.equals(Vector<u8>.asSlice(&changedBody), Vector<u8>.asSlice(&revisedBody)), "literal body edits invalidate content without changing identity")
  let mut oldEncoding = Bytes.make()
  let mut newEncoding = Bytes.make()
  let mut effectEncoding = Bytes.make()
  run RuntimeEncoding.declaration(&mut oldEncoding, &before[1].identity)
  run RuntimeEncoding.declaration(&mut newEncoding, &after[3].identity)
  run RuntimeEncoding.declaration(&mut effectEncoding, &before[3].identity)
  run Testing.expect(RuntimeEncoding.equals(Bytes.asSlice(&oldEncoding), Bytes.asSlice(&newEncoding)) && !RuntimeEncoding.equals(Bytes.asSlice(&oldEncoding), Bytes.asSlice(&effectEncoding)), "canonical encoding preserves literal identity and distinguishes owner kinds")
  return ()
}

test effect fn anonymousDeclarationsUseAbstractBodyOrdinals() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run anonymousIdentityClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

// The fingerprints of the declaration named `name` in a fingerprinted index of `text`.
effect fn fingerprintsIn(text: string, name: string) -> Option<Fingerprints>
! InvalidModulePath | OutOfMemoryError
? &mut Allocator {
  let id = run module("fingerprints.silk")
  let unit = run SourceUnit.parse(&id, usize.ONE, run Bytes.copy(String.utf8Bytes(text)))
  let index = run ModuleIndex.build(&unit, true)
  let declarations = ModuleIndex.listDeclarations(&index)
  let mut at = usize.ZERO
  while at < declarations.length {
    if DeclarationId.named(&declarations[at].identity, String.utf8Bytes(name)) {
      if let Option<Fingerprints>.Some {value} = &declarations[at].fingerprints {
        return Option<Fingerprints>.some(value)
      }
    }
    at = at + usize.ONE
  }
  return Option<Fingerprints>.none()
}

fn sameWhole(left: &Option<Fingerprints>, right: &Option<Fingerprints>) -> bool {
  if let Option<Fingerprints>.Some {value: first} = &left.* {
    if let Option<Fingerprints>.Some {value: second} = &right.* {
      return ContentHash.equals(first.whole, second.whole)
    }
  }
  return false
}

fn samePrototype(left: &Option<Fingerprints>, right: &Option<Fingerprints>) -> bool {
  if let Option<Fingerprints>.Some {value: first} = &left.* {
    if let Option<Fingerprints>.Some {value: second} = &right.* {
      return ContentHash.equals(first.prototype, second.prototype)
    }
  }
  return false
}

// Fingerprints cover significant tokens and the line breaks before them, never trivia or
// positions; a nested declaration stands in for its parent by identity (incremental v2 §3.1).
effect fn declarationFingerprintClaims() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static>
? &mut Allocator {
  let base = "fn leaf() -> i32 { return 1 }\nstruct Point { x: i32 }\nimpl Point { fn get(self: Self) -> i32 { return self.x } }\n"
  let spaced = "fn  leaf()  ->  i32  {  return  1  }  // spaced\nstruct Point { x: i32 }\nimpl Point { fn get(self: Self) -> i32 { return self.x } }\n"
  let moved = "// a new first line\n\nstruct Point { x: i32 }\nfn leaf() -> i32 { return 1 }\nimpl Point { fn get(self: Self) -> i32 { return self.x } }\n"
  let bodyEdit = "fn leaf() -> i32 { return 2 }\nstruct Point { x: i32 }\nimpl Point { fn get(self: Self) -> i32 { return self.x } }\n"
  let signatureEdit = "fn leaf() -> i64 { return 1 }\nstruct Point { x: i32 }\nimpl Point { fn get(self: Self) -> i32 { return self.x } }\n"
  let broken = "fn leaf() -> i32 {\n  return 1 }\nstruct Point { x: i32 }\nimpl Point { fn get(self: Self) -> i32 { return self.x } }\n"
  let memberEdit = "fn leaf() -> i32 { return 1 }\nstruct Point { x: i32 }\nimpl Point { fn get(self: Self) -> i32 { return 0 } }\n"
  let leaf = run fingerprintsIn(base, "leaf")
  let spacedLeaf = run fingerprintsIn(spaced, "leaf")
  run Testing.expect(sameWhole(&leaf, &spacedLeaf) && samePrototype(&leaf, &spacedLeaf),
    "spacing and comments leave both fingerprints equal")
  let movedLeaf = run fingerprintsIn(moved, "leaf")
  let point = run fingerprintsIn(base, "Point")
  let movedPoint = run fingerprintsIn(moved, "Point")
  run Testing.expect(sameWhole(&leaf, &movedLeaf) && sameWhole(&point, &movedPoint),
    "moving declarations leaves their fingerprints equal")
  let editedLeaf = run fingerprintsIn(bodyEdit, "leaf")
  run Testing.expect(!sameWhole(&leaf, &editedLeaf) && samePrototype(&leaf, &editedLeaf),
    "a body edit changes the whole fingerprint and keeps the prototype")
  let retypedLeaf = run fingerprintsIn(signatureEdit, "leaf")
  run Testing.expect(!sameWhole(&leaf, &retypedLeaf) && !samePrototype(&leaf, &retypedLeaf),
    "a signature edit changes both fingerprints")
  let brokenLeaf = run fingerprintsIn(broken, "leaf")
  run Testing.expect(!sameWhole(&leaf, &brokenLeaf),
    "a new line break before a token changes the whole fingerprint, since the parser reads line breaks")
  let id = run module("fingerprints.silk")
  let unit = run SourceUnit.parse(&id, usize.ONE, run Bytes.copy(String.utf8Bytes(memberEdit)))
  let revised = run ModuleIndex.build(&unit, true)
  let original = run SourceUnit.parse(&id, usize.ONE, run Bytes.copy(String.utf8Bytes(base)))
  let index = run ModuleIndex.build(&original, true)
  let editedUnit = run SourceUnit.parse(&id, usize.ONE, run Bytes.copy(String.utf8Bytes(bodyEdit)))
  let editedIndex = run ModuleIndex.build(&editedUnit, true)
  let retypedUnit = run SourceUnit.parse(&id, usize.ONE, run Bytes.copy(String.utf8Bytes(signatureEdit)))
  let retypedIndex = run ModuleIndex.build(&retypedUnit, true)
  run Testing.expect(ModuleIndex.matchesPrototype(&index, usize.ZERO, &editedIndex, usize.ZERO)
    && !ModuleIndex.matchesDeclaration(&index, usize.ZERO, &editedIndex, usize.ZERO)
    && !ModuleIndex.matchesPrototype(&index, usize.ZERO, &retypedIndex, usize.ZERO),
    "prototype comparison retains a body edit but observes a signature edit")
  let before = ModuleIndex.listDeclarations(&index)
  let after = ModuleIndex.listDeclarations(&revised)
  // The impl, then its member: a member body edit changes the member and leaves the impl equal.
  run Testing.expect(before.length == 4 && after.length == 4
    && ModuleIndex.matchesDeclaration(&index, 2, &revised, 2) && !ModuleIndex.matchesDeclaration(&index, 3, &revised, 3)
    && ModuleIndex.matchesPrototype(&index, 3, &revised, 3)
    && ModuleIndex.matchesDeclaration(&index, usize.ZERO, &revised, usize.ZERO),
    "a member body edit changes the member and leaves its impl and siblings equal")
  let oneShot = run ModuleIndex.build(&original, false)
  let unprinted = ModuleIndex.listDeclarations(&oneShot)
  let mut none = true
  let mut at = usize.ZERO
  while at < unprinted.length {
    if let Option<Fingerprints>.Some {..} = &unprinted[at].fingerprints {
      none = false
    }
    at = at + usize.ONE
  }
  run Testing.expect(none && !ModuleIndex.matchesDeclaration(&oneShot, usize.ZERO, &oneShot, usize.ZERO)
    && !ModuleIndex.matchesPrototype(&oneShot, usize.ZERO, &oneShot, usize.ZERO),
    "an index built for a one-shot store computes no fingerprints and matches nothing")
  let mut handles = DeclarationTable.make()
  let originalDeclarations = ModuleIndex.listDeclarations(&index)
  let leafHandle = run DeclarationTable.intern(
    &mut handles, usize.ZERO, usize.ZERO, &originalDeclarations[0].identity)
  let beforeSignature = Option<ModuleIndex>.some(move index)
  run DeclarationTable.refresh(&mut handles, usize.ZERO, &beforeSignature, &retypedIndex)
  if let Option<ModuleIndex>.Some {value: oldIndex} = &beforeSignature {
    let signature = DeclarationTable.changes(&handles, leafHandle, &oldIndex, &retypedIndex)
    run Testing.expect(signature.wholeChanged && signature.prototypeChanged,
      "a signature edit changes both recorded declaration inputs")
  }
  let withoutFingerprints = run ModuleIndex.build(&retypedUnit, false)
  let beforeOneShot = Option<ModuleIndex>.some(move retypedIndex)
  run DeclarationTable.refresh(&mut handles, usize.ZERO, &beforeOneShot, &withoutFingerprints)
  if let Option<ModuleIndex>.Some {value: oldIndex} = &beforeOneShot {
    let unknown = DeclarationTable.changes(&handles, leafHandle, &oldIndex, &withoutFingerprints)
    let invalid = DeclarationTable.changes(&handles, usize.MAX, &oldIndex, &withoutFingerprints)
    run Testing.expect(unknown.wholeChanged && unknown.prototypeChanged
      && invalid.wholeChanged && invalid.prototypeChanged,
      "missing fingerprints and invalid handles conservatively change both inputs")
  }
  return ()
}

test effect fn declarationFingerprintsIgnoreTriviaAndPositions() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run declarationFingerprintClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

// Handles name declarations across revisions; source ordinals are only current projections.
effect fn declarationHandleClaims() -> ()
  ! InvalidModulePath | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator {
  let id = run module("handles.silk")
  let firstSource = run SourceUnit.parse(
    &id,
    usize.ONE,
    run Bytes.copy(b"fn leaf() -> i32 { return 1 }\nfn sibling() -> i32 { return 2 }\n")
  )
  let first = run ModuleIndex.build(&firstSource, true)
  let mut handles = DeclarationTable.make()
  let firstDeclarations = ModuleIndex.listDeclarations(&first)
  let leaf = run DeclarationTable.intern(
    &mut handles,
    usize.ZERO,
    usize.ZERO,
    &firstDeclarations[0].identity
  )
  let sibling = run DeclarationTable.intern(
    &mut handles,
    usize.ZERO,
    usize.ONE,
    &firstDeclarations[1].identity
  )
  let movedSource = run SourceUnit.parse(
    &id,
    usize.ONE,
    run Bytes.copy(
      b"fn prefix() -> i32 { return 0 }\nfn sibling() -> i32 { return 2 }\nfn leaf() -> i32 { return 3 }\n"
    )
  )
  let moved = run ModuleIndex.build(&movedSource, true)
  run Testing.expect(
    ModuleIndex.matchesIdentity(&first, usize.ZERO, &moved, 2)
      && !ModuleIndex.matchesDeclaration(&first, usize.ZERO, &moved, 2),
    "body edits retain identity independently of equal content"
  )
  let beforeMove = Option<ModuleIndex>.some(move first)
  run DeclarationTable.refresh(&mut handles, usize.ZERO, &beforeMove, &moved)
  run Testing.expect(
    DeclarationTable.position(&handles, leaf) == 2
      && DeclarationTable.position(&handles, sibling) == 1
      && DeclarationTable.cached(&handles, usize.ZERO, 2) == leaf,
    "insertion and reordering keep handles and update only source positions"
  )
  if let Option<ModuleIndex>.Some {value: before} = &beforeMove {
    let edited = DeclarationTable.changes(&handles, leaf, &before, &moved)
    let unchanged = DeclarationTable.changes(&handles, sibling, &before, &moved)
    run Testing.expect(DeclarationTable.moduleOf(&handles, leaf) == usize.ZERO
      && DeclarationTable.moduleOf(&handles, usize.MAX) == usize.MAX
      && edited.wholeChanged && !edited.prototypeChanged
      && !unchanged.wholeChanged && !unchanged.prototypeChanged,
      "recorded handles distinguish a moved body edit from an unchanged sibling")
  }
  let movedDeclarations = ModuleIndex.listDeclarations(&moved)
  let prefix = run DeclarationTable.intern(
    &mut handles,
    usize.ZERO,
    usize.ZERO,
    &movedDeclarations[0].identity
  )
  run Testing.expect(
    prefix != leaf && prefix != sibling,
    "a new declaration gets its own dense handle"
  )
  let deletedSource = run SourceUnit.parse(
    &id,
    usize.ONE,
    run Bytes.copy(b"fn prefix() -> i32 { return 0 }\nfn sibling() -> i32 { return 2 }\n")
  )
  let deleted = run ModuleIndex.build(&deletedSource, true)
  let beforeDelete = Option<ModuleIndex>.some(move moved)
  run DeclarationTable.refresh(&mut handles, usize.ZERO, &beforeDelete, &deleted)
  run Testing.expect(
    DeclarationTable.position(&handles, leaf) == usize.MAX
      && DeclarationTable.position(&handles, sibling) == 1,
    "deletion loses only the removed handle"
  )
  if let Option<ModuleIndex>.Some {value: before} = &beforeDelete {
    let lost = DeclarationTable.changes(&handles, leaf, &before, &deleted)
    let kept = DeclarationTable.changes(&handles, sibling, &before, &deleted)
    run Testing.expect(DeclarationTable.moduleOf(&handles, leaf) == usize.ZERO
      && lost.wholeChanged && lost.prototypeChanged
      && !kept.wholeChanged && !kept.prototypeChanged,
      "lost handles keep their owner and invalidate both declaration inputs")
  }
  let restoredSource = run SourceUnit.parse(
    &id,
    usize.ONE,
    run Bytes.copy(
      b"fn leaf() -> i32 { return 1 }\nfn prefix() -> i32 { return 0 }\nfn sibling() -> i32 { return 2 }\n"
    )
  )
  let restored = run ModuleIndex.build(&restoredSource, true)
  let beforeRestore = Option<ModuleIndex>.some(move deleted)
  run DeclarationTable.refresh(&mut handles, usize.ZERO, &beforeRestore, &restored)
  let restoredDeclarations = ModuleIndex.listDeclarations(&restored)
  let replacement = run DeclarationTable.intern(
    &mut handles,
    usize.ZERO,
    usize.ZERO,
    &restoredDeclarations[0].identity
  )
  run Testing.expect(
    replacement != leaf && DeclarationTable.position(&handles, leaf) == usize.MAX
      && DeclarationTable.position(&handles, sibling) == 2,
    "reintroduction allocates a new handle without reviving a lost unit key"
  )
  if let Option<ModuleIndex>.Some {value: before} = &beforeRestore {
    let old = DeclarationTable.changes(&handles, leaf, &before, &restored)
    let new = DeclarationTable.changes(&handles, replacement, &before, &restored)
    run Testing.expect(old.wholeChanged && old.prototypeChanged
      && new.wholeChanged && new.prototypeChanged,
      "reintroduced spelling cannot match either the lost or the new handle to an old declaration")
  }
  let ambiguousSource = run SourceUnit.parse(
    &id,
    usize.ONE,
    run Bytes.copy(
      b"fn leaf() -> i32 { return 1 }\nfn leaf() -> i32 { return 2 }\nfn sibling() -> i32 { return 2 }\n"
    )
  )
  let ambiguous = run ModuleIndex.build(&ambiguousSource, true)
  run Testing.expect(
    !ModuleIndex.matchesIdentity(&restored, usize.ZERO, &ambiguous, usize.ZERO)
      && ModuleIndex.matchesIdentity(&restored, 2, &ambiguous, 2),
    "changed same-key counts lose that group while distinct siblings survive"
  )
  let beforeAmbiguous = Option<ModuleIndex>.some(move restored)
  run DeclarationTable.refresh(&mut handles, usize.ZERO, &beforeAmbiguous, &ambiguous)
  run Testing.expect(
    DeclarationTable.position(&handles, replacement) == usize.MAX
      && DeclarationTable.position(&handles, sibling) == 2,
    "ambiguous group refresh loses its old handle without losing a distinct sibling"
  )
  if let Option<ModuleIndex>.Some {value: before} = &beforeAmbiguous {
    let ambiguousChange = DeclarationTable.changes(&handles, replacement, &before, &ambiguous)
    let unchanged = DeclarationTable.changes(&handles, sibling, &before, &ambiguous)
    run Testing.expect(ambiguousChange.wholeChanged && ambiguousChange.prototypeChanged
      && !unchanged.wholeChanged && !unchanged.prototypeChanged,
      "same-key count changes invalidate that group without invalidating distinct siblings")
  }
  DeclarationTable.lose(&mut handles, usize.ZERO)
  run Testing.expect(
    DeclarationTable.position(&handles, sibling) == usize.MAX
      && DeclarationTable.cached(&handles, usize.ZERO, 2) == usize.MAX,
    "module absence ends its surviving handles and current position hits"
  )
  let ambiguousDeclarations = ModuleIndex.listDeclarations(&ambiguous)
  let again = run DeclarationTable.intern(
    &mut handles,
    usize.ZERO,
    2,
    &ambiguousDeclarations[2].identity
  )
  run Testing.expect(
    again != sibling,
    "restoring a module cannot revive its old declaration handle"
  )
  return ()
}

test effect fn declarationHandlesSurviveMovesAndNeverRevive() -> ()
  ! InvalidModulePath | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run declarationHandleClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}


struct RecordFailureAllocator {
  target: usize
  attempts: usize
  rejected: bool
}

impl RecordFailureAllocator {
  effect fn allocate(self: &mut Self, layout: Layout) -> Intrinsic.Allocation
    ! OutOfMemoryError {
    self.attempts = self.attempts + usize.ONE
    if self.attempts == self.target {
      self.rejected = true
      fail OutOfMemoryError {}
    }
    let mut system = Allocator.systemAllocatorProvider()
    return run Allocator.allocate(move layout) |> Effect.provideMut<Allocator>(&mut system)
  }
}

impl Allocator for RecordFailureAllocator {
  allocate: RecordFailureAllocator.allocate
}

// Failure at each allocation boundary must not leave a hidden ordinal in a collision chain.
effect fn indexPublicationClaims() -> ()
  ! OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator {
  let mut stage = usize.ZERO
  while stage < 2 {
    let existing: usize = match stage {
      0 => usize.ZERO
      _ => 12
    }
    let allocations: usize = match stage {
      0 => 4
      _ => 2
    }
    let mut target = usize.ONE
    while target <= allocations {
      let mut index = InternIndex.make()
      let mut at = usize.ZERO
      while at < existing {
        run InternIndex.record(&mut index, 7)
        at = at + usize.ONE
      }
      let mut fault = RecordFailureAllocator {
        target: target,
        attempts: usize.ZERO,
        rejected: false
      }
      let attempted = run Effect.result(InternIndex.record(&mut index, 7))
        |> Effect.provideMut<Allocator>(&mut fault)
      let failed = match move attempted {
        Result<(), OutOfMemoryError>.Failure { .. } => true
        Result<(), OutOfMemoryError>.Success { .. } => false
      }
      run Testing.expect(failed && fault.rejected, "the chosen initial or growth allocation failed")
      run InternIndex.record(&mut index, 7)
      let mut ordinal = InternIndex.first(&index, 7)
      at = usize.ZERO
      while at <= existing {
        run Testing.expect(ordinal == at, "retry records exactly the next table ordinal")
        ordinal = InternIndex.after(&index, ordinal)
        at = at + usize.ONE
      }
      run Testing.expect(
        ordinal == usize.MAX,
        "failed publication left no extra collision-chain entry"
      )
      target = target + usize.ONE
    }
    stage = stage + usize.ONE
  }
  return ()
}

test effect fn indexPublicationFailuresKeepDeclarationOrdinalsAligned() -> ()
  ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run indexPublicationClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn stableLocationClaims() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static>
? &mut Allocator {
  let id = run module("entry.silk")
  let before = run SourceUnit.parse(&id, usize.ZERO, run Bytes.copy(b"fn entry(\n  value: i32) -> i32 { return\n  value }\n"))
  let after = run SourceUnit.parse(&id, usize.ONE, run Bytes.copy(b"fn prefix() -> i32 { return 0 }\nfn entry( //header\n    value: i32) -> i32 { return //body\n       value }\n"))
  let beforeIndex = run ModuleIndex.build(&before, true)
  let afterIndex = run ModuleIndex.build(&after, true)
  run Testing.expect(ModuleIndex.matchesDeclaration(&beforeIndex, usize.ZERO, &afterIndex, usize.ONE),
    "trivia and an earlier declaration preserve the selected declaration's semantic input")
  let earlier = ModuleIndex.listDeclarations(&beforeIndex)[usize.ZERO].local
  let current = ModuleIndex.listDeclarations(&afterIndex)[usize.ONE].local
  let oldAnchor = match move Anchor.of(&before.authored, &before.locations, earlier) {
    Option<Anchor>.Some {value} => move value
    Option<Anchor>.None => {return run Testing.expect(false, "earlier declaration has an anchor")}
  }
  let newAnchor = match move Anchor.of(&after.authored, &after.locations, current) {
    Option<Anchor>.Some {value} => move value
    Option<Anchor>.None => {return run Testing.expect(false, "current declaration has an anchor")}
  }
  // Deliberately name the declaration while selecting only its parameter-name token.
  let name = Origin.at(&oldAnchor, earlier, Span.make(12, 17))
  let use = Origin.at(&oldAnchor, earlier, Span.make(42, 47))
  let empty = Origin.at(&oldAnchor, earlier, Span.make(42, 42))
  let named = Origin.span(name, &newAnchor)
  let used = Origin.span(use, &newAnchor)
  let point = Origin.span(empty, &newAnchor)
  run Testing.expect(Origin.syntax(name, &newAnchor).index == current.index
    && named.start == 55 && named.end == 60
    && used.start == 97 && used.end == 102
    && point.start == 97 && point.end == 97,
    "retained origins project exact current name/use/empty spans after trivia inside the declaration")
  let retained = Origin.span(use, &oldAnchor)
  run Testing.expect(retained.start == 42 && retained.end == 47,
    "the old anchor still resolves its own immutable source revision")
  return ()
}

test effect fn originsProjectCurrentTokenBoundariesAfterTriviaEdits() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run stableLocationClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn declarationLocationChanged(before: string, after: Option<Bytes>, ordinal: usize) -> bool
! InvalidModulePath | OutOfMemoryError | Cycle | AssertionError<'static>
? &mut Allocator {
  let id = run module("location.silk")
  let initial = run Revision.publish(&Revision.make(), &id, &run present(before))
  let successor = run Revision.copy(&initial)
  let mut index = SourceIndex.make(move initial)
  let answer = run SourceIndex.demand(&mut index, &id)
  let found = run SourceIndex.sharedIdentity(&mut index, &answer, &id, ordinal)
  let identity = match move found {
    Option<Shared<DeclarationId>>.Some {value} => DeclarationId.copyShared(&value)
    Option<Shared<DeclarationId>>.None => {
      run Testing.expect(false, "fixture declaration has a stable identity")
      return true
    }
  }
  let remainsPresent = match &after {
    Option<Bytes>.Some {..} => true
    Option<Bytes>.None => false
  }
  let next = run Revision.publish(&successor, &id, &after)
  let changes = run SourceIndex.revise(&mut index, move next)
  let entries = Vector<SourceChange>.asSlice(&changes)
  run Testing.expect(entries.length == usize.ONE && ModuleId.equals(&entries[usize.ZERO].module, &id),
    "fixture revision changes exactly its loaded module")
  let compared = run SourceIndex.locationComparison(&index, &entries[usize.ZERO])
  if let Option<LocationComparison>.Some {value} = move compared {
    return LocationComparison.changed(&value, &identity)
  }
  run Testing.expect(!remainsPresent, "present revised source has location evidence")
  return true
}

effect fn declarationLocationClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | AssertionError<'static>
? &mut Allocator {
  run Testing.expect(!run declarationLocationChanged(
    "fn a() -> i32 { return 1 }\nfn b() -> i32 { return 3 }\n",
    run present("fn a() -> i32 { return 2 }\nfn b() -> i32 { return 4 }\n"),
    usize.ZERO,
  ), "body token text changes at equal boundaries retain location")
  run Testing.expect(!run declarationLocationChanged(
    "fn a() -> i32 { return 1 }\n",
    run present("fn a() -> i32 { return 1 }\nfn b() -> i32 { return 2 }\n"),
    usize.ZERO,
  ), "a later declaration does not change an earlier declaration's location")
  run Testing.expect(run declarationLocationChanged(
    "fn a() -> i32 { return 1 }\n",
    run present("fn a() -> i32 { return  1 }\n"),
    usize.ZERO,
  ), "trivia that moves a significant token changes location")
  run Testing.expect(run declarationLocationChanged(
    "fn a() -> i32 {\n return 1 }\n",
    run present("fn a() -> i32 { \nreturn 1 }\n"),
    usize.ZERO,
  ), "a moved newline changes columns at equal token byte boundaries")
  run Testing.expect(run declarationLocationChanged(
    "fn a() -> i32 { return 1 }\n",
    run present("fn b() -> i32 { return 1 }\n"),
    usize.ZERO,
  ), "a removed stable declaration changes location")
  run Testing.expect(run declarationLocationChanged(
    "fn a() -> i32 { return 1 }\n",
    Option<Bytes>.none(),
    usize.ZERO,
  ), "an absent revised source changes location")
  run Testing.expect(run declarationLocationChanged(
    "fn a() -> i32 { return 1 }\nfn a() -> i32 { return 2 }\n",
    run present("fn a() -> i32 { return 1 }\nfn a() -> i32 { return 3 }\n"),
    usize.ZERO,
  ), "duplicate same-key siblings cannot prove a retained location")
  return ()
}

test effect fn revisionLocationComparisonTracksOnlyStableTokenProjections() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run declarationLocationClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

fn isSyntaxInput(index: &ModuleIndex, hir: &Module, id: HirId, ordinal: usize, prototype: bool) -> bool {
  let found = ModuleIndex.syntaxInput(index, hir, id)
  return match move found {
    Option<SyntaxInput>.Some {value} => value.ordinal == ordinal && value.prototype == prototype
    Option<SyntaxInput>.None => false
  }
}

test effect fn syntaxReadsConstantInitializerOwner() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("static-owner.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let source = run SourceUnit.parse(&id, usize.ONE,
    run Bytes.copy(b"const number: u32 = 7\nconst idle: u32 = 10\n") |> Effect.provideMut<Allocator>(&mut allocator))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let index = run ModuleIndex.build(&source, true) |> Effect.provideMut<Allocator>(&mut allocator)
  let declarations = ModuleIndex.listDeclarations(&index)
  let mut owned = false
  if declarations.length == 2 {
    if let Node.Declaration {body, ..} = Module.node(&source.authored, declarations[usize.ZERO].local) {
      if let Node.InitializerBody {value} = Module.node(&source.authored, body) {
        owned = value.present && isSyntaxInput(&index, &source.authored, value.id, usize.ZERO, false)
      }
    }
  }
  return run Testing.expect(owned, "a constant initializer expression reads its own declaration")
}

effect fn syntaxNestedClaims() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static>
? &mut Allocator {
  let id = run module("ownership.silk")
  let nested = run SourceUnit.parse(&id, usize.ONE, run Bytes.copy(b"""
impl Thing { fn member(self: Self) -> i32 { return 1 } }
static if true { fn yes() -> i32 { return 2 } } else { fn no() -> i32 { return 3 } }
"""))
  let index = run ModuleIndex.build(&nested, true)
  let hir = &nested.authored
  let declarations = ModuleIndex.listDeclarations(&index)
  run Testing.expect(declarations.length >= 4 && DeclarationId.kind(&declarations[usize.ZERO].identity) == OwnerKind.Implementation
    && DeclarationId.kind(&declarations[usize.ONE].identity) == OwnerKind.Function,
    "implementation and member have indexed nested identities")
  let member = &declarations[usize.ONE]
  let memberName = match Module.node(hir, member.header) {
    Node.FunctionHeader {name, ..} => name
    _ => { return run Testing.expect(false, "member has a callable header") }
  }
  let memberBody = match Module.node(hir, member.local) {
    Node.Declaration {body, ..} => body
    _ => { return run Testing.expect(false, "member is an authored declaration") }
  }
  run Testing.expect(isSyntaxInput(&index, hir, memberName, usize.ONE, true)
    && isSyntaxInput(&index, hir, member.header, usize.ONE, true)
    && isSyntaxInput(&index, hir, memberBody, usize.ONE, false)
    && isSyntaxInput(&index, hir, member.local, usize.ONE, false)
    && isSyntaxInput(&index, hir, declarations[usize.ZERO].header, usize.ZERO, false),
    "nested callable header nodes use prototype and body nodes use the member whole input")
  let mut armed = usize.ZERO
  let mut thenSeen = false
  let mut elseSeen = false
  let mut at = usize.ZERO
  while at < declarations.length {
    if DeclarationId.kind(&declarations[at].identity) == OwnerKind.Function {
      if let Option<Arm>.Some {value: arm} = &declarations[at].arm {
        run Testing.expect(isSyntaxInput(&index, hir, declarations[at].header, at, true)
          && isSyntaxInput(&index, hir, declarations[at].local, at, false),
          "both static-arm functions own their header and body syntax")
        if arm.holds { thenSeen = true } else { elseSeen = true }
        armed = armed + usize.ONE
      }
    }
    at = at + usize.ONE
  }
  run Testing.expect(armed == 2 && thenSeen && elseSeen, "both static arms are indexed without selecting either")
  return ()
}

effect fn syntaxLiteralClaims() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static>
? &mut Allocator {
  let id = run module("literals.silk")
  let literals = run SourceUnit.parse(&id, usize.ONE, run Bytes.copy(b"""
fn host() -> () {
  let callable = fn(value: i32) -> i32 { return value }
  let pending = effect { return 2 }
}
"""))
  let literalIndex = run ModuleIndex.build(&literals, true)
  let entries = ModuleIndex.listDeclarations(&literalIndex)
  run Testing.expect(entries.length == 3
    && DeclarationId.kind(&entries[usize.ONE].identity) == OwnerKind.Anonymous
    && DeclarationId.kind(&entries[2].identity) == OwnerKind.EffectBlock,
    "callable and Effect literals have abstract identities within their host")
  run Testing.expect(isSyntaxInput(&literalIndex, &literals.authored, entries[usize.ONE].header, usize.ZERO, false)
    && isSyntaxInput(&literalIndex, &literals.authored, entries[usize.ONE].local, usize.ZERO, false)
    && isSyntaxInput(&literalIndex, &literals.authored, entries[2].local, usize.ZERO, false),
    "literal syntax lifts to the enclosing named declaration's whole input")
  let missing = ModuleIndex.syntaxInput(&literalIndex, &literals.authored, HirId {index: usize.MAX})
  run Testing.expect(match move missing { Option<SyntaxInput>.None => true _ => false },
    "an unknown HIR node keeps a coarse source dependency")
  return ()
}

effect fn syntaxDamagedClaims() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static>
? &mut Allocator {
  let id = run module("damaged.silk")
  let damaged = run SourceUnit.parse(&id, usize.ONE, run Bytes.copy(b"fn broken( -> () { return () }\n"))
  let damagedIndex = run ModuleIndex.build(&damaged, true)
  let broken = ModuleIndex.listDeclarations(&damagedIndex)
  run Testing.expect(broken.length == usize.ONE && SourceUnit.diagnosticCount(&damaged) > usize.ZERO,
    "damaged source retains one authored declaration")
  run Testing.expect(isSyntaxInput(&damagedIndex, &damaged.authored, broken[usize.ZERO].header, usize.ZERO, false)
    && isSyntaxInput(&damagedIndex, &damaged.authored, broken[usize.ZERO].local, usize.ZERO, false),
    "an authenticated damaged declaration uses its whole owner for header and local syntax")
  return ()
}

