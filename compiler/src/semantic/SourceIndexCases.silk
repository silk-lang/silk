test effect fn implInventoryConservativelyChangesUncertainSources() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run implInventoryUncertaintyClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

