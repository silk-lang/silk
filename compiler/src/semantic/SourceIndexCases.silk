effect fn fingerprintByteClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | AssertionError<'static>
? &mut Allocator {
  let id = run module("fingerprints.silk")
  let original = run SourceUnit.parse(&id, usize.ONE, run Bytes.copy(b"fn a() {}\n"))
  let named = run ModuleIndex.build(&original, true)
  let ordinary = run ModuleIndex.build(&original, false)
  run Testing.expect(ModuleIndex.fingerprintBytesHashed(&named) == 62
    && ModuleIndex.fingerprintBytesHashed(&ordinary) == usize.ZERO,
    "whole and prototype hash exactly their framed token bytes only in a revisable index")

  let first = run Revision.publish(&Revision.make(), &id, &run present("fn a() {}\n"))
  let mut index = SourceIndex.make(run Revision.copy(&first))
  let loaded = run SourceIndex.demand(&mut index, &id)
  drop loaded
  run Testing.expect(SourceIndex.fingerprintBytesHashed(&index) == 62,
    "a completed source publication contributes its indexed fingerprint bytes once")
  let repeated = run SourceIndex.demand(&mut index, &id)
  drop repeated
  let same = run Revision.publish(&first, &id, &run present("fn a() {}\n"))
  let unchanged = run SourceIndex.revise(&mut index, run Revision.copy(&same))
  run Testing.expect(Vector<SourceChange>.length(&unchanged) == usize.ZERO
    && SourceIndex.fingerprintBytesHashed(&index) == 62,
    "a memo hit and equal-byte revision hash no new declaration input")

  let trivia = run Revision.publish(&same, &id, &run present("// moved\nfn a() { }\n"))
  let triviaChanges = run SourceIndex.revise(&mut index, run Revision.copy(&trivia))
  run Testing.expect(Vector<SourceChange>.length(&triviaChanges) == usize.ONE
    && SourceIndex.fingerprintBytesHashed(&index) == 124,
    "reindexing changed bytes counts the same significant-token input despite extra trivia")
  let changed = run Revision.publish(&trivia, &id, &run present("fn a() { return 1 }\n"))
  let changedSources = run SourceIndex.revise(&mut index, move changed)
  run Testing.expect(Vector<SourceChange>.length(&changedSources) == usize.ONE
    && SourceIndex.fingerprintBytesHashed(&index) > 124,
    "a changed body contributes its newly hashed token bytes after publication")

  let mut oneShot = SourceIndex.oneShot(run Revision.copy(&first))
  let oneShotAnswer = run SourceIndex.demand(&mut oneShot, &id)
  drop oneShotAnswer
  run Testing.expect(SourceIndex.fingerprintBytesHashed(&oneShot) == usize.ZERO,
    "a one-shot source store performs no fingerprint hashing")
  return ()
}

test effect fn fingerprintByteCounterTracksPublishedIndexes() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run fingerprintByteClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn stagedFingerprintByteClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | AssertionError<'static> {
  let mut system = Allocator.systemAllocatorProvider()
  let first = run module("first.silk") |> Effect.provideMut<Allocator>(&mut system)
  let second = run module("second.silk") |> Effect.provideMut<Allocator>(&mut system)
  let initialFirst = run present("fn first() {}\n") |> Effect.provideMut<Allocator>(&mut system)
  let initialSecond = run present("fn second() {}\n") |> Effect.provideMut<Allocator>(&mut system)
  let one = run Revision.publish(&Revision.make(), &first, &initialFirst)
    |> Effect.provideMut<Allocator>(&mut system)
  let initial = run Revision.publish(&one, &second, &initialSecond)
    |> Effect.provideMut<Allocator>(&mut system)
  let mut index = SourceIndex.make(move initial)
  let firstAnswer = run SourceIndex.demand(&mut index, &first)
    |> Effect.provideMut<Allocator>(&mut system)
  let secondAnswer = run SourceIndex.demand(&mut index, &second)
    |> Effect.provideMut<Allocator>(&mut system)
  drop firstAnswer
  drop secondAnswer
  let before = SourceIndex.fingerprintBytesHashed(&index)
  let firstEdited = run present("fn first() { return 123 }\n")
    |> Effect.provideMut<Allocator>(&mut system)
  let secondText = "fn second() { return 987654321 }\n// second changed source parse allocation\n"
  let secondEdited = run present(secondText) |> Effect.provideMut<Allocator>(&mut system)
  let firstChange = run Revision.publish(&Revision.make(), &first, &firstEdited)
    |> Effect.provideMut<Allocator>(&mut system)
  let revision = run Revision.publish(&firstChange, &second, &secondEdited)
    |> Effect.provideMut<Allocator>(&mut system)
  let attempt = run Revision.copy(&revision) |> Effect.provideMut<Allocator>(&mut system)
  let mut fault = RevisionParseAllocator {
    targetBytes: String.utf8Bytes(secondText).length,
    rejected: false,
  }
  let failed = run Effect.result(SourceIndex.revise(&mut index, move attempt))
    |> Effect.provideMut<Allocator>(&mut fault)
  run Testing.expect(match move failed {
    Result<Vector<SourceChange>, OutOfMemoryError>.Failure {..} => true
    Result<Vector<SourceChange>, OutOfMemoryError>.Success {..} => false
  } && fault.rejected && SourceIndex.fingerprintBytesHashed(&index) == before,
    "an index staged before a later parse failure does not enter the published byte count")
  let changes = run SourceIndex.revise(&mut index, move revision)
    |> Effect.provideMut<Allocator>(&mut system)
  run Testing.expect(Vector<SourceChange>.length(&changes) == 2
    && SourceIndex.fingerprintBytesHashed(&index) > before,
    "retry counts the changed indexes when the revision publishes")
  return ()
}

test effect fn fingerprintBytesCountOnlyAfterStagedPublication() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | AssertionError<'static> {
  return run stagedFingerprintByteClaims()
}
