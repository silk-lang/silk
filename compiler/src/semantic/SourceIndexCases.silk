effect fn namespaceMatches(before: string, after: string) -> bool
! InvalidModulePath | OutOfMemoryError | AssertionError<'static>
? &mut Allocator {
  let id = run module("namespace.silk")
  let first = run SourceUnit.parse(&id, usize.ONE, run Bytes.copy(String.utf8Bytes(before)))
  let second = run SourceUnit.parse(&id, 2, run Bytes.copy(String.utf8Bytes(after)))
  run Testing.expect(SourceUnit.diagnosticCount(&first) == usize.ZERO
    && SourceUnit.diagnosticCount(&second) == usize.ZERO, "namespace fixtures parse")
  let left = run ModuleIndex.build(&first, true)
  let right = run ModuleIndex.build(&second, true)
  let agrees = ModuleIndex.matchesNamespace(&left, &right)
  run Testing.expect(agrees == ModuleIndex.matchesNamespace(&right, &left),
    "namespace equality is symmetric")
  return agrees
}

effect fn namespaceClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | AssertionError<'static>
? &mut Allocator {
  let base = "pub fn first() -> i32 { return 1 }\nfn second() -> i32 { return 2 }\n"
  run Testing.expect(run namespaceMatches(base,
    "// moved and changed\nfn second() -> bool { return true }\npub fn first() -> i32 { return 999 }\n"),
    "body, header, trivia and source order do not change written namespace")
  run Testing.expect(!run namespaceMatches(base,
    "fn first() -> i32 { return 1 }\nfn second() -> i32 { return 2 }\n"),
    "visibility changes namespace")
  run Testing.expect(!run namespaceMatches(base,
    "pub fn third() -> i32 { return 1 }\nfn second() -> i32 { return 2 }\n"),
    "replacing a name changes namespace even at equal cardinality")
  run Testing.expect(run namespaceMatches("fn first() -> i32 { return 1 }\n",
    "fn first() -> i32 { return 1 }\nfn first() -> i32 { return 2 }\n"),
    "duplicate count belongs to a name bucket, not namespace")
  run Testing.expect(!run namespaceMatches("fn first() -> i32 { return 1 }\n",
    "fn first() -> i32 { return 1 }\npub fn first() -> i32 { return 2 }\n"),
    "both public and private membership are represented for duplicate names")
  run Testing.expect(run namespaceMatches("pub import model.User as Tree { Guest as Friend }\n",
    "pub import model.User as Tree { User as Friend }\n"),
    "changed import target with equal visible spelling belongs to the import prototype")
  let id = run module("namespace.silk")
  let initial = run Revision.publish(&Revision.make(), &id, &run present(base))
  let next = run Revision.publish(&initial, &id, &run present(
    "pub fn first() -> i32 { return 3 }\nfn second() -> i32 { return 4 }\n"))
  let removed = run Revision.publish(&next, &id, &Option<Bytes>.none())
  let restored = run Revision.publish(&removed, &id, &run present(""))
  let mut index = SourceIndex.make(move initial)
  let answer = run SourceIndex.demand(&mut index, &id)
  drop answer
  let edits = run SourceIndex.revise(&mut index, move next)
  let edited = Vector<SourceChange>.asSlice(&edits)
  run Testing.expect(edited.length == usize.ONE && !SourceIndex.namespaceChanged(&index, &edited[usize.ZERO]),
    "source publication preserves namespace on a body-only edit")
  let removals = run SourceIndex.revise(&mut index, move removed)
  let absent = Vector<SourceChange>.asSlice(&removals)
  run Testing.expect(absent.length == usize.ONE && SourceIndex.namespaceChanged(&index, &absent[usize.ZERO]),
    "source disappearance changes namespace")
  let additions = run SourceIndex.revise(&mut index, move restored)
  let presentAgain = Vector<SourceChange>.asSlice(&additions)
  run Testing.expect(presentAgain.length == usize.ONE
    && SourceIndex.namespaceChanged(&index, &presentAgain[usize.ZERO]),
    "an empty source appearing changes namespace presence")
  return ()
}

test effect fn namespaceTracksNamesAndVisibilityOnly() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run namespaceClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn implInventoryBodyAndMembershipClaims() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static>
? &mut Allocator {
  let id = run module("impls.silk")
  let before = run SourceUnit.parse(&id, usize.ONE, run Bytes.copy(b"""
impl Thing { fn member(self: Self) -> i32 { return 1 } }
impl Contract for Thing { fn apply(self: Self) -> i32 { return 2 } }
fn other() -> i32 { return 3 }
"""))
  let oldIndex = run ModuleIndex.build(&before, true)
  let bodies = run SourceUnit.parse(&id, 2, run Bytes.copy(b"""
impl Thing { fn member(self: Self) -> i32 { return 4 } }
impl Contract for Thing { fn apply(self: Self) -> i32 { return 5 } }
fn other() -> i32 { return 6 } // trailing trivia
"""))
  let bodyIndex = run ModuleIndex.build(&bodies, true)
  let bodyChanges = ModuleIndex.implInventoryChanges(&oldIndex, &before, &bodyIndex, &bodies)
  run Testing.expect(!bodyChanges.conformance && !bodyChanges.inherent,
    "member and unrelated bodies and trivia preserve both written impl inventories")
  let renamed = run SourceUnit.parse(&id, 3, run Bytes.copy(b"""
impl Thing { fn renamed(self: Self) -> i32 { return 1 } }
impl Contract for Thing { fn apply(self: Self) -> i32 { return 2 } }
fn other() -> i32 { return 3 }
"""))
  let renamedIndex = run ModuleIndex.build(&renamed, true)
  let memberChanges = ModuleIndex.implInventoryChanges(&oldIndex, &before, &renamedIndex, &renamed)
  run Testing.expect(!memberChanges.conformance && memberChanges.inherent,
    "renaming an inherent member changes only its written inventory")
  let added = run SourceUnit.parse(&id, 4, run Bytes.copy(b"""
impl Thing { fn member(self: Self) -> i32 { return 1 } }
impl Contract for Thing { fn apply(self: Self) -> i32 { return 2 } }
impl Other for Thing { fn extra(self: Self) -> i32 { return 7 } }
fn other() -> i32 { return 3 }
"""))
  let addedIndex = run ModuleIndex.build(&added, true)
  let addedChanges = ModuleIndex.implInventoryChanges(&oldIndex, &before, &addedIndex, &added)
  run Testing.expect(addedChanges.conformance && !addedChanges.inherent,
    "adding a conformance dirties its inventory without dirtying inherent members")
  return ()
}

effect fn implInventoryUncertaintyClaims() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static>
? &mut Allocator {
  let id = run module("uncertain.silk")
  let duplicated = run SourceUnit.parse(&id, usize.ONE, run Bytes.copy(b"""
impl Thing { fn member(self: Self) -> i32 { return 1 } }
impl Thing { fn member(self: Self) -> i32 { return 2 } }
"""))
  let duplicateIndex = run ModuleIndex.build(&duplicated, true)
  let ambiguous = ModuleIndex.implInventoryChanges(&duplicateIndex, &duplicated, &duplicateIndex, &duplicated)
  run Testing.expect(ambiguous.inherent, "ambiguous same-key impl identities conservatively change")
  let malformed = run SourceUnit.parse(&id, 2, run Bytes.copy(b"impl Thing { fn broken( -> i32 { return 1 } }\n"))
  let malformedIndex = run ModuleIndex.build(&malformed, true)
  let damaged = ModuleIndex.implInventoryChanges(&malformedIndex, &malformed, &malformedIndex, &malformed)
  run Testing.expect(SourceUnit.diagnosticCount(&malformed) > usize.ZERO && damaged.inherent,
    "damaged impl syntax conservatively changes its written inventory")
  let other = run module("foreign.silk")
  let foreign = run SourceUnit.parse(&other, usize.ONE, run Bytes.copy(b"impl Thing {}\n"))
  let foreignIndex = run ModuleIndex.build(&foreign, true)
  let mismatch = ModuleIndex.implInventoryChanges(&duplicateIndex, &duplicated, &foreignIndex, &foreign)
  run Testing.expect(mismatch.conformance && mismatch.inherent,
    "foreign source captures cannot compare an implementation inventory")
  return ()
}

effect fn implInventoryArmClaims() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static>
? &mut Allocator {
  let id = run module("arms.silk")
  let before = run SourceUnit.parse(&id, usize.ONE, run Bytes.copy(b"""
static if true {
  impl Thing { fn member(self: Self) -> i32 { return 1 } }
} else {}
"""))
  let oldIndex = run ModuleIndex.build(&before, true)
  let moved = run SourceUnit.parse(&id, 2, run Bytes.copy(b"""
static if true {
} else {
  impl Thing { fn member(self: Self) -> i32 { return 1 } }
}
"""))
  let movedIndex = run ModuleIndex.build(&moved, true)
  let changes = ModuleIndex.implInventoryChanges(&oldIndex, &before, &movedIndex, &moved)
  run Testing.expect(changes.inherent && !changes.conformance,
    "moving an otherwise unchanged inherent impl between static arms changes written selection ownership")
  return ()
}

effect fn implInventoryAbsentClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator {
  let id = run module("gone.silk")
  let initial = run Revision.publish(&Revision.make(), &id, &run present("impl Thing {}\n"))
  let mut index = SourceIndex.make(run Revision.copy(&initial))
  let observed = run SourceIndex.demand(&mut index, &id)
  drop observed
  let removed = run Revision.publish(&initial, &id, &Option<Bytes>.none())
  let changes = run SourceIndex.revise(&mut index, move removed)
  let listed = Vector<SourceChange>.asSlice(&changes)
  run Testing.expect(listed.length == usize.ONE, "loaded implementation module reports deletion")
  let missing = SourceIndex.implInventoryChanges(&index, &listed[usize.ZERO])
  run Testing.expect(missing.conformance && missing.inherent,
    "deleting an observed module conservatively changes both inventories")
  return ()
}

