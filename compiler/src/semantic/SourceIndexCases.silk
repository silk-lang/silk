//! Focused source tests for held revisions and syntax-only declaration indexing.

import hir.Hir {HirId, Node, OwnerKind}
import hir.Fingerprint
import semantic.RuntimeEncoding
import semantic.DeclarationId {DeclarationId}
import semantic.BodyInput {BodyInput}
import semantic.ModuleId {InvalidModulePath, ModuleId}
import semantic.ModuleIndex {ModuleIndex, NameObservation}
import semantic.SourceIndex {
  AuthoredCursor,
  EventKind,
  IndexedSource,
  NoRejection,
  RevisionMismatch,
  SourceIndex,
  SourceResult,
  SourceSlot,
}
import semantic.SourceRevision {Observation, Revision}
import semantic.SourceUnit {SourceUnit}
import silk.allocator {Allocator, OutOfMemoryError}
import silk.bytes {Bytes}
import silk.effect {Effect}
import silk.layout {Layout}
import silk.option {Option}
