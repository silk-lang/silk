//! Finite storage validity of captured-owner descriptor reborrows.
import semantic.ModuleId {InvalidModulePath}
import semantic.Query {Cycle}
import semantic.Semantic {Semantic, Request, Answer}
import semantic.SemanticCaseSupport {module, staticSemantic, hasBorrowStatus, rejection, rejectsSpan, offsetOf}
import semantic.Rejection {Rejection, RejectionCode}
import semantic.SourceIndex {RevisionMismatch, NoRejection}
import semantic.Target {Target, Id as TargetId}
import semantic.TypedBody {BorrowStatus}
import semantic.Types {TypeTable, Types}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.core.effect {Effect}
import silk.testing.testing {Testing, AssertionError}
import silk.mem.shared {Shared}
import silk.core.result {Result}
import silk.option {Option}

test effect fn capturedOwnerDescriptorFiniteProof() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut types = TypeTable.make()
  return run capturedOwnerDescriptorClaims() |> Effect.provideMut<Types>(&mut types) |> Effect.provideMut<Allocator>(&mut allocator)
}
effect fn capturedOwnerDescriptorClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("finite-Closures.silk")
  let text = """
struct Item { path: i32, other: i32 }
struct Holder { item: Item, n: i32 }
struct Pair { a: i32, b: i32 }
fn view<'a>(h: &'a Holder) -> &'a Holder { return h }
fn make() -> Holder { return Holder {item: Item {path: 1, other: 2}, n: 3} }
fn spent(h: Holder) -> i32 { return h.item.path }
pub fn main() -> i32 { return 0 }
fn U31(fb: &i32, c: bool) -> i32 { let h = make() let g = fn(x: &i32) -> i32 { let mut q = x if c { let d = &h q = &d.item.path } return q.* } let r = g(fb) let n = spent(move h) return r + n }
fn U31direct(fb: &i32, c: bool) -> i32 { let h = make() let g = fn(x: &i32) -> i32 { let mut q = x if c { q = &h.item.path } return q.* } let r = g(fb) let n = spent(move h) return r + n }
fn U31noncapture(fb: &i32, c: bool) -> i32 { let h = make() let g = fn(x: &i32) -> i32 { let mut q = x if c { let d = x q = &d.* } return q.* } let r = g(fb) let n = spent(move h) return r + n }
fn U31moved(fb: &i32, c: bool) -> i32 { let h = make() let g = fn(x: &i32) -> i32 { let mut q = x if c { let d = &h q = &d.item.path } return q.* } let n = spent(move h) let r = g(fb) return r + n }
fn U31inner(fb: &i32, c: bool) -> i32 { let h = make() let g = fn(x: &i32) -> i32 { let mut q = x if c { let inner = make() let d = &inner q = &d.item.path } return q.* } let r = g(fb) let n = spent(move h) return r + n }
"""
  let mut store = run staticSemantic(&id, text, Target.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let U31 = run Semantic.demandBody(&mut store, &mut request, &id, b"U31")
  run Testing.expect(hasBorrowStatus(&U31, BorrowStatus.Checked), "a descriptor reborrow retains its captured owner until the last scalar-returning call")
  let U31direct = run Semantic.demandBody(&mut store, &mut request, &id, b"U31direct")
  run Testing.expect(hasBorrowStatus(&U31direct, BorrowStatus.Checked), "direct owner borrowing remains checked")
  let U31noncapture = run Semantic.demandBody(&mut store, &mut request, &id, b"U31noncapture")
  run Testing.expect(hasBorrowStatus(&U31noncapture, BorrowStatus.Checked), "a noncapturing descriptor remains checked")
  let U31moved = run Semantic.demandBody(&mut store, &mut request, &id, b"U31moved")
  let movedStart = offsetOf(text, "move h) let r = g(fb)", 0) + 5
  let movedCause = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(&U31moved, rejection)
  let movedRejected = match move movedCause {
    Option<Shared<Rejection>>.Some {value} => Shared<Rejection>.with<bool>(&value, fn(r: &Rejection) -> bool {
      return r.code == RejectionCode.AccessDuringLoan && r.span.start == movedStart && r.span.end == movedStart + 1
    })
    Option<Shared<Rejection>>.None => false
  }
  run Testing.expect(movedRejected, "moving the capture before the last call still reports OWN0011 at the moved owner")
  let U31inner = run Semantic.demandBody(&mut store, &mut request, &id, b"U31inner")
  run Testing.expect(rejectsSpan(&U31inner, RejectionCode.ExpiredLifetime, text, "q.*", 4), "a truly inner owner still expires before the scalar read (OWN0019)")
  return ()
}
