//! Checked bodies keep the names they resolve only for a store that selects editor tables.

import semantic.Anchor {Anchor}
import semantic.Types {TypeTable, Types}
import semantic.ModuleId {InvalidModulePath, ModuleId}
import semantic.Query {Cycle}
import semantic.Semantic {Request, Semantic}
import semantic.SemanticCaseSupport {checkedBody, makeSemantic, module, present}
import semantic.SourceIndex {RevisionMismatch}
import semantic.SourceRevision {Revision}
import semantic.DeclarationId {DeclarationId}
import semantic.TypedBody {Referent, Resolution, TypedBody}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.core.effect {Effect}
import silk.option {Option}
import silk.core.result {Result}
import silk.mem.shared {Shared}
import silk.testing.testing {AssertionError, Testing}
import silk.text.string {String}
import silk.num.usize
import semantic.Semantic {Answer}
import semantic.SourceIndex {NoRejection}

fn source() -> string<'static> {
  return """
struct Point {x: i32, y: i32}
fn twice(value: i32) -> i32 {
  return value + value
}
fn sum(point: &Point) -> i32 {
  let total: i32 = twice(point.x)
  return total + point.y
}
"""
}

test effect fn bodiesKeepTheNamesTheyResolveForAnEditor() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run editorTableClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn editorTableClaims() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
? &mut Allocator | &mut Types {
  let id = run module("editor-tables.silk")
  let source = run present(source())
  let revision = run Revision.publish(&Revision.make(), &id, &source)
  let mut plain = makeSemantic(run Revision.copy(&revision))
  let mut request = Request.make()
  let unrecorded = run Semantic.demandBody(&mut plain, &mut request, &id, b"sum")
  if let Option<Shared<TypedBody>>.Some {value: body} = move Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(&unrecorded, checkedBody) {
    run Testing.expect(Shared<TypedBody>.with<usize>(&body, resolutionCount) == usize.ZERO,
      "a store without editor tables records no resolutions")
  } else {
    run Testing.expect(false, "the body checks without editor tables")
  }
  let mut store = makeSemantic(move revision)
  Semantic.selectEditorTables(&mut store, true)
  let mut editorRequest = Request.make()
  let answer = run Semantic.demandBody(&mut store, &mut editorRequest, &id, b"sum")
  let checked = Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(&answer, checkedBody)
  let body = match move checked {
    Option<Shared<TypedBody>>.Some {value} => move value
    Option<Shared<TypedBody>>.None => {
      run Testing.expect(false, "the body checks with editor tables")
      return ()
    }
  }
  let anchor = match move run Semantic.bodyAnchor(&mut store, &body) {
    Option<Anchor>.Some {value} => move value
    Option<Anchor>.None => {
      run Testing.expect(false, "the checked body has an anchor")
      return ()
    }
  }
  run Testing.expect(Shared<TypedBody>.with<bool>(&body, fn(checked: &TypedBody) -> bool {
    return named(checked, &anchor, at(b"twice(point"), b"twice")
  }), "the call names the function it selects")
  run Testing.expect(Shared<TypedBody>.with<bool>(&body, fn(checked: &TypedBody) -> bool {
    return field(checked, &anchor, at(b"x)"), usize.ZERO) && field(checked, &anchor, at(b"y\n}"), usize.ONE)
  }), "each field projection names its field ordinal")
  run Testing.expect(Shared<TypedBody>.with<bool>(&body, fn(checked: &TypedBody) -> bool {
    return local(checked, &anchor, at(b"point.x"), usize.ZERO) && local(checked, &anchor, at(b"total +"), usize.ONE)
  }), "each local use names its binding")
  run Testing.expect(Shared<TypedBody>.with<bool>(&body, fn(checked: &TypedBody) -> bool {
    return written(checked, &anchor, at(b"i32 = twice"))
  }), "a written annotation names its type")
  return ()
}

fn resolutionCount(body: &TypedBody) -> usize {
  return TypedBody.resolutionSlice(body).length
}

// The offset of the first occurrence of `needle` in the source.
fn at(needle: &[u8]) -> usize {
  let text = String.utf8Bytes(source())
  let mut start = usize.ZERO
  while start + needle.length <= text.length {
    let mut same = true
    let mut offset = usize.ZERO
    while offset < needle.length && same {
      same = text[start + offset] == needle[offset]
      offset = offset + usize.ONE
    }
    if same { return start }
    start = start + usize.ONE
  }
  return usize.MAX
}

fn startsAt(resolution: &Resolution, anchor: &Anchor, offset: usize) -> bool {
  let span = Anchor.span(anchor, resolution.origin.location)
  return span.start == offset
}

fn named(body: &TypedBody, anchor: &Anchor, offset: usize, name: &[u8]) -> bool {
  let list = TypedBody.resolutionSlice(body)
  let mut at = usize.ZERO
  while at < list.length {
    if startsAt(&list[at], anchor, offset) {
      if let Referent.Declaration {declaration} = &list[at].referent {
        if Shared<DeclarationId>.with<bool>(&declaration, fn(identity: &DeclarationId) -> bool { return DeclarationId.named(identity, name) }) {
          return true
        }
      }
    }
    at = at + usize.ONE
  }
  return false
}

fn field(body: &TypedBody, anchor: &Anchor, offset: usize, ordinal: usize) -> bool {
  let list = TypedBody.resolutionSlice(body)
  let mut at = usize.ZERO
  while at < list.length {
    if startsAt(&list[at], anchor, offset) {
      if let Referent.Field {index, ..} = &list[at].referent {
        if index == ordinal { return true }
      }
    }
    at = at + usize.ONE
  }
  return false
}

fn local(body: &TypedBody, anchor: &Anchor, offset: usize, ordinal: usize) -> bool {
  let list = TypedBody.resolutionSlice(body)
  let mut at = usize.ZERO
  while at < list.length {
    if startsAt(&list[at], anchor, offset) {
      if let Referent.Local {local} = &list[at].referent {
        if local.index == ordinal { return true }
      }
    }
    at = at + usize.ONE
  }
  return false
}

fn written(body: &TypedBody, anchor: &Anchor, offset: usize) -> bool {
  let list = TypedBody.resolutionSlice(body)
  let mut at = usize.ZERO
  while at < list.length {
    if startsAt(&list[at], anchor, offset) {
      if let Referent.Type {..} = &list[at].referent { return true }
    }
    at = at + usize.ONE
  }
  return false
}
