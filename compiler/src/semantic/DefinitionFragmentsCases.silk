//! Worker definition packets preserve assembly identities without exporting local semantic handles.
import backend.EmissionPlan {EmissionPlan, Replayed, Identity}
import backend.InstanceText {InstanceText}
import backend.LlvmCode {Declaration}
import hir.Hir {OwnerKind}
import semantic.DeclarationId {DeclarationId, OwnerStep}
import semantic.DefinitionFragments {Entry}
import semantic.DefinitionFragments
import semantic.ModuleId {ModuleId, InvalidModulePath}
import semantic.TypedBody {BorrowStatus}
import silk.collections.bytes {Bytes}
import silk.collections.list {List}
import silk.collections.slice {Slice}
import silk.core.effect {Effect}
import silk.core.option {Option}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.num.usize
import silk.testing.testing {AssertionError, Testing}

test effect fn portableDefinitionsPreserveAssemblyIdentityAndRejectConflicts() -> ()
! OutOfMemoryError | InvalidModulePath | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run claims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn identity() -> Replayed ! OutOfMemoryError | InvalidModulePath ? &mut Allocator {
  let module = run ModuleId.make(b"workspace", b"packet", b"main")
  let mut owners = List<OwnerStep>.make()
  run List<OwnerStep>.append(&mut owners, OwnerStep {kind: OwnerKind.Function,
    name: Option<Bytes>.some(run Bytes.copy(b"main")), occurrence: usize.ZERO})
  return Replayed {exact: run Bytes.copy(b"0123456789abcdef"), hash: 42,
    declaration: run DeclarationId.fromParts(move module, move owners), family: 0}
}

effect fn definition(text: &[u8], encoding: &[u8], symbol: &[u8]) -> InstanceText
! OutOfMemoryError ? &mut Allocator {
  let mut foreign = List<Declaration>.make()
  run List<Declaration>.append(&mut foreign, Declaration {symbol: run Bytes.copy(b"puts"),
    contract: run Bytes.copy(b"contract"), text: run Bytes.copy(b"declaration")})
  return InstanceText {encoding: run Bytes.copy(encoding), symbol: run Bytes.copy(symbol), text: run Bytes.copy(text),
    foreign: move foreign, borrow: BorrowStatus.Checked}
}

effect fn claims() -> () ! OutOfMemoryError | InvalidModulePath | AssertionError<'static> ? &mut Allocator {
  let named = run identity()
  let body = run definition(b"fragment", b"abcdefghijklmnop", b"silk.function")
  let mut packet = run DefinitionFragments.begin(b"context", 2)
  run DefinitionFragments.append(&mut packet, &named, &body, Bytes.asSlice(&body.text))
  run DefinitionFragments.append(&mut packet, &named, &body, Bytes.asSlice(&body.text))
  let decoded = run DefinitionFragments.read(Bytes.asSlice(&packet), b"context")
  let entries = match &decoded {
    Option<List<Entry>>.Some {value} => List<Entry>.asSlice(&value)
    Option<List<Entry>>.None => { run Testing.expect(false, "valid packet was refused")
      return () }
  }
  run Testing.expect(entries.length == 2, "exact aliases survive transport")
  run Testing.expect(DeclarationId.equals(&named.declaration, &entries[0].identity.declaration), "stable declaration survives transport")
  run Testing.expect(entries[0].identity.hash == 42 && entries[0].identity.family == 0, "replayed lookup metadata survives transport")
  let mut plan = EmissionPlan.empty()
  let mut at = usize.ZERO
  while at < entries.length {
    let item = &entries[at]
    run EmissionPlan.includeReplayed(&mut plan, &item.identity, Bytes.asSlice(&item.definition.encoding),
      Bytes.asSlice(&item.definition.symbol), item.definition.borrow)
    at = at + usize.ONE
  }
  run Testing.expect(List<Identity>.length(&plan.identities) == usize.ONE,
    "assembly deduplicates aliases without an InstanceKey")
  run Testing.expect(!EmissionPlan.hasSymbolConflict(&plan), "valid imported symbols do not conflict")
  let wrong = run DefinitionFragments.read(Bytes.asSlice(&packet), b"other context")
  run Testing.expect(missing(&wrong), "worker packets cannot cross build contexts")
  let truncated = run DefinitionFragments.read(Slice.view<u8>(Bytes.asSlice(&packet), usize.ZERO, Bytes.length(&packet) - usize.ONE), b"context")
  run Testing.expect(missing(&truncated), "truncated packets are refused atomically")
  run Bytes.append(&mut packet, b"trailing")
  let trailing = run DefinitionFragments.read(Bytes.asSlice(&packet), b"context")
  run Testing.expect(missing(&trailing), "extra bytes are refused")
  let changed = run definition(b"different fragment", b"abcdefghijklmnop", b"silk.function")
  let mut conflict = run DefinitionFragments.begin(b"context", 2)
  run DefinitionFragments.append(&mut conflict, &named, &body, Bytes.asSlice(&body.text))
  run DefinitionFragments.append(&mut conflict, &named, &changed, Bytes.asSlice(&changed.text))
  let result = run DefinitionFragments.read(Bytes.asSlice(&conflict), b"context")
  run Testing.expect(missing(&result), "same-identity different bodies cannot silently select a worker")
  let alias = run definition(b"fragment", b"ponmlkjihgfedcba", b"silk.function")
  let mut collision = run DefinitionFragments.begin(b"context", 2)
  run DefinitionFragments.append(&mut collision, &named, &body, Bytes.asSlice(&body.text))
  run DefinitionFragments.append(&mut collision, &named, &alias, Bytes.asSlice(&alias.text))
  let collided = run DefinitionFragments.read(Bytes.asSlice(&collision), b"context")
  run Testing.expect(missing(&collided), "different canonical identities cannot share a symbol")
  return ()
}

fn missing(value: &Option<List<Entry>>) -> bool {
  return match &value.* {
    Option<List<Entry>>.Some {..} => false
    Option<List<Entry>>.None => true
  }
}
