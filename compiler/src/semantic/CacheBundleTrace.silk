//! Opt-in coarse diagnostics for the immutable bundle experiment. No cache decisions depend on it.
import semantic.FrontierHost {FrontierHost}
import silk.platform.native.clock {NativeClock}
import silk.system.system_clock {SystemClock}
import silk.mem.pointer {Pointer}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.collections.bytes {Bytes}
import silk.num.i64
import silk.num.u64
import silk.num.usize

pub fn enabled() -> bool {
  return !Pointer.isNullMany<u8>(unsafe FrontierHost.environment(Pointer.fromSlice<u8>(b"SILK_CACHE_BUNDLE_TRACE\0")))
    || !Pointer.isNullMany<u8>(unsafe FrontierHost.environment(Pointer.fromSlice<u8>(b"SILK_CACHE_BUNDLE_TRACE_FILE\0")))
}
effect fn now() -> u64 {
  let instant = run NativeClock.now(true)
  return i64.toU64(SystemClock.seconds(&instant)) * 1000000000 + i64.toU64(SystemClock.nanoseconds(&instant))
}
pub effect fn start() -> u64 { return if enabled() { run now() } else { 0 } }
pub effect fn elapsed(start: u64) -> u64 { return if start == 0 { 0 } else { (run now()) - start } }
effect fn decimal(output: &mut Bytes, value: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  if value >= 10 { run decimal(&mut output.*, value / 10) }
  return run Bytes.append(&mut output.*, &[usize.toU8(value % 10) + 48])
}
pub effect fn report(label: &[u8], duration: u64, first: usize, second: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  if !enabled() { return () }
  let mut message = run Bytes.copy(b"frontier bundle ")
  run Bytes.append(&mut message, label)
  run Bytes.append(&mut message, b" ms=")
  run decimal(&mut message, u64.toUsize(duration / 1000000))
  run Bytes.append(&mut message, b" a=")
  run decimal(&mut message, first)
  run Bytes.append(&mut message, b" b=")
  run decimal(&mut message, second)
  run Bytes.append(&mut message, b"\n")
  let bytes = Bytes.asSlice(&message)
  let path = unsafe FrontierHost.environment(Pointer.fromSlice<u8>(b"SILK_CACHE_BUNDLE_TRACE_FILE\0"))
  if !Pointer.isNullMany<u8>(path) {
    let stream = unsafe FrontierHost.openFile(path, Pointer.fromSlice<u8>(b"ab\0"))
    if !Pointer.isNull<u8>(stream) {
      drop unsafe FrontierHost.write(unsafe FrontierHost.descriptor(stream), Pointer.fromSlice<u8>(bytes), bytes.length)
      drop unsafe FrontierHost.closeFile(stream)
      return ()
    }
  }
  drop unsafe FrontierHost.write(2, Pointer.fromSlice<u8>(bytes), bytes.length)
}
pub effect fn finish(label: &[u8], start: u64, first: usize, second: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  if start != 0 { run report(label, run elapsed(start), first, second) }
}
