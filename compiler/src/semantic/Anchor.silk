//! Where one declaration starts, so that positions inside it can be kept relative to it.
//!
//! # When to use
//! Use an [`Anchor`] to store a node or byte position of a declaration in a result that may
//! outlive an edit elsewhere in the same file, such as a typed body or its MIR, and to read it
//! back against the current source (incremental v2 §3.5).
//!
//! # Details
//! A declaration's HIR nodes, nested declarations included, occupy one contiguous arena range that
//! ends at the declaration node, and its bytes start at its first significant token. Inserting or
//! removing text above the declaration moves both starts and nothing else, so positions counted
//! from them stay equal. An anonymous literal is analyzed inside its enclosing declaration and
//! uses that declaration's anchor.
//!
//! # Gotchas
//! A position outside the anchored declaration has no relative form; converting one traps.
//! Diagnostics keep absolute spans: a result that carries one depends on the declaration's location.

import hir.Hir {HirId, Module}
import lexer.Span {Span}
import silk.option {Option}
import silk.ownership {Copy}

/// The first node and first byte of one declaration in its current source.
pub struct Anchor {
  /// The first node of the declaration's arena range.
  pub first: HirId
  /// The declaration's first significant byte.
  pub start: usize
}

impl Copy for Anchor {}

impl Anchor {
  /// The anchor of `declaration`, a declaration node of `module`; absent for any other node.
  pub fn of(module: &Module, declaration: HirId) -> Option<Anchor> {
    if let Option<HirId>.Some {value: first} = move Module.declarationStart(module, declaration) {
      return Option<Anchor>.some(Anchor {first: first, start: Module.span(module, declaration).start})
    }
    return Option<Anchor>.none()
  }

  /// The position of node `syntax` counted from the declaration's first node.
  pub fn node(self: Self, syntax: HirId) -> usize {
    return syntax.index - self.first.index
  }

  /// `span` counted from the declaration's first byte.
  pub fn relativeSpan(self: Self, span: Span) -> Span {
    return Span.make(span.start - self.start, span.end - self.start)
  }

  /// The current node at relative position `node`.
  pub fn hir(self: Self, node: usize) -> HirId {
    return HirId {index: self.first.index + node}
  }

  /// The current byte span of `span`, counted from the declaration's first byte.
  pub fn absoluteSpan(self: Self, span: Span) -> Span {
    return Span.make(self.start + span.start, self.start + span.end)
  }
}
