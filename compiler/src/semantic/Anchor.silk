//! Declaration-relative HIR identities and current token-location projection.
//!
//! An anchor owns a shared reference to the exact source revision's significant-token table.
//! Retained typed bodies and MIR keep token-boundary coordinates, so trivia inserted inside a
//! declaration changes only the current projection. Anonymous literals use their enclosing
//! named declaration's anchor (incremental v2 §3.5).

import hir.Hir {HirId, Module}
import lexer.Span {Span}
import silk.option {Option}
import semantic.SourceLocations {Location, SourceLocations}
import silk.mem.shared {Shared}

/// The first node and significant token of one declaration in its current source.
pub struct Anchor {
  /// The first node of the declaration's arena range.
  pub first: HirId,
  /// The declaration's first significant token.
  pub token: usize,
  locations: Shared<SourceLocations>,
}

impl Anchor {
  /// The anchor of `declaration`, a declaration node of `module`; absent for any other node.
  pub fn of(module: &Module, locations: &Shared<SourceLocations>, declaration: HirId) -> Option<
    Anchor,
  > {
    if let Option<HirId>.Some {value: first} = move Module.declarationStart(module, declaration) {
      let start = Module.span(module, declaration).start
      let token = Shared<SourceLocations>.with<usize>(
        locations,
        fn(value: &SourceLocations) -> usize {
          return SourceLocations.boundary(value, start, false) / 2
        },
      )
      return Option<Anchor>.some(
        Anchor {first: first, token: token, locations: Shared<SourceLocations>.clone(locations)},
      )
    }
    return Option<Anchor>.none()
  }
  /// The position of node `syntax` counted from the declaration's first node.
  pub fn node(self: &Self, syntax: HirId) -> usize {
    return syntax.index - self.first.index
  }
  /// Captures token boundaries relative to this declaration's first significant token.
  pub fn location(self: &Self, span: Span) -> Location {
    return Shared<SourceLocations>.with<Location>(
      &self.locations,
      fn(value: &SourceLocations) -> Location {
        return Location.make(
          SourceLocations.boundary(value, span.start, false) - self.token * 2,
          SourceLocations.boundary(value, span.end, span.end != span.start) - self.token * 2,
        )
      },
    )
  }
  /// The current node at relative position `node`.
  pub fn hir(self: &Self, node: usize) -> HirId {
    return HirId {index: self.first.index + node}
  }
  /// Projects retained token boundaries through this source revision's current locations.
  pub fn span(self: &Self, location: Location) -> Span {
    return Shared<SourceLocations>.with<Span>(
      &self.locations,
      fn(value: &SourceLocations) -> Span {
        return Span.make(
          SourceLocations.byte(value, self.token * 2 + location.start),
          SourceLocations.byte(value, self.token * 2 + location.end),
        )
      },
    )
  }
  /// Recovery diagnostics may not be token aligned. They need a raw-position observation.
  pub fn findLocation(self: &Self, span: Span) -> Option<Location> {
    return Shared<SourceLocations>.with<Option<Location>>(&self.locations, fn(value: &SourceLocations) -> Option<Location> {
      let start = SourceLocations.findBoundary(value, span.start, false)
      let end = SourceLocations.findBoundary(value, span.end, span.end != span.start)
      if let Option<usize>.Some {value: first} = move start {
        if let Option<usize>.Some {value: last} = move end {
          if first >= self.token * 2 && last >= self.token * 2 {
            return Option<Location>.some(Location.make(first - self.token * 2, last - self.token * 2))
          }
        }
      }
      return Option<Location>.none()
    })
  }
  pub fn retainedSpan(self: &Self, location: Location) -> Option<Span> {
    return Shared<SourceLocations>.with<Option<Span>>(&self.locations, fn(value: &SourceLocations) -> Option<Span> {
      let start = self.token * 2 + location.start
      let end = self.token * 2 + location.end
      if SourceLocations.hasBoundary(value, start) && SourceLocations.hasBoundary(value, end) {
        return Option<Span>.some(Span.make(SourceLocations.byte(value, start), SourceLocations.byte(value, end)))
      }
      return Option<Span>.none()
    })
  }
  pub fn copy(self: &Self) -> Self {
    return Anchor {
      first: self.first,
      token: self.token,
      locations: Shared<SourceLocations>.clone(&self.locations),
    }
  }
}
