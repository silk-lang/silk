//! Deterministic resource accounting for a completed graph of code definitions.
//!
//! Exact definitions are charged once. Repeated MIR variants contribute the maximum observed
//! reference count and retained runtime-key length, so traversal and worker order cannot change
//! whether a completed graph fits. Exhaustion means the graph was not proved within resources;
//! it is never evidence that the graph is infinite.

import semantic.ContentHash {ContentHash}
import semantic.DeclarationId {DeclarationId, OwnerStep}
import semantic.InternIndex {InternIndex}
import semantic.ModuleId {InvalidModulePath, ModuleId}
import silk.collections.hash {Hash}
import silk.collections.list {List}
import silk.core.option {Option}
import silk.core.ownership {Copy}
import silk.core.result {Result}
import silk.mem.layout {Layout}
import silk.mem.pointer {Pointer}
import silk.core.effect {Effect}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.testing.testing {AssertionError, Testing}
import silk.num.usize

pub const definitionsLimit: usize = 250000
pub const bodyDefinitionsLimit: usize = 4096
pub const referencesLimit: usize = 4000000
pub const runtimeBytesLimit: usize = 536870912

/// Command resource policy, independent of already charged definitions or checkpoints.
pub struct Limits {
  pub definitions: usize,
  pub perBody: usize,
  pub references: usize,
  pub runtimeBytes: usize,
}
impl Copy for Limits {}
impl Limits {
  pub fn make() -> Self {
    return Self {definitions: definitionsLimit, perBody: bodyDefinitionsLimit,
      references: referencesLimit, runtimeBytes: runtimeBytesLimit}
  }
}

struct Definition {
  key: ContentHash,
  body: usize,
  bytes: usize,
  references: usize,
}

// Only maxima changed on existing definitions need an undo entry. Newly appended definitions
// and bodies are removed by their saved lengths when a speculative walk is abandoned.
struct Update {definition: usize, bytes: usize, references: usize}

/// A nested speculative accounting boundary. Commit only a replay that proves the current graph.
pub struct Checkpoint {
  definitions: usize, bodies: usize, updates: usize, references: usize, bytes: usize,
  failed: bool, failure: usize, depth: usize,
}

pub struct Budget {
  definitions: List<Definition>,
  definitionLookup: InternIndex,
  bodies: List<DeclarationId>,
  bodyLookup: InternIndex,
  bodyCounts: List<usize>,
  references: usize,
  bytes: usize,
  maxDefinitions: usize,
  maxBodyDefinitions: usize,
  maxReferences: usize,
  maxBytes: usize,
  failed: bool,
  failure: usize,
  updates: List<Update>,
  depth: usize,
}

impl Budget {
  /// Copies policy only; workers must account their own observations and retain global proof.
  pub fn limits(self: &Self) -> Limits {
    return Limits {definitions: self.maxDefinitions, perBody: self.maxBodyDefinitions,
      references: self.maxReferences, runtimeBytes: self.maxBytes}
  }
  pub fn make() -> Self {
    return Budget.withLimits(definitionsLimit, bodyDefinitionsLimit, referencesLimit, runtimeBytesLimit)
  }
  /// Explicit bounds for isolated checks and inexpensive exhaustion tests.
  pub fn withLimits(definitions: usize, perBody: usize, references: usize, runtimeBytes: usize) -> Self {
    return Budget {definitions: List<Definition>.make(), definitionLookup: InternIndex.make(),
      bodies: List<DeclarationId>.make(), bodyLookup: InternIndex.make(), bodyCounts: List<usize>.make(),
      references: usize.ZERO, bytes: usize.ZERO, maxDefinitions: definitions, maxBodyDefinitions: perBody,
      maxReferences: references, maxBytes: runtimeBytes, failed: false, failure: usize.ZERO, updates: List<Update>.make(), depth: usize.ZERO}
  }
  /// Starts a new command/revision while preserving the configured resource policy.
  pub fn clear(self: &mut Self) -> () {
    let fresh = Budget.withLimits(self.maxDefinitions, self.maxBodyDefinitions, self.maxReferences, self.maxBytes)
    self.* = move fresh
  }
  /// Begins accounting that may be discarded without copying the already accepted graph.
  pub fn checkpoint(self: &mut Self) -> Checkpoint {
    let saved = Checkpoint {definitions: List<Definition>.length(&self.definitions), bodies: List<DeclarationId>.length(&self.bodies),
      updates: List<Update>.length(&self.updates), references: self.references, bytes: self.bytes,
      failed: self.failed, failure: self.failure, depth: self.depth}
    self.depth = self.depth + usize.ONE
    return move saved
  }
  /// Keeps the observations of a completed replay. An outer transaction can still undo them.
  pub fn commit(self: &mut Self, saved: Checkpoint) -> () {
    self.depth = saved.depth
    if self.depth == usize.ZERO { List<Update>.clear(&mut self.updates) }
  }
  /// Discards observations of an unproved replay so the live walk retains its own refusal site.
  pub fn rollback(self: &mut Self, saved: Checkpoint) -> () {
    while List<Update>.length(&self.updates) > saved.updates {
      let last = List<Update>.length(&self.updates) - usize.ONE
      let update = List<Update>.remove(&mut self.updates, last)
      let entries = List<Definition>.asMutSlice(&mut self.definitions)
      entries[update.definition].bytes = update.bytes
      entries[update.definition].references = update.references
    }
    let rebuildDefinitions = List<Definition>.length(&self.definitions) != saved.definitions
    let rebuildBodies = List<DeclarationId>.length(&self.bodies) != saved.bodies
    while List<Definition>.length(&self.definitions) > saved.definitions {
      let last = List<Definition>.length(&self.definitions) - usize.ONE
      let removed = List<Definition>.remove(&mut self.definitions, last)
      if removed.body != usize.MAX {
        let count = List<usize>.get(&self.bodyCounts, removed.body)
        List<usize>.set(&mut self.bodyCounts, removed.body, count - usize.ONE)
      }
    }
    List<DeclarationId>.truncate(&mut self.bodies, saved.bodies)
    List<usize>.truncate(&mut self.bodyCounts, saved.bodies)
    self.references = saved.references
    self.bytes = saved.bytes
    self.failed = saved.failed
    self.failure = saved.failure
    self.depth = saved.depth
    // A successful replay never relinks indexes; abandoned extensions reuse their existing storage.
    if rebuildDefinitions { InternIndex.truncate(&mut self.definitionLookup, saved.definitions) }
    if rebuildBodies { InternIndex.truncate(&mut self.bodyLookup, saved.bodies) }
  }

  fn refuse(self: &mut Self, resource: usize) -> bool {
    if !self.failed { self.failure = resource }
    self.failed = true
    return false
  }
  pub fn failureResource(self: &Self) -> &'static [u8] {
    return match self.failure {
      1 => b"command definitions"
      2 => b"definitions of one original body"
      3 => b"MIR reference slots"
      4 => b"retained runtime-key bytes"
      5 => b"consistent definition metadata"
      _ => b"none"
    }
  }
  pub fn failureLimit(self: &Self) -> usize {
    return match self.failure {
      1 => self.maxDefinitions
      2 => self.maxBodyDefinitions
      3 => self.maxReferences
      4 => self.maxBytes
      _ => usize.ZERO
    }
  }
  pub fn exhausted(self: &Self) -> bool { return self.failed }
  pub fn definitionCount(self: &Self) -> usize { return List<Definition>.length(&self.definitions) }
  pub fn referenceCount(self: &Self) -> usize { return self.references }
  pub fn runtimeBytes(self: &Self) -> usize { return self.bytes }

  /// Charges a complete provider-sensitive code definition. `body` is its exact original
  /// function declaration; glue, export and generated helper definitions have none.
  /// A before-lowering call may give zero references; completed MIR updates the same entry.
  pub effect fn include(self: &mut Self, definition: ContentHash, body: Option<&DeclarationId>, runtimeBytes: usize,
    referenceCount: usize) -> bool ! OutOfMemoryError ? &mut Allocator {
    if self.failed { return false }
    let hash = Hash.combine(definition.high, definition.low)
    let mut known = InternIndex.first(&self.definitionLookup, hash)
    let listed = List<Definition>.asSlice(&self.definitions)
    while known != usize.MAX && !ContentHash.equals(listed[known].key, definition) {
      known = InternIndex.after(&self.definitionLookup, known)
    }
    if known != usize.MAX {
      let previous = &listed[known]
      let sameBody = match &body {
        Option<&DeclarationId>.Some {value} => previous.body != usize.MAX
          && DeclarationId.equals(&List<DeclarationId>.asSlice(&self.bodies)[previous.body], value)
        Option<&DeclarationId>.None => previous.body == usize.MAX
      }
      if !sameBody { return Budget.refuse(&mut self.*, 5) }
      let extraBytes = if runtimeBytes > previous.bytes { runtimeBytes - previous.bytes } else { usize.ZERO }
      let extraReferences = if referenceCount > previous.references { referenceCount - previous.references } else { usize.ZERO }
      if extraBytes > self.maxBytes - self.bytes { return Budget.refuse(&mut self.*, 4) }
      if extraReferences > self.maxReferences - self.references { return Budget.refuse(&mut self.*, 3) }
      if self.depth != usize.ZERO && (extraBytes != usize.ZERO || extraReferences != usize.ZERO) {
        run List<Update>.append(&mut self.updates, Update {definition: known, bytes: previous.bytes, references: previous.references})
      }
      self.bytes = self.bytes + extraBytes
      self.references = self.references + extraReferences
      let entries = List<Definition>.asMutSlice(&mut self.definitions)
      if runtimeBytes > entries[known].bytes { entries[known].bytes = runtimeBytes }
      if referenceCount > entries[known].references { entries[known].references = referenceCount }
      return true
    }
    if listed.length >= self.maxDefinitions { return Budget.refuse(&mut self.*, 1) }
    if runtimeBytes > self.maxBytes - self.bytes { return Budget.refuse(&mut self.*, 4) }
    if referenceCount > self.maxReferences - self.references { return Budget.refuse(&mut self.*, 3) }
    let mut selectedBody = usize.MAX
    if let Option<&DeclarationId>.Some {value} = &body {
      let declared = List<DeclarationId>.asSlice(&self.bodies)
      selectedBody = InternIndex.first(&self.bodyLookup, DeclarationId.hash(value))
      while selectedBody != usize.MAX && !DeclarationId.equals(&declared[selectedBody], value) {
        selectedBody = InternIndex.after(&self.bodyLookup, selectedBody)
      }
      if self.maxBodyDefinitions == usize.ZERO
        || (selectedBody != usize.MAX && List<usize>.get(&self.bodyCounts, selectedBody) >= self.maxBodyDefinitions) {
        return Budget.refuse(&mut self.*, 2)
      }
    }
    run List<Definition>.reserve(&mut self.definitions, usize.ONE)
    run InternIndex.reserveNext(&mut self.definitionLookup)
    if let Option<&DeclarationId>.Some {value} = &body {
      if selectedBody == usize.MAX {
        run List<DeclarationId>.reserve(&mut self.bodies, usize.ONE)
        run List<usize>.reserve(&mut self.bodyCounts, usize.ONE)
        run InternIndex.reserveNext(&mut self.bodyLookup)
      }
      // All allocations completed before any body count or ordinal is published.
      if selectedBody == usize.MAX {
        selectedBody = List<DeclarationId>.length(&self.bodies)
        run List<DeclarationId>.append(&mut self.bodies, DeclarationId.copy(value))
        run List<usize>.append(&mut self.bodyCounts, usize.ZERO)
        run InternIndex.record(&mut self.bodyLookup, DeclarationId.hash(value))
      }
      let count = List<usize>.get(&self.bodyCounts, selectedBody)
      List<usize>.set(&mut self.bodyCounts, selectedBody, count + usize.ONE)
    }
    run List<Definition>.append(&mut self.definitions, Definition {key: definition, body: selectedBody, bytes: runtimeBytes,
      references: referenceCount})
    run InternIndex.record(&mut self.definitionLookup, hash)
    self.bytes = self.bytes + runtimeBytes
    self.references = self.references + referenceCount
    return true
  }
}

fn exampleKey(value: u64) -> ContentHash { return ContentHash {high: 0, low: value} }

effect fn budgetClaims() -> () ! InvalidModulePath | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let body = run DeclarationId.fromParts(run ModuleId.make(b"memory", b"finite", b"first"), List<OwnerStep>.make())
  let sameBody = run DeclarationId.fromParts(run ModuleId.make(b"memory", b"finite", b"first"), List<OwnerStep>.make())
  let otherBody = run DeclarationId.fromParts(run ModuleId.make(b"memory", b"finite", b"second"), List<OwnerStep>.make())
  let mut forward = Budget.withLimits(4, 2, 10, 100)
  let mut reverse = Budget.withLimits(4, 2, 10, 100)
  run Testing.expect(run Budget.include(&mut forward, exampleKey(1), Option<&DeclarationId>.some(&body), 20, 2), "first observation charges one definition")
  run Testing.expect(run Budget.include(&mut forward, exampleKey(1), Option<&DeclarationId>.some(&sameBody), 40, 5), "a repeated variant updates only maxima under exact body equality")
  run Testing.expect(run Budget.include(&mut reverse, exampleKey(1), Option<&DeclarationId>.some(&sameBody), 40, 5), "the larger observation may arrive first")
  run Testing.expect(run Budget.include(&mut reverse, exampleKey(1), Option<&DeclarationId>.some(&body), 20, 2), "smaller repeated observations do not charge twice")
  run Testing.expect(Budget.definitionCount(&forward) == 1 && Budget.referenceCount(&forward) == Budget.referenceCount(&reverse)
    && Budget.runtimeBytes(&forward) == Budget.runtimeBytes(&reverse), "complete graph cost does not depend on variant or worker order")
  run Testing.expect(run Budget.include(&mut forward, exampleKey(2), Option<&DeclarationId>.some(&body), 10, 1), "the second distinct definition of a body fits")
  run Testing.expect(!run Budget.include(&mut forward, exampleKey(3), Option<&DeclarationId>.some(&sameBody), 10, 1), "per-body limits count exact unique definitions across independently decoded declaration identities")
  run Testing.expect(Budget.exhausted(&forward) && Budget.failureLimit(&forward) == 2,
    "exhaustion retains the specific configured per-body bound")
  Budget.clear(&mut forward)
  run Testing.expect(!Budget.exhausted(&forward) && Budget.definitionCount(&forward) == 0 && Budget.failureLimit(&forward) == 0,
    "a revision reset clears charged definitions and the earlier refusal")
  run Testing.expect(run Budget.include(&mut forward, exampleKey(1), Option<&DeclarationId>.some(&body), 1, 1), "the reset accepts its first definition")
  run Testing.expect(run Budget.include(&mut forward, exampleKey(2), Option<&DeclarationId>.some(&body), 1, 1), "the reset accepts its second definition")
  run Testing.expect(!run Budget.include(&mut forward, exampleKey(3), Option<&DeclarationId>.some(&body), 1, 1), "a revision reset preserves the configured per-body limit")
  let mut distinct = Budget.withLimits(3, 1, 10, 100)
  run Testing.expect(run Budget.include(&mut distinct, exampleKey(1), Option<&DeclarationId>.some(&body), 1, 1), "first body fits")
  run Testing.expect(run Budget.include(&mut distinct, exampleKey(2), Option<&DeclarationId>.some(&otherBody), 1, 1), "a different original body has its own allowance")
  run Testing.expect(run Budget.include(&mut distinct, exampleKey(3), Option<&DeclarationId>.none(), 1, 1), "glue counts toward the aggregate without inventing a function body")
  run Testing.expect(!run Budget.include(&mut distinct, exampleKey(4), Option<&DeclarationId>.none(), 1, 1), "aggregate definition count bounds functions and glue together")
  let mut edges = Budget.withLimits(2, 2, 3, usize.MAX)
  run Testing.expect(run Budget.include(&mut edges, exampleKey(1), Option<&DeclarationId>.none(), usize.MAX, 2), "exact maximum byte accounting does not overflow")
  run Testing.expect(!run Budget.include(&mut edges, exampleKey(2), Option<&DeclarationId>.none(), 1, 1), "adding bytes beyond MAX is refused before arithmetic overflow")
  let mut calls = Budget.withLimits(2, 2, 3, 100)
  run Testing.expect(run Budget.include(&mut calls, exampleKey(1), Option<&DeclarationId>.none(), 1, 2), "initial reference cost fits")
  run Testing.expect(!run Budget.include(&mut calls, exampleKey(1), Option<&DeclarationId>.none(), 1, 4), "a larger MIR variant can exhaust the aggregate reference budget")
  let mut speculative = Budget.withLimits(3, 2, 20, 100)
  run Testing.expect(run Budget.include(&mut speculative, exampleKey(1), Option<&DeclarationId>.some(&body), 10, 2), "an accepted graph precedes the replay")
  let outer = Budget.checkpoint(&mut speculative)
  run Testing.expect(run Budget.include(&mut speculative, exampleKey(1), Option<&DeclarationId>.some(&body), 30, 5), "replay can observe larger maxima")
  let inner = Budget.checkpoint(&mut speculative)
  run Testing.expect(run Budget.include(&mut speculative, exampleKey(2), Option<&DeclarationId>.some(&otherBody), 20, 3), "nested replay adds another body")
  Budget.commit(&mut speculative, move inner)
  run Testing.expect(!run Budget.include(&mut speculative, exampleKey(3), Option<&DeclarationId>.none(), 60, 1), "speculative graph can exhaust bytes")
  Budget.rollback(&mut speculative, move outer)
  run Testing.expect(!Budget.exhausted(&speculative) && Budget.definitionCount(&speculative) == 1
    && Budget.runtimeBytes(&speculative) == 10 && Budget.referenceCount(&speculative) == 2,
    "outer rollback restores existing maxima and removes committed inner additions and exhaustion")
  run Testing.expect(run Budget.include(&mut speculative, exampleKey(2), Option<&DeclarationId>.some(&body), 10, 2), "rolled-back body counts and lookup chains admit the actual graph")
  let accepted = Budget.checkpoint(&mut speculative)
  run Testing.expect(run Budget.include(&mut speculative, exampleKey(2), Option<&DeclarationId>.some(&body), 20, 4), "successful replay updates maxima")
  Budget.commit(&mut speculative, move accepted)
  run Testing.expect(Budget.runtimeBytes(&speculative) == 30 && Budget.referenceCount(&speculative) == 6, "committing a replay retains its exact resource contribution")

}

test effect fn frontierFiniteBudgetsAreExactAndIndependentOfOrder() -> () ! InvalidModulePath | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run budgetClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

struct BudgetFaultAllocator {target: usize, attempts: usize}
impl BudgetFaultAllocator {
  effect fn allocate(self: &mut Self, layout: Layout) -> Intrinsic.Allocation ! OutOfMemoryError {
    self.attempts = self.attempts + usize.ONE
    if self.attempts == self.target { fail OutOfMemoryError {} }
    let mut system = Allocator.systemAllocatorProvider()
    return run Allocator.allocate(move layout) |> Effect.provideMut<Allocator>(&mut system)
  }
}
impl Allocator for BudgetFaultAllocator {
  allocate: BudgetFaultAllocator.allocate
  effect fn allocateZeroed(self: &mut Self, layout: Layout) -> Intrinsic.Allocation ! OutOfMemoryError {
    self.attempts = self.attempts + usize.ONE
    if self.attempts == self.target { fail OutOfMemoryError {} }
    let mut system = Allocator.systemAllocatorProvider()
    return run Allocator.allocateZeroed(move layout) |> Effect.provideMut<Allocator>(&mut system)
  }
  unsafe effect fn takeBlock(self: &mut Self, layout: Layout) -> ?*mut u8 { drop layout return Pointer.null<u8>() }
}

effect fn allocationClaims() -> () ! InvalidModulePath | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let body = run DeclarationId.fromParts(run ModuleId.make(b"memory", b"finite", b"allocation"), List<OwnerStep>.make())
  let stages: [usize; 3] = [0, 12, 16]
  let mut stage = usize.ZERO
  while stage < stages.length {
    let existing = stages[stage]
    let mut target = usize.ZERO
    let mut allocations = usize.ONE
    while target <= allocations {
      let mut budget = Budget.withLimits(100, existing + usize.ONE, 100, 100)
      let mut at = usize.ZERO
      while at < existing {
        drop run Budget.include(&mut budget, exampleKey(usize.toU64(at)), Option<&DeclarationId>.some(&body), 1, 1)
        at = at + usize.ONE
      }
      let saved = Budget.checkpoint(&mut budget)
      let mut fault = BudgetFaultAllocator {target: target, attempts: usize.ZERO}
      let tried = run Effect.result(Budget.include(&mut budget, exampleKey(usize.toU64(existing)), Option<&DeclarationId>.some(&body), 1, 1))
        |> Effect.provideMut<Allocator>(&mut fault)
      if target == usize.ZERO { allocations = fault.attempts }
      else {
        run Testing.expect(match &tried { Result<bool, OutOfMemoryError>.Failure {..} => true _ => false },
          "every injected allocation failure is reported before publishing the definition")
        run Testing.expect(Budget.definitionCount(&budget) == existing && Budget.runtimeBytes(&budget) == existing
          && Budget.referenceCount(&budget) == existing && !Budget.exhausted(&budget),
          "failed publication leaves the accepted graph and its resource state intact")
        if existing != usize.ZERO {
          run Testing.expect(List<usize>.get(&budget.bodyCounts, usize.ZERO) == existing,
            "failed definition allocation never increments an existing body's specialization count")
        }
      }
      // Rollback has no allocator effect, including when the allocator that failed still refuses storage.
      Budget.rollback(&mut budget, move saved)
      run Testing.expect(run Budget.include(&mut budget, exampleKey(usize.toU64(existing)), Option<&DeclarationId>.some(&body), 1, 1),
        "the actual definition can be retried after speculative allocation failure")
      run Testing.expect(!run Budget.include(&mut budget, exampleKey(usize.toU64(existing + usize.ONE)), Option<&DeclarationId>.some(&body), 1, 1),
        "retry consumes exactly one body slot rather than retaining or duplicating a failed publication")
      target = target + usize.ONE
    }
    stage = stage + usize.ONE
  }
}

test effect fn frontierBudgetAllocationFailureIsAtomic() -> () ! InvalidModulePath | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run allocationClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}
