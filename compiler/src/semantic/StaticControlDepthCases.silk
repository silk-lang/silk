//! Selected static bodies share the caller's configured recursion budget.

import lexer.Span {Span}
import semantic.ModuleId {InvalidModulePath}
import semantic.Semantic {Dependency, Semantic}
import semantic.StaticExecution
import semantic.StaticExecution {Diagnostic as StaticDiagnostic, Fault as StaticFault}
import semantic.StaticValue {
  IntegerType as StaticIntegerType,
  Sign as StaticSign,
  Value as StaticData,
}
import semantic.Target {Id as TargetId, Target as MachineTarget}
import semantic.SemanticCaseSupport {module, offsetOf, sameBytes, staticSemantic}
import silk.allocator {Allocator, OutOfMemoryError}
import silk.effect {Effect}
import silk.result {Result}
import silk.shared {Shared}
import silk.string {String}
import silk.testing {AssertionError, Testing}
import silk.usize
import silk.vector {Vector}

fn depthFortyTwo(value: &StaticData) -> bool {
  return match & value.* {
    StaticData.Integer {ty, sign, magnitude} => ty == StaticIntegerType.I32 && sign == StaticSign.Positive && magnitude == 42
    _ => false
  }
}

fn depthFaultAt(
  answer: &Result<Shared<StaticData>, StaticDiagnostic | OutOfMemoryError>,
  start: usize,
  width: usize,
) -> bool {
  return match & answer.* {
    Result<Shared<StaticData>, StaticDiagnostic | OutOfMemoryError>.Failure {error} => match & error {
      StaticDiagnostic {fault, code, span, ..} => fault == StaticFault.DepthLimit && sameBytes(
        code,
        b"SEM0180",
      ) && span.start == start && span.end == start + width
      _ => false
    }
    _ => false
  }
}

test effect fn selectedStaticRecursionSharesConfiguredDepthBudget() -> ()
! InvalidModulePath | OutOfMemoryError | StaticDiagnostic | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("selected-static-depth.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let source = """static fn selected(n: u32) -> i32 {
  static if n == 0 { return 42 } else {
    static if selected(n - 1) == 42 { return 42 } else { return 0 }
  }
}
static fn ordinary(n: u32) -> i32 {
  if n == 0 { return 42 } else { return ordinary(n - 1) }
}
"""
  let mut semantic = run staticSemantic(
    &id,
    source,
    MachineTarget.forId(TargetId.X8664UnknownLinuxGnu),
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut dependencies = Vector.make<Dependency>()
  let mut shallowMachine = run StaticExecution.make(
    Semantic.staticPort(&mut semantic, &mut dependencies),
    &id,
    StaticExecution.Limits {steps: 10000, depth: 2, valueBytes: 1048576},
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let shallowInput = run Shared.make<StaticData>(
    StaticData.Integer {ty: StaticIntegerType.U32, sign: StaticSign.Positive, magnitude: 8},
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let shallowEight = run Effect.result(
    StaticExecution.demand(
      &mut shallowMachine,
      b"selected",
      &[move shallowInput],
      Span.make(usize.ZERO, usize.ZERO),
    ),
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    depthFaultAt(
      &shallowEight,
      offsetOf(source, "selected(n - 1)", usize.ZERO),
      String.utf8Bytes("selected(n - 1)").length,
    ),
    "selected recursion of eight reports a structured refusal under configured depth two",
  )
  drop shallowMachine
  let mut defaultMachine = run StaticExecution.make(
    Semantic.staticPort(&mut semantic, &mut dependencies),
    &id,
    StaticExecution.Limits {steps: 10000, depth: 64, valueBytes: 1048576},
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let eight = run Shared.make<StaticData>(
    StaticData.Integer {ty: StaticIntegerType.U32, sign: StaticSign.Positive, magnitude: 8},
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let selectedEight = run StaticExecution.demand(
    &mut defaultMachine,
    b"selected",
    &[move eight],
    Span.make(usize.ZERO, usize.ZERO),
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    Shared.with<StaticData, bool>(&selectedEight, depthFortyTwo),
    "the same selected application reaches 42 at depth 64 after a depth-two refusal on the same semantic",
  )
  drop defaultMachine

  let mut boundedMachine = run StaticExecution.make(
    Semantic.staticPort(&mut semantic, &mut dependencies),
    &id,
    StaticExecution.Limits {steps: 10000, depth: 8, valueBytes: 1048576},
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let selectedInput = run Shared.make<StaticData>(
    StaticData.Integer {ty: StaticIntegerType.U32, sign: StaticSign.Positive, magnitude: 80},
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let selectedEighty = run Effect.result(
    StaticExecution.demand(
      &mut boundedMachine,
      b"selected",
      &[move selectedInput],
      Span.make(usize.ZERO, usize.ZERO),
    ),
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    depthFaultAt(
      &selectedEighty,
      offsetOf(source, "selected(n - 1)", usize.ZERO),
      String.utf8Bytes("selected(n - 1)").length,
    ),
    "selected recursion of eighty reports SEM0180 DepthLimit at the authored recursive call under configured depth eight",
  )

  let ordinaryInput = run Shared.make<StaticData>(
    StaticData.Integer {ty: StaticIntegerType.U32, sign: StaticSign.Positive, magnitude: 80},
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let ordinaryEighty = run Effect.result(
    StaticExecution.demand(
      &mut boundedMachine,
      b"ordinary",
      &[move ordinaryInput],
      Span.make(usize.ZERO, usize.ZERO),
    ),
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    depthFaultAt(
      &ordinaryEighty,
      offsetOf(source, "ordinary(n - 1)", usize.ZERO),
      String.utf8Bytes("ordinary(n - 1)").length,
    ),
    "ordinary recursion of eighty retains the same structured configured-depth refusal and authored call span",
  )

  let retryInput = run Shared.make<StaticData>(
    StaticData.Integer {ty: StaticIntegerType.U32, sign: StaticSign.Positive, magnitude: 1},
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let retried = run StaticExecution.demand(
    &mut boundedMachine,
    b"selected",
    &[move retryInput],
    Span.make(usize.ZERO, usize.ZERO),
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    Shared.with<StaticData, bool>(&retried, depthFortyTwo),
    "both depth refusals restore the shared budget so a later selected demand remains executable",
  )
  return ()
}
