//! Complete, identity-free values produced by static evaluation.
//!
//! # When to use
//! Store a successful static expression in [`Value`]. An evaluator owns each value and may share it
//! between demands; sharing does not imply that the source type implements runtime `Copy`.
//! Aggregate children are complete values, never addresses or mutable places. Source positions and
//! text provenance belong to the evaluation result, not to value identity.

import hir.Hir {InfixOperator, PrefixOperator}
import semantic.DeclarationId {DeclarationId}
import semantic.Type {Type}
import silk.allocator {Allocator, OutOfMemoryError}
import silk.bytes {Bytes}
import silk.f32
import silk.f64
import silk.option {Option}
import silk.result {Result}
import silk.shared {Shared}
import silk.u32
import silk.u64
import silk.u8
import silk.usize
import silk.utf8_decoder {Utf8Decoder, Utf8Step}
import silk.vector {Vector}

/// The exact integer type selected before static arithmetic. Pointer-sized kinds use the frozen
/// target's width, supplied to operations separately from this value.
pub enum IntegerType {
  U8,
  U16,
  U32,
  U64,
  Usize,
  I8,
  I16,
  I32,
  I64,
  Isize,
}

/// The width of a floating result. Its bits preserve signed zero and NaN representation.
pub enum FloatType {
  F32,
  F64,
}

/// An integer's sign. Zero always has [`Sign.Positive`].
pub enum Sign {
  Positive,
  Negative,
}

/// One immutable, recursively pure value. A `Value` contains no borrow, resource, callable,
/// Effect, service, pointer, or observable cleanup state.
pub union Value {
  Unit,
  Boolean {pub value: bool},
  Character {pub scalar: u32},
  Integer {pub ty: IntegerType, pub sign: Sign, pub magnitude: u64},
  Float {pub ty: FloatType, pub bits: u64},
  /// A scalar enum's canonical declaration and selected member, not merely its integer bits.
  Enum {
    pub declaration: Shared<DeclarationId>,
    pub member: usize,
    pub representation: IntegerType,
    pub sign: Sign,
    pub magnitude: u64,
  },
  /// Decoded UTF-8 bytes. Provenance is deliberately separate from identity.
  Text {pub bytes: Bytes},
  /// One fixed array. Nominal storage remains unsupported until M2.5 can prove structural
  /// cleanup freedom from validated declaration facts.
  Aggregate {
    pub ty: Shared<Type>,
    pub variant: Option<usize>,
    pub fields: Vector<Shared<Value>>,
    admission: ArrayAdmission,
  },
}

/// Private evidence that the array extent was checked at construction.
struct ArrayAdmission {
  length: usize
}

/// A static scalar operation failed before it could publish a value. The caller attaches the
/// authored operation's span and specialization trace to its diagnostic.
pub enum Fault {
  InvalidOperands,
  Overflow,
  DivisionByZero,
}

/// The number of bits in an integer type after the target has been frozen.
pub fn integerBits(ty: IntegerType, pointerBits: u32) -> Option<u32> {
  return match ty {
    IntegerType.U8 => Option.some<u32>(8)
    IntegerType.I8 => Option.some<u32>(8)
    IntegerType.U16 => Option.some<u32>(16)
    IntegerType.I16 => Option.some<u32>(16)
    IntegerType.U32 => Option.some<u32>(32)
    IntegerType.I32 => Option.some<u32>(32)
    IntegerType.U64 => Option.some<u32>(64)
    IntegerType.I64 => Option.some<u32>(64)
    IntegerType.Usize => {
      if pointerBits == 32 || pointerBits == 64 {
        return Option.some<u32>(pointerBits)
      }
      return Option.none<u32>()
    }
    IntegerType.Isize => {
      if pointerBits == 32 || pointerBits == 64 {
        return Option.some<u32>(pointerBits)
      }
      return Option.none<u32>()
    }
  }
}

/// Whether the selected integer type admits negative values.
pub fn signed(ty: IntegerType) -> bool {
  return match ty {
    IntegerType.I8 => true
    IntegerType.I16 => true
    IntegerType.I32 => true
    IntegerType.I64 => true
    IntegerType.Isize => true
    _ => false
  }
}

/// The largest magnitude permitted with this sign and target width.
pub fn integerLimit(ty: IntegerType, sign: Sign, pointerBits: u32) -> Option<u64> {
  let bits = match move integerBits(ty, pointerBits) {
    Option<u32>.Some {value} => value
    Option<u32>.None => {
      return Option.none<u64>()
    }
  }
  if sign == Sign.Negative && !signed(ty) {
    return Option.none<u64>()
  }
  if !signed(ty) {
    if bits == 64 {
      return Option.some<u64>(u64.MAX)
    }
    return Option.some<u64>(u64.subtract(u64.shiftLeft(1, u32.toU64(bits)), 1))
  }
  if sign == Sign.Negative {
    return Option.some<u64>(u64.shiftLeft(1, u32.toU64(bits - 1)))
  }
  return Option.some<u64>(u64.subtract(u64.shiftLeft(1, u32.toU64(bits - 1)), 1))
}

/// Normalize zero and reject values outside the exact selected integer range.
pub fn integer(ty: IntegerType, sign: Sign, magnitude: u64, pointerBits: u32) -> Option<Value> {
  let mut canonical = sign
  if magnitude == 0 {
    canonical = Sign.Positive
  }
  let limit = match move integerLimit(ty, canonical, pointerBits) {
    Option<u64>.Some {value} => value
    Option<u64>.None => {
      return Option.none<Value>()
    }
  }
  if magnitude > limit {
    return Option.none<Value>()
  }
  return Option.some<Value>(Value.Integer {ty: ty, sign: canonical, magnitude: magnitude})
}

/// Construct one validated scalar enum member while retaining its nominal identity.
pub fn enumeration(
  declaration: Shared<DeclarationId>,
  member: usize,
  representation: IntegerType,
  sign: Sign,
  magnitude: u64,
) -> Option<Value> {
  if representation == IntegerType.Usize || representation == IntegerType.Isize {
    return Option.none<Value>()
  }
  if let Option<Value>.None = move integer(representation, sign, magnitude, 64) {
    return Option.none<Value>()
  }
  let mut canonical = sign
  if magnitude == 0 {
    canonical = Sign.Positive
  }
  return Option.some<Value>(
    Value.Enum {
      declaration: move declaration,
      member: member,
      representation: representation,
      sign: canonical,
      magnitude: magnitude,
    },
  )
}

/// Admit exactly one Unicode scalar value.
pub fn character(scalar: u32) -> Option<Value> {
  if scalar > 0x10ffff || (scalar >= 0xd800 && scalar <= 0xdfff) {
    return Option.none<Value>()
  }
  return Option.some<Value>(Value.Character {scalar: scalar})
}

/// Admit complete UTF-8 text without conflating it with a byte view. This checks a static text
/// candidate again after concatenation or slicing, before it can enter the value domain.
pub fn text(bytes: Bytes) -> Option<Value> {
  let mut decoder = Utf8Decoder.make()
  let data = Bytes.asSlice(&bytes)
  let mut at = usize.ZERO
  while at < data.length {
    if let Utf8Step.Invalid {..} = move Utf8Decoder.step(&mut decoder, data[at], at) {
      return Option.none<Value>()
    }
    at = at + usize.ONE
  }
  if Utf8Decoder.pending(&decoder) {
    return Option.none<Value>()
  }
  return Option.some<Value>(Value.Text {bytes: move bytes})
}

/// These type forms contain execution or an address even if their current payload looks inert.
/// Nominal structural eligibility awaits M2.5's validated cleanup proof, including empty types.
pub fn intrinsicallyForbidden(ty: &Type) -> bool {
  return match & ty.* {
    Type.Reference {..} => true
    Type.Slice {..} => true
    Type.Pointer {..} => true
    Type.Callable {..} => true
    Type.Effect {..} => true
    Type.NamedRepresentation {..} => true
    Type.OpaqueRepresentation {..} => true
    Type.Nominal {..} => true
    Type.Array {element, ..} => Shared.with<Type, bool>(&element, intrinsicallyForbidden)
    _ => false
  }
}

/// Check the recursively immutable value domain before sharing an aggregate child.
pub fn pure(value: &Value) -> bool {
  return match & value.* {
    Value.Aggregate {ty, variant, fields, admission} => {
      if Shared.with<Type, bool>(&ty, intrinsicallyForbidden) {
        return false
      }
      let length = Shared.with<Type, Option<usize>>(&ty, fn(ty: &Type) -> Option<usize> {
        return match & ty.* {
          Type.Array {extent, ..} => arrayLength(Bytes.asSlice(&extent))
          _ => Option.none<usize>()
        }
      })
      let expected = match move length {
        Option<usize>.Some {value: count} => count
        Option<usize>.None => return false
      }
      if expected != admission.length || expected != Vector.length<Shared<Value>>(&fields) {
        return false
      }
      if let Option<usize>.Some {..} = & variant {
        return false
      }
      let children = Vector.asSlice<Shared<Value>>(&fields)
      let mut at = usize.ZERO
      while at < children.length {
        if !Shared.with<Value, bool>(&children[at], pure) {
          return false
        }
        at = at + usize.ONE
      }
      return true
    }
    _ => true
  }
}

fn arrayLength(extent: &[u8]) -> Option<usize> {
  if extent.length == usize.ZERO {
    return Option.none<usize>()
  }
  let mut length = usize.ZERO
  let mut at = usize.ZERO
  while at < extent.length {
    if extent[at] < 48 || extent[at] > 57 {
      return Option.none<usize>()
    }
    length = match move usize.checkedMultiply(length, 10) {
      Option<usize>.Some {value} => value
      Option<usize>.None => {
        return Option.none<usize>()
      }
    }
    length = match move usize.checkedAdd(length, u8.toUsize(extent[at] - 48)) {
      Option<usize>.Some {value} => value
      Option<usize>.None => {
        return Option.none<usize>()
      }
    }
    at = at + usize.ONE
  }
  return Option.some<usize>(length)
}

/// Construct a fixed array from already admitted child values. No child address or mutable place
/// is retained. Nominal values are Unsupported until M2.5 proves cleanup freedom.
pub fn aggregate(ty: Shared<Type>, variant: Option<usize>, fields: Vector<Shared<Value>>) -> Option<
  Value,
> {
  if Shared.with<Type, bool>(&ty, intrinsicallyForbidden) {
    return Option.none<Value>()
  }
  let count = Vector.length<Shared<Value>>(&fields)
  let noVariant = match & variant {
    Option<usize>.None => true
    Option<usize>.Some {..} => false
  }
  let shape = Shared.with<Type, bool>(
    &ty,
    fn(value: &Type) -> bool {
      return match & value.* {
        Type.Array {extent, ..} => {
          if !noVariant {
            return false
          }
          return match move arrayLength(Bytes.asSlice(&extent)) {
            Option<usize>.Some {value: length} => length == count
            Option<usize>.None => false
          }
        }
        _ => false
      }
    },
  )
  if !shape {
    return Option.none<Value>()
  }
  let children = Vector.asSlice<Shared<Value>>(&fields)
  let mut at = usize.ZERO
  while at < children.length {
    if !Shared.with<Value, bool>(&children[at], pure) {
      return Option.none<Value>()
    }
    at = at + usize.ONE
  }
  return Option.some<Value>(
    Value.Aggregate {
      ty: move ty,
      variant: move variant,
      fields: move fields,
      admission: ArrayAdmission {length: count},
    },
  )
}

/// Admit a bit-exact float. An f32 value has no bits above its 32-bit representation.
pub fn floating(ty: FloatType, bits: u64) -> Option<Value> {
  if ty == FloatType.F32 && bits > 0xffffffff {
    return Option.none<Value>()
  }
  return Option.some<Value>(Value.Float {ty: ty, bits: bits})
}

/// Borrow one field without giving the caller an address or mutable place.
pub fn field(value: &Value, ordinal: usize) -> Option<Shared<Value>> {
  return match & value.* {
    Value.Aggregate {fields, ..} => {
      let values = Vector.asSlice<Shared<Value>>(&fields)
      if ordinal >= values.length {
        return Option.none<Shared<Value>>()
      }
      return Option.some<Shared<Value>>(Shared.clone<Value>(&values[ordinal]))
    }
    _ => Option.none<Shared<Value>>()
  }
}

fn success(value: Value) -> Result<Value, Fault> {
  return Result.succeed<Value, Fault>(move value)
}

fn failure(reason: Fault) -> Result<Value, Fault> {
  return Result.failResult<Value, Fault>(reason)
}

fn integerResult(ty: IntegerType, sign: Sign, magnitude: u64, pointerBits: u32) -> Result<
  Value,
  Fault,
> {
  return match move integer(ty, sign, magnitude, pointerBits) {
    Option<Value>.Some {value} => success(move value)
    Option<Value>.None => failure(Fault.Overflow)
  }
}

fn opposite(sign: Sign) -> Sign {
  if sign == Sign.Negative {
    return Sign.Positive
  }
  return Sign.Negative
}

fn sum(ty: IntegerType, leftSign: Sign, left: u64, rightSign: Sign, right: u64, pointerBits: u32) -> Result<
  Value,
  Fault,
> {
  if leftSign == rightSign {
    return match move u64.checkedAdd(left, right) {
      Option<u64>.Some {value} => integerResult(ty, leftSign, value, pointerBits)
      Option<u64>.None => failure(Fault.Overflow)
    }
  }
  if left >= right {
    return integerResult(ty, leftSign, u64.subtract(left, right), pointerBits)
  }
  return integerResult(ty, rightSign, u64.subtract(right, left), pointerBits)
}

fn compareIntegers(leftSign: Sign, left: u64, rightSign: Sign, right: u64) -> i32 {
  if leftSign != rightSign {
    if leftSign == Sign.Negative {
      return -1
    }
    return 1
  }
  if left == right {
    return 0
  }
  if (left < right) == (leftSign == Sign.Positive) {
    return -1
  }
  return 1
}

fn ordered(operator: InfixOperator, comparison: i32) -> Result<Value, Fault> {
  let result = match operator {
    InfixOperator.Equals => comparison == 0
    InfixOperator.NotEquals => comparison != 0
    InfixOperator.LessThan => comparison < 0
    InfixOperator.LessOrEqual => comparison <= 0
    InfixOperator.GreaterThan => comparison > 0
    InfixOperator.GreaterOrEqual => comparison >= 0
    _ => {
      return failure(Fault.InvalidOperands)
    }
  }
  return success(Value.Boolean {value: result})
}

fn integerPattern(sign: Sign, magnitude: u64) -> u64 {
  if sign == Sign.Negative {
    return u64.wrappingSubtract(0, magnitude)
  }
  return magnitude
}

fn fromPattern(ty: IntegerType, pattern: u64, pointerBits: u32) -> Result<Value, Fault> {
  let bits = match move integerBits(ty, pointerBits) {
    Option<u32>.Some {value} => value
    Option<u32>.None => {
      return failure(Fault.InvalidOperands)
    }
  }
  let mut mask = u64.MAX
  if bits != 64 {
    mask = u64.subtract(u64.shiftLeft(1, u32.toU64(bits)), 1)
  }
  let truncated = u64.bitAnd(pattern, mask)
  if signed(ty) && u64.bitAnd(truncated, u64.shiftLeft(1, u32.toU64(bits - 1))) != 0 {
    return integerResult(
      ty,
      Sign.Negative,
      u64.bitAnd(u64.wrappingSubtract(0, truncated), mask),
      pointerBits,
    )
  }
  return integerResult(ty, Sign.Positive, truncated, pointerBits)
}

fn integerPrefix(
  operator: PrefixOperator,
  ty: IntegerType,
  sign: Sign,
  magnitude: u64,
  pointerBits: u32,
) -> Result<Value, Fault> {
  return match operator {
    PrefixOperator.Negate => {
      if !signed(ty) {
        return failure(Fault.InvalidOperands)
      }
      return integerResult(ty, opposite(sign), magnitude, pointerBits)
    }
    PrefixOperator.BitwiseNot => fromPattern(
      ty,
      u64.bitNot(integerPattern(sign, magnitude)),
      pointerBits,
    )
    PrefixOperator.Not => failure(Fault.InvalidOperands)
  }
}

fn integerInfix(
  operator: InfixOperator,
  ty: IntegerType,
  leftSign: Sign,
  left: u64,
  rightSign: Sign,
  right: u64,
  pointerBits: u32,
) -> Result<Value, Fault> {
  match operator {
    InfixOperator.Add => {
      return sum(ty, leftSign, left, rightSign, right, pointerBits)
    }
    InfixOperator.Subtract => {
      return sum(ty, leftSign, left, opposite(rightSign), right, pointerBits)
    }
    InfixOperator.Multiply => {
      return match move u64.checkedMultiply(left, right) {
        Option<u64>.Some {value} => {
          let mut sign = Sign.Negative
          if leftSign == rightSign {
            sign = Sign.Positive
          }
          return integerResult(ty, sign, value, pointerBits)
        }
        Option<u64>.None => failure(Fault.Overflow)
      }
    }
    InfixOperator.Divide => {
      if right == 0 {
        return failure(Fault.DivisionByZero)
      }
      let mut sign = Sign.Negative
      if leftSign == rightSign {
        sign = Sign.Positive
      }
      return integerResult(ty, sign, u64.divide(left, right), pointerBits)
    }
    InfixOperator.Remainder => {
      if right == 0 {
        return failure(Fault.DivisionByZero)
      }
      // MIN % -1 traps alongside MIN / -1, even though the mathematical remainder is zero.
      if signed(ty) && leftSign == Sign.Negative && rightSign == Sign.Negative && right == 1 {
        if let Option<u64>.Some {value: minimumMagnitude} = move integerLimit(
          ty,
          Sign.Negative,
          pointerBits,
        ) {
          if left == minimumMagnitude {
            return failure(Fault.Overflow)
          }
        }
      }
      return integerResult(ty, leftSign, u64.remainder(left, right), pointerBits)
    }
    InfixOperator.BitAnd => {
      return fromPattern(
        ty,
        u64.bitAnd(integerPattern(leftSign, left), integerPattern(rightSign, right)),
        pointerBits,
      )
    }
    InfixOperator.BitOr => {
      return fromPattern(
        ty,
        u64.bitOr(integerPattern(leftSign, left), integerPattern(rightSign, right)),
        pointerBits,
      )
    }
    InfixOperator.BitXor => {
      return fromPattern(
        ty,
        u64.bitXor(integerPattern(leftSign, left), integerPattern(rightSign, right)),
        pointerBits,
      )
    }
    _ => {
      return ordered(operator, compareIntegers(leftSign, left, rightSign, right))
    }
  }
}

/// Evaluate a concrete unary scalar operator. The evaluator checks the typed operand contract
/// before this call; the result here still rejects mismatched value forms defensively.
pub fn prefix(operator: PrefixOperator, operand: &Value, pointerBits: u32) -> Result<Value, Fault> {
  return match & operand.* {
    Value.Integer {ty, sign, magnitude} => integerPrefix(operator, ty, sign, magnitude, pointerBits)
    Value.Boolean {value} => {
      if operator == PrefixOperator.Not {
        return success(Value.Boolean {value: !value})
      }
      return failure(Fault.InvalidOperands)
    }
    Value.Float {ty, bits} => {
      if operator != PrefixOperator.Negate {
        return failure(Fault.InvalidOperands)
      }
      let mut signBit: u64 = 0x8000000000000000
      if ty == FloatType.F32 {
        signBit = 0x80000000
      }
      return match move floating(ty, u64.bitXor(bits, signBit)) {
        Option<Value>.Some {value} => success(move value)
        Option<Value>.None => failure(Fault.InvalidOperands)
      }
    }
    _ => failure(Fault.InvalidOperands)
  }
}

fn float32Infix(operator: InfixOperator, leftBits: u64, rightBits: u64) -> Result<Value, Fault> {
  let left = f32.fromBits(u64.toU32(leftBits))
  let right = f32.fromBits(u64.toU32(rightBits))
  let result = match operator {
    InfixOperator.Add => f32.add(left, right)
    InfixOperator.Subtract => f32.subtract(left, right)
    InfixOperator.Multiply => f32.multiply(left, right)
    InfixOperator.Divide => f32.divide(left, right)
    InfixOperator.Remainder => f32.remainder(left, right)
    InfixOperator.Equals => {
      return success(Value.Boolean {value: left == right})
    }
    InfixOperator.NotEquals => {
      return success(Value.Boolean {value: left != right})
    }
    InfixOperator.LessThan => {
      return success(Value.Boolean {value: left < right})
    }
    InfixOperator.LessOrEqual => {
      return success(Value.Boolean {value: left <= right})
    }
    InfixOperator.GreaterThan => {
      return success(Value.Boolean {value: left > right})
    }
    InfixOperator.GreaterOrEqual => {
      return success(Value.Boolean {value: left >= right})
    }
    _ => {
      return failure(Fault.InvalidOperands)
    }
  }
  return match move floating(FloatType.F32, u32.toU64(f32.toBits(result))) {
    Option<Value>.Some {value} => success(move value)
    Option<Value>.None => failure(Fault.InvalidOperands)
  }
}

fn float64Infix(operator: InfixOperator, leftBits: u64, rightBits: u64) -> Result<Value, Fault> {
  let left = f64.fromBits(leftBits)
  let right = f64.fromBits(rightBits)
  let result = match operator {
    InfixOperator.Add => f64.add(left, right)
    InfixOperator.Subtract => f64.subtract(left, right)
    InfixOperator.Multiply => f64.multiply(left, right)
    InfixOperator.Divide => f64.divide(left, right)
    InfixOperator.Remainder => f64.remainder(left, right)
    InfixOperator.Equals => {
      return success(Value.Boolean {value: left == right})
    }
    InfixOperator.NotEquals => {
      return success(Value.Boolean {value: left != right})
    }
    InfixOperator.LessThan => {
      return success(Value.Boolean {value: left < right})
    }
    InfixOperator.LessOrEqual => {
      return success(Value.Boolean {value: left <= right})
    }
    InfixOperator.GreaterThan => {
      return success(Value.Boolean {value: left > right})
    }
    InfixOperator.GreaterOrEqual => {
      return success(Value.Boolean {value: left >= right})
    }
    _ => {
      return failure(Fault.InvalidOperands)
    }
  }
  return match move floating(FloatType.F64, f64.toBits(result)) {
    Option<Value>.Some {value} => success(move value)
    Option<Value>.None => failure(Fault.InvalidOperands)
  }
}

fn sameBytes(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

fn declarationWith(first: &DeclarationId, second: &Shared<DeclarationId>) -> bool {
  return Shared.with<DeclarationId, bool>(
    second,
    fn(other: &DeclarationId) -> bool {
      return DeclarationId.equals(first, other)
    },
  )
}

fn declarationAddress(value: &DeclarationId) -> usize {
  return Pointer.address<DeclarationId>(Pointer.fromRef<DeclarationId>(value))
}

fn valueAddress(value: &Value) -> usize {
  return Pointer.address<Value>(Pointer.fromRef<Value>(value))
}

fn sameDeclaration(left: &Shared<DeclarationId>, right: &Shared<DeclarationId>) -> bool {
  if Shared.with<DeclarationId, usize>(left, declarationAddress) == Shared.with<
    DeclarationId,
    usize,
  >(right, declarationAddress) {
    return true
  }
  return Shared.with<DeclarationId, bool>(
    left,
    fn(first: &DeclarationId) -> bool {
      return declarationWith(first, right)
    },
  )
}

/// Retain a complete value for another static use without implying runtime `Copy`.
pub fn copy(value: &Shared<Value>) -> Shared<Value> {
  return Shared.clone<Value>(value)
}

fn sameVariant(left: &Option<usize>, right: &Option<usize>) -> bool {
  return match & left.* {
    Option<usize>.Some {value: first} => match & right.* {
      Option<usize>.Some {value: second} => first == second
      Option<usize>.None => false
    }
    Option<usize>.None => match & right.* {
      Option<usize>.Some {..} => false
      Option<usize>.None => true
    }
  }
}

fn immediateEquals(left: &Value, right: &Value) -> bool {
  return match & left.* {
    Value.Unit => match & right.* {
      Value.Unit => true
      _ => false
    }
    Value.Boolean {value: first} => match & right.* {
      Value.Boolean {value: second} => first == second
      _ => false
    }
    Value.Character {scalar: first} => match & right.* {
      Value.Character {scalar: second} => first == second
      _ => false
    }
    Value.Integer {ty: firstType, sign: firstSign, magnitude: firstMagnitude} => match & right.* {
      Value.Integer {ty: secondType, sign: secondSign, magnitude: secondMagnitude} => firstType == secondType && firstSign == secondSign && firstMagnitude == secondMagnitude
      _ => false
    }
    Value.Float {ty: firstType, bits: firstBits} => match & right.* {
      Value.Float {ty: secondType, bits: secondBits} => firstType == secondType && firstBits == secondBits
      _ => false
    }
    Value.Enum {
      declaration: firstDeclaration,
      member: firstMember,
      representation: firstType,
      sign: firstSign,
      magnitude: firstMagnitude,
    } => match & right.* {
      Value.Enum {
        declaration: secondDeclaration,
        member: secondMember,
        representation: secondType,
        sign: secondSign,
        magnitude: secondMagnitude,
      } => sameDeclaration(&firstDeclaration, &secondDeclaration) && firstMember == secondMember && firstType == secondType && firstSign == secondSign && firstMagnitude == secondMagnitude
      _ => false
    }
    Value.Text {bytes: first} => match & right.* {
      Value.Text {bytes: second} => sameBytes(Bytes.asSlice(&first), Bytes.asSlice(&second))
      _ => false
    }
    Value.Aggregate {variant: firstVariant, fields: firstFields, ..} => match & right.* {
      Value.Aggregate {variant: secondVariant, fields: secondFields, ..} => sameVariant(
        &firstVariant,
        &secondVariant,
      ) && Vector.length<Shared<Value>>(&firstFields) == Vector.length<Shared<Value>>(&secondFields)
      _ => false
    }
  }
}

fn immediateWith(first: &Value, right: &Shared<Value>) -> bool {
  return Shared.with<Value, bool>(
    right,
    fn(second: &Value) -> bool {
      return immediateEquals(first, second)
    },
  )
}

fn immediateSharedEquals(left: &Shared<Value>, right: &Shared<Value>) -> bool {
  return Shared.with<Value, bool>(
    left,
    fn(first: &Value) -> bool {
      return immediateWith(first, right)
    },
  )
}

fn aggregateType(value: &Value) -> Option<Shared<Type>> {
  return match & value.* {
    Value.Aggregate {ty, ..} => Option.some<Shared<Type>>(Shared.clone<Type>(&ty))
    _ => Option.none<Shared<Type>>()
  }
}

fn aggregateLength(value: &Value) -> usize {
  return match & value.* {
    Value.Aggregate {fields, ..} => Vector.length<Shared<Value>>(&fields)
    _ => usize.ZERO
  }
}

fn aggregateChild(value: &Value, at: usize) -> Option<Shared<Value>> {
  if let Value.Aggregate {fields, ..} = &value.* {
    let entries = Vector.asSlice<Shared<Value>>(&fields)
    return Option.some<Shared<Value>>(Shared.clone<Value>(&entries[at]))
  }
  return Option.none<Shared<Value>>()
}

effect fn sharedEquals(left: &Shared<Value>, right: &Shared<Value>) -> bool
! OutOfMemoryError
? &mut Allocator {
  if Shared.with<Value, usize>(left, valueAddress) == Shared.with<Value, usize>(right, valueAddress) {
    return true
  }
  if !immediateSharedEquals(left, right) {
    return false
  }
  let leftType = Shared.with<Value, Option<Shared<Type>>>(left, aggregateType)
  let rightType = Shared.with<Value, Option<Shared<Type>>>(right, aggregateType)
  if let Option<Shared<Type>>.Some {value: firstType} = move leftType {
    if let Option<Shared<Type>>.Some {value: secondType} = move rightType {
      if !run Type.equalsShared(&firstType, &secondType) {
        return false
      }
      let length = Shared.with<Value, usize>(left, aggregateLength)
      let mut at = usize.ZERO
      while at < length {
        let firstChild = Shared.with<Value, Option<Shared<Value>>>(
          left,
          fn(value: &Value) -> Option<Shared<Value>> {
            return aggregateChild(value, at)
          },
        )
        let secondChild = Shared.with<Value, Option<Shared<Value>>>(
          right,
          fn(value: &Value) -> Option<Shared<Value>> {
            return aggregateChild(value, at)
          },
        )
        let first = match move firstChild {
          Option<Shared<Value>>.Some {value} => value
          Option<Shared<Value>>.None => {
            return false
          }
        }
        let second = match move secondChild {
          Option<Shared<Value>>.Some {value} => value
          Option<Shared<Value>>.None => {
            return false
          }
        }
        if !run sharedEquals(&first, &second) {
          return false
        }
        at = at + usize.ONE
      }
    }
  }
  return true
}

/// Canonical structural identity, including nominal aggregate types and every nested child.
pub effect fn equals(left: &Shared<Value>, right: &Shared<Value>) -> bool
! OutOfMemoryError
? &mut Allocator {
  return run sharedEquals(left, right)
}

fn saturatingAdd(left: usize, right: usize) -> usize {
  return match move usize.checkedAdd(left, right) {
    Option<usize>.Some {value} => value
    Option<usize>.None => usize.MAX
  }
}

/// Conservative retained-byte estimate for bounded static evaluation.
pub fn size(value: &Value) -> usize {
  return match & value.* {
    Value.Text {bytes} => saturatingAdd(16, Bytes.length(&bytes))
    Value.Aggregate {fields, ..} => {
      let children = Vector.asSlice<Shared<Value>>(&fields)
      let mut total = usize.ZERO + 16
      let mut at = usize.ZERO
      while at < children.length {
        let child = Shared.with<Value, usize>(&children[at], size)
        total = saturatingAdd(total, child)
        at = at + usize.ONE
      }
      return total
    }
    _ => 16
  }
}

/// Evaluate a concrete eager scalar or text operator. `&&` and `||` belong to the control-flow
/// evaluator because their right operand must remain undemanded when the left decides the result.
pub fn infix(operator: InfixOperator, left: &Value, right: &Value, pointerBits: u32) -> Result<
  Value,
  Fault,
> {
  return match & left.* {
    Value.Integer {ty: leftType, sign: leftSign, magnitude: leftMagnitude} => match & right.* {
      Value.Integer {ty: rightType, sign: rightSign, magnitude: rightMagnitude} => {
        if leftType != rightType {
          return failure(Fault.InvalidOperands)
        }
        return integerInfix(
          operator,
          leftType,
          leftSign,
          leftMagnitude,
          rightSign,
          rightMagnitude,
          pointerBits,
        )
      }
      _ => failure(Fault.InvalidOperands)
    }
    Value.Float {ty: leftType, bits: leftBits} => match & right.* {
      Value.Float {ty: rightType, bits: rightBits} => {
        if leftType != rightType {
          return failure(Fault.InvalidOperands)
        }
        if leftType == FloatType.F32 {
          return float32Infix(operator, leftBits, rightBits)
        }
        return float64Infix(operator, leftBits, rightBits)
      }
      _ => failure(Fault.InvalidOperands)
    }
    Value.Boolean {value: leftValue} => match & right.* {
      Value.Boolean {value: rightValue} => {
        if operator == InfixOperator.Equals {
          return success(Value.Boolean {value: leftValue == rightValue})
        }
        if operator == InfixOperator.NotEquals {
          return success(Value.Boolean {value: leftValue != rightValue})
        }
        return failure(Fault.InvalidOperands)
      }
      _ => failure(Fault.InvalidOperands)
    }
    Value.Character {scalar: leftScalar} => match & right.* {
      Value.Character {scalar: rightScalar} => {
        let mut order = 0
        if leftScalar < rightScalar {
          order = -1
        }
        if leftScalar > rightScalar {
          order = 1
        }
        return ordered(operator, order)
      }
      _ => failure(Fault.InvalidOperands)
    }
    Value.Text {bytes: leftBytes} => match & right.* {
      Value.Text {bytes: rightBytes} => {
        if operator != InfixOperator.Equals && operator != InfixOperator.NotEquals {
          return failure(Fault.InvalidOperands)
        }
        let equal = sameBytes(Bytes.asSlice(&leftBytes), Bytes.asSlice(&rightBytes))
        let mut result = equal
        if operator == InfixOperator.NotEquals {
          result = !equal
        }
        return success(Value.Boolean {value: result})
      }
      _ => failure(Fault.InvalidOperands)
    }
    Value.Enum {declaration: leftDeclaration, member: leftMember, ..} => match & right.* {
      Value.Enum {declaration: rightDeclaration, member: rightMember, ..} => {
        if operator != InfixOperator.Equals && operator != InfixOperator.NotEquals {
          return failure(Fault.InvalidOperands)
        }
        let sameDeclaration = sameDeclaration(&leftDeclaration, &rightDeclaration)
        if !sameDeclaration {
          return failure(Fault.InvalidOperands)
        }
        let equal = leftMember == rightMember
        let mut result = equal
        if operator == InfixOperator.NotEquals {
          result = !equal
        }
        return success(Value.Boolean {value: result})
      }
      _ => failure(Fault.InvalidOperands)
    }
    _ => failure(Fault.InvalidOperands)
  }
}
