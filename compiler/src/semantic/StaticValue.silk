//! Complete, identity-free values used by static evaluation and checked configuration schemas.
//!
//! # When to use
//! Store a successful static expression in [`Value`]. An evaluator owns each value and may share it
//! between demands; sharing does not imply that the source type implements runtime `Copy`.
//! Aggregate children are complete values, never addresses or mutable places. General static
//! admission uses [`pure`]; configuration nominal values require a separate portable Shape proof
//! before publication. Source positions and text provenance belong to the evaluation result.

import hir.FloatingLiteral
import hir.Hir {InfixOperator, Module, OwnerKind, PrefixOperator}
import hir.Intern {Symbol}
import semantic.Intrinsic as CheckedIntrinsic
import semantic.DeclarationId {DeclarationId}
import semantic.Lifetime {CanonicalizationFailure, Numbering}
import semantic.RuntimeEncoding
import semantic.RuntimeEncoding {Coordinates}
import semantic.Type {Argument, Type as SemanticType}
import silk.allocator {Allocator, OutOfMemoryError}
import silk.bytes {Bytes}
import silk.f32
import silk.f64
import silk.format {ParseError}
import silk.option {Option}
import silk.pointer {Pointer}
import silk.result {Result}
import silk.shared {Shared}
import silk.u32
import silk.u64
import silk.u8
import silk.usize
import silk.utf8_decoder {Utf8Decoder, Utf8Step}
import silk.vector {Vector}

/// The exact integer type selected before static arithmetic. Pointer-sized kinds use the frozen
/// target's width, supplied to operations separately from this value.
pub enum IntegerType {
  U8,
  U16,
  U32,
  U64,
  Usize,
  I8,
  I16,
  I32,
  I64,
  Isize,
}

/// The width of a floating result. Its bits preserve signed zero and NaN representation.
pub enum FloatType {
  F32,
  F64,
}

/// An integer's sign. Zero always has [`Sign.Positive`].
pub enum Sign {
  Positive,
  Negative,
}

/// One immutable complete value. General static evaluation admits it only when [`pure`] holds.
/// Configuration nominals are construction-only here and require U7's portable Shape proof.
pub union Value {
  Unit,
  Boolean {pub value: bool},
  Character {pub scalar: u32},
  Integer {pub ty: IntegerType, pub sign: Sign, pub magnitude: u64},
  Float {pub ty: FloatType, pub bits: u64},
  /// A scalar enum's canonical declaration and selected member, not merely its integer bits.
  Enum {
    pub declaration: Shared<DeclarationId>,
    pub member: usize,
    pub representation: IntegerType,
    pub sign: Sign,
    pub magnitude: u64,
  },
  /// Decoded UTF-8 bytes. Provenance is deliberately separate from identity.
  Text {pub bytes: Bytes},
  /// A fixed array or construction-only nominal. Nominal storage in general static evaluation
  /// remains Unsupported until M2.5 proves structural cleanup freedom.
  /// An immutable phase-only sealed sequence. Only checked constructors mint its admission.
  Sequence {pub ty: Shared<SemanticType>, pub elements: Vector<Shared<Value>>, admission: SequenceAdmission},
  Aggregate {
    pub ty: Shared<SemanticType>,
    pub variant: Option<usize>,
    pub fields: Vector<Shared<Value>>,
    admission: Option<ArrayAdmission>,
  },
}

/// Private evidence that the array extent was checked at construction.
struct SequenceAdmission {}

struct ArrayAdmission {
  length: usize
}

/// A static scalar operation failed before it could publish a value. The caller attaches the
/// authored operation's span and specialization trace to its diagnostic.
pub enum Fault {
  InvalidOperands,
  Overflow,
  DivisionByZero,
}

/// The number of bits in an integer type after the target has been frozen.
pub fn integerBits(ty: IntegerType, pointerBits: u32) -> Option<u32> {
  return match ty {
    IntegerType.U8 => Option.some<u32>(8)
    IntegerType.I8 => Option.some<u32>(8)
    IntegerType.U16 => Option.some<u32>(16)
    IntegerType.I16 => Option.some<u32>(16)
    IntegerType.U32 => Option.some<u32>(32)
    IntegerType.I32 => Option.some<u32>(32)
    IntegerType.U64 => Option.some<u32>(64)
    IntegerType.I64 => Option.some<u32>(64)
    IntegerType.Usize => {
      if pointerBits == 32 || pointerBits == 64 {
        return Option.some<u32>(pointerBits)
      }
      return Option.none<u32>()
    }
    IntegerType.Isize => {
      if pointerBits == 32 || pointerBits == 64 {
        return Option.some<u32>(pointerBits)
      }
      return Option.none<u32>()
    }
  }
}

/// Whether the selected integer type admits negative values.
pub fn signed(ty: IntegerType) -> bool {
  return match ty {
    IntegerType.I8 => true
    IntegerType.I16 => true
    IntegerType.I32 => true
    IntegerType.I64 => true
    IntegerType.Isize => true
    _ => false
  }
}

/// The largest magnitude permitted with this sign and target width.
pub fn integerLimit(ty: IntegerType, sign: Sign, pointerBits: u32) -> Option<u64> {
  let bits = match move integerBits(ty, pointerBits) {
    Option<u32>.Some {value} => value
    Option<u32>.None => {
      return Option.none<u64>()
    }
  }
  if sign == Sign.Negative && !signed(ty) {
    return Option.none<u64>()
  }
  if !signed(ty) {
    if bits == 64 {
      return Option.some<u64>(u64.MAX)
    }
    return Option.some<u64>(u64.subtract(u64.shiftLeft(1, u32.toU64(bits)), 1))
  }
  if sign == Sign.Negative {
    return Option.some<u64>(u64.shiftLeft(1, u32.toU64(bits - 1)))
  }
  return Option.some<u64>(u64.subtract(u64.shiftLeft(1, u32.toU64(bits - 1)), 1))
}

/// Normalize zero and reject values outside the exact selected integer range.
pub fn integer(ty: IntegerType, sign: Sign, magnitude: u64, pointerBits: u32) -> Option<Value> {
  let mut canonical = sign
  if magnitude == 0 {
    canonical = Sign.Positive
  }
  let limit = match move integerLimit(ty, canonical, pointerBits) {
    Option<u64>.Some {value} => value
    Option<u64>.None => {
      return Option.none<Value>()
    }
  }
  if magnitude > limit {
    return Option.none<Value>()
  }
  return Option.some<Value>(Value.Integer {ty: ty, sign: canonical, magnitude: magnitude})
}

/// Construct one validated scalar enum member while retaining its nominal identity.
pub fn enumeration(
  declaration: Shared<DeclarationId>,
  member: usize,
  representation: IntegerType,
  sign: Sign,
  magnitude: u64,
) -> Option<Value> {
  if representation == IntegerType.Usize || representation == IntegerType.Isize {
    return Option.none<Value>()
  }
  if let Option<Value>.None = move integer(representation, sign, magnitude, 64) {
    return Option.none<Value>()
  }
  let mut canonical = sign
  if magnitude == 0 {
    canonical = Sign.Positive
  }
  return Option.some<Value>(
    Value.Enum {
      declaration: move declaration,
      member: member,
      representation: representation,
      sign: canonical,
      magnitude: magnitude,
    },
  )
}

/// Admit exactly one Unicode scalar value.
pub fn character(scalar: u32) -> Option<Value> {
  if scalar > 0x10ffff || (scalar >= 0xd800 && scalar <= 0xdfff) {
    return Option.none<Value>()
  }
  return Option.some<Value>(Value.Character {scalar: scalar})
}

/// Admit complete UTF-8 text without conflating it with a byte view. This checks a static text
/// candidate again after concatenation or slicing, before it can enter the value domain.
pub fn text(bytes: Bytes) -> Option<Value> {
  let mut decoder = Utf8Decoder.make()
  let data = Bytes.asSlice(&bytes)
  let mut at = usize.ZERO
  while at < data.length {
    if let Utf8Step.Invalid {..} = move Utf8Decoder.step(&mut decoder, data[at], at) {
      return Option.none<Value>()
    }
    at = at + usize.ONE
  }
  if Utf8Decoder.pending(&decoder) {
    return Option.none<Value>()
  }
  return Option.some<Value>(Value.Text {bytes: move bytes})
}

fn textLength(value: &Value) -> Option<usize> {
  return match & value.* {
    Value.Text {bytes} => Option.some<usize>(Bytes.length(&bytes))
    _ => Option.none<usize>()
  }
}

fn copyTextInto(value: &Value, output: &mut Bytes) -> bool {
  return match & value.* {
    Value.Text {bytes} => {
      let source = Bytes.asSlice(&bytes)
      let mut target = Bytes.asMutSlice(&mut output.*)
      if source.length != target.length {
        return false
      }
      let mut at = usize.ZERO
      while at < source.length {
        target[at] = source[at]
        at = at + usize.ONE
      }
      return true
    }
    _ => false
  }
}

/// Copy text from a shared value into independent owned bytes for a diagnostic or output sink.
pub effect fn textBytes(value: &Shared<Value>) -> Option<Bytes>
! OutOfMemoryError
? &mut Allocator {
  let length = Shared.with<Value, Option<usize>>(value, textLength)
  let count = match move length {
    Option<usize>.Some {value: measured} => measured
    Option<usize>.None => {
      return Option.none<Bytes>()
    }
  }
  let mut output = run Bytes.zeroed(count)
  let copied = Shared.with<Value, bool>(value, fn(found: &Value) -> bool {
    return copyTextInto(found, &mut output)
  })
  if !copied {
    return Option.none<Bytes>()
  }
  return Option.some<Bytes>(move output)
}

/// These type forms contain execution or an address even if their current payload looks inert.
/// Nominal structural eligibility awaits M2.5's validated cleanup proof, including empty types.
pub fn intrinsicallyForbidden(ty: &SemanticType) -> bool {
  return match & ty.* {
    SemanticType.Reference {..} => true
    SemanticType.Slice {..} => true
    SemanticType.Pointer {..} => true
    SemanticType.Callable {..} => true
    SemanticType.Effect {..} => true
    SemanticType.CallableValue {..} => true
    SemanticType.CallableSchema {..} => true
    SemanticType.CallableStage {..} => true
    SemanticType.OpaqueRepresentation {..} => true
    SemanticType.Nominal {..} => true
    SemanticType.Anonymous {..} => true
    SemanticType.Array {element, ..} => Shared.with<SemanticType, bool>(&element, intrinsicallyForbidden)
    _ => false
  }
}

fn isDescriptor(ty: &SemanticType) -> bool {
  return match & ty.* {
    SemanticType.TypeDescriptor {..} => true
    _ => false
  }
}

/// The phase-only descriptor of `owner`, as produced by `Intrinsic.reflectType<Owner>()`.
pub effect fn descriptor(owner: Shared<SemanticType>) -> Value ! OutOfMemoryError ? &mut Allocator {
  return Value.Aggregate {
    ty: run Shared.make<SemanticType>(SemanticType.TypeDescriptor {owner: move owner}),
    variant: Option.none<usize>(),
    fields: Vector.make<Shared<Value>>(),
    admission: Option.none<ArrayAdmission>(),
  }
}

/// Check the recursively immutable value domain before sharing an aggregate child.
pub fn pure(value: &Value) -> bool {
  return match & value.* {
    Value.Sequence {ty, elements, ..} => {
      let sequenceType = Shared.with<SemanticType, Option<Shared<SemanticType>>>(&ty, CheckedIntrinsic.staticSequenceElement)
      if let Option<Shared<SemanticType>>.None = move sequenceType { return false }
      let entries = Vector.asSlice<Shared<Value>>(&elements)
      let mut at = usize.ZERO
      while at < entries.length {
        if !Shared.with<Value, bool>(&entries[at], sequenceScalar) { return false }
        at = at + usize.ONE
      }
      return true
    }
    Value.Aggregate {ty, variant, fields, admission} => {
      // A reflected `Intrinsic.Type<Owner>` descriptor is an inert, field-free phase-only value.
      if Shared.with<SemanticType, bool>(&ty, isDescriptor) {
        let hasVariant = match & variant {
          Option<usize>.Some {..} => true
          Option<usize>.None => false
        }
        return !hasVariant && Vector.length<Shared<Value>>(&fields) == usize.ZERO
      }
      let checked = match & admission {
        Option<ArrayAdmission>.Some {value: proof} => proof.length
        Option<ArrayAdmission>.None => {
          return false
        }
      }
      if Shared.with<SemanticType, bool>(&ty, intrinsicallyForbidden) {
        return false
      }
      let length = Shared.with<SemanticType, Option<usize>>(&ty, fn(ty: &SemanticType) -> Option<usize> {
        return match & ty.* {
          SemanticType.Array {extent, ..} => arrayLength(Bytes.asSlice(&extent))
          _ => Option.none<usize>()
        }
      })
      let expected = match move length {
        Option<usize>.Some {value: count} => count
        Option<usize>.None => {
          return false
        }
      }
      if expected != checked || expected != Vector.length<Shared<Value>>(&fields) {
        return false
      }
      let hasVariant = match & variant {
        Option<usize>.Some {..} => true
        Option<usize>.None => false
      }
      if hasVariant {
        return false
      }
      let children = Vector.asSlice<Shared<Value>>(&fields)
      let mut at = usize.ZERO
      while at < children.length {
        if !Shared.with<Value, bool>(&children[at], pure) {
          return false
        }
        at = at + usize.ONE
      }
      return true
    }
    _ => true
  }
}

fn matchesPrimitive(name: &[u8], value: &Value) -> bool {
  return match &value.* {
    Value.Unit => sameBytes(name, b"unit")
    Value.Boolean {..} => sameBytes(name, b"bool")
    Value.Character {..} => sameBytes(name, b"char")
    Value.Text {..} => sameBytes(name, b"string")
    Value.Float {ty, ..} => (ty == FloatType.F32 && sameBytes(name, b"f32")) ||
      (ty == FloatType.F64 && sameBytes(name, b"f64"))
    Value.Integer {ty, ..} => match ty {
      IntegerType.U8 => sameBytes(name, b"u8")
      IntegerType.U16 => sameBytes(name, b"u16")
      IntegerType.U32 => sameBytes(name, b"u32")
      IntegerType.U64 => sameBytes(name, b"u64")
      IntegerType.Usize => sameBytes(name, b"usize")
      IntegerType.I8 => sameBytes(name, b"i8")
      IntegerType.I16 => sameBytes(name, b"i16")
      IntegerType.I32 => sameBytes(name, b"i32")
      IntegerType.I64 => sameBytes(name, b"i64")
      IntegerType.Isize => sameBytes(name, b"isize")
    }
    _ => false
  }
}

fn scalarMatchesType(value: &Value, declared: &SemanticType) -> bool {
  return match &declared.* {
    SemanticType.Primitive {name} => matchesPrimitive(Bytes.asSlice(&name), value)
    SemanticType.Unit => match &value.* {
      Value.Unit => true
      _ => false
    }
    SemanticType.String {..} => match &value.* {
      Value.Text {..} => true
      _ => false
    }
    SemanticType.Nominal {declaration, arguments, ..} => match &value.* {
      Value.Enum {declaration: actual, ..} => Vector.length<Argument>(&arguments) == usize.ZERO &&
        DeclarationId.kind(&declaration) == OwnerKind.Enumeration &&
        declarationWith(&declaration, &actual)
      _ => false
    }
    _ => false
  }
}

effect fn matchesCheckedType(value: &Shared<Value>, declared: &Shared<SemanticType>) -> bool
! OutOfMemoryError
? &mut Allocator {
  let sequence = Shared.with<Value, Option<Shared<SemanticType>>>(value, fn(actual: &Value) -> Option<Shared<SemanticType>> {
    return match &actual.* { Value.Sequence {ty, ..} => Option.some<Shared<SemanticType>>(Shared.clone<SemanticType>(&ty)) _ => Option.none<Shared<SemanticType>>() }
  })
  if let Option<Shared<SemanticType>>.Some {value: actual} = move sequence {
    if !run SemanticType.equalsShared(&actual, declared) { return false }
    let element = Shared.with<SemanticType, Option<Shared<SemanticType>>>(declared, CheckedIntrinsic.staticSequenceElement)
    let exact = match move element { Option<Shared<SemanticType>>.Some {value: selected} => move selected Option<Shared<SemanticType>>.None => { return false } }
    let count = Shared.with<Value, usize>(value, sequenceLength)
    let mut at = usize.ZERO
    while at < count {
      let child = Shared.with<Value, Option<Shared<Value>>>(value, fn(actual: &Value) -> Option<Shared<Value>> { return sequenceElement(actual, at) })
      let next = match move child { Option<Shared<Value>>.Some {value: selected} => move selected Option<Shared<Value>>.None => { return false } }
      let matches = run matchesCheckedType(&next, &exact)
    if !matches { return false }
      at = at + usize.ONE
    }
    return true
  }
  let aggregate = Shared.with<Value, Option<Shared<SemanticType>>>(value, fn(actual: &Value) -> Option<Shared<SemanticType>> {
    return match &actual.* {
      Value.Aggregate {ty, ..} => Option.some<Shared<SemanticType>>(Shared.clone<SemanticType>(&ty))
      _ => Option.none<Shared<SemanticType>>()
    }
  })
  if let Option<Shared<SemanticType>>.Some {value: actual} = move aggregate {
    if !run SemanticType.equalsShared(&actual, declared) { return false }
    if Shared.with<SemanticType, bool>(declared, isDescriptor) { return true }
    let element = Shared.with<SemanticType, Option<Shared<SemanticType>>>(declared, fn(expected: &SemanticType) -> Option<Shared<SemanticType>> {
      return match &expected.* {
        SemanticType.Array {element, ..} => Option.some<Shared<SemanticType>>(Shared.clone<SemanticType>(&element))
        _ => Option.none<Shared<SemanticType>>()
      }
    })
    let childType = match move element {
      Option<Shared<SemanticType>>.Some {value: selected} => move selected
      Option<Shared<SemanticType>>.None => { return false }
    }
    let count = Shared.with<Value, usize>(value, fn(actual: &Value) -> usize {
      return match &actual.* {
        Value.Aggregate {fields, ..} => Vector.length<Shared<Value>>(&fields)
        _ => usize.ZERO
      }
    })
    let mut at = usize.ZERO
    while at < count {
      let child = Shared.with<Value, Option<Shared<Value>>>(value, fn(actual: &Value) -> Option<Shared<Value>> {
        return field(actual, at)
      })
      let next = match move child {
        Option<Shared<Value>>.Some {value: selected} => move selected
        Option<Shared<Value>>.None => { return false }
      }
      if !run matchesCheckedType(&next, &childType) { return false }
      at = at + usize.ONE
    }
    return true
  }
  return Shared.with<SemanticType, bool>(declared, fn(expected: &SemanticType) -> bool {
    return scalarSharedMatchesType(value, expected)
  })
}

fn scalarSharedMatchesType(value: &Shared<Value>, declared: &SemanticType) -> bool {
  return Shared.with<Value, bool>(value, fn(actual: &Value) -> bool {
    return scalarMatchesType(actual, declared)
  })
}

/// Admits a pure static value against a resolved declaration type. Alias spellings are absent from
/// the canonical type; enum declarations and each fixed-array element retain exact identities.
pub effect fn matchesType(value: &Shared<Value>, declared: &Shared<SemanticType>) -> bool
! OutOfMemoryError
? &mut Allocator {
  if !Shared.with<Value, bool>(value, pure) { return false }
  return run matchesCheckedType(value, declared)
}

fn arrayLength(extent: &[u8]) -> Option<usize> {
  if extent.length == usize.ZERO {
    return Option.none<usize>()
  }
  let mut length = usize.ZERO
  let mut at = usize.ZERO
  while at < extent.length {
    if extent[at] < 48 || extent[at] > 57 {
      return Option.none<usize>()
    }
    length = match move usize.checkedMultiply(length, 10) {
      Option<usize>.Some {value} => value
      Option<usize>.None => {
        return Option.none<usize>()
      }
    }
    length = match move usize.checkedAdd(length, u8.toUsize(extent[at] - 48)) {
      Option<usize>.Some {value} => value
      Option<usize>.None => {
        return Option.none<usize>()
      }
    }
    at = at + usize.ONE
  }
  return Option.some<usize>(length)
}

/// Construct a fixed array from already admitted child values. No child address or mutable place
/// is retained. Nominal values are Unsupported until M2.5 proves cleanup freedom.
pub fn aggregate(ty: Shared<SemanticType>, variant: Option<usize>, fields: Vector<Shared<Value>>) -> Option<
  Value,
> {
  if Shared.with<SemanticType, bool>(&ty, intrinsicallyForbidden) {
    return Option.none<Value>()
  }
  let count = Vector.length<Shared<Value>>(&fields)
  let noVariant = match & variant {
    Option<usize>.None => true
    Option<usize>.Some {..} => false
  }
  let shape = Shared.with<SemanticType, bool>(
    &ty,
    fn(value: &SemanticType) -> bool {
      return match & value.* {
        SemanticType.Array {extent, ..} => {
          if !noVariant {
            return false
          }
          return match move arrayLength(Bytes.asSlice(&extent)) {
            Option<usize>.Some {value: length} => length == count
            Option<usize>.None => false
          }
        }
        _ => false
      }
    },
  )
  if !shape {
    return Option.none<Value>()
  }
  let children = Vector.asSlice<Shared<Value>>(&fields)
  let mut at = usize.ZERO
  while at < children.length {
    if !Shared.with<Value, bool>(&children[at], pure) {
      return Option.none<Value>()
    }
    at = at + usize.ONE
  }
  return Option.some<Value>(
    Value.Aggregate {
      ty: move ty,
      variant: move variant,
      fields: move fields,
      admission: Option.some<ArrayAdmission>(ArrayAdmission {length: count}),
    },
  )
}

/// Construct an array representation after checking its extent. Children may be construction-only
/// configuration nominals; U7 must prove the complete portable Shape before publishing this value.
pub fn fixedArray(ty: Shared<SemanticType>, fields: Vector<Shared<Value>>) -> Option<Value> {
  let count = Vector.length<Shared<Value>>(&fields)
  let shape = Shared.with<SemanticType, bool>(&ty, fn(value: &SemanticType) -> bool {
    return match & value.* {
      SemanticType.Array {extent, ..} => match move arrayLength(Bytes.asSlice(&extent)) {
        Option<usize>.Some {value: length} => length == count
        Option<usize>.None => false
      }
      _ => false
    }
  })
  if !shape {
    return Option.none<Value>()
  }
  return Option.some<Value>(Value.Aggregate {
    ty: move ty,
    variant: Option.none<usize>(),
    fields: move fields,
    admission: Option.none<ArrayAdmission>(),
  })
}

fn unadmittedNominal(ty: Shared<SemanticType>, variant: Option<usize>, fields: Vector<Shared<Value>>) -> Value {
  return Value.Aggregate {
    ty: move ty,
    variant: move variant,
    fields: move fields,
    admission: Option.none<ArrayAdmission>(),
  }
}

/// Construct a record representation. U7 must prove its portable Shape before publication;
/// this value is never admitted by general static evaluation.
pub fn record(ty: Shared<SemanticType>, fields: Vector<Shared<Value>>) -> Value {
  return unadmittedNominal(move ty, Option.none<usize>(), move fields)
}

/// Construct a tuple representation under the same portable Shape boundary.
pub fn tupleValue(ty: Shared<SemanticType>, fields: Vector<Shared<Value>>) -> Value {
  return unadmittedNominal(move ty, Option.none<usize>(), move fields)
}

/// Construct one union variant by its validated case ordinal.
pub fn unionVariant(ty: Shared<SemanticType>, ordinal: usize, fields: Vector<Shared<Value>>) -> Value {
  return unadmittedNominal(move ty, Option.some<usize>(ordinal), move fields)
}

/// Construct an optional case by its validated case ordinal (including an empty None case).
pub fn optionalVariant(ty: Shared<SemanticType>, ordinal: usize, fields: Vector<Shared<Value>>) -> Value {
  return unadmittedNominal(move ty, Option.some<usize>(ordinal), move fields)
}

/// Admit a bit-exact float. An f32 value has no bits above its 32-bit representation.
pub fn floating(ty: FloatType, bits: u64) -> Option<Value> {
  if ty == FloatType.F32 && bits > 0xffffffff {
    return Option.none<Value>()
  }
  return Option.some<Value>(Value.Float {ty: ty, bits: bits})
}

/// Round one authored decimal directly to binary32 and retain its exact bits.
pub fn f32Literal(module: &Module, spelling: Symbol) -> Result<Value, ParseError> {
  return match move FloatingLiteral.f32Bits(module, spelling) {
    Result<u32, ParseError>.Success {value: bits} => Result.succeed<Value, ParseError>(
      Value.Float {ty: FloatType.F32, bits: u32.toU64(bits)},
    )
    Result<u32, ParseError>.Failure {error} => Result.failResult<Value, ParseError>(move error)
  }
}

/// Round one authored decimal directly to binary64 and retain its exact bits.
pub fn f64Literal(module: &Module, spelling: Symbol) -> Result<Value, ParseError> {
  return match move FloatingLiteral.f64Bits(module, spelling) {
    Result<u64, ParseError>.Success {value: bits} => Result.succeed<Value, ParseError>(
      Value.Float {ty: FloatType.F64, bits: bits},
    )
    Result<u64, ParseError>.Failure {error} => Result.failResult<Value, ParseError>(move error)
  }
}

/// Borrow one field without giving the caller an address or mutable place.
pub fn field(value: &Value, ordinal: usize) -> Option<Shared<Value>> {
  return match & value.* {
    Value.Aggregate {fields, ..} => {
      let values = Vector.asSlice<Shared<Value>>(&fields)
      if ordinal >= values.length {
        return Option.none<Shared<Value>>()
      }
      return Option.some<Shared<Value>>(Shared.clone<Value>(&values[ordinal]))
    }
    _ => Option.none<Shared<Value>>()
  }
}

fn success(value: Value) -> Result<Value, Fault> {
  return Result.succeed<Value, Fault>(move value)
}

fn failure(reason: Fault) -> Result<Value, Fault> {
  return Result.failResult<Value, Fault>(reason)
}

fn integerResult(ty: IntegerType, sign: Sign, magnitude: u64, pointerBits: u32) -> Result<
  Value,
  Fault,
> {
  return match move integer(ty, sign, magnitude, pointerBits) {
    Option<Value>.Some {value} => success(move value)
    Option<Value>.None => failure(Fault.Overflow)
  }
}

fn opposite(sign: Sign) -> Sign {
  if sign == Sign.Negative {
    return Sign.Positive
  }
  return Sign.Negative
}

fn sum(ty: IntegerType, leftSign: Sign, left: u64, rightSign: Sign, right: u64, pointerBits: u32) -> Result<
  Value,
  Fault,
> {
  if leftSign == rightSign {
    return match move u64.checkedAdd(left, right) {
      Option<u64>.Some {value} => integerResult(ty, leftSign, value, pointerBits)
      Option<u64>.None => failure(Fault.Overflow)
    }
  }
  if left >= right {
    return integerResult(ty, leftSign, u64.subtract(left, right), pointerBits)
  }
  return integerResult(ty, rightSign, u64.subtract(right, left), pointerBits)
}

fn compareIntegers(leftSign: Sign, left: u64, rightSign: Sign, right: u64) -> i32 {
  if leftSign != rightSign {
    if leftSign == Sign.Negative {
      return -1
    }
    return 1
  }
  if left == right {
    return 0
  }
  if (left < right) == (leftSign == Sign.Positive) {
    return -1
  }
  return 1
}

fn ordered(operator: InfixOperator, comparison: i32) -> Result<Value, Fault> {
  let result = match operator {
    InfixOperator.Equals => comparison == 0
    InfixOperator.NotEquals => comparison != 0
    InfixOperator.LessThan => comparison < 0
    InfixOperator.LessOrEqual => comparison <= 0
    InfixOperator.GreaterThan => comparison > 0
    InfixOperator.GreaterOrEqual => comparison >= 0
    _ => {
      return failure(Fault.InvalidOperands)
    }
  }
  return success(Value.Boolean {value: result})
}

fn integerPattern(sign: Sign, magnitude: u64) -> u64 {
  if sign == Sign.Negative {
    return u64.wrappingSubtract(0, magnitude)
  }
  return magnitude
}

fn fromPattern(ty: IntegerType, pattern: u64, pointerBits: u32) -> Result<Value, Fault> {
  let bits = match move integerBits(ty, pointerBits) {
    Option<u32>.Some {value} => value
    Option<u32>.None => {
      return failure(Fault.InvalidOperands)
    }
  }
  let mut mask = u64.MAX
  if bits != 64 {
    mask = u64.subtract(u64.shiftLeft(1, u32.toU64(bits)), 1)
  }
  let truncated = u64.bitAnd(pattern, mask)
  if signed(ty) && u64.bitAnd(truncated, u64.shiftLeft(1, u32.toU64(bits - 1))) != 0 {
    return integerResult(
      ty,
      Sign.Negative,
      u64.bitAnd(u64.wrappingSubtract(0, truncated), mask),
      pointerBits,
    )
  }
  return integerResult(ty, Sign.Positive, truncated, pointerBits)
}

fn integerPrefix(
  operator: PrefixOperator,
  ty: IntegerType,
  sign: Sign,
  magnitude: u64,
  pointerBits: u32,
) -> Result<Value, Fault> {
  return match operator {
    PrefixOperator.Negate => {
      if !signed(ty) {
        return failure(Fault.InvalidOperands)
      }
      return integerResult(ty, opposite(sign), magnitude, pointerBits)
    }
    PrefixOperator.BitwiseNot => fromPattern(
      ty,
      u64.bitNot(integerPattern(sign, magnitude)),
      pointerBits,
    )
    PrefixOperator.Not => failure(Fault.InvalidOperands)
  }
}

// The sign shared by a product and a quotient: positive exactly when the operand signs agree.
fn quotientSign(leftSign: Sign, rightSign: Sign) -> Sign {
  if leftSign == rightSign {
    return Sign.Positive
  }
  return Sign.Negative
}

// MIN % -1 traps alongside MIN / -1, even though the mathematical remainder is zero.
fn remainderTraps(
  ty: IntegerType,
  leftSign: Sign,
  left: u64,
  rightSign: Sign,
  right: u64,
  pointerBits: u32,
) -> bool {
  if !(signed(ty) && leftSign == Sign.Negative && rightSign == Sign.Negative && right == 1) {
    return false
  }
  if let Option<u64>.Some {value: minimumMagnitude} = move integerLimit(
    ty,
    Sign.Negative,
    pointerBits,
  ) {
    return left == minimumMagnitude
  }
  return false
}

fn integerInfix(
  operator: InfixOperator,
  ty: IntegerType,
  leftSign: Sign,
  left: u64,
  rightSign: Sign,
  right: u64,
  pointerBits: u32,
) -> Result<Value, Fault> {
  match operator {
    InfixOperator.Add => {
      return sum(ty, leftSign, left, rightSign, right, pointerBits)
    }
    InfixOperator.Subtract => {
      return sum(ty, leftSign, left, opposite(rightSign), right, pointerBits)
    }
    InfixOperator.Multiply => {
      if let Option<u64>.Some {value} = move u64.checkedMultiply(left, right) {
        return integerResult(ty, quotientSign(leftSign, rightSign), value, pointerBits)
      }
      return failure(Fault.Overflow)
    }
    InfixOperator.Divide => {
      if right == 0 {
        return failure(Fault.DivisionByZero)
      }
      return integerResult(
        ty,
        quotientSign(leftSign, rightSign),
        u64.divide(left, right),
        pointerBits,
      )
    }
    InfixOperator.Remainder => {
      if right == 0 {
        return failure(Fault.DivisionByZero)
      }
      if remainderTraps(ty, leftSign, left, rightSign, right, pointerBits) {
        return failure(Fault.Overflow)
      }
      return integerResult(ty, leftSign, u64.remainder(left, right), pointerBits)
    }
    InfixOperator.BitAnd => {
      return fromPattern(
        ty,
        u64.bitAnd(integerPattern(leftSign, left), integerPattern(rightSign, right)),
        pointerBits,
      )
    }
    InfixOperator.BitOr => {
      return fromPattern(
        ty,
        u64.bitOr(integerPattern(leftSign, left), integerPattern(rightSign, right)),
        pointerBits,
      )
    }
    InfixOperator.BitXor => {
      return fromPattern(
        ty,
        u64.bitXor(integerPattern(leftSign, left), integerPattern(rightSign, right)),
        pointerBits,
      )
    }
    _ => {
      return ordered(operator, compareIntegers(leftSign, left, rightSign, right))
    }
  }
}

/// Evaluate a concrete unary scalar operator. The evaluator checks the typed operand contract
/// before this call; the result here still rejects mismatched value forms defensively.
pub fn prefix(operator: PrefixOperator, operand: &Value, pointerBits: u32) -> Result<Value, Fault> {
  return match & operand.* {
    Value.Integer {ty, sign, magnitude} => integerPrefix(operator, ty, sign, magnitude, pointerBits)
    Value.Boolean {value} => {
      if operator == PrefixOperator.Not {
        return success(Value.Boolean {value: !value})
      }
      return failure(Fault.InvalidOperands)
    }
    Value.Float {ty, bits} => {
      if operator != PrefixOperator.Negate {
        return failure(Fault.InvalidOperands)
      }
      let mut signBit: u64 = 0x8000000000000000
      if ty == FloatType.F32 {
        signBit = 0x80000000
      }
      return match move floating(ty, u64.bitXor(bits, signBit)) {
        Option<Value>.Some {value} => success(move value)
        Option<Value>.None => failure(Fault.InvalidOperands)
      }
    }
    _ => failure(Fault.InvalidOperands)
  }
}

fn float32Infix(operator: InfixOperator, leftBits: u64, rightBits: u64) -> Result<Value, Fault> {
  let left = f32.fromBits(u64.toU32(leftBits))
  let right = f32.fromBits(u64.toU32(rightBits))
  let result = match operator {
    InfixOperator.Add => f32.add(left, right)
    InfixOperator.Subtract => f32.subtract(left, right)
    InfixOperator.Multiply => f32.multiply(left, right)
    InfixOperator.Divide => f32.divide(left, right)
    InfixOperator.Remainder => f32.remainder(left, right)
    InfixOperator.Equals => {
      return success(Value.Boolean {value: left == right})
    }
    InfixOperator.NotEquals => {
      return success(Value.Boolean {value: left != right})
    }
    InfixOperator.LessThan => {
      return success(Value.Boolean {value: left < right})
    }
    InfixOperator.LessOrEqual => {
      return success(Value.Boolean {value: left <= right})
    }
    InfixOperator.GreaterThan => {
      return success(Value.Boolean {value: left > right})
    }
    InfixOperator.GreaterOrEqual => {
      return success(Value.Boolean {value: left >= right})
    }
    _ => {
      return failure(Fault.InvalidOperands)
    }
  }
  return match move floating(FloatType.F32, u32.toU64(f32.toBits(result))) {
    Option<Value>.Some {value} => success(move value)
    Option<Value>.None => failure(Fault.InvalidOperands)
  }
}

fn float64Infix(operator: InfixOperator, leftBits: u64, rightBits: u64) -> Result<Value, Fault> {
  let left = f64.fromBits(leftBits)
  let right = f64.fromBits(rightBits)
  let result = match operator {
    InfixOperator.Add => f64.add(left, right)
    InfixOperator.Subtract => f64.subtract(left, right)
    InfixOperator.Multiply => f64.multiply(left, right)
    InfixOperator.Divide => f64.divide(left, right)
    InfixOperator.Remainder => f64.remainder(left, right)
    InfixOperator.Equals => {
      return success(Value.Boolean {value: left == right})
    }
    InfixOperator.NotEquals => {
      return success(Value.Boolean {value: left != right})
    }
    InfixOperator.LessThan => {
      return success(Value.Boolean {value: left < right})
    }
    InfixOperator.LessOrEqual => {
      return success(Value.Boolean {value: left <= right})
    }
    InfixOperator.GreaterThan => {
      return success(Value.Boolean {value: left > right})
    }
    InfixOperator.GreaterOrEqual => {
      return success(Value.Boolean {value: left >= right})
    }
    _ => {
      return failure(Fault.InvalidOperands)
    }
  }
  return match move floating(FloatType.F64, f64.toBits(result)) {
    Option<Value>.Some {value} => success(move value)
    Option<Value>.None => failure(Fault.InvalidOperands)
  }
}

fn sameBytes(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

fn declarationWith(first: &DeclarationId, second: &Shared<DeclarationId>) -> bool {
  return Shared.with<DeclarationId, bool>(
    second,
    fn(other: &DeclarationId) -> bool {
      return DeclarationId.equals(first, other)
    },
  )
}

fn declarationAddress(value: &DeclarationId) -> usize {
  return Pointer.address<DeclarationId>(Pointer.fromRef<DeclarationId>(value))
}

fn valueAddress(value: &Value) -> usize {
  return Pointer.address<Value>(Pointer.fromRef<Value>(value))
}

fn sameDeclaration(left: &Shared<DeclarationId>, right: &Shared<DeclarationId>) -> bool {
  if Shared.with<DeclarationId, usize>(left, declarationAddress) == Shared.with<
    DeclarationId,
    usize,
  >(right, declarationAddress) {
    return true
  }
  return Shared.with<DeclarationId, bool>(
    left,
    fn(first: &DeclarationId) -> bool {
      return declarationWith(first, right)
    },
  )
}

/// Retain a complete value for another static use without implying runtime `Copy`.
pub fn copy(value: &Shared<Value>) -> Shared<Value> {
  return Shared.clone<Value>(value)
}

fn sameVariant(left: &Option<usize>, right: &Option<usize>) -> bool {
  return match & left.* {
    Option<usize>.Some {value: first} => match & right.* {
      Option<usize>.Some {value: second} => first == second
      Option<usize>.None => false
    }
    Option<usize>.None => match & right.* {
      Option<usize>.Some {..} => false
      Option<usize>.None => true
    }
  }
}

fn immediateEquals(left: &Value, right: &Value) -> bool {
  return match & left.* {
    Value.Unit => match & right.* {
      Value.Unit => true
      _ => false
    }
    Value.Boolean {value: first} => match & right.* {
      Value.Boolean {value: second} => first == second
      _ => false
    }
    Value.Character {scalar: first} => match & right.* {
      Value.Character {scalar: second} => first == second
      _ => false
    }
    Value.Integer {ty: firstType, sign: firstSign, magnitude: firstMagnitude} => match & right.* {
      Value.Integer {ty: secondType, sign: secondSign, magnitude: secondMagnitude} => firstType == secondType && firstSign == secondSign && firstMagnitude == secondMagnitude
      _ => false
    }
    Value.Float {ty: firstType, bits: firstBits} => match & right.* {
      Value.Float {ty: secondType, bits: secondBits} => firstType == secondType && firstBits == secondBits
      _ => false
    }
    Value.Enum {
      declaration: firstDeclaration,
      member: firstMember,
      representation: firstType,
      sign: firstSign,
      magnitude: firstMagnitude,
    } => match & right.* {
      Value.Enum {
        declaration: secondDeclaration,
        member: secondMember,
        representation: secondType,
        sign: secondSign,
        magnitude: secondMagnitude,
      } => sameDeclaration(&firstDeclaration, &secondDeclaration) && firstMember == secondMember && firstType == secondType && firstSign == secondSign && firstMagnitude == secondMagnitude
      _ => false
    }
    Value.Text {bytes: first} => match & right.* {
      Value.Text {bytes: second} => sameBytes(Bytes.asSlice(&first), Bytes.asSlice(&second))
      _ => false
    }
    Value.Sequence {elements: firstElements, ..} => match &right.* {
      Value.Sequence {elements: secondElements, ..} => Vector.length<Shared<Value>>(&firstElements) == Vector.length<Shared<Value>>(&secondElements)
      _ => false
    }
    Value.Aggregate {variant: firstVariant, fields: firstFields, ..} => match & right.* {
      Value.Aggregate {variant: secondVariant, fields: secondFields, ..} => sameVariant(
        &firstVariant,
        &secondVariant,
      ) && Vector.length<Shared<Value>>(&firstFields) == Vector.length<Shared<Value>>(&secondFields)
      _ => false
    }
  }
}

fn immediateWith(first: &Value, right: &Shared<Value>) -> bool {
  return Shared.with<Value, bool>(
    right,
    fn(second: &Value) -> bool {
      return immediateEquals(first, second)
    },
  )
}

fn immediateSharedEquals(left: &Shared<Value>, right: &Shared<Value>) -> bool {
  return Shared.with<Value, bool>(
    left,
    fn(first: &Value) -> bool {
      return immediateWith(first, right)
    },
  )
}

fn aggregateType(value: &Value) -> Option<Shared<SemanticType>> {
  return match & value.* {
    Value.Sequence {ty, ..} => Option.some<Shared<SemanticType>>(Shared.clone<SemanticType>(&ty))
    Value.Aggregate {ty, ..} => Option.some<Shared<SemanticType>>(Shared.clone<SemanticType>(&ty))
    _ => Option.none<Shared<SemanticType>>()
  }
}

fn aggregateLength(value: &Value) -> usize {
  return match & value.* {
    Value.Sequence {elements, ..} => Vector.length<Shared<Value>>(&elements)
    Value.Aggregate {fields, ..} => Vector.length<Shared<Value>>(&fields)
    _ => usize.ZERO
  }
}

fn aggregateChild(value: &Value, at: usize) -> Option<Shared<Value>> {
  if let Value.Sequence {..} = &value.* { return sequenceElement(value, at) }
  if let Value.Aggregate {fields, ..} = &value.* {
    let entries = Vector.asSlice<Shared<Value>>(&fields)
    return Option.some<Shared<Value>>(Shared.clone<Value>(&entries[at]))
  }
  return Option.none<Shared<Value>>()
}

effect fn sharedEquals(left: &Shared<Value>, right: &Shared<Value>) -> bool
! OutOfMemoryError
? &mut Allocator {
  if Shared.with<Value, usize>(left, valueAddress) == Shared.with<Value, usize>(right, valueAddress) {
    return true
  }
  if !immediateSharedEquals(left, right) {
    return false
  }
  let leftType = Shared.with<Value, Option<Shared<SemanticType>>>(left, aggregateType)
  let rightType = Shared.with<Value, Option<Shared<SemanticType>>>(right, aggregateType)
  if let Option<Shared<SemanticType>>.Some {value: firstType} = move leftType {
    if let Option<Shared<SemanticType>>.Some {value: secondType} = move rightType {
      if !run SemanticType.equalsShared(&firstType, &secondType) {
        return false
      }
      let length = Shared.with<Value, usize>(left, aggregateLength)
      let mut at = usize.ZERO
      while at < length {
        let firstChild = Shared.with<Value, Option<Shared<Value>>>(
          left,
          fn(value: &Value) -> Option<Shared<Value>> {
            return aggregateChild(value, at)
          },
        )
        let secondChild = Shared.with<Value, Option<Shared<Value>>>(
          right,
          fn(value: &Value) -> Option<Shared<Value>> {
            return aggregateChild(value, at)
          },
        )
        let first = match move firstChild {
          Option<Shared<Value>>.Some {value} => move value
          Option<Shared<Value>>.None => {
            return false
          }
        }
        let second = match move secondChild {
          Option<Shared<Value>>.Some {value} => move value
          Option<Shared<Value>>.None => {
            return false
          }
        }
        if !run sharedEquals(&first, &second) {
          return false
        }
        at = at + usize.ONE
      }
    }
  }
  return true
}

/// Canonical structural identity, including nominal aggregate types and every nested child.
pub effect fn equals(left: &Shared<Value>, right: &Shared<Value>) -> bool
! OutOfMemoryError
? &mut Allocator {
  return run sharedEquals(left, right)
}

struct Immediate {
  kind: u64
  first: u64
  second: u64
  third: u64
  fourth: u64
}

fn word(flag: bool) -> u64 {
  if flag { return 1 }
  return 0
}

fn integerTag(ty: IntegerType) -> u64 {
  return match ty {
    IntegerType.U8 => 0
    IntegerType.U16 => 1
    IntegerType.U32 => 2
    IntegerType.U64 => 3
    IntegerType.Usize => 4
    IntegerType.I8 => 5
    IntegerType.I16 => 6
    IntegerType.I32 => 7
    IntegerType.I64 => 8
    IntegerType.Isize => 9
  }
}

fn floatTag(ty: FloatType) -> u64 {
  return match ty {
    FloatType.F32 => 0
    FloatType.F64 => 1
  }
}

fn signTag(sign: Sign) -> u64 {
  return match sign {
    Sign.Positive => 0
    Sign.Negative => 1
  }
}

fn immediate(value: &Value) -> Immediate {
  return match & value.* {
    Value.Unit => Immediate {kind: 0, first: 0, second: 0, third: 0, fourth: 0}
    Value.Boolean {value: flag} => Immediate {kind: 1, first: word(flag), second: 0, third: 0, fourth: 0}
    Value.Character {scalar} => Immediate {kind: 2, first: u32.toU64(scalar), second: 0, third: 0, fourth: 0}
    Value.Integer {ty, sign, magnitude} => Immediate {kind: 3, first: integerTag(ty), second: signTag(sign), third: magnitude, fourth: 0}
    Value.Float {ty, bits} => Immediate {kind: 4, first: floatTag(ty), second: bits, third: 0, fourth: 0}
    Value.Enum {member, representation, sign, magnitude, ..} => Immediate {
      kind: 5, first: usize.toU64(member), second: integerTag(representation), third: signTag(sign), fourth: magnitude,
    }
    Value.Text {..} => Immediate {kind: 6, first: 0, second: 0, third: 0, fourth: 0}
    Value.Sequence {..} => Immediate {kind: 8, first: 0, second: 0, third: 0, fourth: 0}
    Value.Aggregate {variant, ..} => match & variant {
      Option<usize>.Some {value: index} => Immediate {kind: 7, first: 1, second: usize.toU64(index), third: 0, fourth: 0}
      Option<usize>.None => Immediate {kind: 7, first: 0, second: 0, third: 0, fourth: 0}
    }
  }
}

fn enumDeclaration(value: &Value) -> Option<Shared<DeclarationId>> {
  return match & value.* {
    Value.Enum {declaration, ..} => Option.some<Shared<DeclarationId>>(Shared.clone<DeclarationId>(&declaration))
    _ => Option.none<Shared<DeclarationId>>()
  }
}

effect fn appendRuntime(
  output: &mut Bytes,
  value: &Shared<Value>,
  owner: &DeclarationId,
  exact: bool,
  coordinates: &mut Coordinates,
) -> () ! OutOfMemoryError ? &mut Allocator {
  if coordinates.exceeded { return () }
  let head = Shared.with<Value, Immediate>(value, immediate)
  run RuntimeEncoding.recordWord(&mut output.*, head.kind, &mut coordinates.*)
  run RuntimeEncoding.recordWord(&mut output.*, head.first, &mut coordinates.*)
  run RuntimeEncoding.recordWord(&mut output.*, head.second, &mut coordinates.*)
  run RuntimeEncoding.recordWord(&mut output.*, head.third, &mut coordinates.*)
  run RuntimeEncoding.recordWord(&mut output.*, head.fourth, &mut coordinates.*)
  let enumOwner = Shared.with<Value, Option<Shared<DeclarationId>>>(value, enumDeclaration)
  if let Option<Shared<DeclarationId>>.Some {value: declaration} = move enumOwner {
    let affordable = Shared.with<DeclarationId, bool>(&declaration,
      fn(identity: &DeclarationId) -> bool { return RuntimeEncoding.recordPayload(&mut coordinates.*, RuntimeEncoding.declarationPayload(identity)) })
    if !affordable { return () }
    let identity = run DeclarationId.copyShared(&declaration)
    run RuntimeEncoding.recordDeclaration(&mut output.*, &identity, &mut coordinates.*)
  }
  let copiedTextLength = Shared.with<Value, Option<usize>>(value, textLength)
  if let Option<usize>.Some {value: count} = move copiedTextLength {
    if !RuntimeEncoding.recordPayload(&mut coordinates.*, count) { return () }
  }
  let decoded = run textBytes(value)
  if let Option<Bytes>.Some {value: text} = move decoded {
    run RuntimeEncoding.recordField(&mut output.*, Bytes.asSlice(&text), &mut coordinates.*)
  }
  let aggregate = Shared.with<Value, Option<Shared<SemanticType>>>(value, aggregateType)
  if let Option<Shared<SemanticType>>.Some {value: ty} = move aggregate {
    let typeBytes = run SemanticType.encoding(&ty, owner, exact, &mut coordinates.*)
    run RuntimeEncoding.recordField(&mut output.*, Bytes.asSlice(&typeBytes), &mut coordinates.*)
    let length = Shared.with<Value, usize>(value, aggregateLength)
    run RuntimeEncoding.recordWord(&mut output.*, usize.toU64(length), &mut coordinates.*)
    let mut at = usize.ZERO
    while at < length {
      let child = Shared.with<Value, Option<Shared<Value>>>(value, fn(entry: &Value) -> Option<Shared<Value>> {
        return aggregateChild(entry, at)
      })
      if let Option<Shared<Value>>.Some {value: element} = move child {
        let mut nested = Bytes.make()
        run appendRuntime(&mut nested, &element, owner, exact, &mut coordinates.*)
        run RuntimeEncoding.recordField(&mut output.*, Bytes.asSlice(&nested), &mut coordinates.*)
      }
      at = at + usize.ONE
    }
  }
  return ()
}

// Static values retain semantic aggregate types in exact identity. Collection must inspect those
// types and every child even though valid source statics contain no borrowed runtime value.
fn numberingCost(value: &Value, numbering: &mut Numbering) -> bool {
  return match &value.* {
    Value.Text {bytes} => Numbering.bytes(&mut numbering.*, Bytes.length(&bytes))
    Value.Enum {declaration, ..} => Shared.with<DeclarationId, bool>(&declaration,
      fn(identity: &DeclarationId) -> bool {
        if !Numbering.units(&mut numbering.*, DeclarationId.ownerCount(identity)) { return false }
        return Numbering.bytes(&mut numbering.*, RuntimeEncoding.declarationPayload(identity))
      })
    Value.Aggregate {fields, ..} => Numbering.units(&mut numbering.*, Vector.length<Shared<Value>>(&fields))
    Value.Sequence {elements, ..} => Numbering.units(&mut numbering.*, Vector.length<Shared<Value>>(&elements))
    _ => true
  }
}
struct NumberedAggregate {
  ty: Shared<SemanticType>
  variant: Option<usize>
  admission: Option<ArrayAdmission>
}
fn numberingAggregate(value: &Value) -> Option<NumberedAggregate> {
  if let Value.Aggregate {ty, variant, admission, ..} = &value.* {
    let mut proof = Option.none<ArrayAdmission>()
    if let Option<ArrayAdmission>.Some {value: admitted} = &admission {
      proof = Option.some<ArrayAdmission>(ArrayAdmission {length: admitted.length})
    }
    let mut selectedVariant = Option.none<usize>()
    if let Option<usize>.Some {value: selected} = &variant {
      selectedVariant = Option.some<usize>(selected)
    }
    return Option.some<NumberedAggregate>(NumberedAggregate {ty: Shared.clone<SemanticType>(&ty),
      variant: move selectedVariant, admission: move proof})
  }
  return Option.none<NumberedAggregate>()
}
fn numberingSequence(value: &Value) -> Option<Shared<SemanticType>> {
  return match &value.* {
    Value.Sequence {ty, ..} => Option.some<Shared<SemanticType>>(Shared.clone<SemanticType>(&ty))
    _ => Option.none<Shared<SemanticType>>()
  }
}

/// Renames all semantic aggregate and sealed sequence evidence in the enclosing identity transaction.
pub effect fn numberRegions(value: &Shared<Value>, owner: &DeclarationId, numbering: &mut Numbering) -> Shared<Value>
! OutOfMemoryError ? &mut Allocator {
  if !Numbering.isActive(&numbering.*) { return Shared.clone<Value>(value) }
  let address = Shared.with<Value, usize>(value, fn(held: &Value) -> usize {
    return Pointer.address<Value>(Pointer.fromRef<Value>(held))
  })
  let entered = run Numbering.enter(&mut numbering.*, address, 2)
  if !entered { return Shared.clone<Value>(value) }
  let affordable = Shared.with<Value, bool>(value,
    fn(held: &Value) -> bool { return numberingCost(held, &mut numbering.*) })
  if !affordable { Numbering.leave(&mut numbering.*)
    return Shared.clone<Value>(value) }
  let sequence = Shared.with<Value, Option<Shared<SemanticType>>>(value, numberingSequence)
  if let Option<Shared<SemanticType>>.Some {value: originalType} = move sequence {
    let ty = run SemanticType.numberRegions(&originalType, owner, &mut numbering.*)
    let count = Shared.with<Value, usize>(value, sequenceLength)
    let mut elements = Vector.make<Shared<Value>>()
    let mut at = usize.ZERO
    while at < count {
      let child = Shared.with<Value, Option<Shared<Value>>>(value,
        fn(held: &Value) -> Option<Shared<Value>> { return sequenceElement(held, at) })
      if let Option<Shared<Value>>.Some {value: nested} = move child {
        run Vector.append<Shared<Value>>(&mut elements, run numberRegions(&nested, owner, &mut numbering.*))
      }
      let childFailure = Numbering.failure(&numbering.*)
      if let Option<CanonicalizationFailure>.Some {..} = move childFailure { break }
      at = at + usize.ONE
    }
    Numbering.leave(&mut numbering.*)
    if Numbering.isCollecting(&numbering.*) { return Shared.clone<Value>(value) }
    let sequenceFailure = Numbering.failure(&numbering.*)
    if let Option<CanonicalizationFailure>.Some {..} = move sequenceFailure { return Shared.clone<Value>(value) }
    // The source was an admitted Sequence, and only its exact type/children were renamed.
    // SequenceAdmission has no mutable payload and remains owned by this factory actor.
    return run Shared.make<Value>(Value.Sequence {ty: move ty, elements: move elements,
      admission: SequenceAdmission {}})
  }
  let aggregate = Shared.with<Value, Option<NumberedAggregate>>(value, numberingAggregate)
  if let Option<NumberedAggregate>.Some {value: original} = move aggregate {
    let ty = run SemanticType.numberRegions(&original.ty, owner, &mut numbering.*)
    let count = Shared.with<Value, usize>(value, aggregateLength)
    let mut fields = Vector.make<Shared<Value>>()
    let mut at = usize.ZERO
    while at < count {
      let child = Shared.with<Value, Option<Shared<Value>>>(value,
        fn(held: &Value) -> Option<Shared<Value>> { return aggregateChild(held, at) })
      if let Option<Shared<Value>>.Some {value: nested} = move child {
        run Vector.append<Shared<Value>>(&mut fields, run numberRegions(&nested, owner, &mut numbering.*))
      }
      let childFailure = Numbering.failure(&numbering.*)
      if let Option<CanonicalizationFailure>.Some {..} = move childFailure { break }
      at = at + usize.ONE
    }
    Numbering.leave(&mut numbering.*)
    if Numbering.isCollecting(&numbering.*) { return Shared.clone<Value>(value) }
    let aggregateFailure = Numbering.failure(&numbering.*)
    if let Option<CanonicalizationFailure>.Some {..} = move aggregateFailure { return Shared.clone<Value>(value) }
    return run Shared.make<Value>(Value.Aggregate {ty: move ty, variant: move original.variant,
      fields: move fields, admission: move original.admission})
  }
  Numbering.leave(&mut numbering.*)
  return Shared.clone<Value>(value)
}

/// Canonical runtime identity bytes shared by runtime equality, interning and symbol content.
///
/// # Details
/// Every kind carries a stable tag and fixed-width payload: exact integer kind, normalized sign and
/// magnitude; exact float width and original bits (signed zero and NaN payloads stay distinct); the
/// enum's declaration, member and representation; decoded UTF-8 text with its length; and an
/// aggregate's lifetime-erased runtime type, variant presence and recursively encoded fields. No
/// pointer, sharing address, allocation order, HIR index or provenance is encoded. Semantic identity
/// remains [`equals`], which compares aggregate types semantically.
pub effect fn runtimeEncoding(value: &Shared<Value>, owner: &DeclarationId) -> Bytes
! OutOfMemoryError
? &mut Allocator {
  let mut coordinates = RuntimeEncoding.coordinates()
  return run encoding(value, owner, false, &mut coordinates)
}

/// Exact static identity retains semantic type evidence inside aggregate values.
pub effect fn encoding(
  value: &Shared<Value>,
  owner: &DeclarationId,
  exact: bool,
  coordinates: &mut Coordinates,
) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut output = Bytes.make()
  run appendRuntime(&mut output, value, owner, exact, &mut coordinates.*)
  return move output
}

/// Equal runtime projections for two values in the same declaration context.
pub effect fn runtimeEquals(left: &Shared<Value>, right: &Shared<Value>, owner: &DeclarationId) -> bool
! OutOfMemoryError
? &mut Allocator {
  let first = run runtimeEncoding(left, owner)
  let second = run runtimeEncoding(right, owner)
  return RuntimeEncoding.equals(Bytes.asSlice(&first), Bytes.asSlice(&second))
}

fn saturatingAdd(left: usize, right: usize) -> usize {
  return match move usize.checkedAdd(left, right) {
    Option<usize>.Some {value} => value
    Option<usize>.None => usize.MAX
  }
}

/// Conservative retained-byte estimate for bounded static evaluation.
pub fn size(value: &Value) -> usize {
  return match & value.* {
    Value.Text {bytes} => saturatingAdd(16, Bytes.length(&bytes))
    Value.Sequence {elements, ..} => sequenceSize(Vector.asSlice<Shared<Value>>(&elements))
    Value.Aggregate {fields, ..} => {
      let children = Vector.asSlice<Shared<Value>>(&fields)
      let mut total = usize.ZERO + 16
      let mut at = usize.ZERO
      while at < children.length {
        let child = Shared.with<Value, usize>(&children[at], size)
        total = saturatingAdd(total, child)
        at = at + usize.ONE
      }
      return total
    }
    _ => 16
  }
}

fn integerOperandsInfix(
  operator: InfixOperator,
  leftType: IntegerType,
  leftSign: Sign,
  leftMagnitude: u64,
  rightType: IntegerType,
  rightSign: Sign,
  rightMagnitude: u64,
  pointerBits: u32,
) -> Result<Value, Fault> {
  if leftType != rightType {
    return failure(Fault.InvalidOperands)
  }
  return integerInfix(
    operator,
    leftType,
    leftSign,
    leftMagnitude,
    rightSign,
    rightMagnitude,
    pointerBits,
  )
}

fn floatOperandsInfix(
  operator: InfixOperator,
  leftType: FloatType,
  leftBits: u64,
  rightType: FloatType,
  rightBits: u64,
) -> Result<Value, Fault> {
  if leftType != rightType {
    return failure(Fault.InvalidOperands)
  }
  if leftType == FloatType.F32 {
    return float32Infix(operator, leftBits, rightBits)
  }
  return float64Infix(operator, leftBits, rightBits)
}

fn booleanOperandsInfix(operator: InfixOperator, left: bool, right: bool) -> Result<Value, Fault> {
  if operator == InfixOperator.Equals {
    return success(Value.Boolean {value: left == right})
  }
  if operator == InfixOperator.NotEquals {
    return success(Value.Boolean {value: left != right})
  }
  // Short-circuit evaluation reaches here only when the left operand does not decide the result.
  if operator == InfixOperator.And {
    return success(Value.Boolean {value: left && right})
  }
  if operator == InfixOperator.Or {
    return success(Value.Boolean {value: left || right})
  }
  return failure(Fault.InvalidOperands)
}

fn characterOperandsInfix(operator: InfixOperator, left: u32, right: u32) -> Result<Value, Fault> {
  let mut order = 0
  if left < right {
    order = -1
  }
  if left > right {
    order = 1
  }
  return ordered(operator, order)
}

fn textOperandsInfix(operator: InfixOperator, left: &[u8], right: &[u8]) -> Result<Value, Fault> {
  if operator != InfixOperator.Equals && operator != InfixOperator.NotEquals {
    return failure(Fault.InvalidOperands)
  }
  let equal = sameBytes(left, right)
  let mut result = equal
  if operator == InfixOperator.NotEquals {
    result = !equal
  }
  return success(Value.Boolean {value: result})
}

fn enumOperandsInfix(
  operator: InfixOperator,
  leftDeclaration: &Shared<DeclarationId>,
  leftMember: usize,
  rightDeclaration: &Shared<DeclarationId>,
  rightMember: usize,
) -> Result<Value, Fault> {
  if operator != InfixOperator.Equals && operator != InfixOperator.NotEquals {
    return failure(Fault.InvalidOperands)
  }
  let identical = sameDeclaration(leftDeclaration, rightDeclaration)
  if !identical {
    return failure(Fault.InvalidOperands)
  }
  let equal = leftMember == rightMember
  let mut result = equal
  if operator == InfixOperator.NotEquals {
    result = !equal
  }
  return success(Value.Boolean {value: result})
}

/// Evaluate a concrete eager scalar or text operator. `&&` and `||` belong to the control-flow
/// evaluator because their right operand must remain undemanded when the left decides the result.
pub fn infix(operator: InfixOperator, left: &Value, right: &Value, pointerBits: u32) -> Result<
  Value,
  Fault,
> {
  return match & left.* {
    Value.Integer {ty: leftType, sign: leftSign, magnitude: leftMagnitude} => match & right.* {
      Value.Integer {ty: rightType, sign: rightSign, magnitude: rightMagnitude} => {
        return integerOperandsInfix(
          operator,
          leftType,
          leftSign,
          leftMagnitude,
          rightType,
          rightSign,
          rightMagnitude,
          pointerBits,
        )
      }
      _ => failure(Fault.InvalidOperands)
    }
    Value.Float {ty: leftType, bits: leftBits} => match & right.* {
      Value.Float {ty: rightType, bits: rightBits} => {
        return floatOperandsInfix(operator, leftType, leftBits, rightType, rightBits)
      }
      _ => failure(Fault.InvalidOperands)
    }
    Value.Boolean {value: leftValue} => match & right.* {
      Value.Boolean {value: rightValue} => {
        return booleanOperandsInfix(operator, leftValue, rightValue)
      }
      _ => failure(Fault.InvalidOperands)
    }
    Value.Character {scalar: leftScalar} => match & right.* {
      Value.Character {scalar: rightScalar} => {
        return characterOperandsInfix(operator, leftScalar, rightScalar)
      }
      _ => failure(Fault.InvalidOperands)
    }
    Value.Text {bytes: leftBytes} => match & right.* {
      Value.Text {bytes: rightBytes} => {
        return textOperandsInfix(operator, Bytes.asSlice(&leftBytes), Bytes.asSlice(&rightBytes))
      }
      _ => failure(Fault.InvalidOperands)
    }
    Value.Enum {declaration: leftDeclaration, member: leftMember, ..} => match & right.* {
      Value.Enum {declaration: rightDeclaration, member: rightMember, ..} => {
        return enumOperandsInfix(
          operator,
          &leftDeclaration,
          leftMember,
          &rightDeclaration,
          rightMember,
        )
      }
      _ => failure(Fault.InvalidOperands)
    }
    _ => failure(Fault.InvalidOperands)
  }
}

/// Apply a prefix operator to a retained value without exposing a borrow to the caller.
pub fn prefixShared(operator: PrefixOperator, operand: &Shared<Value>, pointerBits: u32) -> Result<
  Value,
  Fault,
> {
  return Shared.with<Value, Result<Value, Fault>>(operand, fn(value: &Value) -> Result<Value, Fault> {
    return prefix(operator, value, pointerBits)
  })
}

fn infixWithRight(
  operator: InfixOperator,
  first: &Value,
  right: &Shared<Value>,
  pointerBits: u32,
) -> Result<Value, Fault> {
  return Shared.with<Value, Result<Value, Fault>>(
    right,
    fn(second: &Value) -> Result<Value, Fault> {
      return infix(operator, first, second, pointerBits)
    },
  )
}

/// Apply an eager operator to retained values, including two handles to the same value. An alias
/// must use one Shared.with callback because nested access to the same control block traps.
pub fn infixShared(
  operator: InfixOperator,
  left: &Shared<Value>,
  right: &Shared<Value>,
  pointerBits: u32,
) -> Result<Value, Fault> {
  let firstAddress = Shared.with<Value, usize>(left, valueAddress)
  let secondAddress = Shared.with<Value, usize>(right, valueAddress)
  if firstAddress == secondAddress {
    return Shared.with<Value, Result<Value, Fault>>(
      left,
      fn(value: &Value) -> Result<Value, Fault> {
        return infix(operator, value, value, pointerBits)
      },
    )
  }
  return Shared.with<Value, Result<Value, Fault>>(
    left,
    fn(first: &Value) -> Result<Value, Fault> {
      return infixWithRight(operator, first, right, pointerBits)
    },
  )
}

fn sequenceScalar(value: &Value) -> bool {
  return match &value.* { Value.Aggregate {..} => false Value.Sequence {..} => false _ => true }
}

/// Constructs an empty immutable sequence at its authenticated sealed type.
pub fn sequenceEmpty(ty: Shared<SemanticType>) -> Option<Value> {
  let sequenceType = Shared.with<SemanticType, Option<Shared<SemanticType>>>(&ty, CheckedIntrinsic.staticSequenceElement)
  if let Option<Shared<SemanticType>>.Some {..} = move sequenceType {
    return Option.some<Value>(Value.Sequence {ty: move ty, elements: Vector.make<Shared<Value>>(), admission: SequenceAdmission {}})
  }
  return Option.none<Value>()
}

/// Appends one complete scalar of the exact element type, leaving the input untouched.
pub effect fn sequenceAppend(sequence: &Shared<Value>, next: &Shared<Value>) -> Option<Value>
! OutOfMemoryError ? &mut Allocator {
  if !Shared.with<Value, bool>(next, sequenceScalar) { return Option.none<Value>() }
  let ty = Shared.with<Value, Option<Shared<SemanticType>>>(sequence, fn(value: &Value) -> Option<Shared<SemanticType>> {
    return match &value.* { Value.Sequence {ty, ..} => Option.some<Shared<SemanticType>>(Shared.clone<SemanticType>(&ty)) _ => Option.none<Shared<SemanticType>>() }
  })
  let exact = match move ty { Option<Shared<SemanticType>>.Some {value} => move value Option<Shared<SemanticType>>.None => { return Option.none<Value>() } }
  let element = Shared.with<SemanticType, Option<Shared<SemanticType>>>(&exact, CheckedIntrinsic.staticSequenceElement)
  let selected = match move element { Option<Shared<SemanticType>>.Some {value} => move value Option<Shared<SemanticType>>.None => { return Option.none<Value>() } }
  let matches = run matchesType(next, &selected)
  if !matches { return Option.none<Value>() }
  let mut elements = Vector.make<Shared<Value>>()
  let count = Shared.with<Value, usize>(sequence, sequenceLength)
  let mut at = usize.ZERO
  while at < count {
    let child = Shared.with<Value, Option<Shared<Value>>>(sequence, fn(value: &Value) -> Option<Shared<Value>> { return sequenceElement(value, at) })
    if let Option<Shared<Value>>.Some {value} = move child { run Vector.append<Shared<Value>>(&mut elements, move value) }
    at = at + usize.ONE
  }
  run Vector.append<Shared<Value>>(&mut elements, Shared.clone<Value>(next))
  return Option.some<Value>(Value.Sequence {ty: move exact, elements: move elements, admission: SequenceAdmission {}})
}

pub fn sequenceLength(value: &Value) -> usize {
  return match &value.* { Value.Sequence {elements, ..} => Vector.length<Shared<Value>>(&elements) _ => usize.MAX }
}

pub fn sequenceElement(value: &Value, at: usize) -> Option<Shared<Value>> {
  if let Value.Sequence {elements, ..} = &value.* {
    let entries = Vector.asSlice<Shared<Value>>(&elements)
    if at < entries.length { return Option.some<Shared<Value>>(Shared.clone<Value>(&entries[at])) }
  }
  return Option.none<Shared<Value>>()
}

fn sequenceSize(elements: &[Shared<Value>]) -> usize {
  let mut total = usize.ZERO + 32
  let mut at = usize.ZERO
  while at < elements.length {
    total = saturatingAdd(total, Shared.with<Value, usize>(&elements[at], size))
    at = at + usize.ONE
  }
  return total
}
