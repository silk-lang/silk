//! Source-only observations consumed by semantic units. These are graph inputs, not queries.
//! Loading syntax does not imply consuming all of its bytes. Each selector retains exactly the
//! authored facts read by its consumer; unconverted readers keep explicit SourceFile edges.

import hir.Hir as Hir {Module, Node}
import hir.Fingerprint
import semantic.SourceSyntax
import semantic.DeclarationId {DeclarationId}
import semantic.ModuleIndex {ModuleIndex, NameObservation, CandidateKind, Arm}
import semantic.SourceIndex {IndexedSource}
import semantic.Anchor {Anchor}
import semantic.SourceLocations {Location}
import lexer.Span {Span}
import semantic.SourceUnit {SourceUnit}
import silk.collections.slice {Slice}
import silk.text.string {String}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.collections.bytes {Bytes}
import silk.option {Option}
import silk.collections.list {List}
import silk.num.usize
import silk.num.u64
import semantic.RuntimeEncoding as Encoding
import semantic.InternIndex {InternIndex}
import silk.collections.hash {Hash}
import semantic.ContentHash {ContentHash}

pub enum Facet {
  /// A declaration handle still denotes its original owner. Position is not content.
  Alive,
  /// Header node category and visibility, without fields or binders.
  Identity,
  /// Canonical enclosing static-arm chain and polarity.
  Arm,
  /// One authored import declaration. Other declarations are excluded.
  Import,
  Header,
  Binders,
  Members,
  Fields,
  Operations,
  Parent,
  Body,
  /// The whole written header, nested syntax included, without positions.
  Written,
  /// The headers of the declarations an implementation or contract encloses, in written order.
  Enclosed,
  /// The declaration's directives, sorted, so their written order is not content. A header edit
  /// leaves them alone, and a directive edit leaves the header alone.
  Directives,
}

pub union Selector {
  Presence,
  Implementations,
  /// The module's top-level inherent implementations, with their arms.
  Inherents,
  Imports,
  VisibleNames {pub namespaces: bool, pub external: bool},
  Identity {pub identity: DeclarationId},
  Member {pub handle: usize, pub ordinal: usize},
  Name {pub spelling: Bytes},
  /// The complete bucket plus the arm/import facts actually read by selection.
  Selection {pub spelling: Bytes},
  Declaration {pub handle: usize, pub facet: Facet},
  Location {pub handle: usize, pub location: Location},
  /// A source prefix used only when a published absolute diagnostic cannot be represented by
  /// an authored token selector. Appending unrelated bytes after the site does not change it.
  Prefix {pub end: usize},
  /// The module the import path `path` (canonical, such as `json/Value.silk`) names from this
  /// module under the selected package graph, and whether that module may import it. It reads
  /// the dependency names and exports of the manifests, not the module's source, so the store
  /// captures it.
  Resolution {pub path: Bytes},
}

pub struct Input {
  pub module: usize,
  pub selector: Selector,
  /// The digest of the value [`capture`] read; equal digests mean the read is unchanged.
  pub digest: ContentHash,
  /// The [`text`] the value was read from, or zero.
  pub text: ContentHash,
}

/// The interned inputs, in first-observation order, and their positions by module and selector.
pub struct SourceInputs {
  pub inputs: List<Input>,
  lookup: InternIndex,
  // Declaration-facet inputs by handle and facet ordinal, each plus one or zero for none. A
  // handle names one module's declaration, so it keys these reads without hashing.
  facets: List<usize>,
}

pub fn make() -> SourceInputs {
  return SourceInputs {inputs: List<Input>.make(), lookup: InternIndex.make(), facets: List<usize>.make()}
}

// One past the largest `facetOrdinal`.
const FACETS: usize = 14

fn sameBytes(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut at = usize.ZERO
  while at < left.length { if left[at] != right[at] { return false } at = at + usize.ONE }
  return true
}

fn sameSelector(left: &Selector, right: &Selector) -> bool {
  return match &left.* {
    Selector.VisibleNames {namespaces, external} => match &right.* { Selector.VisibleNames {namespaces: other, external: exposed} => namespaces == other && external == exposed _ => false }
    Selector.Imports => match &right.* { Selector.Imports => true _ => false }
    Selector.Implementations => match &right.* { Selector.Implementations => true _ => false }
    Selector.Inherents => match &right.* { Selector.Inherents => true _ => false }
    Selector.Identity {identity} => match &right.* { Selector.Identity {identity: other} => DeclarationId.equals(&identity, &other) _ => false }
    Selector.Member {handle, ordinal} => match &right.* { Selector.Member {handle: other, ordinal: member} => handle == other && ordinal == member _ => false }
    Selector.Presence => match &right.* { Selector.Presence => true _ => false }
    Selector.Name {spelling} => match &right.* {
      Selector.Name {spelling: other} => sameBytes(Bytes.asSlice(&spelling), Bytes.asSlice(&other)) _ => false
    }
    Selector.Selection {spelling} => match &right.* {
      Selector.Selection {spelling: other} => sameBytes(Bytes.asSlice(&spelling), Bytes.asSlice(&other)) _ => false
    }
    Selector.Declaration {handle, facet} => match &right.* {
      Selector.Declaration {handle: other, facet: otherFacet} => handle == other && facet == otherFacet _ => false
    }
    Selector.Location {handle, location} => match &right.* {
      Selector.Location {handle: other, location: compared} => handle == other && location.start == compared.start && location.end == compared.end
      _ => false
    }
    Selector.Prefix {end} => match &right.* { Selector.Prefix {end: other} => end == other _ => false }
    Selector.Resolution {path} => match &right.* {
      Selector.Resolution {path: other} => sameBytes(Bytes.asSlice(&path), Bytes.asSlice(&other)) _ => false
    }
  }
}

fn facetOrdinal(facet: Facet) -> u64 {
  return match facet {
    Facet.Alive => 0
    Facet.Identity => 1
    Facet.Arm => 2
    Facet.Import => 3
    Facet.Header => 4
    Facet.Binders => 5
    Facet.Members => 6
    Facet.Fields => 7
    Facet.Operations => 8
    Facet.Parent => 9
    Facet.Body => 10
    Facet.Written => 11
    Facet.Enclosed => 12
    Facet.Directives => 13
  }
}

// Equal module and selector pairs hash alike, as `sameSelector` compares them.
fn selectorHash(module: usize, selector: &Selector) -> u64 {
  let start = usize.toU64(module)
  return match &selector.* {
    Selector.Presence => Hash.combine(start, 0)
    Selector.Implementations => Hash.combine(start, 1)
    Selector.Imports => Hash.combine(start, 2)
    Selector.VisibleNames {namespaces, external} => {
      let mut hashed = Hash.combine(start, 3)
      if namespaces { hashed = Hash.combine(hashed, 1) }
      if external { hashed = Hash.combine(hashed, 2) }
      return hashed
    }
    Selector.Identity {identity} => Hash.combine(Hash.combine(start, 4), DeclarationId.hash(&identity))
    Selector.Member {handle, ordinal} => Hash.combine(Hash.combine(Hash.combine(start, 5), usize.toU64(handle)), usize.toU64(ordinal))
    Selector.Name {spelling} => InternIndex.hashBytes(Hash.combine(start, 6), Bytes.asSlice(&spelling))
    Selector.Selection {spelling} => InternIndex.hashBytes(Hash.combine(start, 7), Bytes.asSlice(&spelling))
    Selector.Declaration {handle, facet} => Hash.combine(Hash.combine(Hash.combine(start, 8), usize.toU64(handle)), facetOrdinal(facet))
    Selector.Location {handle, location} => Hash.combine(Hash.combine(Hash.combine(Hash.combine(start, 9), usize.toU64(handle)),
      usize.toU64(location.start)), usize.toU64(location.end))
    Selector.Prefix {end} => Hash.combine(Hash.combine(start, 10), usize.toU64(end))
    Selector.Inherents => Hash.combine(start, 11)
    Selector.Resolution {path} => InternIndex.hashBytes(Hash.combine(start, 12), Bytes.asSlice(&path))
  }
}

/// The interned input of `module` read through `selector`, or `usize.MAX` when none is yet.
pub fn find(self: &SourceInputs, module: usize, selector: &Selector) -> usize {
  if let Selector.Declaration {handle, facet} = &selector.* {
    if handle != usize.MAX {
      let slot = handle * FACETS + u64.toUsize(facetOrdinal(facet))
      let facets = List<usize>.asSlice(&self.facets)
      if slot < facets.length && facets[slot] != usize.ZERO { return facets[slot] - usize.ONE }
      return usize.MAX
    }
  }
  let inputs = List<Input>.asSlice(&self.inputs)
  let mut at = InternIndex.first(&self.lookup, selectorHash(module, selector))
  while at != usize.MAX {
    if inputs[at].module == module && sameSelector(&inputs[at].selector, selector) { return at }
    at = InternIndex.after(&self.lookup, at)
  }
  return usize.MAX
}

/// Interns a new input whose captured value has `digest`; [`find`] must not know it yet.
pub effect fn add(self: &mut SourceInputs, module: usize, selector: Selector, digest: ContentHash, text: ContentHash) -> usize
! OutOfMemoryError ? &mut Allocator {
  let at = List<Input>.length(&self.inputs)
  run List<Input>.reserve(&mut self.inputs, usize.ONE)
  if let Selector.Declaration {handle, facet} = &selector {
    if handle != usize.MAX {
      let slot = handle * FACETS + u64.toUsize(facetOrdinal(facet))
      while List<usize>.length(&self.facets) <= slot {
        run List<usize>.append(&mut self.facets, usize.ZERO)
      }
      List<usize>.set(&mut self.facets, slot, at + usize.ONE)
    }
  }
  run InternIndex.record(&mut self.lookup, selectorHash(module, &selector))
  run List<Input>.append(&mut self.inputs, Input {module: module, selector: move selector, digest: digest, text: text})
  return at
}

pub fn unchanged(input: &Input, digest: ContentHash) -> bool { return ContentHash.equals(input.digest, digest) }

// Canonical arm coordinates, never an ordinal from a previous parse.
effect fn arm(output: &mut Bytes, source: &IndexedSource, position: usize) -> ()
! OutOfMemoryError ? &mut Allocator {
  let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(source))
  let mut current = position
  while true {
    if let Option<Arm>.Some {value} = &declarations[current].arm {
      run Encoding.field(&mut output.*, b"arm")
      let mut identity = Bytes.make()
      run DeclarationId.appendContent(&declarations[value.conditional].identity, &mut identity)
      run Encoding.field(&mut output.*, Bytes.asSlice(&identity))
      if value.holds { run Encoding.field(&mut output.*, b"true") }
      else { run Encoding.field(&mut output.*, b"false") }
      current = value.conditional
    } else { break }
  }
  run Encoding.field(&mut output.*, b"unconditional")
  return ()
}

/// The tokens [`capture`] reads `selector` from at `position` of `source`: for a facet that reads
/// only the declaration's own syntax, its `ModuleIndex.ownTokens`; zero for any other selector,
/// or when the declaration nests one with its own identity. A nonzero value equal to an earlier
/// one means `capture` reads what it read then, without reading it.
pub fn text(selector: &Selector, source: Option<&IndexedSource>, position: usize) -> ContentHash {
  let none = ContentHash {high: 0, low: 0}
  let own = match &selector.* {
    Selector.Declaration {facet, ..} => facet == Facet.Alive || facet == Facet.Identity || facet == Facet.Import
      || facet == Facet.Header || facet == Facet.Binders || facet == Facet.Members || facet == Facet.Fields
      || facet == Facet.Body || facet == Facet.Written || facet == Facet.Directives
    _ => false
  }
  if !own { return none }
  return match move source {
    Option<&IndexedSource>.Some {value: indexed} => ModuleIndex.ownTokens(IndexedSource.moduleIndex(indexed),
      IndexedSource.authored(indexed), position)
    Option<&IndexedSource>.None => none
  }
}

// The caller provides the current live position of the stable handle, or MAX if it was lost.
pub effect fn capture(selector: &Selector, source: Option<&IndexedSource>, position: usize) -> Bytes
! OutOfMemoryError ? &mut Allocator {
  let mut output = Bytes.make()
  let indexed = match move source {
    Option<&IndexedSource>.Some {value} => value
    Option<&IndexedSource>.None => { return run Bytes.copy(b"absent") }
  }
  run Encoding.field(&mut output, b"present")
  let index = IndexedSource.moduleIndex(indexed)
  let declarations = ModuleIndex.listDeclarations(index)
  let hir = IndexedSource.authored(indexed)
  match &selector.* {
    Selector.Presence => {}
    Selector.VisibleNames {namespaces, external} => { run SourceSyntax.visibleNames(&mut output, indexed, namespaces, external) }
    Selector.Imports => { run SourceSyntax.imports(&mut output, indexed) }
    Selector.Implementations => { run SourceSyntax.implementations(&mut output, indexed) }
    Selector.Inherents => { run SourceSyntax.inherents(&mut output, indexed) }
    // The store captures a resolution before it reaches here.
    Selector.Resolution {..} => {}
    Selector.Identity {identity} => {
      let present = ModuleIndex.ordinalOf(index, &identity)
      if let Option<usize>.Some {..} = &present { run Encoding.field(&mut output, b"identity") }
      else { run Encoding.field(&mut output, b"missing-identity") }
    }
    Selector.Member {ordinal, ..} => {
      if position >= declarations.length { return run Bytes.copy(b"lost-handle") }
      run SourceSyntax.member(&mut output, hir, declarations[position].header, ordinal)
    }
    Selector.Name {spelling} => { run name(&mut output, indexed, Bytes.asSlice(&spelling), false) }
    Selector.Selection {spelling} => { run name(&mut output, indexed, Bytes.asSlice(&spelling), true) }
    Selector.Location {location, ..} => {
      if position < declarations.length {
        // A token ordinal is meaningful only under its retained authored header structure.
        let guarded = run Fingerprint.header(hir, declarations[position].header)
        run Encoding.field(&mut output, List<u8>.asSlice(&guarded))
        if let Option<Anchor>.Some {value: anchor} = move IndexedSource.anchorOf(indexed, position) {
          if let Option<Span>.Some {value: span} = move Anchor.retainedSpan(&anchor, location) {
            run Encoding.word(&mut output, usize.toU64(span.start))
            run Encoding.word(&mut output, usize.toU64(span.end))
            return move output
          }
        }
      }
      return run Bytes.copy(b"missing-location")
    }
    Selector.Prefix {end} => {
      let bytes = SourceUnit.bytes(IndexedSource.sourceUnit(indexed))
      let limit = end
      if limit > bytes.length { return run Bytes.copy(b"missing-prefix") }
      run Encoding.field(&mut output, Slice.view<u8>(bytes, usize.ZERO, limit))
    }
    Selector.Declaration {facet, ..} => {
      if position >= declarations.length { return run Bytes.copy(b"lost-handle") }
      run Encoding.field(&mut output, b"live")
      if facet == Facet.Arm { run arm(&mut output, indexed, position) }
      if facet == Facet.Identity {
        let header = Module.node(hir, declarations[position].header)
        run Encoding.field(&mut output, String.utf8Bytes(Hir.nodeKindName(header)))
        let visible = match header {
          Node.StructHeader {isPublic, ..} => isPublic
          Node.TupleHeader {isPublic, ..} => isPublic
          Node.EnumHeader {isPublic, ..} => isPublic
          Node.UnionHeader {isPublic, ..} => isPublic
          Node.ServiceHeader {isPublic, ..} => isPublic
          Node.InterfaceHeader {isPublic, ..} => isPublic
          Node.RoleHeader {isPublic, ..} => isPublic
          Node.FunctionHeader {isPublic, ..} => isPublic
          _ => false
        }
        if visible { run Encoding.field(&mut output, b"public") }
        if let Node.FunctionHeader {linkage, ..} = header {
          if linkage.present { run Encoding.field(&mut output, b"linkage") }
        }
      }
      if facet == Facet.Import {
        let encoded = run Fingerprint.header(hir, declarations[position].header)
        run Encoding.field(&mut output, List<u8>.asSlice(&encoded))
      }
      if facet == Facet.Header { run SourceSyntax.header(&mut output, hir, declarations[position].header) }
      if facet == Facet.Binders { run SourceSyntax.binders(&mut output, hir, declarations[position].header) }
      if facet == Facet.Members { run SourceSyntax.members(&mut output, hir, declarations[position].header) }
      if facet == Facet.Fields { run SourceSyntax.fields(&mut output, hir, declarations[position].header) }
      if facet == Facet.Operations { run SourceSyntax.operations(&mut output, indexed, position) }
      if facet == Facet.Parent { run SourceSyntax.parent(&mut output, indexed, position) }
      if facet == Facet.Body {
        let encoded = run Fingerprint.body(hir, declarations[position].local)
        run Encoding.field(&mut output, List<u8>.asSlice(&encoded))
      }
      if facet == Facet.Written {
        let encoded = run Fingerprint.header(hir, declarations[position].header)
        run Encoding.field(&mut output, List<u8>.asSlice(&encoded))
      }
      if facet == Facet.Enclosed { run SourceSyntax.enclosed(&mut output, indexed, position) }
      if facet == Facet.Directives {
        let encoded = run Fingerprint.directives(hir, declarations[position].local)
        run Encoding.field(&mut output, List<u8>.asSlice(&encoded))
      }
    }
  }
  return move output
}

effect fn name(output: &mut Bytes, source: &IndexedSource, spelling: &[u8], selected: bool) -> ()
! OutOfMemoryError ? &mut Allocator {
  let index = IndexedSource.moduleIndex(source)
  let observation = run ModuleIndex.observeName(index, spelling)
  let members = NameObservation.listMembers(&observation)
  run Encoding.word(&mut output.*, usize.toU64(members.length))
  let mut at = usize.ZERO
  while at < members.length {
    let item = &members[at]
    let mut identity = Bytes.make()
    run DeclarationId.appendContent(&item.declaration, &mut identity)
    run Encoding.field(&mut output.*, Bytes.asSlice(&identity))
    run Encoding.field(&mut output.*, match item.kind {
      CandidateKind.Declaration => b"declaration"
      CandidateKind.ImportModule => b"namespace"
      CandidateKind.ImportMember => b"member"
    })
    run Encoding.word(&mut output.*, usize.toU64(item.ordinal))
    if item.isPublic { run Encoding.field(&mut output.*, b"public") }
    else { run Encoding.field(&mut output.*, b"private") }
    if selected {
      if let Option<usize>.Some {value: position} = move ModuleIndex.ordinalOf(index, &item.declaration) {
        run arm(&mut output.*, source, position)
        if item.kind != CandidateKind.Declaration {
          let declarations = ModuleIndex.listDeclarations(index)
          let encoded = run Fingerprint.header(IndexedSource.authored(source), declarations[position].header)
          run Encoding.field(&mut output.*, List<u8>.asSlice(&encoded))
        }
      }
    }
    at = at + usize.ONE
  }
  return ()
}

/// `selector`, or `Presence` for a handle selector that carries no handle: such a selector reads
/// only whether its module is present, so both capture the same thing, and only `Presence` has a
/// form a cache on disk can name.
pub fn settled(selector: Selector) -> Selector {
  let handleless = match &selector {
    Selector.Declaration {handle, ..} => handle == usize.MAX
    Selector.Location {handle, ..} => handle == usize.MAX
    Selector.Member {handle, ..} => handle == usize.MAX
    _ => false
  }
  if handleless {
    drop selector
    return Selector.Presence
  }
  return move selector
}

/// Handle carried by a declaration or retained-location selector, if any.
pub fn handle(selector: &Selector) -> usize {
  return match &selector.* {
    Selector.Declaration {handle, ..} => handle
    Selector.Location {handle, ..} => handle
    Selector.Member {handle, ..} => handle
    _ => usize.MAX
  }
}

/// A selector's kind, for traced replay reports; a name selector's spelling is not included.
pub fn selectorName(selector: &Selector) -> &'static [u8] {
  return match &selector.* {
    Selector.Presence => b"Presence"
    Selector.Implementations => b"Implementations"
    Selector.Inherents => b"Inherents"
    Selector.Imports => b"Imports"
    Selector.VisibleNames {..} => b"VisibleNames"
    Selector.Identity {..} => b"Identity"
    Selector.Member {..} => b"Member"
    Selector.Name {..} => b"Name"
    Selector.Selection {..} => b"Selection"
    Selector.Location {..} => b"Location"
    Selector.Prefix {..} => b"Prefix"
    Selector.Resolution {..} => b"Resolution"
    Selector.Declaration {facet, ..} => match facet {
      Facet.Alive => b"Declaration.Alive"
      Facet.Identity => b"Declaration.Identity"
      Facet.Arm => b"Declaration.Arm"
      Facet.Import => b"Declaration.Import"
      Facet.Header => b"Declaration.Header"
      Facet.Binders => b"Declaration.Binders"
      Facet.Members => b"Declaration.Members"
      Facet.Fields => b"Declaration.Fields"
      Facet.Operations => b"Declaration.Operations"
      Facet.Parent => b"Declaration.Parent"
      Facet.Body => b"Declaration.Body"
      Facet.Written => b"Declaration.Written"
      Facet.Enclosed => b"Declaration.Enclosed"
      Facet.Directives => b"Declaration.Directives"
    }
  }
}
