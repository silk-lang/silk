//! Artifact graph assembly preserves its selected identity mode and rejects unsupported worker evidence.
import semantic.ArtifactGraph
import semantic.BuildRecord
import semantic.ContentHash {ContentHash}
import hir.Hir {OwnerKind}
import semantic.DeclarationId {DeclarationId, OwnerStep}
import semantic.ModuleId {ModuleId, InvalidModulePath}
import semantic.StableKey
import silk.collections.bytes {Bytes}
import silk.collections.list {List}
import silk.core.effect {Effect}
import silk.core.option {Option}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.num.usize
import silk.testing.testing {AssertionError, Testing}

fn digest(value: u64) -> ContentHash { return ContentHash {high: 0, low: value} }

effect fn entry(exact: u64, leaf: u64) -> BuildRecord.Entry ! OutOfMemoryError ? &mut Allocator {
  let mut facts = BuildRecord.unknownFacts()
  facts.flags = BuildRecord.FACT_KNOWN
  facts.definition = digest(7)
  if leaf == 0 { facts.flags = facts.flags + BuildRecord.FACT_SUMMARIZED + BuildRecord.FACT_CALLEES }
  return BuildRecord.Entry {exact: digest(exact), hash: exact, family: 0, declaration: run Bytes.copy(b"declaration"),
    parent: usize.MAX, position: usize.ZERO, requested: false, alias: usize.MAX, leaf: leaf,
    references: List<BuildRecord.Reference>.make(), summary: digest(exact), facts: move facts}
}

effect fn fragment(exact: u64, target: u64) -> BuildRecord.Record ! OutOfMemoryError ? &mut Allocator {
  let mut result = BuildRecord.make(false, true)
  run List<ContentHash>.append(&mut result.roots, digest(exact))
  let mut body = run entry(exact, 0)
  if target != 0 {
    run List<BuildRecord.Reference>.append(&mut body.references, BuildRecord.Reference {target: usize.ONE, edge: digest(99)})
    run List<usize>.append(&mut body.facts.callees, usize.ZERO)
  }
  run List<BuildRecord.Entry>.append(&mut result.entries, move body)
  if target != 0 { run List<BuildRecord.Entry>.append(&mut result.entries, run entry(target, 3)) }
  return move result
}

fn absent(value: &Option<BuildRecord.Record>) -> bool {
  return match &value.* {
    Option<BuildRecord.Record>.Some {..} => false
    Option<BuildRecord.Record>.None => true
  }
}

test effect fn artifactGraphUsesOnlyActualExactRootsAndRejectsMissingPatterns() -> ()
! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run graphClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn graphClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut records = List<BuildRecord.Record>.make()
  run List<BuildRecord.Record>.append(&mut records, run fragment(1, 2))
  run List<BuildRecord.Record>.append(&mut records, run fragment(2, 1))
  // An unused module root even has an unresolved edge; the actual artifact never reaches it.
  run List<BuildRecord.Record>.append(&mut records, run fragment(3, 4))
  let roots = [digest(1)]
  let merged = run ArtifactGraph.merge(List<BuildRecord.Record>.asSlice(&records), &roots, false, true)
  let graph = match &merged {
    Option<BuildRecord.Record>.Some {value} => &value
    Option<BuildRecord.Record>.None => {
      run Testing.expect(false, "a closed exact graph is accepted")
      return ()
    }
  }
  let entries = List<BuildRecord.Entry>.asSlice(&graph.entries)
  run Testing.expect(entries.length == 2 && List<ContentHash>.length(&graph.roots) == 1,
    "only the requested root and its exact closure survive")
  run Testing.expect(ContentHash.equals(entries[0].exact, digest(1)) && ContentHash.equals(entries[1].exact, digest(2))
    && ContentHash.equals(entries[0].facts.definition, entries[1].facts.definition),
    "two exact region patterns remain separate even when their backend definition matches")
  run Testing.expect(entries[0].parent == usize.MAX && entries[1].parent == usize.ZERO
    && List<BuildRecord.Reference>.asSlice(&entries[1].references)[0].target == usize.ZERO,
    "DFS order and cyclic reference remapping are stable")
  run Testing.expect(List<usize>.asSlice(&entries[0].facts.callees)[0] == usize.ZERO,
    "direct calls still name their reference positions")
  let missingRoots = [digest(3)]
  let missing = run ArtifactGraph.merge(List<BuildRecord.Record>.asSlice(&records), &missingRoots, false, true)
  run Testing.expect(absent(&missing), "a missing exact pattern cannot use another pattern's same definition")
  let mut regionErased = List<BuildRecord.Record>.make()
  let mut erased = run fragment(1, 0)
  erased.patterns = false
  run List<BuildRecord.Record>.append(&mut regionErased, move erased)
  let refused = run ArtifactGraph.merge(List<BuildRecord.Record>.asSlice(&regionErased), &roots, false, true)
  run Testing.expect(absent(&refused), "definition records cannot masquerade as exact-pattern evidence")
  // These fragments are born with definition identities; merely changing an exact graph's
  // mode would not convert its roots, references or selected representatives.
  let mut definitions = List<BuildRecord.Record>.make()
  let mut firstDefinition = run fragment(11, 22)
  firstDefinition.patterns = false
  let firstEntries = List<BuildRecord.Entry>.asMutSlice(&mut firstDefinition.entries)
  firstEntries[0].facts.definition = digest(11)
  firstEntries[1].facts.definition = digest(22)
  let mut owed = List<BuildRecord.Callee>.make()
  run List<BuildRecord.Callee>.append(&mut owed, BuildRecord.Callee {exact: digest(222), definition: digest(22)})
  run List<BuildRecord.Obligation>.append(&mut firstEntries[0].facts.obligations,
    BuildRecord.Obligation {exact: true, callees: move owed, declarations: List<Bytes>.make()})
  run List<BuildRecord.Record>.append(&mut definitions, move firstDefinition)
  let mut secondDefinition = run fragment(22, 0)
  secondDefinition.patterns = false
  let secondEntries = List<BuildRecord.Entry>.asMutSlice(&mut secondDefinition.entries)
  secondEntries[0].facts.definition = digest(22)
  run List<BuildRecord.Record>.append(&mut definitions, move secondDefinition)
  let definitionRoots = [digest(11)]
  let definitionGraph = run ArtifactGraph.merge(List<BuildRecord.Record>.asSlice(&definitions), &definitionRoots, false, false)
  let selectedDefinitions = match &definitionGraph {
    Option<BuildRecord.Record>.Some {value} => &value
    Option<BuildRecord.Record>.None => {
      run Testing.expect(false, "a consistent provider-sensitive definition graph is accepted")
      return ()
    }
  }
  let selectedEntries = List<BuildRecord.Entry>.asSlice(&selectedDefinitions.entries)
  run Testing.expect(!selectedDefinitions.patterns && selectedEntries.length == 2
    && ContentHash.equals(selectedEntries[0].exact, digest(11))
    && ContentHash.equals(selectedEntries[1].exact, digest(22)),
    "definition mode preserves its supplied selected identities and uses obligation definition targets")
  return ()
}

test effect fn artifactGraphRejectsConflictingFactsModesAndUnselectedObligations() -> ()
! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run refusalClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn refusalClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let roots = [digest(1)]
  let mut conflicting = List<BuildRecord.Record>.make()
  run List<BuildRecord.Record>.append(&mut conflicting, run fragment(1, 0))
  let mut other = run fragment(1, 0)
  let otherEntries = List<BuildRecord.Entry>.asMutSlice(&mut other.entries)
  otherEntries[0].facts.keyBytes = 9
  run List<BuildRecord.Record>.append(&mut conflicting, move other)
  let collision = run ArtifactGraph.merge(List<BuildRecord.Record>.asSlice(&conflicting), &roots, false, true)
  run Testing.expect(absent(&collision), "equal summary digests do not hide conflicting portable facts")
  let mut malformed = List<BuildRecord.Record>.make()
  let mut missingReference = run fragment(1, 0)
  run List<usize>.append(&mut List<BuildRecord.Entry>.asMutSlice(&mut missingReference.entries)[0].facts.callees, usize.ZERO)
  run List<BuildRecord.Record>.append(&mut malformed, move missingReference)
  let bounds = run ArtifactGraph.merge(List<BuildRecord.Record>.asSlice(&malformed), &roots, false, true)
  run Testing.expect(absent(&bounds), "callee positions must refer to actual edges")
  let mut observed = List<BuildRecord.Record>.make()
  let mut observer = run fragment(1, 0)
  let observedEntries = List<BuildRecord.Entry>.asMutSlice(&mut observer.entries)
  observedEntries[0].facts.flags = observedEntries[0].facts.flags + BuildRecord.FACT_OBSERVES
  run List<BuildRecord.Record>.append(&mut observed, move observer)
  let mode = run ArtifactGraph.merge(List<BuildRecord.Record>.asSlice(&observed), &roots, false, true)
  run Testing.expect(absent(&mode), "ordinary emission refuses real observation")
  let wrongFragmentMode = run ArtifactGraph.merge(List<BuildRecord.Record>.asSlice(&observed), &roots, true, true)
  run Testing.expect(absent(&wrongFragmentMode), "a mode change requires freshly observing worker fragments")
  let observingRecords = List<BuildRecord.Record>.asMutSlice(&mut observed)
  observingRecords[0].observing = true
  let observing = run ArtifactGraph.merge(List<BuildRecord.Record>.asSlice(&observed), &roots, true, true)
  run Testing.expect(!absent(&observing), "an observing nonsuspending graph is accepted in observing mode")
  let changedRecords = List<BuildRecord.Record>.asMutSlice(&mut observed)
  let changedEntries = List<BuildRecord.Entry>.asMutSlice(&mut changedRecords[0].entries)
  changedEntries[0].facts.flags = changedEntries[0].facts.flags - BuildRecord.FACT_OBSERVES
  let unobserved = run ArtifactGraph.merge(List<BuildRecord.Record>.asSlice(&observed), &roots, true, true)
  run Testing.expect(absent(&unobserved), "observing mode needs an actually reached observer")
  let suspendedRecords = List<BuildRecord.Record>.asMutSlice(&mut observed)
  let suspendedEntries = List<BuildRecord.Entry>.asMutSlice(&mut suspendedRecords[0].entries)
  suspendedEntries[0].facts.flags = suspendedEntries[0].facts.flags + BuildRecord.FACT_OBSERVES + BuildRecord.FACT_SUSPENDS
  let suspended = run ArtifactGraph.merge(List<BuildRecord.Record>.asSlice(&observed), &roots, true, true)
  run Testing.expect(absent(&suspended), "observing mode still refuses every suspension")
  let mut owing = List<BuildRecord.Record>.make()
  let mut owner = run fragment(1, 0)
  let ownerEntries = List<BuildRecord.Entry>.asMutSlice(&mut owner.entries)
  ownerEntries[0].facts.definition = digest(8)
  let mut callees = List<BuildRecord.Callee>.make()
  run List<BuildRecord.Callee>.append(&mut callees, BuildRecord.Callee {exact: digest(2), definition: digest(7)})
  run List<BuildRecord.Obligation>.append(&mut List<BuildRecord.Entry>.asMutSlice(&mut owner.entries)[0].facts.obligations,
    BuildRecord.Obligation {exact: true, callees: move callees, declarations: List<Bytes>.make()})
  run List<BuildRecord.Record>.append(&mut owing, move owner)
  run List<BuildRecord.Record>.append(&mut owing, run fragment(2, 0))
  let unselected = run ArtifactGraph.merge(List<BuildRecord.Record>.asSlice(&owing), &roots, false, true)
  run Testing.expect(absent(&unselected), "a worker-held but unselected NonParking target is insufficient")
  let withRequested = [digest(1), digest(2)]
  let selected = run ArtifactGraph.merge(List<BuildRecord.Record>.asSlice(&owing), &withRequested, false, true)
  run Testing.expect(!absent(&selected), "explicit requested roots satisfy exact NonParking coverage")
  return ()
}


effect fn declared(name: &[u8], shape: bool) -> Bytes
! OutOfMemoryError | InvalidModulePath ? &mut Allocator {
  let module = run ModuleId.make(b"workspace", b"artifact", b"main")
  let mut owners = List<OwnerStep>.make()
  run List<OwnerStep>.append(&mut owners, OwnerStep {kind: OwnerKind.Function,
    name: Option<Bytes>.some(run Bytes.copy(name)), occurrence: usize.ZERO})
  let identity = run DeclarationId.fromParts(move module, move owners)
  let mut encoded = Bytes.make()
  run StableKey.declaration(&mut encoded, &identity)
  if shape { run Bytes.append(&mut encoded, b"shape") }
  return move encoded
}

test effect fn artifactGraphNamedObligationsNeedSelectedNonparkingDeclarations() -> ()
! OutOfMemoryError | InvalidModulePath | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run namedClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn namedClaims() -> ()
! OutOfMemoryError | InvalidModulePath | AssertionError<'static> ? &mut Allocator {
  let mut records = List<BuildRecord.Record>.make()
  let mut caller = run fragment(1, 0)
  let callerEntries = List<BuildRecord.Entry>.asMutSlice(&mut caller.entries)
  callerEntries[0].declaration = run declared(b"caller", true)
  let mut declarations = List<Bytes>.make()
  run List<Bytes>.append(&mut declarations, run declared(b"target", false))
  run List<BuildRecord.Obligation>.append(&mut callerEntries[0].facts.obligations,
    BuildRecord.Obligation {exact: true, callees: List<BuildRecord.Callee>.make(), declarations: move declarations})
  run List<BuildRecord.Record>.append(&mut records, move caller)
  let mut target = run fragment(2, 0)
  let targetEntries = List<BuildRecord.Entry>.asMutSlice(&mut target.entries)
  targetEntries[0].declaration = run declared(b"target", true)
  run List<BuildRecord.Record>.append(&mut records, move target)
  let onlyCaller = [digest(1)]
  let unselected = run ArtifactGraph.merge(List<BuildRecord.Record>.asSlice(&records), &onlyCaller, false, true)
  run Testing.expect(absent(&unselected), "a named target held only by an unused worker root is not proved")
  let both = [digest(1), digest(2)]
  let selected = run ArtifactGraph.merge(List<BuildRecord.Record>.asSlice(&records), &both, false, true)
  run Testing.expect(!absent(&selected), "selected declarations match their canonical prefix despite appended shape bytes")
  let mutableRecords = List<BuildRecord.Record>.asMutSlice(&mut records)
  let targetBodies = List<BuildRecord.Entry>.asMutSlice(&mut mutableRecords[1].entries)
  targetBodies[0].facts.flags = targetBodies[0].facts.flags + BuildRecord.FACT_SUSPENDS
  let suspending = run ArtifactGraph.merge(List<BuildRecord.Record>.asSlice(&records), &both, false, true)
  run Testing.expect(absent(&suspending), "a reached named target cannot prove nonparking while it suspends")
  let restoredRecords = List<BuildRecord.Record>.asMutSlice(&mut records)
  let restoredTarget = List<BuildRecord.Entry>.asMutSlice(&mut restoredRecords[1].entries)
  restoredTarget[0].facts.flags = restoredTarget[0].facts.flags - BuildRecord.FACT_SUSPENDS
  let callerBodies = List<BuildRecord.Entry>.asMutSlice(&mut restoredRecords[0].entries)
  let obligations = List<BuildRecord.Obligation>.asMutSlice(&mut callerBodies[0].facts.obligations)
  obligations[0].exact = false
  let inexact = run ArtifactGraph.merge(List<BuildRecord.Record>.asSlice(&records), &both, false, true)
  run Testing.expect(absent(&inexact), "matching declarations do not discharge an inexact obligation")
  return ()
}


test effect fn artifactGraphServedBodiesProveBareNonparkingWithoutNewRoots() -> ()
! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run bareClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn bareClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut records = List<BuildRecord.Record>.make()
  let mut caller = run fragment(11, 22)
  caller.patterns = false
  let callerEntries = List<BuildRecord.Entry>.asMutSlice(&mut caller.entries)
  callerEntries[0].facts.definition = digest(11)
  callerEntries[1].facts.definition = digest(22)
  let mut callees = List<BuildRecord.Callee>.make()
  run List<BuildRecord.Callee>.append(&mut callees,
    BuildRecord.Callee {exact: digest(333), definition: digest(33)})
  run List<BuildRecord.Obligation>.append(&mut callerEntries[0].facts.obligations,
    BuildRecord.Obligation {exact: true, callees: move callees, declarations: List<Bytes>.make()})
  run List<BuildRecord.Record>.append(&mut records, move caller)
  let mut served = run fragment(22, 0)
  served.patterns = false
  let servedEntries = List<BuildRecord.Entry>.asMutSlice(&mut served.entries)
  servedEntries[0].facts.definition = digest(22)
  servedEntries[0].facts.bare = digest(33)
  run List<BuildRecord.Record>.append(&mut records, move served)
  let roots = [digest(11)]
  let unflagged = run ArtifactGraph.merge(List<BuildRecord.Record>.asSlice(&records), &roots, false, false)
  run Testing.expect(absent(&unflagged), "bare bytes without FACT_BARE prove nothing")
  let mutable = List<BuildRecord.Record>.asMutSlice(&mut records)
  let bodies = List<BuildRecord.Entry>.asMutSlice(&mut mutable[1].entries)
  bodies[0].facts.flags = bodies[0].facts.flags + BuildRecord.FACT_BARE
  let proved = run ArtifactGraph.merge(List<BuildRecord.Record>.asSlice(&records), &roots, false, false)
  let graph = match &proved {
    Option<BuildRecord.Record>.Some {value} => &value
    Option<BuildRecord.Record>.None => {
      run Testing.expect(false, "a reached served instance proves its provider-free NonParking target")
      return ()
    }
  }
  let entries = List<BuildRecord.Entry>.asSlice(&graph.entries)
  run Testing.expect(entries.length == 2 && List<ContentHash>.length(&graph.roots) == 1
    && ContentHash.equals(entries[1].exact, digest(22)),
    "bare obligation coverage adds neither a root nor a provider-free definition")
  let unseen = List<BuildRecord.Record>.asMutSlice(&mut records)
  let callers = List<BuildRecord.Entry>.asMutSlice(&mut unseen[0].entries)
  callers[0].references = List<BuildRecord.Reference>.make()
  callers[0].facts.callees = List<usize>.make()
  let unselected = run ArtifactGraph.merge(List<BuildRecord.Record>.asSlice(&records), &roots, false, false)
  run Testing.expect(absent(&unselected), "an unused worker-held served instance does not discharge an obligation")
  // The same obligation rule applies when roots and edges retain exact region patterns.
  let exact = List<BuildRecord.Record>.asMutSlice(&mut records)
  exact[0].patterns = true
  exact[1].patterns = true
  let exactRoots = [digest(11), digest(22)]
  let exactProved = run ArtifactGraph.merge(List<BuildRecord.Record>.asSlice(&records), &exactRoots, false, true)
  run Testing.expect(!absent(&exactProved), "exact graph mode still uses serial sameInstance NonParking coverage")
  let suspending = List<BuildRecord.Record>.asMutSlice(&mut records)
  let suspendedBodies = List<BuildRecord.Entry>.asMutSlice(&mut suspending[1].entries)
  suspendedBodies[0].facts.flags = suspendedBodies[0].facts.flags + BuildRecord.FACT_SUSPENDS
  let refused = run ArtifactGraph.merge(List<BuildRecord.Record>.asSlice(&records), &exactRoots, false, true)
  run Testing.expect(absent(&refused), "a suspending served instance cannot prove its bare target nonparking")
  return ()
}
