//! Immutable source and fingerprint inputs for one authored declaration.
//!
//! # When to use
//!
//! Use `BodyInput` handles for typed bodies and static roots in the same declaration.
//! The source index returns a shared handle on demand instead of repeating the fingerprint work.
//!
//! # Details
//!
//! Each input owns exact source bytes, syntax positions, and canonical header and body bytes.
//! A source change creates another input. Comparisons also check the module and declaration identity.

import hir.Fingerprint
import hir.Hir {HirId, Module}
import lexer.Span {Span}
import semantic.DeclarationId {DeclarationId}
import silk.allocator {Allocator, OutOfMemoryError}
import silk.vector {Vector}
import silk.usize
import silk.option {Option}
import silk.shared {Shared}

/// Exact declaration identity, syntax positions, source bytes, and canonical fingerprints.
pub struct BodyInput {
  declaration: DeclarationId
  syntax: HirId
  ambiguous: bool
  span: Span
  text: Vector<u8>
  header: Vector<u8>
  body: Vector<u8>
  // Literal typing also depends on its lexical owner, including that owner's own captures.
  enclosing: Option<Shared<BodyInput>>
}

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] { return false }
    at = at + usize.ONE
  }
  return true
}

impl BodyInput {
  /// Captures exact source bytes, syntax positions, and canonical header and body inputs.
  ///
  /// # Gotchas
  ///
  /// `syntax` must name the declaration in `module`. Its complete source span must address `bytes`.
  /// A literal requires its directly enclosing declaration input; a named declaration has none.
  pub effect fn make(
    module: &Module,
    declaration: &DeclarationId,
    syntax: HirId,
    ambiguous: bool,
    bytes: &[u8],
    enclosing: Option<Shared<BodyInput>>,
  ) -> Self
  ! OutOfMemoryError ? &mut Allocator {
    let span = Module.span(module, syntax)
    let mut text = Vector.make<u8>()
    let mut at = span.start
    while at < span.end {
      run Vector.append<u8>(&mut text, bytes[at])
      at = at + usize.ONE
    }
    return BodyInput {
      declaration: run DeclarationId.copy(declaration),
      syntax: syntax,
      ambiguous: ambiguous,
      span: span,
      text: move text,
      header: run Fingerprint.header(module, syntax),
      body: run Fingerprint.body(module, syntax),
      enclosing: move enclosing,
    }
  }
  /// Returns true when the captured declaration has an unambiguous identity.
  pub fn isStable(self: &Self) -> bool {
    return !self.ambiguous
  }
  /// Compares canonical declaration inputs, retaining syntax-position and module ownership checks.
  pub fn equals(self: &Self, other: &Self) -> bool {
    if self.ambiguous || other.ambiguous || !DeclarationId.equals(
      &self.declaration,
      &other.declaration,
    ) {
      return false
    }
    if self.syntax.index != other.syntax.index || self.span.start != other.span.start || self.span.end != other.span.end {
      return false
    }
    if !sameEnclosing(&self.enclosing, &other.enclosing) { return false }
    return same(Vector.asSlice<u8>(&self.text), Vector.asSlice<u8>(&other.text)) && same(
      Vector.asSlice<u8>(&self.header),
      Vector.asSlice<u8>(&other.header),
    ) && same(Vector.asSlice<u8>(&self.body), Vector.asSlice<u8>(&other.body))
  }
}

fn sameEnclosing(left: &Option<Shared<BodyInput>>, right: &Option<Shared<BodyInput>>) -> bool {
  return match &left.* {
    Option<Shared<BodyInput>>.Some {value} => Shared.with<BodyInput, bool>(&value, fn(first: &BodyInput) -> bool {
      return enclosingWith(first, right)
    })
    Option<Shared<BodyInput>>.None => match &right.* {
      Option<Shared<BodyInput>>.Some {value: ignored} => false
      Option<Shared<BodyInput>>.None => true
    }
  }
}

fn enclosingWith(first: &BodyInput, right: &Option<Shared<BodyInput>>) -> bool {
  return match &right.* {
    Option<Shared<BodyInput>>.Some {value} => Shared.with<BodyInput, bool>(&value, fn(second: &BodyInput) -> bool {
      return BodyInput.equals(first, second)
    })
    Option<Shared<BodyInput>>.None => false
  }
}
