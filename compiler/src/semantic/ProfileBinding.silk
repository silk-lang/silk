//! External package-parameter input before semantic type checking.
//!
//! # When to use
//! Build a [`Supplied`] value at an application edge and call [`admit`] before any schema lookup,
//! diagnostic rendering, or query-key construction. The accepted value still needs exact schema
//! and type validation; only that later result may participate in precedence selection.

import semantic.DeclarationId {DeclarationId}
import semantic.ModuleId {ModuleId}
import semantic.Semantic {ParameterSchema}
import silk.bytes {Bytes}
import silk.result {Result}
import silk.shared {Shared}
import silk.vector {Vector}
import silk.usize

/// An untrusted portable binding value. Integer text is exact decimal, never a JSON number.
pub union Input {
  Integer {pub decimal: Bytes},
  Boolean {pub value: bool},
  String {pub text: Bytes},
  Enum {pub nominal: Bytes, pub member: Bytes},
  None,
  Some {pub value: Shared<Input>},
  Array {pub values: Vector<Shared<Input>>},
  Record {pub fields: Vector<Field>},
}

/// One name and value in a record input. Field order does not define record identity.
pub struct Field {
  pub name: Bytes
  pub value: Shared<Input>
}

/// The origin of a supplied value. Public translation has a stable logical translator identity.
pub union Provenance {
  Literal,
  TranslatedPublic {pub translator: Bytes},
  Secret,
  PhysicalSupply,
  Runtime,
}

/// Project and workspace inputs share a tier; artifact and selected-profile overrides share one.
pub enum Tier {
  Project,
  Override,
}

/// A raw binding from the request edge. It is not safe to put in a cache or diagnostic.
pub struct Supplied {
  pub package: Bytes
  pub module: Bytes
  pub parameter: Bytes
  pub value: Input
  pub provenance: Provenance
  pub tier: Tier
}

/// A binding whose provenance may enter semantic validation, but whose type is still unchecked.
pub struct Accepted {
  pub package: Bytes
  pub module: Bytes
  pub parameter: Bytes
  pub value: Input
  pub provenance: Provenance
  pub tier: Tier
}

/// The value had prohibited provenance and must not enter diagnostic details or a cache key.
pub struct ProhibitedProvenance {}

/// The supplied identity does not name a registered parameter, or names a private one.
pub enum HeaderError {
  UnknownParameter,
  PrivateParameter,
}

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

/// Rejects untrusted origins before inspecting, copying, or publishing the supplied value.
pub fn admit(binding: Supplied) -> Result<Accepted, ProhibitedProvenance> {
  let Supplied {package, module, parameter, value, provenance, tier} = move binding
  return match move provenance {
    Provenance.Literal => Result.succeed<Accepted, ProhibitedProvenance>(
      Accepted {package: move package, module: move module, parameter: move parameter,
        value: move value, provenance: Provenance.Literal, tier: tier},
    )
    Provenance.TranslatedPublic {translator} => Result.succeed<Accepted, ProhibitedProvenance>(
      Accepted {package: move package, module: move module, parameter: move parameter,
        value: move value, provenance: Provenance.TranslatedPublic {translator: move translator}, tier: tier},
    )
    Provenance.Secret => Result.failResult<Accepted, ProhibitedProvenance>(ProhibitedProvenance {})
    Provenance.PhysicalSupply => Result.failResult<Accepted, ProhibitedProvenance>(ProhibitedProvenance {})
    Provenance.Runtime => Result.failResult<Accepted, ProhibitedProvenance>(ProhibitedProvenance {})
  }
}

/// Looks up a registered canonical declaration without using an import alias or physical path.
/// The caller must admit provenance first and validate the value's type after this lookup.
pub fn header(binding: &Accepted, schemas: &[Shared<ParameterSchema>]) -> Result<Shared<ParameterSchema>, HeaderError> {
  let mut at = usize.ZERO
  while at < schemas.length {
    let found = Shared.with<ParameterSchema, bool>(&schemas[at], fn(schema: &ParameterSchema) -> bool {
      let id = &schema.declaration
      let module = DeclarationId.moduleId(id)
      return same(Bytes.asSlice(&binding.package), ModuleId.packageIdentity(module)) && same(
        Bytes.asSlice(&binding.module), ModuleId.logicalPath(module),
      ) && same(Bytes.asSlice(&binding.parameter), DeclarationId.spelling(id))
    })
    if found {
      let isPublic = Shared.with<ParameterSchema, bool>(&schemas[at], fn(schema: &ParameterSchema) -> bool {
        return schema.isPublic
      })
      if !isPublic {
        return Result.failResult<Shared<ParameterSchema>, HeaderError>(HeaderError.PrivateParameter)
      }
      return Result.succeed<Shared<ParameterSchema>, HeaderError>(Shared.clone<ParameterSchema>(&schemas[at]))
    }
    at = at + usize.ONE
  }
  return Result.failResult<Shared<ParameterSchema>, HeaderError>(HeaderError.UnknownParameter)
}
