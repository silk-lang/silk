//! A store that adopts another store's cache image checks unchanged modules without sweeping
//! them, sweeps a changed module again, and reports what a cold store reports. A changed
//! package graph reaches the checks whose imports it resolves.

import backend.Bitcode
import backend.CodegenUnits { CodegenUnit }
import lexer.Span { Span }
import semantic.WalkShare {WalkShared}
import semantic.BuildRecord
import semantic.CacheImage as CacheImage {Image}
import semantic.ContentHash { ContentHash }
import semantic.DeclarationId { DeclarationId }
import semantic.FinalProfile { FinalProfile }
import semantic.ModuleId {InvalidModulePath, ModuleId}
import semantic.PackageGraph {PackageGraph}
import semantic.Query { Cycle }
import semantic.Rejection { MessageArgument, Rejection, RejectionCode }
import semantic.Semantic { BackendBuild, Event as SemanticEvent, EventKind, Family, Request, Semantic, staticClosureNodes }
import semantic.SemanticCaseSupport { buildRejectedAt, makeSemantic, module, offsetOf, present, starts }
import semantic.SourceIndex { Event as SourceEvent, EventKind as SourceEventKind, RevisionMismatch }
import semantic.SourceRevision { Revision }
import semantic.Target { Id as TargetId, Target as MachineTarget }
import semantic.Types { TypeTable, Types }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.bytes { Bytes }
import silk.core.effect { Effect }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.mem.shared { Shared }
import silk.testing.testing { AssertionError, Testing }
import silk.num.u16
import silk.num.u64
import silk.num.usize

fn library() -> string<'static> {
  return """
pub struct Point {pub x: i32, pub y: i32}
pub fn origin() -> Point {
  return Point { x: 0, y: 0 }
}
"""
}

fn application() -> string<'static> {
  return """
import shape { Point, origin }
fn norm(point: &Point) -> i32 {
  return point.x + point.y
}
pub fn main() -> i32 {
  let first = origin()
  return norm(&first)
}
"""
}

fn edited() -> string<'static> {
  return """
import shape { Point, origin }
fn norm(point: &Point) -> i32 {
  return point.x + point.z
}
pub fn main() -> i32 {
  let first = origin()
  return norm(&first)
}
"""
}

test effect fn adoptedChecksVerifyInsteadOfSweeping() -> ()
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run adoptClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

// The source queries that started, each of which parses one module.
fn parses(events: &[SourceEvent]) -> usize {
  let mut count = usize.ZERO
  let mut at = usize.ZERO
  while at < events.length {
    if events[at].kind == SourceEventKind.QueryStart { count = count + usize.ONE }
    at = at + usize.ONE
  }
  return count
}

effect fn storeOf(text: string<'static>) -> Semantic
  ! InvalidModulePath | OutOfMemoryError
  ? &mut Allocator {
  let app = run module("app.silk")
  let shape = run module("shape.silk")
  let initial = run Revision.publish(&Revision.make(), &app, &run present(text))
  let revision = run Revision.publish(&initial, &shape, &run present(library()))
  return makeSemantic(move revision)
}

// Checks both modules and gives how many rejections they report.
effect fn checkBoth(store: &mut Semantic, request: &mut Request) -> usize
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
  let app = run module("app.silk")
  let shape = run module("shape.silk")
  let first = run Semantic.checkModule(&mut store.*, &mut request.*, &app, &Option<ModuleId>.none())
  let second = run Semantic.checkModule(&mut store.*, &mut request.*, &shape, &Option<ModuleId>.none())
  return List<Shared<Rejection>>.length(&first.rejections) + List<Shared<Rejection>>.length(&second.rejections)
}

effect fn adoptClaims() -> ()
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator | &mut Types {
  let mut request = Request.make()
  let mut cold = run storeOf(application())
  let coldFound = run checkBoth(&mut cold, &mut request)
  run Testing.expect(coldFound == usize.ZERO, "the program checks clean")
  let coldRuns = Semantic.statistics(&cold).runs
  let image = run Semantic.cacheImage(&mut cold)

  // The same sources: every check is reused, and nothing reruns.
  let mut warm = run storeOf(application())
  let adopted = run Semantic.adoptCache(&mut warm, &request, &image, true)
  run Testing.expect(adopted.roots > 4 && adopted.stale == usize.ZERO && adopted.changedLeaves == usize.ZERO,
    "every clean check of unchanged sources is reused")
  // The import's resolution is read from the package graph, so adoption parses no module.
  run Testing.expect(parses(Semantic.sourceEvents(&warm)) == usize.ZERO, "adopting unchanged sources parses nothing")
  let warmFound = run checkBoth(&mut warm, &mut request)
  run Testing.expect(warmFound == usize.ZERO, "a warm check reports what the cold one did")
  run Testing.expect(Semantic.statistics(&warm).runs == usize.ZERO && coldRuns > usize.ZERO, "a warm check of unchanged sources runs nothing")

  // An edited body: its module's sweep is stale and runs again, the other module is reused, and
  // the warm store reports exactly what a cold store of the edit reports.
  let mut changed = run storeOf(edited())
  let partly = run Semantic.adoptCache(&mut changed, &request, &image, true)
  run Testing.expect(partly.roots > usize.ZERO && partly.stale > usize.ZERO && partly.changedLeaves > usize.ZERO,
    "an edit leaves only the checks resting on it stale")
  let warmEdited = run checkBoth(&mut changed, &mut request)
  let mut fresh = run storeOf(edited())
  let coldEdited = run checkBoth(&mut fresh, &mut request)
  run Testing.expect(warmEdited == coldEdited && coldEdited > usize.ZERO, "a partly warm check reports what a cold one does")
  run Testing.expect(Semantic.statistics(&changed).runs < Semantic.statistics(&fresh).runs, "a partly warm check runs less")

  // A revision of the warm store: an adopted check that the edit reaches sweeps again.
  let app = run module("app.silk")
  let shape = run module("shape.silk")
  let initial = run Revision.publish(&Revision.make(), &app, &run present(edited()))
  let revision = run Revision.publish(&initial, &shape, &run present(library()))
  run Semantic.update(&mut warm, move revision)
  let revised = run checkBoth(&mut warm, &mut request)
  run Testing.expect(revised == coldEdited, "an edit after adoption reaches the adopted checks")

  // An unlinked store, as a command line check makes: the checks it reuses rest on nothing in it,
  // so the image it writes carries them from the image it read, and still names what they read.
  let mut lone = run storeOf(edited())
  let unlinked = run Semantic.adoptCache(&mut lone, &request, &image, false)
  run Testing.expect(unlinked.roots > usize.ZERO && Semantic.carried(&lone).length == unlinked.roots,
    "an unlinked store carries every check it reused")
  let onceFound = run checkBoth(&mut lone, &mut request)
  run Testing.expect(onceFound == coldEdited, "an unlinked partly warm check reports what a cold one does")
  // As the driver writes it: a check written here rests on the carried ones it reused.
  let mut rewritten = run Semantic.cacheImage(&mut lone)
  let nodes = run CacheImage.carry(&mut rewritten, &image, Semantic.carried(&lone))
  run Semantic.imageCarriedChecks(&mut lone, &mut rewritten, List<usize>.asSlice(&nodes))
  run Semantic.imageCarriedFiles(&mut lone, &mut rewritten)
  let mut rereading = run storeOf(edited())
  let reread = run Semantic.adoptCache(&mut rereading, &request, &rewritten, false)
  run Testing.expect(reread.stale == usize.ZERO && reread.roots == List<CacheImage.Root>.length(&rewritten.roots)
    && reread.roots >= unlinked.roots, "the carried checks are reused again")
  let mut reverted = run storeOf(application())
  run Testing.expect(CacheImage.leafCount(&rewritten) > usize.ZERO, "a carried check still names the sources it read")
  drop run Semantic.adoptCache(&mut reverted, &request, &rewritten, false)
  let revertedFound = run checkBoth(&mut reverted, &mut request)
  run Testing.expect(revertedFound == usize.ZERO, "a revert after carrying reports what a cold check does")
  return ()
}

fn twoNames() -> string<'static> {
  return """
import lb.lib { one }
import l2.lib { two }
pub fn main() -> i32 {
  return one() + two()
}
"""
}

test effect fn adoptedChecksFollowThePackageGraph() -> ()
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run graphClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

// The program that imports package `lb` under the name `lb` and, when `aliased`, also under `l2`;
// `exported` is whether `lb` exports the module both import.
effect fn packagedStore(aliased: bool, exported: bool) -> Semantic
  ! InvalidModulePath | OutOfMemoryError
  ? &mut Allocator {
  let app = run ModuleId.make(b"memory", b"app@1.0.0", b"main.silk")
  let library = run ModuleId.make(b"memory", b"lb@1.0.0", b"lib.silk")
  let initial = run Revision.publish(&Revision.make(), &app, &run present(twoNames()))
  let revision = run Revision.publish(&initial, &library,
    &run present("pub fn one() -> i32 { return 1 }\npub fn two() -> i32 { return 2 }\n"))
  let mut graph = PackageGraph.make(&app)
  run PackageGraph.depend(&mut graph, b"app@1.0.0", b"lb", b"lb@1.0.0")
  if aliased { run PackageGraph.depend(&mut graph, b"app@1.0.0", b"l2", b"lb@1.0.0") }
  if exported { run PackageGraph.publish(&mut graph, b"lb@1.0.0", b"lib.silk") }
  let mut store = makeSemantic(move revision)
  Semantic.selectPackages(&mut store, move graph)
  return move store
}

effect fn checkApp(store: &mut Semantic, request: &mut Request) -> usize
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
  let app = run ModuleId.make(b"memory", b"app@1.0.0", b"main.silk")
  let checked = run Semantic.checkModule(&mut store.*, &mut request.*, &app, &Option<ModuleId>.none())
  return List<Shared<Rejection>>.length(&checked.rejections)
}

// Checks a store of the graph `aliased` and `exported` select after it adopts `image`, and a cold
// store of it, and gives whether both report the same nonzero count.
effect fn warmMatchesCold(image: &Image, request: &mut Request, aliased: bool, exported: bool) -> bool
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
  let mut warm = run packagedStore(aliased, exported)
  drop run Semantic.adoptCache(&mut warm, &request.*, image, false)
  let warmFound = run checkApp(&mut warm, &mut request.*)
  let mut cold = run packagedStore(aliased, exported)
  let coldFound = run checkApp(&mut cold, &mut request.*)
  return warmFound == coldFound && coldFound > usize.ZERO
}

effect fn graphClaims() -> ()
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator | &mut Types {
  let mut request = Request.make()
  let mut cold = run packagedStore(true, true)
  let coldFound = run checkApp(&mut cold, &mut request)
  run Testing.expect(coldFound == usize.ZERO, "a package imported under two names checks clean")
  let image = run Semantic.cacheImage(&mut cold)

  let mut same = run packagedStore(true, true)
  drop run Semantic.adoptCache(&mut same, &request, &image, true)
  let sameFound = run checkApp(&mut same, &mut request)
  run Testing.expect(sameFound == usize.ZERO && Semantic.statistics(&same).runs == usize.ZERO,
    "the same graph reuses every check")

  // The other name of the package still loads it, so only the resolution of the dropped name
  // tells the import apart.
  let dropped = run warmMatchesCold(&image, &mut request, false, true)
  run Testing.expect(dropped, "an import of a dependency name the graph no longer lists is unknown, as a cold check reports")
  let internal = run warmMatchesCold(&image, &mut request, true, false)
  run Testing.expect(internal, "a module the dependency no longer exports is internal, as a cold check reports")
  return ()
}

test effect fn carriedChecksKeepTheFilesTheyRead() -> ()
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run carryClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

// The two modules beside the program, which import nothing it imports.
effect fn sideStore(text: string<'static>) -> Semantic
  ! InvalidModulePath | OutOfMemoryError
  ? &mut Allocator {
  let app = run module("app.silk")
  let shape = run module("shape.silk")
  let extra = run module("extra.silk")
  let tool = run module("tool.silk")
  let first = run Revision.publish(&Revision.make(), &app, &run present(text))
  let second = run Revision.publish(&first, &shape, &run present(library()))
  let third = run Revision.publish(&second, &extra,
    &run present("import tool { one }\npub fn two() -> i32 {\n  return one() + one()\n}\n"))
  return makeSemantic(run Revision.publish(&third, &tool, &run present("pub fn one() -> i32 {\n  return 1\n}\n")))
}

effect fn checkAll(store: &mut Semantic, request: &mut Request) -> usize
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
  let extra = run module("extra.silk")
  let tool = run module("tool.silk")
  let found = run checkBoth(&mut store.*, &mut request.*)
  let first = run Semantic.checkModule(&mut store.*, &mut request.*, &extra, &Option<ModuleId>.none())
  let second = run Semantic.checkModule(&mut store.*, &mut request.*, &tool, &Option<ModuleId>.none())
  return found + List<Shared<Rejection>>.length(&first.rejections) + List<Shared<Rejection>>.length(&second.rejections)
}

effect fn carryClaims() -> ()
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator | &mut Types {
  let mut request = Request.make()
  let mut cold = run sideStore(application())
  let coldFound = run checkAll(&mut cold, &mut request)
  run Testing.expect(coldFound == usize.ZERO, "the program and its side modules check clean")
  let image = run Semantic.cacheImage(&mut cold)

  // Only the program's check runs again, so no check here reads `extra`'s import or the
  // `tool/mod.silk` it might have named, which does not exist.
  let mut lone = run sideStore(edited())
  drop run Semantic.adoptCache(&mut lone, &request, &image, false)
  drop run checkAll(&mut lone, &mut request)
  let mut rewritten = run Semantic.cacheImage(&mut lone)
  drop run CacheImage.carry(&mut rewritten, &image, Semantic.carried(&lone))
  run Semantic.imageCarriedFiles(&mut lone, &mut rewritten)
  let mut again = run sideStore(edited())
  let reread = run Semantic.adoptCache(&mut again, &request, &rewritten, false)
  run Testing.expect(reread.changedLeaves == usize.ZERO && reread.stale == usize.ZERO,
    "a carried check finds the sources it read unchanged again, a missing import candidate among them")
  return ()
}

test effect fn adoptedDeclarationChecksSurviveASiblingEdit() -> ()
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run siblingClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

// The image the driver writes after `store`, which adopted `read`, checked.
effect fn rewrittenImage(store: &mut Semantic, read: &Image) -> Image
  ! Cycle | OutOfMemoryError
  ? &mut Allocator {
  let mut rewritten = run Semantic.cacheImage(&mut store.*)
  let mut carried = List<usize>.make()
  let checks = Semantic.carried(&store.*)
  let definitions = Semantic.carriedDefinitions(&store.*)
  let mut at = usize.ZERO
  while at < checks.length + definitions.length {
    if at < checks.length { run List<usize>.append(&mut carried, checks[at]) }
    else { run List<usize>.append(&mut carried, definitions[at - checks.length]) }
    at = at + usize.ONE
  }
  let nodes = run CacheImage.carry(&mut rewritten, read, List<usize>.asSlice(&carried))
  run Semantic.imageCarriedChecks(&mut store.*, &mut rewritten, List<usize>.asSlice(&nodes))
  run Semantic.imageReplayedChecks(&store.*, &mut rewritten)
  run Semantic.imageCarriedFiles(&mut store.*, &mut rewritten)
  return move rewritten
}

effect fn pairStore(text: string<'static>) -> Semantic
  ! InvalidModulePath | OutOfMemoryError
  ? &mut Allocator {
  let pair = run module("pair.silk")
  return makeSemantic(run Revision.publish(&Revision.make(), &pair, &run present(text)))
}

effect fn checkPair(store: &mut Semantic, request: &mut Request) -> usize
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
  let pair = run module("pair.silk")
  let checked = run Semantic.checkModule(&mut store.*, &mut request.*, &pair, &Option<ModuleId>.none())
  return List<Shared<Rejection>>.length(&checked.rejections)
}

// A module whose second function is edited: its sweep runs again, but the first function's check
// is reused, and so is its MIR in the replayed escape check, so the warm check types fewer bodies
// than a cold one and reports what it reports.
effect fn siblingClaims() -> ()
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator | &mut Types {
  let mut request = Request.make()
  let mut cold = run pairStore("pub fn first() -> i32 {\n  return 1\n}\npub fn second() -> i32 {\n  return 2\n}\n")
  let coldFound = run checkPair(&mut cold, &mut request)
  run Testing.expect(coldFound == usize.ZERO, "the pair checks clean")
  let image = run Semantic.cacheImage(&mut cold)
  let edited = "pub fn first() -> i32 {\n  return 1\n}\npub fn second() -> i32 {\n  return 2 + 3\n}\n"
  let mut warm = run pairStore(edited)
  let adopted = run Semantic.adoptCache(&mut warm, &request, &image, false)
  let warmFound = run checkPair(&mut warm, &mut request)
  let mut fresh = run pairStore(edited)
  let freshFound = run checkPair(&mut fresh, &mut request)
  run Testing.expect(adopted.stale > usize.ZERO && warmFound == freshFound,
    "a sibling edit reports what a cold check does")
  run Testing.expect(starts(Semantic.eventLog(&warm), Family.Body) < starts(Semantic.eventLog(&fresh), Family.Body),
    "a sibling edit leaves the unchanged function's body unchecked")

  // The sweep that ran again rests on the reused check's carried node, so the image the driver
  // writes keeps it, and the next check of the same sources runs nothing.
  let rewritten = run rewrittenImage(&mut warm, &image)
  let mut again = run pairStore(edited)
  let reread = run Semantic.adoptCache(&mut again, &request, &rewritten, false)
  let againFound = run checkPair(&mut again, &mut request)
  run Testing.expect(reread.stale == usize.ZERO && againFound == freshFound && Semantic.statistics(&again).runs == usize.ZERO,
    "a sweep that reused a carried check is written on it and reused next")
  return ()
}

test effect fn adoptedChecksKeepAStructAndItsImplApart() -> ()
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run namesakeClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

// A struct and the `impl` block of the same name are two declaration checks: an edit elsewhere in
// the module reuses both, so the warm check checks neither again.
effect fn namesakeClaims() -> ()
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator | &mut Types {
  let mut request = Request.make()
  let text = "pub struct Box {\n  value: i32,\n}\nimpl Box {\n  pub fn get(self: &Self) -> i32 {\n    return self.value\n  }\n}\npub fn second() -> i32 {\n  return 2\n}\n"
  let mut cold = run pairStore(text)
  let coldFound = run checkPair(&mut cold, &mut request)
  run Testing.expect(coldFound == usize.ZERO, "the namesakes check clean")
  let image = run Semantic.cacheImage(&mut cold)
  let edited = "pub struct Box {\n  value: i32,\n}\nimpl Box {\n  pub fn get(self: &Self) -> i32 {\n    return self.value\n  }\n}\npub fn second() -> i32 {\n  return 2 + 3\n}\n"
  let mut warm = run pairStore(edited)
  drop run Semantic.adoptCache(&mut warm, &request, &image, false)
  let warmFound = run checkPair(&mut warm, &mut request)
  run Testing.expect(warmFound == usize.ZERO, "the edit checks clean")
  let events = Semantic.eventLog(&warm)
  run Testing.expect(starts(events, Family.Members) == usize.ZERO && starts(events, Family.ImplementationHead) == usize.ZERO,
    "an edit elsewhere checks neither the struct nor its impl again")
  return ()
}

test effect fn escapeRecordsOutliveABrokenEdit() -> ()
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run brokenClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

// An edit that breaks a body makes the escape check report. It replays the walk up to the broken
// body, lowering only what the edit reached, and records nothing; the image it writes still holds
// the walk record it read, which the check replays once the body is fixed, lowering only the
// fixed body's MIR.
effect fn brokenClaims() -> ()
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator | &mut Types {
  let mut request = Request.make()
  let clean = "pub fn first() -> i32 {\n  return second()\n}\npub fn second() -> i32 {\n  return 2\n}\npub fn third() -> i32 {\n  return 3\n}\n"
  let mut cold = run pairStore(clean)
  let coldFound = run checkPair(&mut cold, &mut request)
  run Testing.expect(coldFound == usize.ZERO, "the pair checks clean")
  let image = run Semantic.cacheImage(&mut cold)
  let broken = "pub fn first() -> i32 {\n  return second()\n}\npub fn second() -> i32 {\n  return true\n}\npub fn third() -> i32 {\n  return 3\n}\n"
  let mut warm = run pairStore(broken)
  drop run Semantic.adoptCache(&mut warm, &request, &image, false)
  let warmFound = run checkPair(&mut warm, &mut request)
  let mut fresh = run pairStore(broken)
  let freshFound = run checkPair(&mut fresh, &mut request)
  run Testing.expect(warmFound > usize.ZERO && warmFound == freshFound, "a broken body reports what a cold check does")
  run Testing.expect(starts(Semantic.eventLog(&warm), Family.Mir) < starts(Semantic.eventLog(&fresh), Family.Mir),
    "the broken check replays the walk instead of lowering every body again")
  let rewritten = run rewrittenImage(&mut warm, &image)
  let mut fixed = run pairStore(clean)
  drop run Semantic.adoptCache(&mut fixed, &request, &rewritten, false)
  let fixedFound = run checkPair(&mut fixed, &mut request)
  let mut fixedCold = run pairStore(clean)
  drop run checkPair(&mut fixedCold, &mut request)
  run Testing.expect(fixedFound == usize.ZERO, "the fixed pair checks clean")
  run Testing.expect(starts(Semantic.eventLog(&fixed), Family.Mir) < starts(Semantic.eventLog(&fixedCold), Family.Mir),
    "the fix replays the walk the broken check kept instead of lowering every body again")
  return ()
}

test effect fn brokenWalksKeepTheirRecord() -> ()
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run brokenWalkClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

// A cold walk that reaches a body that lowers to nothing records the walk with that body as an
// entry. An edit elsewhere replays the record, which lowers the broken body again and reports it
// where a cold walk does, instead of walking every body again.
effect fn brokenWalkClaims() -> ()
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator | &mut Types {
  let mut request = Request.make()
  let broken = "pub fn first() -> i32 {\n  return second()\n}\npub fn second() -> i32 {\n  return true\n}\npub fn third() -> i32 {\n  return fourth()\n}\npub fn fourth() -> i32 {\n  return 4\n}\n"
  let mut cold = run pairStore(broken)
  let coldFound = run checkPair(&mut cold, &mut request)
  run Testing.expect(coldFound > usize.ZERO, "the broken pair reports")
  let image = run Semantic.cacheImage(&mut cold)
  let edited = "pub fn first() -> i32 {\n  return second()\n}\npub fn second() -> i32 {\n  return true\n}\npub fn third() -> i32 {\n  return fourth()\n}\npub fn fourth() -> i32 {\n  return 5\n}\n"
  let mut warm = run pairStore(edited)
  drop run Semantic.adoptCache(&mut warm, &request, &image, false)
  let warmFound = run checkPair(&mut warm, &mut request)
  let mut fresh = run pairStore(edited)
  let freshFound = run checkPair(&mut fresh, &mut request)
  run Testing.expect(warmFound == freshFound, "an edit beside a broken body reports what a cold check does")
  run Testing.expect(starts(Semantic.eventLog(&warm), Family.Mir) < starts(Semantic.eventLog(&fresh), Family.Mir),
    "an edit beside a broken body replays the walk the broken check recorded")
  return ()
}

test effect fn deferredTemplatesKeepTheirSweep() -> ()
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run deferredClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

// A module whose sweep defers a body awaiting a static argument writes its sweep to the image
// with the deferred body beside it, so a warm check of the same sources sweeps nothing and still
// names the deferred body.
effect fn deferredClaims() -> ()
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator | &mut Types {
  let mut request = Request.make()
  let text = "pub fn first() -> i32 {\n  return 1\n}\nfn pending(static input: bool) -> i32 {\n  static if input { return 1 } else { return 0 }\n}\n"
  let mut cold = run pairStore(text)
  let coldFound = run checkPair(&mut cold, &mut request)
  let coldDeferred = Semantic.deferredStaticTemplates(&cold)
  run Testing.expect(coldFound == usize.ZERO && coldDeferred.length == usize.ONE
    && DeclarationId.named(&coldDeferred[usize.ZERO].declaration, b"pending"), "the cold sweep defers the static body")
  let image = run Semantic.cacheImage(&mut cold)
  let mut warm = run pairStore(text)
  let adopted = run Semantic.adoptCache(&mut warm, &request, &image, false)
  run Testing.expect(adopted.roots > usize.ZERO && adopted.stale == usize.ZERO, "the deferring sweep is in the image")
  let warmFound = run checkPair(&mut warm, &mut request)
  let warmDeferred = Semantic.deferredStaticTemplates(&warm)
  run Testing.expect(warmFound == coldFound && Semantic.moduleCheckRuns(&warm) == usize.ZERO,
    "a warm check of a deferring module sweeps nothing")
  run Testing.expect(warmDeferred.length == usize.ONE && DeclarationId.named(&warmDeferred[usize.ZERO].declaration, b"pending"),
    "a warm check names the body the cold sweep deferred")
  return ()
}

test effect fn staticEvaluationReadsOnlyItsDeclarations() -> ()
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run evaluationClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

// `size` evaluates `width`, and `first`'s parameter and `third`'s call are checked against its
// value. An edit to `second`, which neither reads, reuses the constant; an edit to `width`
// reaches `third`'s check.
fn evaluated(width: u8, second: u8) -> string<'static> {
  if width == 5 {
    return """static fn width() -> usize {
  return 5
}
const size: usize = width()
pub fn first(bytes: [u8; size]) -> u8 {
  return bytes[0]
}
pub fn second() -> i32 {
  return 2
}
pub fn third() -> u8 {
  let bytes: [u8; 4] = [1, 2, 3, 4]
  return first(bytes)
}
"""
  }
  if second == 3 {
    return """static fn width() -> usize {
  return 4
}
const size: usize = width()
pub fn first(bytes: [u8; size]) -> u8 {
  return bytes[0]
}
pub fn second() -> i32 {
  return 2 + 3
}
pub fn third() -> u8 {
  let bytes: [u8; 4] = [1, 2, 3, 4]
  return first(bytes)
}
"""
  }
  return """static fn width() -> usize {
  return 4
}
const size: usize = width()
pub fn first(bytes: [u8; size]) -> u8 {
  return bytes[0]
}
pub fn second() -> i32 {
  return 2
}
pub fn third() -> u8 {
  let bytes: [u8; 4] = [1, 2, 3, 4]
  return first(bytes)
}
"""
}

effect fn evaluationClaims() -> ()
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator | &mut Types {
  let mut request = Request.make()
  let mut cold = run pairStore(evaluated(4, 2))
  let coldFound = run checkPair(&mut cold, &mut request)
  run Testing.expect(coldFound == usize.ZERO, "the evaluated pair checks clean")
  let image = run Semantic.cacheImage(&mut cold)

  let mut sibling = run pairStore(evaluated(4, 3))
  drop run Semantic.adoptCache(&mut sibling, &request, &image, false)
  let siblingFound = run checkPair(&mut sibling, &mut request)
  let mut siblingCold = run pairStore(evaluated(4, 3))
  let siblingColdFound = run checkPair(&mut siblingCold, &mut request)
  run Testing.expect(siblingFound == usize.ZERO && siblingColdFound == usize.ZERO, "a sibling edit checks clean")
  run Testing.expect(starts(Semantic.eventLog(&sibling), Family.Initializer) == usize.ZERO
    && starts(Semantic.eventLog(&siblingCold), Family.Initializer) > usize.ZERO,
    "a sibling edit reuses the evaluated constant")

  let mut callee = run pairStore(evaluated(5, 2))
  drop run Semantic.adoptCache(&mut callee, &request, &image, false)
  let calleeFound = run checkPair(&mut callee, &mut request)
  let mut calleeCold = run pairStore(evaluated(5, 2))
  let calleeColdFound = run checkPair(&mut calleeCold, &mut request)
  run Testing.expect(calleeColdFound > usize.ZERO && calleeFound == calleeColdFound,
    "an edit to the evaluated function reports what a cold check does")
  return ()
}

test effect fn cleanChecksSurviveMovedLines() -> ()
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run movedClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

// The `Printable` head stores where it is written, so a line inserted above it moves what its check
// rests on. The clean checks hold no position, so they are reused; a type error inserted with the
// line is still reported where a cold check reports it, and the escape walk the image recorded
// is replayed rather than walked again.
effect fn movedClaims() -> ()
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator | &mut Types {
  let mut request = Request.make()
  let written = "pub interface Printable { fn print(value: &Self) -> i32 }\npub struct Document {}\nimpl Printable for Document { fn print(value: &Self) -> i32 { return 42 } }\npub fn first(value: &Document) -> i32 {\n  return value.print()\n}\n"
  let mut cold = run pairStore(written)
  let coldFound = run checkPair(&mut cold, &mut request)
  run Testing.expect(coldFound == usize.ZERO, "the moved pair checks clean")
  let image = run Semantic.cacheImage(&mut cold)
  let moved = "\npub interface Printable { fn print(value: &Self) -> i32 }\npub struct Document {}\nimpl Printable for Document { fn print(value: &Self) -> i32 { return 42 } }\npub fn first(value: &Document) -> i32 {\n  return value.print()\n}\n"
  let mut warm = run pairStore(moved)
  let adopted = run Semantic.adoptCache(&mut warm, &request, &image, false)
  let warmFound = run checkPair(&mut warm, &mut request)
  run Testing.expect(adopted.changedLeaves > usize.ZERO && adopted.roots > usize.ZERO && warmFound == usize.ZERO,
    "a moved line leaves the clean checks reused")
  run Testing.expect(starts(Semantic.eventLog(&warm), Family.Body) == usize.ZERO, "a moved line checks no body again")
  let broken = "pub fn second() -> i32 {\n  return true\n}\npub interface Printable { fn print(value: &Self) -> i32 }\npub struct Document {}\nimpl Printable for Document { fn print(value: &Self) -> i32 { return 42 } }\npub fn first(value: &Document) -> i32 {\n  return value.print()\n}\n"
  let mut warmBroken = run pairStore(broken)
  drop run Semantic.adoptCache(&mut warmBroken, &request, &image, false)
  let warmBrokenFound = run checkPair(&mut warmBroken, &mut request)
  let mut freshBroken = run pairStore(broken)
  let freshBrokenFound = run checkPair(&mut freshBroken, &mut request)
  run Testing.expect(freshBrokenFound > usize.ZERO && warmBrokenFound == freshBrokenFound,
    "an error above the moved checks reports what a cold check does")

  // An error that moves the head: the escape walk the image recorded is replayed, so only the
  // broken body is lowered again.
  let calling = "pub fn first(value: &Document) -> i32 {\n  return value.print()\n}\npub fn second() -> i32 {\n  return 2\n}\npub interface Printable { fn print(value: &Self) -> i32 }\npub struct Document {}\nimpl Printable for Document { fn print(value: &Self) -> i32 { return 42 } }\n"
  let mut callingCold = run pairStore(calling)
  let callingFound = run checkPair(&mut callingCold, &mut request)
  run Testing.expect(callingFound == usize.ZERO, "the calling pair checks clean")
  let callingImage = run Semantic.cacheImage(&mut callingCold)
  let shifted = "pub fn first(value: &Document) -> i32 {\n  return value.print()\n}\npub fn second() -> i32 {\n  return true\n}\npub interface Printable { fn print(value: &Self) -> i32 }\npub struct Document {}\nimpl Printable for Document { fn print(value: &Self) -> i32 { return 42 } }\n"
  let mut shiftedWarm = run pairStore(shifted)
  drop run Semantic.adoptCache(&mut shiftedWarm, &request, &callingImage, false)
  let shiftedFound = run checkPair(&mut shiftedWarm, &mut request)
  let mut shiftedFresh = run pairStore(shifted)
  let shiftedFreshFound = run checkPair(&mut shiftedFresh, &mut request)
  run Testing.expect(shiftedFreshFound > usize.ZERO && shiftedFound == shiftedFreshFound,
    "an error that moves a head reports what a cold check does")
  run Testing.expect(starts(Semantic.eventLog(&shiftedWarm), Family.Mir) < starts(Semantic.eventLog(&shiftedFresh), Family.Mir),
    "an error that moves a head replays the escape walk instead of lowering every body again")
  return ()
}

test effect fn changedCalleeOfABrokenCallerReplays() -> ()
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run brokenCallerClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

// `caller` is walked first and reaches `digest` before `digest` starts a walk of its own. An edit
// to `digest`'s signature breaks `caller`, so the record names `digest` only below a body that now
// lowers to nothing. The replay still lowers `digest` as the root it is, finds it summarizes as the
// record says, and leaves `helper` and `other` alone.
effect fn brokenCallerClaims() -> ()
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator | &mut Types {
  let mut request = Request.make()
  let written = "pub fn digest(left: i32, right: i32) -> bool {\n  return left == right\n}\npub fn helper() -> i32 {\n  return 1\n}\npub fn other() -> i32 {\n  return helper()\n}\npub fn caller() -> bool {\n  return digest(1, 2)\n}\n"
  let mut cold = run pairStore(written)
  let coldFound = run checkPair(&mut cold, &mut request)
  run Testing.expect(coldFound == usize.ZERO, "the calling module checks clean")
  let image = run Semantic.cacheImage(&mut cold)
  let edited = "pub fn digest(left: i32, right: bool) -> bool {\n  return right\n}\npub fn helper() -> i32 {\n  return 1\n}\npub fn other() -> i32 {\n  return helper()\n}\npub fn caller() -> bool {\n  return digest(1, 2)\n}\n"
  let mut warm = run pairStore(edited)
  drop run Semantic.adoptCache(&mut warm, &request, &image, false)
  let warmFound = run checkPair(&mut warm, &mut request)
  let mut fresh = run pairStore(edited)
  let freshFound = run checkPair(&mut fresh, &mut request)
  run Testing.expect(freshFound > usize.ZERO && warmFound == freshFound, "a callee edit that breaks its caller reports what a cold check does")
  run Testing.expect(starts(Semantic.eventLog(&warm), Family.Mir) < starts(Semantic.eventLog(&fresh), Family.Mir),
    "a callee edit that breaks its caller replays the escape walk instead of lowering every body again")
  return ()
}

test effect fn tupleTypesSurviveEditsAbove() -> ()
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run tupleClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

// `second` passes a tuple to `keep`, which calls `first`. An edit to `first`'s body renumbers the
// module's syntax below it, but the tuple's type is named relative to `second`, so the walk the
// image recorded still names `keep` for that tuple and is replayed: only the bodies on the way to
// `first` are lowered, not `third` or `fourth`.
effect fn tupleClaims() -> ()
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator | &mut Types {
  let mut request = Request.make()
  let written = "pub fn first() -> i32 {\n  return 1\n}\nfn keep<T>(value: T) -> T {\n  drop first()\n  return move value\n}\npub fn second() -> i32 {\n  drop keep((1, 2))\n  return 2\n}\npub fn third() -> i32 {\n  return 3\n}\npub fn fourth() -> i32 {\n  return third()\n}\n"
  let mut cold = run pairStore(written)
  let coldFound = run checkPair(&mut cold, &mut request)
  run Testing.expect(coldFound == usize.ZERO, "the tuple module checks clean")
  let image = run Semantic.cacheImage(&mut cold)
  let edited = "pub fn first() -> i32 {\n  return 1 + 0\n}\nfn keep<T>(value: T) -> T {\n  drop first()\n  return move value\n}\npub fn second() -> i32 {\n  drop keep((1, 2))\n  return 2\n}\npub fn third() -> i32 {\n  return 3\n}\npub fn fourth() -> i32 {\n  return third()\n}\n"
  let mut warm = run pairStore(edited)
  drop run Semantic.adoptCache(&mut warm, &request, &image, false)
  let warmFound = run checkPair(&mut warm, &mut request)
  let mut fresh = run pairStore(edited)
  let freshFound = run checkPair(&mut fresh, &mut request)
  run Testing.expect(warmFound == usize.ZERO && freshFound == usize.ZERO, "the edited tuple module checks clean")
  run Testing.expect(starts(Semantic.eventLog(&warm), Family.Mir) < starts(Semantic.eventLog(&fresh), Family.Mir),
    "an edit above a tuple literal replays the escape walk instead of lowering every body again")
  return ()
}

test effect fn reportingChecksAreReusedWhileTheirFilesHold() -> ()
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run reportingClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

// What both modules report, one word per code, span bound and message argument, in order.
effect fn reported(store: &mut Semantic, request: &mut Request) -> List<u64>
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
  let mut words = List<u64>.make()
  let app = run module("app.silk")
  let shape = run module("shape.silk")
  let first = run Semantic.checkModule(&mut store.*, &mut request.*, &app, &Option<ModuleId>.none())
  let second = run Semantic.checkModule(&mut store.*, &mut request.*, &shape, &Option<ModuleId>.none())
  run describe(&mut words, List<Shared<Rejection>>.asSlice(&first.rejections))
  run describe(&mut words, List<Shared<Rejection>>.asSlice(&second.rejections))
  return move words
}

effect fn describe(words: &mut List<u64>, rejections: &[Shared<Rejection>]) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < rejections.length {
    let code = Shared<Rejection>.with<u16>(&rejections[at], fn(held: &Rejection) -> u16 { return RejectionCode.value(held.code) })
    let span = Shared<Rejection>.with<Span>(&rejections[at], fn(held: &Rejection) -> Span { return held.span })
    let arguments = Shared<Rejection>.with<usize>(&rejections[at], fn(held: &Rejection) -> usize {
      return List<MessageArgument>.length(&held.arguments)
    })
    run List<u64>.append(&mut words.*, u16.toU64(code))
    run List<u64>.append(&mut words.*, usize.toU64(span.start))
    run List<u64>.append(&mut words.*, usize.toU64(span.end))
    run List<u64>.append(&mut words.*, usize.toU64(arguments))
    at = at + usize.ONE
  }
}

fn sameWords(left: &List<u64>, right: &List<u64>) -> bool {
  let first = List<u64>.asSlice(&left.*)
  let second = List<u64>.asSlice(&right.*)
  if first.length != second.length { return false }
  let mut at = usize.ZERO
  while at < first.length {
    if first[at] != second[at] { return false }
    at = at + usize.ONE
  }
  return true
}

// A check that reports is written with its rejections. A store of the same sources reports them
// again without checking; one whose file moved the spans checks again, since the image's spans
// point at bytes that are no longer there.
effect fn reportingClaims() -> ()
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator | &mut Types {
  let mut request = Request.make()
  let mut cold = run storeOf(edited())
  let coldFound = run reported(&mut cold, &mut request)
  run Testing.expect(List<u64>.length(&coldFound) > usize.ZERO, "the edit reports")
  let image = run Semantic.cacheImage(&mut cold)

  let mut warm = run storeOf(edited())
  let adopted = run Semantic.adoptCache(&mut warm, &request, &image, false)
  run Testing.expect(adopted.stale == usize.ZERO, "a reporting check of unchanged sources is reused")
  let warmFound = run reported(&mut warm, &mut request)
  run Testing.expect(sameWords(&warmFound, &coldFound), "a reused check reports what the cold one did")
  run Testing.expect(Semantic.statistics(&warm).runs == usize.ZERO, "a reused reporting check runs nothing")

  let mut moved = run storeOf(shifted())
  let shiftedAdoption = run Semantic.adoptCache(&mut moved, &request, &image, false)
  run Testing.expect(shiftedAdoption.stale > usize.ZERO, "a reporting check whose spans moved is not reused")
  let movedFound = run reported(&mut moved, &mut request)
  let mut fresh = run storeOf(shifted())
  let freshFound = run reported(&mut fresh, &mut request)
  run Testing.expect(sameWords(&movedFound, &freshFound) && !sameWords(&movedFound, &coldFound),
    "a check whose spans moved reports where a cold one does")
  return ()
}

fn shifted() -> string<'static> {
  return """

import shape { Point, origin }
fn norm(point: &Point) -> i32 {
  return point.x + point.z
}
pub fn main() -> i32 {
  let first = origin()
  return norm(&first)
}
"""
}

test effect fn reportingReplaysAreReused() -> ()
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run replayReportClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

// An edit that breaks a generic body makes the escape check that replays the walk through its
// instance report. The image written after it holds that check with what it reports, so the
// next check of the same sources reports it without replaying; a fix replays again.
effect fn replayReportClaims() -> ()
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator | &mut Types {
  let mut request = Request.make()
  let clean = "pub fn first() -> i32 {\n  let one: i32 = 1\n  return second(one)\n}\npub fn second<T>(value: T) -> T {\n  return move value\n}\n"
  let broken = "pub fn first() -> i32 {\n  let one: i32 = 1\n  return second(one)\n}\npub fn second<T>(value: T) -> T {\n  let wrong: u32 = 5\n  let bad: bool = wrong\n  return move value\n}\n"
  let mut cold = run pairStore(clean)
  let coldFound = run checkPair(&mut cold, &mut request)
  run Testing.expect(coldFound == usize.ZERO, "the pair checks clean")
  let image = run Semantic.cacheImage(&mut cold)
  let mut warm = run pairStore(broken)
  drop run Semantic.adoptCache(&mut warm, &request, &image, false)
  let warmFound = run checkPair(&mut warm, &mut request)
  let mut fresh = run pairStore(broken)
  let freshFound = run checkPair(&mut fresh, &mut request)
  run Testing.expect(warmFound > usize.ZERO && warmFound == freshFound, "a broken generic body reports what a cold check does")
  let rewritten = run rewrittenImage(&mut warm, &image)
  let mut again = run pairStore(broken)
  let adopted = run Semantic.adoptCache(&mut again, &request, &rewritten, false)
  run Testing.expect(adopted.stale == usize.ZERO, "every check of the unchanged broken pair is reused")
  let againFound = run checkPair(&mut again, &mut request)
  run Testing.expect(againFound == freshFound, "a reused check reports what a cold one does")
  run Testing.expect(Semantic.statistics(&again).runs == usize.ZERO, "a reused reporting replay runs nothing")
  let mut fixed = run pairStore(clean)
  drop run Semantic.adoptCache(&mut fixed, &request, &rewritten, false)
  let fixedFound = run checkPair(&mut fixed, &mut request)
  run Testing.expect(fixedFound == usize.ZERO, "the fixed pair checks clean")
  return ()
}

test effect fn carriedInputsKeepTheFileTheyWereRead() -> ()
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run insertedClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn shapedStore(text: string<'static>, shape: string<'static>) -> Semantic
  ! InvalidModulePath | OutOfMemoryError
  ? &mut Allocator {
  let app = run module("app.silk")
  let library = run module("shape.silk")
  let initial = run Revision.publish(&Revision.make(), &app, &run present(text))
  return makeSemantic(run Revision.publish(&initial, &library, &run present(shape)))
}

// A declaration inserted above `origin` moves it. The program's check, reused unlinked after the
// insertion, is carried with what it read before; the next store must not place `origin` where
// it sat then, where `flag` sits now, although `shape` reads as the written image recorded it.
effect fn insertedClaims() -> ()
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator | &mut Types {
  let mut request = Request.make()
  let inserted = "pub struct Point {pub x: i32, pub y: i32}\npub fn flag() -> bool {\n  return true\n}\npub fn origin() -> Point {\n  return Point { x: 0, y: 0 }\n}\n"
  let flagged = "import shape { Point, flag, origin }\nfn norm(point: &Point) -> i32 {\n  return point.x + point.y\n}\npub fn main() -> i32 {\n  let first = origin()\n  let on: bool = flag()\n  if on { return norm(&first) }\n  return 0\n}\n"
  let mut cold = run shapedStore(application(), library())
  let coldFound = run checkBoth(&mut cold, &mut request)
  run Testing.expect(coldFound == usize.ZERO, "the program checks clean")
  let image = run Semantic.cacheImage(&mut cold)
  let mut moved = run shapedStore(application(), inserted)
  drop run Semantic.adoptCache(&mut moved, &request, &image, false)
  // Only the program is checked, so the image written next holds `shape` only as that check read it.
  let app = run module("app.silk")
  let movedFound = run Semantic.checkModule(&mut moved, &mut request, &app, &Option<ModuleId>.none())
  run Testing.expect(List<Shared<Rejection>>.length(&movedFound.rejections) == usize.ZERO && Semantic.carried(&moved).length > usize.ZERO,
    "the program's check is reused across the insertion")
  let rewritten = run rewrittenImage(&mut moved, &image)
  let mut fresh = run shapedStore(flagged, inserted)
  let freshFound = run checkBoth(&mut fresh, &mut request)
  run Testing.expect(freshFound == usize.ZERO, "the program that calls `flag` checks clean")
  let mut warm = run shapedStore(flagged, inserted)
  drop run Semantic.adoptCache(&mut warm, &request, &rewritten, false)
  let warmFound = run checkBoth(&mut warm, &mut request)
  run Testing.expect(warmFound == freshFound, "a warm check after the insertion reports what a cold one does")
  return ()
}

test effect fn movedDefinitionsKeepTheirCode() -> ()
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run movedCodeClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

fn entryRuntime() -> string<'static> {
  return "import Intrinsic.application\nexport \"C\" fn enter(count: i32, values: ?[*]const u8) -> i32 as \"main\" { return application.answer(count) }\n"
}

fn steps() -> string<'static> {
  return "pub struct Box {pub value: i32}\nimpl Box {\n  pub fn get(self: &Box) -> i32 {\n    return self.value\n  }\n}\npub fn answer(count: i32) -> i32 {\n  let held = Box {value: count}\n  return held.get()\n}\n"
}

// A store that builds `steps` text into codegen units, as `silk build` does, offered `bodies`.
effect fn unitStore(text: string<'static>, bodies: List<BuildRecord.PackBody>) -> Semantic
  ! InvalidModulePath | OutOfMemoryError
  ? &mut Allocator {
  let runtime = run module("runtime.silk")
  let application = run module("steps.silk")
  let initial = run Revision.publish(&Revision.make(), &runtime, &run present(entryRuntime()))
  let mut store = Semantic.traced(run Revision.publish(&initial, &application, &run present(text)),
    MachineTarget.forId(TargetId.X8664UnknownLinuxGnu), Option<FinalProfile>.none())
  Semantic.selectCodegenUnits(&mut store, true)
  Semantic.offerPacks(&mut store, move bodies)
  return move store
}

effect fn unitBuild(store: &mut Semantic) -> List<CodegenUnit>
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
  let runtime = run module("runtime.silk")
  let application = run module("steps.silk")
  let mut request = Request.forApplication(ModuleId.copy(&application))
  let roots = [ModuleId.copy(&runtime), ModuleId.copy(&application)]
  let built = run Semantic.buildArtifact(&mut store.*, &mut request, Option<&ModuleId>.some(&runtime), &roots, &roots, staticClosureNodes)
  return match move built {
    BackendBuild.Module {units, ..} => move units
    _ => List<CodegenUnit>.make()
  }
}

// Whether every unit that defines a function was taken from a held pack unread.
fn allStored(units: &List<CodegenUnit>) -> bool {
  let listed = List<CodegenUnit>.asSlice(units)
  let mut at = usize.ZERO
  while at < listed.length {
    if !listed[at].stored && Bitcode.definesAnyFunction(Bytes.asSlice(&listed[at].body)) { return false }
    at = at + usize.ONE
  }
  return true
}

// A declaration inserted above both functions moves them without changing them. A build that
// adopts the image of the build before reuses their code, which is the code a cold build of the
// moved text emits. The method call matters: the build of `answer` reads where one of its sites
// sits, which the insertion moves.
effect fn movedCodeClaims() -> ()
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator | &mut Types {
  let moved = "const unused: i32 = 0\npub struct Box {pub value: i32}\nimpl Box {\n  pub fn get(self: &Box) -> i32 {\n    return self.value\n  }\n}\npub fn answer(count: i32) -> i32 {\n  let held = Box {value: count}\n  return held.get()\n}\n"
  let mut cold = run unitStore(steps(), List<BuildRecord.PackBody>.make())
  let coldUnits = run unitBuild(&mut cold)
  run Testing.expect(List<CodegenUnit>.length(&coldUnits) > usize.ZERO && !allStored(&coldUnits), "a cold build emits its units")
  let image = run Semantic.cacheImage(&mut cold)
  let mut warm = run unitStore(moved, run packBodies(&coldUnits))
  let request = Request.forApplication(run module("steps.silk"))
  drop run Semantic.adoptCache(&mut warm, &request, &image, false)
  let warmUnits = run unitBuild(&mut warm)
  run Testing.expect(List<CodegenUnit>.length(&warmUnits) > usize.ZERO && allStored(&warmUnits),
    "a build after the insertion emits no function again")
  let mut fresh = run unitStore(moved, List<BuildRecord.PackBody>.make())
  let freshUnits = run unitBuild(&mut fresh)
  let warmListed = List<CodegenUnit>.asSlice(&warmUnits)
  let freshListed = List<CodegenUnit>.asSlice(&freshUnits)
  let mut agrees = warmListed.length == freshListed.length
  let mut at = usize.ZERO
  while agrees && at < warmListed.length {
    agrees = ContentHash.equals(warmListed[at].digest, freshListed[at].digest)
    at = at + usize.ONE
  }
  run Testing.expect(agrees, "the reused code is the code a cold build of the moved text emits")
  return ()
}

test effect fn editedLeavesLowerAlone() -> ()
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run leafCodeClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn editedBorrowingLeafLowersAlone() -> ()
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run borrowingLeafClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn editedLeafRechecksAlone() -> ()
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run leafRecheckClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

// In one process, as the language server's, a recheck after an edit of a plain function's body
// lowers that function alone: the escape check replays its own last walk, whose other bodies' MIR
// is current, instead of walking again. A second recheck lowers nothing.
effect fn leafRecheckClaims() -> ()
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator | &mut Types {
  let text = "pub fn leaf(count: i32) -> i32 {\n  return count\n}\npub fn middle(count: i32) -> i32 {\n  return leaf(count)\n}\npub fn answer(count: i32) -> i32 {\n  return middle(count)\n}\n"
  let edited = "pub fn leaf(count: i32) -> i32 {\n  return count + 1\n}\npub fn middle(count: i32) -> i32 {\n  return leaf(count)\n}\npub fn answer(count: i32) -> i32 {\n  return middle(count)\n}\n"
  let runtime = run module("runtime.silk")
  let application = run module("steps.silk")
  let roots = [ModuleId.copy(&runtime), ModuleId.copy(&application)]
  let mut store = run unitStore(text, List<BuildRecord.PackBody>.make())
  let mut first = Request.forApplication(ModuleId.copy(&application))
  let before = run Semantic.checkDeclarations(&mut store, &mut first, &roots, &Option<ModuleId>.some(ModuleId.copy(&runtime)))
  run Testing.expect(List<Shared<Rejection>>.length(&before.rejections) == usize.ZERO, "the program checks clean")
  let initial = run Revision.publish(&Revision.make(), &runtime, &run present(entryRuntime()))
  run Semantic.update(&mut store, run Revision.publish(&initial, &application, &run present(edited)))
  Semantic.trace(&mut store, true)
  let mut second = Request.forApplication(ModuleId.copy(&application))
  let after = run Semantic.checkDeclarations(&mut store, &mut second, &roots, &Option<ModuleId>.some(ModuleId.copy(&runtime)))
  run Testing.expect(List<Shared<Rejection>>.length(&after.rejections) == usize.ZERO, "the edited program checks clean")
  run Testing.expect(starts(Semantic.eventLog(&store), Family.Mir) == usize.ONE, "the recheck lowers the edited function alone")
  run Testing.expect(demandedKeys(Semantic.eventLog(&store), Family.Mir) == usize.ONE, "the recheck reads no other function's MIR")
  Semantic.trace(&mut store, true)
  let mut third = Request.forApplication(ModuleId.copy(&application))
  drop run Semantic.checkDeclarations(&mut store, &mut third, &roots, &Option<ModuleId>.some(ModuleId.copy(&runtime)))
  run Testing.expect(starts(Semantic.eventLog(&store), Family.Mir) == usize.ZERO, "a recheck with no edit lowers nothing")
  return ()
}

// The MIR an optimized build lowers again in the same store after `text` is edited to `edited`.
effect fn inlinedEditLowers(text: string<'static>, edited: string<'static>) -> usize
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
  let mut store = run unitStore(text, List<BuildRecord.PackBody>.make())
  Semantic.selectInlining(&mut store, true)
  Semantic.selectDirect(&mut store, true, false, false)
  drop run unitBuild(&mut store)
  let runtime = run module("runtime.silk")
  let application = run module("steps.silk")
  let initial = run Revision.publish(&Revision.make(), &runtime, &run present(entryRuntime()))
  run Semantic.update(&mut store, run Revision.publish(&initial, &application, &run present(edited)))
  Semantic.trace(&mut store, true)
  drop run unitBuild(&mut store)
  return starts(Semantic.eventLog(&store), Family.Mir)
}

// In an optimized build a caller reads the un-inlined MIR of each callee it inlines, and the
// inline summary of every other callee, which an edit that keeps the callee's inlinability leaves
// equal. So an edit of an inlined callee's body lowers its un-inlined MIR and the caller that
// inlined it again; an edit of a callee no caller inlines lowers that callee's two MIR forms and
// none of its callers; and an edit of a function the build does not reach lowers nothing.
test effect fn inlinedCalleeEditsLowerTheirCallers() -> ()
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run inlinedEditClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn inlinedEditClaims() -> ()
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator | &mut Types {
  let text = "pub fn leaf(count: i32) -> i32 {\n  return count\n}\n@inlineNever\npub fn kept(count: i32) -> i32 {\n  return count\n}\npub fn answer(count: i32) -> i32 {\n  return leaf(count) + kept(count)\n}\npub fn other(count: i32) -> i32 {\n  return count\n}\n"
  let leafEdited = "pub fn leaf(count: i32) -> i32 {\n  return count + 1\n}\n@inlineNever\npub fn kept(count: i32) -> i32 {\n  return count\n}\npub fn answer(count: i32) -> i32 {\n  return leaf(count) + kept(count)\n}\npub fn other(count: i32) -> i32 {\n  return count\n}\n"
  let keptEdited = "pub fn leaf(count: i32) -> i32 {\n  return count\n}\n@inlineNever\npub fn kept(count: i32) -> i32 {\n  return count + 1\n}\npub fn answer(count: i32) -> i32 {\n  return leaf(count) + kept(count)\n}\npub fn other(count: i32) -> i32 {\n  return count\n}\n"
  let otherEdited = "pub fn leaf(count: i32) -> i32 {\n  return count\n}\n@inlineNever\npub fn kept(count: i32) -> i32 {\n  return count\n}\npub fn answer(count: i32) -> i32 {\n  return leaf(count) + kept(count)\n}\npub fn other(count: i32) -> i32 {\n  return count + 1\n}\n"
  let afterLeaf = run inlinedEditLowers(text, leafEdited)
  run Testing.expect(afterLeaf == 2, "an edit of an inlined callee lowers its un-inlined MIR and its caller again")
  let afterKept = run inlinedEditLowers(text, keptEdited)
  run Testing.expect(afterKept == 2, "an edit of a callee no caller inlines lowers its own MIR forms alone")
  let afterOther = run inlinedEditLowers(text, otherEdited)
  run Testing.expect(afterOther == usize.ZERO, "an edit of a function the build does not reach lowers nothing")
  return ()
}

// A store that builds `text` as an optimized direct build does, offered `bodies`.
effect fn inliningStore(text: string<'static>, bodies: List<BuildRecord.PackBody>) -> Semantic
  ! InvalidModulePath | OutOfMemoryError
  ? &mut Allocator {
  let mut store = run unitStore(text, move bodies)
  Semantic.selectInlining(&mut store, true)
  Semantic.selectDirect(&mut store, true, false, false)
  return move store
}

// The MIR an optimized build lowers after it adopts the image the build of `text` wrote, with
// `text` edited to `edited`. The build must emit what a cold build of `edited` emits.
effect fn adoptedInlinedEditLowers(text: string<'static>, edited: string<'static>) -> usize
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator | &mut Types {
  let mut cold = run inliningStore(text, List<BuildRecord.PackBody>.make())
  let coldUnits = run unitBuild(&mut cold)
  let image = run Semantic.cacheImage(&mut cold)
  let mut warm = run inliningStore(edited, run packBodies(&coldUnits))
  let request = Request.forApplication(run module("steps.silk"))
  drop run Semantic.adoptCache(&mut warm, &request, &image, false)
  Semantic.trace(&mut warm, true)
  let warmUnits = run unitBuild(&mut warm)
  let lowered = starts(Semantic.eventLog(&warm), Family.Mir)
  let mut fresh = run inliningStore(edited, List<BuildRecord.PackBody>.make())
  let freshUnits = run unitBuild(&mut fresh)
  let warmListed = List<CodegenUnit>.asSlice(&warmUnits)
  let freshListed = List<CodegenUnit>.asSlice(&freshUnits)
  let mut agrees = warmListed.length == freshListed.length && warmListed.length > usize.ZERO
  let mut at = usize.ZERO
  while agrees && at < warmListed.length {
    agrees = ContentHash.equals(warmListed[at].digest, freshListed[at].digest)
    at = at + usize.ONE
  }
  run Testing.expect(agrees, "the build after the edit emits what a cold build of the edited text emits")
  return lowered
}

// Across processes, an optimized build that adopts the image of the build before compares the
// inline summary of an edited callee, which the image records, instead of its source. So an edit of
// a callee no caller inlines lowers that callee's two MIR forms and none of its callers, while an
// edit that makes the callee inlinable, or of a callee its caller inlined, lowers the caller again.
test effect fn adoptedSummariesCutOffTheirCallers() -> ()
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run adoptedSummaryClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn adoptedSummaryClaims() -> ()
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator | &mut Types {
  let text = "pub fn leaf(count: i32) -> i32 {\n  return count\n}\n@inlineNever\npub fn kept(count: i32) -> i32 {\n  return count\n}\npub fn answer(count: i32) -> i32 {\n  return leaf(count) + kept(count)\n}\n"
  let keptEdited = "pub fn leaf(count: i32) -> i32 {\n  return count\n}\n@inlineNever\npub fn kept(count: i32) -> i32 {\n  return count + 1\n}\npub fn answer(count: i32) -> i32 {\n  return leaf(count) + kept(count)\n}\n"
  let keptFreed = "pub fn leaf(count: i32) -> i32 {\n  return count\n}\npub fn kept(count: i32) -> i32 {\n  return count\n}\npub fn answer(count: i32) -> i32 {\n  return leaf(count) + kept(count)\n}\n"
  let leafEdited = "pub fn leaf(count: i32) -> i32 {\n  return count + 1\n}\n@inlineNever\npub fn kept(count: i32) -> i32 {\n  return count\n}\npub fn answer(count: i32) -> i32 {\n  return leaf(count) + kept(count)\n}\n"
  let afterKept = run adoptedInlinedEditLowers(text, keptEdited)
  run Testing.expect(afterKept == 2, "an edit of a callee no caller inlines lowers its own MIR forms alone")
  let afterFreed = run adoptedInlinedEditLowers(text, keptFreed)
  run Testing.expect(afterFreed > afterKept, "a callee that becomes inlinable lowers its caller again")
  let afterLeaf = run adoptedInlinedEditLowers(text, leafEdited)
  run Testing.expect(afterLeaf > afterKept, "an edit of an inlined callee lowers its caller again")
  return ()
}

// The caller inlines leaf from another module while kept is never inlined. An observation enables
// the production observing variants; the ordinary inlining fixture has no observer.
test effect fn observingSummariesCutOffInlinedCallers() -> ()
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run adoptedObservedSummaryClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn adoptedObservedSummaryClaims() -> ()
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator | &mut Types {
  let text = """
pub fn leaf(count: i32) -> i32 { return count }
@inlineNever
pub fn kept(count: i32) -> i32 { return count }
"""
  let keptEdited = """
pub fn leaf(count: i32) -> i32 { return count }
@inlineNever
pub fn kept(count: i32) -> i32 { return count + 1 }
"""
  let leafEdited = """
pub fn leaf(count: i32) -> i32 { return count + 1 }
@inlineNever
pub fn kept(count: i32) -> i32 { return count }
"""
  let afterKept = run adoptedObservedEditLowers(text, keptEdited, true)
  run Testing.expect(afterKept == 2, "a non-inlined body edit lowers only that callee's ordinary and raw MIR")
  let afterLeaf = run adoptedObservedEditLowers(text, leafEdited, true)
  run Testing.expect(afterLeaf > afterKept, "an inlined body edit lowers the caller that spliced it")
  return ()
}

effect fn observingInliningStore(text: string<'static>, bodies: List<BuildRecord.PackBody>, inlining: bool) -> Semantic
  ! InvalidModulePath | OutOfMemoryError
  ? &mut Allocator {
  let runtime = run module("runtime.silk")
  let application = run module("steps.silk")
  let callee = run module("callee.silk")
  let entry = """
import Intrinsic.application
struct Log {}
fn onEvent(self: &mut Log, event: u8, first: usize, second: usize, identity: string<'static>, origin: string<'static>) -> usize { return 0 }
effect fn invoke(count: i32) -> i32 { return application.answer(count) }
export "C" fn enter(count: i32, values: ?[*]const u8) -> i32 as "main" {
  return run Intrinsic.observeDiagnostics(Log {}, onEvent, invoke(count))
}
"""
  let caller = """
import callee {leaf, kept}
pub fn answer(count: i32) -> i32 { return kept(count) + leaf(count) }
"""
  let initial = run Revision.publish(&Revision.make(), &runtime, &run present(entry))
  let second = run Revision.publish(&initial, &application, &run present(caller))
  let revision = run Revision.publish(&second, &callee, &run present(text))
  let mut store = Semantic.traced(move revision,
    MachineTarget.forId(TargetId.X8664UnknownLinuxGnu), Option<FinalProfile>.none())
  Semantic.selectCodegenUnits(&mut store, true)
  Semantic.offerPacks(&mut store, move bodies)
  Semantic.selectInlining(&mut store, inlining)
  Semantic.selectDirect(&mut store, true, false, false)
  return move store
}

effect fn adoptedObservedEditLowers(text: string<'static>, edited: string<'static>, inlining: bool) -> usize
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator | &mut Types {
  let mut cold = run observingInliningStore(text, List<BuildRecord.PackBody>.make(), inlining)
  let coldUnits = run unitBuild(&mut cold)
  let image = run Semantic.cacheImage(&mut cold)
  let mut warm = run observingInliningStore(edited, run packBodies(&coldUnits), inlining)
  let request = Request.forApplication(run module("steps.silk"))
  drop run Semantic.adoptCache(&mut warm, &request, &image, false)
  Semantic.trace(&mut warm, true)
  let warmUnits = run unitBuild(&mut warm)
  let lowered = starts(Semantic.eventLog(&warm), Family.Mir)
  let mut fresh = run observingInliningStore(edited, List<BuildRecord.PackBody>.make(), inlining)
  let freshUnits = run unitBuild(&mut fresh)
  let warmListed = List<CodegenUnit>.asSlice(&warmUnits)
  let freshListed = List<CodegenUnit>.asSlice(&freshUnits)
  let mut agrees = warmListed.length == freshListed.length && warmListed.length > usize.ZERO
  let mut at = usize.ZERO
  while agrees && at < warmListed.length {
    agrees = ContentHash.equals(warmListed[at].digest, freshListed[at].digest)
    at = at + usize.ONE
  }
  run Testing.expect(agrees, "the adopted observing build emits the cold build's definitions")
  return lowered
}


// These cases exercise observing, unoptimized MIR independently of the inliner's raw variants.
// The cold comparison detects stale positions even when a body keeps the same semantic value.
test effect fn observingBodyEditLowersOnlyItsDeclaration() -> ()
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run observingPositionClaims(0) |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn observingOriginEditRelowersTheMovedDeclaration() -> ()
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run observingPositionClaims(1) |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn observingInternalTriviaRelowersItsDeclaration() -> ()
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run observingPositionClaims(2) |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn observingPositionClaims(edit: usize) -> ()
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator | &mut Types {
  let text = """
pub fn leaf(count: i32) -> i32 { return count }
@inlineNever
pub fn kept(count: i32) -> i32 { return count / 2 }
"""
  let body = """
pub fn leaf(count: i32) -> i32 { return count }
@inlineNever
pub fn kept(count: i32) -> i32 { return count / 3 }
"""
  let origin = """
pub fn leaf(count: i32) -> i32 { return count }

@inlineNever
pub fn kept(count: i32) -> i32 { return count / 2 }
"""
  let trivia = """
pub fn leaf(count: i32) -> i32 { return count }
@inlineNever
pub fn kept(count: i32) -> i32 { return  count / 2 }
"""
  let edited = if edit == 0 { body } else { if edit == 1 { origin } else { trivia } }
  let lowered = run adoptedObservedEditLowers(text, edited, false)
  run Testing.expect(lowered == usize.ONE, "only the changed or moved observing declaration is lowered")
  return ()
}

// A borrowed callback passed through a generic parameter stays a callable schema. A changed
// call graph reuses its inlining caller's NonParking facts even though the callback has no
// emitted definition. The edited caller, runtime wrapper and new callee each compute both MIR
// forms, alongside the generic invoke's raw MIR.
test effect fn adoptedInlinedDeclarationsSurviveRewalk() -> ()
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run inlinedRewalkClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn inlinedRewalkClaims() -> ()
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator | &mut Types {
  let text = """
pub fn leaf(value: &i32) -> i32 { return value.* }
@inlineNever
fn invoke<D, F: fn<'static>(D) -> i32 + Intrinsic.NonParking>(callback: F, count: D) -> i32 { return callback(move count) }
@inlineNever
fn other(count: i32) -> i32 { return count }
pub fn answer(count: i32) -> i32 { return invoke(leaf, &count) }
"""
  let edited = """
pub fn leaf(value: &i32) -> i32 { return value.* }
@inlineNever
fn invoke<D, F: fn<'static>(D) -> i32 + Intrinsic.NonParking>(callback: F, count: D) -> i32 { return callback(move count) }
@inlineNever
fn other(count: i32) -> i32 { return count }
pub fn answer(count: i32) -> i32 { return invoke(leaf, &count) + other(count) }
"""
  let lowered = run adoptedInlinedEditLowers(text, edited)
  run Testing.expect(lowered == 7, "a changed call graph rewalk computes seven MIR units instead of the whole program")
  return ()
}

// An edit that makes an inlined schema park must still reach the cold NonParking diagnostic.
test effect fn adoptedInlinedDeclarationCannotHideParking() -> ()
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run inlinedParkingClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn inlinedParkingClaims() -> ()
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator | &mut Types {
  let text = """
pub fn leaf(value: &i32) -> i32 { return value.* }
@inlineNever
fn invoke<D, F: fn<'static>(D) -> i32 + Intrinsic.NonParking>(callback: F, count: D) -> i32 { return callback(move count) }
pub fn answer(count: i32) -> i32 { return invoke(leaf, &count) }
"""
  let edited = """
pub fn leaf(value: &i32) -> i32 {
  run Intrinsic.relinquish()
  return value.*
}
@inlineNever
fn invoke<D, F: fn<'static>(D) -> i32 + Intrinsic.NonParking>(callback: F, count: D) -> i32 { return callback(move count) }
pub fn answer(count: i32) -> i32 { return invoke(leaf, &count) }
"""
  let mut cold = run inliningStore(text, List<BuildRecord.PackBody>.make())
  let coldUnits = run unitBuild(&mut cold)
  run Testing.expect(List<CodegenUnit>.length(&coldUnits) > usize.ZERO, "the non-parking schema builds before the edit")
  let image = run Semantic.cacheImage(&mut cold)
  let mut warm = run inliningStore(edited, run packBodies(&coldUnits))
  let request = Request.forApplication(run module("steps.silk"))
  drop run Semantic.adoptCache(&mut warm, &request, &image, false)
  let mut fresh = run inliningStore(edited, List<BuildRecord.PackBody>.make())
  let start = offsetOf(edited, "invoke(leaf, &count)", usize.ZERO)
  run inlinedParkingReported(&mut warm, start)
  run inlinedParkingReported(&mut fresh, start)
  return ()
}

effect fn inlinedParkingReported(store: &mut Semantic, start: usize) -> ()
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator | &mut Types {
  let runtime = run module("runtime.silk")
  let application = run module("steps.silk")
  let mut request = Request.forApplication(ModuleId.copy(&application))
  let roots = [ModuleId.copy(&runtime), ModuleId.copy(&application)]
  let built = run Semantic.buildArtifact(&mut store.*, &mut request, Option<&ModuleId>.some(&runtime), &roots, &roots, staticClosureNodes)
  run Testing.expect(buildRejectedAt(&built, RejectionCode.UnsatisfiedExecutableProperty, start),
    "the edited schema reports SEM0139 at its incoming call in both warm and cold builds")
  return ()
}

// A generic callee's summary must rebuild the same application after adoption, without
// lowering its caller to rediscover the type argument. The pre-encoding implementation lowers
// that caller too. Removing the directive changes the summary and must release the caller.
test effect fn adoptedGenericSummariesCutOffTheirCallers() -> ()
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run adoptedGenericSummaryClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn adoptedGenericSummaryClaims() -> ()
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator | &mut Types {
  let text = """
@inlineNever
pub fn kept<T>(count: T) -> T {
  return move count
}
pub fn answer(count: i32) -> i32 {
  return kept<i32>(count)
}
"""
  let edited = """
@inlineNever
pub fn kept<T>(count: T) -> T {
  let result = move count
  return move result
}
pub fn answer(count: i32) -> i32 {
  return kept<i32>(count)
}
"""
  let freed = """
pub fn kept<T>(count: T) -> T {
  return move count
}
pub fn answer(count: i32) -> i32 {
  return kept<i32>(count)
}
"""
  let afterEdit = run adoptedInlinedEditLowers(text, edited)
  run Testing.expect(afterEdit == 2, "a generic body edit lowers only the callee's ordinary and raw MIR")
  let afterFreed = run adoptedInlinedEditLowers(edited, freed)
  run Testing.expect(afterFreed > afterEdit, "a generic callee that becomes inlinable lowers its caller again")
  return ()
}

// How many distinct `family` units `events` demanded, lowered or served from memo.
fn demandedKeys(events: &[SemanticEvent], family: Family) -> usize {
  let mut count = usize.ZERO
  let mut at = usize.ZERO
  while at < events.length {
    if events[at].family == family && (events[at].kind == EventKind.Start || events[at].kind == EventKind.Hit) {
      let mut seen = false
      let mut before = usize.ZERO
      while before < at && !seen {
        seen = events[before].family == family && events[before].key == events[at].key
          && (events[before].kind == EventKind.Start || events[before].kind == EventKind.Hit)
        before = before + usize.ONE
      }
      if !seen { count = count + usize.ONE }
    }
    at = at + usize.ONE
  }
  return count
}

// The packs of `units`, as the driver offers them to the next build.
effect fn packBodies(units: &List<CodegenUnit>) -> List<BuildRecord.PackBody> ! OutOfMemoryError ? &mut Allocator {
  let mut bodies = List<BuildRecord.PackBody>.make()
  let built = List<CodegenUnit>.asSlice(units)
  let mut at = usize.ZERO
  while at < built.length {
    run List<BuildRecord.PackBody>.append(&mut bodies, BuildRecord.PackBody {digest: built[at].digest, bytes: run Bytes.copy(Bytes.asSlice(&built[at].body))})
    at = at + usize.ONE
  }
  return move bodies
}

// An edit of a plain function's body lowers that function alone, in the check and the build: both
// replays find its key in their records, so the callers on its path from the entry, which still
// call it, do not lower again.
effect fn leafCodeClaims() -> ()
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator | &mut Types {
  let text = "pub fn leaf(count: i32) -> i32 {\n  return count\n}\npub fn middle(count: i32) -> i32 {\n  return leaf(count)\n}\npub fn answer(count: i32) -> i32 {\n  return middle(count)\n}\n"
  let edited = "pub fn leaf(count: i32) -> i32 {\n  return count + 1\n}\npub fn middle(count: i32) -> i32 {\n  return leaf(count)\n}\npub fn answer(count: i32) -> i32 {\n  return middle(count)\n}\n"
  return run editedLeafClaims(text, edited, usize.ONE)
}

// So does one whose key holds lifetimes: the record keeps them after the declaration. The build
// lowers the region pattern its caller reaches, once; the function's own root is the check's.
effect fn borrowingLeafClaims() -> ()
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator | &mut Types {
  let text = "pub fn leaf(count: &i32) -> i32 {\n  return count.*\n}\npub fn middle(count: i32) -> i32 {\n  return leaf(&count)\n}\npub fn answer(count: i32) -> i32 {\n  return middle(count)\n}\n"
  let edited = "pub fn leaf(count: &i32) -> i32 {\n  return count.* + 1\n}\npub fn middle(count: i32) -> i32 {\n  return leaf(&count)\n}\npub fn answer(count: i32) -> i32 {\n  return middle(count)\n}\n"
  return run editedLeafClaims(text, edited, usize.ONE)
}

// Edits `text` to `edited` after a cold build and expects the warm build to lower `lowered` MIR
// bodies, all of the edited function, and to emit what a cold build of `edited` emits.
effect fn editedLeafClaims(text: string<'static>, edited: string<'static>, lowered: usize) -> ()
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator | &mut Types {
  let runtime = run module("runtime.silk")
  let application = run module("steps.silk")
  let roots = [ModuleId.copy(&runtime), ModuleId.copy(&application)]
  // The cold store is checked too, as `silk check` before `silk build` leaves it, so the image
  // holds the escape walks beside the build's record.
  let mut cold = run unitStore(text, List<BuildRecord.PackBody>.make())
  let mut first = Request.forApplication(ModuleId.copy(&application))
  drop run Semantic.checkDeclarations(&mut cold, &mut first, &roots, &Option<ModuleId>.some(ModuleId.copy(&runtime)))
  let coldUnits = run unitBuild(&mut cold)
  let image = run Semantic.cacheImage(&mut cold)
  let mut warm = run unitStore(edited, run packBodies(&coldUnits))
  // The store adopts the image for the build it serves, whose application the image's checks read.
  let request = Request.forApplication(ModuleId.copy(&application))
  drop run Semantic.adoptCache(&mut warm, &request, &image, false)
  // The build walks into no instance before its own walk, so the count is that walk's alone.
  Semantic.trace(&mut warm, true)
  let warmUnits = run unitBuild(&mut warm)
  run Testing.expect(starts(Semantic.eventLog(&warm), Family.Mir) == lowered, "the check and the build lower the edited function alone")
  let mut fresh = run unitStore(edited, List<BuildRecord.PackBody>.make())
  let freshUnits = run unitBuild(&mut fresh)
  let warmListed = List<CodegenUnit>.asSlice(&warmUnits)
  let freshListed = List<CodegenUnit>.asSlice(&freshUnits)
  let mut agrees = warmListed.length == freshListed.length && warmListed.length > usize.ZERO
  let mut at = usize.ZERO
  while agrees && at < warmListed.length {
    agrees = ContentHash.equals(warmListed[at].digest, freshListed[at].digest)
    at = at + usize.ONE
  }
  run Testing.expect(agrees, "the build after the edit emits what a cold build of the edited text emits")
  return ()
}

// A build whose walk two copies of the process share emits the units a build in one process
// emits. Once its record is walked for (`recordSharedBuild`), a build that adopts its image takes
// every unit from the packs, as it does after a build in one process.
effect fn sharedBuildClaims() -> ()
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator | &mut Types {
  let mut alone = run unitStore(steps(), List<BuildRecord.PackBody>.make())
  let aloneUnits = run unitBuild(&mut alone)
  let mut shared = run unitStore(steps(), List<BuildRecord.PackBody>.make())
  // The copies start before the walk enters its first instance.
  Semantic.shareWalks(&mut shared, 2, usize.ZERO)
  let sharedUnits = run unitBuild(&mut shared)
  // A host that starts no copy of the process built in one, which the tests above cover.
  if !WalkShared.supported() { return () }
  run Testing.expect(Semantic.sharedBuildUnrecorded(&shared), "copies of the process lowered the build")
  let aloneListed = List<CodegenUnit>.asSlice(&aloneUnits)
  let sharedListed = List<CodegenUnit>.asSlice(&sharedUnits)
  let mut agrees = aloneListed.length == sharedListed.length && aloneListed.length > usize.ZERO
  let mut at = usize.ZERO
  while agrees && at < aloneListed.length {
    agrees = ContentHash.equals(aloneListed[at].digest, sharedListed[at].digest)
    at = at + usize.ONE
  }
  run Testing.expect(agrees, "a shared build emits what a build in one process emits")
  run Semantic.recordSharedBuild(&mut shared)
  run Testing.expect(!Semantic.sharedBuildUnrecorded(&shared), "the record walk leaves nothing unrecorded")
  let image = run Semantic.cacheImage(&mut shared)
  let mut warm = run unitStore(steps(), run packBodies(&sharedUnits))
  let request = Request.forApplication(run module("steps.silk"))
  drop run Semantic.adoptCache(&mut warm, &request, &image, false)
  let warmUnits = run unitBuild(&mut warm)
  run Testing.expect(List<CodegenUnit>.length(&warmUnits) > usize.ZERO && allStored(&warmUnits),
    "a build after a shared one takes its units from the packs")
  return ()
}

test effect fn sharedBuildEmitsAndRecordsAsOneProcess() -> ()
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run sharedBuildClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn grownElementEmitsItsViewAgain() -> ()
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run grownElementClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

// `view<Item>` lowers to the same MIR whatever `Item` holds: only its emission reads `Item`'s
// layout, for the stride of the slice it returns.
fn viewSteps() -> string<'static> {
  return """
import item { Item }
fn view<T>(buffer: &Intrinsic.RawBuffer<T>, length: usize) -> &[T] {
  unsafe { return Intrinsic.rawBufferView<T>(buffer, 0, length) }
}
fn absurd<T>() -> T { return absurd<T>() }
pub fn answer(count: i32) -> i32 {
  let buffer = absurd<&'static Intrinsic.RawBuffer<Item>>()
  let items = view<Item>(buffer, 2)
  return items[1].id + count
}
"""
}

// A store that builds `viewSteps` into codegen units, with `item` the text of the module that
// declares `Item`, offered `bodies`.
effect fn elementStore(item: string<'static>, bodies: List<BuildRecord.PackBody>) -> Semantic
  ! InvalidModulePath | OutOfMemoryError
  ? &mut Allocator {
  let runtime = run module("runtime.silk")
  let application = run module("steps.silk")
  let element = run module("item.silk")
  let initial = run Revision.publish(&Revision.make(), &runtime, &run present(entryRuntime()))
  let both = run Revision.publish(&initial, &application, &run present(viewSteps()))
  let mut store = Semantic.traced(run Revision.publish(&both, &element, &run present(item)),
    MachineTarget.forId(TargetId.X8664UnknownLinuxGnu), Option<FinalProfile>.none())
  Semantic.selectCodegenUnits(&mut store, true)
  Semantic.offerPacks(&mut store, move bodies)
  return move store
}

effect fn elementBuild(store: &mut Semantic) -> List<CodegenUnit>
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
  let runtime = run module("runtime.silk")
  let application = run module("steps.silk")
  let element = run module("item.silk")
  let mut request = Request.forApplication(ModuleId.copy(&application))
  let roots = [ModuleId.copy(&runtime), ModuleId.copy(&application), ModuleId.copy(&element)]
  let mut check = Request.forApplication(ModuleId.copy(&application))
  drop run Semantic.checkDeclarations(&mut store.*, &mut check, &roots, &Option<ModuleId>.some(ModuleId.copy(&runtime)))
  let built = run Semantic.buildArtifact(&mut store.*, &mut request, Option<&ModuleId>.some(&runtime), &roots, &roots, staticClosureNodes)
  return match move built {
    BackendBuild.Module {units, ..} => move units
    _ => List<CodegenUnit>.make()
  }
}

// Growing `Item` leaves `view<Item>`'s MIR as it was, but not its code, which strides by `Item`'s
// size. A build that adopts the image of the build before emits `view<Item>` again: it emits what
// a cold build of the grown text does, not the code for the old size (silk-lang/silk#2468).
effect fn grownElementClaims() -> ()
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator | &mut Types {
  let small = "pub struct Item {pub id: i32}\n"
  let grown = "pub struct Item {pub id: i32, pub extra: i64}\n"
  let mut cold = run elementStore(small, List<BuildRecord.PackBody>.make())
  let coldUnits = run elementBuild(&mut cold)
  run Testing.expect(List<CodegenUnit>.length(&coldUnits) > usize.ZERO && !allStored(&coldUnits), "a cold build emits its units")
  let image = run Semantic.cacheImage(&mut cold)
  let mut warm = run elementStore(grown, run packBodies(&coldUnits))
  let request = Request.make()
  drop run Semantic.adoptCache(&mut warm, &request, &image, false)
  let warmUnits = run elementBuild(&mut warm)
  let mut fresh = run elementStore(grown, List<BuildRecord.PackBody>.make())
  let freshUnits = run elementBuild(&mut fresh)
  let warmListed = List<CodegenUnit>.asSlice(&warmUnits)
  let freshListed = List<CodegenUnit>.asSlice(&freshUnits)
  let mut agrees = warmListed.length == freshListed.length && warmListed.length > usize.ZERO
  let mut at = usize.ZERO
  while agrees && at < warmListed.length {
    agrees = ContentHash.equals(warmListed[at].digest, freshListed[at].digest)
    at = at + usize.ONE
  }
  run Testing.expect(agrees, "the build after the element grew emits what a cold build of the grown text emits")
  return ()
}
