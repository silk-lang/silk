//! Reachable concrete members of explicitly erased interface contracts.

import CompilerBug
import backend.InstanceKey {InstanceKey}
import backend.Mir {ErasureFact}
import semantic.DeclarationId {DeclarationId}
import semantic.InternIndex {InternIndex}
import semantic.RuntimeEncoding
import semantic.TypeText
import silk.collections.bytes {Bytes}
import semantic.Type {Type}
import semantic.Types {Types}
import silk.collections.list {List}
import silk.core.option {Option}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.mem.interned {Interned}
import silk.num.usize

struct Contract {
  ty: Interned<Type>,
  members: List<ErasureFact>,
  tags: InternIndex,
  identity: Bytes,
  snapshot: Bytes,
  // Contracts to which a value of this contract has been narrowed.
  narrower: List<usize>,
}

/// The facts from the reached MIR of one build. Positions are internal to this build; the tag
/// written into an erased reference is independent of contract or discovery order.
pub struct ErasureIndex {
  contracts: List<Contract>,
  ambientPosition: usize,
  ambientKeys: List<u64>,
}

// The first conversion in declaration identity and source order anchors a witness. Choosing it
// from the observed sites gives worker partitions and narrowing paths the same diagnostic.
fn earlier(left: &ErasureFact, right: &ErasureFact) -> bool {
  let a = Interned<DeclarationId>.get(&left.owner)
  let b = Interned<DeclarationId>.get(&right.owner)
  if DeclarationId.equals(a, b) {
    if left.origin.location.start != right.origin.location.start { return left.origin.location.start < right.origin.location.start }
    return left.origin.location.end < right.origin.location.end
  }
  return DeclarationId.withContent<bool>(a, |first: &[u8]| -> bool {
    return DeclarationId.withContent<bool>(b, |second: &[u8]| -> bool { return RuntimeEncoding.less(first, second) })
  })
}

// Only the compiler creates this erased contract. Each member is a distinct ambient
// service for which a reachable provideAmbient built an entry.
fn ambientRegistry(ty: &Interned<Type>) -> bool {
  return match &Interned<Type>.get(ty).* {
    Type.Erased {contracts, transferable, concurrent} => match &Interned<Type>.get(&contracts).* {
      Type.Unit => !transferable && !concurrent
      _ => false
    }
    _ => false
  }
}

impl ErasureIndex {
  pub fn make() -> ErasureIndex { return ErasureIndex {ambientPosition: usize.MAX, contracts: List<Contract>.make(), ambientKeys: List<u64>.make()} }

  /// The registrations known at the beginning of the current reachability round.
  pub fn ambientExtent(self: &Self) -> usize {
    if self.ambientPosition == usize.MAX { return usize.ZERO }
    return Self.countAt(self, self.ambientPosition)
  }

  /// A service query can expose another operation (and its witness) during discovery.
  pub effect fn containsAmbient(self: &Self, capability: &Interned<Type>) -> bool
    ! OutOfMemoryError ? &mut Allocator | &mut Types {
    if self.ambientPosition == usize.MAX { return false }
    let facts = Self.factsAt(self, self.ambientPosition)
    let mut at = usize.ZERO
    while at < facts.length {
      if run Type.runtimeEqualsShared(&facts[at].source, capability) { return true }
      at = at + usize.ONE
    }
    return false
  }

  /// The stable position of a contract during this build.
  pub effect fn position(self: &mut Self, ty: &Interned<Type>) -> usize ! OutOfMemoryError ? &mut Allocator | &mut Types {
    let contracts = List<Contract>.asSlice(&self.contracts)
    let mut at = usize.ZERO
    while at < contracts.length {
      if run Type.runtimeEqualsShared(ty, &contracts[at].ty) { return at }
      at = at + usize.ONE
    }
    if ambientRegistry(ty) { self.ambientPosition = at }
    run List<Contract>.append(&mut self.contracts, Contract {ty: Interned<Type>.clone(ty),
      members: List<ErasureFact>.make(), tags: InternIndex.make(), identity: Bytes.make(), snapshot: Bytes.make(), narrower: List<usize>.make()})
    return at
  }

  /// The number of currently reached concrete members of the contract at this position.
  pub fn countAt(self: &Self, position: usize) -> usize {
    return List<ErasureFact>.length(&List<Contract>.asSlice(&self.contracts)[position].members)
  }

  /// The concrete conversion sites of this walk's contract.
  pub fn factsAt<'a>(self: &'a Self, position: usize) -> &'a [ErasureFact] {
    return List<ErasureFact>.asSlice(&List<Contract>.asSlice(&self.contracts)[position].members)
  }

  /// Adds a concrete conversion or narrowing edge. A newly reached concrete member is forwarded
  /// across existing edges, and a newly reached edge forwards all previously discovered members.
  /// Each pair is propagated once, including when different paths meet at the same contract.
  pub effect fn observe(self: &mut Self, fact: &ErasureFact) -> () ! OutOfMemoryError ? &mut Allocator | &mut Types {
    let dest = run ErasureIndex.position(&mut self.*, &fact.target)
    if Interned<Type>.with<bool>(&fact.source, Type.isErased) {
      let source = run ErasureIndex.position(&mut self.*, &fact.source)
      if source == dest { return () }
      let entry = &mut List<Contract>.asMutSlice(&mut self.contracts)[source]
      let edges = List<usize>.asSlice(&entry.narrower)
      let mut at = usize.ZERO
      while at < edges.length {
        if edges[at] == dest { return () }
        at = at + usize.ONE
      }
      run List<usize>.append(&mut entry.narrower, dest)
      let members = List<ErasureFact>.asSlice(&entry.members)
      let mut forward = List<ErasureFact>.make()
      run ErasureFact.appendTo(members, &mut forward)
      let listed = List<ErasureFact>.asSlice(&forward)
      at = usize.ZERO
      while at < listed.length {
        run ErasureIndex.propagate(&mut self.*, dest, &listed[at])
        at = at + usize.ONE
      }
    } else { run ErasureIndex.propagate(&mut self.*, dest, fact) }
    return ()
  }

  effect fn propagate(self: &mut Self, start: usize, fact: &ErasureFact) -> () ! OutOfMemoryError ? &mut Allocator | &mut Types {
    let owner = DeclarationId.copyShared(&fact.owner)
    let tag = run InstanceKey.memberTag(&fact.source, &owner)
    let mut work = List<usize>.make()
    run List<usize>.append(&mut work, start)
    while let Option<usize>.Some {value: next} = move List<usize>.pop(&mut work) {
      let entry = &mut List<Contract>.asMutSlice(&mut self.contracts)[next]
      let members = List<ErasureFact>.asSlice(&entry.members)
      let known = InternIndex.first(&entry.tags, tag)
      if known != usize.MAX {
        if run Type.runtimeEqualsShared(&members[known].source, &fact.source) {
          if earlier(fact, &members[known]) {
            List<ErasureFact>.set(&mut entry.members, known, ErasureFact.copy(fact))
            run List<usize>.appendSlice(&mut work, List<usize>.asSlice(&entry.narrower))
          }
          continue
        }
        let mut detail = run Bytes.copy(b"erased dispatch tag collision between ")
        let viewer = DeclarationId.moduleId(&owner)
        let types = [Interned<Type>.clone(&members[known].source), Interned<Type>.clone(&fact.source)]
        let mut i = usize.ZERO
        while i < types.length {
          if i > usize.ZERO { run Bytes.append(&mut detail, b" and ") }
          if let Option<Bytes>.Some {value: name} = move run TypeText.display(&types[i], viewer) {
            run Bytes.append(&mut detail, Bytes.asSlice(&name))
          } else {
            let identity = run Type.runtimeEncoding(&types[i], &owner)
            run Bytes.append(&mut detail, Bytes.asSlice(&identity))
          }
          i = i + usize.ONE
        }
        return CompilerBug.panic(Bytes.asSlice(&detail))
      }
      run InternIndex.record(&mut entry.tags, tag)
      run List<ErasureFact>.append(&mut entry.members, ErasureFact.copy(fact))
      run List<usize>.appendSlice(&mut work, List<usize>.asSlice(&entry.narrower))
    }
    return ()
  }

  /// Freezes the sorted lifetime-erased type identities read by a dispatcher. The leading byte
  /// distinguishes a closed empty set from a query that ran before a program had been closed.
  pub effect fn freeze(self: &mut Self) -> () ! OutOfMemoryError ? &mut Allocator {
    self.ambientKeys = List<u64>.make()
    let entries = List<Contract>.asMutSlice(&mut self.contracts)
    let mut at = usize.ZERO
    while at < entries.length {
      let entry = &mut entries[at]
      let members = List<ErasureFact>.asSlice(&entry.members)
      let mut coordinates = RuntimeEncoding.coordinates()
      let mut ambientRegistry = false
      let owner = match move run Type.glueOwner(&entry.ty, &mut coordinates) {
        Option<DeclarationId>.Some {value} => move value
        _ => {
          // The synthetic registry of ambient services is module independent. Its runtime
          // encoding contains no parameters that require a particular declaration as owner.
          if at != self.ambientPosition || members.length == 0 { return CompilerBug.panic(b"an erased contract has no interface identity") }
          ambientRegistry = true
          DeclarationId.copyShared(&members[0].owner)
        }
      }
      entry.identity = run Type.runtimeEncoding(&entry.ty, &owner)
      let mut shapes = List<Bytes>.make()
      let mut member = usize.ZERO
      while member < members.length {
        run List<Bytes>.append(&mut shapes, run Type.runtimeEncoding(&members[member].source, &owner))
        member = member + usize.ONE
      }
      let order = run RuntimeEncoding.order(&shapes)
      let listed = List<Bytes>.asSlice(&shapes)
      entry.snapshot = run Bytes.copy(b"C")
      member = usize.ZERO
      while member < members.length {
        let position = List<usize>.get(&order, member)
        let tag = run InstanceKey.memberTag(&members[position].source, &owner)
        run RuntimeEncoding.word(&mut entry.snapshot, tag)
        if ambientRegistry { run List<u64>.append(&mut self.ambientKeys, tag) }
        run RuntimeEncoding.field(&mut entry.snapshot, Bytes.asSlice(&listed[position]))
        member = member + usize.ONE
      }
      at = at + usize.ONE
    }
    run List<u64>.sort(&mut self.ambientKeys)
  }

  /// Stable dense ordinals for this artifact, shared by table extents and dispatchers.
  pub fn ambientServices(self: &Self) -> &[u64] { return List<u64>.asSlice(&self.ambientKeys) }

  /// The table layout has an empty value even before discovery, and is addressable in a
  /// disk cache before any source type is interned.
  pub fn ambientSelector() -> &'static [u8] { return b"ambient-service-table" }

  /// What a closed build reads for this stable contract, including a contract reached only by
  /// the previous build. A contract absent from this build has the closed empty set.
  pub fn snapshot<'a>(self: &'a Self, identity: &[u8]) -> &'a [u8] {
    let entries = List<Contract>.asSlice(&self.contracts)
    let ambient = ErasureIndex.ambientSelector()
    if identity.length == ambient.length && !RuntimeEncoding.less(identity, ambient) && !RuntimeEncoding.less(ambient, identity) {
      if self.ambientPosition == usize.MAX { return b"C" }
      return Bytes.asSlice(&entries[self.ambientPosition].snapshot)
    }
    let mut at = usize.ZERO
    while at < entries.length {
      let named = Bytes.asSlice(&entries[at].identity)
      if named.length == identity.length && !RuntimeEncoding.less(named, identity) && !RuntimeEncoding.less(identity, named) {
        return Bytes.asSlice(&entries[at].snapshot)
      }
      at = at + usize.ONE
    }
    return b"C"
  }

  /// The concrete conversions contributing to this contract, including via narrowing. Each
  /// entry keeps the authored conversion to attach to a failing witness.
  pub effect fn members(self: &Self, ty: &Interned<Type>) -> List<ErasureFact> ! OutOfMemoryError ? &mut Allocator | &mut Types {
    let contracts = List<Contract>.asSlice(&self.contracts)
    let mut found = List<ErasureFact>.make()
    let mut at = usize.ZERO
    while at < contracts.length {
      if run Type.runtimeEqualsShared(ty, &contracts[at].ty) {
        run ErasureFact.appendTo(List<ErasureFact>.asSlice(&contracts[at].members), &mut found)
        break
      }
      at = at + usize.ONE
    }
    return move found
  }
}
