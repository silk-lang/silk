//! UTF-8 operations for admitted static text values.
//!
//! # When to use
//! The sealed `Intrinsic.staticText*` operations call [`apply`] during static execution. This
//! actor owns byte inspection and scalar-boundary validation. The evaluator carries source spans
//! separately from value identity and attaches them to a failure's byte offset.

import semantic.StaticValue
import semantic.StaticValue {IntegerType, Sign, Value}
import silk.allocator {Allocator, OutOfMemoryError}
import silk.bytes {Bytes}
import silk.option {Option}
import silk.result {Result}
import silk.shared {Shared}
import silk.u64
import silk.u8
import silk.usize

/// The four sealed primitives used by the ordinary `silk.static_text` source wrappers.
pub enum Operation {
  ByteLength,
  ByteAt,
  Concat,
  Slice,
}

/// A static text operation failed before publishing a value.
pub enum FaultKind {
  InvalidArguments,
  InvalidTarget,
  OutOfBounds,
  InvalidRange,
  SplitScalar,
  InvalidText,
  ValueLimit,
}

/// The byte offset is relative to the original text argument, not the call expression.
pub struct Fault {
  pub kind: FaultKind
  pub byteOffset: u64
}

fn failure(kind: FaultKind, byteOffset: u64) -> Result<Value, Fault> {
  return Result.failResult<Value, Fault>(Fault {kind: kind, byteOffset: byteOffset})
}

fn length(value: &Value) -> Option<usize> {
  return match & value.* {
    Value.Text {bytes} => Option.some<usize>(Bytes.length(&bytes))
    _ => Option.none<usize>()
  }
}

fn index(value: &Value) -> Option<u64> {
  return match & value.* {
    Value.Integer {ty, sign, magnitude} => {
      if ty == IntegerType.Usize && sign == Sign.Positive {
        return Option.some<u64>(magnitude)
      }
      return Option.none<u64>()
    }
    _ => Option.none<u64>()
  }
}

fn byte(value: &Value, at: usize) -> Option<u8> {
  return match & value.* {
    Value.Text {bytes} => {
      let data = Bytes.asSlice(&bytes)
      if at < data.length { return Option.some<u8>(data[at]) }
      return Option.none<u8>()
    }
    _ => Option.none<u8>()
  }
}

fn boundary(value: &Value, at: usize) -> bool {
  return match & value.* {
    Value.Text {bytes} => {
      let data = Bytes.asSlice(&bytes)
      if at == usize.ZERO || at == data.length { return true }
      if at > data.length { return false }
      return u8.bitAnd(data[at], 192) != 128
    }
    _ => false
  }
}

fn write(value: &Value, start: usize, end: usize, output: &mut Bytes, offset: usize) -> bool {
  return match & value.* {
    Value.Text {bytes} => {
      let source = Bytes.asSlice(&bytes)
      if end > source.length || start > end { return false }
      let target = Bytes.asMutSlice(&mut output.*)
      if offset > target.length || end - start > target.length - offset { return false }
      let mut at = start
      while at < end {
        target[offset + at - start] = source[at]
        at = at + usize.ONE
      }
      return true
    }
    _ => false
  }
}

fn admitted(bytes: Bytes) -> Result<Value, Fault> {
  return match move StaticValue.text(move bytes) {
    Option<Value>.Some {value} => Result.succeed<Value, Fault>(move value)
    Option<Value>.None => failure(FaultKind.InvalidText, 0)
  }
}

/// Executes one primitive on complete static values. The pointer width is the frozen target's.
/// The output budget is checked before allocating a concatenation or slice buffer.
pub effect fn apply(operation: Operation, args: &[Shared<Value>], pointerBits: u32, valueBytes: usize) -> Result<
  Value,
  Fault,
> ! OutOfMemoryError ? &mut Allocator {
  if pointerBits != 32 && pointerBits != 64 {
    return failure(FaultKind.InvalidTarget, 0)
  }
  return match operation {
    Operation.ByteLength => {
      if args.length != usize.ONE { return failure(FaultKind.InvalidArguments, 0) }
      let count = match move Shared.with<Value, Option<usize>>(&args[0], length) {
        Option<usize>.Some {value} => value
        Option<usize>.None => { return failure(FaultKind.InvalidArguments, 0) }
      }
      return match move StaticValue.integer(IntegerType.Usize, Sign.Positive, usize.toU64(count), pointerBits) {
        Option<Value>.Some {value} => Result.succeed<Value, Fault>(move value)
        Option<Value>.None => failure(FaultKind.InvalidTarget, 0)
      }
    }
    Operation.ByteAt => {
      if args.length != 2 { return failure(FaultKind.InvalidArguments, 0) }
      let count = match move Shared.with<Value, Option<usize>>(&args[0], length) {
        Option<usize>.Some {value} => value
        Option<usize>.None => { return failure(FaultKind.InvalidArguments, 0) }
      }
      let at = match move Shared.with<Value, Option<u64>>(&args[1], index) {
        Option<u64>.Some {value} => value
        Option<u64>.None => { return failure(FaultKind.InvalidArguments, 0) }
      }
      if at >= usize.toU64(count) { return failure(FaultKind.OutOfBounds, at) }
      let selected = match move Shared.with<Value, Option<u8>>(
        &args[0], fn(value: &Value) -> Option<u8> { return byte(value, u64.toUsize(at)) },
      ) {
        Option<u8>.Some {value} => value
        Option<u8>.None => { return failure(FaultKind.InvalidArguments, at) }
      }
      return Result.succeed<Value, Fault>(Value.Integer {
        ty: IntegerType.U8, sign: Sign.Positive, magnitude: u8.toU64(selected),
      })
    }
    Operation.Concat => {
      if args.length != 2 { return failure(FaultKind.InvalidArguments, 0) }
      let left = match move Shared.with<Value, Option<usize>>(&args[0], length) {
        Option<usize>.Some {value} => value
        Option<usize>.None => { return failure(FaultKind.InvalidArguments, 0) }
      }
      let right = match move Shared.with<Value, Option<usize>>(&args[1], length) {
        Option<usize>.Some {value} => value
        Option<usize>.None => { return failure(FaultKind.InvalidArguments, 0) }
      }
      let total = match move usize.checkedAdd(left, right) {
        Option<usize>.Some {value} => value
        Option<usize>.None => { return failure(FaultKind.InvalidRange, usize.toU64(left)) }
      }
      if total > valueBytes || valueBytes - total < 16 {
        return failure(FaultKind.ValueLimit, 0)
      }
      let mut output = run Bytes.zeroed(total)
      let wroteLeft = Shared.with<Value, bool>(
        &args[0], fn(value: &Value) -> bool { return write(value, 0, left, &mut output, 0) },
      )
      let wroteRight = Shared.with<Value, bool>(
        &args[1], fn(value: &Value) -> bool { return write(value, 0, right, &mut output, left) },
      )
      if !wroteLeft || !wroteRight { return failure(FaultKind.InvalidArguments, 0) }
      return admitted(move output)
    }
    Operation.Slice => {
      if args.length != 3 { return failure(FaultKind.InvalidArguments, 0) }
      let count = match move Shared.with<Value, Option<usize>>(&args[0], length) {
        Option<usize>.Some {value} => value
        Option<usize>.None => { return failure(FaultKind.InvalidArguments, 0) }
      }
      let start = match move Shared.with<Value, Option<u64>>(&args[1], index) {
        Option<u64>.Some {value} => value
        Option<u64>.None => { return failure(FaultKind.InvalidArguments, 0) }
      }
      let end = match move Shared.with<Value, Option<u64>>(&args[2], index) {
        Option<u64>.Some {value} => value
        Option<u64>.None => { return failure(FaultKind.InvalidArguments, 0) }
      }
      if start > end || end > usize.toU64(count) {
        return failure(FaultKind.InvalidRange, start)
      }
      if !Shared.with<Value, bool>(
        &args[0], fn(value: &Value) -> bool { return boundary(value, u64.toUsize(start)) },
      ) { return failure(FaultKind.SplitScalar, start) }
      if !Shared.with<Value, bool>(
        &args[0], fn(value: &Value) -> bool { return boundary(value, u64.toUsize(end)) },
      ) { return failure(FaultKind.SplitScalar, end) }
      let outputLength = u64.toUsize(end - start)
      if outputLength > valueBytes || valueBytes - outputLength < 16 {
        return failure(FaultKind.ValueLimit, start)
      }
      let mut output = run Bytes.zeroed(outputLength)
      let wrote = Shared.with<Value, bool>(
        &args[0], fn(value: &Value) -> bool {
          return write(value, u64.toUsize(start), u64.toUsize(end), &mut output, 0)
        },
      )
      if !wrote { return failure(FaultKind.InvalidArguments, start) }
      return admitted(move output)
    }
  }
}
