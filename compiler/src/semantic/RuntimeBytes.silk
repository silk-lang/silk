//! One lazily computed immutable byte value. Encoding happens outside this cell's lock.
//! Readers retain a snapshot before releasing the lock; no user callback executes under it.
import semantic.Published {Published}
import semantic.RuntimeEncoding
import silk.concurrency.sync {Arc, Mutex}
import silk.collections.bytes {Bytes}
import silk.num.usize
import silk.mem.allocator {Allocator, OutOfMemoryError}

/// Retains a lazily installed immutable encoding behind a short publication lock.
/// An empty encoding denotes a value that has not been computed yet.
pub struct RuntimeBytes { value: Arc<Mutex<Published<Bytes>>> }

impl RuntimeBytes {
  /// Creates a cell containing the supplied encoding, or empty bytes for deferred computation.
  pub effect fn make(value: Bytes) -> Self ! OutOfMemoryError ? &mut Allocator {
    let held = run Published<Bytes>.make(move value)
    let locked = run Mutex<Published<Bytes>>.make(move held)
    return Self {value: run Arc<Mutex<Published<Bytes>>>.make(move locked)}
  }
  /// Retains the same publication cell.
  pub fn clone(self: &Self) -> Self { return Self {value: Arc<Mutex<Published<Bytes>>>.clone(&self.value)} }
  /// Retains the current encoding and releases the publication lock before returning.
  pub fn snapshot(self: &Self) -> Published<Bytes> {
    let guard = Mutex<Published<Bytes>>.lock(Arc<Mutex<Published<Bytes>>>.get(&self.value))
    return Published<Bytes>.clone(guard.get())
  }
  /// Invokes a callback with an immutable snapshot after releasing the publication lock.
  pub fn with<A>(self: &Self, use: once fn(&Bytes) -> A) -> A {
    let snapshot = RuntimeBytes.snapshot(self)
    return use(Published<Bytes>.get(&snapshot))
  }
  /// Installs a completed encoding only if no reader already installed one. Duplicate
  /// computations are safe: the input is immutable and every encoding is deterministic.
  pub effect fn keep(self: &Self, value: Bytes) -> () ! OutOfMemoryError ? &mut Allocator {
    let ready = run Published<Bytes>.make(move value)
    let mut guard = Mutex<Published<Bytes>>.lock(Arc<Mutex<Published<Bytes>>>.get(&self.value))
    if Published<Bytes>.with<usize>(guard.get(), Bytes.length) == 0 {
      guard.getMut().* = move ready
    } else {
      // All producers encoded this same immutable callable. Never silently select a different
      // value if a future mutation or incorrectly shared cache violates that invariant.
      if !RuntimeEncoding.equals(Bytes.asSlice(Published<Bytes>.get(guard.get())),
        Bytes.asSlice(Published<Bytes>.get(&ready))) {
        Intrinsic.trap("immutable callable runtime encoding changed after publication")
      }
    }
  }
}
