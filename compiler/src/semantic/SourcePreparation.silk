//! Immutable semantic inputs to complete body source analysis.
//!
//! Semantic resolves these tables through the owning body's tracked queries before graph
//! reservation. Prepared IDs are table coordinates, not source witnesses. SourceAnalysis owns
//! occurrence, route, case and proof IDs and authenticates them with its private analysis stamp.
//! No table is extended by solving, and no prepared package survives a body recheck or rebase.

import hir.Hir {Access, CallableMode}
import semantic.DeclarationId {DeclarationId}
import semantic.Lifetime {Intersection, Lifetime}
import semantic.Semantic {Constraint}
import semantic.Type {Binding, Row, RowParameter, Type}
import semantic.TypedBody {Local, LocalId, Node, NodeId, Origin, SafetyObligation, SourceAnonymousUse, SourceInference}
import silk.option {Option}
import silk.ownership {Copy}
import silk.shared {Shared}
import silk.usize
import silk.vector {Vector}

pub struct ShapeId { pub index: usize }
impl Copy for ShapeId {}
pub struct EndpointId { pub index: usize }
impl Copy for EndpointId {}
pub struct ApplicationId { pub index: usize }
impl Copy for ApplicationId {}
pub struct MapId { pub index: usize }
impl Copy for MapId {}
pub struct SelectionId { pub index: usize }
impl Copy for SelectionId {}
pub struct ContractRouteId { pub index: usize }
impl Copy for ContractRouteId {}
pub struct ContractSelectionId { pub index: usize }
impl Copy for ContractSelectionId {}
pub struct ContractProjectionId { pub index: usize }
impl Copy for ContractProjectionId {}
pub struct ContractContinuationId { pub index: usize }
impl Copy for ContractContinuationId {}
pub struct PredicateId { pub index: usize }
impl Copy for PredicateId {}
pub struct ComponentId { pub shape: ShapeId, pub ordinal: usize }
impl Copy for ComponentId {}
pub struct ResidualStateId { pub index: usize }
impl Copy for ResidualStateId {}
pub struct BoundarySubstitutionId { pub index: usize }
impl Copy for BoundarySubstitutionId {}
pub struct BoundaryTransitionId { pub index: usize }
impl Copy for BoundaryTransitionId {}

/// An original declared/header premise. This is kept separate from retained goals and from
/// the indexed predicate universe; candidates never become assumptions by being prepared.
pub struct RegionBound {
  pub longer: Shared<Lifetime>
  pub shorter: Shared<Lifetime>
}

/// Complete and recovery bodies share structural inputs; recovery never authorizes publication.
pub enum Coverage { Complete, Recovery }

/// A borrowed immutable snapshot, owned by the still-active semantic body query. Analysis uses
/// these exact inputs rather than accepting a second independently supplied node/local graph.
pub struct Body<'body> {
  pub owner: &'body DeclarationId
  pub supplied: &'body [Shared<Lifetime>]
  pub locals: &'body [Local]
  pub nodes: &'body [Node]
  pub root: NodeId
  pub pending: bool
  pub obligations: &'body [SafetyObligation]
  pub premises: &'body [RegionBound]
  pub coverage: Coverage
}

/// Positive emptiness is different from an unreadable declaration or an opaque type parameter.
pub union ShapeState {
  KnownEmpty,
  Inline,
  Reference,
  Slice,
  Array { pub length: usize },
  Effect,
  Opaque,
  Unavailable { pub reason: UnavailableReason },
}

/// A genuine unavailable input is retained explicitly. Missing a supported map is instead a
/// preparation failure, never an unavailable shape used to excuse an omitted component.
pub enum UnavailableReason { DeclarationUnavailable, RejectedShape, UnresolvedApplication }

pub struct Shape {
  /// The complete nominal application or structural type, preserving every argument owner.
  pub ty: Shared<Type>
  pub state: ShapeState
  pub components: Vector<Component>
}

/// One finite inline child or a boundary descriptor. A referent is not an inline owned child.
/// The child type is retained even at boundaries which must not recursively unfold.
pub struct Component {
  pub selector: Selector
  pub ty: Shared<Type>
  pub inline: bool
}

pub union Selector {
  /// Struct/tuple fields and nominal variant payloads retain both declaration coordinates.
  Member { pub declaration: Shared<DeclarationId>, pub member: usize, pub payload: usize },
  /// Structural tuple/anonymous record fields have no invented nominal member declaration.
  Field { pub ordinal: usize },
  /// Structural union members are distinguished from a record's field ordinal.
  Variant { pub ordinal: usize },
  Index { pub class: IndexClass },
  Referent,
  EffectSuccess,
  EffectFailure,
  /// An authenticated whole-value identity/copy/placement, not an unknown selector.
  Identity,
  /// A genuinely opaque location is distinct from an unknown source or failed shape query.
  Opaque,
}

pub union IndexClass { Exact { pub index: usize }, Remainder }

pub enum EndpointRole { Value, Storage }
pub enum ContractPort { Input, Environment, Result, Failure, Success, Capture }
/// Selected is the actual opened invocation signature, whose parameter coordinates can differ
/// from the full original target. Applied retains original-target coordinates after substitution.
pub enum TypeSpace { Original, Selected, Applied }

/// Entry locals have no fabricated RHS NodeId. Application endpoints retain declaration-space
/// roles separately from actual body expression endpoints.
pub union Root {
  Local { pub local: LocalId, pub role: EndpointRole },
  Node { pub node: NodeId, pub role: EndpointRole },
  Application { pub application: ApplicationId, pub port: ContractPort, pub ordinal: usize, pub space: TypeSpace },
}

pub struct Endpoint {
  pub root: Root
  pub parent: Option<EndpointId>
  pub selector: Selector
  pub shape: ShapeId
  pub origin: Origin
}

/// Original enclosing interface/provider application, before the operation's own binders are
/// assigned. A direct signature has no fabricated interface/provider identities.
pub union Target {
  Direct { pub declaration: Shared<DeclarationId> },
  Operation { pub operation: Shared<DeclarationId>, pub contract: Shared<Type>, pub provider: Shared<Type> },
  /// Exact invocation inference owner; runtime target-ordinal remapping is separate evidence.
  Callable { pub inference: Shared<DeclarationId>, pub contract: Shared<Type> },
}

/// A whole original selected contract plus its final, owner-keyed assignment. Correlation is
/// established in original space before applying bindings; equal caller atoms add no routes.
pub struct Application {
  pub site: NodeId
  pub origin: Origin
  pub target: Target
  pub owner: Shared<DeclarationId>
  pub typeParameters: Vector<Shared<Type>>
  pub callableParameterStart: usize
  pub lifetimeParameters: Vector<Shared<Lifetime>>
  pub rowParameters: Vector<RowParameter>
  pub bindings: Vector<Binding>
  /// Actual final/private inference assignments, still keyed by the selected fresh owner.
  /// These cannot be reconstructed from original target slots or applied type equality.
  pub selectedBindings: Vector<Binding>
  /// Actual opening/private-prefix domain for a retained callable producer, if it had one.
  pub inference: Option<Shared<SourceInference>>
  /// Exactly one original row per header-bearing Callable producer has Some. The formal
  /// application and raw-to-use transform identify its descriptor; neither proves its fields.
  /// Derived effect {} has no raw header row and must not demand a body-derived Signature.
  pub anonymous: Option<Shared<SourceAnonymousUse>>
  pub constraints: Vector<Constraint>
  pub isVariadic: bool
  pub isUnsafe: bool
  pub isStatic: bool
  pub closed: bool
  pub staticSlots: Vector<usize>
  pub parameters: Vector<Shared<Type>>
  pub result: Shared<Type>
  pub failure: Shared<Type>
  pub requirements: Shared<Row>
  pub constructs: bool
  pub environment: Option<Intersection>
  pub environmentWritten: bool
  pub environmentExempt: usize
  pub premises: Vector<PredicateId>
  /// Actual explicit argument reads; captured fields retain separate physical routes.
  pub arguments: Vector<NodeId>
}

/// Predicate identities are reserved before solving. Traversing a cycle cannot create a new
/// subject type, substitution environment or predicate, and revisiting one is never its proof.
pub union Predicate {
  Outlives { pub longer: Shared<Lifetime>, pub shorter: Shared<Lifetime> },
  Contents { pub subject: Shared<Type>, pub region: Shared<Lifetime> },
}

pub enum MapKind { Select, Copy, Place, Contract }

pub struct SelectionMap {
  pub site: NodeId
  pub origin: Origin
  pub source: EndpointId
  pub target: EndpointId
  pub selector: Selector
  pub kind: MapKind
  pub application: Option<ApplicationId>
  /// The exact finite component maps emitted with this transfer, recursively. A consumer may
  /// not recover the family from same-site, type equality or endpoint spelling.
  pub children: Vector<MapId>
  /// Set only at an actual whole-value Copy/Place append site. Raw reference creation and
  /// contract maps cannot acquire physical component authority from their kind or types.
  pub componentTransport: bool
  /// Separate address interpretation, admitted only for an actual Storage -> Storage
  /// Select/Identity family. Analysis must supply this exact map's contiguous alias/Eval
  /// evidence before use; availability alone creates no alias or evaluation.
  pub addressTransport: bool
  /// Root entries of this exact transport's paired residual graph. Descendant transitions
  /// are reachable only through BoundaryTransition.next, never a same-shape table search.
  pub boundaries: Vector<BoundaryTransitionId>
}

/// One finite requested selector suffix. vertex is the ORIGINAL selector vertex, even when
/// this state interprets it at a transported predecessor with no concrete child endpoint.
/// The key includes selection, vertex, input and output; equal types do not merge suffixes.
/// Authored states follow real selector vertices. Original contract states may retain a
/// normalized-away Variant prefix, justified only by their exact application projection.
/// Physical/StorageAlias boundaries never admit Contract authority.
pub union ResidualAuthority {
  Authored,
  Contract { pub projection: ContractProjectionId, pub terminal: bool },
}
impl Copy for ResidualAuthority {}
pub struct ResidualState {
  pub authority: ResidualAuthority
  pub selection: SelectionId
  pub vertex: EndpointId
  pub input: ComponentId
  pub output: ShapeId
  pub accepts: bool
  pub next: Vector<ResidualStateId>
}

/// Neither case rewrites a binder or proves Contents/outlives. Physical transport must already
/// be authenticated by the exact map. Identity explicitly records complete output identity;
/// AppliedPair retains two already-applied component types/nominal applications. Empty binding
/// vectors never select Identity. Original/final rewrites belong to Application/ContractRoute.
pub enum BoundarySubstitutionForm { Identity, AppliedPair }
pub struct BoundarySubstitution {
  /// Component RESULT shapes, equal to the source/target residual states' output fields.
  /// Descriptor parent shapes and access are recorded separately on BoundaryTransition.
  pub source: ShapeId
  pub target: ShapeId
  pub form: BoundarySubstitutionForm
}

pub enum BoundaryAuthority { Physical, StorageAlias }

/// Typed continuation across a real whole-descriptor transport or an actual storage alias.
/// StorageAlias additionally requires the exact occurrence-authenticated contiguous address
/// route; inverse traversal swaps BOTH paired states/components and substitution direction.
/// Neither authority admits Contract/Effect-success, parent->child selection, newly created
/// references, or the separate Value.Referent -> Storage Borrow/address boundary.
/// Each next edge follows BOTH sourceState.next and targetState.next under this SAME MapId.
/// Only entries in SelectionMap.boundaries are anchored directly to its endpoint parent shapes;
/// descendants retain paired histories/substitutions without requiring recursive endpoints.
pub struct BoundaryTransition {
  pub map: MapId
  pub authority: BoundaryAuthority
  pub sourceState: ResidualStateId
  pub targetState: ResidualStateId
  pub source: ComponentId
  pub target: ComponentId
  /// None for an inline/non-access-bearing parent, never a fabricated shared-access default.
  pub sourceAccess: Option<Access>
  pub targetAccess: Option<Access>
  pub substitution: BoundarySubstitutionId
  pub next: Vector<BoundaryTransitionId>
}

/// A finite prepared selector graph. Its vertices are endpoint IDs; start and accepting ports
/// remain explicit even for empty selection. The analysis issues a stamped SelectionId for it.
pub struct Selection {
  pub root: EndpointId
  pub accepts: Vector<EndpointId>
  pub maps: Vector<MapId>
}

/// A permitted original-input/result component correspondence. The precise original premise
/// IDs and endpoint types survive final application; this records no actual source presence.
pub struct ContractRoute {
  pub application: ApplicationId
  pub source: EndpointId
  pub target: EndpointId
  pub targetResidual: Option<ResidualStateId>
  pub maps: Vector<MapId>
  pub premises: Vector<PredicateId>
}

/// Enumeration is distinct from admitting a route or proving its predicate. Incomplete
/// describes genuine semantic opacity/unavailability/unresolved correlation, never a
/// missing supported map (which is a construction defect).
pub enum ContractGap { Opaque, Unavailable, Unresolved }
pub union ContractCoverage { Complete, Incomplete { pub reason: ContractGap } }
pub struct ContractSelection {
  pub application: ApplicationId
  /// Exact Original-domain ancestor. Unique by application, ancestor and residual.
  pub output: EndpointId
  /// Original-domain selected component at this ancestor, when no concrete child exists.
  pub residual: Option<ResidualStateId>
  pub routes: Vector<ContractRouteId>
  /// Complete+empty excludes original contract input routes only. It does not manufacture
  /// LoanFree, a source/owner, an outlives proof, or an actual completed result occurrence.
  pub coverage: ContractCoverage
}

/// Original route enumeration has exactly one authority. These projections transport it to
/// a selected opening or final application without recomputing regions after coalescing.
pub enum ContractProjectionStage { OriginalToSelected, OriginalToApplied }
pub struct ContractProjection {
  pub application: ApplicationId
  pub original: EndpointId
  pub output: EndpointId
  pub stage: ContractProjectionStage
  pub maps: Vector<MapId>
  /// A projected component exposed only by substitution of an opaque original ancestor.
  /// These exact endpoint selectors do not manufacture an original field or improve coverage.
  pub suffix: Vector<EndpointId>
  pub continuations: Vector<ContractContinuationId>
}

/// One finite selected-success/component continuation under this exact application transform.
/// Repeated runtime execution reuses these states; a repeated vertex is never a predicate proof.
pub struct ContractContinuation {
  pub projection: ContractProjectionId
  pub originalSelection: ContractSelectionId
  pub original: EndpointId
  /// Exact original advances for this one authored output step. Normalized-away union
  /// variants remain in this path; full path identity distinguishes coalesced contributors.
  /// Some originalState equals the last step. None with a nonempty path retains precisely
  /// its opaque last step's enumeration; empty None inherits the parent's unchanged row.
  pub originalPath: Vector<ResidualStateId>
  pub originalState: Option<ResidualStateId>
  pub outputState: ResidualStateId
  pub next: Vector<ContractContinuationId>
}

/// Physical value transport chosen by the producer. CallableMode alone cannot derive this:
/// staging a mutable base transfers it, whereas preparing an anonymous mutable Effect borrows it.
/// Evaluated uses the actual operand evaluation; it neither inserts a read nor guesses the
/// ownership transport of an arbitrary rvalue. Explicit callee-field transports stay separate.
pub enum Transport { Evaluated, Copy, Move, BorrowShared, BorrowMutable }
pub enum OperationPhase { Invoke, PrepareEffect, ExecuteEffect }

/// Exact operand occurrence within the typed producer. NodeId alone cannot distinguish
/// repeated evaluations. Field names the written fields-vector position, not its destination
/// field ordinal; Argument names the arguments-vector position, independent of pipeline order.
pub union InputRead {
  Argument {pub ordinal: usize},
  Receiver,
  Field {pub ordinal: usize},
}
impl Copy for InputRead {}

/// A real operand/component-to-capture/input map paired with BOTH selected and original input
/// endpoints. Anonymous Environment is explicit; static/represented inputs invent no value lane.
pub struct InputRoute {
  pub read: InputRead
  /// The map names physical source/capture endpoints; selected/original below are separate.
  pub map: MapId
  /// A producer-created reference also transports the original value to its Referent port.
  /// For BorrowShared/BorrowMutable, map is Storage -> descriptor and this is Value ->
  /// Referent, at the same actual source occurrence. Other transports have no new reference.
  pub referent: Option<MapId>
  pub selected: EndpointId
  pub original: EndpointId
  pub transport: Transport
}

/// The two physical maps of an authored Borrow node. Its actual place evaluation creates one
/// descriptor loan; the paired referent transfer carries the borrowed value separately.
/// This is not a selected contract input and has no fabricated application endpoint.
pub struct Borrow {
  pub site: NodeId
  pub map: MapId
  pub referent: MapId
}

/// Construction records physical holdings only, never a future invocation destination write.
pub struct Construction {
  pub site: NodeId
  pub origin: Origin
  pub application: ApplicationId
  pub inputs: Vector<InputRoute>
}

/// Execution binds these routes to the actual evaluation/read selected by SourceAnalysis.
/// A stored Run resolves its application alternatives through receiver's reaching descriptors.
pub struct Operation {
  pub site: NodeId
  pub origin: Origin
  pub phase: OperationPhase
  pub receiver: Option<EndpointId>
  /// Invocation access, independent of each physical route's explicit Transport.
  pub access: CallableMode
  pub application: Option<ApplicationId>
  pub inputs: Vector<InputRoute>
  /// Exact selected success/result family to the actual operation output. Invoke and
  /// ExecuteEffect require Some; PrepareEffect requires None because Construction owns
  /// the descriptor placement. This map never copies the receiver or all captures.
  pub result: Option<MapId>
}

/// Predicate obligations indexed against existing retained body goals. EnvironmentInput adds
/// its request authentication here only when that independent follow-on producer is integrated.
pub struct Obligation {
  pub ordinal: usize
  pub predicate: PredicateId
  pub endpoint: Option<EndpointId>
}

/// Construction failures preserve the originating actual node/endpoint. They are not a solver
/// gap or a successful package with an omitted component.
pub union Failure {
  MissingSupportedMap { pub site: NodeId, pub source: EndpointId, pub target: EndpointId },
  IncompatibleEndpoint { pub site: NodeId, pub endpoint: EndpointId },
  MissingApplication { pub site: NodeId },
  InvalidComponent { pub site: NodeId, pub shape: ShapeId },
}

/// Owned semantic descriptors plus the exact immutable body view. Only Semantic constructs
/// this package. SourceAnalysis consumes it; nothing stores it in a TypedBody or query answer.
pub struct SourcePreparation<'body> {
  pub body: Body<'body>
  pub shapes: Vector<Shape>
  pub endpoints: Vector<Endpoint>
  pub applications: Vector<Application>
  pub maps: Vector<SelectionMap>
  pub selections: Vector<Selection>
  pub residuals: Vector<ResidualState>
  pub boundarySubstitutions: Vector<BoundarySubstitution>
  pub boundaryTransitions: Vector<BoundaryTransition>
  pub routes: Vector<ContractRoute>
  pub contractSelections: Vector<ContractSelection>
  pub contractProjections: Vector<ContractProjection>
  pub contractContinuations: Vector<ContractContinuation>
  pub borrows: Vector<Borrow>
  pub constructions: Vector<Construction>
  pub operations: Vector<Operation>
  pub predicates: Vector<Predicate>
  pub premises: Vector<PredicateId>
  pub obligations: Vector<Obligation>
}

/// Copies a prepared root coordinate without changing its owner, role or application space.
pub fn copyRoot(value: &Root) -> Root {
  return match &value.* {
    Root.Local {local, role} => Root.Local {local: local, role: role}
    Root.Node {node, role} => Root.Node {node: node, role: role}
    Root.Application {application, port, ordinal, space} => Root.Application {
      application: application, port: port, ordinal: ordinal, space: space}
  }
}

/// Copies a typed selector; shared declaration evidence is preserved rather than reconstructed.
pub fn copySelector(value: &Selector) -> Selector {
  return match &value.* {
    Selector.Member {declaration, member, payload} => Selector.Member {
      declaration: Shared<DeclarationId>.clone(&declaration), member: member, payload: payload}
    Selector.Field {ordinal} => Selector.Field {ordinal: ordinal}
    Selector.Variant {ordinal} => Selector.Variant {ordinal: ordinal}
    Selector.Index {class: IndexClass.Exact {index}} => Selector.Index {class: IndexClass.Exact {index: index}}
    Selector.Index {class: IndexClass.Remainder} => Selector.Index {class: IndexClass.Remainder}
    Selector.Referent => Selector.Referent
    Selector.EffectSuccess => Selector.EffectSuccess
    Selector.EffectFailure => Selector.EffectFailure
    Selector.Identity => Selector.Identity
    Selector.Opaque => Selector.Opaque
  }
}
