//! Reachable return operands of one checked body, before its storage is realized.
//! Nested callable bodies are separate declarations; only their capture operands execute here.

import hir.Hir {InfixOperator}
import semantic.Type {Type}
import semantic.TypedBody {TypedBody, NodeId, NodeKind, Expression, AggregateField, Pattern, MatchArm, UnionMember, PatternTest}
import silk.allocator {Allocator, OutOfMemoryError}
import silk.option {Option}
import silk.shared {Shared}
import silk.usize
import silk.vector {Vector}

enum Kind { Sequence, Return, Fail, Break, Continue, Branch, While, Match, ShortCircuit }
struct View { kind: Kind count: usize first: usize second: usize third: usize never: bool }
struct Flow { normal: bool breaks: bool continues: bool }
struct PatternKey { kind: usize ordinal: usize magnitude: u64 negative: bool }
struct Arm { guard: usize result: usize universal: bool top: bool key: PatternKey }

fn patternKey(pattern: &Pattern) -> PatternKey {
  let mut key = PatternKey {kind: usize.ZERO, ordinal: usize.ZERO, magnitude: 0, negative: false}
  match &pattern.* {
    Pattern.Universal => { key.kind = usize.ONE }
    Pattern.Record {member} => {
      if let Option<UnionMember>.Some {value} = &member { key.kind = 2 key.ordinal = value.tag }
      else { key.kind = usize.ONE }
    }
    Pattern.Variant {tag} => { key.kind = 3 key.ordinal = tag }
    Pattern.EnumMember {member} => { key.kind = 4 key.ordinal = member.ordinal }
    Pattern.Integer {magnitude, negative} => { key.kind = 5 key.magnitude = magnitude key.negative = negative }
  }
  return move key
}
fn samePattern(left: &PatternKey, right: &PatternKey) -> bool {
  return left.kind == right.kind && left.ordinal == right.ordinal
    && left.magnitude == right.magnitude && left.negative == right.negative
}

fn normal() -> Flow { return Flow {normal: true, breaks: false, continues: false} }
fn join(value: &mut Flow, other: Flow) -> () {
  value.normal = value.normal || other.normal
  value.breaks = value.breaks || other.breaks
  value.continues = value.continues || other.continues
}
fn never(ty: &Type) -> bool {
  return match &ty.* { Type.Union {members} => Vector.length<Shared<Type>>(&members) == usize.ZERO _ => false }
}

fn view(body: &Shared<TypedBody>, id: NodeId) -> View {
  return Shared.with<TypedBody, View>(body, fn(value: &TypedBody) -> View {
    let mut result = View {kind: Kind.Sequence, count: usize.ZERO, first: usize.ZERO,
      second: usize.ZERO, third: usize.MAX, never: false}
    let nodes = TypedBody.nodeSlice(value)
    match &nodes[id.index].kind {
      NodeKind.Block {statements, ..} => { result.count = Vector.length<NodeId>(&statements) }
      NodeKind.LocalBinding {..} => { result.count = usize.ONE }
      NodeKind.MutableBinding {..} => { result.count = usize.ONE }
      NodeKind.Assignment {..} => { result.count = usize.ONE }
      NodeKind.PlaceAssignment {..} => { result.count = 2 }
      NodeKind.Drop {..} => { result.count = usize.ONE }
      NodeKind.Return {value: returned} => {
        result.kind = Kind.Return
        if let Option<NodeId>.Some {value: node} = &returned { result.count = usize.ONE result.first = node.index }
      }
      NodeKind.Fail {value: failure} => {
        result.kind = Kind.Fail result.count = usize.ONE result.first = failure.index
      }
      NodeKind.Break => { result.kind = Kind.Break }
      NodeKind.Continue => { result.kind = Kind.Continue }
      NodeKind.Branch {condition, thenBranch, elseBranch, ..} => {
        result.kind = Kind.Branch result.first = condition.index result.second = thenBranch.index
        if let Option<NodeId>.Some {value: node} = &elseBranch { result.third = node.index }
      }
      NodeKind.While {condition, body: repeated} => {
        result.kind = Kind.While result.first = condition.index result.second = repeated.index
      }
      NodeKind.Expression {ty, form} => {
        result.never = Shared.with<Type, bool>(&ty, never)
        match &form {
          Expression.Aggregate {fields} => { result.count = Vector.length<AggregateField>(&fields) }
          Expression.Callable {fields, ..} => { result.count = Vector.length<AggregateField>(&fields) }
          Expression.VariantConstruct {fields, ..} => { result.count = Vector.length<AggregateField>(&fields) }
          Expression.DirectCall {arguments, ..} => { result.count = Vector.length<NodeId>(&arguments) }
          Expression.ForeignCall {arguments, ..} => { result.count = Vector.length<NodeId>(&arguments) }
          Expression.IntrinsicCall {arguments, ..} => { result.count = Vector.length<NodeId>(&arguments) }
          Expression.StorageCall {arguments, ..} => { result.count = Vector.length<NodeId>(&arguments) }
          Expression.InterfaceCall {arguments, ..} => { result.count = Vector.length<NodeId>(&arguments) }
          Expression.CallableCall {arguments, ..} => { result.count = Vector.length<NodeId>(&arguments) + usize.ONE }
          Expression.StagedCallable {arguments, ..} => { result.count = Vector.length<NodeId>(&arguments) + usize.ONE }
          Expression.Match {subject, domain, arms, ..} => {
            result.kind = Kind.Match result.first = subject.index result.third = domain result.count = Vector.length<MatchArm>(&arms)
          }
          Expression.ConcreteInfix {operator, left, right} => {
            result.count = 2
            if operator == InfixOperator.And || operator == InfixOperator.Or {
              result.kind = Kind.ShortCircuit result.first = left.index result.second = right.index
              if operator == InfixOperator.And { result.third = usize.ONE } else { result.third = usize.ZERO }
            }
          }
          Expression.Index {..} => { result.count = 2 }
          Expression.Borrow {..} => { result.count = usize.ONE }
          Expression.PointerWeaken {..} => { result.count = usize.ONE }
          Expression.Dereference {..} => { result.count = usize.ONE }
          Expression.Field {..} => { result.count = usize.ONE }
          Expression.ArraySlice {..} => { result.count = usize.ONE }
          Expression.SliceLength {..} => { result.count = usize.ONE }
          Expression.ArrayLength {..} => { result.count = usize.ONE }
          Expression.EnumValue {..} => { result.count = usize.ONE }
          Expression.UnionInject {..} => { result.count = usize.ONE }
          Expression.UnionWiden {..} => { result.count = usize.ONE }
          Expression.Move {..} => { result.count = usize.ONE }
          Expression.ConcretePrefix {..} => { result.count = usize.ONE }
          Expression.CompileError {..} => { result.count = usize.ONE }
          Expression.Run {..} => { result.count = usize.ONE }
          _ => {}
        }
      }
    }
    return move result
  })
}

fn child(body: &Shared<TypedBody>, id: NodeId, at: usize) -> NodeId {
  return Shared.with<TypedBody, NodeId>(body, fn(value: &TypedBody) -> NodeId {
    let nodes = TypedBody.nodeSlice(value)
    return match &nodes[id.index].kind {
      NodeKind.Block {statements, ..} => Vector.asSlice<NodeId>(&statements)[at]
      NodeKind.LocalBinding {initializer, ..} => initializer
      NodeKind.MutableBinding {initializer, ..} => initializer
      NodeKind.Assignment {value: assigned, ..} => assigned
      NodeKind.PlaceAssignment {target, value: assigned} => { if at == usize.ZERO { return target } return assigned }
      NodeKind.Drop {value: dropped, ..} => dropped
      NodeKind.Return {value: returned} => match &returned { Option<NodeId>.Some {value: node} => node _ => id }
      NodeKind.Fail {value: failure} => failure
      NodeKind.Expression {form, ..} => match &form {
        Expression.Aggregate {fields} => Vector.asSlice<AggregateField>(&fields)[at].value
        Expression.Callable {fields, ..} => Vector.asSlice<AggregateField>(&fields)[at].value
        Expression.VariantConstruct {fields, ..} => Vector.asSlice<AggregateField>(&fields)[at].value
        Expression.DirectCall {arguments, ..} => Vector.asSlice<NodeId>(&arguments)[at]
        Expression.ForeignCall {arguments, ..} => Vector.asSlice<NodeId>(&arguments)[at]
        Expression.IntrinsicCall {arguments, ..} => Vector.asSlice<NodeId>(&arguments)[at]
        Expression.StorageCall {arguments, ..} => Vector.asSlice<NodeId>(&arguments)[at]
        Expression.InterfaceCall {arguments, ..} => Vector.asSlice<NodeId>(&arguments)[at]
        Expression.CallableCall {callee, arguments, pipeline, ..} => {
          if pipeline { if at == Vector.length<NodeId>(&arguments) { return callee } return Vector.asSlice<NodeId>(&arguments)[at] }
          if at == usize.ZERO { return callee } return Vector.asSlice<NodeId>(&arguments)[at - usize.ONE]
        }
        Expression.StagedCallable {callee, arguments, ..} => {
          if at == usize.ZERO { return callee } return Vector.asSlice<NodeId>(&arguments)[at - usize.ONE]
        }
        Expression.Index {value: subject, index} => { if at == usize.ZERO { return subject } return index }
        Expression.ConcreteInfix {left, right, ..} => { if at == usize.ZERO { return left } return right }
        Expression.ConcretePrefix {operand, ..} => operand
        Expression.Borrow {value: operand, ..} => operand
        Expression.PointerWeaken {value: operand} => operand
        Expression.Dereference {value: operand} => operand
        Expression.Field {value: operand, ..} => operand
        Expression.ArraySlice {value: operand, ..} => operand
        Expression.SliceLength {value: operand} => operand
        Expression.ArrayLength {value: operand, ..} => operand
        Expression.EnumValue {value: operand} => operand
        Expression.UnionInject {value: operand, ..} => operand
        Expression.UnionWiden {value: operand} => operand
        Expression.Move {value: operand, ..} => operand
        Expression.CompileError {message} => message
        Expression.Run {value: operand, ..} => operand
        _ => id
      }
      _ => id
    }
  })
}

// 0/1 are known Boolean values; MAX is a runtime condition.
fn boolean(body: &Shared<TypedBody>, id: NodeId) -> usize {
  return Shared.with<TypedBody, usize>(body, fn(value: &TypedBody) -> usize {
    let nodes = TypedBody.nodeSlice(value)
    if let NodeKind.Expression {form: Expression.Boolean {value: known}, ..} = &nodes[id.index].kind {
      if known { return usize.ONE } return usize.ZERO
    }
    return usize.MAX
  })
}
fn arm(body: &Shared<TypedBody>, id: NodeId, at: usize) -> Arm {
  return Shared.with<TypedBody, Arm>(body, fn(value: &TypedBody) -> Arm {
    let mut result = Arm {guard: usize.MAX, result: usize.ZERO, universal: false, top: false,
      key: PatternKey {kind: usize.ZERO, ordinal: usize.ZERO, magnitude: 0, negative: false}}
    let nodes = TypedBody.nodeSlice(value)
    if let NodeKind.Expression {form: Expression.Match {arms, ..}, ..} = &nodes[id.index].kind {
      let listed = Vector.asSlice<MatchArm>(&arms)
      result.result = listed[at].result.index
      if let Option<NodeId>.Some {value: guard} = &listed[at].guard { result.guard = guard.index }
      result.key = patternKey(&listed[at].pattern)
      result.top = Vector.length<PatternTest>(&listed[at].tests) == usize.ZERO
      result.universal = result.key.kind == usize.ONE && result.top
    }
    return move result
  })
}

effect fn sequence(body: &Shared<TypedBody>, id: NodeId, flow: &mut Flow, returns: &mut Vector<NodeId>) -> ()
! OutOfMemoryError ? &mut Allocator {
  if !flow.normal { return () }
  let next = run walk(body, id, &mut returns.*)
  flow.normal = next.normal
  flow.breaks = flow.breaks || next.breaks
  flow.continues = flow.continues || next.continues
  return ()
}

effect fn walk(body: &Shared<TypedBody>, id: NodeId, returns: &mut Vector<NodeId>) -> Flow
! OutOfMemoryError ? &mut Allocator {
  let selected = view(body, id)
  let mut flow = normal()
  match selected.kind {
    Kind.Sequence => {
      let mut at = usize.ZERO
      while at < selected.count && flow.normal {
        run sequence(body, child(body, id, at), &mut flow, &mut returns.*)
        at = at + usize.ONE
      }
    }
    Kind.Return => {
      if selected.count != usize.ZERO {
        run sequence(body, NodeId {index: selected.first}, &mut flow, &mut returns.*)
        if flow.normal { run Vector.append<NodeId>(&mut returns.*, NodeId {index: selected.first}) }
      }
      flow.normal = false
    }
    Kind.Fail => {
      run sequence(body, NodeId {index: selected.first}, &mut flow, &mut returns.*)
      flow.normal = false
    }
    Kind.Break => { flow.normal = false flow.breaks = true }
    Kind.Continue => { flow.normal = false flow.continues = true }
    Kind.Branch => {
      let condition = NodeId {index: selected.first}
      run sequence(body, condition, &mut flow, &mut returns.*)
      if flow.normal {
        flow.normal = false
        let known = boolean(body, condition)
        if known != usize.ZERO { join(&mut flow, run walk(body, NodeId {index: selected.second}, &mut returns.*)) }
        if known != usize.ONE {
          if selected.third == usize.MAX { flow.normal = true }
          else { join(&mut flow, run walk(body, NodeId {index: selected.third}, &mut returns.*)) }
        }
      }
    }
    Kind.While => {
      let condition = NodeId {index: selected.first}
      run sequence(body, condition, &mut flow, &mut returns.*)
      if flow.normal {
        let known = boolean(body, condition)
        if known != usize.ZERO {
          let iteration = run walk(body, NodeId {index: selected.second}, &mut returns.*)
          flow.normal = known != usize.ONE || iteration.breaks
        }
      }
    }
    Kind.ShortCircuit => {
      let condition = NodeId {index: selected.first}
      run sequence(body, condition, &mut flow, &mut returns.*)
      if flow.normal {
        let known = boolean(body, condition)
        if known == selected.third { run sequence(body, NodeId {index: selected.second}, &mut flow, &mut returns.*) }
        else if known == usize.MAX {
          join(&mut flow, run walk(body, NodeId {index: selected.second}, &mut returns.*))
        }
      }
    }
    Kind.Match => {
      run sequence(body, NodeId {index: selected.first}, &mut flow, &mut returns.*)
      if flow.normal {
        flow.normal = false
        let mut remaining = selected.third != usize.ZERO
        let mut excluded = Vector.make<usize>()
        let mut at = usize.ZERO
        while at < selected.count && remaining {
          let candidate = arm(body, id, at)
          let previous = Vector.asSlice<usize>(&excluded)
          let mut before = usize.ZERO
          let mut blocked = false
          while before < previous.length {
            let earlier = arm(body, id, previous[before])
            if samePattern(&earlier.key, &candidate.key) { blocked = true }
            before = before + usize.ONE
          }
          if blocked { at = at + usize.ONE continue }
          let mut evaluated = normal()
          let mut known = usize.ONE
          if candidate.guard != usize.MAX {
            let guard = NodeId {index: candidate.guard}
            run sequence(body, guard, &mut evaluated, &mut returns.*)
            known = boolean(body, guard)
          }
          let guardCompletes = evaluated.normal
          if known != usize.ZERO { run sequence(body, NodeId {index: candidate.result}, &mut evaluated, &mut returns.*) }
          else { evaluated.normal = false }
          join(&mut flow, move evaluated)
          if candidate.universal && (!guardCompletes || known == usize.ONE) { remaining = false }
          if candidate.top && (!guardCompletes || known == usize.ONE) {
            run Vector.append<usize>(&mut excluded, at)
            if selected.third != usize.MAX && Vector.length<usize>(&excluded) == selected.third { remaining = false }
          }
          at = at + usize.ONE
        }
      }
    }
  }
  if selected.never { flow.normal = false }
  return move flow
}

/// Collects reachable return values in execution order without borrowing a body across Effects.
pub effect fn collect(body: &Shared<TypedBody>) -> Vector<NodeId> ! OutOfMemoryError ? &mut Allocator {
  let root = Shared.with<TypedBody, NodeId>(body, TypedBody.rootNode)
  let mut returns = Vector.make<NodeId>()
  drop run walk(body, root, &mut returns)
  return move returns
}
