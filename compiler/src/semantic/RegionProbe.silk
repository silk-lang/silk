//! Temporary R3 census only (local scratch, never published). No record participates in a verdict.
import backend.InstanceKey {InstanceKey}
import semantic.InternIndex {InternIndex}
import semantic.DeclarationId {DeclarationId, contentKind}
import silk.u64
import silk.isize
import semantic.TypedBody {TypedBody, BorrowStatus}
import silk.allocator {Allocator, OutOfMemoryError}
import silk.bytes {Bytes}
import silk.pointer {Pointer}
import silk.shared {Shared}
import silk.usize
import silk.vector {Vector}

unsafe extern "C" fn write(fd: i32, buffer: *const u8, count: usize) -> isize with Intrinsic.foreign(noCapture: ("buffer",))
unsafe extern "C" fn dprintf(fd: i32, format: *const u8, ...) -> i32 with Intrinsic.foreign(noCapture: ("format",))

// kind 2: MIR map(exactKey, owner, mask)
// kind 3: emission inclusion(encoding, exactKey, reason)
// kind 4: final emitted regions identity(encoding)
pub fn numbers(kind: usize, first: u64, second: u64, a: usize) -> () {
  let format = b"; PROBE R3 %zu %llu %llu %zu\n\0"
  unsafe { let ignored = dprintf(2, Pointer.fromRef<u8>(&format[0]), kind, first, second, a) }
  return ()
}

pub effect fn keyHash(key: &InstanceKey) -> u64 ! OutOfMemoryError ? &mut Allocator {
  let content = run InstanceKey.encoding(key)
  return InternIndex.hashBytes(0, Bytes.asSlice(&content))
}

pub effect fn mapping(key: &InstanceKey, body: &Shared<TypedBody>) -> () ! OutOfMemoryError ? &mut Allocator {
  let status = Shared<TypedBody>.with<BorrowStatus>(body, TypedBody.borrowStatus)
  if status != BorrowStatus.Regions { return () }
  let mask = Shared<TypedBody>.with<usize>(body, fn(value: &TypedBody) -> usize { return value.probeMask })
  numbers(2, run keyHash(key), 0, mask)
  return ()
}

pub effect fn included(key: &InstanceKey, encoding: u64, status: BorrowStatus) -> () ! OutOfMemoryError ? &mut Allocator {
  if status != BorrowStatus.Regions { return () }
  numbers(3, encoding, run keyHash(key), 1)
  return ()
}

effect fn decimal(text: &mut Bytes, value: u64) -> () ! OutOfMemoryError ? &mut Allocator {
  if value >= 10 { run decimal(&mut text.*, value / 10) }
  let digit: [u8; 1] = [u64.toU8(value % 10 + 48)]
  run Bytes.append(&mut text.*, &digit)
  return ()
}

// kind 1: Regions body owner (extra = mask); kind 2: outside parameter atom in types (extra = prefix-of-owner);
// kind 3: outside local atom in types (extra = prefix-of-owner)
pub effect fn label(kind: usize, decl: &DeclarationId, extra: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut text = Bytes.make()
  let count = DeclarationId.ownerCount(decl)
  let mut at = usize.ZERO
  while at < count {
    if at > usize.ZERO { run Bytes.append(&mut text, b"/") }
    run Bytes.append(&mut text, b"k")
    run decimal(&mut text, contentKind(DeclarationId.ownerKind(decl, at)))
    run Bytes.append(&mut text, b":")
    if DeclarationId.ownerNamed(decl, at) {
      let name = run DeclarationId.copyOwnerName(decl, at)
      run Bytes.append(&mut text, Bytes.asSlice(&name))
    } else {
      run Bytes.append(&mut text, b"#")
      run decimal(&mut text, usize.toU64(DeclarationId.ownerOccurrence(decl, at)))
    }
    at = at + usize.ONE
  }
  run Bytes.append(&mut text, b"\n")
  let format = b"; PROBEDBG %zu %zu \0"
  unsafe { let ignored = dprintf(2, Pointer.fromRef<u8>(&format[0]), kind, extra) }
  let bytes = Bytes.asSlice(&text)
  unsafe { let written = write(2, Pointer.fromRef<u8>(&bytes[0]), bytes.length) }
  return ()
}
