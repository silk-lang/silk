//! Temporary R3 census only. No record participates in a checking decision.
import backend.InstanceKey {InstanceKey}
import semantic.DeclarationId {DeclarationId}
import semantic.InternIndex {InternIndex}
import semantic.ModuleId {ModuleId}
import semantic.Lifetime {Lifetime}
import semantic.Type {Type}
import semantic.TypedBody {TypedBody, BorrowStatus, Stage, SafetyObligation, NodeKind, uncheckedReason}
import silk.allocator {Allocator, OutOfMemoryError}
import silk.bytes {Bytes}
import silk.pointer {Pointer}
import silk.shared {Shared}
import silk.usize
import silk.vector {Vector}

unsafe extern "C" fn dprintf(fd: i32, format: *const u8, ...) -> i32 with Intrinsic.foreign(noCapture: ("format",))
unsafe extern "C" fn write(fd: i32, data: *const u8, count: usize) -> isize with Intrinsic.foreign(noCapture: ("data",))

// kind 1: unit(owner,0,mask,relations,contents,atomBits,rootStart)
// kind 2: MIR map(exactKey,owner,mask,0,0,0,0)
// kind 3: emission inclusion(encoding,exactKey,uncheckedReason,0,0,0,0)
// kind 4: final emitted regions identity(encoding,0,0,0,0,0,0)
// kind 5: relation(owner,0,offeredBits,wantedBits,start,end,0)
pub fn numbers(kind: usize, first: u64, second: u64, a: usize, b: usize, c: usize, d: usize, e: usize) -> () {
  let format = b"; PROBE R3 %zu %llu %llu %zu %zu %zu %zu %zu\n\0"
  unsafe { let ignored = dprintf(2, Pointer.fromRef<u8>(&format[0]), kind, first, second, a, b, c, d, e) }
  return ()
}

fn atomBits(region: &Lifetime, owner: &DeclarationId) -> usize {
  return match &region.* {
    Lifetime.Static => 1
    Lifetime.Parameter {declaration, ..} => { if DeclarationId.equals(&declaration, owner) { return 2 } return 8 }
    Lifetime.Local {declaration, ..} => { if DeclarationId.equals(&declaration, owner) { return 4 } return 16 }
    Lifetime.Invocation {..} => 32
    Lifetime.Supplied {..} => 64
    Lifetime.Meet {..} => 128
  }
}

effect fn typeBits(ty: &Shared<Type>, owner: &DeclarationId) -> usize ! OutOfMemoryError ? &mut Allocator {
  let mut regions = Vector<Shared<Lifetime>>.make()
  run Type.regionAtoms(ty, &mut regions)
  let atoms = Vector<Shared<Lifetime>>.asSlice(&regions)
  let mut bits = usize.ZERO
  let mut at = usize.ZERO
  while at < atoms.length {
    bits = usize.bitOr(bits, Shared<Lifetime>.with<usize>(&atoms[at], fn(value: &Lifetime) -> usize { return atomBits(value, owner) }))
    at = at + usize.ONE
  }
  return bits
}

pub effect fn record(body: &mut TypedBody, crossed: bool) -> () ! OutOfMemoryError ? &mut Allocator {
  if TypedBody.borrowStatus(&body.*) != BorrowStatus.Regions { return () }
  let owner = TypedBody.declarationId(&body.*)
  let hashed = DeclarationId.hash(owner)
  let mut label = run ModuleId.copyPath(DeclarationId.moduleId(owner))
  let mut step = usize.ZERO
  while step < DeclarationId.ownerCount(owner) {
    run Bytes.append(&mut label, b"/")
    let name = run DeclarationId.copyOwnerName(owner, step)
    run Bytes.append(&mut label, Bytes.asSlice(&name))
    step = step + usize.ONE
  }
  run Bytes.append(&mut label, b"\n")
  let format = b"; PROBE R3 NAME %llu \0"
  let labelBytes = Bytes.asSlice(&label)
  unsafe {
    let ignored = dprintf(2, Pointer.fromRef<u8>(&format[0]), hashed)
    let written = write(2, Pointer.fromRef<u8>(&labelBytes[0]), labelBytes.length)
  }
  let mut relations = usize.ZERO
  let mut contents = usize.ZERO
  let stage = TypedBody.checkingStage(&body.*)
  if let Stage.ContractTyped {obligations} = &stage.* {
    let list = Vector<SafetyObligation>.asSlice(&obligations)
    let mut at = usize.ZERO
    while at < list.length {
      match &list[at] {
        SafetyObligation.RegionRelation {origin, offered, wanted} => {
          relations = relations + usize.ONE
          let offeredBits = Shared<Lifetime>.with<usize>(&offered, fn(value: &Lifetime) -> usize { return atomBits(value, owner) })
          let wantedBits = Shared<Lifetime>.with<usize>(&wanted, fn(value: &Lifetime) -> usize { return atomBits(value, owner) })
          numbers(5, hashed, 0, offeredBits, wantedBits, origin.bytes.start, origin.bytes.end, 0)
        }
        SafetyObligation.Contents {..} => { contents = contents + usize.ONE }
        _ => ()
      }
      at = at + usize.ONE
    }
  }
  let mut bits = usize.ZERO
  let locals = TypedBody.localSlice(&body.*)
  let mut at = usize.ZERO
  while at < locals.length {
    bits = usize.bitOr(bits, run typeBits(&locals[at].ty, owner))
    at = at + usize.ONE
  }
  let nodes = TypedBody.nodeSlice(&body.*)
  at = usize.ZERO
  while at < nodes.length {
    if let NodeKind.Expression {ty, ..} = &nodes[at].kind { bits = usize.bitOr(bits, run typeBits(&ty, owner)) }
    at = at + usize.ONE
  }
  let root = TypedBody.rootNode(&body.*)
  let start = nodes[root.index].origin.bytes.start
  let mut mask = usize.ZERO
  if relations > usize.ZERO { mask = mask + 1 }
  if contents > usize.ZERO { mask = mask + 2 }
  if crossed { mask = mask + 4 }
  if usize.bitAnd(bits, 248) != usize.ZERO { mask = mask + 8 }
  numbers(1, hashed, 0, mask, relations, contents, bits, start)
  body.probeMask = mask
  return ()
}

pub effect fn keyHash(key: &InstanceKey) -> u64 ! OutOfMemoryError ? &mut Allocator {
  let content = run InstanceKey.encoding(key)
  return InternIndex.hashBytes(0, Bytes.asSlice(&content))
}

pub effect fn mapping(key: &InstanceKey, body: &Shared<TypedBody>) -> () ! OutOfMemoryError ? &mut Allocator {
  let status = Shared<TypedBody>.with<BorrowStatus>(body, TypedBody.borrowStatus)
  if status != BorrowStatus.Regions { return () }
  let mask = Shared<TypedBody>.with<usize>(body, fn(value: &TypedBody) -> usize { return value.probeMask })
  let owner = Shared<TypedBody>.with<u64>(body, fn(value: &TypedBody) -> u64 { return DeclarationId.hash(TypedBody.declarationId(value)) })
  numbers(2, run keyHash(key), owner, mask, 0, 0, 0, 0)
  return ()
}

pub effect fn included(key: &InstanceKey, encoding: u64, status: BorrowStatus) -> () ! OutOfMemoryError ? &mut Allocator {
  numbers(3, encoding, run keyHash(key), uncheckedReason(status), 0, 0, 0, 0)
  return ()
}
