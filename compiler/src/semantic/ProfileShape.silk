//! Resolve registered source parameter types into portable binding shapes.
//!
//! # When to use
//! A schema header supplies a concrete `Type`; resolve it here before calling
//! `ProfileBinding.prepare`. This actor follows canonical source member demands so forward
//! declarations and array extents have the same answers as ordinary semantic analysis.

import semantic.Types {Types}
import hir.Hir {OwnerKind}
import semantic.Lifetime {Lifetime}
import semantic.DeclarationId {DeclarationId}
import semantic.ModuleId {ModuleId}
import semantic.ModuleId {InvalidModulePath}
import semantic.ParameterSchema {ParameterSchema}
import semantic.ProfileBinding {EnumMember, NamedShape, RegisteredShape, Shape}
import semantic.Query {Cycle}
import semantic.ScalarEnum {Case as EnumCase}
import semantic.Semantic {
  Answer,
  Outcome,
  Member,
  MemberKind,
  RegisteredParameter,
  Request,
  Semantic,
  Value,
}
import semantic.SourceIndex {NoRejection, RevisionMismatch}
import semantic.StaticValue {IntegerType, Sign, Value as StaticData}
import semantic.StaticValue
import semantic.Target {Target}
import semantic.Type {Argument, Type}
import semantic.Rejection {Rejection}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.mem.box {Box}
import silk.collections.bytes {Bytes}
import silk.core.option {Option}
import silk.mem.pointer {Pointer}
import silk.core.result {Result}
import silk.mem.shared {Shared}
import silk.num.u8
import silk.num.u32
import silk.num.u64
import silk.num.usize
import silk.collections.list {List}

/// A source type cannot become a portable configuration value.
pub enum Problem {
  InvalidHeader,
  UnsupportedType,
  InvalidExtent,
  RecursiveShape,
  InvalidMember,
}

/// Concrete schemas aligned with the canonical registered declarations that supplied them.
pub struct Registered {
  pub schemas: List<RegisteredShape>,
  pub parameters: List<RegisteredParameter>,
}

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

fn integer(name: &[u8]) -> Option<IntegerType> {
  if same(name, b"u8") {
    return Option<IntegerType>.some(IntegerType.U8)
  }
  if same(name, b"u16") {
    return Option<IntegerType>.some(IntegerType.U16)
  }
  if same(name, b"u32") {
    return Option<IntegerType>.some(IntegerType.U32)
  }
  if same(name, b"u64") {
    return Option<IntegerType>.some(IntegerType.U64)
  }
  if same(name, b"usize") {
    return Option<IntegerType>.some(IntegerType.Usize)
  }
  if same(name, b"i8") {
    return Option<IntegerType>.some(IntegerType.I8)
  }
  if same(name, b"i16") {
    return Option<IntegerType>.some(IntegerType.I16)
  }
  if same(name, b"i32") {
    return Option<IntegerType>.some(IntegerType.I32)
  }
  if same(name, b"i64") {
    return Option<IntegerType>.some(IntegerType.I64)
  }
  if same(name, b"isize") {
    return Option<IntegerType>.some(IntegerType.Isize)
  }
  return Option<IntegerType>.none()
}

fn extent(bytes: &[u8]) -> Option<usize> {
  if bytes.length == usize.ZERO {
    return Option<usize>.none()
  }
  let mut value = usize.ZERO
  let mut at = usize.ZERO
  while at < bytes.length {
    let digit = bytes[at]
    if digit < 48 || digit > 57 {
      return Option<usize>.none()
    }
    value = match move usize.checkedMultiply(value, 10) {
      Option<usize>.Some {value: next} => next
      Option<usize>.None => {
        return Option<usize>.none()
      }
    }
    value = match move usize.checkedAdd(value, u8.toUsize(digit - 48)) {
      Option<usize>.Some {value: next} => next
      Option<usize>.None => {
        return Option<usize>.none()
      }
    }
    at = at + usize.ONE
  }
  return Option<usize>.some(value)
}

fn header(answer: &Result<Answer, NoRejection>) -> Option<Shared<ParameterSchema>> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.ParameterSchema {schema}} => Option<
        Shared<ParameterSchema>,
      >.some(Shared<ParameterSchema>.clone(&schema))
      _ => Option<Shared<ParameterSchema>>.none()
    }
    Result<Answer, NoRejection>.Failure {error: _} => Option<Shared<ParameterSchema>>.none()
  }
}

// The rejection of a refused parameter header answer, if it carries one.
fn refusedHeader(answer: &Result<Answer, NoRejection>) -> Option<Shared<Rejection>> {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Rejected {diagnostics, ..} = &value.outcome {
      let listed = List<Shared<Rejection>>.asSlice(&diagnostics)
      if listed.length > usize.ZERO { return Option<Shared<Rejection>>.some(Shared<Rejection>.clone(&listed[usize.ZERO])) }
    }
    if let Outcome.Unavailable {cause, ..} = &value.outcome { return Option<Shared<Rejection>>.some(Shared<Rejection>.clone(&cause)) }
  }
  return Option<Shared<Rejection>>.none()
}

struct NominalLengths {
  name: usize,
  kind: OwnerKind,
  arguments: usize,
}

struct NominalPath {
  module: ModuleId,
  name: Bytes,
  kind: OwnerKind,
}

struct MemberSet {
  identity: Shared<DeclarationId>,
  count: usize,
  representation: IntegerType,
}

struct MemberInfo {
  nameLength: usize,
  kind: MemberKind,
  isPublic: bool,
  discriminant: Option<EnumCase>,
}

fn memberSet(answer: &Result<Answer, NoRejection>) -> Option<MemberSet> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Members {identity, members, enumRepresentation}} => Option<
        MemberSet,
      >.some(
        MemberSet {
          identity: Shared<DeclarationId>.clone(&identity),
          count: List<Member>.length(&members),
          representation: enumRepresentation,
        },
      )
      _ => Option<MemberSet>.none()
    }
    _ => Option<MemberSet>.none()
  }
}

fn memberInfoAt(members: &List<Member>, ordinal: usize) -> Option<MemberInfo> {
  let listed = List<Member>.asSlice(members)
  if ordinal >= listed.length {
    return Option<MemberInfo>.none()
  }
  let length = match & listed[ordinal].name {
    Option<Bytes>.Some {value: text} => Bytes.length(&text)
    Option<Bytes>.None => usize.ZERO
  }
  return Option<MemberInfo>.some(
    MemberInfo {
      nameLength: length,
      kind: listed[ordinal].kind,
      isPublic: listed[ordinal].isPublic,
      discriminant: match & listed[ordinal].discriminant {
        Option<EnumCase>.Some {value: selected} => Option<EnumCase>.some(
          EnumCase {sign: selected.sign, magnitude: selected.magnitude},
        )
        Option<EnumCase>.None => Option<EnumCase>.none()
      },
    },
  )
}

fn memberInfo(answer: &Result<Answer, NoRejection>, ordinal: usize) -> Option<MemberInfo> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Members {members, ..}} => memberInfoAt(&members, ordinal)
      _ => Option<MemberInfo>.none()
    }
    _ => Option<MemberInfo>.none()
  }
}

fn copyMemberName(answer: &Result<Answer, NoRejection>, ordinal: usize, destination: &mut [u8]) -> bool {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Members {members, ..}} => {
        let listed = List<Member>.asSlice(&members)
        if ordinal >= listed.length {
          return false
        }
        return match & listed[ordinal].name {
          Option<Bytes>.Some {value: text} => copySlice(Bytes.asSlice(&text), move destination)
          Option<Bytes>.None => false
        }
      }
      _ => false
    }
    _ => false
  }
}

fn memberType(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.MemberShape {types}} => {
        let listed = List<Shared<Type>>.asSlice(&types)
        if listed.length != usize.ONE {
          return Option<Shared<Type>>.none()
        }
        return Option<Shared<Type>>.some(Shared<Type>.clone(&listed[usize.ZERO]))
      }
      _ => Option<Shared<Type>>.none()
    }
    _ => Option<Shared<Type>>.none()
  }
}

fn memberTypeCount(answer: &Result<Answer, NoRejection>) -> Option<usize> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.MemberShape {types}} => Option<usize>.some(
        List<Shared<Type>>.length(&types),
      )
      _ => Option<usize>.none()
    }
    _ => Option<usize>.none()
  }
}

fn sameDeclaration(left: &DeclarationId, right: &Shared<DeclarationId>) -> bool {
  return Shared<DeclarationId>.with<bool>(
    right,
    fn(value: &DeclarationId) -> bool {
      return DeclarationId.equals(left, value)
    },
  )
}

fn nominalMatches(value: &Type, identity: &Shared<DeclarationId>) -> bool {
  return match & value.* {
    Type.Nominal {declaration, ..} => sameDeclaration(&declaration, identity)
    _ => false
  }
}

fn alreadySeen(seen: &[Shared<DeclarationId>], identity: &Shared<DeclarationId>) -> bool {
  let mut at = usize.ZERO
  while at < seen.length {
    // `Shared.with` is exclusive even for inspection. A recursive shape can reach the
    // same allocation through a cloned handle, so detect that alias before nested reads.
    let leftAddress = Shared<DeclarationId>.with<usize>(
      &seen[at],
      fn(value: &DeclarationId) -> usize {
        return Pointer.address<DeclarationId>(Pointer.fromRef<DeclarationId>(value))
      },
    )
    let rightAddress = Shared<DeclarationId>.with<usize>(
      identity,
      fn(value: &DeclarationId) -> usize {
        return Pointer.address<DeclarationId>(Pointer.fromRef<DeclarationId>(value))
      },
    )
    if leftAddress == rightAddress {
      return true
    }
    if Shared<DeclarationId>.with<bool>(
      &seen[at],
      fn(value: &DeclarationId) -> bool {
        return sameDeclaration(value, identity)
      },
    ) {
      return true
    }
    at = at + usize.ONE
  }
  return false
}

effect fn nominalPath(ty: &Shared<Type>) -> Option<NominalPath>
! OutOfMemoryError
? &mut Allocator {
  let lengths = match move Shared<Type>.with<Option<NominalLengths>>(ty, nominalLengths) {
    Option<NominalLengths>.Some {value} => move value
    Option<NominalLengths>.None => {
      return Option<NominalPath>.none()
    }
  }
  if lengths.name == usize.ZERO {
    return Option<NominalPath>.none()
  }
  let module = match move Shared<Type>.with<Option<ModuleId>>(ty, nominalModule) {
    Option<ModuleId>.Some {value} => move value
    Option<ModuleId>.None => {
      return Option<NominalPath>.none()
    }
  }
  let mut name = run Bytes.zeroed(lengths.name)
  let copied = Shared<Type>.with<bool>(
    ty,
    fn(value: &Type) -> bool {
      return copyNominalName(value, Bytes.asMutSlice(&mut name))
    },
  )
  if !copied {
    return Option<NominalPath>.none()
  }
  return Option<NominalPath>.some(
    NominalPath {module: move module, name: move name, kind: lengths.kind},
  )
}

fn canonicalName(package: &[u8], path: &[u8], name: &[u8], destination: &mut [u8]) -> bool {
  if destination.length != package.length + path.length + name.length + 2 {
    return false
  }
  let mut at = usize.ZERO
  let mut i = usize.ZERO
  while i < package.length {
    destination[at] = package[i]
    at = at + usize.ONE
    i = i + usize.ONE
  }
  destination[at] = 47
  at = at + usize.ONE
  i = usize.ZERO
  while i < path.length {
    destination[at] = path[i]
    at = at + usize.ONE
    i = i + usize.ONE
  }
  destination[at] = 47
  at = at + usize.ONE
  i = usize.ZERO
  while i < name.length {
    destination[at] = name[i]
    at = at + usize.ONE
    i = i + usize.ONE
  }
  return true
}

fn nominalLengths(value: &Type) -> Option<NominalLengths> {
  return match & value.* {
    Type.Nominal {declaration, arguments, ..} => {
      return Option<NominalLengths>.some(
        NominalLengths {
          name: DeclarationId.withSpelling<usize>(&declaration, sliceLength),
          kind: DeclarationId.kind(&declaration),
          arguments: List<Argument>.length(&arguments),
        },
      )
    }
    _ => Option<NominalLengths>.none()
  }
}

fn sliceLength(bytes: &[u8]) -> usize {
  return bytes.length
}

fn copySlice(source: &[u8], target: &mut [u8]) -> bool {
  if source.length != target.length {
    return false
  }
  let mut at = usize.ZERO
  while at < source.length {
    target[at] = source[at]
    at = at + usize.ONE
  }
  return true
}

fn copyNominalName(value: &Type, name: &mut [u8]) -> bool {
  return match & value.* {
    Type.Nominal {declaration, ..} => DeclarationId.withSpelling<bool>(&declaration, fn(spelled: &[u8]) -> bool {
      return copySlice(spelled, move name)
    })
    _ => false
  }
}

// The module of the nominal declaration; the copy shares the module's components.
fn nominalModule(value: &Type) -> Option<ModuleId> {
  return match & value.* {
    Type.Nominal {declaration, ..} => Option<ModuleId>.some(ModuleId.copy(DeclarationId.moduleId(&declaration)))
    _ => Option<ModuleId>.none()
  }
}

/// Resolve one concrete source type using the selected target's pointer width.
pub effect fn resolve(
  semantic: &mut Semantic,
  request: &mut Request,
  target: &Target,
  ty: &Shared<Type>,
) -> Result<Shape, Problem>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let mut seen = List<Shared<DeclarationId>>.make()
  return run resolveInner(move semantic, move request, target, ty, &mut seen)
}

effect fn resolveInner(
  semantic: &mut Semantic,
  request: &mut Request,
  target: &Target,
  ty: &Shared<Type>,
  seen: &mut List<Shared<DeclarationId>>,
) -> Result<Shape, Problem>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let view = Shared<Type>.with<TypeView>(ty, typeView)
  return match move view {
    TypeView.Boolean => Result<Shape, Problem>.succeed(Shape.Boolean)
    TypeView.Integer {kind} => {
      let bits = StaticValue.integerBits(kind, Target.pointerBits(target))
      return match move bits {
        Option<u32>.Some {value} => Result<Shape, Problem>.succeed(
          Shape.Integer {kind: kind, bits: value},
        )
        Option<u32>.None => Result<Shape, Problem>.failResult(Problem.UnsupportedType)
      }
    }
    TypeView.String => Result<Shape, Problem>.succeed(Shape.String)
    TypeView.Array {element, length} => {
      let count = match move length {
        Option<usize>.Some {value} => value
        Option<usize>.None => {
          return Result<Shape, Problem>.failResult(Problem.InvalidExtent)
        }
      }
      let child = run resolveInner(move semantic, move request, target, &element, move seen)
      return match move child {
        Result<Shape, Problem>.Success {value} => Result<Shape, Problem>.succeed(
          Shape.Array {
            length: count,
            elementType: move element,
            element: run Box<Shape>.make(move value),
          },
        )
        Result<Shape, Problem>.Failure {error} => Result<Shape, Problem>.failResult(move error)
      }
    }
    TypeView.Nominal => run nominal(move semantic, move request, target, ty, move seen)
    TypeView.Unsupported => Result<Shape, Problem>.failResult(Problem.UnsupportedType)
  }
}

effect fn nominal(
  semantic: &mut Semantic,
  request: &mut Request,
  target: &Target,
  ty: &Shared<Type>,
  seen: &mut List<Shared<DeclarationId>>,
) -> Result<Shape, Problem>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let path = match move run nominalPath(ty) {
    Option<NominalPath>.Some {value} => move value
    Option<NominalPath>.None => {
      return Result<Shape, Problem>.failResult(Problem.UnsupportedType)
    }
  }
  let answer = run Semantic.demandMembers(
    &mut semantic.*,
    &mut request.*,
    &path.module,
    Bytes.asSlice(&path.name),
  )
  let set = match move Shared<Result<Answer, NoRejection>>.with<Option<MemberSet>>(
    &answer,
    memberSet,
  ) {
    Option<MemberSet>.Some {value} => move value
    Option<MemberSet>.None => {
      return Result<Shape, Problem>.failResult(Problem.InvalidMember)
    }
  }
  if !Shared<Type>.with<bool>(
    ty,
    fn(value: &Type) -> bool {
      return nominalMatches(value, &set.identity)
    },
  ) {
    return Result<Shape, Problem>.failResult(Problem.InvalidMember)
  }
  if alreadySeen(List<Shared<DeclarationId>>.asSlice(&seen.*), &set.identity) {
    return Result<Shape, Problem>.failResult(Problem.RecursiveShape)
  }
  run List<Shared<DeclarationId>>.append(&mut seen.*, Shared<DeclarationId>.clone(&set.identity))
  if path.kind == OwnerKind.Enumeration {
    if set.count == usize.ZERO {
      return Result<Shape, Problem>.failResult(Problem.InvalidMember)
    }
    let spelling = Bytes.asSlice(&path.name)
    let scoped = ModuleId.withComponents<usize>(&path.module, fn(origin: &[u8], package: &[u8], modulePath: &[u8]) -> usize {
      return package.length + modulePath.length
    })
    let mut canonical = run Bytes.zeroed(scoped + spelling.length + 2)
    if !ModuleId.withComponents<bool>(&path.module, fn(origin: &[u8], package: &[u8], modulePath: &[u8]) -> bool {
      return canonicalName(package, modulePath, spelling, Bytes.asMutSlice(&mut canonical))
    }) {
      return Result<Shape, Problem>.failResult(Problem.InvalidMember)
    }
    let mut members = List<EnumMember>.make()
    let mut at = usize.ZERO
    while at < set.count {
      let info = match move Shared<Result<Answer, NoRejection>>.with<Option<MemberInfo>>(
        &answer,
        fn(value: &Result<Answer, NoRejection>) -> Option<MemberInfo> {
          return memberInfo(value, at)
        },
      ) {
        Option<MemberInfo>.Some {value} => move value
        Option<MemberInfo>.None => {
          return Result<Shape, Problem>.failResult(Problem.InvalidMember)
        }
      }
      if info.kind != MemberKind.EnumCase || info.nameLength == usize.ZERO {
        return Result<Shape, Problem>.failResult(Problem.InvalidMember)
      }
      let discriminant = match move info.discriminant {
        Option<EnumCase>.Some {value} => move value
        Option<EnumCase>.None => {
          return Result<Shape, Problem>.failResult(Problem.InvalidMember)
        }
      }
      let mut name = run Bytes.zeroed(info.nameLength)
      if !Shared<Result<Answer, NoRejection>>.with<bool>(
        &answer,
        fn(value: &Result<Answer, NoRejection>) -> bool {
          return copyMemberName(value, at, Bytes.asMutSlice(&mut name))
        },
      ) {
        return Result<Shape, Problem>.failResult(Problem.InvalidMember)
      }
      let staticValue = match move StaticValue.enumeration(
        Shared<DeclarationId>.clone(&set.identity),
        at,
        set.representation,
        discriminant.sign,
        discriminant.magnitude,
      ) {
        Option<StaticData>.Some {value} => move value
        Option<StaticData>.None => {
          return Result<Shape, Problem>.failResult(Problem.InvalidMember)
        }
      }
      run List<EnumMember>.append(
        &mut members,
        EnumMember {name: move name, value: run Shared<StaticData>.make(move staticValue)},
      )
      at = at + usize.ONE
    }
    let last = List<Shared<DeclarationId>>.length(&seen.*) - usize.ONE
    let discarded = List<Shared<DeclarationId>>.remove(&mut seen.*, last)
    drop discarded
    return Result<Shape, Problem>.succeed(
      Shape.Enum {canonical: move canonical, members: move members},
    )
  }
  if path.kind == OwnerKind.Struct {
    let mut fields = List<NamedShape>.make()
    let mut at = usize.ZERO
    while at < set.count {
      let info = match move Shared<Result<Answer, NoRejection>>.with<Option<MemberInfo>>(
        &answer,
        fn(value: &Result<Answer, NoRejection>) -> Option<MemberInfo> {
          return memberInfo(value, at)
        },
      ) {
        Option<MemberInfo>.Some {value} => move value
        Option<MemberInfo>.None => {
          return Result<Shape, Problem>.failResult(Problem.InvalidMember)
        }
      }
      if info.kind != MemberKind.Field || info.nameLength == usize.ZERO || !info.isPublic {
        return Result<Shape, Problem>.failResult(Problem.UnsupportedType)
      }
      let mut name = run Bytes.zeroed(info.nameLength)
      if !Shared<Result<Answer, NoRejection>>.with<bool>(
        &answer,
        fn(value: &Result<Answer, NoRejection>) -> bool {
          return copyMemberName(value, at, Bytes.asMutSlice(&mut name))
        },
      ) {
        return Result<Shape, Problem>.failResult(Problem.InvalidMember)
      }
      let fieldAnswer = run Semantic.demandMemberShape(
        &mut semantic.*,
        &mut request.*,
        &path.module,
        Bytes.asSlice(&path.name),
        at,
        ty,
      )
      let fieldType = match move Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(
        &fieldAnswer,
        memberType,
      ) {
        Option<Shared<Type>>.Some {value} => move value
        Option<Shared<Type>>.None => {
          return Result<Shape, Problem>.failResult(Problem.InvalidMember)
        }
      }
      let child = match move run resolveInner(
        &mut semantic.*,
        &mut request.*,
        target,
        &fieldType,
        &mut seen.*,
      ) {
        Result<Shape, Problem>.Success {value} => move value
        Result<Shape, Problem>.Failure {error} => {
          return Result<Shape, Problem>.failResult(move error)
        }
      }
      run List<NamedShape>.append(
        &mut fields,
        NamedShape {name: move name, ty: move fieldType, value: run Box<Shape>.make(move child)},
      )
      at = at + usize.ONE
    }
    let last = List<Shared<DeclarationId>>.length(&seen.*) - usize.ONE
    let discarded = List<Shared<DeclarationId>>.remove(&mut seen.*, last)
    drop discarded
    return Result<Shape, Problem>.succeed(Shape.Record {fields: move fields})
  }
  if path.kind == OwnerKind.Union {
    if set.count != 2 {
      return Result<Shape, Problem>.failResult(Problem.UnsupportedType)
    }
    let mut absent = Option<usize>.none()
    let mut present = Option<usize>.none()
    let mut payloadType = Option<Shared<Type>>.none()
    let mut payloadShape = Option<Shape>.none()
    let mut at = usize.ZERO
    while at < set.count {
      let info = match move Shared<Result<Answer, NoRejection>>.with<Option<MemberInfo>>(
        &answer,
        fn(value: &Result<Answer, NoRejection>) -> Option<MemberInfo> {
          return memberInfo(value, at)
        },
      ) {
        Option<MemberInfo>.Some {value} => move value
        Option<MemberInfo>.None => {
          return Result<Shape, Problem>.failResult(Problem.InvalidMember)
        }
      }
      if info.kind != MemberKind.Variant || !info.isPublic {
        return Result<Shape, Problem>.failResult(Problem.UnsupportedType)
      }
      let variantAnswer = run Semantic.demandMemberShape(
        &mut semantic.*,
        &mut request.*,
        &path.module,
        Bytes.asSlice(&path.name),
        at,
        ty,
      )
      let count = match move Shared<Result<Answer, NoRejection>>.with<Option<usize>>(
        &variantAnswer,
        memberTypeCount,
      ) {
        Option<usize>.Some {value} => value
        Option<usize>.None => {
          return Result<Shape, Problem>.failResult(Problem.InvalidMember)
        }
      }
      if count == usize.ZERO {
        if let Option<usize>.Some {..} = &absent {
          return Result<Shape, Problem>.failResult(Problem.UnsupportedType)
        }
        absent = Option<usize>.some(at)
      } else if count == usize.ONE {
        if let Option<usize>.Some {..} = &present {
          return Result<Shape, Problem>.failResult(Problem.UnsupportedType)
        }
        let childType = match move Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(
          &variantAnswer,
          memberType,
        ) {
          Option<Shared<Type>>.Some {value} => move value
          Option<Shared<Type>>.None => {
            return Result<Shape, Problem>.failResult(Problem.InvalidMember)
          }
        }
        let child = match move run resolveInner(
          &mut semantic.*,
          &mut request.*,
          target,
          &childType,
          &mut seen.*,
        ) {
          Result<Shape, Problem>.Success {value} => move value
          Result<Shape, Problem>.Failure {error} => {
            return Result<Shape, Problem>.failResult(move error)
          }
        }
        present = Option<usize>.some(at)
        payloadType = Option<Shared<Type>>.some(move childType)
        payloadShape = Option<Shape>.some(move child)
      } else {
        return Result<Shape, Problem>.failResult(Problem.UnsupportedType)
      }
      at = at + usize.ONE
    }
    let absentIndex = match move absent {
      Option<usize>.Some {value} => value
      Option<usize>.None => {
        return Result<Shape, Problem>.failResult(Problem.UnsupportedType)
      }
    }
    let presentIndex = match move present {
      Option<usize>.Some {value} => value
      Option<usize>.None => {
        return Result<Shape, Problem>.failResult(Problem.UnsupportedType)
      }
    }
    let elementType = match move payloadType {
      Option<Shared<Type>>.Some {value} => move value
      Option<Shared<Type>>.None => {
        return Result<Shape, Problem>.failResult(Problem.UnsupportedType)
      }
    }
    let element = match move payloadShape {
      Option<Shape>.Some {value} => move value
      Option<Shape>.None => {
        return Result<Shape, Problem>.failResult(Problem.UnsupportedType)
      }
    }
    let last = List<Shared<DeclarationId>>.length(&seen.*) - usize.ONE
    let discarded = List<Shared<DeclarationId>>.remove(&mut seen.*, last)
    drop discarded
    return Result<Shape, Problem>.succeed(
      Shape.Optional {
        absent: absentIndex,
        present: presentIndex,
        elementType: move elementType,
        element: run Box<Shape>.make(move element),
      },
    )
  }
  return Result<Shape, Problem>.failResult(Problem.UnsupportedType)
}

union TypeView {
  Boolean,
  Integer {kind: IntegerType},
  String,
  Array {element: Shared<Type>, length: Option<usize>},
  Nominal,
  Unsupported,
}

fn typeView(value: &Type) -> TypeView {
  return match & value.* {
    Type.Primitive {name} => {
      let spelling = Bytes.asSlice(&name)
      if same(spelling, b"bool") {
        return TypeView.Boolean
      }
      return match move integer(spelling) {
        Option<IntegerType>.Some {value: selected} => TypeView.Integer {kind: selected}
        Option<IntegerType>.None => TypeView.Unsupported
      }
    }
    Type.String {lifetime} => {
      let isStatic = Shared<Lifetime>.with<bool>(
        &lifetime,
        fn(value: &Lifetime) -> bool {
          return match & value.* {
            Lifetime.Static => true
            _ => false
          }
        },
      )
      if isStatic {
        return TypeView.String
      }
      return TypeView.Unsupported
    }
    Type.Array {element, extent: length} => TypeView.Array {
      element: Shared<Type>.clone(&element),
      length: extent(Bytes.asSlice(&length)),
    }
    Type.Nominal {..} => TypeView.Nominal
    _ => TypeView.Unsupported
  }
}

/// Why the registered headers cannot form a binding schema: a header the semantic store rejected,
/// with its located diagnostic, or a resolved type that has no portable shape.
pub union Refusal {
  Rejected {pub rejection: Shared<Rejection>},
  Shape {pub problem: Problem},
}

/// Resolve all registered headers into U7's concrete binding schema input.
pub effect fn registered(semantic: &mut Semantic, request: &mut Request, target: &Target) -> Result<
  Registered,
  Problem,
> ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  return match move run registeredOrRefused(&mut semantic.*, &mut request.*, target) {
    Result<Registered, Refusal>.Success {value} => Result<Registered, Problem>.succeed(move value)
    Result<Registered, Refusal>.Failure {error} => match move error {
      Refusal.Rejected {rejection} => {
        drop rejection
        return Result<Registered, Problem>.failResult(Problem.InvalidHeader)
      }
      Refusal.Shape {problem} => Result<Registered, Problem>.failResult(problem)
    }
  }
}

/// As [`registered`], keeping the rejection of a refused header so it can be reported where it is.
pub effect fn registeredOrRefused(semantic: &mut Semantic, request: &mut Request, target: &Target) -> Result<
  Registered,
  Refusal,
> ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let demanded = run Semantic.demandRegisteredParameters(&mut semantic.*, &mut request.*)
  let found = match move demanded {
    Result<List<RegisteredParameter>, Shared<Rejection>>.Success {value} => move value
    Result<List<RegisteredParameter>, Shared<Rejection>>.Failure {error} => {
      return Result<Registered, Refusal>.failResult(Refusal.Rejected {rejection: move error})
    }
  }
  let mut remaining = move found
  let mut shapes = List<RegisteredShape>.make()
  let mut parameters = List<RegisteredParameter>.make()
  while List<RegisteredParameter>.length(&remaining) > usize.ZERO {
    let item = List<RegisteredParameter>.remove(&mut remaining, usize.ZERO)
    let schema = match move Shared<
      Result<Answer, NoRejection>,
    >.with<
      Option<Shared<ParameterSchema>>,
    >(&item.answer, header) {
      Option<Shared<ParameterSchema>>.Some {value} => move value
      Option<Shared<ParameterSchema>>.None => {
        if let Option<Shared<Rejection>>.Some {value: rejected} = move Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(&item.answer, refusedHeader) {
          return Result<Registered, Refusal>.failResult(Refusal.Rejected {rejection: move rejected})
        }
        return Result<Registered, Refusal>.failResult(Refusal.Shape {problem: Problem.InvalidHeader})
      }
    }
    let ty = Shared<ParameterSchema>.with<Shared<Type>>(
      &schema,
      fn(value: &ParameterSchema) -> Shared<Type> {
        return Shared<Type>.clone(&value.ty)
      },
    )
    let resolved = run resolve(&mut semantic.*, &mut request.*, target, &ty)
    let shape = match move resolved {
      Result<Shape, Problem>.Success {value} => move value
      Result<Shape, Problem>.Failure {error} => {
        return Result<Registered, Refusal>.failResult(Refusal.Shape {problem: error})
      }
    }
    run List<RegisteredShape>.append(
      &mut shapes,
      RegisteredShape {schema: move schema, shape: move shape},
    )
    run List<RegisteredParameter>.append(&mut parameters, move item)
  }
  return Result<Registered, Refusal>.succeed(
    Registered {schemas: move shapes, parameters: move parameters},
  )
}
