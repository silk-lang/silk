test effect fn coherenceAcrossOwnerModules() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run coherenceClaims(7)
    |> Effect.provideMut<Allocator>(&mut allocator)
}

// The coherence answer of a module's `occurrence`th `impl`, addressed by its identity.
effect fn coherenceOf(
  semantic: &mut Semantic,
  request: &mut Request,
  index: &mut SourceIndex,
  module: &ModuleId,
  occurrence: usize,
) -> Shared<Result<Answer, NoRejection>>
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator {
  let identity = run requireIndexedIdentity(&mut index.*, module, OwnerKind.Implementation, b"", occurrence)
  return run Semantic.demandCoherence(&mut semantic.*, &mut request.*, &identity)
}

fn coherent(answer: &Shared<Result<Answer, NoRejection>>) -> bool {
  return Shared.with<Result<Answer, NoRejection>, bool>(
    answer,
    fn(value: &Result<Answer, NoRejection>) -> bool {
      return match & value.* {
        Result<Answer, NoRejection>.Success {value: found} => match & found.outcome {
          Outcome.Success {value: result} => match & result {
            Value.Coherent => true
            _ => false
          }
          _ => false
        }
        Result<Answer, NoRejection>.Failure {error: _} => false
      }
    },
  )
}

fn pathIs(path: &Vector<Shared<DeclarationId>>, primary: &DeclarationId, related: &DeclarationId) -> bool {
  let listed = Vector.asSlice<Shared<DeclarationId>>(path)
  if listed.length != 2 {
    return false
  }
  let first = Shared.with<DeclarationId, bool>(
    &listed[usize.ZERO],
    fn(value: &DeclarationId) -> bool {
      return DeclarationId.equals(value, primary)
    },
  )
  let second = Shared.with<DeclarationId, bool>(
    &listed[usize.ONE],
    fn(value: &DeclarationId) -> bool {
      return DeclarationId.equals(value, related)
    },
  )
  return first && second
}

// A conflict anchored at the primary head in `module`, naming the primary then the related head.
fn conflictIs(
  answer: &Shared<Result<Answer, NoRejection>>,
  code: RejectionCode,
  module: &ModuleId,
  start: usize,
  primary: &DeclarationId,
  related: &DeclarationId,
) -> bool {
  let found = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(answer, rejection)
  if let Option<Shared<Rejection>>.Some {value} = move found {
    return Shared.with<Rejection, bool>(
      &value,
      fn(diagnostic: &Rejection) -> bool {
        return diagnostic.code == code && ModuleId.equals(&diagnostic.module, module) && diagnostic.span.start == start && pathIs(
          &diagnostic.path,
          primary,
          related,
        )
      },
    )
  }
  return false
}

fn terminatesAt(answer: &Shared<Result<Answer, NoRejection>>, step: TerminationStep, start: usize) -> bool {
  let found = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(answer, rejection)
  if let Option<Shared<Rejection>>.Some {value} = move found {
    return Shared.with<Rejection, bool>(
      &value,
      fn(diagnostic: &Rejection) -> bool {
        return diagnostic.code == RejectionCode.NonterminatingConformance && diagnostic.termination == step && diagnostic.span.start == start
      },
    )
  }
  return false
}

// Both heads of a pair report the same conflict: `later` primary, `earlier` related.
effect fn pairConflicts(
  semantic: &mut Semantic,
  request: &mut Request,
  index: &mut SourceIndex,
  module: &ModuleId,
  earlier: usize,
  later: usize,
  code: RejectionCode,
  start: usize,
) -> bool ! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> ? &mut Allocator {
  let primary = run requireIndexedIdentity(&mut index.*, module, OwnerKind.Implementation, b"", later)
  let related = run requireIndexedIdentity(&mut index.*, module, OwnerKind.Implementation, b"", earlier)
  let first = run Semantic.demandCoherence(&mut semantic.*, &mut request.*, &related)
  let second = run Semantic.demandCoherence(&mut semantic.*, &mut request.*, &primary)
  return conflictIs(&first, code, module, start, &primary, &related) && conflictIs(
    &second,
    code,
    module,
    start,
    &primary,
    &related,
  )
}

effect fn pairCoherent(
  semantic: &mut Semantic,
  request: &mut Request,
  index: &mut SourceIndex,
  module: &ModuleId,
  earlier: usize,
  later: usize,
) -> bool ! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> ? &mut Allocator {
  let first = run coherenceOf(&mut semantic.*, &mut request.*, &mut index.*, module, earlier)
  let second = run coherenceOf(&mut semantic.*, &mut request.*, &mut index.*, module, later)
  return coherent(&first) && coherent(&second)
}

fn providerOf(head: &Option<Shared<ImplementationHead>>) -> Option<Shared<Type>> {
  if let Option<Shared<ImplementationHead>>.Some {value} = &head.* {
    return Option.some<Shared<Type>>(
      Shared.with<ImplementationHead, Shared<Type>>(
        &value,
        fn(found: &ImplementationHead) -> Shared<Type> {
          return Shared.clone<Type>(&found.provider)
        },
      ),
    )
  }
  return Option.none<Shared<Type>>()
}

fn typePresent(found: &Option<Shared<Type>>) -> bool {
  return match & found.* {
    Option<Shared<Type>>.Some {..} => true
    Option<Shared<Type>>.None => false
  }
}

fn proofStepCount(decision: &ConformanceDecision) -> usize {
  return match & decision.* {
    ConformanceDecision.Proven {proof} => Vector.length<ConformanceStep>(&proof.steps)
    ConformanceDecision.Rejected {..} => usize.MAX
  }
}

fn stepDeclared(step: &ConformanceStep) -> bool {
  return match & step.evidence {
    ConformanceEvidence.Declared {..} => true
    _ => false
  }
}

fn proofDeclaredCount(decision: &ConformanceDecision) -> usize {
  if let ConformanceDecision.Proven {proof} = &decision.* {
    let steps = Vector.asSlice<ConformanceStep>(&proof.steps)
    let mut count = usize.ZERO
    let mut at = usize.ZERO
    while at < steps.length {
      if stepDeclared(&steps[at]) {
        count = count + usize.ONE
      }
      at = at + usize.ONE
    }
    return count
  }
  return usize.MAX
}

fn proofFailureCode(decision: &ConformanceDecision) -> Option<RejectionCode> {
  return match & decision.* {
    ConformanceDecision.Proven {..} => Option.none<RejectionCode>()
    ConformanceDecision.Rejected {diagnostic, ..} => Option.some<RejectionCode>(
      Shared.with<Rejection, RejectionCode>(&diagnostic, fn(value: &Rejection) -> RejectionCode {
        return value.code
      }),
    )
  }
}

fn proofFailsWith(decision: &ConformanceDecision, code: RejectionCode) -> bool {
  if let Option<RejectionCode>.Some {value} = move proofFailureCode(decision) {
    return value == code
  }
  return false
}

fn proofChainLength(decision: &ConformanceDecision) -> usize {
  return match & decision.* {
    ConformanceDecision.Proven {..} => usize.ZERO
    ConformanceDecision.Rejected {chain, ..} => Vector.length<ConformanceGoal>(&chain)
  }
}

fn boundAt(answer: &Result<Answer, NoRejection>, at: usize) -> Option<Constraint> {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Signature {signature}} = &value.outcome {
      let constraints = Vector.asSlice<Constraint>(&signature.constraints)
      if at < constraints.length {
        if let Constraint.Conforms {provider, contract} = &constraints[at] {
          return Option.some<Constraint>(Constraint.Conforms {
            provider: Shared.clone<Type>(&provider),
            contract: Shared.clone<Type>(&contract),
          })
        }
      }
    }
  }
  return Option.none<Constraint>()
}

effect fn declaredOf(answer: &Shared<Result<Answer, NoRejection>>) -> Vector<Constraint>
! OutOfMemoryError
? &mut Allocator {
  let mut constraints = Vector.make<Constraint>()
  let mut at = usize.ZERO
  while true {
    let found = Shared.with<Result<Answer, NoRejection>, Option<Constraint>>(
      answer,
      fn(value: &Result<Answer, NoRejection>) -> Option<Constraint> {
        return boundAt(value, at)
      },
    )
    if let Option<Constraint>.Some {value} = move found {
      run Vector.append<Constraint>(&mut constraints, move value)
    } else {
      return move constraints
    }
    at = at + usize.ONE
  }
  return move constraints
}

test effect fn conformanceProofsAreComplete() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run conformanceProofClaims()
    |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn conformanceProofClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator {
  let moduleId = run module("proofs.silk")
  let text = """
interface Display {}
interface A {}
interface B {}
interface Both {}
service Logger {}
interface Shape { fn area(value: Self) -> i32 }
struct Item {}
struct Missing {}
struct Wrong {}
struct Box<T> { value: T }
impl Display for Item {}
impl<T: Display> Display for Box<T> {}
impl A for Missing {}
impl<T: A + B> Both for Box<T> {}
impl Logger for Item {}
impl Shape for Wrong { fn area(value: Self) -> bool { return true } }
fn deep(value: Box<Box<Item>>) -> i32 { return 0 }
fn absent(value: Box<Box<Missing>>) -> i32 { return 0 }
fn conditional(value: Box<Missing>) -> i32 { return 0 }
fn serviceGoal(value: Item) -> i32 { return 0 }
fn wrong(value: Wrong) -> i32 { return 0 }
fn first<T: A + B>(value: Box<T>) -> i32 { return 0 }
fn reversed<T: B + A>(value: Box<T>) -> i32 { return 0 }
"""
  let source = run present(text)
  let revision = run Revision.publish(&Revision.make(), &moduleId, &source)
  let mut semantic = makeSemantic(move revision)
  let mut request = Request.make()
  let implementations = run Semantic.demandImplementations(&mut semantic, &mut request, &moduleId)
  let display = contractOf(&headAt(&implementations, usize.ZERO))
  let both = contractOf(&headAt(&implementations, 3))
  let logger = contractOf(&headAt(&implementations, 4))
  let shape = contractOf(&headAt(&implementations, 5))
  let deepSignature = run Semantic.demandSignature(&mut semantic, &mut request, &moduleId, b"deep")
  let absentSignature = run Semantic.demandSignature(&mut semantic, &mut request, &moduleId, b"absent")
  let conditionalSignature = run Semantic.demandSignature(&mut semantic, &mut request, &moduleId, b"conditional")
  let serviceSignature = run Semantic.demandSignature(&mut semantic, &mut request, &moduleId, b"serviceGoal")
  let wrongSignature = run Semantic.demandSignature(&mut semantic, &mut request, &moduleId, b"wrong")
  let firstSignature = run Semantic.demandSignature(&mut semantic, &mut request, &moduleId, b"first")
  let reversedSignature = run Semantic.demandSignature(&mut semantic, &mut request, &moduleId, b"reversed")
  let none = Vector.make<Constraint>()
  run Testing.expect(
    typePresent(&display) && typePresent(&both) && typePresent(&logger) && typePresent(&shape) && typePresent(&slotOf(&deepSignature, usize.ZERO)) && typePresent(&slotOf(&absentSignature, usize.ZERO)) && typePresent(&slotOf(&conditionalSignature, usize.ZERO)) && typePresent(&slotOf(&serviceSignature, usize.ZERO)) && typePresent(&slotOf(&wrongSignature, usize.ZERO)) && typePresent(&slotOf(&firstSignature, usize.ZERO)) && typePresent(&slotOf(&reversedSignature, usize.ZERO)),
    "proof fixture resolves each goal and contract",
  )
  if let Option<Shared<Type>>.Some {value: contract} = move display {
    if let Option<Shared<Type>>.Some {value: provider} = move slotOf(&deepSignature, usize.ZERO) {
      let proof = run Semantic.proveConformance(&mut semantic, &mut request, &contract, &provider, Vector.asSlice<Constraint>(&none), &moduleId, Span.make(usize.ZERO, usize.ZERO))
      run Testing.expect(proofStepCount(&proof) == 3, "nested conditional proof reaches one concrete base")
    }
    if let Option<Shared<Type>>.Some {value: provider} = move slotOf(&absentSignature, usize.ZERO) {
      let proof = run Semantic.proveConformance(&mut semantic, &mut request, &contract, &provider, Vector.asSlice<Constraint>(&none), &moduleId, Span.make(usize.ZERO, usize.ZERO))
      run Testing.expect(proofFailsWith(&proof, RejectionCode.MissingConformance) && proofChainLength(&proof) == 3, "missing base reports the complete finite goal chain")
      let mut copied = Vector.make<Constraint>()
      run Vector.append<Constraint>(&mut copied, Constraint.Conforms {
        provider: Shared.clone<Type>(&provider),
        contract: Shared.clone<Type>(&contract),
      })
      let stillMissing = run Semantic.proveConformance(&mut semantic, &mut request, &contract, &provider, Vector.asSlice<Constraint>(&copied), &moduleId, Span.make(usize.ZERO, usize.ZERO))
      run Testing.expect(
        proofFailsWith(&stillMissing, RejectionCode.MissingConformance) && proofChainLength(&stillMissing) == 3,
        "a copied concrete bound is an obligation, not declared abstract evidence",
      )
    }
  }
  if let Option<Shared<Type>>.Some {value: contract} = move both {
    if let Option<Shared<Type>>.Some {value: provider} = move slotOf(&conditionalSignature, usize.ZERO) {
      let proof = run Semantic.proveConformance(&mut semantic, &mut request, &contract, &provider, Vector.asSlice<Constraint>(&none), &moduleId, Span.make(usize.ZERO, usize.ZERO))
      run Testing.expect(proofFailsWith(&proof, RejectionCode.MissingConformance) && proofChainLength(&proof) == 2, "a fulfilled first conjunct never admits an unproved second conjunct")
    }
    let leftBounds = run declaredOf(&firstSignature)
    let rightBounds = run declaredOf(&reversedSignature)
    if let Option<Shared<Type>>.Some {value: provider} = move slotOf(&firstSignature, usize.ZERO) {
      let proof = run Semantic.proveConformance(&mut semantic, &mut request, &contract, &provider, Vector.asSlice<Constraint>(&leftBounds), &moduleId, Span.make(usize.ZERO, usize.ZERO))
      run Testing.expect(proofStepCount(&proof) == 3 && proofDeclaredCount(&proof) == 2, "abstract conditional proof uses only declared A and B evidence")
    }
    if let Option<Shared<Type>>.Some {value: provider} = move slotOf(&reversedSignature, usize.ZERO) {
      let proof = run Semantic.proveConformance(&mut semantic, &mut request, &contract, &provider, Vector.asSlice<Constraint>(&rightBounds), &moduleId, Span.make(usize.ZERO, usize.ZERO))
      run Testing.expect(proofStepCount(&proof) == 3 && proofDeclaredCount(&proof) == 2, "permuting declared conjuncts preserves the proof")
    }
  }
  if let Option<Shared<Type>>.Some {value: contract} = move logger {
    if let Option<Shared<Type>>.Some {value: provider} = move slotOf(&serviceSignature, usize.ZERO) {
      let bodies = starts(Semantic.eventLog(&semantic), Family.Body)
      let proof = run Semantic.proveConformance(&mut semantic, &mut request, &contract, &provider, Vector.asSlice<Constraint>(&none), &moduleId, Span.make(usize.ZERO, usize.ZERO))
      let emptyRequirements = Shared.with<Result<Answer, NoRejection>, bool>(
        &serviceSignature,
        fn(answer: &Result<Answer, NoRejection>) -> bool {
          return rowCountIs(answer, usize.ZERO)
        },
      )
      run Testing.expect(
        proofStepCount(&proof) == usize.ONE && emptyRequirements && starts(Semantic.eventLog(&semantic), Family.Body) == bodies,
        "service conformance is static and adds no runtime requirement or body demand",
      )
    }
  }
  if let Option<Shared<Type>>.Some {value: contract} = move shape {
    if let Option<Shared<Type>>.Some {value: provider} = move slotOf(&wrongSignature, usize.ZERO) {
      let proof = run Semantic.proveConformance(&mut semantic, &mut request, &contract, &provider, Vector.asSlice<Constraint>(&none), &moduleId, Span.make(usize.ZERO, usize.ZERO))
      run Testing.expect(
        proofFailsWith(&proof, RejectionCode.IncompatibleWitness) && proofChainLength(&proof) == usize.ONE,
        "an incompatible operation cannot provisionally prove its conformance",
      )
    }
  }
  return ()
}

test effect fn conformanceWitnessesRespectDeclaredBounds() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run conformanceWitnessClaims()
    |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn conformanceWitnessClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator {
  let moduleId = run module("witnesses.silk")
  let text = """
interface Base {}
interface Lift {}
interface Apply { fn apply<T: Base>(value: Self, item: Box<T>) -> i32 }
interface ApplyMissing { fn apply<T>(value: Self, item: Box<T>) -> i32 }
struct Engine {}
interface SelfBound { fn check(value: Self, item: Engine) -> i32 }
struct Box<T> { value: T }
impl<T: Base> Lift for Box<T> {}
impl Apply for Engine { fn apply<U: Lift>(value: Self, item: U) -> i32 { return 0 } }
impl ApplyMissing for Engine { fn apply<U: Lift>(value: Self, item: U) -> i32 { return 0 } }
impl SelfBound for Engine { fn check<U: SelfBound>(value: Self, item: U) -> i32 { return 0 } }
"""
  let source = run present(text)
  let revision = run Revision.publish(&Revision.make(), &moduleId, &source)
  let mut semantic = makeSemantic(run Revision.copy(&revision))
  let mut index = SourceIndex.make(move revision)
  let mut request = Request.make()
  let impliedWitness = run witnessesOf(&mut semantic, &mut request, &mut index, &moduleId, 1)
  let unprovedWitness = run witnessesOf(&mut semantic, &mut request, &mut index, &moduleId, 2)
  let circularWitness = run witnessesOf(&mut semantic, &mut request, &mut index, &moduleId, 3)
  run Testing.expect(
    succeeded(&impliedWitness) && rejectsFrom(&unprovedWitness, RejectionCode.Unsupported, offsetOf(text, "fn apply<U: Lift>", 1)),
    "a substituted witness bound follows the operation's Base assumption through Lift, but missing Base never admits it",
  )
  run Testing.expect(
    rejectsFrom(&circularWitness, RejectionCode.Unsupported, offsetOf(text, "fn check<U: SelfBound>", 0)),
    "a witness cannot prove its own stronger bound by recursively selecting its conformance",
  )
  return ()
}

// Each set claim uses only the declarations whose coherence it tests.
fn coherenceSetsFixture(part: usize) -> string<'static> {
  if part == 2 {
    return "struct Box<T> {\n  value: T\n}\nstruct Settings {}\nservice Clock {}\nservice Logger {}\ninterface Absorb {}\nimpl<T> Absorb for Box<T | i32> {}\nimpl Absorb for Box<bool> {}\ninterface Contain {}\nimpl<T> Contain for Box<T | i32> {}\nimpl Contain for Box<i32 | bool> {}\ninterface Nested {}\nimpl<T> Nested for Box<Box<T> | i32> {}\nimpl Nested for Box<Box<u8> | i32> {}\ninterface RowKey<?R> {}\nimpl<?R> RowKey<? &Clock | R> for Settings {}\nimpl RowKey<? &Logger> for Settings {}\ninterface RowAccess<?R> {}\nimpl<?R> RowAccess<? &Clock | R> for Settings {}\nimpl RowAccess<? &mut Clock> for Settings {}\ninterface RowReverse<?R> {}\nimpl<?R> RowReverse<? &mut Clock | R> for Settings {}\nimpl RowReverse<? &Clock> for Settings {}\n"
  }
  if part == 3 {
    return "struct Box<T> {\n  value: T\n}\nstruct Settings {}\ninterface DuplicateUnion {}\nimpl<T> DuplicateUnion for Box<T | i32> {}\nimpl<U> DuplicateUnion for Box<U | i32> {}\ninterface DuplicateRow<?R> {}\nimpl<?R> DuplicateRow<? R> for Settings {}\nimpl<?S> DuplicateRow<? S> for Settings {}\ninterface PermutedUnion {}\nimpl<A, B> PermutedUnion for Box<A | B> {}\nimpl<X, Y> PermutedUnion for Box<Y | X> {}\nservice S<'a> {}\ninterface MixedAccess<?R> {}\nimpl<'b, 'c> MixedAccess<? &S<'b> | &mut S<'c>> for Settings {}\nimpl<'z, 'y> MixedAccess<? &mut S<'z> | &S<'y>> for Settings {}\n"
  }
  if part == 4 {
    return "struct Box<T> {\n  value: T\n}\nstruct Settings {}\nservice Clock {}\nservice Logger {}\nservice S<'a> {}\ninterface Collapse<?R> {}\nimpl<'a, 'b> Collapse<? &S<'a> | &mut S<'b>> for Settings {}\nimpl Collapse<? &mut S<'static>> for Settings {}\ninterface DistinctCount<?R> {}\nimpl DistinctCount<? &Clock> for Settings {}\nimpl DistinctCount<? &Clock | &Logger> for Settings {}\nservice Channel<T> {}\ninterface Parameterized<?R> {}\nimpl<T> Parameterized<? &Channel<T>> for Settings {}\nimpl Parameterized<? &Channel<i32>> for Settings {}\nstruct Pair<A, B> {}\ninterface SharedNested {}\nimpl<T> SharedNested for Box<Box<T> | Pair<T, T>> {}\nimpl SharedNested for Box<Box<u8> | Pair<u8, u8>> {}\ninterface SplitNested {}\nimpl<T> SplitNested for Box<Box<T> | Pair<T, T>> {}\nimpl SplitNested for Box<Box<u8> | Pair<u8, bool>> {}\ninterface KeyAccess<?R> {}\nimpl<T> KeyAccess<? &Channel<T>> for Settings {}\nimpl KeyAccess<? &mut Channel<i32>> for Settings {}\n"
  }
  return ""
}

effect fn coherenceClaims(part: usize) -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator {
  let local = run module("local.silk")
  let sets = run module("sets.silk")
  let shapes = run module("shapes.silk")
  let contracts = run module("contracts.silk")
  let model = run module("model.silk")
  let facade = run module("facade.silk")
  let unrelated = run module("unrelated.silk")
  let boundSet = run module("bound-set.silk")
  let localText = "struct Box<T> {\n  value: T\n}\nstruct Pair<A, B> {\n  first: A\n  second: B\n}\nstruct Settings {}\nstruct User {}\ninterface Left {}\ninterface Right {}\ninterface Show {}\ninterface Display {}\ninterface Bounded {}\nimpl<T: Left> Bounded for Box<T> {}\nimpl<T: Right> Bounded for Box<T> {}\ninterface Special {}\nimpl<T: Show> Special for Box<T> {}\nimpl Special for Box<i32> {}\ninterface Twice {}\nimpl Twice for User {}\nimpl Twice for User {}\ninterface Occurs {}\nimpl<T> Occurs for Pair<T, T> {}\nimpl<A> Occurs for Pair<A, Box<A>> {}\ninterface Free {}\nimpl<T> Free for User {}\ninterface Pick<T> {}\nimpl<T: Show> Pick<T> for Settings {}\ninterface Eq2<T> {}\nimpl<T: Eq2<Pair<T, T>>> Eq2<T> for Box<T> {}\ninterface Fixed<T> {}\nimpl<T: Fixed<bool>> Fixed<i32> for Box<T> {}\ninterface Convert<T> {}\nimpl Convert<i32> for Settings {}\nimpl Convert<bool> for Settings {}\nimpl<T: Display> Display for Box<T> {}\ninterface Width {}\nimpl Width for Box<i32> {}\nimpl Width for Box<u8> {}\ninterface Permuted {}\nimpl<A, B> Permuted for Pair<A, B> {}\nimpl<X, Y> Permuted for Pair<Y, X> {}\ninterface Consistent<T> {}\nimpl<A, B> Consistent<A> for Pair<A, B> {}\nimpl<X, Y> Consistent<Y> for Pair<X, Y> {}\n"
  let setsText = coherenceSetsFixture(part)
  let shapesText = "struct Box<T> {\n  value: T\n}\nstruct View<'a> {\n  value: &'a i32\n}\ninterface Lasting {}\nimpl Lasting for View<'static> {}\nimpl<'a> Lasting for View<'a> {}\ninterface Calls {}\nimpl Calls for Box<fn<'static>(&i32) -> &i32> {}\nimpl Calls for Box<for<'a, 'b> fn<'static>(&'a i32) -> &'b i32> {}\ninterface DuplicateCalls {}\nimpl DuplicateCalls for Box<for<'a> fn<'static>(&'a i32) -> &'a i32> {}\nimpl DuplicateCalls for Box<for<'b> fn<'static>(&'b i32) -> &'b i32> {}\ninterface BoundedLife {}\nimpl<'a: 'static> BoundedLife for View<'a> {}\nimpl<'b> BoundedLife for View<'b> {}\n"
  let contractsText = "import facade { User as Person }\nimport unrelated { Noise }\npub interface Marker {}\nimpl Marker for Person {}\nfn unused(value: Noise) -> i32 { return 0 }\n"
  let modelText = "import contracts { Marker }\npub struct User {}\nimpl Marker for User {}\n"
  let boundSetText = "struct Box<T> { value: T }\nfn left<'a>(value: Box<for<'b: 'a> fn<'static>(&'b i32) -> i32> | bool) -> i32 { return 0 }\nfn right<'c>(value: Box<for<'d: 'c> fn<'static>(&'d i32) -> i32> | bool) -> i32 { return 0 }\nfn retained<'a>(callback: for<'b: 'a> fn<'static>(&'b i32) -> i32) -> i32 { return 0 }\n"
  let localSource = run present(localText)
  let setsSource = run present(setsText)
  let shapesSource = run present(shapesText)
  let contractsSource = run present(contractsText)
  let modelSource = run present(modelText)
  let facadeSource = run present("pub import model { User }\n")
  let unrelatedSource = run present("pub struct Noise {}\n")
  let boundSetSource = run present(boundSetText)
  let r1 = run Revision.publish(&Revision.make(), &local, &localSource)
  let r2 = run Revision.publish(&r1, &sets, &setsSource)
  let r3 = run Revision.publish(&r2, &shapes, &shapesSource)
  let r4 = run Revision.publish(&r3, &contracts, &contractsSource)
  let r5 = run Revision.publish(&r4, &model, &modelSource)
  let r6 = run Revision.publish(&r5, &facade, &facadeSource)
  let r7 = run Revision.publish(&r6, &unrelated, &unrelatedSource)
  let revision = run Revision.publish(&r7, &boundSet, &boundSetSource)
  let mut semantic = makeSemantic(run Revision.copy(&revision))
  let mut request = Request.make()
  let mut index = SourceIndex.make(run Revision.copy(&revision))

  if part == 0 {
    // IMPL-007: bounds never make heads distinct, and neither head of a conflict is admitted.
    let bounded = run pairConflicts(
      &mut semantic,
      &mut request,
      &mut index,
      &local,
      usize.ZERO,
      usize.ONE,
      RejectionCode.OverlappingConformance,
      offsetOf(localText, "impl<T: Right>", 0),
    )
    run Testing.expect(bounded, "heads that differ only in bounds overlap, and both report the later head")
    let special = run pairConflicts(
      &mut semantic,
      &mut request,
      &mut index,
      &local,
      2,
      3,
      RejectionCode.OverlappingConformance,
      offsetOf(localText, "impl Special for Box<i32>", 0),
    )
    run Testing.expect(special, "a concrete head overlapping a generic one is not ranked above it")
    let twice = run pairConflicts(
      &mut semantic,
      &mut request,
      &mut index,
      &local,
      4,
      5,
      RejectionCode.DuplicateConformance,
      offsetOf(localText, "impl Twice for User", 1),
    )
    run Testing.expect(twice, "two unbounded identical heads are duplicates")
    let occurs = run pairCoherent(&mut semantic, &mut request, &mut index, &local, 6, 7)
    run Testing.expect(occurs, "heads that could only agree on an infinite type are distinct")
    let free = run coherenceOf(&mut semantic, &mut request, &mut index, &local, 8)
    run Testing.expect(
      rejectsFrom(&free, RejectionCode.UnconstrainedImplParameter, offsetOf(localText, "T> Free", 0)),
      "a parameter absent from the head is rejected at its binder",
    )
    let peer = run coherenceOf(&mut semantic, &mut request, &mut index, &local, 9)
    let duplicated = run coherenceOf(&mut semantic, &mut request, &mut index, &local, 10)
    let fixed = run coherenceOf(&mut semantic, &mut request, &mut index, &local, 11)
    run Testing.expect(
      terminatesAt(&peer, TerminationStep.Peer, offsetOf(localText, "Show> Pick", 0)) && terminatesAt(
        &duplicated,
        TerminationStep.DuplicatedParameter,
        offsetOf(localText, "Eq2<Pair<T, T>>", 0),
      ) && terminatesAt(&fixed, TerminationStep.ChangedFixedArgument, offsetOf(localText, "Fixed<bool>>", 0)),
      "peer, duplicating and fixed-argument-rewriting bounds are rejected at the bound",
    )
  }
  if part == 1 {
    let converts = run pairCoherent(&mut semantic, &mut request, &mut index, &local, 12, 13)
    let display = run coherenceOf(&mut semantic, &mut request, &mut index, &local, 14)
    let widths = run pairCoherent(&mut semantic, &mut request, &mut index, &local, 15, 16)
    run Testing.expect(
      converts && coherent(&display) && widths,
      "distinct interface applications, a descending bound and distinct providers are coherent",
    )

    let permuted = run pairConflicts(
      &mut semantic, &mut request, &mut index, &local, 17, 18,
      RejectionCode.DuplicateConformance,
      offsetOf(localText, "impl<X, Y> Permuted", 0),
    )
    let inconsistent = run pairConflicts(
      &mut semantic, &mut request, &mut index, &local, 19, 20,
      RejectionCode.OverlappingConformance,
      offsetOf(localText, "impl<X, Y> Consistent", 0),
    )
    run Testing.expect(permuted && inconsistent, "alpha maps permute binders and must agree across contract and provider")

    let localHeads = run Semantic.demandImplementations(&mut semantic, &mut request, &local)
    let consistentLeft = headAt(&localHeads, 19)
    let consistentRight = headAt(&localHeads, 20)
    let leftContract = contractOf(&consistentLeft)
    let rightContract = contractOf(&consistentRight)
    let sharedProvider = providerOf(&consistentLeft)
    let mut aliasedMapControl = false
    if let Option<Shared<Type>>.Some {value: fromContract} = move leftContract {
      if let Option<Shared<Type>>.Some {value: toContract} = move rightContract {
        if let Option<Shared<Type>>.Some {value: provider} = move sharedProvider {
          let swapped = run Type.alphaEquivalent(&fromContract, &provider, &toContract, &provider, 2)
          aliasedMapControl = !swapped
        }
      }
    }
    run Testing.expect(aliasedMapControl, "an aliased provider still rejects a nonidentity binder map")

  }
  if part == 2 {
    // Sets decide only their containment fragment; access in a row can strengthen, never weaken.
    let absorbed = run pairCoherent(&mut semantic, &mut request, &mut index, &sets, usize.ZERO, usize.ONE)
    let contained = run pairConflicts(
      &mut semantic,
      &mut request,
      &mut index,
      &sets,
      2,
      3,
      RejectionCode.OverlappingConformance,
      offsetOf(setsText, "impl Contain for Box<i32 | bool>", 0),
    )
    run Testing.expect(absorbed, "an open union does not overlap a set missing its fixed member")
    run Testing.expect(contained, "an open union overlaps a set containing its fixed members")
    let nested = run pairConflicts(
      &mut semantic,
      &mut request,
      &mut index,
      &sets,
      4,
      5,
      RejectionCode.OverlappingConformance,
      offsetOf(setsText, "impl Nested for Box<Box<u8> | i32>", 0),
    )
    run Testing.expect(
      nested,
      "a union member nested under a nominal parameter overlaps its concrete application",
    )
    let keyed = run pairCoherent(&mut semantic, &mut request, &mut index, &sets, 6, 7)
    let strengthened = run pairConflicts(
      &mut semantic,
      &mut request,
      &mut index,
      &sets,
      8,
      9,
      RejectionCode.OverlappingConformance,
      offsetOf(setsText, "impl RowAccess<? &mut Clock>", 0),
    )
    let weakened = run pairCoherent(&mut semantic, &mut request, &mut index, &sets, 10, 11)
    run Testing.expect(
      keyed && strengthened && weakened,
      "an open row covers a closed row only with its keys at no weaker access",
    )

  }
  if part == 3 {
    let duplicateUnion = run pairConflicts(
      &mut semantic, &mut request, &mut index, &sets, 0, 1,
      RejectionCode.DuplicateConformance,
      offsetOf(setsText, "impl<U> DuplicateUnion", 0),
    )
    let duplicateRow = run pairConflicts(
      &mut semantic, &mut request, &mut index, &sets, 2, 3,
      RejectionCode.DuplicateConformance,
      offsetOf(setsText, "impl<?S> DuplicateRow", 0),
    )
    let permutedUnion = run pairConflicts(
      &mut semantic, &mut request, &mut index, &sets, 4, 5,
      RejectionCode.DuplicateConformance,
      offsetOf(setsText, "impl<X, Y> PermutedUnion", 0),
    )
    run Testing.expect(duplicateUnion && duplicateRow && permutedUnion, "alpha-identical open unions and rows are duplicates under binder permutation")
    let mixedAccess = run pairConflicts(
      &mut semantic, &mut request, &mut index, &sets, 6, 7,
      RejectionCode.DuplicateConformance,
      offsetOf(setsText, "impl<'z, 'y> MixedAccess", 0),
    )
    run Testing.expect(mixedAccess, "reordered row keys choose a candidate with matching access in both directions")
  }
  if part == 4 {
    let collapsed = run pairConflicts(
      &mut semantic,
      &mut request,
      &mut index,
      &sets,
      0,
      1,
      RejectionCode.OverlappingConformance,
      offsetOf(setsText, "impl Collapse<? &mut S<'static>>", 0),
    )
    run Testing.expect(
      collapsed,
      "projected lifetime keys collapse to the strongest closed-row access before coherence",
    )
    let distinctCount = run pairCoherent(&mut semantic, &mut request, &mut index, &sets, 2, 3)
    run Testing.expect(distinctCount, "closed rows with different keys and no projected collision remain distinct")
    let parameterized = run pairConflicts(
      &mut semantic,
      &mut request,
      &mut index,
      &sets,
      4,
      5,
      RejectionCode.OverlappingConformance,
      offsetOf(setsText, "impl Parameterized<? &Channel<i32>>", 0),
    )
    run Testing.expect(parameterized, "parameterized row keys share exact evidence across a coherent pairing")
    let repeatedNested = run pairConflicts(
      &mut semantic,
      &mut request,
      &mut index,
      &sets,
      6,
      7,
      RejectionCode.OverlappingConformance,
      offsetOf(setsText, "impl SharedNested for Box<Box<u8>", 0),
    )
    let splitNested = run pairCoherent(&mut semantic, &mut request, &mut index, &sets, 8, 9)
    run Testing.expect(
      repeatedNested && splitNested,
      "repeated variables inside set members share one assignment and reject contradictory evidence",
    )
    let keyAccess = run pairCoherent(&mut semantic, &mut request, &mut index, &sets, 10, 11)
    run Testing.expect(keyAccess, "a parameterized closed-row key cannot strengthen fixed shared access")

  }
  if part == 5 {
    // Coherence compares heads with lifetimes erased; their exact identities stay distinct.
    let lasting = run pairConflicts(
      &mut semantic,
      &mut request,
      &mut index,
      &shapes,
      usize.ZERO,
      usize.ONE,
      RejectionCode.OverlappingConformance,
      offsetOf(shapesText, "impl<'a> Lasting", 0),
    )
    let calls = run pairConflicts(
      &mut semantic,
      &mut request,
      &mut index,
      &shapes,
      2,
      3,
      RejectionCode.OverlappingConformance,
      offsetOf(shapesText, "impl Calls for Box<for", 0),
    )
    let duplicateCalls = run pairConflicts(
      &mut semantic, &mut request, &mut index, &shapes, 4, 5,
      RejectionCode.DuplicateConformance,
      offsetOf(shapesText, "impl DuplicateCalls for Box<for<'b>", 0),
    )
    let boundedLife = run pairConflicts(
      &mut semantic, &mut request, &mut index, &shapes, 6, 7,
      RejectionCode.OverlappingConformance,
      offsetOf(shapesText, "impl<'b> BoundedLife", 0),
    )
    run Testing.expect(duplicateCalls && boundedLife, "quantified callable identity is exact, and outlives bounds prevent duplicate classification")
    let heads = run Semantic.demandImplementations(&mut semantic, &mut request, &shapes)
    let elided = providerOf(&headAt(&heads, 2))
    let quantified = providerOf(&headAt(&heads, 3))
    let mut exactDistinct = false
    if let Option<Shared<Type>>.Some {value: left} = &elided {
      if let Option<Shared<Type>>.Some {value: right} = &quantified {
        exactDistinct = !run Type.equalsShared(&left, &right)
      }
    }
    run Testing.expect(
      lasting && calls && exactDistinct,
      "heads differing only in lifetimes or invocation binders overlap without becoming duplicates",
    )

  }
  if part == 6 {
    let leftSignature = run Semantic.demandSignature(&mut semantic, &mut request, &boundSet, b"left")
    let rightSignature = run Semantic.demandSignature(&mut semantic, &mut request, &boundSet, b"right")
    let leftParameter = slotOf(&leftSignature, usize.ZERO)
    let rightParameter = slotOf(&rightSignature, usize.ZERO)
    let mut boundSetUndetermined = false
    if let Option<Shared<Type>>.Some {value: first} = move leftParameter {
      if let Option<Shared<Type>>.Some {value: second} = move rightParameter {
        let leftOwner = run requireIndexedIdentity(&mut index, &boundSet, OwnerKind.Function, b"left", usize.ZERO)
        let rightOwner = run requireIndexedIdentity(&mut index, &boundSet, OwnerKind.Function, b"right", usize.ZERO)
        let mut variables = Vector.make<Shared<DeclarationId>>()
        run Vector.append<Shared<DeclarationId>>(&mut variables, run Shared.make<DeclarationId>(move leftOwner))
        run Vector.append<Shared<DeclarationId>>(&mut variables, run Shared.make<DeclarationId>(move rightOwner))
        let mut bindings = Vector.make<Binding>()
        let result = run Type.unify(
          &first, &second, Vector.asSlice<Shared<DeclarationId>>(&variables), Comparison.Exact, &mut bindings,
        )
        boundSetUndetermined = match & result {
          Unification.Undetermined {..} => Vector.length<Binding>(&bindings) == usize.ZERO
          _ => false
        }
      }
    }
    run Testing.expect(boundSetUndetermined, "an outer lifetime used by a quantified set member's bound is undecided in exact matching")
    let retainedSignature = run Semantic.demandSignature(&mut semantic, &mut request, &boundSet, b"retained")
    let retainedParameter = contractSlotOf(&retainedSignature, usize.ZERO)
    let mut staticCapture = false
    if let Option<Shared<Type>>.Some {value: callable} = move retainedParameter {
      let owner = run requireIndexedIdentity(&mut index, &boundSet, OwnerKind.Function, b"retained", usize.ZERO)
      let representations = Vector.make<Option<Shared<Type>>>()
      let mut regions = Vector.make<Shared<Lifetime>>()
      let known = run Type.retainedRegions(
        &callable, &owner, Vector.asSlice<Option<Shared<Type>>>(&representations), &mut regions,
      )
      staticCapture = known && Vector.length<Shared<Lifetime>>(&regions) == usize.ZERO
    }
    run Testing.expect(staticCapture, "a static callable environment retains none of its invocation-bound lifetimes")

  }
  if part == 7 {
    // D09: the interface's and the provider's modules form one bucket, through a facade alias, and
    // the pair reports the canonically later module's head whatever the demand order.
    let modelImpl = run requireIndexedIdentity(&mut index, &model, OwnerKind.Implementation, b"", usize.ZERO)
    let contractsImpl = run requireIndexedIdentity(&mut index, &contracts, OwnerKind.Implementation, b"", usize.ZERO)
    let modelStart = offsetOf(modelText, "impl Marker for User", 0)
    let viaContracts = run Semantic.demandCoherence(&mut semantic, &mut request, &contractsImpl)
    let viaModel = run Semantic.demandCoherence(&mut semantic, &mut request, &modelImpl)
    let coldStarts = starts(Semantic.eventLog(&semantic), Family.Coherence)
    let again = run Semantic.demandCoherence(&mut semantic, &mut request, &contractsImpl)
    let warm = starts(Semantic.eventLog(&semantic), Family.Coherence) == coldStarts && hits(
      Semantic.eventLog(&semantic),
      Family.Coherence,
    ) > usize.ZERO
    run Testing.expect(
      conflictIs(&viaContracts, RejectionCode.DuplicateConformance, &model, modelStart, &modelImpl, &contractsImpl) && conflictIs(
        &viaModel,
        RejectionCode.DuplicateConformance,
        &model,
        modelStart,
        &modelImpl,
        &contractsImpl,
      ) && conflictIs(&again, RejectionCode.DuplicateConformance, &model, modelStart, &modelImpl, &contractsImpl) && warm,
      "owner modules of both endpoints conflict through a facade, reported alike cold and warm",
    )
    run Testing.expect(
      reads(Semantic.sourceEvents(&semantic), &unrelated) == usize.ZERO,
      "coherence reads no body-only import of an owner module",
    )
    let mut reversed = makeSemantic(run Revision.copy(&revision))
    let mut reversedRequest = Request.make()
    let modelFirst = run Semantic.demandCoherence(&mut reversed, &mut reversedRequest, &modelImpl)
    let contractsSecond = run Semantic.demandCoherence(&mut reversed, &mut reversedRequest, &contractsImpl)
    run Testing.expect(
      conflictIs(&modelFirst, RejectionCode.DuplicateConformance, &model, modelStart, &modelImpl, &contractsImpl) && conflictIs(
        &contractsSecond,
        RejectionCode.DuplicateConformance,
        &model,
        modelStart,
        &modelImpl,
        &contractsImpl,
      ),
      "the reversed demand order in a fresh store reports the same pair",
    )
  }
  return ()
}

test effect fn inherentHeadsMembersAndRefinements() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run inherentClaims(0)
    |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn inherentMemberBindersAndCollisions() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run inherentClaims(1)
    |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn inherentRequirementRows() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run inherentClaims(2)
    |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn inherentDeferredHeadDefersMembers() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let cells = run module("cells.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = "pub struct Cell<T> {\n  core: Intrinsic.Execution<T>\n}\nimpl<T> Cell<T> {\n  pub fn mark() -> i32 { return 0 }\n}\npub struct Plain {}\nimpl Plain {\n  pub fn kept() -> i32 { return 0 }\n}\nfn missing() -> i32 { return Plain.absent() }\n"
  let source = run present(text) |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&Revision.make(), &cells, &source) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut semantic = makeSemantic(move revision)
  let mut request = Request.make()
  let cell = run Semantic.demandInherentMembers(&mut semantic, &mut request, &cells, b"Cell")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsSpan(&cell, RejectionCode.CoreTypeUnavailable, text, "Intrinsic.Execution<T>", 0),
    "a deferred head defers the owner's members instead of publishing none")
  let plain = run Semantic.demandInherentMembers(&mut semantic, &mut request, &cells, b"Plain")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let plainPublished = Shared.with<Result<Answer, NoRejection>, usize>(&plain,
    fn(answer: &Result<Answer, NoRejection>) -> usize { return inherentCount(answer, true) })
  run Testing.expect(plainPublished == usize.ONE, "a sibling owner's deferred head leaves this owner's members published")
  let missing = run Semantic.demandBody(&mut semantic, &mut request, &cells, b"missing")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsSpan(&missing, RejectionCode.UnknownMember, text, "absent", 0),
    "an absent member of a sibling owner stays UnknownMember")
  return ()
}

effect fn inherentClaims(part: usize) -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator {
  let owners = run module("owners.silk")
  let external = run module("external.silk")
  let text = "import external { Foreign }\nstruct Counter {\n  count: i32\n}\nstruct Pair<A, B> {}\ntype Alias = Counter\nenum Status { Ready }\nimpl Counter {\n  fn value(counter: &Self) -> i32 { return 0 }\n  fn count(counter: &Self) -> i32 { return 0 }\n}\nimpl Counter {\n  fn value(other: &Self) -> i32 { return 1 }\n  fn reset() -> Self { return () }\n  measure: Counter.reset\n  fn drop(counter: &mut Self) -> () { return () }\n}\nimpl<A, B> Pair<A, B> {\n  fn first<A: Copy>(pair: &Self, value: A) -> A { return move value }\n  fn left(value: A) -> A { return move value }\n  fn plain() -> i32 { return 0 }\n}\nimpl Pair<i32, bool> {\n  fn special() -> i32 { return 0 }\n}\nimpl<A, B> Pair<B, A> {\n  fn swapped() -> i32 { return 0 }\n}\nimpl<A: Copy, B> Pair<A, B> {\n  fn bounded() -> Self { return () }\n}\nimpl Alias {\n  fn aliased() -> i32 { return 0 }\n}\nimpl Foreign {\n  fn mine() -> i32 { return 0 }\n}\nimpl Status {\n  fn value() -> i32 { return 0 }\n}\nstruct Twice {}\nimpl Twice {\n  fn same() -> i32 { return 0 }\n  fn same() -> bool { return true }\n}\nstruct Rowed<?R> {}\nimpl<?R> Rowed<? R> {\n  fn rowed() -> i32 { return 0 }\n  fn clash<R>() -> i32 { return 0 }\n}\nstruct Held<'a> {\n  value: &'a i32\n}\nimpl<'a> Held<'a> {\n  effect<'a> fn retained() -> i32 { return 0 }\n}\nimpl Copy for Status {}\nservice Clock {}\nrole Primary\nstruct Routed<?H> {}\nimpl<?H> Routed<H> {\n  fn routed() -> i32 { return 0 }\n}\nfn served(value: Routed<&Clock at Primary>) -> i32 { return 0 }\nfn mismatched(value: Routed<i32>) -> i32 { return 0 }\nfn extra(value: Routed<&Clock ? &Clock>) -> i32 { return 0 }\nstatic if true {\n  fn conditional<T>(value: T) -> T { return move value }\n}\n"
  let ownersSource = run present(text)
  let externalSource = run present("pub struct Foreign {}\n")
  let first = run Revision.publish(&Revision.make(), &owners, &ownersSource)
  let revision = run Revision.publish(&first, &external, &externalSource)
  let mut semantic = makeSemantic(run Revision.copy(&revision))
  let mut index = SourceIndex.make(run Revision.copy(&revision))
  let mut request = Request.make()
  if part == 0 {
    let counter = run Semantic.demandInherentMembers(&mut semantic, &mut request, &owners, b"Counter")
    let counterPublished = Shared.with<Result<Answer, NoRejection>, usize>(
      &counter,
      fn(answer: &Result<Answer, NoRejection>) -> usize {
        return inherentCount(answer, true)
      },
    )
    let counterRejected = Shared.with<Result<Answer, NoRejection>, usize>(
      &counter,
      fn(answer: &Result<Answer, NoRejection>) -> usize {
        return inherentCount(answer, false)
      },
    )
    run Testing.expect(
      counterPublished == usize.ONE && counterRejected == 5,
      "duplicates, field collisions, mappings and Drop hooks publish nothing and choose no winner",
    )
    let pair = run Semantic.demandInherentMembers(&mut semantic, &mut request, &owners, b"Pair")
    let status = run Semantic.demandInherentMembers(&mut semantic, &mut request, &owners, b"Status")
    let pairPublished = Shared.with<Result<Answer, NoRejection>, usize>(
      &pair,
      fn(answer: &Result<Answer, NoRejection>) -> usize {
        return inherentCount(answer, true)
      },
    )
    let statusRejected = Shared.with<Result<Answer, NoRejection>, usize>(
      &status,
      fn(answer: &Result<Answer, NoRejection>) -> usize {
        return inherentCount(answer, false)
      },
    )
    run Testing.expect(
      pairPublished == 3 && statusRejected == usize.ONE,
      "rejected heads publish no member and a generated enum operation keeps its name",
    )
    let special = run signatureNamed(&mut semantic, &mut request, &mut index, &owners, b"special", 0)
    let swapped = run signatureNamed(&mut semantic, &mut request, &mut index, &owners, b"swapped", 0)
    let bounded = run signatureNamed(&mut semantic, &mut request, &mut index, &owners, b"bounded", 0)
    let aliased = run signatureNamed(&mut semantic, &mut request, &mut index, &owners, b"aliased", 0)
    let foreign = run signatureNamed(&mut semantic, &mut request, &mut index, &owners, b"mine", 0)
    let specialAt = rejectsFrom(&special, RejectionCode.InvalidInherentHead, offsetOf(text, "Pair<i32", 0))
    let swappedAt = rejectsFrom(&swapped, RejectionCode.InvalidInherentHead, offsetOf(text, "Pair<B, A>", 0))
    let boundedAt = rejectsFrom(
      &bounded,
      RejectionCode.InvalidInherentHead,
      offsetOf(text, "Pair<A, B> {\n  fn bounded", 0),
    )
    let aliasedAt = rejectsFrom(&aliased, RejectionCode.InvalidInherentHead, offsetOf(text, "Alias {", 0))
    let foreignAt = rejectsFrom(&foreign, RejectionCode.InvalidInherentHead, offsetOf(text, "Foreign {", 0))
    run Testing.expect(
      specialAt && swappedAt && boundedAt && aliasedAt && foreignAt,
      "specialized, reordered, bounded, alias and foreign inherent heads report only the head",
    )
  }
  if part == 1 {
    let refined = run signatureNamed(&mut semantic, &mut request, &mut index, &owners, b"first", 0)
    // `first` names `Self`, so its contract lists both owner binders and adds no binder of its own.
    let ownerPrefix = Shared.with<Result<Answer, NoRejection>, usize>(&refined, ownBinderCount) == 2
    let refinedBound = Shared.with<Result<Answer, NoRejection>, bool>(&refined, copyBoundOnly)
    run Testing.expect(
      ownerPrefix && refinedBound,
      "an inherent member restating an owner binder bounds the owner's parameter for itself",
    )
    let left = run Semantic.demandInherentMember(&mut semantic, &mut request, &owners, b"Pair", b"left")
    let plain = run Semantic.demandInherentMember(&mut semantic, &mut request, &owners, b"Pair", b"plain")
    let leftPrefix = Shared.with<Result<Answer, NoRejection>, usize>(&left, ownBinderCount) == usize.ONE
    let plainPrefix = Shared.with<Result<Answer, NoRejection>, usize>(&plain, ownBinderCount) == usize.ZERO
    run Testing.expect(
      leftPrefix && plainPrefix,
      "a member's contract lists only the owner binders it mentions",
    )
    let duplicated = run Semantic.demandInherentMember(&mut semantic, &mut request, &owners, b"Counter", b"value")
    let claimed = run Semantic.demandInherentMember(&mut semantic, &mut request, &owners, b"Counter", b"count")
    let reset = run Semantic.demandInherentMember(&mut semantic, &mut request, &owners, b"Counter", b"reset")
    let absent = run Semantic.demandInherentMember(&mut semantic, &mut request, &owners, b"Counter", b"absent")
    let twice = run signatureNamed(&mut semantic, &mut request, &mut index, &owners, b"same", 0)
    let twiceAgain = run signatureNamed(&mut semantic, &mut request, &mut index, &owners, b"same", 1)
    let duplicatedAt = rejectsAt(&duplicated, RejectionCode.Collision)
    let claimedAt = rejectsAt(&claimed, RejectionCode.InvalidInherentMember)
    let resetView = Shared.with<Result<Answer, NoRejection>, AnswerView>(&reset, inspect)
    let absentAt = rejectsAt(&absent, RejectionCode.UnknownMember)
    let twiceAt = rejectsFrom(&twice, RejectionCode.Collision, offsetOf(text, "fn same() -> bool", 0)) && rejectsFrom(
      &twiceAgain,
      RejectionCode.Collision,
      offsetOf(text, "fn same() -> bool", 0),
    )
    run Testing.expect(
      duplicatedAt && claimedAt && resetView.success && absentAt && twiceAt,
      "member lookups return the kept rejection for duplicates and claimed names and never a winner",
    )
    let signatureStarts = starts(Semantic.eventLog(&semantic), Family.Signature)
    let leftById = run signatureNamed(&mut semantic, &mut request, &mut index, &owners, b"left", 0)
    let valueAgain = run signatureNamed(&mut semantic, &mut request, &mut index, &owners, b"value", 1)
    let sameLeft = run resultEquals(&left, &leftById)
    let noRestart = starts(Semantic.eventLog(&semantic), Family.Signature) == signatureStarts
    run Testing.expect(
      sameLeft && noRestart && rejectsAt(&valueAgain, RejectionCode.Collision),
      "an identity-addressed member shares the name lookup's answer, and each duplicate identity rejects",
    )
    let conditional = run signatureNamed(&mut semantic, &mut request, &mut index, &owners, b"conditional", 0)
    run Testing.expect(
      Shared.with<Result<Answer, NoRejection>, bool>(&conditional, signatureHasOrdinaryBinder),
      "a function in a static conditional sees no enclosing binders or `Self`",
    )
    let firstValue = run signatureNamed(&mut semantic, &mut request, &mut index, &owners, b"value", 0)
    let firstCount = run signatureNamed(&mut semantic, &mut request, &mut index, &owners, b"count", 0)
    let crossDuplicate = rejectsAt(&firstValue, RejectionCode.Collision)
    let fieldClaimed = rejectsAt(&firstCount, RejectionCode.InvalidInherentMember)
    run Testing.expect(
      crossDuplicate && fieldClaimed,
      "an impl-addressed inherent member obeys owner-wide uniqueness across impl blocks",
    )
  }
  if part == 2 {
    let rowed = run signatureNamed(&mut semantic, &mut request, &mut index, &owners, b"rowed", 0)
    let clash = run signatureNamed(&mut semantic, &mut request, &mut index, &owners, b"clash", 0)
    let retained = run Semantic.demandInherentMember(&mut semantic, &mut request, &owners, b"Held", b"retained")
    let rowedView = Shared.with<Result<Answer, NoRejection>, AnswerView>(&rowed, inspect)
    let clashAt = rejectsFrom(&clash, RejectionCode.DuplicateTypeParameter, offsetOf(text, "clash<R>", 0) + 6)
    let environmentOwner = Shared.with<Result<Answer, NoRejection>, usize>(&retained, lifetimeCountOf) == usize.ONE
    run Testing.expect(
      rowedView.success && clashAt && environmentOwner,
      "row owner binders form a whole family, a restated binder of another kind rejects, and a written environment names owner lifetimes",
    )
    let sealedHeads = run Semantic.demandImplementations(&mut semantic, &mut request, &owners)
    let sealedEnum = rejectsFrom(
      &sealedHeads,
      RejectionCode.InvalidCopyConformance,
      offsetOf(text, "impl Copy for Status", 0),
    )
    run Testing.expect(sealedEnum, "a scalar enum cannot request Copy by implementation")
    let routed = run signatureNamed(&mut semantic, &mut request, &mut index, &owners, b"routed", 0)
    let served = run Semantic.demandSignature(&mut semantic, &mut request, &owners, b"served")
    let mismatched = run Semantic.demandSignature(&mut semantic, &mut request, &owners, b"mismatched")
    let routedView = Shared.with<Result<Answer, NoRejection>, AnswerView>(&routed, inspect)
    let servedView = Shared.with<Result<Answer, NoRejection>, AnswerView>(&served, inspect)
    let mismatchedKind = rejectsFrom(&mismatched, RejectionCode.TypeArgumentKind, offsetOf(text, "i32>) -> i32", 0))
    let extra = run Semantic.demandSignature(&mut semantic, &mut request, &owners, b"extra")
    let extraSuffix = rejectsAt(&extra, RejectionCode.TypeArity)
    run Testing.expect(
      routedView.success && servedView.success && mismatchedKind && extraSuffix,
      "a requirement row binder takes a positional or suffixed row argument, and a value type there is a kind error",
    )
  }
  return ()
}

test effect fn importBindingsPreludeAndDemandOrder() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run bindingClaims()
    |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn bindingClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator {
  let entry = run module("bindings.silk")
  let lib = run module("lib.silk")
  let other = run module("other.silk")
  let clashing = run module("clashing.silk")
  let entryText = "import lib { Item }\nimport lib { Item }\nimport lib as lib\nimport lib\nfn twice(value: Item) -> i32 { return 0 }\nfn qualified(value: lib.Item) -> i32 { return 0 }\nfn prelude(value: Option<i32>) -> i32 { return 0 }\neffect fn fails<E>() -> i32 ! E { return 0 }\nfn marked<!E>() -> i32 { return 0 }\n"
  let clashingText = "import lib { Item }\nimport other { Item }\nfn clash(value: Item) -> i32 { return 0 }\n"
  let entrySource = run present(entryText)
  let libSource = run present("pub struct Item {}\n")
  let otherSource = run present("pub struct Item {}\n")
  let clashingSource = run present(clashingText)
  let r1 = run Revision.publish(&Revision.make(), &lib, &libSource)
  let r2 = run Revision.publish(&r1, &other, &otherSource)
  let r3 = run Revision.publish(&r2, &clashing, &clashingSource)
  let revision = run Revision.publish(&r3, &entry, &entrySource)
  let mut semantic = makeSemantic(run Revision.copy(&revision))
  let mut request = Request.make()
  let twice = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"twice")
  let qualified = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"qualified")
  let clash = run Semantic.demandSignature(&mut semantic, &mut request, &clashing, b"clash")
  let twiceView = Shared.with<Result<Answer, NoRejection>, AnswerView>(&twice, inspect)
  let qualifiedView = Shared.with<Result<Answer, NoRejection>, AnswerView>(&qualified, inspect)
  let sameItem = run answersEqual(&twice, &qualified, usize.ZERO)
  let stillClashes = rejectsAt(&clash, RejectionCode.Collision)
  run Testing.expect(
    twiceView.success && qualifiedView.success && sameItem && stillClashes,
    "a repeated identical import and a redundant alias are one binding; different imports still collide",
  )
  let prelude = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"prelude")
  let fails = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"fails")
  let marked = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"marked")
  let noPrelude = rejectsFrom(&prelude, RejectionCode.UnknownName, offsetOf(entryText, "Option<i32>", 0))
  let failsView = Shared.with<Result<Answer, NoRejection>, AnswerView>(&fails, inspect)
  let markedView = Shared.with<Result<Answer, NoRejection>, AnswerView>(&marked, inspect)
  run Testing.expect(
    noPrelude && failsView.success && !markedView.success,
    "no library name is implicit, and an ordinary failure parameter needs no `!E` binder",
  )
  let mut reversed = makeSemantic(move revision)
  let mut reversedRequest = Request.make()
  let clashFirst = run Semantic.demandSignature(&mut reversed, &mut reversedRequest, &clashing, b"clash")
  let qualifiedFirst = run Semantic.demandSignature(&mut reversed, &mut reversedRequest, &entry, b"qualified")
  let twiceLast = run Semantic.demandSignature(&mut reversed, &mut reversedRequest, &entry, b"twice")
  let reversedClash = rejectsAt(&clashFirst, RejectionCode.Collision)
  let reversedSame = run answersEqual(&twiceLast, &qualifiedFirst, usize.ZERO)
  let reversedTwice = run answersEqual(&twiceLast, &twice, usize.ZERO)
  run Testing.expect(
    reversedClash && reversedSame && reversedTwice,
    "binding answers do not depend on demand order",
  )
  return ()
}

test effect fn requestApplicationImportKeepsSelectionsSeparate() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run applicationImportClaims()
    |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn applicationImportClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator {
  let entry = run module("application-client.silk")
  let idle = run module("application-idle.silk")
  let namespace = run module("application-namespace.silk")
  let coherence = run module("application-coherence.silk")
  let operations = run module("application-operations.silk")
  let first = run module("runtime-first.silk")
  let second = run module("runtime-second.silk")
  let private = run module("runtime-private.silk")
  let entryText = "import Intrinsic.application { Item }\nfn consume(value: Item) -> i32 { return 0 }\n"
  let entrySource = run present(entryText)
  let idleSource = run present(
    "import Intrinsic.application { Item }\nfn idle(value: i32) -> i32 { return value }\n",
  )
  let namespaceSource = run present(
    "import Intrinsic.application\nfn consume(value: application.Item) -> i32 { return 0 }\n",
  )
  let coherenceText = "import Intrinsic.application { Item }\ninterface Label {}\nimpl Label for Item {}\n"
  let coherenceSource = run present(coherenceText)
  let operationsText = "import Intrinsic.application { Item }\ninterface Label { fn select(value: Self) -> Item }\nstruct Local {}\nimpl Label for Local {}\n"
  let operationsSource = run present(operationsText)
  let firstSource = run present("pub struct Item {}\n")
  let secondSource = run present("pub struct Item {}\n")
  let privateSource = run present("struct Item {}\n")
  let r1 = run Revision.publish(&Revision.make(), &first, &firstSource)
  let r2 = run Revision.publish(&r1, &second, &secondSource)
  let r3 = run Revision.publish(&r2, &private, &privateSource)
  let r4 = run Revision.publish(&r3, &idle, &idleSource)
  let r5 = run Revision.publish(&r4, &namespace, &namespaceSource)
  let r6 = run Revision.publish(&r5, &coherence, &coherenceSource)
  let r7 = run Revision.publish(&r6, &entry, &entrySource)
  let revision = run Revision.publish(&r7, &operations, &operationsSource)
  let mut semantic = makeSemantic(run Revision.copy(&revision))
  let mut firstRequest = Request.forApplication(run ModuleId.copy(&first))
  let mut secondRequest = Request.forApplication(run ModuleId.copy(&second))
  let mut absentRequest = Request.make()
  let firstUse = run Semantic.demandSignature(&mut semantic, &mut firstRequest, &entry, b"consume")
  let namespaceUse = run Semantic.demandSignature(&mut semantic, &mut firstRequest, &namespace, b"consume")
  let secondUse = run Semantic.demandSignature(&mut semantic, &mut secondRequest, &entry, b"consume")
  let absentUse = run Semantic.demandSignature(&mut semantic, &mut absentRequest, &entry, b"consume")
  let distinct = !run answersEqual(&firstUse, &secondUse, usize.ZERO)
  let sameNamespace = run answersEqual(&firstUse, &namespaceUse, usize.ZERO)
  let missing = rejectsFrom(
    &absentUse,
    RejectionCode.MissingModule,
    offsetOf(entryText, "Intrinsic.application", usize.ZERO),
  )
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, AnswerView>(&firstUse, inspect).success && Shared.with<
      Result<Answer, NoRejection>,
      AnswerView,
    >(&secondUse, inspect).success && sameNamespace && distinct && missing,
    "namespace and selective imports choose the request application; other bindings and absence stay separate",
  )
  let mut index = SourceIndex.make(run Revision.copy(&revision))
  let implementation = run requireIndexedIdentity(&mut index, &coherence, OwnerKind.Implementation, b"", usize.ZERO)
  let mut coherenceFirstRequest = Request.forApplication(run ModuleId.copy(&first))
  let mut coherencePrivateRequest = Request.forApplication(run ModuleId.copy(&private))
  let mut coherenceAbsentRequest = Request.make()
  let firstHead = run Semantic.demandCoherence(&mut semantic, &mut coherenceFirstRequest, &implementation)
  let privateHead = run Semantic.demandCoherence(&mut semantic, &mut coherencePrivateRequest, &implementation)
  let absentHead = run Semantic.demandCoherence(&mut semantic, &mut coherenceAbsentRequest, &implementation)
  run Testing.expect(
    succeeded(&firstHead) && rejectsAt(&privateHead, RejectionCode.PrivateMember) && rejectsFrom(
      &absentHead,
      RejectionCode.MissingModule,
      offsetOf(coherenceText, "Intrinsic.application", usize.ZERO),
    ) && Request.hasDiscovered(&coherenceFirstRequest, &first) && !Request.hasDiscovered(
      &coherenceAbsentRequest,
      &first,
    ),
    "coherence demands select each request application and do not inherit a prior binding or discovery",
  )
  let beforeHits = hits(Semantic.eventLog(&semantic), Family.Signature)
  let mut repeatRequest = Request.forApplication(run ModuleId.copy(&first))
  let firstAgain = run Semantic.demandSignature(&mut semantic, &mut repeatRequest, &entry, b"consume")
  let same = run answersEqual(&firstUse, &firstAgain, usize.ZERO)
  run Testing.expect(
    same && hits(Semantic.eventLog(&semantic), Family.Signature) > beforeHits,
    "an identical selected application reuses its completed signature",
  )
  let idleUse = run Semantic.demandSignature(&mut semantic, &mut absentRequest, &idle, b"idle")
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, AnswerView>(&idleUse, inspect).success,
    "an unused application import does not demand a binding",
  )
  let mut privateRequest = Request.forApplication(run ModuleId.copy(&private))
  let privateUse = run Semantic.demandSignature(&mut semantic, &mut privateRequest, &entry, b"consume")
  run Testing.expect(
    rejectsAt(&privateUse, RejectionCode.PrivateMember),
    "selected application members obey ordinary import visibility",
  )
  let operation = run requireIndexedIdentity(&mut index, &operations, OwnerKind.Function, b"select", usize.ZERO)
  let mut operationFirstRequest = Request.forApplication(run ModuleId.copy(&first))
  let heads = run Semantic.demandImplementations(&mut semantic, &mut operationFirstRequest, &operations)
  let head = headAt(&heads, usize.ZERO)
  let selectedContract = contractOf(&head)
  let selectedProvider = providerOf(&head)
  let mut switched = false
  if let Option<Shared<Type>>.Some {value: contract} = move selectedContract {
    if let Option<Shared<Type>>.Some {value: provider} = move selectedProvider {
      let firstApplied = run Semantic.demandAppliedOperation(
        &mut semantic, &mut operationFirstRequest, &contract, &provider, &operation,
      )
      let mut operationSecondRequest = Request.forApplication(run ModuleId.copy(&second))
      let secondApplied = run Semantic.demandAppliedOperation(
        &mut semantic, &mut operationSecondRequest, &contract, &provider, &operation,
      )
      let mut operationAbsentRequest = Request.make()
      let absentApplied = run Semantic.demandAppliedOperation(
        &mut semantic, &mut operationAbsentRequest, &contract, &provider, &operation,
      )
      let sameAppliedResult = run resultEquals(&firstApplied, &secondApplied)
      switched = succeeded(&firstApplied) && succeeded(&secondApplied) && !sameAppliedResult && rejectsFrom(
        &absentApplied,
        RejectionCode.MissingModule,
        offsetOf(operationsText, "Intrinsic.application", usize.ZERO),
      )
    }
  }
  run Testing.expect(switched, "applied operation selects each request application before resolving its signature")
  let removed = run present("pub struct Other {}\n")
  let changed = run Revision.publish(&revision, &first, &removed)
  Semantic.revise(&mut semantic, move changed)
  let mut changedRequest = Request.forApplication(run ModuleId.copy(&first))
  let missingItem = run Semantic.demandSignature(&mut semantic, &mut changedRequest, &entry, b"consume")
  run Testing.expect(
    rejectsAt(&missingItem, RejectionCode.UnknownMember),
    "a selected application edit invalidates its imported member",
  )
  return ()
}

// Whether a signature records the sealed `wanted` property on some parameter.
fn recordsProperty(answer: &Result<Answer, NoRejection>, wanted: IntrinsicProperty) -> bool {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Signature {signature}} = &value.outcome {
      let declared = Vector.asSlice<Constraint>(&signature.constraints)
      let mut at = usize.ZERO
      while at < declared.length {
        if let Constraint.Property {property, ..} = &declared[at] {
          let matches = match property {
            IntrinsicProperty.Detached => match wanted {
              IntrinsicProperty.Detached => true
              IntrinsicProperty.NonParking => false
            }
            IntrinsicProperty.NonParking => match wanted {
              IntrinsicProperty.Detached => false
              IntrinsicProperty.NonParking => true
            }
          }
          if matches {
            return true
          }
        }
        at = at + usize.ONE
      }
    }
  }
  return false
}

fn parameterOwnedBy(answer: &Result<Answer, NoRejection>, slot: usize, name: &[u8]) -> bool {
  if let Option<Shared<Type>>.Some {value} = move typeAt(answer, slot) {
    return Shared.with<Type, bool>(
      &value,
      fn(found: &Type) -> bool {
        return match & found.* {
          Type.Parameter {declaration, ..} => DeclarationId.named(&declaration, name)
          _ => false
        }
      },
    )
  }
  return false
}

test effect fn operationSignaturesUnderImplementations() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run operationUnderClaims()
    |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn operationUnderClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator {
  let contracts = run module("contracts.silk")
  let model = run module("model.silk")
  let witness = run module("witness.silk")
  let contractsText = "pub interface Convert<T> {\n  fn convert<U>(value: Self, other: U) -> T\n}\npub interface Hold<'a> {\n  fn hold(value: &Self) -> &'a i32\n}\npub service Clock {}\npub interface Needs<?R> {\n  fn pending(value: &Self) -> Effect<'static; i32 ? R>\n}\npub interface Other {\n  fn other(value: &Self) -> i32\n}\nstruct Hidden {}\npub interface Leaks {\n  fn leak(value: &Self) -> Hidden\n}\ninterface Quiet {\n  fn quiet(value: &Self) -> Hidden\n}\n"
  let modelText = "import contracts { Convert, Hold, Needs, Clock, Other }\nimport witness\npub struct Box<T> {\n  value: T\n}\npub struct Plain {}\nimpl Convert<i32> for Box<bool> {\n  convert: witness.convertBool\n}\nimpl Convert<bool> for Box<i32> {}\nimpl Hold<'static> for Plain {}\nimpl Needs<&Clock> for Plain {}\nimpl Other for Plain {}\nfn expectBoxBool(value: Box<bool>) -> i32 { return 0 }\nfn expectInt() -> i32 { return 0 }\nfn expectBool() -> bool { return true }\nfn expectStatic() -> &'static i32 { return () }\nfn expectPending() -> Effect<'static; i32 ? &Clock> { return () }\n"
  let contractsSource = run present(contractsText)
  let modelSource = run present(modelText)
  let witnessSource = run present("pub fn convertBool(value: i32) -> i32 { return 0 }\n")
  let r1 = run Revision.publish(&Revision.make(), &contracts, &contractsSource)
  let r2 = run Revision.publish(&r1, &model, &modelSource)
  let first = run Revision.publish(&r2, &witness, &witnessSource)
  let mut semantic = makeSemantic(run Revision.copy(&first))
  let mut request = Request.make()
  let mut index = SourceIndex.make(run Revision.copy(&first))
  let boxBool = run requireIndexedIdentity(&mut index, &model, OwnerKind.Implementation, b"", 0)
  let boxInt = run requireIndexedIdentity(&mut index, &model, OwnerKind.Implementation, b"", 1)
  let plainHold = run requireIndexedIdentity(&mut index, &model, OwnerKind.Implementation, b"", 2)
  let plainNeeds = run requireIndexedIdentity(&mut index, &model, OwnerKind.Implementation, b"", 3)
  let plainOther = run requireIndexedIdentity(&mut index, &model, OwnerKind.Implementation, b"", 4)
  let convert = run requireIndexedIdentity(&mut index, &contracts, OwnerKind.Function, b"convert", 0)
  let hold = run requireIndexedIdentity(&mut index, &contracts, OwnerKind.Function, b"hold", 0)
  let pending = run requireIndexedIdentity(&mut index, &contracts, OwnerKind.Function, b"pending", 0)
  let other = run requireIndexedIdentity(&mut index, &contracts, OwnerKind.Function, b"other", 0)
  let underBool = run Semantic.demandOperationUnder(&mut semantic, &mut request, &boxBool, &convert)
  let underInt = run Semantic.demandOperationUnder(&mut semantic, &mut request, &boxInt, &convert)
  let heads = run Semantic.demandImplementations(&mut semantic, &mut request, &model)
  let appliedContract = contractOf(&headAt(&heads, usize.ZERO))
  let appliedProvider = providerOf(&headAt(&heads, usize.ZERO))
  let mut sameAppliedContract = false
  if let Option<Shared<Type>>.Some {value: contract} = move appliedContract {
    if let Option<Shared<Type>>.Some {value: provider} = move appliedProvider {
      let applied = run Semantic.demandAppliedOperation(
        &mut semantic,
        &mut request,
        &contract,
        &provider,
        &convert,
      )
      sameAppliedContract = run answersEqual(&applied, &underBool, usize.MAX)
    }
  }
  run Testing.expect(
    sameAppliedContract,
    "an applied operation has the same call signature with or without its conformance head",
  )
  let expectBoxBool = run Semantic.demandSignature(&mut semantic, &mut request, &model, b"expectBoxBool")
  let expectInt = run Semantic.demandSignature(&mut semantic, &mut request, &model, b"expectInt")
  let expectBool = run Semantic.demandSignature(&mut semantic, &mut request, &model, b"expectBool")
  let selfBound = run answersEqual(&underBool, &expectBoxBool, usize.ZERO)
  let resultInt = run resultEquals(&underBool, &expectInt)
  let resultBool = run resultEquals(&underInt, &expectBool)
  let distinct = !(run resultEquals(&underBool, &underInt))
  let ownRigid = Shared.with<Result<Answer, NoRejection>, bool>(
    &underBool,
    fn(answer: &Result<Answer, NoRejection>) -> bool {
      return parameterOwnedBy(answer, usize.ONE, b"convert")
    },
  )
  run Testing.expect(
    selfBound && resultInt && resultBool && distinct && ownRigid,
    "each conformance head binds the contract's T and Self in one operation while its own U stays its parameter",
  )
  let underHold = run Semantic.demandOperationUnder(&mut semantic, &mut request, &plainHold, &hold)
  let underNeeds = run Semantic.demandOperationUnder(&mut semantic, &mut request, &plainNeeds, &pending)
  let expectStatic = run Semantic.demandSignature(&mut semantic, &mut request, &model, b"expectStatic")
  let expectPending = run Semantic.demandSignature(&mut semantic, &mut request, &model, b"expectPending")
  let staticBound = run resultEquals(&underHold, &expectStatic)
  let rowBound = run resultEquals(&underNeeds, &expectPending)
  let foreign = run Semantic.demandOperationUnder(&mut semantic, &mut request, &plainOther, &convert)
  let foreignAt = rejectsFrom(&foreign, RejectionCode.UnknownMember, offsetOf(modelText, "Other for Plain", 0))
  let foreignHead = headAt(&heads, 4)
  let foreignContract = contractOf(&foreignHead)
  let foreignProvider = providerOf(&foreignHead)
  let mut appliedForeignAt = false
  if let Option<Shared<Type>>.Some {value: contract} = move foreignContract {
    if let Option<Shared<Type>>.Some {value: provider} = move foreignProvider {
      let appliedForeign = run Semantic.demandAppliedOperation(
        &mut semantic,
        &mut request,
        &contract,
        &provider,
        &convert,
      )
      appliedForeignAt = rejectsFrom(
        &appliedForeign,
        RejectionCode.UnknownMember,
        offsetOf(contractsText, "fn convert", 0),
      )
    }
  }
  run Testing.expect(
    staticBound && rowBound && foreignAt && appliedForeignAt,
    "contract lifetime and row arguments bind, and a foreign operation rejects at its written header",
  )
  let named = run Semantic.demandOperation(&mut semantic, &mut request, &contracts, b"Convert", b"convert")
  let signatureStarts = starts(Semantic.eventLog(&semantic), Family.Signature)
  let byIdentity = run Semantic.demandSignatureOf(&mut semantic, &mut request, &convert)
  let sameAnswer = run resultEquals(&named, &byIdentity)
  let noRestart = starts(Semantic.eventLog(&semantic), Family.Signature) == signatureStarts
  let leak = run Semantic.demandOperation(&mut semantic, &mut request, &contracts, b"Leaks", b"leak")
  let quiet = run Semantic.demandOperation(&mut semantic, &mut request, &contracts, b"Quiet", b"quiet")
  let quietView = Shared.with<Result<Answer, NoRejection>, AnswerView>(&quiet, inspect)
  run Testing.expect(
    sameAnswer && noRestart && rejectsAt(&leak, RejectionCode.PrivateTypeExposure) && quietView.success,
    "an identity-addressed operation shares its name lookup's answer, and a public contract's operation cannot expose a private type",
  )
  let underStarts = starts(Semantic.eventLog(&semantic), Family.OperationUnder)
  let underHits = hits(Semantic.eventLog(&semantic), Family.OperationUnder)
  let editedWitness = run present("pub fn convertBool(value: i32) -> i32 { return 1 }\n")
  let second = run Revision.publish(&first, &witness, &editedWitness)
  Semantic.revise(&mut semantic, run Revision.copy(&second))
  let afterBody = run Semantic.demandOperationUnder(&mut semantic, &mut request, &boxBool, &convert)
  let bodyReused = starts(Semantic.eventLog(&semantic), Family.OperationUnder) == underStarts && hits(
    Semantic.eventLog(&semantic),
    Family.OperationUnder,
  ) == underHits + usize.ONE && (run resultEquals(&afterBody, &expectInt))
  let editedContracts = run present(
    "pub interface Convert<T> {\n  fn convert<U>(value: Self, other: U) -> U\n}\npub interface Hold<'a> {\n  fn hold(value: &Self) -> &'a i32\n}\npub service Clock {}\npub interface Needs<?R> {\n  fn pending(value: &Self) -> Effect<'static; i32 ? R>\n}\npub interface Other {}\nstruct Hidden {}\npub interface Leaks {\n  fn leak(value: &Self) -> Hidden\n}\ninterface Quiet {\n  fn quiet(value: &Self) -> Hidden\n}\n",
  )
  let third = run Revision.publish(&second, &contracts, &editedContracts)
  Semantic.revise(&mut semantic, run Revision.copy(&third))
  let afterHeader = run Semantic.demandOperationUnder(&mut semantic, &mut request, &boxBool, &convert)
  let headerRecomputed = starts(Semantic.eventLog(&semantic), Family.OperationUnder) == underStarts + usize.ONE && Shared.with<
    Result<Answer, NoRejection>,
    bool,
  >(
    &afterHeader,
    fn(answer: &Result<Answer, NoRejection>) -> bool {
      return parameterOwnedBy(answer, usize.MAX, b"convert")
    },
  )
  let deleted = run Semantic.demandSignatureOf(&mut semantic, &mut request, &other)
  run Testing.expect(
    bodyReused && headerRecomputed && rejectsWith(&deleted, RejectionCode.UnknownMember),
    "a witness body edit reuses the answer, a contract header edit recomputes it, and a deleted identity rejects",
  )
  return ()
}

