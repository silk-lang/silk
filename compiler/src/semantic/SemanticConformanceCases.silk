  let mut changedRequest = Request.make()
  let changed = run Semantic.demandBody(&mut semantic, &mut changedRequest, &entry, b"caller")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    succeeded(&checked) && !succeeded(&changed) && Request.hasDemand(
      &changedRequest, Family.Witnesses, &entry,
    ),
    "changing an operation signature invalidates its witness and caller",
  )
  return ()
}

fn singleWitnessMapsTo(answer: &Result<Answer, NoRejection>, target: &DeclarationId) -> bool {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Witnesses {witnesses}} = &value.outcome {
      let listed = Vector.asSlice<Witness>(&witnesses)
      if listed.length == usize.ONE {
        return Shared.with<DeclarationId, bool>(
          &listed[usize.ZERO].implementation,
          fn(found: &DeclarationId) -> bool { return DeclarationId.equals(found, target) },
        )
      }
    }
  }
  return false
}

test effect fn contractReuseRevisionWitnessSelection() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let entry = run module("pool-witness.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let unrelated = run module("pool-unrelated.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let initial = "interface Measure { fn value(item: Self) -> i32 }\nstruct Counter {}\nfn first(item: Counter) -> i32 { return 1 }\nfn other(item: Counter) -> i32 { return 2 }\nimpl Measure for Counter { value: first }\n"
  let source = run present(initial)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let firstRevision = run Revision.publish(&Revision.make(), &entry, &source)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut firstIndex = SourceIndex.make(
    run Revision.copy(&firstRevision)
      |> Effect.provideMut<Allocator>(&mut allocator),
  )
  let firstId = run requireIndexedIdentity(&mut firstIndex, &entry, OwnerKind.Function, b"first", usize.ZERO)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let otherId = run requireIndexedIdentity(&mut firstIndex, &entry, OwnerKind.Function, b"other", usize.ZERO)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut semantic = makeSemantic(
    run Revision.copy(&firstRevision)
      |> Effect.provideMut<Allocator>(&mut allocator),
  )
  let mut firstRequest = Request.make()
  let firstWitness = run witnessesOf(&mut semantic, &mut firstRequest, &mut firstIndex, &entry, usize.ZERO)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let unrelatedSource = run present("fn idle() -> i32 { return 1 }\n")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let warmRevision = run Revision.publish(&firstRevision, &unrelated, &unrelatedSource)
    |> Effect.provideMut<Allocator>(&mut allocator)
  Semantic.revise(
    &mut semantic,
    run Revision.copy(&warmRevision)
      |> Effect.provideMut<Allocator>(&mut allocator),
  )
  let mut warmIndex = SourceIndex.make(
    run Revision.copy(&warmRevision)
      |> Effect.provideMut<Allocator>(&mut allocator),
  )
  let mut warmRequest = Request.make()
  let warmWitness = run witnessesOf(&mut semantic, &mut warmRequest, &mut warmIndex, &entry, usize.ZERO)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut coldSemantic = makeSemantic(
    run Revision.copy(&warmRevision)
      |> Effect.provideMut<Allocator>(&mut allocator),
  )
  let mut coldRequest = Request.make()
  let coldWitness = run witnessesOf(&mut coldSemantic, &mut coldRequest, &mut warmIndex, &entry, usize.ZERO)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let remappedSource = run present(
    "interface Measure { fn value(item: Self) -> i32 }\nstruct Counter {}\nfn first(item: Counter) -> i32 { return 1 }\nfn other(item: Counter) -> i32 { return 2 }\nimpl Measure for Counter { value: other }\n",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let changedRevision = run Revision.publish(&warmRevision, &entry, &remappedSource)
    |> Effect.provideMut<Allocator>(&mut allocator)
  Semantic.revise(
    &mut semantic,
    run Revision.copy(&changedRevision)
      |> Effect.provideMut<Allocator>(&mut allocator),
  )
  let mut changedIndex = SourceIndex.make(
    run Revision.copy(&changedRevision)
      |> Effect.provideMut<Allocator>(&mut allocator),
  )
  let mut changedRequest = Request.make()
  let changedWitness = run witnessesOf(&mut semantic, &mut changedRequest, &mut changedIndex, &entry, usize.ZERO)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(
      &firstWitness,
      fn(answer: &Result<Answer, NoRejection>) -> bool { return singleWitnessMapsTo(answer, &firstId) },
    ) && Shared.with<Result<Answer, NoRejection>, bool>(
      &warmWitness,
      fn(answer: &Result<Answer, NoRejection>) -> bool { return singleWitnessMapsTo(answer, &firstId) },
    ) && Shared.with<Result<Answer, NoRejection>, bool>(
      &coldWitness,
      fn(answer: &Result<Answer, NoRejection>) -> bool { return singleWitnessMapsTo(answer, &firstId) },
    ) && Shared.with<Result<Answer, NoRejection>, bool>(
      &changedWitness,
      fn(answer: &Result<Answer, NoRejection>) -> bool { return singleWitnessMapsTo(answer, &otherId) },
    ) && hits(Semantic.eventLog(&semantic), Family.Witnesses) == usize.ONE && Request.rootCount(&changedRequest) == usize.ONE,
    "warm and cold sessions select the same witness after an unrelated edit and a remap selects the other implementation",
  )
  return ()
}

effect fn witnessClaims(part: usize) -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator {
  let contracts = run module("wcontracts.silk")
  let model = run module("wmodel.silk")
  let contractsText = "pub struct LoadError {}\npub struct IoError {}\npub service Clock {}\npub service Logger {}\npub service Ticker {\n  fn tick(value: Self) -> i32\n}\npub interface Info {\n  fn decode(value: Self) -> i32\n  fn width(value: Self) -> i32\n}\npub interface Load {\n  effect<'static> fn load(value: Self) -> i32 ! LoadError ? &Clock\n}\npub interface Shift {\n  fn shift(value: Self, amount: i32) -> i32\n}\npub interface Look {\n  fn look(value: &'static Self) -> i32\n}\npub interface Poke {\n  fn poke(value: &'static mut Self) -> i32\n}\npub interface Spread {\n  fn spread(value: Self, items: &'static [i32]) -> i32\n}\npub interface Risky {\n  unsafe fn risky(value: Self) -> i32\n}\npub interface Pick<'x, 'y> {\n  effect<'x> fn pick(value: Self) -> i32\n}\npub interface Bridge<'x, 'y> {\n  effect<'x> fn cross() -> i32\n}\nfn shiftInt(value: i32, amount: i32) -> i32 { return value }\nimpl Info for i32 {\n  fn decode(value: Self) -> i32 { return value }\n  fn width(value: Self) -> i32 { return 32 }\n}\nimpl Shift for i32 {\n  shift: shiftInt\n}\n"
  let modelText = witnessModelFixture(part)
  let contractsSource = run present(contractsText)
  let modelSource = run present(modelText)
  let r1 = run Revision.publish(&Revision.make(), &contracts, &contractsSource)
  let revision = run Revision.publish(&r1, &model, &modelSource)
  let mut semantic = makeSemantic(run Revision.copy(&revision))
  let mut index = SourceIndex.make(run Revision.copy(&revision))
  let mut request = Request.make()
  if part == 0 {
    let schema = run witnessesOf(&mut semantic, &mut request, &mut index, &model, 0)
    let schemaPair = Shared.with<Result<Answer, NoRejection>, bool>(&schema, inlineThenMappedWitnesses)
    let serviceWitness = run witnessesOf(&mut semantic, &mut request, &mut index, &model, 4)
    let scalarInline = run witnessesOf(&mut semantic, &mut request, &mut index, &contracts, 0)
    run Testing.expect(
      schemaPair && succeeded(&serviceWitness) && succeeded(&scalarInline),
      "inline and mapped members supply operations in contract order for interfaces, services and scalars",
    )
    let lacking = run witnessesOf(&mut semantic, &mut request, &mut index, &model, 1)
    let misnamed = run witnessesOf(&mut semantic, &mut request, &mut index, &model, 2)
    let twice = run witnessesOf(&mut semantic, &mut request, &mut index, &model, 3)
    let scalarMapped = run witnessesOf(&mut semantic, &mut request, &mut index, &contracts, 1)
    run Testing.expect(
      rejectsWitness(&lacking, offsetOf(modelText, "impl Info for Lacking", 0), 0, usize.MAX) && rejectsWitness(
        &misnamed,
        offsetOf(modelText, "fn decodeSchema", 0),
        1,
        usize.MAX,
      ) && rejectsFrom(&twice, RejectionCode.Collision, offsetOf(modelText, "decode: twiceDecode", 0)) && rejectsWitness(
        &scalarMapped,
        offsetOf(contractsText, "shift: shiftInt", 0),
        2,
        usize.MAX,
      ),
      "a missing, unknown or repeated member, or a mapped scalar source function, is rejected at its anchor",
    )
  }
  if part == 1 {
    let eager = run witnessesOf(&mut semantic, &mut request, &mut index, &model, 0)
    let lazy = run witnessesOf(&mut semantic, &mut request, &mut index, &model, 1)
    let hazard = run witnessesOf(&mut semantic, &mut request, &mut index, &model, 2)
    let careful = run witnessesOf(&mut semantic, &mut request, &mut index, &model, 3)
    run Testing.expect(
      rejectsWitness(&eager, offsetOf(modelText, "fn load(value: Self) -> i32 { return 0 }", 0), 3, usize.MAX),
      "an ordinary function cannot implement an effect operation",
    )
    run Testing.expect(
      rejectsWitness(&lazy, offsetOf(modelText, "effect fn decode", 0), 3, usize.MAX),
      "an effect function cannot implement an ordinary operation",
    )
    run Testing.expect(
      rejectsWitness(&hazard, offsetOf(modelText, "unsafe fn decode", 0), 4, usize.MAX),
      "an unsafe function cannot implement a safe operation",
    )
    run Testing.expect(succeeded(&careful), "a safe function can implement an unsafe operation")
  }
  if part == 2 {
    let grabby = run witnessesOf(&mut semantic, &mut request, &mut index, &model, 0)
    let taker = run witnessesOf(&mut semantic, &mut request, &mut index, &model, 1)
    let reader = run witnessesOf(&mut semantic, &mut request, &mut index, &model, 2)
    let single = run witnessesOf(&mut semantic, &mut request, &mut index, &model, 3)
    let wide = run witnessesOf(&mut semantic, &mut request, &mut index, &model, 4)
    let nested = run witnessesOf(&mut semantic, &mut request, &mut index, &model, 5)
    run Testing.expect(
      rejectsWitness(&grabby, offsetOf(modelText, "fn look(value: &'static mut Self)", 0), 6, 0) && rejectsWitness(
        &taker,
        offsetOf(modelText, "fn look(value: Self)", 0),
        6,
        0,
      ) && succeeded(&reader) && rejectsWitness(&single, offsetOf(modelText, "fn spread", 0), 7, 1) && rejectsWitness(
        &wide,
        offsetOf(modelText, "fn shift(value: Self, amount: i64)", 0),
        8,
        1,
      ) && rejectsWitness(&nested, offsetOf(modelText, "fn look(value: &'static &'static Self)", 0), 8, 0),
      "operand modes are literal: weaker access is allowed, stronger or consuming access, a slice for a reference, and another type are not",
    )
  }
  if part == 3 {
    let long = run witnessesOf(&mut semantic, &mut request, &mut index, &model, 0)
    let deferred = run witnessesOf(&mut semantic, &mut request, &mut index, &model, 1)
    let noisy = run witnessesOf(&mut semantic, &mut request, &mut index, &model, 2)
    let chatty = run witnessesOf(&mut semantic, &mut request, &mut index, &model, 3)
    let writer = run witnessesOf(&mut semantic, &mut request, &mut index, &model, 4)
    let quiet = run witnessesOf(&mut semantic, &mut request, &mut index, &model, 5)
    run Testing.expect(
      rejectsWitness(&long, offsetOf(modelText, "fn decode(value: Self) -> i64", 0), 9, usize.MAX) && rejectsWitness(
        &deferred,
        offsetOf(modelText, "effect fn load(value: Self) -> Effect", 0),
        9,
        usize.MAX,
      ) && rejectsWitness(&noisy, offsetOf(modelText, "effect fn load(value: Self) -> i32 ! LoadError | IoError", 0), 10, usize.MAX) && rejectsWitness(
        &chatty,
        offsetOf(modelText, "effect fn load(value: Self) -> i32 ? &Logger", 0),
        11,
        usize.MAX,
      ) && rejectsWitness(&writer, offsetOf(modelText, "effect fn load(value: Self) -> i32 ? &mut Clock", 0), 12, usize.MAX) && succeeded(&quiet),
      "results match exactly, while failures and requirements may only narrow the promised channels",
    )
    let loadIdentity = run requireIndexedIdentity(&mut index, &model, OwnerKind.Implementation, b"", 5)
    let loadOperation = run requireIndexedIdentity(&mut index, &contracts, OwnerKind.Function, b"load", 0)
    let promised = run Semantic.demandOperationUnder(&mut semantic, &mut request, &loadIdentity, &loadOperation)
    run Testing.expect(
      Shared.with<Result<Answer, NoRejection>, bool>(&promised, promisesLoadChannels),
      "a narrower witness leaves the operation contract that callers see unchanged",
    )
  }
  if part == 4 {
    let bodies = starts(Semantic.eventLog(&semantic), Family.Body)
    let broken = run witnessesOf(&mut semantic, &mut request, &mut index, &model, 0)
    let loose = run witnessesOf(&mut semantic, &mut request, &mut index, &model, 1)
    run Testing.expect(
      rejectsFrom(&broken, RejectionCode.UnknownName, offsetOf(modelText, "Missing", 0)) && succeeded(&loose) && bodies == usize.ZERO && starts(
        Semantic.eventLog(&semantic),
        Family.Body,
      ) == usize.ZERO,
      "a mapped header is checked, and no member body is read or checked",
    )
    let retained = run witnessesOf(&mut semantic, &mut request, &mut index, &model, 2)
    let unrelated = run witnessesOf(&mut semantic, &mut request, &mut index, &model, 3)
    // 'b covers 'a through the declared chain 'b: 'c: 'a.
    let chained = run witnessesOf(&mut semantic, &mut request, &mut index, &model, 4)
    // Staged for exact matching in this unit: the elided borrow is the witness's own binder.
    let elided = run witnessesOf(&mut semantic, &mut request, &mut index, &model, 5)
    run Testing.expect(succeeded(&retained), "the retained environment can implement its matching operation")
    run Testing.expect(
      rejectsWitness(&unrelated, offsetOf(modelText, "effect<'c> fn pick", 0), 14, usize.MAX),
      "an unrelated witness environment cannot cover the promised one",
    )
    run Testing.expect(
      succeeded(&chained),
      "transitive declared lifetime bounds cover the promised environment",
    )
    run Testing.expect(
      succeeded(&elided) && witnessArgumentCount(&elided) == usize.ONE,
      "an elided witness-owned lifetime matches the promised borrow and records its argument",
    )
  }
  return ()
}

effect fn copyGenericArguments(arguments: &[Argument]) -> Vector<Argument> ! OutOfMemoryError ? &mut Allocator {
  let mut output = Vector.make<Argument>()
  let mut at = usize.ZERO
  while at < arguments.length {
    run Vector.append<Argument>(&mut output, Argument.copy(&arguments[at]))
    at = at + usize.ONE
  }
  return move output
}

effect fn mappedCallOf(
  semantic: &mut Semantic, request: &mut Request, module: &ModuleId,
  caller: &DeclarationId, operation: &DeclarationId, answer: &Shared<Result<Answer, NoRejection>>,
  arguments: &[Argument], concrete: bool,
) -> SpecializationApplication
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator {
  let inputs = Shared.with<Result<Answer, NoRejection>, Option<WitnessCallInputs>>(answer, witnessCallInputs)
  let value = match move inputs {
    Option<WitnessCallInputs>.Some {value} => move value
    Option<WitnessCallInputs>.None => {
      run Testing.expect(false, "source fixture produces a checked interface call")
      return run specializationWithArguments(caller, Vector.make<Argument>())
    }
  }
  run Testing.expect(value.selected == concrete, "typing keeps declared and concrete witness selection distinct")
  let environment = run specializationWithArguments(caller, run copyGenericArguments(arguments))
  let resolved = run Semantic.specializeInterfaceCall(&mut semantic.*, &mut request.*, &value.contract,
    &value.provider, operation, &environment, module, value.span)
  if let Result<SpecializationApplication, Shared<Rejection>>.Success {value: application} = move resolved {
    return move application
  }
  run Testing.expect(false, "concrete proof maps a checked interface call to its target application")
  return run specializationWithArguments(caller, Vector.make<Argument>())
}

test effect fn witnessApplicationMapsTargetBinderOrder() -> ()
! CanonicalizationFailure | InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run witnessApplicationClaims(true) |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn witnessApplicationBindsContractOnlyInlineParameters() -> ()
! CanonicalizationFailure | InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run witnessApplicationClaims(false) |> Effect.provideMut<Allocator>(&mut allocator)
}

fn witnessApplicationSource(mapped: bool) -> string<'static> {
  if mapped {
    return """
interface Make<A, B> { fn make(value: Self, left: A, right: B) -> B }
struct Maker {}
fn target<Y, X>(value: Maker, left: X, right: Y) -> Y { return missing }
impl<A, B> Make<A, B> for Maker { make: target }
fn bounded<P: Make<A, B>, A, B>(value: P, left: A, right: B) -> B { return Make.make(move value, move left, move right) }
fn concrete(value: Maker) -> bool { return true }
"""
  }
  return """
interface Make<T> { fn make(value: Self) -> T }
struct Maker {}
impl<T> Make<T> for Maker { fn make(value: Self) -> T { return missing } }
fn bounded<P: Make<A>, A>(value: P) -> A { return Make.make(move value) }
fn concrete(value: Maker) -> i32 { return 0 }
struct Pair<A, B> { first: A second: B }
struct Container<T> { value: T }
impl<T> Container<T> {
  fn sparse<T, U>(value: Pair<T, U>) -> Pair<T, U> { return missing }
  fn collision<U>(value: Pair<T, U>) -> Pair<T, U> { return missing }
  fn scoped<P: Make<T>>(value: P) -> T { return missing }
}
struct RegionContainer<'a> {}
impl<'a> RegionContainer<'a> { fn region(value: Self) -> string<'a> { return missing } }
fn lifetime<'a>(value: &'a i32) -> &'a i32 { return value }
pub fn exposed<T>(value: T) -> T { return missing }
interface Regional<'a> { fn regionMake(value: Self) -> string<'a> }
impl<'a> Regional<'a> for Maker { fn regionMake(value: Self) -> string<'a> { return missing } }
service Clock {}
service Logger {}
struct RowHost<?R> {}
impl<?R> RowHost<?R> { effect fn rows<?S>() -> Effect<'static; i32 ? R | S> ? R | S { return missing } }
effect fn capture(value: &i32) -> i32 { return missing }
"""
}

effect fn witnessApplicationClaims(mapped: bool) -> ()
! CanonicalizationFailure | InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator {
  let entry = run module("witness-application.silk")
  let text = witnessApplicationSource(mapped)
  let source = run present(text)
  let revision = run Revision.publish(&Revision.make(), &entry, &source)
  let mut semantic = makeSemantic(run Revision.copy(&revision))
  let mut index = SourceIndex.make(move revision)
  let mut request = Request.make()
  let bounded = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"bounded")
  let boundedOwner = run requireIndexedIdentity(&mut index, &entry, OwnerKind.Function, b"bounded", usize.ZERO)
  let concreteOwner = run requireIndexedIdentity(&mut index, &entry, OwnerKind.Function, b"concrete", usize.ZERO)
  let operation = run requireIndexedIdentity(&mut index, &entry, OwnerKind.Function, b"make", usize.ZERO)
  let contractOwner = run requireIndexedIdentity(&mut index, &entry, OwnerKind.Interface, b"Make", usize.ZERO)
  let providerSignature = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"concrete")
  let provider = move slotOf(&providerSignature, usize.ZERO)
  if let Option<Shared<Type>>.Some {value: ty} = move provider {
    let mut supplied = Vector.make<Argument>()
    run Vector.append<Argument>(&mut supplied, Argument.Type {value: Shared.clone<Type>(&ty)})
    run Vector.append<Argument>(&mut supplied, Argument.Type {value: run specializationPrimitive(b"i32")})
    if mapped { run Vector.append<Argument>(&mut supplied, Argument.Type {value: run specializationPrimitive(b"bool")}) }
    let none = Vector.make<Argument>()
    let bodies = starts(Semantic.eventLog(&semantic), Family.Body)
    let boundApplication = run mappedCallOf(&mut semantic, &mut request, &entry, &boundedOwner, &operation, &bounded,
      Vector.asSlice<Argument>(&supplied), false)
    // The qualified-call typer takes generic contract arguments from declared bounds. Build
    // this concrete goal independently so this mapping assertion does not widen that policy.
    let mut contractArguments = Vector.make<Argument>()
    run Vector.append<Argument>(&mut contractArguments, Argument.Type {value: run specializationPrimitive(b"i32")})
    if mapped { run Vector.append<Argument>(&mut contractArguments, Argument.Type {value: run specializationPrimitive(b"bool")}) }
    let contract = run Shared.make<Type>(Type.Nominal {
      declaration: move contractOwner, isPublic: false, arguments: move contractArguments,
    })
    let concreteEnvironment = run specializationWithArguments(&concreteOwner, Vector.make<Argument>())
    let concreteResolved = run Semantic.specializeInterfaceCall(&mut semantic, &mut request, &contract, &ty,
      &operation, &concreteEnvironment, &entry, Span.make(usize.ZERO, usize.ONE))
    let concreteApplication = match move concreteResolved {
      Result<SpecializationApplication, Shared<Rejection>>.Success {value} => move value
      Result<SpecializationApplication, Shared<Rejection>>.Failure {error} => {
        run Testing.expect(false, "independent concrete goal resolves without declared bounds")
        return ()
      }
    }
    run Testing.expect(run SpecializationApplication.runtimeEquals(&boundApplication, &concreteApplication),
      "bound and concrete calls select the same canonical resolved application")
    let arguments = Vector.asSlice<Argument>(&boundApplication.arguments)
    let mut ordered = false
    if mapped && arguments.length == 2 {
      ordered = match &arguments[0] { Argument.Type {value} => Shared.with<Type, bool>(&value,
        fn(ty: &Type) -> bool { return witnessPrimitive(ty, b"bool") }) _ => false }
        && match &arguments[1] { Argument.Type {value} => Shared.with<Type, bool>(&value,
          fn(ty: &Type) -> bool { return witnessPrimitive(ty, b"i32") }) _ => false }
    }
    if !mapped && arguments.length == usize.ZERO {
      let expectedOwner = run requireIndexedIdentity(&mut index, &entry, OwnerKind.Implementation, b"", usize.ZERO)
      let scopes = Vector.asSlice<ScopeBinding>(&boundApplication.scopes)
      if scopes.length == usize.ONE {
        let values = Vector.asSlice<Argument>(&scopes[0].arguments)
        let ordinals = Vector.asSlice<usize>(&scopes[0].argumentOrdinals)
        ordered = values.length == usize.ONE && ordinals.length == usize.ONE && ordinals[0] == usize.ZERO
          && Shared.with<DeclarationId, bool>(&scopes[0].owner, fn(owner: &DeclarationId) -> bool { return DeclarationId.equals(owner, &expectedOwner) })
          && match &values[0] { Argument.Type {value} => Shared.with<Type, bool>(&value,
            fn(ty: &Type) -> bool { return witnessPrimitive(ty, b"i32") }) _ => false }
      }
    }
    run Testing.expect(ordered, "witness mapping retains target binder order and binds parameters found only in the contract")
    if mapped {
      let target = run requireIndexedIdentity(&mut index, &entry, OwnerKind.Function, b"target", usize.ZERO)
      let mut directArguments = Vector.make<Argument>()
      run Vector.append<Argument>(&mut directArguments, Argument.Type {value: run specializationPrimitive(b"bool")})
      run Vector.append<Argument>(&mut directArguments, Argument.Type {value: run specializationPrimitive(b"i32")})
      let direct = run specializationWithArguments(&target, move directArguments)
      run Testing.expect(run SpecializationApplication.equals(&boundApplication, &direct),
        "mapped witness and direct call share the exact Named application")
      let witnessKey = run requiredCanonicalKey(run InstanceKey.function(run SpecializationApplication.copy(&boundApplication)))
      let directKey = run requiredCanonicalKey(run InstanceKey.function(run SpecializationApplication.copy(&direct)))
      let witnessSymbol = run InstanceKey.runtimeName(&witnessKey)
      let directSymbol = run InstanceKey.runtimeName(&directKey)
      run Testing.expect(InstanceKey.sameRuntimeBase(&witnessKey, &directKey) && sameBytes(Bytes.asSlice(&witnessSymbol), Bytes.asSlice(&directSymbol)),
        "resolved witnesses share direct target erased family keys and names without demanding the body")
    }
    if !mapped {
      let target = run requireIndexedIdentity(&mut index, &entry, OwnerKind.Function, b"make", usize.ONE)
      let scopeOwner = run requireIndexedIdentity(&mut index, &entry, OwnerKind.Implementation, b"", usize.ZERO)
      let mut direct = run specializationWithArguments(&target, Vector.make<Argument>())
      run Vector.append<ScopeBinding>(&mut direct.scopes, run specializationScope(&scopeOwner, run specializationPrimitive(b"i32")))
      let validated = run Semantic.validateApplication(&mut semantic, &mut request, &direct, &entry, Span.make(usize.ZERO, usize.ONE))
      run Testing.expect(matchesApplication(&validated, &target), "independent direct inline environment validates against actual impl-owner slots")
      run Testing.expect(run SpecializationApplication.equals(&boundApplication, &direct), "inline direct and witness own[] plus actual impl scope agree")
      let applied = run Semantic.specializeSignature(&mut semantic, &mut request, &direct, &entry, Span.make(usize.ZERO, usize.ONE))
      run Testing.expect(signatureIsI32(&applied), "full target scope substitutes impl-owned T in the signature")
      let directKey = run requiredCanonicalKey(run InstanceKey.function(run SpecializationApplication.copy(&direct)))
      let witnessKey = run requiredCanonicalKey(run InstanceKey.function(run SpecializationApplication.copy(&boundApplication)))
      let copied = run InstanceKey.selected(&directKey)
      let firstSymbol = run InstanceKey.runtimeName(&directKey)
      let secondSymbol = run InstanceKey.runtimeName(&witnessKey)
      let completeCopy = run SpecializationApplication.equals(&copied, &direct)
      run Testing.expect(completeCopy && InstanceKey.sameRuntimeBase(&directKey, &witnessKey)
        && sameBytes(Bytes.asSlice(&firstSymbol), Bytes.asSlice(&secondSymbol)), "complete scope survives key projections and shares direct witness family names")
      let mut other = run specializationWithArguments(&target, Vector.make<Argument>())
      run Vector.append<ScopeBinding>(&mut other.scopes, run specializationScope(&scopeOwner, run specializationPrimitive(b"bool")))
      let aliases = run SpecializationApplication.runtimeEquals(&direct, &other)
      run Testing.expect(!aliases, "different impl scope arguments do not alias")
      run witnessScopeMetadataClaims(&mut semantic, &mut request, &mut index, &entry, &direct)
    }
    run Testing.expect(starts(Semantic.eventLog(&semantic), Family.Body) == bodies && bodies == usize.ONE,
      "mapping reads only proof and witness headers even when the selected target body is invalid")
  } else { run Testing.expect(false, "fixture has a concrete provider") }
  return ()
}

fn matchesApplication(result: &Result<SpecializationApplication, Shared<Rejection>>, target: &DeclarationId) -> bool {
  return match &result.* {
    Result<SpecializationApplication, Shared<Rejection>>.Success {value} => DeclarationId.equals(SpecializationApplication.bodyDeclaration(&value), target)
    _ => false
  }
}

effect fn specializationScope(owner: &DeclarationId, value: Shared<Type>) -> ScopeBinding
! OutOfMemoryError ? &mut Allocator {
  let mut arguments = Vector.make<Argument>()
  run Vector.append<Argument>(&mut arguments, Argument.Type {value: move value})
  let mut ordinals = Vector.make<usize>()
  run Vector.append<usize>(&mut ordinals, usize.ZERO)
  return ScopeBinding {owner: run Shared.make<DeclarationId>(run DeclarationId.copy(owner)), arguments: move arguments, argumentOrdinals: move ordinals}
}

effect fn witnessScopeMetadataClaims(semantic: &mut Semantic, request: &mut Request, index: &mut SourceIndex,
  entry: &ModuleId, inline: &SpecializationApplication) -> ()
! CanonicalizationFailure | InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> ? &mut Allocator {
  let enclosing = run requireIndexedIdentity(&mut index.*, entry, OwnerKind.Implementation, b"", usize.ONE)
  let pair = run requireIndexedIdentity(&mut index.*, entry, OwnerKind.Struct, b"Pair", usize.ZERO)
  let sparse = run requireIndexedIdentity(&mut index.*, entry, OwnerKind.Function, b"sparse", usize.ZERO)
  let collision = run requireIndexedIdentity(&mut index.*, entry, OwnerKind.Function, b"collision", usize.ZERO)
  let expectedArguments = [Argument.Type {value: run specializationPrimitive(b"i32")}, Argument.Type {value: run specializationPrimitive(b"bool")}]
  let expected = run specializationNominal(&pair, run copyGenericArguments(&expectedArguments))
  let mut at = usize.ZERO
  while at < 2 {
    let mut target = run DeclarationId.copy(&sparse)
    if at == usize.ONE { target = run DeclarationId.copy(&collision) }
    let own = [Argument.Type {value: run specializationPrimitive(b"bool")}]
    let mut application = run specializationWithArguments(&target, run copyGenericArguments(&own))
    Vector.set<usize>(&mut application.argumentOrdinals, usize.ZERO, usize.ONE - at)
    run Vector.append<ScopeBinding>(&mut application.scopes, run specializationScope(&enclosing, run specializationPrimitive(b"i32")))
    let accepted = run Semantic.validateApplication(&mut semantic.*, &mut request.*, &application, entry, Span.make(usize.ZERO, usize.ONE))
    run Testing.expect(matchesApplication(&accepted, &target), "actual sparse and colliding owner metadata validate without enabling a source call")
    let applied = run Semantic.specializeSignature(&mut semantic.*, &mut request.*, &application, entry, Span.make(usize.ZERO, usize.ONE))
    let result = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(&applied, signatureResult)
    let parameter = move slotOf(&applied, usize.ZERO)
    let mut substituted = false
    if let Option<Shared<Type>>.Some {value: found} = move result {
      if let Option<Shared<Type>>.Some {value: input} = move parameter {
        let resultMatches = run Type.equalsShared(&found, &expected)
        let inputMatches = run Type.equalsShared(&input, &expected)
        substituted = resultMatches && inputMatches
      }
    }
    run Testing.expect(substituted, "sparse own ordinal and equal own/scope ordinals substitute distinct values deeply")
    let mut invalid = run SpecializationApplication.copy(&application)
    Vector.set<usize>(&mut invalid.argumentOrdinals, usize.ZERO, 2)
    let rejected = run Semantic.validateApplication(&mut semantic.*, &mut request.*, &invalid, entry, Span.make(3, 7))
    let anchored = match &rejected {
      Result<SpecializationApplication, Shared<Rejection>>.Failure {error} => Shared.with<Rejection, bool>(&error, fn(value: &Rejection) -> bool {
        return value.code == RejectionCode.Unsupported && ModuleId.equals(&value.module, entry) && value.span.start == 3 && value.span.end == 7
      })
      _ => false
    }
    run Testing.expect(anchored, "an invalid original ordinal rejects at the exact caller site")
    at = at + usize.ONE
  }
  let mut variant = usize.ZERO
  while variant < 3 {
    let mut invalid = run SpecializationApplication.copy(inline)
    let mut scopes = Vector.asMutSlice<ScopeBinding>(&mut invalid.scopes)
    if variant == usize.ZERO { scopes[0].owner = run Shared.make<DeclarationId>(run DeclarationId.copy(&collision)) }
    if variant == usize.ONE {
      Vector.set<Argument>(&mut scopes[0].arguments, usize.ZERO, Argument.Lifetime {value: run Shared.make<Lifetime>(Lifetime.Static)})
    }
    if variant == 2 { Vector.truncate<Argument>(&mut scopes[0].arguments, usize.ZERO) }
    let rejected = run Semantic.validateApplication(&mut semantic.*, &mut request.*, &invalid, entry, Span.make(3, 7))
    let anchored = match &rejected {
      Result<SpecializationApplication, Shared<Rejection>>.Failure {error} => Shared.with<Rejection, bool>(&error,
        fn(value: &Rejection) -> bool { return value.code == RejectionCode.Unsupported && value.span.start == 3 && value.span.end == 7 && ModuleId.equals(&value.module, entry) })
      _ => false
    }
    run Testing.expect(anchored, "wrong scope owner, kind and count reject at the caller site")
    variant = variant + usize.ONE
  }
  let regionTarget = run requireIndexedIdentity(&mut index.*, entry, OwnerKind.Function, b"region", usize.ZERO)
  let regionOwner = run requireIndexedIdentity(&mut index.*, entry, OwnerKind.Implementation, b"", 2)
  let regionCaller = run requireIndexedIdentity(&mut index.*, entry, OwnerKind.Function, b"lifetime", usize.ZERO)
  let mut staticRegion = run specializationWithArguments(&regionTarget, Vector.make<Argument>())
  let mut lifetimeValues = Vector.make<Argument>()
  run Vector.append<Argument>(&mut lifetimeValues, Argument.Lifetime {value: run Shared.make<Lifetime>(Lifetime.Static)})
  run Vector.append<ScopeBinding>(&mut staticRegion.scopes, ScopeBinding {owner: run Shared.make<DeclarationId>(run DeclarationId.copy(&regionOwner)),
    arguments: move lifetimeValues, argumentOrdinals: run SpecializationApplication.denseOrdinals(usize.ONE)})
  let mut otherRegion = run SpecializationApplication.copy(&staticRegion)
  let mut scope = Vector.asMutSlice<ScopeBinding>(&mut otherRegion.scopes)
  Vector.set<Argument>(&mut scope[0].arguments, usize.ZERO, Argument.Lifetime {value: run Shared.make<Lifetime>(Lifetime.Parameter {
    declaration: move regionCaller, ordinal: usize.ZERO})})
  let accepted = run Semantic.validateApplication(&mut semantic.*, &mut request.*, &otherRegion, entry, Span.make(usize.ZERO, usize.ONE))
  let sameValidity = run SpecializationApplication.equals(&staticRegion, &otherRegion)
  let sameRuntime = run SpecializationApplication.runtimeEquals(&staticRegion, &otherRegion)
  run Testing.expect(matchesApplication(&accepted, &regionTarget) && !sameValidity && sameRuntime,
    "scope validity lifetimes differ semantically and erase in runtime identity")
  let mut outer = run SpecializationApplication.copy(inline)
  let mut scopes = Vector.asMutSlice<ScopeBinding>(&mut outer.scopes)
  Vector.set<Argument>(&mut scopes[0].arguments, usize.ZERO, Argument.Type {value: Shared.clone<Type>(&expected)})
  let mut admission = SpecializationAdmission.make()
  let first = run SpecializationAdmission.enter(&mut admission, &outer, SpecializationEdge.Witness)
  let smaller = run SpecializationAdmission.enter(&mut admission, inline, SpecializationEdge.Witness)
  let growth = run SpecializationAdmission.enter(&mut admission, &outer, SpecializationEdge.Witness)
  let descends = match move first { SpecializationDecision.Entered => true _ => false }
    && match move smaller { SpecializationDecision.Entered => true _ => false }
    && match move growth { SpecializationDecision.Rejected {..} => true _ => false }
  run Testing.expect(descends, "scope-only witness descent enters and reverse growth rejects despite own[]")
  run witnessCallerAndRowClaims(&mut semantic.*, &mut request.*, &mut index.*, entry, inline, &enclosing)
  run witnessLifetimeClaims(&mut semantic.*, &mut request.*, &mut index.*, entry)
  return ()
}

fn signatureStringIsStatic(answer: &Result<Answer, NoRejection>) -> bool {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Signature {signature}} = &value.outcome {
      return Shared.with<Type, bool>(&signature.result, stringIsStatic)
    }
  }
  return false
}

fn stringIsStatic(value: &Type) -> bool {
  return match &value.* { Type.String {lifetime} => Shared.with<Lifetime, bool>(&lifetime, validityIsStatic) _ => false }
}

fn borrowIsStatic(value: &Type) -> bool {
  return match &value.* { Type.Reference {lifetime, ..} => Shared.with<Lifetime, bool>(&lifetime, validityIsStatic) _ => false }
}

fn signatureEnvironmentIsStatic(answer: &Result<Answer, NoRejection>) -> bool {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Signature {signature}} = &value.outcome {
      let parameters = Vector.asSlice<Shared<Type>>(&signature.parameters)
      if parameters.length != usize.ONE || !Shared.with<Type, bool>(&parameters[0], borrowIsStatic) { return false }
      if let Option<Intersection>.Some {value: environment} = &signature.environment {
        let members = Vector.asSlice<LifetimeMember>(&environment.members)
        return members.length == usize.ZERO
      }
    }
  }
  return false
}

effect fn witnessCallerAndRowClaims(semantic: &mut Semantic, request: &mut Request, index: &mut SourceIndex,
  entry: &ModuleId, inline: &SpecializationApplication, enclosing: &DeclarationId) -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> ? &mut Allocator {
  let maker = run requireIndexedIdentity(&mut index.*, entry, OwnerKind.Struct, b"Maker", usize.ZERO)
  let provider = run specializationNominal(&maker, Vector.make<Argument>())
  let scoped = run requireIndexedIdentity(&mut index.*, entry, OwnerKind.Function, b"scoped", usize.ZERO)
  let operation = run requireIndexedIdentity(&mut index.*, entry, OwnerKind.Function, b"make", usize.ZERO)
  let abstractOwn = [Argument.Type {value: run specializationParameter(&scoped, usize.ZERO)}]
  let mut abstractCaller = run specializationWithArguments(&scoped, run copyGenericArguments(&abstractOwn))
  run Vector.append<ScopeBinding>(&mut abstractCaller.scopes, run specializationScope(enclosing, run specializationParameter(enclosing, usize.ZERO)))
  let header = run Semantic.specializeSignature(&mut semantic.*, &mut request.*, &abstractCaller, entry, Span.make(usize.ZERO, usize.ONE))
  let declared = Shared.with<Result<Answer, NoRejection>, Option<Constraint>>(&header,
    fn(answer: &Result<Answer, NoRejection>) -> Option<Constraint> { return boundAt(answer, usize.ZERO) })
  let own = [Argument.Type {value: Shared.clone<Type>(&provider)}]
  let mut caller = run specializationWithArguments(&scoped, run copyGenericArguments(&own))
  run Vector.append<ScopeBinding>(&mut caller.scopes, run specializationScope(enclosing, run specializationPrimitive(b"i32")))
  if let Option<Constraint>.Some {value: Constraint.Conforms {provider: abstractProvider, contract}} = move declared {
    run Testing.expect(Type.occurrences(&abstractProvider, &scoped, usize.ZERO) == usize.ONE
      && Type.occurrences(&contract, enclosing, usize.ZERO) == usize.ONE, "source header retains colliding caller own and actual impl scope ordinals")
    let mapped = run Semantic.specializeInterfaceCall(&mut semantic.*, &mut request.*, &contract, &abstractProvider, &operation,
      &caller, entry, Span.make(usize.ZERO, usize.ONE))
    if let Result<SpecializationApplication, Shared<Rejection>>.Success {value} = move mapped {
      run Testing.expect(run SpecializationApplication.equals(&value, inline), "complete scoped caller applies both actual owners through the production mapping API")
    } else { run Testing.expect(false, "scoped caller maps its concrete contract and provider") }
  } else { run Testing.expect(false, "scoped caller has a declared source conformance") }
  let exposed = run requireIndexedIdentity(&mut index.*, entry, OwnerKind.Function, b"exposed", usize.ZERO)
  let application = run specializationWithArguments(&exposed, run copyGenericArguments(&own))
  let signature = run Semantic.specializeSignature(&mut semantic.*, &mut request.*, &application, entry, Span.make(usize.ZERO, usize.ONE))
  let result = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(&signature, signatureResult)
  let parameter = move slotOf(&signature, usize.ZERO)
  let mut privateAllowed = false
  if let Option<Shared<Type>>.Some {value} = move result {
    if let Option<Shared<Type>>.Some {value: input} = move parameter {
      let resultMatches = run Type.equalsShared(&value, &provider)
      let inputMatches = run Type.equalsShared(&input, &provider)
      privateAllowed = resultMatches && inputMatches
    }
  }
  run Testing.expect(privateAllowed, "caller-local public generic instantiation may use a private nominal without publishing it")
  let rows = run requireIndexedIdentity(&mut index.*, entry, OwnerKind.Function, b"rows", usize.ZERO)
  let rowOwner = run requireIndexedIdentity(&mut index.*, entry, OwnerKind.Implementation, b"", 4)
  let clock = run requireIndexedIdentity(&mut index.*, entry, OwnerKind.Service, b"Clock", usize.ZERO)
  let logger = run requireIndexedIdentity(&mut index.*, entry, OwnerKind.Service, b"Logger", usize.ZERO)
  let mut ownRow = Row.empty()
  run Row.require(&mut ownRow, Requirement {capability: run specializationNominal(&clock, Vector.make<Argument>()), roleType: Option.none<Shared<Type>>(), access: Access.Shared})
  let mut scopeRow = Row.empty()
  run Row.require(&mut scopeRow, Requirement {capability: run specializationNominal(&logger, Vector.make<Argument>()), roleType: Option.none<Shared<Type>>(), access: Access.Mutable})
  let ownShared = run Shared.make<Row>(move ownRow)
  let scopeShared = run Shared.make<Row>(move scopeRow)
  let ownRows = [Argument.Row {value: Shared.clone<Row>(&ownShared)}]
  let scopedRows = [Argument.Row {value: Shared.clone<Row>(&scopeShared)}]
  let mut rowApplication = run specializationWithArguments(&rows, run copyGenericArguments(&ownRows))
  run Vector.append<ScopeBinding>(&mut rowApplication.scopes, ScopeBinding {owner: run Shared.make<DeclarationId>(run DeclarationId.copy(&rowOwner)),
    arguments: run copyGenericArguments(&scopedRows), argumentOrdinals: run SpecializationApplication.denseOrdinals(usize.ONE)})
  let rowSignature = run Semantic.specializeSignature(&mut semantic.*, &mut request.*, &rowApplication, entry, Span.make(usize.ZERO, usize.ONE))
  let mut expected = Row.empty()
  run Row.merge(&mut expected, &ownShared)
  run Row.merge(&mut expected, &scopeShared)
  let expectedShared = run Shared.make<Row>(move expected)
  let requirements = Shared.with<Result<Answer, NoRejection>, Option<Shared<Row>>>(&rowSignature, signatureRequirements)
  let input = slotOf(&rowSignature, usize.MAX)
  let mut rowsMatch = false
  if let Option<Shared<Row>>.Some {value: found} = move requirements {
    if let Option<Shared<Type>>.Some {value: parameterType} = move input {
      let nested = Shared.with<Type, Option<Shared<Row>>>(&parameterType, effectRequirements)
      if let Option<Shared<Row>>.Some {value: nestedRow} = move nested {
        let outerMatches = run Row.equalsShared(&found, &expectedShared)
        let nestedMatches = run Row.equalsShared(&nestedRow, &expectedShared)
        rowsMatch = outerMatches && nestedMatches
      }
    }
  }
  run Testing.expect(rowsMatch, "colliding own and scope row ordinals substitute distinct services in nested Effect and signature requirements")
  return ()
}

effect fn witnessLifetimeClaims(semantic: &mut Semantic, request: &mut Request, index: &mut SourceIndex, entry: &ModuleId) -> ()
! CanonicalizationFailure | InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> ? &mut Allocator {
  let maker = run requireIndexedIdentity(&mut index.*, entry, OwnerKind.Struct, b"Maker", usize.ZERO)
  let provider = run specializationNominal(&maker, Vector.make<Argument>())
  let contractId = run requireIndexedIdentity(&mut index.*, entry, OwnerKind.Interface, b"Regional", usize.ZERO)
  let operation = run requireIndexedIdentity(&mut index.*, entry, OwnerKind.Function, b"regionMake", usize.ZERO)
  let target = run requireIndexedIdentity(&mut index.*, entry, OwnerKind.Function, b"regionMake", usize.ONE)
  let implOwner = run requireIndexedIdentity(&mut index.*, entry, OwnerKind.Implementation, b"", 3)
  let callerId = run requireIndexedIdentity(&mut index.*, entry, OwnerKind.Function, b"lifetime", usize.ZERO)
  let actual = [Argument.Lifetime {value: run Shared.make<Lifetime>(Lifetime.Static)}]
  let caller = run specializationWithArguments(&callerId, run copyGenericArguments(&actual))
  let mut direct = run specializationWithArguments(&target, Vector.make<Argument>())
  run Vector.append<ScopeBinding>(&mut direct.scopes, ScopeBinding {owner: run Shared.make<DeclarationId>(run DeclarationId.copy(&implOwner)),
    arguments: run copyGenericArguments(&actual), argumentOrdinals: run SpecializationApplication.denseOrdinals(usize.ONE)})
  let accepted = run Semantic.validateApplication(&mut semantic.*, &mut request.*, &direct, entry, Span.make(usize.ZERO, usize.ONE))
  run Testing.expect(matchesApplication(&accepted, &target), "independent direct lifetime environment has exact lexical impl slots")
  let contractArguments = [Argument.Lifetime {value: run specializationLifetime(&callerId, usize.ZERO)}]
  let abstractContract = run specializationNominal(&contractId, run copyGenericArguments(&contractArguments))
  let contract = run specializationNominal(&contractId, run copyGenericArguments(&actual))
  let concreteId = run requireIndexedIdentity(&mut index.*, entry, OwnerKind.Function, b"concrete", usize.ZERO)
  let concreteCaller = run specializationWithArguments(&concreteId, Vector.make<Argument>())
  let mapped = run Semantic.specializeInterfaceCall(&mut semantic.*, &mut request.*, &contract, &provider, &operation, &concreteCaller, entry, Span.make(usize.ZERO, usize.ONE))
  let scoped = run Semantic.specializeInterfaceCall(&mut semantic.*, &mut request.*, &abstractContract, &provider, &operation, &caller, entry, Span.make(usize.ZERO, usize.ONE))
  if let Result<SpecializationApplication, Shared<Rejection>>.Success {value} = move mapped {
    run Testing.expect(run SpecializationApplication.equals(&value, &direct), "proof-supplied static lifetime reaches the exact witness scope before runtime erasure")
    if let Result<SpecializationApplication, Shared<Rejection>>.Success {value: fromCaller} = move scoped {
      run Testing.expect(run SpecializationApplication.equals(&fromCaller, &direct), "complete caller lifetime composition reaches the same semantic witness application")
    } else { run Testing.expect(false, "caller lifetime specialization proves its concrete goal") }
    let effective = run Semantic.specializeSignature(&mut semantic.*, &mut request.*, &value, entry, Span.make(usize.ZERO, usize.ONE))
    run Testing.expect(Shared.with<Result<Answer, NoRejection>, bool>(&effective, signatureStringIsStatic), "effective witness signature uses string static validity")
    let directKey = run requiredCanonicalKey(run InstanceKey.function(run SpecializationApplication.copy(&direct)))
    let witnessKey = run requiredCanonicalKey(run InstanceKey.function(run SpecializationApplication.copy(&value)))
    let directSymbol = run InstanceKey.runtimeName(&directKey)
    let witnessSymbol = run InstanceKey.runtimeName(&witnessKey)
    run Testing.expect(InstanceKey.sameRuntimeBase(&directKey, &witnessKey) && sameBytes(Bytes.asSlice(&directSymbol), Bytes.asSlice(&witnessSymbol)), "validity-composed direct and witness erased family keys and names agree")
  } else { run Testing.expect(false, "independent concrete lifetime goal has a witness") }
  let mut recipe = run SpecializationApplication.copy(&direct)
  let mut scopes = Vector.asMutSlice<ScopeBinding>(&mut recipe.scopes)
  Vector.set<Argument>(&mut scopes[0].arguments, usize.ZERO, Argument.Lifetime {value: run specializationLifetime(&callerId, usize.ZERO)})
  let composed = run SpecializationApplication.substitute(&recipe, &caller)
  run Testing.expect(run SpecializationApplication.equals(&composed, &direct), "recorded application lifetime recipes consume complete caller bindings")
  let capture = run requireIndexedIdentity(&mut index.*, entry, OwnerKind.Function, b"capture", usize.ZERO)
  let captured = run specializationWithArguments(&capture, run copyGenericArguments(&actual))
  let effective = run Semantic.specializeSignature(&mut semantic.*, &mut request.*, &captured, entry, Span.make(usize.ZERO, usize.ONE))
  run Testing.expect(Shared.with<Result<Answer, NoRejection>, bool>(&effective, signatureEnvironmentIsStatic), "generated input and effect environment lifetimes consume the same supplied validity")
  return ()
}

test effect fn witnessApplicationUsesRootProofAndCallerFailureSite() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run witnessRootProofClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn witnessRootProofClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator {
  let library = run module("evidence.silk")
  let caller = run module("witness-caller.silk")
  let librarySource = run present("""
pub interface Leaf { fn leaf(value: Self) -> i32 }
pub interface Make { fn make(value: Self) -> i32 }
pub struct Good {}
pub struct Missing {}
pub struct Box<T> { value: T }
impl Leaf for Good { fn leaf(value: Self) -> i32 { return missing } }
impl<T: Leaf> Make for Box<T> { fn make(value: Self) -> i32 { return missing } }
""")
  let callerSource = run present("""
import evidence { Make, Box, Good, Missing }
fn bounded<P: Make>(value: P) -> i32 { return Make.make(move value) }
fn concrete(value: Box<Good>) -> i32 { return Make.make(move value) }
fn absent(value: Box<Missing>) -> i32 { return 0 }
""")
  let revision = run Revision.publish(&Revision.make(), &library, &librarySource)
  let current = run Revision.publish(&revision, &caller, &callerSource)
  let mut semantic = makeSemantic(run Revision.copy(&current))
  let mut index = SourceIndex.make(move current)
  let mut request = Request.make()
  let body = run Semantic.demandBody(&mut semantic, &mut request, &caller, b"bounded")
  let concreteBody = run Semantic.demandBody(&mut semantic, &mut request, &caller, b"concrete")
  let inputs = Shared.with<Result<Answer, NoRejection>, Option<WitnessCallInputs>>(&body, witnessCallInputs)
  let owner = run requireIndexedIdentity(&mut index, &caller, OwnerKind.Function, b"bounded", usize.ZERO)
  let concreteOwner = run requireIndexedIdentity(&mut index, &caller, OwnerKind.Function, b"concrete", usize.ZERO)
  // Occurrence zero is the interface operation; occurrence one is the root impl member.
  let target = run requireIndexedIdentity(&mut index, &library, OwnerKind.Function, b"make", usize.ONE)
  let operation = run requireIndexedIdentity(&mut index, &library, OwnerKind.Function, b"make", usize.ZERO)
  let concrete = run Semantic.demandSignature(&mut semantic, &mut request, &caller, b"concrete")
  let absent = run Semantic.demandSignature(&mut semantic, &mut request, &caller, b"absent")
  if let Option<WitnessCallInputs>.Some {value: call} = move inputs {
    let bodies = starts(Semantic.eventLog(&semantic), Family.Body)
    if let Option<Shared<Type>>.Some {value} = move slotOf(&concrete, usize.ZERO) {
      let arguments = [Argument.Type {value: move value}]
      let application = run mappedCallOf(&mut semantic, &mut request, &caller, &owner, &operation, &body, &arguments, false)
      let none = Vector.make<Argument>()
      let selected = run mappedCallOf(&mut semantic, &mut request, &caller, &concreteOwner, &operation, &concreteBody,
        Vector.asSlice<Argument>(&none), true)
      run Testing.expect(run SpecializationApplication.equals(&application, &selected),
        "typing-selected concrete and declared-bound calls map to the same root witness application")
      run Testing.expect(DeclarationId.equals(SpecializationApplication.bodyDeclaration(&application), &target),
        "a conditional proof selects the root Make witness after proving the distinct Leaf child head")
    } else { run Testing.expect(false, "conditional proof has a concrete provider") }
    if let Option<Shared<Type>>.Some {value} = move slotOf(&absent, usize.ZERO) {
      let arguments = [Argument.Type {value: move value}]
      let failedEnvironment = run specializationWithArguments(&owner, run copyGenericArguments(&arguments))
      let failed = run Semantic.specializeInterfaceCall(&mut semantic, &mut request, &call.contract, &call.provider,
        &operation, &failedEnvironment, &caller, call.span)
      let anchored = match &failed {
        Result<SpecializationApplication, Shared<Rejection>>.Failure {error} => Shared.with<Rejection, bool>(&error,
          fn(diagnostic: &Rejection) -> bool {
            return diagnostic.code == RejectionCode.MissingConformance && ModuleId.equals(&diagnostic.module, &caller)
              && diagnostic.span.start == call.span.start && diagnostic.span.end == call.span.end
          })
        _ => false
      }
      run Testing.expect(anchored, "failed conditional specialization retains the caller module and exact call span")
    } else { run Testing.expect(false, "failed conditional proof has a concrete provider") }
    let retained = Shared.with<Type, bool>(&call.provider, fn(ty: &Type) -> bool {
      return match &ty.* {
        Type.Parameter {declaration, ordinal} => ordinal == usize.ZERO && DeclarationId.equals(&declaration, &owner)
        _ => false
      }
    })
    run Testing.expect(retained && starts(Semantic.eventLog(&semantic), Family.Body) == bodies && bodies == 2,
      "proof success and failure retain the checked caller binder owner and read no target body")
  } else { run Testing.expect(false, "imported abstract interface call is checked") }
  return ()
}

test effect fn witnessOwnBinders() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run witnessOwnBinderClaims()
    |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn witnessOwnBinderClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator {
  let module = run module("wbinders.silk")
  let text = "interface Plain {\n  fn plain(value: Self) -> i32\n}\nstruct Extra {}\nimpl Plain for Extra {\n  fn plain<T>(value: Self) -> i32 { return 0 }\n}\ninterface Display {\n  fn display(value: Self) -> i32\n}\nstruct View<'a> { value: &'a i32 }\nimpl Display for View {\n  fn display(value: Self) -> i32 { return 0 }\n}\ninterface Show {}\ninterface Bound {\n  fn use<U: Show>(value: U) -> i32\n}\nstruct Candidate {}\nimpl Bound for Candidate {\n  fn use<T: Show>(value: T) -> i32 { return 0 }\n}\nservice Clock {}\ninterface Rowed {\n  effect<'static> fn load<?R>(value: Self) -> i32 ? &mut Clock | R\n}\nstruct Reader {}\nimpl Rowed for Reader {\n  effect<'static> fn load<?W>(value: Self) -> i32 ? &Clock | W { return 0 }\n}\ninterface Carry<'a> {\n  effect<'a> fn carry(value: Self) -> i32\n}\nstruct Stored<'a> { value: &'a i32 }\nimpl<'a> Carry<'a> for Stored<'a> {\n  effect<'w> fn carry<'w>(value: Self) -> i32 { return 0 }\n}\ninterface TwoEnv<'a, 'b> {\n  effect<'a & 'b> fn hold(value: Self) -> i32\n}\nstruct PairStored<'a, 'b> { first: &'a i32, second: &'b i32 }\nimpl<'a, 'b> TwoEnv<'a, 'b> for PairStored<'a, 'b> {\n  effect<'w> fn hold<'w>(value: Self) -> i32 { return 0 }\n}\n"
  let source = run present(text)
  let revision = run Revision.publish(&Revision.make(), &module, &source)
  let mut semantic = makeSemantic(run Revision.copy(&revision))
  let mut index = SourceIndex.make(run Revision.copy(&revision))
  let mut request = Request.make()
  let unused = run witnessesOf(&mut semantic, &mut request, &mut index, &module, 0)
  let headLifetime = run witnessesOf(&mut semantic, &mut request, &mut index, &module, 1)
  let alphaBound = run witnessesOf(&mut semantic, &mut request, &mut index, &module, 2)
  let row = run witnessesOf(&mut semantic, &mut request, &mut index, &module, 3)
  let environment = run witnessesOf(&mut semantic, &mut request, &mut index, &module, 4)
  let intersection = run witnessesOf(&mut semantic, &mut request, &mut index, &module, 5)
  run Testing.expect(
    rejectsFrom(&unused, RejectionCode.Unsupported, offsetOf(text, "fn plain<T>", 0)),
    "an unbound witness-owned type parameter never publishes witness arguments",
  )
  run Testing.expect(succeeded(&headLifetime), "a generated lifetime in the implementation head remains in scope")
  run Testing.expect(
    succeeded(&alphaBound) && witnessArgumentCount(&alphaBound) == usize.ONE,
    "the operation's own bound implies the matched witness bound and records its argument",
  )
  run Testing.expect(
    succeeded(&row) && witnessArgumentCount(&row) == usize.ONE,
    "a fixed shared requirement is covered by the promised mutable requirement while the open witness row binds to the promised row",
  )
  run Testing.expect(
    succeeded(&environment) && witnessArgumentCount(&environment) == usize.ONE,
    "a witness-owned lifetime used only by its effect environment matches the promised region",
  )
  run Testing.expect(
    rejectsFrom(&intersection, RejectionCode.Unsupported, offsetOf(text, "effect<'w> fn hold<'w>", 0)),
    "an environment intersection does not bind a free witness lifetime by positional guessing",
  )
  return ()
}

// Lent witness borrows are claims independent of witness binder scope, so they keep their own
// fixture: the two tests share no declarations.
test effect fn witnessLentBorrowsStayScoped() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run witnessLentBorrowClaims()
    |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn witnessLentBorrowClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator {
  let module = run module("wlent.silk")
  let text = "interface Lend {\n  fn take(value: Self) -> i32\n}\nstruct Borrow {}\nimpl Lend for Borrow {\n  fn take(value: &Self) -> i32 { return 0 }\n}\ninterface Peek {\n  fn peek(value: Self) -> &'static Self\n}\nstruct Leaker {}\nimpl Peek for Leaker {\n  fn peek(value: &Self) -> &Self { return () }\n}\ninterface Later {\n  fn later(value: Self) -> Effect<'static; i32>\n}\nstruct Deferred {}\nimpl Later for Deferred {\n  fn later<'a>(value: &'a Self) -> Effect<'a; i32> { return () }\n}\ninterface Repeat {\n  fn repeat(value: Self, other: &'static Self) -> i32\n}\nstruct Reused {}\nimpl Repeat for Reused {\n  fn repeat<'a>(value: &'a Self, other: &'a Self) -> i32 { return 0 }\n}\ninterface StaticTake {\n  fn take(value: Self) -> i32\n}\nstruct Fixed {}\nimpl StaticTake for Fixed {\n  fn take(value: &'static Self) -> i32 { return 0 }\n}\n"
  let source = run present(text)
  let revision = run Revision.publish(&Revision.make(), &module, &source)
  let mut semantic = makeSemantic(run Revision.copy(&revision))
  let mut index = SourceIndex.make(run Revision.copy(&revision))
  let mut request = Request.make()
  let lent = run witnessesOf(&mut semantic, &mut request, &mut index, &module, 0)
  let escaped = run witnessesOf(&mut semantic, &mut request, &mut index, &module, 1)
  let nested = run witnessesOf(&mut semantic, &mut request, &mut index, &module, 2)
  let reused = run witnessesOf(&mut semantic, &mut request, &mut index, &module, 3)
  let fixed = run witnessesOf(&mut semantic, &mut request, &mut index, &module, 4)
  run Testing.expect(
    succeeded(&lent) && witnessArgumentCount(&lent) == usize.ONE,
    "an owned contract operand can be lent to an elided witness borrow with a recorded lifetime",
  )
  run Testing.expect(
    rejectsWitness(&escaped, offsetOf(text, "fn peek(value: &Self)", 0), 9, usize.MAX),
    "a lent borrow cannot escape through the witness result",
  )
  run Testing.expect(
    rejectsWitness(&nested, offsetOf(text, "fn later<'a>", 0), 9, usize.MAX),
    "a lent borrow cannot escape through a returned Effect environment",
  )
  run Testing.expect(
    rejectsWitness(&reused, offsetOf(text, "fn repeat<'a>", 0), 8, 1),
    "a lent borrow cannot be reused by another operand",
  )
  run Testing.expect(
    rejectsWitness(&fixed, offsetOf(text, "fn take(value: &'static Self)", 0), 8, 0),
    "a fixed lifetime cannot stand in for a witness-owned lent borrow",
  )
  return ()
}

fn witnessArgumentCount(answer: &Shared<Result<Answer, NoRejection>>) -> usize {
  return Shared.with<Result<Answer, NoRejection>, usize>(
    answer,
    fn(resolved: &Result<Answer, NoRejection>) -> usize {
      if let Result<Answer, NoRejection>.Success {value} = &resolved.* {
        if let Outcome.Success {value: Value.Witnesses {witnesses}} = &value.outcome {
          let entries = Vector.asSlice<Witness>(&witnesses)
          if entries.length > usize.ZERO {
            return Vector.length<Argument>(&entries[usize.ZERO].arguments)
          }
        }
      }
      return usize.MAX
    },
  )
}

// The witnesses of the `occurrence`th implementation of a module.
effect fn witnessesOf(
  semantic: &mut Semantic,
  request: &mut Request,
  index: &mut SourceIndex,
  module: &ModuleId,
  occurrence: usize,
) -> Shared<Result<Answer, NoRejection>>
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator {
  let implementation = run requireIndexedIdentity(&mut index.*, module, OwnerKind.Implementation, b"", occurrence)
  return run Semantic.demandWitnesses(&mut semantic.*, &mut request.*, &implementation)
}

// Position of a component in `WitnessProblem`'s declaration order.
fn problemOrdinal(problem: &WitnessProblem) -> usize {
  return match & problem.* {
    WitnessProblem.Missing => 0
    WitnessProblem.Unknown => 1
    WitnessProblem.ScalarMapping => 2
    WitnessProblem.Kind => 3
    WitnessProblem.Safety => 4
    WitnessProblem.OperandCount => 5
    WitnessProblem.OperandAccess {..} => 6
    WitnessProblem.OperandShape {..} => 7
    WitnessProblem.OperandType {..} => 8
    WitnessProblem.ResultType => 9
    WitnessProblem.Failure => 10
    WitnessProblem.Requirement => 11
    WitnessProblem.RequirementAccess => 12
    WitnessProblem.RequirementParameter => 13
    WitnessProblem.Environment => 14
  }
}

fn problemOperand(problem: &WitnessProblem) -> usize {
  return match & problem.* {
    WitnessProblem.OperandAccess {operand} => operand
    WitnessProblem.OperandShape {operand} => operand
    WitnessProblem.OperandType {operand} => operand
    _ => usize.MAX
  }
}

// An `IncompatibleWitness` rejection at `start` naming the component and, for an operand, its position.
fn rejectsWitness(answer: &Shared<Result<Answer, NoRejection>>, start: usize, problem: usize, operand: usize) -> bool {
  if !rejectsFrom(answer, RejectionCode.IncompatibleWitness, start) {
    return false
  }
  let found = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(answer, rejection)
  if let Option<Shared<Rejection>>.Some {value} = move found {
    return Shared.with<Rejection, bool>(
      &value,
      fn(diagnostic: &Rejection) -> bool {
        if let Option<WitnessProblem>.Some {value: named} = &diagnostic.witness {
          return problemOrdinal(&named) == problem && problemOperand(&named) == operand
        }
        return false
      },
    )
  }
  return false
}

// Two witnesses in operation order: `decode` inline, then `width` mapped to `schemaWidth`.
fn inlineThenMappedWitnesses(answer: &Result<Answer, NoRejection>) -> bool {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Witnesses {witnesses}} = &value.outcome {
      let listed = Vector.asSlice<Witness>(&witnesses)
      if listed.length != 2 {
        return false
      }
      return spelledAs(&listed[0].operation, b"decode") && spelledAs(&listed[0].implementation, b"decode") && spelledAs(
        &listed[1].operation,
        b"width",
      ) && spelledAs(&listed[1].implementation, b"schemaWidth")
    }
  }
  return false
}

fn spelledAs(identity: &Shared<DeclarationId>, name: &[u8]) -> bool {
  return Shared.with<DeclarationId, bool>(
    identity,
    fn(declaration: &DeclarationId) -> bool {
      return sameBytes(DeclarationId.spelling(declaration), name)
    },
  )
}

// The promised `load` keeps its `LoadError` failure and one `Clock` requirement.
fn promisesLoadChannels(answer: &Result<Answer, NoRejection>) -> bool {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Signature {signature}} = &value.outcome {
      let failure = Shared.with<Type, bool>(
        &signature.failure,
        fn(ty: &Type) -> bool {
          return match & ty.* {
            Type.Nominal {..} => true
            _ => false
          }
        },
      )
      let entries = Shared.with<Row, usize>(
        &signature.requirements,
        fn(row: &Row) -> usize {
          return Vector.length<Requirement>(&row.entries)
        },
      )
      return signature.isEffect && failure && entries == 1
    }
  }
  return false
}

test effect fn intrinsicPropertiesAndSealedNamespace() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let entry = run module("intrinsics.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
effect fn detached<A, F: once Effect<A> + Intrinsic.Detached>(pending: F) -> A { return run pending }
effect fn attached<A, F: once Effect<A>>(pending: F) -> A { return run pending }
fn nonParking<F: fn<'static>(i32) -> i32 + Intrinsic.NonParking>(callback: F) -> i32 { return 0 }
fn plainDetached<T: Intrinsic.Detached>(value: T) -> i32 { return 0 }
fn execution(value: Intrinsic.Execution<i32>) -> i32 { return 0 }
fn unknownFamily<T: Intrinsic.Replace>(value: T) -> i32 { return 0 }
struct Intrinsic {}
pub struct Plain {}
fn usesReserved(value: Intrinsic) -> i32 { return 0 }
struct Holds {
  execution: Intrinsic.Execution<i32>
}
fn holds() -> Holds { return () }
"""
  let aliased = run module("aliased.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let namespaced = run module("namespaced.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let aliasedText = """
import intrinsics { Plain as Intrinsic }
fn viaAlias(value: Intrinsic) -> i32 { return 0 }
"""
  let namespacedText = """
import intrinsics as Intrinsic
fn viaNamespace(value: Intrinsic.Plain) -> i32 { return 0 }
impl Intrinsic {
  fn reopened() -> i32 { return 0 }
}
fn calls() -> i32 { return Intrinsic.replace(1, 2) }
"""
  let source = run present(text)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let aliasedSource = run present(aliasedText)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let namespacedSource = run present(namespacedText)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let withEntry = run Revision.publish(&Revision.make(), &entry, &source)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let withAliased = run Revision.publish(&withEntry, &aliased, &aliasedSource)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&withAliased, &namespaced, &namespacedSource)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut semantic = makeSemantic(
    run Revision.copy(&revision)
      |> Effect.provideMut<Allocator>(&mut allocator),
  )
  let mut request = Request.make()
  let mut index = SourceIndex.make(run Revision.copy(&revision) |> Effect.provideMut<Allocator>(&mut allocator))
  let detached = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"detached")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let attached = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"attached")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let detachedStatic = Shared.with<Result<Answer, NoRejection>, bool>(&detached, staticEnvironment)
  let attachedStatic = Shared.with<Result<Answer, NoRejection>, bool>(&attached, staticEnvironment)
  let detachedRecorded = Shared.with<Result<Answer, NoRejection>, bool>(
    &detached,
    fn(answer: &Result<Answer, NoRejection>) -> bool {
      return recordsProperty(answer, IntrinsicProperty.Detached)
    },
  )
  run Testing.expect(
    detachedStatic && !attachedStatic && detachedRecorded,
    "a Detached representation retains no region in an effect environment, unlike an ordinary one",
  )
  let nonParking = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"nonParking")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let plainDetached = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"plainDetached")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let nonParkingRecorded = Shared.with<Result<Answer, NoRejection>, bool>(
    &nonParking,
    fn(answer: &Result<Answer, NoRejection>) -> bool {
      return recordsProperty(answer, IntrinsicProperty.NonParking)
    },
  )
  let plainRecorded = Shared.with<Result<Answer, NoRejection>, bool>(
    &plainDetached,
    fn(answer: &Result<Answer, NoRejection>) -> bool {
      return recordsProperty(answer, IntrinsicProperty.Detached)
    },
  )
  run Testing.expect(
    nonParkingRecorded && plainRecorded,
    "sealed properties are recorded as witness-free bounds without an interface or proof",
  )
  let execution = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"execution")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let unknownFamily = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"unknownFamily")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let reserved = run Semantic.demandIdentity(&mut semantic, &mut request, &entry, b"Intrinsic")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let executionAt = rejectsFrom(&execution, RejectionCode.CoreTypeUnavailable, offsetOf(text, "Intrinsic.Execution", 0))
  let familyAt = rejectsFrom(&unknownFamily, RejectionCode.Unsupported, offsetOf(text, "Intrinsic.Replace", 0))
  let reservedAt = rejectsAt(&reserved, RejectionCode.Collision)
  run Testing.expect(
    executionAt && familyAt && reservedAt,
    "catalog intrinsic families are the named core-type deferral, unknown ones unsupported, and no declaration can claim the sealed name",
  )
  let usesReserved = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"usesReserved")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let viaAlias = run Semantic.demandSignature(&mut semantic, &mut request, &aliased, b"viaAlias")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let namespace = run Semantic.demandIdentity(&mut semantic, &mut request, &namespaced, b"Intrinsic")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    rejectsAt(&usesReserved, RejectionCode.Collision) && rejectsAt(&viaAlias, RejectionCode.Collision) && rejectsAt(
      &namespace,
      RejectionCode.Collision,
    ),
    "a declaration, member alias or namespace alias named Intrinsic collides wherever the binding is looked up",
  )
  let holds = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"holds")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let viaNamespace = run Semantic.demandSignature(&mut semantic, &mut request, &namespaced, b"viaNamespace")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let reopened = run signatureNamed(&mut semantic, &mut request, &mut index, &namespaced, b"reopened", 0)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let calls = run Semantic.demandBody(&mut semantic, &mut request, &namespaced, b"calls")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let fieldAt = rejectsFrom(&holds, RejectionCode.CoreTypeUnavailable, offsetOf(text, "Intrinsic.Execution", 1))
  let sealedAt = rejectsFrom(&viaNamespace, RejectionCode.Unsupported, offsetOf(namespacedText, "Intrinsic.Plain", 0))
  let reopenedAt = rejectsFrom(&reopened, RejectionCode.Unsupported, offsetOf(namespacedText, "Intrinsic {", 0))
  let callAt = rejectsSpan(&calls, RejectionCode.TypeMismatch, namespacedText, "Intrinsic.replace(1, 2)", usize.ZERO)
  run Testing.expect(
    fieldAt && sealedAt && reopenedAt && callAt,
    "Intrinsic paths in fields, types and calls never reach module lookup, and the namespace cannot be reopened",
  )
  return ()
}

test effect fn receiverLifetimeElisionPrefersTheAuthoredOuterBorrow() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run receiverLifetimeElisionClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn receiverLifetimeElisionClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> ? &mut Allocator {
  let id = run module("receiver-lifetime-elision.silk")
  let text = """
struct View<'data> { bytes: &'data [u8] }
struct Maybe<T> { value: T }
fn borrowed<'data>(self: &View<'data>, key: &[u8]) -> Maybe<&[u8]> {
  return Maybe<&[u8]> { value: self.bytes }
}
fn reordered<'data>(key: &[u8], self: &View<'data>) -> Maybe<&[u8]> {
  return Maybe<&[u8]> { value: self.bytes }
}
fn independent(first: &[u8], second: &[u8]) -> &u8 { return &first[0] }
fn absent() -> &i32 { return &42 }
fn explicit<'data, 'key>(self: &View<'data>, key: &'key [u8]) -> Maybe<&'key [u8]> {
  return Maybe<&'key [u8]> { value: key }
}
fn byValue<'data>(self: View<'data>, key: &[u8]) -> Maybe<&[u8]> {
  return Maybe<&[u8]> { value: key }
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let borrowed = run Semantic.demandSignature(&mut store, &mut request, &id, b"borrowed")
  let reordered = run Semantic.demandSignature(&mut store, &mut request, &id, b"reordered")
  let independent = run Semantic.demandSignature(&mut store, &mut request, &id, b"independent")
  let absent = run Semantic.demandSignature(&mut store, &mut request, &id, b"absent")
  let explicit = run Semantic.demandSignature(&mut store, &mut request, &id, b"explicit")
  let byValue = run Semantic.demandSignature(&mut store, &mut request, &id, b"byValue")
  run Testing.expect(signatureResultUsesInputRegion(&borrowed, usize.ZERO)
      && !signatureResultUsesInputRegion(&borrowed, usize.ONE)
      && Shared.with<Result<Answer, NoRejection>, usize>(&borrowed, lifetimeCountOf) == 3,
    "the receiver's outer borrow supplies the nested output region without merging its stored-data or key lifetimes")
  run Testing.expect(signatureResultUsesInputRegion(&reordered, usize.ONE)
      && !signatureResultUsesInputRegion(&reordered, usize.ZERO),
    "the authored name self selects the receiver default independently of parameter position")
  run Testing.expect(rejectsSpan(&independent, RejectionCode.AmbiguousLifetime, text, "&u8", usize.ZERO)
      && rejectsSpan(&absent, RejectionCode.AmbiguousLifetime, text, "&i32", usize.ZERO),
    "two non-receiver borrowed inputs and no borrowed inputs keep exact ambiguous output diagnostics")
  run Testing.expect(signatureResultUsesInputRegion(&explicit, usize.ONE)
      && !signatureResultUsesInputRegion(&explicit, usize.ZERO),
    "an explicit output lifetime keeps the key relationship instead of taking the receiver default")
  run Testing.expect(signatureResultUsesInputRegion(&byValue, usize.ONE),
    "a by-value receiver's stored view gives no outer borrow default, so the sole borrowed input supplies it")
}

// Inspect the written region, including the one type argument of this fixture's Maybe wrapper.
fn signatureBorrowRegion(value: &Type) -> Option<Shared<Lifetime>> {
  return match &value.* {
    Type.Reference {lifetime, ..} => Option.some<Shared<Lifetime>>(Shared.clone<Lifetime>(&lifetime))
    Type.Slice {lifetime, ..} => Option.some<Shared<Lifetime>>(Shared.clone<Lifetime>(&lifetime))
    Type.Nominal {arguments, ..} => {
      let given = Vector.asSlice<Argument>(&arguments)
      if given.length == usize.ONE {
        if let Argument.Type {value: argument} = &given[usize.ZERO] {
          return Shared.with<Type, Option<Shared<Lifetime>>>(&argument, signatureBorrowRegion)
        }
      }
      return Option.none<Shared<Lifetime>>()
    }
    _ => Option.none<Shared<Lifetime>>()
  }
}

fn signatureResultUsesInputRegion(answer: &Shared<Result<Answer, NoRejection>>, input: usize) -> bool {
  let parameter = slotOf(answer, input)
  let result = slotOf(answer, usize.MAX)
  if let Option<Shared<Type>>.Some {value: from} = move parameter {
    if let Option<Shared<Type>>.Some {value: to} = move result {
      let first = Shared.with<Type, Option<Shared<Lifetime>>>(&from, signatureBorrowRegion)
      let second = Shared.with<Type, Option<Shared<Lifetime>>>(&to, signatureBorrowRegion)
      if let Option<Shared<Lifetime>>.Some {value: source} = move first {
        if let Option<Shared<Lifetime>>.Some {value: target} = move second {
          return Lifetime.equalsShared(&source, &target)
        }
      }
    }
  }
  return false
}

test effect fn referenceModifiersAndLifetimeIdentities() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let entry = run module("views.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let source = run present(
    "type Ref<'a, T> = &'a T\ntype Borrow = &i32\nstruct View<'a, T> { value: &'a T }\nfn same<'a>(value: &'a i32) -> &'a i32 { return value }\nfn sameOther<'a>(value: &'a i32) -> &'a i32 { return value }\nfn different<'a>(value: &'a i32) -> &'static i32 { return value }\nfn alias<'a, T>(left: Ref<'a, T>, right: &'a T) -> &'a T { return right }\nfn aliasElided(value: Borrow) -> Borrow { return value }\nfn nominal<'a>(value: View<'a, i32>) -> View<'a, i32> { return value }\nfn implicit(value: &i32) -> &i32 { return value }\nfn separate(left: &i32, right: &i32) -> i32 { return 0 }\nfn ambiguous(left: &i32, right: &i32) -> &i32 { return left }\nfn unknown(value: &'missing i32) -> i32 { return 0 }\nfn duplicate<'a, 'a>(value: &'a i32) -> i32 { return 0 }\nfn reserved<'static>(value: &'static i32) -> i32 { return 0 }\nfn shared(value: &'static i32) -> &'static i32 { return value }\nfn exclusive(value: &'static mut i32) -> &'static mut i32 { return value }\nfn slice(value: &'static [i32]) -> &'static [i32] { return value }\nfn text(value: string<'static>) -> string<'static> { return value }\nfn pointer() -> *const i32 { return () }\nfn pointerAgain() -> *const i32 { return () }\nfn pointerMut() -> *mut i32 { return () }\nfn pointerNull() -> ?*const i32 { return () }\nfn pointerMany() -> [*]const i32 { return () }\nfn aligned() -> *const align(8) u8 { return () }\nfn alignedAgain() -> *const align(8) addrspace(0) u8 { return () }\nfn maxAlign() -> *const align(536870912) u8 { return () }\nfn tooLargeAlign() -> *const align(1073741824) u8 { return () }\nfn badAlign() -> *const align(3) u8 { return () }\nfn badSpace() -> *const addrspace(3) u8 { return () }\nfn namedPointer() -> *const View<'static, i32> { return () }\nfn missingPointer() -> *const Missing { return () }\n",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&Revision.make(), &entry, &source)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut semantic = makeSemantic(move revision)
  let mut request = Request.make()
  let same = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"same")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let sameOther = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"sameOther")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let different = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"different")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let alias = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"alias")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let aliasElided = run Semantic.demandSignature(
    &mut semantic,
    &mut request,
    &entry,
    b"aliasElided",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let nominal = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"nominal")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let implicit = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"implicit")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let separate = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"separate")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    (run signatureReferencesAgree(&same)
      |> Effect.provideMut<Allocator>(&mut allocator)) && !(run signatureReferencesAgree(&different)
      |> Effect.provideMut<Allocator>(&mut allocator)) && !(run resultEquals(&same, &sameOther)
      |> Effect.provideMut<Allocator>(&mut allocator)) && (run signatureArgumentsAgree(&alias)
      |> Effect.provideMut<Allocator>(&mut allocator)) && (run signatureReferencesAgree(&nominal)
      |> Effect.provideMut<Allocator>(&mut allocator)) && (run signatureReferencesAgree(
      &aliasElided,
    )
      |> Effect.provideMut<Allocator>(&mut allocator)) && (run signatureReferencesAgree(&implicit)
      |> Effect.provideMut<Allocator>(&mut allocator)) && (run signatureArgumentsDiffer(&separate)
      |> Effect.provideMut<Allocator>(&mut allocator)),
    "written and elided lifetimes keep their declaration-owned relationships",
  )
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(
      &alias,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return hasTypeLookup(answer, Family.Alias)
      },
    ) && Shared.with<Result<Answer, NoRejection>, bool>(
      &nominal,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return hasTypeLookup(answer, Family.Identity)
      },
    ),
    "view applications keep their alias and nominal dependencies",
  )
  let shared = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"shared")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let exclusive = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"exclusive")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let slice = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"slice")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let text = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"text")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let pointer = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"pointer")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let pointerAgain = run Semantic.demandSignature(
    &mut semantic,
    &mut request,
    &entry,
    b"pointerAgain",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let pointerMut = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"pointerMut")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let pointerNull = run Semantic.demandSignature(
    &mut semantic,
    &mut request,
    &entry,
    b"pointerNull",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let pointerMany = run Semantic.demandSignature(
    &mut semantic,
    &mut request,
    &entry,
    b"pointerMany",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let aligned = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"aligned")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let alignedAgain = run Semantic.demandSignature(
    &mut semantic,
    &mut request,
    &entry,
    b"alignedAgain",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let maxAlign = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"maxAlign")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(&shared, signatureSucceeded) && Shared.with<
      Result<Answer, NoRejection>,
      bool,
    >(&exclusive, signatureSucceeded) && Shared.with<Result<Answer, NoRejection>, bool>(
      &slice,
      signatureSucceeded,
    ) && Shared.with<Result<Answer, NoRejection>, bool>(&text, signatureSucceeded) && Shared.with<
      Result<Answer, NoRejection>,
      bool,
    >(&pointerMut, signatureSucceeded) && Shared.with<Result<Answer, NoRejection>, bool>(
      &pointerNull,
      signatureSucceeded,
    ) && Shared.with<Result<Answer, NoRejection>, bool>(&pointerMany, signatureSucceeded) && !(run resultEquals(
      &shared,
      &exclusive,
    )
      |> Effect.provideMut<Allocator>(&mut allocator)) && !(run resultEquals(&shared, &slice)
      |> Effect.provideMut<Allocator>(&mut allocator)) && !(run resultEquals(&slice, &text)
      |> Effect.provideMut<Allocator>(&mut allocator)) && (run resultEquals(&pointer, &pointerAgain)
      |> Effect.provideMut<Allocator>(&mut allocator)) && !(run resultEquals(&pointer, &pointerMut)
      |> Effect.provideMut<Allocator>(&mut allocator)) && !(run resultEquals(&pointer, &pointerNull)
      |> Effect.provideMut<Allocator>(&mut allocator)) && !(run resultEquals(&pointer, &pointerMany)
      |> Effect.provideMut<Allocator>(&mut allocator)) && (run resultEquals(&aligned, &alignedAgain)
      |> Effect.provideMut<Allocator>(&mut allocator)) && Shared.with<
      Result<Answer, NoRejection>,
      bool,
    >(&maxAlign, signatureSucceeded),
    "access, view form, pointer extent, nullability and alignment shape type identity",
  )
  let ambiguous = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"ambiguous")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let unknown = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"unknown")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let duplicate = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"duplicate")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let reserved = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"reserved")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let badAlign = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"badAlign")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let tooLargeAlign = run Semantic.demandSignature(
    &mut semantic,
    &mut request,
    &entry,
    b"tooLargeAlign",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let badSpace = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"badSpace")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let missingPointer = run Semantic.demandSignature(
    &mut semantic,
    &mut request,
    &entry,
    b"missingPointer",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(
      &ambiguous,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectedTypeApplication(answer, RejectionCode.AmbiguousLifetime)
      },
    ) && Shared.with<Result<Answer, NoRejection>, bool>(
      &unknown,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectedTypeApplication(answer, RejectionCode.UnknownLifetime)
      },
    ) && Shared.with<Result<Answer, NoRejection>, bool>(
      &duplicate,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectedTypeApplication(answer, RejectionCode.DuplicateLifetimeParameter)
      },
    ) && Shared.with<Result<Answer, NoRejection>, bool>(
      &reserved,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectedTypeApplication(answer, RejectionCode.InvalidLifetime)
      },
    ) && Shared.with<Result<Answer, NoRejection>, bool>(
      &badAlign,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectedTypeApplication(answer, RejectionCode.InvalidPointerQualifier)
      },
    ) && Shared.with<Result<Answer, NoRejection>, bool>(
      &tooLargeAlign,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectedTypeApplication(answer, RejectionCode.InvalidPointerQualifier)
      },
    ) && Shared.with<Result<Answer, NoRejection>, bool>(
      &badSpace,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectedTypeApplication(answer, RejectionCode.InvalidPointerQualifier)
      },
    ) && Shared.with<Result<Answer, NoRejection>, bool>(
      &missingPointer,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectedTypeApplication(answer, RejectionCode.UnknownName) && hasTypeLookup(
          answer,
          Family.Name,
        )
      },
    ),
    "invalid references, lifetime names and pointer qualifiers reject at written spans",
  )
  let namedPointer = run Semantic.demandSignature(
    &mut semantic,
    &mut request,
    &entry,
    b"namedPointer",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(
      &namedPointer,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return hasTypeLookup(answer, Family.Identity)
      },
    ),
    "a pointer's named pointee retains its transitive identity dependency",
  )
  return ()
}

fn signatureArrayExtent(answer: &Result<Answer, NoRejection>, digits: &[u8]) -> bool {
  let selected = signatureResult(answer)
  if let Option<Shared<Type>>.Some {value} = move selected {
    return Shared.with<Type, bool>(&value, fn(ty: &Type) -> bool {
      return match &ty.* {
        Type.Array {extent, ..} => sameBytes(Bytes.asSlice(&extent), digits)
        _ => false
      }
    })
  }
  return false
}

fn constantTrue(answer: &Result<Answer, NoRejection>) -> bool {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Initializer {value: found}} => Shared.with<StaticData, bool>(
        &found,
        fn(constant: &StaticData) -> bool {
          return match & constant.* {
            StaticData.Boolean {value: truth} => truth
            _ => false
          }
        },
      )
      _ => false
    }
    Result<Answer, NoRejection>.Failure {error: _} => false
  }
}

fn constantFloatBits(answer: &Result<Answer, NoRejection>, expected: StaticFloatType, bits: u64) -> bool {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Initializer {value: found}} => Shared.with<StaticData, bool>(
        &found,
        fn(constant: &StaticData) -> bool {
          return match & constant.* {
            StaticData.Float {ty, bits: actual} => ty == expected && actual == bits
            _ => false
          }
        },
      )
      _ => false
    }
    Result<Answer, NoRejection>.Failure {error: _} => false
  }
}

fn staticString(resolved: &Type) -> bool {
  return match & resolved.* {
    Type.String {lifetime} => Shared.with<Lifetime, bool>(
      &lifetime,
      fn(value: &Lifetime) -> bool {
        return match & value.* {
          Lifetime.Static => true
          _ => false
        }
      },
    )
    _ => false
  }
}

fn staticStringConstant(answer: &Result<Answer, NoRejection>) -> bool {
  let resolved = nominalResult(answer)
  if let Option<Shared<Type>>.Some {value} = move resolved {
    return Shared.with<Type, bool>(&value, staticString)
  }
  return false
}

effect fn initializerRejects(
  semantic: &mut Semantic,
  request: &mut Request,
  entry: &ModuleId,
  name: &[u8],
  code: RejectionCode,
) -> bool ! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch ? &mut Allocator {
  let answer = run Semantic.demandInitializer(&mut semantic.*, &mut request.*, entry, name)
  return Shared.with<Result<Answer, NoRejection>, bool>(
    &answer,
    fn(found: &Result<Answer, NoRejection>) -> bool {
      return rejectionCode(found, code)
    },
  )
}

fn cycleOfThree(answer: &Result<Answer, NoRejection>) -> bool {
  let found = rejection(answer)
  if let Option<Shared<Rejection>>.Some {value} = move found {
    return Shared.with<Rejection, bool>(&value, isCycle) && Shared.with<Rejection, usize>(
      &value,
      cyclePathLength,
    ) == 3
  }
  return false
}

fn dependsOnName(semantic: &Semantic, answer: &Result<Answer, NoRejection>, name: &[u8]) -> bool {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => {
      let edges = Vector.asSlice<Dependency>(&value.dependencies)
      let mut at = usize.ZERO
      while at < edges.length {
        if let Option<&[u8]>.Some {value: written} = move Semantic.dependencyName(semantic, &edges[at]) {
          if sameBytes(written, name) {
            return true
          }
        }
        at = at + usize.ONE
      }
      return false
    }
    Result<Answer, NoRejection>.Failure {error: _} => false
  }
}

fn dependsOnFamily(answer: &Result<Answer, NoRejection>, family: Family) -> bool {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => {
      let edges = Vector.asSlice<Dependency>(&value.dependencies)
      let mut at = usize.ZERO
      while at < edges.length {
        if edges[at].family == family { return true }
        at = at + usize.ONE
      }
      return false
    }
    Result<Answer, NoRejection>.Failure {error: _} => false
  }
}

effect fn constantClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator {
  let entry = run module("constants.silk")
  let library = run module("library.silk")
  let librarySource = run present("pub const base: u8 = 7\n")
  let first = run Revision.publish(&Revision.make(), &library, &librarySource)
  let written = """import library { base }
import library as Library
const limit: u8 = 255
const copied: u8 = limit
const imported: u8 = base
fn arrayFromImport() -> [u8; base] { return () }
fn arrayFromQualified() -> [u8; Library.base] { return () }
fn arithmeticExtent() -> [u8; 4294967296 + 1] { return () }
fn negativeArray() -> [u8; -1] { return () }
fn boolArray() -> [u8; true] { return () }
const first: i32 = second
const second: i32 = first
const flag: bool = true
const half: f32 = 1.5
const ratio: f64 = 1.5
const label: string = "x"
const wide: u8 = 256
const wrong: bool = 1
const mismatch: bool = limit
const pointer: &i32 = 1
const sized: usize = 1
fn helper() -> i32 { return 1 }
const called: i32 = helper()
static fn doubled(value: u32) -> u32 { return value + value }
const computed: u32 = doubled(3)
static fn abort() -> u32 { compileError("stop") }
const aborted: u32 = abort()
fn reads() -> u8 { return limit }
fn readsQualified() -> u8 { return Library.base }
fn readsRejected() -> bool { return mismatch }
fn absent() -> u8 { return nowhere }
"""
  let source = run present(written)
  let revision = run Revision.publish(&first, &entry, &source)
  let mut semantic = makeSemantic(run Revision.copy(&revision))
  let mut request = Request.make()
  let limitType = run Semantic.demandConstant(&mut semantic, &mut request, &entry, b"limit")
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, AnswerView>(&limitType, inspect).success && starts(
      Semantic.eventLog(&semantic),
      Family.Initializer,
    ) == 0,
    "a constant type resolves without demanding its initializer",
  )
  let copied = run Semantic.demandInitializer(&mut semantic, &mut request, &entry, b"copied")
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(
      &copied,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return constantInteger(answer, b"255")
      },
    ) && starts(Semantic.eventLog(&semantic), Family.Initializer) == 2 && starts(
      Semantic.eventLog(&semantic),
      Family.Constant,
    ) == 2 && reads(Semantic.sourceEvents(&semantic), &library) == 0,
    "a named constant demands the referenced type and value edges only",
  )
  let imported = run Semantic.demandInitializer(&mut semantic, &mut request, &entry, b"imported")
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(
      &imported,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return constantInteger(answer, b"7")
      },
    ) && Request.hasDemand(&request, Family.Import, &entry) && Request.hasDemand(
      &request,
      Family.Initializer,
      &library,
    ),
    "a selected imported constant records import and value evidence",
  )
  let importedExtent = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"arrayFromImport")
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(&importedExtent, fn(answer: &Result<Answer, NoRejection>) -> bool {
      return signatureArrayExtent(answer, b"7")
    }) && Request.hasDemand(&request, Family.Initializer, &library),
    "an imported constant selects a canonical array extent and records its value dependency",
  )
  let qualifiedExtent = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"arrayFromQualified")
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(&qualifiedExtent, fn(answer: &Result<Answer, NoRejection>) -> bool {
      return signatureArrayExtent(answer, b"7")
    }) && Request.hasDemand(&request, Family.Initializer, &library),
    "a qualified imported constant selects the checked extent and records its value dependency",
  )
  let arithmeticExtent = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"arithmeticExtent")
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(&arithmeticExtent, fn(answer: &Result<Answer, NoRejection>) -> bool {
      return signatureArrayExtent(answer, b"4294967297")
    }),
    "an all-literal extent retains a wide intermediate before target-width admission",
  )
  let mut wasm = Semantic.make(run Revision.copy(&revision), MachineTarget.forId(TargetId.Wasm32UnknownUnknown), Option.none<FinalProfile>())
  let mut wasmRequest = Request.make()
  let narrowExtent = run Semantic.demandSignature(&mut wasm, &mut wasmRequest, &entry, b"arithmeticExtent")
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(&narrowExtent, fn(answer: &Result<Answer, NoRejection>) -> bool {
      return rejectedTypeApplication(answer, RejectionCode.InvalidConstant)
    }),
    "the same arithmetic extent exceeds the selected wasm32 width",
  )
  let negativeExtent = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"negativeArray")
  let wrongExtent = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"boolArray")
  run Testing.expect(
    rejectsFrom(&negativeExtent, RejectionCode.IntegerOutOfRange, offsetOf(written, "-1", usize.ZERO)),
    "a negative array extent is rejected at its authored literal",
  )
  run Testing.expect(
    rejectsFrom(&wrongExtent, RejectionCode.InvalidConstant, offsetOf(written, "true", usize.ZERO)),
    "a noninteger array extent rejects at its authored expression",
  )
  let cycle = run Semantic.demandInitializer(&mut semantic, &mut request, &entry, b"first")
  let secondValue = run Semantic.demandInitializer(&mut semantic, &mut request, &entry, b"second")
  let secondType = run Semantic.demandConstant(&mut semantic, &mut request, &entry, b"second")
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(&cycle, cycleOfThree) && Shared.with<
      Result<Answer, NoRejection>,
      bool,
    >(&secondValue, cycleOfThree) && Shared.with<Result<Answer, NoRejection>, AnswerView>(
      &secondType,
      inspect,
    ).success,
    "an initializer cycle publishes no value while both constant types remain available",
  )
  let mut reversed = makeSemantic(move revision)
  let mut reversedRequest = Request.make()
  let reversedSecond = run Semantic.demandInitializer(
    &mut reversed,
    &mut reversedRequest,
    &entry,
    b"second",
  )
  let reversedFirst = run Semantic.demandInitializer(
    &mut reversed,
    &mut reversedRequest,
    &entry,
    b"first",
  )
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(
      &cycle,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionSpells(answer, RejectionCode.Cycle, String.utf8Bytes(written), b"second")
      },
    ) && Shared.with<Result<Answer, NoRejection>, bool>(
      &secondValue,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionSpells(answer, RejectionCode.Cycle, String.utf8Bytes(written), b"first")
      },
    ) && rejectsFrom(&cycle, RejectionCode.Cycle, offsetOf(written, "second", usize.ZERO)) && rejectsFrom(
      &secondValue, RejectionCode.Cycle, offsetOf(written, "first", usize.ONE),
    ) && rotatedPair(&cycle, &secondValue) && sameCycleAnswers(&cycle, &reversedFirst) && sameCycleAnswers(
      &secondValue,
      &reversedSecond,
    ),
    "each initializer cycle member rejects at its own reference in either demand order",
  )
  let flag = run Semantic.demandInitializer(&mut semantic, &mut request, &entry, b"flag")
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(&flag, constantTrue),
    "a Boolean literal is its constant value",
  )
  let label = run Semantic.demandConstant(&mut semantic, &mut request, &entry, b"label")
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(&label, staticStringConstant),
    "an omitted constant string lifetime is static",
  )
  let ratioType = run Semantic.demandConstant(&mut semantic, &mut request, &entry, b"ratio")
  let half = run Semantic.demandInitializer(&mut semantic, &mut request, &entry, b"half")
  let ratio = run Semantic.demandInitializer(&mut semantic, &mut request, &entry, b"ratio")
  let text = run Semantic.demandInitializer(&mut semantic, &mut request, &entry, b"label")
  let sized = run Semantic.demandInitializer(&mut semantic, &mut request, &entry, b"sized")
  let computed = run Semantic.demandInitializer(&mut semantic, &mut request, &entry, b"computed")
  let called = run initializerRejects(
    &mut semantic, &mut request, &entry, b"called", RejectionCode.StaticPhaseViolation,
  )
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(&half, fn(answer: &Result<Answer, NoRejection>) -> bool {
      return constantFloatBits(answer, StaticFloatType.F32, 0x3fc00000)
    }),
    "a declared f32 constant rounds the authored literal to f32 bits",
  )
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(&ratio, fn(answer: &Result<Answer, NoRejection>) -> bool {
      return constantFloatBits(answer, StaticFloatType.F64, 0x3ff8000000000000)
    }),
    "a declared f64 constant retains f64 literal bits",
  )
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(&text, fn(answer: &Result<Answer, NoRejection>) -> bool {
      return constantText(answer, b"x")
    }),
    "a text constant publishes its static bytes",
  )
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(&sized, fn(answer: &Result<Answer, NoRejection>) -> bool {
      return constantInteger(answer, b"1")
    }),
    "a pointer-sized constant publishes its selected value",
  )
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(&computed, fn(answer: &Result<Answer, NoRejection>) -> bool {
      return constantInteger(answer, b"6")
    }),
    "a static call publishes the computed constant value",
  )
  run Testing.expect(
    called,
    "an ordinary function cannot execute as a static constant initializer",
  )
  let wide = run Semantic.demandInitializer(&mut semantic, &mut request, &entry, b"wide")
  let wrong = run Semantic.demandInitializer(&mut semantic, &mut request, &entry, b"wrong")
  run Testing.expect(
    rejectsFrom(&wide, RejectionCode.IntegerOutOfRange, offsetOf(written, "256", usize.ZERO)) && Shared.with<
      Result<Answer, NoRejection>,
      bool,
    >(&wide, fn(answer: &Result<Answer, NoRejection>) -> bool {
      return rejectionSpells(answer, RejectionCode.IntegerOutOfRange, String.utf8Bytes(written), b"256")
    }),
    "the range error points at the authored integer literal",
  )
  run Testing.expect(
    rejectsFrom(&wrong, RejectionCode.TypeMismatch, offsetOf(written, "1\nconst mismatch", usize.ZERO)) && Shared.with<
      Result<Answer, NoRejection>,
      bool,
    >(&wrong, fn(answer: &Result<Answer, NoRejection>) -> bool {
      return rejectionSpells(answer, RejectionCode.TypeMismatch, String.utf8Bytes(written), b"1")
    }),
    "the type mismatch points at the authored initializer",
  )
  let aborted = run Semantic.demandInitializer(&mut semantic, &mut request, &entry, b"aborted")
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(&aborted, fn(answer: &Result<Answer, NoRejection>) -> bool {
      return selectedStaticFailure(answer, String.utf8Bytes(written))
    }),
    "selected compileError retains its static code, message, origin, and call trace",
  )
  let pointer = run Semantic.demandConstant(&mut semantic, &mut request, &entry, b"pointer")
  let mismatch = run Semantic.demandInitializer(&mut semantic, &mut request, &entry, b"mismatch")
  let notConstant = run Semantic.demandConstant(&mut semantic, &mut request, &entry, b"helper")
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, AnswerView>(&ratioType, inspect).success && Shared.with<
      Result<Answer, NoRejection>,
      bool,
    >(
      &pointer,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionCode(answer, RejectionCode.InvalidConstant)
      },
    ) && Shared.with<Result<Answer, NoRejection>, bool>(
      &mismatch,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionCode(answer, RejectionCode.TypeMismatch)
      },
    ) && Shared.with<Result<Answer, NoRejection>, bool>(
      &notConstant,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionCode(answer, RejectionCode.Unsupported)
      },
    ),
    "constant types, referenced-type mismatches, and non-constants have distinct outcomes",
  )
  let valueStarts = starts(Semantic.eventLog(&semantic), Family.Initializer)
  let reads = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"reads")
  let readsQualified = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"readsQualified")
  let readsRejected = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"readsRejected")
  let absent = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"absent")
  run Testing.expect(
    characterBodyFact(&reads, b"u8", true, StaticIntegerType.U8, 255, usize.ONE)
      && characterBodyFact(&readsQualified, b"u8", true, StaticIntegerType.U8, 7, usize.ONE)
      && Shared.with<Result<Answer, NoRejection>, bool>(
        &reads,
        fn(answer: &Result<Answer, NoRejection>) -> bool {
          return dependsOnName(&semantic, answer, b"limit") && dependsOnFamily(answer, Family.Initializer)
        },
      ) && starts(Semantic.eventLog(&semantic), Family.Initializer) == valueStarts,
    "a runtime constant read embeds the shared published value at its declared type",
  )
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(
      &readsRejected,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionSpells(answer, RejectionCode.TypeMismatch, String.utf8Bytes(written), b"limit")
      },
    ) && Shared.with<Result<Answer, NoRejection>, bool>(
      &absent,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionSpells(
          answer,
          RejectionCode.UnknownName,
          String.utf8Bytes(written),
          b"nowhere",
        ) && dependsOnName(&semantic, answer, b"nowhere")
      },
    ),
    "a rejected initializer rejects its runtime reader with its own diagnostic; an absent name stays unknown",
  )
  return ()
}

// Demands one fixed set of constant facts. `copied` and `pending` hold the expected digits; an
// empty slice expects the anchored rejection at that name instead.
effect fn constantFacts(
  semantic: &mut Semantic,
  entry: &ModuleId,
  text: &[u8],
  copied: &[u8],
  pending: &[u8],
  cycle: bool,
) -> bool ! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch ? &mut Allocator {
  let mut request = Request.make()
  let copiedValue = run Semantic.demandInitializer(&mut semantic.*, &mut request, entry, b"copied")
  let firstValue = run Semantic.demandInitializer(&mut semantic.*, &mut request, entry, b"first")
  let firstType = run Semantic.demandConstant(&mut semantic.*, &mut request, entry, b"first")
  let laterValue = run Semantic.demandInitializer(&mut semantic.*, &mut request, entry, b"later")
  let copiedHolds = Shared.with<Result<Answer, NoRejection>, bool>(
    &copiedValue,
    fn(answer: &Result<Answer, NoRejection>) -> bool {
      if copied.length == usize.ZERO {
        return rejectionSpells(answer, RejectionCode.TypeMismatch, text, b"base")
      }
      return constantInteger(answer, copied)
    },
  )
  let laterHolds = Shared.with<Result<Answer, NoRejection>, bool>(
    &laterValue,
    fn(answer: &Result<Answer, NoRejection>) -> bool {
      if pending.length == usize.ZERO {
        return rejectionSpells(answer, RejectionCode.UnknownName, text, b"pending")
      }
      return constantInteger(answer, pending)
    },
  )
  let firstHolds = Shared.with<Result<Answer, NoRejection>, bool>(
    &firstValue,
    fn(answer: &Result<Answer, NoRejection>) -> bool {
      if cycle {
        return cycleOfThree(answer)
      }
      return constantInteger(answer, b"3")
    },
  )
  return copiedHolds && laterHolds && firstHolds && Shared.with<
    Result<Answer, NoRejection>,
    AnswerView,
  >(&firstType, inspect).success
}

effect fn constantRevisionClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator {
  let entry = run module("values.silk")
  let library = run module("library.silk")
  let text = "import library { base }\nconst copied: u8 = base\nconst first: i32 = second\nconst second: i32 = 3\nconst later: u8 = pending\nfn unrelated() -> i32 { return 1 }\n"
  let entrySource = run present(text)
  let librarySource = run present("pub const base: u8 = 7\n")
  let first = run Revision.publish(&Revision.make(), &library, &librarySource)
  let held = run Revision.publish(&first, &entry, &entrySource)
  let mut semantic = makeSemantic(run Revision.copy(&held))
  let cold = run constantFacts(&mut semantic, &entry, String.utf8Bytes(text), b"7", b"", false)
  let mut request = Request.make()
  let unrelated = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"unrelated")
  run Testing.expect(
    cold && Shared.with<Result<Answer, NoRejection>, AnswerView>(&unrelated, inspect).success,
    "initial constant values, a missing name, and an unrelated body",
  )
  let valueSource = run present("pub const base: u8 = 9\n")
  let valueRevision = run Revision.publish(&held, &library, &valueSource)
  Semantic.revise(&mut semantic, run Revision.copy(&valueRevision))
  let valueStarts = starts(Semantic.eventLog(&semantic), Family.Initializer)
  let typeStarts = starts(Semantic.eventLog(&semantic), Family.Constant)
  let warmValue = run constantFacts(&mut semantic, &entry, String.utf8Bytes(text), b"9", b"", false)
  let mut again = Request.make()
  let kept = run Semantic.demandBody(&mut semantic, &mut again, &entry, b"unrelated")
  let mut freshValue = makeSemantic(run Revision.copy(&valueRevision))
  let coldValue = run constantFacts(
    &mut freshValue,
    &entry,
    String.utf8Bytes(text),
    b"9",
    b"",
    false,
  )
  run Testing.expect(
    warmValue && coldValue && Shared.with<Result<Answer, NoRejection>, AnswerView>(&kept, inspect).success && starts(
      Semantic.eventLog(&semantic),
      Family.Initializer,
    ) == valueStarts + 2 && starts(Semantic.eventLog(&semantic), Family.Constant) == typeStarts + 1 && starts(
      Semantic.eventLog(&semantic),
      Family.Body,
    ) == 1,
    "an imported value edit restarts only its value consumers, not their type facts or unrelated bodies",
  )
  let typeSource = run present("pub const base: bool = true\n")
  let typeRevision = run Revision.publish(&valueRevision, &library, &typeSource)
  Semantic.revise(&mut semantic, run Revision.copy(&typeRevision))
  let warmType = run constantFacts(&mut semantic, &entry, String.utf8Bytes(text), b"", b"", false)
  let mut freshType = makeSemantic(run Revision.copy(&typeRevision))
  let coldType = run constantFacts(&mut freshType, &entry, String.utf8Bytes(text), b"", b"", false)
  run Testing.expect(
    warmType && coldType,
    "an imported type edit rejects the consumer value at its reference",
  )
  let shiftedText = "// shifted\nimport library { base }\nconst copied: u8 = base\nconst first: i32 = second\nconst second: i32 = first\nconst later: u8 = pending\nconst pending: u8 = 4\nfn unrelated() -> i32 { return 1 }\n"
  let shiftedSource = run present(shiftedText)
  let shifted = run Revision.publish(&typeRevision, &entry, &shiftedSource)
  Semantic.revise(&mut semantic, run Revision.copy(&shifted))
  let warmShifted = run constantFacts(
    &mut semantic,
    &entry,
    String.utf8Bytes(shiftedText),
    b"",
    b"4",
    true,
  )
  let mut freshShifted = makeSemantic(run Revision.copy(&shifted))
  let coldShifted = run constantFacts(
    &mut freshShifted,
    &entry,
    String.utf8Bytes(shiftedText),
    b"",
    b"4",
    true,
  )
  let mut warmRequest = Request.make()
  let warmFirst = run Semantic.demandInitializer(&mut semantic, &mut warmRequest, &entry, b"first")
  let warmSecond = run Semantic.demandInitializer(
    &mut semantic,
    &mut warmRequest,
    &entry,
    b"second",
  )
  let mut reversed = makeSemantic(run Revision.copy(&shifted))
  let mut reversedRequest = Request.make()
  let reversedSecond = run Semantic.demandInitializer(
    &mut reversed,
    &mut reversedRequest,
    &entry,
    b"second",
  )
  let reversedFirst = run Semantic.demandInitializer(
    &mut reversed,
    &mut reversedRequest,
    &entry,
    b"first",
  )
  run Testing.expect(
    warmShifted && coldShifted && sameCycleAnswers(&warmFirst, &reversedFirst) && sameCycleAnswers(
      &warmSecond,
      &reversedSecond,
    ) && starts(Semantic.eventLog(&semantic), Family.Body) == 1,
    "a new cycle, a newly present name, and moved references use current values and spans",
  )
  let recoveredText = "// shifted\nimport library { base }\nconst copied: u8 = base\nconst first: i32 = second\nconst second: i32 = 3\nconst later: u8 = pending\nconst pending: u8 = 4\nfn unrelated() -> i32 { return 1 }\n"
  let recoveredSource = run present(recoveredText)
  let recovered = run Revision.publish(&shifted, &entry, &recoveredSource)
  Semantic.revise(&mut semantic, run Revision.copy(&recovered))
  let warmRecovered = run constantFacts(
    &mut semantic,
    &entry,
    String.utf8Bytes(recoveredText),
    b"",
    b"4",
    false,
  )
  let mut freshRecovered = makeSemantic(move recovered)
  let coldRecovered = run constantFacts(
    &mut freshRecovered,
    &entry,
    String.utf8Bytes(recoveredText),
    b"",
    b"4",
    false,
  )
  run Testing.expect(
    warmRecovered && coldRecovered,
    "breaking the cycle publishes the value again instead of a cached rejection",
  )
  return ()
}

test effect fn constantTypesAndInitializerDemands() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run constantClaims()
    |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn constantRevisionsReplayAffectedFacts() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run constantRevisionClaims()
    |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn bodyChecksDemandedScalarReturnsAndReplaysEvidence() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let entry = run module("bodies.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """type Byte = u8
fn answer() -> i32 { return 42 }
fn broken() -> i32 { return missing }
fn fits() -> u8 { return 255 }
fn tooLarge() -> u8 { return 256 }
fn alias() -> Byte { return 255 }
fn echo(value: i32) -> i32 { return value }
fn inferred() -> u8 { let value = 255 return value }
fn annotated() -> u8 { let value: Byte = 255 return value }
fn localChain() -> i32 { let first = 1 let second = first return second }
fn shadow(value: i32) -> i32 { let value = value return value }
fn unitLocal() { let value = () return value }
fn duplicate() -> i32 { let value = 1 let value = 2 return value }
fn duplicateParameters(value: i32, value: i32) -> i32 { return value }
fn forward() -> i32 { let first = later let later = 1 return first }
fn selfRead() -> i32 { let value = value return value }
fn tooLargeLocal() -> u8 { let value: u8 = 256 return value }
fn incompatibleLocal() -> bool { let value: bool = 1 return value }
fn discard() { 7 }
fn empty() {}
fn bare() { return }
fn explicit() -> () { return () }
fn mismatch() -> bool { return 1 }
fn noReturn() -> i32 { true }
fn logical() -> bool { return true && false }
"""
  let held = run present(text)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&Revision.make(), &entry, &held)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut semantic = makeSemantic(move revision)
  let mut request = Request.make()

  let answer = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"answer")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let answerBody = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(
    &answer,
    checkedBody,
  )
  if let Option<Shared<TypedBody>>.Some {value} = move answerBody {
    run Testing.expect(
      Shared.with<TypedBody, bool>(
        &value,
        fn(body: &TypedBody) -> bool {
          return bodyFirstIntegerType(body, b"i32") && TypedBody.nodeSlice(body).length == 3 && TypedBody.runtimeBodies(
            body,
          ).length == 0 && TypedBody.signatureDependencies(body).length == 1
        },
      ),
      "demanded answer has a complete typed return and signature dependency",
    )
  } else {
    run Testing.expect(false, "demanded answer has a checked body")
  }
  run Testing.expect(
    starts(Semantic.eventLog(&semantic), Family.Body) == 1 && Request.hasDemand(
      &request,
      Family.Signature,
      &entry,
    ) && Request.hasDiscovered(&request, &entry),
    "demanding answer does not start the broken body and retains its source",
  )

  let broken = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"broken")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(
      &broken,
      fn(value: &Result<Answer, NoRejection>) -> bool {
        return rejectionSpells(value, RejectionCode.UnknownName, String.utf8Bytes(text), b"missing")
      },
    ),
    "the demanded unresolved body name is rejected at its source span",
  )

  let fits = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"fits")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let alias = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"alias")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let tooLarge = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"tooLarge")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let fitsBody = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(
    &fits,
    checkedBody,
  )
  let aliasBody = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(
    &alias,
    checkedBody,
  )
  let mut typedAsU8 = false
  if let Option<Shared<TypedBody>>.Some {value} = move fitsBody {
    typedAsU8 = Shared.with<TypedBody, bool>(
      &value,
      fn(body: &TypedBody) -> bool {
        return bodyFirstIntegerType(body, b"u8")
      },
    )
  }
  if let Option<Shared<TypedBody>>.Some {value} = move aliasBody {
    typedAsU8 = typedAsU8 && Shared.with<TypedBody, bool>(
      &value,
      fn(body: &TypedBody) -> bool {
        return bodyFirstIntegerType(body, b"u8")
      },
    )
  } else {
    typedAsU8 = false
  }
  run Testing.expect(
    typedAsU8 && Shared.with<Result<Answer, NoRejection>, bool>(
      &tooLarge,
      fn(value: &Result<Answer, NoRejection>) -> bool {
        return rejectionCode(value, RejectionCode.IntegerOutOfRange)
      },
    ),
    "the immediate return context selects u8 through an alias and checks exact range",
  )

  let echo = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"echo")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let echoBody = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(
    &echo,
    checkedBody,
  )
  if let Option<Shared<TypedBody>>.Some {value} = move echoBody {
    run Testing.expect(
      Shared.with<TypedBody, bool>(&value, bodyReadsParameter),
      "parameter read keeps its authored binder identity",
    )
  } else {
    run Testing.expect(false, "parameter read has a checked body")
  }
  let inferred = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"inferred")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let annotated = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"annotated")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let localChain = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"localChain")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let shadow = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"shadow")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let unitLocal = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"unitLocal")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(
      &inferred,
      fn(value: &Result<Answer, NoRejection>) -> bool {
        return rejectionSpells(value, RejectionCode.TypeMismatch, String.utf8Bytes(text), b"value")
      },
    ),
    "a later u8 return cannot retype an inferred i32 local",
  )
  let annotatedBody = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(
    &annotated,
    checkedBody,
  )
  if let Option<Shared<TypedBody>>.Some {value} = move annotatedBody {
    run Testing.expect(
      Shared.with<TypedBody, bool>(
        &value,
        fn(body: &TypedBody) -> bool {
          return bodyFirstIntegerType(body, b"u8") && TypedBody.localSlice(body).length == 1
        },
      ),
      "an alias annotation selects u8 while the literal is still exact",
    )
  } else {
    run Testing.expect(false, "annotated local has a checked body")
  }
  let chainBody = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(
    &localChain,
    checkedBody,
  )
  if let Option<Shared<TypedBody>>.Some {value} = move chainBody {
    run Testing.expect(
      Shared.with<TypedBody, bool>(&value, bodyReadsLocalChain),
      "each immutable local has a body-owned identity and is available to later initializers",
    )
  } else {
    run Testing.expect(false, "local chain has a checked body")
  }
  let shadowBody = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(
    &shadow,
    checkedBody,
  )
  if let Option<Shared<TypedBody>>.Some {value} = move shadowBody {
    run Testing.expect(
      Shared.with<TypedBody, bool>(&value, bodyShadowsParameter),
      "the local initializer reads the parameter before the local shadows it",
    )
  } else {
    run Testing.expect(false, "parameter shadow has a checked body")
  }
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, AnswerView>(&unitLocal, inspect).success,
    "unit locals can be read by a unit return",
  )
  let duplicate = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"duplicate")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let duplicateParameters = run Semantic.demandBody(
    &mut semantic,
    &mut request,
    &entry,
    b"duplicateParameters",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let forward = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"forward")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let selfRead = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"selfRead")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let tooLargeLocal = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"tooLargeLocal")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let incompatibleLocal = run Semantic.demandBody(
    &mut semantic,
    &mut request,
    &entry,
    b"incompatibleLocal",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(
      &duplicate,
      fn(value: &Result<Answer, NoRejection>) -> bool {
        return rejectionSpells(value, RejectionCode.Collision, String.utf8Bytes(text), b"value")
      },
    ) && Shared.with<Result<Answer, NoRejection>, bool>(
      &duplicateParameters,
      fn(value: &Result<Answer, NoRejection>) -> bool {
        return rejectionSpells(value, RejectionCode.Collision, String.utf8Bytes(text), b"value")
      },
    ) && Shared.with<Result<Answer, NoRejection>, bool>(
      &forward,
      fn(value: &Result<Answer, NoRejection>) -> bool {
        return rejectionSpells(value, RejectionCode.UnknownName, String.utf8Bytes(text), b"later")
      },
    ) && Shared.with<Result<Answer, NoRejection>, bool>(
      &selfRead,
      fn(value: &Result<Answer, NoRejection>) -> bool {
        return rejectionSpells(value, RejectionCode.UnknownName, String.utf8Bytes(text), b"value")
      },
    ),
    "duplicate locals and parameters reject, and missing initializer names retain exact use spans",
  )
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(
      &tooLargeLocal,
      fn(value: &Result<Answer, NoRejection>) -> bool {
        return rejectionSpells(
          value,
          RejectionCode.IntegerOutOfRange,
          String.utf8Bytes(text),
          b"256",
        )
      },
    ) && Shared.with<Result<Answer, NoRejection>, bool>(
      &incompatibleLocal,
      fn(value: &Result<Answer, NoRejection>) -> bool {
        return rejectionSpells(value, RejectionCode.TypeMismatch, String.utf8Bytes(text), b"1")
      },
    ),
    "an annotated initializer checks exact range and type at the initializer",
  )
  let discard = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"discard")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let discardBody = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(
    &discard,
    checkedBody,
  )
  if let Option<Shared<TypedBody>>.Some {value} = move discardBody {
    run Testing.expect(
      Shared.with<TypedBody, bool>(
        &value,
        fn(body: &TypedBody) -> bool {
          return bodyFirstIntegerType(body, b"i32")
        },
      ),
      "an integer without immediate context defaults to i32",
    )
  } else {
    run Testing.expect(false, "unit expression body is checked")
  }
  let empty = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"empty")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let bare = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"bare")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let explicit = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"explicit")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, AnswerView>(&empty, inspect).success && Shared.with<
      Result<Answer, NoRejection>,
      AnswerView,
    >(&bare, inspect).success && Shared.with<Result<Answer, NoRejection>, AnswerView>(
      &explicit,
      inspect,
    ).success,
    "empty, bare-return, and explicit-unit bodies satisfy unit contracts",
  )
  let mismatch = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"mismatch")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let noReturn = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"noReturn")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let logical = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"logical")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(
      &mismatch,
      fn(value: &Result<Answer, NoRejection>) -> bool {
        return rejectionCode(value, RejectionCode.TypeMismatch)
      },
    ),
    "incompatible return has a type-mismatch rejection",
  )
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(
      &noReturn,
      fn(value: &Result<Answer, NoRejection>) -> bool {
        return rejectionCode(value, RejectionCode.MissingReturn)
      },
    ),
    "reachable non-unit fallthrough has a missing-return rejection",
  )
  let logicalBody = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(
    &logical,
    checkedBody,
  )
  if let Option<Shared<TypedBody>>.Some {value} = move logicalBody {
    run Testing.expect(
      Shared.with<TypedBody, bool>(&value, bodyHasLogicalAnd),
      "runtime logical and retains a checked scalar operation",
    )
  } else {
    run Testing.expect(false, "runtime logical and has a checked body")
  }
  return ()
}

test effect fn bodyChecksRuntimeBranchesAndReachableReturns() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let entry = run module("branches.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let text = "fn choose(flag: bool) -> i32 { if flag { return 1 } else { return 2 } }\nfn constantBad() -> i32 { if true { return 1 } else { return missing } }\nfn falseBad() -> i32 { if false { return missing } else { return 2 } }\nfn callerKnown() -> i32 { return badByFlag(true) }\nfn badByFlag(flag: bool) -> i32 { if flag { return 1 } else { return missing } }\nfn missingArm(flag: bool) -> i32 { if flag { return 1 } else { true } }\nfn partial(flag: bool) -> i32 { if flag { return 1 } }\nfn nonBool() -> i32 { if 1 { return 1 } else { return 2 } }\nfn badReturn(flag: bool) -> i32 { if flag { return true } else { return 2 } }\nfn branchScope() -> i32 { if true { let scoped = 1 } return scoped }\nfn branchDuplicate() -> i32 { if true { let value = 1 let value = 2 } return 0 }\nfn branchReuse() -> i32 { if true { let value = 1 } let value = 2 return value }\nfn bothLocals(flag: bool) -> i32 { if flag { let value = 1 return value } else { let value = 2 return value } }\nfn unreachableBad() -> i32 { return 1 if true { return missing } }\nfn unreachableValid() -> i32 { return 1 if true {} }\nfn laterReturn(flag: bool) -> i32 { if flag { return 1 } return 2 }\nfn unitFallthrough(flag: bool) { if flag { return } }\nfn chained(first: bool, second: bool) -> i32 { if first { return 1 } else if second { return 2 } else { return 3 } }\nfn callee() -> i32 { return missing }\nfn branchCall(flag: bool) -> i32 { if flag { return callee() } else { return 2 } }\nfn staticDeferred() -> i32 { static if true { return 1 } else { return missing } }\n"
  let held = run present(text)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&Revision.make(), &entry, &held)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut index = SourceIndex.make(run Revision.copy(&revision) |> Effect.provideMut<Allocator>(&mut allocator))
  let mut semantic = makeSemantic(move revision)
  let mut request = Request.make()
  let choose = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"choose")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let selected = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(
    &choose,
    checkedBody,
  )
  if let Option<Shared<TypedBody>>.Some {value} = move selected {
    run Testing.expect(
      Shared.with<TypedBody, bool>(&value, bodyHasCompleteBranch),
      "both returning arms retain typed branch and completion facts",
    )
  } else {
    run Testing.expect(false, "both returning arms produce a checked body")
  }
  let constantBad = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"constantBad")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let falseBad = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"falseBad")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let callerKnown = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"callerKnown")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let badByFlag = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"badByFlag")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let missingArm = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"missingArm")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let partial = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"partial")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let nonBool = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"nonBool")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let badReturn = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"badReturn")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(
      &constantBad,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionSpells(
          answer,
          RejectionCode.UnknownName,
          String.utf8Bytes(text),
          b"missing",
        )
      },
    ) && Shared.with<Result<Answer, NoRejection>, bool>(
      &falseBad,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionSpells(
          answer,
          RejectionCode.UnknownName,
          String.utf8Bytes(text),
          b"missing",
        )
      },
    ) && Shared.with<Result<Answer, NoRejection>, bool>(
      &badByFlag,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionSpells(
          answer,
          RejectionCode.UnknownName,
          String.utf8Bytes(text),
          b"missing",
        )
      },
    ) && Shared.with<Result<Answer, NoRejection>, AnswerView>(&callerKnown, inspect).success && Shared.with<
      Result<Answer, NoRejection>,
      bool,
    >(
      &missingArm,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return missingReturnAtFunctionClose(answer, String.utf8Bytes(text), b"missingArm")
      },
    ) && Shared.with<Result<Answer, NoRejection>, bool>(
      &partial,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return missingReturnAtFunctionClose(answer, String.utf8Bytes(text), b"partial")
      },
    ) && Shared.with<Result<Answer, NoRejection>, bool>(
      &nonBool,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionSpells(answer, RejectionCode.ConditionNotBool, String.utf8Bytes(text), b"1")
      },
    ) && Shared.with<Result<Answer, NoRejection>, bool>(
      &badReturn,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionSpells(answer, RejectionCode.TypeMismatch, String.utf8Bytes(text), b"true")
      },
    ),
    "constant and caller-known conditions do not hide bad arms; invalid exits reject",
  )
  let branchScope = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"branchScope")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let branchDuplicate = run Semantic.demandBody(
    &mut semantic,
    &mut request,
    &entry,
    b"branchDuplicate",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let branchReuse = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"branchReuse")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let bothLocals = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"bothLocals")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let armLocals = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(
    &bothLocals,
    checkedBody,
  )
  let mut distinct = false
  if let Option<Shared<TypedBody>>.Some {value} = move armLocals {
    distinct = Shared.with<TypedBody, bool>(&value, bodyHasDistinctArmLocals)
  }
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(
      &branchScope,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionSpells(answer, RejectionCode.UnknownName, String.utf8Bytes(text), b"scoped")
      },
    ) && Shared.with<Result<Answer, NoRejection>, bool>(
      &branchDuplicate,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionSpells(answer, RejectionCode.Collision, String.utf8Bytes(text), b"value")
      },
    ) && Shared.with<Result<Answer, NoRejection>, AnswerView>(&branchReuse, inspect).success && Shared.with<
      Result<Answer, NoRejection>,
      AnswerView,
    >(&bothLocals, inspect).success && distinct,
    "branch bindings are lexical, duplicate only in their own block, and have body-local IDs",
  )
  let unreachableBad = run Semantic.demandBody(
    &mut semantic,
    &mut request,
    &entry,
    b"unreachableBad",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let unreachableValid = run Semantic.demandBody(
    &mut semantic,
    &mut request,
    &entry,
    b"unreachableValid",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let laterReturn = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"laterReturn")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let unitFallthrough = run Semantic.demandBody(
    &mut semantic,
    &mut request,
    &entry,
    b"unitFallthrough",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let chained = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"chained")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(
      &unreachableBad,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionSpells(
          answer,
          RejectionCode.UnknownName,
          String.utf8Bytes(text),
          b"missing",
        )
      },
    ) && Shared.with<Result<Answer, NoRejection>, AnswerView>(&unreachableValid, inspect).success && Shared.with<
      Result<Answer, NoRejection>,
      AnswerView,
    >(&laterReturn, inspect).success && Shared.with<Result<Answer, NoRejection>, AnswerView>(
      &unitFallthrough,
      inspect,
    ).success && Shared.with<Result<Answer, NoRejection>, AnswerView>(&chained, inspect).success,
    "later source is checked while only reachable paths govern fallthrough",
  )
  let branchCall = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"branchCall")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let branchBody = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(
    &branchCall,
    checkedBody,
  )
  if let Option<Shared<TypedBody>>.Some {value} = move branchBody {
    run Testing.expect(
      Shared.with<TypedBody, bool>(
        &value,
        fn(body: &TypedBody) -> bool {
          return bodyCalls(body, &entry, usize.ZERO)
        },
      ),
      "a call inside a runtime arm retains its signature and body obligation",
    )
  } else {
    run Testing.expect(false, "a call in a runtime arm produces a checked body")
  }
  let deferredApplication = run selectedApplicationOf(&mut index, &entry, b"staticDeferred")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let deferred = run Semantic.demandSelectedBody(&mut semantic, &mut request, &deferredApplication)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, AnswerView>(&deferred, inspect).success,
    "static selection checks its active arm without resolving the inactive name",
  )
  return ()
}

test effect fn operandEvidenceFillsNestedLifetimeAndRows() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run operandEvidenceClaims()
    |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn boundedCallsUseProviderEvidenceAndProveBounds() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let entry = run module("bounded-accepted.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
interface Label<A> {}
struct Input {}
struct Many {}
struct Box<T> { value: T }
struct Held<'a> { value: &'a i32 }
impl Label<i32> for Input {}
impl Label<i32> for Many {}
impl Label<bool> for Many {}
impl<T> Label<T> for Box<T> {}
impl<'a> Label<i32> for Held<'a> {}
fn select<C: Label<A>, A>(value: C) -> i32 { return 0 }
fn inferred(value: Input) -> i32 { return select(value) }
fn generic(value: Box<u8>) -> i32 { return select(value) }
fn regional<'a>(value: Held<'a>) -> i32 { return select(value) }
fn explicit(value: Input) -> i32 { return select<Input, i32>(value) }
fn chosen(value: Many) -> i32 { return select<Many, i32>(value) }
fn relay<C: Label<i32>>(value: C) -> i32 { return select<C, i32>(value) }
fn abstractKnown<C: Label<i32>>(value: C) -> i32 { return select(value) }
fn abstractCarry<C: Label<A>, A>(value: C) -> i32 { return select(value) }
"""
  let source = run present(text)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&Revision.make(), &entry, &source)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut semantic = makeSemantic(move revision)
  let mut request = Request.make()
  let inferred = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"inferred")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let generic = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"generic")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let regional = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"regional")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let explicit = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"explicit")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let relay = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"relay")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let chosen = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"chosen")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let abstractKnown = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"abstractKnown")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let abstractCarry = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"abstractCarry")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(&inferred, fn(answer: &Result<Answer, NoRejection>) -> bool {
      return checkedCallGenericCount(answer, 2)
    }) && Shared.with<Result<Answer, NoRejection>, bool>(&generic, fn(answer: &Result<Answer, NoRejection>) -> bool {
      return checkedCallGenericCount(answer, 2)
    }) && Shared.with<Result<Answer, NoRejection>, bool>(&explicit, fn(answer: &Result<Answer, NoRejection>) -> bool {
      return checkedCallGenericCount(answer, 2)
    }) && Shared.with<Result<Answer, NoRejection>, bool>(&relay, fn(answer: &Result<Answer, NoRejection>) -> bool {
      return checkedCallGenericCount(answer, 2)
    }) && Shared.with<Result<Answer, NoRejection>, bool>(&chosen, fn(answer: &Result<Answer, NoRejection>) -> bool {
      return checkedCallGenericCount(answer, 2)
    }) && Shared.with<Result<Answer, NoRejection>, bool>(&abstractKnown, fn(answer: &Result<Answer, NoRejection>) -> bool {
      return checkedCallGenericCount(answer, 2)
    }) && Shared.with<Result<Answer, NoRejection>, bool>(&abstractCarry, fn(answer: &Result<Answer, NoRejection>) -> bool {
      return checkedCallGenericCount(answer, 2)
    }),
    "ground and generic provider heads fill the remaining argument; explicit and declared bounds prove",
  )
  // A provider whose only open arguments are regions is known; its head binds the impl's lifetime.
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(&regional, fn(answer: &Result<Answer, NoRejection>) -> bool {
      return checkedCallGenericCount(answer, 2)
    }),
    "a provider with only lifetime arguments selects its implementation head",
  )
  return ()
}

test effect fn boundedCallsFillIndependentBounds() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let entry = run module("bounded-independent.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
interface First<A> {}
interface Second<B> {}
struct Input {}
impl First<i32> for Input {}
impl Second<bool> for Input {}
fn selectBoth<C: First<A> + Second<B>, A, B>(value: C) -> i32 { return 0 }
fn independent(value: Input) -> i32 { return selectBoth(value) }
fn partiallyFixed(value: Input) -> i32 { return selectBoth<Input, i32>(value) }
"""
  let source = run present(text)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&Revision.make(), &entry, &source)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut semantic = makeSemantic(move revision)
  let mut request = Request.make()
  let independent = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"independent")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let partiallyFixed = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"partiallyFixed")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(&independent, fn(answer: &Result<Answer, NoRejection>) -> bool {
      return checkedCallGenericCount(answer, 3)
    }) && Shared.with<Result<Answer, NoRejection>, bool>(&partiallyFixed, fn(answer: &Result<Answer, NoRejection>) -> bool {
      return checkedCallGenericCount(answer, 3)
    }),
    "independent bounds fill separate arguments while an explicit prefix remains fixed",
  )
  return ()
}

test effect fn boundedCallsRejectMissingAndConflictingEvidence() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let entry = run module("bounded-rejected.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
interface Label<A> {}
interface First<A> {}
interface Second<B> {}
struct Input {}
struct Other {}
struct Many {}
impl Label<i32> for Input {}
impl First<i32> for Input {}
impl Second<bool> for Input {}
impl Label<i32> for Many {}
impl Label<bool> for Many {}
struct Pinned<'a> { value: &'a i32 }
impl<'a: 'static> Label<i32> for Pinned<'a> {}
fn select<C: Label<A>, A>(value: C) -> i32 { return 0 }
fn selectWith<C: Label<A>, A>(value: C, hint: A) -> i32 { return 0 }
fn selectSame<C: First<A> + Second<A>, A>(value: C) -> i32 { return 0 }
fn missing(value: Other) -> i32 { return select<Other, i32>(value) }
fn conflicting(value: Input) -> i32 { return select<Input, bool>(value) }
fn conflictingBounds(value: Input) -> i32 { return selectSame(value) }
fn operandConflict(value: Input) -> i32 { return selectWith(value, true) }
fn ambiguous(value: Many) -> i32 { return select(value) }
fn unknown<C>(value: C) -> i32 { return select(value) }
fn unpinned<'a>(value: Pinned<'a>) -> i32 { return select(value) }
"""
  let source = run present(text)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&Revision.make(), &entry, &source)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut semantic = makeSemantic(move revision)
  let mut request = Request.make()
  let missing = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"missing")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let conflicting = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"conflicting")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let conflictingBounds = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"conflictingBounds")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let operandConflict = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"operandConflict")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let ambiguous = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"ambiguous")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let unknown = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"unknown")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let unpinned = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"unpinned")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(&missing, fn(answer: &Result<Answer, NoRejection>) -> bool {
      return rejectionSpells(answer, RejectionCode.MissingConformance, String.utf8Bytes(text), b"select<Other, i32>(value)")
    }) && Shared.with<Result<Answer, NoRejection>, bool>(&conflicting, fn(answer: &Result<Answer, NoRejection>) -> bool {
      return rejectionSpells(answer, RejectionCode.MissingConformance, String.utf8Bytes(text), b"select<Input, bool>(value)")
    }) && Shared.with<Result<Answer, NoRejection>, bool>(&operandConflict, fn(answer: &Result<Answer, NoRejection>) -> bool {
      return rejectionSpells(answer, RejectionCode.MissingConformance, String.utf8Bytes(text), b"selectWith(value, true)")
    }) && Shared.with<Result<Answer, NoRejection>, bool>(&ambiguous, fn(answer: &Result<Answer, NoRejection>) -> bool {
      return rejectionSpells(answer, RejectionCode.UninferredParameter, String.utf8Bytes(text), b"select(value)")
    }) && Shared.with<Result<Answer, NoRejection>, bool>(&unknown, fn(answer: &Result<Answer, NoRejection>) -> bool {
      return rejectionSpells(answer, RejectionCode.UninferredParameter, String.utf8Bytes(text), b"select(value)")
    }),
    "bounded calls reject absent and conflicting conformances; an unknown provider cannot invent evidence",
  )
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(&conflictingBounds, fn(answer: &Result<Answer, NoRejection>) -> bool {
      return rejectionSpells(answer, RejectionCode.MissingConformance, String.utf8Bytes(text), b"selectSame(value)")
    }),
    "two bounds cannot replace a binder fixed by the first bound's unique evidence",
  )
  // A head selected by a region-only provider still owes its outlives requirements.
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(&unpinned, fn(answer: &Result<Answer, NoRejection>) -> bool {
      return rejectionSpells(answer, RejectionCode.Unsupported, String.utf8Bytes(text), b"select(value)")
    }),
    "an implementation head's unmet outlives requirement still refuses the call",
  )
  return ()
}

effect fn operandEvidenceClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator {
  let entry = run module("operand-evidence.silk")
  let text = "service Clock {}\nservice Logger {}\nservice Channel<T> {}\nstruct Box<T> {}\nstruct Left<?R> {}\nstruct Right<?S> {}\nfn takeNested<T>(value: Box<T>) -> i32 { return 0 }\nfn useNested(value: Box<i32>) -> i32 { return takeNested(value) }\nfn takeSet<T>(value: Box<Box<T> | i32>) -> i32 { return 0 }\nfn useSet(value: Box<Box<u8> | i32>) -> i32 { return takeSet(value) }\nfn takeExact(value: Box<i32>) -> i32 { return 0 }\nfn wrongNested(value: Box<bool>) -> i32 { return takeExact(value) }\nfn wrongScalar(value: Box<i32>) -> i32 { return value }\nfn takeRegion<'a>(value: &'a i32) -> i32 { return 0 }\nfn useRegion(value: &'static i32) -> i32 { return takeRegion(value) }\nfn takeRows<?R, ?S>(first: Left<? R>, second: Right<? S>) -> i32 { return 0 }\nfn useRows(first: Left<&Clock>, second: Right<&Logger>) -> i32 { return takeRows(first, second) }\nfn takeRowKey<T>(value: Left<&Channel<T>>) -> i32 { return 0 }\nfn useRowKey(value: Left<&Channel<i32>>) -> i32 { return takeRowKey(value) }\nfn takeRepeated<?R>(first: Left<? R>, second: Left<? R>) -> i32 { return 0 }\nfn conflictingRows(first: Left<&Clock>, second: Left<&Logger>) -> i32 { return takeRepeated(first, second) }\n"
  let source = run present(text)
  let revision = run Revision.publish(&Revision.make(), &entry, &source)
  let mut semantic = makeSemantic(move revision)
  let mut request = Request.make()
  let nested = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"useNested")
  let set = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"useSet")
  let region = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"useRegion")
  let rows = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"useRows")
  let rowKey = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"useRowKey")
  let conflict = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"conflictingRows")
  let wrongNested = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"wrongNested")
  let wrongScalar = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"wrongScalar")
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(
      &nested,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return checkedCallGenericCount(answer, 1) && checkedNominalOperand(answer)
      },
    ),
    "a nested nominal operand fixes its type binder",
  )
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(
      &region,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return checkedCallGenericCount(answer, 1)
      },
    ),
    "a borrowed operand fixes its lifetime binder",
  )
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(
      &set,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return checkedCallGenericCount(answer, 1)
      },
    ),
    "one nested union member fixes its type binder without set subtraction",
  )
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(
      &rows,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return checkedCallGenericCount(answer, 2)
      },
    ),
    "independent operands fix two requirement rows",
  )
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(
      &rowKey,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return checkedCallGenericCount(answer, 1)
      },
    ),
    "one parameterized row key fixes its ordinary type binder",
  )
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(
      &conflict,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionCode(answer, RejectionCode.TypeMismatch)
      },
    ) && Shared.with<Result<Answer, NoRejection>, bool>(
      &wrongNested,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionCode(answer, RejectionCode.TypeMismatch)
      },
    ) && Shared.with<Result<Answer, NoRejection>, bool>(
      &wrongScalar,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionCode(answer, RejectionCode.TypeMismatch)
      },
    ),
    "conflicting row and nominal operands reject, and a nominal local cannot satisfy a scalar return",
  )
  return ()
}

test effect fn witnessRowResidualUsesFixedCoverage() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let entry = run module("witness-row-residual.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let source = run present(
    "service Clock {}\nservice Logger {}\nfn promised<?R>(value: Effect<'static; i32 ? &mut Clock | R>) -> i32 { return 0 }\nfn witness<?W>(value: Effect<'static; i32 ? &Clock | W>) -> i32 { return 0 }\nfn extra<?W>(value: Effect<'static; i32 ? &Logger | W>) -> i32 { return 0 }\n",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&Revision.make(), &entry, &source)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut index = SourceIndex.make(
    run Revision.copy(&revision)
      |> Effect.provideMut<Allocator>(&mut allocator),
  )
  let witnessOwner = run requireIndexedIdentity(&mut index, &entry, OwnerKind.Function, b"witness", usize.ZERO)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let extraOwner = run requireIndexedIdentity(&mut index, &entry, OwnerKind.Function, b"extra", usize.ZERO)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut semantic = makeSemantic(move revision)
  let mut request = Request.make()
  let promised = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"promised")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let witness = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"witness")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let extra = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"extra")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let promisedValue = contractSlotOf(&promised, usize.ZERO)
  let witnessValue = contractSlotOf(&witness, usize.ZERO)
  let extraValue = contractSlotOf(&extra, usize.ZERO)
  if let Option<Shared<Type>>.Some {value: allowed} = move promisedValue {
    if let Option<Shared<Type>>.Some {value: required} = move witnessValue {
      let witnessDeclaration = run Shared.make<DeclarationId>(move witnessOwner)
        |> Effect.provideMut<Allocator>(&mut allocator)
      let mut bindable = Vector.make<Shared<DeclarationId>>()
      run Vector.append<Shared<DeclarationId>>(&mut bindable, move witnessDeclaration)
        |> Effect.provideMut<Allocator>(&mut allocator)
      let mut ordinary = Vector.make<Binding>()
      let exact = run Type.unify(
        &allowed,
        &required,
        Vector.asSlice<Shared<DeclarationId>>(&bindable),
        Comparison.Exact,
        &mut ordinary,
      ) |> Effect.provideMut<Allocator>(&mut allocator)
      let mut bindings = Vector.make<Binding>()
      let residual = run Type.bindWitnessResidual(
        &allowed,
        &required,
        Vector.asSlice<Shared<DeclarationId>>(&bindable),
        &mut bindings,
      ) |> Effect.provideMut<Allocator>(&mut allocator)
      let ordinaryUnknown = match & exact {
        Unification.Undetermined {..} => Vector.length<Binding>(&ordinary) == usize.ZERO
        _ => false
      }
      let mut boundToPromisedRow = false
      let matched = match & residual {
        Unification.Unified => true
        _ => false
      }
      if matched {
        let values = Vector.asSlice<Binding>(&bindings)
        if values.length == usize.ONE {
          if let Argument.Row {value} = &values[usize.ZERO].value {
            boundToPromisedRow = Shared.with<Row, bool>(
              &value,
              fn(row: &Row) -> bool {
                return Vector.length(&row.parameters) == usize.ONE && Vector.length<Requirement>(
                  &row.entries,
                ) == usize.ZERO
              },
            )
          }
        }
      }
      run Testing.expect(
        ordinaryUnknown && boundToPromisedRow,
        "a covered fixed witness key leaves its open row bound to the promised row parameter without changing Exact equality",
      )
      if let Option<Shared<Type>>.Some {value: uncovered} = move extraValue {
        let extraDeclaration = run Shared.make<DeclarationId>(move extraOwner)
          |> Effect.provideMut<Allocator>(&mut allocator)
        let mut extraBindable = Vector.make<Shared<DeclarationId>>()
        run Vector.append<Shared<DeclarationId>>(&mut extraBindable, move extraDeclaration)
          |> Effect.provideMut<Allocator>(&mut allocator)
        let mut extraBindings = Vector.make<Binding>()
        let failed = run Type.bindWitnessResidual(
          &allowed,
          &uncovered,
          Vector.asSlice<Shared<DeclarationId>>(&extraBindable),
          &mut extraBindings,
        ) |> Effect.provideMut<Allocator>(&mut allocator)
        let uncoveredRejected = match & failed {
          Unification.Distinct => Vector.length<Binding>(&extraBindings) == usize.ZERO
          _ => false
        }
        run Testing.expect(uncoveredRejected, "an open witness row cannot conceal an uncovered fixed requirement")
      } else {
        run Testing.expect(false, "the uncovered witness has a source-resolved row")
      }
    } else {
      run Testing.expect(false, "the witness has a source-resolved row")
    }
  } else {
    run Testing.expect(false, "the promise has a source-resolved row")
  }
  return ()
}

fn checkedCallGenericCount(answer: &Result<Answer, NoRejection>, count: usize) -> bool {
  let body = checkedBody(answer)
  if let Option<Shared<TypedBody>>.Some {value} = move body {
    return Shared.with<TypedBody, bool>(
      &value,
      fn(checked: &TypedBody) -> bool {
        return bodyCallGenericCount(checked, count)
      },
    )
  }
  return false
}

fn checkedNominalOperand(answer: &Result<Answer, NoRejection>) -> bool {
  let body = checkedBody(answer)
  if let Option<Shared<TypedBody>>.Some {value} = move body {
    return Shared.with<TypedBody, bool>(
      &value,
      fn(checked: &TypedBody) -> bool {
        let locals = TypedBody.localSlice(checked)
        if locals.length != 1 || !Shared.with<Type, bool>(&locals[0].ty, nominalType) {
          return false
        }
        let nodes = TypedBody.nodeSlice(checked)
        let mut at = usize.ZERO
        while at < nodes.length {
          if let BodyNodeKind.Expression {form: BodyExpression.DirectCall {arguments, ..}, ..} = &nodes[at].kind {
            let supplied = Vector.asSlice<BodyNodeId>(&arguments)
            if supplied.length == 1 {
              if let BodyNodeKind.Expression {ty, form: BodyExpression.Local {local}} = &nodes[supplied[usize.ZERO].index].kind {
                return local.index == usize.ZERO && Shared.with<Type, bool>(&ty, nominalType)
              }
            }
          }
          at = at + usize.ONE
        }
        return false
      },
    )
  }
  return false
}

test effect fn bodyChecksDirectCallsWithoutDemandingCalleeBodies() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let entry = run module("calls.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let library = run module("library.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let missing = run module("missing.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let text = "import library as Library { leaf as selected }\nimport missing as Missing\nservice Clock {}\nfn leaf() -> i32 { return missing }\nfn caller() -> i32 { let value = leaf() return value }\nfn pair(first: u8, second: i32) -> i32 { return second }\nfn contextual() -> i32 { return pair(255, 1) }\nfn nested() -> i32 { return pair(255, leaf()) }\nfn incompatible() -> i32 { return pair(true, 1) }\nfn fixedLocal() -> i32 { let value = 255 return pair(value, 1) }\nfn tooMany() -> i32 { return pair(1, 2, 3) }\nfn section() -> i32 { return pair(1) }\nfn invalidSection() -> i32 { return pair(true) }\nfn emptyCall() -> i32 { return pair() }\nfn nonCallable() -> i32 { let value = 1 return value() }\nfn generic<A, B>(first: A, second: B) -> i32 { return 0 }\nfn excessPrefix() -> i32 { return generic<i32, bool, u8>(1, true) }\nfn wrongPrefixKind() -> i32 { return generic<'static>(1, true) }\nfn unknownPrefixType() -> i32 { return generic<MissingType>(1, true) }\nfn nongenericPrefix() -> i32 { return leaf<i32>() }\nfn choose<A, B>(first: A, second: B) -> A { return move first }\nfn inferUse() -> i32 { return choose(42, true) }\nfn explicitUse() -> i32 { return choose<i32>(42, true) }\nfn conflictUse() -> i32 { return choose<bool>(42, true) }\nfn repeated<T>(first: T, second: T) -> T { return move first }\nfn repeatedConflict() -> i32 { return repeated(42, true) }\nfn resultOnly<T>() -> T { return 0 }\nfn unknownResult() -> i32 { return resultOnly() }\nfn lifetimeFirst<'a, T>(value: T) -> T { return move value }\nfn lifetimePrefix() -> i32 { return lifetimeFirst<'static>(42) }\nfn missingLifetime() -> i32 { return lifetimeFirst(42) }\nfn twoRows<?R, ?S>(value: i32) -> i32 { return value }\nfn positionalRows() -> i32 { return twoRows<&Clock, never>(1) }\nfn missingSecondRow() -> i32 { return twoRows<&Clock>(1) }\nfn left() -> i32 { return right() }\nfn right() -> i32 { return left() }\nfn imported() -> i32 { return selected() }\nfn qualified() -> i32 { return Library.leaf() }\nfn absent() -> i32 { return Library.absent() }\nfn missingCall() -> i32 { return Missing.leaf() }\nstruct Cell { value: i32 }\nimpl Cell { effect<'env> fn store<'env>(self: &mut Self, value: i32) -> () { self.value = value return () } }\nfn environmentUse() -> i32 { let mut cell = Cell {value: 1} run Cell.store(&mut cell, 41) return cell.value }\neffect<'env> fn keep<'env>(value: i32) -> i32 { return value }\nfn staticEnvironment() -> i32 { return run keep(7) }\n"
  let entrySource = run present(text)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let librarySource = run present("pub fn leaf() -> i32 { return missing }\n")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let first = run Revision.publish(&Revision.make(), &entry, &entrySource)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&first, &library, &librarySource)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut semantic = makeSemantic(move revision)
  let mut request = Request.make()
  let caller = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"caller")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let callerBody = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(
    &caller,
    checkedBody,
  )
  if let Option<Shared<TypedBody>>.Some {value} = move callerBody {
    run Testing.expect(
      Shared.with<TypedBody, bool>(
        &value,
        fn(body: &TypedBody) -> bool {
          return bodyCalls(body, &entry, usize.ZERO)
        },
      ) && starts(Semantic.eventLog(&semantic), Family.Body) == 1,
      "a caller keeps its callee signature and runtime obligation without checking the broken leaf",
    )
  } else {
    run Testing.expect(false, "the direct caller has a checked body")
  }
  let contextual = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"contextual")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let contextualBody = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(
    &contextual,
    checkedBody,
  )
  if let Option<Shared<TypedBody>>.Some {value} = move contextualBody {
    run Testing.expect(
      Shared.with<TypedBody, bool>(
        &value,
        fn(body: &TypedBody) -> bool {
          return bodyCalls(body, &entry, 2) && bodyFirstIntegerType(body, b"u8")
        },
      ),
      "source-ordered arguments receive their own immediate parameter contexts",
    )
  } else {
    run Testing.expect(false, "the contextual call has a checked body")
  }
  let nested = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"nested")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let nestedBody = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(
    &nested,
    checkedBody,
  )
  if let Option<Shared<TypedBody>>.Some {value} = move nestedBody {
    run Testing.expect(
      Shared.with<TypedBody, bool>(&value, bodyNestedCalls),
      "nested calls retain each runtime body in argument evaluation order",
    )
  } else {
    run Testing.expect(false, "the nested call has a checked body")
  }
  let incompatible = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"incompatible")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let fixedLocal = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"fixedLocal")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let tooMany = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"tooMany")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let section = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"section")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let invalidSection = run Semantic.demandBody(
    &mut semantic,
    &mut request,
    &entry,
    b"invalidSection",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let emptyCall = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"emptyCall")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let nonCallable = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"nonCallable")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(
      &incompatible,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionSpells(answer, RejectionCode.TypeMismatch, String.utf8Bytes(text), b"true")
      },
    ) && Shared.with<Result<Answer, NoRejection>, bool>(
      &fixedLocal,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionSpells(answer, RejectionCode.TypeMismatch, String.utf8Bytes(text), b"value")
      },
    ) && Shared.with<Result<Answer, NoRejection>, bool>(
      &tooMany,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionCode(answer, RejectionCode.CallArity)
      },
    ) && Shared.with<Result<Answer, NoRejection>, bool>(
      &section,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionSpells(answer, RejectionCode.TypeMismatch, String.utf8Bytes(text), b"pair(1)")
      },
    ) && Shared.with<Result<Answer, NoRejection>, bool>(
      &invalidSection,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionSpells(answer, RejectionCode.TypeMismatch, String.utf8Bytes(text), b"true")
      },
    ) && Shared.with<Result<Answer, NoRejection>, bool>(
      &emptyCall,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionCode(answer, RejectionCode.RedundantCall)
      },
    ) && Shared.with<Result<Answer, NoRejection>, bool>(
      &nonCallable,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionCode(answer, RejectionCode.NotCallable)
      },
    ),
    "direct calls distinguish argument types, invalid arity, callable-valued sections, and non-callables",
  )
  let excessPrefix = run Semantic.demandBody(
    &mut semantic,
    &mut request,
    &entry,
    b"excessPrefix",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let wrongPrefixKind = run Semantic.demandBody(
    &mut semantic,
    &mut request,
    &entry,
    b"wrongPrefixKind",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let nongenericPrefix = run Semantic.demandBody(
    &mut semantic,
    &mut request,
    &entry,
    b"nongenericPrefix",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let unknownPrefixType = run Semantic.demandBody(
    &mut semantic,
    &mut request,
    &entry,
    b"unknownPrefixType",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(
      &excessPrefix,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionSpells(answer, RejectionCode.TypeArity, String.utf8Bytes(text), b"u8")
      },
    ),
    "an excess call prefix rejects at its first extra argument",
  )
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(
      &wrongPrefixKind,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionSpells(
          answer,
          RejectionCode.TypeArgumentKind,
          String.utf8Bytes(text),
          b"'static",
        )
      },
    ),
    "a written call prefix checks its binder kind",
  )
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(
      &unknownPrefixType,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionSpells(
          answer,
          RejectionCode.UnknownName,
          String.utf8Bytes(text),
          b"MissingType",
        )
      },
    ),
    "a written call prefix resolves its type argument",
  )
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(
      &nongenericPrefix,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionSpells(answer, RejectionCode.TypeArity, String.utf8Bytes(text), b"i32")
      },
    ),
    "a nongeneric function rejects a written type argument",
  )
  let inferUse = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"inferUse")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let explicitUse = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"explicitUse")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let lifetimePrefix = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"lifetimePrefix")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let positionalRows = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"positionalRows")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let environmentUse = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"environmentUse")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let staticEnvironment = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"staticEnvironment")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(&environmentUse, fn(answer: &Result<Answer, NoRejection>) -> bool {
      return match move checkedBody(answer) { Option<Shared<TypedBody>>.Some {..} => true Option<Shared<TypedBody>>.None => false }
    }) && Shared.with<Result<Answer, NoRejection>, bool>(&staticEnvironment, fn(answer: &Result<Answer, NoRejection>) -> bool {
      return match move checkedBody(answer) { Option<Shared<TypedBody>>.Some {..} => true Option<Shared<TypedBody>>.None => false }
    }),
    "a written effect environment binder takes the captured borrow's region, or 'static for owned operands",
  )
  let missingLifetime = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"missingLifetime")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let missingSecondRow = run Semantic.demandBody(
    &mut semantic,
    &mut request,
    &entry,
    b"missingSecondRow",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let conflictUse = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"conflictUse")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let repeatedConflict = run Semantic.demandBody(
    &mut semantic,
    &mut request,
    &entry,
    b"repeatedConflict",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let unknownResult = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"unknownResult")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, AnswerView>(&inferUse, inspect).success && Shared.with<
      Result<Answer, NoRejection>,
      AnswerView,
    >(&explicitUse, inspect).success && Shared.with<Result<Answer, NoRejection>, AnswerView>(
      &lifetimePrefix,
      inspect,
    ).success && Shared.with<Result<Answer, NoRejection>, AnswerView>(
      &positionalRows,
      inspect,
    ).success,
    "supplied operands infer after a fixed prefix, while positional lifetime and row arguments retain their kinds",
  )
  let inferredBody = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(
    &inferUse,
    checkedBody,
  )
  let rowBody = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(
    &positionalRows,
    checkedBody,
  )
  if let Option<Shared<TypedBody>>.Some {value: inferredCall} = move inferredBody {
    if let Option<Shared<TypedBody>>.Some {value: rowCall} = move rowBody {
      run Testing.expect(
        Shared.with<TypedBody, bool>(
          &inferredCall,
          fn(body: &TypedBody) -> bool { return bodyCallGenericCount(body, 2) },
        ) && Shared.with<TypedBody, bool>(
          &rowCall,
          fn(body: &TypedBody) -> bool { return bodyCallGenericCount(body, 2) },
        ),
        "typed calls retain completed ordinary and row applications",
      )
    } else {
      run Testing.expect(false, "row call has a checked body")
    }
  } else {
    run Testing.expect(false, "inferred call has a checked body")
  }
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, AnswerView>(&missingLifetime, inspect).success,
    "an omitted lifetime binder that nothing mentions binds 'static, as in the bootstrap",
  )
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(
      &missingSecondRow,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionCode(answer, RejectionCode.UninferredParameter)
      },
    ),
    "an omitted second row binder without operand evidence remains uninferred",
  )
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(
      &conflictUse,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionCode(answer, RejectionCode.TypeMismatch)
      },
    ) && Shared.with<Result<Answer, NoRejection>, bool>(
      &repeatedConflict,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionCode(answer, RejectionCode.TypeMismatch)
      },
    ) && Shared.with<Result<Answer, NoRejection>, bool>(
      &unknownResult,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionCode(answer, RejectionCode.UninferredParameter)
      },
    ),
    "conflicting operand evidence and result-only parameters reject without result inference",
  )
  let left = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"left")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let right = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"right")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, AnswerView>(&left, inspect).success && Shared.with<
      Result<Answer, NoRejection>,
      AnswerView,
    >(&right, inspect).success,
    "written signatures let mutually recursive bodies check without a body-query cycle",
  )
  let imported = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"imported")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let qualified = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"qualified")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let absent = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"absent")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let missingCall = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"missingCall")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let importedBody = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(
    &imported,
    checkedBody,
  )
  if let Option<Shared<TypedBody>>.Some {value} = move importedBody {
    run Testing.expect(
      Shared.with<TypedBody, bool>(
        &value,
        fn(body: &TypedBody) -> bool {
          return bodyCalls(body, &library, usize.ZERO)
        },
      ),
      "selected imports keep the canonical imported callee",
    )
  } else {
    run Testing.expect(false, "the selected imported call has a checked body")
  }
  let qualifiedBody = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(
    &qualified,
    checkedBody,
  )
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, AnswerView>(&qualified, inspect).success && Shared.with<
      Result<Answer, NoRejection>,
      bool,
    >(
      &absent,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionSpells(
          answer,
          RejectionCode.UnknownMember,
          String.utf8Bytes(text),
          b"absent",
        )
      },
    ) && Request.hasDiscovered(&request, &library) && Request.hasDemand(
      &request,
      Family.Signature,
      &library,
    ) && Shared.with<Result<Answer, NoRejection>, bool>(
      &missingCall,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionCode(answer, RejectionCode.MissingModule) && answerHasAbsentSource(
          answer,
          &missing,
        )
      },
    ) && starts(Semantic.eventLog(&semantic), Family.Body) == 31,
    "imported calls retain positive and negative name evidence without demanding library bodies",
  )
  if let Option<Shared<TypedBody>>.Some {value} = move qualifiedBody {
    run Testing.expect(
      Shared.with<TypedBody, bool>(
        &value,
        fn(body: &TypedBody) -> bool {
          return bodyCalls(body, &library, usize.ZERO)
        },
      ),
      "qualified imports use the same canonical callee",
    )
  }
  let mut fresh = Request.make()
  let replayed = run Semantic.demandBody(&mut semantic, &mut fresh, &entry, b"qualified")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut freshNegative = Request.make()
  let replayedAbsence = run Semantic.demandBody(
    &mut semantic,
    &mut freshNegative,
    &entry,
    b"absent",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let replayedMissing = run Semantic.demandBody(
    &mut semantic,
    &mut freshNegative,
    &entry,
    b"missingCall",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, AnswerView>(&replayed, inspect).success && Request.hasDiscovered(
      &fresh,
      &library,
    ) && Request.hasDemand(&fresh, Family.Signature, &library) && Request.hasDemand(
      &fresh,
      Family.Import,
      &entry,
    ) && Shared.with<Result<Answer, NoRejection>, bool>(
      &replayedAbsence,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionCode(answer, RejectionCode.UnknownMember)
      },
    ) && Request.hasDiscovered(&freshNegative, &library) && Request.hasDemand(
      &freshNegative,
      Family.Name,
      &library,
    ) && Shared.with<Result<Answer, NoRejection>, bool>(
      &replayedMissing,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionCode(answer, RejectionCode.MissingModule) && answerHasAbsentSource(
          answer,
          &missing,
        )
      },
    ) && Request.hasDemand(&freshNegative, Family.Import, &entry) && hits(
      Semantic.eventLog(&semantic),
      Family.Body,
    ) > 0,
    "fresh caller hits replay imported signature and source discoveries",
  )
  return ()
}

test effect fn inherentReceiverCallKeepsQualifiedTargetAndOwnerPrecedence() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let entry = run module("inherent-receiver-calls.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let text = "interface Rescue { fn read(value: Self, item: i32) -> i32 }\nstruct Counter {}\nimpl Rescue for Counter { fn read(value: Self, item: i32) -> i32 { return item } }\nimpl Counter { fn read(self: Self) -> i32 { return 42 } fn touch(self: &mut Self) -> i32 { return 1 } }\nfn qualified(value: Counter) -> i32 { return Counter.read(move value) }\nfn receiver(value: Counter) -> i32 { return value.read() }\nfn mutReceiver(value: &mut Counter) -> i32 { return value.touch() }\nfn wrongArity(value: Counter) -> i32 { return value.read(7) }\nstruct Associated {}\nimpl Rescue for Associated { fn read(value: Self, item: i32) -> i32 { return item } }\nimpl Associated { fn read() -> i32 { return 0 } }\nfn associated(value: Associated) -> i32 { return value.read(7) }\n"
  let source = run present(text)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&Revision.make(), &entry, &source)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut semantic = makeSemantic(move revision)
  let mut request = Request.make()
  let qualified = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"qualified")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let receiver = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"receiver")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mutReceiver = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"mutReceiver")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let wrongArity = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"wrongArity")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let associated = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"associated")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let qualifiedBody = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(
    &qualified, checkedBody,
  )
  let receiverBody = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(
    &receiver, checkedBody,
  )
  let mutableBody = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(
    &mutReceiver, checkedBody,
  )
  let mut sameInherent = false
  if let Option<Shared<TypedBody>>.Some {value} = move qualifiedBody {
    sameInherent = Shared.with<TypedBody, bool>(&value, fn(body: &TypedBody) -> bool {
      return bodyCalls(body, &entry, usize.ONE)
    })
  }
  if let Option<Shared<TypedBody>>.Some {value} = move receiverBody {
    sameInherent = sameInherent && Shared.with<TypedBody, bool>(&value, fn(body: &TypedBody) -> bool {
      return bodyCalls(body, &entry, usize.ONE)
    })
  } else {
    sameInherent = false
  }
  let mut retainedMode = false
  if let Option<Shared<TypedBody>>.Some {value} = move mutableBody {
    retainedMode = Shared.with<TypedBody, bool>(&value, fn(body: &TypedBody) -> bool {
      return bodyRetainsReceiverPass(body, BodyReceiverPass.Mutable)
    })
  }
  run Testing.expect(
    sameInherent && retainedMode && rejectsFrom(&wrongArity, RejectionCode.CallArity, offsetOf(text, "value.read(7)", usize.ZERO))
      && rejectsFrom(&associated, RejectionCode.AssociatedFunctionOnValue, offsetOf(text, "read(7)", usize.ONE)),
    "inherent receiver spelling keeps the qualified target and owner errors before conformance",
  )
  return ()
}

test effect fn bodyReusesValidatedCallerAcrossControlledEdits() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let entry = run module("controlled.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let initial = run present(
    "fn leaf() -> i32 { return 1 }\nfn caller() -> i32 { let value = leaf() return value }\n",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let first = run Revision.publish(&Revision.make(), &entry, &initial)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut semantic = makeSemantic(
    run Revision.copy(&first)
      |> Effect.provideMut<Allocator>(&mut allocator),
  )
  let mut coldRequest = Request.make()
  let cold = run Semantic.demandBody(&mut semantic, &mut coldRequest, &entry, b"caller")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut warmRequest = Request.make()
  let warm = run Semantic.demandBody(&mut semantic, &mut warmRequest, &entry, b"caller")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let coldBody = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(
    &cold,
    checkedBody,
  )
  let mut coldCallsLeaf = false
  if let Option<Shared<TypedBody>>.Some {value} = move coldBody {
    coldCallsLeaf = Shared.with<TypedBody, bool>(
      &value,
      fn(body: &TypedBody) -> bool {
        return bodyCalls(body, &entry, usize.ZERO)
      },
    )
  }
  run Testing.expect(
    coldCallsLeaf && Shared.with<Result<Answer, NoRejection>, AnswerView>(&cold, inspect).success && Shared.with<
      Result<Answer, NoRejection>,
      bool,
    >(
      &warm,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return bodyHasCurrentSource(answer, &first)
      },
    ) && Request.hasRoot(&warmRequest, Family.Body, &entry, b"caller") && Request.hasDemand(
      &warmRequest,
      Family.Signature,
      &entry,
    ) && Request.hasDiscovered(&warmRequest, &entry) && hits(Semantic.eventLog(&semantic), Family.Body) == 1 && starts(
      Semantic.eventLog(&semantic),
      Family.Body,
    ) == 1,
    "cold and warm caller demands agree while the leaf body remains undemanded",
  )
  // The leaf edit keeps its width so the caller's syntax positions stay put. Body reuse compares
  // exact spans; the shifted revision below proves that a moved caller is checked afresh.
  let changedBody = run present(
    "fn leaf() -> i32 { return 2 }\nfn caller() -> i32 { let value = leaf() return value }\n",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let second = run Revision.publish(&first, &entry, &changedBody)
    |> Effect.provideMut<Allocator>(&mut allocator)
  Semantic.revise(
    &mut semantic,
    run Revision.copy(&second)
      |> Effect.provideMut<Allocator>(&mut allocator),
  )
  let mut editedRequest = Request.make()
  let edited = run Semantic.demandBody(&mut semantic, &mut editedRequest, &entry, b"caller")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let currentSource = Shared.with<Result<Answer, NoRejection>, bool>(
    &edited,
    fn(answer: &Result<Answer, NoRejection>) -> bool {
      return bodyHasCurrentSource(answer, &second)
    },
  )
  let reuseCount = reused(Semantic.eventLog(&semantic))
  let bodyStarts = starts(Semantic.eventLog(&semantic), Family.Body)
  let bodyHits = hits(Semantic.eventLog(&semantic), Family.Body)
  let hasRoot = Request.hasRoot(&editedRequest, Family.Body, &entry, b"caller")
  let hasSignature = Request.hasDemand(&editedRequest, Family.Signature, &entry)
  let editedBody = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(
    &edited,
    checkedBody,
  )
  let mut editedCallsLeaf = false
  if let Option<Shared<TypedBody>>.Some {value} = move editedBody {
    editedCallsLeaf = Shared.with<TypedBody, bool>(
      &value,
      fn(body: &TypedBody) -> bool {
        return bodyCalls(body, &entry, usize.ZERO)
      },
    )
  }
  run Testing.expect(
    currentSource && editedCallsLeaf && reuseCount == 1 && bodyStarts == 2 && bodyHits == 1 && hasRoot && hasSignature,
    "same-file leaf implementation edit validates and retains the caller payload with current evidence",
  )
  let collisionSource = run present(
    "fn leaf() -> i32 { return 2 }\nfn caller() -> i32 { let value = leaf() return value }\nfn leaf() -> i32 { return 3 }\n",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let collision = run Revision.publish(&second, &entry, &collisionSource)
    |> Effect.provideMut<Allocator>(&mut allocator)
  Semantic.revise(
    &mut semantic,
    run Revision.copy(&collision)
      |> Effect.provideMut<Allocator>(&mut allocator),
  )
  let mut ambiguousRequest = Request.make()
  let ambiguous = run Semantic.demandBody(&mut semantic, &mut ambiguousRequest, &entry, b"caller")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let collisionRejected = Shared.with<Result<Answer, NoRejection>, bool>(
    &ambiguous,
    fn(answer: &Result<Answer, NoRejection>) -> bool {
      return rejectionCode(answer, RejectionCode.Collision)
    },
  )
  run Testing.expect(
    collisionRejected && reused(Semantic.eventLog(&semantic)) == 1,
    "ambiguous callee declaration mapping checks the caller afresh",
  )
  let shiftedSource = run present(
    "\nfn leaf() -> i32 { return 2 }\nfn caller() -> i32 { let value = leaf() return value }\n",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let shifted = run Revision.publish(&collision, &entry, &shiftedSource)
    |> Effect.provideMut<Allocator>(&mut allocator)
  Semantic.revise(
    &mut semantic,
    run Revision.copy(&shifted)
      |> Effect.provideMut<Allocator>(&mut allocator),
  )
  let mut shiftedRequest = Request.make()
  let shiftedAnswer = run Semantic.demandBody(&mut semantic, &mut shiftedRequest, &entry, b"caller")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(
      &shiftedAnswer,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return bodyHasCurrentSource(answer, &shifted)
      },
    ) && reused(Semantic.eventLog(&semantic)) == 1 && starts(
      Semantic.eventLog(&semantic),
      Family.Body,
    ) == 4,
    "a source offset change checks a fresh caller instead of keeping old syntax positions",
  )
  let changedSignatureText = "\nfn leaf() -> bool { return true }\nfn caller() -> i32 { let value = leaf() return value }\n"
  let changedSignature = run present(changedSignatureText)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let fourth = run Revision.publish(&shifted, &entry, &changedSignature)
    |> Effect.provideMut<Allocator>(&mut allocator)
  Semantic.revise(&mut semantic, move fourth)
  let mut invalidRequest = Request.make()
  let invalid = run Semantic.demandBody(&mut semantic, &mut invalidRequest, &entry, b"caller")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(
      &invalid,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionSpells(
          answer,
          RejectionCode.TypeMismatch,
          String.utf8Bytes(changedSignatureText),
          b"value",
        )
      },
    ) && reused(Semantic.eventLog(&semantic)) == 1 && starts(
      Semantic.eventLog(&semantic),
      Family.Body,
    ) == 5,
    "a changed leaf signature invalidates the checked caller",
  )
  return ()
}

test effect fn bodyRechecksImportedPathAndDeclarationEdits() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let entry = run module("importing.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let library = run module("library.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let source = run present(
    "import library as Library\nfn caller() -> i32 { return Library.leaf() }\n",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let first = run Revision.publish(&Revision.make(), &entry, &source)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut semantic = makeSemantic(
    run Revision.copy(&first)
      |> Effect.provideMut<Allocator>(&mut allocator),
  )
  let mut missingRequest = Request.make()
  let missing = run Semantic.demandBody(&mut semantic, &mut missingRequest, &entry, b"caller")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let pathMissing = Shared.with<Result<Answer, NoRejection>, bool>(
    &missing,
    fn(answer: &Result<Answer, NoRejection>) -> bool {
      return rejectionCode(answer, RejectionCode.MissingModule) && answerHasAbsentSource(
        answer,
        &library,
      )
    },
  )
  run Testing.expect(pathMissing, "an absent imported path rejects its actual caller")

  let empty = run present("")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let second = run Revision.publish(&first, &library, &empty)
    |> Effect.provideMut<Allocator>(&mut allocator)
  Semantic.revise(
    &mut semantic,
    run Revision.copy(&second)
      |> Effect.provideMut<Allocator>(&mut allocator),
  )
  let mut absentRequest = Request.make()
  let absent = run Semantic.demandBody(&mut semantic, &mut absentRequest, &entry, b"caller")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let declarationMissing = Shared.with<Result<Answer, NoRejection>, bool>(
    &absent,
    fn(answer: &Result<Answer, NoRejection>) -> bool {
      return rejectionCode(answer, RejectionCode.UnknownMember)
    },
  )
  run Testing.expect(
    declarationMissing,
    "a newly present path still rejects its missing declaration",
  )

  let exported = run present("pub fn leaf() -> i32 { return 1 }\n")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let third = run Revision.publish(&second, &library, &exported)
    |> Effect.provideMut<Allocator>(&mut allocator)
  Semantic.revise(
    &mut semantic,
    run Revision.copy(&third)
      |> Effect.provideMut<Allocator>(&mut allocator),
  )
  let mut foundRequest = Request.make()
  let found = run Semantic.demandBody(&mut semantic, &mut foundRequest, &entry, b"caller")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let foundBody = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(
    &found,
    checkedBody,
  )
  let mut callsLibrary = false
  if let Option<Shared<TypedBody>>.Some {value} = move foundBody {
    callsLibrary = Shared.with<TypedBody, bool>(
      &value,
      fn(body: &TypedBody) -> bool {
        return bodyCalls(body, &library, usize.ZERO)
      },
    )
  }
  let foundSignature = Request.hasDemand(&foundRequest, Family.Signature, &library)
  run Testing.expect(
    callsLibrary && foundSignature,
    "adding the imported declaration checks the caller and records its runtime obligation",
  )

  let fourth = run Revision.publish(&third, &library, &empty)
    |> Effect.provideMut<Allocator>(&mut allocator)
  Semantic.revise(
    &mut semantic,
    run Revision.copy(&fourth)
      |> Effect.provideMut<Allocator>(&mut allocator),
  )
  let mut removedRequest = Request.make()
  let removed = run Semantic.demandBody(&mut semantic, &mut removedRequest, &entry, b"caller")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let removedDeclaration = Shared.with<Result<Answer, NoRejection>, bool>(
    &removed,
    fn(answer: &Result<Answer, NoRejection>) -> bool {
      return rejectionCode(answer, RejectionCode.UnknownMember)
    },
  )
  run Testing.expect(
    removedDeclaration,
    "removing the imported declaration invalidates the checked caller",
  )

  let fifth = run Revision.publish(&fourth, &library, &Option.none<Bytes>())
    |> Effect.provideMut<Allocator>(&mut allocator)
  Semantic.revise(&mut semantic, move fifth)
  let mut removedPathRequest = Request.make()
  let removedPath = run Semantic.demandBody(
    &mut semantic,
    &mut removedPathRequest,
    &entry,
    b"caller",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let pathGone = Shared.with<Result<Answer, NoRejection>, bool>(
    &removedPath,
    fn(answer: &Result<Answer, NoRejection>) -> bool {
      return rejectionCode(answer, RejectionCode.MissingModule) && answerHasAbsentSource(
        answer,
        &library,
      )
    },
  )
  let allRechecked = starts(Semantic.eventLog(&semantic), Family.Body) == 5 && reused(
    Semantic.eventLog(&semantic),
  ) == 0
  run Testing.expect(
    pathGone && allRechecked && Request.hasRoot(&removedPathRequest, Family.Body, &entry, b"caller"),
    "removing the imported path records current negative evidence without retaining an old body",
  )
  return ()
}

effect fn specializationRepresentation(declaration: &DeclarationId) -> Shared<Type>
! OutOfMemoryError ? &mut Allocator {
  let application = run specializationWithArguments(declaration, Vector.make<Argument>())
  let result = run specializationPrimitive(b"i32")
  let regions = Vector.make<Shared<Lifetime>>()
  let contract = run Shared.make<Type>(Type.Callable {mode: CallableMode.Shared, isUnsafe: false,
    environment: run Shared.make<Intersection>(run Intersection.of(Vector.asSlice<Shared<Lifetime>>(&regions))),
    invocationBinders: usize.ZERO, invocationUse: usize.MAX, invocationBounds: Vector.make<Outlives>(),
    parameters: Vector.make<Shared<Type>>(), result: move result})
  return run Type.callableValue(false, run Shared.make<SpecializationApplication>(move application), move contract,
    Vector.make<Shared<Type>>(), Vector.make<CallableFieldInput>())
}

effect fn specializationLifetime(declaration: &DeclarationId, ordinal: usize) -> Shared<Lifetime>
! OutOfMemoryError ? &mut Allocator {
  return run Shared.make<Lifetime>(Lifetime.Parameter {declaration: run DeclarationId.copy(declaration), ordinal: ordinal})
}

test effect fn effectEnvironmentInferenceRetainsTheCompleteIntersection() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run provenEffectEnvironmentClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn provenEffectEnvironmentClaims() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("proven-effect-environment.silk")
  let text = """
effect fn consume<'env, A, E, ?R>(protected: once Effect<'env; A ! E ? R>) -> A ! E ? R {
  return run move protected
}
effect fn capture<'handle, 'data>(handle: &'handle mut i32, bytes: &'data [u8]) -> i32 {
  return handle.*
}
effect fn captureReversed<'data, 'handle>(bytes: &'data [u8], handle: &'handle mut i32) -> i32 {
  return handle.*
}
effect fn capturePair<'first, 'second>(first: &'first mut i32, second: &'second mut i32) -> i32 {
  return first.*
}
fn accepted<'data>(bytes: &'data [u8]) -> i32 {
  let mut handle = 42
  return run consume(capture(&mut handle, bytes))
}
fn reversed<'data>(bytes: &'data [u8]) -> i32 {
  let mut handle = 42
  return run consume(captureReversed(bytes, &mut handle))
}
fn unrelated() -> i32 {
  let mut first = 1
  let mut second = 2
  let firstLoan = &mut first
  let secondLoan = &mut second
  let pending = capturePair(move firstLoan, move secondLoan)
  return run consume(move pending)
}
effect fn consumeFirst<'first>(protected: once Effect<'first; i32>) -> i32 { return run move protected }
fn missingPremise<'first, 'second>(first: &'first mut i32, second: &'second mut i32) -> i32 {
  let promised = capturePair(move first, move second)
  return run consumeFirst<'first>(move promised)
}
fn reversedPremise<'first: 'second, 'second>(first: &'first mut i32, second: &'second mut i32) -> i32 {
  let promised = capturePair(move first, move second)
  return run consumeFirst<'first>(move promised)
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let accepted = run Semantic.demandBody(&mut store, &mut request, &id, b"accepted")
  let reversed = run Semantic.demandBody(&mut store, &mut request, &id, b"reversed")
  let unrelated = run Semantic.demandBody(&mut store, &mut request, &id, b"unrelated")
  run Testing.expect(bodyRetainsEffectRegions(&accepted, b"capture", 2)
      && bodyRetainsEffectRegions(&reversed, b"captureReversed", 2)
      && bodyCompleteEffectArgument(&unrelated),
    "complete environment inference preserves both original regions in either capture order and selects their whole meet for unrelated loans")
  let missing = run Semantic.demandBody(&mut store, &mut request, &id, b"missingPremise")
  let reversedBound = run Semantic.demandBody(&mut store, &mut request, &id, b"reversedPremise")
  run Testing.expect(rejectsSpan(&missing, RejectionCode.IncompatibleCallableSignature, text, "move promised", usize.ZERO)
      && rejectsSpan(&reversedBound, RejectionCode.IncompatibleCallableSignature, text, "move promised", usize.ONE),
    "a fixed longer constituent needs the other constituent's genuine outlives premise; absent and reversed premises never prove it")
}

fn completeEffectEnvironment(ty: &Type) -> Option<Shared<Intersection>> {
  return match &ty.* {
    Type.Effect {mode, environment, ..} => {
      if mode == CallableMode.Once { return Option.some<Shared<Intersection>>(Shared.clone<Intersection>(&environment)) }
      return Option.none<Shared<Intersection>>()
    }
    Type.CallableValue {contract, ..} => Shared.with<Type, Option<Shared<Intersection>>>(&contract, completeEffectEnvironment)
    _ => Option.none<Shared<Intersection>>()
  }
}

fn completeEffectMeet(environment: &Intersection, selected: &Shared<Lifetime>) -> bool {
  let actual = Vector.asSlice<LifetimeMember>(&environment.members)
  if actual.length != 2 || Lifetime.atomCount(selected) != 2
    || Lifetime.equalsShared(&actual[usize.ZERO].region, &actual[usize.ONE].region) { return false }
  return lifetimeHasTwoAtoms(selected, &actual[usize.ZERO].region, &actual[usize.ONE].region)
}

fn completeEffectArgument(body: &TypedBody) -> bool {
  let nodes = TypedBody.nodeSlice(body)
  let mut calls = usize.ZERO
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {form: BodyExpression.DirectCall {declaration, application, arguments, ..}, ..} = &nodes[at].kind {
      if DeclarationId.named(&declaration, b"consume") {
        let supplied = Vector.asSlice<BodyNodeId>(&arguments)
        if supplied.length != usize.ONE || supplied[usize.ZERO].index >= nodes.length { return false }
        if let BodyNodeKind.Expression {ty, form: BodyExpression.Move {value, ..}} = &nodes[supplied[usize.ZERO].index].kind {
          if value.index >= nodes.length { return false }
          if let BodyNodeKind.Expression {form: BodyExpression.Local {local}, ..} = &nodes[value.index].kind {
            let mut definitions = usize.ZERO
            let mut node = usize.ZERO
            while node < nodes.length {
              if let BodyNodeKind.LocalBinding {local: bound, initializer} = &nodes[node].kind {
                if bound.index == local.index {
                  if initializer.index >= nodes.length { return false }
                  if let BodyNodeKind.Expression {form: BodyExpression.DirectCall {declaration: producer, ..}, ..} = &nodes[initializer.index].kind {
                    if !DeclarationId.named(&producer, b"capturePair") { return false }
                  } else { return false }
                  definitions = definitions + usize.ONE
                }
              }
              node = node + usize.ONE
            }
            if definitions != usize.ONE { return false }
          } else { return false }
          let source = Shared.with<Type, Option<Shared<Intersection>>>(&ty, completeEffectEnvironment)
          if let Option<Shared<Intersection>>.Some {value: environment} = move source {
            let meet = Shared.with<SpecializationApplication, Option<Shared<Lifetime>>>(&application,
              fn(selected: &SpecializationApplication) -> Option<Shared<Lifetime>> {
                let given = Vector.asSlice<Argument>(&selected.arguments)
                let ordinals = Vector.asSlice<usize>(&selected.argumentOrdinals)
                if !DeclarationId.equals(SpecializationApplication.bodyDeclaration(selected), &declaration)
                  || given.length == usize.ZERO || ordinals.length != given.length
                  || ordinals[usize.ZERO] != usize.ZERO { return Option.none<Shared<Lifetime>>() }
                return match &given[usize.ZERO] {
                  Argument.Lifetime {value: boundRegion} => Option.some<Shared<Lifetime>>(Shared.clone<Lifetime>(&boundRegion))
                  _ => Option.none<Shared<Lifetime>>()
                }
              })
            if let Option<Shared<Lifetime>>.Some {value: region} = move meet {
              if !Shared.with<Intersection, bool>(&environment,
                fn(actual: &Intersection) -> bool { return completeEffectMeet(actual, &region) }) { return false }
            } else { return false }
          } else { return false }
        } else { return false }
        calls = calls + usize.ONE
      }
    }
    at = at + usize.ONE
  }
  return calls == usize.ONE
}

fn bodyCompleteEffectArgument(answer: &Shared<Result<Answer, NoRejection>>) -> bool {
  let body = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(answer, checkedBody)
  if let Option<Shared<TypedBody>>.Some {value} = move body { return Shared.with<TypedBody, bool>(&value, completeEffectArgument) }
  return false
}

fn effectRegionCount(value: &Type) -> usize {
  return match &value.* {
    Type.Effect {environment, ..} => Shared.with<Intersection, usize>(&environment,
      fn(regions: &Intersection) -> usize { return Vector.length<LifetimeMember>(&regions.members) })
    Type.CallableValue {contract, ..} => Shared.with<Type, usize>(&contract, effectRegionCount)
    _ => usize.MAX
  }
}

fn bodyRetainsEffectRegions(answer: &Shared<Result<Answer, NoRejection>>, name: &[u8], count: usize) -> bool {
  let body = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(answer, checkedBody)
  if let Option<Shared<TypedBody>>.Some {value} = move body {
    return Shared.with<TypedBody, bool>(&value, fn(typed: &TypedBody) -> bool {
      let nodes = TypedBody.nodeSlice(typed)
      let mut at = usize.ZERO
      while at < nodes.length {
        if let BodyNodeKind.Expression {ty, form: BodyExpression.DirectCall {declaration, ..}} = &nodes[at].kind {
          if DeclarationId.named(&declaration, name) && Shared.with<Type, usize>(&ty, effectRegionCount) == count { return true }
        }
        at = at + usize.ONE
      }
      return false
    })
  }
  return false
}

effect fn environmentEffect(regions: &[Shared<Lifetime>]) -> Shared<Type>
! OutOfMemoryError ? &mut Allocator {
  let value = run specializationPrimitive(b"i32")
  return run Shared.make<Type>(Type.Effect {
    mode: CallableMode.Once,
    environment: run Shared.make<Intersection>(run Intersection.of(regions)),
    success: Shared.clone<Type>(&value),
    failure: move value,
    requirements: run Shared.make<Row>(Row.empty()),
  })
}

effect fn environmentCallable(
  regions: &[Shared<Lifetime>],
  binders: usize,
  bounds: Vector<Outlives>,
) -> Shared<Type> ! OutOfMemoryError ? &mut Allocator {
  return run Shared.make<Type>(Type.Callable {
    mode: CallableMode.Once,
    isUnsafe: false,
    environment: run Shared.make<Intersection>(run Intersection.of(regions)),
    invocationBinders: binders, invocationUse: usize.MAX,
    invocationBounds: move bounds,
    parameters: Vector.make<Shared<Type>>(),
    result: run specializationPrimitive(b"i32"),
  })
}

fn unified(value: &Unification) -> bool {
  return match &value.* { Unification.Unified => true _ => false }
}

fn undecided(value: &Unification) -> bool {
  return match &value.* { Unification.Undetermined {..} => true _ => false }
}

effect fn exactEnvironment(
  left: &Shared<Type>,
  right: &Shared<Type>,
  variables: &[Shared<DeclarationId>],
  bindings: &mut Vector<Binding>,
) -> Unification ! OutOfMemoryError ? &mut Allocator {
  return run Type.unify(left, right, variables, Comparison.Exact, &mut bindings.*)
}

effect fn bindingsProveEqual(left: &Shared<Type>, right: &Shared<Type>, bindings: &[Binding]) -> bool
! OutOfMemoryError ? &mut Allocator {
  let resolvedLeft = run Type.applyBindings(left, bindings, true)
  let resolvedRight = run Type.applyBindings(right, bindings, true)
  return run Type.equalsShared(&resolvedLeft, &resolvedRight)
}

// Literal atom expectations stay independent of canonical ordering and factory normalization.
fn lifetimeHasTwoAtoms(value: &Shared<Lifetime>, first: &Shared<Lifetime>, second: &Shared<Lifetime>) -> bool {
  if Lifetime.atomCount(value) != 2 || Lifetime.equalsShared(first, second) { return false }
  let a = Lifetime.atomAt(value, usize.ZERO)
  let b = Lifetime.atomAt(value, usize.ONE)
  return (Lifetime.equalsShared(&a, first) && Lifetime.equalsShared(&b, second))
    || (Lifetime.equalsShared(&a, second) && Lifetime.equalsShared(&b, first))
}

fn environmentBindingIsMeet(bindings: &[Binding], owner: &DeclarationId, ordinal: usize,
  first: &Shared<Lifetime>, second: &Shared<Lifetime>) -> bool {
  if bindings.length != usize.ONE || bindings[usize.ZERO].ordinal != ordinal
    || !Shared.with<DeclarationId, bool>(&bindings[usize.ZERO].declaration,
      fn(found: &DeclarationId) -> bool { return DeclarationId.equals(found, owner) }) { return false }
  return match &bindings[usize.ZERO].value {
    Argument.Lifetime {value} => lifetimeHasTwoAtoms(&value, first, second)
    _ => false
  }
}

// Executable environments are normalized sets. These actor-level controls exercise inference
// without parser, body, or backend work and ensure a successful answer carries independently
// checkable substitution evidence.
test effect fn executableEnvironmentInferenceIsSetBasedAndTransactional() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run executableEnvironmentInferenceClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn executableEnvironmentInferenceClaims() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("executable-environment-inference.silk")
  let mut ownerSteps = Vector.make<OwnerStep>()
  run Vector.append<OwnerStep>(&mut ownerSteps, OwnerStep {kind: OwnerKind.Function,
    name: Option.some<Bytes>(run Bytes.copy(b"owner")), occurrence: usize.ZERO})
  let owner = DeclarationId.fromParts(run ModuleId.copy(&id), move ownerSteps)
  let mut foreignSteps = Vector.make<OwnerStep>()
  run Vector.append<OwnerStep>(&mut foreignSteps, OwnerStep {kind: OwnerKind.Function,
    name: Option.some<Bytes>(run Bytes.copy(b"foreign")), occurrence: usize.ZERO})
  let foreign = DeclarationId.fromParts(move id, move foreignSteps)
  let parameterA = run specializationLifetime(&owner, usize.ZERO)
  let parameterB = run specializationLifetime(&owner, usize.ONE)
  let foreignParameter = run specializationLifetime(&foreign, usize.ZERO)
  let staticRegion = run Shared.make<Lifetime>(Lifetime.Static)
  let localX = run Shared.make<Lifetime>(Lifetime.Local {declaration: run DeclarationId.copy(&owner), ordinal: 10})
  let localY = run Shared.make<Lifetime>(Lifetime.Local {declaration: run DeclarationId.copy(&owner), ordinal: 11})
  let mut variables = Vector.make<Shared<DeclarationId>>()
  let ownerIdentity = run Shared.make<DeclarationId>(run DeclarationId.copy(&owner))
  run Vector.append<Shared<DeclarationId>>(&mut variables, Shared.clone<DeclarationId>(&ownerIdentity))

  let mut oneA = Vector.make<Shared<Lifetime>>()
  run Vector.append<Shared<Lifetime>>(&mut oneA, Shared.clone<Lifetime>(&parameterA))
  let openStatic = run environmentEffect(Vector.asSlice<Shared<Lifetime>>(&oneA))
  let emptyRegions = Vector.make<Shared<Lifetime>>()
  let empty = run environmentEffect(Vector.asSlice<Shared<Lifetime>>(&emptyRegions))
  let mut staticBindings = Vector.make<Binding>()
  let staticAnswer = run exactEnvironment(&openStatic, &empty, Vector.asSlice<Shared<DeclarationId>>(&variables), &mut staticBindings)
  run Testing.expect(unified(&staticAnswer) && Vector.length<Binding>(&staticBindings) == usize.ONE
      && run bindingsProveEqual(&openStatic, &empty, Vector.asSlice<Binding>(&staticBindings)),
    "one fresh environment variable binds to the canonical empty static intersection")

  let mut preboundLocal = Vector.make<Binding>()
  run Vector.append<Binding>(&mut preboundLocal, Binding {declaration: Shared.clone<DeclarationId>(&ownerIdentity),
    ordinal: usize.ZERO, value: Argument.Lifetime {value: Shared.clone<Lifetime>(&localX)}})
  let localAnswer = run exactEnvironment(&openStatic, &empty, Vector.asSlice<Shared<DeclarationId>>(&variables), &mut preboundLocal)
  run Testing.expect(undecided(&localAnswer) && Vector.length<Binding>(&preboundLocal) == usize.ONE,
    "an existing local assignment cannot be overwritten by contradictory static evidence")

  let mut preboundStatic = Vector.make<Binding>()
  run Vector.append<Binding>(&mut preboundStatic, Binding {declaration: Shared.clone<DeclarationId>(&ownerIdentity),
    ordinal: usize.ZERO, value: Argument.Lifetime {value: Shared.clone<Lifetime>(&staticRegion)}})
  let repeatedStatic = run exactEnvironment(&openStatic, &empty, Vector.asSlice<Shared<DeclarationId>>(&variables), &mut preboundStatic)
  run Testing.expect(unified(&repeatedStatic) && Vector.length<Binding>(&preboundStatic) == usize.ONE
      && run bindingsProveEqual(&openStatic, &empty, Vector.asSlice<Binding>(&preboundStatic)),
    "a prebound static slot proves equality without appending duplicate evidence")

  let mut leftRegions = Vector.make<Shared<Lifetime>>()
  run Vector.append<Shared<Lifetime>>(&mut leftRegions, Shared.clone<Lifetime>(&parameterA))
  run Vector.append<Shared<Lifetime>>(&mut leftRegions, Shared.clone<Lifetime>(&localX))
  let left = run environmentEffect(Vector.asSlice<Shared<Lifetime>>(&leftRegions))
  let mut rightRegions = Vector.make<Shared<Lifetime>>()
  run Vector.append<Shared<Lifetime>>(&mut rightRegions, Shared.clone<Lifetime>(&localY))
  run Vector.append<Shared<Lifetime>>(&mut rightRegions, Shared.clone<Lifetime>(&localX))
  let right = run environmentEffect(Vector.asSlice<Shared<Lifetime>>(&rightRegions))
  let mut setBindings = Vector.make<Binding>()
  let setAnswer = run exactEnvironment(&left, &right, Vector.asSlice<Shared<DeclarationId>>(&variables), &mut setBindings)
  run Testing.expect(unified(&setAnswer) && Vector.length<Binding>(&setBindings) == usize.ONE
      && run bindingsProveEqual(&left, &right, Vector.asSlice<Binding>(&setBindings)),
    "set difference binds the unmatched region rather than the member at the same insertion position")

  let mut reversed = Vector.make<Shared<Lifetime>>()
  run Vector.append<Shared<Lifetime>>(&mut reversed, Shared.clone<Lifetime>(&localX))
  run Vector.append<Shared<Lifetime>>(&mut reversed, Shared.clone<Lifetime>(&localY))
  let reversedRight = run environmentEffect(Vector.asSlice<Shared<Lifetime>>(&reversed))
  let mut reverseBindings = Vector.make<Binding>()
  let reverseAnswer = run exactEnvironment(&left, &reversedRight, Vector.asSlice<Shared<DeclarationId>>(&variables), &mut reverseBindings)
  run Testing.expect(unified(&reverseAnswer) && run bindingsProveEqual(&left, &reversedRight, Vector.asSlice<Binding>(&reverseBindings)),
    "the same environment equation is independent of rigid member insertion order")

  let mut duplicateRegions = Vector.make<Shared<Lifetime>>()
  run Vector.append<Shared<Lifetime>>(&mut duplicateRegions, Shared.clone<Lifetime>(&localX))
  run Vector.append<Shared<Lifetime>>(&mut duplicateRegions, Shared.clone<Lifetime>(&staticRegion))
  run Vector.append<Shared<Lifetime>>(&mut duplicateRegions, Shared.clone<Lifetime>(&localX))
  let normalized = run environmentEffect(Vector.asSlice<Shared<Lifetime>>(&duplicateRegions))
  let mut singleRegion = Vector.make<Shared<Lifetime>>()
  run Vector.append<Shared<Lifetime>>(&mut singleRegion, Shared.clone<Lifetime>(&localX))
  let single = run environmentEffect(Vector.asSlice<Shared<Lifetime>>(&singleRegion))
  let mut normalizedBindings = Vector.make<Binding>()
  let normalizedAnswer = run exactEnvironment(&normalized, &single, Vector.asSlice<Shared<DeclarationId>>(&variables), &mut normalizedBindings)
  run Testing.expect(unified(&normalizedAnswer) && Vector.length<Binding>(&normalizedBindings) == usize.ZERO,
    "duplicate members and static identity normalize before set cardinality is compared")

  let mut aggregateBindings = Vector.make<Binding>()
  let aggregateAnswer = run exactEnvironment(&openStatic, &right,
    Vector.asSlice<Shared<DeclarationId>>(&variables), &mut aggregateBindings)
  run Testing.expect(unified(&aggregateAnswer)
      && environmentBindingIsMeet(Vector.asSlice<Binding>(&aggregateBindings), &owner, usize.ZERO, &localX, &localY)
      && (run bindingsProveEqual(&openStatic, &right, Vector.asSlice<Binding>(&aggregateBindings))),
    "one fresh lifetime slot retains both unmatched environment atoms under its original owner and ordinal")

  let mut rightOpenRegions = Vector.make<Shared<Lifetime>>()
  run Vector.append<Shared<Lifetime>>(&mut rightOpenRegions, Shared.clone<Lifetime>(&parameterA))
  let rightOpen = run environmentEffect(Vector.asSlice<Shared<Lifetime>>(&rightOpenRegions))
  let mut rightOpenBindings = Vector.make<Binding>()
  let rightOpenAnswer = run exactEnvironment(&single, &rightOpen, Vector.asSlice<Shared<DeclarationId>>(&variables), &mut rightOpenBindings)
  run Testing.expect(unified(&rightOpenAnswer) && run bindingsProveEqual(&single, &rightOpen, Vector.asSlice<Binding>(&rightOpenBindings)),
    "a sole variable on the right receives the nonstatic environment member symmetrically")

  let mut foreignRegions = Vector.make<Shared<Lifetime>>()
  run Vector.append<Shared<Lifetime>>(&mut foreignRegions, Shared.clone<Lifetime>(&foreignParameter))
  let foreignEffect = run environmentEffect(Vector.asSlice<Shared<Lifetime>>(&foreignRegions))
  let mut foreignBindings = Vector.make<Binding>()
  let foreignAnswer = run exactEnvironment(&foreignEffect, &empty, Vector.asSlice<Shared<DeclarationId>>(&variables), &mut foreignBindings)
  run Testing.expect(undecided(&foreignAnswer) && Vector.length<Binding>(&foreignBindings) == usize.ZERO,
    "a foreign-owner unlisted parameter remains rigid")

  let mut twoOpen = Vector.make<Shared<Lifetime>>()
  run Vector.append<Shared<Lifetime>>(&mut twoOpen, Shared.clone<Lifetime>(&parameterA))
  run Vector.append<Shared<Lifetime>>(&mut twoOpen, Shared.clone<Lifetime>(&parameterB))
  let twoOpenEffect = run environmentEffect(Vector.asSlice<Shared<Lifetime>>(&twoOpen))
  let mut collapsed = Vector.make<Binding>()
  run Vector.append<Binding>(&mut collapsed, Binding {declaration: Shared.clone<DeclarationId>(&ownerIdentity), ordinal: usize.ZERO,
    value: Argument.Lifetime {value: Shared.clone<Lifetime>(&localX)}})
  run Vector.append<Binding>(&mut collapsed, Binding {declaration: Shared.clone<DeclarationId>(&ownerIdentity), ordinal: usize.ONE,
    value: Argument.Lifetime {value: Shared.clone<Lifetime>(&localX)}})
  let collapsedAnswer = run exactEnvironment(&twoOpenEffect, &right, Vector.asSlice<Shared<DeclarationId>>(&variables), &mut collapsed)
  run Testing.expect(undecided(&collapsedAnswer) && Vector.length<Binding>(&collapsed) == 2,
    "two prebound slots that collapse to X cannot cover the distinct set containing X and Y")

  let mut callableOpenRegions = Vector.make<Shared<Lifetime>>()
  run Vector.append<Shared<Lifetime>>(&mut callableOpenRegions, Shared.clone<Lifetime>(&parameterA))
  let callableOpen = run environmentCallable(Vector.asSlice<Shared<Lifetime>>(&callableOpenRegions), usize.ONE, Vector.make<Outlives>())
  let callableBinderMismatch = run environmentCallable(Vector.asSlice<Shared<Lifetime>>(&singleRegion), 2, Vector.make<Outlives>())
  let mut binderBindings = Vector.make<Binding>()
  let binderAnswer = run exactEnvironment(&callableOpen, &callableBinderMismatch,
    Vector.asSlice<Shared<DeclarationId>>(&variables), &mut binderBindings)
  run Testing.expect(undecided(&binderAnswer) && Vector.length<Binding>(&binderBindings) == usize.ZERO,
    "environment inference cannot bypass a callable invocation-binder mismatch")
  let invocationZero = run Shared.make<Lifetime>(Lifetime.Invocation {ordinal: usize.ZERO})
  let invocationOne = run Shared.make<Lifetime>(Lifetime.Invocation {ordinal: usize.ONE})
  let mut leftBounds = Vector.make<Outlives>()
  run Vector.append<Outlives>(&mut leftBounds, Outlives {longer: Shared.clone<Lifetime>(&invocationZero),
    shorter: Shared.clone<Lifetime>(&invocationOne)})
  let mut rightBounds = Vector.make<Outlives>()
  run Vector.append<Outlives>(&mut rightBounds, Outlives {longer: move invocationOne, shorter: move invocationZero})
  let callableBoundLeft = run environmentCallable(Vector.asSlice<Shared<Lifetime>>(&callableOpenRegions), 2, move leftBounds)
  let callableBoundRight = run environmentCallable(Vector.asSlice<Shared<Lifetime>>(&singleRegion), 2, move rightBounds)
  let mut boundBindings = Vector.make<Binding>()
  let boundAnswer = run exactEnvironment(&callableBoundLeft, &callableBoundRight,
    Vector.asSlice<Shared<DeclarationId>>(&variables), &mut boundBindings)
  run Testing.expect(undecided(&boundAnswer) && Vector.length<Binding>(&boundBindings) == usize.ZERO,
    "environment inference cannot bypass different callable invocation outlives bounds")

  let atoms = [Shared.clone<Lifetime>(&localX), Shared.clone<Lifetime>(&localY)]
  let meet = run Lifetime.meet(&atoms)
  let backwards = [Shared.clone<Lifetime>(&localY), Shared.clone<Lifetime>(&staticRegion),
    Shared.clone<Lifetime>(&localX), Shared.clone<Lifetime>(&localY)]
  let reorderedMeet = run Lifetime.meet(&backwards)
  let nestedAtoms = [Shared.clone<Lifetime>(&meet), Shared.clone<Lifetime>(&localX)]
  let nestedMeet = run Lifetime.meet(&nestedAtoms)
  let singletonAtoms = [Shared.clone<Lifetime>(&localX), Shared.clone<Lifetime>(&staticRegion),
    Shared.clone<Lifetime>(&localX)]
  let singleton = run Lifetime.meet(&singletonAtoms)
  let emptyMeet = run Lifetime.meet(Vector.asSlice<Shared<Lifetime>>(&emptyRegions))
  run Testing.expect(lifetimeHasTwoAtoms(&meet, &localX, &localY)
      && lifetimeHasTwoAtoms(&reorderedMeet, &localX, &localY)
      && lifetimeHasTwoAtoms(&nestedMeet, &localX, &localY)
      && Lifetime.equalsShared(&meet, &meet) && Lifetime.equalsShared(&meet, &reorderedMeet)
      && !Lifetime.equalsShared(&meet, &localX)
      && Lifetime.atomCount(&singleton) == usize.ONE && Lifetime.equalsShared(&singleton, &localX)
      && Lifetime.equalsShared(&emptyMeet, &staticRegion),
    "canonical meets flatten shared members, ignore Static and duplicates, and retain two distinct atoms")

  let chainAtoms = [Shared.clone<Lifetime>(&parameterB), Shared.clone<Lifetime>(&localX)]
  let chainMeet = run Lifetime.meet(&chainAtoms)
  let mut chainBindings = Vector.make<Binding>()
  run Vector.append<Binding>(&mut chainBindings, Binding {declaration: Shared.clone<DeclarationId>(&ownerIdentity),
    ordinal: usize.ZERO, value: Argument.Lifetime {value: move chainMeet}})
  run Vector.append<Binding>(&mut chainBindings, Binding {declaration: Shared.clone<DeclarationId>(&ownerIdentity),
    ordinal: usize.ONE, value: Argument.Lifetime {value: Shared.clone<Lifetime>(&localY)}})
  let chainSnapshot = run preboundUnionSeedCopies(Vector.asSlice<Binding>(&chainBindings))
  let firstReference = run environmentReference(&parameterA)
  let simultaneous = run Type.applyBindings(&firstReference, Vector.asSlice<Binding>(&chainBindings), true)
  let simultaneousAtoms = [Shared.clone<Lifetime>(&parameterB), Shared.clone<Lifetime>(&localX)]
  let simultaneousMeet = run Lifetime.meet(&simultaneousAtoms)
  let simultaneousExpected = run environmentReference(&simultaneousMeet)
  let fullyResolved = run environmentReference(&meet)
  let resolvedAnswer = run exactEnvironment(&firstReference, &fullyResolved,
    Vector.asSlice<Shared<DeclarationId>>(&variables), &mut chainBindings)
  run Testing.expect((run Type.equalsShared(&simultaneous, &simultaneousExpected))
      && unified(&resolvedAnswer)
      && (run preboundUnionSeedsEqual(Vector.asSlice<Binding>(&chainBindings), Vector.asSlice<Binding>(&chainSnapshot))),
    "public substitution inserts a meet simultaneously while exact inference resolves seeded members without changing seeds")

  let cyclicAtoms = [Shared.clone<Lifetime>(&parameterA), Shared.clone<Lifetime>(&localX)]
  let cyclicMeet = run Lifetime.meet(&cyclicAtoms)
  let cyclicReference = run environmentReference(&cyclicMeet)
  let mut directCycle = Vector.make<Binding>()
  let directCycleAnswer = run exactEnvironment(&firstReference, &cyclicReference,
    Vector.asSlice<Shared<DeclarationId>>(&variables), &mut directCycle)
  run Testing.expect(undecided(&directCycleAnswer) && Vector.length<Binding>(&directCycle) == usize.ZERO,
    "a fresh region cannot bind to a meet containing itself and publishes no cyclic evidence")
  let mut indirectCycle = Vector.make<Binding>()
  run Vector.append<Binding>(&mut indirectCycle, Binding {declaration: Shared.clone<DeclarationId>(&ownerIdentity),
    ordinal: usize.ZERO, value: Argument.Lifetime {value: Shared.clone<Lifetime>(&parameterB)}})
  let indirectSnapshot = run preboundUnionSeedCopies(Vector.asSlice<Binding>(&indirectCycle))
  let secondReference = run environmentReference(&parameterB)
  let indirectAnswer = run exactEnvironment(&secondReference, &cyclicReference,
    Vector.asSlice<Shared<DeclarationId>>(&variables), &mut indirectCycle)
  run Testing.expect(undecided(&indirectAnswer)
      && (run preboundUnionSeedsEqual(Vector.asSlice<Binding>(&indirectCycle), Vector.asSlice<Binding>(&indirectSnapshot))),
    "an indirect seeded route back to the inferred region rejects without changing the original seed")
  let mut ambiguousBindings = Vector.make<Binding>()
  let ambiguousAnswer = run exactEnvironment(&twoOpenEffect, &right,
    Vector.asSlice<Shared<DeclarationId>>(&variables), &mut ambiguousBindings)
  run Testing.expect(undecided(&ambiguousAnswer) && Vector.length<Binding>(&ambiguousBindings) == usize.ZERO,
    "two free regions do not choose an arbitrary partition of a complete environment")
  let foreignAtoms = [Shared.clone<Lifetime>(&foreignParameter), Shared.clone<Lifetime>(&localX)]
  let foreignMeet = run Lifetime.meet(&foreignAtoms)
  let foreignReference = run environmentReference(&foreignMeet)
  let mut hiddenForeignBindings = Vector.make<Binding>()
  let hiddenForeign = run exactEnvironment(&foreignReference, &fullyResolved,
    Vector.asSlice<Shared<DeclarationId>>(&variables), &mut hiddenForeignBindings)
  run Testing.expect(match &hiddenForeign { Unification.Distinct => true _ => false }
      && Vector.length<Binding>(&hiddenForeignBindings) == usize.ZERO
      && Type.hasOpenParameters(&foreignReference),
    "a foreign declaration-owned atom remains open and rigid when nested inside a meet")
  let hiddenInvocation = run Shared.make<Lifetime>(Lifetime.Invocation {ordinal: 7})
  let invocationAtoms = [Shared.clone<Lifetime>(&hiddenInvocation), Shared.clone<Lifetime>(&localX)]
  let invocationMeet = run Lifetime.meet(&invocationAtoms)
  let invocationReference = run environmentReference(&invocationMeet)
  let mut invocationOrdinals = Vector.make<usize>()
  run Type.collectInvocations(&invocationReference, &mut invocationOrdinals)
  let recordedInvocations = Vector.asSlice<usize>(&invocationOrdinals)
  let opened = run Type.openInvocation(&invocationReference, &foreign)
  let openedRegion = run specializationLifetime(&foreign, 7)
  let openedAtoms = [Shared.clone<Lifetime>(&openedRegion), Shared.clone<Lifetime>(&localX)]
  let openedMeet = run Lifetime.meet(&openedAtoms)
  let openedExpected = run environmentReference(&openedMeet)
  run Testing.expect(recordedInvocations.length == usize.ONE && recordedInvocations[usize.ZERO] == 7
      && (run Type.equalsShared(&opened, &openedExpected)),
    "a meet-hidden invocation is collected and opens into the actual supplied declaration owner")
  return ()
}

// Fixed-set comparison must use established evidence, even when no member has a free variable.
// The environment controls above never compare prebound nominal union members.
test effect fn preboundUnionMembersResolveNestedEvidenceWithoutChangingSeeds() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run preboundUnionEvidenceClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn preboundUnionOwner(id: &ModuleId, name: &[u8]) -> DeclarationId
! OutOfMemoryError ? &mut Allocator {
  let mut steps = Vector.make<OwnerStep>()
  run Vector.append<OwnerStep>(&mut steps, OwnerStep {kind: OwnerKind.Function,
    name: Option.some<Bytes>(run Bytes.copy(name)), occurrence: usize.ZERO})
  return DeclarationId.fromParts(run ModuleId.copy(id), move steps)
}

effect fn preboundUnionPair(first: &Shared<Type>, second: &Shared<Type>) -> Shared<Type>
! OutOfMemoryError ? &mut Allocator {
  let mut members = Vector.make<Shared<Type>>()
  run Type.joinMember(&mut members, first)
  run Type.joinMember(&mut members, second)
  return run Shared.make<Type>(Type.Union {members: move members})
}

effect fn preboundUnionNominal(owner: &DeclarationId, referent: &Shared<Type>, region: &Shared<Lifetime>,
  access: Access, row: &Shared<Row>) -> Shared<Type>
! OutOfMemoryError ? &mut Allocator {
  let loan = run Shared.make<Type>(Type.Reference {referent: Shared.clone<Type>(referent),
    lifetime: Shared.clone<Lifetime>(region), access: access})
  let mut arguments = Vector.make<Argument>()
  run Vector.append<Argument>(&mut arguments, Argument.Type {value: move loan})
  run Vector.append<Argument>(&mut arguments, Argument.Row {value: Shared.clone<Row>(row)})
  return run specializationNominal(owner, move arguments)
}

effect fn preboundUnionRow(owner: &Shared<DeclarationId>, ordinal: usize) -> Shared<Row>
! OutOfMemoryError ? &mut Allocator {
  let mut row = Row.empty()
  run Row.include(&mut row, RowParameter {declaration: Shared.clone<DeclarationId>(owner), ordinal: ordinal})
  return run Shared.make<Row>(move row)
}

effect fn preboundUnionSeedCopies(bindings: &[Binding]) -> Vector<Binding>
! OutOfMemoryError ? &mut Allocator {
  let mut result = Vector.make<Binding>()
  let mut at = usize.ZERO
  while at < bindings.length {
    run Vector.append<Binding>(&mut result, Binding {declaration: Shared.clone<DeclarationId>(&bindings[at].declaration),
      ordinal: bindings[at].ordinal, value: Argument.copy(&bindings[at].value)})
    at = at + usize.ONE
  }
  return move result
}

effect fn preboundUnionSeedsEqual(first: &[Binding], second: &[Binding]) -> bool
! OutOfMemoryError ? &mut Allocator {
  if first.length != second.length { return false }
  let mut at = usize.ZERO
  while at < first.length {
    if first[at].ordinal != second[at].ordinal || !sameStep(&first[at].declaration, &second[at].declaration) { return false }
    let equal = match &first[at].value {
      Argument.Type {value} => match &second[at].value {
        Argument.Type {value: other} => run Type.equalsShared(&value, &other)
        _ => false
      }
      Argument.Lifetime {value} => match &second[at].value {
        Argument.Lifetime {value: other} => Lifetime.equalsShared(&value, &other)
        _ => false
      }
      Argument.Row {value} => match &second[at].value {
        Argument.Row {value: other} => run Row.equalsShared(&value, &other)
        _ => false
      }
    }
    if !equal { return false }
    at = at + usize.ONE
  }
  return true
}

effect fn preboundUnionComparison(left: &Shared<Type>, right: &Shared<Type>, variables: &[Shared<DeclarationId>],
  bindings: &mut Vector<Binding>, seeds: &[Binding], comparison: Comparison, expected: usize) -> bool
! OutOfMemoryError ? &mut Allocator {
  let result = run Type.unify(left, right, variables, comparison, &mut bindings.*)
  let outcome: usize = match &result {
    Unification.Unified => usize.ZERO
    Unification.Distinct => usize.ONE
    Unification.Undetermined {..} => 2
  }
  return outcome == expected && run preboundUnionSeedsEqual(Vector.asSlice<Binding>(&bindings.*), seeds)
}

effect fn preboundUnionEvidenceClaims() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("prebound-union-evidence.silk")
  let owner = run preboundUnionOwner(&id, b"owner")
  let firstOwner = run preboundUnionOwner(&id, b"A")
  let secondOwner = run preboundUnionOwner(&id, b"B")
  let foreign = run preboundUnionOwner(&id, b"foreign")
  let identity = run Shared.make<DeclarationId>(run DeclarationId.copy(&owner))
  let foreignIdentity = run Shared.make<DeclarationId>(run DeclarationId.copy(&foreign))
  let mut owners = Vector.make<Shared<DeclarationId>>()
  run Vector.append<Shared<DeclarationId>>(&mut owners, Shared.clone<DeclarationId>(&identity))
  let variables = Vector.asSlice<Shared<DeclarationId>>(&owners)
  let integer = run specializationPrimitive(b"i32")
  let boolean = run specializationPrimitive(b"bool")
  let typeFirst = run specializationParameter(&owner, usize.ZERO)
  let typeNext = run specializationParameter(&owner, usize.ONE)
  let lifetimeFirst = run specializationLifetime(&owner, 2)
  let lifetimeNext = run specializationLifetime(&owner, 3)
  let local = run Shared.make<Lifetime>(Lifetime.Local {declaration: run DeclarationId.copy(&owner), ordinal: 10})
  let otherLocal = run Shared.make<Lifetime>(Lifetime.Local {declaration: run DeclarationId.copy(&owner), ordinal: 11})
  let staticRegion = run Shared.make<Lifetime>(Lifetime.Static)
  let rowFirst = run preboundUnionRow(&identity, 4)
  let rowNext = run preboundUnionRow(&identity, 5)
  let emptyRow = run Shared.make<Row>(Row.empty())
  let mut keyArguments = Vector.make<Argument>()
  run Vector.append<Argument>(&mut keyArguments, Argument.Type {value: Shared.clone<Type>(&typeFirst)})
  let openKey = run specializationNominal(&firstOwner, move keyArguments)
  let mut concreteArguments = Vector.make<Argument>()
  run Vector.append<Argument>(&mut concreteArguments, Argument.Type {value: Shared.clone<Type>(&integer)})
  let closedKey = run specializationNominal(&firstOwner, move concreteArguments)
  let mut seededRow = Row.empty()
  run Row.require(&mut seededRow, Requirement {capability: move openKey,
    roleType: Option.some<Shared<Type>>(Shared.clone<Type>(&typeNext)), access: Access.Mutable})
  let nestedRow = run Shared.make<Row>(move seededRow)
  let mut expectedRow = Row.empty()
  run Row.require(&mut expectedRow, Requirement {capability: move closedKey,
    roleType: Option.some<Shared<Type>>(Shared.clone<Type>(&integer)), access: Access.Mutable})
  let concreteRow = run Shared.make<Row>(move expectedRow)
  let openA = run preboundUnionNominal(&firstOwner, &typeFirst, &lifetimeFirst, Access.Mutable, &rowFirst)
  let openB = run preboundUnionNominal(&secondOwner, &typeFirst, &lifetimeFirst, Access.Mutable, &rowFirst)
  let closedA = run preboundUnionNominal(&firstOwner, &integer, &local, Access.Mutable, &concreteRow)
  let closedB = run preboundUnionNominal(&secondOwner, &integer, &local, Access.Mutable, &concreteRow)
  let pattern = run preboundUnionPair(&openA, &openB)
  let concrete = run preboundUnionPair(&closedB, &closedA)
  let mut bindings = Vector.make<Binding>()
  run Vector.append<Binding>(&mut bindings, Binding {declaration: Shared.clone<DeclarationId>(&identity),
    ordinal: usize.ZERO, value: Argument.Type {value: Shared.clone<Type>(&typeNext)}})
  run Vector.append<Binding>(&mut bindings, Binding {declaration: Shared.clone<DeclarationId>(&identity),
    ordinal: usize.ONE, value: Argument.Type {value: Shared.clone<Type>(&integer)}})
  run Vector.append<Binding>(&mut bindings, Binding {declaration: Shared.clone<DeclarationId>(&identity),
    ordinal: 2, value: Argument.Lifetime {value: Shared.clone<Lifetime>(&lifetimeNext)}})
  run Vector.append<Binding>(&mut bindings, Binding {declaration: Shared.clone<DeclarationId>(&identity),
    ordinal: 3, value: Argument.Lifetime {value: Shared.clone<Lifetime>(&local)}})
  run Vector.append<Binding>(&mut bindings, Binding {declaration: Shared.clone<DeclarationId>(&identity),
    ordinal: 4, value: Argument.Row {value: Shared.clone<Row>(&rowNext)}})
  run Vector.append<Binding>(&mut bindings, Binding {declaration: Shared.clone<DeclarationId>(&identity),
    ordinal: 5, value: Argument.Row {value: move nestedRow}})
  run Vector.append<Binding>(&mut bindings, Binding {declaration: Shared.clone<DeclarationId>(&identity),
    ordinal: 6, value: Argument.Type {value: Shared.clone<Type>(&concrete)}})
  run Vector.append<Binding>(&mut bindings, Binding {declaration: move foreignIdentity,
    ordinal: usize.ZERO, value: Argument.Type {value: Shared.clone<Type>(&boolean)}})
  let snapshot = run preboundUnionSeedCopies(Vector.asSlice<Binding>(&bindings))
  let seeds = Vector.asSlice<Binding>(&snapshot)
  run Testing.expect(run preboundUnionComparison(&pattern, &concrete, variables, &mut bindings, seeds, Comparison.Exact, usize.ZERO),
    "reversed fixed nominal union members resolve nested type, lifetime and row chains including service-role keys")
  run Testing.expect(run preboundUnionComparison(&concrete, &pattern, variables, &mut bindings, seeds, Comparison.Exact, usize.ZERO),
    "fixed-member evidence resolves on the right side of comparison without changing seeds")
  // The public substitution contract is simultaneous: one pass keeps the replacement T1.
  let onceResult = run Type.applyBindings(&typeFirst, seeds, true)
  run Testing.expect(run Type.equalsShared(&onceResult, &typeNext), "ordinary substitution does not normalize binding chains")
  let nextA = run preboundUnionNominal(&firstOwner, &typeNext, &lifetimeFirst, Access.Mutable, &rowFirst)
  let collapsing = run preboundUnionPair(&openA, &nextA)
  run Testing.expect(run preboundUnionComparison(&collapsing, &closedA, variables, &mut bindings, seeds, Comparison.Exact, usize.ZERO),
    "established bindings collapse duplicate nominal members before bidirectional set inclusion")
  let setVariable = run specializationParameter(&owner, 6)
  let expanding = run preboundUnionPair(&setVariable, &openA)
  run Testing.expect(run preboundUnionComparison(&expanding, &concrete, variables, &mut bindings, seeds, Comparison.Exact, usize.ZERO),
    "a prebound bare variable expands into flattened members and absorbs a duplicate")
  let wrongType = run preboundUnionNominal(&firstOwner, &boolean, &local, Access.Mutable, &concreteRow)
  let wrongAccess = run preboundUnionNominal(&firstOwner, &integer, &local, Access.Shared, &concreteRow)
  let wrongLifetime = run preboundUnionNominal(&firstOwner, &integer, &otherLocal, Access.Mutable, &concreteRow)
  let staticA = run preboundUnionNominal(&firstOwner, &integer, &staticRegion, Access.Mutable, &concreteRow)
  let staticSet = run preboundUnionPair(&closedB, &staticA)
  let wrongRow = run preboundUnionNominal(&firstOwner, &integer, &local, Access.Mutable, &emptyRow)
  let typeSet = run preboundUnionPair(&closedB, &wrongType)
  let accessSet = run preboundUnionPair(&closedB, &wrongAccess)
  let lifetimeSet = run preboundUnionPair(&closedB, &wrongLifetime)
  let rowSet = run preboundUnionPair(&closedB, &wrongRow)
  run Testing.expect(run preboundUnionComparison(&pattern, &typeSet, variables, &mut bindings, seeds, Comparison.Exact, usize.ONE),
    "a fixed mutable referent does not become another primitive and preserves every seed")
  run Testing.expect(run preboundUnionComparison(&pattern, &accessSet, variables, &mut bindings, seeds, Comparison.Exact, usize.ONE),
    "fixed-set comparison keeps exclusive and shared access distinct")
  run Testing.expect(run preboundUnionComparison(&pattern, &lifetimeSet, variables, &mut bindings, seeds, Comparison.Exact, usize.ONE),
    "distinct fixed local lifetimes reject without replacing lifetime evidence")
  run Testing.expect(run preboundUnionComparison(&pattern, &staticSet, variables, &mut bindings, seeds, Comparison.Exact, usize.ONE),
    "a fixed local lifetime cannot become static inside a union member")
  run Testing.expect(run preboundUnionComparison(&pattern, &rowSet, variables, &mut bindings, seeds, Comparison.Exact, usize.ONE),
    "a fixed requirement row cannot lose its service-role key")
  run Testing.expect(run preboundUnionComparison(&pattern, &lifetimeSet, variables, &mut bindings, seeds, Comparison.Projection, usize.ZERO),
    "projection still erases lifetimes after resolving nested type and row evidence")
  let foreignType = run specializationParameter(&foreign, usize.ZERO)
  let rigidA = run preboundUnionNominal(&firstOwner, &foreignType, &local, Access.Mutable, &concreteRow)
  let rigidSet = run preboundUnionPair(&rigidA, &closedB)
  run Testing.expect(run preboundUnionComparison(&rigidSet, &typeSet, variables, &mut bindings, seeds, Comparison.Exact, usize.ONE),
    "a seed owned outside the variable whitelist cannot substitute a rigid parameter")
  let fresh = run specializationParameter(&owner, 7)
  let openSet = run preboundUnionPair(&openA, &fresh)
  run Testing.expect(run preboundUnionComparison(&openSet, &concrete, variables, &mut bindings, seeds, Comparison.Exact, 2),
    "exact comparison retains Undetermined for a bare unresolved set variable")
  run Testing.expect(run preboundUnionComparison(&openSet, &concrete, variables, &mut bindings, seeds, Comparison.Projection, usize.ZERO),
    "projection contains the normalized fixed member without binding its absorbed open variable")
  let mut absorbedLeft = Vector.make<Shared<Type>>()
  run Vector.append<Shared<Type>>(&mut absorbedLeft, Shared.clone<Type>(&openSet))
  run Vector.append<Shared<Type>>(&mut absorbedLeft, Shared.clone<Type>(&fresh))
  let mut absorbedRight = Vector.make<Shared<Type>>()
  run Vector.append<Shared<Type>>(&mut absorbedRight, Shared.clone<Type>(&concrete))
  run Vector.append<Shared<Type>>(&mut absorbedRight, Shared.clone<Type>(&boolean))
  let absorption = run Type.unifyAll(Vector.asSlice<Shared<Type>>(&absorbedLeft), Vector.asSlice<Shared<Type>>(&absorbedRight),
    variables, Comparison.Projection, &mut bindings)
  run Testing.expect(undecided(&absorption) && run preboundUnionSeedsEqual(Vector.asSlice<Binding>(&bindings), seeds),
    "an absorbed variable cannot acquire a later first-order assignment after fixed-member normalization")
  let mut lefts = Vector.make<Shared<Type>>()
  run Vector.append<Shared<Type>>(&mut lefts, Shared.clone<Type>(&fresh))
  run Vector.append<Shared<Type>>(&mut lefts, Shared.clone<Type>(&pattern))
  let mut rights = Vector.make<Shared<Type>>()
  run Vector.append<Shared<Type>>(&mut rights, Shared.clone<Type>(&boolean))
  run Vector.append<Shared<Type>>(&mut rights, Shared.clone<Type>(&typeSet))
  let failed = run Type.unifyAll(Vector.asSlice<Shared<Type>>(&lefts), Vector.asSlice<Shared<Type>>(&rights),
    variables, Comparison.Exact, &mut bindings)
  run Testing.expect(match &failed { Unification.Distinct => true _ => false }
      && run preboundUnionSeedsEqual(Vector.asSlice<Binding>(&bindings), seeds),
    "a failed fixed-set comparison rolls back an earlier fresh assignment and retains full seed contents")
  return ()
}

// The call assertion requires both an actual Body and the original target's Signature.
test effect fn explicitUnionCallsRetainOriginalGenericSelection() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run explicitUnionCallClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn explicitUnionCallClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> ? &mut Allocator {
  let id = run module("prebound-union-call.silk")
  let text = """
struct A<T> { value: T }
struct B<T> { value: T }
fn pass<T>(value: A<T> | B<T>) -> A<T> | B<T> { return move value }
fn nominal<T>(value: A<T>) -> A<T> { return move value }
fn explicit(value: A<i32> | B<i32>) -> A<i32> | B<i32> { return pass<i32>(move value) }
fn inferred(value: A<i32> | B<i32>) -> A<i32> | B<i32> { return pass(move value) }
fn ordinary(value: A<i32>) -> A<i32> { return nominal<i32>(move value) }
fn wrong(value: A<i32> | B<i32>) -> A<bool> | B<bool> { return pass<bool>(move value) }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let signature = run Semantic.demandSignature(&mut store, &mut request, &id, b"pass")
  let nominalSignature = run Semantic.demandSignature(&mut store, &mut request, &id, b"nominal")
  let explicit = run Semantic.demandBody(&mut store, &mut request, &id, b"explicit")
  let inferred = run Semantic.demandBody(&mut store, &mut request, &id, b"inferred")
  let ordinary = run Semantic.demandBody(&mut store, &mut request, &id, b"ordinary")
  let wrong = run Semantic.demandBody(&mut store, &mut request, &id, b"wrong")
  run Testing.expect(run preboundUnionSelectedCall(&explicit, &signature, b"pass", 2),
    "an explicit union call selects original pass T0=i32 and retains its concrete union result")
  run Testing.expect(run preboundUnionSelectedCall(&inferred, &signature, b"pass", 2),
    "ordinary inferred union selection independently fixes the same original T0")
  run Testing.expect(run preboundUnionSelectedCall(&ordinary, &nominalSignature, b"nominal", usize.ONE),
    "a seeded ordinary nominal call retains the original target and concrete result")
  run Testing.expect(rejectsSpan(&wrong, RejectionCode.TypeMismatch, text, "move value", 5),
    "an explicitly wrong type remains TypeMismatch at its moved operand")
  return ()
}

struct PreboundUnionCall {
  application: Shared<SpecializationApplication>
  result: Shared<Type>
}

fn preboundUnionCall(body: &TypedBody, target: &[u8]) -> Option<PreboundUnionCall> {
  let nodes = TypedBody.nodeSlice(body)
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {ty, form: BodyExpression.DirectCall {declaration, application, ..}} = &nodes[at].kind {
      let original = Shared.with<SpecializationApplication, bool>(&application,
        fn(value: &SpecializationApplication) -> bool {
          return DeclarationId.equals(SpecializationApplication.bodyDeclaration(value), &declaration)
        })
      if original && DeclarationId.named(&declaration, target) {
        return Option.some<PreboundUnionCall>(PreboundUnionCall {
          application: Shared.clone<SpecializationApplication>(&application), result: Shared.clone<Type>(&ty)})
      }
    }
    at = at + usize.ONE
  }
  return Option.none<PreboundUnionCall>()
}

effect fn preboundUnionSelectedCall(answer: &Shared<Result<Answer, NoRejection>>,
  signature: &Shared<Result<Answer, NoRejection>>, target: &[u8], memberCount: usize) -> bool
! OutOfMemoryError ? &mut Allocator {
  let body = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(answer, checkedBody)
  let parameter = contractSlotOf(signature, usize.ZERO)
  let result = contractSlotOf(signature, usize.MAX)
  if let Option<Shared<TypedBody>>.Some {value: typed} = move body {
    let call = Shared.with<TypedBody, Option<PreboundUnionCall>>(&typed,
      fn(value: &TypedBody) -> Option<PreboundUnionCall> { return preboundUnionCall(value, target) })
    if let Option<PreboundUnionCall>.Some {value: selected} = move call {
      let application = run SpecializationApplication.copyShared(&selected.application)
      let arguments = Vector.asSlice<Argument>(&application.arguments)
      let ordinals = Vector.asSlice<usize>(&application.argumentOrdinals)
      if arguments.length != usize.ONE || ordinals.length != usize.ONE || ordinals[usize.ZERO] != usize.ZERO
        || Vector.length<ScopeBinding>(&application.scopes) != usize.ZERO { return false }
      let integerSelected = match &arguments[usize.ZERO] {
        Argument.Type {value: supplied} => Shared.with<Type, bool>(&supplied, isI32)
        _ => false
      }
      if !integerSelected { return false }
      let declaration = SpecializationApplication.bodyDeclaration(&application)
      if let Option<Shared<Type>>.Some {value: promised} = &parameter {
        if let Option<Shared<Type>>.Some {value: returned} = &result {
          // Both written positions must retain the original target's owned T0.
          if Type.occurrences(&promised, declaration, usize.ZERO) != memberCount
            || Type.occurrences(&returned, declaration, usize.ZERO) != memberCount { return false }
          let concreteParameter = run Type.instantiate(&promised, declaration, arguments)
          let concreteResult = run Type.instantiate(&returned, declaration, arguments)
          let parameterMatches = run Type.equalsShared(&concreteParameter, &concreteResult)
          return parameterMatches && run Type.equalsShared(&selected.result, &concreteResult)
        }
      }
    }
  }
  return false
}

test effect fn closedSpecializationSharesErasedFamilyButKeepsValidityAndEvidence() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let entry = run module("specialization-identity.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let source = run present("struct Box<T> { value: T }\nservice Clock {}\nfn apply<'a, T>(value: T) -> T { return move value }\nfn other<'a, T>(value: T) -> T { return move value }\nfn row<?R>() -> i32 { return 0 }\nfn compare<T>(value: T) -> T { return move value }\nfn sourceA() -> i32 { return 1 }\nfn sourceB() -> i32 { return 2 }\n")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&Revision.make(), &entry, &source)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut index = SourceIndex.make(
    run Revision.copy(&revision)
      |> Effect.provideMut<Allocator>(&mut allocator),
  )
  let selected = run indexedIdentity(&mut index, &entry, OwnerKind.Function, b"apply", usize.ZERO)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let alternate = run indexedIdentity(&mut index, &entry, OwnerKind.Function, b"other", usize.ZERO)
    |> Effect.provideMut<Allocator>(&mut allocator)
  if let Option<DeclarationId>.Some {value: apply} = move selected {
    if let Option<DeclarationId>.Some {value: other} = move alternate {
      let integer = run specializationPrimitive(b"i32")
        |> Effect.provideMut<Allocator>(&mut allocator)
      let boolean = run specializationPrimitive(b"bool")
        |> Effect.provideMut<Allocator>(&mut allocator)
      let staticRegion = run Shared.make<Lifetime>(Lifetime.Static)
        |> Effect.provideMut<Allocator>(&mut allocator)
      let localRegion = run specializationLifetime(&apply, usize.ZERO)
        |> Effect.provideMut<Allocator>(&mut allocator)
      let mut firstArguments = Vector.make<Argument>()
      run Vector.append<Argument>(&mut firstArguments, Argument.Lifetime {value: Shared.clone<Lifetime>(&staticRegion)})
        |> Effect.provideMut<Allocator>(&mut allocator)
      run Vector.append<Argument>(&mut firstArguments, Argument.Type {value: Shared.clone<Type>(&integer)})
        |> Effect.provideMut<Allocator>(&mut allocator)
      let first = run specializationWithArguments(&apply, move firstArguments)
        |> Effect.provideMut<Allocator>(&mut allocator)
      let mut secondArguments = Vector.make<Argument>()
      run Vector.append<Argument>(&mut secondArguments, Argument.Lifetime {value: Shared.clone<Lifetime>(&localRegion)})
        |> Effect.provideMut<Allocator>(&mut allocator)
      run Vector.append<Argument>(&mut secondArguments, Argument.Type {value: Shared.clone<Type>(&integer)})
        |> Effect.provideMut<Allocator>(&mut allocator)
      let second = run specializationWithArguments(&apply, move secondArguments)
        |> Effect.provideMut<Allocator>(&mut allocator)
      let mut pool = SpecializationPool.make()
      let firstId = run SpecializationPool.intern(&mut pool, &first)
        |> Effect.provideMut<Allocator>(&mut allocator)
      let repeated = run SpecializationPool.intern(&mut pool, &first)
        |> Effect.provideMut<Allocator>(&mut allocator)
      let secondId = run SpecializationPool.intern(&mut pool, &second)
        |> Effect.provideMut<Allocator>(&mut allocator)
      if let Option<SpecializationIdentity>.Some {value: original} = move firstId {
        if let Option<SpecializationIdentity>.Some {value: again} = move repeated {
          if let Option<SpecializationIdentity>.Some {value: lifetimeOnly} = move secondId {
            run Testing.expect(
              original.semantic == again.semantic && original.runtime == again.runtime && original.semantic != lifetimeOnly.semantic && original.runtime == lifetimeOnly.runtime,
              "equal applications reuse both pool identities while validity lifetimes share the provisional runtime family",
            )
          } else { run Testing.expect(false, "lifetime-only application is closed") }
        } else { run Testing.expect(false, "repeated application is closed") }
      } else { run Testing.expect(false, "first application is closed") }
      let mut changedArguments = Vector.make<Argument>()
      run Vector.append<Argument>(&mut changedArguments, Argument.Lifetime {value: Shared.clone<Lifetime>(&staticRegion)})
        |> Effect.provideMut<Allocator>(&mut allocator)
      run Vector.append<Argument>(&mut changedArguments, Argument.Type {value: Shared.clone<Type>(&boolean)})
        |> Effect.provideMut<Allocator>(&mut allocator)
      let differentType = run specializationWithArguments(&apply, move changedArguments)
        |> Effect.provideMut<Allocator>(&mut allocator)
      let mut ownerArguments = Vector.make<Argument>()
      run Vector.append<Argument>(&mut ownerArguments, Argument.Lifetime {value: Shared.clone<Lifetime>(&staticRegion)})
        |> Effect.provideMut<Allocator>(&mut allocator)
      run Vector.append<Argument>(&mut ownerArguments, Argument.Type {value: Shared.clone<Type>(&integer)})
        |> Effect.provideMut<Allocator>(&mut allocator)
      let differentDeclaration = run specializationWithArguments(&other, move ownerArguments)
        |> Effect.provideMut<Allocator>(&mut allocator)
      let _typeId = run SpecializationPool.intern(&mut pool, &differentType)
        |> Effect.provideMut<Allocator>(&mut allocator)
      let _ownerId = run SpecializationPool.intern(&mut pool, &differentDeclaration)
        |> Effect.provideMut<Allocator>(&mut allocator)
      run Testing.expect(
        SpecializationPool.semanticCount(&pool) == 4 && SpecializationPool.runtimeCount(&pool) == 3,
        "type and declaration evidence retain distinct specialization identities",
      )
      let rowOwner = run indexedIdentity(&mut index, &entry, OwnerKind.Function, b"row", usize.ZERO)
        |> Effect.provideMut<Allocator>(&mut allocator)
      let clockOwner = run indexedIdentity(&mut index, &entry, OwnerKind.Service, b"Clock", usize.ZERO)
        |> Effect.provideMut<Allocator>(&mut allocator)
      let compareOwner = run indexedIdentity(&mut index, &entry, OwnerKind.Function, b"compare", usize.ZERO)
        |> Effect.provideMut<Allocator>(&mut allocator)
      let firstSource = run indexedIdentity(&mut index, &entry, OwnerKind.Function, b"sourceA", usize.ZERO)
        |> Effect.provideMut<Allocator>(&mut allocator)
      let secondSource = run indexedIdentity(&mut index, &entry, OwnerKind.Function, b"sourceB", usize.ZERO)
        |> Effect.provideMut<Allocator>(&mut allocator)
      if let Option<DeclarationId>.Some {value: rowDeclaration} = move rowOwner {
        if let Option<DeclarationId>.Some {value: clock} = move clockOwner {
          let capability = run specializationNominal(&clock, Vector.make<Argument>())
            |> Effect.provideMut<Allocator>(&mut allocator)
          let emptyRow = run Shared.make<Row>(Row.empty())
            |> Effect.provideMut<Allocator>(&mut allocator)
          let mut required = Row.empty()
          run Row.require(&mut required, Requirement {
            capability: move capability, roleType: Option.none<Shared<Type>>(), access: Access.Shared,
          })
            |> Effect.provideMut<Allocator>(&mut allocator)
          let clockRow = run Shared.make<Row>(move required)
            |> Effect.provideMut<Allocator>(&mut allocator)
          let mut emptyArguments = Vector.make<Argument>()
          run Vector.append<Argument>(&mut emptyArguments, Argument.Row {value: move emptyRow})
            |> Effect.provideMut<Allocator>(&mut allocator)
          let noService = run specializationWithArguments(&rowDeclaration, move emptyArguments)
            |> Effect.provideMut<Allocator>(&mut allocator)
          let mut clockArguments = Vector.make<Argument>()
          run Vector.append<Argument>(&mut clockArguments, Argument.Row {value: move clockRow})
            |> Effect.provideMut<Allocator>(&mut allocator)
          let withService = run specializationWithArguments(&rowDeclaration, move clockArguments)
            |> Effect.provideMut<Allocator>(&mut allocator)
          let mut evidence = SpecializationPool.make()
          let _empty = run SpecializationPool.intern(&mut evidence, &noService)
            |> Effect.provideMut<Allocator>(&mut allocator)
          let _clock = run SpecializationPool.intern(&mut evidence, &withService)
            |> Effect.provideMut<Allocator>(&mut allocator)
          run Testing.expect(SpecializationPool.runtimeCount(&evidence) == 2, "closed requirement rows keep different runtime identities")
        } else { run Testing.expect(false, "Clock service has a canonical identity") }
      } else { run Testing.expect(false, "row function has a canonical identity") }
      if let Option<DeclarationId>.Some {value: compare} = move compareOwner {
        if let Option<DeclarationId>.Some {value: sourceA} = move firstSource {
          if let Option<DeclarationId>.Some {value: sourceB} = move secondSource {
            let representationA = run specializationRepresentation(&sourceA)
              |> Effect.provideMut<Allocator>(&mut allocator)
            let representationB = run specializationRepresentation(&sourceB)
              |> Effect.provideMut<Allocator>(&mut allocator)
            let applicationA = run specializationOf(&compare, &representationA)
              |> Effect.provideMut<Allocator>(&mut allocator)
            let applicationB = run specializationOf(&compare, &representationB)
              |> Effect.provideMut<Allocator>(&mut allocator)
            let mut evidence = SpecializationPool.make()
            let _first = run SpecializationPool.intern(&mut evidence, &applicationA)
              |> Effect.provideMut<Allocator>(&mut allocator)
            let _second = run SpecializationPool.intern(&mut evidence, &applicationB)
              |> Effect.provideMut<Allocator>(&mut allocator)
            run Testing.expect(SpecializationPool.runtimeCount(&evidence) == 2, "exact named representations remain different code identities")
            let selectedA = SpecializationApplication {
              target: SpecializationTarget.Operation {
                contract: Shared.clone<Type>(&integer),
                provider: Shared.clone<Type>(&representationA),
                operation: run DeclarationId.copy(&compare)
                  |> Effect.provideMut<Allocator>(&mut allocator),
                implementation: run DeclarationId.copy(&sourceA)
                  |> Effect.provideMut<Allocator>(&mut allocator),
              },
              argumentOrdinals: Vector.make<usize>(),
              scopes: Vector.make<ScopeBinding>(),
              arguments: Vector.make<Argument>(),
              statics: Vector.make<StaticSlot>(),
            }
            let selectedB = SpecializationApplication {
              target: SpecializationTarget.Operation {
                contract: Shared.clone<Type>(&integer),
                provider: Shared.clone<Type>(&representationA),
                operation: run DeclarationId.copy(&compare)
                  |> Effect.provideMut<Allocator>(&mut allocator),
                implementation: run DeclarationId.copy(&sourceB)
                  |> Effect.provideMut<Allocator>(&mut allocator),
              },
              argumentOrdinals: Vector.make<usize>(),
              scopes: Vector.make<ScopeBinding>(),
              arguments: Vector.make<Argument>(),
              statics: Vector.make<StaticSlot>(),
            }
            let mut operations = SpecializationPool.make()
            let _selectedA = run SpecializationPool.intern(&mut operations, &selectedA)
              |> Effect.provideMut<Allocator>(&mut allocator)
            let _selectedB = run SpecializationPool.intern(&mut operations, &selectedB)
              |> Effect.provideMut<Allocator>(&mut allocator)
            run Testing.expect(SpecializationPool.runtimeCount(&operations) == 2, "selected operation implementations remain different code identities")
            let abstractType = run specializationParameter(&compare, usize.ZERO)
              |> Effect.provideMut<Allocator>(&mut allocator)
            let abstractApplication = run specializationOf(&compare, &abstractType)
              |> Effect.provideMut<Allocator>(&mut allocator)
            let unclosed = run SpecializationPool.intern(&mut evidence, &abstractApplication)
              |> Effect.provideMut<Allocator>(&mut allocator)
            let mut refused = false
            if let Option<SpecializationIdentity>.None = move unclosed {
              refused = true
            }
            run Testing.expect(refused && SpecializationPool.runtimeCount(&evidence) == 2, "abstract source parameters never become runtime identities")
          } else { run Testing.expect(false, "sourceB has a canonical identity") }
        } else { run Testing.expect(false, "sourceA has a canonical identity") }
      } else { run Testing.expect(false, "compare has a canonical identity") }
    } else { run Testing.expect(false, "other function has a canonical identity") }
  } else { run Testing.expect(false, "applied function has a canonical identity") }
  return ()
}

test effect fn specializationAdmissionRejectsGrowthAndAllowsFiniteWitnessDescent() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let entry = run module("specialization-recursion.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let source = run present("struct Box<T> { value: T }\nfn walk<T>(value: T) -> T { return move value }\nfn helper<T>(value: T) -> T { return move value }\n")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&Revision.make(), &entry, &source)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut index = SourceIndex.make(
    run Revision.copy(&revision)
      |> Effect.provideMut<Allocator>(&mut allocator),
  )
  let walkId = run indexedIdentity(&mut index, &entry, OwnerKind.Function, b"walk", usize.ZERO)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let helperId = run indexedIdentity(&mut index, &entry, OwnerKind.Function, b"helper", usize.ZERO)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let boxId = run indexedIdentity(&mut index, &entry, OwnerKind.Struct, b"Box", usize.ZERO)
    |> Effect.provideMut<Allocator>(&mut allocator)
  if let Option<DeclarationId>.Some {value: walk} = move walkId {
    if let Option<DeclarationId>.Some {value: helper} = move helperId {
      if let Option<DeclarationId>.Some {value: boxDeclaration} = move boxId {
        let integer = run specializationPrimitive(b"i32")
          |> Effect.provideMut<Allocator>(&mut allocator)
        let mut boxArguments = Vector.make<Argument>()
        run Vector.append<Argument>(&mut boxArguments, Argument.Type {value: Shared.clone<Type>(&integer)})
          |> Effect.provideMut<Allocator>(&mut allocator)
        let boxType = run specializationNominal(&boxDeclaration, move boxArguments)
          |> Effect.provideMut<Allocator>(&mut allocator)
        let mut largerArguments = Vector.make<Argument>()
        run Vector.append<Argument>(&mut largerArguments, Argument.Type {value: Shared.clone<Type>(&boxType)})
          |> Effect.provideMut<Allocator>(&mut allocator)
        let largerType = run specializationNominal(&boxDeclaration, move largerArguments)
          |> Effect.provideMut<Allocator>(&mut allocator)
        let outer = run specializationOf(&walk, &boxType)
          |> Effect.provideMut<Allocator>(&mut allocator)
        let larger = run specializationOf(&walk, &largerType)
          |> Effect.provideMut<Allocator>(&mut allocator)
        let smaller = run specializationOf(&walk, &integer)
          |> Effect.provideMut<Allocator>(&mut allocator)
        let helperApplication = run specializationOf(&helper, &boxType)
          |> Effect.provideMut<Allocator>(&mut allocator)
        run Testing.expect(run callableFamilyAliasAdmission(&walk, &helper, &integer)
          |> Effect.provideMut<Allocator>(&mut allocator),
          "callable family admission releases aliased targets and distinguishes other target declarations")
        let mut admission = SpecializationAdmission.make()
        let entered = run SpecializationAdmission.enter(&mut admission, &outer, SpecializationEdge.Direct)
          |> Effect.provideMut<Allocator>(&mut allocator)
        let repeated = run SpecializationAdmission.enter(&mut admission, &outer, SpecializationEdge.Direct)
          |> Effect.provideMut<Allocator>(&mut allocator)
        let grown = run SpecializationAdmission.enter(&mut admission, &larger, SpecializationEdge.Direct)
          |> Effect.provideMut<Allocator>(&mut allocator)
        let direct = match move grown {
          SpecializationDecision.Rejected {path} => Vector.length<SpecializationApplication>(&path) == 2
          _ => false
        }
        let same = match move repeated {
          SpecializationDecision.Reused {ancestor} => ancestor == usize.ZERO
          _ => false
        }
        let initial = match move entered {
          SpecializationDecision.Entered => true
          _ => false
        }
        run Testing.expect(initial && same && direct, "same application reuses its frame and direct growth rejects with the path")
        let mutual = run SpecializationAdmission.enter(&mut admission, &helperApplication, SpecializationEdge.Direct)
          |> Effect.provideMut<Allocator>(&mut allocator)
        let mutualGrowth = run SpecializationAdmission.enter(&mut admission, &larger, SpecializationEdge.Direct)
          |> Effect.provideMut<Allocator>(&mut allocator)
        let across = match move mutualGrowth {
          SpecializationDecision.Rejected {path} => Vector.length<SpecializationApplication>(&path) == 3
          _ => false
        }
        let helperDirect = match move mutual {
          SpecializationDecision.Entered => true
          _ => false
        }
        run Testing.expect(helperDirect && across, "mutual growth rejects with the full application path")
        SpecializationAdmission.leave(&mut admission)
        let helperEntered = run SpecializationAdmission.enter(&mut admission, &helperApplication, SpecializationEdge.Witness)
          |> Effect.provideMut<Allocator>(&mut allocator)
        let descent = run SpecializationAdmission.enter(&mut admission, &smaller, SpecializationEdge.Direct)
          |> Effect.provideMut<Allocator>(&mut allocator)
        let finite = match move descent {
          SpecializationDecision.Entered => true
          _ => false
        }
        let witness = match move helperEntered {
          SpecializationDecision.Entered => true
          _ => false
        }
        run Testing.expect(witness && finite, "a concrete witness may delegate through a helper to a strict type subterm")
        let returnsToLarger = run SpecializationAdmission.enter(&mut admission, &outer, SpecializationEdge.Witness)
          |> Effect.provideMut<Allocator>(&mut allocator)
        let disallowed = match move returnsToLarger {
          SpecializationDecision.Rejected {path} => Vector.length<SpecializationApplication>(&path) == 2
          _ => false
        }
        run Testing.expect(disallowed, "a witness descent cannot grow back to an older cached application")
        SpecializationAdmission.leave(&mut admission)
        SpecializationAdmission.leave(&mut admission)
        SpecializationAdmission.leave(&mut admission)
      } else { run Testing.expect(false, "Box has a canonical identity") }
    } else { run Testing.expect(false, "helper has a canonical identity") }
  } else { run Testing.expect(false, "walk has a canonical identity") }
  return ()
}

// Actor-only controls: one retained application handle, a fresh equivalent one, and another body.
effect fn callableFamilyAliasAdmission(owner: &DeclarationId, target: &DeclarationId, integer: &Shared<Type>) -> bool
! OutOfMemoryError ? &mut Allocator {
  let aliased = run callableFamilySection(target, integer)
  let equivalent = run callableFamilySection(target, integer)
  let different = run callableFamilySection(owner, integer)
  let first = run specializationOf(owner, &aliased)
  let same = run specializationOf(owner, &equivalent)
  let other = run specializationOf(owner, &different)
  let mut admission = SpecializationAdmission.make()
  let entered = run SpecializationAdmission.enter(&mut admission, &first, SpecializationEdge.Direct)
  let repeated = run SpecializationAdmission.enter(&mut admission, &first, SpecializationEdge.Direct)
  let fresh = run SpecializationAdmission.enter(&mut admission, &same, SpecializationEdge.Direct)
  let distinct = run SpecializationAdmission.enter(&mut admission, &other, SpecializationEdge.Direct)
  let initial = match move entered { SpecializationDecision.Entered => true _ => false }
  let aliasSafe = match move repeated { SpecializationDecision.Reused {ancestor} => ancestor == usize.ZERO _ => false }
  let exact = match move fresh { SpecializationDecision.Reused {ancestor} => ancestor == usize.ZERO _ => false }
  let separate = match move distinct { SpecializationDecision.Entered => true _ => false }
  SpecializationAdmission.leave(&mut admission)
  SpecializationAdmission.leave(&mut admission)
  return initial && aliasSafe && exact && separate
}

effect fn callableFamilySection(target: &DeclarationId, integer: &Shared<Type>) -> Shared<Type>
! OutOfMemoryError ? &mut Allocator {
  let application = run Shared.make<SpecializationApplication>(run specializationOf(target, integer))
  let environment = run Shared.make<Intersection>(Intersection {members: Vector.make<LifetimeMember>()})
  let contract = run Shared.make<Type>(Type.Callable {mode: CallableMode.Shared, isUnsafe: false,
    environment: move environment, invocationBinders: usize.ZERO, invocationUse: usize.MAX, invocationBounds: Vector.make<Outlives>(),
    parameters: Vector.make<Shared<Type>>(), result: Shared.clone<Type>(integer)})
  let mut captures = Vector.make<Shared<Type>>()
  run Vector.append<Shared<Type>>(&mut captures, Shared.clone<Type>(integer))
  let mut fields = Vector.make<CallableFieldInput>()
  run Vector.append<CallableFieldInput>(&mut fields, CallableFieldInput.Argument {parameter: usize.ZERO})
  return run Type.callableValue(true, move application, move contract, move captures, move fields)
}

test effect fn specializationAdmissionUsesResolvedConcreteFieldDescent() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let entry = run module("specialization-field-descent.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let source = run present("struct Inner { value: i32 }\nstruct Outer { inner: Inner }\nstruct Other { value: i32 }\nfn walk<T>(value: T) -> T { return move value }\n")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&Revision.make(), &entry, &source)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut semantic = makeSemantic(run Revision.copy(&revision)
    |> Effect.provideMut<Allocator>(&mut allocator))
  let mut index = SourceIndex.make(
    run Revision.copy(&revision)
      |> Effect.provideMut<Allocator>(&mut allocator),
  )
  let owner = run indexedIdentity(&mut index, &entry, OwnerKind.Struct, b"Outer", usize.ZERO)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let member = run indexedIdentity(&mut index, &entry, OwnerKind.Struct, b"Inner", usize.ZERO)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let unrelated = run indexedIdentity(&mut index, &entry, OwnerKind.Struct, b"Other", usize.ZERO)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let function = run indexedIdentity(&mut index, &entry, OwnerKind.Function, b"walk", usize.ZERO)
    |> Effect.provideMut<Allocator>(&mut allocator)
  if let Option<DeclarationId>.Some {value: outerId} = move owner {
    if let Option<DeclarationId>.Some {value: innerId} = move member {
      if let Option<DeclarationId>.Some {value: otherId} = move unrelated {
        if let Option<DeclarationId>.Some {value: walkId} = move function {
          let outerType = run specializationNominal(&outerId, Vector.make<Argument>())
            |> Effect.provideMut<Allocator>(&mut allocator)
          let innerType = run specializationNominal(&innerId, Vector.make<Argument>())
            |> Effect.provideMut<Allocator>(&mut allocator)
          let otherType = run specializationNominal(&otherId, Vector.make<Argument>())
            |> Effect.provideMut<Allocator>(&mut allocator)
          let outerCall = run specializationOf(&walkId, &outerType)
            |> Effect.provideMut<Allocator>(&mut allocator)
          let innerCall = run specializationOf(&walkId, &innerType)
            |> Effect.provideMut<Allocator>(&mut allocator)
          let otherCall = run specializationOf(&walkId, &otherType)
            |> Effect.provideMut<Allocator>(&mut allocator)
          let mut request = Request.make()
          let checked = run SpecializationFieldDescent.fromMember(
            &mut semantic, &mut request, &outerId, &outerType, usize.ZERO,
          )
            |> Effect.provideMut<Allocator>(&mut allocator)
          let mut admission = SpecializationAdmission.make()
          let _outer = run SpecializationAdmission.enter(&mut admission, &outerCall, SpecializationEdge.Direct)
            |> Effect.provideMut<Allocator>(&mut allocator)
          let unproven = run SpecializationAdmission.enter(&mut admission, &innerCall, SpecializationEdge.Witness)
            |> Effect.provideMut<Allocator>(&mut allocator)
          let noArbitraryNominalDescent = match move unproven {
            SpecializationDecision.Rejected {path} => Vector.length<SpecializationApplication>(&path) == 2
            _ => false
          }
          if let Option<SpecializationFieldDescent>.Some {value: field} = move checked {
            let wrongField = run SpecializationAdmission.enter(&mut admission, &otherCall, SpecializationEdge.FieldWitness {field: field})
              |> Effect.provideMut<Allocator>(&mut allocator)
            let noUnrelatedNominalDescent = match move wrongField {
              SpecializationDecision.Rejected {path} => Vector.length<SpecializationApplication>(&path) == 2
              _ => false
            }
            let checkedAgain = run SpecializationFieldDescent.fromMember(
              &mut semantic, &mut request, &outerId, &outerType, usize.ZERO,
            )
              |> Effect.provideMut<Allocator>(&mut allocator)
            if let Option<SpecializationFieldDescent>.Some {value: proven} = move checkedAgain {
              let descent = run SpecializationAdmission.enter(&mut admission, &innerCall, SpecializationEdge.FieldWitness {field: proven})
                |> Effect.provideMut<Allocator>(&mut allocator)
              let accepted = match move descent {
                SpecializationDecision.Entered => true
                _ => false
              }
              run Testing.expect(accepted && noArbitraryNominalDescent && noUnrelatedNominalDescent, "only the selected concrete field permits nongeneric nominal descent")
            } else { run Testing.expect(false, "resolved field can be requested again") }
          } else { run Testing.expect(false, "Outer.inner has a concrete field shape") }
        } else { run Testing.expect(false, "walk has a canonical identity") }
      } else { run Testing.expect(false, "Other has a canonical identity") }
    } else { run Testing.expect(false, "Inner has a canonical identity") }
  } else { run Testing.expect(false, "Outer has a canonical identity") }
  return ()
}

fn bodyHasLogicalAnd(body: &TypedBody) -> bool {
  let nodes = TypedBody.nodeSlice(body)
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {form: BodyExpression.ConcreteInfix {operator, ..}, ..} = &nodes[at].kind {
      if operator == InfixOperator.And { return true }
    }
    at = at + usize.ONE
  }
  return false
}

test effect fn staticIntrinsicContractsRejectUnknownMembersAndMismatches() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let entry = run module("static-intrinsic-errors.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """static fn unknown() -> u32 { return Intrinsic.missing() }
static fn wrongArgument() -> usize { return Intrinsic.staticTextByteLength(1) }
static fn wrongResult() -> usize { return Intrinsic.targetPointerBits() }
pub fn main() -> i32 { return Intrinsic.wake(40, 2) }
fn unknownRuntime() -> i32 { return Intrinsic.i32AddMissing<i32>(40, 2) }
"""
  let source = run present(text) |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&Revision.make(), &entry, &source)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut semantic = makeSemantic(move revision)
  let mut request = Request.make()
  let unknown = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"unknown")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let argument = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"wrongArgument")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let result = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"wrongResult")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let runtime = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"main")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let unknownRuntime = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"unknownRuntime")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    rejectsFrom(&unknown, RejectionCode.UnknownMember, offsetOf(text, "missing", usize.ZERO)) && rejectsFrom(&argument, RejectionCode.TypeMismatch, offsetOf(text, "Intrinsic.staticTextByteLength(1)", usize.ZERO)) && rejectsFrom(&result, RejectionCode.TypeMismatch, offsetOf(text, "Intrinsic.targetPointerBits()", usize.ZERO)),
    "sealed intrinsic selection reports unknown members and typed contract mismatches at source spans",
  )
  run Testing.expect(
    rejectsSpan(&runtime, RejectionCode.IntrinsicUnavailable, text, "wake", 0) &&
      rejectsSpan(&unknownRuntime, RejectionCode.UnknownMember, text, "i32AddMissing", 0),
    "a catalog-defined runtime primitive defers while a misspelled generic member stays an error",
  )
  let built = run Semantic.buildMain(&mut semantic, &mut request, &entry, staticClosureNodes)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut namedGap = false
  match move built {
    BackendBuild.Unsupported {gaps} => {
      let entries = Vector.asSlice<Shared<BackendGap>>(&gaps)
      if entries.length == usize.ONE {
        namedGap = Shared.with<BackendGap, bool>(&entries[usize.ZERO], fn(gap: &BackendGap) -> bool {
          return gap.code == GapCode.IntrinsicMember &&
            BackendGap.span(gap).start == offsetOf(text, "wake", 0) && BackendGap.span(gap).end == BackendGap.span(gap).start + 4
        })
      }
    }
    _ => {}
  }
  run Testing.expect(namedGap, "the backend reports an intrinsic-member gap at the authored member span")
  return ()
}

// Whether lowered MIR contains a slice data read and an element address offset.
fn mirFormsPointerAddresses(function: &MirFunction) -> bool {
  let mut sliceData = false
  let mut offset = false
  let blocks = Vector.asSlice<MirBlock>(&function.blocks)
  let mut blockAt = usize.ZERO
  while blockAt < blocks.length {
    let statements = Vector.asSlice<MirStatement>(&blocks[blockAt].statements)
    let mut at = usize.ZERO
    while at < statements.length {
      if let MirStatement.Assign {value: MirRvalue.SliceData {..}, ..} = &statements[at] { sliceData = true }
      if let MirStatement.Assign {value: MirRvalue.PointerOffset {..}, ..} = &statements[at] { offset = true }
      at = at + usize.ONE
    }
    blockAt = blockAt + usize.ONE
  }
  return sliceData && offset
}

test effect fn pointerPrimitivesSelectNativeAddresses() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | BackendGap | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let entry = run module("pointer-intrinsics.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """fn second(values: &[u8]) -> u8 {
  let many = Intrinsic.pointerFromSlice<u8>(values)
  unsafe {
    let base = Intrinsic.pointerRequalify<?[*]const u8, [*]const u8>(many)
    return Intrinsic.pointerRead<u8>(Intrinsic.pointerAt<u8>(base, 1))
  }
}
fn widen(value: isize) -> usize { return Intrinsic.isizeToUsize(value) }
fn unacknowledged(pointer: *const u8) -> u8 { return Intrinsic.pointerRead<u8>(pointer) }
fn retargeted(pointer: *const u8) -> *const i32 { unsafe { return Intrinsic.pointerRequalify<*const u8, *const i32>(pointer) } }
struct Heavy { value: i32 }
fn readHeavy(pointer: *const Heavy) -> Heavy { unsafe { return Intrinsic.pointerRead<Heavy>(pointer) } }
fn mutableAt(pointer: [*]mut u8) -> *const u8 { unsafe { return Intrinsic.pointerAt<u8>(pointer, 0) } }
fn sink(buffer: ?[*]const u8) -> u8 { return 0 }
fn addNullability(pointer: [*]mut u8) -> u8 { return sink(pointer) }
fn kept<T: Copy>(value: T) -> T { return value }
fn element(argv: [*]const ?[*]const u8) -> ?[*]const u8 {
  unsafe { return Intrinsic.pointerRead<?[*]const u8>(Intrinsic.pointerAt<?[*]const u8>(argv, 0)) }
}
fn bounded(argument: ?[*]const u8) -> ?[*]const u8 { return kept(argument) }
"""
  let mut store = run staticSemantic(&entry, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let unacknowledged = run Semantic.demandBody(&mut store, &mut request, &entry, b"unacknowledged")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let retargeted = run Semantic.demandBody(&mut store, &mut request, &entry, b"retargeted")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let heavy = run Semantic.demandBody(&mut store, &mut request, &entry, b"readHeavy")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mutable = run Semantic.demandBody(&mut store, &mut request, &entry, b"mutableAt")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let nullable = run Semantic.demandBody(&mut store, &mut request, &entry, b"addNullability")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(&nullable, bodyRetainsPointerWeaken) &&
      Shared.with<Result<Answer, NoRejection>, bool>(&mutable, bodyRetainsPointerWeaken),
    "pointer arguments, including primitive ones, remove mutation capability and add nullability",
  )
  run Testing.expect(
    rejectsFrom(&unacknowledged, RejectionCode.UnsafeAcknowledgement, offsetOf(text, "Intrinsic.pointerRead<u8>(pointer)", 0)) &&
      rejectsFrom(&retargeted, RejectionCode.InvalidPointerQualifier, offsetOf(text, "Intrinsic.pointerRequalify<*const u8, *const i32>", 0)) &&
      rejectsFrom(&heavy, RejectionCode.MissingConformance, offsetOf(text, "Intrinsic.pointerRead<Heavy>", 0)),
    "unsafe pointer primitives need acknowledgement, requalification keeps the pointee, and reads need Copy",
  )
  let lowered = run Semantic.demandMir(&mut store, &mut request, &entry, b"second")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let widened = run Semantic.demandMir(&mut store, &mut request, &entry, b"widen")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let element = run Semantic.demandMir(&mut store, &mut request, &entry, b"element")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let bounded = run Semantic.demandMir(&mut store, &mut request, &entry, b"bounded")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let elementIndex = Shared.with<Result<Answer, NoRejection>, Option<usize>>(&element, selectedMirIndex)
  let boundedIndex = Shared.with<Result<Answer, NoRejection>, Option<usize>>(&bounded, selectedMirIndex)
  let mut pointersLowered = false
  if let Option<usize>.Some {..} = move elementIndex {
    if let Option<usize>.Some {..} = move boundedIndex { pointersLowered = true }
  }
  run Testing.expect(pointersLowered,
    "a raw pointer is Copy whatever its pointee, so it is read through a pointer and satisfies a Copy bound")
  let mut addresses = false
  let mut trapped = false
  let selected = Shared.with<Result<Answer, NoRejection>, Option<usize>>(&lowered, selectedMirIndex)
  if let Option<usize>.Some {value} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(&store, value) {
      addresses = mirFormsPointerAddresses(function)
    }
  }
  // The conversion stays one checked MIR form; its native lowering guards the sign and traps.
  let selectedWiden = Shared.with<Result<Answer, NoRejection>, Option<usize>>(&widened, selectedMirIndex)
  if let Option<usize>.Some {value: widenIndex} = move selectedWiden {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(&store, widenIndex) {
      let machine = MachineTarget.forId(TargetId.X8664UnknownLinuxGnu)
      let layouts = run scalarControlLayouts(function, &machine) |> Effect.provideMut<Allocator>(&mut allocator)
      let foreign = Vector.make<CAbi.Signature>()
      let llvm = run emitClosedMir(function, &machine, Vector.asSlice<TypeLayout>(&layouts), Vector.asSlice<CAbi.Signature>(&foreign))
        |> Effect.provideMut<Allocator>(&mut allocator)
      let ir = Bytes.asSlice(&llvm)
      trapped = scalarForms(function).converts && containsIr(ir, b" = icmp slt i64 ") && containsIr(ir, b"call void @llvm.trap()")
    }
  }
  run Testing.expect(addresses && trapped,
    "slice data and element addresses lower to MIR pointer operations, and a negative isize traps")
  return ()
}

effect fn foreignContractClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator {
  let repeatedId = run module("foreign-repeated.silk")
  let scalarId = run module("foreign-scalar.silk")
  let readingId = run module("foreign-reading.silk")
  let repeatedText = """unsafe extern "C" fn admitted(text: ?[*]const u8) -> usize with Intrinsic.foreign(noCapture: ("text",))
unsafe extern "C" fn other(text: ?[*]const u8) -> usize with Intrinsic.foreign(noCapture: ("text", "text"))
fn measure(values: &[u8]) -> usize { return unsafe admitted(Intrinsic.pointerFromSlice<u8>(values)) + unsafe other(Intrinsic.pointerFromSlice<u8>(values)) }
pub fn main() -> i32 { if measure(&[0]) == 0 { return 42 } return 1 }
"""
  let scalarText = """unsafe extern "C" fn other(text: ?[*]const u8, count: usize) -> usize with Intrinsic.foreign(noCapture: ("count",))
fn measure(values: &[u8]) -> usize { return unsafe other(Intrinsic.pointerFromSlice<u8>(values), 0) }
pub fn main() -> i32 { if measure(&[0]) == 0 { return 42 } return 1 }
"""
  let readingText = """unsafe extern "C" fn other(text: ?[*]const u8) -> usize with Intrinsic.foreign(memory: "read")
fn measure(values: &[u8]) -> usize { return unsafe other(Intrinsic.pointerFromSlice<u8>(values)) }
pub fn main() -> i32 { if measure(&[0]) == 0 { return 42 } return 1 }
"""
  let repeatedSource = run present(repeatedText)
  let scalarSource = run present(scalarText)
  let readingSource = run present(readingText)
  let first = run Revision.publish(&Revision.make(), &repeatedId, &repeatedSource)
  let second = run Revision.publish(&first, &scalarId, &scalarSource)
  let revision = run Revision.publish(&second, &readingId, &readingSource)
  let mut store = Semantic.make(move revision, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu), Option.none<FinalProfile>())
  let mut request = Request.make()
  let repeated = run Semantic.buildMain(&mut store, &mut request, &repeatedId, staticClosureNodes)
  let scalar = run Semantic.buildMain(&mut store, &mut request, &scalarId, staticClosureNodes)
  let reading = run Semantic.buildMain(&mut store, &mut request, &readingId, staticClosureNodes)
  let anchor = "unsafe extern \"C\" fn other"
  run Testing.expect(
    foreignContractGapAt(&repeated, offsetOf(repeatedText, anchor, 0)) &&
      foreignContractGapAt(&scalar, offsetOf(scalarText, anchor, 0)) &&
      foreignContractGapAt(&reading, offsetOf(readingText, anchor, 0)),
    "one noCapture field over distinct pointer parameters is admitted; duplicates, scalars and other properties stay gaps",
  )
  return ()
}

test effect fn foreignNoCaptureSelectNativeContracts() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run foreignContractClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

fn staticTextIntegerIs(value: &Result<StaticData, StaticText.Fault>, expected: u64) -> bool {
  return match & value.* {
    Result<StaticData, StaticText.Fault>.Success {value: StaticData.Integer {sign, magnitude, ..}} => {
      return sign == StaticSign.Positive && magnitude == expected
    }
    _ => false
  }
}

fn staticTextFailureIs(
  value: &Result<StaticData, StaticText.Fault>,
  kind: StaticTextFaultKind,
  offset: u64,
) -> bool {
  return match & value.* {
    Result<StaticData, StaticText.Fault>.Failure {error} => {
      return error.kind == kind && error.byteOffset == offset
    }
    _ => false
  }
}

test effect fn staticTextPrimitivesCheckBytesAndScalarBoundaries() -> ()
! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let source = run Bytes.copy(String.utf8Bytes("é!"))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let text = run Shared.make<StaticData>(StaticData.Text {bytes: move source})
    |> Effect.provideMut<Allocator>(&mut allocator)
  let one = run Shared.make<StaticData>(StaticData.Integer {
    ty: StaticIntegerType.Usize, sign: StaticSign.Positive, magnitude: 1,
  }) |> Effect.provideMut<Allocator>(&mut allocator)
  let two = run Shared.make<StaticData>(StaticData.Integer {
    ty: StaticIntegerType.Usize, sign: StaticSign.Positive, magnitude: 2,
  }) |> Effect.provideMut<Allocator>(&mut allocator)
  let three = run Shared.make<StaticData>(StaticData.Integer {
    ty: StaticIntegerType.Usize, sign: StaticSign.Positive, magnitude: 3,
  }) |> Effect.provideMut<Allocator>(&mut allocator)
  let zero = run Shared.make<StaticData>(StaticData.Integer {
    ty: StaticIntegerType.Usize, sign: StaticSign.Positive, magnitude: 0,
  }) |> Effect.provideMut<Allocator>(&mut allocator)
  let lengthArgs = [Shared.clone<StaticData>(&text)]
  let length = run StaticText.apply(StaticTextOperation.ByteLength, &lengthArgs, 32, 1024)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let byteArgs = [Shared.clone<StaticData>(&text), Shared.clone<StaticData>(&one)]
  let selected = run StaticText.apply(StaticTextOperation.ByteAt, &byteArgs, 32, 1024)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let invalidByteArgs = [Shared.clone<StaticData>(&text), Shared.clone<StaticData>(&three)]
  let invalidByte = run StaticText.apply(StaticTextOperation.ByteAt, &invalidByteArgs, 32, 1024)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let splitArgs = [Shared.clone<StaticData>(&text), Shared.clone<StaticData>(&zero), Shared.clone<StaticData>(&one)]
  let split = run StaticText.apply(StaticTextOperation.Slice, &splitArgs, 32, 1024)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let sliceArgs = [Shared.clone<StaticData>(&text), Shared.clone<StaticData>(&zero), Shared.clone<StaticData>(&two)]
  let sliced = run StaticText.apply(StaticTextOperation.Slice, &sliceArgs, 32, 1024)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let sliceIsText = match move sliced {
    Result<StaticData, StaticText.Fault>.Success {value} => staticTextBytesAre(&value, String.utf8Bytes("é"))
    _ => false
  }
  let concatArgs = [Shared.clone<StaticData>(&text), Shared.clone<StaticData>(&text)]
  let joined = run StaticText.apply(StaticTextOperation.Concat, &concatArgs, 32, 1024)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let concatIsText = match move joined {
    Result<StaticData, StaticText.Fault>.Success {value} => staticTextBytesAre(&value, String.utf8Bytes("é!é!"))
    _ => false
  }
  let overBudget = run StaticText.apply(StaticTextOperation.Concat, &concatArgs, 32, 16)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    staticTextIntegerIs(&length, 3) && staticTextIntegerIs(&selected, 169) &&
      staticTextFailureIs(&invalidByte, StaticTextFaultKind.OutOfBounds, 3) &&
      staticTextFailureIs(&split, StaticTextFaultKind.SplitScalar, 1) &&
      staticTextFailureIs(&overBudget, StaticTextFaultKind.ValueLimit, 0) &&
      sliceIsText && concatIsText,
    "static text operations enforce byte bounds and Unicode scalar boundaries",
  )
  return ()
}

// U6: constant values and extents use canonical static results, independent of literal spelling.
test effect fn staticConstantAdmissionAndCanonicalExtent() -> ()
! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let name = run Bytes.copy(b"u32") |> Effect.provideMut<Allocator>(&mut allocator)
  let ty = Type.Primitive {name: move name}
  let result = StaticData.Integer {
    ty: StaticIntegerType.U32, sign: StaticSign.Positive, magnitude: 12,
  }
  let wrong = StaticData.Integer {
    ty: StaticIntegerType.U64, sign: StaticSign.Positive, magnitude: 12,
  }
  let extentValue = run Shared.make<StaticData>(StaticData.Integer {
    ty: StaticIntegerType.U32, sign: StaticSign.Positive, magnitude: 12,
  }) |> Effect.provideMut<Allocator>(&mut allocator)
  let negativeValue = run Shared.make<StaticData>(StaticData.Integer {
    ty: StaticIntegerType.I32, sign: StaticSign.Negative, magnitude: 1,
  }) |> Effect.provideMut<Allocator>(&mut allocator)
  let wideValue = run Shared.make<StaticData>(StaticData.Integer {
    ty: StaticIntegerType.U64, sign: StaticSign.Positive, magnitude: 4294967296,
  }) |> Effect.provideMut<Allocator>(&mut allocator)
  let digits = run StaticConstant.extent(&extentValue, 32)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let rejected = run StaticConstant.extent(&negativeValue, 32)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let narrowRejected = run StaticConstant.extent(&wideValue, 32)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let wideAccepted = run StaticConstant.extent(&wideValue, 64)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let canonical = match move digits {
    Option<Bytes>.Some {value} => sameBytes(Bytes.asSlice(&value), b"12")
    Option<Bytes>.None => false
  }
  let noNegative = match move rejected {
    Option<Bytes>.None => true
    _ => false
  }
  let targetRange = match move narrowRejected {
    Option<Bytes>.None => match move wideAccepted {
      Option<Bytes>.Some {value} => sameBytes(Bytes.asSlice(&value), b"4294967296")
      Option<Bytes>.None => false
    }
    _ => false
  }
  run Testing.expect(
    StaticConstant.typeAllowed(&ty) && StaticConstant.matches(&ty, &result) &&
      !StaticConstant.matches(&ty, &wrong) && canonical && noNegative && targetRange,
    "constant admission and array extents respect exact type and target width",
  )
  return ()
}
