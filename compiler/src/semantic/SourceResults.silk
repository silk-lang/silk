//! Frozen operation/result candidates tied to actual structural operand occurrences.
//!
//! This inventory is not a source or policy solve. InputRoute authenticates the binding from
//! a physical operand to selected/original input coordinates; it is not a fabricated Copy map.
//! Original routes, projections and continuations retain their separate authorities. Consumers
//! activate candidates in the one source program and must preserve incomplete/empty coverage.

import semantic.SourceAnalysis {EvalId, inputOperand, sameInputRead, sameSelector}
import semantic.SourceFlow {PointId}
import semantic.SourcePreparation as Prepared
import semantic.SourcePreparation {ApplicationId, ContractContinuationId, ContractProjectionId,
  ContractRouteId, ContractSelectionId, EndpointId, EndpointRole, InputRoute, MapId, MapKind,
  OperationPhase, Root, SourcePreparation, TypeSpace}
import semantic.SourceTraversal as Traversal
import semantic.SourceTraversal {Reservation, Visit}
import semantic.TypedBody {Expression, NodeId, NodeKind, AggregateField, SourceAnonymousUse}
import semantic.DeclarationId {DeclarationId}
import semantic.Specialization {Application}
import hir.Hir {OwnerKind}
import silk.shared {Shared}
import silk.allocator {Allocator, OutOfMemoryError}
import silk.option {Option}
import silk.ownership {Copy}
import silk.usize
import silk.list {List}
import CompilerBug

/// Original physical contributor domains are distinct. Literal Environment is the real
/// descriptor's stored field family, never a fabricated construction or formal parameter.
pub union DescriptorSource {
  Construction {pub construction: usize, pub input: usize, pub inputMap: MapId},
  Environment {pub original: EndpointId, pub field: usize, pub inputMap: MapId},
}
impl Copy for DescriptorSource {}

pub fn descriptorMap(source: DescriptorSource) -> MapId {
  return match source {
    DescriptorSource.Construction {inputMap, ..} => inputMap
    DescriptorSource.Environment {inputMap, ..} => inputMap
  }
}

pub fn sameDescriptorSource(left: DescriptorSource, right: DescriptorSource) -> bool {
  return match left {
    DescriptorSource.Construction {construction, input, inputMap} => match right {
      DescriptorSource.Construction {construction: other, input: otherInput, inputMap: otherMap} =>
        construction == other && input == otherInput && inputMap.index == otherMap.index
      _ => false
    }
    DescriptorSource.Environment {original, field, inputMap} => match right {
      DescriptorSource.Environment {original: other, field: otherField, inputMap: otherMap} =>
        original.index == other.index && field == otherField && inputMap.index == otherMap.index
      _ => false
    }
  }
}

pub fn descriptorOriginal<'body>(prepared: &SourcePreparation<'body>, source: DescriptorSource) -> EndpointId {
  return match source {
    DescriptorSource.Construction {construction, input, ..} => List<InputRoute>.asSlice(
      &List<Prepared.Construction>.asSlice(&prepared.constructions)[construction].inputs)[input].original
    DescriptorSource.Environment {original, ..} => original
  }
}

fn literalEnvironment<'body>(prepared: &SourcePreparation<'body>, channel: usize) -> EndpointId {
  let selected = &List<Prepared.ProducerChannel>.asSlice(&prepared.producerChannels)[channel]
  let application = &List<Prepared.Application>.asSlice(&prepared.applications)[selected.application.index]
  let actual = match &prepared.body.nodes[selected.site.index].kind {
    NodeKind.Expression {form: Expression.Callable {source, ..}, ..} => match &source {
      Option<Shared<SourceAnonymousUse>>.Some {value} => {
        let formal = Shared<SourceAnonymousUse>.with<DeclarationId>(&value, fn(value: &SourceAnonymousUse) -> DeclarationId {
          return Shared<Application>.with<DeclarationId>(&value.application,
            fn(value: &Application) -> DeclarationId { return DeclarationId.copy(Application.bodyDeclaration(value)) })
        })
        let recorded = match &application.anonymous {
          Option<Shared<SourceAnonymousUse>>.Some {value} => Shared<SourceAnonymousUse>.with<DeclarationId>(&value,
            fn(value: &SourceAnonymousUse) -> DeclarationId {
              return Shared<Application>.with<DeclarationId>(&value.application,
                fn(value: &Application) -> DeclarationId { return DeclarationId.copy(Application.bodyDeclaration(value)) })
            })
          _ => { return CompilerBug.panic(b"literal Environment lost its retained anonymous application") }
        }
        DeclarationId.equals(&formal, &recorded) && DeclarationId.equals(&formal, &DeclarationId.copyShared(&application.owner))
      }
      _ => {
        let owner = DeclarationId.copyShared(&application.owner)
        DeclarationId.kind(&owner) == OwnerKind.EffectBlock && application.constructs
          && match &application.anonymous { Option<Shared<SourceAnonymousUse>>.None => true _ => false }
      }
    }
    _ => false
  }
  let endpoints = List<Prepared.Endpoint>.asSlice(&prepared.endpoints)
  if !actual || application.site.index != selected.site.index
    || !nodeValue(&endpoints[selected.descriptor.index], selected.site) || !rootEndpoint(&endpoints[selected.descriptor.index]) {
    return CompilerBug.panic(b"literal Environment changed its exact descriptor producer")
  }
  let mut found = usize.MAX
  let mut at = usize.ZERO
  while at < endpoints.length {
    if rootEndpoint(&endpoints[at]) {
      if let Root.Application {application, port: Prepared.ContractPort.Environment, ordinal, space: TypeSpace.Original} = &endpoints[at].root {
        if application.index == selected.application.index && ordinal == usize.ZERO {
          if found != usize.MAX { return CompilerBug.panic(b"literal descriptor has duplicate original Environment roots") }
          found = at
        }
      }
    }
    at = at + usize.ONE
  }
  if found == usize.MAX { return CompilerBug.panic(b"literal descriptor lost its original Environment declaration") }
  return EndpointId {index: found}
}

// Re-identify the exact aggregate placement already activated by Traversal. This reserves
// no value or map, and field is the written field-list position, not a declaration ordinal.
fn environmentMap<'body>(prepared: &SourcePreparation<'body>, channel: usize, field: usize) -> MapId {
  let selected = &List<Prepared.ProducerChannel>.asSlice(&prepared.producerChannels)[channel]
  let fields = match &prepared.body.nodes[selected.site.index].kind {
    NodeKind.Expression {form: Expression.Callable {fields, ..}, ..} => List<AggregateField>.asSlice(&fields)
    _ => { return CompilerBug.panic(b"Environment source is not an actual callable literal") }
  }
  if field >= fields.length { return CompilerBug.panic(b"Environment source names an absent actual field") }
  let endpoints = List<Prepared.Endpoint>.asSlice(&prepared.endpoints)
  let maps = List<Prepared.SelectionMap>.asSlice(&prepared.maps)
  let mut found = usize.MAX
  let mut at = usize.ZERO
  while at < maps.length {
    let map = &maps[at]
    if map.site.index == selected.site.index && map.kind == MapKind.Place
      && nodeValue(&endpoints[map.source.index], fields[field].value) && rootEndpoint(&endpoints[map.source.index]) {
      let target = &endpoints[map.target.index]
      let child = match target.parent { Option<EndpointId>.Some {value} => value.index == selected.descriptor.index _ => false }
      let component = match &target.selector { Prepared.Selector.Field {ordinal} => ordinal == fields[field].index _ => false }
      if child && component {
        if found != usize.MAX { return CompilerBug.panic(b"literal field has duplicate physical aggregate placements") }
        found = at
      }
    }
    at = at + usize.ONE
  }
  if found == usize.MAX { return CompilerBug.panic(b"literal field lost its accepted aggregate placement") }
  return MapId {index: found}
}

pub effect fn descriptorSources<'body>(prepared: &SourcePreparation<'body>, channel: usize) -> List<DescriptorSource>
! OutOfMemoryError ? &mut Allocator {
  let selected = &List<Prepared.ProducerChannel>.asSlice(&prepared.producerChannels)[channel]
  let constructions = List<Prepared.Construction>.asSlice(&prepared.constructions)
  let maps = List<Prepared.SelectionMap>.asSlice(&prepared.maps)
  let mut found = usize.MAX
  let mut at = usize.ZERO
  while at < constructions.length {
    if constructions[at].site.index == selected.site.index && constructions[at].application.index == selected.application.index {
      if found != usize.MAX { CompilerBug.panic(b"descriptor producer has duplicate physical constructions") }
      found = at
    }
    at = at + usize.ONE
  }
  let mut sources = List<DescriptorSource>.make()
  if found != usize.MAX {
    let inputs = List<InputRoute>.asSlice(&constructions[found].inputs)
    at = usize.ZERO
    while at < inputs.length {
      let family = run mapFamily(maps, inputs[at].map)
      let family = List<MapId>.asSlice(&family)
      let mut member = usize.ZERO
      while member < family.length {
        run List<DescriptorSource>.append(&mut sources, DescriptorSource.Construction {construction: found, input: at, inputMap: family[member]})
        member = member + usize.ONE
      }
      at = at + usize.ONE
    }
  } else {
    let original = literalEnvironment(prepared, channel)
    let fields = match &prepared.body.nodes[selected.site.index].kind {
      NodeKind.Expression {form: Expression.Callable {fields, ..}, ..} => List<AggregateField>.asSlice(&fields)
      _ => { return CompilerBug.panic(b"descriptor has neither a construction nor literal Environment authority") }
    }
    at = usize.ZERO
    while at < fields.length {
      let mut prior = usize.ZERO
      while prior < at {
        if fields[prior].index == fields[at].index { CompilerBug.panic(b"literal Environment repeats an actual field placement") }
        prior = prior + usize.ONE
      }
      let family = run mapFamily(maps, environmentMap(prepared, channel, at))
      let family = List<MapId>.asSlice(&family)
      let mut member = usize.ZERO
      while member < family.length {
        run List<DescriptorSource>.append(&mut sources, DescriptorSource.Environment {original: original, field: at, inputMap: family[member]})
        member = member + usize.ONE
      }
      at = at + usize.ONE
    }
  }
  return move sources
}

fn validateDescriptorSource<'body>(prepared: &SourcePreparation<'body>, channel: usize, source: DescriptorSource) -> () {
  let selected = &List<Prepared.ProducerChannel>.asSlice(&prepared.producerChannels)[channel]
  let maps = List<Prepared.SelectionMap>.asSlice(&prepared.maps)
  match source {
    DescriptorSource.Construction {construction, input, inputMap} => {
      let constructions = List<Prepared.Construction>.asSlice(&prepared.constructions)
      if construction >= constructions.length { CompilerBug.panic(b"descriptor input names an absent construction") }
      let row = &constructions[construction]
      let inputs = List<InputRoute>.asSlice(&row.inputs)
      if row.site.index != selected.site.index || row.application.index != selected.application.index
        || input >= inputs.length || !inFamily(maps, inputs[input].map, inputMap) {
        CompilerBug.panic(b"descriptor input changed its original construction domain")
      }
    }
    DescriptorSource.Environment {original, field, inputMap} => {
      if literalEnvironment(prepared, channel).index != original.index || !inFamily(maps, environmentMap(prepared, channel, field), inputMap) {
        CompilerBug.panic(b"literal input changed its original Environment or actual field family")
      }
    }
  }
  return ()
}

/// One composite result authority. Every ordinal belongs to the supplied immutable package;
/// A's invocation placement is separate from B's captured-input route/projection authority.
pub struct DescriptorPrefix {
  pub projection: ContractProjectionId,
  pub requestedRoot: Prepared.ResidualStateId, pub requested: Prepared.ResidualStateId,
  pub root: Prepared.ResidualStateId, pub current: Prepared.ResidualStateId
}
impl Copy for DescriptorPrefix {}

pub fn sameDescriptorPrefix(left: Option<DescriptorPrefix>, right: Option<DescriptorPrefix>) -> bool {
  return match left {
    Option<DescriptorPrefix>.Some {value: a} => match right {
      Option<DescriptorPrefix>.Some {value: b} => a.projection.index == b.projection.index
        && a.requestedRoot.index == b.requestedRoot.index && a.requested.index == b.requested.index
        && a.root.index == b.root.index && a.current.index == b.current.index
      _ => false
    }
    _ => match right { Option<DescriptorPrefix>.None => true _ => false }
  }
}
pub fn sameRequestedPrefix(left: Option<DescriptorPrefix>, right: Option<DescriptorPrefix>) -> bool {
  return match left {
    Option<DescriptorPrefix>.Some {value: a} => match right {
      Option<DescriptorPrefix>.Some {value: b} => a.projection.index == b.projection.index
        && a.requestedRoot.index == b.requestedRoot.index && a.requested.index == b.requested.index
      _ => false
    }
    _ => match right { Option<DescriptorPrefix>.None => true _ => false }
  }
}

pub struct DescriptorInvocation {
  pub prefix: Option<DescriptorPrefix>,
  pub channel: usize, pub pair: usize, pub resultProjection: ContractProjectionId,
  pub resultRoot: Option<ContractContinuationId>, pub resultContinuation: Option<ContractContinuationId>
}
impl Copy for DescriptorInvocation {}

pub fn sameDescriptorInvocation(left: Option<DescriptorInvocation>, right: Option<DescriptorInvocation>) -> bool {
  return match left {
    Option<DescriptorInvocation>.Some {value: a} => match right {
      Option<DescriptorInvocation>.Some {value: b} => a.channel == b.channel && a.pair == b.pair
        && a.resultProjection.index == b.resultProjection.index && sameContinuation(a.resultRoot, b.resultRoot)
        && sameContinuation(a.resultContinuation, b.resultContinuation) && sameDescriptorPrefix(a.prefix, b.prefix)
      _ => false
    }
    _ => match right { Option<DescriptorInvocation>.None => true _ => false }
  }
}
fn sameContinuation(left: Option<ContractContinuationId>, right: Option<ContractContinuationId>) -> bool {
  return match left {
    Option<ContractContinuationId>.Some {value} => match right { Option<ContractContinuationId>.Some {value: other} => value.index == other.index _ => false }
    _ => match right { Option<ContractContinuationId>.None => true _ => false }
  }
}

/// position is the actual Visit.inputs position, independent of parameter/capture ordinals.
/// A selected continuation retains its rooted physical placement, never the entire anchor.
pub union Binding {
  Argument {pub input: usize, pub inputMap: MapId, pub position: usize},
  CallableArgument {pub input: usize, pub inputMap: MapId, pub position: usize,
    pub channel: usize, pub proof: usize, pub pair: usize,
    pub receiverProjection: ContractProjectionId, pub receiverContinuation: Option<ContractContinuationId>,
    pub resultRoot: Option<ContractContinuationId>},
  /// Construction coordinates are NOT invocation argument ordinals. proof/capture name
  /// finite actual receiver/producer derivations retained by the graph, never a map cache.
  DescriptorInput {pub channel: usize, pub source: DescriptorSource, pub producer: EvalId, pub receiverPosition: usize,
    pub proof: usize, pub capture: usize, pub placement: usize,
    pub requestedRoot: Option<Prepared.ResidualStateId>, pub requested: Option<Prepared.ResidualStateId>,
    pub producerRoot: Option<Prepared.ResidualStateId>, pub producerState: Option<Prepared.ResidualStateId>,
    pub originalRoot: Option<ContractContinuationId>, pub invocation: Option<DescriptorInvocation>},
}
impl Copy for Binding {}

pub struct Candidate {
  pub operation: usize
  pub binding: Binding
  pub operand: EvalId
  pub usePoint: PointId
  pub result: EvalId
  pub source: EndpointId
  pub target: EndpointId
  pub selection: ContractSelectionId
  pub route: ContractRouteId
  pub projection: ContractProjectionId
  pub continuation: Option<ContractContinuationId>
  pub output: MapId
}
impl Copy for Candidate {}

/// A selected operation subject must retain its root, not just its current outputState.
/// One continuation can be both a root and a descendant, with different physical suffixes.
pub union Position {
  Contract {pub output: MapId, pub projection: ContractProjectionId,
    pub root: ContractContinuationId, pub current: ContractContinuationId},
  Descriptor {pub proof: usize, pub root: Prepared.ResidualStateId, pub current: Prepared.ResidualStateId},
}
impl Copy for Position {}

pub struct PlacementStep {
  pub position: Position
  pub state: Prepared.ResidualStateId
  /// The exact authored output component. Its selector includes channels and Referent;
  /// neither a non-inline component nor a nonaccepting state means the whole anchor.
  pub component: Prepared.ComponentId
  pub next: List<Position>
}

pub union PlacementSuffix {
  Whole,
  Selected {
    pub roots: List<Position>,
    /// Subject coordinates, not accepting-state, Contents, or query certificates.
    pub targets: List<Position>,
    pub steps: List<PlacementStep>,
  },
}

/// Immutable description only: no new endpoint, selected value, query result or policy fact.
/// prefix lists actual output child endpoints, root-to-anchor, excluding root itself.
/// Selected retains the finite root/current product; its paths end at targets, not at a
/// guessed endpoint under the result. Candidate preserves its original source contributor.
pub struct Placement {
  pub candidate: Candidate
  pub root: EndpointId
  pub prefix: List<EndpointId>
  pub suffix: PlacementSuffix
}

pub fn samePosition(left: Position, right: Position) -> bool {
  return match left {
    Position.Contract {output, projection, root, current} => match right {
      Position.Contract {output: otherOutput, projection: otherProjection, root: otherRoot, current: otherCurrent} =>
        output.index == otherOutput.index && projection.index == otherProjection.index
          && root.index == otherRoot.index && current.index == otherCurrent.index
      _ => false
    }
    Position.Descriptor {proof, root, current} => match right {
      Position.Descriptor {proof: other, root: otherRoot, current: otherCurrent} =>
        proof == other && root.index == otherRoot.index && current.index == otherCurrent.index
      _ => false
    }
  }
}

pub fn positionState<'body>(prepared: &SourcePreparation<'body>, position: Position) -> Prepared.ResidualStateId {
  return match position {
    Position.Contract {current, ..} => List<Prepared.ContractContinuation>.asSlice(&prepared.contractContinuations)[current.index].outputState
    Position.Descriptor {current, ..} => current
  }
}

pub fn positionRoot(position: Position) -> Position {
  return match position {
    Position.Contract {output, projection, root, ..} => Position.Contract {output: output, projection: projection, root: root, current: root}
    Position.Descriptor {proof, root, ..} => Position.Descriptor {proof: proof, root: root, current: root}
  }
}

pub struct Input {
  pub route: usize
  pub position: usize
  pub actual: Traversal.Input
}
impl Copy for Input {}

/// A receiver is a real read even when Operation.inputs is empty (stored Run). It is not
/// synthesized into an input route or selected declaration parameter.
pub struct Receiver {
  pub endpoint: EndpointId
  pub position: usize
  pub actual: Traversal.Input
}
impl Copy for Receiver {}

/// Retained even for a complete empty row or an incomplete row with no routes. Coverage is
/// read from this exact selection; no absence here produces LoanFree or proves a result safe.
pub struct Contributor {
  pub projection: ContractProjectionId
  pub continuation: Option<ContractContinuationId>
  pub selection: ContractSelectionId
  pub candidates: List<Candidate>
}

pub struct Output {
  pub map: MapId
  pub contributors: List<Contributor>
}

/// Both Invoke plans enumerate original A contributors. Callable candidates remain structural
/// until the graph attaches an actual receiver origin and paired projection cursor. Effect
/// execution uses its real descriptor captures; no empty inventory certifies source coverage.
pub union Plan {
  NamedInvoke {pub application: ApplicationId, pub result: MapId, pub outputs: List<Output>},
  CallableInvoke {pub application: ApplicationId, pub result: MapId, pub channel: Option<usize>, pub outputs: List<Output>},
  PrepareEffect {pub application: ApplicationId, pub construction: usize},
  ExecuteEffect {pub receiver: EndpointId, pub result: MapId},
}

pub struct Operation {
  pub prepared: usize
  pub evaluation: EvalId
  pub execute: PointId
  pub receiver: Option<Receiver>
  /// Actual evaluation order, then original route order for several fields of one operand.
  pub inputs: List<Input>
  pub plan: Plan
}

pub struct Inventory { pub operations: List<Operation> }

/// Enumerates each actual operation occurrence once, including structurally reserved but
/// unreachable occurrences. A repeated NodeId has its own Visit/Eval and input use points.
/// No values, leaves, rules, aliases, loans or policy ports are created here.
pub effect fn reserve<'body>(prepared: &SourcePreparation<'body>, reservation: &Reservation) -> Inventory
! OutOfMemoryError ? &mut Allocator {
  let rows = List<Prepared.Operation>.asSlice(&prepared.operations)
  let visits = List<Visit>.asSlice(&reservation.visits)
  let mut inventory = Inventory {operations: List<Operation>.make()}
  let mut at = usize.ZERO
  while at < visits.length {
    let visit = &visits[at]
    let mut selected = usize.MAX
    let mut each = usize.ZERO
    while each < rows.length {
      if rows[each].site.index == visit.node.index {
        if selected != usize.MAX { CompilerBug.panic(b"result occurrence has duplicate prepared operations") }
        selected = each
      }
      each = each + usize.ONE
    }
    if selected == usize.MAX {
      if namedCall(prepared, visit.node) { CompilerBug.panic(b"actual named call has no prepared operation") }
    } else {
      let inputs = run actualInputs(prepared, visit, &rows[selected])
      let receiver = actualReceiver(prepared, visit, &rows[selected])
      let plan = run operationPlan(prepared, visit, selected, List<Input>.asSlice(&inputs))
      run List<Operation>.append(&mut inventory.operations, Operation {prepared: selected,
        evaluation: visit.evaluation, execute: visit.execute, receiver: receiver, inputs: move inputs, plan: move plan})
    }
    at = at + usize.ONE
  }
  return move inventory
}

/// Whole-result ownership reset requires the actual result root as well as an unselected
/// output. A composite binding's B contributor can be selected; only its exact A output
/// continuation determines the final result. No selected Position is made whole here.
pub fn wholeResultCandidate<'body>(prepared: &SourcePreparation<'body>, candidate: Candidate) -> bool {
  validateCandidate(prepared, candidate)
  let endpoint = &List<Prepared.Endpoint>.asSlice(&prepared.endpoints)[candidate.target.index]
  let operation = &List<Prepared.Operation>.asSlice(&prepared.operations)[candidate.operation]
  if !nodeValue(endpoint, operation.site) { return false }
  if let Option<EndpointId>.Some {..} = endpoint.parent { return false }
  return match candidate.binding {
    Binding.Argument {..} | Binding.CallableArgument {..} => match candidate.continuation {
      Option<ContractContinuationId>.None => true
      _ => false
    }
    Binding.DescriptorInput {requestedRoot, requested, invocation, ..} => match invocation {
      Option<DescriptorInvocation>.Some {value} => match value.resultContinuation {
        Option<ContractContinuationId>.None => true
        _ => false
      }
      Option<DescriptorInvocation>.None => match requestedRoot {
        Option<Prepared.ResidualStateId>.None => match requested {
          Option<Prepared.ResidualStateId>.None => true
          _ => false
        }
        _ => false
      }
    }
  }
}

/// Place one contributor using existing output-family and continuation identities only.
/// Selected targets need Position in the source product identity BEFORE query acceptance;
/// (actual output anchor, outputState) alone merges direct-root and descendant placements.
pub effect fn outputPlacement<'body>(prepared: &SourcePreparation<'body>, candidate: Candidate) -> Placement
! OutOfMemoryError ? &mut Allocator {
  validateCandidate(prepared, candidate)
  let endpoints = List<Prepared.Endpoint>.asSlice(&prepared.endpoints)
  let operation = &List<Prepared.Operation>.asSlice(&prepared.operations)[candidate.operation]
  let mut reverse = List<EndpointId>.make()
  let mut root = candidate.target
  let mut remaining = endpoints.length
  while true {
    if remaining == usize.ZERO || root.index >= endpoints.length || !nodeValue(&endpoints[root.index], operation.site) {
      CompilerBug.panic(b"result placement lost its actual output prefix")
    }
    remaining = remaining - usize.ONE
    match endpoints[root.index].parent {
      Option<EndpointId>.Some {value} => {
        run List<EndpointId>.append(&mut reverse, root)
        root = value
      }
      Option<EndpointId>.None => { break }
    }
  }
  let mut prefix = List<EndpointId>.make()
  let backwards = List<EndpointId>.asSlice(&reverse)
  let mut at = backwards.length
  while at > usize.ZERO {
    at = at - usize.ONE
    run List<EndpointId>.append(&mut prefix, backwards[at])
  }
  let suffix = match candidate.binding {
    Binding.Argument {..} => match candidate.continuation {
      Option<ContractContinuationId>.None => PlacementSuffix.Whole
      Option<ContractContinuationId>.Some {value} => run selectedPlacement(prepared, candidate, value)
    }
    Binding.CallableArgument {..} => match candidate.continuation {
      Option<ContractContinuationId>.None => PlacementSuffix.Whole
      Option<ContractContinuationId>.Some {value} => run selectedPlacement(prepared, candidate, value)
    }
    Binding.DescriptorInput {placement, requestedRoot, requested, invocation, ..} => match invocation {
      Option<DescriptorInvocation>.Some {value} => match value.resultContinuation {
        Option<ContractContinuationId>.Some {value} => run selectedPlacement(prepared, candidate, value)
        _ => PlacementSuffix.Whole
      }
      _ => run descriptorPlacement(prepared, placement, requestedRoot, requested)
    }
  }
  return Placement {candidate: candidate, root: root, prefix: move prefix, suffix: move suffix}
}

fn candidateRoot(candidate: Candidate, root: ContractContinuationId) -> bool {
  return match candidate.binding {
    Binding.DescriptorInput {invocation: Option<DescriptorInvocation>.Some {value}, ..} => match value.resultRoot {
      Option<ContractContinuationId>.Some {value} => value.index == root.index
      _ => false
    }
    Binding.CallableArgument {resultRoot, ..} => match resultRoot {
      Option<ContractContinuationId>.Some {value} => value.index == root.index
      _ => false
    }
    _ => true
  }
}

fn placementProjection(candidate: Candidate) -> ContractProjectionId {
  return match candidate.binding {
    Binding.DescriptorInput {invocation: Option<DescriptorInvocation>.Some {value}, ..} => value.resultProjection
    _ => candidate.projection
  }
}
fn position(candidate: Candidate, root: ContractContinuationId, current: ContractContinuationId) -> Position {
  return Position.Contract {output: candidate.output, projection: placementProjection(candidate), root: root, current: current}
}

fn hasContinuation(values: &[ContractContinuationId], id: ContractContinuationId) -> bool {
  let mut at = usize.ZERO
  while at < values.length {
    if values[at].index == id.index { return true }
    at = at + usize.ONE
  }
  return false
}

effect fn selectedPlacement<'body>(prepared: &SourcePreparation<'body>, candidate: Candidate,
  target: ContractContinuationId) -> PlacementSuffix ! OutOfMemoryError ? &mut Allocator {
  let projection = &List<Prepared.ContractProjection>.asSlice(&prepared.contractProjections)[placementProjection(candidate).index]
  let continuations = List<Prepared.ContractContinuation>.asSlice(&prepared.contractContinuations)
  let states = List<Prepared.ResidualState>.asSlice(&prepared.residuals)
  let roots = List<ContractContinuationId>.asSlice(&projection.continuations)
  let mut reachable = List<ContractContinuationId>.make()
  let mut at = usize.ZERO
  while at < roots.length {
    let mut before = usize.ZERO
    while before < at {
      if roots[before].index == roots[at].index { CompilerBug.panic(b"result placement repeats an identical projection root") }
      before = before + usize.ONE
    }
    validatePlacementStep(prepared, candidate, roots[at])
    let state = &states[continuations[roots[at].index].outputState.index]
    if state.input.shape.index != List<Prepared.Endpoint>.asSlice(&prepared.endpoints)[projection.output.index].shape.index {
      CompilerBug.panic(b"result placement root lost its declared output anchor")
    }
    if candidateRoot(candidate, roots[at]) { run appendContinuation(&mut reachable, roots[at]) }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < List<ContractContinuationId>.length(&reachable) {
    let current = List<ContractContinuationId>.asSlice(&reachable)[at]
    validatePlacementStep(prepared, candidate, current)
    // A placement ends AT the candidate subject, not at all of its later accepting leaves.
    if current.index != target.index {
      let next = List<ContractContinuationId>.asSlice(&continuations[current.index].next)
      let mut each = usize.ZERO
      while each < next.length {
        validatePlacementEdge(prepared, candidate, current, next[each])
        run appendContinuation(&mut reachable, next[each])
        each = each + usize.ONE
      }
    }
    at = at + usize.ONE
  }
  if !hasContinuation(List<ContractContinuationId>.asSlice(&reachable), target) {
    CompilerBug.panic(b"result placement has no declared root-to-subject continuation")
  }
  // Backward closure keeps every alternative predecessor leading to this exact subject.
  // It does not enumerate paths or merge original normalization contributors by outputState.
  let reachable = List<ContractContinuationId>.asSlice(&reachable)
  let mut retained = List<ContractContinuationId>.make()
  run List<ContractContinuationId>.append(&mut retained, target)
  let mut changed = true
  while changed {
    changed = false
    at = usize.ZERO
    while at < reachable.length {
      if !hasContinuation(List<ContractContinuationId>.asSlice(&retained), reachable[at]) {
        let next = List<ContractContinuationId>.asSlice(&continuations[reachable[at].index].next)
        let mut each = usize.ZERO
        while each < next.length {
          if hasContinuation(List<ContractContinuationId>.asSlice(&retained), next[each]) {
            run List<ContractContinuationId>.append(&mut retained, reachable[at])
            changed = true
            break
          }
          each = each + usize.ONE
        }
      }
      at = at + usize.ONE
    }
  }
  let retained = List<ContractContinuationId>.asSlice(&retained)
  let mut entries = List<Position>.make()
  let mut targets = List<Position>.make()
  let mut steps = List<PlacementStep>.make()
  at = usize.ZERO
  while at < roots.length {
    if candidateRoot(candidate, roots[at]) && hasContinuation(retained, roots[at]) {
      let root = roots[at]
      run List<Position>.append(&mut entries, position(candidate, root, root))
      let mut pending = List<ContractContinuationId>.make()
      run List<ContractContinuationId>.append(&mut pending, root)
      let mut each = usize.ZERO
      while each < List<ContractContinuationId>.length(&pending) {
        let current = List<ContractContinuationId>.asSlice(&pending)[each]
        let state = continuations[current.index].outputState
        let mut next = List<Position>.make()
        if current.index == target.index {
          run List<Position>.append(&mut targets, position(candidate, root, current))
        } else {
          let onward = List<ContractContinuationId>.asSlice(&continuations[current.index].next)
          let mut edge = usize.ZERO
          while edge < onward.length {
            if hasContinuation(retained, onward[edge]) {
              run List<Position>.append(&mut next, position(candidate, root, onward[edge]))
              run appendContinuation(&mut pending, onward[edge])
            }
            edge = edge + usize.ONE
          }
        }
        run List<PlacementStep>.append(&mut steps, PlacementStep {position: position(candidate, root, current),
          state: state, component: states[state.index].input, next: move next})
        each = each + usize.ONE
      }
    }
    at = at + usize.ONE
  }
  if List<Position>.length(&targets) == usize.ZERO { CompilerBug.panic(b"selected result placement became whole or empty") }
  return PlacementSuffix.Selected {roots: move entries, targets: move targets, steps: move steps}
}

fn residualDescends(states: &[Prepared.ResidualState], root: Prepared.ResidualStateId,
  target: Prepared.ResidualStateId, remaining: usize) -> bool {
  if root.index == target.index { return true }
  if remaining == usize.ZERO || root.index >= states.length { return false }
  let next = List<Prepared.ResidualStateId>.asSlice(&states[root.index].next)
  let mut at = usize.ZERO
  while at < next.length {
    if residualDescends(states, next[at], target, remaining - usize.ONE) { return true }
    at = at + usize.ONE
  }
  return false
}

/// The graph has already retained every actual descriptor Case and paired channel cursor.
/// This projection exposes only its requested, rooted authored placement to policy consumers.
effect fn descriptorPlacement<'body>(prepared: &SourcePreparation<'body>, proof: usize,
  root: Option<Prepared.ResidualStateId>, target: Option<Prepared.ResidualStateId>) -> PlacementSuffix
! OutOfMemoryError ? &mut Allocator {
  let root = match root {
    Option<Prepared.ResidualStateId>.Some {value} => value
    _ => {
      if let Option<Prepared.ResidualStateId>.Some {..} = target { return CompilerBug.panic(b"descriptor placement lost its requested root") }
      return PlacementSuffix.Whole
    }
  }
  let target = match target { Option<Prepared.ResidualStateId>.Some {value} => value
    _ => { return CompilerBug.panic(b"descriptor placement replaced a selected output with whole") } }
  let states = List<Prepared.ResidualState>.asSlice(&prepared.residuals)
  if !residualDescends(states, root, target, states.length) {
    return CompilerBug.panic(b"descriptor result has no requested root-to-output path")
  }
  let mut pending = List<Prepared.ResidualStateId>.make()
  run List<Prepared.ResidualStateId>.append(&mut pending, root)
  let mut roots = List<Position>.make()
  let mut targets = List<Position>.make()
  let mut steps = List<PlacementStep>.make()
  run List<Position>.append(&mut roots, Position.Descriptor {proof: proof, root: root, current: root})
  let mut at = usize.ZERO
  while at < List<Prepared.ResidualStateId>.length(&pending) {
    let current = List<Prepared.ResidualStateId>.asSlice(&pending)[at]
    let state = &states[current.index]
    let position = Position.Descriptor {proof: proof, root: root, current: current}
    let mut next = List<Position>.make()
    if current.index == target.index { run List<Position>.append(&mut targets, position) }
    else {
      let children = List<Prepared.ResidualStateId>.asSlice(&state.next)
      let mut child = usize.ZERO
      while child < children.length {
        let value = children[child]
        if residualDescends(states, value, target, states.length) {
          run List<Position>.append(&mut next, Position.Descriptor {proof: proof, root: root, current: value})
          let old = List<Prepared.ResidualStateId>.asSlice(&pending)
          let mut found = false
          let mut before = usize.ZERO
          while before < old.length { if old[before].index == value.index { found = true } before = before + usize.ONE }
          if !found { run List<Prepared.ResidualStateId>.append(&mut pending, value) }
        }
        child = child + usize.ONE
      }
    }
    run List<PlacementStep>.append(&mut steps, PlacementStep {position: position, state: current,
      component: state.input, next: move next})
    at = at + usize.ONE
  }
  return PlacementSuffix.Selected {roots: move roots, targets: move targets, steps: move steps}
}

fn descriptorContinuationDescends(rows: &[Prepared.ContractContinuation], root: ContractContinuationId,
  current: ContractContinuationId, remaining: usize) -> bool {
  if root.index == current.index { return true }
  if remaining == usize.ZERO || root.index >= rows.length { return false }
  let next = List<ContractContinuationId>.asSlice(&rows[root.index].next)
  let mut at = usize.ZERO
  while at < next.length {
    if descriptorContinuationDescends(rows, next[at], current, remaining - usize.ONE) { return true }
    at = at + usize.ONE
  }
  return false
}

// Authenticate the original A inline endpoint history separately from contextual shapes.
// A copied prefix can retain these vertices with different frozen input/output ShapeIds.
fn receiverPrefixHistory<'body>(prepared: &SourcePreparation<'body>, endpoint: EndpointId,
  root: Prepared.ResidualStateId, current: Prepared.ResidualStateId, target: EndpointId, remaining: usize) -> bool {
  if remaining == usize.ZERO { return false }
  let states = List<Prepared.ResidualState>.asSlice(&prepared.residuals)
  let state = &states[root.index]
  if let Prepared.ResidualAuthority.Contract {..} = state.authority { return false }
  let endpoints = List<Prepared.Endpoint>.asSlice(&prepared.endpoints)
  let vertex = &endpoints[state.vertex.index]
  let parent = match vertex.parent { Option<EndpointId>.Some {value} => value.index == endpoint.index _ => false }
  if !parent { return false }
  let shapes = List<Prepared.Shape>.asSlice(&prepared.shapes)
  let component = &List<Prepared.Component>.asSlice(&shapes[state.input.shape.index].components)[state.input.ordinal]
  if !component.inline || !sameSelector(&component.selector, &vertex.selector) { return false }
  let original = List<Prepared.Component>.asSlice(&shapes[endpoints[endpoint.index].shape.index].components)
  let mut inline = false
  let mut ordinal = usize.ZERO
  while ordinal < original.length {
    if original[ordinal].inline && sameSelector(&original[ordinal].selector, &vertex.selector) { inline = true }
    ordinal = ordinal + usize.ONE
  }
  if !inline { return false }
  let maps = List<Prepared.SelectionMap>.asSlice(&prepared.maps)
  let selection = &List<Prepared.Selection>.asSlice(&prepared.selections)[state.selection.index]
  let selected = List<MapId>.asSlice(&selection.maps)
  let mut edge = false
  let mut at = usize.ZERO
  while at < selected.length {
    let map = &maps[selected[at].index]
    if map.site.index == selection.site.index && map.kind == MapKind.Select && map.source.index == endpoint.index
      && map.target.index == state.vertex.index && sameSelector(&map.selector, &vertex.selector) { edge = true }
    at = at + usize.ONE
  }
  if !edge { return false }
  if root.index == current.index { return state.vertex.index == target.index }
  let next = List<Prepared.ResidualStateId>.asSlice(&state.next)
  at = usize.ZERO
  while at < next.length {
    if states[next[at].index].selection.index == state.selection.index && states[next[at].index].input.shape.index == state.output.index
      && receiverPrefixHistory(prepared, state.vertex, next[at], current, target, remaining - usize.ONE) { return true }
    at = at + usize.ONE
  }
  return false
}

pub fn receiverPrefix<'body>(prepared: &SourcePreparation<'body>, channel: usize, projection: ContractProjectionId,
  root: Prepared.ResidualStateId, current: Prepared.ResidualStateId) -> bool {
  let call = &List<Prepared.InvocationChannel>.asSlice(&prepared.invocationChannels)[channel]
  let selected = &List<Prepared.ContractProjection>.asSlice(&prepared.contractProjections)[projection.index]
  let states = List<Prepared.ResidualState>.asSlice(&prepared.residuals)
  let selection = &List<Prepared.Selection>.asSlice(&prepared.selections)[states[root.index].selection.index]
  if selected.application.index != call.application.index || selected.stage != Prepared.ContractProjectionStage.OriginalToReceiver
    || selection.site.index != List<Prepared.Operation>.asSlice(&prepared.operations)[call.operation].site.index { return false }
  let listed = List<ContractProjectionId>.asSlice(&call.receiverProjections)
  let mut member = false
  let mut at = usize.ZERO
  while at < listed.length { if listed[at].index == projection.index { member = true } at = at + usize.ONE }
  return member && receiverPrefixHistory(prepared, List<Prepared.SelectionMap>.asSlice(&prepared.maps)[call.map.index].source,
    root, current, selected.output, states.length)
}

fn validateDescriptorCandidate<'body>(prepared: &SourcePreparation<'body>, candidate: Candidate) -> () {
  let binding = match candidate.binding { Binding.DescriptorInput {channel, source, ..} =>
    DescriptorDeclaration {channel: channel, source: source}
    _ => { return CompilerBug.panic(b"descriptor result substituted an argument binding") } }
  let operations = List<Prepared.Operation>.asSlice(&prepared.operations)
  let channels = List<Prepared.ProducerChannel>.asSlice(&prepared.producerChannels)
  let projections = List<Prepared.ContractProjection>.asSlice(&prepared.contractProjections)
  let selections = List<Prepared.ContractSelection>.asSlice(&prepared.contractSelections)
  let routes = List<Prepared.ContractRoute>.asSlice(&prepared.routes)
  let maps = List<Prepared.SelectionMap>.asSlice(&prepared.maps)
  let endpoints = List<Prepared.Endpoint>.asSlice(&prepared.endpoints)
  if candidate.operation >= operations.length || binding.channel >= channels.length
    || candidate.projection.index >= projections.length || candidate.selection.index >= selections.length || candidate.route.index >= routes.length
    || candidate.output.index >= maps.length || descriptorMap(binding.source).index >= maps.length
    || candidate.source.index >= endpoints.length || candidate.target.index >= endpoints.length {
    CompilerBug.panic(b"descriptor result is outside its exact prepared domain")
  }
  let operation = &operations[candidate.operation]
  let channel = &channels[binding.channel]
  validateDescriptorSource(prepared, binding.channel, binding.source)
  let invocation = match candidate.binding { Binding.DescriptorInput {invocation, ..} => invocation
    _ => { return CompilerBug.panic(b"descriptor source omitted its executing authority") } }
  let mut requestedAnchor = candidate.target
  let mut prefix = Option<DescriptorPrefix>.none()
  match invocation {
    Option<DescriptorInvocation>.Some {value} => {
      let calls = List<Prepared.InvocationChannel>.asSlice(&prepared.invocationChannels)
      if value.channel >= calls.length { CompilerBug.panic(b"captured callable result lost its invocation channel") }
      let call = &calls[value.channel]
      prefix = value.prefix
      if operation.phase != OperationPhase.Invoke || call.operation != candidate.operation || channel.channel != Prepared.ContractPort.Result {
        CompilerBug.panic(b"captured callable result changed its producer/invocation phase")
      }
      let listed = List<ContractProjectionId>.asSlice(&call.resultProjections)
      let mut found = usize.ZERO
      let mut at = usize.ZERO
      while at < listed.length { if listed[at].index == value.resultProjection.index { found = found + usize.ONE } at = at + usize.ONE }
      if found != usize.ONE { CompilerBug.panic(b"captured callable placement lost its exact A result projection membership") }
      let selection = match value.resultContinuation {
        Option<ContractContinuationId>.Some {value} => List<Prepared.ContractContinuation>.asSlice(&prepared.contractContinuations)[value.index].originalSelection
        _ => rootSelection(prepared, value.resultProjection)
      }
      validateContributor(prepared, candidate.operation, candidate.output, value.resultProjection, value.resultContinuation, selection)
      match value.resultContinuation {
        Option<ContractContinuationId>.Some {value: current} => {
          let root = match value.resultRoot { Option<ContractContinuationId>.Some {value} => value
            _ => { return CompilerBug.panic(b"captured callable result lost its paired A continuation root") } }
          let rows = List<Prepared.ContractContinuation>.asSlice(&prepared.contractContinuations)
          if !hasContinuation(List<ContractContinuationId>.asSlice(&projections[value.resultProjection.index].continuations), root)
            || !descriptorContinuationDescends(rows, root, current, rows.length) {
            CompilerBug.panic(b"captured callable result changed its exact A root/current placement")
          }
        }
        _ => { if let Option<ContractContinuationId>.Some {..} = value.resultRoot { CompilerBug.panic(b"whole callable placement retained a selected root") } }
      }
      requestedAnchor = maps[call.map.index].source
    }
    _ => {
      if operation.phase != OperationPhase.ExecuteEffect || channel.channel != Prepared.ContractPort.Success {
        CompilerBug.panic(b"descriptor source changed its executing phase")
      }
    }
  }
  let receiver = match operation.receiver { Option<EndpointId>.Some {value} => value
    _ => { return CompilerBug.panic(b"descriptor execution lost its actual receiver") } }
  if !inFamily(maps, operationResult(operation), candidate.output) || maps[candidate.output.index].target.index != candidate.target.index
    || !nodeValue(&endpoints[candidate.source.index], inputOperand(prepared, operation.site, Prepared.InputRead.Receiver)) {
    CompilerBug.panic(b"descriptor result changed its executing input/output coordinates")
  }
  if let Option<DescriptorInvocation>.None = invocation {
    let success = &endpoints[maps[candidate.output.index].source.index]
    let exact = match success.parent { Option<EndpointId>.Some {value} => value.index == receiver.index _ => false }
    if candidate.output.index != operationResult(operation).index || !exact
      || !sameSelector(&success.selector, &Prepared.Selector.EffectSuccess) || maps[candidate.output.index].kind != MapKind.Contract {
      CompilerBug.panic(b"descriptor result replaced the actual Run success bridge")
    }
  }
  let projected = &projections[candidate.projection.index]
  let listed = List<ContractProjectionId>.asSlice(&channel.projections)
  let mut matches = usize.ZERO
  let mut at = usize.ZERO
  while at < listed.length { if listed[at].index == candidate.projection.index { matches = matches + usize.ONE } at = at + usize.ONE }
  if matches != usize.ONE || projected.application.index != channel.application.index {
    CompilerBug.panic(b"descriptor result substituted a producer projection")
  }
  let selected = &selections[candidate.selection.index]
  let original = &routes[candidate.route.index]
  if selected.application.index != channel.application.index || selected.output.index != projected.original.index
    || original.application.index != channel.application.index || original.source.index != descriptorOriginal(prepared, binding.source).index
    || original.target.index != selected.output.index || !sameResidual(original.targetResidual, selected.residual) {
    CompilerBug.panic(b"descriptor result changed its original input/result enumeration")
  }
  let members = List<ContractRouteId>.asSlice(&selected.routes)
  matches = usize.ZERO
  at = usize.ZERO
  while at < members.length { if members[at].index == candidate.route.index { matches = matches + usize.ONE } at = at + usize.ONE }
  if matches != usize.ONE { CompilerBug.panic(b"descriptor result route lost its original contributor") }
  validateLinks(prepared, List<MapId>.asSlice(&original.maps), channel.application, original.source, original.target)
  validateLinks(prepared, List<MapId>.asSlice(&projected.maps), channel.application, projected.original, projected.output)
  match candidate.continuation {
    Option<ContractContinuationId>.None => {
      if let Option<Prepared.ResidualStateId>.Some {..} = selected.residual { CompilerBug.panic(b"whole producer result substituted a residual row") }
    }
    Option<ContractContinuationId>.Some {value} => {
      let continuations = List<Prepared.ContractContinuation>.asSlice(&prepared.contractContinuations)
      if value.index >= continuations.length { CompilerBug.panic(b"descriptor result lost its original continuation") }
      let current = &continuations[value.index]
      if current.projection.index != candidate.projection.index || current.originalSelection.index != candidate.selection.index {
        CompilerBug.panic(b"descriptor result continuation belongs to another original contributor")
      }
    }
  }
  if let Binding.DescriptorInput {requestedRoot, requested, producerRoot, producerState, originalRoot, ..} = candidate.binding {
    let states = List<Prepared.ResidualState>.asSlice(&prepared.residuals)
    match requestedRoot {
      Option<Prepared.ResidualStateId>.None => {
        if let Option<DescriptorPrefix>.Some {..} = prefix { CompilerBug.panic(b"whole descriptor result discarded its relative suffix") }
        if projected.output.index != maps[channel.map.index].target.index { CompilerBug.panic(b"whole descriptor output substituted an inline producer projection") }
        if let Option<Prepared.ResidualStateId>.Some {..} = requested { CompilerBug.panic(b"whole descriptor output retained an unrooted suffix") }
        if let Option<Prepared.ResidualStateId>.Some {..} = producerRoot { CompilerBug.panic(b"whole descriptor output invented a producer suffix") }
        if let Option<Prepared.ResidualStateId>.Some {..} = producerState { CompilerBug.panic(b"whole descriptor output invented a producer component") }
        if let Option<ContractContinuationId>.Some {..} = candidate.continuation { CompilerBug.panic(b"selected descriptor output became whole") }
      }
      Option<Prepared.ResidualStateId>.Some {value: root} => {
        let current = match requested { Option<Prepared.ResidualStateId>.Some {value} => value _ => { return CompilerBug.panic(b"descriptor output lost its requested current state") } }
        let earlierRoot = match producerRoot { Option<Prepared.ResidualStateId>.Some {value} => value _ => { return CompilerBug.panic(b"descriptor output lost its producer root state") } }
        let earlier = match producerState { Option<Prepared.ResidualStateId>.Some {value} => value _ => { return CompilerBug.panic(b"descriptor output lost its producer current state") } }
        if root.index >= states.length || current.index >= states.length || earlierRoot.index >= states.length || earlier.index >= states.length {
          CompilerBug.panic(b"descriptor output suffix is outside its frozen state domain")
        }
        let mut requestedShape = endpoints[requestedAnchor.index].shape
        let mut producerShape = endpoints[maps[channel.map.index].target.index].shape
        if let Option<DescriptorPrefix>.Some {value: path} = prefix {
          let call = match invocation { Option<DescriptorInvocation>.Some {value} => value.channel
            _ => { return CompilerBug.panic(b"segmented descriptor suffix omitted A invocation authority") } }
          if !receiverPrefix(prepared, call, path.projection, path.requestedRoot, path.requested)
            || states[path.requestedRoot.index].input.shape.index != requestedShape.index
            || states[path.root.index].input.shape.index != producerShape.index
            || !residualDescends(states, path.root, path.current, states.length)
            || states[path.requestedRoot.index].selection.index != states[path.root.index].selection.index
            || states[path.requestedRoot.index].vertex.index != states[path.root.index].vertex.index
            || states[path.requested.index].selection.index != states[path.current.index].selection.index
            || states[path.requested.index].vertex.index != states[path.current.index].vertex.index {
            CompilerBug.panic(b"segmented descriptor result changed its exact inline prefix history")
          }
          requestedShape = states[path.requested.index].output
          producerShape = states[path.current.index].output
        }
        if states[root.index].input.shape.index != requestedShape.index
          || states[earlierRoot.index].input.shape.index != producerShape.index
          || !residualDescends(states, root, current, states.length) || !residualDescends(states, earlierRoot, earlier, states.length)
          || states[root.index].selection.index != states[earlierRoot.index].selection.index
          || states[root.index].vertex.index != states[earlierRoot.index].vertex.index
          || states[current.index].selection.index != states[earlier.index].selection.index
          || states[current.index].vertex.index != states[earlier.index].vertex.index {
          CompilerBug.panic(b"descriptor output changed its paired rooted authored suffixes")
        }
      }
    }
    match candidate.continuation {
      Option<ContractContinuationId>.Some {value} => {
        let root = match originalRoot { Option<ContractContinuationId>.Some {value} => value
          _ => { return CompilerBug.panic(b"descriptor continuation lost its original projection root") } }
        let rows = List<Prepared.ContractContinuation>.asSlice(&prepared.contractContinuations)
        if !hasContinuation(List<ContractContinuationId>.asSlice(&projected.continuations), root)
          || !descriptorContinuationDescends(rows, root, value, rows.length)
          || !sameResidual(producerState, Option<Prepared.ResidualStateId>.some(rows[value.index].outputState)) {
          CompilerBug.panic(b"descriptor continuation changed its original root/current projection")
        }
      }
      _ => { if let Option<ContractContinuationId>.Some {..} = originalRoot { CompilerBug.panic(b"whole producer contributor invented a continuation root") } }
    }
  }
  // Actual source endpoint membership and paired cursor gates are checked against the
  // retained runtime capture/placement proof before emitting a transfer.
  return ()
}
struct DescriptorDeclaration {channel: usize, source: DescriptorSource}

fn validatePlacementStep<'body>(prepared: &SourcePreparation<'body>, candidate: Candidate,
  id: ContractContinuationId) -> () {
  let continuations = List<Prepared.ContractContinuation>.asSlice(&prepared.contractContinuations)
  if id.index >= continuations.length { CompilerBug.panic(b"result placement names an absent continuation") }
  let continued = &continuations[id.index]
  validateContributor(prepared, candidate.operation, candidate.output, placementProjection(candidate),
    Option<ContractContinuationId>.some(id), continued.originalSelection)
  let states = List<Prepared.ResidualState>.asSlice(&prepared.residuals)
  let state = &states[continued.outputState.index]
  let shapes = List<Prepared.Shape>.asSlice(&prepared.shapes)
  let endpoints = List<Prepared.Endpoint>.asSlice(&prepared.endpoints)
  if state.input.shape.index >= shapes.length || state.vertex.index >= endpoints.length {
    CompilerBug.panic(b"result placement lost its authored component coordinate")
  }
  let components = List<Prepared.Component>.asSlice(&shapes[state.input.shape.index].components)
  if state.input.ordinal >= components.length
    || !sameSelector(&components[state.input.ordinal].selector, &endpoints[state.vertex.index].selector) {
    CompilerBug.panic(b"result placement changed its exact authored component selector")
  }
  // This checks the declared suffix graph, NOT vertex ancestry under the actual result.
  // Each authored vertex has one parent, and one next state per child vertex at a fixed
  // parent state. Thus fixed root/current has one output selector path even if original
  // normalization alternatives diverge and reconverge in the paired continuation graph.
  let next = List<Prepared.ResidualStateId>.asSlice(&state.next)
  let mut at = usize.ZERO
  while at < next.length {
    if next[at].index >= states.length { CompilerBug.panic(b"result placement has an absent authored successor") }
    let child = &states[next[at].index]
    if child.vertex.index >= endpoints.length || child.selection.index != state.selection.index
      || child.input.shape.index != state.output.index {
      CompilerBug.panic(b"result placement authored successor changed its exact subject")
    }
    let parent = match endpoints[child.vertex.index].parent {
      Option<EndpointId>.Some {value} => value.index == state.vertex.index
      _ => false
    }
    if !parent { CompilerBug.panic(b"result placement authored successor is not a direct selector step") }
    let mut before = usize.ZERO
    while before < at {
      if states[next[before].index].vertex.index == child.vertex.index && next[before].index != next[at].index {
        CompilerBug.panic(b"one authored result step has conflicting successor states")
      }
      before = before + usize.ONE
    }
    at = at + usize.ONE
  }
  return ()
}

fn validatePlacementEdge<'body>(prepared: &SourcePreparation<'body>, candidate: Candidate,
  from: ContractContinuationId, to: ContractContinuationId) -> () {
  validatePlacementStep(prepared, candidate, to)
  let continuations = List<Prepared.ContractContinuation>.asSlice(&prepared.contractContinuations)
  let states = List<Prepared.ResidualState>.asSlice(&prepared.residuals)
  let next = List<Prepared.ResidualStateId>.asSlice(&states[continuations[from.index].outputState.index].next)
  let mut found = false
  let mut at = usize.ZERO
  while at < next.length {
    if next[at].index == continuations[to.index].outputState.index { found = true }
    at = at + usize.ONE
  }
  if !found { CompilerBug.panic(b"result placement paired edge lost its authored output step") }
  return ()
}

fn namedCall<'body>(prepared: &SourcePreparation<'body>, site: NodeId) -> bool {
  if site.index >= prepared.body.nodes.length { return CompilerBug.panic(b"result operation names an absent typed node") }
  return match &prepared.body.nodes[site.index].kind {
    NodeKind.Expression {form: Expression.DirectCall {..}, ..} => true
    NodeKind.Expression {form: Expression.InterfaceCall {..}, ..} => true
    _ => false
  }
}

fn actualReceiver<'body>(prepared: &SourcePreparation<'body>, visit: &Visit,
  operation: &Prepared.Operation) -> Option<Receiver> {
  let endpoint = match operation.receiver {
    Option<EndpointId>.Some {value} => value
    _ => { return Option<Receiver>.none() }
  }
  let operand = inputOperand(prepared, visit.node, Prepared.InputRead.Receiver)
  let endpoints = List<Prepared.Endpoint>.asSlice(&prepared.endpoints)
  if endpoint.index >= endpoints.length || !nodeValue(&endpoints[endpoint.index], operand)
    || !rootEndpoint(&endpoints[endpoint.index]) {
    return CompilerBug.panic(b"result receiver changed its actual operand endpoint")
  }
  let inputs = List<Traversal.Input>.asSlice(&visit.inputs)
  let mut result = Option<Receiver>.none()
  let mut position = usize.ZERO
  while position < inputs.length {
    if let Option<Prepared.InputRead>.Some {value: Prepared.InputRead.Receiver} = inputs[position].read {
      if inputs[position].node.index != operand.index { return CompilerBug.panic(b"result receiver changed its typed operand") }
      if let Option<Receiver>.Some {..} = result { return CompilerBug.panic(b"result receiver has duplicate actual occurrences") }
      result = Option<Receiver>.some(Receiver {endpoint: endpoint, position: position, actual: inputs[position]})
    }
    position = position + usize.ONE
  }
  if let Option<Receiver>.None = result { return CompilerBug.panic(b"prepared result receiver has no actual read occurrence") }
  return result
}

effect fn actualInputs<'body>(prepared: &SourcePreparation<'body>, visit: &Visit,
  operation: &Prepared.Operation) -> List<Input> ! OutOfMemoryError ? &mut Allocator {
  let routes = List<InputRoute>.asSlice(&operation.inputs)
  let actual = List<Traversal.Input>.asSlice(&visit.inputs)
  let mut inputs = List<Input>.make()
  let mut position = usize.ZERO
  while position < actual.length {
    if let Option<Prepared.InputRead>.Some {value: read} = actual[position].read {
      let mut route = usize.ZERO
      while route < routes.length {
        if sameInputRead(read, routes[route].read) {
          let input = Traversal.routeInput(prepared, visit, &routes[route])
          if input.evaluation.index != actual[position].evaluation.index || input.usePoint.index != actual[position].usePoint.index {
            CompilerBug.panic(b"operation result input changed its actual evaluation or use point")
          }
          run List<Input>.append(&mut inputs, Input {route: route, position: position, actual: input})
        }
        route = route + usize.ONE
      }
    }
    position = position + usize.ONE
  }
  if List<Input>.length(&inputs) != routes.length {
    CompilerBug.panic(b"prepared result input has no unique actual operand coordinate")
  }
  return move inputs
}

effect fn operationPlan<'body>(prepared: &SourcePreparation<'body>, visit: &Visit,
  operation: usize, inputs: &[Input]) -> Plan ! OutOfMemoryError ? &mut Allocator {
  let row = &List<Prepared.Operation>.asSlice(&prepared.operations)[operation]
  return match row.phase {
    OperationPhase.PrepareEffect => {
      if let Option<MapId>.Some {..} = row.result { return CompilerBug.panic(b"effect preparation has an invocation result family") }
      let constructions = List<Prepared.Construction>.asSlice(&prepared.constructions)
      let mut found = usize.MAX
      let mut at = usize.ZERO
      while at < constructions.length {
        if constructions[at].site.index == row.site.index {
          if found != usize.MAX { return CompilerBug.panic(b"effect preparation has duplicate constructions") }
          found = at
        }
        at = at + usize.ONE
      }
      if found == usize.MAX { return CompilerBug.panic(b"effect preparation lost its physical construction") }
      Plan.PrepareEffect {application: operationApplication(row), construction: found}
    }
    OperationPhase.ExecuteEffect => {
      let receiver = match row.receiver {
        Option<EndpointId>.Some {value} => value
        _ => { return CompilerBug.panic(b"effect execution has no actual receiver endpoint") }
      }
      Plan.ExecuteEffect {receiver: receiver, result: operationResult(row)}
    }
    OperationPhase.Invoke => {
      let application = operationApplication(row)
      let result = operationResult(row)
      if namedCall(prepared, visit.node) {
        let outputs = run namedOutputs(prepared, visit, operation, inputs, result)
        Plan.NamedInvoke {application: application, result: result, outputs: move outputs}
      } else {
        let channels = List<Prepared.InvocationChannel>.asSlice(&prepared.invocationChannels)
        let mut channel = Option<usize>.none()
        let mut at = usize.ZERO
        while at < channels.length {
          if channels[at].operation == operation {
            if let Option<usize>.Some {..} = channel { CompilerBug.panic(b"callable result has duplicate receiver bridges") }
            channel = Option<usize>.some(at)
          }
          at = at + usize.ONE
        }
        if let Option<usize>.None = channel { CompilerBug.panic(b"actual callable invocation has no frozen receiver channel") }
        let outputs = run namedOutputs(prepared, visit, operation, inputs, result)
        Plan.CallableInvoke {application: application, result: result, channel: channel, outputs: move outputs}
      }
    }
  }
}

fn operationApplication(operation: &Prepared.Operation) -> ApplicationId {
  return match operation.application {
    Option<ApplicationId>.Some {value} => value
    _ => CompilerBug.panic(b"declared result operation has no application")
  }
}
fn operationResult(operation: &Prepared.Operation) -> MapId {
  return match operation.result {
    Option<MapId>.Some {value} => value
    _ => CompilerBug.panic(b"executing operation has no exact result family")
  }
}

// Only explicit family children extend this inventory. Maps with equal sites/types/endpoints
// elsewhere in the table do not acquire membership. Family order is the frozen component order.
effect fn namedOutputs<'body>(prepared: &SourcePreparation<'body>, visit: &Visit, operation: usize,
  inputs: &[Input], result: MapId) -> List<Output> ! OutOfMemoryError ? &mut Allocator {
  let maps = List<Prepared.SelectionMap>.asSlice(&prepared.maps)
  let projections = List<Prepared.ContractProjection>.asSlice(&prepared.contractProjections)
  let row = &List<Prepared.Operation>.asSlice(&prepared.operations)[operation]
  let application = operationApplication(row)
  let family = run mapFamily(maps, result)
  let mut outputs = List<Output>.make()
  let mut at = usize.ZERO
  while at < List<MapId>.length(&family) {
    let map = List<MapId>.asSlice(&family)[at]
    validateOutput(prepared, row, map)
    let mut contributors = List<Contributor>.make()
    let mut projection = usize.ZERO
    while projection < projections.length {
      let selected = &projections[projection]
      if selected.application.index == application.index && selected.output.index == maps[map.index].source.index
        && selected.stage == Prepared.ContractProjectionStage.OriginalToApplied {
        let id = ContractProjectionId {index: projection}
        let selection = rootSelection(prepared, id)
        run List<Contributor>.append(&mut contributors, run contributor(prepared, visit, operation, inputs,
          map, id, Option<ContractContinuationId>.none(), selection))
        // Keep the finite graph's identities, including every normalized original contributor.
        // Reaching an existing ID schedules no new path string and discards no distinct ID.
        let mut pending = List<ContractContinuationId>.make()
        let roots = List<ContractContinuationId>.asSlice(&selected.continuations)
        let mut each = usize.ZERO
        while each < roots.length { run appendContinuation(&mut pending, roots[each]) each = each + usize.ONE }
        let mut next = usize.ZERO
        while next < List<ContractContinuationId>.length(&pending) {
          let continuation = List<ContractContinuationId>.asSlice(&pending)[next]
          let continuations = List<Prepared.ContractContinuation>.asSlice(&prepared.contractContinuations)
          if continuation.index >= continuations.length || continuations[continuation.index].projection.index != id.index {
            CompilerBug.panic(b"result continuation left its exact projection")
          }
          let continued = &continuations[continuation.index]
          run List<Contributor>.append(&mut contributors, run contributor(prepared, visit, operation, inputs,
            map, id, Option<ContractContinuationId>.some(continuation), continued.originalSelection))
          let onward = List<ContractContinuationId>.asSlice(&continued.next)
          each = usize.ZERO
          while each < onward.length { run appendContinuation(&mut pending, onward[each]) each = each + usize.ONE }
          next = next + usize.ONE
        }
      }
      projection = projection + usize.ONE
    }
    if List<Contributor>.length(&contributors) == usize.ZERO {
      CompilerBug.panic(b"named result family has no original contract projection")
    }
    run List<Output>.append(&mut outputs, Output {map: map, contributors: move contributors})
    at = at + usize.ONE
  }
  return move outputs
}

// The producer's family is ordered root first, then its explicit inline children. Reference
// contents and semantic channels are not inline members; no endpoint-table scan adds them.
pub effect fn mapFamily(maps: &[Prepared.SelectionMap], root: MapId) -> List<MapId>
! OutOfMemoryError ? &mut Allocator {
  let mut family = List<MapId>.make()
  run List<MapId>.append(&mut family, root)
  let mut at = usize.ZERO
  while at < List<MapId>.length(&family) {
    let map = List<MapId>.asSlice(&family)[at]
    if map.index >= maps.length { CompilerBug.panic(b"candidate family contains an absent map") }
    let children = List<MapId>.asSlice(&maps[map.index].children)
    let mut each = usize.ZERO
    while each < children.length {
      let existing = List<MapId>.asSlice(&family)
      let mut before = usize.ZERO
      while before < existing.length {
        if existing[before].index == children[each].index { CompilerBug.panic(b"candidate family repeats a map or contains a cycle") }
        before = before + usize.ONE
      }
      run List<MapId>.append(&mut family, children[each])
      each = each + usize.ONE
    }
    at = at + usize.ONE
  }
  return move family
}

effect fn appendContinuation(values: &mut List<ContractContinuationId>, id: ContractContinuationId) -> ()
! OutOfMemoryError ? &mut Allocator {
  let existing = List<ContractContinuationId>.asSlice(&values.*)
  let mut at = usize.ZERO
  while at < existing.length {
    if existing[at].index == id.index { return () }
    at = at + usize.ONE
  }
  run List<ContractContinuationId>.append(&mut values.*, id)
  return ()
}

pub fn rootSelection<'body>(prepared: &SourcePreparation<'body>, projection: ContractProjectionId) -> ContractSelectionId {
  let selected = &List<Prepared.ContractProjection>.asSlice(&prepared.contractProjections)[projection.index]
  let rows = List<Prepared.ContractSelection>.asSlice(&prepared.contractSelections)
  let mut found = usize.MAX
  let mut at = usize.ZERO
  while at < rows.length {
    let whole = match rows[at].residual { Option<Prepared.ResidualStateId>.None => true _ => false }
    if rows[at].application.index == selected.application.index && rows[at].output.index == selected.original.index && whole {
      if found != usize.MAX { return CompilerBug.panic(b"result projection has duplicate original enumerations") }
      found = at
    }
    at = at + usize.ONE
  }
  if found == usize.MAX { return CompilerBug.panic(b"result projection lost its original enumeration") }
  return ContractSelectionId {index: found}
}

effect fn contributor<'body>(prepared: &SourcePreparation<'body>, visit: &Visit, operation: usize,
  inputs: &[Input], output: MapId, projection: ContractProjectionId,
  continuation: Option<ContractContinuationId>, selection: ContractSelectionId) -> Contributor
! OutOfMemoryError ? &mut Allocator {
  validateContributor(prepared, operation, output, projection, continuation, selection)
  let row = &List<Prepared.Operation>.asSlice(&prepared.operations)[operation]
  let routes = List<InputRoute>.asSlice(&row.inputs)
  let selections = List<Prepared.ContractSelection>.asSlice(&prepared.contractSelections)
  let declared = List<ContractRouteId>.asSlice(&selections[selection.index].routes)
  let originals = List<Prepared.ContractRoute>.asSlice(&prepared.routes)
  let maps = List<Prepared.SelectionMap>.asSlice(&prepared.maps)
  let mut candidates = List<Candidate>.make()
  // Keep actual operand order, then the producer's inline family order, then declaration
  // alternatives. These are distinct physical positions at one Eval/usePoint, not extra reads.
  let mut at = usize.ZERO
  while at < inputs.length {
    let physical = &routes[inputs[at].route]
    let family = run mapFamily(maps, physical.map)
    let members = List<MapId>.asSlice(&family)
    let mut member = usize.ZERO
    while member < members.length {
      let inputMap = members[member]
      let mut route = usize.ZERO
      while route < declared.length {
        if declared[route].index >= originals.length { CompilerBug.panic(b"result enumeration names an absent original route") }
        if originals[declared[route].index].source.index == physical.original.index {
          let candidate = Candidate {operation: operation, binding: Binding.Argument {input: inputs[at].route, inputMap: inputMap, position: inputs[at].position},
            operand: inputs[at].actual.evaluation, usePoint: inputs[at].actual.usePoint, result: visit.evaluation,
            source: maps[inputMap.index].source, target: maps[output.index].target, selection: selection,
            route: declared[route], projection: projection, continuation: continuation, output: output}
          validateCandidate(prepared, candidate)
          run List<Candidate>.append(&mut candidates, candidate)
        }
        route = route + usize.ONE
      }
      member = member + usize.ONE
    }
    at = at + usize.ONE
  }
  // A supported declared route without a physical input binding is a construction defect;
  // it must not disappear from the result just because it would be inconvenient to interpret.
  let mut route = usize.ZERO
  while route < declared.length {
    if declared[route].index >= originals.length { CompilerBug.panic(b"result enumeration names an absent original route") }
    let mut bound = false
    at = usize.ZERO
    while at < inputs.length {
      if originals[declared[route].index].source.index == routes[inputs[at].route].original.index { bound = true }
      at = at + usize.ONE
    }
    if !bound { CompilerBug.panic(b"original result contributor has no actual input binding") }
    route = route + usize.ONE
  }
  return Contributor {projection: projection, continuation: continuation, selection: selection, candidates: move candidates}
}

struct PreparedInput {input: usize, map: MapId}

/// Validates declaration/map authority only. The inventory constructor authenticates actual
/// Visit/input pairing; graph reservation additionally authenticates Eval nodes and use points.
/// No contract endpoint is materialized as a value merely to connect this evidence chain.
pub fn validateCandidate<'body>(prepared: &SourcePreparation<'body>, candidate: Candidate) -> () {
  let selected = match candidate.binding {
    Binding.Argument {input, inputMap, ..} => PreparedInput {input: input, map: inputMap}
    Binding.CallableArgument {input, inputMap, channel, receiverProjection, receiverContinuation, resultRoot, ..} => {
      let channels = List<Prepared.InvocationChannel>.asSlice(&prepared.invocationChannels)
      let projections = List<Prepared.ContractProjection>.asSlice(&prepared.contractProjections)
      if channel >= channels.length || channels[channel].operation != candidate.operation
        || receiverProjection.index >= projections.length { CompilerBug.panic(b"callable argument changed its invocation channel") }
      let rows = List<ContractProjectionId>.asSlice(&channels[channel].receiverProjections)
      let mut member = false
      let mut at = usize.ZERO
      while at < rows.length { if rows[at].index == receiverProjection.index { member = true } at = at + usize.ONE }
      if !member || projections[receiverProjection.index].original.index != projections[candidate.projection.index].original.index {
        CompilerBug.panic(b"callable argument lost its paired original projection")
      }
      if let Option<ContractContinuationId>.Some {value} = receiverContinuation {
        if List<Prepared.ContractContinuation>.asSlice(&prepared.contractContinuations)[value.index].projection.index != receiverProjection.index {
          CompilerBug.panic(b"callable argument changed its receiver continuation")
        }
      }
      match candidate.continuation {
        Option<ContractContinuationId>.Some {..} => {
          let root = match resultRoot { Option<ContractContinuationId>.Some {value} => value
            _ => { return CompilerBug.panic(b"callable selected result omitted its paired root") } }
          if !hasContinuation(List<ContractContinuationId>.asSlice(&projections[candidate.projection.index].continuations), root) {
            CompilerBug.panic(b"callable selected result invented a projection root")
          }
        }
        _ => { if let Option<ContractContinuationId>.Some {..} = resultRoot { CompilerBug.panic(b"whole callable result acquired a residual root") } }
      }
      PreparedInput {input: input, map: inputMap}
    }
    Binding.DescriptorInput {..} => { validateDescriptorCandidate(prepared, candidate) return () }
  }
  validateContributor(prepared, candidate.operation, candidate.output, candidate.projection,
    candidate.continuation, candidate.selection)
  let operation = &List<Prepared.Operation>.asSlice(&prepared.operations)[candidate.operation]
  let inputs = List<InputRoute>.asSlice(&operation.inputs)
  let routes = List<Prepared.ContractRoute>.asSlice(&prepared.routes)
  let maps = List<Prepared.SelectionMap>.asSlice(&prepared.maps)
  let endpoints = List<Prepared.Endpoint>.asSlice(&prepared.endpoints)
  let application = operationApplication(operation)
  if selected.input >= inputs.length || candidate.route.index >= routes.length {
    CompilerBug.panic(b"result candidate names an absent physical input or original route")
  }
  let input = &inputs[selected.input]
  if input.map.index >= maps.length || selected.map.index >= maps.length
    || input.selected.index >= endpoints.length || input.original.index >= endpoints.length {
    CompilerBug.panic(b"result input lost its physical and declaration coordinates")
  }
  let physical = &maps[input.map.index]
  let identity = match &physical.selector { Prepared.Selector.Identity => true _ => false }
  if physical.site.index != operation.site.index || physical.kind != MapKind.Select || !identity
    || physical.source.index != physical.target.index || physical.source.index >= endpoints.length
    || input.transport != Prepared.Transport.Evaluated {
    CompilerBug.panic(b"named result input has no exact evaluated operand binding")
  }
  if let Option<MapId>.Some {..} = input.referent { CompilerBug.panic(b"ordinary named input invented an implicit reference") }
  let operand = inputOperand(prepared, operation.site, input.read)
  if !nodeValue(&endpoints[physical.source.index], operand)
    || !applicationEndpoint(&endpoints[input.selected.index], application, Prepared.ContractPort.Input, TypeSpace.Selected)
    || !applicationEndpoint(&endpoints[input.original.index], application, Prepared.ContractPort.Input, TypeSpace.Original) {
    CompilerBug.panic(b"named result binding changed its actual operand or declaration owner")
  }
  if !rootEndpoint(&endpoints[physical.source.index]) || !rootEndpoint(&endpoints[input.selected.index])
    || !rootEndpoint(&endpoints[input.original.index]) {
    CompilerBug.panic(b"ordinary named input binding substituted a component for its whole operand")
  }
  // Original single-source admission binds the whole input. Its actual inline family carries
  // the owned component positions; the original declaration endpoint remains the whole input.
  // This join follows explicit map children only, never equal regions or endpoint shapes.
  if !inFamily(maps, input.map, selected.map) {
    CompilerBug.panic(b"result candidate input map is outside its exact operand family")
  }
  let member = &maps[selected.map.index]
  let memberIdentity = match &member.selector { Prepared.Selector.Identity => true _ => false }
  if member.site.index != operation.site.index || member.kind != MapKind.Select || !memberIdentity
    || member.source.index != member.target.index || member.source.index != candidate.source.index
    || candidate.source.index >= endpoints.length || !nodeValue(&endpoints[candidate.source.index], operand)
    || member.componentTransport || member.addressTransport {
    CompilerBug.panic(b"result candidate changed its exact inline operand position")
  }
  if let Option<ApplicationId>.Some {..} = member.application {
    CompilerBug.panic(b"result input component substituted declaration-map authority")
  }
  let selectedOrdinal = match &endpoints[input.selected.index].root {
    Root.Application {ordinal, ..} => ordinal
    _ => { return CompilerBug.panic(b"named input has no selected parameter coordinate") }
  }
  let originalOrdinal = match &endpoints[input.original.index].root {
    Root.Application {ordinal, ..} => ordinal
    _ => { return CompilerBug.panic(b"named input has no original parameter coordinate") }
  }
  if namedCall(prepared, operation.site) && selectedOrdinal != originalOrdinal { CompilerBug.panic(b"named input changed its declaration parameter ordinal") }
  let original = &routes[candidate.route.index]
  let selection = &List<Prepared.ContractSelection>.asSlice(&prepared.contractSelections)[candidate.selection.index]
  if original.application.index != application.index || original.source.index != input.original.index
    || original.target.index != selection.output.index || !sameResidual(original.targetResidual, selection.residual) {
    CompilerBug.panic(b"result route changed its exact original input or output subject")
  }
  let members = List<ContractRouteId>.asSlice(&selection.routes)
  let mut matches = usize.ZERO
  let mut at = usize.ZERO
  while at < members.length {
    if members[at].index == candidate.route.index { matches = matches + usize.ONE }
    at = at + usize.ONE
  }
  if matches != usize.ONE { CompilerBug.panic(b"result route is not a unique member of its original enumeration") }
  validateLinks(prepared, List<MapId>.asSlice(&original.maps), application, original.source, original.target)
  let premises = List<Prepared.PredicateId>.asSlice(&original.premises)
  let declared = List<Prepared.PredicateId>.asSlice(&List<Prepared.Application>.asSlice(&prepared.applications)[application.index].premises)
  at = usize.ZERO
  while at < premises.length {
    let mut found = false
    let mut each = usize.ZERO
    while each < declared.length { if declared[each].index == premises[at].index { found = true } each = each + usize.ONE }
    if !found || premises[at].index >= List<Prepared.Predicate>.length(&prepared.predicates) {
      CompilerBug.panic(b"result route substituted a foreign original premise")
    }
    at = at + usize.ONE
  }
  if candidate.target.index != maps[candidate.output.index].target.index {
    CompilerBug.panic(b"result candidate changed its actual output coordinate")
  }
  return ()
}

pub fn validateContributor<'body>(prepared: &SourcePreparation<'body>, operation: usize, output: MapId,
  projection: ContractProjectionId, continuation: Option<ContractContinuationId>, selection: ContractSelectionId) -> () {
  let operations = List<Prepared.Operation>.asSlice(&prepared.operations)
  let projections = List<Prepared.ContractProjection>.asSlice(&prepared.contractProjections)
  let selections = List<Prepared.ContractSelection>.asSlice(&prepared.contractSelections)
  let endpoints = List<Prepared.Endpoint>.asSlice(&prepared.endpoints)
  let maps = List<Prepared.SelectionMap>.asSlice(&prepared.maps)
  if operation >= operations.length || projection.index >= projections.length || selection.index >= selections.length {
    CompilerBug.panic(b"result contributor names an absent operation or contract row")
  }
  let row = &operations[operation]
  if row.phase != OperationPhase.Invoke {
    CompilerBug.panic(b"named result authority was attached to another operation phase")
  }
  if !namedCall(prepared, row.site) {
    let channels = List<Prepared.InvocationChannel>.asSlice(&prepared.invocationChannels)
    let mut found = false
    let mut at = usize.ZERO
    while at < channels.length {
      if channels[at].operation == operation {
        let listed = List<ContractProjectionId>.asSlice(&channels[at].resultProjections)
        let mut each = usize.ZERO
        while each < listed.length { if listed[each].index == projection.index { found = true } each = each + usize.ONE }
      }
      at = at + usize.ONE
    }
    if !found { CompilerBug.panic(b"callable result projection is outside its exact invocation bridge") }
  }
  let application = operationApplication(row)
  if application.index >= List<Prepared.Application>.length(&prepared.applications) {
    CompilerBug.panic(b"result contributor names an absent application")
  }
  if List<Prepared.Application>.asSlice(&prepared.applications)[application.index].site.index != row.site.index {
    CompilerBug.panic(b"named result application belongs to another operation")
  }
  validateOutput(prepared, row, output)
  if !inFamily(maps, operationResult(row), output) { CompilerBug.panic(b"result map is outside the operation's exact family") }
  let projected = &projections[projection.index]
  let selected = &selections[selection.index]
  if projected.application.index != application.index || projected.stage != Prepared.ContractProjectionStage.OriginalToApplied
    || projected.output.index != maps[output.index].source.index || selected.application.index != application.index
    || selected.output.index != projected.original.index || projected.original.index >= endpoints.length
    || !applicationEndpoint(&endpoints[projected.original.index], application, Prepared.ContractPort.Result, TypeSpace.Original) {
    CompilerBug.panic(b"result contributor lost its exact original-to-applied projection")
  }
  validateLinks(prepared, List<MapId>.asSlice(&projected.maps), application, projected.original, projected.output)
  match continuation {
    Option<ContractContinuationId>.None => {
      if let Option<Prepared.ResidualStateId>.Some {..} = selected.residual {
        CompilerBug.panic(b"whole result contributor substituted a residual original selection")
      }
    }
    Option<ContractContinuationId>.Some {value} => {
      let continuations = List<Prepared.ContractContinuation>.asSlice(&prepared.contractContinuations)
      if value.index >= continuations.length { CompilerBug.panic(b"result contributor names an absent continuation") }
      let continued = &continuations[value.index]
      if continued.projection.index != projection.index || continued.original.index != selected.output.index
        || continued.originalSelection.index != selection.index {
        CompilerBug.panic(b"result continuation changed its original enumeration")
      }
      let states = List<Prepared.ResidualState>.asSlice(&prepared.residuals)
      if continued.outputState.index >= states.length { CompilerBug.panic(b"result continuation lost its authored output state") }
      if let Prepared.ResidualAuthority.Contract {..} = states[continued.outputState.index].authority {
        CompilerBug.panic(b"result continuation output has original-contract authority")
      }
      let path = List<Prepared.ResidualStateId>.asSlice(&continued.originalPath)
      let mut at = usize.ZERO
      while at < path.length {
        if path[at].index >= states.length { CompilerBug.panic(b"result continuation lost its original path") }
        let exact = match states[path[at].index].authority {
          Prepared.ResidualAuthority.Contract {projection: actual, ..} => actual.index == projection.index
          _ => false
        }
        if !exact { CompilerBug.panic(b"result continuation path changed its original projection") }
        if at > usize.ZERO && states[path[at - usize.ONE].index].output.index != states[path[at].index].input.shape.index {
          CompilerBug.panic(b"result continuation original path is not contiguous")
        }
        at = at + usize.ONE
      }
      if path.length > usize.ZERO {
        let last = path[path.length - usize.ONE]
        if !sameResidual(selected.residual, Option<Prepared.ResidualStateId>.some(last)) {
          CompilerBug.panic(b"result continuation discarded its exact original residual subject")
        }
      }
      if let Option<Prepared.ResidualStateId>.Some {value: advancing} = continued.originalState {
        if path.length == usize.ZERO || path[path.length - usize.ONE].index != advancing.index {
          CompilerBug.panic(b"result continuation changed its advancing original state")
        }
      }
      // None with an empty originalPath keeps originalSelection verbatim, including an
      // already-residual opaque subject. It must never fall back to the projection's root row.
    }
  }
  return ()
}

fn validateOutput<'body>(prepared: &SourcePreparation<'body>, operation: &Prepared.Operation, output: MapId) -> () {
  let maps = List<Prepared.SelectionMap>.asSlice(&prepared.maps)
  let endpoints = List<Prepared.Endpoint>.asSlice(&prepared.endpoints)
  if output.index >= maps.length { CompilerBug.panic(b"operation result family contains an absent map") }
  let map = &maps[output.index]
  if map.source.index >= endpoints.length || map.target.index >= endpoints.length || map.kind != MapKind.Contract
    || map.site.index != operation.site.index || map.componentTransport || map.addressTransport {
    CompilerBug.panic(b"operation result family lost its declared output authority")
  }
  if let Option<ApplicationId>.Some {..} = map.application {
    CompilerBug.panic(b"actual output family substituted original contract-map authority")
  }
  if !nodeValue(&endpoints[map.target.index], operation.site)
    || !applicationEndpoint(&endpoints[map.source.index], operationApplication(operation), Prepared.ContractPort.Result, TypeSpace.Applied) {
    CompilerBug.panic(b"named result map changed its applied or actual output domain")
  }
  return ()
}

fn validateLinks<'body>(prepared: &SourcePreparation<'body>, links: &[MapId], application: ApplicationId,
  source: EndpointId, target: EndpointId) -> () {
  let maps = List<Prepared.SelectionMap>.asSlice(&prepared.maps)
  let mut anchored = false
  let mut at = usize.ZERO
  while at < links.length {
    if links[at].index >= maps.length { CompilerBug.panic(b"result authority names an absent contract map") }
    let map = &maps[links[at].index]
    let exact = match map.application { Option<ApplicationId>.Some {value} => value.index == application.index _ => false }
    if !exact || map.kind != MapKind.Contract || map.componentTransport || map.addressTransport
      || map.source.index >= List<Prepared.Endpoint>.length(&prepared.endpoints)
      || map.target.index >= List<Prepared.Endpoint>.length(&prepared.endpoints) {
      CompilerBug.panic(b"result authority substituted physical or foreign contract evidence")
    }
    if map.source.index == source.index && map.target.index == target.index { anchored = true }
    at = at + usize.ONE
  }
  if !anchored { CompilerBug.panic(b"result authority lost its exact endpoint correspondence") }
  return ()
}

// Family children are uniquely owned map identities in the frozen producer table. Follow
// their explicit parents, never endpoints, selectors, types or numeric table adjacency.
pub fn inFamily(maps: &[Prepared.SelectionMap], root: MapId, member: MapId) -> bool {
  let mut current = member
  let mut remaining = maps.length
  while remaining > usize.ZERO {
    if current.index == root.index { return true }
    let mut parent = usize.MAX
    let mut at = usize.ZERO
    while at < maps.length {
      let children = List<MapId>.asSlice(&maps[at].children)
      let mut child = usize.ZERO
      while child < children.length {
        if children[child].index == current.index {
          if parent != usize.MAX { return CompilerBug.panic(b"result family member has duplicate owning parents") }
          parent = at
        }
        child = child + usize.ONE
      }
      at = at + usize.ONE
    }
    if parent == usize.MAX { return false }
    current = MapId {index: parent}
    remaining = remaining - usize.ONE
  }
  return CompilerBug.panic(b"result family parent relation is cyclic")
}

fn applicationEndpoint(endpoint: &Prepared.Endpoint, application: ApplicationId,
  port: Prepared.ContractPort, space: TypeSpace) -> bool {
  return match &endpoint.root {
    Root.Application {application: actual, port: actualPort, space: actualSpace, ..} =>
      actual.index == application.index && actualPort == port && actualSpace == space
    _ => false
  }
}
fn nodeValue(endpoint: &Prepared.Endpoint, node: NodeId) -> bool {
  return match &endpoint.root { Root.Node {node: actual, role} => actual.index == node.index && role == EndpointRole.Value _ => false }
}
fn rootEndpoint(endpoint: &Prepared.Endpoint) -> bool {
  return match endpoint.parent { Option<EndpointId>.None => true _ => false }
}
fn sameResidual(left: Option<Prepared.ResidualStateId>, right: Option<Prepared.ResidualStateId>) -> bool {
  return match left {
    Option<Prepared.ResidualStateId>.Some {value} => match right { Option<Prepared.ResidualStateId>.Some {value: other} => value.index == other.index _ => false }
    Option<Prepared.ResidualStateId>.None => match right { Option<Prepared.ResidualStateId>.None => true _ => false }
  }
}
