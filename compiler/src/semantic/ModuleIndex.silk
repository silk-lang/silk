//! Syntax-only declaration and name membership for one requested source unit.
//!
//! # When to use
//! Use [`ModuleIndex`] after parsing a requested source. [`build`] reads authored declaration
//! headers and import binding syntax without opening imported modules or checking types or bodies.
//!
//! # Details
//! All authored declarations keep identities, including damaged declarations and anonymous callable
//! or Effect literals in abstract bodies. Literal identities count both static arms before selection.
//! A name lookup
//! returns the complete set of written candidates, including an empty set for an absent name.
//! Declarations in module-level `static if` arms belong to the module namespace; each records the
//! arm that admits it, and semantic selection decides which arms exist.

import hir.Hir {DeclarationStart, Diagnostic, HirId, HirRef, Module, Node, OwnerKey, OwnerKind, Range}
import hir.Intern {SymbolRef}
import semantic.ContentHash {ContentHash, Stream as ContentStream}
import semantic.DeclarationId {DeclarationId}
import semantic.InternIndex {InternIndex}
import semantic.ModuleId {ModuleId}
import semantic.SourceUnit {SourceUnit}
import silk.allocator {Allocator, OutOfMemoryError}
import silk.bytes {Bytes}
import silk.option {Option}
import silk.ownership {Copy}
import silk.shared {Shared}
import silk.usize
import silk.vector {Vector}
import lexer.Span {Span}
import lexer.Token {Token, TokenKind, kind as tokenKind, span as tokenSpan}
import silk.u8
import silk.u64

/// How a written name entered the module namespace.
pub enum CandidateKind {
  /// A named top-level declaration.
  Declaration,
  /// An imported module alias or final path segment.
  ImportModule,
  /// A name selected by an import member list.
  ImportMember,
}

/// One module-level `static if` arm: the conditional's selected branch must equal `holds`.
pub struct Arm {
  /// The ordinal of the conditional declaration in this index.
  pub conditional: usize
  /// Whether this arm is selected when the condition holds.
  pub holds: bool
}

impl Copy for Arm {}

fn copyArm(arm: &Option<Arm>) -> Option<Arm> {
  return match & arm.* {
    Option<Arm>.Some {value} => Option<Arm>.some(value)
    Option<Arm>.None => Option<Arm>.none()
  }
}

/// One authored declaration with its canonical and local identities.
pub struct IndexedDeclaration {
  /// The module and complete owner chain, independent of HIR indexes.
  pub identity: DeclarationId
  /// The node location in this index's source unit only.
  pub local: HirId
  /// The written contract location, or the literal itself for an implicit Effect-block header.
  pub header: HirId
  /// Whether same-key siblings make occurrence matching across revisions ambiguous.
  pub ambiguous: bool
  /// The ordinal of the directly enclosing declaration in this index; absent at module level.
  /// Static conditional arms are transparent: their declarations belong to the enclosing scope.
  pub parent: Option<usize>
  /// The innermost module-level `static if` arm that admits this declaration; absent when
  /// unconditional. The arm's conditional carries its own enclosing arm.
  pub arm: Option<Arm>
  /// The declaration's fingerprints, computed only for an index that a revision may replace;
  /// absent for an anonymous literal, which belongs to its enclosing declaration.
  pub fingerprints: Option<Fingerprints>
}

/// The authored declaration whose syntax contains one HIR node. A prototype input covers the
/// written callable header; a whole input also covers its body.
pub struct SyntaxInput {
  pub ordinal: usize
  pub prototype: bool
}

impl Copy for SyntaxInput {}

/// Syntactic changes to the two module-level implementation inventories. This does not resolve
/// an implementation's contract, provider, static condition, or semantic membership bucket.
pub struct ImplInventoryChanges {
  pub conformance: bool
  pub inherent: bool
}

impl Copy for ImplInventoryChanges {}

/// The content of one declaration that a revision compares (incremental v2 §3.1).
///
/// # Details
///
/// Each covers the declaration's significant tokens: trivia and positions are excluded, but
/// whether a line feed precedes a token is kept, since the parser reads line breaks. A directly
/// nested declaration with its own identity, such as an `impl` member or a static arm,
/// contributes its identity instead of its tokens, so editing it leaves its parent equal.
pub struct Fingerprints {
  /// The whole declaration.
  pub whole: ContentHash
  /// What a reader of the declaration's header consumes: the tokens before a function's body,
  /// and the whole declaration for every other form.
  pub prototype: ContentHash
}

impl Copy for Fingerprints {}

struct ComputedFingerprints {
  hashes: Fingerprints
  bytesHashed: usize
}

/// One named function or operation copied from authenticated authored syntax.
pub struct NamedFunction {
  /// The full canonical address, parent and static arm; local IDs are source-local only.
  pub declaration: IndexedDeclaration
  pub ordinal: usize
  pub span: Span
  pub headerSpan: Span
  /// The actual FunctionHeader/OperationHeader name child, never a spelling-derived offset.
  pub nameSpan: Span
  /// Source-local child identity for the authenticated SourceIndex span check.
  pub name: HirId
  pub hasBody: bool
  pub isStatic: bool
}

/// A syntax census, including explicit exclusions; this does not type any body.
pub struct FunctionInventory {
  pub functions: Vector<NamedFunction>
  /// Import declarations that contribute actual indexed bindings, once per declaration.
  pub imports: Vector<IndexedDeclaration>
  pub excludedAnonymous: usize
  pub excludedDamaged: usize
}

/// One syntax-derived binding of a written name to an authored declaration.
pub struct Candidate {
  /// The exact name bytes visible in this module.
  pub name: Bytes
  /// The ordinal of its authored declaration in this index.
  pub declaration: usize
  /// The binding category.
  pub kind: CandidateKind
  /// The member ordinal within an import, or zero for a declaration or module binding.
  pub ordinal: usize
  /// The HIR node that spells this binding in this source unit.
  pub local: HirId
  /// Whether this binding is written public.
  pub isPublic: bool
}

/// Two bindings in the same module that spell the same namespace name.
///
/// # Details
///
/// This is a syntax collision record. Later semantic rules decide whether the pair is permitted,
/// such as when callable overloads have distinct signatures.
pub struct Collision {
  /// The earlier candidate ordinal.
  pub first: usize
  /// The later candidate ordinal.
  pub second: usize
  /// The later binding's span in the retained source bytes.
  pub span: Span
}

impl Copy for Collision {}

struct Bucket {
  name: Bytes
  observation: Shared<NameObservation>
}

/// All authored declarations, module bindings, and syntax collisions in one source unit.
pub struct ModuleIndex {
  module: ModuleId
  revision: usize
  // Logical bytes appended to whole and prototype hashes while building this index.
  hashedByteCount: usize
  declarations: Vector<IndexedDeclaration>
  candidates: Vector<Candidate>
  collisions: Vector<Collision>
  buckets: Vector<Bucket>
  // Declarations by identity, same-key sibling class, enclosing declaration and local node;
  // candidates and buckets by name.
  identities: InternIndex
  siblings: InternIndex
  enclosures: InternIndex
  locals: InternIndex
  candidateNames: InternIndex
  bucketNames: InternIndex
}

/// A complete observed candidate set, including an empty set for absence.
pub struct NameObservation {
  module: ModuleId
  name: Bytes
  members: Vector<ObservedCandidate>
}

/// A candidate identity independent of one HIR arena or index position.
pub struct ObservedCandidate {
  /// The authored declaration that contains the binding.
  pub declaration: DeclarationId
  /// The binding category.
  pub kind: CandidateKind
  /// The import member ordinal, or zero for a declaration or module binding.
  pub ordinal: usize
  /// Whether the binding is written public.
  pub isPublic: bool
}

fn sameBytes(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut index = usize.ZERO
  while index < left.length {
    if left[index] != right[index] {
      return false
    }
    index = index + usize.ONE
  }
  return true
}

pub fn namedDeclaration(kind: OwnerKind) -> bool {
  return match kind {
    OwnerKind.Function => true
    OwnerKind.Struct => true
    OwnerKind.Tuple => true
    OwnerKind.Enumeration => true
    OwnerKind.Union => true
    OwnerKind.Service => true
    OwnerKind.Interface => true
    OwnerKind.Role => true
    OwnerKind.Constant => true
    OwnerKind.PackageParameter => true
    OwnerKind.Alias => true
    OwnerKind.Static => true
    _ => false
  }
}

fn publicHeader(header: Node) -> bool {
  return match header {
    Node.FunctionHeader {isPublic, ..} => isPublic
    Node.StructHeader {isPublic, ..} => isPublic
    Node.TupleHeader {isPublic, ..} => isPublic
    Node.EnumHeader {isPublic, ..} => isPublic
    Node.UnionHeader {isPublic, ..} => isPublic
    Node.ServiceHeader {isPublic, ..} => isPublic
    Node.InterfaceHeader {isPublic, ..} => isPublic
    Node.RoleHeader {isPublic, ..} => isPublic
    Node.ConstantHeader {isPublic, ..} => isPublic
    Node.PackageParameterHeader {isPublic, ..} => isPublic
    Node.AliasHeader {isPublic, ..} => isPublic
    Node.StaticHeader {isPublic, ..} => isPublic
    _ => false
  }
}

fn headerName(header: Node) -> HirRef {
  return match header {
    Node.FunctionHeader {name, ..} => HirRef.of(name)
    Node.StructHeader {name, ..} => HirRef.of(name)
    Node.TupleHeader {name, ..} => HirRef.of(name)
    Node.EnumHeader {name, ..} => HirRef.of(name)
    Node.UnionHeader {name, ..} => HirRef.of(name)
    Node.ServiceHeader {name, ..} => HirRef.of(name)
    Node.InterfaceHeader {name, ..} => HirRef.of(name)
    Node.RoleHeader {name, ..} => HirRef.of(name)
    Node.ConstantHeader {name, ..} => HirRef.of(name)
    Node.PackageParameterHeader {name, ..} => HirRef.of(name)
    Node.AliasHeader {name, ..} => HirRef.of(name)
    Node.StaticHeader {name, ..} => HirRef.of(name)
    _ => HirRef.absent()
  }
}

fn copyIndex(ordinal: &Option<usize>) -> Option<usize> {
  return match & ordinal.* {
    Option<usize>.Some {value} => Option<usize>.some(value)
    Option<usize>.None => Option<usize>.none()
  }
}

effect fn copyName(module: &Module, id: HirId) -> Option<Bytes> ! OutOfMemoryError ? &mut Allocator {
  return match Module.node(module, id) {
    Node.Name {text} => Option<Bytes>.some(run Bytes.copy(Module.text(module, text)))
    _ => Option<Bytes>.none()
  }
}

fn nameHash(name: &[u8]) -> u64 {
  return InternIndex.hashBytes(0, name)
}

// The first candidate at or after `position` along its name chain that is spelled `name`.
fn namedFrom(index: &ModuleIndex, position: usize, name: &[u8]) -> usize {
  let listed = Vector<Candidate>.asSlice(&index.candidates)
  let mut at = position
  while at != usize.MAX && !sameBytes(Bytes.asSlice(&listed[at].name), name) {
    at = InternIndex.after(&index.candidateNames, at)
  }
  return at
}

effect fn appendCandidate(index: &mut ModuleIndex, module: &Module, candidate: Candidate) -> ()
! OutOfMemoryError
? &mut Allocator {
  let hashed = nameHash(Bytes.asSlice(&candidate.name))
  let prior = Vector<Candidate>.asSlice(&index.candidates)
  let mut position = InternIndex.first(&index.candidateNames, hashed)
  let second = prior.length
  while position != usize.MAX {
    if sameBytes(Bytes.asSlice(&prior[position].name), Bytes.asSlice(&candidate.name)) {
      run Vector<Collision>.append(
        &mut index.collisions,
        Collision {first: position, second: second, span: Module.span(module, candidate.local)},
      )
    }
    position = InternIndex.after(&index.candidateNames, position)
  }
  run Vector<Candidate>.append(&mut index.candidates, move candidate)
  run InternIndex.record(&mut index.candidateNames, hashed)
  return ()
}

// The enclosure key of a declaration: its parent ordinal, or `usize.MAX` at module level. The
// keys are exact, so one enclosure chain lists exactly the declarations it encloses.
fn enclosureOf(declaration: &IndexedDeclaration) -> u64 {
  return match & declaration.parent {
    Option<usize>.Some {value} => usize.toU64(value)
    Option<usize>.None => usize.toU64(usize.MAX)
  }
}

// Appends one declaration and records it under its identity, same-key sibling class, enclosing
// declaration and local node.
effect fn appendDeclaration(index: &mut ModuleIndex, declaration: IndexedDeclaration) -> ()
! OutOfMemoryError
? &mut Allocator {
  let identity = DeclarationId.hash(&declaration.identity)
  let sibling = DeclarationId.siblingHash(&declaration.identity)
  let enclosure = enclosureOf(&declaration)
  let local = usize.toU64(declaration.local.index)
  run Vector<IndexedDeclaration>.append(&mut index.declarations, move declaration)
  run InternIndex.record(&mut index.identities, identity)
  run InternIndex.record(&mut index.siblings, sibling)
  run InternIndex.record(&mut index.enclosures, enclosure)
  run InternIndex.record(&mut index.locals, local)
  return ()
}

effect fn indexImport(index: &mut ModuleIndex, module: &Module, declaration: usize, header: HirId) -> ()
! OutOfMemoryError
? &mut Allocator {
  if let Node.ImportHeader {isPublic, path, alias, members} = Module.node(module, header) {
    if members.present {
      let mut ordinal = usize.ZERO
      while ordinal < members.range.length {
        let memberId = Module.child(module, members.range, ordinal)
        if let Node.ImportMember {name, alias: memberAlias} = Module.node(module, memberId) {
          let mut written = name
          if memberAlias.present {
            written = memberAlias.id
          }
          let found = run copyName(module, written)
          if let Option<Bytes>.Some {value} = move found {
            run appendCandidate(
              &mut index.*,
              module,
              Candidate {
                name: move value,
                declaration: declaration,
                kind: CandidateKind.ImportMember,
                ordinal: ordinal,
                local: written,
                isPublic: isPublic,
              },
            )
          }
        }
        ordinal = ordinal + usize.ONE
      }
      if !alias.present {
        return ()
      }
    }
    let mut written = path
    if alias.present {
      written = alias.id
    } else {
      if let Node.Path {segments} = Module.node(module, path) {
        if segments.length > usize.ZERO {
          written = Module.child(module, segments, segments.length - usize.ONE)
        }
      }
    }
    let found = run copyName(module, written)
    if let Option<Bytes>.Some {value} = move found {
      run appendCandidate(
        &mut index.*,
        module,
        Candidate {
          name: move value,
          declaration: declaration,
          kind: CandidateKind.ImportModule,
          ordinal: usize.ZERO,
          local: written,
          isPublic: false,
        },
      )
    }
  }
  return ()
}

effect fn visit(
  index: &mut ModuleIndex,
  unit: &SourceUnit,
  id: HirId,
  parent: Option<DeclarationId>,
  enclosing: Option<usize>,
  arm: Option<Arm>,
  topLevel: bool,
) -> () ! OutOfMemoryError ? &mut Allocator {
  let module = &unit.authored
  if let Node.Declaration {owner, header, body, ..} = Module.node(module, id) {
    let identity = match move parent {
      Option<DeclarationId>.Some {value} => run DeclarationId.child(&value, module, owner)
      Option<DeclarationId>.None => run DeclarationId.root(&unit.id, module, owner)
    }
    let existing = Vector<IndexedDeclaration>.asSlice(&index.declarations)
    let mut previous = Vector<usize>.make()
    let mut offset = InternIndex.first(&index.siblings, DeclarationId.siblingHash(&identity))
    while offset != usize.MAX {
      if DeclarationId.sameSiblingKey(&existing[offset].identity, &identity) {
        run Vector<usize>.append(&mut previous, offset)
      }
      offset = InternIndex.after(&index.siblings, offset)
    }
    let current = existing.length
    // A conditional or one of its arms is transparent: members keep the enclosing scope.
    let transparent = owner.kind == OwnerKind.Conditional
    let mut inner = Option<usize>.some(current)
    if transparent {
      inner = copyIndex(&enclosing)
    }
    run appendDeclaration(
      &mut index.*,
      IndexedDeclaration {
        identity: DeclarationId.copy(&identity),
        local: id,
        header: header,
        ambiguous: Vector<usize>.length(&previous) > usize.ZERO,
        parent: move enclosing,
        arm: copyArm(&arm),
        fingerprints: Option<Fingerprints>.none(),
      },
    )
    let marked = Vector<usize>.asSlice(&previous)
    offset = usize.ZERO
    while offset < marked.length {
      let entries = Vector<IndexedDeclaration>.asMutSlice(&mut index.declarations)
      entries[marked[offset]].ambiguous = true
      offset = offset + usize.ONE
    }
    if topLevel {
      if owner.kind == OwnerKind.Import {
        run indexImport(&mut index.*, module, current, header)
      } else {
        if namedDeclaration(owner.kind) && owner.name.present {
          let name = run Bytes.copy(Module.text(module, owner.name.symbol))
          let written = headerName(Module.node(module, header))
          let mut local = id
          if written.present {
            local = written.id
          }
          run appendCandidate(
            &mut index.*,
            module,
            Candidate {
              name: move name,
              declaration: current,
              kind: CandidateKind.Declaration,
              ordinal: usize.ZERO,
              local: local,
              isPublic: publicHeader(Module.node(module, header)),
            },
          )
        }
      }
    }
    let mut literals = LiteralScope.make()
    run visitBody(&mut index.*, unit, body, &identity, current, &mut literals)
    if let Node.MembersBody {members} = Module.node(module, body) {
      let mut child = usize.ZERO
      while child < members.length {
        run visit(
          &mut index.*,
          unit,
          Module.child(module, members, child),
          Option<DeclarationId>.some(DeclarationId.copy(&identity)),
          copyIndex(&inner),
          copyArm(&arm),
          topLevel && transparent,
        )
        child = child + usize.ONE
      }
    }
    if let Node.ConditionalBody {thenBranch, elseBranch} = Module.node(module, body) {
      run visit(
        &mut index.*,
        unit,
        thenBranch,
        Option<DeclarationId>.some(DeclarationId.copy(&identity)),
        copyIndex(&inner),
        Option<Arm>.some(Arm {conditional: current, holds: true}),
        topLevel,
      )
      if elseBranch.present {
        run visit(
          &mut index.*,
          unit,
          elseBranch.id,
          Option<DeclarationId>.some(DeclarationId.copy(&identity)),
          copyIndex(&inner),
          Option<Arm>.some(Arm {conditional: current, holds: false}),
          topLevel,
        )
      }
    }
  }
  return ()
}

// Counts are per abstract owner, never per selected branch or arena position.
struct LiteralScope {
  anonymous: usize
  effects: usize
}

impl LiteralScope {
  fn make() -> LiteralScope {
    return LiteralScope {anonymous: usize.ZERO, effects: usize.ZERO}
  }
}

effect fn visitBodyRange(
  index: &mut ModuleIndex, unit: &SourceUnit, range: Range,
  parent: &DeclarationId, enclosing: usize, scope: &mut LiteralScope,
) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < range.length {
    run visitBody(&mut index.*, unit, Module.child(&unit.authored, range, at), parent, enclosing, &mut scope.*)
    at = at + usize.ONE
  }
  return ()
}

effect fn visitBodyRef(
  index: &mut ModuleIndex, unit: &SourceUnit, child: HirRef,
  parent: &DeclarationId, enclosing: usize, scope: &mut LiteralScope,
) -> () ! OutOfMemoryError ? &mut Allocator {
  if child.present {
    run visitBody(&mut index.*, unit, child.id, parent, enclosing, &mut scope.*)
  }
  return ()
}

effect fn visitLiteral(
  index: &mut ModuleIndex, unit: &SourceUnit, local: HirId, header: HirId, body: HirId,
  kind: OwnerKind, parent: &DeclarationId, enclosing: usize, scope: &mut LiteralScope,
) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut occurrence = scope.anonymous
  if kind == OwnerKind.EffectBlock {
    occurrence = scope.effects
    scope.effects = scope.effects + usize.ONE
  } else {
    scope.anonymous = scope.anonymous + usize.ONE
  }
  let identity = run DeclarationId.child(parent, &unit.authored, OwnerKey {
    kind: kind, name: SymbolRef.absent(), occurrence: occurrence,
  })
  let current = Vector<IndexedDeclaration>.length(&index.declarations)
  let existing = Vector<IndexedDeclaration>.asSlice(&index.declarations)
  let arm = copyArm(&existing[enclosing].arm)
  run appendDeclaration(&mut index.*, IndexedDeclaration {
    identity: DeclarationId.copy(&identity), local: local, header: header,
    ambiguous: false, parent: Option<usize>.some(enclosing), arm: move arm,
    fingerprints: Option<Fingerprints>.none(),
  })
  let mut nested = LiteralScope.make()
  run visitBody(&mut index.*, unit, body, &identity, current, &mut nested)
  return ()
}

// Walk executable HIR in written preorder. Bindings refer back to nodes but are not children.
// Both static arms are visited without selecting or typing either one.
effect fn visitBody(
  index: &mut ModuleIndex, unit: &SourceUnit, id: HirId,
  parent: &DeclarationId, enclosing: usize, scope: &mut LiteralScope,
) -> () ! OutOfMemoryError ? &mut Allocator {
  match Module.node(&unit.authored, id) {
    Node.CallableExpression {contract, body} => {
      let mut kind = OwnerKind.Anonymous
      if let Node.CallableContract {isEffect, ..} = Module.node(&unit.authored, contract) {
        if isEffect { kind = OwnerKind.EffectBlock }
      }
      run visitLiteral(&mut index.*, unit, id, contract, body, kind, parent, enclosing, &mut scope.*)
    }
    Node.EffectExpression {body} => {
      run visitLiteral(&mut index.*, unit, id, id, body, OwnerKind.EffectBlock, parent, enclosing, &mut scope.*)
    }
    Node.CallableBody {block} => {
      run visitBodyRef(&mut index.*, unit, block, parent, enclosing, &mut scope.*)
    }
    Node.InitializerBody {value} => {
      run visitBodyRef(&mut index.*, unit, value, parent, enclosing, &mut scope.*)
    }
    Node.PackageParameterBody {default, validation} => {
      run visitBodyRef(&mut index.*, unit, default, parent, enclosing, &mut scope.*)
      run visitBodyRef(&mut index.*, unit, validation, parent, enclosing, &mut scope.*)
    }
    Node.MoveExpression {operand, ..} => {
      run visitBody(&mut index.*, unit, operand, parent, enclosing, &mut scope.*)
    }
    Node.BorrowExpression {operand, ..} => {
      run visitBody(&mut index.*, unit, operand, parent, enclosing, &mut scope.*)
    }
    Node.RunExpression {operand, ..} => {
      run visitBody(&mut index.*, unit, operand, parent, enclosing, &mut scope.*)
    }
    Node.UnsafeExpression {operand, ..} => {
      run visitBody(&mut index.*, unit, operand, parent, enclosing, &mut scope.*)
    }
    Node.CompileErrorExpression {message, ..} => {
      run visitBody(&mut index.*, unit, message, parent, enclosing, &mut scope.*)
    }
    Node.ReferentExpression {subject, ..} => {
      run visitBody(&mut index.*, unit, subject, parent, enclosing, &mut scope.*)
    }
    Node.ExpressionStatement {expression, ..} => {
      run visitBody(&mut index.*, unit, expression, parent, enclosing, &mut scope.*)
    }
    Node.BindingStatement {initializer, ..} => {
      run visitBody(&mut index.*, unit, initializer, parent, enclosing, &mut scope.*)
    }
    Node.PatternBindingStatement {initializer, ..} => {
      run visitBody(&mut index.*, unit, initializer, parent, enclosing, &mut scope.*)
    }
    Node.FailStatement {value, ..} => {
      run visitBody(&mut index.*, unit, value, parent, enclosing, &mut scope.*)
    }
    Node.DropStatement {value, ..} => {
      run visitBody(&mut index.*, unit, value, parent, enclosing, &mut scope.*)
    }
    Node.UnsafeStatement {body, ..} => {
      run visitBody(&mut index.*, unit, body, parent, enclosing, &mut scope.*)
    }
    Node.FieldInitializer {value, ..} => {
      run visitBody(&mut index.*, unit, value, parent, enclosing, &mut scope.*)
    }
    Node.PrefixExpression {operand, ..} => {
      run visitBody(&mut index.*, unit, operand, parent, enclosing, &mut scope.*)
    }
    Node.AssignmentStatement {target, value, ..} => {
      run visitBody(&mut index.*, unit, target, parent, enclosing, &mut scope.*)
      run visitBody(&mut index.*, unit, value, parent, enclosing, &mut scope.*)
    }
    Node.InfixExpression {left, right, ..} => {
      run visitBody(&mut index.*, unit, left, parent, enclosing, &mut scope.*)
      run visitBody(&mut index.*, unit, right, parent, enclosing, &mut scope.*)
    }
    Node.PipelineExpression {input, target, ..} => {
      run visitBody(&mut index.*, unit, input, parent, enclosing, &mut scope.*)
      run visitBody(&mut index.*, unit, target, parent, enclosing, &mut scope.*)
    }
    Node.IndexExpression {subject, index: offset, ..} => {
      run visitBody(&mut index.*, unit, subject, parent, enclosing, &mut scope.*)
      run visitBody(&mut index.*, unit, offset, parent, enclosing, &mut scope.*)
    }
    Node.WhileStatement {condition, body, ..} => {
      run visitBody(&mut index.*, unit, condition, parent, enclosing, &mut scope.*)
      run visitBody(&mut index.*, unit, body, parent, enclosing, &mut scope.*)
    }
    Node.StaticForStatement {iterable, body, ..} => {
      run visitBody(&mut index.*, unit, iterable, parent, enclosing, &mut scope.*)
      run visitBody(&mut index.*, unit, body, parent, enclosing, &mut scope.*)
    }
    Node.Block {statements, ..} => {
      run visitBodyRange(&mut index.*, unit, statements, parent, enclosing, &mut scope.*)
    }
    Node.TupleExpression {elements, ..} => {
      run visitBodyRange(&mut index.*, unit, elements, parent, enclosing, &mut scope.*)
    }
    Node.ArrayExpression {elements, ..} => {
      run visitBodyRange(&mut index.*, unit, elements, parent, enclosing, &mut scope.*)
    }
    Node.StructExpression {fields, ..} => {
      run visitBodyRange(&mut index.*, unit, fields, parent, enclosing, &mut scope.*)
    }
    Node.RecordExpression {fields, ..} => {
      run visitBodyRange(&mut index.*, unit, fields, parent, enclosing, &mut scope.*)
    }
    Node.InvalidExpression {retained, ..} => {
      run visitBodyRange(&mut index.*, unit, retained, parent, enclosing, &mut scope.*)
    }
    Node.InvalidStatement {retained, ..} => {
      run visitBodyRange(&mut index.*, unit, retained, parent, enclosing, &mut scope.*)
    }
    Node.ConditionalStatement {condition, thenBranch, elseBranch, ..} => {
      run visitBody(&mut index.*, unit, condition, parent, enclosing, &mut scope.*)
      run visitBody(&mut index.*, unit, thenBranch, parent, enclosing, &mut scope.*)
      run visitBodyRef(&mut index.*, unit, elseBranch, parent, enclosing, &mut scope.*)
    }
    Node.StaticConditionalStatement {condition, thenBranch, elseBranch, ..} => {
      run visitBody(&mut index.*, unit, condition, parent, enclosing, &mut scope.*)
      run visitBody(&mut index.*, unit, thenBranch, parent, enclosing, &mut scope.*)
      run visitBodyRef(&mut index.*, unit, elseBranch, parent, enclosing, &mut scope.*)
    }
    Node.PatternConditionalStatement {subject, thenBranch, elseBranch, ..} => {
      run visitBody(&mut index.*, unit, subject, parent, enclosing, &mut scope.*)
      run visitBody(&mut index.*, unit, thenBranch, parent, enclosing, &mut scope.*)
      run visitBodyRef(&mut index.*, unit, elseBranch, parent, enclosing, &mut scope.*)
    }
    Node.ReturnStatement {value} => {
      run visitBodyRef(&mut index.*, unit, value, parent, enclosing, &mut scope.*)
    }
    Node.MatchExpression {subject, arms, ..} => {
      run visitBody(&mut index.*, unit, subject, parent, enclosing, &mut scope.*)
      run visitBodyRange(&mut index.*, unit, arms, parent, enclosing, &mut scope.*)
    }
    Node.MatchArm {guard, result, ..} => {
      run visitBodyRef(&mut index.*, unit, guard, parent, enclosing, &mut scope.*)
      run visitBody(&mut index.*, unit, result, parent, enclosing, &mut scope.*)
    }
    Node.CallExpression {callee, arguments, ..} => {
      run visitBody(&mut index.*, unit, callee, parent, enclosing, &mut scope.*)
      run visitBodyRange(&mut index.*, unit, arguments, parent, enclosing, &mut scope.*)
    }
    Node.MemberExpression {fields, ..} => {
      if fields.present {
        run visitBodyRange(&mut index.*, unit, fields.range, parent, enclosing, &mut scope.*)
      }
    }
    Node.FieldExpression {subject, ..} => {
      run visitBody(&mut index.*, unit, subject, parent, enclosing, &mut scope.*)
    }
    Node.OrdinalExpression {subject, ..} => {
      run visitBody(&mut index.*, unit, subject, parent, enclosing, &mut scope.*)
    }
    _ => ()
  }
  return ()
}

fn ambiguousChain(index: &ModuleIndex, identity: &DeclarationId) -> bool {
  let declarations = Vector<IndexedDeclaration>.asSlice(&index.declarations)
  let mut ordinal = usize.ZERO
  while ordinal < declarations.length {
    if declarations[ordinal].ambiguous && DeclarationId.isPrefixOf(
      &declarations[ordinal].identity,
      identity,
    ) {
      return true
    }
    ordinal = ordinal + usize.ONE
  }
  return false
}

effect fn cacheBuckets(index: &mut ModuleIndex) -> () ! OutOfMemoryError ? &mut Allocator {
  let count = Vector<Candidate>.length(&index.candidates)
  let mut ordinal = usize.ZERO
  while ordinal < count {
    let candidates = Vector<Candidate>.asSlice(&index.candidates)
    let name = run Bytes.copy(Bytes.asSlice(&candidates[ordinal].name))
    let known = ModuleIndex.cachedName(&index.*, Bytes.asSlice(&name))
    if let Option<Shared<NameObservation>>.Some {value} = move known {
      drop value
    } else {
      let observed = run ModuleIndex.observeName(&index.*, Bytes.asSlice(&name))
      let hashed = nameHash(Bytes.asSlice(&name))
      run Vector<Bucket>.append(
        &mut index.buckets,
        Bucket {name: move name, observation: run Shared<NameObservation>.make(move observed)},
      )
      run InternIndex.record(&mut index.bucketNames, hashed)
    }
    ordinal = ordinal + usize.ONE
  }
  return ()
}

impl IndexedDeclaration {
  /// Copies one declaration so a caller can continue after the index loan ends.
  pub effect fn copy(self: &Self) -> IndexedDeclaration ! OutOfMemoryError ? &mut Allocator {
    return IndexedDeclaration {
      identity: DeclarationId.copy(&self.identity),
      local: self.local,
      header: self.header,
      ambiguous: self.ambiguous,
      parent: copyIndex(&self.parent),
      arm: copyArm(&self.arm),
      fingerprints: copyFingerprints(&self.fingerprints),
    }
  }
}

impl ModuleIndex {
  /// Copies function addresses and import declarations from this index's exact source owner.
  /// A different module or source revision refuses instead of interpreting foreign HIR IDs.
  pub effect fn copyFunctionInventory(self: &Self, unit: &SourceUnit) -> Option<FunctionInventory>
  ! OutOfMemoryError ? &mut Allocator {
    if !ModuleId.equals(&self.module, &unit.id) || self.revision != unit.revision {
      return Option<FunctionInventory>.none()
    }
    let mut inventory = FunctionInventory {
      functions: Vector<NamedFunction>.make(), imports: Vector<IndexedDeclaration>.make(),
      excludedAnonymous: usize.ZERO, excludedDamaged: usize.ZERO,
    }
    let declarations = Vector<IndexedDeclaration>.asSlice(&self.declarations)
    let candidates = Vector<Candidate>.asSlice(&self.candidates)
    let hir = &unit.authored
    let mut at = usize.ZERO
    while at < declarations.length {
      let declared = &declarations[at]
      let kind = DeclarationId.kind(&declared.identity)
      if kind == OwnerKind.Anonymous || kind == OwnerKind.EffectBlock {
        inventory.excludedAnonymous = inventory.excludedAnonymous + usize.ONE
      } else if kind == OwnerKind.Damaged {
        inventory.excludedDamaged = inventory.excludedDamaged + usize.ONE
      } else if kind == OwnerKind.Import {
        let mut binding = usize.ZERO
        let mut indexed = false
        while binding < candidates.length {
          if candidates[binding].declaration == at && candidates[binding].kind != CandidateKind.Declaration {
            indexed = true
          }
          binding = binding + usize.ONE
        }
        if indexed { run Vector<IndexedDeclaration>.append(&mut inventory.imports, run IndexedDeclaration.copy(declared)) }
      } else if kind == OwnerKind.Function {
        let mut name = HirRef.absent()
        let mut contract = HirRef.absent()
        match Module.node(hir, declared.header) {
          Node.FunctionHeader {name: child, contract: written, ..} => { name = HirRef.of(child) contract = HirRef.of(written) }
          Node.OperationHeader {name: child, contract: written, ..} => { name = HirRef.of(child) contract = HirRef.of(written) }
          _ => ()
        }
        let mut valid = false
        if name.present {
          if let Node.Name {text} = Module.node(hir, name.id) {
            valid = Module.text(hir, text).length > usize.ZERO
          }
        }
        if valid {
          if let Node.Declaration {body, ..} = Module.node(hir, declared.local) {
            let hasBody = match Module.node(hir, body) { Node.CallableBody {block} => block.present _ => false }
            let mut isStatic = false
            if contract.present {
              if let Node.CallableContract {isStatic: written, ..} = Module.node(hir, contract.id) { isStatic = written }
            }
            run Vector<NamedFunction>.append(&mut inventory.functions, NamedFunction {
              declaration: run IndexedDeclaration.copy(declared), ordinal: at,
              span: Module.span(hir, declared.local), headerSpan: Module.span(hir, declared.header),
              nameSpan: Module.span(hir, name.id), name: name.id, hasBody: hasBody, isStatic: isStatic,
            })
          } else { inventory.excludedDamaged = inventory.excludedDamaged + usize.ONE }
        } else { inventory.excludedDamaged = inventory.excludedDamaged + usize.ONE }
      }
      at = at + usize.ONE
    }
    return Option<FunctionInventory>.some(move inventory)
  }
  /// Reports the source revision this index was built from.
  pub fn sourceRevision(self: &Self) -> usize {
    return self.revision
  }
  /// Logical input bytes hashed for whole and prototype fingerprints. Zero for a one-shot index.
  pub fn fingerprintBytesHashed(self: &Self) -> usize {
    return self.hashedByteCount
  }
  /// Borrows all authored declarations in source order, including damaged and nested entries.
  pub fn listDeclarations(self: &Self) -> &[IndexedDeclaration] {
    return Vector<IndexedDeclaration>.asSlice(&self.declarations)
  }
  /// Classifies a local HIR node by the narrowest verified declaration arena range containing it.
  /// Anonymous callable and Effect literals belong to their enclosing named declaration's whole
  /// input. A module-level or unowned node retains the coarse source dependency. Once ownership
  /// is authenticated, damaged syntax conservatively consumes that owner's whole input. The caller
  /// must supply this index's authenticated HIR; a bare `Module` cannot prove its source owner.
  /// This classifies syntax fields only: source bytes and absolute HIR spans can read outside the
  /// prototype even when the node is a callable header, and need their own dependency evidence.
  pub fn syntaxInput(self: &Self, hir: &Module, id: HirId) -> Option<SyntaxInput> {
    if id.index >= Module.length(hir) { return Option<SyntaxInput>.none() }
    // Declaration nodes close their contiguous HIR ranges in postorder. The first closing
    // declaration after `id` that starts before it is the deepest ordinary owner. Literal
    // expressions are not declaration nodes, so their enclosing ordinary owner wins.
    let starts = Vector<DeclarationStart>.asSlice(&hir.declarationStarts)
    let mut low = usize.ZERO
    let mut high = starts.length
    while low < high {
      let middle = low + (high - low) / 2
      if starts[middle].declaration.index < id.index { low = middle + usize.ONE } else { high = middle }
    }
    let declarations = Vector<IndexedDeclaration>.asSlice(&self.declarations)
    while low < starts.length {
      let start = starts[low]
      if start.first.index <= id.index {
        let found = ModuleIndex.ordinalAtLocal(self, start.declaration)
        let ordinal = match move found {
          Option<usize>.Some {value} => value
          Option<usize>.None => { return Option<SyntaxInput>.none() }
        }
        if ordinal >= declarations.length || start.declaration.index >= Module.length(hir) {
          return Option<SyntaxInput>.none()
        }
        let declared = &declarations[ordinal]
        if declared.local.index != start.declaration.index { return Option<SyntaxInput>.none() }
        if literalOwner(DeclarationId.kind(&declared.identity)) {
          low = low + usize.ONE
          continue
        }
        let mut body = declared.local
        if let Node.Declaration {header, body: writtenBody, ..} = Module.node(hir, declared.local) {
          if header.index != declared.header.index { return Option<SyntaxInput>.none() }
          body = writtenBody
        } else { return Option<SyntaxInput>.none() }
        if start.first.index > declared.header.index || declared.header.index >= body.index
          || body.index >= declared.local.index { return Option<SyntaxInput>.none() }
        let own = Module.span(hir, declared.local)
        let diagnostics = Vector<Diagnostic>.asSlice(&hir.diagnostics)
        let mut problem = usize.ZERO
        while problem < diagnostics.length {
          if own.start <= diagnostics[problem].span.start
            && diagnostics[problem].span.start <= own.end {
            return Option<SyntaxInput>.some(SyntaxInput {ordinal: ordinal, prototype: false})
          }
          problem = problem + usize.ONE
        }
        if DeclarationId.kind(&declared.identity) == OwnerKind.Damaged
          || Module.causeRange(hir, declared.header).length > usize.ZERO
          || Module.causeRange(hir, id).length > usize.ZERO {
          return Option<SyntaxInput>.some(SyntaxInput {ordinal: ordinal, prototype: false})
        }
        let mut prototype = false
        if id.index <= declared.header.index {
          prototype = match Module.node(hir, declared.header) {
            Node.FunctionHeader {..} => true
            Node.OperationHeader {..} => true
            _ => false
          }
        }
        return Option<SyntaxInput>.some(SyntaxInput {ordinal: ordinal, prototype: prototype})
      }
      low = low + usize.ONE
    }
    return Option<SyntaxInput>.none()
  }
  /// Returns the logical path of every written import in source order, such as
  /// `silk/vector.silk`, so a build can read its modules before semantic analysis.
  ///
  /// # Details
  ///
  /// Imports in every module-level `static if` arm are listed. `Intrinsic` imports and damaged
  /// paths name no source module and are left out.
  pub effect fn importPaths(self: &Self, unit: &SourceUnit) -> Vector<Bytes> ! OutOfMemoryError ? &mut Allocator {
    let hir = &unit.authored
    let declarations = Vector<IndexedDeclaration>.asSlice(&self.declarations)
    let mut paths = Vector<Bytes>.make()
    let mut ordinal = usize.ZERO
    while ordinal < declarations.length {
      if let Node.ImportHeader {path, ..} = Module.node(hir, declarations[ordinal].header) {
        if let Node.Path {segments} = Module.node(hir, path) {
          let mut joined = Bytes.make()
          let mut valid = segments.length > usize.ZERO
          let mut at = usize.ZERO
          while valid && at < segments.length {
            if let Node.Name {text} = Module.node(hir, Module.child(hir, segments, at)) {
              let name = Module.text(hir, text)
              if at == usize.ZERO && sameBytes(name, b"Intrinsic") {
                valid = false
              }
              if at > usize.ZERO {
                run Bytes.append(&mut joined, b"/")
              }
              run Bytes.append(&mut joined, name)
            } else {
              valid = false
            }
            at = at + usize.ONE
          }
          if valid {
            run Bytes.append(&mut joined, b".silk")
            run Vector<Bytes>.append(&mut paths, move joined)
          }
        }
      }
      ordinal = ordinal + usize.ONE
    }
    return move paths
  }
  /// Borrows top-level declaration and import bindings in source order.
  pub fn listCandidates(self: &Self) -> &[Candidate] {
    return Vector<Candidate>.asSlice(&self.candidates)
  }
  /// Returns the first candidate in source order spelled `name`, or `usize.MAX` when none is.
  ///
  /// # Details
  ///
  /// With [`nextCandidateNamed`] this visits exactly the candidates a source-order scan comparing
  /// names would, in the same order, through the name index.
  pub fn firstCandidateNamed(self: &Self, name: &[u8]) -> usize {
    return namedFrom(self, InternIndex.first(&self.candidateNames, nameHash(name)), name)
  }
  /// Returns the next candidate in source order spelled like candidate `after`, or `usize.MAX`.
  pub fn nextCandidateNamed(self: &Self, after: usize) -> usize {
    let listed = Vector<Candidate>.asSlice(&self.candidates)
    return namedFrom(self, InternIndex.after(&self.candidateNames, after), Bytes.asSlice(&listed[after].name))
  }
  /// Borrows every same-name syntax collision found during indexing.
  pub fn listCollisions(self: &Self) -> &[Collision] {
    return Vector<Collision>.asSlice(&self.collisions)
  }
  /// Indexes all declarations and import bindings in a requested unit without semantic queries.
  ///
  /// # Details
  ///
  /// The index retains damaged declarations and complete same-name candidate sets. Import paths
  /// are read as syntax only; this operation never asks a source provider for their targets.
  /// With `fingerprinted`, every named declaration also gets its [`Fingerprints`]; only a store
  /// that a revision may replace compares them (AGENTS.md one-shot rule).
  pub effect fn build(unit: &SourceUnit, fingerprinted: bool) -> ModuleIndex ! OutOfMemoryError ? &mut Allocator {
    let mut index = ModuleIndex {
      module: ModuleId.copy(&unit.id),
      revision: unit.revision,
      hashedByteCount: usize.ZERO,
      declarations: Vector<IndexedDeclaration>.make(),
      candidates: Vector<Candidate>.make(),
      collisions: Vector<Collision>.make(),
      buckets: Vector<Bucket>.make(),
      identities: InternIndex.make(),
      siblings: InternIndex.make(),
      enclosures: InternIndex.make(),
      locals: InternIndex.make(),
      candidateNames: InternIndex.make(),
      bucketNames: InternIndex.make(),
    }
    let module = &unit.authored
    let mut ordinal = usize.ZERO
    while ordinal < module.declarations.length {
      run visit(
        &mut index,
        unit,
        Module.child(module, module.declarations, ordinal),
        Option<DeclarationId>.none(),
        Option<usize>.none(),
        Option<Arm>.none(),
        true,
      )
      ordinal = ordinal + usize.ONE
    }
    run cacheBuckets(&mut index)
    if fingerprinted {
      run fingerprint(&mut index, unit)
    }
    return move index
  }
  /// Clones the complete preindexed bucket for a written name without allocation.
  ///
  /// # Details
  ///
  /// `None` means the requested spelling has no candidates. This can be called while borrowing a
  /// completed source answer through `Shared.with`; no Effect may escape that borrow.
  pub fn cachedName(self: &Self, name: &[u8]) -> Option<Shared<NameObservation>> {
    let buckets = Vector<Bucket>.asSlice(&self.buckets)
    let mut ordinal = InternIndex.first(&self.bucketNames, nameHash(name))
    while ordinal != usize.MAX {
      if sameBytes(Bytes.asSlice(&buckets[ordinal].name), name) {
        return Option<Shared<NameObservation>>.some(
          Shared<NameObservation>.clone(&buckets[ordinal].observation),
        )
      }
      ordinal = InternIndex.after(&self.bucketNames, ordinal)
    }
    return Option<Shared<NameObservation>>.none()
  }
  /// Returns the first declaration directly enclosed by the declaration at `parent`, in source
  /// order, or `usize.MAX` when it encloses none. `parent` `usize.MAX` selects module-level
  /// declarations. Continue with [`nextEnclosed`].
  pub fn firstEnclosed(self: &Self, parent: usize) -> usize {
    return InternIndex.first(&self.enclosures, usize.toU64(parent))
  }
  /// Returns the declaration after `ordinal` in source order with the same enclosing declaration,
  /// or `usize.MAX` after the last.
  pub fn nextEnclosed(self: &Self, ordinal: usize) -> usize {
    return InternIndex.after(&self.enclosures, ordinal)
  }
  /// Returns the ordinal of the first declaration whose local node has this index.
  pub fn ordinalAtLocal(self: &Self, local: HirId) -> Option<usize> {
    let ordinal = InternIndex.first(&self.locals, usize.toU64(local.index))
    if ordinal == usize.MAX {
      return Option<usize>.none()
    }
    return Option<usize>.some(ordinal)
  }
  /// Returns the ordinal of the first authored declaration with exactly this identity.
  pub fn ordinalOf(self: &Self, identity: &DeclarationId) -> Option<usize> {
    let declarations = Vector<IndexedDeclaration>.asSlice(&self.declarations)
    let mut ordinal = InternIndex.first(&self.identities, DeclarationId.hash(identity))
    while ordinal != usize.MAX {
      if DeclarationId.equals(&declarations[ordinal].identity, identity) {
        return Option<usize>.some(ordinal)
      }
      ordinal = InternIndex.after(&self.identities, ordinal)
    }
    return Option<usize>.none()
  }
  /// Records every candidate for one spelling in this index's module, including an empty bucket.
  pub effect fn observeName(self: &Self, name: &[u8]) -> NameObservation
  ! OutOfMemoryError
  ? &mut Allocator {
    let mut members = Vector<ObservedCandidate>.make()
    let candidates = Vector<Candidate>.asSlice(&self.candidates)
    let declarations = Vector<IndexedDeclaration>.asSlice(&self.declarations)
    let mut ordinal = ModuleIndex.firstCandidateNamed(self, name)
    while ordinal != usize.MAX {
      let candidate = &candidates[ordinal]
      run Vector<ObservedCandidate>.append(
        &mut members,
        ObservedCandidate {
          declaration: DeclarationId.copy(&declarations[candidate.declaration].identity),
          kind: candidate.kind,
          ordinal: candidate.ordinal,
          isPublic: candidate.isPublic,
        },
      )
      ordinal = ModuleIndex.nextCandidateNamed(self, ordinal)
    }
    return NameObservation {
      module: ModuleId.copy(&self.module),
      name: run Bytes.copy(name),
      members: move members,
    }
  }
  /// Whether the complete written bucket for `name` is unchanged between two parses, including
  /// an empty bucket. Candidate identity, binding kind, ordinal, visibility, and source order
  /// determine the result; byte positions and unrelated declarations do not.
  pub fn matchesName(self: &Self, right: &ModuleIndex, name: &[u8]) -> bool {
    if !ModuleId.equals(&self.module, &right.module) { return false }
    let firstCandidates = Vector<Candidate>.asSlice(&self.candidates)
    let secondCandidates = Vector<Candidate>.asSlice(&right.candidates)
    let firstDeclarations = Vector<IndexedDeclaration>.asSlice(&self.declarations)
    let secondDeclarations = Vector<IndexedDeclaration>.asSlice(&right.declarations)
    let mut first = ModuleIndex.firstCandidateNamed(self, name)
    let mut second = ModuleIndex.firstCandidateNamed(right, name)
    while first != usize.MAX && second != usize.MAX {
      let left = &firstCandidates[first]
      let other = &secondCandidates[second]
      if left.kind != other.kind || left.ordinal != other.ordinal || left.isPublic != other.isPublic
        || !DeclarationId.equals(
          &firstDeclarations[left.declaration].identity,
          &secondDeclarations[other.declaration].identity,
        ) {
        return false
      }
      first = ModuleIndex.nextCandidateNamed(self, first)
      second = ModuleIndex.nextCandidateNamed(right, second)
    }
    return first == usize.MAX && second == usize.MAX
  }
  /// Whether the declaration identity survives a revision, independently of its body content.
  /// Same-key occurrence identities survive only while every owner's sibling count agrees.
  pub fn matchesIdentity(self: &Self, left: usize, right: &ModuleIndex, other: usize) -> bool {
    let before = Vector<IndexedDeclaration>.asSlice(&self.declarations)
    let after = Vector<IndexedDeclaration>.asSlice(&right.declarations)
    if left >= before.length || other >= after.length
      || !DeclarationId.equals(&before[left].identity, &after[other].identity) {
      return false
    }
    let mut owner = left
    while owner < before.length {
      let identity = &before[owner].identity
      let mut oldCount = usize.ZERO
      let mut newCount = usize.ZERO
      let mut at = usize.ZERO
      while at < before.length {
        if DeclarationId.sameSiblingKey(identity, &before[at].identity) {
          oldCount = oldCount + usize.ONE
        }
        at = at + usize.ONE
      }
      at = usize.ZERO
      while at < after.length {
        if DeclarationId.sameSiblingKey(identity, &after[at].identity) {
          newCount = newCount + usize.ONE
        }
        at = at + usize.ONE
      }
      if oldCount != newCount {
        return false
      }
      owner = match &before[owner].parent {
        Option<usize>.Some { value } => value
        Option<usize>.None => usize.MAX
      }
    }
    return true
  }
  /// Whether the sets of written names and visibility agree. Candidate identities, kinds,
  /// multiplicity, and order belong to `Name`, not `Namespace`.
  pub fn matchesNamespace(self: &Self, right: &ModuleIndex) -> bool {
    if !ModuleId.equals(&self.module, &right.module) { return false }
    let names = Vector<Bucket>.asSlice(&self.buckets)
    if names.length != Vector<Bucket>.length(&right.buckets) { return false }
    let mut at = usize.ZERO
    while at < names.length {
      let name = Bytes.asSlice(&names[at].name)
      if ModuleIndex.namespaceVisibility(self, name) != ModuleIndex.namespaceVisibility(right, name) {
        return false
      }
      at = at + usize.ONE
    }
    return true
  }
  fn namespaceVisibility(self: &Self, name: &[u8]) -> usize {
    let candidates = Vector<Candidate>.asSlice(&self.candidates)
    let mut hidden = false
    let mut exposed = false
    let mut at = ModuleIndex.firstCandidateNamed(self, name)
    while at != usize.MAX {
      if candidates[at].isPublic { exposed = true } else { hidden = true }
      at = ModuleIndex.nextCandidateNamed(self, at)
    }
    let mut flags = usize.ZERO
    if hidden { flags = flags + usize.ONE }
    if exposed { flags = flags + 2 }
    return flags
  }
  /// Whether declaration `left` here and `other` in `right` are one declaration with equal content:
  /// the same unambiguous identity and equal whole fingerprints.
  ///
  /// # Details
  ///
  /// Only indexes built with fingerprints can match. Invalid ordinals and anonymous literals,
  /// which carry no fingerprints, never match.
  pub fn matchesDeclaration(self: &Self, left: usize, right: &ModuleIndex, other: usize) -> bool {
    return matchesFingerprint(self, left, right, other, false)
  }
  /// Whether two declarations have the same unambiguous identity and equal prototypes.
  /// A function body may change without changing its prototype. As with whole-declaration
  /// comparison, absent fingerprints and ambiguous identities never match.
  pub fn matchesPrototype(self: &Self, left: usize, right: &ModuleIndex, other: usize) -> bool {
    return matchesFingerprint(self, left, right, other, true)
  }
  /// Compares the written implementation heads and direct member headers of two authenticated
  /// source captures. A member body or trivia edit compares equal. An uncertain identity or
  /// damaged candidate conservatively changes its inventory. Semantic bucket membership and
  /// static-arm selection remain dependencies of the aggregate provider, not this comparison.
  pub fn implInventoryChanges(self: &Self, before: &SourceUnit, right: &ModuleIndex,
    after: &SourceUnit) -> ImplInventoryChanges {
    if !ModuleId.equals(&self.module, &right.module)
      || !ModuleId.equals(&self.module, &before.id)
      || !ModuleId.equals(&right.module, &after.id)
      || self.revision != before.revision || right.revision != after.revision {
      return ImplInventoryChanges {conformance: true, inherent: true}
    }
    return ImplInventoryChanges {
      conformance: !matchesImplKind(self, before, right, after, true),
      inherent: !matchesImplKind(self, before, right, after, false),
    }
  }
}

fn nextImpl(index: &ModuleIndex, hir: &Module, from: usize, conformance: bool) -> usize {
  let declarations = Vector<IndexedDeclaration>.asSlice(&index.declarations)
  let mut at = from
  while at < declarations.length {
    if declarations[at].header.index < Module.length(hir) {
      let written = Module.node(hir, declarations[at].header)
      if let Node.ImplHeader {target, ..} = written {
        let topLevel = match &declarations[at].parent { Option<usize>.None => true _ => false }
        if topLevel && target.present == conformance { return at }
      }
    }
    at = at + usize.ONE
  }
  return usize.MAX
}

fn sameImplArm(left: &ModuleIndex, first: usize, right: &ModuleIndex, second: usize) -> bool {
  let before = Vector<IndexedDeclaration>.asSlice(&left.declarations)
  let after = Vector<IndexedDeclaration>.asSlice(&right.declarations)
  let mut oldArm = copyArm(&before[first].arm)
  let mut newArm = copyArm(&after[second].arm)
  while true {
    match move oldArm {
      Option<Arm>.None => {
        if let Option<Arm>.Some {..} = move newArm { return false }
        return true
      }
      Option<Arm>.Some {value: old} => {
        let current = match move newArm {
          Option<Arm>.None => { return false }
          Option<Arm>.Some {value} => move value
        }
        if old.holds != current.holds || old.conditional >= before.length
          || current.conditional >= after.length
          || !ModuleIndex.matchesIdentity(left, old.conditional, right, current.conditional) {
          return false
        }
        oldArm = copyArm(&before[old.conditional].arm)
        newArm = copyArm(&after[current.conditional].arm)
      }
    }
  }
  return false
}

fn damagedImplPart(index: &ModuleIndex, unit: &SourceUnit, ordinal: usize) -> bool {
  let declarations = Vector<IndexedDeclaration>.asSlice(&index.declarations)
  let declared = &declarations[ordinal]
  if DeclarationId.kind(&declared.identity) == OwnerKind.Damaged
    || Module.causeRange(&unit.authored, declared.header).length > usize.ZERO {
    return true
  }
  let own = Module.span(&unit.authored, declared.local)
  let diagnostics = Vector<Diagnostic>.asSlice(&unit.authored.diagnostics)
  let mut at = usize.ZERO
  while at < diagnostics.length {
    if own.start <= diagnostics[at].span.start && diagnostics[at].span.start <= own.end {
      return true
    }
    at = at + usize.ONE
  }
  return false
}

fn sameImplMembers(left: &ModuleIndex, before: &SourceUnit, first: usize,
  right: &ModuleIndex, after: &SourceUnit, second: usize) -> bool {
  let mut oldMember = ModuleIndex.firstEnclosed(left, first)
  let mut newMember = ModuleIndex.firstEnclosed(right, second)
  while oldMember != usize.MAX && newMember != usize.MAX {
    if damagedImplPart(left, before, oldMember) || damagedImplPart(right, after, newMember)
      || !ModuleIndex.matchesPrototype(left, oldMember, right, newMember) {
      return false
    }
    oldMember = ModuleIndex.nextEnclosed(left, oldMember)
    newMember = ModuleIndex.nextEnclosed(right, newMember)
  }
  return oldMember == usize.MAX && newMember == usize.MAX
}

fn matchesImplKind(left: &ModuleIndex, before: &SourceUnit, right: &ModuleIndex,
  after: &SourceUnit, conformance: bool) -> bool {
  let mut first = nextImpl(left, &before.authored, usize.ZERO, conformance)
  let mut second = nextImpl(right, &after.authored, usize.ZERO, conformance)
  while first != usize.MAX && second != usize.MAX {
    if damagedImplPart(left, before, first) || damagedImplPart(right, after, second)
      || !ModuleIndex.matchesPrototype(left, first, right, second)
      || !sameImplArm(left, first, right, second)
      || !sameImplMembers(left, before, first, right, after, second) {
      return false
    }
    first = nextImpl(left, &before.authored, first + usize.ONE, conformance)
    second = nextImpl(right, &after.authored, second + usize.ONE, conformance)
  }
  return first == usize.MAX && second == usize.MAX
}

fn matchesFingerprint(firstIndex: &ModuleIndex, left: usize, secondIndex: &ModuleIndex, other: usize, prototype: bool) -> bool {
  let leftItems = Vector<IndexedDeclaration>.asSlice(&firstIndex.declarations)
  let rightItems = Vector<IndexedDeclaration>.asSlice(&secondIndex.declarations)
  if left >= leftItems.length || other >= rightItems.length {
    return false
  }
  let first = &leftItems[left]
  let second = &rightItems[other]
  if ambiguousChain(firstIndex, &first.identity) || ambiguousChain(secondIndex, &second.identity) || !DeclarationId.equals(
    &first.identity,
    &second.identity,
  ) {
    return false
  }
  return match &first.fingerprints {
    Option<Fingerprints>.Some {value: mine} => match &second.fingerprints {
      Option<Fingerprints>.Some {value: theirs} => {
        if prototype { return ContentHash.equals(mine.prototype, theirs.prototype) }
        return ContentHash.equals(mine.whole, theirs.whole)
      }
      Option<Fingerprints>.None => false
    }
    Option<Fingerprints>.None => false
  }
}

impl NameObservation {
  /// Creates a complete empty bucket for an unwritten spelling in a known module.
  pub effect fn empty(id: &ModuleId, name: &[u8]) -> NameObservation
  ! OutOfMemoryError
  ? &mut Allocator {
    return NameObservation {
      module: ModuleId.copy(id),
      name: run Bytes.copy(name),
      members: Vector<ObservedCandidate>.make(),
    }
  }
  /// Borrows the canonical module identity whose namespace was observed.
  pub fn moduleId(self: &Self) -> &ModuleId {
    return &self.module
  }
  /// Borrows the exact queried spelling.
  pub fn spelling(self: &Self) -> &[u8] {
    return Bytes.asSlice(&self.name)
  }
  /// Borrows the complete candidate set, including an empty set for absence.
  pub fn listMembers(self: &Self) -> &[ObservedCandidate] {
    return Vector<ObservedCandidate>.asSlice(&self.members)
  }
  /// Reports whether another complete bucket has the same candidates, including empty membership.
  ///
  /// # Details
  ///
  /// The comparison uses canonical declaration identities and import binding ordinals. It never
  /// compares local candidate indexes or HIR symbols from different source units.
  pub fn equals(self: &Self, other: &NameObservation) -> bool {
    if !ModuleId.equals(&self.module, &other.module) || !sameBytes(
      Bytes.asSlice(&self.name),
      Bytes.asSlice(&other.name),
    ) {
      return false
    }
    let left = Vector<ObservedCandidate>.asSlice(&self.members)
    let right = Vector<ObservedCandidate>.asSlice(&other.members)
    if left.length != right.length {
      return false
    }
    let mut index = usize.ZERO
    while index < left.length {
      if left[index].kind != right[index].kind || left[index].ordinal != right[index].ordinal || left[index].isPublic != right[index].isPublic || !DeclarationId.equals(
        &left[index].declaration,
        &right[index].declaration,
      ) {
        return false
      }
      index = index + usize.ONE
    }
    return true
  }
}

fn copyFingerprints(fingerprints: &Option<Fingerprints>) -> Option<Fingerprints> {
  return match &fingerprints.* {
    Option<Fingerprints>.Some {value} => Option<Fingerprints>.some(value)
    Option<Fingerprints>.None => Option<Fingerprints>.none()
  }
}

// Whether `kind` is an anonymous literal, which is analyzed inside its enclosing declaration.
fn literalOwner(kind: OwnerKind) -> bool {
  return kind == OwnerKind.Anonymous || kind == OwnerKind.EffectBlock
}

fn triviaToken(kind: TokenKind) -> bool {
  return match kind {
    TokenKind.Whitespace => true
    TokenKind.LineComment => true
    TokenKind.DocComment => true
    TokenKind.ModuleDocComment => true
    _ => false
  }
}

fn holdsLineFeed(source: &[u8], span: Span) -> bool {
  let mut at = span.start
  while at < span.end && at < source.length {
    if source[at] == 10 {
      return true
    }
    at = at + usize.ONE
  }
  return false
}

// The index of the first token that starts at or after `start`; tokens are in source order.
fn firstTokenAt(tokens: &[Token], start: usize) -> usize {
  let mut low = usize.ZERO
  let mut high = tokens.length
  while low < high {
    let middle = low + (high - low) / 2
    if tokenSpan(tokens[middle]).start < start { low = middle + usize.ONE } else { high = middle }
  }
  return low
}

// Where a declaration's prototype ends: at a function's body block, or with the declaration.
fn prototypeEnd(module: &Module, local: HirId, own: Span) -> usize {
  if let Node.Declaration {body, ..} = Module.node(module, local) {
    if let Node.CallableBody {block} = Module.node(module, body) {
      if block.present {
        return Module.span(module, block.id).start
      }
    }
  }
  return own.end
}

// Frames a length so that adjacent byte strings stay distinct.
fn appendLength(stream: &mut ContentStream, length: usize) -> () {
  let mut remaining = usize.toU64(length)
  let mut at = usize.ZERO
  while at < 4 {
    ContentHash.appendByte(&mut stream.*, u64.toU8(u64.bitAnd(remaining, 255)))
    remaining = u64.shiftRight(remaining, 8)
    at = at + usize.ONE
  }
  return ()
}

// One significant token: whether a line feed precedes it, then its exact text.
fn appendToken(stream: &mut ContentStream, source: &[u8], span: Span, lineFeed: bool) -> () {
  let mut marker: u8 = 0
  if lineFeed {
    marker = 1
  }
  ContentHash.appendByte(&mut stream.*, marker)
  appendLength(&mut stream.*, span.end - span.start)
  let mut at = span.start
  while at < span.end {
    ContentHash.appendByte(&mut stream.*, source[at])
    at = at + usize.ONE
  }
  return ()
}

// A nested declaration in place of its tokens: its canonical identity content.
fn appendIdentity(stream: &mut ContentStream, identity: &DeclarationId) -> () {
  ContentHash.appendByte(&mut stream.*, 2)
  let length = DeclarationId.withContent<usize>(identity, fn(content: &[u8]) -> usize { return content.length })
  appendLength(&mut stream.*, length)
  DeclarationId.withContent<()>(identity, fn(content: &[u8]) -> () {
    ContentHash.append(&mut stream.*, content)
    return ()
  })
  return ()
}

// The spans and ordinals of the declarations directly nested in `ordinal` that have their own
// identity. The index lists a declaration before everything nested in it, in source order.
effect fn nestedOf(index: &ModuleIndex, module: &Module, ordinal: usize, own: Span) -> Vector<usize>
! OutOfMemoryError ? &mut Allocator {
  let declarations = Vector<IndexedDeclaration>.asSlice(&index.declarations)
  let mut nested = Vector<usize>.make()
  let mut covered = own.start
  let mut at = ordinal + usize.ONE
  while at < declarations.length {
    let span = Module.span(module, declarations[at].local)
    if span.start >= own.end {
      break
    }
    if !literalOwner(DeclarationId.kind(&declarations[at].identity)) && span.start >= covered {
      run Vector<usize>.append(&mut nested, at)
      covered = span.end
    }
    at = at + usize.ONE
  }
  return move nested
}

effect fn fingerprintOf(index: &ModuleIndex, unit: &SourceUnit, ordinal: usize) -> ComputedFingerprints
! OutOfMemoryError ? &mut Allocator {
  let module = &unit.authored
  let declarations = Vector<IndexedDeclaration>.asSlice(&index.declarations)
  let own = Module.span(module, declarations[ordinal].local)
  let protoEnd = prototypeEnd(module, declarations[ordinal].local, own)
  let nestedList = run nestedOf(index, module, ordinal, own)
  let nested = Vector<usize>.asSlice(&nestedList)
  let tokens = Vector<Token>.asSlice(&unit.syntax.tokens)
  let source = Bytes.asSlice(&unit.syntax.source)
  let mut whole = ContentHash.stream()
  let mut prototype = ContentHash.stream()
  let mut lineFeed = false
  let mut next = usize.ZERO
  // The nested declaration whose identity was last appended, so each stands in once.
  let mut emitted = usize.MAX
  let mut at = firstTokenAt(tokens, own.start)
  while at < tokens.length {
    let span = tokenSpan(tokens[at])
    if span.start >= own.end {
      break
    }
    at = at + usize.ONE
    if triviaToken(tokenKind(tokens[at - usize.ONE])) {
      lineFeed = lineFeed || holdsLineFeed(source, span)
      continue
    }
    while next < nested.length && Module.span(module, declarations[nested[next]].local).end <= span.start {
      next = next + usize.ONE
    }
    if next < nested.length {
      let inner = Module.span(module, declarations[nested[next]].local)
      if span.start >= inner.start {
        if emitted != next {
          appendIdentity(&mut whole, &declarations[nested[next]].identity)
          if span.start < protoEnd {
            appendIdentity(&mut prototype, &declarations[nested[next]].identity)
          }
          emitted = next
        }
        lineFeed = false
        continue
      }
    }
    appendToken(&mut whole, source, span, lineFeed)
    if span.start < protoEnd {
      appendToken(&mut prototype, source, span, lineFeed)
    }
    lineFeed = false
  }
  let bytesHashed = ContentStream.bytesAppended(&whole) + ContentStream.bytesAppended(&prototype)
  return ComputedFingerprints {
    hashes: Fingerprints {whole: ContentHash.finish(move whole), prototype: ContentHash.finish(move prototype)},
    bytesHashed: bytesHashed,
  }
}

effect fn fingerprint(index: &mut ModuleIndex, unit: &SourceUnit) -> () ! OutOfMemoryError ? &mut Allocator {
  let count = Vector<IndexedDeclaration>.length(&index.declarations)
  let mut ordinal = usize.ZERO
  while ordinal < count {
    let declarations = Vector<IndexedDeclaration>.asSlice(&index.declarations)
    let kind = DeclarationId.kind(&declarations[ordinal].identity)
    if !literalOwner(kind) {
      let computed = run fingerprintOf(&index.*, unit, ordinal)
      index.hashedByteCount = index.hashedByteCount + computed.bytesHashed
      let entries = Vector<IndexedDeclaration>.asMutSlice(&mut index.declarations)
      entries[ordinal].fingerprints = Option<Fingerprints>.some(move computed.hashes)
    }
    ordinal = ordinal + usize.ONE
  }
  return ()
}
