//! Source text of a resolved type, spelled as the bootstrap's diagnostics spell it.
//!
//! # When to use
//! Use [`display`] to fill a diagnostic template hole that names a type. It returns none for a
//! type whose bootstrap spelling native cannot reproduce exactly, so a message is either the
//! bootstrap's text or absent.
//!
//! # Details
//! The supported forms follow the bootstrap's `Type.encode`: primitive names, `()`, a module-level
//! nominal type as `module/path.Name<arguments>`, `string<'static>`, `&'static T`, `&'static mut T`,
//! `&'static [T]`, `Array<T, n>` and natural-alignment raw pointers. A type that carries an inferred
//! or declared lifetime, a parameter, a structural union, an anonymous aggregate, a callable or an
//! Effect is not yet rendered: the bootstrap spells inferred lifetimes with its own numbering and
//! orders union members by its own keys.

import hir.Hir {Access, Multiplicity, OwnerKind}
import semantic.DeclarationId {DeclarationId}
import semantic.Lifetime {Lifetime}
import semantic.ModuleId {ModuleId}
import semantic.Type {Argument, Type}
import silk.allocator {Allocator, OutOfMemoryError}
import silk.bytes {Bytes}
import silk.option {Option}
import silk.shared {Shared}
import silk.usize
import silk.list {List}

/// The bootstrap's spelling of `ty`; none when native cannot reproduce it exactly.
pub effect fn display(ty: &Shared<Type>) -> Option<Bytes> ! OutOfMemoryError ? &mut Allocator {
  let mut output = Bytes.make()
  if !run append(&mut output, ty, false) { return Option<Bytes>.none() }
  return Option<Bytes>.some(move output)
}

/// The spelling of `ty` with a lifetime other than `'static` written as elided (`string`, `&T`), as
/// a signature with elided lifetimes spells it; none when native cannot reproduce it.
pub effect fn displayElided(ty: &Shared<Type>) -> Option<Bytes> ! OutOfMemoryError ? &mut Allocator {
  let mut output = Bytes.make()
  if !run append(&mut output, ty, true) { return Option<Bytes>.none() }
  return Option<Bytes>.some(move output)
}

/// Writes the spellings of two mismatched types into `wanted` and `offered`, where a lifetime
/// other than `'static` is written as elided (`string`, `&T`), as a signature with elided lifetimes
/// spells it. False unless both print and differ, so a mismatch only in which non-static lifetimes
/// is never shown as two equal texts.
pub effect fn mismatch(expected: &Shared<Type>, actual: &Shared<Type>, wanted: &mut Bytes, offered: &mut Bytes) -> bool
! OutOfMemoryError ? &mut Allocator {
  if !run append(&mut wanted.*, expected, true) { return false }
  if !run append(&mut offered.*, actual, true) { return false }
  let left = Bytes.asSlice(&wanted.*)
  let right = Bytes.asSlice(&offered.*)
  if left.length != right.length { return true }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] { return true }
    at = at + usize.ONE
  }
  return false
}

// Appends the spelling of `ty`; false when it has no exactly reproducible spelling. `loose`
// writes a lifetime other than `'static` as elided instead of refusing.
effect fn append(output: &mut Bytes, ty: &Shared<Type>, loose: bool) -> bool ! OutOfMemoryError ? &mut Allocator {
  let copied = run Type.copy(ty)
  return match move copied {
    Type.Primitive {name} => {
      run Bytes.append(&mut output.*, Bytes.asSlice(&name))
      return true
    }
    Type.Unit => {
      run Bytes.append(&mut output.*, b"()")
      return true
    }
    Type.Nominal {declaration, arguments, ..} => run appendNominal(&mut output.*, &declaration, List<Argument>.asSlice(&arguments), loose)
    Type.String {lifetime} => {
      if staticLifetime(&lifetime) {
        run Bytes.append(&mut output.*, b"string<'static>")
        return true
      }
      if !loose { return false }
      run Bytes.append(&mut output.*, b"string")
      return true
    }
    Type.Reference {referent, access, lifetime} => {
      if staticLifetime(&lifetime) {
        run Bytes.append(&mut output.*, b"&'static ")
      } else if loose {
        run Bytes.append(&mut output.*, b"&")
      } else {
        return false
      }
      if access == Access.Mutable { run Bytes.append(&mut output.*, b"mut ") }
      return run append(&mut output.*, &referent, loose)
    }
    Type.Slice {element, access, lifetime} => {
      if staticLifetime(&lifetime) {
        run Bytes.append(&mut output.*, b"&'static ")
      } else if loose {
        run Bytes.append(&mut output.*, b"&")
      } else {
        return false
      }
      if access == Access.Mutable { run Bytes.append(&mut output.*, b"mut ") }
      run Bytes.append(&mut output.*, b"[")
      if !run append(&mut output.*, &element, loose) { return false }
      run Bytes.append(&mut output.*, b"]")
      return true
    }
    Type.Array {element, extent} => {
      run Bytes.append(&mut output.*, b"Array<")
      if !run append(&mut output.*, &element, loose) { return false }
      run Bytes.append(&mut output.*, b", ")
      run Bytes.append(&mut output.*, Bytes.asSlice(&extent))
      run Bytes.append(&mut output.*, b">")
      return true
    }
    Type.Vector {element, lanes} => {
      let mask = Shared<Type>.with<bool>(&element, fn(lane: &Type) -> bool {
        return match &lane.* { Type.Primitive {name} => Bytes.length(&name) == 4 _ => false }
      })
      if mask {
        run Bytes.append(&mut output.*, b"mask<")
      } else {
        run Bytes.append(&mut output.*, b"simd<")
        if !run append(&mut output.*, &element, loose) { return false }
        run Bytes.append(&mut output.*, b", ")
      }
      run Bytes.append(&mut output.*, Bytes.asSlice(&lanes))
      run Bytes.append(&mut output.*, b">")
      return true
    }
    Type.Pointer {pointee, access, nullable, multiplicity, alignment} => {
      // A written alignment is spelled from the bootstrap's own alignment text.
      if let Option<u64>.Some {..} = &alignment { return false }
      if nullable { run Bytes.append(&mut output.*, b"?") }
      if multiplicity == Multiplicity.Many { run Bytes.append(&mut output.*, b"[*]") } else { run Bytes.append(&mut output.*, b"*") }
      if access == Access.Mutable { run Bytes.append(&mut output.*, b"mut ") } else { run Bytes.append(&mut output.*, b"const ") }
      return run append(&mut output.*, &pointee, loose)
    }
    _ => false
  }
}

// Appends `module/path.Name<arguments>` for a module-level nominal declaration.
effect fn appendNominal(output: &mut Bytes, declaration: &DeclarationId, arguments: &[Argument], loose: bool) -> bool
! OutOfMemoryError ? &mut Allocator {
  if DeclarationId.ownerCount(declaration) != usize.ONE { return false }
  if !DeclarationId.ownerNamed(declaration, usize.ZERO) { return false }
  let path = run modulePath(DeclarationId.moduleId(declaration))
  run Bytes.append(&mut output.*, Bytes.asSlice(&path))
  run Bytes.append(&mut output.*, b".")
  let name = run DeclarationId.copySpelling(declaration)
  run Bytes.append(&mut output.*, Bytes.asSlice(&name))
  if arguments.length == usize.ZERO { return true }
  run Bytes.append(&mut output.*, b"<")
  let mut at = usize.ZERO
  while at < arguments.length {
    if at > usize.ZERO { run Bytes.append(&mut output.*, b", ") }
    match &arguments[at] {
      Argument.Type {value} => {
        if !run append(&mut output.*, &value, loose) { return false }
      }
      Argument.Lifetime {value} => {
        if !loose { return false }
        if staticLifetime(&value) {
          run Bytes.append(&mut output.*, b"'static")
        } else {
          run Bytes.append(&mut output.*, b"'_")
        }
      }
      _ => { return false }
    }
    at = at + usize.ONE
  }
  run Bytes.append(&mut output.*, b">")
  return true
}

/// The module's path as the bootstrap spells it in messages: without its `.silk` file extension.
pub effect fn modulePath(module: &ModuleId) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let path = run ModuleId.copyPath(module)
  let written = Bytes.asSlice(&path)
  let mut length = written.length
  if endsWithExtension(written) { length = length - 5 }
  let mut spelled = Bytes.make()
  let mut copied = usize.ZERO
  while copied < length {
    run Bytes.append(&mut spelled, &[written[copied]])
    copied = copied + usize.ONE
  }
  return move spelled
}

fn endsWithExtension(path: &[u8]) -> bool {
  let extension = b".silk"
  if path.length < extension.length { return false }
  let start = path.length - extension.length
  let mut at = usize.ZERO
  while at < extension.length {
    if path[start + at] != extension[at] { return false }
    at = at + usize.ONE
  }
  return true
}

fn staticLifetime(lifetime: &Shared<Lifetime>) -> bool {
  return Shared<Lifetime>.with<bool>(lifetime, fn(value: &Lifetime) -> bool {
    return match &value.* {
      Lifetime.Static => true
      _ => false
    }
  })
}
