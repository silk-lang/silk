//! Source text of a resolved type, spelled as the bootstrap's diagnostics spell it.
//!
//! # When to use
//! Use [`display`] to fill a diagnostic template hole that names a type. It returns none for a
//! type whose bootstrap spelling native cannot reproduce exactly, so a message is either the
//! bootstrap's text or absent.
//!
//! # Details
//! The supported forms follow the bootstrap's `Type.encode`: primitive names, `()`, a module-level
//! nominal type as `module.path.Name<arguments>`, `string<'static>`, `&'static T`, `&'static mut T`,
//! `&'static [T]`, `Array<T, n>` and natural-alignment raw pointers. A type that carries an inferred
//! or declared lifetime, a structural union, a callable or an Effect is not yet rendered: the
//! bootstrap spells inferred lifetimes with its own numbering and orders union members by its own
//! keys. A type parameter prints only through [`mismatchNamed`], which is given its written
//! spelling. An anonymous aggregate, `(i32, bool)` or `.{ a: i32 }`, prints only in a loose message.
//!
//! Every spelling is read from a `viewer` module, the one a message is about. A type declared in
//! another package than the viewer's is led by its package's name, `geo.lib.Square`, since every
//! library's root module is `lib`. Standard-library types keep their `silk.` path.

import hir.Hir {Access, Multiplicity, OwnerKind}
import semantic.DeclarationId {DeclarationId}
import semantic.Lifetime {Lifetime}
import semantic.ModuleId {ModuleId}
import semantic.PackageGraph
import semantic.Type {AnonymousOccurrence, Argument, Type}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.collections.bytes {Bytes}
import silk.core.option {Option}
import silk.mem.shared {Shared}
import silk.collections.slice {Slice}
import silk.num.usize
import silk.collections.list {List}

/// The bootstrap's spelling of `ty`; none when native cannot reproduce it exactly.
pub effect fn display(ty: &Shared<Type>, viewer: &ModuleId) -> Option<Bytes> ! OutOfMemoryError ? &mut Allocator {
  let mut output = Bytes.make()
  let mut names = List<Named>.make()
  if !run append(&mut output, ty, false, &mut names, viewer) { return Option<Bytes>.none() }
  return Option<Bytes>.some(move output)
}

/// The spelling of `ty` with a lifetime other than `'static` written as elided (`string`, `&T`), as
/// a signature with elided lifetimes spells it; none when native cannot reproduce it.
pub effect fn displayElided(ty: &Shared<Type>, viewer: &ModuleId) -> Option<Bytes> ! OutOfMemoryError ? &mut Allocator {
  let mut output = Bytes.make()
  let mut names = List<Named>.make()
  if !run append(&mut output, ty, true, &mut names, viewer) { return Option<Bytes>.none() }
  return Option<Bytes>.some(move output)
}

/// As `displayElided`, spelling a type parameter by its entry in `names`. A parameter without a
/// spelling there is added to `names` with an empty one and the type does not print, so a caller
/// can supply the spellings and try again.
pub effect fn displayNamed(ty: &Shared<Type>, viewer: &ModuleId, names: &mut List<Named>) -> Option<Bytes>
! OutOfMemoryError ? &mut Allocator {
  let mut output = Bytes.make()
  if !run append(&mut output, ty, true, &mut names.*, viewer) { return Option<Bytes>.none() }
  return Option<Bytes>.some(move output)
}

/// Writes the spellings of two mismatched types into `wanted` and `offered`, where a lifetime
/// other than `'static` is written as elided (`string`, `&T`), as a signature with elided lifetimes
/// spells it. False unless both print and differ, so a mismatch only in which non-static lifetimes
/// is never shown as two equal texts.
pub effect fn mismatch(expected: &Shared<Type>, actual: &Shared<Type>, viewer: &ModuleId, wanted: &mut Bytes,
  offered: &mut Bytes) -> bool ! OutOfMemoryError ? &mut Allocator {
  let mut names = List<Named>.make()
  return run mismatchNamed(expected, actual, viewer, &mut names, &mut wanted.*, &mut offered.*)
}

/// As `mismatch`, spelling a type parameter by its entry in `names`. A parameter without a
/// spelling there is added to `names` with an empty one and the types do not print, so a caller
/// can supply the spellings and try again.
pub effect fn mismatchNamed(expected: &Shared<Type>, actual: &Shared<Type>, viewer: &ModuleId, names: &mut List<Named>,
  wanted: &mut Bytes, offered: &mut Bytes) -> bool ! OutOfMemoryError ? &mut Allocator {
  let wantedPrinted = run append(&mut wanted.*, expected, true, &mut names.*, viewer)
  let offeredPrinted = run append(&mut offered.*, actual, true, &mut names.*, viewer)
  if !wantedPrinted || !offeredPrinted { return false }
  let left = Bytes.asSlice(&wanted.*)
  let right = Bytes.asSlice(&offered.*)
  if left.length != right.length { return true }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] { return true }
    at = at + usize.ONE
  }
  return false
}

/// The written spelling of one type parameter, keyed by its declaration and ordinal.
pub struct Named {
  pub declaration: DeclarationId,
  pub ordinal: usize,
  pub spelling: Bytes,
}

// Appends the spelling of `ty`; false when it has no exactly reproducible spelling. `loose`
// writes a lifetime other than `'static` as elided instead of refusing.
effect fn append(output: &mut Bytes, ty: &Shared<Type>, loose: bool, names: &mut List<Named>, viewer: &ModuleId) -> bool
! OutOfMemoryError ? &mut Allocator {
  let copied = run Type.copy(ty)
  return match move copied {
    Type.Primitive {name} => {
      run Bytes.append(&mut output.*, Bytes.asSlice(&name))
      return true
    }
    Type.Parameter {declaration, ordinal} => {
      // A parameter's spelling is not part of its identity; it prints only in a loose message.
      if !loose { return false }
      let listed = List<Named>.asSlice(&names.*)
      let mut at = usize.ZERO
      while at < listed.length {
        if listed[at].ordinal == ordinal && DeclarationId.equals(&listed[at].declaration, &declaration) {
          if Bytes.length(&listed[at].spelling) == usize.ZERO { return false }
          run Bytes.append(&mut output.*, Bytes.asSlice(&listed[at].spelling))
          return true
        }
        at = at + usize.ONE
      }
      run List<Named>.append(&mut names.*, Named {declaration: move declaration, ordinal: ordinal, spelling: Bytes.make()})
      return false
    }
    Type.Unit => {
      run Bytes.append(&mut output.*, b"()")
      return true
    }
    Type.Anonymous {occurrence, members} => {
      // An occurrence is its own type, so its structure only describes it in a loose message.
      if !loose { return false }
      let positional = AnonymousOccurrence.isPositional(&occurrence)
      let listed = List<Shared<Type>>.asSlice(&members)
      if positional {
        run Bytes.append(&mut output.*, b"(")
      } else {
        run Bytes.append(&mut output.*, b".{ ")
      }
      let mut at = usize.ZERO
      while at < listed.length {
        if at > usize.ZERO { run Bytes.append(&mut output.*, b", ") }
        if !positional {
          let label = run anonymousLabel(&occurrence, at)
          run Bytes.append(&mut output.*, Bytes.asSlice(&label))
          run Bytes.append(&mut output.*, b": ")
        }
        if !run append(&mut output.*, &listed[at], loose, &mut names.*, viewer) { return false }
        at = at + usize.ONE
      }
      if positional {
        if listed.length == usize.ONE { run Bytes.append(&mut output.*, b",") }
        run Bytes.append(&mut output.*, b")")
      } else {
        run Bytes.append(&mut output.*, b" }")
      }
      return true
    }
    Type.Nominal {declaration, arguments, ..} => run appendNominal(&mut output.*, &declaration, List<Argument>.asSlice(&arguments), loose, &mut names.*, viewer)
    Type.String {lifetime} => {
      if staticLifetime(&lifetime) {
        run Bytes.append(&mut output.*, b"string<'static>")
        return true
      }
      if !loose { return false }
      run Bytes.append(&mut output.*, b"string")
      return true
    }
    Type.Reference {referent, access, lifetime} => {
      if staticLifetime(&lifetime) {
        run Bytes.append(&mut output.*, b"&'static ")
      } else if loose {
        run Bytes.append(&mut output.*, b"&")
      } else {
        return false
      }
      if access == Access.Mutable { run Bytes.append(&mut output.*, b"mut ") }
      return run append(&mut output.*, &referent, loose, &mut names.*, viewer)
    }
    Type.Slice {element, access, lifetime} => {
      if staticLifetime(&lifetime) {
        run Bytes.append(&mut output.*, b"&'static ")
      } else if loose {
        run Bytes.append(&mut output.*, b"&")
      } else {
        return false
      }
      if access == Access.Mutable { run Bytes.append(&mut output.*, b"mut ") }
      run Bytes.append(&mut output.*, b"[")
      if !run append(&mut output.*, &element, loose, &mut names.*, viewer) { return false }
      run Bytes.append(&mut output.*, b"]")
      return true
    }
    Type.Array {element, extent} => {
      run Bytes.append(&mut output.*, b"Array<")
      if !run append(&mut output.*, &element, loose, &mut names.*, viewer) { return false }
      run Bytes.append(&mut output.*, b", ")
      run Bytes.append(&mut output.*, Bytes.asSlice(&extent))
      run Bytes.append(&mut output.*, b">")
      return true
    }
    Type.Vector {element, lanes} => {
      let mask = Shared<Type>.with<bool>(&element, fn(lane: &Type) -> bool {
        return match &lane.* { Type.Primitive {name} => Bytes.length(&name) == 4 _ => false }
      })
      if mask {
        run Bytes.append(&mut output.*, b"mask<")
      } else {
        run Bytes.append(&mut output.*, b"simd<")
        if !run append(&mut output.*, &element, loose, &mut names.*, viewer) { return false }
        run Bytes.append(&mut output.*, b", ")
      }
      run Bytes.append(&mut output.*, Bytes.asSlice(&lanes))
      run Bytes.append(&mut output.*, b">")
      return true
    }
    Type.Pointer {pointee, access, nullable, multiplicity, alignment} => {
      // A written alignment is spelled from the bootstrap's own alignment text.
      if let Option<u64>.Some {..} = &alignment { return false }
      if nullable { run Bytes.append(&mut output.*, b"?") }
      if multiplicity == Multiplicity.Many { run Bytes.append(&mut output.*, b"[*]") } else { run Bytes.append(&mut output.*, b"*") }
      if access == Access.Mutable { run Bytes.append(&mut output.*, b"mut ") } else { run Bytes.append(&mut output.*, b"const ") }
      return run append(&mut output.*, &pointee, loose, &mut names.*, viewer)
    }
    _ => false
  }
}

// Appends `module.path.Name<arguments>` for a module-level nominal declaration, which may sit
// inside `static if` branches.
effect fn appendNominal(output: &mut Bytes, declaration: &DeclarationId, arguments: &[Argument], loose: bool,
  names: &mut List<Named>, viewer: &ModuleId) -> bool
! OutOfMemoryError ? &mut Allocator {
  let count = DeclarationId.ownerCount(declaration)
  if count == usize.ZERO || !DeclarationId.ownerNamed(declaration, count - usize.ONE) { return false }
  let mut step = usize.ZERO
  while step + usize.ONE < count {
    if DeclarationId.ownerKind(declaration, step) != OwnerKind.Conditional { return false }
    step = step + usize.ONE
  }
  let module = DeclarationId.moduleId(declaration)
  let path = run modulePath(module)
  let name = run DeclarationId.copySpelling(declaration)
  // A compiler-owned operator interface is spelled from the standard module that exports it.
  let mut written = Bytes.asSlice(&path)
  if same(written, b"intrinsic/operators") { written = operatorHome(Bytes.asSlice(&name)) }
  run appendPackage(&mut output.*, module, viewer, written)
  let mut spelled = usize.ZERO
  while spelled < written.length {
    if written[spelled] == '/' { run Bytes.append(&mut output.*, b".") } else { run Bytes.append(&mut output.*, &[written[spelled]]) }
    spelled = spelled + usize.ONE
  }
  run Bytes.append(&mut output.*, b".")
  run Bytes.append(&mut output.*, Bytes.asSlice(&name))
  if arguments.length == usize.ZERO { return true }
  run Bytes.append(&mut output.*, b"<")
  let mut at = usize.ZERO
  while at < arguments.length {
    if at > usize.ZERO { run Bytes.append(&mut output.*, b", ") }
    match &arguments[at] {
      Argument.Type {value} => {
        if !run append(&mut output.*, &value, loose, &mut names.*, viewer) { return false }
      }
      Argument.Lifetime {value} => {
        if !loose { return false }
        if staticLifetime(&value) {
          run Bytes.append(&mut output.*, b"'static")
        } else {
          run Bytes.append(&mut output.*, b"'_")
        }
      }
      _ => { return false }
    }
    at = at + usize.ONE
  }
  run Bytes.append(&mut output.*, b">")
  return true
}

// The standard module that exports the operator interface `name` under its own name. Only spells
// type text; the catalog roles (`StandardRole`) decide where the modules load from, so moving one
// changes the catalog and this spelling together.
fn operatorHome(name: &[u8]) -> &'static [u8] {
  if same(name, b"Equal") { return b"silk/core/equal" }
  if same(name, b"Order") || same(name, b"Ordering") { return b"silk/core/order" }
  return b"silk/core/ops"
}

// Appends `geo.` for a module of package `geo@0.1.0` that `viewer` sees from another package of the
// same origin. A standard-library module belongs to every package and is spelled by its path alone.
effect fn appendPackage(output: &mut Bytes, module: &ModuleId, viewer: &ModuleId, path: &[u8]) -> ()
! OutOfMemoryError ? &mut Allocator {
  if ModuleId.samePackage(module, viewer) || !ModuleId.sameOrigin(module, viewer) || PackageGraph.isStandard(path) { return () }
  let package = run ModuleId.copyPackage(module)
  let identity = Bytes.asSlice(&package)
  let mut end = usize.ZERO
  while end < identity.length && identity[end] != '@' { end = end + usize.ONE }
  if end == usize.ZERO { return () }
  run Bytes.append(&mut output.*, Slice.view<u8>(identity, usize.ZERO, end))
  return run Bytes.append(&mut output.*, b".")
}

/// The module's path as the bootstrap spells it in messages: without its `.silk` file extension.
pub effect fn modulePath(module: &ModuleId) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let path = run ModuleId.copyPath(module)
  let written = Bytes.asSlice(&path)
  let mut length = written.length
  if endsWithExtension(written) { length = length - 5 }
  let mut spelled = Bytes.make()
  let mut copied = usize.ZERO
  while copied < length {
    run Bytes.append(&mut spelled, &[written[copied]])
    copied = copied + usize.ONE
  }
  return move spelled
}

/// `importPath` as `viewer` imports it: led by the package name, `geo.lib`, for a module of
/// another package.
pub effect fn importPathFrom(module: &ModuleId, viewer: &ModuleId) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let path = run modulePath(module)
  let mut text = Bytes.make()
  run appendPackage(&mut text, module, viewer, Bytes.asSlice(&path))
  run Bytes.append(&mut text, Bytes.asSlice(&run importPath(module)))
  return move text
}

/// The module's path as an `import` spells it, `silk.compress.inflate` for `silk/compress/inflate.silk`. A
/// directory's barrel file `util/mod.silk` is spelled by its directory's path, `util`.
pub effect fn importPath(module: &ModuleId) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let path = run modulePath(module)
  let written = Bytes.asSlice(&path)
  let mut length = written.length
  let barrel = b"/mod"
  if length > barrel.length && sameTail(written, barrel) { length = length - barrel.length }
  let mut dotted = Bytes.make()
  let mut at = usize.ZERO
  while at < length {
    if written[at] == 47 { run Bytes.append(&mut dotted, b".") } else { run Bytes.append(&mut dotted, &[written[at]]) }
    at = at + usize.ONE
  }
  return move dotted
}

fn sameTail(path: &[u8], tail: &[u8]) -> bool {
  let start = path.length - tail.length
  let mut at = usize.ZERO
  while at < tail.length {
    if path[start + at] != tail[at] { return false }
    at = at + usize.ONE
  }
  return true
}

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] { return false }
    at = at + usize.ONE
  }
  return true
}

fn endsWithExtension(path: &[u8]) -> bool {
  let extension = b".silk"
  if path.length < extension.length { return false }
  let start = path.length - extension.length
  let mut at = usize.ZERO
  while at < extension.length {
    if path[start + at] != extension[at] { return false }
    at = at + usize.ONE
  }
  return true
}

// The label of an anonymous record's field `ordinal`.
effect fn anonymousLabel(occurrence: &Shared<AnonymousOccurrence>, ordinal: usize) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let length = Shared<AnonymousOccurrence>.with<usize>(occurrence, fn(found: &AnonymousOccurrence) -> usize {
    let labels = List<Bytes>.asSlice(&found.labels)
    if ordinal < labels.length { return Bytes.length(&labels[ordinal]) }
    return usize.ZERO
  })
  let mut label = run Bytes.zeroed(length)
  let filled = Shared<AnonymousOccurrence>.with<bool>(occurrence, fn(found: &AnonymousOccurrence) -> bool {
    let labels = List<Bytes>.asSlice(&found.labels)
    if ordinal >= labels.length { return false }
    let source = Bytes.asSlice(&labels[ordinal])
    let target = Bytes.asMutSlice(&mut label)
    let mut at = usize.ZERO
    while at < source.length {
      target[at] = source[at]
      at = at + usize.ONE
    }
    return true
  })
  drop filled
  return move label
}

fn staticLifetime(lifetime: &Shared<Lifetime>) -> bool {
  return Shared<Lifetime>.with<bool>(lifetime, fn(value: &Lifetime) -> bool {
    return match &value.* {
      Lifetime.Static => true
      _ => false
    }
  })
}
