//! Immutable command configuration for independently constructed semantic worker stores.
//! The source epoch, target, final profile, application and type pool belong to the registry.
//! This value contains only owned configuration; query answers, local ordinals, request roots,
//! progress reporters and transient evaluator budgets never cross the thread boundary.
import semantic.FiniteBudget {Limits}
import semantic.PackageGraph {PackageGraph}
import semantic.ExecutionStorage {ExecutionStorage}
import semantic.Retention {Root as RetentionRoot}
import semantic.ModuleId {ModuleId}
import silk.collections.bytes {Bytes}
import silk.collections.list {List}
import silk.core.option {Option}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.num.usize

/// A selected target support module and whether its C exports are also host exports.
pub struct Support {pub module: ModuleId, pub hosted: bool}
/// The completed discovery configuration used by test intrinsics.
pub struct Discovery {
  pub root: ModuleId,
  pub directory: Bytes,
  pub exports: List<ModuleId>,
}
/// Final configuration captured before a worker makes its first query. Keep this immutable
/// while it supplies a registry; workers copy fields into their own stores before demanding.
pub struct Setup {
  pub packages: PackageGraph,
  pub storage: Option<ExecutionStorage>,
  pub retention: List<RetentionRoot>,
  pub support: List<Support>,
  pub discovery: Option<Discovery>,
  pub claimFree: List<ModuleId>,
  pub schemaModules: List<ModuleId>,
  pub verifyMir: bool,
  pub codegenUnits: bool,
  pub fastPathIr: bool,
  pub direct: bool,
  pub threads: bool,
  pub lineTables: bool,
  pub limits: Limits,
}

pub effect fn copyModules(modules: &[ModuleId]) -> List<ModuleId> ! OutOfMemoryError ? &mut Allocator {
  let mut copied = run List<ModuleId>.makeWithCapacity(modules.length)
  let mut at = usize.ZERO
  while at < modules.length {
    run List<ModuleId>.append(&mut copied, ModuleId.copy(&modules[at]))
    at = at + usize.ONE
  }
  return move copied
}
impl Support {
  pub fn copy(self: &Self) -> Self { return Self {module: ModuleId.copy(&self.module), hosted: self.hosted} }
}
impl Discovery {
  pub effect fn copy(self: &Self) -> Self ! OutOfMemoryError ? &mut Allocator {
    return Self {root: ModuleId.copy(&self.root), directory: run Bytes.copy(Bytes.asSlice(&self.directory)),
      exports: run copyModules(List<ModuleId>.asSlice(&self.exports))}
  }
}
impl Setup {
  pub fn make() -> Self {
    return Self {packages: PackageGraph.single(), storage: Option<ExecutionStorage>.none(),
      retention: List<RetentionRoot>.make(), support: List<Support>.make(), discovery: Option<Discovery>.none(),
      claimFree: List<ModuleId>.make(), schemaModules: List<ModuleId>.make(), verifyMir: false,
      codegenUnits: false, fastPathIr: false, direct: false, threads: false, lineTables: false, limits: Limits.make()}
  }
  /// Copies owned mutable containers while retaining only intrinsically immutable module IDs.
  /// Build this before worker queries; a failure cannot partially reconfigure a live store.
  pub effect fn copy(self: &Self) -> Self ! OutOfMemoryError ? &mut Allocator {
    let packages = run PackageGraph.copy(&self.packages)
    let storage = match &self.storage {
      Option<ExecutionStorage>.Some {value} => Option<ExecutionStorage>.some(run ExecutionStorage.copy(&value))
      _ => Option<ExecutionStorage>.none()
    }
    let roots = List<RetentionRoot>.asSlice(&self.retention)
    let mut retention = run List<RetentionRoot>.makeWithCapacity(roots.length)
    let mut at = usize.ZERO
    while at < roots.length {
      run List<RetentionRoot>.append(&mut retention, run RetentionRoot.copy(&roots[at]))
      at = at + usize.ONE
    }
    let supports = List<Support>.asSlice(&self.support)
    let mut support = run List<Support>.makeWithCapacity(supports.length)
    at = usize.ZERO
    while at < supports.length {
      run List<Support>.append(&mut support, Support.copy(&supports[at]))
      at = at + usize.ONE
    }
    let discovery = match &self.discovery {
      Option<Discovery>.Some {value} => Option<Discovery>.some(run Discovery.copy(&value))
      _ => Option<Discovery>.none()
    }
    return Self {packages: move packages, storage: move storage, retention: move retention,
      support: move support, discovery: move discovery,
      claimFree: run copyModules(List<ModuleId>.asSlice(&self.claimFree)),
      schemaModules: run copyModules(List<ModuleId>.asSlice(&self.schemaModules)), verifyMir: self.verifyMir,
      codegenUnits: self.codegenUnits, fastPathIr: self.fastPathIr, direct: self.direct, threads: self.threads,
      lineTables: self.lineTables, limits: self.limits}
  }
}
