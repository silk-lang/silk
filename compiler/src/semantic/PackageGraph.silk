//! Which module an import path names when a build spans several packages.
//!
//! # When to use
//! Use [`PackageGraph.target`] wherever an import path, or a standard-library path the language
//! reads without an import, becomes a module identity. Preloading and import resolution must agree
//! on it, or a build would read one module and resolve another.
//!
//! # Details
//! A package lists its dependencies by name (PACKAGE-002). An import path whose first segment is
//! one of the importing package's dependency names names a module of that dependency: the rest of
//! the path, in the dependency's own package identity. Any other path stays in the importing
//! package. Standard-library paths (`silk/...`) and the sealed operator catalog belong to one
//! package for the whole build (PACKAGE-005), so every package shares the same library modules.
//!
//! A module of another package is importable only when that package's manifest exports it
//! (PACKAGE-006); [`PackageGraph.exported`] answers that for one import.
//!
//! An import path names one of two files (MODULE-007): the module file, such as `util/Shapes.silk`,
//! or the barrel file of the directory of that name, `util/Shapes/mod.silk`.
//! [`PackageGraph.target`] gives the first and [`PackageGraph.barrel`] the second; the sources
//! present decide which one the import names.
//!
//! A few standard-library modules are read by their role rather than through an import, such as the
//! `Layout` record that layout intrinsics exchange. [`PackageGraph.standardPath`] gives the module
//! path of each [`StandardRole`]: the one the library's composition catalog lists, or the canonical
//! path when the build reads no catalog.
//!
//! An empty graph names no dependencies and no standard-library owner, so every path stays in its
//! importer's package: the single-package build that semantic test fixtures assemble.

import semantic.ModuleId {InvalidModulePath, ModuleId}
import semantic.SealedOperators
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.collections.bytes {Bytes}
import silk.option {Option}
import silk.collections.slice {Slice}
import silk.num.usize
import silk.collections.list {List}

// One dependency of one package: the name its imports use and the package identity it selects.
struct Dependency {
  owner: Bytes,
  name: Bytes,
  package: Bytes,
}

// One module that package `package` exports, by its canonical path such as `codec/Json.silk`.
struct Export {
  package: Bytes,
  path: Bytes,
}

/// A standard-library module the language reads by its role rather than through an import.
pub enum StandardRole {
  /// The `Layout` record that layout and allocation intrinsics exchange.
  Layout,
  /// The `Option` union whose `OptionService` stands for it in requirement rows (SERV-011).
  Option,
  /// The operator interfaces, which stay implicit until the alias migration (OP-009).
  Ops,
  /// The `Equal` interface.
  Equal,
  /// The `Order` interface.
  Order,
}

// The module path the library's composition catalog lists for one role.
struct RolePath {
  which: StandardRole,
  path: Bytes,
}

/// The dependency names of every package in one build, the modules each dependency exports, and
/// the owner of its standard library.
pub struct PackageGraph {
  // A module of the package that owns standard-library paths; its origin and package are used.
  standard: Option<ModuleId>,
  dependencies: List<Dependency>,
  exports: List<Export>,
  roles: List<RolePath>,
}

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] { return false }
    at = at + usize.ONE
  }
  return true
}

fn startsWith(bytes: &[u8], prefix: &[u8]) -> bool {
  if bytes.length < prefix.length { return false }
  let mut at = usize.ZERO
  while at < prefix.length {
    if bytes[at] != prefix[at] { return false }
    at = at + usize.ONE
  }
  return true
}

/// Whether `path` is a standard-library module path or the sealed operator catalog, which belong
/// to the build's standard-library owner rather than to the importing package.
pub fn isStandard(path: &[u8]) -> bool {
  return startsWith(path, b"silk/") || SealedOperators.isPath(path)
}

// The length of the first segment of a module path such as `json/Value.silk`, or `usize.MAX` when
// the path has a single segment and so cannot name a module below a dependency.
fn firstSegment(path: &[u8]) -> usize {
  let mut at = usize.ZERO
  while at < path.length {
    if path[at] == 47 { return at }
    at = at + usize.ONE
  }
  return usize.MAX
}

impl PackageGraph {
  /// The barrel file of the directory that `path`, a canonical module path such as
  /// `util/Shapes.silk`, names: `util/Shapes/mod.silk`.
  pub effect fn barrelPath(path: &[u8]) -> Bytes ! OutOfMemoryError ? &mut Allocator {
    let extension = b".silk"
    let mut stem = path.length
    if path.length >= extension.length && same(Slice.view<u8>(path, path.length - extension.length, extension.length), extension) {
      stem = path.length - extension.length
    }
    let mut barrel = run Bytes.copy(Slice.view<u8>(path, usize.ZERO, stem))
    run Bytes.append(&mut barrel, b"/mod.silk")
    return move barrel
  }
  /// Whether `path`, a canonical module path, is a directory's barrel file `mod.silk`, which imports
  /// name by the directory's path alone.
  pub fn isBarrel(path: &[u8]) -> bool {
    let file = b"mod.silk"
    if path.length < file.length || !same(Slice.view<u8>(path, path.length - file.length, file.length), file) { return false }
    return path.length == file.length || path[path.length - file.length - usize.ONE] == 47
  }
  /// A graph with no dependencies, where every path stays in its importer's package.
  pub fn single() -> PackageGraph {
    return PackageGraph {
      standard: Option<ModuleId>.none(), dependencies: List<Dependency>.make(), exports: List<Export>.make(),
      roles: List<RolePath>.make(),
    }
  }
  /// A graph whose standard-library paths belong to the origin and package of `owner`.
  pub fn make(owner: &ModuleId) -> PackageGraph {
    return PackageGraph {
      standard: Option<ModuleId>.some(ModuleId.copy(owner)), dependencies: List<Dependency>.make(),
      exports: List<Export>.make(), roles: List<RolePath>.make(),
    }
  }
  /// A module of the package that owns standard-library paths: the build's root package. None in
  /// a single-package graph.
  pub fn standardOwner(self: &Self) -> Option<ModuleId> {
    return match &self.standard {
      Option<ModuleId>.Some {value} => Option<ModuleId>.some(ModuleId.copy(&value))
      Option<ModuleId>.None => Option<ModuleId>.none()
    }
  }
  /// Records that package `owner` imports package `package` under the dependency name `name`.
  pub effect fn depend(self: &mut Self, owner: &[u8], name: &[u8], package: &[u8]) -> () ! OutOfMemoryError ? &mut Allocator {
    run List<Dependency>.append(&mut self.dependencies, Dependency {
      owner: run Bytes.copy(owner), name: run Bytes.copy(name), package: run Bytes.copy(package),
    })
    return ()
  }
  /// Records that the standard library's module for `which` is at `path`, such as
  /// `silk/mem/layout.silk`, in place of its canonical path.
  pub effect fn assign(self: &mut Self, which: StandardRole, path: &[u8]) -> () ! OutOfMemoryError ? &mut Allocator {
    run List<RolePath>.append(&mut self.roles, RolePath {which: which, path: run Bytes.copy(path)})
    return ()
  }
  /// The standard-library module path of `which`, such as `silk/layout.silk`: the one [`assign`]
  /// recorded, or its canonical path.
  pub fn standardPath(self: &Self, which: StandardRole) -> &[u8] {
    let listed = List<RolePath>.asSlice(&self.roles)
    let mut at = usize.ZERO
    while at < listed.length {
      if listed[at].which == which { return Bytes.asSlice(&listed[at].path) }
      at = at + usize.ONE
    }
    if which == StandardRole.Layout { return b"silk/layout.silk" }
    if which == StandardRole.Option { return b"silk/option.silk" }
    if which == StandardRole.Ops { return b"silk/ops.silk" }
    if which == StandardRole.Equal { return b"silk/equal.silk" }
    return b"silk/order.silk"
  }
  /// Records that package `package` exports its module at canonical path `path`.
  pub effect fn publish(self: &mut Self, package: &[u8], path: &[u8]) -> () ! OutOfMemoryError ? &mut Allocator {
    run List<Export>.append(&mut self.exports, Export {package: run Bytes.copy(package), path: run Bytes.copy(path)})
    return ()
  }
  /// Whether `importer` may import `target`: a module of its own package, a standard-library
  /// module, or a module another package exports (PACKAGE-006).
  pub effect fn exported(self: &Self, importer: &ModuleId, target: &ModuleId) -> bool ! OutOfMemoryError ? &mut Allocator {
    if ModuleId.samePackage(importer, target) { return true }
    let path = run ModuleId.copyPath(target)
    if isStandard(Bytes.asSlice(&path)) { return true }
    let package = run ModuleId.copyPackage(target)
    let listed = List<Export>.asSlice(&self.exports)
    let mut at = usize.ZERO
    while at < listed.length {
      if same(Bytes.asSlice(&listed[at].package), Bytes.asSlice(&package)) && same(Bytes.asSlice(&listed[at].path), Bytes.asSlice(&path)) {
        return true
      }
      at = at + usize.ONE
    }
    return false
  }
  /// Copies the graph; the standard-library owner shares its identity record.
  pub effect fn copy(self: &Self) -> PackageGraph ! OutOfMemoryError ? &mut Allocator {
    let mut standard = Option<ModuleId>.none()
    if let Option<ModuleId>.Some {value} = &self.standard {
      standard = Option<ModuleId>.some(ModuleId.copy(&value))
    }
    let mut copied = PackageGraph {
      standard: move standard, dependencies: List<Dependency>.make(), exports: List<Export>.make(),
      roles: List<RolePath>.make(),
    }
    let listed = List<Dependency>.asSlice(&self.dependencies)
    let mut at = usize.ZERO
    while at < listed.length {
      run PackageGraph.depend(&mut copied, Bytes.asSlice(&listed[at].owner), Bytes.asSlice(&listed[at].name),
        Bytes.asSlice(&listed[at].package))
      at = at + usize.ONE
    }
    let exports = List<Export>.asSlice(&self.exports)
    let mut exportAt = usize.ZERO
    while exportAt < exports.length {
      run PackageGraph.publish(&mut copied, Bytes.asSlice(&exports[exportAt].package), Bytes.asSlice(&exports[exportAt].path))
      exportAt = exportAt + usize.ONE
    }
    let roles = List<RolePath>.asSlice(&self.roles)
    let mut roleAt = usize.ZERO
    while roleAt < roles.length {
      run PackageGraph.assign(&mut copied, roles[roleAt].which, Bytes.asSlice(&roles[roleAt].path))
      roleAt = roleAt + usize.ONE
    }
    return move copied
  }
  /// The module that `path`, a canonical module path such as `json/Value.silk`, names when
  /// `importer` imports it.
  ///
  /// # Gotchas
  ///
  /// A path with empty, `.` or `..` segments or a backslash fails, as [`ModuleId.sibling`] does.
  /// Whether [`PackageGraph.target`] of `path` written in `module` is `module` itself, decided
  /// without building the target's identity. A path `target` refuses names no module.
  pub fn targetsItself(self: &Self, module: &ModuleId, path: &[u8]) -> bool {
    if isStandard(path) {
      if let Option<ModuleId>.Some {value: owner} = &self.standard {
        return ModuleId.isSiblingOf(module, &owner, path)
      }
      return ModuleId.isSiblingOf(module, module, path)
    }
    let split = firstSegment(path)
    if split != usize.MAX {
      let first = Slice.view<u8>(path, usize.ZERO, split)
      let listed = List<Dependency>.asSlice(&self.dependencies)
      let mut at = usize.ZERO
      while at < listed.length {
        let owned = ModuleId.withPackage<bool>(module, fn(package: &[u8]) -> bool { return same(Bytes.asSlice(&listed[at].owner), package) })
        if owned && same(Bytes.asSlice(&listed[at].name), first) {
          let rest = Slice.view<u8>(path, split + usize.ONE, path.length - split - usize.ONE)
          return ModuleId.isPackageModuleOf(module, module, Bytes.asSlice(&listed[at].package), rest)
        }
        at = at + usize.ONE
      }
    }
    return ModuleId.isSiblingOf(module, module, path)
  }
  /// The name `importer`'s package gives the dependency that `target` belongs to, the first
  /// segment of the path that imports `target`; none for a module of the importer's own package,
  /// a standard-library module, or a package the importer does not name.
  pub effect fn dependencyName(self: &Self, importer: &ModuleId, target: &ModuleId) -> Option<Bytes>
  ! OutOfMemoryError
  ? &mut Allocator {
    if ModuleId.samePackage(importer, target) { return Option<Bytes>.none() }
    let owner = run ModuleId.copyPackage(importer)
    let package = run ModuleId.copyPackage(target)
    let listed = List<Dependency>.asSlice(&self.dependencies)
    let mut at = usize.ZERO
    while at < listed.length {
      if same(Bytes.asSlice(&listed[at].owner), Bytes.asSlice(&owner)) && same(Bytes.asSlice(&listed[at].package), Bytes.asSlice(&package)) {
        return Option<Bytes>.some(run Bytes.copy(Bytes.asSlice(&listed[at].name)))
      }
      at = at + usize.ONE
    }
    return Option<Bytes>.none()
  }
  pub effect fn target(self: &Self, importer: &ModuleId, path: &[u8]) -> ModuleId
  ! InvalidModulePath | OutOfMemoryError
  ? &mut Allocator {
    if isStandard(path) {
      if let Option<ModuleId>.Some {value: owner} = &self.standard {
        return run ModuleId.sibling(&owner, path)
      }
      return run ModuleId.sibling(importer, path)
    }
    let split = firstSegment(path)
    if split != usize.MAX {
      let owner = run ModuleId.copyPackage(importer)
      let first = Slice.view<u8>(path, usize.ZERO, split)
      let listed = List<Dependency>.asSlice(&self.dependencies)
      let mut at = usize.ZERO
      while at < listed.length {
        if same(Bytes.asSlice(&listed[at].owner), Bytes.asSlice(&owner)) && same(Bytes.asSlice(&listed[at].name), first) {
          let origin = run ModuleId.copyOrigin(importer)
          let rest = Slice.view<u8>(path, split + usize.ONE, path.length - split - usize.ONE)
          return run ModuleId.make(Bytes.asSlice(&origin), Bytes.asSlice(&listed[at].package), rest)
        }
        at = at + usize.ONE
      }
    }
    return run ModuleId.sibling(importer, path)
  }
  /// The barrel module that `path`, a canonical module path such as `util/Shapes.silk`, names when
  /// `importer` imports it: the `mod.silk` file of the directory `util/Shapes`, in the package of
  /// [`PackageGraph.target`] of the same path.
  ///
  /// # Gotchas
  ///
  /// A path with empty, `.` or `..` segments or a backslash fails, as [`ModuleId.sibling`] does.
  pub effect fn barrel(self: &Self, importer: &ModuleId, path: &[u8]) -> ModuleId
  ! InvalidModulePath | OutOfMemoryError
  ? &mut Allocator {
    let file = run PackageGraph.target(self, importer, path)
    let origin = run ModuleId.copyOrigin(&file)
    let package = run ModuleId.copyPackage(&file)
    let filePath = run ModuleId.copyPath(&file)
    let barrel = run PackageGraph.barrelPath(Bytes.asSlice(&filePath))
    return run ModuleId.make(Bytes.asSlice(&origin), Bytes.asSlice(&package), Bytes.asSlice(&barrel))
  }
}
