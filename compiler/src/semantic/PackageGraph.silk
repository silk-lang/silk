//! Which module an import path names when a build spans several packages.
//!
//! # When to use
//! Use [`PackageGraph.target`] wherever an import path, or a standard-library path the language
//! reads without an import, becomes a module identity. Preloading and import resolution must agree
//! on it, or a build would read one module and resolve another.
//!
//! # Details
//! A package lists its dependencies by name (PACKAGE-002). An import path whose first segment is
//! one of the importing package's dependency names names a module of that dependency: the rest of
//! the path, in the dependency's own package identity. Any other path stays in the importing
//! package. Standard-library paths (`silk/...`) and the sealed operator catalog belong to one
//! package for the whole build (PACKAGE-005), so every package shares the same library modules.
//!
//! An empty graph names no dependencies and no standard-library owner, so every path stays in its
//! importer's package: the single-package build that semantic test fixtures assemble.

import semantic.ModuleId {InvalidModulePath, ModuleId}
import semantic.SealedOperators
import silk.allocator {Allocator, OutOfMemoryError}
import silk.bytes {Bytes}
import silk.option {Option}
import silk.slice {Slice}
import silk.usize
import silk.vector {Vector}

// One dependency of one package: the name its imports use and the package identity it selects.
struct Dependency {
  owner: Bytes
  name: Bytes
  package: Bytes
}

/// The dependency names of every package in one build and the owner of its standard library.
pub struct PackageGraph {
  // A module of the package that owns standard-library paths; its origin and package are used.
  standard: Option<ModuleId>
  dependencies: Vector<Dependency>
}

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] { return false }
    at = at + usize.ONE
  }
  return true
}

fn startsWith(bytes: &[u8], prefix: &[u8]) -> bool {
  if bytes.length < prefix.length { return false }
  let mut at = usize.ZERO
  while at < prefix.length {
    if bytes[at] != prefix[at] { return false }
    at = at + usize.ONE
  }
  return true
}

/// Whether `path` is a standard-library module path or the sealed operator catalog, which belong
/// to the build's standard-library owner rather than to the importing package.
pub fn isStandard(path: &[u8]) -> bool {
  return startsWith(path, b"silk/") || SealedOperators.isPath(path)
}

// The length of the first segment of a module path such as `json/Value.silk`, or `usize.MAX` when
// the path has a single segment and so cannot name a module below a dependency.
fn firstSegment(path: &[u8]) -> usize {
  let mut at = usize.ZERO
  while at < path.length {
    if path[at] == 47 { return at }
    at = at + usize.ONE
  }
  return usize.MAX
}

impl PackageGraph {
  /// A graph with no dependencies, where every path stays in its importer's package.
  pub fn single() -> PackageGraph {
    return PackageGraph {standard: Option<ModuleId>.none(), dependencies: Vector<Dependency>.make()}
  }
  /// A graph whose standard-library paths belong to the origin and package of `owner`.
  pub fn make(owner: &ModuleId) -> PackageGraph {
    return PackageGraph {standard: Option<ModuleId>.some(ModuleId.copy(owner)), dependencies: Vector<Dependency>.make()}
  }
  /// Records that package `owner` imports package `package` under the dependency name `name`.
  pub effect fn depend(self: &mut Self, owner: &[u8], name: &[u8], package: &[u8]) -> () ! OutOfMemoryError ? &mut Allocator {
    run Vector<Dependency>.append(&mut self.dependencies, Dependency {
      owner: run Bytes.copy(owner), name: run Bytes.copy(name), package: run Bytes.copy(package),
    })
    return ()
  }
  /// Copies the graph; the standard-library owner shares its identity record.
  pub effect fn copy(self: &Self) -> PackageGraph ! OutOfMemoryError ? &mut Allocator {
    let mut standard = Option<ModuleId>.none()
    if let Option<ModuleId>.Some {value} = &self.standard {
      standard = Option<ModuleId>.some(ModuleId.copy(&value))
    }
    let mut copied = PackageGraph {standard: move standard, dependencies: Vector<Dependency>.make()}
    let listed = Vector<Dependency>.asSlice(&self.dependencies)
    let mut at = usize.ZERO
    while at < listed.length {
      run PackageGraph.depend(&mut copied, Bytes.asSlice(&listed[at].owner), Bytes.asSlice(&listed[at].name),
        Bytes.asSlice(&listed[at].package))
      at = at + usize.ONE
    }
    return move copied
  }
  /// The module that `path`, a canonical module path such as `json/Value.silk`, names when
  /// `importer` imports it.
  ///
  /// # Gotchas
  ///
  /// A path with empty, `.` or `..` segments or a backslash fails, as [`ModuleId.sibling`] does.
  pub effect fn target(self: &Self, importer: &ModuleId, path: &[u8]) -> ModuleId
  ! InvalidModulePath | OutOfMemoryError
  ? &mut Allocator {
    if isStandard(path) {
      if let Option<ModuleId>.Some {value: owner} = &self.standard {
        return run ModuleId.sibling(&owner, path)
      }
      return run ModuleId.sibling(importer, path)
    }
    let split = firstSegment(path)
    if split != usize.MAX {
      let owner = run ModuleId.copyPackage(importer)
      let first = Slice.view<u8>(path, usize.ZERO, split)
      let listed = Vector<Dependency>.asSlice(&self.dependencies)
      let mut at = usize.ZERO
      while at < listed.length {
        if same(Bytes.asSlice(&listed[at].owner), Bytes.asSlice(&owner)) && same(Bytes.asSlice(&listed[at].name), first) {
          let origin = run ModuleId.copyOrigin(importer)
          let rest = Slice.view<u8>(path, split + usize.ONE, path.length - split - usize.ONE)
          return run ModuleId.make(Bytes.asSlice(&origin), Bytes.asSlice(&listed[at].package), rest)
        }
        at = at + usize.ONE
      }
    }
    return run ModuleId.sibling(importer, path)
  }
}
