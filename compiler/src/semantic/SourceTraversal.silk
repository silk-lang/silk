//! Complete structural evaluation order for source and ownership analysis.
//!
//! Reservation emits one SourceFlow CFG into SourceAnalysis.Skeleton. It never inspects a
//! solved source, loan precision, policy result or checker-outside flag. Consumers attach source
//! transport and ownership actions to these actual occurrences before that same graph is solved.

import hir.Hir {InfixOperator}
import semantic.SourceAnalysis {Skeleton, SelectionUse, ThroughDescriptor, ThroughFlightKind, Directness, TransferPolicy, EvalId, EvaluationRole, Evaluation, EvaluationSite, Seed, Leaf, SourceLeaf, Storage, sameSelector, inputOperand, sameInputRead}
import semantic.SourceFlow {Flow, PointId, Write}
import semantic.SourceRules {Atom, Program}
import semantic.SourcePreparation {SourcePreparation, Endpoint, EndpointId, Root, EndpointRole, Shape, ShapeState, Component, Selector, IndexClass, MapId, SelectionId, Selection, SelectionMap, MapKind, InputRead, InputRoute, Construction, Operation, Transport, Replacement, ArraySlice}
import semantic.TypedBody {Node, NodeId, NodeKind, Expression, LocalId, AggregateField, MatchArm, MatchSyntax, SubjectAccess, BindingAccess, RunAccess, ConsumedPlace, SourceConstruction, PlaceStep}
import semantic.Type {Type}
import semantic.StorageOperation {StorageOperation}
import silk.allocator {Allocator, OutOfMemoryError}
import silk.option {Option}
import silk.ownership {Copy}
import silk.shared {Shared}
import silk.usize
import silk.list {List}
import CompilerBug

/// Addressing a place does not copy its stored value. Dereferencing it still evaluates the
/// reference descriptor, and an index expression still executes in source order.
pub enum Access { Value, Place }
pub enum ScopeKind { Body, Block, Statement, Match, Arm }
pub enum ExitKind { Normal, Return, Failure, Break, Continue, RunFailure }
pub enum Retention { None, Arrays, Storage }
pub struct OwnerId { pub index: usize }
impl Copy for OwnerId {}
pub union OwnerRoot { Local { pub local: LocalId }, Temporary { pub evaluation: EvalId }, Subject { pub node: NodeId, pub evaluation: EvalId } }
impl Copy for OwnerRoot {}
pub struct Owner {
  pub root: OwnerRoot
  pub scope: ScopeId
  pub initialized: PointId
}
pub enum OwnerAction { Use, Cleanup, End, Expire }
pub struct OwnerExit {
  pub owner: OwnerId
  pub action: OwnerAction
  pub point: PointId
  pub cause: NodeId
  /// Use/Cleanup observes this owner's current value here, separately from acquisition.
  /// The source root comes from owner, never from the exit's diagnostic cause node.
  pub read: Option<EvalId>
}

pub struct ScopeId { pub index: usize }
impl Copy for ScopeId {}

pub struct Scope {
  pub node: NodeId
  pub kind: ScopeKind
  pub parent: Option<ScopeId>
  pub owners: List<OwnerId>
  pub expiring: List<OwnerId>
}

pub struct ScopeExit {
  pub scope: ScopeId
  pub point: PointId
  pub cause: NodeId
  pub kind: ExitKind
}

pub struct Input {
  pub node: NodeId
  pub evaluation: EvalId
  /// The enclosing operation's use occurs after this evaluation and before the next input.
  /// Receiver borrowing/consumption attaches here, not at the later result-production point.
  pub usePoint: PointId
  /// Completion after this input's statement cleanup; ordinary inputs retain usePoint.
  pub completed: PointId
  pub access: Access
  pub read: Option<InputRead>
}
impl Copy for Input {}

/// One actual arm interval, including provisional bindings and its optional guard.
pub struct ArmResult {
  pub entry: PointId
  /// Actual guard operand position in Visit.inputs; repeated guard NodeIds stay distinct.
  pub guard: Option<usize>
  pub input: usize
  pub completed: PointId
}
impl Copy for ArmResult {}

/// A single actual evaluation, separate from its enclosing operation's use of the result.
/// `execute` is reached even for a never-returning call. Its successful output evaluation can
/// instead be unreachable; this distinction must survive into operation effects and queries.
pub struct Visit {
  /// Incoming occurrence point, before any operands or checker refusal.
  pub entry: PointId
  pub node: NodeId
  pub evaluation: EvalId
  pub execute: PointId
  /// Successful completion, or the existing post-cleanup point of a terminating transfer.
  pub completed: PointId
  /// Replace reads displaced storage here, after its RHS and before the result/write point.
  pub displaced: Option<EvalId>
  /// Exact current-owner Cleanup action reserved before a whole replacement.
  pub prewrite: Option<usize>
  pub access: Access
  pub scope: ScopeId
  pub inputs: List<Input>
  /// Match arm ordinal -> exact result input position, including repeated NodeIds.
  pub armInputs: List<ArmResult>
}

pub struct Loop {
  pub node: NodeId
  pub before: PointId
  pub header: PointId
  /// Actual body completion, including cleanup, even when unreachable. Exit is allocated earlier.
  pub completed: PointId
  pub exit: PointId
  pub backedges: List<PointId>
}

/// Actual structural encounter order, independent of preallocated CFG point ordinals.
/// Applicability remains the owning occurrence/action's existing runtime atom.
pub union Dispatch {
  Enter {pub evaluation: EvalId},
  InputComplete {pub evaluation: EvalId, pub input: usize},
  InputSettled {pub evaluation: EvalId, pub input: usize},
  ArmComplete {pub evaluation: EvalId, pub arm: usize},
  TransferComplete {pub evaluation: EvalId},
  Finish {pub evaluation: EvalId},
  OwnerExit {pub exit: usize},
}
impl Copy for Dispatch {}

// Evaluation IDs are allocated after operands. Retain a private encounter ordinal during
// traversal, then resolve it once to the exact completed Visit; never predict an EvalId.
union PendingDispatch {
  Enter {occurrence: usize},
  InputComplete {occurrence: usize, input: usize},
  InputSettled {occurrence: usize, input: usize},
  ArmComplete {occurrence: usize, arm: usize},
  TransferComplete {occurrence: usize},
  Finish {occurrence: usize},
  OwnerExit {exit: usize},
}
impl Copy for PendingDispatch {}

pub struct Reservation {
  pub dispatch: List<Dispatch>
  pub skeleton: Skeleton
  pub entry: PointId
  pub exit: PointId
  pub visits: List<Visit>
  pub scopes: List<Scope>
  pub exits: List<ScopeExit>
  pub loops: List<Loop>
  pub owners: List<Owner>
  pub ownerExits: List<OwnerExit>
  pub subjects: List<Subject>
}

struct Frame {
  repeat: usize
  scopeDepth: usize
}
impl Copy for Frame {}
/// A match or zero-count repeat captures its operand once. Owned subjects have a distinct
/// snapshot occurrence; borrowed/place subjects keep the actual scoped address.
pub struct Subject {
  pub site: NodeId
  pub node: NodeId
  pub source: EvalId
  pub evaluation: EvalId
  pub scope: ScopeId
  pub owned: bool
  pub consumes: bool
}
impl Copy for Subject {}
struct Walk {
  encounters: List<Option<EvalId>>
  visiting: List<usize>
  dispatch: List<PendingDispatch>
  reservation: Reservation
  active: List<ScopeId>
  frames: List<Frame>
  yes: Atom
  retention: Retention
}
struct Completed {
  evaluation: EvalId
  next: PointId
}
impl Copy for Completed {}

pub effect fn reserve<'body>(prepared: &SourcePreparation<'body>) -> Reservation
! OutOfMemoryError ? &mut Allocator {
  let mut skeleton = Skeleton.make()
  let yes = Program.atom(&mut skeleton.rules)
  run Program.fact(&mut skeleton.rules, yes)
  let entry = run Flow.point(&mut skeleton.flow, &mut skeleton.rules)
  let exit = run Flow.point(&mut skeleton.flow, &mut skeleton.rules)
  run Program.fact(&mut skeleton.rules, Flow.reachable(&skeleton.flow, entry))
  let mut walk = Walk {encounters: List<Option<EvalId>>.make(), visiting: List<usize>.make(), dispatch: List<PendingDispatch>.make(),
    reservation: Reservation {dispatch: List<Dispatch>.make(), skeleton: move skeleton, entry: entry, exit: exit,
    visits: List<Visit>.make(), scopes: List<Scope>.make(), exits: List<ScopeExit>.make(), loops: List<Loop>.make(),
    owners: List<Owner>.make(), ownerExits: List<OwnerExit>.make(), subjects: List<Subject>.make()},
    active: List<ScopeId>.make(), frames: List<Frame>.make(), yes: yes, retention: Retention.None}
  run openScope(&mut walk, prepared.body.root, ScopeKind.Body)
  // The same entry eligibility as accepted ownership initialization: actual bindings acquire
  // definitions at their nodes, never at entry. No invented RHS stands for a parameter/capture.
  let mut initialized = entry
  let mut local = usize.ZERO
  while local < prepared.body.locals.length {
    let mut bound = false
    let mut node = usize.ZERO
    while node < prepared.body.nodes.length {
      let binding = match &prepared.body.nodes[node].kind {
        NodeKind.LocalBinding {local: found, ..} => found.index == local
        NodeKind.MutableBinding {local: found, ..} => found.index == local
        _ => false
      }
      bound = bound || binding
      node = node + usize.ONE
    }
    if !bound {
      initialized = run after(&mut walk, initialized)
      let entryValue = run Skeleton.entry(&mut walk.reservation.skeleton, LocalId {index: local}, initialized)
      run Skeleton.constructionOccurrence(&mut walk.reservation.skeleton, entryValue, usize.ZERO)
      drop run registerOwner(&mut walk, OwnerRoot.Local {local: LocalId {index: local}}, initialized, true)
    }
    local = local + usize.ONE
  }
  let body = run visit(prepared, &mut walk, prepared.body.root, Access.Value, initialized)
  let ended = run closeScopes(&mut walk, usize.ZERO, body.next, prepared.body.root, ExitKind.Normal)
  run edge(&mut walk, ended, exit)
  run activateLocalStorage(prepared, &mut walk.reservation, yes)
  if List<usize>.length(&walk.visiting) != usize.ZERO { CompilerBug.panic(b"source dispatch left an unfinished occurrence") }
  let encounters = List<Option<EvalId>>.asSlice(&walk.encounters)
  let dispatch = List<PendingDispatch>.asSlice(&walk.dispatch)
  let mut at = usize.ZERO
  while at < dispatch.length {
    let action = match dispatch[at] {
      PendingDispatch.Enter {occurrence} => Dispatch.Enter {evaluation: dispatchEvaluation(encounters, occurrence)}
      PendingDispatch.InputComplete {occurrence, input} => Dispatch.InputComplete {evaluation: dispatchEvaluation(encounters, occurrence), input: input}
      PendingDispatch.InputSettled {occurrence, input} => Dispatch.InputSettled {evaluation: dispatchEvaluation(encounters, occurrence), input: input}
      PendingDispatch.ArmComplete {occurrence, arm} => Dispatch.ArmComplete {evaluation: dispatchEvaluation(encounters, occurrence), arm: arm}
      PendingDispatch.TransferComplete {occurrence} => Dispatch.TransferComplete {evaluation: dispatchEvaluation(encounters, occurrence)}
      PendingDispatch.Finish {occurrence} => Dispatch.Finish {evaluation: dispatchEvaluation(encounters, occurrence)}
      PendingDispatch.OwnerExit {exit: ownerExit} => Dispatch.OwnerExit {exit: ownerExit}
    }
    run List<Dispatch>.append(&mut walk.reservation.dispatch, action)
    at = at + usize.ONE
  }
  return move walk.reservation
}

fn dispatchEvaluation(encounters: &[Option<EvalId>], occurrence: usize) -> EvalId {
  if occurrence >= encounters.length { return CompilerBug.panic(b"source dispatch lost its actual encounter") }
  return match encounters[occurrence] {
    Option<EvalId>.Some {value} => value
    _ => CompilerBug.panic(b"source dispatch names an unfinished occurrence")
  }
}

effect fn completeInput(walk: &mut Walk, count: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  let visiting = List<usize>.asSlice(&walk.visiting)
  if count == usize.ZERO || visiting.length == usize.ZERO { return CompilerBug.panic(b"source input has no actual parent encounter") }
  run List<PendingDispatch>.append(&mut walk.dispatch, PendingDispatch.InputComplete {
    occurrence: visiting[visiting.length - usize.ONE], input: count - usize.ONE})
  return ()
}

// Keep the pre-cleanup input use intact: implicit acquisition and defer observe that boundary.
// Only callers that actually close an input scope publish its later semantic completion.
effect fn settleInput(walk: &mut Walk, inputs: &mut List<Input>, ended: PointId) -> ()
! OutOfMemoryError ? &mut Allocator {
  let count = List<Input>.length(&inputs.*)
  let visiting = List<usize>.asSlice(&walk.visiting)
  if count == usize.ZERO || visiting.length == usize.ZERO { return CompilerBug.panic(b"settled source input has no actual parent encounter") }
  let completedInputs = List<Input>.asMutSlice(&mut inputs.*)
  completedInputs[count - usize.ONE].completed = ended
  run List<PendingDispatch>.append(&mut walk.dispatch, PendingDispatch.InputSettled {
    occurrence: visiting[visiting.length - usize.ONE], input: count - usize.ONE})
  return ()
}

effect fn point(walk: &mut Walk) -> PointId ! OutOfMemoryError ? &mut Allocator {
  return run Flow.point(&mut walk.reservation.skeleton.flow, &mut walk.reservation.skeleton.rules)
}
effect fn edge(walk: &mut Walk, from: PointId, to: PointId) -> () ! OutOfMemoryError ? &mut Allocator {
  run Flow.edge(&mut walk.reservation.skeleton.flow, from, to, walk.yes)
  return ()
}
effect fn after(walk: &mut Walk, previous: PointId) -> PointId ! OutOfMemoryError ? &mut Allocator {
  let next = run point(&mut walk.*)
  run edge(&mut walk.*, previous, next)
  return next
}
effect fn openScope(walk: &mut Walk, node: NodeId, kind: ScopeKind) -> () ! OutOfMemoryError ? &mut Allocator {
  let active = List<ScopeId>.asSlice(&walk.active)
  let mut parent = Option<ScopeId>.none()
  if active.length > usize.ZERO { parent = Option<ScopeId>.some(active[active.length - usize.ONE]) }
  let id = ScopeId {index: List<Scope>.length(&walk.reservation.scopes)}
  run List<Scope>.append(&mut walk.reservation.scopes, Scope {node: node, kind: kind, parent: move parent, owners: List<OwnerId>.make(), expiring: List<OwnerId>.make()})
  run List<ScopeId>.append(&mut walk.active, id)
  return ()
}
// Registers physical owners in acquisition order. A retained initializer temporary lives in
// the nearest non-statement scope; its validity may still expire in the creating statement.
effect fn registerOwner(walk: &mut Walk, root: OwnerRoot, initialized: PointId, lexical: bool) -> OwnerId
! OutOfMemoryError ? &mut Allocator {
  let active = List<ScopeId>.asSlice(&walk.active)
  let mut at = active.length
  if at == usize.ZERO { return CompilerBug.panic(b"source owner has no active lexical scope") }
  at = at - usize.ONE
  while lexical && at > usize.ZERO && List<Scope>.asSlice(&walk.reservation.scopes)[active[at].index].kind == ScopeKind.Statement {
    at = at - usize.ONE
  }
  let scope = active[at]
  let id = OwnerId {index: List<Owner>.length(&walk.reservation.owners)}
  run List<Owner>.append(&mut walk.reservation.owners, Owner {root: root, scope: scope, initialized: initialized})
  let scopes = List<Scope>.asMutSlice(&mut walk.reservation.scopes)
  run List<OwnerId>.append(&mut scopes[scope.index].owners, id)
  return id
}

effect fn ownerAction(walk: &mut Walk, owner: OwnerId, action: OwnerAction, previous: PointId, cause: NodeId) -> PointId
! OutOfMemoryError ? &mut Allocator {
  let current = run after(&mut walk.*, previous)
  let mut read = Option<EvalId>.none()
  if action == OwnerAction.Use || action == OwnerAction.Cleanup {
    read = Option<EvalId>.some(run Skeleton.evaluate(&mut walk.reservation.skeleton, cause, EvaluationRole.Cleanup, current))
  }
  let ordinal = List<OwnerExit>.length(&walk.reservation.ownerExits)
  run List<PendingDispatch>.append(&mut walk.dispatch, PendingDispatch.OwnerExit {exit: ordinal})
  run List<OwnerExit>.append(&mut walk.reservation.ownerExits, OwnerExit {owner: owner, action: action, point: current,
    cause: cause, read: move read})
  return current
}

// Whole replacement observes the old local at RHS completion, before the new definition.
// Scope membership selects the actual acquisition; a repeated typed binding is not its owner.
effect fn replacementCleanup(walk: &mut Walk, local: LocalId, previous: PointId, cause: NodeId) -> PointId
! OutOfMemoryError ? &mut Allocator {
  let active = List<ScopeId>.asSlice(&walk.active)
  let scopes = List<Scope>.asSlice(&walk.reservation.scopes)
  let owners = List<Owner>.asSlice(&walk.reservation.owners)
  let mut scope = active.length
  let mut found = Option<OwnerId>.none()
  while scope > usize.ZERO {
    scope = scope - usize.ONE
    let acquired = List<OwnerId>.asSlice(&scopes[active[scope].index].owners)
    let mut at = acquired.length
    while at > usize.ZERO {
      at = at - usize.ONE
      let matches = match owners[acquired[at].index].root {
        OwnerRoot.Local {local: actual} => actual.index == local.index
        _ => false
      }
      if matches {
        found = Option<OwnerId>.some(acquired[at])
        break
      }
    }
    if let Option<OwnerId>.Some {..} = found { break }
  }
  if let Option<OwnerId>.Some {value: owner} = found {
    return run ownerAction(&mut walk.*, owner, OwnerAction.Cleanup, previous, cause)
  }
  return CompilerBug.panic(b"whole replacement has no actual active local owner")
}

// Empty place/exclusive bindings over named storage retain the whole local's identity.
// Follow only their recorded nonowned subject; rvalues and owned snapshots stop here.
fn replacementLocal<'body>(prepared: &SourcePreparation<'body>, reservation: &Reservation, target: Input) -> Option<LocalId> {
  let mut current = target
  let mut remaining = List<Visit>.length(&reservation.visits) + usize.ONE
  while remaining > usize.ZERO {
    remaining = remaining - usize.ONE
    if current.access != Access.Place { return Option<LocalId>.none() }
    let actual = occurrence(reservation, current.evaluation)
    if actual.node.index != current.node.index { return CompilerBug.panic(b"replacement changed its actual destination occurrence") }
    match &prepared.body.nodes[actual.node.index].kind {
      NodeKind.Expression {form: Expression.Local {local}, ..} => { return Option<LocalId>.some(local) }
      NodeKind.Expression {form: Expression.PatternBinding {subject, access, path, ..}, ..} => {
        if access != BindingAccess.Place && access != BindingAccess.Exclusive { return Option<LocalId>.none() }
        if List<PlaceStep>.length(&path) != usize.ZERO { return Option<LocalId>.none() }
        let inputs = List<Input>.asSlice(&actual.inputs)
        if inputs.length != usize.ONE || inputs[0].node.index != subject.index {
          return CompilerBug.panic(b"whole pattern replacement lost its actual subject")
        }
        let subjects = List<Subject>.asSlice(&reservation.subjects)
        let mut retained = false
        let mut at = usize.ZERO
        while at < subjects.length {
          if subjects[at].node.index == subject.index && subjects[at].evaluation.index == inputs[0].evaluation.index
            && !subjects[at].owned {
            let matched = match &prepared.body.nodes[subjects[at].site.index].kind {
              NodeKind.Expression {form: Expression.Match {subject: matchedSubject, access: SubjectAccess.Place {access: mode}, ..}, ..} =>
                matchedSubject.index == subject.index && mode == access
              _ => false
            }
            if matched { retained = true }
          }
          at = at + usize.ONE
        }
        if !retained { return Option<LocalId>.none() }
        current = inputs[0]
      }
      _ => { return Option<LocalId>.none() }
    }
  }
  return CompilerBug.panic(b"whole replacement subject occurrence chain is cyclic")
}

// Conditional owner-use/cleanup actions get immutable points before solving. Their effects
// are gated by the real held sources and cleanup contract; their reservation is not a use.
// A transfer exit replays release order without mutating sibling lexical acquisition state.
effect fn closeScopes(walk: &mut Walk, depth: usize, from: PointId, cause: NodeId, kind: ExitKind) -> PointId
! OutOfMemoryError ? &mut Allocator {
  let mut at = List<ScopeId>.length(&walk.active)
  let mut current = from
  while at > depth {
    at = at - usize.ONE
    let scope = List<ScopeId>.asSlice(&walk.active)[at]
    let mut expiring = List<OwnerId>.make()
    let mut owners = List<OwnerId>.make()
    let scopes = List<Scope>.asSlice(&walk.reservation.scopes)
    let expires = List<OwnerId>.asSlice(&scopes[scope.index].expiring)
    let roots = List<OwnerId>.asSlice(&scopes[scope.index].owners)
    let mut each = expires.length
    while each > usize.ZERO {
      each = each - usize.ONE
      run List<OwnerId>.append(&mut expiring, expires[each])
    }
    each = roots.length
    while each > usize.ZERO {
      each = each - usize.ONE
      run List<OwnerId>.append(&mut owners, roots[each])
    }
    let ended = List<OwnerId>.asSlice(&expiring)
    each = usize.ZERO
    while each < ended.length {
      current = run ownerAction(&mut walk.*, ended[each], OwnerAction.Expire, current, cause)
      each = each + usize.ONE
    }
    let released = List<OwnerId>.asSlice(&owners)
    each = usize.ZERO
    while each < released.length {
      current = run ownerAction(&mut walk.*, released[each], OwnerAction.Use, current, cause)
      current = run ownerAction(&mut walk.*, released[each], OwnerAction.Cleanup, current, cause)
      current = run ownerAction(&mut walk.*, released[each], OwnerAction.End, current, cause)
      each = each + usize.ONE
    }
    current = run after(&mut walk.*, current)
    run List<ScopeExit>.append(&mut walk.reservation.exits, ScopeExit {scope: scope, point: current, cause: cause, kind: kind})
  }
  return current
}

effect fn input<'body>(prepared: &SourcePreparation<'body>, walk: &mut Walk, inputs: &mut List<Input>,
  node: NodeId, access: Access, previous: PointId) -> PointId ! OutOfMemoryError ? &mut Allocator {
  let result = run visit(prepared, &mut walk.*, node, access, previous)
  let used = run after(&mut walk.*, result.next)
  run List<Input>.append(&mut inputs.*, Input {node: node, evaluation: result.evaluation, usePoint: used, completed: used,
    access: access, read: Option<InputRead>.none()})
  run completeInput(&mut walk.*, List<Input>.length(&inputs.*))
  return used
}

// Record the actual vector coordinate before evaluation order can permute it (pipeline calls).
effect fn selectedInput<'body>(prepared: &SourcePreparation<'body>, walk: &mut Walk, inputs: &mut List<Input>,
  site: NodeId, node: NodeId, read: InputRead, previous: PointId) -> PointId ! OutOfMemoryError ? &mut Allocator {
  let mut access = Access.Value
  if referenceInput(prepared, site, read) { access = Access.Place }
  return run selectedAccess(prepared, &mut walk.*, &mut inputs.*, node, read, access, previous)
}

// A place-taking primitive uses the same occurrence coordinate without pretending to create
// a reference. In particular Replace must not read its destination before evaluating its RHS.
effect fn selectedAccess<'body>(prepared: &SourcePreparation<'body>, walk: &mut Walk, inputs: &mut List<Input>,
  node: NodeId, read: InputRead, access: Access, previous: PointId) -> PointId
! OutOfMemoryError ? &mut Allocator {
  let result = run visit(prepared, &mut walk.*, node, access, previous)
  let used = run after(&mut walk.*, result.next)
  run List<Input>.append(&mut inputs.*, Input {node: node, evaluation: result.evaluation, usePoint: used, completed: used,
    access: access, read: Option<InputRead>.some(read)})
  run completeInput(&mut walk.*, List<Input>.length(&inputs.*))
  return used
}

// The producer explicitly requests a reference to this actual operand. This only selects
// place evaluation/temporary lifetime; the real Borrow leaf/event is still created once by
// that InputRoute's transport. Shared same-map PrepareEffect metadata adds no second action.
fn referenceInput<'body>(prepared: &SourcePreparation<'body>, site: NodeId, read: InputRead) -> bool {
  let constructions = List<Construction>.asSlice(&prepared.constructions)
  let operations = List<Operation>.asSlice(&prepared.operations)
  let mut at = usize.ZERO
  while at < constructions.length {
    if constructions[at].site.index == site.index && borrowedInput(List<InputRoute>.asSlice(&constructions[at].inputs), read) { return true }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < operations.length {
    if operations[at].site.index == site.index && borrowedInput(List<InputRoute>.asSlice(&operations[at].inputs), read) { return true }
    at = at + usize.ONE
  }
  return false
}

fn borrowedInput(inputs: &[InputRoute], read: InputRead) -> bool {
  let mut at = usize.ZERO
  while at < inputs.length {
    if sameInputRead(inputs[at].read, read)
      && (inputs[at].transport == Transport.BorrowShared || inputs[at].transport == Transport.BorrowMutable) { return true }
    at = at + usize.ONE
  }
  return false
}

/// Actual structural occurrence lookup. NodeId is intentionally insufficient here: source
/// borrowers and implicit receivers follow their enclosing Visit's recorded EvalId chain.
pub fn occurrence(reservation: &Reservation, evaluation: EvalId) -> &Visit {
  let visits = List<Visit>.asSlice(&reservation.visits)
  let mut at = usize.ZERO
  while at < visits.length {
    if visits[at].evaluation.index == evaluation.index { return &visits[at] }
    at = at + usize.ONE
  }
  return CompilerBug.panic(b"ownership source names no actual node evaluation")
}

/// Resolve a route only within this physical operation's actual inputs. Repeated NodeIds at
/// different argument coordinates remain separate; a malformed duplicate coordinate is a defect.
pub fn routeInput<'body>(prepared: &SourcePreparation<'body>, visit: &Visit, route: &InputRoute) -> Input {
  let operand = inputOperand(prepared, visit.node, route.read)
  let inputs = List<Input>.asSlice(&visit.inputs)
  let mut found = Option<Input>.none()
  let mut at = usize.ZERO
  while at < inputs.length {
    if let Option<InputRead>.Some {value} = inputs[at].read {
      if sameInputRead(value, route.read) {
        if inputs[at].node.index != operand.index { return CompilerBug.panic(b"source route names another operand occurrence") }
        if let Option<Input>.Some {..} = found { return CompilerBug.panic(b"source operation repeated an input coordinate") }
        found = Option<Input>.some(inputs[at])
      }
    }
    at = at + usize.ONE
  }
  return match found {
    Option<Input>.Some {value} => value
    Option<Input>.None => CompilerBug.panic(b"prepared source input has no actual evaluation")
  }
}

effect fn operands<'body>(prepared: &SourcePreparation<'body>, walk: &mut Walk, inputs: &mut List<Input>,
  site: NodeId, nodes: &[NodeId], previous: PointId) -> PointId ! OutOfMemoryError ? &mut Allocator {
  let mut current = previous
  let mut at = usize.ZERO
  while at < nodes.length {
    current = run selectedInput(prepared, &mut walk.*, &mut inputs.*, site, nodes[at], InputRead.Argument {ordinal: at}, current)
    at = at + usize.ONE
  }
  return current
}

effect fn fields<'body>(prepared: &SourcePreparation<'body>, walk: &mut Walk, inputs: &mut List<Input>,
  site: NodeId, values: &[AggregateField], previous: PointId) -> PointId ! OutOfMemoryError ? &mut Allocator {
  let mut current = previous
  let mut at = usize.ZERO
  while at < values.length {
    current = run selectedInput(prepared, &mut walk.*, &mut inputs.*, site, values[at].value, InputRead.Field {ordinal: at}, current)
    at = at + usize.ONE
  }
  return current
}

// Conditions/guards own statement temporaries even outside an enclosing ordinary statement.
effect fn settled<'body>(prepared: &SourcePreparation<'body>, walk: &mut Walk, inputs: &mut List<Input>,
  node: NodeId, previous: PointId) -> PointId ! OutOfMemoryError ? &mut Allocator {
  let depth = List<ScopeId>.length(&walk.active)
  run openScope(&mut walk.*, node, ScopeKind.Statement)
  let saved = walk.retention
  walk.retention = Retention.None
  let current = run input(prepared, &mut walk.*, &mut inputs.*, node, Access.Value, previous)
  walk.retention = saved
  let ended = run closeScopes(&mut walk.*, depth, current, node, ExitKind.Normal)
  List<ScopeId>.truncate(&mut walk.active, depth)
  run settleInput(&mut walk.*, &mut inputs.*, ended)
  return ended
}

effect fn visit<'body>(prepared: &SourcePreparation<'body>, walk: &mut Walk, id: NodeId, access: Access,
  previous: PointId) -> Completed ! OutOfMemoryError ? &mut Allocator {
  if id.index >= prepared.body.nodes.length { return CompilerBug.panic(b"source traversal names an absent body node") }
  let encounter = List<Option<EvalId>>.length(&walk.encounters)
  run List<Option<EvalId>>.append(&mut walk.encounters, Option<EvalId>.none())
  run List<usize>.append(&mut walk.visiting, encounter)
  run List<PendingDispatch>.append(&mut walk.dispatch, PendingDispatch.Enter {occurrence: encounter})
  let node = &prepared.body.nodes[id.index]
  let mut inputs = List<Input>.make()
  let mut armInputs = List<ArmResult>.make()
  let mut prewrite = Option<usize>.none()
  let mut current = previous
  let mut terminates = false
  let mut exitKind = ExitKind.Normal
  let mut jump = Option<PointId>.none()
  let mut exitDepth = usize.ZERO
  match &node.kind {
    NodeKind.Expression {form, ..} => {
      current = run expression(prepared, &mut walk.*, id, &form, access, &mut inputs, &mut armInputs, previous)
      if let Expression.CompileError {..} = &form { terminates = true }
    }
    NodeKind.LocalBinding {local, initializer} => {
      walk.retention = bindingRetention(prepared, local)
      current = run input(prepared, &mut walk.*, &mut inputs, initializer, Access.Value, current)
      walk.retention = Retention.None
    }
    NodeKind.MutableBinding {local, initializer} => {
      walk.retention = bindingRetention(prepared, local)
      current = run input(prepared, &mut walk.*, &mut inputs, initializer, Access.Value, current)
      walk.retention = Retention.None
    }
    NodeKind.Assignment {local, value} => {
      current = run input(prepared, &mut walk.*, &mut inputs, value, Access.Value, current)
      prewrite = Option<usize>.some(List<OwnerExit>.length(&walk.reservation.ownerExits))
      current = run replacementCleanup(&mut walk.*, local, current, id)
    }
    NodeKind.PlaceAssignment {target, value} => {
      current = run input(prepared, &mut walk.*, &mut inputs, target, Access.Place, current)
      current = run input(prepared, &mut walk.*, &mut inputs, value, Access.Value, current)
      if let Option<LocalId>.Some {value: local} = replacementLocal(prepared, &walk.reservation, List<Input>.asSlice(&inputs)[0]) {
        prewrite = Option<usize>.some(List<OwnerExit>.length(&walk.reservation.ownerExits))
        current = run replacementCleanup(&mut walk.*, local, current, id)
      }
    }
    NodeKind.Drop {value, consumed} => {
      let mut mode = Access.Value
      if let Option<ConsumedPlace>.Some {..} = &consumed { mode = Access.Place }
      current = run input(prepared, &mut walk.*, &mut inputs, value, mode, current)
    }
    NodeKind.Return {value} => {
      if let Option<NodeId>.Some {value: operand} = &value {
        current = run input(prepared, &mut walk.*, &mut inputs, operand, Access.Value, current)
      }
      terminates = true
      exitKind = ExitKind.Return
      jump = Option<PointId>.some(walk.reservation.exit)
    }
    NodeKind.Fail {value} => {
      current = run input(prepared, &mut walk.*, &mut inputs, value, Access.Value, current)
      terminates = true
      exitKind = ExitKind.Failure
      jump = Option<PointId>.some(walk.reservation.exit)
    }
    NodeKind.Branch {condition, thenBranch, elseBranch, ..} => {
      let split = run settled(prepared, &mut walk.*, &mut inputs, condition, current)
      let taken = run input(prepared, &mut walk.*, &mut inputs, thenBranch, Access.Value, split)
      let mut other = split
      if let Option<NodeId>.Some {value} = &elseBranch {
        other = run input(prepared, &mut walk.*, &mut inputs, value, Access.Value, split)
      }
      current = run after(&mut walk.*, taken)
      run edge(&mut walk.*, other, current)
    }
    NodeKind.While {condition, body} => {
      let header = run after(&mut walk.*, current)
      let exit = run point(&mut walk.*)
      let repeat = List<Loop>.length(&walk.reservation.loops)
      run List<Loop>.append(&mut walk.reservation.loops, Loop {node: id, before: current,
        header: header, completed: header, exit: exit, backedges: List<PointId>.make()})
      // Preserve TRANSFER-001: a transfer in the condition addresses the enclosing frame.
      let split = run settled(prepared, &mut walk.*, &mut inputs, condition, header)
      let mut enters = true
      let mut skips = true
      if let NodeKind.Expression {form: Expression.Boolean {value}, ..} = &prepared.body.nodes[condition.index].kind {
        enters = value
        skips = !value
      }
      if skips { run edge(&mut walk.*, split, exit) }
      let start = run point(&mut walk.*)
      if enters { run edge(&mut walk.*, split, start) }
      run List<Frame>.append(&mut walk.frames, Frame {repeat: repeat, scopeDepth: List<ScopeId>.length(&walk.active)})
      // Even an impossible body is structurally reserved. It receives no runtime entry edge.
      let repeated = run input(prepared, &mut walk.*, &mut inputs, body, Access.Value, start)
      run edge(&mut walk.*, repeated, header)
      let loops = List<Loop>.asMutSlice(&mut walk.reservation.loops)
      loops[repeat].completed = repeated
      run List<PointId>.append(&mut loops[repeat].backedges, repeated)
      drop List<Frame>.pop(&mut walk.frames)
      current = exit
    }
    NodeKind.Break => {
      let frames = List<Frame>.asSlice(&walk.frames)
      if frames.length == usize.ZERO { return CompilerBug.panic(b"typed source break has no loop frame") }
      let frame = frames[frames.length - usize.ONE]
      jump = Option<PointId>.some(List<Loop>.asSlice(&walk.reservation.loops)[frame.repeat].exit)
      exitDepth = frame.scopeDepth
      exitKind = ExitKind.Break
      terminates = true
    }
    NodeKind.Continue => {
      let frames = List<Frame>.asSlice(&walk.frames)
      if frames.length == usize.ZERO { return CompilerBug.panic(b"typed source continue has no loop frame") }
      let frame = frames[frames.length - usize.ONE]
      jump = Option<PointId>.some(List<Loop>.asSlice(&walk.reservation.loops)[frame.repeat].header)
      exitDepth = frame.scopeDepth
      exitKind = ExitKind.Continue
      terminates = true
    }
    NodeKind.Recovered {resumes} => {
      // Recovery never certifies. Its isolated suffix still gets ownership diagnostics exactly
      // as the accepted checker does; no failed statement transports prior source definitions.
      current = run point(&mut walk.*)
      if resumes { run edge(&mut walk.*, walk.reservation.entry, current) }
    }
    NodeKind.Block {statements, ..} => {
      let enclosing = List<ScopeId>.length(&walk.active)
      run openScope(&mut walk.*, id, ScopeKind.Block)
      let values = List<NodeId>.asSlice(&statements)
      let mut at = usize.ZERO
      while at < values.length {
        current = run settled(prepared, &mut walk.*, &mut inputs, values[at], current)
        at = at + usize.ONE
      }
      current = run closeScopes(&mut walk.*, enclosing, current, id, ExitKind.Normal)
      List<ScopeId>.truncate(&mut walk.active, enclosing)
    }
  }
  let execute = run after(&mut walk.*, current)
  let mut successful = execute
  let mut displaced = Option<EvalId>.none()
  if let NodeKind.Expression {form: Expression.StorageCall {operation, ..}, ..} = &node.kind {
    if operation == StorageOperation.Replace {
      displaced = Option<EvalId>.some(run Skeleton.evaluate(&mut walk.reservation.skeleton, id, EvaluationRole.Replacement, execute))
      successful = run after(&mut walk.*, execute)
    }
  }
  if neverValue(node) || impossibleIndex(prepared, id) { successful = run point(&mut walk.*) }
  let evaluation = run Skeleton.evaluate(&mut walk.reservation.skeleton, id, EvaluationRole.Value, successful)
  let encountered = List<Option<EvalId>>.asMutSlice(&mut walk.encounters)
  encountered[encounter] = Option<EvalId>.some(evaluation)
  match &node.kind {
    NodeKind.LocalBinding {local, ..} => { drop run registerOwner(&mut walk.*, OwnerRoot.Local {local: local}, execute, true) }
    NodeKind.MutableBinding {local, ..} => { drop run registerOwner(&mut walk.*, OwnerRoot.Local {local: local}, execute, true) }
    _ => ()
  }
  if access == Access.Place && needsTemporary(&node.kind) {
    let owner = run registerOwner(&mut walk.*, OwnerRoot.Temporary {evaluation: evaluation}, successful, walk.retention != Retention.None)
    let mut expires = walk.retention == Retention.Storage
    if walk.retention == Retention.Arrays {
      let array = match &node.kind {
        NodeKind.Expression {ty, ..} => Shared<Type>.with<bool>(&ty, fn(value: &Type) -> bool {
          return match &value.* { Type.Array {..} => true _ => false }
        })
        _ => false
      }
      expires = !array
    }
    if expires {
      let active = List<ScopeId>.asSlice(&walk.active)
      let scope = active[active.length - usize.ONE]
      let scopes = List<Scope>.asMutSlice(&mut walk.reservation.scopes)
      run List<OwnerId>.append(&mut scopes[scope.index].expiring, owner)
    }
  }
  let active = List<ScopeId>.asSlice(&walk.active)
  if active.length == usize.ZERO { return CompilerBug.panic(b"source occurrence has no lexical scope") }
  let visitIndex = List<Visit>.length(&walk.reservation.visits)
  run List<Visit>.append(&mut walk.reservation.visits, Visit {node: id, entry: previous, evaluation: evaluation,
    execute: execute, completed: successful, displaced: move displaced, prewrite: move prewrite, access: access, scope: active[active.length - usize.ONE], inputs: move inputs, armInputs: move armInputs})
  // Fixed ownership construction order follows this actual completion encounter. Runtime
  // activity and all backedge definition/read pairs remain properties of the shared Flow.
  run Skeleton.constructionOccurrence(&mut walk.reservation.skeleton, evaluation,
    List<PendingDispatch>.length(&walk.dispatch) + usize.ONE)
  run List<PendingDispatch>.append(&mut walk.dispatch, PendingDispatch.Finish {occurrence: encounter})
  drop List<usize>.pop(&mut walk.visiting)
  if let NodeKind.Expression {form: Expression.Run {..}, ..} = &node.kind {
    let failed = run closeScopes(&mut walk.*, usize.ZERO, execute, id, ExitKind.RunFailure)
    run edge(&mut walk.*, failed, walk.reservation.exit)
  }
  if terminates {
    let cleaned = run closeScopes(&mut walk.*, exitDepth, execute, id, exitKind)
    let completedVisits = List<Visit>.asMutSlice(&mut walk.reservation.visits)
    completedVisits[visitIndex].completed = cleaned
    run List<PendingDispatch>.append(&mut walk.dispatch, PendingDispatch.TransferComplete {occurrence: encounter})
    if let Option<PointId>.Some {value} = jump {
      run edge(&mut walk.*, cleaned, value)
      if exitKind == ExitKind.Continue {
        let frames = List<Frame>.asSlice(&walk.frames)
        let repeat = frames[frames.length - usize.ONE].repeat
        let loops = List<Loop>.asMutSlice(&mut walk.reservation.loops)
        run List<PointId>.append(&mut loops[repeat].backedges, cleaned)
      }
    }
    return Completed {evaluation: evaluation, next: run point(&mut walk.*)}
  }
  return Completed {evaluation: evaluation, next: successful}
}

fn bindingRetention<'body>(prepared: &SourcePreparation<'body>, local: LocalId) -> Retention {
  if local.index >= prepared.body.locals.length { return CompilerBug.panic(b"source binding has no declared local type") }
  let ty = &prepared.body.locals[local.index].ty
  if Shared<Type>.with<bool>(ty, Type.holdsView) { return Retention.Arrays }
  if Type.hasOpenRuntimeParameters(ty) { return Retention.Storage }
  return Retention.None
}

fn neverValue(node: &Node) -> bool {
  return match &node.kind {
    NodeKind.Expression {ty, ..} => Shared<Type>.with<bool>(&ty, fn(ty: &Type) -> bool {
      return match &ty.* { Type.Union {members} => List<Shared<Type>>.length(&members) == usize.ZERO _ => false }
    })
    _ => false
  }
}

// Positive frozen layout evidence only. A raw pointer or unknown-length slice is not Array(0).
fn impossibleIndex<'body>(prepared: &SourcePreparation<'body>, node: NodeId) -> bool {
  let base = match &prepared.body.nodes[node.index].kind {
    NodeKind.Expression {form: Expression.Index {value, ..}, ..} => value.index
    _ => usize.MAX
  }
  if base == usize.MAX { return false }
  let endpoints = List<Endpoint>.asSlice(&prepared.endpoints)
  let shapes = List<Shape>.asSlice(&prepared.shapes)
  let mut at = usize.ZERO
  while at < endpoints.length {
    let actual = match &endpoints[at].root {
      Root.Node {node: found, category} => found.index == base && category == EndpointRole.Value
      _ => false
    }
    let root = match endpoints[at].parent { Option<EndpointId>.None => true _ => false }
    if actual && root {
      if endpoints[at].shape.index >= shapes.length { return CompilerBug.panic(b"source index has no prepared shape") }
      return match &shapes[endpoints[at].shape.index].state { ShapeState.Array {length} => length == usize.ZERO _ => false }
    }
    at = at + usize.ONE
  }
  return CompilerBug.panic(b"source index has no prepared operand root")
}

// Exhaustive typed expression traversal. Descriptor recipes and selected contracts are metadata,
// not extra operand executions; pattern uses refer to the one earlier subject occurrence.
effect fn expression<'body>(prepared: &SourcePreparation<'body>, walk: &mut Walk, id: NodeId, form: &Expression,
  access: Access, inputs: &mut List<Input>, armInputs: &mut List<ArmResult>, previous: PointId) -> PointId ! OutOfMemoryError ? &mut Allocator {
  return match &form.* {
    Expression.Integer {..} => previous
    Expression.Float {..} => previous
    Expression.Text {..} => previous
    Expression.Boolean {..} => previous
    Expression.Unit => previous
    Expression.Local {..} => previous
    Expression.Embedded {..} => previous
    Expression.Constant {..} => previous
    Expression.ForeignStatic {..} => previous
    Expression.ForeignAddress {..} => previous
    Expression.EnumMember {..} => previous
    Expression.PatternBinding {subject, ..} => {
      // A use/definition addresses the previously evaluated subject; it must not reevaluate
      // the subject expression (and cannot infer its identity from a type or region).
      let subjects = List<Subject>.asSlice(&walk.reservation.subjects)
      let active = List<ScopeId>.asSlice(&walk.active)
      let mut at = subjects.length
      while at > usize.ZERO {
        at = at - usize.ONE
        if subjects[at].node.index == subject.index {
          let mut scope = usize.ZERO
          while scope < active.length {
            if subjects[at].scope.index == active[scope].index {
              let used = run after(&mut walk.*, previous)
              run List<Input>.append(&mut inputs.*, Input {node: subject, evaluation: subjects[at].evaluation,
                usePoint: used, completed: used, access: Access.Place, read: Option<InputRead>.none()})
              run completeInput(&mut walk.*, List<Input>.length(&inputs.*))
              return used
            }
            scope = scope + usize.ONE
          }
        }
      }
      return CompilerBug.panic(b"pattern source has no actual evaluated subject in its scope")
    }
    Expression.Borrow {value, ..} => run input(prepared, &mut walk.*, &mut inputs.*, value, Access.Place, previous)
    Expression.Field {value, ..} => run input(prepared, &mut walk.*, &mut inputs.*, value, Access.Place, previous)
    Expression.Index {value, index, ..} => {
      let base = run input(prepared, &mut walk.*, &mut inputs.*, value, Access.Place, previous)
      return run input(prepared, &mut walk.*, &mut inputs.*, index, Access.Value, base)
    }
    Expression.Dereference {value} => run input(prepared, &mut walk.*, &mut inputs.*, value, Access.Value, previous)
    Expression.Move {value, consumed} => {
      let mut mode = Access.Value
      if let Option<ConsumedPlace>.Some {..} = &consumed { mode = Access.Place }
      return run input(prepared, &mut walk.*, &mut inputs.*, value, mode, previous)
    }
    Expression.PointerWeaken {value} => run input(prepared, &mut walk.*, &mut inputs.*, value, Access.Value, previous)
    Expression.ArraySlice {value, ..} => run input(prepared, &mut walk.*, &mut inputs.*, value, Access.Value, previous)
    Expression.SliceLength {value} => run input(prepared, &mut walk.*, &mut inputs.*, value, Access.Value, previous)
    Expression.ArrayLength {value, ..} => run input(prepared, &mut walk.*, &mut inputs.*, value, Access.Value, previous)
    Expression.ArrayRepeat {value, count} => {
      if count != usize.ZERO {
        return run input(prepared, &mut walk.*, &mut inputs.*, value, Access.Value, previous)
      }
      // Even an empty repeat evaluates and disposes its operand. Capture the owned value
      // separately from a local/projection's address: ending this copy must not end its source.
      let depth = List<ScopeId>.length(&walk.active)
      run openScope(&mut walk.*, id, ScopeKind.Statement)
      let saved = walk.retention
      walk.retention = Retention.None
      let used = run input(prepared, &mut walk.*, &mut inputs.*, value, Access.Value, previous)
      walk.retention = saved
      let actual = List<Input>.asSlice(&inputs.*)[usize.ZERO]
      let snapshot = run Skeleton.evaluate(&mut walk.reservation.skeleton, value, EvaluationRole.Binding, used)
      run Skeleton.constructionOccurrence(&mut walk.reservation.skeleton, snapshot,
        List<PendingDispatch>.length(&walk.dispatch))
      let scope = List<ScopeId>.asSlice(&walk.active)[depth]
      drop run registerOwner(&mut walk.*, OwnerRoot.Subject {node: value, evaluation: snapshot}, used, false)
      run List<Subject>.append(&mut walk.reservation.subjects, Subject {site: id, node: value,
        source: actual.evaluation, evaluation: snapshot, scope: scope, owned: true, consumes: false})
      let ended = run closeScopes(&mut walk.*, depth, used, id, ExitKind.Normal)
      List<ScopeId>.truncate(&mut walk.active, depth)
      run settleInput(&mut walk.*, &mut inputs.*, ended)
      return ended
    }
    Expression.EnumValue {value} => run input(prepared, &mut walk.*, &mut inputs.*, value, Access.Value, previous)
    Expression.UnionInject {value, ..} => run input(prepared, &mut walk.*, &mut inputs.*, value, Access.Value, previous)
    Expression.UnionWiden {value} => run input(prepared, &mut walk.*, &mut inputs.*, value, Access.Value, previous)
    Expression.CompileError {message} => run input(prepared, &mut walk.*, &mut inputs.*, message, Access.Value, previous)
    Expression.ConcretePrefix {operand, ..} => run input(prepared, &mut walk.*, &mut inputs.*, operand, Access.Value, previous)
    Expression.ConcreteInfix {operator, left, right} => {
      let first = run input(prepared, &mut walk.*, &mut inputs.*, left, Access.Value, previous)
      if operator == InfixOperator.And || operator == InfixOperator.Or {
        let second = run settled(prepared, &mut walk.*, &mut inputs.*, right, first)
        let joined = run after(&mut walk.*, second)
        run edge(&mut walk.*, first, joined)
        return joined
      }
      return run input(prepared, &mut walk.*, &mut inputs.*, right, Access.Value, first)
    }
    Expression.Aggregate {fields: values, ..} => run fields(prepared, &mut walk.*, &mut inputs.*, id, List<AggregateField>.asSlice(&values), previous)
    Expression.VariantConstruct {fields: values, ..} => run fields(prepared, &mut walk.*, &mut inputs.*, id, List<AggregateField>.asSlice(&values), previous)
    Expression.Callable {fields: values, ..} => run fields(prepared, &mut walk.*, &mut inputs.*, id, List<AggregateField>.asSlice(&values), previous)
    Expression.StagedCallable {callee, arguments, ..} => {
      let first = run selectedInput(prepared, &mut walk.*, &mut inputs.*, id, callee, InputRead.Receiver, previous)
      return run operands(prepared, &mut walk.*, &mut inputs.*, id, List<NodeId>.asSlice(&arguments), first)
    }
    Expression.CallableCall {callee, arguments, pipeline, ..} => {
      let supplied = List<NodeId>.asSlice(&arguments)
      let mut current = previous
      let mut first = usize.ZERO
      if pipeline && supplied.length > usize.ZERO {
        current = run selectedInput(prepared, &mut walk.*, &mut inputs.*, id, supplied[0], InputRead.Argument {ordinal: usize.ZERO}, current)
        first = usize.ONE
      }
      current = run selectedInput(prepared, &mut walk.*, &mut inputs.*, id, callee, InputRead.Receiver, current)
      while first < supplied.length {
        current = run selectedInput(prepared, &mut walk.*, &mut inputs.*, id, supplied[first], InputRead.Argument {ordinal: first}, current)
        first = first + usize.ONE
      }
      return current
    }
    Expression.DirectCall {arguments, ..} => run operands(prepared, &mut walk.*, &mut inputs.*, id, List<NodeId>.asSlice(&arguments), previous)
    Expression.InterfaceCall {arguments, ..} => run operands(prepared, &mut walk.*, &mut inputs.*, id, List<NodeId>.asSlice(&arguments), previous)
    Expression.ForeignCall {arguments, ..} => run operands(prepared, &mut walk.*, &mut inputs.*, id, List<NodeId>.asSlice(&arguments), previous)
    Expression.IntrinsicCall {arguments, ..} => run operands(prepared, &mut walk.*, &mut inputs.*, id, List<NodeId>.asSlice(&arguments), previous)
    Expression.StorageCall {operation, arguments, ..} => {
      let supplied = List<NodeId>.asSlice(&arguments)
      if operation == StorageOperation.Replace {
        if supplied.length != 2 { return CompilerBug.panic(b"typed replacement lost its place/value operands") }
        let addressed = run selectedAccess(prepared, &mut walk.*, &mut inputs.*, supplied[usize.ZERO],
          InputRead.Argument {ordinal: usize.ZERO}, Access.Place, previous)
        return run selectedInput(prepared, &mut walk.*, &mut inputs.*, id, supplied[usize.ONE],
          InputRead.Argument {ordinal: usize.ONE}, addressed)
      }
      return run operands(prepared, &mut walk.*, &mut inputs.*, id, supplied, previous)
    }
    Expression.Run {value, access: mode} => {
      let mut receiver = Access.Value
      if mode == RunAccess.Shared || mode == RunAccess.Exclusive { receiver = Access.Place }
      return run selectedAccess(prepared, &mut walk.*, &mut inputs.*, value, InputRead.Receiver, receiver, previous)
    }
    Expression.Match {subject, arms, access: mode, syntax, ..} => {
      let mut subjectMode = Access.Value
      if let SubjectAccess.Place {..} = &mode { subjectMode = Access.Place }
      if let SubjectAccess.Consume {consumed: Option<ConsumedPlace>.Some {..}} = &mode { subjectMode = Access.Place }
      let savedRetention = walk.retention
      if syntax == MatchSyntax.Let {
        if let SubjectAccess.Place {..} = &mode { walk.retention = Retention.Storage }
      }
      let evaluated = run visit(prepared, &mut walk.*, subject, subjectMode, previous)
      walk.retention = savedRetention
      let tested = run after(&mut walk.*, evaluated.next)
      run List<Input>.append(&mut inputs.*, Input {node: subject, evaluation: evaluated.evaluation,
        usePoint: tested, completed: tested, access: subjectMode, read: Option<InputRead>.none()})
      run completeInput(&mut walk.*, List<Input>.length(&inputs.*))
      let enclosing = List<ScopeId>.length(&walk.active)
      if syntax != MatchSyntax.Let { run openScope(&mut walk.*, id, ScopeKind.Match) }
      let active = List<ScopeId>.asSlice(&walk.active)
      let mut subjectScope = active[active.length - usize.ONE]
      if syntax == MatchSyntax.Let {
        // Destructuring-let subjects remain available to uses after this statement, in the
        // nearest enclosing ordinary scope; arm scopes never extend their owner's lifetime.
        let scopes = List<Scope>.asSlice(&walk.reservation.scopes)
        let mut enclosing = active.length
        while enclosing > usize.ZERO {
          enclosing = enclosing - usize.ONE
          if scopes[active[enclosing].index].kind != ScopeKind.Statement {
            subjectScope = active[enclosing]
            break
          }
        }
      }
      let owned = match &mode { SubjectAccess.Place {..} => false _ => true }
      let mut retained = evaluated.evaluation
      if owned {
        // A copied/moved subject has distinct storage, even when the source is a local.
        // Its identity is this acquisition, not the shared typed subject NodeId.
        retained = run Skeleton.evaluate(&mut walk.reservation.skeleton, subject, EvaluationRole.Binding, tested)
        run Skeleton.constructionOccurrence(&mut walk.reservation.skeleton, retained,
          List<PendingDispatch>.length(&walk.dispatch))
        drop run registerOwner(&mut walk.*, OwnerRoot.Subject {node: subject, evaluation: retained}, tested, syntax == MatchSyntax.Let)
      }
      let consumes = match &mode {
        SubjectAccess.Consume {consumed: Option<ConsumedPlace>.Some {..}} => true
        _ => false
      }
      run List<Subject>.append(&mut walk.reservation.subjects, Subject {site: id, node: subject,
        source: evaluated.evaluation, evaluation: retained, scope: subjectScope, owned: owned, consumes: consumes})
      let joined = run point(&mut walk.*)
      let mut rejected = tested
      let values = List<MatchArm>.asSlice(&arms)
      let mut arm = usize.ZERO
      while arm < values.length {
        let depth = List<ScopeId>.length(&walk.active)
        if syntax != MatchSyntax.Let { run openScope(&mut walk.*, id, ScopeKind.Arm) }
        let entry = run after(&mut walk.*, rejected)
        let mut selected = entry
        let bindings = List<NodeId>.asSlice(&values[arm].bindings)
        let mut binding = usize.ZERO
        while binding < bindings.length {
          selected = run input(prepared, &mut walk.*, &mut inputs.*, bindings[binding], Access.Place, selected)
          binding = binding + usize.ONE
        }
        // Existing ownership coverage admits pattern failure independently of guard failure.
        // Pattern/case predicates remain paired source applicability, not guessed runtime tags.
        rejected = entry
        let mut guardInput = Option<usize>.none()
        if let Option<NodeId>.Some {value: guard} = &values[arm].guard {
          guardInput = Option<usize>.some(List<Input>.length(&inputs.*))
          selected = run settled(prepared, &mut walk.*, &mut inputs.*, guard, selected)
          let failed = run closeScopes(&mut walk.*, depth, selected, id, ExitKind.Normal)
          let next = run after(&mut walk.*, rejected)
          run edge(&mut walk.*, failed, next)
          rejected = next
        }
        let resultIndex = List<Input>.length(&inputs.*)
        let result = run input(prepared, &mut walk.*, &mut inputs.*, values[arm].result, Access.Value, selected)
        let ended = run closeScopes(&mut walk.*, enclosing, result, id, ExitKind.Normal)
        run List<ArmResult>.append(&mut armInputs.*, ArmResult {entry: entry, guard: guardInput,
          input: resultIndex, completed: ended})
        let visiting = List<usize>.asSlice(&walk.visiting)
        if visiting.length == usize.ZERO { CompilerBug.panic(b"source arm has no enclosing match occurrence") }
        run List<PendingDispatch>.append(&mut walk.dispatch, PendingDispatch.ArmComplete {
          occurrence: visiting[visiting.length - usize.ONE], arm: arm})
        run edge(&mut walk.*, ended, joined)
        List<ScopeId>.truncate(&mut walk.active, depth)
        arm = arm + usize.ONE
      }
      List<ScopeId>.truncate(&mut walk.active, enclosing)
      return joined
    }
  }
}

// Copies, selections and representation-preserving forwards keep their actual predecessor
// source even when the result is loan-free. Only a value-producing expression seeds a fresh
// empty value; an empty typed read is not permission to replace its reaching provenance.
fn producesValue(form: &Expression) -> bool {
  return match &form.* {
    Expression.Local {..} => false
    Expression.Field {..} => false
    Expression.Index {..} => false
    Expression.Dereference {..} => false
    Expression.PatternBinding {..} => false
    Expression.Move {..} => false
    Expression.PointerWeaken {..} => false
    Expression.EnumValue {..} => false
    Expression.ArraySlice {..} => false
    Expression.UnionInject {..} => false
    Expression.UnionWiden {..} => false
    Expression.Match {..} => false
    _ => true
  }
}

// Only a real place-forming use materializes an rvalue. A Local or projection denotes an
// existing place; selecting it must not create a replacement owner from its read value.
fn needsTemporary(kind: &NodeKind) -> bool {
  return match &kind.* {
    NodeKind.Expression {form, ..} => match &form {
      Expression.Local {..} => false
      Expression.Field {..} => false
      Expression.Index {..} => false
      Expression.Dereference {..} => false
      Expression.PatternBinding {..} => false
      _ => true
    }
    _ => false
  }
}

// Canonical whole-value storage does not depend on whether any source is a Loan. This stage
// installs entry definitions and every authored local read/replacement in the same skeleton;
// operation and boundary activation add their transfers before Builder.reserve emits equations.
effect fn activateLocalStorage<'body>(prepared: &SourcePreparation<'body>, reservation: &mut Reservation, yes: Atom) -> ()
! OutOfMemoryError ? &mut Allocator {
  let endpoints = List<Endpoint>.asSlice(&prepared.endpoints)
  let maps = List<SelectionMap>.asSlice(&prepared.maps)
  let absent = Program.atom(&mut reservation.skeleton.rules)
  // All subjects are structurally reserved already. Materialize each owned snapshot once;
  // later source/definition closure supplies its RHS, including loop-carried sources.
  let subjects = List<Subject>.asSlice(&reservation.subjects)
  let mut subject = usize.ZERO
  while subject < subjects.length {
    if subjects[subject].owned {
      let from = nodeRoot(endpoints, subjects[subject].node, EndpointRole.Value)
      let into = nodeRoot(endpoints, subjects[subject].node, EndpointRole.Storage)
      let placement = exactMap(maps, subjects[subject].node, from, into, MapKind.Place)
      run Skeleton.materialize(&mut reservation.skeleton, endpoints, maps, placement,
        subjects[subject].source, subjects[subject].evaluation, yes)
    }
    subject = subject + usize.ONE
  }
  let count = List<Evaluation>.length(&reservation.skeleton.evaluations)
  let mut at = usize.ZERO
  while at < count {
    let evaluation = List<Evaluation>.asSlice(&reservation.skeleton.evaluations)[at]
    if let EvaluationSite.Entry {local} = evaluation.site {
      let root = localRoot(endpoints, local)
      let mut component = usize.ZERO
      while component < endpoints.length {
        if inlineComponent(prepared, root, EndpointId {index: component}) {
          let endpoint = EndpointId {index: component}
          let value = run Skeleton.value(&mut reservation.skeleton, EvalId {index: at}, endpoint)
          let leaf = run Skeleton.leaf(&mut reservation.skeleton, Leaf {kind: SourceLeaf.Entry {local: local},
            origin: prepared.body.locals[local.index].origin, endpoint: endpoint})
          run List<Seed>.append(&mut reservation.skeleton.seeds, Seed {value: value, leaf: leaf,
            direct: false, active: yes, stored: absent, alternatives: absent})
          drop run Skeleton.define(&mut reservation.skeleton, evaluation.point, EvalId {index: at}, Storage {endpoint: endpoint, temporary: Option<EvalId>.none()}, value, yes, Write.Strong)
        }
        component = component + usize.ONE
      }
    }
    at = at + usize.ONE
  }
  let visits = List<Visit>.asSlice(&reservation.visits)
  at = usize.ZERO
  while at < visits.length {
    let occurrence = &visits[at]
    let inputs = List<Input>.asSlice(&occurrence.inputs)
    if let NodeKind.Expression {form, ..} = &prepared.body.nodes[occurrence.node.index].kind {
      let endpoint = nodeRoot(endpoints, occurrence.node, EndpointRole.Value)
      let shapes = List<Shape>.asSlice(&prepared.shapes)
      if endpoints[endpoint.index].shape.index >= shapes.length { CompilerBug.panic(b"expression source has no prepared shape") }
      let empty = match &shapes[endpoints[endpoint.index].shape.index].state {
        ShapeState.KnownEmpty => true
        ShapeState.Array {length} => length == usize.ZERO
        _ => false
      }
      // A newly constructed descriptor has a real producer identity in addition to its
      // independently placed fields. This root supports later selected-application routing;
      // it says nothing about child contents and is not copied into them. Whole-value source
      // queries continue to use their prepared component frontier.
      let constructed = match &form {
        Expression.Aggregate {..} => true
        Expression.VariantConstruct {..} => true
        Expression.Callable {..} => true
        Expression.StagedCallable {..} => true
        Expression.ArrayRepeat {..} => true
        _ => false
      }
      if !empty && constructed {
        let value = run Skeleton.value(&mut reservation.skeleton, occurrence.evaluation, endpoint)
        let leaf = run Skeleton.leaf(&mut reservation.skeleton, Leaf {kind: SourceLeaf.Expression {node: occurrence.node},
          origin: prepared.body.nodes[occurrence.node.index].origin, endpoint: endpoint})
        run List<Seed>.append(&mut reservation.skeleton.seeds, Seed {value: value, leaf: leaf,
          direct: false, active: yes, stored: absent, alternatives: absent})
      }
      if empty && producesValue(&form) {
        // Positive layout emptiness is an actual definition. It is not inferred from absence
        // of loans or missing sources, and never supplies any noninline Referent contents.
        let value = run Skeleton.value(&mut reservation.skeleton, occurrence.evaluation, endpoint)
        let leaf = run Skeleton.leaf(&mut reservation.skeleton, Leaf {kind: SourceLeaf.LoanFree {node: occurrence.node},
          origin: prepared.body.nodes[occurrence.node.index].origin, endpoint: endpoint})
        run List<Seed>.append(&mut reservation.skeleton.seeds, Seed {value: value, leaf: leaf,
          direct: false, active: yes, stored: absent, alternatives: absent})
      }
    }
    if occurrence.access == Access.Place && needsTemporary(&prepared.body.nodes[occurrence.node.index].kind) {
      let from = nodeRoot(endpoints, occurrence.node, EndpointRole.Value)
      let into = nodeRoot(endpoints, occurrence.node, EndpointRole.Storage)
      let placement = exactMap(maps, occurrence.node, from, into, MapKind.Place)
      run Skeleton.materialize(&mut reservation.skeleton, endpoints, maps, placement, occurrence.evaluation, occurrence.evaluation, yes)
    }
    match &prepared.body.nodes[occurrence.node.index].kind {
      NodeKind.Expression {form: Expression.Local {local}, ..} => {
        let source = localRoot(endpoints, local)
        let target = nodeRoot(endpoints, occurrence.node, EndpointRole.Value)
        let map = exactMap(maps, occurrence.node, source, target, MapKind.Copy)
        // Place access needs the actual stored sources for a subsequent borrow/projection,
        // but it is not thereby an ownership Read event; that distinction stays in Visit.
        drop run Skeleton.readLocal(&mut reservation.skeleton, endpoints, maps, map, occurrence.evaluation, local)
        let storage = nodeRoot(endpoints, occurrence.node, EndpointRole.Storage)
        let alias = exactMap(maps, occurrence.node, source, storage, MapKind.Select)
        run Skeleton.localAliases(&mut reservation.skeleton, endpoints, maps, alias, occurrence.evaluation, local)
      }
      NodeKind.Expression {form: Expression.Move {value, consumed}, ..} => {
        let mut storage = false
        if let Option<ConsumedPlace>.Some {..} = &consumed { storage = true }
        run forwardedValue(prepared, &mut reservation.skeleton, occurrence, value, storage,
          Option<usize>.none(), yes)
        if storage { run consumedStorage(prepared, &mut reservation.skeleton, occurrence, value, yes) }
      }
      NodeKind.Expression {form: Expression.PointerWeaken {value}, ..} => {
        run forwardedValue(prepared, &mut reservation.skeleton, occurrence, value, false,
          Option<usize>.none(), yes)
      }
      NodeKind.Expression {form: Expression.EnumValue {value}, ..} => {
        run forwardedValue(prepared, &mut reservation.skeleton, occurrence, value, false,
          Option<usize>.none(), yes)
      }
      NodeKind.Expression {form: Expression.ArraySlice {value, ..}, ..} => {
        let rows = List<ArraySlice>.asSlice(&prepared.arraySlices)
        let mut selected = usize.MAX
        let mut row = usize.ZERO
        while row < rows.length {
          if rows[row].site.index == occurrence.node.index {
            if selected != usize.MAX { CompilerBug.panic(b"array slice occurrence has duplicate conversion records") }
            selected = row
          }
          row = row + usize.ONE
        }
        if selected == usize.MAX { CompilerBug.panic(b"typed array slice has no exact conversion maps") }
        if inputs.length != usize.ONE || inputs[usize.ZERO].node.index != value.index {
          CompilerBug.panic(b"array slice lost its actual descriptor operand occurrence")
        }
        run Skeleton.arraySlice(&mut reservation.skeleton, prepared, &rows[selected], inputs[usize.ZERO].evaluation,
          occurrence.evaluation, yes)
      }
      NodeKind.Expression {form: Expression.ArrayRepeat {value, count: repeatedCount}, ..} => {
        run repeatValues(prepared, &mut reservation.skeleton, occurrence, value, repeatedCount, yes)
      }
      NodeKind.Expression {form: Expression.StorageCall {operation: storageOperation, ..}, ..} if storageOperation == StorageOperation.Replace => {
        let rows = List<Replacement>.asSlice(&prepared.replacements)
        let mut selected = usize.MAX
        let mut row = usize.ZERO
        while row < rows.length {
          if rows[row].site.index == occurrence.node.index {
            if selected != usize.MAX { CompilerBug.panic(b"replacement occurrence has duplicate prepared records") }
            selected = row
          }
          row = row + usize.ONE
        }
        if selected == usize.MAX { CompilerBug.panic(b"typed replacement has no exact prepared maps") }
        if inputs.length != 2 || inputs[usize.ZERO].access != Access.Place {
          CompilerBug.panic(b"replacement lost its actual destination address or RHS occurrence")
        }
        let read = match &occurrence.displaced {
          Option<EvalId>.Some {value} => value
          _ => { return CompilerBug.panic(b"replacement has no distinct displaced-read occurrence") }
        }
        run Skeleton.replace(&mut reservation.skeleton, prepared, &rows[selected], inputs[usize.ZERO].evaluation,
          inputs[usize.ONE].evaluation, read, occurrence.evaluation, yes)
        run throughFlights(prepared, &mut reservation.skeleton, visits, subjects, occurrence, yes)
      }
      NodeKind.Expression {form: Expression.UnionWiden {value}, ..} => {
        // Only the exact producer-paired children move. The root map has no generic
        // component authority and newly admitted target variants receive no source.
        run forwardedValue(prepared, &mut reservation.skeleton, occurrence, value, false,
          Option<usize>.none(), yes)
      }
      NodeKind.Expression {form: Expression.UnionInject {value, tag}, ..} => {
        run forwardedValue(prepared, &mut reservation.skeleton, occurrence, value, false,
          Option<usize>.some(tag), yes)
      }
      NodeKind.Expression {form: Expression.Aggregate {fields, construction, ..}, ..} => {
        if let Option<SourceConstruction>.None = &construction {
          run aggregateValues(prepared, &mut reservation.skeleton, occurrence,
            List<AggregateField>.asSlice(&fields), usize.MAX, yes)
        }
      }
      NodeKind.Expression {form: Expression.VariantConstruct {fields, tag}, ..} => {
        run aggregateValues(prepared, &mut reservation.skeleton, occurrence,
          List<AggregateField>.asSlice(&fields), tag, yes)
      }
      NodeKind.Expression {form: Expression.Callable {fields, ..}, ..} => {
        // A prepared construction owns its exact Copy/Move/Borrow route, including the
        // paired referent of an implicit capture borrow. Do not also copy its plain fields.
        if !preparedConstruction(prepared, occurrence.node) {
          run aggregateValues(prepared, &mut reservation.skeleton, occurrence,
            List<AggregateField>.asSlice(&fields), usize.MAX, yes)
        }
      }
      NodeKind.Expression {form: Expression.Match {arms, ..}, ..} => {
        run matchValues(prepared, &mut reservation.skeleton, occurrence, List<MatchArm>.asSlice(&arms), yes)
      }
      NodeKind.Expression {form: Expression.PatternBinding {..}, ..} => {
        run projection(prepared, &mut reservation.skeleton, occurrence, yes)
        if occurrence.access == Access.Value {
          run throughFlights(prepared, &mut reservation.skeleton, visits, subjects, occurrence, yes)
        }
      }
      NodeKind.Expression {form: Expression.Field {..}, ..} => {
        run projection(prepared, &mut reservation.skeleton, occurrence, yes)
        if occurrence.access == Access.Value {
          run throughFlights(prepared, &mut reservation.skeleton, visits, subjects, occurrence, yes)
        }
      }
      NodeKind.Expression {form: Expression.Index {..}, ..} => {
        run projection(prepared, &mut reservation.skeleton, occurrence, yes)
        if occurrence.access == Access.Value {
          run throughFlights(prepared, &mut reservation.skeleton, visits, subjects, occurrence, yes)
        }
      }
      NodeKind.Expression {form: Expression.Dereference {..}, ..} => {
        run projection(prepared, &mut reservation.skeleton, occurrence, yes)
        if occurrence.access == Access.Value {
          run throughFlights(prepared, &mut reservation.skeleton, visits, subjects, occurrence, yes)
        }
      }
      NodeKind.Drop {value, consumed} => {
        if let Option<ConsumedPlace>.Some {..} = &consumed {
          run consumedStorage(prepared, &mut reservation.skeleton, occurrence, value, yes)
        }
      }
      NodeKind.PlaceAssignment {target, value} => {
        if inputs.length != 2 || inputs[0].node.index != target.index || inputs[1].node.index != value.index {
          CompilerBug.panic(b"projected replacement lost actual address/RHS evaluation order")
        }
        let from = nodeRoot(endpoints, value, EndpointRole.Value)
        let into = nodeRoot(endpoints, target, EndpointRole.Storage)
        let placement = exactMap(maps, occurrence.node, from, into, MapKind.Place)
        run Skeleton.writeAliases(&mut reservation.skeleton, endpoints, maps, placement,
          inputs[1].evaluation, inputs[0].evaluation, occurrence.evaluation, yes)
        let execution = run Skeleton.execution(&mut reservation.skeleton, occurrence.evaluation, occurrence.execute)
        run Skeleton.fieldRehold(&mut reservation.skeleton, prepared, placement,
          inputs[1].evaluation, inputs[0].evaluation, execution, occurrence.evaluation, yes)
        run throughFlights(prepared, &mut reservation.skeleton, visits, subjects, occurrence, yes)
      }
      NodeKind.LocalBinding {local, initializer} => {
        run localReplacement(prepared, &mut reservation.skeleton, occurrence, inputs, local, initializer, yes)
      }
      NodeKind.MutableBinding {local, initializer} => {
        run localReplacement(prepared, &mut reservation.skeleton, occurrence, inputs, local, initializer, yes)
      }
      NodeKind.Assignment {local, value} => {
        run localReplacement(prepared, &mut reservation.skeleton, occurrence, inputs, local, value, yes)
      }
      _ => ()
    }
    at = at + usize.ONE
  }
  // Alias construction is complete before consumption is attached, but the definition is
  // placed at the original subject acquisition point, before every guard/arm. Its copied
  // snapshot retains the earlier actual read; later reads of the moved source are unknown.
  subject = usize.ZERO
  while subject < subjects.length {
    if subjects[subject].consumes {
      let storage = nodeRoot(endpoints, subjects[subject].node, EndpointRole.Storage)
      run Skeleton.invalidateAliases(&mut reservation.skeleton, endpoints, subjects[subject].source,
        storage, subjects[subject].evaluation, prepared.body.nodes[subjects[subject].site.index].origin, yes)
    }
    subject = subject + usize.ONE
  }
  return ()
}

// Walk the already executed first-operand chain backwards. Replacing the selected crossing
// on each step finds the root-nearest Dereference/Slice, not the outermost projection.
// Neither an index expression nor a retained match subject is evaluated again.
effect fn throughFlights<'body>(prepared: &SourcePreparation<'body>, skeleton: &mut Skeleton,
  visits: &[Visit], subjects: &[Subject], operation: &Visit, active: Atom) -> () ! OutOfMemoryError ? &mut Allocator {
  let inputs = List<Input>.asSlice(&operation.inputs)
  let writing = match &prepared.body.nodes[operation.node.index].kind {
    NodeKind.PlaceAssignment {..} => true
    NodeKind.Expression {form: Expression.StorageCall {operation: storageOperation, ..}, ..} if storageOperation == StorageOperation.Replace => true
    _ => false
  }
  if writing && inputs.length != 2 { return CompilerBug.panic(b"through operation lost its destination/RHS occurrences") }
  let target = match writing { bool writingInput if writingInput => inputs[0].evaluation _ => operation.evaluation }
  let endpoints = List<Endpoint>.asSlice(&prepared.endpoints)
  let shapes = List<Shape>.asSlice(&prepared.shapes)
  let mut current = target
  let mut selected = Option<ThroughDescriptor>.none()
  let mut complete = true
  let mut remaining = visits.length + subjects.length + usize.ONE
  while true {
    if remaining == usize.ZERO { return CompilerBug.panic(b"through operand occurrence chain is cyclic") }
    remaining = remaining - usize.ONE
    let mut retained = false
    let mut each = usize.ZERO
    while each < subjects.length {
      if subjects[each].evaluation.index == current.index && subjects[each].owned { retained = true }
      each = each + usize.ONE
    }
    // An owned subject is its own real canonical owner, not its earlier initializer.
    if retained { break }
    let mut found = usize.MAX
    each = usize.ZERO
    while each < visits.length {
      if visits[each].evaluation.index == current.index {
        if found != usize.MAX { return CompilerBug.panic(b"through path repeats an actual evaluation") }
        found = each
      }
      each = each + usize.ONE
    }
    if found == usize.MAX { complete = false break }
    let visit = &visits[found]
    let mut operand = Option<NodeId>.none()
    let mut crossing = false
    let mut pattern = false
    match &prepared.body.nodes[visit.node.index].kind {
      NodeKind.Expression {form: Expression.Field {value, ..}, ..} => { operand = Option<NodeId>.some(value) }
      NodeKind.Expression {form: Expression.Index {value, ..}, ..} => {
        operand = Option<NodeId>.some(value)
        let root = nodeRoot(endpoints, value, EndpointRole.Storage)
        match &shapes[endpoints[root.index].shape.index].state {
          ShapeState.Slice => { crossing = true }
          ShapeState.Array {..} => ()
          _ => { complete = false break }
        }
      }
      NodeKind.Expression {form: Expression.Dereference {value}, ..} => {
        operand = Option<NodeId>.some(value)
        let root = nodeRoot(endpoints, value, EndpointRole.Storage)
        let reference = match &shapes[endpoints[root.index].shape.index].state { ShapeState.Reference => true _ => false }
        if !reference { complete = false break }
        crossing = true
      }
      NodeKind.Expression {form: Expression.PatternBinding {subject, access, ..}, ..} => {
        // A borrowed binding's implicit descriptor needs its own producer authority.
        // Its subject's alias cannot stand in for that descriptor.
        if access == BindingAccess.Shared || access == BindingAccess.Exclusive { complete = false break }
        operand = Option<NodeId>.some(subject)
        pattern = true
      }
      _ => { break }
    }
    let selectedOperand = match operand { Option<NodeId>.Some {value} => value _ => { break } }
    let actual = List<Input>.asSlice(&visit.inputs)
    if actual.length == usize.ZERO || actual[0].node.index != selectedOperand.index {
      return CompilerBug.panic(b"through projection lost its actual first operand")
    }
    if pattern {
      let uses = List<SelectionUse>.asSlice(&skeleton.selections)
      let maps = List<SelectionMap>.asSlice(&prepared.maps)
      let mut authentic = false
      let mut each = usize.ZERO
      while each < uses.length {
        if uses[each].result.index == visit.evaluation.index && uses[each].operand.index == actual[0].evaluation.index {
          let selectors = List<MapId>.asSlice(&uses[each].selectors)
          let mut inline = true
          let mut step = usize.ZERO
          while step < selectors.length {
            let map = &maps[selectors[step].index]
            if !inlineComponent(prepared, map.source, map.target) { inline = false }
            step = step + usize.ONE
          }
          if inline { authentic = true }
        }
        each = each + usize.ONE
      }
      if !authentic { complete = false break }
    }
    if crossing {
      selected = Option<ThroughDescriptor>.some(ThroughDescriptor {evaluation: actual[0].evaluation,
        root: nodeRoot(endpoints, operand, EndpointRole.Storage), crossing: visit.evaluation})
    }
    current = actual[0].evaluation
  }
  if complete {
    if let Option<ThroughDescriptor>.None = selected { return () }
  } else { selected = Option<ThroughDescriptor>.none() }
  match &prepared.body.nodes[operation.node.index].kind {
    NodeKind.PlaceAssignment {..} => {
      let execution = run Skeleton.execution(&mut skeleton.*, operation.evaluation, operation.execute)
      run Skeleton.reserveThroughFlight(&mut skeleton.*, prepared, operation.evaluation, target, execution,
        ThroughFlightKind.Write, selected, active)
    }
    NodeKind.Expression {form: Expression.StorageCall {operation: storageOperation, ..}, ..} if storageOperation == StorageOperation.Replace => {
      let displaced = match operation.displaced { Option<EvalId>.Some {value} => value
        _ => { return CompilerBug.panic(b"through replacement lost its distinct read point") } }
      run Skeleton.reserveThroughFlight(&mut skeleton.*, prepared, operation.evaluation, target, displaced,
        ThroughFlightKind.Read, selected, active)
      run Skeleton.reserveThroughFlight(&mut skeleton.*, prepared, operation.evaluation, target, operation.evaluation,
        ThroughFlightKind.Write, selected, active)
    }
    NodeKind.Expression {form: Expression.PatternBinding {..}, ..} => {
      if operation.access != Access.Value { return CompilerBug.panic(b"through read observes an address-only visit") }
      run Skeleton.reserveThroughFlight(&mut skeleton.*, prepared, operation.evaluation, target, operation.evaluation,
        ThroughFlightKind.Read, selected, active)
    }
    NodeKind.Expression {form: Expression.Field {..}, ..} => {
      if operation.access != Access.Value { return CompilerBug.panic(b"through read observes an address-only visit") }
      run Skeleton.reserveThroughFlight(&mut skeleton.*, prepared, operation.evaluation, target, operation.evaluation,
        ThroughFlightKind.Read, selected, active)
    }
    NodeKind.Expression {form: Expression.Index {..}, ..} => {
      if operation.access != Access.Value { return CompilerBug.panic(b"through read observes an address-only visit") }
      run Skeleton.reserveThroughFlight(&mut skeleton.*, prepared, operation.evaluation, target, operation.evaluation,
        ThroughFlightKind.Read, selected, active)
    }
    NodeKind.Expression {form: Expression.Dereference {..}, ..} => {
      if operation.access != Access.Value { return CompilerBug.panic(b"through read observes an address-only visit") }
      run Skeleton.reserveThroughFlight(&mut skeleton.*, prepared, operation.evaluation, target, operation.evaluation,
        ThroughFlightKind.Read, selected, active)
    }
    _ => { return CompilerBug.panic(b"through flight is not a typed read or write operation") }
  }
  return ()
}

// Joining paths copy their actual returned component occurrences. A historical alternative
// is not another operand evaluation. Never select the last matching result NodeId: two arms
// may evaluate the same retained node, and only that arm's real CFG path activates its copy.
effect fn matchValues<'body>(prepared: &SourcePreparation<'body>, skeleton: &mut Skeleton,
  occurrence: &Visit, arms: &[MatchArm], active: Atom) -> () ! OutOfMemoryError ? &mut Allocator {
  let inputs = List<Input>.asSlice(&occurrence.inputs)
  let selected = List<ArmResult>.asSlice(&occurrence.armInputs)
  if selected.length != arms.length { CompilerBug.panic(b"match source lost an actual arm result coordinate") }
  let endpoints = List<Endpoint>.asSlice(&prepared.endpoints)
  let maps = List<SelectionMap>.asSlice(&prepared.maps)
  let output = nodeRoot(endpoints, occurrence.node, EndpointRole.Value)
  let absent = Program.atom(&mut skeleton.rules)
  let mut arm = usize.ZERO
  while arm < arms.length {
    if selected[arm].input >= inputs.length || inputs[selected[arm].input].node.index != arms[arm].result.index {
      CompilerBug.panic(b"match arm source names another result occurrence")
    }
    let actual = inputs[selected[arm].input]
    let reached = Flow.reachable(&skeleton.flow, selected[arm].completed)
    let gate = Program.atom(&mut skeleton.rules)
    let positive: [Atom; 2] = [active, reached]
    let empty = List<Atom>.make()
    run Program.rule(&mut skeleton.rules, gate, &positive, List<Atom>.asSlice(&empty))
    match &prepared.body.nodes[actual.node.index].kind {
      NodeKind.Expression {..} => {
        if !neverValue(&prepared.body.nodes[actual.node.index]) {
          let source = nodeRoot(endpoints, actual.node, EndpointRole.Value)
          let map = exactMap(maps, occurrence.node, source, output, MapKind.Copy)
          drop run Skeleton.transfer(&mut skeleton.*, endpoints, maps, map, actual.evaluation,
            occurrence.evaluation, gate, Directness.Preserve, absent, absent, TransferPolicy.Physical)
        }
      }
      NodeKind.Block {..} => {
        let shape = &List<Shape>.asSlice(&prepared.shapes)[endpoints[output.index].shape.index]
        if let ShapeState.KnownEmpty = &shape.state {
          let value = run Skeleton.value(&mut skeleton.*, occurrence.evaluation, output)
          let leaf = run Skeleton.leaf(&mut skeleton.*, Leaf {kind: SourceLeaf.LoanFree {node: actual.node},
            origin: prepared.body.nodes[actual.node.index].origin, endpoint: output})
          run List<Seed>.append(&mut skeleton.seeds, Seed {value: value, leaf: leaf,
            direct: false, active: gate, stored: absent, alternatives: absent})
        }
      }
      _ => { CompilerBug.panic(b"typed match arm is neither an expression nor a block") }
    }
    arm = arm + usize.ONE
  }
  return ()
}

// Only typing's actual consuming-place record reaches this operation. Rvalue moves/drops
// transport/finish their value; they do not clear some unrelated same-typed local storage.
effect fn consumedStorage<'body>(prepared: &SourcePreparation<'body>, skeleton: &mut Skeleton,
  occurrence: &Visit, operand: NodeId, active: Atom) -> () ! OutOfMemoryError ? &mut Allocator {
  let inputs = List<Input>.asSlice(&occurrence.inputs)
  if inputs.length != usize.ONE || inputs[0].node.index != operand.index || inputs[0].access != Access.Place {
    CompilerBug.panic(b"consuming operation lost its typed place occurrence")
  }
  let endpoints = List<Endpoint>.asSlice(&prepared.endpoints)
  let root = nodeRoot(endpoints, operand, EndpointRole.Storage)
  run Skeleton.invalidateAliases(&mut skeleton.*, endpoints, inputs[0].evaluation, root,
    occurrence.evaluation, prepared.body.nodes[occurrence.node.index].origin, active)
  return ()
}

// Representation-preserving unary transfers retain their actual predecessor, including
// LoanFree and Unknown. A consumed place reads at this operation before its destructive
// ownership action; it does not reuse an earlier cached contents snapshot of the address.
effect fn forwardedValue<'body>(prepared: &SourcePreparation<'body>, skeleton: &mut Skeleton,
  occurrence: &Visit, operand: NodeId, storage: bool, variant: Option<usize>, active: Atom) -> ()
! OutOfMemoryError ? &mut Allocator {
  let inputs = List<Input>.asSlice(&occurrence.inputs)
  if inputs.length != usize.ONE || inputs[0].node.index != operand.index {
    CompilerBug.panic(b"forwarded value lost its actual operand occurrence")
  }
  let endpoints = List<Endpoint>.asSlice(&prepared.endpoints)
  let maps = List<SelectionMap>.asSlice(&prepared.maps)
  let mut category = EndpointRole.Value
  if storage { category = EndpointRole.Storage }
  let source = nodeRoot(endpoints, operand, category)
  let mut target = nodeRoot(endpoints, occurrence.node, EndpointRole.Value)
  let mut kind = MapKind.Copy
  if let Option<usize>.Some {value: tag} = variant {
    target = exactChild(endpoints, target, &Selector.Variant {ordinal: tag})
    kind = MapKind.Place
  }
  let map = exactMap(maps, occurrence.node, source, target, kind)
  if storage {
    run Skeleton.readAliases(&mut skeleton.*, endpoints, maps, map,
      inputs[0].evaluation, occurrence.evaluation, active)
    let execution = run Skeleton.execution(&mut skeleton.*, occurrence.evaluation, occurrence.execute)
    run Skeleton.selectedMove(&mut skeleton.*, prepared, map, inputs[0].evaluation,
      execution, occurrence.evaluation, active)
  } else {
    let absent = Program.atom(&mut skeleton.rules)
    drop run Skeleton.transfer(&mut skeleton.*, endpoints, maps, map, inputs[0].evaluation,
      occurrence.evaluation, active, Directness.Preserve, absent, absent, TransferPolicy.Physical)
  }
  return ()
}

// The written fields vector supplies occurrence multiplicity; its destination coordinate
// selects one frozen map. Two fields evaluating the same NodeId remain two physical reads.
// This is construction holding only. Invocation result/storage policy is a separate consumer.
effect fn aggregateValues<'body>(prepared: &SourcePreparation<'body>, skeleton: &mut Skeleton,
  occurrence: &Visit, fields: &[AggregateField], variant: usize, active: Atom) -> ()
! OutOfMemoryError ? &mut Allocator {
  let endpoints = List<Endpoint>.asSlice(&prepared.endpoints)
  let maps = List<SelectionMap>.asSlice(&prepared.maps)
  let inputs = List<Input>.asSlice(&occurrence.inputs)
  let output = nodeRoot(endpoints, occurrence.node, EndpointRole.Value)
  let shape = &List<Shape>.asSlice(&prepared.shapes)[endpoints[output.index].shape.index]
  let array = match &shape.state { ShapeState.Array {..} => true _ => false }
  let absent = Program.atom(&mut skeleton.rules)
  let mut field = usize.ZERO
  while field < fields.length {
    let mut actual = usize.MAX
    let mut input = usize.ZERO
    while input < inputs.length {
      if let Option<InputRead>.Some {value: InputRead.Field {ordinal}} = inputs[input].read {
        if ordinal == field {
          if actual != usize.MAX || inputs[input].node.index != fields[field].value.index {
            CompilerBug.panic(b"aggregate field has no unique actual operand occurrence")
          }
          actual = input
        }
      }
      input = input + usize.ONE
    }
    if actual == usize.MAX { CompilerBug.panic(b"aggregate field lost its written evaluation") }
    let source = nodeRoot(endpoints, fields[field].value, EndpointRole.Value)
    let mut selected = usize.MAX
    let mut endpoint = usize.ZERO
    while endpoint < endpoints.length {
      let child = match endpoints[endpoint].parent {
        Option<EndpointId>.Some {value} => value.index == output.index
        _ => false
      }
      let placed = match &endpoints[endpoint].selector {
        Selector.Member {member, payload, ..} =>
          (variant != usize.MAX && member == variant && payload == fields[field].index)
          || (variant == usize.MAX && !array && member == fields[field].index && payload == usize.ZERO)
        Selector.Field {ordinal} => !array && variant == usize.MAX && ordinal == fields[field].index
        Selector.Index {class: IndexClass.Exact {index}} => array && index == fields[field].index
        _ => false
      }
      if child && placed {
        if selected != usize.MAX { CompilerBug.panic(b"aggregate placement has duplicate prepared components") }
        selected = endpoint
      }
      endpoint = endpoint + usize.ONE
    }
    if selected == usize.MAX { CompilerBug.panic(b"aggregate placement has no exact prepared component") }
    let map = exactMap(maps, occurrence.node, source, EndpointId {index: selected}, MapKind.Place)
    drop run Skeleton.transfer(&mut skeleton.*, endpoints, maps, map, inputs[actual].evaluation,
      occurrence.evaluation, active, Directness.Preserve, absent, absent, TransferPolicy.Physical)
    field = field + usize.ONE
  }
  return ()
}

// Repeat cardinality is not evaluation multiplicity. Each frozen partition holds the same
// actual operand result at its own physical endpoint; Remainder is one finite partition.
effect fn repeatValues<'body>(prepared: &SourcePreparation<'body>, skeleton: &mut Skeleton,
  occurrence: &Visit, operand: NodeId, count: usize, active: Atom) -> ()
! OutOfMemoryError ? &mut Allocator {
  let inputs = List<Input>.asSlice(&occurrence.inputs)
  if inputs.length != usize.ONE || inputs[0].node.index != operand.index || inputs[0].access != Access.Value {
    CompilerBug.panic(b"array repeat lost its single actual value operand")
  }
  let endpoints = List<Endpoint>.asSlice(&prepared.endpoints)
  let maps = List<SelectionMap>.asSlice(&prepared.maps)
  let source = nodeRoot(endpoints, operand, EndpointRole.Value)
  let output = nodeRoot(endpoints, occurrence.node, EndpointRole.Value)
  let shape = &List<Shape>.asSlice(&prepared.shapes)[endpoints[output.index].shape.index]
  let correct = match &shape.state { ShapeState.Array {length} => length == count _ => false }
  if !correct { CompilerBug.panic(b"array repeat has no exact frozen array extent") }
  let components = List<Component>.asSlice(&shape.components)
  let mut exact = usize.ZERO
  let mut remainder = false
  let mut partitions = List<EndpointId>.make()
  let mut at = usize.ZERO
  while at < components.length {
    if !components[at].inline { CompilerBug.panic(b"array repeat partition is not owned inline storage") }
    match &components[at].selector {
      Selector.Index {class: IndexClass.Exact {index}} => {
        if index >= count { CompilerBug.panic(b"array repeat has an out-of-bounds exact partition") }
        exact = exact + usize.ONE
      }
      Selector.Index {class: IndexClass.Remainder} => { remainder = true }
      _ => { CompilerBug.panic(b"array repeat has a non-index output partition") }
    }
    let mut previous = usize.ZERO
    while previous < at {
      if sameSelector(&components[previous].selector, &components[at].selector) {
        CompilerBug.panic(b"array repeat has a duplicate frozen partition")
      }
      previous = previous + usize.ONE
    }
    run List<EndpointId>.append(&mut partitions, exactChild(endpoints, output, &components[at].selector))
    at = at + usize.ONE
  }
  if (exact < count) != remainder || (count == usize.ONE && exact != usize.ONE) {
    CompilerBug.panic(b"array repeat frozen partitions do not cover its exact extent")
  }
  let partitionRows = List<EndpointId>.asSlice(&partitions)
  // Every actual direct child must belong to the shape, and every root family must name
  // exactly this operand and one such child. Descendant maps remain owned by children IDs.
  at = usize.ZERO
  while at < endpoints.length {
    let child = match endpoints[at].parent { Option<EndpointId>.Some {value} => value.index == output.index _ => false }
    if child {
      let mut found = false
      let mut part = usize.ZERO
      while part < partitionRows.length {
        found = found || partitionRows[part].index == at
        part = part + usize.ONE
      }
      let root = match &endpoints[at].root {
        Root.Node {node, category} => node.index == occurrence.node.index && category == EndpointRole.Value
        _ => false
      }
      if !found || !root { CompilerBug.panic(b"array repeat has an extraneous output component") }
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < maps.length {
    // Whole-value selection also has maps into these components. Those select an existing
    // output; only transport families can purport to place the repeated operand there.
    if maps[at].site.index == occurrence.node.index && maps[at].kind != MapKind.Select {
      let mut target = false
      let mut part = usize.ZERO
      while part < partitionRows.length {
        target = target || maps[at].target.index == partitionRows[part].index
        part = part + usize.ONE
      }
      if maps[at].source.index == source.index || target || maps[at].target.index == output.index {
        if maps[at].source.index != source.index || !target || maps[at].kind != MapKind.Place
          || !maps[at].componentTransport || !sameSelector(&maps[at].selector, &Selector.Identity) {
          CompilerBug.panic(b"array repeat has an extraneous or unauthenticated placement family")
        }
      }
    }
    at = at + usize.ONE
  }
  let absent = Program.atom(&mut skeleton.rules)
  at = usize.ZERO
  while at < partitionRows.length {
    let map = exactMap(maps, occurrence.node, source, partitionRows[at], MapKind.Place)
    drop run Skeleton.transfer(&mut skeleton.*, endpoints, maps, map, inputs[0].evaluation,
      occurrence.evaluation, active, Directness.Preserve, absent, absent, TransferPolicy.Physical)
    at = at + usize.ONE
  }
  return ()
}

fn exactChild(endpoints: &[Endpoint], parent: EndpointId, selector: &Selector) -> EndpointId {
  let mut found = usize.MAX
  let mut at = usize.ZERO
  while at < endpoints.length {
    let child = match endpoints[at].parent { Option<EndpointId>.Some {value} => value.index == parent.index _ => false }
    if child && sameSelector(&endpoints[at].selector, selector) {
      if found != usize.MAX { return CompilerBug.panic(b"source component has duplicate exact prepared identities") }
      found = at
    }
    at = at + usize.ONE
  }
  if found == usize.MAX { return CompilerBug.panic(b"source component has no prepared identity") }
  return EndpointId {index: found}
}

// Reserve actual selector uses before address/source closure. Inline and boundary selections
// share this path: a field below a dereference cannot eagerly see its eventual canonical alias.
// The operand is the recorded visit input (or retained pattern subject), never a NodeId lookup.
effect fn projection<'body>(prepared: &SourcePreparation<'body>, skeleton: &mut Skeleton,
  occurrence: &Visit, active: Atom) -> () ! OutOfMemoryError ? &mut Allocator {
  let inputs = List<Input>.asSlice(&occurrence.inputs)
  if inputs.length == usize.ZERO { CompilerBug.panic(b"typed projection lost its actual base evaluation") }
  let endpoints = List<Endpoint>.asSlice(&prepared.endpoints)
  let mut root = nodeRoot(endpoints, inputs[0].node, EndpointRole.Storage)
  let mut path = List<EndpointId>.make()
  let mut strength = Write.Strong
  match &prepared.body.nodes[occurrence.node.index].kind {
    NodeKind.Expression {form: Expression.Field {value, index, ..}, ..} => {
      if inputs.length != usize.ONE || inputs[0].node.index != value.index {
        CompilerBug.panic(b"field selection lost its actual typed operand")
      }
      run List<EndpointId>.append(&mut path, projectionField(endpoints, root, index, usize.MAX))
    }
    NodeKind.Expression {form: Expression.Dereference {value}, ..} => {
      if inputs.length != usize.ONE || inputs[0].node.index != value.index {
        CompilerBug.panic(b"dereference selection lost its actual descriptor operand")
      }
      root = nodeRoot(endpoints, value, EndpointRole.Value)
      run List<EndpointId>.append(&mut path, exactChild(endpoints, root, &Selector.Referent))
    }
    NodeKind.Expression {form: Expression.Index {value, index, element}, ..} => {
      if inputs.length != 2 || inputs[0].node.index != value.index || inputs[1].node.index != index.index {
        CompilerBug.panic(b"index selection lost its base/index operand order")
      }
      if element == usize.MAX { strength = Write.Weak }
      let shape = &List<Shape>.asSlice(&prepared.shapes)[endpoints[root.index].shape.index]
      let slice = match &shape.state { ShapeState.Slice => true _ => false }
      if slice { root = nodeRoot(endpoints, value, EndpointRole.Value) }
      let components = List<Component>.asSlice(&shape.components)
      let mut selected = usize.ZERO
      let mut at = usize.ZERO
      while at < components.length {
        let matches = match &components[at].selector {
          Selector.Index {class: IndexClass.Exact {index: ordinal}} => element == usize.MAX || element == ordinal
          Selector.Index {class: IndexClass.Remainder} => slice || element == usize.MAX
          _ => false
        }
        if matches {
          let mut part = List<EndpointId>.make()
          run List<EndpointId>.append(&mut part, exactChild(endpoints, root, &components[at].selector))
          run selectionUse(prepared, &mut skeleton.*, occurrence, root, List<EndpointId>.asSlice(&part), strength, active)
          selected = selected + usize.ONE
        }
        at = at + usize.ONE
      }
      // Only an actual Array(0) has no successful partition. A Count0 conversion is one
      // reaching slice case, and cannot suppress this use's other possible descriptor cases.
      if selected == usize.ZERO && !impossibleIndex(prepared, occurrence.node) {
        CompilerBug.panic(b"index selection has no exact prepared partition")
      }
      return ()
    }
    NodeKind.Expression {form: Expression.PatternBinding {subject, path: steps, ..}, ..} => {
      if inputs.length != usize.ONE || inputs[0].node.index != subject.index {
        CompilerBug.panic(b"pattern selection lost its retained subject occurrence")
      }
      let steps = List<PlaceStep>.asSlice(&steps)
      let mut parent = root
      let mut at = usize.ZERO
      while at < steps.length {
        let child = match &steps[at] {
          PlaceStep.Member {tag, ..} => exactChild(endpoints, parent, &Selector.Variant {ordinal: tag})
          PlaceStep.VariantField {tag, field} => projectionField(endpoints, parent, field, tag)
          PlaceStep.Field {index} => projectionField(endpoints, parent, index, usize.MAX)
          PlaceStep.Element {index} => exactChild(endpoints, parent, &Selector.Index {class: IndexClass.Exact {index: index}})
        }
        run List<EndpointId>.append(&mut path, child)
        parent = child
        at = at + usize.ONE
      }
    }
    _ => { CompilerBug.panic(b"source selection is not a typed projection") }
  }
  run selectionUse(prepared, &mut skeleton.*, occurrence, root, List<EndpointId>.asSlice(&path), strength, active)
  return ()
}

fn projectionField(endpoints: &[Endpoint], parent: EndpointId, field: usize, variant: usize) -> EndpointId {
  let mut found = usize.MAX
  let mut at = usize.ZERO
  while at < endpoints.length {
    let child = match endpoints[at].parent { Option<EndpointId>.Some {value} => value.index == parent.index _ => false }
    let matches = match &endpoints[at].selector {
      Selector.Member {member, payload, ..} =>
        (variant == usize.MAX && member == field && payload == usize.ZERO)
        || (variant != usize.MAX && member == variant && payload == field)
      Selector.Field {ordinal} => variant == usize.MAX && ordinal == field
      _ => false
    }
    if child && matches {
      if found != usize.MAX { return CompilerBug.panic(b"field selection has duplicate prepared coordinates") }
      found = at
    }
    at = at + usize.ONE
  }
  if found == usize.MAX { return CompilerBug.panic(b"field selection has no exact prepared coordinate") }
  return EndpointId {index: found}
}

// Site, path and terminal inline frontier identify the prepared selection. Empty pattern
// paths can have no maps at all, so map.site alone cannot authenticate their distinct uses.
effect fn selectionUse<'body>(prepared: &SourcePreparation<'body>, skeleton: &mut Skeleton,
  occurrence: &Visit, root: EndpointId, path: &[EndpointId], strength: Write, active: Atom) -> ()
! OutOfMemoryError ? &mut Allocator {
  let endpoints = List<Endpoint>.asSlice(&prepared.endpoints)
  let maps = List<SelectionMap>.asSlice(&prepared.maps)
  let selections = List<Selection>.asSlice(&prepared.selections)
  let mut terminal = root
  if path.length > usize.ZERO { terminal = path[path.length - usize.ONE] }
  let mut found = usize.MAX
  let mut at = usize.ZERO
  while at < selections.length {
    if selections[at].site.index == occurrence.node.index && selections[at].root.index == root.index
      && projectionSelection(prepared, &selections[at], occurrence.node, root, path, terminal) {
      if found != usize.MAX { CompilerBug.panic(b"projection has duplicate exact prepared selections") }
      found = at
    }
    at = at + usize.ONE
  }
  if found == usize.MAX { CompilerBug.panic(b"projection has no exact prepared selection") }
  let mut selectors = List<MapId>.make()
  let members = List<MapId>.asSlice(&selections[found].maps)
  let mut parent = root
  at = usize.ZERO
  while at < path.length {
    // The selection matcher proved there is exactly one map for each authored step.
    let mut each = usize.ZERO
    while each < members.length {
      let map = &maps[members[each].index]
      if map.source.index == parent.index && map.target.index == path[at].index {
        run List<MapId>.append(&mut selectors, members[each])
      }
      each = each + usize.ONE
    }
    parent = path[at]
    at = at + usize.ONE
  }
  let value = exactMap(maps, occurrence.node, terminal,
    nodeRoot(endpoints, occurrence.node, EndpointRole.Value), MapKind.Copy)
  let place = exactMap(maps, occurrence.node, terminal,
    nodeRoot(endpoints, occurrence.node, EndpointRole.Storage), MapKind.Select)
  let inputs = List<Input>.asSlice(&occurrence.inputs)
  run List<SelectionUse>.append(&mut skeleton.selections, SelectionUse {operand: inputs[0].evaluation,
    result: occurrence.evaluation, selection: SelectionId {index: found}, selectors: move selectors,
    value: Option<MapId>.some(value), place: Option<MapId>.some(place), strength: strength, active: active})
  return ()
}

fn projectionSelection<'body>(prepared: &SourcePreparation<'body>, selection: &Selection,
  site: NodeId, root: EndpointId, path: &[EndpointId], terminal: EndpointId) -> bool {
  let endpoints = List<Endpoint>.asSlice(&prepared.endpoints)
  let maps = List<SelectionMap>.asSlice(&prepared.maps)
  let members = List<MapId>.asSlice(&selection.maps)
  let accepts = List<EndpointId>.asSlice(&selection.accepts)
  let mut expectedMaps = path.length
  let mut expectedAccepts = usize.ZERO
  let mut at = usize.ZERO
  while at < members.length {
    if members[at].index >= maps.length { return CompilerBug.panic(b"prepared selection names an absent map") }
    let map = &maps[members[at].index]
    if map.site.index != site.index || map.kind != MapKind.Select { return false }
    let child = match endpoints[map.target.index].parent { Option<EndpointId>.Some {value} => value.index == map.source.index _ => false }
    if !child || !sameSelector(&map.selector, &endpoints[map.target.index].selector) { return false }
    at = at + usize.ONE
  }
  let mut parent = root
  at = usize.ZERO
  while at < path.length {
    if selectionEdgeCount(maps, members, parent, path[at]) != usize.ONE { return false }
    parent = path[at]
    at = at + usize.ONE
  }
  // Exactly the terminal's inline frontier, not a sibling with an equal type and not an
  // additional Referent/Effect channel that happens to be present in the endpoint table.
  at = usize.ZERO
  while at < endpoints.length {
    let endpoint = EndpointId {index: at}
    if inlineComponent(prepared, terminal, endpoint) {
      if at != terminal.index {
        let parent = match endpoints[at].parent {
          Option<EndpointId>.Some {value} => value
          _ => { return CompilerBug.panic(b"selected inline child has no parent") }
        }
        if selectionEdgeCount(maps, members, parent, endpoint) != usize.ONE { return false }
        expectedMaps = expectedMaps + usize.ONE
      }
      let mut children = false
      let mut child = usize.ZERO
      while child < endpoints.length {
        let immediate = match endpoints[child].parent { Option<EndpointId>.Some {value} => value.index == at _ => false }
        if immediate && inlineComponent(prepared, endpoint, EndpointId {index: child}) { children = true }
        child = child + usize.ONE
      }
      if !children {
        let mut matches = usize.ZERO
        let mut accept = usize.ZERO
        while accept < accepts.length {
          if accepts[accept].index == at { matches = matches + usize.ONE }
          accept = accept + usize.ONE
        }
        if matches != usize.ONE { return false }
        expectedAccepts = expectedAccepts + usize.ONE
      }
    }
    at = at + usize.ONE
  }
  return members.length == expectedMaps && accepts.length == expectedAccepts
}

fn selectionEdgeCount(maps: &[SelectionMap], members: &[MapId], parent: EndpointId, child: EndpointId) -> usize {
  let mut count = usize.ZERO
  let mut at = usize.ZERO
  while at < members.length {
    if maps[members[at].index].source.index == parent.index && maps[members[at].index].target.index == child.index {
      count = count + usize.ONE
    }
    at = at + usize.ONE
  }
  return count
}

fn preparedConstruction<'body>(prepared: &SourcePreparation<'body>, site: NodeId) -> bool {
  let rows = List<Construction>.asSlice(&prepared.constructions)
  let mut found = false
  let mut at = usize.ZERO
  while at < rows.length {
    if rows[at].site.index == site.index {
      if found { return CompilerBug.panic(b"source producer has duplicate physical constructions") }
      found = true
    }
    at = at + usize.ONE
  }
  return found
}

effect fn localReplacement<'body>(prepared: &SourcePreparation<'body>, skeleton: &mut Skeleton, occurrence: &Visit,
  inputs: &[Input], local: LocalId, operand: NodeId, yes: Atom) -> () ! OutOfMemoryError ? &mut Allocator {
  if inputs.length != usize.ONE || inputs[0].node.index != operand.index {
    CompilerBug.panic(b"local source replacement lost its actual initializer occurrence")
  }
  let endpoints = List<Endpoint>.asSlice(&prepared.endpoints)
  let maps = List<SelectionMap>.asSlice(&prepared.maps)
  let source = nodeRoot(endpoints, operand, EndpointRole.Value)
  let target = localRoot(endpoints, local)
  let map = exactMap(maps, occurrence.node, source, target, MapKind.Place)
  drop run Skeleton.writeLocal(&mut skeleton.*, endpoints, maps, map, inputs[0].evaluation, occurrence.evaluation, local, yes)
  return ()
}

fn localRoot(endpoints: &[Endpoint], local: LocalId) -> EndpointId {
  let mut found = usize.MAX
  let mut at = usize.ZERO
  while at < endpoints.length {
    let matches = match &endpoints[at].root {
      Root.Local {local: actual, category} => actual.index == local.index && category == EndpointRole.Storage
      _ => false
    }
    let root = match endpoints[at].parent { Option<EndpointId>.None => true _ => false }
    if matches && root {
      if found != usize.MAX { return CompilerBug.panic(b"canonical local storage has duplicate prepared roots") }
      found = at
    }
    at = at + usize.ONE
  }
  if found == usize.MAX { return CompilerBug.panic(b"local storage has no canonical prepared root") }
  return EndpointId {index: found}
}

fn nodeRoot(endpoints: &[Endpoint], node: NodeId, category: EndpointRole) -> EndpointId {
  let mut found = usize.MAX
  let mut at = usize.ZERO
  while at < endpoints.length {
    let matches = match &endpoints[at].root {
      Root.Node {node: actual, category: actualRole} => actual.index == node.index && actualRole == category
      _ => false
    }
    let root = match endpoints[at].parent { Option<EndpointId>.None => true _ => false }
    if matches && root {
      if found != usize.MAX { return CompilerBug.panic(b"source node has duplicate prepared component roots") }
      found = at
    }
    at = at + usize.ONE
  }
  if found == usize.MAX { return CompilerBug.panic(b"source node has no prepared component root") }
  return EndpointId {index: found}
}

// Identity is the actual typed site AND both physical endpoints/kind. Matching a shared site,
// type, or lifetime alone cannot select a transfer; duplicate exact evidence is also a defect.
fn exactMap(maps: &[SelectionMap], site: NodeId, source: EndpointId, target: EndpointId, kind: MapKind) -> MapId {
  let mut found = usize.MAX
  let mut at = usize.ZERO
  while at < maps.length {
    if maps[at].site.index == site.index && maps[at].source.index == source.index
      && maps[at].target.index == target.index && maps[at].kind == kind {
      if found != usize.MAX { return CompilerBug.panic(b"physical source transfer has duplicate exact map identities") }
      found = at
    }
    at = at + usize.ONE
  }
  if found == usize.MAX { return CompilerBug.panic(b"supported physical source transfer has no prepared map") }
  return MapId {index: found}
}

// Entry owns only the finite inline frontier. A demanded Referent/EffectSuccess boundary is
// not another initialized local field; later selection must compose its actual source route.
fn inlineComponent<'body>(prepared: &SourcePreparation<'body>, root: EndpointId, candidate: EndpointId) -> bool {
  let endpoints = List<Endpoint>.asSlice(&prepared.endpoints)
  let shapes = List<Shape>.asSlice(&prepared.shapes)
  let mut current = candidate
  let mut remaining = endpoints.length
  while remaining > usize.ZERO {
    if current.index == root.index { return true }
    if current.index >= endpoints.length { return CompilerBug.panic(b"prepared entry component is absent") }
    let endpoint = &endpoints[current.index]
    let parent = match endpoint.parent { Option<EndpointId>.Some {value} => value _ => { return false } }
    if parent.index >= endpoints.length || endpoints[parent.index].shape.index >= shapes.length {
      return CompilerBug.panic(b"prepared entry component has no parent shape")
    }
    // Inline coordinates are fields, variant payloads, or authored array partitions. Reference,
    // pointer and Effect semantic channels always stop the owned frontier.
    let boundary = match &endpoint.selector {
      Selector.Referent => true
      Selector.EffectSuccess => true
      Selector.EffectFailure => true
      Selector.Opaque => true
      _ => false
    }
    if boundary { return false }
    let components = List<Component>.asSlice(&shapes[endpoints[parent.index].shape.index].components)
    let mut found = false
    let mut component = usize.ZERO
    while component < components.length {
      if sameSelector(&components[component].selector, &endpoint.selector) {
        if !components[component].inline { return false }
        found = true
      }
      component = component + usize.ONE
    }
    if !found { return CompilerBug.panic(b"prepared entry child is absent from its exact inline shape") }
    current = parent
    remaining = remaining - usize.ONE
  }
  return CompilerBug.panic(b"prepared inline source component ancestry is cyclic")
}
