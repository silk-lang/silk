//! Structural eligibility for checking an unspecialized static template.
//!
//! A deferred expansion needs authored static inputs, not a guessed value. This classifier runs
//! before body checking and never inspects a checking refusal (STATIC-010; follow-up ticket 18).

import hir.Hir as Hir { CallableContract, HirId, Module, Node, ParameterMode, Range }
import hir.Intern { Symbol }
import semantic.ModuleIndex { IndexedDeclaration }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.option { Option }
import silk.num.usize
import silk.collections.list { List }

pub enum Reason {
  StaticParameters,
  DependentExpansion
}

/// The code a cache image writes for `reason`, which [`reasonOf`] reads back.
pub fn reasonCode(reason: Reason) -> u64 {
  return match reason {
    Reason.StaticParameters => 0
    Reason.DependentExpansion => 1
  }
}

/// The reason [`reasonCode`] wrote as `code`, or none when no reason has that code.
pub fn reasonOf(code: u64) -> Option<Reason> {
  if code == 0 { return Option<Reason>.some(Reason.StaticParameters) }
  if code == 1 { return Option<Reason>.some(Reason.DependentExpansion) }
  return Option<Reason>.none()
}

fn parentOf(declaration: &IndexedDeclaration) -> Option<usize> {
  return match &declaration.parent {
    Option<usize>.Some { value } => Option<usize>.some(value)
    _ => Option<usize>.none()
  }
}

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

fn listedNode(nodes: &[HirId], node: HirId) -> bool {
  let mut at = usize.ZERO
  while at < nodes.length {
    if nodes[at].index == node.index {
      return true
    }
    at = at + usize.ONE
  }
  return false
}

// Appends each type binder's name to `names`, and to `contracts` the last name of each type its
// bounds write, such as `Described` in `B: Described`.
effect fn appendGenerics(module: &Module, generics: Range, names: &mut List<Symbol>, contracts: &mut List<Symbol>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut at = usize.ZERO
  while at < generics.length {
    if let Node.TypeParameter {
      name,
      bounds,
    } = Module.node(module, Module.child(module, generics, at)) {
      if let Node.Name { text } = Module.node(module, name) {
        run List<Symbol>.append(&mut names.*, text)
      }
      let mut bound = usize.ZERO
      while bound < bounds.length {
        if let Node.NamedType { path, .. } = Module.node(module, Module.child(module, bounds, bound)) {
          if let Node.Path { segments } = Module.node(module, path) {
            if segments.length > usize.ZERO {
              if let Node.Name { text } = Module.node(module, Module.child(module, segments, segments.length - usize.ONE)) {
                run List<Symbol>.append(&mut contracts.*, text)
              }
            }
          }
        }
        bound = bound + usize.ONE
      }
    }
    at = at + usize.ONE
  }
  return ()
}

fn listedSymbol(symbols: &[Symbol], symbol: Symbol) -> bool {
  let mut at = usize.ZERO
  while at < symbols.length {
    if symbols[at].index == symbol.index {
      return true
    }
    at = at + usize.ONE
  }
  return false
}

// A lexical binding is followed to its own initializer, rather than compared by spelling. Type
// names use the declaration's own and enclosing generic binder symbols, in their type namespace,
// and `Self` when `openSelf`: the implicit provider binder of an enclosing interface or service.
// A name that no local binds and that names a bound's contract, such as `Described` in
// `Described.describe()` under `B: Described`, selects its provider through that binder.
effect fn dependent(module: &Module, expression: HirId, generics: &[Symbol], contracts: &[Symbol], openSelf: bool) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut pending = List<HirId>.make()
  let mut visited = List<HirId>.make()
  run List<HirId>.append(&mut pending, expression)
  while List<HirId>.length(&pending) > usize.ZERO {
    let node = match move List<HirId>.pop(&mut pending) {
      Option<HirId>.Some { value } => value
      _ => {
        break
      }
    }
    if listedNode(List<HirId>.asSlice(&visited), node) {
      continue
    }
    run List<HirId>.append(&mut visited, node)
    if let Node.IdentifierExpression { name, binding } = Module.node(module, node) {
      if binding.present {
        if let Node.BindingStatement { initializer, .. } = Module.node(module, binding.id) {
          run List<HirId>.append(&mut pending, initializer)
        }
      } else if let Node.Name { text } = Module.node(module, name) {
        if listedSymbol(contracts, text) {
          return true
        }
      }
    }
    if let Node.NamedType { path, .. } = Module.node(module, node) {
      if let Node.Path { segments } = Module.node(module, path) {
        if segments.length == usize.ONE {
          if let Node.Name {
            text
          } = Module.node(module, Module.child(module, segments, usize.ZERO)) {
            if openSelf && same(Module.text(module, text), b"Self") {
              return true
            }
            let mut at = usize.ZERO
            while at < generics.length {
              if generics[at].index == text.index {
                return true
              }
              at = at + usize.ONE
            }
          }
        }
      }
    }
    let children = run Hir.ownedChildren(module, node)
    let listed = List<HirId>.asSlice(&children)
    let mut at = usize.ZERO
    while at < listed.length {
      run List<HirId>.append(&mut pending, listed[at])
      at = at + usize.ONE
    }
  }
  return false
}

/// Why an ordinary declaration body needs a selected static environment, if it does.
/// The function's header is still checked even when its body has no abstract elaboration yet.
pub effect fn reason(
  module: &Module,
  declarations: &[IndexedDeclaration],
  ordinal: usize
) -> Option<Reason>
  ! OutOfMemoryError
  ? &mut Allocator {
  let declaration = &declarations[ordinal]
  let contract = match Module.node(module, declaration.header) {
    Node.FunctionHeader { contract, .. } => contract
    Node.OperationHeader { contract, .. } => contract
    _ => {
      return Option<Reason>.none()
    }
  }
  let mut generics = List<Symbol>.make()
  let mut contracts = List<Symbol>.make()
  if let Option<CallableContract>.Some {value: CallableContract { parameters: inputs, generics: own, isStatic, .. }} = Module.contractOf(module, contract) {
    run appendGenerics(module, own, &mut generics, &mut contracts)
    let mut at = usize.ZERO
    while at < inputs.length {
      let parameter = Module.child(module, inputs, at)
      if let Node.Parameter { mode, .. } = Module.node(module, parameter) {
        // Every input of a static fn is supplied at static execution, as is an explicitly static
        // parameter of an ordinary function. Neither has a value at the abstract Body demand.
        if isStatic || mode == ParameterMode.Static {
          return Option<Reason>.some(Reason.StaticParameters)
        }
      }
      at = at + usize.ONE
    }
  }
  let mut openSelf = false
  let mut parent = parentOf(declaration)
  while true {
    let at = match move parent {
      Option<usize>.Some { value } => value
      _ => {
        break
      }
    }
    let inherited = match Module.node(module, declarations[at].header) {
      Node.ImplHeader { generics: implGenerics, .. } => implGenerics
      Node.StructHeader { generics: structGenerics, .. } => structGenerics
      Node.TupleHeader { generics: tupleGenerics, .. } => tupleGenerics
      Node.UnionHeader { generics: unionGenerics, .. } => unionGenerics
      Node.ServiceHeader { generics: serviceGenerics, .. } => {
        openSelf = true
        serviceGenerics
      }
      // A default body's `Self` conforms to the interface, so a call qualified by its name
      // selects `Self`'s operation.
      Node.InterfaceHeader { name: interfaceName, generics: interfaceGenerics, .. } => {
        openSelf = true
        if let Node.Name { text } = Module.node(module, interfaceName) {
          run List<Symbol>.append(&mut contracts, text)
        }
        interfaceGenerics
      }
      Node.AliasHeader { generics: aliasGenerics, .. } => aliasGenerics
      _ => Range.empty()
    }
    run appendGenerics(module, inherited, &mut generics, &mut contracts)
    parent = parentOf(&declarations[at])
  }
  if List<Symbol>.length(&generics) == usize.ZERO && !openSelf {
    return Option<Reason>.none()
  }
  let body = match Module.node(module, declaration.local) {
    Node.Declaration { body, .. } => body
    _ => {
      return Option<Reason>.none()
    }
  }
  let mut pending = List<HirId>.make()
  run List<HirId>.append(&mut pending, body)
  while List<HirId>.length(&pending) > usize.ZERO {
    let node = match move List<HirId>.pop(&mut pending) {
      Option<HirId>.Some { value } => value
      _ => {
        break
      }
    }
    let expression = match Module.node(module, node) {
      Node.StaticForStatement { iterable, .. } => Option<HirId>.some(iterable)
      Node.StaticConditionalStatement { condition, .. } => Option<HirId>.some(condition)
      // A `let static` that names a binder, such as `let static d = describe<T>()`, has no value
      // until the binder does.
      Node.BindingStatement { isStatic, initializer, .. } => if isStatic {
        Option<HirId>.some(initializer)
      } else {
        Option<HirId>.none()
      }
      _ => Option<HirId>.none()
    }
    if let Option<HirId>.Some { value } = move expression {
      if run dependent(module, value, List<Symbol>.asSlice(&generics), List<Symbol>.asSlice(&contracts), openSelf) {
        return Option<Reason>.some(Reason.DependentExpansion)
      }
    }
    let children = run Hir.ownedChildren(module, node)
    let listed = List<HirId>.asSlice(&children)
    let mut at = usize.ZERO
    while at < listed.length {
      run List<HirId>.append(&mut pending, listed[at])
      at = at + usize.ONE
    }
  }
  return Option<Reason>.none()
}
