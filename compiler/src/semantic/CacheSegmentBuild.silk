//! Partitions a fresh cache graph into bounded immutable segments without copying old graphs.
//!
//! External placeholders are meaningful only together with their explicit authenticated node
//! mapping. The caller supplies answer pack requirements and chooses generation root authority.

import semantic.CacheImage as Image {Image as ImageData}
import semantic.CacheSegments as Segments {Descriptor, SealedSegment, Segment, Reference, Observation, Node, Edge, Root}
import semantic.ContentHash {ContentHash}
import semantic.InternIndex {InternIndex}
import semantic.RuntimeEncoding
import silk.collections.bytes {Bytes}
import silk.collections.list {List}
import silk.core.option {Option}
import silk.core.ownership {Copy}
import silk.mem.frozen {Frozen}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.num.u64
import silk.num.usize

/// A published segment-local item. Its role is supplied by the containing mapping.
pub struct Target {pub segment: ContentHash, pub index: usize}
impl Copy for Target {}
/// A zero-edge fresh node standing for an existing, authenticated dependency node.
pub struct ExternalNode {pub node: usize, pub target: Target}
impl Copy for ExternalNode {}
/// Native pack requirements supplied by the semantic answer's family.
pub struct RootPacks {pub root: usize, pub packs: List<ContentHash>}
/// The exact published root corresponding to one fresh root ordinal.
pub struct RootMapping {pub source: usize, pub target: Target}
impl Copy for RootMapping {}
/// Newly sealed owners and exact fresh-item mappings. Inherited owners are not returned.
pub struct Built {pub owners: List<Frozen<SealedSegment>>, pub roots: List<RootMapping>, pub leaves: List<Target>}

struct Location {owner: usize, index: usize}
impl Copy for Location {}
struct Builder {
  owners: List<Frozen<SealedSegment>>,
  inherited: usize,
  segment: Segment,
  imports: List<usize>,
  stamp: Bytes,
  bytes: usize,
  items: usize,
}
fn absent() -> Location { return Location {owner: usize.MAX, index: usize.MAX} }
fn ordinal(builder: &Builder) -> usize { return List<Frozen<SealedSegment>>.length(&builder.owners) }
fn descriptor(builder: &Builder, owner: usize) -> Descriptor {
  return Segments.descriptor(Frozen<SealedSegment>.get(&List<Frozen<SealedSegment>>.asSlice(&builder.owners)[owner]))
}
fn contains(values: &[usize], value: usize) -> bool {
  let mut at = usize.ZERO
  while at < values.length { if values[at] == value { return true } at = at + usize.ONE }
  return false
}
fn occupied(builder: &Builder) -> bool {
  return List<Observation>.length(&builder.segment.leaves) > 0 || List<Node>.length(&builder.segment.nodes) > 0
    || List<Root>.length(&builder.segment.roots) > 0
}
effect fn flush(builder: &mut Builder) -> bool ! OutOfMemoryError ? &mut Allocator {
  if !occupied(&builder.*) { return false }
  if ordinal(&builder.*) >= 256 { return false }
  let serial = builder.segment.serial
  let next: u64 = if serial == u64.MAX { 0 } else { serial + 1 }
  let empty = run Segments.make(next, Bytes.asSlice(&builder.stamp))
  let segment = Intrinsic.replace(builder.segment, move empty)
  let sealed = match move run Segments.seal(move segment, List<Frozen<SealedSegment>>.asSlice(&builder.owners)) {
    Option<SealedSegment>.Some {value} => move value
    Option<SealedSegment>.None => { return false }
  }
  run List<Frozen<SealedSegment>>.append(&mut builder.owners, run Frozen<SealedSegment>.make(move sealed))
  builder.imports = List<usize>.make()
  builder.bytes = 168 + Bytes.length(&builder.stamp)
  builder.items = usize.ZERO
  return true
}

// Costs include each record's index slot and the same conservative fixed header as seal's
// validator. Only one segment is encoded at a time; an overflow never probes by re-encoding.
effect fn space(builder: &mut Builder, references: &[Location], bytes: usize, items: usize, kind: usize) -> bool
! OutOfMemoryError ? &mut Allocator {
  if bytes > Segments.BYTE_LIMIT || items > Segments.ITEM_LIMIT { return false }
  let mut attempt = usize.ZERO
  while attempt < 2 {
    if builder.segment.serial == 0 || ordinal(&builder.*) >= 256 { return false }
    let current = ordinal(&builder.*)
    let mut missing = List<usize>.make()
    let mut at = usize.ZERO
    while at < references.length {
      let owner = references[at].owner
      if owner > current { return false }
      if owner < current && !contains(List<usize>.asSlice(&builder.imports), owner)
        && !contains(List<usize>.asSlice(&missing), owner) { run List<usize>.append(&mut missing, owner) }
      at = at + usize.ONE
    }
    let additions = List<usize>.length(&missing)
    let count = if kind == 0 { List<Observation>.length(&builder.segment.leaves) }
      else if kind == 1 { List<Node>.length(&builder.segment.nodes) } else { List<Root>.length(&builder.segment.roots) }
    let fits = count < Segments.ENTRY_LIMIT && additions <= Segments.IMPORT_LIMIT - List<usize>.length(&builder.imports)
      && additions * 48 <= Segments.BYTE_LIMIT - bytes
      && builder.bytes <= Segments.BYTE_LIMIT - bytes - additions * 48
      && additions <= Segments.ITEM_LIMIT - items && builder.items <= Segments.ITEM_LIMIT - items - additions
    if fits {
      let needed = List<usize>.asSlice(&missing)
      at = usize.ZERO
      while at < needed.length {
        let held = descriptor(&builder.*, needed[at])
        run List<Descriptor>.append(&mut builder.segment.imports, held)
        run List<usize>.append(&mut builder.imports, needed[at])
        at = at + usize.ONE
      }
      builder.bytes = builder.bytes + bytes + additions * 48
      builder.items = builder.items + items + additions
      return true
    }
    if !run flush(&mut builder.*) { return false }
    attempt = attempt + usize.ONE
  }
  return false
}
fn reference(builder: &Builder, location: Location) -> Reference {
  if location.owner == ordinal(builder) { return Reference {segment: 0, index: location.index} }
  let imported = List<usize>.asSlice(&builder.imports)
  let mut at = usize.ZERO
  while at < imported.length {
    if imported[at] == location.owner { return Reference {segment: at + usize.ONE, index: location.index} }
    at = at + usize.ONE
  }
  return Reference {segment: usize.MAX, index: location.index}
}
fn target(builder: &Builder, location: Location) -> Target {
  return Target {segment: descriptor(builder, location.owner).digest, index: location.index}
}
fn parent(parents: &[Frozen<SealedSegment>], expected: Target) -> usize {
  let mut at = usize.ZERO
  while at < parents.length {
    if ContentHash.equals(Segments.descriptor(Frozen<SealedSegment>.get(&parents[at])).digest, expected.segment) { return at }
    at = at + usize.ONE
  }
  return usize.MAX
}

/// Converts fresh observations, topological nodes and roots into independently sealed segments.
/// Parents must come from an admitted generation with authenticated import closure. This function
/// checks their stamps and exact target bounds but does not revalidate old graph dependencies.
/// A single item exceeding the segment budget, an invalid external placeholder, duplicate root
/// authority or exhausted serial/catalog space refuses the candidate without publishing it.
pub effect fn build(stamp: &[u8], image: ImageData, external: &[ExternalNode], packs: &[RootPacks], parents: &[Frozen<SealedSegment>])
-> Option<Built> ! OutOfMemoryError ? &mut Allocator {
  if stamp.length > 65536 || parents.length >= 256 { return Option<Built>.none() }
  let mut fresh = move image
  if !run Image.readLeaves(&mut fresh) || !run Image.readNodes(&mut fresh) { return Option<Built>.none() }
  let leafCount = Image.leafCount(&fresh)
  let nodeCount = Image.nodeCount(&fresh)
  let rootCount = List<Image.Root>.length(&fresh.roots)
  let mut owners = List<Frozen<SealedSegment>>.make()
  let mut serial: u64 = 0
  let mut at = usize.ZERO
  while at < parents.length {
    let held = Frozen<SealedSegment>.get(&parents[at])
    let found = Segments.descriptor(held)
    if !RuntimeEncoding.equals(stamp, Segments.stamp(held)) { return Option<Built>.none() }
    let mut prior = usize.ZERO
    while prior < at {
      if ContentHash.equals(found.digest, Segments.descriptor(Frozen<SealedSegment>.get(&parents[prior])).digest) { return Option<Built>.none() }
      prior = prior + usize.ONE
    }
    if found.serial > serial { serial = found.serial }
    run List<Frozen<SealedSegment>>.append(&mut owners, Frozen<SealedSegment>.clone(&parents[at]))
    at = at + usize.ONE
  }
  if serial == u64.MAX { return Option<Built>.none() }
  let mut builder = Builder {owners: move owners, inherited: parents.length, segment: run Segments.make(serial + 1, stamp),
    imports: List<usize>.make(), stamp: run Bytes.copy(stamp), bytes: 168 + stamp.length, items: 0}
  let mut leaves = List<Location>.make()
  let mut nodes = List<Location>.make()
  let mut rootLocations = List<Location>.make()
  let mut rootPacks = List<usize>.make()
  run List<Location>.appendRepeated(&mut leaves, absent(), leafCount)
  run List<Location>.appendRepeated(&mut nodes, absent(), nodeCount)
  run List<usize>.appendRepeated(&mut rootPacks, usize.MAX, rootCount)
  at = usize.ZERO
  while at < external.length {
    let entry = external[at]
    let owner = parent(parents, entry.target)
    if entry.node >= nodeCount || owner == usize.MAX { return Option<Built>.none() }
    if List<Location>.get(&nodes, entry.node).owner != usize.MAX || Image.edgesOf(&fresh, entry.node).length != 0
      || entry.target.index >= Segments.descriptor(Frozen<SealedSegment>.get(&parents[owner])).nodes { return Option<Built>.none() }
    List<Location>.set(&mut nodes, entry.node, Location {owner: owner, index: entry.target.index})
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < packs.length {
    let root = packs[at].root
    if root >= rootCount || List<usize>.get(&rootPacks, root) != usize.MAX { return Option<Built>.none() }
    if List<ContentHash>.length(&packs[at].packs) > Segments.ENTRY_LIMIT { return Option<Built>.none() }
    List<usize>.set(&mut rootPacks, root, at)
    at = at + usize.ONE
  }
  // Files precede inputs even when a fresh image records an input before its file snapshot.
  let mut phase = usize.ZERO
  while phase < 2 {
    let mut cursor = Image.keyCursor()
    at = usize.ZERO
    while at < leafCount {
      let leaf = Image.leaves(&fresh)[at]
      if leaf.input == (phase == 1) {
        let key = run Image.keyAt(&fresh, &mut cursor, at)
        let hasFile = leaf.file != usize.MAX
        if key.length > Segments.BYTE_LIMIT - 96 { return Option<Built>.none() }
        let mut refs = List<Location>.make()
        if hasFile {
          if !leaf.input || leaf.file >= leafCount || Image.leaves(&fresh)[leaf.file].input { return Option<Built>.none() }
          let file = List<Location>.get(&leaves, leaf.file)
          if file.owner == usize.MAX { return Option<Built>.none() }
          run List<Location>.append(&mut refs, file)
        }
        let fixed: usize = if hasFile { 96 } else { 80 }
        let cost = key.length + fixed
        if !run space(&mut builder, List<Location>.asSlice(&refs), cost, 1, 0) { return Option<Built>.none() }
        let mut file = Option<Reference>.none()
        if hasFile { file = Option<Reference>.some(reference(&builder, List<Location>.get(&leaves, leaf.file))) }
        let location = Location {owner: ordinal(&builder), index: List<Observation>.length(&builder.segment.leaves)}
        run List<Observation>.append(&mut builder.segment.leaves, Observation {key: run Bytes.copy(key), digest: leaf.digest,
          text: leaf.text, position: leaf.position, file: move file, selector: leaf.selector, input: leaf.input})
        List<Location>.set(&mut leaves, at, location)
      }
      at = at + usize.ONE
    }
    phase = phase + usize.ONE
  }
  at = usize.ZERO
  while at < nodeCount {
    if List<Location>.get(&nodes, at).owner == usize.MAX {
      let edges = Image.edgesOf(&fresh, at)
      if edges.length > Segments.ENTRY_LIMIT { return Option<Built>.none() }
      let mut refs = List<Location>.make()
      let mut edge = usize.ZERO
      while edge < edges.length {
        let node = Image.namesNode(edges[edge])
        let index = Image.target(edges[edge])
        if (node && index >= at) || (!node && index >= leafCount) { return Option<Built>.none() }
        let location = if node { List<Location>.get(&nodes, index) } else { List<Location>.get(&leaves, index) }
        if location.owner == usize.MAX { return Option<Built>.none() }
        run List<Location>.append(&mut refs, location)
        edge = edge + usize.ONE
      }
      if !run space(&mut builder, List<Location>.asSlice(&refs), 16 + edges.length * 24, usize.ONE + edges.length, 1) { return Option<Built>.none() }
      let mut written = List<Edge>.make()
      edge = usize.ZERO
      while edge < edges.length {
        run List<Edge>.append(&mut written, Edge {node: Image.namesNode(edges[edge]), target: reference(&builder, List<Location>.get(&refs, edge))})
        edge = edge + usize.ONE
      }
      let location = Location {owner: ordinal(&builder), index: List<Node>.length(&builder.segment.nodes)}
      run List<Node>.append(&mut builder.segment.nodes, Node {edges: move written})
      List<Location>.set(&mut nodes, at, location)
    }
    at = at + usize.ONE
  }
  let mut keys = InternIndex.make()
  at = usize.ZERO
  while at < rootCount {
    let roots = List<Image.Root>.asSlice(&fresh.roots)
    let root = &roots[at]
    let hash = ContentHash.of(Bytes.asSlice(&root.key)).low
    let mut prior = InternIndex.first(&keys, hash)
    while prior != usize.MAX {
      // Earlier keys were moved into sealed/current owners; the compact hash index alone
      // cannot authorize equality. Resolve the original key through the published location.
      let location = List<Location>.get(&rootLocations, prior)
      let previous = if location.owner == ordinal(&builder) {
        Bytes.asSlice(&List<Root>.asSlice(&builder.segment.roots)[location.index].key)
      } else {
        match move Segments.rootKey(Frozen<SealedSegment>.get(&List<Frozen<SealedSegment>>.asSlice(&builder.owners)[location.owner]), location.index) {
          Option<&[u8]>.Some {value} => value
          Option<&[u8]>.None => { return Option<Built>.none() }
        }
      }
      if RuntimeEncoding.equals(previous, Bytes.asSlice(&root.key)) { return Option<Built>.none() }
      prior = InternIndex.after(&keys, prior)
    }
    if root.node >= nodeCount { return Option<Built>.none() }
    let dependency = List<Location>.get(&nodes, root.node)
    if dependency.owner == usize.MAX { return Option<Built>.none() }
    let named = List<usize>.get(&rootPacks, at)
    let packCount = if named == usize.MAX { usize.ZERO } else { List<ContentHash>.length(&packs[named].packs) }
    let keyBytes = Bytes.length(&root.key)
    let answerBytes = Bytes.length(&root.answer)
    if keyBytes > Segments.BYTE_LIMIT - 48 || answerBytes > Segments.BYTE_LIMIT - 48 - keyBytes
      || packCount * 16 > Segments.BYTE_LIMIT - 48 - keyBytes - answerBytes { return Option<Built>.none() }
    let cost = 48 + keyBytes + answerBytes + packCount * 16
    if !run space(&mut builder, &[dependency], cost, usize.ONE + packCount, 2) { return Option<Built>.none() }
    let mut required = List<ContentHash>.make()
    if named != usize.MAX { run List<ContentHash>.appendSlice(&mut required, List<ContentHash>.asSlice(&packs[named].packs)) }
    let location = Location {owner: ordinal(&builder), index: List<Root>.length(&builder.segment.roots)}
    let root = &mut List<Image.Root>.asMutSlice(&mut fresh.roots)[at]
    let key = Intrinsic.replace(root.key, Bytes.make())
    let answer = Intrinsic.replace(root.answer, Bytes.make())
    let wireReference = reference(&builder, dependency)
    run List<Root>.append(&mut builder.segment.roots, Root {key: move key, node: wireReference, answer: move answer, packs: move required})
    run List<Location>.append(&mut rootLocations, location)
    run InternIndex.record(&mut keys, hash)
    at = at + usize.ONE
  }
  if occupied(&builder) && !run flush(&mut builder) { return Option<Built>.none() }
  let mut mappedLeaves = List<Target>.make()
  at = usize.ZERO
  while at < leafCount { run List<Target>.append(&mut mappedLeaves, target(&builder, List<Location>.get(&leaves, at))) at = at + usize.ONE }
  let mut mappedRoots = List<RootMapping>.make()
  at = usize.ZERO
  while at < rootCount {
    run List<RootMapping>.append(&mut mappedRoots, RootMapping {source: at, target: target(&builder, List<Location>.get(&rootLocations, at))})
    at = at + usize.ONE
  }
  let mut inherited = builder.inherited
  while inherited > 0 { inherited = inherited - usize.ONE drop List<Frozen<SealedSegment>>.remove(&mut builder.owners, inherited) }
  return Option<Built>.some(Built {owners: move builder.owners, roots: move mappedRoots, leaves: move mappedLeaves})
}
