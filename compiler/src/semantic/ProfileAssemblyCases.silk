//! Effective package defaults, final-map validation, and failed-request isolation.

import semantic.Types {TypeTable, Types}
import lexer.Span { Span }
import semantic.DeclarationId { DeclarationId }
import semantic.FinalProfile { FinalProfile }
import semantic.InitialProfile { InitialProfile, Input, Problem as InputProblem }
import semantic.ModuleId { InvalidModulePath, ModuleId }
import semantic.ProfileAssembly { AssemblyProblem, assemble }
import semantic.ProfileBinding { Input as BindingInput, Provenance, Supplied, Tier }
import semantic.ProfileShape { Problem as ShapeProblem, Refusal, Registered, registered, registeredOrRefused }
import semantic.Query { Cycle }
import semantic.Rejection { MessageArgument, Rejection, RejectionCode }
import semantic.Semantic {
  Answer,
  ConflictingPackageSource,
  Outcome,
  RegistrationClosed,
  Request,
  Semantic,
  Value
}
import semantic.SourceIndex { NoRejection, RevisionMismatch }
import semantic.SourceRevision { Revision }
import semantic.StaticValue { Value as StaticData }
import semantic.Target { Id as TargetId, Target }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.mem.box { Box }
import silk.collections.bytes { Bytes }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.mem.shared { Shared }
import silk.text.string { String }
import silk.testing.testing { AssertionError, Testing }
import silk.num.u64
import silk.num.usize
import silk.collections.list { List }

fn parameterIs(profile: &FinalProfile, name: &[u8], expected: u64) -> bool {
  let entries = FinalProfile.entries(profile)
  let mut at = usize.ZERO
  while at < entries.length {
    if DeclarationId.named(&entries[at].declaration, name) {
      return Shared<StaticData>.with<bool>(
        &entries[at].value,
        fn(value: &StaticData) -> bool {
          return match &value.* {
            StaticData.Integer { magnitude, .. } => magnitude == expected
            _ => false
          }
        }
      )
    }
    at = at + usize.ONE
  }
  return false
}

fn sameText(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] { return false }
    at = at + usize.ONE
  }
  return true
}

// Whether `rejection` carries a `message` argument with exactly `text`.
fn carriesMessage(rejection: &Shared<Rejection>, text: &[u8]) -> bool {
  return Shared<Rejection>.with<bool>(rejection, fn(value: &Rejection) -> bool {
    let listed = List<MessageArgument>.asSlice(&value.arguments)
    let mut at = usize.ZERO
    while at < listed.length {
      if sameText(Bytes.asSlice(&listed[at].name), b"message") { return sameText(Bytes.asSlice(&listed[at].value), text) }
      at = at + usize.ONE
    }
    return false
  })
}

fn assemblyMessage(result: &Result<FinalProfile, AssemblyProblem>, text: &[u8]) -> bool {
  return match &result.* {
    Result<FinalProfile, AssemblyProblem>.Failure {error: AssemblyProblem.Default {rejection}} => carriesMessage(&rejection, text)
    _ => false
  }
}

fn assemblyRejected(result: &Result<FinalProfile, AssemblyProblem>, code: RejectionCode) -> bool {
  return match &result.* {
    Result<FinalProfile, AssemblyProblem>.Failure {
      error: AssemblyProblem.Default { rejection }
    } => Shared<Rejection>.with<bool>(
      &rejection,
      fn(value: &Rejection) -> bool {
        return value.code == code
      }
    )
    _ => false
  }
}

effect fn binding(name: &[u8], value: &[u8]) -> List<Supplied>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut result = List<Supplied>.make()
  run List<
    Supplied,
  >.append(
    &mut result,
    Supplied {
      package: run Bytes.copy(b"example"),
      module: run Bytes.copy(b"registered-parameters.silk"),
      parameter: run Bytes.copy(name),
      value: BindingInput.Integer { decimal: run Bytes.copy(value) },
      provenance: Provenance.Literal,
      tier: Tier.Override,
    }
  )
  return move result
}

effect fn facts() -> InitialProfile
  ! InputProblem | OutOfMemoryError
  ? &mut Allocator {
  let mut input = Input.make()
  input.target = Option<Bytes>.some(run Bytes.copy(b"x86_64-unknown-linux-gnu"))
  return run InitialProfile.freeze(&input)
}

fn initializerIs(answer: &Result<Answer, NoRejection>, expected: u64) -> bool {
  return match &answer.* {
    Result<Answer, NoRejection>.Success {
      value: Answer { outcome: Outcome.Success { value: Value.Initializer { value: data } }, .. }
    } => Shared<StaticData>.with<bool>(
      &data,
      fn(value: &StaticData) -> bool {
        return match &value.* {
          StaticData.Integer { magnitude, .. } => magnitude == expected
          _ => false
        }
      }
    )
    _ => false
  }
}

fn overriddenReadIsCurrent(answer: &Result<Answer, NoRejection>) -> bool {
  return initializerIs(answer, 16)
}

fn defaultReadIsCurrent(answer: &Result<Answer, NoRejection>) -> bool {
  return initializerIs(answer, 6)
}

fn runtimeBodyAccepted(answer: &Result<Answer, NoRejection>) -> bool {
  return match &answer.* {
    Result<Answer, NoRejection>.Success {
      value: Answer { outcome: Outcome.Success { value: Value.Body { .. } }, .. }
    } => true
    _ => false
  }
}

test effect fn effectiveDefaultsAndPredicatesUseCurrentFinalValues() -> ()
  ! InvalidModulePath
    | OutOfMemoryError
    | Cycle
    | RevisionMismatch
    | RegistrationClosed
    | ConflictingPackageSource
    | InputProblem
    | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let check = effect fn() -> ()
    ! InvalidModulePath
      | OutOfMemoryError
      | Cycle
      | RevisionMismatch
      | RegistrationClosed
      | ConflictingPackageSource
      | InputProblem
      | AssertionError<'static>
    ? &mut Allocator | &mut Types {
    let entry = run ModuleId.make(b"memory", b"example", b"registered-parameters.silk")
    let source = Option<Bytes>.some(
      run Bytes.copy(
        String.utf8Bytes(
          """
pub param first: u32 = second + 1
pub param second: u32 = 2
pub param checked: u32 = first where valid(checked, second)
pub param pointer: u32 = Intrinsic.targetPointerBits()
pub param debug: bool = Intrinsic.profileFlag("debug") where debug == Intrinsic.profileFlag("debug")
static fn valid(value: u32, floor: u32) -> bool { return value > floor }
const read: u32 = first + checked
fn runtimeRead() -> u32 { return first + checked }
"""
        )
      )
    )
    let revision = run Revision.publish(&Revision.make(), &entry, &source)
    let target = Target.forId(TargetId.X8664UnknownLinuxGnu)
    let mut semantic = Semantic.traced(move revision, target, Option<FinalProfile>.none())
    let mut request = Request.make()
    run Request.registerSchemaModule(&mut request, &entry)
    let shapes = run registered(&mut semantic, &mut request, &target)
    if let Result<Registered, ShapeProblem>.Success { value: schemas } = move shapes {
      let defaults = run assemble(
        run facts(),
        &mut semantic,
        &mut request,
        &schemas,
        List<Supplied>.make()
      )
      let overridden = run assemble(
        run facts(),
        &mut semantic,
        &mut request,
        &schemas,
        run binding(b"second", b"7")
      )
      let invalid = run assemble(
        run facts(),
        &mut semantic,
        &mut request,
        &schemas,
        run binding(b"checked", b"0")
      )
      let restored = run assemble(
        run facts(),
        &mut semantic,
        &mut request,
        &schemas,
        List<Supplied>.make()
      )
      run Testing.expect(
        assemblyRejected(&invalid, RejectionCode.ParameterValidationFailed),
        "overrides are validated against the complete effective map"
      )
      run Testing.expect(
        assemblyMessage(&invalid, b"the bound value of package parameter `checked` does not satisfy its `where` predicate"),
        "a failed predicate names its parameter"
      )
      if let Result<FinalProfile, AssemblyProblem>.Success { value: first } = move defaults {
        run Testing.expect(
          parameterIs(&first, b"first", 3) && parameterIs(&first, b"checked", 3),
          "forward defaults and static predicate helpers see final values"
        )
      } else {
        run Testing.expect(false, "default profile completes")
      }
      if let Result<FinalProfile, AssemblyProblem>.Success { value: second } = move overridden {
        run Testing.expect(
          parameterIs(&second, b"first", 8) && parameterIs(&second, b"checked", 8),
          "dependent defaults see the selected override"
        )
        run Semantic.reviseProfile(&mut semantic, Option<FinalProfile>.some(move second))
        let read = run Semantic.demandInitializer(&mut semantic, &mut request, &entry, b"read")
        run Testing.expect(
          Shared<Result<Answer, NoRejection>>.with<bool>(&read, overriddenReadIsCurrent),
          "ordinary reads see the current overriding profile"
        )
      } else {
        run Testing.expect(false, "override profile completes")
      }
      if let Result<FinalProfile, AssemblyProblem>.Success { value: current } = move restored {
        run Testing.expect(
          parameterIs(&current, b"first", 3),
          "a failed or changed request does not contaminate later defaults"
        )
        run Semantic.reviseProfile(&mut semantic, Option<FinalProfile>.some(move current))
        let read = run Semantic.demandInitializer(&mut semantic, &mut request, &entry, b"read")
        run Testing.expect(
          Shared<Result<Answer, NoRejection>>.with<bool>(&read, defaultReadIsCurrent),
          "ordinary static reads use the published profile"
        )
        let body = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"runtimeRead")
        let accepted = Shared<Result<Answer, NoRejection>>.with<bool>(&body, runtimeBodyAccepted)
        run Testing.expect(accepted, "ordinary runtime reads embed the published values")
      } else {
        run Testing.expect(false, "retry after failed validation completes")
      }
    } else {
      run Testing.expect(false, "registered scalar shapes resolve")
    }
    return ()
  }
  return run check() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn overridesBreakDefaultCyclesAndFailuresRestoreTheGraph() -> ()
  ! InvalidModulePath
    | OutOfMemoryError
    | Cycle
    | RevisionMismatch
    | RegistrationClosed
    | ConflictingPackageSource
    | InputProblem
    | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let check = effect fn() -> ()
    ! InvalidModulePath
      | OutOfMemoryError
      | Cycle
      | RevisionMismatch
      | RegistrationClosed
      | ConflictingPackageSource
      | InputProblem
      | AssertionError<'static>
    ? &mut Allocator | &mut Types {
    let entry = run ModuleId.make(b"memory", b"example", b"registered-parameters.silk")
    let source = Option<Bytes>.some(
      run Bytes.copy(
        String.utf8Bytes(
          """
pub param first: u32 = second
pub param second: u32 = first
"""
        )
      )
    )
    let revision = run Revision.publish(&Revision.make(), &entry, &source)
    let target = Target.forId(TargetId.X8664UnknownLinuxGnu)
    let mut semantic = Semantic.traced(move revision, target, Option<FinalProfile>.none())
    let mut request = Request.make()
    run Request.registerSchemaModule(&mut request, &entry)
    let shapes = run registered(&mut semantic, &mut request, &target)
    if let Result<Registered, ShapeProblem>.Success { value: schemas } = move shapes {
      let cycle = run assemble(
        run facts(),
        &mut semantic,
        &mut request,
        &schemas,
        List<Supplied>.make()
      )
      run Testing.expect(
        assemblyRejected(&cycle, RejectionCode.Cycle),
        "a revisited effective default is a semantic cycle"
      )
      let broken = run assemble(
        run facts(),
        &mut semantic,
        &mut request,
        &schemas,
        run binding(b"first", b"5")
      )
      if let Result<FinalProfile, AssemblyProblem>.Success { value } = move broken {
        run Testing.expect(
          parameterIs(&value, b"first", 5) && parameterIs(&value, b"second", 5),
          "an override stops traversal of its cyclic default"
        )
      } else {
        run Testing.expect(false, "an explicit value breaks the default cycle")
      }
      let again = run assemble(
        run facts(),
        &mut semantic,
        &mut request,
        &schemas,
        List<Supplied>.make()
      )
      run Testing.expect(
        assemblyRejected(&again, RejectionCode.Cycle),
        "removing the override restores the cycle without stale bindings"
      )
    } else {
      run Testing.expect(false, "cyclic defaults do not prevent schema registration")
    }
    return ()
  }
  return run check() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn unsupportedParameterTypesKeepTheirSchemaReason() -> ()
  ! InvalidModulePath
    | OutOfMemoryError
    | Cycle
    | RevisionMismatch
    | RegistrationClosed
    | ConflictingPackageSource
    | InputProblem
    | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let check = effect fn() -> ()
    ! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | RegistrationClosed | ConflictingPackageSource | InputProblem | AssertionError<'static>
    ? &mut Allocator | &mut Types {
    let entry = run ModuleId.make(b"memory", b"example", b"refused-parameters.silk")
    let source = Option<Bytes>.some(run Bytes.copy(String.utf8Bytes("param ratio: f64 = 1.0\n")))
    let revision = run Revision.publish(&Revision.make(), &entry, &source)
    let target = Target.forId(TargetId.X8664UnknownLinuxGnu)
    let mut semantic = Semantic.traced(move revision, target, Option<FinalProfile>.none())
    let mut request = Request.make()
    run Request.registerSchemaModule(&mut request, &entry)
    let shapes = run registeredOrRefused(&mut semantic, &mut request, &target)
    let kept = match &shapes {
      Result<Registered, Refusal>.Failure {error: Refusal.Rejected {rejection}} => carriesMessage(&rejection,
        b"a package parameter's type must be bool, an integer, a string, or a fixed array of them")
      _ => false
    }
    return run Testing.expect(kept, "a refused parameter type keeps the reason its schema rejected it")
  }
  return run check() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

// Registers and assembles one parameter module; a refused header becomes a `Default` problem so
// either refusal can be checked by its message.
effect fn assembledFrom(text: string<'static>, supplied: List<Supplied>) -> Result<FinalProfile, AssemblyProblem>
  ! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | RegistrationClosed | ConflictingPackageSource | InputProblem
  ? &mut Allocator | &mut Types {
  let entry = run ModuleId.make(b"memory", b"example", b"registered-parameters.silk")
  let source = Option<Bytes>.some(run Bytes.copy(String.utf8Bytes(text)))
  let revision = run Revision.publish(&Revision.make(), &entry, &source)
  let target = Target.forId(TargetId.X8664UnknownLinuxGnu)
  let mut semantic = Semantic.traced(move revision, target, Option<FinalProfile>.none())
  let mut request = Request.make()
  run Request.registerSchemaModule(&mut request, &entry)
  return match move run registeredOrRefused(&mut semantic, &mut request, &target) {
    Result<Registered, Refusal>.Success {value: schemas} => run assemble(run facts(), &mut semantic, &mut request, &schemas, move supplied)
    Result<Registered, Refusal>.Failure {error: Refusal.Rejected {rejection}} => Result<FinalProfile, AssemblyProblem>.failResult(
      AssemblyProblem.Default {rejection: move rejection})
    Result<Registered, Refusal>.Failure {error: _} => Result<FinalProfile, AssemblyProblem>.failResult(AssemblyProblem.InputMismatch)
  }
}

// Whether the assembly failed with a located `message` whose span starts at `start`.
fn refusedAt(result: &Result<FinalProfile, AssemblyProblem>, text: &[u8], start: usize) -> bool {
  return assemblyMessage(result, text) && match &result.* {
    Result<FinalProfile, AssemblyProblem>.Failure {error: AssemblyProblem.Default {rejection}} => Shared<Rejection>.with<bool>(&rejection,
      fn(value: &Rejection) -> bool { return value.span.start == start })
    _ => false
  }
}

test effect fn parameterRefusalsNameTheParameterWhereItIsDeclared() -> ()
  ! InvalidModulePath
    | OutOfMemoryError
    | Cycle
    | RevisionMismatch
    | RegistrationClosed
    | ConflictingPackageSource
    | InputProblem
    | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let check = effect fn() -> ()
    ! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | RegistrationClosed | ConflictingPackageSource | InputProblem | AssertionError<'static>
    ? &mut Allocator | &mut Types {
    let unbound = run assembledFrom("pub param x: i32\n", List<Supplied>.make())
    run Testing.expect(refusedAt(&unbound,
      b"package parameter `x` has no default value and no binding; give it a default or set it under `[config]` in silk.toml", 0),
      "an unbound parameter without a default is named at its declaration")
    let enumerated = run assembledFrom("enum E { A, B }\npub param e: E = E.A\n", List<Supplied>.make())
    run Testing.expect(refusedAt(&enumerated,
      b"package parameter `e` has an enum, struct, union or optional type, which package parameters do not support yet", 16),
      "an enum parameter is named at its declaration")
    // `?T` is a syntax error (PAR0007) whose recovery keeps the operand type and the default, so
    // the schema adds no second refusal, such as a private parameter missing its default.
    let optional = run assembledFrom("param o: ?i32 = 1\n", List<Supplied>.make())
    let recovered = match &optional {
      Result<FinalProfile, AssemblyProblem>.Success {value} => FinalProfile.entries(&value).length == usize.ONE
      _ => false
    }
    run Testing.expect(recovered, "a private `?T` parameter keeps its written default")
    let mistyped = run assembledFrom("param x: i32 = true\n", List<Supplied>.make())
    run Testing.expect(refusedAt(&mistyped, b"the default value of package parameter `x` does not have its type `i32`", 15),
      "a default of the wrong type names the parameter and its type at the default")
    let predicate = run assembledFrom("param x: i32 = 5 where x\n", List<Supplied>.make())
    run Testing.expect(refusedAt(&predicate, b"the `where` predicate of package parameter `x` is not a `bool`", 23),
      "a non-bool `where` predicate names the parameter at the predicate")
    let conditional = run assembledFrom("static if true {\n  param x: i32 = 5\n}\n", List<Supplied>.make())
    run Testing.expect(refusedAt(&conditional,
      b"package parameter `x` is declared inside a module-level `static if`; parameters are fixed before `static if` selects declarations, so a `param` cannot be conditional",
      19), "a conditional parameter is named at its declaration")
    return ()
  }
  return run check() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn matchingArrayBindingsAreAccepted() -> ()
  ! InvalidModulePath
    | OutOfMemoryError
    | Cycle
    | RevisionMismatch
    | RegistrationClosed
    | ConflictingPackageSource
    | InputProblem
    | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let check = effect fn() -> ()
    ! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | RegistrationClosed | ConflictingPackageSource | InputProblem | AssertionError<'static>
    ? &mut Allocator | &mut Types {
    let mut values = List<Box<BindingInput>>.make()
    run List<Box<BindingInput>>.append(&mut values, run Box<BindingInput>.make(BindingInput.Integer {decimal: run Bytes.copy(b"3")}))
    run List<Box<BindingInput>>.append(&mut values, run Box<BindingInput>.make(BindingInput.Integer {decimal: run Bytes.copy(b"4")}))
    let mut supplied = List<Supplied>.make()
    run List<Supplied>.append(&mut supplied, Supplied {
      package: run Bytes.copy(b"example"),
      module: run Bytes.copy(b"registered-parameters.silk"),
      parameter: run Bytes.copy(b"xs"),
      value: BindingInput.Array {values: move values},
      provenance: Provenance.Literal,
      tier: Tier.Override,
    })
    let bound = run assembledFrom("pub param xs: [i32; 2] = [1, 2]\n", move supplied)
    let accepted = match &bound {
      Result<FinalProfile, AssemblyProblem>.Success {value} => FinalProfile.entries(&value).length == usize.ONE
      _ => false
    }
    run Testing.expect(accepted, "an array binding that matches `[i32; 2]` is accepted")
    return ()
  }
  return run check() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}
