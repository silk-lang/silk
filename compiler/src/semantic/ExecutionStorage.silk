//! The selected `execution-storage` component (SUSP-005): the source C exports that create a
//! private frame storage state, acquire and release its frames, and destroy it.
//!
//! # Details
//!
//! A build reads the selection from its composition and demands a binding's module only when a
//! reached instance needs a frame. The compiler calls each operation by its export symbol and
//! never recognizes a provider by its module or declaration name.

import semantic.ModuleId {ModuleId}
import silk.allocator {Allocator, OutOfMemoryError}
import silk.bytes {Bytes}

/// One operation's source C export: the declaration named `declaration` in `module`.
pub struct Binding {
  pub module: ModuleId
  pub declaration: Bytes
}

/// The four bound operations of one selected component.
pub struct ExecutionStorage {
  pub create: Binding
  pub acquire: Binding
  pub release: Binding
  pub destroy: Binding
}

impl Binding {
  pub effect fn copy(self: &Self) -> Binding ! OutOfMemoryError ? &mut Allocator {
    return Binding {module: run ModuleId.copy(&self.module), declaration: run Bytes.copy(Bytes.asSlice(&self.declaration))}
  }
}

impl ExecutionStorage {
  pub effect fn copy(self: &Self) -> ExecutionStorage ! OutOfMemoryError ? &mut Allocator {
    return ExecutionStorage {
      create: run Binding.copy(&self.create),
      acquire: run Binding.copy(&self.acquire),
      release: run Binding.copy(&self.release),
      destroy: run Binding.copy(&self.destroy),
    }
  }
}
