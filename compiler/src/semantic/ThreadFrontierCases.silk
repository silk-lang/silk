//! Native lifecycle proofs for bounded persistent command workers.
import semantic.ThreadFrontier {Worker, Endpoint, TaskQueue}
import semantic.ThreadFrontier
import semantic.Published {Published}
import silk.concurrency.sync {Mutex}
import silk.concurrency.thread_native {SpawnError}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.core.effect {Effect}
import silk.core.option {Option}
import silk.core.result {Result}
import silk.collections.list {List}
import silk.num.usize
import silk.testing.testing {Testing, AssertionError}

fn finished(counter: &Published<Mutex<usize>>) -> () {
  let mut guard = Mutex<usize>.lock(Published<Mutex<usize>>.get(counter))
  let next = guard.get().* + 1
  let value = guard.getMut()
  value.* = next
}

fn count(counter: &Published<Mutex<usize>>) -> usize {
  let guard = Mutex<usize>.lock(Published<Mutex<usize>>.get(counter))
  return guard.get().*
}

fn accumulate(endpoint: Endpoint<usize, usize>, ended: Published<Mutex<usize>>) -> () {
  let mut commands = move endpoint
  let mut total: usize = 0
  while true {
    let command = match move Endpoint<usize, usize>.next(&mut commands) {
      Option<usize>.Some {value} => value
      Option<usize>.None => { break }
    }
    total = total + command
    if let Result<(), usize>.Failure {..} = move Endpoint<usize, usize>.reply(&mut commands, total) { break }
  }
  finished(&ended)
}

effect fn persistentClaims() -> ()
! OutOfMemoryError | SpawnError | AssertionError<'static> ? &mut Allocator {
  let ended = run Published<Mutex<usize>>.make(run Mutex<usize>.make(0))
  let held = Published<Mutex<usize>>.clone(&ended)
  let mut worker = run ThreadFrontier.start(fn(endpoint: Endpoint<usize, usize>) -> () {
    accumulate(move endpoint, move held)
  })
  run Testing.expect(match move Worker<usize, usize>.submit(&mut worker, 1) {
    Result<(), usize>.Success {..} => true _ => false
  }, "first command enters the empty channel")
  run Testing.expect(match move Worker<usize, usize>.submit(&mut worker, 9) {
    Result<(), usize>.Failure {error} => error == 9 _ => false
  }, "one outstanding command bounds work even after the worker has produced a reply")
  run Testing.expect(match move Worker<usize, usize>.receive(&mut worker) {
    Option<usize>.Some {value} => value == 1 _ => false
  }, "the first command returns its exact reply")
  drop Worker<usize, usize>.submit(&mut worker, 5)
  run Testing.expect(match move Worker<usize, usize>.receive(&mut worker) {
    Option<usize>.Some {value} => value == 6 _ => false
  }, "private worker state persists across command batches")
  Worker<usize, usize>.close(&mut worker)
  Worker<usize, usize>.close(&mut worker)
  run Testing.expect(Worker<usize, usize>.joined(&worker) && count(&ended) == 1,
    "closing wakes an idle worker and returns only after its private state has finished")
  run Testing.expect(match move Worker<usize, usize>.submit(&mut worker, 7) {
    Result<(), usize>.Failure {error} => error == 7 _ => false
  }, "a joined worker cannot accept a new command")
  let next = Published<Mutex<usize>>.clone(&ended)
  let abandoned = run ThreadFrontier.start(fn(endpoint: Endpoint<usize, usize>) -> () {
    accumulate(move endpoint, move next)
  })
  drop abandoned
  run Testing.expect(count(&ended) == 2, "dropping a controller joins its blocked worker without an explicit stop request")
}

effect fn earlyReturnClaims() -> ()
! OutOfMemoryError | SpawnError | AssertionError<'static> ? &mut Allocator {
  let mut worker = run ThreadFrontier.start(fn(endpoint: Endpoint<usize, usize>) -> () {
    let mut commands = move endpoint
    drop Endpoint<usize, usize>.next(&mut commands)
    // A failed provider can return before publishing a response. Its completion guard must wake
    // the parent without authorizing any partial result.
  })
  drop Worker<usize, usize>.submit(&mut worker, 11)
  run Testing.expect(match move Worker<usize, usize>.receive(&mut worker) {
    Option<usize>.None => true _ => false
  }, "an early worker return refuses the outstanding reply instead of waiting forever")
  Worker<usize, usize>.close(&mut worker)
  run Testing.expect(Worker<usize, usize>.joined(&worker), "an early-return worker still has one joined owner")
}

test effect fn threadFrontierRetainsPrivateStateAndJoinsBeforeReturn() -> ()
! OutOfMemoryError | SpawnError | AssertionError<'static> {
  if !ThreadFrontier.available() { return () }
  let mut allocator = Allocator.systemAllocatorProvider()
  run persistentClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn threadFrontierEarlyExitRefusesUnfinishedReply() -> ()
! OutOfMemoryError | SpawnError | AssertionError<'static> {
  if !ThreadFrontier.available() { return () }
  let mut allocator = Allocator.systemAllocatorProvider()
  run earlyReturnClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}


effect fn takeTasks(queue: &TaskQueue) -> List<usize> ! OutOfMemoryError ? &mut Allocator {
  let mut taken = List<usize>.make()
  while let Option<usize>.Some {value} = move TaskQueue.take(queue) {
    run List<usize>.append(&mut taken, value)
  }
  return move taken
}
fn taskWorker(endpoint: Endpoint<usize, List<usize>>, queue: TaskQueue) -> () {
  let mut commands = move endpoint
  if let Option<usize>.None = move Endpoint<usize, List<usize>>.next(&mut commands) { return () }
  let mut allocator = Allocator.systemAllocatorProvider()
  let result = run Effect.result(takeTasks(&queue)) |> Effect.provideMut<Allocator>(&mut allocator)
  if let Result<List<usize>, OutOfMemoryError>.Success {value} = move result {
    drop Endpoint<usize, List<usize>>.reply(&mut commands, move value)
  }
}
effect fn taskClaims() -> () ! OutOfMemoryError | SpawnError | AssertionError<'static> ? &mut Allocator {
  let queue = run TaskQueue.make(257)
  run Testing.expect(TaskQueue.claim(&queue, 11, 21, 0) && TaskQueue.claim(&queue, 11, 21, 0)
    && !TaskQueue.claim(&queue, 11, 21, 1), "a definition has one known producer and repeats in that producer remain local")
  run Testing.expect(TaskQueue.claim(&queue, 11, 22, 1) && TaskQueue.owner(&queue, 11, 21) == 0
    && TaskQueue.owner(&queue, 11, 22) == 1, "ownership compares the complete definition digest")
  run Testing.expect(TaskQueue.claim(&queue, 13, 24, usize.MAX) && TaskQueue.owner(&queue, 13, 24) == usize.MAX,
    "coordinator work cannot publish an unroutable producer")
  let left = TaskQueue.clone(&queue)
  let right = TaskQueue.clone(&queue)
  let mut first = run ThreadFrontier.start(fn(endpoint: Endpoint<usize, List<usize>>) -> () { taskWorker(move endpoint, move left) })
  let mut second = run ThreadFrontier.start(fn(endpoint: Endpoint<usize, List<usize>>) -> () { taskWorker(move endpoint, move right) })
  drop Worker<usize, List<usize>>.submit(&mut first, 0)
  drop Worker<usize, List<usize>>.submit(&mut second, 0)
  let responses = [Worker<usize, List<usize>>.receive(&mut first), Worker<usize, List<usize>>.receive(&mut second)]
  let mut seen = List<bool>.make()
  let mut at: usize = 0
  while at < 257 { run List<bool>.append(&mut seen, false) at = at + 1 }
  let mut count: usize = 0
  at = 0
  while at < responses.length {
    let values = match &responses[at] {
      Option<List<usize>>.Some {value} => List<usize>.asSlice(&value)
      _ => { run Testing.expect(false, "a completed task worker returns its claimed ordinals") return () }
    }
    let mut item: usize = 0
    while item < values.length {
      let task = values[item]
      run Testing.expect(task < 257 && !List<bool>.asSlice(&seen)[task], "native workers never claim a task twice")
      List<bool>.set(&mut seen, task, true)
      count = count + 1
      item = item + 1
    }
    at = at + 1
  }
  run Testing.expect(count == 257, "all fixed tasks are assigned before the proof barrier")
  Worker<usize, List<usize>>.close(&mut first)
  Worker<usize, List<usize>>.close(&mut second)
  let cancelled = run TaskQueue.make(1)
  TaskQueue.cancel(&cancelled)
  run Testing.expect(match move TaskQueue.take(&cancelled) { Option<usize>.None => true _ => false },
    "cancellation prevents new tasks while callers join executing workers")
}
test effect fn threadFrontierTasksAreUniqueAcrossNativeWorkers() -> ()
! OutOfMemoryError | SpawnError | AssertionError<'static> {
  if !ThreadFrontier.available() { return () }
  let mut allocator = Allocator.systemAllocatorProvider()
  run taskClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}
