//! Immutable syntax publication with private source-query and cursor authority.
import semantic.SourceEpoch {SourceEpoch}
import semantic.SourceIndex {SourceIndex, ParsedSource, IndexedSource, AuthoredCursor}
import semantic.SourceUnit {SourceUnit}
import semantic.SourceLocations {SourceLocations}
import semantic.SourceRevision {Revision, Observation}
import semantic.ModuleId {ModuleId, InvalidModulePath}
import semantic.Published {Published}
import semantic.Query {Cycle}
import silk.concurrency.thread_native {NativeThread, SpawnError}
import silk.collections.bytes {Bytes}
import silk.collections.list {List}
import silk.core.option {Option}
import silk.core.result {Result}
import silk.core.effect {Effect}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.testing.testing {Testing, AssertionError}

fn absent(value: &Option<Published<ParsedSource>>) -> bool {
  return match &value.* { Option<Published<ParsedSource>>.None => true _ => false }
}

effect fn publish(epoch: &SourceEpoch, module: &ModuleId) -> Option<Published<ParsedSource>>
! Cycle | OutOfMemoryError ? &mut Allocator {
  let mut index = SourceIndex.inEpoch(epoch)
  let answer = run SourceIndex.demand(&mut index, module)
  if let Option<&IndexedSource>.None = move SourceIndex.source(&index, &answer, module) {
    return Option<Published<ParsedSource>>.none()
  }
  return SourceEpoch.parsed(epoch, module)
}

fn threadParse(epoch: SourceEpoch, module: ModuleId) -> Option<Published<ParsedSource>> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let result = run Effect.result(publish(&epoch, &module)) |> Effect.provideMut<Allocator>(&mut allocator)
  return match move result {
    Result<Option<Published<ParsedSource>>, Cycle | OutOfMemoryError>.Success {value} => move value
    _ => Option<Published<ParsedSource>>.none()
  }
}

effect fn epochClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | AssertionError<'static> ? &mut Allocator {
  let module = run ModuleId.make(b"memory", b"epoch", b"entry.silk")
  let missing = run ModuleId.make(b"memory", b"epoch", b"later.silk")
  let content = Option<Bytes>.some(run Bytes.copy(b"fn entry() -> i32 { return 1 }\n"))
  let revision = run Revision.publish(&Revision.make(), &module, &content)
  let epoch = run SourceEpoch.make(move revision)
  let copied = SourceEpoch.clone(&epoch)
  run Testing.expect(SourceEpoch.same(&epoch, &copied), "cloned workers retain the same immutable epoch")
  let mut first = SourceIndex.inEpoch(&epoch)
  run Testing.expect(SourceIndex.matchesEpoch(&first, &epoch), "worker store retains its constructing epoch")
  let unit = run SourceUnit.parse(&module, 0, run Bytes.copy(b"fn entry() -> i32 { return 1 }\n"))
  let locations = Published<SourceLocations>.clone(&unit.locations)
  let mut offered = List<SourceUnit>.make()
  run List<SourceUnit>.append(&mut offered, move unit)
  SourceIndex.offerParsed(&mut first, move offered)
  run Testing.expect(absent(&SourceEpoch.parsed(&epoch, &module)), "an offered parse is not a completed index")
  let answer = run SourceIndex.demand(&mut first, &module)
  let ready = match move SourceEpoch.parsed(&epoch, &module) {
    Option<Published<ParsedSource>>.Some {value} => move value
    _ => { run Testing.expect(false, "completed source publishes its syntax") return () }
  }
  run Testing.expect(Published<SourceLocations>.same(&locations,
    &ParsedSource.sourceUnit(Published<ParsedSource>.get(&ready)).locations), "driver parse is retained rather than rebuilt")
  let mut second = SourceIndex.inEpoch(&epoch)
  let secondAnswer = run SourceIndex.demand(&mut second, &module)
  run Testing.expect(match move SourceIndex.source(&second, &secondAnswer, &module) {
    Option<&IndexedSource>.Some {..} => true _ => false
  }, "a separate query store can use the completed syntax")
  let again = SourceEpoch.parsed(&epoch, &module)
  run Testing.expect(match &again {
    Option<Published<ParsedSource>>.Some {value} => Published<ParsedSource>.same(&ready, &value)
    _ => false
  }, "workers share the same complete immutable parse")
  let cursor = run SourceIndex.authoredCursor(&mut first, &answer, &module)
  if let Option<AuthoredCursor>.Some {value} = move cursor {
    run Testing.expect(match move SourceIndex.sourceAtCursor(&second, &value) {
      Option<&IndexedSource>.None => true _ => false
    }, "shared syntax does not make private query cursors transferable")
  } else { run Testing.expect(false, "present source has a private cursor") }

  let changed = Option<Bytes>.some(run Bytes.copy(b"fn entry() -> i32 { return 2 }\n"))
  let edited = run Revision.publish(SourceEpoch.revision(&epoch), &module, &changed)
  let expanded = run Revision.publish(&edited, &missing, &content)
  let next = run SourceEpoch.make(move expanded)
  run Testing.expect(!SourceEpoch.same(&epoch, &next), "changed mappings create a distinct epoch")
  run Testing.expect(!SourceIndex.matchesEpoch(&first, &next), "a store cannot attach an unrelated epoch")
  run Testing.expect(absent(&SourceEpoch.keep(&next, &ready)), "a completed old parse cannot enter a changed-byte slot")
  let oldObservation = run Revision.observe(SourceEpoch.revision(&epoch), &module)
  run Testing.expect(!Observation.matches(&oldObservation, SourceEpoch.revision(&next)), "old epoch bytes remain exact after another snapshot is made")
  let oldAbsent = run Revision.observe(SourceEpoch.revision(&epoch), &missing)
  let newPresent = run Revision.observe(SourceEpoch.revision(&next), &missing)
  run Testing.expect(!Observation.isPresent(&oldAbsent) && Observation.isPresent(&newPresent), "absences remain pinned without consulting later source mappings")
  let newReady = run publish(&next, &module)
  run Testing.expect(match &newReady {
    Option<Published<ParsedSource>>.Some {value} => !Published<ParsedSource>.same(&ready, &value)
    _ => false
  }, "changed source builds a new immutable payload")
}

effect fn concurrentClaims() -> ()
! InvalidModulePath | OutOfMemoryError | SpawnError | AssertionError<'static> ? &mut Allocator {
  let module = run ModuleId.make(b"memory", b"epoch", b"race.silk")
  let content = Option<Bytes>.some(run Bytes.copy(b"fn value() -> bool { return true }\n"))
  let revision = run Revision.publish(&Revision.make(), &module, &content)
  let epoch = run SourceEpoch.make(move revision)
  let firstEpoch = SourceEpoch.clone(&epoch)
  let secondEpoch = SourceEpoch.clone(&epoch)
  let firstModule = ModuleId.copy(&module)
  let secondModule = ModuleId.copy(&module)
  let first = run NativeThread.spawn(fn() -> Option<Published<ParsedSource>> {
    return threadParse(move firstEpoch, move firstModule)
  })
  let second = run NativeThread.spawn(fn() -> Option<Published<ParsedSource>> {
    return threadParse(move secondEpoch, move secondModule)
  })
  // Join both workers before inspecting either result, including a failed publication.
  let firstResult = first.join()
  let secondResult = second.join()
  let left = match move firstResult {
    Option<Published<ParsedSource>>.Some {value} => move value
    _ => { run Testing.expect(false, "first worker completes source publication") return () }
  }
  let right = match move secondResult {
    Option<Published<ParsedSource>>.Some {value} => move value
    _ => { run Testing.expect(false, "second worker completes source publication") return () }
  }
  run Testing.expect(Published<ParsedSource>.same(&left, &right), "concurrent source stores select one completed syntax publication")
  let survivor = SourceEpoch.parsed(&epoch, &module)
  run Testing.expect(match &survivor {
    Option<Published<ParsedSource>>.Some {value} => Published<ParsedSource>.same(&left, &value)
    _ => false
  }, "published syntax survives both private query stores")
}

test effect fn sourceEpochKeepsExactSnapshotsAndPrivateCursors() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run epochClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn nativeSourceStoresShareOnlyCompletedSyntax() -> ()
! InvalidModulePath | OutOfMemoryError | SpawnError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run concurrentClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}
