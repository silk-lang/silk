//! Exact declaration coverage for independently checked pieces of one module sweep.
//!
//! Workers carry source identities and complete semantic answers, never query-store ordinals.
//! A parent publishes a module answer only after every declaration and its names are covered.

import semantic.StableKey
import semantic.RuntimeEncoding
import silk.collections.bytes {Bytes}
import silk.collections.list {List}
import silk.core.option {Option}
import silk.core.effect {Effect}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.num.u64
import silk.num.usize
import silk.testing.testing {AssertionError, Testing}

/// One completed ordered part of a module's declaration sweep and its escape-walk proof.
pub struct Packet {
  /// The exact stable module-sweep key, including its target/profile scope.
  pub sweep: Bytes,
  /// The exact stable escape-check key for this module and walk boundary.
  pub escape: Bytes,
  /// The complete module declaration roster's length.
  pub total: usize,
  /// The first declaration's position in that roster.
  pub start: usize,
  /// Exact stable declaration encodings in source-roster order.
  pub declarations: List<Bytes>,
  /// Whether this part also completed the module-wide name checks.
  pub namesChecked: bool,
  /// The exact ordered names checked; empty when `namesChecked` is false.
  pub names: List<Bytes>,
  /// The encoded sweep answer, including concrete bodies, deferred templates, and warnings.
  pub answer: Bytes,
  /// The encoded escape-walk fragment; every duplicate packet's fragment still needs validation.
  pub record: Bytes,
}

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] { return false }
    at = at + usize.ONE
  }
  return true
}

/// Encodes a completed chunk without persistent-cache nodes or source fingerprints.
pub effect fn encode(packet: &Packet) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut bytes = Bytes.make()
  run RuntimeEncoding.word(&mut bytes, 1)
  run RuntimeEncoding.field(&mut bytes, Bytes.asSlice(&packet.sweep))
  run RuntimeEncoding.field(&mut bytes, Bytes.asSlice(&packet.escape))
  run RuntimeEncoding.word(&mut bytes, usize.toU64(packet.total))
  run RuntimeEncoding.word(&mut bytes, usize.toU64(packet.start))
  let declarations = List<Bytes>.asSlice(&packet.declarations)
  run RuntimeEncoding.word(&mut bytes, usize.toU64(declarations.length))
  let mut at = usize.ZERO
  while at < declarations.length {
    run RuntimeEncoding.field(&mut bytes, Bytes.asSlice(&declarations[at]))
    at = at + usize.ONE
  }
  run RuntimeEncoding.word(&mut bytes, if packet.namesChecked { 1 } else { 0 })
  let names = List<Bytes>.asSlice(&packet.names)
  run RuntimeEncoding.word(&mut bytes, usize.toU64(names.length))
  at = usize.ZERO
  while at < names.length {
    run RuntimeEncoding.field(&mut bytes, Bytes.asSlice(&names[at]))
    at = at + usize.ONE
  }
  run RuntimeEncoding.field(&mut bytes, Bytes.asSlice(&packet.answer))
  run RuntimeEncoding.field(&mut bytes, Bytes.asSlice(&packet.record))
  return move bytes
}

effect fn field(bytes: &[u8], reader: &mut StableKey.Reader) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let span = StableKey.readField(bytes, &mut reader.*)
  if StableKey.failed(&reader.*) { return Bytes.make() }
  return run Bytes.copy(StableKey.view(bytes, span))
}

/// Decodes a bounded packet, refusing malformed fields and trailing bytes.
pub effect fn decode(bytes: &[u8]) -> Option<Packet> ! OutOfMemoryError ? &mut Allocator {
  let mut reader = StableKey.reader()
  if StableKey.readWord(bytes, &mut reader) != 1 { return Option<Packet>.none() }
  let sweep = run field(bytes, &mut reader)
  let escape = run field(bytes, &mut reader)
  let total = StableKey.readWord(bytes, &mut reader)
  let start = StableKey.readWord(bytes, &mut reader)
  let count = StableKey.readWord(bytes, &mut reader)
  if StableKey.failed(&reader) || total > 500000 || start > total || count > total - start { return Option<Packet>.none() }
  let mut declarations = List<Bytes>.make()
  let mut at: u64 = 0
  while at < count {
    let declaration = run field(bytes, &mut reader)
    if StableKey.failed(&reader) { return Option<Packet>.none() }
    run List<Bytes>.append(&mut declarations, move declaration)
    at = at + 1
  }
  let checked = StableKey.readWord(bytes, &mut reader)
  let namesCount = StableKey.readWord(bytes, &mut reader)
  if StableKey.failed(&reader) || checked > 1 || namesCount > 500000 { return Option<Packet>.none() }
  let mut names = List<Bytes>.make()
  at = 0
  while at < namesCount {
    let name = run field(bytes, &mut reader)
    if StableKey.failed(&reader) { return Option<Packet>.none() }
    run List<Bytes>.append(&mut names, move name)
    at = at + 1
  }
  let answer = run field(bytes, &mut reader)
  let record = run field(bytes, &mut reader)
  if !StableKey.finished(bytes, &reader) { return Option<Packet>.none() }
  return Option<Packet>.some(Packet {sweep: move sweep, escape: move escape, total: u64.toUsize(total), start: u64.toUsize(start),
    declarations: move declarations, namesChecked: checked == 1, names: move names, answer: move answer, record: move record})
}

/// Verifies exact complete roster/name coverage and returns unique chunks in declaration order.
///
/// Exact duplicate sweep answers may come from inherited worker state. Their proof records are
/// deliberately not deduplicated here: the caller must validate and merge every fragment.
pub effect fn order(packets: &[Packet], sweep: &[u8], declarations: &[Bytes], names: &[Bytes]) -> Option<List<usize>>
! OutOfMemoryError ? &mut Allocator {
  let mut unique = List<usize>.make()
  let mut at = usize.ZERO
  while at < packets.length {
    let packet = &packets[at]
    if !same(Bytes.asSlice(&packet.sweep), sweep) { at = at + usize.ONE continue }
    let owned = List<Bytes>.asSlice(&packet.declarations)
    if packet.total != declarations.length || packet.start > declarations.length
      || owned.length > declarations.length - packet.start
      || (owned.length == usize.ZERO && declarations.length != usize.ZERO) { return Option<List<usize>>.none() }
    let mut index = usize.ZERO
    while index < owned.length {
      if !same(Bytes.asSlice(&owned[index]), Bytes.asSlice(&declarations[packet.start + index])) { return Option<List<usize>>.none() }
      index = index + usize.ONE
    }
    let named = List<Bytes>.asSlice(&packet.names)
    if packet.namesChecked != (packet.start == usize.ZERO) { return Option<List<usize>>.none() }
    if packet.namesChecked {
      if named.length != names.length { return Option<List<usize>>.none() }
      index = usize.ZERO
      while index < named.length {
        if !same(Bytes.asSlice(&named[index]), Bytes.asSlice(&names[index])) { return Option<List<usize>>.none() }
        index = index + usize.ONE
      }
    } else { if named.length != usize.ZERO { return Option<List<usize>>.none() } }
    let prior = List<usize>.asSlice(&unique)
    let mut duplicate = false
    index = usize.ZERO
    while index < prior.length {
      let held = &packets[prior[index]]
      if !same(Bytes.asSlice(&held.escape), Bytes.asSlice(&packet.escape)) { return Option<List<usize>>.none() }
      if held.start == packet.start {
        if List<Bytes>.length(&held.declarations) != owned.length || !same(Bytes.asSlice(&held.answer), Bytes.asSlice(&packet.answer)) {
          return Option<List<usize>>.none()
        }
        duplicate = true
      }
      index = index + usize.ONE
    }
    if !duplicate { run List<usize>.append(&mut unique, at) }
    at = at + usize.ONE
  }
  if List<usize>.length(&unique) == usize.ZERO { return Option<List<usize>>.none() }
  let mut ordered = List<usize>.make()
  let selected = List<usize>.asSlice(&unique)
  let mut cursor = usize.ZERO
  while List<usize>.length(&ordered) < selected.length {
    let mut found = usize.MAX
    at = usize.ZERO
    while at < selected.length {
      if packets[selected[at]].start == cursor { found = selected[at] break }
      at = at + usize.ONE
    }
    if found == usize.MAX { return Option<List<usize>>.none() }
    run List<usize>.append(&mut ordered, found)
    cursor = cursor + List<Bytes>.length(&packets[found].declarations)
  }
  if cursor != declarations.length { return Option<List<usize>>.none() }
  return Option<List<usize>>.some(move ordered)
}

effect fn testPacket(start: usize, count: usize) -> Packet ! OutOfMemoryError ? &mut Allocator {
  let ids: [&[u8]; 3] = [b"a", b"b", b"c"]
  let mut declarations = List<Bytes>.make()
  let mut at = usize.ZERO
  while at < count {
    run List<Bytes>.append(&mut declarations, run Bytes.copy(ids[start + at]))
    at = at + usize.ONE
  }
  let mut names = List<Bytes>.make()
  if start == usize.ZERO { run List<Bytes>.append(&mut names, run Bytes.copy(b"name")) }
  return Packet {sweep: run Bytes.copy(b"sweep"), escape: run Bytes.copy(b"escape"), total: 3, start: start,
    declarations: move declarations, namesChecked: start == usize.ZERO, names: move names,
    answer: run Bytes.copy(b"clean"), record: run Bytes.copy(b"fragment")}
}

fn refused(value: &Option<List<usize>>) -> bool {
  return match &value.* { Option<List<usize>>.None => true _ => false }
}

test effect fn exactSweepCoverageRejectsMissingOrConflictingWork() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run coverageClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn coverageClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let whole = run testPacket(usize.ZERO, 3)
  let expected = List<Bytes>.asSlice(&whole.declarations)
  let names = List<Bytes>.asSlice(&whole.names)
  let mut packets = List<Packet>.make()
  run List<Packet>.append(&mut packets, run testPacket(2, usize.ONE))
  run List<Packet>.append(&mut packets, run testPacket(usize.ZERO, usize.ONE))
  run List<Packet>.append(&mut packets, run testPacket(usize.ONE, usize.ONE))
  let ordered = run order(List<Packet>.asSlice(&packets), b"sweep", expected, names)
  run Testing.expect(match &ordered {
    Option<List<usize>>.Some {value} => List<usize>.length(&value) == 3 && List<usize>.get(&value, usize.ZERO) == usize.ONE
      && List<usize>.get(&value, usize.ONE) == 2 && List<usize>.get(&value, 2) == usize.ZERO
    _ => false
  }, "complete chunks are published in declaration order regardless of worker completion order")
  let duplicate = run testPacket(usize.ONE, usize.ONE)
  run List<Packet>.append(&mut packets, move duplicate)
  run Testing.expect(!refused(&run order(List<Packet>.asSlice(&packets), b"sweep", expected, names)),
    "inherited duplicate sweep metadata retains complete coverage")
  let entries = List<Packet>.asMutSlice(&mut packets)
  entries[3].answer = run Bytes.copy(b"conflicting")
  run Testing.expect(refused(&run order(List<Packet>.asSlice(&packets), b"sweep", expected, names)),
    "duplicate declarations cannot disagree about their semantic answer")
  drop List<Packet>.pop(&mut packets)
  drop List<Packet>.pop(&mut packets)
  run Testing.expect(refused(&run order(List<Packet>.asSlice(&packets), b"sweep", expected, names)),
    "a missing declaration range never becomes a whole module answer")
  run List<Packet>.append(&mut packets, run testPacket(usize.ZERO, 2))
  run Testing.expect(refused(&run order(List<Packet>.asSlice(&packets), b"sweep", expected, names)),
    "overlapping chunks are refused even when they cover every declaration")
  drop List<Packet>.pop(&mut packets)
  run List<Packet>.append(&mut packets, run testPacket(usize.ONE, usize.ONE))
  let missingNames = List<Packet>.asMutSlice(&mut packets)
  missingNames[usize.ONE].namesChecked = false
  run Testing.expect(refused(&run order(List<Packet>.asSlice(&packets), b"sweep", expected, names)),
    "declaration checks alone do not prove the module-wide names were checked")
  let restoredNames = List<Packet>.asMutSlice(&mut packets)
  restoredNames[usize.ONE].namesChecked = true
  let mut wrong = run testPacket(usize.ONE, usize.ONE)
  wrong.declarations = List<Bytes>.make()
  run List<Bytes>.append(&mut wrong.declarations, run Bytes.copy(b"different"))
  drop List<Packet>.pop(&mut packets)
  run List<Packet>.append(&mut packets, move wrong)
  run Testing.expect(refused(&run order(List<Packet>.asSlice(&packets), b"sweep", expected, names)),
    "equal counts and ranges cannot substitute a different declaration identity")
  let mut encoded = run encode(&whole)
  let decoded = run decode(Bytes.asSlice(&encoded))
  run Testing.expect(match &decoded {
    Option<Packet>.Some {value} => value.total == 3 && value.namesChecked && List<Bytes>.length(&value.declarations) == 3
      && same(Bytes.asSlice(&value.answer), b"clean") && same(Bytes.asSlice(&value.record), b"fragment")
    _ => false
  }, "transport preserves the exact roster and semantic proof payloads")
  run Bytes.append(&mut encoded, b"trailing")
  run Testing.expect(match &run decode(Bytes.asSlice(&encoded)) { Option<Packet>.None => true _ => false },
    "trailing transport bytes cannot silently change the published packet")
  return ()
}
