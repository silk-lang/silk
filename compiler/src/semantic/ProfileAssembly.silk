//! Assemble one final profile from frozen facts, registered source defaults, and checked bindings.

import semantic.Types {Types}
import semantic.DeclarationId { DeclarationId }
import semantic.FinalProfile { Entry, FinalProfile, Origin, Problem }
import semantic.InitialProfile { InitialProfile }
import semantic.ModuleId { InvalidModulePath }
import semantic.ParameterSchema { ParameterSchema }
import semantic.ProfileBinding
import semantic.ProfileBinding { BindingError, Checked, RegisteredShape, Supplied }
import semantic.ProfileShape { Registered }
import semantic.Query { Cycle }
import semantic.Rejection { Rejection }
import semantic.Semantic { Answer, Outcome, RegisteredParameter, Request, Semantic, Value }
import semantic.SourceLocations { Location }
import semantic.SourceIndex { NoRejection, RevisionMismatch }
import semantic.StaticValue { Value as StaticData }
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.option { Option }
import silk.result { Result }
import silk.shared { Shared }
import silk.usize
import silk.vector { Vector }

/// A rejected binding or incomplete result prevents publication of a final profile.
pub union AssemblyProblem {
  /// The semantic store was opened for different frozen facts.
  InputMismatch,
  Binding { pub error: BindingError },
  Default { pub rejection: Shared<Rejection> },
  Profile { pub error: Problem },
}

struct EvaluatedDefault {
  value: Shared<StaticData>
  location: Location
}

fn selectedDefault(answer: &Result<Answer, NoRejection>) -> Option<EvaluatedDefault> {
  return match &answer.* {
    Result<Answer, NoRejection>.Success { value } => match &value.outcome {
      Outcome.Success {
        value: Value.ParameterDefault { value: found, location }
      } => Option<
        EvaluatedDefault,
      >.some(EvaluatedDefault { value: Shared<StaticData>.clone(&found), location: location },)
      _ => Option<EvaluatedDefault>.none()
    }
    Result<Answer, NoRejection>.Failure { error: _ } => Option<EvaluatedDefault>.none()
  }
}

fn defaultRejection(answer: &Result<Answer, NoRejection>) -> Option<Shared<Rejection>> {
  return match &answer.* {
    Result<Answer, NoRejection>.Success { value } => match &value.outcome {
      Outcome.Rejected {
        diagnostic
      } => Option<Shared<Rejection>>.some(Shared<Rejection>.clone(&diagnostic))
      _ => Option<Shared<Rejection>>.none()
    }
    Result<Answer, NoRejection>.Failure { error: _ } => Option<Shared<Rejection>>.none()
  }
}

fn rejectedDefault(answer: &Shared<Result<Answer, NoRejection>>) -> AssemblyProblem {
  let rejection = Shared<
    Result<Answer, NoRejection>,
  >.with<
    Option<Shared<Rejection>>,
  >(answer, defaultRejection,)
  return match move rejection {
    Option<Shared<Rejection>>.Some { value } => AssemblyProblem.Default { rejection: move value }
    Option<Shared<Rejection>>.None => AssemblyProblem.Profile { error: Problem.MissingParameter }
  }
}

// The checked binding that targets this parameter, when one was supplied.
fn firstTargeting(checkedValues: &[Checked], identity: &DeclarationId) -> Option<usize> {
  let mut candidate = usize.ZERO
  while candidate < checkedValues.length {
    if ProfileBinding.targets(&checkedValues[candidate], identity) {
      return Option<usize>.some(candidate)
    }
    candidate = candidate + usize.ONE
  }
  return Option<usize>.none()
}

// Evaluates the source default of a parameter that no binding supplies.
effect fn evaluatedDefault(
  semantic: &mut Semantic,
  request: &mut Request,
  registered: &RegisteredShape,
  identity: &DeclarationId,
) -> Result<EvaluatedDefault, AssemblyProblem>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
  let hasDefault = Shared<
    ParameterSchema,
  >.with<
    bool,
  >(
    &registered.schema,
    fn(header: &ParameterSchema) -> bool {
      return header.hasDefault
    },
  )
  if
    !hasDefault {
    return Result<
      EvaluatedDefault,
      AssemblyProblem,
    >.failResult(AssemblyProblem.Profile { error: Problem.MissingParameter },)
  }
  let answer = run Semantic.demandParameterDefault(&mut semantic.*, &mut request.*, identity)
  let found = Shared<
    Result<Answer, NoRejection>,
  >.with<
    Option<EvaluatedDefault>,
  >(&answer, selectedDefault,)
  let evaluated = match move found {
    Option<EvaluatedDefault>.Some { value } => move value
    Option<EvaluatedDefault>.None => {
      return Result<EvaluatedDefault, AssemblyProblem>.failResult(rejectedDefault(&answer))
    }
  }
  return Result<EvaluatedDefault, AssemblyProblem>.succeed(move evaluated)
}

/// Selects validated CLI bindings over evaluated defaults and publishes one complete profile.
effect fn resolveValues(
  initial: InitialProfile,
  semantic: &mut Semantic,
  request: &mut Request,
  registered: &Registered,
  checked: Vector<Checked>,
) -> Result<FinalProfile, AssemblyProblem>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
  let schemas = Vector<RegisteredShape>.asSlice(&registered.schemas)
  let parameters = Vector<RegisteredParameter>.asSlice(&registered.parameters)
  let checkedValues = Vector<Checked>.asSlice(&checked)
  let mut entries = Vector<Entry>.make()
  let mut at = usize.ZERO
  while at < parameters.length {
    let key = &parameters[at]
    let winner = firstTargeting(checkedValues, &key.identity)
    if let Option<usize>.Some { value: index } = move winner {
      run Vector<
        Entry,
      >.append(
        &mut entries,
        Entry {
          declaration: DeclarationId.copy(&key.identity),
          value: ProfileBinding.value(&checkedValues[index]),
          origin: run FinalProfile.bindingOrigin(
            ProfileBinding.ordinal(&checkedValues[index]),
            ProfileBinding.provenance(&checkedValues[index]),
          ),
        },
      )
    } else {
      let defaulted = run evaluatedDefault(
        &mut semantic.*,
        &mut request.*,
        &schemas[at],
        &key.identity
      )
      let evaluated = match move defaulted {
        Result<EvaluatedDefault, AssemblyProblem>.Success { value } => move value
        Result<EvaluatedDefault, AssemblyProblem>.Failure { error } => {
          return Result<FinalProfile, AssemblyProblem>.failResult(move error)
        }
      }
      run Vector<
        Entry,
      >.append(
        &mut entries,
        Entry {
          declaration: DeclarationId.copy(&key.identity),
          value: move evaluated.value,
          origin: Origin.Default {
            span: run Semantic.parameterSpan(&mut semantic.*, &key.identity, evaluated.location),
          },
        },
      )
    }
    at = at + usize.ONE
  }
  let mut complete = Vector<Entry>.make()
  let values = Vector<Entry>.asSlice(&entries)
  at = usize.ZERO
  while at < values.length {
    run Vector<Entry>.append(&mut complete, run FinalProfile.copyEntry(&values[at]))
    at = at + usize.ONE
  }
  Semantic.selectAssemblyValues(&mut semantic.*, move complete)
  let mut predicates = Vector<DeclarationId>.make()
  at = usize.ZERO
  while at < parameters.length {
    let validated = run Semantic.validateParameter(
      &mut semantic.*,
      &mut request.*,
      &parameters[at].identity
    )
    if let Result<(), Shared<Rejection>>.Failure { error } = move validated {
      return Result<
        FinalProfile,
        AssemblyProblem,
      >.failResult(AssemblyProblem.Default { rejection: move error })
    }
    run Vector<
      DeclarationId,
    >.append(&mut predicates, DeclarationId.copy(&parameters[at].identity))
    at = at + usize.ONE
  }
  return match move run FinalProfile.publish(
    move initial,
    schemas,
    move entries,
    Vector<DeclarationId>.asSlice(&predicates)
  ) {
    Result<FinalProfile, Problem>.Success {
      value
    } => Result<FinalProfile, AssemblyProblem>.succeed(move value,)
    Result<FinalProfile, Problem>.Failure {
      error
    } => Result<
      FinalProfile,
      AssemblyProblem,
    >.failResult(AssemblyProblem.Profile { error: move error })
  }
}

struct AssemblySession<'a> {
  semantic: &'a mut Semantic
  previous: usize
}

/// Resolves effective defaults lazily, then validates every predicate against the complete map.
pub effect fn assemble<'semantic>(
  initial: InitialProfile,
  semantic: &'semantic mut Semantic,
  request: &mut Request,
  registered: &Registered,
  supplied: Vector<Supplied>,
) -> Result<FinalProfile, AssemblyProblem>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
  if
    !run Semantic.bindAssemblyFacts(&mut semantic.*, &initial) {
    return Result<FinalProfile, AssemblyProblem>.failResult(AssemblyProblem.InputMismatch)
  }
  let checked = match move run ProfileBinding.prepare(
    move supplied,
    Vector<RegisteredShape>.asSlice(&registered.schemas)
  ) {
    Result<Vector<Checked>, BindingError>.Success { value } => move value
    Result<Vector<Checked>, BindingError>.Failure { error } => {
      return Result<
        FinalProfile,
        AssemblyProblem,
      >.failResult(AssemblyProblem.Binding { error: move error })
    }
  }
  let parameters = Vector<RegisteredParameter>.asSlice(&registered.parameters)
  let checkedValues = Vector<Checked>.asSlice(&checked)
  let mut identities = Vector<DeclarationId>.make()
  let mut bindings = Vector<Entry>.make()
  let mut at = usize.ZERO
  while at < parameters.length {
    run Vector<
      DeclarationId,
    >.append(&mut identities, DeclarationId.copy(&parameters[at].identity))
    if let Option<usize>.Some {
      value: index
    } = move firstTargeting(checkedValues, &parameters[at].identity) {
      run Vector<
        Entry,
      >.append(
        &mut bindings,
        Entry {
          declaration: DeclarationId.copy(&parameters[at].identity),
          value: ProfileBinding.value(&checkedValues[index]),
          origin: run FinalProfile.bindingOrigin(
            ProfileBinding.ordinal(&checkedValues[index]),
            ProfileBinding.provenance(&checkedValues[index])
          ),
        }
      )
    }
    at = at + usize.ONE
  }
  let previous = Semantic.beginParameterAssembly(&mut semantic.*, move identities, move bindings)
  let session = AssemblySession<'semantic> { semantic: move semantic, previous: previous }
  let use = effect fn(session: &mut AssemblySession<'semantic>) -> Result<FinalProfile, AssemblyProblem>
    ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
    ? &mut Allocator | &mut Types {
    return run resolveValues(
      move initial,
      &mut session.*.semantic.*,
      &mut request.*,
      registered,
      move checked
    )
  }
  let release = effect fn(session: &mut AssemblySession<'semantic>) -> () {
    let previous = session.previous
    Semantic.endParameterAssembly(&mut session.*.semantic.*, previous)
    return ()
  }
  return run Effect.useReleaseNonParking(move session, move use, move release)
}
