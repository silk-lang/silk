//! Diagnostic-only expensive-provider accounting. No keys are encoded and no I/O occurs
//! per event. Rows are bounded; overflow remains explicit rather than becoming a partial census.
import silk.core.ownership {Copy}
import silk.core.effect {Effect}
import silk.testing.testing {Testing, AssertionError}
import semantic.FrontierHost {FrontierHost}
import semantic.InternIndex {InternIndex}
import silk.collections.list {List}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.mem.pointer {Pointer}
import silk.num.usize
import silk.num.u64
import silk.num.i32

pub struct Row {
  pub unit: usize,
  pub starts: usize,
  pub finishes: usize,
  pub hits: usize,
  pub preexistingUnitHits: usize,
  pub newUnitHits: usize,
  pub unmatchedFinishes: usize,
  pub provenanceMentions: usize,
}
impl Copy for Row {}
pub struct Census {
  pub enabled: bool,
  pub rows: List<Row>,
  lookup: InternIndex,
  pub preexistingUnits: usize,
  // Overflow counts events whose new unit could not be recorded, not distinct keys.
  pub dropped: usize,
}
pub fn make(immutable: bool) -> Census {
  let enabled = immutable && !Pointer.isNullMany<u8>(unsafe FrontierHost.environment(Pointer.fromSlice<u8>(b"SILK_QUERY_RUN_CENSUS\0")))
  return Census {enabled: enabled, rows: List<Row>.make(), lookup: InternIndex.make(), preexistingUnits: usize.ZERO, dropped: usize.ZERO}
}
/// Begins a distinct child's accounting; the boundary classifies preexisting keys, not inherited memo ownership.
pub fn fork(self: &mut Census, units: usize) -> () {
  if !self.enabled { return () }
  self.rows = List<Row>.make()
  self.lookup = InternIndex.make()
  self.preexistingUnits = units
  self.dropped = usize.ZERO
}
/// Event 0 starts a provider, 1 finishes it, 2 hits a memo, 3 mentions query provenance.
pub effect fn record(self: &mut Census, unit: usize, event: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  if !self.enabled { return () }
  let mut found = InternIndex.first(&self.lookup, usize.toU64(unit))
  while found != usize.MAX && List<Row>.asSlice(&self.rows)[found].unit != unit { found = InternIndex.after(&self.lookup, found) }
  if found == usize.MAX {
    if List<Row>.length(&self.rows) >= 131072 { self.dropped = self.dropped + usize.ONE return () }
    found = List<Row>.length(&self.rows)
    run List<Row>.append(&mut self.rows, Row {unit: unit, starts: 0, finishes: 0, hits: 0, preexistingUnitHits: 0,
      newUnitHits: 0, unmatchedFinishes: 0, provenanceMentions: 0})
    run InternIndex.record(&mut self.lookup, usize.toU64(unit))
  }
  let rows = List<Row>.asMutSlice(&mut self.rows)
  let row = &mut rows[found]
  if event == 0 { row.starts = row.starts + usize.ONE }
  else if event == 1 {
    if row.finishes < row.starts { row.finishes = row.finishes + usize.ONE }
    else { row.unmatchedFinishes = row.unmatchedFinishes + usize.ONE }
  } else if event == 2 {
    row.hits = row.hits + usize.ONE
    if row.starts == usize.ZERO {
      if unit < self.preexistingUnits { row.preexistingUnitHits = row.preexistingUnitHits + usize.ONE }
      else { row.newUnitHits = row.newUnitHits + usize.ONE }
    }
  } else if event == 3 { row.provenanceMentions = row.provenanceMentions + usize.ONE }
}
static if Intrinsic.targetOperatingSystem() == "linux" && Intrinsic.profileText("libc") == "gnu"
  && (Intrinsic.targetArchitecture() == "x86_64" || Intrinsic.targetArchitecture() == "aarch64") {
  unsafe extern "C" fn censusPid() -> i32 as "getpid"
  pub fn process() -> usize { return i32.toUsize(unsafe censusPid()) }
} else {
  pub fn process() -> usize { return usize.ZERO }
}

effect fn censusClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut census = make(false)
  run record(&mut census, 3, 0)
  run Testing.expect(List<Row>.length(&census.rows) == usize.ZERO, "disabled accounting creates no rows")
  census.enabled = true
  run record(&mut census, 3, 0)
  run record(&mut census, 3, 1)
  run record(&mut census, 3, 2)
  run record(&mut census, 3, 3)
  let row = List<Row>.get(&census.rows, usize.ZERO)
  run Testing.expect(row.starts == 1 && row.finishes == 1 && row.hits == 1 && row.provenanceMentions == 1
    && row.preexistingUnitHits == 0 && row.newUnitHits == 0, "memo and provenance reuse do not add provider starts")
  fork(&mut census, 5)
  run record(&mut census, 3, 2)
  run record(&mut census, 7, 2)
  run record(&mut census, 3, 1)
  run record(&mut census, 7, 0)
  run record(&mut census, 7, 1)
  let old = List<Row>.get(&census.rows, usize.ZERO)
  let fresh = List<Row>.get(&census.rows, usize.ONE)
  run Testing.expect(old.starts == 0 && old.finishes == 0 && old.preexistingUnitHits == 1 && old.unmatchedFinishes == 1
    && fresh.starts == 1 && fresh.finishes == 1 && fresh.newUnitHits == 1,
    "fork reset separates local work and key-age hits without claiming memo ownership")
}

test effect fn expensiveQueryCensusSeparatesWorkHitsAndProvenance() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run censusClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}
