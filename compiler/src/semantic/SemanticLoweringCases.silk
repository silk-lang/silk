test effect fn genericNominalBorrowArgumentsPreserveActualRegions() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("generic-nominal-borrow-regions.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
struct Ref<'a, T> { value: &'a T }
fn fixedBorrow<'a>(source: &'a i32) -> Ref<'a, i32> { return Ref<'a, i32> { value: &source.* } }
fn partialBorrow<'a>(source: &'a i32) -> Ref<'a, i32> { let held = Ref<'a> { value: source } return move held }
fn escapingBorrow() -> Ref<'static, i32> { let local = 42 return Ref<'static, i32> { value: &local } }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu)) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let fixedBorrow = run Semantic.demandBody(&mut store, &mut request, &id, b"fixedBorrow") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(succeeded(&fixedBorrow), "a fully written aggregate lifetime preserves a borrow of the caller's parameter instead of replacing it with a local region")
  let partialBorrow = run Semantic.demandBody(&mut store, &mut request, &id, b"partialBorrow") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(succeeded(&partialBorrow), "a fixed lifetime prefix keeps its proven source region while inferring only the omitted value type")
  let escapingBorrow = run Semantic.demandBody(&mut store, &mut request, &id, b"escapingBorrow") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsSpan(&escapingBorrow, RejectionCode.TypeMismatch, text, "&local", usize.ZERO),
    "a static aggregate annotation cannot manufacture a static loan from owned local storage")
  return ()
}

test effect fn genericBoundedOwnerSuppliesReceiverHeaderAndFieldCopy() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("generic-bounded-owner-member.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
struct Box<T: Copy> { value: T }
impl<T> Box<T> { fn copied(self: &Box<T>) -> T { return self.value } }
fn caller<U: Copy>(boxed: &Box<U>) -> U { return boxed.copied() }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu)) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let caller = run Semantic.demandBody(&mut store, &mut request, &id, b"caller") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(succeeded(&caller), "a borrowed receiver applies its bounded owner under the caller's Copy premise")
  let application = run directApplicationAt(&caller, usize.ZERO) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut headerChecked = false
  let mut fieldCopied = false
  if let Option<SpecializationApplication>.Some {value} = move application {
    let declaration = SpecializationApplication.bodyDeclaration(&value)
    let signature = run Semantic.demandSignatureOf(&mut store, &mut request, declaration) |> Effect.provideMut<Allocator>(&mut allocator)
    headerChecked = succeeded(&signature)
    let mut dependencies = Vector.make<Dependency>()
    let mut port = Semantic.staticPort(&mut store, &mut dependencies)
    let body = run StaticPort.demandBody(&mut port, declaration, Span.make(usize.ZERO, usize.ZERO)) |> Effect.provideMut<Allocator>(&mut allocator)
    if let Option<Shared<Result<Answer, NoRejection>>>.Some {value: checked} = move body {
      fieldCopied = Shared.with<Result<Answer, NoRejection>, bool>(&checked, bodyAnswerIsContractTyped)
        && bodyProjects(&checked, usize.ZERO)
    }
  }
  run Testing.expect(headerChecked, "an inherent receiver header inherits the owner's substituted Copy premise without a new impl bound")
  run Testing.expect(fieldCopied, "the abstract inherent body copies its borrowed generic field using only the owner's Copy premise")
  return ()
}

test effect fn genericRecordInstancesInferAndLayoutSeparately() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("generic-record-instances.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let mut store = run staticSemantic(&id, """
struct Cell<T> {
  marker: u8
  value: T
}
fn small(value: u8) -> u8 {
  let cell = Cell { marker: 1, value: value }
  return cell.value
}
fn wide(value: i64) -> i64 {
  let cell = Cell { marker: 1, value: value }
  return cell.value
}
fn matched(value: Cell<i64>) -> i64 {
  return match move value {
    Cell<i64> { value, .. } => value
  }
}
struct View<'data, A> { items: &'data [A] }
fn sliced() -> i32 {
  let values = [42]
  let view = View { items: &values }
  return view.items[0]
}
struct Borrowed<'data> { left: &'data i32 right: &'data i32 }
fn borrowed() -> i32 {
  let left = 20
  let right = 22
  let value = Borrowed { left: &left, right: &right }
  return value.left.* + value.right.*
}
""", MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let smallAnswer = run Semantic.demandBody(&mut store, &mut request, &id, b"small")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let wideAnswer = run Semantic.demandBody(&mut store, &mut request, &id, b"wide")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let slicedAnswer = run Semantic.demandBody(&mut store, &mut request, &id, b"sliced")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let matchedAnswer = run Semantic.demandMir(&mut store, &mut request, &id, b"matched")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let borrowedAnswer = run Semantic.demandBody(&mut store, &mut request, &id, b"borrowed")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let smallType = match move bodyLocalType(&smallAnswer, usize.ONE) {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => {
      run Testing.expect(false, "the inferred Cell<u8> local retains its complete nominal type")
      return ()
    }
  }
  let wideType = match move bodyLocalType(&wideAnswer, usize.ONE) {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => {
      run Testing.expect(false, "the inferred Cell<i64> local retains its complete nominal type")
      return ()
    }
  }
  let complete = nominalOfKind(&smallType, OwnerKind.Struct)
    && nominalOfKind(&wideType, OwnerKind.Struct)
    && !Type.hasOpenParameters(&smallType)
    && !Type.hasOpenParameters(&wideType)
  let distinct = !(run Type.equalsShared(&smallType, &wideType)
    |> Effect.provideMut<Allocator>(&mut allocator))
  let matched = match move Shared.with<Result<Answer, NoRejection>, Option<usize>>(&matchedAnswer, selectedMirIndex) {
    Option<usize>.Some {..} => true
    Option<usize>.None => false
  }
  run Testing.expect(
    complete,
    "bare generic record literals infer complete nominal applications",
  )
  run Testing.expect(distinct, "different initializer types infer distinct generic record applications")
  run Testing.expect(
    matched,
    "a complete generic record pattern binds its substituted field in MIR",
  )
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(&slicedAnswer, bodyAnswerIsContractTyped),
    "an inferred slice field lowers a borrowed array through the shared slice conversion",
  )
  run Testing.expect(
    succeeded(&borrowedAnswer),
    "one inferred lifetime is shared by every written borrow in a generic record literal",
  )
  let smallLayout = run Semantic.demandLayout(&mut store, &mut request, &id, &smallType)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let repeatedLayout = run Semantic.demandLayout(&mut store, &mut request, &id, &smallType)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let wideLayout = run Semantic.demandLayout(&mut store, &mut request, &id, &wideType)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let smallIndex = Shared.with<Result<Answer, NoRejection>, Option<usize>>(&smallLayout, selectedLayoutIndex)
  let repeatedIndex = Shared.with<Result<Answer, NoRejection>, Option<usize>>(&repeatedLayout, selectedLayoutIndex)
  let wideIndex = Shared.with<Result<Answer, NoRejection>, Option<usize>>(&wideLayout, selectedLayoutIndex)
  let mut interned = false
  let mut laidOut = false
  if let Option<usize>.Some {value: small} = move smallIndex {
    if let Option<usize>.Some {value: repeated} = move repeatedIndex {
      if let Option<usize>.Some {value: wide} = move wideIndex {
        interned = small == repeated && small != wide
        let smallFacts = Semantic.layoutAt(&store, small)
        let wideFacts = Semantic.layoutAt(&store, wide)
        if let Option<Shared<BackendLayout>>.Some {value: narrow} = move smallFacts {
          if let Option<Shared<BackendLayout>>.Some {value: broad} = move wideFacts {
            laidOut = Shared.with<BackendLayout, bool>(&narrow, fn(layout: &BackendLayout) -> bool {
              return genericRecordLayout(layout, 2, usize.ONE, usize.ONE)
            }) && Shared.with<BackendLayout, bool>(&broad, fn(layout: &BackendLayout) -> bool {
              return genericRecordLayout(layout, 16, 8, 8)
            })
          }
        }
      }
    }
  }
  run Testing.expect(interned, "equal complete record instances share one interned layout and distinct instances do not")
  run Testing.expect(laidOut, "generic record layout uses each complete instance's substituted field types")
  return ()
}

test effect fn genericRecordInstancesClassifyCopyAndShareDropGlue() -> ()
! CanonicalizationFailure | InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("generic-record-ownership.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
struct Token { value: i32 }
impl Drop for Token { fn drop(self: &mut Token) -> () { return () } }
struct Box<T> { value: T }
impl<T: Copy> Copy for Box<T> {}
fn copied(boxed: &Box<i32>) -> i32 { drop boxed.* return 0 }
fn affine(boxed: &Box<Token>) -> i32 { drop boxed.* return 0 }
fn dropped(boxed: Box<Token>) -> i32 { drop boxed return 0 }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let copied = run Semantic.demandBody(&mut store, &mut request, &id, b"copied")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let affine = run Semantic.demandBody(&mut store, &mut request, &id, b"affine")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(succeeded(&copied), "Box<i32> satisfies the generic record's declared Copy bound")
  run Testing.expect(
    rejectsSpan(
      &affine,
      RejectionCode.BorrowedExtraction,
      text,
      "boxed.*",
      1,
    ),
    "Box<Token> remains affine because Token does not satisfy the declared Copy bound",
  )
  let firstDrop = run Semantic.demandMir(&mut store, &mut request, &id, b"dropped")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let firstGlue = run droppedGlue(&mut store, &mut request, &id, b"dropped")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let secondGlue = run droppedGlue(&mut store, &mut request, &id, b"dropped")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let firstIndex = Shared.with<Result<Answer, NoRejection>, Option<usize>>(&firstGlue, selectedMirIndex)
  let secondIndex = Shared.with<Result<Answer, NoRejection>, Option<usize>>(&secondGlue, selectedMirIndex)
  let sharedGlue = match move firstIndex {
    Option<usize>.Some {value: first} => match move secondIndex {
      Option<usize>.Some {value: second} => first == second
      Option<usize>.None => false
    }
    Option<usize>.None => false
  }
  run Testing.expect(
    sharedGlue && glueFact(&store, &firstGlue, usize.ZERO) == usize.ONE
      && glueFact(&store, &firstGlue, 3) == usize.ZERO
      && glueFact(&store, &firstGlue, 6) == usize.ONE,
    "one Box<Token> glue instance drops its substituted Token field through Token glue",
  )
  let copyType = referentOf(bodyLocalType(&copied, usize.ZERO))
  let dropType = droppedType(&store, &firstDrop)
  let repeatedDropType = droppedType(&store, &firstDrop)
  let mut keyed = false
  if let Option<Shared<Type>>.Some {value: plain} = move copyType {
    if let Option<Shared<Type>>.Some {value: droppable} = move dropType {
      if let Option<Shared<Type>>.Some {value: repeated} = move repeatedDropType {
  let copyOwner = run glueSourceOwner(&mut store, &copied) |> Effect.provideMut<Allocator>(&mut allocator)
  let dropOwner = run glueSourceOwner(&mut store, &firstDrop) |> Effect.provideMut<Allocator>(&mut allocator)
        let plainKeyResult = run InstanceKey.dropGlue(&plain, &copyOwner) |> Effect.provideMut<Allocator>(&mut allocator)
        let plainKey = run requiredCanonicalGlue(move plainKeyResult)
        let dropKeyResult = run InstanceKey.dropGlue(&droppable, &dropOwner) |> Effect.provideMut<Allocator>(&mut allocator)
        let dropKey = run requiredCanonicalGlue(move dropKeyResult)
        let repeatedKeyResult = run InstanceKey.dropGlue(&repeated, &dropOwner) |> Effect.provideMut<Allocator>(&mut allocator)
        let repeatedKey = run requiredCanonicalGlue(move repeatedKeyResult)
        if let Option<InstanceKey>.Some {value: plainInstance} = move plainKey {
          if let Option<InstanceKey>.Some {value: dropInstance} = move dropKey {
            if let Option<InstanceKey>.Some {value: repeatedInstance} = move repeatedKey {
              let plainSymbol = run InstanceKey.runtimeName(&plainInstance)
                |> Effect.provideMut<Allocator>(&mut allocator)
              let dropSymbol = run InstanceKey.runtimeName(&dropInstance)
                |> Effect.provideMut<Allocator>(&mut allocator)
              let repeatedSymbol = run InstanceKey.runtimeName(&repeatedInstance)
                |> Effect.provideMut<Allocator>(&mut allocator)
              keyed = !InstanceKey.sameRuntimeBase(&plainInstance, &dropInstance)
                && InstanceKey.sameRuntimeBase(&dropInstance, &repeatedInstance)
                && !sameBytes(Bytes.asSlice(&plainSymbol), Bytes.asSlice(&dropSymbol))
                && sameBytes(Bytes.asSlice(&dropSymbol), Bytes.asSlice(&repeatedSymbol))
            }
          }
        }
      }
    }
  }
  run Testing.expect(keyed, "complete generic record instances have canonical distinct glue family keys and names")
  return ()
}

test effect fn genericCopyRejectsAffineStoredFieldsAndOwnDrop() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("genericCopyRejectsAffineStoredFieldsAndOwnDrop.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
struct Token { value: i32 }
impl Drop for Token { fn drop(self: &mut Token) -> () { return () } }
struct Fixed<T> { item: T token: Token }
impl<T: Copy> Copy for Fixed<T> {}
fn fixed(value: &Fixed<i32>) -> i32 { drop value.* return 0 }
union Payload<T> { Empty, Full { item: T, token: Token } }
impl<T: Copy> Copy for Payload<T> {}
fn payload(value: &Payload<i32>) -> i32 { drop value.* return 0 }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu)) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let fixed = run Semantic.demandBody(&mut store, &mut request, &id, b"fixed") |> Effect.provideMut<Allocator>(&mut allocator)
  let payload = run Semantic.demandBody(&mut store, &mut request, &id, b"payload") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsSpan(&fixed, RejectionCode.InvalidCopyConformance, text, "impl<T: Copy> Copy for Fixed<T> {}", 0),
    "a matched generic Copy head cannot conceal a fixed affine record field")
  run Testing.expect(rejectsSpan(&payload, RejectionCode.InvalidCopyConformance, text, "impl<T: Copy> Copy for Payload<T> {}", 0),
    "every substituted union payload must be Copy, including fixed fields")
  return ()
}

