test effect fn importedTargetConstantsUseTheFrozenSemanticTarget() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let target = run module("target.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let entry = run module("target-entry.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let targetSource = run present("""pub const pointerBits: u32 = Intrinsic.targetPointerBits()
pub const architecture: string<'static> = Intrinsic.targetArchitecture()
""") |> Effect.provideMut<Allocator>(&mut allocator)
  let entrySource = run present("""import target { pointerBits, architecture }
const selectedBits: u32 = pointerBits
const selectedArchitecture: string<'static> = architecture
""") |> Effect.provideMut<Allocator>(&mut allocator)
  let first = run Revision.publish(&Revision.make(), &target, &targetSource)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&first, &entry, &entrySource)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut wasm = Semantic.traced(
    run Revision.copy(&revision) |> Effect.provideMut<Allocator>(&mut allocator),
    MachineTarget.forId(TargetId.Wasm32UnknownUnknown),
    Option<FinalProfile>.none(),
  )
  let mut native = Semantic.traced(move revision, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu), Option<FinalProfile>.none())
  let mut wasmRequest = Request.make()
  let mut nativeRequest = Request.make()
  let wasmBits = run Semantic.demandInitializer(&mut wasm, &mut wasmRequest, &entry, b"selectedBits")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let wasmArchitecture = run Semantic.demandInitializer(&mut wasm, &mut wasmRequest, &entry, b"selectedArchitecture")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let nativeBits = run Semantic.demandInitializer(&mut native, &mut nativeRequest, &entry, b"selectedBits")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let nativeArchitecture = run Semantic.demandInitializer(&mut native, &mut nativeRequest, &entry, b"selectedArchitecture")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    Shared<Result<Answer, NoRejection>>.with<bool>(&wasmBits, fn(answer: &Result<Answer, NoRejection>) -> bool {
      return constantInteger(answer, b"32")
    }) && Shared<Result<Answer, NoRejection>>.with<bool>(&nativeBits, fn(answer: &Result<Answer, NoRejection>) -> bool {
      return constantInteger(answer, b"64")
    }) && Shared<Result<Answer, NoRejection>>.with<bool>(&wasmArchitecture, fn(answer: &Result<Answer, NoRejection>) -> bool {
      return constantText(answer, b"wasm32")
    }) && Shared<Result<Answer, NoRejection>>.with<bool>(&nativeArchitecture, fn(answer: &Result<Answer, NoRejection>) -> bool {
      return constantText(answer, b"x86_64")
    }) && Semantic.requestDemanded(&mut wasm, &wasmRequest, Family.Initializer, &target) &&
      Semantic.requestDemanded(&mut native, &nativeRequest, Family.Initializer, &target),
    "ordinary imported target constants retain their selected target and value edges",
  )
  return ()
}

effect fn nominalBindingShapeClaims() -> ()
! InvalidModulePath | Cycle | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let entry = run module("shape-kind.silk")
  let source = run present("""
struct Card {}
enum Choice { Open }
union Maybe { None, Some { value: bool } }
""")
  let revision = run Revision.publish(&Revision.make(), &entry, &source)
  let mut index = SourceIndex.make(run Revision.copy(&revision))
  let card = run requireIndexedIdentity(&mut index, &entry, OwnerKind.Struct, b"Card", usize.ZERO)
  let choice = run requireIndexedIdentity(&mut index, &entry, OwnerKind.Enumeration, b"Choice", usize.ZERO)
  let cardType = run Types.intern(Type.Nominal {
    declaration: move card, isPublic: false, arguments: Vector<Argument>.make(),
  })
  let choiceType = run Types.intern(Type.Nominal {
    declaration: DeclarationId.copy(&choice), isPublic: false, arguments: Vector<Argument>.make(),
  })
  let boolType = run Types.intern(Type.Primitive {name: run Bytes.copy(b"bool")})
  let optional = BindingShape.Optional {
    absent: 0, present: 1, elementType: Shared<Type>.clone(&boolType),
    element: run Box<BindingShape>.make(BindingShape.Boolean),
  }
  let record = BindingShape.Record {fields: Vector<BindingNamedShape>.make()}
  let mut cases = Vector<BindingEnumMember>.make()
  run Vector<BindingEnumMember>.append(&mut cases, BindingEnumMember {
    name: run Bytes.copy(b"Open"),
    value: run Shared<StaticData>.make(StaticData.Enum {
      declaration: run Shared<DeclarationId>.make(DeclarationId.copy(&choice)),
      member: 0, representation: StaticIntegerType.U8, sign: StaticSign.Positive, magnitude: 0,
    }),
  })
  let enumeration = BindingShape.Enum {
    canonical: run Bytes.copy(b"example/shape-kind.silk/Choice"), members: move cases,
  }
  let correctEnum = run bindingCorrespondsToType(&choiceType, &enumeration)
  let enumAsRecord = run bindingCorrespondsToType(&choiceType, &record)
  let structAsOptional = run bindingCorrespondsToType(&cardType, &optional)
  let structAsEnum = run bindingCorrespondsToType(&cardType, &enumeration)
  let wrongKind = !enumAsRecord && !structAsOptional && !structAsEnum
  let mut forgedCases = Vector<BindingEnumMember>.make()
  run Vector<BindingEnumMember>.append(&mut forgedCases, BindingEnumMember {
    name: run Bytes.copy(b"Open"),
    value: run Shared<StaticData>.make(StaticData.Enum {
      declaration: run Shared<DeclarationId>.make(move choice),
      member: 0, representation: StaticIntegerType.U8, sign: StaticSign.Positive, magnitude: 0,
    }),
  })
  let wrongCanonical = BindingShape.Enum {
    canonical: run Bytes.copy(b"example/shape-kind.silk/Other"), members: move forgedCases,
  }
  let acceptedWrongCanonical = run bindingCorrespondsToType(&choiceType, &wrongCanonical)
  run Testing.expect(
    correctEnum && wrongKind && !acceptedWrongCanonical,
    "nominal shapes use declaration kind and canonical enum identity",
  )
  return ()
}

test effect fn profileBindingNominalIdentity() -> ()
! InvalidModulePath | Cycle | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
