  return run nominalBindingShapeClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

fn pipelineGapAt(answer: &Result<Answer, NoRejection>, code: GapCode, owner: &[u8], start: usize, end: usize) -> bool {
  let selected = selectedBackendGap(answer)
  if let Option<Shared<BackendGap>>.Some {value} = move selected {
    let identity = Shared<BackendGap>.with<Shared<DeclarationId>>(&value, fn(gap: &BackendGap) -> Shared<DeclarationId> { return Shared<DeclarationId>.clone(&gap.owner) })
    let owned = Shared<DeclarationId>.with<bool>(&identity, fn(id: &DeclarationId) -> bool { return DeclarationId.named(id, owner) })
    return owned && Shared<BackendGap>.with<bool>(&value, fn(gap: &BackendGap) -> bool {
      let span = BackendGap.span(gap)
      return gap.code == code && span.start == start && span.end == end
    })
  }
  return false
}

fn pipelineTypedUnary(body: &TypedBody, callee: &[u8], primitive: &[u8]) -> bool {
  let nodes = TypedBody.nodeSlice(body)
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {ty, form: BodyExpression.DirectCall {declaration, arguments, ..}} = &nodes[at].kind {
      if DeclarationId.named(&declaration, callee) {
        let values = Vector<BodyNodeId>.asSlice(&arguments)
        if values.length != usize.ONE { return false }
        if let BodyNodeKind.Expression {ty: inputType, ..} = &nodes[values[usize.ZERO].index].kind {
          return Shared<Type>.with<bool>(&ty, fn(value: &Type) -> bool { return witnessPrimitive(value, primitive) })
            && Shared<Type>.with<bool>(&inputType, fn(value: &Type) -> bool { return witnessPrimitive(value, primitive) })
        }
      }
    }
    at = at + usize.ONE
  }
  return false
}

test effect fn namedPipelinesShareDirectCallTypingAndOrder() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("pipeline.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let library = run module("pipe_library.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
import pipe_library as Library
struct Convert {}
impl Convert { fn finish(value: i32) -> i32 { return value } }
fn produce() -> i32 { return 41 }
fn increment(value: i32) -> i32 { return value + 1 }
fn byteIdentity(value: u8) -> u8 { return value }
fn main() -> i32 { return produce() |> increment |> Convert.finish |> Library.finish }
fn contextual() -> u8 { return 255 |> byteIdentity }
fn block() -> i32 { return match true { _ => { let value = produce() return value |> increment } } }
static fn staticPlus(value: i32) -> i32 { return value + 1 }
fn selected() -> i32 { return 40 |> staticPlus |> increment }
fn slot(static value: i32) -> i32 { return value }
fn selectedSlot() -> i32 { return 41 |> slot }
fn callable() -> i32 { return 1 |> fn(value: i32) -> i32 { return value } }
fn binding(target: fn(i32) -> i32) -> i32 { return 1 |> target }
struct Unit { value: i32 }
interface Plain { fn apply(value: &Self) -> i32 }
interface Applied<T> { fn apply(value: &Self) -> T }
impl Plain for Unit { fn apply(value: &Self) -> i32 { return value.value } }
impl Applied<i32> for Unit { fn apply(value: &Self) -> i32 { return value.value } }
fn operation() -> i32 { let unit = Unit {value: 1} return &unit |> Plain.apply }
fn appliedOperation() -> i32 { let unit = Unit {value: 1} return &unit |> Applied<i32>.apply }
struct Generic<T> {}
impl<T> Generic<T> { fn finish(value: i32) -> i32 { return value } }
fn appliedNominal() -> i32 { return 1 |> Generic<i32>.finish }
fn excessPipe() -> i32 { return 1 |> Convert<Missing>.finish }
fn excessCall() -> i32 { return Convert<Missing>.finish(1) }
fn unknownPipe() -> i32 { return 1 |> Generic<Missing>.finish }
fn unknownCall() -> i32 { return Generic<Missing>.finish(1) }
fn modulePipe() -> i32 { return 1 |> Library<Missing>.finish }
fn moduleCall() -> i32 { return Library<Missing>.finish(1) }
"""
  let entrySource = run present(text) |> Effect.provideMut<Allocator>(&mut allocator)
  let librarySource = run present("pub fn finish(value: i32) -> i32 { return value }\n") |> Effect.provideMut<Allocator>(&mut allocator)
  let first = run Revision.publish(&Revision.make(), &id, &entrySource) |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&first, &library, &librarySource) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut store = Semantic.traced(move revision, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu), Option<FinalProfile>.none())
  let mut request = Request.make()
  let body = run Semantic.demandBody(&mut store, &mut request, &id, b"main") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let checked = Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(&body, checkedBody)
  let mut typed = false
  if let Option<Shared<TypedBody>>.Some {value} = move checked {
    typed = Shared<TypedBody>.with<bool>(&value, fn(value: &TypedBody) -> bool { return pipelineTypedUnary(value, b"increment", b"i32") })
  }
  run Testing.expect(typed, "a pipe selects the direct function and checks its input and result types")
  let contextual = run Semantic.demandBody(&mut store, &mut request, &id, b"contextual") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let contextualBody = Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(&contextual, checkedBody)
  let mut contextualInput = false
  if let Option<Shared<TypedBody>>.Some {value} = move contextualBody {
    contextualInput = Shared<TypedBody>.with<bool>(&value, fn(value: &TypedBody) -> bool { return pipelineTypedUnary(value, b"byteIdentity", b"u8") })
  }
  run Testing.expect(contextualInput, "the unary parameter contexts an unsuffixed piped integer")
  let mir = run Semantic.demandMir(&mut store, &mut request, &id, b"main") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let index = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(&mir, selectedMirIndex)
  let mut ordered = false
  if let Option<usize>.Some {value} = move index {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(&store, value) {
      let blocks = Vector<MirBlock>.asSlice(&function.blocks)
      let mut block = usize.ZERO
      let mut phase = usize.ZERO
      let mut previous = usize.MAX
      ordered = true
      while ordered && phase < 4 {
        if block >= blocks.length { ordered = false break }
        if let MirTerminator.Call {callee: MirCallee.Instance {key}, arguments, destination, normal, ..} = &blocks[block].terminator {
          let identity = InstanceKey.identity(&key)
          let mut spelling = b"produce"
          if phase == usize.ONE { spelling = b"increment" }
          if phase >= 2 { spelling = b"finish" }
          ordered = Shared<DeclarationId>.with<bool>(&identity, fn(value: &DeclarationId) -> bool { return DeclarationId.named(value, spelling) })
          let values = Vector<MirOperand>.asSlice(&arguments)
          if phase == usize.ZERO {
            ordered = ordered && values.length == usize.ZERO
          } else {
            ordered = ordered && values.length == usize.ONE
            if values.length == usize.ONE {
              if let MirOperand.Copy {place} = &values[usize.ZERO] {
                ordered = ordered && place.local == previous && Vector<MirProjection>.length(&place.projections) == usize.ZERO
              } else { ordered = false }
            }
          }
          if phase == 3 { ordered = ordered && Shared<DeclarationId>.with<bool>(&identity, fn(value: &DeclarationId) -> bool { return ModuleId.equals(DeclarationId.moduleId(value), &library) }) }
          previous = destination.local
          block = normal
          phase = phase + usize.ONE
        } else { ordered = false }
      }
      let mut calls = usize.ZERO
      let mut at = usize.ZERO
      while at < blocks.length {
        if let MirTerminator.Call {..} = &blocks[at].terminator { calls = calls + usize.ONE }
        at = at + usize.ONE
      }
      ordered = ordered && phase == 4 && calls == 4
    }
  }
  run Testing.expect(ordered, "MIR evaluates the input once before each named, type-qualified, and module-qualified target")
  let block = run Semantic.demandMir(&mut store, &mut request, &id, b"block") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(Shared<Result<Answer, NoRejection>>.with<bool>(&block, pipelineHasMir), "call collection reaches a pipe in a block match arm")
  let selected = run Semantic.demandMir(&mut store, &mut request, &id, b"selected") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let selectedSlot = run Semantic.demandMir(&mut store, &mut request, &id, b"selectedSlot") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(Shared<Result<Answer, NoRejection>>.with<bool>(&selected, pipelineHasMir)
    && Shared<Result<Answer, NoRejection>>.with<bool>(&selectedSlot, pipelineHasMir), "pipes share static-call execution and static argument selection")
  let callable = run Semantic.demandMir(&mut store, &mut request, &id, b"callable") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let binding = run Semantic.demandBody(&mut store, &mut request, &id, b"binding") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let operation = run Semantic.demandMir(&mut store, &mut request, &id, b"operation") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let applied = run Semantic.demandMir(&mut store, &mut request, &id, b"appliedOperation") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(succeeded(&callable) && succeeded(&binding),
    "an exact anonymous pipeline lowers directly and an abstract callable parameter pipeline types")
  run Testing.expect(Shared<Result<Answer, NoRejection>>.with<bool>(&operation, pipelineHasMir)
    && Shared<Result<Answer, NoRejection>>.with<bool>(&applied, pipelineHasMir), "an interface-operation pipeline lowers as its direct qualified call")
  let appliedNominal = run Semantic.demandMir(&mut store, &mut request, &id, b"appliedNominal") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(Shared<Result<Answer, NoRejection>>.with<bool>(&appliedNominal, pipelineHasMir), "a validated nominal application selects its inherent pipeline target")
  let excessPipe = run Semantic.demandBody(&mut store, &mut request, &id, b"excessPipe") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let excessCall = run Semantic.demandBody(&mut store, &mut request, &id, b"excessCall") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let unknownPipe = run Semantic.demandBody(&mut store, &mut request, &id, b"unknownPipe") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let unknownCall = run Semantic.demandBody(&mut store, &mut request, &id, b"unknownCall") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let modulePipe = run Semantic.demandBody(&mut store, &mut request, &id, b"modulePipe") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let moduleCall = run Semantic.demandBody(&mut store, &mut request, &id, b"moduleCall") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  // A call's applied owner reports a wrong argument count at its whole application (SEM0051).
  let excessStart = offsetOf(text, "Convert<Missing>", usize.ZERO)
  let excessCallStart = offsetOf(text, "Convert<Missing>", usize.ONE)
  let unknownStart = offsetOf(text, "Generic<Missing>", usize.ZERO) + String.utf8Bytes("Generic<").length
  let unknownCallStart = offsetOf(text, "Generic<Missing>", usize.ONE) + String.utf8Bytes("Generic<").length
  let moduleStart = offsetOf(text, "Library<Missing>", usize.ZERO)
  let moduleCallStart = offsetOf(text, "Library<Missing>", usize.ONE)
  run Testing.expect(Shared<Result<Answer, NoRejection>>.with<bool>(&excessPipe, fn(value: &Result<Answer, NoRejection>) -> bool { return rejectionAt(value, RejectionCode.TypeArity, excessStart) })
    && Shared<Result<Answer, NoRejection>>.with<bool>(&excessCall, fn(value: &Result<Answer, NoRejection>) -> bool { return rejectionAt(value, RejectionCode.TypeArity, excessCallStart) }), "both call forms reject type arguments on a nongeneric qualifier at the written application")
  run Testing.expect(Shared<Result<Answer, NoRejection>>.with<bool>(&unknownPipe, fn(value: &Result<Answer, NoRejection>) -> bool { return rejectionAt(value, RejectionCode.UnknownType, unknownStart) })
    && Shared<Result<Answer, NoRejection>>.with<bool>(&unknownCall, fn(value: &Result<Answer, NoRejection>) -> bool { return rejectionAt(value, RejectionCode.UnknownType, unknownCallStart) }), "both call forms resolve the qualifier's type arguments and reject unknown names")
  run Testing.expect(Shared<Result<Answer, NoRejection>>.with<bool>(&modulePipe, fn(value: &Result<Answer, NoRejection>) -> bool { return rejectionAt(value, RejectionCode.NotType, moduleStart) })
    && Shared<Result<Answer, NoRejection>>.with<bool>(&moduleCall, fn(value: &Result<Answer, NoRejection>) -> bool { return rejectionAt(value, RejectionCode.NotType, moduleCallStart) }), "both call forms reject applying type arguments to a module qualifier")
  return ()
}

test effect fn movedDeclarationsRetainLiteralPayloadsAndIr() -> ()
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
