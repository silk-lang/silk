effect fn appendRecipeControl(recipes: &mut Vector<InstanceRecipe>, key: &InstanceKey, callees: &[InstanceKey], constant: Option<bool>, checked: bool) -> ()
! OutOfMemoryError ? &mut Allocator {
  let function = run recipeControlMir(key, callees, move constant, checked)
  return run Vector.append<InstanceRecipe>(&mut recipes.*, run InstanceRecipe.make(&function))
}

effect fn recipeControlPlan(recipes: &[InstanceRecipe]) -> EmissionPlan
! OutOfMemoryError
? &mut Allocator {
  let mut plan = EmissionPlan.empty()
  let mut at = usize.ZERO
  while at < recipes.length {
    let identity = run InstanceKey.encoding(&recipes[at].key)
    let symbol = run InstanceKey.symbol(&recipes[at].key)
    run EmissionPlan.include(
      &mut plan,
      &recipes[at].key,
      Bytes.asSlice(&identity),
      Bytes.asSlice(&symbol),
      recipes[at].safetyChecked,
    )
    at = at + usize.ONE
  }
  return move plan
}

effect fn recipePlansAgree(left: &EmissionPlan, right: &EmissionPlan, key: &InstanceKey) -> bool
! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let first = run recipeIdentityAt(left, key)
  let second = run recipeIdentityAt(right, key)
  let firstIdentities = Vector.asSlice<EmissionIdentity>(&left.identities)
  let secondIdentities = Vector.asSlice<EmissionIdentity>(&right.identities)
  let a = &firstIdentities[first]
  let b = &secondIdentities[second]
  return sameBytes(Bytes.asSlice(&a.encoding), Bytes.asSlice(&b.encoding))
    && sameBytes(Bytes.asSlice(&a.symbol), Bytes.asSlice(&b.symbol))
}

// Canonical labeling preserves the complete region-incidence graph, including unordered sets.
test effect fn instanceKeysCanonicallyNumberCompleteCallerRegionGraphs() -> ()
! CanonicalizationFailure | Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run callerRegionNumberingClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn numberingDeclaration(id: &ModuleId, name: &[u8], kind: OwnerKind) -> DeclarationId ! OutOfMemoryError ? &mut Allocator {
  let mut owners = Vector.make<OwnerStep>()
  run Vector.append<OwnerStep>(&mut owners, OwnerStep {kind: kind,
    name: Option.some<Bytes>(run Bytes.copy(name)), occurrence: usize.ZERO})
  return run DeclarationId.fromParts(run ModuleId.copy(id), move owners)
}

// A borrow region of `caller`, or `'static` when `lasting`.
effect fn numberingRegion(caller: &DeclarationId, ordinal: usize, lasting: bool) -> Shared<Lifetime>
! OutOfMemoryError ? &mut Allocator {
  if lasting { return run Shared.make<Lifetime>(Lifetime.Static) }
  return run Shared.make<Lifetime>(Lifetime.Local {declaration: run DeclarationId.copy(caller), ordinal: ordinal})
}

effect fn numberingPair(callee: &DeclarationId, first: Shared<Lifetime>, second: Shared<Lifetime>) -> InstanceKey
! CanonicalizationFailure | OutOfMemoryError ? &mut Allocator {
  let mut arguments = Vector.make<Argument>()
  run Vector.append<Argument>(&mut arguments, Argument.Lifetime {value: move first})
  run Vector.append<Argument>(&mut arguments, Argument.Lifetime {value: move second})
  return run requiredCanonicalKey(run InstanceKey.function(run specializationWithArguments(callee, move arguments)))
}

// `wrap<'r, &'t u8>`: one direct region argument and one region nested in a type argument.
effect fn numberingNested(callee: &DeclarationId, direct: Shared<Lifetime>, nested: Shared<Lifetime>) -> InstanceKey
! CanonicalizationFailure | OutOfMemoryError ? &mut Allocator {
  let referent = run specializationPrimitive(b"u8")
  let mut arguments = Vector.make<Argument>()
  run Vector.append<Argument>(&mut arguments, Argument.Lifetime {value: move direct})
  run Vector.append<Argument>(&mut arguments, Argument.Type {value: run Shared.make<Type>(
    Type.Reference {referent: move referent, access: Access.Shared, lifetime: move nested})})
  return run requiredCanonicalKey(run InstanceKey.function(run specializationWithArguments(callee, move arguments)))
}

// `serve<'a>` whose `Sink` requirement is served by a provider of type `&'p Console`.
effect fn numberingServed(callee: &DeclarationId, sink: &DeclarationId, console: &DeclarationId, argument: Shared<Lifetime>,
  lent: Shared<Lifetime>) -> InstanceKey
! CanonicalizationFailure | OutOfMemoryError ? &mut Allocator {
  let mut arguments = Vector.make<Argument>()
  run Vector.append<Argument>(&mut arguments, Argument.Lifetime {value: move argument})
  let capability = run specializationNominal(sink, Vector.make<Argument>())
  let referent = run specializationNominal(console, Vector.make<Argument>())
  let provider = run Shared.make<Type>(Type.Reference {referent: move referent, access: Access.Shared, lifetime: move lent})
  let mut served = Vector.make<ProviderEntry>()
  run Vector.append<ProviderEntry>(&mut served, ProviderEntry {
    key: Requirement {capability: move capability, roleType: Option.none<Shared<Type>>(), access: Access.Shared},
    provider: move provider,
  })
  return run requiredCanonicalKey(run InstanceKey.withProviders(run specializationWithArguments(callee, move arguments), move served))
}

enum NumberingSetShape { Meet, Union, Row }

// The unordered input is followed by two ordered anchors. Changing the second anchor's sharing
// cannot be repaired by swapping the two otherwise interchangeable unordered members.
effect fn numberingSetCorrelation(callee: &DeclarationId, caller: &DeclarationId, capability: &DeclarationId,
  first: usize, second: usize, separate: bool, reversed: bool, shape: NumberingSetShape) -> InstanceKey
! CanonicalizationFailure | OutOfMemoryError ? &mut Allocator {
  let a = run numberingRegion(caller, first, false)
  let b = run numberingRegion(caller, second, false)
  let referenceA = run environmentReference(&a)
  let referenceB = run environmentReference(&b)
  let mut arguments = Vector.make<Argument>()
  if shape == NumberingSetShape.Meet {
    let atoms = [Shared.clone<Lifetime>(&a), Shared.clone<Lifetime>(&b)]
    run Vector.append<Argument>(&mut arguments, Argument.Lifetime {value: run Lifetime.meet(&atoms)})
  } else if shape == NumberingSetShape.Union {
    let mut members = Vector.make<Shared<Type>>()
    if reversed {
      run Type.joinMember(&mut members, &referenceB)
      run Type.joinMember(&mut members, &referenceA)
    } else {
      run Type.joinMember(&mut members, &referenceA)
      run Type.joinMember(&mut members, &referenceB)
    }
    run Vector.append<Argument>(&mut arguments, Argument.Type {value: run Shared.make<Type>(Type.Union {members: move members})})
  } else {
    let mut firstArguments = Vector.make<Argument>()
    run Vector.append<Argument>(&mut firstArguments, Argument.Type {value: Shared.clone<Type>(&referenceA)})
    let firstCapability = run specializationNominal(capability, move firstArguments)
    let mut secondArguments = Vector.make<Argument>()
    run Vector.append<Argument>(&mut secondArguments, Argument.Type {value: Shared.clone<Type>(&referenceB)})
    let secondCapability = run specializationNominal(capability, move secondArguments)
    let mut row = Row.empty()
    let firstKey = Requirement {capability: move firstCapability, roleType: Option.none<Shared<Type>>(), access: Access.Shared}
    let secondKey = Requirement {capability: move secondCapability, roleType: Option.none<Shared<Type>>(), access: Access.Shared}
    if reversed { run Row.require(&mut row, move secondKey) run Row.require(&mut row, move firstKey) }
    else { run Row.require(&mut row, move firstKey) run Row.require(&mut row, move secondKey) }
    run Vector.append<Argument>(&mut arguments, Argument.Row {value: run Shared.make<Row>(move row)})
  }
  run Vector.append<Argument>(&mut arguments, Argument.Type {value: Shared.clone<Type>(&referenceA)})
  let mut last = Shared.clone<Type>(&referenceA)
  if separate { last = Shared.clone<Type>(&referenceB) }
  run Vector.append<Argument>(&mut arguments, Argument.Type {value: move last})
  return run requiredCanonicalKey(run InstanceKey.function(run specializationWithArguments(callee, move arguments)))
}

effect fn numberingScopedProvider(callee: &DeclarationId, caller: &DeclarationId, scope: &DeclarationId,
  capability: &DeclarationId, first: usize, second: usize, separate: bool) -> InstanceKey
! CanonicalizationFailure | OutOfMemoryError ? &mut Allocator {
  let a = run numberingRegion(caller, first, false)
  let b = run numberingRegion(caller, second, false)
  let atoms = [Shared.clone<Lifetime>(&a), Shared.clone<Lifetime>(&b)]
  let mut own = Vector.make<Argument>()
  run Vector.append<Argument>(&mut own, Argument.Lifetime {value: run Lifetime.meet(&atoms)})
  let mut application = run specializationWithArguments(callee, move own)
  let mut scoped = Vector.make<Argument>()
  run Vector.append<Argument>(&mut scoped, Argument.Type {value: run environmentReference(&a)})
  run Vector.append<Argument>(&mut scoped, Argument.Type {value: run environmentReference(&b)})
  run Vector.append<ScopeBinding>(&mut application.scopes, ScopeBinding {
    owner: run Shared.make<DeclarationId>(run DeclarationId.copy(scope)), arguments: move scoped,
    argumentOrdinals: run SpecializationApplication.denseOrdinals(2),
  })
  let mut capabilityArguments = Vector.make<Argument>()
  run Vector.append<Argument>(&mut capabilityArguments, Argument.Type {value: run environmentReference(&b)})
  let mut roleType = run environmentReference(&a)
  if separate { roleType = run environmentReference(&b) }
  let mut providers = Vector.make<ProviderEntry>()
  run Vector.append<ProviderEntry>(&mut providers, ProviderEntry {
    key: Requirement {capability: run specializationNominal(capability, move capabilityArguments),
      roleType: Option.some<Shared<Type>>(move roleType), access: Access.Shared},
    provider: run environmentReference(&a),
  })
  return run requiredCanonicalKey(run InstanceKey.withProviders(move application, move providers))
}

// One meet holds every atom at a single site, so only the single-atom references after it rank
// them. The references run from the last atom to the first, or from the first to the last when
// `ascending`; with `repeated`, the final reference names the previous reference's atom again.
effect fn numberingTiedMeet(callee: &DeclarationId, caller: &DeclarationId, base: usize, count: usize, ascending: bool,
  repeated: bool) -> Result<InstanceKey, CanonicalizationFailure>
! OutOfMemoryError ? &mut Allocator {
  let mut atoms = Vector.make<Shared<Lifetime>>()
  let mut at = usize.ZERO
  while at < count {
    run Vector.append<Shared<Lifetime>>(&mut atoms, run numberingRegion(caller, base + at, false))
    at = at + usize.ONE
  }
  let mut arguments = Vector.make<Argument>()
  run Vector.append<Argument>(&mut arguments, Argument.Lifetime {value: run Lifetime.meet(Vector.asSlice<Shared<Lifetime>>(&atoms))})
  at = usize.ZERO
  while at < count {
    let mut atom = count - usize.ONE - at
    if ascending { atom = at }
    if repeated && at == count - usize.ONE {
      atom = atom + usize.ONE
      if ascending { atom = at - usize.ONE }
    }
    let listed = Vector.asSlice<Shared<Lifetime>>(&atoms)
    run Vector.append<Argument>(&mut arguments, Argument.Type {value: run environmentReference(&listed[atom])})
    at = at + usize.ONE
  }
  return run InstanceKey.function(run specializationWithArguments(callee, move arguments))
}

effect fn numberingDag(callee: &DeclarationId, record: &DeclarationId, caller: &DeclarationId, ordinal: usize, shared: bool) -> InstanceKey
! CanonicalizationFailure | OutOfMemoryError ? &mut Allocator {
  let region = run numberingRegion(caller, ordinal, false)
  let first = run environmentReference(&region)
  let mut second = Shared.clone<Type>(&first)
  if !shared { second = run environmentReference(&region) }
  let mut members = Vector.make<Argument>()
  run Vector.append<Argument>(&mut members, Argument.Type {value: move first})
  run Vector.append<Argument>(&mut members, Argument.Type {value: move second})
  let mut arguments = Vector.make<Argument>()
  run Vector.append<Argument>(&mut arguments, Argument.Type {value: run specializationNominal(record, move members)})
  return run requiredCanonicalKey(run InstanceKey.function(run specializationWithArguments(callee, move arguments)))
}

fn suppliedAt(value: &Lifetime, position: usize) -> bool {
  return match &value.* { Lifetime.Supplied {ordinal} => ordinal == position _ => false }
}

fn numberedSharedI32(value: &Type, ordinal: usize) -> bool {
  if let Type.Reference {access, referent, lifetime} = &value.* {
    return access == Access.Shared && Shared.with<Type, bool>(&referent, isI32)
      && Shared.with<Lifetime, bool>(&lifetime,
        fn(region: &Lifetime) -> bool { return suppliedAt(region, ordinal) })
  }
  return false
}

fn numberedMeetAndAnchors(application: &SpecializationApplication) -> bool {
  let arguments = Vector.asSlice<Argument>(&application.arguments)
  if arguments.length != 3 { return false }
  if let Argument.Lifetime {value} = &arguments[usize.ZERO] {
    if Lifetime.atomCount(&value) != 2 { return false }
    let first = Lifetime.atomAt(&value, usize.ZERO)
    let second = Lifetime.atomAt(&value, usize.ONE)
    let a = Shared.with<Lifetime, bool>(&first, fn(region: &Lifetime) -> bool { return suppliedAt(region, usize.ZERO) })
    let b = Shared.with<Lifetime, bool>(&second, fn(region: &Lifetime) -> bool { return suppliedAt(region, usize.ONE) })
    let reversedA = Shared.with<Lifetime, bool>(&first, fn(region: &Lifetime) -> bool { return suppliedAt(region, usize.ONE) })
    let reversedB = Shared.with<Lifetime, bool>(&second, fn(region: &Lifetime) -> bool { return suppliedAt(region, usize.ZERO) })
    if !(a && b) && !(reversedA && reversedB) { return false }
    let mut at = usize.ONE
    while at < arguments.length {
      if let Argument.Type {value: reference} = &arguments[at] {
        if !Shared.with<Type, bool>(&reference,
          fn(ty: &Type) -> bool { return numberedSharedI32(ty, usize.ZERO) }) { return false }
      } else { return false }
      at = at + usize.ONE
    }
    return true
  }
  return false
}

effect fn numberedArgumentsAre(key: &InstanceKey, first: usize, second: usize) -> bool ! OutOfMemoryError ? &mut Allocator {
  let application = run InstanceKey.selected(key)
  let arguments = Vector.asSlice<Argument>(&application.arguments)
  if arguments.length != 2 { return false }
  let leading = match &arguments[usize.ZERO] {
    Argument.Lifetime {value} => Shared.with<Lifetime, bool>(&value, fn(region: &Lifetime) -> bool { return suppliedAt(region, first) })
    _ => false
  }
  let trailing = match &arguments[usize.ONE] {
    Argument.Lifetime {value} => Shared.with<Lifetime, bool>(&value, fn(region: &Lifetime) -> bool { return suppliedAt(region, second) })
    _ => false
  }
  return leading && trailing
}

effect fn callerRegionNumberingClaims() -> ()
! CanonicalizationFailure | Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("caller-region-numbering.silk")
  let caller = run numberingDeclaration(&id, b"caller", OwnerKind.Function)
  let pair = run numberingDeclaration(&id, b"pair", OwnerKind.Function)
  let distinct = run numberingPair(&pair, run numberingRegion(&caller, 9, false), run numberingRegion(&caller, 3, false))
  let renamed = run numberingPair(&pair, run numberingRegion(&caller, 4, false), run numberingRegion(&caller, 12, false))
  let shared = run numberingPair(&pair, run numberingRegion(&caller, 3, false), run numberingRegion(&caller, 3, false))
  let sharedElsewhere = run numberingPair(&pair, run numberingRegion(&caller, 5, false), run numberingRegion(&caller, 5, false))
  let lasting = run numberingPair(&pair, run numberingRegion(&caller, 9, false), run numberingRegion(&caller, 3, true))
  let renamedEqual = run InstanceKey.sameApplication(&distinct, &renamed)
  let sharedEqual = run InstanceKey.sameApplication(&shared, &sharedElsewhere)
  let distinctNumbered = run numberedArgumentsAre(&distinct, usize.ZERO, usize.ONE)
  let sharedNumbered = run numberedArgumentsAre(&shared, usize.ZERO, usize.ZERO)
  run Testing.expect(renamedEqual && sharedEqual && distinctNumbered && sharedNumbered,
    "renamed ordered caller regions share one exact instance with independently checked distinct or shared canonical atoms")
  let sharingKept = run InstanceKey.sameApplication(&distinct, &shared)
  let lastingKept = run InstanceKey.sameApplication(&distinct, &lasting)
  run Testing.expect(!sharingKept && !lastingKept && InstanceKey.sameRuntimeBase(&distinct, &shared)
    && InstanceKey.sameRuntimeBase(&distinct, &lasting),
    "region sharing and 'static remain exact instance evidence inside one erased runtime family")
  let supplied = run Shared.make<Lifetime>(Lifetime.Supplied {ordinal: 3})
  let mixedKinds = run numberingPair(&pair, run numberingRegion(&caller, 3, false), move supplied)
  run Testing.expect((run InstanceKey.sameApplication(&distinct, &mixedKinds))
      && !(run InstanceKey.sameApplication(&shared, &mixedKinds)),
    "a caller's supplied atom and a distinct local loan never alias merely because their raw ordinals match")
  let wrap = run numberingDeclaration(&id, b"wrap", OwnerKind.Function)
  let together = run numberingNested(&wrap, run numberingRegion(&caller, 3, false), run numberingRegion(&caller, 3, false))
  let movedTogether = run numberingNested(&wrap, run numberingRegion(&caller, 8, false), run numberingRegion(&caller, 8, false))
  let apart = run numberingNested(&wrap, run numberingRegion(&caller, 3, false), run numberingRegion(&caller, 8, false))
  let nestedEqual = run InstanceKey.sameApplication(&together, &movedTogether)
  let nestedApart = run InstanceKey.sameApplication(&together, &apart)
  run Testing.expect(nestedEqual && !nestedApart,
    "a region nested in a type argument is numbered with the direct region arguments")
  let guard = run numberingDeclaration(&id, b"Guard", OwnerKind.Struct)
  let mut firstGuard = Vector.make<Argument>()
  run Vector.append<Argument>(&mut firstGuard, Argument.Lifetime {value: run numberingRegion(&caller, 3, false)})
  let mut secondGuard = Vector.make<Argument>()
  run Vector.append<Argument>(&mut secondGuard, Argument.Lifetime {value: run numberingRegion(&caller, 8, false)})
  let mut staticGuard = Vector.make<Argument>()
  run Vector.append<Argument>(&mut staticGuard, Argument.Lifetime {value: run numberingRegion(&caller, 8, true)})
  let firstType = run specializationNominal(&guard, move firstGuard)
  let secondType = run specializationNominal(&guard, move secondGuard)
  let staticType = run specializationNominal(&guard, move staticGuard)
  let firstGlue = run requiredCanonicalGlue(run InstanceKey.dropGlue(&firstType, &caller))
  let secondGlue = run requiredCanonicalGlue(run InstanceKey.dropGlue(&secondType, &caller))
  let staticGlue = run requiredCanonicalGlue(run InstanceKey.dropGlue(&staticType, &caller))
  let mut glue = false
  if let Option<InstanceKey>.Some {value: first} = &firstGlue {
    if let Option<InstanceKey>.Some {value: second} = &secondGlue {
      if let Option<InstanceKey>.Some {value: permanent} = &staticGlue {
        let glueShared = run InstanceKey.sameApplication(&first, &second)
        let glueLasting = run InstanceKey.sameApplication(&first, &permanent)
        glue = glueShared && !glueLasting
      }
    }
  }
  run Testing.expect(glue, "drop glue numbers caller regions of its type and keeps 'static cleanup selection distinct")
  let serve = run numberingDeclaration(&id, b"serve", OwnerKind.Function)
  let sink = run numberingDeclaration(&id, b"Sink", OwnerKind.Service)
  let console = run numberingDeclaration(&id, b"Console", OwnerKind.Struct)
  let servedTogether = run numberingServed(&serve, &sink, &console, run numberingRegion(&caller, 3, false), run numberingRegion(&caller, 3, false))
  let servedMoved = run numberingServed(&serve, &sink, &console, run numberingRegion(&caller, 8, false), run numberingRegion(&caller, 8, false))
  let servedApart = run numberingServed(&serve, &sink, &console, run numberingRegion(&caller, 3, false), run numberingRegion(&caller, 8, false))
  let providerShared = run InstanceKey.sameApplication(&servedTogether, &servedMoved)
  let providerApart = run InstanceKey.sameApplication(&servedTogether, &servedApart)
  run Testing.expect(providerShared && !providerApart,
    "one numbering covers an application and its providers, so argument-provider region sharing stays exact")
  let site = run numberingDeclaration(&id, b"site", OwnerKind.Function)
  let declared = run Shared.make<Lifetime>(Lifetime.Parameter {declaration: run DeclarationId.copy(&site), ordinal: usize.ZERO})
  let parameter = run numberingPair(&pair, move declared, run numberingRegion(&caller, 3, false))
  let application = run InstanceKey.selected(&parameter)
  let arguments = Vector.asSlice<Argument>(&application.arguments)
  let mut kept = false
  if arguments.length == 2 {
    kept = match &arguments[usize.ZERO] {
      Argument.Lifetime {value} => Shared.with<Lifetime, bool>(&value, fn(region: &Lifetime) -> bool {
        return match &region.* {
          Lifetime.Parameter {declaration, ordinal} => ordinal == usize.ZERO && DeclarationId.equals(&declaration, &site)
          _ => false
        }
      })
      _ => false
    }
  }
  run Testing.expect(kept, "a declaration-owned parameter region is not a caller region and keeps its identity")
  let foreignParameter = run Shared.make<Lifetime>(Lifetime.Parameter {
    declaration: run DeclarationId.copy(&caller), ordinal: usize.ZERO})
  let foreignKey = run numberingPair(&pair, move foreignParameter, run numberingRegion(&caller, 3, false))
  run Testing.expect(!(run InstanceKey.sameApplication(&parameter, &foreignKey)),
    "the same parameter ordinal under another declaration remains a different rigid atom")
  let sets = [NumberingSetShape.Meet, NumberingSetShape.Union, NumberingSetShape.Row]
  let mut set = usize.ZERO
  while set < 3 {
    let original = run numberingSetCorrelation(&pair, &caller, &sink, usize.ONE, 2, false, false, sets[set])
    let alpha = run numberingSetCorrelation(&pair, &caller, &sink, 6, 5, false, true, sets[set])
    let different = run numberingSetCorrelation(&pair, &caller, &sink, 6, 5, true, true, sets[set])
    let equal = run InstanceKey.sameApplication(&original, &alpha)
    let unequal = run InstanceKey.sameApplication(&original, &different)
    run Testing.expect(equal && !unequal && InstanceKey.sameRuntimeBase(&original, &different),
      "unordered lifetime/type/row sets are alpha invariant across ordered anchors and preserve changed sharing in one erased family")
    if sets[set] == NumberingSetShape.Meet {
      let selected = run InstanceKey.selected(&original)
      run Testing.expect(numberedMeetAndAnchors(&selected),
        "canonical meet atoms remain injective Supplied0/1 and both literal ordered anchors retain Supplied0")
      let renumbered = run requiredCanonicalKey(run InstanceKey.function(move selected))
      run Testing.expect(run InstanceKey.sameApplication(&original, &renumbered),
        "renumbering the complete selected Supplied-atom graph preserves the same canonical application")
    }
    set = set + usize.ONE
  }
  // Members without caller atoms cannot reorder any atom's incidence, so many distinct caller
  // regions beside a plain union and row stay positional: an exact search over 9! numberings
  // would exceed the 65536-state budget.
  let mut plainMembers = Vector.make<Shared<Type>>()
  run Type.joinMember(&mut plainMembers, &run specializationNominal(&console, Vector.make<Argument>()))
  run Type.joinMember(&mut plainMembers, &run specializationNominal(&guard, Vector.make<Argument>()))
  let mut plainRow = Row.empty()
  run Row.require(&mut plainRow, Requirement {capability: run specializationNominal(&sink, Vector.make<Argument>()),
    roleType: Option.none<Shared<Type>>(), access: Access.Shared})
  run Row.require(&mut plainRow, Requirement {capability: run specializationNominal(&console, Vector.make<Argument>()),
    roleType: Option.none<Shared<Type>>(), access: Access.Mutable})
  let mut plainArguments = Vector.make<Argument>()
  let mut atom = usize.ZERO
  while atom < 9 {
    run Vector.append<Argument>(&mut plainArguments, Argument.Lifetime {value: run numberingRegion(&caller, atom + usize.ONE, false)})
    atom = atom + usize.ONE
  }
  run Vector.append<Argument>(&mut plainArguments, Argument.Type {value: run Shared.make<Type>(Type.Union {members: move plainMembers})})
  run Vector.append<Argument>(&mut plainArguments, Argument.Row {value: run Shared.make<Row>(move plainRow)})
  let plain = run InstanceKey.function(run specializationWithArguments(&pair, move plainArguments))
  let plainNumbered = match &plain { Result<InstanceKey, CanonicalizationFailure>.Success {..} => true _ => false }
  run Testing.expect(plainNumbered, "a union or row whose members carry no caller region needs no exact numbering search")
  // Atoms that share their first site are ordered by later incidence. Ranking 24 tied atoms
  // takes 276 comparisons; rescanning every site and occurrence for each one exceeded the
  // 32768-unit budget, while comparing each atom's sorted site list stays linear.
  let tied = run numberingTiedMeet(&pair, &caller, usize.ONE, 24, false, false)
  let tiedAlpha = run numberingTiedMeet(&pair, &caller, 40, 24, true, false)
  let tiedRepeated = run numberingTiedMeet(&pair, &caller, usize.ONE, 24, false, true)
  let mut tiedClaim = false
  if let Result<InstanceKey, CanonicalizationFailure>.Success {value: tiedKey} = &tied {
    if let Result<InstanceKey, CanonicalizationFailure>.Success {value: alphaKey} = &tiedAlpha {
      if let Result<InstanceKey, CanonicalizationFailure>.Success {value: repeatedKey} = &tiedRepeated {
        let alphaEqual = run InstanceKey.sameApplication(&tiedKey, &alphaKey)
        let repeatedEqual = run InstanceKey.sameApplication(&tiedKey, &repeatedKey)
        tiedClaim = alphaEqual && !repeatedEqual && InstanceKey.sameRuntimeBase(&tiedKey, &repeatedKey)
      }
    }
  }
  run Testing.expect(tiedClaim,
    "atoms tied at one meet are ranked by later incidence within budget, alpha invariant and sharing exact")
  let scoped = run numberingScopedProvider(&serve, &caller, &guard, &sink, usize.ONE, 2, false)
  let scopedAlpha = run numberingScopedProvider(&serve, &caller, &guard, &sink, 6, 5, false)
  let scopedDifferent = run numberingScopedProvider(&serve, &caller, &guard, &sink, 6, 5, true)
  run Testing.expect((run InstanceKey.sameApplication(&scoped, &scopedAlpha))
      && !(run InstanceKey.sameApplication(&scoped, &scopedDifferent))
      && InstanceKey.sameRuntimeBase(&scoped, &scopedDifferent),
    "one frozen domain retains sharing across own meets, original scopes, capability arguments, role types and provider types")
  let dag = run numberingDag(&wrap, &guard, &caller, usize.ONE, true)
  let copiedDag = run numberingDag(&wrap, &guard, &caller, 6, false)
  run Testing.expect(run InstanceKey.sameApplication(&dag, &copiedDag),
    "shared DAG occurrences and independently allocated equal children have one canonical application")
  // These are real incoming semantic edges, even though every edge shares one small child.
  // Each Reference and its i32 child require at least four node/edge units per occurrence.
  // 8193 occurrences therefore exceed the 32768-unit budget without a large allocation graph.
  let repeatedChild = run environmentReference(&run numberingRegion(&caller, usize.ONE, false))
  let mut repeatedEdges = Vector.make<Argument>()
  let mut edge = usize.ZERO
  while edge < 8193 {
    run Vector.append<Argument>(&mut repeatedEdges, Argument.Type {value: Shared.clone<Type>(&repeatedChild)})
    edge = edge + usize.ONE
  }
  let wide = run specializationNominal(&guard, move repeatedEdges)
  let mut exhaustedArguments = Vector.make<Argument>()
  run Vector.append<Argument>(&mut exhaustedArguments, Argument.Type {value: move wide})
  let exhausted = run InstanceKey.function(run specializationWithArguments(&pair, move exhaustedArguments))
  let refused = match &exhausted {
    Result<InstanceKey, CanonicalizationFailure>.Failure {error} => error == CanonicalizationFailure.Resource
    _ => false
  }
  run Testing.expect(refused, "whole-domain structural exhaustion returns the exact Resource failure and publishes no partial canonical key")
  // Positional storage has no unordered regions or search permutations. Its repeated incoming
  // primitive edges fit collection, then exceed the same cumulative budget during frozen rewrite.
  let primitiveChild = run specializationPrimitive(b"u8")
  let mut primitiveEdges = Vector.make<Shared<Type>>()
  let mut primitiveAt = usize.ZERO
  while primitiveAt < 5000 {
    run Vector.append<Shared<Type>>(&mut primitiveEdges, Shared.clone<Type>(&primitiveChild))
    primitiveAt = primitiveAt + usize.ONE
  }
  let occurrence = run Shared.make<AnonymousOccurrence>(AnonymousOccurrence {
    declaration: run Shared.make<DeclarationId>(run DeclarationId.copy(&caller)), syntax: usize.ZERO,
    positional: true, labels: Vector.make<Bytes>()})
  let positional = run Shared.make<Type>(Type.Anonymous {occurrence: move occurrence, members: move primitiveEdges})
  let budgetText = """
// The canonical refusal must retain this original declaration's nonzero source span.
fn budget<T>() -> () { return () }
"""
  let mut budgetStore = run staticSemantic(&id, budgetText, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut budgetDependencies = Vector.make<Dependency>()
  let mut budgetPort = Semantic.staticPort(&mut budgetStore, &mut budgetDependencies)
  let budgetAddressed = run StaticPort.resolveRootDeclaration(&mut budgetPort, &id, b"budget",
    Span.make(usize.ZERO, usize.ZERO))
  drop budgetPort
  let budgetOwner = match move budgetAddressed {
    Result<DeclarationId, Shared<Rejection>>.Success {value} => move value
    _ => { fail InvalidModulePath {} }
  }
  let mut frozenArguments = Vector.make<Argument>()
  run Vector.append<Argument>(&mut frozenArguments, Argument.Type {value: move positional})
  let budgetApplication = run specializationWithArguments(&budgetOwner, move frozenArguments)
  let frozen = run InstanceKey.function(run SpecializationApplication.copy(&budgetApplication))
  let frozenRefused = match &frozen {
    Result<InstanceKey, CanonicalizationFailure>.Failure {error} => error == CanonicalizationFailure.Resource
    _ => false
  }
  run Testing.expect(frozenRefused,
    "a collected positional storage domain cannot publish a key after exhausting frozen traversal work")
  let mut budgetRequest = Request.make()
  let budgetValidation = run Semantic.validateApplication(&mut budgetStore, &mut budgetRequest,
    &budgetApplication, &id, Span.make(usize.ZERO, usize.ZERO))
  let validHeader = match &budgetValidation {
    Result<SpecializationApplication, Shared<Rejection>>.Success {..} => true
    _ => false
  }
  run Testing.expect(validHeader, "the actual authored generic header accepts the same application before its canonical Resource refusal")
  let budgetClosure = run Semantic.closeStaticChain(&mut budgetStore, &mut budgetRequest, &budgetApplication, usize.ONE)
  let budgetHeader = "fn budget<T>() -> () { return () }"
  let budgetStart = offsetOf(budgetText, budgetHeader, usize.ZERO)
  let mut budgetEnd = usize.ZERO
  if budgetStart != usize.MAX { budgetEnd = budgetStart + String.utf8Bytes(budgetHeader).length }
  let originalHeader = match &budgetClosure {
    StaticClosure.Rejected {diagnostic} => Shared.with<Rejection, bool>(&diagnostic,
      fn(found: &Rejection) -> bool {
        return budgetStart != usize.MAX && budgetStart > usize.ZERO && found.code == RejectionCode.Unsupported
          && ModuleId.equals(&found.module, &id) && found.span.start == budgetStart && found.span.end == budgetEnd
      })
    _ => false
  }
  run Testing.expect(originalHeader,
    "a root closure's actual canonical Resource refusal is anchored to its original module and complete authored header")
  return ()
}

// Main lends two distinct locals; both calls reach one canonical instance and one MIR answer.
test effect fn callSitesLendingDistinctLocalsShareOneInstance() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run sharedCallerRegionClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

// Every reference a lowered function makes to instances of `callee`, in reference order.
effect fn calleeReferences(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>, callee: &[u8]) -> Vector<InstanceKey>
! OutOfMemoryError ? &mut Allocator {
  let mut keys = Vector.make<InstanceKey>()
  let index = Shared.with<Result<Answer, NoRejection>, Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: at} = move index {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, at) {
      let references = Vector.asSlice<MirReference>(&function.references)
      let mut reference = usize.ZERO
      while reference < references.length {
        let identity = InstanceKey.identity(&references[reference].key)
        if Shared.with<DeclarationId, bool>(&identity, fn(found: &DeclarationId) -> bool { return DeclarationId.named(found, callee) }) {
          run Vector.append<InstanceKey>(&mut keys, InstanceKey.copy(&references[reference].key))
        }
        reference = reference + usize.ONE
      }
    }
  }
  return move keys
}

effect fn sharedCallerRegionClaims() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("caller-region-instances.silk")
  let text = """
fn accepts(input: &i32) -> bool { return true }
pub fn main() -> i32 {
  let first: i32 = 1
  let second: i32 = 2
  let left = accepts(&first)
  let right = accepts(&second)
  if left && right { return 42 }
  return 0
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let entry = run Semantic.demandMir(&mut store, &mut request, &id, b"main")
  let keys = run calleeReferences(&store, &entry, b"accepts")
  let listed = Vector.asSlice<InstanceKey>(&keys)
  let mut shared = succeeded(&entry) && listed.length == 2
  if shared {
    shared = run InstanceKey.sameApplication(&listed[usize.ZERO], &listed[usize.ONE])
    let application = run InstanceKey.selected(&listed[usize.ZERO])
    let arguments = Vector.asSlice<Argument>(&application.arguments)
    if arguments.length == usize.ONE {
      shared = shared && match &arguments[usize.ZERO] {
        Argument.Lifetime {value} => Shared.with<Lifetime, bool>(&value, fn(region: &Lifetime) -> bool { return suppliedAt(region, usize.ZERO) })
        _ => false
      }
    } else { shared = false }
    let firstMir = run sourceCallMir(&mut store, &mut request, &entry, &listed[usize.ZERO], usize.ZERO, false)
    let secondMir = run sourceCallMir(&mut store, &mut request, &entry, &listed[usize.ONE], usize.ONE, false)
    let firstIndex = Shared.with<Result<Answer, NoRejection>, Option<usize>>(&firstMir, selectedMirIndex)
    let secondIndex = Shared.with<Result<Answer, NoRejection>, Option<usize>>(&secondMir, selectedMirIndex)
    shared = shared && match &firstIndex {
      Option<usize>.Some {value: one} => match &secondIndex { Option<usize>.Some {value: two} => one == two _ => false }
      _ => false
    }
  }
  run Testing.expect(shared, "two calls lending distinct caller locals reach one canonical instance and one lowered MIR")
  let providedId = run module("caller-region-provision.silk")
  let providedText = """
effect fn provideMut<'env, ?S, A, P, E, ?R>(self: once Effect<'env; A ! E ? R>, provider: &'env mut P) -> A ! E ? Without<R, S>
where &'env mut P provides S from R {
  let bound = Intrinsic.bindRequirementMut<S>(move self, provider)
  return run bound
}
service Sink { effect fn put(value: &i32) -> () ? &mut Sink }
struct Cell { value: i32 }
effect fn put(self: &mut Cell, value: &i32) -> () { self.value = self.value + value.* }
impl Sink for Cell { put: Cell.put }
effect fn emit(value: &i32) -> () ? &mut Sink { run Sink.put(value) }
effect fn measured(value: &i32) -> i32 {
  let mut cell = Cell { value: 1 }
  run emit(value) |> provideMut<Sink>(&mut cell)
  return cell.value
}
fn root() -> i32 {
  let local: i32 = 41
  return run measured(&local)
}
effect fn provideWith<'env, ?S, A, P, E, F, ?R, ?Q>(self: once Effect<'env; A ! E ? R>, acquire: once Effect<'env; P ! F ? Q>)
  -> A ! E | F ? Without<R, S> | Q
where &'env mut P provides S from R {
  let mut provider = run move acquire
  let bound = Intrinsic.bindRequirementMut<S>(move self, &mut provider)
  return run bound
}
effect fn makeCell() -> Cell { return Cell { value: 1 } }
effect fn acquired(value: &i32) -> () { run emit(value) |> provideWith<Sink>(makeCell()) }
"""
  let mut providedStore = run staticSemantic(&providedId, providedText, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut providedRequest = Request.make()
  let root = run Semantic.demandMir(&mut providedStore, &mut providedRequest, &providedId, b"root")
  let measuredKeys = run calleeReferences(&providedStore, &root, b"measured")
  let measuredListed = Vector.asSlice<InstanceKey>(&measuredKeys)
  let mut provided = succeeded(&root) && measuredListed.length == usize.ONE
  if provided {
    let measuredMir = run sourceCallMir(&mut providedStore, &mut providedRequest, &root, &measuredListed[usize.ZERO], usize.ZERO, false)
    provided = succeeded(&measuredMir)
  }
  run Testing.expect(provided, "an Effect lending a caller region is provided a local exclusive provider in that caller's instance")
  let withAcquired = run Semantic.demandSignature(&mut providedStore, &mut providedRequest, &providedId, b"provideWith")
  let acquiring = run Semantic.demandBody(&mut providedStore, &mut providedRequest, &providedId, b"acquired")
  run Testing.expect(succeeded(&withAcquired) && succeeded(&acquiring),
    "a requirement row joining a Without term with another row binder resolves each operand")
  let localId = run module("local-provider-premise.silk")
  let localText = """
effect<'env> fn provideOwned<'env, ?S, A, P: 'env, E, ?R>(self: once Effect<'env; A ! E ? R>, made: P) -> A ! E ? Without<R, S>
where &'env mut P provides S from R {
  let mut provider = move made
  let bound = Intrinsic.bindRequirementMut<S>(move self, &mut provider)
  return run bound
}
effect<'env> fn provideOther<'env, ?S, A, P: 'env, Q: 'env, E, ?R>(self: once Effect<'env; A ! E ? R>, made: P, other: &'env mut Q) -> A ! E ? Without<R, S>
where &'env mut Q provides S from R {
  let mut provider = move made
  let bound = Intrinsic.bindRequirementMut<S>(move self, &mut provider)
  return run bound
}
"""
  let mut localStore = run staticSemantic(&localId, localText, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut localRequest = Request.make()
  let owned = run Semantic.demandBody(&mut localStore, &mut localRequest, &localId, b"provideOwned")
  run Testing.expect(succeeded(&owned),
    "a declared provides bound covers a local exclusive borrow of the same provider type, whatever the loan's region")
  let other = run Semantic.demandBody(&mut localStore, &mut localRequest, &localId, b"provideOther")
  run Testing.expect(rejectsSpan(&other, RejectionCode.Unsupported, localText, "&mut provider", usize.ONE),
    "a bound for a different provider type does not cover the borrowed provider")
  return ()
}

test effect fn genericRecipeCyclesKeepExactLifetimesAndSafety() -> ()
! CanonicalizationFailure | InvalidModulePath | BackendGap | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run recipeCycleSharingClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn recipeCycleSharingClaims() -> ()
! CanonicalizationFailure | InvalidModulePath | BackendGap | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("recipe-cycle-sharing.silk")
  let first = run recipeControlKey(&id, b"cycle", false)
  let second = run recipeControlKey(&id, b"cycle", true)
  let unrelated = run recipeControlKey(&id, b"unrelated", false)
  let selfEdge = [InstanceKey.copy(&first)]
  let firstEdge = [InstanceKey.copy(&second)]
  let secondEdge = [InstanceKey.copy(&first)]
  let empty = Vector.make<InstanceKey>()
  let mut single = Vector.make<InstanceRecipe>()
  run appendRecipeControl(&mut single, &first, &selfEdge, Option.none<bool>(), true)
  let alone = run recipeControlPlan(Vector.asSlice<InstanceRecipe>(&single))
  let mut alternating = Vector.make<InstanceRecipe>()
  run appendRecipeControl(&mut alternating, &first, &firstEdge, Option.none<bool>(), true)
  run appendRecipeControl(&mut alternating, &second, &secondEdge, Option.none<bool>(), false)
  let paired = run recipeControlPlan(Vector.asSlice<InstanceRecipe>(&alternating))
  let firstAt = run recipeIdentityAt(&paired, &first)
  let secondAt = run recipeIdentityAt(&paired, &second)
  let selfEquivalent = run recipePlansAgree(&alone, &paired, &first)
  run Testing.expect(
    firstAt != secondAt && Vector.length<EmissionIdentity>(&paired.identities) == 2 && selfEquivalent,
    "self and mutual recursion preserve each exact lifetime instance symbol without graph-derived identity",
  )
  run Testing.expect(
    Vector.asSlice<EmissionIdentity>(&paired.identities)[firstAt].safetyChecked && !Vector.asSlice<
      EmissionIdentity,
    >(&paired.identities)[secondAt].safetyChecked && Vector.asSlice<EmissionIdentity>(
      &alone.identities,
    )[usize.ZERO].safetyChecked,
    "each exact recursive instance retains its own checked safety evidence",
  )
  let mut reversed = Vector.make<InstanceRecipe>()
  run appendRecipeControl(&mut reversed, &unrelated, Vector.asSlice<InstanceKey>(&empty), Option.some<bool>(true), true)
  run appendRecipeControl(&mut reversed, &second, &secondEdge, Option.none<bool>(), false)
  run appendRecipeControl(&mut reversed, &first, &firstEdge, Option.none<bool>(), true)
  let reordered = run recipeControlPlan(Vector.asSlice<InstanceRecipe>(&reversed))
  let reversedAt = run recipeIdentityAt(&reordered, &first)
  let firstEquivalent = run recipePlansAgree(&paired, &reordered, &first)
  let secondEquivalent = run recipePlansAgree(&paired, &reordered, &second)
  run Testing.expect(
    firstEquivalent && secondEquivalent && Vector.asSlice<EmissionIdentity>(&reordered.identities)[reversedAt].safetyChecked,
    "reversed representative order and an unrelated first component change neither canonical identity nor safety reporting")
}

test effect fn genericRecipeMutualCyclesIgnoreLeafBodies() -> ()
! CanonicalizationFailure | InvalidModulePath | BackendGap | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run recipeTransitiveCycleClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn recipeTransitiveCycleClaims() -> ()
! CanonicalizationFailure | InvalidModulePath | BackendGap | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("recipe-cycle-stability.silk")
  let outer = run recipeControlKey(&id, b"outer", false)
  let inner = run recipeControlKey(&id, b"inner", false)
  let leaf = run recipeControlKey(&id, b"leaf", false)
  let outerEdges = [InstanceKey.copy(&inner)]
  let innerEdges = [InstanceKey.copy(&outer), InstanceKey.copy(&leaf)]
  let empty = Vector.make<InstanceKey>()
  let mut before = Vector.make<InstanceRecipe>()
  run appendRecipeControl(&mut before, &outer, &outerEdges, Option.none<bool>(), true)
  run appendRecipeControl(&mut before, &inner, &innerEdges, Option.none<bool>(), true)
  run appendRecipeControl(
    &mut before,
    &leaf,
    Vector.asSlice<InstanceKey>(&empty),
    Option.some<bool>(true),
    true,
  )
  let original = run recipeControlPlan(Vector.asSlice<InstanceRecipe>(&before))
  let mut after = Vector.make<InstanceRecipe>()
  run appendRecipeControl(
    &mut after,
    &leaf,
    Vector.asSlice<InstanceKey>(&empty),
    Option.some<bool>(false),
    true,
  )
  run appendRecipeControl(&mut after, &inner, &innerEdges, Option.none<bool>(), true)
  run appendRecipeControl(&mut after, &outer, &outerEdges, Option.none<bool>(), true)
  let changed = run recipeControlPlan(Vector.asSlice<InstanceRecipe>(&after))
  let outerSame = run recipePlansAgree(&original, &changed, &outer)
  let innerSame = run recipePlansAgree(&original, &changed, &inner)
  let leafSame = run recipePlansAgree(&original, &changed, &leaf)
  run Testing.expect(
    outerSame && innerSame && leafSame,
    "a leaf body edit preserves both mutually recursive caller symbols and the leaf linkage identity",
  )
  run Testing.expect(
    !EmissionPlan.hasSymbolConflict(&original) && !EmissionPlan.hasSymbolConflict(&changed),
    "recursive exact identities resolve consistently in both discovery orders",
  )
  let forward = [InstanceKey.copy(&inner), InstanceKey.copy(&leaf)]
  let backward = [InstanceKey.copy(&leaf), InstanceKey.copy(&inner)]
  let first = run recipeControlMir(&outer, &forward, Option.none<bool>(), true)
  let second = run recipeControlMir(&outer, &backward, Option.none<bool>(), true)
  let layouts = Vector.make<TypeLayout>()
  let foreign = Vector.make<CAbi.Signature>()
  let one = run InstanceText.content(
    &first,
    &MachineTarget.forId(TargetId.X8664UnknownLinuxGnu),
    Vector.asSlice<TypeLayout>(&layouts),
    Vector.asSlice<CAbi.Signature>(&foreign),
    b"",
  )
  let two = run InstanceText.content(
    &second,
    &MachineTarget.forId(TargetId.X8664UnknownLinuxGnu),
    Vector.asSlice<TypeLayout>(&layouts),
    Vector.asSlice<CAbi.Signature>(&foreign),
    b"",
  )
  run Testing.expect(
    !sameBytes(Bytes.asSlice(&one), Bytes.asSlice(&two)),
    "LLVM content retains call-site order even though linkage does not contain instruction bodies",
  )
}

fn llvmAnswerIndex(answer: &Result<Answer, NoRejection>) -> usize {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.LlvmText {index}} => index
      _ => usize.MAX
    }
    _ => usize.MAX
  }
}

fn llvmAnswerId(answer: &Result<Answer, NoRejection>) -> usize {
  return Pointer.address<Result<Answer, NoRejection>>(
    Pointer.fromRef<Result<Answer, NoRejection>>(answer),
  )
}

fn llvmBuildTextEqual(first: &BackendBuild, second: &BackendBuild) -> bool {
  return match & first.* {
    BackendBuild.Module {text, ..} => match & second.* {
      BackendBuild.Module {text: compared, ..} => sameBytes(
        Bytes.asSlice(&text),
        Bytes.asSlice(&compared),
      )
      _ => false
    }
    _ => false
  }
}

fn llvmDefinitionsSorted(built: &BackendBuild) -> bool {
  if let BackendBuild.Module {text: bytes, ..} = &built.* {
    let text = Bytes.asSlice(&bytes)
    let mut previous = usize.ZERO
    let mut previousLength = usize.ZERO
    let mut count = usize.ZERO
    let mut start = usize.ZERO
    while start < text.length {
      let mut end = start
      while end < text.length && text[end] != 10 {
        end = end + usize.ONE
      }
      if end - start > 7 && sameBytes(Slice.view<u8>(text, start, 7), b"define ") {
        let mut symbol = start + 7
        while symbol < end && text[symbol] != 64 {
          symbol = symbol + usize.ONE
        }
        if symbol == end {
          return false
        }
        symbol = symbol + usize.ONE
        let mut tail = symbol
        while tail < end && text[tail] != 40 {
          tail = tail + usize.ONE
        }
        if tail == end {
          return false
        }
        if count > usize.ZERO && !RuntimeEncoding.less(
          Slice.view<u8>(text, previous, previousLength),
          Slice.view<u8>(text, symbol, tail - symbol),
        ) {
          return false
        }
        previous = symbol
        previousLength = tail - symbol
        count = count + usize.ONE
      }
      start = end + usize.ONE
    }
    return count > usize.ZERO
  }
  return false
}

test effect fn llvmInstanceAnswersReuseAcrossBuildAndLeafBodyEdit() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run llvmReuseClaims()
    |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn llvmReuseClaims() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
? &mut Allocator {
  let id = run module("llvm-reuse.silk")
  let initial = run present(
    "fn leaf() -> i32 { return 1 }\nfn identity<'a>(value: &'a i32) -> i32 { return value.* }\nfn caller() -> i32 { let held = 2 return identity(&held) + leaf() }\npub fn main() -> i32 { return caller() }\n",
  )
  let authored = run Revision.publish(&Revision.make(), &id, &initial)
  let first = run withEntryRuntime(&authored)
  let mut index = SourceIndex.make(run Revision.copy(&first))
  let callerDeclaration = run requireIndexedIdentity(
    &mut index,
    &id,
    OwnerKind.Function,
    b"caller",
    usize.ZERO,
  )
  let leafDeclaration = run requireIndexedIdentity(
    &mut index,
    &id,
    OwnerKind.Function,
    b"leaf",
    usize.ZERO,
  )
  let caller = run InstanceKey.named(&run Shared.make<DeclarationId>(run DeclarationId.copy(&callerDeclaration)))
  let leaf = run InstanceKey.named(&run Shared.make<DeclarationId>(run DeclarationId.copy(&leafDeclaration)))
  let mut store = makeSemantic(run Revision.copy(&first))
  let mut request = Request.forApplication(run ModuleId.copy(&id))
  let cold = run buildApplication(&mut store, &mut request, staticClosureNodes)
  let callerCold = run Semantic.demandInstanceText(&mut store, &mut request, &caller, &callerDeclaration, Span.make(usize.ZERO, usize.ZERO), false)
  let leafCold = run Semantic.demandInstanceText(&mut store, &mut request, &leaf, &leafDeclaration, Span.make(usize.ZERO, usize.ZERO), false)
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(&callerCold, llvmAnswerDependencies),
    "a caller LLVM answer records its MIR, layouts and signature dependencies without demanding callee bodies or text",
  )
  let produced = starts(Semantic.eventLog(&store), Family.LlvmText)
  run Testing.expect(
    Request.hasDemand(&request, Family.Mir, &id) && Request.hasDemand(
      &request,
      Family.Signature,
      &id,
    ),
    "instance text preparation retains its request demand footprint",
  )
  let warm = run buildApplication(&mut store, &mut request, staticClosureNodes)
  run Testing.expect(
    produced == 6 && starts(Semantic.eventLog(&store), Family.LlvmText) == produced && hits(
      Semantic.eventLog(&store),
      Family.LlvmText,
    ) >= 6 && llvmBuildTextEqual(&cold, &warm) && llvmDefinitionsSorted(&cold) && llvmDefinitionsSorted(
      &warm,
    ),
    "a second build reuses every instance LLVM answer, including the runtime's C export shim",
  )
  let mut scoped = Request.forApplication(run ModuleId.copy(&id))
  let scopedBuild = run buildApplication(&mut store, &mut scoped, staticClosureNodes)
  run Testing.expect(
    starts(Semantic.eventLog(&store), Family.LlvmText) == produced && llvmBuildTextEqual(
      &cold,
      &scopedBuild,
    ),
    "identical LLVM content is reused across semantic requests",
  )
  let changed = run present(
    "fn leaf() -> i32 { return 2 + 20 }\nfn identity<'a>(value: &'a i32) -> i32 { return value.* }\nfn caller() -> i32 { let held = 2 return identity(&held) + leaf() }\npub fn main() -> i32 { return caller() }\n",
  )
  let second = run Revision.publish(&first, &id, &changed)
  Semantic.revise(&mut store, run Revision.copy(&second))
  let edited = run buildApplication(&mut store, &mut request, staticClosureNodes)
  let callerEdited = run Semantic.demandInstanceText(&mut store, &mut request, &caller, &callerDeclaration, Span.make(usize.ZERO, usize.ZERO), false)
  let leafEdited = run Semantic.demandInstanceText(&mut store, &mut request, &leaf, &leafDeclaration, Span.make(usize.ZERO, usize.ZERO), false)
  let oldCaller = Shared.with<Result<Answer, NoRejection>, usize>(&callerCold, llvmAnswerIndex)
  let newCaller = Shared.with<Result<Answer, NoRejection>, usize>(&callerEdited, llvmAnswerIndex)
  let oldLeaf = Shared.with<Result<Answer, NoRejection>, usize>(&leafCold, llvmAnswerIndex)
  let newLeaf = Shared.with<Result<Answer, NoRejection>, usize>(&leafEdited, llvmAnswerIndex)
  run Testing.expect(
    oldCaller != usize.MAX && oldCaller == newCaller && Shared.with<
      Result<Answer, NoRejection>,
      usize,
    >(&callerCold, llvmAnswerId) == Shared.with<Result<Answer, NoRejection>, usize>(
      &callerEdited,
      llvmAnswerId,
    ) && oldLeaf != usize.MAX && newLeaf != usize.MAX && oldLeaf != newLeaf && starts(
      Semantic.eventLog(&store),
      Family.LlvmText,
    ) == produced + usize.ONE && !llvmBuildTextEqual(&cold, &edited) && llvmDefinitionsSorted(
      &edited,
    ),
    "editing a leaf body publishes only its new text answer and changes the artifact, reusing caller answers",
  )
  let values = Semantic.instanceTexts(&store)
  run Testing.expect(
    sameBytes(Bytes.asSlice(&values[oldCaller].symbol), Bytes.asSlice(&values[newCaller].symbol)) && sameBytes(
      Bytes.asSlice(&values[oldLeaf].symbol),
      Bytes.asSlice(&values[newLeaf].symbol),
    ),
    "caller and leaf linkage symbols depend on instance identity, not body content",
  )
}

fn llvmAnswerDependencies(answer: &Result<Answer, NoRejection>) -> bool {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    let entries = Vector.asSlice<Dependency>(&value.dependencies)
    let mut mir = false
    let mut layout = false
    let mut signature = false
    let mut at = usize.ZERO
    while at < entries.length {
      mir = mir || entries[at].family == Family.Mir
      layout = layout || entries[at].family == Family.Layout
      signature = signature || entries[at].family == Family.Signature
      // Own MIR encapsulates lowering; the text answer never demands another body or text.
      if entries[at].family == Family.Body || entries[at].family == Family.LlvmText {
        return false
      }
      at = at + usize.ONE
    }
    return mir && layout && signature
  }
  return false
}

test effect fn llvmRecursiveAnswersReuseAfterLeafEdit() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run llvmRecursiveClaims()
    |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn llvmRecursiveClaims() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
? &mut Allocator {
  let id = run module("llvm-recursive.silk")
  let initial = run present(
    "fn leaf() -> i32 { return 1 }\nfn recur(n: i32) -> i32 { if n == 0 { return 0 } return recur(n - 1) + 1 }\nfn left(n: i32) -> i32 { if n == 0 { return leaf() } return right(n - 1) }\nfn right(n: i32) -> i32 { if n == 0 { return leaf() } return left(n - 1) }\npub fn main() -> i32 { return left(recur(2)) }\n",
  )
  let authored = run Revision.publish(&Revision.make(), &id, &initial)
  let first = run withEntryRuntime(&authored)
  let mut index = SourceIndex.make(run Revision.copy(&first))
  let recurDeclaration = run requireIndexedIdentity(
    &mut index,
    &id,
    OwnerKind.Function,
    b"recur",
    usize.ZERO,
  )
  let leftDeclaration = run requireIndexedIdentity(
    &mut index,
    &id,
    OwnerKind.Function,
    b"left",
    usize.ZERO,
  )
  let rightDeclaration = run requireIndexedIdentity(
    &mut index,
    &id,
    OwnerKind.Function,
    b"right",
    usize.ZERO,
  )
  let recur = run InstanceKey.named(&run Shared.make<DeclarationId>(run DeclarationId.copy(&recurDeclaration)))
  let left = run InstanceKey.named(&run Shared.make<DeclarationId>(run DeclarationId.copy(&leftDeclaration)))
  let right = run InstanceKey.named(&run Shared.make<DeclarationId>(run DeclarationId.copy(&rightDeclaration)))
  let mut store = makeSemantic(run Revision.copy(&first))
  let mut request = Request.forApplication(run ModuleId.copy(&id))
  let cold = run buildApplication(&mut store, &mut request, staticClosureNodes)
  let recurCold = run Semantic.demandInstanceText(&mut store, &mut request, &recur, &recurDeclaration, Span.make(usize.ZERO, usize.ZERO), false)
  let leftCold = run Semantic.demandInstanceText(&mut store, &mut request, &left, &leftDeclaration, Span.make(usize.ZERO, usize.ZERO), false)
  let rightCold = run Semantic.demandInstanceText(&mut store, &mut request, &right, &rightDeclaration, Span.make(usize.ZERO, usize.ZERO), false)
  let produced = starts(Semantic.eventLog(&store), Family.LlvmText)
  let changed = run present(
    "fn leaf() -> i32 { return 22 }\nfn recur(n: i32) -> i32 { if n == 0 { return 0 } return recur(n - 1) + 1 }\nfn left(n: i32) -> i32 { if n == 0 { return leaf() } return right(n - 1) }\nfn right(n: i32) -> i32 { if n == 0 { return leaf() } return left(n - 1) }\npub fn main() -> i32 { return left(recur(2)) }\n",
  )
  let second = run Revision.publish(&first, &id, &changed)
  Semantic.revise(&mut store, move second)
  let edited = run buildApplication(&mut store, &mut request, staticClosureNodes)
  let recurEdited = run Semantic.demandInstanceText(&mut store, &mut request, &recur, &recurDeclaration, Span.make(usize.ZERO, usize.ZERO), false)
  let leftEdited = run Semantic.demandInstanceText(&mut store, &mut request, &left, &leftDeclaration, Span.make(usize.ZERO, usize.ZERO), false)
  let rightEdited = run Semantic.demandInstanceText(&mut store, &mut request, &right, &rightDeclaration, Span.make(usize.ZERO, usize.ZERO), false)
  run Testing.expect(
    produced == 7 && starts(Semantic.eventLog(&store), Family.LlvmText) == produced + usize.ONE && !llvmBuildTextEqual(
      &cold,
      &edited,
    ) && Shared.with<Result<Answer, NoRejection>, usize>(&recurCold, llvmAnswerIndex) != usize.MAX && Shared.with<
      Result<Answer, NoRejection>,
      usize,
    >(&recurCold, llvmAnswerId) == Shared.with<Result<Answer, NoRejection>, usize>(
      &recurEdited,
      llvmAnswerId,
    ) && Shared.with<Result<Answer, NoRejection>, usize>(&leftCold, llvmAnswerId) == Shared.with<
      Result<Answer, NoRejection>,
      usize,
    >(&leftEdited, llvmAnswerId) && Shared.with<Result<Answer, NoRejection>, usize>(
      &rightCold,
      llvmAnswerId,
    ) == Shared.with<Result<Answer, NoRejection>, usize>(&rightEdited, llvmAnswerId),
    "self and mutually recursive LLVM answers and their symbols survive a leaf edit without a text-query cycle",
  )
}

fn llvmGapSpan(answer: &Result<Answer, NoRejection>) -> Span {
  let gap = selectedBackendGap(answer)
  if let Option<Shared<BackendGap>>.Some {value} = move gap {
    return Shared.with<BackendGap, Span>(&value, BackendGap.span)
  }
  return Span.make(usize.MAX, usize.MAX)
}

test effect fn completedInstanceTextGapRefreshesItsSourceSpan() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run instanceTextGapClaims()
    |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn instanceTextGapClaims() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
? &mut Allocator {
  let id = run module("llvm-gap.silk")
  // A C export keeps every written parameter as a C lane, and a unit parameter has none.
  let initial = run present("export \"C\" fn sink(value: ()) -> () as \"sink\" { return () }\n")
  let first = run Revision.publish(&Revision.make(), &id, &initial)
  let mut index = SourceIndex.make(run Revision.copy(&first))
  let declaration = run requireIndexedIdentity(
    &mut index,
    &id,
    OwnerKind.Function,
    b"sink",
    usize.ZERO,
  )
  let instance = InstanceKey.Export {
    function: run Shared.make<DeclarationId>(run DeclarationId.copy(&declaration)),
    symbol: run Shared.make<Bytes>(run Bytes.copy(b"sink")),
  }
  let mut store = makeSemantic(run Revision.copy(&first))
  let mut request = Request.make()
  let cold = run Semantic.demandInstanceText(&mut store, &mut request, &instance, &declaration, Span.make(usize.ZERO, usize.ZERO), false)
  let warm = run Semantic.demandInstanceText(&mut store, &mut request, &instance, &declaration, Span.make(usize.ZERO, usize.ZERO), false)
  let span = Shared.with<Result<Answer, NoRejection>, Span>(&cold, llvmGapSpan)
  run Testing.expect(
    span.start != usize.MAX && span.end > span.start && Shared.with<
      Result<Answer, NoRejection>,
      bool,
    >(
      &cold,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return pipelineGapAt(answer, GapCode.UnitParameter, b"sink", span.start, span.end)
      },
    ) && Shared.with<
      Result<Answer, NoRejection>,
      usize,
    >(&cold, llvmAnswerId) == Shared.with<Result<Answer, NoRejection>, usize>(&warm, llvmAnswerId) && Semantic.instanceTexts(
      &store,
    ).length == usize.ZERO,
    "a completed instance-text gap is reused without publishing a partial definition",
  )
  let changed = run present("\nexport \"C\" fn sink(value: ()) -> () as \"sink\" { return () }\n")
  let second = run Revision.publish(&first, &id, &changed)
  Semantic.revise(&mut store, move second)
  let edited = run Semantic.demandInstanceText(&mut store, &mut request, &instance, &declaration, Span.make(usize.ZERO, usize.ZERO), false)
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(
      &edited,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return pipelineGapAt(
          answer,
          GapCode.UnitParameter,
          b"sink",
          span.start + usize.ONE,
          span.end + usize.ONE,
        )
      },
    ) && Semantic.instanceTexts(&store).length == usize.ZERO,
    "equal unsupported content retries after source movement and reports the current declaration span",
  )
}

test effect fn llvmCalleeSignatureEditInvalidatesCallerAnswer() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run llvmSignatureClaims()
    |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn llvmSignatureClaims() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
? &mut Allocator {
  let id = run module("llvm-signature.silk")
  let initial = run present(
    "fn leaf() -> i32 { return 1 }\npub fn main() -> i32 { let value = leaf() return 0 }\n",
  )
  let first = run Revision.publish(&Revision.make(), &id, &initial)
  let mut index = SourceIndex.make(run Revision.copy(&first))
  let declaration = run requireIndexedIdentity(
    &mut index,
    &id,
    OwnerKind.Function,
    b"main",
    usize.ZERO,
  )
  let caller = run InstanceKey.named(&run Shared.make<DeclarationId>(run DeclarationId.copy(&declaration)))
  let mut store = makeSemantic(run Revision.copy(&first))
  let mut request = Request.make()
  let cold = run Semantic.demandInstanceText(&mut store, &mut request, &caller, &declaration, Span.make(usize.ZERO, usize.ZERO), false)
  let changed = run present(
    "fn leaf() -> u32 { return 1 }\npub fn main() -> i32 { let value = leaf() return 0 }\n",
  )
  let second = run Revision.publish(&first, &id, &changed)
  Semantic.revise(&mut store, move second)
  let edited = run Semantic.demandInstanceText(&mut store, &mut request, &caller, &declaration, Span.make(usize.ZERO, usize.ZERO), false)
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, usize>(&cold, llvmAnswerIndex) != usize.MAX && Shared.with<
      Result<Answer, NoRejection>,
      usize,
    >(&edited, llvmAnswerIndex) != usize.MAX && Shared.with<Result<Answer, NoRejection>, usize>(
      &cold,
      llvmAnswerIndex,
    ) != Shared.with<Result<Answer, NoRejection>, usize>(&edited, llvmAnswerIndex),
    "a callee signature edit invalidates its caller's text answer even when both result types use i32 lanes",
  )
}

test effect fn genericRecipeMissingIdentityIsLoudGap() -> ()
! CanonicalizationFailure | InvalidModulePath | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run recipeMissingIdentityClaims()
    |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn recipeMissingIdentityClaims() -> ()
! CanonicalizationFailure | InvalidModulePath | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("recipe-missing.silk")
  let absent = run recipeControlKey(&id, b"absent", false)
  let plan = EmissionPlan.empty()
  let result = run Effect.result(EmissionPlan.symbol(&plan, &absent))
  let rejected = match &result {
    Result<Bytes, BackendGap | OutOfMemoryError>.Failure {error} => match & error {
      BackendGap {code, owner, source} => code == GapCode.CalleeModule
        && Shared.with<DeclarationId, bool>(&owner, fn(value: &DeclarationId) -> bool {
          return DeclarationId.named(value, b"absent") && ModuleId.equals(
            DeclarationId.moduleId(value),
            &id,
          )
        }) && match &source {
          GapSource.Declaration {span, ..} => span.start == usize.ZERO && span.end == usize.ZERO
          _ => false
        }
      _ => false
    }
    _ => false
  }
  run Testing.expect(
    rejected,
    "an absent exact identity reports callee-module at its declaration span",
  )
}

fn genericGapOwnerMatches(value: &BackendGap, module: &ModuleId, name: &[u8]) -> bool {
  return Shared.with<DeclarationId, bool>(&value.owner, fn(owner: &DeclarationId) -> bool {
    return DeclarationId.named(owner, name) && ModuleId.equals(DeclarationId.moduleId(owner), module)
  })
}

test effect fn genericPropagatedForeignGapKeepsLibrarySource() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let entry = run module("generic-gap-main.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let library = run module("callback_library.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let entryText = """import callback_library { create }
pub fn main() -> i32 { let callback = unsafe create() drop callback return 42 }
"""
  let libraryText = """pub unsafe extern "C" fn create() -> extern "C" fn(i32) -> i32
"""
  let entrySource = run present(entryText) |> Effect.provideMut<Allocator>(&mut allocator)
  let librarySource = run present(libraryText) |> Effect.provideMut<Allocator>(&mut allocator)
  let first = run Revision.publish(&Revision.make(), &entry, &entrySource) |> Effect.provideMut<Allocator>(&mut allocator)
  let held = run Revision.publish(&first, &library, &librarySource) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut store = makeSemantic(move held)
  let mut request = Request.make()
  let mir = run Semantic.demandMir(&mut store, &mut request, &entry, b"main") |> Effect.provideMut<Allocator>(&mut allocator)
  let gap = Shared.with<Result<Answer, NoRejection>, Option<Shared<BackendGap>>>(&mir, selectedBackendGap)
  let retained = match move gap {
    Option<Shared<BackendGap>>.Some {value} => Shared.with<BackendGap, bool>(&value, fn(found: &BackendGap) -> bool {
      let span = BackendGap.span(found)
      return found.code == GapCode.CAbiCallback && BackendGap.moduleMatches(found, &library)
        && !BackendGap.moduleMatches(found, &entry) && span.start == usize.ZERO
        && span.end == String.utf8Bytes(libraryText).length - usize.ONE
        && genericGapOwnerMatches(found, &entry, b"main")
    })
    Option<Shared<BackendGap>>.None => false
  }
  run Testing.expect(retained, "an imported callback signature keeps its library span and module independently of the reached main owner")
  return ()
}

test effect fn genericEffectRunsCallTheirSpecializedInstance() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("generic-effect-runs.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
effect fn produce<T>(value: &T) -> i32 { return 41 }
fn ordinary() -> i32 {
  let held = 5
  return (run produce<i32>(&held)) + 1
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let mir = run Semantic.demandMir(&mut store, &mut request, &id, b"ordinary") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(succeeded(&mir) && failureFact(&store, &mir, 2) == usize.ZERO,
    "running a generic effect fn construction is a direct call of its specialized instance")
  return ()
}

fn signatureResultOf(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Signature {signature}} => Option.some<Shared<Type>>(writtenResult(&signature.result))
      _ => Option.none<Shared<Type>>()
    }
    Result<Answer, NoRejection>.Failure {error: _} => Option.none<Shared<Type>>()
  }
}

fn effectRowOf(found: &Option<Shared<Type>>) -> Option<Shared<Row>> {
  if let Option<Shared<Type>>.Some {value} = &found.* {
    return Shared.with<Type, Option<Shared<Row>>>(&value, effectRequirements)
  }
  return Option.none<Shared<Row>>()
}

// Whether an Effect type's requirement row has these entry, row-parameter, and `Without` counts.
fn effectRowCounts(found: &Option<Shared<Type>>, entries: usize, parameters: usize, subtractions: usize) -> bool {
  if let Option<Shared<Row>>.Some {value} = move effectRowOf(found) {
    return Shared.with<Row, bool>(&value, fn(row: &Row) -> bool {
      return Vector.length<Requirement>(&row.entries) == entries && Vector.length(&row.parameters) == parameters && Vector.length(
        &row.subtractions,
      ) == subtractions
    })
  }
  return false
}

effect fn sameEffectRows(left: &Option<Shared<Type>>, right: &Option<Shared<Type>>) -> bool
! OutOfMemoryError
? &mut Allocator {
  let first = effectRowOf(left)
  let second = effectRowOf(right)
  if let Option<Shared<Row>>.Some {value: from} = move first {
    if let Option<Shared<Row>>.Some {value: to} = move second {
      return run Row.equalsShared(&from, &to)
    }
  }
  return false
}

// Each provision claim group resolves only the declarations it needs.
fn providedRowsFixture(part: usize) -> string<'static> {
  if part == 0 {
    return """
service Clock {}
service Logger {}
role Primary
struct SystemClock {}
impl Clock for SystemClock {}
struct Holder<?H> {}
fn read() -> once Effect<'static; i32 ? &Clock | &Logger> { return missing }
fn bind<'p, ?S, A, P, E, ?R>(self: once Effect<'static; A ! E ? R>, provider: &'p P) -> Effect<'static; A ! E ? Without<R, S>>
where &'p P provides S from R { return missing }
fn kept() -> Effect<'static; i32 ? &Logger> { return missing }
fn clockOnly() -> Effect<'static; i32 ? &Clock> { return missing }
fn residual() -> Effect<'static; i32 ? Without<&mut Clock at Primary | &Logger, Clock at Primary>> { return missing }
fn absentKey() -> Effect<'static; i32 ? Without<&Logger, Clock>> { return missing }
fn nested<?R>(left: Holder<Without<Without<R, Clock>, Logger>>, right: Holder<Without<R, Logger | Clock>>) -> i32 { return 0 }
fn decided<?R>(left: Holder<Without<&Clock | R, &Clock>>, right: Holder<Without<R, Clock>>) -> i32 { return 0 }
fn decidedKey<?R>(left: Holder<Without<&Logger | R, Clock>>, right: Holder<Without<R, Clock> | &Logger>) -> i32 { return 0 }
"""
  }
  if part == 1 {
    return """
service Clock {}
service Logger {}
role Primary
struct SystemClock {}
impl Clock for SystemClock {}
effect fn read() -> i32 ? &Clock | &Logger { return 1 }
effect fn logged() -> i32 ? &Logger { return 1 }
effect fn twice() -> i32 ? &Clock | &Clock at Primary { return 1 }
effect fn advance() -> i32 ? &mut Clock { return 1 }
effect fn mixed() -> i32 ? &Clock at Primary | &mut Clock { return 1 }
effect fn bind<'p, ?S, A, P, E, ?R>(self: once Effect<'static; A ! E ? R>, provider: &'p P) -> A ! E ? Without<R, S>
where &'p P provides S from R { return missing }
effect fn bindMut<'p, ?S, A, P, E, ?R>(self: once Effect<'static; A ! E ? R>, provider: &'p mut P) -> A ! E ? Without<R, S>
where &'p mut P provides S from R { return missing }
effect fn inferred(clock: &SystemClock) -> i32 ? &Logger { return run bind(read(), clock) }
effect fn tight(clock: &SystemClock) -> i32 ? &Clock { return run bind(read(), clock) }
effect fn explicit(clock: &SystemClock) -> i32 ? &Logger { return run bind<Clock>(read(), clock) }
effect fn chosen(clock: &SystemClock) -> i32 ? &Clock { return run bind<Clock at Primary>(twice(), clock) }
effect fn exclusive(clock: &mut SystemClock) -> i32 { return run bindMut(advance(), clock) }
effect fn absent(clock: &SystemClock) -> i32 ? &Logger { return run bind(logged(), clock) }
effect fn ambiguous(clock: &SystemClock) -> i32 ? &Clock { return run bind(twice(), clock) }
effect fn shared(clock: &SystemClock) -> i32 { return run bind(advance(), clock) }
effect fn weak(clock: &SystemClock) -> i32 ? &Clock at Primary { return run bind(mixed(), clock) }
effect fn missingKey(clock: &SystemClock) -> i32 ? &Logger { return run bind<Clock>(logged(), clock) }
effect fn foreignKey(clock: &SystemClock) -> i32 ? &Clock { return run bind<Logger>(read(), clock) }
effect fn twoKeys(clock: &SystemClock) -> i32 { return run bind<Clock | Logger>(read(), clock) }
effect fn accessKey(clock: &SystemClock) -> i32 ? &Logger { return run bind<&Clock>(read(), clock) }
effect fn bindBorrowed<'p, A, P, E, ?R>(self: once Effect<'static; A ! E ? R>, provider: &'p P) -> A ! E ? Without<R, Clock>
where &'p P provides &Clock from R { return missing }
effect fn borrowedSelector(clock: &SystemClock) -> i32 ? &Logger { return run bindBorrowed(read(), clock) }
"""
  }
  if part == 2 {
    return """
service Clock {}
service Logger {}
struct SystemClock {}
struct Doubled {}
impl Clock for Doubled {}
impl Clock for Doubled {}
effect fn read() -> i32 ? &Clock | &Logger { return 1 }
effect fn bind<'p, ?S, A, P, E, ?R>(self: once Effect<'static; A ! E ? R>, provider: &'p P) -> A ! E ? Without<R, S>
where &'p P provides S from R { return missing }
effect fn witnesses(clock: &Doubled) -> i32 ? &Logger { return run bind(read(), clock) }
effect fn covered(pending: once Effect<'static; i32 ? Without<&Clock | &Logger, Clock>>) -> i32 ? &Logger { return run move pending }
effect fn uncovered(pending: once Effect<'static; i32 ? Without<&Clock | &Logger, Clock>>) -> i32 { return run move pending }
effect fn forward<?S, ?R>(pending: once Effect<'static; i32 ? Without<R, S>>) -> i32 ? Without<R, S> { return run move pending }
effect fn widened<?S, ?R>(pending: once Effect<'static; i32 ? Without<R, S>>) -> i32 ? R { return run move pending }
effect fn leaks<?S, ?R>(pending: once Effect<'static; i32 ? Without<R, S>>) -> i32 { return run move pending }
"""
  }
  if part == 3 {
    return """
service Clock {}
struct SystemClock {}
impl Clock for SystemClock {}
struct Holder<?H> {}
struct Lent<'a, ?H> { value: &'a SystemClock }
struct Pair<T, U> { left: T }
fn clockHolder(value: Holder<&Clock>) -> i32 { return 0 }
fn pick<'a, T, 'b>(x: &'a T, y: &'b T) -> &'a T { return missing }
fn hold<'a, T>(x: &'a T) -> &'a T { return missing }
fn rowed<'a, ?R>(value: &'a SystemClock) -> Holder<R> { return missing }
fn wrap<T, U>(value: T) -> Pair<T, U> { return missing }
fn apply<A, B>(transform: fn(A) -> B, value: A) -> B { return missing }
effect fn reading() -> i32 ? &Clock { return 1 }
effect fn bindP<'p, ?S, A, P, E, ?R>(self: once Effect<'static; A ! E ? R>, provider: &'p P) -> A ! E ? Without<R, S>
where &'p P provides S from R { return missing }
effect fn envBound<'env, P>(pending: once Effect<'env; i32>, provider: &'env P) -> i32 { return missing }
effect fn fixed() -> i32 { return 1 }
fn picked(first: &'static i32, second: &i32) -> i32 { let chosen = pick<i32, 'static>(first, second) return 0 }
fn held<'x>(value: &'x i32) -> i32 { let kept = hold<i32, 'x>(value) return 0 }
fn suffixed(value: &SystemClock) -> i32 { let rows = rowed<&Clock>(value) return 0 }
fn overfull(value: &i32) -> i32 { let kept = hold<i32, i64>(value) return 0 }
fn lent(value: &SystemClock) -> i32 { let made = Lent<? &Clock> {value: value} return 0 }
fn wrapped(value: &SystemClock) -> i32 { let made = apply(wrap, 1) return 0 }
fn promised(value: &SystemClock) -> i32 { let made = apply<i32, Pair<i32, bool>>(wrap, 1) return 0 }
fn piped(value: &SystemClock) -> i32 { let pending = reading() |> bindP(value) return 0 }
fn shared() -> i32 { let local = SystemClock {} let pending = envBound(fixed(), &local) return 0 }
fn declaredShared(clock: &SystemClock) -> i32 { let pending = envBound(fixed(), clock) return 0 }
"""
  }
  return ""
}

fn holderRow(value: &Type) -> Option<Shared<Row>> {
  if let Type.Nominal {arguments, ..} = &value.* {
    let listed = Vector.asSlice<Argument>(&arguments)
    if listed.length == usize.ONE {
      if let Argument.Row {value: row} = &listed[usize.ZERO] {
        return Option.some<Shared<Row>>(Shared.clone<Row>(&row))
      }
    }
  }
  return Option.none<Shared<Row>>()
}

// Whether a signature's two `Holder<...>` parameters carry equal rows.
effect fn sameHolderRows(answer: &Shared<Result<Answer, NoRejection>>) -> bool ! OutOfMemoryError ? &mut Allocator {
  let left = slotOf(answer, usize.ZERO)
  let right = slotOf(answer, usize.ONE)
  if let Option<Shared<Type>>.Some {value: first} = move left {
    if let Option<Shared<Type>>.Some {value: second} = move right {
      let firstRow = Shared.with<Type, Option<Shared<Row>>>(&first, holderRow)
      let secondRow = Shared.with<Type, Option<Shared<Row>>>(&second, holderRow)
      if let Option<Shared<Row>>.Some {value: from} = move firstRow {
        if let Option<Shared<Row>>.Some {value: to} = move secondRow {
          return run Row.equalsShared(&from, &to)
        }
      }
    }
  }
  return false
}

effect fn providedRowsAfter(store: &mut Semantic, request: &mut Request, id: &ModuleId, name: string) -> Option<Shared<Type>>
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let body = run Semantic.demandBody(&mut store.*, &mut request.*, id, String.utf8Bytes(name))
  return bodyLocalType(&body, usize.ONE)
}

effect fn providedSignatureResult(store: &mut Semantic, request: &mut Request, id: &ModuleId, name: string) -> Option<Shared<Type>>
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let answer = run Semantic.demandSignature(&mut store.*, &mut request.*, id, String.utf8Bytes(name))
  return Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(&answer, signatureResultOf)
}

test effect fn providedWithoutRowsNormalizeByKey() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("provided-rows.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = providedRowsFixture(0)
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let generic = run providedSignatureResult(&mut store, &mut request, &id, "bind") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(effectRowCounts(&generic, usize.ZERO, usize.ZERO, usize.ONE),
    "a provides-bounded signature resolves and keeps Without<R, S> as one unresolved term")
  let kept = run providedSignatureResult(&mut store, &mut request, &id, "kept") |> Effect.provideMut<Allocator>(&mut allocator)
  let residual = run providedSignatureResult(&mut store, &mut request, &id, "residual") |> Effect.provideMut<Allocator>(&mut allocator)
  let absentKey = run providedSignatureResult(&mut store, &mut request, &id, "absentKey") |> Effect.provideMut<Allocator>(&mut allocator)
  let residualKept = run sameEffectRows(&residual, &kept) |> Effect.provideMut<Allocator>(&mut allocator)
  let absentKept = run sameEffectRows(&absentKey, &kept) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(residualKept && absentKept,
    "concrete Without removes the whole keyed entry regardless of access, and an absent key is a no-op")
  let nested = run Semantic.demandSignature(&mut store, &mut request, &id, b"nested") |> Effect.provideMut<Allocator>(&mut allocator)
  let decidedKey = run Semantic.demandSignature(&mut store, &mut request, &id, b"decidedKey") |> Effect.provideMut<Allocator>(&mut allocator)
  let nestedSame = run sameHolderRows(&nested) |> Effect.provideMut<Allocator>(&mut allocator)
  let decidedSame = run sameHolderRows(&decidedKey) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(nestedSame && decidedSame,
    "nested and reordered Without terms normalize to one term, and decided entries leave the term")
  let decided = run Semantic.demandSignature(&mut store, &mut request, &id, b"decided") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsSpan(&decided, RejectionCode.InvalidRequirement, text, "&Clock", 3),
    "a Without key operand cannot carry access")
  return ()
}

// Whether a type-arity rejection sits at `spelling` and counts only the ordinary namespace.
fn ordinaryArity(answer: &Shared<Result<Answer, NoRejection>>, text: string, spelling: string, expected: usize, supplied: usize) -> bool {
  let start = offsetOf(text, spelling, usize.ZERO)
  let found = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(answer, rejection)
  if let Option<Shared<Rejection>>.Some {value} = move found {
    return Shared.with<Rejection, bool>(&value, fn(problem: &Rejection) -> bool {
      return problem.code == RejectionCode.TypeArity && problem.span.start == start && problem.expected == expected && problem.supplied == supplied
    })
  }
  return false
}

test effect fn providedSelectionChoosesOneCompatibleKey() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("provided-rows.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = providedRowsFixture(1)
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  // A residual row is observed through run coverage of the enclosing `effect fn` row.
  let inferred = run providedSucceeds(&mut store, &mut request, &id, "inferred") |> Effect.provideMut<Allocator>(&mut allocator)
  let tight = run providedRejects(&mut store, &mut request, &id, "tight", RejectionCode.UnhandledRequirement, text,
    "run bind(read(), clock)", usize.ONE) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(inferred && tight, "an omitted selector infers the one conforming key and subtracts only it")
  let explicit = run providedSucceeds(&mut store, &mut request, &id, "explicit") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(explicit, "an explicit selector skips the leading lifetime binder and subtracts its key")
  let chosen = run providedSucceeds(&mut store, &mut request, &id, "chosen") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(chosen, "a role selector resolves key ambiguity and leaves the default-role entry")
  let exclusive = run providedSucceeds(&mut store, &mut request, &id, "exclusive") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(exclusive, "an exclusive provider satisfies an exclusive entry and leaves an empty row")
  let borrowed = run providedSucceeds(&mut store, &mut request, &id, "borrowedSelector") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(borrowed, "a declared selector may spell its key with a borrow; only the key selects and subtracts")
  return ()
}

test effect fn providedSelectionRejectsAbsentAmbiguousAndWeakKeys() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("provided-rows.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = providedRowsFixture(1)
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let absent = run providedRejects(&mut store, &mut request, &id, "absent", RejectionCode.MissingProvidedKey, text,
    "bind(logged(), clock)", usize.ZERO) |> Effect.provideMut<Allocator>(&mut allocator)
  let missingKey = run providedRejects(&mut store, &mut request, &id, "missingKey", RejectionCode.MissingProvidedKey, text,
    "bind<Clock>(logged(), clock)", usize.ZERO) |> Effect.provideMut<Allocator>(&mut allocator)
  let foreignKey = run providedRejects(&mut store, &mut request, &id, "foreignKey", RejectionCode.MissingProvidedKey, text,
    "bind<Logger>(read(), clock)", usize.ZERO) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(absent && missingKey && foreignKey,
    "no conforming key, an absent selected key, and a selected key the provider does not conform to reject")
  let ambiguous = run providedRejects(&mut store, &mut request, &id, "ambiguous", RejectionCode.AmbiguousProvidedKey, text,
    "bind(twice(), clock)", usize.ZERO) |> Effect.provideMut<Allocator>(&mut allocator)
  let shared = run providedRejects(&mut store, &mut request, &id, "shared", RejectionCode.InsufficientProviderAccess, text,
    "bind(advance(), clock)", usize.ZERO) |> Effect.provideMut<Allocator>(&mut allocator)
  let weak = run providedRejects(&mut store, &mut request, &id, "weak", RejectionCode.InsufficientProviderAccess, text,
    "bind(mixed(), clock)", usize.ZERO) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(ambiguous && shared && weak,
    "ambiguity needs a selector, and a shared borrow never silently skips an exclusive candidate")
  let twoKeys = run providedRejects(&mut store, &mut request, &id, "twoKeys", RejectionCode.ProviderSelectorCardinality, text,
    "bind<Clock | Logger>(read(), clock)", usize.ZERO) |> Effect.provideMut<Allocator>(&mut allocator)
  let accessKey = run providedRejects(&mut store, &mut request, &id, "accessKey", RejectionCode.InvalidRequirement, text,
    "&Clock", 9) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(twoKeys, "a selector names exactly one key")
  run Testing.expect(accessKey, "a selector cannot carry access")
  return ()
}

fn lentRow(value: &Type) -> bool {
  if let Type.Nominal {arguments, ..} = &value.* {
    let listed = Vector.asSlice<Argument>(&arguments)
    let mut at = usize.ZERO
    while at < listed.length {
      if let Argument.Row {value: row} = &listed[at] {
        return Shared.with<Row, bool>(&row, fn(found: &Row) -> bool { return Vector.length<Requirement>(&found.entries) == usize.ONE })
      }
      at = at + usize.ONE
    }
  }
  return false
}

// Whether two `Holder<...>` types carry equal rows.
effect fn sameHolderRow(left: &Option<Shared<Type>>, right: Option<Shared<Type>>) -> bool ! OutOfMemoryError ? &mut Allocator {
  if let Option<Shared<Type>>.Some {value: first} = &left.* {
    if let Option<Shared<Type>>.Some {value: second} = move right {
      let firstRow = Shared.with<Type, Option<Shared<Row>>>(&first, holderRow)
      let secondRow = Shared.with<Type, Option<Shared<Row>>>(&second, holderRow)
      if let Option<Shared<Row>>.Some {value: from} = move firstRow {
        if let Option<Shared<Row>>.Some {value: to} = move secondRow {
          return run Row.equalsShared(&from, &to)
        }
      }
    }
  }
  return false
}

test effect fn providedCallPrefixesMapLifetimesSeparately() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("provided-rows.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = providedRowsFixture(3)
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let clockHolder = run Semantic.demandSignature(&mut store, &mut request, &id, b"clockHolder") |> Effect.provideMut<Allocator>(&mut allocator)
  let picked = run Semantic.demandBody(&mut store, &mut request, &id, b"picked") |> Effect.provideMut<Allocator>(&mut allocator)
  let chosenRegion = bodyLocalType(&picked, 2)
  let pickedStatic = match move chosenRegion {
    Option<Shared<Type>>.Some {value} => Shared.with<Type, bool>(&value, staticReference)
    Option<Shared<Type>>.None => false
  }
  run Testing.expect(pickedStatic, "a written lifetime binds the first lifetime binder, not the next binder position")
  let held = run providedSucceeds(&mut store, &mut request, &id, "held") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(held, "a lifetime written after a type still binds the leading lifetime binder")
  let suffixed = run providedRowsAfter(&mut store, &mut request, &id, "suffixed") |> Effect.provideMut<Allocator>(&mut allocator)
  let suffixedSame = run sameHolderRow(&suffixed, slotOf(&clockHolder, usize.ZERO)) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(suffixedSame, "a row argument takes the next ordinary binder past a leading lifetime")
  let overfull = run Semantic.demandBody(&mut store, &mut request, &id, b"overfull") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(ordinaryArity(&overfull, text, "i64>(value)", usize.ONE, 2),
    "an excess type argument reports the ordinary-namespace arity")
  let lent = run providedRowsAfter(&mut store, &mut request, &id, "lent") |> Effect.provideMut<Allocator>(&mut allocator)
  let lentKeyed = match move lent {
    Option<Shared<Type>>.Some {value} => Shared.with<Type, bool>(&value, lentRow)
    Option<Shared<Type>>.None => false
  }
  run Testing.expect(lentKeyed, "a `? Row` suffix continues the ordinary namespace past a leading lifetime")
  let wrapped = run providedRejects(&mut store, &mut request, &id, "wrapped", RejectionCode.SectionResultInferenceUnavailable,
    text, "wrap", 2) |> Effect.provideMut<Allocator>(&mut allocator)
  let piped = run providedSucceeds(&mut store, &mut request, &id, "piped") |> Effect.provideMut<Allocator>(&mut allocator)
  let shared = run providedRelates(&mut store, &mut request, &id, "shared", text, "envBound(fixed(), &local)", usize.ZERO)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let promised = run providedSucceeds(&mut store, &mut request, &id, "promised") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(wrapped, "a result-only section binder is the named result-inference deferral")
  run Testing.expect(promised, "a function value takes a result-only binder from the closed contract its parameter promises")
  run Testing.expect(piped, "a provision section's omitted selector waits for the piped Effect's row")
  run Testing.expect(shared, "an Effect environment and a distinct local borrow sharing one binder relate as an open obligation")
  let declaredShared = run Semantic.demandBody(&mut store, &mut request, &id, b"declaredShared") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(succeeded(&declaredShared) && regionRelationCount(&declaredShared) == usize.ONE,
    "a binder a 'static Effect environment fixed relates a later loan of a declared lifetime as one open obligation")
  return ()
}

test effect fn providedRunsAndWitnessesCheckResidualRows() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("provided-rows.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = providedRowsFixture(2)
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let witnesses = run providedRejects(&mut store, &mut request, &id, "witnesses", RejectionCode.DuplicateConformance, text,
    "impl Clock for Doubled {}", usize.ONE) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(witnesses, "competing conformance witnesses reject before selection")
  let covered = run providedSucceeds(&mut store, &mut request, &id, "covered") |> Effect.provideMut<Allocator>(&mut allocator)
  let uncovered = run providedRejects(&mut store, &mut request, &id, "uncovered", RejectionCode.UnhandledRequirement, text,
    "run move pending", usize.ONE) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(covered && uncovered, "a concrete residual row must be covered by the enclosing row")
  let forward = run providedSucceeds(&mut store, &mut request, &id, "forward") |> Effect.provideMut<Allocator>(&mut allocator)
  let widened = run providedSucceeds(&mut store, &mut request, &id, "widened") |> Effect.provideMut<Allocator>(&mut allocator)
  let leaks = run providedRejects(&mut store, &mut request, &id, "leaks", RejectionCode.UnhandledRequirement, text,
    "run move pending", 4) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(forward, "an equal Without<R, S> term covers a symbolic residual row")
  run Testing.expect(widened, "the source row R bounds Without<R, S>")
  run Testing.expect(leaks, "an empty enclosing row cannot cover a symbolic Without<R, S>")
  return ()
}

test effect fn genericSealedUnknownDropProofIsNotAbsence() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("generic-sealed-unknown-drop.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
struct Pending<T> { value: T }
impl<T: Intrinsic.Detached> Drop for Pending<T> { fn drop(self: &mut Pending<T>) -> () { return () } }
fn inspect(value: Pending<i32>) -> i32 { return 0 }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let body = run Semantic.demandBody(&mut store, &mut request, &id, b"inspect") |> Effect.provideMut<Allocator>(&mut allocator)
  let ty = match move bodyLocalType(&body, usize.ZERO) {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => { run Testing.expect(false, "the complete instance is typed before its property proof is needed") return () }
  }
  let sourceOwner = run glueSourceOwner(&mut store, &body) |> Effect.provideMut<Allocator>(&mut allocator)
  let glue = run Semantic.demandGlueMir(&mut store, &mut request, &ty, &sourceOwner) |> Effect.provideMut<Allocator>(&mut allocator)
  let failure = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(&glue, rejection)
  let explicit = match move failure {
    Option<Shared<Rejection>>.Some {value} => Shared.with<Rejection, bool>(&value, fn(problem: &Rejection) -> bool {
      return problem.code == RejectionCode.Unsupported && problem.span.start == usize.ZERO && problem.span.end == usize.ZERO
    })
    Option<Shared<Rejection>>.None => false
  }
  run Testing.expect(explicit, "an unavailable concrete property proof rejects the site-free glue identity instead of silently omitting Drop")
  return ()
}

fn recordOperandsKeepWrittenOrder(body: &TypedBody) -> bool {
  let nodes = TypedBody.nodeSlice(body)
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {form: BodyExpression.Aggregate {fields}, ..} = &nodes[at].kind {
      let operands = Vector.asSlice<BodyAggregateField>(&fields)
      if operands.length == 2 {
        return operands[usize.ZERO].index == usize.ONE && operands[usize.ONE].index == usize.ZERO
      }
    }
    at = at + usize.ONE
  }
  return false
}

test effect fn recordConstructionAndAssignmentRetainCanonicalFields() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("record-fields.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let mut store = run applicationSemantic(&id, """
struct Pair {
  left: i32
  right: i32
}
fn create() -> Pair { return Pair { left: 40, right: 2 } }
fn sum(pair: Pair) -> i32 { return pair.left + pair.right }
pub fn main() -> i32 {
  let mut pair = Pair { right: 22, left: 20 }
  pair.left = 21
  return sum(create()) + pair.left + pair.right
}
""", MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.forApplication(run ModuleId.copy(&id) |> Effect.provideMut<Allocator>(&mut allocator))
  let bodyAnswer = run Semantic.demandBody(&mut store, &mut request, &id, b"main")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let selectedBody = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(&bodyAnswer, checkedBody)
  let mut writtenOrder = false
  if let Option<Shared<TypedBody>>.Some {value} = move selectedBody {
    writtenOrder = Shared.with<TypedBody, bool>(&value, recordOperandsKeepWrittenOrder)
  }
  let mirAnswer = run Semantic.demandMir(&mut store, &mut request, &id, b"main")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let selectedMir = Shared.with<Result<Answer, NoRejection>, Option<usize>>(&mirAnswer, selectedMirIndex)
  let mut aggregate = false
  let mut replacement = false
  if let Option<usize>.Some {value: index} = move selectedMir {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(&store, index) {
      let blocks = Vector.asSlice<MirBlock>(&function.blocks)
      let mut blockAt = usize.ZERO
      while blockAt < blocks.length {
        let statements = Vector.asSlice<MirStatement>(&blocks[blockAt].statements)
        let mut at = usize.ZERO
        while at < statements.length {
          if let MirStatement.Assign {destination, value, ..} = &statements[at] {
            if let MirRvalue.Aggregate {fields} = &value {
              let operands = Vector.asSlice<MirAggregateField>(&fields)
              if operands.length == 2 {
                aggregate = operands[usize.ZERO].index == usize.ONE && operands[usize.ONE].index == usize.ZERO
              }
            }
            let projections = Vector.asSlice<MirProjection>(&destination.projections)
            if projections.length == usize.ONE {
              if let MirProjection.Field {index: ordinal} = &projections[usize.ZERO] {
                replacement = ordinal == usize.ZERO
              }
            }
          }
          at = at + usize.ONE
        }
        blockAt = blockAt + usize.ONE
      }
    }
  }
  run Testing.expect(writtenOrder, "typed record operands retain written order and canonical fields")
  run Testing.expect(aggregate, "written record operand order survives canonical field selection into MIR")
  run Testing.expect(replacement, "assignment retains a canonical projected destination")
  let built = run buildApplication(&mut store, &mut request, staticClosureNodes)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut storage = false
  match move built {
    BackendBuild.Module {text, ..} => {
      let ir = Bytes.asSlice(&text)
      storage = containsIr(ir, b"(ptr %out") && containsIrLine(ir, b"call void @llvm.memmove.p0.p0.i64(", b" %l1, ptr %p0, i64 8, i1 false)")
        && containsIrLine(ir, b"getelementptr i8", b", i64 4")
    }
    _ => ()
  }
  run Testing.expect(storage, "record storage uses layout offsets and indirect parameter and result copies")
  return ()
}

fn anonymousShape(ty: &Shared<Type>, positional: bool, count: usize) -> bool {
  return Shared.with<Type, bool>(ty, fn(value: &Type) -> bool {
    if let Type.Anonymous {occurrence, members} = &value.* {
      return Vector.length<Shared<Type>>(&members) == count && AnonymousOccurrence.isPositional(&occurrence) == positional
    }
    return false
  })
}

fn nominalOfKind(ty: &Shared<Type>, kind: OwnerKind) -> bool {
  return Shared.with<Type, bool>(ty, fn(value: &Type) -> bool {
    if let Type.Nominal {declaration, ..} = &value.* { return DeclarationId.kind(&declaration) == kind }
    return false
  })
}

fn localIsAnonymous(answer: &Shared<Result<Answer, NoRejection>>, at: usize, positional: bool, count: usize) -> bool {
  if let Option<Shared<Type>>.Some {value} = move bodyLocalType(answer, at) { return anonymousShape(&value, positional, count) }
  return false
}

fn checkedNodeMatches(answer: &Shared<Result<Answer, NoRejection>>, index: usize, kind: OwnerKind) -> bool {
  let body = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(answer, checkedBody)
  if let Option<Shared<TypedBody>>.Some {value} = move body {
    return Shared.with<TypedBody, bool>(&value, fn(checked: &TypedBody) -> bool {
      let nodes = TypedBody.nodeSlice(checked)
      let mut at = usize.ZERO
      while at < nodes.length {
        if let BodyNodeKind.Expression {ty, form} = &nodes[at].kind {
          if let BodyExpression.Field {index: selected, ..} = &form { if selected == index { return true } }
          if let BodyExpression.Aggregate {..} = &form { if nominalOfKind(&ty, kind) { return true } }
        }
        at = at + usize.ONE
      }
      return false
    })
  }
  return false
}

// Whether a checked body projects member `index`.
fn bodyProjects(answer: &Shared<Result<Answer, NoRejection>>, index: usize) -> bool {
  return checkedNodeMatches(answer, index, OwnerKind.Damaged)
}

// Whether a checked body constructs an aggregate of a named declaration kind.
fn bodyConstructs(answer: &Shared<Result<Answer, NoRejection>>, kind: OwnerKind) -> bool {
  return checkedNodeMatches(answer, usize.MAX, kind)
}

fn writtenRecordOrder(answer: &Shared<Result<Answer, NoRejection>>) -> bool {
  let body = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(answer, checkedBody)
  if let Option<Shared<TypedBody>>.Some {value} = move body {
    return Shared.with<TypedBody, bool>(&value, recordOperandsKeepWrittenOrder)
  }
  return false
}

// Anonymous and contextual aggregate literals: TUPLE-002, RECORD-001 and RECORD-002.
test effect fn aggregateLiteralsConstructContextualOrAnonymousTypes() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run aggregateLiteralClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn aggregateLiteralClaims() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
? &mut Allocator {
  let id = run module("aggregate-literals.silk")
  let text = """
tuple Point(i32, i32)
struct Pair { left: i32 right: i32 }
enum Choice { First, Second }
fn identity<T>(value: T) -> T { return move value }
fn sumPair(value: Pair) -> i32 { return value.left + value.right }
fn tuples() -> i32 {
  let coordinates = (20, 22)
  let point: Point = (3, 4)
  return coordinates.1 + point.0
}
fn records() -> i32 {
  let record = .{ left: 20, right: 22 }
  let again = .{ left: 20, right: 22 }
  return record.right + sumPair(.{ left: 1, right: 2 })
}
fn select(choice: Choice) -> Pair {
  let selected: Pair = match choice {
    Choice.First => .{ right: 22, left: 20 }
    Choice.Second => .{ left: 21, right: 21 }
  }
  return move selected
}
fn generic() -> i32 {
  let record = identity(.{ left: 20, right: 22 })
  return record.left
}
fn unknownLabel() -> Pair { return .{ left: 1, wrong: 2 } }
fn repeatedLabel() -> i32 {
  let twice = .{ dup: 1, dup: 2 }
  return 0
}
fn separate() -> i32 {
  let mut first = .{ only: 1 }
  first = .{ only: 2 }
  return 0
}
fn tupleForRecord() -> Pair { return (5, 6) }
fn recordForTuple() -> Point { return .{ x: 1 } }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let tuples = run Semantic.demandBody(&mut store, &mut request, &id, b"tuples")
  let records = run Semantic.demandBody(&mut store, &mut request, &id, b"records")
  let select = run Semantic.demandBody(&mut store, &mut request, &id, b"select")
  let generic = run Semantic.demandBody(&mut store, &mut request, &id, b"generic")
  let namedPoint = match move bodyLocalType(&tuples, usize.ONE) {
    Option<Shared<Type>>.Some {value} => nominalOfKind(&value, OwnerKind.Tuple)
    Option<Shared<Type>>.None => false
  }
  run Testing.expect(localIsAnonymous(&tuples, usize.ZERO, true, 2) && namedPoint &&
    bodyProjects(&tuples, usize.ONE) && bodyConstructs(&tuples, OwnerKind.Tuple),
    "an uncontextualized tuple literal is anonymous and positional; a named tuple expectation constructs that tuple")
  let first = bodyLocalType(&records, usize.ZERO)
  let second = bodyLocalType(&records, usize.ONE)
  let mut distinct = false
  if let Option<Shared<Type>>.Some {value: left} = move first {
    if let Option<Shared<Type>>.Some {value: right} = move second { distinct = !run Type.equalsShared(&left, &right) }
  }
  run Testing.expect(localIsAnonymous(&records, usize.ZERO, false, 2) && distinct &&
    bodyProjects(&records, usize.ONE) && bodyConstructs(&records, OwnerKind.Struct),
    "each record literal occurrence is its own anonymous type, and a parameter expectation constructs the named struct")
  run Testing.expect(writtenRecordOrder(&select) && bodyConstructs(&select, OwnerKind.Struct),
    "match arms receive the named struct expectation and keep written operand order over canonical fields")
  run Testing.expect(localIsAnonymous(&generic, usize.ZERO, false, 2),
    "an open parameter expectation leaves the record anonymous, and inference binds the parameter to it")
  let unknownLabel = run Semantic.demandBody(&mut store, &mut request, &id, b"unknownLabel")
  let repeatedLabel = run Semantic.demandBody(&mut store, &mut request, &id, b"repeatedLabel")
  let separate = run Semantic.demandBody(&mut store, &mut request, &id, b"separate")
  let tupleForRecord = run Semantic.demandBody(&mut store, &mut request, &id, b"tupleForRecord")
  let recordForTuple = run Semantic.demandBody(&mut store, &mut request, &id, b"recordForTuple")
  run Testing.expect(rejectsSpan(&unknownLabel, RejectionCode.UnknownMember, text, "wrong", usize.ZERO) &&
    rejectsSpan(&repeatedLabel, RejectionCode.Collision, text, "dup", usize.ONE),
    "a contextual record keeps struct field authority and an anonymous record rejects a repeated label")
  run Testing.expect(rejectsSpan(&separate, RejectionCode.TypeMismatch, text, ".{ only: 2 }", usize.ZERO) &&
    rejectsSpan(&tupleForRecord, RejectionCode.TypeMismatch, text, "(5, 6)", usize.ZERO) &&
    rejectsSpan(&recordForTuple, RejectionCode.TypeMismatch, text, ".{ x: 1 }", usize.ZERO),
    "separate anonymous occurrences and a literal of the other aggregate kind never acquire the expected type")
  let coordinates = match move bodyLocalType(&tuples, usize.ZERO) {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => {
      run Testing.expect(false, "the anonymous tuple local retains its type")
      return ()
    }
  }
  let layout = run Semantic.demandLayout(&mut store, &mut request, &id, &coordinates)
  let mut laidOut = false
  let layoutIndex = Shared.with<Result<Answer, NoRejection>, Option<usize>>(&layout, selectedLayoutIndex)
  if let Option<usize>.Some {value: index} = move layoutIndex {
    if let Option<Shared<BackendLayout>>.Some {value: facts} = move Semantic.layoutAt(&store, index) {
      laidOut = Shared.with<BackendLayout, bool>(&facts, fn(computed: &BackendLayout) -> bool {
        if let LayoutStorage.Record {fields} = &computed.storage {
          let entries = Vector.asSlice<LayoutField>(&fields)
          return computed.size == 8 && entries.length == 2 && entries[usize.ONE].offset == 4
        }
        return false
      })
    }
  }
  let mir = run Semantic.demandMir(&mut store, &mut request, &id, b"tuples")
  let mut constructed = false
  let mirIndex = Shared.with<Result<Answer, NoRejection>, Option<usize>>(&mir, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move mirIndex {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(&store, index) {
      let blocks = Vector.asSlice<MirBlock>(&function.blocks)
      let mut blockAt = usize.ZERO
      while blockAt < blocks.length {
        let statements = Vector.asSlice<MirStatement>(&blocks[blockAt].statements)
        let mut at = usize.ZERO
        while at < statements.length {
          if let MirStatement.Assign {value: MirRvalue.Aggregate {fields}, ..} = &statements[at] {
            if Vector.length<MirAggregateField>(&fields) == 2 { constructed = true }
          }
          at = at + usize.ONE
        }
        blockAt = blockAt + usize.ONE
      }
    }
  }
  run Testing.expect(laidOut && constructed,
    "an anonymous tuple lays out as an ordinary record of its members and lowers to aggregate construction")
  return ()
}

// Runtime boolean typing uses the same concrete rule as compile-time boolean typing.
test effect fn runtimeBooleanOperatorsLowerShortCircuit() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("runtime-booleans.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
fn choose(value: bool) -> bool { return value && true || false }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let mir = run Semantic.demandMir(&mut store, &mut request, &id, b"choose")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let selected = Shared.with<Result<Answer, NoRejection>, Option<usize>>(&mir, selectedMirIndex)
  let mut branches = false
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(&store, index) {
      let blocks = Vector.asSlice<MirBlock>(&function.blocks)
      let mut at = usize.ZERO
      while at < blocks.length {
        if let MirTerminator.Branch {..} = &blocks[at].terminator { branches = true }
        at = at + usize.ONE
      }
    }
  }
  run Testing.expect(branches, "runtime boolean operators retain conditional evaluation in MIR")
  return ()
}

// Deferred representations keep unknown members and incompatible injection operands diagnostic.
test effect fn deferredRecordFormsRetainInvalidOperandDiagnostics() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("record-coverage.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
struct Left { value: i32 }
struct Right { value: i32 }
struct Holder { value: Left | Right }
union Choice { Value { value: i32 }, Empty }
struct Counter { value: i32 }
impl Counter { fn read(value: &Self) -> i32 { return value.value } }
enum Status { Ready }
fn consume(value: Left | Right) -> i32 { return 42 }
fn unionValue() -> i32 { return consume(Left { value: 42 }) }
fn invalidUnion() -> i32 { return consume(true) }
fn fieldUnion() -> i32 { let holder = Holder { value: Left { value: 42 } } return 42 }
fn invalidFieldUnion() -> i32 { let holder = Holder { value: true } return 42 }
fn invalidRecordUnion() -> i32 { let holder = Holder { value: Left { value: true } } return 42 }
fn produce(value: i32) -> Choice { return Choice.Value { value: value } }
fn unionResult() -> i32 { let selected = produce(42) return 42 }
fn invalidUnionResult() -> bool { return produce(42) }
fn invalidEnum() -> i32 { let status = Status.Absent return 42 }
fn bound(value: &Counter) -> i32 { let read = value.read return 42 }
fn invalidMember(value: &Counter) -> i32 { let read = value.absent return 42 }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let unionValue = run Semantic.demandBody(&mut store, &mut request, &id, b"unionValue")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let invalidUnion = run Semantic.demandBody(&mut store, &mut request, &id, b"invalidUnion")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let fieldUnion = run Semantic.demandBody(&mut store, &mut request, &id, b"fieldUnion")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let invalidFieldUnion = run Semantic.demandBody(&mut store, &mut request, &id, b"invalidFieldUnion")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let invalidRecordUnion = run Semantic.demandBody(&mut store, &mut request, &id, b"invalidRecordUnion")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let unionResult = run Semantic.demandBody(&mut store, &mut request, &id, b"unionResult")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let invalidUnionResult = run Semantic.demandBody(&mut store, &mut request, &id, b"invalidUnionResult")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let invalidEnum = run Semantic.demandBody(&mut store, &mut request, &id, b"invalidEnum")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let bound = run Semantic.demandBody(&mut store, &mut request, &id, b"bound")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let invalidMember = run Semantic.demandBody(&mut store, &mut request, &id, b"invalidMember")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let injectedArgument = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(&unionValue, checkedBody)
  let injectedField = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(&fieldUnion, checkedBody)
  let argumentChecked = match &injectedArgument {
    Option<Shared<TypedBody>>.Some {..} => true
    Option<Shared<TypedBody>>.None => false
  }
  let fieldChecked = match &injectedField {
    Option<Shared<TypedBody>>.Some {..} => true
    Option<Shared<TypedBody>>.None => false
  }
  run Testing.expect(
    argumentChecked && rejectsSpan(&invalidUnion, RejectionCode.TypeMismatch, text, "true", 0),
    "a closed record injects into its structural union and a non-member is a mismatch",
  )
  run Testing.expect(
    fieldChecked &&
    rejectsSpan(&invalidFieldUnion, RejectionCode.TypeMismatch, text, "true", 1) &&
    rejectsSpan(&invalidRecordUnion, RejectionCode.TypeMismatch, text, "true", 2),
    "a record field injects its union member only after checking the nested initializer",
  )
  let nominalResult = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(&unionResult, checkedBody)
  let resultChecked = match &nominalResult {
    Option<Shared<TypedBody>>.Some {..} => true
    Option<Shared<TypedBody>>.None => false
  }
  run Testing.expect(
    resultChecked && rejectsSpan(&invalidUnionResult, RejectionCode.TypeMismatch, text, "produce(42)", 1),
    "a non-generic nominal union result is a runtime value and a mismatched use is rejected",
  )
  run Testing.expect(
    rejectsSpan(&invalidEnum, RejectionCode.UnknownMember, text, "Status.Absent", 0),
    "an absent enum member remains an unknown member",
  )
  run Testing.expect(
    rejectsSpan(&bound, RejectionCode.BoundMethodUnavailable, text, "value.read", 0) &&
    rejectsSpan(&invalidMember, RejectionCode.UnknownMember, text, "absent", 0),
    "published bound methods and invalid members keep specific diagnostics",
  )
  return ()
}

fn enumMatchArmsKeepPatternsAndGuards(body: &TypedBody) -> bool {
  let nodes = TypedBody.nodeSlice(body)
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {form: BodyExpression.Match {arms, ..}, ..} = &nodes[at].kind {
      let written = Vector.asSlice<BodyMatchArm>(&arms)
      if written.length != 3 { return false }
      let mut guarded = false
      if let Option<BodyNodeId>.Some {..} = &written[usize.ZERO].guard { guarded = true }
      let mut ready = false
      if let BodyPattern.EnumMember {member} = &written[usize.ZERO].pattern {
        ready = member.ordinal == usize.ONE && !member.negative && member.magnitude == 7
      }
      let mut unknown = false
      if let BodyPattern.EnumMember {member} = &written[usize.ONE].pattern {
        unknown = member.ordinal == usize.ZERO && member.negative && member.magnitude == 1
      }
      let mut fallback = true
      if let BodyPattern.EnumMember {..} = &written[2].pattern { fallback = false }
      return guarded && ready && unknown && fallback
    }
    at = at + usize.ONE
  }
  return false
}

fn enumMatchCopiesSubject(body: &TypedBody) -> bool {
  let nodes = TypedBody.nodeSlice(body)
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {form: BodyExpression.Match {access, ..}, ..} = &nodes[at].kind {
      return match &access { BodySubjectAccess.Copy => true _ => false }
    }
    at = at + usize.ONE
  }
  return false
}

// Scalar enums keep nominal identity, take their representation's layout, and lower matches to switches.
test effect fn scalarEnumsLowerMembersValuesAndSwitches() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("scalar-enums.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
enum(i8) Status {
  Unknown = -1,
  Ready = 7,
}
enum Other { First, Second }
struct Flags { status: Status }
fn raw(status: Status) -> i8 { return Status.value(status) }
fn stored(flags: &Flags) -> bool { return flags.status != Status.Ready }
fn classify(status: Status, open: bool) -> i32 {
  return match move status {
    Status.Ready if open => 1
    Status.Unknown => 2
    _ => 3
  }
}
pub fn main() -> i32 {
  let flags = Flags { status: Status.Unknown }
  if stored(&flags) && raw(flags.status) == -1 { return classify(flags.status, true) }
  return 0
}
fn missing(status: Status) -> i32 { return match status { Status.Ready => 1 } }
fn duplicate(status: Status) -> i32 { return match status { Status.Unknown => 1 Status.Unknown => 2 _ => 3 } }
fn afterUniversal(status: Status) -> i32 { return match status { _ => 1 Status.Ready => 4 } }
fn covered(status: Status) -> i32 { return match status { Status.Ready => 1 Status.Unknown => 5 _ => 6 } }
fn foreign(status: Status) -> i32 { return match status { Other.First => 1 _ => 2 } }
fn guardType(status: Status, count: i32) -> i32 { return match status { Status.Ready if count => 1 _ => 2 } }
fn copied(status: Status) -> i32 { return match status { _ => 0 } }
fn movedField(flags: Flags) -> i32 { return match move flags.status { _ => 0 } }
fn movedFresh() -> i32 { return match move Status.Ready { _ => 0 } }
struct Guarded { status: Status }
impl Drop for Guarded { fn drop(self: &mut Guarded) -> () { return () } }
fn guardedField(value: Guarded) -> i32 { return match move value.status { _ => 0 } }
fn borrowed(status: &Status) -> i32 { return match & status.* { Status.Ready => 1 _ => 0 } }
fn borrowedMutable(status: Status) -> i32 {
  let mut held = status
  return match &mut held { _ => 0 }
}
impl Status { fn code(self: &Self) -> i32 { return 7 } }
fn inherent(status: Status) -> i32 { return Status.code(&status) }
fn invokedMember(status: Status) -> i32 { return Status.Ready(status) }
"""
  let mut store = run applicationSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.forApplication(run ModuleId.copy(&id) |> Effect.provideMut<Allocator>(&mut allocator))
  let classifyAnswer = run Semantic.demandBody(&mut store, &mut request, &id, b"classify")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let classifyBody = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(&classifyAnswer, checkedBody)
  let mut arms = false
  let mut enumType = Option.none<Shared<Type>>()
  if let Option<Shared<TypedBody>>.Some {value} = move classifyBody {
    arms = Shared.with<TypedBody, bool>(&value, enumMatchArmsKeepPatternsAndGuards)
    enumType = Shared.with<TypedBody, Option<Shared<Type>>>(&value, enumParameterType)
  }
  run Testing.expect(arms, "match arms keep member values, guard and universal fallback in written order")
  run Testing.expect(consumesAt(&classifyAnswer, 2, usize.ZERO, usize.MAX, usize.MAX),
    "an explicit scalar enum move match records the consumed parameter despite its Copy classification")
  let copied = run Semantic.demandBody(&mut store, &mut request, &id, b"copied")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let copiedAccess = Shared.with<Result<Answer, NoRejection>, bool>(&copied,
    fn(answer: &Result<Answer, NoRejection>) -> bool {
      if let Option<Shared<TypedBody>>.Some {value} = move checkedBody(answer) {
        return Shared.with<TypedBody, bool>(&value, enumMatchCopiesSubject)
      }
      return false
    })
  run Testing.expect(copiedAccess, "a bare enum match keeps Copy access")
  let field = run Semantic.demandBody(&mut store, &mut request, &id, b"movedField")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let fresh = run Semantic.demandBody(&mut store, &mut request, &id, b"movedFresh")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(consumesAt(&field, 2, usize.ZERO, usize.ZERO, usize.MAX)
    && consumesAt(&fresh, 2, usize.MAX, usize.MAX, usize.MAX),
    "a consuming enum field records its owner projection while a fresh member value records no place")
  let guarded = run Semantic.demandBody(&mut store, &mut request, &id, b"guardedField")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsSpan(&guarded, RejectionCode.ExtractionBoundary, text,
    "match move value.status { _ => 0 }", usize.ZERO),
    "a Copy enum field cannot be extracted through a Drop-hooked ancestor, diagnosed at the whole match")
  let borrowed = run Semantic.demandBody(&mut store, &mut request, &id, b"borrowed")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let borrowedAccess = Shared.with<Result<Answer, NoRejection>, bool>(&borrowed,
    fn(answer: &Result<Answer, NoRejection>) -> bool {
      if let Option<Shared<TypedBody>>.Some {value} = move checkedBody(answer) {
        return Shared.with<TypedBody, bool>(&value, enumMatchCopiesSubject)
      }
      return false
    })
  let borrowedMir = run Semantic.demandMir(&mut store, &mut request, &id, b"borrowed")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(borrowedAccess && succeeded(&borrowedMir),
    "a shared scalar enum match binds nothing, so it reads the Copy tag and lowers like a plain match")
  let borrowedMutable = run Semantic.demandBody(&mut store, &mut request, &id, b"borrowedMutable")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsSpan(&borrowedMutable, RejectionCode.Unsupported, text, "match &mut held { _ => 0 }", usize.ZERO),
    "a mutable scalar enum match retains its separate unsupported boundary")
  let inherent = run Semantic.demandMir(&mut store, &mut request, &id, b"inherent")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let invokedMember = run Semantic.demandBody(&mut store, &mut request, &id, b"invokedMember")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(Shared.with<Result<Answer, NoRejection>, bool>(&inherent, pipelineHasMir),
    "a qualified call of an inherent enum member resolves as in every other nominal namespace")
  run Testing.expect(rejectsSpan(&invokedMember, RejectionCode.NotCallable, text, "Status.Ready(status)", usize.ZERO),
    "invoking an enum member value remains not callable")
  let mut scalarLayout = false
  if let Option<Shared<Type>>.Some {value: ty} = move enumType {
    let layoutAnswer = run Semantic.demandLayout(&mut store, &mut request, &id, &ty)
      |> Effect.provideMut<Allocator>(&mut allocator)
    let layoutIndex = Shared.with<Result<Answer, NoRejection>, Option<usize>>(&layoutAnswer, selectedLayoutIndex)
    if let Option<usize>.Some {value: index} = move layoutIndex {
      if let Option<Shared<BackendLayout>>.Some {value: facts} = move Semantic.layoutAt(&store, index) {
        scalarLayout = Shared.with<BackendLayout, bool>(&facts, fn(layout: &BackendLayout) -> bool {
          let scalarStorage = match &layout.storage {
            LayoutStorage.Scalar => true
            _ => false
          }
          return scalarStorage && layout.size == usize.ONE && layout.alignment == usize.ONE && layout.abi == LayoutAbi.Integer
        })
      }
    }
  }
  run Testing.expect(scalarLayout, "a scalar enum takes its representation's neutral layout")
  let mirAnswer = run Semantic.demandMir(&mut store, &mut request, &id, b"classify")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut switches = usize.ZERO
  let mut cases = usize.ZERO
  let mut noDropFlags = false
  let mirIndex = Shared.with<Result<Answer, NoRejection>, Option<usize>>(&mirAnswer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move mirIndex {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(&store, index) {
      noDropFlags = true
      let locals = Vector.asSlice<MirLocal>(&function.locals)
      let mut localAt = usize.ZERO
      while localAt < locals.length {
        if let MirLocalKind.DropFlag {..} = &locals[localAt].kind { noDropFlags = false }
        localAt = localAt + usize.ONE
      }
      let blocks = Vector.asSlice<MirBlock>(&function.blocks)
      let mut at = usize.ZERO
      while at < blocks.length {
        if let MirTerminator.Switch {cases: selected, ..} = &blocks[at].terminator {
          switches = switches + usize.ONE
          cases = cases + Vector.length<MirSwitchCase>(&selected)
        }
        at = at + usize.ONE
      }
    }
  }
  run Testing.expect(switches == 2 && cases == 3, "a false guard resumes dispatch at the next arm with a second switch")
  run Testing.expect(succeeded(&mirAnswer) && noDropFlags && glueFact(&store, &mirAnswer, usize.ZERO) == usize.ZERO
    && glueFact(&store, &mirAnswer, 6) == usize.ZERO,
    "a consuming Copy enum switch has no drop statements, glue references or ownership flags")
  let built = run buildApplication(&mut store, &mut request, staticClosureNodes)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut emitted = false
  match move built {
    BackendBuild.Module {text: ir, ..} => {
      let bytes = Bytes.asSlice(&ir)
      emitted = containsIr(bytes, b"switch i8") && containsIr(bytes, b"i8 7, label %b") && containsIr(bytes, b"i8 -1, label %b")
    }
    _ => ()
  }
  run Testing.expect(emitted, "enum switches and values are spelled from the representation layout")
  let missing = run Semantic.demandBody(&mut store, &mut request, &id, b"missing")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let duplicate = run Semantic.demandBody(&mut store, &mut request, &id, b"duplicate")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let afterUniversal = run Semantic.demandBody(&mut store, &mut request, &id, b"afterUniversal")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let covered = run Semantic.demandBody(&mut store, &mut request, &id, b"covered")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let foreign = run Semantic.demandBody(&mut store, &mut request, &id, b"foreign")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let guardType = run Semantic.demandBody(&mut store, &mut request, &id, b"guardType")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    rejectsSpan(&missing, RejectionCode.MissingEnumMember, text, "match status { Status.Ready => 1 }", 0) &&
    rejectsSpan(&duplicate, RejectionCode.DuplicateMatchPattern, text, "Status.Unknown", 3) &&
    rejectsSpan(&afterUniversal, RejectionCode.MatchArmAfterUniversal, text, "Status.Ready", 3) &&
    rejectsSpan(&covered, RejectionCode.UnreachableMatchArm, text, "_", 3) &&
    rejectsSpan(&foreign, RejectionCode.TypeMismatch, text, "Other.First", 0) &&
    rejectsSpan(&guardType, RejectionCode.ConditionNotBool, text, "count", 1),
    "enum coverage, foreign members and non-Boolean guards report precise spans",
  )
  return ()
}

fn recordArmTag(body: &TypedBody, arm: usize) -> usize {
  let nodes = TypedBody.nodeSlice(body)
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {form: BodyExpression.Match {arms, ..}, ..} = &nodes[at].kind {
      let written = Vector.asSlice<BodyMatchArm>(&arms)
      if arm < written.length {
        if let BodyPattern.Record {member} = &written[arm].pattern {
          if let Option<BodyUnionMember>.Some {value} = &member { return value.tag }
        }
      }
      return usize.MAX
    }
    at = at + usize.ONE
  }
  return usize.MAX
}

// Counts binding places reaching field `first` (then `second`, unless MAX) after an optional
// structural member step `tag` (MAX = none).
fn bindingPlaces(body: &TypedBody, tag: usize, first: usize, second: usize) -> usize {
  let nodes = TypedBody.nodeSlice(body)
  let mut found = usize.ZERO
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {form: BodyExpression.PatternBinding {path, ..}, ..} = &nodes[at].kind {
      let steps = Vector.asSlice<BodyPlaceStep>(&path)
      let mut cursor = usize.ZERO
      let mut matched = true
      if tag != usize.MAX {
        matched = false
        if steps.length > usize.ZERO {
          if let BodyPlaceStep.Member {tag: selected, ..} = &steps[usize.ZERO] { matched = selected == tag }
        }
        cursor = usize.ONE
      }
      let mut expected = usize.ONE + usize.ONE
      if second == usize.MAX { expected = usize.ONE }
      if matched && steps.length == cursor + expected {
        let mut fieldsMatch = false
        if let BodyPlaceStep.Field {index} = &steps[cursor] { fieldsMatch = index == first }
        if second != usize.MAX {
          let mut secondMatch = false
          if let BodyPlaceStep.Field {index} = &steps[cursor + usize.ONE] { secondMatch = index == second }
          fieldsMatch = fieldsMatch && secondMatch
        }
        if fieldsMatch { found = found + usize.ONE }
      }
    }
    at = at + usize.ONE
  }
  return found
}

effect fn injectionCount(answer: &Shared<Result<Answer, NoRejection>>) -> usize ! OutOfMemoryError ? &mut Allocator {
  let selected = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(answer, checkedBody)
  return match move selected {
    Option<Shared<TypedBody>>.Some {value} => Shared.with<TypedBody, usize>(&value, unionInjections)
    Option<Shared<TypedBody>>.None => usize.MAX
  }
}

fn unionInjections(body: &TypedBody) -> usize {
  let nodes = TypedBody.nodeSlice(body)
  let mut found = usize.ZERO
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {form: BodyExpression.UnionInject {..}, ..} = &nodes[at].kind { found = found + usize.ONE }
    at = at + usize.ONE
  }
  return found
}

fn firstArmMember(body: &TypedBody) -> Option<Shared<Type>> {
  let nodes = TypedBody.nodeSlice(body)
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {form: BodyExpression.Match {arms, ..}, ..} = &nodes[at].kind {
      let written = Vector.asSlice<BodyMatchArm>(&arms)
      if written.length > usize.ZERO {
        if let BodyPattern.Record {member} = &written[usize.ZERO].pattern {
          if let Option<BodyUnionMember>.Some {value} = &member { return Option.some<Shared<Type>>(Shared.clone<Type>(&value.ty)) }
        }
      }
      return Option.none<Shared<Type>>()
    }
    at = at + usize.ONE
  }
  return Option.none<Shared<Type>>()
}

fn taggedMemberAt(layout: &BackendLayout, tag: usize) -> Option<Shared<Type>> {
  if let LayoutStorage.Tagged {members, ..} = &layout.storage {
    let listed = Vector.asSlice<Shared<Type>>(&members)
    if tag < listed.length { return Option.some<Shared<Type>>(Shared.clone<Type>(&listed[tag])) }
  }
  return Option.none<Shared<Type>>()
}

fn taggedLayout(layout: &BackendLayout) -> usize {
  if let LayoutStorage.Tagged {tagSize, payloadOffset, ..} = &layout.storage {
    if tagSize == usize.ONE && layout.abi == LayoutAbi.Indirect { return payloadOffset * 100 + layout.size }
  }
  return usize.MAX
}

// Closed-record unions share canonical tags across functions, keep field places for bindings, and
// lower matches to tag switches over a Tagged layout.
test effect fn structuralUnionsInjectBindAndSwitchOnTags() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("structural-unions.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
struct Left { value: i32 }
struct Right { marker: u8 value: i32 }
struct Empty {}
struct Token { value: i32 }
struct Pair { token: Token discarded: Token }
fn inspect(input: Left | Right | Empty, open: bool) -> i32 {
  return match &input {
    Left { value } if open => value
    Right { value, .. } => value
    _ => 7
  }
}
fn total(pair: Pair) -> i32 { return match move pair { Pair { token: Token { value }, .. } => value } }
fn exclusive(token: Token) -> i32 { let mut held = token return match &mut held { Token { value } => value } }
fn same(input: Left | Token) -> i32 { return 0 }
pub fn main() -> i32 { return inspect(Left { value: 42 }, true) }
fn spelled(input: Empty | Right | Left) -> i32 { return 0 }
"""
  let mut store = run applicationSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.forApplication(run ModuleId.copy(&id) |> Effect.provideMut<Allocator>(&mut allocator))
  let spelledAnswer = run Semantic.demandBody(&mut store, &mut request, &id, b"spelled")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut spelledType = Option.none<Shared<Type>>()
  let spelledBody = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(&spelledAnswer, checkedBody)
  if let Option<Shared<TypedBody>>.Some {value} = move spelledBody {
    spelledType = Shared.with<TypedBody, Option<Shared<Type>>>(&value, enumParameterType)
  }
  let mut spelledLayout = Option.none<Shared<BackendLayout>>()
  if let Option<Shared<Type>>.Some {value: ty} = move spelledType {
    let layoutAnswer = run Semantic.demandLayout(&mut store, &mut request, &id, &ty)
      |> Effect.provideMut<Allocator>(&mut allocator)
    let layoutIndex = Shared.with<Result<Answer, NoRejection>, Option<usize>>(&layoutAnswer, selectedLayoutIndex)
    if let Option<usize>.Some {value: index} = move layoutIndex { spelledLayout = Semantic.layoutAt(&store, index) }
  }
  let inspectAnswer = run Semantic.demandBody(&mut store, &mut request, &id, b"inspect")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mainAnswer = run Semantic.demandBody(&mut store, &mut request, &id, b"main")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let totalAnswer = run Semantic.demandBody(&mut store, &mut request, &id, b"total")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let exclusiveAnswer = run Semantic.demandBody(&mut store, &mut request, &id, b"exclusive")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let sameAnswer = run Semantic.demandBody(&mut store, &mut request, &id, b"same")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut leftArm = usize.MAX
  let mut rightArm = usize.MAX
  let mut leftValues = usize.ZERO
  let mut rightValues = usize.ZERO
  let mut unionType = Option.none<Shared<Type>>()
  let mut leftType = Option.none<Shared<Type>>()
  let checked1 = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(&inspectAnswer, checkedBody)
  if let Option<Shared<TypedBody>>.Some {value} = move checked1 {
    leftArm = Shared.with<TypedBody, usize>(&value, fn(body: &TypedBody) -> usize { return recordArmTag(body, usize.ZERO) })
    rightArm = Shared.with<TypedBody, usize>(&value, fn(body: &TypedBody) -> usize { return recordArmTag(body, usize.ONE) })
    leftValues = Shared.with<TypedBody, usize>(&value, fn(body: &TypedBody) -> usize { return bindingPlaces(body, leftArm, usize.ZERO, usize.MAX) })
    rightValues = Shared.with<TypedBody, usize>(&value, fn(body: &TypedBody) -> usize { return bindingPlaces(body, rightArm, usize.ONE, usize.MAX) })
    unionType = Shared.with<TypedBody, Option<Shared<Type>>>(&value, enumParameterType)
    leftType = Shared.with<TypedBody, Option<Shared<Type>>>(&value, firstArmMember)
  }
  let mut injected = usize.MAX
  let checked2 = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(&mainAnswer, checkedBody)
  if let Option<Shared<TypedBody>>.Some {value} = move checked2 {
    injected = Shared.with<TypedBody, usize>(&value, firstUnionInjectTag)
  }
  run Testing.expect(leftArm < 3 && rightArm < 3 && leftArm != rightArm && injected == leftArm,
    "an injected member and its pattern in another function share one canonical tag")
  run Testing.expect(leftValues >= usize.ONE && rightValues >= usize.ONE, "member field bindings are places under their member tag")
  let mut nested = usize.ZERO
  let mut consumed = true
  let checked3 = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(&totalAnswer, checkedBody)
  if let Option<Shared<TypedBody>>.Some {value} = move checked3 {
    nested = Shared.with<TypedBody, usize>(&value, fn(body: &TypedBody) -> usize { return bindingPlaces(body, usize.MAX, usize.ZERO, usize.ZERO) })
    consumed = Shared.with<TypedBody, bool>(&value, matchAddressesPlace)
  }
  let mut addressed = false
  let checked4 = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(&exclusiveAnswer, checkedBody)
  if let Option<Shared<TypedBody>>.Some {value} = move checked4 {
    addressed = Shared.with<TypedBody, bool>(&value, matchAddressesPlace)
  }
  run Testing.expect(nested >= usize.ONE && !consumed && addressed,
    "nested record bindings follow field paths; moves read a copy and exclusive matches address the place")
  let mut asymmetric = usize.MAX
  if let Option<Shared<Type>>.Some {value: ty} = move unionType {
    let layoutAnswer = run Semantic.demandLayout(&mut store, &mut request, &id, &ty)
      |> Effect.provideMut<Allocator>(&mut allocator)
    let layoutIndex = Shared.with<Result<Answer, NoRejection>, Option<usize>>(&layoutAnswer, selectedLayoutIndex)
    if let Option<usize>.Some {value: index} = move layoutIndex {
      if let Option<Shared<BackendLayout>>.Some {value: facts} = move Semantic.layoutAt(&store, index) {
        asymmetric = Shared.with<BackendLayout, usize>(&facts, taggedLayout)
      }
    }
  }
  let mut equal = usize.MAX
  let mut sameType = Option.none<Shared<Type>>()
  let checked5 = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(&sameAnswer, checkedBody)
  if let Option<Shared<TypedBody>>.Some {value} = move checked5 {
    sameType = Shared.with<TypedBody, Option<Shared<Type>>>(&value, enumParameterType)
  }
  if let Option<Shared<Type>>.Some {value: ty} = move sameType {
    let layoutAnswer = run Semantic.demandLayout(&mut store, &mut request, &id, &ty)
      |> Effect.provideMut<Allocator>(&mut allocator)
    let layoutIndex = Shared.with<Result<Answer, NoRejection>, Option<usize>>(&layoutAnswer, selectedLayoutIndex)
    if let Option<usize>.Some {value: index} = move layoutIndex {
      if let Option<Shared<BackendLayout>>.Some {value: facts} = move Semantic.layoutAt(&store, index) {
        equal = Shared.with<BackendLayout, usize>(&facts, taggedLayout)
      }
    }
  }
  run Testing.expect(asymmetric == 412 && equal == 408,
    "a one-byte tag precedes the largest member at the strictest member alignment")
  let mut canonicalMember = false
  if let Option<Shared<BackendLayout>>.Some {value: facts} = move spelledLayout {
    let selected = Shared.with<BackendLayout, Option<Shared<Type>>>(&facts, fn(layout: &BackendLayout) -> Option<Shared<Type>> {
      return taggedMemberAt(layout, leftArm)
    })
    if let Option<Shared<Type>>.Some {value: member} = move selected {
      if let Option<Shared<Type>>.Some {value: left} = move leftType { canonicalMember = run Type.equalsShared(&member, &left)
        |> Effect.provideMut<Allocator>(&mut allocator) }
    }
  }
  run Testing.expect(canonicalMember, "a differently spelled union demanded first still stores members in canonical tag order")
  let mirAnswer = run Semantic.demandMir(&mut store, &mut request, &id, b"inspect")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut switches = usize.ZERO
  let mut cases = usize.ZERO
  let mut discriminant = false
  let mut payload = false
  let mirIndex = Shared.with<Result<Answer, NoRejection>, Option<usize>>(&mirAnswer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move mirIndex {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(&store, index) {
      let blocks = Vector.asSlice<MirBlock>(&function.blocks)
      let mut at = usize.ZERO
      while at < blocks.length {
        if let MirTerminator.Switch {cases: selected, ..} = &blocks[at].terminator {
          switches = switches + usize.ONE
          cases = cases + Vector.length<MirSwitchCase>(&selected)
        }
        let statements = Vector.asSlice<MirStatement>(&blocks[at].statements)
        let mut statementAt = usize.ZERO
        while statementAt < statements.length {
          if let MirStatement.Assign {value, ..} = &statements[statementAt] {
            if let MirRvalue.Discriminant {..} = &value { discriminant = true }
            if let MirRvalue.Use {value: MirOperand.Copy {place}} = &value {
              let projections = Vector.asSlice<MirProjection>(&place.projections)
              let mut step = usize.ZERO
              while step < projections.length {
                if let MirProjection.Payload {..} = &projections[step] { payload = true }
                step = step + usize.ONE
              }
            }
          }
          statementAt = statementAt + usize.ONE
        }
        at = at + usize.ONE
      }
    }
  }
  run Testing.expect(discriminant && payload && switches == 2 && cases == 3,
    "the tag is read once and a false guard resumes the switch at the next arm")
  let built = run buildApplication(&mut store, &mut request, staticClosureNodes)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut emitted = false
  match move built {
    BackendBuild.Module {text: ir, ..} => {
      let bytes = Bytes.asSlice(&ir)
      emitted = containsIr(bytes, b"switch i8") && containsIrLine(bytes, b"getelementptr i8", b", i64 4")
    }
    _ => ()
  }
  run Testing.expect(emitted, "tags and payload offsets are spelled from the Tagged layout")
  return ()
}

// Scalar members join closed structural unions: canonical tags, a Tagged layout, injection at every
// boundary, and exact `T name` / `T _` arms that are never catch-alls.
test effect fn scalarMemberUnionsInjectBindAndSwitch() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run scalarMemberUnionClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn scalarMemberUnionClaims() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
? &mut Allocator {
  let id = run module("scalar-member-unions.silk")
  let text = """
struct Token { kind: i32 }
fn spelled(value: bool | i64) -> i32 { return 0 }
fn wide(value: i64 | bool) -> i32 { return 0 }
fn small(value: u8 | bool) -> i32 { return 0 }
fn pick(k: i32) -> i64 | bool | Token {
  if k == 0 {
    let n: i64 = 7
    return n
  }
  if k == 1 {
    let flag: bool = true
    return flag
  }
  return Token { kind: k }
}
fn classify(k: i32) -> i64 {
  return match move pick(k) {
    i64 n => n
    bool _ => 1
    Token { kind } => 2
  }
}
fn shared(v: i64 | bool) -> i32 { return match &v { i64 _ => 1 bool _ => 2 } }
fn copied(v: i64 | bool) -> i32 { return match v { i64 _ => 1 bool _ => 2 } }
fn affine(v: i64 | bool | Token) -> i32 { return match v { i64 _ => 1 bool _ => 2 Token { kind } => 3 } }
fn partial(v: i64 | bool | Token) -> i32 { return match move v { i64 _ => 1 } }
fn literal() -> i64 | bool { return 5 }
fn absent(v: i64 | bool) -> i32 { return match move v { u8 x => 1 bool _ => 2 } }
fn twice(v: i64 | bool) -> i32 { return match move v { i64 a => 1 i64 b => 2 bool _ => 3 } }
fn braced(v: i64 | bool) -> i32 { return match move v { i64 {} => 1 bool _ => 2 } }
fn floatUnion(value: f64 | bool) -> i32 { return 0 }
fn floaty() -> i32 {
  let truth: bool = true
  return floatUnion(truth)
}
fn stringUnion(value: i32 | string<'static>) -> i32 { return 0 }
fn stringy() -> i32 {
  let count: i32 = 1
  return stringUnion(count)
}
fn stringMatch(value: i32 | string<'static>) -> i32 { return match move value { i32 n => n string text => 1 } }
fn truthy(v: i64 | bool) -> bool {
  return match move v {
    bool b => b
    i64 _ => false
  }
}
pub fn main() -> i32 {
  let picked = classify(0)
  let flag: bool = true
  let held: i64 | bool = flag
  let truth = truthy(held)
  return 0
}
"""
  let mut store = run applicationSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.forApplication(run ModuleId.copy(&id))
  let spelled = run parameterLayout(&mut store, &mut request, &id, b"spelled")
  let wide = run parameterLayout(&mut store, &mut request, &id, b"wide")
  let small = run parameterLayout(&mut store, &mut request, &id, b"small")
  run Testing.expect(spelled != usize.MAX && spelled == wide,
    "bool | i64 and i64 | bool are one canonical union with one layout")
  run Testing.expect(wide % 1000000 == 108168, "i64 | bool: a one-byte tag, the payload at 8, size 16, alignment 8")
  run Testing.expect(small % 1000000 == 101021, "u8 | bool: a one-byte tag, the payload at 1, size 2, alignment 1")
  let pickAnswer = run Semantic.demandBody(&mut store, &mut request, &id, b"pick")
  let pickInjections = run injectionCount(&pickAnswer)
  run Testing.expect(pickInjections == 3, "each returned member, scalar or record, injects once")
  let classifyAnswer = run Semantic.demandBody(&mut store, &mut request, &id, b"classify")
  let mut tags = usize.MAX
  let classifyBody = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(&classifyAnswer, checkedBody)
  if let Option<Shared<TypedBody>>.Some {value} = move classifyBody {
    tags = Shared.with<TypedBody, usize>(&value, matchTagCount)
  }
  run Testing.expect(tags == 3, "a type-binding match over three members switches on three tags")
  let mirAnswer = run Semantic.demandMir(&mut store, &mut request, &id, b"classify")
  let mut cases = usize.ZERO
  let mut discriminant = false
  let mut payload = false
  let mirIndex = Shared.with<Result<Answer, NoRejection>, Option<usize>>(&mirAnswer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move mirIndex {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(&store, index) {
      let blocks = Vector.asSlice<MirBlock>(&function.blocks)
      let mut at = usize.ZERO
      while at < blocks.length {
        if let MirTerminator.Switch {cases: selected, ..} = &blocks[at].terminator {
          cases = cases + Vector.length<MirSwitchCase>(&selected)
        }
        let statements = Vector.asSlice<MirStatement>(&blocks[at].statements)
        let mut statementAt = usize.ZERO
        while statementAt < statements.length {
          if let MirStatement.Assign {value, ..} = &statements[statementAt] {
            if let MirRvalue.Discriminant {..} = &value { discriminant = true }
            if let MirRvalue.Use {value: MirOperand.Copy {place}} = &value {
              let projections = Vector.asSlice<MirProjection>(&place.projections)
              let mut step = usize.ZERO
              while step < projections.length {
                if let MirProjection.Payload {..} = &projections[step] { payload = true }
                step = step + usize.ONE
              }
            }
          }
          statementAt = statementAt + usize.ONE
        }
        at = at + usize.ONE
      }
    }
  }
  run Testing.expect(discriminant && payload && cases == 3, "the scalar binding copies its payload after one tag switch")
  let built = run buildApplication(&mut store, &mut request, staticClosureNodes)
  let mut emitted = false
  match move built {
    BackendBuild.Module {text: ir, ..} => {
      let bytes = Bytes.asSlice(&ir)
      emitted = containsIr(bytes, b"switch i8") && containsIr(bytes, b"store i64 7")
        && containsIr(bytes, b"store i1 true") && containsIr(bytes, b"load i1")
        && containsIrLine(bytes, b"getelementptr i8", b", i64 8")
    }
    _ => ()
  }
  run Testing.expect(emitted,
    "scalar payloads are stored and loaded at the Tagged payload offset in the representation bool record fields use")
  let sharedAnswer = run Semantic.demandBody(&mut store, &mut request, &id, b"shared")
  let copiedAnswer = run Semantic.demandBody(&mut store, &mut request, &id, b"copied")
  run Testing.expect(succeeded(&sharedAnswer) && succeeded(&copiedAnswer),
    "`T _` arms over every member are exhaustive, and an all-Copy union matches by value")
  let affineAnswer = run Semantic.demandBody(&mut store, &mut request, &id, b"affine")
  run Testing.expect(rejectsSpan(&affineAnswer, RejectionCode.ExplicitMoveRequired, text,
      "match v { i64 _ => 1 bool _ => 2 Token { kind } => 3 }", 0),
    "a union with an affine member needs an explicit move to match by value")
  let partialAnswer = run Semantic.demandBody(&mut store, &mut request, &id, b"partial")
  run Testing.expect(rejectsSpan(&partialAnswer, RejectionCode.MissingUnionMember, text, "match move v { i64 _ => 1 }", 0),
    "`T _` covers only T: a match missing members is not exhaustive")
  let literalAnswer = run Semantic.demandBody(&mut store, &mut request, &id, b"literal")
  run Testing.expect(rejectsSpan(&literalAnswer, RejectionCode.TypeMismatch, text, "5", 0),
    "a bare literal is not typed into a union member")
  let absentAnswer = run Semantic.demandBody(&mut store, &mut request, &id, b"absent")
  let twiceAnswer = run Semantic.demandBody(&mut store, &mut request, &id, b"twice")
  let bracedAnswer = run Semantic.demandBody(&mut store, &mut request, &id, b"braced")
  run Testing.expect(
    rejectsSpan(&absentAnswer, RejectionCode.TypeMismatch, text, "u8 x", 0) &&
    rejectsSpan(&twiceAnswer, RejectionCode.DuplicateMatchPattern, text, "i64 b", 0) &&
    rejectsSpan(&bracedAnswer, RejectionCode.InvalidRecordPattern, text, "i64 {}", 0),
    "a non-member type arm, a repeated type arm and a field list on a scalar member report precise spans",
  )
  let floatyAnswer = run Semantic.demandBody(&mut store, &mut request, &id, b"floaty")
  run Testing.expect(rejectsSpan(&floatyAnswer, RejectionCode.UnionFormUnavailable, text, "floatUnion(truth)", 0),
    "a float member stays the named union-form gap")
  let stringyAnswer = run Semantic.demandMir(&mut store, &mut request, &id, b"stringy")
  let stringMatch = run Semantic.demandMir(&mut store, &mut request, &id, b"stringMatch")
  let stringLayout = run parameterLayout(&mut store, &mut request, &id, b"stringMatch")
  run Testing.expect(succeeded(&stringyAnswer) && succeeded(&stringMatch) && stringLayout % 1000000 == 108248,
    "a text view is a descriptor member: i32 | string injects, binds and switches with its payload at 8, size 24, alignment 8")
  return ()
}

test effect fn structuralUnionsInjectAtBoundariesAndRejectPrecisely() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("structural-union-rejections.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
struct Left { value: i32 }
struct Right { marker: u8 value: i32 }
struct Empty {}
struct Token { value: i32 }
struct Holder { inner: Left | Empty }
fn missing(input: Left | Right | Empty) -> i32 { return match &input { Left { value } => value Empty {} => 0 } }
fn duplicate(input: Left | Right | Empty) -> i32 { return match &input { Left { .. } => 1 Left { value } => value _ => 0 } }
fn afterUniversal(input: Left | Right | Empty) -> i32 { return match &input { _ => 1 Empty {} => 2 } }
fn covered(input: Left | Right | Empty) -> i32 { return match &input { Left { .. } => 1 Right { .. } => 2 Empty {} => 3 _ => 4 } }
fn foreign(input: Left | Right | Empty) -> i32 { return match &input { Token { value } => value _ => 0 } }
fn incomplete(input: Left | Right | Empty) -> i32 { return match &input { Left {} => 1 _ => 0 } }
fn refutable(holder: Holder) -> i32 { return match &holder { Holder { inner: Left { value } } => value } }
fn guardType(input: Left | Right | Empty, count: i32) -> i32 { return match &input { Left { value } if count => value _ => 0 } }
fn returned() -> Left | Empty { return Left { value: 1 } }
fn bound() -> i32 { let held: Left | Empty = Empty {} return 0 }
fn assigned() -> i32 { let mut held: Left | Empty = Empty {} held = Left { value: 2 } return 0 }
fn listed() -> i32 { let values: [Left | Empty; 2] = [Left { value: 3 }, Empty {}] return 0 }
fn armResult(input: Left | Right | Empty) -> Left | Empty { return match &input { Left { value } => Left { value: value } _ => Empty {} } }
fn wrong() -> Left | Empty { return Token { value: 1 } }
fn openUnion(value: f64 | Token) -> i32 { return 0 }
fn deferredOpen() -> i32 { return openUnion(1.5) }
union Shape { Dot, Line { length: i32 } }
fn nestedVariant(input: Left | Shape) -> i32 { return match &input { Shape.Line { length } => length _ => 0 } }
fn nestedExhaustive(input: Left | Shape) -> i32 { return match &input { Shape.Dot => 1 Shape.Line { length } => length Left { value } => value } }
fn helper() -> i32 { return 0 }
fn notType(input: Left | Shape) -> i32 { return match &input { helper { value } => value _ => 0 } }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let returned = run Semantic.demandBody(&mut store, &mut request, &id, b"returned")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let bound = run Semantic.demandBody(&mut store, &mut request, &id, b"bound")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let assigned = run Semantic.demandBody(&mut store, &mut request, &id, b"assigned")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let listed = run Semantic.demandBody(&mut store, &mut request, &id, b"listed")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let armResult = run Semantic.demandBody(&mut store, &mut request, &id, b"armResult")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let wrong = run Semantic.demandBody(&mut store, &mut request, &id, b"wrong")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let deferredOpen = run Semantic.demandBody(&mut store, &mut request, &id, b"deferredOpen")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsSpan(&deferredOpen, RejectionCode.UnionFormUnavailable, text, "openUnion(1.5)", 0),
    "a member of a union outside the closed lane stays a named union-form deferral")
  let returnedInjections = run injectionCount(&returned) |> Effect.provideMut<Allocator>(&mut allocator)
  let boundInjections = run injectionCount(&bound) |> Effect.provideMut<Allocator>(&mut allocator)
  let assignedInjections = run injectionCount(&assigned) |> Effect.provideMut<Allocator>(&mut allocator)
  let listedInjections = run injectionCount(&listed) |> Effect.provideMut<Allocator>(&mut allocator)
  let armInjections = run injectionCount(&armResult) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(returnedInjections == usize.ONE, "a returned member injects once")
  run Testing.expect(boundInjections == usize.ONE, "a typed binding initializer injects once")
  run Testing.expect(assignedInjections == 2, "an initializer and an assignment each inject")
  run Testing.expect(listedInjections == 2, "each contextual array element injects")
  run Testing.expect(armInjections == 2, "each union-typed arm result injects")
  run Testing.expect(rejectsSpan(&wrong, RejectionCode.TypeMismatch, text, "Token { value: 1 }", 0),
    "a non-member return is a mismatch at the returned expression")
  let missing = run Semantic.demandBody(&mut store, &mut request, &id, b"missing")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let duplicate = run Semantic.demandBody(&mut store, &mut request, &id, b"duplicate")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let afterUniversal = run Semantic.demandBody(&mut store, &mut request, &id, b"afterUniversal")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let covered = run Semantic.demandBody(&mut store, &mut request, &id, b"covered")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let foreign = run Semantic.demandBody(&mut store, &mut request, &id, b"foreign")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let incomplete = run Semantic.demandBody(&mut store, &mut request, &id, b"incomplete")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let refutable = run Semantic.demandBody(&mut store, &mut request, &id, b"refutable")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let guardType = run Semantic.demandBody(&mut store, &mut request, &id, b"guardType")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let nestedVariant = run Semantic.demandBody(&mut store, &mut request, &id, b"nestedVariant")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let nestedExhaustive = run Semantic.demandBody(&mut store, &mut request, &id, b"nestedExhaustive")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let notType = run Semantic.demandBody(&mut store, &mut request, &id, b"notType")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(succeeded(&nestedVariant) && succeeded(&nestedExhaustive),
    "a variant pattern of a nominal union member selects that member and tests its variant, and its variants cover it")
  run Testing.expect(rejectsSpan(&notType, RejectionCode.NotType, text, "helper", 1),
    "a record pattern naming a non-type over a structural union keeps its own diagnostic")
  run Testing.expect(
    rejectsSpan(&missing, RejectionCode.MissingUnionMember, text, "match &input { Left { value } => value Empty {} => 0 }", 0) &&
    rejectsSpan(&duplicate, RejectionCode.DuplicateMatchPattern, text, "Left { value }", 1) &&
    rejectsSpan(&afterUniversal, RejectionCode.MatchArmAfterUniversal, text, "Empty {}", 2) &&
    rejectsSpan(&covered, RejectionCode.UnreachableMatchArm, text, "_", 2) &&
    rejectsSpan(&foreign, RejectionCode.TypeMismatch, text, "Token { value }", 0) &&
    rejectsSpan(&incomplete, RejectionCode.InvalidRecordPattern, text, "Left {}", 0) &&
    rejectsSpan(&refutable, RejectionCode.MissingUnionMember, text, "match &holder { Holder { inner: Left { value } } => value }", 0) &&
    rejectsSpan(&guardType, RejectionCode.ConditionNotBool, text, "count", 1),
    "union coverage, foreign members, field lists, refutable subpatterns and guards report precise spans",
  )
  return ()
}

// A nominal application keeps its own identity while its arguments are open, so a generic body
// injects into and matches a union of generic records, as `Vector<T>` storage does; each instance
// maps the authored member to its canonical tag.
test effect fn genericRecordUnionsInjectAndMatchInGenericBodies() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("generic-record-union.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
struct Cell<T> { value: T }
struct Gone {}
struct Holder<T> { state: Cell<T> | Gone }
fn fresh<T>() -> Holder<T> { return Holder<T> { state: Gone {} } }
fn fill<T>(holder: &mut Holder<T>, value: T) -> () {
  let previous = Intrinsic.replace(holder.state, Cell<T> { value: move value })
  drop previous
  return ()
}
fn take<T>(holder: Holder<T>, fallback: T) -> T {
  return match move holder.state {
    Cell<T> { value } => move value
    Gone gone => move fallback
  }
}
pub fn main() -> i32 {
  let mut holder = fresh<i32>()
  fill<i32>(&mut holder, 42)
  return take<i32>(move holder, 0)
}
"""
  let mut store = run applicationSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.forApplication(run ModuleId.copy(&id) |> Effect.provideMut<Allocator>(&mut allocator))
  let fresh = run Semantic.demandBody(&mut store, &mut request, &id, b"fresh")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let fill = run Semantic.demandBody(&mut store, &mut request, &id, b"fill")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let take = run Semantic.demandBody(&mut store, &mut request, &id, b"take")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let empty = run injectionCount(&fresh) |> Effect.provideMut<Allocator>(&mut allocator)
  let filled = run injectionCount(&fill) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(empty == usize.ONE && filled == usize.ONE && succeeded(&take),
    "a generic body injects a record into, and matches, a union of generic record applications")
  let built = run buildApplication(&mut store, &mut request, staticClosureNodes)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(match &built { BackendBuild.Module {..} => true _ => false },
    "each closed instance lowers the injections, the replacement and the tag match")
  return ()
}

// A `while` loop turns the move-consumed `if let` subject into a flagged Maybe owner. Every exit
// drops that union under its flag through its own glue; it is never expanded into a member.
test effect fn loopExitsDropConsumedUnionSubjectUnderItsFlag() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run loopExitSubjectClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}
effect fn loopExitSubjectClaims() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("loop-exit-consumed-union.silk")
  let text = """
struct Token { value: i32 }
impl Drop for Token { fn drop(self: &mut Token) -> () { return () } }
union Kind { Pair {left: Token, right: Token}, Plain {value: i32} }
fn spread(kind: Kind, count: i32) -> i32 {
  if let Kind.Pair {left, right} = move kind {
    let mut at = 0
    while at < count { at = at + left.value }
    drop move right
    return at
  }
  return 0
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let answer = run Semantic.demandMir(&mut store, &mut request, &id, b"spread")
  run Testing.expect(succeeded(&answer) && flaggedSubjectDrop(&store, &answer),
    "the exit after the loop drops the consumed subject only under its own drop flag")
}

// Whether a whole drop of parameter 0 runs as the then-block of a branch on that parameter's flag.
fn flaggedSubjectDrop(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>) -> bool {
  let selected = Shared.with<Result<Answer, NoRejection>, Option<usize>>(answer, selectedMirIndex)
  let index = match move selected { Option<usize>.Some {value} => value _ => { return false } }
  let function = match move Semantic.mirAt(store, index) { Option<&MirFunction>.Some {value} => value _ => { return false } }
  let blocks = Vector.asSlice<MirBlock>(&function.blocks)
  let locals = Vector.asSlice<MirLocal>(&function.locals)
  let mut subject = usize.MAX
  let mut at = usize.ZERO
  while at < locals.length {
    if let MirLocalKind.Parameter {index: parameter} = &locals[at].kind {
      if parameter == usize.ZERO { subject = at }
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < blocks.length {
    if let MirTerminator.Branch {condition: MirOperand.Copy {place}, thenBlock, ..} = &blocks[at].terminator {
      let mut flagged = false
      if place.local < locals.length {
        if let MirLocalKind.DropFlag {local, path} = &locals[place.local].kind {
          flagged = local == subject && Vector.length<MirProjection>(&path) == usize.ZERO
        }
      }
      if flagged && thenBlock < blocks.length {
        let statements = Vector.asSlice<MirStatement>(&blocks[thenBlock].statements)
        let mut position = usize.ZERO
        while position < statements.length {
          if let MirStatement.Drop {destination, ..} = &statements[position] {
            if destination.local == subject && Vector.length<MirProjection>(&destination.projections) == usize.ZERO { return true }
          }
          position = position + usize.ONE
        }
      }
    }
    at = at + usize.ONE
  }
  return false
}

// OWN-004, OWN-008: a `match place` arm that moves a payload field partitions the union while
// another arm keeps it compact. The join keeps one Alternatives component: the union's own flag
// says whether it is whole, and each joined child has a flag. When every arm partitions it there
// is no compact arrival, so only the child flags exist.
test effect fn placeMatchJoinsCompactAndPartitionedUnionUnderFlags() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run alternativesJoinClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}
effect fn alternativesJoinClaims() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("place-match-alternatives-join.silk")
  let text = """
struct Token { value: i32 }
impl Drop for Token { fn drop(self: &mut Token) -> () { return () } }
union Packet { Empty, Ready { left: Token, right: Token } }
union Parcel { Single { only: Token }, Ready { left: Token, right: Token } }
fn joined(packet: Packet) -> () {
  match place packet {
    Packet.Ready { left, .. } => { drop move left }
    Packet.Empty => {}
  }
  return ()
}
fn partitioned(parcel: Parcel) -> () {
  match place parcel {
    Parcel.Ready { left, .. } => { drop move left }
    Parcel.Single { only } => { drop move only }
  }
  return ()
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let joined = run Semantic.demandMir(&mut store, &mut request, &id, b"joined")
  let partitioned = run Semantic.demandMir(&mut store, &mut request, &id, b"partitioned")
  run Testing.expect(succeeded(&joined) && flagDepths(&store, &joined, usize.ZERO) == usize.ONE &&
    flagDepths(&store, &joined, usize.ONE) == 2,
    "a compact arm and a partitioning arm join under the union's whole flag and its children's flags")
  run Testing.expect(succeeded(&partitioned) && flagDepths(&store, &partitioned, usize.ZERO) == usize.ZERO &&
    flagDepths(&store, &partitioned, usize.ONE) == 3,
    "arms that each partition the union join under child flags alone")
}

// The drop-flag locals of a MIR function whose owner path has `depth` projections.
fn flagDepths(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>, depth: usize) -> usize {
  let selected = Shared.with<Result<Answer, NoRejection>, Option<usize>>(answer, selectedMirIndex)
  let index = match move selected { Option<usize>.Some {value} => value _ => { return usize.MAX } }
  let function = match move Semantic.mirAt(store, index) { Option<&MirFunction>.Some {value} => value _ => { return usize.MAX } }
  let locals = Vector.asSlice<MirLocal>(&function.locals)
  let mut count = usize.ZERO
  let mut at = usize.ZERO
  while at < locals.length {
    if let MirLocalKind.DropFlag {path, ..} = &locals[at].kind {
      if Vector.length<MirProjection>(&path) == depth { count = count + usize.ONE }
    }
    at = at + usize.ONE
  }
  return count
}

// UNION-001: substitution may collapse a written failure row, so `Cycle | E | Exhausted` stores
// two members for `E = Exhausted` and three flattened ones for `E = Cycle | Other | Exhausted`.
// Injecting `Cycle` needs only its own storage tag, not an injective map of every written member.
test effect fn genericUnionInjectionSurvivesCollapsedMembers() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run genericUnionInjectionClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}
effect fn genericUnionInjectionClaims() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("generic-union-injection-collapse.silk")
  let text = """
struct Cycle {}
struct Other {}
struct Exhausted {}
effect fn guard<E>(active: bool) -> i32 ! Cycle | E | Exhausted {
  if active { fail Cycle {} }
  return 1
}
effect fn narrow(active: bool) -> i32 ! Cycle | Exhausted { return run guard<Exhausted>(active) }
effect fn wide(active: bool) -> i32 ! Cycle | Other | Exhausted { return run guard<Cycle | Other | Exhausted>(active) }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let narrow = run Semantic.demandBody(&mut store, &mut request, &id, b"narrow")
  let wide = run Semantic.demandBody(&mut store, &mut request, &id, b"wide")
  let mut collapsed = false
  let mut flattened = false
  let narrowApplication = run directApplicationAt(&narrow, usize.ZERO)
  if let Option<SpecializationApplication>.Some {value} = move narrowApplication {
    let mir = run Semantic.demandApplicationMir(&mut store, &mut request, &value)
    collapsed = run injectsUnderStorageTag(&store, &mir)
  }
  let wideApplication = run directApplicationAt(&wide, usize.ZERO)
  if let Option<SpecializationApplication>.Some {value} = move wideApplication {
    let mir = run Semantic.demandApplicationMir(&mut store, &mut request, &value)
    flattened = run injectsUnderStorageTag(&store, &mir)
  }
  run Testing.expect(collapsed && flattened,
    "each closed instance injects Cycle under its own tag when other written members collapse or flatten")
}

// UNION-001: a narrower structural union is stored in a wider one, as a field or a plain return,
// by re-injecting each of its members under that member's canonical tag in the wider union.
test effect fn narrowerUnionWidensIntoFieldsAndReturns() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run unionWideningClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}
effect fn unionWideningClaims() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("union-widening.silk")
  let text = """
struct Success<A> { value: A }
struct Failure<E> { error: E }
struct Cancelled {}
struct Outcome<A, E> { value: Success<A> | Failure<E> | Cancelled }
fn field<A, E>(selected: Success<A> | Failure<E>) -> Outcome<A, E> { return Outcome<A, E> { value: move selected } }
fn closedField() -> Outcome<i32, bool> { return field<i32, bool>(Success<i32> { value: 1 }) }
fn plain(selected: Success<i32> | Cancelled) -> Success<i32> | Failure<bool> | Cancelled { return move selected }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let plainBody = run Semantic.demandBody(&mut store, &mut request, &id, b"plain")
  let fieldBody = run Semantic.demandBody(&mut store, &mut request, &id, b"field")
  run Testing.expect((run wideningCount(&plainBody)) == usize.ONE && (run wideningCount(&fieldBody)) == usize.ONE,
    "a narrower union is widened once for a plain return and once for a struct field")
  let plainMir = run Semantic.demandMir(&mut store, &mut request, &id, b"plain")
  let plainWidened = run widensUnderStorageTag(&store, &plainMir)
  let closed = run Semantic.demandBody(&mut store, &mut request, &id, b"closedField")
  let mut fieldWidened = usize.ZERO
  let application = run directApplicationAt(&closed, usize.ZERO)
  if let Option<SpecializationApplication>.Some {value} = move application {
    let mir = run Semantic.demandApplicationMir(&mut store, &mut request, &value)
    fieldWidened = run widensUnderStorageTag(&store, &mir)
  }
  run Testing.expect(plainWidened == 2 && fieldWidened == 2,
    "each member of the narrower union is re-injected under its own canonical tag in the wider union")
}

effect fn wideningCount(answer: &Shared<Result<Answer, NoRejection>>) -> usize ! OutOfMemoryError ? &mut Allocator {
  let selected = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(answer, checkedBody)
  return match move selected {
    Option<Shared<TypedBody>>.Some {value} => Shared.with<TypedBody, usize>(&value, unionWidenings)
    Option<Shared<TypedBody>>.None => usize.MAX
  }
}

fn unionWidenings(body: &TypedBody) -> usize {
  let nodes = TypedBody.nodeSlice(body)
  let mut found = usize.ZERO
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {form: BodyExpression.UnionWiden {..}, ..} = &nodes[at].kind { found = found + usize.ONE }
    at = at + usize.ONE
  }
  return found
}

// How many Injects in the selected MIR store a projected union payload under the tag its member
// type has in the destination union; zero when any such Inject uses another tag.
effect fn widensUnderStorageTag(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>) -> usize
! OutOfMemoryError ? &mut Allocator {
  let selected = Shared.with<Result<Answer, NoRejection>, Option<usize>>(answer, selectedMirIndex)
  let index = match move selected { Option<usize>.Some {value} => value _ => { return usize.ZERO } }
  let function = match move Semantic.mirAt(store, index) { Option<&MirFunction>.Some {value} => value _ => { return usize.ZERO } }
  let blocks = Vector.asSlice<MirBlock>(&function.blocks)
  let locals = Vector.asSlice<MirLocal>(&function.locals)
  let mut count = usize.ZERO
  let mut at = usize.ZERO
  while at < blocks.length {
    let statements = Vector.asSlice<MirStatement>(&blocks[at].statements)
    let mut position = usize.ZERO
    while position < statements.length {
      if let MirStatement.Assign {destination, value: MirRvalue.Inject {tag, value: MirOperand.Move {place}}, ..} = &statements[position] {
        let projections = Vector.asSlice<MirProjection>(&place.projections)
        if projections.length == usize.ONE {
          if let MirProjection.Payload {ty, ..} = &projections[usize.ZERO] {
            if destination.local >= locals.length { return usize.ZERO }
            let members = match move run Type.canonicalUnionMembers(&locals[destination.local].ty) {
              Option<Vector<Shared<Type>>>.Some {value} => move value
              _ => { return usize.ZERO }
            }
            let listed = Vector.asSlice<Shared<Type>>(&members)
            if tag >= listed.length || !(run Type.runtimeEqualsShared(&listed[tag], &ty)) { return usize.ZERO }
            count = count + usize.ONE
          }
        }
      }
      position = position + usize.ONE
    }
    at = at + usize.ONE
  }
  return count
}

// Every Inject in the selected MIR stores its operand's type under that type's canonical tag.
effect fn injectsUnderStorageTag(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>) -> bool
! OutOfMemoryError ? &mut Allocator {
  let selected = Shared.with<Result<Answer, NoRejection>, Option<usize>>(answer, selectedMirIndex)
  let index = match move selected { Option<usize>.Some {value} => value _ => { return false } }
  let function = match move Semantic.mirAt(store, index) { Option<&MirFunction>.Some {value} => value _ => { return false } }
  let blocks = Vector.asSlice<MirBlock>(&function.blocks)
  let locals = Vector.asSlice<MirLocal>(&function.locals)
  let mut count = usize.ZERO
  let mut at = usize.ZERO
  while at < blocks.length {
    let statements = Vector.asSlice<MirStatement>(&blocks[at].statements)
    let mut position = usize.ZERO
    while position < statements.length {
      if let MirStatement.Assign {destination, value: MirRvalue.Inject {tag, value: MirOperand.Move {place}}, ..} = &statements[position] {
        if destination.local >= locals.length || place.local >= locals.length { return false }
        let members = match move run Type.canonicalUnionMembers(&locals[destination.local].ty) {
          Option<Vector<Shared<Type>>>.Some {value} => move value
          _ => { return false }
        }
        let listed = Vector.asSlice<Shared<Type>>(&members)
        if tag >= listed.length || !(run Type.runtimeEqualsShared(&listed[tag], &locals[place.local].ty)) { return false }
        count = count + usize.ONE
      }
      position = position + usize.ONE
    }
    at = at + usize.ONE
  }
  return count != usize.ZERO
}

fn variantConstructions(body: &TypedBody) -> usize {
  let nodes = TypedBody.nodeSlice(body)
  let mut encoded = usize.ZERO
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {form: BodyExpression.VariantConstruct {tag, fields}, ..} = &nodes[at].kind {
      encoded = encoded * 10 + tag * 3 + Vector.length<BodyAggregateField>(&fields) + usize.ONE
    }
    at = at + usize.ONE
  }
  return encoded
}

fn matchTagCount(body: &TypedBody) -> usize {
  let nodes = TypedBody.nodeSlice(body)
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {form: BodyExpression.Match {tags, ..}, ..} = &nodes[at].kind { return tags }
    at = at + usize.ONE
  }
  return usize.MAX
}

fn matchArmCount(body: &TypedBody) -> usize {
  let nodes = TypedBody.nodeSlice(body)
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {form: BodyExpression.Match {arms, ..}, ..} = &nodes[at].kind {
      return Vector.length<BodyMatchArm>(&arms)
    }
    at = at + usize.ONE
  }
  return usize.MAX
}

fn variantArmTag(body: &TypedBody, arm: usize) -> usize {
  let nodes = TypedBody.nodeSlice(body)
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {form: BodyExpression.Match {arms, ..}, ..} = &nodes[at].kind {
      let written = Vector.asSlice<BodyMatchArm>(&arms)
      if arm < written.length {
        if let BodyPattern.Variant {tag} = &written[arm].pattern { return tag }
      }
      return usize.MAX
    }
    at = at + usize.ONE
  }
  return usize.MAX
}

fn variantBindings(body: &TypedBody, tag: usize, field: usize) -> usize {
  let nodes = TypedBody.nodeSlice(body)
  let mut found = usize.ZERO
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {form: BodyExpression.PatternBinding {path, ..}, ..} = &nodes[at].kind {
      let steps = Vector.asSlice<BodyPlaceStep>(&path)
      if steps.length == usize.ONE {
        if let BodyPlaceStep.VariantField {tag: selected, field: index} = &steps[usize.ZERO] {
          if selected == tag && index == field { found = found + usize.ONE }
        }
      }
    }
    at = at + usize.ONE
  }
  return found
}

fn variantsLayout(layout: &BackendLayout) -> bool {
  if let LayoutStorage.Variants {tagSize, payloadOffset, ..} = &layout.storage {
    let height = BackendLayout.variantField(layout, usize.ONE, usize.ONE)
    let radius = BackendLayout.variantField(layout, usize.ZERO, usize.ZERO)
    let mut offsets = false
    if let Option<LayoutField>.Some {value: second} = &height {
      if let Option<LayoutField>.Some {value: first} = &radius { offsets = second.offset == 16 && first.offset == 8 }
    }
    return tagSize == usize.ONE && payloadOffset == 8 && layout.size == 24 && layout.alignment == 8 && offsets
  }
  return false
}

fn genericUnionLayout(layout: &BackendLayout, size: usize, alignment: usize, payloadOffset: usize) -> bool {
  if let LayoutStorage.Variants {tagSize, payloadOffset: offset, ..} = &layout.storage {
    return tagSize == usize.ONE && offset == payloadOffset && layout.size == size
      && layout.alignment == alignment
  }
  return false
}

// The empty variant is tag zero and the one-field payload is tag one in both ordinary declarations.
fn sameOptionTopology(left: &BackendLayout, right: &BackendLayout) -> bool {
  if left.size != right.size || left.alignment != right.alignment || left.abi != right.abi
    || left.abi != LayoutAbi.Indirect { return false }
  if let LayoutStorage.Variants {variants: first, tagSize: firstTag, payloadOffset: firstPayload} = &left.storage {
    if let LayoutStorage.Variants {variants: second, tagSize: secondTag, payloadOffset: secondPayload} = &right.storage {
      let a = Vector.asSlice<Vector<LayoutField>>(&first)
      let b = Vector.asSlice<Vector<LayoutField>>(&second)
      if a.length != 2 || b.length != 2 || firstTag != usize.ONE || firstTag != secondTag
        || firstPayload != secondPayload || Vector.length<LayoutField>(&a[usize.ZERO]) != usize.ZERO
        || Vector.length<LayoutField>(&b[usize.ZERO]) != usize.ZERO { return false }
      let firstFields = Vector.asSlice<LayoutField>(&a[usize.ONE])
      let secondFields = Vector.asSlice<LayoutField>(&b[usize.ONE])
      return firstFields.length == usize.ONE && secondFields.length == usize.ONE
        && firstFields[usize.ZERO].offset == secondFields[usize.ZERO].offset
    }
  }
  return false
}

fn sameSharedOptionTopology(left: &BackendLayout, right: &Shared<BackendLayout>) -> bool {
  return Shared.with<BackendLayout, bool>(right, fn(value: &BackendLayout) -> bool {
    return sameOptionTopology(left, value)
  })
}

effect fn optionLayoutMatches(
  store: &Semantic, left: &Shared<Result<Answer, NoRejection>>, right: &Shared<Result<Answer, NoRejection>>,
  size: usize, alignment: usize, payload: usize,
) -> bool ! OutOfMemoryError ? &mut Allocator {
  let firstIndex = Shared.with<Result<Answer, NoRejection>, Option<usize>>(left, selectedLayoutIndex)
  let secondIndex = Shared.with<Result<Answer, NoRejection>, Option<usize>>(right, selectedLayoutIndex)
  if let Option<usize>.Some {value: a} = move firstIndex {
    if let Option<usize>.Some {value: b} = move secondIndex {
      if let Option<Shared<BackendLayout>>.Some {value: actual} = move Semantic.layoutAt(store, a) {
        if let Option<Shared<BackendLayout>>.Some {value: custom} = move Semantic.layoutAt(store, b) {
          let topology = Shared.with<BackendLayout, bool>(&actual, fn(first: &BackendLayout) -> bool {
            return genericUnionLayout(first, size, alignment, payload)
              && sameSharedOptionTopology(first, &custom)
          })
          let actualField = Shared.with<BackendLayout, Option<LayoutField>>(&actual, fn(layout: &BackendLayout) -> Option<LayoutField> {
            return BackendLayout.variantField(layout, usize.ONE, usize.ZERO)
          })
          let customField = Shared.with<BackendLayout, Option<LayoutField>>(&custom, fn(layout: &BackendLayout) -> Option<LayoutField> {
            return BackendLayout.variantField(layout, usize.ONE, usize.ZERO)
          })
          if let Option<LayoutField>.Some {value: x} = move actualField {
            if let Option<LayoutField>.Some {value: y} = move customField {
              return topology && x.offset == payload && y.offset == payload && run Type.equalsShared(&x.ty, &y.ty)
            }
          }
        }
      }
    }
  }
  return false
}

test effect fn genericOptionLibraryAndUserUnionHaveIdenticalLayout() -> ()
! FileError | HostInputError | InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  // Program.runTest preserves repository-root CWD. Read the actual library through its ordinary
  // native provider, then publish all bytes under the same ModuleId an import normally resolves.
  let cwd = run NativeHostInput.workingDirectory() |> Effect.provideMut<Allocator>(&mut allocator)
  let mut files = run OsFileSystem.make(Bytes.asSlice(&cwd)) |> Effect.provideMut<Allocator>(&mut allocator)
  let path = run Path.fromBytes(b"/packages/compiler/stdlib/silk/option.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let bytes = run FileSystem.readFile(&path) |> Effect.provideMut<FileSystem>(&mut files) |> Effect.provideMut<Allocator>(&mut allocator)
  let librarySource = Option.some<Bytes>(move bytes)
  let id = run module("generic-option-layout.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let library = run module("silk/option.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let source = run present("""
import silk.option { Option }
struct Token { value: i64 }
union Maybe<T> { None, Some { value: T } }
fn instances(actual: Option<i32>, custom: Maybe<i32>, actualToken: Option<Token>, customToken: Maybe<Token>) -> i32 { return 0 }
""") |> Effect.provideMut<Allocator>(&mut allocator)
  let entryRevision = run Revision.publish(&Revision.make(), &id, &source) |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&entryRevision, &library, &librarySource) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut store = Semantic.traced(move revision, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu), Option.none<FinalProfile>())
  let mut request = Request.make()
  let body = run Semantic.demandBody(&mut store, &mut request, &id, b"instances") |> Effect.provideMut<Allocator>(&mut allocator)
  let actual = match move bodyLocalType(&body, usize.ZERO) {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => { run Testing.expect(false, "actual stdlib Option<i32> resolves through ordinary source publication") return () }
  }
  let custom = match move bodyLocalType(&body, usize.ONE) {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => { run Testing.expect(false, "the user-defined Maybe<i32> is a separate complete nominal instance") return () }
  }
  let actualToken = match move bodyLocalType(&body, 2) {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => { run Testing.expect(false, "actual stdlib Option<Token> retains its nominal payload") return () }
  }
  let customToken = match move bodyLocalType(&body, 3) {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => { run Testing.expect(false, "the user-defined Maybe<Token> retains the same nominal payload") return () }
  }
  run Testing.expect(!(run Type.equalsShared(&actual, &custom) |> Effect.provideMut<Allocator>(&mut allocator))
    && !(run Type.equalsShared(&actualToken, &customToken) |> Effect.provideMut<Allocator>(&mut allocator)),
    "library Option and user Maybe are distinct declarations, not aliases of one privileged instance")
  let a = run Semantic.demandLayout(&mut store, &mut request, &id, &actual) |> Effect.provideMut<Allocator>(&mut allocator)
  let b = run Semantic.demandLayout(&mut store, &mut request, &id, &custom) |> Effect.provideMut<Allocator>(&mut allocator)
  let c = run Semantic.demandLayout(&mut store, &mut request, &id, &actualToken) |> Effect.provideMut<Allocator>(&mut allocator)
  let d = run Semantic.demandLayout(&mut store, &mut request, &id, &customToken) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(run optionLayoutMatches(&store, &a, &b, 8, 4, 4) |> Effect.provideMut<Allocator>(&mut allocator),
    "Option<i32> and Maybe<i32> agree on size, alignment, ABI, tag order/width and payload field type/offset")
  run Testing.expect(run optionLayoutMatches(&store, &c, &d, 16, 8, 8) |> Effect.provideMut<Allocator>(&mut allocator),
    "Option<Token> and Maybe<Token> use the same substituted nominal-payload layout without library privilege")
  return ()
}

test effect fn genericNominalUnionInstancesConstructMatchAndLayout() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("generic-nominal-union-instances.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
union Choice<T> { Some { value: T }, None }
fn instances() -> u8 {
  let narrow = Choice<u8>.Some { value: 42 }
  let wide = Choice<i64>.Some { value: 42 }
  drop wide
  return match move narrow { Choice<u8>.Some { value } => value Choice<u8>.None => 0 }
}
fn incomplete(value: Choice<i32>) -> i32 {
  return match move value { Choice<i32>.Some { value } => value }
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let instances = run Semantic.demandBody(&mut store, &mut request, &id, b"instances")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let narrowType = match move bodyLocalType(&instances, usize.ZERO) {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => {
      run Testing.expect(false, "Choice<u8> construction retains its complete nominal type")
      return ()
    }
  }
  let wideType = match move bodyLocalType(&instances, usize.ONE) {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => {
      run Testing.expect(false, "Choice<i64> call result retains its complete nominal type")
      return ()
    }
  }
  let distinct = !(run Type.equalsShared(&narrowType, &wideType)
    |> Effect.provideMut<Allocator>(&mut allocator))
  run Testing.expect(
    distinct && nominalOfKind(&narrowType, OwnerKind.Union)
      && nominalOfKind(&wideType, OwnerKind.Union)
      && !Type.hasOpenParameters(&narrowType)
      && !Type.hasOpenParameters(&wideType),
    "generic union construction and call results publish distinct complete applications",
  )
  let narrowLayout = run Semantic.demandLayout(&mut store, &mut request, &id, &narrowType)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let repeatedLayout = run Semantic.demandLayout(&mut store, &mut request, &id, &narrowType)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let wideLayout = run Semantic.demandLayout(&mut store, &mut request, &id, &wideType)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let narrowIndex = Shared.with<Result<Answer, NoRejection>, Option<usize>>(&narrowLayout, selectedLayoutIndex)
  let repeatedIndex = Shared.with<Result<Answer, NoRejection>, Option<usize>>(&repeatedLayout, selectedLayoutIndex)
  let wideIndex = Shared.with<Result<Answer, NoRejection>, Option<usize>>(&wideLayout, selectedLayoutIndex)
  let mut interned = false
  let mut laidOut = false
  if let Option<usize>.Some {value: small} = move narrowIndex {
    if let Option<usize>.Some {value: repeated} = move repeatedIndex {
      if let Option<usize>.Some {value: broad} = move wideIndex {
        interned = small == repeated && small != broad
        let smallFacts = Semantic.layoutAt(&store, small)
        let broadFacts = Semantic.layoutAt(&store, broad)
        if let Option<Shared<BackendLayout>>.Some {value: narrowFacts} = move smallFacts {
          if let Option<Shared<BackendLayout>>.Some {value: wideFacts} = move broadFacts {
            laidOut = Shared.with<BackendLayout, bool>(&narrowFacts, fn(layout: &BackendLayout) -> bool {
              return genericUnionLayout(layout, 2, usize.ONE, usize.ONE)
            }) && Shared.with<BackendLayout, bool>(&wideFacts, fn(layout: &BackendLayout) -> bool {
              return genericUnionLayout(layout, 16, 8, 8)
            })
          }
        }
      }
    }
  }
  run Testing.expect(
    interned && laidOut,
    "equal generic union instances share one layout and distinct payload instances lay out separately",
  )
  let instancesBody = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(&instances, checkedBody)
  let mut patterns = false
  if let Option<Shared<TypedBody>>.Some {value: body} = move instancesBody {
    patterns = Shared.with<TypedBody, usize>(&body, matchTagCount) == 2
      && Shared.with<TypedBody, usize>(&body, fn(selected: &TypedBody) -> usize {
        return variantBindings(selected, usize.ZERO, usize.ZERO)
      }) >= usize.ONE
  }
  run Testing.expect(patterns, "applied generic variant patterns retain tag coverage and substituted payload places")
  let incomplete = run Semantic.demandBody(&mut store, &mut request, &id, b"incomplete")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    rejectsSpan(
      &incomplete,
      RejectionCode.MissingUnionMember,
      text,
      "match move value { Choice<i32>.Some { value } => value }",
      0,
    ),
    "generic union coverage reports an omitted variant at the match",
  )
  return ()
}

test effect fn genericAggregatePayloadInferenceCompletesOrDiagnosesDeclaration() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("generic-aggregate-inference.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
union Choice<Payload> { Some { value: Payload }, None }
struct Phantom<Unused> { value: i32 }
fn inferred() -> i32 {
  let chosen = Choice.Some { value: 42 }
  return match move chosen { Choice<i32>.Some { value } => value Choice<i32>.None => 0 }
}
fn contextual() -> Choice<u8> { return Choice.Some { value: 42 } }
fn missingUnionArgument() -> i32 { let empty = Choice.None drop empty return 42 }
fn missingRecordArgument() -> i32 { let phantom = Phantom { value: 42 } drop phantom return 42 }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let inferred = run Semantic.demandBody(&mut store, &mut request, &id, b"inferred") |> Effect.provideMut<Allocator>(&mut allocator)
  let contextual = run Semantic.demandBody(&mut store, &mut request, &id, b"contextual") |> Effect.provideMut<Allocator>(&mut allocator)
  let chosenType = bodyLocalType(&inferred, usize.ZERO)
  let mut complete = false
  if let Option<Shared<Type>>.Some {value} = move chosenType {
    complete = nominalOfKind(&value, OwnerKind.Union) && !Type.hasOpenParameters(&value)
  }
  run Testing.expect(complete && Shared.with<Result<Answer, NoRejection>, AnswerView>(&contextual, inspect).success,
    "bare union payload inference publishes a complete nominal application and aggregate context remains valid")
  let missingUnion = run Semantic.demandBody(&mut store, &mut request, &id, b"missingUnionArgument") |> Effect.provideMut<Allocator>(&mut allocator)
  let missingRecord = run Semantic.demandBody(&mut store, &mut request, &id, b"missingRecordArgument") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    rejectsSpan(&missingUnion, RejectionCode.UninferredParameter, text, "Payload", 0)
      && rejectsSpan(&missingRecord, RejectionCode.UninferredParameter, text, "Unused", 0),
    "uninferred union and record parameters are diagnosed at their declaration anchors")
  return ()
}

test effect fn genericNominalUnionInstancesClassifyCopyAndShareDropGlue() -> ()
! CanonicalizationFailure | InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("generic-nominal-union-ownership.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
struct Token { value: i32 }
impl Drop for Token { fn drop(self: &mut Token) -> () { return () } }
union Cell<T> { Vacant, Held { value: T } }
impl<T: Copy> Copy for Cell<T> {}
fn abstract<T>(subject: &Cell<T>, value: T) -> Cell<T> {
  let held = match &subject.* { Cell<T>.Held { .. } => true Cell<T>.Vacant => false }
  if held { return Cell.Held { value: move value } }
  return Cell.Vacant
}
fn copied(slot: &Cell<i32>) -> i32 { drop slot.* return 0 }
fn affine(slot: &Cell<Token>) -> i32 { drop slot.* return 0 }
fn dropped(slot: Cell<Token>) -> i32 { drop slot return 0 }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let copied = run Semantic.demandBody(&mut store, &mut request, &id, b"copied")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let abstract = run Semantic.demandBody(&mut store, &mut request, &id, b"abstract")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let affine = run Semantic.demandBody(&mut store, &mut request, &id, b"affine")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    succeeded(&copied) && succeeded(&abstract),
    "generic union Copy bounds, open patterns and contextual constructors check abstractly",
  )
  run Testing.expect(
    rejectsSpan(&affine, RejectionCode.BorrowedExtraction, text, "slot.*", 1),
    "Cell<Token> remains affine because Token does not satisfy the declared Copy bound",
  )
  let dropped = run Semantic.demandMir(&mut store, &mut request, &id, b"dropped")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let firstGlue = run droppedGlue(&mut store, &mut request, &id, b"dropped")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let secondGlue = run droppedGlue(&mut store, &mut request, &id, b"dropped")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let firstIndex = Shared.with<Result<Answer, NoRejection>, Option<usize>>(&firstGlue, selectedMirIndex)
  let secondIndex = Shared.with<Result<Answer, NoRejection>, Option<usize>>(&secondGlue, selectedMirIndex)
  let sharedGlue = match move firstIndex {
    Option<usize>.Some {value: first} => match move secondIndex {
      Option<usize>.Some {value: second} => first == second
      Option<usize>.None => false
    }
    Option<usize>.None => false
  }
  run Testing.expect(
    sharedGlue && glueFact(&store, &firstGlue, 2) == usize.ONE
      && glueFact(&store, &firstGlue, usize.ZERO) == usize.ONE
      && glueFact(&store, &firstGlue, 3) == 3010,
    "one Cell<Token> glue instance switches on the active tag and drops its substituted Token once",
  )
  let copyType = referentOf(bodyLocalType(&copied, usize.ZERO))
  let dropType = droppedType(&store, &dropped)
  let repeatedDropType = droppedType(&store, &dropped)
  let mut keyed = false
  if let Option<Shared<Type>>.Some {value: plain} = move copyType {
    if let Option<Shared<Type>>.Some {value: droppable} = move dropType {
      if let Option<Shared<Type>>.Some {value: repeated} = move repeatedDropType {
  let copyOwner = run glueSourceOwner(&mut store, &copied) |> Effect.provideMut<Allocator>(&mut allocator)
  let dropOwner = run glueSourceOwner(&mut store, &dropped) |> Effect.provideMut<Allocator>(&mut allocator)
        let plainKeyResult = run InstanceKey.dropGlue(&plain, &copyOwner) |> Effect.provideMut<Allocator>(&mut allocator)
        let plainKey = run requiredCanonicalGlue(move plainKeyResult)
        let dropKeyResult = run InstanceKey.dropGlue(&droppable, &dropOwner) |> Effect.provideMut<Allocator>(&mut allocator)
        let dropKey = run requiredCanonicalGlue(move dropKeyResult)
        let repeatedKeyResult = run InstanceKey.dropGlue(&repeated, &dropOwner) |> Effect.provideMut<Allocator>(&mut allocator)
        let repeatedKey = run requiredCanonicalGlue(move repeatedKeyResult)
        if let Option<InstanceKey>.Some {value: plainInstance} = move plainKey {
          if let Option<InstanceKey>.Some {value: dropInstance} = move dropKey {
            if let Option<InstanceKey>.Some {value: repeatedInstance} = move repeatedKey {
              let plainSymbol = run InstanceKey.runtimeName(&plainInstance)
                |> Effect.provideMut<Allocator>(&mut allocator)
              let dropSymbol = run InstanceKey.runtimeName(&dropInstance)
                |> Effect.provideMut<Allocator>(&mut allocator)
              let repeatedSymbol = run InstanceKey.runtimeName(&repeatedInstance)
                |> Effect.provideMut<Allocator>(&mut allocator)
              keyed = !InstanceKey.sameRuntimeBase(&plainInstance, &dropInstance)
                && InstanceKey.sameRuntimeBase(&dropInstance, &repeatedInstance)
                && !sameBytes(Bytes.asSlice(&plainSymbol), Bytes.asSlice(&dropSymbol))
                && sameBytes(Bytes.asSlice(&dropSymbol), Bytes.asSlice(&repeatedSymbol))
            }
          }
        }
      }
    }
  }
  run Testing.expect(keyed, "complete generic union instances have canonical distinct glue family keys and names")
  return ()
}

// Nominal unions tag variants in declaration order, lay each variant out like a record
// after the tag, bind variant fields as places and switch on the tag.
test effect fn genericAndNominalUnionsConstructBindAndSwitchOnVariants() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("genericAndNominalUnionsConstructBindAndSwitchOnVariants.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
union Shape { Circle { radius: i32 }, Rect { width: i32, height: i64 }, Empty }
fn make(kind: i32) -> Shape {
  if kind == 0 { return Shape.Circle { radius: 3 } }
  return Shape.Empty
}
fn area(shape: &Shape) -> i32 {
  return match &shape.* {
    Shape.Circle { radius } => radius
    Shape.Rect { width, .. } if width > 10 => width
    Shape.Rect { width, height } => width
    Shape.Empty => 0
  }
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu)) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let makeAnswer = run Semantic.demandBody(&mut store, &mut request, &id, b"make")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let areaAnswer = run Semantic.demandBody(&mut store, &mut request, &id, b"area")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut constructions = usize.ZERO
  let madeBody = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(&makeAnswer, checkedBody)
  if let Option<Shared<TypedBody>>.Some {value} = move madeBody {
    constructions = Shared.with<TypedBody, usize>(&value, variantConstructions)
  }
  run Testing.expect(constructions == 27, "a payload variant keeps its tag and field operand and a unit variant has none")
  let mut tags = usize.MAX
  let mut armCount = usize.MAX
  let mut first = usize.MAX
  let mut second = usize.MAX
  let mut third = usize.MAX
  let mut fourth = usize.MAX
  let mut radius = usize.ZERO
  let mut width = usize.ZERO
  let mut height = usize.ZERO
  let mut shapeType = Option.none<Shared<Type>>()
  let areaBody = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(&areaAnswer, checkedBody)
  if let Option<Shared<TypedBody>>.Some {value} = move areaBody {
    tags = Shared.with<TypedBody, usize>(&value, matchTagCount)
    armCount = Shared.with<TypedBody, usize>(&value, matchArmCount)
    first = Shared.with<TypedBody, usize>(&value, fn(body: &TypedBody) -> usize { return variantArmTag(body, usize.ZERO) })
    second = Shared.with<TypedBody, usize>(&value, fn(body: &TypedBody) -> usize { return variantArmTag(body, usize.ONE) })
    third = Shared.with<TypedBody, usize>(&value, fn(body: &TypedBody) -> usize { return variantArmTag(body, 2) })
    fourth = Shared.with<TypedBody, usize>(&value, fn(body: &TypedBody) -> usize { return variantArmTag(body, 3) })
    radius = Shared.with<TypedBody, usize>(&value, fn(body: &TypedBody) -> usize { return variantBindings(body, usize.ZERO, usize.ZERO) })
    width = Shared.with<TypedBody, usize>(&value, fn(body: &TypedBody) -> usize { return variantBindings(body, usize.ONE, usize.ZERO) })
    height = Shared.with<TypedBody, usize>(&value, fn(body: &TypedBody) -> usize { return variantBindings(body, usize.ONE, usize.ONE) })
    shapeType = Shared.with<TypedBody, Option<Shared<Type>>>(&value, enumParameterType)
  }
  run Testing.expect(tags == 3 && armCount == 4 && first == usize.ZERO && second == usize.ONE && third == usize.ONE && fourth == 2,
    "variant patterns keep declaration-order tags")
  run Testing.expect(radius >= usize.ONE && width >= 2 && height >= usize.ONE, "variant fields bind as places")
  let mut laidOut = false
  if let Option<Shared<Type>>.Some {value: reference} = move shapeType {
    let referent = Shared.with<Type, Option<Shared<Type>>>(&reference, fn(value: &Type) -> Option<Shared<Type>> {
      if let Type.Reference {referent, ..} = &value.* { return Option.some<Shared<Type>>(Shared.clone<Type>(&referent)) }
      return Option.none<Shared<Type>>()
    })
    if let Option<Shared<Type>>.Some {value: ty} = move referent {
      let layoutAnswer = run Semantic.demandLayout(&mut store, &mut request, &id, &ty)
        |> Effect.provideMut<Allocator>(&mut allocator)
      let layoutIndex = Shared.with<Result<Answer, NoRejection>, Option<usize>>(&layoutAnswer, selectedLayoutIndex)
      if let Option<usize>.Some {value: index} = move layoutIndex {
        if let Option<Shared<BackendLayout>>.Some {value: facts} = move Semantic.layoutAt(&store, index) {
          laidOut = Shared.with<BackendLayout, bool>(&facts, variantsLayout)
        }
      }
    }
  }
  run Testing.expect(laidOut, "each variant keeps record field offsets after a one-byte tag at the strictest alignment")
  let mirAnswer = run Semantic.demandMir(&mut store, &mut request, &id, b"area")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut switches = usize.ZERO
  let mut cases = usize.ZERO
  let mut discriminant = false
  let mut variantField = false
  let mirIndex = Shared.with<Result<Answer, NoRejection>, Option<usize>>(&mirAnswer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move mirIndex {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(&store, index) {
      let blocks = Vector.asSlice<MirBlock>(&function.blocks)
      let mut at = usize.ZERO
      while at < blocks.length {
        if let MirTerminator.Switch {cases: selected, ..} = &blocks[at].terminator {
          switches = switches + usize.ONE
          cases = cases + Vector.length<MirSwitchCase>(&selected)
        }
        let statements = Vector.asSlice<MirStatement>(&blocks[at].statements)
        let mut statementAt = usize.ZERO
        while statementAt < statements.length {
          if let MirStatement.Assign {value, ..} = &statements[statementAt] {
            if let MirRvalue.Discriminant {..} = &value { discriminant = true }
            if let MirRvalue.Use {value: MirOperand.Copy {place}} = &value {
              let projections = Vector.asSlice<MirProjection>(&place.projections)
              let mut step = usize.ZERO
              while step < projections.length {
                if let MirProjection.VariantField {..} = &projections[step] { variantField = true }
                step = step + usize.ONE
              }
            }
          }
          statementAt = statementAt + usize.ONE
        }
        at = at + usize.ONE
      }
    }
  }
  run Testing.expect(discriminant && variantField && switches == 2 && cases == 5,
    "the tag is read once, a false guard resumes the switch at the next arm, and fields project by variant")
  return ()
}

test effect fn genericNominalUnionConstructorsDiagnosePayloads() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("genericNominalUnionConstructorsDiagnosePayloads.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
union Shape { Circle { radius: i32 }, Rect { width: i32, height: i64 }, Empty }
fn unknownField() -> Shape { return Shape.Circle { size: 1 } }
fn fieldCount() -> Shape { return Shape.Rect { width: 1 } }
fn payloadUnit() -> Shape { return Shape.Rect }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu)) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let unknownField = run Semantic.demandBody(&mut store, &mut request, &id, b"unknownField") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsSpan(&unknownField, RejectionCode.UnknownMember, text, "size", 0), "a constructor names only variant fields")
  let fieldCount = run Semantic.demandBody(&mut store, &mut request, &id, b"fieldCount") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsSpan(&fieldCount, RejectionCode.CallArity, text, "Shape.Rect { width: 1 }", 0), "a constructor initializes every field")
  let payloadUnit = run Semantic.demandBody(&mut store, &mut request, &id, b"payloadUnit") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsSpan(&payloadUnit, RejectionCode.CallArity, text, "Shape.Rect", 1), "a payload variant needs its fields")
  return ()
}

test effect fn genericNominalUnionPatternsDiagnoseCoverage() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("genericNominalUnionPatternsDiagnoseCoverage.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
union Shape { Circle { radius: i32 }, Rect { width: i32, height: i64 }, Empty }
fn missing(shape: Shape) -> i32 { return match move shape { Shape.Circle { radius } => radius Shape.Empty => 0 } }
fn duplicate(shape: Shape) -> i32 { return match move shape { Shape.Empty => 0 Shape.Empty => 1 _ => 2 } }
fn unitPattern(shape: Shape) -> i32 { return match move shape { Shape.Rect => 1 _ => 0 } }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu)) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let missing = run Semantic.demandBody(&mut store, &mut request, &id, b"missing") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsSpan(&missing, RejectionCode.MissingUnionMember, text, "match move shape { Shape.Circle { radius } => radius Shape.Empty => 0 }", 0), "a missing variant is uncovered")
  let duplicate = run Semantic.demandBody(&mut store, &mut request, &id, b"duplicate") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsSpan(&duplicate, RejectionCode.DuplicateMatchPattern, text, "Shape.Empty", 2), "a repeated unit variant is duplicate")
  let unitPattern = run Semantic.demandBody(&mut store, &mut request, &id, b"unitPattern") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsSpan(&unitPattern, RejectionCode.InvalidRecordPattern, text, "Shape.Rect", 0), "a payload variant pattern names its fields")
  return ()
}

