  run Testing.expect(absent && missingKey && foreignKey,
    "no conforming key, an absent selected key, and a selected key the provider does not conform to reject")
  let ambiguous = run providedRejects(&mut store, &mut request, &id, "ambiguous", RejectionCode.AmbiguousProvidedKey, text,
    "bind(twice(), clock)", usize.ZERO) |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let shared = run providedRejects(&mut store, &mut request, &id, "shared", RejectionCode.InsufficientProviderAccess, text,
    "bind(advance(), clock)", usize.ZERO) |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let weak = run providedRejects(&mut store, &mut request, &id, "weak", RejectionCode.InsufficientProviderAccess, text,
    "bind(mixed(), clock)", usize.ZERO) |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(ambiguous && shared && weak,
    "ambiguity needs a selector, and a shared borrow never silently skips an exclusive candidate")
  let twoKeys = run providedRejects(&mut store, &mut request, &id, "twoKeys", RejectionCode.ProviderSelectorCardinality, text,
    "bind<Clock | Logger>(read(), clock)", usize.ZERO) |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let accessKey = run providedRejects(&mut store, &mut request, &id, "accessKey", RejectionCode.InvalidRequirement, text,
    "&Clock", 9) |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(twoKeys, "a selector names exactly one key")
  run Testing.expect(accessKey, "a selector cannot carry access")
  return ()
}

test effect fn intrinsicProvisionInfersOneKeyAndKeepsResidualRequirements() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("inferred-intrinsic-provision.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
service Clock {}
service Logger {}
role Primary
struct SystemClock {}
impl Clock for SystemClock {}
effect fn read() -> i32 ? &Clock | &Logger { return 42 }
effect fn only() -> i32 ? &Clock { return 42 }
effect fn advance() -> i32 ? &mut Clock { return 42 }
effect fn twice() -> i32 ? &Clock | &Clock at Primary { return 42 }
effect fn logged() -> i32 ? &Logger { return 42 }
effect fn shared(clock: &SystemClock) -> i32 ? &Logger { return run Intrinsic.bindRequirement(read(), clock) }
effect fn explicit(clock: &SystemClock) -> i32 ? &Logger { return run Intrinsic.bindRequirement<Clock>(read(), clock) }
effect fn tight(clock: &SystemClock) -> i32 { return run Intrinsic.bindRequirement(read(), clock) }
effect fn chosenRole(clock: &SystemClock) -> i32 ? &Clock { return run Intrinsic.bindRequirement<Clock at Primary>(twice(), clock) }
fn sharedClosed(clock: &SystemClock) -> i32 { return run Intrinsic.bindRequirement(only(), clock) }
fn exclusiveClosed(clock: &mut SystemClock) -> i32 { return run Intrinsic.bindRequirementMut(advance(), clock) }
fn ownedClosed(clock: SystemClock) -> i32 { return run Intrinsic.bindRequirementOwned(only(), move clock) }
effect fn ambiguous(ambiguousClock: &SystemClock) -> i32 ? &Clock { return run Intrinsic.bindRequirement(twice(), ambiguousClock) }
effect fn absent(absentClock: &SystemClock) -> i32 ? &Logger { return run Intrinsic.bindRequirement(logged(), absentClock) }
fn weak(weakClock: &SystemClock) -> i32 { return run Intrinsic.bindRequirement(advance(), weakClock) }
effect fn openRow<?R>(pending: once Effect<'static; i32 ? &Clock | R>, openClock: &SystemClock) -> i32 ? R {
  return run Intrinsic.bindRequirement(move pending, openClock)
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let shared = run providedSucceeds(&mut store, &mut request, &id, "shared") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let explicit = run providedSucceeds(&mut store, &mut request, &id, "explicit") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let chosenRole = run providedSucceeds(&mut store, &mut request, &id, "chosenRole") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let tight = run providedRejects(&mut store, &mut request, &id, "tight", RejectionCode.UnhandledRequirement,
    text, "run Intrinsic.bindRequirement(read(), clock)", usize.ONE) |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(shared && explicit && chosenRole && tight,
    "an inferred intrinsic selector removes exactly one key, as an explicit default or role selector does")
  let sharedMir = run Semantic.demandMir(&mut store, &mut request, &id, b"sharedClosed") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let exclusiveMir = run Semantic.demandMir(&mut store, &mut request, &id, b"exclusiveClosed") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let ownedMir = run Semantic.demandMir(&mut store, &mut request, &id, b"ownedClosed") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(succeeded(&sharedMir) && succeeded(&exclusiveMir) && succeeded(&ownedMir)
    && failureFact(&store, &sharedMir, 2) == usize.ZERO
    && failureFact(&store, &exclusiveMir, 2) == usize.ZERO
    && failureFact(&store, &ownedMir, 2) == usize.ZERO,
    "shared, exclusive and owned inferred keys survive specialized MIR preparation")
  let ambiguous = run providedRejects(&mut store, &mut request, &id, "ambiguous", RejectionCode.AmbiguousProvidedKey,
    text, "ambiguousClock", usize.ONE) |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let absent = run providedRejects(&mut store, &mut request, &id, "absent", RejectionCode.MissingProvidedKey,
    text, "absentClock", usize.ONE) |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let weak = run providedRejects(&mut store, &mut request, &id, "weak", RejectionCode.InsufficientProviderAccess,
    text, "weakClock", usize.ONE) |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let openRow = run providedRejects(&mut store, &mut request, &id, "openRow", RejectionCode.TypeArgumentInference,
    text, "openClock", usize.ONE) |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(ambiguous && absent && weak && openRow,
    "omitting an intrinsic selector preserves selection diagnostics and never guesses from an open row")
  return ()
}

fn lentRow(value: &Type) -> bool {
  if let Type.Nominal {arguments, ..} = &value.* {
    let listed = Vector<Argument>.asSlice(&arguments)
    let mut at = usize.ZERO
    while at < listed.length {
      if let Argument.Row {value: row} = &listed[at] {
        return Shared<Row>.with<bool>(&row, fn(found: &Row) -> bool { return Vector<Requirement>.length(&found.entries) == usize.ONE })
      }
      at = at + usize.ONE
    }
  }
  return false
}

// Whether two `Holder<...>` types carry equal rows.
effect fn sameHolderRow(left: &Option<Shared<Type>>, right: Option<Shared<Type>>) -> bool ! OutOfMemoryError ? &mut Allocator | &mut Types {
  if let Option<Shared<Type>>.Some {value: first} = &left.* {
    if let Option<Shared<Type>>.Some {value: second} = move right {
      let firstRow = Shared<Type>.with<Option<Shared<Row>>>(&first, holderRow)
      let secondRow = Shared<Type>.with<Option<Shared<Row>>>(&second, holderRow)
      if let Option<Shared<Row>>.Some {value: from} = move firstRow {
        if let Option<Shared<Row>>.Some {value: to} = move secondRow {
          return run Row.equalsShared(&from, &to)
        }
      }
    }
  }
  return false
}

test effect fn providedCallPrefixesMapLifetimesSeparately() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("provided-rows.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = providedRowsFixture(3)
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let clockHolder = run Semantic.demandSignature(&mut store, &mut request, &id, b"clockHolder") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let picked = run Semantic.demandBody(&mut store, &mut request, &id, b"picked") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let chosenRegion = bodyLocalType(&picked, 2)
  let pickedStatic = match move chosenRegion {
    Option<Shared<Type>>.Some {value} => Shared<Type>.with<bool>(&value, staticReference)
    Option<Shared<Type>>.None => false
  }
  run Testing.expect(pickedStatic, "a written lifetime binds the first lifetime binder, not the next binder position")
  let held = run providedSucceeds(&mut store, &mut request, &id, "held") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(held, "a lifetime written after a type still binds the leading lifetime binder")
  let suffixed = run providedRowsAfter(&mut store, &mut request, &id, "suffixed") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let suffixedSame = run sameHolderRow(&suffixed, slotOf(&clockHolder, usize.ZERO)) |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(suffixedSame, "a row argument takes the next ordinary binder past a leading lifetime")
  let overfull = run Semantic.demandBody(&mut store, &mut request, &id, b"overfull") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(ordinaryArity(&overfull, text, "hold<i32, i64>(value)", usize.ONE, 2),
    "an excess type argument reports the ordinary-namespace arity at the whole call")
  let lent = run providedRowsAfter(&mut store, &mut request, &id, "lent") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let lentKeyed = match move lent {
    Option<Shared<Type>>.Some {value} => Shared<Type>.with<bool>(&value, lentRow)
    Option<Shared<Type>>.None => false
  }
  run Testing.expect(lentKeyed, "a `? Row` suffix continues the ordinary namespace past a leading lifetime")
  let wrapped = run providedRejects(&mut store, &mut request, &id, "wrapped", RejectionCode.SectionResultInferenceUnavailable,
    text, "wrap", 2) |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let piped = run providedSucceeds(&mut store, &mut request, &id, "piped") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let shared = run Semantic.demandBody(&mut store, &mut request, &id, b"shared")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let promised = run providedSucceeds(&mut store, &mut request, &id, "promised") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(wrapped, "a result-only section binder is the named result-inference deferral")
  run Testing.expect(promised, "a function value takes a result-only binder from the closed contract its parameter promises")
  run Testing.expect(piped, "a provision section's omitted selector waits for the piped Effect's row")
  run Testing.expect(hasBorrowStatus(&shared, BorrowStatus.Checked), "the inferred Effect environment is proved against the local provider source")
  let declaredShared = run Semantic.demandBody(&mut store, &mut request, &id, b"declaredShared") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(hasBorrowStatus(&declaredShared, BorrowStatus.Checked),
    "the inferred Effect environment is proved against the provider's declared lifetime")
  return ()
}

test effect fn providedRunsAndWitnessesCheckResidualRows() -> ()
