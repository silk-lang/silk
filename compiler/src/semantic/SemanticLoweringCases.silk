test effect fn receiverAutoBorrowRetainsProjectedReference() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("receiver-place.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut store = run staticSemantic(
    &id,
    """
struct Counter {}
impl Counter { fn read(value: &Self) -> i32 { return 42 } }
fn reborrow(value: &mut Counter) -> i32 { return value.read() }
""",
    MachineTarget.forId(TargetId.X8664UnknownLinuxGnu),
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let body = run Semantic.demandBody(&mut store, &mut request, &id, b"reborrow")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let checked = Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(
    &body,
    checkedBody,
  )
  let mut retained = false
  if let Option<Shared<TypedBody>>.Some {value} = move checked {
    retained = Shared<TypedBody>.with<bool>(&value, fn(typed: &TypedBody) -> bool {
      return bodyCallsWithReceiverPass(typed, BodyReceiverPass.Shared) && bodyIsFullyChecked(typed)
    })
  }
  run Testing.expect(retained, "a mutable receiver passes a shared reborrow, which the borrow walk proves")
  let answer = run Semantic.demandMir(&mut store, &mut request, &id, b"reborrow")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let selected = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(&answer, selectedMirIndex)
  let mut projected = false
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(&store, index) {
      let blocks = Vector<MirBlock>.asSlice(&function.blocks)
      let mut at = usize.ZERO
      while at < blocks.length {
        let statements = Vector<MirStatement>.asSlice(&blocks[at].statements)
        let mut item = usize.ZERO
        while item < statements.length {
          if let MirStatement.Assign {value: MirRvalue.Ref {access, place}, ..} = &statements[item] {
            let projections = Vector<MirProjection>.asSlice(&place.projections)
            if access == Access.Shared && projections.length == usize.ONE {
              projected = projected || mirProjectionIsDeref(&projections[usize.ZERO])
            }
          }
          item = item + usize.ONE
        }
        at = at + usize.ONE
      }
    }
  }
  run Testing.expect(projected, "receiver adaptation borrows the referent through one dereference")
  return ()
}

fn receiverRegionBelongsTo(lifetime: &Lifetime, caller: &DeclarationId) -> bool {
  return match &lifetime.* {
    Lifetime.Parameter {declaration, ..} => DeclarationId.equals(&declaration, caller)
    Lifetime.Local {declaration, ..} => DeclarationId.equals(&declaration, caller)
    _ => false
  }
}

fn receiverApplicationMatchesRegions(value: &SpecializationApplication, declaration: &DeclarationId,
  inputs: &[BodyNodeId], nodes: &[BodyNode], caller: &DeclarationId) -> bool {
  let given = Vector<Argument>.asSlice(&value.arguments)
  let ordinals = Vector<usize>.asSlice(&value.argumentOrdinals)
  if !DeclarationId.equals(SpecializationApplication.bodyDeclaration(value), declaration)
    || given.length != inputs.length || ordinals.length != inputs.length
    || Vector<ScopeBinding>.length(&value.scopes) != usize.ZERO { return false }
  let mut index = usize.ZERO
  while index < inputs.length {
    if ordinals[index] != index || inputs[index].index >= nodes.length { return false }
    let region = match &given[index] {
      Argument.Lifetime {value: lifetime} => Shared<Lifetime>.clone(&lifetime)
      _ => { return false }
    }
    let callerOwned = Shared<Lifetime>.with<bool>(&region, fn(lifetime: &Lifetime) -> bool {
      return receiverRegionBelongsTo(lifetime, caller)
    })
    if !callerOwned { return false }
    if let BodyNodeKind.Expression {ty, ..} = &nodes[inputs[index].index].kind {
      let actual = Shared<Type>.with<Option<Shared<Lifetime>>>(&ty, receiverReferenceRegion)
      if let Option<Shared<Lifetime>>.Some {value: lifetime} = move actual {
        if !Lifetime.equalsShared(&region, &lifetime) { return false }
      } else { return false }
    } else { return false }
    index = index + usize.ONE
  }
  return true
}

fn receiverCallNode(body: &TypedBody) -> Option<BodyNodeId> {
  let nodes = TypedBody.nodeSlice(body)
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {form: BodyExpression.DirectCall {receiverPass, ..}, ..} = &nodes[at].kind {
      if let Option<BodyReceiverPass>.Some {..} = &receiverPass {
        return Option<BodyNodeId>.some(BodyNodeId {index: at})
      }
    }
    at = at + usize.ONE
  }
  return Option<BodyNodeId>.none()
}

fn genericInherentApplication(value: &SpecializationApplication, owner: &[u8], ownType: &[u8]) -> bool {
  if !DeclarationId.named(SpecializationApplication.bodyDeclaration(value), b"choose") {
    return false
  }
  let ownArguments = Vector<Argument>.asSlice(&value.arguments)
  let ownOrdinals = Vector<usize>.asSlice(&value.argumentOrdinals)
  let scopes = Vector<ScopeBinding>.asSlice(&value.scopes)
  if ownArguments.length != usize.ONE || ownOrdinals.length != usize.ONE || ownOrdinals[usize.ZERO] != usize.ZERO || !applicationArgumentIs(
    &ownArguments[usize.ZERO],
    ownType,
  ) || scopes.length != usize.ONE {
    return false
  }
  let scoped = Vector<Argument>.asSlice(&scopes[usize.ZERO].arguments)
  let scopedOrdinals = Vector<usize>.asSlice(&scopes[usize.ZERO].argumentOrdinals)
  return scoped.length == usize.ONE && scopedOrdinals.length == usize.ONE && scopedOrdinals[usize.ZERO] == usize.ZERO && applicationArgumentIs(
    &scoped[usize.ZERO],
    owner,
  )
}

fn genericReceiverApplication(value: &SpecializationApplication, owner: &[u8]) -> bool {
  if !DeclarationId.named(SpecializationApplication.bodyDeclaration(value), b"take") || Vector<
    Argument,
  >.length(&value.arguments) != usize.ZERO || Vector<usize>.length(&value.argumentOrdinals) != usize.ZERO {
    return false
  }
  let scopes = Vector<ScopeBinding>.asSlice(&value.scopes)
  if scopes.length != usize.ONE {
    return false
  }
  let scoped = Vector<Argument>.asSlice(&scopes[usize.ZERO].arguments)
  let ordinals = Vector<usize>.asSlice(&scopes[usize.ZERO].argumentOrdinals)
  return scoped.length == usize.ONE && ordinals.length == usize.ONE && ordinals[usize.ZERO] == usize.ZERO && applicationArgumentIs(
    &scoped[usize.ZERO],
    owner,
  )
}

test effect fn genericInherentMembersPublishCompleteApplications() -> ()
! CanonicalizationFailure | InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("generic-inherent-members.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let source = """
struct Box<T> { value: T }
impl<T> Box<T> {
  fn choose<U>(left: T, right: U) -> T { drop right return move left }
}
fn calls() -> i32 {
  let prefixed = Box.choose(42, true)
  let applied = Box<i32>.choose<bool>(42, true)
  let distinct = Box.choose(true, 42)
  return 0
}
"""
  let mut store = run staticSemantic(
    &id,
    source,
    MachineTarget.forId(TargetId.X8664UnknownLinuxGnu),
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let calls = run Semantic.demandBody(&mut store, &mut request, &id, b"calls")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    succeeded(&calls),
    "generic inherent associated calls check from ordinary source",
  )
  let prefixApplication = run directApplicationAt(&calls, usize.ZERO)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let appliedApplication = run directApplicationAt(&calls, usize.ONE)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let distinctApplication = run directApplicationAt(&calls, 2)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut canonical = false
  let mut separated = false
  if let Option<SpecializationApplication>.Some {value: prefix} = move prefixApplication {
    if let Option<SpecializationApplication>.Some {value: fixed} = move appliedApplication {
      if let Option<SpecializationApplication>.Some {value: other} = move distinctApplication {
        let prefixCopy = run SpecializationApplication.copy(&prefix)
          |> Effect.provideMut<Allocator>(&mut allocator)
        let fixedCopy = run SpecializationApplication.copy(&fixed)
          |> Effect.provideMut<Allocator>(&mut allocator)
        let otherCopy = run SpecializationApplication.copy(&other)
          |> Effect.provideMut<Allocator>(&mut allocator)
        let prefixKeyResult = run InstanceKey.function(move prefixCopy)
          |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
        let prefixKey = run requiredCanonicalKey(move prefixKeyResult)
        let fixedKeyResult = run InstanceKey.function(move fixedCopy)
          |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
        let fixedKey = run requiredCanonicalKey(move fixedKeyResult)
        let otherKeyResult = run InstanceKey.function(move otherCopy)
          |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
        let otherKey = run requiredCanonicalKey(move otherKeyResult)
        let prefixSymbol = run InstanceKey.runtimeName(&prefixKey)
          |> Effect.provideMut<Allocator>(&mut allocator)
        let fixedSymbol = run InstanceKey.runtimeName(&fixedKey)
          |> Effect.provideMut<Allocator>(&mut allocator)
        let otherSymbol = run InstanceKey.runtimeName(&otherKey)
          |> Effect.provideMut<Allocator>(&mut allocator)
        let sameApplication = run SpecializationApplication.equals(&prefix, &fixed)
          |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
        canonical = genericInherentApplication(&prefix, b"i32", b"bool") && genericInherentApplication(
          &fixed,
          b"i32",
          b"bool",
        ) && sameApplication && InstanceKey.sameRuntimeBase(&prefixKey, &fixedKey) && sameBytes(
          Bytes.asSlice(&prefixSymbol),
          Bytes.asSlice(&fixedSymbol),
        )
        separated = genericInherentApplication(&other, b"bool", b"i32") && !InstanceKey.sameRuntimeBase(
          &prefixKey,
          &otherKey,
        ) && !sameBytes(Bytes.asSlice(&prefixSymbol), Bytes.asSlice(&otherSymbol))
      }
    }
  }
  run Testing.expect(
    canonical,
    "prefix and applied-owner syntax publish the same owner scope, member arguments, family key and name",
  )
  run Testing.expect(
    separated,
    "a different complete generic owner publishes a distinct inherent-member family key and name",
  )
  return ()
}

test effect fn ownerApplicationInfersOmittedLifetimes() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("owner-omitted-lifetimes.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let source = """
struct Lent<'a, T> { value: &'a T }
impl<'a, T> Lent<'a, T> {
  fn read(lent: &Lent<'a, T>) -> &'a T { return lent.value }
  fn pick<U>(lent: &Lent<'a, T>, other: U) -> &'a T { drop other return lent.value }
}
struct Holder<T> { held: T }
impl<T> Holder<T> { fn wrap(held: T) -> Holder<T> { return Holder {held: move held} } }
fn calls<'r>(lent: &Lent<'r, i32>, value: &'r i32) -> i32 {
  let read = Lent<i32>.read(lent)
  let picked = Lent<i32>.pick<bool>(lent, true)
  let held = Holder<&i32>.wrap(value)
  return 0
}
fn readPrefix<'r>(lent: &Lent<'r, i32>) -> &'r i32 { return Lent.read<i32>(lent) }
fn pickPrefix<'r>(lent: &Lent<'r, i32>) -> &'r i32 { return Lent.pick<i32, bool>(lent, true) }
fn pickOwn<'r>(lent: &Lent<'r, i32>) -> &'r i32 { return Lent.pick<bool>(lent, true) }
fn wrapPrefix(value: &i32) -> Holder<&i32> { return Holder.wrap<&i32>(value) }
"""
  let mut store = run staticSemantic(&id, source, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu)) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let calls = run Semantic.demandBody(&mut store, &mut request, &id, b"calls") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(succeeded(&calls), "an owner application that omits lifetimes infers them from the call")
  let mut at = usize.ZERO
  while at < 3 {
    let mut published = false
    if let Option<SpecializationApplication>.Some {..} = move run directApplicationAt(&calls, at) |> Effect.provideMut<Allocator>(&mut allocator) {
      published = true
    }
    run Testing.expect(published, "each owner-applied call publishes its application")
    at = at + usize.ONE
  }
  let readPrefix = run Semantic.demandBody(&mut store, &mut request, &id, b"readPrefix") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsSpan(&readPrefix, RejectionCode.OwnerArgumentPlacement, source, "<i32>", 2),
    "a member list after an unwritten owner whose parameters the member uses is misplaced (GEN-008)")
  let pickPrefix = run Semantic.demandBody(&mut store, &mut request, &id, b"pickPrefix") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsSpan(&pickPrefix, RejectionCode.OwnerArgumentPlacement, source, "<i32, bool>", usize.ZERO),
    "a member list after an unwritten owner whose parameters the member uses is misplaced (GEN-008)")
  let pickOwn = run Semantic.demandBody(&mut store, &mut request, &id, b"pickOwn") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsSpan(&pickOwn, RejectionCode.OwnerArgumentPlacement, source, "<bool>", usize.ONE),
    "a member list after an unwritten owner whose parameters the member uses is misplaced (GEN-008)")
  let wrapPrefix = run Semantic.demandBody(&mut store, &mut request, &id, b"wrapPrefix") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsSpan(&wrapPrefix, RejectionCode.OwnerArgumentPlacement, source, "<&i32>", 2),
    "a member list after an unwritten owner whose parameters the member uses is misplaced (GEN-008)")
  return ()
}

test effect fn ownerApplicationSectionsTakeImplBindersFromTheApplication() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("owner-application-sections.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let source = """
struct Holder<T> { value: T }
impl<T> Holder<T> { fn get(self: &Holder<T>, at: i32) -> &T { drop at return &self.value } }
fn kind(value: &i32) -> i32 { return value.* }
fn calls(held: &Holder<i32>) -> i32 {
  let opened = held |> Holder<i32>.get(0) |> kind
  let applied = held |> Holder<i32>.get(0) |> kind
  return opened + applied
}
"""
  let mut store = run staticSemantic(&id, source, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu)) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let calls = run Semantic.demandBody(&mut store, &mut request, &id, b"calls") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(succeeded(&calls), "a section of an applied-owner member takes its impl binders from the application")
  return ()
}

test effect fn genericInherentReceiverPublishesCompleteOwner() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("generic-inherent-receiver.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let source = """
struct Box<T> { value: T }
impl<T> Box<T> { fn take(self: Self) -> T { return move self.value } }
fn calls(value: Box<i32>) -> i32 { return value.take() }
"""
  let mut store = run staticSemantic(&id, source, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu)) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let calls = run Semantic.demandBody(&mut store, &mut request, &id, b"calls") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(succeeded(&calls), "generic inherent receiver calls check from ordinary source")
  let application = run directApplicationAt(&calls, usize.ZERO) |> Effect.provideMut<Allocator>(&mut allocator)
  let complete = match move application {
    Option<SpecializationApplication>.Some {value} => genericReceiverApplication(&value, b"i32")
    Option<SpecializationApplication>.None => false
  }
  run Testing.expect(complete, "a direct receiver call retains the complete generic owner in its application scope")
  return ()
}

fn receiverApplicationMatchesBody(
  body: &TypedBody,
  application: &SpecializationApplication,
  node: BodyNodeId,
) -> bool {
  let nodes = TypedBody.nodeSlice(body)
  if node.index < nodes.length {
    if let BodyNodeKind.Expression {form: BodyExpression.DirectCall {declaration, arguments, ..}, ..} = &nodes[node.index].kind {
      let inputs = Vector<BodyNodeId>.asSlice(&arguments)
      let caller = TypedBody.declarationId(body)
      return receiverApplicationMatchesRegions(application, &declaration, inputs, nodes, caller)
    }
  }
  return false
}

effect fn receiverApplicationRetainsArgumentRegions(body: &Shared<TypedBody>) -> bool
! OutOfMemoryError ? &mut Allocator {
  let selected = Shared<TypedBody>.with<Option<BodyNodeId>>(body, receiverCallNode)
  if let Option<BodyNodeId>.Some {value: node} = move selected {
    let found = TypedBody.directApplication(body, node)
    if let Option<Shared<SpecializationApplication>>.Some {value} = move found {
      let application = run SpecializationApplication.copyShared(&value)
      return Shared<TypedBody>.with<bool>(body, fn(checked: &TypedBody) -> bool {
        return receiverApplicationMatchesBody(checked, &application, node)
      })
    }
  }
  return false
}

test effect fn receiverArgumentsInferCallerReferenceLifetimes() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("receiver-argument-region.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut store = run staticSemantic(
    &id,
    """
struct Counter {}
impl Counter {
  fn inspect(value: &Self, other: &i32) -> i32 { return other.* }
}
fn forward(value: Counter, other: &i32) -> i32 {
  return value.inspect(other)
}
fn reborrow(value: Counter, other: &i32) -> i32 {
  return value.inspect(&other)
}
struct Plan<'a> { bytes: &'a [u8] }
fn begin(plan: &mut Plan) -> bool { return true }
fn peek(plan: &Plan) -> bool { return true }
fn nominal(plan: Plan) -> bool {
  let mut held = move plan
  return begin(&mut held) && peek(&held)
}
""",
    MachineTarget.forId(TargetId.X8664UnknownLinuxGnu),
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let forwarded = run Semantic.demandBody(&mut store, &mut request, &id, b"forward")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let borrowed = run Semantic.demandBody(&mut store, &mut request, &id, b"reborrow")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    Shared<Result<Answer, NoRejection>>.with<bool>(&forwarded, bodyAnswerIsTyped)
      && Shared<Result<Answer, NoRejection>>.with<bool>(&borrowed, bodyAnswerIsTyped),
    "non-receiver reference arguments infer caller lifetimes and explicit reborrows",
  )
  let nominal = run Semantic.demandBody(&mut store, &mut request, &id, b"nominal")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(Shared<Result<Answer, NoRejection>>.with<bool>(&nominal, bodyAnswerIsTyped),
    "a loan of a nominal infers its elided lifetime argument from the place under & and &mut")
  let forwardedBody = Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(&forwarded, checkedBody)
  let borrowedBody = Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(&borrowed, checkedBody)
  let retainedForwarded = match move forwardedBody {
    Option<Shared<TypedBody>>.Some {value} => run receiverApplicationRetainsArgumentRegions(&value)
      |> Effect.provideMut<Allocator>(&mut allocator)
    _ => false
  }
  let retainedBorrowed = match move borrowedBody {
    Option<Shared<TypedBody>>.Some {value} => run receiverApplicationRetainsArgumentRegions(&value)
      |> Effect.provideMut<Allocator>(&mut allocator)
    _ => false
  }
  run Testing.expect(retainedForwarded && retainedBorrowed,
    "published receiver applications retain each actual caller region in original method slot order")
  return ()
}

test effect fn sharedLoanParametersShortenOnlyMatchingAccess() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("covariant-loan-shortening.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
struct H<'v> { s: &'v [u8] }
impl<'v> Intrinsic.Copy for H<'v> {}
struct Hs<'v> { e: &'v [H<'v>] }
impl<'v> Hs<'v> {
  fn make(e: &'v [H<'v>]) -> i32 { return 1 }
  fn edit(e: &'v mut [H<'v>]) -> i32 { return 1 }
}
fn shared<'v>(a: H<'v>, b: H<'v>) -> i32 { let es: [H<'v>; 2] = [a, b] return Hs.make(&es) }
fn exclusive<'v>(a: H<'v>, b: H<'v>) -> i32 { let mut es: [H<'v>; 2] = [a, b] return Hs.edit(&mut es) }
struct C<'v> { slot: &'v mut &'v [u8] }
fn cells<'v>(items: &'v [C<'v>]) -> i32 { return 1 }
fn invariant<'a, 'v>(items: &'a [C<'v>]) -> i32 { return cells(items) }
struct P<'v, 'w> { a: &'v [u8], b: &'w [u8] }
impl<'v, 'w> Intrinsic.Copy for P<'v, 'w> {}
fn keep<'v, 'w>(pairs: &'v [P<'v, 'w>]) -> &'w [u8] { return pairs[0].b }
fn pair<'a, 'b>(x: P<'a, 'b>) -> &'b [u8] { let ps: [P<'a, 'b>; 1] = [x] return keep(&ps) }
struct S { n: i32 }
fn reads(value: &S) -> i32 { return value.n }
fn view<T>(value: &T) -> i32 { return 1 }
fn writes(value: &mut S) -> i32 { return 1 }
fn given(owner: &mut S) -> i32 { return reads(move owner) }
fn givenGeneric(owner: &mut S) -> i32 { return view(move owner) }
fn strengthened(owner: &S) -> i32 { return writes(owner) }
fn bound(owner: &mut S) -> i32 { let held: &S = move owner return held.n }
fn named<'a>(owner: &'a mut S) -> i32 { let held: &'a S = move owner return held.n }
fn nested<'a>(slot: &'a mut &'a mut S) -> i32 { let inner: &'a mut &'a S = move slot return 1 }
fn reborrowed(owner: &mut S) -> i32 { return reads(&owner.*) }
fn reborrowedBinding(owner: &mut S) -> i32 { let held: &S = &owner.* return held.n }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let shared = run Semantic.demandBody(&mut store, &mut request, &id, b"shared") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let exclusive = run Semantic.demandBody(&mut store, &mut request, &id, b"exclusive") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(Shared<Result<Answer, NoRejection>>.with<bool>(&shared, bodyAnswerIsTyped),
    "a shared loan shortens a covariant nominal lifetime argument to the loan region")
  run Testing.expect(rejectsSpan(&exclusive, RejectionCode.TypeMismatch, text, "Hs.edit(&mut es)", usize.ZERO),
    "an exclusive loan keeps its referent's lifetime arguments invariant")
  let invariant = run Semantic.demandBody(&mut store, &mut request, &id, b"invariant") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let pair = run Semantic.demandBody(&mut store, &mut request, &id, b"pair") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsSpan(&invariant, RejectionCode.TypeMismatch, text, "cells(items)", usize.ZERO),
    "a lifetime under an exclusive field referent keeps the nominal invariant behind a shared loan")
  run Testing.expect(Shared<Result<Answer, NoRejection>>.with<bool>(&pair, bodyAnswerIsTyped),
    "only lifetimes the parameter writes as its loan lifetime shorten; others keep their evidence")
  let given = run Semantic.demandBody(&mut store, &mut request, &id, b"given") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let givenGeneric = run Semantic.demandBody(&mut store, &mut request, &id, b"givenGeneric") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let strengthened = run Semantic.demandBody(&mut store, &mut request, &id, b"strengthened") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsSpan(&given, RejectionCode.TypeMismatch, text, "reads(move owner)", usize.ZERO)
      && rejectsSpan(&givenGeneric, RejectionCode.TypeMismatch, text, "view(move owner)", usize.ZERO),
    "a moved exclusive loan cannot satisfy a shared parameter")
  run Testing.expect(rejectsSpan(&strengthened, RejectionCode.TypeMismatch, text, "writes(owner)", usize.ZERO),
    "a shared loan never strengthens to an exclusive parameter")
  let bound = run Semantic.demandBody(&mut store, &mut request, &id, b"bound") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let named = run Semantic.demandBody(&mut store, &mut request, &id, b"named") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let nested = run Semantic.demandBody(&mut store, &mut request, &id, b"nested") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsSpan(&bound, RejectionCode.AssignmentTypeMismatch, text, "move owner", 2)
      && rejectsSpan(&named, RejectionCode.AssignmentTypeMismatch, text, "move owner", 3),
    "shared binding annotations keep the initializer's exclusive access")
  run Testing.expect(rejectsSpan(&nested, RejectionCode.AssignmentTypeMismatch, text, "move slot", usize.ZERO),
    "an exclusive loan under an exclusive referent is never given up")
  let reborrowed = run Semantic.demandBody(&mut store, &mut request, &id, b"reborrowed") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let reborrowedBinding = run Semantic.demandBody(&mut store, &mut request, &id, b"reborrowedBinding") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(Shared<Result<Answer, NoRejection>>.with<bool>(&reborrowed, bodyAnswerIsTyped)
      && Shared<Result<Answer, NoRejection>>.with<bool>(&reborrowedBinding, bodyAnswerIsTyped),
    "a source-written shared reborrow satisfies calls and binding annotations")
  return ()
}

test effect fn recordAndSliceIndexProjectionsRetainPlaces() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("projection-gap.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
struct Pair { value: i32 }
fn field(pair: &Pair) -> i32 { return pair.value }
fn index(values: &[i32]) -> i32 { return values[0] }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let field = run Semantic.demandMir(&mut store, &mut request, &id, b"field")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let index = run Semantic.demandMir(&mut store, &mut request, &id, b"index")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let selected = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(&field, selectedMirIndex)
  let mut projected = false
  if let Option<usize>.Some {value} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(&store, value) {
      let blocks = Vector<MirBlock>.asSlice(&function.blocks)
      let mut blockAt = usize.ZERO
      while blockAt < blocks.length {
        let statements = Vector<MirStatement>.asSlice(&blocks[blockAt].statements)
        let mut at = usize.ZERO
        while at < statements.length {
          if let MirStatement.Assign {value: MirRvalue.Use {value: MirOperand.Copy {place}}, ..} = &statements[at] {
            let projections = Vector<MirProjection>.asSlice(&place.projections)
            if projections.length == 2 {
              if mirProjectionIsDeref(&projections[usize.ZERO]) {
                if let MirProjection.Field {index: ordinal} = &projections[usize.ONE] {
                  projected = ordinal == usize.ZERO
                }
              }
            }
          }
          at = at + usize.ONE
        }
        blockAt = blockAt + usize.ONE
      }
    }
  }
  let selectedIndex = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(&index, selectedMirIndex)
  let mut checkedIndex = false
  if let Option<usize>.Some {value: ordinal} = move selectedIndex {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(&store, ordinal) {
      let blocks = Vector<MirBlock>.asSlice(&function.blocks)
      let mut blockAt = usize.ZERO
      while blockAt < blocks.length {
        if let MirTerminator.Branch {thenBlock, elseBlock, ..} = &blocks[blockAt].terminator {
          if let MirTerminator.Trap {..} = &blocks[elseBlock].terminator {
            let statements = Vector<MirStatement>.asSlice(&blocks[blockAt].statements)
            let mut statementAt = usize.ZERO
            let mut runtimeLength = false
            while statementAt < statements.length {
              if let MirStatement.Assign {value: MirRvalue.SliceLength {..}, ..} = &statements[statementAt] { runtimeLength = true }
              statementAt = statementAt + usize.ONE
            }
            let safeStatements = Vector<MirStatement>.asSlice(&blocks[thenBlock].statements)
            let mut safeAt = usize.ZERO
            while safeAt < safeStatements.length {
              if let MirStatement.Assign {value: MirRvalue.Use {value: MirOperand.Copy {place}}, ..} = &safeStatements[safeAt] {
                let projections = Vector<MirProjection>.asSlice(&place.projections)
                if projections.length == usize.ONE {
                  if let MirProjection.Index {..} = &projections[usize.ZERO] { checkedIndex = checkedIndex || runtimeLength }
                }
              }
              safeAt = safeAt + usize.ONE
            }
          }
        }
        blockAt = blockAt + usize.ONE
      }
    }
  }
  run Testing.expect(projected, "a borrowed nominal field lowers as Deref followed by Field zero")
  run Testing.expect(checkedIndex, "slice indexing reads runtime length and reaches its element projection only through the bounds-success block")
  return ()
}

test effect fn unsafePrefixAcknowledgesOnlySelectedCall() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("unsafe-prefix.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
unsafe fn inner() -> i32 { return 42 }
unsafe fn outer(value: i32) -> i32 { return value }
fn safe() -> i32 { return 42 }
struct Counter {}
impl Counter { unsafe fn marked(value: &Self) -> i32 { return 42 } }
unsafe fn receiverSource(value: Counter) -> Counter { return move value }
fn nested() -> i32 { return unsafe outer(inner()) }
fn acknowledged() -> i32 { return unsafe outer(unsafe inner()) }
fn block() -> i32 { unsafe { return outer(inner()) } }
fn literal() -> i32 { return unsafe 42 }
fn pointer(value: *const i32) -> i32 { return unsafe value.* }
fn redundant() -> i32 { return unsafe safe() }
fn receiver(value: Counter) -> i32 { return unsafe receiverSource(move value).marked() }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let nested = run Semantic.demandBody(&mut store, &mut request, &id, b"nested")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    rejectsFrom(&nested, RejectionCode.UnsafeAcknowledgement, offsetOf(text, "inner())", 0)),
    "an outer unsafe prefix does not acknowledge its argument call",
  )
  let acknowledged = run Semantic.demandMir(&mut store, &mut request, &id, b"acknowledged")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let block = run Semantic.demandMir(&mut store, &mut request, &id, b"block")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let explicitMir = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(
    &acknowledged,
    selectedMirIndex,
  )
  let blockMir = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(&block, selectedMirIndex)
  let mut permitted = false
  if let Option<usize>.Some {..} = &explicitMir {
    if let Option<usize>.Some {..} = &blockMir {
      permitted = true
    }
  }
  run Testing.expect(permitted, "nested prefixes and a lexical unsafe block each authorize calls")
  let literal = run Semantic.demandBody(&mut store, &mut request, &id, b"literal")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let pointer = run Semantic.demandBody(&mut store, &mut request, &id, b"pointer")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    rejectsFrom(&literal, RejectionCode.UnsafeInvocation, offsetOf(text, "unsafe 42", 0)) && rejectsFrom(
      &pointer,
      RejectionCode.UnsafeInvocation,
      offsetOf(text, "unsafe value.*", 0),
    ),
    "an unsafe prefix rejects non-call operands including raw dereference",
  )
  let redundant = run Semantic.demandBody(&mut store, &mut request, &id, b"redundant")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    rejectsFrom(&redundant, RejectionCode.UnsafeInvocation, offsetOf(text, "safe()", 1)),
    "a safe call has no obligation for a prefix to acknowledge",
  )
  let receiver = run Semantic.demandBody(&mut store, &mut request, &id, b"receiver")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    rejectsFrom(
      &receiver,
      RejectionCode.UnsafeAcknowledgement,
      offsetOf(text, "receiverSource(move value).marked()", 0),
    ),
    "a prefix on the receiver operation does not acknowledge its receiver call",
  )
  return ()
}

test effect fn pointerAlignmentUsesNeutralFactsAndDeclaredGuarantees() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("pointer-alignment.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let target = MachineTarget.forId(TargetId.X8664UnknownLinuxGnu)
  let text = """
fn probe(aligned: *const i32, unaligned: *const align(1) i32) -> i32 {
  unsafe { return aligned.* + unaligned.* }
}
struct PointerHolder { pointer: ?[*]mut i32 }
impl PointerHolder { fn raw(self: &Self) -> ?[*]mut i32 { return self.pointer } }
fn inspect<T>(pointer: ?[*]const T) -> i32 { return 42 }
fn inspectI32(pointer: ?[*]const i32) -> i32 { return 42 }
fn inspectMut(pointer: ?[*]mut i32) -> i32 { return 42 }
fn inspectNonNull(pointer: [*]const i32) -> i32 { return 42 }
fn inspectNested(pointer: ?[*]const (*const i32)) -> i32 { return 42 }
fn weaken(pointer: ?[*]mut i32) -> i32 { return inspect(pointer) }
fn weakenReturn(pointer: ?[*]mut i32) -> ?[*]const i32 { return pointer }
fn weakenLocal(pointer: ?[*]mut i32) -> i32 { let held: ?[*]const i32 = pointer return inspectI32(held) }
fn fieldReturn(holder: PointerHolder) -> ?[*]const i32 { return holder.pointer }
fn fieldLocal(holder: PointerHolder) -> i32 { let held: ?[*]const i32 = holder.pointer return inspectI32(held) }
fn fieldCall(holder: PointerHolder) -> i32 { return inspectI32(holder.pointer) }
fn receiverResult(holder: PointerHolder) -> ?[*]const i32 { return holder.raw() }
fn reverseAccess(reversePointer: ?[*]const i32) -> i32 { return inspectMut(reversePointer) }
fn wrongPointee(wrongValue: ?[*]mut bool) -> i32 { return inspectI32(wrongValue) }
fn wrongExtent(singlePointer: ?*mut i32) -> i32 { return inspectI32(singlePointer) }
fn wrongNullability(nullablePointer: ?[*]mut i32) -> i32 { return inspectNonNull(nullablePointer) }
fn wrongAlignment(unalignedPointer: ?[*]mut align(1) i32) -> i32 { return inspectI32(unalignedPointer) }
fn wrongNested(nestedPointer: ?[*]mut (*mut i32)) -> i32 { return inspectNested(nestedPointer) }
fn inspectUnaligned(pointer: *const align(1) i32) -> i32 { return 42 }
fn inspectTwo(pointer: *const align(2) i32) -> i32 { return 42 }
fn weakenNatural(naturalPointer: *mut i32) -> i32 { return inspectUnaligned(naturalPointer) }
fn weakenWritten(writtenPointer: *mut align(4) i32) -> i32 { return inspectTwo(writtenPointer) }
fn naturalToTwo(naturalTwo: *const i32) -> i32 { return inspectTwo(naturalTwo) }
"""
  let mut store = run staticSemantic(&id, text, target)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let checked = run Semantic.demandMir(&mut store, &mut request, &id, b"probe")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let selected = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(&checked, selectedMirIndex)
  let mut aligned = false
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(&store, index) {
      let locals = Vector<MirLocal>.asSlice(&function.locals)
      let mut layouts = Vector<TypeLayout>.make()
      let mut at = usize.ZERO
      while at < locals.length {
        if let Option<BackendLayout>.Some {value: facts} = move BackendLayout.scalar(
          &locals[at].ty,
          &target,
        ) {
          let layout = run Shared<BackendLayout>.make(move facts)
            |> Effect.provideMut<Allocator>(&mut allocator)
          run Vector<TypeLayout>.append(
            &mut layouts,
            TypeLayout {ty: Shared<Type>.clone(&locals[at].ty), layout: move layout},
          )
            |> Effect.provideMut<Allocator>(&mut allocator)
        }
        at = at + usize.ONE
      }
      let foreign = Vector<CAbi.Signature>.make()
      let emitted = run Effect.result(
        emitClosedMir(function, &target, Vector<TypeLayout>.asSlice(&layouts), Vector<CAbi.Signature>.asSlice(&foreign)),
      )
        |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
      match move emitted {
        Result<Bytes, BackendGap | OutOfMemoryError>.Success {value: llvmText} => {
          let ir = Bytes.asSlice(&llvmText)
          aligned = containsIr(ir, b"alloca i32, align 4") && containsIr(ir, b"alloca ptr, align 8") && containsIrLine(
            ir,
            b"load i32, ptr",
            b", align 4",
          ) && containsIrLine(ir, b"load i32, ptr", b", align 1")
        }
        _ => ()
      }
    }
  }
  run Testing.expect(
    aligned,
    "local alignment uses neutral facts and explicit raw align(1) is preserved",
  )
  let weakened = run Semantic.demandBody(&mut store, &mut request, &id, b"weaken") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let returned = run Semantic.demandBody(&mut store, &mut request, &id, b"weakenReturn") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let initialized = run Semantic.demandBody(&mut store, &mut request, &id, b"weakenLocal") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let fieldReturn = run Semantic.demandBody(&mut store, &mut request, &id, b"fieldReturn") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let fieldLocal = run Semantic.demandBody(&mut store, &mut request, &id, b"fieldLocal") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let fieldCall = run Semantic.demandBody(&mut store, &mut request, &id, b"fieldCall") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let receiverResult = run Semantic.demandBody(&mut store, &mut request, &id, b"receiverResult") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(Shared<Result<Answer, NoRejection>>.with<bool>(&weakened, bodyRetainsPointerWeaken)
    && Shared<Result<Answer, NoRejection>>.with<bool>(&returned, bodyRetainsPointerWeaken)
    && Shared<Result<Answer, NoRejection>>.with<bool>(&initialized, bodyRetainsPointerWeaken)
    && Shared<Result<Answer, NoRejection>>.with<bool>(&fieldReturn, bodyRetainsPointerWeaken)
    && Shared<Result<Answer, NoRejection>>.with<bool>(&fieldLocal, bodyRetainsPointerWeaken)
    && Shared<Result<Answer, NoRejection>>.with<bool>(&fieldCall, bodyRetainsPointerWeaken)
    && Shared<Result<Answer, NoRejection>>.with<bool>(&receiverResult, bodyRetainsPointerWeaken),
    "immediate pointer boundaries retain mutable identifiers, fields and selected results below shared access")
  let natural = run Semantic.demandBody(&mut store, &mut request, &id, b"weakenNatural") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let written = run Semantic.demandBody(&mut store, &mut request, &id, b"weakenWritten") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let naturalTwo = run Semantic.demandBody(&mut store, &mut request, &id, b"naturalToTwo") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(Shared<Result<Answer, NoRejection>>.with<bool>(&natural, bodyRetainsPointerWeaken)
    && Shared<Result<Answer, NoRejection>>.with<bool>(&written, bodyRetainsPointerWeaken),
    "any alignment weakens to align(1) and a written alignment weakens to a smaller written one")
  run Testing.expect(rejectsSpan(&naturalTwo, RejectionCode.TypeMismatch, text, "naturalTwo", usize.ONE),
    "natural alignment is not compared numerically against a written alignment above one")
  let reverse = run Semantic.demandBody(&mut store, &mut request, &id, b"reverseAccess") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let pointee = run Semantic.demandBody(&mut store, &mut request, &id, b"wrongPointee") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let extent = run Semantic.demandBody(&mut store, &mut request, &id, b"wrongExtent") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let nullability = run Semantic.demandBody(&mut store, &mut request, &id, b"wrongNullability") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let alignment = run Semantic.demandBody(&mut store, &mut request, &id, b"wrongAlignment") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let nested = run Semantic.demandBody(&mut store, &mut request, &id, b"wrongNested") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsSpan(&reverse, RejectionCode.TypeMismatch, text, "reversePointer", usize.ONE)
    && rejectsSpan(&pointee, RejectionCode.TypeMismatch, text, "wrongValue", usize.ONE)
    && rejectsSpan(&extent, RejectionCode.TypeMismatch, text, "singlePointer", usize.ONE)
    && rejectsSpan(&nullability, RejectionCode.TypeMismatch, text, "nullablePointer", usize.ONE)
    && rejectsSpan(&alignment, RejectionCode.TypeMismatch, text, "unalignedPointer", usize.ONE)
    && rejectsSpan(&nested, RejectionCode.TypeMismatch, text, "nestedPointer", usize.ONE),
    "pointer access weakening preserves pointee, extent, nullability and alignment and cannot reverse")
  return ()
}

test effect fn importedNominalQualifiersUseInherentQueries() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let entry = run module("qualified-calls.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let library = run module("actor.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
    import actor { Counter as Imported }
    import actor
    fn works() -> i32 { return Imported.make() }
    fn namespace() -> i32 { return actor.answer() }
    fn privateMember() -> i32 { return Imported.hidden() }
    fn missingMember() -> i32 { return Imported.absent() }
    """
  let libraryText = """
    pub struct Counter {}
    impl Counter {
      pub fn make() -> i32 { return 42 }
      fn hidden() -> i32 { return 7 }
    }
    pub fn answer() -> i32 { return 42 }
    """
  let written = run present(text)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let exported = run present(libraryText)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let initial = run Revision.publish(&Revision.make(), &entry, &written)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&initial, &library, &exported)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut semantic = makeSemantic(move revision)
  let mut request = Request.make()
  let works = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"works")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let namespace = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"namespace")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let privateMember = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"privateMember")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let missingMember = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"missingMember")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    Shared<Result<Answer, NoRejection>>.with<AnswerView>(&works, inspect).success &&
    Shared<Result<Answer, NoRejection>>.with<AnswerView>(&namespace, inspect).success,
    "an imported type alias selects its inherent function while namespace calls retain their path",
  )
  run Testing.expect(
    rejectsFrom(&privateMember, RejectionCode.PrivateMember, offsetOf(text, "hidden", 0)) &&
    rejectsFrom(&missingMember, RejectionCode.UnknownOperation, offsetOf(text, "absent", 0)),
    "imported inherent lookup preserves privacy and missing-member spans",
  )
  return ()
}

test effect fn constructorAndPackageValueAdmission() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let entry = run module("value-admission.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
    tuple Pair(i32, bool)
    param answer: i32 = 42
    param absent: i32
    fn tupleValue() -> i32 {
      let pair = Pair(42, true)
      return 42
    }
    fn tupleArity() -> i32 {
      let pair = Pair(42)
      return 42
    }
    fn tupleType() -> i32 {
      let pair = Pair(true, true)
      return 42
    }
    pub fn main() -> i32 { return answer }
    fn parameterValue() -> i32 { return answer }
    fn parameterCall() -> i32 { return answer() }
    fn invalidSchema() -> i32 { return absent }
    """
  let mut semantic = run applicationSemantic(&entry, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.forApplication(ModuleId.copy(&entry))
  let tupleValue = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"tupleValue")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let tupleArity = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"tupleArity")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let tupleType = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"tupleType")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let parameterValue = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"parameterValue")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let parameterCall = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"parameterCall")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let invalidSchema = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"invalidSchema")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    Shared<Result<Answer, NoRejection>>.with<bool>(&tupleValue, bodyAnswerIsTyped) && rejectsSpan(&parameterValue, RejectionCode.ProfileInputUnavailable, text, "answer", 2),
    "named tuple construction is checked while package values retain the profile gap",
  )
  run Testing.expect(
    rejectsSpan(&tupleArity, RejectionCode.TupleArityMismatch, text, "Pair(42)", 0) && rejectsSpan(&tupleType, RejectionCode.StructFieldTypeMismatch, text, "true", 1) &&
    rejectsSpan(&parameterCall, RejectionCode.NotCallable, text, "answer", 3) && rejectsSpan(&invalidSchema, RejectionCode.InvalidParameterSchema, text, "param absent: i32", 0),
    "argument and schema errors stay diagnostics before value deferral",
  )
  // Keep every negative Body assertion in the original source. The emission control gets
  // a complete valid program, since builds now check its entire loaded declaration closure.
  let buildText = """
    tuple Pair(i32, bool)
    param answer: i32 = 42
    fn tupleValue() -> i32 {
      let pair = Pair(42, true)
      return 42
    }
    pub fn main() -> i32 { return answer }
    """
  let mut buildStore = run applicationSemantic(
    &entry,
    buildText,
    MachineTarget.forId(TargetId.X8664UnknownLinuxGnu)
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut buildRequest = Request.forApplication(ModuleId.copy(&entry))
  let built = run buildApplication(&mut buildStore, &mut buildRequest, staticClosureNodes)
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  match move built {
    BackendBuild.Unsupported {gaps} => {
      let entries = Vector<Shared<BackendGap>>.asSlice(&gaps)
      run Testing.expect(entries.length == usize.ONE, "one profile input gap is retained")
      if entries.length == usize.ONE {
        run Testing.expect(
          Shared<BackendGap>.with<bool>(
            &entries[usize.ZERO],
            fn(gap: &BackendGap) -> bool {
              return gap.code == GapCode.ProfileInput
                && BackendGap.span(gap).start == offsetOf(buildText, "answer", 1)
                && BackendGap.span(gap).end == BackendGap.span(gap).start + 6
            }
          ),
          "a package value reports the profile input gap at its use",
        )
      }
    }
    _ => { run Testing.expect(false, "package values require the profile input query") }
  }
  return ()
}

test effect fn genericOpenOwnerCallsValidateBeforeDeferral() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let entry = run module("genericOpenOwnerCallsValidateBeforeDeferral.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
pub struct Box<T> { value: T }
impl<T> Box<T> { pub fn read(value: T) -> T { return move value } }
fn excessArguments() -> i32 { return Box.read(1, 2) }
fn excessPrefix() -> i32 { return Box<i32>.read<bool>(42) }
fn unknownPrefix() -> i32 { return Box<Missing>.read(42) }
"""
  let mut semantic = run staticSemantic(&entry, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu)) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let excessArguments = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"excessArguments") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let excessPrefix = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"excessPrefix") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let unknownPrefix = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"unknownPrefix") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsSpan(&excessArguments, RejectionCode.CallArity, text, "Box.read", 0)
    && rejectsSpan(&excessPrefix, RejectionCode.TypeArity, text, "Box<i32>.read<bool>(42)", 0)
    && rejectsSpan(&unknownPrefix, RejectionCode.UnknownType, text, "Missing", 0),
    "known call and prefix errors remain diagnostics before owner specialization defers")
  return ()
}

fn genericIndependentMemberArgument(value: &SpecializationApplication, spelling: &[u8]) -> bool {
  let arguments = Vector<Argument>.asSlice(&value.arguments)
  return Vector<ScopeBinding>.length(&value.scopes) == usize.ZERO && arguments.length == usize.ONE
    && applicationArgumentIs(&arguments[usize.ZERO], spelling)
}

test effect fn genericOpenOwnerPositiveCallsKeepOwnArguments() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let entry = run module("genericOpenOwnerPositiveCallsKeepOwnArguments.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
pub struct Box<T> { value: T }
impl<T> Box<T> {
  pub fn read(value: T) -> T { return move value }
  pub fn fixed() -> i32 { return 42 }
  pub fn keep<U>(value: U) -> U { return move value }
}
struct Scalar {}
impl Scalar { fn keep<T>(value: T) -> T { return move value } }
fn calls() -> i32 {
  let inferredOwner: i32 = Box.read(42)
  let fixedMember: i32 = Box.fixed()
  let explicitMember: i32 = Scalar.keep<i32>(42)
  let ownExplicit: u8 = Box.keep<u8>(42)
  let ownInferred: i32 = Box.keep(42)
  return 0
}
"""
  let mut semantic = run staticSemantic(&entry, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu)) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let calls = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"calls") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(succeeded(&calls),
    "owner arguments are inferred from the member contract without blocking owner-independent calls")
  let explicit = run directApplicationAt(&calls, 3) |> Effect.provideMut<Allocator>(&mut allocator)
  let inferred = run directApplicationAt(&calls, 4) |> Effect.provideMut<Allocator>(&mut allocator)
  let kept = match move explicit {
    Option<SpecializationApplication>.Some {value} => genericIndependentMemberArgument(&value, b"u8")
    Option<SpecializationApplication>.None => false
  }
  let inferredKept = match move inferred {
    Option<SpecializationApplication>.Some {value} => genericIndependentMemberArgument(&value, b"i32")
    Option<SpecializationApplication>.None => false
  }
  run Testing.expect(kept && inferredKept, "an owner-independent member keeps its own explicit and inferred generic arguments")
  return ()
}

