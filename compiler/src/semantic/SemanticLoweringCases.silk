  run Testing.expect(glueFact(&store, &glue, usize.ZERO) == usize.ONE && glueFact(&store, &glue, usize.ONE) == usize.ZERO,
    "without a Copy head the same affine field remains owned and receives child cleanup")
  return ()
}

fn genericGapKeepsInlineStorageDiagnostic(gap: &BackendGap) -> bool {
  return match &gap.source {
    GapSource.Diagnostic {diagnostic} => Shared<Rejection>.with<bool>(&diagnostic,
      fn(problem: &Rejection) -> bool { return problem.code == RejectionCode.InlineStorageUnavailable })
    _ => false
  }
}

test effect fn genericCleanupPropertiesKeepFiniteOpaqueDescentAndRejectGrowth() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("generic-cleanup-storage-descent.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
struct Plain<T> { value: T }
struct Storage { value: Plain<i32> }
fn finite(value: Plain<Storage>) -> i32 { return 0 }
struct CleanupGrowing<T> { child: CleanupGrowing<[T; 1]> }
fn shape(value: CleanupGrowing<i32>) -> i32 { return 0 }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu)) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let finite = run Semantic.demandMir(&mut store, &mut request, &id, b"finite") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(Shared<Result<Answer, NoRejection>>.with<bool>(&finite, pipelineHasMir),
    "cleanup-free stored fields may descend through opaque nominal arguments before returning to the same declaration")
  let shape = run Semantic.demandBody(&mut store, &mut request, &id, b"shape") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let growing = match move bodyLocalType(&shape, usize.ZERO) {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => { run Testing.expect(false, "the complete growing parameter is typed before cleanup demand") return () }
  }
  let sourceOwner = run glueSourceOwner(&mut store, &shape) |> Effect.provideMut<Allocator>(&mut allocator)
  let glue = run Semantic.demandGlueMir(&mut store, &mut request, &growing, &sourceOwner) |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let selected = Shared<Result<Answer, NoRejection>>.with<Option<Shared<BackendGap>>>(&glue, selectedBackendGap)
  let siteMatches = match move selected {
    Option<Shared<BackendGap>>.Some {value} => Shared<BackendGap>.with<bool>(&value, fn(gap: &BackendGap) -> bool {
      let written = "struct CleanupGrowing<T> { child: CleanupGrowing<[T; 1]> }"
      let start = offsetOf(text, written, usize.ZERO)
      let site = BackendGap.span(gap)
      return gap.code == GapCode.InlineStorage && BackendGap.moduleMatches(gap, &id)
        && genericGapKeepsInlineStorageDiagnostic(gap) && genericGapOwnerMatches(gap, &id, b"CleanupGrowing")
        && site.start == start && site.end == start + String.utf8Bytes(written).length
    })
    Option<Shared<BackendGap>>.None => false
  }
  run Testing.expect(siteMatches,
    "growing inline cleanup retains the named storage-recursion gap at its exact authored module and aggregate declaration")
  return ()
}

test effect fn genericCopyCyclesKeepCompleteImportedDiagnosticSite() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let leftId = run module("copy_left.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let rightId = run module("copy_right.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let leftText = """import copy_right { Right }
pub struct Left<T> { pub right: Right<T> }
impl<T> Intrinsic.Copy for Left<T> {}
fn inspect(value: &Left<i32>) -> i32 { drop value.* return 0 }
"""
  let rightText = """// The imported implementation deliberately starts beyond every byte in the entry module so a detached span paired with the repeated Left type's module cannot accidentally satisfy the source location assertion.
import copy_left { Left }
pub struct Right<T> { pub left: Left<T> }
impl<T> Intrinsic.Copy for Right<T> {}
"""
  let leftSource = run present(leftText) |> Effect.provideMut<Allocator>(&mut allocator)
  let rightSource = run present(rightText) |> Effect.provideMut<Allocator>(&mut allocator)
  let first = run Revision.publish(&Revision.make(), &leftId, &leftSource) |> Effect.provideMut<Allocator>(&mut allocator)
  let held = run Revision.publish(&first, &rightId, &rightSource) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut store = makeSemantic(move held)
  let mut request = Request.make()
  let body = run Semantic.demandBody(&mut store, &mut request, &leftId, b"inspect") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let found = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(&body, rejection)
  let siteMatches = match move found {
    Option<Shared<Rejection>>.Some {value} => Shared<Rejection>.with<bool>(&value, fn(problem: &Rejection) -> bool {
      let start = offsetOf(rightText, "impl<T> Intrinsic.Copy for Right<T> {}", usize.ZERO)
      return problem.code == RejectionCode.InvalidCopyConformance && ModuleId.equals(&problem.module, &rightId)
        && !ModuleId.equals(&problem.module, &leftId) && start > String.utf8Bytes(leftText).length
        && problem.span.start == start && problem.span.end == start + String.utf8Bytes("impl<T> Intrinsic.Copy for Right<T> {}").length
    })
    Option<Shared<Rejection>>.None => false
  }
  run Testing.expect(siteMatches, "a cross-module Copy cycle retains the selecting implementation's module and exact span as one rejection site")
  return ()
}

test effect fn genericSealedCopyUsesLexicalPremises() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("generic-sealed-copy-premises.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
struct Box<T> { value: T }
impl<T: Intrinsic.Copy> Intrinsic.Copy for Box<T> {}
fn abstractCopied<T: Intrinsic.Copy>(proved: &Box<Box<T>>) -> i32 { drop proved.* return 0 }
fn abstractAffine<T>(unproved: &Box<Box<T>>) -> i32 { drop unproved.* return 0 }
fn accepts<U: Intrinsic.Copy>(value: U) -> i32 { return 0 }
fn abstractApplied<T: Intrinsic.Copy>(value: Box<Box<T>>) -> i32 { return accepts<Box<Box<T>>>(move value) }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let positive = run Semantic.demandBody(&mut store, &mut request, &id, b"abstractCopied")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let negative = run Semantic.demandBody(&mut store, &mut request, &id, b"abstractAffine")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let applied = run Semantic.demandBody(&mut store, &mut request, &id, b"abstractApplied")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(succeeded(&positive), "nested conditional Copy retains the ordinary body's lexical T: Intrinsic.Copy premise")
  run Testing.expect(rejectsSpan(&negative, RejectionCode.BorrowedExtraction, text, "unproved.*", usize.ZERO),
    "an unconstrained abstract payload is not guaranteed Copy and remains affine")
  run Testing.expect(succeeded(&applied), "generic-call bound proof recursively retains lexical Copy premises")
  return ()
}

// Read the selected hook's impl scope, not the nominal owner's arguments or the caller's scope.
fn dropHookScopeMatches(application: &SpecializationApplication, first: &[u8], second: &[u8]) -> bool {
  if !DeclarationId.named(SpecializationApplication.bodyDeclaration(application), b"drop") { return false }
  let scopes = Vector<ScopeBinding>.asSlice(&application.scopes)
  if scopes.length != usize.ONE { return false }
  let arguments = Vector<Argument>.asSlice(&scopes[usize.ZERO].arguments)
  let ordinals = Vector<usize>.asSlice(&scopes[usize.ZERO].argumentOrdinals)
  let mut count: usize = 2
  if second.length == usize.ZERO { count = usize.ONE }
  if arguments.length != count || ordinals.length != count || ordinals[usize.ZERO] != usize.ZERO
    || !applicationArgumentIs(&arguments[usize.ZERO], first) { return false }
  return count == usize.ONE || (ordinals[usize.ONE] == usize.ONE && applicationArgumentIs(&arguments[usize.ONE], second))
}

fn glueHookScopeMatches(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>, first: &[u8], second: &[u8]) -> bool {
  let selected = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      let blocks = Vector<MirBlock>.asSlice(&function.blocks)
      let mut at = usize.ZERO
      while at < blocks.length {
        if let MirTerminator.Call {callee: MirCallee.Instance {key}, ..} = &blocks[at].terminator {
          if let Option<Shared<SpecializationApplication>>.Some {value: application} = move InstanceKey.application(&key) {
            return Shared<SpecializationApplication>.with<bool>(&application,
              fn(value: &SpecializationApplication) -> bool { return dropHookScopeMatches(value, first, second) })
          }
          return false
        }
        at = at + usize.ONE
      }
    }
  }
  return false
}

// Glue assertions need the complete parameter type, not an unasserted wrapper's cleanup MIR.
effect fn genericParameterGlue(
  store: &mut Semantic, request: &mut Request, body: &Shared<Result<Answer, NoRejection>>, parameter: usize,
) -> Shared<Result<Answer, NoRejection>>
! AssertionError<'static> | InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let sourceOwner = run glueSourceOwner(&mut store.*, body)
  return match move bodyLocalType(body, parameter) {
    Option<Shared<Type>>.Some {value} => run Semantic.demandGlueMir(&mut store.*, &mut request.*, &value, &sourceOwner)
    Option<Shared<Type>>.None => Shared<Result<Answer, NoRejection>>.clone(body)
  }
}

test effect fn genericSealedDropRetainsExactHeadBindings() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("generic-sealed-drop-bindings.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
struct Pair<A, B> { first: A second: B }
impl<X, Y> Intrinsic.Drop for Pair<Y, X> { fn drop(self: &mut Pair<Y, X>) -> () { return () } }
struct Packed<T> { value: T }
impl<U> Intrinsic.Drop for Packed<[U; 2]> { fn drop(self: &mut Packed<[U; 2]>) -> () { return () } }
fn instances(swapped: Pair<i32, bool>, nested: Packed<[i32; 2]>) -> i32 { return 0 }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let body = run Semantic.demandBody(&mut store, &mut request, &id, b"instances") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let swapped = run genericParameterGlue(&mut store, &mut request, &body, usize.ZERO) |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let nested = run genericParameterGlue(&mut store, &mut request, &body, usize.ONE) |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(glueFact(&store, &swapped, usize.ONE) == usize.ONE && glueHookScopeMatches(&store, &swapped, b"bool", b"i32"),
    "Pair<i32, bool> invokes exactly one hook with impl X=bool and Y=i32, not nominal positions")
  run Testing.expect(glueFact(&store, &nested, usize.ONE) == usize.ONE && glueHookScopeMatches(&store, &nested, b"i32", b""),
    "a nested provider head binds U=i32, not the nominal owner's array argument")
  return ()
}

test effect fn genericEqualLifetimeRecipesShareOneBody() -> ()
! CanonicalizationFailure | InvalidModulePath | Cycle | RevisionMismatch | BackendGap | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("generic-recipe-equal.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
struct Token {}
impl Intrinsic.Drop for Token { fn drop(self: &mut Token) -> () { return () } }
struct Guard<'a> { token: Token }
impl<'a> Intrinsic.Drop for Guard<'a> { fn drop(self: &mut Guard<'a>) -> () { return () } }
fn localGuard<'a>(value: &'a i32) -> Guard<'a> { return Guard<'a> { token: Token {} } }
fn consume<'a>(guard: Guard<'a>) -> () { drop guard return () }
pub fn main() -> i32 { let lasting = Guard<'static> { token: Token {} } let local: i32 = 0 let short = localGuard(&local) consume<'static>(move lasting) consume(move short) return 0 }
"""
  run sharedLifetimeRecipeClaim(&id, text) |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  return ()
}

// Lifetimes never decide which code runs (IMPL-007): both region patterns of `consume` and of
// `Guard`'s glue share one lowered body and one emitted definition.
effect fn sharedLifetimeRecipeClaim(id: &ModuleId, text: string) -> ()
! CanonicalizationFailure | InvalidModulePath | Cycle | RevisionMismatch | BackendGap | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let mut store = run applicationSemantic(id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.forApplication(ModuleId.copy(id))
  let main = run Semantic.demandBody(&mut store, &mut request, id, b"main")
  let lasting = match move bodyLocalType(&main, usize.ZERO) {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => { run Testing.expect(false, "the static Guard fixture binding resolves") return () }
  }
  let short = match move bodyLocalType(&main, 2) {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => { run Testing.expect(false, "the local Guard fixture binding resolves") return () }
  }
  let sourceOwner = run glueSourceOwner(&mut store, &main)
  let first = run Semantic.demandGlueMir(&mut store, &mut request, &lasting, &sourceOwner)
  let second = run Semantic.demandGlueMir(&mut store, &mut request, &short, &sourceOwner)
  run Testing.expect(sameSelectedMir(&first, &second) && glueFact(&store, &first, usize.ONE) == usize.ONE,
    "both region patterns of the glue share one body that runs the total Drop hook")
  let firstCall = run directApplicationAt(&main, usize.ONE)
  let secondCall = run directApplicationAt(&main, 2)
  if let Option<SpecializationApplication>.Some {value: one} = move firstCall {
    if let Option<SpecializationApplication>.Some {value: two} = move secondCall {
      let oneMir = run Semantic.demandApplicationMir(&mut store, &mut request, &one)
      let twoMir = run Semantic.demandApplicationMir(&mut store, &mut request, &two)
      let oneKey = run requiredCanonicalKey(run InstanceKey.function(move one))
      let twoKey = run requiredCanonicalKey(run InstanceKey.function(move two))
      run Testing.expect(!(run InstanceKey.sameApplication(&oneKey, &twoKey)) && sameSelectedMir(&oneMir, &twoMir),
        "two exact lifetime applications of `consume` share one lowered body")
      let built = run buildApplication(&mut store, &mut request, staticClosureNodes)
      if let BackendBuild.Module {text: ir, plan, ..} = &built {
        let oneSymbol = run EmissionPlan.symbol(&plan, &oneKey)
        let twoSymbol = run EmissionPlan.symbol(&plan, &twoKey)
        run Testing.expect(sameBytes(Bytes.asSlice(&oneSymbol), Bytes.asSlice(&twoSymbol))
          && genericUniqueSymbolDefinition(Bytes.asSlice(&ir), Bytes.asSlice(&oneSymbol)),
          "both region patterns name one emitted definition")
        return ()
      }
      run Testing.expect(false, "the shared lifetime recipe builds natively")
      return ()
    }
  }
  run Testing.expect(false, "fixture retains both exact caller applications")
  return ()
}

fn sameSelectedMir(left: &Shared<Result<Answer, NoRejection>>, right: &Shared<Result<Answer, NoRejection>>) -> bool {
  let first = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(left, selectedMirIndex)
  let second = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(right, selectedMirIndex)
  return match &first {
    Option<usize>.Some {value: one} => match &second { Option<usize>.Some {value: two} => one == two _ => false }
    _ => false
  }
}

// A control recipe with the borrow status of the function it was made from, which the emission plan
// reports and the recipe's runtime identity leaves out.
struct ControlRecipe {
  recipe: InstanceRecipe
  borrow: BorrowStatus
}

effect fn appendRecipeControl(recipes: &mut Vector<ControlRecipe>, key: &InstanceKey, callees: &[InstanceKey], constant: Option<bool>, checked: bool) -> ()
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let function = run recipeControlMir(key, callees, move constant, checked)
  return run Vector<ControlRecipe>.append(&mut recipes.*, ControlRecipe {recipe: run InstanceRecipe.make(&function), borrow: function.borrow})
}

effect fn recipeControlPlan(controls: &[ControlRecipe]) -> EmissionPlan
! OutOfMemoryError
? &mut Allocator {
  let mut plan = EmissionPlan.empty()
  let mut at = usize.ZERO
  while at < controls.length {
    let identity = run InstanceKey.encoding(&controls[at].recipe.key)
    let symbol = run InstanceKey.symbol(&controls[at].recipe.key)
    run EmissionPlan.include(
      &mut plan,
      &controls[at].recipe.key,
      Bytes.asSlice(&identity),
      Bytes.asSlice(&symbol),
      controls[at].borrow,
    )
    at = at + usize.ONE
  }
  return move plan
}

effect fn recipePlansAgree(left: &EmissionPlan, right: &EmissionPlan, key: &InstanceKey) -> bool
! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let first = run recipeIdentityAt(left, key)
  let second = run recipeIdentityAt(right, key)
  let firstIdentities = Vector<EmissionIdentity>.asSlice(&left.identities)
  let secondIdentities = Vector<EmissionIdentity>.asSlice(&right.identities)
  let a = &firstIdentities[first]
  let b = &secondIdentities[second]
  return sameBytes(Bytes.asSlice(&a.encoding), Bytes.asSlice(&b.encoding))
    && sameBytes(Bytes.asSlice(&a.symbol), Bytes.asSlice(&b.symbol))
}

// Canonical labeling preserves the complete region-incidence graph, including unordered sets.
test effect fn instanceKeysCanonicallyNumberCompleteCallerRegionGraphs() -> ()
! CanonicalizationFailure | Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run callerRegionNumberingClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn numberingDeclaration(id: &ModuleId, name: &[u8], kind: OwnerKind) -> DeclarationId ! OutOfMemoryError ? &mut Allocator {
  let mut owners = Vector<OwnerStep>.make()
  run Vector<OwnerStep>.append(&mut owners, OwnerStep {kind: kind,
    name: Option<Bytes>.some(run Bytes.copy(name)), occurrence: usize.ZERO})
  return run DeclarationId.fromParts(ModuleId.copy(id), move owners)
}

// A borrow region of `caller`, or `'static` when `lasting`.
effect fn numberingRegion(caller: &DeclarationId, ordinal: usize, lasting: bool) -> Shared<Lifetime>
! OutOfMemoryError ? &mut Allocator {
  if lasting { return run Shared<Lifetime>.make(Lifetime.Static) }
  return run Shared<Lifetime>.make(Lifetime.Local {declaration: DeclarationId.copy(caller), ordinal: ordinal})
}

effect fn numberingPair(callee: &DeclarationId, first: Shared<Lifetime>, second: Shared<Lifetime>) -> InstanceKey
! CanonicalizationFailure | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut arguments = Vector<Argument>.make()
  run Vector<Argument>.append(&mut arguments, Argument.Lifetime {value: move first})
  run Vector<Argument>.append(&mut arguments, Argument.Lifetime {value: move second})
  return run requiredCanonicalKey(run InstanceKey.function(run specializationWithArguments(callee, move arguments)))
}

// `wrap<'r, &'t u8>`: one direct region argument and one region nested in a type argument.
effect fn numberingNested(callee: &DeclarationId, direct: Shared<Lifetime>, nested: Shared<Lifetime>) -> InstanceKey
! CanonicalizationFailure | OutOfMemoryError ? &mut Allocator | &mut Types {
  let referent = run specializationPrimitive(b"u8")
  let mut arguments = Vector<Argument>.make()
  run Vector<Argument>.append(&mut arguments, Argument.Lifetime {value: move direct})
  run Vector<Argument>.append(&mut arguments, Argument.Type {value: run Types.intern(
    Type.Reference {referent: move referent, access: Access.Shared, lifetime: move nested})})
  return run requiredCanonicalKey(run InstanceKey.function(run specializationWithArguments(callee, move arguments)))
}

// `serve<'a>` whose `Sink` requirement is served by a provider of type `&'p Console`.
effect fn numberingServed(callee: &DeclarationId, sink: &DeclarationId, console: &DeclarationId, argument: Shared<Lifetime>,
  lent: Shared<Lifetime>) -> InstanceKey
! CanonicalizationFailure | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut arguments = Vector<Argument>.make()
  run Vector<Argument>.append(&mut arguments, Argument.Lifetime {value: move argument})
  let capability = run specializationNominal(sink, Vector<Argument>.make())
  let referent = run specializationNominal(console, Vector<Argument>.make())
  let provider = run Types.intern(Type.Reference {referent: move referent, access: Access.Shared, lifetime: move lent})
  let mut served = Vector<ProviderEntry>.make()
  run Vector<ProviderEntry>.append(&mut served, ProviderEntry {
    key: Requirement {capability: move capability, roleType: Option<Shared<Type>>.none(), access: Access.Shared},
    provider: move provider,
  })
  return run requiredCanonicalKey(run InstanceKey.withProviders(run specializationWithArguments(callee, move arguments), move served))
}

enum NumberingSetShape { Meet, Union, Row }

// The unordered input is followed by two ordered anchors. Changing the second anchor's sharing
// cannot be repaired by swapping the two otherwise interchangeable unordered members.
effect fn numberingSetCorrelation(callee: &DeclarationId, caller: &DeclarationId, capability: &DeclarationId,
  first: usize, second: usize, separate: bool, reversed: bool, shape: NumberingSetShape) -> InstanceKey
! CanonicalizationFailure | OutOfMemoryError ? &mut Allocator | &mut Types {
  let a = run numberingRegion(caller, first, false)
  let b = run numberingRegion(caller, second, false)
  let referenceA = run environmentReference(&a)
  let referenceB = run environmentReference(&b)
  let mut arguments = Vector<Argument>.make()
  if shape == NumberingSetShape.Meet {
    let atoms = [Shared<Lifetime>.clone(&a), Shared<Lifetime>.clone(&b)]
    run Vector<Argument>.append(&mut arguments, Argument.Lifetime {value: run Lifetime.meet(&atoms)})
  } else if shape == NumberingSetShape.Union {
    let mut members = Vector<Shared<Type>>.make()
    if reversed {
      run Type.joinMember(&mut members, &referenceB)
      run Type.joinMember(&mut members, &referenceA)
    } else {
      run Type.joinMember(&mut members, &referenceA)
      run Type.joinMember(&mut members, &referenceB)
    }
    run Vector<Argument>.append(&mut arguments, Argument.Type {value: run Types.intern(Type.Union {members: move members})})
  } else {
    let mut firstArguments = Vector<Argument>.make()
    run Vector<Argument>.append(&mut firstArguments, Argument.Type {value: Shared<Type>.clone(&referenceA)})
    let firstCapability = run specializationNominal(capability, move firstArguments)
    let mut secondArguments = Vector<Argument>.make()
    run Vector<Argument>.append(&mut secondArguments, Argument.Type {value: Shared<Type>.clone(&referenceB)})
    let secondCapability = run specializationNominal(capability, move secondArguments)
    let mut row = Row.empty()
    let firstKey = Requirement {capability: move firstCapability, roleType: Option<Shared<Type>>.none(), access: Access.Shared}
    let secondKey = Requirement {capability: move secondCapability, roleType: Option<Shared<Type>>.none(), access: Access.Shared}
    if reversed { run Row.require(&mut row, move secondKey) run Row.require(&mut row, move firstKey) }
    else { run Row.require(&mut row, move firstKey) run Row.require(&mut row, move secondKey) }
    run Vector<Argument>.append(&mut arguments, Argument.Row {value: run Shared<Row>.make(move row)})
  }
  run Vector<Argument>.append(&mut arguments, Argument.Type {value: Shared<Type>.clone(&referenceA)})
  let mut last = Shared<Type>.clone(&referenceA)
  if separate { last = Shared<Type>.clone(&referenceB) }
  run Vector<Argument>.append(&mut arguments, Argument.Type {value: move last})
  return run requiredCanonicalKey(run InstanceKey.function(run specializationWithArguments(callee, move arguments)))
}

// A union of borrows of `count` caller regions, each region also anchored at its own ordered
// lifetime argument after the union when `anchored`.
effect fn numberingAnchoredUnion(callee: &DeclarationId, caller: &DeclarationId, base: usize, count: usize,
  reversed: bool, anchored: bool) -> Result<InstanceKey, CanonicalizationFailure>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut regions = Vector<Shared<Lifetime>>.make()
  let mut at = usize.ZERO
  while at < count {
    run Vector<Shared<Lifetime>>.append(&mut regions, run numberingRegion(caller, base + at, false))
    at = at + usize.ONE
  }
  let listed = Vector<Shared<Lifetime>>.asSlice(&regions)
  let mut members = Vector<Shared<Type>>.make()
  at = usize.ZERO
  while at < count {
    let mut selected = at
    if reversed { selected = count - usize.ONE - at }
    run Type.joinMember(&mut members, &run environmentReference(&listed[selected]))
    at = at + usize.ONE
  }
  let mut arguments = Vector<Argument>.make()
  run Vector<Argument>.append(&mut arguments, Argument.Type {value: run Types.intern(Type.Union {members: move members})})
  at = usize.ZERO
  while anchored && at < count {
    run Vector<Argument>.append(&mut arguments, Argument.Lifetime {value: Shared<Lifetime>.clone(&listed[at])})
    at = at + usize.ONE
  }
  return run InstanceKey.function(run specializationWithArguments(callee, move arguments))
}

effect fn numberingScopedProvider(callee: &DeclarationId, caller: &DeclarationId, scope: &DeclarationId,
  capability: &DeclarationId, first: usize, second: usize, separate: bool) -> InstanceKey
! CanonicalizationFailure | OutOfMemoryError ? &mut Allocator | &mut Types {
  let a = run numberingRegion(caller, first, false)
  let b = run numberingRegion(caller, second, false)
  let atoms = [Shared<Lifetime>.clone(&a), Shared<Lifetime>.clone(&b)]
  let mut own = Vector<Argument>.make()
  run Vector<Argument>.append(&mut own, Argument.Lifetime {value: run Lifetime.meet(&atoms)})
  let mut application = run specializationWithArguments(callee, move own)
  let mut scoped = Vector<Argument>.make()
  run Vector<Argument>.append(&mut scoped, Argument.Type {value: run environmentReference(&a)})
  run Vector<Argument>.append(&mut scoped, Argument.Type {value: run environmentReference(&b)})
  run Vector<ScopeBinding>.append(&mut application.scopes, ScopeBinding {
    owner: run Shared<DeclarationId>.make(DeclarationId.copy(scope)), arguments: move scoped,
    argumentOrdinals: run SpecializationApplication.denseOrdinals(2),
  })
  let mut capabilityArguments = Vector<Argument>.make()
  run Vector<Argument>.append(&mut capabilityArguments, Argument.Type {value: run environmentReference(&b)})
  let mut roleType = run environmentReference(&a)
  if separate { roleType = run environmentReference(&b) }
  let mut providers = Vector<ProviderEntry>.make()
  run Vector<ProviderEntry>.append(&mut providers, ProviderEntry {
    key: Requirement {capability: run specializationNominal(capability, move capabilityArguments),
      roleType: Option<Shared<Type>>.some(move roleType), access: Access.Shared},
    provider: run environmentReference(&a),
  })
  return run requiredCanonicalKey(run InstanceKey.withProviders(move application, move providers))
}

// One meet holds every atom at a single site, so only the single-atom references after it rank
// them. The references run from the last atom to the first, or from the first to the last when
// `ascending`; with `repeated`, the final reference names the previous reference's atom again.
effect fn numberingTiedMeet(callee: &DeclarationId, caller: &DeclarationId, base: usize, count: usize, ascending: bool,
  repeated: bool) -> Result<InstanceKey, CanonicalizationFailure>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut atoms = Vector<Shared<Lifetime>>.make()
  let mut at = usize.ZERO
  while at < count {
    run Vector<Shared<Lifetime>>.append(&mut atoms, run numberingRegion(caller, base + at, false))
    at = at + usize.ONE
  }
  let mut arguments = Vector<Argument>.make()
  run Vector<Argument>.append(&mut arguments, Argument.Lifetime {value: run Lifetime.meet(Vector<Shared<Lifetime>>.asSlice(&atoms))})
  at = usize.ZERO
  while at < count {
    let mut atom = count - usize.ONE - at
    if ascending { atom = at }
    if repeated && at == count - usize.ONE {
      atom = atom + usize.ONE
      if ascending { atom = at - usize.ONE }
    }
    let listed = Vector<Shared<Lifetime>>.asSlice(&atoms)
    run Vector<Argument>.append(&mut arguments, Argument.Type {value: run environmentReference(&listed[atom])})
    at = at + usize.ONE
  }
  return run InstanceKey.function(run specializationWithArguments(callee, move arguments))
}

effect fn numberingDag(callee: &DeclarationId, record: &DeclarationId, caller: &DeclarationId, ordinal: usize, shared: bool) -> InstanceKey
! CanonicalizationFailure | OutOfMemoryError ? &mut Allocator | &mut Types {
  let region = run numberingRegion(caller, ordinal, false)
  let first = run environmentReference(&region)
  let mut second = Shared<Type>.clone(&first)
  if !shared { second = run environmentReference(&region) }
  let mut members = Vector<Argument>.make()
  run Vector<Argument>.append(&mut members, Argument.Type {value: move first})
  run Vector<Argument>.append(&mut members, Argument.Type {value: move second})
  let mut arguments = Vector<Argument>.make()
  run Vector<Argument>.append(&mut arguments, Argument.Type {value: run specializationNominal(record, move members)})
  return run requiredCanonicalKey(run InstanceKey.function(run specializationWithArguments(callee, move arguments)))
}

fn suppliedAt(value: &Lifetime, position: usize) -> bool {
  return match &value.* { Lifetime.Supplied {ordinal} => ordinal == position _ => false }
}

fn numberedSharedI32(value: &Type, ordinal: usize) -> bool {
  if let Type.Reference {access, referent, lifetime} = &value.* {
    return access == Access.Shared && Shared<Type>.with<bool>(&referent, isI32)
      && Shared<Lifetime>.with<bool>(&lifetime,
        fn(region: &Lifetime) -> bool { return suppliedAt(region, ordinal) })
  }
  return false
}

fn numberedMeetAndAnchors(application: &SpecializationApplication) -> bool {
  let arguments = Vector<Argument>.asSlice(&application.arguments)
  if arguments.length != 3 { return false }
  if let Argument.Lifetime {value} = &arguments[usize.ZERO] {
    if Lifetime.atomCount(&value) != 2 { return false }
    let first = Lifetime.atomAt(&value, usize.ZERO)
    let second = Lifetime.atomAt(&value, usize.ONE)
    let a = Shared<Lifetime>.with<bool>(&first, fn(region: &Lifetime) -> bool { return suppliedAt(region, usize.ZERO) })
    let b = Shared<Lifetime>.with<bool>(&second, fn(region: &Lifetime) -> bool { return suppliedAt(region, usize.ONE) })
    let reversedA = Shared<Lifetime>.with<bool>(&first, fn(region: &Lifetime) -> bool { return suppliedAt(region, usize.ONE) })
    let reversedB = Shared<Lifetime>.with<bool>(&second, fn(region: &Lifetime) -> bool { return suppliedAt(region, usize.ZERO) })
    if !(a && b) && !(reversedA && reversedB) { return false }
    let mut at = usize.ONE
    while at < arguments.length {
      if let Argument.Type {value: reference} = &arguments[at] {
        if !Shared<Type>.with<bool>(&reference,
          fn(ty: &Type) -> bool { return numberedSharedI32(ty, usize.ZERO) }) { return false }
      } else { return false }
      at = at + usize.ONE
    }
    return true
  }
  return false
}

effect fn numberedArgumentsAre(key: &InstanceKey, first: usize, second: usize) -> bool ! OutOfMemoryError ? &mut Allocator {
  let application = run InstanceKey.selected(key)
  let arguments = Vector<Argument>.asSlice(&application.arguments)
  if arguments.length != 2 { return false }
  let leading = match &arguments[usize.ZERO] {
    Argument.Lifetime {value} => Shared<Lifetime>.with<bool>(&value, fn(region: &Lifetime) -> bool { return suppliedAt(region, first) })
    _ => false
  }
  let trailing = match &arguments[usize.ONE] {
    Argument.Lifetime {value} => Shared<Lifetime>.with<bool>(&value, fn(region: &Lifetime) -> bool { return suppliedAt(region, second) })
    _ => false
  }
  return leading && trailing
}

effect fn callerRegionNumberingClaims() -> ()
! CanonicalizationFailure | Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("caller-region-numbering.silk")
  let caller = run numberingDeclaration(&id, b"caller", OwnerKind.Function)
  let pair = run numberingDeclaration(&id, b"pair", OwnerKind.Function)
  let distinct = run numberingPair(&pair, run numberingRegion(&caller, 9, false), run numberingRegion(&caller, 3, false))
  let renamed = run numberingPair(&pair, run numberingRegion(&caller, 4, false), run numberingRegion(&caller, 12, false))
  let shared = run numberingPair(&pair, run numberingRegion(&caller, 3, false), run numberingRegion(&caller, 3, false))
  let sharedElsewhere = run numberingPair(&pair, run numberingRegion(&caller, 5, false), run numberingRegion(&caller, 5, false))
  let lasting = run numberingPair(&pair, run numberingRegion(&caller, 9, false), run numberingRegion(&caller, 3, true))
  let renamedEqual = run InstanceKey.sameApplication(&distinct, &renamed)
  let sharedEqual = run InstanceKey.sameApplication(&shared, &sharedElsewhere)
  let distinctNumbered = run numberedArgumentsAre(&distinct, usize.ZERO, usize.ONE)
  let sharedNumbered = run numberedArgumentsAre(&shared, usize.ZERO, usize.ZERO)
  run Testing.expect(renamedEqual && sharedEqual && distinctNumbered && sharedNumbered,
    "renamed ordered caller regions share one exact instance with independently checked distinct or shared canonical atoms")
  let sharingKept = run InstanceKey.sameApplication(&distinct, &shared)
  let lastingKept = run InstanceKey.sameApplication(&distinct, &lasting)
  run Testing.expect(!sharingKept && !lastingKept && InstanceKey.sameRuntimeBase(&distinct, &shared)
    && InstanceKey.sameRuntimeBase(&distinct, &lasting),
    "region sharing and 'static remain exact instance evidence inside one erased runtime family")
  let sharingCode = run InstanceKey.sameInstance(&distinct, &shared)
  let lastingCode = run InstanceKey.sameInstance(&distinct, &lasting)
  run Testing.expect(sharingCode && lastingCode, "region patterns share one backend instance")
  let supplied = run Shared<Lifetime>.make(Lifetime.Supplied {ordinal: 3})
  let mixedKinds = run numberingPair(&pair, run numberingRegion(&caller, 3, false), move supplied)
  run Testing.expect((run InstanceKey.sameApplication(&distinct, &mixedKinds))
      && !(run InstanceKey.sameApplication(&shared, &mixedKinds)),
    "a caller's supplied atom and a distinct local loan never alias merely because their raw ordinals match")
  let wrap = run numberingDeclaration(&id, b"wrap", OwnerKind.Function)
  let together = run numberingNested(&wrap, run numberingRegion(&caller, 3, false), run numberingRegion(&caller, 3, false))
  let movedTogether = run numberingNested(&wrap, run numberingRegion(&caller, 8, false), run numberingRegion(&caller, 8, false))
  let apart = run numberingNested(&wrap, run numberingRegion(&caller, 3, false), run numberingRegion(&caller, 8, false))
  let nestedEqual = run InstanceKey.sameApplication(&together, &movedTogether)
  let nestedApart = run InstanceKey.sameApplication(&together, &apart)
  run Testing.expect(nestedEqual && !nestedApart,
    "a region nested in a type argument is numbered with the direct region arguments")
  let guard = run numberingDeclaration(&id, b"Guard", OwnerKind.Struct)
  let mut firstGuard = Vector<Argument>.make()
  run Vector<Argument>.append(&mut firstGuard, Argument.Lifetime {value: run numberingRegion(&caller, 3, false)})
  let mut secondGuard = Vector<Argument>.make()
  run Vector<Argument>.append(&mut secondGuard, Argument.Lifetime {value: run numberingRegion(&caller, 8, false)})
  let mut staticGuard = Vector<Argument>.make()
  run Vector<Argument>.append(&mut staticGuard, Argument.Lifetime {value: run numberingRegion(&caller, 8, true)})
  let firstType = run specializationNominal(&guard, move firstGuard)
  let secondType = run specializationNominal(&guard, move secondGuard)
  let staticType = run specializationNominal(&guard, move staticGuard)
  let firstGlue = run requiredCanonicalGlue(run InstanceKey.dropGlue(&firstType, &caller))
  let secondGlue = run requiredCanonicalGlue(run InstanceKey.dropGlue(&secondType, &caller))
  let staticGlue = run requiredCanonicalGlue(run InstanceKey.dropGlue(&staticType, &caller))
  let mut glue = false
  if let Option<InstanceKey>.Some {value: first} = &firstGlue {
    if let Option<InstanceKey>.Some {value: second} = &secondGlue {
      if let Option<InstanceKey>.Some {value: permanent} = &staticGlue {
        let glueShared = run InstanceKey.sameApplication(&first, &second)
        let glueLasting = run InstanceKey.sameApplication(&first, &permanent)
        let glueCode = run InstanceKey.sameInstance(&first, &permanent)
        glue = glueShared && !glueLasting && glueCode
      }
    }
  }
  run Testing.expect(glue, "drop glue numbers caller regions of its type; 'static stays exact semantically and shares the glue's code")
  let serve = run numberingDeclaration(&id, b"serve", OwnerKind.Function)
  let sink = run numberingDeclaration(&id, b"Sink", OwnerKind.Service)
  let console = run numberingDeclaration(&id, b"Console", OwnerKind.Struct)
  let servedTogether = run numberingServed(&serve, &sink, &console, run numberingRegion(&caller, 3, false), run numberingRegion(&caller, 3, false))
  let servedMoved = run numberingServed(&serve, &sink, &console, run numberingRegion(&caller, 8, false), run numberingRegion(&caller, 8, false))
  let servedApart = run numberingServed(&serve, &sink, &console, run numberingRegion(&caller, 3, false), run numberingRegion(&caller, 8, false))
  let providerShared = run InstanceKey.sameApplication(&servedTogether, &servedMoved)
  let providerApart = run InstanceKey.sameApplication(&servedTogether, &servedApart)
  run Testing.expect(providerShared && !providerApart,
    "one numbering covers an application and its providers, so argument-provider region sharing stays exact")
  let site = run numberingDeclaration(&id, b"site", OwnerKind.Function)
  let declared = run Shared<Lifetime>.make(Lifetime.Parameter {declaration: DeclarationId.copy(&site), ordinal: usize.ZERO})
  let parameter = run numberingPair(&pair, move declared, run numberingRegion(&caller, 3, false))
  let application = run InstanceKey.selected(&parameter)
  let arguments = Vector<Argument>.asSlice(&application.arguments)
  let mut kept = false
  if arguments.length == 2 {
    kept = match &arguments[usize.ZERO] {
      Argument.Lifetime {value} => Shared<Lifetime>.with<bool>(&value, fn(region: &Lifetime) -> bool {
        return match &region.* {
          Lifetime.Parameter {declaration, ordinal} => ordinal == usize.ZERO && DeclarationId.equals(&declaration, &site)
          _ => false
        }
      })
      _ => false
    }
  }
  run Testing.expect(kept, "a declaration-owned parameter region is not a caller region and keeps its identity")
  let foreignParameter = run Shared<Lifetime>.make(Lifetime.Parameter {
    declaration: DeclarationId.copy(&caller), ordinal: usize.ZERO})
  let foreignKey = run numberingPair(&pair, move foreignParameter, run numberingRegion(&caller, 3, false))
  run Testing.expect(!(run InstanceKey.sameApplication(&parameter, &foreignKey)),
    "the same parameter ordinal under another declaration remains a different rigid atom")
  let sets = [NumberingSetShape.Meet, NumberingSetShape.Union, NumberingSetShape.Row]
  let mut set = usize.ZERO
  while set < 3 {
    let original = run numberingSetCorrelation(&pair, &caller, &sink, usize.ONE, 2, false, false, sets[set])
    let alpha = run numberingSetCorrelation(&pair, &caller, &sink, 6, 5, false, true, sets[set])
    let different = run numberingSetCorrelation(&pair, &caller, &sink, 6, 5, true, true, sets[set])
    let equal = run InstanceKey.sameApplication(&original, &alpha)
    let unequal = run InstanceKey.sameApplication(&original, &different)
    run Testing.expect(equal && !unequal && InstanceKey.sameRuntimeBase(&original, &different),
      "unordered lifetime/type/row sets are alpha invariant across ordered anchors and preserve changed sharing in one erased family")
    if sets[set] == NumberingSetShape.Meet {
      let selected = run InstanceKey.selected(&original)
      run Testing.expect(numberedMeetAndAnchors(&selected),
        "canonical meet atoms remain injective Supplied0/1 and both literal ordered anchors retain Supplied0")
      let renumbered = run requiredCanonicalKey(run InstanceKey.function(move selected))
      run Testing.expect(run InstanceKey.sameApplication(&original, &renumbered),
        "renumbering the complete selected Supplied-atom graph preserves the same canonical application")
    }
    set = set + usize.ONE
  }
  // Members without caller atoms cannot reorder any atom's incidence, so many distinct caller
  // regions beside a plain union and row stay positional: an exact search over 9! numberings
  // would exceed the 65536-state budget.
  let mut plainMembers = Vector<Shared<Type>>.make()
  run Type.joinMember(&mut plainMembers, &run specializationNominal(&console, Vector<Argument>.make()))
  run Type.joinMember(&mut plainMembers, &run specializationNominal(&guard, Vector<Argument>.make()))
  let mut plainRow = Row.empty()
  run Row.require(&mut plainRow, Requirement {capability: run specializationNominal(&sink, Vector<Argument>.make()),
    roleType: Option<Shared<Type>>.none(), access: Access.Shared})
  run Row.require(&mut plainRow, Requirement {capability: run specializationNominal(&console, Vector<Argument>.make()),
    roleType: Option<Shared<Type>>.none(), access: Access.Mutable})
  let mut plainArguments = Vector<Argument>.make()
  let mut atom = usize.ZERO
  while atom < 9 {
    run Vector<Argument>.append(&mut plainArguments, Argument.Lifetime {value: run numberingRegion(&caller, atom + usize.ONE, false)})
    atom = atom + usize.ONE
  }
  run Vector<Argument>.append(&mut plainArguments, Argument.Type {value: run Types.intern(Type.Union {members: move plainMembers})})
  run Vector<Argument>.append(&mut plainArguments, Argument.Row {value: run Shared<Row>.make(move plainRow)})
  let plain = run InstanceKey.function(run specializationWithArguments(&pair, move plainArguments))
  let plainNumbered = match &plain { Result<InstanceKey, CanonicalizationFailure>.Success {..} => true _ => false }
  run Testing.expect(plainNumbered, "a union or row whose members carry no caller region needs no exact numbering search")
  // Inside an unordered set every occurrence takes the set's last site, so atoms the ordered
  // anchors still distinguish keep their ranked ordinals and need no search: exchanging all 9
  // would take 9! candidates, beyond the 65536-state budget.
  let anchored = run numberingAnchoredUnion(&pair, &caller, usize.ONE, 9, false, true)
  let anchoredAlpha = run numberingAnchoredUnion(&pair, &caller, 40, 9, true, true)
  let mut anchoredClaim = false
  if let Result<InstanceKey, CanonicalizationFailure>.Success {value: anchoredKey} = &anchored {
    if let Result<InstanceKey, CanonicalizationFailure>.Success {value: alphaKey} = &anchoredAlpha {
      anchoredClaim = run InstanceKey.sameApplication(&anchoredKey, &alphaKey)
    }
  }
  run Testing.expect(anchoredClaim,
    "a union whose caller atoms ordered sites distinguish numbers without exchanging them and stays alpha invariant")
  // Without anchors every atom of the union ties, so the search exchanges them all and still
  // picks one record for every renaming.
  let tiedUnion = run numberingAnchoredUnion(&pair, &caller, usize.ONE, 4, false, false)
  let tiedUnionAlpha = run numberingAnchoredUnion(&pair, &caller, 60, 4, true, false)
  let mut tiedUnionClaim = false
  if let Result<InstanceKey, CanonicalizationFailure>.Success {value: tiedKey} = &tiedUnion {
    if let Result<InstanceKey, CanonicalizationFailure>.Success {value: alphaKey} = &tiedUnionAlpha {
      tiedUnionClaim = run InstanceKey.sameApplication(&tiedKey, &alphaKey)
    }
  }
  run Testing.expect(tiedUnionClaim, "atoms tied inside an unordered union number identically under any renaming")
  // Atoms that share their first site are ordered by later incidence. Ranking 24 tied atoms
  // takes 276 comparisons; rescanning every site and occurrence for each one exceeded the
  // 32768-unit budget, while comparing each atom's sorted site list stays linear.
  let tied = run numberingTiedMeet(&pair, &caller, usize.ONE, 24, false, false)
  let tiedAlpha = run numberingTiedMeet(&pair, &caller, 40, 24, true, false)
  let tiedRepeated = run numberingTiedMeet(&pair, &caller, usize.ONE, 24, false, true)
  let mut tiedClaim = false
  if let Result<InstanceKey, CanonicalizationFailure>.Success {value: tiedKey} = &tied {
    if let Result<InstanceKey, CanonicalizationFailure>.Success {value: alphaKey} = &tiedAlpha {
      if let Result<InstanceKey, CanonicalizationFailure>.Success {value: repeatedKey} = &tiedRepeated {
        let alphaEqual = run InstanceKey.sameApplication(&tiedKey, &alphaKey)
        let repeatedEqual = run InstanceKey.sameApplication(&tiedKey, &repeatedKey)
        tiedClaim = alphaEqual && !repeatedEqual && InstanceKey.sameRuntimeBase(&tiedKey, &repeatedKey)
      }
    }
  }
  run Testing.expect(tiedClaim,
    "atoms tied at one meet are ranked by later incidence within budget, alpha invariant and sharing exact")
  let scoped = run numberingScopedProvider(&serve, &caller, &guard, &sink, usize.ONE, 2, false)
  let scopedAlpha = run numberingScopedProvider(&serve, &caller, &guard, &sink, 6, 5, false)
  let scopedDifferent = run numberingScopedProvider(&serve, &caller, &guard, &sink, 6, 5, true)
  run Testing.expect((run InstanceKey.sameApplication(&scoped, &scopedAlpha))
      && !(run InstanceKey.sameApplication(&scoped, &scopedDifferent))
      && InstanceKey.sameRuntimeBase(&scoped, &scopedDifferent),
    "one frozen domain retains sharing across own meets, original scopes, capability arguments, role types and provider types")
  let dag = run numberingDag(&wrap, &guard, &caller, usize.ONE, true)
  let copiedDag = run numberingDag(&wrap, &guard, &caller, 6, false)
  run Testing.expect(run InstanceKey.sameApplication(&dag, &copiedDag),
    "shared DAG occurrences and independently allocated equal children have one canonical application")
  // These are real incoming semantic edges, even though every edge shares one small child.
  // Each Reference and its i32 child require at least four node/edge units per occurrence.
  // 8193 occurrences therefore exceed the 32768-unit budget without a large allocation graph.
  let repeatedChild = run environmentReference(&run numberingRegion(&caller, usize.ONE, false))
  let mut repeatedEdges = Vector<Argument>.make()
  let mut edge = usize.ZERO
  while edge < 8193 {
    run Vector<Argument>.append(&mut repeatedEdges, Argument.Type {value: Shared<Type>.clone(&repeatedChild)})
    edge = edge + usize.ONE
  }
  let wide = run specializationNominal(&guard, move repeatedEdges)
  let mut exhaustedArguments = Vector<Argument>.make()
  run Vector<Argument>.append(&mut exhaustedArguments, Argument.Type {value: move wide})
  let exhausted = run InstanceKey.function(run specializationWithArguments(&pair, move exhaustedArguments))
  let refused = match &exhausted {
    Result<InstanceKey, CanonicalizationFailure>.Failure {error} => error == CanonicalizationFailure.Resource
    _ => false
  }
  run Testing.expect(refused, "whole-domain structural exhaustion returns the exact Resource failure and publishes no partial canonical key")
  // Positional storage has no unordered regions or search permutations. Its repeated incoming
  // primitive edges fit collection, then exceed the same cumulative budget during frozen rewrite.
  let primitiveChild = run specializationPrimitive(b"u8")
  let mut primitiveEdges = Vector<Shared<Type>>.make()
  let mut primitiveAt = usize.ZERO
  while primitiveAt < 5000 {
    run Vector<Shared<Type>>.append(&mut primitiveEdges, Shared<Type>.clone(&primitiveChild))
    primitiveAt = primitiveAt + usize.ONE
  }
  let occurrence = run Shared<AnonymousOccurrence>.make(AnonymousOccurrence {
    declaration: run Shared<DeclarationId>.make(DeclarationId.copy(&caller)), syntax: usize.ZERO,
    positional: true, labels: Vector<Bytes>.make()})
  let positional = run Types.intern(Type.Anonymous {occurrence: move occurrence, members: move primitiveEdges})
  let budgetText = """
// The canonical refusal must retain this original declaration's nonzero source span.
fn budget<T>() -> () { return () }
"""
  let mut budgetStore = run staticSemantic(&id, budgetText, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut budgetDependencies = Vector<Dependency>.make()
  let mut budgetPort = Semantic.staticPort(&mut budgetStore, &mut budgetDependencies)
  let budgetAddressed = run StaticPort.resolveRootDeclaration(&mut budgetPort, &id, b"budget",
    Span.make(usize.ZERO, usize.ZERO))
  drop budgetPort
  let budgetOwner = match move budgetAddressed {
    Result<DeclarationId, Shared<Rejection>>.Success {value} => move value
    _ => { fail InvalidModulePath {} }
  }
  let mut frozenArguments = Vector<Argument>.make()
  run Vector<Argument>.append(&mut frozenArguments, Argument.Type {value: move positional})
  let budgetApplication = run specializationWithArguments(&budgetOwner, move frozenArguments)
  let frozen = run InstanceKey.function(run SpecializationApplication.copy(&budgetApplication))
  let frozenRefused = match &frozen {
    Result<InstanceKey, CanonicalizationFailure>.Failure {error} => error == CanonicalizationFailure.Resource
    _ => false
  }
  run Testing.expect(frozenRefused,
    "a collected positional storage domain cannot publish a key after exhausting frozen traversal work")
  let mut budgetRequest = Request.make()
  let budgetValidation = run Semantic.validateApplication(&mut budgetStore, &mut budgetRequest,
    &budgetApplication, &id, Span.make(usize.ZERO, usize.ZERO))
  let validHeader = match &budgetValidation {
    Result<SpecializationApplication, Shared<Rejection>>.Success {..} => true
    _ => false
  }
  run Testing.expect(validHeader, "the actual authored generic header accepts the same application before its canonical Resource refusal")
  let budgetClosure = run Semantic.closeStaticChain(&mut budgetStore, &mut budgetRequest, &budgetApplication, usize.ONE)
  let budgetHeader = "fn budget<T>() -> () { return () }"
  let budgetStart = offsetOf(budgetText, budgetHeader, usize.ZERO)
  let mut budgetEnd = usize.ZERO
  if budgetStart != usize.MAX { budgetEnd = budgetStart + String.utf8Bytes(budgetHeader).length }
  let originalHeader = match &budgetClosure {
    StaticClosure.Rejected {diagnostic} => Shared<Rejection>.with<bool>(&diagnostic,
      fn(found: &Rejection) -> bool {
        return budgetStart != usize.MAX && budgetStart > usize.ZERO && found.code == RejectionCode.Unsupported
          && ModuleId.equals(&found.module, &id) && found.span.start == budgetStart && found.span.end == budgetEnd
      })
    _ => false
  }
  run Testing.expect(originalHeader,
    "a root closure's actual canonical Resource refusal is anchored to its original module and complete authored header")
  return ()
}

// Main lends two distinct locals; both calls reach one canonical instance and one MIR answer.
test effect fn callSitesLendingDistinctLocalsShareOneInstance() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run sharedCallerRegionClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

// Every reference a lowered function makes to instances of `callee`, in reference order.
effect fn calleeReferences(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>, callee: &[u8]) -> Vector<InstanceKey>
! OutOfMemoryError ? &mut Allocator {
  let mut keys = Vector<InstanceKey>.make()
  let index = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: at} = move index {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, at) {
      let references = Vector<MirReference>.asSlice(&function.references)
      let mut reference = usize.ZERO
      while reference < references.length {
        let identity = InstanceKey.identity(&references[reference].key)
        if Shared<DeclarationId>.with<bool>(&identity, fn(found: &DeclarationId) -> bool { return DeclarationId.named(found, callee) }) {
          run Vector<InstanceKey>.append(&mut keys, InstanceKey.copy(&references[reference].key))
        }
        reference = reference + usize.ONE
      }
    }
  }
  return move keys
}

effect fn sharedCallerRegionClaims() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("caller-region-instances.silk")
  let text = """
fn accepts(input: &i32) -> bool { return true }
pub fn main() -> i32 {
  let first: i32 = 1
  let second: i32 = 2
  let left = accepts(&first)
  let right = accepts(&second)
  if left && right { return 42 }
  return 0
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let entry = run Semantic.demandMir(&mut store, &mut request, &id, b"main")
  let keys = run calleeReferences(&store, &entry, b"accepts")
  let listed = Vector<InstanceKey>.asSlice(&keys)
  let mut shared = succeeded(&entry) && listed.length == 2
  if shared {
    shared = run InstanceKey.sameApplication(&listed[usize.ZERO], &listed[usize.ONE])
    let application = run InstanceKey.selected(&listed[usize.ZERO])
    let arguments = Vector<Argument>.asSlice(&application.arguments)
    if arguments.length == usize.ONE {
      shared = shared && match &arguments[usize.ZERO] {
        Argument.Lifetime {value} => Shared<Lifetime>.with<bool>(&value, fn(region: &Lifetime) -> bool { return suppliedAt(region, usize.ZERO) })
        _ => false
      }
    } else { shared = false }
    let firstMir = run sourceCallMir(&mut store, &mut request, &entry, &listed[usize.ZERO], usize.ZERO, false)
    let secondMir = run sourceCallMir(&mut store, &mut request, &entry, &listed[usize.ONE], usize.ONE, false)
    let firstIndex = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(&firstMir, selectedMirIndex)
    let secondIndex = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(&secondMir, selectedMirIndex)
    shared = shared && match &firstIndex {
      Option<usize>.Some {value: one} => match &secondIndex { Option<usize>.Some {value: two} => one == two _ => false }
      _ => false
    }
  }
  run Testing.expect(shared, "two calls lending distinct caller locals reach one canonical instance and one lowered MIR")
  let providedId = run module("caller-region-provision.silk")
  let providedText = """
effect fn provideMut<'env, ?S, A, P, E, ?R>(self: once Effect<'env; A ! E ? R>, provider: &'env mut P) -> A ! E ? Without<R, S>
where &'env mut P provides S from R {
  let bound = Intrinsic.bindRequirementMut<S>(move self, provider)
  return run bound
}
service Sink { effect fn put(value: &i32) -> () ? &mut Sink }
struct Cell { value: i32 }
effect fn put(self: &mut Cell, value: &i32) -> () { self.value = self.value + value.* }
impl Sink for Cell { put: Cell.put }
effect fn emit(value: &i32) -> () ? &mut Sink { run Sink.put(value) }
effect fn measured(value: &i32) -> i32 {
  let mut cell = Cell { value: 1 }
  run emit(value) |> provideMut<Sink>(&mut cell)
  return cell.value
}
fn root() -> i32 {
  let local: i32 = 41
  return run measured(&local)
}
effect fn provideWith<'env, ?S, A, P, E, F, ?R, ?Q>(self: once Effect<'env; A ! E ? R>, acquire: once Effect<'env; P ! F ? Q>)
  -> A ! E | F ? Without<R, S> | Q
where &'env mut P provides S from R {
  let mut provider = run move acquire
  let bound = Intrinsic.bindRequirementMut<S>(move self, &mut provider)
  return run bound
}
effect fn makeCell() -> Cell { return Cell { value: 1 } }
effect fn acquired(value: &i32) -> () { run emit(value) |> provideWith<Sink>(makeCell()) }
"""
  let mut providedStore = run staticSemantic(&providedId, providedText, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut providedRequest = Request.make()
  let root = run Semantic.demandMir(&mut providedStore, &mut providedRequest, &providedId, b"root")
  let measuredKeys = run calleeReferences(&providedStore, &root, b"measured")
  let measuredListed = Vector<InstanceKey>.asSlice(&measuredKeys)
  let mut provided = succeeded(&root) && measuredListed.length == usize.ONE
  if provided {
    let measuredMir = run sourceCallMir(&mut providedStore, &mut providedRequest, &root, &measuredListed[usize.ZERO], usize.ZERO, false)
    provided = succeeded(&measuredMir)
  }
  run Testing.expect(provided, "an Effect lending a caller region is provided a local exclusive provider in that caller's instance")
  let withAcquired = run Semantic.demandSignature(&mut providedStore, &mut providedRequest, &providedId, b"provideWith")
  let acquiring = run Semantic.demandBody(&mut providedStore, &mut providedRequest, &providedId, b"acquired")
  run Testing.expect(succeeded(&withAcquired) && succeeded(&acquiring),
    "a requirement row joining a Without term with another row binder resolves each operand")
  let localId = run module("local-provider-premise.silk")
  let localText = """
effect<'env> fn provideOwned<'env, ?S, A, P: 'env, E, ?R>(self: once Effect<'env; A ! E ? R>, made: P) -> A ! E ? Without<R, S>
where &'env mut P provides S from R {
  let mut provider = move made
  let bound = Intrinsic.bindRequirementMut<S>(move self, &mut provider)
  return run bound
}
effect<'env> fn provideOther<'env, ?S, A, P: 'env, Q: 'env, E, ?R>(self: once Effect<'env; A ! E ? R>, made: P, other: &'env mut Q) -> A ! E ? Without<R, S>
where &'env mut Q provides S from R {
  let mut provider = move made
  let bound = Intrinsic.bindRequirementMut<S>(move self, &mut provider)
  return run bound
}
"""
  let mut localStore = run staticSemantic(&localId, localText, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut localRequest = Request.make()
  let owned = run Semantic.demandBody(&mut localStore, &mut localRequest, &localId, b"provideOwned")
  run Testing.expect(succeeded(&owned),
    "a declared provides bound covers a local exclusive borrow of the same provider type, whatever the loan's region")
  let other = run Semantic.demandBody(&mut localStore, &mut localRequest, &localId, b"provideOther")
  run Testing.expect(rejectsSpan(&other, RejectionCode.Unsupported, localText, "&mut provider", usize.ONE),
    "a bound for a different provider type does not cover the borrowed provider")
  return ()
}

test effect fn genericRecipeCyclesKeepExactLifetimesAndSafety() -> ()
! CanonicalizationFailure | InvalidModulePath | BackendGap | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run recipeCycleSharingClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn recipeCycleSharingClaims() -> ()
! CanonicalizationFailure | InvalidModulePath | BackendGap | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("recipe-cycle-sharing.silk")
  let first = run recipeControlKey(&id, b"cycle", false)
  let second = run recipeControlKey(&id, b"cycle", true)
  let unrelated = run recipeControlKey(&id, b"unrelated", false)
  let selfEdge = [InstanceKey.copy(&first)]
  let firstEdge = [InstanceKey.copy(&second)]
  let secondEdge = [InstanceKey.copy(&first)]
  let empty = Vector<InstanceKey>.make()
  let mut single = Vector<ControlRecipe>.make()
  run appendRecipeControl(&mut single, &first, &selfEdge, Option<bool>.none(), true)
  let alone = run recipeControlPlan(Vector<ControlRecipe>.asSlice(&single))
  let mut alternating = Vector<ControlRecipe>.make()
  run appendRecipeControl(&mut alternating, &first, &firstEdge, Option<bool>.none(), true)
  run appendRecipeControl(&mut alternating, &second, &secondEdge, Option<bool>.none(), false)
  let paired = run recipeControlPlan(Vector<ControlRecipe>.asSlice(&alternating))
  let firstAt = run recipeIdentityAt(&paired, &first)
  let secondAt = run recipeIdentityAt(&paired, &second)
  let selfEquivalent = run recipePlansAgree(&alone, &paired, &first)
  run Testing.expect(
    firstAt != secondAt && Vector<EmissionIdentity>.length(&paired.identities) == 2 && selfEquivalent,
    "self and mutual recursion preserve each exact lifetime instance symbol without graph-derived identity",
  )
  run Testing.expect(
    Vector<EmissionIdentity>.asSlice(&paired.identities)[firstAt].borrow == BorrowStatus.Checked
      && Vector<EmissionIdentity>.asSlice(&paired.identities)[secondAt].borrow != BorrowStatus.Checked
      && Vector<EmissionIdentity>.asSlice(&alone.identities)[usize.ZERO].borrow == BorrowStatus.Checked,
    "each exact recursive instance retains its own checked safety evidence",
  )
  let mut reversed = Vector<ControlRecipe>.make()
  run appendRecipeControl(&mut reversed, &unrelated, Vector<InstanceKey>.asSlice(&empty), Option<bool>.some(true), true)
  run appendRecipeControl(&mut reversed, &second, &secondEdge, Option<bool>.none(), false)
  run appendRecipeControl(&mut reversed, &first, &firstEdge, Option<bool>.none(), true)
  let reordered = run recipeControlPlan(Vector<ControlRecipe>.asSlice(&reversed))
  let reversedAt = run recipeIdentityAt(&reordered, &first)
  let firstEquivalent = run recipePlansAgree(&paired, &reordered, &first)
  let secondEquivalent = run recipePlansAgree(&paired, &reordered, &second)
  run Testing.expect(
    firstEquivalent && secondEquivalent && Vector<EmissionIdentity>.asSlice(&reordered.identities)[reversedAt].borrow == BorrowStatus.Checked,
    "reversed representative order and an unrelated first component change neither canonical identity nor safety reporting")
}

test effect fn genericRecipeMutualCyclesIgnoreLeafBodies() -> ()
! CanonicalizationFailure | InvalidModulePath | BackendGap | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run recipeTransitiveCycleClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn recipeTransitiveCycleClaims() -> ()
! CanonicalizationFailure | InvalidModulePath | BackendGap | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("recipe-cycle-stability.silk")
  let outer = run recipeControlKey(&id, b"outer", false)
  let inner = run recipeControlKey(&id, b"inner", false)
  let leaf = run recipeControlKey(&id, b"leaf", false)
  let outerEdges = [InstanceKey.copy(&inner)]
  let innerEdges = [InstanceKey.copy(&outer), InstanceKey.copy(&leaf)]
  let empty = Vector<InstanceKey>.make()
  let mut before = Vector<ControlRecipe>.make()
  run appendRecipeControl(&mut before, &outer, &outerEdges, Option<bool>.none(), true)
  run appendRecipeControl(&mut before, &inner, &innerEdges, Option<bool>.none(), true)
  run appendRecipeControl(
    &mut before,
    &leaf,
    Vector<InstanceKey>.asSlice(&empty),
    Option<bool>.some(true),
    true,
  )
  let original = run recipeControlPlan(Vector<ControlRecipe>.asSlice(&before))
  let mut after = Vector<ControlRecipe>.make()
  run appendRecipeControl(
    &mut after,
    &leaf,
    Vector<InstanceKey>.asSlice(&empty),
    Option<bool>.some(false),
    true,
  )
  run appendRecipeControl(&mut after, &inner, &innerEdges, Option<bool>.none(), true)
  run appendRecipeControl(&mut after, &outer, &outerEdges, Option<bool>.none(), true)
  let changed = run recipeControlPlan(Vector<ControlRecipe>.asSlice(&after))
  let outerSame = run recipePlansAgree(&original, &changed, &outer)
  let innerSame = run recipePlansAgree(&original, &changed, &inner)
  let leafSame = run recipePlansAgree(&original, &changed, &leaf)
  run Testing.expect(
    outerSame && innerSame && leafSame,
    "a leaf body edit preserves both mutually recursive caller symbols and the leaf linkage identity",
  )
  run Testing.expect(
    !EmissionPlan.hasSymbolConflict(&original) && !EmissionPlan.hasSymbolConflict(&changed),
    "recursive exact identities resolve consistently in both discovery orders",
  )
  let forward = [InstanceKey.copy(&inner), InstanceKey.copy(&leaf)]
  let backward = [InstanceKey.copy(&leaf), InstanceKey.copy(&inner)]
  let first = run recipeControlMir(&outer, &forward, Option<bool>.none(), true)
  let second = run recipeControlMir(&outer, &backward, Option<bool>.none(), true)
  let layouts = Vector<TypeLayout>.make()
  let foreign = Vector<CAbi.Signature>.make()
  let one = run InstanceText.content(
    &first,
    &MachineTarget.forId(TargetId.X8664UnknownLinuxGnu),
    Vector<TypeLayout>.asSlice(&layouts),
    Vector<CAbi.Signature>.asSlice(&foreign),
    b"",
  )
  let two = run InstanceText.content(
    &second,
    &MachineTarget.forId(TargetId.X8664UnknownLinuxGnu),
    Vector<TypeLayout>.asSlice(&layouts),
    Vector<CAbi.Signature>.asSlice(&foreign),
    b"",
  )
  run Testing.expect(
    !sameBytes(Bytes.asSlice(&one), Bytes.asSlice(&two)),
    "LLVM content retains call-site order even though linkage does not contain instruction bodies",
  )
  let unchecked = run recipeControlMir(&outer, &forward, Option<bool>.none(), false)
  let three = run InstanceText.content(
    &unchecked,
    &MachineTarget.forId(TargetId.X8664UnknownLinuxGnu),
    Vector<TypeLayout>.asSlice(&layouts),
    Vector<CAbi.Signature>.asSlice(&foreign),
    b"",
  )
  run Testing.expect(sameBytes(Bytes.asSlice(&one), Bytes.asSlice(&three)),
    "LLVM content does not depend on the body's borrow-checking verdict")
}

fn llvmAnswerIndex(answer: &Result<Answer, NoRejection>) -> usize {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.LlvmText {index}} => index
      _ => usize.MAX
    }
    _ => usize.MAX
  }
}

fn llvmAnswerId(answer: &Result<Answer, NoRejection>) -> usize {
  return Pointer.address<Result<Answer, NoRejection>>(
    Pointer.fromRef<Result<Answer, NoRejection>>(answer),
  )
}

fn llvmBuildTextEqual(first: &BackendBuild, second: &BackendBuild) -> bool {
  return match & first.* {
    BackendBuild.Module {text, ..} => match & second.* {
      BackendBuild.Module {text: compared, ..} => sameBytes(
        Bytes.asSlice(&text),
        Bytes.asSlice(&compared),
      )
      _ => false
    }
    _ => false
  }
}

// Fixed internal runtime helpers precede the sorted authored instance definitions.
fn llvmInstanceDefinitionsSorted(built: &BackendBuild) -> bool {
  if let BackendBuild.Module {text: bytes, ..} = &built.* {
    let text = Bytes.asSlice(&bytes)
    let mut previous = usize.ZERO
    let mut previousLength = usize.ZERO
    let mut count = usize.ZERO
    let mut start = usize.ZERO
    while start < text.length {
      let mut end = start
      while end < text.length && text[end] != 10 {
        end = end + usize.ONE
      }
      if end - start > 7 && sameBytes(Slice.view<u8>(text, start, 7), b"define ")
        && !(end - start >= 16 && sameBytes(Slice.view<u8>(text, start, 16), b"define internal ")) {
        let mut symbol = start + 7
        while symbol < end && text[symbol] != 64 {
          symbol = symbol + usize.ONE
        }
        if symbol == end {
          return false
        }
        symbol = symbol + usize.ONE
        let mut tail = symbol
        while tail < end && text[tail] != 40 {
          tail = tail + usize.ONE
        }
        if tail == end {
          return false
        }
        if count > usize.ZERO && !RuntimeEncoding.less(
          Slice.view<u8>(text, previous, previousLength),
          Slice.view<u8>(text, symbol, tail - symbol),
        ) {
          return false
        }
        previous = symbol
        previousLength = tail - symbol
        count = count + usize.ONE
      }
      start = end + usize.ONE
    }
    return count > usize.ZERO
  }
  return false
}

test effect fn llvmInstanceAnswersReuseAcrossBuildAndLeafBodyEdit() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run llvmReuseClaims()
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn llvmReuseClaims() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
? &mut Allocator | &mut Types {
  let id = run module("llvm-reuse.silk")
  let initial = run present(
    "fn leaf() -> i32 { return 1 + 10 }\nfn identity<'a>(value: &'a i32) -> i32 { return value.* }\nfn caller() -> i32 { let held = 2 return identity(&held) + leaf() }\npub fn main() -> i32 { return caller() }\n",
  )
  let authored = run Revision.publish(&Revision.make(), &id, &initial)
  let first = run withEntryRuntime(&authored)
  let mut index = SourceIndex.make(run Revision.copy(&first))
  let callerDeclaration = run requireIndexedIdentity(
    &mut index,
    &id,
    OwnerKind.Function,
    b"caller",
    usize.ZERO,
  )
  let leafDeclaration = run requireIndexedIdentity(
    &mut index,
    &id,
    OwnerKind.Function,
    b"leaf",
    usize.ZERO,
  )
  let caller = run InstanceKey.named(&run Shared<DeclarationId>.make(DeclarationId.copy(&callerDeclaration)))
  let leaf = run InstanceKey.named(&run Shared<DeclarationId>.make(DeclarationId.copy(&leafDeclaration)))
  let mut store = makeSemantic(run Revision.copy(&first))
  let mut request = Request.forApplication(ModuleId.copy(&id))
  let cold = run buildApplication(&mut store, &mut request, staticClosureNodes)
  let callerCold = run Semantic.demandInstanceText(&mut store, &mut request, &caller, &callerDeclaration, Span.make(usize.ZERO, usize.ZERO), false)
  let leafCold = run Semantic.demandInstanceText(&mut store, &mut request, &leaf, &leafDeclaration, Span.make(usize.ZERO, usize.ZERO), false)
  run Testing.expect(
    Shared<Result<Answer, NoRejection>>.with<bool>(&callerCold, llvmAnswerDependencies),
    "a caller LLVM answer records its MIR, layouts and signature dependencies without demanding callee bodies or text",
  )
  let produced = starts(Semantic.eventLog(&store), Family.LlvmText)
  run Testing.expect(
    Semantic.requestDemanded(&mut store, &request, Family.Mir, &id) && Semantic.requestDemanded(
      &mut store, &request,
      Family.Signature,
      &id,
    ),
    "instance text preparation retains its request demand footprint",
  )
  let warm = run buildApplication(&mut store, &mut request, staticClosureNodes)
  run Testing.expect(
    produced == 6 && starts(Semantic.eventLog(&store), Family.LlvmText) == produced && hits(
      Semantic.eventLog(&store),
      Family.LlvmText,
    ) >= 6 && llvmBuildTextEqual(&cold, &warm) && llvmInstanceDefinitionsSorted(&cold) && llvmInstanceDefinitionsSorted(
      &warm,
    ),
    "a second build reuses every instance LLVM answer, including the runtime's C export shim",
  )
  let mut scoped = Request.forApplication(ModuleId.copy(&id))
  let scopedBuild = run buildApplication(&mut store, &mut scoped, staticClosureNodes)
  run Testing.expect(
    starts(Semantic.eventLog(&store), Family.LlvmText) == produced && llvmBuildTextEqual(
      &cold,
      &scopedBuild,
    ),
    "identical LLVM content is reused across semantic requests",
  )
  let changed = run present(
    "fn leaf() -> i32 { return 2 + 20 }\nfn identity<'a>(value: &'a i32) -> i32 { return value.* }\nfn caller() -> i32 { let held = 2 return identity(&held) + leaf() }\npub fn main() -> i32 { return caller() }\n",
  )
  let second = run Revision.publish(&first, &id, &changed)
  run Semantic.update(&mut store, run Revision.copy(&second))
  let edited = run buildApplication(&mut store, &mut request, staticClosureNodes)
  let callerEdited = run Semantic.demandInstanceText(&mut store, &mut request, &caller, &callerDeclaration, Span.make(usize.ZERO, usize.ZERO), false)
  let leafEdited = run Semantic.demandInstanceText(&mut store, &mut request, &leaf, &leafDeclaration, Span.make(usize.ZERO, usize.ZERO), false)
  let oldCaller = Shared<Result<Answer, NoRejection>>.with<usize>(&callerCold, llvmAnswerIndex)
  let newCaller = Shared<Result<Answer, NoRejection>>.with<usize>(&callerEdited, llvmAnswerIndex)
  let oldLeaf = Shared<Result<Answer, NoRejection>>.with<usize>(&leafCold, llvmAnswerIndex)
  let newLeaf = Shared<Result<Answer, NoRejection>>.with<usize>(&leafEdited, llvmAnswerIndex)
  run Testing.expect(
    oldCaller != usize.MAX && oldCaller == newCaller && Shared<
      Result<Answer, NoRejection>,
    >.with<
      usize,
    >(&callerCold, llvmAnswerId) == Shared<Result<Answer, NoRejection>>.with<usize>(
      &callerEdited,
      llvmAnswerId,
    ) && oldLeaf != usize.MAX && newLeaf != usize.MAX && oldLeaf != newLeaf && starts(
      Semantic.eventLog(&store),
      Family.LlvmText,
    ) == produced + usize.ONE && !llvmBuildTextEqual(&cold, &edited) && llvmInstanceDefinitionsSorted(
      &edited,
    ),
    "editing a leaf body publishes only its new text answer and changes the artifact, reusing caller answers",
  )
  let mut freshSecond = makeSemantic(run Revision.copy(&second))
  let mut freshSecondRequest = Request.forApplication(ModuleId.copy(&id))
  let freshLeaf = run Semantic.demandInstanceText(&mut freshSecond, &mut freshSecondRequest, &leaf, &leafDeclaration, Span.make(usize.ZERO, usize.ZERO), false)
  run Testing.expect(agreesWithFresh(&leafEdited, &freshLeaf), "the edited leaf text answer agrees with a fresh store of the same revision")
  let values = Semantic.instanceTexts(&store)
  run Testing.expect(
    sameBytes(Bytes.asSlice(&values[oldCaller].symbol), Bytes.asSlice(&values[newCaller].symbol)) && sameBytes(
      Bytes.asSlice(&values[oldLeaf].symbol),
      Bytes.asSlice(&values[newLeaf].symbol),
    ),
    "caller and leaf linkage symbols depend on instance identity, not body content",
  )
}

fn llvmAnswerDependencies(answer: &Result<Answer, NoRejection>) -> bool {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    let entries = Vector<Dependency>.asSlice(&value.dependencies)
    let mut mir = false
    let mut layout = false
    let mut signature = false
    let mut at = usize.ZERO
    while at < entries.length {
      mir = mir || entries[at].family == Family.Mir
      layout = layout || entries[at].family == Family.Layout
      signature = signature || entries[at].family == Family.Signature
      // Own MIR encapsulates lowering; the text answer never demands another body or text.
      if entries[at].family == Family.Body || entries[at].family == Family.LlvmText {
        return false
      }
      at = at + usize.ONE
    }
    return mir && layout && signature
  }
  return false
}

test effect fn llvmRecursiveAnswersReuseAfterLeafEdit() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run llvmRecursiveClaims()
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn llvmRecursiveClaims() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
? &mut Allocator | &mut Types {
  let id = run module("llvm-recursive.silk")
  let initial = run present(
    "fn leaf() -> i32 { return 1 }\nfn recur(n: i32) -> i32 { if n == 0 { return 0 } return recur(n - 1) + 1 }\nfn left(n: i32) -> i32 { if n == 0 { return leaf() } return right(n - 1) }\nfn right(n: i32) -> i32 { if n == 0 { return leaf() } return left(n - 1) }\npub fn main() -> i32 { return left(recur(2)) }\n",
  )
  let authored = run Revision.publish(&Revision.make(), &id, &initial)
  let first = run withEntryRuntime(&authored)
  let mut index = SourceIndex.make(run Revision.copy(&first))
  let recurDeclaration = run requireIndexedIdentity(
    &mut index,
    &id,
    OwnerKind.Function,
    b"recur",
    usize.ZERO,
  )
  let leftDeclaration = run requireIndexedIdentity(
    &mut index,
    &id,
    OwnerKind.Function,
    b"left",
    usize.ZERO,
  )
  let rightDeclaration = run requireIndexedIdentity(
    &mut index,
    &id,
    OwnerKind.Function,
    b"right",
    usize.ZERO,
  )
  let recur = run InstanceKey.named(&run Shared<DeclarationId>.make(DeclarationId.copy(&recurDeclaration)))
  let left = run InstanceKey.named(&run Shared<DeclarationId>.make(DeclarationId.copy(&leftDeclaration)))
  let right = run InstanceKey.named(&run Shared<DeclarationId>.make(DeclarationId.copy(&rightDeclaration)))
  let mut store = makeSemantic(run Revision.copy(&first))
  let mut request = Request.forApplication(ModuleId.copy(&id))
  let cold = run buildApplication(&mut store, &mut request, staticClosureNodes)
  let recurCold = run Semantic.demandInstanceText(&mut store, &mut request, &recur, &recurDeclaration, Span.make(usize.ZERO, usize.ZERO), false)
  let leftCold = run Semantic.demandInstanceText(&mut store, &mut request, &left, &leftDeclaration, Span.make(usize.ZERO, usize.ZERO), false)
  let rightCold = run Semantic.demandInstanceText(&mut store, &mut request, &right, &rightDeclaration, Span.make(usize.ZERO, usize.ZERO), false)
  let produced = starts(Semantic.eventLog(&store), Family.LlvmText)
  let changed = run present(
    "fn leaf() -> i32 { return 22 }\nfn recur(n: i32) -> i32 { if n == 0 { return 0 } return recur(n - 1) + 1 }\nfn left(n: i32) -> i32 { if n == 0 { return leaf() } return right(n - 1) }\nfn right(n: i32) -> i32 { if n == 0 { return leaf() } return left(n - 1) }\npub fn main() -> i32 { return left(recur(2)) }\n",
  )
  let second = run Revision.publish(&first, &id, &changed)
  run Semantic.update(&mut store, run Revision.copy(&second))
  let edited = run buildApplication(&mut store, &mut request, staticClosureNodes)
  let recurEdited = run Semantic.demandInstanceText(&mut store, &mut request, &recur, &recurDeclaration, Span.make(usize.ZERO, usize.ZERO), false)
  let leftEdited = run Semantic.demandInstanceText(&mut store, &mut request, &left, &leftDeclaration, Span.make(usize.ZERO, usize.ZERO), false)
  let rightEdited = run Semantic.demandInstanceText(&mut store, &mut request, &right, &rightDeclaration, Span.make(usize.ZERO, usize.ZERO), false)
  run Testing.expect(
    produced == 7 && starts(Semantic.eventLog(&store), Family.LlvmText) == produced + usize.ONE && !llvmBuildTextEqual(
      &cold,
      &edited,
    ) && Shared<Result<Answer, NoRejection>>.with<usize>(&recurCold, llvmAnswerIndex) != usize.MAX && Shared<
      Result<Answer, NoRejection>,
    >.with<
      usize,
    >(&recurCold, llvmAnswerId) == Shared<Result<Answer, NoRejection>>.with<usize>(
      &recurEdited,
      llvmAnswerId,
    ) && Shared<Result<Answer, NoRejection>>.with<usize>(&leftCold, llvmAnswerId) == Shared<
      Result<Answer, NoRejection>,
    >.with<
      usize,
    >(&leftEdited, llvmAnswerId) && Shared<Result<Answer, NoRejection>>.with<usize>(
      &rightCold,
      llvmAnswerId,
    ) == Shared<Result<Answer, NoRejection>>.with<usize>(&rightEdited, llvmAnswerId),
    "self and mutually recursive LLVM answers and their symbols survive a leaf edit without a text-query cycle",
  )
  let mut freshSecond = makeSemantic(move second)
  let mut freshSecondRequest = Request.forApplication(ModuleId.copy(&id))
  let freshLeft = run Semantic.demandInstanceText(&mut freshSecond, &mut freshSecondRequest, &left, &leftDeclaration, Span.make(usize.ZERO, usize.ZERO), false)
  run Testing.expect(agreesWithFresh(&leftEdited, &freshLeft), "the recursive text answer agrees with a fresh store of the same revision")
}

fn llvmGapSpan(answer: &Result<Answer, NoRejection>) -> Span {
  let gap = selectedBackendGap(answer)
  if let Option<Shared<BackendGap>>.Some {value} = move gap {
    return Shared<BackendGap>.with<Span>(&value, BackendGap.span)
  }
  return Span.make(usize.MAX, usize.MAX)
}

test effect fn completedInstanceTextGapRefreshesItsSourceSpan() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run instanceTextGapClaims()
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn instanceTextGapClaims() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
? &mut Allocator | &mut Types {
  let id = run module("llvm-gap.silk")
  // A C export keeps every written parameter as a C lane, and a unit parameter has none.
  let initial = run present("export \"C\" fn sink(value: ()) -> () as \"sink\" { return () }\n")
  let first = run Revision.publish(&Revision.make(), &id, &initial)
  let mut index = SourceIndex.make(run Revision.copy(&first))
  let declaration = run requireIndexedIdentity(
    &mut index,
    &id,
    OwnerKind.Function,
    b"sink",
    usize.ZERO,
  )
  let instance = InstanceKey.Export {
    function: run Shared<DeclarationId>.make(DeclarationId.copy(&declaration)),
    symbol: run Shared<Bytes>.make(run Bytes.copy(b"sink")),
  }
  let mut store = makeSemantic(run Revision.copy(&first))
  let mut request = Request.make()
  let cold = run Semantic.demandInstanceText(&mut store, &mut request, &instance, &declaration, Span.make(usize.ZERO, usize.ZERO), false)
  let warm = run Semantic.demandInstanceText(&mut store, &mut request, &instance, &declaration, Span.make(usize.ZERO, usize.ZERO), false)
  let span = Shared<Result<Answer, NoRejection>>.with<Span>(&cold, llvmGapSpan)
  run Testing.expect(
    span.start != usize.MAX && span.end > span.start && Shared<
      Result<Answer, NoRejection>,
    >.with<
      bool,
    >(
      &cold,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return pipelineGapAt(answer, GapCode.UnitParameter, b"sink", span.start, span.end)
      },
    ) && Shared<
      Result<Answer, NoRejection>,
    >.with<
      usize,
    >(&cold, llvmAnswerId) == Shared<Result<Answer, NoRejection>>.with<usize>(&warm, llvmAnswerId) && Semantic.instanceTexts(
      &store,
    ).length == usize.ZERO,
    "a completed instance-text gap is reused without publishing a partial definition",
  )
  let changed = run present("\nexport \"C\" fn sink(value: ()) -> () as \"sink\" { return () }\n")
  let second = run Revision.publish(&first, &id, &changed)
  run Semantic.update(&mut store, run Revision.copy(&second))
  let edited = run Semantic.demandInstanceText(&mut store, &mut request, &instance, &declaration, Span.make(usize.ZERO, usize.ZERO), false)
  run Testing.expect(
    Shared<Result<Answer, NoRejection>>.with<bool>(
      &edited,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return pipelineGapAt(
          answer,
          GapCode.UnitParameter,
          b"sink",
          span.start + usize.ONE,
          span.end + usize.ONE,
        )
      },
    ) && Semantic.instanceTexts(&store).length == usize.ZERO,
    "equal unsupported content retries after source movement and reports the current declaration span",
  )
  let mut freshSecond = makeSemantic(move second)
  let mut freshSecondRequest = Request.make()
  let freshEdited = run Semantic.demandInstanceText(&mut freshSecond, &mut freshSecondRequest, &instance, &declaration, Span.make(usize.ZERO, usize.ZERO), false)
  run Testing.expect(agreesWithFresh(&edited, &freshEdited), "the moved gap answer agrees with a fresh store of the same revision")
}

test effect fn llvmCalleeSignatureEditInvalidatesCallerAnswer() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run llvmSignatureClaims()
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn llvmSignatureClaims() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
? &mut Allocator | &mut Types {
  let id = run module("llvm-signature.silk")
  let initial = run present(
    "fn leaf() -> i32 { return 1 }\npub fn main() -> i32 { let value = leaf() return 0 }\n",
  )
  let first = run Revision.publish(&Revision.make(), &id, &initial)
  let mut index = SourceIndex.make(run Revision.copy(&first))
  let declaration = run requireIndexedIdentity(
    &mut index,
    &id,
    OwnerKind.Function,
    b"main",
    usize.ZERO,
  )
  let caller = run InstanceKey.named(&run Shared<DeclarationId>.make(DeclarationId.copy(&declaration)))
  let mut store = makeSemantic(run Revision.copy(&first))
  let mut request = Request.make()
  let cold = run Semantic.demandInstanceText(&mut store, &mut request, &caller, &declaration, Span.make(usize.ZERO, usize.ZERO), false)
  let changed = run present(
    "fn leaf() -> u32 { return 1 }\npub fn main() -> i32 { let value = leaf() return 0 }\n",
  )
  let second = run Revision.publish(&first, &id, &changed)
  run Semantic.update(&mut store, run Revision.copy(&second))
  let edited = run Semantic.demandInstanceText(&mut store, &mut request, &caller, &declaration, Span.make(usize.ZERO, usize.ZERO), false)
  run Testing.expect(
    Shared<Result<Answer, NoRejection>>.with<usize>(&cold, llvmAnswerIndex) != usize.MAX && Shared<
      Result<Answer, NoRejection>,
    >.with<
      usize,
    >(&edited, llvmAnswerIndex) != usize.MAX && Shared<Result<Answer, NoRejection>>.with<usize>(
      &cold,
      llvmAnswerIndex,
    ) != Shared<Result<Answer, NoRejection>>.with<usize>(&edited, llvmAnswerIndex),
    "a callee signature edit invalidates its caller's text answer even when both result types use i32 lanes",
  )
  let mut freshSecond = makeSemantic(move second)
  let mut freshSecondRequest = Request.make()
  let freshEdited = run Semantic.demandInstanceText(&mut freshSecond, &mut freshSecondRequest, &caller, &declaration, Span.make(usize.ZERO, usize.ZERO), false)
  run Testing.expect(agreesWithFresh(&edited, &freshEdited), "the invalidated caller text answer agrees with a fresh store of the same revision")
}

test effect fn genericRecipeMissingIdentityIsLoudGap() -> ()
! CanonicalizationFailure | InvalidModulePath | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run recipeMissingIdentityClaims()
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn recipeMissingIdentityClaims() -> ()
! CanonicalizationFailure | InvalidModulePath | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("recipe-missing.silk")
  let absent = run recipeControlKey(&id, b"absent", false)
  let plan = EmissionPlan.empty()
  let result = run Effect.result(EmissionPlan.symbol(&plan, &absent))
  let rejected = match &result {
    Result<Bytes, BackendGap | OutOfMemoryError>.Failure {error} => match & error {
      BackendGap {code, owner, source} => code == GapCode.CalleeModule
        && Shared<DeclarationId>.with<bool>(&owner, fn(value: &DeclarationId) -> bool {
          return DeclarationId.named(value, b"absent") && ModuleId.equals(
            DeclarationId.moduleId(value),
            &id,
          )
        }) && match &source {
          GapSource.Declaration {span, ..} => span.start == usize.ZERO && span.end == usize.ZERO
          _ => false
        }
      _ => false
    }
    _ => false
  }
  run Testing.expect(
    rejected,
    "an absent exact identity reports callee-module at its declaration span",
  )
}

fn genericGapOwnerMatches(value: &BackendGap, module: &ModuleId, name: &[u8]) -> bool {
  return Shared<DeclarationId>.with<bool>(&value.owner, fn(owner: &DeclarationId) -> bool {
    return DeclarationId.named(owner, name) && ModuleId.equals(DeclarationId.moduleId(owner), module)
  })
}

test effect fn genericPropagatedForeignGapKeepsLibrarySource() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let entry = run module("generic-gap-main.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let library = run module("callback_library.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let entryText = """import callback_library { create }
pub fn main() -> i32 { let callback = unsafe create() drop callback return 42 }
"""
  let libraryText = """pub unsafe extern "C" fn create() -> extern "C" fn(i32) -> i32
"""
  let entrySource = run present(entryText) |> Effect.provideMut<Allocator>(&mut allocator)
  let librarySource = run present(libraryText) |> Effect.provideMut<Allocator>(&mut allocator)
  let first = run Revision.publish(&Revision.make(), &entry, &entrySource) |> Effect.provideMut<Allocator>(&mut allocator)
  let held = run Revision.publish(&first, &library, &librarySource) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut store = makeSemantic(move held)
  let mut request = Request.make()
  let mir = run Semantic.demandMir(&mut store, &mut request, &entry, b"main") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let gap = Shared<Result<Answer, NoRejection>>.with<Option<Shared<BackendGap>>>(&mir, selectedBackendGap)
  let retained = match move gap {
    Option<Shared<BackendGap>>.Some {value} => Shared<BackendGap>.with<bool>(&value, fn(found: &BackendGap) -> bool {
      let span = BackendGap.span(found)
      return found.code == GapCode.CAbiCallback && BackendGap.moduleMatches(found, &library)
        && !BackendGap.moduleMatches(found, &entry) && span.start == usize.ZERO
        && span.end == String.utf8Bytes(libraryText).length - usize.ONE
        && genericGapOwnerMatches(found, &entry, b"main")
    })
    Option<Shared<BackendGap>>.None => false
  }
  run Testing.expect(retained, "an imported callback signature keeps its library span and module independently of the reached main owner")
  return ()
}

test effect fn genericEffectRunsCallTheirSpecializedInstance() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("generic-effect-runs.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
effect fn produce<T>(value: &T) -> i32 { return 41 }
fn ordinary() -> i32 {
  let held = 5
  return (run produce<i32>(&held)) + 1
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let mir = run Semantic.demandMir(&mut store, &mut request, &id, b"ordinary") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(succeeded(&mir) && failureFact(&store, &mir, 2) == usize.ZERO,
    "running a generic effect fn construction is a direct call of its specialized instance")
  return ()
}

fn signatureResultOf(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Signature {signature}} => Option<Shared<Type>>.some(writtenResult(&signature.result))
      _ => Option<Shared<Type>>.none()
    }
    Result<Answer, NoRejection>.Failure {error: _} => Option<Shared<Type>>.none()
  }
}

fn effectRowOf(found: &Option<Shared<Type>>) -> Option<Shared<Row>> {
  if let Option<Shared<Type>>.Some {value} = &found.* {
    return Shared<Type>.with<Option<Shared<Row>>>(&value, effectRequirements)
  }
  return Option<Shared<Row>>.none()
}

// Whether an Effect type's requirement row has these entry, row-parameter, and `Without` counts.
fn effectRowCounts(found: &Option<Shared<Type>>, entries: usize, parameters: usize, subtractions: usize) -> bool {
  if let Option<Shared<Row>>.Some {value} = move effectRowOf(found) {
    return Shared<Row>.with<bool>(&value, fn(row: &Row) -> bool {
      return Vector<Requirement>.length(&row.entries) == entries && Vector.length(&row.parameters) == parameters && Vector.length(
        &row.subtractions,
      ) == subtractions
    })
  }
  return false
}

effect fn sameEffectRows(left: &Option<Shared<Type>>, right: &Option<Shared<Type>>) -> bool
! OutOfMemoryError
? &mut Allocator | &mut Types {
  let first = effectRowOf(left)
  let second = effectRowOf(right)
  if let Option<Shared<Row>>.Some {value: from} = move first {
    if let Option<Shared<Row>>.Some {value: to} = move second {
      return run Row.equalsShared(&from, &to)
    }
  }
  return false
}

// Each provision claim group resolves only the declarations it needs.
fn providedRowsFixture(part: usize) -> string<'static> {
  if part == 0 {
    return """
service Clock {}
service Logger {}
role Primary
struct SystemClock {}
impl Clock for SystemClock {}
struct Holder<?H> {}
fn read() -> once Effect<'static; i32 ? &Clock | &Logger> { return missing }
fn bind<'p, ?S, A, P, E, ?R>(self: once Effect<'static; A ! E ? R>, provider: &'p P) -> Effect<'static; A ! E ? Without<R, S>>
where &'p P provides S from R { return missing }
fn kept() -> Effect<'static; i32 ? &Logger> { return missing }
fn clockOnly() -> Effect<'static; i32 ? &Clock> { return missing }
fn residual() -> Effect<'static; i32 ? Without<&mut Clock at Primary | &Logger, Clock at Primary>> { return missing }
fn absentKey() -> Effect<'static; i32 ? Without<&Logger, Clock>> { return missing }
fn nested<?R>(left: Holder<Without<Without<R, Clock>, Logger>>, right: Holder<Without<R, Logger | Clock>>) -> i32 { return 0 }
fn decided<?R>(left: Holder<Without<&Clock | R, &Clock>>, right: Holder<Without<R, Clock>>) -> i32 { return 0 }
fn decidedKey<?R>(left: Holder<Without<&Logger | R, Clock>>, right: Holder<Without<R, Clock> | &Logger>) -> i32 { return 0 }
"""
  }
  if part == 1 {
    return """
service Clock {}
service Logger {}
role Primary
struct SystemClock {}
impl Clock for SystemClock {}
effect fn read() -> i32 ? &Clock | &Logger { return 1 }
effect fn logged() -> i32 ? &Logger { return 1 }
effect fn twice() -> i32 ? &Clock | &Clock at Primary { return 1 }
effect fn advance() -> i32 ? &mut Clock { return 1 }
effect fn mixed() -> i32 ? &Clock at Primary | &mut Clock { return 1 }
effect fn bind<'p, ?S, A, P, E, ?R>(self: once Effect<'static; A ! E ? R>, provider: &'p P) -> A ! E ? Without<R, S>
where &'p P provides S from R { return missing }
effect fn bindMut<'p, ?S, A, P, E, ?R>(self: once Effect<'static; A ! E ? R>, provider: &'p mut P) -> A ! E ? Without<R, S>
where &'p mut P provides S from R { return missing }
effect fn inferred(clock: &SystemClock) -> i32 ? &Logger { return run bind(read(), clock) }
effect fn tight(clock: &SystemClock) -> i32 ? &Clock { return run bind(read(), clock) }
effect fn explicit(clock: &SystemClock) -> i32 ? &Logger { return run bind<Clock>(read(), clock) }
effect fn chosen(clock: &SystemClock) -> i32 ? &Clock { return run bind<Clock at Primary>(twice(), clock) }
effect fn exclusive(clock: &mut SystemClock) -> i32 { return run bindMut(advance(), &mut clock) }
effect fn absent(clock: &SystemClock) -> i32 ? &Logger { return run bind(logged(), clock) }
effect fn ambiguous(clock: &SystemClock) -> i32 ? &Clock { return run bind(twice(), clock) }
effect fn shared(clock: &SystemClock) -> i32 { return run bind(advance(), clock) }
effect fn weak(clock: &SystemClock) -> i32 ? &Clock at Primary { return run bind(mixed(), clock) }
effect fn missingKey(clock: &SystemClock) -> i32 ? &Logger { return run bind<Clock>(logged(), clock) }
effect fn foreignKey(clock: &SystemClock) -> i32 ? &Clock { return run bind<Logger>(read(), clock) }
effect fn twoKeys(clock: &SystemClock) -> i32 { return run bind<Clock | Logger>(read(), clock) }
effect fn accessKey(clock: &SystemClock) -> i32 ? &Logger { return run bind<&Clock>(read(), clock) }
effect fn bindBorrowed<'p, A, P, E, ?R>(self: once Effect<'static; A ! E ? R>, provider: &'p P) -> A ! E ? Without<R, Clock>
where &'p P provides &Clock from R { return missing }
effect fn borrowedSelector(clock: &SystemClock) -> i32 ? &Logger { return run bindBorrowed(read(), clock) }
"""
  }
  if part == 2 {
    return """
service Clock {}
service Logger {}
struct SystemClock {}
struct Doubled {}
impl Clock for Doubled {}
impl Clock for Doubled {}
effect fn read() -> i32 ? &Clock | &Logger { return 1 }
effect fn bind<'p, ?S, A, P, E, ?R>(self: once Effect<'static; A ! E ? R>, provider: &'p P) -> A ! E ? Without<R, S>
where &'p P provides S from R { return missing }
effect fn witnesses(clock: &Doubled) -> i32 ? &Logger { return run bind(read(), clock) }
effect fn covered(pending: once Effect<'static; i32 ? Without<&Clock | &Logger, Clock>>) -> i32 ? &Logger { return run move pending }
effect fn uncovered(pending: once Effect<'static; i32 ? Without<&Clock | &Logger, Clock>>) -> i32 { return run move pending }
effect fn forward<?S, ?R>(pending: once Effect<'static; i32 ? Without<R, S>>) -> i32 ? Without<R, S> { return run move pending }
effect fn widened<?S, ?R>(pending: once Effect<'static; i32 ? Without<R, S>>) -> i32 ? R { return run move pending }
effect fn leaks<?S, ?R>(pending: once Effect<'static; i32 ? Without<R, S>>) -> i32 { return run move pending }
"""
  }
  if part == 3 {
    return """
service Clock {}
struct SystemClock {}
impl Clock for SystemClock {}
struct Holder<?H> {}
struct Lent<'a, ?H> { value: &'a SystemClock }
struct Pair<T, U> { left: T }
fn clockHolder(value: Holder<&Clock>) -> i32 { return 0 }
fn pick<'a, T, 'b>(x: &'a T, y: &'b T) -> &'a T { return missing }
fn hold<'a, T>(x: &'a T) -> &'a T { return missing }
fn rowed<'a, ?R>(value: &'a SystemClock) -> Holder<R> { return missing }
fn wrap<T, U>(value: T) -> Pair<T, U> { return missing }
fn apply<A, B>(transform: fn(A) -> B, value: A) -> B { return missing }
effect fn reading() -> i32 ? &Clock { return 1 }
effect fn bindP<'p, ?S, A, P, E, ?R>(self: once Effect<'static; A ! E ? R>, provider: &'p P) -> A ! E ? Without<R, S>
where &'p P provides S from R { return missing }
effect fn envBound<'env, P>(pending: once Effect<'env; i32>, provider: &'env P) -> i32 { return missing }
effect fn fixed() -> i32 { return 1 }
fn picked(first: &'static i32, second: &i32) -> i32 { let chosen = pick<i32, 'static>(first, second) return 0 }
fn held<'x>(value: &'x i32) -> i32 { let kept = hold<i32, 'x>(value) return 0 }
fn suffixed(value: &SystemClock) -> i32 { let rows = rowed<&Clock>(value) return 0 }
fn overfull(value: &i32) -> i32 { let kept = hold<i32, i64>(value) return 0 }
fn lent(value: &SystemClock) -> i32 { let made = Lent<? &Clock> {value: value} return 0 }
fn wrapped(value: &SystemClock) -> i32 { let made = apply(wrap, 1) return 0 }
fn promised(value: &SystemClock) -> i32 { let made = apply<i32, Pair<i32, bool>>(wrap, 1) return 0 }
fn piped(value: &SystemClock) -> i32 { let pending = reading() |> bindP(value) return 0 }
fn shared() -> i32 { let local = SystemClock {} let pending = envBound(fixed(), &local) return 0 }
fn declaredShared(clock: &SystemClock) -> i32 { let pending = envBound(fixed(), clock) return 0 }
"""
  }
  return ""
}

fn holderRow(value: &Type) -> Option<Shared<Row>> {
  if let Type.Nominal {arguments, ..} = &value.* {
    let listed = Vector<Argument>.asSlice(&arguments)
    if listed.length == usize.ONE {
      if let Argument.Row {value: row} = &listed[usize.ZERO] {
        return Option<Shared<Row>>.some(Shared<Row>.clone(&row))
      }
    }
  }
  return Option<Shared<Row>>.none()
}

// Whether a signature's two `Holder<...>` parameters carry equal rows.
effect fn sameHolderRows(answer: &Shared<Result<Answer, NoRejection>>) -> bool ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let left = slotOf(answer, usize.ZERO)
  let right = slotOf(answer, usize.ONE)
  if let Option<Shared<Type>>.Some {value: first} = move left {
    if let Option<Shared<Type>>.Some {value: second} = move right {
      let firstRow = Shared<Type>.with<Option<Shared<Row>>>(&first, holderRow)
      let secondRow = Shared<Type>.with<Option<Shared<Row>>>(&second, holderRow)
      if let Option<Shared<Row>>.Some {value: from} = move firstRow {
        if let Option<Shared<Row>>.Some {value: to} = move secondRow {
          return run Row.equalsShared(&from, &to)
        }
      }
    }
  }
  return false
}

effect fn providedRowsAfter(store: &mut Semantic, request: &mut Request, id: &ModuleId, name: string) -> Option<Shared<Type>>
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let body = run Semantic.demandBody(&mut store.*, &mut request.*, id, String.utf8Bytes(name))
  return bodyLocalType(&body, usize.ONE)
}

effect fn providedSignatureResult(store: &mut Semantic, request: &mut Request, id: &ModuleId, name: string) -> Option<Shared<Type>>
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let answer = run Semantic.demandSignature(&mut store.*, &mut request.*, id, String.utf8Bytes(name))
  return Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(&answer, signatureResultOf)
}

test effect fn providedWithoutRowsNormalizeByKey() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("provided-rows.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = providedRowsFixture(0)
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let generic = run providedSignatureResult(&mut store, &mut request, &id, "bind") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(effectRowCounts(&generic, usize.ZERO, usize.ZERO, usize.ONE),
    "a provides-bounded signature resolves and keeps Without<R, S> as one unresolved term")
  let kept = run providedSignatureResult(&mut store, &mut request, &id, "kept") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let residual = run providedSignatureResult(&mut store, &mut request, &id, "residual") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let absentKey = run providedSignatureResult(&mut store, &mut request, &id, "absentKey") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let residualKept = run sameEffectRows(&residual, &kept) |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let absentKept = run sameEffectRows(&absentKey, &kept) |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(residualKept && absentKept,
    "concrete Without removes the whole keyed entry regardless of access, and an absent key is a no-op")
  let nested = run Semantic.demandSignature(&mut store, &mut request, &id, b"nested") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let decidedKey = run Semantic.demandSignature(&mut store, &mut request, &id, b"decidedKey") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let nestedSame = run sameHolderRows(&nested) |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let decidedSame = run sameHolderRows(&decidedKey) |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(nestedSame && decidedSame,
    "nested and reordered Without terms normalize to one term, and decided entries leave the term")
  let decided = run Semantic.demandSignature(&mut store, &mut request, &id, b"decided") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsSpan(&decided, RejectionCode.InvalidRequirement, text, "&Clock", 3),
    "a Without key operand cannot carry access")
  return ()
}

// Whether a type-arity rejection sits at `spelling` and counts only the ordinary namespace.
fn ordinaryArity(answer: &Shared<Result<Answer, NoRejection>>, text: string, spelling: string, expected: usize, supplied: usize) -> bool {
  let start = offsetOf(text, spelling, usize.ZERO)
  let found = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(answer, rejection)
  if let Option<Shared<Rejection>>.Some {value} = move found {
    return Shared<Rejection>.with<bool>(&value, fn(problem: &Rejection) -> bool {
      return problem.code == RejectionCode.TypeArity && problem.span.start == start && problem.expected == expected && problem.supplied == supplied
    })
  }
  return false
}

test effect fn providedSelectionChoosesOneCompatibleKey() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("provided-rows.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = providedRowsFixture(1)
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  // A residual row is observed through run coverage of the enclosing `effect fn` row.
  let inferred = run providedSucceeds(&mut store, &mut request, &id, "inferred") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let tight = run providedRejects(&mut store, &mut request, &id, "tight", RejectionCode.UnhandledRequirement, text,
    "run bind(read(), clock)", usize.ONE) |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(inferred && tight, "an omitted selector infers the one conforming key and subtracts only it")
  let explicit = run providedSucceeds(&mut store, &mut request, &id, "explicit") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(explicit, "an explicit selector skips the leading lifetime binder and subtracts its key")
  let chosen = run providedSucceeds(&mut store, &mut request, &id, "chosen") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(chosen, "a role selector resolves key ambiguity and leaves the default-role entry")
  let exclusive = run providedSucceeds(&mut store, &mut request, &id, "exclusive") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(exclusive, "an exclusive provider satisfies an exclusive entry and leaves an empty row")
  let borrowed = run providedSucceeds(&mut store, &mut request, &id, "borrowedSelector") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(borrowed, "a declared selector may spell its key with a borrow; only the key selects and subtracts")
  return ()
}

