  let inferredType = bodyLocalType(&generic, usize.ZERO)
  let mut complete = false
  if let Option<Shared<Type>>.Some {value} = move inferredType {
    complete = nominalOfKind(&value, OwnerKind.Union) && !Type.hasOpenParameters(&value)
  }
  run Testing.expect(complete, "a bare generic union payload constructs a complete ordinary nominal application")
  return ()
}

// One fact of a MIR function: `Return` terminators (`returns`) or locals typed `never`.
fn mirFact(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>, returns: bool) -> usize {
  let selected = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      let mut found = usize.ZERO
      if returns {
        let blocks = Vector<MirBlock>.asSlice(&function.blocks)
        let mut at = usize.ZERO
        while at < blocks.length {
          if let MirTerminator.Return {..} = &blocks[at].terminator { found = found + usize.ONE }
          at = at + usize.ONE
        }
        return found
      }
      let locals = Vector<MirLocal>.asSlice(&function.locals)
      let mut at = usize.ZERO
      while at < locals.length {
        let empty = Shared<Type>.with<bool>(&locals[at].ty, fn(value: &Type) -> bool {
          if let Type.Union {members} = &value.* { return Vector<Shared<Type>>.length(&members) == usize.ZERO }
          return false
        })
        if empty { found = found + usize.ONE }
        at = at + usize.ONE
      }
      return found
    }
  }
  return usize.MAX
}

// Match arms are statement blocks after `=>`: a completing block is `()`, an all-transferring block
// contributes no result, and a transfer leaves the arm even inside a call argument. Whole-member
// arms select one exact member, a bare match reads only a Copy scrutinee, and distinct record
// results join into their union.
test effect fn matchArmsRunBlocksBindMembersAndCopyBareSubjects() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("match-arms.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
struct Left { value: i32 }
struct Right {}
struct Token { value: i32 }
impl Intrinsic.Copy for Token {}
fn identity(value: i32) -> i32 { return value }
fn early(input: Left | Right) -> i32 { return identity(match &input { Left { value } => { return value } Right {} => 0 }) + 100 }
fn statement(input: Left | Right) -> i32 {
  let mut total = 0
  match &input {
    Left { value } => {
      let doubled = value + value
      total = doubled
    }
    Right {} => {
      let doubled = 7
      total = doubled
    }
  }
  return total
}
fn diverging(input: Left | Right) -> i32 { match &input { Left { value } => { return value } Right {} => { return 8 } } }
fn loops(limit: i32) -> i32 {
  let mut count = 0
  let mut sum = 0
  while count < limit {
    count = count + 1
    match count { _ if count == 1 => { continue } _ if count == 4 => { break } _ => { sum = sum + count } }
  }
  return sum
}
fn whole(input: Left | Right) -> i32 { return match move input { Left held => held.value Right _ => 0 } }
fn reachable(input: Left | Right) -> i32 { return match move input { Left _ => 1 Right {} => 2 } }
fn copied(token: Token) -> i32 { return match token { Token { value } => value } }
fn incompatible(input: Left | Right) -> i32 { return match &input { Left { value } => {} Right {} => 1 } }
fn bareAffine(input: Left | Right) -> i32 { return match input { _ => 0 } }
fn absentMember(input: Left | Right) -> i32 { return match move input { Token held => 1 _ => 0 } }
fn onlyLeft(input: Left | Right) -> i32 { return match move input { Left _ => 1 } }
fn outside(input: Left | Right) -> i32 { return match &input { Left { value } => { break } Right {} => 0 } }
fn outsideContinue(input: Left | Right) -> i32 { return match &input { Left { value } => { continue } Right {} => 0 } }
enum Mode { Fast, Slow }
fn scalarMember(input: Left | Mode) -> i32 { return match move input { Left held => held.value Mode mode => 1 } }
union Outcome { Lost, Found { value: i32 } }
fn unionMember(input: Left | Outcome) -> i32 {
  return match move input { Left held => held.value Outcome outcome => match move outcome { Outcome.Found { value } => value Outcome.Lost => 0 } }
}
tuple Pair(i32, i32)
fn absentTuple(input: Left | Outcome) -> i32 { return match move input { Pair whole => 1 _ => 0 } }
struct Wide { value: i32 }
struct Narrow { value: i32 }
fn joined(input: Left | Right) -> i32 {
  let picked = match move input { Left { value } => Wide { value: value } Right {} => Narrow { value: 2 } }
  return match move picked { Wide { value } => value Narrow { value } => value }
}
fn unjoinable(input: Left | Right, other: &Token) -> i32 {
  let picked = match move input { Left { value } => Wide { value: value } Right {} => other }
  return 0
}
union Maybe<T> { None, Some { value: T } }
fn regionJoined(input: Left | Right, first: &Token, second: &Token) -> i32 {
  let picked = match move input { Left _ => Maybe<&Token>.Some { value: first } Right {} => Maybe<&Token>.Some { value: second } }
  if let Maybe<&Token>.Some { value: found } = move picked { return found.value }
  return 0
}
fn invariantJoined(input: Left | Right, first: &mut &Token, second: &mut &Token) -> i32 {
  let picked = match move input { Left _ => Maybe<&mut &Token>.Some { value: first } Right {} => Maybe<&mut &Token>.Some { value: second } }
  if let Maybe<&mut &Token>.Some { value: found } = move picked { return found.*.value }
  return 0
}
fn invariantView(input: Left | Right, first: &mut &Token, second: &mut &Token) -> i32 {
  let picked = match move input { Left _ => first Right {} => second }
  return picked.*.value
}
"""
  let source = run present(text) |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&Revision.make(), &id, &source) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut store = Semantic.traced(run Revision.copy(&revision) |> Effect.provideMut<Allocator>(&mut allocator),
    MachineTarget.forId(TargetId.X8664UnknownLinuxGnu), Option<FinalProfile>.none())
  let mut request = Request.make()
  let early = run Semantic.demandBody(&mut store, &mut request, &id, b"early") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let statement = run Semantic.demandBody(&mut store, &mut request, &id, b"statement") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let diverging = run Semantic.demandBody(&mut store, &mut request, &id, b"diverging") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let loops = run Semantic.demandBody(&mut store, &mut request, &id, b"loops") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let whole = run Semantic.demandBody(&mut store, &mut request, &id, b"whole") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let reachable = run Semantic.demandBody(&mut store, &mut request, &id, b"reachable") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let copied = run Semantic.demandBody(&mut store, &mut request, &id, b"copied") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(bodyFact(&early, usize.ZERO) == usize.ONE && bodyFact(&early, usize.ONE) == usize.ZERO && bodyFact(&early, 2) == 2,
    "a transferring arm inside a call argument contributes no result to the i32 join")
  run Testing.expect(bodyFact(&statement, usize.ZERO) == usize.ZERO && bodyFact(&statement, usize.ONE) == 2 && bodyFact(&statement, 2) == usize.ZERO,
    "completing statement arms join as ()")
  run Testing.expect(bodyFact(&statement, 3) == 4, "each arm's same-named local is its own body local")
  run Testing.expect(bodyFact(&diverging, usize.ZERO) == 2 && bodyFact(&diverging, 2) == usize.ONE, "a match whose arms all transfer is never")
  run Testing.expect(bodyFact(&loops, usize.ZERO) == 2 && bodyFact(&loops, usize.ONE) == usize.ONE,
    "a bare scalar match with guarded wildcards runs continue and break arms")
  run Testing.expect(bodyFact(&whole, 4) == 2, "whole-member arms bind the selected member, including T _")
  run Testing.expect(succeeded(&reachable), "T _ covers only its member, so a later arm stays reachable")
  let mut copiedPlace = true
  let copiedBody = Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(&copied, checkedBody)
  if let Option<Shared<TypedBody>>.Some {value} = move copiedBody {
    copiedPlace = Shared<TypedBody>.with<bool>(&value, matchAddressesPlace)
  }
  run Testing.expect(succeeded(&copied) && !copiedPlace, "a bare match of a Copy record reads one copy")
  let scalarMember = run Semantic.demandMir(&mut store, &mut request, &id, b"scalarMember") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(succeeded(&scalarMember), "a whole-member arm binds a scalar enum member")
  let unionMember = run Semantic.demandMir(&mut store, &mut request, &id, b"unionMember") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(succeeded(&unionMember), "a whole-member arm binds a nominal union member")
  let absentTuple = run Semantic.demandBody(&mut store, &mut request, &id, b"absentTuple") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsSpan(&absentTuple, RejectionCode.MatchMemberNotInScrutinee, text, "Pair whole", 0),
    "a whole-member arm naming a type the scrutinee lacks is a type mismatch at the pattern (PATT-015)")
  let earlyMir = run Semantic.demandMir(&mut store, &mut request, &id, b"early") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let divergingMir = run Semantic.demandMir(&mut store, &mut request, &id, b"diverging") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let loopsMir = run Semantic.demandMir(&mut store, &mut request, &id, b"loops") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(mirFact(&store, &earlyMir, true) == 2 && mirFact(&store, &divergingMir, true) == 2,
    "a transferring arm returns from its block, and an all-transferring match adds no fallthrough return")
  run Testing.expect(mirFact(&store, &divergingMir, false) == usize.ZERO, "a never match stores no value")
  run Testing.expect(mirFact(&store, &loopsMir, true) == usize.ONE, "loop control from arms keeps one function return")
  let joinedMir = run Semantic.demandMir(&mut store, &mut request, &id, b"joined") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let unjoinable = run Semantic.demandBody(&mut store, &mut request, &id, b"unjoinable") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(succeeded(&joinedMir) &&
    rejectsSpan(&unjoinable, RejectionCode.IncompatibleMatchResults, text,
      "match move input { Left { value } => Wide { value: value } Right {} => other }", 0),
    "unannotated arms of distinct records join into their union, and a borrowed view joins no record")
  let regionJoined = run Semantic.demandBody(&mut store, &mut request, &id, b"regionJoined") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(succeeded(&regionJoined),
    "arms differing only in regions join at their meet, which an elided pattern annotation then names")
  let invariantJoined = run Semantic.demandBody(&mut store, &mut request, &id, b"invariantJoined") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let invariantView = run Semantic.demandBody(&mut store, &mut request, &id, b"invariantView") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    rejectsSpan(&invariantJoined, RejectionCode.MatchMemberNotInScrutinee, text, "Maybe<&mut &Token>.Some { value: found }", 0) &&
      rejectsSpan(&invariantView, RejectionCode.IncompatibleMatchResults, text, "second", 5),
    "a region under an exclusive referent is invariant, so such arms have no meet: the nominal arms stay distinct and the second view arm does not meet the first",
  )
  let incompatible = run Semantic.demandBody(&mut store, &mut request, &id, b"incompatible") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let bareAffine = run Semantic.demandBody(&mut store, &mut request, &id, b"bareAffine") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let absentMember = run Semantic.demandBody(&mut store, &mut request, &id, b"absentMember") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let onlyLeft = run Semantic.demandBody(&mut store, &mut request, &id, b"onlyLeft") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let outside = run Semantic.demandBody(&mut store, &mut request, &id, b"outside") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let outsideContinue = run Semantic.demandBody(&mut store, &mut request, &id, b"outsideContinue") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    rejectsSpan(&incompatible, RejectionCode.IncompatibleMatchResults, text, "match &input { Left { value } => {} Right {} => 1 }", 0) &&
    rejectsSpan(&bareAffine, RejectionCode.ExplicitMoveRequired, text, "match input { _ => 0 }", 0) &&
    rejectsSpan(&absentMember, RejectionCode.MatchMemberNotInScrutinee, text, "Token held", 0) &&
    rejectsSpan(&onlyLeft, RejectionCode.MissingUnionMember, text, "match move input { Left _ => 1 }", 0) &&
    rejectsSpan(&outside, RejectionCode.TransferOutsideLoop, text, "break", 1) &&
    rejectsSpan(&outsideContinue, RejectionCode.TransferOutsideLoop, text, "continue", 1),
    "a completing block beside a value, a bare affine match, an absent member, an uncovered member and arm break or continue outside a loop report precise spans",
  )
  let affineText = """
struct Left { value: i32 }
struct Right {}
struct Token { value: i32 }
fn copied(token: Token) -> i32 { return match token { Token { value } => value } }
"""
  let affineSource = run present(affineText) |> Effect.provideMut<Allocator>(&mut allocator)
  let affine = run Revision.publish(&revision, &id, &affineSource) |> Effect.provideMut<Allocator>(&mut allocator)
  let copiedAffine = run Revision.copy(&affine) |> Effect.provideMut<Allocator>(&mut allocator)
  run Semantic.update(&mut store, move copiedAffine) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut affineRequest = Request.make()
  let recopied = run Semantic.demandBody(&mut store, &mut affineRequest, &id, b"copied") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsSpan(&recopied, RejectionCode.ExplicitMoveRequired, affineText, "match token { Token { value } => value }", 0),
    "removing impl Intrinsic.Copy makes the same bare match require an explicit access")
  let mut freshAffine = Semantic.traced(move affine,
    MachineTarget.forId(TargetId.X8664UnknownLinuxGnu), Option<FinalProfile>.none())
  let mut freshAffineRequest = Request.make()
  let freshRecopied = run Semantic.demandBody(&mut freshAffine, &mut freshAffineRequest, &id, b"copied") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(agreesWithFresh(&recopied, &freshRecopied), "the affine bare match agrees with a fresh store of the same revision")
  return ()
}

test effect fn consumingSitesRecordConsumedPlaces() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("consumed-places.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
struct Token { value: i32 }
impl Intrinsic.Drop for Token { fn drop(self: &mut Token) -> () { return () } }
struct Envelope { token: Token code: i32 }
struct Bits { value: i32 }
impl Intrinsic.Copy for Bits {}
impl Token { fn take(self: Self) -> i32 { return self.value } }
impl Bits { fn take(self: Self) -> i32 { return self.value } }
fn make() -> Token { return Token { value: 1 } }
fn whole(token: Token) -> Token { return move token }
fn field(envelope: Envelope) -> Token { return move envelope.token }
fn element(pair: [Token; 2]) -> Token { return move pair[1] }
fn fresh() -> Token { return move make() }
fn dropped(token: Token) -> i32 { drop token return 0 }
fn droppedRvalue() -> i32 { drop make() return 0 }
fn droppedScalar(value: i32) -> i32 { drop value return 0 }
fn consumed(envelope: Envelope) -> i32 { return match move envelope { Envelope { token, code } => code } }
fn receiver(token: Token) -> i32 { return token.take() }
fn copyReceiver(bits: Bits) -> i32 { return bits.take() }
fn droppedCopyBehind(held: &Envelope) -> i32 { drop held.code return 0 }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let whole = run Semantic.demandBody(&mut store, &mut request, &id, b"whole") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let field = run Semantic.demandBody(&mut store, &mut request, &id, b"field") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let element = run Semantic.demandBody(&mut store, &mut request, &id, b"element") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let fresh = run Semantic.demandBody(&mut store, &mut request, &id, b"fresh") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let dropped = run Semantic.demandBody(&mut store, &mut request, &id, b"dropped") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let droppedRvalue = run Semantic.demandBody(&mut store, &mut request, &id, b"droppedRvalue") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let droppedScalar = run Semantic.demandBody(&mut store, &mut request, &id, b"droppedScalar") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let consumed = run Semantic.demandBody(&mut store, &mut request, &id, b"consumed") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let receiver = run Semantic.demandBody(&mut store, &mut request, &id, b"receiver") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let copyReceiver = run Semantic.demandBody(&mut store, &mut request, &id, b"copyReceiver") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let droppedCopyBehind = run Semantic.demandBody(&mut store, &mut request, &id, b"droppedCopyBehind") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(consumesAt(&whole, usize.ZERO, usize.ZERO, usize.MAX, usize.MAX) &&
    consumesAt(&field, usize.ZERO, usize.ZERO, usize.ZERO, usize.MAX) &&
    consumesAt(&element, usize.ZERO, usize.ZERO, 1001, usize.MAX),
    "a move records its local root and static field and element steps")
  run Testing.expect(consumesAt(&fresh, usize.ZERO, usize.MAX, usize.MAX, usize.MAX) &&
    consumesAt(&droppedRvalue, usize.ONE, usize.MAX, usize.MAX, usize.MAX),
    "moving or dropping an owned rvalue records no place")
  run Testing.expect(consumesAt(&dropped, usize.ONE, usize.ZERO, usize.MAX, usize.MAX) &&
    consumesAt(&droppedScalar, usize.ONE, usize.ZERO, usize.MAX, usize.MAX),
    "drop consumes its binding, including a Copy one")
  run Testing.expect(consumesAt(&consumed, 2, usize.ZERO, usize.MAX, usize.MAX), "match move consumes its subject place")
  run Testing.expect(consumesAt(&receiver, usize.ZERO, usize.ZERO, usize.MAX, usize.MAX) &&
    !consumesAt(&copyReceiver, usize.ZERO, usize.ZERO, usize.MAX, usize.MAX),
    "a by-value receiver moves an affine place and copies a Copy one")
  run Testing.expect(consumesAt(&droppedCopyBehind, usize.ONE, usize.MAX, usize.MAX, usize.MAX),
    "dropping a Copy value behind a reference ends no owner")
  let scalarMir = run Semantic.demandMir(&mut store, &mut request, &id, b"droppedScalar") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let affineMir = run Semantic.demandMir(&mut store, &mut request, &id, b"dropped") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(mirFact(&store, &scalarMir, true) == usize.ONE && glueFact(&store, &scalarMir, usize.ZERO) == usize.ZERO &&
    glueFact(&store, &affineMir, usize.ZERO) == usize.ONE && glueFact(&store, &affineMir, 6) == usize.ONE,
    "a cleanup-free drop emits nothing, and a value needing cleanup drops through its type's glue")
  return ()
}

test effect fn unextractablePlacesAreRejected() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("unextractable-places.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
struct Token { value: i32 }
impl Intrinsic.Drop for Token { fn drop(self: &mut Token) -> () { return () } }
struct Envelope { token: Token code: i32 }
impl Token { fn take(self: Self) -> i32 { return self.value } }
fn make() -> Token { return Token { value: 1 } }
fn dynamic(pair: [Token; 2], at: usize) -> Token { return move pair[at] }
fn behind(token: &Token) -> Token { return move token.* }
fn droppedBehind(held: &Envelope) -> i32 { drop held.token return 0 }
fn wrapped() -> Envelope { return Envelope { token: make(), code: 1 } }
fn escaped(envelope: Envelope) -> Token { return match &envelope { Envelope { token, code } => move token } }
fn placed(envelope: Envelope) -> Token { return match place envelope { Envelope { token, code } => move token } }
fn projectedRvalue() -> Token { return move wrapped().token }
fn sliced(tokens: &[Token]) -> Token { return move tokens[0] }
fn receiverBoundary(pair: [Token; 2], at: usize) -> i32 { return pair[at].take() }
fn subjectBoundary(pair: [Token; 2], at: usize) -> i32 { return match move pair[at] { Token { value } => value } }
struct Inner { x: i32 }
impl Intrinsic.Copy for Inner {}
struct Outer { inner: Inner }
impl Intrinsic.Copy for Outer {}
fn copiedProjection(outer: Outer) -> i32 { return match outer { Outer { inner } => move inner.x } }
fn droppedBorrowed(envelope: Envelope) -> i32 {
  match &envelope { Envelope { token, code } => { drop token.value } }
  return 0
}
fn droppedCopyBinding(envelope: Envelope) -> i32 {
  match &envelope { Envelope { token, code } => { drop code } }
  return 0
}
struct Crate { cargo: Token }
fn droppedPlaced(boxed: Crate) -> i32 {
  match place boxed { Crate { cargo } => { drop cargo } }
  return 0
}
struct Shell { envelope: Envelope }
fn nestedPlaced(shell: Shell) -> Token {
  return match place shell { Shell { envelope: Envelope { token, code } } => move token }
}
fn matchedBorrowed(envelope: Envelope) -> i32 {
  return match &envelope { Envelope { token, code } => match move token.value { _ => 0 } }
}
struct Plain { value: i32 }
struct Parcel { plain: Plain code: i32 }
fn matchedPlain(parcel: Parcel) -> i32 {
  return match &parcel { Parcel { plain, code } => match move plain.value { _ => 0 } }
}
fn matchedWhole(envelope: Envelope) -> i32 {
  return match &envelope { Envelope { token, code } => match move token { _ => 0 } }
}
fn inspectedWhole(envelope: Envelope) -> i32 {
  return match &envelope { Envelope { token, code } => match &token { _ => 0 } }
}
fn bareEscaped(envelope: Envelope) -> Token { return match &envelope { Envelope { token: loaned, code } => loaned } }
fn bareOwned(envelope: Envelope) -> Token { return match move envelope { Envelope { token: kept, code } => kept } }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let dynamic = run Semantic.demandBody(&mut store, &mut request, &id, b"dynamic") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let behind = run Semantic.demandBody(&mut store, &mut request, &id, b"behind") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let droppedBehind = run Semantic.demandBody(&mut store, &mut request, &id, b"droppedBehind") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsSpan(&dynamic, RejectionCode.ExtractionBoundary, text, "move pair[at]", 0) &&
    rejectsSpan(&behind, RejectionCode.BorrowedExtraction, text, "move token.*", 0) &&
    rejectsSpan(&droppedBehind, RejectionCode.ExtractionBoundary, text, "held.token", 0),
    "a runtime index or a reference boundary cannot leave a hole (OWN0002, OWN0012)")
  let escaped = run Semantic.demandBody(&mut store, &mut request, &id, b"escaped") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let placed = run Semantic.demandBody(&mut store, &mut request, &id, b"placed") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let droppedPlaced = run Semantic.demandBody(&mut store, &mut request, &id, b"droppedPlaced") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let nestedPlaced = run Semantic.demandBody(&mut store, &mut request, &id, b"nestedPlaced") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsSpan(&escaped, RejectionCode.MatchBorrowEscape, text, "move token", 1),
    "a borrowing match binding cannot leave its arm (OWN0006)")
  run Testing.expect(consumesAt(&placed, usize.ZERO, usize.ZERO, usize.ZERO, usize.MAX)
    && consumesAt(&droppedPlaced, usize.ONE, usize.ZERO, usize.ZERO, usize.MAX),
    "a one-step `match place` binding moves or drops that projection of its subject's own place (OWN-004)")
  run Testing.expect(rejectsSpan(&nestedPlaced, RejectionCode.Unsupported, text, "move token", 4),
    "a deeper `match place` binding path keeps its unsupported boundary")
  let projectedRvalue = run Semantic.demandBody(&mut store, &mut request, &id, b"projectedRvalue") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let sliced = run Semantic.demandBody(&mut store, &mut request, &id, b"sliced") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsSpan(&projectedRvalue, RejectionCode.ExtractionBoundary, text, "move wrapped().token", 0) &&
    rejectsSpan(&sliced, RejectionCode.BorrowedExtraction, text, "move tokens[0]", 0),
    "a projection out of an owned rvalue leaves an unowned remainder (OWN0002), and a slice element is borrowed (OWN0012)")
  let receiverBoundary = run Semantic.demandBody(&mut store, &mut request, &id, b"receiverBoundary") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let subjectBoundary = run Semantic.demandBody(&mut store, &mut request, &id, b"subjectBoundary") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsSpan(&receiverBoundary, RejectionCode.ExtractionBoundary, text, "pair[at]", 1) &&
    rejectsSpan(&subjectBoundary, RejectionCode.ExtractionBoundary, text, "pair[at]", 2),
    "a by-value receiver and a consuming match subject are rejected at the extracted place")
  let copiedProjection = run Semantic.demandBody(&mut store, &mut request, &id, b"copiedProjection") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let droppedCopyBinding = run Semantic.demandBody(&mut store, &mut request, &id, b"droppedCopyBinding") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(succeeded(&copiedProjection) && succeeded(&droppedCopyBinding),
    "a bare match binding is a place of the copied subject, and dropping a Copy borrowing binding ends no owner")
  let droppedBorrowed = run Semantic.demandBody(&mut store, &mut request, &id, b"droppedBorrowed") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsSpan(&droppedBorrowed, RejectionCode.MatchBorrowEscape, text, "token.value", 0),
    "a Copy part of a non-Copy borrowing binding still cannot leave its arm (OWN0006)")
  let matchedBorrowed = run Semantic.demandBody(&mut store, &mut request, &id, b"matchedBorrowed") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let matchedPlain = run Semantic.demandBody(&mut store, &mut request, &id, b"matchedPlain") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsSpan(&matchedBorrowed, RejectionCode.ExtractionBoundary, text, "match move token.value { _ => 0 }", 0) &&
    succeeded(&matchedPlain) && consumesAt(&matchedPlain, 2, usize.MAX, usize.MAX, usize.MAX),
    "a consuming match copies a Copy part of a borrowing binding unless an owner on its path has a Drop hook (OWN0002)")
  let matchedWhole = run Semantic.demandBody(&mut store, &mut request, &id, b"matchedWhole") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let inspectedWhole = run Semantic.demandBody(&mut store, &mut request, &id, b"inspectedWhole") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsSpan(&matchedWhole, RejectionCode.MatchBorrowEscape, text, "token", 20) &&
    succeeded(&inspectedWhole),
    "a consuming match of a whole affine borrowing binding escapes its arm (OWN0006), and a borrowing match inspects it")
  let bareEscaped = run Semantic.demandBody(&mut store, &mut request, &id, b"bareEscaped") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let bareOwned = run Semantic.demandBody(&mut store, &mut request, &id, b"bareOwned") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsSpan(&bareEscaped, RejectionCode.MatchBorrowEscape, text, "loaned", 1) &&
    rejectsSpan(&bareOwned, RejectionCode.ExplicitMoveRequired, text, "kept", 1),
    "a bare affine borrowing binding leaving its arm is an escape (OWN0006) before a missing move, which a consuming binding needs (OWN0003)")
  return ()
}

test effect fn dropGlueCleansHookThenChildren() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("drop-glue.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
struct Token { value: i32 }
impl Intrinsic.Drop for Token { fn drop(self: &mut Token) -> () { return () } }
struct Pair { first: Token count: i32 second: Token }
struct Guard { token: Token }
impl Intrinsic.Drop for Guard { fn drop(self: &mut Guard) -> () { return () } }
union Cell { Vacant, Held { token: Token, code: i32 } }
fn pair(value: Pair) -> i32 { drop value return 0 }
fn token(value: Token) -> i32 { drop value return 0 }
fn guard(value: Guard) -> i32 { drop value return 0 }
fn array(values: [Token; 2]) -> i32 { drop values return 0 }
fn either(value: Token | i32) -> i32 { drop value return 0 }
fn arrayEither(value: [Token; 2] | i32) -> i32 { drop value return 0 }
fn slot(value: Cell) -> i32 { drop value return 0 }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let pair = run droppedGlue(&mut store, &mut request, &id, b"pair") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let token = run droppedGlue(&mut store, &mut request, &id, b"token") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let guard = run droppedGlue(&mut store, &mut request, &id, b"guard") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let array = run droppedGlue(&mut store, &mut request, &id, b"array") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let either = run droppedGlue(&mut store, &mut request, &id, b"either") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let arrayEither = run droppedGlue(&mut store, &mut request, &id, b"arrayEither") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let slot = run droppedGlue(&mut store, &mut request, &id, b"slot") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(glueFact(&store, &token, 1) == usize.ONE && glueFact(&store, &token, usize.ZERO) == usize.ZERO,
    "glue calls the Drop hook found through impl Intrinsic.Drop, and a cleanup-free field needs no drop")
  run Testing.expect(glueFact(&store, &guard, 1) == usize.ONE && glueFact(&store, &guard, usize.ZERO) == usize.ONE &&
    glueFact(&store, &guard, 3) == usize.ZERO && glueFact(&store, &guard, 7) == usize.ONE,
    "a hooked record runs its hook before dropping its field")
  run Testing.expect(glueFact(&store, &pair, 1) == usize.ZERO && glueFact(&store, &pair, usize.ZERO) == 2 &&
    glueFact(&store, &pair, 3) == usize.ZERO && glueFact(&store, &pair, 4) == 2,
    "a hookless record drops its droppable fields in declaration order")
  run Testing.expect(glueFact(&store, &array, usize.ZERO) == usize.ONE && glueFact(&store, &array, 3) == 1000 &&
    glueFact(&store, &array, 5) == usize.ONE,
    "array glue drops every element in one counted loop")
  run Testing.expect(glueFact(&store, &either, 2) == usize.ONE && glueFact(&store, &either, usize.ZERO) == usize.ONE &&
    glueFact(&store, &either, 8) == usize.ONE,
    "structural union glue switches on the tag and drops only the payload of the member that needs cleanup")
  run Testing.expect(glueFact(&store, &arrayEither, 2) == usize.ONE &&
    glueFact(&store, &arrayEither, usize.ZERO) == usize.ONE && glueFact(&store, &arrayEither, 8) == usize.ZERO
    && glueFact(&store, &arrayEither, 6) == usize.ONE,
    "structural union glue selects the active fixed-array payload and delegates element cleanup to array glue")
  run Testing.expect(glueFact(&store, &slot, 2) == usize.ONE && glueFact(&store, &slot, usize.ZERO) == usize.ONE &&
    glueFact(&store, &slot, 3) == 3010,
    "nominal union glue drops the active variant's droppable fields")
  return ()
}

test effect fn cleanupStackDropsWhatEachExitLeaves() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("cleanup-stack.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
struct Token { value: i32 }
impl Intrinsic.Drop for Token { fn drop(self: &mut Token) -> () { return () } }
fn consume(token: Token) -> i32 { return token.value }
fn ordered() -> i32 {
  let first = Token { value: 1 }
  let second = Token { value: 2 }
  return 0
}
fn moved() -> Token {
  let kept = Token { value: 1 }
  return move kept
}
fn replaced(limit: i32) -> i32 {
  let mut current = Token { value: 0 }
  let mut remaining = limit
  while remaining > 0 {
    current = Token { value: remaining }
    remaining = remaining - 1
  }
  return 0
}
fn maybe(flag: bool) -> i32 {
  let token = Token { value: 1 }
  if flag {
    let used = consume(move token)
  }
  return 0
}
fn breaks(limit: i32) -> i32 {
  let outer = Token { value: 1 }
  while true {
    let inner = Token { value: 2 }
    if limit > 0 { break }
  }
  return 0
}
struct Point { x: i32 }
fn make() -> Token { return Token { value: 1 } }
fn plain() -> i32 {
  let point = Point { x: 1 }
  return point.x
}
fn first(points: &[Point]) -> i32 { return points[0].x }
fn pointTemporary() -> i32 { return first(&[Point { x: 2 }]) }
fn read(token: &Token) -> i32 { return token.value }
fn borrowedTemporary() -> i32 { return read(&make()) }
fn bump(token: &mut Token) -> i32 { return token.value }
fn mutableTemporary() -> i32 { return bump(&mut make()) }
impl Token { fn peek(token: &Self) -> i32 { return token.value } }
fn receiverTemporary() -> i32 { return make().peek() }
fn tokens() -> [Token; 1] { return [Token { value: 1 }] }
fn identity(values: &[Token]) -> &[Token] { return values }
fn held() -> i32 {
  let view = identity(&tokens())
  return view[0].value
}
fn keep<'a>(token: &'a Token, seen: i32) -> &'a Token { return token }
fn armTemporary(code: i32) -> i32 {
  let outer = make()
  let view = match code { _ => keep(&outer, read(&make())) }
  return view.value
}
fn heldView() -> i32 {
  let view = &make()
  return view.value
}
fn armView(code: i32) -> i32 {
  let view = match code { _ => &make() }
  return view.value
}
fn matchedTemporary() -> i32 { return match &make() { Token { value } => value } }
fn destructured() -> i32 {
  let Token { value } = &make()
  return value
}
fn exclusiveTemporary() -> i32 { return match &mut make() { Token { value } => value } }
fn exclusiveBinding() -> i32 {
  let Token { value } = &mut make()
  return value
}
fn placeTemporary() -> i32 { return match place make() { Token { value } => value } }
fn exclusiveImmutable(input: Token) -> i32 { return match &mut input { Token { value } => value } }
fn exclusiveImmutableBinding(input: Token) -> i32 {
  let Token { value } = &mut input
  return value
}
fn exclusiveMutable() -> i32 {
  let mut token = make()
  return match &mut token { Token { value } => value }
}
struct Pair { token: Token }
fn accepts(token: Token) -> bool { return token.value > 0 }
fn guardMoves(input: Pair) -> i32 {
  return match move input {
    Pair { token } if accepts(move token) => 1
    Pair { token: other } => consume(move other)
  }
}
fn guardReads(input: Pair) -> i32 {
  return match move input {
    Pair { token } if token.value > 0 => consume(move token)
    Pair { token: other } => consume(move other)
  }
}
fn view(points: &[Point]) -> &[Point] { return points }
fn matchedElement(points: &[Point]) -> i32 { return match &view(points)[0] { Point { x } => x } }
fn width(values: &[i32]) -> usize { return values.length }
fn show<T>(value: &T) -> i32 { return 42 }
fn nestedTemporary() -> i32 {
  let values = [1, 2, 3]
  return show<usize>(&width(&values))
}
fn projected() -> i32 { return make().value }
fn unused(token: Token) -> i32 { return 0 }
fn continues(limit: i32) -> i32 {
  let mut count = 0
  while count < limit {
    count = count + 1
    let token = make()
    continue
  }
  return count
}
fn kept<T: Intrinsic.Copy>(value: T) -> i32 { return 0 }
fn lent<'env>(predicate: fn<'env>(i32) -> bool) -> i32 { return 0 }
fn affine<T>(value: T) -> i32 { return 7 }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let ordered = run Semantic.demandMir(&mut store, &mut request, &id, b"ordered") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let moved = run Semantic.demandMir(&mut store, &mut request, &id, b"moved") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let replaced = run Semantic.demandMir(&mut store, &mut request, &id, b"replaced") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let maybe = run Semantic.demandMir(&mut store, &mut request, &id, b"maybe") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let breaks = run Semantic.demandMir(&mut store, &mut request, &id, b"breaks") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(glueFact(&store, &ordered, usize.ZERO) == 2 && cleanupFact(&store, &ordered, 2) == 2 &&
    cleanupFact(&store, &ordered, 3) == usize.ONE,
    "a return drops its scope's owners in reverse acquisition order")
  run Testing.expect(glueFact(&store, &moved, usize.ZERO) == usize.ZERO, "a returned owner moves out and is not dropped")
  run Testing.expect(glueFact(&store, &replaced, usize.ZERO) == 2 && cleanupFact(&store, &replaced, usize.ZERO) == usize.ZERO,
    "replacement drops the displaced value and the loop exit needs no drop flag (worked example A)")
  run Testing.expect(cleanupFact(&store, &maybe, usize.ZERO) == usize.ONE && cleanupFact(&store, &maybe, usize.ONE) == 2 &&
    glueFact(&store, &maybe, usize.ZERO) == usize.ONE,
    "an owner moved on one path only is dropped under a flag written on each incoming edge")
  run Testing.expect(glueFact(&store, &breaks, usize.ZERO) == 3 && cleanupFact(&store, &breaks, usize.ZERO) == usize.ZERO,
    "break drops the loop scope it leaves, the loop body's fallthrough drops it, and return drops the rest")
  let plain = run Semantic.demandMir(&mut store, &mut request, &id, b"plain") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let pointTemporary = run Semantic.demandMir(&mut store, &mut request, &id, b"pointTemporary") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(glueFact(&store, &plain, usize.ZERO) == usize.ZERO && succeeded(&pointTemporary),
    "a value whose owned structure carries no impl Intrinsic.Drop is never an owner, and its borrowed array literal is admitted")
  let projected = run Semantic.demandMir(&mut store, &mut request, &id, b"projected") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let unused = run Semantic.demandMir(&mut store, &mut request, &id, b"unused") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let continues = run Semantic.demandMir(&mut store, &mut request, &id, b"continues") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(glueFact(&store, &projected, usize.ZERO) == usize.ONE && glueFact(&store, &unused, usize.ZERO) == usize.ONE &&
    cleanupFact(&store, &unused, 2) == usize.ONE,
    "a temporary read only through a projection and an owned parameter never moved are each dropped once")
  run Testing.expect(glueFact(&store, &continues, usize.ZERO) == usize.ONE && cleanupFact(&store, &continues, usize.ZERO) == usize.ZERO,
    "continue drops the loop scope it leaves")
  let borrowedTemporary = run Semantic.demandMir(&mut store, &mut request, &id, b"borrowedTemporary") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let mutableTemporary = run Semantic.demandMir(&mut store, &mut request, &id, b"mutableTemporary") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let receiverTemporary = run Semantic.demandMir(&mut store, &mut request, &id, b"receiverTemporary") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(loanFact(&store, &borrowedTemporary, usize.ZERO) == usize.ONE && loanFact(&store, &mutableTemporary, usize.ZERO) == usize.ONE &&
    loanFact(&store, &receiverTemporary, usize.ZERO) == usize.ONE,
    "a borrowed call result, mutable loan or auto-borrowed receiver loans the call's own temporary, dropped once after the borrowing call")
  let held = run Semantic.demandMir(&mut store, &mut request, &id, b"held") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let armTemporary = run Semantic.demandMir(&mut store, &mut request, &id, b"armTemporary") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(loanFact(&store, &held, usize.ONE) == usize.ONE
      && backendGapAt(&armTemporary, GapCode.Cleanup, text, "_ => keep(&outer, read(&make()))", 0),
    "a borrowing binding keeps its borrowed array call result until the scope's exit; a borrowing arm result keeps the cleanup gap")
  let heldView = run Semantic.demandBody(&mut store, &mut request, &id, b"heldView") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let armView = run Semantic.demandBody(&mut store, &mut request, &id, b"armView") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsSpan(&heldView, RejectionCode.ExpiredLifetime, text, "view.value", 1)
      && rejectsSpan(&armView, RejectionCode.ExpiredLifetime, text, "view.value", 2),
    "a view of any other temporary is valid only within its statement, as the bootstrap reports it (BORROW-006, OWN0019)")
  let nestedTemporary = run Semantic.demandMir(&mut store, &mut request, &id, b"nestedTemporary") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(loanFact(&store, &nestedTemporary, usize.ZERO) == usize.ZERO,
    "an explicitly applied generic call loans a nested call result that needs no cleanup")
  let matchedTemporary = run Semantic.demandMir(&mut store, &mut request, &id, b"matchedTemporary") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let matchedElement = run Semantic.demandMir(&mut store, &mut request, &id, b"matchedElement") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(glueFact(&store, &matchedTemporary, usize.ZERO) == usize.ONE && glueFact(&store, &matchedElement, usize.ZERO) == usize.ZERO,
    "a borrowing match addresses a call result's temporary, dropped once, or a slice element reached through a call")
  let destructured = run Semantic.demandMir(&mut store, &mut request, &id, b"destructured") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(retainedResultFact(&store, &destructured) == usize.ONE,
    "a borrowing destructuring let keeps its subject's call result until the scope's exit, after its bindings are read")
  let exclusiveTemporary = run Semantic.demandBody(&mut store, &mut request, &id, b"exclusiveTemporary") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let exclusiveBinding = run Semantic.demandBody(&mut store, &mut request, &id, b"exclusiveBinding") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let placeTemporary = run Semantic.demandBody(&mut store, &mut request, &id, b"placeTemporary") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsSpan(&exclusiveTemporary, RejectionCode.InvalidMatchScrutineePlace, text, "match &mut make() { Token { value } => value }", 0) &&
    rejectsSpan(&exclusiveBinding, RejectionCode.InvalidMatchScrutineePlace, text, "let Token { value } = &mut make()", 0) &&
    rejectsSpan(&placeTemporary, RejectionCode.InvalidMatchScrutineePlace, text, "match place make() { Token { value } => value }", 0),
    "an exclusive or place match, or an exclusive destructuring let, must name an existing place")
  let exclusiveImmutable = run Semantic.demandBody(&mut store, &mut request, &id, b"exclusiveImmutable") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let exclusiveImmutableBinding = run Semantic.demandBody(&mut store, &mut request, &id, b"exclusiveImmutableBinding") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let exclusiveMutable = run Semantic.demandBody(&mut store, &mut request, &id, b"exclusiveMutable") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsSpan(&exclusiveImmutable, RejectionCode.ExclusiveMatchRequiresMutable, text, "match &mut input { Token { value } => value }", 0) &&
    rejectsSpan(&exclusiveImmutableBinding, RejectionCode.ExclusiveMatchRequiresMutable, text, "let Token { value } = &mut input", 0) &&
    succeeded(&exclusiveMutable),
    "an exclusive match or destructuring let needs a mutable subject place (bootstrap OWN0007)")
  let guardMoves = run Semantic.demandBody(&mut store, &mut request, &id, b"guardMoves") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let guardReads = run Semantic.demandBody(&mut store, &mut request, &id, b"guardReads") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsSpan(&guardMoves, RejectionCode.GuardConsumesPattern, text, "move token", 1) && succeeded(&guardReads),
    "a guard may read its arm's bindings but not move them; the arm may (bootstrap OWN0008)")
  let kept = run Semantic.demandMir(&mut store, &mut request, &id, b"kept") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let lent = run Semantic.demandMir(&mut store, &mut request, &id, b"lent") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let affine = run Semantic.demandMir(&mut store, &mut request, &id, b"affine") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(glueFact(&store, &kept, usize.ZERO) == usize.ZERO && glueFact(&store, &lent, usize.ZERO) == usize.ZERO
    && backendGapAt(&affine, GapCode.Cleanup, text, "return 7", 0),
    "a Copy-bounded parameter or a shared callable representation owns no cleanup; an unbounded abstract owner keeps the gap")
  return ()
}

// The drops of call-result temporaries in a MIR function when each happens after the return slot
// is written, else MAX.
fn retainedResultFact(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>) -> usize {
  let selected = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      let locals = Vector<MirLocal>.asSlice(&function.locals)
      let blocks = Vector<MirBlock>.asSlice(&function.blocks)
      let mut dropped = usize.ZERO
      let mut local = usize.ZERO
      while local < locals.length {
        if callDestination(locals, blocks, local) && dropsOf(blocks, local) != usize.ZERO {
          if !droppedAfterResult(blocks, local) { return usize.MAX }
          dropped = dropped + dropsOf(blocks, local)
        }
        local = local + usize.ONE
      }
      return dropped
    }
  }
  return usize.MAX
}

fn dropsOf(blocks: &[MirBlock], local: usize) -> usize {
  let mut count = usize.ZERO
  let mut at = usize.ZERO
  while at < blocks.length {
    let statements = Vector<MirStatement>.asSlice(&blocks[at].statements)
    let mut position = usize.ZERO
    while position < statements.length {
      if let MirStatement.Drop {destination, ..} = &statements[position] {
        if destination.local == local { count = count + usize.ONE }
      }
      position = position + usize.ONE
    }
    at = at + usize.ONE
  }
  return count
}

// One fact of the first loan of a call result in a MIR function: 0 the drops of the loaned
// temporary, all in the block the call receiving the loan continues to; 1 whether the temporary is
// dropped only after the return slot is written. MAX when the shape is absent.
fn loanFact(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>, fact: usize) -> usize {
  let selected = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      let locals = Vector<MirLocal>.asSlice(&function.locals)
      let blocks = Vector<MirBlock>.asSlice(&function.blocks)
      let loaned = loanedCallResult(locals, blocks)
      if loaned == usize.MAX { return usize.MAX }
      if fact == usize.ONE { return countIf(droppedAfterResult(blocks, loaned)) }
      let continuation = borrowingContinuation(blocks, loanReference(blocks, loaned))
      if continuation == usize.MAX { return usize.MAX }
      return dropsOnlyIn(blocks, loaned, continuation)
    }
  }
  return usize.MAX
}

// The first compiler temporary loaned whole after a call wrote it as its destination.
fn loanedCallResult(locals: &[MirLocal], blocks: &[MirBlock]) -> usize {
  let mut at = usize.ZERO
  while at < blocks.length {
    let statements = Vector<MirStatement>.asSlice(&blocks[at].statements)
    let mut position = usize.ZERO
    while position < statements.length {
      if let MirStatement.Assign {value: MirRvalue.Ref {place, ..}, ..} = &statements[position] {
        if Vector<MirProjection>.length(&place.projections) == usize.ZERO && callDestination(locals, blocks, place.local) { return place.local }
      }
      position = position + usize.ONE
    }
    at = at + usize.ONE
  }
  return usize.MAX
}

fn callDestination(locals: &[MirLocal], blocks: &[MirBlock], local: usize) -> bool {
  let temporary = match &locals[local].kind { MirLocalKind.Temp => true _ => false }
  let mut at = usize.ZERO
  while temporary && at < blocks.length {
    if let MirTerminator.Call {destination, ..} = &blocks[at].terminator {
      if destination.local == local && Vector<MirProjection>.length(&destination.projections) == usize.ZERO { return true }
    }
    at = at + usize.ONE
  }
  return false
}

// The local assigned the whole-local reference to `loaned`.
fn loanReference(blocks: &[MirBlock], loaned: usize) -> usize {
  let mut at = usize.ZERO
  while at < blocks.length {
    let statements = Vector<MirStatement>.asSlice(&blocks[at].statements)
    let mut position = usize.ZERO
    while position < statements.length {
      if let MirStatement.Assign {destination, value: MirRvalue.Ref {place, ..}, ..} = &statements[position] {
        if place.local == loaned && Vector<MirProjection>.length(&place.projections) == usize.ZERO { return destination.local }
      }
      position = position + usize.ONE
    }
    at = at + usize.ONE
  }
  return usize.MAX
}

// The block that the call receiving `reference` as an argument continues to.
fn borrowingContinuation(blocks: &[MirBlock], reference: usize) -> usize {
  let mut at = usize.ZERO
  while at < blocks.length {
    if let MirTerminator.Call {arguments, normal, ..} = &blocks[at].terminator {
      if copiesLocal(Vector<MirOperand>.asSlice(&arguments), reference) { return normal }
    }
    at = at + usize.ONE
  }
  return usize.MAX
}

fn copiesLocal(operands: &[MirOperand], local: usize) -> bool {
  let mut at = usize.ZERO
  while at < operands.length {
    if let MirOperand.Copy {place} = &operands[at] {
      if place.local == local && Vector<MirProjection>.length(&place.projections) == usize.ZERO { return true }
    }
    at = at + usize.ONE
  }
  return false
}

// The drops of `local` in block `target`, or MAX when another block drops it too.
fn dropsOnlyIn(blocks: &[MirBlock], local: usize, target: usize) -> usize {
  let mut there = usize.ZERO
  let mut at = usize.ZERO
  while at < blocks.length {
    let statements = Vector<MirStatement>.asSlice(&blocks[at].statements)
    let mut position = usize.ZERO
    while position < statements.length {
      if let MirStatement.Drop {destination, ..} = &statements[position] {
        if destination.local == local {
          if at != target { return usize.MAX }
          there = there + usize.ONE
        }
      }
      position = position + usize.ONE
    }
    at = at + usize.ONE
  }
  return there
}

// Whether `local` is dropped, each time after the return slot is written in the same block.
fn droppedAfterResult(blocks: &[MirBlock], local: usize) -> bool {
  let mut dropped = false
  let mut at = usize.ZERO
  while at < blocks.length {
    let statements = Vector<MirStatement>.asSlice(&blocks[at].statements)
    let mut written = false
    let mut position = usize.ZERO
    while position < statements.length {
      if let MirStatement.Assign {destination, ..} = &statements[position] {
        if destination.local == usize.ZERO { written = true }
      }
      if let MirStatement.Drop {destination, ..} = &statements[position] {
        if destination.local == local {
          if !written { return false }
          dropped = true
        }
      }
      position = position + usize.ONE
    }
    at = at + usize.ONE
  }
  return dropped
}

test effect fn fallibleRunsUseFailureEdgesAndOutSlots() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("fallible-runs.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let target = MachineTarget.forId(TargetId.X8664UnknownLinuxGnu)
  let text = """
struct Token { value: i32 }
impl Intrinsic.Drop for Token { fn drop(self: &mut Token) -> () { return () } }
struct Missing { code: i32 }
struct Offline {}
effect fn load(mode: i32) -> i32 ! Missing {
  if mode == 0 { return 1 }
  fail Missing { code: mode }
}
effect fn widened(mode: i32) -> i32 ! Missing | Offline {
  let held = Token { value: mode }
  let value = run load(mode)
  return value
}
effect fn status(mode: i32) -> i32 ! i64 {
  if mode == 0 { return 1 }
  fail 7
}
effect fn forward(mode: i32) -> i32 ! i64 { return run status(mode) }
effect fn recurse(mode: i32) -> i32 ! i64 {
  if mode == 0 { fail 9 }
  return run recurse(mode - 1)
}
effect fn closed() -> i32 { return 2 }
fn ordinary() -> i32 { return run closed() }
fn plain() -> i32 { return 3 }
fn leaks() -> i32 { return run status(1) }
fn outside() -> i32 { fail 7 }
effect fn undeclared() -> i32 ! i64 { fail true }
fn notEffect() -> i32 { return run plain() }
effect fn parks() -> () { return run Intrinsic.relinquish() }
effect fn suspends() -> i32 { return run Intrinsic.suspendEffect(effect { return 1 }) }
effect fn asks() -> () {
  let reference = run Intrinsic.executionCurrent()
  Intrinsic.executionNotify(&reference)
  return ()
}
fn consume(token: Token, value: i32) -> i32 { return value }
effect fn guarded(mode: i32) -> i32 ! Missing | Offline { return consume(Token { value: mode }, run load(mode)) }
effect fn rewidened(mode: i32) -> i32 ! Missing | Offline | i64 { return run widened(mode) }
effect fn rethrow(problem: Missing) -> i32 ! Missing { fail move problem }
effect fn quiet() -> i32 { fail 77 }
effect fn shaped() -> i32 ! Missing { fail Missing { code: false } }
service Clock { effect fn now() -> i32 ? &Clock }
effect fn reads() -> i32 ? &Clock { return 1 }
effect fn unprovided() -> i32 { return run reads() }
struct Done { value: i32 }
struct Failed<E> { error: E }
effect<'env> fn raise<A, E: 'env, 'env>(error: E) -> A ! E { fail move error }
effect fn explicitBottom(error: never) -> i32 ! never { fail move error }
effect<'env> fn bottom<E: 'env, 'env>(error: E) -> i32 ! E { fail move error }
effect<'env> fn settle<E: 'env, 'env>(state: Done | Failed<E>) -> i32 ! E {
  return match move state {
    Done { value } => value
    Failed<E> { error } => run raise<i32, E>(move error)
  }
}
effect fn settled() -> i32 { return run settle<never>(Done { value: 4 }) }
fn unwrapped(state: Done | Failed<never>) -> i32 {
  return match move state {
    Done { value } => value
    Failed<never> { error } => move error
  }
}
"""
  let mut store = run staticSemantic(&id, text, target) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let load = run Semantic.demandMir(&mut store, &mut request, &id, b"load") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let widened = run Semantic.demandMir(&mut store, &mut request, &id, b"widened") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let ordinary = run Semantic.demandMir(&mut store, &mut request, &id, b"ordinary") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(failureFact(&store, &load, usize.ZERO) == usize.ONE && failureFact(&store, &load, usize.ONE) == usize.ONE,
    "a fallible effect fn owns one Failure out-slot and `fail` exits through Fail")
  run Testing.expect(failureFact(&store, &widened, 2) == usize.ONE && failureFact(&store, &widened, 3) == usize.ONE,
    "a run's failure edge widens the callee failure into Failure, drops the live owner, then fails")
  run Testing.expect(succeeded(&ordinary) && failureFact(&store, &ordinary, usize.ZERO) == usize.ZERO &&
    failureFact(&store, &ordinary, 2) == usize.ZERO,
    "a closed infallible run in an ordinary fn is an ordinary call without a failure edge")
  // A self-recursive instance is its own closed emission plan.
  let recurse = run Semantic.demandMir(&mut store, &mut request, &id, b"recurse") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let selected = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(&recurse, selectedMirIndex)
  let mut outSlots = false
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(&store, index) {
      let locals = Vector<MirLocal>.asSlice(&function.locals)
      let mut layouts = Vector<TypeLayout>.make()
      let mut at = usize.ZERO
      while at < locals.length {
        if let Option<BackendLayout>.Some {value: facts} = move BackendLayout.scalar(&locals[at].ty, &target) {
          let layout = run Shared<BackendLayout>.make(move facts) |> Effect.provideMut<Allocator>(&mut allocator)
          run Vector<TypeLayout>.append(&mut layouts, TypeLayout {ty: Shared<Type>.clone(&locals[at].ty), layout: move layout})
            |> Effect.provideMut<Allocator>(&mut allocator)
        }
        at = at + usize.ONE
      }
      let foreign = Vector<CAbi.Signature>.make()
      let emitted = run Effect.result(emitClosedMir(function, &target, Vector<TypeLayout>.asSlice(&layouts),
        Vector<CAbi.Signature>.asSlice(&foreign))) |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
      if let Result<Bytes, BackendGap | OutOfMemoryError>.Success {value: llvmText} = move emitted {
        let ir = Bytes.asSlice(&llvmText)
        outSlots = containsIr(ir, b"define i1 @") && containsIr(ir, b"i32 %p0, ptr %out, ptr %fail)") &&
          containsIrLine(ir, b" = call i1 @", b"(i32 ") && containsIrLine(ir, b" = call i1 @", b", ptr ") &&
          containsIr(ir, b"br i1 ") && containsIr(ir, b"ret i1 1") && containsIr(ir, b"ret i1 0")
      }
    }
  }
  run Testing.expect(outSlots, "a fallible instance takes its arguments, then success and failure out-addresses, and returns a status flag")
  let leaks = run Semantic.demandBody(&mut store, &mut request, &id, b"leaks") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let outside = run Semantic.demandBody(&mut store, &mut request, &id, b"outside") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let undeclared = run Semantic.demandBody(&mut store, &mut request, &id, b"undeclared") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let notEffect = run Semantic.demandBody(&mut store, &mut request, &id, b"notEffect") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsSpan(&leaks, RejectionCode.UnhandledFailure, text, "run status(1)", 0) &&
    rejectsSpan(&outside, RejectionCode.FailOutsideEffect, text, "fail 7", 1) &&
    rejectsSpan(&undeclared, RejectionCode.UndeclaredFailure, text, "true", 0) &&
    rejectsSpan(&notEffect, RejectionCode.RunNonEffect, text, "plain()", 1),
    "run and fail check the enclosing channels and the runnable operand")
  let parks = run Semantic.demandMir(&mut store, &mut request, &id, b"parks") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let parksAnchor = run answerMirAnchor(&mut store, &parks) |> Effect.provideMut<Allocator>(&mut allocator)
  let parksIndex = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(&parks, selectedMirIndex)
  let mut relinquishes = usize.ZERO
  let mut parked = usize.MAX
  let mut external = usize.MAX
  if let Option<usize>.Some {value: index} = move parksIndex {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(&store, index) {
      if let Option<Anchor>.Some {value: anchor} = &parksAnchor {
        if let Option<BodyOrigin>.Some {value: origin} = &function.suspension { parked = Anchor.span(&anchor, origin.location).start }
        if let Option<BodyOrigin>.Some {value: origin} = &function.parks { external = Anchor.span(&anchor, origin.location).start }
      }
      let blocks = Vector<MirBlock>.asSlice(&function.blocks)
      let mut at = usize.ZERO
      while at < blocks.length {
        if let MirTerminator.Relinquish {..} = &blocks[at].terminator { relinquishes = relinquishes + usize.ONE }
        at = at + usize.ONE
      }
    }
  }
  // Suspension provenance is projected through the current source anchor.
  run Testing.expect(parked == offsetOf(text, "run Intrinsic.relinquish", 0) && relinquishes == usize.ONE,
    "a relinquishment ends its block at one resume point and marks the instance as a suspension origin")
  run Testing.expect(external == offsetOf(text, "run Intrinsic.relinquish", 0),
    "a relinquishment is an external park of its instance")
  let asks = run Semantic.demandMir(&mut store, &mut request, &id, b"asks") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let asksAnchor = run answerMirAnchor(&mut store, &asks) |> Effect.provideMut<Allocator>(&mut allocator)
  let asksIndex = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(&asks, selectedMirIndex)
  let mut asked = usize.MAX
  let mut askedBoundary = usize.MAX
  if let Option<usize>.Some {value: index} = move asksIndex {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(&store, index) {
      if let Option<Anchor>.Some {value: anchor} = &asksAnchor {
        if let Option<BodyOrigin>.Some {value: origin} = &function.parks { asked = Anchor.span(&anchor, origin.location).start }
        if let Option<BodyOrigin>.Some {value: origin} = &function.suspension { askedBoundary = Anchor.span(&anchor, origin.location).start }
      }
    }
  }
  run Testing.expect(asked == offsetOf(text, "run Intrinsic.executionCurrent", 0) && askedBoundary == asked,
    "naming the running Execution is an external park and a suspension boundary of its instance")
  let suspendsBody = run Semantic.demandBody(&mut store, &mut request, &id, b"suspends") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let suspends = run Semantic.demandMir(&mut store, &mut request, &id, b"suspends") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let suspendsAnchor = run answerMirAnchor(&mut store, &suspends) |> Effect.provideMut<Allocator>(&mut allocator)
  let suspendsIndex = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(&suspends, selectedMirIndex)
  let mut boundary = usize.MAX
  let mut nestedParks = true
  if let Option<usize>.Some {value: index} = move suspendsIndex {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(&store, index) {
      if let Option<Anchor>.Some {value: anchor} = &suspendsAnchor {
        if let Option<BodyOrigin>.Some {value: origin} = &function.suspension { boundary = Anchor.span(&anchor, origin.location).start }
      }
      nestedParks = match &function.parks { Option<BodyOrigin>.Some {..} => true Option<BodyOrigin>.None => false }
    }
  }
  run Testing.expect(succeeded(&suspendsBody) && boundary == offsetOf(text, "run Intrinsic.suspendEffect", 0),
    "a suspension composes the deferred child's channels, and its run marks the instance as a suspension origin")
  run Testing.expect(!nestedParks, "a nested transfer is a suspension boundary but not an external park")
  let guarded = run Semantic.demandMir(&mut store, &mut request, &id, b"guarded") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(failureFact(&store, &guarded, 3) == usize.ONE,
    "an owned operand evaluated before a failing run in the same call is dropped on the failure edge")
  let rewidened = run Semantic.demandMir(&mut store, &mut request, &id, b"rewidened") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(failureFact(&store, &rewidened, 2) == usize.ONE && failureFact(&store, &rewidened, 4) == usize.ONE,
    "a union failure re-injects into a wider union through one switch on the caught member")
  let rethrow = run Semantic.demandMir(&mut store, &mut request, &id, b"rethrow") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(failureFact(&store, &rethrow, usize.ONE) == usize.ONE, "`fail move` transfers its operand into Failure and fails")
  let quiet = run Semantic.demandBody(&mut store, &mut request, &id, b"quiet") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let shaped = run Semantic.demandBody(&mut store, &mut request, &id, b"shaped") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let unprovided = run Semantic.demandBody(&mut store, &mut request, &id, b"unprovided") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsSpan(&quiet, RejectionCode.UndeclaredFailure, text, "77", 0) &&
    rejectsSpan(&shaped, RejectionCode.StructFieldTypeMismatch, text, "false", 0) &&
    rejectsSpan(&unprovided, RejectionCode.UnhandledRequirement, text, "run reads()", 0),
    "an effect fn without a failure cannot fail, a payload's own mismatch keeps its site, and rows must be covered")
  let settled = run Semantic.demandMir(&mut store, &mut request, &id, b"settled") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut uninhabited = false
  if let Option<InstanceKey>.Some {value: settleKey} = move providedCallee(&store, &settled, "settle") {
    let settle = run sourceCallMir(&mut store, &mut request, &settled, &settleKey, usize.ZERO, false) |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
    uninhabited = succeeded(&settle) && failureFact(&store, &settle, usize.ZERO) == usize.ZERO
      && failureFact(&store, &settle, usize.ONE) == usize.ZERO && neverReads(&store, &settle) == usize.ZERO
      && unreachableExits(&store, &settle) > usize.ZERO
    if let Option<InstanceKey>.Some {..} = move providedCallee(&store, &settle, "raise") { uninhabited = false }
  }
  run Testing.expect(uninhabited, "a specialized never arm becomes unreachable before the callee can receive its uninhabited operand")
  let explicitBottom = run Semantic.demandBody(&mut store, &mut request, &id, b"explicitBottom") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsSpan(&explicitBottom, RejectionCode.UndeclaredFailure, text, "error", 4),
    "an explicitly empty failure channel rejects a fail statement before checking its payload")
  let bottomSource = run present(text) |> Effect.provideMut<Allocator>(&mut allocator)
  let bottomRevision = run Revision.publish(&Revision.make(), &id, &bottomSource) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut bottomIndex = SourceIndex.make(run Revision.copy(&bottomRevision) |> Effect.provideMut<Allocator>(&mut allocator))
  let bottomDeclaration = run requireIndexedIdentity(&mut bottomIndex, &id, OwnerKind.Function, b"bottom", usize.ZERO)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut bottomArguments = Vector<Argument>.make()
  run Vector<Argument>.append(&mut bottomArguments, Argument.Type {value: run Types.intern(Type.Union {members: Vector<Shared<Type>>.make()})
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)}) |> Effect.provideMut<Allocator>(&mut allocator)
  run Vector<Argument>.append(&mut bottomArguments, Argument.Lifetime {value: run Shared<Lifetime>.make(Lifetime.Static)
    |> Effect.provideMut<Allocator>(&mut allocator)}) |> Effect.provideMut<Allocator>(&mut allocator)
  let bottomApplication = run specializationWithArguments(&bottomDeclaration, move bottomArguments)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let bottom = run Semantic.demandApplicationMir(&mut store, &mut request, &bottomApplication)
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(succeeded(&bottom) && failureFact(&store, &bottom, usize.ZERO) == usize.ZERO
    && failureFact(&store, &bottom, usize.ONE) == usize.ZERO && neverReads(&store, &bottom) == usize.ZERO
    && unreachableExits(&store, &bottom) > usize.ZERO,
    "`fail` in a closed instance whose failure is `never` lowers unreachable without a Failure out-slot or Fail exit")
  let unwrapped = run Semantic.demandMir(&mut store, &mut request, &id, b"unwrapped") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(succeeded(&unwrapped) && neverReads(&store, &unwrapped) == usize.ZERO && unreachableExits(&store, &unwrapped) > usize.ZERO,
    "an arm that yields a `never` value ends unreachable instead of writing it into the match result")
  return ()
}

// Assignments that read a whole local of an uninhabited type in the selected MIR function.
fn neverReads(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>) -> usize {
  let mut count = usize.ZERO
  let selected = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      let locals = Vector<MirLocal>.asSlice(&function.locals)
      let blocks = Vector<MirBlock>.asSlice(&function.blocks)
      let mut at = usize.ZERO
      while at < blocks.length {
        let statements = Vector<MirStatement>.asSlice(&blocks[at].statements)
        let mut position = usize.ZERO
        while position < statements.length {
          if let MirStatement.Assign {value: MirRvalue.Use {value: operand}, ..} = &statements[position] {
            let read = match &operand { MirOperand.Copy {place} => place.local MirOperand.Move {place} => place.local _ => usize.MAX }
            if read < locals.length && Shared<Type>.with<bool>(&locals[read].ty, fn(value: &Type) -> bool { return Type.isNever(value) }) { count = count + usize.ONE }
          }
          position = position + usize.ONE
        }
        at = at + usize.ONE
      }
    }
  }
  return count
}

fn unreachableExits(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>) -> usize {
  let mut count = usize.ZERO
  let selected = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      let blocks = Vector<MirBlock>.asSlice(&function.blocks)
      let mut at = usize.ZERO
      while at < blocks.length {
        if let MirTerminator.Unreachable {..} = &blocks[at].terminator { count = count + usize.ONE }
        at = at + usize.ONE
      }
    }
  }
  return count
}

// The definition text that starts with `header`, through its closing brace; empty when absent.
fn definitionAt<'a>(text: &'a [u8], header: &[u8]) -> &'a [u8] {
  let mut start = usize.ZERO
  while start + header.length <= text.length {
    if sameBytes(Slice.view<u8>(text, start, header.length), header) {
      let mut end = start + header.length
      while end < text.length && !(text[end] == 125 && text[end - usize.ONE] == 10) {
        end = end + usize.ONE
      }
      return Slice.view<u8>(text, start, end - start)
    }
    start = start + usize.ONE
  }
  return Slice.view<u8>(text, usize.ZERO, usize.ZERO)
}

test effect fn selectedRuntimeExportsAreTheBuildRoots() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run runtimeRootClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn runtimeRootClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator | &mut Types {
  let runtime = run module("runtime-roots.silk")
  let application = run module("runtime-application.silk")
  let lanes = run module("runtime-lanes.silk")
  let absent = run module("runtime-absent.silk")
  let runtimeText = """import Intrinsic.application
fn forward(count: i32, values: ?[*]const u8) -> i32 { return application.answer(count) }
export "C" fn enter(count: i32, values: ?[*]const u8) -> i32 as "main" { return forward(count, values) }
export "C" fn narrow(value: i8) -> u16 as "silk_narrow" { return 7 }
static if false {
  export "C" fn inactive() -> i32 as "silk_inactive" { return 1 }
}
"""
  let laneText = """export "C" fn flag(value: bool) -> i32 as "silk_flag" { return 0 }
"""
  let runtimeSource = run present(runtimeText)
  let applicationSource = run present("pub fn answer(count: i32) -> i32 { return count + 1 }\n")
  let laneSource = run present(laneText)
  let first = run Revision.publish(&Revision.make(), &runtime, &runtimeSource)
  let second = run Revision.publish(&first, &application, &applicationSource)
  let revision = run Revision.publish(&second, &lanes, &laneSource)
  let mut store = Semantic.traced(move revision, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu), Option<FinalProfile>.none())
  let mut request = Request.forApplication(ModuleId.copy(&application))
  let roots = [ModuleId.copy(&runtime), ModuleId.copy(&application)]
  let built = run Semantic.buildArtifact(&mut store, &mut request, Option<&ModuleId>.some(&runtime), &roots, staticClosureNodes)
  let mut rooted = false
  if let BackendBuild.Module {text, ..} = &built {
    let ir = Bytes.asSlice(&text)
    let shim = definitionAt(ir, b"define i32 @\"main\"(i32 %p0, ptr %p1) noinline nounwind personality ptr @__silk_foreign_personality {")
    rooted = containsIr(shim, b" = invoke i32 @silk_") && containsIr(ir, b"define zeroext i16 @\"silk_narrow\"(i8 signext %p0) noinline nounwind personality ptr @__silk_foreign_personality {")
      && !containsIr(ir, b"silk_inactive") && !containsIr(ir, b"define i32 @main(")
  }
  run Testing.expect(rooted,
    "active runtime C exports are the only roots: each forwards its C lanes under the requested symbol, and Intrinsic.application reaches the application")
  // A one-shot store records no revision evidence and computes the same module.
  let onceRevision = run Revision.publish(&second, &lanes, &laneSource)
  let mut single = Semantic.oneShot(move onceRevision, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu), Option<FinalProfile>.none())
  let mut onceRequest = Request.forApplication(ModuleId.copy(&application))
  let onceBuilt = run Semantic.buildArtifact(&mut single, &mut onceRequest, Option<&ModuleId>.some(&runtime), &roots, staticClosureNodes)
  let mut agrees = false
  if let BackendBuild.Module {text, ..} = &built {
    if let BackendBuild.Module {text: onceText, ..} = &onceBuilt {
      agrees = sameBytes(Bytes.asSlice(&text), Bytes.asSlice(&onceText))
    }
  }
  // A signature root replays the source observations its answer retains.
  let mut tracedProbe = Request.make()
  let tracedAnswer = run Semantic.demandSignature(&mut store, &mut tracedProbe, &application, b"answer")
  let mut singleProbe = Request.make()
  let singleAnswer = run Semantic.demandSignature(&mut single, &mut singleProbe, &application, b"answer")
  run Testing.expect(agrees && Semantic.requestDiscovered(&mut store, &tracedProbe, &application) && !Semantic.requestDiscovered(&mut single, &singleProbe, &application),
    "a one-shot store emits the same module as a revisable store and keeps none of its source observations")
  run Testing.expect(Semantic.digestedLlvmInputs(&store) > usize.ZERO && Semantic.digestedLlvmInputs(&single) == usize.ZERO,
    "a revisable store names its LLVM inputs by content digest; a one-shot store hashes none")
  let armRuntime = run Revision.publish(&Revision.make(), &runtime, &runtimeSource)
  let armRevision = run Revision.publish(&armRuntime, &application, &applicationSource)
  let mut arm = Semantic.traced(move armRevision, MachineTarget.forId(TargetId.Aarch64UnknownLinuxGnu), Option<FinalProfile>.none())
  let mut armRequest = Request.forApplication(ModuleId.copy(&application))
  let armBuilt = run Semantic.buildArtifact(&mut arm, &mut armRequest, Option<&ModuleId>.some(&runtime), &roots, staticClosureNodes)
  let mut bare = false
  if let BackendBuild.Module {text, ..} = &armBuilt {
    bare = containsIr(Bytes.asSlice(&text), b"define i16 @\"silk_narrow\"(i8 %p0) noinline nounwind personality ptr @__silk_foreign_personality {")
  }
  run Testing.expect(bare, "an AAPCS64 Linux C export leaves its narrow integer lanes unextended")
  let mut laneRequest = Request.forApplication(ModuleId.copy(&application))
  let laneRoots = [ModuleId.copy(&lanes), ModuleId.copy(&application)]
  let narrowed = run Semantic.buildArtifact(&mut store, &mut laneRequest, Option<&ModuleId>.some(&lanes), &laneRoots, staticClosureNodes)
  let mut absentRequest = Request.forApplication(ModuleId.copy(&application))
  let missingRoots = [ModuleId.copy(&application)]
  let missing = run Semantic.buildArtifact(&mut store, &mut absentRequest, Option<&ModuleId>.some(&absent), &missingRoots, staticClosureNodes)
  let missingRuntime = match &missing {
    BackendBuild.Rejected {first: diagnostic, ..} => Shared<Rejection>.with<bool>(&diagnostic, fn(found: &Rejection) -> bool {
      return found.code == RejectionCode.MissingModule && ModuleId.equals(&found.module, &absent)
    })
    _ => false
  }
  run Testing.expect(foreignContractGapAt(&narrowed, offsetOf(laneText, "export \"C\" fn flag", usize.ZERO)) && missingRuntime,
    "an export lane outside the C scalar and pointer subset keeps its named gap, and an absent runtime source is rejected at that module")
  // A library or object form selects no runtime: its application's C exports are the only roots,
  // and an application without one builds an empty artifact rather than requiring an entry.
  let library = run module("runtime-library.silk")
  let libraryText = "fn helper() -> i32 { return 41 }\nexport \"C\" fn answer() -> i32 as \"silk_answer\" { return helper() + 1 }\n"
  let librarySource = run present(libraryText)
  let libraryRevision = run Revision.publish(&Revision.make(), &library, &librarySource)
  let mut libraryStore = Semantic.oneShot(move libraryRevision, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu), Option<FinalProfile>.none())
  let mut libraryRequest = Request.forApplication(ModuleId.copy(&library))
  let libraryRoots = [ModuleId.copy(&library)]
  let libraryBuilt = run Semantic.buildArtifact(&mut libraryStore, &mut libraryRequest, Option<&ModuleId>.none(), &libraryRoots, staticClosureNodes)
  let mut exportsOnly = false
  if let BackendBuild.Module {text, ..} = &libraryBuilt {
    let ir = Bytes.asSlice(&text)
    exportsOnly = containsIr(ir, b"define i32 @\"silk_answer\"() noinline nounwind personality ptr @__silk_foreign_personality {")
      && containsIr(ir, b" = invoke i32 @silk_") && !containsIr(ir, b"@\"main\"") && !containsIr(ir, b"@main(")
  }
  let plain = run module("runtime-bare.silk")
  let plainSource = run present("pub fn answer() -> i32 { return 42 }\n")
  let plainRevision = run Revision.publish(&Revision.make(), &plain, &plainSource)
  let mut plainStore = Semantic.oneShot(move plainRevision, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu), Option<FinalProfile>.none())
  let mut plainRequest = Request.forApplication(ModuleId.copy(&plain))
  let plainRoots = [ModuleId.copy(&plain)]
  let plainBuilt = run Semantic.buildArtifact(&mut plainStore, &mut plainRequest, Option<&ModuleId>.none(), &plainRoots, staticClosureNodes)
  let mut empty = false
  if let BackendBuild.Module {text, ..} = &plainBuilt {
    empty = !containsIr(Bytes.asSlice(&text), b"define i32 @silk_") && !containsIr(Bytes.asSlice(&text), b"@\"main\"")
  }
  run Testing.expect(exportsOnly && empty,
    "without a runtime the application's C exports are the only roots, and an application with none builds an empty artifact")
  return ()
}

test effect fn buildsSelectExactlyOneRuntime() -> ()
! FileError | TomlError | InvalidSourceRoot | InvalidDependency | MissingManifest | InvalidBuildComposition | MissingStandardLibrary | InvalidNativeLinkInput | InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let mut files = run OsFileSystem.make(b"/") |> Effect.provideMut<Allocator>(&mut allocator)
  return run compositionClaims() |> Effect.provideMut<FileSystem>(&mut files) |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn writePackageFile(directory: &Path, name: string, contents: &[u8]) -> ()
! FileError | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  let path = run Path.join(directory, name)
  return run FileSystem.writeFile(&path, contents)
}

// Whether reading the package for x86-64 Linux and `libc` fails only because it selects no single
// runtime.
effect fn compositionRefused(source: &Path, standardLibrary: Option<Path>, libc: &[u8]) -> bool
! FileError | TomlError | InvalidSourceRoot | InvalidDependency | MissingManifest | MissingStandardLibrary | InvalidNativeLinkInput | InvalidModulePath | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  return run requestRefused(source, move standardLibrary, libc, ProfileSelection.Default)
}

// Whether reading the package as an executable with the profile's runtime `request` fails only
// because it selects no single runtime.
effect fn requestRefused(source: &Path, standardLibrary: Option<Path>, libc: &[u8], request: ProfileSelection) -> bool
! FileError | TomlError | InvalidSourceRoot | InvalidDependency | MissingManifest | MissingStandardLibrary | InvalidNativeLinkInput | InvalidModulePath | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  let attempted = run Effect.result(ModuleSourceFiles.make(source, move standardLibrary, b"x86_64-unknown-linux-gnu", libc, true, move request))
  return match move attempted {
    Result<ModuleSources, FileError | TomlError | InvalidSourceRoot | InvalidDependency | MissingManifest | InvalidBuildComposition | MissingStandardLibrary | InvalidNativeLinkInput | InvalidModulePath | OutOfMemoryError>.Success {value} => {
      drop value
      return false
    }
    Result<ModuleSources, FileError | TomlError | InvalidSourceRoot | InvalidDependency | MissingManifest | InvalidBuildComposition | MissingStandardLibrary | InvalidNativeLinkInput | InvalidModulePath | OutOfMemoryError>.Failure {error} => match move error {
      InvalidBuildComposition refused => {
        drop refused
        return true
      }
      MissingStandardLibrary failure => { fail move failure }
      FileError failure => { fail move failure }
      TomlError failure => { fail move failure }
      InvalidSourceRoot failure => { fail move failure }
      MissingManifest failure => { fail move failure }
      InvalidNativeLinkInput failure => { fail move failure }
      InvalidDependency failure => { fail move failure }
      InvalidModulePath failure => { fail move failure }
      OutOfMemoryError failure => { fail move failure }
    }
  }
}

// The runtime a fixture package selects, or an identity no fixture publishes when it selects none.
effect fn selectedRuntime(sources: &ModuleSources) -> ModuleId ! InvalidModulePath | OutOfMemoryError ? &mut Allocator {
  return match move ModuleSourceFiles.runtime(sources) {
    Option<&ModuleId>.Some {value} => ModuleId.copy(value)
    Option<&ModuleId>.None => run ModuleId.make(b"file", b"absent", b"absent-runtime.silk")
  }
}

// Whether `sources` selected no runtime, as a library or object form without a default does.
fn runtimeless(sources: &ModuleSources) -> bool {
  return match move ModuleSourceFiles.runtime(sources) {
    Option<&ModuleId>.Some {..} => false
    Option<&ModuleId>.None => true
  }
}

// Native filesystem fixtures need the physical temporary root: /tmp is a symlink on Darwin.
effect fn fixtureTemporaryParent() -> Path
  ! FileError | OutOfMemoryError
  ? &mut Allocator {
  static if Intrinsic.targetOperatingSystem() == "darwin" {
    return run Path.make("/private/tmp")
  } else {
    return run Path.make("/tmp")
  }
}

effect fn compositionClaims() -> ()
! FileError | TomlError | InvalidSourceRoot | InvalidDependency | MissingManifest | InvalidBuildComposition | MissingStandardLibrary | InvalidNativeLinkInput | InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
? &mut FileSystem | &mut Allocator | &mut Types {
  let parent = run fixtureTemporaryParent()
  let temp = run FileSystem.temporaryDirectory(&parent, "silk-runtime-composition-")
  let support = run Path.join(&temp.path, "support")
  run FileSystem.createDirectory(&support)
  run writePackageFile(&temp.path, "silk.toml", b"[package]\nname = \"composed\"\nversion = \"0.1.0\"\nroot = \"main.silk\"\n\n[build]\ncomposition = { runtimes = [{ name = \"other\", module = \"unused\" }, { name = \"start\", module = \"support/start\" }], defaults = [\"start\"], retention = [], requirements = [] }\n")
  run writePackageFile(&temp.path, "main.silk", b"pub fn answer() -> i32 { return 42 }\n")
  run writePackageFile(&support, "start.silk", b"import Intrinsic.application\nexport \"C\" fn enter() -> i32 as \"main\" { return application.answer() }\n")
  let source = run Path.join(&temp.path, "main.silk")
  let mut sources = run ModuleSourceFiles.make(&source, Option<Path>.none(), b"x86_64-unknown-linux-gnu", b"gnu", true, ProfileSelection.Default)
  let application = ModuleId.copy(ModuleSourceFiles.entry(&sources))
  let runtime = run selectedRuntime(&sources)
  run ModuleSourceFiles.preloadProgram(&mut sources, &application)
  let rootPackage = run ModuleSourceFiles.loadedRootModules(&sources)
  let mut store = Semantic.traced(run ModuleSourceFiles.revision(&sources), MachineTarget.forId(TargetId.X8664UnknownLinuxGnu), Option<FinalProfile>.none())
  let mut request = Request.forApplication(ModuleId.copy(&application))
  let built = run Semantic.buildArtifact(&mut store, &mut request, Option<&ModuleId>.some(&runtime), Vector<ModuleId>.asSlice(&rootPackage), staticClosureNodes)
  let rooted = match &built {
    BackendBuild.Module {text, ..} => containsIr(Bytes.asSlice(&text), b"define i32 @\"main\"() noinline nounwind personality ptr @__silk_foreign_personality {")
    _ => false
  }
  let runtimePath = run ModuleId.copyPath(&runtime)
  run Testing.expect(sameBytes(Bytes.asSlice(&runtimePath), b"support/start.silk") && rooted,
    "the default names a listed package module, which is preloaded and roots the build with its C export")
  run writePackageFile(&temp.path, "silk.toml", b"[package]\nname = \"composed\"\nversion = \"0.1.0\"\nroot = \"main.silk\"\n\n[build]\ncomposition = { runtimes = [{ name = \"start\", module = \"support/start\" }], defaults = [\"start\", \"start\"], retention = [], requirements = [] }\n")
  let ambiguous = run compositionRefused(&source, Option<Path>.none(), b"gnu")
  run writePackageFile(&temp.path, "silk.toml", b"[package]\nname = \"composed\"\nversion = \"0.1.0\"\nroot = \"main.silk\"\n\n[build]\ncomposition = { runtimes = [{ name = \"start\", module = \"support/start\" }], defaults = [\"hosted\"], retention = [], requirements = [] }\n")
  let unlisted = run compositionRefused(&source, Option<Path>.none(), b"gnu")
  run writePackageFile(&temp.path, "silk.toml", b"[package]\nname = \"composed\"\nversion = \"0.1.0\"\nroot = \"main.silk\"\n\n[build]\ncomposition = { runtimes = [{ name = \"start\", module = \"support/start\" }], defaults = [], retention = [], requirements = [] }\n")
  let unselected = run compositionRefused(&source, Option<Path>.none(), b"gnu")
  run Testing.expect(ambiguous && unlisted && unselected,
    "two default candidates are ambiguous, an unlisted default never falls back, and a composition must select a runtime")
  run writePackageFile(&temp.path, "silk.toml", b"[package]\nname = \"composed\"\nversion = \"0.1.0\"\nroot = \"main.silk\"\n\n[build]\ncomposition = { runtimes = [{ name = \"start\", module = \"support/start\" }], defaults = [\"start\"], retention = [{ module = \"support/start\", declaration = \"enter\" }] }\n")
  let retaining = run ModuleSourceFiles.make(&source, Option<Path>.none(), b"x86_64-unknown-linux-gnu", b"gnu", true, ProfileSelection.Default)
  let selectors = run ModuleSourceFiles.retention(&retaining)
  let decoded = Vector<RetentionRoot>.asSlice(&selectors)
  let mut retainedPath = Bytes.make()
  if decoded.length == usize.ONE { retainedPath = run ModuleId.copyPath(&decoded[0].module) }
  run writePackageFile(&temp.path, "silk.toml", b"[package]\nname = \"composed\"\nversion = \"0.1.0\"\nroot = \"main.silk\"\n\n[build]\ncomposition = { runtimes = [{ name = \"start\", module = \"support/start\" }], defaults = [\"start\"], retention = [{ module = \"support/start\", declaration = \"enter\", symbol = \"x\" }] }\n")
  let extraKey = run compositionRefused(&source, Option<Path>.none(), b"gnu")
  run writePackageFile(&temp.path, "silk.toml", b"[package]\nname = \"composed\"\nversion = \"0.1.0\"\nroot = \"main.silk\"\n\n[build]\ncomposition = { runtimes = [{ name = \"start\", module = \"support/start\" }], defaults = [\"start\"], retention = [{ module = \"support/start\", declaration = \"1enter\" }] }\n")
  let badName = run compositionRefused(&source, Option<Path>.none(), b"gnu")
  run writePackageFile(&temp.path, "silk.toml", b"[package]\nname = \"composed\"\nversion = \"0.1.0\"\nroot = \"main.silk\"\n\n[build]\ncomposition = { runtimes = [{ name = \"start\", module = \"support/start\" }], defaults = [\"start\"], retention = { module = \"support/start\", declaration = \"enter\" } }\n")
  let scalarRetention = run compositionRefused(&source, Option<Path>.none(), b"gnu")
  run Testing.expect(
    decoded.length == usize.ONE && sameBytes(Bytes.asSlice(&retainedPath), b"support/start.silk") && sameBytes(Bytes.asSlice(&decoded[0].declaration), b"enter")
      && extraKey && badName && scalarRetention,
    "retention selectors name exactly a package module and an identifier declaration in an array"
  )
  // The profile's runtime request selects a listed runtime by name, or none at all.
  run writePackageFile(&temp.path, "silk.toml", b"[package]\nname = \"composed\"\nversion = \"0.1.0\"\nroot = \"main.silk\"\n\n[build]\ncomposition = { runtimes = [{ name = \"start\", module = \"support/start\" }, { name = \"other\", module = \"support/other\" }], defaults = [\"start\"] }\n")
  let namedSources = run ModuleSourceFiles.make(&source, Option<Path>.none(), b"x86_64-unknown-linux-gnu", b"gnu", true,
    ProfileSelection.Named {name: run Bytes.copy(b"other")})
  let namedRuntime = run selectedRuntime(&namedSources)
  let namedPath = run ModuleId.copyPath(&namedRuntime)
  let unlistedName = run requestRefused(&source, Option<Path>.none(), b"gnu", ProfileSelection.Named {name: run Bytes.copy(b"absent")})
  let noneSources = run ModuleSourceFiles.make(&source, Option<Path>.none(), b"x86_64-unknown-linux-gnu", b"gnu", true, ProfileSelection.None)
  run Testing.expect(sameBytes(Bytes.asSlice(&namedPath), b"support/other.silk") && unlistedName && runtimeless(&noneSources),
    "a named runtime request selects the listed runtime of that name, never a default, and a none request selects no runtime")
  run writePackageFile(&temp.path, "silk.toml", b"[package]\nname = \"composed\"\nversion = \"0.1.0\"\nroot = \"main.silk\"\n\n[build]\ncomposition = { runtimes = [{ name = \"start\", module = \"support/start\" }], defaults = [], retention = [], requirements = [] }\n")
  // A library or object form needs no runtime: an empty or absent default selects none.
  let emptyDefaults = run ModuleSourceFiles.make(&source, Option<Path>.none(), b"x86_64-unknown-linux-gnu", b"gnu", false, ProfileSelection.Default)
  run writePackageFile(&temp.path, "silk.toml", b"[package]\nname = \"composed\"\nversion = \"0.1.0\"\nroot = \"main.silk\"\n\n[build]\ncomposition = { runtimes = [{ name = \"start\", module = \"support/start\" }], retention = [], requirements = [] }\n")
  let absentDefaults = run ModuleSourceFiles.make(&source, Option<Path>.none(), b"x86_64-unknown-linux-gnu", b"gnu", false, ProfileSelection.Default)
  let absentForExecutable = run compositionRefused(&source, Option<Path>.none(), b"gnu")
  run Testing.expect(runtimeless(&emptyDefaults) && runtimeless(&absentDefaults) && absentForExecutable,
    "a library or object composition with an empty or absent default selects no runtime, which an executable refuses")
  // Without a composition the standard-library catalog supplies the runtime listed for the target and libc.
  run writePackageFile(&temp.path, "silk.toml", b"[package]\nname = \"composed\"\nversion = \"0.1.0\"\nroot = \"main.silk\"\n")
  let library = run Path.join(&temp.path, "library")
  run FileSystem.createDirectory(&library)
  run writePackageFile(&library, "compositions.json", b"{\"runtimes\": [{\"targets\": [\"aarch64-apple-darwin\"], \"libc\": \"system\", \"name\": \"hosted\", \"module\": \"silk/darwin_start\"}, {\"targets\": [\"x86_64-unknown-linux-gnu\"], \"libc\": \"gnu\", \"name\": \"hosted\", \"module\": \"silk/linux_start\"}], \"components\": []}")
  let catalogued = run ModuleSourceFiles.make(&source, Option<Path>.some(run Path.fromBytes(Path.rawBytes(&library))),
    b"x86_64-unknown-linux-gnu", b"gnu", true, ProfileSelection.Default)
  let cataloguedRuntime = run selectedRuntime(&catalogued)
  let catalogPath = run ModuleId.copyPath(&cataloguedRuntime)
  let catalogRuntime = sameBytes(Bytes.asSlice(&catalogPath), b"silk/linux_start.silk")
  let refusedUnmatched = run compositionRefused(&source, Option<Path>.some(run Path.fromBytes(Path.rawBytes(&library))), b"none")
  let bare = run Path.join(&temp.path, "bare")
  run FileSystem.createDirectory(&bare)
  let uncatalogued = run compositionRefused(&source, Option<Path>.some(move bare), b"gnu")
  let unlibraried = run libraryRefused(&source)
  run Testing.expect(catalogRuntime && refusedUnmatched && uncatalogued && unlibraried,
    "without a composition the catalog runtime for the target and libc is selected; no listed runtime or a library without a catalog is refused, and no library is reported as missing")
  let namedCatalog = run ModuleSourceFiles.make(&source, Option<Path>.some(run Path.fromBytes(Path.rawBytes(&library))),
    b"x86_64-unknown-linux-gnu", b"gnu", true, ProfileSelection.Named {name: run Bytes.copy(b"hosted")})
  let namedCatalogRuntime = run selectedRuntime(&namedCatalog)
  let namedCatalogPath = run ModuleId.copyPath(&namedCatalogRuntime)
  let otherCatalogName = run requestRefused(&source, Option<Path>.some(run Path.fromBytes(Path.rawBytes(&library))), b"gnu",
    ProfileSelection.Named {name: run Bytes.copy(b"other")})
  let noneCatalog = run ModuleSourceFiles.make(&source, Option<Path>.none(), b"x86_64-unknown-linux-gnu", b"gnu", true, ProfileSelection.None)
  run Testing.expect(sameBytes(Bytes.asSlice(&namedCatalogPath), b"silk/linux_start.silk") && otherCatalogName && runtimeless(&noneCatalog),
    "a named request selects the catalog runtime of that name for the target and libc, and none needs no catalog")
  // A library or object form acquires no catalog runtime, so it needs neither a match nor a catalog.
  let catalogLibrary = run ModuleSourceFiles.make(&source, Option<Path>.some(run Path.fromBytes(Path.rawBytes(&library))),
    b"x86_64-unknown-linux-gnu", b"gnu", false, ProfileSelection.Default)
  let unmatchedLibrary = run ModuleSourceFiles.make(&source, Option<Path>.some(run Path.fromBytes(Path.rawBytes(&library))),
    b"x86_64-unknown-linux-gnu", b"none", false, ProfileSelection.Default)
  let uncataloguedLibrary = run ModuleSourceFiles.make(&source, Option<Path>.none(), b"x86_64-unknown-linux-gnu", b"gnu", false, ProfileSelection.Default)
  run Testing.expect(runtimeless(&catalogLibrary) && runtimeless(&unmatchedLibrary) && runtimeless(&uncataloguedLibrary),
    "a library or object form without a composition acquires no catalog runtime")
  // A composition component may bind standard-library and package declarations together.
  run writePackageFile(&temp.path, "silk.toml", b"[package]\nname = \"composed\"\nversion = \"0.1.0\"\nroot = \"main.silk\"\n\n[build]\ncomposition = { runtimes = [{ name = \"start\", module = \"support/start\" }], defaults = [\"start\"], retention = [], requirements = [], components = [{ capability = \"execution-storage\", bindings = [{ operation = \"create\", module = \"silk/execution_storage\", declaration = \"silk_execution_storage_create\" }, { operation = \"acquire\", module = \"support/refusing\", declaration = \"refuse\" }, { operation = \"release\", module = \"silk/execution_storage\", declaration = \"silk_execution_storage_release\" }, { operation = \"destroy\", module = \"silk/execution_storage\", declaration = \"silk_execution_storage_destroy\" }] }] }\n")
  let mixed = run ModuleSourceFiles.make(&source, Option<Path>.some(run Path.fromBytes(Path.rawBytes(&library))),
    b"x86_64-unknown-linux-gnu", b"gnu", true, ProfileSelection.Default)
  let mut routed = false
  if let Option<&ExecutionStorage>.Some {value: storage} = move ModuleSourceFiles.executionStorage(&mixed) {
    let created = run ModuleSourceFiles.sourceLocation(&mixed, &storage.create.module)
    let acquired = run ModuleSourceFiles.sourceLocation(&mixed, &storage.acquire.module)
    let createPath = run ModuleId.copyPath(&storage.create.module)
    let acquirePath = run ModuleId.copyPath(&storage.acquire.module)
    routed = created.provider == ProviderRole.StandardLibrary && acquired.provider == ProviderRole.Compiler &&
      sameBytes(Bytes.asSlice(&createPath), b"silk/execution_storage.silk") &&
      sameBytes(Bytes.asSlice(&acquirePath), b"support/refusing.silk") &&
      sameBytes(Bytes.asSlice(&storage.acquire.declaration), b"refuse")
  }
  run Testing.expect(routed,
    "a composition binding a silk/ module reads it from the standard library, as an import does, while a package binding reads from the package")
  run FileSystem.release(move temp)
  return ()
}

test effect fn packageIdentityExcludesTheCheckoutDirectory() -> ()
! FileError | TomlError | InvalidSourceRoot | InvalidDependency | MissingManifest | InvalidBuildComposition | MissingStandardLibrary | InvalidNativeLinkInput | InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let mut files = run OsFileSystem.make(b"/") |> Effect.provideMut<Allocator>(&mut allocator)
  return run packageIdentityClaims() |> Effect.provideMut<FileSystem>(&mut files) |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

fn containsModule(modules: &[ModuleId], wanted: &ModuleId) -> bool {
  let mut at = usize.ZERO
  while at < modules.length {
    if ModuleId.equals(&modules[at], wanted) { return true }
    at = at + usize.ONE
  }
  return false
}

effect fn loadedRootPackageClaims() -> ()
! FileError | TomlError | InvalidSourceRoot | InvalidDependency | MissingManifest | InvalidBuildComposition | MissingStandardLibrary | InvalidNativeLinkInput | InvalidModulePath | OutOfMemoryError | AssertionError<'static>
? &mut FileSystem | &mut Allocator {
  let parent = run fixtureTemporaryParent()
  let temp = run FileSystem.temporaryDirectory(&parent, "silk-root-package-")
  let app = run Path.join(&temp.path, "app")
  let library = run Path.join(&temp.path, "stdlib")
  let silk = run Path.join(&library, "silk")
  run FileSystem.createDirectory(&app)
  run FileSystem.createDirectory(&library)
  run FileSystem.createDirectory(&silk)
  run writePackageFile(&app, "silk.toml", b"[package]\nname = \"root-app\"\nversion = \"0.1.0\"\nroot = \"main.silk\"\n[build]\ncomposition = { runtimes = [{ name = \"local\", module = \"local\" }], defaults = [\"local\"], retention = [], requirements = [] }\n")
  run writePackageFile(&app, "main.silk", b"import local\nimport silk.option\nimport missing\nimport silk.missing\n")
  run writePackageFile(&app, "local.silk", b"pub fn local() -> i32 { return 0 }\n")
  run writePackageFile(&silk, "option.silk", b"pub struct OptionMarker {}\n")
  let appSource = run Path.join(&app, "main.silk")
  let mut appSources = run ModuleSourceFiles.make(&appSource,
    Option<Path>.some(run Path.fromBytes(Path.rawBytes(&library))), b"x86_64-unknown-linux-gnu", b"gnu", true, ProfileSelection.Default)
  let appRoot = ModuleId.copy(ModuleSourceFiles.entry(&appSources))
  let appLocal = run ModuleSourceFiles.module(&appSources, b"local.silk")
  let appLibrary = run ModuleSourceFiles.module(&appSources, b"silk/option.silk")
  let appMissing = run ModuleSourceFiles.module(&appSources, b"missing.silk")
  run ModuleSourceFiles.preloadProgram(&mut appSources, &appRoot)
  let appLoaded = run ModuleSourceFiles.loadedRootModules(&appSources)
  let appListed = Vector<ModuleId>.asSlice(&appLoaded)
  let appRevision = run ModuleSourceFiles.revision(&appSources)
  run Testing.expect(appListed.length == 2 && containsModule(appListed, &appRoot) && containsModule(appListed, &appLocal)
    && !containsModule(appListed, &appLibrary) && !containsModule(appListed, &appMissing)
    && Revision.presents(&appRevision, &appLibrary) && ModuleId.samePackage(&appRoot, &appLibrary),
    "a present standard-library dependency shares the app's logical package but is outside its root sweep")

  run writePackageFile(&library, "silk.toml", b"[package]\nname = \"root-stdlib\"\nversion = \"0.1.0\"\nroot = \"stdlib_check.silk\"\n[build]\ncomposition = { runtimes = [{ name = \"check\", module = \"check_runtime\" }], defaults = [\"check\"], retention = [], requirements = [] }\n")
  run writePackageFile(&library, "stdlib_check.silk", b"import silk.option\nimport silk.missing\n")
  run writePackageFile(&library, "check_runtime.silk", b"export \"C\" fn enter() -> i32 as \"main\" { return 0 }\n")
  let librarySource = run Path.join(&library, "stdlib_check.silk")
  let mut librarySources = run ModuleSourceFiles.make(&librarySource,
    Option<Path>.some(run Path.fromBytes(Path.rawBytes(&library))), b"x86_64-unknown-linux-gnu", b"gnu", true, ProfileSelection.Default)
  let libraryRoot = ModuleId.copy(ModuleSourceFiles.entry(&librarySources))
  let libraryOption = run ModuleSourceFiles.module(&librarySources, b"silk/option.silk")
  let libraryRuntime = run selectedRuntime(&librarySources)
  let libraryMissing = run ModuleSourceFiles.module(&librarySources, b"silk/missing.silk")
  run ModuleSourceFiles.preloadProgram(&mut librarySources, &libraryRoot)
  let libraryLoaded = run ModuleSourceFiles.loadedRootModules(&librarySources)
  let libraryListed = Vector<ModuleId>.asSlice(&libraryLoaded)
  run Testing.expect(libraryListed.length == 3 && containsModule(libraryListed, &libraryRoot)
    && containsModule(libraryListed, &libraryRuntime) && containsModule(libraryListed, &libraryOption)
    && !containsModule(libraryListed, &libraryMissing),
    "the same source route sweeps present stdlib modules when that directory is the selected root")
  run FileSystem.release(move temp)
  return ()
}

test effect fn loadedRootPackageUsesSourceOwnership() -> ()
! FileError | TomlError | InvalidSourceRoot | InvalidDependency | MissingManifest | InvalidBuildComposition | MissingStandardLibrary | InvalidNativeLinkInput | InvalidModulePath | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut files = run OsFileSystem.make(b"/") |> Effect.provideMut<Allocator>(&mut allocator)
  return run loadedRootPackageClaims() |> Effect.provideMut<FileSystem>(&mut files) |> Effect.provideMut<Allocator>(&mut allocator)
}

// The detail of the dependency refusal reading the package at `source` reports, or `None` when
// it reads.
effect fn dependencyRefusal(source: &Path, library: &Path) -> Option<Bytes>
! FileError | TomlError | InvalidSourceRoot | MissingManifest | InvalidBuildComposition | MissingStandardLibrary | InvalidNativeLinkInput | InvalidModulePath | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  let attempted = run Effect.result(ModuleSourceFiles.make(source, Option<Path>.some(run Path.fromBytes(Path.rawBytes(library))),
    b"x86_64-unknown-linux-gnu", b"gnu", true, ProfileSelection.Default))
  return match move attempted {
    Result<ModuleSources, FileError | TomlError | InvalidSourceRoot | InvalidDependency | MissingManifest | InvalidBuildComposition | MissingStandardLibrary | InvalidNativeLinkInput | InvalidModulePath | OutOfMemoryError>.Success {value} => {
      drop value
      return Option<Bytes>.none()
    }
    Result<ModuleSources, FileError | TomlError | InvalidSourceRoot | InvalidDependency | MissingManifest | InvalidBuildComposition | MissingStandardLibrary | InvalidNativeLinkInput | InvalidModulePath | OutOfMemoryError>.Failure {error} => match move error {
      InvalidDependency refused => {
        let InvalidDependency {detail} = move refused
        return Option<Bytes>.some(move detail)
      }
      FileError failure => { fail move failure }
      TomlError failure => { fail move failure }
      InvalidSourceRoot failure => { fail move failure }
      MissingManifest failure => { fail move failure }
      InvalidBuildComposition failure => { fail move failure }
      MissingStandardLibrary failure => { fail move failure }
      InvalidNativeLinkInput failure => { fail move failure }
      InvalidModulePath failure => { fail move failure }
      OutOfMemoryError failure => { fail move failure }
    }
  }
}

// Whether `refusal` is a dependency refusal whose detail begins with `prefix`.
fn refusedWith(refusal: &Option<Bytes>, prefix: &[u8]) -> bool {
  return match &refusal.* {
    Option<Bytes>.Some {value} => {
      let detail = Bytes.asSlice(&value)
      return detail.length >= prefix.length && sameBytes(Slice.view<u8>(detail, usize.ZERO, prefix.length), prefix)
    }
    Option<Bytes>.None => false
  }
}

effect fn packageDependencyClaims() -> ()
! FileError | TomlError | InvalidSourceRoot | InvalidDependency | MissingManifest | InvalidBuildComposition | MissingStandardLibrary | InvalidNativeLinkInput | InvalidModulePath | OutOfMemoryError | AssertionError<'static>
? &mut FileSystem | &mut Allocator {
  let parent = run fixtureTemporaryParent()
  let temp = run FileSystem.temporaryDirectory(&parent, "silk-package-dependency-")
  let app = run Path.join(&temp.path, "app")
  let json = run Path.join(&temp.path, "json")
  let jsonSource = run Path.join(&json, "src")
  let jsonUtil = run Path.join(&jsonSource, "util")
  let newer = run Path.join(&temp.path, "newer")
  let library = run Path.join(&temp.path, "stdlib")
  let silk = run Path.join(&library, "silk")
  run FileSystem.createDirectory(&app)
  run FileSystem.createDirectory(&json)
  run FileSystem.createDirectory(&jsonSource)
  run FileSystem.createDirectory(&jsonUtil)
  run FileSystem.createDirectory(&newer)
  run FileSystem.createDirectory(&library)
  run FileSystem.createDirectory(&silk)
  let composition = b"[build]\ncomposition = { runtimes = [{ name = \"local\", module = \"local\" }], defaults = [\"local\"], retention = [], requirements = [] }\n"
  let mut manifest = run Bytes.copy(b"[package]\nname = \"app\"\nversion = \"0.1.0\"\nroot = \"main.silk\"\n[dependencies]\njson = { path = \"../json\", package = \"silk-json\" }\n")
  run Bytes.append(&mut manifest, composition)
  run writePackageFile(&app, "silk.toml", Bytes.asSlice(&manifest))
  run writePackageFile(&app, "main.silk", b"import json.Value\nimport local\n")
  run writePackageFile(&app, "local.silk", b"pub fn local() -> i32 { return 0 }\n")
  run writePackageFile(&json, "silk.toml", b"[package]\nname = \"silk-json\"\nversion = \"0.2.0\"\nsource-root = \"src\"\n")
  run writePackageFile(&jsonSource, "Value.silk", b"import util.Digits\nimport silk.option\n")
  run writePackageFile(&jsonUtil, "Digits.silk", b"pub fn two() -> i32 { return 2 }\n")
  run writePackageFile(&silk, "option.silk", b"pub struct OptionMarker {}\n")
  let source = run Path.join(&app, "main.silk")
  let mut sources = run ModuleSourceFiles.make(&source,
    Option<Path>.some(run Path.fromBytes(Path.rawBytes(&library))), b"x86_64-unknown-linux-gnu", b"gnu", true, ProfileSelection.Default)
  let root = ModuleId.copy(ModuleSourceFiles.entry(&sources))
  let value = run ModuleId.make(b"file", b"silk-json@0.2.0", b"Value.silk")
  let digits = run ModuleId.make(b"file", b"silk-json@0.2.0", b"util/Digits.silk")
  let option = run ModuleSourceFiles.module(&sources, b"silk/option.silk")
  run ModuleSourceFiles.preloadProgram(&mut sources, &root)
  let loaded = run ModuleSourceFiles.loadedRootModules(&sources)
  let listed = Vector<ModuleId>.asSlice(&loaded)
  let revision = run ModuleSourceFiles.revision(&sources)
  let location = run ModuleSourceFiles.sourceLocation(&sources, &value)
  let expected = run Path.join(&jsonSource, "Value.silk")
  let located = match &location.path {
    Option<Path>.Some {value: path} => sameBytes(Path.rawBytes(&path), Path.rawBytes(&expected))
    Option<Path>.None => false
  }
  run Testing.expect(Revision.presents(&revision, &value) && Revision.presents(&revision, &digits)
    && Revision.presents(&revision, &option) && located && !containsModule(listed, &value) && !containsModule(listed, &digits),
    "a dependency's modules load from its own source root in its own package, outside the root sweep, and share the standard library")
  let mut reserved = run Bytes.copy(b"[package]\nname = \"app\"\nversion = \"0.1.0\"\nroot = \"main.silk\"\n[dependencies]\nsilk = { path = \"../json\" }\n")
  run Bytes.append(&mut reserved, composition)
  run writePackageFile(&app, "silk.toml", Bytes.asSlice(&reserved))
  let reservedRefusal = run dependencyRefusal(&source, &library)
  let mut mismatched = run Bytes.copy(b"[package]\nname = \"app\"\nversion = \"0.1.0\"\nroot = \"main.silk\"\n[dependencies]\njson = { path = \"../json\", package = \"other\" }\n")
  run Bytes.append(&mut mismatched, composition)
  run writePackageFile(&app, "silk.toml", Bytes.asSlice(&mismatched))
  let mismatchRefusal = run dependencyRefusal(&source, &library)
  let mut shadowed = run Bytes.copy(b"[package]\nname = \"app\"\nversion = \"0.1.0\"\nroot = \"main.silk\"\n[dependencies]\nlocal = { path = \"../json\" }\n")
  run Bytes.append(&mut shadowed, composition)
  run writePackageFile(&app, "silk.toml", Bytes.asSlice(&shadowed))
  let shadowRefusal = run dependencyRefusal(&source, &library)
  let mut absent = run Bytes.copy(b"[package]\nname = \"app\"\nversion = \"0.1.0\"\nroot = \"main.silk\"\n[dependencies]\njson = { path = \"../nowhere\" }\n")
  run Bytes.append(&mut absent, composition)
  run writePackageFile(&app, "silk.toml", Bytes.asSlice(&absent))
  let absentRefusal = run dependencyRefusal(&source, &library)
  run Testing.expect(refusedWith(&reservedRefusal, b"dependency `silk`") && refusedWith(&mismatchRefusal, b"dependency `json`")
    && refusedWith(&shadowRefusal, b"dependency `local`") && refusedWith(&absentRefusal, b"dependency `json`"),
    "a reserved name, a mismatched package name, a name the source root also uses, and a missing manifest are refused")
  let mut versions = run Bytes.copy(b"[package]\nname = \"app\"\nversion = \"0.1.0\"\nroot = \"main.silk\"\n[dependencies]\njson = { path = \"../json\" }\nnewer = { path = \"../newer\" }\n")
  run Bytes.append(&mut versions, composition)
  run writePackageFile(&app, "silk.toml", Bytes.asSlice(&versions))
  run writePackageFile(&newer, "silk.toml", b"[package]\nname = \"silk-json\"\nversion = \"0.3.0\"\nsource-root = \".\"\n")
  let versionRefusal = run dependencyRefusal(&source, &library)
  Bytes.truncate(&mut manifest, usize.ZERO)
  run Bytes.append(&mut manifest, b"[package]\nname = \"app\"\nversion = \"0.1.0\"\nroot = \"main.silk\"\n[dependencies]\njson = { path = \"../json\" }\n")
  run Bytes.append(&mut manifest, composition)
  run writePackageFile(&app, "silk.toml", Bytes.asSlice(&manifest))
  run writePackageFile(&json, "silk.toml", b"[package]\nname = \"silk-json\"\nversion = \"0.2.0\"\nsource-root = \"src\"\n[dependencies]\nback = { path = \"../app\" }\n")
  let cycleRefusal = run dependencyRefusal(&source, &library)
  run Testing.expect(refusedWith(&versionRefusal, b"dependency `newer`") && refusedWith(&cycleRefusal, b"dependency `back`"),
    "two versions of one package and a package cycle are refused")
  run FileSystem.release(move temp)
  return ()
}

test effect fn pathDependenciesLoadTheirOwnPackages() -> ()
! FileError | TomlError | InvalidSourceRoot | InvalidDependency | MissingManifest | InvalidBuildComposition | MissingStandardLibrary | InvalidNativeLinkInput | InvalidModulePath | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut files = run OsFileSystem.make(b"/") |> Effect.provideMut<Allocator>(&mut allocator)
  return run packageDependencyClaims() |> Effect.provideMut<FileSystem>(&mut files) |> Effect.provideMut<Allocator>(&mut allocator)
}

// One composed package's entry identity and built LLVM IR.
struct ComposedPackage {
  entry: ModuleId
  text: Bytes
}

// Writes one composed package into `directory` and builds it.
effect fn composedPackage(directory: &Path) -> ComposedPackage
! FileError | TomlError | InvalidSourceRoot | InvalidDependency | MissingManifest | InvalidBuildComposition | MissingStandardLibrary | InvalidNativeLinkInput | InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError
? &mut FileSystem | &mut Allocator | &mut Types {
  let support = run Path.join(directory, "support")
  run FileSystem.createDirectory(&support)
  run writePackageFile(directory, "silk.toml", b"[package]\nname = \"composed\"\nversion = \"0.1.0\"\nroot = \"main.silk\"\n\n[build]\ncomposition = { runtimes = [{ name = \"start\", module = \"support/start\" }], defaults = [\"start\"], retention = [], requirements = [] }\n")
  run writePackageFile(directory, "main.silk", b"pub fn answer() -> i32 { return 42 }\n")
  run writePackageFile(&support, "start.silk", b"import Intrinsic.application\nexport \"C\" fn enter() -> i32 as \"main\" { return application.answer() }\n")
  let source = run Path.join(directory, "main.silk")
  let mut sources = run ModuleSourceFiles.make(&source, Option<Path>.none(), b"x86_64-unknown-linux-gnu", b"gnu", true, ProfileSelection.Default)
  let application = ModuleId.copy(ModuleSourceFiles.entry(&sources))
  let runtime = run selectedRuntime(&sources)
  run ModuleSourceFiles.preloadProgram(&mut sources, &application)
  let rootPackage = run ModuleSourceFiles.loadedRootModules(&sources)
  let mut store = Semantic.traced(run ModuleSourceFiles.revision(&sources), MachineTarget.forId(TargetId.X8664UnknownLinuxGnu), Option<FinalProfile>.none())
  let mut request = Request.forApplication(ModuleId.copy(&application))
  let built = run Semantic.buildArtifact(&mut store, &mut request, Option<&ModuleId>.some(&runtime), Vector<ModuleId>.asSlice(&rootPackage), staticClosureNodes)
  let text = match move built {
    BackendBuild.Module {text, ..} => move text
    _ => Bytes.make()
  }
  return ComposedPackage {entry: move application, text: move text}
}

// Whether reading the package as an executable for x86-64 Linux fails only because its catalog
// runtime needs a standard library and none is named.
effect fn libraryRefused(source: &Path) -> bool
! FileError | TomlError | InvalidSourceRoot | InvalidDependency | MissingManifest | InvalidBuildComposition | InvalidNativeLinkInput | InvalidModulePath | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  let attempted = run Effect.result(ModuleSourceFiles.make(source, Option<Path>.none(), b"x86_64-unknown-linux-gnu", b"gnu", true, ProfileSelection.Default))
  return match move attempted {
    Result<ModuleSources, FileError | TomlError | InvalidSourceRoot | InvalidDependency | MissingManifest | InvalidBuildComposition | MissingStandardLibrary | InvalidNativeLinkInput | InvalidModulePath | OutOfMemoryError>.Success {value} => {
      drop value
      return false
    }
    Result<ModuleSources, FileError | TomlError | InvalidSourceRoot | InvalidDependency | MissingManifest | InvalidBuildComposition | MissingStandardLibrary | InvalidNativeLinkInput | InvalidModulePath | OutOfMemoryError>.Failure {error} => match move error {
      MissingStandardLibrary refused => {
        drop refused
        return true
      }
      FileError failure => { fail move failure }
      TomlError failure => { fail move failure }
      InvalidSourceRoot failure => { fail move failure }
      MissingManifest failure => { fail move failure }
      InvalidBuildComposition failure => { fail move failure }
      InvalidNativeLinkInput failure => { fail move failure }
      InvalidDependency failure => { fail move failure }
      InvalidModulePath failure => { fail move failure }
      OutOfMemoryError failure => { fail move failure }
    }
  }
}

// Whether reading the entry `source` fails only because no manifest lies in `directory` or any of
// its parents, and the failure names that directory as where the search started.
effect fn manifestMissingFrom(source: &Path, directory: &Path) -> bool
! FileError | TomlError | InvalidSourceRoot | InvalidDependency | InvalidBuildComposition | MissingStandardLibrary | InvalidNativeLinkInput | InvalidModulePath | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  let attempted = run Effect.result(ModuleSourceFiles.make(source, Option<Path>.none(), b"x86_64-unknown-linux-gnu", b"gnu", true, ProfileSelection.Default))
  return match move attempted {
    Result<ModuleSources, FileError | TomlError | InvalidSourceRoot | InvalidDependency | MissingManifest | InvalidBuildComposition | MissingStandardLibrary | InvalidNativeLinkInput | InvalidModulePath | OutOfMemoryError>.Success {value} => {
      drop value
      return false
    }
    Result<ModuleSources, FileError | TomlError | InvalidSourceRoot | InvalidDependency | MissingManifest | InvalidBuildComposition | MissingStandardLibrary | InvalidNativeLinkInput | InvalidModulePath | OutOfMemoryError>.Failure {error} => match move error {
      MissingManifest missing => {
        let named = sameBytes(Path.rawBytes(&missing.directory), Path.rawBytes(directory))
        drop missing
        return named
      }
      FileError failure => { fail move failure }
      TomlError failure => { fail move failure }
      InvalidSourceRoot failure => { fail move failure }
      InvalidBuildComposition failure => { fail move failure }
      MissingStandardLibrary failure => { fail move failure }
      InvalidNativeLinkInput failure => { fail move failure }
      InvalidDependency failure => { fail move failure }
      InvalidModulePath failure => { fail move failure }
      OutOfMemoryError failure => { fail move failure }
    }
  }
}

// Whether reading the package at `source` fails only because its manifest names no version.
effect fn versionlessRefused(source: &Path) -> bool
! FileError | TomlError | InvalidDependency | MissingManifest | InvalidBuildComposition | MissingStandardLibrary | InvalidNativeLinkInput | InvalidModulePath | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  let attempted = run Effect.result(ModuleSourceFiles.make(source, Option<Path>.none(), b"x86_64-unknown-linux-gnu", b"gnu", true, ProfileSelection.Default))
  return match move attempted {
    Result<ModuleSources, FileError | TomlError | InvalidSourceRoot | InvalidDependency | MissingManifest | InvalidBuildComposition | MissingStandardLibrary | InvalidNativeLinkInput | InvalidModulePath | OutOfMemoryError>.Success {value} => {
      drop value
      return false
    }
    Result<ModuleSources, FileError | TomlError | InvalidSourceRoot | InvalidDependency | MissingManifest | InvalidBuildComposition | MissingStandardLibrary | InvalidNativeLinkInput | InvalidModulePath | OutOfMemoryError>.Failure {error} => match move error {
      InvalidSourceRoot refused => {
        drop refused
        return true
      }
      FileError failure => { fail move failure }
      TomlError failure => { fail move failure }
      MissingManifest failure => { fail move failure }
      InvalidBuildComposition failure => { fail move failure }
      MissingStandardLibrary failure => { fail move failure }
      InvalidNativeLinkInput failure => { fail move failure }
      InvalidDependency failure => { fail move failure }
      InvalidModulePath failure => { fail move failure }
      OutOfMemoryError failure => { fail move failure }
    }
  }
}

effect fn packageIdentityClaims() -> ()
! FileError | TomlError | InvalidSourceRoot | InvalidDependency | MissingManifest | InvalidBuildComposition | MissingStandardLibrary | InvalidNativeLinkInput | InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
? &mut FileSystem | &mut Allocator | &mut Types {
  let parent = run fixtureTemporaryParent()
  let first = run FileSystem.temporaryDirectory(&parent, "silk-package-identity-")
  let second = run FileSystem.temporaryDirectory(&parent, "silk-package-identity-")
  let nested = run Path.join(&second.path, "checkout")
  run FileSystem.createDirectory(&nested)
  let here = run composedPackage(&first.path)
  let there = run composedPackage(&nested)
  let package = run ModuleId.copyPackage(&here.entry)
  let hereText = Bytes.asSlice(&here.text)
  run Testing.expect(ModuleId.equals(&here.entry, &there.entry) && sameBytes(Bytes.asSlice(&package), b"composed@0.1.0") &&
    hereText.length > usize.ZERO && sameBytes(hereText, Bytes.asSlice(&there.text)),
    "one package built from two directories has one logical identity and byte-identical LLVM IR")
  run writePackageFile(&nested, "silk.toml", b"[package]\nname = \"composed\"\nversion = \"1.2.0\"\nroot = \"main.silk\"\n\n[build]\ncomposition = { runtimes = [{ name = \"start\", module = \"support/start\" }], defaults = [\"start\"], retention = [], requirements = [] }\n")
  let source = run Path.join(&nested, "main.silk")
  let versioned = run ModuleSourceFiles.make(&source, Option<Path>.none(), b"x86_64-unknown-linux-gnu", b"gnu", true, ProfileSelection.Default)
  let versionedPackage = run ModuleId.copyPackage(ModuleSourceFiles.entry(&versioned))
  let manifestless = run Path.join(&second.path, "main.silk")
  run writePackageFile(&second.path, "main.silk", b"pub fn answer() -> i32 { return 42 }\n")
  let refused = run manifestMissingFrom(&manifestless, &second.path)
  run writePackageFile(&nested, "silk.toml", b"[package]\nname = \"composed\"\nroot = \"main.silk\"\n\n[build]\ncomposition = { runtimes = [{ name = \"start\", module = \"support/start\" }], defaults = [\"start\"] }\n")
  let versionless = run versionlessRefused(&source)
  run Testing.expect(sameBytes(Bytes.asSlice(&versionedPackage), b"composed@1.2.0") && versionless && refused,
    "the required version joins the package name, a manifest without one is refused, and an entry without a manifest is refused from its own directory")
  run FileSystem.release(move second)
  run FileSystem.release(move first)
  return ()
}

// The glue MIR for the type the first `drop` of function `name` cleans.
effect fn droppedGlue(store: &mut Semantic, request: &mut Request, id: &ModuleId, name: &[u8]) -> Shared<Result<Answer, NoRejection>>
! AssertionError<'static> | InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let dropping = run Semantic.demandMir(&mut store.*, &mut request.*, id, name)
  let ty = match move droppedType(&store.*, &dropping) {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => { return move dropping }
  }
  let sourceOwner = run glueSourceOwner(&mut store.*, &dropping)
  return run Semantic.demandGlueMir(&mut store.*, &mut request.*, &ty, &sourceOwner)
}

fn droppedType(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>) -> Option<Shared<Type>> {
  let selected = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      let blocks = Vector<MirBlock>.asSlice(&function.blocks)
      let locals = Vector<MirLocal>.asSlice(&function.locals)
      let mut at = usize.ZERO
      while at < blocks.length {
        let statements = Vector<MirStatement>.asSlice(&blocks[at].statements)
        let mut position = usize.ZERO
        while position < statements.length {
          if let MirStatement.Drop {destination, ..} = &statements[position] {
            if Vector<MirProjection>.length(&destination.projections) == usize.ZERO { return Option<Shared<Type>>.some(Shared<Type>.clone(&locals[destination.local].ty)) }
          }
          position = position + usize.ONE
        }
        at = at + usize.ONE
      }
    }
  }
  return Option<Shared<Type>>.none()
}

// Whether the first consuming site of `kind` (0 move, 1 drop, 2 consuming match) records root local
// `root` (MAX: no place) and the steps `first` and `second` (a field ordinal, 1000 + an element
// index, or MAX when absent).
fn consumesAt(answer: &Shared<Result<Answer, NoRejection>>, kind: usize, root: usize, first: usize, second: usize) -> bool {
  let selected = Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(answer, checkedBody)
  if let Option<Shared<TypedBody>>.Some {value: body} = move selected {
    return Shared<TypedBody>.with<bool>(&body, fn(typed: &TypedBody) -> bool {
      return consumedSiteMatches(typed, kind, root, first, second)
    })
  }
  return false
}

fn consumedSiteMatches(body: &TypedBody, kind: usize, root: usize, first: usize, second: usize) -> bool {
  let nodes = TypedBody.nodeSlice(body)
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {form: BodyExpression.Move {consumed, ..}, ..} = &nodes[at].kind {
      if kind == usize.ZERO { return consumedMatches(&consumed, root, first, second) }
    }
    if let BodyNodeKind.Drop {consumed, ..} = &nodes[at].kind {
      if kind == usize.ONE { return consumedMatches(&consumed, root, first, second) }
    }
    if let BodyNodeKind.Expression {form: BodyExpression.Match {access: BodySubjectAccess.Consume {consumed}, ..}, ..} = &nodes[at].kind {
      if kind == 2 { return consumedMatches(&consumed, root, first, second) }
    }
    at = at + usize.ONE
  }
  return false
}

fn consumedMatches(consumed: &Option<BodyConsumedPlace>, root: usize, first: usize, second: usize) -> bool {
  return match &consumed.* {
    Option<BodyConsumedPlace>.Some {value} => placeMatches(&value, root, first, second)
    Option<BodyConsumedPlace>.None => root == usize.MAX
  }
}

fn placeMatches(place: &BodyConsumedPlace, root: usize, first: usize, second: usize) -> bool {
  let local = match &place.root {
    BodyPlaceRoot.Local {local} => local.index
    BodyPlaceRoot.Subject {..} => usize.MAX - usize.ONE
  }
  if local != root { return false }
  let steps = Vector<BodyPlaceStep>.asSlice(&place.steps)
  let expected = [first, second]
  let mut at = usize.ZERO
  while at < 2 {
    let mut code = usize.MAX
    if at < steps.length {
      code = match &steps[at] {
        BodyPlaceStep.Field {index} => index
        BodyPlaceStep.Element {index} => 1000 + index
        _ => usize.MAX - usize.ONE
      }
    }
    if code != expected[at] { return false }
    at = at + usize.ONE
  }
  return steps.length <= 2
}

// Reference values of SipHash-1-3-128 with a zero key, from an implementation that reproduces the
// published SipHash-2-4-128 vectors: the empty input, a partial word, words plus a partial word,
// exact words, and one word plus a byte.
fn hashes(bytes: &[u8], high: u64, low: u64) -> bool {
  return ContentHash.equals(ContentHash.of(bytes), ContentHash {high: high, low: low})
}

// The bytes 0, 1, ... up to `count`.
effect fn ordinals(count: u8) -> Vector<u8> ! OutOfMemoryError ? &mut Allocator {
  let mut bytes = Vector<u8>.make()
  let mut at: u8 = 0
  while at < count {
    run Vector.append(&mut bytes, at)
    at = at + 1
  }
  return move bytes
}

effect fn contentHashClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let long = run ordinals(31)
  let block = run ordinals(16)
  let short = run ordinals(9)
  run Testing.expect(hashes(b"", 13338640444649321219, 2392699331323474957) && hashes(b"hello", 12712089204820622507, 1476871855972406397)
    && hashes(b"The quick brown fox jumps over the lazy dog", 10789751878142006043, 9024588510407613351),
    "content hashes of text agree with SipHash-1-3-128")
  run Testing.expect(hashes(Vector.asSlice(&long), 407396894503321071, 11541266571300785951)
    && hashes(Vector.asSlice(&block), 14288859609232744459, 12120854413928149182)
    && hashes(Vector.asSlice(&short), 16324788615320407035, 6760368122428048305),
    "content hashes split words and the final partial word as SipHash-1-3-128 does")
}

test effect fn contentHashMatchesSipHash13() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run contentHashClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

// MODULE-004: OWN0016 is a static obligation even when the holder is never executable.
effect fn unreferencedLocalSharedEscapeClaims() -> ()
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator | &mut Types {
  let id = run module("unused-local-shared.silk")
  let text = """
struct Cell { value: i32 }
fn escapes(cell: &mut Cell) -> i32 {
  run Intrinsic.relinquish()
  return cell.value
}
fn busy() -> i32 { return 0 }
fn unused(core: &Intrinsic.SharedCore<Cell>) -> i32 {
  return Intrinsic.sharedWithMut<Cell, i32>(core, escapes, busy)
}
pub fn main() -> i32 { return 42 }
"""
  let source = run present(text)
  let revision = run Revision.publish(&Revision.make(), &id, &source)
  let mut store = Semantic.traced(
    run withEntryRuntime(&revision),
    MachineTarget.forId(TargetId.X8664UnknownLinuxGnu),
    Option<FinalProfile>.none()
  )
  let mut request = Request.forApplication(ModuleId.copy(&id))
  let built = run buildApplication(&mut store, &mut request, staticClosureNodes)
  run Testing.expect(
    reportCount(&built) == usize.ONE
      && escapeReportedAt(
      &built,
      &id,
      spanOf(text, "run Intrinsic.relinquish()", usize.ZERO),
      &id,
      spanOf(text, "Intrinsic.sharedWithMut<Cell, i32>(core, escapes, busy)", usize.ZERO)
    ),
    "an unreferenced concrete access holder rejects its callback's run at the original escape and access spans"
  )
  return ()
}

test effect fn loadedDeclarationSweepRejectsUnreferencedLocalSharedEscape() -> ()
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut types = TypeTable.make()
  return run unreferencedLocalSharedEscapeClaims() |> Effect.provideMut<Types>(&mut types)
    |> Effect.provideMut<Allocator>(&mut allocator)
}

// A sealed storage identity is a compiler input, never an authored source module.
effect fn sealedCoreSweepClaims() -> ()
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator | &mut Types {
  let id = run module("unused-sealed-glue.silk")
  let source = run present(
    "struct Cell { value: i32 }\nfn unused(value: Intrinsic.SharedCore<Cell>) -> () { drop value return () }\npub fn main() -> i32 { return 42 }\n"
  )
  let revision = run Revision.publish(&Revision.make(), &id, &source)
  let mut store = Semantic.traced(
    run withEntryRuntime(&revision),
    MachineTarget.forId(TargetId.X8664UnknownLinuxGnu),
    Option<FinalProfile>.none()
  )
  let mut request = Request.forApplication(ModuleId.copy(&id))
  let built = run buildApplication(&mut store, &mut request, staticClosureNodes)
  let accepted = match &built {
    BackendBuild.Module { .. } => true
    _ => false
  }
  let events = Semantic.sourceEvents(&store)
  let mut sourceRead = false
  let mut at = usize.ZERO
  while at < events.length {
    if ModuleId.matches(&events[at].module, b"compiler-sealed-core", b"silk", b"silk/core") {
      sourceRead = true
    }
    at = at + usize.ONE
  }
  run Testing.expect(
    accepted && !sourceRead,
    "checking an unreferenced sealed-core cleanup succeeds without asking the source provider for compiler-owned glue"
  )
  return ()
}

test effect fn loadedDeclarationSweepKeepsSealedGlueOutOfSourceGraph() -> ()
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut types = TypeTable.make()
  return run sealedCoreSweepClaims() |> Effect.provideMut<Types>(&mut types)
    |> Effect.provideMut<Allocator>(&mut allocator)
}
