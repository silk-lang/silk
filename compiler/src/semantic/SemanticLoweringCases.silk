}

test effect fn genericSealedUnknownDropProofIsNotAbsence() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("generic-sealed-unknown-drop.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
struct Pending<T> { value: T }
impl<T: Intrinsic.Detached> Intrinsic.Drop for Pending<T> { fn drop(self: &mut Pending<T>) -> () { return () } }
fn inspect(value: Pending<i32>) -> i32 { return 0 }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let body = run Semantic.demandBody(&mut store, &mut request, &id, b"inspect") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let ty = match move bodyLocalType(&body, usize.ZERO) {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => { run Testing.expect(false, "the complete instance is typed before its property proof is needed") return () }
  }
  let sourceOwner = run glueSourceOwner(&mut store, &body) |> Effect.provideMut<Allocator>(&mut allocator)
  let glue = run Semantic.demandGlueMir(&mut store, &mut request, &ty, &sourceOwner) |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let failure = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(&glue, rejection)
  let explicit = match move failure {
    Option<Shared<Rejection>>.Some {value} => Shared<Rejection>.with<bool>(&value, fn(problem: &Rejection) -> bool {
      return problem.code == RejectionCode.Unsupported && problem.span.start == usize.ZERO && problem.span.end == usize.ZERO
    })
    Option<Shared<Rejection>>.None => false
  }
  run Testing.expect(explicit, "an unavailable concrete property proof rejects the site-free glue identity instead of silently omitting Drop")
  return ()
}

fn recordOperandsKeepWrittenOrder(body: &TypedBody) -> bool {
  let nodes = TypedBody.nodeSlice(body)
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {form: BodyExpression.Aggregate {fields, ..}, ..} = &nodes[at].kind {
      let operands = Vector<BodyAggregateField>.asSlice(&fields)
      if operands.length == 2 {
        return operands[usize.ZERO].index == usize.ONE && operands[usize.ONE].index == usize.ZERO
      }
    }
    at = at + usize.ONE
  }
  return false
}

test effect fn recordConstructionAndAssignmentRetainCanonicalFields() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("record-fields.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let mut store = run applicationSemantic(&id, """
struct Pair {
  left: i32
  right: i32
}
fn create() -> Pair { return Pair { left: 40, right: 2 } }
fn sum(pair: Pair) -> i32 { return pair.left + pair.right }
pub fn main() -> i32 {
  let mut pair = Pair { right: 22, left: 20 }
  pair.left = 21
  return sum(create()) + pair.left + pair.right
}
""", MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.forApplication(ModuleId.copy(&id))
  let bodyAnswer = run Semantic.demandBody(&mut store, &mut request, &id, b"main")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let selectedBody = Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(&bodyAnswer, checkedBody)
  let mut writtenOrder = false
  if let Option<Shared<TypedBody>>.Some {value} = move selectedBody {
    writtenOrder = Shared<TypedBody>.with<bool>(&value, recordOperandsKeepWrittenOrder)
  }
  let mirAnswer = run Semantic.demandMir(&mut store, &mut request, &id, b"main")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let selectedMir = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(&mirAnswer, selectedMirIndex)
  let mut aggregate = false
  let mut replacement = false
  if let Option<usize>.Some {value: index} = move selectedMir {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(&store, index) {
      let blocks = Vector<MirBlock>.asSlice(&function.blocks)
      let mut blockAt = usize.ZERO
      while blockAt < blocks.length {
        let statements = Vector<MirStatement>.asSlice(&blocks[blockAt].statements)
        let mut at = usize.ZERO
        while at < statements.length {
          if let MirStatement.Assign {destination, value, ..} = &statements[at] {
            if let MirRvalue.Aggregate {fields} = &value {
              let operands = Vector<MirAggregateField>.asSlice(&fields)
              if operands.length == 2 {
                aggregate = operands[usize.ZERO].index == usize.ONE && operands[usize.ONE].index == usize.ZERO
              }
            }
            let projections = Vector<MirProjection>.asSlice(&destination.projections)
            if projections.length == usize.ONE {
              if let MirProjection.Field {index: ordinal} = &projections[usize.ZERO] {
                replacement = ordinal == usize.ZERO
              }
            }
          }
          at = at + usize.ONE
        }
        blockAt = blockAt + usize.ONE
      }
    }
  }
  run Testing.expect(writtenOrder, "typed record operands retain written order and canonical fields")
  run Testing.expect(aggregate, "written record operand order survives canonical field selection into MIR")
  run Testing.expect(replacement, "assignment retains a canonical projected destination")
  let built = run buildApplication(&mut store, &mut request, staticClosureNodes)
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut storage = false
  match move built {
    BackendBuild.Module {text, ..} => {
      let ir = Bytes.asSlice(&text)
      storage = containsIr(ir, b"(ptr %out") && containsIrLine(ir, b"call void @llvm.memmove.p0.p0.i64(", b" %l1, ptr %p0, i64 8, i1 false)")
        && containsIrLine(ir, b"getelementptr i8", b", i64 4")
    }
    _ => ()
  }
  run Testing.expect(storage, "record storage uses layout offsets and indirect parameter and result copies")
  return ()
}

fn anonymousShape(ty: &Shared<Type>, positional: bool, count: usize) -> bool {
  return Shared<Type>.with<bool>(ty, fn(value: &Type) -> bool {
    if let Type.Anonymous {occurrence, members} = &value.* {
      return Vector<Shared<Type>>.length(&members) == count && AnonymousOccurrence.isPositional(&occurrence) == positional
    }
    return false
  })
}

fn nominalOfKind(ty: &Shared<Type>, kind: OwnerKind) -> bool {
  return Shared<Type>.with<bool>(ty, fn(value: &Type) -> bool {
    if let Type.Nominal {declaration, ..} = &value.* { return DeclarationId.kind(&declaration) == kind }
    return false
  })
}

fn localIsAnonymous(answer: &Shared<Result<Answer, NoRejection>>, at: usize, positional: bool, count: usize) -> bool {
  if let Option<Shared<Type>>.Some {value} = move bodyLocalType(answer, at) { return anonymousShape(&value, positional, count) }
  return false
}

fn checkedNodeMatches(answer: &Shared<Result<Answer, NoRejection>>, index: usize, kind: OwnerKind) -> bool {
  let body = Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(answer, checkedBody)
  if let Option<Shared<TypedBody>>.Some {value} = move body {
    return Shared<TypedBody>.with<bool>(&value, fn(checked: &TypedBody) -> bool {
      let nodes = TypedBody.nodeSlice(checked)
      let mut at = usize.ZERO
      while at < nodes.length {
        if let BodyNodeKind.Expression {ty, form} = &nodes[at].kind {
          if let BodyExpression.Field {index: selected, ..} = &form { if selected == index { return true } }
          if let BodyExpression.Aggregate {..} = &form { if nominalOfKind(&ty, kind) { return true } }
        }
        at = at + usize.ONE
      }
      return false
    })
  }
  return false
}

// Whether a checked body projects member `index`.
fn bodyProjects(answer: &Shared<Result<Answer, NoRejection>>, index: usize) -> bool {
  return checkedNodeMatches(answer, index, OwnerKind.Damaged)
}

// Whether a checked body constructs an aggregate of a named declaration kind.
fn bodyConstructs(answer: &Shared<Result<Answer, NoRejection>>, kind: OwnerKind) -> bool {
  return checkedNodeMatches(answer, usize.MAX, kind)
}

fn writtenRecordOrder(answer: &Shared<Result<Answer, NoRejection>>) -> bool {
  let body = Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(answer, checkedBody)
  if let Option<Shared<TypedBody>>.Some {value} = move body {
    return Shared<TypedBody>.with<bool>(&value, recordOperandsKeepWrittenOrder)
  }
  return false
}

// Anonymous and contextual aggregate literals: TUPLE-002, RECORD-001 and RECORD-002.
test effect fn aggregateLiteralsConstructContextualOrAnonymousTypes() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run aggregateLiteralClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn aggregateLiteralClaims() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
? &mut Allocator | &mut Types {
  let id = run module("aggregate-literals.silk")
  let text = """
tuple Point(i32, i32)
struct Pair { left: i32 right: i32 }
enum Choice { First, Second }
fn identity<T>(value: T) -> T { return move value }
fn sumPair(value: Pair) -> i32 { return value.left + value.right }
fn tuples() -> i32 {
  let coordinates = (20, 22)
  let point: Point = (3, 4)
  return coordinates.1 + point.0
}
fn records() -> i32 {
  let record = .{ left: 20, right: 22 }
  let again = .{ left: 20, right: 22 }
  return record.right + sumPair(.{ left: 1, right: 2 })
}
fn select(choice: Choice) -> Pair {
  let selected: Pair = match choice {
    Choice.First => .{ right: 22, left: 20 }
    Choice.Second => .{ left: 21, right: 21 }
  }
  return move selected
}
fn generic() -> i32 {
  let record = identity(.{ left: 20, right: 22 })
  return record.left
}
fn unknownLabel() -> Pair { return .{ left: 1, wrong: 2 } }
fn repeatedLabel() -> i32 {
  let twice = .{ dup: 1, dup: 2 }
  return 0
}
fn separate() -> i32 {
  let mut first = .{ only: 1 }
  first = .{ only: 2 }
  return 0
}
fn tupleForRecord() -> Pair { return (5, 6) }
fn recordForTuple() -> Point { return .{ x: 1 } }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let tuples = run Semantic.demandBody(&mut store, &mut request, &id, b"tuples")
  let records = run Semantic.demandBody(&mut store, &mut request, &id, b"records")
  let select = run Semantic.demandBody(&mut store, &mut request, &id, b"select")
  let generic = run Semantic.demandBody(&mut store, &mut request, &id, b"generic")
  let namedPoint = match move bodyLocalType(&tuples, usize.ONE) {
    Option<Shared<Type>>.Some {value} => nominalOfKind(&value, OwnerKind.Tuple)
    Option<Shared<Type>>.None => false
  }
  run Testing.expect(localIsAnonymous(&tuples, usize.ZERO, true, 2) && namedPoint &&
    bodyProjects(&tuples, usize.ONE) && bodyConstructs(&tuples, OwnerKind.Tuple),
    "an uncontextualized tuple literal is anonymous and positional; a named tuple expectation constructs that tuple")
  let first = bodyLocalType(&records, usize.ZERO)
  let second = bodyLocalType(&records, usize.ONE)
  let mut distinct = false
  if let Option<Shared<Type>>.Some {value: left} = move first {
    if let Option<Shared<Type>>.Some {value: right} = move second { distinct = !run Type.equalsShared(&left, &right) }
  }
  run Testing.expect(localIsAnonymous(&records, usize.ZERO, false, 2) && distinct &&
    bodyProjects(&records, usize.ONE) && bodyConstructs(&records, OwnerKind.Struct),
    "each record literal occurrence is its own anonymous type, and a parameter expectation constructs the named struct")
  run Testing.expect(writtenRecordOrder(&select) && bodyConstructs(&select, OwnerKind.Struct),
    "match arms receive the named struct expectation and keep written operand order over canonical fields")
  run Testing.expect(localIsAnonymous(&generic, usize.ZERO, false, 2),
    "an open parameter expectation leaves the record anonymous, and inference binds the parameter to it")
  let unknownLabel = run Semantic.demandBody(&mut store, &mut request, &id, b"unknownLabel")
  let repeatedLabel = run Semantic.demandBody(&mut store, &mut request, &id, b"repeatedLabel")
  let separate = run Semantic.demandBody(&mut store, &mut request, &id, b"separate")
  let tupleForRecord = run Semantic.demandBody(&mut store, &mut request, &id, b"tupleForRecord")
  let recordForTuple = run Semantic.demandBody(&mut store, &mut request, &id, b"recordForTuple")
  run Testing.expect(rejectsSpan(&unknownLabel, RejectionCode.UnknownStructField, text, "wrong", usize.ZERO) &&
    rejectsSpan(&repeatedLabel, RejectionCode.DuplicateFieldName, text, "dup", usize.ONE),
    "a contextual record keeps struct field authority and an anonymous record rejects a repeated label")
  run Testing.expect(rejectsSpan(&separate, RejectionCode.AssignmentTypeMismatch, text, ".{ only: 2 }", usize.ZERO) &&
    rejectsSpan(&tupleForRecord, RejectionCode.ContextualAggregateKindMismatch, text, "(5, 6)", usize.ZERO) &&
    rejectsSpan(&recordForTuple, RejectionCode.ContextualAggregateKindMismatch, text, ".{ x: 1 }", usize.ZERO),
    "separate anonymous occurrences and a literal of the other aggregate kind never acquire the expected type")
  let coordinates = match move bodyLocalType(&tuples, usize.ZERO) {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => {
      run Testing.expect(false, "the anonymous tuple local retains its type")
      return ()
    }
  }
  let layout = run Semantic.demandLayout(&mut store, &mut request, &id, &coordinates)
  let mut laidOut = false
  let layoutIndex = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(&layout, selectedLayoutIndex)
  if let Option<usize>.Some {value: index} = move layoutIndex {
    if let Option<Shared<BackendLayout>>.Some {value: facts} = move Semantic.layoutAt(&store, index) {
      laidOut = Shared<BackendLayout>.with<bool>(&facts, fn(computed: &BackendLayout) -> bool {
        if let LayoutStorage.Record {fields} = &computed.storage {
          let entries = Vector<LayoutField>.asSlice(&fields)
          return computed.size == 8 && entries.length == 2 && entries[usize.ONE].offset == 4
        }
        return false
      })
    }
  }
  let mir = run Semantic.demandMir(&mut store, &mut request, &id, b"tuples")
  let mut constructed = false
  let mirIndex = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(&mir, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move mirIndex {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(&store, index) {
      let blocks = Vector<MirBlock>.asSlice(&function.blocks)
      let mut blockAt = usize.ZERO
      while blockAt < blocks.length {
        let statements = Vector<MirStatement>.asSlice(&blocks[blockAt].statements)
        let mut at = usize.ZERO
        while at < statements.length {
          if let MirStatement.Assign {value: MirRvalue.Aggregate {fields}, ..} = &statements[at] {
            if Vector<MirAggregateField>.length(&fields) == 2 { constructed = true }
          }
          at = at + usize.ONE
        }
        blockAt = blockAt + usize.ONE
      }
    }
  }
  run Testing.expect(laidOut && constructed,
    "an anonymous tuple lays out as an ordinary record of its members and lowers to aggregate construction")
  return ()
}

// Runtime boolean typing uses the same concrete rule as compile-time boolean typing.
test effect fn runtimeBooleanOperatorsLowerShortCircuit() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("runtime-booleans.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
fn choose(value: bool) -> bool { return value && true || false }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let mir = run Semantic.demandMir(&mut store, &mut request, &id, b"choose")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let selected = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(&mir, selectedMirIndex)
  let mut branches = false
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(&store, index) {
      let blocks = Vector<MirBlock>.asSlice(&function.blocks)
      let mut at = usize.ZERO
      while at < blocks.length {
        if let MirTerminator.Branch {..} = &blocks[at].terminator { branches = true }
        at = at + usize.ONE
      }
    }
  }
  run Testing.expect(branches, "runtime boolean operators retain conditional evaluation in MIR")
  return ()
}

// Deferred representations keep unknown members and incompatible injection operands diagnostic.
test effect fn deferredRecordFormsRetainInvalidOperandDiagnostics() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("record-coverage.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
struct Left { value: i32 }
struct Right { value: i32 }
struct Holder { value: Left | Right }
union Choice { Value { value: i32 }, Empty }
struct Counter { value: i32 }
impl Counter { fn read(value: &Self) -> i32 { return value.value } }
enum Status { Ready }
fn consume(value: Left | Right) -> i32 { return 42 }
fn unionValue() -> i32 { return consume(Left { value: 42 }) }
fn invalidUnion() -> i32 { return consume(true) }
fn fieldUnion() -> i32 { let holder = Holder { value: Left { value: 42 } } return 42 }
fn invalidFieldUnion() -> i32 { let holder = Holder { value: true } return 42 }
fn invalidRecordUnion() -> i32 { let holder = Holder { value: Left { value: true } } return 42 }
fn produce(value: i32) -> Choice { return Choice.Value { value: value } }
fn unionResult() -> i32 { let selected = produce(42) return 42 }
fn invalidUnionResult() -> bool { return produce(42) }
fn invalidEnum() -> i32 { let status = Status.Absent return 42 }
fn bound(value: &Counter) -> i32 { let read = value.read return 42 }
fn invalidMember(value: &Counter) -> i32 { let read = value.absent return 42 }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let unionValue = run Semantic.demandBody(&mut store, &mut request, &id, b"unionValue")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let invalidUnion = run Semantic.demandBody(&mut store, &mut request, &id, b"invalidUnion")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let fieldUnion = run Semantic.demandBody(&mut store, &mut request, &id, b"fieldUnion")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let invalidFieldUnion = run Semantic.demandBody(&mut store, &mut request, &id, b"invalidFieldUnion")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let invalidRecordUnion = run Semantic.demandBody(&mut store, &mut request, &id, b"invalidRecordUnion")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let unionResult = run Semantic.demandBody(&mut store, &mut request, &id, b"unionResult")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let invalidUnionResult = run Semantic.demandBody(&mut store, &mut request, &id, b"invalidUnionResult")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let invalidEnum = run Semantic.demandBody(&mut store, &mut request, &id, b"invalidEnum")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let bound = run Semantic.demandBody(&mut store, &mut request, &id, b"bound")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let invalidMember = run Semantic.demandBody(&mut store, &mut request, &id, b"invalidMember")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let injectedArgument = Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(&unionValue, checkedBody)
  let injectedField = Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(&fieldUnion, checkedBody)
  let argumentChecked = match &injectedArgument {
    Option<Shared<TypedBody>>.Some {..} => true
    Option<Shared<TypedBody>>.None => false
  }
  let fieldChecked = match &injectedField {
    Option<Shared<TypedBody>>.Some {..} => true
    Option<Shared<TypedBody>>.None => false
  }
  run Testing.expect(
    argumentChecked && rejectsSpan(&invalidUnion, RejectionCode.IncompatibleUnionConversion, text, "true", 0),
    "a closed record injects into its structural union and a non-member is a mismatch",
  )
  run Testing.expect(
    fieldChecked &&
    rejectsSpan(&invalidFieldUnion, RejectionCode.IncompatibleUnionConversion, text, "true", 1) &&
    rejectsSpan(&invalidRecordUnion, RejectionCode.StructFieldTypeMismatch, text, "true", 2),
    "a record field injects its union member only after checking the nested initializer",
  )
  let nominalResult = Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(&unionResult, checkedBody)
  let resultChecked = match &nominalResult {
    Option<Shared<TypedBody>>.Some {..} => true
    Option<Shared<TypedBody>>.None => false
  }
  run Testing.expect(
    resultChecked && rejectsSpan(&invalidUnionResult, RejectionCode.ReturnTypeMismatch, text, "produce(42)", 1),
    "a non-generic nominal union result is a runtime value and a mismatched use is rejected",
  )
  run Testing.expect(
    rejectsSpan(&invalidEnum, RejectionCode.UnknownEnumMember, text, "Status.Absent", 0),
    "an absent enum member remains an unknown member",
  )
  run Testing.expect(
    succeeded(&bound) &&
    rejectsSpan(&invalidMember, RejectionCode.UnknownProjectedField, text, "absent", 0),
    "published bound methods form callable values while invalid members remain diagnostic",
  )
  return ()
}

// CALL-003: bound methods store parameter zero and invoke the original member directly.
test effect fn boundMethodsCaptureReceiverAtItsOriginalParameter() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("bound-method-values.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
struct Counter { value: i32 }
impl Counter {
  fn read(self: &Self) -> i32 { return self.value }
  fn bump(self: &mut Self) -> i32 { self.value = self.value + 1 return self.value }
  fn take(self: Self) -> i32 { return self.value }
  fn add(self: &Self, other: &Self) -> i32 { return self.value + other.value }
}
fn shared() -> i32 { let value = Counter { value: 10 } let read = value.read return read() + read() }
fn mutable() -> i32 { let mut value = Counter { value: 0 } let mut bump = value.bump return bump() + bump() }
fn owned() -> i32 { let value = Counter { value: 20 } let take = value.take return take() }
fn applied(value: &Counter, other: &Counter) -> i32 { let add = value.add return add(other) }
fn temporary() -> i32 { let read = Counter { value: 1 }.read return read() }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let shared = run Semantic.demandMir(&mut store, &mut request, &id, b"shared") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let mutable = run Semantic.demandMir(&mut store, &mut request, &id, b"mutable") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let owned = run Semantic.demandMir(&mut store, &mut request, &id, b"owned") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let applied = run Semantic.demandMir(&mut store, &mut request, &id, b"applied") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let temporary = run Semantic.demandBody(&mut store, &mut request, &id, b"temporary") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(boundMethodMir(&store, &shared, b"read", CallableMode.Shared, usize.ONE, 2),
    "a shared receiver-only bound value remains reusable and directly calls the original member")
  run Testing.expect(boundMethodMir(&store, &mutable, b"bump", CallableMode.Mutable, usize.ONE, 2),
    "an exclusive receiver produces a reusable mutable callable")
  run Testing.expect(boundMethodMir(&store, &owned, b"take", CallableMode.Once, usize.ONE, usize.ONE),
    "a by-value receiver moves from the capture into its original member parameter")
  run Testing.expect(boundMethodMir(&store, &applied, b"add", CallableMode.Shared, 2, usize.ONE),
    "the captured receiver is parameter zero before the remaining written operand")
  run Testing.expect(rejectsSpan(&temporary, RejectionCode.TemporaryBoundReceiver, text, "Counter { value: 1 }", usize.ZERO),
    "a bound value cannot retain a borrowed temporary receiver")
  return ()
}

fn boundMethodSignature(contract: &Shared<Type>, mode: CallableMode, parameters: usize) -> bool {
  return Shared<Type>.with<bool>(contract, fn(callable: &Type) -> bool {
    return match &callable.* {
      Type.Callable {mode: found, parameters: open, ..} => found == mode && Vector<Shared<Type>>.length(&open) + usize.ONE == parameters
      _ => false
    }
  })
}

fn boundMethodFields(captures: &Vector<Shared<Type>>, inputs: &Vector<CallableFieldInput>) -> bool {
  if Vector<Shared<Type>>.length(captures) != usize.ONE || Vector<CallableFieldInput>.length(inputs) != usize.ONE {
    return false
  }
  return match Vector<CallableFieldInput>.asSlice(inputs)[usize.ZERO] {
    CallableFieldInput.Argument {parameter} => parameter == usize.ZERO
    _ => false
  }
}

fn boundMethodSchemaSignature(schema: &Shared<SectionSchema>, mode: CallableMode, parameters: usize) -> bool {
  return Shared<SectionSchema>.with<bool>(schema, fn(value: &SectionSchema) -> bool {
    return Vector<usize>.length(&value.deferred) > usize.ZERO && boundMethodSignature(&value.contract, mode, parameters)
  })
}

fn boundMethodMir(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>, target: &[u8],
  mode: CallableMode, parameters: usize, calls: usize) -> bool {
  let selected = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      let locals = Vector<MirLocal>.asSlice(&function.locals)
      let mut typed = false
      let mut at = usize.ZERO
      while at < locals.length {
        if Shared<Type>.with<bool>(&locals[at].ty, fn(value: &Type) -> bool {
          if let Type.CallableValue {contract, captures, fieldInputs, ..} = &value.* {
            return boundMethodFields(&captures, &fieldInputs) && boundMethodSignature(&contract, mode, parameters)
          }
          if let Type.CallableSchema {schema, captures, fieldInputs, ..} = &value.* {
            return boundMethodFields(&captures, &fieldInputs) && boundMethodSchemaSignature(&schema, mode, parameters)
          }
          return false
        }) { typed = true }
        at = at + usize.ONE
      }
      let blocks = Vector<MirBlock>.asSlice(&function.blocks)
      let mut selectedCalls = usize.ZERO
      at = usize.ZERO
      while at < blocks.length {
        if let MirTerminator.Call {callee: MirCallee.Instance {key}, arguments, ..} = &blocks[at].terminator {
          let identity = InstanceKey.identity(&key)
          if Shared<DeclarationId>.with<bool>(&identity, fn(value: &DeclarationId) -> bool { return DeclarationId.named(value, target) }) {
            let operands = Vector<MirOperand>.asSlice(&arguments)
            if operands.length != parameters || !sectionCaptureOperand(&operands[usize.ZERO], mode == CallableMode.Once) { return false }
            selectedCalls = selectedCalls + usize.ONE
          }
        }
        at = at + usize.ONE
      }
      return typed && selectedCalls == calls
    }
  }
  return false
}

fn enumMatchArmsKeepPatternsAndGuards(body: &TypedBody) -> bool {
  let nodes = TypedBody.nodeSlice(body)
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {form: BodyExpression.Match {arms, ..}, ..} = &nodes[at].kind {
      let written = Vector<BodyMatchArm>.asSlice(&arms)
      if written.length != 3 { return false }
      let mut guarded = false
      if let Option<BodyNodeId>.Some {..} = &written[usize.ZERO].guard { guarded = true }
      let mut ready = false
      if let BodyPattern.EnumMember {member} = &written[usize.ZERO].pattern {
        ready = member.ordinal == usize.ONE && !member.negative && member.magnitude == 7
      }
      let mut unknown = false
      if let BodyPattern.EnumMember {member} = &written[usize.ONE].pattern {
        unknown = member.ordinal == usize.ZERO && member.negative && member.magnitude == 1
      }
      let mut fallback = true
      if let BodyPattern.EnumMember {..} = &written[2].pattern { fallback = false }
      return guarded && ready && unknown && fallback
    }
    at = at + usize.ONE
  }
  return false
}

fn enumMatchCopiesSubject(body: &TypedBody) -> bool {
  let nodes = TypedBody.nodeSlice(body)
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {form: BodyExpression.Match {access, ..}, ..} = &nodes[at].kind {
      return match &access { BodySubjectAccess.Copy => true _ => false }
    }
    at = at + usize.ONE
  }
  return false
}

// Scalar enums keep nominal identity, take their representation's layout, and lower matches to switches.
test effect fn scalarEnumsLowerMembersValuesAndSwitches() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("scalar-enums.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
enum(i8) Status {
  Unknown = -1,
  Ready = 7,
}
enum Other { First, Second }
struct Flags { status: Status }
fn raw(status: Status) -> i8 { return Status.value(status) }
fn stored(flags: &Flags) -> bool { return flags.status != Status.Ready }
fn classify(status: Status, open: bool) -> i32 {
  return match move status {
    Status.Ready if open => 1
    Status.Unknown => 2
    _ => 3
  }
}
pub fn main() -> i32 {
  let flags = Flags { status: Status.Unknown }
  if stored(&flags) && raw(flags.status) == -1 { return classify(flags.status, true) }
  return 0
}
fn missing(status: Status) -> i32 { return match status { Status.Ready => 1 } }
fn duplicate(status: Status) -> i32 { return match status { Status.Unknown => 1 Status.Unknown => 2 _ => 3 } }
fn afterUniversal(status: Status) -> i32 { return match status { _ => 1 Status.Ready => 4 } }
fn covered(status: Status) -> i32 { return match status { Status.Ready => 1 Status.Unknown => 5 _ => 6 } }
fn coveredRepeat(status: Status) -> i32 { return match status { Status.Ready => 1 Status.Unknown => 5 Status.Ready => 6 } }
fn foreign(status: Status) -> i32 { return match status { Other.First => 1 _ => 2 } }
fn guardType(status: Status, count: i32) -> i32 { return match status { Status.Ready if count => 1 _ => 2 } }
fn copied(status: Status) -> i32 { return match status { _ => 0 } }
fn movedField(flags: Flags) -> i32 { return match move flags.status { _ => 0 } }
fn movedFresh() -> i32 { return match move Status.Ready { _ => 0 } }
struct Guarded { status: Status }
impl Intrinsic.Drop for Guarded { fn drop(self: &mut Guarded) -> () { return () } }
fn guardedField(value: Guarded) -> i32 { return match move value.status { _ => 0 } }
fn borrowed(status: &Status) -> i32 { return match & status.* { Status.Ready => 1 _ => 0 } }
fn borrowedMutable(status: Status) -> i32 {
  let mut held = status
  return match &mut held { _ => 0 }
}
impl Status { fn code(self: &Self) -> i32 { return 7 } }
fn inherent(status: Status) -> i32 { return Status.code(&status) }
fn invokedMember(status: Status) -> i32 { return Status.Ready(status) }
"""
  let mut store = run applicationSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.forApplication(ModuleId.copy(&id))
  let classifyAnswer = run Semantic.demandBody(&mut store, &mut request, &id, b"classify")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let classifyBody = Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(&classifyAnswer, checkedBody)
  let mut arms = false
  let mut enumType = Option<Shared<Type>>.none()
  if let Option<Shared<TypedBody>>.Some {value} = move classifyBody {
    arms = Shared<TypedBody>.with<bool>(&value, enumMatchArmsKeepPatternsAndGuards)
    enumType = Shared<TypedBody>.with<Option<Shared<Type>>>(&value, enumParameterType)
  }
  run Testing.expect(arms, "match arms keep member values, guard and universal fallback in written order")
  run Testing.expect(consumesAt(&classifyAnswer, 2, usize.ZERO, usize.MAX, usize.MAX),
    "an explicit scalar enum move match records the consumed parameter despite its Copy classification")
  let copied = run Semantic.demandBody(&mut store, &mut request, &id, b"copied")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let copiedAccess = Shared<Result<Answer, NoRejection>>.with<bool>(&copied,
    fn(answer: &Result<Answer, NoRejection>) -> bool {
      if let Option<Shared<TypedBody>>.Some {value} = move checkedBody(answer) {
        return Shared<TypedBody>.with<bool>(&value, enumMatchCopiesSubject)
      }
      return false
    })
  run Testing.expect(copiedAccess, "a bare enum match keeps Copy access")
  let field = run Semantic.demandBody(&mut store, &mut request, &id, b"movedField")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let fresh = run Semantic.demandBody(&mut store, &mut request, &id, b"movedFresh")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(consumesAt(&field, 2, usize.ZERO, usize.ZERO, usize.MAX)
    && consumesAt(&fresh, 2, usize.MAX, usize.MAX, usize.MAX),
    "a consuming enum field records its owner projection while a fresh member value records no place")
  let guarded = run Semantic.demandBody(&mut store, &mut request, &id, b"guardedField")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsSpan(&guarded, RejectionCode.ExtractionBoundary, text,
    "match move value.status { _ => 0 }", usize.ZERO),
    "a Copy enum field cannot be extracted through a Drop-hooked ancestor, diagnosed at the whole match")
  let borrowed = run Semantic.demandBody(&mut store, &mut request, &id, b"borrowed")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let borrowedAccess = Shared<Result<Answer, NoRejection>>.with<bool>(&borrowed,
    fn(answer: &Result<Answer, NoRejection>) -> bool {
      if let Option<Shared<TypedBody>>.Some {value} = move checkedBody(answer) {
        return Shared<TypedBody>.with<bool>(&value, enumMatchCopiesSubject)
      }
      return false
    })
  let borrowedMir = run Semantic.demandMir(&mut store, &mut request, &id, b"borrowed")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(borrowedAccess && succeeded(&borrowedMir),
    "a shared scalar enum match binds nothing, so it reads the Copy tag and lowers like a plain match")
  let borrowedMutable = run Semantic.demandBody(&mut store, &mut request, &id, b"borrowedMutable")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsSpan(&borrowedMutable, RejectionCode.Unsupported, text, "match &mut held { _ => 0 }", usize.ZERO),
    "a mutable scalar enum match retains its separate unsupported boundary")
  let inherent = run Semantic.demandMir(&mut store, &mut request, &id, b"inherent")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let invokedMember = run Semantic.demandBody(&mut store, &mut request, &id, b"invokedMember")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(Shared<Result<Answer, NoRejection>>.with<bool>(&inherent, pipelineHasMir),
    "a qualified call of an inherent enum member resolves as in every other nominal namespace")
  run Testing.expect(rejectsSpan(&invokedMember, RejectionCode.NotCallable, text, "Status.Ready(status)", usize.ZERO),
    "invoking an enum member value remains not callable")
  let mut scalarLayout = false
  if let Option<Shared<Type>>.Some {value: ty} = move enumType {
    let layoutAnswer = run Semantic.demandLayout(&mut store, &mut request, &id, &ty)
      |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
    let layoutIndex = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(&layoutAnswer, selectedLayoutIndex)
    if let Option<usize>.Some {value: index} = move layoutIndex {
      if let Option<Shared<BackendLayout>>.Some {value: facts} = move Semantic.layoutAt(&store, index) {
        scalarLayout = Shared<BackendLayout>.with<bool>(&facts, fn(layout: &BackendLayout) -> bool {
          let scalarStorage = match &layout.storage {
            LayoutStorage.Scalar => true
            _ => false
          }
          return scalarStorage && layout.size == usize.ONE && layout.alignment == usize.ONE && layout.abi == LayoutAbi.Integer
        })
      }
    }
  }
  run Testing.expect(scalarLayout, "a scalar enum takes its representation's neutral layout")
  let mirAnswer = run Semantic.demandMir(&mut store, &mut request, &id, b"classify")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut switches = usize.ZERO
  let mut cases = usize.ZERO
  let mut noDropFlags = false
  let mirIndex = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(&mirAnswer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move mirIndex {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(&store, index) {
      noDropFlags = true
      let locals = Vector<MirLocal>.asSlice(&function.locals)
      let mut localAt = usize.ZERO
      while localAt < locals.length {
        if let MirLocalKind.DropFlag {..} = &locals[localAt].kind { noDropFlags = false }
        localAt = localAt + usize.ONE
      }
      let blocks = Vector<MirBlock>.asSlice(&function.blocks)
      let mut at = usize.ZERO
      while at < blocks.length {
        if let MirTerminator.Switch {cases: selected, ..} = &blocks[at].terminator {
          switches = switches + usize.ONE
          cases = cases + Vector<MirSwitchCase>.length(&selected)
        }
        at = at + usize.ONE
      }
    }
  }
  run Testing.expect(switches == 2 && cases == 3, "a false guard resumes dispatch at the next arm with a second switch")
  run Testing.expect(succeeded(&mirAnswer) && noDropFlags && glueFact(&store, &mirAnswer, usize.ZERO) == usize.ZERO
    && glueFact(&store, &mirAnswer, 6) == usize.ZERO,
    "a consuming Copy enum switch has no drop statements, glue references or ownership flags")
  // Keep every negative Body assertion in the original source. The emission control gets
  // a complete valid program, since builds now check its entire loaded declaration closure.
  let buildText = """
enum(i8) Status {
  Unknown = -1,
  Ready = 7,
}
enum Other { First, Second }
struct Flags { status: Status }
fn raw(status: Status) -> i8 { return Status.value(status) }
fn stored(flags: &Flags) -> bool { return flags.status != Status.Ready }
fn classify(status: Status, open: bool) -> i32 {
  return match move status {
    Status.Ready if open => 1
    Status.Unknown => 2
    _ => 3
  }
}
pub fn main() -> i32 {
  let flags = Flags { status: Status.Unknown }
  if stored(&flags) && raw(flags.status) == -1 { return classify(flags.status, true) }
  return 0
}
fn copied(status: Status) -> i32 { return match status { _ => 0 } }
fn movedField(flags: Flags) -> i32 { return match move flags.status { _ => 0 } }
fn movedFresh() -> i32 { return match move Status.Ready { _ => 0 } }
struct Guarded { status: Status }
impl Intrinsic.Drop for Guarded { fn drop(self: &mut Guarded) -> () { return () } }
fn borrowed(status: &Status) -> i32 { return match & status.* { Status.Ready => 1 _ => 0 } }
impl Status { fn code(self: &Self) -> i32 { return 7 } }
fn inherent(status: Status) -> i32 { return Status.code(&status) }
"""
  let mut buildStore = run applicationSemantic(
    &id,
    buildText,
    MachineTarget.forId(TargetId.X8664UnknownLinuxGnu)
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut buildRequest = Request.forApplication(ModuleId.copy(&id))
  let built = run buildApplication(&mut buildStore, &mut buildRequest, staticClosureNodes)
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut emitted = false
  match move built {
    BackendBuild.Module {text: ir, ..} => {
      let bytes = Bytes.asSlice(&ir)
      emitted = containsIr(bytes, b"switch i8") && containsIr(bytes, b"i8 7, label %b") && containsIr(bytes, b"i8 -1, label %b")
    }
    _ => ()
  }
  run Testing.expect(emitted, "enum switches and values are spelled from the representation layout")
  let missing = run Semantic.demandBody(&mut store, &mut request, &id, b"missing")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let duplicate = run Semantic.demandBody(&mut store, &mut request, &id, b"duplicate")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let afterUniversal = run Semantic.demandBody(&mut store, &mut request, &id, b"afterUniversal")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let covered = run Semantic.demandBody(&mut store, &mut request, &id, b"covered")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let coveredRepeat = run Semantic.demandBody(&mut store, &mut request, &id, b"coveredRepeat")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let foreign = run Semantic.demandBody(&mut store, &mut request, &id, b"foreign")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let guardType = run Semantic.demandBody(&mut store, &mut request, &id, b"guardType")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    rejectsSpan(&missing, RejectionCode.MissingEnumMember, text, "match status { Status.Ready => 1 }", 0) &&
    rejectsSpan(&duplicate, RejectionCode.DuplicateEnumMatchArm, text, "Status.Unknown", 3) &&
    rejectsRelated(&duplicate, RejectionCode.DuplicateEnumMatchArm, offsetOf(text, "Status.Unknown", 3), offsetOf(text, "Status.Unknown", 2)) &&
    rejectsSpan(&afterUniversal, RejectionCode.EnumMatchArmAfterWildcard, text, "Status.Ready => 4", 0) &&
    rejectsSpan(&covered, RejectionCode.UnreachableMatchArm, text, "_ => 6", 0) &&
    rejectsSpan(&coveredRepeat, RejectionCode.DuplicateEnumMatchArm, text, "Status.Ready", 6) &&
    rejectsRelated(&coveredRepeat, RejectionCode.DuplicateEnumMatchArm, offsetOf(text, "Status.Ready", 6), offsetOf(text, "Status.Ready", 5)) &&
    rejectsSpan(&foreign, RejectionCode.ForeignEnumPattern, text, "Other.First", 0) &&
    rejectsSpan(&guardType, RejectionCode.MatchGuardNotBool, text, "count", 1),
    "enum coverage, foreign members and non-Boolean guards report precise spans",
  )
  return ()
}

fn recordArmTag(body: &TypedBody, arm: usize) -> usize {
  let nodes = TypedBody.nodeSlice(body)
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {form: BodyExpression.Match {arms, ..}, ..} = &nodes[at].kind {
      let written = Vector<BodyMatchArm>.asSlice(&arms)
      if arm < written.length {
        if let BodyPattern.Record {member} = &written[arm].pattern {
          if let Option<BodyUnionMember>.Some {value} = &member { return value.tag }
        }
      }
      return usize.MAX
    }
    at = at + usize.ONE
  }
  return usize.MAX
}

// Counts binding places reaching field `first` (then `second`, unless MAX) after an optional
// structural member step `tag` (MAX = none).
fn bindingPlaces(body: &TypedBody, tag: usize, first: usize, second: usize) -> usize {
  let nodes = TypedBody.nodeSlice(body)
  let mut found = usize.ZERO
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {form: BodyExpression.PatternBinding {path, ..}, ..} = &nodes[at].kind {
      let steps = Vector<BodyPlaceStep>.asSlice(&path)
      let mut cursor = usize.ZERO
      let mut matched = true
      if tag != usize.MAX {
        matched = false
        if steps.length > usize.ZERO {
          if let BodyPlaceStep.Member {tag: selected, ..} = &steps[usize.ZERO] { matched = selected == tag }
        }
        cursor = usize.ONE
      }
      let mut expected = usize.ONE + usize.ONE
      if second == usize.MAX { expected = usize.ONE }
      if matched && steps.length == cursor + expected {
        let mut fieldsMatch = false
        if let BodyPlaceStep.Field {index} = &steps[cursor] { fieldsMatch = index == first }
        if second != usize.MAX {
          let mut secondMatch = false
          if let BodyPlaceStep.Field {index} = &steps[cursor + usize.ONE] { secondMatch = index == second }
          fieldsMatch = fieldsMatch && secondMatch
        }
        if fieldsMatch { found = found + usize.ONE }
      }
    }
    at = at + usize.ONE
  }
  return found
}

effect fn injectionCount(answer: &Shared<Result<Answer, NoRejection>>) -> usize ! OutOfMemoryError ? &mut Allocator {
  let selected = Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(answer, checkedBody)
  return match move selected {
    Option<Shared<TypedBody>>.Some {value} => Shared<TypedBody>.with<usize>(&value, unionInjections)
    Option<Shared<TypedBody>>.None => usize.MAX
  }
}

fn unionInjections(body: &TypedBody) -> usize {
  let nodes = TypedBody.nodeSlice(body)
  let mut found = usize.ZERO
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {form: BodyExpression.UnionInject {..}, ..} = &nodes[at].kind { found = found + usize.ONE }
    at = at + usize.ONE
  }
  return found
}

fn firstArmMember(body: &TypedBody) -> Option<Shared<Type>> {
  let nodes = TypedBody.nodeSlice(body)
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {form: BodyExpression.Match {arms, ..}, ..} = &nodes[at].kind {
      let written = Vector<BodyMatchArm>.asSlice(&arms)
      if written.length > usize.ZERO {
        if let BodyPattern.Record {member} = &written[usize.ZERO].pattern {
          if let Option<BodyUnionMember>.Some {value} = &member { return Option<Shared<Type>>.some(Shared<Type>.clone(&value.ty)) }
        }
      }
      return Option<Shared<Type>>.none()
    }
    at = at + usize.ONE
  }
  return Option<Shared<Type>>.none()
}

fn taggedMemberAt(layout: &BackendLayout, tag: usize) -> Option<Shared<Type>> {
  if let LayoutStorage.Tagged {members, ..} = &layout.storage {
    let listed = Vector<Shared<Type>>.asSlice(&members)
    if tag < listed.length { return Option<Shared<Type>>.some(Shared<Type>.clone(&listed[tag])) }
  }
  return Option<Shared<Type>>.none()
}

fn taggedLayout(layout: &BackendLayout) -> usize {
  if let LayoutStorage.Tagged {tagSize, payloadOffset, ..} = &layout.storage {
    if tagSize == usize.ONE && layout.abi == LayoutAbi.Indirect { return payloadOffset * 100 + layout.size }
  }
  return usize.MAX
}

// Closed-record unions share canonical tags across functions, keep field places for bindings, and
// lower matches to tag switches over a Tagged layout.
test effect fn structuralUnionsInjectBindAndSwitchOnTags() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("structural-unions.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
struct Left { value: i32 }
struct Right { marker: u8 value: i32 }
struct Empty {}
struct Token { value: i32 }
struct Pair { token: Token discarded: Token }
fn inspect(input: Left | Right | Empty, open: bool) -> i32 {
  return match &input {
    Left { value } if open => value
    Right { value, .. } => value
    _ => 7
  }
}
fn total(pair: Pair) -> i32 { return match move pair { Pair { token: Token { value }, .. } => value } }
fn exclusive(token: Token) -> i32 { let mut held = move token return match &mut held { Token { value } => value } }
fn same(input: Left | Token) -> i32 { return 0 }
pub fn main() -> i32 { return inspect(Left { value: 42 }, true) }
fn spelled(input: Empty | Right | Left) -> i32 { return 0 }
"""
  let mut store = run applicationSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.forApplication(ModuleId.copy(&id))
  let spelledAnswer = run Semantic.demandBody(&mut store, &mut request, &id, b"spelled")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut spelledType = Option<Shared<Type>>.none()
  let spelledBody = Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(&spelledAnswer, checkedBody)
  if let Option<Shared<TypedBody>>.Some {value} = move spelledBody {
    spelledType = Shared<TypedBody>.with<Option<Shared<Type>>>(&value, enumParameterType)
  }
  let mut spelledLayout = Option<Shared<BackendLayout>>.none()
  if let Option<Shared<Type>>.Some {value: ty} = move spelledType {
    let layoutAnswer = run Semantic.demandLayout(&mut store, &mut request, &id, &ty)
      |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
    let layoutIndex = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(&layoutAnswer, selectedLayoutIndex)
    if let Option<usize>.Some {value: index} = move layoutIndex { spelledLayout = Semantic.layoutAt(&store, index) }
  }
  let inspectAnswer = run Semantic.demandBody(&mut store, &mut request, &id, b"inspect")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let mainAnswer = run Semantic.demandBody(&mut store, &mut request, &id, b"main")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let totalAnswer = run Semantic.demandBody(&mut store, &mut request, &id, b"total")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let exclusiveAnswer = run Semantic.demandBody(&mut store, &mut request, &id, b"exclusive")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let sameAnswer = run Semantic.demandBody(&mut store, &mut request, &id, b"same")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut leftArm = usize.MAX
  let mut rightArm = usize.MAX
  let mut leftValues = usize.ZERO
  let mut rightValues = usize.ZERO
  let mut unionType = Option<Shared<Type>>.none()
  let mut leftType = Option<Shared<Type>>.none()
  let checked1 = Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(&inspectAnswer, checkedBody)
  if let Option<Shared<TypedBody>>.Some {value} = move checked1 {
    leftArm = Shared<TypedBody>.with<usize>(&value, fn(body: &TypedBody) -> usize { return recordArmTag(body, usize.ZERO) })
    rightArm = Shared<TypedBody>.with<usize>(&value, fn(body: &TypedBody) -> usize { return recordArmTag(body, usize.ONE) })
    leftValues = Shared<TypedBody>.with<usize>(&value, fn(body: &TypedBody) -> usize { return bindingPlaces(body, leftArm, usize.ZERO, usize.MAX) })
    rightValues = Shared<TypedBody>.with<usize>(&value, fn(body: &TypedBody) -> usize { return bindingPlaces(body, rightArm, usize.ONE, usize.MAX) })
    unionType = Shared<TypedBody>.with<Option<Shared<Type>>>(&value, enumParameterType)
    leftType = Shared<TypedBody>.with<Option<Shared<Type>>>(&value, firstArmMember)
  }
  let mut injected = usize.MAX
  let checked2 = Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(&mainAnswer, checkedBody)
  if let Option<Shared<TypedBody>>.Some {value} = move checked2 {
    injected = Shared<TypedBody>.with<usize>(&value, firstUnionInjectTag)
  }
  run Testing.expect(leftArm < 3 && rightArm < 3 && leftArm != rightArm && injected == leftArm,
    "an injected member and its pattern in another function share one canonical tag")
  run Testing.expect(leftValues >= usize.ONE && rightValues >= usize.ONE, "member field bindings are places under their member tag")
  let mut nested = usize.ZERO
  let mut consumed = true
  let checked3 = Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(&totalAnswer, checkedBody)
  if let Option<Shared<TypedBody>>.Some {value} = move checked3 {
    nested = Shared<TypedBody>.with<usize>(&value, fn(body: &TypedBody) -> usize { return bindingPlaces(body, usize.MAX, usize.ZERO, usize.ZERO) })
    consumed = Shared<TypedBody>.with<bool>(&value, matchAddressesPlace)
  }
  let mut addressed = false
  let checked4 = Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(&exclusiveAnswer, checkedBody)
  if let Option<Shared<TypedBody>>.Some {value} = move checked4 {
    addressed = Shared<TypedBody>.with<bool>(&value, matchAddressesPlace)
  }
  run Testing.expect(nested >= usize.ONE && !consumed && addressed,
    "nested record bindings follow field paths; moves read a copy and exclusive matches address the place")
  let mut asymmetric = usize.MAX
  if let Option<Shared<Type>>.Some {value: ty} = move unionType {
    let layoutAnswer = run Semantic.demandLayout(&mut store, &mut request, &id, &ty)
      |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
    let layoutIndex = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(&layoutAnswer, selectedLayoutIndex)
    if let Option<usize>.Some {value: index} = move layoutIndex {
      if let Option<Shared<BackendLayout>>.Some {value: facts} = move Semantic.layoutAt(&store, index) {
        asymmetric = Shared<BackendLayout>.with<usize>(&facts, taggedLayout)
      }
    }
  }
  let mut equal = usize.MAX
  let mut sameType = Option<Shared<Type>>.none()
  let checked5 = Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(&sameAnswer, checkedBody)
  if let Option<Shared<TypedBody>>.Some {value} = move checked5 {
    sameType = Shared<TypedBody>.with<Option<Shared<Type>>>(&value, enumParameterType)
  }
  if let Option<Shared<Type>>.Some {value: ty} = move sameType {
    let layoutAnswer = run Semantic.demandLayout(&mut store, &mut request, &id, &ty)
      |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
    let layoutIndex = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(&layoutAnswer, selectedLayoutIndex)
    if let Option<usize>.Some {value: index} = move layoutIndex {
      if let Option<Shared<BackendLayout>>.Some {value: facts} = move Semantic.layoutAt(&store, index) {
        equal = Shared<BackendLayout>.with<usize>(&facts, taggedLayout)
      }
    }
  }
  run Testing.expect(asymmetric == 412 && equal == 408,
    "a one-byte tag precedes the largest member at the strictest member alignment")
  let mut canonicalMember = false
  if let Option<Shared<BackendLayout>>.Some {value: facts} = move spelledLayout {
    let selected = Shared<BackendLayout>.with<Option<Shared<Type>>>(&facts, fn(layout: &BackendLayout) -> Option<Shared<Type>> {
      return taggedMemberAt(layout, leftArm)
    })
    if let Option<Shared<Type>>.Some {value: member} = move selected {
      if let Option<Shared<Type>>.Some {value: left} = move leftType { canonicalMember = run Type.equalsShared(&member, &left)
        |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator) }
    }
  }
  run Testing.expect(canonicalMember, "a differently spelled union demanded first still stores members in canonical tag order")
  let mirAnswer = run Semantic.demandMir(&mut store, &mut request, &id, b"inspect")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut switches = usize.ZERO
  let mut cases = usize.ZERO
  let mut discriminant = false
  let mut payload = false
  let mirIndex = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(&mirAnswer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move mirIndex {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(&store, index) {
      let blocks = Vector<MirBlock>.asSlice(&function.blocks)
      let mut at = usize.ZERO
      while at < blocks.length {
        if let MirTerminator.Switch {cases: selected, ..} = &blocks[at].terminator {
          switches = switches + usize.ONE
          cases = cases + Vector<MirSwitchCase>.length(&selected)
        }
        let statements = Vector<MirStatement>.asSlice(&blocks[at].statements)
        let mut statementAt = usize.ZERO
        while statementAt < statements.length {
          if let MirStatement.Assign {value, ..} = &statements[statementAt] {
            if let MirRvalue.Discriminant {..} = &value { discriminant = true }
            if let MirRvalue.Use {value: MirOperand.Copy {place}} = &value {
              let projections = Vector<MirProjection>.asSlice(&place.projections)
              let mut step = usize.ZERO
              while step < projections.length {
                if let MirProjection.Payload {..} = &projections[step] { payload = true }
                step = step + usize.ONE
              }
            }
          }
          statementAt = statementAt + usize.ONE
        }
        at = at + usize.ONE
      }
    }
  }
  run Testing.expect(discriminant && payload && switches == 2 && cases == 3,
    "the tag is read once and a false guard resumes the switch at the next arm")
  let built = run buildApplication(&mut store, &mut request, staticClosureNodes)
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut emitted = false
  match move built {
    BackendBuild.Module {text: ir, ..} => {
      let bytes = Bytes.asSlice(&ir)
      emitted = containsIr(bytes, b"switch i8") && containsIrLine(bytes, b"getelementptr i8", b", i64 4")
    }
    _ => ()
  }
  run Testing.expect(emitted, "tags and payload offsets are spelled from the Tagged layout")
  return ()
}

// Scalar members join closed structural unions: canonical tags, a Tagged layout, injection at every
// boundary, and exact `T name` / `T _` arms that are never catch-alls.
test effect fn scalarMemberUnionsInjectBindAndSwitch() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run scalarMemberUnionClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn scalarMemberUnionClaims() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
? &mut Allocator | &mut Types {
  let id = run module("scalar-member-unions.silk")
  let text = """
struct Token { kind: i32 }
fn spelled(value: bool | i64) -> i32 { return 0 }
fn wide(value: i64 | bool) -> i32 { return 0 }
fn small(value: u8 | bool) -> i32 { return 0 }
fn pick(k: i32) -> i64 | bool | Token {
  if k == 0 {
    let n: i64 = 7
    return n
  }
  if k == 1 {
    let flag: bool = true
    return flag
  }
  return Token { kind: k }
}
fn classify(k: i32) -> i64 {
  return match move pick(k) {
    i64 n => n
    bool _ => 1
    Token { kind } => 2
  }
}
fn shared(v: i64 | bool) -> i32 { return match &v { i64 _ => 1 bool _ => 2 } }
fn copied(v: i64 | bool) -> i32 { return match v { i64 _ => 1 bool _ => 2 } }
fn affine(v: i64 | bool | Token) -> i32 { return match v { i64 _ => 1 bool _ => 2 Token { kind } => 3 } }
fn partial(v: i64 | bool | Token) -> i32 { return match move v { i64 _ => 1 } }
fn literal() -> i64 | bool { return 5 }
fn absent(v: i64 | bool) -> i32 { return match move v { u8 x => 1 bool _ => 2 } }
fn twice(v: i64 | bool) -> i32 { return match move v { i64 a => 1 i64 b => 2 bool _ => 3 } }
fn braced(v: i64 | bool) -> i32 { return match move v { i64 {} => 1 bool _ => 2 } }
fn fpick(k: i32) -> f64 | f32 | char | bool {
  if k == 0 { return 1.5 }
  if k == 1 {
    let small: f32 = 2.5
    return small
  }
  if k == 2 { return 'q' }
  return true
}
fn fscore(k: i32) -> i32 {
  return match move fpick(k) {
    f64 real => { if real == 1.5 { return 1 } return 9 }
    f32 small => { if small == 2.5 { return 2 } return 9 }
    char c => { if c == 'q' { return 3 } return 9 }
    bool b => { if b { return 4 } return 9 }
  }
}
fn openMatch(value: f64 | Token) -> i32 { return match move value { f64 _ => 1 Token { kind } => kind } }
fn openPass() -> i32 { return openMatch(1.5) }
fn charSmall(value: char | u8) -> i32 { return 0 }
fn floatUnion(value: f64 | bool) -> i32 { return 0 }
fn floaty() -> i32 {
  let truth: bool = true
  return floatUnion(truth)
}
fn stringUnion(value: i32 | string<'static>) -> i32 { return 0 }
fn stringy() -> i32 {
  let count: i32 = 1
  return stringUnion(count)
}
fn stringMatch(value: i32 | string<'static>) -> i32 { return match move value { i32 n => n string text => 1 } }
fn truthy(v: i64 | bool) -> bool {
  return match move v {
    bool b => b
    i64 _ => false
  }
}
pub fn main() -> i32 {
  let picked = classify(0)
  let flag: bool = true
  let held: i64 | bool = flag
  let truth = truthy(held)
  return 0
}
"""
  let mut store = run applicationSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.forApplication(ModuleId.copy(&id))
  let spelled = run parameterLayout(&mut store, &mut request, &id, b"spelled")
  let wide = run parameterLayout(&mut store, &mut request, &id, b"wide")
  let small = run parameterLayout(&mut store, &mut request, &id, b"small")
  run Testing.expect(spelled != usize.MAX && spelled == wide,
    "bool | i64 and i64 | bool are one canonical union with one layout")
  run Testing.expect(wide % 1000000 == 108168, "i64 | bool: a one-byte tag, the payload at 8, size 16, alignment 8")
  run Testing.expect(small % 1000000 == 101021, "u8 | bool: a one-byte tag, the payload at 1, size 2, alignment 1")
  let pickAnswer = run Semantic.demandBody(&mut store, &mut request, &id, b"pick")
  let pickInjections = run injectionCount(&pickAnswer)
  run Testing.expect(pickInjections == 3, "each returned member, scalar or record, injects once")
  let classifyAnswer = run Semantic.demandBody(&mut store, &mut request, &id, b"classify")
  let mut tags = usize.MAX
  let classifyBody = Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(&classifyAnswer, checkedBody)
  if let Option<Shared<TypedBody>>.Some {value} = move classifyBody {
    tags = Shared<TypedBody>.with<usize>(&value, matchTagCount)
  }
  run Testing.expect(tags == 3, "a type-binding match over three members switches on three tags")
  let mirAnswer = run Semantic.demandMir(&mut store, &mut request, &id, b"classify")
  run Testing.expect(taggedMatchCases(&store, &mirAnswer) == 3, "the scalar binding copies its payload after one tag switch")
  let fscoreMir = run Semantic.demandMir(&mut store, &mut request, &id, b"fscore")
  run Testing.expect(taggedMatchCases(&store, &fscoreMir) == 4,
    "float, char and bool members bind by copying their payload after one four-way tag switch")
  let openMatch = run Semantic.demandMir(&mut store, &mut request, &id, b"openMatch")
  let openPass = run Semantic.demandMir(&mut store, &mut request, &id, b"openPass")
  let openPassBody = run Semantic.demandBody(&mut store, &mut request, &id, b"openPass")
  let openPassInjections = run injectionCount(&openPassBody)
  let openLayout = run parameterLayout(&mut store, &mut request, &id, b"openMatch")
  run Testing.expect(
    taggedMatchCases(&store, &openMatch) == 2 && succeeded(&openPass) && openPassInjections == usize.ONE
      && openLayout % 1000000 == 108168,
    "f64 | Token injects a float literal once, switches on two tags, and lays out its payload at 8, size 16, alignment 8",
  )
  let charLayout = run parameterLayout(&mut store, &mut request, &id, b"charSmall")
  run Testing.expect(charLayout % 1000000 == 104084, "char | u8: a one-byte tag, the payload at 4, size 8, alignment 4")
  // Keep every negative Body assertion in the original source. The emission control gets
  // a complete valid program, since builds now check its entire loaded declaration closure.
  let buildText = """
struct Token { kind: i32 }
fn spelled(value: bool | i64) -> i32 { return 0 }
fn wide(value: i64 | bool) -> i32 { return 0 }
fn small(value: u8 | bool) -> i32 { return 0 }
fn pick(k: i32) -> i64 | bool | Token {
  if k == 0 {
    let n: i64 = 7
    return n
  }
  if k == 1 {
    let flag: bool = true
    return flag
  }
  return Token { kind: k }
}
fn classify(k: i32) -> i64 {
  return match move pick(k) {
    i64 n => n
    bool _ => 1
    Token { kind } => 2
  }
}
fn shared(v: i64 | bool) -> i32 { return match &v { i64 _ => 1 bool _ => 2 } }
fn copied(v: i64 | bool) -> i32 { return match v { i64 _ => 1 bool _ => 2 } }
fn fpick(k: i32) -> f64 | f32 | char | bool {
  if k == 0 { return 1.5 }
  if k == 1 {
    let small: f32 = 2.5
    return small
  }
  if k == 2 { return 'q' }
  return true
}
fn fscore(k: i32) -> i32 {
  return match move fpick(k) {
    f64 real => { if real == 1.5 { return 1 } return 9 }
    f32 small => { if small == 2.5 { return 2 } return 9 }
    char c => { if c == 'q' { return 3 } return 9 }
    bool b => { if b { return 4 } return 9 }
  }
}
fn floatUnion(value: f64 | bool) -> i32 { return 0 }
fn stringUnion(value: i32 | string<'static>) -> i32 { return 0 }
fn stringy() -> i32 {
  let count: i32 = 1
  return stringUnion(count)
}
fn stringMatch(value: i32 | string<'static>) -> i32 { return match move value { i32 n => n string text => 1 } }
fn truthy(v: i64 | bool) -> bool {
  return match move v {
    bool b => b
    i64 _ => false
  }
}
pub fn main() -> i32 {
  let picked = classify(0)
  let flag: bool = true
  let held: i64 | bool = flag
  let truth = truthy(held)
  let scored = fscore(2)
  return 0
}
"""
  let mut buildStore = run applicationSemantic(
    &id,
    buildText,
    MachineTarget.forId(TargetId.X8664UnknownLinuxGnu)
  )
  let mut buildRequest = Request.forApplication(ModuleId.copy(&id))
  let built = run buildApplication(&mut buildStore, &mut buildRequest, staticClosureNodes)
  let mut emitted = false
  let mut floats = false
  match move built {
    BackendBuild.Module {text: ir, ..} => {
      let bytes = Bytes.asSlice(&ir)
      emitted = containsIr(bytes, b"switch i8") && containsIr(bytes, b"store i64 7")
        && containsIr(bytes, b"store i1 true") && containsIr(bytes, b"load i1")
        && containsIrLine(bytes, b"getelementptr i8", b", i64 8")
      floats = containsIr(bytes, b"store double 0x3FF8000000000000") && containsIr(bytes, b"load double")
        && containsIr(bytes, b"store float") && containsIr(bytes, b"load float")
        && containsIr(bytes, b"store i32 113")
    }
    _ => ()
  }
  run Testing.expect(emitted,
    "scalar payloads are stored and loaded at the Tagged payload offset in the representation bool record fields use")
  run Testing.expect(floats,
    "f64 and f32 payloads are stored and loaded as double and float, and a char payload as its i32 code point")
  let sharedAnswer = run Semantic.demandBody(&mut store, &mut request, &id, b"shared")
  let copiedAnswer = run Semantic.demandBody(&mut store, &mut request, &id, b"copied")
  run Testing.expect(succeeded(&sharedAnswer) && succeeded(&copiedAnswer),
    "`T _` arms over every member are exhaustive, and an all-Copy union matches by value")
  let affineAnswer = run Semantic.demandBody(&mut store, &mut request, &id, b"affine")
  run Testing.expect(rejectsSpan(&affineAnswer, RejectionCode.ExplicitMoveRequired, text,
      "match v { i64 _ => 1 bool _ => 2 Token { kind } => 3 }", 0),
    "a union with an affine member needs an explicit move to match by value")
  let partialAnswer = run Semantic.demandBody(&mut store, &mut request, &id, b"partial")
  run Testing.expect(rejectsSpan(&partialAnswer, RejectionCode.MissingUnionMember, text, "match move v { i64 _ => 1 }", 0),
    "`T _` covers only T: a match missing members is not exhaustive")
  let literalAnswer = run Semantic.demandBody(&mut store, &mut request, &id, b"literal")
  run Testing.expect(rejectsSpan(&literalAnswer, RejectionCode.IncompatibleUnionConversion, text, "5", 0),
    "a bare literal is not typed into a union member")
  let absentAnswer = run Semantic.demandBody(&mut store, &mut request, &id, b"absent")
  let twiceAnswer = run Semantic.demandBody(&mut store, &mut request, &id, b"twice")
  let bracedAnswer = run Semantic.demandBody(&mut store, &mut request, &id, b"braced")
  run Testing.expect(
    rejectsSpan(&absentAnswer, RejectionCode.MatchMemberNotInScrutinee, text, "u8 x", 0) &&
    rejectsSpan(&twiceAnswer, RejectionCode.UnreachableMatchArm, text, "i64 b => 2", 0) &&
    rejectsSpan(&bracedAnswer, RejectionCode.NotType, text, "i64 {}", 0),
    "a non-member type arm, a repeated type arm and a field list on a scalar member report precise spans",
  )
  let floatyAnswer = run Semantic.demandMir(&mut store, &mut request, &id, b"floaty")
  let floatLayout = run parameterLayout(&mut store, &mut request, &id, b"floatUnion")
  run Testing.expect(succeeded(&floatyAnswer) && floatLayout % 1000000 == 108168,
    "a float member is an ordinary scalar member: f64 | bool injects with its payload at 8, size 16, alignment 8")
  let stringyAnswer = run Semantic.demandMir(&mut store, &mut request, &id, b"stringy")
  let stringMatch = run Semantic.demandMir(&mut store, &mut request, &id, b"stringMatch")
  let stringLayout = run parameterLayout(&mut store, &mut request, &id, b"stringMatch")
  run Testing.expect(succeeded(&stringyAnswer) && succeeded(&stringMatch) && stringLayout % 1000000 == 108248,
    "a text view is a descriptor member: i32 | string injects, binds and switches with its payload at 8, size 24, alignment 8")
  return ()
}

// The tag-switch case count of a selected MIR function whose arms read a payload after
// reading the discriminant, or `usize.MAX` when either read is missing.
fn taggedMatchCases(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>) -> usize {
  let mut cases = usize.ZERO
  let mut discriminant = false
  let mut payload = false
  let mirIndex = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move mirIndex {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      let blocks = Vector<MirBlock>.asSlice(&function.blocks)
      let mut at = usize.ZERO
      while at < blocks.length {
        if let MirTerminator.Switch {cases: selected, ..} = &blocks[at].terminator {
          cases = cases + Vector<MirSwitchCase>.length(&selected)
        }
        let statements = Vector<MirStatement>.asSlice(&blocks[at].statements)
        let mut statementAt = usize.ZERO
        while statementAt < statements.length {
          if let MirStatement.Assign {value, ..} = &statements[statementAt] {
            if let MirRvalue.Discriminant {..} = &value { discriminant = true }
            if let MirRvalue.Use {value: MirOperand.Copy {place}} = &value {
              let projections = Vector<MirProjection>.asSlice(&place.projections)
              let mut step = usize.ZERO
              while step < projections.length {
                if let MirProjection.Payload {..} = &projections[step] { payload = true }
                step = step + usize.ONE
              }
            }
          }
          statementAt = statementAt + usize.ONE
        }
        at = at + usize.ONE
      }
    }
  }
  if discriminant && payload { return cases }
  return usize.MAX
}

test effect fn structuralUnionsInjectAtBoundariesAndRejectPrecisely() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("structural-union-rejections.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
struct Left { value: i32 }
struct Right { marker: u8 value: i32 }
struct Empty {}
struct Token { value: i32 }
struct Holder { inner: Left | Empty }
fn missing(input: Left | Right | Empty) -> i32 { return match &input { Left { value } => value Empty {} => 0 } }
fn duplicate(input: Left | Right | Empty) -> i32 { return match &input { Left { .. } => 1 Left { value } => value _ => 0 } }
fn afterUniversal(input: Left | Right | Empty) -> i32 { return match &input { _ => 1 Empty {} => 2 } }
fn covered(input: Left | Right | Empty) -> i32 { return match &input { Left { .. } => 1 Right { .. } => 2 Empty {} => 3 _ => 4 } }
fn foreign(input: Left | Right | Empty) -> i32 { return match &input { Token { value } => value _ => 0 } }
fn incomplete(input: Left | Right | Empty) -> i32 { return match &input { Left {} => 1 _ => 0 } }
fn refutable(holder: Holder) -> i32 { return match &holder { Holder { inner: Left { value } } => value } }
fn guardType(input: Left | Right | Empty, count: i32) -> i32 { return match &input { Left { value } if count => value _ => 0 } }
fn returned() -> Left | Empty { return Left { value: 1 } }
fn bound() -> i32 { let held: Left | Empty = Empty {} return 0 }
fn assigned() -> i32 { let mut held: Left | Empty = Empty {} held = Left { value: 2 } return 0 }
fn listed() -> i32 { let values: [Left | Empty; 2] = [Left { value: 3 }, Empty {}] return 0 }
fn armResult(input: Left | Right | Empty) -> Left | Empty { return match &input { Left { value } => Left { value: value } _ => Empty {} } }
fn wrong() -> Left | Empty { return Token { value: 1 } }
fn openUnion(value: f64 | Token) -> i32 { return 0 }
fn deferredOpen() -> i32 { return openUnion(1.5) }
union Shape { Dot, Line { length: i32 } }
fn nestedVariant(input: Left | Shape) -> i32 { return match &input { Shape.Line { length } => length _ => 0 } }
fn nestedExhaustive(input: Left | Shape) -> i32 { return match &input { Shape.Dot => 1 Shape.Line { length } => length Left { value } => value } }
fn helper() -> i32 { return 0 }
fn notType(input: Left | Shape) -> i32 { return match &input { helper { value } => value _ => 0 } }
fn recovered(input: Left | Right | Empty) -> i32 { return match &input { Token { value } => value Left { value, absent } => value _ => 0 } }
fn recoveredCoverage(input: Left | Right | Empty) -> i32 { return match &input { Token { value } => value Left { value } => value } }
fn oneFailedArm(input: Left | Right | Empty) -> i32 { return match &input { Left { value } => value Token { value } => value Right { value, .. } => value _ => 0 } }
fn statementsRecover(flag: bool) -> i32 { if 41 { return 0 } while 42 { } return flag }
fn statementsAfterBinding(flag: bool) -> i32 { if 43 { return 0 } let held: i32 = flag if 44 { return 1 } return held }
fn statementsWithArms(input: Left | Right | Empty) -> i32 { if 45 { return 0 } return match &input { Token { value } => value Left { value, missed } => value _ => 0 } }
static fn statementsStatic(flag: bool) -> i32 { if 46 { return 0 } while 47 { } return 0 }
fn takeToken(token: Token) -> i32 { return token.value }
fn ownedBefore(flag: bool) -> i32 { let owned = Token { value: 1 } let a = takeToken(move owned) let b = takeToken(move owned) if 51 { return 0 } return a + b }
fn ownedAfter(flag: bool) -> i32 { let owned = Token { value: 2 } while 52 { } let a = takeToken(move owned) let b = takeToken(move owned) return a + b }
fn ownedAcross(flag: bool) -> i32 { let owned = Token { value: 3 } let a = takeToken(move owned) if 53 { return 0 } let b = takeToken(move owned) return a + b }
fn ownedReplaced(flag: bool) -> i32 { let mut owned = Token { value: 4 } let a = takeToken(move owned) owned = 54 let b = takeToken(move owned) return a + b }
fn ownedLoop(flag: bool) -> i32 { let owned = Token { value: 5 } while flag { if 55 { } let a = takeToken(move owned) } return 0 }
fn ownedUnreached(flag: bool) -> i32 { let owned = Token { value: 6 } if 56 { } return 0 let a = takeToken(move owned) let b = takeToken(move owned) return a + b }
fn ownedFailedReturn(flag: bool) -> i32 { let owned = Token { value: 7 } return flag let a = takeToken(move owned) let b = takeToken(move owned) return a + b }
fn bindingChain(flag: bool) -> i32 { let first: i32 = flag let second = first + 1 let third = second + 2 if 61 { return 0 } return third }
fn bindingClosure(flag: bool) -> i32 { let captured: i32 = flag let read = fn() -> i32 { return captured } if 62 { return 0 } return read() }
fn bindingArm(input: Left | Right | Empty, flag: bool) -> i32 { let armed: i32 = flag let chosen = match &input { Left { value } => armed _ => 0 } if 63 { } return chosen }
fn bindingPattern(flag: bool) -> i32 { let Token { absentField, .. } = Token { value: 1 } if 64 { } return absentField }
fn staticReader<T>(flag: bool) -> i32 { let reader: i32 = flag static if (fn() -> bool { return reader == 1 })() { return 1 } return 0 }
fn halt(code: bool) -> never { return halt(code) }
fn ownedPiped(flag: bool) -> i32 { let owned = Token { value: 9 } if 58 { flag |> halt } else { flag |> halt } let a = takeToken(move owned) let b = takeToken(move owned) return a + b }
fn ownedNever(flag: bool, stopped: never) -> i32 { let owned = Token { value: 10 } if 59 { stopped } else { stopped } let a = takeToken(move owned) let b = takeToken(move owned) return a + b }
fn deadAfterCall(flag: bool) -> i32 { let owned = Token { value: 11 } halt(flag) let a = takeToken(move owned) let b = takeToken(move owned) return a + b }
fn deadAfterBranch(flag: bool) -> i32 { let owned = Token { value: 12 } if flag { return 0 } else { return 1 } if flag { } let a = takeToken(move owned) let b = takeToken(move owned) return a + b }
fn deadAfterPipe(flag: bool) -> i32 { let owned = Token { value: 13 } flag |> halt let a = takeToken(move owned) let b = takeToken(move owned) return a + b }
fn deadAfterNever(flag: bool, stopped: never) -> i32 { let owned = Token { value: 14 } stopped let a = takeToken(move owned) let b = takeToken(move owned) return a + b }
fn deadAfterMatch(input: Left | Right | Empty) -> i32 { let owned = Token { value: 15 } match &input { Left { .. } => { return 1 } _ => { return 2 } } let a = takeToken(move owned) let b = takeToken(move owned) return a + b }
fn liveAfterLoop(flag: bool) -> i32 { let owned = Token { value: 17 } while true { } let a = takeToken(move owned) let b = takeToken(move owned) return a + b }
fn accepting(value: bool) -> bool { return value }
fn liveAfterShortCircuit(flag: bool) -> i32 { let owned = Token { value: 18 } let a = takeToken(move owned) if flag && accepting(halt(flag)) { } let b = takeToken(move owned) return a + b }
fn conditionBreaks(flag: bool, input: Left | Right | Empty) -> i32 { let mut owned = Token { value: 19 } while flag { while accepting(match &input { Left { .. } => { let z = takeToken(move owned) break } _ => false }) { } owned = Token { value: 20 } } let b = takeToken(move owned) return b }
fn conditionAlwaysBreaks(flag: bool, input: Left | Right | Empty) -> i32 { let mut owned = Token { value: 21 } while flag { while accepting(match &input { Left { .. } => { let z = takeToken(move owned) break } _ => { break } }) { } owned = Token { value: 22 } } let b = takeToken(move owned) return b }
fn conditionContinues(flag: bool, input: Left | Right | Empty) -> i32 { let mut owned = Token { value: 23 } while flag { while accepting(match &input { Left { .. } => { let z = takeToken(move owned) continue } _ => false }) { } owned = Token { value: 24 } } let b = takeToken(move owned) return b }
fn liveBeforeCall(flag: bool) -> i32 { let owned = Token { value: 16 } let a = takeToken(move owned) let b = takeToken(move owned) halt(flag) }
fn ownedFailedExits(flag: bool) -> i32 { let owned = Token { value: 8 } if 57 { return 0 } else { return 1 } let a = takeToken(move owned) let b = takeToken(move owned) return a + b }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let returned = run Semantic.demandBody(&mut store, &mut request, &id, b"returned")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let bound = run Semantic.demandBody(&mut store, &mut request, &id, b"bound")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let assigned = run Semantic.demandBody(&mut store, &mut request, &id, b"assigned")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let listed = run Semantic.demandBody(&mut store, &mut request, &id, b"listed")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let armResult = run Semantic.demandBody(&mut store, &mut request, &id, b"armResult")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let wrong = run Semantic.demandBody(&mut store, &mut request, &id, b"wrong")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let deferredOpen = run Semantic.demandBody(&mut store, &mut request, &id, b"deferredOpen")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(succeeded(&deferredOpen),
    "a float literal injects into a union of a float and a nominal member")
  let returnedInjections = run injectionCount(&returned) |> Effect.provideMut<Allocator>(&mut allocator)
  let boundInjections = run injectionCount(&bound) |> Effect.provideMut<Allocator>(&mut allocator)
  let assignedInjections = run injectionCount(&assigned) |> Effect.provideMut<Allocator>(&mut allocator)
  let listedInjections = run injectionCount(&listed) |> Effect.provideMut<Allocator>(&mut allocator)
  let armInjections = run injectionCount(&armResult) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(returnedInjections == usize.ONE, "a returned member injects once")
  run Testing.expect(boundInjections == usize.ONE, "a typed binding initializer injects once")
  run Testing.expect(assignedInjections == 2, "an initializer and an assignment each inject")
  run Testing.expect(listedInjections == 2, "each contextual array element injects")
  run Testing.expect(armInjections == 2, "each union-typed arm result injects")
  run Testing.expect(rejectsSpan(&wrong, RejectionCode.IncompatibleUnionConversion, text, "Token { value: 1 }", 0),
    "a non-member return is a mismatch at the returned expression")
  let missing = run Semantic.demandBody(&mut store, &mut request, &id, b"missing")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let duplicate = run Semantic.demandBody(&mut store, &mut request, &id, b"duplicate")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let afterUniversal = run Semantic.demandBody(&mut store, &mut request, &id, b"afterUniversal")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let covered = run Semantic.demandBody(&mut store, &mut request, &id, b"covered")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let foreign = run Semantic.demandBody(&mut store, &mut request, &id, b"foreign")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let incomplete = run Semantic.demandBody(&mut store, &mut request, &id, b"incomplete")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let refutable = run Semantic.demandBody(&mut store, &mut request, &id, b"refutable")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let guardType = run Semantic.demandBody(&mut store, &mut request, &id, b"guardType")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let nestedVariant = run Semantic.demandBody(&mut store, &mut request, &id, b"nestedVariant")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let nestedExhaustive = run Semantic.demandBody(&mut store, &mut request, &id, b"nestedExhaustive")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let notType = run Semantic.demandBody(&mut store, &mut request, &id, b"notType")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(succeeded(&nestedVariant) && succeeded(&nestedExhaustive),
    "a variant pattern of a nominal union member selects that member and tests its variant, and its variants cover it")
  run Testing.expect(rejectsSpan(&notType, RejectionCode.NotType, text, "helper", 1),
    "a record pattern naming a non-type over a structural union keeps its own diagnostic")
  run Testing.expect(
    rejectsSpan(&missing, RejectionCode.MissingUnionMember, text, "match &input { Left { value } => value Empty {} => 0 }", 0) &&
    rejectsSpan(&duplicate, RejectionCode.UnreachableMatchArm, text, "Left { value } => value", 1) &&
    rejectsSpan(&afterUniversal, RejectionCode.UnreachableMatchArm, text, "Empty {} => 2", 0) &&
    rejectsSpan(&covered, RejectionCode.UnreachableMatchArm, text, "_ => 4", 0) &&
    rejectsSpan(&foreign, RejectionCode.MatchMemberNotInScrutinee, text, "Token { value }", 0) &&
    rejectsSpan(&incomplete, RejectionCode.MissingPatternField, text, "Left {}", 0) &&
    rejectsSpan(&refutable, RejectionCode.MissingUnionMember, text, "match &holder { Holder { inner: Left { value } } => value }", 0) &&
    rejectsSpan(&guardType, RejectionCode.MatchGuardNotBool, text, "count", 1),
    "union coverage, foreign members, field lists, refutable subpatterns and guards report precise spans",
  )
  let recovered = run Semantic.demandBody(&mut store, &mut request, &id, b"recovered")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let recoveredCoverage = run Semantic.demandBody(&mut store, &mut request, &id, b"recoveredCoverage")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    ownDiagnosticCount(&recovered) == 2 &&
    reportsSpanAt(&recovered, usize.ZERO, RejectionCode.MatchMemberNotInScrutinee, text, "Token { value }", 1) &&
    reportsSpanAt(&recovered, usize.ONE, RejectionCode.UnknownStructField, text, "absent", 0),
    "a failed arm pattern is reported, the later arms are still checked, and the diagnostics keep source order",
  )
  run Testing.expect(
    ownDiagnosticCount(&recoveredCoverage) == usize.ONE &&
    reportsSpanAt(&recoveredCoverage, usize.ZERO, RejectionCode.MatchMemberNotInScrutinee, text, "Token { value }", 2),
    "a match with a failed arm reports no missing member",
  )
  let oneFailedArm = run Semantic.demandBody(&mut store, &mut request, &id, b"oneFailedArm")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    !succeeded(&oneFailedArm) && ownDiagnosticCount(&oneFailedArm) == usize.ONE &&
    reportsSpanAt(&oneFailedArm, usize.ZERO, RejectionCode.MatchMemberNotInScrutinee, text, "Token { value }", 3),
    "recovery never accepts a match: one failed arm among valid arms still rejects the body",
  )
  let statementsRecover = run Semantic.demandBody(&mut store, &mut request, &id, b"statementsRecover")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let statementsAfterBinding = run Semantic.demandBody(&mut store, &mut request, &id, b"statementsAfterBinding")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let statementsWithArms = run Semantic.demandBody(&mut store, &mut request, &id, b"statementsWithArms")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let statementsStatic = run Semantic.demandBody(&mut store, &mut request, &id, b"statementsStatic")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let ownedBefore = run Semantic.demandBody(&mut store, &mut request, &id, b"ownedBefore")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let ownedAfter = run Semantic.demandBody(&mut store, &mut request, &id, b"ownedAfter")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let ownedAcross = run Semantic.demandBody(&mut store, &mut request, &id, b"ownedAcross")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let ownedReplaced = run Semantic.demandBody(&mut store, &mut request, &id, b"ownedReplaced")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let ownedLoop = run Semantic.demandBody(&mut store, &mut request, &id, b"ownedLoop")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let ownedUnreached = run Semantic.demandBody(&mut store, &mut request, &id, b"ownedUnreached")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let ownedFailedReturn = run Semantic.demandBody(&mut store, &mut request, &id, b"ownedFailedReturn")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let ownedFailedExits = run Semantic.demandBody(&mut store, &mut request, &id, b"ownedFailedExits")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let bindingChain = run Semantic.demandBody(&mut store, &mut request, &id, b"bindingChain")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let bindingClosure = run Semantic.demandBody(&mut store, &mut request, &id, b"bindingClosure")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let bindingArm = run Semantic.demandBody(&mut store, &mut request, &id, b"bindingArm")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let bindingPattern = run Semantic.demandBody(&mut store, &mut request, &id, b"bindingPattern")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let staticReader = run Semantic.demandBody(&mut store, &mut request, &id, b"staticReader")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let deadAfterCall = run Semantic.demandBody(&mut store, &mut request, &id, b"deadAfterCall")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let deadAfterBranch = run Semantic.demandBody(&mut store, &mut request, &id, b"deadAfterBranch")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let deadAfterPipe = run Semantic.demandBody(&mut store, &mut request, &id, b"deadAfterPipe")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let deadAfterNever = run Semantic.demandBody(&mut store, &mut request, &id, b"deadAfterNever")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let deadAfterMatch = run Semantic.demandBody(&mut store, &mut request, &id, b"deadAfterMatch")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let liveAfterLoop = run Semantic.demandBody(&mut store, &mut request, &id, b"liveAfterLoop")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let liveAfterShortCircuit = run Semantic.demandBody(&mut store, &mut request, &id, b"liveAfterShortCircuit")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let conditionBreaks = run Semantic.demandBody(&mut store, &mut request, &id, b"conditionBreaks")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let conditionAlwaysBreaks = run Semantic.demandBody(&mut store, &mut request, &id, b"conditionAlwaysBreaks")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let conditionContinues = run Semantic.demandBody(&mut store, &mut request, &id, b"conditionContinues")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let liveBeforeCall = run Semantic.demandBody(&mut store, &mut request, &id, b"liveBeforeCall")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let ownedPiped = run Semantic.demandBody(&mut store, &mut request, &id, b"ownedPiped")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let ownedNever = run Semantic.demandBody(&mut store, &mut request, &id, b"ownedNever")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    ownDiagnosticCount(&statementsRecover) == 3 &&
    reportsSpanAt(&statementsRecover, usize.ZERO, RejectionCode.ConditionNotBool, text, "41", 0) &&
    reportsSpanAt(&statementsRecover, usize.ONE, RejectionCode.ConditionNotBool, text, "42", 0) &&
    reportsSpanAt(&statementsRecover, 2, RejectionCode.ReturnTypeMismatch, text, "flag", 1),
    "a statement that binds nothing and fails does not stop the statements after it",
  )
  run Testing.expect(
    ownDiagnosticCount(&statementsAfterBinding) == 3 &&
    reportsSpanAt(&statementsAfterBinding, usize.ZERO, RejectionCode.ConditionNotBool, text, "43", 0) &&
    reportsSpanAt(&statementsAfterBinding, usize.ONE, RejectionCode.AssignmentTypeMismatch, text, "flag", 3) &&
    reportsSpanAt(&statementsAfterBinding, 2, RejectionCode.ConditionNotBool, text, "44", 0),
    "the statements after a failed binding are still checked, and a read of its name reports nothing",
  )
  run Testing.expect(
    ownDiagnosticCount(&statementsWithArms) == 3 &&
    reportsSpanAt(&statementsWithArms, usize.ZERO, RejectionCode.ConditionNotBool, text, "45", 0) &&
    reportsSpanAt(&statementsWithArms, usize.ONE, RejectionCode.MatchMemberNotInScrutinee, text, "Token { value }", 4) &&
    reportsSpanAt(&statementsWithArms, 2, RejectionCode.UnknownStructField, text, "missed", 0),
    "a failed statement's diagnostic precedes those a later statement's match recovers, in source order",
  )
  run Testing.expect(
    ownDiagnosticCount(&statementsStatic) == usize.ONE &&
    reportsSpanAt(&statementsStatic, usize.ZERO, RejectionCode.ConditionNotBool, text, "46", 0),
    "a static body stops at its first failed statement, since later statements evaluate the checked prefix",
  )
  run Testing.expect(
    ownDiagnosticCount(&ownedBefore) == 2 &&
    reportsSpanAt(&ownedBefore, usize.ZERO, RejectionCode.UseAfterMove, text, "move owned", 1) &&
    reportsSpanAt(&ownedBefore, usize.ONE, RejectionCode.ConditionNotBool, text, "51", 0),
    "a use after move before a recovered statement joins its rejection in source order",
  )
  run Testing.expect(
    ownDiagnosticCount(&ownedAfter) == 2 &&
    reportsSpanAt(&ownedAfter, usize.ZERO, RejectionCode.ConditionNotBool, text, "52", 0) &&
    reportsSpanAt(&ownedAfter, usize.ONE, RejectionCode.UseAfterMove, text, "move owned", 3),
    "a use after move after a recovered statement joins its rejection in source order",
  )
  run Testing.expect(
    ownDiagnosticCount(&ownedAcross) == usize.ONE &&
    reportsSpanAt(&ownedAcross, usize.ZERO, RejectionCode.ConditionNotBool, text, "53", 0),
    "a move and a use on either side of a recovered statement report nothing: its effects are unknown",
  )
  run Testing.expect(
    ownDiagnosticCount(&ownedReplaced) == usize.ONE &&
    reportsSpanAt(&ownedReplaced, usize.ZERO, RejectionCode.AssignmentTypeMismatch, text, "54", 0),
    "a failed replacement never makes the use after it a use after move",
  )
  run Testing.expect(
    ownDiagnosticCount(&ownedLoop) == usize.ONE &&
    reportsSpanAt(&ownedLoop, usize.ZERO, RejectionCode.ConditionNotBool, text, "55", 0),
    "a failed statement in a loop body fails the whole loop, and no path crosses it",
  )
  run Testing.expect(
    ownDiagnosticCount(&ownedUnreached) == usize.ONE &&
    reportsSpanAt(&ownedUnreached, usize.ZERO, RejectionCode.ConditionNotBool, text, "56", 0),
    "statements after a return stay unreached in a recovered body: resuming after a recovered statement adds no path",
  )
  run Testing.expect(
    ownDiagnosticCount(&ownedFailedReturn) == usize.ONE &&
    reportsSpanAt(&ownedFailedReturn, usize.ZERO, RejectionCode.ReturnTypeMismatch, text, "flag", 13),
    "statements after a failed return stay unreached",
  )
  run Testing.expect(
    ownDiagnosticCount(&ownedFailedExits) == usize.ONE &&
    reportsSpanAt(&ownedFailedExits, usize.ZERO, RejectionCode.ConditionNotBool, text, "57", 0),
    "statements after a failed statement that may exit on every path stay unreached",
  )
  run Testing.expect(
    ownDiagnosticCount(&bindingChain) == 2 &&
    reportsSpanAt(&bindingChain, usize.ZERO, RejectionCode.AssignmentTypeMismatch, text, "flag", 15) &&
    reportsSpanAt(&bindingChain, usize.ONE, RejectionCode.ConditionNotBool, text, "61", 0),
    "bindings that read a failed binding are unavailable in turn, and only independent failures are reported",
  )
  run Testing.expect(
    ownDiagnosticCount(&bindingClosure) == 2 &&
    reportsSpanAt(&bindingClosure, usize.ZERO, RejectionCode.AssignmentTypeMismatch, text, "flag", 17) &&
    reportsSpanAt(&bindingClosure, usize.ONE, RejectionCode.ConditionNotBool, text, "62", 0),
    "a callable literal that reads a failed binding reports nothing of its own",
  )
  run Testing.expect(
    ownDiagnosticCount(&bindingArm) == 2 &&
    reportsSpanAt(&bindingArm, usize.ZERO, RejectionCode.AssignmentTypeMismatch, text, "flag", 19) &&
    reportsSpanAt(&bindingArm, usize.ONE, RejectionCode.ConditionNotBool, text, "63", 0),
    "a recovered match arm that reads a failed binding reports nothing of its own",
  )
  run Testing.expect(
    ownDiagnosticCount(&bindingPattern) == 2 &&
    reportsSpanAt(&bindingPattern, usize.ONE, RejectionCode.ConditionNotBool, text, "64", 1),
    "a name bound by a failed destructuring binding is unavailable after it",
  )
  run Testing.expect(
    ownDiagnosticCount(&staticReader) == 2 &&
    reportsSpanAt(&staticReader, usize.ZERO, RejectionCode.AssignmentTypeMismatch, text, "flag", 22),
    "a static root inside a recovered body never reads that body's failed statements",
  )
  run Testing.expect(
    noUnavailableRead(&staticReader) && noUnavailableRead(&statementsAfterBinding) && noUnavailableRead(&bindingChain) && noUnavailableRead(&bindingClosure)
      && noUnavailableRead(&bindingArm) && noUnavailableRead(&bindingPattern),
    "no rejection lists a read of an unavailable binding",
  )
  run Testing.expect(
    Shared<Result<Answer, NoRejection>>.with<bool>(&deadAfterCall, bodyAnswerIsTyped)
      && Shared<Result<Answer, NoRejection>>.with<bool>(&deadAfterBranch, bodyAnswerIsTyped)
      && Shared<Result<Answer, NoRejection>>.with<bool>(&deadAfterPipe, bodyAnswerIsTyped)
      && Shared<Result<Answer, NoRejection>>.with<bool>(&deadAfterNever, bodyAnswerIsTyped)
      && Shared<Result<Answer, NoRejection>>.with<bool>(&deadAfterMatch, bodyAnswerIsTyped),
    "code after a call, pipe or value of type `never`, or after a branch or match none of whose arms completes, is unreachable and never borrow-checked",
  )
  run Testing.expect(
    ownDiagnosticCount(&liveAfterLoop) == usize.ONE &&
    reportsSpanAt(&liveAfterLoop, usize.ZERO, RejectionCode.UseAfterMove, text, "move owned", 28),
    "a loop that can leave through its condition completes, as in the bootstrap, even when the condition is `true`",
  )
  run Testing.expect(
    ownDiagnosticCount(&liveAfterShortCircuit) == usize.ONE &&
    reportsSpanAt(&liveAfterShortCircuit, usize.ZERO, RejectionCode.UseAfterMove, text, "move owned", 30),
    "a `never` right operand of `&&` leaves the path that skips it, so code after it is still checked",
  )
  run Testing.expect(
    ownDiagnosticCount(&conditionBreaks) == usize.ONE &&
    reportsSpanAt(&conditionBreaks, usize.ZERO, RejectionCode.UseAfterMove, text, "move owned", 32) &&
    ownDiagnosticCount(&conditionAlwaysBreaks) == usize.ONE &&
    reportsSpanAt(&conditionAlwaysBreaks, usize.ZERO, RejectionCode.UseAfterMove, text, "move owned", 34),
    "a `break` in a loop condition leaves the enclosing loop, so the move before it reaches the use after that loop",
  )
  run Testing.expect(
    ownDiagnosticCount(&conditionContinues) == usize.ONE &&
    reportsSpanAt(&conditionContinues, usize.ZERO, RejectionCode.IncompatibleLoopHeader, text, "while flag { while accepting(match &input { Left { .. } => { let z = takeToken(move owned) continue } _ => false }) { } owned = Token { value: 24 } }", 0),
    "a `continue` in a loop condition repeats the enclosing loop, which reports its incompatible header",
  )
  run Testing.expect(
    ownDiagnosticCount(&liveBeforeCall) == usize.ONE &&
    reportsSpanAt(&liveBeforeCall, usize.ZERO, RejectionCode.UseAfterMove, text, "move owned", 38),
    "a use after move before a call of type `never` is still reported",
  )
  run Testing.expect(
    ownDiagnosticCount(&ownedPiped) == usize.ONE &&
    reportsSpanAt(&ownedPiped, usize.ZERO, RejectionCode.ConditionNotBool, text, "58", 0),
    "statements after a failed statement that pipes into a `never` function stay unreached",
  )
  run Testing.expect(
    ownDiagnosticCount(&ownedNever) == usize.ONE &&
    reportsSpanAt(&ownedNever, usize.ZERO, RejectionCode.ConditionNotBool, text, "59", 0),
    "statements after a failed statement that names a `never` value stay unreached",
  )
  return ()
}

// A nominal application keeps its own identity while its arguments are open, so a generic body
// injects into and matches a union of generic records, as `Vector<T>` storage does; each instance
// maps the authored member to its canonical tag.
test effect fn genericRecordUnionsInjectAndMatchInGenericBodies() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("generic-record-union.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
struct Cell<T> { value: T }
struct Gone {}
struct Holder<T> { state: Cell<T> | Gone }
fn fresh<T>() -> Holder<T> { return Holder<T> { state: Gone {} } }
fn fill<T>(holder: &mut Holder<T>, value: T) -> () {
  let previous = Intrinsic.replace(holder.state, Cell<T> { value: move value })
  drop previous
  return ()
}
fn take<T>(holder: Holder<T>, fallback: T) -> T {
  return match move holder.state {
    Cell<T> { value } => move value
    Gone gone => move fallback
  }
}
pub fn main() -> i32 {
  let mut holder = fresh<i32>()
  fill<i32>(&mut holder, 42)
  return take<i32>(move holder, 0)
}
"""
  let mut store = run applicationSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.forApplication(ModuleId.copy(&id))
  let fresh = run Semantic.demandBody(&mut store, &mut request, &id, b"fresh")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let fill = run Semantic.demandBody(&mut store, &mut request, &id, b"fill")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let take = run Semantic.demandBody(&mut store, &mut request, &id, b"take")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let empty = run injectionCount(&fresh) |> Effect.provideMut<Allocator>(&mut allocator)
  let filled = run injectionCount(&fill) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(empty == usize.ONE && filled == usize.ONE && succeeded(&take),
    "a generic body injects a record into, and matches, a union of generic record applications")
  let built = run buildApplication(&mut store, &mut request, staticClosureNodes)
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(match &built { BackendBuild.Module {..} => true _ => false },
    "each closed instance lowers the injections, the replacement and the tag match")
  return ()
}

// A `while` loop turns the move-consumed `if let` subject into a flagged Maybe owner. Every exit
// drops that union under its flag through its own glue; it is never expanded into a member.
test effect fn loopExitsDropConsumedUnionSubjectUnderItsFlag() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run loopExitSubjectClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}
effect fn loopExitSubjectClaims() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("loop-exit-consumed-union.silk")
  let text = """
struct Token { value: i32 }
impl Intrinsic.Drop for Token { fn drop(self: &mut Token) -> () { return () } }
union Kind { Pair {left: Token, right: Token}, Plain {value: i32} }
fn spread(kind: Kind, count: i32) -> i32 {
  if let Kind.Pair {left, right} = move kind {
    let mut at = 0
    while at < count { at = at + left.value }
    drop move right
    return at
  }
  return 0
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let answer = run Semantic.demandMir(&mut store, &mut request, &id, b"spread")
  run Testing.expect(succeeded(&answer) && flaggedSubjectDrop(&store, &answer),
    "the exit after the loop drops the consumed subject only under its own drop flag")
}

// Whether a whole drop of parameter 0 runs as the then-block of a branch on that parameter's flag.
fn flaggedSubjectDrop(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>) -> bool {
  let selected = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(answer, selectedMirIndex)
  let index = match move selected { Option<usize>.Some {value} => value _ => { return false } }
  let function = match move Semantic.mirAt(store, index) { Option<&MirFunction>.Some {value} => value _ => { return false } }
  let blocks = Vector<MirBlock>.asSlice(&function.blocks)
  let locals = Vector<MirLocal>.asSlice(&function.locals)
  let mut subject = usize.MAX
  let mut at = usize.ZERO
  while at < locals.length {
    if let MirLocalKind.Parameter {index: parameter} = &locals[at].kind {
      if parameter == usize.ZERO { subject = at }
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < blocks.length {
    if let MirTerminator.Branch {condition: MirOperand.Copy {place}, thenBlock, ..} = &blocks[at].terminator {
      let mut flagged = false
      if place.local < locals.length {
        if let MirLocalKind.DropFlag {local, path} = &locals[place.local].kind {
          flagged = local == subject && Vector<MirProjection>.length(&path) == usize.ZERO
        }
      }
      if flagged && thenBlock < blocks.length {
        let statements = Vector<MirStatement>.asSlice(&blocks[thenBlock].statements)
        let mut position = usize.ZERO
        while position < statements.length {
          if let MirStatement.Drop {destination, ..} = &statements[position] {
            if destination.local == subject && Vector<MirProjection>.length(&destination.projections) == usize.ZERO { return true }
          }
          position = position + usize.ONE
        }
      }
    }
    at = at + usize.ONE
  }
  return false
}

// OWN-004, OWN-008: a `match place` arm that moves a payload field partitions the union while
// another arm keeps it compact. The join keeps one Alternatives component: the union's own flag
// says whether it is whole, and each joined child has a flag. When every arm partitions it there
// is no compact arrival, so only the child flags exist.
test effect fn placeMatchJoinsCompactAndPartitionedUnionUnderFlags() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run alternativesJoinClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}
effect fn alternativesJoinClaims() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("place-match-alternatives-join.silk")
  let text = """
struct Token { value: i32 }
impl Intrinsic.Drop for Token { fn drop(self: &mut Token) -> () { return () } }
union Packet { Empty, Ready { left: Token, right: Token } }
union Parcel { Single { only: Token }, Ready { left: Token, right: Token } }
fn joined(packet: Packet) -> () {
  match place packet {
    Packet.Ready { left, .. } => { drop move left }
    Packet.Empty => {}
  }
  return ()
}
fn partitioned(parcel: Parcel) -> () {
  match place parcel {
    Parcel.Ready { left, .. } => { drop move left }
    Parcel.Single { only } => { drop move only }
  }
  return ()
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let joined = run Semantic.demandMir(&mut store, &mut request, &id, b"joined")
  let partitioned = run Semantic.demandMir(&mut store, &mut request, &id, b"partitioned")
  run Testing.expect(succeeded(&joined) && flagDepths(&store, &joined, usize.ZERO) == usize.ONE &&
    flagDepths(&store, &joined, usize.ONE) == 2,
    "a compact arm and a partitioning arm join under the union's whole flag and its children's flags")
  run Testing.expect(succeeded(&partitioned) && flagDepths(&store, &partitioned, usize.ZERO) == usize.ZERO &&
    flagDepths(&store, &partitioned, usize.ONE) == 3,
    "arms that each partition the union join under child flags alone")
}

// The drop-flag locals of a MIR function whose owner path has `depth` projections.
fn flagDepths(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>, depth: usize) -> usize {
  let selected = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(answer, selectedMirIndex)
  let index = match move selected { Option<usize>.Some {value} => value _ => { return usize.MAX } }
  let function = match move Semantic.mirAt(store, index) { Option<&MirFunction>.Some {value} => value _ => { return usize.MAX } }
  let locals = Vector<MirLocal>.asSlice(&function.locals)
  let mut count = usize.ZERO
  let mut at = usize.ZERO
  while at < locals.length {
    if let MirLocalKind.DropFlag {path, ..} = &locals[at].kind {
      if Vector<MirProjection>.length(&path) == depth { count = count + usize.ONE }
    }
    at = at + usize.ONE
  }
  return count
}

// UNION-001: substitution may collapse a written failure row, so `Cycle | E | Exhausted` stores
// two members for `E = Exhausted` and three flattened ones for `E = Cycle | Other | Exhausted`.
// Injecting `Cycle` needs only its own storage tag, not an injective map of every written member.
test effect fn genericUnionInjectionSurvivesCollapsedMembers() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run genericUnionInjectionClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}
effect fn genericUnionInjectionClaims() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("generic-union-injection-collapse.silk")
  let text = """
struct Cycle {}
struct Other {}
struct Exhausted {}
effect fn guard<E>(active: bool) -> i32 ! Cycle | E | Exhausted {
  if active { fail Cycle {} }
  return 1
}
effect fn narrow(active: bool) -> i32 ! Cycle | Exhausted { return run guard<Exhausted>(active) }
effect fn wide(active: bool) -> i32 ! Cycle | Other | Exhausted { return run guard<Cycle | Other | Exhausted>(active) }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let narrow = run Semantic.demandBody(&mut store, &mut request, &id, b"narrow")
  let wide = run Semantic.demandBody(&mut store, &mut request, &id, b"wide")
  let mut collapsed = false
  let mut flattened = false
  let narrowApplication = run directApplicationAt(&narrow, usize.ZERO)
  if let Option<SpecializationApplication>.Some {value} = move narrowApplication {
    let mir = run Semantic.demandApplicationMir(&mut store, &mut request, &value)
    collapsed = run injectsUnderStorageTag(&store, &mir)
  }
  let wideApplication = run directApplicationAt(&wide, usize.ZERO)
  if let Option<SpecializationApplication>.Some {value} = move wideApplication {
    let mir = run Semantic.demandApplicationMir(&mut store, &mut request, &value)
    flattened = run injectsUnderStorageTag(&store, &mir)
  }
  run Testing.expect(collapsed && flattened,
    "each closed instance injects Cycle under its own tag when other written members collapse or flatten")
}

// UNION-001: a narrower structural union is stored in a wider one, as a field or a plain return,
// by re-injecting each of its members under that member's canonical tag in the wider union.
test effect fn narrowerUnionWidensIntoFieldsAndReturns() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run unionWideningClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}
effect fn unionWideningClaims() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("union-widening.silk")
  let text = """
struct Success<A> { value: A }
struct Failure<E> { error: E }
struct Cancelled {}
struct Outcome<A, E> { value: Success<A> | Failure<E> | Cancelled }
fn field<A, E>(selected: Success<A> | Failure<E>) -> Outcome<A, E> { return Outcome<A, E> { value: move selected } }
fn closedField() -> Outcome<i32, bool> { return field<i32, bool>(Success<i32> { value: 1 }) }
fn plain(selected: Success<i32> | Cancelled) -> Success<i32> | Failure<bool> | Cancelled { return move selected }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let plainBody = run Semantic.demandBody(&mut store, &mut request, &id, b"plain")
  let fieldBody = run Semantic.demandBody(&mut store, &mut request, &id, b"field")
  run Testing.expect((run wideningCount(&plainBody)) == usize.ONE && (run wideningCount(&fieldBody)) == usize.ONE,
    "a narrower union is widened once for a plain return and once for a struct field")
  let plainMir = run Semantic.demandMir(&mut store, &mut request, &id, b"plain")
  let plainWidened = run widensUnderStorageTag(&store, &plainMir)
  let closed = run Semantic.demandBody(&mut store, &mut request, &id, b"closedField")
  let mut fieldWidened = usize.ZERO
  let application = run directApplicationAt(&closed, usize.ZERO)
  if let Option<SpecializationApplication>.Some {value} = move application {
    let mir = run Semantic.demandApplicationMir(&mut store, &mut request, &value)
    fieldWidened = run widensUnderStorageTag(&store, &mir)
  }
  run Testing.expect(plainWidened == 2 && fieldWidened == 2,
    "each member of the narrower union is re-injected under its own canonical tag in the wider union")
}

effect fn wideningCount(answer: &Shared<Result<Answer, NoRejection>>) -> usize ! OutOfMemoryError ? &mut Allocator {
  let selected = Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(answer, checkedBody)
  return match move selected {
    Option<Shared<TypedBody>>.Some {value} => Shared<TypedBody>.with<usize>(&value, unionWidenings)
    Option<Shared<TypedBody>>.None => usize.MAX
  }
}

fn unionWidenings(body: &TypedBody) -> usize {
  let nodes = TypedBody.nodeSlice(body)
  let mut found = usize.ZERO
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {form: BodyExpression.UnionWiden {..}, ..} = &nodes[at].kind { found = found + usize.ONE }
    at = at + usize.ONE
  }
  return found
}

// How many Injects in the selected MIR store a projected union payload under the tag its member
// type has in the destination union; zero when any such Inject uses another tag.
effect fn widensUnderStorageTag(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>) -> usize
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let selected = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(answer, selectedMirIndex)
  let index = match move selected { Option<usize>.Some {value} => value _ => { return usize.ZERO } }
  let function = match move Semantic.mirAt(store, index) { Option<&MirFunction>.Some {value} => value _ => { return usize.ZERO } }
  let blocks = Vector<MirBlock>.asSlice(&function.blocks)
  let locals = Vector<MirLocal>.asSlice(&function.locals)
  let mut count = usize.ZERO
  let mut at = usize.ZERO
  while at < blocks.length {
    let statements = Vector<MirStatement>.asSlice(&blocks[at].statements)
    let mut position = usize.ZERO
    while position < statements.length {
      if let MirStatement.Assign {destination, value: MirRvalue.Inject {tag, value: MirOperand.Move {place}}, ..} = &statements[position] {
        let projections = Vector<MirProjection>.asSlice(&place.projections)
        if projections.length == usize.ONE {
          if let MirProjection.Payload {ty, ..} = &projections[usize.ZERO] {
            if destination.local >= locals.length { return usize.ZERO }
            let members = match move run Type.canonicalUnionMembers(&locals[destination.local].ty) {
              Option<Vector<Shared<Type>>>.Some {value} => move value
              _ => { return usize.ZERO }
            }
            let listed = Vector<Shared<Type>>.asSlice(&members)
            if tag >= listed.length || !(run Type.runtimeEqualsShared(&listed[tag], &ty)) { return usize.ZERO }
            count = count + usize.ONE
          }
        }
      }
      position = position + usize.ONE
    }
    at = at + usize.ONE
  }
  return count
}

// Every Inject in the selected MIR stores its operand's type under that type's canonical tag.
effect fn injectsUnderStorageTag(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>) -> bool
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let selected = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(answer, selectedMirIndex)
  let index = match move selected { Option<usize>.Some {value} => value _ => { return false } }
  let function = match move Semantic.mirAt(store, index) { Option<&MirFunction>.Some {value} => value _ => { return false } }
  let blocks = Vector<MirBlock>.asSlice(&function.blocks)
  let locals = Vector<MirLocal>.asSlice(&function.locals)
  let mut count = usize.ZERO
  let mut at = usize.ZERO
  while at < blocks.length {
    let statements = Vector<MirStatement>.asSlice(&blocks[at].statements)
    let mut position = usize.ZERO
    while position < statements.length {
      if let MirStatement.Assign {destination, value: MirRvalue.Inject {tag, value: MirOperand.Move {place}}, ..} = &statements[position] {
        if destination.local >= locals.length || place.local >= locals.length { return false }
        let members = match move run Type.canonicalUnionMembers(&locals[destination.local].ty) {
          Option<Vector<Shared<Type>>>.Some {value} => move value
          _ => { return false }
        }
        let listed = Vector<Shared<Type>>.asSlice(&members)
        if tag >= listed.length || !(run Type.runtimeEqualsShared(&listed[tag], &locals[place.local].ty)) { return false }
        count = count + usize.ONE
      }
      position = position + usize.ONE
    }
    at = at + usize.ONE
  }
  return count != usize.ZERO
}

fn variantConstructions(body: &TypedBody) -> usize {
  let nodes = TypedBody.nodeSlice(body)
  let mut encoded = usize.ZERO
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {form: BodyExpression.VariantConstruct {tag, fields}, ..} = &nodes[at].kind {
      encoded = encoded * 10 + tag * 3 + Vector<BodyAggregateField>.length(&fields) + usize.ONE
    }
    at = at + usize.ONE
  }
  return encoded
}

fn matchTagCount(body: &TypedBody) -> usize {
  let nodes = TypedBody.nodeSlice(body)
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {form: BodyExpression.Match {tags, ..}, ..} = &nodes[at].kind { return tags }
    at = at + usize.ONE
  }
  return usize.MAX
}

fn matchArmCount(body: &TypedBody) -> usize {
  let nodes = TypedBody.nodeSlice(body)
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {form: BodyExpression.Match {arms, ..}, ..} = &nodes[at].kind {
      return Vector<BodyMatchArm>.length(&arms)
    }
    at = at + usize.ONE
  }
  return usize.MAX
}

fn variantArmTag(body: &TypedBody, arm: usize) -> usize {
  let nodes = TypedBody.nodeSlice(body)
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {form: BodyExpression.Match {arms, ..}, ..} = &nodes[at].kind {
      let written = Vector<BodyMatchArm>.asSlice(&arms)
      if arm < written.length {
        if let BodyPattern.Variant {tag} = &written[arm].pattern { return tag }
      }
      return usize.MAX
    }
    at = at + usize.ONE
  }
  return usize.MAX
}

fn variantBindings(body: &TypedBody, tag: usize, field: usize) -> usize {
  let nodes = TypedBody.nodeSlice(body)
  let mut found = usize.ZERO
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {form: BodyExpression.PatternBinding {path, ..}, ..} = &nodes[at].kind {
      let steps = Vector<BodyPlaceStep>.asSlice(&path)
      if steps.length == usize.ONE {
        if let BodyPlaceStep.VariantField {tag: selected, field: index} = &steps[usize.ZERO] {
          if selected == tag && index == field { found = found + usize.ONE }
        }
      }
    }
    at = at + usize.ONE
  }
  return found
}

fn variantsLayout(layout: &BackendLayout) -> bool {
  if let LayoutStorage.Variants {tagSize, payloadOffset, ..} = &layout.storage {
    let height = BackendLayout.variantField(layout, usize.ONE, usize.ONE)
    let radius = BackendLayout.variantField(layout, usize.ZERO, usize.ZERO)
    let mut offsets = false
    if let Option<LayoutField>.Some {value: second} = &height {
      if let Option<LayoutField>.Some {value: first} = &radius { offsets = second.offset == 16 && first.offset == 8 }
    }
    return tagSize == usize.ONE && payloadOffset == 8 && layout.size == 24 && layout.alignment == 8 && offsets
  }
  return false
}

fn genericUnionLayout(layout: &BackendLayout, size: usize, alignment: usize, payloadOffset: usize) -> bool {
  if let LayoutStorage.Variants {tagSize, payloadOffset: offset, ..} = &layout.storage {
    return tagSize == usize.ONE && offset == payloadOffset && layout.size == size
      && layout.alignment == alignment
  }
  return false
}

// The empty variant is tag zero and the one-field payload is tag one in both ordinary declarations.
fn sameOptionTopology(left: &BackendLayout, right: &BackendLayout) -> bool {
  if left.size != right.size || left.alignment != right.alignment || left.abi != right.abi
    || left.abi != LayoutAbi.Indirect { return false }
  if let LayoutStorage.Variants {variants: first, tagSize: firstTag, payloadOffset: firstPayload} = &left.storage {
    if let LayoutStorage.Variants {variants: second, tagSize: secondTag, payloadOffset: secondPayload} = &right.storage {
      let a = Vector<Vector<LayoutField>>.asSlice(&first)
      let b = Vector<Vector<LayoutField>>.asSlice(&second)
      if a.length != 2 || b.length != 2 || firstTag != usize.ONE || firstTag != secondTag
        || firstPayload != secondPayload || Vector<LayoutField>.length(&a[usize.ZERO]) != usize.ZERO
        || Vector<LayoutField>.length(&b[usize.ZERO]) != usize.ZERO { return false }
      let firstFields = Vector<LayoutField>.asSlice(&a[usize.ONE])
      let secondFields = Vector<LayoutField>.asSlice(&b[usize.ONE])
      return firstFields.length == usize.ONE && secondFields.length == usize.ONE
        && firstFields[usize.ZERO].offset == secondFields[usize.ZERO].offset
    }
  }
  return false
}

fn sameSharedOptionTopology(left: &BackendLayout, right: &Shared<BackendLayout>) -> bool {
  return Shared<BackendLayout>.with<bool>(right, fn(value: &BackendLayout) -> bool {
    return sameOptionTopology(left, value)
  })
}

effect fn optionLayoutMatches(
  store: &Semantic, left: &Shared<Result<Answer, NoRejection>>, right: &Shared<Result<Answer, NoRejection>>,
  size: usize, alignment: usize, payload: usize,
) -> bool ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let firstIndex = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(left, selectedLayoutIndex)
  let secondIndex = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(right, selectedLayoutIndex)
  if let Option<usize>.Some {value: a} = move firstIndex {
    if let Option<usize>.Some {value: b} = move secondIndex {
      if let Option<Shared<BackendLayout>>.Some {value: actual} = move Semantic.layoutAt(store, a) {
        if let Option<Shared<BackendLayout>>.Some {value: custom} = move Semantic.layoutAt(store, b) {
          let topology = Shared<BackendLayout>.with<bool>(&actual, fn(first: &BackendLayout) -> bool {
            return genericUnionLayout(first, size, alignment, payload)
              && sameSharedOptionTopology(first, &custom)
          })
          let actualField = Shared<BackendLayout>.with<Option<LayoutField>>(&actual, fn(layout: &BackendLayout) -> Option<LayoutField> {
            return BackendLayout.variantField(layout, usize.ONE, usize.ZERO)
          })
          let customField = Shared<BackendLayout>.with<Option<LayoutField>>(&custom, fn(layout: &BackendLayout) -> Option<LayoutField> {
            return BackendLayout.variantField(layout, usize.ONE, usize.ZERO)
          })
          if let Option<LayoutField>.Some {value: x} = move actualField {
            if let Option<LayoutField>.Some {value: y} = move customField {
              return topology && x.offset == payload && y.offset == payload && run Type.equalsShared(&x.ty, &y.ty)
            }
          }
        }
      }
    }
  }
  return false
}

test effect fn genericOptionLibraryAndUserUnionHaveIdenticalLayout() -> ()
! FileError | HostInputError | InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  // Program.runTest preserves repository-root CWD. Read the actual library through its ordinary
  // native provider, then publish all bytes under the same ModuleId an import normally resolves.
  let cwd = run NativeHostInput.workingDirectory() |> Effect.provideMut<Allocator>(&mut allocator)
  let mut files = run OsFileSystem.make(Bytes.asSlice(&cwd)) |> Effect.provideMut<Allocator>(&mut allocator)
  let path = run Path.fromBytes(b"/packages/compiler/stdlib/silk/option.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let bytes = run FileSystem.readFile(&path) |> Effect.provideMut<FileSystem>(&mut files) |> Effect.provideMut<Allocator>(&mut allocator)
  let librarySource = Option<Bytes>.some(move bytes)
  let id = run module("generic-option-layout.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let library = run module("silk/option.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let source = run present("""
import silk.option { Option }
struct Token { value: i64 }
union Maybe<T> { None, Some { value: T } }
fn instances(actual: Option<i32>, custom: Maybe<i32>, actualToken: Option<Token>, customToken: Maybe<Token>) -> i32 { return 0 }
""") |> Effect.provideMut<Allocator>(&mut allocator)
  let entryRevision = run Revision.publish(&Revision.make(), &id, &source) |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&entryRevision, &library, &librarySource) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut store = Semantic.traced(move revision, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu), Option<FinalProfile>.none())
  let mut request = Request.make()
  let body = run Semantic.demandBody(&mut store, &mut request, &id, b"instances") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let actual = match move bodyLocalType(&body, usize.ZERO) {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => { run Testing.expect(false, "actual stdlib Option<i32> resolves through ordinary source publication") return () }
  }
  let custom = match move bodyLocalType(&body, usize.ONE) {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => { run Testing.expect(false, "the user-defined Maybe<i32> is a separate complete nominal instance") return () }
  }
  let actualToken = match move bodyLocalType(&body, 2) {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => { run Testing.expect(false, "actual stdlib Option<Token> retains its nominal payload") return () }
  }
  let customToken = match move bodyLocalType(&body, 3) {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => { run Testing.expect(false, "the user-defined Maybe<Token> retains the same nominal payload") return () }
  }
  run Testing.expect(!(run Type.equalsShared(&actual, &custom) |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator))
    && !(run Type.equalsShared(&actualToken, &customToken) |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)),
    "library Option and user Maybe are distinct declarations, not aliases of one privileged instance")
  let a = run Semantic.demandLayout(&mut store, &mut request, &id, &actual) |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let b = run Semantic.demandLayout(&mut store, &mut request, &id, &custom) |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let c = run Semantic.demandLayout(&mut store, &mut request, &id, &actualToken) |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let d = run Semantic.demandLayout(&mut store, &mut request, &id, &customToken) |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(run optionLayoutMatches(&store, &a, &b, 8, 4, 4) |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator),
    "Option<i32> and Maybe<i32> agree on size, alignment, ABI, tag order/width and payload field type/offset")
  run Testing.expect(run optionLayoutMatches(&store, &c, &d, 16, 8, 8) |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator),
    "Option<Token> and Maybe<Token> use the same substituted nominal-payload layout without library privilege")
  return ()
}

test effect fn callerPreconditionStorageOperationsNeedAnUnsafeBoundary() -> ()
! FileError | HostInputError | InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  // The actual library declares `RawBuffer.read` as `pub unsafe fn`; publish it under its ordinary
  // module id so the entry resolves the import exactly as a program would.
  let cwd = run NativeHostInput.workingDirectory() |> Effect.provideMut<Allocator>(&mut allocator)
  let mut files = run OsFileSystem.make(Bytes.asSlice(&cwd)) |> Effect.provideMut<Allocator>(&mut allocator)
  let path = run Path.fromBytes(b"/packages/compiler/stdlib/silk/raw_buffer.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let bytes = run FileSystem.readFile(&path) |> Effect.provideMut<FileSystem>(&mut files) |> Effect.provideMut<Allocator>(&mut allocator)
  let librarySource = Option<Bytes>.some(move bytes)
  // `RawBuffer.read` bounds its element on `Copy`, which the library imports from `silk.ownership`.
  let ownershipPath = run Path.fromBytes(b"/packages/compiler/stdlib/silk/ownership.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let ownershipBytes = run FileSystem.readFile(&ownershipPath) |> Effect.provideMut<FileSystem>(&mut files) |> Effect.provideMut<Allocator>(&mut allocator)
  let ownershipSource = Option<Bytes>.some(move ownershipBytes)
  let id = run module("unsafe-storage.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let library = run module("silk/raw_buffer.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let ownership = run module("silk/ownership.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
import silk.raw_buffer { RawBuffer }
fn missing(buffer: &Intrinsic.RawBuffer<u8>) -> u8 { return RawBuffer.read<u8>(buffer, 0) }
fn acknowledged(buffer: &mut Intrinsic.RawBuffer<u8>) -> u8 {
  RawBuffer.fill(&mut buffer.*, 0, 1, 7)
  return unsafe RawBuffer.read<u8>(&buffer.*, 0)
}
"""
  let source = run present(text) |> Effect.provideMut<Allocator>(&mut allocator)
  let entryRevision = run Revision.publish(&Revision.make(), &id, &source) |> Effect.provideMut<Allocator>(&mut allocator)
  let libraryRevision = run Revision.publish(&entryRevision, &library, &librarySource) |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&libraryRevision, &ownership, &ownershipSource) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut store = Semantic.traced(move revision, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu), Option<FinalProfile>.none())
  let mut request = Request.make()
  let missing = run Semantic.demandBody(&mut store, &mut request, &id, b"missing") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let acknowledged = run Semantic.demandBody(&mut store, &mut request, &id, b"acknowledged") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    rejectsFrom(&missing, RejectionCode.UnsafeAcknowledgement, offsetOf(text, "RawBuffer.read<u8>(buffer", usize.ZERO))
      && succeeded(&acknowledged),
    "a safe call of an unsafe library wrapper needs a boundary; an acknowledged call and a safe fill do not",
  )
}

test effect fn genericNominalUnionInstancesConstructMatchAndLayout() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("generic-nominal-union-instances.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
union Choice<T> { Some { value: T }, None }
fn instances() -> u8 {
  let narrow = Choice<u8>.Some { value: 42 }
  let wide = Choice<i64>.Some { value: 42 }
  drop wide
  return match move narrow { Choice<u8>.Some { value } => value Choice<u8>.None => 0 }
}
fn incomplete(value: Choice<i32>) -> i32 {
  return match move value { Choice<i32>.Some { value: inner } => inner }
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let instances = run Semantic.demandBody(&mut store, &mut request, &id, b"instances")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let narrowType = match move bodyLocalType(&instances, usize.ZERO) {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => {
      run Testing.expect(false, "Choice<u8> construction retains its complete nominal type")
      return ()
    }
  }
  let wideType = match move bodyLocalType(&instances, usize.ONE) {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => {
      run Testing.expect(false, "Choice<i64> call result retains its complete nominal type")
      return ()
    }
  }
  let distinct = !(run Type.equalsShared(&narrowType, &wideType)
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator))
  run Testing.expect(
    distinct && nominalOfKind(&narrowType, OwnerKind.Union)
      && nominalOfKind(&wideType, OwnerKind.Union)
      && !Type.hasOpenParameters(&narrowType)
      && !Type.hasOpenParameters(&wideType),
    "generic union construction and call results publish distinct complete applications",
  )
  let narrowLayout = run Semantic.demandLayout(&mut store, &mut request, &id, &narrowType)
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let repeatedLayout = run Semantic.demandLayout(&mut store, &mut request, &id, &narrowType)
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let wideLayout = run Semantic.demandLayout(&mut store, &mut request, &id, &wideType)
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let narrowIndex = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(&narrowLayout, selectedLayoutIndex)
  let repeatedIndex = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(&repeatedLayout, selectedLayoutIndex)
  let wideIndex = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(&wideLayout, selectedLayoutIndex)
  let mut interned = false
  let mut laidOut = false
  if let Option<usize>.Some {value: small} = move narrowIndex {
    if let Option<usize>.Some {value: repeated} = move repeatedIndex {
      if let Option<usize>.Some {value: broad} = move wideIndex {
        interned = small == repeated && small != broad
        let smallFacts = Semantic.layoutAt(&store, small)
        let broadFacts = Semantic.layoutAt(&store, broad)
        if let Option<Shared<BackendLayout>>.Some {value: narrowFacts} = move smallFacts {
          if let Option<Shared<BackendLayout>>.Some {value: wideFacts} = move broadFacts {
            laidOut = Shared<BackendLayout>.with<bool>(&narrowFacts, fn(layout: &BackendLayout) -> bool {
              return genericUnionLayout(layout, 2, usize.ONE, usize.ONE)
            }) && Shared<BackendLayout>.with<bool>(&wideFacts, fn(layout: &BackendLayout) -> bool {
              return genericUnionLayout(layout, 16, 8, 8)
            })
          }
        }
      }
    }
  }
  run Testing.expect(
    interned && laidOut,
    "equal generic union instances share one layout and distinct payload instances lay out separately",
  )
  let instancesBody = Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(&instances, checkedBody)
  let mut patterns = false
  if let Option<Shared<TypedBody>>.Some {value: body} = move instancesBody {
    patterns = Shared<TypedBody>.with<usize>(&body, matchTagCount) == 2
      && Shared<TypedBody>.with<usize>(&body, fn(selected: &TypedBody) -> usize {
        return variantBindings(selected, usize.ZERO, usize.ZERO)
      }) >= usize.ONE
  }
  run Testing.expect(patterns, "applied generic variant patterns retain tag coverage and substituted payload places")
  let incomplete = run Semantic.demandBody(&mut store, &mut request, &id, b"incomplete")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    rejectsSpan(
      &incomplete,
      RejectionCode.MissingUnionMember,
      text,
      "match move value { Choice<i32>.Some { value: inner } => inner }",
      0,
    ),
    "generic union coverage reports an omitted variant at the match",
  )
  return ()
}

test effect fn genericAggregatePayloadInferenceCompletesOrDiagnosesDeclaration() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("generic-aggregate-inference.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
union Choice<Payload> { Some { value: Payload }, None }
struct Phantom<Unused> { value: i32 }
fn inferred() -> i32 {
  let chosen = Choice.Some { value: 42 }
  return match move chosen { Choice<i32>.Some { value } => value Choice<i32>.None => 0 }
}
fn contextual() -> Choice<u8> { return Choice.Some { value: 42 } }
fn missingUnionArgument() -> i32 { let empty = Choice.None drop empty return 42 }
fn missingRecordArgument() -> i32 { let phantom = Phantom { value: 42 } drop phantom return 42 }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let inferred = run Semantic.demandBody(&mut store, &mut request, &id, b"inferred") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let contextual = run Semantic.demandBody(&mut store, &mut request, &id, b"contextual") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let chosenType = bodyLocalType(&inferred, usize.ZERO)
  let mut complete = false
  if let Option<Shared<Type>>.Some {value} = move chosenType {
    complete = nominalOfKind(&value, OwnerKind.Union) && !Type.hasOpenParameters(&value)
  }
  run Testing.expect(complete && Shared<Result<Answer, NoRejection>>.with<AnswerView>(&contextual, inspect).success,
    "bare union payload inference publishes a complete nominal application and aggregate context remains valid")
  let missingUnion = run Semantic.demandBody(&mut store, &mut request, &id, b"missingUnionArgument") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let missingRecord = run Semantic.demandBody(&mut store, &mut request, &id, b"missingRecordArgument") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    rejectsSpan(&missingUnion, RejectionCode.UninferredParameter, text, "Payload", 0)
      && rejectsSpan(&missingRecord, RejectionCode.UninferredParameter, text, "Unused", 0),
    "uninferred union and record parameters are diagnosed at their declaration anchors")
  return ()
}

test effect fn genericNominalUnionInstancesClassifyCopyAndShareDropGlue() -> ()
! CanonicalizationFailure | InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("generic-nominal-union-ownership.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
struct Token { value: i32 }
impl Intrinsic.Drop for Token { fn drop(self: &mut Token) -> () { return () } }
union Cell<T> { Vacant, Held { value: T } }
impl<T: Intrinsic.Copy> Intrinsic.Copy for Cell<T> {}
fn abstract<T>(subject: &Cell<T>, value: T) -> Cell<T> {
  let held = match &subject.* { Cell<T>.Held { .. } => true Cell<T>.Vacant => false }
  if held { return Cell.Held { value: move value } }
  return Cell.Vacant
}
fn copied(slot: &Cell<i32>) -> i32 { drop slot.* return 0 }
fn affine(slot: &Cell<Token>) -> i32 { drop slot.* return 0 }
fn dropped(slot: Cell<Token>) -> i32 { drop slot return 0 }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let copied = run Semantic.demandBody(&mut store, &mut request, &id, b"copied")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let abstract = run Semantic.demandBody(&mut store, &mut request, &id, b"abstract")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let affine = run Semantic.demandBody(&mut store, &mut request, &id, b"affine")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    succeeded(&copied) && succeeded(&abstract),
    "generic union Copy bounds, open patterns and contextual constructors check abstractly",
  )
  run Testing.expect(
    rejectsSpan(&affine, RejectionCode.BorrowedExtraction, text, "slot.*", 1),
    "Cell<Token> remains affine because Token does not satisfy the declared Copy bound",
  )
  let dropped = run Semantic.demandMir(&mut store, &mut request, &id, b"dropped")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let firstGlue = run droppedGlue(&mut store, &mut request, &id, b"dropped")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let secondGlue = run droppedGlue(&mut store, &mut request, &id, b"dropped")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let firstIndex = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(&firstGlue, selectedMirIndex)
  let secondIndex = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(&secondGlue, selectedMirIndex)
  let sharedGlue = match move firstIndex {
    Option<usize>.Some {value: first} => match move secondIndex {
      Option<usize>.Some {value: second} => first == second
      Option<usize>.None => false
    }
    Option<usize>.None => false
  }
  run Testing.expect(
    sharedGlue && glueFact(&store, &firstGlue, 2) == usize.ONE
      && glueFact(&store, &firstGlue, usize.ZERO) == usize.ONE
      && glueFact(&store, &firstGlue, 3) == 3010,
    "one Cell<Token> glue instance switches on the active tag and drops its substituted Token once",
  )
  let copyType = referentOf(bodyLocalType(&copied, usize.ZERO))
  let dropType = droppedType(&store, &dropped)
  let repeatedDropType = droppedType(&store, &dropped)
  let mut keyed = false
  if let Option<Shared<Type>>.Some {value: plain} = move copyType {
    if let Option<Shared<Type>>.Some {value: droppable} = move dropType {
      if let Option<Shared<Type>>.Some {value: repeated} = move repeatedDropType {
  let copyOwner = run glueSourceOwner(&mut store, &copied) |> Effect.provideMut<Allocator>(&mut allocator)
  let dropOwner = run glueSourceOwner(&mut store, &dropped) |> Effect.provideMut<Allocator>(&mut allocator)
        let plainKeyResult = run InstanceKey.dropGlue(&plain, &copyOwner) |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
        let plainKey = run requiredCanonicalGlue(move plainKeyResult)
        let dropKeyResult = run InstanceKey.dropGlue(&droppable, &dropOwner) |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
        let dropKey = run requiredCanonicalGlue(move dropKeyResult)
        let repeatedKeyResult = run InstanceKey.dropGlue(&repeated, &dropOwner) |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
        let repeatedKey = run requiredCanonicalGlue(move repeatedKeyResult)
        if let Option<InstanceKey>.Some {value: plainInstance} = move plainKey {
          if let Option<InstanceKey>.Some {value: dropInstance} = move dropKey {
            if let Option<InstanceKey>.Some {value: repeatedInstance} = move repeatedKey {
              let plainSymbol = run InstanceKey.runtimeName(&plainInstance)
                |> Effect.provideMut<Allocator>(&mut allocator)
              let dropSymbol = run InstanceKey.runtimeName(&dropInstance)
                |> Effect.provideMut<Allocator>(&mut allocator)
              let repeatedSymbol = run InstanceKey.runtimeName(&repeatedInstance)
                |> Effect.provideMut<Allocator>(&mut allocator)
              keyed = !InstanceKey.sameRuntimeBase(&plainInstance, &dropInstance)
                && InstanceKey.sameRuntimeBase(&dropInstance, &repeatedInstance)
                && !sameBytes(Bytes.asSlice(&plainSymbol), Bytes.asSlice(&dropSymbol))
                && sameBytes(Bytes.asSlice(&dropSymbol), Bytes.asSlice(&repeatedSymbol))
            }
          }
        }
      }
    }
  }
  run Testing.expect(keyed, "complete generic union instances have canonical distinct glue family keys and names")
  return ()
}

// Nominal unions tag variants in declaration order, lay each variant out like a record
// after the tag, bind variant fields as places and switch on the tag.
test effect fn genericAndNominalUnionsConstructBindAndSwitchOnVariants() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("genericAndNominalUnionsConstructBindAndSwitchOnVariants.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
union Shape { Circle { radius: i32 }, Rect { width: i32, height: i64 }, Empty }
fn make(kind: i32) -> Shape {
  if kind == 0 { return Shape.Circle { radius: 3 } }
  return Shape.Empty
}
fn area(shape: &Shape) -> i32 {
  return match &shape.* {
    Shape.Circle { radius } => radius
    Shape.Rect { width, .. } if width > 10 => width
    Shape.Rect { width, height } => width
    Shape.Empty => 0
  }
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu)) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let makeAnswer = run Semantic.demandBody(&mut store, &mut request, &id, b"make")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let areaAnswer = run Semantic.demandBody(&mut store, &mut request, &id, b"area")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut constructions = usize.ZERO
  let madeBody = Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(&makeAnswer, checkedBody)
  if let Option<Shared<TypedBody>>.Some {value} = move madeBody {
    constructions = Shared<TypedBody>.with<usize>(&value, variantConstructions)
  }
  run Testing.expect(constructions == 27, "a payload variant keeps its tag and field operand and a unit variant has none")
  let mut tags = usize.MAX
  let mut armCount = usize.MAX
  let mut first = usize.MAX
  let mut second = usize.MAX
  let mut third = usize.MAX
  let mut fourth = usize.MAX
  let mut radius = usize.ZERO
  let mut width = usize.ZERO
  let mut height = usize.ZERO
  let mut shapeType = Option<Shared<Type>>.none()
  let areaBody = Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(&areaAnswer, checkedBody)
  if let Option<Shared<TypedBody>>.Some {value} = move areaBody {
    tags = Shared<TypedBody>.with<usize>(&value, matchTagCount)
    armCount = Shared<TypedBody>.with<usize>(&value, matchArmCount)
    first = Shared<TypedBody>.with<usize>(&value, fn(body: &TypedBody) -> usize { return variantArmTag(body, usize.ZERO) })
    second = Shared<TypedBody>.with<usize>(&value, fn(body: &TypedBody) -> usize { return variantArmTag(body, usize.ONE) })
    third = Shared<TypedBody>.with<usize>(&value, fn(body: &TypedBody) -> usize { return variantArmTag(body, 2) })
    fourth = Shared<TypedBody>.with<usize>(&value, fn(body: &TypedBody) -> usize { return variantArmTag(body, 3) })
    radius = Shared<TypedBody>.with<usize>(&value, fn(body: &TypedBody) -> usize { return variantBindings(body, usize.ZERO, usize.ZERO) })
    width = Shared<TypedBody>.with<usize>(&value, fn(body: &TypedBody) -> usize { return variantBindings(body, usize.ONE, usize.ZERO) })
    height = Shared<TypedBody>.with<usize>(&value, fn(body: &TypedBody) -> usize { return variantBindings(body, usize.ONE, usize.ONE) })
    shapeType = Shared<TypedBody>.with<Option<Shared<Type>>>(&value, enumParameterType)
  }
  run Testing.expect(tags == 3 && armCount == 4 && first == usize.ZERO && second == usize.ONE && third == usize.ONE && fourth == 2,
    "variant patterns keep declaration-order tags")
  run Testing.expect(radius >= usize.ONE && width >= 2 && height >= usize.ONE, "variant fields bind as places")
  let mut laidOut = false
  if let Option<Shared<Type>>.Some {value: reference} = move shapeType {
    let referent = Shared<Type>.with<Option<Shared<Type>>>(&reference, fn(value: &Type) -> Option<Shared<Type>> {
      if let Type.Reference {referent, ..} = &value.* { return Option<Shared<Type>>.some(Shared<Type>.clone(&referent)) }
      return Option<Shared<Type>>.none()
    })
    if let Option<Shared<Type>>.Some {value: ty} = move referent {
      let layoutAnswer = run Semantic.demandLayout(&mut store, &mut request, &id, &ty)
        |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
      let layoutIndex = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(&layoutAnswer, selectedLayoutIndex)
      if let Option<usize>.Some {value: index} = move layoutIndex {
        if let Option<Shared<BackendLayout>>.Some {value: facts} = move Semantic.layoutAt(&store, index) {
          laidOut = Shared<BackendLayout>.with<bool>(&facts, variantsLayout)
        }
      }
    }
  }
  run Testing.expect(laidOut, "each variant keeps record field offsets after a one-byte tag at the strictest alignment")
  let mirAnswer = run Semantic.demandMir(&mut store, &mut request, &id, b"area")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut switches = usize.ZERO
  let mut cases = usize.ZERO
  let mut discriminant = false
  let mut variantField = false
  let mirIndex = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(&mirAnswer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move mirIndex {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(&store, index) {
      let blocks = Vector<MirBlock>.asSlice(&function.blocks)
      let mut at = usize.ZERO
      while at < blocks.length {
        if let MirTerminator.Switch {cases: selected, ..} = &blocks[at].terminator {
          switches = switches + usize.ONE
          cases = cases + Vector<MirSwitchCase>.length(&selected)
        }
        let statements = Vector<MirStatement>.asSlice(&blocks[at].statements)
        let mut statementAt = usize.ZERO
        while statementAt < statements.length {
          if let MirStatement.Assign {value, ..} = &statements[statementAt] {
            if let MirRvalue.Discriminant {..} = &value { discriminant = true }
            if let MirRvalue.Use {value: MirOperand.Copy {place}} = &value {
              let projections = Vector<MirProjection>.asSlice(&place.projections)
              let mut step = usize.ZERO
              while step < projections.length {
                if let MirProjection.VariantField {..} = &projections[step] { variantField = true }
                step = step + usize.ONE
              }
            }
          }
          statementAt = statementAt + usize.ONE
        }
        at = at + usize.ONE
      }
    }
  }
  run Testing.expect(discriminant && variantField && switches == 2 && cases == 5,
    "the tag is read once, a false guard resumes the switch at the next arm, and fields project by variant")
  return ()
}

test effect fn genericNominalUnionConstructorsDiagnosePayloads() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("genericNominalUnionConstructorsDiagnosePayloads.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
union Shape { Circle { radius: i32 }, Rect { width: i32, height: i64 }, Empty }
fn unknownField() -> Shape { return Shape.Circle { size: 1 } }
fn fieldCount() -> Shape { return Shape.Rect { width: 1 } }
fn payloadUnit() -> Shape { return Shape.Rect }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu)) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let unknownField = run Semantic.demandBody(&mut store, &mut request, &id, b"unknownField") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsSpan(&unknownField, RejectionCode.UnknownStructField, text, "size", 0), "a constructor names only variant fields")
  let fieldCount = run Semantic.demandBody(&mut store, &mut request, &id, b"fieldCount") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsSpan(&fieldCount, RejectionCode.MissingStructInitializer, text, "Shape.Rect { width: 1 }", 0), "a constructor initializes every field")
  let payloadUnit = run Semantic.demandBody(&mut store, &mut request, &id, b"payloadUnit") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsSpan(&payloadUnit, RejectionCode.MissingStructInitializer, text, "Shape.Rect", 1), "a payload variant needs its fields")
  return ()
}

test effect fn recordPatternsDistinguishMissingAndRepeatedFields() -> ()
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("record-pattern-diagnostics.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """struct Pair { slot: i32 }
fn missing(pair: Pair) -> i32 { return match move pair { Pair {} => 0 } }
fn repeated(pair: Pair) -> i32 { return match move pair { Pair { slot: left, slot: right } => left } }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let missing = run Semantic.demandBody(&mut store, &mut request, &id, b"missing")
    |> Effect.provideMut<Types>(&mut typeTable)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let repeated = run Semantic.demandBody(&mut store, &mut request, &id, b"repeated")
    |> Effect.provideMut<Types>(&mut typeTable)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    rejectsSpan(&missing, RejectionCode.MissingPatternField, text, "Pair {}", 0)
      && rejectsSpan(&repeated, RejectionCode.DuplicatePatternField, text, "slot", 2),
    "missing fields and repeated fields retain distinct reasons at their exact source spans",
  )
  return ()
}

test effect fn genericNominalUnionPatternsDiagnoseCoverage() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("genericNominalUnionPatternsDiagnoseCoverage.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
union Shape { Circle { radius: i32 }, Rect { width: i32, height: i64 }, Empty }
fn missing(shape: Shape) -> i32 { return match move shape { Shape.Circle { radius } => radius Shape.Empty => 0 } }
fn duplicate(shape: Shape) -> i32 { return match move shape { Shape.Empty => 0 Shape.Empty => 1 _ => 2 } }
fn unitPattern(shape: Shape) -> i32 { return match move shape { Shape.Rect => 1 _ => 0 } }
fn bracedUnit(shape: Shape) -> i32 { return match move shape { Shape.Empty {} => 1 _ => 0 } }
struct Box { shape: Shape }
fn nestedUnit(boxed: Box) -> i32 { return match move boxed { Box { shape: Shape.Empty {} } => 1 _ => 0 } }
fn joinedUnit(shape: Shape | i32) -> i32 { return match move shape { Shape.Empty {} => 1 _ => 0 } }
union Generic<T> { Empty, Full { value: T } }
fn appliedUnit(shape: Generic<i32>) -> i32 { return match move shape { Generic<i32>.Empty {} => 1 _ => 0 } }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu)) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let missing = run Semantic.demandBody(&mut store, &mut request, &id, b"missing") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsSpan(&missing, RejectionCode.MissingUnionMember, text, "match move shape { Shape.Circle { radius } => radius Shape.Empty => 0 }", 0), "a missing variant is uncovered")
  let duplicate = run Semantic.demandBody(&mut store, &mut request, &id, b"duplicate") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsSpan(&duplicate, RejectionCode.UnreachableMatchArm, text, "Shape.Empty => 1", 0), "a repeated unit variant is duplicate")
  let unitPattern = run Semantic.demandBody(&mut store, &mut request, &id, b"unitPattern") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsSpan(&unitPattern, RejectionCode.MissingPatternField, text, "Shape.Rect", 0), "a payload variant pattern names its fields")
  let bracedUnit = run Semantic.demandBody(&mut store, &mut request, &id, b"bracedUnit") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsSpan(&bracedUnit, RejectionCode.UnitVariantPayloadPattern, text, "Shape.Empty {}", 0),
    "braces on a unit variant report SEM0224, distinct from missing payload fields (SEM0046)")
  let nestedUnit = run Semantic.demandBody(&mut store, &mut request, &id, b"nestedUnit") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let joinedUnit = run Semantic.demandBody(&mut store, &mut request, &id, b"joinedUnit") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let appliedUnit = run Semantic.demandBody(&mut store, &mut request, &id, b"appliedUnit") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsSpan(&nestedUnit, RejectionCode.UnitVariantPayloadPattern, text, "Shape.Empty {}", 1)
    && rejectsSpan(&joinedUnit, RejectionCode.UnitVariantPayloadPattern, text, "Shape.Empty {}", 2)
    && rejectsSpan(&appliedUnit, RejectionCode.UnitVariantPayloadPattern, text, "Generic<i32>.Empty {}", 0),
    "nested field, structural-union member, and applied variant patterns preserve the same unit-payload boundary")
  return ()
}

