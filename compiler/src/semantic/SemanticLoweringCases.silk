effect fn movedLiteralClaims() -> ()
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator | &mut Types {
  let id = run module("relative-literal-payloads.silk")
  let beforeText = """
fn padding() -> i32 { return 0 }
fn integer() -> i32 { return 42 }
fn floating() -> f64 { return 1.25 }
fn text() -> string<'static> { return "literal" }
fn bytes() -> &'static [u8] { return b"bytes" }
pub fn main() -> i32 {
  let number = integer()
  let real = floating()
  let word = text()
  let octets = bytes()
  return number
}
"""
  let afterText = """
fn padding() -> i32 {
  let changed = 10
  return changed
}
fn integer() -> i32 { return 42 }
fn floating() -> f64 { return 1.25 }
fn text() -> string<'static> { return "literal" }
fn bytes() -> &'static [u8] { return b"bytes" }
pub fn main() -> i32 {
  let number = integer()
  let real = floating()
  let word = text()
  let octets = bytes()
  return number
}
"""
  let first = run Revision.publish(&Revision.make(), &id, &run present(beforeText))
  let initial = run withEntryRuntime(&first)
  let mut store = makeSemantic(run Revision.copy(&initial))
  let mut request = Request.forApplication(ModuleId.copy(&id))
  let names = [b"integer", b"floating", b"text", b"bytes"]
  let mut bodies = Vector<Option<Shared<TypedBody>>>.make()
  let mut anchors = Vector<Option<Anchor>>.make()
  let mut at = usize.ZERO
  while at < names.length {
    let answer = run Semantic.demandBody(&mut store, &mut request, &id, names[at])
    run Vector<
      Option<Shared<TypedBody>>
    >.append(
      &mut bodies,
      Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(&answer, checkedBody)
    )
    run Vector<Option<Anchor>>.append(&mut anchors, run answerAnchor(&mut store, &answer))
    at = at + usize.ONE
  }
  let before = run buildApplication(&mut store, &mut request, staticClosureNodes)
  let updated = run Revision.publish(&initial, &id, &run present(afterText))
  run Semantic.update(&mut store, move updated)
  let mut revised = Request.forApplication(ModuleId.copy(&id))
  at = usize.ZERO
  while at < names.length {
    let answer = run Semantic.demandBody(&mut store, &mut revised, &id, names[at])
    let body = Shared<
      Result<Answer, NoRejection>
    >.with<Option<Shared<TypedBody>>>(&answer, checkedBody)
    let anchor = run answerAnchor(&mut store, &answer)
    let mut stable = false
    if let Option<Shared<TypedBody>>.Some {
      value: prior
    } = &Vector<Option<Shared<TypedBody>>>.asSlice(&bodies)[at] {
      if let Option<Shared<TypedBody>>.Some { value: current } = &body {
        stable = Shared<TypedBody>.with<bool>(
          &prior,
          fn(left: &TypedBody) -> bool {
            return Shared<TypedBody>.with<bool>(
              &current,
              fn(right: &TypedBody) -> bool {
                return sameLiteralPayloads(left, right)
              }
            )
          }
        )
      }
    }
    let mut shifted = false
    if let Option<Anchor>.Some { value: prior } = &Vector<Option<Anchor>>.asSlice(&anchors)[at] {
      if let Option<Anchor>.Some { value: current } = &anchor {
        shifted = current.first.index > prior.first.index && current.token > prior.token
      }
    }
    run Testing.expect(
      stable && shifted,
      "integer, float, string and bytes retain literal nodes and linked origins after both HIR and byte starts move (incremental v2 §3.5)"
    )
    at = at + usize.ONE
  }
  let after = run buildApplication(&mut store, &mut revised, staticClosureNodes)
  let mut identical = false
  if let BackendBuild.Module { text: prior, .. } = &before {
    if let BackendBuild.Module { text: current, .. } = &after {
      identical = sameBytes(Bytes.asSlice(&prior), Bytes.asSlice(&current))
    }
  }
  run Testing.expect(
    identical,
    "literal consumers lower the current anchored syntax to identical program IR after an earlier declaration edit"
  )
}

// Complete node forms of these direct-literal returns, including their source-relative linkage.
fn sameLiteralPayloads(left: &TypedBody, right: &TypedBody) -> bool {
  if
    !DeclarationId.equals(TypedBody.declarationId(left), TypedBody.declarationId(right))
      || TypedBody.rootNode(left).index != TypedBody.rootNode(right).index
      || TypedBody.localSlice(left).length != usize.ZERO
      || TypedBody.localSlice(right).length != usize.ZERO {
    return false
  }
  let before = TypedBody.nodeSlice(left)
  let after = TypedBody.nodeSlice(right)
  if before.length != after.length {
    return false
  }
  let mut literals = usize.ZERO
  let mut at = usize.ZERO
  while at < before.length {
    let origin = before[at].origin
    let current = after[at].origin
    if origin.node != current.node || origin.location.start != current.location.start
      || origin.location.end != current.location.end {
      return false
    }
    match &before[at].kind {
      BodyNodeKind.Expression { form: first, .. } => {
        if let BodyNodeKind.Expression { form: second, .. } = &after[at].kind {
          let equal = match &first {
            BodyExpression.Integer { literal: a } => match &second {
              BodyExpression.Integer { literal: b } => a == b
              _ => false
            }
            BodyExpression.Float { literal: a } => match &second {
              BodyExpression.Float { literal: b } => a == b
              _ => false
            }
            BodyExpression.Text { literal: a } => match &second {
              BodyExpression.Text { literal: b } => a == b
              _ => false
            }
            _ => false
          }
          if
            !equal {
            return false
          }
          literals = literals + usize.ONE
        } else {
          return false
        }
      }
      BodyNodeKind.Return { value: first } => {
        if let BodyNodeKind.Return { value: second } = &after[at].kind {
          let equal = match &first {
            Option<BodyNodeId>.Some { value: a } => match &second {
              Option<BodyNodeId>.Some { value: b } => a.index == b.index
              _ => false
            }
            Option<BodyNodeId>.None => match &second {
              Option<BodyNodeId>.None => true
              _ => false
            }
          }
          if
            !equal {
            return false
          }
        } else {
          return false
        }
      }
      BodyNodeKind.Block { statements: first, canComplete: beforeEnd } => {
        if let BodyNodeKind.Block { statements: second, canComplete: afterEnd } = &after[at].kind {
          let a = Vector<BodyNodeId>.asSlice(&first)
          let b = Vector<BodyNodeId>.asSlice(&second)
          if beforeEnd != afterEnd || a.length != b.length {
            return false
          }
          let mut statement = usize.ZERO
          while statement < a.length {
            if a[statement].index != b[statement].index {
              return false
            }
            statement = statement + usize.ONE
          }
        } else {
          return false
        }
      }
      _ => {
        return false
      }
    }
    at = at + usize.ONE
  }
  return literals == usize.ONE
}

test effect fn scalarMirRetainsBranchesAndDirectCallEdges() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("scalar-mir.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let source = """fn step(value: i32) -> i32 { return value + 1 }
pub fn main() -> i32 {
  let mut value: i32 = 0
  while value < 3 { value = step(value) }
  if value == 3 && !(value == 4 || false) { return value }
  return 0
}
"""
  let mut store = run staticSemantic(
    &id,
    source,
    MachineTarget.forId(TargetId.X8664UnknownLinuxGnu),
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let answer = run Semantic.demandMir(&mut store, &mut request, &id, b"main")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let selected = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(&answer, selectedMirIndex)
  let index = match move selected {
    Option<usize>.Some {value} => value
    Option<usize>.None => {
      run Testing.expect(false, "scalar body produces MIR")
      return ()
    }
  }
  let mut hasBranch = false
  let mut hasReturn = false
  let mut hasCall = false
  let mut hasReference = false
  if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(&store, index) {
    let blocks = Vector<MirBlock>.asSlice(&function.blocks)
    let mut at = usize.ZERO
    while at < blocks.length {
      match & blocks[at].terminator {
        MirTerminator.Branch {..} => {
          hasBranch = true
        }
        MirTerminator.Return {..} => {
          hasReturn = true
        }
        MirTerminator.Call {..} => {
          hasCall = true
        }
        _ => {}
      }
      at = at + usize.ONE
    }
    hasReference = Vector<MirReference>.length(&function.references) == usize.ONE
  }
  run Testing.expect(
    hasBranch && hasReturn && hasCall && hasReference,
    "scalar MIR retains control flow and the reached callee",
  )
  let stepAnswer = run Semantic.demandMir(&mut store, &mut request, &id, b"step")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let stepSelected = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(
    &stepAnswer,
    selectedMirIndex,
  )
  let stepIndex = match move stepSelected {
    Option<usize>.Some {value} => value
    Option<usize>.None => {
      run Testing.expect(false, "scalar callee produces MIR")
      return ()
    }
  }
  let mut hasBinary = false
  if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(&store, stepIndex) {
    let blocks = Vector<MirBlock>.asSlice(&function.blocks)
    let mut block = usize.ZERO
    while block < blocks.length {
      let statements = Vector<MirStatement>.asSlice(&blocks[block].statements)
      let mut statement = usize.ZERO
      while statement < statements.length {
        if let MirStatement.Assign {value, ..} = &statements[statement] {
          if let MirRvalue.Binary {..} = &value {
            hasBinary = true
          }
        }
        statement = statement + usize.ONE
      }
      block = block + usize.ONE
    }
    hasBinary = hasBinary && Vector<MirReference>.length(&function.references) == usize.ZERO
  }
  run Testing.expect(hasBinary, "scalar callee retains arithmetic without extra call edges")
  return ()
}

test effect fn missingBuildModuleReportsDiagnostic() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("missing-build-module.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
    import silk.i32
    pub fn main() -> i32 { return i32.add(40, 2) }
    """
  let mut store = run applicationSemantic(
    &id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu),
  ) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.forApplication(ModuleId.copy(&id))
  let built = run buildApplication(&mut store, &mut request, staticClosureNodes)
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let rejected = match move built {
    BackendBuild.Rejected {first: diagnostic, ..} => Shared<Rejection>.with<bool>(
      &diagnostic, fn(value: &Rejection) -> bool {
        return value.code == RejectionCode.MissingModule &&
          value.span.start == offsetOf(text, "silk.i32", 0) && value.span.end == value.span.start + 8
      },
    )
    _ => false
  }
  run Testing.expect(rejected, "a genuinely absent source remains an authored missing-module diagnostic")
  return ()
}

test effect fn ordinaryNegationBuildsTrappingIr() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("negation-overflow.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut store = run applicationSemantic(
    &id,
    "pub fn main() -> i32 { return -(-2147483648) }",
    MachineTarget.forId(TargetId.X8664UnknownLinuxGnu),
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.forApplication(ModuleId.copy(&id))
  let built = run buildApplication(&mut store, &mut request, staticClosureNodes)
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut checked = false
  match move built {
    BackendBuild.Module {text, ..} => {
      let ir = Bytes.asSlice(&text)
      checked = containsIr(ir, b"call { i32, i1 } @llvm.ssub.with.overflow.i32") && containsIr(ir, b"call void @llvm.trap()")
    }
    _ => {}
  }
  run Testing.expect(checked, "ordinary negation checks overflow and traps")
  return ()
}

// The symbol on the map line naming `entry`, or nothing when no line names it.
effect fn mappedSymbol(map: &[u8], entry: &[u8]) -> Option<Bytes> ! OutOfMemoryError ? &mut Allocator {
  let mut line = usize.ZERO
  while line < map.length {
    let mut end = line
    while end < map.length && map[end] != 10 {
      end = end + usize.ONE
    }
    let mut tab = line
    while tab < end && map[tab] != 9 {
      tab = tab + usize.ONE
    }
    if end - tab == entry.length + usize.ONE && containsIr(Slice.view<u8>(map, tab + usize.ONE, entry.length), entry) {
      return Option<Bytes>.some(run Bytes.copy(Slice.view<u8>(map, line, tab - line)))
    }
    line = end + usize.ONE
  }
  return Option<Bytes>.none()
}

test effect fn symbolMapNamesEachEmittedInstance() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("symbol-map.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut store = run applicationSemantic(
    &id,
    "fn helper() -> i32 { return 7 }\npub fn main() -> i32 { return helper() }",
    MachineTarget.forId(TargetId.X8664UnknownLinuxGnu),
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.forApplication(ModuleId.copy(&id))
  let built = run buildApplication(&mut store, &mut request, staticClosureNodes)
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut named = false
  if let BackendBuild.Module {text, plan, ..} = &built {
    let map = run EmissionPlan.symbolMap(&plan)
      |> Effect.provideMut<Allocator>(&mut allocator)
    let symbol = run mappedSymbol(Bytes.asSlice(&map), b"function\texample:symbol-map.silk::helper")
      |> Effect.provideMut<Allocator>(&mut allocator)
    if let Option<Bytes>.Some {value} = &symbol {
      let mut definition = run Bytes.copy(b" @")
        |> Effect.provideMut<Allocator>(&mut allocator)
      run Bytes.append(&mut definition, Bytes.asSlice(&value))
        |> Effect.provideMut<Allocator>(&mut allocator)
      run Bytes.append(&mut definition, b"(")
        |> Effect.provideMut<Allocator>(&mut allocator)
      named = containsIr(Bytes.asSlice(&text), Bytes.asSlice(&definition))
    }
  }
  run Testing.expect(named, "the debug symbol map names the content-derived symbol the IR defines for `helper`")
  return ()
}

// `--stats` names each body the borrow-check gap counts: one line per unchecked definition, with
// its reason, family, owner path and symbol. A checked helper is not listed. A checked root body no
// instance emits still counts, listed with the family `unemitted` and no symbol.
test effect fn uncheckedBodiesNameEachCountedDefinition() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("unchecked-bodies.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
struct Key<'k> { text: &'k i32 }
struct Out<'t> { text: &'t i32 }
struct Pair {
  a: i32
  b: i32
}
fn pick<'t>(key: &Key, text: &'t i32) -> Out<'t> { return Out<'t> {text: text} }
pub fn main() -> i32 { let mut p = Pair {a: 1, b: 2}  let key = Key {text: &p.a}  let out = pick(&key, &p.b)  drop key  p.a = 5  return out.text.* }
fn unused() -> i32 { let mut p = Pair {a: 1, b: 2}  let key = Key {text: &p.a}  let out = pick(&key, &p.b)  drop key  p.a = 5  return out.text.* }
"""
  let mut store = run applicationSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.forApplication(ModuleId.copy(&id))
  let built = run buildApplication(&mut store, &mut request, staticClosureNodes)
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut named = false
  if let BackendBuild.Module {unchecked, plan, ..} = &built {
    let bodies = run EmissionPlan.uncheckedBodies(&plan) |> Effect.provideMut<Allocator>(&mut allocator)
    let lines = Vector<Bytes>.asSlice(&bodies)
    let map = run EmissionPlan.symbolMap(&plan) |> Effect.provideMut<Allocator>(&mut allocator)
    let symbol = run mappedSymbol(Bytes.asSlice(&map), b"function\texample:unchecked-bodies.silk::main")
      |> Effect.provideMut<Allocator>(&mut allocator)
    let mut total = usize.ZERO
    let counts = Vector<usize>.asSlice(&unchecked)
    let mut at = usize.ZERO
    while at < counts.length {
      total = total + counts[at]
      at = at + usize.ONE
    }
    if let Option<Bytes>.Some {value} = &symbol {
      let mut expected = run Bytes.copy(b"imprecise\tfunction\texample:unchecked-bodies.silk::main\t") |> Effect.provideMut<Allocator>(&mut allocator)
      run Bytes.append(&mut expected, Bytes.asSlice(&value)) |> Effect.provideMut<Allocator>(&mut allocator)
      named = total == usize.ONE + usize.ONE && lines.length == usize.ONE + usize.ONE
        && sameBytes(Bytes.asSlice(&lines[usize.ZERO]), Bytes.asSlice(&expected))
        && sameBytes(Bytes.asSlice(&lines[usize.ONE]), b"imprecise\tunemitted\texample:unchecked-bodies.silk::unused\t-")
    }
  }
  run Testing.expect(named, "the unchecked-body listing names main with its reason and symbol, and the unemitted unused body")
  return ()
}

test effect fn assemblyBuildsInlineAsmCallsAndRejectsContractViolations() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("assembly.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let source = """unsafe fn trap() -> () {
  return unsafe Intrinsic.assembly<()>("ud2", "", "", "none", true, true, ())
}
unsafe fn add(left: u64, right: u64) -> u64 {
  return unsafe Intrinsic.assembly<u64>("addq $2, $0", "={rax},0,{rdi}", "flags", "read", true, false, (left, right))
}
unsafe fn racy(value: u64) -> u64 {
  return unsafe Intrinsic.assembly<u64>("movq $1, $0", "={rax},{rdi}", "", "write", false, false, (value,))
}
pub fn main() -> i32 {
  let total = unsafe add(40, 2)
  if total == 7 { unsafe trap() }
  return 0
}
"""
  let mut store = run applicationSemantic(&id, source, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.forApplication(ModuleId.copy(&id))
  // Keep every negative Body assertion in the original source. The emission control gets
  // a complete valid program, since builds now check its entire loaded declaration closure.
  let buildText = """unsafe fn trap() -> () {
  return unsafe Intrinsic.assembly<()>("ud2", "", "", "none", true, true, ())
}
unsafe fn add(left: u64, right: u64) -> u64 {
  return unsafe Intrinsic.assembly<u64>("addq $2, $0", "={rax},0,{rdi}", "flags", "read", true, false, (left, right))
}
pub fn main() -> i32 {
  let total = unsafe add(40, 2)
  if total == 7 { unsafe trap() }
  return 0
}
"""
  let mut buildStore = run applicationSemantic(
    &id,
    buildText,
    MachineTarget.forId(TargetId.X8664UnknownLinuxGnu)
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut buildRequest = Request.forApplication(ModuleId.copy(&id))
  let built = run buildApplication(&mut buildStore, &mut buildRequest, staticClosureNodes)
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut lowered = false
  match move built {
    BackendBuild.Module {text, ..} => {
      let ir = Bytes.asSlice(&text)
      lowered = containsIr(ir, b"call void asm sideeffect \"ud2\", \"\"() noreturn memory(inaccessiblemem: readwrite)\nunreachable") &&
        containsIr(ir, b" = call i64 asm sideeffect \"addq $2, $0\", \"={rax},0,{rdi},~{flags},~{memory}\"(i64 ") &&
        containsIr(ir, b") memory(read, inaccessiblemem: readwrite, target_mem0: none, target_mem1: none)\n")
    }
    _ => {}
  }
  run Testing.expect(lowered, "assembly lowers to one inline-asm call with its clobbers, effects and no-return edge")
  let racy = run Semantic.demandBody(&mut store, &mut request, &id, b"racy")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsFrom(&racy, RejectionCode.InvalidConfiguration, offsetOf(source, "Intrinsic.assembly<u64>(\"movq", usize.ZERO)),
    "a writing fragment without side effects violates the machine contract at the call")
  return ()
}

// Binds each storage operation to the same-named declaration of `module`.
effect fn storageIn(module: &ModuleId) -> ExecutionStorage ! OutOfMemoryError ? &mut Allocator {
  return ExecutionStorage {
    create: StorageBinding {module: ModuleId.copy(module), declaration: run Bytes.copy(b"create")},
    acquire: StorageBinding {module: ModuleId.copy(module), declaration: run Bytes.copy(b"acquire")},
    release: StorageBinding {module: ModuleId.copy(module), declaration: run Bytes.copy(b"release")},
    destroy: StorageBinding {module: ModuleId.copy(module), declaration: run Bytes.copy(b"destroy")},
  }
}

// A build that reaches a suspension boundary needs the selected execution storage; with it,
// every suspendable instance becomes a driver, an `$enter` and a `$step` over a frame from that
// storage, and a borrowed local lives in the frame. A step whose package was dropped while
// relinquished enters the cancel exit of its point.
test effect fn suspensionBuildsCoroutinesOverSelectedStorage() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("suspension-frames.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  // The storage exports only need to exist for this structural build; their bodies never run.
  let source = """
struct Counter { value: i32 }
effect fn bump(counter: &mut Counter, value: i32) -> i32 {
  let next = run Intrinsic.suspendEffect(effect { return value + 1 })
  counter.value = counter.value + next
  return next
}
pub fn main() -> i32 {
  let mut counter = Counter { value: 1 }
  let first = run bump(&mut counter, 2)
  return first + counter.value
}
export "C" fn create() -> usize { return 0 }
export "C" fn acquire(state: usize, size: usize, alignment: usize) -> usize { return state }
export "C" fn release(state: usize, frame: usize) -> () { return () }
export "C" fn destroy(state: usize) -> () { return () }
"""
  let mut store = run applicationSemantic(&id, source, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.forApplication(ModuleId.copy(&id))
  let unselected = run buildApplication(&mut store, &mut request, staticClosureNodes)
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let boundary = offsetOf(source, "run Intrinsic.suspendEffect", usize.ZERO)
  let mut refused = false
  if let BackendBuild.Rejected {first, ..} = &unselected {
    refused = Shared<Rejection>.with<bool>(&first, fn(found: &Rejection) -> bool {
      return found.code == RejectionCode.InvalidConfiguration && found.span.start == boundary
    })
  }
  run Testing.expect(refused, "a reached suspension without a selected execution storage is a configuration rejection at its boundary")
  let storage = run storageIn(&id) |> Effect.provideMut<Allocator>(&mut allocator)
  Semantic.selectExecutionStorage(&mut store, move storage)
  let built = run buildApplication(&mut store, &mut request, staticClosureNodes)
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut lowered = false
  match move built {
    BackendBuild.Module {text, ..} => {
      let ir = Bytes.asSlice(&text)
      lowered = containsIr(ir, b"$enter\"(ptr %transfer") && containsIr(ir, b"$step\"(ptr %transfer, ptr %frame) {") &&
        containsIr(ir, b"%frame = call ptr @\"acquire\"(ptr ") && containsIr(ir, b"call void @\"release\"(ptr ") &&
        containsIr(ir, b"call void @\"destroy\"(ptr ") && containsIr(ir, b", label %resume1") &&
        containsIr(ir, b"\nret i32 1\n") && containsIr(ir, b" = getelementptr i8, ptr %frame, i64 ") &&
        containsIr(ir, b"call i32 %") && containsIr(ir, b" i32 1, label %cancel1 ]") && containsIr(ir, b"\ncancel1:\n") &&
        !containsIr(ir, b"\ncancel1:\ncall void @llvm.trap()")
    }
    _ => {}
  }
  run Testing.expect(lowered,
    "suspendable instances drive frames from the selected storage, keep borrowed locals in their frame, and cancel each point through its own exit")
  return ()
}

effect fn retaining(module: &ModuleId, declaration: &[u8]) -> Vector<RetentionRoot> ! OutOfMemoryError ? &mut Allocator {
  let mut roots = Vector<RetentionRoot>.make()
  run Vector<RetentionRoot>.append(&mut roots, RetentionRoot {module: ModuleId.copy(module), declaration: run Bytes.copy(declaration)})
  return move roots
}

// The code and span start of a refused build's first rejection.
fn refusedAt(built: &BackendBuild, start: usize) -> bool {
  if let BackendBuild.Rejected {first, ..} = &built.* {
    return Shared<Rejection>.with<bool>(&first, fn(found: &Rejection) -> bool {
      return found.code == RejectionCode.InvalidConfiguration && found.span.start == start
    })
  }
  return false
}

// A retention selector roots one monomorphic runtime function, even a private one, and marks it
// used without exporting it; an unrelated public function still disappears. A selector naming no
// single function, or a generic or provider-requiring one, is a configuration rejection
// (ARTIFACT-003).
test effect fn retentionRootsKeepPrivateFunctionsUsed() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("retention-roots.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let source = """
service Clock {}
fn capability() -> i32 { return 7177 }
pub fn unrelated() -> i32 { return 8188 }
fn view<T>(value: &T) -> i32 { return 1 }
effect fn timed() -> i32 ? &Clock { return 1 }
pub fn main() -> i32 { return 0 }
"""
  let mut store = run applicationSemantic(&id, source, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.forApplication(ModuleId.copy(&id))
  let plain = run buildApplication(&mut store, &mut request, staticClosureNodes)
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut unretained = false
  if let BackendBuild.Module {text, ..} = &plain {
    unretained = !containsIr(Bytes.asSlice(&text), b"i32 7177") && !containsIr(Bytes.asSlice(&text), b"@llvm.used")
  }
  run Testing.expect(unretained, "an unexported private function is not emitted without a retention root")
  Semantic.selectRetention(&mut store, run retaining(&id, b"capability") |> Effect.provideMut<Allocator>(&mut allocator))
  let kept = run buildApplication(&mut store, &mut request, staticClosureNodes)
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut retained = false
  if let BackendBuild.Module {text, ..} = &kept {
    let ir = Bytes.asSlice(&text)
    retained = containsIr(ir, b"i32 7177") && containsIr(ir, b"@llvm.used = appending global [1 x ptr] [ptr @")
      && containsIr(ir, b"], section \"llvm.metadata\"\n") && !containsIr(ir, b"i32 8188")
  }
  run Testing.expect(retained, "a retained private function is emitted and marked used, and an unrelated public one is not")
  Semantic.selectRetention(&mut store, run retaining(&id, b"view") |> Effect.provideMut<Allocator>(&mut allocator))
  let generic = run buildApplication(&mut store, &mut request, staticClosureNodes)
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  Semantic.selectRetention(&mut store, run retaining(&id, b"timed") |> Effect.provideMut<Allocator>(&mut allocator))
  let provided = run buildApplication(&mut store, &mut request, staticClosureNodes)
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  Semantic.selectRetention(&mut store, run retaining(&id, b"absent") |> Effect.provideMut<Allocator>(&mut allocator))
  let absent = run buildApplication(&mut store, &mut request, staticClosureNodes)
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    refusedAt(&generic, offsetOf(source, "view<T>", usize.ZERO)) && refusedAt(&provided, offsetOf(source, "timed()", usize.ZERO))
      && refusedAt(&absent, usize.ZERO),
    "a generic, provider-requiring or absent retention root is a configuration rejection at its declaration or module"
  )
  return ()
}

// A frame cancelled while a finalizer runs never delivers the failure it holds: its cancel exit
// drops that failure once (SUSP-013), while a failure recovered before the finalizer is no longer
// held there.
test effect fn cancelledFinalizerDropsItsHeldFailure() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("suspension-held-failure.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let source = """
struct Token { value: i32 }
impl Intrinsic.Drop for Token { fn drop(self: &mut Token) -> () { return () } }
struct Owned { token: Token }
effect fn failing() -> i32 ! Owned { fail Owned { token: Token { value: 6 } } }
effect fn parked() -> () { return run Intrinsic.relinquish() }
effect fn recover(error: Owned) -> i32 { return 1 }
effect fn held() -> i32 ! Owned { return run Intrinsic.finalizeEffect(failing(), parked()) }
effect fn recovered() -> i32 { return run Intrinsic.finalizeEffect(Intrinsic.catchFailure<Owned>(failing(), recover), parked()) }
pub fn main() -> i32 {
  let first = run Intrinsic.catchFailure<Owned>(held(), recover)
  let second = run recovered()
  return first + second
}
export "C" fn create() -> usize { return 0 }
export "C" fn acquire(state: usize, size: usize, alignment: usize) -> usize { return state }
export "C" fn release(state: usize, frame: usize) -> () { return () }
export "C" fn destroy(state: usize) -> () { return () }
"""
  let mut store = run applicationSemantic(&id, source, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.forApplication(ModuleId.copy(&id))
  let storage = run storageIn(&id) |> Effect.provideMut<Allocator>(&mut allocator)
  Semantic.selectExecutionStorage(&mut store, move storage)
  let built = run buildApplication(&mut store, &mut request, staticClosureNodes)
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let emitted = match &built { BackendBuild.Module {..} => true _ => false }
  // Per frame variant, the drops its cancel exits run: exactly one function's exits drop one value.
  let mut dropping = usize.ZERO
  let mut dropped = usize.ZERO
  let mut cancelling = usize.ZERO
  let mut index = usize.ZERO
  let mut more = true
  while more {
    more = false
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(&store, index) {
      more = true
      if Vector<MirCancel>.length(&function.cancels) != usize.ZERO {
        cancelling = cancelling + usize.ONE
        let count = run cancelDrops(function) |> Effect.provideMut<Allocator>(&mut allocator)
        if count != usize.ZERO { dropping = dropping + usize.ONE }
        dropped = dropped + count
      }
    }
    index = index + usize.ONE
  }
  run Testing.expect(emitted && cancelling >= 3 && dropping == usize.ONE && dropped == usize.ONE,
    "only the frame holding an owned failure across its finalizer's point drops it, once, when cancelled there")
  return ()
}

// The drops in the blocks reachable from every cancel exit of `function`.
effect fn cancelDrops(function: &MirFunction) -> usize ! OutOfMemoryError ? &mut Allocator {
  let blocks = Vector<MirBlock>.asSlice(&function.blocks)
  let mut seen = Vector<bool>.make()
  let mut at = usize.ZERO
  while at < blocks.length {
    run Vector<bool>.append(&mut seen, false)
    at = at + usize.ONE
  }
  let mut pending = Vector<usize>.make()
  let cancels = Vector<MirCancel>.asSlice(&function.cancels)
  at = usize.ZERO
  while at < cancels.length {
    run Vector<usize>.append(&mut pending, cancels[at].entry)
    at = at + usize.ONE
  }
  let mut drops = usize.ZERO
  while Vector<usize>.length(&pending) != usize.ZERO {
    let block = Vector<usize>.asSlice(&pending)[Vector<usize>.length(&pending) - usize.ONE]
    drop Vector<usize>.pop(&mut pending)
    if Vector<bool>.asSlice(&seen)[block] { continue }
    let marks = Vector<bool>.asMutSlice(&mut seen)
    marks[block] = true
    let statements = Vector<MirStatement>.asSlice(&blocks[block].statements)
    let mut position = usize.ZERO
    while position < statements.length {
      if let MirStatement.Drop {..} = &statements[position] { drops = drops + usize.ONE }
      position = position + usize.ONE
    }
    match &blocks[block].terminator {
      MirTerminator.Goto {target, ..} => run Vector<usize>.append(&mut pending, target)
      MirTerminator.Branch {thenBlock, elseBlock, ..} => {
        run Vector<usize>.append(&mut pending, thenBlock)
        run Vector<usize>.append(&mut pending, elseBlock)
      }
      MirTerminator.Switch {cases, otherwise, ..} => {
        let listed = Vector<MirSwitchCase>.asSlice(&cases)
        let mut item = usize.ZERO
        while item < listed.length {
          run Vector<usize>.append(&mut pending, listed[item].target)
          item = item + usize.ONE
        }
        run Vector<usize>.append(&mut pending, otherwise)
      }
      MirTerminator.Call {normal, failure, ..} => {
        run Vector<usize>.append(&mut pending, normal)
        if let Option<MirFailureEdge>.Some {value: edge} = &failure { run Vector<usize>.append(&mut pending, edge.target) }
      }
      _ => {}
    }
  }
  return drops
}

// Every suspension point of a frame has a cancel exit, and no drop flag is read before an edge
// writes it: planning aborts otherwise. Real frames satisfy both; a frame stripped of its cancel
// exits, or an entry that reads a flag, is reported at that point or flag.
test effect fn suspensionFramesKeepTheirCancelExitsAndAssignedFlags() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("suspension-frame-invariants.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let source = """
struct Token { value: i32 }
impl Intrinsic.Drop for Token { fn drop(self: &mut Token) -> () { return () } }
struct Pair { left: Token right: Token }
effect fn tidy() -> () { return () }
effect fn parked(flag: bool) -> i32 {
  let mut pair = Pair { left: Token { value: 1 }, right: Token { value: 2 } }
  if flag { let left = move pair.left drop left }
  run Intrinsic.relinquish()
  pair.left = Token { value: 3 }
  return pair.right.value
}
effect fn finalized(flag: bool) -> i32 { return run Intrinsic.finalizeEffectNonParking(parked(flag), tidy()) }
pub fn main() -> i32 {
  let value = run finalized(true)
  return value
}
export "C" fn create() -> usize { return 0 }
export "C" fn acquire(state: usize, size: usize, alignment: usize) -> usize { return state }
export "C" fn release(state: usize, frame: usize) -> () { return () }
export "C" fn destroy(state: usize) -> () { return () }
"""
  let mut store = run applicationSemantic(&id, source, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.forApplication(ModuleId.copy(&id))
  let storage = run storageIn(&id) |> Effect.provideMut<Allocator>(&mut allocator)
  Semantic.selectExecutionStorage(&mut store, move storage)
  let built = run buildApplication(&mut store, &mut request, staticClosureNodes)
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let emitted = match &built { BackendBuild.Module {..} => true _ => false }
  let mut frames = usize.ZERO
  let mut exited = true
  let mut stripped = true
  let mut assigned = true
  let mut flagged = usize.ZERO
  let mut index = usize.ZERO
  let mut more = true
  while more {
    more = false
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(&store, index) {
      more = true
      let cancels = Vector<MirCancel>.asSlice(&function.cancels)
      if cancels.length != usize.ZERO {
        frames = frames + usize.ONE
        let blocks = Vector<MirBlock>.asSlice(&function.blocks)
        let suspending = run cancelPoints(blocks.length, cancels) |> Effect.provideMut<Allocator>(&mut allocator)
        let marked = Vector<bool>.asSlice(&suspending)
        let found = run unexitedPoint(function, cancels, marked) |> Effect.provideMut<Allocator>(&mut allocator)
        if found != usize.MAX { exited = false }
        let none = Vector<MirCancel>.make()
        let unexited = run unexitedPoint(function, Vector<MirCancel>.asSlice(&none), marked) |> Effect.provideMut<Allocator>(&mut allocator)
        if unexited != firstPoint(cancels) { stripped = false }
        let mut entry = run entryLive(function) |> Effect.provideMut<Allocator>(&mut allocator)
        let locals = Vector<MirLocal>.asSlice(&function.locals)
        if liveFlag(locals, Vector<u64>.asSlice(&entry)) != usize.MAX { assigned = false }
        let flag = firstFlag(locals)
        if flag != usize.MAX {
          let words = Vector<u64>.asMutSlice(&mut entry)
          words[flag / 64] = u64.bitOr(words[flag / 64], u64.shiftLeft(1, usize.toU64(flag - flag / 64 * 64)))
          if liveFlag(locals, Vector<u64>.asSlice(&entry)) == flag { flagged = flagged + usize.ONE }
        }
      }
    }
    index = index + usize.ONE
  }
  run Testing.expect(emitted && frames >= 2 && exited && stripped,
    "every suspension point of a frame has a cancel exit, and one without is reported at the point")
  run Testing.expect(assigned && flagged >= usize.ONE,
    "no drop flag of a frame is live on entry, and an entry that reads one is reported at that flag")
  return ()
}

// One mark per block: whether it is the point of one of `cancels`.
effect fn cancelPoints(count: usize, cancels: &[MirCancel]) -> Vector<bool> ! OutOfMemoryError ? &mut Allocator {
  let mut marks = Vector<bool>.make()
  let mut at = usize.ZERO
  while at < count {
    run Vector<bool>.append(&mut marks, false)
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < cancels.length {
    let listed = Vector<bool>.asMutSlice(&mut marks)
    listed[cancels[at].point] = true
    at = at + usize.ONE
  }
  return move marks
}

fn firstPoint(cancels: &[MirCancel]) -> usize {
  let mut first = usize.MAX
  let mut at = usize.ZERO
  while at < cancels.length {
    if cancels[at].point < first { first = cancels[at].point }
    at = at + usize.ONE
  }
  return first
}

fn firstFlag(locals: &[MirLocal]) -> usize {
  let mut at = usize.ZERO
  while at < locals.length {
    if let MirLocalKind.DropFlag {..} = &locals[at].kind { return at }
    at = at + usize.ONE
  }
  return usize.MAX
}

// A frame cancelled inside a consuming match arm cleans as a return from that arm would
// (EXEC-008): the arm's binding first, then the subject's remainder.
test effect fn cancelledMatchArmDropsBindingBeforeSubjectRemainder() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("suspension-cancel-order.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let source = """
struct Token { value: i32 }
impl Intrinsic.Drop for Token { fn drop(self: &mut Token) -> () { return () } }
struct Holder { token: Token other: Token }
effect fn parked(holder: Holder) -> i32 {
  match move holder {
    Holder { token, .. } => {
      run Intrinsic.relinquish()
      return token.value
    }
  }
}
pub fn main() -> i32 {
  let value = run parked(Holder { token: Token { value: 1 }, other: Token { value: 2 } })
  return value
}
export "C" fn create() -> usize { return 0 }
export "C" fn acquire(state: usize, size: usize, alignment: usize) -> usize { return state }
export "C" fn release(state: usize, frame: usize) -> () { return () }
export "C" fn destroy(state: usize) -> () { return () }
"""
  let mut store = run applicationSemantic(&id, source, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.forApplication(ModuleId.copy(&id))
  let storage = run storageIn(&id) |> Effect.provideMut<Allocator>(&mut allocator)
  Semantic.selectExecutionStorage(&mut store, move storage)
  let built = run buildApplication(&mut store, &mut request, staticClosureNodes)
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let emitted = match &built { BackendBuild.Module {..} => true _ => false }
  // The cancel path of `parked`'s one point drops the arm's binding `token` (field 0 of the
  // evaluated subject), then the remainder `other` (field 1).
  let mut ordered = false
  let mut index = usize.ZERO
  let mut more = true
  while more {
    more = false
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(&store, index) {
      more = true
      let cancels = Vector<MirCancel>.asSlice(&function.cancels)
      if cancels.length == usize.ONE && Vector<Shared<Type>>.length(&function.parameters) == usize.ONE {
        ordered = cancelDropOrder(function, cancels[usize.ZERO].entry) == 12
      }
    }
    index = index + usize.ONE
  }
  run Testing.expect(emitted && ordered,
    "a frame cancelled in a consuming arm drops the arm's binding, then the subject's remainder")
  return ()
}

// Follows the straight-line cancel path from `entry` and encodes its drops in order, one decimal
// digit each: the drop's field of the subject local plus one. Every drop must name a field of the
// same local, the evaluated subject whose parts the arm's bindings own; 0 otherwise.
fn cancelDropOrder(function: &MirFunction, entry: usize) -> usize {
  let blocks = Vector<MirBlock>.asSlice(&function.blocks)
  let mut code = usize.ZERO
  let mut subject = usize.MAX
  let mut block = entry
  let mut steps = usize.ZERO
  while block < blocks.length && steps < blocks.length {
    let statements = Vector<MirStatement>.asSlice(&blocks[block].statements)
    let mut position = usize.ZERO
    while position < statements.length {
      if let MirStatement.Drop {destination, ..} = &statements[position] {
        if subject == usize.MAX { subject = destination.local }
        if destination.local != subject { return usize.ZERO }
        let path = Vector<MirProjection>.asSlice(&destination.projections)
        if path.length != usize.ONE { return usize.ZERO }
        let mut digit = usize.ZERO
        if let MirProjection.Field {index} = &path[usize.ZERO] { digit = index + usize.ONE }
        if digit == usize.ZERO { return usize.ZERO }
        code = code * 10 + digit
      }
      position = position + usize.ONE
    }
    match &blocks[block].terminator {
      MirTerminator.Goto {target, ..} => { block = target }
      MirTerminator.Abandon {..} => { return code }
      _ => { return usize.ZERO }
    }
    steps = steps + usize.ONE
  }
  return usize.ZERO
}

test effect fn unitParametersHaveNoLlvmLane() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("unit-parameter.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut store = run applicationSemantic(
    &id,
    """fn sink(first: i32, value: (), last: i32) -> i32 { return first + last }
fn unit(value: ()) -> i32 { return 1 }
fn apply(f: fn<'static>(()) -> i32) -> i32 { return f(()) }
pub fn main() -> i32 { return sink(40, (), 1) + apply(unit) }
""",
    MachineTarget.forId(TargetId.X8664UnknownLinuxGnu),
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.forApplication(ModuleId.copy(&id))
  let built = run buildApplication(&mut store, &mut request, staticClosureNodes)
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut checked = false
  match move built {
    BackendBuild.Module {text, ..} => {
      let ir = Bytes.asSlice(&text)
      checked = containsIr(ir, b"i32 %p0, i32 %p2)") && !containsIr(ir, b"%p1") && !containsIr(ir, b"void %")
    }
    _ => {}
  }
  run Testing.expect(checked, "a unit parameter, called directly or through a callable, has no LLVM lane")
  return ()
}

test effect fn staticFunctionsDoNotBecomeRuntimeInstances() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let calleeId = run module("static-callee.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut callee = run applicationSemantic(
    &calleeId,
    """static fn answer() -> i32 { return 42 }
pub fn main() -> i32 { return answer() }
""",
    MachineTarget.forId(TargetId.X8664UnknownLinuxGnu),
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut calleeRequest = Request.forApplication(ModuleId.copy(&calleeId))
  let calleeBuild = run buildApplication(&mut callee, &mut calleeRequest, staticClosureNodes)
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  // The caller routes to its selected body, which embeds the static result: the static callee
  // has no runtime instance, call or residualization gap.
  let built = match &calleeBuild {
    BackendBuild.Module {..} => true
    _ => false
  }
  let abstractMain = run Semantic.demandBody(&mut callee, &mut calleeRequest, &calleeId, b"main")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let selectedMain = run Semantic.demandMir(&mut callee, &mut calleeRequest, &calleeId, b"main")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let callStart = offsetOf("""static fn answer() -> i32 { return 42 }
pub fn main() -> i32 { return answer() }
""", "answer()", usize.ONE)
  run Testing.expect(built && mirReferenceCount(&callee, &selectedMain) == usize.ZERO
      && Shared<Result<Answer, NoRejection>>.with<bool>(&abstractMain, fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionAt(answer, RejectionCode.Unsupported, callStart)
      }),
    "a static callee's result is embedded: the build succeeds, member MIR has no callee reference, and an unselected body cannot call it")
  return ()
}

test effect fn foreignCallsKeepCSignatureAndSeparateMirEdges() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("foreign-c-signature.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let foreignText = """unsafe extern "C" fn narrow(value: i8) -> i8
unsafe extern "C" fn malloc(size: usize) -> ?*mut u8
unsafe extern "C" fn free(pointer: ?*mut u8) -> ()
unsafe extern "C" fn fabs(value: f64) -> f64
unsafe extern "C" fn fabsf(value: f32) -> f32
pub fn main() -> i32 {
  let value = unsafe narrow(-7)
  let memory = unsafe malloc(8)
  unsafe free(memory)
  if unsafe fabs(-42.0) != 42.0 { return 1 }
  if unsafe fabsf(-7.0) != 7.0 { return 2 }
  if 7.0 != unsafe fabsf(-7.0) { return 3 }
  return 42
}
"""
  let mut store = run applicationSemantic(&id, foreignText, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu)) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.forApplication(ModuleId.copy(&id))
  let built = run buildApplication(&mut store, &mut request, staticClosureNodes) |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut classified = false
  match move built {
    BackendBuild.Module {text, ..} => {
      let ir = Bytes.asSlice(&text)
      classified = containsIr(ir, b"declare signext i8 @\"narrow\"(i8 signext ") && containsIr(ir, b"invoke signext i8 @\"narrow\"(i8 signext -7)") && containsIr(ir, b"declare ptr @\"malloc\"(i64 ") && containsIr(ir, b"declare void @\"free\"(ptr ") && containsIr(ir, b"declare double @\"fabs\"(double ") && containsIr(ir, b"declare float @\"fabsf\"(float ") && containsIr(ir, b"invoke float @\"fabsf\"(float 0xC01C000000000000") && containsIr(ir, b"invoke double @\"fabs\"(double 0xC045000000000000") && containsIr(ir, b" = fcmp une float ") && containsIr(ir, b" = fcmp une double ")
    }
    _ => {}
  }
  run Testing.expect(classified, "C narrow extensions, pointer and contextual floating lanes agree at declaration and call")
  let mut arm = run applicationSemantic(&id, foreignText, MachineTarget.forId(TargetId.Aarch64UnknownLinuxGnu)) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut armRequest = Request.forApplication(ModuleId.copy(&id))
  let armBuilt = run buildApplication(&mut arm, &mut armRequest, staticClosureNodes) |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut bare = false
  if let BackendBuild.Module {text: armText, ..} = &armBuilt {
    let ir = Bytes.asSlice(&armText)
    bare = containsIr(ir, b"declare i8 @\"narrow\"(i8 ") && containsIr(ir, b"invoke i8 @\"narrow\"(i8 -7)")
      && containsIr(ir, b"declare double @\"fabs\"(double ") && !containsIr(ir, b"signext")
  }
  run Testing.expect(bare, "AAPCS64 Linux leaves narrow C integer lanes unextended at declaration and call, and its entry runtime builds")
  let mirAnswer = run Semantic.demandMir(&mut store, &mut request, &id, b"main") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let index = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(&mirAnswer, selectedMirIndex)
  let mut separate = false
  if let Option<usize>.Some {value} = move index {
    if let Option<&MirFunction>.Some {value: mir} = move Semantic.mirAt(&store, value) {
      separate = Vector<MirReference>.length(&mir.references) == usize.ZERO && Vector<Shared<DeclarationId>>.length(&mir.externs) > usize.ZERO
    }
  }
  run Testing.expect(separate, "foreign declarations never enter the runtime body worklist")
  return ()
}

test effect fn foreignUnsafePrefixesSelectOnlyTheirInvocation() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("foreign-unsafe-regions.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """unsafe extern "C" fn outer(value: i32) -> i32
unsafe extern "C" fn inner() -> i32
fn safe(value: i32) -> i32 { return value }
fn nestedMissing() -> i32 { return unsafe outer(inner()) }
unsafe fn unsafeFunction() -> i32 { return inner() }
fn explicitNested() -> i32 { return unsafe outer(unsafe inner()) }
fn blockNested() -> i32 {
  unsafe { return outer(inner()) }
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu)) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let nested = run Semantic.demandBody(&mut store, &mut request, &id, b"nestedMissing") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let unmarked = run Semantic.demandBody(&mut store, &mut request, &id, b"unsafeFunction") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    rejectsSpan(&nested, RejectionCode.UnsafeAcknowledgement, text, "inner()", usize.ONE) &&
    rejectsFrom(&unmarked, RejectionCode.UnsafeAcknowledgement, offsetOf(text, "inner() }", usize.ZERO)),
    "prefix authority selects one unsafe call and function modifiers grant no lexical permission",
  )
  let explicit = run Semantic.demandBody(&mut store, &mut request, &id, b"explicitNested") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let blocked = run Semantic.demandBody(&mut store, &mut request, &id, b"blockNested") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let markedBody = Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(&explicit, checkedBody)
  let blockBody = Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(&blocked, checkedBody)
  let mut accepted = false
  if let Option<Shared<TypedBody>>.Some {value: marked} = move markedBody {
    if let Option<Shared<TypedBody>>.Some {value: region} = move blockBody {
      accepted = Shared<TypedBody>.with<bool>(&marked, bodyIsFullyChecked) && Shared<TypedBody>.with<bool>(&region, bodyIsFullyChecked)
    }
  }
  run Testing.expect(accepted, "explicit nested prefixes and a lexical unsafe block acknowledge both calls")
  return ()
}

test effect fn foreignFunctionTypeReasonsAreDistinct() -> ()
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("foreign-type-reasons.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
fn abi(value: extern "wrong" fn(i32) -> i32) -> () {}
fn contract(value: extern "C" fn(i32) -> i32 with Intrinsic.foreign(memory: "invalid")) -> () {}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let abi = run Semantic.demandSignature(&mut store, &mut request, &id, b"abi")
    |> Effect.provideMut<Types>(&mut typeTable)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let contract = run Semantic.demandSignature(&mut store, &mut request, &id, b"contract")
    |> Effect.provideMut<Types>(&mut typeTable)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    rejectsSpan(
      &abi,
      RejectionCode.UnsupportedForeignAbi,
      text,
      "extern \"wrong\" fn(i32) -> i32",
      0
    )
      && rejectsSpan(
      &contract,
      RejectionCode.ForeignDeclarationRestriction,
      text,
      "extern \"C\" fn(i32) -> i32 with Intrinsic.foreign(memory: \"invalid\")",
      0
    ),
    "ABI selection and invalid foreign contracts have distinct reasons at the whole type"
  )
  return ()
}

test effect fn negativeUsizeHasDedicatedReason() -> ()
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("usize-negative.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = "fn negative() -> usize { return -1 }\nfn range() -> u8 { return 256 }\n"
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let negative = run Semantic.demandBody(&mut store, &mut request, &id, b"negative")
    |> Effect.provideMut<Types>(&mut typeTable)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let range = run Semantic.demandBody(&mut store, &mut request, &id, b"range")
    |> Effect.provideMut<Types>(&mut typeTable)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    rejectsSpan(&negative, RejectionCode.UsizeNegative, text, "-1", 0)
      && rejectsSpan(&range, RejectionCode.IntegerOutOfRange, text, "256", 0),
    "negative usize and fixed-width overflow retain distinct reasons at the literals"
  )
  return ()
}

test effect fn foreignBoolSignatureRejectsDespiteItsRuntimeLayout() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("foreign-bool.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """unsafe extern "C" fn probe(value: bool) -> bool
pub fn main() -> i32 {
  let value = unsafe probe(true)
  return 42
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu)) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let body = run Semantic.demandBody(&mut store, &mut request, &id, b"main") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsFrom(&body, RejectionCode.ForeignType, offsetOf(text, "probe(true)", usize.ZERO)), "closed foreign admission rejects bool before C ABI emission")
  return ()
}

test effect fn foreignCFunctionPointersReportTheirNamedGap() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("foreign-callback.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """unsafe extern "C" fn consume(callback: extern "C" fn(i32) -> i32) -> i32
unsafe extern "C" fn create() -> extern "C" fn(i32) -> i32
pub fn main() -> i32 { return unsafe consume(unsafe create()) }
"""
  let mut store = run applicationSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu)) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.forApplication(ModuleId.copy(&id))
  let built = run buildApplication(&mut store, &mut request, staticClosureNodes) |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut deferred = false
  match move built {
    BackendBuild.Unsupported {gaps} => {
      let entries = Vector<Shared<BackendGap>>.asSlice(&gaps)
      if entries.length == 2 {
        let parameter = Shared<
          BackendGap
        >.with<bool>(
          &entries[usize.ZERO],
          fn(value: &BackendGap) -> bool {
            let span = BackendGap.span(value)
            return value.code == GapCode.CAbiCallback && BackendGap.moduleMatches(value, &id)
              && span.start == usize.ZERO
              && span.end == offsetOf(text, "unsafe extern \"C\" fn create", usize.ZERO) - usize.ONE
          }
        )
        let result = Shared<
          BackendGap
        >.with<bool>(
          &entries[usize.ONE],
          fn(value: &BackendGap) -> bool {
            let span = BackendGap.span(value)
            return value.code == GapCode.CAbiCallback && BackendGap.moduleMatches(value, &id)
              && span.start == offsetOf(text, "unsafe extern \"C\" fn create", usize.ZERO)
              && span.end == offsetOf(text, "pub fn main", usize.ZERO) - usize.ONE
          }
        )
        deferred = parameter && result
      }
    }
    _ => {}
  }
  run Testing.expect(
    deferred,
    "every loaded C callback parameter/result header retains its own authentic gap; forwarding does not duplicate it"
  )
  return ()
}

// These expectations come from the integer C variadic reference, independently of CAbi's classifier.
fn variadicSource(at: usize) -> &'static [u8] {
  if at == usize.ZERO { return b"i8" }
  if at == usize.ONE { return b"u8" }
  if at == 2 { return b"i16" }
  if at == 3 { return b"u16" }
  if at == 4 { return b"i32" }
  if at == 5 { return b"u32" }
  if at == 6 { return b"i64" }
  if at == 7 { return b"u64" }
  if at == 8 { return b"isize" }
  if at == 9 { return b"usize" }
  return b""
}

fn variadicPromoted(at: usize) -> &'static [u8] {
  if at < 4 { return b"i32" }
  return variadicSource(at)
}

fn variadicPrimitive(ty: &Shared<Type>, spelling: &[u8]) -> bool {
  return Shared<Type>.with<bool>(ty, fn(value: &Type) -> bool { return witnessPrimitive(value, spelling) })
}

fn variadicPair(value: &CAbi.VariadicArgument, source: &[u8], promoted: &[u8]) -> bool {
  return variadicPrimitive(&value.sourceType, source) && variadicPrimitive(&value.promotedType, promoted)
}

fn variadicImport(declaration: &DeclarationId, id: &ModuleId) -> bool {
  return ModuleId.equals(DeclarationId.moduleId(declaration), id) && DeclarationId.named(declaration, b"receive")
}

fn variadicLocalOperand(node: &BodyNode, index: usize, spelling: &[u8]) -> bool {
  if let BodyNodeKind.Expression {ty, form: BodyExpression.Local {local}} = &node.kind {
    return local.index == index && variadicPrimitive(&ty, spelling)
  }
  return false
}

fn variadicFixedInteger(node: &BodyNode) -> bool {
  if let BodyNodeKind.Expression {ty, form: BodyExpression.Integer {..}} = &node.kind {
    return variadicPrimitive(&ty, b"i32")
  }
  return false
}

fn variadicBody(body: &TypedBody, id: &ModuleId, tails: bool) -> bool {
  let mut caller: &'static [u8] = b"zero"
  if tails { caller = b"tails" }
  if !ModuleId.equals(DeclarationId.moduleId(TypedBody.declarationId(body)), id)
    || !DeclarationId.named(TypedBody.declarationId(body), caller) { return false }
  let nodes = TypedBody.nodeSlice(body)
  let locals = TypedBody.localSlice(body)
  let handles = TypedBody.foreignHandles(body)
  if handles.length != usize.ONE || TypedBody.runtimeBodies(body).length != usize.ZERO { return false }
  let mut count = usize.ONE
  if tails { count = 11 }
  if locals.length != count { return false }
  let mut calls = usize.ZERO
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {ty, form: BodyExpression.ForeignCall {declaration, arguments, variadicArguments}} = &nodes[at].kind {
      if !variadicImport(&declaration, id) || !variadicPrimitive(&ty, b"i32")
        || !Shared<DeclarationId>.with<bool>(&handles[usize.ZERO], fn(value: &DeclarationId) -> bool {
          return DeclarationId.equals(value, &declaration)
        }) { return false }
      let supplied = Vector<BodyNodeId>.asSlice(&arguments)
      if supplied.length != count { return false }
      let evidence = Shared<Vector<CAbi.VariadicArgument>>.with<bool>(&variadicArguments,
        fn(values: &Vector<CAbi.VariadicArgument>) -> bool {
          let records = Vector<CAbi.VariadicArgument>.asSlice(values)
          if records.length != count - usize.ONE { return false }
          let mut item = usize.ZERO
          while item < records.length {
            if !variadicPair(&records[item], variadicSource(item), variadicPromoted(item)) { return false }
            item = item + usize.ONE
          }
          return true
        })
      if !evidence { return false }
      let mut item = usize.ZERO
      while item < supplied.length {
        if supplied[item].index >= nodes.length { return false }
        let mut spelling: &'static [u8] = b"i8"
        if item > usize.ZERO { spelling = variadicSource(item - usize.ONE) }
        if !variadicPrimitive(&locals[item].ty, spelling) { return false }
        if !variadicLocalOperand(&nodes[supplied[item].index], item, spelling) { return false }
        item = item + usize.ONE
      }
      calls = calls + usize.ONE
    }
    at = at + usize.ONE
  }
  return calls == usize.ONE
}

fn variadicCallResultUnchanged(function: &MirFunction, local: usize, producer: usize) -> bool {
  let blocks = Vector<MirBlock>.asSlice(&function.blocks)
  let mut writers = usize.ZERO
  let mut at = usize.ZERO
  while at < blocks.length {
    let statements = Vector<MirStatement>.asSlice(&blocks[at].statements)
    let mut item = usize.ZERO
    while item < statements.length {
      if variadicStatementLocal(&statements[item]) == local { return false }
      item = item + usize.ONE
    }
    if let MirTerminator.Call {destination, failure, ..} = &blocks[at].terminator {
      if destination.local == local {
        if at != producer || Vector<MirProjection>.length(&destination.projections) != usize.ZERO { return false }
        writers = writers + usize.ONE
      }
      if let Option<MirFailureEdge>.Some {value} = &failure {
        if value.destination.local == local { return false }
      }
    }
    at = at + usize.ONE
  }
  return writers == usize.ONE
}

fn variadicMir(function: &MirFunction, id: &ModuleId, tails: bool) -> bool {
  let identity = InstanceKey.identity(&function.key)
  let mut caller: &'static [u8] = b"zero"
  if tails { caller = b"tails" }
  if !Shared<DeclarationId>.with<bool>(&identity, fn(value: &DeclarationId) -> bool {
    return ModuleId.equals(DeclarationId.moduleId(value), id) && DeclarationId.named(value, caller)
  }) { return false }
  let blocks = Vector<MirBlock>.asSlice(&function.blocks)
  let locals = Vector<MirLocal>.asSlice(&function.locals)
  let parameters = Vector<Shared<Type>>.asSlice(&function.parameters)
  if Vector<MirReference>.length(&function.references) != usize.ZERO
    || Vector<Shared<DeclarationId>>.length(&function.externs) != usize.ONE { return false }
  let mut count = usize.ONE
  if tails { count = 11 }
  if parameters.length != count { return false }
  let mut calls = usize.ZERO
  let mut at = usize.ZERO
  while at < blocks.length {
    if let MirTerminator.Call {callee: MirCallee.Extern {declaration, variadicArguments}, arguments, providers, diagnostics, failure, ..} = &blocks[at].terminator {
      if !Shared<DeclarationId>.with<bool>(&declaration, fn(value: &DeclarationId) -> bool { return variadicImport(value, id) })
        || Vector<MirOperand>.length(&providers) != usize.ZERO { return false }
      if let Option<MirDiagnostics>.Some {..} = &diagnostics { return false }
      if let Option<MirFailureEdge>.Some {..} = &failure { return false }
      let supplied = Vector<MirOperand>.asSlice(&arguments)
      let records = Vector<CAbi.VariadicArgument>.asSlice(&variadicArguments)
      if supplied.length != count || records.length != count - usize.ONE { return false }
      let mut item = usize.ZERO
      while item < supplied.length {
        let local = variadicOperandLocal(&supplied[item])
        if local >= locals.length || !variadicParameter(function, local, item) { return false }
        let mut spelling: &'static [u8] = b"i8"
        if item > usize.ZERO { spelling = variadicSource(item - usize.ONE) }
        if !variadicPrimitive(&locals[local].ty, spelling) || !variadicPrimitive(&parameters[item], spelling) { return false }
        if item > usize.ZERO && !variadicPair(&records[item - usize.ONE], spelling, variadicPromoted(item - usize.ONE)) { return false }
        item = item + usize.ONE
      }
      calls = calls + usize.ONE
    } else if let MirTerminator.Call {..} = &blocks[at].terminator { return false }
    at = at + usize.ONE
  }
  return calls == usize.ONE
}

fn variadicOrderedMir(function: &MirFunction, id: &ModuleId) -> bool {
  let callerIdentity = InstanceKey.identity(&function.key)
  if !Shared<DeclarationId>.with<bool>(&callerIdentity, fn(value: &DeclarationId) -> bool {
    return ModuleId.equals(DeclarationId.moduleId(value), id) && DeclarationId.named(value, b"ordered")
  }) { return false }
  let blocks = Vector<MirBlock>.asSlice(&function.blocks)
  let locals = Vector<MirLocal>.asSlice(&function.locals)
  let mut next = usize.ZERO
  let mut left = usize.MAX
  let mut right = usize.MAX
  let mut calls = usize.ZERO
  let mut at = usize.ZERO
  while at < blocks.length {
    if let MirTerminator.Call {..} = &blocks[at].terminator { calls = calls + usize.ONE }
    at = at + usize.ONE
  }
  if calls != 3 { return false }
  let mut side = usize.ZERO
  while side < 2 {
    if next >= blocks.length { return false }
    match &blocks[next].terminator {
      MirTerminator.Call {callee: MirCallee.Instance {key}, arguments, destination, normal, ..} => {
        let identity = InstanceKey.identity(&key)
        let mut name: &'static [u8] = b"left"
        if side == usize.ONE { name = b"right" }
        if !Shared<DeclarationId>.with<bool>(&identity, fn(value: &DeclarationId) -> bool {
          return ModuleId.equals(DeclarationId.moduleId(value), id) && DeclarationId.named(value, name)
        }) || Vector<MirOperand>.length(&arguments) != usize.ZERO
          || Vector<MirProjection>.length(&destination.projections) != usize.ZERO { return false }
        if !variadicCallResultUnchanged(function, destination.local, next) { return false }
        if side == usize.ZERO { left = destination.local } else { right = destination.local }
        next = normal
      }
      _ => { return false }
    }
    side = side + usize.ONE
  }
  if left == right || left >= locals.length || right >= locals.length || next >= blocks.length { return false }
  if !variadicPrimitive(&locals[left].ty, b"i8") || !variadicPrimitive(&locals[right].ty, b"u16") { return false }
  if let MirTerminator.Call {callee: MirCallee.Extern {declaration, variadicArguments}, arguments, ..} = &blocks[next].terminator {
    let supplied = Vector<MirOperand>.asSlice(&arguments)
    let records = Vector<CAbi.VariadicArgument>.asSlice(&variadicArguments)
    return Shared<DeclarationId>.with<bool>(&declaration, fn(value: &DeclarationId) -> bool { return variadicImport(value, id) })
      && supplied.length == 3 && records.length == 2
      && variadicOperandLocal(&supplied[usize.ONE]) == left && variadicOperandLocal(&supplied[2]) == right
      && variadicPair(&records[usize.ZERO], b"i8", b"i32") && variadicPair(&records[usize.ONE], b"u16", b"i32")
  }
  return false
}

// Byte spans keep SSA links exact: %v1 must never accidentally match %v10.
fn variadicFind(text: &[u8], needle: &[u8], start: usize) -> usize {
  let mut at = start
  while at <= text.length && needle.length <= text.length - at {
    if sameBytes(Slice.view<u8>(text, at, needle.length), needle) { return at }
    at = at + usize.ONE
  }
  return usize.MAX
}

fn variadicSsa(text: &[u8], start: usize) -> Span {
  let mut at = start
  while at < text.length && text[at] == 32 { at = at + usize.ONE }
  if at >= text.length || text[at] != 37 { return Span.make(usize.MAX, usize.MAX) }
  let begin = at
  at = at + usize.ONE
  while at < text.length && text[at] != 32 && text[at] != 10 && text[at] != 44 && text[at] != 41 { at = at + usize.ONE }
  return Span.make(begin, at)
}

fn variadicLoad(text: &[u8], local: usize, width: &[u8]) -> Span {
  let mut result = Span.make(usize.MAX, usize.MAX)
  let mut start = usize.ZERO
  while start < text.length {
    let mut end = start
    while end < text.length && text[end] != 10 { end = end + usize.ONE }
    let line = Slice.view<u8>(text, start, end - start)
    let load = variadicFind(line, b" = load ", usize.ZERO)
    let address = variadicFind(line, b", ptr %l", usize.ZERO)
    if load != usize.MAX && address != usize.MAX {
      let kind = load + 8
      let digits = address + 8
      let mut finish = digits
      while finish < line.length && line[finish] >= 48 && line[finish] <= 57 { finish = finish + usize.ONE }
      if kind + width.length < line.length && sameBytes(Slice.view<u8>(line, kind, width.length), width)
        && line[kind + width.length] == 44
        && finish > digits && (finish == line.length || line[finish] == 44)
        && decimalEqualsUsize(Slice.view<u8>(line, digits, finish - digits), local) {
        if result.start != usize.MAX { return Span.make(usize.MAX, usize.MAX) }
        result = variadicSsa(text, start)
      }
    }
    start = end + usize.ONE
  }
  return result
}

fn variadicConversion(text: &[u8], input: Span, operation: &[u8]) -> Span {
  if input.start == usize.MAX { return input }
  let mut result = Span.make(usize.MAX, usize.MAX)
  let mut start = usize.ZERO
  while start < text.length {
    let mut end = start
    while end < text.length && text[end] != 10 { end = end + usize.ONE }
    let line = Slice.view<u8>(text, start, end - start)
    let found = variadicFind(line, operation, usize.ZERO)
    if found != usize.MAX {
      let operand = variadicSsa(line, found + operation.length)
      if operand.start != usize.MAX && sameBytes(Slice.view<u8>(line, operand.start, operand.end - operand.start),
        Slice.view<u8>(text, input.start, input.end - input.start))
        && sameBytes(Slice.view<u8>(line, operand.end, line.length - operand.end), b" to i32") {
        if result.start != usize.MAX { return Span.make(usize.MAX, usize.MAX) }
        result = variadicSsa(text, start)
      }
    }
    start = end + usize.ONE
  }
  return result
}

fn variadicCallValue(text: &[u8], call: usize, position: usize, kind: &[u8], expected: Span) -> bool {
  if expected.start == usize.MAX { return false }
  let mut at = call + b"@\"receive\"(".length
  let mut item = usize.ZERO
  while item < position {
    while at < text.length && text[at] != 44 && text[at] != 41 && text[at] != 10 { at = at + usize.ONE }
    if at >= text.length || text[at] != 44 { return false }
    at = at + 2
    item = item + usize.ONE
  }
  if at + kind.length >= text.length || !sameBytes(Slice.view<u8>(text, at, kind.length), kind) { return false }
  let actual = variadicSsa(text, at + kind.length)
  return actual.start != usize.MAX && sameBytes(Slice.view<u8>(text, actual.start, actual.end - actual.start),
    Slice.view<u8>(text, expected.start, expected.end - expected.start))
}

fn variadicReceiveCall(text: &[u8]) -> usize {
  let target = b"@\"receive\"("
  let call = variadicFind(text, target, usize.ZERO)
  let prefix = b"invoke i32 (i8, ...) "
  if call == usize.MAX || call < prefix.length
    || variadicFind(text, target, call + target.length) != usize.MAX
    || !sameBytes(Slice.view<u8>(text, call - prefix.length, prefix.length), prefix) { return usize.MAX }
  return call
}

fn variadicConnectedIr(text: &[u8], function: &MirFunction) -> bool {
  // This source has exactly one function with eleven scalar parameters; identify its real definition.
  let header = variadicFind(text, b"(i8 %p0, i8 %p1, i8 %p2, i16 %p3, i16 %p4, i32 %p5, i32 %p6, i64 %p7, i64 %p8, i64 %p9, i64 %p10)", usize.ZERO)
  if header == usize.MAX { return false }
  let mut start = header
  while start > usize.ZERO && text[start - usize.ONE] != 10 { start = start - usize.ONE }
  if !sameBytes(Slice.view<u8>(text, start, 7), b"define ") { return false }
  let end = variadicFind(text, b"\n}", header)
  if end == usize.MAX { return false }
  let body = Slice.view<u8>(text, start, end - start)
  let call = variadicReceiveCall(body)
  if call == usize.MAX { return false }
  let blocks = Vector<MirBlock>.asSlice(&function.blocks)
  let mut at = usize.ZERO
  while at < blocks.length {
    if let MirTerminator.Call {callee: MirCallee.Extern {..}, arguments, ..} = &blocks[at].terminator {
      let supplied = Vector<MirOperand>.asSlice(&arguments)
      if supplied.length != 11 { return false }
      let fixed = variadicLoad(body, variadicOperandLocal(&supplied[usize.ZERO]), b"i8")
      if !variadicCallValue(body, call, usize.ZERO, b"i8 signext ", fixed) { return false }
      let mut tail = usize.ZERO
      while tail < 10 {
        let mut width: &'static [u8] = b"i64"
        let mut passed: &'static [u8] = b"i64 "
        if tail < 2 { width = b"i8" }
        else if tail < 4 { width = b"i16" }
        else if tail < 6 { width = b"i32" }
        if tail < 6 { passed = b"i32 " }
        let loaded = variadicLoad(body, variadicOperandLocal(&supplied[tail + usize.ONE]), width)
        let mut operand = loaded
        if tail == usize.ZERO { operand = variadicConversion(body, loaded, b" = sext i8 ") }
        if tail == usize.ONE { operand = variadicConversion(body, loaded, b" = zext i8 ") }
        if tail == 2 { operand = variadicConversion(body, loaded, b" = sext i16 ") }
        if tail == 3 { operand = variadicConversion(body, loaded, b" = zext i16 ") }
        if !variadicCallValue(body, call, tail + usize.ONE, passed, operand) { return false }
        tail = tail + usize.ONE
      }
      return true
    }
    at = at + usize.ONE
  }
  return false
}

fn variadicBuildIr(built: &BackendBuild, function: &MirFunction) -> bool {
  if let BackendBuild.Module {text, ..} = &built.* {
    let ir = Bytes.asSlice(&text)
    let declaration = b"declare i32 @\"receive\"(i8 signext , ...)"
    let declared = variadicFind(ir, declaration, usize.ZERO)
    return declared != usize.MAX && variadicFind(ir, declaration, declared + declaration.length) == usize.MAX
      && variadicZeroIr(ir) && variadicConnectedIr(ir, function)
  }
  return false
}

fn variadicZeroIr(text: &[u8]) -> bool {
  // Only the authored zero-tail function has this one-parameter definition header.
  let marker = b"(i8 %p0)"
  let header = variadicFind(text, marker, usize.ZERO)
  if header == usize.MAX || variadicFind(text, marker, header + marker.length) != usize.MAX { return false }
  let mut start = header
  while start > usize.ZERO && text[start - usize.ONE] != 10 { start = start - usize.ONE }
  if !sameBytes(Slice.view<u8>(text, start, 7), b"define ") { return false }
  let end = variadicFind(text, b"\n}", header)
  if end == usize.MAX { return false }
  let body = Slice.view<u8>(text, start, end - start)
  let call = variadicReceiveCall(body)
  if call == usize.MAX { return false }
  let fixedStart = call + b"@\"receive\"(".length
  let fixedKind = b"i8 signext "
  if fixedStart + fixedKind.length >= body.length
    || !sameBytes(Slice.view<u8>(body, fixedStart, fixedKind.length), fixedKind) { return false }
  let operand = variadicSsa(body, call + b"@\"receive\"(i8 signext ".length)
  return operand.start != usize.MAX && operand.end < body.length && body[operand.end] == 41
}

fn variadicImportSignature(value: &Signature) -> bool {
  let parameters = Vector<Shared<Type>>.asSlice(&value.parameters)
  return value.isUnsafe && value.isVariadic && !value.isEffect && parameters.length == usize.ONE
    && variadicPrimitive(&parameters[usize.ZERO], b"i8") && variadicPrimitive(&value.result, b"i32")
}

fn variadicSignatureAnswer(answer: &Result<Answer, NoRejection>) -> bool {
  return onSignature(answer, variadicImportSignature)
}

test effect fn foreignIntegerVariadicsRetainSourceTypesAndPromotions() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("foreign-integer-variadic.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """unsafe extern "C" fn receive(tag: i8, ...) -> i32
fn zero(tag: i8) -> i32 { return unsafe receive(tag) }
fn tails(tag: i8, a: i8, b: u8, c: i16, d: u16, e: i32, f: u32, g: i64, h: u64, j: isize, k: usize) -> i32 {
  return unsafe receive(tag, a, b, c, d, e, f, g, h, j, k)
}
fn left() -> i8 { return -7 }
fn right() -> u16 { return 65535 }
fn ordered() -> i32 { return unsafe receive(1, left(), right()) }
pub fn main() -> i32 { return zero(-7) + tails(-7, -7, 255, -300, 65535, 32, 32, 64, 64, -1, 1) + ordered() }
"""
  let source = run present(text) |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&Revision.make(), &id, &source) |> Effect.provideMut<Allocator>(&mut allocator)
  let linuxRevision = run withEntryRuntime(&revision) |> Effect.provideMut<Allocator>(&mut allocator)
  let darwinRevision = run withEntryRuntime(&revision) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut store = Semantic.traced(move linuxRevision, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu), Option<FinalProfile>.none())
  let mut darwin = Semantic.traced(move darwinRevision, MachineTarget.forId(TargetId.Aarch64AppleDarwin), Option<FinalProfile>.none())
  let mut request = Request.forApplication(ModuleId.copy(&id))
  let signature = run Semantic.demandSignature(&mut store, &mut request, &id, b"receive") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let declared = Shared<Result<Answer, NoRejection>>.with<bool>(&signature, variadicSignatureAnswer)
  let zero = run Semantic.demandBody(&mut store, &mut request, &id, b"zero") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let tails = run Semantic.demandBody(&mut store, &mut request, &id, b"tails") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let zeroBody = Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(&zero, checkedBody)
  let tailBody = Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(&tails, checkedBody)
  let mut typed = false
  if let Option<Shared<TypedBody>>.Some {value: first} = move zeroBody {
    if let Option<Shared<TypedBody>>.Some {value: second} = move tailBody {
      typed = Shared<TypedBody>.with<bool>(&first, fn(value: &TypedBody) -> bool { return variadicBody(value, &id, false) })
        && Shared<TypedBody>.with<bool>(&second, fn(value: &TypedBody) -> bool { return variadicBody(value, &id, true) })
    }
  }
  run Testing.expect(declared && typed, "one authored C import retains fixed i8 and ordered integer source types with independent signed-int promotion evidence")
  let zeroMir = run Semantic.demandMir(&mut store, &mut request, &id, b"zero") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let tailMir = run Semantic.demandMir(&mut store, &mut request, &id, b"tails") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let ordered = run Semantic.demandMir(&mut store, &mut request, &id, b"ordered") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut lowered = false
  let mut orderedCalls = false
  let zeroIndex = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(&zeroMir, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move zeroIndex {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(&store, index) { lowered = variadicMir(function, &id, false) }
  }
  let orderedIndex = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(&ordered, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move orderedIndex {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(&store, index) { orderedCalls = variadicOrderedMir(function, &id) }
  }
  let linuxBuild = run buildApplication(&mut store, &mut request, staticClosureNodes) |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut darwinRequest = Request.forApplication(ModuleId.copy(&id))
  let darwinBuild = run buildApplication(&mut darwin, &mut darwinRequest, staticClosureNodes) |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let tailIndex = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(&tailMir, selectedMirIndex)
  let mut emitted = false
  if let Option<usize>.Some {value: index} = move tailIndex {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(&store, index) {
      lowered = lowered && variadicMir(function, &id, true)
      emitted = variadicBuildIr(&linuxBuild, function) && variadicBuildIr(&darwinBuild, function)
    } else { lowered = false }
  } else { lowered = false }
  run Testing.expect(lowered && orderedCalls, "source MIR keeps fixed and tail parameter provenance, no foreign body edges, and left/right call results once in order")
  run Testing.expect(emitted, "Linux and Darwin emit one true variadic declaration and calls whose dynamic narrow operands link through the prescribed sign/zero extensions")
  return ()
}

test effect fn foreignIntegerVariadicsRejectNonIntegerTails() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("foreign-variadic-tail-types.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """unsafe extern "C" fn receive(tag: i32, ...) -> i32
struct Pair { value: i32 }
impl Intrinsic.Copy for Pair {}
fn floating(badFloat: f64) -> i32 { return unsafe receive(1, badFloat) }
fn pointer(badPointer: ?*const u8) -> i32 { return unsafe receive(1, badPointer) }
fn reference(badReference: &i32) -> i32 { return unsafe receive(1, badReference) }
fn boolean(badBool: bool) -> i32 { return unsafe receive(1, badBool) }
fn character(badChar: char) -> i32 { return unsafe receive(1, badChar) }
fn aggregate(badRecord: Pair) -> i32 { return unsafe receive(1, badRecord) }
fn callable(badCallable: fn(i32) -> i32) -> i32 { return unsafe receive(1, move badCallable) }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu)) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let floating = run Semantic.demandBody(&mut store, &mut request, &id, b"floating") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let pointer = run Semantic.demandBody(&mut store, &mut request, &id, b"pointer") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let reference = run Semantic.demandBody(&mut store, &mut request, &id, b"reference") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let boolean = run Semantic.demandBody(&mut store, &mut request, &id, b"boolean") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let character = run Semantic.demandBody(&mut store, &mut request, &id, b"character") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let aggregate = run Semantic.demandBody(&mut store, &mut request, &id, b"aggregate") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let callable = run Semantic.demandBody(&mut store, &mut request, &id, b"callable") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsSpan(&floating, RejectionCode.ForeignType, text, "badFloat", usize.ONE)
    && rejectsSpan(&pointer, RejectionCode.ForeignType, text, "badPointer", usize.ONE)
    && rejectsSpan(&reference, RejectionCode.ForeignType, text, "badReference", usize.ONE)
    && rejectsSpan(&boolean, RejectionCode.ForeignType, text, "badBool", usize.ONE)
    && rejectsSpan(&character, RejectionCode.ForeignType, text, "badChar", usize.ONE)
    && rejectsSpan(&aggregate, RejectionCode.ForeignType, text, "badRecord", usize.ONE)
    && rejectsSpan(&callable, RejectionCode.ForeignType, text, "move badCallable", usize.ZERO),
    "integer tails exclude fixed-C floats/pointers and ordinary references, bool, char, aggregate and callable values at their authored operands")
  return ()
}

// A build that stops on exactly one gap of `code`.
fn soleGap(built: &BackendBuild, code: GapCode) -> bool {
  if let BackendBuild.Unsupported {gaps} = &built.* {
    let entries = Vector<Shared<BackendGap>>.asSlice(&gaps)
    if entries.length != usize.ONE { return false }
    return Shared<BackendGap>.with<bool>(&entries[usize.ZERO], fn(value: &BackendGap) -> bool { return value.code == code })
  }
  return false
}

fn variadicGap(built: &BackendBuild, code: GapCode, source: string, header: string) -> bool {
  if let BackendBuild.Unsupported {gaps} = &built.* {
    let entries = Vector<Shared<BackendGap>>.asSlice(&gaps)
    if entries.length != usize.ONE { return false }
    return Shared<BackendGap>.with<bool>(&entries[usize.ZERO], fn(value: &BackendGap) -> bool {
      let span = BackendGap.span(value)
      let start = offsetOf(source, header, usize.ZERO)
      return value.code == code && span.start == start && span.end == start + String.utf8Bytes(header).length
    })
  }
  return false
}

test effect fn nativeCallbackAddressesRequireExportedMatchingContracts() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("native-callback-addresses.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
unsafe extern "C" fn apply(callback: extern "C" fn(*const i32) -> i32 with Intrinsic.foreign(memory: "read", locality: "arguments")) -> i32 with Intrinsic.foreign(callbacks: ("callback",))
type Callback = extern "C" fn(*const i32) -> i32 with Intrinsic.foreign(memory: "read", locality: "arguments")
unsafe extern "C" fn applyAlias(callback: Callback) -> i32 with Intrinsic.foreign(callbacks: ("callback",))
unsafe extern "C" fn applyPure(callback: extern "C" fn() -> i32 with Intrinsic.foreign(memory: "none", locality: "arguments")) -> i32 with Intrinsic.foreign(callbacks: ("callback",))
unsafe export "C" fn pure() -> i32 with Intrinsic.foreign(memory: "none") { return 42 }
fn normalized() -> i32 { return unsafe applyPure(pure) }
unsafe extern "C" fn external(value: *const i32) -> i32
unsafe export "C" fn read(value: *const i32) -> i32 as "callback_alias" with Intrinsic.foreign(memory: "read", locality: "arguments") { return 42 }
unsafe export "C" fn write(value: *const i32) -> i32 as "callback_mutating" with Intrinsic.foreign(memory: "write", locality: "arguments") { return 42 }
unsafe export "C" fn wide(value: *const i32) -> i64 as "callback_large" with Intrinsic.foreign(memory: "read", locality: "arguments") { return 42 }
fn ordinary(value: *const i32) -> i32 { return 42 }
effect fn effectful(value: *const i32) -> i32 { return 42 }
fn generic<T>(value: *const T) -> i32 { return 42 }
fn rejectedOrdinary() -> i32 { return unsafe apply(ordinary) }
fn rejectedEffect() -> i32 { return unsafe apply(effectful) }
fn rejectedGeneric() -> i32 { return unsafe apply(generic) }
fn accepted() -> i32 { return unsafe apply(read) }
fn aliased() -> i32 { return unsafe applyAlias(read) }
fn wrongBehavior() -> i32 { return unsafe apply(write) }
fn wrongShape() -> i32 { return unsafe apply(wide) }
fn imported() -> i32 { return unsafe apply(external) }
pub fn main() -> i32 { return accepted() + aliased() + normalized() }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu)) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let accepted = run Semantic.demandBody(&mut store, &mut request, &id, b"accepted") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let aliased = run Semantic.demandBody(&mut store, &mut request, &id, b"aliased") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let normalized = run Semantic.demandBody(&mut store, &mut request, &id, b"normalized") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let behavior = run Semantic.demandBody(&mut store, &mut request, &id, b"wrongBehavior") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let shape = run Semantic.demandBody(&mut store, &mut request, &id, b"wrongShape") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let imported = run Semantic.demandBody(&mut store, &mut request, &id, b"imported") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(succeeded(&accepted) && succeeded(&aliased) && succeeded(&normalized) && rejectsSpan(&behavior, RejectionCode.TypeMismatch, text, "write", 2)
    && rejectsSpan(&shape, RejectionCode.TypeMismatch, text, "wide", usize.ONE)
    && rejectsSpan(&imported, RejectionCode.ForeignFunctionNotFirstClass, text, "external", usize.ONE),
    "a native callback selects an exported entry with exactly the requested scalar signature and behavioral contract")
  let safePromiseText = """unsafe extern "C" fn apply(callback: extern "C" fn(*const i32) -> i32 with Intrinsic.foreign(memory: "read", locality: "arguments")) -> i32 with Intrinsic.foreign(callbacks: ("callback",))
export "C" fn safeStrong(value: *const i32) -> i32 with Intrinsic.foreign(memory: "read", locality: "arguments") { return 42 }
fn rejectedSafePromise() -> i32 { return unsafe apply(safeStrong) }
pub fn main() -> i32 { return rejectedSafePromise() }
"""
  let mut safePromiseStore = run staticSemantic(
    &id,
    safePromiseText,
    MachineTarget.forId(TargetId.X8664UnknownLinuxGnu)
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let safePromise = run Semantic.demandBody(
    &mut safePromiseStore,
    &mut request,
    &id,
    b"rejectedSafePromise"
  )
    |> Effect.provideMut<Types>(&mut typeTable)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let ordinary = run Semantic.demandBody(&mut store, &mut request, &id, b"rejectedOrdinary")
    |> Effect.provideMut<Types>(&mut typeTable)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let effectful = run Semantic.demandBody(&mut store, &mut request, &id, b"rejectedEffect")
    |> Effect.provideMut<Types>(&mut typeTable)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let generic = run Semantic.demandBody(&mut store, &mut request, &id, b"rejectedGeneric")
    |> Effect.provideMut<Types>(&mut typeTable)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    rejectsSpan(
      &safePromise,
      RejectionCode.ForeignFunctionNotFirstClass,
      safePromiseText,
      "safeStrong",
      usize.ONE
    )
      && rejectsSpan(&ordinary, RejectionCode.TypeMismatch, text, "ordinary", usize.ONE)
      && rejectsSpan(&effectful, RejectionCode.TypeMismatch, text, "effectful", usize.ONE)
      && rejectsSpan(&generic, RejectionCode.TypeMismatch, text, "generic", usize.ONE),
    "strong promises require unsafe export; ordinary, effectful and generic Silk declarations cannot form C addresses"
  )
  let mir = run Semantic.demandMir(&mut store, &mut request, &id, b"accepted")
    |> Effect.provideMut<Types>(&mut typeTable)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    nativeCallbackAddressMir(&store, &mir),
    "the callback address selects its fixed C export alias, and the foreign call carries one pointer lane without hidden diagnostics"
  )
  let mut applicationRequest = Request.forApplication(ModuleId.copy(&id))
  // Keep every negative Body assertion in the original source. The emission control gets
  // a complete valid program, since builds now check its entire loaded declaration closure.
  let buildText = """
unsafe extern "C" fn apply(callback: extern "C" fn(*const i32) -> i32 with Intrinsic.foreign(memory: "read", locality: "arguments")) -> i32 with Intrinsic.foreign(callbacks: ("callback",))
type Callback = extern "C" fn(*const i32) -> i32 with Intrinsic.foreign(memory: "read", locality: "arguments")
unsafe extern "C" fn applyAlias(callback: Callback) -> i32 with Intrinsic.foreign(callbacks: ("callback",))
unsafe extern "C" fn applyPure(callback: extern "C" fn() -> i32 with Intrinsic.foreign(memory: "none", locality: "arguments")) -> i32 with Intrinsic.foreign(callbacks: ("callback",))
unsafe export "C" fn pure() -> i32 with Intrinsic.foreign(memory: "none") { return 42 }
fn normalized() -> i32 { return unsafe applyPure(pure) }
unsafe extern "C" fn external(value: *const i32) -> i32
unsafe export "C" fn read(value: *const i32) -> i32 as "callback_alias" with Intrinsic.foreign(memory: "read", locality: "arguments") { return 42 }
unsafe export "C" fn write(value: *const i32) -> i32 as "callback_mutating" with Intrinsic.foreign(memory: "write", locality: "arguments") { return 42 }
unsafe export "C" fn wide(value: *const i32) -> i64 as "callback_large" with Intrinsic.foreign(memory: "read", locality: "arguments") { return 42 }
fn ordinary(value: *const i32) -> i32 { return 42 }
effect fn effectful(value: *const i32) -> i32 { return 42 }
fn generic<T>(value: *const T) -> i32 { return 42 }
fn accepted() -> i32 { return unsafe apply(read) }
fn aliased() -> i32 { return unsafe applyAlias(read) }
pub fn main() -> i32 { return accepted() + aliased() + normalized() }
"""
  let mut buildStore = run applicationSemantic(
    &id,
    buildText,
    MachineTarget.forId(TargetId.X8664UnknownLinuxGnu)
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut buildRequest = Request.forApplication(ModuleId.copy(&id))
  let built = run buildApplication(&mut buildStore, &mut buildRequest, staticClosureNodes)
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut guarded = false
  if let BackendBuild.Module {text: output, ..} = &built {
    let ir = Bytes.asSlice(&output)
    guarded = containsIr(ir, b"define internal i32 @__silk_foreign_personality")
      && containsIr(ir, b"noinline nounwind personality ptr @__silk_foreign_personality")
      && containsIr(ir, b"invoke i32 @\"apply\"(ptr ") && containsIr(ir, b"invoke i32 @\"applyAlias\"(ptr ") && containsIr(ir, b"invoke i32 @\"applyPure\"(ptr ")
      && containsIr(ir, b"define i32 @\"callback_alias\"(ptr %p0) noinline nounwind personality")
      && containsIr(ir, b"unwind label %v") && containsIr(ir, b"landingpad { ptr, i32 } cleanup\ncall void @llvm.trap()\nunreachable")
  }
  run Testing.expect(guarded, "native calls and callback export entries retain fatal personality frames and enforced unwind edges")
  let missingText = """type Callback = extern "C" fn() -> i32
unsafe extern "C" fn consume(callback: Callback) -> i32
export "C" fn callback() -> i32 { return 42 }
pub fn main() -> i32 { return unsafe consume(callback) }
"""
  let mut missingStore = run applicationSemantic(&id, missingText, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let missing = run buildApplication(&mut missingStore, &mut applicationRequest, staticClosureNodes)
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(soleGap(&missing, GapCode.CAbiCallback),
    "an aliased C callback parameter cannot bypass the complete synchronous callbacks contract")
  let suspendingText = """unsafe extern "C" fn consume(callback: extern "C" fn() -> i32) -> i32 with Intrinsic.foreign(callbacks: ("callback",))
effect fn pauses() -> () { return run Intrinsic.relinquish() }
export "C" fn callback() -> i32 { run pauses() return 42 }
pub fn main() -> i32 { return unsafe consume(callback) }
"""
  let mut suspendingStore = run applicationSemantic(&id, suspendingText, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let suspending = run buildApplication(&mut suspendingStore, &mut applicationRequest, staticClosureNodes)
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut refused = false
  if let BackendBuild.Rejected {first: diagnostic, ..} = &suspending {
    refused = Shared<Rejection>.with<bool>(&diagnostic, fn(value: &Rejection) -> bool {
      return value.code == RejectionCode.ForeignCallback && value.span.start == offsetOf(suspendingText, "callback", 4)
        && value.span.end == value.span.start + 8
    })
  }
  run Testing.expect(refused, "a C callback address rejects a transitively relinquishing exported body at its address occurrence")
  let equivalentText = """unsafe extern "C" fn first(callback: extern "C" fn() -> i32 with Intrinsic.foreign(memory: "none")) -> i32 as "shared_callback" with Intrinsic.foreign(callbacks: ("callback",))
unsafe extern "C" fn second(other: extern "C" fn() -> i32 with Intrinsic.foreign(memory: "none", locality: "arguments")) -> i32 as "shared_callback" with Intrinsic.foreign(callbacks: ("other",))
unsafe export "C" fn callback() -> i32 with Intrinsic.foreign(memory: "none") { return 21 }
pub fn main() -> i32 { return unsafe first(callback) + unsafe second(callback) }
"""
  let mut equivalentStore = run applicationSemantic(&id, equivalentText, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let equivalent = run buildApplication(&mut equivalentStore, &mut applicationRequest, staticClosureNodes)
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut merged = false
  if let BackendBuild.Module {..} = &equivalent { merged = true }
  run Testing.expect(merged, "equivalent normalized callback contracts and renamed parameters share one native symbol")
  let mismatchText = """unsafe extern "C" fn first(callback: extern "C" fn() -> i32 with Intrinsic.foreign(memory: "read")) -> i32 as "shared_callback" with Intrinsic.foreign(callbacks: ("callback",))
unsafe extern "C" fn second(callback: extern "C" fn() -> i32 with Intrinsic.foreign(memory: "write")) -> i32 as "shared_callback" with Intrinsic.foreign(callbacks: ("callback",))
unsafe export "C" fn reads() -> i32 with Intrinsic.foreign(memory: "read") { return 21 }
unsafe export "C" fn writes() -> i32 with Intrinsic.foreign(memory: "write") { return 21 }
pub fn main() -> i32 { return unsafe first(reads) + unsafe second(writes) }
"""
  let mut mismatchStore = run applicationSemantic(&id, mismatchText, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mismatch = run buildApplication(&mut mismatchStore, &mut applicationRequest, staticClosureNodes)
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(nativeCallbackSymbolConflict(&mismatch), "different callback contracts conflict even when both C lanes print ptr")
  let outerText = """unsafe extern "C" fn first(value: i32) -> i32 as "shared_memory" with Intrinsic.foreign(memory: "read")
unsafe extern "C" fn second(value: i32) -> i32 as "shared_memory" with Intrinsic.foreign(memory: "write")
pub fn main() -> i32 { return unsafe first(21) + unsafe second(21) }
"""
  let mut outerStore = run applicationSemantic(&id, outerText, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let outer = run buildApplication(&mut outerStore, &mut applicationRequest, staticClosureNodes)
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(nativeCallbackSymbolConflict(&outer), "different outer memory contracts conflict despite identical machine declarations")
  let opaqueText = """unsafe extern "C" fn first(size: usize) -> ?*mut u8 as "shared_allocator"
unsafe extern "C" fn second(size: usize) -> ?[*]mut u8 as "shared_allocator"
pub fn main() -> i32 { let one = unsafe first(1) let two = unsafe second(1) drop one drop two return 42 }
"""
  let mut opaqueStore = run applicationSemantic(&id, opaqueText, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let opaque = run buildApplication(&mut opaqueStore, &mut applicationRequest, staticClosureNodes)
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut compatible = false
  if let BackendBuild.Module {..} = &opaque { compatible = true }
  run Testing.expect(compatible, "ordinary raw-data-pointer metadata remains opaque at the C machine symbol join")
  let noCaptureText = """unsafe extern "C" fn first(left: ?*mut i32, right: ?*mut i32) -> i32 as "shared_nocapture" with Intrinsic.foreign(noCapture: ("left", "right"))
unsafe extern "C" fn second(a: ?*mut i32, b: ?*mut i32) -> i32 as "shared_nocapture" with Intrinsic.foreign(noCapture: ("b", "a"))
pub fn main() -> i32 { return unsafe first(Intrinsic.pointerNull<i32>(), Intrinsic.pointerNull<i32>()) + unsafe second(Intrinsic.pointerNull<i32>(), Intrinsic.pointerNull<i32>()) }
"""
  let mut noCaptureStore = run applicationSemantic(&id, noCaptureText, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let noCapture = run buildApplication(&mut noCaptureStore, &mut applicationRequest, staticClosureNodes)
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut sameOrdinals = false
  if let BackendBuild.Module {..} = &noCapture { sameOrdinals = true }
  run Testing.expect(sameOrdinals, "renamed and reordered noCapture tuples normalize to the same declaration parameter ordinals")
  let noCaptureMismatchText = """unsafe extern "C" fn first(left: ?*mut i32, right: ?*mut i32) -> i32 as "shared_nocapture" with Intrinsic.foreign(noCapture: ("left", "right"))
unsafe extern "C" fn second(a: ?*mut i32, b: ?*mut i32) -> i32 as "shared_nocapture" with Intrinsic.foreign(noCapture: ("b",))
pub fn main() -> i32 { return unsafe first(Intrinsic.pointerNull<i32>(), Intrinsic.pointerNull<i32>()) + unsafe second(Intrinsic.pointerNull<i32>(), Intrinsic.pointerNull<i32>()) }
"""
  let mut noCaptureMismatchStore = run applicationSemantic(&id, noCaptureMismatchText, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let noCaptureMismatch = run buildApplication(&mut noCaptureMismatchStore, &mut applicationRequest, staticClosureNodes)
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(nativeCallbackSymbolConflict(&noCaptureMismatch), "different noCapture ordinals conflict despite identical C machine declarations")
  return ()
}

// The number of reports a refused build carries.
fn reportCount(build: &BackendBuild) -> usize {
  return match & build.* {
    BackendBuild.Rejected {further, ..} => Vector<Shared<Rejection>>.length(&further) + usize.ONE
    _ => usize.ZERO
  }
}

fn escapeReportedAt(build: &BackendBuild, module: &ModuleId, span: Span, relatedModule: &ModuleId, related: Span) -> bool {
  if let BackendBuild.Rejected {first, further, ..} = &build.* {
    if escapeIs(&first, module, span, relatedModule, related) { return true }
    let rest = Vector<Shared<Rejection>>.asSlice(&further)
    let mut index = usize.ZERO
    while index < rest.length {
      if escapeIs(&rest[index], module, span, relatedModule, related) { return true }
      index = index + usize.ONE
    }
  }
  return false
}

fn escapeIs(selected: &Shared<Rejection>, module: &ModuleId, span: Span, relatedModule: &ModuleId, related: Span) -> bool {
  return Shared<Rejection>.with<bool>(selected, fn(value: &Rejection) -> bool {
    if let Option<RelatedSite>.Some {value: site} = &value.related {
      return value.code == RejectionCode.LocalSharedAccessEscape && ModuleId.equals(&value.module, module)
        && value.span.start == span.start && value.span.end == span.end && ModuleId.equals(&site.module, relatedModule)
        && site.span.start == related.start && site.span.end == related.end
    }
    return false
  })
}

fn spanOf(text: string, spelling: string, occurrence: usize) -> Span {
  let start = offsetOf(text, spelling, occurrence)
  return Span.make(start, start + String.utf8Bytes(spelling).length)
}

test effect fn nonParkingBoundsAreProvedAtBuild() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run nonParkingClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

// #1665: an `Intrinsic.NonParking` value may nest a transfer but never park externally, also
// transitively. A bounded instance owes the proof at the call that reaches it, a finalizer or
// release whose bound no premise carries owes it at its intrinsic run, and a nonparking service
// operation owes it for the selected witness at its call (SEM0139). Valid bounded values build.
effect fn nonParkingClaims() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("nonparking-proof.silk")
  let declarations = """
effect fn guarded<'env, A, E, ?R, ?S, F: once Effect<'env; () ! never ? S> + Intrinsic.NonParking>(
  self: once Effect<'env; A ! E ? R>, finalizer: F) -> A ! E ? R | S {
  return run Intrinsic.finalizeEffectNonParking<A, E, R, S>(move self, move finalizer)
}
effect fn unbounded<'env, A, E, ?R, ?S, F: once Effect<'env; () ! never ? S>>(self: once Effect<'env; A ! E ? R>, finalizer: F)
  -> A ! E ? R | S {
  return run Intrinsic.finalizeEffectNonParking<A, E, R, S>(move self, move finalizer)
}
fn invoke<F: fn() -> i32 + Intrinsic.NonParking>(body: F) -> i32 { return body() }
fn forwards<F: fn() -> i32 + Intrinsic.NonParking>(body: F) -> i32 { return invoke(move body) }
fn ignore<F: fn() -> i32 + Intrinsic.NonParking>(body: F) -> i32 {
  drop body
  return 1
}
effect fn provideMut<'env, ?S, A, P, E, ?R>(self: once Effect<'env; A ! E ? R>, provider: &'env mut P) -> A ! E ? Without<R, S>
where &'env mut P provides S from R {
  let bound = Intrinsic.bindRequirementMut<S>(move self, provider)
  return run bound
}
fn bracket<'env, T, A, E, ?R, ?S>(resource: T,
  use: for<'scope> once fn<'env>(&'scope mut T) -> once Effect<'scope & 'env; A ! E ? R>,
  release: for<'scope> once fn<'env>(&'scope mut T) -> once Effect<'scope & 'env; () ! never ? S>) -> once Effect<'env; A ! E ? R | S> {
  return Intrinsic.useReleaseNonParking<T, A, E, R, S>(move resource, move use, move release)
}
effect<'env> fn scoped<'env, T: 'env, A, E, ?R, ?S,
  Release: for<'scope> once fn<'env>(&'scope mut T) -> once Effect<'scope & 'env; () ! never ? S> + Intrinsic.NonParking>(
  resource: T, use: for<'scope> once fn<'env>(&'scope mut T) -> once Effect<'scope & 'env; A ! E ? R>,
  release: Release) -> A ! E ? R | S {
  return run Intrinsic.useReleaseNonParking<T, A, E, R, S>(move resource, move use, move release)
}
fn observing<'env, S: 'env, A, ?R, F: fn<'static>(&mut S, u8, usize, usize, string<'static>, string<'static>) -> usize>(
  state: S, callback: F, body: once Effect<'env; A ? R>) -> once Effect<'env; A ? R> {
  return Intrinsic.observeDiagnostics<S, A, R, F>(move state, move callback, move body)
}
fn unavailableExecution() -> Intrinsic.Execution<i32> { return unavailableExecution() }
fn noAllocation() -> Intrinsic.Allocation { return noAllocation() }
fn packaged<F: once Effect<'static; i32> + Intrinsic.Detached,
  R: for<'a> fn<'static>(&'a i32) -> () + Intrinsic.Detached + Intrinsic.NonParking>(allocation: Intrinsic.Allocation, body: F, ready: R)
  -> Intrinsic.Execution<i32> {
  unsafe { return Intrinsic.executionFromAllocation<i32, F, i32, R>(move allocation, move body, 1, move ready) }
  return unavailableExecution()
}
fn readyAt(state: &i32) -> () {}
service Port { effect fn close() -> () ? &mut Port with Intrinsic.nonParking() }
effect fn closing() -> () ? &mut Port { run Port.close() }
effect fn work() -> i32 { return 1 }
"""
  let rejectedText = """
effect fn pause() -> () { return run Intrinsic.relinquish() }
effect fn release() -> () { return run pause() }
fn parked() -> i32 {
  run pause()
  return 2
}
fn alsoParked() -> i32 {
  run pause()
  return 4
}
fn neverRun() -> i32 {
  run pause()
  return 5
}
fn later<T>(value: T) -> i32 {
  drop value
  run pause()
  return 8
}
fn viaGeneric() -> i32 { return later<i32>(3) }
effect fn transfers() -> () { return run Intrinsic.suspendEffect(pause()) }
struct Sleepy {}
impl Intrinsic.Drop for Sleepy {
  fn drop(self: &mut Sleepy) -> () {
    run pause()
    return ()
  }
}
fn drops() -> i32 {
  let sleepy = Sleepy {}
  drop sleepy
  return 6
}
effect fn useSleepy(sleepy: &mut Sleepy) -> () { return () }
effect fn releaseSleepy(sleepy: &mut Sleepy) -> () { return () }
effect fn sleepyBody(sleepy: Sleepy) -> i32 {
  drop sleepy
  return 0
}
fn releases() -> i32 {
  let inner = packaged(noAllocation(), sleepyBody(Sleepy {}), readyAt)
  drop inner
  return 10
}
struct Restless {}
effect fn shut(self: &mut Restless) -> () { return run pause() }
impl Port for Restless { close: Restless.shut }
fn closed() -> i32 {
  let mut port = Restless {}
  run closing() |> provideMut<Port>(&mut port)
  return 3
}
pub fn main() -> i32 {
  let guardedRun = run guarded(work(), release())
  let invoked = invoke(parked)
  let forwarded = forwards(alsoParked)
  let unboundedRun = run unbounded(work(), release())
  let serviced = closed()
  let ignored = ignore(neverRun)
  let dropped = invoke(drops)
  let closure = invoke(fn() -> i32 {
    run pause()
    return 9
  })
  let generic = invoke(viaGeneric)
  let transferred = run guarded(work(), transfers())
  let bracketed = run guarded(work(), bracket(Sleepy {}, useSleepy, releaseSleepy))
  let released = invoke(releases)
  let scopedRun = run scoped(Sleepy {}, useSleepy, releaseSleepy)
  return guardedRun
}
"""
  let rejected = run nonParkingBuild(&id, declarations, rejectedText)
  let base = String.utf8Bytes(declarations).length
  run Testing.expect(reportCount(&rejected) == 14,
    "a build reports each unproved NonParking site once and emits no artifact")
  run Testing.expect(unprovedAt(&rejected, &id, base + offsetOf(rejectedText, "guarded(work(), release())", usize.ZERO)),
    "a bounded finalizer that parks through a helper is rejected at the call that reaches the bounded instance")
  run Testing.expect(unprovedAt(&rejected, &id, base + offsetOf(rejectedText, "invoke(parked)", usize.ZERO)),
    "a bounded callable that parks is rejected at the call that reaches the bounded instance")
  run Testing.expect(unprovedAt(&rejected, &id, base + offsetOf(rejectedText, "forwards(alsoParked)", usize.ZERO))
    && unprovedAt(&rejected, &id, offsetOf(declarations, "invoke(move body)", usize.ZERO)),
    "a forwarded bound is owed by each bounded instance's own incoming call")
  run Testing.expect(unprovedAt(&rejected, &id, offsetOf(declarations, "run Intrinsic.finalizeEffectNonParking", usize.ONE)),
    "a nonparking finalizer whose bound no premise carries is rejected at its intrinsic run")
  run Testing.expect(unprovedAt(&rejected, &id, offsetOf(declarations, "Port.close()", usize.ZERO)),
    "a nonparking service operation is rejected at its call when the selected witness parks")
  run Testing.expect(unprovedAt(&rejected, &id, base + offsetOf(rejectedText, "invoke(drops)", usize.ZERO)),
    "a bounded callable that drops a value whose Drop hook parks is rejected")
  run Testing.expect(unprovedAt(&rejected, &id, base + offsetOf(rejectedText, "ignore(neverRun)", usize.ZERO)),
    "a bounded value the program never invokes is still proved, as in the bootstrap, and rejected when it parks")
  run Testing.expect(unprovedAt(&rejected, &id, base + offsetOf(rejectedText, "invoke(fn() -> i32 {", usize.ZERO)),
    "a bounded closure that parks is rejected")
  run Testing.expect(unprovedAt(&rejected, &id, base + offsetOf(rejectedText, "invoke(viaGeneric)", usize.ZERO)),
    "a bounded callable that parks through a generic instantiation is rejected")
  run Testing.expect(unprovedAt(&rejected, &id, base + offsetOf(rejectedText, "guarded(work(), transfers())", usize.ZERO)),
    "a finalizer that parks inside a nested transfer is rejected: the park propagates through Effect.suspend")
  run Testing.expect(unprovedAt(&rejected, &id, base + offsetOf(rejectedText, "guarded(work(), bracket(Sleepy {}", usize.ZERO)),
    "a composite finalizer whose runner drops a resource with a parking Drop hook is rejected")
  run Testing.expect(unprovedAt(&rejected, &id, base + offsetOf(rejectedText, "invoke(releases)", usize.ZERO)),
    "a bounded callable that releases an Execution whose package glue parks is rejected")
  run Testing.expect(unprovedAt(&rejected, &id, offsetOf(declarations, "run Intrinsic.useReleaseNonParking", usize.ZERO)),
    "a carried release does not cover the resource the bracket drops after it: a parking resource Drop hook is rejected at the run")
  let acceptedText = """
effect fn tidy() -> () { return () }
fn plain() -> i32 { return 2 }
fn calm() -> i32 { return 5 }
struct Quiet {}
effect fn useQuiet(quiet: &mut Quiet) -> () { return () }
effect fn releaseQuiet(quiet: &mut Quiet) -> () { return () }
effect fn plainBody() -> i32 { return 0 }
fn releasesCalm() -> i32 {
  let inner = packaged(noAllocation(), plainBody(), readyAt)
  drop inner
  return 10
}
struct Calm {}
effect fn shut(self: &mut Calm) -> () { return () }
impl Port for Calm { close: Calm.shut }
fn closed() -> i32 {
  let mut port = Calm {}
  run closing() |> provideMut<Port>(&mut port)
  return 3
}
pub fn main() -> i32 {
  let guardedRun = run guarded(work(), tidy())
  let invoked = invoke(plain)
  let forwarded = forwards(plain)
  let unboundedRun = run unbounded(work(), tidy())
  let serviced = closed()
  let ignored = ignore(calm)
  let bracketed = run guarded(work(), bracket(Quiet {}, useQuiet, releaseQuiet))
  let released = invoke(releasesCalm)
  let scopedRun = run scoped(Quiet {}, useQuiet, releaseQuiet)
  return guardedRun
}
"""
  let accepted = run nonParkingBuild(&id, declarations, acceptedText)
  run Testing.expect(match &accepted { BackendBuild.Module {..} => true _ => false },
    "bounded finalizers, callables, forwarded bounds, service witnesses, composites, package releases and a never-invoked bounded value that never park build")
  // Every diagnostic an observed body reports invokes the observer, so the observation owes the
  // callback's proof where it runs. Observation rebuilds the whole program, so it gets its own one.
  let observedText = """
effect fn pause() -> () { return run Intrinsic.relinquish() }
fn noisy(state: &mut i32, event: u8, first: usize, second: usize, identity: string<'static>, label: string<'static>) -> usize {
  run pause()
  return 0
}
fn quiet(state: &mut i32, event: u8, first: usize, second: usize, identity: string<'static>, label: string<'static>) -> usize {
  return 0
}
pub fn main() -> i32 {
  let parking = run observing(0, noisy, work())
  let calm = run observing(0, quiet, work())
  return calm
}
"""
  let observed = run nonParkingBuild(&id, declarations, observedText)
  run Testing.expect(reportCount(&observed) == usize.ONE
    && unprovedAt(&observed, &id, base + offsetOf(observedText, "run observing(0, noisy, work())", usize.ZERO)),
    "an observer callback that parks is rejected where the observation runs, and a calm one is not")
  // A plain function that returns an Effect for its caller to run is not lowered natively yet, as a
  // bracket's release (here returning a composite) or as a bounded callable whose result is run.
  // It is refused as unsupported rather than accepted unproved (COMPILER_COMPATIBILITY.md); the
  // NonParking proof also treats such a target as inexact.
  let compositeText = """
fn fin<'env, A, E, ?R, ?S>(a: once Effect<'env; A ! E ? R>, b: once Effect<'env; () ! never ? S>) -> once Effect<'env; A ! E ? R | S> {
  return Intrinsic.finalizeEffect<A, E, R, S>(move a, move b)
}
effect fn calmUnit() -> () { return () }
struct Quiet {}
effect fn useQuiet(quiet: &mut Quiet) -> () { return () }
fn releaseComposite(quiet: &mut Quiet) -> once Effect<()> { return fin(calmUnit(), calmUnit()) }
pub fn main() -> i32 {
  run bracket(Quiet {}, useQuiet, releaseComposite)
  return 0
}
"""
  let composite = run nonParkingBuild(&id, declarations, compositeText)
  run Testing.expect(soleUnsupported(&composite), "a release that returns a composite Effect to run inline is refused as unsupported")
  let returnedText = """
effect fn pause() -> () { return run Intrinsic.relinquish() }
fn parky() -> once Effect<'static; ()> { return pause() }
effect fn go<F: fn<'static>() -> once Effect<'static; ()> + Intrinsic.NonParking>(f: F) -> () {
  let pending = f()
  return run move pending
}
pub fn main() -> i32 {
  run go(parky)
  return 0
}
"""
  let returned = run nonParkingBuild(&id, declarations, returnedText)
  run Testing.expect(soleUnsupported(&returned),
    "a NonParking callable whose result Effect its caller runs is refused as unsupported, never proved by its own instance")
  // A nested transfer is not an external park. This entry runtime provides no execution storage,
  // so the build stops at the suspension boundary after the NonParking proof succeeds.
  let nestedText = """
fn nests() -> i32 { return run Intrinsic.suspendEffect(effect { return 3 }) }
pub fn main() -> i32 { return invoke(nests) }
"""
  let nested = run nonParkingBuild(&id, declarations, nestedText)
  let mut transferred = false
  if let BackendBuild.Rejected {first, further, ..} = &nested {
    transferred = Vector<Shared<Rejection>>.length(&further) == usize.ZERO
      && Shared<Rejection>.with<bool>(&first, fn(value: &Rejection) -> bool { return value.code == RejectionCode.InvalidConfiguration })
  }
  run Testing.expect(transferred, "a bounded callable that only nests a transfer satisfies NonParking")
}

// Builds one application module made of the shared declarations followed by `text`.
effect fn nonParkingBuild(id: &ModuleId, declarations: string, text: string) -> BackendBuild
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut bytes = run Bytes.copy(String.utf8Bytes(declarations))
  run Bytes.append(&mut bytes, String.utf8Bytes(text))
  let source = Option<Bytes>.some(move bytes)
  let empty = Revision.make()
  let revision = run Revision.publish(&empty, id, &source)
  let runtime = run withEntryRuntime(&revision)
  let mut store = Semantic.traced(move runtime, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu), Option<FinalProfile>.none())
  let mut request = Request.forApplication(ModuleId.copy(id))
  return run buildApplication(&mut store, &mut request, staticClosureNodes)
}

fn soleUnsupported(build: &BackendBuild) -> bool {
  if let BackendBuild.Rejected {first, further, ..} = &build.* {
    return Vector<Shared<Rejection>>.length(&further) == usize.ZERO
      && Shared<Rejection>.with<bool>(&first, fn(value: &Rejection) -> bool { return value.code == RejectionCode.Unsupported })
  }
  return false
}

fn unprovedAt(build: &BackendBuild, module: &ModuleId, start: usize) -> bool {
  if let BackendBuild.Rejected {first, further, ..} = &build.* {
    if unprovedIs(&first, module, start) { return true }
    let rest = Vector<Shared<Rejection>>.asSlice(&further)
    let mut index = usize.ZERO
    while index < rest.length {
      if unprovedIs(&rest[index], module, start) { return true }
      index = index + usize.ONE
    }
  }
  return false
}

fn unprovedIs(selected: &Shared<Rejection>, module: &ModuleId, start: usize) -> bool {
  return Shared<Rejection>.with<bool>(selected, fn(value: &Rejection) -> bool {
    return value.code == RejectionCode.UnsatisfiedExecutableProperty && ModuleId.equals(&value.module, module) && value.span.start == start
  })
}

test effect fn localSharedAccessRejectsEveryReachedEscape() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run localSharedEscapeClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

// SHARED-003: nothing a held access's callback reaches may run an Effect or notify an execution.
// The build reports each escape at its own span, in its own module, related to the call that named
// the callback, once per pair; no artifact is produced.
effect fn localSharedEscapeClaims() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("local-shared-escapes.silk")
  let parkingId = run module("parking.silk")
  let text = """
import parking { parks }
struct Empty {}
struct Armed { reference: Intrinsic.ExecutionRef }
struct Cell { value: i32 slot: Empty | Armed }
effect fn pause() -> () { return run Intrinsic.relinquish() }
fn suspends(cell: &mut Cell) -> i32 {
  run pause()
  return cell.value
}
fn indirect(cell: &mut Cell) -> i32 { return parks() }
fn spin(n: i32) -> i32 {
  if n > 0 { return spin(n - 1) }
  run pause()
  return 0
}
fn recursive(cell: &mut Cell) -> i32 { return spin(3) }
fn signals(cell: &mut Cell) -> i32 {
  let selected = Intrinsic.replace(cell.slot, Empty {})
  return match move selected {
    Empty {} => 0
    Armed { reference } => {
      Intrinsic.executionNotify(&reference)
      return 1
    }
  }
}
fn calm(cell: &mut Cell) -> i32 { return cell.value }
fn busy() -> i32 { return 0 }
fn wrap(core: &Intrinsic.SharedCore<Cell>, use: once fn(&mut Cell) -> i32) -> i32 {
  return Intrinsic.sharedWithMut<Cell, i32>(core, move use, busy)
}
// Never called: the build only needs a core to name the accesses below.
fn unavailable() -> Intrinsic.SharedCore<Cell> { return unavailable() }
pub fn main() -> i32 {
  let core = unavailable()
  let direct = Intrinsic.sharedWithMut<Cell, i32>(&core, suspends, busy)
  let forwarded = wrap(&core, indirect)
  let looping = wrap(&core, recursive)
  let notified = wrap(&core, signals)
  let clean = wrap(&core, calm)
  drop core
  return direct + forwarded + looping + notified + clean
}
"""
  let parkingText = """
pub fn parks() -> i32 {
  run Intrinsic.relinquish()
  return 1
}
"""
  let withParking = run Revision.publish(&Revision.make(), &parkingId, &run present(parkingText))
  let revision = run Revision.publish(&withParking, &id, &run present(text))
  let mut store = Semantic.traced(run withEntryRuntime(&revision), MachineTarget.forId(TargetId.X8664UnknownLinuxGnu), Option<FinalProfile>.none())
  let mut request = Request.forApplication(ModuleId.copy(&id))
  let root = run Semantic.demandBody(&mut store, &mut request, &id, b"main")
  run Testing.expect(
    hasBorrowStatus(&root, BorrowStatus.Checked),
    "St3 can clear a region-closed caller, but the build must still judge every reached callback escape"
  )
  let built = run buildApplication(&mut store, &mut request, staticClosureNodes)
  run Testing.expect(reportCount(&built) == 4,
    "a refused build reports each escaping access once and emits no artifact; a calm callback adds nothing")
  run Testing.expect(escapeReportedAt(&built, &id, spanOf(text, "run pause()", usize.ZERO),
    &id, spanOf(text, "Intrinsic.sharedWithMut<Cell, i32>(&core, suspends, busy)", usize.ZERO)),
    "a callback's own run escapes, related to the access that names it")
  run Testing.expect(escapeReportedAt(&built, &parkingId, spanOf(parkingText, "run Intrinsic.relinquish()", usize.ZERO),
    &id, spanOf(text, "wrap(&core, indirect)", usize.ZERO)),
    "a run in a plain callee in another module escapes there, related to the call that named the callback through a wrapper")
  run Testing.expect(escapeReportedAt(&built, &id, spanOf(text, "run pause()", usize.ONE),
    &id, spanOf(text, "wrap(&core, recursive)", usize.ZERO)),
    "a recursive callee is walked exactly: the run its cycle reaches escapes")
  run Testing.expect(escapeReportedAt(&built, &id, spanOf(text, "Intrinsic.executionNotify(&reference)", usize.ZERO),
    &id, spanOf(text, "wrap(&core, signals)", usize.ZERO)),
    "a direct readiness notification inside the callback escapes")
}


test effect fn localSharedAccessRejectsDiscoveredTests() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run discoveredEscapeClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

// The `silk test` entry builds a runner application over the discovery root's catalog; the same
// build pass judges the accesses the discovered tests reach, so a refused test yields no runner.
effect fn discoveredEscapeClaims() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let runner = run module("runner.silk")
  let checks = run module("checks.silk")
  let runnerText = """
pub fn main() -> i32 {
  static for descriptor in Intrinsic.tests() {
    let body = Intrinsic.testFunction(descriptor)
    body()
  }
  return 0
}
"""
  let checksText = """
struct Cell { value: i32 }
effect fn pause() -> () { return run Intrinsic.relinquish() }
fn parked(cell: &mut Cell) -> i32 {
  run pause()
  return cell.value
}
fn busy() -> i32 { return 0 }
fn wrap(core: &Intrinsic.SharedCore<Cell>, use: once fn(&mut Cell) -> i32) -> i32 {
  return Intrinsic.sharedWithMut<Cell, i32>(core, move use, busy)
}
// Never called: the build only needs a core to name the access below.
fn unavailable() -> Intrinsic.SharedCore<Cell> { return unavailable() }
test fn heldAccessParks() {
  let core = unavailable()
  let value = wrap(&core, parked)
  drop core
  drop value
}
"""
  let withChecks = run Revision.publish(&Revision.make(), &checks, &run present(checksText))
  let revision = run Revision.publish(&withChecks, &runner, &run present(runnerText))
  let mut store = Semantic.traced(run withEntryRuntime(&revision), MachineTarget.forId(TargetId.X8664UnknownLinuxGnu), Option<FinalProfile>.none())
  Semantic.selectDiscovery(&mut store, ModuleId.copy(&checks), Bytes.make())
  let mut request = Request.forApplication(ModuleId.copy(&runner))
  let built = run buildApplication(&mut store, &mut request, staticClosureNodes)
  run Testing.expect(reportCount(&built) == usize.ONE && escapeReportedAt(&built, &checks, spanOf(checksText, "run pause()", usize.ZERO),
    &checks, spanOf(checksText, "wrap(&core, parked)", usize.ZERO)),
    "a discovered test's escaping access refuses the runner build at the escape, related to the test's call")
}

test effect fn nativeIndirectCallbacksRequireUnsafeAndUseCAbiLanes() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("native-indirect-callback.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
export "C" fn narrow(value: i8) -> i8 { return value }
fn invoke(callback: extern "C" fn(i8) -> i8) -> i8 { return unsafe callback(-7) }
fn unacknowledged(callback: extern "C" fn(i8) -> i8) -> i8 { return callback(-7) }
fn missing(callback: extern "C" fn(i8) -> i8) -> i8 { return unsafe callback() }
pub fn main() -> i32 { let value = invoke(narrow) drop value return 42 }
"""
  let mut store = run applicationSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.forApplication(ModuleId.copy(&id))
  let unacknowledged = run Semantic.demandBody(&mut store, &mut request, &id, b"unacknowledged")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let missing = run Semantic.demandBody(&mut store, &mut request, &id, b"missing")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsSpan(&unacknowledged, RejectionCode.UnsafeAcknowledgement, text, "callback(-7)", usize.ONE)
    && rejectsSpan(&missing, RejectionCode.CallArity, text, "callback()", usize.ZERO),
    "a C function pointer invocation requires an unsafe acknowledgement and its complete written arity")
  // Keep every negative Body assertion in the original source. The emission control gets
  // a complete valid program, since builds now check its entire loaded declaration closure.
  let buildText = """
export "C" fn narrow(value: i8) -> i8 { return value }
fn invoke(callback: extern "C" fn(i8) -> i8) -> i8 { return unsafe callback(-7) }
pub fn main() -> i32 { let value = invoke(narrow) drop value return 42 }
"""
  let mut buildStore = run applicationSemantic(
    &id,
    buildText,
    MachineTarget.forId(TargetId.X8664UnknownLinuxGnu)
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut buildRequest = Request.forApplication(ModuleId.copy(&id))
  let built = run buildApplication(&mut buildStore, &mut buildRequest, staticClosureNodes)
    |> Effect.provideMut<Types>(&mut typeTable)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut classified = false
  if let BackendBuild.Module {text: output, ..} = &built {
    let ir = Bytes.asSlice(&output)
    classified = containsIr(ir, b"invoke signext i8 %v") && containsIr(ir, b"(i8 signext -7) to label %v")
      && containsIr(ir, b"define signext i8 @\"narrow\"(i8 signext %p0) noinline nounwind personality")
      && containsIr(ir, b"landingpad { ptr, i32 } cleanup\ncall void @llvm.trap()\nunreachable")
  }
  run Testing.expect(classified, "an indirect C call uses target C narrow-lane extensions and retains its fatal unwind frame")
  return ()
}

fn nativeCallbackSymbolConflict(built: &BackendBuild) -> bool {
  if let BackendBuild.Rejected {first: diagnostic, ..} = &built.* {
    return Shared<Rejection>.with<bool>(&diagnostic, fn(value: &Rejection) -> bool {
      return value.code == RejectionCode.ForeignSymbolConflict
    })
  }
  return false
}

fn nativeCallbackAddressMir(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>) -> bool {
  let selected = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      let blocks = Vector<MirBlock>.asSlice(&function.blocks)
      let mut address = false
      let mut boundary = false
      let mut at = usize.ZERO
      while at < blocks.length {
        let statements = Vector<MirStatement>.asSlice(&blocks[at].statements)
        let mut statement = usize.ZERO
        while statement < statements.length {
          if let MirStatement.Assign {value: MirRvalue.FunctionAddress {key: InstanceKey.Export {function: identity, symbol}}, ..} = &statements[statement] {
            address = Shared<DeclarationId>.with<bool>(&identity, fn(value: &DeclarationId) -> bool {
              return DeclarationId.named(value, b"read")
            }) && Shared<Bytes>.with<bool>(&symbol, fn(value: &Bytes) -> bool {
              return sameBytes(Bytes.asSlice(value), b"callback_alias")
            })
          }
          statement = statement + usize.ONE
        }
        if let MirTerminator.Call {callee: MirCallee.Extern {..}, arguments, providers, diagnostics, ..} = &blocks[at].terminator {
          boundary = Vector<MirOperand>.length(&arguments) == usize.ONE && Vector<MirOperand>.length(&providers) == usize.ZERO
          if let Option<MirDiagnostics>.Some {..} = &diagnostics { return false }
        }
        at = at + usize.ONE
      }
      return address && boundary
    }
  }
  return false
}

test effect fn foreignIntegerVariadicsKeepTheirBoundaryRules() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("foreign-variadic-boundaries.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """unsafe extern "C" fn receive(tag: i32, ...) -> i32
unsafe extern "C" fn fixed(tag: i32) -> i32
unsafe extern "C" fn inner() -> i32
unsafe extern "C" fn noFixed(...) -> i32
fn missing() -> i32 { return unsafe receive() }
fn excess() -> i32 { return unsafe fixed(1, 2) }
fn wrongFixed() -> i32 { return unsafe receive(true, 2) }
fn unacknowledged() -> i32 { return receive(1) }
fn nestedMissing() -> i32 { return unsafe receive(1, inner()) }
fn zeroFixed() -> i32 { return unsafe noFixed(1) }
fn named() -> () { let chosen = receive drop chosen }
fn ordinary(value: i32, ...) -> i32 { return value }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu)) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let missing = run Semantic.demandBody(&mut store, &mut request, &id, b"missing") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let excess = run Semantic.demandBody(&mut store, &mut request, &id, b"excess") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let wrong = run Semantic.demandBody(&mut store, &mut request, &id, b"wrongFixed") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let unacknowledged = run Semantic.demandBody(&mut store, &mut request, &id, b"unacknowledged") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let nested = run Semantic.demandBody(&mut store, &mut request, &id, b"nestedMissing") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let empty = run Semantic.demandBody(&mut store, &mut request, &id, b"zeroFixed") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let named = run Semantic.demandBody(&mut store, &mut request, &id, b"named") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let ordinary = run Semantic.demandSignature(&mut store, &mut request, &id, b"ordinary") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsSpan(&missing, RejectionCode.CallArity, text, "receive()", usize.ZERO)
    && rejectsSpan(&excess, RejectionCode.CallArity, text, "fixed(1, 2)", usize.ZERO)
    && rejectsSpan(&wrong, RejectionCode.TypeMismatch, text, "true", usize.ZERO)
    && rejectsSpan(&unacknowledged, RejectionCode.UnsafeAcknowledgement, text, "receive(1)", usize.ZERO)
    && rejectsSpan(&nested, RejectionCode.UnsafeAcknowledgement, text, "inner()", usize.ONE)
    && rejectsSpan(&empty, RejectionCode.ForeignVariadic, text, "noFixed(1)", usize.ZERO)
    && rejectsSpan(&named, RejectionCode.ForeignFunctionNotFirstClass, text, "receive", 5)
    && rejectsSpan(&ordinary, RejectionCode.Unsupported, text, "fn ordinary(value: i32, ...) -> i32 { return value }", usize.ZERO),
    "variadic imports keep fixed arity/type, per-call unsafe authority, nonempty fixed prefix and first-class/ordinary definition boundaries")
  let exportId = run module("foreign-variadic-export.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let exportText = """export "C" fn exported(value: i32, ...) -> i32 { return value }
pub fn main() -> i32 { return 0 }
"""
  let exportSource = run present(exportText) |> Effect.provideMut<Allocator>(&mut allocator)
  let conflictId = run module("foreign-variadic-conflict.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let conflictText = """unsafe extern "C" fn fixed(value: i32) -> i32 as "shared_symbol"
unsafe extern "C" fn varying(value: i32, ...) -> i32 as "shared_symbol"
pub fn main() -> i32 { return unsafe fixed(1) + unsafe varying(1) }
"""
  let conflictSource = run present(conflictText) |> Effect.provideMut<Allocator>(&mut allocator)
  let targetId = run module("foreign-variadic-target.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let targetText = """unsafe extern "C" fn receive(value: i32, ...) -> i32
pub fn main() -> i32 { return unsafe receive(1, 2) }
"""
  let targetSource = run present(targetText) |> Effect.provideMut<Allocator>(&mut allocator)
  let first = run Revision.publish(&Revision.make(), &exportId, &exportSource) |> Effect.provideMut<Allocator>(&mut allocator)
  let second = run Revision.publish(&first, &conflictId, &conflictSource) |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&second, &targetId, &targetSource) |> Effect.provideMut<Allocator>(&mut allocator)
  let nativeRevision = run withEntryRuntime(&revision) |> Effect.provideMut<Allocator>(&mut allocator)
  let unsupportedRevision = run withEntryRuntime(&revision) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut native = Semantic.traced(move nativeRevision, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu), Option<FinalProfile>.none())
  let mut unsupported = Semantic.traced(move unsupportedRevision, MachineTarget.forId(TargetId.Wasm32UnknownUnknown), Option<FinalProfile>.none())
  let mut backendRequest = Request.forApplication(ModuleId.copy(&conflictId))
  let exportRoots = [ModuleId.copy(&exportId), ModuleId.copy(&conflictId)]
  let exported = run Semantic.buildArtifact(&mut native, &mut backendRequest, Option<&ModuleId>.some(&exportId), &exportRoots, staticClosureNodes) |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let conflict = run buildApplication(&mut native, &mut backendRequest, staticClosureNodes) |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut unsupportedRequest = Request.forApplication(ModuleId.copy(&targetId))
  let target = run buildApplication(&mut unsupported, &mut unsupportedRequest, staticClosureNodes) |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut conflicted = false
  if let BackendBuild.Rejected {first: diagnostic, ..} = &conflict {
    conflicted = Shared<Rejection>.with<bool>(&diagnostic, fn(value: &Rejection) -> bool {
      return value.code == RejectionCode.ForeignSymbolConflict
    })
  }
  run Testing.expect(variadicGap(&exported, GapCode.CAbiVariadic, exportText, "export \"C\" fn exported(value: i32, ...) -> i32 { return value }")
    && conflicted && soleGap(&target, GapCode.CAbiTarget),
    "a variadic export retains its exact named boundary, a target without the C ABI stops at its first C boundary, and fixed/variadic declarations cannot share one reached native symbol")
  return ()
}

fn variadicRevisionBody(body: &TypedBody, caller: &ModuleId, supplier: &ModuleId) -> bool {
  if !ModuleId.equals(DeclarationId.moduleId(TypedBody.declarationId(body)), caller)
    || !DeclarationId.named(TypedBody.declarationId(body), b"probe") { return false }
  let nodes = TypedBody.nodeSlice(body)
  let locals = TypedBody.localSlice(body)
  let handles = TypedBody.foreignHandles(body)
  if locals.length != usize.ONE || handles.length != usize.ONE
    || TypedBody.runtimeBodies(body).length != usize.ZERO || !variadicPrimitive(&locals[usize.ZERO].ty, b"u16") { return false }
  let mut calls = usize.ZERO
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {ty, form: BodyExpression.ForeignCall {declaration, arguments, variadicArguments}} = &nodes[at].kind {
      if !variadicImport(&declaration, supplier) || !variadicPrimitive(&ty, b"i32")
        || !Shared<DeclarationId>.with<bool>(&handles[usize.ZERO], fn(value: &DeclarationId) -> bool {
          return DeclarationId.equals(value, &declaration)
        }) { return false }
      let supplied = Vector<BodyNodeId>.asSlice(&arguments)
      if supplied.length != 2 || supplied[usize.ZERO].index >= nodes.length || supplied[usize.ONE].index >= nodes.length { return false }
      if !variadicFixedInteger(&nodes[supplied[usize.ZERO].index])
        || !variadicLocalOperand(&nodes[supplied[usize.ONE].index], usize.ZERO, b"u16") { return false }
      if !Shared<Vector<CAbi.VariadicArgument>>.with<bool>(&variadicArguments, fn(values: &Vector<CAbi.VariadicArgument>) -> bool {
        let records = Vector<CAbi.VariadicArgument>.asSlice(values)
        return records.length == usize.ONE && variadicPair(&records[usize.ZERO], b"u16", b"i32")
      }) { return false }
      calls = calls + usize.ONE
    }
    at = at + usize.ONE
  }
  return calls == usize.ONE
}

fn variadicRevisionAnswer(answer: &Shared<Result<Answer, NoRejection>>, caller: &ModuleId, supplier: &ModuleId) -> bool {
  let selected = Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(answer, checkedBody)
  if let Option<Shared<TypedBody>>.Some {value} = move selected {
    return Shared<TypedBody>.with<bool>(&value, fn(body: &TypedBody) -> bool { return variadicRevisionBody(body, caller, supplier) })
  }
  return false
}

test effect fn foreignIntegerVariadicsInvalidateImportedSignatureStatus() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let caller = run module("variadic-revision.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let supplier = run module("variadic_supplier.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = "import variadic_supplier { receive }\nfn probe(value: u16) -> i32 { return unsafe receive(1, value) }\n"
  let authored = run present(text) |> Effect.provideMut<Allocator>(&mut allocator)
  let varying = run present("pub unsafe extern \"C\" fn receive(tag: i32, ...) -> i32\n") |> Effect.provideMut<Allocator>(&mut allocator)
  let fixed = run present("pub unsafe extern \"C\" fn receive(tag: i32) -> i32\n") |> Effect.provideMut<Allocator>(&mut allocator)
  let first = run Revision.publish(&Revision.make(), &caller, &authored) |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&first, &supplier, &varying) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut warm = makeSemantic(run Revision.copy(&revision) |> Effect.provideMut<Allocator>(&mut allocator))
  let mut request = Request.make()
  let initial = run Semantic.demandBody(&mut warm, &mut request, &caller, b"probe") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(variadicRevisionAnswer(&initial, &caller, &supplier),
    "the authored imported variadic call retains its actual u16 parameter and independent i32 tail promotion")
  let changed = run Revision.publish(&revision, &supplier, &fixed) |> Effect.provideMut<Allocator>(&mut allocator)
  let copiedChanged = run Revision.copy(&changed) |> Effect.provideMut<Allocator>(&mut allocator)
  run Semantic.update(&mut warm, move copiedChanged) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut cold = makeSemantic(run Revision.copy(&changed) |> Effect.provideMut<Allocator>(&mut allocator))
  let mut coldRequest = Request.make()
  let cachedFixed = run Semantic.demandBody(&mut warm, &mut request, &caller, b"probe") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let freshFixed = run Semantic.demandBody(&mut cold, &mut coldRequest, &caller, b"probe") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsSpan(&cachedFixed, RejectionCode.CallArity, text, "receive(1, value)", usize.ZERO)
    && rejectsSpan(&freshFixed, RejectionCode.CallArity, text, "receive(1, value)", usize.ZERO),
    "removing only the imported ellipsis invalidates the unchanged caller and agrees with a fresh store's exact arity rejection")
  run Testing.expect(agreesWithFresh(&cachedFixed, &freshFixed), "the fixed-arity caller agrees with a fresh store of the same revision")
  let restored = run Revision.publish(&changed, &supplier, &varying) |> Effect.provideMut<Allocator>(&mut allocator)
  let copiedRestored = run Revision.copy(&restored) |> Effect.provideMut<Allocator>(&mut allocator)
  run Semantic.update(&mut warm, move copiedRestored) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut restoredCold = makeSemantic(run Revision.copy(&restored) |> Effect.provideMut<Allocator>(&mut allocator))
  let mut restoredRequest = Request.make()
  let cachedVarying = run Semantic.demandBody(&mut warm, &mut request, &caller, b"probe") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let freshVarying = run Semantic.demandBody(&mut restoredCold, &mut restoredRequest, &caller, b"probe") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(variadicRevisionAnswer(&cachedVarying, &caller, &supplier) && variadicRevisionAnswer(&freshVarying, &caller, &supplier),
    "restoring the real variadic contract retypes the unchanged caller and agrees with fresh source-owned tail evidence")
  run Testing.expect(agreesWithFresh(&cachedVarying, &freshVarying), "the restored variadic caller agrees with a fresh store of the same revision")
  let hitsBefore = hits(Semantic.eventLog(&warm), Family.Body)
  let startsBefore = starts(Semantic.eventLog(&warm), Family.Body)
  run Semantic.update(&mut warm, move restored) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut sameRequest = Request.make()
  let same = run Semantic.demandBody(&mut warm, &mut sameRequest, &caller, b"probe") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(variadicRevisionAnswer(&same, &caller, &supplier)
    && hits(Semantic.eventLog(&warm), Family.Body) == hitsBefore + usize.ONE
    && starts(Semantic.eventLog(&warm), Family.Body) == startsBefore,
    "the unchanged source head reuses the same strict checked body without restarting its semantic query")
  run Testing.expect(agreesWithFresh(&same, &freshVarying), "the reused variadic caller agrees with a fresh store of the same revision")
  return ()
}

// B5 proves the typed place shape; native execution is covered by the shared corpus.
test effect fn referencesRetainLoansAndLowerProjectedStores() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("reference-mir.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut store = run applicationSemantic(
    &id,
    """
fn read(value: &i32) -> i32 { return value.* }
fn store(value: &mut i32) -> () { set(&mut value) }
fn set(value: &mut i32) -> () { value.* = 42 }
pub fn main() -> i32 {
  let mut value = 0
  store(&mut value)
  return read(&value)
}
""",
    MachineTarget.forId(TargetId.X8664UnknownLinuxGnu),
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.forApplication(ModuleId.copy(&id))
  let body = run Semantic.demandBody(&mut store, &mut request, &id, b"main")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    Shared<Result<Answer, NoRejection>>.with<bool>(&body, bodyAnswerIsTyped),
    "references retain explicit unfinished borrow-safety obligations",
  )
  let main = run Semantic.demandMir(&mut store, &mut request, &id, b"main")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let mainIndex = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(&main, selectedMirIndex)
  let mut hasRef = false
  if let Option<usize>.Some {value: index} = move mainIndex {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(&store, index) {
      let blocks = Vector<MirBlock>.asSlice(&function.blocks)
      let mut at = usize.ZERO
      while at < blocks.length {
        let statements = Vector<MirStatement>.asSlice(&blocks[at].statements)
        let mut item = usize.ZERO
        while item < statements.length {
          if let MirStatement.Assign {value: MirRvalue.Ref {access, place}, ..} = &statements[item] {
            hasRef = hasRef || access == Access.Mutable && Vector<MirProjection>.length(
              &place.projections,
            ) == usize.ZERO
          }
          item = item + usize.ONE
        }
        at = at + usize.ONE
      }
    }
  }
  let stored = run Semantic.demandMir(&mut store, &mut request, &id, b"set")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let storedIndex = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(
    &stored,
    selectedMirIndex,
  )
  let mut projectedStore = false
  if let Option<usize>.Some {value: index} = move storedIndex {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(&store, index) {
      let blocks = Vector<MirBlock>.asSlice(&function.blocks)
      let statements = Vector<MirStatement>.asSlice(&blocks[usize.ZERO].statements)
      let mut at = usize.ZERO
      while at < statements.length {
        if let MirStatement.Assign {destination, ..} = &statements[at] {
          let projections = Vector<MirProjection>.asSlice(&destination.projections)
          if projections.length == usize.ONE {
            projectedStore = projectedStore || mirProjectionIsDeref(&projections[usize.ZERO])
          }
        }
        at = at + usize.ONE
      }
    }
  }
  run Testing.expect(
    hasRef && projectedStore,
    "MIR retains loans and the dereferenced assignment destination",
  )
  let built = run buildApplication(&mut store, &mut request, staticClosureNodes)
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut emitted = false
  match move built {
    BackendBuild.Module {text, ..} => {
      let ir = Bytes.asSlice(&text)
      emitted = containsIr(ir, b"load ptr, ptr") && containsIr(ir, b"store i32 42, ptr %v") && containsIr(ir, b"alloca i32, align 4")
    }
    _ => {}
  }
  run Testing.expect(emitted, "LLVM uses the projected address for the scalar store")
  return ()
}

// An unsafe declaration is a caller contract, never an implicit unsafe implementation block.
test effect fn pointerDerefRequiresLexicalUnsafe() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("pointer-place.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
unsafe fn forbidden(value: *const i32) -> i32 { return value.* }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let rejected = run Semantic.demandBody(&mut store, &mut request, &id, b"forbidden")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    rejectsFrom(&rejected, RejectionCode.UnsafeAcknowledgement, offsetOf(text, "value.*", usize.ZERO)),
    "an unsafe function modifier does not permit raw-pointer dereference without an unsafe block",
  )
  return ()
}

