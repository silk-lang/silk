// U6: ordinary source-defined static functions reach only the sealed Intrinsic operations.
struct StaticByteFacts {
  fault: bool
  offset: bool
  origin: bool
}

fn staticByteFacts(
  answer: &Result<Shared<StaticData>, StaticDiagnostic | OutOfMemoryError>,
  offset: u64,
  origin: usize,
) -> StaticByteFacts {
  return match & answer.* {
    Result<Shared<StaticData>, StaticDiagnostic | OutOfMemoryError>.Failure {error} => match &error {
      StaticDiagnostic {fault, byteOffset, origin: source, ..} => {
        let rightOffset = match &byteOffset {
          Option<u64>.Some {value} => value == offset
          Option<u64>.None => false
        }
        let rightOrigin = match &source {
          Option<Span>.Some {value} => value.start == origin
          Option<Span>.None => false
        }
        return StaticByteFacts {
          fault: fault == StaticExecutionFault.InvalidValue,
          offset: rightOffset,
          origin: rightOrigin,
        }
      }
      _ => StaticByteFacts {fault: false, offset: false, origin: false}
    }
    _ => StaticByteFacts {fault: false, offset: false, origin: false}
  }
}

test effect fn staticIntrinsicSourceWrappersUseFrozenTargetAndTextOffsets() -> ()
! InvalidModulePath | OutOfMemoryError | StaticDiagnostic | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("static-intrinsic-wrapper.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let wrapper = run module("text.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let wrapperSource = r"""pub static fn byteAt(value: string, index: usize) -> u8 {
  return Intrinsic.staticTextByteAt(value, index)
}
pub static fn concat(left: string, right: string) -> string<'static> {
  return Intrinsic.staticTextConcat(left, right)
}
pub static fn slice(value: string, start: usize, end: usize) -> string<'static> {
  return Intrinsic.staticTextSlice(value, start, end)
}
"""
  let source = r"""import text { byteAt as selectedByte, concat as selectedConcat, slice as selectedSlice }
static fn width() -> u32 { return Intrinsic.targetPointerBits() }
static fn arch() -> string<'static> { return Intrinsic.targetArchitecture() }
static fn invalidByte() -> u8 { return selectedByte("é!", 3) }
static fn splitText() -> string<'static> { return selectedSlice("é!", 0, 1) }
static fn concatByte() -> u8 { return selectedByte(selectedConcat("é", "!"), 3) }
"""
  let held = run present(source) |> Effect.provideMut<Allocator>(&mut allocator)
  let publishedWrapper = run present(wrapperSource) |> Effect.provideMut<Allocator>(&mut allocator)
  let first = run Revision.publish(&Revision.make(), &wrapper, &publishedWrapper)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&first, &id, &held) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut wasmSemantic = Semantic.traced(
    run Revision.copy(&revision) |> Effect.provideMut<Allocator>(&mut allocator),
    MachineTarget.forId(TargetId.Wasm32UnknownUnknown),
    Option.none<FinalProfile>(),
  )
  let mut nativeSemantic = Semantic.traced(move revision, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu), Option.none<FinalProfile>())
  let mut wasmDependencies = Vector.make<Dependency>()
  let mut nativeDependencies = Vector.make<Dependency>()
  let mut wasm = run StaticExecution.make(
    Semantic.staticPort(&mut wasmSemantic, &mut wasmDependencies),
    &id,
    StaticExecution.Limits {steps: 100, depth: 8, valueBytes: 1024},
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut native = run StaticExecution.make(
    Semantic.staticPort(&mut nativeSemantic, &mut nativeDependencies),
    &id,
    StaticExecution.Limits {steps: 100, depth: 8, valueBytes: 1024},
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let args = Vector.make<Shared<StaticData>>()
  let span = Span.make(usize.ZERO, usize.ZERO)
  let wasmWidth = run StaticExecution.demand(&mut wasm, b"width", Vector.asSlice<Shared<StaticData>>(&args), span)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let nativeWidth = run StaticExecution.demand(&mut native, b"width", Vector.asSlice<Shared<StaticData>>(&args), span)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let wasmArch = run StaticExecution.demand(&mut wasm, b"arch", Vector.asSlice<Shared<StaticData>>(&args), span)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let nativeArch = run StaticExecution.demand(&mut native, b"arch", Vector.asSlice<Shared<StaticData>>(&args), span)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    Shared.with<StaticData, bool>(&wasmWidth, fn(value: &StaticData) -> bool { return staticSharedIntegerIs(value, 32) }) &&
      Shared.with<StaticData, bool>(&nativeWidth, fn(value: &StaticData) -> bool { return staticSharedIntegerIs(value, 64) }) &&
      Shared.with<StaticData, bool>(&wasmArch, fn(value: &StaticData) -> bool { return staticTextBytesAre(value, b"wasm32") }) &&
      Shared.with<StaticData, bool>(&nativeArch, fn(value: &StaticData) -> bool { return staticTextBytesAre(value, b"x86_64") }),
    "sealed target facts follow the selected target in ordinary source",
  )
  let badByte = run Effect.result(StaticExecution.demand(&mut native, b"invalidByte", Vector.asSlice<Shared<StaticData>>(&args), span))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let split = run Effect.result(StaticExecution.demand(&mut native, b"splitText", Vector.asSlice<Shared<StaticData>>(&args), span))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let concat = run Effect.result(StaticExecution.demand(&mut native, b"concatByte", Vector.asSlice<Shared<StaticData>>(&args), span))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let byteFacts = staticByteFacts(&badByte, 3, offsetOf(source, "\"é!\"", usize.ZERO))
  run Testing.expect(byteFacts.fault, "imported byteAt reports an invalid-value fault")
  run Testing.expect(byteFacts.offset, "imported byteAt reports the out-of-bounds byte offset")
  run Testing.expect(byteFacts.origin, "imported byteAt reports the original text anchor")
  let sliceFacts = staticByteFacts(&split, 1, offsetOf(source, "\"é!\"", usize.ONE))
  run Testing.expect(sliceFacts.fault, "imported slice reports an invalid-value fault")
  run Testing.expect(sliceFacts.offset, "imported slice reports the split-scalar byte offset")
  run Testing.expect(sliceFacts.origin, "imported slice reports the original text anchor")
  let concatFacts = staticByteFacts(&concat, 3, offsetOf(source, "\"é\"", usize.ZERO))
  run Testing.expect(concatFacts.fault, "imported concat byteAt reports an invalid-value fault")
  run Testing.expect(concatFacts.offset, "imported concat byteAt reports the out-of-bounds byte offset")
  run Testing.expect(concatFacts.origin, "imported concat preserves its left text anchor through byteAt")
  return ()
}

effect fn initializerHasBody(
  semantic: &mut Semantic,
  answer: &Shared<Result<Answer, NoRejection>>,
  module: &ModuleId,
  name: &[u8],
) -> bool ! Cycle | OutOfMemoryError ? &mut Allocator {
  let count = Shared.with<Result<Answer, NoRejection>, usize>(answer, dependencyCount)
  let mut at = usize.ZERO
  while at < count {
    let selected = Shared.with<Result<Answer, NoRejection>, Option<Dependency>>(
      answer,
      fn(value: &Result<Answer, NoRejection>) -> Option<Dependency> {
        return dependencyAt(value, at)
      },
    )
    if let Option<Dependency>.Some {value: edge} = move selected {
      if edge.family == Family.Body && ModuleId.equals(Semantic.dependencyModule(&semantic.*, &edge), module) {
        let found = run Semantic.dependencyDeclaration(&mut semantic.*, &edge)
        if let Option<DeclarationId>.Some {value: declaration} = move found {
          if sameBytes(DeclarationId.spelling(&declaration), name) { return true }
        }
      }
    }
    at = at + usize.ONE
  }
  return false
}

test effect fn staticInitializerRecomputesAfterReachedImportedBodyEdit() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let entry = run module("static-constant-entry.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let helper = run module("helper.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let entrySource = run present("""import helper { value as selected, idle }
const localOffset: u32 = 3
static fn localValue() -> u32 { return localOffset + 4 }
const localComputed: u32 = localValue()
const computed: u32 = selected()
""") |> Effect.provideMut<Allocator>(&mut allocator)
  let firstBody = run present("""const offset: u32 = 2
pub static fn value() -> u32 { return offset + 5 }
pub static fn idle() -> u32 { return 99 }
""") |> Effect.provideMut<Allocator>(&mut allocator)
  let first = run Revision.publish(&Revision.make(), &helper, &firstBody)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&first, &entry, &entrySource)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut semantic = makeSemantic(run Revision.copy(&revision)
    |> Effect.provideMut<Allocator>(&mut allocator))
  let mut request = Request.make()
  let initial = run Semantic.demandInitializer(&mut semantic, &mut request, &entry, b"computed")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let local = run Semantic.demandInitializer(&mut semantic, &mut request, &entry, b"localComputed")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let reachedValue = run initializerHasBody(&mut semantic, &initial, &helper, b"value")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let reachedIdle = run initializerHasBody(&mut semantic, &initial, &helper, b"idle")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(&initial, fn(answer: &Result<Answer, NoRejection>) -> bool {
      return constantInteger(answer, b"7")
    }) && reachedValue && !reachedIdle && Shared.with<Result<Answer, NoRejection>, bool>(&local, fn(answer: &Result<Answer, NoRejection>) -> bool {
      return constantInteger(answer, b"7")
    }),
    "active initializers resolve helper constants in local and imported frames and record only reached bodies",
  )
  let initializerStarts = starts(Semantic.eventLog(&semantic), Family.Initializer)
  let changedBody = run present("""const offset: u32 = 2
pub static fn value() -> u32 { return offset + 7 }
pub static fn idle() -> u32 { return 99 }
""") |> Effect.provideMut<Allocator>(&mut allocator)
  let updated = run Revision.publish(&revision, &helper, &changedBody)
    |> Effect.provideMut<Allocator>(&mut allocator)
  Semantic.revise(&mut semantic, move updated)
  let mut again = Request.make()
  let changed = run Semantic.demandInitializer(&mut semantic, &mut again, &entry, b"computed")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let reachedChanged = run initializerHasBody(&mut semantic, &changed, &helper, b"value")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(&changed, fn(answer: &Result<Answer, NoRejection>) -> bool {
      return constantInteger(answer, b"9")
    }) && reachedChanged,
    "editing the reached imported body updates the active initializer value and dependency",
  )
  run Testing.expect(
    starts(Semantic.eventLog(&semantic), Family.Initializer) > initializerStarts,
    "editing the reached imported body starts initializer recomputation",
  )
  return ()
}

// U9: diagnostics are rebuilt from current source rather than retained value identity.
fn staticFailureAt(answer: &Result<Answer, NoRejection>, expected: usize) -> bool {
  let found = rejection(answer)
  if let Option<Shared<Rejection>>.Some {value} = move found {
    return Shared.with<Rejection, bool>(&value, fn(diagnostic: &Rejection) -> bool {
      if diagnostic.code != RejectionCode.SelectedCompileError || diagnostic.span.start != expected { return false }
      if let Option<StaticDiagnostic>.Some {value: details} = &diagnostic.staticFailure {
        let trace = Vector.asSlice<StaticTraceStep>(&details.trace)
        return sameBytes(details.code, b"SEM0177") && details.span.start == expected &&
          trace.length == usize.ONE && trace[usize.ZERO].span.end > trace[usize.ZERO].span.start
      }
      return false
    })
  }
  return false
}

effect fn staticDiagnosticRevisionClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator {
  let entry = run module("static-diagnostic-reuse.silk")
  let firstText = """static fn abort() -> u32 { compileError("stop") }
const bad: u32 = abort()
const good: u32 = 4
"""
  let firstSource = run present(firstText)
  let first = run Revision.publish(&Revision.make(), &entry, &firstSource)
  let mut warm = makeSemantic(run Revision.copy(&first))
  let mut original = Request.make()
  let failed = run Semantic.demandInitializer(&mut warm, &mut original, &entry, b"bad")
  run Testing.expect(Shared.with<Result<Answer, NoRejection>, bool>(&failed, fn(answer: &Result<Answer, NoRejection>) -> bool {
    return staticFailureAt(answer, offsetOf(firstText, "compileError", usize.ZERO))
  }), "the first failing application retains its authored static trace")
  let movedText = """// New source positions for the same failure.
static fn abort() -> u32 { compileError("stop") }
const bad: u32 = abort()
const good: u32 = 4
"""
  let movedSource = run present(movedText)
  let movedRevision = run Revision.publish(&first, &entry, &movedSource)
  Semantic.revise(&mut warm, run Revision.copy(&movedRevision))
  let mut fresh = makeSemantic(run Revision.copy(&movedRevision))
  let mut warmRequest = Request.make()
  let mut freshRequest = Request.make()
  let warmBad = run Semantic.demandInitializer(&mut warm, &mut warmRequest, &entry, b"bad")
  let warmGood = run Semantic.demandInitializer(&mut warm, &mut warmRequest, &entry, b"good")
  let freshGood = run Semantic.demandInitializer(&mut fresh, &mut freshRequest, &entry, b"good")
  let freshBad = run Semantic.demandInitializer(&mut fresh, &mut freshRequest, &entry, b"bad")
  run Testing.expect(Shared.with<Result<Answer, NoRejection>, bool>(&warmBad, fn(answer: &Result<Answer, NoRejection>) -> bool {
    return staticFailureAt(answer, offsetOf(movedText, "compileError", usize.ZERO))
  }) && Shared.with<Result<Answer, NoRejection>, bool>(&freshBad, fn(answer: &Result<Answer, NoRejection>) -> bool {
    return staticFailureAt(answer, offsetOf(movedText, "compileError", usize.ZERO))
  }) && Shared.with<Result<Answer, NoRejection>, bool>(&warmGood, fn(answer: &Result<Answer, NoRejection>) -> bool {
    return constantInteger(answer, b"4")
  }) && Shared.with<Result<Answer, NoRejection>, bool>(&freshGood, fn(answer: &Result<Answer, NoRejection>) -> bool {
    return constantInteger(answer, b"4")
  }), "warm and reversed fresh demands agree on current spans, traces and unaffected values")
  let repairedSource = run present("""static fn abort() -> u32 { return 6 }
const bad: u32 = abort()
const good: u32 = 4
""")
  let repaired = run Revision.publish(&movedRevision, &entry, &repairedSource)
  Semantic.revise(&mut warm, move repaired)
  let mut retriedRequest = Request.make()
  let retried = run Semantic.demandInitializer(&mut warm, &mut retriedRequest, &entry, b"bad")
  run Testing.expect(Shared.with<Result<Answer, NoRejection>, bool>(&retried, fn(answer: &Result<Answer, NoRejection>) -> bool {
    return constantInteger(answer, b"6")
  }), "a failed application publishes no partial value and retries after its body is repaired")
  return ()
}

test effect fn staticDiagnosticReplayUsesCurrentSpansAndRetries() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run staticDiagnosticRevisionClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

// U9: a residual body replays executed helpers and canonical values, not only signatures.
effect fn staticRevisionReplayClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator {
  let entry = run module("static-reuse.silk")
  let helper = run module("gate.silk")
  let entrySource = run present("""import gate { gate }
static fn choose() -> u32 {
  static if gate { return 7 } else { return 9 }
}
const selected: u32 = choose()
""")
  let helperSource = run present("""pub static fn enabled() -> bool { return true }
pub const gate: bool = enabled()
fn unrelated() -> u32 { return 1 }
""")
  let first = run Revision.publish(&Revision.make(), &entry, &entrySource)
  let initial = run Revision.publish(&first, &helper, &helperSource)
  let mut warm = makeSemantic(run Revision.copy(&initial))
  let mut request = Request.make()
  let original = run Semantic.demandBody(&mut warm, &mut request, &entry, b"choose")
  let selected = run Semantic.demandInitializer(&mut warm, &mut request, &entry, b"selected")
  run Testing.expect(Shared.with<Result<Answer, NoRejection>, AnswerView>(&original, inspect).success &&
    Shared.with<Result<Answer, NoRejection>, bool>(&selected, fn(answer: &Result<Answer, NoRejection>) -> bool {
      return constantInteger(answer, b"7")
    }) && Request.hasDemand(&request, Family.Body, &helper),
    "static selection observes the executed helper body")
  let unrelated = run present("""pub static fn enabled() -> bool { return true }
pub const gate: bool = enabled()
fn unrelated() -> u32 { return 2 }
""")
  let edited = run Revision.publish(&initial, &helper, &unrelated)
  Semantic.revise(&mut warm, run Revision.copy(&edited))
  let mut again = Request.make()
  let beforeReuse = reused(Semantic.eventLog(&warm))
  let preserved = run Semantic.demandBody(&mut warm, &mut again, &entry, b"choose")
  run Testing.expect(Shared.with<Result<Answer, NoRejection>, AnswerView>(&preserved, inspect).success &&
    reused(Semantic.eventLog(&warm)) >= beforeReuse + 2 &&
    Request.hasDemand(&again, Family.Body, &helper) && Request.hasDiscovered(&again, &helper),
    "an unrelated helper-module edit retains the checked helper and selected body with replayed evidence")
  let changed = run present("""pub static fn enabled() -> bool { return false }
pub const gate: bool = enabled()
fn unrelated() -> u32 { return 2 }
""")
  let revision = run Revision.publish(&edited, &helper, &changed)
  Semantic.revise(&mut warm, run Revision.copy(&revision))
  let mut fresh = makeSemantic(run Revision.copy(&revision))
  let mut warmRequest = Request.make()
  let mut freshRequest = Request.make()
  let warmValue = run Semantic.demandInitializer(&mut warm, &mut warmRequest, &entry, b"selected")
  let freshBody = run Semantic.demandBody(&mut fresh, &mut freshRequest, &entry, b"choose")
  let freshValue = run Semantic.demandInitializer(&mut fresh, &mut freshRequest, &entry, b"selected")
  run Testing.expect(Shared.with<Result<Answer, NoRejection>, bool>(&warmValue, fn(answer: &Result<Answer, NoRejection>) -> bool {
    return constantInteger(answer, b"9")
  }) && Shared.with<Result<Answer, NoRejection>, bool>(&freshValue, fn(answer: &Result<Answer, NoRejection>) -> bool {
    return constantInteger(answer, b"9")
  }) && Shared.with<Result<Answer, NoRejection>, AnswerView>(&freshBody, inspect).success,
    "a helper-body edit with unchanged signature changes selection equally in warm and reversed fresh demands")
  return ()
}

test effect fn staticRevisionReplayPreservesFactsAndInvalidatesExecutedBodies() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run staticRevisionReplayClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn importedTargetConstantsUseTheFrozenSemanticTarget() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let target = run module("target.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let entry = run module("target-entry.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let targetSource = run present("""pub const pointerBits: u32 = Intrinsic.targetPointerBits()
pub const architecture: string<'static> = Intrinsic.targetArchitecture()
""") |> Effect.provideMut<Allocator>(&mut allocator)
  let entrySource = run present("""import target { pointerBits, architecture }
const selectedBits: u32 = pointerBits
const selectedArchitecture: string<'static> = architecture
""") |> Effect.provideMut<Allocator>(&mut allocator)
  let first = run Revision.publish(&Revision.make(), &target, &targetSource)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&first, &entry, &entrySource)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut wasm = Semantic.traced(
    run Revision.copy(&revision) |> Effect.provideMut<Allocator>(&mut allocator),
    MachineTarget.forId(TargetId.Wasm32UnknownUnknown),
    Option.none<FinalProfile>(),
  )
  let mut native = Semantic.traced(move revision, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu), Option.none<FinalProfile>())
  let mut wasmRequest = Request.make()
  let mut nativeRequest = Request.make()
  let wasmBits = run Semantic.demandInitializer(&mut wasm, &mut wasmRequest, &entry, b"selectedBits")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let wasmArchitecture = run Semantic.demandInitializer(&mut wasm, &mut wasmRequest, &entry, b"selectedArchitecture")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let nativeBits = run Semantic.demandInitializer(&mut native, &mut nativeRequest, &entry, b"selectedBits")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let nativeArchitecture = run Semantic.demandInitializer(&mut native, &mut nativeRequest, &entry, b"selectedArchitecture")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(&wasmBits, fn(answer: &Result<Answer, NoRejection>) -> bool {
      return constantInteger(answer, b"32")
    }) && Shared.with<Result<Answer, NoRejection>, bool>(&nativeBits, fn(answer: &Result<Answer, NoRejection>) -> bool {
      return constantInteger(answer, b"64")
    }) && Shared.with<Result<Answer, NoRejection>, bool>(&wasmArchitecture, fn(answer: &Result<Answer, NoRejection>) -> bool {
      return constantText(answer, b"wasm32")
    }) && Shared.with<Result<Answer, NoRejection>, bool>(&nativeArchitecture, fn(answer: &Result<Answer, NoRejection>) -> bool {
      return constantText(answer, b"x86_64")
    }) && Request.hasDemand(&wasmRequest, Family.Initializer, &target) &&
      Request.hasDemand(&nativeRequest, Family.Initializer, &target),
    "ordinary imported target constants retain their selected target and value edges",
  )
  return ()
}

effect fn nominalBindingShapeClaims() -> ()
! InvalidModulePath | Cycle | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let entry = run module("shape-kind.silk")
  let source = run present("""
struct Card {}
enum Choice { Open }
union Maybe { None, Some { value: bool } }
""")
  let revision = run Revision.publish(&Revision.make(), &entry, &source)
  let mut index = SourceIndex.make(run Revision.copy(&revision))
  let card = run requireIndexedIdentity(&mut index, &entry, OwnerKind.Struct, b"Card", usize.ZERO)
  let choice = run requireIndexedIdentity(&mut index, &entry, OwnerKind.Enumeration, b"Choice", usize.ZERO)
  let cardType = run Shared.make<Type>(Type.Nominal {
    declaration: move card, isPublic: false, arguments: Vector.make<Argument>(),
  })
  let choiceType = run Shared.make<Type>(Type.Nominal {
    declaration: run DeclarationId.copy(&choice), isPublic: false, arguments: Vector.make<Argument>(),
  })
  let boolType = run Shared.make<Type>(Type.Primitive {name: run Bytes.copy(b"bool")})
  let optional = BindingShape.Optional {
    absent: 0, present: 1, elementType: Shared.clone<Type>(&boolType),
    element: run Box.make<BindingShape>(BindingShape.Boolean),
  }
  let record = BindingShape.Record {fields: Vector.make<BindingNamedShape>()}
  let mut cases = Vector.make<BindingEnumMember>()
  run Vector.append<BindingEnumMember>(&mut cases, BindingEnumMember {
    name: run Bytes.copy(b"Open"),
    value: run Shared.make<StaticData>(StaticData.Enum {
      declaration: run Shared.make<DeclarationId>(run DeclarationId.copy(&choice)),
      member: 0, representation: StaticIntegerType.U8, sign: StaticSign.Positive, magnitude: 0,
    }),
  })
  let enumeration = BindingShape.Enum {
    canonical: run Bytes.copy(b"example/shape-kind.silk/Choice"), members: move cases,
  }
  let correctEnum = run bindingCorrespondsToType(&choiceType, &enumeration)
  let enumAsRecord = run bindingCorrespondsToType(&choiceType, &record)
  let structAsOptional = run bindingCorrespondsToType(&cardType, &optional)
  let structAsEnum = run bindingCorrespondsToType(&cardType, &enumeration)
  let wrongKind = !enumAsRecord && !structAsOptional && !structAsEnum
  let mut forgedCases = Vector.make<BindingEnumMember>()
  run Vector.append<BindingEnumMember>(&mut forgedCases, BindingEnumMember {
    name: run Bytes.copy(b"Open"),
    value: run Shared.make<StaticData>(StaticData.Enum {
      declaration: run Shared.make<DeclarationId>(move choice),
      member: 0, representation: StaticIntegerType.U8, sign: StaticSign.Positive, magnitude: 0,
    }),
  })
  let wrongCanonical = BindingShape.Enum {
    canonical: run Bytes.copy(b"example/shape-kind.silk/Other"), members: move forgedCases,
  }
  let acceptedWrongCanonical = run bindingCorrespondsToType(&choiceType, &wrongCanonical)
  run Testing.expect(
    correctEnum && wrongKind && !acceptedWrongCanonical,
    "nominal shapes use declaration kind and canonical enum identity",
  )
  return ()
}

test effect fn profileBindingNominalIdentity() -> ()
! InvalidModulePath | Cycle | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run nominalBindingShapeClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

fn pipelineGapAt(answer: &Result<Answer, NoRejection>, code: GapCode, owner: &[u8], start: usize, end: usize) -> bool {
  let selected = selectedBackendGap(answer)
  if let Option<Shared<BackendGap>>.Some {value} = move selected {
    let identity = Shared.with<BackendGap, Shared<DeclarationId>>(&value, fn(gap: &BackendGap) -> Shared<DeclarationId> { return Shared.clone<DeclarationId>(&gap.owner) })
    let owned = Shared.with<DeclarationId, bool>(&identity, fn(id: &DeclarationId) -> bool { return DeclarationId.named(id, owner) })
    return owned && Shared.with<BackendGap, bool>(&value, fn(gap: &BackendGap) -> bool {
      let span = BackendGap.span(gap)
      return gap.code == code && span.start == start && span.end == end
    })
  }
  return false
}

fn pipelineTypedUnary(body: &TypedBody, callee: &[u8], primitive: &[u8]) -> bool {
  let nodes = TypedBody.nodeSlice(body)
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {ty, form: BodyExpression.DirectCall {declaration, arguments, ..}} = &nodes[at].kind {
      if DeclarationId.named(&declaration, callee) {
        let values = Vector.asSlice<BodyNodeId>(&arguments)
        if values.length != usize.ONE { return false }
        if let BodyNodeKind.Expression {ty: inputType, ..} = &nodes[values[usize.ZERO].index].kind {
          return Shared.with<Type, bool>(&ty, fn(value: &Type) -> bool { return witnessPrimitive(value, primitive) })
            && Shared.with<Type, bool>(&inputType, fn(value: &Type) -> bool { return witnessPrimitive(value, primitive) })
        }
      }
    }
    at = at + usize.ONE
  }
  return false
}

test effect fn namedPipelinesShareDirectCallTypingAndOrder() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("pipeline.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let library = run module("pipe_library.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
import pipe_library as Library
struct Convert {}
impl Convert { fn finish(value: i32) -> i32 { return value } }
fn produce() -> i32 { return 41 }
fn increment(value: i32) -> i32 { return value + 1 }
fn byteIdentity(value: u8) -> u8 { return value }
fn main() -> i32 { return produce() |> increment |> Convert.finish |> Library.finish }
fn contextual() -> u8 { return 255 |> byteIdentity }
fn block() -> i32 { return match true { _ => { let value = produce() return value |> increment } } }
static fn staticPlus(value: i32) -> i32 { return value + 1 }
fn selected() -> i32 { return 40 |> staticPlus |> increment }
fn slot(static value: i32) -> i32 { return value }
fn selectedSlot() -> i32 { return 41 |> slot }
fn callable() -> i32 { return 1 |> fn(value: i32) -> i32 { return value } }
fn binding(target: fn(i32) -> i32) -> i32 { return 1 |> target }
struct Unit { value: i32 }
interface Plain { fn apply(value: &Self) -> i32 }
interface Applied<T> { fn apply(value: &Self) -> T }
impl Plain for Unit { fn apply(value: &Self) -> i32 { return value.value } }
impl Applied<i32> for Unit { fn apply(value: &Self) -> i32 { return value.value } }
fn operation() -> i32 { let unit = Unit {value: 1} return &unit |> Plain.apply }
fn appliedOperation() -> i32 { let unit = Unit {value: 1} return &unit |> Applied<i32>.apply }
struct Generic<T> {}
impl<T> Generic<T> { fn finish(value: i32) -> i32 { return value } }
fn appliedNominal() -> i32 { return 1 |> Generic<i32>.finish }
fn excessPipe() -> i32 { return 1 |> Convert<Missing>.finish }
fn excessCall() -> i32 { return Convert<Missing>.finish(1) }
fn unknownPipe() -> i32 { return 1 |> Generic<Missing>.finish }
fn unknownCall() -> i32 { return Generic<Missing>.finish(1) }
fn modulePipe() -> i32 { return 1 |> Library<Missing>.finish }
fn moduleCall() -> i32 { return Library<Missing>.finish(1) }
"""
  let entrySource = run present(text) |> Effect.provideMut<Allocator>(&mut allocator)
  let librarySource = run present("pub fn finish(value: i32) -> i32 { return value }\n") |> Effect.provideMut<Allocator>(&mut allocator)
  let first = run Revision.publish(&Revision.make(), &id, &entrySource) |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&first, &library, &librarySource) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut store = Semantic.traced(move revision, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu), Option.none<FinalProfile>())
  let mut request = Request.make()
  let body = run Semantic.demandBody(&mut store, &mut request, &id, b"main") |> Effect.provideMut<Allocator>(&mut allocator)
  let checked = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(&body, checkedBody)
  let mut typed = false
  if let Option<Shared<TypedBody>>.Some {value} = move checked {
    typed = Shared.with<TypedBody, bool>(&value, fn(value: &TypedBody) -> bool { return pipelineTypedUnary(value, b"increment", b"i32") })
  }
  run Testing.expect(typed, "a pipe selects the direct function and checks its input and result types")
  let contextual = run Semantic.demandBody(&mut store, &mut request, &id, b"contextual") |> Effect.provideMut<Allocator>(&mut allocator)
  let contextualBody = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(&contextual, checkedBody)
  let mut contextualInput = false
  if let Option<Shared<TypedBody>>.Some {value} = move contextualBody {
    contextualInput = Shared.with<TypedBody, bool>(&value, fn(value: &TypedBody) -> bool { return pipelineTypedUnary(value, b"byteIdentity", b"u8") })
  }
  run Testing.expect(contextualInput, "the unary parameter contexts an unsuffixed piped integer")
  let mir = run Semantic.demandMir(&mut store, &mut request, &id, b"main") |> Effect.provideMut<Allocator>(&mut allocator)
  let index = Shared.with<Result<Answer, NoRejection>, Option<usize>>(&mir, selectedMirIndex)
  let mut ordered = false
  if let Option<usize>.Some {value} = move index {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(&store, value) {
      let blocks = Vector.asSlice<MirBlock>(&function.blocks)
      let mut block = usize.ZERO
      let mut phase = usize.ZERO
      let mut previous = usize.MAX
      ordered = true
      while ordered && phase < 4 {
        if block >= blocks.length { ordered = false break }
        if let MirTerminator.Call {callee: MirCallee.Instance {key}, arguments, destination, normal, ..} = &blocks[block].terminator {
          let identity = InstanceKey.identity(&key)
          let mut spelling = b"produce"
          if phase == usize.ONE { spelling = b"increment" }
          if phase >= 2 { spelling = b"finish" }
          ordered = Shared.with<DeclarationId, bool>(&identity, fn(value: &DeclarationId) -> bool { return DeclarationId.named(value, spelling) })
          let values = Vector.asSlice<MirOperand>(&arguments)
          if phase == usize.ZERO {
            ordered = ordered && values.length == usize.ZERO
          } else {
            ordered = ordered && values.length == usize.ONE
            if values.length == usize.ONE {
              if let MirOperand.Copy {place} = &values[usize.ZERO] {
                ordered = ordered && place.local == previous && Vector.length<MirProjection>(&place.projections) == usize.ZERO
              } else { ordered = false }
            }
          }
          if phase == 3 { ordered = ordered && Shared.with<DeclarationId, bool>(&identity, fn(value: &DeclarationId) -> bool { return ModuleId.equals(DeclarationId.moduleId(value), &library) }) }
          previous = destination.local
          block = normal
          phase = phase + usize.ONE
        } else { ordered = false }
      }
      let mut calls = usize.ZERO
      let mut at = usize.ZERO
      while at < blocks.length {
        if let MirTerminator.Call {..} = &blocks[at].terminator { calls = calls + usize.ONE }
        at = at + usize.ONE
      }
      ordered = ordered && phase == 4 && calls == 4
    }
  }
  run Testing.expect(ordered, "MIR evaluates the input once before each named, type-qualified, and module-qualified target")
  let block = run Semantic.demandMir(&mut store, &mut request, &id, b"block") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(Shared.with<Result<Answer, NoRejection>, bool>(&block, pipelineHasMir), "call collection reaches a pipe in a block match arm")
  let selected = run Semantic.demandMir(&mut store, &mut request, &id, b"selected") |> Effect.provideMut<Allocator>(&mut allocator)
  let selectedSlot = run Semantic.demandMir(&mut store, &mut request, &id, b"selectedSlot") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(Shared.with<Result<Answer, NoRejection>, bool>(&selected, pipelineHasMir)
    && Shared.with<Result<Answer, NoRejection>, bool>(&selectedSlot, pipelineHasMir), "pipes share static-call execution and static argument selection")
  let callable = run Semantic.demandMir(&mut store, &mut request, &id, b"callable") |> Effect.provideMut<Allocator>(&mut allocator)
  let binding = run Semantic.demandBody(&mut store, &mut request, &id, b"binding") |> Effect.provideMut<Allocator>(&mut allocator)
  let operation = run Semantic.demandMir(&mut store, &mut request, &id, b"operation") |> Effect.provideMut<Allocator>(&mut allocator)
  let applied = run Semantic.demandMir(&mut store, &mut request, &id, b"appliedOperation") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(succeeded(&callable) && succeeded(&binding),
    "an exact anonymous pipeline lowers directly and an abstract callable parameter pipeline types")
  run Testing.expect(Shared.with<Result<Answer, NoRejection>, bool>(&operation, pipelineHasMir)
    && Shared.with<Result<Answer, NoRejection>, bool>(&applied, pipelineHasMir), "an interface-operation pipeline lowers as its direct qualified call")
  let appliedNominal = run Semantic.demandMir(&mut store, &mut request, &id, b"appliedNominal") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(Shared.with<Result<Answer, NoRejection>, bool>(&appliedNominal, pipelineHasMir), "a validated nominal application selects its inherent pipeline target")
  let excessPipe = run Semantic.demandBody(&mut store, &mut request, &id, b"excessPipe") |> Effect.provideMut<Allocator>(&mut allocator)
  let excessCall = run Semantic.demandBody(&mut store, &mut request, &id, b"excessCall") |> Effect.provideMut<Allocator>(&mut allocator)
  let unknownPipe = run Semantic.demandBody(&mut store, &mut request, &id, b"unknownPipe") |> Effect.provideMut<Allocator>(&mut allocator)
  let unknownCall = run Semantic.demandBody(&mut store, &mut request, &id, b"unknownCall") |> Effect.provideMut<Allocator>(&mut allocator)
  let modulePipe = run Semantic.demandBody(&mut store, &mut request, &id, b"modulePipe") |> Effect.provideMut<Allocator>(&mut allocator)
  let moduleCall = run Semantic.demandBody(&mut store, &mut request, &id, b"moduleCall") |> Effect.provideMut<Allocator>(&mut allocator)
  let excessStart = offsetOf(text, "Convert<Missing>", usize.ZERO) + String.utf8Bytes("Convert").length
  let excessCallStart = offsetOf(text, "Convert<Missing>", usize.ONE) + String.utf8Bytes("Convert").length
  let unknownStart = offsetOf(text, "Generic<Missing>", usize.ZERO) + String.utf8Bytes("Generic<").length
  let unknownCallStart = offsetOf(text, "Generic<Missing>", usize.ONE) + String.utf8Bytes("Generic<").length
  let moduleStart = offsetOf(text, "Library<Missing>", usize.ZERO)
  let moduleCallStart = offsetOf(text, "Library<Missing>", usize.ONE)
  run Testing.expect(Shared.with<Result<Answer, NoRejection>, bool>(&excessPipe, fn(value: &Result<Answer, NoRejection>) -> bool { return rejectionAt(value, RejectionCode.TypeArity, excessStart) })
    && Shared.with<Result<Answer, NoRejection>, bool>(&excessCall, fn(value: &Result<Answer, NoRejection>) -> bool { return rejectionAt(value, RejectionCode.TypeArity, excessCallStart) }), "both call forms reject type arguments on a nongeneric qualifier at the written application")
  run Testing.expect(Shared.with<Result<Answer, NoRejection>, bool>(&unknownPipe, fn(value: &Result<Answer, NoRejection>) -> bool { return rejectionAt(value, RejectionCode.UnknownName, unknownStart) })
    && Shared.with<Result<Answer, NoRejection>, bool>(&unknownCall, fn(value: &Result<Answer, NoRejection>) -> bool { return rejectionAt(value, RejectionCode.UnknownName, unknownCallStart) }), "both call forms resolve the qualifier's type arguments and reject unknown names")
  run Testing.expect(Shared.with<Result<Answer, NoRejection>, bool>(&modulePipe, fn(value: &Result<Answer, NoRejection>) -> bool { return rejectionAt(value, RejectionCode.NotType, moduleStart) })
    && Shared.with<Result<Answer, NoRejection>, bool>(&moduleCall, fn(value: &Result<Answer, NoRejection>) -> bool { return rejectionAt(value, RejectionCode.NotType, moduleCallStart) }), "both call forms reject applying type arguments to a module qualifier")
  return ()
}

test effect fn scalarMirRetainsBranchesAndDirectCallEdges() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("scalar-mir.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let source = """fn step(value: i32) -> i32 { return value + 1 }
pub fn main() -> i32 {
  let mut value: i32 = 0
  while value < 3 { value = step(value) }
  if value == 3 && !(value == 4 || false) { return value }
  return 0
}
"""
  let mut store = run staticSemantic(
    &id,
    source,
    MachineTarget.forId(TargetId.X8664UnknownLinuxGnu),
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let answer = run Semantic.demandMir(&mut store, &mut request, &id, b"main")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let selected = Shared.with<Result<Answer, NoRejection>, Option<usize>>(&answer, selectedMirIndex)
  let index = match move selected {
    Option<usize>.Some {value} => value
    Option<usize>.None => {
      run Testing.expect(false, "scalar body produces MIR")
      return ()
    }
  }
  let mut hasBranch = false
  let mut hasReturn = false
  let mut hasCall = false
  let mut hasReference = false
  if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(&store, index) {
    let blocks = Vector.asSlice<MirBlock>(&function.blocks)
    let mut at = usize.ZERO
    while at < blocks.length {
      match & blocks[at].terminator {
        MirTerminator.Branch {..} => {
          hasBranch = true
        }
        MirTerminator.Return {..} => {
          hasReturn = true
        }
        MirTerminator.Call {..} => {
          hasCall = true
        }
        _ => {}
      }
      at = at + usize.ONE
    }
    hasReference = Vector.length<MirReference>(&function.references) == usize.ONE
  }
  run Testing.expect(
    hasBranch && hasReturn && hasCall && hasReference,
    "scalar MIR retains control flow and the reached callee",
  )
  let stepAnswer = run Semantic.demandMir(&mut store, &mut request, &id, b"step")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let stepSelected = Shared.with<Result<Answer, NoRejection>, Option<usize>>(
    &stepAnswer,
    selectedMirIndex,
  )
  let stepIndex = match move stepSelected {
    Option<usize>.Some {value} => value
    Option<usize>.None => {
      run Testing.expect(false, "scalar callee produces MIR")
      return ()
    }
  }
  let mut hasBinary = false
  if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(&store, stepIndex) {
    let blocks = Vector.asSlice<MirBlock>(&function.blocks)
    let mut block = usize.ZERO
    while block < blocks.length {
      let statements = Vector.asSlice<MirStatement>(&blocks[block].statements)
      let mut statement = usize.ZERO
      while statement < statements.length {
        if let MirStatement.Assign {value, ..} = &statements[statement] {
          if let MirRvalue.Binary {..} = &value {
            hasBinary = true
          }
        }
        statement = statement + usize.ONE
      }
      block = block + usize.ONE
    }
    hasBinary = hasBinary && Vector.length<MirReference>(&function.references) == usize.ZERO
  }
  run Testing.expect(hasBinary, "scalar callee retains arithmetic without extra call edges")
  return ()
}

test effect fn missingBuildModuleReportsDiagnostic() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("missing-build-module.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
    import silk.i32
    pub fn main() -> i32 { return i32.add(40, 2) }
    """
  let mut store = run applicationSemantic(
    &id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu),
  ) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.forApplication(run ModuleId.copy(&id) |> Effect.provideMut<Allocator>(&mut allocator))
  let built = run buildApplication(&mut store, &mut request, staticClosureNodes)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let rejected = match move built {
    BackendBuild.Rejected {first: diagnostic, ..} => Shared.with<Rejection, bool>(
      &diagnostic, fn(value: &Rejection) -> bool {
        return value.code == RejectionCode.MissingModule &&
          value.span.start == offsetOf(text, "silk.i32", 0) && value.span.end == value.span.start + 8
      },
    )
    _ => false
  }
  run Testing.expect(rejected, "a genuinely absent source remains an authored missing-module diagnostic")
  return ()
}

test effect fn ordinaryNegationBuildsTrappingIr() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("negation-overflow.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut store = run applicationSemantic(
    &id,
    "pub fn main() -> i32 { return -(-2147483648) }",
    MachineTarget.forId(TargetId.X8664UnknownLinuxGnu),
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.forApplication(run ModuleId.copy(&id) |> Effect.provideMut<Allocator>(&mut allocator))
  let built = run buildApplication(&mut store, &mut request, staticClosureNodes)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut checked = false
  match move built {
    BackendBuild.Module {text, ..} => {
      let ir = Bytes.asSlice(&text)
      checked = containsIr(ir, b"call { i32, i1 } @llvm.ssub.with.overflow.i32") && containsIr(ir, b"call void @llvm.trap()")
    }
    _ => {}
  }
  run Testing.expect(checked, "ordinary negation checks overflow and traps")
  return ()
}

test effect fn assemblyBuildsInlineAsmCallsAndRejectsContractViolations() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("assembly.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let source = """unsafe fn trap() -> () {
  return unsafe Intrinsic.assembly<()>("ud2", "", "", "none", true, true, ())
}
unsafe fn add(left: u64, right: u64) -> u64 {
  return unsafe Intrinsic.assembly<u64>("addq $2, $0", "={rax},0,{rdi}", "flags", "read", true, false, (left, right))
}
unsafe fn racy(value: u64) -> u64 {
  return unsafe Intrinsic.assembly<u64>("movq $1, $0", "={rax},{rdi}", "", "write", false, false, (value,))
}
pub fn main() -> i32 {
  let total = unsafe add(40, 2)
  if total == 7 { unsafe trap() }
  return 0
}
"""
  let mut store = run applicationSemantic(&id, source, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.forApplication(run ModuleId.copy(&id) |> Effect.provideMut<Allocator>(&mut allocator))
  let built = run buildApplication(&mut store, &mut request, staticClosureNodes)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut lowered = false
  match move built {
    BackendBuild.Module {text, ..} => {
      let ir = Bytes.asSlice(&text)
      lowered = containsIr(ir, b"call void asm sideeffect \"ud2\", \"\"() noreturn memory(inaccessiblemem: readwrite)\nunreachable") &&
        containsIr(ir, b" = call i64 asm sideeffect \"addq $2, $0\", \"={rax},0,{rdi},~{flags},~{memory}\"(i64 ") &&
        containsIr(ir, b") memory(read, inaccessiblemem: readwrite, target_mem0: none, target_mem1: none)\n")
    }
    _ => {}
  }
  run Testing.expect(lowered, "assembly lowers to one inline-asm call with its clobbers, effects and no-return edge")
  let racy = run Semantic.demandBody(&mut store, &mut request, &id, b"racy")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsFrom(&racy, RejectionCode.InvalidConfiguration, offsetOf(source, "Intrinsic.assembly<u64>(\"movq", usize.ZERO)),
    "a writing fragment without side effects violates the machine contract at the call")
  return ()
}

// Binds each storage operation to the same-named declaration of `module`.
effect fn storageIn(module: &ModuleId) -> ExecutionStorage ! OutOfMemoryError ? &mut Allocator {
  return ExecutionStorage {
    create: StorageBinding {module: run ModuleId.copy(module), declaration: run Bytes.copy(b"create")},
    acquire: StorageBinding {module: run ModuleId.copy(module), declaration: run Bytes.copy(b"acquire")},
    release: StorageBinding {module: run ModuleId.copy(module), declaration: run Bytes.copy(b"release")},
    destroy: StorageBinding {module: run ModuleId.copy(module), declaration: run Bytes.copy(b"destroy")},
  }
}

// A build that reaches a suspension boundary needs the selected execution storage; with it,
// every suspendable instance becomes a driver, an `$enter` and a `$step` over a frame from that
// storage, and a borrowed local lives in the frame. A step whose package was dropped while
// relinquished enters the cancel exit of its point.
test effect fn suspensionBuildsCoroutinesOverSelectedStorage() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("suspension-frames.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  // The storage exports only need to exist for this structural build; their bodies never run.
  let source = """
struct Counter { value: i32 }
effect fn bump(counter: &mut Counter, value: i32) -> i32 {
  let next = run Intrinsic.suspendEffect(effect { return value + 1 })
  counter.value = counter.value + next
  return next
}
pub fn main() -> i32 {
  let mut counter = Counter { value: 1 }
  let first = run bump(&mut counter, 2)
  return first + counter.value
}
export "C" fn create() -> usize { return 0 }
export "C" fn acquire(state: usize, size: usize, alignment: usize) -> usize { return state }
export "C" fn release(state: usize, frame: usize) -> () { return () }
export "C" fn destroy(state: usize) -> () { return () }
"""
  let mut store = run applicationSemantic(&id, source, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.forApplication(run ModuleId.copy(&id) |> Effect.provideMut<Allocator>(&mut allocator))
  let unselected = run buildApplication(&mut store, &mut request, staticClosureNodes)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let boundary = offsetOf(source, "run Intrinsic.suspendEffect", usize.ZERO)
  let mut refused = false
  if let BackendBuild.Rejected {first, ..} = &unselected {
    refused = Shared.with<Rejection, bool>(&first, fn(found: &Rejection) -> bool {
      return found.code == RejectionCode.InvalidConfiguration && found.span.start == boundary
    })
  }
  run Testing.expect(refused, "a reached suspension without a selected execution storage is a configuration rejection at its boundary")
  let storage = run storageIn(&id) |> Effect.provideMut<Allocator>(&mut allocator)
  Semantic.selectExecutionStorage(&mut store, move storage)
  let built = run buildApplication(&mut store, &mut request, staticClosureNodes)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut lowered = false
  match move built {
    BackendBuild.Module {text, ..} => {
      let ir = Bytes.asSlice(&text)
      lowered = containsIr(ir, b"$enter\"(ptr %transfer") && containsIr(ir, b"$step\"(ptr %transfer, ptr %frame) {") &&
        containsIr(ir, b"%frame = call ptr @\"acquire\"(ptr ") && containsIr(ir, b"call void @\"release\"(ptr ") &&
        containsIr(ir, b"call void @\"destroy\"(ptr ") && containsIr(ir, b", label %resume1") &&
        containsIr(ir, b"\nret i32 1\n") && containsIr(ir, b" = getelementptr i8, ptr %frame, i64 ") &&
        containsIr(ir, b"call i32 %") && containsIr(ir, b" i32 1, label %cancel1 ]") && containsIr(ir, b"\ncancel1:\n") &&
        !containsIr(ir, b"\ncancel1:\ncall void @llvm.trap()")
    }
    _ => {}
  }
  run Testing.expect(lowered,
    "suspendable instances drive frames from the selected storage, keep borrowed locals in their frame, and cancel each point through its own exit")
  return ()
}

test effect fn unitParametersHaveNoLlvmLane() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("unit-parameter.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut store = run applicationSemantic(
    &id,
    """fn sink(first: i32, value: (), last: i32) -> i32 { return first + last }
fn unit(value: ()) -> i32 { return 1 }
fn apply(f: fn<'static>(()) -> i32) -> i32 { return f(()) }
pub fn main() -> i32 { return sink(40, (), 1) + apply(unit) }
""",
    MachineTarget.forId(TargetId.X8664UnknownLinuxGnu),
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.forApplication(run ModuleId.copy(&id) |> Effect.provideMut<Allocator>(&mut allocator))
  let built = run buildApplication(&mut store, &mut request, staticClosureNodes)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut checked = false
  match move built {
    BackendBuild.Module {text, ..} => {
      let ir = Bytes.asSlice(&text)
      checked = containsIr(ir, b"i32 %p0, i32 %p2)") && !containsIr(ir, b"%p1") && !containsIr(ir, b"void %")
    }
    _ => {}
  }
  run Testing.expect(checked, "a unit parameter, called directly or through a callable, has no LLVM lane")
  return ()
}

test effect fn staticFunctionsDoNotBecomeRuntimeInstances() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let calleeId = run module("static-callee.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut callee = run applicationSemantic(
    &calleeId,
    """static fn answer() -> i32 { return 42 }
pub fn main() -> i32 { return answer() }
""",
    MachineTarget.forId(TargetId.X8664UnknownLinuxGnu),
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut calleeRequest = Request.forApplication(run ModuleId.copy(&calleeId) |> Effect.provideMut<Allocator>(&mut allocator))
  let calleeBuild = run buildApplication(&mut callee, &mut calleeRequest, staticClosureNodes)
    |> Effect.provideMut<Allocator>(&mut allocator)
  // The caller routes to its selected body, which embeds the static result: the static callee
  // has no runtime instance, call or residualization gap.
  let built = match &calleeBuild {
    BackendBuild.Module {..} => true
    _ => false
  }
  let abstractMain = run Semantic.demandBody(&mut callee, &mut calleeRequest, &calleeId, b"main")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let selectedMain = run Semantic.demandMir(&mut callee, &mut calleeRequest, &calleeId, b"main")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let callStart = offsetOf("""static fn answer() -> i32 { return 42 }
pub fn main() -> i32 { return answer() }
""", "answer()", usize.ONE)
  run Testing.expect(built && mirReferenceCount(&callee, &selectedMain) == usize.ZERO
      && Shared.with<Result<Answer, NoRejection>, bool>(&abstractMain, fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionAt(answer, RejectionCode.Unsupported, callStart)
      }),
    "a static callee's result is embedded: the build succeeds, member MIR has no callee reference, and an unselected body cannot call it")
  return ()
}

test effect fn foreignCallsKeepCSignatureAndSeparateMirEdges() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("foreign-c-signature.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let foreignText = """unsafe extern "C" fn narrow(value: i8) -> i8
unsafe extern "C" fn malloc(size: usize) -> ?*mut u8
unsafe extern "C" fn free(pointer: ?*mut u8) -> ()
unsafe extern "C" fn fabs(value: f64) -> f64
unsafe extern "C" fn fabsf(value: f32) -> f32
pub fn main() -> i32 {
  let value = unsafe narrow(-7)
  let memory = unsafe malloc(8)
  unsafe free(memory)
  if unsafe fabs(-42.0) != 42.0 { return 1 }
  if unsafe fabsf(-7.0) != 7.0 { return 2 }
  if 7.0 != unsafe fabsf(-7.0) { return 3 }
  return 42
}
"""
  let mut store = run applicationSemantic(&id, foreignText, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu)) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.forApplication(run ModuleId.copy(&id) |> Effect.provideMut<Allocator>(&mut allocator))
  let built = run buildApplication(&mut store, &mut request, staticClosureNodes) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut classified = false
  match move built {
    BackendBuild.Module {text, ..} => {
      let ir = Bytes.asSlice(&text)
      classified = containsIr(ir, b"declare signext i8 @\"narrow\"(i8 signext ") && containsIr(ir, b"call signext i8 @\"narrow\"(i8 signext -7)") && containsIr(ir, b"declare ptr @\"malloc\"(i64 ") && containsIr(ir, b"declare void @\"free\"(ptr ") && containsIr(ir, b"declare double @\"fabs\"(double ") && containsIr(ir, b"declare float @\"fabsf\"(float ") && containsIr(ir, b"call float @\"fabsf\"(float 0xC01C000000000000") && containsIr(ir, b"call double @\"fabs\"(double 0xC045000000000000") && containsIr(ir, b" = fcmp une float ") && containsIr(ir, b" = fcmp une double ")
    }
    _ => {}
  }
  run Testing.expect(classified, "C narrow extensions, pointer and contextual floating lanes agree at declaration and call")
  let mut arm = run applicationSemantic(&id, foreignText, MachineTarget.forId(TargetId.Aarch64UnknownLinuxGnu)) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut armRequest = Request.forApplication(run ModuleId.copy(&id) |> Effect.provideMut<Allocator>(&mut allocator))
  let armBuilt = run buildApplication(&mut arm, &mut armRequest, staticClosureNodes) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut bare = false
  if let BackendBuild.Module {text: armText, ..} = &armBuilt {
    let ir = Bytes.asSlice(&armText)
    bare = containsIr(ir, b"declare i8 @\"narrow\"(i8 ") && containsIr(ir, b"call i8 @\"narrow\"(i8 -7)")
      && containsIr(ir, b"declare double @\"fabs\"(double ") && !containsIr(ir, b"signext")
  }
  run Testing.expect(bare, "AAPCS64 Linux leaves narrow C integer lanes unextended at declaration and call, and its entry runtime builds")
  let mirAnswer = run Semantic.demandMir(&mut store, &mut request, &id, b"main") |> Effect.provideMut<Allocator>(&mut allocator)
  let index = Shared.with<Result<Answer, NoRejection>, Option<usize>>(&mirAnswer, selectedMirIndex)
  let mut separate = false
  if let Option<usize>.Some {value} = move index {
    if let Option<&MirFunction>.Some {value: mir} = move Semantic.mirAt(&store, value) {
      separate = Vector.length<MirReference>(&mir.references) == usize.ZERO && Vector.length<Shared<DeclarationId>>(&mir.externs) > usize.ZERO
    }
  }
  run Testing.expect(separate, "foreign declarations never enter the runtime body worklist")
  return ()
}

test effect fn foreignUnsafePrefixesSelectOnlyTheirInvocation() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("foreign-unsafe-regions.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """unsafe extern "C" fn outer(value: i32) -> i32
unsafe extern "C" fn inner() -> i32
fn safe(value: i32) -> i32 { return value }
fn nestedMissing() -> i32 { return unsafe outer(inner()) }
unsafe fn unsafeFunction() -> i32 { return inner() }
fn explicitNested() -> i32 { return unsafe outer(unsafe inner()) }
fn blockNested() -> i32 {
  unsafe { return outer(inner()) }
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu)) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let nested = run Semantic.demandBody(&mut store, &mut request, &id, b"nestedMissing") |> Effect.provideMut<Allocator>(&mut allocator)
  let unmarked = run Semantic.demandBody(&mut store, &mut request, &id, b"unsafeFunction") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    rejectsSpan(&nested, RejectionCode.UnsafeAcknowledgement, text, "inner()", usize.ONE) &&
    rejectsFrom(&unmarked, RejectionCode.UnsafeAcknowledgement, offsetOf(text, "inner() }", usize.ZERO)),
    "prefix authority selects one unsafe call and function modifiers grant no lexical permission",
  )
  let explicit = run Semantic.demandBody(&mut store, &mut request, &id, b"explicitNested") |> Effect.provideMut<Allocator>(&mut allocator)
  let blocked = run Semantic.demandBody(&mut store, &mut request, &id, b"blockNested") |> Effect.provideMut<Allocator>(&mut allocator)
  let markedBody = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(&explicit, checkedBody)
  let blockBody = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(&blocked, checkedBody)
  let mut accepted = false
  if let Option<Shared<TypedBody>>.Some {value: marked} = move markedBody {
    if let Option<Shared<TypedBody>>.Some {value: region} = move blockBody {
      accepted = Shared.with<TypedBody, bool>(&marked, bodyIsFullyChecked) && Shared.with<TypedBody, bool>(&region, bodyIsFullyChecked)
    }
  }
  run Testing.expect(accepted, "explicit nested prefixes and a lexical unsafe block acknowledge both calls")
  return ()
}

