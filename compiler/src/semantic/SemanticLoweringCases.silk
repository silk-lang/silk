fn localGuard<'a>(value: &'a i32) -> Guard<'a> { return Guard<'a> { token: Token {} } }
fn consume<'a>(guard: Guard<'a>) -> () { drop guard return () }
pub fn main() -> i32 { let lasting = Guard<'static> { token: Token {} } let local: i32 = 0 let short = localGuard(&local) consume(move short) consume<'static>(move lasting) return 0 }
