effect fn sealedPublicationClaims() -> ()
  ! FileError
    | HostInputError
    | TomlError
    | InvalidSourceRoot
    | InvalidDependency
    | MissingManifest
    | InvalidBuildComposition
    | MissingStandardLibrary
    | InvalidNativeLinkInput
    | InvalidModulePath
    | OutOfMemoryError
    | AssertionError<'static>
  ? &mut FileSystem | &mut Allocator {
  let cwd = run NativeHostInput.workingDirectory()
  let checkout = run Path.fromBytes(Bytes.asSlice(&cwd))
  let library = run Path.join(&checkout, "packages/compiler/stdlib")
  let sharedFile = run Path.join(&library, "intrinsic/operators.silk")
  let sharedBytes = run FileSystem.readFile(&sharedFile)
  let temp = run FileSystem.temporaryDirectory(&run Path.make("/tmp"), "silk-sealed-operators-")
  let source = run Path.join(&temp.path, "main.silk")
  run writePackageFile(
    &temp.path,
    "silk.toml",
    b"[package]\nname = \"sealed-fixture\"\nversion = \"0.1.0\"\nroot = \"main.silk\"\n[build]\ncomposition = { runtimes = [{ name = \"start\", module = \"main\" }], defaults = [\"start\"], retention = [], requirements = [] }\n"
  )
  run writePackageFile(
    &temp.path,
    "main.silk",
    b"// Intrinsic.Add is only a comment\nfn plain() -> i32 { return Intrinsic.i32Add(1, 2) }\n"
  )
  let shadow = run Path.join(&temp.path, "intrinsic")
  run FileSystem.createDirectory(&shadow)
  run writePackageFile(&shadow, "operators.silk", b"pub interface Forged {}\n")
  let mut plain = run ModuleSourceFiles.make(
    &source,
    Option<Path>.some(run Path.fromBytes(Path.rawBytes(&library))),
    b"x86_64-unknown-linux-gnu",
    b"gnu",
    true
  , ProfileSelection.Default)
  let plainRoots = [ModuleId.copy(ModuleSourceFiles.entry(&plain))]
  run ModuleSourceFiles.preload(&mut plain, &plainRoots)
  let sealed = run ModuleSourceFiles.module(&plain, b"intrinsic/operators.silk")
  let plainRevision = run ModuleSourceFiles.revision(&plain)
  run Testing.expect(
    !Revision.presents(&plainRevision, &sealed),
    "comments and ordinary intrinsic operations do not load the sealed source"
  )
  run writePackageFile(
    &temp.path,
    "main.silk",
    b"import intrinsic.operators\nfn plain() -> i32 { return 0 }\n"
  )
  let mut imported = run ModuleSourceFiles.make(
    &source,
    Option<Path>.some(run Path.fromBytes(Path.rawBytes(&library))),
    b"x86_64-unknown-linux-gnu",
    b"gnu",
    true
  , ProfileSelection.Default)
  let importRoots = [ModuleId.copy(ModuleSourceFiles.entry(&imported))]
  run ModuleSourceFiles.preload(&mut imported, &importRoots)
  let importRevision = run ModuleSourceFiles.revision(&imported)
  run Testing.expect(
    !Revision.presents(&importRevision, &sealed),
    "an import cannot publish the sealed file or a project substitute"
  )
  run writePackageFile(
    &temp.path,
    "main.silk",
    b"import aliases { Plus }\nfn add<T: Plus<T, T>>(left: T, right: T) -> T { return move left + move right }\n"
  )
  run writePackageFile(&temp.path, "aliases.silk", b"pub type Plus = Intrinsic // trivia\n . Add\n")
  let mut named = run ModuleSourceFiles.make(
    &source,
    Option<Path>.some(run Path.fromBytes(Path.rawBytes(&library))),
    b"x86_64-unknown-linux-gnu",
    b"gnu",
    true
  , ProfileSelection.Default)
  let namedRoots = [ModuleId.copy(ModuleSourceFiles.entry(&named))]
  run ModuleSourceFiles.preload(&mut named, &namedRoots)
  let namedRevision = run ModuleSourceFiles.revision(&named)
  let observation = run Revision.observe(&namedRevision, &sealed)
  let content = run Observation.copyContent(&observation)
  let identical = match &content {
    Option<Bytes>.Some { value } => sameBytes(Bytes.asSlice(&value), Bytes.asSlice(&sharedBytes))
    Option<Bytes>.None => false
  }
  let route = run ModuleSourceFiles.sourceLocation(&named, &sealed)
  run Testing.expect(
    identical && route.provider == ProviderRole.StandardLibrary,
    "a reachable alias loads exactly the physical source embedded by bootstrap, ignoring the project substitute"
  )
  let extendedLibrary = run Path.join(&temp.path, "distribution")
  run FileSystem.createDirectory(&extendedLibrary)
  let extendedIntrinsic = run Path.join(&extendedLibrary, "intrinsic")
  run FileSystem.createDirectory(&extendedIntrinsic)
  let mut extendedBytes = run Bytes.copy(Bytes.asSlice(&sharedBytes))
  run Bytes.append(
    &mut extendedBytes,
    b"\npub // declaration trivia\n interface FutureSealedInterface {}\n"
  )
  run writePackageFile(&extendedIntrinsic, "operators.silk", Bytes.asSlice(&extendedBytes))
  run writePackageFile(
    &temp.path,
    "main.silk",
    b"pub type Future = Intrinsic.FutureSealedInterface\n"
  )
  let mut extended = run ModuleSourceFiles.make(
    &source,
    Option<Path>.some(run Path.fromBytes(Path.rawBytes(&extendedLibrary))),
    b"x86_64-unknown-linux-gnu",
    b"gnu",
    true
  , ProfileSelection.Default)
  let extendedRoots = [ModuleId.copy(ModuleSourceFiles.entry(&extended))]
  run ModuleSourceFiles.preload(&mut extended, &extendedRoots)
  let extendedRevision = run ModuleSourceFiles.revision(&extended)
  let extendedObservation = run Revision.observe(&extendedRevision, &sealed)
  let extendedContent = run Observation.copyContent(&extendedObservation)
  let recognizesAddition = match &extendedContent {
    Option<Bytes>.Some { value } => sameBytes(Bytes.asSlice(&value), Bytes.asSlice(&extendedBytes))
    Option<Bytes>.None => false
  }
  run Testing.expect(
    recognizesAddition,
    "new public declarations in the shared file are recognized without a compiler name-list edit"
  )
  let forbidden = run Path.join(&shadow, "operators.silk")
  let attempted = run Effect.result(
    ModuleSourceFiles.make(
      &forbidden,
      Option<Path>.some(run Path.fromBytes(Path.rawBytes(&library))),
      b"x86_64-unknown-linux-gnu",
      b"gnu",
      true
    , ProfileSelection.Default)
  )
  let rejected = match move attempted {
    Result<
      ModuleSources,
      FileError
        | TomlError
        | InvalidSourceRoot
        | InvalidDependency
        | MissingManifest
        | InvalidBuildComposition
        | MissingStandardLibrary
        | InvalidNativeLinkInput
        | InvalidModulePath
        | OutOfMemoryError
    >.Failure {
      error
    } => match move error {
      InvalidSourceRoot {} => true
      _ => false
    }
    Result<
      ModuleSources,
      FileError
        | TomlError
        | InvalidSourceRoot
        | InvalidDependency
        | MissingManifest
        | InvalidBuildComposition
        | MissingStandardLibrary
        | InvalidNativeLinkInput
        | InvalidModulePath
        | OutOfMemoryError
    >.Success {
      ..
    } => false
  }
  run Testing.expect(rejected, "the sealed logical source cannot be a user entry root")
  run writePackageFile(
    &temp.path,
    "silk.toml",
    b"[package]\nname = \"sealed-fixture\"\nversion = \"0.1.0\"\nroot = \"main.silk\"\n[build]\ncomposition = { runtimes = [{ name = \"start\", module = \"intrinsic/operators\" }], defaults = [\"start\"], retention = [], requirements = [] }\n"
  )
  run Testing.expect(
    run compositionRefused(
      &source,
      Option<Path>.some(run Path.fromBytes(Path.rawBytes(&library))),
      b"gnu"
    ),
    "the sealed source cannot be selected as a composition runtime root"
  )
  return ()
}


// Nested expression failures keep the expectation that produced them (SEM0012/0025/0037/0129).
// Whether the rejection carries exactly these `expected` and `actual` arguments; empty texts
// mean it carries none.
fn messageArguments(answer: &Shared<Result<Answer, NoRejection>>, expected: &[u8], actual: &[u8]) -> bool {
  let found = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(answer, rejection)
  if let Option<Shared<Rejection>>.Some {value} = move found {
    return Shared<Rejection>.with<bool>(&value, fn(diagnostic: &Rejection) -> bool {
      let listed = Vector<MessageArgument>.asSlice(&diagnostic.arguments)
      if expected.length == usize.ZERO { return listed.length == usize.ZERO }
      return listed.length == 2 && sameText(Bytes.asSlice(&listed[0].name), b"expected")
        && sameText(Bytes.asSlice(&listed[0].value), expected) && sameText(Bytes.asSlice(&listed[1].name), b"actual")
        && sameText(Bytes.asSlice(&listed[1].value), actual)
    })
  }
  return false
}

// Whether the rejection carries the argument `name` with exactly `value`.
fn argumentIs(answer: &Shared<Result<Answer, NoRejection>>, name: &[u8], value: &[u8]) -> bool {
  let found = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(answer, rejection)
  if let Option<Shared<Rejection>>.Some {value: diagnostic} = move found {
    return Shared<Rejection>.with<bool>(&diagnostic, fn(entry: &Rejection) -> bool {
      let listed = Vector<MessageArgument>.asSlice(&entry.arguments)
      let mut at = usize.ZERO
      while at < listed.length {
        if sameText(Bytes.asSlice(&listed[at].name), name) { return sameText(Bytes.asSlice(&listed[at].value), value) }
        at = at + usize.ONE
      }
      return false
    })
  }
  return false
}

fn sameText(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] { return false }
    at = at + usize.ONE
  }
  return true
}

test effect fn expectedValueReasonsPreserveNestedCallFailures() -> ()
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("expected-value-reasons.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
enum Mode { First }
enum Different { First }
fn crossEnum(left: Mode, right: Different) -> bool { return left == right }
fn orderedEnum(left: Mode, right: Mode) -> bool { return left < right }
fn enumEqualsInteger(left: Mode) -> bool { return left != 1 }
fn badCharacter() -> u32 { return '\\q' }
fn badText() -> string<'static> { return "\\q" }
fn wrongEnum() -> Mode { return Different.First }
fn typedReturn(flag: i32) -> bool { return flag }
fn arityTarget(first: i32) -> i32 { return first }
fn tooMany() -> i32 { return arityTarget(1, 2) }
fn nominalReturn(held: Slot) -> i32 { return held }
fn takesFlag(enabled: bool) -> bool { return enabled }
fn typedArgument(count: i32) -> bool { return takesFlag(count) }
fn untypedReturn(view: &i32) -> bool { return view }
fn enumInteger() -> i32 { return Mode.First }
fn integerEnum() -> Mode { return 17 }
struct Slot { value: i32 }
fn immutableField() -> i32 { let slot = Slot {value: 1} slot.value = 2 return 0 }
fn slots(values: &mut [i32]) -> &mut [i32] { return move values }
fn slotOf(held: &mut Slot) -> &mut Slot { return move held }
fn cell(target: &mut i32) -> &mut i32 { return move target }
fn callElement(values: &mut [i32]) -> () { slots(move values)[0] = 1 }
fn callField(held: &mut Slot) -> () { slotOf(move held).value = 1 }
fn callReferent(target: &mut i32) -> () { cell(move target).* = 1 }
fn sharedReferent(target: &i32) -> () { target.* = 1 }
fn immutableReplacement() -> i32 { let held = 1 return Intrinsic.replace(held, 2) }
fn invalidReplacement() -> i32 { return Intrinsic.replace(3, 4) }
fn take(value: i32) -> i32 { return value }
fn fieldDirect(fieldDirectValue: bool) -> Slot { return Slot { value: fieldDirectValue } }
fn fieldNested(fieldNestedValue: bool) -> Slot { return Slot { value: take(fieldNestedValue) } }
struct Shelf { slot: Slot }
fn fieldInner(fieldInnerValue: bool) -> Shelf { return Shelf { slot: Slot { value: fieldInnerValue } } }
fn guardNotBool(guardValue: i32) -> i32 { return match guardValue { _ if guardValue => 1 _ => 0 } }
fn unknownProjection(projected: Slot) -> i32 { return projected.missingField }
fn unknownInitializer() -> Slot { return Slot { value: 1, extraField: 2 } }
fn openPick<T>() -> i32 { return 0 }
fn openPair<T, U>() -> i32 { return 0 }
impl Slot { fn openProbe<T>(self: &Self) -> i32 { return 0 } }
fn unprefixedCall() -> i32 { return openPick() }
fn receiverCall(probed: Slot) -> i32 { return probed.openProbe() }
fn prefixedCall() -> i32 { return openPair<i32>() }
fn bindingDirect(bindingDirectValue: bool) -> i32 { let value: i32 = bindingDirectValue return value }
fn bindingNested(bindingNestedValue: bool) -> i32 { let value: i32 = take(bindingNestedValue) return value }
fn assignmentDirect(assignmentDirectValue: bool) -> i32 { let mut value = 0 value = assignmentDirectValue return value }
fn assignmentNested(assignmentNestedValue: bool) -> i32 { let mut value = 0 value = take(assignmentNestedValue) return value }
fn returnDirect(returnDirectValue: bool) -> i32 { return returnDirectValue }
fn returnNested(returnNestedValue: bool) -> i32 { return take(returnNestedValue) }
fn arrayDirect(arrayDirectValue: bool) -> [i32; 1] { return [arrayDirectValue] }
fn arrayNested(arrayNestedValue: bool) -> [i32; 1] { return [take(arrayNestedValue)] }
fn indexDirect(indexDirectValue: bool) -> i32 { let values = [0] return values[indexDirectValue] }
fn indexNested(indexNestedValue: bool) -> i32 { let values = [0] return values[take(indexNestedValue)] }
effect fn failureDirect(failureDirectValue: bool) -> i32 ! i32 { fail failureDirectValue }
effect fn failureNested(failureNestedValue: bool) -> i32 ! i32 { fail take(failureNestedValue) }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let fieldDirect = run Semantic.demandBody(&mut store, &mut request, &id, b"fieldDirect")
    |> Effect.provideMut<Types>(&mut typeTable)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    rejectsSpan(
      &fieldDirect,
      RejectionCode.StructFieldTypeMismatch,
      text,
      "fieldDirectValue",
      usize.ONE
    ) && argumentIs(&fieldDirect, b"field", b"value") && argumentIs(&fieldDirect, b"expected", b"i32")
      && argumentIs(&fieldDirect, b"actual", b"bool"),
    "fieldDirect preserves the producing expectation and operand span and names the field and both types"
  )
  let fieldInner = run Semantic.demandBody(&mut store, &mut request, &id, b"fieldInner")
    |> Effect.provideMut<Types>(&mut typeTable)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let guardNotBool = run Semantic.demandBody(&mut store, &mut request, &id, b"guardNotBool")
    |> Effect.provideMut<Types>(&mut typeTable)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    rejectsSpan(&fieldInner, RejectionCode.StructFieldTypeMismatch, text, "fieldInnerValue", usize.ONE)
      && argumentIs(&fieldInner, b"field", b"value")
      && rejectsSpan(&guardNotBool, RejectionCode.MatchGuardNotBool, text, "guardValue", 2)
      && argumentIs(&guardNotBool, b"actual", b"i32"),
    "a nested initializer keeps its own field name; a non-bool guard names its type"
  )
  let unknownProjection = run Semantic.demandBody(&mut store, &mut request, &id, b"unknownProjection")
    |> Effect.provideMut<Types>(&mut typeTable)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let unknownInitializer = run Semantic.demandBody(&mut store, &mut request, &id, b"unknownInitializer")
    |> Effect.provideMut<Types>(&mut typeTable)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    rejectsSpan(&unknownProjection, RejectionCode.UnknownProjectedField, text, "missingField", usize.ZERO)
      && argumentIs(&unknownProjection, b"type", b"expected-value-reasons.Slot")
      && argumentIs(&unknownProjection, b"field", b"missingField")
      && rejectsSpan(&unknownInitializer, RejectionCode.UnknownStructField, text, "extraField", usize.ZERO)
      && argumentIs(&unknownInitializer, b"type", b"expected-value-reasons.Slot")
      && argumentIs(&unknownInitializer, b"field", b"extraField"),
    "an unknown projected or initialized field names the record type and the field"
  )
  let unprefixedCall = run Semantic.demandBody(&mut store, &mut request, &id, b"unprefixedCall")
    |> Effect.provideMut<Types>(&mut typeTable)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let receiverCall = run Semantic.demandBody(&mut store, &mut request, &id, b"receiverCall")
    |> Effect.provideMut<Types>(&mut typeTable)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let prefixedCall = run Semantic.demandBody(&mut store, &mut request, &id, b"prefixedCall")
    |> Effect.provideMut<Types>(&mut typeTable)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    rejectsSpan(&unprefixedCall, RejectionCode.TypeArgumentInference, text, "openPick()", usize.ZERO)
      && argumentIs(&unprefixedCall, b"target", b"openPick")
      && rejectsSpan(&receiverCall, RejectionCode.TypeArgumentInference, text, "probed.openProbe()", usize.ZERO)
      && argumentIs(&receiverCall, b"target", b"Slot.openProbe")
      && rejectsSpan(&prefixedCall, RejectionCode.UninferredParameter, text, "openPair<i32>()", usize.ZERO),
    "an unprefixed call its values cannot determine is uninferable as a whole and names its callee; a prefix leaves one parameter undetermined"
  )
  let fieldNested = run Semantic.demandBody(&mut store, &mut request, &id, b"fieldNested")
    |> Effect.provideMut<Types>(&mut typeTable)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    rejectsSpan(&fieldNested, RejectionCode.TypeMismatch, text, "fieldNestedValue", usize.ONE),
    "fieldNested preserves the producing expectation and operand span"
  )
  let bindingDirect = run Semantic.demandBody(&mut store, &mut request, &id, b"bindingDirect")
    |> Effect.provideMut<Types>(&mut typeTable)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    rejectsSpan(
      &bindingDirect,
      RejectionCode.AssignmentTypeMismatch,
      text,
      "bindingDirectValue",
      usize.ONE
    ),
    "bindingDirect preserves the producing expectation and operand span"
  )
  let bindingNested = run Semantic.demandBody(&mut store, &mut request, &id, b"bindingNested")
    |> Effect.provideMut<Types>(&mut typeTable)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    rejectsSpan(&bindingNested, RejectionCode.TypeMismatch, text, "bindingNestedValue", usize.ONE),
    "bindingNested preserves the producing expectation and operand span"
  )
  let assignmentDirect = run Semantic.demandBody(&mut store, &mut request, &id, b"assignmentDirect")
    |> Effect.provideMut<Types>(&mut typeTable)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    rejectsSpan(
      &assignmentDirect,
      RejectionCode.AssignmentTypeMismatch,
      text,
      "assignmentDirectValue",
      usize.ONE
    ),
    "assignmentDirect preserves the producing expectation and operand span"
  )
  let assignmentNested = run Semantic.demandBody(&mut store, &mut request, &id, b"assignmentNested")
    |> Effect.provideMut<Types>(&mut typeTable)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    rejectsSpan(
      &assignmentNested,
      RejectionCode.TypeMismatch,
      text,
      "assignmentNestedValue",
      usize.ONE
    ),
    "assignmentNested preserves the producing expectation and operand span"
  )
  let returnDirect = run Semantic.demandBody(&mut store, &mut request, &id, b"returnDirect")
    |> Effect.provideMut<Types>(&mut typeTable)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    rejectsSpan(
      &returnDirect,
      RejectionCode.ReturnTypeMismatch,
      text,
      "returnDirectValue",
      usize.ONE
    ),
    "returnDirect preserves the producing expectation and operand span"
  )
  let returnNested = run Semantic.demandBody(&mut store, &mut request, &id, b"returnNested")
    |> Effect.provideMut<Types>(&mut typeTable)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    rejectsSpan(&returnNested, RejectionCode.TypeMismatch, text, "returnNestedValue", usize.ONE),
    "returnNested preserves the producing expectation and operand span"
  )
  let arrayDirect = run Semantic.demandBody(&mut store, &mut request, &id, b"arrayDirect")
    |> Effect.provideMut<Types>(&mut typeTable)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    rejectsSpan(
      &arrayDirect,
      RejectionCode.ArrayElementMismatch,
      text,
      "arrayDirectValue",
      usize.ONE
    ),
    "arrayDirect preserves the producing expectation and operand span"
  )
  let arrayNested = run Semantic.demandBody(&mut store, &mut request, &id, b"arrayNested")
    |> Effect.provideMut<Types>(&mut typeTable)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    rejectsSpan(&arrayNested, RejectionCode.TypeMismatch, text, "arrayNestedValue", usize.ONE),
    "arrayNested preserves the producing expectation and operand span"
  )
  let indexDirect = run Semantic.demandBody(&mut store, &mut request, &id, b"indexDirect")
    |> Effect.provideMut<Types>(&mut typeTable)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    rejectsSpan(&indexDirect, RejectionCode.InvalidIndexType, text, "indexDirectValue", usize.ONE),
    "indexDirect preserves the producing expectation and operand span"
  )
  let indexNested = run Semantic.demandBody(&mut store, &mut request, &id, b"indexNested")
    |> Effect.provideMut<Types>(&mut typeTable)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    rejectsSpan(&indexNested, RejectionCode.TypeMismatch, text, "indexNestedValue", usize.ONE),
    "indexNested preserves the producing expectation and operand span"
  )
  let failureDirect = run Semantic.demandBody(&mut store, &mut request, &id, b"failureDirect")
    |> Effect.provideMut<Types>(&mut typeTable)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    rejectsSpan(
      &failureDirect,
      RejectionCode.UndeclaredFailure,
      text,
      "failureDirectValue",
      usize.ONE
    ),
    "failureDirect preserves the producing expectation and operand span"
  )
  let failureNested = run Semantic.demandBody(&mut store, &mut request, &id, b"failureNested")
    |> Effect.provideMut<Types>(&mut typeTable)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    rejectsSpan(&failureNested, RejectionCode.TypeMismatch, text, "failureNestedValue", usize.ONE),
    "failureNested preserves the producing expectation and operand span"
  )
  let crossEnum = run Semantic.demandBody(&mut store, &mut request, &id, b"crossEnum")
    |> Effect.provideMut<Types>(&mut typeTable)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let orderedEnum = run Semantic.demandBody(&mut store, &mut request, &id, b"orderedEnum")
    |> Effect.provideMut<Types>(&mut typeTable)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let enumEqualsInteger = run Semantic.demandBody(&mut store, &mut request, &id, b"enumEqualsInteger")
    |> Effect.provideMut<Types>(&mut typeTable)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    rejectsSpan(&crossEnum, RejectionCode.CrossEnumEquality, text, "==", usize.ZERO)
      && rejectsSpan(&orderedEnum, RejectionCode.EnumOrdering, text, "<", usize.ZERO)
      && rejectsSpan(&enumEqualsInteger, RejectionCode.EnumIntegerMismatch, text, "!=", usize.ZERO),
    "OP-011 reports cross-enum equality, enum ordering and enum-integer equality at the operator"
  )
  let badCharacter = run Semantic.demandBody(&mut store, &mut request, &id, b"badCharacter")
    |> Effect.provideMut<Types>(&mut typeTable)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let badText = run Semantic.demandBody(&mut store, &mut request, &id, b"badText")
    |> Effect.provideMut<Types>(&mut typeTable)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    rejectsSpan(&badCharacter, RejectionCode.InvalidStaticLiteral, text, "'\\q'", usize.ZERO)
      && rejectsSpan(&badText, RejectionCode.InvalidStaticLiteral, text, "\"\\q\"", usize.ZERO),
    "a character or text literal with a malformed escape reports SEM0085 at the literal (TEXT-001)"
  )
  let typedReturn = run Semantic.demandBody(&mut store, &mut request, &id, b"typedReturn")
    |> Effect.provideMut<Types>(&mut typeTable)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let untypedReturn = run Semantic.demandBody(&mut store, &mut request, &id, b"untypedReturn")
    |> Effect.provideMut<Types>(&mut typeTable)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let nominalReturn = run Semantic.demandBody(&mut store, &mut request, &id, b"nominalReturn")
    |> Effect.provideMut<Types>(&mut typeTable)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let typedArgument = run Semantic.demandBody(&mut store, &mut request, &id, b"typedArgument")
    |> Effect.provideMut<Types>(&mut typeTable)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let tooMany = run Semantic.demandBody(&mut store, &mut request, &id, b"tooMany")
    |> Effect.provideMut<Types>(&mut typeTable)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    rejectsSpan(&typedReturn, RejectionCode.ReturnTypeMismatch, text, "flag", usize.ONE)
      && messageArguments(&typedReturn, b"bool", b"i32")
      && rejectsSpan(&untypedReturn, RejectionCode.ReturnTypeMismatch, text, "view", usize.ONE)
      && messageArguments(&untypedReturn, b"", b"")
      && messageArguments(&nominalReturn, b"i32", b"expected-value-reasons.Slot")
      && rejectsSpan(&typedArgument, RejectionCode.TypeMismatch, text, "count", usize.ONE)
      && messageArguments(&typedArgument, b"bool", b"i32")
      && rejectsSpan(&tooMany, RejectionCode.CallArity, text, "arityTarget(1, 2)", usize.ZERO)
      && argumentIs(&tooMany, b"expectedCount", b"1") && argumentIs(&tooMany, b"expectedCountWord", b"argument")
      && argumentIs(&tooMany, b"actualCount", b"2"),
    "a return or argument mismatch carries the expected and actual type text, none for a type with an inferred lifetime, and a call arity mismatch carries both counts"
  )
  let wrongEnum = run Semantic.demandBody(&mut store, &mut request, &id, b"wrongEnum")
    |> Effect.provideMut<Types>(&mut typeTable)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    rejectsSpan(&wrongEnum, RejectionCode.WrongEnumMember, text, "Different.First", usize.ZERO),
    "wrongEnum retains the specific enum relation reason at the returned value"
  )
  let enumInteger = run Semantic.demandBody(&mut store, &mut request, &id, b"enumInteger")
    |> Effect.provideMut<Types>(&mut typeTable)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    rejectsSpan(&enumInteger, RejectionCode.EnumIntegerMismatch, text, "Mode.First", usize.ZERO),
    "enumInteger retains the specific enum relation reason at the returned value"
  )
  let integerEnum = run Semantic.demandBody(&mut store, &mut request, &id, b"integerEnum")
    |> Effect.provideMut<Types>(&mut typeTable)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    rejectsSpan(&integerEnum, RejectionCode.EnumIntegerMismatch, text, "17", usize.ZERO),
    "integerEnum retains the specific enum relation reason at the returned value"
  )
  let immutableField = run Semantic.demandBody(&mut store, &mut request, &id, b"immutableField")
    |> Effect.provideMut<Types>(&mut typeTable)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    rejectsSpan(
      &immutableField,
      RejectionCode.ImmutableAssignment,
      text,
      "slot.value",
      usize.ZERO
    ),
    "immutableField distinguishes immutable storage from invalid assignment places"
  )
  let callElement = run Semantic.demandBody(&mut store, &mut request, &id, b"callElement")
    |> Effect.provideMut<Types>(&mut typeTable)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let callField = run Semantic.demandBody(&mut store, &mut request, &id, b"callField")
    |> Effect.provideMut<Types>(&mut typeTable)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let callReferent = run Semantic.demandBody(&mut store, &mut request, &id, b"callReferent")
    |> Effect.provideMut<Types>(&mut typeTable)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let sharedReferent = run Semantic.demandBody(&mut store, &mut request, &id, b"sharedReferent")
    |> Effect.provideMut<Types>(&mut typeTable)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    rejectsSpan(&callElement, RejectionCode.InvalidAssignmentPlace, text, "slots(move values)[0]", usize.ZERO)
      && rejectsSpan(&callField, RejectionCode.InvalidAssignmentPlace, text, "slotOf(move held).value", usize.ZERO)
      && rejectsSpan(&callReferent, RejectionCode.InvalidAssignmentPlace, text, "cell(move target).*", usize.ZERO)
      && rejectsSpan(&sharedReferent, RejectionCode.InvalidAssignmentPlace, text, "target.*", usize.ZERO),
    "an element, field or referent reached through a call result, and a shared referent, are not assignment targets (ASSIGN-001)"
  )
  let immutableReplacement = run Semantic.demandBody(
    &mut store,
    &mut request,
    &id,
    b"immutableReplacement"
  )
    |> Effect.provideMut<Types>(&mut typeTable)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    rejectsSpan(
      &immutableReplacement,
      RejectionCode.ImmutableAssignment,
      text,
      "Intrinsic.replace(held, 2)",
      usize.ZERO
    ),
    "immutableReplacement distinguishes immutable storage from invalid assignment places"
  )
  let invalidReplacement = run Semantic.demandBody(
    &mut store,
    &mut request,
    &id,
    b"invalidReplacement"
  )
    |> Effect.provideMut<Types>(&mut typeTable)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    rejectsSpan(
      &invalidReplacement,
      RejectionCode.InvalidAssignmentPlace,
      text,
      "Intrinsic.replace(3, 4)",
      usize.ZERO
    ),
    "invalidReplacement distinguishes immutable storage from invalid assignment places"
  )
  return ()
}

// Whether no diagnostic of the answer is a read of an unavailable binding, which is never rendered.
fn noUnavailableRead(answer: &Shared<Result<Answer, NoRejection>>) -> bool {
  return Shared<Result<Answer, NoRejection>>.with<bool>(answer, fn(found: &Result<Answer, NoRejection>) -> bool {
    if let Result<Answer, NoRejection>.Success {value} = &found.* {
      if let Outcome.Rejected {diagnostics} = &value.outcome {
        let listed = Vector<Shared<Rejection>>.asSlice(&diagnostics)
        let mut at = usize.ZERO
        while at < listed.length {
          if Shared<Rejection>.with<bool>(&listed[at], fn(item: &Rejection) -> bool { return item.code == RejectionCode.UnavailableBinding }) { return false }
          at = at + usize.ONE
        }
      }
    }
    return true
  })
}

test effect fn recoveredBodiesRejectTheBuildThatReachesThem() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run recoveredBuildClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

// A body rejected for statements it recovered past is never a checked body to its dependents: the
// build that reaches it from `main` is refused with its diagnostics, its ownership conflict first.
effect fn recoveredBuildClaims() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("recovered-build.silk")
  let text = """struct Token { value: i32 }
fn take(token: Token) -> i32 { return token.value }
fn recovered(flag: bool) -> i32 { let owned = Token { value: 1 } let a = take(move owned) let b = take(move owned) if 3 { return 0 } return a + b }
pub fn main() -> i32 { return recovered(true) }
"""
  let revision = run Revision.publish(&Revision.make(), &id, &run present(text))
  let mut store = makeSemantic(run withEntryRuntime(&revision))
  let mut request = Request.forApplication(ModuleId.copy(&id))
  let built = run buildApplication(&mut store, &mut request, staticClosureNodes)
  let moved = offsetOf(text, "move owned", usize.ONE)
  let condition = offsetOf(text, "3 {", usize.ZERO)
  let mut refused = false
  if let BackendBuild.Rejected {first, further, ..} = &built {
    let listed = Vector<Shared<Rejection>>.asSlice(&further)
    refused = Shared<Rejection>.with<bool>(&first, fn(found: &Rejection) -> bool { return found.code == RejectionCode.UseAfterMove && found.span.start == moved })
      && listed.length == usize.ONE
      && Shared<Rejection>.with<bool>(&listed[usize.ZERO], fn(found: &Rejection) -> bool { return found.code == RejectionCode.ConditionNotBool && found.span.start == condition })
  }
  run Testing.expect(refused, "a build that reaches a recovered body is refused with that body's diagnostics")
  return ()
}

// The #1833 reviewer shapes. In each temporary shape, a temporary array outlives every use of the
// view, Holder, Wrap or Effect built from it, including the Holder's destructor: lowered MIR
// verifies clean, and moving the temporary's drop to just after the call that takes its borrow,
// or after the borrow when no call follows it, is a use after drop. In e1-e4 the result keeps
// only views that outlive the temporary (another region, `'static`, a sibling field), so the
// body verifies clean and, in e1, e2 and e4, the moved drop is still sound. In e5 an impl bound
// lets the temporary reach the result. In e6-e8 a view only might reach a later use (through a
// holder's inner region, a callable value, or a field of a value without its own destructor),
// so those bodies verify clean and the moved drops in e6 and e7 are not reported; e8 has no
// call after the borrow, so its moved drop lands before the slice built from the borrow. In
// g1-g6 a value is read out through a view of a temporary (a `'static` name, a borrow of a
// binding) and outlives it: it is not a view of the temporary, so the bodies verify clean,
// while the moved drop lands before the read through the view. The plain-owner shapes (b3, b6,
// c6) hold no temporary.
test effect fn useAfterDropReportsAMisplacedTemporaryDrop() -> ()
! CanonicalizationFailure | InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("use-after-drop.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
struct Res { value: i32 }
impl Intrinsic.Drop for Res { fn drop(self: &mut Res) -> () { return () } }
fn make(value: i32) -> Res { return Res { value: value } }
fn read(res: &[Res]) -> i32 { return res[0].value }
fn identity(res: &[Res]) -> &[Res] { return res }
fn identityMut(res: &mut [Res]) -> &mut [Res] { return move res }
fn bump(res: &mut [Res]) -> () { res[0].value = res[0].value + 1  return () }
struct Holder<'a> { view: &'a [Res] }
impl<'a> Intrinsic.Drop for Holder<'a> { fn drop(self: &mut Holder<'a>) -> () { let seen = read(self.view)  return () } }
union Packet { Empty, Ready { value: i32 } }
effect fn pause() -> i32 { return 1 }
effect fn useView(view: &[Res]) -> i32 { return read(view) }
effect fn useHolder<'a>(holder: Holder<'a>) -> i32 { return read(holder.view) }
struct Wrap<'a> { view: &'a [Res] }
fn a1(flag: bool) -> i32 { let view = identity(&[make(5)])  if flag { return 1 }  return read(view) }
fn a2(flag: bool) -> i32 { let view = identityMut(&mut [make(5)])  if flag { return 1 }  bump(move view)  return 0 }
fn a3(flag: bool) -> i32 { let view = identity(&[make(5)])  let mut total = 0  if flag { return 1 } else { total = 2 }  return read(view) + total }
fn b1(p: Packet) -> i32 { match move p { Packet.Ready { value } => { let holder = Holder { view: &[make(value)] }  let seen = read(holder.view) }  Packet.Empty => {} }  return 0 }
fn b9(p: Packet) -> i32 { match move p { Packet.Ready { value } => { let view = identity(&[make(value)])  let holder = Holder { view: view }  let seen = read(holder.view) }  Packet.Empty => {} }  return 0 }
fn c3(n: i32) -> i32 { let mut i = 0  let mut total = 0  while i < n { let view = identity(&[make(i)])  if i == 3 { break }  total = total + read(view)  i = i + 1 }  return total }
fn c4(n: i32) -> i32 { let mut i = 0  let mut total = 0  while i < n { i = i + 1  let view = identity(&[make(i)])  if i == 3 { continue }  total = total + read(view) }  return total }
fn c5(p: Packet, flag: bool) -> i32 { let mut total = 0  match move p { Packet.Ready { value } => { let view = identity(&[make(value)])  if flag { return 1 }  total = read(view) }  Packet.Empty => {} }  return total }
effect fn d4(flag: bool) -> i32 { let view = identity(&[make(5)])  if flag { return 1 }  let x = run pause()  return read(view) + x }
fn f3(flag: bool) -> i32 { let holder = Holder { view: &[make(1)] }  if flag { return 1 }  return read(holder.view) }
fn f4(n: i32) -> i32 { let mut i = 0  while i < n { let packet = Packet.Ready { value: i }  match move packet { Packet.Ready { value } => { let holder = Holder { view: &[make(value)] }  i = i + read(holder.view) }  Packet.Empty => {} }  i = i + 1 }  return i }
effect fn h3(p: Packet) -> i32 { let w = Wrap { view: identity(&[make(5)]) }  let x = match move p { Packet.Ready { value } => run pause()  Packet.Empty => 0 }  return read(w.view) + x }
effect fn m1(p: Packet) -> i32 { let eff = useView(&[make(5)])  let mut x = 0  match move p { Packet.Ready { value } => { x = run eff }  Packet.Empty => {} }  return x }
effect fn m2(p: Packet) -> i32 { let eff = useHolder(Holder { view: identity(&[make(5)]) })  let mut x = 0  match move p { Packet.Ready { value } => { x = run eff }  Packet.Empty => {} }  return x }
effect fn m3(p: Packet) -> i32 { let eff = useHolder(Holder { view: &[make(5)] })  let mut x = 0  match move p { Packet.Ready { value } => { x = run eff }  Packet.Empty => {} }  return x }
effect fn n1(flag: bool) -> i32 { let eff = useHolder(Holder { view: identity(&[make(5)]) })  let mut x = 0  if flag { x = run eff }  return x }
fn q2(p: Packet) -> i32 { let view = identity(&[make(5)])  let mut x = 0  match move p { Packet.Ready { value } => { x = read(view) }  Packet.Empty => { x = 2 } }  let other = [make(2)]  return read(&other) + x }
effect fn r1(p: Packet) -> i32 { let view = identity(&[make(5)])  let mut x = 0  match move p { Packet.Empty => { let h = Holder { view: view } }  Packet.Ready { value } => { x = run pause() } }  return x }
effect fn r2(p: Packet) -> i32 { let view = identity(&[make(5)])  let eff = useView(view)  let mut x = 0  match move p { Packet.Empty => { let h = Holder { view: view } }  Packet.Ready { value } => { x = run eff } }  return x }
struct Pair<'a, 'b> { a: &'a [Res]  b: &'b [Res] }
fn first<'a, 'b>(x: &'a [Res], y: &'b [Res]) -> &'a [Res] { return x }
fn label(res: &[Res]) -> &'static [u8] { return b"x" }
fn e1() -> i32 { let a = [make(3)]  let b = [make(5)]  let mut r: &[Res] = &b  r = first(&a, &[make(4)])  return read(r) }
fn e2() -> i32 { let mut s: &'static [u8] = b"y"  s = label(&[make(4)])  if s[0] == 120 { return 0 }  return 1 }
fn e3() -> i32 { let a = [make(3)]  let b = [make(5)]  let c = [make(4)]  let mut r: &[Res] = &b  r = Pair { a: &a, b: &c }.a  return read(r) }
struct G<'a, 'b> { a: &'a [Res]  b: &'b [Res] }
impl<'a: 'b, 'b> G<'a, 'b> { fn pick(x: &'a [Res], y: &'b [Res]) -> &'b [Res] { return x } }
fn e5() -> i32 { let b = [make(5)]  let n = read(G.pick(&[make(4)], &b))  return n }
struct W<'b> { r: &'b [Res]  res: Res }
impl<'b> Intrinsic.Drop for W<'b> { fn drop(self: &mut W<'b>) -> () { return () } }
fn inner<'a, 'b>(x: &'a W<'b>) -> &'b [Res] { return x.r }
fn e6() -> i32 { let v = [make(7)]  let w = [make(8)]  let mut r: &[Res] = &w  r = inner(&W { r: &v, res: make(1) })  return read(r) }
fn e7() -> i32 { let label = fn(r: &[Res]) -> &'static [u8] { return b"x" }  let mut s: &'static [u8] = b"y"  s = label(&[make(4)])  if s[0] == 120 { return 0 }  return 1 }
struct B<'a> { r: &'a [Res]  res: Res }
fn e8() -> i32 { let v = [make(1)]  let mut b = B { r: &v, res: make(2) }  b.r = &[make(3)]  return b.res.value }
struct Named { name: &'static [u8]  res: Res }
fn viewNamed(named: &Named) -> &Named { return named }
fn namesOf(xs: &[Named]) -> &[Named] { return xs }
struct Outer2<'a> { inner: &'a [Res]  own: Res }
fn refOuter<'x, 'a>(o: &'x Outer2<'a>) -> &'x Outer2<'a> { return o }
fn g1() -> i32 { let mut s: &'static [u8] = b"y"  s = viewNamed(&Named { name: b"x", res: make(1) }).name  if s[0] == 120 { return 0 }  return 1 }
fn g2(value: i32) -> &'static [u8] { return viewNamed(&Named { name: b"x", res: make(value) }).name }
fn g3() -> i32 { let mut s: &'static [u8] = b"y"  s = namesOf(&[Named { name: b"x", res: make(1) }])[0].name  if s[0] == 120 { return 0 }  return 1 }
fn g4() -> i32 { let a = [make(1)]  let b = [make(2)]  let mut r: &[Res] = &b  r = refOuter(&Outer2 { inner: &a, own: make(3) }).inner  return read(r) }
fn g5(n: i32) -> i32 { let mut s: &'static [u8] = b"y"  let mut i = 0  while i < n { let view = namesOf(&[Named { name: b"x", res: make(i) }])  s = view[0].name  i = i + 1 }  if s[0] == 120 { return 0 }  return 1 }
fn g6() -> i32 { let mut s: &'static [u8] = b"y"  let names = namesOf(&[Named { name: b"x", res: make(1) }, Named { name: b"z", res: make(2) }])  s = names[1].name  if s[0] == 122 { return 0 }  return 1 }
fn e4(n: i32) -> i32 { let a = [make(3)]  let mut r: &[Res] = &a  let mut i = 0  while i < n { r = first(r, &[make(i)])  i = i + 1 }  return read(r) }
fn b3(n: i32) -> i32 { let a = [make(1)]  let b = [make(2)]  let mut prev: &[Res] = &a  let mut i = 0  let mut total = 0  while i < n { total = total + read(prev)  prev = &b  i = i + 1 }  return total + read(prev) }
fn b6(n: i32) -> i32 { let a = [make(1)]  let b = [make(2)]  let mut found: &[Res] = &a  let mut i = 0  while i < n { let candidate = &b  if read(candidate) == 2 { found = candidate  break }  i = i + 1 }  return read(found) }
fn c6(p: Packet) -> i32 { let a = [make(1)]  let b = [make(2)]  let view = match move p { Packet.Ready { value } => &a  Packet.Empty => &b }  return read(view) }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu)) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let names = [b"a1", b"a2", b"a3", b"b1", b"b9", b"c3", b"c4", b"c5", b"d4", b"f3", b"f4", b"h3", b"m1", b"m2", b"m3", b"n1", b"q2", b"r1", b"r2",
    b"e1", b"e2", b"e3", b"e4", b"e5", b"e6", b"e7", b"e8", b"g1", b"g2", b"g3", b"g4", b"g5", b"g6", b"b3", b"b6", b"c6"]
  let misplaced = [true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true,
    false, false, false, false, true, false, false, true, true, true, true, true, true, true, false, false, false]
  let mut at = usize.ZERO
  while at < 36 {
    let answer = run Semantic.demandMir(&mut store, &mut request, &id, names[at]) |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
    let index = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(&answer, selectedMirIndex)
    let mut lowered = false
    let mut clean = true
    let mut reported = false
    if let Option<usize>.Some {value: first} = move index {
      lowered = true
      // The body and the helpers lowered with it, which hold an Effect body's temporaries.
      let mut position = first
      let mut helping = true
      while helping {
        helping = false
        let mut copied = Option<MirFunction>.none()
        if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(&store, position) {
          if position == first || match &function.key { InstanceKey.Helper {..} => true _ => false } {
            copied = Option<MirFunction>.some(run copyMirShape(function) |> Effect.provideMut<Allocator>(&mut allocator))
          }
        }
        if let Option<MirFunction>.Some {value: original} = move copied {
          helping = true
          let found = run Semantic.useAfterDrop(&mut store, &mut request, &original) |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
          clean = clean && Vector<MirVerification.UseAfterDrop>.length(&found) == usize.ZERO
          let mut perturbed = run copyMirShape(&original) |> Effect.provideMut<Allocator>(&mut allocator)
          if let Option<usize>.Some {value: temporary} = move run misplaceTemporaryDrop(&mut perturbed) |> Effect.provideMut<Allocator>(&mut allocator) {
            let early = run Semantic.useAfterDrop(&mut store, &mut request, &perturbed) |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
            reported = reported || reportsDropOf(&early, temporary)
          }
        }
        position = position + usize.ONE
      }
    }
    run Testing.expect(lowered && clean, "lowering keeps every temporary until its last use")
    let expected = misplaced[at]
    run Testing.expect((reported && expected) || (!reported && !expected), "moving a temporary's drop before a use of a view of it is a use after drop")
    at = at + usize.ONE
  }
  return ()
}

// Moves a temporary's whole drops to the start of the normal successor of the call that ends the
// block of its first borrow, or right after that borrow, and returns the temporary: only view
// tracking can see the early drop.
effect fn misplaceTemporaryDrop(function: &mut MirFunction) -> Option<usize> ! OutOfMemoryError ? &mut Allocator {
  let site = run firstTemporaryBorrow(&function.*)
  if let Option<BorrowSite>.Some {value: found} = move site {
    let mut block = usize.ZERO
    while block < Vector<MirBlock>.length(&function.blocks) {
      let blocks = Vector<MirBlock>.asSlice(&function.blocks)
      let statements = Vector<MirStatement>.asSlice(&blocks[block].statements)
      let mut rebuilt = Vector<MirStatement>.make()
      if block == found.after && found.statement == usize.MAX { run Vector<MirStatement>.append(&mut rebuilt, run copyMirStatement(&found.dropped)) }
      let mut copied = usize.ZERO
      while copied < statements.length {
        if !isWholeDropOf(&statements[copied], found.local) {
          run Vector<MirStatement>.append(&mut rebuilt, run copyMirStatement(&statements[copied]))
        }
        if block == found.after && copied == found.statement { run Vector<MirStatement>.append(&mut rebuilt, run copyMirStatement(&found.dropped)) }
        copied = copied + usize.ONE
      }
      let mut replaced = run copyMirBlock(&blocks[block])
      replaced.statements = move rebuilt
      Vector<MirBlock>.set(&mut function.blocks, block, move replaced)
      block = block + usize.ONE
    }
    return Option<usize>.some(found.local)
  }
  return Option<usize>.none()
}

fn reportsDropOf(found: &Vector<MirVerification.UseAfterDrop>, local: usize) -> bool {
  let entries = Vector<MirVerification.UseAfterDrop>.asSlice(found)
  let mut at = usize.ZERO
  while at < entries.length {
    if entries[at].dropped == local { return true }
    at = at + usize.ONE
  }
  return false
}

fn isWholeDropOf(statement: &MirStatement, local: usize) -> bool {
  return match &statement.* {
    MirStatement.Drop {destination, ..} => destination.local == local && Vector<MirProjection>.length(&destination.projections) == usize.ZERO
    _ => false
  }
}

// The first borrow of a temporary that the function drops whole, and a copy of that drop.
struct BorrowSite {
  after: usize
  statement: usize
  local: usize
  dropped: MirStatement
}

effect fn firstTemporaryBorrow(function: &MirFunction) -> Option<BorrowSite> ! OutOfMemoryError ? &mut Allocator {
  let blocks = Vector<MirBlock>.asSlice(&function.blocks)
  let locals = Vector<MirLocal>.asSlice(&function.locals)
  let mut block = usize.ZERO
  while block < blocks.length {
    let statements = Vector<MirStatement>.asSlice(&blocks[block].statements)
    let mut at = usize.ZERO
    while at < statements.length {
      let borrowed = match &statements[at] {
        MirStatement.Assign {value: MirRvalue.Ref {place, ..}, ..} => place.local
        _ => usize.MAX
      }
      if borrowed != usize.MAX && match &locals[borrowed].kind { MirLocalKind.Temp => true _ => false } {
        if let Option<MirStatement>.Some {value: dropped} = move run wholeDropOf(function, borrowed) {
          let site = match &blocks[block].terminator {
            MirTerminator.Call {normal, ..} => BorrowSite {after: normal, statement: usize.MAX, local: borrowed, dropped: move dropped}
            _ => BorrowSite {after: block, statement: at, local: borrowed, dropped: move dropped}
          }
          return Option<BorrowSite>.some(move site)
        }
      }
      at = at + usize.ONE
    }
    block = block + usize.ONE
  }
  return Option<BorrowSite>.none()
}

effect fn wholeDropOf(function: &MirFunction, local: usize) -> Option<MirStatement> ! OutOfMemoryError ? &mut Allocator {
  let blocks = Vector<MirBlock>.asSlice(&function.blocks)
  let mut block = usize.ZERO
  while block < blocks.length {
    let statements = Vector<MirStatement>.asSlice(&blocks[block].statements)
    let mut at = usize.ZERO
    while at < statements.length {
      if let MirStatement.Drop {destination, ..} = &statements[at] {
        if destination.local == local && Vector<MirProjection>.length(&destination.projections) == usize.ZERO {
          return Option<MirStatement>.some(run copyMirStatement(&statements[at]))
        }
      }
      at = at + usize.ONE
    }
    block = block + usize.ONE
  }
  return Option<MirStatement>.none()
}
