test effect fn genericInherentInferencePreservesOriginalScopeOrdinals() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("inherent-signature-slots.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
struct Pair<A, B> { left: A right: B }
impl<A, B> Pair<A, B> {
  fn second(value: B) -> B { return move value }
  fn keep<U>(value: U) -> U { return move value }
  fn bodyOnly() -> i32 { return ignore<A>() }
}
fn ignore<T>() -> i32 { return 42 }
fn calls() -> i32 {
  let partial: u8 = Pair.second<u8>(42)
  let independent: u8 = Pair.keep<u8>(42)
  let applied: u8 = Pair<i64, bool>.keep<u8>(42)
  let bodyApplied: i32 = Pair<i64, bool>.bodyOnly()
  return 0
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let calls = run Semantic.demandBody(&mut store, &mut request, &id, b"calls") |> Effect.provideMut<Allocator>(&mut allocator)
  let partialApplication = run directApplicationAt(&calls, usize.ZERO) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut originalOrdinal = false
  if let Option<SpecializationApplication>.Some {value} = move partialApplication {
    let scopes = Vector.asSlice<ScopeBinding>(&value.scopes)
    if scopes.length == usize.ONE {
      let arguments = Vector.asSlice<Argument>(&scopes[usize.ZERO].arguments)
      let ordinals = Vector.asSlice<usize>(&scopes[usize.ZERO].argumentOrdinals)
      originalOrdinal = Vector.length<Argument>(&value.arguments) == usize.ZERO
        && arguments.length == usize.ONE && ordinals.length == usize.ONE
        && ordinals[usize.ZERO] == usize.ONE && applicationArgumentIs(&arguments[usize.ZERO], b"u8")
    }
  }
  run Testing.expect(originalOrdinal, "a partial owner signature infers B while retaining its original ordinal one")
  let independentApplication = run directApplicationAt(&calls, usize.ONE) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut noFabrication = false
  if let Option<SpecializationApplication>.Some {value} = move independentApplication {
    let arguments = Vector.asSlice<Argument>(&value.arguments)
    noFabrication = Vector.length<ScopeBinding>(&value.scopes) == usize.ZERO && arguments.length == usize.ONE
      && applicationArgumentIs(&arguments[usize.ZERO], b"u8")
  }
  run Testing.expect(noFabrication, "an owner-independent member stores only its own complete argument")
  let appliedApplication = run directApplicationAt(&calls, 2) |> Effect.provideMut<Allocator>(&mut allocator)
  let bodyApplication = run directApplicationAt(&calls, 3) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut fullApplied = false
  let mut bodyBindings = false
  if let Option<SpecializationApplication>.Some {value} = move appliedApplication {
    let scopes = Vector.asSlice<ScopeBinding>(&value.scopes)
    if scopes.length == usize.ONE {
      let arguments = Vector.asSlice<Argument>(&scopes[usize.ZERO].arguments)
      let own = Vector.asSlice<Argument>(&value.arguments)
      fullApplied = arguments.length == 2 && own.length == usize.ONE
        && applicationArgumentIs(&arguments[usize.ZERO], b"i64") && applicationArgumentIs(&arguments[usize.ONE], b"bool")
        && applicationArgumentIs(&own[usize.ZERO], b"u8")
    }
  }
  if let Option<SpecializationApplication>.Some {value} = move bodyApplication {
    let scopes = Vector.asSlice<ScopeBinding>(&value.scopes)
    if scopes.length == usize.ONE {
      let arguments = Vector.asSlice<Argument>(&scopes[usize.ZERO].arguments)
      bodyBindings = arguments.length == 2 && applicationArgumentIs(&arguments[usize.ZERO], b"i64")
        && applicationArgumentIs(&arguments[usize.ONE], b"bool")
    }
  }
  run Testing.expect(fullApplied && bodyBindings, "an applied owner retains every lexical binding including body-only uses")
  return ()
}

fn recordLayoutType(body: &TypedBody) -> Option<Shared<Type>> {
  let locals = TypedBody.localSlice(body)
  if locals.length != usize.ONE { return Option.none<Shared<Type>>() }
  return Option.some<Shared<Type>>(Shared.clone<Type>(&locals[usize.ZERO].ty))
}

test effect fn aggregateLayoutRetainsFieldOffsetsAndChildPadding() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("record-layout.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let mut store = run staticSemantic(&id, """
struct Inner {
  first: u8
  second: i32
  third: u8
}
struct Outer {
  prefix: u8
  nested: Inner
}
fn probe(value: Outer) -> i32 { return 42 }
""", MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let bodyAnswer = run Semantic.demandBody(&mut store, &mut request, &id, b"probe")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let body = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(&bodyAnswer, checkedBody)
  let mut ty = Option.none<Shared<Type>>()
  if let Option<Shared<TypedBody>>.Some {value} = move body {
    ty = Shared.with<TypedBody, Option<Shared<Type>>>(&value, recordLayoutType)
  }
  let record = match move ty {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => {
      run Testing.expect(false, "the record parameter retains its nominal type")
      return ()
    }
  }
  let answer = run Semantic.demandLayout(&mut store, &mut request, &id, &record)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let selected = Shared.with<Result<Answer, NoRejection>, Option<usize>>(&answer, selectedLayoutIndex)
  let hasLayout = match &selected {
    Option<usize>.Some {..} => true
    Option<usize>.None => false
  }
  run Testing.expect(hasLayout, "the aggregate query publishes a layout answer")
  let mut aligned = false
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<Shared<BackendLayout>>.Some {value: facts} = move Semantic.layoutAt(&store, index) {
      aligned = Shared.with<BackendLayout, bool>(&facts, fn(layout: &BackendLayout) -> bool {
        if let LayoutStorage.Record {fields} = &layout.storage {
          let entries = Vector.asSlice<LayoutField>(&fields)
          if entries.length == 2 {
            return layout.size == 16 && layout.alignment == 4 && layout.abi == LayoutAbi.Indirect
              && entries[usize.ZERO].offset == usize.ZERO && entries[usize.ONE].offset == 4
          }
        }
        return false
      })
    }
  }
  run Testing.expect(aligned, "record padding and alignment come from recursively demanded child layouts")
  return ()
}

fn genericRecordLayout(layout: &BackendLayout, size: usize, alignment: usize, valueOffset: usize) -> bool {
  if let LayoutStorage.Record {fields} = &layout.storage {
    let entries = Vector.asSlice<LayoutField>(&fields)
    return entries.length == 2 && layout.size == size && layout.alignment == alignment
      && entries[usize.ZERO].offset == usize.ZERO && entries[usize.ONE].offset == valueOffset
  }
  return false
}

test effect fn genericRecordConstructionPrefixesRemainFixedAndQualified() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("generic-record-prefix.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let library = run module("records.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
import records as Records
struct Pair<A, B> { first: A second: B }
struct Tail<A, MissingTail> { first: A }
fn prefixed() -> i32 { let pair = Pair<i32> { first: 42, second: true } if pair.second { return pair.first } return 0 }
fn qualified() -> i32 { let pair = Records.Pair { first: 42, second: true } if pair.second { return pair.first } return 0 }
fn conflict() -> i32 { let pair = Pair<i32> { first: false, second: true } return 0 }
fn uninferred() -> i32 { let tail = Tail<i32> { first: 42 } return 0 }
"""
  let entrySource = run present(text) |> Effect.provideMut<Allocator>(&mut allocator)
  let librarySource = run present("pub struct Pair<A, B> { pub first: A pub second: B }") |> Effect.provideMut<Allocator>(&mut allocator)
  let first = run Revision.publish(&Revision.make(), &id, &entrySource) |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&first, &library, &librarySource) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut store = Semantic.traced(move revision, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu), Option.none<FinalProfile>())
  let mut request = Request.make()
  let prefixed = run Semantic.demandBody(&mut store, &mut request, &id, b"prefixed") |> Effect.provideMut<Allocator>(&mut allocator)
  let qualified = run Semantic.demandBody(&mut store, &mut request, &id, b"qualified") |> Effect.provideMut<Allocator>(&mut allocator)
  let prefixType = bodyLocalType(&prefixed, usize.ZERO)
  let qualifiedType = bodyLocalType(&qualified, usize.ZERO)
  let mut completePrefix = false
  let mut completeQualified = false
  if let Option<Shared<Type>>.Some {value} = move prefixType { completePrefix = nominalOfKind(&value, OwnerKind.Struct) && !Type.hasOpenParameters(&value) }
  if let Option<Shared<Type>>.Some {value} = move qualifiedType { completeQualified = nominalOfKind(&value, OwnerKind.Struct) && !Type.hasOpenParameters(&value) }
  run Testing.expect(completePrefix && completeQualified, "written prefixes and namespace-qualified owners infer only omitted aggregate parameters")
  let conflict = run Semantic.demandBody(&mut store, &mut request, &id, b"conflict") |> Effect.provideMut<Allocator>(&mut allocator)
  let uninferred = run Semantic.demandBody(&mut store, &mut request, &id, b"uninferred") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsSpan(&conflict, RejectionCode.TypeMismatch, text, "false", 0), "payload inference cannot overwrite a fixed i32 prefix")
  run Testing.expect(rejectsSpan(&uninferred, RejectionCode.UninferredParameter, text, "MissingTail", 0), "an omitted uninferred tail retains its declaration diagnostic")
  return ()
}

test effect fn genericRecordPatternsCheckAbstractlyBeforeCompleteMir() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("generic-record-pattern.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
struct Box<T> { value: T }
struct Other<T> { value: T }
fn unwrap<T>(boxed: Box<T>, enabled: bool) -> T {
  return match move boxed { Box<T> { value } if enabled => move value Box<T> { value } => move value }
}
fn wrong<T>(boxed: Box<T>) -> i32 { return match move boxed { Other<T> { .. } => 0 } }
fn caller() -> i32 { let boxed = Box<i32> { value: 42 } return unwrap<i32>(move boxed, true) }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu)) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let abstractBody = run Semantic.demandBody(&mut store, &mut request, &id, b"unwrap") |> Effect.provideMut<Allocator>(&mut allocator)
  let wrong = run Semantic.demandBody(&mut store, &mut request, &id, b"wrong") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(succeeded(&abstractBody), "a caller-owned T is valid record pattern evidence in an ordinary abstract body")
  run Testing.expect(rejectsSpan(&wrong, RejectionCode.TypeMismatch, text, "Other<T> { .. }", 0), "an abstract pattern must still select the subject's exact record")
  let caller = run Semantic.demandBody(&mut store, &mut request, &id, b"caller") |> Effect.provideMut<Allocator>(&mut allocator)
  let application = run directApplicationAt(&caller, usize.ZERO) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut realized = false
  if let Option<SpecializationApplication>.Some {value} = move application {
    let mir = run Semantic.demandApplicationMir(&mut store, &mut request, &value) |> Effect.provideMut<Allocator>(&mut allocator)
    let selected = Shared.with<Result<Answer, NoRejection>, Option<usize>>(&mir, selectedMirIndex)
    if let Option<usize>.Some {value: index} = move selected {
      if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(&store, index) {
        realized = !Type.hasOpenRuntimeParameters(&function.result)
        let locals = Vector.asSlice<MirLocal>(&function.locals)
        let mut at = usize.ZERO
        while at < locals.length { realized = realized && !Type.hasOpenRuntimeParameters(&locals[at].ty) at = at + usize.ONE }
      }
    }
  }
  run Testing.expect(realized, "the same abstract record pattern realizes under a complete i32 application with closed MIR types")
  return ()
}

test effect fn genericNominalConstructionRetainsLexicalBounds() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("generic-nominal-lexical-bounds.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
struct Box<T: Copy> { value: T }
fn applied<U: Copy>(value: U) -> Box<U> { let boxed: Box<U> = Box<U> { value: value } return move boxed }
fn inferred<U: Copy>(value: U) -> Box<U> { return Box { value: value } }
fn unbounded<U>(value: U) -> i32 { let boxed = Box<U> { value: move value } return 0 }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu)) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let applied = run Semantic.demandBody(&mut store, &mut request, &id, b"applied") |> Effect.provideMut<Allocator>(&mut allocator)
  let inferred = run Semantic.demandBody(&mut store, &mut request, &id, b"inferred") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(succeeded(&applied) && succeeded(&inferred), "applied annotations and both constructor lanes retain the lexical U: Copy premise")
  let unbounded = run Semantic.demandBody(&mut store, &mut request, &id, b"unbounded") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsSpan(&unbounded, RejectionCode.Unsupported, text, "Box<U> { value: move value }", 0), "an unbounded U does not gain a fabricated Copy proof")
  return ()
}

