fn genericGapKeepsInlineStorageDiagnostic(gap: &BackendGap) -> bool {
  return match &gap.source {
    GapSource.Diagnostic {diagnostic} => Shared.with<Rejection, bool>(&diagnostic,
      fn(problem: &Rejection) -> bool { return problem.code == RejectionCode.InlineStorageUnavailable })
    _ => false
  }
}

test effect fn genericCleanupPropertiesKeepFiniteOpaqueDescentAndRejectGrowth() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("generic-cleanup-storage-descent.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
struct Plain<T> { value: T }
struct Storage { value: Plain<i32> }
fn finite(value: Plain<Storage>) -> i32 { return 0 }
struct CleanupGrowing<T> { child: CleanupGrowing<[T; 1]> }
fn shape(value: CleanupGrowing<i32>) -> i32 { return 0 }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu)) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let finite = run Semantic.demandMir(&mut store, &mut request, &id, b"finite") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(Shared.with<Result<Answer, NoRejection>, bool>(&finite, pipelineHasMir),
    "cleanup-free stored fields may descend through opaque nominal arguments before returning to the same declaration")
  let shape = run Semantic.demandBody(&mut store, &mut request, &id, b"shape") |> Effect.provideMut<Allocator>(&mut allocator)
  let growing = match move bodyLocalType(&shape, usize.ZERO) {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => { run Testing.expect(false, "the complete growing parameter is typed before cleanup demand") return () }
  }
  let sourceOwner = run glueSourceOwner(&mut store, &shape) |> Effect.provideMut<Allocator>(&mut allocator)
  let glue = run Semantic.demandGlueMir(&mut store, &mut request, &growing, &sourceOwner) |> Effect.provideMut<Allocator>(&mut allocator)
  let selected = Shared.with<Result<Answer, NoRejection>, Option<Shared<BackendGap>>>(&glue, selectedBackendGap)
  let siteMatches = match move selected {
    Option<Shared<BackendGap>>.Some {value} => Shared.with<BackendGap, bool>(&value, fn(gap: &BackendGap) -> bool {
      let written = "struct CleanupGrowing<T> { child: CleanupGrowing<[T; 1]> }"
      let start = offsetOf(text, written, usize.ZERO)
      let site = BackendGap.span(gap)
      return gap.code == GapCode.InlineStorage && BackendGap.moduleMatches(gap, &id)
        && genericGapKeepsInlineStorageDiagnostic(gap) && genericGapOwnerMatches(gap, &id, b"CleanupGrowing")
        && site.start == start && site.end == start + String.utf8Bytes(written).length
    })
    Option<Shared<BackendGap>>.None => false
  }
  run Testing.expect(siteMatches,
    "growing inline cleanup retains the named storage-recursion gap at its exact authored module and aggregate declaration")
  return ()
}

test effect fn genericCopyCyclesKeepCompleteImportedDiagnosticSite() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let leftId = run module("copy_left.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let rightId = run module("copy_right.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let leftText = """import copy_right { Right }
pub struct Left<T> { pub right: Right<T> }
impl<T> Copy for Left<T> {}
fn inspect(value: &Left<i32>) -> i32 { drop value.* return 0 }
"""
  let rightText = """// The imported implementation deliberately starts beyond every byte in the entry module so a detached span paired with the repeated Left type's module cannot accidentally satisfy the source location assertion.
import copy_left { Left }
pub struct Right<T> { pub left: Left<T> }
impl<T> Copy for Right<T> {}
"""
  let leftSource = run present(leftText) |> Effect.provideMut<Allocator>(&mut allocator)
  let rightSource = run present(rightText) |> Effect.provideMut<Allocator>(&mut allocator)
  let first = run Revision.publish(&Revision.make(), &leftId, &leftSource) |> Effect.provideMut<Allocator>(&mut allocator)
  let held = run Revision.publish(&first, &rightId, &rightSource) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut store = makeSemantic(move held)
  let mut request = Request.make()
  let body = run Semantic.demandBody(&mut store, &mut request, &leftId, b"inspect") |> Effect.provideMut<Allocator>(&mut allocator)
  let found = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(&body, rejection)
  let siteMatches = match move found {
    Option<Shared<Rejection>>.Some {value} => Shared.with<Rejection, bool>(&value, fn(problem: &Rejection) -> bool {
      let start = offsetOf(rightText, "impl<T> Copy for Right<T> {}", usize.ZERO)
      return problem.code == RejectionCode.InvalidCopyConformance && ModuleId.equals(&problem.module, &rightId)
        && !ModuleId.equals(&problem.module, &leftId) && start > String.utf8Bytes(leftText).length
        && problem.span.start == start && problem.span.end == start + String.utf8Bytes("impl<T> Copy for Right<T> {}").length
    })
    Option<Shared<Rejection>>.None => false
  }
  run Testing.expect(siteMatches, "a cross-module Copy cycle retains the selecting implementation's module and exact span as one rejection site")
  return ()
}

test effect fn genericSealedCopyUsesLexicalAndLifetimePremises() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("generic-sealed-copy-premises.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
struct Box<T> { value: T }
impl<T: Copy> Copy for Box<T> {}
fn abstractCopied<T: Copy>(proved: &Box<Box<T>>) -> i32 { drop proved.* return 0 }
fn abstractAffine<T>(unproved: &Box<Box<T>>) -> i32 { drop unproved.* return 0 }
fn accepts<U: Copy>(value: U) -> i32 { return 0 }
fn abstractApplied<T: Copy>(value: Box<Box<T>>) -> i32 { return accepts<Box<Box<T>>>(move value) }
struct View<'a> { value: &'a i32 }
impl<'a: 'static> Copy for View<'a> {}
fn lifetimeCopied(lasting: &View<'static>) -> i32 { drop lasting.* return 0 }
fn assumedLifetimeCopied<'a: 'static>(assumed: &View<'a>) -> i32 { drop assumed.* return 0 }
struct Lasting<T> { value: T }
impl<T: Copy + 'static> Copy for Lasting<T> {}
fn retainedCopied<T: Copy + 'static>(retained: &Lasting<T>) -> i32 { drop retained.* return 0 }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let positive = run Semantic.demandBody(&mut store, &mut request, &id, b"abstractCopied")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let negative = run Semantic.demandBody(&mut store, &mut request, &id, b"abstractAffine")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let concreteLifetime = run Semantic.demandBody(&mut store, &mut request, &id, b"lifetimeCopied")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let lexicalLifetime = run Semantic.demandBody(&mut store, &mut request, &id, b"assumedLifetimeCopied")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let applied = run Semantic.demandBody(&mut store, &mut request, &id, b"abstractApplied")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let retained = run Semantic.demandBody(&mut store, &mut request, &id, b"retainedCopied")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(succeeded(&positive), "nested conditional Copy retains the ordinary body's lexical T: Copy premise")
  run Testing.expect(rejectsSpan(&negative, RejectionCode.BorrowedExtraction, text, "unproved.*", usize.ZERO),
    "an unconstrained abstract payload is not guaranteed Copy and remains affine")
  run Testing.expect(succeeded(&concreteLifetime), "a complete static lifetime proves the conditional Copy head")
  run Testing.expect(succeeded(&lexicalLifetime), "lexical outlives premises prove the conditional Copy head abstractly")
  run Testing.expect(succeeded(&applied), "generic-call bound proof recursively retains lexical Copy premises")
  run Testing.expect(succeeded(&retained), "lexical contents-lifetime premises remain available to a conditional Copy head")
  return ()
}

// Read the selected hook's impl scope, not the nominal owner's arguments or the caller's scope.
fn dropHookScopeMatches(application: &SpecializationApplication, first: &[u8], second: &[u8]) -> bool {
  if !DeclarationId.named(SpecializationApplication.bodyDeclaration(application), b"drop") { return false }
  let scopes = Vector.asSlice<ScopeBinding>(&application.scopes)
  if scopes.length != usize.ONE { return false }
  let arguments = Vector.asSlice<Argument>(&scopes[usize.ZERO].arguments)
  let ordinals = Vector.asSlice<usize>(&scopes[usize.ZERO].argumentOrdinals)
  let mut count: usize = 2
  if second.length == usize.ZERO { count = usize.ONE }
  if arguments.length != count || ordinals.length != count || ordinals[usize.ZERO] != usize.ZERO
    || !applicationArgumentIs(&arguments[usize.ZERO], first) { return false }
  return count == usize.ONE || (ordinals[usize.ONE] == usize.ONE && applicationArgumentIs(&arguments[usize.ONE], second))
}

fn glueHookScopeMatches(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>, first: &[u8], second: &[u8]) -> bool {
  let selected = Shared.with<Result<Answer, NoRejection>, Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      let blocks = Vector.asSlice<MirBlock>(&function.blocks)
      let mut at = usize.ZERO
      while at < blocks.length {
        if let MirTerminator.Call {callee: MirCallee.Instance {key}, ..} = &blocks[at].terminator {
          if let Option<Shared<SpecializationApplication>>.Some {value: application} = move InstanceKey.application(&key) {
            return Shared.with<SpecializationApplication, bool>(&application,
              fn(value: &SpecializationApplication) -> bool { return dropHookScopeMatches(value, first, second) })
          }
          return false
        }
        at = at + usize.ONE
      }
    }
  }
  return false
}

// Glue assertions need the complete parameter type, not an unasserted wrapper's cleanup MIR.
effect fn genericParameterGlue(
  store: &mut Semantic, request: &mut Request, body: &Shared<Result<Answer, NoRejection>>, parameter: usize,
) -> Shared<Result<Answer, NoRejection>>
! AssertionError<'static> | InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let sourceOwner = run glueSourceOwner(&mut store.*, body)
  return match move bodyLocalType(body, parameter) {
    Option<Shared<Type>>.Some {value} => run Semantic.demandGlueMir(&mut store.*, &mut request.*, &value, &sourceOwner)
    Option<Shared<Type>>.None => Shared.clone<Result<Answer, NoRejection>>(body)
  }
}

test effect fn genericSealedDropRetainsExactHeadBindings() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("generic-sealed-drop-bindings.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
struct Pair<A, B> { first: A second: B }
impl<X, Y> Drop for Pair<Y, X> { fn drop(self: &mut Pair<Y, X>) -> () { return () } }
struct Packed<T> { value: T }
impl<U> Drop for Packed<[U; 2]> { fn drop(self: &mut Packed<[U; 2]>) -> () { return () } }
struct Guard<'a> { count: &'a mut i32 }
impl<'a: 'static> Drop for Guard<'a> { fn drop(self: &mut Guard<'a>) -> () { return () } }
struct Lasting<T> { value: T }
impl<T: 'static> Drop for Lasting<T> { fn drop(self: &mut Lasting<T>) -> () { return () } }
fn instances(swapped: Pair<i32, bool>, nested: Packed<[i32; 2]>, lasting: Guard<'static>, contents: Lasting<&'static i32>) -> i32 { return 0 }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let body = run Semantic.demandBody(&mut store, &mut request, &id, b"instances") |> Effect.provideMut<Allocator>(&mut allocator)
  let swapped = run genericParameterGlue(&mut store, &mut request, &body, usize.ZERO) |> Effect.provideMut<Allocator>(&mut allocator)
  let nested = run genericParameterGlue(&mut store, &mut request, &body, usize.ONE) |> Effect.provideMut<Allocator>(&mut allocator)
  let lasting = run genericParameterGlue(&mut store, &mut request, &body, 2) |> Effect.provideMut<Allocator>(&mut allocator)
  let contents = run genericParameterGlue(&mut store, &mut request, &body, 3) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(glueFact(&store, &swapped, usize.ONE) == usize.ONE && glueHookScopeMatches(&store, &swapped, b"bool", b"i32"),
    "Pair<i32, bool> invokes exactly one hook with impl X=bool and Y=i32, not nominal positions")
  run Testing.expect(glueFact(&store, &nested, usize.ONE) == usize.ONE && glueHookScopeMatches(&store, &nested, b"i32", b""),
    "a nested provider head binds U=i32, not the nominal owner's array argument")
  run Testing.expect(glueFact(&store, &lasting, usize.ONE) == usize.ONE,
    "a complete lifetime-bound Drop head is applicable and emits exactly one hook call")
  run Testing.expect(glueFact(&store, &contents, usize.ONE) == usize.ONE,
    "a complete retained-contents bound proves Drop rather than omitting its hook")
  return ()
}

fn genericDefinitionCalls(text: &[u8], definition: &[u8], callee: &[u8]) -> bool {
  let mut at = usize.ZERO
  let mut begin = usize.ZERO
  let mut selected = false
  while at <= text.length {
    if at == text.length || text[at] == 10 {
      let line = Slice.view<u8>(text, begin, at - begin)
      if containsIr(line, b"define ") { selected = containsIr(line, definition) }
      if selected && containsIr(line, b"call ") && containsIr(line, callee) { return true }
      begin = at + usize.ONE
    }
    at = at + usize.ONE
  }
  return false
}

effect fn genericMirHasExactDrop(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>, key: &InstanceKey) -> bool
! OutOfMemoryError ? &mut Allocator {
  let selected = Shared.with<Result<Answer, NoRejection>, Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      let blocks = Vector.asSlice<MirBlock>(&function.blocks)
      let mut at = usize.ZERO
      let mut count = usize.ZERO
      while at < blocks.length {
        let statements = Vector.asSlice<MirStatement>(&blocks[at].statements)
        let mut position = usize.ZERO
        while position < statements.length {
          if let MirStatement.Drop {glue, ..} = &statements[position] {
            if !(run InstanceKey.sameApplication(&glue, key)) { return false }
            count = count + usize.ONE
          }
          position = position + usize.ONE
        }
        at = at + usize.ONE
      }
      return count == usize.ONE
    }
  }
  return false
}

effect fn genericGlueEdgesAreEmitted(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>, plan: &EmissionPlan, ir: &[u8]) -> bool
! BackendGap | OutOfMemoryError ? &mut Allocator {
  let selected = Shared.with<Result<Answer, NoRejection>, Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      let name = run EmissionPlan.symbol(plan, &function.key)
      if !genericUniqueSymbolDefinition(ir, Bytes.asSlice(&name)) { return false }
      let blocks = Vector.asSlice<MirBlock>(&function.blocks)
      let mut at = usize.ZERO
      while at < blocks.length {
        let statements = Vector.asSlice<MirStatement>(&blocks[at].statements)
        let mut position = usize.ZERO
        while position < statements.length {
          if let MirStatement.Drop {glue, ..} = &statements[position] {
            let child = match move InstanceKey.glueType(&glue) {
              Option<Shared<Type>>.Some {value} => Shared.with<Type, bool>(&value, fn(ty: &Type) -> bool {
                return match &ty.* { Type.Nominal {declaration, arguments, ..} => DeclarationId.named(&declaration, b"Token") && Vector.length<Argument>(&arguments) == usize.ZERO _ => false }
              })
              _ => false
            }
            let symbol = run EmissionPlan.symbol(plan, &glue)
            if !child || !genericDefinitionCalls(ir, Bytes.asSlice(&name), Bytes.asSlice(&symbol)) { return false }
          }
          position = position + usize.ONE
        }
        if let MirTerminator.Call {callee: MirCallee.Instance {key}, ..} = &blocks[at].terminator {
          let symbol = run EmissionPlan.symbol(plan, &key)
          if !genericDefinitionCalls(ir, Bytes.asSlice(&name), Bytes.asSlice(&symbol)) { return false }
        }
        at = at + usize.ONE
      }
      return true
    }
  }
  return false
}

effect fn genericLifetimeRecipeClaim(id: &ModuleId, text: string, localFirst: bool, conditional: bool, children: bool) -> ()
! CanonicalizationFailure | InvalidModulePath | Cycle | RevisionMismatch | BackendGap | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut store = run applicationSemantic(id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.forApplication(run ModuleId.copy(id))
  let main = run Semantic.demandBody(&mut store, &mut request, id, b"main")
  let lasting = match move bodyLocalType(&main, usize.ZERO) {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => { run Testing.expect(false, "the static Guard fixture binding resolves") return () }
  }
  let short = match move bodyLocalType(&main, 2) {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => { run Testing.expect(false, "the local Guard fixture binding resolves") return () }
  }
  let sourceOwner = run glueSourceOwner(&mut store, &main)
  let lastingKey = run requiredCanonicalGlue(run InstanceKey.dropGlue(&lasting, &sourceOwner))
  let shortKey = run requiredCanonicalGlue(run InstanceKey.dropGlue(&short, &sourceOwner))
  let exact = match &lastingKey {
    Option<InstanceKey>.Some {value: first} => match &shortKey {
      Option<InstanceKey>.Some {value: second} => InstanceKey.sameRuntimeBase(&first, &second)
        && !(run InstanceKey.sameApplication(&first, &second))
      Option<InstanceKey>.None => false
    }
    Option<InstanceKey>.None => false
  }
  run Testing.expect(exact, "lifetime-distinct glue has exact semantic applications despite one erased runtime family")
  let mut firstType = Shared.clone<Type>(&lasting)
  let mut secondType = Shared.clone<Type>(&short)
  if localFirst {
    firstType = Shared.clone<Type>(&short)
    secondType = Shared.clone<Type>(&lasting)
  }
  let first = run Semantic.demandGlueMir(&mut store, &mut request, &firstType, &sourceOwner)
  let second = run Semantic.demandGlueMir(&mut store, &mut request, &secondType, &sourceOwner)
  let firstIndex = Shared.with<Result<Answer, NoRejection>, Option<usize>>(&first, selectedMirIndex)
  let secondIndex = Shared.with<Result<Answer, NoRejection>, Option<usize>>(&second, selectedMirIndex)
  let distinct = match &firstIndex {
    Option<usize>.Some {value: one} => match &secondIndex { Option<usize>.Some {value: two} => one != two _ => false }
    _ => false
  }
  let mut firstHooks = usize.ONE
  let mut secondHooks = usize.ONE
  if conditional && localFirst { firstHooks = usize.ZERO }
  if conditional && !localFirst { secondHooks = usize.ZERO }
  run Testing.expect(distinct && glueFact(&store, &first, usize.ONE) == firstHooks
    && glueFact(&store, &second, usize.ONE) == secondHooks,
    "both demand orders independently select their applicable hook, never the first erased glue query")
  let mut childDrops = usize.ZERO
  if children { childDrops = usize.ONE }
  run Testing.expect(glueFact(&store, &first, usize.ZERO) == childDrops
    && glueFact(&store, &second, usize.ZERO) == childDrops,
    "both exact glue recipes retain every droppable child instead of passing by omitting cleanup")
  if children {
    run Testing.expect(glueFact(&store, &first, 3) == usize.ZERO && glueFact(&store, &second, 3) == usize.ZERO
      && (firstHooks == usize.ZERO || glueFact(&store, &first, 7) == usize.ONE)
      && (secondHooks == usize.ZERO || glueFact(&store, &second, 7) == usize.ONE),
      "the selected hook precedes the one declaration-order Token child cleanup")
  }
  let firstCall = run directApplicationAt(&main, usize.ONE)
  let secondCall = run directApplicationAt(&main, 2)
  if let Option<SpecializationApplication>.Some {value: one} = move firstCall {
    if let Option<SpecializationApplication>.Some {value: two} = move secondCall {
      let oneMir = run Semantic.demandApplicationMir(&mut store, &mut request, &one)
      let twoMir = run Semantic.demandApplicationMir(&mut store, &mut request, &two)
      let oneKey = run requiredCanonicalKey(run InstanceKey.function(move one))
      let twoKey = run requiredCanonicalKey(run InstanceKey.function(move two))
      run Testing.expect(InstanceKey.sameRuntimeBase(&oneKey, &twoKey) && !(run InstanceKey.sameApplication(&oneKey, &twoKey)),
        "the entry reaches distinct exact lifetime applications in one erased function family")
      let firstGuard = run requiredCanonicalGlue(run InstanceKey.dropGlue(&firstType, &sourceOwner))
      let secondGuard = run requiredCanonicalGlue(run InstanceKey.dropGlue(&secondType, &sourceOwner))
      if let Option<InstanceKey>.Some {value: firstGlueKey} = &firstGuard {
        if let Option<InstanceKey>.Some {value: secondGlueKey} = &secondGuard {
          let firstNeedsDrop = children || !conditional || !localFirst
          let secondNeedsDrop = children || !conditional || localFirst
          let mut firstDrops = usize.ZERO
          let mut secondDrops = usize.ZERO
          if firstNeedsDrop { firstDrops = usize.ONE }
          if secondNeedsDrop { secondDrops = usize.ONE }
          let mut firstExactDrop = true
          let mut secondExactDrop = true
          if firstNeedsDrop { firstExactDrop = run genericMirHasExactDrop(&store, &oneMir, &firstGlueKey) }
          if secondNeedsDrop { secondExactDrop = run genericMirHasExactDrop(&store, &twoMir, &secondGlueKey) }
          run Testing.expect(glueFact(&store, &oneMir, usize.ZERO) == firstDrops && glueFact(&store, &twoMir, usize.ZERO) == secondDrops
            && firstExactDrop && secondExactDrop,
            "caller Drop instructions retain exactly their selected semantic glue key")
          let built = run buildApplication(&mut store, &mut request, staticClosureNodes)
          if let BackendBuild.Module {text: ir, plan, ..} = &built {
            let oneSymbol = run EmissionPlan.symbol(&plan, &oneKey)
            let twoSymbol = run EmissionPlan.symbol(&plan, &twoKey)
            let oneIdentity = run EmissionPlan.lookup(&plan, &oneKey)
            let twoIdentity = run EmissionPlan.lookup(&plan, &twoKey)
            let identities = Vector.asSlice<EmissionIdentity>(&plan.identities)
            let mapped = match move oneIdentity {
              Option<usize>.Some {value: left} => match move twoIdentity {
                Option<usize>.Some {value: right} => left != right && sameBytes(
                  Bytes.asSlice(&identities[left].encoding),
                  Bytes.asSlice(&identities[right].encoding),
                ) == false
                _ => false
              }
              _ => false
            }
            let llvm = Bytes.asSlice(&ir)
            run Testing.expect(
              mapped && !sameBytes(Bytes.asSlice(&oneSymbol), Bytes.asSlice(&twoSymbol)) && genericUniqueSymbolDefinition(
                llvm,
                Bytes.asSlice(&oneSymbol),
              ) && genericUniqueSymbolDefinition(llvm, Bytes.asSlice(&twoSymbol)),
              "exact lifetime instance identities retain separate unique definitions for both conditional and unconditional cleanup",
            )
            let mut firstGlueSymbol = Bytes.make()
            let mut secondGlueSymbol = Bytes.make()
            if firstNeedsDrop { firstGlueSymbol = run EmissionPlan.symbol(&plan, &firstGlueKey) }
            if secondNeedsDrop { secondGlueSymbol = run EmissionPlan.symbol(&plan, &secondGlueKey) }
            run Testing.expect((!firstNeedsDrop || genericDefinitionCalls(llvm, Bytes.asSlice(&oneSymbol), Bytes.asSlice(&firstGlueSymbol)))
              && (!secondNeedsDrop || genericDefinitionCalls(llvm, Bytes.asSlice(&twoSymbol), Bytes.asSlice(&secondGlueSymbol))),
              "each emitted caller names its resolved glue rather than reconstructing an erased family name")
            let mut firstGlueEdges = true
            let mut secondGlueEdges = true
            if firstNeedsDrop { firstGlueEdges = run genericGlueEdgesAreEmitted(&store, &first, &plan, llvm) }
            if secondNeedsDrop { secondGlueEdges = run genericGlueEdgesAreEmitted(&store, &second, &plan, llvm) }
            run Testing.expect(firstGlueEdges && secondGlueEdges,
              "every emitted glue definition calls its exact selected hook and complete Token child recipe through the same plan")
            if firstNeedsDrop && secondNeedsDrop {
              let left = run EmissionPlan.lookup(&plan, &firstGlueKey)
              let right = run EmissionPlan.lookup(&plan, &secondGlueKey)
              let glueMapped = match move left {
                Option<usize>.Some {value: a} => match move right {
                  Option<usize>.Some {value: b} => a != b && sameBytes(
                    Bytes.asSlice(&identities[a].encoding),
                    Bytes.asSlice(&identities[b].encoding),
                  ) == false
                  _ => false
                }
                _ => false
              }
              run Testing.expect(
                glueMapped && !sameBytes(
                  Bytes.asSlice(&firstGlueSymbol),
                  Bytes.asSlice(&secondGlueSymbol),
                ) && genericUniqueSymbolDefinition(llvm, Bytes.asSlice(&firstGlueSymbol)) && genericUniqueSymbolDefinition(
                  llvm,
                  Bytes.asSlice(&secondGlueSymbol),
                ),
                "exact glue identities retain both selected hooks and lifetime applications without body-derived sharing",
              )
            }
            return ()
          }
          run Testing.expect(false, "all complete conditional and equal lifetime recipes build natively instead of reporting instance-recipe")
          return ()
        }
      }
    }
  }
  run Testing.expect(false, "fixture retains both exact selected caller applications and glue keys")
  return ()
}

test effect fn genericLifetimeRecipeStaticFirstSplitsSelectedCleanup() -> ()
! CanonicalizationFailure | InvalidModulePath | Cycle | RevisionMismatch | BackendGap | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let firstId = run module("generic-recipe-static-first.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let first = """
struct Token {}
impl Drop for Token { fn drop(self: &mut Token) -> () { return () } }
struct Guard<'a> { token: Token }
impl<'a: 'static> Drop for Guard<'a> { fn drop(self: &mut Guard<'a>) -> () { return () } }
fn localGuard<'a>(value: &'a i32) -> Guard<'a> { return Guard<'a> { token: Token {} } }
fn consume<'a>(guard: Guard<'a>) -> () { drop guard return () }
pub fn main() -> i32 { let lasting = Guard<'static> { token: Token {} } let local: i32 = 0 let short = localGuard(&local) consume<'static>(move lasting) consume(move short) return 0 }
"""
  run genericLifetimeRecipeClaim(&firstId, first, false, true, true) |> Effect.provideMut<Allocator>(&mut allocator)
  return ()
}

