    "impl Clock for Doubled {}", usize.ONE) |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(witnesses, "competing conformance witnesses reject before selection")
  let covered = run providedSucceeds(&mut store, &mut request, &id, "covered") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let uncovered = run providedRejects(&mut store, &mut request, &id, "uncovered", RejectionCode.UnhandledRequirement, text,
    "run move pending", usize.ONE) |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
