  let forward = run providedSucceeds(&mut store, &mut request, &id, "forward") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let widened = run providedSucceeds(&mut store, &mut request, &id, "widened") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let leaks = run providedRejects(&mut store, &mut request, &id, "leaks", RejectionCode.UnhandledRequirement, text,
