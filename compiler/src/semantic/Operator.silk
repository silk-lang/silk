//! Closed eager operator eligibility and concrete operand contracts.
//!
//! # When to use
//! Each overloadable operator binds to one standard-library interface operation (`bindsModule`,
//! `bindsOperation`). A concrete primitive or scalar enum expression uses `prefix` or `infix` to
//! decide only its type contract. These functions do not execute an operation or adapt an operand.

import hir.Hir {InfixOperator, PrefixOperator}
import semantic.Type {Type}
import silk.bytes {Bytes}
import silk.option {Option}
import silk.usize

/// The concrete family relevant to operator eligibility.
pub enum Family {
  Boolean,
  SignedInteger,
  UnsignedInteger,
  Floating,
  Character,
  String,
  ScalarEnum,
  Other,
}

/// How an admitted concrete operator determines its result type.
pub enum ResultType {
  /// The left operand's exact type.
  Operand,
  /// The closed `bool` type.
  Boolean,
}

/// One authored eager operator, kept distinct by its prefix or infix category.
pub union Spelling {
  Prefix {pub operator: PrefixOperator},
  Infix {pub operator: InfixOperator},
}

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

/// Whether `path` is the standard-library module whose interface an operator binds to (OP-009).
/// `&&` and `||` bind to none.
pub fn bindsModule(requested: &Spelling, path: &[u8]) -> bool {
  return match &requested.* {
    Spelling.Prefix {..} => same(path, b"silk/ops.silk")
    Spelling.Infix {operator} => match operator {
    InfixOperator.Equals => same(path, b"silk/equal.silk")
    InfixOperator.NotEquals => same(path, b"silk/equal.silk")
    InfixOperator.LessThan => same(path, b"silk/order.silk")
    InfixOperator.LessOrEqual => same(path, b"silk/order.silk")
    InfixOperator.GreaterThan => same(path, b"silk/order.silk")
    InfixOperator.GreaterOrEqual => same(path, b"silk/order.silk")
    InfixOperator.And => false
    InfixOperator.Or => false
    _ => same(path, b"silk/ops.silk")
    }
  }
}

/// Whether `name` is the interface operation an operator binds to: `+` to `Add.add`, `==` and
/// `!=` to `Equal.equals`, and every ordering operator to `Order.compare`.
pub fn bindsOperation(requested: &Spelling, name: &[u8]) -> bool {
  return match &requested.* {
    Spelling.Prefix {operator} => match operator {
    PrefixOperator.Negate => same(name, b"negate")
    PrefixOperator.Not => same(name, b"not")
    PrefixOperator.BitwiseNot => same(name, b"bitNot")
    }
    Spelling.Infix {operator} => match operator {
    InfixOperator.Add => same(name, b"add")
    InfixOperator.Subtract => same(name, b"subtract")
    InfixOperator.Multiply => same(name, b"multiply")
    InfixOperator.Divide => same(name, b"divide")
    InfixOperator.Remainder => same(name, b"remainder")
    InfixOperator.Equals => same(name, b"equals")
    InfixOperator.NotEquals => same(name, b"equals")
    InfixOperator.LessThan => same(name, b"compare")
    InfixOperator.LessOrEqual => same(name, b"compare")
    InfixOperator.GreaterThan => same(name, b"compare")
    InfixOperator.GreaterOrEqual => same(name, b"compare")
    InfixOperator.BitAnd => same(name, b"bitAnd")
    InfixOperator.BitOr => same(name, b"bitOr")
    InfixOperator.BitXor => same(name, b"bitXor")
    InfixOperator.And => false
    InfixOperator.Or => false
    }
  }
}

/// Classifies one canonical type; `isScalarEnum` comes from its declaration header.
pub fn family(value: &Type, isScalarEnum: bool) -> Family {
  match &value.* {
    Type.Primitive {name} => {
      let spelling = Bytes.asSlice(&name)
      if same(spelling, b"bool") {
        return Family.Boolean
      }
      if same(spelling, b"char") {
        return Family.Character
      }
      if same(spelling, b"f32") || same(spelling, b"f64") {
        return Family.Floating
      }
      if same(spelling, b"i8") || same(spelling, b"i16") || same(spelling, b"i32") || same(
        spelling,
        b"i64",
      ) || same(spelling, b"isize") {
        return Family.SignedInteger
      }
      if same(spelling, b"u8") || same(spelling, b"u16") || same(spelling, b"u32") || same(
        spelling,
        b"u64",
      ) || same(spelling, b"usize") {
        return Family.UnsignedInteger
      }
      return Family.Other
    }
    Type.String {..} => { return Family.String }
    Type.Nominal {..} => {
      if isScalarEnum {
        return Family.ScalarEnum
      }
      return Family.Other
    }
    _ => { return Family.Other }
  }
}

fn integer(value: Family) -> bool {
  return value == Family.SignedInteger || value == Family.UnsignedInteger
}

fn numeric(value: Family) -> bool {
  return integer(value) || value == Family.Floating
}

/// Selects the closed concrete result of an eager prefix operator.
pub fn prefix(operator: PrefixOperator, operand: Family) -> Option<ResultType> {
  match operator {
    PrefixOperator.Negate => {
      if operand == Family.SignedInteger || operand == Family.Floating {
        return Option.some<ResultType>(ResultType.Operand)
      }
      return Option.none<ResultType>()
    }
    PrefixOperator.Not => {
      if operand == Family.Boolean {
        return Option.some<ResultType>(ResultType.Boolean)
      }
      return Option.none<ResultType>()
    }
    PrefixOperator.BitwiseNot => {
      if integer(operand) {
        return Option.some<ResultType>(ResultType.Operand)
      }
      return Option.none<ResultType>()
    }
  }
}

fn arithmetic(operator: InfixOperator) -> bool {
  return match operator {
    InfixOperator.Add => true
    InfixOperator.Subtract => true
    InfixOperator.Multiply => true
    InfixOperator.Divide => true
    InfixOperator.Remainder => true
    _ => false
  }
}

fn bitwise(operator: InfixOperator) -> bool {
  return match operator {
    InfixOperator.BitAnd => true
    InfixOperator.BitOr => true
    InfixOperator.BitXor => true
    _ => false
  }
}

fn ordering(operator: InfixOperator) -> bool {
  return match operator {
    InfixOperator.LessThan => true
    InfixOperator.LessOrEqual => true
    InfixOperator.GreaterThan => true
    InfixOperator.GreaterOrEqual => true
    _ => false
  }
}

fn equality(operator: InfixOperator) -> bool {
  return match operator {
    InfixOperator.Equals => true
    InfixOperator.NotEquals => true
    _ => false
  }
}

/// Selects the closed concrete result of an eager infix operator.
/// `sameType` is canonical type equality, independent of the expected result. String equality
/// accepts views with different validity lifetimes because it only compares their UTF-8 bytes.
pub fn infix(
  operator: InfixOperator,
  left: Family,
  right: Family,
  sameType: bool,
) -> Option<ResultType> {
  if arithmetic(operator) && sameType && numeric(left) && numeric(right) {
    return Option.some<ResultType>(ResultType.Operand)
  }
  if bitwise(operator) && sameType && integer(left) && integer(right) {
    return Option.some<ResultType>(ResultType.Operand)
  }
  if ordering(operator) && sameType && ((numeric(left) && numeric(right)) || (left == Family.Character && right == Family.Character)) {
    return Option.some<ResultType>(ResultType.Boolean)
  }
  if equality(operator) {
    if left == Family.String && right == Family.String {
      return Option.some<ResultType>(ResultType.Boolean)
    }
    if sameType && left == right && (numeric(left) || left == Family.Boolean || left == Family.Character || left == Family.ScalarEnum) {
      return Option.some<ResultType>(ResultType.Boolean)
    }
  }
  return Option.none<ResultType>()
}
