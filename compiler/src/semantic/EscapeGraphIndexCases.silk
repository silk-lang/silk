//! Parity and malformed-input checks for immutable record directories.
import semantic.BuildRecord
import semantic.ContentHash {ContentHash}
import semantic.DeclarationId {DeclarationId, OwnerStep}
import hir.Hir {OwnerKind}
import semantic.EscapeGraph
import semantic.EscapeGraphIndex
import semantic.ModuleId {InvalidModulePath, ModuleId}
import semantic.RuntimeEncoding as Encoding
import semantic.StableKey
import silk.collections.bytes {Bytes}
import silk.collections.list {List}
import silk.collections.slice {Slice}
import silk.core.effect {Effect}
import silk.core.option {Option}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.num.u64
import silk.num.usize
import silk.testing.testing {AssertionError, Testing}

fn key(value: usize) -> ContentHash { return ContentHash {high: 19, low: usize.toU64(value)} }

effect fn fixture() -> BuildRecord.Record ! InvalidModulePath | OutOfMemoryError ? &mut Allocator {
  let module = run ModuleId.make(b"memory", b"index-cases", b"bodies.silk")
  let mut owners = List<OwnerStep>.make()
  run List<OwnerStep>.append(&mut owners, OwnerStep {kind: OwnerKind.Function,
    name: Option<Bytes>.some(run Bytes.copy(b"body")), occurrence: 0})
  let declaration = run DeclarationId.fromParts(move module, move owners)
  let mut declared = Bytes.make()
  run StableKey.declaration(&mut declared, &declaration)
  let mut record = BuildRecord.make(false, false)
  run List<ContentHash>.append(&mut record.roots, key(0))
  let mut at = usize.ZERO
  while at < 40 {
    let mut facts = BuildRecord.unknownFacts()
    facts.flags = BuildRecord.FACT_KNOWN + BuildRecord.FACT_APPLICATION + BuildRecord.FACT_FUNCTION
      + BuildRecord.FACT_PLAIN_FUNCTION + BuildRecord.FACT_BOUNDARY_KEY + BuildRecord.FACT_CLOSED
      + BuildRecord.FACT_SUMMARIZED + BuildRecord.FACT_KEY_BYTES + BuildRecord.FACT_CALLEES
    facts.definition = key(at)
    facts.keyBytes = 100 + at
    facts.flags = facts.flags + BuildRecord.FACT_EXECUTABLES
    run List<BuildRecord.Callee>.append(&mut facts.executables,
      BuildRecord.Callee {exact: key((at + usize.ONE) % 40), definition: key((at + usize.ONE) % 40)})
    run List<usize>.append(&mut facts.callees, 0)
    if at == usize.ZERO {
      facts.flags = facts.flags + BuildRecord.FACT_ACCESSES
      run List<ContentHash>.append(&mut facts.callbacks, key(17))
    }
    let mut references = List<BuildRecord.Reference>.make()
    run List<BuildRecord.Reference>.append(&mut references, BuildRecord.Reference {target: (at + usize.ONE) % 40, edge: key(77)})
    let mut bytes = run Bytes.copy(Bytes.asSlice(&declared))
    // Shape bytes follow the stable body identity and participate in front compression.
    run Encoding.word(&mut bytes, usize.toU64(at))
    run List<BuildRecord.Entry>.append(&mut record.entries, BuildRecord.Entry {exact: key(at), hash: usize.toU64(at), family: 0,
      declaration: move bytes, parent: if at == usize.ZERO { usize.MAX } else { at - usize.ONE }, position: 0,
      requested: false, alias: usize.MAX, leaf: 0, references: move references, summary: key(at), facts: move facts})
    at = at + usize.ONE
  }
  return move record
}

effect fn directoryClaims() -> () ! InvalidModulePath | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let record = run fixture()
  let blob = match move run EscapeGraph.encodeGraph(&record) {
    Option<Bytes>.Some {value} => move value
    Option<Bytes>.None => { run Testing.expect(false, "the shared fixture proves complete") return () }
  }
  let bytes = Bytes.asSlice(&blob)
  let mut index = match move run EscapeGraphIndex.read(bytes, ContentHash.of(bytes)) {
    Option<EscapeGraphIndex.Index>.Some {value} => move value
    Option<EscapeGraphIndex.Index>.None => { run Testing.expect(false, "the indexed reader accepts a complete authenticated graph") return () }
  }
  let entries = List<EscapeGraphIndex.Entry>.asSlice(&index.entries)
  run Testing.expect(entries.length == 40 && List<usize>.length(&index.references) == 40
    && List<usize>.length(&index.callees) == 40 && List<ContentHash>.length(&index.callbacks) == 1,
    "flat tables preserve exactly the original adjacency and callback facts")
  let mut at = usize.ZERO
  while at < entries.length {
    run Testing.expect(ContentHash.equals(entries[at].exact, key(at)) && entries[at].keyBytes == 100 + at
      && List<usize>.get(&index.references, entries[at].references.start) == (at + usize.ONE) % 40
      && EscapeGraphIndex.graphEntry(&index, key(at)) == at,
      "directory rows retain scalar costs and exact ordered targets")
    run Testing.expect(match &entries[at].body { Option<DeclarationId>.None => true _ => false },
      "green directory validation does not eagerly allocate declaration identities")
    at = at + usize.ONE
  }
  run Testing.expect(EscapeGraphIndex.declarationStart(&index, 31) == 16,
    "first random access starts at the nearest encoded restart")
  run Testing.expect(run EscapeGraphIndex.ensureDeclaration(&mut index, bytes, 31), "first random declaration reconstructs")
  run Testing.expect(EscapeGraphIndex.declarationStart(&index, 1) == 0,
    "backward access cannot use a later rolling memo")
  run Testing.expect(run EscapeGraphIndex.ensureDeclaration(&mut index, bytes, 1), "backward random declaration reconstructs")
  run Testing.expect(EscapeGraphIndex.declarationStart(&index, 39) == 32,
    "forward access skips the large gap when a nearer restart supersedes the memo")
  run Testing.expect(run EscapeGraphIndex.ensureDeclaration(&mut index, bytes, 39), "forward random declaration reconstructs")
  run Testing.expect(EscapeGraphIndex.declarationStart(&index, 40) == usize.MAX,
    "work lookup refuses rows outside the authenticated directory")
  let originalBytes = Bytes.asSlice(&List<BuildRecord.Entry>.asSlice(&record.entries)[0].declaration)
  let mut reader = StableKey.reader()
  let original = match move run StableKey.readDeclaration(originalBytes, &mut reader) {
    Option<DeclarationId>.Some {value} => move value
    Option<DeclarationId>.None => { run Testing.expect(false, "fixture body identity is well formed") return () }
  }
  let decoded = List<EscapeGraphIndex.Entry>.asSlice(&index.entries)
  let chosen: [usize; 3] = [1, 31, 39]
  at = usize.ZERO
  while at < 3 {
    let row = chosen[at]
    at = at + usize.ONE
    run Testing.expect(match &decoded[row].body { Option<DeclarationId>.Some {value} => DeclarationId.equals(&value, &original) _ => false },
      "shape suffixes never change a definition's original body identity")
  }
  run Testing.expect(match &decoded[20].body { Option<DeclarationId>.None => true _ => false },
    "reconstructing a compressed prefix does not eagerly decode intervening declarations")
  let inline = run BuildRecord.encode(&record)
  let mut ordinary = match move run EscapeGraphIndex.readInline(Bytes.asSlice(&inline)) {
    Option<EscapeGraphIndex.Index>.Some {value} => move value
    Option<EscapeGraphIndex.Index>.None => { run Testing.expect(false, "ordinary inline directories retain the established record format") return () }
  }
  let mut withoutRestarts = match move run EscapeGraphIndex.read(Bytes.asSlice(&inline), ContentHash.of(Bytes.asSlice(&inline))) {
    Option<EscapeGraphIndex.Index>.Some {value} => move value
    Option<EscapeGraphIndex.Index>.None => { run Testing.expect(false, "prefix restarts are a writer cost policy, not an extra semantic proof condition") return () }
  }
  run Testing.expect(run EscapeGraphIndex.ensureDeclaration(&mut withoutRestarts, Bytes.asSlice(&inline), 39),
    "all valid front-compressed records reconstruct safely without a special format fallback")
  at = usize.ZERO
  while at < 40 {
    run Testing.expect(EscapeGraphIndex.declarationStart(&ordinary, at) == at,
      "ordinary inline sequential access reconstructs only its next suffix without assuming sixteen-row restarts")
    run Testing.expect(run EscapeGraphIndex.ensureDeclaration(&mut ordinary, Bytes.asSlice(&inline), at),
      "a sequential inline budget pass reconstructs ordinary front compression once")
    at = at + usize.ONE
  }
  run Testing.expect(!run EscapeGraphIndex.escapeFree(&index, &[0]),
    "a selected view cannot borrow missing references or callback bodies from the global graph")
  let mut selected = List<usize>.make()
  at = usize.ZERO
  while at < 40 { run List<usize>.append(&mut selected, at) at = at + usize.ONE }
  run Testing.expect(run EscapeGraphIndex.escapeFree(&index, List<usize>.asSlice(&selected)),
    "the complete selected cycle preserves callback escape proof")
}

effect fn malformedClaims() -> () ! InvalidModulePath | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut record = run fixture()
  let written = run BuildRecord.normalizedGraphEncoding(&record)
  let bytes = Bytes.asSlice(&written)
  let mut end = usize.ZERO
  while end < bytes.length {
    let prefix = Slice.view<u8>(bytes, 0, end)
    run Testing.expect(match move run EscapeGraphIndex.readInline(prefix) {
      Option<EscapeGraphIndex.Index>.None => true _ => false }, "every truncated directory is refused without reading past its bytes")
    end = end + usize.ONE
  }
  run Testing.expect(match move run EscapeGraphIndex.read(bytes, key(100)) {
    Option<EscapeGraphIndex.Index>.None => true _ => false }, "a directory authenticates the exact content address")
  let changed = List<BuildRecord.Entry>.asMutSlice(&mut record.entries)
  changed[20].facts.flags = u64.bitOr(changed[20].facts.flags, BuildRecord.FACT_ESCAPES)
  let escaping = run BuildRecord.normalizedGraphEncoding(&record)
  run Testing.expect(match move run EscapeGraphIndex.read(Bytes.asSlice(&escaping), ContentHash.of(Bytes.asSlice(&escaping))) {
    Option<EscapeGraphIndex.Index>.None => true _ => false }, "an authenticated graph still must prove callback escape freedom")
  let bounded = List<BuildRecord.Entry>.asMutSlice(&mut record.entries)
  bounded[20].leaf = BuildRecord.LEFT
  let ordinary = run BuildRecord.encode(&record)
  run Testing.expect(match move run EscapeGraphIndex.readInline(Bytes.asSlice(&ordinary)) {
    Option<EscapeGraphIndex.Index>.Some {..} => true _ => false }, "ordinary bounded inline records are not confused with complete graph blobs")
  run Testing.expect(match move run EscapeGraphIndex.read(Bytes.asSlice(&ordinary), ContentHash.of(Bytes.asSlice(&ordinary))) {
    Option<EscapeGraphIndex.Index>.None => true _ => false }, "bounded leaves never authorize complete shared graphs")
  let bad = List<BuildRecord.Entry>.asMutSlice(&mut record.entries)
  List<usize>.set(&mut bad[0].facts.callees, 0, 1)
  let invalidCallee = run BuildRecord.encode(&record)
  run Testing.expect(match move run EscapeGraphIndex.readInline(Bytes.asSlice(&invalidCallee)) {
    Option<EscapeGraphIndex.Index>.None => true _ => false }, "direct callee positions are checked against the entry's reference count")
  let restored = List<BuildRecord.Entry>.asMutSlice(&mut record.entries)
  List<usize>.set(&mut restored[0].facts.callees, 0, 0)
  restored[20].alias = usize.ZERO
  restored[20].facts.flags = 0
  record.guarded = true
  record.patterns = true
  let ordinaryShape = run BuildRecord.encode(&record)
  let allowed = match move run EscapeGraphIndex.readInline(Bytes.asSlice(&ordinaryShape)) {
    Option<EscapeGraphIndex.Index>.Some {value} => move value
    Option<EscapeGraphIndex.Index>.None => { run Testing.expect(false, "inline directory preserves all structurally valid ordinary record modes") return () }
  }
  run Testing.expect(allowed.guarded && allowed.patterns
    && List<EscapeGraphIndex.Entry>.asSlice(&allowed.entries)[20].alias == usize.ZERO
    && List<EscapeGraphIndex.Entry>.asSlice(&allowed.entries)[20].flags == 0,
    "inline indexing preserves aliases, bounded leaves and unknown facts for the original consumer's proof gates")
  run Testing.expect(match move run EscapeGraphIndex.read(Bytes.asSlice(&ordinaryShape), ContentHash.of(Bytes.asSlice(&ordinaryShape))) {
    Option<EscapeGraphIndex.Index>.None => true _ => false }, "guarded or patterned captures cannot become complete shared graphs")
  let overflow: [u8; 10] = [255, 255, 255, 255, 255, 255, 255, 255, 255, 2]
  let mut cursor = BuildRecord.Cursor {at: 0, failed: false}
  drop BuildRecord.readVarint(&overflow, &mut cursor)
  run Testing.expect(cursor.failed, "varints cannot overflow their final 64-bit payload bit")
}

test effect fn indexedEscapeGraphsDecodeOnlySelectedBodyIdentities() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run directoryClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn indexedEscapeGraphsRejectMalformedAndIncompleteProofs() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run malformedClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}
