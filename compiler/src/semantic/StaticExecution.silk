/// Deterministic work limits for one demand graph.
pub struct Limits {
  pub steps: usize,
  pub depth: usize,
  pub valueBytes: usize,
}

/// The compiler's limits for one demand graph. The thresholds are compiler policy (STATIC-013).
/// The step limit matches the bootstrap's; the call depth and retained bytes are below its 128
/// frames and 4 MiB.
pub fn defaultLimits() -> Limits { return Limits {steps: 100000, depth: 64, valueBytes: 1048576} }

/// A source-defined failure; related calls are ordered from the root to the failing frame.
pub enum Fault {
  InvalidHeader,
  Unavailable,
  StaticPhaseViolation,
  Unsupported,
  InvalidValue,
  InvalidControl,
  Overflow,
  DivisionByZero,
  CompileError,
  Cycle,
  StepLimit,
  DepthLimit,
  ValueLimit,
}

/// A fact required to execute a selected call that source HIR alone cannot supply.
pub enum MissingFact {
  TypedApplication,
  CheckedBody,
  CheckedExpression,
  CheckedSource,
  DeclaredType,
  IntrinsicOperation,
  /// No final build profile was supplied to this static evaluation.
  ProfileInput,
}

pub struct TraceStep {
  pub name: Bytes,
  pub arguments: List<Interned<StaticData>>,
  pub span: Span,
  /// The module whose body the step executes; none for a step that is not a call frame.
  pub module: Option<ModuleId>,
}

pub struct Diagnostic {
  pub fault: Fault,
  pub code: &'static [u8],
  pub span: Span,
  pub target: MachineTarget,
  pub message: Option<Bytes>,
  pub origin: Option<Span>,
  pub byteOffset: Option<u64>,
  pub rejection: Option<Shared<Rejection>>,
  pub needed: Option<Needed>,
  pub missing: Option<MissingFact>,
  pub trace: List<TraceStep>,
}

/// A reached checked constant whose value must be demanded by its selected declaration.
pub struct Needed {
  pub module: ModuleId,
  pub expression: HirId,
  pub declaration: Interned<DeclarationId>,
}

// The catalog code that reports `fault`; none for a refusal.
fn faultCatalogCode(fault: Fault) -> Option<Code> {
  return match fault {
    Fault.InvalidHeader => Option<Code>.some(Code.StaticPhaseViolation)
    Fault.Unavailable => Option<Code>.none()
    Fault.StaticPhaseViolation => Option<Code>.some(Code.StaticPhaseViolation)
    Fault.Unsupported => Option<Code>.none()
    Fault.InvalidValue => Option<Code>.some(Code.StaticPhaseViolation)
    Fault.InvalidControl => Option<Code>.some(Code.StaticPhaseViolation)
    Fault.Overflow => Option<Code>.some(Code.StaticPhaseViolation)
    Fault.DivisionByZero => Option<Code>.some(Code.StaticPhaseViolation)
    Fault.CompileError => Option<Code>.some(Code.SelectedCompileError)
    Fault.Cycle => Option<Code>.some(Code.StaticEvaluationCycle)
    Fault.StepLimit => Option<Code>.some(Code.StaticStepLimit)
    Fault.DepthLimit => Option<Code>.some(Code.StaticCallDepthLimit)
    Fault.ValueLimit => Option<Code>.some(Code.StaticRetainedValueLimit)
  }
}

fn faultCode(fault: Fault) -> &'static [u8] {
  return match move faultCatalogCode(fault) {
    Option<Code>.Some {value} => String.utf8Bytes(Catalog.spelling(value))
    Option<Code>.None => b""
  }
}

/// The stable source diagnostic code for a failed static demand.
pub fn code(diagnostic: &Diagnostic) -> &[u8] {
  return diagnostic.code
}

/// One immutable static value made available at an authored binder.
pub struct Binding {
  pub module: ModuleId,
  pub binder: HirId,
  pub value: Interned<StaticData>,
}

/// A checked expression tree with declaration-relative origins and literal nodes.
pub struct CheckedRoot {
  body: Shared<TypedBody>,
}

/// Extracts the checked tree of one successful semantic answer.
pub fn checkedRoot(answer: &Result<Answer, NoRejection>) -> Option<CheckedRoot> {
  return match &answer.* {
    Result<Answer, NoRejection>.Success {value} => match &value.outcome {
      Outcome.Success {value: Value.Body {body}} => Option<CheckedRoot>.some(CheckedRoot {
        body: Shared<TypedBody>.clone(&body),
      })
      _ => Option<CheckedRoot>.none()
    }
    Result<Answer, NoRejection>.Failure {..} => Option<CheckedRoot>.none()
  }
}

struct RetainedBinding {
  module: ModuleId,
  binder: HirId,
  value: Interned<StaticData>,
  chargedBytes: usize,
}

struct Local {
  binder: HirId,
  mutable: bool,
  value: Interned<StaticData>,
}

struct Frame {
  application: usize,
  // The closed application this frame executes; its bindings close the calls it reaches.
  instance: Application,
  // `instance`'s bindings, listed once when the frame is pushed.
  bindings: List<TypeBinding>,
  module: ModuleId,
  name: Bytes,
  arguments: List<Interned<StaticData>>,
  body: Shared<TypedBody>,
  // The slot in the machine's indexed bodies that holds `body`'s node index.
  nodes: usize,
  window: Range,
  span: Span,
}

// Each checked node's position grouped by the relative syntax node it records, so a lookup reads
// the few nodes one syntax node records instead of scanning the whole body. Positions ascend
// within one syntax node, so the first one inside a window is the one a scan would find first.
struct NodeIndex {
  starts: List<usize>,
  positions: List<usize>,
}

// One frame body's node index, kept for the machine's life; holding the body keeps its address.
struct IndexedBody {
  body: Shared<TypedBody>,
  address: usize,
  nodes: NodeIndex,
}

struct Complete {
  application: usize,
  arguments: List<Interned<StaticData>>,
  value: Interned<StaticData>,
}

struct TextOrigin {
  address: usize,
  value: Interned<StaticData>,
  span: Span,
  // The module whose source `span` points into.
  module: ModuleId,
  // For a reflected field's label, the field whose declared name the label is; `span` is then
  // the reflecting call.
  field: Option<FieldOrigin>,
}

// The struct and label of a named field, which locate its declaration when a report needs it.
struct FieldOrigin {
  owner: Interned<SemanticType>,
  label: Bytes,
}

/// A site in authored source that a static report names.
pub struct LocatedSite {
  pub module: ModuleId,
  pub span: Span,
}

struct Chosen {
  function: SelectedStaticFunction,
  cursor: AuthoredCursor,
  signature: Shared<Result<Answer, NoRejection>>,
}

struct FrameReservation<'a, 'source> {
  machine: &'a mut Machine<'source>,
  previous: Option<AuthoredCursor>,
}

struct SourceReservation<'a, 'source> {
  machine: &'a mut Machine<'source>,
  previous: Option<AuthoredCursor>,
  previousBody: Option<Shared<TypedBody>>,
  previousNodes: NodeIndex,
  suppliedBase: usize,
}

union Flow {
  Next,
  Break,
  Continue,
  Return {value: Interned<StaticData>},
}

/// One held source and target for static applications. No body executes during construction.
pub struct Machine<'source> {
  port: StaticPort<'source>,
  root: ModuleId,
  current: Option<AuthoredCursor>,
  rootBody: Option<Shared<TypedBody>>,
  // `rootBody`'s node index.
  rootNodes: NodeIndex,
  // Node indexes of the bodies frames have executed.
  indexed: List<IndexedBody>,
  window: Range,
  target: MachineTarget,
  limits: Limits,
  steps: usize,
  retainedBytes: usize,
  applications: Pool,
  active: List<Frame>,
  supplied: List<RetainedBinding>,
  complete: List<Complete>,
  textOrigins: List<TextOrigin>,
  // Addresses of the values completed calls and text origins keep alive until release, in
  // ascending order. Each is charged once, however many calls share it.
  held: List<usize>,
  // The closed application whose body roots are evaluated outside any active frame.
  instance: Option<Application>,
  // `instance`'s bindings, listed once when it is set.
  instanceBindings: List<TypeBinding>,
}

/// Borrows one held semantic store without demanding any static body.
pub effect fn make<'source>(port: StaticPort<'source>, root: &ModuleId, limits: Limits) -> Machine<
  'source,
> ! OutOfMemoryError ? &mut Allocator {
  let target = StaticPort.target(&port)
  return Machine {
    port: move port,
    root: ModuleId.copy(root),
    current: Option<AuthoredCursor>.none(),
    rootBody: Option<Shared<TypedBody>>.none(),
    rootNodes: emptyNodes(),
    indexed: List<IndexedBody>.make(),
    window: Range {start: usize.ZERO, length: usize.MAX},
    target: target,
    limits: move limits,
    steps: usize.ZERO,
    retainedBytes: usize.ZERO,
    applications: Pool.make(),
    active: List<Frame>.make(),
    supplied: List<RetainedBinding>.make(),
    complete: List<Complete>.make(),
    textOrigins: List<TextOrigin>.make(),
    held: List<usize>.make(),
    instance: Option<Application>.none(),
    instanceBindings: List<TypeBinding>.make(),
  }
}

/// Evaluates later roots inside one closed application: calls written in its generic body reach
/// the callees its bindings select.
pub effect fn useInstance<'source>(machine: &mut Machine<'source>, application: &Application) -> ()
! OutOfMemoryError ? &mut Allocator | &mut Types {
  machine.instance = Option<Application>.some(run Application.copy(application))
  machine.instanceBindings = run Application.bindings(application)
  return ()
}

// Closes a reached call written in the executing body's binders with that body's application.
effect fn closeCall<'source>(machine: &Machine<'source>, call: Application) -> Application
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let frames = List<Frame>.asSlice(&machine.active)
  if frames.length > usize.ZERO {
    return run Application.substitute(&call, &frames[frames.length - usize.ONE].instance)
  }
  if let Option<Application>.Some {value: root} = &machine.instance {
    return run Application.substitute(&call, &root)
  }
  return move call
}

/// Borrows the active semantic port briefly between evaluation attempts.
pub fn port<'borrow, 'source>(machine: &'borrow mut Machine<'source>) -> &'borrow mut StaticPort<'source> {
  return &mut machine.port
}

fn staticDataAddress(value: &StaticData) -> usize {
  return Pointer.address<StaticData>(Pointer.fromRef<StaticData>(value))
}

fn sharedDataAddress(value: &Interned<StaticData>) -> usize {
  return Interned<StaticData>.with<usize>(value, staticDataAddress)
}

/// Retains a text value's original authored span independently of its value identity.
pub effect fn rememberTextOrigin<'source>(machine: &mut Machine<'source>, value: &Interned<StaticData>, span: Span) -> ()
! Diagnostic | OutOfMemoryError
? &mut Allocator {
  let module = run currentModule(&machine.*)
  run recordTextOrigin(&mut machine.*, value, span, move module, Option<FieldOrigin>.none())
}

effect fn recordTextOrigin<'source>(machine: &mut Machine<'source>, value: &Interned<StaticData>, span: Span,
  module: ModuleId, field: Option<FieldOrigin>) -> ()
! Diagnostic | OutOfMemoryError
? &mut Allocator {
  let address = sharedDataAddress(value)
  let origins = List<TextOrigin>.asSlice(&machine.textOrigins)
  let mut at = usize.ZERO
  while at < origins.length {
    if origins[at].address == address { return () }
    at = at + usize.ONE
  }
  let bytes = run unheldBytes(&mut machine.*, value, true)
  if machine.retainedBytes > machine.limits.valueBytes || bytes > machine.limits.valueBytes - machine.retainedBytes {
    return run reject(&machine.*, Fault.ValueLimit, span)
  }
  run List<TextOrigin>.append(&mut machine.textOrigins, TextOrigin {
    address: address,
    value: Interned<StaticData>.clone(value),
    span: span,
    module: move module,
    field: move field,
  })
  machine.retainedBytes = machine.retainedBytes + bytes
  return ()
}

/// Finds the original authored span of a text value retained by this machine.
pub fn textOrigin<'source>(machine: &Machine<'source>, value: &Interned<StaticData>) -> Option<Span> {
  let address = sharedDataAddress(value)
  let origins = List<TextOrigin>.asSlice(&machine.textOrigins)
  let mut at = usize.ZERO
  while at < origins.length {
    if origins[at].address == address {
      if let Option<FieldOrigin>.Some {..} = &origins[at].field { return Option<Span>.none() }
      return Option<Span>.some(origins[at].span)
    }
    at = at + usize.ONE
  }
  return Option<Span>.none()
}

// The index of the origin a text value keeps, if it keeps one.
fn textOriginIndex<'source>(machine: &Machine<'source>, value: &Interned<StaticData>) -> usize {
  let address = sharedDataAddress(value)
  let origins = List<TextOrigin>.asSlice(&machine.textOrigins)
  let mut at = usize.ZERO
  while at < origins.length {
    if origins[at].address == address { return at }
    at = at + usize.ONE
  }
  return usize.MAX
}

// The bytes of the values in `value` that the machine does not already hold. Completed calls and
// text provenance own their values until the machine is released; with `record`, `value` joins
// them. An alias shares that charge rather than charging its bytes again, as one template passed
// to each `StaticText.byteAt` of a scan.
effect fn unheldBytes<'source>(machine: &mut Machine<'source>, value: &Interned<StaticData>, record: bool) -> usize
! OutOfMemoryError ? &mut Allocator {
  let address = sharedDataAddress(value)
  let held = List<usize>.asSlice(&machine.held)
  let mut low = usize.ZERO
  let mut high = held.length
  while low < high {
    let middle = low + (high - low) / 2
    if held[middle] < address { low = middle + usize.ONE } else { high = middle }
  }
  if low < held.length && held[low] == address { return usize.ZERO }
  if record { run List<usize>.insert(&mut machine.held, low, address) }
  let mut total = Interned<StaticData>.with<usize>(value, StaticValue.ownSize)
  let count = Interned<StaticData>.with<usize>(value, StaticValue.childCount)
  let mut at = usize.ZERO
  while at < count {
    let child = Interned<StaticData>.with<Interned<StaticData>>(value, fn(data: &StaticData) -> Interned<StaticData> {
      return StaticValue.childAt(data, at)
    })
    let below = run unheldBytes(&mut machine.*, &child, record)
    total = match move usize.checkedAdd(total, below) {
      Option<usize>.Some {value: sum} => sum
      Option<usize>.None => usize.MAX
    }
    at = at + usize.ONE
  }
  return total
}

fn copyCurrent<'source>(machine: &Machine<'source>) -> Option<AuthoredCursor> {
  return match &machine.current {
    Option<AuthoredCursor>.Some {value} => Option<AuthoredCursor>.some(AuthoredCursor.copy(&value))
    Option<AuthoredCursor>.None => Option<AuthoredCursor>.none()
  }
}

fn copyPrevious(previous: &Option<AuthoredCursor>) -> Option<AuthoredCursor> {
  return match &previous.* {
    Option<AuthoredCursor>.Some {value} => Option<AuthoredCursor>.some(AuthoredCursor.copy(&value))
    Option<AuthoredCursor>.None => Option<AuthoredCursor>.none()
  }
}

/// Reports consumed work so a caller can preserve the budget across dependency retries.
pub fn steps<'source>(machine: &Machine<'source>) -> usize {
  return machine.steps
}

/// The step budget this machine was made with.
pub fn stepLimit<'source>(machine: &Machine<'source>) -> usize {
  return machine.limits.steps
}

/// Authenticates one module in the held source index for short HIR reads.
pub effect fn sourceCursor<'source>(machine: &mut Machine<'source>, module: &ModuleId) -> AuthoredCursor
! Diagnostic | OutOfMemoryError
? &mut Allocator {
  return run cursorFor(&mut machine.*, module, Span.make(usize.ZERO, usize.ZERO))
}

/// Returns the first parser or HIR diagnostic of the authenticated source that lies inside
/// `extent`. Diagnostics of other declarations are never read, so a declaration's answer does not
/// depend on syntax elsewhere in its module.
pub fn sourceDiagnosticWithin<'source>(machine: &Machine<'source>, cursor: &AuthoredCursor, extent: Span) -> Option<HirDiagnostic> {
  if let Option<&IndexedSource>.Some {value} = move StaticPort.sourceAtCursor(&machine.port, cursor) {
    let unit = IndexedSource.sourceUnit(value)
    let mut at = usize.ZERO
    while at < SourceUnit.diagnosticCount(unit) {
      let diagnostic = SourceUnit.diagnostic(unit, at)
      if diagnostic.span.start >= extent.start && diagnostic.span.end <= extent.end {
        return Option<HirDiagnostic>.some(diagnostic)
      }
      at = at + usize.ONE
    }
  }
  return Option<HirDiagnostic>.none()
}

/// Reports the root HIR node count for bounded traversal.
pub fn authoredLength<'source>(machine: &Machine<'source>, cursor: &AuthoredCursor) -> Option<usize> {
  if let Option<&IndexedSource>.Some {value} = move StaticPort.sourceAtCursor(&machine.port, cursor) {
    let hir = IndexedSource.authored(value)
    return Option<usize>.some(Module.length(hir))
  }
  return Option<usize>.none()
}

/// Reports how many canonical declarations belong to the authenticated source.
pub fn sourceDeclarationCount<'source>(machine: &Machine<'source>, cursor: &AuthoredCursor) -> Option<usize> {
  if let Option<&IndexedSource>.Some {value} = move StaticPort.sourceAtCursor(&machine.port, cursor) {
    let index = IndexedSource.moduleIndex(value)
    let declarations = ModuleIndex.listDeclarations(index)
    return Option<usize>.some(declarations.length)
  }
  return Option<usize>.none()
}

/// Copies one canonical declaration so selection can continue after the source loan ends.
pub effect fn sourceDeclaration<'source>(machine: &Machine<'source>, cursor: &AuthoredCursor, at: usize) -> Option<IndexedDeclaration>
! OutOfMemoryError
? &mut Allocator {
  if let Option<&IndexedSource>.Some {value} = move StaticPort.sourceAtCursor(&machine.port, cursor) {
    let index = IndexedSource.moduleIndex(value)
    let declarations = ModuleIndex.listDeclarations(index)
    if at < declarations.length {
      return Option<IndexedDeclaration>.some(run IndexedDeclaration.copy(&declarations[at]))
    }
  }
  return Option<IndexedDeclaration>.none()
}

/// Reports how many syntax-derived name candidates belong to the authenticated source.
pub fn sourceCandidateCount<'source>(machine: &Machine<'source>, cursor: &AuthoredCursor) -> Option<usize> {
  if let Option<&IndexedSource>.Some {value} = move StaticPort.sourceAtCursor(&machine.port, cursor) {
    let index = IndexedSource.moduleIndex(value)
    let candidates = ModuleIndex.listCandidates(index)
    return Option<usize>.some(candidates.length)
  }
  return Option<usize>.none()
}

/// Copies one source name candidate so selection can continue after the source loan ends.
pub effect fn sourceCandidate<'source>(machine: &Machine<'source>, cursor: &AuthoredCursor, at: usize) -> Option<Candidate>
! OutOfMemoryError
? &mut Allocator {
  if let Option<&IndexedSource>.Some {value} = move StaticPort.sourceAtCursor(&machine.port, cursor) {
    let index = IndexedSource.moduleIndex(value)
    let candidates = ModuleIndex.listCandidates(index)
    if at < candidates.length {
      let selected = &candidates[at]
      return Option<Candidate>.some(Candidate {
        name: run Bytes.copy(Bytes.asSlice(&selected.name)),
        declaration: selected.declaration,
        kind: selected.kind,
        ordinal: selected.ordinal,
        local: selected.local,
        isPublic: selected.isPublic,
      })
    }
  }
  return Option<Candidate>.none()
}

/// Returns a Copy HIR node without retaining a source loan across evaluation.
pub fn authoredNode<'source>(machine: &Machine<'source>, cursor: &AuthoredCursor, id: HirId) -> Option<Node> {
  if let Option<&IndexedSource>.Some {value} = move StaticPort.sourceAtCursor(&machine.port, cursor) {
    let hir = IndexedSource.authored(value)
    if id.index < Module.length(hir) {
      return Option<Node>.some(Module.node(hir, id))
    }
  }
  return Option<Node>.none()
}

/// Returns the callable contract at position `contract` of the cursor's module, which a
/// [`Node.CallableContract`] names.
pub fn authoredContract<'source>(machine: &Machine<'source>, cursor: &AuthoredCursor, contract: usize) -> Option<CallableContract> {
  if let Option<&IndexedSource>.Some {value} = move StaticPort.sourceAtCursor(&machine.port, cursor) {
    let hir = IndexedSource.authored(value)
    if contract < List<CallableContract>.length(&hir.contracts) {
      return Option<CallableContract>.some(Module.contract(hir, contract))
    }
  }
  return Option<CallableContract>.none()
}

/// Returns a child HIR identity without retaining a source loan across evaluation.
pub fn authoredChild<'source>(machine: &Machine<'source>, cursor: &AuthoredCursor, range: Range, at: usize) -> Option<HirId> {
  if at < range.length {
    if let Option<&IndexedSource>.Some {value} = move StaticPort.sourceAtCursor(&machine.port, cursor) {
      let hir = IndexedSource.authored(value)
      return Option<HirId>.some(Module.child(hir, range, at))
    }
  }
  return Option<HirId>.none()
}

/// Returns an authored span without retaining a source loan across evaluation.
pub fn authoredSpan<'source>(machine: &Machine<'source>, cursor: &AuthoredCursor, id: HirId) -> Option<Span> {
  if let Option<&IndexedSource>.Some {value} = move StaticPort.sourceAtCursor(&machine.port, cursor) {
    let hir = IndexedSource.authored(value)
    if id.index < Module.length(hir) {
      return Option<Span>.some(Module.span(hir, id))
    }
  }
  return Option<Span>.none()
}

/// Copies authored text so the caller can mutate the machine after this read.
pub effect fn authoredText<'source>(machine: &Machine<'source>, cursor: &AuthoredCursor, symbol: Symbol) -> Option<Bytes>
! OutOfMemoryError
? &mut Allocator {
  if let Option<&IndexedSource>.Some {value} = move StaticPort.sourceAtCursor(&machine.port, cursor) {
    let hir = IndexedSource.authored(value)
    let text = Module.text(hir, symbol)
    return Option<Bytes>.some(run Bytes.copy(text))
  }
  return Option<Bytes>.none()
}


fn borrowedAuthored<'m, 'source>(machine: &'m Machine<'source>) -> Option<&'m Module> {
  if let Option<AuthoredCursor>.Some {value: cursor} = &machine.current {
    return StaticPort<'source>.authoredAtCursor(&machine.port, &cursor)
  }
  return Option<&Module>.none()
}

effect fn authored<'m, 'source>(machine: &'m Machine<'source>) -> &'m Module
! Diagnostic | OutOfMemoryError
? &mut Allocator {
  let borrowed = borrowedAuthored(machine)
  if let Option<&Module>.Some {value} = move borrowed {
    return value
  }
  return run reject(machine, Fault.Unavailable, Span.make(usize.ZERO, usize.ZERO))
}

// A test-discovery answer from the port; its rejection, such as a missing discovery root or an
// invalid test declaration, is this static operation's diagnostic.
effect fn discoveryAnswer<'source>(machine: &Machine<'source>,
  answered: Result<Result<StaticData, Shared<Rejection>>, Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError>, span: Span)
-> StaticData ! Diagnostic | OutOfMemoryError ? &mut Allocator {
  let result = match move answered {
    Result<Result<StaticData, Shared<Rejection>>, Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError>.Success {value} => move value
    Result<Result<StaticData, Shared<Rejection>>, Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError>.Failure {error} => match move error {
      OutOfMemoryError {} => {fail OutOfMemoryError {}}
      _ => run reject(machine, Fault.Unavailable, span)
    }
  }
  return match move result {
    Result<StaticData, Shared<Rejection>>.Success {value} => move value
    Result<StaticData, Shared<Rejection>>.Failure {error} => {
      let mut failure = run diagnostic(machine, Fault.StaticPhaseViolation, span)
      failure.rejection = Option<Shared<Rejection>>.some(move error)
      fail move failure
    }
  }
}

// The declaration whose module decides which fields `reflectFields` lists: the innermost
// executing function, so `Reflect.fields<T>()` lists the fields visible in `silk/core/reflect` and only
// a direct `Intrinsic.reflectFields<T>()` call uses its caller's visibility.
// The value a reflection port answered, or the fault that stops static execution.
effect fn reflectionAnswer<'source>(machine: &Machine<'source>,
  reflected: Result<Result<StaticData, Shared<Rejection>>, Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError>, span: Span)
-> StaticData ! Diagnostic | OutOfMemoryError ? &mut Allocator {
  let result = match move reflected {
    Result<Result<StaticData, Shared<Rejection>>, Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError>.Success {value} => move value
    Result<Result<StaticData, Shared<Rejection>>, Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError>.Failure {error} => match move error {
      OutOfMemoryError {} => {fail OutOfMemoryError {}}
      _ => run reject(&machine.*, Fault.Unavailable, span)
    }
  }
  return match move result {
    Result<StaticData, Shared<Rejection>>.Success {value} => move value
    Result<StaticData, Shared<Rejection>>.Failure {error} => {
      let mut failure = run diagnostic(&machine.*, Fault.Unsupported, span)
      failure.rejection = Option<Shared<Rejection>>.some(move error)
      fail move failure
    }
  }
}

fn reflectionAuthority<'source>(machine: &Machine<'source>) -> Option<DeclarationId> {
  let frames = List<Frame>.asSlice(&machine.active)
  if frames.length > usize.ZERO {
    return Option<DeclarationId>.some(DeclarationId.copy(Application.bodyDeclaration(&frames[frames.length - usize.ONE].instance)))
  }
  if let Option<Application>.Some {value: instance} = &machine.instance {
    return Option<DeclarationId>.some(DeclarationId.copy(Application.bodyDeclaration(&instance)))
  }
  return Option<DeclarationId>.none()
}

effect fn currentModule<'source>(machine: &Machine<'source>) -> ModuleId
! Diagnostic | OutOfMemoryError
? &mut Allocator {
  let active = List<Frame>.asSlice(&machine.active)
  if active.length > usize.ZERO {
    return ModuleId.copy(&active[active.length - usize.ONE].module)
  }
  return ModuleId.copy(&machine.root)
}

effect fn cursorFor<'source>(machine: &mut Machine<'source>, module: &ModuleId, span: Span) -> AuthoredCursor
! Diagnostic | OutOfMemoryError
? &mut Allocator {
  let attempted = run Effect.result(StaticPort.authoredCursor(&mut machine.port, module))
  let available = match move attempted {
    Result<Option<AuthoredCursor>, Cycle | OutOfMemoryError>.Success {value} => move value
    Result<Option<AuthoredCursor>, Cycle | OutOfMemoryError>.Failure {error} => match move error {
      OutOfMemoryError {} => { fail OutOfMemoryError {} }
      Cycle {} => run reject(&machine.*, Fault.Unavailable, span)
    }
  }
  return match move available {
    Option<AuthoredCursor>.Some {value} => move value
    Option<AuthoredCursor>.None => run reject(&machine.*, Fault.Unavailable, span)
  }
}

// `cursorFor` for reading `declaration` alone, which observes only its header and body.
effect fn declarationCursorFor<'source>(machine: &mut Machine<'source>, declaration: &DeclarationId, span: Span) -> AuthoredCursor
! Diagnostic | OutOfMemoryError
? &mut Allocator {
  let attempted = run Effect.result(StaticPort.declarationCursor(&mut machine.port, declaration))
  let available = match move attempted {
    Result<Option<AuthoredCursor>, Cycle | OutOfMemoryError>.Success {value} => move value
    Result<Option<AuthoredCursor>, Cycle | OutOfMemoryError>.Failure {error} => match move error {
      OutOfMemoryError {} => { fail OutOfMemoryError {} }
      Cycle {} => run reject(&machine.*, Fault.Unavailable, span)
    }
  }
  return match move available {
    Option<AuthoredCursor>.Some {value} => move value
    Option<AuthoredCursor>.None => run reject(&machine.*, Fault.Unavailable, span)
  }
}

// The cursor a checked root evaluates through: its own declaration's syntax.
effect fn rootCursor<'source>(machine: &mut Machine<'source>, checked: &CheckedRoot) -> AuthoredCursor
! Diagnostic | OutOfMemoryError
? &mut Allocator {
  let declaration = Shared<TypedBody>.with<DeclarationId>(&checked.body, fn(body: &TypedBody) -> DeclarationId {
    return DeclarationId.copy(TypedBody.declarationId(body))
  })
  return run declarationCursorFor(&mut machine.*, &declaration, Span.make(usize.ZERO, usize.ZERO))
}

effect fn diagnostic<'source>(machine: &Machine<'source>, fault: Fault, span: Span) -> Diagnostic
! OutOfMemoryError
? &mut Allocator {
  let sourceCode = faultCode(fault)
  let mut trace = List<TraceStep>.make()
  let active = List<Frame>.asSlice(&machine.active)
  let mut at = usize.ZERO
  while at < active.length {
    run List<TraceStep>.append(
      &mut trace,
      TraceStep {
        name: run Bytes.copy(Bytes.asSlice(&active[at].name)),
        arguments: run copyArguments(List<Interned<StaticData>>.asSlice(&active[at].arguments)),
        span: active[at].span,
        module: Option<ModuleId>.some(ModuleId.copy(&active[at].module)),
      },
    )
    at = at + usize.ONE
  }
  return Diagnostic {
    fault: fault,
    code: sourceCode,
    span: span,
    target: machine.target,
    message: Option<Bytes>.none(),
    origin: Option<Span>.none(),
    byteOffset: Option<u64>.none(),
    rejection: Option<Shared<Rejection>>.none(),
    needed: Option<Needed>.none(),
    missing: Option<MissingFact>.none(),
    trace: move trace,
  }
}

effect fn reject<'source>(machine: &Machine<'source>, fault: Fault, span: Span) -> never
! Diagnostic | OutOfMemoryError
? &mut Allocator {
  let failure = run diagnostic(machine, fault, span)
  fail move failure
}

// A failed operator at `span`, its authored operator; an arithmetic fault keeps the whole
// `expression` as its origin, which the report names.
effect fn rejectScalar<'source>(machine: &Machine<'source>, failure: StaticFault, span: Span, expression: Span) -> never
! Diagnostic | OutOfMemoryError
? &mut Allocator {
  let fault = match failure {
    StaticFault.InvalidOperands => { return run reject(machine, Fault.InvalidValue, span) }
    StaticFault.Overflow => Fault.Overflow
    StaticFault.DivisionByZero => Fault.DivisionByZero
  }
  let mut rejected = run diagnostic(machine, fault, span)
  rejected.origin = Option<Span>.some(expression)
  fail move rejected
}

effect fn unresolvedConstant<'source>(machine: &Machine<'source>, id: HirId, declaration: Interned<DeclarationId>) -> never
! Diagnostic | OutOfMemoryError
? &mut Allocator {
  let mut failure = run diagnostic(machine, Fault.Unavailable, Module.span(run authored(&machine.*), id))
  failure.needed = Option<Needed>.some(Needed {
    module: run currentModule(machine),
    expression: id,
    declaration: move declaration,
  })
  fail move failure
}

effect fn supplyBindings<'source>(machine: &mut Machine<'source>, bindings: &[Binding]) -> ()
! Diagnostic | OutOfMemoryError
? &mut Allocator | &mut Types {
  let mut at = usize.ZERO
  while at < bindings.length {
    let supplied = List<RetainedBinding>.asSlice(&machine.supplied)
    let mut found = false
    let mut prior = usize.ZERO
    while prior < supplied.length {
      if ModuleId.equals(&supplied[prior].module, &bindings[at].module) &&
        supplied[prior].binder.index == bindings[at].binder.index {
        if !run StaticValue.equals(&supplied[prior].value, &bindings[at].value) {
          return run reject(&machine.*, Fault.InvalidValue, Span.make(usize.ZERO, usize.ZERO))
        }
        found = true
        break
      }
      prior = prior + usize.ONE
    }
    if !found {
      let bytes = run unheldBytes(&mut machine.*, &bindings[at].value, false)
      if machine.retainedBytes > machine.limits.valueBytes || bytes > machine.limits.valueBytes - machine.retainedBytes {
        return run reject(&machine.*, Fault.ValueLimit, Span.make(usize.ZERO, usize.ZERO))
      }
      run List<RetainedBinding>.append(&mut machine.supplied, RetainedBinding {
        module: ModuleId.copy(&bindings[at].module),
        binder: bindings[at].binder,
        value: StaticValue.copy(&bindings[at].value),
        chargedBytes: bytes,
      })
      machine.retainedBytes = machine.retainedBytes + bytes
    }
    at = at + usize.ONE
  }
  return ()
}

effect fn suppliedValue<'source>(machine: &Machine<'source>, id: HirId, target: HirId) -> Option<Interned<StaticData>>
! Diagnostic | OutOfMemoryError
? &mut Allocator {
  let module = run currentModule(machine)
  let supplied = List<RetainedBinding>.asSlice(&machine.supplied)
  let mut at = supplied.length
  while at > usize.ZERO {
    at = at - usize.ONE
    if ModuleId.equals(&supplied[at].module, &module) &&
      (supplied[at].binder.index == target.index || supplied[at].binder.index == id.index) {
      return Option<Interned<StaticData>>.some(StaticValue.copy(&supplied[at].value))
    }
  }
  return Option<Interned<StaticData>>.none()
}

effect fn step<'source>(machine: &mut Machine<'source>, id: HirId) -> ()
! Diagnostic | OutOfMemoryError
? &mut Allocator {
  if machine.steps >= machine.limits.steps {
    return run reject(&machine.*, Fault.StepLimit, Module.span(run authored(&machine.*), id))
  }
  machine.steps = machine.steps + usize.ONE
  return ()
}

effect fn retain<'source>(machine: &mut Machine<'source>, value: StaticData, span: Span) -> Interned<StaticData> ! Diagnostic | OutOfMemoryError ? &mut Allocator {
  if StaticValue.size(&value) > machine.limits.valueBytes {
    return run reject(&machine.*, Fault.ValueLimit, span)
  }
  return run Interned<StaticData>.make(move value)
}

effect fn sameArguments(left: &[Interned<StaticData>], right: &[Interned<StaticData>]) -> bool
! OutOfMemoryError
? &mut Allocator | &mut Types {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if sharedDataAddress(&left[at]) != sharedDataAddress(&right[at]) && !run StaticValue.equals(&left[at], &right[at]) {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

effect fn copyArguments(args: &[Interned<StaticData>]) -> List<Interned<StaticData>>
! OutOfMemoryError
? &mut Allocator {
  let mut copied = run List<Interned<StaticData>>.makeWithCapacity(args.length)
  let mut at = usize.ZERO
  while at < args.length {
    run List<Interned<StaticData>>.append(&mut copied, StaticValue.copy(&args[at]))
    at = at + usize.ONE
  }
  return move copied
}

effect fn completed<'source>(
  machine: &Machine<'source>,
  application: usize,
  args: &[Interned<StaticData>],
) -> Option<Interned<StaticData>> ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let entries = List<Complete>.asSlice(&machine.complete)
  let mut at = usize.ZERO
  while at < entries.length {
    if entries[at].application == application && run sameArguments(
      List<Interned<StaticData>>.asSlice(&entries[at].arguments),
      args,
    ) {
      return Option<Interned<StaticData>>.some(StaticValue.copy(&entries[at].value))
    }
    at = at + usize.ONE
  }
  return Option<Interned<StaticData>>.none()
}

effect fn publish<'source>(
  machine: &mut Machine<'source>,
  application: usize,
  args: &[Interned<StaticData>],
  value: &Interned<StaticData>,
  span: Span,
) -> () ! Diagnostic | OutOfMemoryError ? &mut Allocator {
  let mut bytes = run unheldBytes(&mut machine.*, value, true)
  let mut at = usize.ZERO
  while at < args.length {
    let argumentBytes = run unheldBytes(&mut machine.*, &args[at], true)
    bytes = match move usize.checkedAdd(bytes, argumentBytes) {
      Option<usize>.Some {value: total} => total
      Option<usize>.None => {
        return run reject(&machine.*, Fault.ValueLimit, span)
      }
    }
    at = at + usize.ONE
  }
  if machine.retainedBytes > machine.limits.valueBytes || bytes > machine.limits.valueBytes - machine.retainedBytes {
    return run reject(&machine.*, Fault.ValueLimit, span)
  }
  let entry = Complete {
    application: application,
    arguments: run copyArguments(args),
    value: StaticValue.copy(value),
  }
  run List<Complete>.append(&mut machine.complete, move entry)
  machine.retainedBytes = machine.retainedBytes + bytes
  return ()
}

fn equal(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}


fn staticTextOperation(member: IntrinsicPrimitive) -> Option<StaticTextOperation> {
  if member == IntrinsicPrimitive.StaticTextByteLength {
    return Option<StaticTextOperation>.some(StaticTextOperation.ByteLength)
  }
  if member == IntrinsicPrimitive.StaticTextByteAt {
    return Option<StaticTextOperation>.some(StaticTextOperation.ByteAt)
  }
  if member == IntrinsicPrimitive.StaticTextConcat {
    return Option<StaticTextOperation>.some(StaticTextOperation.Concat)
  }
  if member == IntrinsicPrimitive.StaticTextSlice {
    return Option<StaticTextOperation>.some(StaticTextOperation.Slice)
  }
  return Option<StaticTextOperation>.none()
}

// The literal origin of the first argument: its span and the module the span points into.
// A field origin does not carry over: a text built from a label is not the field's name.
fn firstTextOrigin<'source>(machine: &Machine<'source>, values: &List<Interned<StaticData>>) -> Option<LocatedSite> {
  let arguments = List<Interned<StaticData>>.asSlice(values)
  if arguments.length == usize.ZERO { return Option<LocatedSite>.none() }
  let index = textOriginIndex(machine, &arguments[usize.ZERO])
  if index == usize.MAX { return Option<LocatedSite>.none() }
  let origin = &List<TextOrigin>.asSlice(&machine.textOrigins)[index]
  if let Option<FieldOrigin>.Some {..} = &origin.field { return Option<LocatedSite>.none() }
  return Option<LocatedSite>.some(LocatedSite {module: ModuleId.copy(&origin.module), span: origin.span})
}

// The module whose package an embedded file belongs to: the innermost active frame outside the
// standard library, whose `silk/` modules only wrap the read, else the evaluation's root.
effect fn embeddingModule<'source>(machine: &Machine<'source>) -> ModuleId
! OutOfMemoryError ? &mut Allocator {
  let active = List<Frame>.asSlice(&machine.active)
  let mut at = active.length
  while at > usize.ZERO {
    at = at - usize.ONE
    let standard = ModuleId.withPath<bool>(&active[at].module, fn(path: &[u8]) -> bool {
      return path.length > 5 && path[0] == 115 && path[1] == 105 && path[2] == 108 && path[3] == 107 && path[4] == 47
    })
    if !standard { return ModuleId.copy(&active[at].module) }
  }
  return ModuleId.copy(&machine.root)
}

// Fails an embed with `detail` at `span`.
effect fn rejectEmbed<'source>(machine: &Machine<'source>, span: Span, detail: Bytes) -> never
! Diagnostic | OutOfMemoryError ? &mut Allocator {
  let mut failure = run diagnostic(&machine.*, Fault.InvalidValue, span)
  failure.message = Option<Bytes>.some(move detail)
  fail move failure
}

effect fn profileArgument<'source>(
  machine: &mut Machine<'source>,
  local: &mut List<Local>,
  arguments: CallArguments,
  at: usize,
  span: Span,
) -> Bytes ! Diagnostic | OutOfMemoryError ? &mut Allocator | &mut Types {
  if at >= CallArguments.length(arguments) {
    return run reject(&machine.*, Fault.InvalidValue, span)
  }
  let id = CallArguments.child(arguments, run authored(&machine.*), at)
  let value = run expression(&mut machine.*, &mut local.*, id)
  return match move run StaticValue.textBytes(&value) {
    Option<Bytes>.Some {value: bytes} => move bytes
    Option<Bytes>.None => run reject(&machine.*, Fault.InvalidValue, span)
  }
}

// The integer type a scalar names, when it names one.
fn scalarInteger(scalar: Scalar) -> Option<StaticIntegerType> {
  return match scalar {
    Scalar.U8 => Option<StaticIntegerType>.some(StaticIntegerType.U8)
    Scalar.U16 => Option<StaticIntegerType>.some(StaticIntegerType.U16)
    Scalar.U32 => Option<StaticIntegerType>.some(StaticIntegerType.U32)
    Scalar.U64 => Option<StaticIntegerType>.some(StaticIntegerType.U64)
    Scalar.Usize => Option<StaticIntegerType>.some(StaticIntegerType.Usize)
    Scalar.I8 => Option<StaticIntegerType>.some(StaticIntegerType.I8)
    Scalar.I16 => Option<StaticIntegerType>.some(StaticIntegerType.I16)
    Scalar.I32 => Option<StaticIntegerType>.some(StaticIntegerType.I32)
    Scalar.I64 => Option<StaticIntegerType>.some(StaticIntegerType.I64)
    Scalar.Isize => Option<StaticIntegerType>.some(StaticIntegerType.Isize)
    _ => Option<StaticIntegerType>.none()
  }
}

// The source operator a checked arithmetic operation guards.
fn checkedInfix(code: ScalarCode) -> Option<InfixOperator> {
  return match code {
    ScalarCode.CheckedAdd => Option<InfixOperator>.some(InfixOperator.Add)
    ScalarCode.CheckedSubtract => Option<InfixOperator>.some(InfixOperator.Subtract)
    ScalarCode.CheckedMultiply => Option<InfixOperator>.some(InfixOperator.Multiply)
    ScalarCode.CheckedDivide => Option<InfixOperator>.some(InfixOperator.Divide)
    ScalarCode.CheckedRemainder => Option<InfixOperator>.some(InfixOperator.Remainder)
    _ => Option<InfixOperator>.none()
  }
}

// A scalar operand; `lessThan` takes its operands by reference.
effect fn scalarOperand<'source>(
  machine: &mut Machine<'source>,
  local: &mut List<Local>,
  operation: ScalarOperation,
  arguments: CallArguments,
  at: usize,
) -> Interned<StaticData> ! Diagnostic | OutOfMemoryError ? &mut Allocator | &mut Types {
  let id = CallArguments.child(arguments, run authored(&machine.*), at)
  let value = run expression(&mut machine.*, &mut local.*, id)
  if !ScalarOperation.borrows(operation) { return move value }
  return match move Interned<StaticData>.with<Option<Interned<StaticData>>>(&value, StaticValue.borrowTarget) {
    Option<Interned<StaticData>>.Some {value: target} => move target
    Option<Interned<StaticData>>.None => move value
  }
}

// Evaluates a sealed scalar intrinsic with the semantics of its source operator. A checked
// operation returns through its `present` and `absent` function values.
effect fn scalarIntrinsic<'source>(
  machine: &mut Machine<'source>,
  operation: ScalarOperation,
  arguments: CallArguments,
  local: &mut List<Local>,
  span: Span,
) -> Interned<StaticData> ! Diagnostic | OutOfMemoryError ? &mut Allocator | &mut Types {
  let arity = ScalarOperation.arity(operation)
  let mut expected = arity
  if ScalarOperation.checked(operation) { expected = arity + 2 }
  if CallArguments.length(arguments) != expected { return run reject(&machine.*, Fault.InvalidValue, span) }
  let pointerBits = machine.target.pointerBits()
  let first = run scalarOperand(&mut machine.*, &mut local.*, operation, arguments, usize.ZERO)
  let mut computed = Result<StaticData, StaticFault>.failResult(StaticFault.InvalidOperands)
  let mut supported = true
  if arity == 2 {
    let second = run scalarOperand(&mut machine.*, &mut local.*, operation, arguments, usize.ONE)
    let mut operator = ScalarOperation.infix(operation)
    if !operator.isSome() { operator = checkedInfix(operation.code) }
    match operator {
      Option<InfixOperator>.Some {value: selected} => {
        computed = StaticValue.infixShared(selected, &first, &second, pointerBits)
      }
      Option<InfixOperator>.None => { supported = false }
    }
  } else if operation.code == ScalarCode.Convert || operation.code == ScalarCode.CheckedConvert {
    match scalarInteger(operation.target) {
      Option<StaticIntegerType>.Some {value: ty} => {
        computed = StaticValue.convertedIntegerShared(&first, ty, pointerBits)
      }
      Option<StaticIntegerType>.None => { supported = false }
    }
  } else {
    match ScalarOperation.prefix(operation) {
      Option<PrefixOperator>.Some {value: selected} => {
        computed = StaticValue.prefixShared(selected, &first, pointerBits)
      }
      Option<PrefixOperator>.None => { supported = false }
    }
  }
  if !supported { return run reject(&machine.*, Fault.Unsupported, span) }
  if !ScalarOperation.checked(operation) {
    return match move computed {
      Result<StaticData, StaticFault>.Success {value: selected} => run retain(&mut machine.*, move selected, span)
      Result<StaticData, StaticFault>.Failure {error} => run rejectScalar(&machine.*, move error, span, span)
    }
  }
  let presentId = CallArguments.child(arguments, run authored(&machine.*), arity)
  let absentId = CallArguments.child(arguments, run authored(&machine.*), arity + usize.ONE)
  let present = run expression(&mut machine.*, &mut local.*, presentId)
  let absent = run expression(&mut machine.*, &mut local.*, absentId)
  let mut supplied = List<Interned<StaticData>>.make()
  return match move computed {
    Result<StaticData, StaticFault>.Success {value: selected} => {
      let held = run retain(&mut machine.*, move selected, span)
      run List<Interned<StaticData>>.append(&mut supplied, move held)
      run applyCallable(&mut machine.*, &present, move supplied, span)
    }
    Result<StaticData, StaticFault>.Failure {error} => {
      if error == StaticFault.InvalidOperands { return run reject(&machine.*, Fault.InvalidValue, span) }
      run applyCallable(&mut machine.*, &absent, move supplied, span)
    }
  }
}

fn sameLabel(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] { return false }
    at = at + usize.ONE
  }
  return true
}

effect fn dispatchIntrinsic<'source>(
  machine: &mut Machine<'source>,
  member: IntrinsicMember,
  call: HirId,
  arguments: CallArguments,
  local: &mut List<Local>,
  span: Span,
) -> Interned<StaticData> ! Diagnostic | OutOfMemoryError ? &mut Allocator | &mut Types {
  let primitive = match member {
    IntrinsicMember.Primitive {primitive: named} => named
    IntrinsicMember.Scalar {operation} => {
      return run scalarIntrinsic(&mut machine.*, operation, arguments, &mut local.*, span)
    }
  }
  if primitive == IntrinsicPrimitive.StaticSequenceEmpty || primitive == IntrinsicPrimitive.StaticSequenceAppend {
    let written = match move checkedIntrinsicType(&machine.*, call) {
      Option<Interned<SemanticType>>.Some {value} => move value
      Option<Interned<SemanticType>>.None => run reject(&machine.*, Fault.Unavailable, span)
    }
    let closed = run closeType(&machine.*, &written)
    if SemanticType.hasOpenRuntimeParameters(&closed) { return run reject(&machine.*, Fault.Unsupported, span) }
    if primitive == IntrinsicPrimitive.StaticSequenceEmpty {
      if CallArguments.length(arguments) != usize.ZERO { return run reject(&machine.*, Fault.InvalidValue, span) }
      let value = match move StaticValue.sequenceEmpty(move closed) {
        Option<StaticData>.Some {value} => move value
        Option<StaticData>.None => run reject(&machine.*, Fault.InvalidValue, span)
      }
      return run retain(&mut machine.*, move value, span)
    }
    if CallArguments.length(arguments) != 2 { return run reject(&machine.*, Fault.InvalidValue, span) }
    let first = CallArguments.child(arguments, run authored(&machine.*), usize.ZERO)
    let next = CallArguments.child(arguments, run authored(&machine.*), usize.ONE)
    let sequence = run expression(&mut machine.*, &mut local.*, first)
    let element = run expression(&mut machine.*, &mut local.*, next)
    if !run StaticValue.matchesType(&sequence, &closed) { return run reject(&machine.*, Fault.InvalidValue, span) }
    let appended = match move run StaticValue.sequenceAppend(&sequence, &element) {
      Option<StaticData>.Some {value} => move value
      Option<StaticData>.None => run reject(&machine.*, Fault.Unsupported, span)
    }
    return run retain(&mut machine.*, move appended, span)
  }
  if primitive == IntrinsicPrimitive.StaticSequenceConcat {
    if CallArguments.length(arguments) != 2 { return run reject(&machine.*, Fault.InvalidValue, span) }
    let first = CallArguments.child(arguments, run authored(&machine.*), usize.ZERO)
    let second = CallArguments.child(arguments, run authored(&machine.*), usize.ONE)
    let left = run expression(&mut machine.*, &mut local.*, first)
    let right = run expression(&mut machine.*, &mut local.*, second)
    let joined = match move run StaticValue.sequenceConcat(&left, &right) {
      Option<StaticData>.Some {value} => move value
      Option<StaticData>.None => run reject(&machine.*, Fault.InvalidValue, span)
    }
    return run retain(&mut machine.*, move joined, span)
  }
  if primitive == IntrinsicPrimitive.StaticSequenceLength || primitive == IntrinsicPrimitive.StaticSequenceAt {
    let mut expected: usize = 2
    if primitive == IntrinsicPrimitive.StaticSequenceLength { expected = usize.ONE }
    if CallArguments.length(arguments) != expected { return run reject(&machine.*, Fault.InvalidValue, span) }
    let first = CallArguments.child(arguments, run authored(&machine.*), usize.ZERO)
    let sequence = run expression(&mut machine.*, &mut local.*, first)
    let count = Interned<StaticData>.with<usize>(&sequence, StaticValue.sequenceLength)
    if count == usize.MAX { return run reject(&machine.*, Fault.InvalidValue, span) }
    if primitive == IntrinsicPrimitive.StaticSequenceLength {
      return run retain(&mut machine.*, StaticData.Integer {ty: StaticIntegerType.Usize, sign: StaticSign.Positive, magnitude: usize.toU64(count)}, span)
    }
    let next = CallArguments.child(arguments, run authored(&machine.*), usize.ONE)
    let position = run expression(&mut machine.*, &mut local.*, next)
    let at = Interned<StaticData>.with<u64>(&position, fn(actual: &StaticData) -> u64 {
      if let StaticData.Integer {sign, magnitude, ..} = &actual.* { if sign == StaticSign.Positive { return magnitude } }
      return u64.MAX
    })
    if at >= usize.toU64(count) { return run reject(&machine.*, Fault.InvalidValue, span) }
    return match move Interned<StaticData>.with<Option<Interned<StaticData>>>(&sequence, fn(actual: &StaticData) -> Option<Interned<StaticData>> {
      return StaticValue.sequenceElement(actual, u64.toUsize(at))
    }) {
      Option<Interned<StaticData>>.Some {value} => move value
      Option<Interned<StaticData>>.None => run reject(&machine.*, Fault.InvalidValue, span)
    }
  }
  if primitive == IntrinsicPrimitive.ReflectFields {
    if CallArguments.length(arguments) != usize.ZERO {return run reject(&machine.*, Fault.InvalidValue, span)}
    let written = match move checkedIntrinsicType(&machine.*, call) {
      Option<Interned<SemanticType>>.Some {value} => move value
      Option<Interned<SemanticType>>.None => run reject(&machine.*, Fault.Unavailable, span)
    }
    let closed = run closeType(&machine.*, &written)
    let owner = match move Interned<SemanticType>.with<Option<Interned<SemanticType>>>(&closed, CheckedIntrinsic.fieldsOwner) {
      Option<Interned<SemanticType>>.Some {value} => move value
      Option<Interned<SemanticType>>.None => run reject(&machine.*, Fault.InvalidValue, span)
    }
    if SemanticType.hasOpenRuntimeParameters(&owner) {return run reject(&machine.*, Fault.Unsupported, span)}
    let authorization = reflectionAuthority(&machine.*)
    let authority = match move authorization {
      Option<DeclarationId>.Some {value} => move value
      Option<DeclarationId>.None => run reject(&machine.*, Fault.Unavailable, span)
    }
    let site = run currentModule(&machine.*)
    let reflected = run Effect.result(StaticPort.reflectedFields(&mut machine.port, &owner, &authority, &site, span))
    let result = match move reflected {
      Result<Result<StaticData, Shared<Rejection>>, Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError>.Success {value} => move value
      Result<Result<StaticData, Shared<Rejection>>, Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError>.Failure {error} => match move error {
        OutOfMemoryError {} => {fail OutOfMemoryError {}}
        _ => run reject(&machine.*, Fault.Unavailable, span)
      }
    }
    let fields = match move result {
      Result<StaticData, Shared<Rejection>>.Success {value} => move value
      Result<StaticData, Shared<Rejection>>.Failure {error} => {
        let mut failure = run diagnostic(&machine.*, Fault.Unsupported, span)
        failure.rejection = Option<Shared<Rejection>>.some(move error)
        fail move failure
      }
    }
    return run retain(&mut machine.*, move fields, span)
  }
  if primitive == IntrinsicPrimitive.ReflectField {
    if CallArguments.length(arguments) != usize.ONE {return run reject(&machine.*, Fault.InvalidValue, span)}
    let written = match move checkedIntrinsicType(&machine.*, call) {
      Option<Interned<SemanticType>>.Some {value} => move value
      Option<Interned<SemanticType>>.None => run reject(&machine.*, Fault.Unavailable, span)
    }
    let closed = run closeType(&machine.*, &written)
    let owner = match move Interned<SemanticType>.with<Option<CheckedIntrinsic.FieldTypes>>(&closed, CheckedIntrinsic.fieldTypes) {
      Option<CheckedIntrinsic.FieldTypes>.Some {value} => move value.owner
      Option<CheckedIntrinsic.FieldTypes>.None => run reject(&machine.*, Fault.InvalidValue, span)
    }
    if SemanticType.hasOpenRuntimeParameters(&closed) {return run reject(&machine.*, Fault.Unsupported, span)}
    let syntax = CallArguments.child(arguments, run authored(&machine.*), usize.ZERO)
    let text = run expression(&mut machine.*, &mut local.*, syntax)
    let label = match move run StaticValue.textBytes(&text) {
      Option<Bytes>.Some {value} => move value
      Option<Bytes>.None => run reject(&machine.*, Fault.InvalidValue, span)
    }
    let authority = match move reflectionAuthority(&machine.*) {
      Option<DeclarationId>.Some {value} => move value
      Option<DeclarationId>.None => run reject(&machine.*, Fault.Unavailable, span)
    }
    let site = run currentModule(&machine.*)
    let reflected = run Effect.result(StaticPort.reflectedFields(&mut machine.port, &owner, &authority, &site, span))
    let fields = run reflectionAnswer(&machine.*, move reflected, span)
    let count = StaticValue.sequenceLength(&fields)
    let mut at = usize.ZERO
    while at < count {
      let element = match move StaticValue.sequenceElement(&fields, at) {
        Option<Interned<StaticData>>.Some {value} => move value
        Option<Interned<StaticData>>.None => run reject(&machine.*, Fault.InvalidValue, span)
      }
      let parts = match move Interned<StaticData>.with<Option<StaticValue.FieldParts>>(&element, StaticValue.fieldParts) {
        Option<StaticValue.FieldParts>.Some {value} => move value
        Option<StaticValue.FieldParts>.None => run reject(&machine.*, Fault.InvalidValue, span)
      }
      let same = Shared<Bytes>.with<bool>(&parts.label, fn(held: &Bytes) -> bool {
        return sameLabel(Bytes.asSlice(held), Bytes.asSlice(&label))
      })
      if same {
        if !run SemanticType.equalsShared(&parts.ty, &closed) {
          let mut detail = run Bytes.copy(b"the field `")
          run Bytes.append(&mut detail, Bytes.asSlice(&label))
          run Bytes.append(&mut detail, b"` does not have the requested type")
          let mut failure = run diagnostic(&machine.*, Fault.InvalidValue, span)
          failure.message = Option<Bytes>.some(move detail)
          fail move failure
        }
        return move element
      }
      at = at + usize.ONE
    }
    let mut detail = run Bytes.copy(b"there is no visible field named `")
    run Bytes.append(&mut detail, Bytes.asSlice(&label))
    run Bytes.append(&mut detail, b"`")
    let mut failure = run diagnostic(&machine.*, Fault.InvalidValue, span)
    failure.message = Option<Bytes>.some(move detail)
    fail move failure
  }
  if primitive == IntrinsicPrimitive.ReflectVariants {
    if CallArguments.length(arguments) != usize.ZERO {return run reject(&machine.*, Fault.InvalidValue, span)}
    let written = match move checkedIntrinsicType(&machine.*, call) {
      Option<Interned<SemanticType>>.Some {value} => move value
      Option<Interned<SemanticType>>.None => run reject(&machine.*, Fault.Unavailable, span)
    }
    let closed = run closeType(&machine.*, &written)
    let owner = match move Interned<SemanticType>.with<Option<Interned<SemanticType>>>(&closed, CheckedIntrinsic.variantsOwner) {
      Option<Interned<SemanticType>>.Some {value} => move value
      Option<Interned<SemanticType>>.None => run reject(&machine.*, Fault.InvalidValue, span)
    }
    if SemanticType.hasOpenRuntimeParameters(&owner) {return run reject(&machine.*, Fault.Unsupported, span)}
    let authority = match move reflectionAuthority(&machine.*) {
      Option<DeclarationId>.Some {value} => move value
      Option<DeclarationId>.None => run reject(&machine.*, Fault.Unavailable, span)
    }
    let site = run currentModule(&machine.*)
    let reflected = run Effect.result(StaticPort.reflectedVariants(&mut machine.port, &owner, &authority, &site, span))
    let variants = run reflectionAnswer(&machine.*, move reflected, span)
    return run retain(&mut machine.*, move variants, span)
  }
  if primitive == IntrinsicPrimitive.ReflectVariantLabel || primitive == IntrinsicPrimitive.ReflectVariantFields {
    if CallArguments.length(arguments) != usize.ONE {return run reject(&machine.*, Fault.InvalidValue, span)}
    let syntax = CallArguments.child(arguments, run authored(&machine.*), usize.ZERO)
    let actual = run expression(&mut machine.*, &mut local.*, syntax)
    let variant = match move Interned<StaticData>.with<Option<StaticValue.FieldParts>>(&actual, StaticValue.fieldParts) {
      Option<StaticValue.FieldParts>.Some {value} => move value
      Option<StaticValue.FieldParts>.None => run reject(&machine.*, Fault.InvalidValue, span)
    }
    if variant.kind != StaticValue.variantKind {return run reject(&machine.*, Fault.InvalidValue, span)}
    if primitive == IntrinsicPrimitive.ReflectVariantLabel {
      let label = run StaticValue.copySharedBytes(&variant.label)
      let text = match move StaticValue.text(move label) {
        Option<StaticData>.Some {value} => move value
        Option<StaticData>.None => run reject(&machine.*, Fault.InvalidValue, span)
      }
      return run retain(&mut machine.*, move text, span)
    }
    let described = match move Interned<SemanticType>.with<Option<Interned<SemanticType>>>(&variant.ty, CheckedIntrinsic.variantOwner) {
      Option<Interned<SemanticType>>.Some {value} => move value
      Option<Interned<SemanticType>>.None => run reject(&machine.*, Fault.InvalidValue, span)
    }
    // The variant's fields are listed with the visibility its descriptor was reflected under.
    let site = run currentModule(&machine.*)
    let reflected = run Effect.result(StaticPort.reflectedVariantFields(&mut machine.port, &described, variant.ordinal, &variant.authorization,
      &site, span))
    let fields = run reflectionAnswer(&machine.*, move reflected, span)
    return run retain(&mut machine.*, move fields, span)
  }
  if primitive == IntrinsicPrimitive.Tests {
    if CallArguments.length(arguments) != usize.ZERO {return run reject(&machine.*, Fault.InvalidValue, span)}
    let module = run currentModule(&machine.*)
    let answered = run Effect.result(StaticPort.tests(&mut machine.port, &module, span))
    let catalog = run discoveryAnswer(&machine.*, move answered, span)
    return run retain(&mut machine.*, move catalog, span)
  }
  if primitive == IntrinsicPrimitive.TestInfo {
    if CallArguments.length(arguments) != usize.ONE {return run reject(&machine.*, Fault.InvalidValue, span)}
    let syntax = CallArguments.child(arguments, run authored(&machine.*), usize.ZERO)
    let descriptor = run expression(&mut machine.*, &mut local.*, syntax)
    let module = run currentModule(&machine.*)
    let answered = run Effect.result(StaticPort.testInfo(&mut machine.port, &descriptor, &module, span))
    let info = run discoveryAnswer(&machine.*, move answered, span)
    return run retain(&mut machine.*, move info, span)
  }
  // An erased function reference is the function value itself; restoring it checks the contract
  // the reference was erased from against the one the call names.
  if primitive == IntrinsicPrimitive.FunctionRef || primitive == IntrinsicPrimitive.FunctionAs {
    if CallArguments.length(arguments) != usize.ONE {return run reject(&machine.*, Fault.InvalidValue, span)}
    let syntax = CallArguments.child(arguments, run authored(&machine.*), usize.ZERO)
    let held = run expression(&mut machine.*, &mut local.*, syntax)
    if !Interned<StaticData>.with<bool>(&held, StaticValue.isCallable) {return run reject(&machine.*, Fault.InvalidValue, span)}
    if primitive == IntrinsicPrimitive.FunctionAs {
      let written = match move checkedIntrinsicType(&machine.*, call) {
        Option<Interned<SemanticType>>.Some {value} => move value
        Option<Interned<SemanticType>>.None => run reject(&machine.*, Fault.Unavailable, span)
      }
      let wanted = run closeType(&machine.*, &written)
      if !run callableHasContract(&held, &wanted) {
        let mut failure = run diagnostic(&machine.*, Fault.InvalidValue, span)
        failure.message = Option<Bytes>.some(run Bytes.copy(b"the function this reference holds does not have the contract `functionAs` names"))
        fail move failure
      }
    }
    return move held
  }
  // A checked field name is its text during static evaluation; the checker proved the field.
  if primitive == IntrinsicPrimitive.FieldNameLabel || primitive == IntrinsicPrimitive.VariantNameLabel {
    if CallArguments.length(arguments) != usize.ONE {return run reject(&machine.*, Fault.InvalidValue, span)}
    let syntax = CallArguments.child(arguments, run authored(&machine.*), usize.ZERO)
    let name = run expression(&mut machine.*, &mut local.*, syntax)
    let text = Interned<StaticData>.with<bool>(&name, fn(data: &StaticData) -> bool { return match &data.* { StaticData.Text {..} => true _ => false } })
    if !text {return run reject(&machine.*, Fault.InvalidValue, span)}
    return move name
  }
  if primitive == IntrinsicPrimitive.ReflectFieldDoc || primitive == IntrinsicPrimitive.ReflectFieldKind || primitive == IntrinsicPrimitive.ReflectFieldLabel || primitive == IntrinsicPrimitive.ReflectFieldOrdinal {
    if CallArguments.length(arguments) != usize.ONE {return run reject(&machine.*, Fault.InvalidValue, span)}
    let syntax = CallArguments.child(arguments, run authored(&machine.*), usize.ZERO)
    let actual = run expression(&mut machine.*, &mut local.*, syntax)
    let field = match move Interned<StaticData>.with<Option<StaticValue.FieldParts>>(&actual, StaticValue.fieldParts) {
      Option<StaticValue.FieldParts>.Some {value} => move value
      Option<StaticValue.FieldParts>.None => run reject(&machine.*, Fault.InvalidValue, span)
    }
    if field.kind == StaticValue.variantKind {return run reject(&machine.*, Fault.InvalidValue, span)}
    if primitive == IntrinsicPrimitive.ReflectFieldDoc {
      // Only a named struct field has a `///` block of its own here.
      let mut documentation = Bytes.make()
      if field.kind == 0 {
        let owner = match move Interned<SemanticType>.with<Option<CheckedIntrinsic.FieldTypes>>(&field.ty, CheckedIntrinsic.fieldTypes) {
          Option<CheckedIntrinsic.FieldTypes>.Some {value} => move value.owner
          Option<CheckedIntrinsic.FieldTypes>.None => run reject(&machine.*, Fault.InvalidValue, span)
        }
        let label = run StaticValue.copySharedBytes(&field.label)
        documentation = match move run Effect.result(StaticPort.fieldDocumentation(&mut machine.port, &owner, Bytes.asSlice(&label))) {
          Result<Bytes, Cycle | OutOfMemoryError>.Success {value} => move value
          Result<Bytes, Cycle | OutOfMemoryError>.Failure {error} => match move error {
            OutOfMemoryError {} => { fail OutOfMemoryError {} }
            Cycle {} => run reject(&machine.*, Fault.Cycle, span)
          }
        }
      }
      let text = match move StaticValue.text(move documentation) {
        Option<StaticData>.Some {value} => move value
        Option<StaticData>.None => run reject(&machine.*, Fault.InvalidValue, span)
      }
      return run retain(&mut machine.*, move text, span)
    }
    if primitive == IntrinsicPrimitive.ReflectFieldLabel {
      // A named field and a union variant's field both have a label.
      if field.kind != 0 && field.kind != 2 {return run reject(&machine.*, Fault.Unsupported, span)}
      let label = run StaticValue.copySharedBytes(&field.label)
      let text = match move StaticValue.text(run Bytes.copy(Bytes.asSlice(&label))) {
        Option<StaticData>.Some {value} => move value
        Option<StaticData>.None => run reject(&machine.*, Fault.InvalidValue, span)
      }
      let retained = run retain(&mut machine.*, move text, span)
      // A struct field's label is its declared name, so a report about the label names the field.
      if field.kind == 0 {
        if let Option<CheckedIntrinsic.FieldTypes>.Some {value: types} = Interned<SemanticType>.with<Option<CheckedIntrinsic.FieldTypes>>(&field.ty, CheckedIntrinsic.fieldTypes) {
          let module = run currentModule(&machine.*)
          run recordTextOrigin(&mut machine.*, &retained, span, move module,
            Option<FieldOrigin>.some(FieldOrigin {owner: move types.owner, label: move label}))
        }
      }
      return move retained
    }
    if primitive == IntrinsicPrimitive.ReflectFieldOrdinal {
      if field.kind != 1 && field.kind != 2 {return run reject(&machine.*, Fault.Unsupported, span)}
      return run retain(&mut machine.*, StaticData.Integer {ty: StaticIntegerType.Usize, sign: StaticSign.Positive, magnitude: usize.toU64(field.ordinal)}, span)
    }
    return run retain(&mut machine.*, StaticData.Integer {ty: StaticIntegerType.U8, sign: StaticSign.Positive, magnitude: u8.toU64(field.kind)}, span)
  }
  if primitive == IntrinsicPrimitive.ReflectType {
    if CallArguments.length(arguments) != usize.ZERO { return run reject(&machine.*, Fault.InvalidValue, span) }
    let checked = checkedIntrinsicType(&machine.*, call)
    let written = match move checked {
      Option<Interned<SemanticType>>.Some {value} => move value
      Option<Interned<SemanticType>>.None => run reject(&machine.*, Fault.Unavailable, span)
    }
    let closed = run closeType(&machine.*, &written)
    let described = Interned<SemanticType>.with<Option<Interned<SemanticType>>>(&closed, descriptorOwner)
    let owner = match move described {
      Option<Interned<SemanticType>>.Some {value} => move value
      Option<Interned<SemanticType>>.None => run reject(&machine.*, Fault.InvalidValue, span)
    }
    // Reflection reads a type's shape, which its validity lifetimes never change: a descriptor of
    // `(string<'a>,)` in the generic check of a function over `'a` is that tuple's. Only an open
    // type or row parameter leaves the shape unknown.
    if SemanticType.hasOpenRuntimeParameters(&owner) {
      let mut failure = run diagnostic(&machine.*, Fault.Unsupported, span)
      failure.missing = Option<MissingFact>.some(MissingFact.TypedApplication)
      fail move failure
    }
    return run retain(&mut machine.*, run StaticValue.descriptor(move owner), span)
  }
  if primitive == IntrinsicPrimitive.ReflectTypeKind {
    if CallArguments.length(arguments) != usize.ONE { return run reject(&machine.*, Fault.InvalidValue, span) }
    let argument = CallArguments.child(arguments, run authored(&machine.*), usize.ZERO)
    let value = run expression(&mut machine.*, &mut local.*, argument)
    let described = Interned<StaticData>.with<Option<Interned<SemanticType>>>(&value, fn(data: &StaticData) -> Option<Interned<SemanticType>> {
      return match &data.* {
        StaticData.Aggregate {ty, ..} => Interned<SemanticType>.with<Option<Interned<SemanticType>>>(&ty, descriptorOwner)
        _ => Option<Interned<SemanticType>>.none()
      }
    })
    let owner = match move described {
      Option<Interned<SemanticType>>.Some {value: selected} => move selected
      Option<Interned<SemanticType>>.None => run reject(&machine.*, Fault.InvalidValue, span)
    }
    // The stable codes of `silk.core.reflect`: a source-declared named aggregate is 0 and a positional
    // one is 1. Occurrence-generated records and positional aggregates are 2 and 3. A fixed array
    // is 4, a nominal union is 6, and every other type is 5, so a generic body can branch on the
    // kind of any type.
    let kind = Interned<SemanticType>.with<u64>(&owner, fn(ty: &SemanticType) -> u64 {
      return match &ty.* {
        SemanticType.Nominal {declaration, ..} => match DeclarationId.kind(&declaration) {
          OwnerKind.Struct => 0
          OwnerKind.Tuple => 1
          OwnerKind.Union => 6
          _ => 5
        }
        SemanticType.Anonymous {occurrence, ..} => {
          if AnonymousOccurrence.isPositional(&occurrence) {return 3}
          return 2
        }
        SemanticType.Array {..} => 4
        _ => 5
      }
    })
    return run retain(&mut machine.*, StaticData.Integer {ty: StaticIntegerType.U8, sign: StaticSign.Positive, magnitude: kind}, span)
  }
  if primitive == IntrinsicPrimitive.Embed || primitive == IntrinsicPrimitive.EmbedText {
    if CallArguments.length(arguments) != usize.ONE { return run reject(&machine.*, Fault.InvalidValue, span) }
    let path = run profileArgument(&mut machine.*, &mut local.*, arguments, usize.ZERO, span)
    let reader = run embeddingModule(&machine.*)
    let mut package = Bytes.make()
    run ModuleId.appendPackage(&reader, &mut package)
    let file = match move run Effect.result(ModuleId.make(b"embed", Bytes.asSlice(&package), Bytes.asSlice(&path))) {
      Result<ModuleId, InvalidModulePath | OutOfMemoryError>.Success {value} => move value
      Result<ModuleId, InvalidModulePath | OutOfMemoryError>.Failure {error} => match move error {
        InvalidModulePath {} => {
          let mut detail = run Bytes.copy(b"cannot embed \"")
          run Bytes.append(&mut detail, Bytes.asSlice(&path))
          run Bytes.append(&mut detail, b"\": the path must be relative to the package's directory, without . or .. segments, so a package embeds only its own files")
          run rejectEmbed(&machine.*, span, move detail)
        }
        OutOfMemoryError {} => { fail OutOfMemoryError {} }
      }
    }
    let content = match move run StaticPort<'source>.embeddedFile(&mut machine.port, &file) {
      Option<Bytes>.Some {value} => move value
      Option<Bytes>.None => {
        let mut detail = run Bytes.copy(b"cannot embed \"")
        run Bytes.append(&mut detail, Bytes.asSlice(&path))
        run Bytes.append(&mut detail, b"\": no such file in package ")
        run Bytes.append(&mut detail, Bytes.asSlice(&package))
        run Bytes.append(&mut detail, b" (the path is relative to the package's directory, and must be a string literal written in the call that embeds it)")
        run rejectEmbed(&machine.*, span, move detail)
      }
    }
    // A file's bytes are read, not computed, so the value limit that bounds evaluation does not
    // apply to them.
    if primitive == IntrinsicPrimitive.Embed {
      return run Interned<StaticData>.make(StaticData.Bytes {bytes: move content})
    }
    let text = match move StaticValue.text(move content) {
      Option<StaticData>.Some {value} => move value
      Option<StaticData>.None => {
        let mut detail = run Bytes.copy(b"cannot embed \"")
        run Bytes.append(&mut detail, Bytes.asSlice(&path))
        run Bytes.append(&mut detail, b"\" as text: the file is not valid UTF-8; embed its bytes instead")
        run rejectEmbed(&machine.*, span, move detail)
      }
    }
    return run Interned<StaticData>.make(move text)
  }
  if primitive == IntrinsicPrimitive.ProfileText || primitive == IntrinsicPrimitive.ProfileFlag || primitive == IntrinsicPrimitive.ProfileContains {
    let mut count = usize.ONE
    if primitive == IntrinsicPrimitive.ProfileContains { count = 2 }
    if CallArguments.length(arguments) != count {
      return run reject(&machine.*, Fault.InvalidValue, span)
    }
    let key = run profileArgument(&mut machine.*, &mut local.*, arguments, usize.ZERO, span)
    let mut memberName = Bytes.make()
    if primitive == IntrinsicPrimitive.ProfileContains {
      memberName = run profileArgument(&mut machine.*, &mut local.*, arguments, usize.ONE, span)
    }
    let module = run currentModule(&machine.*)
    let demanded = run Effect.result(StaticPort.demandProfile(&mut machine.port, &module, span))
    match move demanded {
      Result<(), Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError>.Success {..} => {}
      Result<(), Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError>.Failure {error} => match move error {
        OutOfMemoryError {} => { fail OutOfMemoryError {} }
        Cycle {} => run reject(&machine.*, Fault.Unavailable, span)
        InvalidModulePath {} => run reject(&machine.*, Fault.Unavailable, span)
        RevisionMismatch {} => run reject(&machine.*, Fault.Unavailable, span)
      }
    }
    let mut kind: &[u8] = b"text:"
    if primitive == IntrinsicPrimitive.ProfileFlag { kind = b"flag:" }
    if primitive == IntrinsicPrimitive.ProfileContains { kind = b"set:" }
    run StaticPort.observeProfile(&mut machine.port, &module, kind, Bytes.asSlice(&key))
    let available = StaticPort<'source>.profileFacts(&machine.port)
    let profile = match move available {
      Option<&InitialProfile>.Some {value} => value
      Option<&InitialProfile>.None => {
        let mut failure = run diagnostic(&machine.*, Fault.Unsupported, span)
        failure.missing = Option<MissingFact>.some(MissingFact.ProfileInput)
        fail move failure
      }
    }
    if primitive == IntrinsicPrimitive.ProfileText {
      let selected = InitialProfile.text(profile, Bytes.asSlice(&key))
      let fact = match move selected {
        Option<&[u8]>.Some {value} => value
        Option<&[u8]>.None => run reject(&machine.*, Fault.InvalidValue, span)
      }
      if fact.length > machine.limits.valueBytes || machine.limits.valueBytes - fact.length < 16 {
        return run reject(&machine.*, Fault.ValueLimit, span)
      }
      let copied = run Bytes.copy(fact)
      let selectedText = StaticValue.text(move copied)
      let text = match move selectedText {
        Option<StaticData>.Some {value} => move value
        Option<StaticData>.None => run reject(&machine.*, Fault.InvalidValue, span)
      }
      let retained = run retain(&mut machine.*, move text, span)
      run rememberTextOrigin(&mut machine.*, &retained, span)
      return move retained
    }
    let mut result = Option<bool>.none()
    if primitive == IntrinsicPrimitive.ProfileFlag {
      result = InitialProfile.flag(profile, Bytes.asSlice(&key))
    } else {
      result = InitialProfile.contains(profile, Bytes.asSlice(&key), Bytes.asSlice(&memberName))
    }
    return match move result {
      Option<bool>.Some {value} => run retain(&mut machine.*, StaticData.Boolean {value: value}, span)
      Option<bool>.None => run reject(&machine.*, Fault.InvalidValue, span)
    }
  }
  let selectedName = intrinsicSpelling(primitive)
  if let Option<u32>.Some {value: number} = move machine.target.queryNumber(selectedName) {
    if CallArguments.length(arguments) != usize.ZERO { return run reject(&machine.*, Fault.InvalidValue, span) }
    return run retain(&mut machine.*, StaticData.Integer {
      ty: StaticIntegerType.U32, sign: StaticSign.Positive, magnitude: u32.toU64(number),
    }, span)
  }
  if let Option<&[u8]>.Some {value: fact} = move machine.target.queryText(selectedName) {
    if CallArguments.length(arguments) != usize.ZERO { return run reject(&machine.*, Fault.InvalidValue, span) }
    if fact.length > machine.limits.valueBytes || machine.limits.valueBytes - fact.length < 16 {
      return run reject(&machine.*, Fault.ValueLimit, span)
    }
    let copied = run Bytes.copy(fact)
    let text = match move StaticValue.text(move copied) {
      Option<StaticData>.Some {value} => move value
      Option<StaticData>.None => { return run reject(&machine.*, Fault.InvalidValue, span) }
    }
    let retained = run retain(&mut machine.*, move text, span)
    run rememberTextOrigin(&mut machine.*, &retained, span)
    return move retained
  }
  if primitive == IntrinsicPrimitive.StaticTextErrorAt {
    return run textErrorAt(&mut machine.*, arguments, &mut local.*, span)
  }
  if let Option<StaticTextOperation>.Some {value: selected} = move staticTextOperation(primitive) {
    let mut values = List<Interned<StaticData>>.make()
    let mut at = usize.ZERO
    while at < CallArguments.length(arguments) {
      let argument = CallArguments.child(arguments, run authored(&machine.*), at)
      let value = run expression(&mut machine.*, &mut local.*, argument)
      run List<Interned<StaticData>>.append(&mut values, move value)
      at = at + usize.ONE
    }
    let sourceOrigin = firstTextOrigin(&machine.*, &values)
    let producesText = selected == StaticTextOperation.Concat || selected == StaticTextOperation.Slice
    let applied = run StaticText.apply(
      selected, List<Interned<StaticData>>.asSlice(&values), machine.target.pointerBits(),
      machine.limits.valueBytes,
    )
    return match move applied {
      Result<StaticData, StaticText.Fault>.Success {value} => {
        let retained = run retain(&mut machine.*, move value, span)
        if producesText {
          if let Option<LocatedSite>.Some {value: origin} = move sourceOrigin {
            run recordTextOrigin(&mut machine.*, &retained, origin.span, ModuleId.copy(&origin.module), Option<FieldOrigin>.none())
          }
        }
        return move retained
      }
      Result<StaticData, StaticText.Fault>.Failure {error} => {
        if error.kind == StaticTextFaultKind.ValueLimit {
          return run reject(&machine.*, Fault.ValueLimit, span)
        }
        let mut failure = run diagnostic(&machine.*, Fault.InvalidValue, span)
        failure.byteOffset = Option<u64>.some(error.byteOffset)
        failure.origin = match move sourceOrigin {
          Option<LocatedSite>.Some {value: origin} => Option<Span>.some(origin.span)
          Option<LocatedSite>.None => Option<Span>.none()
        }
        failure.message = run textFaultDetail(move error, List<Interned<StaticData>>.asSlice(&values))
        fail move failure
      }
    }
  }
  let mut failure = run diagnostic(&machine.*, Fault.Unsupported, span)
  failure.missing = Option<MissingFact>.some(MissingFact.IntrinsicOperation)
  fail move failure
}

// `StaticText.errorAt`: a selected compile error whose site is a byte range of a text that came
// from a literal or a field name. A text with no such origin, or one built from several, reports
// at the call like `compileError`.
effect fn textErrorAt<'source>(machine: &mut Machine<'source>, arguments: CallArguments, local: &mut List<Local>, span: Span)
-> Interned<StaticData> ! Diagnostic | OutOfMemoryError ? &mut Allocator | &mut Types {
  if CallArguments.length(arguments) != 4 { return run reject(&machine.*, Fault.InvalidValue, span) }
  let mut values = List<Interned<StaticData>>.make()
  let mut at = usize.ZERO
  while at < 4 {
    let argument = CallArguments.child(arguments, run authored(&machine.*), at)
    let value = run expression(&mut machine.*, &mut local.*, argument)
    run List<Interned<StaticData>>.append(&mut values, move value)
    at = at + usize.ONE
  }
  let listed = List<Interned<StaticData>>.asSlice(&values)
  let length = match move Interned<StaticData>.with<Option<usize>>(&listed[usize.ZERO], StaticText.length) {
    Option<usize>.Some {value} => value
    Option<usize>.None => { return run reject(&machine.*, Fault.InvalidValue, span) }
  }
  let start = match move Interned<StaticData>.with<Option<u64>>(&listed[usize.ONE], usizeValue) {
    Option<u64>.Some {value} => value
    Option<u64>.None => { return run reject(&machine.*, Fault.InvalidValue, span) }
  }
  let end = match move Interned<StaticData>.with<Option<u64>>(&listed[2], usizeValue) {
    Option<u64>.Some {value} => value
    Option<u64>.None => { return run reject(&machine.*, Fault.InvalidValue, span) }
  }
  let message = match move run StaticValue.textBytes(&listed[3]) {
    Option<Bytes>.Some {value} => move value
    Option<Bytes>.None => { return run reject(&machine.*, Fault.InvalidValue, span) }
  }
  if start > end || end > usize.toU64(length) {
    let mut failure = run diagnostic(&machine.*, Fault.InvalidValue, span)
    let mut detail = Bytes.make()
    run Bytes.append(&mut detail, b"the range starting at byte ")
    run appendDecimal(&mut detail, start)
    run Bytes.append(&mut detail, b" does not fit inside the text")
    failure.message = Option<Bytes>.some(move detail)
    fail move failure
  }
  let site = run textSite(&mut machine.*, &listed[usize.ZERO], u64.toUsize(start), u64.toUsize(end), length)
  let mut failure = run diagnostic(&machine.*, Fault.CompileError, span)
  failure.message = Option<Bytes>.some(run Bytes.copy(Bytes.asSlice(&message)))
  if let Option<LocatedSite>.Some {value: located} = move site {
    // The outermost frame is the call in the evaluated module that reached this report.
    let mut related = Option<LocatedSite>.none()
    let active = List<Frame>.asSlice(&machine.active)
    if active.length > usize.ZERO {
      related = Option<LocatedSite>.some(LocatedSite {module: ModuleId.copy(&machine.root), span: active[usize.ZERO].span})
    }
    let rejection = run StaticPort.locatedCompileError(&mut machine.port, move located, move related, Bytes.asSlice(&message))
    failure.rejection = Option<Shared<Rejection>>.some(move rejection)
  }
  fail move failure
}

// The authored site of bytes `start..end` of a text whose byte length is `length`: inside the
// literal it was written as, escapes included, or in the declared name of the field it labels.
effect fn textSite<'source>(machine: &mut Machine<'source>, value: &Interned<StaticData>, start: usize, end: usize, length: usize)
-> Option<LocatedSite> ! Diagnostic | OutOfMemoryError ? &mut Allocator {
  let index = textOriginIndex(&machine.*, value)
  if index == usize.MAX { return Option<LocatedSite>.none() }
  let origin = &List<TextOrigin>.asSlice(&machine.textOrigins)[index]
  let module = ModuleId.copy(&origin.module)
  let span = origin.span
  let mut field = Option<FieldOrigin>.none()
  if let Option<FieldOrigin>.Some {value: named} = &origin.field {
    field = Option<FieldOrigin>.some(FieldOrigin {owner: Interned<SemanticType>.clone(&named.owner), label: run Bytes.copy(Bytes.asSlice(&named.label))})
  }
  let answered = match move field {
    Option<FieldOrigin>.Some {value: named} => run Effect.result(StaticPort.fieldNameSite(&mut machine.port, &named.owner,
      Bytes.asSlice(&named.label), start, end))
    Option<FieldOrigin>.None => run Effect.result(StaticPort.literalSite(&mut machine.port, &module, span, start, end, length))
  }
  return match move answered {
    Result<Option<LocatedSite>, Cycle | OutOfMemoryError>.Success {value: found} => move found
    Result<Option<LocatedSite>, Cycle | OutOfMemoryError>.Failure {error} => match move error {
      OutOfMemoryError {} => { fail OutOfMemoryError {} }
      Cycle {} => Option<LocatedSite>.none()
    }
  }
}

fn usizeValue(value: &StaticData) -> Option<u64> {
  return match &value.* {
    StaticData.Integer {ty, sign, magnitude} => {
      if ty == StaticIntegerType.Usize && sign == StaticSign.Positive { return Option<u64>.some(magnitude) }
      return Option<u64>.none()
    }
    _ => Option<u64>.none()
  }
}

// Why a static text operation failed, in words; none for a fault the reference has no wording for.
effect fn textFaultDetail(error: StaticText.Fault, values: &[Interned<StaticData>]) -> Option<Bytes> ! OutOfMemoryError ? &mut Allocator {
  let mut detail = Bytes.make()
  if error.kind == StaticTextFaultKind.OutOfBounds {
    run Bytes.append(&mut detail, b"index ")
    run appendDecimal(&mut detail, error.byteOffset)
    run Bytes.append(&mut detail, b" is past the end of the ")
    if values.length > usize.ZERO {
      if let Option<usize>.Some {value: count} = Interned<StaticData>.with<Option<usize>>(&values[usize.ZERO], StaticText.length) {
        run appendDecimal(&mut detail, usize.toU64(count))
        run Bytes.append(&mut detail, b"-byte ")
      }
    }
    run Bytes.append(&mut detail, b"text")
    return Option<Bytes>.some(move detail)
  }
  if error.kind == StaticTextFaultKind.InvalidRange {
    run Bytes.append(&mut detail, b"the range starting at byte ")
    run appendDecimal(&mut detail, error.byteOffset)
    run Bytes.append(&mut detail, b" does not fit inside the text")
    return Option<Bytes>.some(move detail)
  }
  if error.kind == StaticTextFaultKind.SplitScalar {
    run Bytes.append(&mut detail, b"byte ")
    run appendDecimal(&mut detail, error.byteOffset)
    run Bytes.append(&mut detail, b" falls inside a UTF-8 character, so the slice would split it")
    return Option<Bytes>.some(move detail)
  }
  return Option<Bytes>.none()
}

effect fn appendDecimal(output: &mut Bytes, value: u64) -> () ! OutOfMemoryError ? &mut Allocator {
  if value >= 10 { run appendDecimal(&mut output.*, value / 10) }
  run Bytes.append(&mut output.*, &[u64.toU8(48 + u64.remainder(value, 10))])
  return ()
}

/// The exact static integer representation of a checked primitive type spelling.
pub fn integerType(text: &[u8]) -> Option<StaticIntegerType> {
  if equal(text, b"u8") {
    return Option<StaticIntegerType>.some(StaticIntegerType.U8)
  }
  if equal(text, b"u16") {
    return Option<StaticIntegerType>.some(StaticIntegerType.U16)
  }
  if equal(text, b"u32") {
    return Option<StaticIntegerType>.some(StaticIntegerType.U32)
  }
  if equal(text, b"u64") {
    return Option<StaticIntegerType>.some(StaticIntegerType.U64)
  }
  if equal(text, b"usize") {
    return Option<StaticIntegerType>.some(StaticIntegerType.Usize)
  }
  if equal(text, b"i8") {
    return Option<StaticIntegerType>.some(StaticIntegerType.I8)
  }
  if equal(text, b"i16") {
    return Option<StaticIntegerType>.some(StaticIntegerType.I16)
  }
  if equal(text, b"i32") {
    return Option<StaticIntegerType>.some(StaticIntegerType.I32)
  }
  if equal(text, b"i64") {
    return Option<StaticIntegerType>.some(StaticIntegerType.I64)
  }
  if equal(text, b"isize") {
    return Option<StaticIntegerType>.some(StaticIntegerType.Isize)
  }
  return Option<StaticIntegerType>.none()
}

fn namedType(value: &StaticData, text: &[u8]) -> Option<bool> {
  if let Option<StaticIntegerType>.Some {value: expected} = move integerType(text) {
    return Option<bool>.some(match & value.* {
      StaticData.Integer {ty, ..} => ty == expected
      _ => false
    })
  }
  if equal(text, b"bool") {
    return Option<bool>.some(match & value.* {
      StaticData.Boolean {..} => true
      _ => false
    })
  }
  if equal(text, b"char") {
    return Option<bool>.some(match & value.* {
      StaticData.Character {..} => true
      _ => false
    })
  }
  if equal(text, b"string") {
    return Option<bool>.some(match & value.* {
      StaticData.Text {..} => true
      _ => false
    })
  }
  if equal(text, b"f32") {
    return Option<bool>.some(match & value.* {
      StaticData.Float {ty, ..} => ty == StaticFloatType.F32
      _ => false
    })
  }
  if equal(text, b"f64") {
    return Option<bool>.some(match & value.* {
      StaticData.Float {ty, ..} => ty == StaticFloatType.F64
      _ => false
    })
  }
  return Option<bool>.none()
}

fn semanticValueType(value: &StaticData, ty: &SemanticType) -> Option<bool> {
  return match & ty.* {
    SemanticType.Primitive {name: spelling} => namedType(value, Bytes.asSlice(&spelling))
    SemanticType.Unit => Option<bool>.some(match & value.* {
      StaticData.Unit => true
      _ => false
    })
    SemanticType.String {..} => Option<bool>.some(match & value.* {
      StaticData.Text {..} => true
      _ => false
    })
    // Only an embedded file's bytes are a static `&'static [u8]`.
    SemanticType.Slice {..} => match & value.* {
      StaticData.Bytes {..} => Option<bool>.some(true)
      _ => Option<bool>.none()
    }
    _ => Option<bool>.none()
  }
}

fn checkedValueType(ty: &SemanticType, value: &Interned<StaticData>) -> Option<bool> {
  return Interned<StaticData>.with<Option<bool>>(value, fn(actual: &StaticData) -> Option<bool> {
    return semanticValueType(actual, ty)
  })
}

// A rejected or unavailable body's forwarded cause.
fn failedBody(cause: Option<Shared<Rejection>>) -> Option<Result<Shared<TypedBody>, Shared<Rejection>>> {
  return match move cause {
    Option<Shared<Rejection>>.Some {value} => Option<Result<Shared<TypedBody>, Shared<Rejection>>>.some(
      Result<Shared<TypedBody>, Shared<Rejection>>.failResult(move value))
    Option<Shared<Rejection>>.None => Option<Result<Shared<TypedBody>, Shared<Rejection>>>.none()
  }
}

fn bodyFromAnswer(answer: &Result<Answer, NoRejection>) -> Option<Result<Shared<TypedBody>, Shared<Rejection>>> {
  return match &answer.* {
    Result<Answer, NoRejection>.Success {value} => match &value.outcome {
      Outcome.Success {value: Value.Body {body}} => Option<Result<Shared<TypedBody>, Shared<Rejection>>>.some(
        Result<Shared<TypedBody>, Shared<Rejection>>.succeed(Shared<TypedBody>.clone(&body)),
      )
      Outcome.Rejected {..} => failedBody(Outcome.cause(&value.outcome))
      Outcome.Unavailable {..} => failedBody(Outcome.cause(&value.outcome))
      _ => Option<Result<Shared<TypedBody>, Shared<Rejection>>>.none()
    }
    Result<Answer, NoRejection>.Failure {..} => Option<Result<Shared<TypedBody>, Shared<Rejection>>>.none()
  }
}

fn emptyNodes() -> NodeIndex {
  return NodeIndex {starts: List<usize>.make(), positions: List<usize>.make()}
}

// One more than the largest relative syntax node `body` records.
fn nodeLimit(body: &TypedBody) -> usize {
  let nodes = TypedBody.nodeSlice(body)
  let mut limit = usize.ZERO
  let mut at = usize.ZERO
  while at < nodes.length {
    if nodes[at].origin.node >= limit { limit = nodes[at].origin.node + usize.ONE }
    at = at + usize.ONE
  }
  return limit
}

fn nodeCount(body: &TypedBody) -> usize {
  return TypedBody.nodeSlice(body).length
}

effect fn zeros(count: usize) -> List<usize> ! OutOfMemoryError ? &mut Allocator {
  let mut values = List<usize>.make()
  run List<usize>.reserveExact(&mut values, count)
  let mut at = usize.ZERO
  while at < count {
    run List<usize>.append(&mut values, usize.ZERO)
    at = at + usize.ONE
  }
  return move values
}

// Counting-sorts `body`'s node positions by syntax node: `starts` holds one more slot than there
// are syntax nodes, `cursors` one per syntax node, and `positions` one per checked node.
fn placeNodes(body: &TypedBody, starts: &mut [usize], cursors: &mut [usize], positions: &mut [usize]) -> () {
  let nodes = TypedBody.nodeSlice(body)
  let mut at = usize.ZERO
  while at < nodes.length {
    let node = nodes[at].origin.node
    starts[node + usize.ONE] = starts[node + usize.ONE] + usize.ONE
    at = at + usize.ONE
  }
  at = usize.ONE
  while at < starts.length {
    starts[at] = starts[at] + starts[at - usize.ONE]
    cursors[at - usize.ONE] = starts[at - usize.ONE]
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < nodes.length {
    let node = nodes[at].origin.node
    positions[cursors[node]] = at
    cursors[node] = cursors[node] + usize.ONE
    at = at + usize.ONE
  }
  return ()
}

// Groups `body`'s node positions by the relative syntax node each records.
effect fn indexShared(body: &Shared<TypedBody>) -> NodeIndex ! OutOfMemoryError ? &mut Allocator {
  let limit = Shared<TypedBody>.with<usize>(body, nodeLimit)
  let count = Shared<TypedBody>.with<usize>(body, nodeCount)
  let mut starts = run zeros(limit + usize.ONE)
  let mut cursors = run zeros(limit)
  let mut positions = run zeros(count)
  Shared<TypedBody>.with<()>(body, fn(typed: &TypedBody) -> () {
    placeNodes(typed, List<usize>.asMutSlice(&mut starts), List<usize>.asMutSlice(&mut cursors), List<usize>.asMutSlice(&mut positions))
    return ()
  })
  return NodeIndex {starts: move starts, positions: move positions}
}

fn bodyAddress(body: &TypedBody) -> usize {
  return Pointer.address<TypedBody>(Pointer.fromRef<TypedBody>(body))
}

// The slot of `body`'s node index, indexing it the first time a frame executes it.
effect fn indexedSlot<'source>(machine: &mut Machine<'source>, body: &Shared<TypedBody>) -> usize
! OutOfMemoryError ? &mut Allocator {
  let address = Shared<TypedBody>.with<usize>(body, bodyAddress)
  let known = List<IndexedBody>.asSlice(&machine.indexed)
  let mut at = usize.ZERO
  while at < known.length {
    if known[at].address == address { return at }
    at = at + usize.ONE
  }
  let slot = known.length
  let nodes = run indexShared(body)
  run List<IndexedBody>.append(&mut machine.indexed, IndexedBody {body: Shared<TypedBody>.clone(body), address: address, nodes: move nodes})
  return slot
}

// The node index of the body expressions currently execute in.
fn checkedNodes<'borrow, 'source>(machine: &'borrow Machine<'source>) -> &'borrow NodeIndex {
  let frames = List<Frame>.asSlice(&machine.active)
  if frames.length == usize.ZERO { return &machine.rootNodes }
  let known = List<IndexedBody>.asSlice(&machine.indexed)
  return &known[frames[frames.length - usize.ONE].nodes].nodes
}

// The positions in `nodes.positions` of the checked nodes that record `id`.
fn recorded(nodes: &NodeIndex, anchor: &Anchor, id: HirId) -> Range {
  let starts = List<usize>.asSlice(&nodes.starts)
  if id.index < anchor.first.index { return Range {start: usize.ZERO, length: usize.ZERO} }
  let relative = id.index - anchor.first.index
  if relative + usize.ONE >= starts.length { return Range {start: usize.ZERO, length: usize.ZERO} }
  return Range {start: starts[relative], length: starts[relative + usize.ONE] - starts[relative]}
}

fn checkedBodyForExpression<'source>(machine: &Machine<'source>) -> Option<Shared<TypedBody>> {
  let frames = List<Frame>.asSlice(&machine.active)
  if frames.length == usize.ZERO {
    return match &machine.rootBody {
      Option<Shared<TypedBody>>.Some {value} => Option<Shared<TypedBody>>.some(Shared<TypedBody>.clone(&value))
      Option<Shared<TypedBody>>.None => Option<Shared<TypedBody>>.none()
    }
  }
  let current = &frames[frames.length - usize.ONE]
  return Option<Shared<TypedBody>>.some(Shared<TypedBody>.clone(&current.body))
}

// The anchor the executing checked body's origins count from, read through the current source;
// absent when no body executes or its declaration is gone from that source.
fn checkedAnchor<'source>(machine: &Machine<'source>) -> Option<Anchor> {
  let body = match move checkedBodyForExpression(machine) {
    Option<Shared<TypedBody>>.Some {value} => move value
    Option<Shared<TypedBody>>.None => { return Option<Anchor>.none() }
  }
  let declaration = Shared<TypedBody>.with<DeclarationId>(&body, fn(checked: &TypedBody) -> DeclarationId {
    return DeclarationId.copy(TypedBody.declarationId(checked))
  })
  if let Option<AuthoredCursor>.Some {value: cursor} = &machine.current {
    if let Option<&IndexedSource>.Some {value: indexed} = move StaticPort.sourceAtCursor(&machine.port, &cursor) {
      if let Option<usize>.Some {value: ordinal} = move ModuleIndex.ordinalOf(IndexedSource.moduleIndex(indexed), &declaration) {
        return IndexedSource.anchorOf(indexed, ordinal)
      }
    }
  }
  return Option<Anchor>.none()
}

fn checkedExpressionType<'source>(machine: &Machine<'source>, id: HirId) -> Option<Interned<SemanticType>> {
  let window = checkedRange(machine)
  let index = checkedNodes(machine)
  let anchor = match move checkedAnchor(machine) {
    Option<Anchor>.Some {value} => move value
    Option<Anchor>.None => { return Option<Interned<SemanticType>>.none() }
  }
  return match move checkedBodyForExpression(machine) {
    Option<Shared<TypedBody>>.Some {value: body} => Shared<TypedBody>.with<Option<Interned<SemanticType>>>(
    &body,
    fn(body: &TypedBody) -> Option<Interned<SemanticType>> {
      let nodes = TypedBody.nodeSlice(body)
      let found = recorded(index, &anchor, id)
      let candidates = List<usize>.asSlice(&index.positions)
      let mut next = found.start
      while next < found.start + found.length {
        let at = candidates[next]
        if at >= window.start && at - window.start < window.length {
          if let CheckedNodeKind.Expression {ty, ..} = &nodes[at].kind {
            return Option<Interned<SemanticType>>.some(Interned<SemanticType>.clone(&ty))
          }
        }
        next = next + usize.ONE
      }
      return Option<Interned<SemanticType>>.none()
    },
    )
    Option<Shared<TypedBody>>.None => Option<Interned<SemanticType>>.none()
  }
}

fn intrinsicMemberAt(body: &TypedBody, index: &NodeIndex, id: HirId, window: Range, anchor: &Anchor) -> Option<IntrinsicMember> {
  let nodes = TypedBody.nodeSlice(body)
  let found = recorded(index, anchor, id)
  let candidates = List<usize>.asSlice(&index.positions)
  let mut next = found.start
  while next < found.start + found.length {
    let at = candidates[next]
    if at >= window.start && at - window.start < window.length {
      if let CheckedNodeKind.Expression {form: CheckedExpression.IntrinsicCall {member, ..}, ..} = &nodes[at].kind {
        return Option<IntrinsicMember>.some(member)
      }
    }
    next = next + usize.ONE
  }
  return Option<IntrinsicMember>.none()
}

fn checkedIntrinsicMember<'source>(machine: &Machine<'source>, id: HirId) -> Option<IntrinsicMember> {
  let window = checkedRange(machine)
  let index = checkedNodes(machine)
  let anchor = match move checkedAnchor(machine) {
    Option<Anchor>.Some {value} => move value
    Option<Anchor>.None => { return Option<IntrinsicMember>.none() }
  }
  return match move checkedBodyForExpression(machine) {
    Option<Shared<TypedBody>>.Some {value: body} => Shared<TypedBody>.with<Option<IntrinsicMember>>(&body, fn(body: &TypedBody) -> Option<IntrinsicMember> {
      return intrinsicMemberAt(body, index, id, window, &anchor)
    })
    Option<Shared<TypedBody>>.None => Option<IntrinsicMember>.none()
  }
}

// The checked type of one reached intrinsic call, written in the executing body's binders.
fn checkedIntrinsicType<'source>(machine: &Machine<'source>, id: HirId) -> Option<Interned<SemanticType>> {
  let window = checkedRange(machine)
  let index = checkedNodes(machine)
  let anchor = match move checkedAnchor(machine) {
    Option<Anchor>.Some {value} => move value
    Option<Anchor>.None => { return Option<Interned<SemanticType>>.none() }
  }
  return match move checkedBodyForExpression(machine) {
    Option<Shared<TypedBody>>.Some {value: body} => Shared<TypedBody>.with<Option<Interned<SemanticType>>>(&body, fn(body: &TypedBody) -> Option<Interned<SemanticType>> {
      let nodes = TypedBody.nodeSlice(body)
      let found = recorded(index, &anchor, id)
      let candidates = List<usize>.asSlice(&index.positions)
      let mut next = found.start
      while next < found.start + found.length {
        let at = candidates[next]
        if at >= window.start && at - window.start < window.length {
          if let CheckedNodeKind.Expression {ty, form: CheckedExpression.IntrinsicCall {..}} = &nodes[at].kind {
            return Option<Interned<SemanticType>>.some(Interned<SemanticType>.clone(&ty))
          }
        }
        next = next + usize.ONE
      }
      return Option<Interned<SemanticType>>.none()
    })
    Option<Shared<TypedBody>>.None => Option<Interned<SemanticType>>.none()
  }
}

fn descriptorOwner(ty: &SemanticType) -> Option<Interned<SemanticType>> {
  return match &ty.* {
    SemanticType.TypeDescriptor {owner} => Option<Interned<SemanticType>>.some(Interned<SemanticType>.clone(&owner))
    _ => Option<Interned<SemanticType>>.none()
  }
}

// Closes a checked type written in the executing body's binders with that body's application.
effect fn closeType<'source>(machine: &Machine<'source>, ty: &Interned<SemanticType>) -> Interned<SemanticType>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let frames = List<Frame>.asSlice(&machine.active)
  if frames.length > usize.ZERO {
    return run SemanticType.applyBindings(ty, List<TypeBinding>.asSlice(&frames[frames.length - usize.ONE].bindings), true)
  }
  // Empty until a root instance is set, which closes nothing.
  return run SemanticType.applyBindings(ty, List<TypeBinding>.asSlice(&machine.instanceBindings), true)
}

fn selectedStaticArm<'source>(machine: &Machine<'source>, id: HirId) -> Option<HirRef> {
  let window = checkedRange(machine)
  let index = checkedNodes(machine)
  let anchor = match move checkedAnchor(machine) {
    Option<Anchor>.Some {value} => move value
    Option<Anchor>.None => { return Option<HirRef>.none() }
  }
  return match move checkedBodyForExpression(machine) {
    Option<Shared<TypedBody>>.Some {value: body} => Shared<TypedBody>.with<Option<HirRef>>(
      &body,
      fn(checked: &TypedBody) -> Option<HirRef> {
        let nodes = TypedBody.nodeSlice(checked)
        let found = recorded(index, &anchor, id)
        let candidates = List<usize>.asSlice(&index.positions)
        let mut next = found.start
        while next < found.start + found.length {
          let at = candidates[next]
          if at >= window.start && at - window.start < window.length {
            if let CheckedNodeKind.Block {statements, ..} = &nodes[at].kind {
              let retained = List<CheckedNodeId>.asSlice(&statements)
              if retained.length == usize.ZERO {
                return Option<HirRef>.some(HirRef.absent())
              }
              if retained.length == usize.ONE && retained[usize.ZERO].index < nodes.length {
                return Option<HirRef>.some(
                  HirRef.of(Anchor.hir(&anchor, nodes[retained[usize.ZERO].index].origin.node)),
                )
              }
            }
            return Option<HirRef>.none()
          }
          next = next + usize.ONE
        }
        return Option<HirRef>.none()
      },
    )
    Option<Shared<TypedBody>>.None => Option<HirRef>.none()
  }
}

// The scalar-enum member a static root's checked body records at `id`, if any.
fn checkedEnumMember<'source>(machine: &Machine<'source>, id: HirId) -> Option<CheckedEnumMember> {
  let window = checkedRange(machine)
  let index = checkedNodes(machine)
  let anchor = match move checkedAnchor(machine) {
    Option<Anchor>.Some {value} => move value
    Option<Anchor>.None => { return Option<CheckedEnumMember>.none() }
  }
  return match move checkedBodyForExpression(machine) {
    Option<Shared<TypedBody>>.Some {value: body} => Shared<TypedBody>.with<Option<CheckedEnumMember>>(
      &body,
      fn(body: &TypedBody) -> Option<CheckedEnumMember> {
        let nodes = TypedBody.nodeSlice(body)
        let found = recorded(index, &anchor, id)
        let candidates = List<usize>.asSlice(&index.positions)
        let mut next = found.start
        while next < found.start + found.length {
          let at = candidates[next]
          if at >= window.start && at - window.start < window.length {
            if let CheckedNodeKind.Expression {form: CheckedExpression.EnumMember {member}, ..} = &nodes[at].kind {
              return Option<CheckedEnumMember>.some(member)
            }
          }
          next = next + usize.ONE
        }
        return Option<CheckedEnumMember>.none()
      },
    )
    Option<Shared<TypedBody>>.None => Option<CheckedEnumMember>.none()
  }
}

// The declaration-order field a static root's checked body reads at `id`, if `id` is a field read.
// Whether typing read this field expression as an array's or a slice's length.
fn checkedLength<'source>(machine: &Machine<'source>, id: HirId) -> bool {
  let window = checkedRange(machine)
  let index = checkedNodes(machine)
  let anchor = match move checkedAnchor(machine) {
    Option<Anchor>.Some {value} => move value
    Option<Anchor>.None => { return false }
  }
  return match move checkedBodyForExpression(machine) {
    Option<Shared<TypedBody>>.Some {value: body} => Shared<TypedBody>.with<bool>(&body, fn(body: &TypedBody) -> bool {
      let nodes = TypedBody.nodeSlice(body)
      let found = recorded(index, &anchor, id)
      let candidates = List<usize>.asSlice(&index.positions)
      let mut next = found.start
      while next < found.start + found.length {
        let at = candidates[next]
        if at >= window.start && at - window.start < window.length {
          if let CheckedNodeKind.Expression {form: CheckedExpression.ArrayLength {..}, ..} = &nodes[at].kind { return true }
          if let CheckedNodeKind.Expression {form: CheckedExpression.SliceLength {..}, ..} = &nodes[at].kind { return true }
        }
        next = next + usize.ONE
      }
      return false
    })
    Option<Shared<TypedBody>>.None => false
  }
}

// The slice type typing made of an array borrow read at this expression, if it made one.
fn checkedSliceType<'source>(machine: &Machine<'source>, id: HirId) -> Option<Interned<SemanticType>> {
  let window = checkedRange(machine)
  let index = checkedNodes(machine)
  let anchor = match move checkedAnchor(machine) {
    Option<Anchor>.Some {value} => move value
    Option<Anchor>.None => { return Option<Interned<SemanticType>>.none() }
  }
  return match move checkedBodyForExpression(machine) {
    Option<Shared<TypedBody>>.Some {value: body} => Shared<TypedBody>.with<Option<Interned<SemanticType>>>(&body, fn(body: &TypedBody) -> Option<Interned<SemanticType>> {
      let nodes = TypedBody.nodeSlice(body)
      let found = recorded(index, &anchor, id)
      let candidates = List<usize>.asSlice(&index.positions)
      let mut next = found.start
      while next < found.start + found.length {
        let at = candidates[next]
        if at >= window.start && at - window.start < window.length {
          if let CheckedNodeKind.Expression {ty, form: CheckedExpression.ArraySlice {..}} = &nodes[at].kind {
            return Option<Interned<SemanticType>>.some(Interned<SemanticType>.clone(&ty))
          }
        }
        next = next + usize.ONE
      }
      return Option<Interned<SemanticType>>.none()
    })
    Option<Shared<TypedBody>>.None => Option<Interned<SemanticType>>.none()
  }
}

// The type of a borrow expression's view: the slice typing made of an array borrow, or else the
// borrow's own reference type.
fn checkedViewType<'source>(machine: &Machine<'source>, id: HirId) -> Option<Interned<SemanticType>> {
  let window = checkedRange(machine)
  let index = checkedNodes(machine)
  let anchor = match move checkedAnchor(machine) {
    Option<Anchor>.Some {value} => move value
    Option<Anchor>.None => { return Option<Interned<SemanticType>>.none() }
  }
  return match move checkedBodyForExpression(machine) {
    Option<Shared<TypedBody>>.Some {value: body} => Shared<TypedBody>.with<Option<Interned<SemanticType>>>(&body, fn(body: &TypedBody) -> Option<Interned<SemanticType>> {
      let nodes = TypedBody.nodeSlice(body)
      let found = recorded(index, &anchor, id)
      let candidates = List<usize>.asSlice(&index.positions)
      let mut borrowed = Option<Interned<SemanticType>>.none()
      let mut next = found.start
      while next < found.start + found.length {
        let at = candidates[next]
        if at >= window.start && at - window.start < window.length {
          if let CheckedNodeKind.Expression {ty, form: CheckedExpression.ArraySlice {..}} = &nodes[at].kind {
            return Option<Interned<SemanticType>>.some(Interned<SemanticType>.clone(&ty))
          }
          if let CheckedNodeKind.Expression {ty, form: CheckedExpression.Borrow {..}} = &nodes[at].kind {
            borrowed = Option<Interned<SemanticType>>.some(Interned<SemanticType>.clone(&ty))
          }
        }
        next = next + usize.ONE
      }
      return move borrowed
    })
    Option<Shared<TypedBody>>.None => Option<Interned<SemanticType>>.none()
  }
}

fn checkedFieldIndex<'source>(machine: &Machine<'source>, id: HirId) -> Option<usize> {
  let window = checkedRange(machine)
  let index = checkedNodes(machine)
  let anchor = match move checkedAnchor(machine) {
    Option<Anchor>.Some {value} => move value
    Option<Anchor>.None => { return Option<usize>.none() }
  }
  return match move checkedBodyForExpression(machine) {
    Option<Shared<TypedBody>>.Some {value: body} => Shared<TypedBody>.with<Option<usize>>(&body, fn(body: &TypedBody) -> Option<usize> {
      let nodes = TypedBody.nodeSlice(body)
      let found = recorded(index, &anchor, id)
      let candidates = List<usize>.asSlice(&index.positions)
      let mut next = found.start
      while next < found.start + found.length {
        let at = candidates[next]
        if at >= window.start && at - window.start < window.length {
          if let CheckedNodeKind.Expression {form: CheckedExpression.Field {index: field, ..}, ..} = &nodes[at].kind {
            return Option<usize>.some(field)
          }
        }
        next = next + usize.ONE
      }
      return Option<usize>.none()
    })
    Option<Shared<TypedBody>>.None => Option<usize>.none()
  }
}

// One struct-literal initializer: its authored expression and its declaration-order field.
struct CheckedInitializer {
  syntax: HirId,
  index: usize,
}

// The initializers a static root's checked body records for the struct literal at `id`, in
// authored evaluation order, or absent when `id` is not a checked struct construction.
effect fn checkedInitializers<'source>(machine: &Machine<'source>, id: HirId) -> Option<List<CheckedInitializer>>
! OutOfMemoryError ? &mut Allocator {
  let window = checkedRange(machine)
  let index = checkedNodes(machine)
  let anchor = match move checkedAnchor(machine) {
    Option<Anchor>.Some {value} => move value
    Option<Anchor>.None => { return Option<List<CheckedInitializer>>.none() }
  }
  let body = match move checkedBodyForExpression(machine) {
    Option<Shared<TypedBody>>.Some {value} => move value
    Option<Shared<TypedBody>>.None => { return Option<List<CheckedInitializer>>.none() }
  }
  let count = Shared<TypedBody>.with<usize>(&body, fn(checked: &TypedBody) -> usize { return aggregateFieldCount(checked, index, id, window, &anchor) })
  if count == usize.MAX { return Option<List<CheckedInitializer>>.none() }
  let mut initializers = List<CheckedInitializer>.make()
  let mut at = usize.ZERO
  while at < count {
    let selected = Shared<TypedBody>.with<Option<CheckedInitializer>>(&body, fn(checked: &TypedBody) -> Option<CheckedInitializer> {
      return aggregateFieldAt(checked, index, id, at, window, &anchor)
    })
    match move selected {
      Option<CheckedInitializer>.Some {value} => run List<CheckedInitializer>.append(&mut initializers, move value)
      Option<CheckedInitializer>.None => { return Option<List<CheckedInitializer>>.none() }
    }
    at = at + usize.ONE
  }
  return Option<List<CheckedInitializer>>.some(move initializers)
}

fn aggregateFieldCount(body: &TypedBody, index: &NodeIndex, id: HirId, window: Range, anchor: &Anchor) -> usize {
  let nodes = TypedBody.nodeSlice(body)
  let found = recorded(index, anchor, id)
  let candidates = List<usize>.asSlice(&index.positions)
  let mut next = found.start
  while next < found.start + found.length {
    let at = candidates[next]
    if at >= window.start && at - window.start < window.length {
      if let CheckedNodeKind.Expression {form: CheckedExpression.Aggregate {fields, ..}, ..} = &nodes[at].kind {
        return List<CheckedAggregateField>.length(&fields)
      }
      if let CheckedNodeKind.Expression {form: CheckedExpression.VariantConstruct {fields, ..}, ..} = &nodes[at].kind {
        return List<CheckedAggregateField>.length(&fields)
      }
    }
    next = next + usize.ONE
  }
  return usize.MAX
}

fn aggregateFieldAt(body: &TypedBody, index: &NodeIndex, id: HirId, ordinal: usize, window: Range, anchor: &Anchor) -> Option<CheckedInitializer> {
  let nodes = TypedBody.nodeSlice(body)
  let found = recorded(index, anchor, id)
  let candidates = List<usize>.asSlice(&index.positions)
  let mut next = found.start
  while next < found.start + found.length {
    let at = candidates[next]
    if at >= window.start && at - window.start < window.length {
      if let CheckedNodeKind.Expression {form: CheckedExpression.Aggregate {fields, ..}, ..} = &nodes[at].kind {
        let listed = List<CheckedAggregateField>.asSlice(&fields)
        if ordinal >= listed.length || listed[ordinal].value.index >= nodes.length { return Option<CheckedInitializer>.none() }
        return Option<CheckedInitializer>.some(CheckedInitializer {
          syntax: Anchor.hir(anchor, nodes[listed[ordinal].value.index].origin.node), index: listed[ordinal].index,
        })
      }
      if let CheckedNodeKind.Expression {form: CheckedExpression.VariantConstruct {fields, ..}, ..} = &nodes[at].kind {
        let listed = List<CheckedAggregateField>.asSlice(&fields)
        if ordinal >= listed.length || listed[ordinal].value.index >= nodes.length { return Option<CheckedInitializer>.none() }
        return Option<CheckedInitializer>.some(CheckedInitializer {
          syntax: Anchor.hir(anchor, nodes[listed[ordinal].value.index].origin.node), index: listed[ordinal].index,
        })
      }
    }
    next = next + usize.ONE
  }
  return Option<CheckedInitializer>.none()
}

// The declaration-order tag of the nominal union variant a checked body constructs at `id`, if
// `id` is a variant construction.
fn checkedVariantTag<'source>(machine: &Machine<'source>, id: HirId) -> Option<usize> {
  let window = checkedRange(machine)
  let index = checkedNodes(machine)
  let anchor = match move checkedAnchor(machine) {
    Option<Anchor>.Some {value} => move value
    Option<Anchor>.None => { return Option<usize>.none() }
  }
  return match move checkedBodyForExpression(machine) {
    Option<Shared<TypedBody>>.Some {value: body} => Shared<TypedBody>.with<Option<usize>>(&body, fn(checked: &TypedBody) -> Option<usize> {
      let nodes = TypedBody.nodeSlice(checked)
      let found = recorded(index, &anchor, id)
      let candidates = List<usize>.asSlice(&index.positions)
      let mut next = found.start
      while next < found.start + found.length {
        let at = candidates[next]
        if at >= window.start && at - window.start < window.length {
          if let CheckedNodeKind.Expression {form: CheckedExpression.VariantConstruct {tag, ..}, ..} = &nodes[at].kind {
            return Option<usize>.some(tag)
          }
        }
        next = next + usize.ONE
      }
      return Option<usize>.none()
    })
    Option<Shared<TypedBody>>.None => Option<usize>.none()
  }
}

// Constructs one struct literal (STATIC-005): initializers run in authored order, the value keeps
// declaration field order, and a nominal that any sealed Drop names is refused.
effect fn structValue<'source>(machine: &mut Machine<'source>, local: &mut List<Local>, id: HirId, span: Span) -> Interned<StaticData> ! Diagnostic | OutOfMemoryError ? &mut Allocator | &mut Types {
  let annotated = match move checkedExpressionType(&machine.*, id) {
    Option<Interned<SemanticType>>.Some {value} => move value
    Option<Interned<SemanticType>>.None => { return run reject(&machine.*, Fault.Unavailable, span) }
  }
  // The literal's type is written in the executing body's binders, as `G<V> {..}` in a generic
  // static fn; the value carries the type its application closes.
  let ty = run closeType(&machine.*, &annotated)
  let initializers = match move run checkedInitializers(&machine.*, id) {
    Option<List<CheckedInitializer>>.Some {value} => move value
    Option<List<CheckedInitializer>>.None => { return run reject(&machine.*, Fault.Unsupported, span) }
  }
  let copied = run SemanticType.copy(&ty)
  let declaration = match move copied {
    SemanticType.Nominal {declaration, ..} => move declaration
    _ => { return run reject(&machine.*, Fault.Unsupported, span) }
  }
  let written = List<CheckedInitializer>.asSlice(&initializers)
  let mut values = run List<Interned<StaticData>>.makeWithCapacity(written.length)
  let mut at = usize.ZERO
  while at < written.length {
    run List<Interned<StaticData>>.append(&mut values, run expression(&mut machine.*, &mut local.*, written[at].syntax))
    at = at + usize.ONE
  }
  let demanded = run Effect.result(StaticPort.declaresDrop(&mut machine.port, &declaration, span))
  let dropping = match move demanded {
    Result<bool, Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError>.Success {value} => value
    Result<bool, Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError>.Failure {error} => match move error {
      OutOfMemoryError {} => { fail OutOfMemoryError {} }
      Cycle {} => run reject(&machine.*, Fault.Cycle, span)
      InvalidModulePath {} => run reject(&machine.*, Fault.Unavailable, span)
      RevisionMismatch {} => run reject(&machine.*, Fault.Unavailable, span)
    }
  }
  if dropping { return run reject(&machine.*, Fault.StaticPhaseViolation, span) }
  let evaluated = List<Interned<StaticData>>.asSlice(&values)
  let mut ordered = List<Interned<StaticData>>.make()
  let mut slot = usize.ZERO
  while slot < written.length {
    let mut found = written.length
    let mut search = usize.ZERO
    while search < written.length {
      if written[search].index == slot { found = search }
      search = search + usize.ONE
    }
    if found == written.length { return run reject(&machine.*, Fault.Unsupported, span) }
    run List<Interned<StaticData>>.append(&mut ordered, Interned<StaticData>.clone(&evaluated[found]))
    slot = slot + usize.ONE
  }
  // A variant of a nominal union keeps its declaration-order tag (STATIC-005).
  if let Option<usize>.Some {value: tag} = move checkedVariantTag(&machine.*, id) {
    return match move StaticValue.cleanupFreeVariant(move ty, tag, move ordered) {
      Option<StaticData>.Some {value} => run retain(&mut machine.*, move value, span)
      Option<StaticData>.None => run reject(&machine.*, Fault.Unsupported, span)
    }
  }
  return match move StaticValue.cleanupFreeStruct(move ty, move ordered) {
    Option<StaticData>.Some {value} => run retain(&mut machine.*, move value, span)
    Option<StaticData>.None => run reject(&machine.*, Fault.Unsupported, span)
  }
}

// A member expression constructs the union variant it selects.
effect fn memberValue<'source>(machine: &mut Machine<'source>, local: &mut List<Local>, id: HirId, span: Span) -> Interned<StaticData> ! Diagnostic | OutOfMemoryError ? &mut Allocator | &mut Types {
  if let Option<usize>.Some {..} = move checkedVariantTag(&machine.*, id) {
    return run structValue(&mut machine.*, &mut local.*, id, span)
  }
  return run reject(&machine.*, Fault.Unsupported, span)
}

// Constructs the static value of a checked scalar-enum member, keeping its nominal identity.
effect fn enumValue<'source>(machine: &mut Machine<'source>, id: HirId, member: CheckedEnumMember, span: Span) -> Interned<StaticData> ! Diagnostic | OutOfMemoryError ? &mut Allocator | &mut Types {
  let ty = match move checkedExpressionType(&machine.*, id) {
    Option<Interned<SemanticType>>.Some {value} => move value
    Option<Interned<SemanticType>>.None => { return run reject(&machine.*, Fault.Unavailable, span) }
  }
  let copied = run SemanticType.copy(&ty)
  let declaration = match move copied {
    SemanticType.Nominal {declaration, ..} => run Types.internDeclaration(move declaration)
    _ => { return run reject(&machine.*, Fault.InvalidValue, span) }
  }
  let mut sign = StaticSign.Positive
  if member.negative { sign = StaticSign.Negative }
  let value = match move StaticValue.enumeration(move declaration, member.ordinal, member.representation, sign, member.magnitude) {
    Option<StaticData>.Some {value: built} => move built
    Option<StaticData>.None => { return run reject(&machine.*, Fault.InvalidValue, span) }
  }
  return run retain(&mut machine.*, move value, span)
}

fn checkedConstantDeclaration<'source>(machine: &Machine<'source>, id: HirId) -> Option<Interned<DeclarationId>> {
  let window = checkedRange(machine)
  let index = checkedNodes(machine)
  let anchor = match move checkedAnchor(machine) {
    Option<Anchor>.Some {value} => move value
    Option<Anchor>.None => { return Option<Interned<DeclarationId>>.none() }
  }
  return match move checkedBodyForExpression(machine) {
    Option<Shared<TypedBody>>.Some {value: body} => Shared<TypedBody>.with<Option<Interned<DeclarationId>>>(
      &body,
      fn(body: &TypedBody) -> Option<Interned<DeclarationId>> {
        let nodes = TypedBody.nodeSlice(body)
        let found = recorded(index, &anchor, id)
        let candidates = List<usize>.asSlice(&index.positions)
        let mut next = found.start
        while next < found.start + found.length {
          let at = candidates[next]
          if at >= window.start && at - window.start < window.length {
            if let CheckedNodeKind.Expression {form: CheckedExpression.Constant {declaration}, ..} = &nodes[at].kind {
              return Option<Interned<DeclarationId>>.some(Interned<DeclarationId>.clone(&declaration))
            }
          }
          next = next + usize.ONE
        }
        return Option<Interned<DeclarationId>>.none()
      },
    )
    Option<Shared<TypedBody>>.None => Option<Interned<DeclarationId>>.none()
  }
}

fn checkedIntegerType<'source>(machine: &Machine<'source>, id: HirId) -> Option<StaticIntegerType> {
  return match move checkedExpressionType(machine, id) {
    Option<Interned<SemanticType>>.Some {value: ty} => Interned<SemanticType>.with<Option<StaticIntegerType>>(
      &ty,
      fn(value: &SemanticType) -> Option<StaticIntegerType> {
        if let SemanticType.Primitive {name: spelling} = &value.* {
          return integerType(Bytes.asSlice(&spelling))
        }
        return Option<StaticIntegerType>.none()
      },
    )
    Option<Interned<SemanticType>>.None => Option<StaticIntegerType>.none()
  }
}

fn checkedFloatType<'source>(machine: &Machine<'source>, id: HirId) -> Option<StaticFloatType> {
  return match move checkedExpressionType(machine, id) {
    Option<Interned<SemanticType>>.Some {value: ty} => Interned<SemanticType>.with<Option<StaticFloatType>>(
      &ty,
      fn(value: &SemanticType) -> Option<StaticFloatType> {
        if let SemanticType.Primitive {name: spelling} = &value.* {
          let written = Bytes.asSlice(&spelling)
          if equal(written, b"f32") { return Option<StaticFloatType>.some(StaticFloatType.F32) }
          if equal(written, b"f64") { return Option<StaticFloatType>.some(StaticFloatType.F64) }
        }
        return Option<StaticFloatType>.none()
      },
    )
    Option<Interned<SemanticType>>.None => Option<StaticFloatType>.none()
  }
}

// Closes a declared parameter or result type with the selected application's owner-qualified
// bindings at every depth. A type left open is not a declared runtime-closed type.
effect fn appliedDeclaredType(declared: &Interned<SemanticType>, application: &Application) -> Option<Interned<SemanticType>>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let bindings = run Application.bindings(application)
  let applied = run SemanticType.applyBindings(declared, List<TypeBinding>.asSlice(&bindings), true)
  if SemanticType.hasOpenRuntimeParameters(&applied) { return Option<Interned<SemanticType>>.none() }
  return Option<Interned<SemanticType>>.some(move applied)
}

fn parameterTypeAt(parameters: &[Interned<SemanticType>], ordinal: usize) -> Option<Interned<SemanticType>> {
  if ordinal < parameters.length {
    return Option<Interned<SemanticType>>.some(Interned<SemanticType>.clone(&parameters[ordinal]))
  }
  return Option<Interned<SemanticType>>.none()
}

fn signatureType(answer: &Result<Answer, NoRejection>, parameter: Option<usize>) -> Option<Interned<SemanticType>> {
  return match &answer.* {
    Result<Answer, NoRejection>.Success {value} => match &value.outcome {
      Outcome.Success {value: Value.Signature {signature: signatureBox}} => match move parameter {
        Option<usize>.Some {value: ordinal} => {
          let parameters = List<Interned<SemanticType>>.asSlice(&Value.signatureOf(&signatureBox).parameters)
          return parameterTypeAt(parameters, ordinal)
        }
        Option<usize>.None => Option<Interned<SemanticType>>.some(Interned<SemanticType>.clone(&Value.signatureOf(&signatureBox).result))
      }
      _ => Option<Interned<SemanticType>>.none()
    }
    Result<Answer, NoRejection>.Failure {..} => Option<Interned<SemanticType>>.none()
  }
}

// A method's signature also counts the parameters of its enclosing implementation, which the
// application binds in its scopes.
fn signatureApplicationArityMatches(answer: &Result<Answer, NoRejection>, application: &Application, operation: bool) -> bool {
  let own = List<Argument>.length(&application.arguments)
  let ordinals = List<usize>.asSlice(&application.argumentOrdinals)
  if ordinals.length != own { return false }
  let mut at = usize.ZERO
  while at < ordinals.length {
    if ordinals[at] != at { return false }
    at = at + usize.ONE
  }
  let mut count = own
  let scopes = List<ScopeBinding>.asSlice(&application.scopes)
  at = usize.ZERO
  while at < scopes.length {
    count = count + List<Argument>.length(&scopes[at].arguments)
    at = at + usize.ONE
  }
  // An interface operation's default body binds the interface's `Self` in its innermost scope.
  if operation {
    if count == usize.ZERO { return false }
    count = count - usize.ONE
  }
  return match &answer.* {
    Result<Answer, NoRejection>.Success {value} => match &value.outcome {
      Outcome.Success {value: Value.Signature {signature: signatureBox}} => count ==
        List<Interned<SemanticType>>.length(&Value.signatureOf(&signatureBox).typeParameters) +
        List<Interned<Lifetime>>.length(&Value.signatureOf(&signatureBox).lifetimeParameters) +
        List<RowParameter>.length(&Value.signatureOf(&signatureBox).rowParameters)
      _ => false
    }
    Result<Answer, NoRejection>.Failure {..} => false
  }
}

fn rootLifetimeArgumentCount(answer: &Result<Answer, NoRejection>) -> Option<usize> {
  return match &answer.* {
    Result<Answer, NoRejection>.Success {value} => match &value.outcome {
      Outcome.Success {value: Value.Signature {signature: signatureBox}} => {
        let signature = Value.signatureOf(&signatureBox)
        if List<Interned<SemanticType>>.length(&signature.typeParameters) != usize.ZERO ||
          List<RowParameter>.length(&signature.rowParameters) != usize.ZERO {
          return Option<usize>.none()
        }
        return Option<usize>.some(List<Interned<Lifetime>>.length(&signature.lifetimeParameters))
      }
      _ => Option<usize>.none()
    }
    Result<Answer, NoRejection>.Failure {..} => Option<usize>.none()
  }
}

effect fn selectedSignatureType(
  answer: &Shared<Result<Answer, NoRejection>>,
  parameter: Option<usize>,
  application: &Application,
) -> Option<Interned<SemanticType>> ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let declared = Shared<Result<Answer, NoRejection>>.with<Option<Interned<SemanticType>>>(
    answer,
    fn(value: &Result<Answer, NoRejection>) -> Option<Interned<SemanticType>> {
      return signatureType(value, move parameter)
    },
  )
  return match move declared {
    Option<Interned<SemanticType>>.Some {value} => run appliedDeclaredType(&value, application)
    Option<Interned<SemanticType>>.None => Option<Interned<SemanticType>>.none()
  }
}

/// The value of the decimal `digits` of an integer literal's magnitude, or absence past `u64`.
pub fn parseMagnitude(digits: &[u8]) -> Option<u64> {
  let mut value: u64 = 0
  let mut at = usize.ZERO
  while at < digits.length {
    let digit = digits[at]
    if digit < 48 || digit > 57 {
      return Option<u64>.none()
    }
    let scaled = match move u64.checkedMultiply(value, 10) {
      Option<u64>.Some {value: next} => next
      Option<u64>.None => {
        return Option<u64>.none()
      }
    }
    value = match move u64.checkedAdd(scaled, u8.toU64(digit - 48)) {
      Option<u64>.Some {value: next} => next
      Option<u64>.None => {
        return Option<u64>.none()
      }
    }
    at = at + usize.ONE
  }
  return Option<u64>.some(value)
}

fn boolean(value: &StaticData) -> Option<bool> {
  return match & value.* {
    StaticData.Boolean {value: selected} => Option<bool>.some(selected)
    _ => Option<bool>.none()
  }
}

effect fn evaluatedBoolean<'source>(
  machine: &mut Machine<'source>,
  local: &mut List<Local>,
  id: HirId,
) -> bool ! Diagnostic | OutOfMemoryError ? &mut Allocator | &mut Types {
  let value = run expression(&mut machine.*, &mut local.*, id)
  let selected = Interned<StaticData>.with<Option<bool>>(&value, boolean)
  return match move selected {
    Option<bool>.Some {value: chosen} => chosen
    Option<bool>.None => run reject(
      &machine.*,
      Fault.InvalidValue,
      Module.span(run authored(&machine.*), id),
    )
  }
}

effect fn integerExpression<'source>(
  machine: &mut Machine<'source>,
  id: HirId,
) -> Interned<StaticData> ! Diagnostic | OutOfMemoryError ? &mut Allocator {
  let span = Module.span(run authored(&machine.*), id)
  if let Node.IntegerLiteral {sign, magnitude, suffix, ..} = Module.node(run authored(&machine.*), id) {
    let digits = Module.text(run authored(&machine.*), magnitude)
    let number = match move parseMagnitude(digits) {
      Option<u64>.Some {value} => value
      Option<u64>.None => {
        return run reject(&machine.*, Fault.InvalidValue, span)
      }
    }
    let ty = match move checkedIntegerType(&machine.*, id) {
      Option<StaticIntegerType>.Some {value: checked} => checked
      Option<StaticIntegerType>.None => {
        let mut failure = run diagnostic(&machine.*, Fault.Unsupported, span)
        failure.missing = Option<MissingFact>.some(MissingFact.CheckedExpression)
        fail move failure
      }
    }
    if suffix.present {
      let written = match move integerType(Module.text(run authored(&machine.*), suffix.symbol)) {
        Option<StaticIntegerType>.Some {value} => value
        Option<StaticIntegerType>.None => {
          return run reject(&machine.*, Fault.InvalidValue, span)
        }
      }
      if written != ty {
        return run reject(&machine.*, Fault.InvalidValue, span)
      }
    }
    let mut signed = StaticSign.Positive
    if sign == Sign.Negative {
      signed = StaticSign.Negative
    }
    let selected = match move StaticValue.integer(ty, signed, number, machine.target.pointerBits()) {
      Option<StaticData>.Some {value} => move value
      Option<StaticData>.None => {
        return run reject(&machine.*, Fault.InvalidValue, span)
      }
    }
    return run retain(&mut machine.*, move selected, span)
  }
  return run reject(&machine.*, Fault.InvalidValue, span)
}

effect fn applyInfix<'source>(
  machine: &mut Machine<'source>,
  operator: InfixOperator,
  operatorAnchor: Span,
  span: Span,
  first: &Interned<StaticData>,
  second: &Interned<StaticData>,
) -> Interned<StaticData> ! Diagnostic | OutOfMemoryError ? &mut Allocator {
  let result = StaticValue.infixShared(operator, first, second, machine.target.pointerBits())
  return match move result {
    Result<StaticData, StaticFault>.Success {value: selected} => run retain(
      &mut machine.*,
      move selected,
      span,
    )
    Result<StaticData, StaticFault>.Failure {error} => run rejectScalar(
      &machine.*,
      move error,
      operatorAnchor,
      span,
    )
  }
}

effect fn expression<'source>(machine: &mut Machine<'source>, local: &mut List<Local>, id: HirId) -> Interned<StaticData> ! Diagnostic | OutOfMemoryError ? &mut Allocator | &mut Types {
  let span = Module.span(run authored(&machine.*), id)
  let checked = match move checkedExpressionType(&machine.*, id) {
    Option<Interned<SemanticType>>.Some {value} => move value
    Option<Interned<SemanticType>>.None => {
      let mut failure = run diagnostic(&machine.*, Fault.Unsupported, span)
      failure.missing = Option<MissingFact>.some(MissingFact.CheckedExpression)
      fail move failure
    }
  }
  let mut value = run expressionFromSource(&mut machine.*, &mut local.*, id)
  let mut sliceChecked = Option<Interned<SemanticType>>.none()
  // Typing turns a borrowed array into a slice where the context asks for one; a view read
  // there takes that slice type, so its type always says how it is laid out.
  if let Option<Interned<StaticData>>.Some {value: target} = move Interned<StaticData>.with<Option<Interned<StaticData>>>(&value, StaticValue.borrowTarget) {
    if let Option<Interned<SemanticType>>.Some {value: sliceType} = move checkedSliceType(&machine.*, id) {
      sliceChecked = Option<Interned<SemanticType>>.some(Interned<SemanticType>.clone(&sliceType))
      let isReference = Interned<StaticData>.with<bool>(&value, fn(data: &StaticData) -> bool {
        return match &data.* {
          StaticData.Borrow {ty, ..} => Interned<SemanticType>.with<bool>(&ty, fn(shape: &SemanticType) -> bool {
            return match &shape.* { SemanticType.Reference {..} => true _ => false }
          })
          _ => false
        }
      })
      if isReference {
        let closedSlice = run closeType(&machine.*, &sliceType)
        let canonical = run staticViewType(&closedSlice)
        value = run retain(&mut machine.*, StaticData.Borrow {ty: move canonical, target: move target}, span)
      }
    }
  }
  // A view read as a slice is admitted at that slice type.
  let mut admitted = move checked
  if let Option<Interned<SemanticType>>.Some {value: sliceType} = move sliceChecked { admitted = move sliceType }
  // The checked type is written in the executing body's binders; close it with that body's
  // application before admitting the value.
  let closed = run closeType(&machine.*, &admitted)
  let valid = Interned<SemanticType>.with<Option<bool>>(&closed, fn(ty: &SemanticType) -> Option<bool> {
    return checkedValueType(ty, &value)
  })
  match move valid {
    Option<bool>.Some {value: accepted} => {
      if !accepted {
        return run reject(&machine.*, Fault.InvalidValue, span)
      }
      return move value
    }
    Option<bool>.None => {
      if !SemanticType.hasOpenRuntimeParameters(&closed) && run StaticValue.matchesType(&value, &closed) {
        return move value
      }
      // A function value's type may keep the binders its target opens at each call.
      if Interned<StaticData>.with<bool>(&value, StaticValue.isCallable) && run StaticValue.matchesType(&value, &closed) {
        return move value
      }
      let mut failure = run diagnostic(&machine.*, Fault.Unsupported, span)
      failure.missing = Option<MissingFact>.some(MissingFact.DeclaredType)
      fail move failure
    }
  }
}

// Copies the checked direct-call application selected at this call expression.
// A reached call's callee: its checked direct application, or for a `static` interface operation
// the witness that the executing frame's provider selects.
effect fn selectedCall<'source>(machine: &mut Machine<'source>, id: HirId, span: Span) -> Option<StaticCall>
! Diagnostic | OutOfMemoryError
? &mut Allocator | &mut Types {
  let checked = match move checkedBodyForExpression(&machine.*) {
    Option<Shared<TypedBody>>.Some {value} => move value
    Option<Shared<TypedBody>>.None => {
      let mut failure = run diagnostic(&machine.*, Fault.Unsupported, span)
      failure.missing = Option<MissingFact>.some(MissingFact.CheckedBody)
      fail move failure
    }
  }
  let window = checkedRange(&machine.*)
  let direct = run Effect.result(StaticPort.copyDirectCall(&mut machine.port, &checked, id, window))
  match move direct {
    Result<Option<StaticCall>, Cycle | InvalidModulePath | OutOfMemoryError>.Success {value} => {
      if let Option<StaticCall>.Some {value: selected} = move value { return Option<StaticCall>.some(move selected) }
    }
    Result<Option<StaticCall>, Cycle | InvalidModulePath | OutOfMemoryError>.Failure {error} => match move error {
      OutOfMemoryError {} => { fail OutOfMemoryError {} }
      Cycle {} => run reject(&machine.*, Fault.Cycle, span)
      InvalidModulePath {} => run reject(&machine.*, Fault.Unavailable, span)
    }
  }
  let bindings = run closingBindings(&machine.*)
  let witnessed = run Effect.result(StaticPort.copyInterfaceCall(&mut machine.port, &checked, id, window,
    List<TypeBinding>.asSlice(&bindings), span))
  match move witnessed {
    Result<Option<Application>, Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError>.Success {value} => {
      if let Option<Application>.Some {value: witness} = move value {
        return Option<StaticCall>.some(StaticCall {application: move witness, receiver: false})
      }
    }
    Result<Option<Application>, Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError>.Failure {error} => match move error {
      OutOfMemoryError {} => { fail OutOfMemoryError {} }
      Cycle {} => run reject(&machine.*, Fault.Cycle, span)
      InvalidModulePath {} => run reject(&machine.*, Fault.Unavailable, span)
      RevisionMismatch {} => run reject(&machine.*, Fault.Unavailable, span)
    }
  }
  return Option<StaticCall>.none()
}

// The bindings of the application whose body is executing: the top frame's, else the root's.
effect fn closingBindings<'source>(machine: &Machine<'source>) -> List<TypeBinding> ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let frames = List<Frame>.asSlice(&machine.active)
  if frames.length > usize.ZERO { return run Application.bindings(&frames[frames.length - usize.ONE].instance) }
  if let Option<Application>.Some {value: root} = &machine.instance { return run Application.bindings(&root) }
  return List<TypeBinding>.make()
}

effect fn callExpression<'source>(
  machine: &mut Machine<'source>,
  local: &mut List<Local>,
  id: HirId,
  arguments: CallArguments,
  span: Span,
) -> Interned<StaticData> ! Diagnostic | OutOfMemoryError ? &mut Allocator | &mut Types {
  if let Option<IntrinsicMember>.Some {value: member} = move checkedIntrinsicMember(&machine.*, id) {
    return run dispatchIntrinsic(&mut machine.*, member, id, arguments, &mut local.*, span)
  }
  let call = match move run selectedCall(&mut machine.*, id, span) {
    Option<StaticCall>.Some {value} => move value
    Option<StaticCall>.None => {
      if let Option<StaticCallable>.Some {value: form} = move run checkedCallable(&mut machine.*, id, span) {
        return run callableExpression(&mut machine.*, &mut local.*, id, arguments, span, move form)
      }
      // A positional aggregate, as `Pair(1, 2)`, is a construction written as a call.
      if let Option<List<CheckedInitializer>>.Some {..} = move run checkedInitializers(&machine.*, id) {
        return run structValue(&mut machine.*, &mut local.*, id, span)
      }
      let mut failure = run diagnostic(&machine.*, Fault.Unsupported, span)
      failure.missing = Option<MissingFact>.some(MissingFact.TypedApplication)
      fail move failure
    }
  }
  let selectedName = run DeclarationId.copySpelling(Application.bodyDeclaration(&call.application))
  let application = run closeCall(&machine.*, move call.application)
  let mut values = List<Interned<StaticData>>.make()
  // A receiver call's subject, `value` in `value.member(rest)`, is its first argument.
  if call.receiver {
    if let Node.CallExpression {callee, ..} = Module.node(run authored(&machine.*), id) {
      if let Node.FieldExpression {subject, ..} = Module.node(run authored(&machine.*), callee) {
        run List<Interned<StaticData>>.append(&mut values, run expression(&mut machine.*, &mut local.*, subject))
      }
    }
  }
  let mut at = usize.ZERO
  while at < CallArguments.length(arguments) {
    let hir = run authored(&machine.*)
    let argument = CallArguments.child(arguments, hir, at)
    run List<Interned<StaticData>>.append(
      &mut values,
      run expression(&mut machine.*, &mut local.*, argument),
    )
    at = at + usize.ONE
  }
  return run demandApplication(
    &mut machine.*, &application, Bytes.asSlice(&selectedName),
    List<Interned<StaticData>>.asSlice(&values), span,
  )
}

// The function value form the checker gave `id`, if any (STATIC-005).
effect fn checkedCallable<'source>(machine: &mut Machine<'source>, id: HirId, span: Span) -> Option<StaticCallable>
! Diagnostic | OutOfMemoryError ? &mut Allocator {
  let checked = match move checkedBodyForExpression(&machine.*) {
    Option<Shared<TypedBody>>.Some {value} => move value
    Option<Shared<TypedBody>>.None => { return Option<StaticCallable>.none() }
  }
  let window = checkedRange(&machine.*)
  let found = run Effect.result(StaticPort.copyStaticCallable(&mut machine.port, &checked, id, window))
  return match move found {
    Result<Option<StaticCallable>, Cycle | InvalidModulePath | OutOfMemoryError>.Success {value} => move value
    Result<Option<StaticCallable>, Cycle | InvalidModulePath | OutOfMemoryError>.Failure {error} => match move error {
      OutOfMemoryError {} => { fail OutOfMemoryError {} }
      Cycle {} => run reject(&machine.*, Fault.Cycle, span)
      InvalidModulePath {} => run reject(&machine.*, Fault.Unavailable, span)
    }
  }
}

// Evaluates the written operands of the call `id`, in order, the pipeline input first.
effect fn callOperands<'source>(machine: &mut Machine<'source>, local: &mut List<Local>, arguments: CallArguments)
-> List<Interned<StaticData>> ! Diagnostic | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut values = List<Interned<StaticData>>.make()
  let mut at = usize.ZERO
  while at < CallArguments.length(arguments) {
    let hir = run authored(&machine.*)
    let argument = CallArguments.child(arguments, hir, at)
    run List<Interned<StaticData>>.append(&mut values, run expression(&mut machine.*, &mut local.*, argument))
    at = at + usize.ONE
  }
  return move values
}

// A function value expression (STATIC-005): a named function or a partial application of one
// becomes a `Callable` holding its operands; a call through a function value supplies its open
// leading parameters, invoking the target once none stay open.
effect fn callableExpression<'source>(machine: &mut Machine<'source>, local: &mut List<Local>, id: HirId,
  arguments: CallArguments, span: Span, form: StaticCallable) -> Interned<StaticData>
! Diagnostic | OutOfMemoryError ? &mut Allocator | &mut Types {
  match move form {
    StaticCallable.Section {ty, first} => {
      let captured = run callOperands(&mut machine.*, &mut local.*, arguments)
      let closed = run closeType(&machine.*, &ty)
      return run retain(&mut machine.*, StaticData.Callable {ty: move closed, first: first, captured: move captured}, span)
    }
    StaticCallable.Through => {
      let callee = match move CallInput.ofNode(Module.node(run authored(&machine.*), id)) {
        Option<CallInput>.Some {value} => value.callee
        Option<CallInput>.None => { return run reject(&machine.*, Fault.Unavailable, span) }
      }
      let pipeline = match Module.node(run authored(&machine.*), id) {
        Node.PipelineExpression {..} => true
        _ => false
      }
      // A pipeline finishes its input before it evaluates the function value it calls.
      let mut supplied = List<Interned<StaticData>>.make()
      if pipeline { supplied = run callOperands(&mut machine.*, &mut local.*, arguments) }
      let target = run expression(&mut machine.*, &mut local.*, callee)
      if !pipeline { supplied = run callOperands(&mut machine.*, &mut local.*, arguments) }
      return run applyCallable(&mut machine.*, &target, move supplied, span)
    }
  }
}

// Supplies `supplied` to the open leading parameters of the function value `target`. With
// parameters still open the result is a function value again; otherwise the target runs on every
// argument, the supplied ones first and then the captured ones.
effect fn applyCallable<'source>(machine: &mut Machine<'source>, target: &Interned<StaticData>, supplied: List<Interned<StaticData>>,
  span: Span) -> Interned<StaticData>
! Diagnostic | OutOfMemoryError ? &mut Allocator | &mut Types {
  let selected = Interned<StaticData>.with<Option<Interned<SemanticType>>>(target, callableTargetType)
  let ty = match move selected {
    Option<Interned<SemanticType>>.Some {value} => move value
    Option<Interned<SemanticType>>.None => { return run reject(&machine.*, Fault.InvalidValue, span) }
  }
  let first = Interned<StaticData>.with<usize>(target, callableOpen)
  let count = List<Interned<StaticData>>.length(&supplied)
  if count > first { return run reject(&machine.*, Fault.InvalidValue, span) }
  let mut arguments = move supplied
  let captured = Interned<StaticData>.with<usize>(target, StaticValue.childCount)
  let mut at = usize.ZERO
  while at < captured {
    run List<Interned<StaticData>>.append(&mut arguments, Interned<StaticData>.with<Interned<StaticData>>(target,
      fn(value: &StaticData) -> Interned<StaticData> { return StaticValue.childAt(value, at) }))
    at = at + usize.ONE
  }
  if count < first {
    return run retain(&mut machine.*, StaticData.Callable {ty: move ty, first: first - count, captured: move arguments}, span)
  }
  let application = Interned<SemanticType>.with<Option<Interned<Application>>>(&ty, fn(value: &SemanticType) -> Option<Interned<Application>> {
    return match &value.* {
      SemanticType.CallableValue {application, ..} => Option<Interned<Application>>.some(Interned<Application>.clone(&application))
      _ => Option<Interned<Application>>.none()
    }
  })
  let named = match move application {
    Option<Interned<Application>>.Some {value} => run Application.copyShared(&value)
    Option<Interned<Application>>.None => {
      // A generic function's section opens its binders at each use, which static evaluation does
      // not do yet.
      let mut failure = run diagnostic(&machine.*, Fault.InvalidValue, span)
      failure.message = Option<Bytes>.some(run Bytes.copy(b"a generic function value whose type arguments are not fixed cannot be evaluated; call it with every argument"))
      fail move failure
    }
  }
  let closed = run closeCall(&machine.*, move named)
  let selectedName = run DeclarationId.copySpelling(Application.bodyDeclaration(&closed))
  return run demandApplication(&mut machine.*, &closed, Bytes.asSlice(&selectedName),
    List<Interned<StaticData>>.asSlice(&arguments), span)
}

// The contract of a function value's named section, which lists every parameter the section
// left open when it was named.
fn callableContract(value: &StaticData) -> Option<Interned<SemanticType>> {
  if let StaticData.Callable {ty, ..} = &value.* {
    return Interned<SemanticType>.with<Option<Interned<SemanticType>>>(&ty, fn(named: &SemanticType) -> Option<Interned<SemanticType>> {
      return match &named.* {
        SemanticType.CallableValue {contract, ..} => Option<Interned<SemanticType>>.some(Interned<SemanticType>.clone(&contract))
        SemanticType.CallableSchema {schema, ..} => Option<Interned<SemanticType>>.some(Frozen<CallableSchema>.with<Interned<SemanticType>>(&schema,
          fn(held: &CallableSchema) -> Interned<SemanticType> { return Interned<SemanticType>.clone(&held.contract) }))
        _ => Option<Interned<SemanticType>>.none()
      }
    })
  }
  return Option<Interned<SemanticType>>.none()
}

fn contractParameterCount(contract: &SemanticType) -> usize {
  return match &contract.* {
    SemanticType.Callable {parameters, ..} => List<Interned<SemanticType>>.length(&parameters)
    _ => usize.MAX
  }
}

fn contractParameter(contract: &SemanticType, at: usize) -> Option<Interned<SemanticType>> {
  if let SemanticType.Callable {parameters, ..} = &contract.* {
    let listed = List<Interned<SemanticType>>.asSlice(&parameters)
    if at < listed.length {return Option<Interned<SemanticType>>.some(Interned<SemanticType>.clone(&listed[at]))}
  }
  return Option<Interned<SemanticType>>.none()
}

fn contractResult(contract: &SemanticType) -> Option<Interned<SemanticType>> {
  return match &contract.* {
    SemanticType.Callable {result, ..} => Option<Interned<SemanticType>>.some(Interned<SemanticType>.clone(&result))
    _ => Option<Interned<SemanticType>>.none()
  }
}

// A borrowed view at one level: its access and what it views, or none for any other type.
struct View {
  access: Access,
  viewed: Interned<SemanticType>,
  slice: bool,
}

fn viewOf(ty: &SemanticType) -> Option<View> {
  return match &ty.* {
    SemanticType.Reference {referent, access, ..} => Option<View>.some(View {access: access, viewed: Interned<SemanticType>.clone(&referent), slice: false})
    SemanticType.Slice {element, access, ..} => Option<View>.some(View {access: access, viewed: Interned<SemanticType>.clone(&element), slice: true})
    SemanticType.String {..} => Option<View>.none()
    _ => Option<View>.none()
  }
}

// Whether two types have the same representation whatever regions their views name: a contract's
// elided reference parameter is its own invocation's region, and a named function's is its own.
effect fn sameRepresentation(left: &Interned<SemanticType>, right: &Interned<SemanticType>) -> bool
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let first = Interned<SemanticType>.with<Option<View>>(left, viewOf)
  let second = Interned<SemanticType>.with<Option<View>>(right, viewOf)
  if let Option<View>.Some {value: one} = move first {
    if let Option<View>.Some {value: other} = move second {
      return one.access == other.access && one.slice == other.slice && run sameRepresentation(&one.viewed, &other.viewed)
    }
    return false
  }
  if let Option<View>.Some {..} = move second {return false}
  let text = Interned<SemanticType>.with<bool>(left, fn(ty: &SemanticType) -> bool { return match &ty.* { SemanticType.String {..} => true _ => false } })
  if text {return Interned<SemanticType>.with<bool>(right, fn(ty: &SemanticType) -> bool { return match &ty.* { SemanticType.String {..} => true _ => false } })}
  return run SemanticType.runtimeEqualsShared(left, right)
}

// Whether calling the function value `value` takes exactly the parameters of `wanted`, a callable
// contract, and gives its result: its open leading parameters and its target's result. Lifetimes
// are compared by the call that runs it, so only representations must agree here.
effect fn callableHasContract(value: &Interned<StaticData>, wanted: &Interned<SemanticType>) -> bool
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let contract = match move Interned<StaticData>.with<Option<Interned<SemanticType>>>(value, callableContract) {
    Option<Interned<SemanticType>>.Some {value: found} => move found
    Option<Interned<SemanticType>>.None => { return false }
  }
  let open = Interned<StaticData>.with<usize>(value, callableOpen)
  let count = Interned<SemanticType>.with<usize>(wanted, contractParameterCount)
  if count != open || Interned<SemanticType>.with<usize>(&contract, contractParameterCount) < open {return false}
  let mut at = usize.ZERO
  while at < open {
    let held = Interned<SemanticType>.with<Option<Interned<SemanticType>>>(&contract, fn(listed: &SemanticType) -> Option<Interned<SemanticType>> { return contractParameter(listed, at) })
    let named = Interned<SemanticType>.with<Option<Interned<SemanticType>>>(wanted, fn(listed: &SemanticType) -> Option<Interned<SemanticType>> { return contractParameter(listed, at) })
    if let Option<Interned<SemanticType>>.Some {value: left} = move held {
      if let Option<Interned<SemanticType>>.Some {value: right} = move named {
        if !run sameRepresentation(&left, &right) {return false}
      } else {return false}
    } else {return false}
    at = at + usize.ONE
  }
  let held = Interned<SemanticType>.with<Option<Interned<SemanticType>>>(&contract, contractResult)
  let named = Interned<SemanticType>.with<Option<Interned<SemanticType>>>(wanted, contractResult)
  if let Option<Interned<SemanticType>>.Some {value: left} = move held {
    if let Option<Interned<SemanticType>>.Some {value: right} = move named {
      return run sameRepresentation(&left, &right)
    }
  }
  return false
}

fn callableTargetType(value: &StaticData) -> Option<Interned<SemanticType>> {
  return match &value.* {
    StaticData.Callable {ty, ..} => Option<Interned<SemanticType>>.some(Interned<SemanticType>.clone(&ty))
    _ => Option<Interned<SemanticType>>.none()
  }
}

fn callableOpen(value: &StaticData) -> usize {
  return match &value.* {
    StaticData.Callable {first, ..} => first
    _ => usize.ZERO
  }
}

// Reports whether `&&` or `||` is already decided by its left operand, so the right stays undemanded.
effect fn leftDecidesInfix<'source>(
  machine: &Machine<'source>,
  operator: InfixOperator,
  first: &Interned<StaticData>,
  span: Span,
) -> bool ! Diagnostic | OutOfMemoryError ? &mut Allocator {
  if operator != InfixOperator.And && operator != InfixOperator.Or {
    return false
  }
  let chosen = Interned<StaticData>.with<Option<bool>>(first, boolean)
  let firstBool = match move chosen {
    Option<bool>.Some {value} => value
    Option<bool>.None => {
      return run reject(machine, Fault.InvalidValue, span)
    }
  }
  return (operator == InfixOperator.And && !firstBool) || (operator == InfixOperator.Or && firstBool)
}

// Normalize the large authored vocabulary before effectful dispatch. A pure fallback is
// shared by all unavailable forms, so one evaluator rejection owns one failure slot.
union HotStaticExpressionInput {
  Call {arguments: CallArguments},
  PrefixExpression {operator: PrefixOperator, operatorAnchor: Span, operand: HirId},
  InfixExpression {operator: InfixOperator, operatorAnchor: Span, left: HirId, right: HirId},
}

union OtherSourceExpressionInput {
  BooleanLiteral {value: bool},
  UnitLiteral,
  CharacterLiteral {scalar: u32},
  TextLiteral {value: Symbol},
  BytesLiteral {value: Symbol},
  FloatingLiteral {spelling: Symbol},
  IntegerLiteral,
  DurationLiteral {components: Range},
  IdentifierExpression {binding: HirRef},
  FieldExpression {subject: HirId},
  MoveExpression {operand: HirId},
  StructExpression,
  ArrayExpression {elements: Range},
  ArrayRepeatExpression {value: HirId},
  CompileErrorExpression {message: HirId},
  BorrowExpression {access: Access, operand: HirId},
  ReferentExpression {subject: HirId},
  IndexExpression {subject: HirId, index: HirId},
  // A `match`, or an `if` or `if let` used as a value.
  Branching,
  // A variant qualified by its union's type arguments, as `Option<i32>.Some {value: 1}`.
  MemberExpression,
  Unavailable,
}


union StaticExpressionRoute {
  Hot {input: HotStaticExpressionInput},
  Other {input: OtherSourceExpressionInput},
}

fn sourceExpressionInput(node: Node) -> StaticExpressionRoute {
  if let Option<CallInput>.Some {value: input} = move CallInput.ofNode(node) {
    return StaticExpressionRoute.Hot {input: HotStaticExpressionInput.Call {arguments: input.arguments}}
  }
  return match node {
    Node.BooleanLiteral {value} => StaticExpressionRoute.Other {input: OtherSourceExpressionInput.BooleanLiteral {value: value}}
    Node.UnitLiteral => StaticExpressionRoute.Other {input: OtherSourceExpressionInput.UnitLiteral}
    Node.CharacterLiteral {scalar} => StaticExpressionRoute.Other {input: OtherSourceExpressionInput.CharacterLiteral {scalar: scalar}}
    Node.TextLiteral {value} => StaticExpressionRoute.Other {input: OtherSourceExpressionInput.TextLiteral {value: value}}
    Node.BytesLiteral {value} => StaticExpressionRoute.Other {input: OtherSourceExpressionInput.BytesLiteral {value: value}}
    Node.FloatingLiteral {spelling, suffix: _} => StaticExpressionRoute.Other {input: OtherSourceExpressionInput.FloatingLiteral {spelling: spelling}}
    Node.IntegerLiteral {..} => StaticExpressionRoute.Other {input: OtherSourceExpressionInput.IntegerLiteral}
    Node.DurationLiteral {components} => StaticExpressionRoute.Other {input: OtherSourceExpressionInput.DurationLiteral {components: components}}
    Node.IdentifierExpression {binding, ..} => StaticExpressionRoute.Other {input: OtherSourceExpressionInput.IdentifierExpression {binding: binding}}
    Node.FieldExpression {subject, ..} => StaticExpressionRoute.Other {input: OtherSourceExpressionInput.FieldExpression {subject: subject}}
    Node.MoveExpression {operand} => StaticExpressionRoute.Other {input: OtherSourceExpressionInput.MoveExpression {operand: operand}}
    Node.StructExpression {..} => StaticExpressionRoute.Other {input: OtherSourceExpressionInput.StructExpression}
    Node.TupleExpression {..} => StaticExpressionRoute.Other {input: OtherSourceExpressionInput.StructExpression}
    Node.OrdinalExpression {subject, ..} => StaticExpressionRoute.Other {input: OtherSourceExpressionInput.FieldExpression {subject: subject}}
    Node.ArrayExpression {elements} => StaticExpressionRoute.Other {input: OtherSourceExpressionInput.ArrayExpression {elements: elements}}
    Node.ArrayRepeatExpression {value, ..} => StaticExpressionRoute.Other {input: OtherSourceExpressionInput.ArrayRepeatExpression {value: value}}
    Node.CompileErrorExpression {message} => StaticExpressionRoute.Other {input: OtherSourceExpressionInput.CompileErrorExpression {message: message}}
    Node.BorrowExpression {access, operand} => StaticExpressionRoute.Other {input: OtherSourceExpressionInput.BorrowExpression {access: access, operand: operand}}
    Node.ReferentExpression {subject} => StaticExpressionRoute.Other {input: OtherSourceExpressionInput.ReferentExpression {subject: subject}}
    Node.IndexExpression {subject, index} => StaticExpressionRoute.Other {input: OtherSourceExpressionInput.IndexExpression {subject: subject, index: index}}
    Node.MatchExpression {..} => StaticExpressionRoute.Other {input: OtherSourceExpressionInput.Branching}
    Node.MemberExpression {..} => StaticExpressionRoute.Other {input: OtherSourceExpressionInput.MemberExpression}
    Node.ConditionalStatement {..} => StaticExpressionRoute.Other {input: OtherSourceExpressionInput.Branching}
    Node.PatternConditionalStatement {..} => StaticExpressionRoute.Other {input: OtherSourceExpressionInput.Branching}
    Node.PrefixExpression {operator, operatorAnchor, operand} => StaticExpressionRoute.Hot {input: HotStaticExpressionInput.PrefixExpression {operator: operator, operatorAnchor: operatorAnchor, operand: operand}}
    Node.InfixExpression {operator, operatorAnchor, left, right} => StaticExpressionRoute.Hot {input: HotStaticExpressionInput.InfixExpression {operator: operator, operatorAnchor: operatorAnchor, left: left, right: right}}
    _ => StaticExpressionRoute.Other {input: OtherSourceExpressionInput.Unavailable}
  }
}

effect fn expressionFromSource<'source>(machine: &mut Machine<'source>, local: &mut List<Local>, id: HirId) -> Interned<StaticData> ! Diagnostic | OutOfMemoryError ? &mut Allocator | &mut Types {
  run step(&mut machine.*, id)
  let node = Module.node(run authored(&machine.*), id)
  let span = Module.span(run authored(&machine.*), id)
  return match move sourceExpressionInput(node) {
    StaticExpressionRoute.Hot {input} => match move input {
    HotStaticExpressionInput.Call {arguments} => run callExpression(&mut machine.*, &mut local.*, id, arguments, span)
    HotStaticExpressionInput.PrefixExpression {operator, operatorAnchor, operand} => run prefixExpression(&mut machine.*, &mut local.*, span, operator, operatorAnchor, operand)
    HotStaticExpressionInput.InfixExpression {operator, operatorAnchor, left, right} => run infixExpression(&mut machine.*, &mut local.*, span, operator, operatorAnchor, left, right)
    }
    StaticExpressionRoute.Other {input} => run otherExpressionFromSource(&mut machine.*, &mut local.*, id, span, move input)
  }
}

effect fn otherExpressionFromSource<'source>(
  machine: &mut Machine<'source>, local: &mut List<Local>, id: HirId, span: Span,
  input: OtherSourceExpressionInput,
) -> Interned<StaticData> ! Diagnostic | OutOfMemoryError ? &mut Allocator | &mut Types {
  return match move input {
    OtherSourceExpressionInput.BooleanLiteral {value} => run retain(
      &mut machine.*,
      StaticData.Boolean {value: value},
      span,
    )
    OtherSourceExpressionInput.UnitLiteral => run retain(&mut machine.*, StaticData.Unit, span)
    OtherSourceExpressionInput.CharacterLiteral {scalar} => run characterExpression(&mut machine.*, id, span, scalar)
    OtherSourceExpressionInput.TextLiteral {value} => run textExpression(&mut machine.*, span, value)
    OtherSourceExpressionInput.BytesLiteral {value} => run bytesExpression(&mut machine.*, span, value)
    OtherSourceExpressionInput.FloatingLiteral {spelling} => run floatingExpression(&mut machine.*, id, span, spelling)
    OtherSourceExpressionInput.IntegerLiteral => run integerExpression(&mut machine.*, id)
    OtherSourceExpressionInput.DurationLiteral {components} => run durationExpression(&mut machine.*, span, components)
    OtherSourceExpressionInput.IdentifierExpression {binding} => run identifierExpression(&mut machine.*, &mut local.*, id, span, binding)
    OtherSourceExpressionInput.FieldExpression {subject} => run fieldExpression(&mut machine.*, &mut local.*, id, span, subject)
    OtherSourceExpressionInput.MoveExpression {operand} => run expression(&mut machine.*, &mut local.*, operand)
    OtherSourceExpressionInput.StructExpression => run structValue(&mut machine.*, &mut local.*, id, span)
    // A fixed array is admitted from its elements in order, under the value-size limit. An element
    // that is not itself an admitted static value leaves the array Unsupported.
    OtherSourceExpressionInput.ArrayExpression {elements} => run arrayExpression(&mut machine.*, &mut local.*, id, span, elements)
    OtherSourceExpressionInput.ArrayRepeatExpression {value} => run arrayRepeatExpression(&mut machine.*, &mut local.*, id, span, value)
    OtherSourceExpressionInput.CompileErrorExpression {message} => run compileErrorExpression(&mut machine.*, &mut local.*, span, message)
    OtherSourceExpressionInput.BorrowExpression {access, operand} => run borrowExpression(&mut machine.*, &mut local.*, id, span, access, operand)
    OtherSourceExpressionInput.ReferentExpression {subject} => run referentExpression(&mut machine.*, &mut local.*, span, subject)
    OtherSourceExpressionInput.IndexExpression {subject, index} => run indexExpression(&mut machine.*, &mut local.*, span, subject, index)
    OtherSourceExpressionInput.Branching => run branchValue(&mut machine.*, &mut local.*, id, span)
    OtherSourceExpressionInput.MemberExpression => run memberValue(&mut machine.*, &mut local.*, id, span)
    OtherSourceExpressionInput.Unavailable => run reject(&machine.*, Fault.Unavailable, span)
  }
}

// Branch-local evaluator temporaries stay in the branch that uses them. The dispatch
// retains step accounting and authored spans before entering one selected helper.
effect fn characterExpression<'source>(machine: &mut Machine<'source>, id: HirId, span: Span, scalar: u32) -> Interned<StaticData>
! Diagnostic | OutOfMemoryError ? &mut Allocator {
  if let Option<StaticIntegerType>.Some {value: integer} = move checkedIntegerType(&machine.*, id) {
    let selected = match move StaticValue.integer(integer, StaticSign.Positive, u32.toU64(scalar), machine.target.pointerBits()) {
      Option<StaticData>.Some {value} => move value
      Option<StaticData>.None => { return run reject(&machine.*, Fault.InvalidValue, span) }
    }
    return run retain(&mut machine.*, move selected, span)
  }
  let selected = match move StaticValue.character(scalar) {
    Option<StaticData>.Some {value} => move value
    Option<StaticData>.None => {
      return run reject(&machine.*, Fault.InvalidValue, span)
    }
  }
  return run retain(&mut machine.*, move selected, span)
}

effect fn textExpression<'source>(machine: &mut Machine<'source>, span: Span, value: Symbol) -> Interned<StaticData>
! Diagnostic | OutOfMemoryError ? &mut Allocator {
  let bytes = run Bytes.copy(Module.text(run authored(&machine.*), value))
  let selected = match move StaticValue.text(move bytes) {
    Option<StaticData>.Some {value: textValue} => move textValue
    Option<StaticData>.None => {
      return run reject(&machine.*, Fault.InvalidValue, span)
    }
  }
  let text = run retain(&mut machine.*, move selected, span)
  run rememberTextOrigin(&mut machine.*, &text, span)
  return move text
}

// A byte-string literal is its decoded bytes, which need not be UTF-8: the same value an embedded
// file has, so a `&'static [u8]` field or constant can hold either.
effect fn bytesExpression<'source>(machine: &mut Machine<'source>, span: Span, value: Symbol) -> Interned<StaticData>
! Diagnostic | OutOfMemoryError ? &mut Allocator {
  let bytes = run Bytes.copy(Module.text(run authored(&machine.*), value))
  return run retain(&mut machine.*, StaticData.Bytes {bytes: move bytes}, span)
}

effect fn floatingExpression<'source>(machine: &mut Machine<'source>, id: HirId, span: Span, spelling: Symbol) -> Interned<StaticData>
! Diagnostic | OutOfMemoryError ? &mut Allocator {
  let width = match move checkedFloatType(&machine.*, id) {
    Option<StaticFloatType>.Some {value} => value
    Option<StaticFloatType>.None => {
      let mut failure = run diagnostic(&machine.*, Fault.Unsupported, span)
      failure.missing = Option<MissingFact>.some(MissingFact.CheckedExpression)
      fail move failure
    }
  }
  let rounded = match move width {
    StaticFloatType.F32 => StaticValue.f32Literal(run authored(&machine.*), spelling)
    StaticFloatType.F64 => StaticValue.f64Literal(run authored(&machine.*), spelling)
  }
  return match move rounded {
    Result<StaticData, ParseError>.Success {value: selected} => run retain(
      &mut machine.*,
      move selected,
      span,
    )
    Result<StaticData, ParseError>.Failure {..} => run reject(
      &machine.*,
      Fault.InvalidValue,
      span,
    )
  }
}

effect fn durationExpression<'source>(machine: &mut Machine<'source>, span: Span, components: Range) -> Interned<StaticData>
! Diagnostic | OutOfMemoryError ? &mut Allocator {
  let mut total: u64 = 0
  let mut at = usize.ZERO
  while at < components.length {
    let sum = match Module.node(run authored(&machine.*), Module.child(run authored(&machine.*), components, at)) {
      Node.DurationComponent {magnitude, unit} => DurationUnit.accumulate(unit, total, magnitude)
      _ => Option<u64>.none()
    }
    total = match move sum {
      Option<u64>.Some {value} => value
      Option<u64>.None => { return run reject(&machine.*, Fault.InvalidValue, span) }
    }
    at = at + usize.ONE
  }
  let selected = match move StaticValue.integer(StaticIntegerType.U64, StaticSign.Positive, total, machine.target.pointerBits()) {
    Option<StaticData>.Some {value} => move value
    Option<StaticData>.None => { return run reject(&machine.*, Fault.InvalidValue, span) }
  }
  return run retain(&mut machine.*, move selected, span)
}

effect fn identifierExpression<'source>(machine: &mut Machine<'source>, local: &mut List<Local>, id: HirId, span: Span, binding: HirRef) -> Interned<StaticData>
! Diagnostic | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut target = id
  if binding.present {
    target = binding.id
  }
  let bindings = List<Local>.asSlice(&local.*)
  let mut at = bindings.length
  while at > usize.ZERO {
    at = at - usize.ONE
    if bindings[at].binder.index == target.index || bindings[at].binder.index == id.index {
      return Interned<StaticData>.clone(&bindings[at].value)
    }
  }
  let external = run suppliedValue(&machine.*, id, target)
  if let Option<Interned<StaticData>>.Some {value} = move external {
    return move value
  }
  if let Option<Interned<DeclarationId>>.Some {value: declaration} = move checkedConstantDeclaration(&machine.*, id) {
    return run unresolvedConstant(&machine.*, id, move declaration)
  }
  // A function named as a value is a function value with every parameter open.
  if let Option<StaticCallable>.Some {value: StaticCallable.Section {ty, first}} = move run checkedCallable(&mut machine.*, id, span) {
    let closed = run closeType(&machine.*, &ty)
    return run retain(&mut machine.*, StaticData.Callable {ty: move closed, first: first, captured: List<Interned<StaticData>>.make()}, span)
  }
  return run reject(&machine.*, Fault.Unavailable, span)
}

effect fn fieldExpression<'source>(machine: &mut Machine<'source>, local: &mut List<Local>, id: HirId, span: Span, subject: HirId) -> Interned<StaticData>
! Diagnostic | OutOfMemoryError ? &mut Allocator | &mut Types {
  if let Option<CheckedEnumMember>.Some {value: member} = move checkedEnumMember(&machine.*, id) {
    return run enumValue(&mut machine.*, id, member, span)
  }
  // A unit variant of a nominal union, such as `Shape.Dot`.
  if let Option<usize>.Some {..} = move checkedVariantTag(&machine.*, id) {
    return run structValue(&mut machine.*, &mut local.*, id, span)
  }
  // `.length` of a fixed array, or of the array a static slice views.
  if checkedLength(&machine.*, id) {
    let mut array = run expression(&mut machine.*, &mut local.*, subject)
    while true {
      match move Interned<StaticData>.with<Option<Interned<StaticData>>>(&array, StaticValue.borrowTarget) {
        Option<Interned<StaticData>>.Some {value} => { array = move value }
        Option<Interned<StaticData>>.None => { break }
      }
    }
    let count = match move Interned<StaticData>.with<Option<usize>>(&array, StaticValue.arrayElements) {
      Option<usize>.Some {value} => value
      Option<usize>.None => { return run reject(&machine.*, Fault.Unsupported, span) }
    }
    return run retain(&mut machine.*, StaticData.Integer {ty: StaticIntegerType.Usize, sign: StaticSign.Positive, magnitude: usize.toU64(count)}, span)
  }
  // A field read projects one member of an admitted aggregate; it never yields a place.
  if let Option<usize>.Some {value: ordinal} = move checkedFieldIndex(&machine.*, id) {
    let aggregate = run expression(&mut machine.*, &mut local.*, subject)
    let selected = Interned<StaticData>.with<Option<Interned<StaticData>>>(&aggregate, fn(value: &StaticData) -> Option<Interned<StaticData>> {
      return StaticValue.field(value, ordinal)
    })
    return match move selected {
      Option<Interned<StaticData>>.Some {value} => move value
      Option<Interned<StaticData>>.None => run reject(&machine.*, Fault.InvalidValue, span)
    }
  }
  let bindings = List<Local>.asSlice(&local.*)
  let mut at = bindings.length
  while at > usize.ZERO {
    at = at - usize.ONE
    if bindings[at].binder.index == id.index {
      return Interned<StaticData>.clone(&bindings[at].value)
    }
  }
  let external = run suppliedValue(&machine.*, id, id)
  if let Option<Interned<StaticData>>.Some {value} = move external {
    return move value
  }
  if let Option<Interned<DeclarationId>>.Some {value: declaration} = move checkedConstantDeclaration(&machine.*, id) {
    return run unresolvedConstant(&machine.*, id, move declaration)
  }
  // A function named as a value is a function value with every parameter open.
  if let Option<StaticCallable>.Some {value: StaticCallable.Section {ty, first}} = move run checkedCallable(&mut machine.*, id, span) {
    let closed = run closeType(&machine.*, &ty)
    return run retain(&mut machine.*, StaticData.Callable {ty: move closed, first: first, captured: List<Interned<StaticData>>.make()}, span)
  }
  return run reject(&machine.*, Fault.Unavailable, span)
}

// A shared borrow in a static body views static data, which never changes or ends: the view is
// the referent itself under the borrow's checked type, a reference or, once typing turned an
// array borrow into one, a slice.
effect fn borrowExpression<'source>(machine: &mut Machine<'source>, local: &mut List<Local>, id: HirId, span: Span, access: Access, operand: HirId) -> Interned<StaticData>
! Diagnostic | OutOfMemoryError ? &mut Allocator | &mut Types {
  if access != Access.Shared { return run reject(&machine.*, Fault.StaticPhaseViolation, span) }
  let ty = match move checkedViewType(&machine.*, id) {
    Option<Interned<SemanticType>>.Some {value} => move value
    Option<Interned<SemanticType>>.None => { return run reject(&machine.*, Fault.Unavailable, span) }
  }
  // A view of a `let mut` local would keep the value it saw when a later assignment replaces it.
  if run viewsMutableLocal(&machine.*, &local.*, operand) {
    let mut failure = run diagnostic(&machine.*, Fault.StaticPhaseViolation, span)
    failure.message = Option<Bytes>.some(run Bytes.copy(b"a static body cannot borrow a `let mut` local, because assigning to it later would not change the view; borrow an immutable binding"))
    fail move failure
  }
  let closed = run closeType(&machine.*, &ty)
  let canonical = run staticViewType(&closed)
  let target = run expression(&mut machine.*, &mut local.*, operand)
  return run retain(&mut machine.*, StaticData.Borrow {ty: move canonical, target: move target}, span)
}

// A static view's type: a shared reference or slice valid for the whole program, whatever region
// typing gave the borrow, so equal views are the same static value wherever they are made.
effect fn staticViewType(ty: &Interned<SemanticType>) -> Interned<SemanticType> ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let slice = Interned<SemanticType>.with<Option<Interned<SemanticType>>>(ty, fn(shape: &SemanticType) -> Option<Interned<SemanticType>> {
    return match &shape.* { SemanticType.Slice {element, ..} => Option<Interned<SemanticType>>.some(Interned<SemanticType>.clone(&element)) _ => Option<Interned<SemanticType>>.none() }
  })
  if let Option<Interned<SemanticType>>.Some {value: element} = move slice {
    return run Types.intern(SemanticType.Slice {element: move element, access: Access.Shared, lifetime: run Types.internLifetime(Lifetime.Static)})
  }
  let reference = Interned<SemanticType>.with<Option<Interned<SemanticType>>>(ty, fn(shape: &SemanticType) -> Option<Interned<SemanticType>> {
    return match &shape.* { SemanticType.Reference {referent, ..} => Option<Interned<SemanticType>>.some(Interned<SemanticType>.clone(&referent)) _ => Option<Interned<SemanticType>>.none() }
  })
  if let Option<Interned<SemanticType>>.Some {value: referent} = move reference {
    return run Types.intern(SemanticType.Reference {referent: move referent, access: Access.Shared, lifetime: run Types.internLifetime(Lifetime.Static)})
  }
  return Interned<SemanticType>.clone(ty)
}

// Whether `operand` names a `let mut` local, or a field, element or referent of one.
effect fn viewsMutableLocal<'source>(machine: &Machine<'source>, local: &List<Local>, operand: HirId) -> bool
! Diagnostic | OutOfMemoryError ? &mut Allocator {
  let mut place = operand
  while true {
    match Module.node(run authored(&machine.*), place) {
      Node.FieldExpression {subject, ..} => { place = subject }
      Node.IndexExpression {subject, ..} => { place = subject }
      Node.ReferentExpression {subject} => { place = subject }
      Node.IdentifierExpression {binding, ..} => {
        let mut target = place
        if binding.present { target = binding.id }
        let bindings = List<Local>.asSlice(&local.*)
        let mut at = bindings.length
        while at > usize.ZERO {
          at = at - usize.ONE
          if bindings[at].binder.index == target.index || bindings[at].binder.index == place.index {
            return bindings[at].mutable
          }
        }
        return false
      }
      _ => { return false }
    }
  }
  return false
}

// `view.*` reads the static data a view holds.
effect fn referentExpression<'source>(machine: &mut Machine<'source>, local: &mut List<Local>, span: Span, subject: HirId) -> Interned<StaticData>
! Diagnostic | OutOfMemoryError ? &mut Allocator | &mut Types {
  let view = run expression(&mut machine.*, &mut local.*, subject)
  return match move Interned<StaticData>.with<Option<Interned<StaticData>>>(&view, StaticValue.borrowTarget) {
    Option<Interned<StaticData>>.Some {value} => move value
    Option<Interned<StaticData>>.None => run reject(&machine.*, Fault.Unsupported, span)
  }
}

// One element of a fixed array, or of the array a static slice views. An index past the end is
// the same fault a runtime bounds check would raise.
effect fn indexExpression<'source>(machine: &mut Machine<'source>, local: &mut List<Local>, span: Span, subject: HirId, index: HirId) -> Interned<StaticData>
! Diagnostic | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut array = run expression(&mut machine.*, &mut local.*, subject)
  while true {
    match move Interned<StaticData>.with<Option<Interned<StaticData>>>(&array, StaticValue.borrowTarget) {
      Option<Interned<StaticData>>.Some {value} => { array = move value }
      Option<Interned<StaticData>>.None => { break }
    }
  }
  let position = run expression(&mut machine.*, &mut local.*, index)
  let length = match move Interned<StaticData>.with<Option<usize>>(&array, StaticValue.arrayElements) {
    Option<usize>.Some {value} => value
    Option<usize>.None => { return run reject(&machine.*, Fault.Unsupported, span) }
  }
  let at = match move Interned<StaticData>.with<Option<u64>>(&position, StaticValue.unsignedMagnitude) {
    Option<u64>.Some {value} => value
    Option<u64>.None => { return run reject(&machine.*, Fault.InvalidValue, span) }
  }
  if at >= usize.toU64(length) {
    let mut failure = run diagnostic(&machine.*, Fault.InvalidValue, span)
    let mut detail = run Bytes.copy(b"index ")
    run appendDecimal(&mut detail, at)
    run Bytes.append(&mut detail, b" is out of bounds for length ")
    run appendDecimal(&mut detail, usize.toU64(length))
    failure.message = Option<Bytes>.some(move detail)
    fail move failure
  }
  let selected = Interned<StaticData>.with<Option<Interned<StaticData>>>(&array, fn(value: &StaticData) -> Option<Interned<StaticData>> {
    return StaticValue.field(value, u64.toUsize(at))
  })
  return match move selected {
    Option<Interned<StaticData>>.Some {value} => move value
    Option<Interned<StaticData>>.None => run reject(&machine.*, Fault.InvalidValue, span)
  }
}

effect fn arrayExpression<'source>(machine: &mut Machine<'source>, local: &mut List<Local>, id: HirId, span: Span, elements: Range) -> Interned<StaticData>
! Diagnostic | OutOfMemoryError ? &mut Allocator | &mut Types {
  let written = match move checkedExpressionType(&machine.*, id) {
    Option<Interned<SemanticType>>.Some {value} => move value
    Option<Interned<SemanticType>>.None => { return run reject(&machine.*, Fault.Unavailable, span) }
  }
  let ty = run closeType(&machine.*, &written)
  let mut fields = List<Interned<StaticData>>.make()
  let mut at = usize.ZERO
  while at < elements.length {
    let child = Module.child(run authored(&machine.*), elements, at)
    let value = run expression(&mut machine.*, &mut local.*, child)
    run List<Interned<StaticData>>.append(&mut fields, move value)
    at = at + usize.ONE
  }
  return match move StaticValue.aggregate(move ty, Option<usize>.none(), move fields) {
    Option<StaticData>.Some {value} => run retain(&mut machine.*, move value, span)
    Option<StaticData>.None => run reject(&machine.*, Fault.Unsupported, span)
  }
}

effect fn arrayRepeatExpression<'source>(machine: &mut Machine<'source>, local: &mut List<Local>, id: HirId, span: Span, operand: HirId) -> Interned<StaticData>
! Diagnostic | OutOfMemoryError ? &mut Allocator | &mut Types {
  let written = match move checkedExpressionType(&machine.*, id) {
    Option<Interned<SemanticType>>.Some {value} => move value
    Option<Interned<SemanticType>>.None => { return run reject(&machine.*, Fault.Unavailable, span) }
  }
  let ty = run closeType(&machine.*, &written)
  // Typing has already evaluated and validated the compile-time count and supplied element context.
  let count = match move SemanticType.arrayShape(&ty) {
    Option<ArrayShape>.Some {value: shape} => shape.length
    Option<ArrayShape>.None => { return run reject(&machine.*, Fault.InvalidValue, span) }
  }
  // Evaluate even an empty repeat's operand; only its storage is discarded.
  let value = run expression(&mut machine.*, &mut local.*, operand)
  let bytes = Interned<StaticData>.with<usize>(&value, StaticValue.size)
  if machine.limits.valueBytes < 16 || count > usize.divide(machine.limits.valueBytes - 16, bytes) {
    return run reject(&machine.*, Fault.ValueLimit, span)
  }
  let mut fields = List<Interned<StaticData>>.make()
  let mut at = usize.ZERO
  while at < count {
    run List<Interned<StaticData>>.append(&mut fields, Interned<StaticData>.clone(&value))
    at = at + usize.ONE
  }
  return match move StaticValue.aggregate(move ty, Option<usize>.none(), move fields) {
    Option<StaticData>.Some {value: aggregate} => run retain(&mut machine.*, move aggregate, span)
    Option<StaticData>.None => run reject(&machine.*, Fault.Unsupported, span)
  }
}

effect fn compileErrorExpression<'source>(machine: &mut Machine<'source>, local: &mut List<Local>, span: Span, message: HirId) -> Interned<StaticData>
! Diagnostic | OutOfMemoryError ? &mut Allocator | &mut Types {
  let value = run expression(&mut machine.*, &mut local.*, message)
  let reported = run StaticValue.textBytes(&value)
  let text = match move reported {
    Option<Bytes>.Some {value: copied} => move copied
    Option<Bytes>.None => {
      return run reject(
        &machine.*,
        Fault.InvalidValue,
        Module.span(run authored(&machine.*), message),
      )
    }
  }
  let mut failure = run diagnostic(&machine.*, Fault.CompileError, span)
  failure.message = Option<Bytes>.some(move text)
  failure.origin = Option<Span>.some(Module.span(run authored(&machine.*), message))
  fail move failure
}

effect fn prefixExpression<'source>(machine: &mut Machine<'source>, local: &mut List<Local>, span: Span, operator: PrefixOperator, operatorAnchor: Span, operand: HirId) -> Interned<StaticData>
! Diagnostic | OutOfMemoryError ? &mut Allocator | &mut Types {
  let value = run expression(&mut machine.*, &mut local.*, operand)
  let result = StaticValue.prefixShared(operator, &value, machine.target.pointerBits())
  return match move result {
    Result<StaticData, StaticFault>.Success {value: selected} => run retain(
      &mut machine.*,
      move selected,
      span,
    )
    Result<StaticData, StaticFault>.Failure {error} => run rejectScalar(
      &machine.*,
      move error,
      operatorAnchor,
      span,
    )
  }
}

effect fn infixExpression<'source>(machine: &mut Machine<'source>, local: &mut List<Local>, span: Span, operator: InfixOperator, operatorAnchor: Span, left: HirId, right: HirId) -> Interned<StaticData>
! Diagnostic | OutOfMemoryError ? &mut Allocator | &mut Types {
  let first = run expression(&mut machine.*, &mut local.*, left)
  if run leftDecidesInfix(&machine.*, operator, &first, span) {
    return move first
  }
  let second = run expression(&mut machine.*, &mut local.*, right)
  return run applyInfix(&mut machine.*, operator, operatorAnchor, span, &first, &second)
}


effect<'owner & 'env> fn evaluateCurrent<'owner, 'env, 'source>(
  machine: &'owner mut Machine<'source>,
  bindings: &'env [Binding],
  id: HirId,
) -> Interned<StaticData> ! Diagnostic | OutOfMemoryError ? &mut Allocator | &mut Types {
  run supplyBindings(&mut machine.*, bindings)
  let mut local = List<Local>.make()
  let value = run expression(&mut machine.*, &mut local, id)
  let bytes = run unheldBytes(&mut machine.*, &value, false)
  if machine.retainedBytes > machine.limits.valueBytes || bytes > machine.limits.valueBytes - machine.retainedBytes {
    return run reject(&machine.*, Fault.ValueLimit, Module.span(run authored(&machine.*), id))
  }
  machine.retainedBytes = machine.retainedBytes + bytes
  return move value
}

/// Evaluates one checked expression from the root module with immutable static binders and the machine's limits.
pub effect<'owner & 'env> fn evaluate<'owner, 'env, 'source>(
  machine: &'owner mut Machine<'source>,
  checked: &CheckedRoot,
  bindings: &'env [Binding],
  id: HirId,
) -> Interned<StaticData> ! Diagnostic | OutOfMemoryError ? &mut Allocator | &mut Types {
  let root = ModuleId.copy(&machine.root)
  let cursor = run rootCursor(&mut machine.*, checked)
  let matching = rootChecked(checked, &root)
  if !matching {
    let mut failure = run diagnostic(&machine.*, Fault.Unsupported, Span.make(usize.ZERO, usize.ZERO))
    failure.missing = Option<MissingFact>.some(MissingFact.CheckedSource)
    fail move failure
  }
  let previous = copyCurrent(&machine.*)
  let previousBody = match &machine.rootBody {
    Option<Shared<TypedBody>>.Some {value} => Option<Shared<TypedBody>>.some(Shared<TypedBody>.clone(&value))
    Option<Shared<TypedBody>>.None => Option<Shared<TypedBody>>.none()
  }
  let suppliedBase = List<RetainedBinding>.length(&machine.supplied)
  let rootNodes = run indexShared(&checked.body)
  let previousNodes = Intrinsic.replace(machine.rootNodes, move rootNodes)
  machine.current = Option<AuthoredCursor>.some(move cursor)
  machine.rootBody = Option<Shared<TypedBody>>.some(Shared<TypedBody>.clone(&checked.body))
  let reservation = SourceReservation {
    machine: move machine,
    previous: move previous,
    previousBody: move previousBody,
    previousNodes: move previousNodes,
    suppliedBase: suppliedBase,
  }
  let use = effect fn(resource: &mut SourceReservation<'owner, 'source>) -> Interned<StaticData>
  ! Diagnostic | OutOfMemoryError
  ? &mut Allocator | &mut Types {
    return run evaluateCurrent(&mut resource.machine.*, bindings, id)
  }
  let release = effect fn(resource: &mut SourceReservation<'owner, 'source>) -> () {
    let supplied = List<RetainedBinding>.asSlice(&resource.machine.*.supplied)
    let mut at = resource.suppliedBase
    let mut releasedBytes = usize.ZERO
    while at < supplied.length {
      releasedBytes = releasedBytes + supplied[at].chargedBytes
      at = at + usize.ONE
    }
    List<RetainedBinding>.truncate(&mut resource.machine.*.supplied, resource.suppliedBase)
    resource.machine.*.retainedBytes = resource.machine.*.retainedBytes - releasedBytes
    resource.machine.*.current = copyPrevious(&resource.previous)
    resource.machine.*.rootBody = match &resource.previousBody {
      Option<Shared<TypedBody>>.Some {value} => Option<Shared<TypedBody>>.some(Shared<TypedBody>.clone(&value))
      Option<Shared<TypedBody>>.None => Option<Shared<TypedBody>>.none()
    }
    let restored = Intrinsic.replace(resource.previousNodes, emptyNodes())
    let replaced = Intrinsic.replace(resource.machine.*.rootNodes, move restored)
    drop replaced
    return ()
  }
  return run Effect.useReleaseNonParking(move reservation, move use, move release)
}

fn flowContinues(flow: &Flow) -> bool {
  return match &flow.* {
    Flow.Next => true
    _ => false
  }
}

// Runs the statements of a block in order, then drops the bindings the block introduced.
effect fn blockFlow<'source>(
  machine: &mut Machine<'source>,
  local: &mut List<Local>,
  statements: Range,
) -> Flow
! Diagnostic | OutOfMemoryError
? &mut Allocator | &mut Types {
  let base = List<Local>.length(&local.*)
  let mut at = usize.ZERO
  while at < statements.length {
    let child = Module.child(run authored(&machine.*), statements, at)
    let next = run statement(&mut machine.*, &mut local.*, child)
    if !flowContinues(&next) {
      List<Local>.truncate(&mut local.*, base)
      return move next
    }
    drop next
    at = at + usize.ONE
  }
  List<Local>.truncate(&mut local.*, base)
  return Flow.Next
}

effect fn whileFlow<'source>(
  machine: &mut Machine<'source>,
  local: &mut List<Local>,
  condition: HirId,
  body: HirId,
) -> Flow
! Diagnostic | OutOfMemoryError
? &mut Allocator | &mut Types {
  while run evaluatedBoolean(&mut machine.*, &mut local.*, condition) {
    let next = run statement(&mut machine.*, &mut local.*, body)
    match move next {
      Flow.Next => {}
      Flow.Continue => {}
      Flow.Break => {
        return Flow.Next
      }
      Flow.Return {value} => {
        return Flow.Return {value: move value}
      }
    }
  }
  return Flow.Next
}

// Stores the value of `value` into the innermost mutable local bound by `binding`, reporting
// whether such a local exists.
effect fn assignBinding<'source>(
  machine: &mut Machine<'source>,
  local: &mut List<Local>,
  binding: HirRef,
  value: HirId,
) -> bool
! Diagnostic | OutOfMemoryError
? &mut Allocator | &mut Types {
  if !binding.present {
    return false
  }
  let replacement = run expression(&mut machine.*, &mut local.*, value)
  let slots = List<Local>.asMutSlice(&mut local.*)
  let mut at = slots.length
  while at > usize.ZERO {
    at = at - usize.ONE
    if slots[at].binder.index == binding.id.index && slots[at].mutable {
      slots[at].value = move replacement
      return true
    }
  }
  return false
}

// The compact statement vocabulary keeps unavailable authored forms in one failure arm.
union SourceStatementInput {
  Block {statements: Range},
  ExpressionStatement {expression: HirId},
  BindingStatement {mutable: bool, isStatic: bool, initializer: HirId},
  AssignmentStatement {target: HirId, value: HirId},
  ConditionalStatement {condition: HirId, thenBranch: HirId, elseBranch: HirRef},
  PatternConditionalStatement,
  StaticConditionalStatement {condition: HirId, thenBranch: HirId, elseBranch: HirRef},
  StaticForStatement {binding: HirId, iterable: HirId, body: HirId},
  WhileStatement {condition: HirId, body: HirId},
  BreakStatement,
  ContinueStatement,
  ReturnStatement {value: HirRef},
  Unavailable,
}

fn sourceStatementInput(node: Node) -> SourceStatementInput {
  return match node {
    Node.Block {statements} => SourceStatementInput.Block {statements: statements}
    Node.ExpressionStatement {expression} => SourceStatementInput.ExpressionStatement {expression: expression}
    Node.BindingStatement {mutable, isStatic, initializer, ..} => SourceStatementInput.BindingStatement {mutable: mutable, isStatic: isStatic, initializer: initializer}
    Node.AssignmentStatement {target, value} => SourceStatementInput.AssignmentStatement {target: target, value: value}
    Node.ConditionalStatement {condition, thenBranch, elseBranch} => SourceStatementInput.ConditionalStatement {condition: condition, thenBranch: thenBranch, elseBranch: elseBranch}
    Node.PatternConditionalStatement {..} => SourceStatementInput.PatternConditionalStatement
    Node.StaticConditionalStatement {condition, thenBranch, elseBranch} => SourceStatementInput.StaticConditionalStatement {condition: condition, thenBranch: thenBranch, elseBranch: elseBranch}
    Node.StaticForStatement {binding, iterable, body} => SourceStatementInput.StaticForStatement {binding: binding, iterable: iterable, body: body}
    Node.WhileStatement {condition, body} => SourceStatementInput.WhileStatement {condition: condition, body: body}
    Node.BreakStatement => SourceStatementInput.BreakStatement
    Node.ContinueStatement => SourceStatementInput.ContinueStatement
    Node.ReturnStatement {value} => SourceStatementInput.ReturnStatement {value: value}
    _ => SourceStatementInput.Unavailable
  }
}

effect fn statement<'source>(
  machine: &mut Machine<'source>,
  local: &mut List<Local>,
  id: HirId,
) -> Flow
! Diagnostic | OutOfMemoryError
? &mut Allocator | &mut Types {
  run step(&mut machine.*, id)
  let node = Module.node(run authored(&machine.*), id)
  let span = Module.span(run authored(&machine.*), id)
  return match move sourceStatementInput(node) {
    SourceStatementInput.Block {statements} => run blockFlow(&mut machine.*, &mut local.*, statements)
    SourceStatementInput.ExpressionStatement {expression: value} => run expressionFlow(&mut machine.*, &mut local.*, value)
    SourceStatementInput.BindingStatement {mutable, isStatic, initializer} => run bindingFlow(&mut machine.*, &mut local.*, id, span, mutable, isStatic, initializer)
    SourceStatementInput.AssignmentStatement {target, value} => run assignmentFlow(&mut machine.*, &mut local.*, target, value)
    SourceStatementInput.ConditionalStatement {condition, thenBranch, elseBranch} => run conditionalFlow(&mut machine.*, &mut local.*, condition, thenBranch, elseBranch)
    SourceStatementInput.PatternConditionalStatement => run branchFlow(&mut machine.*, &mut local.*, id)
    SourceStatementInput.StaticConditionalStatement {condition, thenBranch, elseBranch} => run staticConditionalFlow(&mut machine.*, &mut local.*, id, span, condition, thenBranch, elseBranch)
    SourceStatementInput.StaticForStatement {binding, iterable, body} => run staticForFlow(&mut machine.*, &mut local.*, id, span, binding, iterable, body)
    SourceStatementInput.WhileStatement {condition, body} => run whileFlow(&mut machine.*, &mut local.*, condition, body)
    SourceStatementInput.BreakStatement => Flow.Break
    SourceStatementInput.ContinueStatement => Flow.Continue
    SourceStatementInput.ReturnStatement {value} => run returnFlow(&mut machine.*, &mut local.*, span, value)
    SourceStatementInput.Unavailable => run reject(&machine.*, Fault.Unavailable, span)
  }
}

// Branch-local evaluator temporaries stay in the branch that uses them. The dispatch
// retains step accounting and authored spans before entering one selected helper.
effect fn expressionFlow<'source>(machine: &mut Machine<'source>, local: &mut List<Local>, value: HirId) -> Flow
! Diagnostic | OutOfMemoryError ? &mut Allocator | &mut Types {
  return match move run outcome(&mut machine.*, &mut local.*, value) {
    BranchOutcome.Value {..} => Flow.Next
    BranchOutcome.Escape {flow} => move flow
  }
}

effect fn bindingFlow<'source>(machine: &mut Machine<'source>, local: &mut List<Local>, id: HirId, span: Span, mutable: bool, isStatic: bool, initializer: HirId) -> Flow
! Diagnostic | OutOfMemoryError ? &mut Allocator | &mut Types {
  if isStatic {
    return run reject(&machine.*, Fault.Unavailable, span)
  }
  let value = match move run outcome(&mut machine.*, &mut local.*, initializer) {
    BranchOutcome.Value {value: initial} => move initial
    BranchOutcome.Escape {flow} => { return move flow }
  }
  run List<Local>.append(
    &mut local.*,
    Local {binder: id, mutable: mutable, value: move value},
  )
  return Flow.Next
}

effect fn assignmentFlow<'source>(machine: &mut Machine<'source>, local: &mut List<Local>, target: HirId, value: HirId) -> Flow
! Diagnostic | OutOfMemoryError ? &mut Allocator | &mut Types {
  let selected = Module.node(run authored(&machine.*), target)
  if let Node.IdentifierExpression {binding, ..} = selected {
    if run assignBinding(&mut machine.*, &mut local.*, binding, value) {
      return Flow.Next
    }
  }
  if run assignPart(&mut machine.*, &mut local.*, target, value) {
    return Flow.Next
  }
  // STATIC-006: static mutation replaces a `let mut` local, or a field or element of one.
  let mut failure = run diagnostic(&machine.*, Fault.StaticPhaseViolation, Module.span(run authored(&machine.*), target))
  failure.message = Option<Bytes>.some(run Bytes.copy(b"static mutation assigns to a `let mut` local or to a field or element of one"))
  fail move failure
}

// Assigns to a field or element of a `let mut` local (STATIC-006): the local takes a copy of its
// value with that part replaced, so no earlier value or view sees the change. Reports whether
// `target` is such a place.
effect fn assignPart<'source>(machine: &mut Machine<'source>, local: &mut List<Local>, target: HirId, value: HirId) -> bool
! Diagnostic | OutOfMemoryError ? &mut Allocator | &mut Types {
  let span = Module.span(run authored(&machine.*), target)
  // The steps from the place toward its root binding, outermost step last.
  let mut steps = List<usize>.make()
  let mut place = target
  let mut binding = HirRef.absent()
  while !binding.present {
    match Module.node(run authored(&machine.*), place) {
      Node.FieldExpression {subject, ..} => {
        let ordinal = match move checkedFieldIndex(&machine.*, place) {
          Option<usize>.Some {value: found} => found
          Option<usize>.None => { return false }
        }
        run List<usize>.append(&mut steps, ordinal)
        place = subject
      }
      // A tuple element is a field at its ordinal, as reads route it.
      Node.OrdinalExpression {subject, ..} => {
        let ordinal = match move checkedFieldIndex(&machine.*, place) {
          Option<usize>.Some {value: found} => found
          Option<usize>.None => { return false }
        }
        run List<usize>.append(&mut steps, ordinal)
        place = subject
      }
      Node.IndexExpression {subject, index} => {
        let at = run expression(&mut machine.*, &mut local.*, index)
        let ordinal = match move Interned<StaticData>.with<Option<u64>>(&at, StaticValue.unsignedMagnitude) {
          Option<u64>.Some {value: magnitude} => match move u64.checkedToUsize(magnitude) {
            Option<usize>.Some {value: found} => found
            Option<usize>.None => { return run reject(&machine.*, Fault.InvalidValue, span) }
          }
          Option<u64>.None => { return run reject(&machine.*, Fault.InvalidValue, span) }
        }
        run List<usize>.append(&mut steps, ordinal)
        place = subject
      }
      Node.IdentifierExpression {binding: named, ..} => {
        if !named.present { return false }
        binding = named
      }
      _ => { return false }
    }
  }
  let path = List<usize>.asSlice(&steps)
  if path.length == usize.ZERO { return false }
  let slots = List<Local>.asSlice(&local.*)
  let mut slot = slots.length
  let mut search = slots.length
  while search > usize.ZERO {
    search = search - usize.ONE
    if slots[search].binder.index == binding.id.index && slots[search].mutable {
      slot = search
      break
    }
  }
  if slot == slots.length { return false }
  let replacement = run expression(&mut machine.*, &mut local.*, value)
  // The value at each depth along the path, the root first.
  let mut chain = List<Interned<StaticData>>.make()
  run List<Interned<StaticData>>.append(&mut chain, Interned<StaticData>.clone(&List<Local>.asSlice(&local.*)[slot].value))
  let mut depth = usize.ZERO
  while depth + usize.ONE < path.length {
    let ordinal = path[path.length - usize.ONE - depth]
    let outer = List<Interned<StaticData>>.asSlice(&chain)
    let inner = Interned<StaticData>.with<Option<Interned<StaticData>>>(&outer[depth], fn(data: &StaticData) -> Option<Interned<StaticData>> {
      return StaticValue.field(data, ordinal)
    })
    match move inner {
      Option<Interned<StaticData>>.Some {value: found} => run List<Interned<StaticData>>.append(&mut chain, move found)
      Option<Interned<StaticData>>.None => { return run reject(&machine.*, Fault.InvalidValue, span) }
    }
    depth = depth + usize.ONE
  }
  let mut current = move replacement
  let mut level = path.length
  while level > usize.ZERO {
    level = level - usize.ONE
    let ordinal = path[path.length - usize.ONE - level]
    let held = List<Interned<StaticData>>.asSlice(&chain)
    let rebuilt = run StaticValue.replacedField(&held[level], ordinal, move current)
    current = match move rebuilt {
      Option<StaticData>.Some {value: replaced} => run retain(&mut machine.*, move replaced, span)
      Option<StaticData>.None => { return run reject(&machine.*, Fault.InvalidValue, span) }
    }
  }
  let written = List<Local>.asMutSlice(&mut local.*)
  written[slot].value = move current
  return true
}

effect fn conditionalFlow<'source>(machine: &mut Machine<'source>, local: &mut List<Local>, condition: HirId, thenBranch: HirId, elseBranch: HirRef) -> Flow
! Diagnostic | OutOfMemoryError ? &mut Allocator | &mut Types {
  if run evaluatedBoolean(&mut machine.*, &mut local.*, condition) {
    return run statement(&mut machine.*, &mut local.*, thenBranch)
  }
  if elseBranch.present {
    return run statement(&mut machine.*, &mut local.*, elseBranch.id)
  }
  return Flow.Next
}

effect fn staticConditionalFlow<'source>(machine: &mut Machine<'source>, local: &mut List<Local>, id: HirId, span: Span, condition: HirId, thenBranch: HirId, elseBranch: HirRef) -> Flow
! Diagnostic | OutOfMemoryError ? &mut Allocator | &mut Types {
  let selected = match move selectedStaticArm(&machine.*, id) {
    Option<HirRef>.Some {value: arm} => arm
    Option<HirRef>.None => {
      let mut failure = run diagnostic(&machine.*, Fault.Unsupported, span)
      failure.missing = Option<MissingFact>.some(MissingFact.CheckedBody)
      fail move failure
    }
  }
  let chosen = run evaluatedBoolean(&mut machine.*, &mut local.*, condition)
  let mut expected = elseBranch
  if chosen { expected = HirRef.of(thenBranch) }
  if selected.present != expected.present || (selected.present && selected.id.index != expected.id.index) {
    // A static decision checked before an ordinary loop may not silently change when that
    // loop executes again. Such value-dependent rechecking remains an explicit refusal.
    return run reject(&machine.*, Fault.Unsupported, Module.span(run authored(&machine.*), condition))
  }
  if selected.present { return run statement(&mut machine.*, &mut local.*, selected.id) }
  return Flow.Next
}

effect fn staticForFlow<'source>(machine: &mut Machine<'source>, local: &mut List<Local>, id: HirId, span: Span, binding: HirId, iterable: HirId, body: HirId) -> Flow
! Diagnostic | OutOfMemoryError ? &mut Allocator | &mut Types {
  let sequence = run expression(&mut machine.*, &mut local.*, iterable)
  let length = Interned<StaticData>.with<usize>(&sequence, StaticValue.sequenceLength)
  if length == usize.MAX { return run reject(&machine.*, Fault.StaticPhaseViolation, span) }
  let checked = match move checkedBodyForExpression(&machine.*) {
    Option<Shared<TypedBody>>.Some {value} => move value
    Option<Shared<TypedBody>>.None => { return run reject(&machine.*, Fault.Unavailable, span) }
  }
  let window = checkedRange(&machine.*)
  let anchor = match move checkedAnchor(&machine.*) {
    Option<Anchor>.Some {value} => move value
    Option<Anchor>.None => { return run reject(&machine.*, Fault.Unavailable, span) }
  }
  let mut ordinal = usize.ZERO
  while ordinal < length {
    let range = Shared<TypedBody>.with<Option<Range>>(&checked, fn(typed: &TypedBody) -> Option<Range> {
      let facts = TypedBody.staticIterations(typed)
      let mut at = usize.ZERO
      while at < facts.length {
        let StaticIteration {syntax, ordinal: selected, nodeStart, nodeEnd, ..} = &facts[at]
        if Anchor.hir(&anchor, syntax).index == id.index && selected == ordinal && nodeStart >= window.start && nodeEnd - window.start <= window.length { return Option<Range>.some(Range {start: nodeStart, length: nodeEnd - nodeStart}) }

        at = at + usize.ONE
      }
      return Option<Range>.none()
    })
    let occurrence = match move range {
      Option<Range>.Some {value} => value
      Option<Range>.None => { return run reject(&machine.*, Fault.Unavailable, span) }
    }
    let value = match move Interned<StaticData>.with<Option<Interned<StaticData>>>(&sequence,
      fn(data: &StaticData) -> Option<Interned<StaticData>> { return StaticValue.sequenceElement(data, ordinal) }) {
      Option<Interned<StaticData>>.Some {value} => move value
      Option<Interned<StaticData>>.None => { return run reject(&machine.*, Fault.InvalidValue, span) }
    }
    let flow = run occurrenceFlow(&mut machine.*, &mut local.*, body, occurrence.start,
      occurrence.start + occurrence.length, binding, &value)
    if !flowContinues(&flow) { return move flow }
    ordinal = ordinal + usize.ONE
  }
  return Flow.Next
}

effect fn returnFlow<'source>(machine: &mut Machine<'source>, local: &mut List<Local>, span: Span, value: HirRef) -> Flow
! Diagnostic | OutOfMemoryError ? &mut Allocator | &mut Types {
  if value.present {
    return match move run outcome(&mut machine.*, &mut local.*, value.id) {
      BranchOutcome.Value {value: returned} => Flow.Return {value: move returned}
      BranchOutcome.Escape {flow} => move flow
    }
  }
  return Flow.Return {value: run retain(&mut machine.*, StaticData.Unit, span)}
}

// What evaluating a branching value produced: its value, or the flow its selected branch left the
// enclosing body with, as a `return` inside a `match` arm does.
union BranchOutcome {
  Value {value: Interned<StaticData>},
  Escape {flow: Flow},
}

// Whether an authored value selects one of its branches: a `match`, an `if` or `if let` used as
// a value, or a block whose last expression is its value.
fn branchingNode(node: Node) -> bool {
  return match node {
    Node.MatchExpression {..} => true
    Node.ConditionalStatement {..} => true
    Node.PatternConditionalStatement {..} => true
    Node.Block {..} => true
    _ => false
  }
}

// Evaluates `id` where the enclosing statement can carry a flow out: an expression statement, a
// binding's initializer or a returned value.
effect fn outcome<'source>(machine: &mut Machine<'source>, local: &mut List<Local>, id: HirId) -> BranchOutcome
! Diagnostic | OutOfMemoryError ? &mut Allocator | &mut Types {
  let node = Module.node(run authored(&machine.*), id)
  if branchingNode(node) {
    run step(&mut machine.*, id)
    return run branchOutcome(&mut machine.*, &mut local.*, id, node)
  }
  return BranchOutcome.Value {value: run expression(&mut machine.*, &mut local.*, id)}
}

effect fn branchOutcome<'source>(machine: &mut Machine<'source>, local: &mut List<Local>, id: HirId, node: Node) -> BranchOutcome
! Diagnostic | OutOfMemoryError ? &mut Allocator | &mut Types {
  let span = Module.span(run authored(&machine.*), id)
  return match node {
    Node.MatchExpression {subject, arms, ..} => run matchOutcome(&mut machine.*, &mut local.*, id, span, subject, arms)
    Node.PatternConditionalStatement {subject, thenBranch, elseBranch, ..} => run patternConditionalOutcome(&mut machine.*, &mut local.*, id, span, subject, thenBranch, elseBranch)
    Node.ConditionalStatement {condition, thenBranch, elseBranch} => run conditionalOutcome(&mut machine.*, &mut local.*, span, condition, thenBranch, elseBranch)
    Node.Block {statements} => run blockOutcome(&mut machine.*, &mut local.*, span, statements)
    _ => BranchOutcome.Value {value: run expression(&mut machine.*, &mut local.*, id)}
  }
}

// A branching value nested inside another expression, where no flow can leave.
effect fn branchValue<'source>(machine: &mut Machine<'source>, local: &mut List<Local>, id: HirId, span: Span) -> Interned<StaticData>
! Diagnostic | OutOfMemoryError ? &mut Allocator | &mut Types {
  let node = Module.node(run authored(&machine.*), id)
  return match move run branchOutcome(&mut machine.*, &mut local.*, id, node) {
    BranchOutcome.Value {value} => move value
    BranchOutcome.Escape {..} => {
      let mut failure = run diagnostic(&machine.*, Fault.Unsupported, span)
      failure.message = Option<Bytes>.some(run Bytes.copy(b"a static body can leave from a branch only where the branch is a whole statement, a binding's initializer or a returned value"))
      fail move failure
    }
  }
}

// Converts a statement-position branching value to the flow it leaves its statement with.
effect fn branchFlow<'source>(machine: &mut Machine<'source>, local: &mut List<Local>, id: HirId) -> Flow
! Diagnostic | OutOfMemoryError ? &mut Allocator | &mut Types {
  let node = Module.node(run authored(&machine.*), id)
  return match move run branchOutcome(&mut machine.*, &mut local.*, id, node) {
    BranchOutcome.Value {..} => Flow.Next
    BranchOutcome.Escape {flow} => move flow
  }
}

effect fn matchOutcome<'source>(machine: &mut Machine<'source>, local: &mut List<Local>, id: HirId, span: Span, subject: HirId, arms: Range) -> BranchOutcome
! Diagnostic | OutOfMemoryError ? &mut Allocator | &mut Types {
  let value = run expression(&mut machine.*, &mut local.*, subject)
  let position = match move checkedMatchPosition(&machine.*, id) {
    Option<usize>.Some {value: found} => found
    Option<usize>.None => { return run reject(&machine.*, Fault.Unavailable, span) }
  }
  let base = List<Local>.length(&local.*)
  let mut arm = usize.ZERO
  while arm < arms.length {
    let written = Module.child(run authored(&machine.*), arms, arm)
    match Module.node(run authored(&machine.*), written) {
      Node.MatchArm {guard, result, ..} => {
        if run bindArm(&mut machine.*, &mut local.*, position, arm, &value, span) {
          let mut taken = true
          if guard.present { taken = run evaluatedBoolean(&mut machine.*, &mut local.*, guard.id) }
          if taken {
            let produced = run outcome(&mut machine.*, &mut local.*, result)
            List<Local>.truncate(&mut local.*, base)
            return move produced
          }
          List<Local>.truncate(&mut local.*, base)
        }
      }
      _ => { return run reject(&machine.*, Fault.Unavailable, span) }
    }
    arm = arm + usize.ONE
  }
  return run reject(&machine.*, Fault.InvalidValue, span)
}

effect fn patternConditionalOutcome<'source>(
  machine: &mut Machine<'source>, local: &mut List<Local>, id: HirId, span: Span, subject: HirId,
  thenBranch: HirId, elseBranch: HirRef,
) -> BranchOutcome ! Diagnostic | OutOfMemoryError ? &mut Allocator | &mut Types {
  let value = run expression(&mut machine.*, &mut local.*, subject)
  let position = match move checkedMatchPosition(&machine.*, id) {
    Option<usize>.Some {value: found} => found
    Option<usize>.None => { return run reject(&machine.*, Fault.Unavailable, span) }
  }
  let base = List<Local>.length(&local.*)
  if run bindArm(&mut machine.*, &mut local.*, position, usize.ZERO, &value, span) {
    let produced = run outcome(&mut machine.*, &mut local.*, thenBranch)
    List<Local>.truncate(&mut local.*, base)
    return move produced
  }
  if elseBranch.present { return run outcome(&mut machine.*, &mut local.*, elseBranch.id) }
  return BranchOutcome.Value {value: run retain(&mut machine.*, StaticData.Unit, span)}
}

effect fn conditionalOutcome<'source>(
  machine: &mut Machine<'source>, local: &mut List<Local>, span: Span, condition: HirId,
  thenBranch: HirId, elseBranch: HirRef,
) -> BranchOutcome ! Diagnostic | OutOfMemoryError ? &mut Allocator | &mut Types {
  if run evaluatedBoolean(&mut machine.*, &mut local.*, condition) {
    return run outcome(&mut machine.*, &mut local.*, thenBranch)
  }
  if elseBranch.present { return run outcome(&mut machine.*, &mut local.*, elseBranch.id) }
  return BranchOutcome.Value {value: run retain(&mut machine.*, StaticData.Unit, span)}
}

// A block's statements run in order; its last expression, if any, is its value (BLOCK-001).
effect fn blockOutcome<'source>(machine: &mut Machine<'source>, local: &mut List<Local>, span: Span, statements: Range) -> BranchOutcome
! Diagnostic | OutOfMemoryError ? &mut Allocator | &mut Types {
  let base = List<Local>.length(&local.*)
  let mut at = usize.ZERO
  while at < statements.length {
    let child = Module.child(run authored(&machine.*), statements, at)
    if at + usize.ONE == statements.length {
      if let Node.ExpressionStatement {expression: last} = Module.node(run authored(&machine.*), child) {
        run step(&mut machine.*, child)
        let produced = run outcome(&mut machine.*, &mut local.*, last)
        List<Local>.truncate(&mut local.*, base)
        return move produced
      }
    }
    let next = run statement(&mut machine.*, &mut local.*, child)
    if !flowContinues(&next) {
      List<Local>.truncate(&mut local.*, base)
      return BranchOutcome.Escape {flow: move next}
    }
    drop next
    at = at + usize.ONE
  }
  List<Local>.truncate(&mut local.*, base)
  return BranchOutcome.Value {value: run retain(&mut machine.*, StaticData.Unit, span)}
}

// Tests arm `arm` of the checked match at `position` against `subject` and, when it selects the
// subject, appends the arm's bindings as locals. A guard is the caller's to test.
effect fn bindArm<'source>(
  machine: &mut Machine<'source>, local: &mut List<Local>, position: usize, arm: usize,
  subject: &Interned<StaticData>, span: Span,
) -> bool ! Diagnostic | OutOfMemoryError ? &mut Allocator | &mut Types {
  let bindings = match move armProbe(&machine.*, position, arm, subject) {
    ArmProbe.Selected {bindings} => bindings
    ArmProbe.Rejected => { return false }
    ArmProbe.Unsupported => { return run reject(&machine.*, Fault.Unsupported, span) }
  }
  let mut at = usize.ZERO
  while at < bindings {
    let bound = match move armBinding(&machine.*, position, arm, at, subject) {
      Option<ArmBound>.Some {value} => move value
      Option<ArmBound>.None => { return run reject(&machine.*, Fault.Unsupported, span) }
    }
    let ArmBound {binder, value, view} = move bound
    // A `match &` binding is a shared view of its part of the subject.
    let held = match move view {
      Option<Interned<SemanticType>>.Some {value: ty} => {
        let closed = run closeType(&machine.*, &ty)
        let canonical = run staticViewType(&closed)
        run retain(&mut machine.*, StaticData.Borrow {ty: move canonical, target: move value}, span)
      }
      Option<Interned<SemanticType>>.None => move value
    }
    run List<Local>.append(&mut local.*, Local {binder: binder, mutable: false, value: move held})
    at = at + usize.ONE
  }
  return true
}

// Whether one checked arm selects a static subject.
union ArmProbe {
  // The arm tests a form static evaluation does not admit, or its facts are missing.
  Unsupported,
  Rejected,
  Selected {bindings: usize},
}

// One arm binding: the binder its uses resolve to, and its part of the subject.
struct ArmBound {
  binder: HirId,
  value: Interned<StaticData>,
  // The binding's checked type when it is a shared view of its part, absent when it holds it.
  view: Option<Interned<SemanticType>>,
}

// The position of the checked match that the match-shaped authored node `id` records.
fn checkedMatchPosition<'source>(machine: &Machine<'source>, id: HirId) -> Option<usize> {
  let window = checkedRange(machine)
  let index = checkedNodes(machine)
  let anchor = match move checkedAnchor(machine) {
    Option<Anchor>.Some {value} => move value
    Option<Anchor>.None => { return Option<usize>.none() }
  }
  return match move checkedBodyForExpression(machine) {
    Option<Shared<TypedBody>>.Some {value: body} => Shared<TypedBody>.with<Option<usize>>(&body, fn(checked: &TypedBody) -> Option<usize> {
      let nodes = TypedBody.nodeSlice(checked)
      let found = recorded(index, &anchor, id)
      let candidates = List<usize>.asSlice(&index.positions)
      let mut next = found.start
      while next < found.start + found.length {
        let at = candidates[next]
        if at >= window.start && at - window.start < window.length {
          if let CheckedNodeKind.Expression {form: CheckedExpression.Match {..}, ..} = &nodes[at].kind {
            return Option<usize>.some(at)
          }
        }
        next = next + usize.ONE
      }
      return Option<usize>.none()
    })
    Option<Shared<TypedBody>>.None => Option<usize>.none()
  }
}

fn armProbe<'source>(machine: &Machine<'source>, position: usize, arm: usize, subject: &Interned<StaticData>) -> ArmProbe {
  return match move checkedBodyForExpression(machine) {
    Option<Shared<TypedBody>>.Some {value: body} => Shared<TypedBody>.with<ArmProbe>(&body, fn(checked: &TypedBody) -> ArmProbe {
      let nodes = TypedBody.nodeSlice(checked)
      if let CheckedNodeKind.Expression {form: CheckedExpression.Match {arms, ..}, ..} = &nodes[position].kind {
        let listed = List<CheckedMatchArm>.asSlice(&arms)
        if arm >= listed.length { return ArmProbe.Unsupported }
        return selectArm(&listed[arm], subject)
      }
      return ArmProbe.Unsupported
    })
    Option<Shared<TypedBody>>.None => ArmProbe.Unsupported
  }
}

fn armBinding<'source>(machine: &Machine<'source>, position: usize, arm: usize, binding: usize, subject: &Interned<StaticData>) -> Option<ArmBound> {
  let anchor = match move checkedAnchor(machine) {
    Option<Anchor>.Some {value} => move value
    Option<Anchor>.None => { return Option<ArmBound>.none() }
  }
  return match move checkedBodyForExpression(machine) {
    Option<Shared<TypedBody>>.Some {value: body} => Shared<TypedBody>.with<Option<ArmBound>>(&body, fn(checked: &TypedBody) -> Option<ArmBound> {
      let nodes = TypedBody.nodeSlice(checked)
      if let CheckedNodeKind.Expression {form: CheckedExpression.Match {arms, ..}, ..} = &nodes[position].kind {
        let listed = List<CheckedMatchArm>.asSlice(&arms)
        if arm >= listed.length { return Option<ArmBound>.none() }
        let declared = List<CheckedNodeId>.asSlice(&listed[arm].bindings)
        if binding >= declared.length { return Option<ArmBound>.none() }
        let node = &nodes[declared[binding].index]
        if let CheckedNodeKind.Expression {ty, form: CheckedExpression.PatternBinding {path, access, ..}} = &node.kind {
          if access == CheckedBindingAccess.Exclusive { return Option<ArmBound>.none() }
          let part = match move projectPath(subject, List<CheckedPlaceStep>.asSlice(&path)) {
            Projected.Found {value} => move value
            _ => { return Option<ArmBound>.none() }
          }
          let mut view = Option<Interned<SemanticType>>.none()
          if access == CheckedBindingAccess.Shared { view = Option<Interned<SemanticType>>.some(Interned<SemanticType>.clone(&ty)) }
          return Option<ArmBound>.some(ArmBound {binder: Anchor.hir(&anchor, node.origin.node), value: move part, view: move view})
        }
      }
      return Option<ArmBound>.none()
    })
    Option<Shared<TypedBody>>.None => Option<ArmBound>.none()
  }
}

// Whether a checked arm's pattern and nested tests select `subject`, before its guard.
fn selectArm(arm: &CheckedMatchArm, subject: &Interned<StaticData>) -> ArmProbe {
  let top = match &arm.pattern {
    CheckedPattern.Universal => Option<bool>.some(true)
    CheckedPattern.EnumMember {member} => Interned<StaticData>.with<Option<bool>>(subject, fn(value: &StaticData) -> Option<bool> {
      return StaticValue.holdsEnumMember(value, member.ordinal)
    })
    CheckedPattern.Record {member} => match &member {
      Option<CheckedUnionMember>.Some {..} => Option<bool>.none()
      Option<CheckedUnionMember>.None => Option<bool>.some(true)
    }
    CheckedPattern.Variant {tag} => match move Interned<StaticData>.with<Option<usize>>(subject, StaticValue.variantTag) {
      Option<usize>.Some {value: held} => Option<bool>.some(held == tag)
      Option<usize>.None => Option<bool>.none()
    }
    CheckedPattern.Integer {magnitude, negative} => Interned<StaticData>.with<Option<bool>>(subject, fn(value: &StaticData) -> Option<bool> {
      return StaticValue.holdsInteger(value, magnitude, negative)
    })
    CheckedPattern.Boolean {value: expected} => Interned<StaticData>.with<Option<bool>>(subject, fn(value: &StaticData) -> Option<bool> {
      return StaticValue.holdsBoolean(value, expected)
    })
  }
  match move top {
    Option<bool>.Some {value: selected} => { if !selected { return ArmProbe.Rejected } }
    Option<bool>.None => { return ArmProbe.Unsupported }
  }
  let tests = List<CheckedPatternTest>.asSlice(&arm.tests)
  let mut at = usize.ZERO
  while at < tests.length {
    let part = match move projectPath(subject, List<CheckedPlaceStep>.asSlice(&tests[at].path)) {
      Projected.Found {value} => move value
      Projected.Mismatch => { return ArmProbe.Rejected }
      Projected.Unsupported => { return ArmProbe.Unsupported }
    }
    if let Option<CheckedUnionMember>.Some {..} = &tests[at].member { return ArmProbe.Unsupported }
    let tag = tests[at].tag
    let mut held = Option<bool>.none()
    if let Option<CheckedScalarTest>.Some {..} = &tests[at].scalar {
      held = Interned<StaticData>.with<Option<bool>>(&part, fn(value: &StaticData) -> Option<bool> { return StaticValue.holdsEnumMember(value, tag) })
    } else {
      held = match move Interned<StaticData>.with<Option<usize>>(&part, StaticValue.variantTag) {
        Option<usize>.Some {value: found} => Option<bool>.some(found == tag)
        Option<usize>.None => Option<bool>.none()
      }
    }
    match move held {
      Option<bool>.Some {value: selected} => { if !selected { return ArmProbe.Rejected } }
      Option<bool>.None => { return ArmProbe.Unsupported }
    }
    at = at + usize.ONE
  }
  return ArmProbe.Selected {bindings: List<CheckedNodeId>.length(&arm.bindings)}
}

// The part of a static subject a checked place path reaches.
union Projected {
  Found {value: Interned<StaticData>},
  // A variant step names a variant the subject does not hold.
  Mismatch,
  Unsupported,
}

fn projectPath(subject: &Interned<StaticData>, path: &[CheckedPlaceStep]) -> Projected {
  let mut current = Interned<StaticData>.clone(subject)
  let mut at = usize.ZERO
  while at < path.length {
    let mut ordinal = usize.ZERO
    match &path[at] {
      CheckedPlaceStep.VariantField {tag, field} => {
        match move Interned<StaticData>.with<Option<usize>>(&current, StaticValue.variantTag) {
          Option<usize>.Some {value: held} => { if held != tag { return Projected.Mismatch } }
          Option<usize>.None => { return Projected.Unsupported }
        }
        ordinal = field
      }
      CheckedPlaceStep.Field {index} => { ordinal = index }
      CheckedPlaceStep.Element {index} => { ordinal = index }
      CheckedPlaceStep.Member {..} => { return Projected.Unsupported }
    }
    let next = Interned<StaticData>.with<Option<Interned<StaticData>>>(&current, fn(value: &StaticData) -> Option<Interned<StaticData>> {
      return StaticValue.field(value, ordinal)
    })
    current = match move next {
      Option<Interned<StaticData>>.Some {value} => move value
      Option<Interned<StaticData>>.None => { return Projected.Unsupported }
    }
    at = at + usize.ONE
  }
  return Projected.Found {value: move current}
}


// A receiver call borrows its subject for a `self: &Self` method, as `value.isSome()`: the checker
// accepted the call, so a value whose shared view the parameter takes is passed as that view.
effect fn receiverView<'source>(machine: &mut Machine<'source>, value: &Interned<StaticData>, ty: &Interned<SemanticType>, span: Span)
-> Option<Interned<StaticData>> ! Diagnostic | OutOfMemoryError ? &mut Allocator | &mut Types {
  let referent = Interned<SemanticType>.with<Option<Interned<SemanticType>>>(ty, fn(shape: &SemanticType) -> Option<Interned<SemanticType>> {
    return match &shape.* {
      SemanticType.Reference {referent, access, ..} => {
        if access != Access.Shared { return Option<Interned<SemanticType>>.none() }
        return Option<Interned<SemanticType>>.some(Interned<SemanticType>.clone(&referent))
      }
      _ => Option<Interned<SemanticType>>.none()
    }
  })
  let target = match move referent {
    Option<Interned<SemanticType>>.Some {value: found} => move found
    Option<Interned<SemanticType>>.None => { return Option<Interned<StaticData>>.none() }
  }
  if !run StaticValue.matchesType(value, &target) { return Option<Interned<StaticData>>.none() }
  let canonical = run staticViewType(ty)
  let viewed = run retain(&mut machine.*, StaticData.Borrow {ty: move canonical, target: Interned<StaticData>.clone(value)}, span)
  return Option<Interned<StaticData>>.some(move viewed)
}

effect fn execute<'source>(
  machine: &mut Machine<'source>,
  selected: &SelectedStaticFunction,
  application: &Application,
  signature: &Shared<Result<Answer, NoRejection>>,
  args: &[Interned<StaticData>],
) -> Interned<StaticData> ! Diagnostic | OutOfMemoryError ? &mut Allocator | &mut Types {
  let parameters = List<HirId>.asSlice(&selected.parameters)
  if parameters.length != args.length {
    return run reject(&machine.*, Fault.InvalidHeader, selected.span)
  }
  let mut local = List<Local>.make()
  let mut at = usize.ZERO
  while at < parameters.length {
    let parameter = Module.node(run authored(&machine.*), parameters[at])
    let mut mutable = false
    if let Node.Parameter {mode: ParameterMode.Mutable, ..} = parameter { mutable = true }
    let mut supplied = Interned<StaticData>.clone(&args[at])
    if let Node.Parameter {annotation, ..} = parameter {
      let declared = run selectedSignatureType(signature, Option<usize>.some(at), application)
      match move declared {
        Option<Interned<SemanticType>>.Some {value: ty} => {
          if !run StaticValue.matchesType(&supplied, &ty) {
            supplied = match move run receiverView(&mut machine.*, &supplied, &ty, selected.span) {
              Option<Interned<StaticData>>.Some {value: viewed} => move viewed
              Option<Interned<StaticData>>.None => {
                return run reject(&machine.*, Fault.InvalidValue, Module.span(run authored(&machine.*), annotation))
              }
            }
          }
        }
        Option<Interned<SemanticType>>.None => {
          let mut failure = run diagnostic(&machine.*, Fault.Unsupported, Module.span(run authored(&machine.*), annotation))
          failure.missing = Option<MissingFact>.some(MissingFact.DeclaredType)
          fail move failure
        }
      }
    } else {
      return run reject(&machine.*, Fault.InvalidHeader, Module.span(run authored(&machine.*), parameters[at]))
    }
    run List<Local>.append(
      &mut local,
      Local {binder: parameters[at], mutable: mutable, value: move supplied},
    )
    at = at + usize.ONE
  }
  let flow = run statement(&mut machine.*, &mut local, selected.block)
  let returned = match move flow {
    Flow.Return {value} => move value
    Flow.Next => run retain(&mut machine.*, StaticData.Unit, selected.span)
    _ => run reject(&machine.*, Fault.InvalidControl, selected.span)
  }
  let resultType = selected.result
  let mut resultSpan = selected.span
  if resultType.present {
    resultSpan = Module.span(run authored(&machine.*), resultType.id)
  }
  let declaredResult = run selectedSignatureType(signature, Option<usize>.none(), application)
  match move declaredResult {
    Option<Interned<SemanticType>>.Some {value: ty} => {
      if !run StaticValue.matchesType(&returned, &ty) {
        return run reject(&machine.*, Fault.InvalidValue, resultSpan)
      }
    }
    Option<Interned<SemanticType>>.None => {
      let mut failure = run diagnostic(&machine.*, Fault.Unsupported, resultSpan)
      failure.missing = Option<MissingFact>.some(MissingFact.DeclaredType)
      fail move failure
    }
  }
  return move returned
}

effect fn chooseRoot<'source>(
  machine: &mut Machine<'source>,
  caller: &ModuleId,
  selectedName: &[u8],
  callSpan: Span,
) -> Chosen
! Diagnostic | OutOfMemoryError
? &mut Allocator | &mut Types {
  let attempted = run Effect.result(StaticPort.resolveRootDeclaration(
    &mut machine.port, caller, selectedName, callSpan,
  ))
  let resolved = match move attempted {
    Result<Result<DeclarationId, Shared<Rejection>>, Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError>.Success {value} => move value
    Result<Result<DeclarationId, Shared<Rejection>>, Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError>.Failure {error} => match move error {
      OutOfMemoryError {} => { fail OutOfMemoryError {} }
      Cycle {} => run reject(&machine.*, Fault.Unavailable, callSpan)
      InvalidModulePath {} => run reject(&machine.*, Fault.Unavailable, callSpan)
      RevisionMismatch {} => run reject(&machine.*, Fault.Unavailable, callSpan)
    }
  }
  let declaration = match move resolved {
    Result<DeclarationId, Shared<Rejection>>.Success {value} => move value
    Result<DeclarationId, Shared<Rejection>>.Failure {..} => {
      return run reject(&machine.*, Fault.Unavailable, callSpan)
    }
  }
  return run chooseDeclaration(&mut machine.*, &declaration, callSpan)
}

effect fn chooseDeclaration<'source>(
  machine: &mut Machine<'source>,
  declaration: &DeclarationId,
  callSpan: Span,
) -> Chosen
! Diagnostic | OutOfMemoryError
? &mut Allocator | &mut Types {
  let cursor = run declarationCursorFor(&mut machine.*, declaration, callSpan)
  let borrowed = StaticPort.sourceAtCursor(&machine.port, &cursor)
  let selected = match move borrowed {
    Option<&IndexedSource>.Some {value} => run StaticFunction.selectIndexed(value, declaration)
    Option<&IndexedSource>.None => { return run reject(&machine.*, Fault.Unavailable, callSpan) }
  }
  let function = match move selected {
    Result<SelectedStaticFunction, StaticHeaderRejection>.Success {value} => move value
    Result<SelectedStaticFunction, StaticHeaderRejection>.Failure {error} => {
      if error.fault == StaticHeaderFault.RuntimeFunction || error.fault == StaticHeaderFault.UnknownName {
        return run reject(&machine.*, Fault.Unavailable, callSpan)
      }
      return run reject(&machine.*, Fault.InvalidHeader, error.span)
    }
  }
  let attemptedSignature = run Effect.result(StaticPort.demandSignature(&mut machine.port, &function.declaration, callSpan))
  let signature = match move attemptedSignature {
    Result<Option<Shared<Result<Answer, NoRejection>>>, Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError>.Success {value} => match move value {
      Option<Shared<Result<Answer, NoRejection>>>.Some {value: answer} => move answer
      Option<Shared<Result<Answer, NoRejection>>>.None => {
        let mut failure = run diagnostic(&machine.*, Fault.Unsupported, callSpan)
        failure.missing = Option<MissingFact>.some(MissingFact.DeclaredType)
        fail move failure
      }
    }
    Result<Option<Shared<Result<Answer, NoRejection>>>, Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError>.Failure {error} => match move error {
      OutOfMemoryError {} => { fail OutOfMemoryError {} }
      Cycle {} => run reject(&machine.*, Fault.Cycle, callSpan)
      InvalidModulePath {} => run reject(&machine.*, Fault.Unavailable, callSpan)
      RevisionMismatch {} => run reject(&machine.*, Fault.Unavailable, callSpan)
    }
  }
  return Chosen {function: move function, cursor: move cursor, signature: move signature}
}

effect<'owner & 'env> fn demandSelected<'owner, 'env, 'source>(
  machine: &'owner mut Machine<'source>,
  chosen: Chosen,
  application: &'env Application,
  selectedName: &'env [u8],
  args: &'env [Interned<StaticData>],
  callSpan: Span,
) -> Interned<StaticData> ! Diagnostic | OutOfMemoryError ? &mut Allocator | &mut Types {
  let Chosen {function: selected, cursor, signature} = move chosen
  if !DeclarationId.equals(Application.bodyDeclaration(application), &selected.declaration) {
    let mut failure = run diagnostic(&machine.*, Fault.Unsupported, callSpan)
    failure.missing = Option<MissingFact>.some(MissingFact.TypedApplication)
    fail move failure
  }
  // A reached body is a dependency of the active semantic query, including cache hits.
  // Existing execution frames also consume depth. Keep one checking slot at the exhausted
  // boundary so a completed value can retain its existing cache-hit behavior without a frame.
  let activeDepth = List<Frame>.length(&machine.active)
  let mut selectionDepth = usize.ONE
  if activeDepth < machine.limits.depth {selectionDepth = machine.limits.depth - activeDepth}
  let reached = run Effect.result(StaticPort.demandStaticBody(&mut machine.port, application, args, callSpan, selectionDepth))
  return run completeSelectedDemand(move machine, Chosen {
    function: move selected, cursor: move cursor, signature: move signature,
  }, application, selectedName, args, callSpan, move reached)
}

effect<'owner & 'env> fn completeSelectedDemand<'owner, 'env, 'source>(
  machine: &'owner mut Machine<'source>,
  chosen: Chosen,
  application: &'env Application,
  selectedName: &'env [u8],
  args: &'env [Interned<StaticData>],
  callSpan: Span,
  reached: Result<Option<Shared<Result<Answer, NoRejection>>>, Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | Diagnostic>,
) -> Interned<StaticData> ! Diagnostic | OutOfMemoryError ? &mut Allocator | &mut Types {
  let Chosen {function: selected, cursor, signature} = move chosen
  let body = match move reached {
    Result<Option<Shared<Result<Answer, NoRejection>>>, Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | Diagnostic>.Success {value} => match move value {
      Option<Shared<Result<Answer, NoRejection>>>.Some {value: answer} => match move Shared<Result<Answer, NoRejection>>.with<Option<Result<Shared<TypedBody>, Shared<Rejection>>>>(
        &answer,
        bodyFromAnswer,
      ) {
        Option<Result<Shared<TypedBody>, Shared<Rejection>>>.Some {value: checked} => match move checked {
          Result<Shared<TypedBody>, Shared<Rejection>>.Success {value: body} => move body
          Result<Shared<TypedBody>, Shared<Rejection>>.Failure {error: rejected} => {
            let span = Shared<Rejection>.with<Span>(&rejected, fn(value: &Rejection) -> Span { return value.span })
            let fault = Shared<Rejection>.with<Fault>(&rejected, fn(value: &Rejection) -> Fault {
              return match &value.staticFailure {
                Option<Diagnostic>.Some {value: cause} => cause.fault
                _ => Fault.Unsupported
              }
            })
            let mut failure = run diagnostic(&machine.*, fault, span)
            // The refused body is the call's own frame, so a caller can locate the refusal at
            // the call in its own module when the body is another module's.
            run List<TraceStep>.append(&mut failure.trace, TraceStep {
              name: run Bytes.copy(selectedName), arguments: run copyArguments(args), span: callSpan,
              module: Option<ModuleId>.some(ModuleId.copy(DeclarationId.moduleId(&selected.declaration))),
            })
            failure.rejection = Option<Shared<Rejection>>.some(move rejected)
            fail move failure
          }
        }
        Option<Result<Shared<TypedBody>, Shared<Rejection>>>.None => {
          let mut failure = run diagnostic(&machine.*, Fault.Unsupported, callSpan)
          failure.missing = Option<MissingFact>.some(MissingFact.CheckedBody)
          fail move failure
        }
      }
      Option<Shared<Result<Answer, NoRejection>>>.None => run reject(&machine.*, Fault.Unavailable, callSpan)
    }
    Result<Option<Shared<Result<Answer, NoRejection>>>, Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | Diagnostic>.Failure {error} => match move error {
      Diagnostic {fault, code, span, target, message, origin, byteOffset, rejection, needed, missing, trace} => {
        fail Diagnostic {fault: fault, code: code, span: span, target: target, message: move message, origin: move origin,
          byteOffset: move byteOffset, rejection: move rejection, needed: move needed, missing: move missing, trace: move trace}
      }
      OutOfMemoryError {} => { fail OutOfMemoryError {} }
      Cycle {} => run reject(&machine.*, Fault.Cycle, callSpan)
      InvalidModulePath {} => run reject(&machine.*, Fault.Unavailable, callSpan)
      RevisionMismatch {} => run reject(&machine.*, Fault.Unavailable, callSpan)
    }
  }
  // Checked applications include elided lifetime binders as well as written generics.
  // Validate against the same resolved signature that supplied those completed arguments.
  let operation = selected.operation
  if !Shared<Result<Answer, NoRejection>>.with<bool>(&signature, fn(answer: &Result<Answer, NoRejection>) -> bool {
    return signatureApplicationArityMatches(answer, application, operation)
  }) {
    let mut failure = run diagnostic(&machine.*, Fault.Unsupported, callSpan)
    failure.missing = Option<MissingFact>.some(MissingFact.TypedApplication)
    fail move failure
  }
  let identity = match move run Pool.intern(&mut machine.applications, application) {
    Option<Identity>.Some {value} => value.semantic
    Option<Identity>.None => {
      let mut failure = run diagnostic(&machine.*, Fault.Unsupported, callSpan)
      failure.missing = Option<MissingFact>.some(MissingFact.TypedApplication)
      fail move failure
    }
  }
  let cached = run completed(&machine.*, identity, args)
  if let Option<Interned<StaticData>>.Some {value} = move cached {
    return move value
  }
  let active = List<Frame>.asSlice(&machine.active)
  let mut at = usize.ZERO
  while at < active.length {
    if active[at].application == identity && run sameArguments(
      List<Interned<StaticData>>.asSlice(&active[at].arguments),
      args,
    ) {
      return run reject(&machine.*, Fault.Cycle, callSpan)
    }
    at = at + usize.ONE
  }
  if List<Frame>.length(&machine.active) >= machine.limits.depth {
    return run reject(&machine.*, Fault.DepthLimit, callSpan)
  }
  let nodes = run indexedSlot(&mut machine.*, &body)
  run List<Frame>.append(
    &mut machine.active,
    Frame {
      application: identity,
      instance: run Application.copy(application),
      bindings: run Application.bindings(application),
      module: ModuleId.copy(DeclarationId.moduleId(&selected.declaration)),
      name: run Bytes.copy(selectedName),
      arguments: run copyArguments(args),
      body: move body,
      nodes: nodes,
      window: Range {start: usize.ZERO, length: usize.MAX},
      span: callSpan,
    },
  )
  let previous = copyCurrent(&machine.*)
  machine.current = Option<AuthoredCursor>.some(move cursor)
  let reservation = FrameReservation {machine: move machine, previous: move previous}
  let use = effect fn(resource: &mut FrameReservation<'owner, 'source>) -> Interned<StaticData>
  ! Diagnostic | OutOfMemoryError
  ? &mut Allocator | &mut Types {
    let value = run execute(&mut resource.machine.*, &selected, application, &signature, args)
    run publish(&mut resource.machine.*, identity, args, &value, callSpan)
    return move value
  }
  let release = effect fn(resource: &mut FrameReservation<'owner, 'source>) -> () {
    let last = List<Frame>.length(&resource.machine.*.active) - usize.ONE
    let removed = List<Frame>.remove(&mut resource.machine.*.active, last)
    drop removed
    resource.machine.*.current = copyPrevious(&resource.previous)
    return ()
  }
  return run Effect.useReleaseNonParking(move reservation, move use, move release)
}

/// Demands a static function without written generic parameters from owned static values.
/// Elided lifetime arguments are completed before the shared application validation.
/// The active frame is released on failure or interruption.
pub effect<'owner & 'env> fn demand<'owner, 'env, 'source>(
  machine: &'owner mut Machine<'source>,
  selectedName: &'env [u8],
  args: &'env [Interned<StaticData>],
  callSpan: Span,
) -> Interned<StaticData> ! Diagnostic | OutOfMemoryError ? &mut Allocator | &mut Types {
  let caller = ModuleId.copy(&machine.root)
  let chosen = run chooseRoot(&mut machine.*, &caller, selectedName, callSpan)
  if chosen.function.generics.length > usize.ZERO {
    let mut failure = run diagnostic(&machine.*, Fault.Unsupported, callSpan)
    failure.missing = Option<MissingFact>.some(MissingFact.TypedApplication)
    fail move failure
  }
  let inferred = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(&chosen.signature, rootLifetimeArgumentCount)
  let lifetimeCount = match move inferred {
    Option<usize>.Some {value} => value
    Option<usize>.None => {
      let mut failure = run diagnostic(&machine.*, Fault.Unsupported, callSpan)
      failure.missing = Option<MissingFact>.some(MissingFact.TypedApplication)
      fail move failure
    }
  }
  let mut arguments = List<Argument>.make()
  let mut at = usize.ZERO
  while at < lifetimeCount {
    // Static values retain their storage rather than borrowing from the demand caller.
    let lifetime = run Types.internLifetime(Lifetime.Static)
    run List<Argument>.append(&mut arguments, Argument.Lifetime {value: move lifetime})
    at = at + usize.ONE
  }
  let application = Application {
    target: ApplicationTarget.Named {declaration: DeclarationId.copy(&chosen.function.declaration)},
    argumentOrdinals: run Application.denseOrdinals(List<Argument>.length(&arguments)),
    arguments: move arguments,
    scopes: List<ScopeBinding>.make(),
    statics: List<StaticSlot>.make(),
  }
  return run demandSelected(move machine, move chosen, &application, selectedName, args, callSpan)
}

/// Demands a checked, closed application with its exact generic arguments and selected evidence.
pub effect<'owner & 'env> fn demandApplication<'owner, 'env, 'source>(
  machine: &'owner mut Machine<'source>,
  application: &'env Application,
  selectedName: &'env [u8],
  args: &'env [Interned<StaticData>],
  callSpan: Span,
) -> Interned<StaticData> ! Diagnostic | OutOfMemoryError ? &mut Allocator | &mut Types {
  if let ApplicationTarget.Operation {..} = &application.target {
    return run reject(&machine.*, Fault.StaticPhaseViolation, callSpan)
  }
  let chosen = run chooseDeclaration(&mut machine.*, Application.bodyDeclaration(application), callSpan)
  return run demandSelected(move machine, move chosen, application, selectedName, args, callSpan)
}

/// Authenticated evaluation of one sealed finite sequence, retained once for all its iterations.
pub struct SequenceEvidence {
  checked: Shared<Result<Answer, NoRejection>>,
  value: Interned<StaticData>,
}

/// A bounded ordinal in an actually evaluated sequence. Callers cannot fabricate the payload.
pub struct IterationEvidence {
  sequence: Shared<SequenceEvidence>,
  ordinal: usize,
}

pub effect fn evaluateSequence<'source>(machine: &mut Machine<'source>, answer: &Shared<Result<Answer, NoRejection>>,
  bindings: &[Binding], expression: HirId, expressionSpan: Span) -> SequenceEvidence
! Diagnostic | OutOfMemoryError ? &mut Allocator | &mut Types {
  let root = match move Shared<Result<Answer, NoRejection>>.with<Option<CheckedRoot>>(answer, checkedRoot) {
    Option<CheckedRoot>.Some {value} => move value
    Option<CheckedRoot>.None => run reject(&machine.*, Fault.Unavailable, expressionSpan)
  }
  let evaluated = run evaluate(&mut machine.*, &root, bindings, expression)
  if Interned<StaticData>.with<usize>(&evaluated, StaticValue.sequenceLength) == usize.MAX {
    return run reject(&machine.*, Fault.StaticPhaseViolation, expressionSpan)
  }
  return SequenceEvidence {checked: Shared<Result<Answer, NoRejection>>.clone(answer), value: move evaluated}
}

pub fn sequenceLength(evidence: &SequenceEvidence) -> usize {
  return Interned<StaticData>.with<usize>(&evidence.value, StaticValue.sequenceLength)
}

pub fn iteration(sequence: &Shared<SequenceEvidence>, ordinal: usize) -> Option<IterationEvidence> {
  if ordinal >= Shared<SequenceEvidence>.with<usize>(sequence, sequenceLength) { return Option<IterationEvidence>.none() }
  return Option<IterationEvidence>.some(IterationEvidence {sequence: Shared<SequenceEvidence>.clone(sequence), ordinal: ordinal})
}

pub fn copyIteration(evidence: &IterationEvidence) -> IterationEvidence {
  return IterationEvidence {sequence: Shared<SequenceEvidence>.clone(&evidence.sequence), ordinal: evidence.ordinal}
}

pub fn iterationChecked(evidence: &IterationEvidence) -> Shared<Result<Answer, NoRejection>> {
  return Shared<SequenceEvidence>.with<Shared<Result<Answer, NoRejection>>>(&evidence.sequence, fn(sequence: &SequenceEvidence) -> Shared<Result<Answer, NoRejection>> {
    return Shared<Result<Answer, NoRejection>>.clone(&sequence.checked)
  })
}

pub fn iterationValue(evidence: &IterationEvidence) -> Option<Interned<StaticData>> {
  return Shared<SequenceEvidence>.with<Option<Interned<StaticData>>>(&evidence.sequence, fn(sequence: &SequenceEvidence) -> Option<Interned<StaticData>> {
    return iterationValueAt(sequence, evidence.ordinal)
  })
}

pub fn iterationType(evidence: &IterationEvidence) -> Option<Interned<SemanticType>> {
  let actual = iterationValue(evidence)
  if let Option<Interned<StaticData>>.Some {value} = move actual {
    let field = Interned<StaticData>.with<Option<StaticValue.FieldParts>>(&value, StaticValue.fieldParts)
    if let Option<StaticValue.FieldParts>.Some {value: descriptor} = move field {return Option<Interned<SemanticType>>.some(move descriptor.ty)}
    // Each test descriptor keeps its own test's exact callable type (TEST-004).
    let test = Interned<StaticData>.with<Option<Interned<SemanticType>>>(&value, StaticValue.testDescriptorType)
    if let Option<Interned<SemanticType>>.Some {value: descriptor} = move test {return Option<Interned<SemanticType>>.some(move descriptor)}
  }
  return Shared<SequenceEvidence>.with<Option<Interned<SemanticType>>>(&evidence.sequence, fn(sequence: &SequenceEvidence) -> Option<Interned<SemanticType>> {
    return Interned<StaticData>.with<Option<Interned<SemanticType>>>(&sequence.value, sequenceElementType)
  })
}

fn sequenceElementType(value: &StaticData) -> Option<Interned<SemanticType>> {
  if let StaticData.Sequence {ty, ..} = &value.* {
    return Interned<SemanticType>.with<Option<Interned<SemanticType>>>(&ty, CheckedIntrinsic.staticSequenceElement)
  }
  return Option<Interned<SemanticType>>.none()
}

/// Charges each residual occurrence to the same evaluator budget used by the iterable.
pub effect fn generatedWork<'source>(machine: &mut Machine<'source>, syntax: HirId) -> () ! Diagnostic | OutOfMemoryError ? &mut Allocator {
  return run step(&mut machine.*, syntax)
}

fn iterationValueAt(sequence: &SequenceEvidence, ordinal: usize) -> Option<Interned<StaticData>> {
  return Interned<StaticData>.with<Option<Interned<StaticData>>>(&sequence.value, fn(value: &StaticData) -> Option<Interned<StaticData>> {
    return StaticValue.sequenceElement(value, ordinal)
  })
}

/// Accounts for a selected value retained by a residual occurrence across the whole expansion.
pub effect fn retainGenerated<'source>(machine: &mut Machine<'source>, value: &Interned<StaticData>, syntax: HirId) -> ()
! Diagnostic | OutOfMemoryError ? &mut Allocator {
  let bytes = Interned<StaticData>.with<usize>(value, StaticValue.size)
  if machine.retainedBytes > machine.limits.valueBytes || bytes > machine.limits.valueBytes - machine.retainedBytes {
    return run reject(&machine.*, Fault.ValueLimit, Module.span(run authored(&machine.*), syntax))
  }
  machine.retainedBytes = machine.retainedBytes + bytes
  return ()
}


// Whether `checked` is a body of the machine's root module, whose source owns its HIR positions.
fn rootChecked(checked: &CheckedRoot, root: &ModuleId) -> bool {
  return Shared<TypedBody>.with<bool>(&checked.body, fn(body: &TypedBody) -> bool {
    return ModuleId.equals(DeclarationId.moduleId(TypedBody.declarationId(body)), root)
  })
}

/// Seals a semantic checkpoint.
pub fn checkedCheckpoint(body: Shared<TypedBody>) -> CheckedRoot {
  return CheckedRoot {body: move body}
}

/// Completed checked work in the lexical prefix leading to a static control boundary.
pub union PrefixWork {
  Statement {pub syntax: HirId},
  Expression {pub syntax: HirId},
  Binding {pub binder: HirId, pub start: usize, pub value: Interned<StaticData>},
  Iteration {pub syntax: HirId, pub start: usize, pub end: usize, pub binder: HirId, pub value: Interned<StaticData>},
}

pub fn copyPrefix(work: &PrefixWork) -> PrefixWork {
  return match &work.* {
    PrefixWork.Statement {syntax} => PrefixWork.Statement {syntax: syntax}
    PrefixWork.Expression {syntax} => PrefixWork.Expression {syntax: syntax}
    PrefixWork.Binding {binder, start, value} => PrefixWork.Binding {binder: binder, start: start, value: StaticValue.copy(&value)}
    PrefixWork.Iteration {syntax, start, end, binder, value} => PrefixWork.Iteration {syntax: syntax,
      start: start, end: end, binder: binder, value: StaticValue.copy(&value)}
  }
}

/// Replays only completed checked statements before evaluating the next checked control root.
/// Every invocation starts from evaluator arguments, so nested-arm checking cannot replay a
/// mutation against a state already changed by an inner checking boundary.
struct PreparedPrefix {
  root: ModuleId,
  local: List<Local>,
}

pub effect fn evaluatePrefix<'source>(machine: &mut Machine<'source>, checked: &CheckedRoot,
  bindings: &[Binding], supplied: &[Binding], prefix: &[PrefixWork], id: HirId) -> Interned<StaticData>
! Diagnostic | OutOfMemoryError ? &mut Allocator | &mut Types {
  let prepared = run preparePrefix(&mut machine.*, checked, bindings, supplied, prefix)
  let PreparedPrefix {root: _, local: preparedLocal} = move prepared
  let mut local = move preparedLocal
  return run expression(&mut machine.*, &mut local, id)
}

effect fn preparePrefix<'source>(machine: &mut Machine<'source>, checked: &CheckedRoot,
  bindings: &[Binding], supplied: &[Binding], prefix: &[PrefixWork]) -> PreparedPrefix
! Diagnostic | OutOfMemoryError ? &mut Allocator | &mut Types {
  let root = ModuleId.copy(&machine.root)
  let cursor = run rootCursor(&mut machine.*, checked)
  if !rootChecked(checked, &root) { return run reject(&machine.*, Fault.Unavailable, Span.make(usize.ZERO, usize.ZERO)) }
  machine.current = Option<AuthoredCursor>.some(move cursor)
  machine.rootBody = Option<Shared<TypedBody>>.some(Shared<TypedBody>.clone(&checked.body))
  machine.rootNodes = run indexShared(&checked.body)
  setCheckedRange(&mut machine.*, Range {start: usize.ZERO, length: usize.MAX})
  run supplyBindings(&mut machine.*, supplied)
  let mut local = run List<Local>.makeWithCapacity(bindings.length)
  let mut at = usize.ZERO
  while at < bindings.length {
    run List<Local>.append(&mut local, Local {binder: bindings[at].binder, mutable: false,
      value: StaticValue.copy(&bindings[at].value)})
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < prefix.length {
    match &prefix[at] {
      PrefixWork.Statement {syntax} => {
        let flow = run statement(&mut machine.*, &mut local, syntax)
        match move flow {
          Flow.Next => ()
          // The checker still types an unreachable tail. Its preceding lexical initializers
          // can establish the static values that tail uses without changing execution's Return.
          Flow.Return {value} => { drop value }
          _ => { return run reject(&machine.*, Fault.InvalidControl, Module.span(run authored(&machine.*), syntax)) }
        }
      }
      PrefixWork.Expression {syntax} => {
        let ignored = run expression(&mut machine.*, &mut local, syntax)
        drop ignored
      }
      PrefixWork.Binding {binder, start, value} => {
        setCheckedRange(&mut machine.*, Range {start: start, length: usize.MAX - start})
        run List<Local>.append(&mut local, Local {binder: binder, mutable: false, value: StaticValue.copy(&value)})
      }
      PrefixWork.Iteration {syntax, start, end, binder, value} => {
        let flow = run occurrenceFlow(&mut machine.*, &mut local, syntax, start, end, binder, &value)
        if !flowContinues(&flow) { return run reject(&machine.*, Fault.InvalidControl, Module.span(run authored(&machine.*), syntax)) }
      }
    }
    at = at + usize.ONE
  }
  return PreparedPrefix {root: move root, local: move local}
}


// Execution enters the exact checked occurrence and retains mutations to enclosing locals.
// The body's source spelling repeats between iterations; its checked identities do not.
effect fn occurrenceFlow<'source>(machine: &mut Machine<'source>, local: &mut List<Local>,
  syntax: HirId, start: usize, end: usize, binder: HirId, value: &Interned<StaticData>) -> Flow
! Diagnostic | OutOfMemoryError ? &mut Allocator | &mut Types {
  let saved = checkedRange(&machine.*)
  setCheckedRange(&mut machine.*, Range {start: start, length: end - start})
  let length = List<Local>.length(&local.*)
  run List<Local>.append(&mut local.*, Local {binder: binder, mutable: false, value: StaticValue.copy(value)})
  let attempted = run Effect.result(statement(&mut machine.*, &mut local.*, syntax))
  List<Local>.truncate(&mut local.*, length)
  setCheckedRange(&mut machine.*, saved)
  return match move attempted {
    Result<Flow, Diagnostic | OutOfMemoryError>.Success {value: completed} => move completed
    Result<Flow, Diagnostic | OutOfMemoryError>.Failure {error} => { fail move error }
  }
}

fn checkedRange<'source>(machine: &Machine<'source>) -> Range {
  let frames = List<Frame>.asSlice(&machine.active)
  if frames.length > usize.ZERO { return frames[frames.length - usize.ONE].window }
  return machine.window
}
fn setCheckedRange<'source>(machine: &mut Machine<'source>, window: Range) {
  let frames = List<Frame>.asMutSlice(&mut machine.active)
  if frames.length > usize.ZERO { frames[frames.length - usize.ONE].window = window }
  else { machine.window = window }
}
