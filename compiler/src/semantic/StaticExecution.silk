//! Demand-driven execution of static function bodies and evaluator-local control flow.

import hir.Hir {HirId, HirRef, InfixOperator, Module, Node, OwnerKind, PrefixOperator, Range, Sign}
import hir.Intern {Symbol}
import semantic.CallInput {CallInput, Arguments as CallArguments}
import lexer.Span {Span}
import semantic.DeclarationId {DeclarationId}
import semantic.FinalProfile {FinalProfile}
import semantic.Intrinsic {Member as IntrinsicMember, Primitive as IntrinsicPrimitive, spelling as intrinsicSpelling}
import semantic.Lifetime {Lifetime}
import semantic.ModuleId {InvalidModulePath, ModuleId}
import semantic.ModuleIndex {Candidate, IndexedDeclaration, ModuleIndex}
import semantic.Query {Cycle}
import semantic.Rejection {Rejection}
import semantic.Semantic {Answer, Outcome, StaticCall, StaticPort, Value}
import semantic.SourceIndex {AuthoredCursor, IndexedSource, NoRejection, RevisionMismatch}
import semantic.SourceRevision {Observation}
import semantic.SourceUnit {SourceUnit}
import semantic.Specialization {ScopeBinding, Application, Identity, Pool, StaticSlot, Target as ApplicationTarget}
import semantic.StaticFunction
import semantic.StaticFunction {
  StaticFunction as SelectedStaticFunction,
  Rejection as StaticHeaderRejection,
  HeaderFault as StaticHeaderFault,
}
import semantic.StaticText
import semantic.StaticText {FaultKind as StaticTextFaultKind, Operation as StaticTextOperation}
import semantic.StaticValue
import semantic.StaticValue {
  Fault as StaticFault,
  FloatType as StaticFloatType,
  IntegerType as StaticIntegerType,
  Sign as StaticSign,
  Value as StaticData,
}
import semantic.Target {Target as MachineTarget}
import semantic.Type {Argument, Binding as TypeBinding, RowParameter, Type as SemanticType}
import semantic.TypedBody {EnumMember as CheckedEnumMember, Expression as CheckedExpression, NodeId as CheckedNodeId, NodeKind as CheckedNodeKind, TypedBody}
import silk.allocator {Allocator, OutOfMemoryError}
import silk.bytes {Bytes}
import silk.effect {Effect}
import silk.format {ParseError}
import silk.option {Option}
import silk.pointer {Pointer}
import silk.result {Result}
