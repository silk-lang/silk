import silk.u8
import silk.u32
import silk.u64
import silk.usize
import silk.vector {Vector}

/// Deterministic work limits for one demand graph.
pub struct Limits {
  pub steps: usize
  pub depth: usize
  pub valueBytes: usize
}

/// A source-defined failure; related calls are ordered from the root to the failing frame.
pub enum Fault {
  InvalidHeader,
  Unavailable,
  StaticPhaseViolation,
  Unsupported,
  InvalidValue,
  InvalidControl,
  Overflow,
  DivisionByZero,
  CompileError,
  Cycle,
  StepLimit,
  DepthLimit,
  ValueLimit,
}

/// A fact required to execute a selected call that source HIR alone cannot supply.
pub enum MissingFact {
  TypedApplication,
  CheckedBody,
  CheckedExpression,
  CheckedSource,
  DeclaredType,
  IntrinsicOperation,
  /// No final build profile was supplied to this static evaluation.
  ProfileInput,
}

pub struct TraceStep {
  pub name: Bytes
  pub arguments: Vector<Shared<StaticData>>
  pub span: Span
}

pub struct Diagnostic {
  pub fault: Fault
  pub code: &'static [u8]
  pub span: Span
  pub target: MachineTarget
  pub message: Option<Bytes>
  pub origin: Option<Span>
  pub byteOffset: Option<u64>
  pub rejection: Option<Shared<Rejection>>
  pub needed: Option<Needed>
  pub missing: Option<MissingFact>
  pub trace: Vector<TraceStep>
}

/// A reached checked constant whose value must be demanded by its selected declaration.
pub struct Needed {
  pub module: ModuleId
  pub expression: HirId
  pub declaration: Shared<DeclarationId>
}

fn faultCode(fault: Fault) -> &'static [u8] {
  return match fault {
    Fault.InvalidHeader => b"SEM0176"
    Fault.Unavailable => b"SEM0176"
    Fault.StaticPhaseViolation => b"SEM0176"
    Fault.Unsupported => b"SEM0176"
    Fault.InvalidValue => b"SEM0176"
    Fault.InvalidControl => b"SEM0176"
    Fault.Overflow => b"SEM0176"
    Fault.DivisionByZero => b"SEM0176"
    Fault.CompileError => b"SEM0177"
    Fault.Cycle => b"SEM0178"
    Fault.StepLimit => b"SEM0179"
    Fault.DepthLimit => b"SEM0180"
    Fault.ValueLimit => b"SEM0181"
  }
}

/// The stable source diagnostic code for a failed static demand.
pub fn code(diagnostic: &Diagnostic) -> &[u8] {
  return diagnostic.code
}

/// One immutable static value made available at an authored binder.
pub struct Binding {
  pub module: ModuleId
  pub binder: HirId
  pub value: Shared<StaticData>
}

/// A checked expression tree paired with the source observation that owns its HIR positions.
pub struct CheckedRoot {
  body: Shared<TypedBody>
  source: Shared<Observation>
}

/// Extracts a checked tree and its source together from one successful semantic answer.
pub fn checkedRoot(answer: &Result<Answer, NoRejection>) -> Option<CheckedRoot> {
  return match &answer.* {
    Result<Answer, NoRejection>.Success {value} => match &value.outcome {
      Outcome.Success {value: Value.Body {body, source}} => Option.some<CheckedRoot>(CheckedRoot {
        body: Shared.clone<TypedBody>(&body),
        source: Shared.clone<Observation>(&source),
      })
      _ => Option.none<CheckedRoot>()
    }
    Result<Answer, NoRejection>.Failure {error: _} => Option.none<CheckedRoot>()
  }
}

struct RetainedBinding {
  module: ModuleId
  binder: HirId
  value: Shared<StaticData>
  chargedBytes: usize
}

struct Local {
  binder: HirId
  mutable: bool
  value: Shared<StaticData>
}

struct Frame {
  application: usize
  // The closed application this frame executes; its bindings close the calls it reaches.
  instance: Application
  module: ModuleId
  name: Bytes
  arguments: Vector<Shared<StaticData>>
  body: Shared<TypedBody>
  span: Span
}

struct Complete {
  application: usize
  arguments: Vector<Shared<StaticData>>
  value: Shared<StaticData>
}

struct TextOrigin {
  address: usize
  value: Shared<StaticData>
  span: Span
}

struct Chosen {
  function: SelectedStaticFunction
  cursor: AuthoredCursor
  signature: Shared<Result<Answer, NoRejection>>
}

struct FrameReservation<'a, 'source> {
  machine: &'a mut Machine<'source>
  previous: Option<AuthoredCursor>
}

struct SourceReservation<'a, 'source> {
  machine: &'a mut Machine<'source>
  previous: Option<AuthoredCursor>
  previousBody: Option<Shared<TypedBody>>
  suppliedBase: usize
}

union Flow {
  Next,
  Break,
  Continue,
  Return {value: Shared<StaticData>},
}

/// One held source and target for static applications. No body executes during construction.
pub struct Machine<'source> {
  port: StaticPort<'source>
  root: ModuleId
  current: Option<AuthoredCursor>
  rootBody: Option<Shared<TypedBody>>
  target: MachineTarget
  limits: Limits
  steps: usize
  retainedBytes: usize
  applications: Pool
  active: Vector<Frame>
  supplied: Vector<RetainedBinding>
  complete: Vector<Complete>
  textOrigins: Vector<TextOrigin>
  // The closed application whose body roots are evaluated outside any active frame.
  instance: Option<Application>
}

/// Borrows one held semantic store without demanding any static body.
pub effect fn make<'source>(port: StaticPort<'source>, root: &ModuleId, limits: Limits) -> Machine<
  'source,
> ! OutOfMemoryError ? &mut Allocator {
  let target = StaticPort.target(&port)
  return Machine {
    port: move port,
    root: run ModuleId.copy(root),
    current: Option.none<AuthoredCursor>(),
    rootBody: Option.none<Shared<TypedBody>>(),
    target: target,
    limits: move limits,
    steps: usize.ZERO,
    retainedBytes: usize.ZERO,
    applications: Pool.make(),
    active: Vector.make<Frame>(),
    supplied: Vector.make<RetainedBinding>(),
    complete: Vector.make<Complete>(),
    textOrigins: Vector.make<TextOrigin>(),
    instance: Option.none<Application>(),
  }
}

/// Evaluates later roots inside one closed application: calls written in its generic body reach
/// the callees its bindings select.
pub effect fn useInstance<'source>(machine: &mut Machine<'source>, application: &Application) -> ()
! OutOfMemoryError ? &mut Allocator {
  machine.instance = Option.some<Application>(run Application.copy(application))
  return ()
}

// Closes a reached call written in the executing body's binders with that body's application.
effect fn closeCall<'source>(machine: &Machine<'source>, call: Application) -> Application
! OutOfMemoryError ? &mut Allocator {
  let frames = Vector.asSlice<Frame>(&machine.active)
  if frames.length > usize.ZERO {
    return run Application.substitute(&call, &frames[frames.length - usize.ONE].instance)
  }
  if let Option<Application>.Some {value: root} = &machine.instance {
    return run Application.substitute(&call, &root)
  }
  return move call
}

/// Borrows the active semantic port briefly between evaluation attempts.
pub fn port<'borrow, 'source>(machine: &'borrow mut Machine<'source>) -> &'borrow mut StaticPort<'source> {
  return &mut machine.port
}

fn staticDataAddress(value: &StaticData) -> usize {
  return Pointer.address<StaticData>(Pointer.fromRef<StaticData>(value))
}

fn sharedDataAddress(value: &Shared<StaticData>) -> usize {
  return Shared.with<StaticData, usize>(value, staticDataAddress)
}

/// Retains a text value's original authored span independently of its value identity.
pub effect fn rememberTextOrigin<'source>(machine: &mut Machine<'source>, value: &Shared<StaticData>, span: Span) -> ()
! Diagnostic | OutOfMemoryError
? &mut Allocator {
  let address = sharedDataAddress(value)
  let origins = Vector.asSlice<TextOrigin>(&machine.textOrigins)
  let mut at = usize.ZERO
  while at < origins.length {
    if origins[at].address == address { return () }
    at = at + usize.ONE
  }
  let bytes = retainedValueBytes(&machine.*, value)
  if machine.retainedBytes > machine.limits.valueBytes || bytes > machine.limits.valueBytes - machine.retainedBytes {
    return run reject(&machine.*, Fault.ValueLimit, span)
  }
  run Vector.append<TextOrigin>(&mut machine.textOrigins, TextOrigin {
    address: address,
    value: Shared.clone<StaticData>(value),
    span: span,
  })
  machine.retainedBytes = machine.retainedBytes + bytes
  return ()
}

/// Finds the original authored span of a text value retained by this machine.
pub fn textOrigin<'source>(machine: &Machine<'source>, value: &Shared<StaticData>) -> Option<Span> {
  let address = sharedDataAddress(value)
  let origins = Vector.asSlice<TextOrigin>(&machine.textOrigins)
  let mut at = usize.ZERO
  while at < origins.length {
    if origins[at].address == address { return Option.some<Span>(origins[at].span) }
    at = at + usize.ONE
  }
  return Option.none<Span>()
}

// Provenance owns each text allocation until the machine is released. Aliases in supplied
// bindings and completed calls share that charge rather than charging its bytes again.
fn retainedValueBytes<'source>(machine: &Machine<'source>, value: &Shared<StaticData>) -> usize {
  let address = sharedDataAddress(value)
  let origins = Vector.asSlice<TextOrigin>(&machine.textOrigins)
  let mut at = usize.ZERO
  while at < origins.length {
    if origins[at].address == address { return usize.ZERO }
    at = at + usize.ONE
  }
  return Shared.with<StaticData, usize>(value, StaticValue.size)
}

fn copyCurrent<'source>(machine: &Machine<'source>) -> Option<AuthoredCursor> {
  return match &machine.current {
    Option<AuthoredCursor>.Some {value} => Option.some<AuthoredCursor>(AuthoredCursor.copy(&value))
    Option<AuthoredCursor>.None => Option.none<AuthoredCursor>()
  }
}

fn copyPrevious(previous: &Option<AuthoredCursor>) -> Option<AuthoredCursor> {
  return match &previous.* {
    Option<AuthoredCursor>.Some {value} => Option.some<AuthoredCursor>(AuthoredCursor.copy(&value))
    Option<AuthoredCursor>.None => Option.none<AuthoredCursor>()
  }
}

/// Reports consumed work so a caller can preserve the budget across dependency retries.
pub fn steps<'source>(machine: &Machine<'source>) -> usize {
  return machine.steps
}

/// Authenticates one module in the held source index for short HIR reads.
pub effect fn sourceCursor<'source>(machine: &mut Machine<'source>, module: &ModuleId) -> AuthoredCursor
! Diagnostic | OutOfMemoryError
? &mut Allocator {
  return run cursorFor(&mut machine.*, module, Span.make(usize.ZERO, usize.ZERO))
}

/// Reports parse diagnostics from the exact source authenticated by the cursor.
pub fn sourceDiagnosticCount<'source>(machine: &Machine<'source>, cursor: &AuthoredCursor) -> Option<usize> {
  if let Option<&IndexedSource>.Some {value} = move StaticPort.sourceAtCursor(&machine.port, cursor) {
    let unit = IndexedSource.sourceUnit(value)
    return Option.some<usize>(SourceUnit.diagnosticCount(unit))
  }
  return Option.none<usize>()
}

/// Returns one parser or HIR diagnostic span from the authenticated source.
pub fn sourceDiagnosticSpan<'source>(machine: &Machine<'source>, cursor: &AuthoredCursor, at: usize) -> Option<Span> {
  if let Option<&IndexedSource>.Some {value} = move StaticPort.sourceAtCursor(&machine.port, cursor) {
    let unit = IndexedSource.sourceUnit(value)
    if at < SourceUnit.diagnosticCount(unit) {
      let diagnostic = SourceUnit.diagnostic(unit, at)
      return Option.some<Span>(diagnostic.span)
    }
  }
  return Option.none<Span>()
}

/// Reports the root HIR node count for bounded traversal.
pub fn authoredLength<'source>(machine: &Machine<'source>, cursor: &AuthoredCursor) -> Option<usize> {
  if let Option<&IndexedSource>.Some {value} = move StaticPort.sourceAtCursor(&machine.port, cursor) {
    let hir = IndexedSource.authored(value)
    return Option.some<usize>(Module.length(hir))
  }
  return Option.none<usize>()
}

/// Reports how many canonical declarations belong to the authenticated source.
pub fn sourceDeclarationCount<'source>(machine: &Machine<'source>, cursor: &AuthoredCursor) -> Option<usize> {
  if let Option<&IndexedSource>.Some {value} = move StaticPort.sourceAtCursor(&machine.port, cursor) {
    let index = IndexedSource.moduleIndex(value)
    let declarations = ModuleIndex.listDeclarations(index)
    return Option.some<usize>(declarations.length)
  }
  return Option.none<usize>()
}

/// Copies one canonical declaration so selection can continue after the source loan ends.
pub effect fn sourceDeclaration<'source>(machine: &Machine<'source>, cursor: &AuthoredCursor, at: usize) -> Option<IndexedDeclaration>
! OutOfMemoryError
? &mut Allocator {
  if let Option<&IndexedSource>.Some {value} = move StaticPort.sourceAtCursor(&machine.port, cursor) {
    let index = IndexedSource.moduleIndex(value)
    let declarations = ModuleIndex.listDeclarations(index)
    if at < declarations.length {
      return Option.some<IndexedDeclaration>(run IndexedDeclaration.copy(&declarations[at]))
    }
  }
  return Option.none<IndexedDeclaration>()
}

/// Reports how many syntax-derived name candidates belong to the authenticated source.
pub fn sourceCandidateCount<'source>(machine: &Machine<'source>, cursor: &AuthoredCursor) -> Option<usize> {
  if let Option<&IndexedSource>.Some {value} = move StaticPort.sourceAtCursor(&machine.port, cursor) {
    let index = IndexedSource.moduleIndex(value)
    let candidates = ModuleIndex.listCandidates(index)
    return Option.some<usize>(candidates.length)
  }
  return Option.none<usize>()
}

/// Copies one source name candidate so selection can continue after the source loan ends.
pub effect fn sourceCandidate<'source>(machine: &Machine<'source>, cursor: &AuthoredCursor, at: usize) -> Option<Candidate>
! OutOfMemoryError
? &mut Allocator {
  if let Option<&IndexedSource>.Some {value} = move StaticPort.sourceAtCursor(&machine.port, cursor) {
    let index = IndexedSource.moduleIndex(value)
    let candidates = ModuleIndex.listCandidates(index)
    if at < candidates.length {
      let selected = &candidates[at]
      return Option.some<Candidate>(Candidate {
        name: run Bytes.copy(Bytes.asSlice(&selected.name)),
        declaration: selected.declaration,
        kind: selected.kind,
        ordinal: selected.ordinal,
        local: selected.local,
        isPublic: selected.isPublic,
      })
    }
  }
  return Option.none<Candidate>()
}

/// Returns a Copy HIR node without retaining a source loan across evaluation.
pub fn authoredNode<'source>(machine: &Machine<'source>, cursor: &AuthoredCursor, id: HirId) -> Option<Node> {
  if let Option<&IndexedSource>.Some {value} = move StaticPort.sourceAtCursor(&machine.port, cursor) {
    let hir = IndexedSource.authored(value)
    if id.index < Module.length(hir) {
      return Option.some<Node>(Module.node(hir, id))
    }
  }
  return Option.none<Node>()
}

/// Returns a child HIR identity without retaining a source loan across evaluation.
pub fn authoredChild<'source>(machine: &Machine<'source>, cursor: &AuthoredCursor, range: Range, at: usize) -> Option<HirId> {
  if at < range.length {
    if let Option<&IndexedSource>.Some {value} = move StaticPort.sourceAtCursor(&machine.port, cursor) {
      let hir = IndexedSource.authored(value)
      return Option.some<HirId>(Module.child(hir, range, at))
    }
  }
  return Option.none<HirId>()
}

/// Returns an authored span without retaining a source loan across evaluation.
pub fn authoredSpan<'source>(machine: &Machine<'source>, cursor: &AuthoredCursor, id: HirId) -> Option<Span> {
  if let Option<&IndexedSource>.Some {value} = move StaticPort.sourceAtCursor(&machine.port, cursor) {
    let hir = IndexedSource.authored(value)
    if id.index < Module.length(hir) {
      return Option.some<Span>(Module.span(hir, id))
    }
  }
  return Option.none<Span>()
}

/// Copies authored text so the caller can mutate the machine after this read.
pub effect fn authoredText<'source>(machine: &Machine<'source>, cursor: &AuthoredCursor, symbol: Symbol) -> Option<Bytes>
! OutOfMemoryError
? &mut Allocator {
  if let Option<&IndexedSource>.Some {value} = move StaticPort.sourceAtCursor(&machine.port, cursor) {
    let hir = IndexedSource.authored(value)
    let text = Module.text(hir, symbol)
    return Option.some<Bytes>(run Bytes.copy(text))
  }
  return Option.none<Bytes>()
}

/// Demands a reached body on this machine's active semantic query without resetting its budget.
pub effect fn demandCheckedBody<'source>(machine: &mut Machine<'source>, declaration: &DeclarationId, span: Span) -> Option<Shared<Result<Answer, NoRejection>>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  return run StaticPort.demandBody(&mut machine.port, declaration, span)
}

fn borrowedAuthored<'source>(machine: &Machine<'source>) -> Option<&Module> {
  if let Option<AuthoredCursor>.Some {value: cursor} = &machine.current {
    return StaticPort<'source>.authoredAtCursor(&machine.port, &cursor)
  }
  return Option.none<&Module>()
}

effect fn authored<'source>(machine: &Machine<'source>) -> &Module
! Diagnostic | OutOfMemoryError
? &mut Allocator {
  let borrowed = borrowedAuthored(machine)
  if let Option<&Module>.Some {value} = move borrowed {
    return value
  }
  return run reject(machine, Fault.Unavailable, Span.make(usize.ZERO, usize.ZERO))
}

effect fn currentModule<'source>(machine: &Machine<'source>) -> ModuleId
! Diagnostic | OutOfMemoryError
? &mut Allocator {
  let active = Vector.asSlice<Frame>(&machine.active)
  if active.length > usize.ZERO {
    return run ModuleId.copy(&active[active.length - usize.ONE].module)
  }
  return run ModuleId.copy(&machine.root)
}

effect fn cursorFor<'source>(machine: &mut Machine<'source>, module: &ModuleId, span: Span) -> AuthoredCursor
! Diagnostic | OutOfMemoryError
? &mut Allocator {
  let attempted = run Effect.result(StaticPort.authoredCursor(&mut machine.port, module))
  let available = match move attempted {
    Result<Option<AuthoredCursor>, Cycle | OutOfMemoryError>.Success {value} => move value
    Result<Option<AuthoredCursor>, Cycle | OutOfMemoryError>.Failure {error} => match move error {
      OutOfMemoryError {} => { fail OutOfMemoryError {} }
      Cycle {} => run reject(&machine.*, Fault.Unavailable, span)
    }
  }
  return match move available {
    Option<AuthoredCursor>.Some {value} => value
    Option<AuthoredCursor>.None => run reject(&machine.*, Fault.Unavailable, span)
  }
}

effect fn diagnostic<'source>(machine: &Machine<'source>, fault: Fault, span: Span) -> Diagnostic
! OutOfMemoryError
? &mut Allocator {
  let sourceCode = faultCode(fault)
  let mut trace = Vector.make<TraceStep>()
  let active = Vector.asSlice<Frame>(&machine.active)
  let mut at = usize.ZERO
  while at < active.length {
    run Vector.append<TraceStep>(
      &mut trace,
      TraceStep {
        name: run Bytes.copy(Bytes.asSlice(&active[at].name)),
        arguments: run copyArguments(Vector.asSlice<Shared<StaticData>>(&active[at].arguments)),
        span: active[at].span,
      },
    )
    at = at + usize.ONE
  }
  return Diagnostic {
    fault: fault,
    code: sourceCode,
    span: span,
    target: machine.target,
    message: Option.none<Bytes>(),
    origin: Option.none<Span>(),
    byteOffset: Option.none<u64>(),
    rejection: Option.none<Shared<Rejection>>(),
    needed: Option.none<Needed>(),
    missing: Option.none<MissingFact>(),
    trace: move trace,
  }
}

effect fn reject<'source>(machine: &Machine<'source>, fault: Fault, span: Span) -> never
! Diagnostic | OutOfMemoryError
? &mut Allocator {
  let failure = run diagnostic(machine, fault, span)
  fail move failure
}

effect fn rejectScalar<'source>(machine: &Machine<'source>, failure: StaticFault, span: Span) -> never
! Diagnostic | OutOfMemoryError
? &mut Allocator {
  return match failure {
    StaticFault.InvalidOperands => run reject(machine, Fault.InvalidValue, span)
    StaticFault.Overflow => run reject(machine, Fault.Overflow, span)
    StaticFault.DivisionByZero => run reject(machine, Fault.DivisionByZero, span)
  }
}

effect fn unresolvedConstant<'source>(machine: &Machine<'source>, id: HirId, declaration: Shared<DeclarationId>) -> never
! Diagnostic | OutOfMemoryError
? &mut Allocator {
  let mut failure = run diagnostic(machine, Fault.Unavailable, Module.span(run authored(&machine.*), id))
  failure.needed = Option.some<Needed>(Needed {
    module: run currentModule(machine),
    expression: id,
    declaration: move declaration,
  })
  fail move failure
}

effect fn supplyBindings<'source>(machine: &mut Machine<'source>, bindings: &[Binding]) -> ()
! Diagnostic | OutOfMemoryError
? &mut Allocator {
  let mut at = usize.ZERO
  while at < bindings.length {
    let supplied = Vector.asSlice<RetainedBinding>(&machine.supplied)
    let mut found = false
    let mut prior = usize.ZERO
    while prior < supplied.length {
      if ModuleId.equals(&supplied[prior].module, &bindings[at].module) &&
        supplied[prior].binder.index == bindings[at].binder.index {
        if !run StaticValue.equals(&supplied[prior].value, &bindings[at].value) {
          return run reject(&machine.*, Fault.InvalidValue, Span.make(usize.ZERO, usize.ZERO))
        }
        found = true
        break
      }
      prior = prior + usize.ONE
    }
    if !found {
      let bytes = retainedValueBytes(&machine.*, &bindings[at].value)
      if machine.retainedBytes > machine.limits.valueBytes || bytes > machine.limits.valueBytes - machine.retainedBytes {
        return run reject(&machine.*, Fault.ValueLimit, Span.make(usize.ZERO, usize.ZERO))
      }
      run Vector.append<RetainedBinding>(&mut machine.supplied, RetainedBinding {
        module: run ModuleId.copy(&bindings[at].module),
        binder: bindings[at].binder,
        value: StaticValue.copy(&bindings[at].value),
        chargedBytes: bytes,
      })
      machine.retainedBytes = machine.retainedBytes + bytes
    }
    at = at + usize.ONE
  }
  return ()
}

effect fn suppliedValue<'source>(machine: &Machine<'source>, id: HirId, target: HirId) -> Option<Shared<StaticData>>
! Diagnostic | OutOfMemoryError
? &mut Allocator {
  let module = run currentModule(machine)
  let supplied = Vector.asSlice<RetainedBinding>(&machine.supplied)
  let mut at = supplied.length
  while at > usize.ZERO {
    at = at - usize.ONE
    if ModuleId.equals(&supplied[at].module, &module) &&
      (supplied[at].binder.index == target.index || supplied[at].binder.index == id.index) {
      return Option.some<Shared<StaticData>>(StaticValue.copy(&supplied[at].value))
    }
  }
  return Option.none<Shared<StaticData>>()
}

effect fn step<'source>(machine: &mut Machine<'source>, id: HirId) -> ()
! Diagnostic | OutOfMemoryError
? &mut Allocator {
  if machine.steps >= machine.limits.steps {
    return run reject(&machine.*, Fault.StepLimit, Module.span(run authored(&machine.*), id))
  }
  machine.steps = machine.steps + usize.ONE
  return ()
}

effect fn retain<'source>(machine: &mut Machine<'source>, value: StaticData, span: Span) -> Shared<
  StaticData,
> ! Diagnostic | OutOfMemoryError ? &mut Allocator {
  if StaticValue.size(&value) > machine.limits.valueBytes {
    return run reject(&machine.*, Fault.ValueLimit, span)
  }
  return run Shared.make<StaticData>(move value)
}

effect fn sameArguments(left: &[Shared<StaticData>], right: &[Shared<StaticData>]) -> bool
! OutOfMemoryError
? &mut Allocator {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if !run StaticValue.equals(&left[at], &right[at]) {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

effect fn copyArguments(args: &[Shared<StaticData>]) -> Vector<Shared<StaticData>>
! OutOfMemoryError
? &mut Allocator {
  let mut copied = Vector.make<Shared<StaticData>>()
  let mut at = usize.ZERO
  while at < args.length {
    run Vector.append<Shared<StaticData>>(&mut copied, StaticValue.copy(&args[at]))
    at = at + usize.ONE
  }
  return move copied
}

effect fn completed<'source>(
  machine: &Machine<'source>,
  application: usize,
  args: &[Shared<StaticData>],
) -> Option<Shared<StaticData>> ! OutOfMemoryError ? &mut Allocator {
  let entries = Vector.asSlice<Complete>(&machine.complete)
  let mut at = usize.ZERO
  while at < entries.length {
    if entries[at].application == application && run sameArguments(
      Vector.asSlice<Shared<StaticData>>(&entries[at].arguments),
      args,
    ) {
      return Option.some<Shared<StaticData>>(StaticValue.copy(&entries[at].value))
    }
    at = at + usize.ONE
  }
  return Option.none<Shared<StaticData>>()
}

effect fn publish<'source>(
  machine: &mut Machine<'source>,
  application: usize,
  args: &[Shared<StaticData>],
  value: &Shared<StaticData>,
  span: Span,
) -> () ! Diagnostic | OutOfMemoryError ? &mut Allocator {
  let mut bytes = retainedValueBytes(&machine.*, value)
  let mut at = usize.ZERO
  while at < args.length {
    let argumentBytes = retainedValueBytes(&machine.*, &args[at])
    bytes = match move usize.checkedAdd(bytes, argumentBytes) {
      Option<usize>.Some {value: total} => total
      Option<usize>.None => {
        return run reject(&machine.*, Fault.ValueLimit, span)
      }
    }
    at = at + usize.ONE
  }
  if machine.retainedBytes > machine.limits.valueBytes || bytes > machine.limits.valueBytes - machine.retainedBytes {
    return run reject(&machine.*, Fault.ValueLimit, span)
  }
  let entry = Complete {
    application: application,
    arguments: run copyArguments(args),
    value: StaticValue.copy(value),
  }
  run Vector.append<Complete>(&mut machine.complete, move entry)
  machine.retainedBytes = machine.retainedBytes + bytes
  return ()
}

fn equal(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}


fn staticTextOperation(member: IntrinsicPrimitive) -> Option<StaticTextOperation> {
  if member == IntrinsicPrimitive.StaticTextByteLength {
    return Option.some<StaticTextOperation>(StaticTextOperation.ByteLength)
  }
  if member == IntrinsicPrimitive.StaticTextByteAt {
    return Option.some<StaticTextOperation>(StaticTextOperation.ByteAt)
  }
  if member == IntrinsicPrimitive.StaticTextConcat {
    return Option.some<StaticTextOperation>(StaticTextOperation.Concat)
  }
  if member == IntrinsicPrimitive.StaticTextSlice {
    return Option.some<StaticTextOperation>(StaticTextOperation.Slice)
  }
  return Option.none<StaticTextOperation>()
}

fn firstTextOrigin<'source>(machine: &Machine<'source>, values: &Vector<Shared<StaticData>>) -> Option<Span> {
  let arguments = Vector.asSlice<Shared<StaticData>>(values)
  if arguments.length == usize.ZERO { return Option.none<Span>() }
  return textOrigin(machine, &arguments[usize.ZERO])
}

effect fn profileArgument<'source>(
  machine: &mut Machine<'source>,
  local: &mut Vector<Local>,
  arguments: CallArguments,
  at: usize,
  span: Span,
) -> Bytes ! Diagnostic | OutOfMemoryError ? &mut Allocator {
  if at >= CallArguments.length(arguments) {
    return run reject(&machine.*, Fault.InvalidValue, span)
  }
  let id = CallArguments.child(arguments, run authored(&machine.*), at)
  let value = run expression(&mut machine.*, &mut local.*, id)
  return match move run StaticValue.textBytes(&value) {
    Option<Bytes>.Some {value: bytes} => move bytes
    Option<Bytes>.None => run reject(&machine.*, Fault.InvalidValue, span)
  }
}

effect fn dispatchIntrinsic<'source>(
  machine: &mut Machine<'source>,
  member: IntrinsicMember,
  call: HirId,
  arguments: CallArguments,
  local: &mut Vector<Local>,
  span: Span,
) -> Shared<StaticData> ! Diagnostic | OutOfMemoryError ? &mut Allocator {
  // Scalar intrinsics are runtime primitives; a checked static body cannot reach one.
  let primitive = match member {
    IntrinsicMember.Primitive {primitive: named} => named
    IntrinsicMember.Scalar {..} => {
      let mut failure = run diagnostic(&machine.*, Fault.Unsupported, span)
      failure.missing = Option.some<MissingFact>(MissingFact.IntrinsicOperation)
      fail move failure
    }
  }
  if primitive == IntrinsicPrimitive.ReflectType {
    if CallArguments.length(arguments) != usize.ZERO { return run reject(&machine.*, Fault.InvalidValue, span) }
    let checked = checkedIntrinsicType(&machine.*, call)
    let written = match move checked {
      Option<Shared<SemanticType>>.Some {value} => value
      Option<Shared<SemanticType>>.None => run reject(&machine.*, Fault.Unavailable, span)
    }
    let closed = run closeType(&machine.*, &written)
    let described = Shared.with<SemanticType, Option<Shared<SemanticType>>>(&closed, descriptorOwner)
    let owner = match move described {
      Option<Shared<SemanticType>>.Some {value} => value
      Option<Shared<SemanticType>>.None => run reject(&machine.*, Fault.InvalidValue, span)
    }
    if SemanticType.hasOpenParameters(&owner) {
      let mut failure = run diagnostic(&machine.*, Fault.Unsupported, span)
      failure.missing = Option.some<MissingFact>(MissingFact.TypedApplication)
      fail move failure
    }
    return run retain(&mut machine.*, run StaticValue.descriptor(move owner), span)
  }
  if primitive == IntrinsicPrimitive.ReflectTypeKind {
    if CallArguments.length(arguments) != usize.ONE { return run reject(&machine.*, Fault.InvalidValue, span) }
    let argument = CallArguments.child(arguments, run authored(&machine.*), usize.ZERO)
    let value = run expression(&mut machine.*, &mut local.*, argument)
    let described = Shared.with<StaticData, Option<Shared<SemanticType>>>(&value, fn(data: &StaticData) -> Option<Shared<SemanticType>> {
      return match &data.* {
        StaticData.Aggregate {ty, ..} => Shared.with<SemanticType, Option<Shared<SemanticType>>>(&ty, descriptorOwner)
        _ => Option.none<Shared<SemanticType>>()
      }
    })
    let owner = match move described {
      Option<Shared<SemanticType>>.Some {value: selected} => selected
      Option<Shared<SemanticType>>.None => run reject(&machine.*, Fault.InvalidValue, span)
    }
    // The stable codes of `silk.reflect`: a source-declared named aggregate is 0 and a positional
    // one is 1. Occurrence-generated aggregates are not modeled here and stay Unsupported.
    let code = Shared.with<SemanticType, Option<u64>>(&owner, fn(ty: &SemanticType) -> Option<u64> {
      return match &ty.* {
        SemanticType.Nominal {declaration, ..} => match DeclarationId.kind(&declaration) {
          OwnerKind.Struct => Option.some<u64>(0)
          OwnerKind.Tuple => Option.some<u64>(1)
          _ => Option.none<u64>()
        }
        _ => Option.none<u64>()
      }
    })
    let kind = match move code {
      Option<u64>.Some {value: selected} => selected
      Option<u64>.None => {
        let mut failure = run diagnostic(&machine.*, Fault.Unsupported, span)
        failure.missing = Option.some<MissingFact>(MissingFact.IntrinsicOperation)
        fail move failure
      }
    }
    return run retain(&mut machine.*, StaticData.Integer {ty: StaticIntegerType.U8, sign: StaticSign.Positive, magnitude: kind}, span)
  }
  if primitive == IntrinsicPrimitive.ProfileText || primitive == IntrinsicPrimitive.ProfileFlag || primitive == IntrinsicPrimitive.ProfileContains {
    let mut count = usize.ONE
    if primitive == IntrinsicPrimitive.ProfileContains { count = 2 }
    if CallArguments.length(arguments) != count {
      return run reject(&machine.*, Fault.InvalidValue, span)
    }
    let key = run profileArgument(&mut machine.*, &mut local.*, arguments, usize.ZERO, span)
    let mut memberName = Bytes.make()
    if primitive == IntrinsicPrimitive.ProfileContains {
      memberName = run profileArgument(&mut machine.*, &mut local.*, arguments, usize.ONE, span)
    }
    let module = run currentModule(&machine.*)
    let demanded = run Effect.result(StaticPort.demandProfile(&mut machine.port, &module, span))
    match move demanded {
      Result<(), Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError>.Success {value: _} => {}
      Result<(), Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError>.Failure {error} => match move error {
        OutOfMemoryError {} => { fail OutOfMemoryError {} }
        Cycle {} => run reject(&machine.*, Fault.Unavailable, span)
        InvalidModulePath {} => run reject(&machine.*, Fault.Unavailable, span)
        RevisionMismatch {} => run reject(&machine.*, Fault.Unavailable, span)
      }
    }
    let available = StaticPort<'source>.profile(&machine.port)
    let profile = match move available {
      Option<&FinalProfile>.Some {value} => value
      Option<&FinalProfile>.None => {
        let mut failure = run diagnostic(&machine.*, Fault.Unsupported, span)
        failure.missing = Option.some<MissingFact>(MissingFact.ProfileInput)
        fail move failure
      }
    }
    if primitive == IntrinsicPrimitive.ProfileText {
      let selected = FinalProfile.text(profile, Bytes.asSlice(&key))
      let fact = match move selected {
        Option<&[u8]>.Some {value} => value
        Option<&[u8]>.None => run reject(&machine.*, Fault.InvalidValue, span)
      }
      if fact.length > machine.limits.valueBytes || machine.limits.valueBytes - fact.length < 16 {
        return run reject(&machine.*, Fault.ValueLimit, span)
      }
      let copied = run Bytes.copy(fact)
      let selectedText = StaticValue.text(move copied)
      let text = match move selectedText {
        Option<StaticData>.Some {value} => value
        Option<StaticData>.None => run reject(&machine.*, Fault.InvalidValue, span)
      }
      let retained = run retain(&mut machine.*, move text, span)
      run rememberTextOrigin(&mut machine.*, &retained, span)
      return move retained
    }
    let mut result = Option.none<bool>()
    if primitive == IntrinsicPrimitive.ProfileFlag {
      result = FinalProfile.flag(profile, Bytes.asSlice(&key))
    } else {
      result = FinalProfile.contains(profile, Bytes.asSlice(&key), Bytes.asSlice(&memberName))
    }
    return match move result {
      Option<bool>.Some {value} => run retain(&mut machine.*, StaticData.Boolean {value: value}, span)
      Option<bool>.None => run reject(&machine.*, Fault.InvalidValue, span)
    }
  }
  let selectedName = intrinsicSpelling(primitive)
  if let Option<u32>.Some {value: number} = move machine.target.queryNumber(selectedName) {
    if CallArguments.length(arguments) != usize.ZERO { return run reject(&machine.*, Fault.InvalidValue, span) }
    return run retain(&mut machine.*, StaticData.Integer {
      ty: StaticIntegerType.U32, sign: StaticSign.Positive, magnitude: u32.toU64(number),
    }, span)
  }
  if let Option<&[u8]>.Some {value: fact} = move machine.target.queryText(selectedName) {
    if CallArguments.length(arguments) != usize.ZERO { return run reject(&machine.*, Fault.InvalidValue, span) }
    if fact.length > machine.limits.valueBytes || machine.limits.valueBytes - fact.length < 16 {
      return run reject(&machine.*, Fault.ValueLimit, span)
    }
    let copied = run Bytes.copy(fact)
    let text = match move StaticValue.text(move copied) {
      Option<StaticData>.Some {value} => value
      Option<StaticData>.None => { return run reject(&machine.*, Fault.InvalidValue, span) }
    }
    let retained = run retain(&mut machine.*, move text, span)
    run rememberTextOrigin(&mut machine.*, &retained, span)
    return move retained
  }
  if let Option<StaticTextOperation>.Some {value: selected} = move staticTextOperation(primitive) {
    let mut values = Vector.make<Shared<StaticData>>()
    let mut at = usize.ZERO
    while at < CallArguments.length(arguments) {
      let argument = CallArguments.child(arguments, run authored(&machine.*), at)
      let value = run expression(&mut machine.*, &mut local.*, argument)
      run Vector.append<Shared<StaticData>>(&mut values, move value)
      at = at + usize.ONE
    }
    let sourceOrigin = firstTextOrigin(&machine.*, &values)
    let producesText = selected == StaticTextOperation.Concat || selected == StaticTextOperation.Slice
    let applied = run StaticText.apply(
      selected, Vector.asSlice<Shared<StaticData>>(&values), machine.target.pointerBits(),
      machine.limits.valueBytes,
    )
    return match move applied {
      Result<StaticData, StaticText.Fault>.Success {value} => {
        let retained = run retain(&mut machine.*, move value, span)
        if producesText {
          if let Option<Span>.Some {value: origin} = move sourceOrigin {
            run rememberTextOrigin(&mut machine.*, &retained, origin)
          }
        }
        return move retained
      }
      Result<StaticData, StaticText.Fault>.Failure {error} => {
        if error.kind == StaticTextFaultKind.ValueLimit {
          return run reject(&machine.*, Fault.ValueLimit, span)
        }
        let mut failure = run diagnostic(&machine.*, Fault.InvalidValue, span)
        failure.byteOffset = Option.some<u64>(error.byteOffset)
        failure.origin = move sourceOrigin
        fail move failure
      }
    }
  }
  let mut failure = run diagnostic(&machine.*, Fault.Unsupported, span)
  failure.missing = Option.some<MissingFact>(MissingFact.IntrinsicOperation)
  fail move failure
}

/// The exact static integer representation of a checked primitive type spelling.
pub fn integerType(text: &[u8]) -> Option<StaticIntegerType> {
  if equal(text, b"u8") {
    return Option.some<StaticIntegerType>(StaticIntegerType.U8)
  }
  if equal(text, b"u16") {
    return Option.some<StaticIntegerType>(StaticIntegerType.U16)
  }
  if equal(text, b"u32") {
    return Option.some<StaticIntegerType>(StaticIntegerType.U32)
  }
  if equal(text, b"u64") {
    return Option.some<StaticIntegerType>(StaticIntegerType.U64)
  }
  if equal(text, b"usize") {
    return Option.some<StaticIntegerType>(StaticIntegerType.Usize)
  }
  if equal(text, b"i8") {
    return Option.some<StaticIntegerType>(StaticIntegerType.I8)
  }
  if equal(text, b"i16") {
    return Option.some<StaticIntegerType>(StaticIntegerType.I16)
  }
  if equal(text, b"i32") {
    return Option.some<StaticIntegerType>(StaticIntegerType.I32)
  }
  if equal(text, b"i64") {
    return Option.some<StaticIntegerType>(StaticIntegerType.I64)
  }
  if equal(text, b"isize") {
    return Option.some<StaticIntegerType>(StaticIntegerType.Isize)
  }
  return Option.none<StaticIntegerType>()
}

fn namedType(value: &StaticData, text: &[u8]) -> Option<bool> {
  if let Option<StaticIntegerType>.Some {value: expected} = move integerType(text) {
    return Option.some<bool>(match & value.* {
      StaticData.Integer {ty, ..} => ty == expected
      _ => false
    })
  }
  if equal(text, b"bool") {
    return Option.some<bool>(match & value.* {
      StaticData.Boolean {..} => true
      _ => false
    })
  }
  if equal(text, b"char") {
    return Option.some<bool>(match & value.* {
      StaticData.Character {..} => true
      _ => false
    })
  }
  if equal(text, b"string") {
    return Option.some<bool>(match & value.* {
      StaticData.Text {..} => true
      _ => false
    })
  }
  if equal(text, b"f32") {
    return Option.some<bool>(match & value.* {
      StaticData.Float {ty, ..} => ty == StaticFloatType.F32
      _ => false
    })
  }
  if equal(text, b"f64") {
    return Option.some<bool>(match & value.* {
      StaticData.Float {ty, ..} => ty == StaticFloatType.F64
      _ => false
    })
  }
  return Option.none<bool>()
}

fn semanticValueType(value: &StaticData, ty: &SemanticType) -> Option<bool> {
  return match & ty.* {
    SemanticType.Primitive {name: spelling} => namedType(value, Bytes.asSlice(&spelling))
    SemanticType.Unit => Option.some<bool>(match & value.* {
      StaticData.Unit => true
      _ => false
    })
    SemanticType.String {..} => Option.some<bool>(match & value.* {
      StaticData.Text {..} => true
      _ => false
    })
    _ => Option.none<bool>()
  }
}

fn checkedValueType(ty: &SemanticType, value: &Shared<StaticData>) -> Option<bool> {
  return Shared.with<StaticData, Option<bool>>(value, fn(actual: &StaticData) -> Option<bool> {
    return semanticValueType(actual, ty)
  })
}

fn bodyFromAnswer(answer: &Result<Answer, NoRejection>) -> Option<Result<Shared<TypedBody>, Shared<Rejection>>> {
  return match &answer.* {
    Result<Answer, NoRejection>.Success {value} => match &value.outcome {
      Outcome.Success {value: Value.Body {body, source: _}} => Option.some<Result<Shared<TypedBody>, Shared<Rejection>>>(
        Result.succeed<Shared<TypedBody>, Shared<Rejection>>(Shared.clone<TypedBody>(&body)),
      )
      Outcome.Rejected {diagnostic: rejected} => Option.some<Result<Shared<TypedBody>, Shared<Rejection>>>(
        Result.failResult<Shared<TypedBody>, Shared<Rejection>>(Shared.clone<Rejection>(&rejected)),
      )
      _ => Option.none<Result<Shared<TypedBody>, Shared<Rejection>>>()
    }
    Result<Answer, NoRejection>.Failure {error: _} => Option.none<Result<Shared<TypedBody>, Shared<Rejection>>>()
  }
}

fn checkedBodyForExpression<'source>(machine: &Machine<'source>) -> Option<Shared<TypedBody>> {
  let frames = Vector.asSlice<Frame>(&machine.active)
  if frames.length == usize.ZERO {
    return match &machine.rootBody {
      Option<Shared<TypedBody>>.Some {value} => Option.some<Shared<TypedBody>>(Shared.clone<TypedBody>(&value))
      Option<Shared<TypedBody>>.None => Option.none<Shared<TypedBody>>()
    }
  }
  let current = &frames[frames.length - usize.ONE]
  return Option.some<Shared<TypedBody>>(Shared.clone<TypedBody>(&current.body))
}

fn checkedExpressionType<'source>(machine: &Machine<'source>, id: HirId) -> Option<Shared<SemanticType>> {
  return match move checkedBodyForExpression(machine) {
    Option<Shared<TypedBody>>.Some {value: body} => Shared.with<TypedBody, Option<Shared<SemanticType>>>(
    &body,
    fn(body: &TypedBody) -> Option<Shared<SemanticType>> {
      let nodes = TypedBody.nodeSlice(body)
      let mut at = usize.ZERO
      while at < nodes.length {
        if nodes[at].origin.syntax.index == id.index {
          if let CheckedNodeKind.Expression {ty, ..} = &nodes[at].kind {
            return Option.some<Shared<SemanticType>>(Shared.clone<SemanticType>(&ty))
          }
        }
        at = at + usize.ONE
      }
      return Option.none<Shared<SemanticType>>()
    },
    )
    Option<Shared<TypedBody>>.None => Option.none<Shared<SemanticType>>()
  }
}

fn intrinsicMemberAt(body: &TypedBody, id: HirId) -> Option<IntrinsicMember> {
  let nodes = TypedBody.nodeSlice(body)
  let mut at = usize.ZERO
  while at < nodes.length {
    if nodes[at].origin.syntax.index == id.index {
      if let CheckedNodeKind.Expression {form: CheckedExpression.IntrinsicCall {member, ..}, ..} = &nodes[at].kind {
        return Option.some<IntrinsicMember>(member)
      }
    }
    at = at + usize.ONE
  }
  return Option.none<IntrinsicMember>()
}

fn checkedIntrinsicMember<'source>(machine: &Machine<'source>, id: HirId) -> Option<IntrinsicMember> {
  return match move checkedBodyForExpression(machine) {
    Option<Shared<TypedBody>>.Some {value: body} => Shared.with<TypedBody, Option<IntrinsicMember>>(&body, fn(body: &TypedBody) -> Option<IntrinsicMember> {
      return intrinsicMemberAt(body, id)
    })
    Option<Shared<TypedBody>>.None => Option.none<IntrinsicMember>()
  }
}

// The checked type of one reached intrinsic call, written in the executing body's binders.
fn checkedIntrinsicType<'source>(machine: &Machine<'source>, id: HirId) -> Option<Shared<SemanticType>> {
  return match move checkedBodyForExpression(machine) {
    Option<Shared<TypedBody>>.Some {value: body} => Shared.with<TypedBody, Option<Shared<SemanticType>>>(&body, fn(body: &TypedBody) -> Option<Shared<SemanticType>> {
      let nodes = TypedBody.nodeSlice(body)
      let mut at = usize.ZERO
      while at < nodes.length {
        if nodes[at].origin.syntax.index == id.index {
          if let CheckedNodeKind.Expression {ty, form: CheckedExpression.IntrinsicCall {..}} = &nodes[at].kind {
            return Option.some<Shared<SemanticType>>(Shared.clone<SemanticType>(&ty))
          }
        }
        at = at + usize.ONE
      }
      return Option.none<Shared<SemanticType>>()
    })
    Option<Shared<TypedBody>>.None => Option.none<Shared<SemanticType>>()
  }
}

fn descriptorOwner(ty: &SemanticType) -> Option<Shared<SemanticType>> {
  return match &ty.* {
    SemanticType.TypeDescriptor {owner} => Option.some<Shared<SemanticType>>(Shared.clone<SemanticType>(&owner))
    _ => Option.none<Shared<SemanticType>>()
  }
}

// Closes a checked type written in the executing body's binders with that body's application.
effect fn closeType<'source>(machine: &Machine<'source>, ty: &Shared<SemanticType>) -> Shared<SemanticType>
! OutOfMemoryError ? &mut Allocator {
  let frames = Vector.asSlice<Frame>(&machine.active)
  let mut bindings = Vector.make<TypeBinding>()
  if frames.length > usize.ZERO {
    bindings = run Application.bindings(&frames[frames.length - usize.ONE].instance)
  } else if let Option<Application>.Some {value: root} = &machine.instance {
    bindings = run Application.bindings(&root)
  }
  return run SemanticType.applyBindings(ty, Vector.asSlice<TypeBinding>(&bindings), true)
}

fn selectedStaticArm<'source>(machine: &Machine<'source>, id: HirId) -> Option<HirRef> {
  return match move checkedBodyForExpression(machine) {
    Option<Shared<TypedBody>>.Some {value: body} => Shared.with<TypedBody, Option<HirRef>>(
      &body,
      fn(checked: &TypedBody) -> Option<HirRef> {
        let nodes = TypedBody.nodeSlice(checked)
        let mut at = usize.ZERO
        while at < nodes.length {
          if nodes[at].origin.syntax.index == id.index {
            if let CheckedNodeKind.Block {statements, ..} = &nodes[at].kind {
              let retained = Vector.asSlice<CheckedNodeId>(&statements)
              if retained.length == usize.ZERO {
                return Option.some<HirRef>(HirRef.absent())
              }
              if retained.length == usize.ONE && retained[usize.ZERO].index < nodes.length {
                return Option.some<HirRef>(
                  HirRef.of(nodes[retained[usize.ZERO].index].origin.syntax),
                )
              }
            }
            return Option.none<HirRef>()
          }
          at = at + usize.ONE
        }
        return Option.none<HirRef>()
      },
    )
    Option<Shared<TypedBody>>.None => Option.none<HirRef>()
  }
}

// The scalar-enum member a static root's checked body records at `id`, if any.
fn checkedEnumMember<'source>(machine: &Machine<'source>, id: HirId) -> Option<CheckedEnumMember> {
  return match move checkedBodyForExpression(machine) {
    Option<Shared<TypedBody>>.Some {value: body} => Shared.with<TypedBody, Option<CheckedEnumMember>>(
      &body,
      fn(body: &TypedBody) -> Option<CheckedEnumMember> {
        let nodes = TypedBody.nodeSlice(body)
        let mut at = usize.ZERO
        while at < nodes.length {
          if nodes[at].origin.syntax.index == id.index {
            if let CheckedNodeKind.Expression {form: CheckedExpression.EnumMember {member}, ..} = &nodes[at].kind {
              return Option.some<CheckedEnumMember>(member)
            }
          }
          at = at + usize.ONE
        }
        return Option.none<CheckedEnumMember>()
      },
    )
    Option<Shared<TypedBody>>.None => Option.none<CheckedEnumMember>()
  }
}

// Constructs the static value of a checked scalar-enum member, keeping its nominal identity.
effect fn enumValue<'source>(machine: &mut Machine<'source>, id: HirId, member: CheckedEnumMember, span: Span) -> Shared<
  StaticData,
> ! Diagnostic | OutOfMemoryError ? &mut Allocator {
  let ty = match move checkedExpressionType(&machine.*, id) {
    Option<Shared<SemanticType>>.Some {value} => value
    Option<Shared<SemanticType>>.None => { return run reject(&machine.*, Fault.Unavailable, span) }
  }
  let copied = run SemanticType.copy(&ty)
  let declaration = match move copied {
    SemanticType.Nominal {declaration, ..} => run Shared.make<DeclarationId>(move declaration)
    _ => { return run reject(&machine.*, Fault.InvalidValue, span) }
  }
  let mut sign = StaticSign.Positive
  if member.negative { sign = StaticSign.Negative }
  let value = match move StaticValue.enumeration(move declaration, member.ordinal, member.representation, sign, member.magnitude) {
    Option<StaticData>.Some {value: built} => built
    Option<StaticData>.None => { return run reject(&machine.*, Fault.InvalidValue, span) }
  }
  return run retain(&mut machine.*, move value, span)
}

fn checkedConstantDeclaration<'source>(machine: &Machine<'source>, id: HirId) -> Option<Shared<DeclarationId>> {
  return match move checkedBodyForExpression(machine) {
    Option<Shared<TypedBody>>.Some {value: body} => Shared.with<TypedBody, Option<Shared<DeclarationId>>>(
      &body,
      fn(body: &TypedBody) -> Option<Shared<DeclarationId>> {
        let nodes = TypedBody.nodeSlice(body)
        let mut at = usize.ZERO
        while at < nodes.length {
          if nodes[at].origin.syntax.index == id.index {
            if let CheckedNodeKind.Expression {form: CheckedExpression.Constant {declaration}, ..} = &nodes[at].kind {
              return Option.some<Shared<DeclarationId>>(Shared.clone<DeclarationId>(&declaration))
            }
          }
          at = at + usize.ONE
        }
        return Option.none<Shared<DeclarationId>>()
      },
    )
    Option<Shared<TypedBody>>.None => Option.none<Shared<DeclarationId>>()
  }
}

fn checkedIntegerType<'source>(machine: &Machine<'source>, id: HirId) -> Option<StaticIntegerType> {
  return match move checkedExpressionType(machine, id) {
    Option<Shared<SemanticType>>.Some {value: ty} => Shared.with<SemanticType, Option<StaticIntegerType>>(
      &ty,
      fn(value: &SemanticType) -> Option<StaticIntegerType> {
        if let SemanticType.Primitive {name: spelling} = &value.* {
          return integerType(Bytes.asSlice(&spelling))
        }
        return Option.none<StaticIntegerType>()
      },
    )
    Option<Shared<SemanticType>>.None => Option.none<StaticIntegerType>()
  }
}

fn checkedFloatType<'source>(machine: &Machine<'source>, id: HirId) -> Option<StaticFloatType> {
  return match move checkedExpressionType(machine, id) {
    Option<Shared<SemanticType>>.Some {value: ty} => Shared.with<SemanticType, Option<StaticFloatType>>(
      &ty,
      fn(value: &SemanticType) -> Option<StaticFloatType> {
        if let SemanticType.Primitive {name: spelling} = &value.* {
          let written = Bytes.asSlice(&spelling)
          if equal(written, b"f32") { return Option.some<StaticFloatType>(StaticFloatType.F32) }
          if equal(written, b"f64") { return Option.some<StaticFloatType>(StaticFloatType.F64) }
        }
        return Option.none<StaticFloatType>()
      },
    )
    Option<Shared<SemanticType>>.None => Option.none<StaticFloatType>()
  }
}

// Closes a declared parameter or result type with the selected application's owner-qualified
// bindings at every depth. A type left open is not a declared runtime-closed type.
effect fn appliedDeclaredType(declared: &Shared<SemanticType>, application: &Application) -> Option<Shared<SemanticType>>
! OutOfMemoryError ? &mut Allocator {
  let bindings = run Application.bindings(application)
  let applied = run SemanticType.applyBindings(declared, Vector.asSlice<TypeBinding>(&bindings), true)
  if SemanticType.hasOpenRuntimeParameters(&applied) { return Option.none<Shared<SemanticType>>() }
  return Option.some<Shared<SemanticType>>(move applied)
}

fn parameterTypeAt(parameters: &[Shared<SemanticType>], ordinal: usize) -> Option<Shared<SemanticType>> {
  if ordinal < parameters.length {
    return Option.some<Shared<SemanticType>>(Shared.clone<SemanticType>(&parameters[ordinal]))
  }
  return Option.none<Shared<SemanticType>>()
}

fn signatureType(answer: &Result<Answer, NoRejection>, parameter: Option<usize>) -> Option<Shared<SemanticType>> {
  return match &answer.* {
    Result<Answer, NoRejection>.Success {value} => match &value.outcome {
      Outcome.Success {value: Value.Signature {signature}} => match move parameter {
        Option<usize>.Some {value: ordinal} => {
          let parameters = Vector.asSlice<Shared<SemanticType>>(&signature.parameters)
          return parameterTypeAt(parameters, ordinal)
        }
        Option<usize>.None => Option.some<Shared<SemanticType>>(Shared.clone<SemanticType>(&signature.result))
      }
      _ => Option.none<Shared<SemanticType>>()
    }
    Result<Answer, NoRejection>.Failure {error: _} => Option.none<Shared<SemanticType>>()
  }
}

fn signatureApplicationArityMatches(answer: &Result<Answer, NoRejection>, application: &Application) -> bool {
  let count = Vector.length<Argument>(&application.arguments)
  let ordinals = Vector.asSlice<usize>(&application.argumentOrdinals)
  if ordinals.length != count { return false }
  let mut at = usize.ZERO
  while at < ordinals.length {
    if ordinals[at] != at { return false }
    at = at + usize.ONE
  }
  return match &answer.* {
    Result<Answer, NoRejection>.Success {value} => match &value.outcome {
      Outcome.Success {value: Value.Signature {signature}} => count ==
        Vector.length<Shared<SemanticType>>(&signature.typeParameters) +
        Vector.length<Shared<Lifetime>>(&signature.lifetimeParameters) +
        Vector.length<RowParameter>(&signature.rowParameters)
      _ => false
    }
    Result<Answer, NoRejection>.Failure {error: _} => false
  }
}

fn rootLifetimeArgumentCount(answer: &Result<Answer, NoRejection>) -> Option<usize> {
  return match &answer.* {
    Result<Answer, NoRejection>.Success {value} => match &value.outcome {
      Outcome.Success {value: Value.Signature {signature}} => {
        if Vector.length<Shared<SemanticType>>(&signature.typeParameters) != usize.ZERO ||
          Vector.length<RowParameter>(&signature.rowParameters) != usize.ZERO {
          return Option.none<usize>()
        }
        return Option.some<usize>(Vector.length<Shared<Lifetime>>(&signature.lifetimeParameters))
      }
      _ => Option.none<usize>()
    }
    Result<Answer, NoRejection>.Failure {error: _} => Option.none<usize>()
  }
}

effect fn selectedSignatureType(
  answer: &Shared<Result<Answer, NoRejection>>,
  parameter: Option<usize>,
  application: &Application,
) -> Option<Shared<SemanticType>> ! OutOfMemoryError ? &mut Allocator {
  let declared = Shared.with<Result<Answer, NoRejection>, Option<Shared<SemanticType>>>(
    answer,
    fn(value: &Result<Answer, NoRejection>) -> Option<Shared<SemanticType>> {
      return signatureType(value, move parameter)
    },
  )
  return match move declared {
    Option<Shared<SemanticType>>.Some {value} => run appliedDeclaredType(&value, application)
    Option<Shared<SemanticType>>.None => Option.none<Shared<SemanticType>>()
  }
}

fn parseMagnitude(digits: &[u8]) -> Option<u64> {
  let mut value: u64 = 0
  let mut at = usize.ZERO
  while at < digits.length {
    let digit = digits[at]
    if digit < 48 || digit > 57 {
      return Option.none<u64>()
    }
    let scaled = match move u64.checkedMultiply(value, 10) {
      Option<u64>.Some {value: next} => next
      Option<u64>.None => {
        return Option.none<u64>()
      }
    }
    value = match move u64.checkedAdd(scaled, u8.toU64(digit - 48)) {
      Option<u64>.Some {value: next} => next
      Option<u64>.None => {
        return Option.none<u64>()
      }
    }
    at = at + usize.ONE
  }
  return Option.some<u64>(value)
}

fn boolean(value: &StaticData) -> Option<bool> {
  return match & value.* {
    StaticData.Boolean {value: selected} => Option.some<bool>(selected)
    _ => Option.none<bool>()
  }
}

effect fn evaluatedBoolean<'source>(
  machine: &mut Machine<'source>,
  local: &mut Vector<Local>,
  id: HirId,
) -> bool ! Diagnostic | OutOfMemoryError ? &mut Allocator {
  let value = run expression(&mut machine.*, &mut local.*, id)
  let selected = Shared.with<StaticData, Option<bool>>(&value, boolean)
  return match move selected {
    Option<bool>.Some {value: chosen} => chosen
    Option<bool>.None => run reject(
      &machine.*,
      Fault.InvalidValue,
      Module.span(run authored(&machine.*), id),
    )
  }
}

effect fn integerExpression<'source>(
  machine: &mut Machine<'source>,
  id: HirId,
) -> Shared<StaticData> ! Diagnostic | OutOfMemoryError ? &mut Allocator {
  let span = Module.span(run authored(&machine.*), id)
  if let Node.IntegerLiteral {sign, magnitude, suffix, ..} = Module.node(run authored(&machine.*), id) {
    let digits = Module.text(run authored(&machine.*), magnitude)
    let number = match move parseMagnitude(digits) {
      Option<u64>.Some {value} => value
      Option<u64>.None => {
        return run reject(&machine.*, Fault.InvalidValue, span)
      }
    }
    let ty = match move checkedIntegerType(&machine.*, id) {
      Option<StaticIntegerType>.Some {value: checked} => checked
      Option<StaticIntegerType>.None => {
        let mut failure = run diagnostic(&machine.*, Fault.Unsupported, span)
        failure.missing = Option.some<MissingFact>(MissingFact.CheckedExpression)
        fail move failure
      }
    }
    if suffix.present {
      let written = match move integerType(Module.text(run authored(&machine.*), suffix.symbol)) {
        Option<StaticIntegerType>.Some {value} => value
        Option<StaticIntegerType>.None => {
          return run reject(&machine.*, Fault.InvalidValue, span)
        }
      }
      if written != ty {
        return run reject(&machine.*, Fault.InvalidValue, span)
      }
    }
    let mut signed = StaticSign.Positive
    if sign == Sign.Negative {
      signed = StaticSign.Negative
    }
    let selected = match move StaticValue.integer(ty, signed, number, machine.target.pointerBits()) {
      Option<StaticData>.Some {value} => value
      Option<StaticData>.None => {
        return run reject(&machine.*, Fault.InvalidValue, span)
      }
    }
    return run retain(&mut machine.*, move selected, span)
  }
  return run reject(&machine.*, Fault.InvalidValue, span)
}

effect fn applyInfix<'source>(
  machine: &mut Machine<'source>,
  operator: InfixOperator,
  operatorAnchor: Span,
  span: Span,
  first: &Shared<StaticData>,
  second: &Shared<StaticData>,
) -> Shared<StaticData> ! Diagnostic | OutOfMemoryError ? &mut Allocator {
  let result = StaticValue.infixShared(operator, first, second, machine.target.pointerBits())
  return match move result {
    Result<StaticData, StaticFault>.Success {value: selected} => run retain(
      &mut machine.*,
      move selected,
      span,
    )
    Result<StaticData, StaticFault>.Failure {error} => run rejectScalar(
      &machine.*,
      move error,
      operatorAnchor,
    )
  }
}

effect fn expression<'source>(machine: &mut Machine<'source>, local: &mut Vector<Local>, id: HirId) -> Shared<
  StaticData,
> ! Diagnostic | OutOfMemoryError ? &mut Allocator {
  let span = Module.span(run authored(&machine.*), id)
  let checked = match move checkedExpressionType(&machine.*, id) {
    Option<Shared<SemanticType>>.Some {value} => value
    Option<Shared<SemanticType>>.None => {
      let mut failure = run diagnostic(&machine.*, Fault.Unsupported, span)
      failure.missing = Option.some<MissingFact>(MissingFact.CheckedExpression)
      fail move failure
    }
  }
  let value = run expressionFromSource(&mut machine.*, &mut local.*, id)
  // The checked type is written in the executing body's binders; close it with that body's
  // application before admitting the value.
  let closed = run closeType(&machine.*, &checked)
  let valid = Shared.with<SemanticType, Option<bool>>(&closed, fn(ty: &SemanticType) -> Option<bool> {
    return checkedValueType(ty, &value)
  })
  match move valid {
    Option<bool>.Some {value: accepted} => {
      if !accepted {
        return run reject(&machine.*, Fault.InvalidValue, span)
      }
      return move value
    }
    Option<bool>.None => {
      if !SemanticType.hasOpenRuntimeParameters(&closed) && run StaticValue.matchesType(&value, &closed) {
        return move value
      }
      let mut failure = run diagnostic(&machine.*, Fault.Unsupported, span)
      failure.missing = Option.some<MissingFact>(MissingFact.DeclaredType)
      fail move failure
    }
  }
}

// Copies the checked direct-call application selected at this call expression.
effect fn directCall<'source>(machine: &mut Machine<'source>, id: HirId, span: Span) -> StaticCall
! Diagnostic | OutOfMemoryError
? &mut Allocator {
  let checked = match move checkedBodyForExpression(&machine.*) {
    Option<Shared<TypedBody>>.Some {value} => value
    Option<Shared<TypedBody>>.None => {
      let mut failure = run diagnostic(&machine.*, Fault.Unsupported, span)
      failure.missing = Option.some<MissingFact>(MissingFact.CheckedBody)
      fail move failure
    }
  }
  let copied = run Effect.result(StaticPort.copyDirectCall(&mut machine.port, &checked, id))
  let call = match move copied {
    Result<Option<StaticCall>, Cycle | InvalidModulePath | OutOfMemoryError>.Success {value} => match move value {
      Option<StaticCall>.Some {value: selected} => selected
      Option<StaticCall>.None => {
        let mut failure = run diagnostic(&machine.*, Fault.Unsupported, span)
        failure.missing = Option.some<MissingFact>(MissingFact.TypedApplication)
        fail move failure
      }
    }
    Result<Option<StaticCall>, Cycle | InvalidModulePath | OutOfMemoryError>.Failure {error} => match move error {
      OutOfMemoryError {} => { fail OutOfMemoryError {} }
      Cycle {} => run reject(&machine.*, Fault.Cycle, span)
      InvalidModulePath {} => run reject(&machine.*, Fault.Unavailable, span)
    }
  }
  return move call
}

effect fn callExpression<'source>(
  machine: &mut Machine<'source>,
  local: &mut Vector<Local>,
  id: HirId,
  arguments: CallArguments,
  span: Span,
) -> Shared<StaticData> ! Diagnostic | OutOfMemoryError ? &mut Allocator {
  if let Option<IntrinsicMember>.Some {value: member} = move checkedIntrinsicMember(&machine.*, id) {
    return run dispatchIntrinsic(&mut machine.*, member, id, arguments, &mut local.*, span)
  }
  let call = run directCall(&mut machine.*, id, span)
  let selectedName = run Bytes.copy(DeclarationId.spelling(Application.bodyDeclaration(&call.application)))
  let application = run closeCall(&machine.*, move call.application)
  let mut values = Vector.make<Shared<StaticData>>()
  let mut at = usize.ZERO
  while at < CallArguments.length(arguments) {
    let hir = run authored(&machine.*)
    let argument = CallArguments.child(arguments, hir, at)
    run Vector.append<Shared<StaticData>>(
      &mut values,
      run expression(&mut machine.*, &mut local.*, argument),
    )
    at = at + usize.ONE
  }
  return run demandApplication(
    &mut machine.*, &application, Bytes.asSlice(&selectedName),
    Vector.asSlice<Shared<StaticData>>(&values), span,
  )
}

// Reports whether `&&` or `||` is already decided by its left operand, so the right stays undemanded.
effect fn leftDecidesInfix<'source>(
  machine: &Machine<'source>,
  operator: InfixOperator,
  first: &Shared<StaticData>,
  span: Span,
) -> bool ! Diagnostic | OutOfMemoryError ? &mut Allocator {
  if operator != InfixOperator.And && operator != InfixOperator.Or {
    return false
  }
  let chosen = Shared.with<StaticData, Option<bool>>(first, boolean)
  let firstBool = match move chosen {
    Option<bool>.Some {value} => value
    Option<bool>.None => {
      return run reject(machine, Fault.InvalidValue, span)
    }
  }
  return (operator == InfixOperator.And && !firstBool) || (operator == InfixOperator.Or && firstBool)
}

effect fn expressionFromSource<'source>(machine: &mut Machine<'source>, local: &mut Vector<Local>, id: HirId) -> Shared<
  StaticData,
> ! Diagnostic | OutOfMemoryError ? &mut Allocator {
  run step(&mut machine.*, id)
  let node = Module.node(run authored(&machine.*), id)
  let span = Module.span(run authored(&machine.*), id)
  if let Option<CallInput>.Some {value: input} = move CallInput.ofNode(node) {
    let arguments = input.arguments
    return run callExpression(&mut machine.*, &mut local.*, id, arguments, span)
  }
  return match node {
    Node.BooleanLiteral {value} => run retain(
      &mut machine.*,
      StaticData.Boolean {value: value},
      span,
    )
    Node.UnitLiteral => run retain(&mut machine.*, StaticData.Unit, span)
    Node.CharacterLiteral {scalar} => {
      if let Option<StaticIntegerType>.Some {value: integer} = move checkedIntegerType(&machine.*, id) {
        let selected = match move StaticValue.integer(integer, StaticSign.Positive, u32.toU64(scalar), machine.target.pointerBits()) {
          Option<StaticData>.Some {value} => value
          Option<StaticData>.None => { return run reject(&machine.*, Fault.InvalidValue, span) }
        }
        return run retain(&mut machine.*, move selected, span)
      }
      let selected = match move StaticValue.character(scalar) {
        Option<StaticData>.Some {value} => value
        Option<StaticData>.None => {
          return run reject(&machine.*, Fault.InvalidValue, span)
        }
      }
      return run retain(&mut machine.*, move selected, span)
    }
    Node.TextLiteral {value} => {
      let bytes = run Bytes.copy(Module.text(run authored(&machine.*), value))
      let selected = match move StaticValue.text(move bytes) {
        Option<StaticData>.Some {value: textValue} => textValue
        Option<StaticData>.None => {
          return run reject(&machine.*, Fault.InvalidValue, span)
        }
      }
      let text = run retain(&mut machine.*, move selected, span)
      run rememberTextOrigin(&mut machine.*, &text, span)
      return move text
    }
    Node.FloatingLiteral {spelling, suffix: ignoredSuffix} => {
      let width = match move checkedFloatType(&machine.*, id) {
        Option<StaticFloatType>.Some {value} => value
        Option<StaticFloatType>.None => {
          let mut failure = run diagnostic(&machine.*, Fault.Unsupported, span)
          failure.missing = Option.some<MissingFact>(MissingFact.CheckedExpression)
          fail move failure
        }
      }
      let rounded = match move width {
        StaticFloatType.F32 => StaticValue.f32Literal(run authored(&machine.*), spelling)
        StaticFloatType.F64 => StaticValue.f64Literal(run authored(&machine.*), spelling)
      }
      return match move rounded {
        Result<StaticData, ParseError>.Success {value: selected} => run retain(
          &mut machine.*,
          move selected,
          span,
        )
        Result<StaticData, ParseError>.Failure {error: _} => run reject(
          &machine.*,
          Fault.InvalidValue,
          span,
        )
      }
    }
    Node.IntegerLiteral {..} => run integerExpression(&mut machine.*, id)
    Node.IdentifierExpression {binding, ..} => {
      let mut target = id
      if binding.present {
        target = binding.id
      }
      let bindings = Vector.asSlice<Local>(&local.*)
      let mut at = bindings.length
      while at > usize.ZERO {
        at = at - usize.ONE
        if bindings[at].binder.index == target.index || bindings[at].binder.index == id.index {
          return Shared.clone<StaticData>(&bindings[at].value)
        }
      }
      let external = run suppliedValue(&machine.*, id, target)
      if let Option<Shared<StaticData>>.Some {value} = move external {
        return move value
      }
      if let Option<Shared<DeclarationId>>.Some {value: declaration} = move checkedConstantDeclaration(&machine.*, id) {
        return run unresolvedConstant(&machine.*, id, move declaration)
      }
      return run reject(&machine.*, Fault.Unavailable, span)
    }
    Node.FieldExpression {..} => {
      if let Option<CheckedEnumMember>.Some {value: member} = move checkedEnumMember(&machine.*, id) {
        return run enumValue(&mut machine.*, id, member, span)
      }
      let bindings = Vector.asSlice<Local>(&local.*)
      let mut at = bindings.length
      while at > usize.ZERO {
        at = at - usize.ONE
        if bindings[at].binder.index == id.index {
          return Shared.clone<StaticData>(&bindings[at].value)
        }
      }
      let external = run suppliedValue(&machine.*, id, id)
      if let Option<Shared<StaticData>>.Some {value} = move external {
        return move value
      }
      if let Option<Shared<DeclarationId>>.Some {value: declaration} = move checkedConstantDeclaration(&machine.*, id) {
        return run unresolvedConstant(&machine.*, id, move declaration)
      }
      return run reject(&machine.*, Fault.Unavailable, span)
    }
    Node.MoveExpression {operand} => run expression(&mut machine.*, &mut local.*, operand)
    // A fixed array is admitted from its elements in order, under the value-size limit. An element
    // that is not itself an admitted static value leaves the array Unsupported.
    Node.ArrayExpression {elements} => {
      let ty = match move checkedExpressionType(&machine.*, id) {
        Option<Shared<SemanticType>>.Some {value} => value
        Option<Shared<SemanticType>>.None => { return run reject(&machine.*, Fault.Unavailable, span) }
      }
      let mut fields = Vector.make<Shared<StaticData>>()
      let mut at = usize.ZERO
      while at < elements.length {
        let child = Module.child(run authored(&machine.*), elements, at)
        let value = run expression(&mut machine.*, &mut local.*, child)
        run Vector.append<Shared<StaticData>>(&mut fields, move value)
        at = at + usize.ONE
      }
      return match move StaticValue.aggregate(move ty, Option.none<usize>(), move fields) {
        Option<StaticData>.Some {value} => run retain(&mut machine.*, move value, span)
        Option<StaticData>.None => run reject(&machine.*, Fault.Unsupported, span)
      }
    }
    Node.CompileErrorExpression {message} => {
      let value = run expression(&mut machine.*, &mut local.*, message)
      let reported = run StaticValue.textBytes(&value)
      let text = match move reported {
        Option<Bytes>.Some {value: copied} => copied
        Option<Bytes>.None => {
          return run reject(
            &machine.*,
            Fault.InvalidValue,
            Module.span(run authored(&machine.*), message),
          )
        }
      }
      let mut failure = run diagnostic(&machine.*, Fault.CompileError, span)
      failure.message = Option.some<Bytes>(move text)
      failure.origin = Option.some<Span>(Module.span(run authored(&machine.*), message))
      fail move failure
    }
    Node.PrefixExpression {operator, operatorAnchor, operand} => {
      let value = run expression(&mut machine.*, &mut local.*, operand)
      let result = StaticValue.prefixShared(operator, &value, machine.target.pointerBits())
      return match move result {
        Result<StaticData, StaticFault>.Success {value: selected} => run retain(
          &mut machine.*,
          move selected,
          span,
        )
        Result<StaticData, StaticFault>.Failure {error} => run rejectScalar(
          &machine.*,
          move error,
          operatorAnchor,
        )
      }
    }
    Node.InfixExpression {operator, operatorAnchor, left, right} => {
      let first = run expression(&mut machine.*, &mut local.*, left)
      if run leftDecidesInfix(&machine.*, operator, &first, span) {
        return move first
      }
      let second = run expression(&mut machine.*, &mut local.*, right)
      return run applyInfix(&mut machine.*, operator, operatorAnchor, span, &first, &second)
    }
    _ => run reject(&machine.*, Fault.Unavailable, span)
  }
}

effect<'owner & 'env> fn evaluateCurrent<'owner, 'env, 'source>(
  machine: &'owner mut Machine<'source>,
  bindings: &'env [Binding],
  id: HirId,
) -> Shared<StaticData> ! Diagnostic | OutOfMemoryError ? &mut Allocator {
  run supplyBindings(&mut machine.*, bindings)
  let mut local = Vector.make<Local>()
  let value = run expression(&mut machine.*, &mut local, id)
  let bytes = retainedValueBytes(&machine.*, &value)
  if machine.retainedBytes > machine.limits.valueBytes || bytes > machine.limits.valueBytes - machine.retainedBytes {
    return run reject(&machine.*, Fault.ValueLimit, Module.span(run authored(&machine.*), id))
  }
  machine.retainedBytes = machine.retainedBytes + bytes
  return move value
}

/// Evaluates one checked expression from the root module with immutable static binders and the machine's limits.
pub effect<'owner & 'env> fn evaluate<'owner, 'env, 'source>(
  machine: &'owner mut Machine<'source>,
  checked: &CheckedRoot,
  bindings: &'env [Binding],
  id: HirId,
) -> Shared<StaticData> ! Diagnostic | OutOfMemoryError ? &mut Allocator {
  let root = run ModuleId.copy(&machine.root)
  let cursor = run cursorFor(&mut machine.*, &root, Span.make(usize.ZERO, usize.ZERO))
  let matching = Shared.with<Observation, bool>(&checked.source, fn(observed: &Observation) -> bool {
    return StaticPort.matchesObservationAtCursor(&machine.port, &cursor, observed)
  })
  if !matching {
    let mut failure = run diagnostic(&machine.*, Fault.Unsupported, Span.make(usize.ZERO, usize.ZERO))
    failure.missing = Option.some<MissingFact>(MissingFact.CheckedSource)
    fail move failure
  }
  let previous = copyCurrent(&machine.*)
  let previousBody = match &machine.rootBody {
    Option<Shared<TypedBody>>.Some {value} => Option.some<Shared<TypedBody>>(Shared.clone<TypedBody>(&value))
    Option<Shared<TypedBody>>.None => Option.none<Shared<TypedBody>>()
  }
  let suppliedBase = Vector.length<RetainedBinding>(&machine.supplied)
  machine.current = Option.some<AuthoredCursor>(move cursor)
  machine.rootBody = Option.some<Shared<TypedBody>>(Shared.clone<TypedBody>(&checked.body))
  let reservation = SourceReservation {
    machine: move machine,
    previous: move previous,
    previousBody: move previousBody,
    suppliedBase: suppliedBase,
  }
  let use = effect fn(resource: &mut SourceReservation<'owner, 'source>) -> Shared<StaticData>
  ! Diagnostic | OutOfMemoryError
  ? &mut Allocator {
    return run evaluateCurrent(&mut resource.machine.*, bindings, id)
  }
  let release = effect fn(resource: &mut SourceReservation<'owner, 'source>) -> () {
    let supplied = Vector.asSlice<RetainedBinding>(&resource.machine.*.supplied)
    let mut at = resource.suppliedBase
    let mut releasedBytes = usize.ZERO
    while at < supplied.length {
      releasedBytes = releasedBytes + supplied[at].chargedBytes
      at = at + usize.ONE
    }
    Vector.truncate<RetainedBinding>(&mut resource.machine.*.supplied, resource.suppliedBase)
    resource.machine.*.retainedBytes = resource.machine.*.retainedBytes - releasedBytes
    resource.machine.*.current = copyPrevious(&resource.previous)
    resource.machine.*.rootBody = match &resource.previousBody {
      Option<Shared<TypedBody>>.Some {value} => Option.some<Shared<TypedBody>>(Shared.clone<TypedBody>(&value))
      Option<Shared<TypedBody>>.None => Option.none<Shared<TypedBody>>()
    }
    return ()
  }
  return run Effect.useReleaseNonParking(move reservation, move use, move release)
}

fn flowContinues(flow: &Flow) -> bool {
  return match &flow.* {
    Flow.Next => true
    _ => false
  }
}

// Runs the statements of a block in order, then drops the bindings the block introduced.
effect fn blockFlow<'source>(
  machine: &mut Machine<'source>,
  local: &mut Vector<Local>,
  statements: Range,
) -> Flow
! Diagnostic | OutOfMemoryError
? &mut Allocator {
  let base = Vector.length<Local>(&local.*)
  let mut at = usize.ZERO
  while at < statements.length {
    let child = Module.child(run authored(&machine.*), statements, at)
    let next = run statement(&mut machine.*, &mut local.*, child)
    if !flowContinues(&next) {
      Vector.truncate<Local>(&mut local.*, base)
      return move next
    }
    drop next
    at = at + usize.ONE
  }
  Vector.truncate<Local>(&mut local.*, base)
  return Flow.Next
}

effect fn whileFlow<'source>(
  machine: &mut Machine<'source>,
  local: &mut Vector<Local>,
  condition: HirId,
  body: HirId,
) -> Flow
! Diagnostic | OutOfMemoryError
? &mut Allocator {
  while run evaluatedBoolean(&mut machine.*, &mut local.*, condition) {
    let next = run statement(&mut machine.*, &mut local.*, body)
    match move next {
      Flow.Next => {}
      Flow.Continue => {}
      Flow.Break => {
        return Flow.Next
      }
      Flow.Return {value} => {
        return Flow.Return {value: move value}
      }
    }
  }
  return Flow.Next
}

// Stores the value of `value` into the innermost mutable local bound by `binding`, reporting
// whether such a local exists.
effect fn assignBinding<'source>(
  machine: &mut Machine<'source>,
  local: &mut Vector<Local>,
  binding: HirRef,
  value: HirId,
) -> bool
! Diagnostic | OutOfMemoryError
? &mut Allocator {
  if !binding.present {
    return false
  }
  let replacement = run expression(&mut machine.*, &mut local.*, value)
  let slots = Vector.asMutSlice<Local>(&mut local.*)
  let mut at = slots.length
  while at > usize.ZERO {
    at = at - usize.ONE
    if slots[at].binder.index == binding.id.index && slots[at].mutable {
      slots[at].value = move replacement
      return true
    }
  }
  return false
}

effect fn statement<'source>(
  machine: &mut Machine<'source>,
  local: &mut Vector<Local>,
  id: HirId,
) -> Flow
! Diagnostic | OutOfMemoryError
? &mut Allocator {
  run step(&mut machine.*, id)
  let node = Module.node(run authored(&machine.*), id)
  let span = Module.span(run authored(&machine.*), id)
  return match node {
    Node.Block {statements} => run blockFlow(&mut machine.*, &mut local.*, statements)
    Node.ExpressionStatement {expression: value} => {
      let ignored = run expression(&mut machine.*, &mut local.*, value)
      drop ignored
      return Flow.Next
    }
    Node.BindingStatement {mutable, isStatic, initializer, ..} => {
      if isStatic {
        return run reject(&machine.*, Fault.Unavailable, span)
      }
      let value = run expression(&mut machine.*, &mut local.*, initializer)
      run Vector.append<Local>(
        &mut local.*,
        Local {binder: id, mutable: mutable, value: move value},
      )
      return Flow.Next
    }
    Node.AssignmentStatement {target, value} => {
      let selected = Module.node(run authored(&machine.*), target)
      if let Node.IdentifierExpression {binding, ..} = selected {
        if run assignBinding(&mut machine.*, &mut local.*, binding, value) {
          return Flow.Next
        }
      }
      return run reject(&machine.*, Fault.Unavailable, Module.span(run authored(&machine.*), target))
    }
    Node.ConditionalStatement {condition, thenBranch, elseBranch} => {
      if run evaluatedBoolean(&mut machine.*, &mut local.*, condition) {
        return run statement(&mut machine.*, &mut local.*, thenBranch)
      }
      if elseBranch.present {
        return run statement(&mut machine.*, &mut local.*, elseBranch.id)
      }
      return Flow.Next
    }
    Node.StaticConditionalStatement {..} => {
      let selected = match move selectedStaticArm(&machine.*, id) {
        Option<HirRef>.Some {value: arm} => arm
        Option<HirRef>.None => {
          let mut failure = run diagnostic(&machine.*, Fault.Unsupported, span)
          failure.missing = Option.some<MissingFact>(MissingFact.CheckedBody)
          fail move failure
        }
      }
      if selected.present { return run statement(&mut machine.*, &mut local.*, selected.id) }
      return Flow.Next
    }
    Node.WhileStatement {condition, body} => run whileFlow(&mut machine.*, &mut local.*, condition, body)
    Node.BreakStatement => Flow.Break
    Node.ContinueStatement => Flow.Continue
    Node.ReturnStatement {value} => {
      if value.present {
        return Flow.Return {value: run expression(&mut machine.*, &mut local.*, value.id)}
      }
      return Flow.Return {value: run retain(&mut machine.*, StaticData.Unit, span)}
    }
    _ => run reject(&machine.*, Fault.Unavailable, span)
  }
}

effect fn execute<'source>(
  machine: &mut Machine<'source>,
  selected: &SelectedStaticFunction,
  application: &Application,
  signature: &Shared<Result<Answer, NoRejection>>,
  args: &[Shared<StaticData>],
) -> Shared<StaticData> ! Diagnostic | OutOfMemoryError ? &mut Allocator {
  let parameters = Vector.asSlice<HirId>(&selected.parameters)
  if parameters.length != args.length {
    return run reject(&machine.*, Fault.InvalidHeader, selected.span)
  }
  let mut local = Vector.make<Local>()
  let mut at = usize.ZERO
  while at < parameters.length {
    let parameter = Module.node(run authored(&machine.*), parameters[at])
    if let Node.Parameter {annotation, ..} = parameter {
      let declared = run selectedSignatureType(signature, Option.some<usize>(at), application)
      match move declared {
        Option<Shared<SemanticType>>.Some {value: ty} => {
          if !run StaticValue.matchesType(&args[at], &ty) {
            return run reject(&machine.*, Fault.InvalidValue, Module.span(run authored(&machine.*), annotation))
          }
        }
        Option<Shared<SemanticType>>.None => {
          let mut failure = run diagnostic(&machine.*, Fault.Unsupported, Module.span(run authored(&machine.*), annotation))
          failure.missing = Option.some<MissingFact>(MissingFact.DeclaredType)
          fail move failure
        }
      }
    } else {
      return run reject(&machine.*, Fault.InvalidHeader, Module.span(run authored(&machine.*), parameters[at]))
    }
    run Vector.append<Local>(
      &mut local,
      Local {binder: parameters[at], mutable: false, value: Shared.clone<StaticData>(&args[at])},
    )
    at = at + usize.ONE
  }
  let flow = run statement(&mut machine.*, &mut local, selected.block)
  let returned = match move flow {
    Flow.Return {value} => move value
    Flow.Next => run retain(&mut machine.*, StaticData.Unit, selected.span)
    _ => run reject(&machine.*, Fault.InvalidControl, selected.span)
  }
  let resultType = selected.result
  let mut resultSpan = selected.span
  if resultType.present {
    resultSpan = Module.span(run authored(&machine.*), resultType.id)
  }
  let declaredResult = run selectedSignatureType(signature, Option.none<usize>(), application)
  match move declaredResult {
    Option<Shared<SemanticType>>.Some {value: ty} => {
      if !run StaticValue.matchesType(&returned, &ty) {
        return run reject(&machine.*, Fault.InvalidValue, resultSpan)
      }
    }
    Option<Shared<SemanticType>>.None => {
      let mut failure = run diagnostic(&machine.*, Fault.Unsupported, resultSpan)
      failure.missing = Option.some<MissingFact>(MissingFact.DeclaredType)
      fail move failure
    }
  }
  return move returned
}

effect fn chooseRoot<'source>(
  machine: &mut Machine<'source>,
  caller: &ModuleId,
  selectedName: &[u8],
  callSpan: Span,
) -> Chosen
! Diagnostic | OutOfMemoryError
? &mut Allocator {
  let attempted = run Effect.result(StaticPort.resolveRootDeclaration(
    &mut machine.port, caller, selectedName, callSpan,
  ))
  let resolved = match move attempted {
    Result<Result<DeclarationId, Shared<Rejection>>, Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError>.Success {value} => move value
    Result<Result<DeclarationId, Shared<Rejection>>, Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError>.Failure {error} => match move error {
      OutOfMemoryError {} => { fail OutOfMemoryError {} }
      Cycle {} => run reject(&machine.*, Fault.Unavailable, callSpan)
      InvalidModulePath {} => run reject(&machine.*, Fault.Unavailable, callSpan)
      RevisionMismatch {} => run reject(&machine.*, Fault.Unavailable, callSpan)
    }
  }
  let declaration = match move resolved {
    Result<DeclarationId, Shared<Rejection>>.Success {value} => value
    Result<DeclarationId, Shared<Rejection>>.Failure {error: _} => {
      return run reject(&machine.*, Fault.Unavailable, callSpan)
    }
  }
  return run chooseDeclaration(&mut machine.*, &declaration, callSpan)
}

effect fn chooseDeclaration<'source>(
  machine: &mut Machine<'source>,
  declaration: &DeclarationId,
  callSpan: Span,
) -> Chosen
! Diagnostic | OutOfMemoryError
? &mut Allocator {
  let moduleRef = DeclarationId.moduleId(declaration)
  let sourceModule = run ModuleId.copy(moduleRef)
  let cursor = run cursorFor(&mut machine.*, &sourceModule, callSpan)
  let borrowed = StaticPort.sourceAtCursor(&machine.port, &cursor)
  let selected = match move borrowed {
    Option<&IndexedSource>.Some {value} => run StaticFunction.selectIndexed(value, declaration)
    Option<&IndexedSource>.None => { return run reject(&machine.*, Fault.Unavailable, callSpan) }
  }
  let function = match move selected {
    Result<SelectedStaticFunction, StaticHeaderRejection>.Success {value} => move value
    Result<SelectedStaticFunction, StaticHeaderRejection>.Failure {error} => {
      if error.fault == StaticHeaderFault.RuntimeFunction || error.fault == StaticHeaderFault.UnknownName {
        return run reject(&machine.*, Fault.Unavailable, callSpan)
      }
      return run reject(&machine.*, Fault.InvalidHeader, error.span)
    }
  }
  let attemptedSignature = run Effect.result(StaticPort.demandSignature(&mut machine.port, &function.declaration, callSpan))
  let signature = match move attemptedSignature {
    Result<Option<Shared<Result<Answer, NoRejection>>>, Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError>.Success {value} => match move value {
      Option<Shared<Result<Answer, NoRejection>>>.Some {value: answer} => answer
      Option<Shared<Result<Answer, NoRejection>>>.None => {
        let mut failure = run diagnostic(&machine.*, Fault.Unsupported, callSpan)
        failure.missing = Option.some<MissingFact>(MissingFact.DeclaredType)
        fail move failure
      }
    }
    Result<Option<Shared<Result<Answer, NoRejection>>>, Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError>.Failure {error} => match move error {
      OutOfMemoryError {} => { fail OutOfMemoryError {} }
      Cycle {} => run reject(&machine.*, Fault.Cycle, callSpan)
      InvalidModulePath {} => run reject(&machine.*, Fault.Unavailable, callSpan)
      RevisionMismatch {} => run reject(&machine.*, Fault.Unavailable, callSpan)
    }
  }
  return Chosen {function: move function, cursor: move cursor, signature: move signature}
}

effect<'owner & 'env> fn demandSelected<'owner, 'env, 'source>(
  machine: &'owner mut Machine<'source>,
  chosen: Chosen,
  application: &'env Application,
  selectedName: &'env [u8],
  args: &'env [Shared<StaticData>],
  callSpan: Span,
) -> Shared<StaticData> ! Diagnostic | OutOfMemoryError ? &mut Allocator {
  let Chosen {function: selected, cursor, signature} = move chosen
  if !DeclarationId.equals(Application.bodyDeclaration(application), &selected.declaration) {
    let mut failure = run diagnostic(&machine.*, Fault.Unsupported, callSpan)
    failure.missing = Option.some<MissingFact>(MissingFact.TypedApplication)
    fail move failure
  }
  // A reached body is a dependency of the active semantic query, including cache hits.
  let reached = run Effect.result(demandCheckedBody(&mut machine.*, &selected.declaration, callSpan))
  let body = match move reached {
    Result<Option<Shared<Result<Answer, NoRejection>>>, Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError>.Success {value} => match move value {
      Option<Shared<Result<Answer, NoRejection>>>.Some {value: answer} => match move Shared.with<Result<Answer, NoRejection>, Option<Result<Shared<TypedBody>, Shared<Rejection>>>>(
        &answer,
        bodyFromAnswer,
      ) {
        Option<Result<Shared<TypedBody>, Shared<Rejection>>>.Some {value: checked} => match move checked {
          Result<Shared<TypedBody>, Shared<Rejection>>.Success {value: body} => body
          Result<Shared<TypedBody>, Shared<Rejection>>.Failure {error: rejected} => {
            let span = Shared.with<Rejection, Span>(&rejected, fn(value: &Rejection) -> Span { return value.span })
            let mut failure = run diagnostic(&machine.*, Fault.Unsupported, span)
            failure.rejection = Option.some<Shared<Rejection>>(move rejected)
            fail move failure
          }
        }
        Option<Result<Shared<TypedBody>, Shared<Rejection>>>.None => {
          let mut failure = run diagnostic(&machine.*, Fault.Unsupported, callSpan)
          failure.missing = Option.some<MissingFact>(MissingFact.CheckedBody)
          fail move failure
        }
      }
      Option<Shared<Result<Answer, NoRejection>>>.None => run reject(&machine.*, Fault.Unavailable, callSpan)
    }
    Result<Option<Shared<Result<Answer, NoRejection>>>, Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError>.Failure {error} => match move error {
      OutOfMemoryError {} => { fail OutOfMemoryError {} }
      Cycle {} => run reject(&machine.*, Fault.Cycle, callSpan)
      InvalidModulePath {} => run reject(&machine.*, Fault.Unavailable, callSpan)
      RevisionMismatch {} => run reject(&machine.*, Fault.Unavailable, callSpan)
    }
  }
  // Checked applications include elided lifetime binders as well as written generics.
  // Validate against the same resolved signature that supplied those completed arguments.
  if !Shared.with<Result<Answer, NoRejection>, bool>(&signature, fn(answer: &Result<Answer, NoRejection>) -> bool {
    return signatureApplicationArityMatches(answer, application)
  }) {
    let mut failure = run diagnostic(&machine.*, Fault.Unsupported, callSpan)
    failure.missing = Option.some<MissingFact>(MissingFact.TypedApplication)
    fail move failure
  }
  let identity = match move run Pool.intern(&mut machine.applications, application) {
    Option<Identity>.Some {value} => value.semantic
    Option<Identity>.None => {
      let mut failure = run diagnostic(&machine.*, Fault.Unsupported, callSpan)
      failure.missing = Option.some<MissingFact>(MissingFact.TypedApplication)
      fail move failure
    }
  }
  let cached = run completed(&machine.*, identity, args)
  if let Option<Shared<StaticData>>.Some {value} = move cached {
    return move value
  }
  let active = Vector.asSlice<Frame>(&machine.active)
  let mut at = usize.ZERO
  while at < active.length {
    if active[at].application == identity && run sameArguments(
      Vector.asSlice<Shared<StaticData>>(&active[at].arguments),
      args,
    ) {
      return run reject(&machine.*, Fault.Cycle, callSpan)
    }
    at = at + usize.ONE
  }
  if Vector.length<Frame>(&machine.active) >= machine.limits.depth {
    return run reject(&machine.*, Fault.DepthLimit, callSpan)
  }
  run Vector.append<Frame>(
    &mut machine.active,
    Frame {
      application: identity,
      instance: run Application.copy(application),
      module: run ModuleId.copy(DeclarationId.moduleId(&selected.declaration)),
      name: run Bytes.copy(selectedName),
      arguments: run copyArguments(args),
      body: move body,
      span: callSpan,
    },
  )
  let previous = copyCurrent(&machine.*)
  machine.current = Option.some<AuthoredCursor>(move cursor)
  let reservation = FrameReservation {machine: move machine, previous: move previous}
  let use = effect fn(resource: &mut FrameReservation<'owner, 'source>) -> Shared<StaticData>
  ! Diagnostic | OutOfMemoryError
  ? &mut Allocator {
    let value = run execute(&mut resource.machine.*, &selected, application, &signature, args)
    run publish(&mut resource.machine.*, identity, args, &value, callSpan)
    return move value
  }
  let release = effect fn(resource: &mut FrameReservation<'owner, 'source>) -> () {
    let last = Vector.length<Frame>(&resource.machine.*.active) - usize.ONE
    let removed = Vector.remove<Frame>(&mut resource.machine.*.active, last)
    drop removed
    resource.machine.*.current = copyPrevious(&resource.previous)
    return ()
  }
  return run Effect.useReleaseNonParking(move reservation, move use, move release)
}

/// Demands a static function without written generic parameters from owned static values.
/// Elided lifetime arguments are completed before the shared application validation.
/// The active frame is released on failure or interruption.
pub effect<'owner & 'env> fn demand<'owner, 'env, 'source>(
  machine: &'owner mut Machine<'source>,
  selectedName: &'env [u8],
  args: &'env [Shared<StaticData>],
  callSpan: Span,
) -> Shared<StaticData> ! Diagnostic | OutOfMemoryError ? &mut Allocator {
  let caller = run ModuleId.copy(&machine.root)
  let chosen = run chooseRoot(&mut machine.*, &caller, selectedName, callSpan)
  if chosen.function.generics.length > usize.ZERO {
    let mut failure = run diagnostic(&machine.*, Fault.Unsupported, callSpan)
    failure.missing = Option.some<MissingFact>(MissingFact.TypedApplication)
    fail move failure
  }
  let inferred = Shared.with<Result<Answer, NoRejection>, Option<usize>>(&chosen.signature, rootLifetimeArgumentCount)
  let lifetimeCount = match move inferred {
    Option<usize>.Some {value} => value
    Option<usize>.None => {
      let mut failure = run diagnostic(&machine.*, Fault.Unsupported, callSpan)
      failure.missing = Option.some<MissingFact>(MissingFact.TypedApplication)
      fail move failure
    }
  }
  let mut arguments = Vector.make<Argument>()
  let mut at = usize.ZERO
  while at < lifetimeCount {
    // Static values retain their storage rather than borrowing from the demand caller.
    let lifetime = run Shared.make<Lifetime>(Lifetime.Static)
    run Vector.append<Argument>(&mut arguments, Argument.Lifetime {value: move lifetime})
    at = at + usize.ONE
  }
  let application = Application {
    target: ApplicationTarget.Named {declaration: run DeclarationId.copy(&chosen.function.declaration)},
    argumentOrdinals: run Application.denseOrdinals(Vector.length<Argument>(&arguments)),
    arguments: move arguments,
    scopes: Vector.make<ScopeBinding>(),
    statics: Vector.make<StaticSlot>(),
  }
  return run demandSelected(move machine, move chosen, &application, selectedName, args, callSpan)
}

/// Demands a checked, closed application with its exact generic arguments and selected evidence.
pub effect<'owner & 'env> fn demandApplication<'owner, 'env, 'source>(
  machine: &'owner mut Machine<'source>,
  application: &'env Application,
  selectedName: &'env [u8],
  args: &'env [Shared<StaticData>],
  callSpan: Span,
) -> Shared<StaticData> ! Diagnostic | OutOfMemoryError ? &mut Allocator {
  if Vector.length<ScopeBinding>(&application.scopes) > usize.ZERO {
    return run reject(&machine.*, Fault.Unsupported, callSpan)
  }
  if let ApplicationTarget.Operation {..} = &application.target {
    return run reject(&machine.*, Fault.StaticPhaseViolation, callSpan)
  }
  let chosen = run chooseDeclaration(&mut machine.*, Application.bodyDeclaration(application), callSpan)
  return run demandSelected(move machine, move chosen, application, selectedName, args, callSpan)
}
