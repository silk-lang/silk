//! Demand-driven execution of static function bodies and evaluator-local control flow.

import hir.Hir {HirId, HirRef, InfixOperator, Module, Node, PrefixOperator, Sign}
import lexer.Span {Span}
import semantic.DeclarationId {DeclarationId}
import semantic.ModuleIndex {ModuleIndex}
import semantic.SourceUnit {SourceUnit}
import semantic.Specialization {Application, Identity, Pool, Target as ApplicationTarget}
import semantic.StaticFunction
import semantic.StaticFunction {
  StaticFunction as SelectedStaticFunction,
  Rejection as StaticHeaderRejection,
  HeaderFault as StaticHeaderFault,
}
import semantic.StaticValue
import semantic.StaticValue {
  Fault as StaticFault,
  FloatType as StaticFloatType,
  IntegerType as StaticIntegerType,
  Sign as StaticSign,
  Value as StaticData,
}
import semantic.Target {Target as MachineTarget}
import semantic.Type {Argument, Type as SemanticType}
import silk.allocator {Allocator, OutOfMemoryError}
import silk.bytes {Bytes}
import silk.effect {Effect}
import silk.format {ParseError}
import silk.option {Option}
import silk.result {Result}
import silk.shared {Shared}
import silk.u8
import silk.u64
import silk.usize
import silk.vector {Vector}

/// Deterministic work limits for one demand graph.
pub struct Limits {
  pub steps: usize
  pub depth: usize
  pub valueBytes: usize
}

/// A source-defined failure; related calls are ordered from the root to the failing frame.
pub enum Fault {
  InvalidHeader,
  Unavailable,
  Unsupported,
  InvalidValue,
  InvalidControl,
  Overflow,
  DivisionByZero,
  CompileError,
  Cycle,
  StepLimit,
  DepthLimit,
  ValueLimit,
}

/// A fact required to execute a selected call that source HIR alone cannot supply.
pub enum MissingFact {
  TypedApplication,
  DeclaredType,
  SelectedOperationBody,
}

pub struct TraceStep {
  pub name: Bytes
  pub arguments: Vector<Shared<StaticData>>
  pub span: Span
}

pub struct Diagnostic {
  pub fault: Fault
  pub code: &'static [u8]
  pub span: Span
  pub target: MachineTarget
  pub message: Option<Bytes>
  pub origin: Option<Span>
  pub needed: Option<HirId>
  pub missing: Option<MissingFact>
  pub trace: Vector<TraceStep>
}

fn faultCode(fault: Fault) -> &'static [u8] {
  return match fault {
    Fault.InvalidHeader => b"SEM0176"
    Fault.Unavailable => b"SEM0176"
    Fault.Unsupported => b"SEM0176"
    Fault.InvalidValue => b"SEM0176"
    Fault.InvalidControl => b"SEM0176"
    Fault.Overflow => b"SEM0176"
    Fault.DivisionByZero => b"SEM0176"
    Fault.CompileError => b"SEM0177"
    Fault.Cycle => b"SEM0178"
    Fault.StepLimit => b"SEM0179"
    Fault.DepthLimit => b"SEM0180"
    Fault.ValueLimit => b"SEM0181"
  }
}

/// The stable source diagnostic code for a failed static demand.
pub fn code(diagnostic: &Diagnostic) -> &[u8] {
  return diagnostic.code
}

/// One immutable static value made available at an authored binder.
pub struct Binding {
  pub binder: HirId
  pub value: Shared<StaticData>
}

struct Local {
  binder: HirId
  mutable: bool
  value: Shared<StaticData>
}

struct Frame {
  application: usize
  name: Bytes
  arguments: Vector<Shared<StaticData>>
  span: Span
}

struct Complete {
  application: usize
  arguments: Vector<Shared<StaticData>>
  value: Shared<StaticData>
}

struct FrameReservation<'a, 'source> {
  machine: &'a mut Machine<'source>
}

union Flow {
  Next,
  Break,
  Continue,
  Return {value: Shared<StaticData>},
}

/// One held source and target for static applications. No body executes during construction.
pub struct Machine<'source> {
  unit: &'source SourceUnit
  index: ModuleIndex
  target: MachineTarget
  limits: Limits
  steps: usize
  retainedBytes: usize
  applications: Pool
  active: Vector<Frame>
  complete: Vector<Complete>
}

/// Prepares declarations without demanding any static body.
pub effect fn make<'source>(unit: &'source SourceUnit, target: MachineTarget, limits: Limits) -> Machine<
  'source,
> ! OutOfMemoryError ? &mut Allocator {
  let index = run ModuleIndex.build(unit)
  return Machine {
    unit: unit,
    index: move index,
    target: target,
    limits: move limits,
    steps: usize.ZERO,
    retainedBytes: usize.ZERO,
    applications: Pool.make(),
    active: Vector.make<Frame>(),
    complete: Vector.make<Complete>(),
  }
}

/// Borrows the exact parsed source whose HIR identities this machine evaluates.
pub fn source<'source>(machine: &Machine<'source>) -> &'source SourceUnit {
  return machine.unit
}

/// Reports consumed work so a caller can preserve the budget across dependency retries.
pub fn steps<'source>(machine: &Machine<'source>) -> usize {
  return machine.steps
}

effect fn diagnostic<'source>(machine: &Machine<'source>, fault: Fault, span: Span) -> Diagnostic
! OutOfMemoryError
? &mut Allocator {
  let sourceCode = faultCode(fault)
  let mut trace = Vector.make<TraceStep>()
  let active = Vector.asSlice<Frame>(&machine.active)
  let mut at = usize.ZERO
  while at < active.length {
    run Vector.append<TraceStep>(
      &mut trace,
      TraceStep {
        name: run Bytes.copy(Bytes.asSlice(&active[at].name)),
        arguments: run copyArguments(Vector.asSlice<Shared<StaticData>>(&active[at].arguments)),
        span: active[at].span,
      },
    )
    at = at + usize.ONE
  }
  return Diagnostic {
    fault: fault,
    code: sourceCode,
    span: span,
    target: machine.target,
    message: Option.none<Bytes>(),
    origin: Option.none<Span>(),
    needed: Option.none<HirId>(),
    missing: Option.none<MissingFact>(),
    trace: move trace,
  }
}

effect fn reject<'source>(machine: &Machine<'source>, fault: Fault, span: Span) -> never
! Diagnostic | OutOfMemoryError
? &mut Allocator {
  let failure = run diagnostic(machine, fault, span)
  fail move failure
}

effect fn rejectScalar<'source>(machine: &Machine<'source>, failure: StaticFault, span: Span) -> never
! Diagnostic | OutOfMemoryError
? &mut Allocator {
  return match failure {
    StaticFault.InvalidOperands => run reject(machine, Fault.InvalidValue, span)
    StaticFault.Overflow => run reject(machine, Fault.Overflow, span)
    StaticFault.DivisionByZero => run reject(machine, Fault.DivisionByZero, span)
  }
}

effect fn unresolved<'source>(machine: &Machine<'source>, id: HirId) -> never
! Diagnostic | OutOfMemoryError
? &mut Allocator {
  let mut failure = run diagnostic(machine, Fault.Unavailable, Module.span(&machine.unit.authored, id))
  failure.needed = Option.some<HirId>(id)
  fail move failure
}

effect fn step<'source>(machine: &mut Machine<'source>, id: HirId) -> ()
! Diagnostic | OutOfMemoryError
? &mut Allocator {
  if machine.steps >= machine.limits.steps {
    return run reject(&machine.*, Fault.StepLimit, Module.span(&machine.unit.authored, id))
  }
  machine.steps = machine.steps + usize.ONE
  return ()
}

effect fn retain<'source>(machine: &mut Machine<'source>, value: StaticData, span: Span) -> Shared<
  StaticData,
> ! Diagnostic | OutOfMemoryError ? &mut Allocator {
  if StaticValue.size(&value) > machine.limits.valueBytes {
    return run reject(&machine.*, Fault.ValueLimit, span)
  }
  return run Shared.make<StaticData>(move value)
}

effect fn sameArguments(left: &[Shared<StaticData>], right: &[Shared<StaticData>]) -> bool
! OutOfMemoryError
? &mut Allocator {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if !run StaticValue.equals(&left[at], &right[at]) {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

effect fn copyArguments(args: &[Shared<StaticData>]) -> Vector<Shared<StaticData>>
! OutOfMemoryError
? &mut Allocator {
  let mut copied = Vector.make<Shared<StaticData>>()
  let mut at = usize.ZERO
  while at < args.length {
    run Vector.append<Shared<StaticData>>(&mut copied, StaticValue.copy(&args[at]))
    at = at + usize.ONE
  }
  return move copied
}

effect fn completed<'source>(
  machine: &Machine<'source>,
  application: usize,
  args: &[Shared<StaticData>],
) -> Option<Shared<StaticData>> ! OutOfMemoryError ? &mut Allocator {
  let entries = Vector.asSlice<Complete>(&machine.complete)
  let mut at = usize.ZERO
  while at < entries.length {
    if entries[at].application == application && run sameArguments(
      Vector.asSlice<Shared<StaticData>>(&entries[at].arguments),
      args,
    ) {
      return Option.some<Shared<StaticData>>(StaticValue.copy(&entries[at].value))
    }
    at = at + usize.ONE
  }
  return Option.none<Shared<StaticData>>()
}

effect fn publish<'source>(
  machine: &mut Machine<'source>,
  application: usize,
  args: &[Shared<StaticData>],
  value: &Shared<StaticData>,
  span: Span,
) -> () ! Diagnostic | OutOfMemoryError ? &mut Allocator {
  let mut bytes = Shared.with<StaticData, usize>(value, StaticValue.size)
  let mut at = usize.ZERO
  while at < args.length {
    let argumentBytes = Shared.with<StaticData, usize>(&args[at], StaticValue.size)
    bytes = match move usize.checkedAdd(bytes, argumentBytes) {
      Option<usize>.Some {value: total} => total
      Option<usize>.None => {
        return run reject(&machine.*, Fault.ValueLimit, span)
      }
    }
    at = at + usize.ONE
  }
  if machine.retainedBytes > machine.limits.valueBytes || bytes > machine.limits.valueBytes - machine.retainedBytes {
    return run reject(&machine.*, Fault.ValueLimit, span)
  }
  let entry = Complete {
    application: application,
    arguments: run copyArguments(args),
    value: StaticValue.copy(value),
  }
  run Vector.append<Complete>(&mut machine.complete, move entry)
  machine.retainedBytes = machine.retainedBytes + bytes
  return ()
}

fn equal(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

fn name(module: &Module, id: HirId) -> Option<&[u8]> {
  return match Module.node(module, id) {
    Node.Name {text} => Option.some<&[u8]>(Module.text(module, text))
    _ => Option.none<&[u8]>()
  }
}

fn integerType(text: &[u8]) -> Option<StaticIntegerType> {
  if equal(text, b"u8") {
    return Option.some<StaticIntegerType>(StaticIntegerType.U8)
  }
  if equal(text, b"u16") {
    return Option.some<StaticIntegerType>(StaticIntegerType.U16)
  }
  if equal(text, b"u32") {
    return Option.some<StaticIntegerType>(StaticIntegerType.U32)
  }
  if equal(text, b"u64") {
    return Option.some<StaticIntegerType>(StaticIntegerType.U64)
  }
  if equal(text, b"usize") {
    return Option.some<StaticIntegerType>(StaticIntegerType.Usize)
  }
  if equal(text, b"i8") {
    return Option.some<StaticIntegerType>(StaticIntegerType.I8)
  }
  if equal(text, b"i16") {
    return Option.some<StaticIntegerType>(StaticIntegerType.I16)
  }
  if equal(text, b"i32") {
    return Option.some<StaticIntegerType>(StaticIntegerType.I32)
  }
  if equal(text, b"i64") {
    return Option.some<StaticIntegerType>(StaticIntegerType.I64)
  }
  if equal(text, b"isize") {
    return Option.some<StaticIntegerType>(StaticIntegerType.Isize)
  }
  return Option.none<StaticIntegerType>()
}

fn namedType(value: &StaticData, text: &[u8]) -> Option<bool> {
  if let Option<StaticIntegerType>.Some {value: expected} = move integerType(text) {
    return Option.some<bool>(match & value.* {
      StaticData.Integer {ty, ..} => ty == expected
      _ => false
    })
  }
  if equal(text, b"bool") {
    return Option.some<bool>(match & value.* {
      StaticData.Boolean {..} => true
      _ => false
    })
  }
  if equal(text, b"char") {
    return Option.some<bool>(match & value.* {
      StaticData.Character {..} => true
      _ => false
    })
  }
  if equal(text, b"string") {
    return Option.some<bool>(match & value.* {
      StaticData.Text {..} => true
      _ => false
    })
  }
  if equal(text, b"f32") {
    return Option.some<bool>(match & value.* {
      StaticData.Float {ty, ..} => ty == StaticFloatType.F32
      _ => false
    })
  }
  if equal(text, b"f64") {
    return Option.some<bool>(match & value.* {
      StaticData.Float {ty, ..} => ty == StaticFloatType.F64
      _ => false
    })
  }
  return Option.none<bool>()
}

fn semanticValueType(value: &StaticData, ty: &SemanticType) -> Option<bool> {
  return match & ty.* {
    SemanticType.Primitive {name: spelling} => namedType(value, Bytes.asSlice(&spelling))
    SemanticType.Unit => Option.some<bool>(match & value.* {
      StaticData.Unit => true
      _ => false
    })
    SemanticType.String {..} => Option.some<bool>(match & value.* {
      StaticData.Text {..} => true
      _ => false
    })
    _ => Option.none<bool>()
  }
}

fn declaredType(
  module: &Module,
  id: HirId,
  value: &StaticData,
  selected: &SelectedStaticFunction,
  application: &Application,
) -> Option<bool> {
  if let Node.UnitType {} = Module.node(module, id) {
    return Option.some<bool>(match & value.* {
      StaticData.Unit => true
      _ => false
    })
  }
  if let Node.NamedType {path, hasMode, ..} = Module.node(module, id) {
    if hasMode {
      return Option.none<bool>()
    }
    if let Node.Path {segments} = Module.node(module, path) {
      if segments.length == usize.ONE {
        let item = Module.child(module, segments, usize.ZERO)
        if let Option<&[u8]>.Some {value: spelling} = move name(module, item) {
          let primitive = namedType(value, spelling)
          if let Option<bool>.Some {value: valid} = move primitive {
            return Option.some<bool>(valid)
          }
          let arguments = Vector.asSlice<Argument>(&application.arguments)
          let mut at = usize.ZERO
          while at < selected.generics.length && at < arguments.length {
            let binder = Module.child(module, selected.generics, at)
            if let Node.TypeParameter {name: binderName, ..} = Module.node(module, binder) {
              if let Option<&[u8]>.Some {value: written} = move name(module, binderName) {
                if equal(written, spelling) {
                  if let Argument.Type {value: resolved} = &arguments[at] {
                    return Shared.with<SemanticType, Option<bool>>(
                      &resolved,
                      fn(ty: &SemanticType) -> Option<bool> {
                        return semanticValueType(value, ty)
                      },
                    )
                  }
                }
              }
            }
            at = at + usize.ONE
          }
        }
      }
    }
  }
  return Option.none<bool>()
}

fn integerAnnotationType(module: &Module, id: HirId) -> Option<StaticIntegerType> {
  if let Node.NamedType {path, hasMode, ..} = Module.node(module, id) {
    if !hasMode {
      if let Node.Path {segments} = Module.node(module, path) {
        if segments.length == usize.ONE {
          let item = Module.child(module, segments, usize.ZERO)
          if let Option<&[u8]>.Some {value: spelling} = move name(module, item) {
            return integerType(spelling)
          }
        }
      }
    }
  }
  return Option.none<StaticIntegerType>()
}

fn parseMagnitude(digits: &[u8]) -> Option<u64> {
  let mut value: u64 = 0
  let mut at = usize.ZERO
  while at < digits.length {
    let digit = digits[at]
    if digit < 48 || digit > 57 {
      return Option.none<u64>()
    }
    let scaled = match move u64.checkedMultiply(value, 10) {
      Option<u64>.Some {value: next} => next
      Option<u64>.None => {
        return Option.none<u64>()
      }
    }
    value = match move u64.checkedAdd(scaled, u8.toU64(digit - 48)) {
      Option<u64>.Some {value: next} => next
      Option<u64>.None => {
        return Option.none<u64>()
      }
    }
    at = at + usize.ONE
  }
  return Option.some<u64>(value)
}

fn boolean(value: &StaticData) -> Option<bool> {
  return match & value.* {
    StaticData.Boolean {value: selected} => Option.some<bool>(selected)
    _ => Option.none<bool>()
  }
}

effect fn evaluatedBoolean<'source>(
  machine: &mut Machine<'source>,
  local: &mut Vector<Local>,
  id: HirId,
) -> bool ! Diagnostic | OutOfMemoryError ? &mut Allocator {
  let value = run expression(&mut machine.*, &mut local.*, id)
  let selected = Shared.with<StaticData, Option<bool>>(&value, boolean)
  return match move selected {
    Option<bool>.Some {value: chosen} => chosen
    Option<bool>.None => run reject(
      &machine.*,
      Fault.InvalidValue,
      Module.span(&machine.unit.authored, id),
    )
  }
}

effect fn integerExpression<'source>(
  machine: &mut Machine<'source>,
  id: HirId,
  expected: Option<StaticIntegerType>,
) -> Shared<StaticData> ! Diagnostic | OutOfMemoryError ? &mut Allocator {
  let span = Module.span(&machine.unit.authored, id)
  if let Node.IntegerLiteral {sign, magnitude, suffix, ..} = Module.node(&machine.unit.authored, id) {
    let digits = Module.text(&machine.unit.authored, magnitude)
    let number = match move parseMagnitude(digits) {
      Option<u64>.Some {value} => value
      Option<u64>.None => {
        return run reject(&machine.*, Fault.InvalidValue, span)
      }
    }
    let mut ty = StaticIntegerType.U32
    if let Option<StaticIntegerType>.Some {value: contextual} = move expected {
      ty = contextual
    }
    if suffix.present {
      ty = match move integerType(Module.text(&machine.unit.authored, suffix.symbol)) {
        Option<StaticIntegerType>.Some {value} => value
        Option<StaticIntegerType>.None => {
          return run reject(&machine.*, Fault.InvalidValue, span)
        }
      }
    }
    let mut signed = StaticSign.Positive
    if sign == Sign.Negative {
      signed = StaticSign.Negative
    }
    let selected = match move StaticValue.integer(ty, signed, number, machine.target.pointerBits()) {
      Option<StaticData>.Some {value} => value
      Option<StaticData>.None => {
        return run reject(&machine.*, Fault.InvalidValue, span)
      }
    }
    return run retain(&mut machine.*, move selected, span)
  }
  return run reject(&machine.*, Fault.InvalidValue, span)
}

fn integerInfix(operator: InfixOperator) -> bool {
  return operator == InfixOperator.Add || operator == InfixOperator.Subtract ||
    operator == InfixOperator.Multiply || operator == InfixOperator.Divide ||
    operator == InfixOperator.Remainder || operator == InfixOperator.BitAnd ||
    operator == InfixOperator.BitOr || operator == InfixOperator.BitXor
}

effect fn applyInfix<'source>(
  machine: &mut Machine<'source>,
  operator: InfixOperator,
  operatorAnchor: Span,
  span: Span,
  first: &Shared<StaticData>,
  second: &Shared<StaticData>,
) -> Shared<StaticData> ! Diagnostic | OutOfMemoryError ? &mut Allocator {
  let result = StaticValue.infixShared(operator, first, second, machine.target.pointerBits())
  return match move result {
    Result<StaticData, StaticFault>.Success {value: selected} => run retain(
      &mut machine.*,
      move selected,
      span,
    )
    Result<StaticData, StaticFault>.Failure {error} => run rejectScalar(
      &machine.*,
      move error,
      operatorAnchor,
    )
  }
}

effect fn expression<'source>(machine: &mut Machine<'source>, local: &mut Vector<Local>, id: HirId) -> Shared<
  StaticData,
> ! Diagnostic | OutOfMemoryError ? &mut Allocator {
  run step(&mut machine.*, id)
  let node = Module.node(&machine.unit.authored, id)
  let span = Module.span(&machine.unit.authored, id)
  return match node {
    Node.BooleanLiteral {value} => run retain(
      &mut machine.*,
      StaticData.Boolean {value: value},
      span,
    )
    Node.UnitLiteral => run retain(&mut machine.*, StaticData.Unit, span)
    Node.CharacterLiteral {scalar} => {
      let selected = match move StaticValue.character(scalar) {
        Option<StaticData>.Some {value} => value
        Option<StaticData>.None => {
          return run reject(&machine.*, Fault.InvalidValue, span)
        }
      }
      return run retain(&mut machine.*, move selected, span)
    }
    Node.TextLiteral {value} => {
      let bytes = run Bytes.copy(Module.text(&machine.unit.authored, value))
      let selected = match move StaticValue.text(move bytes) {
        Option<StaticData>.Some {value: textValue} => textValue
        Option<StaticData>.None => {
          return run reject(&machine.*, Fault.InvalidValue, span)
        }
      }
      return run retain(&mut machine.*, move selected, span)
    }
    Node.FloatingLiteral {spelling, suffix} => {
      let mut f32Width = false
      if suffix.present {
        let written = Module.text(&machine.unit.authored, suffix.symbol)
        if equal(written, b"f32") {
          f32Width = true
        } else if !equal(written, b"f64") {
          return run reject(&machine.*, Fault.InvalidValue, span)
        }
      }
      let mut rounded = StaticValue.f64Literal(&machine.unit.authored, spelling)
      if f32Width {
        rounded = StaticValue.f32Literal(&machine.unit.authored, spelling)
      }
      return match move rounded {
        Result<StaticData, ParseError>.Success {value: selected} => run retain(
          &mut machine.*,
          move selected,
          span,
        )
        Result<StaticData, ParseError>.Failure {error: _} => run reject(
          &machine.*,
          Fault.InvalidValue,
          span,
        )
      }
    }
    Node.IntegerLiteral {..} => run integerExpression(&mut machine.*, id, Option.none<StaticIntegerType>())
    Node.IdentifierExpression {binding, ..} => {
      let mut target = id
      if binding.present {
        target = binding.id
      }
      let bindings = Vector.asSlice<Local>(&local.*)
      let mut at = bindings.length
      while at > usize.ZERO {
        at = at - usize.ONE
        if bindings[at].binder.index == target.index || bindings[at].binder.index == id.index {
          return Shared.clone<StaticData>(&bindings[at].value)
        }
      }
      return run unresolved(&machine.*, id)
    }
    Node.FieldExpression {..} => {
      let bindings = Vector.asSlice<Local>(&local.*)
      let mut at = bindings.length
      while at > usize.ZERO {
        at = at - usize.ONE
        if bindings[at].binder.index == id.index {
          return Shared.clone<StaticData>(&bindings[at].value)
        }
      }
      return run unresolved(&machine.*, id)
    }
    Node.MoveExpression {operand} => run expression(&mut machine.*, &mut local.*, operand)
    Node.CompileErrorExpression {message} => {
      let value = run expression(&mut machine.*, &mut local.*, message)
      let reported = run StaticValue.textBytes(&value)
      let text = match move reported {
        Option<Bytes>.Some {value: copied} => copied
        Option<Bytes>.None => {
          return run reject(
            &machine.*,
            Fault.InvalidValue,
            Module.span(&machine.unit.authored, message),
          )
        }
      }
      let mut failure = run diagnostic(&machine.*, Fault.CompileError, span)
      failure.message = Option.some<Bytes>(move text)
      failure.origin = Option.some<Span>(Module.span(&machine.unit.authored, message))
      fail move failure
    }
    Node.PrefixExpression {operator, operatorAnchor, operand} => {
      let value = run expression(&mut machine.*, &mut local.*, operand)
      let result = StaticValue.prefixShared(operator, &value, machine.target.pointerBits())
      return match move result {
        Result<StaticData, StaticFault>.Success {value: selected} => run retain(
          &mut machine.*,
          move selected,
          span,
        )
        Result<StaticData, StaticFault>.Failure {error} => run rejectScalar(
          &machine.*,
          move error,
          operatorAnchor,
        )
      }
    }
    Node.InfixExpression {operator, operatorAnchor, left, right} => {
      let first = run expression(&mut machine.*, &mut local.*, left)
      if operator == InfixOperator.And || operator == InfixOperator.Or {
        let chosen = Shared.with<StaticData, Option<bool>>(&first, boolean)
        let firstBool = match move chosen {
          Option<bool>.Some {value} => value
          Option<bool>.None => {
            return run reject(&machine.*, Fault.InvalidValue, span)
          }
        }
        if (operator == InfixOperator.And && !firstBool) || (operator == InfixOperator.Or && firstBool) {
          return move first
        }
      }
      let second = run expression(&mut machine.*, &mut local.*, right)
      return run applyInfix(&mut machine.*, operator, operatorAnchor, span, &first, &second)
    }
    Node.CallExpression {callee, arguments, generics} => {
      if generics.present {
        let mut failure = run diagnostic(&machine.*, Fault.Unsupported, span)
        failure.missing = Option.some<MissingFact>(MissingFact.TypedApplication)
        fail move failure
      }
      let called = Module.node(&machine.unit.authored, callee)
      if let Node.IdentifierExpression {name: calledName, binding} = called {
        if binding.present {
          if let Node.Declaration {..} = Module.node(&machine.unit.authored, binding.id) {} else {
            return run reject(&machine.*, Fault.Unavailable, span)
          }
        }
        let spelling = match move name(&machine.unit.authored, calledName) {
          Option<&[u8]>.Some {value} => run Bytes.copy(value)
          Option<&[u8]>.None => {
            return run reject(&machine.*, Fault.Unavailable, span)
          }
        }
        let selected = run choose(&machine.*, Bytes.asSlice(&spelling), span)
        let parameters = Vector.asSlice<HirId>(&selected.parameters)
        if parameters.length != arguments.length {
          return run reject(&machine.*, Fault.InvalidHeader, span)
        }
        let mut values = Vector.make<Shared<StaticData>>()
        let mut at = usize.ZERO
        while at < arguments.length {
          let argument = Module.child(&machine.unit.authored, arguments, at)
          let mut expected = Option.none<StaticIntegerType>()
          if let Node.Parameter {annotation, ..} = Module.node(&machine.unit.authored, parameters[at]) {
            expected = integerAnnotationType(&machine.unit.authored, annotation)
          }
          run Vector.append<Shared<StaticData>>(
            &mut values,
            run expressionWithIntegerContext(&mut machine.*, &mut local.*, argument, move expected),
          )
          at = at + usize.ONE
        }
        return run demand(
          &mut machine.*,
          Bytes.asSlice(&spelling),
          Vector.asSlice<Shared<StaticData>>(&values),
          span,
        )
      }
      return run reject(&machine.*, Fault.Unavailable, span)
    }
    _ => run reject(&machine.*, Fault.Unavailable, span)
  }
}

effect fn expressionWithIntegerContext<'source>(
  machine: &mut Machine<'source>,
  local: &mut Vector<Local>,
  id: HirId,
  expected: Option<StaticIntegerType>,
) -> Shared<StaticData> ! Diagnostic | OutOfMemoryError ? &mut Allocator {
  if let Option<StaticIntegerType>.Some {value: ty} = move expected {
    if let Node.IntegerLiteral {suffix, ..} = Module.node(&machine.unit.authored, id) {
      if !suffix.present {
        run step(&mut machine.*, id)
        return run integerExpression(&mut machine.*, id, Option.some<StaticIntegerType>(ty))
      }
    }
    if let Node.InfixExpression {operator, operatorAnchor, left, right} = Module.node(&machine.unit.authored, id) {
      if integerInfix(operator) {
        run step(&mut machine.*, id)
        let first = run expressionWithIntegerContext(
          &mut machine.*,
          &mut local.*,
          left,
          Option.some<StaticIntegerType>(ty),
        )
        let second = run expressionWithIntegerContext(
          &mut machine.*,
          &mut local.*,
          right,
          Option.some<StaticIntegerType>(ty),
        )
        let span = Module.span(&machine.unit.authored, id)
        return run applyInfix(
          &mut machine.*,
          operator,
          operatorAnchor,
          span,
          &first,
          &second,
        )
      }
    }
  }
  return run expression(&mut machine.*, &mut local.*, id)
}

/// Evaluates one demanded HIR expression with immutable static binders and the machine's limits.
pub effect<'owner & 'env> fn evaluate<'owner, 'env, 'source>(
  machine: &'owner mut Machine<'source>,
  bindings: &'env [Binding],
  id: HirId,
) -> Shared<StaticData> ! Diagnostic | OutOfMemoryError ? &mut Allocator {
  let mut local = Vector.make<Local>()
  let mut at = usize.ZERO
  while at < bindings.length {
    run Vector.append<Local>(
      &mut local,
      Local {
        binder: bindings[at].binder,
        mutable: false,
        value: StaticValue.copy(&bindings[at].value),
      },
    )
    at = at + usize.ONE
  }
  let value = run expression(&mut machine.*, &mut local, id)
  let bytes = Shared.with<StaticData, usize>(&value, StaticValue.size)
  if machine.retainedBytes > machine.limits.valueBytes || bytes > machine.limits.valueBytes - machine.retainedBytes {
    return run reject(&machine.*, Fault.ValueLimit, Module.span(&machine.unit.authored, id))
  }
  machine.retainedBytes = machine.retainedBytes + bytes
  return move value
}

effect fn statement<'source>(
  machine: &mut Machine<'source>,
  local: &mut Vector<Local>,
  id: HirId,
  resultAnnotation: HirRef,
) -> Flow
! Diagnostic | OutOfMemoryError
? &mut Allocator {
  run step(&mut machine.*, id)
  let node = Module.node(&machine.unit.authored, id)
  let span = Module.span(&machine.unit.authored, id)
  return match node {
    Node.Block {statements} => {
      let base = Vector.length<Local>(&local.*)
      let mut at = usize.ZERO
      while at < statements.length {
        let child = Module.child(&machine.unit.authored, statements, at)
        let next = run statement(&mut machine.*, &mut local.*, child, resultAnnotation)
        match move next {
          Flow.Next => {}
          Flow.Break => {
            Vector.truncate<Local>(&mut local.*, base)
            return Flow.Break
          }
          Flow.Continue => {
            Vector.truncate<Local>(&mut local.*, base)
            return Flow.Continue
          }
          Flow.Return {value} => {
            Vector.truncate<Local>(&mut local.*, base)
            return Flow.Return {value: move value}
          }
        }
        at = at + usize.ONE
      }
      Vector.truncate<Local>(&mut local.*, base)
      return Flow.Next
    }
    Node.ExpressionStatement {expression: value} => {
      let ignored = run expression(&mut machine.*, &mut local.*, value)
      drop ignored
      return Flow.Next
    }
    Node.BindingStatement {mutable, isStatic, annotation, initializer, ..} => {
      if isStatic {
        return run reject(&machine.*, Fault.Unavailable, span)
      }
      let mut expected = Option.none<StaticIntegerType>()
      if annotation.present {
        expected = integerAnnotationType(&machine.unit.authored, annotation.id)
      }
      let value = run expressionWithIntegerContext(&mut machine.*, &mut local.*, initializer, move expected)
      run Vector.append<Local>(
        &mut local.*,
        Local {binder: id, mutable: mutable, value: move value},
      )
      return Flow.Next
    }
    Node.AssignmentStatement {target, value} => {
      let selected = Module.node(&machine.unit.authored, target)
      if let Node.IdentifierExpression {binding, ..} = selected {
        if binding.present {
          let replacement = run expression(&mut machine.*, &mut local.*, value)
          let slots = Vector.asMutSlice<Local>(&mut local.*)
          let mut at = slots.length
          while at > usize.ZERO {
            at = at - usize.ONE
            if slots[at].binder.index == binding.id.index && slots[at].mutable {
              slots[at].value = move replacement
              return Flow.Next
            }
          }
        }
      }
      return run reject(&machine.*, Fault.Unavailable, Module.span(&machine.unit.authored, target))
    }
    Node.ConditionalStatement {condition, thenBranch, elseBranch} => {
      if run evaluatedBoolean(&mut machine.*, &mut local.*, condition) {
        return run statement(&mut machine.*, &mut local.*, thenBranch, resultAnnotation)
      }
      if elseBranch.present {
        return run statement(&mut machine.*, &mut local.*, elseBranch.id, resultAnnotation)
      }
      return Flow.Next
    }
    Node.WhileStatement {condition, body} => {
      while run evaluatedBoolean(&mut machine.*, &mut local.*, condition) {
        let next = run statement(&mut machine.*, &mut local.*, body, resultAnnotation)
        match move next {
          Flow.Next => {}
          Flow.Continue => {}
          Flow.Break => {
            return Flow.Next
          }
          Flow.Return {value} => {
            return Flow.Return {value: move value}
          }
        }
      }
      return Flow.Next
    }
    Node.BreakStatement => Flow.Break
    Node.ContinueStatement => Flow.Continue
    Node.ReturnStatement {value} => {
      if value.present {
        let mut expected = Option.none<StaticIntegerType>()
        if resultAnnotation.present {
          expected = integerAnnotationType(&machine.unit.authored, resultAnnotation.id)
        }
        return Flow.Return {value: run expressionWithIntegerContext(&mut machine.*, &mut local.*, value.id, move expected)}
      }
      return Flow.Return {value: run retain(&mut machine.*, StaticData.Unit, span)}
    }
    _ => run reject(&machine.*, Fault.Unavailable, span)
  }
}

effect fn execute<'source>(
  machine: &mut Machine<'source>,
  selected: &SelectedStaticFunction,
  application: &Application,
  args: &[Shared<StaticData>],
) -> Shared<StaticData> ! Diagnostic | OutOfMemoryError ? &mut Allocator {
  let parameters = Vector.asSlice<HirId>(&selected.parameters)
  if parameters.length != args.length {
    return run reject(&machine.*, Fault.InvalidHeader, selected.span)
  }
  let mut local = Vector.make<Local>()
  let mut at = usize.ZERO
  while at < parameters.length {
    let parameter = Module.node(&machine.unit.authored, parameters[at])
    if let Node.Parameter {annotation, ..} = parameter {
      let checked = Shared.with<StaticData, Option<bool>>(
        &args[at],
        fn(value: &StaticData) -> Option<bool> {
          return declaredType(&machine.unit.authored, annotation, value, selected, application)
        },
      )
      match move checked {
        Option<bool>.Some {value: valid} => {
          if !valid {
            return run reject(&machine.*, Fault.InvalidValue, Module.span(&machine.unit.authored, annotation))
          }
        }
        Option<bool>.None => {
          let mut failure = run diagnostic(&machine.*, Fault.Unsupported, Module.span(&machine.unit.authored, annotation))
          failure.missing = Option.some<MissingFact>(MissingFact.DeclaredType)
          fail move failure
        }
      }
    } else {
      return run reject(&machine.*, Fault.InvalidHeader, Module.span(&machine.unit.authored, parameters[at]))
    }
    run Vector.append<Local>(
      &mut local,
      Local {binder: parameters[at], mutable: false, value: Shared.clone<StaticData>(&args[at])},
    )
    at = at + usize.ONE
  }
  let flow = run statement(&mut machine.*, &mut local, selected.block, selected.result)
  let returned = match move flow {
    Flow.Return {value} => move value
    Flow.Next => run retain(&mut machine.*, StaticData.Unit, selected.span)
    _ => run reject(&machine.*, Fault.InvalidControl, selected.span)
  }
  let resultType = selected.result
  if resultType.present {
    let checked = Shared.with<StaticData, Option<bool>>(
      &returned,
      fn(value: &StaticData) -> Option<bool> {
        return declaredType(&machine.unit.authored, resultType.id, value, selected, application)
      },
    )
    match move checked {
      Option<bool>.Some {value: valid} => {
        if !valid {
          return run reject(&machine.*, Fault.InvalidValue, Module.span(&machine.unit.authored, resultType.id))
        }
      }
      Option<bool>.None => {
        let mut failure = run diagnostic(&machine.*, Fault.Unsupported, Module.span(&machine.unit.authored, resultType.id))
        failure.missing = Option.some<MissingFact>(MissingFact.DeclaredType)
        fail move failure
      }
    }
  } else {
    let unit = Shared.with<StaticData, bool>(&returned, fn(value: &StaticData) -> bool {
      return match & value.* {
        StaticData.Unit => true
        _ => false
      }
    })
    if !unit {
      return run reject(&machine.*, Fault.InvalidValue, selected.span)
    }
  }
  return move returned
}

effect fn choose<'source>(machine: &Machine<'source>, selectedName: &[u8], callSpan: Span) -> SelectedStaticFunction
! Diagnostic | OutOfMemoryError
? &mut Allocator {
  return match move run StaticFunction.select(machine.unit, &machine.index, selectedName) {
    Result<SelectedStaticFunction, StaticHeaderRejection>.Success {value} => value
    Result<SelectedStaticFunction, StaticHeaderRejection>.Failure {error} => {
      if error.fault == StaticHeaderFault.RuntimeFunction || error.fault == StaticHeaderFault.UnknownName {
        return run reject(machine, Fault.Unavailable, callSpan)
      }
      return run reject(machine, Fault.InvalidHeader, error.span)
    }
  }
}

effect<'owner & 'env> fn demandSelected<'owner, 'env, 'source>(
  machine: &'owner mut Machine<'source>,
  selected: SelectedStaticFunction,
  application: &'env Application,
  selectedName: &'env [u8],
  args: &'env [Shared<StaticData>],
  callSpan: Span,
) -> Shared<StaticData> ! Diagnostic | OutOfMemoryError ? &mut Allocator {
  if !DeclarationId.equals(Application.bodyDeclaration(application), &selected.declaration) ||
    Vector.length<Argument>(&application.arguments) != selected.generics.length {
    let mut failure = run diagnostic(&machine.*, Fault.Unsupported, callSpan)
    failure.missing = Option.some<MissingFact>(MissingFact.TypedApplication)
    fail move failure
  }
  let identity = match move run Pool.intern(&mut machine.applications, application) {
    Option<Identity>.Some {value} => value.semantic
    Option<Identity>.None => {
      let mut failure = run diagnostic(&machine.*, Fault.Unsupported, callSpan)
      failure.missing = Option.some<MissingFact>(MissingFact.TypedApplication)
      fail move failure
    }
  }
  let cached = run completed(&machine.*, identity, args)
  if let Option<Shared<StaticData>>.Some {value} = move cached {
    return move value
  }
  let active = Vector.asSlice<Frame>(&machine.active)
  let mut at = usize.ZERO
  while at < active.length {
    if active[at].application == identity && run sameArguments(
      Vector.asSlice<Shared<StaticData>>(&active[at].arguments),
      args,
    ) {
      return run reject(&machine.*, Fault.Cycle, callSpan)
    }
    at = at + usize.ONE
  }
  if Vector.length<Frame>(&machine.active) >= machine.limits.depth {
    return run reject(&machine.*, Fault.DepthLimit, callSpan)
  }
  run Vector.append<Frame>(
    &mut machine.active,
    Frame {
      application: identity,
      name: run Bytes.copy(selectedName),
      arguments: run copyArguments(args),
      span: callSpan,
    },
  )
  let reservation = FrameReservation {machine: move machine}
  let use = effect fn(resource: &mut FrameReservation<'owner, 'source>) -> Shared<StaticData>
  ! Diagnostic | OutOfMemoryError
  ? &mut Allocator {
    let value = run execute(&mut resource.machine.*, &selected, application, args)
    run publish(&mut resource.machine.*, identity, args, &value, callSpan)
    return move value
  }
  let release = effect fn(resource: &mut FrameReservation<'owner, 'source>) -> () {
    let last = Vector.length<Frame>(&resource.machine.*.active) - usize.ONE
    let removed = Vector.remove<Frame>(&mut resource.machine.*.active, last)
    drop removed
    return ()
  }
  return run Effect.useReleaseNonParking(move reservation, move use, move release)
}

/// Demands a source-only nongeneric static function. The active frame is released on failure or interruption.
pub effect<'owner & 'env> fn demand<'owner, 'env, 'source>(
  machine: &'owner mut Machine<'source>,
  selectedName: &'env [u8],
  args: &'env [Shared<StaticData>],
  callSpan: Span,
) -> Shared<StaticData> ! Diagnostic | OutOfMemoryError ? &mut Allocator {
  let selected = run choose(&machine.*, selectedName, callSpan)
  if selected.generics.length > usize.ZERO {
    let mut failure = run diagnostic(&machine.*, Fault.Unsupported, callSpan)
    failure.missing = Option.some<MissingFact>(MissingFact.TypedApplication)
    fail move failure
  }
  let application = Application {
    target: ApplicationTarget.Named {declaration: run DeclarationId.copy(&selected.declaration)},
    arguments: Vector.make<Argument>(),
  }
  return run demandSelected(move machine, move selected, &application, selectedName, args, callSpan)
}

/// Demands a checked, closed application with its exact generic arguments and selected evidence.
pub effect<'owner & 'env> fn demandApplication<'owner, 'env, 'source>(
  machine: &'owner mut Machine<'source>,
  application: &'env Application,
  selectedName: &'env [u8],
  args: &'env [Shared<StaticData>],
  callSpan: Span,
) -> Shared<StaticData> ! Diagnostic | OutOfMemoryError ? &mut Allocator {
  if let ApplicationTarget.Operation {..} = &application.target {
    let mut failure = run diagnostic(&machine.*, Fault.Unsupported, callSpan)
    failure.missing = Option.some<MissingFact>(MissingFact.SelectedOperationBody)
    fail move failure
  }
  let selected = run choose(&machine.*, selectedName, callSpan)
  return run demandSelected(move machine, move selected, application, selectedName, args, callSpan)
}
