//! Focused source tests for typed query ownership and scoped reservations.

import semantic.Query {Cycle, Query}
import semantic.DependencyGraph as Graph {Dependee, DependencyGraph, UnitState}
import silk.allocator {Allocator, OutOfMemoryError}
import silk.effect {Effect}
import silk.execution {Execution, Wake}
import silk.hash {Hash, Word}
import silk.option {Option}
import silk.ownership {Drop}
import silk.result {Result}
import silk.shared {Shared}
import silk.testing {AssertionError, Testing}
import silk.vector {Vector}
import silk.bytes {Bytes}
import silk.usize

struct Rejection {
  code: i32
}

struct ProviderError {
  code: i32
}

struct NestedAnswer {
  marker: Bytes
  retained: Shared<Bytes>
}

effect fn ownedNested(owner: &mut Query<NestedAnswer, Rejection>, key: Word) -> Result<
  NestedAnswer,
  Rejection,
> ! OutOfMemoryError ? &mut Allocator {
  let retained = run Shared<Bytes>.make(run Bytes.copy(b"retained"))
  return Result<NestedAnswer, Rejection>.succeed(
    NestedAnswer {marker: run Bytes.copy(b"marker"), retained: move retained},
  )
}

effect fn nestedMustNotRun(owner: &mut Query<NestedAnswer, Rejection>, key: Word) -> Result<
  NestedAnswer,
  Rejection,
> {
  let stopped = 1 / 0
  return Result<NestedAnswer, Rejection>.failResult(Rejection {code: stopped})
}

effect fn nestedAnswerHit() -> ()
! OutOfMemoryError | Cycle | AssertionError<'static>
? &mut Allocator {
  let mut query = Query<NestedAnswer, Rejection>.make()
  let first = run Query.demand(&mut query, Hash.word(12), ownedNested)
  let again = run Query.demand(&mut query, Hash.word(12), nestedMustNotRun)
  run Testing.expect(Query.length(&query) == 1, "nested answer remains completed")
  drop first
  drop again
  return ()
}

test effect fn reusesAnswerContainingSharedHandle() -> ()
! OutOfMemoryError | Cycle | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run nestedAnswerHit()
    |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn accepted(owner: &mut Query<i32, Rejection>, key: Word) -> Result<i32, Rejection> {
  return Result<i32, Rejection>.succeed(41)
}

effect fn rejected(owner: &mut Query<i32, Rejection>, key: Word) -> Result<i32, Rejection> {
  return Result<i32, Rejection>.failResult(Rejection {code: 7})
}

effect fn mustNotRun(owner: &mut Query<i32, Rejection>, key: Word) -> Result<i32, Rejection> {
  let stopped = 1 / 0
  return Result<i32, Rejection>.succeed(stopped)
}

effect fn failed(owner: &mut Query<i32, Rejection>, key: Word) -> Result<i32, Rejection>
! ProviderError {
  fail ProviderError {code: 19}
}

effect fn recursive(owner: &mut Query<i32, Rejection>, key: Word) -> Result<i32, Rejection>
! Cycle | OutOfMemoryError
? &mut Allocator {
  let ignored = run Query.demand(move owner, key, recursive)
  drop ignored
  return Result<i32, Rejection>.succeed(0)
}

effect fn nested(owner: &mut Query<i32, Rejection>, key: Word) -> Result<i32, Rejection>
! Cycle | OutOfMemoryError
? &mut Allocator {
  if key.value == 5 {
    let inner = run Query.demand(move owner, Hash.word(6), nested)
    drop inner
  }
  return Result<i32, Rejection>.succeed(41)
}

effect fn ownedBytes(owner: &mut Query<Vector<u8>, Rejection>, key: Word) -> Result<
  Vector<u8>,
  Rejection,
> ! OutOfMemoryError ? &mut Allocator {
  let mut bytes = Vector<u8>.make()
  run Vector<u8>.append(&mut bytes, 42)
  return Result<Vector<u8>, Rejection>.succeed(move bytes)
}

fn acceptedValue(value: &Result<i32, Rejection>) -> bool {
  return match & value.* {
    Result<i32, Rejection>.Success {value: answer} => answer == 41
    Result<i32, Rejection>.Failure {error: _} => false
  }
}

fn rejectedValue(value: &Result<i32, Rejection>) -> bool {
  return match & value.* {
    Result<i32, Rejection>.Success {value: _} => false
    Result<i32, Rejection>.Failure {error} => error.code == 7
  }
}

fn unexpectedAnswer(value: Shared<Result<i32, Rejection>>) -> bool {
  drop value
  return false
}

effect fn completedAnswers() -> ()
! OutOfMemoryError | Cycle | AssertionError<'static>
? &mut Allocator {
  let mut query = Query<i32, Rejection>.make()
  let first = run Query.demand(&mut query, Hash.word(1), accepted)
  let second = run Query.demand(&mut query, Hash.word(1), mustNotRun)
  let rejection = run Query.demand(&mut query, Hash.word(2), rejected)
  let repeated = run Query.demand(&mut query, Hash.word(2), mustNotRun)
  run Testing.expect(
    Shared<Result<i32, Rejection>>.with<bool>(&first, acceptedValue),
    "first answer",
  )
  run Testing.expect(
    Shared<Result<i32, Rejection>>.with<bool>(&second, acceptedValue),
    "cached answer",
  )
  run Testing.expect(
    Shared<Result<i32, Rejection>>.with<bool>(&rejection, rejectedValue),
    "rejection",
  )
  run Testing.expect(
    Shared<Result<i32, Rejection>>.with<bool>(&repeated, rejectedValue),
    "cached rejection",
  )
  run Testing.expect(Query.length(&query) == 2, "completed entries")
  return ()
}

test effect fn cachesTypedOutcomes() -> () ! OutOfMemoryError | Cycle | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run completedAnswers()
    |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn failedDemandReleases() -> ()
! OutOfMemoryError | Cycle | AssertionError<'static>
? &mut Allocator {
  let mut query = Query<i32, Rejection>.make()
  let attempted = run Effect.result(Query.demand(&mut query, Hash.word(3), failed))
  let providerFailed = match move attempted {
    Result<Shared<Result<i32, Rejection>>, Cycle | ProviderError | OutOfMemoryError>.Success {value} => unexpectedAnswer(
      move value,
    )
    Result<Shared<Result<i32, Rejection>>, Cycle | ProviderError | OutOfMemoryError>.Failure {error} => match move error {
      ProviderError {code} => code == 19
      Cycle {} => false
      OutOfMemoryError {} => false
    }
  }
  run Testing.expect(providerFailed, "typed provider failure is distinct")
  run Testing.expect(Query.length(&query) == 0, "failed key is released")
  let retried = run Query.demand(&mut query, Hash.word(3), accepted)
  run Testing.expect(
    Shared<Result<i32, Rejection>>.with<bool>(&retried, acceptedValue),
    "retry completes",
  )
  return ()
}

test effect fn retriesAfterTypedFailure() -> () ! OutOfMemoryError | Cycle | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run failedDemandReleases()
    |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn cycleAndNestedDemand() -> ()
! OutOfMemoryError | Cycle | AssertionError<'static>
? &mut Allocator {
  let mut query = Query<i32, Rejection>.make()
  let attempted = run Effect.result(Query.demand(&mut query, Hash.word(4), recursive))
  let cycled = match move attempted {
    Result<Shared<Result<i32, Rejection>>, Cycle | OutOfMemoryError>.Success {value} => unexpectedAnswer(
      move value,
    )
    Result<Shared<Result<i32, Rejection>>, Cycle | OutOfMemoryError>.Failure {error} => match move error {
      Cycle {} => true
      OutOfMemoryError {} => false
    }
  }
  run Testing.expect(cycled, "recursive key reports a cycle")
  run Testing.expect(Query.length(&query) == 0, "cycle releases the outer key")
  let outer = run Query.demand(&mut query, Hash.word(5), nested)
  run Testing.expect(
    Shared<Result<i32, Rejection>>.with<bool>(&outer, acceptedValue),
    "nested answer",
  )
  run Testing.expect(Query.length(&query) == 2, "both nested keys complete")
  return ()
}

test effect fn recognizesCyclesAndAllowsNestedKeys() -> ()
! OutOfMemoryError | Cycle | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run cycleAndNestedDemand()
    |> Effect.provideMut<Allocator>(&mut allocator)
}

fn oneOwnedByte(value: &Result<Vector<u8>, Rejection>) -> bool {
  return match & value.* {
    Result<Vector<u8>, Rejection>.Success {value: bytes} => Vector<u8>.length(&bytes) == 1 && Vector<
      u8,
    >.get(&bytes, 0) == 42
    Result<Vector<u8>, Rejection>.Failure {error: _} => false
  }
}

effect fn moveOnlyAnswer() -> ()
! OutOfMemoryError | Cycle | AssertionError<'static>
? &mut Allocator {
  let mut query = Query<Vector<u8>, Rejection>.make()
  let answer = run Query.demand(&mut query, Hash.word(7), ownedBytes)
  let repeated = run Query.demand(&mut query, Hash.word(7), ownedBytes)
  run Testing.expect(
    Shared<Result<Vector<u8>, Rejection>>.with<bool>(&answer, oneOwnedByte),
    "move-only answer stays owned",
  )
  run Testing.expect(
    Shared<Result<Vector<u8>, Rejection>>.with<bool>(&repeated, oneOwnedByte),
    "move-only cache hit stays owned",
  )
  return ()
}

test effect fn storesMoveOnlyAnswers() -> () ! OutOfMemoryError | Cycle | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run moveOnlyAnswer()
    |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn capturedHit() -> () ! OutOfMemoryError | Cycle | AssertionError<'static> ? &mut Allocator {
  let marker = run Bytes.copy(b"source")
  let mut query = Query<i32, Rejection>.make()
  let first = run Query.demand(
    &mut query,
    Hash.word(9),
    effect fn(owner: &mut Query<i32, Rejection>, key: Word) -> Result<i32, Rejection> {
      return Result<i32, Rejection>.succeed(usize.toI32(Bytes.length(&marker)))
    },
  )
  let second = run Query.demand(
    &mut query,
    Hash.word(9),
    effect fn(owner: &mut Query<i32, Rejection>, key: Word) -> Result<i32, Rejection> {
      let stopped = 1 / 0
      return Result<i32, Rejection>.succeed(usize.toI32(Bytes.length(&marker)) + stopped)
    },
  )
  run Testing.expect(Query.length(&query) == 1, "captured hit keeps one answer")
  drop first
  drop second
  return ()
}

test effect fn reusesAnswerWithCapturedProvider() -> ()
! OutOfMemoryError | Cycle | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run capturedHit()
    |> Effect.provideMut<Allocator>(&mut allocator)
}

struct CancellationMark {
  released: bool
  suspended: bool
  retained: Option<Query<i32, Rejection>>
}

struct TrackedQuery {
  query: Query<i32, Rejection>
  mark: Shared<CancellationMark>
}

impl Drop for TrackedQuery {
  fn drop(self: &mut TrackedQuery) -> () {
    let retained = Intrinsic.replace(self.query, Query<i32, Rejection>.make())
    let released = Query.length(&retained) == 0
    Shared<CancellationMark>.withMut<()>(
      &self.mark,
      fn(mark: &mut CancellationMark) -> () {
        mark.released = released
        mark.retained = Option<Query<i32, Rejection>>.some(move retained)
        return ()
      },
    )
    return ()
  }
}

fn register(wake: Wake) -> () {
  drop wake
  return ()
}

effect fn parked(owner: &mut Query<i32, Rejection>, key: Word) -> Result<i32, Rejection> {
  run Execution.park(register)
  return Result<i32, Rejection>.succeed(0)
}

effect fn nestedParked(owner: &mut Query<i32, Rejection>, key: Word) -> Result<i32, Rejection>
! OutOfMemoryError | Cycle
? &mut Allocator {
  let inner = run Query.demand(move owner, Hash.word(9), parked)
  drop inner
  return Result<i32, Rejection>.succeed(41)
}

effect fn nestedAfterCancellation(owner: &mut Query<i32, Rejection>, key: Word) -> Result<
  i32,
  Rejection,
> ! OutOfMemoryError | Cycle ? &mut Allocator {
  let inner = run Query.demand(move owner, Hash.word(9), accepted)
  drop inner
  return Result<i32, Rejection>.succeed(41)
}

effect fn cancelledWork(mark: Shared<CancellationMark>) -> ()
! OutOfMemoryError | Cycle
? &mut Allocator {
  let mut tracked = TrackedQuery {query: Query<i32, Rejection>.make(), mark: move mark}
  let answer = run Query.demand(&mut tracked.query, Hash.word(8), nestedParked)
  drop answer
  return ()
}

effect fn ignoreCancellationError(error: OutOfMemoryError | Cycle) -> () {
  drop error
  return ()
}

effect fn cancelledBody(mark: Shared<CancellationMark>) -> () {
  let mut allocator = Allocator.systemAllocatorProvider()
  let work = cancelledWork(move mark)
    |> Effect.provideMut<Allocator>(&mut allocator)
  return run Effect.catchAll(move work, ignoreCancellationError)
}

fn ready(state: &()) -> () {
  return ()
}

fn completed(state: Shared<CancellationMark>, answer: ()) -> () {
  drop state
  return ()
}

fn suspended(state: Shared<CancellationMark>, execution: Intrinsic.Execution<()>) -> () {
  Shared<CancellationMark>.withMut<()>(
    &state,
    fn(mark: &mut CancellationMark) -> () {
      mark.suspended = true
      return ()
    },
  )
  drop execution
  drop state
  return ()
}

effect fn cancellationReleases() -> ()
! OutOfMemoryError | Cycle | AssertionError<'static>
? &mut Allocator {
  let mark = run Shared<CancellationMark>.make(
    CancellationMark {
      released: false,
      suspended: false,
      retained: Option<Query<i32, Rejection>>.none(),
    },
  )
  let execution = run Execution.make(cancelledBody(Shared.clone(&mark)), (), ready)
  run Execution.drive(move execution, Shared.clone(&mark), completed, suspended)
  let retained = Shared<CancellationMark>.withMut<Option<Query<i32, Rejection>>>(
    &mark,
    fn(value: &mut CancellationMark) -> Option<Query<i32, Rejection>> {
      return Intrinsic.replace(value.retained, Option<Query<i32, Rejection>>.none())
    },
  )
  run Testing.expect(
    Shared<CancellationMark>.with<bool>(
      &mark,
      fn(value: &CancellationMark) -> bool {
        return value.suspended && value.released
      },
    ),
    "cancellation releases both nested active keys without partial completion",
  )
  if let Option<Query<i32, Rejection>>.Some {value} = move retained {
    let mut query = move value
    run Testing.expect(Query.length(&query) == 0, "cancelled store has no active or completed keys")
    let answer = run Query.demand(&mut query, Hash.word(8), nestedAfterCancellation)
    run Testing.expect(
      Shared<Result<i32, Rejection>>.with<bool>(&answer, acceptedValue) && Query.length(&query) == 2,
      "same store retries and publishes both nested answers",
    )
  } else {
    run Testing.expect(false, "cancelled store is retained for retry")
  }
  return ()
}

test effect fn cancelsNestedReservationsAndRetriesSameStore() -> ()
! OutOfMemoryError | Cycle | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run cancellationReleases()
    |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn graphRecorded(graph: &mut DependencyGraph, unit: usize, dependee: Dependee) -> ()
! OutOfMemoryError ? &mut Allocator {
  run Graph.startRun(&mut graph.*, unit)
  run Graph.record(&mut graph.*, unit, dependee)
  run Graph.finishRun(&mut graph.*, unit)
  return ()
}

effect fn distinctGraphProperties() -> ()
! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut graph = Graph.make(true)
  run graphRecorded(&mut graph, 0, Dependee.Name {module: 2, name: 7})
  run graphRecorded(&mut graph, 1, Dependee.Name {module: 2, name: 8})
  run graphRecorded(&mut graph, 2, Dependee.DeclSource {declaration: 4})
  run graphRecorded(&mut graph, 3, Dependee.DeclPrototype {declaration: 4})
  run graphRecorded(&mut graph, 4, Dependee.DeclLocation {declaration: 4})
  run graphRecorded(&mut graph, 5, Dependee.Namespace {module: 2})
  run graphRecorded(&mut graph, 6, Dependee.SourceFile {module: 2})
  run graphRecorded(&mut graph, 7, Dependee.UnitResult {unit: 0})
  let first = Graph.firstEdgeOf(&graph, 0)
  let correctKey = match Graph.dependeeOf(&graph, first) {
    Dependee.Name {module, name} => module == 2 && name == 7
    _ => false
  }
  run Testing.expect(correctKey && Graph.counters(&graph).dependees == 8
      && Graph.propertyCount(&graph) == 6,
    "distinct approved properties have distinct stored keys")
  run Graph.inputChanged(&mut graph, Dependee.Name {module: 2, name: 7})
  run Testing.expect(Graph.state(&graph, 0) == UnitState.Outdated
      && Graph.state(&graph, 7) == UnitState.Outdated
      && Graph.state(&graph, 1) == UnitState.UpToDate
      && Graph.state(&graph, 2) == UnitState.UpToDate
      && Graph.state(&graph, 3) == UnitState.UpToDate
      && Graph.state(&graph, 4) == UnitState.UpToDate
      && Graph.state(&graph, 5) == UnitState.UpToDate
      && Graph.state(&graph, 6) == UnitState.UpToDate,
    "one changed name invalidates its reader and transitive consumer only")
  run Graph.inputChanged(&mut graph, Dependee.DeclPrototype {declaration: 4})
  run Testing.expect(Graph.state(&graph, 3) == UnitState.Outdated
      && Graph.state(&graph, 2) == UnitState.UpToDate,
    "prototype and whole-declaration readers are distinct")
  run Graph.inputChanged(&mut graph, Dependee.DeclLocation {declaration: 4})
  run Testing.expect(Graph.state(&graph, 4) == UnitState.Outdated
      && Graph.state(&graph, 2) == UnitState.UpToDate,
    "location and whole-declaration readers are distinct")
  run Graph.sourceChanged(&mut graph, 2)
  run Testing.expect(Graph.state(&graph, 6) == UnitState.Outdated
      && Graph.state(&graph, 1) == UnitState.UpToDate,
    "conservative source changes do not mark a different property edge")
  let mut oneShot = Graph.make(false)
  run graphRecorded(&mut oneShot, 0, Dependee.Name {module: 2, name: 7})
  run Testing.expect(Graph.counters(&oneShot).dependees == 0
      && Graph.counters(&oneShot).bytes == 0,
    "one-shot recording allocates no property maps or edges")
  return ()
}

test effect fn dependencyPropertiesKeepIndependentDependersAndOneShotEmpty() -> ()
! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run distinctGraphProperties() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn repeatedGraphReadsRemainExact() -> ()
! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut graph = Graph.make(true)
  run Graph.startRun(&mut graph, 0)
  run Graph.record(&mut graph, 0, Dependee.Name {module: 2, name: 7})
  run Graph.record(&mut graph, 0, Dependee.Name {module: 2, name: 8})
  run Graph.record(&mut graph, 0, Dependee.DeclSource {declaration: 4})
  run Graph.record(&mut graph, 0, Dependee.DeclPrototype {declaration: 4})
  run Graph.record(&mut graph, 0, Dependee.DeclLocation {declaration: 4})
  run Graph.record(&mut graph, 0, Dependee.Namespace {module: 2})
  run Graph.record(&mut graph, 0, Dependee.Name {module: 2, name: 7})
  run Graph.record(&mut graph, 0, Dependee.DeclSource {declaration: 4})
  run Graph.finishRun(&mut graph, 0)
  run Testing.expect(Graph.counters(&graph).edges == 6
      && Graph.counters(&graph).edgesDeduplicated == 2,
    "repeated reads retain one edge per complete property key")
  run Graph.startRun(&mut graph, 1)
  run Graph.record(&mut graph, 1, Dependee.Name {module: 2, name: 7})
  run Graph.finishRun(&mut graph, 1)
  run Testing.expect(Graph.counters(&graph).edges == 7,
    "another unit records its own edge to a recently read property")
  run Graph.inputChanged(&mut graph, Dependee.Name {module: 2, name: 8})
  run Testing.expect(Graph.state(&graph, 0) == UnitState.Outdated,
    "the second name still invalidates its reader")

  run Graph.startRun(&mut graph, 0)
  run Graph.record(&mut graph, 0, Dependee.Name {module: 2, name: 7})
  run Graph.record(&mut graph, 0, Dependee.DeclPrototype {declaration: 4})
  run Graph.finishRun(&mut graph, 0)
  run Testing.expect(Graph.counters(&graph).edges == 3
      && Graph.counters(&graph).edgesRecorded == 9,
    "a new run replaces old edges even when the recent cache saw their keys")
  run Graph.inputChanged(&mut graph, Dependee.DeclSource {declaration: 4})
  run Testing.expect(Graph.state(&graph, 0) == UnitState.UpToDate,
    "a property dropped by the new run no longer invalidates its former reader")
  run Graph.inputChanged(&mut graph, Dependee.DeclPrototype {declaration: 4})
  run Testing.expect(Graph.state(&graph, 0) == UnitState.Outdated,
    "the new run's surviving prototype edge still invalidates its reader")

  let mut oneShot = Graph.make(false)
  run Graph.startRun(&mut oneShot, 0)
  run Graph.record(&mut oneShot, 0, Dependee.Name {module: 2, name: 7})
  run Graph.finishRun(&mut oneShot, 0)
  run Testing.expect(Graph.counters(&oneShot).bytes == 0,
    "one-shot graph never allocates the recent cache")
  return ()
}

test effect fn repeatedGraphPropertiesStayExactAcrossRuns() -> ()
! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run repeatedGraphReadsRemainExact() |> Effect.provideMut<Allocator>(&mut allocator)
}
