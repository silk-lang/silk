//! Authored inputs shared by direct calls and unary pipelines.

import hir.Hir {HirId, HirRef, Module, Node, Range}
import silk.option {Option}
import silk.usize

/// The expressions supplied to one invocation, in evaluation order.
pub union Arguments {
  /// The children of an ordinary call.
  Written {pub range: Range},
  /// The completed left expression of a pipeline.
  Single {pub expression: HirId},
}

impl Copy for Arguments {}

impl Arguments {
  /// Returns the number of supplied arguments.
  pub fn length(self: Self) -> usize {
    return match self {
      Arguments.Written {range} => range.length
      Arguments.Single {..} => usize.ONE
    }
  }
  /// Reads an argument from its owning module. `at` must be below `length`.
  pub fn child(self: Self, hir: &Module, at: usize) -> HirId {
    return match self {
      Arguments.Written {range} => Module.child(hir, range, at)
      Arguments.Single {expression} => expression
    }
  }
}

/// Target syntax and arguments of one authored invocation.
pub struct CallInput {
  /// The written callable target.
  pub callee: HirId
  /// Explicit call type arguments, absent for a pipeline.
  pub generics: HirRef
  /// Supplied value expressions in evaluation order.
  pub arguments: Arguments
  /// Whether deferred target forms need a gap at the complete pipe expression.
  pub pipeline: bool
}

impl Copy for CallInput {}

impl CallInput {
  /// Recognizes ordinary calls and pipelines without rewriting authored HIR.
  pub fn ofNode(node: Node) -> Option<CallInput> {
    return match node {
      Node.CallExpression {callee, generics, arguments} => Option.some<CallInput>(CallInput {
        callee: callee, generics: generics, arguments: Arguments.Written {range: arguments}, pipeline: false,
      })
      Node.PipelineExpression {input, target} => Option.some<CallInput>(CallInput {
        callee: target, generics: HirRef.absent(), arguments: Arguments.Single {expression: input}, pipeline: true,
      })
      _ => Option.none<CallInput>()
    }
  }
}
