//! A source-ordered choice among callable contract suppliers.
//!
//! # When to use
//! Collect eligible suppliers before checking operands or a contextual result. A second supplier
//! makes the choice ambiguous even when its signature would later reject the written arguments.

import silk.option {Option}
import silk.usize

/// The first two distinct suppliers of one callable spelling.
pub struct CallSelection {
  first: Option<usize>
  second: Option<usize>
}

impl CallSelection {
  /// Begins a choice with no eligible supplier.
  pub fn make() -> CallSelection {
    return CallSelection {first: Option.none<usize>(), second: Option.none<usize>()}
  }

  /// Records a supplier's ordinal without consulting its arguments or result.
  pub fn add(self: &mut Self, ordinal: usize) -> () {
    let firstMatches = match &self.first {
      Option<usize>.Some {value} => value == ordinal
      Option<usize>.None => false
    }
    if firstMatches {
      return ()
    }
    let firstMissing = match &self.first {
      Option<usize>.Some {..} => false
      Option<usize>.None => true
    }
    if firstMissing {
      self.first = Option.some<usize>(ordinal)
      return ()
    }
    let secondMissing = match &self.second {
      Option<usize>.Some {..} => false
      Option<usize>.None => true
    }
    if secondMissing {
      self.second = Option.some<usize>(ordinal)
    }
    return ()
  }

  /// Returns the sole supplier, if one exists and no second supplier was found.
  pub fn unique(self: &Self) -> Option<usize> {
    if let Option<usize>.Some {..} = &self.second {
      return Option.none<usize>()
    }
    return match &self.first {
      Option<usize>.Some {value} => Option.some<usize>(value)
      Option<usize>.None => Option.none<usize>()
    }
  }

  /// Whether two distinct suppliers claimed the same spelling.
  pub fn ambiguous(self: &Self) -> bool {
    return match &self.second {
      Option<usize>.Some {..} => true
      Option<usize>.None => false
    }
  }
}
