//! Canonical owner-chain identity for declarations in a source module.
//!
//! # When to use
//! Use [`DeclarationId`] across modules or revisions. A `HirId`, `Symbol`, or `OwnerKey` from
//! authored HIR is local to one parsed module and cannot identify another module's declaration.
//!
//! # Details
//! Each owner step stores its kind, exact name bytes or absence, and same-key occurrence. An
//! occurrence is not sufficient evidence for matching two revisions when same-key siblings exist.
//!
//! A compiler build holds millions of identity copies, so the owner chain is one exact-size byte
//! buffer rather than a vector with a name allocation per step. Each step is a code byte (kind
//! and whether it is named), its occurrence, and for a named step its name length and bytes, with
//! counts in LEB128. The encoding is canonical, so byte equality is chain equality, and a chain
//! is a prefix of another exactly when its bytes are.

import hir.Hir {Module, OwnerKey, OwnerKind}
import silk.allocator {Allocator, OutOfMemoryError}
import silk.bytes {Bytes}
import silk.effect {Effect}
import silk.hash {Hash}
import silk.result {Result}
import silk.option {Option}
import silk.shared {Shared}
import silk.slice {Slice}
import silk.u8
import silk.usize
import silk.vector {Vector}
import semantic.InternIndex {InternIndex}
import semantic.ModuleId {InvalidModulePath, ModuleId}

/// One local owner key converted to bytes independent of a HIR string table.
pub struct OwnerStep {
  /// The declaration category of this step.
  pub kind: OwnerKind
  /// The exact name bytes, absent for unnamed declarations.
  pub name: Option<Bytes>
  /// The position among siblings with this kind and name.
  pub occurrence: usize
}

/// A module identity and complete parent-to-child declaration owner chain.
pub struct DeclarationId {
  module: ModuleId
  owners: Bytes
  count: usize
}

// One decoded owner step: its name is the byte range `start..start + length` of the chain.
struct StepView {
  kind: OwnerKind
  named: bool
  occurrence: usize
  start: usize
  length: usize
  // The offset just past this step.
  next: usize
}

impl Copy for StepView {}

fn kindCode(kind: OwnerKind) -> u8 {
  return match kind {
    OwnerKind.Import => 0
    OwnerKind.Conditional => 1
    OwnerKind.ModuleProperty => 2
    OwnerKind.Implementation => 3
    OwnerKind.Function => 4
    OwnerKind.Struct => 5
    OwnerKind.Tuple => 6
    OwnerKind.Enumeration => 7
    OwnerKind.Union => 8
    OwnerKind.Service => 9
    OwnerKind.Interface => 10
    OwnerKind.Role => 11
    OwnerKind.Constant => 12
    OwnerKind.PackageParameter => 13
    OwnerKind.Alias => 14
    OwnerKind.Static => 15
    OwnerKind.Anonymous => 16
    OwnerKind.EffectBlock => 17
    OwnerKind.Damaged => 18
  }
}

fn kindOf(code: u8) -> OwnerKind {
  if code == 0 { return OwnerKind.Import }
  if code == 1 { return OwnerKind.Conditional }
  if code == 2 { return OwnerKind.ModuleProperty }
  if code == 3 { return OwnerKind.Implementation }
  if code == 4 { return OwnerKind.Function }
  if code == 5 { return OwnerKind.Struct }
  if code == 6 { return OwnerKind.Tuple }
  if code == 7 { return OwnerKind.Enumeration }
  if code == 8 { return OwnerKind.Union }
  if code == 9 { return OwnerKind.Service }
  if code == 10 { return OwnerKind.Interface }
  if code == 11 { return OwnerKind.Role }
  if code == 12 { return OwnerKind.Constant }
  if code == 13 { return OwnerKind.PackageParameter }
  if code == 14 { return OwnerKind.Alias }
  if code == 15 { return OwnerKind.Static }
  if code == 16 { return OwnerKind.Anonymous }
  if code == 17 { return OwnerKind.EffectBlock }
  return OwnerKind.Damaged
}

fn countSize(value: usize) -> usize {
  let mut size = usize.ONE
  let mut rest = value / 128
  while rest != usize.ZERO {
    size = size + usize.ONE
    rest = rest / 128
  }
  return size
}

// Writes `value` in LEB128 at `at` and returns the offset after it.
fn writeCount(output: &mut Bytes, at: usize, value: usize) -> usize {
  let target = Bytes.asMutSlice(&mut output.*)
  let mut offset = at
  let mut rest = value
  while rest >= 128 {
    target[offset] = usize.toU8(rest % 128 + 128)
    rest = rest / 128
    offset = offset + usize.ONE
  }
  target[offset] = usize.toU8(rest)
  return offset + usize.ONE
}

fn stepSize(named: bool, name: &[u8], occurrence: usize) -> usize {
  let mut size = usize.ONE + countSize(occurrence)
  if named {
    size = size + countSize(name.length) + name.length
  }
  return size
}

// Writes one step at `at` and returns the offset after it.
fn writeStep(output: &mut Bytes, at: usize, kind: OwnerKind, named: bool, name: &[u8], occurrence: usize) -> usize {
  let mut code: u8 = kindCode(kind) * 2
  if named {
    code = code + 1
  }
  if true {
    let head = Bytes.asMutSlice(&mut output.*)
    head[at] = code
  }
  let mut offset = writeCount(&mut output.*, at + usize.ONE, occurrence)
  if named {
    offset = writeCount(&mut output.*, offset, name.length)
    let target = Bytes.asMutSlice(&mut output.*)
    let mut index = usize.ZERO
    while index < name.length {
      target[offset + index] = name[index]
      index = index + usize.ONE
    }
    offset = offset + name.length
  }
  return offset
}

fn readStep(bytes: &[u8], at: usize) -> StepView {
  let code = bytes[at]
  let mut offset = at + usize.ONE
  let mut occurrence = usize.ZERO
  let mut scale = usize.ONE
  while bytes[offset] >= 128 {
    occurrence = occurrence + u8.toUsize(bytes[offset] - 128) * scale
    scale = scale * 128
    offset = offset + usize.ONE
  }
  occurrence = occurrence + u8.toUsize(bytes[offset]) * scale
  offset = offset + usize.ONE
  let named = code % 2 == 1
  let mut length = usize.ZERO
  if named {
    scale = usize.ONE
    while bytes[offset] >= 128 {
      length = length + u8.toUsize(bytes[offset] - 128) * scale
      scale = scale * 128
      offset = offset + usize.ONE
    }
    length = length + u8.toUsize(bytes[offset]) * scale
    offset = offset + usize.ONE
  }
  return StepView {kind: kindOf(code / 2), named: named, occurrence: occurrence, start: offset, length: length,
    next: offset + length}
}

// The step at index `owner`, decoded from the start of the chain.
fn stepAt(identity: &DeclarationId, owner: usize) -> StepView {
  let bytes = Bytes.asSlice(&identity.owners)
  let mut view = readStep(bytes, usize.ZERO)
  let mut index = usize.ZERO
  while index < owner {
    view = readStep(bytes, view.next)
    index = index + usize.ONE
  }
  return view
}

fn stepName(identity: &DeclarationId, view: StepView) -> &[u8] {
  return Slice.view<u8>(Bytes.asSlice(&identity.owners), view.start, view.length)
}

fn isNamed(name: &Option<Bytes>) -> bool {
  return match & name.* {
    Option<Bytes>.Some {..} => true
    Option<Bytes>.None => false
  }
}

fn nameBytes(name: &Option<Bytes>) -> &[u8] {
  return match & name.* {
    Option<Bytes>.Some {value} => Bytes.asSlice(&value)
    Option<Bytes>.None => b""
  }
}

effect fn encodeSteps(steps: &[OwnerStep]) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut size = usize.ZERO
  let mut index = usize.ZERO
  while index < steps.length {
    size = size + stepSize(isNamed(&steps[index].name), nameBytes(&steps[index].name), steps[index].occurrence)
    index = index + usize.ONE
  }
  let mut bytes = run Bytes.zeroed(size)
  let mut offset = usize.ZERO
  index = usize.ZERO
  while index < steps.length {
    offset = writeStep(&mut bytes, offset, steps[index].kind, isNamed(&steps[index].name), nameBytes(&steps[index].name),
      steps[index].occurrence)
    index = index + usize.ONE
  }
  return move bytes
}

// The chain of `parent` followed by one more step.
effect fn extended(parent: &Bytes, kind: OwnerKind, named: bool, name: &[u8], occurrence: usize) -> Bytes
! OutOfMemoryError
? &mut Allocator {
  let prefix = Bytes.asSlice(&parent.*)
  let mut bytes = run Bytes.zeroed(prefix.length + stepSize(named, name, occurrence))
  let target = Bytes.asMutSlice(&mut bytes)
  let mut index = usize.ZERO
  while index < prefix.length {
    target[index] = prefix[index]
    index = index + usize.ONE
  }
  let end = writeStep(&mut bytes, prefix.length, kind, named, name, occurrence)
  return move bytes
}

fn sameBytes(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut index = usize.ZERO
  while index < left.length {
    if left[index] != right[index] {
      return false
    }
    index = index + usize.ONE
  }
  return true
}

fn foldName(hashed: u64, identity: &DeclarationId, view: StepView) -> u64 {
  if view.named {
    return InternIndex.hashBytes(Hash.combine(hashed, 1), stepName(identity, view))
  }
  return Hash.combine(hashed, 0)
}

// Folds the module, the count of leading owner steps read, their names, and their occurrences,
// except possibly the last one, which same-key siblings do not share.
fn chainHash(identity: &DeclarationId, count: usize, lastOccurrence: bool) -> u64 {
  let bytes = Bytes.asSlice(&identity.owners)
  let mut hashed = Hash.combine(ModuleId.hash(&identity.module), usize.toU64(count))
  let mut offset = usize.ZERO
  let mut index = usize.ZERO
  while index < count {
    let view = readStep(bytes, offset)
    if lastOccurrence || index + usize.ONE < count {
      hashed = Hash.combine(hashed, usize.toU64(view.occurrence))
    }
    hashed = foldName(hashed, identity, view)
    offset = view.next
    index = index + usize.ONE
  }
  return hashed
}

// The chain of `parent` followed by one authored owner key, with its name copied from `module`.
effect fn ownedChain(parent: &Bytes, module: &Module, owner: OwnerKey) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  if owner.name.present {
    return run extended(&parent.*, owner.kind, true, Module.text(module, owner.name.symbol), owner.occurrence)
  }
  return run extended(&parent.*, owner.kind, false, b"", owner.occurrence)
}

/// The field selected by a short declaration-content read.
pub enum Part {
  Origin,
  Package,
  Path,
  Owners,
}

/// Owned scalar fields of a selected module component or owner step.
pub struct Projection {
  pub length: usize
  pub byte: u8
  pub kind: OwnerKind
  pub occurrence: usize
  pub named: bool
}

impl Copy for Projection {}

fn projectedBytes(bytes: &[u8], offset: usize) -> Projection {
  let mut byte: u8 = 0
  if offset < bytes.length {
    byte = bytes[offset]
  }
  return Projection {
    length: bytes.length,
    byte: byte,
    kind: OwnerKind.Damaged,
    occurrence: usize.ZERO,
    named: false,
  }
}

fn sharedProjection(
  source: &Shared<DeclarationId>,
  part: Part,
  owner: usize,
  offset: usize,
) -> Option<Projection> {
  return Shared.with<DeclarationId, Option<Projection>>(
    source,
    fn(value: &DeclarationId) -> Option<Projection> {
      return readProjection(value, part, owner, offset)
    },
  )
}

// Copies the `count` bytes of one selected module component or owner name using scalar reads.
effect fn copyProjectedBytes(source: &Shared<DeclarationId>, part: Part, owner: usize, count: usize) -> Bytes
! OutOfMemoryError
? &mut Allocator {
  let mut bytes = run Bytes.zeroed(count)
  let target = Bytes.asMutSlice(&mut bytes)
  let mut offset = usize.ZERO
  while offset < count {
    let selected = sharedProjection(source, part, owner, offset)
    match move selected {
      Option<Projection>.Some {value: field} => {
        target[offset] = field.byte
      }
      Option<Projection>.None => {
        return absurd<Bytes>()
      }
    }
    offset = offset + usize.ONE
  }
  return move bytes
}

impl DeclarationId {
  /// Reads scalar content fields without returning a reference to a shared declaration.
  pub fn project(self: &Self, section: Part, owner: usize, offset: usize) -> Projection {
    if section == Part.Origin {
      return projectedBytes(ModuleId.sourceOrigin(&self.module), offset)
    }
    if section == Part.Package {
      return projectedBytes(ModuleId.packageIdentity(&self.module), offset)
    }
    if section == Part.Path {
      return projectedBytes(ModuleId.logicalPath(&self.module), offset)
    }
    if owner >= self.count {
      return Projection {
        length: self.count,
        byte: 0,
        kind: OwnerKind.Damaged,
        occurrence: usize.ZERO,
        named: false,
      }
    }
    let step = stepAt(self, owner)
    let mut projected = Projection {
      length: usize.ZERO,
      byte: 0,
      kind: step.kind,
      occurrence: step.occurrence,
      named: false,
    }
    if step.named {
      let bytes = stepName(self, step)
      projected.length = bytes.length
      projected.named = true
      if offset < bytes.length {
        projected.byte = bytes[offset]
      }
    }
    return projected
  }
  /// Reassembles exact parts copied from an existing canonical declaration.
  pub effect fn fromParts(module: ModuleId, owners: Vector<OwnerStep>) -> DeclarationId
  ! OutOfMemoryError
  ? &mut Allocator {
    let steps = Vector.asSlice<OwnerStep>(&owners)
    return DeclarationId {module: move module, owners: run encodeSteps(steps), count: steps.length}
  }
  /// Copies a shared declaration using scalar reads; allocator effects run outside its borrow.
  pub effect fn copyShared(source: &Shared<DeclarationId>) -> DeclarationId
  ! OutOfMemoryError
  ? &mut Allocator {
    let mut components = Vector.make<Bytes>()
    let mut section = usize.ZERO
    while section < 3 {
      let mut part = Part.Path
      if section == usize.ZERO {
        part = Part.Origin
      }
      if section == usize.ONE {
        part = Part.Package
      }
      let measured = sharedProjection(source, part, usize.MAX, usize.MAX)
      let count = match move measured {
        Option<Projection>.Some {value: field} => field.length
        Option<Projection>.None => {
          return absurd<DeclarationId>()
        }
      }
      let bytes = run copyProjectedBytes(source, part, usize.MAX, count)
      run Vector.append<Bytes>(&mut components, move bytes)
      section = section + usize.ONE
    }
    let measured = sharedProjection(source, Part.Owners, usize.MAX, usize.MAX)
    let count = match move measured {
      Option<Projection>.Some {value: field} => field.length
      Option<Projection>.None => {
        return absurd<DeclarationId>()
      }
    }
    let mut owners = Vector.make<OwnerStep>()
    let mut at = usize.ZERO
    while at < count {
      let selected = sharedProjection(source, Part.Owners, at, usize.MAX)
      let step = match move selected {
        Option<Projection>.Some {value: field} => field
        Option<Projection>.None => {
          return absurd<DeclarationId>()
        }
      }
      let mut name = Option.none<Bytes>()
      if step.named {
        let bytes = run copyProjectedBytes(source, Part.Owners, at, step.length)
        name = Option.some<Bytes>(move bytes)
      }
      run Vector.append<OwnerStep>(
        &mut owners,
        OwnerStep {kind: step.kind, occurrence: step.occurrence, name: move name},
      )
      at = at + usize.ONE
    }
    let path = match move Vector.pop<Bytes>(&mut components) {
      Option<Bytes>.Some {value} => move value
      Option<Bytes>.None => {
        return absurd<DeclarationId>()
      }
    }
    let package = match move Vector.pop<Bytes>(&mut components) {
      Option<Bytes>.Some {value} => move value
      Option<Bytes>.None => {
        return absurd<DeclarationId>()
      }
    }
    let origin = match move Vector.pop<Bytes>(&mut components) {
      Option<Bytes>.Some {value} => move value
      Option<Bytes>.None => {
        return absurd<DeclarationId>()
      }
    }
    let assembled = run Effect.result(ModuleId.fromParts(move origin, move package, move path))
    let module = match move assembled {
      Result<ModuleId, InvalidModulePath>.Success {value} => move value
      Result<ModuleId, InvalidModulePath>.Failure {error: _} => { return absurd<DeclarationId>() }
    }
    return run DeclarationId.fromParts(move module, move owners)
  }
  /// Borrows the canonical module identity that owns this declaration.
  pub fn moduleId(self: &Self) -> &ModuleId {
    return &self.module
  }
  /// Reports the declaration category of the identified declaration itself.
  pub fn kind(self: &Self) -> OwnerKind {
    if self.count == usize.ZERO {
      return OwnerKind.Damaged
    }
    return stepAt(self, self.count - usize.ONE).kind
  }
  /// Borrows the identified declaration's own name, empty for an unnamed declaration.
  pub fn spelling(self: &Self) -> &[u8] {
    if self.count == usize.ZERO {
      return b""
    }
    return stepName(self, stepAt(self, self.count - usize.ONE))
  }
  /// Reports the number of steps in the complete canonical owner chain.
  pub fn ownerCount(self: &Self) -> usize {
    return self.count
  }
  /// Reports the declaration category of owner step `owner`, parent first.
  ///
  /// # Gotchas
  ///
  /// `owner` must be less than [`ownerCount`].
  pub fn ownerKind(self: &Self, owner: usize) -> OwnerKind {
    return stepAt(self, owner).kind
  }
  /// Reports the same-key occurrence of owner step `owner`.
  pub fn ownerOccurrence(self: &Self, owner: usize) -> usize {
    return stepAt(self, owner).occurrence
  }
  /// Reports whether owner step `owner` is named.
  pub fn ownerNamed(self: &Self, owner: usize) -> bool {
    return stepAt(self, owner).named
  }
  /// Borrows the name of owner step `owner`, empty when it is unnamed.
  pub fn ownerName(self: &Self, owner: usize) -> &[u8] {
    return stepName(self, stepAt(self, owner))
  }
  /// Copies owner step `owner` into an owned step value.
  pub effect fn ownerStep(self: &Self, owner: usize) -> OwnerStep ! OutOfMemoryError ? &mut Allocator {
    let view = stepAt(self, owner)
    let mut name = Option.none<Bytes>()
    if view.named {
      name = Option.some<Bytes>(run Bytes.copy(stepName(self, view)))
    }
    return OwnerStep {kind: view.kind, name: move name, occurrence: view.occurrence}
  }
  /// Reports whether the identified declaration itself is named exactly `name`.
  pub fn named(self: &Self, name: &[u8]) -> bool {
    if self.count == usize.ZERO {
      return false
    }
    let view = stepAt(self, self.count - usize.ONE)
    return view.named && sameBytes(stepName(self, view), name)
  }
  /// Creates a canonical identity for a top-level authored declaration.
  pub effect fn root(id: &ModuleId, module: &Module, owner: OwnerKey) -> DeclarationId
  ! OutOfMemoryError
  ? &mut Allocator {
    let empty = Bytes.make()
    let owners = run ownedChain(&empty, module, owner)
    return DeclarationId {module: run ModuleId.copy(id), owners: move owners, count: usize.ONE}
  }
  /// Creates a canonical identity for a declaration inside `self`.
  pub effect fn child(self: &Self, module: &Module, owner: OwnerKey) -> DeclarationId
  ! OutOfMemoryError
  ? &mut Allocator {
    let owners = run ownedChain(&self.owners, module, owner)
    return DeclarationId {module: run ModuleId.copy(&self.module), owners: move owners, count: self.count + usize.ONE}
  }
  /// Copies one canonical identity without retaining a HIR-local symbol.
  pub effect fn copy(self: &Self) -> DeclarationId ! OutOfMemoryError ? &mut Allocator {
    return DeclarationId {module: run ModuleId.copy(&self.module), owners: run Bytes.copy(Bytes.asSlice(&self.owners)),
      count: self.count}
  }
  /// Creates a temporary binder owner for one call's inference transaction.
  ///
  /// `scope` starts with a NUL marker and contains exact caller/module/site bytes plus a serial
  /// unique within its resolver. A named damaged child cannot name a checked authored declaration.
  /// This identity is confined to local inference and never published, interned or cached.
  pub effect fn inference(self: &Self, scope: &[u8]) -> DeclarationId
  ! OutOfMemoryError
  ? &mut Allocator {
    let owners = run extended(&self.owners, OwnerKind.Damaged, true, scope, usize.ZERO)
    return DeclarationId {module: run ModuleId.copy(&self.module), owners: move owners, count: self.count + usize.ONE}
  }
  /// Reports whether two values have the same module and complete owner chain.
  pub fn equals(self: &Self, other: &DeclarationId) -> bool {
    return self.count == other.count && sameBytes(Bytes.asSlice(&self.owners), Bytes.asSlice(&other.owners))
      && ModuleId.equals(&self.module, &other.module)
  }
  /// Returns a hash that two identities share whenever [`equals`] reports them equal.
  ///
  /// # Details
  ///
  /// The hash reads the module and every owner step's name and occurrence.
  pub fn hash(self: &Self) -> u64 {
    return chainHash(self, self.count, true)
  }
  /// Returns [`hash`] of the identity made of this module and the first `count` owner steps, so
  /// a declaration whose identity is that prefix can be found without building it.
  ///
  /// # Gotchas
  ///
  /// `count` must not exceed the number of owner steps.
  pub fn prefixHash(self: &Self, count: usize) -> u64 {
    return chainHash(self, count, true)
  }
  /// Returns a hash that two identities share whenever [`sameSiblingKey`] reports them equal.
  ///
  /// # Details
  ///
  /// The hash reads the module, every owner step's name, and every occurrence but the last.
  pub fn siblingHash(self: &Self) -> u64 {
    return chainHash(self, self.count, false)
  }
  /// Reports whether this exact owner chain is a prefix of another identity, including equality.
  ///
  /// # Details
  ///
  /// A duplicate owner makes every declaration below it ambiguous across revisions, even when
  /// the nested declaration itself has a unique local name.
  pub fn isPrefixOf(self: &Self, other: &DeclarationId) -> bool {
    let prefix = Bytes.asSlice(&self.owners)
    let full = Bytes.asSlice(&other.owners)
    if self.count > other.count || prefix.length > full.length {
      return false
    }
    return sameBytes(prefix, Slice.view<u8>(full, usize.ZERO, prefix.length)) && ModuleId.equals(&self.module, &other.module)
  }
  /// Reports whether two declarations are same-key siblings, regardless of occurrence.
  ///
  /// # Details
  ///
  /// Matching either sibling across a revision change is ambiguous when this returns `true`.
  pub fn sameSiblingKey(self: &Self, other: &DeclarationId) -> bool {
    if !ModuleId.equals(&self.module, &other.module) {
      return false
    }
    if self.count == usize.ZERO || self.count != other.count {
      return false
    }
    let leftBytes = Bytes.asSlice(&self.owners)
    let rightBytes = Bytes.asSlice(&other.owners)
    let mut leftOffset = usize.ZERO
    let mut rightOffset = usize.ZERO
    let mut index = usize.ZERO
    while index < self.count {
      let left = readStep(leftBytes, leftOffset)
      let right = readStep(rightBytes, rightOffset)
      if left.kind != right.kind || left.named != right.named || !sameBytes(stepName(self, left), stepName(other, right)) {
        return false
      }
      if index + usize.ONE < self.count && left.occurrence != right.occurrence {
        return false
      }
      leftOffset = left.next
      rightOffset = right.next
      index = index + usize.ONE
    }
    return true
  }
}

fn readProjection(value: &DeclarationId, part: Part, owner: usize, offset: usize) -> Option<
  Projection,
> {
  return Option.some<Projection>(DeclarationId.project(value, part, owner, offset))
}

// An inconsistent projection is an implementation defect, never a different declaration.
fn absurd<T>() -> T {
  let boom = 1 / 0
  return absurd<T>()
}
