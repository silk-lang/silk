//! Canonical owner-chain identity for declarations in a source module.
//!
//! # When to use
//! Use [`DeclarationId`] across modules or revisions. A `HirId`, `Symbol`, or `OwnerKey` from
//! authored HIR is local to one parsed module and cannot identify another module's declaration.
//!
//! # Details
//! Each owner step stores its kind, exact name bytes or absence, and same-key occurrence. An
//! occurrence is not sufficient evidence for matching two revisions when same-key siblings exist.

import hir.Hir {Module, OwnerKey, OwnerKind}
import silk.allocator {Allocator, OutOfMemoryError}
import silk.bytes {Bytes}
import silk.effect {Effect}
import silk.hash {Hash}
import silk.result {Result}
import silk.option {Option}
import silk.shared {Shared}
import silk.u8
import silk.usize
import silk.vector {Vector}
import semantic.ModuleId {InvalidModulePath, ModuleId}

/// One local owner key converted to bytes independent of a HIR string table.
pub struct OwnerStep {
  /// The declaration category of this step.
  pub kind: OwnerKind
  /// The exact name bytes, absent for unnamed declarations.
  pub name: Option<Bytes>
  /// The position among siblings with this kind and name.
  pub occurrence: usize
}

/// A module identity and complete parent-to-child declaration owner chain.
pub struct DeclarationId {
  module: ModuleId
  owners: Vector<OwnerStep>
}

fn sameBytes(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut index = usize.ZERO
  while index < left.length {
    if left[index] != right[index] {
      return false
    }
    index = index + usize.ONE
  }
  return true
}

fn sameName(left: &Option<Bytes>, right: &Option<Bytes>) -> bool {
  return match & left.* {
    Option<Bytes>.Some {value: leftBytes} => match & right.* {
      Option<Bytes>.Some {value: rightBytes} => sameBytes(
        Bytes.asSlice(&leftBytes),
        Bytes.asSlice(&rightBytes),
      )
      Option<Bytes>.None => false
    }
    Option<Bytes>.None => match & right.* {
      Option<Bytes>.Some {value: _} => false
      Option<Bytes>.None => true
    }
  }
}

// Folds one name's length and bytes, so adjacent owner names cannot exchange bytes unnoticed.
fn foldBytes(hashed: u64, bytes: &[u8]) -> u64 {
  let mut folded = Hash.combine(hashed, usize.toU64(bytes.length))
  let mut index = usize.ZERO
  while index < bytes.length {
    folded = Hash.combine(folded, u8.toU64(bytes[index]))
    index = index + usize.ONE
  }
  return folded
}

fn foldName(hashed: u64, name: &Option<Bytes>) -> u64 {
  return match & name.* {
    Option<Bytes>.Some {value} => foldBytes(Hash.combine(hashed, 1), Bytes.asSlice(&value))
    Option<Bytes>.None => Hash.combine(hashed, 0)
  }
}

effect fn copyStep(step: &OwnerStep) -> OwnerStep ! OutOfMemoryError ? &mut Allocator {
  let name = match & step.name {
    Option<Bytes>.Some {value} => Option.some<Bytes>(run Bytes.copy(Bytes.asSlice(&value)))
    Option<Bytes>.None => Option.none<Bytes>()
  }
  return OwnerStep {kind: step.kind, name: move name, occurrence: step.occurrence}
}

effect fn fromOwner(module: &Module, owner: OwnerKey) -> OwnerStep
! OutOfMemoryError
? &mut Allocator {
  let mut name = Option.none<Bytes>()
  if owner.name.present {
    name = Option.some<Bytes>(run Bytes.copy(Module.text(module, owner.name.symbol)))
  }
  return OwnerStep {kind: owner.kind, name: move name, occurrence: owner.occurrence}
}

/// The field selected by a short declaration-content read.
pub enum Part {
  Origin,
  Package,
  Path,
  Owners,
}

/// Owned scalar fields of a selected module component or owner step.
pub struct Projection {
  pub length: usize
  pub byte: u8
  pub kind: OwnerKind
  pub occurrence: usize
  pub named: bool
}

impl Copy for Projection {}

fn projectedBytes(bytes: &[u8], offset: usize) -> Projection {
  let mut byte: u8 = 0
  if offset < bytes.length {
    byte = bytes[offset]
  }
  return Projection {
    length: bytes.length,
    byte: byte,
    kind: OwnerKind.Damaged,
    occurrence: usize.ZERO,
    named: false,
  }
}

fn sharedProjection(
  source: &Shared<DeclarationId>,
  part: Part,
  owner: usize,
  offset: usize,
) -> Option<Projection> {
  return Shared.with<DeclarationId, Option<Projection>>(
    source,
    fn(value: &DeclarationId) -> Option<Projection> {
      return readProjection(value, part, owner, offset)
    },
  )
}

// Copies the `count` bytes of one selected module component or owner name using scalar reads.
effect fn copyProjectedBytes(source: &Shared<DeclarationId>, part: Part, owner: usize, count: usize) -> Bytes
! OutOfMemoryError
? &mut Allocator {
  let mut bytes = run Bytes.zeroed(count)
  let target = Bytes.asMutSlice(&mut bytes)
  let mut offset = usize.ZERO
  while offset < count {
    let selected = sharedProjection(source, part, owner, offset)
    match move selected {
      Option<Projection>.Some {value: field} => {
        target[offset] = field.byte
      }
      Option<Projection>.None => {
        return absurd<Bytes>()
      }
    }
    offset = offset + usize.ONE
  }
  return move bytes
}

impl DeclarationId {
  /// Reads scalar content fields without returning a reference to a shared declaration.
  pub fn project(self: &Self, section: Part, owner: usize, offset: usize) -> Projection {
    if section == Part.Origin {
      return projectedBytes(ModuleId.sourceOrigin(&self.module), offset)
    }
    if section == Part.Package {
      return projectedBytes(ModuleId.packageIdentity(&self.module), offset)
    }
    if section == Part.Path {
      return projectedBytes(ModuleId.logicalPath(&self.module), offset)
    }
    let owners = Vector.asSlice<OwnerStep>(&self.owners)
    if owner >= owners.length {
      return Projection {
        length: owners.length,
        byte: 0,
        kind: OwnerKind.Damaged,
        occurrence: usize.ZERO,
        named: false,
      }
    }
    let step = &owners[owner]
    let mut projected = Projection {
      length: usize.ZERO,
      byte: 0,
      kind: step.kind,
      occurrence: step.occurrence,
      named: false,
    }
    if let Option<Bytes>.Some {value: name} = &step.name {
      let bytes = Bytes.asSlice(&name)
      projected.length = bytes.length
      projected.named = true
      if offset < bytes.length {
        projected.byte = bytes[offset]
      }
    }
    return projected
  }
  /// Reassembles exact parts copied from an existing canonical declaration.
  pub fn fromParts(module: ModuleId, owners: Vector<OwnerStep>) -> DeclarationId {
    return DeclarationId {module: move module, owners: move owners}
  }
  /// Copies a shared declaration using scalar reads; allocator effects run outside its borrow.
  pub effect fn copyShared(source: &Shared<DeclarationId>) -> DeclarationId
  ! OutOfMemoryError
  ? &mut Allocator {
    let mut components = Vector.make<Bytes>()
    let mut section = usize.ZERO
    while section < 3 {
      let mut part = Part.Path
      if section == usize.ZERO {
        part = Part.Origin
      }
      if section == usize.ONE {
        part = Part.Package
      }
      let measured = sharedProjection(source, part, usize.MAX, usize.MAX)
      let count = match move measured {
        Option<Projection>.Some {value: field} => field.length
        Option<Projection>.None => {
          return absurd<DeclarationId>()
        }
      }
      let bytes = run copyProjectedBytes(source, part, usize.MAX, count)
      run Vector.append<Bytes>(&mut components, move bytes)
      section = section + usize.ONE
    }
    let measured = sharedProjection(source, Part.Owners, usize.MAX, usize.MAX)
    let count = match move measured {
      Option<Projection>.Some {value: field} => field.length
      Option<Projection>.None => {
        return absurd<DeclarationId>()
      }
    }
    let mut owners = Vector.make<OwnerStep>()
    let mut at = usize.ZERO
    while at < count {
      let selected = sharedProjection(source, Part.Owners, at, usize.MAX)
      let step = match move selected {
        Option<Projection>.Some {value: field} => field
        Option<Projection>.None => {
          return absurd<DeclarationId>()
        }
      }
      let mut name = Option.none<Bytes>()
      if step.named {
        let bytes = run copyProjectedBytes(source, Part.Owners, at, step.length)
        name = Option.some<Bytes>(move bytes)
      }
      run Vector.append<OwnerStep>(
        &mut owners,
        OwnerStep {kind: step.kind, occurrence: step.occurrence, name: move name},
      )
      at = at + usize.ONE
    }
    let path = match move Vector.pop<Bytes>(&mut components) {
      Option<Bytes>.Some {value} => move value
      Option<Bytes>.None => {
        return absurd<DeclarationId>()
      }
    }
    let package = match move Vector.pop<Bytes>(&mut components) {
      Option<Bytes>.Some {value} => move value
      Option<Bytes>.None => {
        return absurd<DeclarationId>()
      }
    }
    let origin = match move Vector.pop<Bytes>(&mut components) {
      Option<Bytes>.Some {value} => move value
      Option<Bytes>.None => {
        return absurd<DeclarationId>()
      }
    }
    let assembled = run Effect.result(ModuleId.fromParts(move origin, move package, move path))
    let module = match move assembled {
      Result<ModuleId, InvalidModulePath>.Success {value} => move value
      Result<ModuleId, InvalidModulePath>.Failure {error: _} => { return absurd<DeclarationId>() }
    }
    return DeclarationId.fromParts(move module, move owners)
  }
  /// Borrows the canonical module identity that owns this declaration.
  pub fn moduleId(self: &Self) -> &ModuleId {
    return &self.module
  }
  /// Reports the declaration category of the identified declaration itself.
  pub fn kind(self: &Self) -> OwnerKind {
    let owners = Vector.asSlice<OwnerStep>(&self.owners)
    if owners.length == usize.ZERO {
      return OwnerKind.Damaged
    }
    return owners[owners.length - usize.ONE].kind
  }
  /// Borrows the identified declaration's own name, empty for an unnamed declaration.
  pub fn spelling(self: &Self) -> &[u8] {
    let owners = Vector.asSlice<OwnerStep>(&self.owners)
    if owners.length == usize.ZERO {
      return b""
    }
    return match & owners[owners.length - usize.ONE].name {
      Option<Bytes>.Some {value} => Bytes.asSlice(&value)
      Option<Bytes>.None => b""
    }
  }
  /// Borrows the complete canonical owner chain for stable backend names.
  pub fn ownerSteps(self: &Self) -> &[OwnerStep] {
    return Vector.asSlice<OwnerStep>(&self.owners)
  }
  /// Reports whether the identified declaration itself is named exactly `name`.
  pub fn named(self: &Self, name: &[u8]) -> bool {
    let owners = Vector.asSlice<OwnerStep>(&self.owners)
    if owners.length == usize.ZERO {
      return false
    }
    return match & owners[owners.length - usize.ONE].name {
      Option<Bytes>.Some {value} => sameBytes(Bytes.asSlice(&value), name)
      Option<Bytes>.None => false
    }
  }
  /// Creates a canonical identity for a top-level authored declaration.
  pub effect fn root(id: &ModuleId, module: &Module, owner: OwnerKey) -> DeclarationId
  ! OutOfMemoryError
  ? &mut Allocator {
    let mut owners = Vector.make<OwnerStep>()
    run Vector.append<OwnerStep>(&mut owners, run fromOwner(module, owner))
    return DeclarationId {module: run ModuleId.copy(id), owners: move owners}
  }
  /// Creates a canonical identity for a declaration inside `self`.
  pub effect fn child(self: &Self, module: &Module, owner: OwnerKey) -> DeclarationId
  ! OutOfMemoryError
  ? &mut Allocator {
    let mut owners = Vector.make<OwnerStep>()
    let parent = Vector.asSlice<OwnerStep>(&self.owners)
    let mut index = usize.ZERO
    while index < parent.length {
      run Vector.append<OwnerStep>(&mut owners, run copyStep(&parent[index]))
      index = index + usize.ONE
    }
    run Vector.append<OwnerStep>(&mut owners, run fromOwner(module, owner))
    return DeclarationId {module: run ModuleId.copy(&self.module), owners: move owners}
  }
  /// Copies one canonical identity without retaining a HIR-local symbol.
  pub effect fn copy(self: &Self) -> DeclarationId ! OutOfMemoryError ? &mut Allocator {
    let mut owners = Vector.make<OwnerStep>()
    let source = Vector.asSlice<OwnerStep>(&self.owners)
    let mut index = usize.ZERO
    while index < source.length {
      run Vector.append<OwnerStep>(&mut owners, run copyStep(&source[index]))
      index = index + usize.ONE
    }
    return DeclarationId {module: run ModuleId.copy(&self.module), owners: move owners}
  }
  /// Creates a temporary binder owner for one call's inference transaction.
  ///
  /// `scope` starts with a NUL marker and contains exact caller/module/site bytes plus a serial
  /// unique within its resolver. A named damaged child cannot name a checked authored declaration.
  /// This identity is confined to local inference and never published, interned or cached.
  pub effect fn inference(self: &Self, scope: &[u8]) -> DeclarationId
  ! OutOfMemoryError
  ? &mut Allocator {
    let mut owners = Vector.make<OwnerStep>()
    let source = Vector.asSlice<OwnerStep>(&self.owners)
    let mut at = usize.ZERO
    while at < source.length {
      run Vector.append<OwnerStep>(&mut owners, run copyStep(&source[at]))
      at = at + usize.ONE
    }
    run Vector.append<OwnerStep>(&mut owners, OwnerStep {
      kind: OwnerKind.Damaged, name: Option.some<Bytes>(run Bytes.copy(scope)), occurrence: usize.ZERO,
    })
    return DeclarationId {module: run ModuleId.copy(&self.module), owners: move owners}
  }
  /// Reports whether two values have the same module and complete owner chain.
  pub fn equals(self: &Self, other: &DeclarationId) -> bool {
    if !ModuleId.equals(&self.module, &other.module) {
      return false
    }
    let left = Vector.asSlice<OwnerStep>(&self.owners)
    let right = Vector.asSlice<OwnerStep>(&other.owners)
    if left.length != right.length {
      return false
    }
    let mut index = usize.ZERO
    while index < left.length {
      if left[index].kind != right[index].kind || left[index].occurrence != right[index].occurrence || !sameName(
        &left[index].name,
        &right[index].name,
      ) {
        return false
      }
      index = index + usize.ONE
    }
    return true
  }
  /// Returns a hash that two identities share whenever [`equals`] reports them equal.
  ///
  /// # Details
  ///
  /// The hash reads the module and every owner step's name and occurrence.
  pub fn hash(self: &Self) -> u64 {
    let steps = Vector.asSlice<OwnerStep>(&self.owners)
    let mut hashed = Hash.combine(ModuleId.hash(&self.module), usize.toU64(steps.length))
    let mut index = usize.ZERO
    while index < steps.length {
      hashed = foldName(Hash.combine(hashed, usize.toU64(steps[index].occurrence)), &steps[index].name)
      index = index + usize.ONE
    }
    return hashed
  }
  /// Reports whether this exact owner chain is a prefix of another identity, including equality.
  ///
  /// # Details
  ///
  /// A duplicate owner makes every declaration below it ambiguous across revisions, even when
  /// the nested declaration itself has a unique local name.
  pub fn isPrefixOf(self: &Self, other: &DeclarationId) -> bool {
    if !ModuleId.equals(&self.module, &other.module) {
      return false
    }
    let prefix = Vector.asSlice<OwnerStep>(&self.owners)
    let full = Vector.asSlice<OwnerStep>(&other.owners)
    if prefix.length > full.length {
      return false
    }
    let mut index = usize.ZERO
    while index < prefix.length {
      if prefix[index].kind != full[index].kind || prefix[index].occurrence != full[index].occurrence || !sameName(
        &prefix[index].name,
        &full[index].name,
      ) {
        return false
      }
      index = index + usize.ONE
    }
    return true
  }
  /// Reports whether two declarations are same-key siblings, regardless of occurrence.
  ///
  /// # Details
  ///
  /// Matching either sibling across a revision change is ambiguous when this returns `true`.
  pub fn sameSiblingKey(self: &Self, other: &DeclarationId) -> bool {
    if !ModuleId.equals(&self.module, &other.module) {
      return false
    }
    let left = Vector.asSlice<OwnerStep>(&self.owners)
    let right = Vector.asSlice<OwnerStep>(&other.owners)
    if left.length == usize.ZERO || left.length != right.length {
      return false
    }
    let mut index = usize.ZERO
    while index < left.length {
      if left[index].kind != right[index].kind || !sameName(&left[index].name, &right[index].name) {
        return false
      }
      if index + usize.ONE < left.length && left[index].occurrence != right[index].occurrence {
        return false
      }
      index = index + usize.ONE
    }
    return true
  }
}

fn readProjection(value: &DeclarationId, part: Part, owner: usize, offset: usize) -> Option<
  Projection,
> {
  return Option.some<Projection>(DeclarationId.project(value, part, owner, offset))
}

// An inconsistent projection is an implementation defect, never a different declaration.
fn absurd<T>() -> T {
  let boom = 1 / 0
  return absurd<T>()
}
