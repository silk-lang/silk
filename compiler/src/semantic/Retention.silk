//! The explicit retention roots a build composition selects (ARTIFACT-003): runtime functions a
//! native artifact keeps, and marks used, without exporting them.
//!
//! # Details
//!
//! A selector names a canonical module and one declaration in it. The build resolves it after the
//! selected runtime and module graph are analyzed; it must name one unambiguous monomorphic runtime
//! function. Retention never changes visibility or creates a C ABI export.

import semantic.ModuleId {ModuleId}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.collections.bytes {Bytes}

/// One selector: the declaration named `declaration` in `module`.
pub struct Root {
  pub module: ModuleId,
  pub declaration: Bytes,
}

impl Root {
  pub effect fn copy(self: &Self) -> Root ! OutOfMemoryError ? &mut Allocator {
    return Root {module: ModuleId.copy(&self.module), declaration: run Bytes.copy(Bytes.asSlice(&self.declaration))}
  }
}
