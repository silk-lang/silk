//! Finite reborrow provenance after expected-value admission.
import semantic.ModuleId {InvalidModulePath}
import semantic.Query {Cycle}
import semantic.Semantic {Semantic, Request}
import semantic.SemanticCaseSupport {module, staticSemantic, hasBorrowStatus, rejectsSpan}
import semantic.Rejection {RejectionCode}
import semantic.SourceIndex {RevisionMismatch}
import semantic.Target {Target, Id as TargetId}
import semantic.TypedBody {BorrowStatus}
import semantic.Types {TypeTable, Types}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.core.effect {Effect}
import silk.testing.testing {Testing, AssertionError}

test effect fn expectedValueReborrowKeepsFiniteSource() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut types = TypeTable.make()
  return run finiteReborrowClaims() |> Effect.provideMut<Types>(&mut types) |> Effect.provideMut<Allocator>(&mut allocator)
}
effect fn finiteReborrowClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("finite-reborrow.silk")
  let text = """
struct Token { value: i32 }
struct Item { path: i32, other: i32 }
struct Holder { item: Item, n: i32 }
struct Pair { a: i32, b: i32 }
interface Make { fn make<'w, 'v: 'w>(self: &Self, head: &'v i32) -> &'w i32 }
impl Make for Token { fn make<'w, 'v: 'w>(self: &Self, head: &'v i32) -> &'w i32 { return head } }
interface Both { fn both<'w, 'v: 'w>(self: &Self, a: &'v i32, b: &'v i32) -> &'w i32 }
impl Both for Token { fn both<'w, 'v: 'w>(self: &Self, a: &'v i32, b: &'v i32) -> &'w i32 { return b } }
fn makeDirect<'w, 'v: 'w>(self: &Token, head: &'v i32) -> &'w i32 { return head }
fn bothDirect<'w, 'v: 'w>(self: &Token, a: &'v i32, b: &'v i32) -> &'w i32 { return b }
fn make() -> Holder { return Holder {item: Item {path: 1, other: 2}, n: 3} }
fn U42(p: &mut Pair, c: bool) -> i32 { let mut cursor = &p.a let mut i = 0 while i < 2 { p.a = 5 cursor = &p.b i = i + 1 } return cursor.* }
fn U43(p: &mut Pair, c: bool) -> i32 { let mut cursor = &p.a let mut i = 0 while i < 2 { let s = cursor.* p.b = s cursor = &p.b i = i + 1 } return cursor.* }
fn wl1vDirect(t: &Token) -> i32 { let l = 5 let mut r = &l let mut i = 0 while i < 3 { r = &r.* i = i + 1 } let x = makeDirect(t, r) return x.* }
fn wl3vDirect(t: &Token) -> i32 { let l = 5 let k = 6 let mut a = &l let mut b = &k let mut i = 0 while i < 3 { let c = a a = &b.* b = &c.* i = i + 1 } let x = makeDirect(t, a) return x.* }
fn wl1vInterface(t: &Token) -> i32 { let l = 5 let mut r = &l let mut i = 0 while i < 3 { r = &r.* i = i + 1 } let x = Make.make(t, r) return x.* }
fn wl3vInterface(t: &Token) -> i32 { let l = 5 let k = 6 let mut a = &l let mut b = &k let mut i = 0 while i < 3 { let c = a a = &b.* b = &c.* i = i + 1 } let x = Make.make(t, a) return x.* }
fn oldCursor(p: &mut Pair, c: bool) -> i32 { let mut cursor = &p.a while c { p.a = 5 let s = cursor.* cursor = &p.b } return cursor.* }
fn callerEscapeDirect<'p>(t: &Token, h: &'p i32) -> &'p i32 { let l = 5 return bothDirect(t, h, &l) }
fn staticEscapeDirect(t: &Token) -> &'static i32 { let l = 5 return makeDirect(t, &l) }
fn callerEscapeInterface<'p>(t: &Token, h: &'p i32) -> &'p i32 { let l = 5 return Both.both(t, h, &l) }
fn staticEscapeInterface(t: &Token) -> &'static i32 { let l = 5 return Make.make(t, &l) }
fn copiedEscape<'p>(fb: &'p i32) -> &'p i32 { let h = make() let copy = &h.item.path return copy }
fn copiedStatic(fb: &i32) -> &'static i32 { let h = make() let copy = &h.item.path return copy }
"""
  let mut store = run staticSemantic(&id, text, Target.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let U42 = run Semantic.demandBody(&mut store, &mut request, &id, b"U42")
  run Testing.expect(hasBorrowStatus(&U42, BorrowStatus.Checked), "cursor replacement does not retain the dead loan of p.a")
  let U43 = run Semantic.demandBody(&mut store, &mut request, &id, b"U43")
  run Testing.expect(hasBorrowStatus(&U43, BorrowStatus.Checked), "the scalar read ends before replacing the cursor on the backedge")
  let wl1vDirect = run Semantic.demandBody(&mut store, &mut request, &id, b"wl1vDirect")
  run Testing.expect(hasBorrowStatus(&wl1vDirect, BorrowStatus.Checked), "the complete wl1vDirect result-only call remains finite and fully checked")
  let wl3vDirect = run Semantic.demandBody(&mut store, &mut request, &id, b"wl3vDirect")
  run Testing.expect(hasBorrowStatus(&wl3vDirect, BorrowStatus.Checked), "the complete wl3vDirect result-only call remains finite and fully checked")
  let wl1vInterface = run Semantic.demandBody(&mut store, &mut request, &id, b"wl1vInterface")
  run Testing.expect(hasBorrowStatus(&wl1vInterface, BorrowStatus.Checked), "the complete wl1vInterface result-only call remains finite and fully checked")
  let wl3vInterface = run Semantic.demandBody(&mut store, &mut request, &id, b"wl3vInterface")
  run Testing.expect(hasBorrowStatus(&wl3vInterface, BorrowStatus.Checked), "the complete wl3vInterface result-only call remains finite and fully checked")
  let oldCursor = run Semantic.demandBody(&mut store, &mut request, &id, b"oldCursor")
  run Testing.expect(rejectsSpan(&oldCursor, RejectionCode.AccessDuringLoan, text, "p.a", 4), "oldCursor retains its exact source rejection")
  let callerEscapeDirect = run Semantic.demandBody(&mut store, &mut request, &id, b"callerEscapeDirect")
  run Testing.expect(rejectsSpan(&callerEscapeDirect, RejectionCode.UnsatisfiedLifetimeBound, text, "&l", 4), "callerEscapeDirect retains its exact source rejection")
  let staticEscapeDirect = run Semantic.demandBody(&mut store, &mut request, &id, b"staticEscapeDirect")
  run Testing.expect(rejectsSpan(&staticEscapeDirect, RejectionCode.UnsatisfiedLifetimeBound, text, "&l", 5), "staticEscapeDirect retains its exact source rejection")
  let callerEscapeInterface = run Semantic.demandBody(&mut store, &mut request, &id, b"callerEscapeInterface")
  run Testing.expect(rejectsSpan(&callerEscapeInterface, RejectionCode.UnsatisfiedLifetimeBound, text, "&l", 6), "callerEscapeInterface retains its exact source rejection")
  let staticEscapeInterface = run Semantic.demandBody(&mut store, &mut request, &id, b"staticEscapeInterface")
  run Testing.expect(rejectsSpan(&staticEscapeInterface, RejectionCode.UnsatisfiedLifetimeBound, text, "&l", 7), "staticEscapeInterface retains its exact source rejection")
  let copiedEscape = run Semantic.demandBody(&mut store, &mut request, &id, b"copiedEscape")
  run Testing.expect(rejectsSpan(&copiedEscape, RejectionCode.UnsatisfiedLifetimeBound, text, "&h.item.path", 0),
    "copiedEscape: a borrow of local storage that must outlive a lifetime parameter is refused at the borrow (SEM0212)")
  let copiedStatic = run Semantic.demandBody(&mut store, &mut request, &id, b"copiedStatic")
  run Testing.expect(rejectsSpan(&copiedStatic, RejectionCode.UnsatisfiedLifetimeBound, text, "&h.item.path", 1), "copiedStatic refuses its borrow of body storage returned at 'static (SEM0212)")
  return ()
}


// Descriptor consumption and referent consumption are distinct ownership events. This test
// does not change inferred binding types: each finite loan is an authored reborrow.
test effect fn sharedDescriptorConsumptionKeepsReborrowSource() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut types = TypeTable.make()
  return run sharedDescriptorClaims() |> Effect.provideMut<Types>(&mut types) |> Effect.provideMut<Allocator>(&mut allocator)
}
effect fn sharedDescriptorClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("shared-descriptor-consumption.silk")
  let text = """
fn copyDrop(fb: &i32) -> i32 { let mut q = fb drop fb return q.* }
fn reborrowDrop(fb: &i32) -> i32 { let mut q = &fb.* drop fb return q.* }
fn reborrowMove(fb: &i32) -> i32 { let q = &fb.* let transferred = move fb return q.* + transferred.* }
fn callerReturn<'p>(fb: &'p i32) -> &'p i32 { let q = &fb.* drop fb return q }
fn localSource() -> i32 { let owned = 1 let descriptor = &owned let q = &descriptor.* drop descriptor return q.* }
fn sourceWrite() -> i32 { let mut written = 1 let descriptor = &written let q = &descriptor.* drop descriptor written = 2 return q.* }
fn sourceDrop() -> i32 { let dropped = 1 let descriptor = &dropped let q = &descriptor.* drop descriptor drop dropped return q.* }
fn sourceMove() -> i32 { let moved = 1 let descriptor = &moved let q = &descriptor.* drop descriptor let taken = move moved return q.* + taken }
fn descriptorSlot(fb: &i32) -> i32 { let descriptor = fb let slot = &descriptor drop descriptor return slot.*.* }
fn exclusiveDrop(fb: &mut i32) -> i32 { let q = &fb.* drop fb return q.* }
fn consumedBinding(fb: &i32) -> i32 { let ended = &fb.* drop ended return ended.* }
fn consumedSource(fb: &i32) -> i32 { let q = &fb.* drop fb return fb.* + q.* }
"""
  let mut store = run staticSemantic(&id, text, Target.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let copied = run Semantic.demandBody(&mut store, &mut request, &id, b"copyDrop")
  run Testing.expect(hasBorrowStatus(&copied, BorrowStatus.Checked), "ordinary shared reference copies survive consumption of their source descriptor")
  let dropped = run Semantic.demandBody(&mut store, &mut request, &id, b"reborrowDrop")
  run Testing.expect(hasBorrowStatus(&dropped, BorrowStatus.Checked), "dropping a shared descriptor leaves its reborrowed referent valid")
  let moved = run Semantic.demandBody(&mut store, &mut request, &id, b"reborrowMove")
  run Testing.expect(hasBorrowStatus(&moved, BorrowStatus.Checked), "moving a shared descriptor preserves both the transferred value and its reborrow")
  let returned = run Semantic.demandBody(&mut store, &mut request, &id, b"callerReturn")
  run Testing.expect(hasBorrowStatus(&returned, BorrowStatus.Checked), "the caller's referent lifetime survives its local descriptor")
  let local = run Semantic.demandBody(&mut store, &mut request, &id, b"localSource")
  run Testing.expect(hasBorrowStatus(&local, BorrowStatus.Checked), "a reborrow through a consumed shared descriptor keeps only the body-owned source's loan, which outlives its last use")
  let write = run Semantic.demandBody(&mut store, &mut request, &id, b"sourceWrite")
  run Testing.expect(rejectsSpan(&write, RejectionCode.AccessDuringLoan, text, "written", 2), "dropping a descriptor does not permit writing its still-borrowed owner")
  let droppedOwner = run Semantic.demandBody(&mut store, &mut request, &id, b"sourceDrop")
  run Testing.expect(rejectsSpan(&droppedOwner, RejectionCode.AccessDuringLoan, text, "drop dropped", 0), "dropping the actual owner still conflicts")
  let movedOwner = run Semantic.demandBody(&mut store, &mut request, &id, b"sourceMove")
  run Testing.expect(rejectsSpan(&movedOwner, RejectionCode.AccessDuringLoan, text, "moved", 2), "moving the actual owner still conflicts")
  let slot = run Semantic.demandBody(&mut store, &mut request, &id, b"descriptorSlot")
  run Testing.expect(rejectsSpan(&slot, RejectionCode.AccessDuringLoan, text, "drop descriptor", 4), "a loan of the descriptor slot itself still prevents its consumption")
  let exclusive = run Semantic.demandBody(&mut store, &mut request, &id, b"exclusiveDrop")
  run Testing.expect(rejectsSpan(&exclusive, RejectionCode.AccessDuringLoan, text, "drop fb", 3),
    "consuming an exclusive descriptor while its reborrow is live is OWN0011")
  let ended = run Semantic.demandBody(&mut store, &mut request, &id, b"consumedBinding")
  run Testing.expect(rejectsSpan(&ended, RejectionCode.UseAfterMove, text, "ended.*", 0), "dropping the reborrow binding still ends that binding")
  let source = run Semantic.demandBody(&mut store, &mut request, &id, b"consumedSource")
  run Testing.expect(rejectsSpan(&source, RejectionCode.UseAfterMove, text, "fb.*", 6), "dropping the descriptor still ends its own usability")
  return ()
}
