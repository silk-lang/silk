//! Dense session handles for canonical declarations and their current parse positions.
//!
//! A handle survives insertion and reordering. Parse ordinals belong only to the current source
//! access; a lost handle is never revived, even when the same spelling is later reintroduced.

import semantic.DeclarationId { DeclarationId }
import semantic.InternIndex { InternIndex }
import semantic.ModuleIndex { ModuleIndex }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.option { Option }
import silk.num.usize
import silk.collections.list { List }

struct Record {
  identity: DeclarationId,
  module: usize,
  position: usize,
  lost: bool,
}

/// The declaration handles of one semantic session, with a direct current-position cache.
pub struct DeclarationTable {
  records: List<Record>,
  lookup: InternIndex,
  modules: List<List<usize>>,
}

pub fn make() -> DeclarationTable {
  return DeclarationTable {
    records: List<Record>.make(),
    lookup: InternIndex.make(),
    modules: List<List<usize>>.make()
  }
}

/// The handle already assigned to a current parse ordinal, or MAX until it is requested.
pub fn cached(self: &DeclarationTable, module: usize, position: usize) -> usize {
  let modules = List<List<usize>>.asSlice(&self.modules)
  if module >= modules.length {
    return usize.MAX
  }
  let positions = List<usize>.asSlice(&modules[module])
  if position >= positions.length {
    return usize.MAX
  }
  return positions[position]
}

effect fn put(self: &mut DeclarationTable, module: usize, position: usize, handle: usize) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  while List<List<usize>>.length(&self.modules) <= module {
    run List<List<usize>>.append(&mut self.modules, List<usize>.make())
  }
  let mut modules = List<List<usize>>.asMutSlice(&mut self.modules)
  let mut positions = &mut modules[module]
  while List<usize>.length(&positions.*) <= position {
    run List<usize>.append(&mut positions.*, usize.MAX)
  }
  List<usize>.set(&mut positions.*, position, handle)
}

/// Interns one canonical declaration on its first semantic request.
pub effect fn intern(
  self: &mut DeclarationTable,
  module: usize,
  position: usize,
  identity: &DeclarationId
) -> usize
  ! OutOfMemoryError
  ? &mut Allocator {
  let found = cached(&self.*, module, position)
  if found != usize.MAX {
    return found
  }
  let hash = DeclarationId.hash(identity)
  let records = List<Record>.asSlice(&self.records)
  let mut handle = InternIndex.first(&self.lookup, hash)
  while handle != usize.MAX {
    if
      !records[handle].lost && DeclarationId.equals(&records[handle].identity, identity) {
      run put(&mut self.*, module, position, handle)
      return handle
    }
    handle = InternIndex.after(&self.lookup, handle)
  }
  handle = List<Record>.length(&self.records)

  // Reserve the data slot before publishing its matching index ordinal.
  if handle == List<Record>.capacity(&self.records) {
    run List<Record>.reserve(&mut self.records, usize.ONE)
  }
  run InternIndex.record(&mut self.lookup, hash)
  run List<
    Record
  >.append(
    &mut self.records,
    Record {
      identity: DeclarationId.copy(identity),
      module: module,
      position: position,
      lost: false
    }
  )
  run put(&mut self.*, module, position, handle)
  return handle
}

/// The live handle interned for `identity`, or MAX when none is.
pub fn find(self: &DeclarationTable, identity: &DeclarationId) -> usize {
  let records = List<Record>.asSlice(&self.records)
  let mut handle = InternIndex.first(&self.lookup, DeclarationId.hash(identity))
  while handle != usize.MAX {
    if !records[handle].lost && DeclarationId.equals(&records[handle].identity, identity) {
      return handle
    }
    handle = InternIndex.after(&self.lookup, handle)
  }
  return usize.MAX
}

/// Resolves a live handle to its current parse position; MAX means it is lost.
pub fn position(self: &DeclarationTable, handle: usize) -> usize {
  let records = List<Record>.asSlice(&self.records)
  if handle >= records.length || records[handle].lost {
    return usize.MAX
  }
  return records[handle].position
}

/// The canonical declaration a handle was interned for, lost or not; none for a handle never issued.
pub fn identity(self: &DeclarationTable, handle: usize) -> Option<&DeclarationId> {
  let records = List<Record>.asSlice(&self.records)
  if handle >= records.length {
    return Option<&DeclarationId>.none()
  }
  return Option<&DeclarationId>.some(&records[handle].identity)
}

/// Clears current-position hits when a source revision is waiting to be reconciled.
pub fn invalidate(self: &mut DeclarationTable, module: usize) -> () {
  if module < List<List<usize>>.length(&self.modules) {
    List<List<usize>>.set(&mut self.modules, module, List<usize>.make())
  }
}

/// Prospective position under the same survival rule used by refresh. No mutation or revival.
pub fn nextPosition(self: &DeclarationTable, handle: usize, previous: &Option<ModuleIndex>, current: &ModuleIndex) -> usize {
  let records = List<Record>.asSlice(&self.records)
  if handle >= records.length || records[handle].lost { return usize.MAX }
  if let Option<ModuleIndex>.Some {value: before} = &previous.* {
    if let Option<usize>.Some {value: next} = move ModuleIndex.ordinalOf(current, &records[handle].identity) {
      if ModuleIndex.matchesIdentity(&before, records[handle].position, current, next) { return next }
    }
  }
  return usize.MAX
}

/// Reconciles one revised module. Allocation failure leaves its handles unchanged.
pub effect fn refresh(
  self: &mut DeclarationTable,
  module: usize,
  previous: &Option<ModuleIndex>,
  current: &ModuleIndex
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut updates = List<usize>.make()
  let mut positions = List<usize>.make()
  let records = List<Record>.asSlice(&self.records)
  let mut handle = usize.ZERO
  while handle < records.length {
    let mut found = records[handle].position
    if records[handle].module == module && !records[handle].lost {
      found = nextPosition(&self.*, handle, previous, current)
      if found != usize.MAX {
        while List<usize>.length(&positions) <= found {
          run List<usize>.append(&mut positions, usize.MAX)
        }
        List<usize>.set(&mut positions, found, handle)
      }
    }
    run List<usize>.append(&mut updates, found)
    handle = handle + usize.ONE
  }
  let mut writable = List<Record>.asMutSlice(&mut self.records)
  handle = usize.ZERO
  while handle < writable.length {
    if writable[handle].module == module && !writable[handle].lost {
      let found = List<usize>.get(&updates, handle)
      writable[handle].position = found
      writable[handle].lost = found == usize.MAX
    }
    handle = handle + usize.ONE
  }
  if module < List<List<usize>>.length(&self.modules) {
    List<List<usize>>.set(&mut self.modules, module, move positions)
  }
}

/// Ends every live declaration handle when its module is absent.
pub fn lose(self: &mut DeclarationTable, module: usize) -> () {
  invalidate(&mut self.*, module)
  let mut records = List<Record>.asMutSlice(&mut self.records)
  let mut at = usize.ZERO
  while at < records.length {
    if records[at].module == module {
      records[at].lost = true
      records[at].position = usize.MAX
    }
    at = at + usize.ONE
  }
}
