//! Dense session handles for canonical declarations and their current parse positions.
//!
//! A handle survives insertion and reordering. Parse ordinals belong only to the current source
//! access; a lost handle is never revived, even when the same spelling is later reintroduced.

import semantic.DeclarationId { DeclarationId }
import semantic.InternIndex { InternIndex }
import semantic.ModuleIndex { ModuleIndex }
import silk.allocator { Allocator, OutOfMemoryError }
import silk.option { Option }
import silk.usize
import silk.vector { Vector }

struct Record {
  identity: DeclarationId
  module: usize
  position: usize
  lost: bool
}

/// The changed declaration inputs of one recorded handle after a source refresh.
pub struct DeclarationChanges {
  pub wholeChanged: bool
  pub prototypeChanged: bool
}

/// The declaration handles of one semantic session, with a direct current-position cache.
pub struct DeclarationTable {
  records: Vector<Record>
  lookup: InternIndex
  modules: Vector<Vector<usize>>
}

pub fn make() -> DeclarationTable {
  return DeclarationTable {
    records: Vector<Record>.make(),
    lookup: InternIndex.make(),
    modules: Vector<Vector<usize>>.make()
  }
}

/// The handle already assigned to a current parse ordinal, or MAX until it is requested.
pub fn cached(self: &DeclarationTable, module: usize, position: usize) -> usize {
  let modules = Vector<Vector<usize>>.asSlice(&self.modules)
  if module >= modules.length {
    return usize.MAX
  }
  let positions = Vector<usize>.asSlice(&modules[module])
  if position >= positions.length {
    return usize.MAX
  }
  return positions[position]
}

effect fn put(self: &mut DeclarationTable, module: usize, position: usize, handle: usize) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  while Vector<Vector<usize>>.length(&self.modules) <= module {
    run Vector<Vector<usize>>.append(&mut self.modules, Vector<usize>.make())
  }
  let mut modules = Vector<Vector<usize>>.asMutSlice(&mut self.modules)
  let mut positions = &mut modules[module]
  while Vector<usize>.length(&positions.*) <= position {
    run Vector<usize>.append(&mut positions.*, usize.MAX)
  }
  Vector<usize>.set(&mut positions.*, position, handle)
}

/// Interns one canonical declaration on its first semantic request.
pub effect fn intern(
  self: &mut DeclarationTable,
  module: usize,
  position: usize,
  identity: &DeclarationId
) -> usize
  ! OutOfMemoryError
  ? &mut Allocator {
  let found = cached(&self.*, module, position)
  if found != usize.MAX {
    return found
  }
  let hash = DeclarationId.hash(identity)
  let records = Vector<Record>.asSlice(&self.records)
  let mut handle = InternIndex.first(&self.lookup, hash)
  while handle != usize.MAX {
    if
      !records[handle].lost && DeclarationId.equals(&records[handle].identity, identity) {
      run put(&mut self.*, module, position, handle)
      return handle
    }
    handle = InternIndex.after(&self.lookup, handle)
  }
  handle = Vector<Record>.length(&self.records)

  // Reserve the data slot before publishing its matching index ordinal.
  if handle == Vector<Record>.capacity(&self.records) {
    run Vector<Record>.reserve(&mut self.records, usize.ONE)
  }
  run InternIndex.record(&mut self.lookup, hash)
  run Vector<
    Record
  >.append(
    &mut self.records,
    Record {
      identity: DeclarationId.copy(identity),
      module: module,
      position: position,
      lost: false
    }
  )
  run put(&mut self.*, module, position, handle)
  return handle
}

/// Resolves a live handle to its current parse position; MAX means it is lost.
pub fn position(self: &DeclarationTable, handle: usize) -> usize {
  let records = Vector<Record>.asSlice(&self.records)
  if handle >= records.length || records[handle].lost {
    return usize.MAX
  }
  return records[handle].position
}

/// The owner module of a stable handle, including a handle lost in a later revision.
pub fn moduleOf(self: &DeclarationTable, handle: usize) -> usize {
  let records = Vector<Record>.asSlice(&self.records)
  if handle >= records.length { return usize.MAX }
  return records[handle].module
}

/// The canonical identity retained by a handle, including one lost in a later revision.
pub fn identityOf<'a>(self: &'a DeclarationTable, handle: usize) -> Option<&'a DeclarationId> {
  let records = Vector<Record>.asSlice(&self.records)
  if handle >= records.length { return Option<&'a DeclarationId>.none() }
  return Option<&'a DeclarationId>.some(&records[handle].identity)
}

/// Compares a recorded handle's old identity with its current parse position after refresh.
/// Lost handles, ambiguous identities, and indexes without fingerprints change both inputs.
pub fn changes(
  self: &DeclarationTable,
  handle: usize,
  previous: &ModuleIndex,
  current: &ModuleIndex
) -> DeclarationChanges {
  let records = Vector<Record>.asSlice(&self.records)
  if handle >= records.length || records[handle].lost {
    return DeclarationChanges { wholeChanged: true, prototypeChanged: true }
  }
  let record = &records[handle]
  if let Option<usize>.Some { value: before } = move ModuleIndex.ordinalOf(previous, &record.identity) {
    return DeclarationChanges {
      wholeChanged: !ModuleIndex.matchesDeclaration(previous, before, current, record.position),
      prototypeChanged: !ModuleIndex.matchesPrototype(previous, before, current, record.position)
    }
  }
  return DeclarationChanges { wholeChanged: true, prototypeChanged: true }
}

/// Clears current-position hits when a source revision is waiting to be reconciled.
pub fn invalidate(self: &mut DeclarationTable, module: usize) -> () {
  if module < Vector<Vector<usize>>.length(&self.modules) {
    Vector<Vector<usize>>.set(&mut self.modules, module, Vector<usize>.make())
  }
}

/// Reconciles one revised module. Allocation failure leaves its handles unchanged.
pub effect fn refresh(
  self: &mut DeclarationTable,
  module: usize,
  previous: &Option<ModuleIndex>,
  current: &ModuleIndex
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut updates = Vector<usize>.make()
  let mut positions = Vector<usize>.make()
  let records = Vector<Record>.asSlice(&self.records)
  let mut handle = usize.ZERO
  while handle < records.length {
    let mut found = records[handle].position
    if records[handle].module == module && !records[handle].lost {
      found = usize.MAX
      if let Option<ModuleIndex>.Some { value: before } = &previous.* {
        if let Option<usize>.Some {
          value: next
        } = move ModuleIndex.ordinalOf(current, &records[handle].identity) {
          if ModuleIndex.matchesIdentity(&before, records[handle].position, current, next) {
            found = next
          }
        }
      }
      if found != usize.MAX {
        while Vector<usize>.length(&positions) <= found {
          run Vector<usize>.append(&mut positions, usize.MAX)
        }
        Vector<usize>.set(&mut positions, found, handle)
      }
    }
    run Vector<usize>.append(&mut updates, found)
    handle = handle + usize.ONE
  }
  let mut writable = Vector<Record>.asMutSlice(&mut self.records)
  handle = usize.ZERO
  while handle < writable.length {
    if writable[handle].module == module && !writable[handle].lost {
      let found = Vector<usize>.get(&updates, handle)
      writable[handle].position = found
      writable[handle].lost = found == usize.MAX
    }
    handle = handle + usize.ONE
  }
  if module < Vector<Vector<usize>>.length(&self.modules) {
    Vector<Vector<usize>>.set(&mut self.modules, module, move positions)
  }
}

/// Ends every live declaration handle when its module is absent.
pub fn lose(self: &mut DeclarationTable, module: usize) -> () {
  invalidate(&mut self.*, module)
  let mut records = Vector<Record>.asMutSlice(&mut self.records)
  let mut at = usize.ZERO
  while at < records.length {
    if records[at].module == module {
      records[at].lost = true
      records[at].position = usize.MAX
    }
    at = at + usize.ONE
  }
}
