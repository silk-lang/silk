pub fn staticSharedIntegerIs(value: &StaticData, expected: u64) -> bool {
  return match &value.* {
    StaticData.Integer {sign, magnitude, ..} => sign == StaticSign.Positive && magnitude == expected
    _ => false
  }
}

pub effect fn staticSemantic(id: &ModuleId, text: string, target: MachineTarget) -> Semantic
! OutOfMemoryError
? &mut Allocator {
  let source = run present(text)
  let revision = run Revision.publish(&Revision.make(), id, &source)
  return Semantic.traced(move revision, target, Option.none<FinalProfile>())
}

pub fn rejectionAt(answer: &Result<Answer, NoRejection>, code: RejectionCode, start: usize) -> bool {
  if let Option<Shared<Rejection>>.Some {value: problem} = move rejection(answer) {
    return Shared.with<Rejection, bool>(&problem, fn(found: &Rejection) -> bool {
      return found.code == code && found.span.start == start
    })
  }
  return false
}

pub fn directCalls(body: &TypedBody) -> usize {
  let nodes = TypedBody.nodeSlice(body)
  let mut count = usize.ZERO
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {form: BodyExpression.DirectCall {..}, ..} = &nodes[at].kind { count = count + usize.ONE }
    at = at + usize.ONE
  }
  return count
}

pub fn borrowNotChecked(body: &TypedBody) -> bool {
  return match TypedBody.borrowStatus(body) {
    BodyBorrowStatus.NotChecked => true
  }
}

pub effect fn selectedApplicationOf(index: &mut SourceIndex, id: &ModuleId, name: &[u8]) -> SpecializationApplication
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
? &mut Allocator {
  let declaration = run requireIndexedIdentity(&mut index.*, id, OwnerKind.Function, name, usize.ZERO)
  return run specializationWithArguments(&declaration, Vector.make<Argument>())
}

pub fn mirReferenceCount(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>) -> usize {
  let index = Shared.with<Result<Answer, NoRejection>, Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: at} = move index {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, at) {
      return Vector.length<MirReference>(&function.references)
    }
  }
  return usize.MAX
}

pub fn integerOperand(value: &MirOperand, text: &[u8]) -> bool {
  return match &value.* {
    MirOperand.Integer {decimal, negative, ..} => !negative && sameBytes(Bytes.asSlice(&decimal), text)
    _ => false
  }
}

// The only reference a lowered function makes, if it makes exactly one.
pub fn soleReference(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>) -> Option<InstanceKey> {
  let index = Shared.with<Result<Answer, NoRejection>, Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: at} = move index {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, at) {
      let references = Vector.asSlice<MirReference>(&function.references)
      if references.length == usize.ONE { return Option.some<InstanceKey>(InstanceKey.copy(&references[usize.ZERO].key)) }
    }
  }
  return Option.none<InstanceKey>()
}

// A closure that did not certify, with this rejection code; NotProven also records its budget.
pub fn closureRefused(closure: &StaticClosure, code: RejectionCode, budget: usize) -> bool {
  return match &closure.* {
    StaticClosure.NotProven {diagnostic} => code == RejectionCode.StaticRecursionNotProven && Shared.with<Rejection, bool>(&diagnostic,
      fn(found: &Rejection) -> bool { return found.code == code && found.expected == budget && Vector.length<SpecializationApplication>(&found.specialization) > usize.ZERO })
    StaticClosure.Rejected {diagnostic} => Shared.with<Rejection, bool>(&diagnostic, fn(found: &Rejection) -> bool { return found.code == code })
    _ => false
  }
}

// All semantic fixtures deliberately use one selected native target.
pub fn makeSemantic(revision: Revision) -> Semantic {
  return Semantic.traced(move revision, MachineTarget.forId(TargetId.Aarch64AppleDarwin), Option.none<FinalProfile>())
}

pub struct AnswerView {
  pub success: bool
  pub dependencies: usize
  pub sources: usize
}

pub struct NestedFailureAllocator {
  pub targetBytes: usize
  pub rejected: bool
}

impl NestedFailureAllocator {
  pub effect fn allocate(self: &mut Self, layout: Layout) -> Allocation ! OutOfMemoryError {
    if layout.bytes == self.targetBytes && layout.alignment == 1 {
      self.rejected = true
      fail OutOfMemoryError {}
    }
    let mut system = Allocator.systemAllocatorProvider()
    return run Allocator.allocate(move layout)
      |> Effect.provideMut<Allocator>(&mut system)
  }
}

impl Allocator for NestedFailureAllocator {
  allocate: NestedFailureAllocator.allocate
}

pub fn inspect(answer: &Result<Answer, NoRejection>) -> AnswerView {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: _} => AnswerView {
        success: true,
        dependencies: Vector.length(&value.dependencies),
        sources: Vector.length(&value.sources),
      }
      Outcome.Rejected {diagnostic: _} => AnswerView {
        success: false,
        dependencies: Vector.length(&value.dependencies),
        sources: Vector.length(&value.sources),
      }
    }
    Result<Answer, NoRejection>.Failure {error: _} => AnswerView {
      success: false,
      dependencies: usize.ZERO,
      sources: usize.ZERO,
    }
  }
}

pub fn rejection(answer: &Result<Answer, NoRejection>) -> Option<Shared<Rejection>> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Rejected {diagnostic} => Option.some<Shared<Rejection>>(
        Shared.clone<Rejection>(&diagnostic),
      )
      Outcome.Success {value: _} => Option.none<Shared<Rejection>>()
    }
    Result<Answer, NoRejection>.Failure {error: _} => Option.none<Shared<Rejection>>()
  }
}

pub fn answerHasAbsentSource(answer: &Result<Answer, NoRejection>, module: &ModuleId) -> bool {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => {
      let sources = Vector.asSlice<Shared<Observation>>(&value.sources)
      let mut at = usize.ZERO
      while at < sources.length {
        if Shared.with<Observation, bool>(
          &sources[at],
          fn(observed: &Observation) -> bool {
            return !Observation.isPresent(observed) && ModuleId.equals(
              Observation.moduleId(observed),
              module,
            )
          },
        ) {
          return true
        }
        at = at + usize.ONE
      }
      return false
    }
    Result<Answer, NoRejection>.Failure {error: _} => false
  }
}

pub fn checkedBody(answer: &Result<Answer, NoRejection>) -> Option<Shared<TypedBody>> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Body {body, source: _}} => Option.some<Shared<TypedBody>>(
        Shared.clone<TypedBody>(&body),
      )
      _ => Option.none<Shared<TypedBody>>()
    }
    Result<Answer, NoRejection>.Failure {error: _} => Option.none<Shared<TypedBody>>()
  }
}

pub fn bodyIsFullyChecked(body: &TypedBody) -> bool {
  let stage = TypedBody.checkingStage(body)
  return match &stage.* {
    BodyStage.FullyChecked => true
    BodyStage.ContractTyped {..} => false
  }
}

pub fn bodyIsContractTyped(body: &TypedBody) -> bool {
  let stage = TypedBody.checkingStage(body)
  return match &stage.* {
    BodyStage.ContractTyped {..} => true
    BodyStage.FullyChecked => false
  }
}

pub fn bodyAnswerIsContractTyped(answer: &Result<Answer, NoRejection>) -> bool {
  if let Option<Shared<TypedBody>>.Some {value} = move checkedBody(answer) {
    return Shared.with<TypedBody, bool>(&value, bodyIsContractTyped)
  }
  return false
}

pub fn bodyRetainsReceiverPass(body: &TypedBody, mode: BodyReceiverPass) -> bool {
  let mut typed = false
  let nodes = TypedBody.nodeSlice(body)
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {form, ..} = &nodes[at].kind {
      if let BodyExpression.DirectCall {receiverPass, arguments, ..} = &form {
        if let Option<BodyReceiverPass>.Some {value} = &receiverPass {
          typed = typed || value == mode && Vector.length<BodyNodeId>(&arguments) > usize.ZERO
        }
      }
    }
    at = at + usize.ONE
  }
  let stage = TypedBody.checkingStage(body)
  if let BodyStage.ContractTyped {obligations} = &stage.* {
    let entries = Vector.asSlice<BodySafetyObligation>(&obligations)
    at = usize.ZERO
    while at < entries.length {
      if let BodySafetyObligation.ReceiverPass {receiver, mode: retained, ..} = &entries[at] {
        if receiver.index < nodes.length && retained == mode {
          return typed
        }
      }
      at = at + usize.ONE
    }
  }
  return false
}

pub fn directCallType(body: &TypedBody) -> Option<Shared<Type>> {
  let nodes = TypedBody.nodeSlice(body)
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {ty, form: BodyExpression.DirectCall {..}} = &nodes[at].kind {
      return Option.some<Shared<Type>>(Shared.clone<Type>(&ty))
    }
    at = at + usize.ONE
  }
  return Option.none<Shared<Type>>()
}

pub fn rejectionSpells(
  answer: &Result<Answer, NoRejection>,
  code: RejectionCode,
  source: &[u8],
  spelling: &[u8],
) -> bool {
  let found = rejection(answer)
  if let Option<Shared<Rejection>>.Some {value} = move found {
    return Shared.with<Rejection, bool>(
      &value,
      fn(diagnostic: &Rejection) -> bool {
        if diagnostic.code != code || diagnostic.span.end > source.length || diagnostic.span.end - diagnostic.span.start != spelling.length {
          return false
        }
        let mut at = usize.ZERO
        while at < spelling.length {
          if source[diagnostic.span.start + at] != spelling[at] {
            return false
          }
          at = at + usize.ONE
        }
        return true
      },
    )
  }
  return false
}

pub fn bodyCalls(body: &TypedBody, module: &ModuleId, argumentCount: usize) -> bool {
  let nodes = TypedBody.nodeSlice(body)
  let signatures = TypedBody.signatureDependencies(body)
  let required = TypedBody.runtimeBodies(body)
  if signatures.length != 2 || required.length != 1 || !ModuleId.equals(
    DeclarationId.moduleId(&required[usize.ZERO]),
    module,
  ) || !DeclarationId.equals(&signatures[usize.ONE].declaration, &required[usize.ZERO]) {
    return false
  }
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {form: BodyExpression.DirectCall {declaration, arguments, ..}, ..} = &nodes[at].kind {
      if !DeclarationId.equals(&declaration, &required[usize.ZERO]) || Vector.length(&arguments) != argumentCount {
        return false
      }
      let ordered = Vector.asSlice(&arguments)
      let mut argument = usize.ONE
      while argument < ordered.length {
        if nodes[ordered[argument - usize.ONE].index].origin.span.start >= nodes[ordered[argument].index].origin.span.start {
          return false
        }
        argument = argument + usize.ONE
      }
      return true
    }
    at = at + usize.ONE
  }
  return false
}

pub fn bodyCallGenericCount(body: &TypedBody, count: usize) -> bool {
  let nodes = TypedBody.nodeSlice(body)
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {form: BodyExpression.DirectCall {application, ..}, ..} = &nodes[at].kind {
      return Shared.with<SpecializationApplication, bool>(&application, fn(value: &SpecializationApplication) -> bool {
        return Vector.length<Argument>(&value.arguments) == count
      })
    }
    at = at + usize.ONE
  }
  return false
}

pub fn rejectionCode(answer: &Result<Answer, NoRejection>, code: RejectionCode) -> bool {
  let found = rejection(answer)
  if let Option<Shared<Rejection>>.Some {value} = move found {
    return Shared.with<Rejection, bool>(
      &value,
      fn(diagnostic: &Rejection) -> bool {
        return diagnostic.code == code && diagnostic.span.end > diagnostic.span.start
      },
    )
  }
  return false
}

pub fn isCycle(value: &Rejection) -> bool {
  return value.code == RejectionCode.Cycle
}

pub fn cyclePathLength(value: &Rejection) -> usize {
  return Vector.length(&value.path)
}

pub fn spanEnd(value: &Rejection) -> usize {
  return value.span.end
}

pub fn declarationAddress(value: &DeclarationId) -> usize {
  return Pointer.address<DeclarationId>(Pointer.fromRef<DeclarationId>(value))
}

pub fn stepWith(first: &DeclarationId, right: &Shared<DeclarationId>) -> bool {
  return Shared.with<DeclarationId, bool>(
    right,
    fn(second: &DeclarationId) -> bool {
      return DeclarationId.equals(first, second)
    },
  )
}

// Cycle paths share declaration handles; compare one handle without entering it twice.
pub fn sameStep(left: &Shared<DeclarationId>, right: &Shared<DeclarationId>) -> bool {
  if Shared.with<DeclarationId, usize>(left, declarationAddress) == Shared.with<
    DeclarationId,
    usize,
  >(right, declarationAddress) {
    return true
  }
  return Shared.with<DeclarationId, bool>(
    left,
    fn(first: &DeclarationId) -> bool {
      return stepWith(first, right)
    },
  )
}

pub fn stepOf(value: &Rejection, at: usize) -> Shared<DeclarationId> {
  let path = Vector.asSlice<Shared<DeclarationId>>(&value.path)
  return Shared.clone<DeclarationId>(&path[at])
}

pub fn cycleStep(diagnostic: &Shared<Rejection>, at: usize) -> Shared<DeclarationId> {
  return Shared.with<Rejection, Shared<DeclarationId>>(
    diagnostic,
    fn(value: &Rejection) -> Shared<DeclarationId> {
      return stepOf(value, at)
    },
  )
}

pub fn sameModuleWith(first: &Rejection, other: &Shared<Rejection>) -> bool {
  return Shared.with<Rejection, bool>(
    other,
    fn(second: &Rejection) -> bool {
      return ModuleId.equals(&first.module, &second.module)
    },
  )
}

// Compares cycle rejections from two stores: anchor, module, and the complete ordered path.
pub fn sameCycle(left: &Shared<Rejection>, right: &Shared<Rejection>) -> bool {
  let length = Shared.with<Rejection, usize>(left, cyclePathLength)
  if !Shared.with<Rejection, bool>(left, isCycle) || !Shared.with<Rejection, bool>(right, isCycle) || length != Shared.with<
    Rejection,
    usize,
  >(right, cyclePathLength) || length < 2 || Shared.with<Rejection, usize>(left, spanStart) != Shared.with<
    Rejection,
    usize,
  >(right, spanStart) || Shared.with<Rejection, usize>(left, spanEnd) != Shared.with<
    Rejection,
    usize,
  >(right, spanEnd) || !Shared.with<Rejection, bool>(
    left,
    fn(first: &Rejection) -> bool {
      return sameModuleWith(first, right)
    },
  ) {
    return false
  }
  let mut at = usize.ZERO
  while at < length {
    if !sameStep(&cycleStep(left, at), &cycleStep(right, at)) {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

pub fn sameCycleAnswers(
  left: &Shared<Result<Answer, NoRejection>>,
  right: &Shared<Result<Answer, NoRejection>>,
) -> bool {
  let first = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(left, rejection)
  let second = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(right, rejection)
  if let Option<Shared<Rejection>>.Some {value: from} = move first {
    if let Option<Shared<Rejection>>.Some {value: to} = move second {
      return sameCycle(&from, &to)
    }
  }
  return false
}

// Two members of one two-declaration cycle each start the path at themselves.
pub fn rotatedPair(
  left: &Shared<Result<Answer, NoRejection>>,
  right: &Shared<Result<Answer, NoRejection>>,
) -> bool {
  let first = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(left, rejection)
  let second = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(right, rejection)
  if let Option<Shared<Rejection>>.Some {value: from} = move first {
    if let Option<Shared<Rejection>>.Some {value: to} = move second {
      return Shared.with<Rejection, usize>(&from, cyclePathLength) == 3 && Shared.with<
        Rejection,
        usize,
      >(&to, cyclePathLength) == 3 && sameStep(&cycleStep(&from, 0), &cycleStep(&to, 1)) && sameStep(
        &cycleStep(&from, 1),
        &cycleStep(&to, 0),
      ) && !sameStep(&cycleStep(&from, 0), &cycleStep(&to, 0))
    }
  }
  return false
}

pub fn isNominal(resolved: &Type) -> bool {
  return match & resolved.* {
    Type.Nominal {..} => true
    _ => false
  }
}

pub fn isBool(resolved: &Type) -> bool {
  return match & resolved.* {
    Type.Primitive {name} => {
      let bytes = Bytes.asSlice(&name)
      return bytes.length == 4 && bytes[0] == 98 && bytes[1] == 111 && bytes[2] == 111 && bytes[3] == 108
    }
    _ => false
  }
}

pub fn sameBytes(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

pub fn spanStart(value: &Rejection) -> usize {
  return value.span.start
}

pub fn signatureResult(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: fact} => match & fact {
        Value.Signature {signature} => Option.some<Shared<Type>>(
          Shared.clone<Type>(&signature.result),
        )
        _ => Option.none<Shared<Type>>()
      }
      Outcome.Rejected {diagnostic: _} => Option.none<Shared<Type>>()
    }
    Result<Answer, NoRejection>.Failure {error: _} => Option.none<Shared<Type>>()
  }
}

pub fn nominalResult(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Type {resolved}} => Option.some<Shared<Type>>(
        Shared.clone<Type>(&resolved),
      )
      _ => Option.none<Shared<Type>>()
    }
    Result<Answer, NoRejection>.Failure {error: _} => Option.none<Shared<Type>>()
  }
}

pub fn isParameter(resolved: &Type) -> bool {
  return match & resolved.* {
    Type.Parameter {ordinal, ..} => ordinal == usize.ZERO
    _ => false
  }
}

pub fn typeAddressForContract(value: &Type) -> usize {
  return Pointer.address<Type>(Pointer.fromRef<Type>(value))
}

pub fn sameRepresentationParameterWith(value: &Type, right: &Shared<Type>) -> bool {
  if let Type.Parameter {declaration, ordinal} = &value.* {
    return Shared.with<Type, bool>(
      right,
      fn(other: &Type) -> bool {
        if let Type.Parameter {declaration: selected, ordinal: position} = &other.* {
          return ordinal == position && DeclarationId.equals(&declaration, &selected)
        }
        return false
      },
    )
  }
  return false
}

pub fn sameRepresentationParameter(left: &Shared<Type>, right: &Shared<Type>) -> bool {
  if Shared.with<Type, usize>(left, typeAddressForContract) == Shared.with<Type, usize>(
    right,
    typeAddressForContract,
  ) {
    return true
  }
  return Shared.with<Type, bool>(
    left,
    fn(value: &Type) -> bool {
      return sameRepresentationParameterWith(value, right)
    },
  )
}

// Contract normalization assertions inspect the promised callable, separately from its exact
// declaration-owned parameter representation, which has independent specialization assertions.
pub fn parameterContractAt(signature: &Signature, slot: usize) -> Option<Shared<Type>> {
  if slot == usize.MAX { return Option.some<Shared<Type>>(Shared.clone<Type>(&signature.result)) }
  let parameters = Vector.asSlice<Shared<Type>>(&signature.parameters)
  if slot >= parameters.length {
    return Option.none<Shared<Type>>()
  }
  let parameter = Shared.clone<Type>(&parameters[slot])
  let ordinal = Shared.with<Type, usize>(
    &parameter,
    fn(value: &Type) -> usize {
      return match & value.* {
        Type.Parameter {ordinal, ..} => ordinal
        _ => usize.MAX
      }
    },
  )
  if ordinal != usize.MAX && ordinal >= signature.callableParameterStart {
    let bounds = Vector.asSlice<Constraint>(&signature.constraints)
    let mut at = usize.ZERO
    while at < bounds.length {
      if let Constraint.Represents {parameter: representation, contract} = &bounds[at] {
        if sameRepresentationParameter(&parameter, &representation) {
          return Option.some<Shared<Type>>(Shared.clone<Type>(&contract))
        }
      }
      at = at + usize.ONE
    }
  }
  return Option.some<Shared<Type>>(move parameter)
}

pub fn contractSlotOf(answer: &Shared<Result<Answer, NoRejection>>, slot: usize) -> Option<Shared<Type>> {
  return Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
    answer,
    fn(value: &Result<Answer, NoRejection>) -> Option<Shared<Type>> {
      if let Result<Answer, NoRejection>.Success {value: resolved} = &value.* {
        if let Outcome.Success {value: Value.Signature {signature}} = &resolved.outcome {
          return parameterContractAt(&signature, slot)
        }
      }
      return Option.none<Shared<Type>>()
    },
  )
}

pub fn typeAt(answer: &Result<Answer, NoRejection>, slot: usize) -> Option<Shared<Type>> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Signature {signature}} => {
        if slot == usize.MAX {
          return Option.some<Shared<Type>>(writtenResult(&signature.result))
        }
        let parameters = Vector.asSlice<Shared<Type>>(&signature.parameters)
        if slot < parameters.length {
          return Option.some<Shared<Type>>(Shared.clone<Type>(&parameters[slot]))
        }
        return Option.none<Shared<Type>>()
      }
      _ => Option.none<Shared<Type>>()
    }
    Result<Answer, NoRejection>.Failure {error: _} => Option.none<Shared<Type>>()
  }
}

// The written result: a declared `Effect<...>` result's contract rather than the producer family
// that stores its returned Effects (EFF-013).
pub fn writtenResult(result: &Shared<Type>) -> Shared<Type> {
  let contract = Shared.with<Type, Option<Shared<Type>>>(result, familyEffectContract)
  return match move contract {
    Option<Shared<Type>>.Some {value} => value
    Option<Shared<Type>>.None => Shared.clone<Type>(result)
  }
}

pub fn familyEffectContract(value: &Type) -> Option<Shared<Type>> {
  if let Type.OpaqueRepresentation {contract, ..} = &value.* {
    if Shared.with<Type, bool>(&contract, bareEffectType) { return Option.some<Shared<Type>>(Shared.clone<Type>(&contract)) }
  }
  return Option.none<Shared<Type>>()
}

pub fn bareEffectType(value: &Type) -> bool {
  return match &value.* { Type.Effect {..} => true _ => false }
}

// A parameter's type, or the result's type when `slot` is `usize.MAX`.
pub fn slotOf(answer: &Shared<Result<Answer, NoRejection>>, slot: usize) -> Option<Shared<Type>> {
  return Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
    answer,
    fn(value: &Result<Answer, NoRejection>) -> Option<Shared<Type>> {
      return typeAt(value, slot)
    },
  )
}

pub effect fn typesEqual(first: Option<Shared<Type>>, second: Option<Shared<Type>>) -> bool
! OutOfMemoryError
? &mut Allocator {
  if let Option<Shared<Type>>.Some {value: from} = move first {
    if let Option<Shared<Type>>.Some {value: to} = move second {
      return run Type.equalsShared(&from, &to)
    }
  }
  return false
}

pub effect fn slotsEqual(answer: &Shared<Result<Answer, NoRejection>>, left: usize, right: usize) -> bool
! OutOfMemoryError
? &mut Allocator {
  return run typesEqual(contractSlotOf(answer, left), contractSlotOf(answer, right))
}

pub effect fn answersEqual(
  first: &Shared<Result<Answer, NoRejection>>,
  second: &Shared<Result<Answer, NoRejection>>,
  slot: usize,
) -> bool ! OutOfMemoryError ? &mut Allocator {
  return run typesEqual(slotOf(first, slot), slotOf(second, slot))
}

pub fn parameterCountOf(answer: &Result<Answer, NoRejection>) -> usize {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Signature {signature}} => Vector.length(&signature.parameters)
      _ => usize.ZERO
    }
    Result<Answer, NoRejection>.Failure {error: _} => usize.ZERO
  }
}

pub fn signatureHasOrdinaryBinder(answer: &Result<Answer, NoRejection>) -> bool {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Signature {signature}} => {
        let binders = Vector.asSlice<Shared<Type>>(&signature.typeParameters)
        let parameters = Vector.asSlice<Shared<Type>>(&signature.parameters)
        return binders.length == 1 && parameters.length == 1 && Shared.with<Type, bool>(
          &binders[usize.ZERO],
          isParameter,
        ) && Shared.with<Type, bool>(&parameters[usize.ZERO], isParameter) && Shared.with<
          Type,
          bool,
        >(&signature.result, isParameter)
      }
      _ => false
    }
    Result<Answer, NoRejection>.Failure {error: _} => false
  }
}

pub effect fn resultEquals(
  first: &Shared<Result<Answer, NoRejection>>,
  second: &Shared<Result<Answer, NoRejection>>,
) -> bool ! OutOfMemoryError ? &mut Allocator {
  return run answersEqual(first, second, usize.MAX)
}

pub fn signatureSucceeded(answer: &Result<Answer, NoRejection>) -> bool {
  return match move signatureResult(answer) {
    Option<Shared<Type>>.Some {value: _} => true
    Option<Shared<Type>>.None => false
  }
}

pub fn rejectedTypeApplication(answer: &Result<Answer, NoRejection>, code: RejectionCode) -> bool {
  let diagnostic = rejection(answer)
  if let Option<Shared<Rejection>>.Some {value} = move diagnostic {
    return Shared.with<Rejection, bool>(
      &value,
      fn(found: &Rejection) -> bool {
        return found.code == code && found.span.end > found.span.start
      },
    )
  }
  return false
}

pub fn wrongTypeArity(answer: &Result<Answer, NoRejection>) -> bool {
  let diagnostic = rejection(answer)
  if let Option<Shared<Rejection>>.Some {value} = move diagnostic {
    return Shared.with<Rejection, bool>(
      &value,
      fn(found: &Rejection) -> bool {
        return found.code == RejectionCode.TypeArity && found.expected == 2 && found.supplied == 1 && found.span.end > found.span.start
      },
    )
  }
  return false
}

pub fn hasTypeLookup(answer: &Result<Answer, NoRejection>, expected: Family) -> bool {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => {
      let dependencies = Vector.asSlice<Dependency>(&value.dependencies)
      let mut at = usize.ZERO
      while at < dependencies.length {
        if dependencies[at].family == expected {
          return true
        }
        at = at + usize.ONE
      }
      return false
    }
    Result<Answer, NoRejection>.Failure {error: _} => false
  }
}

pub fn isI32(resolved: &Type) -> bool {
  return match & resolved.* {
    Type.Primitive {name} => {
      let bytes = Bytes.asSlice(&name)
      return bytes.length == 3 && bytes[0] == 105 && bytes[1] == 51 && bytes[2] == 50
    }
    _ => false
  }
}

pub fn signatureIsI32(answer: &Shared<Result<Answer, NoRejection>>) -> bool {
  let result = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
    answer,
    signatureResult,
  )
  if let Option<Shared<Type>>.Some {value} = move result {
    return Shared.with<Type, bool>(&value, isI32)
  }
  return false
}

pub fn reads(events: &[SourceEvent], module: &ModuleId) -> usize {
  let mut count = usize.ZERO
  let mut at = usize.ZERO
  while at < events.length {
    if events[at].kind == SourceEventKind.SourceRead && ModuleId.equals(&events[at].module, module) {
      count = count + usize.ONE
    }
    at = at + usize.ONE
  }
  return count
}

pub fn starts(events: &[SemanticEvent], family: Family) -> usize {
  let mut count = usize.ZERO
  let mut at = usize.ZERO
  while at < events.length {
    if events[at].kind == EventKind.Start && events[at].family == family {
      count = count + usize.ONE
    }
    at = at + usize.ONE
  }
  return count
}

pub fn hits(events: &[SemanticEvent], family: Family) -> usize {
  let mut count = usize.ZERO
  let mut at = usize.ZERO
  while at < events.length {
    if events[at].kind == EventKind.Hit && events[at].family == family {
      count = count + usize.ONE
    }
    at = at + usize.ONE
  }
  return count
}

pub fn reused(events: &[SemanticEvent]) -> usize {
  let mut count = usize.ZERO
  let mut at = usize.ZERO
  while at < events.length {
    if events[at].kind == EventKind.Reuse && events[at].family == Family.Body {
      count = count + usize.ONE
    }
    at = at + usize.ONE
  }
  return count
}

pub effect fn module(path: string) -> ModuleId ! InvalidModulePath | OutOfMemoryError ? &mut Allocator {
  return run ModuleId.make(b"memory", b"example", String.utf8Bytes(path))
}

pub effect fn present(text: string) -> Option<Bytes> ! OutOfMemoryError ? &mut Allocator {
  return Option.some<Bytes>(run Bytes.copy(String.utf8Bytes(text)))
}

pub fn onSignature(answer: &Result<Answer, NoRejection>, check: fn(&Signature) -> bool) -> bool {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Signature {signature}} => check(&signature)
      _ => false
    }
    Result<Answer, NoRejection>.Failure {error: _} => false
  }
}

pub effect fn rowsEqual(left: &Shared<Row>, right: &Shared<Row>) -> bool
! OutOfMemoryError
? &mut Allocator {
  return run Row.equalsShared(left, right)
}

pub fn rowSize(row: &Shared<Row>) -> usize {
  return Shared.with<Row, usize>(
    row,
    fn(value: &Row) -> usize {
      return Vector.length<Requirement>(&value.entries) + Vector.length(&value.parameters)
    },
  )
}

pub fn failureOf(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Signature {signature}} => Option.some<Shared<Type>>(
        Shared.clone<Type>(&signature.failure),
      )
      _ => Option.none<Shared<Type>>()
    }
    Result<Answer, NoRejection>.Failure {error: _} => Option.none<Shared<Type>>()
  }
}

pub effect fn channelsEqual(
  failure: Option<Shared<Type>>,
  requirements: Option<Shared<Row>>,
  otherFailure: Option<Shared<Type>>,
  otherRequirements: Option<Shared<Row>>,
) -> bool ! OutOfMemoryError ? &mut Allocator {
  if !run typesEqual(move failure, move otherFailure) {
    return false
  }
  if let Option<Shared<Row>>.Some {value: row} = move requirements {
    if let Option<Shared<Row>>.Some {value: otherRow} = move otherRequirements {
      return run rowsEqual(&row, &otherRow)
    }
  }
  return false
}

pub fn effectFailure(value: &Type) -> Option<Shared<Type>> {
  return match & value.* {
    Type.Effect {failure, ..} => Option.some<Shared<Type>>(Shared.clone<Type>(&failure))
    _ => Option.none<Shared<Type>>()
  }
}

pub fn effectSuccess(value: &Type) -> Option<Shared<Type>> {
  return match & value.* {
    Type.Effect {success, ..} => Option.some<Shared<Type>>(Shared.clone<Type>(&success))
    _ => Option.none<Shared<Type>>()
  }
}

pub fn effectRequirements(value: &Type) -> Option<Shared<Row>> {
  return match & value.* {
    Type.Effect {requirements, ..} => Option.some<Shared<Row>>(Shared.clone<Row>(&requirements))
    _ => Option.none<Shared<Row>>()
  }
}

pub fn effectEnvironment(value: &Type) -> Option<Shared<Intersection>> {
  return match & value.* {
    Type.Effect {environment, ..} => Option.some<Shared<Intersection>>(
      Shared.clone<Intersection>(&environment),
    )
    _ => Option.none<Shared<Intersection>>()
  }
}

pub fn modeOf(value: &Type) -> usize {
  let mode = match & value.* {
    Type.Callable {mode, ..} => mode
    Type.Effect {mode, ..} => mode
    _ => {
      return usize.ZERO
    }
  }
  return match mode {
    CallableMode.Shared => usize.ONE
    CallableMode.Mutable => 2
    CallableMode.Once => 3
  }
}

pub fn firstParameterMode(signature: &Signature) -> usize {
  if let Option<Shared<Type>>.Some {value} = move parameterContractAt(signature, usize.ZERO) {
    return Shared.with<Type, usize>(&value, modeOf)
  }
  return usize.ZERO
}

pub fn environmentWith(first: &Intersection, right: &Shared<Intersection>) -> bool {
  return Shared.with<Intersection, bool>(
    right,
    fn(second: &Intersection) -> bool {
      return Intersection.equals(first, second)
    },
  )
}

// The consumed and returned Effects hold distinct environment handles.
pub fn environmentsEqual(left: &Shared<Intersection>, right: &Shared<Intersection>) -> bool {
  return Shared.with<Intersection, bool>(
    left,
    fn(first: &Intersection) -> bool {
      return environmentWith(first, right)
    },
  )
}

pub fn rowBinderAndConsumed(signature: &Signature) -> bool {
  return Vector.length(&signature.rowParameters) == usize.ONE && firstParameterMode(signature) == 3
}

pub effect fn environmentsSame(left: &Shared<Type>, right: &Shared<Type>) -> bool
! OutOfMemoryError
? &mut Allocator {
  let first = Shared.with<Type, Option<Shared<Intersection>>>(left, effectEnvironment)
  let second = Shared.with<Type, Option<Shared<Intersection>>>(right, effectEnvironment)
  if let Option<Shared<Intersection>>.Some {value: from} = move first {
    if let Option<Shared<Intersection>>.Some {value: to} = move second {
      return environmentsEqual(&from, &to)
    }
  }
  return false
}

// Mode aside, the consumed parameter and the returned Effect share environment and channels.
pub effect fn sharesEffectParts(input: &Shared<Type>, output: &Shared<Type>) -> bool
! OutOfMemoryError
? &mut Allocator {
  if !run environmentsSame(input, output) {
    return false
  }
  let success = Shared.with<Type, Option<Shared<Type>>>(input, effectSuccess)
  let otherSuccess = Shared.with<Type, Option<Shared<Type>>>(output, effectSuccess)
  if !run typesEqual(move success, move otherSuccess) {
    return false
  }
  let row = Shared.with<Type, Option<Shared<Row>>>(input, effectRequirements)
  if let Option<Shared<Row>>.Some {value: requirements} = &row {
    if rowSize(&requirements) != usize.ONE {
      return false
    }
  }
  if !run channelsEqual(
    Shared.with<Type, Option<Shared<Type>>>(input, effectFailure),
    move row,
    Shared.with<Type, Option<Shared<Type>>>(output, effectFailure),
    Shared.with<Type, Option<Shared<Row>>>(output, effectRequirements),
  ) {
    return false
  }
  return !run Type.equalsShared(input, output)
}

pub fn rejectsAt(answer: &Shared<Result<Answer, NoRejection>>, code: RejectionCode) -> bool {
  return Shared.with<Result<Answer, NoRejection>, bool>(
    answer,
    fn(value: &Result<Answer, NoRejection>) -> bool {
      return rejectedTypeApplication(value, code)
    },
  )
}

// A rejection with `code` whatever its anchor, as for an identity with no written site left.
pub fn rejectsWith(answer: &Shared<Result<Answer, NoRejection>>, code: RejectionCode) -> bool {
  let found = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(answer, rejection)
  if let Option<Shared<Rejection>>.Some {value} = move found {
    return Shared.with<Rejection, bool>(
      &value,
      fn(diagnostic: &Rejection) -> bool {
        return diagnostic.code == code
      },
    )
  }
  return false
}

pub fn staticSignatureEnvironment(signature: &Signature) -> bool {
  return match & signature.environment {
    Option<Intersection>.Some {value} => Vector.length(&value.members) == usize.ZERO
    Option<Intersection>.None => false
  }
}

pub fn staticEnvironment(answer: &Result<Answer, NoRejection>) -> bool {
  return onSignature(answer, staticSignatureEnvironment)
}

pub effect fn preserved(answer: &Shared<Result<Answer, NoRejection>>) -> bool
! OutOfMemoryError
? &mut Allocator {
  let shape = Shared.with<Result<Answer, NoRejection>, bool>(
    answer,
    fn(value: &Result<Answer, NoRejection>) -> bool {
      return onSignature(value, rowBinderAndConsumed)
    },
  )
  // An Effect parameter is an exact representation slot whose bound keeps the written contract.
  let input = contractSlotOf(answer, usize.ZERO)
  let output = slotOf(answer, usize.MAX)
  if let Option<Shared<Type>>.Some {value: from} = move input {
    if let Option<Shared<Type>>.Some {value: to} = move output {
      return shape && run sharesEffectParts(&from, &to)
    }
  }
  return false
}

pub fn rowCountIs(answer: &Result<Answer, NoRejection>, expected: usize) -> bool {
  return onSignature(
    answer,
    fn(signature: &Signature) -> bool {
      return rowSize(&signature.requirements) == expected
    },
  )
}

// The byte offset of the zero-based `occurrence` of `needle` in `text`; `usize.MAX` when absent.
pub fn offsetOf(text: string, needle: string, occurrence: usize) -> usize {
  let haystack = String.utf8Bytes(text)
  let wanted = String.utf8Bytes(needle)
  let mut seen = usize.ZERO
  let mut at = usize.ZERO
  while at + wanted.length <= haystack.length {
    let mut matched = true
    let mut inner = usize.ZERO
    while inner < wanted.length {
      if haystack[at + inner] != wanted[inner] {
        matched = false
      }
      inner = inner + usize.ONE
    }
    if matched {
      if seen == occurrence {
        return at
      }
      seen = seen + usize.ONE
    }
    at = at + usize.ONE
  }
  return usize.MAX
}

// A completed rejection with `code` whose nonempty span starts at `start`.
pub fn rejectsFrom(answer: &Shared<Result<Answer, NoRejection>>, code: RejectionCode, start: usize) -> bool {
  let found = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(answer, rejection)
  if let Option<Shared<Rejection>>.Some {value} = move found {
    return Shared.with<Rejection, bool>(
      &value,
      fn(diagnostic: &Rejection) -> bool {
        return diagnostic.code == code && diagnostic.span.start == start && diagnostic.span.end > start
      },
    )
  }
  return false
}

// A rejection at the exact authored occurrence of `spelling`, including both boundaries.
pub fn rejectsSpan(
  answer: &Shared<Result<Answer, NoRejection>>,
  code: RejectionCode,
  text: string,
  spelling: string,
  occurrence: usize,
) -> bool {
  let start = offsetOf(text, spelling, occurrence)
  if start == usize.MAX { return false }
  let end = start + String.utf8Bytes(spelling).length
  let found = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(answer, rejection)
  if let Option<Shared<Rejection>>.Some {value} = move found {
    return Shared.with<Rejection, bool>(&value, fn(diagnostic: &Rejection) -> bool {
      return diagnostic.code == code && diagnostic.span.start == start && diagnostic.span.end == end
    })
  }
  return false
}

pub fn rejectsRelated(answer: &Shared<Result<Answer, NoRejection>>, code: RejectionCode, start: usize, earlier: usize) -> bool {
  let found = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(answer, rejection)
  if let Option<Shared<Rejection>>.Some {value} = move found {
    return Shared.with<Rejection, bool>(&value, fn(diagnostic: &Rejection) -> bool {
      if diagnostic.code != code || diagnostic.span.start != start { return false }
      return match &diagnostic.related {
        Option<RelatedSite>.Some {value: site} => ModuleId.equals(&site.module, &diagnostic.module)
          && site.span.start == earlier && site.span.end > earlier
        Option<RelatedSite>.None => false
      }
    })
  }
  return false
}

pub fn ownBinder(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Signature {signature}} => {
        let binders = Vector.asSlice<Shared<Type>>(&signature.typeParameters)
        if binders.length == usize.ONE {
          return Option.some<Shared<Type>>(Shared.clone<Type>(&binders[usize.ZERO]))
        }
        return Option.none<Shared<Type>>()
      }
      _ => Option.none<Shared<Type>>()
    }
    Result<Answer, NoRejection>.Failure {error: _} => Option.none<Shared<Type>>()
  }
}

pub fn referentOf(value: Option<Shared<Type>>) -> Option<Shared<Type>> {
  if let Option<Shared<Type>>.Some {value: resolved} = move value {
    return Shared.with<Type, Option<Shared<Type>>>(
      &resolved,
      fn(node: &Type) -> Option<Shared<Type>> {
        return match & node.* {
          Type.Reference {referent, ..} => Option.some<Shared<Type>>(Shared.clone<Type>(&referent))
          _ => Option.none<Shared<Type>>()
        }
      },
    )
  }
  return Option.none<Shared<Type>>()
}

pub fn headCount(answer: &Result<Answer, NoRejection>) -> usize {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Implementations {heads}} => Vector.length(&heads)
      _ => usize.MAX
    }
    Result<Answer, NoRejection>.Failure {error: _} => usize.MAX
  }
}

pub fn headAt(answer: &Shared<Result<Answer, NoRejection>>, at: usize) -> Option<Shared<ImplementationHead>> {
  return Shared.with<Result<Answer, NoRejection>, Option<Shared<ImplementationHead>>>(
    answer,
    fn(value: &Result<Answer, NoRejection>) -> Option<Shared<ImplementationHead>> {
      return match & value.* {
        Result<Answer, NoRejection>.Success {value: found} => match & found.outcome {
          Outcome.Success {value: Value.Implementations {heads}} => {
            let listed = Vector.asSlice<Shared<ImplementationHead>>(&heads)
            if at < listed.length {
              return Option.some<Shared<ImplementationHead>>(
                Shared.clone<ImplementationHead>(&listed[at]),
              )
            }
            return Option.none<Shared<ImplementationHead>>()
          }
          _ => Option.none<Shared<ImplementationHead>>()
        }
        Result<Answer, NoRejection>.Failure {error: _} => Option.none<Shared<ImplementationHead>>()
      }
    },
  )
}

pub fn hasKind(declaration: &DeclarationId, kind: OwnerKind) -> bool {
  return match kind {
    OwnerKind.Function => match DeclarationId.kind(declaration) {
      OwnerKind.Function => true
      _ => false
    }
    OwnerKind.Implementation => match DeclarationId.kind(declaration) {
      OwnerKind.Implementation => true
      _ => false
    }
    OwnerKind.Struct => match DeclarationId.kind(declaration) {
      OwnerKind.Struct => true
      _ => false
    }
    OwnerKind.Tuple => match DeclarationId.kind(declaration) {
      OwnerKind.Tuple => true
      _ => false
    }
    OwnerKind.Enumeration => match DeclarationId.kind(declaration) {
      OwnerKind.Enumeration => true
      _ => false
    }
    OwnerKind.Union => match DeclarationId.kind(declaration) {
      OwnerKind.Union => true
      _ => false
    }
    OwnerKind.Interface => match DeclarationId.kind(declaration) {
      OwnerKind.Interface => true
      _ => false
    }
    OwnerKind.Service => match DeclarationId.kind(declaration) {
      OwnerKind.Service => true
      _ => false
    }
    _ => false
  }
}

// The identity a caller holding the module's source index addresses: the `occurrence`th
// declaration of `kind` in source order, named `name` unless `name` is empty.
// Reuse one parsed source index across every identity addressed by a fixture revision.
pub effect fn indexedIdentity(
  index: &mut SourceIndex,
  module: &ModuleId,
  kind: OwnerKind,
  name: &[u8],
  occurrence: usize,
) -> Option<DeclarationId> ! Cycle | OutOfMemoryError ? &mut Allocator {
  let answer = run SourceIndex.demand(&mut index.*, module)
  if let Option<&IndexedSource>.Some {value} = move SourceIndex.source(&index.*, &answer, module) {
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(value))
    let mut seen = usize.ZERO
    let mut at = usize.ZERO
    while at < declarations.length {
      let identity = &declarations[at].identity
      if hasKind(identity, kind) && (name.length == usize.ZERO || DeclarationId.named(identity, name)) {
        if seen == occurrence {
          return Option.some<DeclarationId>(run DeclarationId.copy(identity))
        }
        seen = seen + usize.ONE
      }
      at = at + usize.ONE
    }
  }
  return Option.none<DeclarationId>()
}

pub effect fn requireIndexedIdentity(
  index: &mut SourceIndex,
  module: &ModuleId,
  kind: OwnerKind,
  name: &[u8],
  occurrence: usize,
) -> DeclarationId ! Cycle | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let found = run indexedIdentity(&mut index.*, module, kind, name, occurrence)
  if let Option<DeclarationId>.Some {value} = move found {
    return move value
  }
  run Testing.expect(false, "the fixture declares the addressed declaration")
  return run requireIndexedIdentity(&mut index.*, module, kind, name, occurrence)
}

// The signature of the `occurrence`th function named `name`, addressed by its identity.
pub effect fn signatureNamed(
  semantic: &mut Semantic,
  request: &mut Request,
  index: &mut SourceIndex,
  module: &ModuleId,
  name: &[u8],
  occurrence: usize,
) -> Shared<Result<Answer, NoRejection>>
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator {
  let identity = run requireIndexedIdentity(&mut index.*, module, OwnerKind.Function, name, occurrence)
  return run Semantic.demandSignatureOf(&mut semantic.*, &mut request.*, &identity)
}

pub fn contractOf(head: &Option<Shared<ImplementationHead>>) -> Option<Shared<Type>> {
  if let Option<Shared<ImplementationHead>>.Some {value} = &head.* {
    return Shared.with<ImplementationHead, Option<Shared<Type>>>(
      &value,
      fn(found: &ImplementationHead) -> Option<Shared<Type>> {
        if let Option<Shared<Type>>.Some {value: contract} = &found.contract {
          return Option.some<Shared<Type>>(Shared.clone<Type>(&contract))
        }
        return Option.none<Shared<Type>>()
      },
    )
  }
  return Option.none<Shared<Type>>()
}

pub fn witnessPrimitive(ty: &Type, spelling: &[u8]) -> bool {
  return match &ty.* { Type.Primitive {name} => sameBytes(Bytes.asSlice(&name), spelling) _ => false }
}

pub struct WitnessCallInputs {
  pub contract: Shared<Type>
  pub provider: Shared<Type>
  pub selected: bool
  pub span: Span
}

pub fn witnessCallInputs(answer: &Result<Answer, NoRejection>) -> Option<WitnessCallInputs> {
  let body = checkedBody(answer)
  if let Option<Shared<TypedBody>>.Some {value} = move body {
    return Shared.with<TypedBody, Option<WitnessCallInputs>>(&value,
      fn(typed: &TypedBody) -> Option<WitnessCallInputs> {
        let nodes = TypedBody.nodeSlice(typed)
        let mut at = usize.ZERO
        while at < nodes.length {
          if let BodyNodeKind.Expression {form: BodyExpression.InterfaceCall {contract, provider, implementation, ..}, ..} = &nodes[at].kind {
            let selected = match &implementation { Option<Shared<DeclarationId>>.Some {..} => true _ => false }
            return Option.some<WitnessCallInputs>(WitnessCallInputs {
              contract: Shared.clone<Type>(&contract), provider: Shared.clone<Type>(&provider),
              selected: selected, span: nodes[at].origin.span,
            })
          }
          at = at + usize.ONE
        }
        return Option.none<WitnessCallInputs>()
      })
  }
  return Option.none<WitnessCallInputs>()
}

pub fn validityIsStatic(value: &Lifetime) -> bool { return match &value.* { Lifetime.Static => true _ => false } }

pub fn signatureRequirements(answer: &Result<Answer, NoRejection>) -> Option<Shared<Row>> {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Signature {signature}} = &value.outcome {
      return Option.some<Shared<Row>>(Shared.clone<Row>(&signature.requirements))
    }
  }
  return Option.none<Shared<Row>>()
}

// Whether an answer succeeded with a value. An Unsupported gap is not a success: it names work the
// compiler has not done, so a success claim must fail on it.
pub fn succeeded(answer: &Shared<Result<Answer, NoRejection>>) -> bool {
  return Shared.with<Result<Answer, NoRejection>, bool>(
    answer,
    fn(resolved: &Result<Answer, NoRejection>) -> bool {
      return match & resolved.* {
        Result<Answer, NoRejection>.Success {value} => match & value.outcome {
          Outcome.Success {value: Value.Unsupported {..}} => false
          Outcome.Success {value: _} => true
          Outcome.Rejected {diagnostic: _} => false
        }
        Result<Answer, NoRejection>.Failure {error: _} => false
      }
    },
  )
}

pub fn sameMagnitude(value: u64, digits: &[u8]) -> bool {
  if value == 0 { return digits.length == usize.ONE && digits[0] == 48 }
  let mut remaining = value
  let mut at = digits.length
  while remaining > 0 {
    if at == usize.ZERO { return false }
    at = at - usize.ONE
    if digits[at] != u64.toU8(48 + u64.remainder(remaining, 10)) { return false }
    remaining = u64.divide(remaining, 10)
  }
  return at == usize.ZERO
}

pub fn constantInteger(answer: &Result<Answer, NoRejection>, digits: &[u8]) -> bool {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Initializer {value: found}} => Shared.with<StaticData, bool>(
        &found,
        fn(constant: &StaticData) -> bool {
          return match & constant.* {
            StaticData.Integer {sign, magnitude, ..} => sign == StaticSign.Positive && sameMagnitude(magnitude, digits)
            _ => false
          }
        },
      )
      _ => false
    }
    Result<Answer, NoRejection>.Failure {error: _} => false
  }
}

pub fn constantText(answer: &Result<Answer, NoRejection>, expected: &[u8]) -> bool {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Initializer {value: found}} => Shared.with<StaticData, bool>(
        &found,
        fn(constant: &StaticData) -> bool {
          return match & constant.* {
            StaticData.Text {bytes} => sameBytes(Bytes.asSlice(&bytes), expected)
            _ => false
          }
        },
      )
      _ => false
    }
    Result<Answer, NoRejection>.Failure {error: _} => false
  }
}

pub fn nominalType(value: &Type) -> bool {
  return match & value.* {
    Type.Nominal {..} => true
    _ => false
  }
}

pub effect fn specializationOf(declaration: &DeclarationId, argument: &Shared<Type>) -> SpecializationApplication
! OutOfMemoryError ? &mut Allocator {
  let mut arguments = Vector.make<Argument>()
  run Vector.append<Argument>(&mut arguments, Argument.Type {value: Shared.clone<Type>(argument)})
  return run specializationWithArguments(declaration, move arguments)
}

pub effect fn specializationWithArguments(declaration: &DeclarationId, arguments: Vector<Argument>) -> SpecializationApplication
! OutOfMemoryError ? &mut Allocator {
  return SpecializationApplication {
    target: SpecializationTarget.Named {declaration: run DeclarationId.copy(declaration)},
    argumentOrdinals: run SpecializationApplication.denseOrdinals(Vector.length<Argument>(&arguments)),
    scopes: Vector.make<ScopeBinding>(),
    arguments: move arguments,
    statics: Vector.make<StaticSlot>(),
  }
}

pub effect fn specializationPrimitive(name: &[u8]) -> Shared<Type> ! OutOfMemoryError ? &mut Allocator {
  return run Shared.make<Type>(Type.Primitive {name: run Bytes.copy(name)})
}

pub effect fn specializationNominal(declaration: &DeclarationId, arguments: Vector<Argument>) -> Shared<Type>
! OutOfMemoryError ? &mut Allocator {
  return run Shared.make<Type>(Type.Nominal {
    declaration: run DeclarationId.copy(declaration), isPublic: false, arguments: move arguments,
  })
}

pub effect fn specializationParameter(declaration: &DeclarationId, ordinal: usize) -> Shared<Type>
! OutOfMemoryError ? &mut Allocator {
  return run Shared.make<Type>(Type.Parameter {declaration: run DeclarationId.copy(declaration), ordinal: ordinal})
}

pub effect fn environmentReference(region: &Shared<Lifetime>) -> Shared<Type>
! OutOfMemoryError ? &mut Allocator {
  return run Shared.make<Type>(Type.Reference {referent: run specializationPrimitive(b"i32"),
    access: Access.Shared, lifetime: Shared.clone<Lifetime>(region)})
}

// Whether a build stops at exactly one foreign-contract gap anchored at `start`.
pub fn foreignContractGapAt(built: &BackendBuild, start: usize) -> bool {
  if let BackendBuild.Unsupported {gaps} = &built.* {
    let entries = Vector.asSlice<Shared<BackendGap>>(&gaps)
    if entries.length != usize.ONE { return false }
    return Shared.with<BackendGap, bool>(&entries[usize.ZERO], fn(gap: &BackendGap) -> bool {
      return gap.code == GapCode.ForeignContract && BackendGap.span(gap).start == start
    })
  }
  return false
}

// U6: sealed static-text primitives retain byte semantics independently of source wrappers.
pub fn staticTextBytesAre(value: &StaticData, expected: &[u8]) -> bool {
  return match & value.* {
    StaticData.Text {bytes} => sameBytes(Bytes.asSlice(&bytes), expected)
    _ => false
  }
}

pub fn dependencyCount(answer: &Result<Answer, NoRejection>) -> usize {
  return match &answer.* {
    Result<Answer, NoRejection>.Success {value} => Vector.length<Dependency>(&value.dependencies)
    Result<Answer, NoRejection>.Failure {error: _} => usize.ZERO
  }
}

pub fn dependencyAt(answer: &Result<Answer, NoRejection>, at: usize) -> Option<Dependency> {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    return Option.some<Dependency>(Vector.get<Dependency>(&value.dependencies, at))
  }
  return Option.none<Dependency>()
}

pub fn selectedMirIndex(answer: &Result<Answer, NoRejection>) -> Option<usize> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Mir {index}} => Option.some<usize>(index)
      _ => Option.none<usize>()
    }
    Result<Answer, NoRejection>.Failure {error: _} => Option.none<usize>()
  }
}

pub fn selectedLayoutIndex(answer: &Result<Answer, NoRejection>) -> Option<usize> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Layout {index}} => Option.some<usize>(index)
      _ => Option.none<usize>()
    }
    Result<Answer, NoRejection>.Failure {error: _} => Option.none<usize>()
  }
}

pub fn pipelineHasMir(answer: &Result<Answer, NoRejection>) -> bool {
  return match move selectedMirIndex(answer) {
    Option<usize>.Some {..} => true
    Option<usize>.None => false
  }
}

pub fn containsIr(text: &[u8], needle: &[u8]) -> bool {
  if needle.length > text.length {
    return false
  }
  let mut start = usize.ZERO
  while start + needle.length <= text.length {
    let mut at = usize.ZERO
    while at < needle.length && text[start + at] == needle[at] {
      at = at + usize.ONE
    }
    if at == needle.length {
      return true
    }
    start = start + usize.ONE
  }
  return false
}

pub fn variadicOperandLocal(operand: &MirOperand) -> usize {
  if let MirOperand.Copy {place} = &operand.* {
    if Vector.length<MirProjection>(&place.projections) == usize.ZERO { return place.local }
  }
  if let MirOperand.Move {place} = &operand.* {
    if Vector.length<MirProjection>(&place.projections) == usize.ZERO { return place.local }
  }
  return usize.MAX
}

pub fn variadicStatementLocal(statement: &MirStatement) -> usize {
  return match &statement.* {
    MirStatement.Assign {destination, ..} => destination.local
    MirStatement.Drop {destination, ..} => destination.local
    MirStatement.FailureContext {destination, ..} => destination.local
  }
}

// Authenticate the complete copy chain, including unchanged parameter roots.
pub fn variadicParameter(function: &MirFunction, start: usize, parameter: usize) -> bool {
  let locals = Vector.asSlice<MirLocal>(&function.locals)
  let blocks = Vector.asSlice<MirBlock>(&function.blocks)
  let mut local = start
  let mut steps = usize.ZERO
  while local < locals.length && steps < locals.length {
    let mut source = usize.MAX
    let mut writers = usize.ZERO
    let mut at = usize.ZERO
    while at < blocks.length {
      let statements = Vector.asSlice<MirStatement>(&blocks[at].statements)
      let mut item = usize.ZERO
      while item < statements.length {
        if variadicStatementLocal(&statements[item]) == local {
          writers = writers + usize.ONE
          match &statements[item] {
            MirStatement.Assign {destination, value: MirRvalue.Use {value}, ..} => {
              if Vector.length<MirProjection>(&destination.projections) != usize.ZERO { return false }
              source = variadicOperandLocal(&value)
              if source == usize.MAX { return false }
            }
            _ => { return false }
          }
        }
        item = item + usize.ONE
      }
      if let MirTerminator.Call {destination, failure, ..} = &blocks[at].terminator {
        if destination.local == local { return false }
        if let Option<MirFailureEdge>.Some {value} = &failure {
          if value.destination.local == local { return false }
        }
      }
      at = at + usize.ONE
    }
    if let MirLocalKind.Parameter {index} = &locals[local].kind { return writers == usize.ZERO && index == parameter }
    if writers != usize.ONE { return false }
    local = source
    steps = steps + usize.ONE
  }
  return false
}

pub fn mirProjectionIsDeref(projection: &MirProjection) -> bool {
  return match &projection.* {
    MirProjection.Deref => true
    _ => false
  }
}

pub fn receiverReferenceRegion(input: &Type) -> Option<Shared<Lifetime>> {
  return match &input.* {
    Type.Reference {lifetime, ..} => Option.some<Shared<Lifetime>>(Shared.clone<Lifetime>(&lifetime))
    _ => Option.none<Shared<Lifetime>>()
  }
}

pub fn directCallNode(body: &TypedBody, ordinal: usize) -> Option<BodyNodeId> {
  let nodes = TypedBody.nodeSlice(body)
  let mut found = usize.ZERO
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {form: BodyExpression.DirectCall {..}, ..} = &nodes[at].kind {
      if found == ordinal {
        return Option.some<BodyNodeId>(BodyNodeId {index: at})
      }
      found = found + usize.ONE
    }
    at = at + usize.ONE
  }
  return Option.none<BodyNodeId>()
}

pub effect fn directApplicationAt(answer: &Shared<Result<Answer, NoRejection>>, ordinal: usize) -> Option<
  SpecializationApplication,
> ! OutOfMemoryError ? &mut Allocator {
  let selected = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(
    answer,
    checkedBody,
  )
  if let Option<Shared<TypedBody>>.Some {value: body} = move selected {
    let node = Shared.with<TypedBody, Option<BodyNodeId>>(
      &body,
      fn(value: &TypedBody) -> Option<BodyNodeId> {
        return directCallNode(value, ordinal)
      },
    )
    if let Option<BodyNodeId>.Some {value} = move node {
      let found = TypedBody.directApplication(&body, value)
      if let Option<Shared<SpecializationApplication>>.Some {value: application} = move found {
        return Option.some<SpecializationApplication>(
          run SpecializationApplication.copyShared(&application),
        )
      }
    }
  }
  return Option.none<SpecializationApplication>()
}

pub fn applicationArgumentIs(argument: &Argument, spelling: &[u8]) -> bool {
  return match & argument.* {
    Argument.Type {value} => Shared.with<Type, bool>(
      &value,
      fn(ty: &Type) -> bool {
        return witnessPrimitive(ty, spelling)
      },
    )
    _ => false
  }
}

pub fn containsIrLine(text: &[u8], operation: &[u8], guarantee: &[u8]) -> bool {
  let mut start = usize.ZERO
  while start < text.length {
    let mut end = start
    while end < text.length && text[end] != 10 {
      end = end + usize.ONE
    }
    let line = Slice.view<u8>(text, start, end - start)
    if containsIr(line, operation) && containsIr(line, guarantee) {
      return true
    }
    start = end + usize.ONE
  }
  return false
}

pub fn bodyRetainsPointerWeaken(answer: &Result<Answer, NoRejection>) -> bool {
  if let Option<Shared<TypedBody>>.Some {value: body} = move checkedBody(answer) {
    return Shared.with<TypedBody, bool>(&body, fn(checked: &TypedBody) -> bool {
      let nodes = TypedBody.nodeSlice(checked)
      let mut at = usize.ZERO
      while at < nodes.length {
        if let BodyNodeKind.Expression {ty, form: BodyExpression.PointerWeaken {value: source}} = &nodes[at].kind {
          if source.index < nodes.length {
            let shared = Shared.with<Type, bool>(&ty, pointerHasSharedAccess)
            if let BodyNodeKind.Expression {ty: original, ..} = &nodes[source.index].kind {
              if shared && Shared.with<Type, bool>(&original, pointerHasMutableAccess) { return true }
            }
          }
        }
        at = at + usize.ONE
      }
      return false
    })
  }
  return false
}

pub fn pointerHasSharedAccess(value: &Type) -> bool {
  return match &value.* { Type.Pointer {access, ..} => access == Access.Shared _ => false }
}

pub fn pointerHasMutableAccess(value: &Type) -> bool {
  return match &value.* { Type.Pointer {access, ..} => access == Access.Mutable _ => false }
}

pub effect fn emitClosedMir(function: &MirFunction, target: &MachineTarget, layouts: &[TypeLayout], foreign: &[CAbi.Signature]) -> Bytes
! BackendGap | OutOfMemoryError ? &mut Allocator {
  let mut coordinates = RuntimeEncoding.coordinates()
  let recipe = run InstanceRecipe.make(function)
  let encoded = run InstanceText.encodings(&recipe, &mut coordinates)
  let identities = run InstanceText.identities(&recipe, Vector.asSlice<Bytes>(&encoded))
  return run LlvmText.emit(
    function,
    target,
    layouts,
    foreign,
    Vector.asSlice<InstanceIdentity>(&identities),
  )
}

pub fn genericUniqueSymbolDefinition(text: &[u8], symbol: &[u8]) -> bool {
  let mut at = usize.ZERO
  let mut begin = usize.ZERO
  let mut found = false
  while at <= text.length {
    if at == text.length || text[at] == 10 {
      let line = Slice.view<u8>(text, begin, at - begin)
      if containsIr(line, b"define ") && containsIr(line, symbol) {
        if found { return false }
        found = true
      }
      begin = at + usize.ONE
    }
    at = at + usize.ONE
  }
  return found
}

// These closed actor graphs avoid reparsing a source program for graph-algorithm claims.
// Each label comes from production MIR encoding; no test-authored expected identity bytes exist.
// A `'static` and a caller-local region select distinct canonical instances of one function.
pub effect fn recipeControlKey(id: &ModuleId, name: &[u8], lasting: bool) -> InstanceKey
! CanonicalizationFailure | OutOfMemoryError ? &mut Allocator {
  let mut owners = Vector.make<OwnerStep>()
  run Vector.append<OwnerStep>(&mut owners, OwnerStep {kind: OwnerKind.Function,
    name: Option.some<Bytes>(run Bytes.copy(name)), occurrence: usize.ZERO})
  let declaration = run DeclarationId.fromParts(run ModuleId.copy(id), move owners)
  let mut lifetime = run Shared.make<Lifetime>(Lifetime.Local {declaration: run DeclarationId.copy(&declaration), ordinal: usize.ZERO})
  if lasting { lifetime = run Shared.make<Lifetime>(Lifetime.Static) }
  let mut arguments = Vector.make<Argument>()
  run Vector.append<Argument>(&mut arguments, Argument.Lifetime {value: move lifetime})
  return run requiredCanonicalKey(run InstanceKey.function(run specializationWithArguments(&declaration, move arguments)))
}

pub effect fn recipeControlMir(key: &InstanceKey, callees: &[InstanceKey], constant: Option<bool>, checked: bool) -> MirFunction
! OutOfMemoryError ? &mut Allocator {
  let unit = run Shared.make<Type>(Type.Unit)
  let boolean = run specializationPrimitive(b"bool")
  let origin = BodyOrigin {syntax: HirId {index: usize.ZERO}, span: Span.make(usize.ZERO, usize.ONE)}
  let mut locals = Vector.make<MirLocal>()
  run Vector.append<MirLocal>(&mut locals, MirLocal {ty: Shared.clone<Type>(&unit), kind: MirLocalKind.Return, origin: origin})
  run Vector.append<MirLocal>(&mut locals, MirLocal {ty: move boolean, kind: MirLocalKind.Temp, origin: origin})
  let mut blocks = Vector.make<MirBlock>()
  let mut at = usize.ZERO
  while at < callees.length {
    run Vector.append<MirBlock>(&mut blocks, MirBlock {statements: Vector.make<MirStatement>(),
      terminator: MirTerminator.Call {callee: MirCallee.Instance {key: InstanceKey.copy(&callees[at])},
        arguments: Vector.make<MirOperand>(), providers: Vector.make<MirOperand>(), diagnostics: Option.none<MirDiagnostics>(),
        destination: MirPlace {local: usize.ZERO, projections: Vector.make<MirProjection>()},
        normal: at + usize.ONE, failure: Option.none<MirFailureEdge>(), origin: origin}})
    at = at + usize.ONE
  }
  let mut statements = Vector.make<MirStatement>()
  if let Option<bool>.Some {value} = move constant {
    run Vector.append<MirStatement>(&mut statements, MirStatement.Assign {
      destination: MirPlace {local: usize.ONE, projections: Vector.make<MirProjection>()},
      value: MirRvalue.Use {value: MirOperand.Boolean {value: value}}, origin: origin})
  }
  run Vector.append<MirBlock>(&mut blocks, MirBlock {statements: move statements, terminator: MirTerminator.Return {origin: origin}})
  return MirFunction {key: InstanceKey.copy(key), safetyChecked: checked, result: move unit,
    parameters: Vector.make<Shared<Type>>(), locals: move locals, blocks: move blocks,
    references: Vector.make<MirReference>(), externs: Vector.make<Shared<DeclarationId>>(), observes: false,
    contexts: Vector.make<MirContextText>(), suspension: Option.none<BodyOrigin>()}
}

pub effect fn recipeIdentityAt(plan: &EmissionPlan, key: &InstanceKey) -> usize
! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let found = run EmissionPlan.lookup(plan, key)
  if let Option<usize>.Some {value} = move found { return value }
  run Testing.expect(false, "the completed plan resolves every exact graph key")
  return usize.ZERO
}

// Fixture construction retains the real typed refusal; no incomplete key is available to assert on.
pub effect fn requiredCanonicalKey(result: Result<InstanceKey, CanonicalizationFailure>) -> InstanceKey
! CanonicalizationFailure {
  return match move result {
    Result<InstanceKey, CanonicalizationFailure>.Success {value} => move value
    Result<InstanceKey, CanonicalizationFailure>.Failure {error} => { fail error }
  }
}

pub effect fn requiredCanonicalGlue(result: Result<Option<InstanceKey>, CanonicalizationFailure>) -> Option<InstanceKey>
! CanonicalizationFailure {
  return match move result {
    Result<Option<InstanceKey>, CanonicalizationFailure>.Success {value} => move value
    Result<Option<InstanceKey>, CanonicalizationFailure>.Failure {error} => { fail error }
  }
}

// Glue canonicalization needs the authentic requesting owner before it visits the type graph.
// Reuse an already checked MIR identity, or the body's own observed signature declaration.
pub effect fn glueSourceOwner(store: &mut Semantic, answer: &Shared<Result<Answer, NoRejection>>) -> DeclarationId
! Cycle | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let selected = Shared.with<Result<Answer, NoRejection>, Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selected {
    let mut owner = Option.none<Shared<DeclarationId>>()
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(&store.*, index) {
      owner = Option.some<Shared<DeclarationId>>(InstanceKey.identity(&function.key))
    }
    if let Option<Shared<DeclarationId>>.Some {value} = move owner {
      return run DeclarationId.copyShared(&value)
    }
  }
  let body = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(answer, checkedBody)
  if let Option<Shared<TypedBody>>.Some {value: checked} = move body {
    let count = Shared.with<Result<Answer, NoRejection>, usize>(answer, dependencyCount)
    let mut at = usize.ZERO
    while at < count {
      let edge = Shared.with<Result<Answer, NoRejection>, Option<Dependency>>(answer,
        fn(value: &Result<Answer, NoRejection>) -> Option<Dependency> { return dependencyAt(value, at) })
      if let Option<Dependency>.Some {value: observed} = move edge {
        if observed.family == Family.Signature {
          let addressed = run Semantic.dependencyDeclaration(&mut store.*, &observed)
          if let Option<DeclarationId>.Some {value: declaration} = move addressed {
            let matches = Shared.with<TypedBody, bool>(&checked, fn(value: &TypedBody) -> bool {
              return DeclarationId.equals(TypedBody.declarationId(value), &declaration)
            })
            if matches { return move declaration }
          }
        }
      }
      at = at + usize.ONE
    }
  }
  run Testing.expect(false, "the requesting checked body or MIR retains its authentic source owner")
  return run glueSourceOwner(&mut store.*, answer)
}

pub effect fn glueNamedSourceOwner(store: &mut Semantic, id: &ModuleId, name: &[u8]) -> DeclarationId
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut dependencies = Vector.make<Dependency>()
  let mut port = Semantic.staticPort(&mut store.*, &mut dependencies)
  let addressed = run StaticPort.resolveRootDeclaration(&mut port, id, name, Span {start: usize.ZERO, end: usize.ZERO})
  drop port
  if let Result<DeclarationId, Shared<Rejection>>.Success {value} = move addressed { return move value }
  run Testing.expect(false, "the held source declares the addressed glue requester")
  return run glueNamedSourceOwner(&mut store.*, id, name)
}

// A requesting source belongs to the actual caller application, never a generated callee key.
pub struct SourceInstanceRequest {
  pub key: InstanceKey
  pub sourceOwner: DeclarationId
  pub span: Span
}

pub fn mirSourceApplication(function: &MirFunction) -> Option<Shared<SpecializationApplication>> {
  return match &function.key {
    InstanceKey.Function {application, ..} => Option.some<Shared<SpecializationApplication>>(Shared.clone<SpecializationApplication>(&application))
    _ => Option.none<Shared<SpecializationApplication>>()
  }
}

pub effect fn instanceCallRequest(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>,
  wanted: &InstanceKey, occurrence: usize) -> SourceInstanceRequest
! InvalidModulePath | OutOfMemoryError ? &mut Allocator {
  let selected = Shared.with<Result<Answer, NoRejection>, Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      let source = match move mirSourceApplication(function) {
        Option<Shared<SpecializationApplication>>.Some {value} => run SpecializationApplication.copyShared(&value)
        _ => { fail InvalidModulePath {} }
      }
      let blocks = Vector.asSlice<MirBlock>(&function.blocks)
      let mut matched = usize.ZERO
      let mut at = usize.ZERO
      while at < blocks.length {
        if let MirTerminator.Call {callee: MirCallee.Instance {key}, origin, ..} = &blocks[at].terminator {
          if run InstanceKey.sameApplication(&key, wanted) {
            if matched == occurrence {
              return SourceInstanceRequest {key: InstanceKey.copy(&key),
                sourceOwner: run DeclarationId.copy(SpecializationApplication.bodyDeclaration(&source)), span: origin.span}
            }
            matched = matched + usize.ONE
          }
        }
        at = at + usize.ONE
      }
    }
  }
  fail InvalidModulePath {}
}

pub effect fn sourceCallMir(store: &mut Semantic, request: &mut Request,
  caller: &Shared<Result<Answer, NoRejection>>, key: &InstanceKey, occurrence: usize, observing: bool)
-> Shared<Result<Answer, NoRejection>>
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let source = run instanceCallRequest(&store.*, caller, key, occurrence)
  return run Semantic.demandInstanceMir(&mut store.*, &mut request.*, &source.key, &source.sourceOwner, source.span, observing)
}

pub effect fn providedRejects(store: &mut Semantic, request: &mut Request, id: &ModuleId, name: string, code: RejectionCode,
  text: string, spelling: string, occurrence: usize) -> bool
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let body = run Semantic.demandBody(&mut store.*, &mut request.*, id, String.utf8Bytes(name))
  return rejectsSpan(&body, code, text, spelling, occurrence)
}

pub effect fn providedSucceeds(store: &mut Semantic, request: &mut Request, id: &ModuleId, name: string) -> bool
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let body = run Semantic.demandBody(&mut store.*, &mut request.*, id, String.utf8Bytes(name))
  return succeeded(&body)
}

// Whether the named body is accepted and retains an open region relation at the spelled source.
pub effect fn providedRelates(store: &mut Semantic, request: &mut Request, id: &ModuleId, name: string,
  text: string, spelling: string, occurrence: usize) -> bool
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let body = run Semantic.demandBody(&mut store.*, &mut request.*, id, String.utf8Bytes(name))
  return retainsRegionRelation(&body, text, spelling, occurrence)
}

// Whether a successful body retains an open region relation within the spelled source whose
// offered region is one of the body's own caller-local regions.
pub fn retainsRegionRelation(answer: &Shared<Result<Answer, NoRejection>>, text: string, spelling: string,
  occurrence: usize) -> bool {
  let start = offsetOf(text, spelling, occurrence)
  if start == usize.MAX { return false }
  let end = start + String.utf8Bytes(spelling).length
  let checked = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(answer, checkedBody)
  if let Option<Shared<TypedBody>>.Some {value} = move checked {
    return Shared.with<TypedBody, bool>(&value, fn(body: &TypedBody) -> bool { return bodyRetainsRegionRelation(body, start, end) })
  }
  return false
}

pub fn bodyRetainsRegionRelation(body: &TypedBody, start: usize, end: usize) -> bool {
  let stage = TypedBody.checkingStage(body)
  if let BodyStage.ContractTyped {obligations} = &stage.* {
    let entries = Vector.asSlice<BodySafetyObligation>(&obligations)
    let mut at = usize.ZERO
    while at < entries.length {
      if let BodySafetyObligation.RegionRelation {origin, offered, ..} = &entries[at] {
        let local = Shared.with<Lifetime, bool>(&offered, fn(region: &Lifetime) -> bool {
          return match &region.* {
            Lifetime.Local {declaration, ..} => DeclarationId.equals(&declaration, TypedBody.declarationId(body))
            _ => false
          }
        })
        if local && origin.span.start >= start && origin.span.end <= end { return true }
      }
      at = at + usize.ONE
    }
  }
  return false
}

// The number of open region relations a successful body retains.
pub fn regionRelationCount(answer: &Shared<Result<Answer, NoRejection>>) -> usize {
  let checked = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(answer, checkedBody)
  if let Option<Shared<TypedBody>>.Some {value} = move checked {
    return Shared.with<TypedBody, usize>(&value, bodyRegionRelationCount)
  }
  return usize.ZERO
}

pub fn bodyRegionRelationCount(body: &TypedBody) -> usize {
  let mut count = usize.ZERO
  let stage = TypedBody.checkingStage(body)
  if let BodyStage.ContractTyped {obligations} = &stage.* {
    let entries = Vector.asSlice<BodySafetyObligation>(&obligations)
    let mut at = usize.ZERO
    while at < entries.length {
      if let BodySafetyObligation.RegionRelation {..} = &entries[at] { count = count + usize.ONE }
      at = at + usize.ONE
    }
  }
  return count
}

pub fn staticReference(value: &Type) -> bool {
  if let Type.Reference {lifetime, ..} = &value.* {
    return Shared.with<Lifetime, bool>(&lifetime, fn(region: &Lifetime) -> bool {
      return match & region.* {
        Lifetime.Static => true
        _ => false
      }
    })
  }
  return false
}

pub fn bodyLocalType(answer: &Shared<Result<Answer, NoRejection>>, at: usize) -> Option<Shared<Type>> {
  let body = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(answer, checkedBody)
  if let Option<Shared<TypedBody>>.Some {value} = move body {
    return Shared.with<TypedBody, Option<Shared<Type>>>(&value, fn(checked: &TypedBody) -> Option<Shared<Type>> {
      let locals = TypedBody.localSlice(checked)
      if at >= locals.length { return Option.none<Shared<Type>>() }
      return Option.some<Shared<Type>>(Shared.clone<Type>(&locals[at].ty))
    })
  }
  return Option.none<Shared<Type>>()
}

pub fn enumParameterType(body: &TypedBody) -> Option<Shared<Type>> {
  let locals = TypedBody.localSlice(body)
  if locals.length == usize.ZERO { return Option.none<Shared<Type>>() }
  return Option.some<Shared<Type>>(Shared.clone<Type>(&locals[usize.ZERO].ty))
}

pub fn firstUnionInjectTag(body: &TypedBody) -> usize {
  let nodes = TypedBody.nodeSlice(body)
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {form: BodyExpression.UnionInject {tag, ..}, ..} = &nodes[at].kind { return tag }
    at = at + usize.ONE
  }
  return usize.MAX
}

pub fn matchAddressesPlace(body: &TypedBody) -> bool {
  let nodes = TypedBody.nodeSlice(body)
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {form: BodyExpression.Match {access, ..}, ..} = &nodes[at].kind {
      return match &access { BodySubjectAccess.Place {..} => true _ => false }
    }
    at = at + usize.ONE
  }
  return false
}

// Injection at every immediate boundary and precise coverage, member, field-list, subpattern and
// guard rejections for closed structural unions.
// The tag size, payload offset, size and alignment of a Tagged layout, packed for one comparison.
pub fn taggedShape(layout: &BackendLayout) -> usize {
  if let LayoutStorage.Tagged {tagSize, payloadOffset, ..} = &layout.storage {
    return tagSize * 100000 + payloadOffset * 1000 + layout.size * 10 + layout.alignment
  }
  return usize.MAX
}

// The layout index and packed Tagged shape of the first parameter type of `name`.
pub effect fn parameterLayout(store: &mut Semantic, request: &mut Request, id: &ModuleId, name: &[u8]) -> usize
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let answer = run Semantic.demandBody(&mut store.*, &mut request.*, id, name)
  let body = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(&answer, checkedBody)
  if let Option<Shared<TypedBody>>.Some {value} = move body {
    let parameter = Shared.with<TypedBody, Option<Shared<Type>>>(&value, enumParameterType)
    if let Option<Shared<Type>>.Some {value: ty} = move parameter {
      let layoutAnswer = run Semantic.demandLayout(&mut store.*, &mut request.*, id, &ty)
      let layoutIndex = Shared.with<Result<Answer, NoRejection>, Option<usize>>(&layoutAnswer, selectedLayoutIndex)
      if let Option<usize>.Some {value: index} = move layoutIndex {
        if let Option<Shared<BackendLayout>>.Some {value: facts} = move Semantic.layoutAt(&store.*, index) {
          return index * 1000000 + Shared.with<BackendLayout, usize>(&facts, taggedShape)
        }
      }
    }
  }
  return usize.MAX
}

// Counts arm results that are statement blocks which can complete (`completing`) or always transfer.
pub fn armBlocks(body: &TypedBody, completing: bool) -> usize {
  let nodes = TypedBody.nodeSlice(body)
  let mut found = usize.ZERO
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {form: BodyExpression.Match {arms, ..}, ..} = &nodes[at].kind {
      let written = Vector.asSlice<BodyMatchArm>(&arms)
      let mut arm = usize.ZERO
      while arm < written.length {
        if let BodyNodeKind.Block {canComplete, ..} = &nodes[written[arm].result.index].kind {
          if canComplete == completing { found = found + usize.ONE }
        }
        arm = arm + usize.ONE
      }
    }
    at = at + usize.ONE
  }
  return found
}

pub fn emptyUnionKind(count: usize) -> usize {
  if count == usize.ZERO { return usize.ONE }
  return 2
}

// The first match's type: 0 for `()`, 1 for `never` and 2 for a value.
pub fn matchResultKind(body: &TypedBody) -> usize {
  let nodes = TypedBody.nodeSlice(body)
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {ty, form: BodyExpression.Match {..}} = &nodes[at].kind {
      return Shared.with<Type, usize>(&ty, fn(value: &Type) -> usize {
        return match &value.* {
          Type.Unit => usize.ZERO
          Type.Union {members} => emptyUnionKind(Vector.length<Shared<Type>>(&members))
          _ => 2
        }
      })
    }
    at = at + usize.ONE
  }
  return usize.MAX
}

// The member tag of a whole-member binding node: a path of exactly one structural member step.
pub fn wholeMemberTag(node: &BodyNode) -> usize {
  if let BodyNodeKind.Expression {form: BodyExpression.PatternBinding {path, ..}, ..} = &node.kind {
    let steps = Vector.asSlice<BodyPlaceStep>(&path)
    if steps.length == usize.ONE {
      if let BodyPlaceStep.Member {tag, ..} = &steps[usize.ZERO] { return tag }
    }
  }
  return usize.MAX
}

// Counts the distinct members bound whole. A later use of a binding repeats its path, so it adds no
// member.
pub fn wholeMemberBindings(body: &TypedBody) -> usize {
  let nodes = TypedBody.nodeSlice(body)
  let mut found = usize.ZERO
  let mut at = usize.ZERO
  while at < nodes.length {
    let tag = wholeMemberTag(&nodes[at])
    if tag != usize.MAX {
      let mut earlier = false
      let mut scan = usize.ZERO
      while scan < at {
        if wholeMemberTag(&nodes[scan]) == tag { earlier = true }
        scan = scan + usize.ONE
      }
      if !earlier { found = found + usize.ONE }
    }
    at = at + usize.ONE
  }
  return found
}

pub fn bodyLocalCount(body: &TypedBody) -> usize { return TypedBody.localSlice(body).length }

// One fact of a checked body: 0 transferring arm blocks, 1 completing arm blocks, 2 the first match
// result kind, 3 body locals, 4 whole-member bindings.
pub fn bodyFact(answer: &Shared<Result<Answer, NoRejection>>, fact: usize) -> usize {
  let checked = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(answer, checkedBody)
  if let Option<Shared<TypedBody>>.Some {value} = move checked {
    return Shared.with<TypedBody, usize>(&value, fn(body: &TypedBody) -> usize {
      if fact == usize.ZERO { return armBlocks(body, false) }
      if fact == usize.ONE { return armBlocks(body, true) }
      if fact == 2 { return matchResultKind(body) }
      if fact == 3 { return bodyLocalCount(body) }
      return wholeMemberBindings(body)
    })
  }
  return usize.MAX
}

// One fallible-ABI fact of a MIR function: 0 `Failure` locals, 1 `Fail` terminators, 2 calls with
// a failure edge, 3 failure edges whose target widens into `Failure`, drops and then fails.
pub fn failureFact(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>, fact: usize) -> usize {
  let selected = Shared.with<Result<Answer, NoRejection>, Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      let locals = Vector.asSlice<MirLocal>(&function.locals)
      let blocks = Vector.asSlice<MirBlock>(&function.blocks)
      let mut failureLocal = usize.MAX
      let mut count = usize.ZERO
      let mut at = usize.ZERO
      while at < locals.length {
        let failure = match &locals[at].kind { MirLocalKind.Failure => true _ => false }
        if failure {
          failureLocal = at
          count = count + usize.ONE
        }
        at = at + usize.ONE
      }
      if fact == usize.ZERO { return count }
      count = usize.ZERO
      at = usize.ZERO
      while at < blocks.length {
        match &blocks[at].terminator {
          MirTerminator.Fail {..} => { if fact == usize.ONE { count = count + usize.ONE } }
          MirTerminator.Switch {..} => { if fact == 4 { count = count + usize.ONE } }
          MirTerminator.Call {failure, ..} => {
            if let Option<MirFailureEdge>.Some {value: edge} = &failure {
              if fact == 2 { count = count + usize.ONE }
              if fact == 3 && failureEdgeCleans(blocks, edge.target, failureLocal) { count = count + usize.ONE }
            }
          }
          _ => {}
        }
        at = at + usize.ONE
      }
      return count
    }
  }
  return usize.MAX
}

// The failure-edge block injects the narrower callee failure into `Failure`, then runs the drop
// chain of the scopes it leaves, then fails (Effect note D7).
pub fn failureEdgeCleans(blocks: &[MirBlock], target: usize, failureLocal: usize) -> bool {
  let statements = Vector.asSlice<MirStatement>(&blocks[target].statements)
  let mut injected = false
  let mut dropped = false
  let mut at = usize.ZERO
  while at < statements.length {
    match &statements[at] {
      MirStatement.Assign {destination, value, ..} => {
        let inject = match &value { MirRvalue.Inject {..} => true _ => false }
        if inject && destination.local == failureLocal && !dropped { injected = true }
      }
      MirStatement.Drop {..} => { if injected { dropped = true } }
      MirStatement.FailureContext {..} => {}
    }
    at = at + usize.ONE
  }
  let fails = match &blocks[target].terminator { MirTerminator.Fail {..} => true _ => false }
  return injected && dropped && fails
}

pub fn suspensionGapAt(answer: &Shared<Result<Answer, NoRejection>>, start: usize) -> bool {
  let gap = Shared.with<Result<Answer, NoRejection>, Option<Shared<BackendGap>>>(answer, selectedBackendGap)
  if let Option<Shared<BackendGap>>.Some {value} = move gap {
    return Shared.with<BackendGap, bool>(&value, fn(found: &BackendGap) -> bool {
      return found.code == GapCode.Suspension && BackendGap.span(found).start == start
    })
  }
  return false
}

pub fn switchCount(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>) -> usize {
  let selected = Shared.with<Result<Answer, NoRejection>, Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      let blocks = Vector.asSlice<MirBlock>(&function.blocks)
      let mut count = usize.ZERO
      let mut at = usize.ZERO
      while at < blocks.length {
        if let MirTerminator.Switch {..} = &blocks[at].terminator { count = count + usize.ONE }
        at = at + usize.ONE
      }
      return count
    }
  }
  return usize.MAX
}

pub fn keyNamed(key: &InstanceKey, name: string) -> bool {
  return Shared.with<DeclarationId, bool>(&InstanceKey.identity(key), fn(value: &DeclarationId) -> bool {
    return DeclarationId.named(value, String.utf8Bytes(name))
  })
}

// Whether the first call to `name` has a failure edge: 1 with one, 0 without, usize.MAX when no
// such call is lowered.
pub fn callFailureEdge(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>, name: string) -> usize {
  let selected = Shared.with<Result<Answer, NoRejection>, Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      let blocks = Vector.asSlice<MirBlock>(&function.blocks)
      let mut at = usize.ZERO
      while at < blocks.length {
        if let MirTerminator.Call {callee: MirCallee.Instance {key}, failure, ..} = &blocks[at].terminator {
          if keyNamed(&key, name) {
            return match &failure { Option<MirFailureEdge>.Some {..} => usize.ONE Option<MirFailureEdge>.None => usize.ZERO }
          }
        }
        at = at + usize.ONE
      }
    }
  }
  return usize.MAX
}

// The callee key of the first call to `name`, providers included.
pub fn providedCallee(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>, name: string) -> Option<InstanceKey> {
  let selected = Shared.with<Result<Answer, NoRejection>, Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      let blocks = Vector.asSlice<MirBlock>(&function.blocks)
      let mut at = usize.ZERO
      while at < blocks.length {
        if let MirTerminator.Call {callee: MirCallee.Instance {key}, ..} = &blocks[at].terminator {
          if keyNamed(&key, name) { return Option.some<InstanceKey>(InstanceKey.copy(&key)) }
        }
        at = at + usize.ONE
      }
    }
  }
  return Option.none<InstanceKey>()
}

pub fn copiedLocal(operand: &MirOperand) -> usize {
  return match &operand.* { MirOperand.Copy {place} => place.local _ => usize.MAX }
}

pub fn copiedProjections(operand: &MirOperand) -> usize {
  return match &operand.* { MirOperand.Copy {place} => Vector.length<MirProjection>(&place.projections) _ => usize.MAX }
}

pub fn cleanupGapAt(answer: &Shared<Result<Answer, NoRejection>>, text: string, spelling: string, occurrence: usize) -> bool {
  let start = offsetOf(text, spelling, occurrence)
  if start == usize.MAX { return false }
  let end = start + String.utf8Bytes(spelling).length
  let gap = Shared.with<Result<Answer, NoRejection>, Option<Shared<BackendGap>>>(answer, selectedBackendGap)
  if let Option<Shared<BackendGap>>.Some {value} = move gap {
    return Shared.with<BackendGap, bool>(&value, fn(found: &BackendGap) -> bool {
      let span = BackendGap.span(found)
      return found.code == GapCode.Cleanup && span.start == start && span.end == end
    })
  }
  return false
}

// One cleanup fact of a MIR function: 0 drop-flag locals, 1 writes to them, 2 and 3 the locals
// the first and second `Drop` statements clean, 4 the edges into the first drop's block.
pub fn cleanupFact(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>, fact: usize) -> usize {
  let selected = Shared.with<Result<Answer, NoRejection>, Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      let locals = Vector.asSlice<MirLocal>(&function.locals)
      let mut flags = usize.ZERO
      let mut at = usize.ZERO
      while at < locals.length {
        if isDropFlag(locals, at) { flags = flags + usize.ONE }
        at = at + usize.ONE
      }
      if fact == usize.ZERO { return flags }
      let blocks = Vector.asSlice<MirBlock>(&function.blocks)
      let mut writes = usize.ZERO
      let mut drops = usize.ZERO
      let mut first = usize.MAX
      let mut second = usize.MAX
      let mut firstBlock = usize.MAX
      at = usize.ZERO
      while at < blocks.length {
        let statements = Vector.asSlice<MirStatement>(&blocks[at].statements)
        let mut position = usize.ZERO
        while position < statements.length {
          if let MirStatement.Assign {destination, ..} = &statements[position] {
            if isDropFlag(locals, destination.local) { writes = writes + usize.ONE }
          }
          if let MirStatement.Drop {destination, ..} = &statements[position] {
            if drops == usize.ZERO {
              first = destination.local
              firstBlock = at
            }
            if drops == usize.ONE { second = destination.local }
            drops = drops + usize.ONE
          }
          position = position + usize.ONE
        }
        at = at + usize.ONE
      }
      if fact == usize.ONE { return writes }
      if fact == 2 { return first }
      if fact == 4 { return predecessors(blocks, firstBlock) }
      return second
    }
  }
  return usize.MAX
}

// The terminator edges that reach block `target`.
pub fn predecessors(blocks: &[MirBlock], target: usize) -> usize {
  let mut count = usize.ZERO
  let mut at = usize.ZERO
  while at < blocks.length {
    count = count + edgesTo(&blocks[at].terminator, target)
    at = at + usize.ONE
  }
  return count
}

pub fn edgesTo(terminator: &MirTerminator, target: usize) -> usize {
  return match &terminator.* {
    MirTerminator.Goto {target: next, ..} => countIf(next == target)
    MirTerminator.Branch {thenBlock, elseBlock, ..} => countIf(thenBlock == target) + countIf(elseBlock == target)
    MirTerminator.Call {normal, failure, ..} => countIf(normal == target) + optionalEdgeTo(&failure, target)
    MirTerminator.Switch {cases, otherwise, ..} => switchEdgesTo(Vector.asSlice<MirSwitchCase>(&cases), target) + countIf(otherwise == target)
    _ => usize.ZERO
  }
}

pub fn optionalEdgeTo(edge: &Option<MirFailureEdge>, target: usize) -> usize {
  return match &edge.* {
    Option<MirFailureEdge>.Some {value} => countIf(value.target == target)
    Option<MirFailureEdge>.None => usize.ZERO
  }
}

pub fn switchEdgesTo(cases: &[MirSwitchCase], target: usize) -> usize {
  let mut count = usize.ZERO
  let mut at = usize.ZERO
  while at < cases.length {
    count = count + countIf(cases[at].target == target)
    at = at + usize.ONE
  }
  return count
}

pub fn countIf(holds: bool) -> usize {
  if holds { return usize.ONE }
  return usize.ZERO
}

// Kept apart from the loops that call it: indexing one slice local in two loops of the same
// function makes the bootstrap reuse a spill slot across blocks it does not dominate.
pub fn isDropFlag(locals: &[MirLocal], local: usize) -> bool {
  return match &locals[local].kind { MirLocalKind.DropFlag {..} => true _ => false }
}

// One fact of a MIR function: 0 `Drop` statements, 1 calls, 2 switches, 3 and 4 the last projection
// of the first and second drop (a field ordinal, 1000 for a runtime index, 2000 + a member tag, or
// 3000 + 10 * variant + field), 5 branches, 6 references to drop glue, 7 whether the first call's
// block precedes the first drop's, 8 whether the first drop selects a union payload whose member
// type is nominal.
pub fn glueFact(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>, fact: usize) -> usize {
  let selected = Shared.with<Result<Answer, NoRejection>, Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      if fact == 6 {
        let references = Vector.asSlice<MirReference>(&function.references)
        let mut glued = usize.ZERO
        let mut at = usize.ZERO
        while at < references.length {
          if let Option<Shared<Type>>.Some {..} = move InstanceKey.glueType(&references[at].key) { glued = glued + usize.ONE }
          at = at + usize.ONE
        }
        return glued
      }
      let blocks = Vector.asSlice<MirBlock>(&function.blocks)
      let mut drops = usize.ZERO
      let mut calls = usize.ZERO
      let mut switches = usize.ZERO
      let mut branches = usize.ZERO
      let mut first = usize.MAX
      let mut second = usize.MAX
      let mut firstCall = usize.MAX
      let mut firstDrop = usize.MAX
      let mut nominalPayload = false
      let mut at = usize.ZERO
      while at < blocks.length {
        let statements = Vector.asSlice<MirStatement>(&blocks[at].statements)
        let mut position = usize.ZERO
        while position < statements.length {
          if let MirStatement.Drop {destination, ..} = &statements[position] {
            let code = lastProjectionCode(&destination.projections)
            if drops == usize.ZERO {
              first = code
              firstDrop = at
              nominalPayload = nominalPayloadStep(&destination.projections)
            }
            if drops == usize.ONE { second = code }
            drops = drops + usize.ONE
          }
          position = position + usize.ONE
        }
        if let MirTerminator.Call {..} = &blocks[at].terminator {
          if calls == usize.ZERO { firstCall = at }
          calls = calls + usize.ONE
        }
        if let MirTerminator.Switch {..} = &blocks[at].terminator { switches = switches + usize.ONE }
        if let MirTerminator.Branch {..} = &blocks[at].terminator { branches = branches + usize.ONE }
        at = at + usize.ONE
      }
      if fact == usize.ZERO { return drops }
      if fact == usize.ONE { return calls }
      if fact == 2 { return switches }
      if fact == 3 { return first }
      if fact == 4 { return second }
      if fact == 7 {
        if firstCall < firstDrop { return usize.ONE }
        return usize.ZERO
      }
      if fact == 8 {
        if nominalPayload { return usize.ONE }
        return usize.ZERO
      }
      return branches
    }
  }
  return usize.MAX
}

// Whether the last projection selects a union payload of a nominal type.
pub fn nominalPayloadStep(projections: &Vector<MirProjection>) -> bool {
  let listed = Vector.asSlice<MirProjection>(projections)
  if listed.length == usize.ZERO { return false }
  return match &listed[listed.length - usize.ONE] {
    MirProjection.Payload {ty, ..} => Shared.with<Type, bool>(&ty, nominalType)
    _ => false
  }
}

pub fn lastProjectionCode(projections: &Vector<MirProjection>) -> usize {
  let listed = Vector.asSlice<MirProjection>(projections)
  if listed.length == usize.ZERO { return usize.MAX }
  return match &listed[listed.length - usize.ONE] {
    MirProjection.Field {index} => index
    MirProjection.Index {..} => 1000
    MirProjection.Payload {index, ..} => 2000 + index
    MirProjection.VariantField {variant, field} => 3000 + 10 * variant + field
    _ => usize.MAX - usize.ONE
  }
}

pub fn localRegion(region: &Lifetime) -> bool {
  return match &region.* { Lifetime.Local {..} => true
    _ => false }
}

pub fn decimalEqualsUsize(digits: &[u8], value: usize) -> bool {
  if digits.length == usize.ZERO { return false }
  let mut parsed = usize.ZERO
  let mut at = usize.ZERO
  while at < digits.length {
    if digits[at] < 48 || digits[at] > 57 { return false }
    let digit = u8.toUsize(digits[at] - 48)
    if parsed > (usize.MAX - digit) / 10 { return false }
    parsed = parsed * 10 + digit
    at = at + usize.ONE
  }
  return parsed == value
}

// Only the referenced ByteBox is non-scalar in these constructed MIR controls.
pub effect fn scalarControlLayout(ty: &Shared<Type>, target: &MachineTarget) -> Option<BackendLayout>
! OutOfMemoryError ? &mut Allocator {
  let scalar = BackendLayout.scalar(ty, target)
  if let Option<BackendLayout>.Some {value} = move scalar {
    return Option.some<BackendLayout>(move value)
  }
  let mut fields = Vector.make<LayoutFieldInput>()
  run Vector.append<LayoutFieldInput>(&mut fields, LayoutFieldInput {ty: run specializationPrimitive(b"u8"),
    metrics: LayoutMetrics {size: usize.ONE, alignment: usize.ONE, abi: LayoutAbi.Integer}})
  return run BackendLayout.record(Vector.asSlice<LayoutFieldInput>(&fields))
}

pub effect fn scalarControlLayouts(function: &MirFunction, target: &MachineTarget) -> Vector<TypeLayout>
! OutOfMemoryError ? &mut Allocator {
  let demands = run mirLayoutDemands(function)
  let needed = Vector.asSlice<LayoutDemand>(&demands)
  let mut layouts = Vector.make<TypeLayout>()
  let mut at = usize.ZERO
  while at < needed.length {
    let facts = run scalarControlLayout(&needed[at].ty, target)
    if let Option<BackendLayout>.Some {value} = move facts {
      run Vector.append<TypeLayout>(&mut layouts, TypeLayout {ty: Shared.clone<Type>(&needed[at].ty), layout: run Shared.make<BackendLayout>(move value)})
    }
    at = at + usize.ONE
  }
  return move layouts
}

pub effect fn typedInteger(spelling: &[u8], digits: &[u8]) -> MirOperand
! OutOfMemoryError ? &mut Allocator {
  return MirOperand.Integer {decimal: run Bytes.copy(digits), negative: false, ty: run specializationPrimitive(spelling)}
}

pub fn runtimeSliceOperand(place: MirPlace, moves: bool) -> MirOperand {
  if moves { return MirOperand.Move {place: move place} }
  return MirOperand.Copy {place: move place}
}

pub struct TextResultEvidence { pub local: usize pub join: usize }

pub fn textResult(function: &MirFunction, block: usize, value: bool) -> Option<TextResultEvidence> {
  let blocks = Vector.asSlice<MirBlock>(&function.blocks)
  if block >= blocks.length { return Option.none<TextResultEvidence>() }
  let statements = Vector.asSlice<MirStatement>(&blocks[block].statements)
  if statements.length != usize.ONE { return Option.none<TextResultEvidence>() }
  if let MirStatement.Assign {destination, value: MirRvalue.Use {value: MirOperand.Boolean {value: chosen}}, ..} = &statements[usize.ZERO] {
    if chosen == value && Vector.length<MirProjection>(&destination.projections) == usize.ZERO {
      if let MirTerminator.Goto {target, ..} = &blocks[block].terminator {
        return Option.some<TextResultEvidence>(TextResultEvidence {local: destination.local, join: target})
      }
    }
  }
  return Option.none<TextResultEvidence>()
}

pub fn selectedBackendGap(answer: &Result<Answer, NoRejection>) -> Option<Shared<BackendGap>> {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Unsupported {gap}} = &value.outcome { return Option.some<Shared<BackendGap>>(Shared.clone<BackendGap>(&gap)) }
  }
  return Option.none<Shared<BackendGap>>()
}

pub fn exactCallableValue(value: &Type) -> bool {
  return match &value.* { Type.CallableValue {..} => true _ => false }
}

pub fn borrowedCallableFieldLocal(value: &MirOperand) -> usize {
  return match &value.* {
    MirOperand.Copy {place} => place.local
    MirOperand.Move {place} => place.local
    _ => usize.MAX
  }
}

pub fn anonymousFunctionKey(key: &InstanceKey) -> bool {
  if let InstanceKey.Function {..} = &key.* {
    let identity = InstanceKey.identity(key)
    return Shared.with<DeclarationId, bool>(&identity, fn(value: &DeclarationId) -> bool {
      return DeclarationId.kind(value) == OwnerKind.Anonymous
    })
  }
  return false
}

pub fn anonymousMirApplication(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>) -> Option<Shared<SpecializationApplication>> {
  let index = Shared.with<Result<Answer, NoRejection>, Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value} = move index {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, value) {
      let references = Vector.asSlice<MirReference>(&function.references)
      let mut at = usize.ZERO
      while at < references.length {
        if anonymousFunctionKey(&references[at].key) {
          return InstanceKey.application(&references[at].key)
        }
        at = at + usize.ONE
      }
    }
  }
  return Option.none<Shared<SpecializationApplication>>()
}

pub fn anonymousReceiverType(ty: &Type, mode: CallableMode) -> bool {
  if mode == CallableMode.Once { return match &ty.* { Type.CallableValue {..} => true _ => false } }
  if let Type.Reference {access, referent, ..} = &ty.* {
    let expected = match mode { CallableMode.Mutable => Access.Mutable _ => Access.Shared }
    return access == expected && Shared.with<Type, bool>(&referent, exactCallableEnvironment)
  }
  return false
}

pub fn exactCallableEnvironment(ty: &Type) -> bool {
  return match &ty.* { Type.CallableValue {..} => true _ => false }
}

pub fn anonymousTargetParameter(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>, mode: CallableMode, count: usize) -> bool {
  let index = Shared.with<Result<Answer, NoRejection>, Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value} = move index {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, value) {
      let parameters = Vector.asSlice<Shared<Type>>(&function.parameters)
      let locals = Vector.asSlice<MirLocal>(&function.locals)
      return anonymousFunctionKey(&function.key) && !function.safetyChecked && parameters.length == count
        && locals.length > count && Shared.with<Type, bool>(&parameters[0],
          fn(ty: &Type) -> bool { return anonymousReceiverType(ty, mode) })
    }
  }
  return false
}

pub fn sectionStoredField(operand: &MirOperand, field: usize) -> bool {
  if let MirOperand.Copy {place} = &operand.* {
    return Vector.length<MirProjection>(&place.projections) == usize.ONE
      && lastProjectionCode(&place.projections) == field
  }
  return false
}

pub fn sectionCaptureOperand(operand: &MirOperand, consumes: bool) -> bool {
  if consumes {
    if let MirOperand.Move {place} = &operand.* {
      return Vector.length<MirProjection>(&place.projections) == usize.ONE
        && lastProjectionCode(&place.projections) == usize.ZERO
    }
    return false
  }
  return sectionStoredField(operand, usize.ZERO)
}

pub fn sectionInvocationCount(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>,
  target: &[u8], consumes: bool) -> usize {
  let selected = Shared.with<Result<Answer, NoRejection>, Option<usize>>(answer, selectedMirIndex)
  let mut count = usize.ZERO
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      let blocks = Vector.asSlice<MirBlock>(&function.blocks)
      let mut at = usize.ZERO
      while at < blocks.length {
        if let MirTerminator.Call {callee: MirCallee.Instance {key}, arguments, ..} = &blocks[at].terminator {
          let identity = InstanceKey.identity(&key)
          let named = Shared.with<DeclarationId, bool>(&identity,
            fn(value: &DeclarationId) -> bool { return DeclarationId.named(value, target) })
          let operands = Vector.asSlice<MirOperand>(&arguments)
          if named && operands.length == 2 && sectionCaptureOperand(&operands[usize.ONE], consumes) { count = count + usize.ONE }
        }
        at = at + usize.ONE
      }
    }
  }
  return count
}

pub fn movedEnvironmentField(operand: &MirOperand, field: usize) -> bool {
  if let MirOperand.Move {place} = &operand.* {
    let path = Vector.asSlice<MirProjection>(&place.projections)
    if path.length != usize.ONE { return false }
    if let MirProjection.Field {index} = &path[usize.ZERO] { return index == field }
  }
  return false
}

pub fn stagedReceiver(operand: &MirOperand, locals: &[MirLocal], mode: CallableMode) -> bool {
  if mode == CallableMode.Once { return movedEnvironmentField(operand, usize.ZERO) }
  if let MirOperand.Copy {place} = &operand.* {
    return Vector.length<MirProjection>(&place.projections) == usize.ZERO
      && Shared.with<Type, bool>(&locals[place.local].ty,
        fn(value: &Type) -> bool { return anonymousReceiverType(value, mode) })
  }
  return false
}

pub fn stagedAnonymousArguments(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>, mode: CallableMode) -> bool {
  return stagedAnonymousFields(store, answer, mode, mode == CallableMode.Once)
}

pub fn stagedAnonymousFields(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>, environmentMode: CallableMode, movesSuffix: bool) -> bool {
  let selected = Shared.with<Result<Answer, NoRejection>, Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      let blocks = Vector.asSlice<MirBlock>(&function.blocks)
      let locals = Vector.asSlice<MirLocal>(&function.locals)
      let mut at = usize.ZERO
      while at < blocks.length {
        if let MirTerminator.Call {callee: MirCallee.Instance {key}, arguments, ..} = &blocks[at].terminator {
          let operands = Vector.asSlice<MirOperand>(&arguments)
          if anonymousFunctionKey(&key) && operands.length == 3 {
            let receiver = stagedReceiver(&operands[usize.ZERO], locals, environmentMode)
            let mut suffix = sectionStoredField(&operands[2], usize.ONE)
            if movesSuffix { suffix = movedEnvironmentField(&operands[2], usize.ONE) }
            return receiver && suffix
          }
        }
        at = at + usize.ONE
      }
    }
  }
  return false
}

pub fn namedMirApplication(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>, name: &[u8]) -> Option<Shared<SpecializationApplication>> {
  let index = Shared.with<Result<Answer, NoRejection>, Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: selected} = move index {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, selected) {
      let references = Vector.asSlice<MirReference>(&function.references)
      let mut at = usize.ZERO
      while at < references.length {
        let identity = InstanceKey.identity(&references[at].key)
        let matches = Shared.with<DeclarationId, bool>(&identity,
          fn(value: &DeclarationId) -> bool { return sameBytes(DeclarationId.spelling(value), name) })
        if matches {
          // Capture glue can share the target's owner identity without being a function application.
          let application = InstanceKey.application(&references[at].key)
          if let Option<Shared<SpecializationApplication>>.Some {value} = move application {
            return Option.some<Shared<SpecializationApplication>>(move value)
          }
        }
        at = at + usize.ONE
      }
    }
  }
  return Option.none<Shared<SpecializationApplication>>()
}

pub effect fn plainCallableParameterTargetClaims(
  text: string<'static>,
  mode: CallableMode,
  parameterCount: usize,
) -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
? &mut Allocator {
  let id = run module("plain-callable-parameter.silk")
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let caller = run Semantic.demandMir(&mut store, &mut request, &id, b"main")
  run Testing.expect(
    succeeded(&caller),
    "a source callable parameter admits the exact argument representation",
  )
  let selected = namedMirApplication(&store, &caller, b"invoke")
  if let Option<Shared<SpecializationApplication>>.Some {value} = move selected {
    let application = run SpecializationApplication.copyShared(&value)
    let target = run Semantic.demandApplicationMir(&mut store, &mut request, &application)
    run Testing.expect(
      succeeded(&target),
      "the specialized callable parameter invokes its ordinary direct target",
    )
    let nested = anonymousMirApplication(&store, &target)
    if let Option<Shared<SpecializationApplication>>.Some {value: original} = move nested {
      let literal = run SpecializationApplication.copyShared(&original)
      let implementation = run Semantic.demandApplicationMir(&mut store, &mut request, &literal)
      run Testing.expect(
        anonymousTargetParameter(&store, &implementation, mode, parameterCount),
        "the original anonymous target retains its actual environment passing mode",
      )
      if mode == CallableMode.Once {
        run Testing.expect(
          glueFact(&store, &caller, usize.ZERO) == usize.ZERO && glueFact(
            &store,
            &target,
            usize.ZERO,
          ) == usize.ZERO && glueFact(&store, &implementation, usize.ZERO) == usize.ONE,
          "the once capture crosses both exact parameters and is dropped only by its literal body",
        )
      }
      return ()
    }
  }
  run Testing.expect(
    false,
    "callable parameter specialization has no adapter or erased function pointer",
  )
}

pub fn characterEmbeddedValue(data: &StaticData, integer: bool, kind: StaticIntegerType, scalar: u32) -> bool {
  return match &data.* {
    StaticData.Character {scalar: actual} => !integer && actual == scalar
    StaticData.Integer {ty, sign, magnitude} => integer && ty == kind && sign == StaticSign.Positive && magnitude == u32.toU64(scalar)
    _ => false
  }
}

pub fn characterBodyFact(answer: &Shared<Result<Answer, NoRejection>>, spelling: &[u8], integer: bool, kind: StaticIntegerType, scalar: u32, count: usize) -> bool {
  let selected = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(answer, checkedBody)
  if let Option<Shared<TypedBody>>.Some {value} = move selected {
    return Shared.with<TypedBody, bool>(&value, fn(body: &TypedBody) -> bool {
      return characterBodyValue(body, spelling, integer, kind, scalar, count)
    })
  }
  return false
}

pub fn characterBodyValue(body: &TypedBody, spelling: &[u8], integer: bool, kind: StaticIntegerType, scalar: u32, count: usize) -> bool {
  let nodes = TypedBody.nodeSlice(body)
  let mut matching = usize.ZERO
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {ty, form: BodyExpression.Embedded {value}} = &nodes[at].kind {
      let typed = Shared.with<Type, bool>(&ty, fn(found: &Type) -> bool { return witnessPrimitive(found, spelling) })
      let exact = Shared.with<StaticData, bool>(&value, fn(data: &StaticData) -> bool { return characterEmbeddedValue(data, integer, kind, scalar) })
      if typed && exact { matching = matching + usize.ONE }
    }
    at = at + usize.ONE
  }
  return matching == count
}

pub fn allocationSignatureParameter(answer: &Shared<Result<Answer, NoRejection>>, index: usize) -> Option<Shared<Type>> {
  return Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(answer,
    fn(value: &Result<Answer, NoRejection>) -> Option<Shared<Type>> {
      if let Result<Answer, NoRejection>.Success {value: checkedAnswer} = &value.* {
        if let Outcome.Success {value: Value.Signature {signature}} = &checkedAnswer.outcome {
          let parameters = Vector.asSlice<Shared<Type>>(&signature.parameters)
          if index < parameters.length { return Option.some<Shared<Type>>(Shared.clone<Type>(&parameters[index])) }
        }
      }
      return Option.none<Shared<Type>>()
    })
}

pub fn sharedCallbackTarget(value: &DeclarationId, id: &ModuleId, name: &[u8]) -> bool {
  return DeclarationId.named(value, name) && ModuleId.equals(DeclarationId.moduleId(value), id)
}

pub fn sharedCallbackSchemaTarget(value: &SectionSchema, id: &ModuleId, name: &[u8]) -> bool {
  return Shared.with<DeclarationId, bool>(&value.target, fn(declaration: &DeclarationId) -> bool {
    return sharedCallbackTarget(declaration, id, name)
  })
}

pub fn sharedCallbackSchemaSelected(value: &SectionSchema, id: &ModuleId, primitive: &[u8]) -> bool {
  if !sharedCallbackSchemaTarget(value, id, b"inspect") { return false }
  let bindings = Vector.asSlice<Binding>(&value.selected)
  let mut element = usize.ZERO
  let mut result = usize.ZERO
  let mut at = usize.ZERO
  while at < bindings.length {
    let target = Shared.with<DeclarationId, bool>(&bindings[at].declaration, fn(declaration: &DeclarationId) -> bool {
      return sharedCallbackTarget(declaration, id, b"inspect")
    })
    if target && bindings[at].ordinal == usize.ZERO {
      if !genericSectionArgument(&bindings[at].value, b"i32") { return false }
      element = element + usize.ONE
    }
    if target && bindings[at].ordinal == usize.ONE {
      if !genericSectionArgument(&bindings[at].value, primitive) { return false }
      result = result + usize.ONE
    }
    at = at + usize.ONE
  }
  return element == usize.ONE && result == usize.ONE
}

pub fn genericSectionArgument(value: &Argument, name: &[u8]) -> bool {
  return match &value.* {
    Argument.Type {value: ty} => Shared.with<Type, bool>(&ty, fn(actual: &Type) -> bool { return witnessPrimitive(actual, name) })
    _ => false
  }
}

pub fn listed(entries: &[usize], count: usize, wanted: usize) -> bool {
  let mut at = usize.ZERO
  while at < count {
    if entries[at] == wanted { return true }
    at = at + usize.ONE
  }
  return false
}

pub fn startsAt(text: &[u8], at: usize, needle: &[u8]) -> bool {
  let mut offset = usize.ZERO
  while offset < needle.length {
    if text[at + offset] != needle[offset] { return false }
    offset = offset + usize.ONE
  }
  return true
}

// Trace the loaded byte SSA name into the zero-extending conversion, independent of temporary numbering.
pub fn conversionUsesProjectedLoad(ir: &[u8]) -> bool {
  let mut start = usize.ZERO
  while start < ir.length {
    let mut end = start
    while end < ir.length && ir[end] != 10 { end = end + usize.ONE }
    let line = Slice.view<u8>(ir, start, end - start)
    if containsIr(line, b" = load i8, ptr ") {
      let mut nameLength = usize.ZERO
      while nameLength < line.length && line[nameLength] != 32 { nameLength = nameLength + usize.ONE }
      let name = Slice.view<u8>(ir, start, nameLength)
      let mut following = end + usize.ONE
      while following < ir.length {
        let mut next = following
        while next < ir.length && ir[next] != 10 { next = next + usize.ONE }
        let widened = Slice.view<u8>(ir, following, next - following)
        if containsIr(widened, b" = load i8, ptr ") { break }
        let mut at = usize.ZERO
        while at < widened.length {
          if startsAt(widened, at, b" = zext i8 ") {
            if startsAt(widened, at + 11, name) && startsAt(widened, at + 11 + name.length, b" to i32") { return true }
            break
          }
          at = at + usize.ONE
        }
        following = next + usize.ONE
      }
    }
    start = end + usize.ONE
  }
  return false
}

// Which scalar MIR forms one lowered instance contains.
pub struct ScalarForms {
  pub shifts: bool
  pub rotates: bool
  pub converts: bool
  pub classifies: bool
  pub saturates: bool
  pub compares: bool
  pub stores: bool
  pub views: bool
  pub traps: bool
  pub overflows: bool
  pub nullTests: bool
  pub calls: usize
}

pub fn scalarForms(function: &MirFunction) -> ScalarForms {
  let mut forms = ScalarForms {shifts: false, rotates: false, converts: false, classifies: false, saturates: false,
    compares: false, stores: false, views: false, traps: false, overflows: false, nullTests: false, calls: usize.ZERO}
  let blocks = Vector.asSlice<MirBlock>(&function.blocks)
  let mut blockAt = usize.ZERO
  while blockAt < blocks.length {
    if let MirTerminator.Trap {..} = &blocks[blockAt].terminator { forms.traps = true }
    if let MirTerminator.Call {..} = &blocks[blockAt].terminator { forms.calls = forms.calls + usize.ONE }
    let statements = Vector.asSlice<MirStatement>(&blocks[blockAt].statements)
    let mut at = usize.ZERO
    while at < statements.length {
      if let MirStatement.Assign {destination, value, ..} = &statements[at] {
        let projections = Vector.asSlice<MirProjection>(&destination.projections)
        if projections.length == usize.ONE && mirProjectionIsDeref(&projections[usize.ZERO]) { forms.stores = true }
        match &value {
          MirRvalue.ScalarBinary {operation, ..} => {
            if operation == MirScalarBinary.ShiftLeft { forms.shifts = true }
            if operation == MirScalarBinary.RotateRight { forms.rotates = true }
            if operation == MirScalarBinary.SaturatingMultiply { forms.saturates = true }
            if operation == MirScalarBinary.AddOverflows { forms.overflows = true }
          }
          MirRvalue.ScalarUnary {operation, ..} => { if operation == MirScalarUnary.IsNaN { forms.classifies = true } }
          MirRvalue.Convert {..} => { forms.converts = true }
          MirRvalue.Binary {operation, right, ..} => {
            if operation == InfixOperator.LessThan { forms.compares = true }
            if let MirOperand.Null {..} = &right { if operation == InfixOperator.Equals { forms.nullTests = true } }
          }
          MirRvalue.Slice {..} => { forms.views = true }
          _ => ()
        }
      }
      at = at + usize.ONE
    }
    blockAt = blockAt + usize.ONE
  }
  return move forms
}
