//! Reachable dependency evidence of one selected immutable cache directory.
//!
//! Retaining shard bytes does not make their unselected roots live. Adoption verifies only
//! nodes reachable from selected roots and the leaves (including recorded files) those nodes
//! require. A mask belongs to one Bundle association and its mutation generation.

import semantic.CacheBundle
import semantic.CacheImage
import semantic.InternIndex {InternIndex}
import silk.collections.list {List}
import silk.collections.bytes {Bytes}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.core.option {Option}
import silk.num.usize

/// Reachability under one Bundle's selected roots and evidence overlays.
pub struct Live { generation: usize, nodes: List<bool>, leaves: List<bool>, roots: List<bool> }

/// Whether the same Bundle association has remained unchanged since this mask was computed.
pub fn current(live: &Live, bundle: &CacheBundle.Bundle) -> bool {
  return live.generation == CacheBundle.generation(bundle)
}

/// Whether this directory entry is the first exact-key authority for its answer.
pub fn root(live: &Live, index: usize) -> bool {
  return index < List<bool>.length(&live.roots) && List<bool>.get(&live.roots, index)
}

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut at = usize.ZERO
  while at < left.length { if left[at] != right[at] { return false } at = at + usize.ONE }
  return true
}

/// Whether a virtual node belongs to a selected dependency closure.
pub fn node(live: &Live, index: usize) -> bool {
  return index < List<bool>.length(&live.nodes) && List<bool>.get(&live.nodes, index)
}

/// Whether a virtual leaf supplies selected evidence or a selected input's recorded file.
pub fn leaf(live: &Live, index: usize) -> bool {
  return index < List<bool>.length(&live.leaves) && List<bool>.get(&live.leaves, index)
}

/// Computes exact live evidence without copying nodes, edges, leaf keys or answers. Invalid
/// references refuse the mask, so a truncated dependency closure cannot authorize adoption.
pub effect fn compute(bundle: &CacheBundle.Bundle) -> Option<Live> ! OutOfMemoryError ? &mut Allocator {
  let count = CacheBundle.nodeCount(bundle)
  let leafCount = CacheBundle.leafCount(bundle)
  let mut nodes = List<bool>.make()
  let mut leaves = List<bool>.make()
  run List<bool>.appendRepeated(&mut nodes, false, count)
  run List<bool>.appendRepeated(&mut leaves, false, leafCount)
  let roots = List<CacheImage.Root>.asSlice(&bundle.roots)
  let mut authority = List<bool>.make()
  run List<bool>.appendRepeated(&mut authority, false, roots.length)
  let mut directory = InternIndex.make()
  let mut selected = List<usize>.make()
  let mut at = usize.ZERO
  while at < roots.length {
    if roots[at].node >= count { return Option<Live>.none() }
    let key = Bytes.asSlice(&roots[at].key)
    let hash = InternIndex.hashBytes(0, key)
    let mut prior = InternIndex.first(&directory, hash)
    let mut duplicate = false
    while prior != usize.MAX && !duplicate {
      duplicate = same(Bytes.asSlice(&roots[List<usize>.get(&selected, prior)].key), key)
      prior = InternIndex.after(&directory, prior)
    }
    if !duplicate {
      run List<usize>.append(&mut selected, at)
      run InternIndex.record(&mut directory, hash)
      List<bool>.set(&mut authority, at, true)
      List<bool>.set(&mut nodes, roots[at].node, true)
    }
    at = at + usize.ONE
  }
  at = count
  while at > usize.ZERO {
    at = at - usize.ONE
    if !List<bool>.get(&nodes, at) { continue }
    let mut edges = CacheBundle.edgeCursor(bundle, at)
    while let Option<usize>.Some {value: edge} = move CacheBundle.nextEdge(bundle, &mut edges) {
      let target = CacheImage.target(edge)
      if CacheImage.namesNode(edge) {
        if target >= at { return Option<Live>.none() }
        List<bool>.set(&mut nodes, target, true)
      } else {
        if target >= leafCount { return Option<Live>.none() }
        List<bool>.set(&mut leaves, target, true)
        let source = CacheBundle.leaf(bundle, target)
        if source.file != usize.MAX {
          if source.file >= leafCount || CacheBundle.leaf(bundle, source.file).input { return Option<Live>.none() }
          List<bool>.set(&mut leaves, source.file, true)
        }
      }
    }
  }
  return Option<Live>.some(Live {generation: CacheBundle.generation(bundle), nodes: move nodes, leaves: move leaves, roots: move authority})
}

import semantic.ContentHash {ContentHash}
import silk.testing.testing {Testing, AssertionError}
import silk.core.effect {Effect}

effect fn liveClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut bundle = CacheBundle.make()
  let digest = ContentHash {high: 1, low: 2}
  let old = run CacheBundle.addLeaf(&mut bundle, false, run Bytes.copy(b"dead-file"), digest,
    usize.MAX, usize.MAX, ContentHash {high: 0, low: 0})
  let dead = run CacheBundle.addNode(&mut bundle, &[CacheImage.leafEdge(old)])
  drop run CacheBundle.addRoot(&mut bundle, CacheImage.Root {key: run Bytes.copy(b"old"), node: dead, answer: Bytes.make()})
  let file = run CacheBundle.addLeaf(&mut bundle, false, run Bytes.copy(b"live-file"), digest,
    usize.MAX, usize.MAX, ContentHash {high: 0, low: 0})
  let input = run CacheBundle.addLeaf(&mut bundle, true, run Bytes.copy(b"live-input"), digest,
    7, file, ContentHash {high: 3, low: 4})
  let child = run CacheBundle.addNode(&mut bundle, &[CacheImage.leafEdge(input)])
  let parent = run CacheBundle.addNode(&mut bundle, &[CacheImage.nodeEdge(child)])
  drop run CacheBundle.addRoot(&mut bundle, CacheImage.Root {key: run Bytes.copy(b"current"), node: parent, answer: Bytes.make()})
  run Testing.expect(run CacheBundle.retainRoots(&mut bundle, &[1]), "the selected directory keeps its current root")
  drop run CacheBundle.addRoot(&mut bundle, CacheImage.Root {key: run Bytes.copy(b"current"), node: dead, answer: Bytes.make()})
  let live = match move run compute(&bundle) {
    Option<Live>.Some {value} => move value
    _ => { run Testing.expect(false, "a complete selected closure has a liveness mask") return () }
  }
  run Testing.expect(root(&live, 0) && !root(&live, 1), "a later duplicate never becomes an alternative proof authority")
  run Testing.expect(!node(&live, dead) && !leaf(&live, old), "unselected immutable evidence causes no source verification")
  run Testing.expect(node(&live, parent) && node(&live, child) && leaf(&live, input) && leaf(&live, file),
    "root dependencies and the input's recorded file remain live together")
  drop run CacheBundle.addRoot(&mut bundle, CacheImage.Root {key: run Bytes.copy(b"restored"), node: dead, answer: Bytes.make()})
  run Testing.expect(!current(&live, &bundle), "directory mutation invalidates the mask before old evidence becomes selected again")
}

test effect fn selectedBundleEvidenceExcludesDeadShardObservations() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run liveClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}
