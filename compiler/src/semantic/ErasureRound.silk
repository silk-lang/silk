//! Conversion sites and dispatcher requests reached against one frozen member set.

import backend.InstanceKey {InstanceKey}
import backend.Mir {ErasureFact}
import semantic.DeclarationId {DeclarationId}
import semantic.ErasureIndex {ErasureIndex}
import semantic.RecordedKey
import semantic.RuntimeEncoding as Encoding
import semantic.SourceLocations {Location}
import semantic.Specialization {Application, Target}
import semantic.StableKey
import semantic.Type {Type}
import semantic.TypedBody {Origin}
import semantic.Types {Types}
import silk.collections.bytes {Bytes}
import silk.collections.list {List}
import silk.core.option {Option}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.mem.interned {Interned}
import silk.num.u64
import silk.num.usize

/// One walk's observations. Worker processes send these to the coordinator. Only the
/// coordinator changes the member sets, after every worker has finished reading them.
pub struct ErasureRound {
  pub facts: List<ErasureFact>,
  pub dispatchers: List<InstanceKey>,
  // A proof target may be reachable solely by obligation, across different workers.
  pub owesProof: bool,
}

impl ErasureRound {
  pub fn make() -> Self {
    return ErasureRound {facts: List<ErasureFact>.make(), dispatchers: List<InstanceKey>.make(), owesProof: false}
  }

  /// Merges all conversion and narrowing sites, then checks whether the dispatchers whose
  /// witnesses were walked this round saw their final member sets.
  pub effect fn close(self: &Self, index: &mut ErasureIndex) -> bool ! OutOfMemoryError ? &mut Allocator | &mut Types {
    let keys = List<InstanceKey>.asSlice(&self.dispatchers)
    let mut positions = List<usize>.make()
    let mut counts = List<usize>.make()
    let mut at = usize.ZERO
    while at < keys.length {
      if let Option<Interned<Application>>.Some {value} = move InstanceKey.application(&keys[at]) {
        if let Target.Operation {provider, ..} = &Interned<Application>.get(&value).target {
          let position = run ErasureIndex.position(&mut index.*, &provider)
          run List<usize>.append(&mut positions, position)
          run List<usize>.append(&mut counts, ErasureIndex.countAt(&index.*, position))
        }
      }
      at = at + usize.ONE
    }
    let facts = List<ErasureFact>.asSlice(&self.facts)
    at = usize.ZERO
    while at < facts.length {
      run ErasureIndex.observe(&mut index.*, &facts[at])
      at = at + usize.ONE
    }
    at = usize.ZERO
    while at < List<usize>.length(&positions) {
      if ErasureIndex.countAt(&index.*, List<usize>.get(&positions, at)) != List<usize>.get(&counts, at) { return false }
      at = at + usize.ONE
    }
    return true
  }

  /// Writes only portable identities. An empty part requests a coordinator walk, as for other
  /// unsupported shared-walk evidence.
  pub effect fn encode(self: &Self, unfit: bool) -> Bytes ! OutOfMemoryError ? &mut Allocator {
    if unfit || self.owesProof { return Bytes.make() }
    let mut out = Bytes.make()
    let facts = List<ErasureFact>.asSlice(&self.facts)
    run Encoding.word(&mut out, usize.toU64(facts.length))
    let mut at = usize.ZERO
    while at < facts.length {
      let fact = &facts[at]
      if !run RecordedKey.appendType(&mut out, &fact.source) { return Bytes.make() }
      if !run RecordedKey.appendType(&mut out, &fact.target) { return Bytes.make() }
      run StableKey.declaration(&mut out, Interned<DeclarationId>.get(&fact.owner))
      run Encoding.word(&mut out, usize.toU64(fact.origin.node))
      run Encoding.word(&mut out, usize.toU64(fact.origin.location.start))
      run Encoding.word(&mut out, usize.toU64(fact.origin.location.end))
      at = at + usize.ONE
    }
    let keys = List<InstanceKey>.asSlice(&self.dispatchers)
    run Encoding.word(&mut out, usize.toU64(keys.length))
    at = usize.ZERO
    while at < keys.length {
      let mut key = Bytes.make()
      run StableKey.declaration(&mut key, Interned<DeclarationId>.get(&InstanceKey.identity(&keys[at])))
      let prefix = Bytes.length(&key)
      run RecordedKey.appendShape(&mut key, &keys[at])
      if Bytes.length(&key) == prefix { return Bytes.make() }
      let digest = run InstanceKey.identityDigest(&keys[at])
      run Encoding.word(&mut out, digest.high)
      run Encoding.word(&mut out, digest.low)
      run Encoding.field(&mut out, Bytes.asSlice(&key))
      at = at + usize.ONE
    }
    return move out
  }

  /// Reads a worker's portable observations. A refused part discards the entire round.
  pub effect fn receive(self: &mut Self, bytes: &[u8]) -> bool ! OutOfMemoryError ? &mut Allocator | &mut Types {
    let mut reader = StableKey.reader()
    let count = StableKey.readWord(bytes, &mut reader)
    let mut at: u64 = 0
    while at < count && !StableKey.failed(&reader) {
      let source = match move run RecordedKey.takeType(bytes, &mut reader) {
        Option<Interned<Type>>.Some {value} => move value
        _ => { return false }
      }
      let target = match move run RecordedKey.takeType(bytes, &mut reader) {
        Option<Interned<Type>>.Some {value} => move value
        _ => { return false }
      }
      let owner = match move run StableKey.readDeclaration(bytes, &mut reader) {
        Option<DeclarationId>.Some {value} => run Types.internDeclaration(move value)
        _ => { return false }
      }
      let node = u64.toUsize(StableKey.readWord(bytes, &mut reader))
      let start = u64.toUsize(StableKey.readWord(bytes, &mut reader))
      let end = u64.toUsize(StableKey.readWord(bytes, &mut reader))
      run List<ErasureFact>.append(&mut self.facts, ErasureFact {source: move source, target: move target, owner: move owner,
        origin: Origin {node: node, location: Location.make(start, end)}})
      at = at + 1
    }
    let keys = StableKey.readWord(bytes, &mut reader)
    at = 0
    while at < keys && !StableKey.failed(&reader) {
      let high = StableKey.readWord(bytes, &mut reader)
      let low = StableKey.readWord(bytes, &mut reader)
      let field = StableKey.readField(bytes, &mut reader)
      let key = match move run RecordedKey.read(StableKey.view(bytes, field)) {
        Option<InstanceKey>.Some {value} => move value
        _ => { return false }
      }
      let digest = run InstanceKey.identityDigest(&key)
      if digest.high != high || digest.low != low { return false }
      run List<InstanceKey>.append(&mut self.dispatchers, move key)
      at = at + 1
    }
    return StableKey.finished(bytes, &reader)
  }
}
