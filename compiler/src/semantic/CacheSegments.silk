//! Immutable portions of a semantic cache generation.
//!
//! Decoding checks bounds and local topology. Before a decoded segment can supply answers,
//! its generation must authenticate every import with `validateImports`, validate selected
//! root keys, and retain the segments and packs that generation names. Source observations
//! are immutable: a newer file position or fingerprint belongs in a new observation.

import semantic.ContentHash {ContentHash}
import lexer.Span {Span}
import semantic.RuntimeEncoding
import semantic.StableKey
import silk.collections.bytes {Bytes}
import silk.collections.list {List}
import silk.collections.slice {Slice}
import silk.core.option {Option}
import silk.core.ownership {Copy}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.num.u8
import silk.num.u32
import silk.num.u64
import silk.num.usize

/// Maximum encoded bytes in one independently authenticated segment.
pub const BYTE_LIMIT: usize = 8388608
/// Maximum imports in one segment; a generation separately bounds its whole catalog.
pub const IMPORT_LIMIT: usize = 256
/// Maximum leaves, nodes, roots, or references of one kind in one segment.
pub const ENTRY_LIMIT: usize = 131072
/// Maximum cumulative structural entries allocated by a segment decoder.
pub const ITEM_LIMIT: usize = 524288

/// A local item when `segment` is zero, otherwise an item of import `segment - 1`.
pub struct Reference {pub segment: usize, pub index: usize}
impl Copy for Reference {}

/// The exact content and topology of a previously admitted immutable segment.
pub struct Descriptor {
  pub digest: ContentHash,
  pub serial: u64,
  pub leaves: usize,
  pub nodes: usize,
  pub roots: usize,
}
impl Copy for Descriptor {}

/// A dependency edge; `node` distinguishes node references from leaf references.
pub struct Edge {pub node: bool, pub target: Reference}
impl Copy for Edge {}

/// A source observation, including the original file snapshot its position describes.
pub struct Observation {
  pub key: Bytes,
  pub digest: ContentHash,
  pub text: ContentHash,
  pub position: usize,
  pub file: Option<Reference>,
  pub selector: u32,
  pub input: bool,
}

/// One dependency node; local node dependencies precede it in the segment.
pub struct Node {pub edges: List<Edge>}

/// One answer and the native pack digests required by that answer.
pub struct Root {
  pub key: Bytes,
  pub node: Reference,
  pub answer: Bytes,
  pub packs: List<ContentHash>,
}

/// Immutable source observations, graph nodes, and answers under one compiler/profile stamp.
pub struct Segment {
  pub serial: u64,
  pub stamp: Bytes,
  pub imports: List<Descriptor>,
  pub leaves: List<Observation>,
  pub nodes: List<Node>,
  pub roots: List<Root>,
}

/// Metadata derived from an already admitted segment; never trust a packet's own import claims.
pub struct Admission {
  pub descriptor: Descriptor,
  /// Bit `i` is set exactly when leaf `i` is a whole source file.
  pub sourceLeaves: Bytes,
}

/// An empty segment. Its serial must be greater than every imported segment's serial.
pub effect fn make(serial: u64, stamp: &[u8]) -> Segment ! OutOfMemoryError ? &mut Allocator {
  return Segment {serial: serial, stamp: run Bytes.copy(stamp), imports: List<Descriptor>.make(),
    leaves: List<Observation>.make(), nodes: List<Node>.make(), roots: List<Root>.make()}
}

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut at = usize.ZERO
  while at < left.length { if left[at] != right[at] { return false } at = at + usize.ONE }
  return true
}

/// Whether two segment descriptors name exactly the same content and topology.
pub fn sameDescriptor(left: Descriptor, right: Descriptor) -> bool {
  return ContentHash.equals(left.digest, right.digest) && left.serial == right.serial
    && left.leaves == right.leaves && left.nodes == right.nodes && left.roots == right.roots
}

fn validReference(segment: &Segment, reference: Reference, node: bool, before: usize) -> bool {
  if reference.segment == usize.ZERO {
    if node { return reference.index < before }
    return reference.index < List<Observation>.length(&segment.leaves)
  }
  let imports = List<Descriptor>.asSlice(&segment.imports)
  if reference.segment > imports.length { return false }
  let imported = imports[reference.segment - usize.ONE]
  if node { return reference.index < imported.nodes }
  return reference.index < imported.leaves
}

fn addBound(total: &mut usize, count: usize, limit: usize) -> bool {
  if count > limit || total.* > limit - count { return false }
  total.* = total.* + count
  return true
}

// Validates before encoding and after decoding. Exact byte accounting bounds allocations made
// by the encoder; input byte bounds plus the cumulative item budget bound the decoder.
fn localValid(segment: &Segment) -> bool {
  let imports = List<Descriptor>.asSlice(&segment.imports)
  let leaves = List<Observation>.asSlice(&segment.leaves)
  let nodes = List<Node>.asSlice(&segment.nodes)
  let roots = List<Root>.asSlice(&segment.roots)
  if imports.length > IMPORT_LIMIT || leaves.length > ENTRY_LIMIT || nodes.length > ENTRY_LIMIT || roots.length > ENTRY_LIMIT {
    return false
  }
  let mut items = usize.ZERO
  if !addBound(&mut items, imports.length, ITEM_LIMIT) || !addBound(&mut items, leaves.length, ITEM_LIMIT)
    || !addBound(&mut items, nodes.length, ITEM_LIMIT) || !addBound(&mut items, roots.length, ITEM_LIMIT) { return false }
  // Magic field, version, serial, stamp field, four counts, and checksum.
  let mut bytes: usize = 168
  if !addBound(&mut bytes, (leaves.length + nodes.length + roots.length) * 8, BYTE_LIMIT) { return false }
  if !addBound(&mut bytes, Bytes.length(&segment.stamp), BYTE_LIMIT) { return false }
  let mut at = usize.ZERO
  while at < imports.length {
    let imported = imports[at]
    if imported.serial >= segment.serial || imported.leaves > ENTRY_LIMIT || imported.nodes > ENTRY_LIMIT || imported.roots > ENTRY_LIMIT {
      return false
    }
    let mut earlier = usize.ZERO
    while earlier < at {
      if ContentHash.equals(imports[earlier].digest, imported.digest) { return false }
      earlier = earlier + usize.ONE
    }
    if !addBound(&mut bytes, 48, BYTE_LIMIT) { return false }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < leaves.length {
    let leaf = &leaves[at]
    if !addBound(&mut bytes, 72, BYTE_LIMIT) || !addBound(&mut bytes, Bytes.length(&leaf.key), BYTE_LIMIT) { return false }
    if let Option<Reference>.Some {value: file} = &leaf.file {
      if !leaf.input || !validReference(segment, file, false, usize.ZERO) { return false }
      if file.segment == usize.ZERO && leaves[file.index].input { return false }
      if !addBound(&mut bytes, 16, BYTE_LIMIT) { return false }
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < nodes.length {
    let edges = List<Edge>.asSlice(&nodes[at].edges)
    if edges.length > ENTRY_LIMIT || !addBound(&mut items, edges.length, ITEM_LIMIT) || !addBound(&mut bytes, 8, BYTE_LIMIT) { return false }
    let mut edge = usize.ZERO
    while edge < edges.length {
      if !validReference(segment, edges[edge].target, edges[edge].node, at) || !addBound(&mut bytes, 24, BYTE_LIMIT) { return false }
      edge = edge + usize.ONE
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < roots.length {
    let root = &roots[at]
    let packs = List<ContentHash>.asSlice(&root.packs)
    if !validReference(segment, root.node, true, nodes.length) || packs.length > ENTRY_LIMIT
      || !addBound(&mut items, packs.length, ITEM_LIMIT) || !addBound(&mut bytes, 40, BYTE_LIMIT)
      || !addBound(&mut bytes, Bytes.length(&root.key), BYTE_LIMIT)
      || !addBound(&mut bytes, Bytes.length(&root.answer), BYTE_LIMIT) { return false }
    let mut pack = usize.ZERO
    while pack < packs.length { if !addBound(&mut bytes, 16, BYTE_LIMIT) { return false } pack = pack + usize.ONE }
    at = at + usize.ONE
  }
  return true
}

effect fn hash(output: &mut Bytes, value: ContentHash) -> () ! OutOfMemoryError ? &mut Allocator {
  run RuntimeEncoding.word(&mut output.*, value.high)
  run RuntimeEncoding.word(&mut output.*, value.low)
}
effect fn reference(output: &mut Bytes, value: Reference) -> () ! OutOfMemoryError ? &mut Allocator {
  run RuntimeEncoding.word(&mut output.*, usize.toU64(value.segment))
  run RuntimeEncoding.word(&mut output.*, usize.toU64(value.index))
}

/// Encodes bounded local topology. Import authority is checked separately by `validateImports`.
pub effect fn encode(segment: &Segment) -> Option<Bytes> ! OutOfMemoryError ? &mut Allocator {
  if !localValid(segment) { return Option<Bytes>.none() }
  let mut output = Bytes.make()
  let mut leafOffsets = List<usize>.make()
  let mut nodeOffsets = List<usize>.make()
  let mut rootOffsets = List<usize>.make()
  run RuntimeEncoding.field(&mut output, b"silk-cache-segment-v2")
  run RuntimeEncoding.word(&mut output, 1)
  run RuntimeEncoding.word(&mut output, segment.serial)
  run RuntimeEncoding.field(&mut output, Bytes.asSlice(&segment.stamp))
  let imports = List<Descriptor>.asSlice(&segment.imports)
  run RuntimeEncoding.word(&mut output, usize.toU64(imports.length))
  let mut at = usize.ZERO
  while at < imports.length {
    let imported = imports[at]
    run hash(&mut output, imported.digest)
    run RuntimeEncoding.word(&mut output, imported.serial)
    run RuntimeEncoding.word(&mut output, usize.toU64(imported.leaves))
    run RuntimeEncoding.word(&mut output, usize.toU64(imported.nodes))
    run RuntimeEncoding.word(&mut output, usize.toU64(imported.roots))
    at = at + usize.ONE
  }
  let leaves = List<Observation>.asSlice(&segment.leaves)
  run RuntimeEncoding.word(&mut output, usize.toU64(leaves.length))
  at = usize.ZERO
  while at < leaves.length {
    let leaf = &leaves[at]
    run List<usize>.append(&mut leafOffsets, Bytes.length(&output))
    run RuntimeEncoding.field(&mut output, Bytes.asSlice(&leaf.key))
    run hash(&mut output, leaf.digest)
    run hash(&mut output, leaf.text)
    run RuntimeEncoding.word(&mut output, usize.toU64(leaf.position))
    match &leaf.file {
      Option<Reference>.None => { run RuntimeEncoding.word(&mut output, 0) }
      Option<Reference>.Some {value: file} => { run RuntimeEncoding.word(&mut output, 1) run reference(&mut output, file) }
    }
    run RuntimeEncoding.word(&mut output, u32.toU64(leaf.selector))
    let mut input: u64 = 0
    if leaf.input { input = 1 }
    run RuntimeEncoding.word(&mut output, input)
    at = at + usize.ONE
  }
  run List<usize>.append(&mut leafOffsets, Bytes.length(&output))
  let nodes = List<Node>.asSlice(&segment.nodes)
  run RuntimeEncoding.word(&mut output, usize.toU64(nodes.length))
  at = usize.ZERO
  while at < nodes.length {
    let edges = List<Edge>.asSlice(&nodes[at].edges)
    run List<usize>.append(&mut nodeOffsets, Bytes.length(&output))
    run RuntimeEncoding.word(&mut output, usize.toU64(edges.length))
    let mut edge = usize.ZERO
    while edge < edges.length {
      let mut kind: u64 = 0
      if edges[edge].node { kind = 1 }
      run RuntimeEncoding.word(&mut output, kind)
      run reference(&mut output, edges[edge].target)
      edge = edge + usize.ONE
    }
    at = at + usize.ONE
  }
  run List<usize>.append(&mut nodeOffsets, Bytes.length(&output))
  let roots = List<Root>.asSlice(&segment.roots)
  run RuntimeEncoding.word(&mut output, usize.toU64(roots.length))
  at = usize.ZERO
  while at < roots.length {
    let root = &roots[at]
    run List<usize>.append(&mut rootOffsets, Bytes.length(&output))
    run RuntimeEncoding.field(&mut output, Bytes.asSlice(&root.key))
    run reference(&mut output, root.node)
    run RuntimeEncoding.field(&mut output, Bytes.asSlice(&root.answer))
    let packs = List<ContentHash>.asSlice(&root.packs)
    run RuntimeEncoding.word(&mut output, usize.toU64(packs.length))
    let mut pack = usize.ZERO
    while pack < packs.length { run hash(&mut output, packs[pack]) pack = pack + usize.ONE }
    at = at + usize.ONE
  }
  run List<usize>.append(&mut rootOffsets, Bytes.length(&output))
  let indexStart = Bytes.length(&output)
  run RuntimeEncoding.word(&mut output, 1397049161)
  run writeOffsets(&mut output, List<usize>.asSlice(&leafOffsets))
  run writeOffsets(&mut output, List<usize>.asSlice(&nodeOffsets))
  run writeOffsets(&mut output, List<usize>.asSlice(&rootOffsets))
  run RuntimeEncoding.word(&mut output, usize.toU64(indexStart))
  let checksum = ContentHash.of(Bytes.asSlice(&output))
  run hash(&mut output, checksum)
  return Option<Bytes>.some(move output)
}

struct Reader {cursor: StableKey.Reader, failed: bool, items: usize}
fn word(bytes: &[u8], reader: &mut Reader) -> u64 {
  if reader.failed { return 0 }
  let value = StableKey.readWord(bytes, &mut reader.cursor)
  if StableKey.failed(&reader.cursor) { reader.failed = true }
  return value
}
fn size(bytes: &[u8], reader: &mut Reader) -> usize {
  let value = word(bytes, &mut reader.*)
  if value > usize.toU64(usize.MAX) { reader.failed = true return usize.ZERO }
  return u64.toUsize(value)
}
fn count(bytes: &[u8], reader: &mut Reader, limit: usize) -> usize {
  let value = size(bytes, &mut reader.*)
  if reader.failed || value > limit || !addBound(&mut reader.items, value, ITEM_LIMIT)
    || value > (bytes.length - StableKey.offset(&reader.cursor)) / 8 {
    reader.failed = true return usize.ZERO
  }
  return value
}
fn boolean(bytes: &[u8], reader: &mut Reader) -> bool {
  let value = word(bytes, &mut reader.*)
  if value > 1 { reader.failed = true }
  return value == 1
}
fn readHash(bytes: &[u8], reader: &mut Reader) -> ContentHash {
  let high = word(bytes, &mut reader.*)
  let low = word(bytes, &mut reader.*)
  return ContentHash {high: high, low: low}
}
fn readReference(bytes: &[u8], reader: &mut Reader) -> Reference {
  let segment = size(bytes, &mut reader.*)
  let index = size(bytes, &mut reader.*)
  return Reference {segment: segment, index: index}
}
effect fn field(bytes: &[u8], reader: &mut Reader) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  if reader.failed { return Bytes.make() }
  let span = StableKey.readField(bytes, &mut reader.cursor)
  if StableKey.failed(&reader.cursor) { reader.failed = true return Bytes.make() }
  return run Bytes.copy(StableKey.view(bytes, span))
}

/// Decodes exact source observations and bounded local topology, without admitting imports.
/// A generation must authenticate imports and selected root authority before using any answer.
pub effect fn decode(bytes: &[u8], expectedStamp: &[u8]) -> Option<Segment> ! OutOfMemoryError ? &mut Allocator {
  if bytes.length > BYTE_LIMIT || bytes.length < 16 { return Option<Segment>.none() }
  // Eager decoding is a test oracle; production keeps the sealed owner and borrowed views.
  if let Option<SealedSegment>.None = move run open(run Bytes.copy(bytes), expectedStamp) { return Option<Segment>.none() }
  let fullPayload = Slice.view<u8>(bytes, usize.ZERO, bytes.length - 16)
  let mut trailer = Reader {cursor: StableKey.reader(), failed: false, items: usize.ZERO}
  let checksum = readHash(Slice.view<u8>(bytes, bytes.length - 16, 16), &mut trailer)
  if !ContentHash.equals(checksum, ContentHash.of(fullPayload)) || fullPayload.length < 8 { return Option<Segment>.none() }
  let mut footer = Reader {cursor: StableKey.reader(), failed: false, items: usize.ZERO}
  let indexStart = size(Slice.view<u8>(fullPayload, fullPayload.length - 8, 8), &mut footer)
  if footer.failed || indexStart > fullPayload.length - 8 { return Option<Segment>.none() }
  let payload = Slice.view<u8>(fullPayload, usize.ZERO, indexStart)
  let mut reader = Reader {cursor: StableKey.reader(), failed: false, items: usize.ZERO}
  let magic = run field(payload, &mut reader)
  if !same(Bytes.asSlice(&magic), b"silk-cache-segment-v2") || word(payload, &mut reader) != 1 { return Option<Segment>.none() }
  let serial = word(payload, &mut reader)
  let stamp = run field(payload, &mut reader)
  if !same(Bytes.asSlice(&stamp), expectedStamp) { return Option<Segment>.none() }
  let mut segment = Segment {serial: serial, stamp: move stamp, imports: List<Descriptor>.make(),
    leaves: List<Observation>.make(), nodes: List<Node>.make(), roots: List<Root>.make()}
  let imports = count(payload, &mut reader, IMPORT_LIMIT)
  let mut at = usize.ZERO
  while at < imports && !reader.failed {
    let digest = readHash(payload, &mut reader)
    let importedSerial = word(payload, &mut reader)
    let leaves = size(payload, &mut reader)
    let nodes = size(payload, &mut reader)
    let roots = size(payload, &mut reader)
    run List<Descriptor>.append(&mut segment.imports, Descriptor {digest: digest, serial: importedSerial,
      leaves: leaves, nodes: nodes, roots: roots})
    at = at + usize.ONE
  }
  let leaves = count(payload, &mut reader, ENTRY_LIMIT)
  at = usize.ZERO
  while at < leaves && !reader.failed {
    let key = run field(payload, &mut reader)
    let digest = readHash(payload, &mut reader)
    let text = readHash(payload, &mut reader)
    let position = size(payload, &mut reader)
    let hasFile = boolean(payload, &mut reader)
    let mut file = Option<Reference>.none()
    if hasFile { file = Option<Reference>.some(readReference(payload, &mut reader)) }
    let selector = word(payload, &mut reader)
    if selector > u32.toU64(u32.MAX) { reader.failed = true }
    let input = boolean(payload, &mut reader)
    run List<Observation>.append(&mut segment.leaves, Observation {key: move key, digest: digest,
      text: text, position: position, file: move file, selector: u64.toU32(selector), input: input})
    at = at + usize.ONE
  }
  let nodes = count(payload, &mut reader, ENTRY_LIMIT)
  at = usize.ZERO
  while at < nodes && !reader.failed {
    let total = count(payload, &mut reader, ENTRY_LIMIT)
    let mut edges = List<Edge>.make()
    let mut edge = usize.ZERO
    while edge < total && !reader.failed {
      let node = boolean(payload, &mut reader)
      let target = readReference(payload, &mut reader)
      run List<Edge>.append(&mut edges, Edge {node: node, target: target})
      edge = edge + usize.ONE
    }
    run List<Node>.append(&mut segment.nodes, Node {edges: move edges})
    at = at + usize.ONE
  }
  let roots = count(payload, &mut reader, ENTRY_LIMIT)
  at = usize.ZERO
  while at < roots && !reader.failed {
    let key = run field(payload, &mut reader)
    let node = readReference(payload, &mut reader)
    let answer = run field(payload, &mut reader)
    let total = count(payload, &mut reader, ENTRY_LIMIT)
    let mut packs = List<ContentHash>.make()
    let mut pack = usize.ZERO
    while pack < total && !reader.failed {
      run List<ContentHash>.append(&mut packs, readHash(payload, &mut reader))
      pack = pack + usize.ONE
    }
    run List<Root>.append(&mut segment.roots, Root {key: move key, node: node, answer: move answer, packs: move packs})
    at = at + usize.ONE
  }
  if reader.failed || !StableKey.finished(payload, &reader.cursor) || !localValid(&segment) { return Option<Segment>.none() }
  return Option<Segment>.some(move segment)
}

/// Describes the exact bytes produced for a locally valid segment. The caller binds decoded
/// segments to their own bytes before admitting the resulting descriptor into a catalog.
pub fn describe(segment: &Segment, encodedBytes: &[u8]) -> Descriptor {
  return Descriptor {digest: ContentHash.of(Slice.view<u8>(encodedBytes, usize.ZERO, encodedBytes.length - 16)), serial: segment.serial,
    leaves: List<Observation>.length(&segment.leaves), nodes: List<Node>.length(&segment.nodes),
    roots: List<Root>.length(&segment.roots)}
}

/// Derives the source-file bitmap of an already fully admitted segment.
pub effect fn admission(segment: &Segment, encodedBytes: &[u8]) -> Admission ! OutOfMemoryError ? &mut Allocator {
  let leaves = List<Observation>.asSlice(&segment.leaves)
  let mut bitmap = Bytes.make()
  let mut at = usize.ZERO
  while at < leaves.length {
    let mut byte: u8 = 0
    let mut bit = usize.ZERO
    while bit < 8 && at + bit < leaves.length {
      if !leaves[at + bit].input { byte = u8.bitOr(byte, u64.toU8(u64.shiftLeft(1, usize.toU64(bit)))) }
      bit = bit + usize.ONE
    }
    run Bytes.append(&mut bitmap, &[byte])
    at = at + 8
  }
  return Admission {descriptor: describe(segment, encodedBytes), sourceLeaves: move bitmap}
}

/// Authenticates imports against previously admitted descriptors and checks that every remote
/// file reference names a whole-file observation. Strict serial order excludes import cycles.
pub fn validateImports(segment: &Segment, admitted: &[Admission]) -> bool {
  if !localValid(segment) { return false }
  let imports = List<Descriptor>.asSlice(&segment.imports)
  let mut at = usize.ZERO
  while at < imports.length {
    let mut found = usize.MAX
    let mut held = usize.ZERO
    while held < admitted.length {
      if ContentHash.equals(admitted[held].descriptor.digest, imports[at].digest) {
        if found != usize.MAX || !sameDescriptor(admitted[held].descriptor, imports[at]) { return false }
        found = held
      }
      held = held + usize.ONE
    }
    if found == usize.MAX { return false }
    let bitmap = Bytes.asSlice(&admitted[found].sourceLeaves)
    if bitmap.length != (imports[at].leaves + 7) / 8 { return false }
    let leaves = List<Observation>.asSlice(&segment.leaves)
    let mut leaf = usize.ZERO
    while leaf < leaves.length {
      if let Option<Reference>.Some {value: file} = &leaves[leaf].file {
        if file.segment == at + usize.ONE {
          let mask = u64.shiftLeft(1, usize.toU64(file.index % 8))
          if u64.bitAnd(u8.toU64(bitmap[file.index / 8]), mask) == 0 { return false }
        }
      }
      leaf = leaf + usize.ONE
    }
    at = at + usize.ONE
  }
  return true
}

effect fn writeOffsets(output: &mut Bytes, offsets: &[usize]) -> () ! OutOfMemoryError ? &mut Allocator {
  run RuntimeEncoding.word(&mut output.*, usize.toU64(offsets.length))
  let mut at = usize.ZERO
  while at < offsets.length { run RuntimeEncoding.word(&mut output.*, usize.toU64(offsets[at])) at = at + usize.ONE }
}

/// An owned authenticated packet with indexed records. Fields are private so a descriptor,
/// answer, source-file bitmap or root key cannot be substituted after authentication.
pub struct SealedSegment {
  bytes: Bytes,
  identity: Descriptor,
  stampAt: Span,
  imported: List<Descriptor>,
  leafOffsets: List<usize>,
  nodeOffsets: List<usize>,
  rootOffsets: List<usize>,
  anchorIndexes: List<usize>,
  sourceFiles: Bytes,
}

/// A borrowed exact observation; keys remain in the sealed packet.
pub struct ObservationView<'a> {
  pub key: &'a [u8],
  pub digest: ContentHash,
  pub text: ContentHash,
  pub position: usize,
  pub file: Option<Reference>,
  pub selector: u32,
  pub input: bool,
}

/// The content-derived identity of an immutable owner.
pub fn descriptor(owner: &SealedSegment) -> Descriptor { return owner.identity }
/// Exact compiler/profile stamp from the authenticated packet.
pub fn stamp<'a>(owner: &'a SealedSegment) -> &'a [u8] { return StableKey.view(Bytes.asSlice(&owner.bytes), owner.stampAt) }
/// Declared imports, which `authenticateImports` binds to previously sealed owners.
pub fn imports(owner: &SealedSegment) -> &[Descriptor] { return List<Descriptor>.asSlice(&owner.imported) }
/// The original immutable packet, suitable for publication without encoding again.
pub fn encoded(owner: &SealedSegment) -> &[u8] { return Bytes.asSlice(&owner.bytes) }
/// Indexes of every leaf that must be checked even when recorded source files are unchanged.
pub fn anchors(owner: &SealedSegment) -> &[usize] { return List<usize>.asSlice(&owner.anchorIndexes) }

fn record<'a>(owner: &'a SealedSegment, offsets: &[usize], at: usize) -> Option<&'a [u8]> {
  if offsets.length == usize.ZERO || at >= offsets.length - usize.ONE { return Option<&[u8]>.none() }
  return Option<&[u8]>.some(Slice.view<u8>(Bytes.asSlice(&owner.bytes), offsets[at], offsets[at + usize.ONE] - offsets[at]))
}
fn readSpan(bytes: &[u8], reader: &mut Reader) -> Span {
  if reader.failed { return Span.make(usize.ZERO, usize.ZERO) }
  let span = StableKey.readField(bytes, &mut reader.cursor)
  if StableKey.failed(&reader.cursor) { reader.failed = true }
  return span
}
fn validOwnedReference(owner: &SealedSegment, target: Reference, node: bool, before: usize) -> bool {
  if target.segment == usize.ZERO {
    if node { return target.index < before }
    return target.index < owner.identity.leaves
  }
  let imported = imports(owner)
  if target.segment > imported.length { return false }
  if node { return target.index < imported[target.segment - usize.ONE].nodes }
  return target.index < imported[target.segment - usize.ONE].leaves
}

/// Reads a bounded source record without copying its key or changing its original file stamp.
pub fn observation<'a>(owner: &'a SealedSegment, at: usize) -> Option<ObservationView<'a>> {
  let bytes = match move record(owner, List<usize>.asSlice(&owner.leafOffsets), at) {
    Option<&[u8]>.Some {value} => value
    Option<&[u8]>.None => { return Option<ObservationView>.none() }
  }
  let mut reader = Reader {cursor: StableKey.reader(), failed: false, items: usize.ZERO}
  let key = readSpan(bytes, &mut reader)
  let digest = readHash(bytes, &mut reader)
  let text = readHash(bytes, &mut reader)
  let position = size(bytes, &mut reader)
  let hasFile = boolean(bytes, &mut reader)
  let mut file = Option<Reference>.none()
  if hasFile { file = Option<Reference>.some(readReference(bytes, &mut reader)) }
  let selector = word(bytes, &mut reader)
  let input = boolean(bytes, &mut reader)
  if reader.failed || selector > u32.toU64(u32.MAX) || !StableKey.finished(bytes, &reader.cursor) { return Option<ObservationView>.none() }
  if let Option<Reference>.Some {value: reference} = &file {
    if !input || !validOwnedReference(owner, reference, false, usize.ZERO) { return Option<ObservationView>.none() }
  }
  return Option<ObservationView>.some(ObservationView {key: StableKey.view(bytes, key), digest: digest,
    text: text, position: position, file: move file, selector: u64.toU32(selector), input: input})
}

struct RootView<'a> {key: &'a [u8], node: Reference, answer: &'a [u8], packs: &'a [u8]}
fn rootView<'a>(owner: &'a SealedSegment, at: usize) -> Option<RootView<'a>> {
  let bytes = match move record(owner, List<usize>.asSlice(&owner.rootOffsets), at) {
    Option<&[u8]>.Some {value} => value
    Option<&[u8]>.None => { return Option<RootView>.none() }
  }
  let mut reader = Reader {cursor: StableKey.reader(), failed: false, items: usize.ZERO}
  let key = readSpan(bytes, &mut reader)
  let node = readReference(bytes, &mut reader)
  let answer = readSpan(bytes, &mut reader)
  let packs = size(bytes, &mut reader)
  let offset = StableKey.offset(&reader.cursor)
  if reader.failed || packs > ENTRY_LIMIT || packs > (bytes.length - offset) / 16
    || packs * 16 != bytes.length - offset || !validOwnedReference(owner, node, true, owner.identity.nodes) { return Option<RootView>.none() }
  return Option<RootView>.some(RootView {key: StableKey.view(bytes, key), node: node,
    answer: StableKey.view(bytes, answer), packs: Slice.view<u8>(bytes, offset, packs * 16)})
}
/// Borrows the exact stored root key; an invalid root ordinal refuses.
pub fn rootKey<'a>(owner: &'a SealedSegment, at: usize) -> Option<&'a [u8]> {
  return match move rootView(owner, at) { Option<RootView>.Some {value} => Option<&[u8]>.some(value.key) Option<RootView>.None => Option<&[u8]>.none() }
}
/// Borrows answer bytes without decoding or copying the answer payload.
pub fn rootAnswer<'a>(owner: &'a SealedSegment, at: usize) -> Option<&'a [u8]> {
  return match move rootView(owner, at) { Option<RootView>.Some {value} => Option<&[u8]>.some(value.answer) Option<RootView>.None => Option<&[u8]>.none() }
}
/// The root's dependency handle, retaining its exact imported segment ownership.
pub fn rootNode(owner: &SealedSegment, at: usize) -> Option<Reference> {
  return match move rootView(owner, at) { Option<RootView>.Some {value} => Option<Reference>.some(value.node) Option<RootView>.None => Option<Reference>.none() }
}
/// Number of required pack digests, or zero for an invalid root ordinal.
pub fn rootPackCount(owner: &SealedSegment, at: usize) -> usize {
  return match move rootView(owner, at) { Option<RootView>.Some {value} => value.packs.length / 16 Option<RootView>.None => usize.ZERO }
}
/// One required pack digest. This is a requirement; filesystem pinning belongs to the driver.
pub fn rootPack(owner: &SealedSegment, at: usize, pack: usize) -> Option<ContentHash> {
  let root = match move rootView(owner, at) { Option<RootView>.Some {value} => move value Option<RootView>.None => { return Option<ContentHash>.none() } }
  if pack >= root.packs.length / 16 { return Option<ContentHash>.none() }
  let mut reader = Reader {cursor: StableKey.reader(), failed: false, items: usize.ZERO}
  return Option<ContentHash>.some(readHash(Slice.view<u8>(root.packs, pack * 16, 16), &mut reader))
}

/// The bounded number of dependencies in a node. Dependency references are checked by `edge`.
pub fn edgeCount(owner: &SealedSegment, node: usize) -> Option<usize> {
  let bytes = match move record(owner, List<usize>.asSlice(&owner.nodeOffsets), node) {
    Option<&[u8]>.Some {value} => value Option<&[u8]>.None => { return Option<usize>.none() }
  }
  let mut reader = Reader {cursor: StableKey.reader(), failed: false, items: usize.ZERO}
  let count = size(bytes, &mut reader)
  if reader.failed || count > ENTRY_LIMIT || count > (bytes.length - 8) / 24 || count * 24 != bytes.length - 8 { return Option<usize>.none() }
  return Option<usize>.some(count)
}
/// Reads and validates one dependency. Callers must validate every edge of a guard before
/// reusing its answer; malformed topology never becomes a green dependency.
pub fn edge(owner: &SealedSegment, node: usize, at: usize) -> Option<Edge> {
  let count = match move edgeCount(owner, node) { Option<usize>.Some {value} => value Option<usize>.None => { return Option<Edge>.none() } }
  if at >= count { return Option<Edge>.none() }
  let offsets = List<usize>.asSlice(&owner.nodeOffsets)
  let bytes = Slice.view<u8>(Bytes.asSlice(&owner.bytes), offsets[node] + 8 + at * 24, 24)
  let mut reader = Reader {cursor: StableKey.reader(), failed: false, items: usize.ZERO}
  let isNode = boolean(bytes, &mut reader)
  let target = readReference(bytes, &mut reader)
  if reader.failed || !validOwnedReference(owner, target, isNode, node) { return Option<Edge>.none() }
  return Option<Edge>.some(Edge {node: isNode, target: target})
}

effect fn readOffsets(bytes: &[u8], reader: &mut Reader, bodyLength: usize, minimum: usize) -> List<usize>
! OutOfMemoryError ? &mut Allocator {
  let total = count(bytes, &mut reader.*, ENTRY_LIMIT + usize.ONE)
  let mut result = List<usize>.make()
  if total == usize.ZERO { reader.failed = true return move result }
  let mut previous = usize.ZERO
  let mut at = usize.ZERO
  while at < total && !reader.failed {
    let offset = size(bytes, &mut reader.*)
    if reader.failed || offset > bodyLength || (at > usize.ZERO && (offset < previous || offset - previous < minimum)) {
      reader.failed = true break
    }
    run List<usize>.append(&mut result, offset)
    previous = offset
    at = at + usize.ONE
  }
  return move result
}
fn countAt(body: &[u8], at: usize, expected: usize) -> bool {
  if at > body.length || body.length - at < 8 { return false }
  let mut reader = Reader {cursor: StableKey.reader(), failed: false, items: usize.ZERO}
  return word(Slice.view<u8>(body, at, 8), &mut reader) == usize.toU64(expected) && !reader.failed
}
fn sourceLeaf(owner: &SealedSegment, at: usize) -> bool {
  if at >= owner.identity.leaves { return false }
  let bitmap = Bytes.asSlice(&owner.sourceFiles)
  return u64.bitAnd(u8.toU64(bitmap[at / 8]), u64.shiftLeft(1, usize.toU64(at % 8))) != 0
}

/// Authenticates raw bytes and indexes, retaining payloads in their original immutable packet.
/// Opening scans source routing metadata and record boundaries, not dependency edges or answers.
/// A generation must authenticate imports and selected keys before consulting these views.
pub effect fn open(bytes: Bytes, expectedStamp: &[u8]) -> Option<SealedSegment> ! OutOfMemoryError ? &mut Allocator {
  let raw = Bytes.asSlice(&bytes)
  if raw.length > BYTE_LIMIT || raw.length < 24 { return Option<SealedSegment>.none() }
  let payload = Slice.view<u8>(raw, usize.ZERO, raw.length - 16)
  let mut trailer = Reader {cursor: StableKey.reader(), failed: false, items: usize.ZERO}
  let checksum = readHash(Slice.view<u8>(raw, raw.length - 16, 16), &mut trailer)
  if !ContentHash.equals(checksum, ContentHash.of(payload)) { return Option<SealedSegment>.none() }
  let mut footer = Reader {cursor: StableKey.reader(), failed: false, items: usize.ZERO}
  let indexStart = size(Slice.view<u8>(payload, payload.length - 8, 8), &mut footer)
  if footer.failed || indexStart > payload.length - 8 { return Option<SealedSegment>.none() }
  let body = Slice.view<u8>(payload, usize.ZERO, indexStart)
  let index = Slice.view<u8>(payload, indexStart, payload.length - 8 - indexStart)
  let mut indexed = Reader {cursor: StableKey.reader(), failed: false, items: usize.ZERO}
  if word(index, &mut indexed) != 1397049161 { return Option<SealedSegment>.none() }
  let leafOffsets = run readOffsets(index, &mut indexed, body.length, 72)
  let nodeOffsets = run readOffsets(index, &mut indexed, body.length, 8)
  let rootOffsets = run readOffsets(index, &mut indexed, body.length, 40)
  if indexed.failed || !StableKey.finished(index, &indexed.cursor) { return Option<SealedSegment>.none() }
  let leafPositions = List<usize>.asSlice(&leafOffsets)
  let nodePositions = List<usize>.asSlice(&nodeOffsets)
  let rootPositions = List<usize>.asSlice(&rootOffsets)
  let leaves = leafPositions.length - usize.ONE
  let nodes = nodePositions.length - usize.ONE
  let roots = rootPositions.length - usize.ONE
  let mut reader = Reader {cursor: StableKey.reader(), failed: false, items: usize.ZERO}
  let magic = readSpan(body, &mut reader)
  if !same(StableKey.view(body, magic), b"silk-cache-segment-v2") || word(body, &mut reader) != 1 { return Option<SealedSegment>.none() }
  let serial = word(body, &mut reader)
  let stampAt = readSpan(body, &mut reader)
  if !same(StableKey.view(body, stampAt), expectedStamp) { return Option<SealedSegment>.none() }
  let total = count(body, &mut reader, IMPORT_LIMIT)
  let mut imported = List<Descriptor>.make()
  let mut at = usize.ZERO
  while at < total && !reader.failed {
    let digest = readHash(body, &mut reader)
    let heldSerial = word(body, &mut reader)
    let heldLeaves = size(body, &mut reader)
    let heldNodes = size(body, &mut reader)
    let heldRoots = size(body, &mut reader)
    if reader.failed || heldSerial >= serial || heldLeaves > ENTRY_LIMIT || heldNodes > ENTRY_LIMIT || heldRoots > ENTRY_LIMIT { return Option<SealedSegment>.none() }
    let earlier = List<Descriptor>.asSlice(&imported)
    let mut previous = usize.ZERO
    while previous < earlier.length {
      if ContentHash.equals(earlier[previous].digest, digest) { return Option<SealedSegment>.none() }
      previous = previous + usize.ONE
    }
    run List<Descriptor>.append(&mut imported, Descriptor {digest: digest, serial: heldSerial, leaves: heldLeaves, nodes: heldNodes, roots: heldRoots})
    at = at + usize.ONE
  }
  if reader.failed || !countAt(body, StableKey.offset(&reader.cursor), leaves)
    || leafPositions[0] != StableKey.offset(&reader.cursor) + 8
    || !countAt(body, leafPositions[leaves], nodes) || nodePositions[0] != leafPositions[leaves] + 8
    || !countAt(body, nodePositions[nodes], roots) || rootPositions[0] != nodePositions[nodes] + 8
    || rootPositions[roots] != body.length { return Option<SealedSegment>.none() }
  let mut owner = SealedSegment {bytes: move bytes, identity: Descriptor {digest: checksum, serial: serial, leaves: leaves, nodes: nodes, roots: roots},
    stampAt: stampAt, imported: move imported, leafOffsets: move leafOffsets, nodeOffsets: move nodeOffsets,
    rootOffsets: move rootOffsets, anchorIndexes: List<usize>.make(), sourceFiles: Bytes.make()}
  let mut byte = usize.ZERO
  while byte < (leaves + 7) / 8 { run Bytes.append(&mut owner.sourceFiles, &[0]) byte = byte + usize.ONE }
  at = usize.ZERO
  while at < leaves {
    let observed = match move observation(&owner, at) { Option<ObservationView>.Some {value} => move value Option<ObservationView>.None => { return Option<SealedSegment>.none() } }
    let mut anchored = !observed.input || ContentHash.equals(observed.digest, ContentHash {high: 0, low: 0})
      || observed.selector == u32.MAX || observed.selector == 12 || observed.selector == 13
    if let Option<Reference>.None = &observed.file { anchored = true }
    let isFile = !observed.input
    if anchored { run List<usize>.append(&mut owner.anchorIndexes, at) }
    if isFile {
      let bitmap = Bytes.asMutSlice(&mut owner.sourceFiles)
      bitmap[at / 8] = u8.bitOr(bitmap[at / 8], u64.toU8(u64.shiftLeft(1, usize.toU64(at % 8))))
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < leaves {
    let observed = match move observation(&owner, at) { Option<ObservationView>.Some {value} => move value Option<ObservationView>.None => { return Option<SealedSegment>.none() } }
    if let Option<Reference>.Some {value: file} = &observed.file {
      if file.segment == usize.ZERO && !sourceLeaf(&owner, file.index) { return Option<SealedSegment>.none() }
    }
    at = at + usize.ONE
  }
  let mut items = leaves + nodes + roots + total
  at = usize.ZERO
  while at < nodes {
    let edges = match move edgeCount(&owner, at) { Option<usize>.Some {value} => value Option<usize>.None => { return Option<SealedSegment>.none() } }
    if !addBound(&mut items, edges, ITEM_LIMIT) { return Option<SealedSegment>.none() }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < roots {
    if let Option<RootView>.None = move rootView(&owner, at) { return Option<SealedSegment>.none() }
    if !addBound(&mut items, rootPackCount(&owner, at), ITEM_LIMIT) { return Option<SealedSegment>.none() }
    at = at + usize.ONE
  }
  return Option<SealedSegment>.some(move owner)
}

fn importedOwner(admitted: &[SealedSegment], expected: Descriptor) -> usize {
  let mut found = usize.MAX
  let mut at = usize.ZERO
  while at < admitted.length {
    if ContentHash.equals(admitted[at].identity.digest, expected.digest) {
      if found != usize.MAX || !sameDescriptor(admitted[at].identity, expected) { return usize.MAX }
      found = at
    }
    at = at + usize.ONE
  }
  return found
}

/// Binds every imported descriptor and remote whole-file observation to an immutable owner.
/// Node payloads remain lazy; a consumer must validate the edges of each guard it uses.
pub fn authenticateImports(owner: &SealedSegment, admitted: &[SealedSegment]) -> bool {
  let imported = imports(owner)
  let mut at = usize.ZERO
  while at < imported.length {
    if importedOwner(admitted, imported[at]) == usize.MAX { return false }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < owner.identity.leaves {
    let observed = match move observation(owner, at) { Option<ObservationView>.Some {value} => move value Option<ObservationView>.None => { return false } }
    if let Option<Reference>.Some {value: file} = &observed.file {
      if file.segment != usize.ZERO {
        let held = importedOwner(admitted, imported[file.segment - usize.ONE])
        if held == usize.MAX || !sourceLeaf(&admitted[held], file.index) { return false }
      }
    }
    at = at + usize.ONE
  }
  return true
}

/// Consumes a fresh mutable builder, encodes it once, and binds the resulting immutable owner
/// to existing imports. No API accepts an unrelated owner and byte packet as one authority.
pub effect fn seal(segment: Segment, admitted: &[SealedSegment]) -> Option<SealedSegment> ! OutOfMemoryError ? &mut Allocator {
  let bytes = match move run encode(&segment) { Option<Bytes>.Some {value} => move value Option<Bytes>.None => { return Option<SealedSegment>.none() } }
  let owner = match move run open(move bytes, Bytes.asSlice(&segment.stamp)) {
    Option<SealedSegment>.Some {value} => move value Option<SealedSegment>.None => { return Option<SealedSegment>.none() }
  }
  if !authenticateImports(&owner, admitted) { return Option<SealedSegment>.none() }
  return Option<SealedSegment>.some(move owner)
}
