//! Immutable portions of a semantic cache generation.
//!
//! Decoding checks bounds and local topology. Before a decoded segment can supply answers,
//! its generation must authenticate every import with `validateImports`, validate selected
//! root keys, and retain the segments and packs that generation names. Source observations
//! are immutable: a newer file position or fingerprint belongs in a new observation.

import semantic.ContentHash {ContentHash}
import semantic.RuntimeEncoding
import semantic.StableKey
import silk.collections.bytes {Bytes}
import silk.collections.list {List}
import silk.collections.slice {Slice}
import silk.core.option {Option}
import silk.core.ownership {Copy}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.num.u8
import silk.num.u32
import silk.num.u64
import silk.num.usize

/// Maximum encoded bytes in one independently authenticated segment.
pub const BYTE_LIMIT: usize = 8388608
/// Maximum imports in one segment; a generation separately bounds its whole catalog.
pub const IMPORT_LIMIT: usize = 256
/// Maximum leaves, nodes, roots, or references of one kind in one segment.
pub const ENTRY_LIMIT: usize = 131072
/// Maximum cumulative structural entries allocated by a segment decoder.
pub const ITEM_LIMIT: usize = 524288

/// A local item when `segment` is zero, otherwise an item of import `segment - 1`.
pub struct Reference {pub segment: usize, pub index: usize}
impl Copy for Reference {}

/// The exact content and topology of a previously admitted immutable segment.
pub struct Descriptor {
  pub digest: ContentHash,
  pub serial: u64,
  pub leaves: usize,
  pub nodes: usize,
  pub roots: usize,
}
impl Copy for Descriptor {}

/// A dependency edge; `node` distinguishes node references from leaf references.
pub struct Edge {pub node: bool, pub target: Reference}
impl Copy for Edge {}

/// A source observation, including the original file snapshot its position describes.
pub struct Observation {
  pub key: Bytes,
  pub digest: ContentHash,
  pub text: ContentHash,
  pub position: usize,
  pub file: Option<Reference>,
  pub selector: u32,
  pub input: bool,
}

/// One dependency node; local node dependencies precede it in the segment.
pub struct Node {pub edges: List<Edge>}

/// One answer and the native pack digests required by that answer.
pub struct Root {
  pub key: Bytes,
  pub node: Reference,
  pub answer: Bytes,
  pub packs: List<ContentHash>,
}

/// Immutable source observations, graph nodes, and answers under one compiler/profile stamp.
pub struct Segment {
  pub serial: u64,
  pub stamp: Bytes,
  pub imports: List<Descriptor>,
  pub leaves: List<Observation>,
  pub nodes: List<Node>,
  pub roots: List<Root>,
}

/// Metadata derived from an already admitted segment; never trust a packet's own import claims.
pub struct Admission {
  pub descriptor: Descriptor,
  /// Bit `i` is set exactly when leaf `i` is a whole source file.
  pub sourceLeaves: Bytes,
}

/// An empty segment. Its serial must be greater than every imported segment's serial.
pub effect fn make(serial: u64, stamp: &[u8]) -> Segment ! OutOfMemoryError ? &mut Allocator {
  return Segment {serial: serial, stamp: run Bytes.copy(stamp), imports: List<Descriptor>.make(),
    leaves: List<Observation>.make(), nodes: List<Node>.make(), roots: List<Root>.make()}
}

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut at = usize.ZERO
  while at < left.length { if left[at] != right[at] { return false } at = at + usize.ONE }
  return true
}

/// Whether two segment descriptors name exactly the same content and topology.
pub fn sameDescriptor(left: Descriptor, right: Descriptor) -> bool {
  return ContentHash.equals(left.digest, right.digest) && left.serial == right.serial
    && left.leaves == right.leaves && left.nodes == right.nodes && left.roots == right.roots
}

fn validReference(segment: &Segment, reference: Reference, node: bool, before: usize) -> bool {
  if reference.segment == usize.ZERO {
    if node { return reference.index < before }
    return reference.index < List<Observation>.length(&segment.leaves)
  }
  let imports = List<Descriptor>.asSlice(&segment.imports)
  if reference.segment > imports.length { return false }
  let imported = imports[reference.segment - usize.ONE]
  if node { return reference.index < imported.nodes }
  return reference.index < imported.leaves
}

fn addBound(total: &mut usize, count: usize, limit: usize) -> bool {
  if count > limit || total.* > limit - count { return false }
  total.* = total.* + count
  return true
}

// Validates before encoding and after decoding. Exact byte accounting bounds allocations made
// by the encoder; input byte bounds plus the cumulative item budget bound the decoder.
fn localValid(segment: &Segment) -> bool {
  let imports = List<Descriptor>.asSlice(&segment.imports)
  let leaves = List<Observation>.asSlice(&segment.leaves)
  let nodes = List<Node>.asSlice(&segment.nodes)
  let roots = List<Root>.asSlice(&segment.roots)
  if imports.length > IMPORT_LIMIT || leaves.length > ENTRY_LIMIT || nodes.length > ENTRY_LIMIT || roots.length > ENTRY_LIMIT {
    return false
  }
  let mut items = usize.ZERO
  if !addBound(&mut items, imports.length, ITEM_LIMIT) || !addBound(&mut items, leaves.length, ITEM_LIMIT)
    || !addBound(&mut items, nodes.length, ITEM_LIMIT) || !addBound(&mut items, roots.length, ITEM_LIMIT) { return false }
  // Magic field, version, serial, stamp field, four counts, and checksum.
  let mut bytes: usize = 104
  if !addBound(&mut bytes, Bytes.length(&segment.stamp), BYTE_LIMIT) { return false }
  let mut at = usize.ZERO
  while at < imports.length {
    let imported = imports[at]
    if imported.serial >= segment.serial || imported.leaves > ENTRY_LIMIT || imported.nodes > ENTRY_LIMIT || imported.roots > ENTRY_LIMIT {
      return false
    }
    let mut earlier = usize.ZERO
    while earlier < at {
      if ContentHash.equals(imports[earlier].digest, imported.digest) { return false }
      earlier = earlier + usize.ONE
    }
    if !addBound(&mut bytes, 48, BYTE_LIMIT) { return false }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < leaves.length {
    let leaf = &leaves[at]
    if !addBound(&mut bytes, 72, BYTE_LIMIT) || !addBound(&mut bytes, Bytes.length(&leaf.key), BYTE_LIMIT) { return false }
    if let Option<Reference>.Some {value: file} = &leaf.file {
      if !leaf.input || !validReference(segment, file, false, usize.ZERO) { return false }
      if file.segment == usize.ZERO && leaves[file.index].input { return false }
      if !addBound(&mut bytes, 16, BYTE_LIMIT) { return false }
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < nodes.length {
    let edges = List<Edge>.asSlice(&nodes[at].edges)
    if edges.length > ENTRY_LIMIT || !addBound(&mut items, edges.length, ITEM_LIMIT) || !addBound(&mut bytes, 8, BYTE_LIMIT) { return false }
    let mut edge = usize.ZERO
    while edge < edges.length {
      if !validReference(segment, edges[edge].target, edges[edge].node, at) || !addBound(&mut bytes, 24, BYTE_LIMIT) { return false }
      edge = edge + usize.ONE
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < roots.length {
    let root = &roots[at]
    let packs = List<ContentHash>.asSlice(&root.packs)
    if !validReference(segment, root.node, true, nodes.length) || packs.length > ENTRY_LIMIT
      || !addBound(&mut items, packs.length, ITEM_LIMIT) || !addBound(&mut bytes, 40, BYTE_LIMIT)
      || !addBound(&mut bytes, Bytes.length(&root.key), BYTE_LIMIT)
      || !addBound(&mut bytes, Bytes.length(&root.answer), BYTE_LIMIT) { return false }
    let mut pack = usize.ZERO
    while pack < packs.length { if !addBound(&mut bytes, 16, BYTE_LIMIT) { return false } pack = pack + usize.ONE }
    at = at + usize.ONE
  }
  return true
}

effect fn hash(output: &mut Bytes, value: ContentHash) -> () ! OutOfMemoryError ? &mut Allocator {
  run RuntimeEncoding.word(&mut output.*, value.high)
  run RuntimeEncoding.word(&mut output.*, value.low)
}
effect fn reference(output: &mut Bytes, value: Reference) -> () ! OutOfMemoryError ? &mut Allocator {
  run RuntimeEncoding.word(&mut output.*, usize.toU64(value.segment))
  run RuntimeEncoding.word(&mut output.*, usize.toU64(value.index))
}

/// Encodes bounded local topology. Import authority is checked separately by `validateImports`.
pub effect fn encode(segment: &Segment) -> Option<Bytes> ! OutOfMemoryError ? &mut Allocator {
  if !localValid(segment) { return Option<Bytes>.none() }
  let mut output = Bytes.make()
  run RuntimeEncoding.field(&mut output, b"silk-cache-segment-v1")
  run RuntimeEncoding.word(&mut output, 1)
  run RuntimeEncoding.word(&mut output, segment.serial)
  run RuntimeEncoding.field(&mut output, Bytes.asSlice(&segment.stamp))
  let imports = List<Descriptor>.asSlice(&segment.imports)
  run RuntimeEncoding.word(&mut output, usize.toU64(imports.length))
  let mut at = usize.ZERO
  while at < imports.length {
    let imported = imports[at]
    run hash(&mut output, imported.digest)
    run RuntimeEncoding.word(&mut output, imported.serial)
    run RuntimeEncoding.word(&mut output, usize.toU64(imported.leaves))
    run RuntimeEncoding.word(&mut output, usize.toU64(imported.nodes))
    run RuntimeEncoding.word(&mut output, usize.toU64(imported.roots))
    at = at + usize.ONE
  }
  let leaves = List<Observation>.asSlice(&segment.leaves)
  run RuntimeEncoding.word(&mut output, usize.toU64(leaves.length))
  at = usize.ZERO
  while at < leaves.length {
    let leaf = &leaves[at]
    run RuntimeEncoding.field(&mut output, Bytes.asSlice(&leaf.key))
    run hash(&mut output, leaf.digest)
    run hash(&mut output, leaf.text)
    run RuntimeEncoding.word(&mut output, usize.toU64(leaf.position))
    match &leaf.file {
      Option<Reference>.None => { run RuntimeEncoding.word(&mut output, 0) }
      Option<Reference>.Some {value: file} => { run RuntimeEncoding.word(&mut output, 1) run reference(&mut output, file) }
    }
    run RuntimeEncoding.word(&mut output, u32.toU64(leaf.selector))
    let mut input: u64 = 0
    if leaf.input { input = 1 }
    run RuntimeEncoding.word(&mut output, input)
    at = at + usize.ONE
  }
  let nodes = List<Node>.asSlice(&segment.nodes)
  run RuntimeEncoding.word(&mut output, usize.toU64(nodes.length))
  at = usize.ZERO
  while at < nodes.length {
    let edges = List<Edge>.asSlice(&nodes[at].edges)
    run RuntimeEncoding.word(&mut output, usize.toU64(edges.length))
    let mut edge = usize.ZERO
    while edge < edges.length {
      let mut kind: u64 = 0
      if edges[edge].node { kind = 1 }
      run RuntimeEncoding.word(&mut output, kind)
      run reference(&mut output, edges[edge].target)
      edge = edge + usize.ONE
    }
    at = at + usize.ONE
  }
  let roots = List<Root>.asSlice(&segment.roots)
  run RuntimeEncoding.word(&mut output, usize.toU64(roots.length))
  at = usize.ZERO
  while at < roots.length {
    let root = &roots[at]
    run RuntimeEncoding.field(&mut output, Bytes.asSlice(&root.key))
    run reference(&mut output, root.node)
    run RuntimeEncoding.field(&mut output, Bytes.asSlice(&root.answer))
    let packs = List<ContentHash>.asSlice(&root.packs)
    run RuntimeEncoding.word(&mut output, usize.toU64(packs.length))
    let mut pack = usize.ZERO
    while pack < packs.length { run hash(&mut output, packs[pack]) pack = pack + usize.ONE }
    at = at + usize.ONE
  }
  let checksum = ContentHash.of(Bytes.asSlice(&output))
  run hash(&mut output, checksum)
  return Option<Bytes>.some(move output)
}

struct Reader {cursor: StableKey.Reader, failed: bool, items: usize}
fn word(bytes: &[u8], reader: &mut Reader) -> u64 {
  if reader.failed { return 0 }
  let value = StableKey.readWord(bytes, &mut reader.cursor)
  if StableKey.failed(&reader.cursor) { reader.failed = true }
  return value
}
fn size(bytes: &[u8], reader: &mut Reader) -> usize {
  let value = word(bytes, &mut reader.*)
  if value > usize.toU64(usize.MAX) { reader.failed = true return usize.ZERO }
  return u64.toUsize(value)
}
fn count(bytes: &[u8], reader: &mut Reader, limit: usize) -> usize {
  let value = size(bytes, &mut reader.*)
  if reader.failed || value > limit || !addBound(&mut reader.items, value, ITEM_LIMIT)
    || value > (bytes.length - StableKey.offset(&reader.cursor)) / 8 {
    reader.failed = true return usize.ZERO
  }
  return value
}
fn boolean(bytes: &[u8], reader: &mut Reader) -> bool {
  let value = word(bytes, &mut reader.*)
  if value > 1 { reader.failed = true }
  return value == 1
}
fn readHash(bytes: &[u8], reader: &mut Reader) -> ContentHash {
  let high = word(bytes, &mut reader.*)
  let low = word(bytes, &mut reader.*)
  return ContentHash {high: high, low: low}
}
fn readReference(bytes: &[u8], reader: &mut Reader) -> Reference {
  let segment = size(bytes, &mut reader.*)
  let index = size(bytes, &mut reader.*)
  return Reference {segment: segment, index: index}
}
effect fn field(bytes: &[u8], reader: &mut Reader) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  if reader.failed { return Bytes.make() }
  let span = StableKey.readField(bytes, &mut reader.cursor)
  if StableKey.failed(&reader.cursor) { reader.failed = true return Bytes.make() }
  return run Bytes.copy(StableKey.view(bytes, span))
}

/// Decodes exact source observations and bounded local topology, without admitting imports.
/// A generation must authenticate imports and selected root authority before using any answer.
pub effect fn decode(bytes: &[u8], expectedStamp: &[u8]) -> Option<Segment> ! OutOfMemoryError ? &mut Allocator {
  if bytes.length > BYTE_LIMIT || bytes.length < 16 { return Option<Segment>.none() }
  let payload = Slice.view<u8>(bytes, usize.ZERO, bytes.length - 16)
  let mut trailer = Reader {cursor: StableKey.reader(), failed: false, items: usize.ZERO}
  let checksum = readHash(Slice.view<u8>(bytes, bytes.length - 16, 16), &mut trailer)
  if !ContentHash.equals(checksum, ContentHash.of(payload)) { return Option<Segment>.none() }
  let mut reader = Reader {cursor: StableKey.reader(), failed: false, items: usize.ZERO}
  let magic = run field(payload, &mut reader)
  if !same(Bytes.asSlice(&magic), b"silk-cache-segment-v1") || word(payload, &mut reader) != 1 { return Option<Segment>.none() }
  let serial = word(payload, &mut reader)
  let stamp = run field(payload, &mut reader)
  if !same(Bytes.asSlice(&stamp), expectedStamp) { return Option<Segment>.none() }
  let mut segment = Segment {serial: serial, stamp: move stamp, imports: List<Descriptor>.make(),
    leaves: List<Observation>.make(), nodes: List<Node>.make(), roots: List<Root>.make()}
  let imports = count(payload, &mut reader, IMPORT_LIMIT)
  let mut at = usize.ZERO
  while at < imports && !reader.failed {
    let digest = readHash(payload, &mut reader)
    let importedSerial = word(payload, &mut reader)
    let leaves = size(payload, &mut reader)
    let nodes = size(payload, &mut reader)
    let roots = size(payload, &mut reader)
    run List<Descriptor>.append(&mut segment.imports, Descriptor {digest: digest, serial: importedSerial,
      leaves: leaves, nodes: nodes, roots: roots})
    at = at + usize.ONE
  }
  let leaves = count(payload, &mut reader, ENTRY_LIMIT)
  at = usize.ZERO
  while at < leaves && !reader.failed {
    let key = run field(payload, &mut reader)
    let digest = readHash(payload, &mut reader)
    let text = readHash(payload, &mut reader)
    let position = size(payload, &mut reader)
    let hasFile = boolean(payload, &mut reader)
    let mut file = Option<Reference>.none()
    if hasFile { file = Option<Reference>.some(readReference(payload, &mut reader)) }
    let selector = word(payload, &mut reader)
    if selector > u32.toU64(u32.MAX) { reader.failed = true }
    let input = boolean(payload, &mut reader)
    run List<Observation>.append(&mut segment.leaves, Observation {key: move key, digest: digest,
      text: text, position: position, file: move file, selector: u64.toU32(selector), input: input})
    at = at + usize.ONE
  }
  let nodes = count(payload, &mut reader, ENTRY_LIMIT)
  at = usize.ZERO
  while at < nodes && !reader.failed {
    let total = count(payload, &mut reader, ENTRY_LIMIT)
    let mut edges = List<Edge>.make()
    let mut edge = usize.ZERO
    while edge < total && !reader.failed {
      let node = boolean(payload, &mut reader)
      let target = readReference(payload, &mut reader)
      run List<Edge>.append(&mut edges, Edge {node: node, target: target})
      edge = edge + usize.ONE
    }
    run List<Node>.append(&mut segment.nodes, Node {edges: move edges})
    at = at + usize.ONE
  }
  let roots = count(payload, &mut reader, ENTRY_LIMIT)
  at = usize.ZERO
  while at < roots && !reader.failed {
    let key = run field(payload, &mut reader)
    let node = readReference(payload, &mut reader)
    let answer = run field(payload, &mut reader)
    let total = count(payload, &mut reader, ENTRY_LIMIT)
    let mut packs = List<ContentHash>.make()
    let mut pack = usize.ZERO
    while pack < total && !reader.failed {
      run List<ContentHash>.append(&mut packs, readHash(payload, &mut reader))
      pack = pack + usize.ONE
    }
    run List<Root>.append(&mut segment.roots, Root {key: move key, node: node, answer: move answer, packs: move packs})
    at = at + usize.ONE
  }
  if reader.failed || !StableKey.finished(payload, &reader.cursor) || !localValid(&segment) { return Option<Segment>.none() }
  return Option<Segment>.some(move segment)
}

/// Describes the exact bytes produced for a locally valid segment. The caller binds decoded
/// segments to their own bytes before admitting the resulting descriptor into a catalog.
pub fn describe(segment: &Segment, encodedBytes: &[u8]) -> Descriptor {
  return Descriptor {digest: ContentHash.of(encodedBytes), serial: segment.serial,
    leaves: List<Observation>.length(&segment.leaves), nodes: List<Node>.length(&segment.nodes),
    roots: List<Root>.length(&segment.roots)}
}

/// Derives the source-file bitmap of an already fully admitted segment.
pub effect fn admission(segment: &Segment, encodedBytes: &[u8]) -> Admission ! OutOfMemoryError ? &mut Allocator {
  let leaves = List<Observation>.asSlice(&segment.leaves)
  let mut bitmap = Bytes.make()
  let mut at = usize.ZERO
  while at < leaves.length {
    let mut byte: u8 = 0
    let mut bit = usize.ZERO
    while bit < 8 && at + bit < leaves.length {
      if !leaves[at + bit].input { byte = u8.bitOr(byte, u64.toU8(u64.shiftLeft(1, usize.toU64(bit)))) }
      bit = bit + usize.ONE
    }
    run Bytes.append(&mut bitmap, &[byte])
    at = at + 8
  }
  return Admission {descriptor: describe(segment, encodedBytes), sourceLeaves: move bitmap}
}

/// Authenticates imports against previously admitted descriptors and checks that every remote
/// file reference names a whole-file observation. Strict serial order excludes import cycles.
pub fn validateImports(segment: &Segment, admitted: &[Admission]) -> bool {
  if !localValid(segment) { return false }
  let imports = List<Descriptor>.asSlice(&segment.imports)
  let mut at = usize.ZERO
  while at < imports.length {
    let mut found = usize.MAX
    let mut held = usize.ZERO
    while held < admitted.length {
      if ContentHash.equals(admitted[held].descriptor.digest, imports[at].digest) {
        if found != usize.MAX || !sameDescriptor(admitted[held].descriptor, imports[at]) { return false }
        found = held
      }
      held = held + usize.ONE
    }
    if found == usize.MAX { return false }
    let bitmap = Bytes.asSlice(&admitted[found].sourceLeaves)
    if bitmap.length != (imports[at].leaves + 7) / 8 { return false }
    let leaves = List<Observation>.asSlice(&segment.leaves)
    let mut leaf = usize.ZERO
    while leaf < leaves.length {
      if let Option<Reference>.Some {value: file} = &leaves[leaf].file {
        if file.segment == at + usize.ONE {
          let mask = u64.shiftLeft(1, usize.toU64(file.index % 8))
          if u64.bitAnd(u8.toU64(bitmap[file.index / 8]), mask) == 0 { return false }
        }
      }
      leaf = leaf + usize.ONE
    }
    at = at + usize.ONE
  }
  return true
}
