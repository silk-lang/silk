//! Frozen machine facts for the four supported compilation targets.
//!
//! # When to use
//!
//! Use `resolve` when a request names a target. Use the target's operations for static machine
//! queries and pointer-sized integer range checks. No operation reads the compiler host.

import silk.option {Option}
import silk.usize

/// One canonical target identity.
pub enum Id {
  /// The Apple AArch64 target.
  Aarch64AppleDarwin,
  /// The GNU Linux AArch64 target.
  Aarch64UnknownLinuxGnu,
  /// The GNU Linux x86-64 target.
  X8664UnknownLinuxGnu,
  /// The standalone WebAssembly target.
  Wasm32UnknownUnknown,
}

/// One admitted primitive whose layout is fixed by a target.
pub enum Primitive {
  /// The language boolean.
  Bool,
  /// The C boolean.
  CBool,
  /// An eight-bit integer.
  Integer8,
  /// A sixteen-bit integer.
  Integer16,
  /// A thirty-two-bit integer.
  Integer32,
  /// A sixty-four-bit integer.
  Integer64,
  /// A thirty-two-bit float.
  Float32,
  /// A sixty-four-bit float.
  Float64,
  /// A C long integer.
  CLong,
}

/// The storage size and alignment of a primitive, in bytes.
pub struct Layout {
  /// The size in bytes.
  pub size: u32
  /// The alignment in bytes.
  pub alignment: u32
}

impl Copy for Layout {}

/// A versioned target description selected by its canonical identity.
pub struct Target {
  identity: Id
}

impl Copy for Target {}

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

fn fitsMagnitude(magnitude: &[u8], maximum: &[u8]) -> bool {
  if magnitude.length != maximum.length {
    return magnitude.length < maximum.length
  }
  let mut at = usize.ZERO
  while at < magnitude.length {
    if magnitude[at] != maximum[at] {
      return magnitude[at] < maximum[at]
    }
    at = at + usize.ONE
  }
  return true
}

impl Target {
  /// Constructs one of the closed target identities without reading the host.
  pub fn forId(identity: Id) -> Target {
    return Target {identity: identity}
  }
  /// Resolves only a canonical target name. An absent or unknown name returns `None`.
  pub fn resolve(name: &[u8]) -> Option<Target> {
    if same(name, b"aarch64-apple-darwin") {
      return Option.some<Target>(Target.forId(Id.Aarch64AppleDarwin))
    }
    if same(name, b"aarch64-unknown-linux-gnu") {
      return Option.some<Target>(Target.forId(Id.Aarch64UnknownLinuxGnu))
    }
    if same(name, b"x86_64-unknown-linux-gnu") {
      return Option.some<Target>(Target.forId(Id.X8664UnknownLinuxGnu))
    }
    if same(name, b"wasm32-unknown-unknown") {
      return Option.some<Target>(Target.forId(Id.Wasm32UnknownUnknown))
    }
    return Option.none<Target>()
  }
  /// Returns the machine-description revision used in target identity.
  pub fn revision(self: &Self) -> u32 {
    return 1
  }
  /// Returns the canonical target identity.
  pub fn id(self: &Self) -> Id {
    return self.identity
  }
  /// Returns the canonical target name.
  pub fn name(self: &Self) -> &[u8] {
    return match self.identity {
      Id.Aarch64AppleDarwin => b"aarch64-apple-darwin"
      Id.Aarch64UnknownLinuxGnu => b"aarch64-unknown-linux-gnu"
      Id.X8664UnknownLinuxGnu => b"x86_64-unknown-linux-gnu"
      Id.Wasm32UnknownUnknown => b"wasm32-unknown-unknown"
    }
  }
  /// Returns the instruction-set architecture name.
  pub fn architecture(self: &Self) -> &[u8] {
    return match self.identity {
      Id.Aarch64AppleDarwin => b"aarch64"
      Id.Aarch64UnknownLinuxGnu => b"aarch64"
      Id.X8664UnknownLinuxGnu => b"x86_64"
      Id.Wasm32UnknownUnknown => b"wasm32"
    }
  }
  /// Returns the operating-system name.
  pub fn operatingSystem(self: &Self) -> &[u8] {
    return match self.identity {
      Id.Aarch64AppleDarwin => b"darwin"
      Id.Aarch64UnknownLinuxGnu => b"linux"
      Id.X8664UnknownLinuxGnu => b"linux"
      Id.Wasm32UnknownUnknown => b"freestanding"
    }
  }
  /// Returns the target ABI name.
  pub fn abi(self: &Self) -> &[u8] {
    return match self.identity {
      Id.Aarch64AppleDarwin => b"apple"
      Id.Aarch64UnknownLinuxGnu => b"gnu"
      Id.X8664UnknownLinuxGnu => b"gnu"
      Id.Wasm32UnknownUnknown => b"wasm"
    }
  }
  /// Returns the object-format name.
  pub fn objectFormat(self: &Self) -> &[u8] {
    return match self.identity {
      Id.Aarch64AppleDarwin => b"macho"
      Id.Aarch64UnknownLinuxGnu => b"elf"
      Id.X8664UnknownLinuxGnu => b"elf"
      Id.Wasm32UnknownUnknown => b"wasm"
    }
  }
  /// Returns the byte-order name.
  pub fn endianness(self: &Self) -> &[u8] {
    return b"little"
  }
  /// Returns the data-pointer width in bits.
  pub fn pointerBits(self: &Self) -> u32 {
    return match self.identity {
      Id.Wasm32UnknownUnknown => 32
      Id.Aarch64AppleDarwin => 64
      Id.Aarch64UnknownLinuxGnu => 64
      Id.X8664UnknownLinuxGnu => 64
    }
  }
  /// Returns the data-pointer alignment in bytes.
  pub fn pointerAlignment(self: &Self) -> u32 {
    return match self.identity {
      Id.Wasm32UnknownUnknown => 4
      Id.Aarch64AppleDarwin => 8
      Id.Aarch64UnknownLinuxGnu => 8
      Id.X8664UnknownLinuxGnu => 8
    }
  }
  /// Returns the data address space number.
  pub fn dataAddressSpace(self: &Self) -> u32 {
    return 0
  }
  /// Returns the stack alignment in bytes.
  pub fn stackAlignment(self: &Self) -> u32 {
    return 16
  }
  /// Returns the target toolchain class.
  pub fn toolchainClass(self: &Self) -> &[u8] {
    return match self.identity {
      Id.Aarch64AppleDarwin => b"darwin"
      Id.Aarch64UnknownLinuxGnu => b"gnu"
      Id.X8664UnknownLinuxGnu => b"gnu"
      Id.Wasm32UnknownUnknown => b"wasm"
    }
  }
  /// Returns the size and alignment of an admitted primitive.
  pub fn primitive(self: &Self, name: Primitive) -> Layout {
    let size: u32 = match name {
      Primitive.Bool => 4
      Primitive.Integer32 => 4
      Primitive.Float32 => 4
      Primitive.CBool => 1
      Primitive.Integer8 => 1
      Primitive.Integer16 => 2
      Primitive.Integer64 => 8
      Primitive.Float64 => 8
      Primitive.CLong => self.pointerAlignment()
    }
    return Layout {size: size, alignment: size}
  }
  /// Returns the default CPU model name for this target.
  pub fn defaultCpu(self: &Self) -> &[u8] {
    return match self.identity {
      Id.X8664UnknownLinuxGnu => b"x86-64"
      Id.Aarch64AppleDarwin => b"generic"
      Id.Aarch64UnknownLinuxGnu => b"generic"
      Id.Wasm32UnknownUnknown => b"generic"
    }
  }
  /// Reports whether this target admits the named CPU model.
  pub fn supportsCpu(self: &Self, model: &[u8]) -> bool {
    return same(model, self.defaultCpu())
  }
  /// Reports whether this target admits the named CPU feature.
  pub fn supportsFeature(self: &Self, feature: &[u8]) -> bool {
    return match self.identity {
      Id.Aarch64AppleDarwin => same(feature, b"crc") || same(
        feature,
        b"crypto",
      ) || same(feature, b"fp-armv8") || same(feature, b"lse") || same(feature, b"neon")
      Id.Aarch64UnknownLinuxGnu => same(feature, b"crc") || same(
        feature,
        b"crypto",
      ) || same(feature, b"fp-armv8") || same(feature, b"lse") || same(feature, b"neon")
      Id.X8664UnknownLinuxGnu => same(feature, b"aes") || same(feature, b"avx") || same(
        feature,
        b"avx2",
      ) || same(feature, b"sse2") || same(feature, b"sse4.2")
      Id.Wasm32UnknownUnknown => same(feature, b"atomics") || same(
        feature,
        b"bulk-memory",
      ) || same(feature, b"mutable-globals") || same(feature, b"sign-ext") || same(
        feature,
        b"simd128",
      )
    }
  }
  /// Returns the number of CPU features in this target's fixed canonical order.
  pub fn featureCount(self: &Self) -> usize {
    return 5
  }
  /// Returns one supported CPU feature in canonical order. `index` must be less than five.
  pub fn feature(self: &Self, index: usize) -> &[u8] {
    return match self.identity {
      Id.Aarch64AppleDarwin => {
        if index == 0 { return b"crc" }
        if index == 1 { return b"crypto" }
        if index == 2 { return b"fp-armv8" }
        if index == 3 { return b"lse" }
        return b"neon"
      }
      Id.Aarch64UnknownLinuxGnu => {
        if index == 0 { return b"crc" }
        if index == 1 { return b"crypto" }
        if index == 2 { return b"fp-armv8" }
        if index == 3 { return b"lse" }
        return b"neon"
      }
      Id.X8664UnknownLinuxGnu => {
        if index == 0 { return b"aes" }
        if index == 1 { return b"avx" }
        if index == 2 { return b"avx2" }
        if index == 3 { return b"sse2" }
        return b"sse4.2"
      }
      Id.Wasm32UnknownUnknown => {
        if index == 0 { return b"atomics" }
        if index == 1 { return b"bulk-memory" }
        if index == 2 { return b"mutable-globals" }
        if index == 3 { return b"sign-ext" }
        return b"simd128"
      }
    }
  }
  /// Reports whether exact decimal digits fit this target's `usize` range.
  pub fn fitsUsize(self: &Self, magnitude: &[u8]) -> bool {
    if self.pointerBits() == 32 {
      return fitsMagnitude(magnitude, b"4294967295")
    }
    return fitsMagnitude(magnitude, b"18446744073709551615")
  }
  /// Reports whether exact signed decimal digits fit this target's `isize` range.
  pub fn fitsIsize(self: &Self, negative: bool, magnitude: &[u8]) -> bool {
    if self.pointerBits() == 32 {
      if negative {
        return fitsMagnitude(magnitude, b"2147483648")
      }
      return fitsMagnitude(magnitude, b"2147483647")
    }
    if negative {
      return fitsMagnitude(magnitude, b"9223372036854775808")
    }
    return fitsMagnitude(magnitude, b"9223372036854775807")
  }
  /// Returns a closed target text fact, or `None` for an unknown intrinsic operation.
  pub fn queryText(self: &Self, operation: &[u8]) -> Option<&[u8]> {
    if same(operation, b"targetArchitecture") {
      return Option.some<&[u8]>(self.architecture())
    }
    if same(operation, b"targetOperatingSystem") {
      return Option.some<&[u8]>(self.operatingSystem())
    }
    if same(operation, b"targetAbi") {
      return Option.some<&[u8]>(self.abi())
    }
    if same(operation, b"targetObjectFormat") {
      return Option.some<&[u8]>(self.objectFormat())
    }
    if same(operation, b"targetEndianness") {
      return Option.some<&[u8]>(self.endianness())
    }
    return Option.none<&[u8]>()
  }
  /// Returns a closed target number fact, or `None` for an unknown intrinsic operation.
  pub fn queryNumber(self: &Self, operation: &[u8]) -> Option<u32> {
    if same(operation, b"targetPointerBits") {
      return Option.some<u32>(self.pointerBits())
    }
    if same(operation, b"targetPointerAlignment") {
      return Option.some<u32>(self.pointerAlignment())
    }
    return Option.none<u32>()
  }
}
