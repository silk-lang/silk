//! Frozen machine facts for the supported compilation targets.
//!
//! # When to use
//!
//! Use `resolve` when a request names a target. Use the target's operations for static machine
//! queries and pointer-sized integer range checks. No operation reads the compiler host.

import silk.core.option {Option}
import silk.core.ownership {Copy}
import silk.num.usize

/// One canonical target identity.
pub enum Id {
  /// The Apple AArch64 target.
  Aarch64AppleDarwin,
  /// The GNU Linux AArch64 target.
  Aarch64UnknownLinuxGnu,
  /// The GNU Linux x86-64 target.
  X8664UnknownLinuxGnu,
  /// The Microsoft x86-64 Windows target.
  X8664PcWindowsMsvc,
  /// The Apple x86-64 (Intel) target.
  X8664AppleDarwin,
  /// The standalone WebAssembly target.
  Wasm32UnknownUnknown,
  /// The WASI Preview 1 core-module target.
  Wasm32Wasip1,
  /// The WASI Preview 2 component target.
  Wasm32Wasip2,
}

/// One admitted primitive whose layout is fixed by a target.
pub enum Primitive {
  /// The language boolean.
  Bool,
  /// The C boolean.
  CBool,
  /// An eight-bit integer.
  Integer8,
  /// A sixteen-bit integer.
  Integer16,
  /// A thirty-two-bit integer.
  Integer32,
  /// A sixty-four-bit integer.
  Integer64,
  /// A thirty-two-bit float.
  Float32,
  /// A sixty-four-bit float.
  Float64,
  /// A C long integer.
  CLong,
}

/// The storage size and alignment of a primitive, in bytes.
pub struct Layout {
  /// The size in bytes.
  pub size: u32,
  /// The alignment in bytes.
  pub alignment: u32,
}

impl Copy for Layout {}

/// A versioned target description selected by its canonical identity.
pub struct Target {
  identity: Id,
}

impl Copy for Target {}

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

fn x86Feature(index: usize) -> &'static [u8] {
  let names = [
    b"aes", b"avx", b"avx2", b"avx512bw", b"avx512cd", b"avx512dq", b"avx512f", b"avx512vbmi",
    b"avx512vl", b"bmi", b"bmi2", b"cx16", b"f16c", b"fma", b"lzcnt", b"movbe", b"pclmul", b"popcnt",
    b"sha", b"sse2", b"sse3", b"sse4.1", b"sse4.2", b"ssse3", b"xsave",
  ]
  let listed: &[&'static [u8]] = &names
  return listed[index]
}

fn aarch64Feature(index: usize) -> &'static [u8] {
  let names = [
    b"aes", b"crc", b"crypto", b"dotprod", b"fp-armv8", b"fullfp16", b"i8mm", b"lse", b"neon", b"rdm",
    b"sha2", b"sha3",
  ]
  let listed: &[&'static [u8]] = &names
  return listed[index]
}

fn wasmFeature(index: usize) -> &'static [u8] {
  let names = [b"atomics", b"bulk-memory", b"mutable-globals", b"relaxed-simd", b"sign-ext", b"simd128"]
  let listed: &[&'static [u8]] = &names
  return listed[index]
}

// Each pair `from[at]` enables `to[at]`, following LLVM's direct feature implications.
fn x86Implies(feature: &[u8], implied: &[u8]) -> bool {
  let from = [
    b"aes", b"avx", b"avx2", b"avx512bw", b"avx512cd", b"avx512dq", b"avx512f", b"avx512f", b"avx512f",
    b"avx512vbmi", b"avx512vl", b"f16c", b"fma", b"pclmul", b"sha", b"sse3", b"sse4.1", b"sse4.2", b"ssse3",
  ]
  let to = [
    b"sse2", b"sse4.2", b"avx", b"avx512f", b"avx512f", b"avx512f", b"avx2", b"f16c", b"fma",
    b"avx512bw", b"avx512f", b"avx", b"avx", b"sse2", b"sse2", b"sse2", b"ssse3", b"sse4.1", b"sse3",
  ]
  return listedPair(&from, &to, feature, implied)
}

fn aarch64Implies(feature: &[u8], implied: &[u8]) -> bool {
  let from = [
    b"aes", b"crypto", b"crypto", b"dotprod", b"fullfp16", b"i8mm", b"neon", b"rdm", b"sha2", b"sha3",
  ]
  let to = [
    b"neon", b"aes", b"sha2", b"neon", b"fp-armv8", b"neon", b"fp-armv8", b"neon", b"neon", b"sha2",
  ]
  return listedPair(&from, &to, feature, implied)
}

fn listedPair(from: &[&'static [u8]], to: &[&'static [u8]], feature: &[u8], implied: &[u8]) -> bool {
  let mut at = usize.ZERO
  while at < from.length {
    if same(from[at], feature) && same(to[at], implied) { return true }
    at = at + usize.ONE
  }
  return false
}

fn fitsMagnitude(magnitude: &[u8], maximum: &[u8]) -> bool {
  if magnitude.length != maximum.length {
    return magnitude.length < maximum.length
  }
  let mut at = usize.ZERO
  while at < magnitude.length {
    if magnitude[at] != maximum[at] {
      return magnitude[at] < maximum[at]
    }
    at = at + usize.ONE
  }
  return true
}

impl Target {
  /// Constructs one of the closed target identities without reading the host.
  pub fn forId(identity: Id) -> Target {
    return Target {identity: identity}
  }
  /// Resolves only a canonical target name. An absent or unknown name returns `None`.
  pub fn resolve(name: &[u8]) -> Option<Target> {
    if same(name, b"aarch64-apple-darwin") {
      return Option<Target>.some(Target.forId(Id.Aarch64AppleDarwin))
    }
    if same(name, b"aarch64-unknown-linux-gnu") {
      return Option<Target>.some(Target.forId(Id.Aarch64UnknownLinuxGnu))
    }
    if same(name, b"x86_64-unknown-linux-gnu") {
      return Option<Target>.some(Target.forId(Id.X8664UnknownLinuxGnu))
    }
    if same(name, b"x86_64-pc-windows-msvc") {
      return Option<Target>.some(Target.forId(Id.X8664PcWindowsMsvc))
    }
    if same(name, b"x86_64-apple-darwin") {
      return Option<Target>.some(Target.forId(Id.X8664AppleDarwin))
    }
    if same(name, b"wasm32-unknown-unknown") {
      return Option<Target>.some(Target.forId(Id.Wasm32UnknownUnknown))
    }
    if same(name, b"wasm32-wasip1") { return Option<Target>.some(Target.forId(Id.Wasm32Wasip1)) }
    if same(name, b"wasm32-wasip2") { return Option<Target>.some(Target.forId(Id.Wasm32Wasip2)) }
    return Option<Target>.none()
  }
  /// Returns the machine-description revision used in target identity.
  pub fn revision(self: &Self) -> u32 {
    return 1
  }
  /// Returns the canonical target identity.
  pub fn id(self: &Self) -> Id {
    return self.identity
  }
  /// Returns the canonical target name.
  pub fn name(self: &Self) -> &[u8] {
    return match self.identity {
      Id.Aarch64AppleDarwin => b"aarch64-apple-darwin"
      Id.Aarch64UnknownLinuxGnu => b"aarch64-unknown-linux-gnu"
      Id.X8664UnknownLinuxGnu => b"x86_64-unknown-linux-gnu"
      Id.X8664PcWindowsMsvc => b"x86_64-pc-windows-msvc"
      Id.X8664AppleDarwin => b"x86_64-apple-darwin"
      Id.Wasm32UnknownUnknown => b"wasm32-unknown-unknown"
      Id.Wasm32Wasip1 => b"wasm32-wasip1"
      Id.Wasm32Wasip2 => b"wasm32-wasip2"
    }
  }
  /// Returns the LLVM triple used to compile the core code of this target.
  /// Both WASI editions use the Preview 1 core ABI; Preview 2 wraps the linked module as a component.
  pub fn llvmTriple(self: &Self) -> &[u8] {
    if self.identity == Id.Wasm32Wasip1 || self.identity == Id.Wasm32Wasip2 { return b"wasm32-unknown-wasi" }
    return self.name()
  }
  /// Returns the instruction-set architecture name.
  pub fn architecture(self: &Self) -> &[u8] {
    return match self.identity {
      Id.Aarch64AppleDarwin => b"aarch64"
      Id.Aarch64UnknownLinuxGnu => b"aarch64"
      Id.X8664UnknownLinuxGnu => b"x86_64"
      Id.X8664PcWindowsMsvc => b"x86_64"
      Id.X8664AppleDarwin => b"x86_64"
      Id.Wasm32UnknownUnknown => b"wasm32"
      Id.Wasm32Wasip1 => b"wasm32"
      Id.Wasm32Wasip2 => b"wasm32"
    }
  }
  /// Returns the operating-system name.
  pub fn operatingSystem(self: &Self) -> &[u8] {
    return match self.identity {
      Id.Aarch64AppleDarwin => b"darwin"
      Id.Aarch64UnknownLinuxGnu => b"linux"
      Id.X8664UnknownLinuxGnu => b"linux"
      Id.X8664PcWindowsMsvc => b"windows"
      Id.X8664AppleDarwin => b"darwin"
      Id.Wasm32UnknownUnknown => b"freestanding"
      Id.Wasm32Wasip1 => b"wasi"
      Id.Wasm32Wasip2 => b"wasi"
    }
  }
  /// Returns the target ABI name.
  pub fn abi(self: &Self) -> &[u8] {
    return match self.identity {
      Id.Aarch64AppleDarwin => b"apple"
      Id.Aarch64UnknownLinuxGnu => b"gnu"
      Id.X8664UnknownLinuxGnu => b"gnu"
      Id.X8664PcWindowsMsvc => b"msvc"
      Id.X8664AppleDarwin => b"apple"
      Id.Wasm32UnknownUnknown => b"wasm"
      Id.Wasm32Wasip1 => b"wasm"
      Id.Wasm32Wasip2 => b"wasm"
    }
  }
  /// Returns the object-format name.
  pub fn objectFormat(self: &Self) -> &[u8] {
    return match self.identity {
      Id.Aarch64AppleDarwin => b"macho"
      Id.Aarch64UnknownLinuxGnu => b"elf"
      Id.X8664UnknownLinuxGnu => b"elf"
      Id.X8664PcWindowsMsvc => b"coff"
      Id.X8664AppleDarwin => b"macho"
      Id.Wasm32UnknownUnknown => b"wasm"
      Id.Wasm32Wasip1 => b"wasm"
      Id.Wasm32Wasip2 => b"wasm"
    }
  }
  /// Returns the byte-order name.
  pub fn endianness(self: &Self) -> &[u8] {
    return b"little"
  }
  /// Returns the data-pointer width in bits.
  pub fn pointerBits(self: &Self) -> u32 {
    return match self.identity {
      Id.Wasm32UnknownUnknown => 32
      Id.Wasm32Wasip1 => 32
      Id.Wasm32Wasip2 => 32
      Id.Aarch64AppleDarwin => 64
      Id.Aarch64UnknownLinuxGnu => 64
      Id.X8664UnknownLinuxGnu => 64
      Id.X8664PcWindowsMsvc => 64
      Id.X8664AppleDarwin => 64
    }
  }
  /// Returns the data-pointer alignment in bytes.
  pub fn pointerAlignment(self: &Self) -> u32 {
    return match self.identity {
      Id.Wasm32UnknownUnknown => 4
      Id.Wasm32Wasip1 => 4
      Id.Wasm32Wasip2 => 4
      Id.Aarch64AppleDarwin => 8
      Id.Aarch64UnknownLinuxGnu => 8
      Id.X8664UnknownLinuxGnu => 8
      Id.X8664PcWindowsMsvc => 8
      Id.X8664AppleDarwin => 8
    }
  }
  /// Returns the data address space number.
  pub fn dataAddressSpace(self: &Self) -> u32 {
    return 0
  }
  /// Returns the stack alignment in bytes.
  pub fn stackAlignment(self: &Self) -> u32 {
    return 16
  }
  /// Returns the target toolchain class.
  pub fn toolchainClass(self: &Self) -> &[u8] {
    return match self.identity {
      Id.Aarch64AppleDarwin => b"darwin"
      Id.Aarch64UnknownLinuxGnu => b"gnu"
      Id.X8664UnknownLinuxGnu => b"gnu"
      Id.X8664PcWindowsMsvc => b"msvc"
      Id.X8664AppleDarwin => b"darwin"
      Id.Wasm32UnknownUnknown => b"wasm"
      Id.Wasm32Wasip1 => b"wasm"
      Id.Wasm32Wasip2 => b"wasm"
    }
  }
  /// Returns the size and alignment of an admitted primitive.
  pub fn primitive(self: &Self, name: Primitive) -> Layout {
    let mut longSize = self.pointerAlignment()
    if self.identity == Id.X8664PcWindowsMsvc { longSize = 4 }
    let size: u32 = match name {
      Primitive.Bool => 4
      Primitive.Integer32 => 4
      Primitive.Float32 => 4
      Primitive.CBool => 1
      Primitive.Integer8 => 1
      Primitive.Integer16 => 2
      Primitive.Integer64 => 8
      Primitive.Float64 => 8
      Primitive.CLong => longSize
    }
    return Layout {size: size, alignment: size}
  }
  /// Returns the default CPU model name for this target.
  pub fn defaultCpu(self: &Self) -> &[u8] {
    return match self.identity {
      Id.X8664UnknownLinuxGnu => b"x86-64"
      Id.X8664PcWindowsMsvc => b"x86-64"
      Id.X8664AppleDarwin => b"x86-64"
      Id.Aarch64AppleDarwin => b"generic"
      Id.Aarch64UnknownLinuxGnu => b"generic"
      Id.Wasm32UnknownUnknown => b"generic"
      Id.Wasm32Wasip1 => b"generic"
      Id.Wasm32Wasip2 => b"generic"
    }
  }
  /// Reports whether this target admits the named CPU model. x86-64 also admits the
  /// `x86-64-v2`, `x86-64-v3` and `x86-64-v4` microarchitecture levels.
  pub fn supportsCpu(self: &Self, model: &[u8]) -> bool {
    return same(model, self.defaultCpu()) || same(self.architecture(), b"x86_64") && (
      same(model, b"x86-64-v2") || same(model, b"x86-64-v3") || same(model, b"x86-64-v4")
    )
  }
  /// Reports whether the admitted CPU model `model` guarantees `feature`. The default model
  /// guarantees only the architecture baseline.
  pub fn cpuIncludes(self: &Self, model: &[u8], feature: &[u8]) -> bool {
    if self.baselineFeature(feature) {
      return true
    }
    if !same(self.architecture(), b"x86_64") {
      return false
    }
    let mut level: u32 = 0
    if same(model, b"x86-64-v2") { level = 2 }
    if same(model, b"x86-64-v3") { level = 3 }
    if same(model, b"x86-64-v4") { level = 4 }
    let mut required: u32 = 5
    if same(feature, b"cx16") || same(feature, b"popcnt") || same(feature, b"sse3") ||
      same(feature, b"sse4.1") || same(feature, b"sse4.2") || same(feature, b"ssse3") { required = 2 }
    if same(feature, b"avx") || same(feature, b"avx2") || same(feature, b"bmi") || same(feature, b"bmi2") ||
      same(feature, b"f16c") || same(feature, b"fma") || same(feature, b"lzcnt") || same(feature, b"movbe") ||
      same(feature, b"xsave") { required = 3 }
    if same(feature, b"avx512bw") || same(feature, b"avx512cd") || same(feature, b"avx512dq") ||
      same(feature, b"avx512f") || same(feature, b"avx512vl") { required = 4 }
    return required <= level
  }
  /// Reports whether every program for this target may use `feature`: SSE2 on x86-64 and
  /// NEON with its floating-point unit on AArch64.
  pub fn baselineFeature(self: &Self, feature: &[u8]) -> bool {
    return match self.identity {
      Id.X8664UnknownLinuxGnu => same(feature, b"sse2")
      Id.X8664PcWindowsMsvc => same(feature, b"sse2")
      Id.X8664AppleDarwin => same(feature, b"sse2")
      Id.Aarch64AppleDarwin => same(feature, b"fp-armv8") || same(feature, b"neon")
      Id.Aarch64UnknownLinuxGnu => same(feature, b"fp-armv8") || same(feature, b"neon")
      Id.Wasm32UnknownUnknown => false
      Id.Wasm32Wasip1 => false
      Id.Wasm32Wasip2 => false
    }
  }
  /// Reports whether this target admits the named CPU feature.
  pub fn supportsFeature(self: &Self, feature: &[u8]) -> bool {
    let mut at = usize.ZERO
    while at < self.featureCount() {
      if same(feature, self.feature(at)) { return true }
      at = at + usize.ONE
    }
    return false
  }
  /// Returns the number of CPU features in this target's catalog.
  pub fn featureCount(self: &Self) -> usize {
    return match self.identity {
      Id.Aarch64AppleDarwin => 12
      Id.Aarch64UnknownLinuxGnu => 12
      Id.X8664UnknownLinuxGnu => 25
      Id.X8664PcWindowsMsvc => 25
      Id.X8664AppleDarwin => 25
      Id.Wasm32UnknownUnknown => 6
      Id.Wasm32Wasip1 => 6
      Id.Wasm32Wasip2 => 6
    }
  }
  /// Returns one CPU feature of this target's catalog, which is sorted by byte value and spelled
  /// as LLVM spells it. `index` must be less than `featureCount`.
  pub fn feature(self: &Self, index: usize) -> &'static [u8] {
    return match self.identity {
      Id.Aarch64AppleDarwin => aarch64Feature(index)
      Id.Aarch64UnknownLinuxGnu => aarch64Feature(index)
      Id.X8664UnknownLinuxGnu => x86Feature(index)
      Id.X8664PcWindowsMsvc => x86Feature(index)
      Id.X8664AppleDarwin => x86Feature(index)
      Id.Wasm32UnknownUnknown => wasmFeature(index)
      Id.Wasm32Wasip1 => wasmFeature(index)
      Id.Wasm32Wasip2 => wasmFeature(index)
    }
  }
  /// Reports whether enabling `feature` directly enables `implied`. Enabling a feature enables
  /// the transitive closure of this relation.
  pub fn implies(self: &Self, feature: &[u8], implied: &[u8]) -> bool {
    return match self.identity {
      Id.Aarch64AppleDarwin => aarch64Implies(feature, implied)
      Id.Aarch64UnknownLinuxGnu => aarch64Implies(feature, implied)
      Id.X8664UnknownLinuxGnu => x86Implies(feature, implied)
      Id.X8664PcWindowsMsvc => x86Implies(feature, implied)
      Id.X8664AppleDarwin => x86Implies(feature, implied)
      Id.Wasm32UnknownUnknown => same(feature, b"relaxed-simd") && same(implied, b"simd128")
      Id.Wasm32Wasip1 => same(feature, b"relaxed-simd") && same(implied, b"simd128")
      Id.Wasm32Wasip2 => same(feature, b"relaxed-simd") && same(implied, b"simd128")
    }
  }
  /// Reports whether exact decimal digits fit this target's `usize` range.
  pub fn fitsUsize(self: &Self, magnitude: &[u8]) -> bool {
    if self.pointerBits() == 32 {
      return fitsMagnitude(magnitude, b"4294967295")
    }
    return fitsMagnitude(magnitude, b"18446744073709551615")
  }
  /// Reports whether exact signed decimal digits fit this target's `isize` range.
  pub fn fitsIsize(self: &Self, negative: bool, magnitude: &[u8]) -> bool {
    if self.pointerBits() == 32 {
      if negative {
        return fitsMagnitude(magnitude, b"2147483648")
      }
      return fitsMagnitude(magnitude, b"2147483647")
    }
    if negative {
      return fitsMagnitude(magnitude, b"9223372036854775808")
    }
    return fitsMagnitude(magnitude, b"9223372036854775807")
  }
  /// Returns a closed target text fact, or `None` for an unknown intrinsic operation.
  pub fn queryText(self: &Self, operation: &[u8]) -> Option<&[u8]> {
    if same(operation, b"targetArchitecture") {
      return Option<&[u8]>.some(self.architecture())
    }
    if same(operation, b"targetOperatingSystem") {
      return Option<&[u8]>.some(self.operatingSystem())
    }
    if same(operation, b"targetAbi") {
      return Option<&[u8]>.some(self.abi())
    }
    if same(operation, b"targetObjectFormat") {
      return Option<&[u8]>.some(self.objectFormat())
    }
    if same(operation, b"targetEndianness") {
      return Option<&[u8]>.some(self.endianness())
    }
    return Option<&[u8]>.none()
  }
  /// Returns a closed target number fact, or `None` for an unknown intrinsic operation.
  pub fn queryNumber(self: &Self, operation: &[u8]) -> Option<u32> {
    if same(operation, b"targetPointerBits") {
      return Option<u32>.some(self.pointerBits())
    }
    if same(operation, b"targetPointerAlignment") {
      return Option<u32>.some(self.pointerAlignment())
    }
    return Option<u32>.none()
  }
}
