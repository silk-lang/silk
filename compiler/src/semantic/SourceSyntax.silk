//! Pure authored projections consumed by the semantic source-input boundary.
//! No semantic query or inferred type participates in these comparison facts.
import hir.Hir as Hir {DeclarationStart, HirId, HirRef, Module, Node, Range}
import hir.Fingerprint
import semantic.FieldSyntax
import semantic.FieldSyntax {FieldReference}
import semantic.SourceIndex {HeaderPlace, IndexedSource, memberRange}
import semantic.ModuleIndex {ModuleIndex, Arm, CandidateKind}
import semantic.DeclarationId {DeclarationId}
import semantic.RuntimeEncoding as Encoding
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.collections.bytes {Bytes}
import silk.core.option {Option}
import silk.collections.list {List}
import silk.text.string {String}
import silk.num.usize

pub effect fn node(output: &mut Bytes, hir: &Module, id: HirId) -> () ! OutOfMemoryError ? &mut Allocator {
  let bytes = run Fingerprint.header(hir, id)
  return run Encoding.field(&mut output.*, List<u8>.asSlice(&bytes))
}
effect fn optional(output: &mut Bytes, hir: &Module, id: HirRef) -> () ! OutOfMemoryError ? &mut Allocator {
  if id.present { run Encoding.field(&mut output.*, b"some") return run node(&mut output.*, hir, id.id) }
  return run Encoding.field(&mut output.*, b"none")
}
effect fn flag(output: &mut Bytes, value: bool) -> () ! OutOfMemoryError ? &mut Allocator {
  if value { return run Encoding.field(&mut output.*, b"true") }
  return run Encoding.field(&mut output.*, b"false")
}
effect fn sequence(output: &mut Bytes, hir: &Module, range: Range) -> () ! OutOfMemoryError ? &mut Allocator {
  run Encoding.word(&mut output.*, usize.toU64(range.length))
  let mut at = usize.ZERO
  while at < range.length { run node(&mut output.*, hir, Module.child(hir, range, at)) at = at + usize.ONE }
}

/// Own header facts, excluding aggregate members and an enclosing contract's operations.
/// Every reader of such a list must additionally consume its member/catalog subject.
pub effect fn header(output: &mut Bytes, hir: &Module, id: HirId) -> () ! OutOfMemoryError ? &mut Allocator {
  let value = Module.node(hir, id)
  run Encoding.field(&mut output.*, String.utf8Bytes(Hir.nodeKindName(value)))
  let mut generics = Range.empty()
  match value {
    Node.StructHeader {name, isPublic, generics: written, abi, genericsAnchor, ..} => {
      run node(&mut output.*, hir, name) run flag(&mut output.*, isPublic)
      run optional(&mut output.*, hir, abi) run flag(&mut output.*, genericsAnchor.present)
      generics = written
    }
    Node.TupleHeader {name, isPublic, generics: written, ..} => {
      run node(&mut output.*, hir, name) run flag(&mut output.*, isPublic) generics = written
    }
    Node.UnionHeader {name, isPublic, generics: written, ..} => {
      run node(&mut output.*, hir, name) run flag(&mut output.*, isPublic) generics = written
    }
    Node.EnumHeader {name, isPublic, representation, ..} => {
      run node(&mut output.*, hir, name) run flag(&mut output.*, isPublic) run optional(&mut output.*, hir, representation)
    }
    _ => { return run node(&mut output.*, hir, id) }
  }
  run Encoding.word(&mut output.*, usize.toU64(memberRange(value).length))
  return run sequence(&mut output.*, hir, generics)
}

pub effect fn binders(output: &mut Bytes, hir: &Module, id: HirId) -> () ! OutOfMemoryError ? &mut Allocator {
  let parameters = FieldSyntax.generics(hir, id)
  run Encoding.word(&mut output.*, usize.toU64(parameters.length))
  let mut at = usize.ZERO
  while at < parameters.length {
    let value = Module.node(hir, Module.child(hir, parameters, at))
    run Encoding.field(&mut output.*, String.utf8Bytes(Hir.nodeKindName(value)))
    let name = match value {
      Node.TypeParameter {name, ..} => HirRef.of(name)
      Node.LifetimeParameter {name, ..} => HirRef.of(name)
      Node.RowParameter {name} => HirRef.of(name)
      _ => HirRef.absent()
    }
    run optional(&mut output.*, hir, name)
    at = at + usize.ONE
  }
}


pub effect fn members(output: &mut Bytes, hir: &Module, id: HirId) -> () ! OutOfMemoryError ? &mut Allocator {
  let value = Module.node(hir, id)
  run Encoding.field(&mut output.*, String.utf8Bytes(Hir.nodeKindName(value)))
  if let Node.EnumHeader {representation, ..} = value { run optional(&mut output.*, hir, representation) }
  let range = memberRange(value)
  run Encoding.word(&mut output.*, usize.toU64(range.length))
  let mut at = usize.ZERO
  while at < range.length {
    let child = Module.child(hir, range, at)
    if let Node.TupleHeader {..} = value {
      // Tuple Members publishes positions, never their annotation category.
      run Encoding.field(&mut output.*, b"position")
    } else {
      let item = Module.node(hir, child)
      run Encoding.field(&mut output.*, String.utf8Bytes(Hir.nodeKindName(item)))
      match item {
        Node.Field {name, isPublic, ..} => { run node(&mut output.*, hir, name) run flag(&mut output.*, isPublic) }
        Node.Variant {name, fields, braces} => {
          run node(&mut output.*, hir, name) run flag(&mut output.*, braces)
          let mut namedField = false
          let mut field = usize.ZERO
          while field < fields.length {
            if let Node.Field {name: fieldName, ..} = Module.node(hir, Module.child(hir, fields, field)) {
              if let Node.Name {..} = Module.node(hir, fieldName) { namedField = true }
            }
            field = field + usize.ONE
          }
          run flag(&mut output.*, namedField)
        }
        Node.EnumMember {..} => { run node(&mut output.*, hir, child) }
        _ => {}
      }
    }
    at = at + usize.ONE
  }
}

pub effect fn member(output: &mut Bytes, hir: &Module, id: HirId, ordinal: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  let range = memberRange(Module.node(hir, id))
  if ordinal < range.length { return run node(&mut output.*, hir, Module.child(hir, range, ordinal)) }
  return run Encoding.field(&mut output.*, b"missing-member")
}

pub effect fn fields(output: &mut Bytes, hir: &Module, id: HirId) -> () ! OutOfMemoryError ? &mut Allocator {
  // Exactly the computation consumed by FieldLifetimes, before recursive name resolution.
  let scan = run FieldSyntax.declaration(hir, id)
  run Encoding.word(&mut output.*, usize.toU64(scan.omitted))
  let references = List<FieldReference>.asSlice(&scan.references)
  run Encoding.word(&mut output.*, usize.toU64(references.length))
  let mut at = usize.ZERO
  while at < references.length {
    run node(&mut output.*, hir, references[at].path)
    run optional(&mut output.*, hir, references[at].arguments)
    run flag(&mut output.*, references[at].writtenLifetimes)
    at = at + usize.ONE
  }
}

effect fn identity(output: &mut Bytes, id: &DeclarationId) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut content = Bytes.make()
  run DeclarationId.appendContent(id, &mut content)
  return run Encoding.field(&mut output.*, Bytes.asSlice(&content))
}

pub effect fn parent(output: &mut Bytes, source: &IndexedSource, ordinal: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(source))
  // memberPlace also classifies its own header; the stable handle supplies its spelling.
  run Encoding.field(&mut output.*, String.utf8Bytes(Hir.nodeKindName(
    Module.node(IndexedSource.authored(source), declarations[ordinal].header))))
  if let Option<usize>.Some {value} = &declarations[ordinal].parent {
    run identity(&mut output.*, &declarations[value].identity)
    // Actual parent header classification/visibility/Self facts, not child bodies.
    return run header(&mut output.*, IndexedSource.authored(source), declarations[value].header)
  }
  return run Encoding.field(&mut output.*, b"no-parent")
}

pub effect fn operations(output: &mut Bytes, source: &IndexedSource, ordinal: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  let index = IndexedSource.moduleIndex(source)
  let declarations = ModuleIndex.listDeclarations(index)
  let hir = IndexedSource.authored(source)
  run header(&mut output.*, hir, declarations[ordinal].header)
  let mut at = ModuleIndex.firstEnclosed(index, ordinal)
  while at != usize.MAX {
    if let Option<usize>.Some {value} = &declarations[at].parent {
      if value == ordinal {
        run identity(&mut output.*, &declarations[at].identity)
        let written = Module.node(hir, declarations[at].header)
        run Encoding.field(&mut output.*, String.utf8Bytes(Hir.nodeKindName(written)))
        if let Node.OperationHeader {name, isPublic, ..} = written {
          run node(&mut output.*, hir, name) run flag(&mut output.*, isPublic)
        }
        let mut hasBody = false
        if let Node.Declaration {body, ..} = Module.node(hir, declarations[at].local) {
          if let Node.CallableBody {block} = Module.node(hir, body) { hasBody = block.present }
        }
        run flag(&mut output.*, hasBody)
      }
    }
    at = ModuleIndex.nextEnclosed(index, at)
  }
}

pub effect fn implementations(output: &mut Bytes, source: &IndexedSource) -> () ! OutOfMemoryError ? &mut Allocator {
  let index = IndexedSource.moduleIndex(source)
  let declarations = ModuleIndex.listDeclarations(index)
  let hir = IndexedSource.authored(source)
  let mut at = ModuleIndex.firstEnclosed(index, usize.MAX)
  while at != usize.MAX {
    if let Option<usize>.None = &declarations[at].parent {
      if let Node.ImplHeader {target, ..} = Module.node(hir, declarations[at].header) {
        if target.present {
          run identity(&mut output.*, &declarations[at].identity)
          if let Option<Arm>.Some {value} = &declarations[at].arm {
            run identity(&mut output.*, &declarations[value.conditional].identity)
            run flag(&mut output.*, value.holds)
          } else { run Encoding.field(&mut output.*, b"unconditional") }
        }
      }
    }
    at = ModuleIndex.nextEnclosed(index, at)
  }
}

/// Each declaration `ordinal` encloses: its identity and whole written header, in written order.
pub effect fn enclosed(output: &mut Bytes, source: &IndexedSource, ordinal: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  let index = IndexedSource.moduleIndex(source)
  let declarations = ModuleIndex.listDeclarations(index)
  let hir = IndexedSource.authored(source)
  let mut at = ModuleIndex.firstEnclosed(index, ordinal)
  while at != usize.MAX {
    if let Option<usize>.Some {value} = &declarations[at].parent {
      if value == ordinal {
        run identity(&mut output.*, &declarations[at].identity)
        run node(&mut output.*, hir, declarations[at].header)
      }
    }
    at = ModuleIndex.nextEnclosed(index, at)
  }
}

/// The module's top-level inherent `impl Owner` declarations, with their arms.
pub effect fn inherents(output: &mut Bytes, source: &IndexedSource) -> () ! OutOfMemoryError ? &mut Allocator {
  let index = IndexedSource.moduleIndex(source)
  let declarations = ModuleIndex.listDeclarations(index)
  let hir = IndexedSource.authored(source)
  let mut at = ModuleIndex.firstEnclosed(index, usize.MAX)
  while at != usize.MAX {
    if let Option<usize>.None = &declarations[at].parent {
      if let Node.ImplHeader {target, ..} = Module.node(hir, declarations[at].header) {
        if !target.present {
          run identity(&mut output.*, &declarations[at].identity)
          if let Option<Arm>.Some {value} = &declarations[at].arm {
            run identity(&mut output.*, &declarations[value.conditional].identity)
            run flag(&mut output.*, value.holds)
          } else { run Encoding.field(&mut output.*, b"unconditional") }
        }
      }
    }
    at = ModuleIndex.nextEnclosed(index, at)
  }
}

pub struct Subject { pub position: usize, pub member: usize, pub body: bool }

/// Authenticates a syntax node against its actual indexed declaration; no query-family context.
/// Anonymous syntax belongs to its real enclosing named body, whose content guards its NodeIds.
pub effect fn subject(source: &IndexedSource, id: HirId) -> Option<Subject> ! OutOfMemoryError ? &mut Allocator {
  let index = IndexedSource.moduleIndex(source)
  let hir = IndexedSource.authored(source)
  // Declaration ranges nest or are disjoint, and the starts are ordered by declaration node, so
  // the first indexed declaration at or after `id` whose range begins at or before it is the
  // innermost indexed declaration around it.
  let starts = List<DeclarationStart>.asSlice(&hir.declarationStarts)
  let mut low = usize.ZERO
  let mut high = starts.length
  while low < high {
    let middle = low + (high - low) / 2
    if starts[middle].declaration.index < id.index { low = middle + usize.ONE } else { high = middle }
  }
  let mut selected = usize.MAX
  let mut at = low
  while at < starts.length && selected == usize.MAX {
    if starts[at].first.index <= id.index {
      if let Option<usize>.Some {value} = move ModuleIndex.ordinalAtLocal(index, starts[at].declaration) { selected = value }
    }
    at = at + usize.ONE
  }
  if selected == usize.MAX { return Option<Subject>.none() }
  // A header nested inside the selected declaration's header would select that declaration, so
  // the innermost header around `id` is the selected one exactly when its header holds `id`.
  if let Option<HeaderPlace>.Some {value: place} = move IndexedSource.headerPlace(source, id) {
    if place.declaration == selected {
      return Option<Subject>.some(Subject {position: selected, member: place.member, body: false})
    }
  }
  return Option<Subject>.some(Subject {position: selected, member: usize.MAX, body: true})
}

/// The names consumed by method-supplier discovery; their actual binding and conditions remain
/// separate Name/Import/Condition queries. Include the negative/empty catalog.
pub effect fn visibleNames(output: &mut Bytes, source: &IndexedSource, namespaces: bool, external: bool)
-> () ! OutOfMemoryError ? &mut Allocator {
  let index = IndexedSource.moduleIndex(source)
  let candidates = ModuleIndex.listCandidates(index)
  let declarations = ModuleIndex.listDeclarations(index)
  let hir = IndexedSource.authored(source)
  let mut at = usize.ZERO
  while at < candidates.length {
    let candidate = &candidates[at]
    let mut include = candidate.kind == CandidateKind.ImportModule
    if !namespaces {
      include = candidate.kind == CandidateKind.ImportMember
      if candidate.kind == CandidateKind.Declaration && candidate.declaration < declarations.length {
        if let Node.InterfaceHeader {..} = Module.node(hir, declarations[candidate.declaration].header) { include = true }
      }
      include = include && (!external || candidate.isPublic)
    }
    if include { run Encoding.field(&mut output.*, Bytes.asSlice(&candidate.name)) }
    at = at + usize.ONE
  }
}

/// All authored member-import lists consumed by implicit supplier discovery.
pub effect fn imports(output: &mut Bytes, source: &IndexedSource) -> () ! OutOfMemoryError ? &mut Allocator {
  let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(source))
  let hir = IndexedSource.authored(source)
  let mut at = usize.ZERO
  while at < declarations.length {
    if let Node.ImportHeader {members, ..} = Module.node(hir, declarations[at].header) {
      if members.present && members.range.length > usize.ZERO {
        run identity(&mut output.*, &declarations[at].identity)
        run Encoding.word(&mut output.*, usize.toU64(members.range.length))
      }
    }
    at = at + usize.ONE
  }
}
