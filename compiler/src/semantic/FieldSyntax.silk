//! Source-only omitted-field-lifetime scan shared by typing and consumed-input comparison.
//! This does not resolve names or compare the final recursively resolved lifetime count.
import hir.Hir {CallableContract, HirId, HirRef, Module, Node, Range}
import lexer.Span {Span}
import semantic.SealedCore
import semantic.SealedCore {Core as SealedKind}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.collections.bytes {Bytes}
import silk.option {Option}
import silk.core.ownership {Copy}
import silk.collections.list {List}
import silk.num.usize

pub struct FieldReference {
  pub path: HirId,
  pub span: Span,
  pub arguments: HirRef,
  pub writtenLifetimes: bool,
}
impl Copy for FieldReference {}
pub struct FieldScan { pub omitted: usize, pub references: List<FieldReference> }
fn same(a: &[u8], b: &[u8]) -> bool {
  if a.length != b.length { return false }
  let mut at = usize.ZERO
  while at < a.length { if a[at] != b[at] { return false } at = at + usize.ONE }
  return true
}
fn hasName(names: &[Bytes], name: &[u8]) -> bool {
  let mut at = usize.ZERO
  while at < names.length { if same(Bytes.asSlice(&names[at]), name) { return true } at = at + usize.ONE }
  return false
}
pub fn generics(hir: &Module, id: HirId) -> Range {
  return match Module.node(hir, id) {
    Node.FunctionHeader {contract, ..} => generics(hir, contract)
    Node.OperationHeader {contract, ..} => generics(hir, contract)
    Node.CallableContract {contract} => Module.contract(hir, contract).generics
    Node.StructHeader {generics, ..} => generics
    Node.TupleHeader {generics, ..} => generics
    Node.UnionHeader {generics, ..} => generics
    Node.ServiceHeader {generics, ..} => generics
    Node.InterfaceHeader {generics, ..} => generics
    Node.AliasHeader {generics, ..} => generics
    Node.ImplHeader {generics, ..} => generics
    _ => Range.empty()
  }
}
pub effect fn binderNames(hir: &Module, header: HirId) -> List<Bytes> ! OutOfMemoryError ? &mut Allocator {
  let mut names = List<Bytes>.make()
  let listed = generics(hir, header)
  let mut at = usize.ZERO
  while at < listed.length {
    let named = match Module.node(hir, Module.child(hir, listed, at)) {
      Node.TypeParameter {name, ..} => HirRef.of(name)
      Node.LifetimeParameter {name, ..} => HirRef.of(name)
      Node.RowParameter {name} => HirRef.of(name)
      _ => HirRef.absent()
    }
    if named.present {
      if let Node.Name {text} = Module.node(hir, named.id) { run List<Bytes>.append(&mut names, run Bytes.copy(Module.text(hir, text))) }
    }
    at = at + usize.ONE
  }
  return move names
}
pub fn primitive(name: &[u8]) -> bool {
  return same(name, b"bool") || same(name, b"i8") || same(name, b"i16") || same(name, b"i32") || same(
    name,
    b"i64",
  ) || same(name, b"isize") || same(name, b"u8") || same(name, b"u16") || same(name, b"u32") || same(
    name,
    b"u64",
  ) || same(name, b"usize") || same(name, b"f32") || same(name, b"f64") || same(name, b"char")
}

pub fn writesLifetime(hir: &Module, arguments: Range) -> bool {
  let mut at = usize.ZERO
  while at < arguments.length {
    if let Node.Lifetime {..} = Module.node(hir, Module.child(hir, arguments, at)) {
      return true
    }
    at = at + usize.ONE
  }
  return false
}

pub effect fn scanFieldType(hir: &Module, id: HirId, binders: &[Bytes], scan: &mut FieldScan) -> ()
! OutOfMemoryError
? &mut Allocator {
  let node = Module.node(hir, id)
  if let Node.ReferenceType {referent, lifetime, ..} = node {
    if !lifetime.present {
      scan.omitted = scan.omitted + usize.ONE
    }
    return run scanFieldType(hir, referent, binders, &mut scan.*)
  }
  if let Node.SliceType {element, lifetime, ..} = node {
    if !lifetime.present {
      scan.omitted = scan.omitted + usize.ONE
    }
    return run scanFieldType(hir, element, binders, &mut scan.*)
  }
  if let Node.PointerType {pointee, ..} = node {
    return run scanFieldType(hir, pointee, binders, &mut scan.*)
  }
  if let Node.FixedArrayType {element, ..} = node {
    return run scanFieldType(hir, element, binders, &mut scan.*)
  }
  if let Node.UnionType {members} = node {
    let mut at = usize.ZERO
    while at < members.length {
      run scanFieldType(hir, Module.child(hir, members, at), binders, &mut scan.*)
      at = at + usize.ONE
    }
    return ()
  }
  if let Node.CallableType {environment, ..} = node {
    if !environment.present {
      scan.omitted = scan.omitted + usize.ONE
    }
    return ()
  }
  let mut named = HirRef.absent()
  let mut hasMode = false
  let mut typeArguments = HirRef.absent()
  if let Node.NamedType {path, hasMode: moded, ..} = node {
    named = HirRef.of(path)
    hasMode = moded
  }
  if let Node.AppliedType {target, arguments: written} = node {
    if let Node.NamedType {path, hasMode: moded, ..} = Module.node(hir, target) {
      named = HirRef.of(path)
      hasMode = moded
    }
    if let Node.TypeArguments {..} = Module.node(hir, written) {
      typeArguments = HirRef.of(written)
    }
  }
  if !named.present {
    return ()
  }
  let mut effectType = false
  if let Node.Path {segments} = Module.node(hir, named.id) {
    // A sealed type family has no source field references; only its written element types can
    // generate lifetimes. Member typing still validates its arguments.
    if sealedTypeName(hir, segments) {
      if typeArguments.present {
        if let Node.TypeArguments {arguments: supplied, ..} = Module.node(hir, typeArguments.id) {
          let mut at = usize.ZERO
          while at < supplied.length {
            let argument = Module.child(hir, supplied, at)
            let lifetime = match Module.node(hir, argument) { Node.Lifetime {..} => true _ => false }
            if !lifetime { run scanFieldType(hir, argument, binders, &mut scan.*) }
            at = at + usize.ONE
          }
        }
      }
      return ()
    }
    if segments.length == usize.ONE {
      if let Node.Name {text} = Module.node(hir, Module.child(hir, segments, usize.ZERO)) {
        let spelling = Module.text(hir, text)
        if hasName(binders, spelling) || same(spelling, b"never") || primitive(spelling) {
          return ()
        }
        if same(spelling, b"string") {
          if !typeArguments.present || !argumentsWriteLifetime(hir, typeArguments.id) {
            scan.omitted = scan.omitted + usize.ONE
          }
          return ()
        }
        effectType = same(spelling, b"Effect")
      }
    }
  }
  // Only `Effect` takes a run mode; any other moded name is invalid where its member is demanded.
  if effectType {
    if typeArguments.present {
      if let Node.TypeArguments {arguments: supplied, environment, failures, requirements} = Module.node(
        hir,
        typeArguments.id,
      ) {
        if !environment.present {
          scan.omitted = scan.omitted + usize.ONE
        }
        let mut at = usize.ZERO
        while at < supplied.length {
          run scanFieldType(hir, Module.child(hir, supplied, at), binders, &mut scan.*)
          at = at + usize.ONE
        }
        if failures.present {
          run scanFieldType(hir, failures.id, binders, &mut scan.*)
        }
        if requirements.present {
          run scanRowSyntax(hir, requirements.id, binders, &mut scan.*)
        }
      }
    }
    return ()
  }
  if hasMode {
    return ()
  }
  run List<FieldReference>.append(
    &mut scan.references,
    FieldReference {
      path: named.id,
      span: Module.span(hir, id),
      arguments: typeArguments,
      writtenLifetimes: typeArguments.present && argumentsWriteLifetime(hir, typeArguments.id),
    },
  )
  return ()
}

pub fn argumentsWriteLifetime(hir: &Module, arguments: HirId) -> bool {
  if let Node.TypeArguments {arguments: supplied, ..} = Module.node(hir, arguments) {
    return writesLifetime(hir, supplied)
  }
  return false
}

pub fn sealedTypeName(hir: &Module, segments: Range) -> bool {
  if segments.length != 2 { return false }
  if let Node.Name {text: namespace} = Module.node(hir, Module.child(hir, segments, usize.ZERO)) {
    if let Node.Name {text: family} = Module.node(hir, Module.child(hir, segments, usize.ONE)) {
      if same(Module.text(hir, namespace), b"Intrinsic") {
        let name = Module.text(hir, family)
        if same(name, b"Type") || same(name, b"StaticSequence") || same(name, b"Field") || same(name, b"Fields") ||
          same(name, b"Variant") || same(name, b"Variants") || same(name, b"Test") || same(name, b"Tests") || same(name, b"TestInfo") { return true }
        return match move SealedCore.intrinsicFamily(name) { Option<SealedKind>.Some {..} => true _ => false }
      }
    }
  }
  return false
}

pub effect fn scanRowSyntax(hir: &Module, id: HirId, binders: &[Bytes], scan: &mut FieldScan) -> ()
! OutOfMemoryError
? &mut Allocator {
  let node = Module.node(hir, id)
  if let Node.RequirementRow {members} = node {
    let mut at = usize.ZERO
    while at < members.length {
      run scanRowSyntax(hir, Module.child(hir, members, at), binders, &mut scan.*)
      at = at + usize.ONE
    }
    return ()
  }
  if let Node.UnionType {members} = node {
    let mut at = usize.ZERO
    while at < members.length {
      run scanRowSyntax(hir, Module.child(hir, members, at), binders, &mut scan.*)
      at = at + usize.ONE
    }
    return ()
  }
  if let Node.Requirement {capability, ..} = node {
    return run scanFieldType(hir, capability, binders, &mut scan.*)
  }
  if let Node.ReferenceType {referent, ..} = node {
    return run scanFieldType(hir, referent, binders, &mut scan.*)
  }
  if let Node.RequirementSelector {subject, ..} = node {
    return run scanFieldType(hir, subject, binders, &mut scan.*)
  }
  return ()
}

pub effect fn declaration(hir: &Module, header: HirId) -> FieldScan ! OutOfMemoryError ? &mut Allocator {
  let own = run binderNames(hir, header)
  let binders = List<Bytes>.asSlice(&own)
  let mut scan = FieldScan {omitted: usize.ZERO, references: List<FieldReference>.make()}
  let written = Module.node(hir, header)
  if let Node.StructHeader {fields, ..} = written {
    let mut at = usize.ZERO
    while at < fields.length {
      if let Node.Field {annotation, ..} = Module.node(hir, Module.child(hir, fields, at)) {
        run scanFieldType(hir, annotation, binders, &mut scan)
      }
      at = at + usize.ONE
    }
  }
  if let Node.TupleHeader {elements, ..} = written {
    let mut at = usize.ZERO
    while at < elements.length {
      run scanFieldType(hir, Module.child(hir, elements, at), binders, &mut scan)
      at = at + usize.ONE
    }
  }
  if let Node.UnionHeader {variants, ..} = written {
    let mut at = usize.ZERO
    while at < variants.length {
      if let Node.Variant {fields, ..} = Module.node(hir, Module.child(hir, variants, at)) {
        let mut fieldAt = usize.ZERO
        while fieldAt < fields.length {
          if let Node.Field {annotation, ..} = Module.node(
            hir,
            Module.child(hir, fields, fieldAt),
          ) {
            run scanFieldType(hir, annotation, binders, &mut scan)
          }
          fieldAt = fieldAt + usize.ONE
        }
      }
      at = at + usize.ONE
    }
  }
  if let Node.AliasHeader {target, ..} = written {
    run scanFieldType(hir, target, binders, &mut scan)
  }
  return move scan
}
