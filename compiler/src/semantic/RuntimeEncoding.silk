//! Canonical content encodings for runtime families and exact instance identities.

import hir.Hir {OwnerKind}
import semantic.DeclarationId {DeclarationId, OwnerStep, Part, Projection}
import semantic.Lifetime {Lifetime}
import silk.shared {Shared}
import semantic.ModuleId {ModuleId, InvalidModulePath}
import silk.effect {Effect}
import silk.result {Result}
import silk.allocator {Allocator, OutOfMemoryError}
import silk.bytes {Bytes}
import silk.option {Option}
import silk.u8
import silk.u64
import silk.usize
import silk.vector {Vector}

/// Coordinates turn a module-local expression index into an ordinal within its declaration.
/// Semantic proof keeps the original region; linkage never includes the module allocation offset.
pub struct Coordinates {
  pub origins: Vector<LocalOrigin>
  pub bounded: bool
  pub remainingBytes: usize
  pub exceeded: bool
}

pub struct LocalOrigin {
  pub owner: DeclarationId
  pub base: Option<usize>
}

pub fn coordinates() -> Coordinates {
  return Coordinates {origins: Vector.make<LocalOrigin>(), bounded: false, remainingBytes: usize.ZERO, exceeded: false}
}

/// One shared record-production byte budget across all nested identity encoders.
pub fn limitedCoordinates(bytes: usize) -> Coordinates {
  let mut value = coordinates()
  value.bounded = true
  value.remainingBytes = bytes
  return move value
}
fn recordCharge(value: &mut Coordinates, bytes: usize) -> bool {
  if !value.bounded { return true }
  if value.exceeded { return false }
  if bytes > value.remainingBytes { value.exceeded = true
    return false }
  value.remainingBytes = value.remainingBytes - bytes
  return true
}
/// A copied identity payload is charged before allocating its temporary record.
pub fn recordPayload(coordinates: &mut Coordinates, count: usize) -> bool {
  return recordCharge(&mut coordinates.*, count)
}
/// Saturated raw identity payload size; MAX cannot pass a bounded byte transaction.
pub fn declarationPayload(value: &DeclarationId) -> usize {
  let module = DeclarationId.moduleId(value)
  let mut total = usize.ZERO + 32
  let parts: [usize; 3] = [ModuleId.sourceOrigin(module).length,
    ModuleId.packageIdentity(module).length, ModuleId.logicalPath(module).length]
  let mut at = usize.ZERO
  while at < 3 {
    if parts[at] > usize.MAX - total { return usize.MAX }
    total = total + parts[at]
    at = at + usize.ONE
  }
  let owners = DeclarationId.ownerCount(value)
  at = usize.ZERO
  while at < owners {
    if total > usize.MAX - 32 { return usize.MAX }
    total = total + 32
    if DeclarationId.ownerNamed(value, at) {
      let count = DeclarationId.ownerName(value, at).length
      if count > usize.MAX - total { return usize.MAX }
      total = total + count
    }
    at = at + usize.ONE
  }
  return total
}
/// Checks an owned declaration copy before allocation in the same record transaction.
pub fn declarationFits(value: &Shared<DeclarationId>, coordinates: &mut Coordinates) -> bool {
  return Shared.with<DeclarationId, bool>(value, fn(identity: &DeclarationId) -> bool {
    return recordPayload(&mut coordinates.*, declarationPayload(identity))
  })
}
pub fn recordEqual(left: &[u8], right: &[u8], coordinates: &mut Coordinates) -> bool {
  if !recordCompared(&mut coordinates.*, left, right) { return false }
  return equals(left, right)
}

pub effect fn recordWord(output: &mut Bytes, value: u64, coordinates: &mut Coordinates) -> ()
! OutOfMemoryError ? &mut Allocator {
  if !recordCharge(&mut coordinates.*, 8) { return () }
  return run word(&mut output.*, value)
}
pub effect fn recordField(output: &mut Bytes, value: &[u8], coordinates: &mut Coordinates) -> ()
! OutOfMemoryError ? &mut Allocator {
  if !recordCharge(&mut coordinates.*, 8) { return () }
  if !recordCharge(&mut coordinates.*, value.length) { return () }
  return run field(&mut output.*, value)
}
// Failed insertion comparisons consume the same budget as successful comparisons.
fn recordCompared(coordinates: &mut Coordinates, left: &[u8], right: &[u8]) -> bool {
  if !recordCharge(&mut coordinates.*, left.length) { return false }
  return recordCharge(&mut coordinates.*, right.length)
}
pub effect fn recordSet(output: &mut Bytes, members: &Vector<Bytes>, coordinates: &mut Coordinates) -> ()
! OutOfMemoryError ? &mut Allocator {
  if coordinates.exceeded { return () }
  let listed = Vector.asSlice<Bytes>(members)
  let mut order = Vector.make<usize>()
  let mut at = usize.ZERO
  while at < listed.length {
    run Vector.append<usize>(&mut order, at)
    let mut position = at
    while position > usize.ZERO {
      let previous = Vector.asSlice<usize>(&order)[position - usize.ONE]
      let current = Vector.asSlice<usize>(&order)[position]
      let first = Bytes.asSlice(&listed[current])
      let second = Bytes.asSlice(&listed[previous])
      if !recordCompared(&mut coordinates.*, first, second) { return () }
      if !less(first, second) { break }
      let ranked = Vector.asMutSlice<usize>(&mut order)
      ranked[position - usize.ONE] = current
      ranked[position] = previous
      position = position - usize.ONE
    }
    at = at + usize.ONE
  }
  let sorted = Vector.asSlice<usize>(&order)
  let mut retained = Vector.make<usize>()
  at = usize.ZERO
  while at < sorted.length {
    let mut distinct = true
    if at > usize.ZERO {
      let first = Bytes.asSlice(&listed[sorted[at]])
      let second = Bytes.asSlice(&listed[sorted[at - usize.ONE]])
      if !recordCompared(&mut coordinates.*, first, second) { return () }
      distinct = !equals(first, second)
    }
    if distinct { run Vector.append<usize>(&mut retained, sorted[at]) }
    at = at + usize.ONE
  }
  let unique = Vector.asSlice<usize>(&retained)
  run recordWord(&mut output.*, usize.toU64(unique.length), &mut coordinates.*)
  at = usize.ZERO
  while at < unique.length {
    run recordField(&mut output.*, Bytes.asSlice(&listed[unique[at]]), &mut coordinates.*)
    if coordinates.exceeded { return () }
    at = at + usize.ONE
  }
  return ()
}
/// Copies an intermediate exact record after accounting for its produced bytes.
pub effect fn recordCopy(value: &[u8], coordinates: &mut Coordinates) -> Bytes
! OutOfMemoryError ? &mut Allocator {
  if !recordCharge(&mut coordinates.*, value.length) { return Bytes.make() }
  return run Bytes.copy(value)
}

pub effect fn recordDeclaration(output: &mut Bytes, value: &DeclarationId, coordinates: &mut Coordinates) -> ()
! OutOfMemoryError ? &mut Allocator {
  let module = DeclarationId.moduleId(value)
  run recordField(&mut output.*, ModuleId.sourceOrigin(module), &mut coordinates.*)
  run recordField(&mut output.*, ModuleId.packageIdentity(module), &mut coordinates.*)
  run recordField(&mut output.*, ModuleId.logicalPath(module), &mut coordinates.*)
  let owners = DeclarationId.ownerCount(value)
  run recordWord(&mut output.*, usize.toU64(owners), &mut coordinates.*)
  let mut at = usize.ZERO
  while at < owners {
    run recordWord(&mut output.*, kindCode(DeclarationId.ownerKind(value, at)), &mut coordinates.*)
    if DeclarationId.ownerNamed(value, at) {
      run recordWord(&mut output.*, 1, &mut coordinates.*)
      run recordField(&mut output.*, DeclarationId.ownerName(value, at), &mut coordinates.*)
    } else {
      run recordWord(&mut output.*, 0, &mut coordinates.*)
    }
    run recordWord(&mut output.*, usize.toU64(DeclarationId.ownerOccurrence(value, at)), &mut coordinates.*)
    at = at + usize.ONE
  }
  return ()
}

pub fn equals(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

pub fn less(left: &[u8], right: &[u8]) -> bool {
  let mut at = usize.ZERO
  while at < left.length && at < right.length {
    if left[at] != right[at] {
      return left[at] < right[at]
    }
    at = at + usize.ONE
  }
  return left.length < right.length
}

/// Appends one fixed-width unsigned field, independent of host byte order.
pub effect fn word(output: &mut Bytes, value: u64) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut bytes: [u8; 8] = [0, 0, 0, 0, 0, 0, 0, 0]
  let mut at = usize.ZERO
  while at < 8 {
    bytes[at] = u64.toU8(u64.bitAnd(u64.shiftRight(value, usize.toU64((7 - at) * 8)), 255))
    at = at + usize.ONE
  }
  return run Bytes.append(&mut output.*, &bytes)
}

/// Appends a length-delimited exact byte field.
pub effect fn field(output: &mut Bytes, value: &[u8]) -> () ! OutOfMemoryError ? &mut Allocator {
  run word(&mut output.*, usize.toU64(value.length))
  return run Bytes.append(&mut output.*, value)
}

fn kindCode(kind: OwnerKind) -> u64 {
  return match kind {
    OwnerKind.Import => 1
    OwnerKind.Conditional => 2
    OwnerKind.ModuleProperty => 3
    OwnerKind.Implementation => 4
    OwnerKind.Function => 5
    OwnerKind.Struct => 6
    OwnerKind.Tuple => 7
    OwnerKind.Enumeration => 8
    OwnerKind.Union => 9
    OwnerKind.Service => 10
    OwnerKind.Interface => 11
    OwnerKind.Role => 12
    OwnerKind.Constant => 13
    OwnerKind.PackageParameter => 14
    OwnerKind.Alias => 15
    OwnerKind.Static => 16
    OwnerKind.Damaged => 17
    OwnerKind.Anonymous => 18
    OwnerKind.EffectBlock => 19
  }
}

/// Encodes the complete declaration content, never a digest or query ordinal.
pub effect fn declaration(output: &mut Bytes, value: &DeclarationId) -> ()
! OutOfMemoryError
? &mut Allocator {
  let module = DeclarationId.moduleId(value)
  run field(&mut output.*, ModuleId.sourceOrigin(module))
  run field(&mut output.*, ModuleId.packageIdentity(module))
  run field(&mut output.*, ModuleId.logicalPath(module))
  let owners = DeclarationId.ownerCount(value)
  run word(&mut output.*, usize.toU64(owners))
  let mut at = usize.ZERO
  while at < owners {
    run word(&mut output.*, kindCode(DeclarationId.ownerKind(value, at)))
    if DeclarationId.ownerNamed(value, at) {
      run word(&mut output.*, 1)
      run field(&mut output.*, DeclarationId.ownerName(value, at))
    } else {
      run word(&mut output.*, 0)
    }
    run word(&mut output.*, usize.toU64(DeclarationId.ownerOccurrence(value, at)))
    at = at + usize.ONE
  }
  return ()
}

/// Positions of `members` in canonical set order; equal encodings stay adjacent.
pub effect fn order(members: &Vector<Bytes>) -> Vector<usize>
! OutOfMemoryError
? &mut Allocator {
  let listed = Vector.asSlice<Bytes>(members)
  let mut order = Vector.make<usize>()
  let mut at = usize.ZERO
  while at < listed.length {
    run Vector.append<usize>(&mut order, at)
    at = at + usize.ONE
  }
  let sorted = Vector.asMutSlice<usize>(&mut order)
  at = usize.ONE
  while at < sorted.length {
    let mut next = at
    while next > usize.ZERO && less(
      Bytes.asSlice(&listed[sorted[next]]),
      Bytes.asSlice(&listed[sorted[next - usize.ONE]]),
    ) {
      let prior = sorted[next - usize.ONE]
      sorted[next - usize.ONE] = sorted[next]
      sorted[next] = prior
      next = next - usize.ONE
    }
    at = at + usize.ONE
  }
  return move order
}

/// Appends a sorted, duplicate-free set of already encoded members.
pub effect fn set(output: &mut Bytes, members: &Vector<Bytes>) -> ()
! OutOfMemoryError
? &mut Allocator {
  let listed = Vector.asSlice<Bytes>(members)
  let ranked = run order(members)
  let sorted = Vector.asSlice<usize>(&ranked)
  let mut unique = usize.ZERO
  let mut at = usize.ZERO
  while at < sorted.length {
    if at == usize.ZERO || !equals(
      Bytes.asSlice(&listed[sorted[at]]),
      Bytes.asSlice(&listed[sorted[at - usize.ONE]]),
    ) {
      unique = unique + usize.ONE
    }
    at = at + usize.ONE
  }
  run word(&mut output.*, usize.toU64(unique))
  at = usize.ZERO
  while at < sorted.length {
    if at == usize.ZERO || !equals(
      Bytes.asSlice(&listed[sorted[at]]),
      Bytes.asSlice(&listed[sorted[at - usize.ONE]]),
    ) {
      run field(&mut output.*, Bytes.asSlice(&listed[sorted[at]]))
    }
    at = at + usize.ONE
  }
  return ()
}
// Read declaration content through the held lifetime without allocating under Shared.with.
fn lifetimeProjection(value: &Lifetime, part: Part, owner: usize, offset: usize) -> Projection {
  return match & value.* {
    Lifetime.Parameter {declaration, ..} => DeclarationId.project(&declaration, part, owner, offset)
    Lifetime.Local {declaration, ..} => DeclarationId.project(&declaration, part, owner, offset)
    _ => Projection {
      length: usize.ZERO,
      byte: 0,
      kind: OwnerKind.Damaged,
      occurrence: usize.ZERO,
      named: false,
    }
  }
}

effect fn lifetimeBytes(value: &Shared<Lifetime>, part: Part, owner: usize) -> Bytes
! OutOfMemoryError
? &mut Allocator {
  let measured = Shared.with<Lifetime, Projection>(
    value,
    fn(region: &Lifetime) -> Projection {
      return lifetimeProjection(region, part, owner, usize.MAX)
    },
  )
  let mut bytes = run Bytes.zeroed(measured.length)
  let target = Bytes.asMutSlice(&mut bytes)
  let mut at = usize.ZERO
  while at < target.length {
    target[at] = Shared.with<Lifetime, Projection>(
      value,
      fn(region: &Lifetime) -> Projection {
        return lifetimeProjection(region, part, owner, at)
      },
    ).byte
    at = at + usize.ONE
  }
  return move bytes
}

effect fn lifetimeField(output: &mut Bytes, value: &Shared<Lifetime>, part: Part, owner: usize) -> ()
! OutOfMemoryError
? &mut Allocator {
  let bytes = run lifetimeBytes(value, part, owner)
  return run field(&mut output.*, Bytes.asSlice(&bytes))
}

effect fn lifetimeOwner(value: &Shared<Lifetime>) -> DeclarationId
! OutOfMemoryError
? &mut Allocator {
  let origin = run lifetimeBytes(value, Part.Origin, usize.MAX)
  let package = run lifetimeBytes(value, Part.Package, usize.MAX)
  let path = run lifetimeBytes(value, Part.Path, usize.MAX)
  let assembled = run Effect.result(ModuleId.fromParts(move origin, move package, move path))
  let module = match move assembled {
    Result<ModuleId, InvalidModulePath>.Success {value: identity} => move identity
    _ => {
      return absurd<DeclarationId>()
    }
  }
  let mut owners = Vector.make<OwnerStep>()
  let count = Shared.with<Lifetime, Projection>(
    value,
    fn(region: &Lifetime) -> Projection {
      return lifetimeProjection(region, Part.Owners, usize.MAX, usize.MAX)
    },
  ).length
  let mut at = usize.ZERO
  while at < count {
    let step = Shared.with<Lifetime, Projection>(
      value,
      fn(region: &Lifetime) -> Projection {
        return lifetimeProjection(region, Part.Owners, at, usize.MAX)
      },
    )
    let mut name = Option.none<Bytes>()
    if step.named {
      name = Option.some<Bytes>(run lifetimeBytes(value, Part.Owners, at))
    }
    run Vector.append<OwnerStep>(
      &mut owners,
      OwnerStep {kind: step.kind, occurrence: step.occurrence, name: move name},
    )
    at = at + usize.ONE
  }
  return run DeclarationId.fromParts(move module, move owners)
}

effect fn recordLifetimeField(output: &mut Bytes, value: &Shared<Lifetime>, part: Part, owner: usize,
  coordinates: &mut Coordinates) -> () ! OutOfMemoryError ? &mut Allocator {
  let count = Shared.with<Lifetime, Projection>(value, fn(region: &Lifetime) -> Projection {
    return lifetimeProjection(region, part, owner, usize.MAX)
  }).length
  if !recordCharge(&mut coordinates.*, 8) { return () }
  if !recordCharge(&mut coordinates.*, count) { return () }
  let bytes = run lifetimeBytes(value, part, owner)
  return run field(&mut output.*, Bytes.asSlice(&bytes))
}

/// Exact validity evidence for a semantic instance; never a body or allocation identity.
pub effect fn lifetime(output: &mut Bytes, value: &Shared<Lifetime>, coordinates: &mut Coordinates) -> ()
! OutOfMemoryError
? &mut Allocator {
  let atoms = Lifetime.atomCount(value)
  if atoms > usize.ONE {
    let mut encoded = Vector.make<Bytes>()
    let mut at = usize.ZERO
    while at < atoms {
      let atom = Lifetime.atomAt(value, at)
      let mut member = Bytes.make()
      run lifetime(&mut member, &atom, &mut coordinates.*)
      run Vector.append<Bytes>(&mut encoded, move member)
      at = at + usize.ONE
    }
    run recordWord(&mut output.*, 5, &mut coordinates.*)
    return run recordSet(&mut output.*, &encoded, &mut coordinates.*)
  }
  let kind = Shared.with<Lifetime, u64>(
    value,
    fn(region: &Lifetime) -> u64 {
      return match & region.* {
        Lifetime.Static => 0
        Lifetime.Parameter {..} => 1
        Lifetime.Local {..} => 2
        Lifetime.Invocation {..} => 3
        Lifetime.Supplied {..} => 4
        Lifetime.Meet {..} => 5
      }
    },
  )
  run recordWord(&mut output.*, kind, &mut coordinates.*)
  if kind == 0 {
    return ()
  }
  let ordinal = Shared.with<Lifetime, usize>(
    value,
    fn(region: &Lifetime) -> usize {
      return match & region.* {
        Lifetime.Parameter {ordinal, ..} => ordinal
        Lifetime.Local {ordinal, ..} => ordinal
        Lifetime.Invocation {ordinal} => ordinal
        Lifetime.Supplied {ordinal} => ordinal
        _ => usize.ZERO
      }
    },
  )
  if kind == 2 {
    if ordinal == usize.MAX {
      run recordWord(&mut output.*, 3, &mut coordinates.*)
      run recordWord(&mut output.*, 0, &mut coordinates.*)
    } else {
      let owner = run lifetimeOwner(value)
      let entries = Vector.asSlice<LocalOrigin>(&coordinates.origins)
      let mut at = usize.ZERO
      let mut base = Option.none<usize>()
      while at < entries.length {
        if DeclarationId.equals(&entries[at].owner, &owner) {
          if let Option<usize>.Some {value: offset} = &entries[at].base {
            base = Option.some<usize>(offset)
          }
          break
        }
        at = at + usize.ONE
      }
      if at == entries.length {
        run Vector.append<LocalOrigin>(
          &mut coordinates.origins,
          LocalOrigin {owner: move owner, base: Option.none<usize>()},
        )
      }
      match move base {
        Option<usize>.Some {value: coordinate} => {
          if ordinal < coordinate {
            run recordWord(&mut output.*, 1, &mut coordinates.*)
            run recordWord(&mut output.*, usize.toU64(coordinate - ordinal), &mut coordinates.*)
          } else {
            run recordWord(&mut output.*, 2, &mut coordinates.*)
            run recordWord(&mut output.*, usize.toU64(ordinal - coordinate), &mut coordinates.*)
          }
        }
        _ => {
          run recordWord(&mut output.*, 0, &mut coordinates.*)
          run recordWord(&mut output.*, usize.toU64(ordinal), &mut coordinates.*)
        }
      }
    }
  } else {
    run recordWord(&mut output.*, usize.toU64(ordinal), &mut coordinates.*)
  }
  // Invocation binders and instance-supplied regions are identified by position alone.
  if kind == 3 || kind == 4 {
    return ()
  }
  run recordLifetimeField(&mut output.*, value, Part.Origin, usize.MAX, &mut coordinates.*)
  run recordLifetimeField(&mut output.*, value, Part.Package, usize.MAX, &mut coordinates.*)
  run recordLifetimeField(&mut output.*, value, Part.Path, usize.MAX, &mut coordinates.*)
  let count = Shared.with<Lifetime, Projection>(
    value,
    fn(region: &Lifetime) -> Projection {
      return lifetimeProjection(region, Part.Owners, usize.MAX, usize.MAX)
    },
  ).length
  run recordWord(&mut output.*, usize.toU64(count), &mut coordinates.*)
  let mut at = usize.ZERO
  while at < count {
    let step = Shared.with<Lifetime, Projection>(
      value,
      fn(region: &Lifetime) -> Projection {
        return lifetimeProjection(region, Part.Owners, at, usize.MAX)
      },
    )
    run recordWord(&mut output.*, kindCode(step.kind), &mut coordinates.*)
    if step.named {
      run recordWord(&mut output.*, 1, &mut coordinates.*)
      run recordLifetimeField(&mut output.*, value, Part.Owners, at, &mut coordinates.*)
    } else {
      run recordWord(&mut output.*, 0, &mut coordinates.*)
    }
    run recordWord(&mut output.*, usize.toU64(step.occurrence), &mut coordinates.*)
    at = at + usize.ONE
  }
  return ()
}

// Reconstructing already validated identity parts cannot fail validation.
fn absurd<T>() -> T {
  let boom = 1 / 0
  return absurd<T>()
}
