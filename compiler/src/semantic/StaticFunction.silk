//! A demanded static function's authored header and body.
//!
//! # When to use
//! Select a static function only when a static application needs it. The source unit owns every
//! returned HIR identity, so callers must retain that unit for the whole evaluation.

import hir.Hir {CallableContract, HirId, HirRef, Module, Node, ParameterMode, Range}
import lexer.Span {Span}
import semantic.DeclarationId {DeclarationId}
import semantic.ModuleIndex {ModuleIndex}
import semantic.SourceIndex {IndexedSource}
import semantic.SourceUnit {SourceUnit}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.core.option {Option}
import silk.core.result {Result}
import silk.num.usize
import silk.collections.list {List}

/// A function selected by a concrete static application.
pub struct StaticFunction {
  pub declaration: DeclarationId,
  pub block: HirId,
  pub parameters: List<HirId>,
  pub result: HirRef,
  pub generics: Range,
  pub span: Span,
  /// An interface's `static` operation with a default body. Its application binds the
  /// interface's `Self` in the innermost scope, which is not one of the signature's parameters.
  pub operation: bool,
}

/// A header that cannot denote a callable static function.
pub enum HeaderFault {
  UnknownName,
  AmbiguousName,
  RuntimeFunction,
  InvalidPosition,
  InvalidModifiers,
  MissingBody,
}

/// A stable source anchor for header validation.
pub struct Rejection {
  pub fault: HeaderFault,
  pub span: Span,
}

/// Selects from the exact source retained by an authenticated cursor.
pub effect fn selectIndexed(indexed: &IndexedSource, declaration: &DeclarationId) -> Result<
  StaticFunction,
  Rejection,
> ! OutOfMemoryError ? &mut Allocator {
  let unit = IndexedSource.sourceUnit(indexed)
  let index = IndexedSource.moduleIndex(indexed)
  return run select(unit, index, declaration)
}

/// Selects one top-level, inherent or witness `static fn`, or an interface's `static` operation with
/// a default body, by its canonical declaration without visiting its body.
pub effect fn select(unit: &SourceUnit, index: &ModuleIndex, declaration: &DeclarationId) -> Result<
  StaticFunction,
  Rejection,
> ! OutOfMemoryError ? &mut Allocator {
  let hir = &unit.authored
  let declarations = ModuleIndex.listDeclarations(index)
  let mut found = usize.MAX
  let mut at = usize.ZERO
  while at < declarations.length {
    if DeclarationId.equals(&declarations[at].identity, declaration) {
      if found != usize.MAX {
        return Result<StaticFunction, Rejection>.failResult(
          Rejection {fault: HeaderFault.AmbiguousName, span: Module.span(hir, declarations[at].local)},
        )
      }
      found = at
    }
    at = at + usize.ONE
  }
  if found == usize.MAX {
    return Result<StaticFunction, Rejection>.failResult(
      Rejection {fault: HeaderFault.UnknownName, span: Span.make(usize.ZERO, usize.ZERO)},
    )
  }
  let selected = &declarations[found]
  let span = Module.span(hir, selected.header)
  if let Node.Declaration {header, body, ..} = Module.node(hir, selected.local) {
    // A function, or an interface's `static` operation whose default body a conformance that
    // omits it runs (INTF-002, INTF-008).
    let mut written = Option<HirId>.none()
    let mut linked = false
    let mut operation = false
    match Module.node(hir, header) {
      Node.FunctionHeader {contract, linkage, ..} => {
        written = Option<HirId>.some(contract)
        linked = linkage.present
      }
      Node.OperationHeader {contract, ..} => {
        written = Option<HirId>.some(contract)
        operation = true
      }
      _ => ()
    }
    if let Option<HirId>.Some {value: contract} = move written {
      if let Option<CallableContract>.Some {value: CallableContract {generics,
        parameters,
        variadic,
        result,
        failures,
        requirements,
        isEffect,
        isTest,
        environment,
        isUnsafe,
        isStatic,
        ..,}} = Module.contractOf(hir, contract) {
        // A runtime function runs statically when its signature says it is pure: not `effect`,
        // `unsafe` or `test`, with no failures, requirements, environment, linkage or `static`
        // parameters (STATIC-016).
        if operation && !isStatic {
          return Result<StaticFunction, Rejection>.failResult(
            Rejection {fault: HeaderFault.RuntimeFunction, span: Module.span(hir, contract)},
          )
        }
        if !isStatic {
          let mut pure = !(isEffect || isUnsafe || isTest || variadic || failures.present || requirements.present
            || environment.present || linked)
          let mut written = usize.ZERO
          while pure && written < parameters.length {
            if let Node.Parameter {mode: ParameterMode.Static, ..} = Module.node(hir, Module.child(hir, parameters, written)) { pure = false }
            written = written + usize.ONE
          }
          if !pure {
            return Result<StaticFunction, Rejection>.failResult(
              Rejection {fault: HeaderFault.RuntimeFunction, span: Module.span(hir, contract)},
            )
          }
        }
        if let Option<usize>.Some {value: parent} = &selected.parent {
          // An inherent method or a conformance's witness for a `static` interface operation.
          let mut member = false
          if parent < declarations.length {
            if let Node.Declaration {header: parentHeader, ..} = Module.node(hir, declarations[parent].local) {
              if let Node.ImplHeader {..} = Module.node(hir, parentHeader) {
                member = !operation
              }
              if let Node.InterfaceHeader {..} = Module.node(hir, parentHeader) {
                member = operation
              }
            }
          }
          if !member {
            return Result<StaticFunction, Rejection>.failResult(
              Rejection {fault: HeaderFault.InvalidPosition, span: span},
            )
          }
        }
        if isEffect || isUnsafe || isTest || variadic || failures.present || requirements.present || environment.present || linked {
          return Result<StaticFunction, Rejection>.failResult(
            Rejection {fault: HeaderFault.InvalidModifiers, span: Module.span(hir, contract)},
          )
        }
        if let Node.CallableBody {block} = Module.node(hir, body) {
          if !block.present {
            return Result<StaticFunction, Rejection>.failResult(
              Rejection {fault: HeaderFault.MissingBody, span: Module.span(hir, body)},
            )
          }
          let mut binders = run List<HirId>.makeWithCapacity(parameters.length)
          let mut parameter = usize.ZERO
          while parameter < parameters.length {
            run List<HirId>.append(&mut binders, Module.child(hir, parameters, parameter))
            parameter = parameter + usize.ONE
          }
          return Result<StaticFunction, Rejection>.succeed(
            StaticFunction {
              declaration: DeclarationId.copy(&selected.identity),
              block: block.id,
              parameters: move binders,
              result: result,
              generics: generics,
              span: span,
              operation: operation,
            },
          )
        }
      }
    }
  }
  return Result<StaticFunction, Rejection>.failResult(
    Rejection {fault: HeaderFault.RuntimeFunction, span: span},
  )
}
