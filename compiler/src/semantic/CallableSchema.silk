//! Immutable callable invocation metadata. A schema becomes an ordinary application only
//! after one use supplies all remaining evidence; its environment contains only stored captures.

import CompilerBug
import semantic.DeclarationId {DeclarationId}
import semantic.RuntimeEncoding
import semantic.RuntimeEncoding {Coordinates}
import semantic.Type {Argument, Binding, Row, Type}
import semantic.Types {Types}
import semantic.Lifetime {Intersection, Lifetime, Member}
import hir.Hir {CallableMode}
import silk.option {Option}
import silk.allocator {Allocator, OutOfMemoryError}
import silk.bytes {Bytes}
import silk.shared {Shared}
import silk.usize
import silk.list {List}

/// An anonymous callable or section's bound blueprint and free construction evidence. The contract's target
/// variables are bound by `deferred`; selected argument values are free caller evidence.
pub struct CallableSchema {
  pub target: Shared<DeclarationId>
  pub contract: Shared<Type>
  pub output: Shared<OutputTransform>
  pub selected: List<Binding>
  pub deferred: List<usize>
}

/// Ordered producer transformations of the original declaration result/success. These are
/// bound schema facts, not the final bindings of a later invocation or physical capture paths.
pub enum OutputBindingKind { Applied, Representations, Invocations }
pub struct OutputBinding {
  pub kind: OutputBindingKind
  /// Exact actual invocation opening, applied before this stage's owner-qualified bindings.
  pub opening: Option<Shared<DeclarationId>>
  pub bindings: List<Binding>
}
pub union OutputRoot {
  /// An ordinary result, with only an ACTUAL top-level captured Effect environment adjustment.
  Result {pub environment: Option<Shared<Intersection>>},
  /// An effect-fn's original success is wrapped at this exact producer. These fields are the
  /// real resulting wrapper; they are never recursively applied to a nested result type.
  Success {pub mode: CallableMode, pub environment: Shared<Intersection>,
    pub failure: Shared<Type>, pub requirements: Shared<Row>},
}
pub struct OutputTransform {
  pub steps: List<OutputBinding>
  pub root: OutputRoot
}

/// Explicit identity for an ordinary raw declaration blueprint, including synthetic schemas.
pub effect fn identityOutput() -> Shared<OutputTransform> ! OutOfMemoryError ? &mut Allocator {
  return run Shared<OutputTransform>.make(OutputTransform {steps: List<OutputBinding>.make(),
    root: OutputRoot.Result {environment: Option<Shared<Intersection>>.none()}})
}

pub fn copyOutputRoot(value: &OutputRoot) -> OutputRoot {
  return match &value.* {
    OutputRoot.Result {environment} => {
      let mut selected = Option<Shared<Intersection>>.none()
      if let Option<Shared<Intersection>>.Some {value: boundValue} = &environment {
        selected = Option<Shared<Intersection>>.some(Shared<Intersection>.clone(&boundValue))
      }
      return OutputRoot.Result {environment: move selected}
    }
    OutputRoot.Success {mode, environment, failure, requirements} => OutputRoot.Success {mode: mode,
      environment: Shared<Intersection>.clone(&environment), failure: Shared<Type>.clone(&failure), requirements: Shared<Row>.clone(&requirements)}
  }
}

pub effect fn copyOutput(value: &Shared<OutputTransform>) -> OutputTransform ! OutOfMemoryError ? &mut Allocator {
  let mut output = Shared<OutputTransform>.with<OutputTransform>(value, fn(value: &OutputTransform) -> OutputTransform {
    return OutputTransform {steps: List<OutputBinding>.make(), root: copyOutputRoot(&value.root)}
  })
  let count = Shared<OutputTransform>.with<usize>(value, fn(value: &OutputTransform) -> usize { return List<OutputBinding>.length(&value.steps) })
  let mut at = usize.ZERO
  while at < count {
    let kind = Shared<OutputTransform>.with<OutputBindingKind>(value,
      fn(value: &OutputTransform) -> OutputBindingKind { return List<OutputBinding>.asSlice(&value.steps)[at].kind })
    let opening = Shared<OutputTransform>.with<Option<Shared<DeclarationId>>>(value, fn(value: &OutputTransform) -> Option<Shared<DeclarationId>> {
      return match &List<OutputBinding>.asSlice(&value.steps)[at].opening {
        Option<Shared<DeclarationId>>.Some {value: boundValue} => Option<Shared<DeclarationId>>.some(Shared<DeclarationId>.clone(&boundValue))
        _ => Option<Shared<DeclarationId>>.none()
      }
    })
    let length = Shared<OutputTransform>.with<usize>(value, fn(value: &OutputTransform) -> usize {
      return List<Binding>.length(&List<OutputBinding>.asSlice(&value.steps)[at].bindings)
    })
    let mut bindings = List<Binding>.make()
    let mut slot = usize.ZERO
    while slot < length {
      let binding = Shared<OutputTransform>.with<Binding>(value, fn(value: &OutputTransform) -> Binding {
        let binding = &List<Binding>.asSlice(&List<OutputBinding>.asSlice(&value.steps)[at].bindings)[slot]
        return Binding {declaration: Shared<DeclarationId>.clone(&binding.declaration), ordinal: binding.ordinal, value: Argument.copy(&binding.value)}
      })
      run List<Binding>.append(&mut bindings, move binding)
      slot = slot + usize.ONE
    }
    run List<OutputBinding>.append(&mut output.steps, OutputBinding {kind: kind, opening: move opening, bindings: move bindings})
    at = at + usize.ONE
  }
  return move output
}

/// Apply the retained ordered binding stages to ONE selected original subject. Root wrapper
/// facts are separate, so this cannot replace an unrelated nested Effect's environment.
pub effect fn applyOutputBindings(value: &Shared<OutputTransform>, original: &Shared<Type>) -> Shared<Type>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let output = run copyOutput(value)
  let steps = List<OutputBinding>.asSlice(&output.steps)
  let mut result = Shared<Type>.clone(original)
  let mut at = usize.ZERO
  while at < steps.length {
    if let Option<Shared<DeclarationId>>.Some {value: boundValue} = &steps[at].opening {
      result = run Type.openInvocation(&result, &DeclarationId.copyShared(&boundValue))
    }
    result = run Type.applyBindings(&result, List<Binding>.asSlice(&steps[at].bindings), true)
    at = at + usize.ONE
  }
  return move result
}

/// Rebuild ONLY the produced root. A selected child uses applyOutputBindings instead, so
/// wrapper and retained-environment facts never migrate to an unrelated nested Effect.
pub effect fn applyOutput(value: &Shared<OutputTransform>, original: &Shared<Type>) -> Shared<Type>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let transformed = run applyOutputBindings(value, original)
  let root = Shared<OutputTransform>.with<OutputRoot>(value,
    fn(value: &OutputTransform) -> OutputRoot { return copyOutputRoot(&value.root) })
  return match move root {
    OutputRoot.Result {environment: Option<Shared<Intersection>>.None} => move transformed
    OutputRoot.Result {environment: Option<Shared<Intersection>>.Some {value: environment}} => {
      if let Type.Effect {mode, success, failure, requirements, ..} = move run Type.copy(&transformed) {
        return run Types.intern(Type.Effect {mode: mode, environment: move environment,
          success: move success, failure: move failure, requirements: move requirements})
      }
      return CompilerBug.panic(b"retained output adjustment requires its actual root Effect")
    }
    OutputRoot.Success {mode, environment, failure, requirements} => run Types.intern(Type.Effect {
      mode: mode, environment: move environment, success: move transformed,
      failure: move failure, requirements: move requirements})
  }
}

/// Copies metadata without opening or specializing the bound contract.
pub effect fn copy(value: &Shared<CallableSchema>) -> CallableSchema
! OutOfMemoryError ? &mut Allocator {
  let mut output = Shared<CallableSchema>.with<CallableSchema>(value, fn(schema: &CallableSchema) -> CallableSchema {
    return CallableSchema {target: Shared<DeclarationId>.clone(&schema.target),
      contract: Shared<Type>.clone(&schema.contract), output: Shared<OutputTransform>.clone(&schema.output), selected: List<Binding>.make(), deferred: List<usize>.make()}
  })
  let count = Shared<CallableSchema>.with<usize>(value, argumentCount)
  let mut at = usize.ZERO
  while at < count {
    run List<Binding>.append(&mut output.selected, Shared<CallableSchema>.with<Binding>(value,
      fn(schema: &CallableSchema) -> Binding { return bindingAt(schema, at) }))
    at = at + usize.ONE
  }
  let slots = Shared<CallableSchema>.with<usize>(value, fn(schema: &CallableSchema) -> usize {
    return List<usize>.length(&schema.deferred)
  })
  at = usize.ZERO
  while at < slots {
    run List<usize>.append(&mut output.deferred, Shared<CallableSchema>.with<usize>(value,
      fn(schema: &CallableSchema) -> usize { return List<usize>.get(&schema.deferred, at) }))
    at = at + usize.ONE
  }
  return move output
}

/// Number of free construction arguments, including any enclosing owner evidence.
pub fn argumentCount(value: &CallableSchema) -> usize { return List<Binding>.length(&value.selected) }

/// Reads one free construction argument without retaining a borrow of the schema.
pub fn argumentAt(value: &CallableSchema, at: usize) -> Argument {
  let values = List<Binding>.asSlice(&value.selected)
  return Argument.copy(&values[at].value)
}

fn bindingAt(value: &CallableSchema, at: usize) -> Binding {
  let values = List<Binding>.asSlice(&value.selected)
  return Binding {declaration: Shared<DeclarationId>.clone(&values[at].declaration),
    ordinal: values[at].ordinal, value: Argument.copy(&values[at].value)}
}

/// Stable schema identity: original target and binder positions, free selected evidence and
/// bound remaining contract. It contains no inference identity or executable dispatch pointer.
pub effect fn runtime(value: &CallableSchema) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut coordinates = RuntimeEncoding.coordinates()
  return run encoding(value, false, &mut coordinates)
}

pub effect fn encoding(value: &CallableSchema, exact: bool, coordinates: &mut Coordinates) -> Bytes
! OutOfMemoryError
? &mut Allocator {
  if coordinates.exceeded { return Bytes.make() }
  let affordable = Shared<DeclarationId>.with<bool>(&value.target,
    fn(identity: &DeclarationId) -> bool { return RuntimeEncoding.recordPayload(&mut coordinates.*, RuntimeEncoding.declarationPayload(identity)) })
  if !affordable { return Bytes.make() }
  let target = DeclarationId.copyShared(&value.target)
  let mut output = Bytes.make()
  run RuntimeEncoding.recordDeclaration(&mut output, &target, &mut coordinates.*)
  let selected = List<Binding>.asSlice(&value.selected)
  run RuntimeEncoding.recordWord(&mut output, usize.toU64(selected.length), &mut coordinates.*)
  let mut at = usize.ZERO
  while at < selected.length {
    let affordableOwner = Shared<DeclarationId>.with<bool>(&selected[at].declaration,
      fn(identity: &DeclarationId) -> bool { return RuntimeEncoding.recordPayload(&mut coordinates.*, RuntimeEncoding.declarationPayload(identity)) })
    if !affordableOwner { return Bytes.make() }
    let owner = DeclarationId.copyShared(&selected[at].declaration)
    run RuntimeEncoding.recordDeclaration(&mut output, &owner, &mut coordinates.*)
    run RuntimeEncoding.recordWord(&mut output, usize.toU64(selected[at].ordinal), &mut coordinates.*)
    let encoded = run Argument.encoding(&selected[at].value, &target, exact, &mut coordinates.*)
    run RuntimeEncoding.recordField(&mut output, Bytes.asSlice(&encoded), &mut coordinates.*)
    at = at + usize.ONE
  }
  let deferred = List<usize>.asSlice(&value.deferred)
  run RuntimeEncoding.recordWord(&mut output, usize.toU64(deferred.length), &mut coordinates.*)
  at = usize.ZERO
  while at < deferred.length {
    run RuntimeEncoding.recordWord(&mut output, usize.toU64(deferred[at]), &mut coordinates.*)
    at = at + usize.ONE
  }
  let source = run outputEncoding(&value.output, &target, exact, &mut coordinates.*)
  run RuntimeEncoding.recordField(&mut output, Bytes.asSlice(&source), &mut coordinates.*)
  let contract = run Type.encoding(&value.contract, &target, exact, &mut coordinates.*)
  run RuntimeEncoding.recordField(&mut output, Bytes.asSlice(&contract), &mut coordinates.*)
  return move output
}

// Encoding uses the same owner/coordinate budget as the bound schema. Proof distinctions
// participate in interning too; equal exposed contracts must not erase different raw maps.
pub effect fn outputEncoding(value: &Shared<OutputTransform>, owner: &DeclarationId, exact: bool, coordinates: &mut Coordinates)
  -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let count = Shared<OutputTransform>.with<usize>(value,
    fn(value: &OutputTransform) -> usize { return List<OutputBinding>.length(&value.steps) })
  let mut output = Bytes.make()
  run RuntimeEncoding.recordWord(&mut output, usize.toU64(count), &mut coordinates.*)
  let mut at = usize.ZERO
  while at < count && !coordinates.exceeded {
    let selected = Shared<OutputTransform>.with<OutputBindingKind>(value,
      fn(value: &OutputTransform) -> OutputBindingKind { return List<OutputBinding>.asSlice(&value.steps)[at].kind })
    let kind: u64 = match selected { OutputBindingKind.Applied => 0 OutputBindingKind.Representations => 1 OutputBindingKind.Invocations => 2 }
    run RuntimeEncoding.recordWord(&mut output, kind, &mut coordinates.*)
    let opening = Shared<OutputTransform>.with<Option<Shared<DeclarationId>>>(value, fn(value: &OutputTransform) -> Option<Shared<DeclarationId>> {
      return match &List<OutputBinding>.asSlice(&value.steps)[at].opening {
        Option<Shared<DeclarationId>>.Some {value: boundValue} => Option<Shared<DeclarationId>>.some(Shared<DeclarationId>.clone(&boundValue))
        _ => Option<Shared<DeclarationId>>.none()
      }
    })
    match &opening {
      Option<Shared<DeclarationId>>.None => run RuntimeEncoding.recordWord(&mut output, 0, &mut coordinates.*)
      Option<Shared<DeclarationId>>.Some {value} => {
        run RuntimeEncoding.recordWord(&mut output, 1, &mut coordinates.*)
        if !Shared<DeclarationId>.with<bool>(&value,
          fn(identity: &DeclarationId) -> bool { return RuntimeEncoding.recordPayload(&mut coordinates.*, RuntimeEncoding.declarationPayload(identity)) }) { return Bytes.make() }
        run RuntimeEncoding.recordDeclaration(&mut output, &DeclarationId.copyShared(&value), &mut coordinates.*)
      }
    }
    let length = Shared<OutputTransform>.with<usize>(value, fn(value: &OutputTransform) -> usize {
      return List<Binding>.length(&List<OutputBinding>.asSlice(&value.steps)[at].bindings)
    })
    run RuntimeEncoding.recordWord(&mut output, usize.toU64(length), &mut coordinates.*)
    let mut slot = usize.ZERO
    while slot < length && !coordinates.exceeded {
      // Copy only this shared binding after the record budget admits its entry. Do not copy
      // an arbitrarily large ordered transform before the existing encoding budget can stop.
      let binding = Shared<OutputTransform>.with<Binding>(value, fn(value: &OutputTransform) -> Binding {
        let binding = &List<Binding>.asSlice(&List<OutputBinding>.asSlice(&value.steps)[at].bindings)[slot]
        return Binding {declaration: Shared<DeclarationId>.clone(&binding.declaration), ordinal: binding.ordinal, value: Argument.copy(&binding.value)}
      })
      let affordable = Shared<DeclarationId>.with<bool>(&binding.declaration,
        fn(identity: &DeclarationId) -> bool { return RuntimeEncoding.recordPayload(&mut coordinates.*, RuntimeEncoding.declarationPayload(identity)) })
      if !affordable { return Bytes.make() }
      run RuntimeEncoding.recordDeclaration(&mut output, &DeclarationId.copyShared(&binding.declaration), &mut coordinates.*)
      run RuntimeEncoding.recordWord(&mut output, usize.toU64(binding.ordinal), &mut coordinates.*)
      let encoded = run Argument.encoding(&binding.value, owner, exact, &mut coordinates.*)
      run RuntimeEncoding.recordField(&mut output, Bytes.asSlice(&encoded), &mut coordinates.*)
      slot = slot + usize.ONE
    }
    at = at + usize.ONE
  }
  if coordinates.exceeded { return Bytes.make() }
  let root = Shared<OutputTransform>.with<OutputRoot>(value,
    fn(value: &OutputTransform) -> OutputRoot { return copyOutputRoot(&value.root) })
  match &root {
    OutputRoot.Result {environment} => {
      run RuntimeEncoding.recordWord(&mut output, 0, &mut coordinates.*)
      match &environment {
        Option<Shared<Intersection>>.None => run RuntimeEncoding.recordWord(&mut output, 0, &mut coordinates.*)
        Option<Shared<Intersection>>.Some {value: boundValue} => {
          run RuntimeEncoding.recordWord(&mut output, 1, &mut coordinates.*)
          run outputEnvironment(&mut output, &boundValue, owner, exact, &mut coordinates.*)
        }
      }
    }
    OutputRoot.Success {mode, environment, failure, requirements} => {
      run RuntimeEncoding.recordWord(&mut output, 1, &mut coordinates.*)
      let access: u64 = match mode { CallableMode.Shared => 0 CallableMode.Mutable => 1 CallableMode.Once => 2 }
      run RuntimeEncoding.recordWord(&mut output, access, &mut coordinates.*)
      run outputEnvironment(&mut output, &environment, owner, exact, &mut coordinates.*)
      let failed = run Type.encoding(&failure, owner, exact, &mut coordinates.*)
      run RuntimeEncoding.recordField(&mut output, Bytes.asSlice(&failed), &mut coordinates.*)
      let row = run Row.encoding(&requirements, owner, exact, &mut coordinates.*)
      run RuntimeEncoding.recordField(&mut output, Bytes.asSlice(&row), &mut coordinates.*)
    }
  }
  return move output
}

effect fn outputEnvironment(output: &mut Bytes, environment: &Shared<Intersection>, owner: &DeclarationId,
  exact: bool, coordinates: &mut Coordinates) -> () ! OutOfMemoryError ? &mut Allocator {
  let count = Shared<Intersection>.with<usize>(environment, fn(value: &Intersection) -> usize { return List<Member>.length(&value.members) })
  run RuntimeEncoding.recordWord(&mut output.*, usize.toU64(count), &mut coordinates.*)
  let mut at = usize.ZERO
  while at < count && !coordinates.exceeded {
    let argument = Shared<Intersection>.with<Argument>(environment, fn(value: &Intersection) -> Argument {
      return Argument.Lifetime {value: Shared<Lifetime>.clone(&List<Member>.asSlice(&value.members)[at].region)}
    })
    let encoded = run Argument.encoding(&argument, owner, exact, &mut coordinates.*)
    run RuntimeEncoding.recordField(&mut output.*, Bytes.asSlice(&encoded), &mut coordinates.*)
    at = at + usize.ONE
  }
  return ()
}
