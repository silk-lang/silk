//! Immutable callable invocation metadata. A schema becomes an ordinary application only
//! after one use supplies all remaining evidence; its environment contains only stored captures.

import semantic.DeclarationId {DeclarationId}
import semantic.RuntimeEncoding
import semantic.RuntimeEncoding {Coordinates}
import semantic.Type {Argument, Binding, Type}
import silk.allocator {Allocator, OutOfMemoryError}
import silk.bytes {Bytes}
import silk.shared {Shared}
import silk.usize
import silk.vector {Vector}

/// An anonymous callable or section's bound blueprint and free construction evidence. The contract's target
/// variables are bound by `deferred`; selected argument values are free caller evidence.
pub struct CallableSchema {
  pub target: Shared<DeclarationId>
  pub contract: Shared<Type>
  pub selected: Vector<Binding>
  pub deferred: Vector<usize>
}

/// Copies metadata without opening or specializing the bound contract.
pub effect fn copy(value: &Shared<CallableSchema>) -> CallableSchema
! OutOfMemoryError ? &mut Allocator {
  let mut output = Shared.with<CallableSchema, CallableSchema>(value, fn(schema: &CallableSchema) -> CallableSchema {
    return CallableSchema {target: Shared.clone<DeclarationId>(&schema.target),
      contract: Shared.clone<Type>(&schema.contract), selected: Vector.make<Binding>(), deferred: Vector.make<usize>()}
  })
  let count = Shared.with<CallableSchema, usize>(value, argumentCount)
  let mut at = usize.ZERO
  while at < count {
    run Vector.append<Binding>(&mut output.selected, Shared.with<CallableSchema, Binding>(value,
      fn(schema: &CallableSchema) -> Binding { return bindingAt(schema, at) }))
    at = at + usize.ONE
  }
  let slots = Shared.with<CallableSchema, usize>(value, fn(schema: &CallableSchema) -> usize {
    return Vector.length<usize>(&schema.deferred)
  })
  at = usize.ZERO
  while at < slots {
    run Vector.append<usize>(&mut output.deferred, Shared.with<CallableSchema, usize>(value,
      fn(schema: &CallableSchema) -> usize { return Vector.get<usize>(&schema.deferred, at) }))
    at = at + usize.ONE
  }
  return move output
}

/// Number of free construction arguments, including any enclosing owner evidence.
pub fn argumentCount(value: &CallableSchema) -> usize { return Vector.length<Binding>(&value.selected) }

/// Reads one free construction argument without retaining a borrow of the schema.
pub fn argumentAt(value: &CallableSchema, at: usize) -> Argument {
  let values = Vector.asSlice<Binding>(&value.selected)
  return Argument.copy(&values[at].value)
}

fn bindingAt(value: &CallableSchema, at: usize) -> Binding {
  let values = Vector.asSlice<Binding>(&value.selected)
  return Binding {declaration: Shared.clone<DeclarationId>(&values[at].declaration),
    ordinal: values[at].ordinal, value: Argument.copy(&values[at].value)}
}

/// Stable schema identity: original target and binder positions, free selected evidence and
/// bound remaining contract. It contains no inference identity or executable dispatch pointer.
pub effect fn runtime(value: &CallableSchema) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut coordinates = RuntimeEncoding.coordinates()
  return run encoding(value, false, &mut coordinates)
}

pub effect fn encoding(value: &CallableSchema, exact: bool, coordinates: &mut Coordinates) -> Bytes
! OutOfMemoryError
? &mut Allocator {
  if coordinates.exceeded { return Bytes.make() }
  let affordable = Shared.with<DeclarationId, bool>(&value.target,
    fn(identity: &DeclarationId) -> bool { return RuntimeEncoding.recordPayload(&mut coordinates.*, RuntimeEncoding.declarationPayload(identity)) })
  if !affordable { return Bytes.make() }
  let target = run DeclarationId.copyShared(&value.target)
  let mut output = Bytes.make()
  run RuntimeEncoding.recordDeclaration(&mut output, &target, &mut coordinates.*)
  let selected = Vector.asSlice<Binding>(&value.selected)
  run RuntimeEncoding.recordWord(&mut output, usize.toU64(selected.length), &mut coordinates.*)
  let mut at = usize.ZERO
  while at < selected.length {
    let affordableOwner = Shared.with<DeclarationId, bool>(&selected[at].declaration,
      fn(identity: &DeclarationId) -> bool { return RuntimeEncoding.recordPayload(&mut coordinates.*, RuntimeEncoding.declarationPayload(identity)) })
    if !affordableOwner { return Bytes.make() }
    let owner = run DeclarationId.copyShared(&selected[at].declaration)
    run RuntimeEncoding.recordDeclaration(&mut output, &owner, &mut coordinates.*)
    run RuntimeEncoding.recordWord(&mut output, usize.toU64(selected[at].ordinal), &mut coordinates.*)
    let encoded = run Argument.encoding(&selected[at].value, &target, exact, &mut coordinates.*)
    run RuntimeEncoding.recordField(&mut output, Bytes.asSlice(&encoded), &mut coordinates.*)
    at = at + usize.ONE
  }
  let deferred = Vector.asSlice<usize>(&value.deferred)
  run RuntimeEncoding.recordWord(&mut output, usize.toU64(deferred.length), &mut coordinates.*)
  at = usize.ZERO
  while at < deferred.length {
    run RuntimeEncoding.recordWord(&mut output, usize.toU64(deferred[at]), &mut coordinates.*)
    at = at + usize.ONE
  }
  let contract = run Type.encoding(&value.contract, &target, exact, &mut coordinates.*)
  run RuntimeEncoding.recordField(&mut output, Bytes.asSlice(&contract), &mut coordinates.*)
  return move output
}
