//! Where a typed body would have to run cleanup that the backend does not lower yet.
//!
//! # When to use
//! Use [`site`] before lowering a body to MIR. Until drops are lowered (Step 6), a body that must
//! clean up an owned value is reported as the `cleanup` gap rather than silently leaking it.
//!
//! This walk is a stopgap with one caller, `resolveMir`. Step 6c's MIR cleanup stack replaces it;
//! delete this module then, and build nothing else on it.

import lexer.Span {Span}
import semantic.TypedBody {
  Expression as BodyExpression,
  AggregateField as BodyAggregateField,
  MatchArm as BodyMatchArm,
  NodeId as BodyNodeId,
  NodeKind as BodyNodeKind,
  TypedBody,
}
import silk.allocator {Allocator, OutOfMemoryError}
import silk.option {Option}
import silk.shared {Shared}
import silk.usize
import silk.vector {Vector}

// What an owned local holds on the current path.
enum Ownership {
  Dead,
  Live,
  Moved,
}


// One shallow, owned view of a typed node; children are read by position.
union Step {
  Bind {local: usize, initializer: BodyNodeId},
  Assign {local: usize, value: BodyNodeId},
  PlaceAssign {target: BodyNodeId, value: BodyNodeId},
  Return {value: Option<BodyNodeId>},
  Branch {condition: BodyNodeId, thenBranch: BodyNodeId, elseBranch: Option<BodyNodeId>},
  Loop {condition: BodyNodeId, body: BodyNodeId},
  Break,
  Continue,
  Block {canComplete: bool},
  Local {local: usize},
  Move {value: BodyNodeId},
  Project {value: BodyNodeId},
  Match {subject: BodyNodeId, place: bool},
  Operands,
}

struct Walk {
  needs: Vector<bool>
  states: Vector<Ownership>
  // Owned locals in lexical order; a block or loop scope is a suffix of it.
  scope: Vector<usize>
  loops: Vector<usize>
  found: Option<Span>
}

/// The first place a body would need to run cleanup, if any.
///
/// # Details
///
/// `localNeeds` and `nodeNeeds` say which locals and node values need cleanup. An owned local is
/// live from its binding (a parameter from entry) until it is moved on every path. A return, break,
/// continue, or block end that leaves a live local in scope, a discarded temporary, an assignment
/// over a live value, a partial move, and an owned match subject (whose unbound remainder must be
/// cleaned) each need cleanup.
pub effect fn site(body: &Shared<TypedBody>, localNeeds: &[bool], nodeNeeds: &[bool]) -> Option<Span>
! OutOfMemoryError
? &mut Allocator {
  let mut bound = Vector.make<bool>()
  while Vector.length<bool>(&bound) < localNeeds.length { run Vector.append<bool>(&mut bound, false) }
  let mut node = usize.ZERO
  while node < nodeNeeds.length {
    let local = bindingLocal(body, node)
    if local < localNeeds.length {
      let mut marks = Vector.asMutSlice<bool>(&mut bound)
      marks[local] = true
    }
    node = node + usize.ONE
  }
  let mut walk = Walk {
    needs: Vector.make<bool>(), states: Vector.make<Ownership>(), scope: Vector.make<usize>(),
    loops: Vector.make<usize>(), found: Option.none<Span>(),
  }
  let boundSlice = Vector.asSlice<bool>(&bound)
  let mut at = usize.ZERO
  while at < localNeeds.length {
    run Vector.append<bool>(&mut walk.needs, localNeeds[at])
    // A parameter owns its argument from entry; every other local becomes live at its binding.
    if localNeeds[at] && !boundSlice[at] {
      run Vector.append<Ownership>(&mut walk.states, Ownership.Live)
      run Vector.append<usize>(&mut walk.scope, at)
    } else {
      run Vector.append<Ownership>(&mut walk.states, Ownership.Dead)
    }
    at = at + usize.ONE
  }
  let root = rootOf(body)
  let completes = run statement(&mut walk, body, nodeNeeds, root)
  if completes { run leave(&mut walk, usize.ZERO, spanOf(body, root)) }
  return move walk.found
}

effect fn statement(walk: &mut Walk, body: &Shared<TypedBody>, nodeNeeds: &[bool], id: BodyNodeId) -> bool
! OutOfMemoryError
? &mut Allocator {
  if found(&walk.*) { return false }
  match move step(body, id) {
    Step.Bind {local, initializer} => {
      drop run expression(&mut walk.*, body, nodeNeeds, initializer)
      if needed(&walk.*, local) {
        setState(&mut walk.*, local, Ownership.Live)
        run Vector.append<usize>(&mut walk.scope, local)
      }
      return true
    }
    Step.Assign {local, value} => {
      drop run expression(&mut walk.*, body, nodeNeeds, value)
      if stateOf(&walk.*, local) == Ownership.Live { walk.found = Option.some<Span>(spanOf(body, id)) }
      if needed(&walk.*, local) { setState(&mut walk.*, local, Ownership.Live) }
      return true
    }
    Step.PlaceAssign {target, value} => {
      drop run expression(&mut walk.*, body, nodeNeeds, value)
      drop run expression(&mut walk.*, body, nodeNeeds, target)
      if nodeNeeds[target.index] { walk.found = Option.some<Span>(spanOf(body, id)) }
      return true
    }
    Step.Return {value} => {
      if let Option<BodyNodeId>.Some {value: returned} = move value {
        drop run expression(&mut walk.*, body, nodeNeeds, returned)
      }
      run leave(&mut walk.*, usize.ZERO, spanOf(body, id))
      return false
    }
    Step.Break => {
      let from = innermostLoop(&walk.*)
      run leave(&mut walk.*, from, spanOf(body, id))
      return false
    }
    Step.Continue => {
      let from = innermostLoop(&walk.*)
      run leave(&mut walk.*, from, spanOf(body, id))
      return false
    }
    Step.Branch {condition, thenBranch, elseBranch} => {
      drop run expression(&mut walk.*, body, nodeNeeds, condition)
      let before = run copyStates(&walk.states)
      let thenCompletes = run statement(&mut walk.*, body, nodeNeeds, thenBranch)
      let afterThen = run copyStates(&walk.states)
      walk.states = move before
      let mut elseCompletes = true
      if let Option<BodyNodeId>.Some {value: otherwise} = move elseBranch {
        elseCompletes = run statement(&mut walk.*, body, nodeNeeds, otherwise)
      }
      if thenCompletes && elseCompletes {
        joinInto(&mut walk.states, Vector.asSlice<Ownership>(&afterThen))
      } else if thenCompletes {
        walk.states = move afterThen
      }
      return thenCompletes || elseCompletes
    }
    Step.Loop {condition, body: repeated} => {
      drop run expression(&mut walk.*, body, nodeNeeds, condition)
      let before = run copyStates(&walk.states)
      run Vector.append<usize>(&mut walk.loops, Vector.length<usize>(&walk.scope))
      drop run statement(&mut walk.*, body, nodeNeeds, repeated)
      drop Vector.pop<usize>(&mut walk.loops)
      // The body may run zero times.
      joinInto(&mut walk.states, Vector.asSlice<Ownership>(&before))
      return true
    }
    Step.Block {canComplete} => {
      let mark = Vector.length<usize>(&walk.scope)
      let mut completes = true
      let mut at = usize.ZERO
      while completes && !found(&walk.*) {
        let child = match move childOf(body, id, at) {
          Option<BodyNodeId>.Some {value} => value
          Option<BodyNodeId>.None => { break }
        }
        completes = run statement(&mut walk.*, body, nodeNeeds, child)
        at = at + usize.ONE
      }
      completes = completes && canComplete
      if completes { run leave(&mut walk.*, mark, spanOf(body, id)) }
      while Vector.length<usize>(&walk.scope) > mark {
        let local = match move Vector.pop<usize>(&mut walk.scope) {
          Option<usize>.Some {value} => value
          Option<usize>.None => { break }
        }
        setState(&mut walk.*, local, Ownership.Dead)
      }
      return completes
    }
    _ => {
      // An expression statement discards its value.
      let completes = run expression(&mut walk.*, body, nodeNeeds, id)
      if completes && nodeNeeds[id.index] { walk.found = Option.some<Span>(spanOf(body, id)) }
      return completes
    }
  }
}

effect fn expression(walk: &mut Walk, body: &Shared<TypedBody>, nodeNeeds: &[bool], id: BodyNodeId) -> bool
! OutOfMemoryError
? &mut Allocator {
  if found(&walk.*) { return false }
  match move step(body, id) {
    Step.Local {..} => { return true }
    Step.Move {value} => {
      if let Step.Local {local} = move step(body, value) {
        if needed(&walk.*, local) { setState(&mut walk.*, local, Ownership.Moved) }
        return true
      }
      // Moving part of an owner leaves a remainder that must be cleaned.
      let root = projectedLocal(body, value)
      if root != usize.MAX && needed(&walk.*, root) {
        walk.found = Option.some<Span>(spanOf(body, id))
        return false
      }
      return run expression(&mut walk.*, body, nodeNeeds, value)
    }
    Step.Match {subject, place} => {
      drop run expression(&mut walk.*, body, nodeNeeds, subject)
      // An owned subject's unbound remainder must be cleaned after the selected arm.
      if !place && nodeNeeds[subject.index] {
        walk.found = Option.some<Span>(spanOf(body, id))
        return false
      }
      let before = run copyStates(&walk.states)
      let mut joined = run copyStates(&walk.states)
      let mut anyCompletes = false
      let mut at = usize.ZERO
      while !found(&walk.*) {
        let arm = match move armOf(body, id, at) {
          Option<ArmNodes>.Some {value} => value
          Option<ArmNodes>.None => { break }
        }
        walk.states = run copyStates(&before)
        if let Option<BodyNodeId>.Some {value: guard} = move arm.guard {
          drop run expression(&mut walk.*, body, nodeNeeds, guard)
        }
        let mut completes = true
        if let Step.Block {..} = move step(body, arm.result) {
          completes = run statement(&mut walk.*, body, nodeNeeds, arm.result)
        } else {
          completes = run expression(&mut walk.*, body, nodeNeeds, arm.result)
        }
        if completes && !anyCompletes {
          joined = run copyStates(&walk.states)
          anyCompletes = true
        } else if completes {
          joinInto(&mut joined, Vector.asSlice<Ownership>(&walk.states))
        }
        at = at + usize.ONE
      }
      walk.states = move joined
      return anyCompletes
    }
    _ => {
      // A borrow, projection or operator only reads its operands, so an owned temporary operand
      // dies at the end of the statement; calls and constructors take ownership of theirs.
      let consumes = consumesOperands(body, id)
      let mut at = usize.ZERO
      while !found(&walk.*) {
        let child = match move childOf(body, id, at) {
          Option<BodyNodeId>.Some {value} => value
          Option<BodyNodeId>.None => { break }
        }
        drop run expression(&mut walk.*, body, nodeNeeds, child)
        if !found(&walk.*) && !consumes && nodeNeeds[child.index] && !placeRooted(body, child) {
          walk.found = Option.some<Span>(spanOf(body, child))
        }
        at = at + usize.ONE
      }
      return !found(&walk.*)
    }
  }
}

// Reports a live owned local declared at or after scope position `from`.
effect fn leave(walk: &mut Walk, from: usize, span: Span) -> () ! OutOfMemoryError ? &mut Allocator {
  if found(&walk.*) { return () }
  let scope = Vector.asSlice<usize>(&walk.scope)
  let mut at = from
  while at < scope.length {
    if stateOf(&walk.*, scope[at]) == Ownership.Live {
      walk.found = Option.some<Span>(span)
      return ()
    }
    at = at + usize.ONE
  }
  return ()
}

fn found(walk: &Walk) -> bool {
  return match &walk.found {
    Option<Span>.Some {..} => true
    Option<Span>.None => false
  }
}

fn needed(walk: &Walk, local: usize) -> bool {
  let needs = Vector.asSlice<bool>(&walk.needs)
  return local < needs.length && needs[local]
}

fn stateOf(walk: &Walk, local: usize) -> Ownership {
  let states = Vector.asSlice<Ownership>(&walk.states)
  if local < states.length { return states[local] }
  return Ownership.Dead
}

fn setState(walk: &mut Walk, local: usize, state: Ownership) -> () {
  let mut states = Vector.asMutSlice<Ownership>(&mut walk.states)
  if local < states.length { states[local] = state }
  return ()
}

fn innermostLoop(walk: &Walk) -> usize {
  let loops = Vector.asSlice<usize>(&walk.loops)
  if loops.length == usize.ZERO { return usize.ZERO }
  return loops[loops.length - usize.ONE]
}

effect fn copyStates(states: &Vector<Ownership>) -> Vector<Ownership> ! OutOfMemoryError ? &mut Allocator {
  let mut copied = Vector.make<Ownership>()
  let listed = Vector.asSlice<Ownership>(states)
  let mut at = usize.ZERO
  while at < listed.length {
    run Vector.append<Ownership>(&mut copied, listed[at])
    at = at + usize.ONE
  }
  return move copied
}

// A value needs cleanup at a join when any incoming path still owns it.
fn joinInto(states: &mut Vector<Ownership>, other: &[Ownership]) -> () {
  let mut merged = Vector.asMutSlice<Ownership>(&mut states.*)
  let mut at = usize.ZERO
  while at < merged.length && at < other.length {
    if merged[at] == Ownership.Live || other[at] == Ownership.Live {
      merged[at] = Ownership.Live
    } else if merged[at] == Ownership.Moved || other[at] == Ownership.Moved {
      merged[at] = Ownership.Moved
    }
    at = at + usize.ONE
  }
  return ()
}

fn rootOf(body: &Shared<TypedBody>) -> BodyNodeId {
  return Shared.with<TypedBody, BodyNodeId>(body, fn(value: &TypedBody) -> BodyNodeId {
    return TypedBody.rootNode(value)
  })
}

fn spanOf(body: &Shared<TypedBody>, id: BodyNodeId) -> Span {
  return Shared.with<TypedBody, Span>(body, fn(value: &TypedBody) -> Span {
    let nodes = TypedBody.nodeSlice(value)
    return nodes[id.index].origin.span
  })
}

// The local a binding statement at node `index` introduces, or MAX.
fn bindingLocal(body: &Shared<TypedBody>, index: usize) -> usize {
  return Shared.with<TypedBody, usize>(body, fn(value: &TypedBody) -> usize {
    let nodes = TypedBody.nodeSlice(value)
    return match &nodes[index].kind {
      BodyNodeKind.LocalBinding {local, ..} => local.index
      BodyNodeKind.MutableBinding {local, ..} => local.index
      _ => usize.MAX
    }
  })
}

fn consumesOperands(body: &Shared<TypedBody>, id: BodyNodeId) -> bool {
  return Shared.with<TypedBody, bool>(body, fn(value: &TypedBody) -> bool {
    let nodes = TypedBody.nodeSlice(value)
    return match &nodes[id.index].kind {
      BodyNodeKind.Expression {form, ..} => match &form {
        BodyExpression.Aggregate {..} => true
        BodyExpression.VariantConstruct {..} => true
        BodyExpression.UnionInject {..} => true
        BodyExpression.EnumValue {..} => true
        BodyExpression.DirectCall {..} => true
        BodyExpression.ForeignCall {..} => true
        BodyExpression.IntrinsicCall {..} => true
        BodyExpression.InterfaceCall {..} => true
        _ => false
      }
      _ => false
    }
  })
}

// Whether a node names existing storage (a local, a pattern binding or a dereference, possibly
// projected) rather than a temporary the expression created.
fn placeRooted(body: &Shared<TypedBody>, id: BodyNodeId) -> bool {
  let mut current = id
  while true {
    let next = Shared.with<TypedBody, usize>(body, fn(value: &TypedBody) -> usize {
      let nodes = TypedBody.nodeSlice(value)
      return match &nodes[current.index].kind {
        BodyNodeKind.Expression {form: BodyExpression.Field {value: projected, ..}, ..} => projected.index
        BodyNodeKind.Expression {form: BodyExpression.Index {value: projected, ..}, ..} => projected.index
        BodyNodeKind.Expression {form: BodyExpression.Local {..}, ..} => usize.MAX
        BodyNodeKind.Expression {form: BodyExpression.PatternBinding {..}, ..} => usize.MAX
        BodyNodeKind.Expression {form: BodyExpression.Dereference {..}, ..} => usize.MAX
        _ => usize.MAX - usize.ONE
      }
    })
    if next == usize.MAX { return true }
    if next == usize.MAX - usize.ONE { return false }
    current = BodyNodeId {index: next}
  }
  return false
}

// The local a field or index projection chain starts from, or MAX.
fn projectedLocal(body: &Shared<TypedBody>, id: BodyNodeId) -> usize {
  let mut current = id
  while true {
    match move step(body, current) {
      Step.Local {local} => { return local }
      Step.Project {value} => { current = value }
      _ => { return usize.MAX }
    }
  }
  return usize.MAX
}

fn step(body: &Shared<TypedBody>, id: BodyNodeId) -> Step {
  return Shared.with<TypedBody, Step>(body, fn(value: &TypedBody) -> Step {
    let nodes = TypedBody.nodeSlice(value)
    return match &nodes[id.index].kind {
      BodyNodeKind.LocalBinding {local, initializer} => Step.Bind {local: local.index, initializer: initializer}
      BodyNodeKind.MutableBinding {local, initializer} => Step.Bind {local: local.index, initializer: initializer}
      BodyNodeKind.Assignment {local, value: assigned} => Step.Assign {local: local.index, value: assigned}
      BodyNodeKind.PlaceAssignment {target, value: assigned} => Step.PlaceAssign {target: target, value: assigned}
      BodyNodeKind.Return {value: returned} => match &returned {
        Option<BodyNodeId>.Some {value: result} => Step.Return {value: Option.some<BodyNodeId>(result)}
        Option<BodyNodeId>.None => Step.Return {value: Option.none<BodyNodeId>()}
      }
      BodyNodeKind.Branch {condition, thenBranch, elseBranch, ..} => match &elseBranch {
        Option<BodyNodeId>.Some {value: otherwise} => Step.Branch {condition: condition, thenBranch: thenBranch, elseBranch: Option.some<BodyNodeId>(otherwise)}
        Option<BodyNodeId>.None => Step.Branch {condition: condition, thenBranch: thenBranch, elseBranch: Option.none<BodyNodeId>()}
      }
      BodyNodeKind.While {condition, body: repeated} => Step.Loop {condition: condition, body: repeated}
      BodyNodeKind.Break => Step.Break
      BodyNodeKind.Continue => Step.Continue
      BodyNodeKind.Block {canComplete, ..} => Step.Block {canComplete: canComplete}
      BodyNodeKind.Expression {form: BodyExpression.Local {local}, ..} => Step.Local {local: local.index}
      BodyNodeKind.Expression {form: BodyExpression.Move {value: moved}, ..} => Step.Move {value: moved}
      BodyNodeKind.Expression {form: BodyExpression.Field {value: projected, ..}, ..} => Step.Project {value: projected}
      BodyNodeKind.Expression {form: BodyExpression.Index {value: projected, ..}, ..} => Step.Project {value: projected}
      BodyNodeKind.Expression {form: BodyExpression.Match {subject, place, ..}, ..} => Step.Match {subject: subject, place: place}
      _ => Step.Operands
    }
  })
}

// The operand at `at` of an expression in evaluation order, or a block's statement.
fn childOf(body: &Shared<TypedBody>, id: BodyNodeId, at: usize) -> Option<BodyNodeId> {
  return Shared.with<TypedBody, Option<BodyNodeId>>(body, fn(value: &TypedBody) -> Option<BodyNodeId> {
    let nodes = TypedBody.nodeSlice(value)
    return match &nodes[id.index].kind {
      BodyNodeKind.Block {statements, ..} => nodeAt(Vector.asSlice<BodyNodeId>(&statements), at)
      BodyNodeKind.Expression {form, ..} => match &form {
        BodyExpression.Borrow {value: operand, ..} => single(operand, at)
        BodyExpression.PointerAccessWeaken {value: operand} => single(operand, at)
        BodyExpression.Dereference {value: operand} => single(operand, at)
        BodyExpression.Field {value: operand, ..} => single(operand, at)
        BodyExpression.ArraySlice {value: operand, ..} => single(operand, at)
        BodyExpression.SliceLength {value: operand} => single(operand, at)
        BodyExpression.ArrayLength {value: operand, ..} => single(operand, at)
        BodyExpression.EnumValue {value: operand} => single(operand, at)
        BodyExpression.UnionInject {value: operand, ..} => single(operand, at)
        BodyExpression.Move {value: operand} => single(operand, at)
        BodyExpression.ConcretePrefix {operand, ..} => single(operand, at)
        BodyExpression.Index {value: operand, index} => pair(operand, index, at)
        BodyExpression.ConcreteInfix {left, right, ..} => pair(left, right, at)
        BodyExpression.Aggregate {fields} => fieldAt(Vector.asSlice<BodyAggregateField>(&fields), at)
        BodyExpression.VariantConstruct {fields, ..} => fieldAt(Vector.asSlice<BodyAggregateField>(&fields), at)
        BodyExpression.DirectCall {arguments, ..} => nodeAt(Vector.asSlice<BodyNodeId>(&arguments), at)
        BodyExpression.ForeignCall {arguments, ..} => nodeAt(Vector.asSlice<BodyNodeId>(&arguments), at)
        BodyExpression.IntrinsicCall {arguments, ..} => nodeAt(Vector.asSlice<BodyNodeId>(&arguments), at)
        BodyExpression.InterfaceCall {arguments, ..} => nodeAt(Vector.asSlice<BodyNodeId>(&arguments), at)
        _ => Option.none<BodyNodeId>()
      }
      _ => Option.none<BodyNodeId>()
    }
  })
}

struct ArmNodes {
  guard: Option<BodyNodeId>
  result: BodyNodeId
}

fn armOf(body: &Shared<TypedBody>, id: BodyNodeId, at: usize) -> Option<ArmNodes> {
  return Shared.with<TypedBody, Option<ArmNodes>>(body, fn(value: &TypedBody) -> Option<ArmNodes> {
    let nodes = TypedBody.nodeSlice(value)
    if let BodyNodeKind.Expression {form: BodyExpression.Match {arms, ..}, ..} = &nodes[id.index].kind {
      let listed = Vector.asSlice<BodyMatchArm>(&arms)
      if at < listed.length {
        let mut guard = Option.none<BodyNodeId>()
        if let Option<BodyNodeId>.Some {value: tested} = &listed[at].guard { guard = Option.some<BodyNodeId>(tested) }
        return Option.some<ArmNodes>(ArmNodes {guard: move guard, result: listed[at].result})
      }
    }
    return Option.none<ArmNodes>()
  })
}

fn single(only: BodyNodeId, at: usize) -> Option<BodyNodeId> {
  if at == usize.ZERO { return Option.some<BodyNodeId>(only) }
  return Option.none<BodyNodeId>()
}

fn pair(first: BodyNodeId, second: BodyNodeId, at: usize) -> Option<BodyNodeId> {
  if at == usize.ZERO { return Option.some<BodyNodeId>(first) }
  if at == usize.ONE { return Option.some<BodyNodeId>(second) }
  return Option.none<BodyNodeId>()
}

fn nodeAt(listed: &[BodyNodeId], at: usize) -> Option<BodyNodeId> {
  if at < listed.length { return Option.some<BodyNodeId>(listed[at]) }
  return Option.none<BodyNodeId>()
}

fn fieldAt(listed: &[BodyAggregateField], at: usize) -> Option<BodyNodeId> {
  if at < listed.length { return Option.some<BodyNodeId>(listed[at].value) }
  return Option.none<BodyNodeId>()
}
