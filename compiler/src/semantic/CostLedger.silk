//! What each call in the built package asked the compiler to generate, for `silk build --costs`.
//!
//! A build walk lowers every function instance the program reaches once. A [`Ledger`] charges each
//! one to the authored call in the root package that led to it: the call itself when the callee is
//! the package's own function, or the call that first left the package when the instance belongs
//! to the standard library or a dependency, however deep below that call the walk reached it. A
//! site's cost is then the functions charged to it, their LLVM text, and the static evaluation
//! steps that ran while they were lowered. These are counts of the program, so two builds of the
//! same sources charge the same numbers to the same calls. The time each site's lowering took is
//! kept beside them for the report only, since it changes from run to run.
//!
//! A static evaluation answer is computed once per process, so the steps a body's evaluation took
//! are remembered by instance ([`Ledger.lowered`]): a later walk of the same build, such as the
//! frame walk of a program that suspends, charges them again to its sites.

import backend.InstanceKey {InstanceKey}
import lexer.Span {Span}
import semantic.InternIndex {InternIndex}
import silk.collections.hash {Hash}
import semantic.ModuleId {ModuleId}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.collections.bytes {Bytes}
import silk.collections.list {List}
import silk.num.usize

/// One authored call and what the functions charged to it cost.
pub struct Site {
  pub module: ModuleId,
  pub span: Span,
  /// The function instances charged to the call.
  pub functions: usize,
  /// The bytes of LLVM text those instances emitted.
  pub bytes: usize,
  /// The static evaluation steps that ran while they were lowered.
  pub steps: usize,
  /// The time their lowering took, which only the report shows.
  pub nanos: u64,
}

/// The sites of one build walk, and the totals of every instance it lowered.
pub struct Ledger {
  /// Whether the walk charges its instances; off, every operation returns at once.
  pub enabled: bool,
  /// Modules of the root package, whose calls are charged; with none, no call is.
  pub root: List<ModuleId>,
  sites: List<Site>,
  lookup: InternIndex,
  /// Every function instance the walk lowered, charged to a site or not.
  pub functions: usize,
  pub bytes: usize,
  pub steps: usize,
  /// The static evaluation steps the whole process ran, in checks and in every walk.
  pub processSteps: usize,
  // The steps each instance's lowering ran, across walks.
  keys: List<InstanceKey>,
  keyLookup: InternIndex,
  keySteps: List<usize>,
}

impl Ledger {
  /// A ledger that charges nothing.
  pub fn off() -> Ledger {
    return Ledger {
      enabled: false,
      root: List<ModuleId>.make(),
      sites: List<Site>.make(),
      lookup: InternIndex.make(),
      functions: usize.ZERO,
      bytes: usize.ZERO,
      steps: usize.ZERO,
      processSteps: usize.ZERO,
      keys: List<InstanceKey>.make(),
      keyLookup: InternIndex.make(),
      keySteps: List<usize>.make(),
    }
  }

  /// Starts a build walk: the sites of an earlier walk of the same build are dropped, since this
  /// walk reaches its instances again.
  pub fn restart(self: &mut Ledger) -> () {
    self.sites = List<Site>.make()
    self.lookup = InternIndex.make()
    self.functions = usize.ZERO
    self.bytes = usize.ZERO
    self.steps = usize.ZERO
  }

  /// Whether `module` belongs to the root package, whose calls are charged.
  pub fn inRoot(self: &Ledger, module: &ModuleId) -> bool {
    let roots = List<ModuleId>.asSlice(&self.root)
    let mut at = usize.ZERO
    while at < roots.length {
      if ModuleId.samePackage(&roots[at], module) { return true }
      at = at + usize.ONE
    }
    return false
  }

  /// Counts one static evaluation step of the process.
  pub fn step(self: &mut Ledger) -> () {
    self.processSteps = self.processSteps + usize.ONE
  }

  /// The steps an instance's lowering ran: `fresh` this time, plus what an earlier walk's lowering
  /// of the same instance ran, which this one found answered.
  pub effect fn lowered(self: &mut Ledger, instance: &InstanceKey, fresh: usize) -> usize ! OutOfMemoryError ? &mut Allocator {
    let hash = InstanceKey.runtimeHash(instance)
    let keys = List<InstanceKey>.asSlice(&self.keys)
    let mut at = InternIndex.first(&self.keyLookup, hash)
    while at != usize.MAX {
      if run InstanceKey.sameApplication(&keys[at], instance) {
        let total = List<usize>.get(&self.keySteps, at) + fresh
        List<usize>.set(&mut self.keySteps, at, total)
        return total
      }
      at = InternIndex.after(&self.keyLookup, at)
    }
    run List<InstanceKey>.append(&mut self.keys, InstanceKey.copy(instance))
    run InternIndex.record(&mut self.keyLookup, hash)
    run List<usize>.append(&mut self.keySteps, fresh)
    return fresh
  }

  /// Charges one lowered instance to the call at `span` of `module`, or to no call when `charged`
  /// is false; either way it counts toward the walk's totals.
  pub effect fn charge(self: &mut Ledger, charged: bool, module: &ModuleId, span: Span, bytes: usize, steps: usize, nanos: u64) -> ()
  ! OutOfMemoryError ? &mut Allocator {
    self.functions = self.functions + usize.ONE
    self.bytes = self.bytes + bytes
    self.steps = self.steps + steps
    if !charged { return () }
    let hash = Hash.combine(Hash.combine(ModuleId.hash(module), usize.toU64(span.start)), usize.toU64(span.end))
    let sites = List<Site>.asMutSlice(&mut self.sites)
    let mut at = InternIndex.first(&self.lookup, hash)
    while at != usize.MAX {
      if sites[at].span.start == span.start && sites[at].span.end == span.end && ModuleId.equals(&sites[at].module, module) {
        sites[at].functions = sites[at].functions + usize.ONE
        sites[at].bytes = sites[at].bytes + bytes
        sites[at].steps = sites[at].steps + steps
        sites[at].nanos = sites[at].nanos + nanos
        return ()
      }
      at = InternIndex.after(&self.lookup, at)
    }
    run List<Site>.append(&mut self.sites, Site {module: ModuleId.copy(module), span: span, functions: usize.ONE, bytes: bytes,
      steps: steps, nanos: nanos})
    run InternIndex.record(&mut self.lookup, hash)
  }

  /// The charged sites, in the order the walk first charged them.
  pub fn charged(self: &Ledger) -> &[Site] {
    return List<Site>.asSlice(&self.sites)
  }

  /// The places in [`charged`] of the `limit` costliest sites, costliest first: most LLVM text, then
  /// most functions, then most steps, then the one charged first. Time never decides the order.
  pub effect fn costliest(self: &Ledger, limit: usize) -> List<usize> ! OutOfMemoryError ? &mut Allocator {
    let sites = List<Site>.asSlice(&self.sites)
    let mut taken = run List<bool>.makeWithCapacity(sites.length)
    run List<bool>.appendRepeated(&mut taken, false, sites.length)
    let mut order = List<usize>.make()
    while List<usize>.length(&order) < limit {
      let mut best = usize.MAX
      let mut at = usize.ZERO
      while at < sites.length {
        if !List<bool>.get(&taken, at) && (best == usize.MAX || costlier(&sites[at], &sites[best])) { best = at }
        at = at + usize.ONE
      }
      if best == usize.MAX { break }
      List<bool>.set(&mut taken, best, true)
      run List<usize>.append(&mut order, best)
    }
    return move order
  }
}

// Whether `left` costs strictly more than `right` by the report's deterministic order.
fn costlier(left: &Site, right: &Site) -> bool {
  if left.bytes != right.bytes { return left.bytes > right.bytes }
  if left.functions != right.functions { return left.functions > right.functions }
  return left.steps > right.steps
}

/// Appends `bytes` as `512 B`, `48.2 KB` or `2.1 MB`, in powers of 1,000.
pub effect fn appendSize(out: &mut Bytes, bytes: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  if bytes < 1000 {
    run appendDecimal(&mut out.*, bytes)
    return run Bytes.append(&mut out.*, b" B")
  }
  let mut unit: &[u8] = b" KB"
  let mut tenths = usize.divide(bytes, 100)
  if bytes >= 1000000 {
    unit = b" MB"
    tenths = usize.divide(bytes, 100000)
  }
  run appendDecimal(&mut out.*, usize.divide(tenths, 10))
  run Bytes.append(&mut out.*, b".")
  run appendDecimal(&mut out.*, usize.remainder(tenths, 10))
  return run Bytes.append(&mut out.*, unit)
}

/// Appends `value` in decimal, without separators.
pub effect fn appendDecimal(out: &mut Bytes, value: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  if value >= 10 { run appendDecimal(&mut out.*, usize.divide(value, 10)) }
  let digit: u8 = usize.toU8(usize.remainder(value, 10)) + 48
  return run Bytes.append(&mut out.*, &[digit])
}

/// Appends `cell` right-aligned in `width` columns, counting each byte that does not continue a
/// UTF-8 character as one column.
pub effect fn appendPadded(out: &mut Bytes, cell: &[u8], width: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut columns = usize.ZERO
  let mut at = usize.ZERO
  while at < cell.length {
    if cell[at] < 128 || cell[at] >= 192 { columns = columns + usize.ONE }
    at = at + usize.ONE
  }
  while columns < width {
    run Bytes.append(&mut out.*, b" ")
    columns = columns + usize.ONE
  }
  return run Bytes.append(&mut out.*, cell)
}
