//! The four ordinary Silk functions selected by the trace-directive capability.
import semantic.ExecutionStorage { Binding }
import silk.mem.allocator { Allocator, OutOfMemoryError }

/// The entry, success, failure and cancellation hooks of a resolved capability.
pub struct TraceDirective {
  /// Opens a span and returns its guard.
  pub enter: Binding,
  /// Closes a completed span while consuming its guard.
  pub exit: Binding,
  /// Marks the escaping failure before the span closes.
  pub failed: Binding,
  /// Closes a suspended activation whose execution was dropped.
  pub cancelled: Binding,
}

impl TraceDirective {
  pub effect fn copy(self: &Self) -> Self ! OutOfMemoryError ? &mut Allocator {
    return TraceDirective {
      enter: run self.enter.copy(),
      exit: run self.exit.copy(),
      failed: run self.failed.copy(),
      cancelled: run self.cancelled.copy(),
    }
  }
}
