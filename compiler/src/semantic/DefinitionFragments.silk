//! Portable definitions returned by a worker after the program's observation and frame modes close.
//! Local MIR, type handles and query ordinals remain in the producing worker.
import backend.EmissionPlan {Replayed}
import backend.InstanceText {InstanceText}
import backend.LlvmCode {Declaration}
import semantic.DeclarationId {DeclarationId}
import semantic.BuildRecord
import semantic.InternIndex {InternIndex}
import semantic.RuntimeEncoding as Encoding
import semantic.StableKey
import silk.collections.bytes {Bytes}
import silk.collections.list {List}
import silk.core.option {Option}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.num.usize

pub struct Entry {
  pub identity: Replayed,
  pub definition: InstanceText,
}

/// Starts a worker packet bound to the coordinator's source, target, profile and closed-mode digest.
pub effect fn begin(context: &[u8], count: usize) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut output = Bytes.make()
  run Encoding.word(&mut output, 1)
  run Encoding.field(&mut output, context)
  run Encoding.word(&mut output, usize.toU64(count))
  return move output
}

/// Appends one stable identity and its immutable definition; `text` may be a slice of a held pack.
pub effect fn append(output: &mut Bytes, identity: &Replayed, definition: &InstanceText, text: &[u8]) -> ()
! OutOfMemoryError ? &mut Allocator {
  run Encoding.field(&mut output.*, Bytes.asSlice(&identity.exact))
  run Encoding.word(&mut output.*, identity.hash)
  run StableKey.declaration(&mut output.*, &identity.declaration)
  run Encoding.word(&mut output.*, identity.family)
  let metadata = run BuildRecord.encodeDefinition(definition)
  run Encoding.field(&mut output.*, Bytes.asSlice(&metadata))
  return run Encoding.field(&mut output.*, text)
}

/// Reads a complete packet for `context`, rejecting malformed identities and conflicting definitions.
pub effect fn read(bytes: &[u8], context: &[u8]) -> Option<List<Entry>> ! OutOfMemoryError ? &mut Allocator {
  let mut reader = StableKey.reader()
  if StableKey.readWord(bytes, &mut reader) != 1 { return Option<List<Entry>>.none() }
  let recorded = StableKey.readField(bytes, &mut reader)
  if !same(StableKey.view(bytes, recorded), context) { return Option<List<Entry>>.none() }
  let count = StableKey.readWord(bytes, &mut reader)
  if StableKey.failed(&reader) || count > usize.toU64(bytes.length) { return Option<List<Entry>>.none() }
  let mut entries = List<Entry>.make()
  let mut at: u64 = 0
  while at < count {
    let exact = StableKey.readField(bytes, &mut reader)
    let hash = StableKey.readWord(bytes, &mut reader)
    let declaration = match move run StableKey.readDeclaration(bytes, &mut reader) {
      Option<DeclarationId>.Some {value} => move value
      Option<DeclarationId>.None => { return Option<List<Entry>>.none() }
    }
    let family = StableKey.readWord(bytes, &mut reader)
    let metadata = StableKey.readField(bytes, &mut reader)
    let text = StableKey.readField(bytes, &mut reader)
    if StableKey.failed(&reader) || family > 4 || exact.end - exact.start != 16 { return Option<List<Entry>>.none() }
    let mut definition = match move run BuildRecord.decodeDefinition(StableKey.view(bytes, metadata)) {
      Option<InstanceText>.Some {value} => move value
      Option<InstanceText>.None => { return Option<List<Entry>>.none() }
    }
    definition.text = run Bytes.copy(StableKey.view(bytes, text))
    run List<Entry>.append(&mut entries, Entry {identity: Replayed {exact: run Bytes.copy(StableKey.view(bytes, exact)),
      hash: hash, declaration: move declaration, family: family}, definition: move definition})
    at = at + 1
  }
  if !StableKey.finished(bytes, &reader) || !run valid(List<Entry>.asSlice(&entries)) { return Option<List<Entry>>.none() }
  return Option<List<Entry>>.some(move entries)
}

/// Checks a union of worker results before LLVM's first-definition-wins global merge.
/// Equal canonical encodings must agree on symbol, fragment and foreign contracts; different
/// encodings cannot define one symbol. Exact application aliases and borrow statuses may differ.
pub effect fn valid(entries: &[Entry]) -> bool ! OutOfMemoryError ? &mut Allocator {
  let mut encodings = InternIndex.make()
  let mut symbols = InternIndex.make()
  let mut at = usize.ZERO
  while at < entries.length {
    let definition = &entries[at].definition
    let encoding = Bytes.asSlice(&definition.encoding)
    let symbol = Bytes.asSlice(&definition.symbol)
    if encoding.length != 16 || symbol.length == usize.ZERO { return false }
    let encodingHash = InternIndex.hashBytes(0, encoding)
    let symbolHash = InternIndex.hashBytes(0, symbol)
    let mut prior = InternIndex.first(&encodings, encodingHash)
    while prior != usize.MAX {
      let previous = &entries[prior].definition
      if same(Bytes.asSlice(&previous.encoding), encoding) && !sameDefinition(previous, definition) { return false }
      prior = InternIndex.after(&encodings, prior)
    }
    prior = InternIndex.first(&symbols, symbolHash)
    while prior != usize.MAX {
      let previous = &entries[prior].definition
      if same(Bytes.asSlice(&previous.symbol), symbol) && !same(Bytes.asSlice(&previous.encoding), encoding) { return false }
      prior = InternIndex.after(&symbols, prior)
    }
    run InternIndex.record(&mut encodings, encodingHash)
    run InternIndex.record(&mut symbols, symbolHash)
    at = at + usize.ONE
  }
  return true
}

fn sameDefinition(first: &InstanceText, second: &InstanceText) -> bool {
  if !same(Bytes.asSlice(&first.symbol), Bytes.asSlice(&second.symbol))
    || !same(Bytes.asSlice(&first.text), Bytes.asSlice(&second.text)) { return false }
  let left = List<Declaration>.asSlice(&first.foreign)
  let right = List<Declaration>.asSlice(&second.foreign)
  if left.length != right.length { return false }
  let mut at = usize.ZERO
  while at < left.length {
    if !same(Bytes.asSlice(&left[at].symbol), Bytes.asSlice(&right[at].symbol))
      || !same(Bytes.asSlice(&left[at].contract), Bytes.asSlice(&right[at].contract))
      || !same(Bytes.asSlice(&left[at].text), Bytes.asSlice(&right[at].text)) { return false }
    at = at + usize.ONE
  }
  return true
}

fn same(first: &[u8], second: &[u8]) -> bool {
  if first.length != second.length { return false }
  let mut at = usize.ZERO
  while at < first.length {
    if first[at] != second[at] { return false }
    at = at + usize.ONE
  }
  return true
}
