//! Metadata-only retention preserves exact root authority without self-retaining dead placements.
import CompilerBug
import semantic.CacheRetain as Retain {Retained}
import semantic.CacheGeneration as Generation {Generation as GenerationData, Selection, Placement, LeafHandle, Certificate, Requirements}
import semantic.CacheSegments as Segments {Descriptor, SealedSegment, Observation, Node, Edge, Reference, Root}
import semantic.CacheView as CacheView {View}
import semantic.ContentHash {ContentHash}
import semantic.RuntimeEncoding
import silk.collections.bytes {Bytes}
import silk.collections.list {List}
import silk.core.option {Option}
import silk.core.effect {Effect}
import silk.mem.frozen {Frozen}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.testing.testing {Testing, AssertionError}
import silk.num.usize
import silk.num.u64

struct Fixture {generation: GenerationData, owners: List<Frozen<SealedSegment>>}

effect fn owner(serial: u64, firstKey: &[u8], secondKey: &[u8], parent: usize, parents: &[Frozen<SealedSegment>])
-> Frozen<SealedSegment> ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut builder = run Segments.make(serial, b"retain-test")
  if parent != usize.MAX { run List<Descriptor>.append(&mut builder.imports, Segments.descriptor(Frozen<SealedSegment>.get(&parents[parent]))) }
  run List<Observation>.append(&mut builder.leaves, Observation {key: run Bytes.copy(b"file"), digest: ContentHash {high: 0, low: serial},
    text: ContentHash.of(b""), position: usize.MAX, file: Option<Reference>.none(), selector: 0, input: false})
  let mut at = usize.ZERO
  while at < 2 {
    run List<Observation>.append(&mut builder.leaves, Observation {key: run Bytes.copy(b"body"), digest: ContentHash.of(b"same-input"),
      text: ContentHash.of(b"same-text"), position: u64.toUsize(serial) + at,
      file: Option<Reference>.some(Reference {segment: 0, index: 0}), selector: 1, input: true})
    at = at + usize.ONE
  }
  let mut edges = List<Edge>.make()
  run List<Edge>.append(&mut edges, Edge {node: false, target: Reference {segment: 0, index: 1}})
  run List<Node>.append(&mut builder.nodes, Node {edges: move edges})
  run List<Root>.append(&mut builder.roots, Root {key: run Bytes.copy(firstKey), node: Reference {segment: 0, index: 0}, answer: run Bytes.copy(b"first"), packs: List<ContentHash>.make()})
  run List<Root>.append(&mut builder.roots, Root {key: run Bytes.copy(secondKey), node: Reference {segment: 0, index: 0}, answer: run Bytes.copy(b"second"), packs: List<ContentHash>.make()})
  return match move run Segments.seal(move builder, parents) {
    Option<SealedSegment>.Some {value} => run Frozen<SealedSegment>.make(move value)
    Option<SealedSegment>.None => { run Testing.expect(false, "retention fixture segment seals") return CompilerBug.panic(b"bad retention fixture") }
  }
}
effect fn append(owners: &mut List<Frozen<SealedSegment>>, serial: u64, firstKey: &[u8], secondKey: &[u8], parent: usize) -> ()
! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fresh = run owner(serial, firstKey, secondKey, parent, List<Frozen<SealedSegment>>.asSlice(&owners.*))
  run List<Frozen<SealedSegment>>.append(&mut owners.*, move fresh)
}
effect fn fixture(owners: List<Frozen<SealedSegment>>) -> Fixture ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut catalog = List<Descriptor>.make()
  let mut selections = List<Selection>.make()
  let held = List<Frozen<SealedSegment>>.asSlice(&owners)
  let mut at = usize.ZERO
  while at < held.length {
    let descriptor = Segments.descriptor(Frozen<SealedSegment>.get(&held[at]))
    run List<Descriptor>.append(&mut catalog, descriptor)
    run List<Selection>.append(&mut selections, Selection {segment: descriptor.digest, roots: run Bytes.copy(&[0])})
    at = at + usize.ONE
  }
  return Fixture {generation: GenerationData {stamp: run Bytes.copy(b"retain-test"), catalog: move catalog, selections: move selections,
    placements: List<Placement>.make(), certificate: Option<Certificate>.none()}, owners: move owners}
}
fn select(value: &mut Fixture, ownerIndex: usize, root: usize) -> bool {
  let descriptor = List<Descriptor>.get(&value.generation.catalog, ownerIndex)
  let entries = List<Selection>.asMutSlice(&mut value.generation.selections)
  return Generation.setSelected(&mut entries[ownerIndex], &descriptor, root, true)
}
fn leaf(value: &Fixture, ownerIndex: usize, index: usize) -> LeafHandle {
  return LeafHandle {segment: List<Descriptor>.get(&value.generation.catalog, ownerIndex).digest, index: index}
}
effect fn placement(value: &mut Fixture, sourceOwner: usize, sourceIndex: usize, targetOwner: usize, targetIndex: usize) -> ()
! OutOfMemoryError ? &mut Allocator {
  let source = leaf(&value.*, sourceOwner, sourceIndex)
  let target = leaf(&value.*, targetOwner, targetIndex)
  run List<Placement>.append(&mut value.generation.placements, Placement {source: source, target: target})
}
effect fn trimmed(value: Fixture) -> Retained ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  return match move run Retain.trim(move value.generation, move value.owners) {
    Option<Retained>.Some {value: kept} => move kept
    Option<Retained>.None => { run Testing.expect(false, "valid metadata closure trims") return CompilerBug.panic(b"trim unexpectedly refused") }
  }
}
effect fn admitted(value: Retained, key: &[u8], missing: &[u8]) -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let view = match move run CacheView.make(move value.generation, move value.owners) {
    Option<View>.Some {value: held} => move held
    Option<View>.None => { run Testing.expect(false, "trimmed generation passes full view admission") return () }
  }
  run Testing.expect(CacheView.rootCount(&view) == 1, "one selected root remains authoritative")
  match move CacheView.findRoot(&view, key) {
    Option<usize>.Some {value: index} => {
      match move CacheView.rootAnswer(&view, index) {
        Option<&[u8]>.Some {value: answer} => { run Testing.expect(RuntimeEncoding.equals(answer, b"second"), "selected root keeps its original exact answer") }
        _ => { run Testing.expect(false, "selected answer remains available") }
      }
    }
    _ => { run Testing.expect(false, "selected exact key survives") }
  }
  match move CacheView.findRoot(&view, missing) { Option<usize>.None => {} _ => { run Testing.expect(false, "retained physical root is not implicitly selected") } }
}
effect fn importsClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut owners = List<Frozen<SealedSegment>>.make()
  run append(&mut owners, 1, b"ancestor0", b"ancestor1", usize.MAX)
  run append(&mut owners, 2, b"middle0", b"middle1", 0)
  run append(&mut owners, 3, b"selected0", b"selected1", 1)
  run append(&mut owners, 4, b"dead0", b"dead1", usize.MAX)
  let mut value = run fixture(move owners)
  run Testing.expect(select(&mut value, 2, 1), "select only fresh root bit one")
  let kept = run trimmed(move value)
  run Testing.expect(kept.stats.beforeSegments == 4 && kept.stats.afterSegments == 3, "selected owner retains transitive imported ancestors but removes unrelated dead owner")
  run Testing.expect(List<Selection>.length(&kept.generation.selections) == 1, "empty selection maps disappear even for retained ancestors")
  run admitted(move kept, b"selected1", b"selected0")
}
effect fn placementClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut owners = List<Frozen<SealedSegment>>.make()
  run append(&mut owners, 1, b"import0", b"import1", usize.MAX)
  run append(&mut owners, 2, b"live0", b"live1", usize.MAX)
  run append(&mut owners, 3, b"target0", b"target1", 0)
  run append(&mut owners, 4, b"dead-left0", b"dead-left1", usize.MAX)
  run append(&mut owners, 5, b"dead-right0", b"dead-right1", usize.MAX)
  let mut value = run fixture(move owners)
  run Testing.expect(select(&mut value, 1, 1), "live source root selected")
  run placement(&mut value, 1, 1, 2, 2)
  // A segment-level cycle uses different source/target leaves, so no forbidden leaf chain
  // exists. Without a selected owner this cycle must not manufacture its own liveness.
  run placement(&mut value, 3, 1, 4, 2)
  run placement(&mut value, 4, 1, 3, 2)
  match move run Generation.admit(&value.generation, List<Frozen<SealedSegment>>.asSlice(&value.owners)) {
    Option<Requirements>.Some {..} => {}
    _ => { run Testing.expect(false, "distinct-leaf placement cycle is structurally and semantically admissible") }
  }
  let kept = run trimmed(move value)
  run Testing.expect(kept.stats.beforeSegments == 5 && kept.stats.afterSegments == 3, "live placement pulls target and target import, dead cycle pulls neither owner")
  run Testing.expect(List<Placement>.length(&kept.generation.placements) == 1, "dead-source placement records cannot self-retain")
  run admitted(move kept, b"live1", b"target1")
}
effect fn certificateClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut mode = usize.ZERO
  while mode < 3 {
    let mut owners = List<Frozen<SealedSegment>>.make()
    run append(&mut owners, 1, b"anchor0", b"anchor1", usize.MAX)
    run append(&mut owners, 2, b"certified0", b"certified1", usize.MAX)
    let mut value = run fixture(move owners)
    run Testing.expect(select(&mut value, 1, 1), "certificate root selected")
    let mut exact = List<Selection>.make()
    let mut positioned = List<Selection>.make()
    let anchorDescriptor = List<Descriptor>.get(&value.generation.catalog, 0)
    let rootDescriptor = List<Descriptor>.get(&value.generation.catalog, 1)
    let activeBits: [u8; 1] = [2]
    let emptyBits: [u8; 1] = [0]
    run List<Selection>.append(&mut exact, Selection {segment: anchorDescriptor.digest, roots: run Bytes.copy(&emptyBits)})
    run List<Selection>.append(&mut exact, Selection {segment: rootDescriptor.digest, roots: run Bytes.copy(if mode == 1 { &activeBits } else { &emptyBits })})
    run List<Selection>.append(&mut positioned, Selection {segment: rootDescriptor.digest, roots: run Bytes.copy(if mode == 2 { &activeBits } else { &emptyBits })})
    let mut anchors = List<LeafHandle>.make()
    run List<LeafHandle>.append(&mut anchors, leaf(&value, 0, 0))
    value.generation.certificate = Option<Certificate>.some(Certificate {context: run Bytes.copy(b"exact-context"), exact: move exact, positionOnly: move positioned, anchors: move anchors})
    let kept = run trimmed(move value)
    run Testing.expect(kept.stats.afterSegments == (if mode == 0 { usize.ONE } else { usize.ONE + usize.ONE }), "anchors retain owners only for a nonempty certified root")
    match &kept.generation.certificate {
      Option<Certificate>.None => { run Testing.expect(mode == 0, "an empty certificate is removed") }
      Option<Certificate>.Some {value: proof} => {
        run Testing.expect(mode != 0 && List<LeafHandle>.length(&proof.anchors) == 1, "live certificate retains its anchor")
        run Testing.expect(List<Selection>.length(&proof.exact) == (if mode == 1 { usize.ONE } else { usize.ZERO })
          && List<Selection>.length(&proof.positionOnly) == (if mode == 2 { usize.ONE } else { usize.ZERO }), "empty certificate maps are removed without upgrading position-only roots")
      }
    }
    run admitted(move kept, b"certified1", b"anchor1")
    mode = mode + usize.ONE
  }
}
effect fn malformedClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut mode = usize.ZERO
  while mode < 3 {
    let mut owners = List<Frozen<SealedSegment>>.make()
    run append(&mut owners, 1, b"parent0", b"parent1", usize.MAX)
    run append(&mut owners, 2, b"child0", b"child1", 0)
    let mut value = run fixture(move owners)
    if mode == 0 {
      let catalog = List<Descriptor>.asMutSlice(&mut value.generation.catalog)
      catalog[1].nodes = catalog[1].nodes + usize.ONE
    } else if mode == 1 {
      drop List<Descriptor>.remove(&mut value.generation.catalog, 0)
      drop List<Selection>.remove(&mut value.generation.selections, 0)
      drop List<Frozen<SealedSegment>>.remove(&mut value.owners, 0)
    } else {
      let replacement = run owner(2, b"wrong0", b"wrong1", usize.MAX, &[])
      List<Frozen<SealedSegment>>.set(&mut value.owners, 1, move replacement)
    }
    run Testing.expect(Generation.validShape(&value.generation), "malformed ownership fixture retains a valid metadata shape")
    match move run Retain.trim(move value.generation, move value.owners) {
      Option<Retained>.None => {}
      _ => { run Testing.expect(false, "mismatched descriptor, missing import or substituted owner refuses even when all roots are dead") }
    }
    mode = mode + usize.ONE
  }
}

test effect fn cacheRetainKeepsSelectedImportsAndExactRootBits() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run importsClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}
test effect fn cacheRetainFollowsLivePlacementsWithoutRevivingDeadCycles() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run placementClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}
test effect fn cacheRetainPinsOnlyNonemptyCertificateAnchors() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run certificateClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}
test effect fn cacheRetainRefusesBrokenDeadOwnerMetadata() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run malformedClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}
