//! The member decision shared by every `Without<source, removed>` subtraction: requirement-row
//! keys (SERV-008) and failure-union members (FAIL-005) are both removed, kept, or deferred by it.

/// How one source member relates to one removed member.
pub enum Relation {
  /// Both name the same member; the source member is removed.
  Same,
  /// No substitution can make them equal; the source member survives this removed member.
  Distinct,
  /// A parameter on either side keeps the answer open.
  Open,
}

/// What subtraction does with one source member.
pub enum Fate {
  /// A removed member names it.
  Removed,
  /// Every removed member is decided distinct from it.
  Kept,
  /// Some removed member may still name it once a parameter is known.
  Deferred,
}

/// The fate of a source member before any removed member is compared. While the removed set
/// itself still has a parameter, any member may later be removed.
pub fn start(removedOpen: bool) -> Fate {
  if removedOpen { return Fate.Deferred }
  return Fate.Kept
}

/// Folds one more removed member's relation into a source member's fate. A match removes the
/// member for good; an open relation defers a member that is not already removed.
pub fn decide(fate: Fate, relation: Relation) -> Fate {
  if fate == Fate.Removed || relation == Relation.Same { return Fate.Removed }
  if relation == Relation.Open { return Fate.Deferred }
  return fate
}
