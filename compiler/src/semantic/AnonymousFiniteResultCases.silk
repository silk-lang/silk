import semantic.ModuleId {InvalidModulePath}
import semantic.Query {Cycle}
import semantic.Semantic {Semantic, Request, Answer}
import semantic.SemanticCaseSupport {module, staticSemantic, hasBorrowStatus, rejectsSpan, checkedBody, bodyIsFullyChecked, ownDiagnosticCount, reportsSpanAt}
import semantic.Rejection {RejectionCode}
import semantic.SourceIndex {RevisionMismatch, NoRejection}
import semantic.Target {Target, Id as TargetId}
import semantic.TypedBody {TypedBody, BorrowStatus, NodeKind, Expression}
import semantic.Types {TypeTable, Types}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.core.effect {Effect}
import silk.testing.testing {Testing, AssertionError}
import silk.mem.shared {Shared}
import silk.core.result {Result}
import silk.core.option {Option}
import silk.num.usize

// Inspect the published, environment-rebased bodies, including recursively nested literals.
// A successful outer demand alone does not prove a callable stored inside it.
fn checkedLiteralCount(body: &TypedBody) -> usize {
  if !bodyIsFullyChecked(body) { return usize.MAX }
  let nodes = TypedBody.nodeSlice(body)
  let mut count = usize.ZERO
  let mut at = usize.ZERO
  while at < nodes.length {
    if let NodeKind.Expression {form: Expression.Callable {body: literal, ..}, ..} = &nodes[at].kind {
      let nested = Shared<TypedBody>.with<usize>(&literal, checkedLiteralCount)
      if nested == usize.MAX { return usize.MAX }
      count = count + usize.ONE + nested
    }
    at = at + usize.ONE
  }
  return count
}
fn checkedLiterals(answer: &Shared<Result<Answer, NoRejection>>, count: usize) -> bool {
  let body = Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(answer, checkedBody)
  if let Option<Shared<TypedBody>>.Some {value} = move body {
    return Shared<TypedBody>.with<usize>(&value, checkedLiteralCount) == count
  }
  return false
}
fn literalChecked(answer: &Shared<Result<Answer, NoRejection>>) -> bool {
  let body = Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(answer, checkedBody)
  if let Option<Shared<TypedBody>>.Some {value} = move body {
    return Shared<TypedBody>.with<bool>(&value, fn(typed: &TypedBody) -> bool {
      let nodes = TypedBody.nodeSlice(typed)
      let mut at = usize.ZERO
      while at < nodes.length {
        if let NodeKind.Expression {form: Expression.Callable {body: literal, ..}, ..} = &nodes[at].kind {
          return Shared<TypedBody>.with<BorrowStatus>(&literal, TypedBody.borrowStatus) == BorrowStatus.Checked
        }
        at = at + usize.ONE
      }
      return false
    })
  }
  return false
}

test effect fn anonymousResultCallsNeedCompleteProof() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut types = TypeTable.make()
  return run anonymousResultClaims() |> Effect.provideMut<Types>(&mut types) |> Effect.provideMut<Allocator>(&mut allocator)
}
effect fn anonymousResultClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("anonymous-result-calls.silk")
  let text = """
struct Token { value: i32 }
interface Both { fn both<'w, 'v: 'w>(self: &Self, a: &'v i32, b: &'v i32) -> &'w i32 }
impl Both for Token { fn both<'w, 'v: 'w>(self: &Self, a: &'v i32, b: &'v i32) -> &'w i32 { return b } }
fn bothDirect<'w, 'v: 'w>(self: &Token, a: &'v i32, b: &'v i32) -> &'w i32 { return b }
fn makeDirect<'w, 'v: 'w>(self: &Token, head: &'v i32) -> &'w i32 { return head }
fn apply<'a>(t: &'a Token, h: &'a i32, f: fn(&'a Token, &'a i32) -> &'a i32) -> &'a i32 { return f(t, h) }
fn constrain<'a, 'x: 'a>(anchor: &'a i32, left: &'x i32, right: &'x i32) -> i32 { return anchor.* }
fn wr2lDirect<'a>(t: &'a Token, h: &'a i32) -> &'a i32 { return apply(t, h, fn(x: &'a Token, y: &'a i32) -> &'a i32 { let l = 5 let r = bothDirect(x, y, &l) return y }) }
fn wr2lInterface<'a>(t: &'a Token, h: &'a i32) -> &'a i32 { return apply(t, h, fn(x: &'a Token, y: &'a i32) -> &'a i32 { let l = 5 let r = Both.both(x, y, &l) return y }) }
fn nested<'a>(t: &'a Token, h: &'a i32) -> &'a i32 {
  return apply(t, h, fn(x: &'a Token, y: &'a i32) -> &'a i32 {
    return apply(x, y, fn(xx: &'a Token, yy: &'a i32) -> &'a i32 {
      let l = 5 let r = bothDirect(xx, yy, &l) return yy
    })
  })
}
fn capturedCaller<'p>(t: &Token, h: &'p i32) -> i32 {
  let g = fn() -> i32 { let l = 5 let r = bothDirect(t, h, &l) return r.* }
  return g()
}
fn callerEscape<'a>(t: &'a Token, h: &'a i32) -> &'a i32 {
  return apply(t, h, fn(x: &'a Token, y: &'a i32) -> &'a i32 { let l = 5 return bothDirect(x, y, &l) })
}
fn staticEscape(t: &Token) -> &'static i32 {
  let g = fn(x: &Token) -> &'static i32 { let l = 5 return makeDirect(x, &l) }
  return g(t)
}
fn capturedStatic<'p>(t: &Token, h: &'p i32) -> &'static i32 {
  let g = fn() -> &'static i32 { return makeDirect(t, h) }
  return g()
}
fn nestedEscape<'a>(t: &'a Token, h: &'a i32) -> &'a i32 {
  return apply(t, h, fn(x: &'a Token, y: &'a i32) -> &'a i32 {
    return apply(x, y, fn(xx: &'a Token, yy: &'a i32) -> &'a i32 { let l = 5 return bothDirect(xx, yy, &l) })
  })
}
fn pendingPlain<'p>(h: &'p i32) -> i32 {
  let g = fn(y: &'p i32) -> i32 { let l = 5 return constrain(y, &y.*, &l) }
  return g(h)
}
fn pendingShortened<'p>(t: &Token, h: &'p i32) -> i32 {
  let g = fn(x: &Token, y: &'p i32) -> i32 {
    let l = 5 let r = bothDirect(x, y, &l)
    let n = constrain(y, &y.*, &l)
    return r.* + n
  }
  return g(t, h)
}
fn copiedCapture<'p>(t: &Token, h: &'p i32) -> i32 {
  let g = fn() -> i32 { let l = 6 let r = bothDirect(t, h, &l) return r.* }
  let copy = g
  return g() + copy()
}
fn spent(value: Token) -> () { return () }
fn movedCapture<'p>(h: &'p i32) -> i32 {
  let capturedOwner = Token { value: 1 }
  let g = fn() -> i32 { let l = 7 let r = bothDirect(&capturedOwner, h, &l) return r.* }
  spent(move capturedOwner)
  return g()
}
fn declaredEffect<'p>(t: &'p Token, h: &'p i32) -> i32 {
  let pending: Effect<'p; i32> = effect {
    let g = fn() -> i32 { let l = 8 let r = bothDirect(t, h, &l) return r.* }
    return g()
  }
  return run pending
}
fn derivedEffect<'p>(t: &'p Token, h: &'p i32) -> i32 {
  let pending = effect {
    let g = fn() -> i32 { let l = 9 let r = bothDirect(t, h, &l) return r.* }
    return g()
  }
  return run pending
}
struct First {}
struct Second {}
effect fn joinedEffect<'p>(t: &'p Token, h: &'p i32, flag: bool, other: bool) -> i32 ! First | Second {
  let pending = effect {
    let g = fn() -> i32 { let l = 10 let r = bothDirect(t, h, &l) return r.* }
    if flag { fail First {} }
    if other { fail Second {} }
    return g()
  }
  return run pending
}
fn declaredPending<'p>(t: &'p Token, h: &'p i32) -> i32 {
  let pending: Effect<'p; i32> = effect {
    let g = fn() -> i32 {
      let l = 11 let r = bothDirect(t, h, &l)
      let n = constrain(h, &h.*, &l)
      return r.* + n
    }
    return g()
  }
  return run pending
}
effect fn joinedPending<'p>(t: &'p Token, h: &'p i32, flag: bool, other: bool) -> i32 ! First | Second {
  let pending = effect {
    let g = fn() -> i32 {
      let l = 12 let r = bothDirect(t, h, &l)
      let n = constrain(h, &h.*, &l)
      return r.* + n
    }
    if flag { fail First {} }
    if other { fail Second {} }
    return g()
  }
  return run pending
}
fn multiplePending<'p>(t: &Token, h: &'p i32) -> i32 {
  let g = fn(x: &Token, y: &'p i32) -> i32 {
    let l = 13 let r = bothDirect(x, y, &l)
    let m = 14 let s = bothDirect(x, y, &m)
    let n = constrain(y, &y.*, &l)
    return r.* + s.* + n
  }
  return g(t, h)
}

fn failedBinding(t: &Token, h: &i32) -> i32 {
  let bad: i32 = true
  let g = fn() -> i32 { let l = 15 let r = bothDirect(t, h, &l) return bad }
  return g()
}
struct Pair<'b, 'a: 'b> { short: &'b i32, long: &'a i32 }
fn viaPair<'a, 'b>(x: &'a i32, p: &Pair<'b, 'a>) -> &'b i32 { return x }
fn impliedOuter<'a, 'b>(t: &Token, x: &'a i32, p: &Pair<'b, 'a>) -> i32 {
  let g = fn() -> i32 {
    let l = 16 let r = bothDirect(t, x, &l)
    let got = viaPair(x, p)
    return got.* + r.*
  }
  return g()
}

"""
  let mut store = run staticSemantic(&id, text, Target.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let wr2lDirect = run Semantic.demandBody(&mut store, &mut request, &id, b"wr2lDirect")
  let wr2lInterface = run Semantic.demandBody(&mut store, &mut request, &id, b"wr2lInterface")
  let nested = run Semantic.demandBody(&mut store, &mut request, &id, b"nested")
  let capturedCaller = run Semantic.demandBody(&mut store, &mut request, &id, b"capturedCaller")
  let callerEscape = run Semantic.demandBody(&mut store, &mut request, &id, b"callerEscape")
  let staticEscape = run Semantic.demandBody(&mut store, &mut request, &id, b"staticEscape")
  let capturedStatic = run Semantic.demandBody(&mut store, &mut request, &id, b"capturedStatic")
  let nestedEscape = run Semantic.demandBody(&mut store, &mut request, &id, b"nestedEscape")
  let pendingPlain = run Semantic.demandBody(&mut store, &mut request, &id, b"pendingPlain")
  let pendingShortened = run Semantic.demandBody(&mut store, &mut request, &id, b"pendingShortened")
  let copiedCapture = run Semantic.demandBody(&mut store, &mut request, &id, b"copiedCapture")
  let movedCapture = run Semantic.demandBody(&mut store, &mut request, &id, b"movedCapture")
  let declaredEffect = run Semantic.demandBody(&mut store, &mut request, &id, b"declaredEffect")
  let derivedEffect = run Semantic.demandBody(&mut store, &mut request, &id, b"derivedEffect")
  let joinedEffect = run Semantic.demandBody(&mut store, &mut request, &id, b"joinedEffect")
  let declaredPending = run Semantic.demandBody(&mut store, &mut request, &id, b"declaredPending")
  let joinedPending = run Semantic.demandBody(&mut store, &mut request, &id, b"joinedPending")
  let multiplePending = run Semantic.demandBody(&mut store, &mut request, &id, b"multiplePending")
  let failedBinding = run Semantic.demandBody(&mut store, &mut request, &id, b"failedBinding")
  let impliedOuter = run Semantic.demandBody(&mut store, &mut request, &id, b"impliedOuter")
  let apply = run Semantic.demandBody(&mut store, &mut request, &id, b"apply")
  run Testing.expect(checkedLiterals(&apply, 0)
      && checkedLiterals(&wr2lDirect, 1) && checkedLiterals(&wr2lInterface, 1),
    "the complete apply helper and both result-only callback bodies prove all their regions before publication")
  run Testing.expect(checkedLiterals(&nested, 2),
    "each nested callback is FullyChecked after its environment is materialized")
  run Testing.expect(checkedLiterals(&capturedCaller, 1) && checkedLiterals(&copiedCapture, 1),
    "captured caller references support only the finite scalar use, including through a copied closure")
  run Testing.expect(rejectsSpan(&movedCapture, RejectionCode.AccessDuringLoan, text, "capturedOwner", 2),
    "a shortened call does not permit moving a captured owner before the closure's last use")
  run Testing.expect(rejectsSpan(&callerEscape, RejectionCode.UnsatisfiedLifetimeBound, text, "&l", 4)
      && rejectsSpan(&staticEscape, RejectionCode.UnsatisfiedLifetimeBound, text, "&l", 5)
      && rejectsSpan(&capturedStatic, RejectionCode.UnsatisfiedLifetimeBound, text, "makeDirect(t, h)", 0)
      && rejectsSpan(&nestedEscape, RejectionCode.UnsatisfiedLifetimeBound, text, "&l", 6),
    "anonymous, captured and nested calls retain their caller and static escape obligations at the original source sites")
  run Testing.expect(hasBorrowStatus(&pendingPlain, BorrowStatus.Checked) && literalChecked(&pendingPlain),
    "a constrain call's binders are fresh regions that shorten to the local borrow, so the enclosing body and its literal are Checked")
  run Testing.expect(hasBorrowStatus(&pendingShortened, BorrowStatus.Checked) && literalChecked(&pendingShortened),
    "the same constrain relation beside a shortened result-only call is Checked in the literal and its enclosing body")
  run Testing.expect(checkedLiterals(&declaredEffect, 2) && checkedLiterals(&derivedEffect, 2)
      && checkedLiterals(&joinedEffect, 2),
    "declared, derived and joined-channel rechecked Effects publish only completely proved nested callables")
  run Testing.expect(hasBorrowStatus(&declaredPending, BorrowStatus.Checked) && hasBorrowStatus(&joinedPending, BorrowStatus.Checked),
    "declared and joined-channel Effects around a shortened callable with a constrain relation are Checked")
  run Testing.expect(hasBorrowStatus(&multiplePending, BorrowStatus.Checked),
    "each of several shortened call sites in one literal takes fresh call regions, so the body is Checked")
  run Testing.expect(ownDiagnosticCount(&failedBinding) == 1
      && reportsSpanAt(&failedBinding, 0, RejectionCode.AssignmentTypeMismatch, text, "true", 0),
    "an anonymous frame still sees an enclosing failed binding and does not report cascading errors")
  run Testing.expect(checkedLiterals(&impliedOuter, 1),
    "anonymous shortening preserves the enclosing signature's implied premises")
  return ()
}
