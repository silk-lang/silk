//! Certificate scope follows current semantic source membership rather than parsing history.

import semantic.CacheScope
import semantic.ContentHash {ContentHash}
import semantic.ModuleId {InvalidModulePath, ModuleId}
import semantic.RuntimeEncoding
import semantic.SourceRevision {Observation, Revision}
import silk.collections.bytes {Bytes}
import silk.collections.list {List}
import silk.core.effect {Effect}
import silk.core.option {Option}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.testing.testing {AssertionError, Testing}

test effect fn cacheScopeUsesImmutablePresentRosterAndExactRequestContext() -> ()
! OutOfMemoryError | InvalidModulePath | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run claims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn claims() -> () ! OutOfMemoryError | InvalidModulePath | AssertionError<'static> ? &mut Allocator {
  let app = run ModuleId.make(b"file", b"package", b"app.silk")
  let library = run ModuleId.make(b"file", b"package", b"library.silk")
  let absent = run ModuleId.make(b"file", b"package", b"absent.silk")
  let original = Option<Bytes>.some(run Bytes.copy(b"original"))
  let other = Option<Bytes>.some(run Bytes.copy(b"library"))
  let mut first = run Revision.publish(&Revision.make(), &app, &original)
  first = run Revision.publish(&first, &library, &other)
  let mut second = run Revision.publish(&Revision.make(), &library, &other)
  second = run Revision.publish(&second, &app, &original)
  second = run Revision.publish(&second, &absent, &Option<Bytes>.none())
  let before = run Revision.presentObservations(&first)
  let reordered = run Revision.presentObservations(&second)
  run Testing.expect(List<Observation>.length(&before) == 2 && List<Observation>.length(&reordered) == 2,
    "explicit absent mappings do not become present source-roster members")
  let firstScope = run CacheScope.context(b"app", b"report", b"profile", &[], List<Observation>.asSlice(&before))
  let secondScope = run CacheScope.context(b"app", b"report", b"profile", &[], List<Observation>.asSlice(&reordered))
  run Testing.expect(RuntimeEncoding.equals(Bytes.asSlice(&firstScope), Bytes.asSlice(&secondScope)),
    "publication order and negative lookup history do not change semantic scope")
  let edited = run Revision.publish(&second, &app, &Option<Bytes>.some(run Bytes.copy(b"edited")))
  let current = run Revision.presentObservations(&edited)
  let editedScope = run CacheScope.context(b"app", b"report", b"profile", &[], List<Observation>.asSlice(&current))
  run Testing.expect(RuntimeEncoding.equals(Bytes.asSlice(&firstScope), Bytes.asSlice(&editedScope)),
    "source content is checked by anchors rather than conflated with source membership")
  let held = &List<Observation>.asSlice(&before)[0]
  match move Observation.contentDigest(held) {
    Option<ContentHash>.Some {value} => { run Testing.expect(ContentHash.equals(value, ContentHash.of(b"original")),
      "retained snapshot still observes old bytes after a later revision") }
    _ => { run Testing.expect(false, "present observation has its content digest") }
  }
  let removed = run Revision.publish(&edited, &library, &Option<Bytes>.none())
  let remaining = run Revision.presentObservations(&removed)
  let removedScope = run CacheScope.context(b"app", b"report", b"profile", &[], List<Observation>.asSlice(&remaining))
  let switchedScope = run CacheScope.context(b"different-app", b"report", b"profile", &[], List<Observation>.asSlice(&before))
  let registeredScope = run CacheScope.context(b"app", b"report", b"profile", &[ModuleId.copy(&app)], List<Observation>.asSlice(&before))
  run Testing.expect(!RuntimeEncoding.equals(Bytes.asSlice(&firstScope), Bytes.asSlice(&removedScope))
    && !RuntimeEncoding.equals(Bytes.asSlice(&firstScope), Bytes.asSlice(&switchedScope))
    && !RuntimeEncoding.equals(Bytes.asSlice(&firstScope), Bytes.asSlice(&registeredScope)),
    "removed modules, changed applications and schema registrations invalidate scope")
}
