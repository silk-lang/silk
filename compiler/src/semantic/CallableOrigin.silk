//! Canonical returned environments behind ordinary authored callable result contracts.

import semantic.CallableWitness
import semantic.CallableWitness {CallableWitness as WitnessRecipe}
import semantic.ReturnFlow
import semantic.Specialization {Application, ScopeBinding}
import semantic.DeclarationId {DeclarationId}
import semantic.Lifetime {Lifetime}
import semantic.Type {Argument, Binding, ComparisonChild, Row, RowParameter, Type}
import semantic.TypedBody {TypedBody, NodeKind, NodeId}
import silk.allocator {Allocator, OutOfMemoryError}
import silk.option {Option}
import silk.shared {Shared}
import silk.usize
import silk.vector {Vector}

/// Substitutes only reachable return operands. Resolver-backed normalization of deferred
/// invocation results is separate from physical storage projection and from unrelated body nodes.
pub effect fn inputs(body: &Shared<TypedBody>, bindings: &[Binding]) -> Option<Vector<Shared<Type>>>
! OutOfMemoryError ? &mut Allocator {
  let reached = run ReturnFlow.collect(body)
  let nodes = Vector<NodeId>.asSlice(&reached)
  let mut output = Vector<Shared<Type>>.make()
  let mut at = usize.ZERO
  while at < nodes.length {
    let source = Shared<TypedBody>.with<Option<Shared<Type>>>(body,
      fn(value: &TypedBody) -> Option<Shared<Type>> { return operandType(value, nodes[at]) })
    let value = match move source {
      Option<Shared<Type>>.Some {value} => move value
      _ => { return Option<Vector<Shared<Type>>>.none() }
    }
    run Vector<Shared<Type>>.append(&mut output, run Type.applyBindings(&value, bindings, true))
    at = at + usize.ONE
  }
  return Option<Vector<Shared<Type>>>.some(move output)
}

/// Selects the common source environment after closed invocation recipes have been normalized.
/// Public views do not invent origin identity; nested semantic capture identities remain intact.
pub effect fn common(values: &[Shared<Type>]) -> Option<Shared<Type>>
! OutOfMemoryError ? &mut Allocator {
  let mut result = Option<Shared<Type>>.none()
  let mut at = usize.ZERO
  while at < values.length {
    let origin = original(&values[at])
    let mut known = false
    if let Option<Shared<Type>>.Some {value: previous} = &result {
      known = true
      if !run samePendingEnvironment(&previous, &origin) { return Option<Shared<Type>>.none() }
    }
    if !known { result = Option<Shared<Type>>.some(move origin) }
    at = at + usize.ONE
  }
  return move result
}

// Only an open witness's transient Local transport regions may differ here. The original
// equations retain every region; selected producers normalize all equations and must agree
// exactly before publication. Ordinary typing, key equality and projection never use this relation.
effect fn samePendingEnvironment(left: &Shared<Type>, right: &Shared<Type>) -> bool
! OutOfMemoryError ? &mut Allocator {
  if run Type.equalsShared(left, right) { return true }
  if !Type.containsCallableWitness(left) || !Type.containsCallableWitness(right) { return false }
  let mut compared = Shared<Type>.clone(right)
  let first = run Type.copy(left)
  let second = run Type.copy(right)
  if let Type.CallableWitnessResult {witness} = move first {
    if let Type.CallableWitnessResult {witness: selected} = move second {
      if !Type.hasOpenRuntimeParameters(left) || !Type.hasOpenRuntimeParameters(right) { return false }
      let original = Shared<WitnessRecipe>.with<WitnessRecipe>(&witness, CallableWitness.copy)
      let target = Shared<WitnessRecipe>.with<WitnessRecipe>(&selected, CallableWitness.copy)
      if CallableWitness.loanCount(&original) != CallableWitness.loanCount(&target) { return false }
      let mut at = usize.ZERO
      while at < CallableWitness.loanCount(&original) {
        let sourceLoan = CallableWitness.loanAt(&original, at)
        let targetLoan = CallableWitness.loanAt(&target, at)
        if let Option<Shared<Lifetime>>.Some {value: sourceRegion} = move sourceLoan {
          if let Option<Shared<Lifetime>>.Some {value: targetRegion} = move targetLoan {
            if !Lifetime.equalsShared(&sourceRegion, &targetRegion) {
              if !Lifetime.allAtoms(&sourceRegion, localTransport)
                || !Lifetime.allAtoms(&targetRegion, localTransport) { return false }
            }
          } else { return false }
        } else { if let Option<Shared<Lifetime>>.Some {..} = move targetLoan { return false } }
        at = at + usize.ONE
      }
      compared = run Shared<Type>.make(Type.CallableWitnessResult {witness: run Shared<WitnessRecipe>.make(WitnessRecipe {
        operation: move target.operation, contract: move target.contract, provider: move target.provider, result: move target.result,
        bindings: move target.bindings, arguments: move target.arguments, loans: move original.loans, constructs: target.constructs})})
    } else { return false }
  }
  // Complete exact headers include schema blueprints, selected lifetimes, rows and statics.
  // Only free child types may contain another pending invocation selection.
  let children = match move run Type.comparisonChildren(left, &compared) {
    Option<Vector<ComparisonChild>>.Some {value} => move value
    _ => { return false }
  }
  let pairs = Vector<ComparisonChild>.asSlice(&children)
  let mut at = usize.ZERO
  while at < pairs.length {
    if !run samePendingEnvironment(&pairs[at].left, &pairs[at].right) { return false }
    at = at + usize.ONE
  }
  return true
}
// A caller region of an instance stands for a caller-local loan.
fn localTransport(value: &Lifetime) -> bool { return match &value.* { Lifetime.Local {..} => true Lifetime.Supplied {..} => true _ => false } }

fn operandType(body: &TypedBody, node: NodeId) -> Option<Shared<Type>> {
  return match &TypedBody.nodeSlice(body)[node.index].kind {
    NodeKind.Expression {ty, ..} => Option<Shared<Type>>.some(Shared<Type>.clone(&ty))
    _ => Option<Shared<Type>>.none()
  }
}

fn original(value: &Shared<Type>) -> Shared<Type> {
  let nested = Shared<Type>.with<Option<Shared<Type>>>(value, fn(node: &Type) -> Option<Shared<Type>> {
    return match &node.* {
      Type.CallableView {representation, ..} => Option<Shared<Type>>.some(Shared<Type>.clone(&representation))
      _ => Option<Shared<Type>>.none()
    }
  })
  if let Option<Shared<Type>>.Some {value: child} = move nested { return original(&child) }
  return Shared<Type>.clone(value)
}


/// A complete ordinary producer and reachable source return evidence, collected privately.
pub struct Producer {
  pub application: Shared<Application>
  pub contract: Shared<Type>
  pub returns: Vector<Shared<Type>>
  pub demands: Vector<Shared<Type>>
}

/// One original source environment selected for a complete ordinary application.
pub struct Solution {
  pub application: Shared<Application>
  pub environment: Shared<Type>
}

/// Private immutable graph evidence. A candidate map is validated by ordinary body replay before
/// an ordinary CallableOrigin answer may publish it.
pub struct Plan {
  pub requested: Shared<Application>
  pub root: Shared<Application>
  pub producers: Vector<Producer>
  pub solutions: Vector<Solution>
}

/// Finds a complete producer, retaining lifetimes, statics and enclosing owner evidence.
pub effect fn producerIndex(producers: &[Producer], application: &Shared<Application>) -> Option<usize>
! OutOfMemoryError ? &mut Allocator {
  let wanted = run Application.copyShared(application)
  let mut at = usize.ZERO
  while at < producers.length {
    let known = run Application.copyShared(&producers[at].application)
    if run Application.equals(&known, &wanted) { return Option<usize>.some(at) }
    at = at + usize.ONE
  }
  return Option<usize>.none()
}

/// Reads a candidate without substituting its original application or weakening its source view.
pub effect fn solution(solutions: &[Solution], application: &Shared<Application>) -> Option<Shared<Type>>
! OutOfMemoryError ? &mut Allocator {
  let wanted = run Application.copyShared(application)
  let mut at = usize.ZERO
  while at < solutions.length {
    let known = run Application.copyShared(&solutions[at].application)
    if run Application.equals(&known, &wanted) { return Option<Shared<Type>>.some(Shared<Type>.clone(&solutions[at].environment)) }
    at = at + usize.ONE
  }
  return Option<Shared<Type>>.none()
}

/// A direct forwarding edge has no environment of its own. Views preserve use permission at the
/// caller boundary, but do not turn a producer declaration into the returned environment identity.
pub fn forward(value: &Shared<Type>) -> Option<Shared<Application>> {
  let base = original(value)
  return Shared<Type>.with<Option<Shared<Application>>>(&base, fn(ty: &Type) -> Option<Shared<Application>> {
    return match &ty.* {
      Type.CallableOrigin {application, ..} => Option<Shared<Application>>.some(Shared<Application>.clone(&application))
      _ => Option<Shared<Application>>.none()
    }
  })
}

/// Propagates seed environments over direct forwarding edges. This deliberately returns a
/// candidate partial map; completeness, divergence and source checking are transaction gates.
pub effect fn seeds(producers: &[Producer]) -> Vector<Solution>
! OutOfMemoryError ? &mut Allocator {
  let mut solved = Vector<Solution>.make()
  let mut changed = true
  while changed {
    changed = false
    let mut at = usize.ZERO
    while at < producers.length {
      let known = run solution(Vector<Solution>.asSlice(&solved), &producers[at].application)
      if let Option<Shared<Type>>.None = move known {
        let returned = Vector<Shared<Type>>.asSlice(&producers[at].returns)
        let mut selected = Option<Shared<Type>>.none()
        let mut item = usize.ZERO
        while item < returned.length {
          let edge = forward(&returned[item])
          if let Option<Shared<Application>>.Some {value: application} = move edge {
            let leaf = run solution(Vector<Solution>.asSlice(&solved), &application)
            if let Option<Shared<Type>>.Some {value} = move leaf { selected = Option<Shared<Type>>.some(move value) }
          } else {
            if !Type.containsCallableOrigin(&returned[item]) && !Type.containsClosedCallableRecipe(&returned[item]) {
              selected = Option<Shared<Type>>.some(original(&returned[item]))
            }
          }
          item = item + usize.ONE
        }
        if let Option<Shared<Type>>.Some {value} = move selected {
          run Vector<Solution>.append(&mut solved, Solution {application: Shared<Application>.clone(&producers[at].application), environment: run Type.callableView(move value, Shared<Type>.clone(&producers[at].contract))})
          changed = true
        }
      }
      at = at + usize.ONE
    }
  }
  return move solved
}

/// Distinct origin-dependent checked node types, including dependencies unused by a reachable
/// return. Nondependent nodes remain checked by whole-body replay; these values never
/// contribute to the returned-environment equation.
pub effect fn demands(body: &Shared<TypedBody>, bindings: &[Binding]) -> Vector<Shared<Type>>
! OutOfMemoryError ? &mut Allocator {
  let count = Shared<TypedBody>.with<usize>(body, fn(value: &TypedBody) -> usize { return TypedBody.nodeSlice(value).length })
  let mut output = Vector<Shared<Type>>.make()
  let mut at = usize.ZERO
  while at < count {
    let found = Shared<TypedBody>.with<Option<Shared<Type>>>(body,
      fn(value: &TypedBody) -> Option<Shared<Type>> { return operandType(value, NodeId {index: at}) })
    if let Option<Shared<Type>>.Some {value} = move found {
      let applied = run Type.applyBindings(&value, bindings, true)
      if Type.containsCallableOrigin(&applied) || Type.containsClosedCallableRecipe(&applied) {
        let listed = Vector<Shared<Type>>.asSlice(&output)
        let mut duplicate = false
        let mut item = usize.ZERO
        while item < listed.length {
          if run Type.equalsShared(&listed[item], &applied) { duplicate = true break }
          item = item + usize.ONE
        }
        if !duplicate { run Vector<Shared<Type>>.append(&mut output, move applied) }
      }
    }
    at = at + usize.ONE
  }
  return move output
}

/// Copies immutable transaction evidence without changing any source identities.
pub effect fn copyProducer(value: &Producer) -> Producer ! OutOfMemoryError ? &mut Allocator {
  let mut returns = Vector<Shared<Type>>.make()
  let mut demands = Vector<Shared<Type>>.make()
  let results = Vector<Shared<Type>>.asSlice(&value.returns)
  let mut at = usize.ZERO
  while at < results.length { run Vector<Shared<Type>>.append(&mut returns, Shared<Type>.clone(&results[at])) at = at + usize.ONE }
  let inputs = Vector<Shared<Type>>.asSlice(&value.demands)
  at = usize.ZERO
  while at < inputs.length { run Vector<Shared<Type>>.append(&mut demands, Shared<Type>.clone(&inputs[at])) at = at + usize.ONE }
  return Producer {application: Shared<Application>.clone(&value.application), contract: Shared<Type>.clone(&value.contract), returns: move returns, demands: move demands}
}

/// Exact equality decides whether another immutable solving round is necessary.
pub effect fn sameProducer(first: &Producer, second: &Producer) -> bool ! OutOfMemoryError ? &mut Allocator {
  let left = run Application.copyShared(&first.application)
  let right = run Application.copyShared(&second.application)
  if !(run Application.equals(&left, &right)) || !(run Type.equalsShared(&first.contract, &second.contract)) { return false }
  return (run sameTypes(Vector<Shared<Type>>.asSlice(&first.returns), Vector<Shared<Type>>.asSlice(&second.returns))) &&
    (run sameTypes(Vector<Shared<Type>>.asSlice(&first.demands), Vector<Shared<Type>>.asSlice(&second.demands)))
}

effect fn sameTypes(first: &[Shared<Type>], second: &[Shared<Type>]) -> bool ! OutOfMemoryError ? &mut Allocator {
  if first.length != second.length { return false }
  let mut at = usize.ZERO
  while at < first.length { if !run Type.equalsShared(&first[at], &second[at]) { return false } at = at + usize.ONE }
  return true
}

/// Canonical producer keys may converge after free invocation recipes close. Retain every source
/// return and validation dependency while publishing one producer per exact selected application.
pub effect fn appendProducer(producers: &mut Vector<Producer>, value: Producer) -> bool
! OutOfMemoryError ? &mut Allocator {
  let previous = run producerIndex(Vector<Producer>.asSlice(&producers.*), &value.application)
  if let Option<usize>.Some {value: at} = move previous {
    let mut listed = Vector<Producer>.asMutSlice(&mut producers.*)
    if !run Type.equalsShared(&listed[at].contract, &value.contract) { return false }
    let returns = Vector<Shared<Type>>.asSlice(&value.returns)
    let mut item = usize.ZERO
    while item < returns.length { run Vector<Shared<Type>>.append(&mut listed[at].returns, Shared<Type>.clone(&returns[item])) item = item + usize.ONE }
    let demands = Vector<Shared<Type>>.asSlice(&value.demands)
    item = usize.ZERO
    while item < demands.length { run Vector<Shared<Type>>.append(&mut listed[at].demands, Shared<Type>.clone(&demands[item])) item = item + usize.ONE }
    return true
  }
  run Vector<Producer>.append(&mut producers.*, move value)
  return true
}

/// Restores original declaration-owned binder evidence for ordinary authored generic checking.
/// Static selections remain the resolver's responsibility; no selected argument is mutated.
pub effect fn sourceApplication(value: &Application) -> Application ! OutOfMemoryError ? &mut Allocator {
  let mut source = run Application.copy(value)
  let owner = DeclarationId.copy(Application.bodyDeclaration(value))
  let ordinals = Vector<usize>.asSlice(&source.argumentOrdinals)
  let mut arguments = Vector<Argument>.asMutSlice(&mut source.arguments)
  let mut at = usize.ZERO
  while at < arguments.length {
    let old = Argument.copy(&arguments[at])
    arguments[at] = run sourceArgument(&owner, ordinals[at], &old)
    at = at + usize.ONE
  }
  let mut scopes = move source.scopes
  let mut opened = Vector<ScopeBinding>.make()
  while Vector<ScopeBinding>.length(&scopes) != usize.ZERO {
    let mut scope = Vector<ScopeBinding>.remove(&mut scopes, usize.ZERO)
    let scopeOwner = DeclarationId.copyShared(&scope.owner)
    let slots = Vector<usize>.asSlice(&scope.argumentOrdinals)
    let mut supplied = Vector<Argument>.asMutSlice(&mut scope.arguments)
    let mut item = usize.ZERO
    while item < supplied.length {
      let old = Argument.copy(&supplied[item])
      supplied[item] = run sourceArgument(&scopeOwner, slots[item], &old)
      item = item + usize.ONE
    }
    run Vector<ScopeBinding>.append(&mut opened, move scope)
  }
  source.scopes = move opened
  return move source
}
effect fn sourceArgument(owner: &DeclarationId, ordinal: usize, value: &Argument) -> Argument
! OutOfMemoryError ? &mut Allocator {
  return match &value.* {
    Argument.Type {..} => Argument.Type {value: run Shared<Type>.make(Type.Parameter {declaration: DeclarationId.copy(owner), ordinal: ordinal})}
    Argument.Lifetime {..} => Argument.Lifetime {value: run Shared<Lifetime>.make(Lifetime.Parameter {declaration: DeclarationId.copy(owner), ordinal: ordinal})}
    Argument.Row {..} => {
      let mut row = Row.empty()
      run Row.include(&mut row, RowParameter {declaration: run Shared<DeclarationId>.make(DeclarationId.copy(owner)), ordinal: ordinal})
      return Argument.Row {value: run Shared<Row>.make(move row)}
    }
  }
}
