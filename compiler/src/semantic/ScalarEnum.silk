//! Representation and discriminant sequence for one scalar enum declaration.
//!
//! # When to use
//! Validate the complete member list when a scalar enum is demanded. Explicit discriminants stay
//! decimal literals; no static expression evaluator participates in their interpretation.

import semantic.StaticValue {IntegerType, Sign, Value}
import semantic.StaticValue
import silk.allocator {Allocator, OutOfMemoryError}
import silk.bytes {Bytes}
import silk.option {Option}
import silk.result {Result}
import silk.u8
import silk.u64
import silk.usize
import silk.vector {Vector}

/// One optionally negative decimal integer literal written after `=`.
pub struct Literal {
  pub sign: Sign
  pub digits: Bytes
}

/// One enum member in declaration order.
pub struct Member {
  pub name: Bytes
  pub explicit: Option<Literal>
}

/// A validated member's representation value in sign-magnitude form.
pub struct Case {
  pub sign: Sign
  pub magnitude: u64
}

/// A rejected member's position and the precise violated rule.
pub struct Failure {
  pub reason: Reason
  pub ordinal: usize
  /// Earlier member for a duplicate name or discriminant.
  pub previous: Option<usize>
}

pub enum Reason {
  Empty,
  Representation,
  DuplicateName,
  DuplicateDiscriminant,
  ExplicitOutOfRange,
  ImplicitOverflow,
  NegativeUnsigned,
  InvalidLiteral,
}

fn rejected(reason: Reason, ordinal: usize, previous: Option<usize>) -> Result<
  Vector<Case>,
  Failure,
> {
  return Result.failResult<Vector<Case>, Failure>(
    Failure {reason: reason, ordinal: ordinal, previous: move previous},
  )
}

fn sameBytes(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

fn decimal(digits: &[u8]) -> Option<u64> {
  if digits.length == usize.ZERO {
    return Option.none<u64>()
  }
  let mut value: u64 = 0
  let mut at = usize.ZERO
  while at < digits.length {
    if digits[at] == 95 {
      if at == usize.ZERO || at + usize.ONE >= digits.length {
        return Option.none<u64>()
      }
      if digits[at - usize.ONE] < 48 || digits[at - usize.ONE] > 57 || digits[at + usize.ONE] < 48 || digits[at + usize.ONE] > 57 {
        return Option.none<u64>()
      }
      at = at + usize.ONE
      continue
    }
    if digits[at] < 48 || digits[at] > 57 {
      return Option.none<u64>()
    }
    let scaled = match move u64.checkedMultiply(value, 10) {
      Option<u64>.Some {value: next} => next
      Option<u64>.None => {
        return Option.none<u64>()
      }
    }
    value = match move u64.checkedAdd(scaled, u8.toU64(digits[at] - 48)) {
      Option<u64>.Some {value: next} => next
      Option<u64>.None => {
        return Option.none<u64>()
      }
    }
    at = at + usize.ONE
  }
  return Option.some<u64>(value)
}

fn successor(previous: &Case) -> Option<Case> {
  if previous.sign == Sign.Negative {
    if previous.magnitude == 1 {
      return Option.some<Case>(Case {sign: Sign.Positive, magnitude: 0})
    }
    return Option.some<Case>(Case {sign: Sign.Negative, magnitude: previous.magnitude - 1})
  }
  return match move u64.checkedAdd(previous.magnitude, 1) {
    Option<u64>.Some {value} => Option.some<Case>(Case {sign: Sign.Positive, magnitude: value})
    Option<u64>.None => Option.none<Case>()
  }
}

fn sameCase(left: &Case, right: &Case) -> bool {
  return left.sign == right.sign && left.magnitude == right.magnitude
}

/// Check representation, ranges, implicit successors, and duplicate names/values in source order.
/// The first failure owns the later member's ordinal and optionally identifies its earlier peer.
pub effect fn validate(members: &[Member], representation: IntegerType) -> Result<
  Vector<Case>,
  Failure,
> ! OutOfMemoryError ? &mut Allocator {
  if members.length == usize.ZERO {
    return rejected(Reason.Empty, usize.ZERO, Option.none<usize>())
  }
  if representation == IntegerType.Usize || representation == IntegerType.Isize {
    return rejected(Reason.Representation, usize.ZERO, Option.none<usize>())
  }
  let mut cases = Vector.make<Case>()
  let mut at = usize.ZERO
  while at < members.length {
    let mut before = usize.ZERO
    while before < at {
      if sameBytes(Bytes.asSlice(&members[before].name), Bytes.asSlice(&members[at].name)) {
        return rejected(Reason.DuplicateName, at, Option.some<usize>(before))
      }
      before = before + usize.ONE
    }
    let mut candidate = Case {sign: Sign.Positive, magnitude: 0}
    let mut explicit = false
    if let Option<Literal>.Some {value} = &members[at].explicit {
      explicit = true
      let magnitude = match move decimal(Bytes.asSlice(&value.digits)) {
        Option<u64>.Some {value: parsed} => parsed
        Option<u64>.None => {
          return rejected(Reason.InvalidLiteral, at, Option.none<usize>())
        }
      }
      let mut sign = value.sign
      if magnitude == 0 {
        sign = Sign.Positive
      }
      candidate = Case {sign: sign, magnitude: magnitude}
    } else if at > usize.ZERO {
      let prior = Vector.asSlice<Case>(&cases)
      candidate = match move successor(&prior[at - usize.ONE]) {
        Option<Case>.Some {value} => move value
        Option<Case>.None => {
          return rejected(Reason.ImplicitOverflow, at, Option.none<usize>())
        }
      }
    }
    if candidate.sign == Sign.Negative && !StaticValue.signed(representation) {
      return rejected(Reason.NegativeUnsigned, at, Option.none<usize>())
    }
    let admitted = StaticValue.integer(representation, candidate.sign, candidate.magnitude, 64)
    if let Option<Value>.None = move admitted {
      let mut reason = Reason.ImplicitOverflow
      if explicit {
        reason = Reason.ExplicitOutOfRange
      }
      return rejected(reason, at, Option.none<usize>())
    }
    let prior = Vector.asSlice<Case>(&cases)
    before = usize.ZERO
    while before < prior.length {
      if sameCase(&prior[before], &candidate) {
        return rejected(Reason.DuplicateDiscriminant, at, Option.some<usize>(before))
      }
      before = before + usize.ONE
    }
    run Vector.append<Case>(&mut cases, move candidate)
    at = at + usize.ONE
  }
  return Result.succeed<Vector<Case>, Failure>(move cases)
}
