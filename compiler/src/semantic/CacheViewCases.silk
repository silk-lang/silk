//! A selected cache view borrows immutable answers and advances only equivalent input placements.

import CompilerBug
import semantic.CacheGeneration {Generation as GenerationData, LeafHandle, Placement, Selection, Certificate}
import semantic.CacheSegments as Segments {Descriptor, Edge, Node, Observation, Reference, Root, SealedSegment}
import semantic.CacheView as CacheView {Handle, View}
import semantic.ContentHash {ContentHash}
import semantic.RuntimeEncoding
import silk.collections.bytes {Bytes}
import silk.collections.list {List}
import silk.core.effect {Effect}
import silk.core.option {Option}
import silk.mem.frozen {Frozen}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.testing.testing {AssertionError, Testing}
import silk.num.u64
import silk.num.u32
import silk.num.usize

fn digest(value: usize) -> ContentHash { return ContentHash {high: 0, low: usize.toU64(value)} }
effect fn segment(serial: u64, fileDigest: ContentHash, answer: &[u8], key: &[u8], parents: &[Frozen<SealedSegment>])
-> Frozen<SealedSegment> ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut builder = run Segments.make(serial, b"view-profile")
  if parents.length > 0 { run List<Descriptor>.append(&mut builder.imports, Segments.descriptor(Frozen<SealedSegment>.get(&parents[0]))) }
  run List<Observation>.append(&mut builder.leaves, Observation {key: run Bytes.copy(b"module"), digest: fileDigest,
    text: digest(0), position: usize.MAX, file: Option<Reference>.none(), selector: u32.MAX, input: false})
  run List<Observation>.append(&mut builder.leaves, Observation {key: run Bytes.copy(b"module/body"), digest: digest(20),
    text: fileDigest, position: u64.toUsize(serial), file: Option<Reference>.some(Reference {segment: 0, index: 0}), selector: 4, input: true})
  let mut edges = List<Edge>.make()
  run List<Edge>.append(&mut edges, Edge {node: false, target: Reference {segment: 0, index: 1}})
  run List<Node>.append(&mut builder.nodes, Node {edges: move edges})
  let mut packs = List<ContentHash>.make()
  run List<ContentHash>.append(&mut packs, fileDigest)
  let rootNode = Reference {segment: if parents.length > 0 { usize.ONE } else { usize.ZERO }, index: 0}
  run List<Root>.append(&mut builder.roots, Root {key: run Bytes.copy(key), node: rootNode, answer: run Bytes.copy(answer), packs: move packs})
  let held = match move run Segments.seal(move builder, parents) {
    Option<SealedSegment>.Some {value} => move value
    Option<SealedSegment>.None => {
      run Testing.expect(false, "valid view fixture seals")
      return CompilerBug.panic(b"fixture segment must seal")
    }
  }
  return run Frozen<SealedSegment>.make(move held)
}
fn consume(view: View) -> () {}

effect fn viewClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut owners = List<Frozen<SealedSegment>>.make()
  run List<Frozen<SealedSegment>>.append(&mut owners, run segment(1, digest(11), b"obsolete", b"old", &[]))
  let fresh = run segment(2, digest(22), b"current", b"fresh", List<Frozen<SealedSegment>>.asSlice(&owners))
  run List<Frozen<SealedSegment>>.append(&mut owners, move fresh)
  let old = Segments.descriptor(Frozen<SealedSegment>.get(&List<Frozen<SealedSegment>>.asSlice(&owners)[0]))
  let new = Segments.descriptor(Frozen<SealedSegment>.get(&List<Frozen<SealedSegment>>.asSlice(&owners)[1]))
  let mut catalog = List<Descriptor>.make()
  run List<Descriptor>.append(&mut catalog, old)
  run List<Descriptor>.append(&mut catalog, new)
  let mut selections = List<Selection>.make()
  run List<Selection>.append(&mut selections, Selection {segment: new.digest, roots: run Bytes.copy(&[1])})
  let mut placements = List<Placement>.make()
  run List<Placement>.append(&mut placements, Placement {source: LeafHandle {segment: old.digest, index: 1}, target: LeafHandle {segment: new.digest, index: 1}})
  let generation = GenerationData {stamp: run Bytes.copy(b"view-profile"), catalog: move catalog, selections: move selections, placements: move placements, certificate: Option<Certificate>.none()}
  let view = match move run CacheView.make(move generation, move owners) {
    Option<View>.Some {value} => move value
    Option<View>.None => { run Testing.expect(false, "coherent selected generation creates a view") return () }
  }
  run Testing.expect(CacheView.rootCount(&view) == 1, "only selected roots appear in the view")
  match move CacheView.findRoot(&view, b"old") {
    Option<usize>.None => {}
    Option<usize>.Some {..} => { run Testing.expect(false, "retained physical old answers confer no root authority") }
  }
  match move CacheView.rootAnswer(&view, 0) {
    Option<&[u8]>.Some {value} => { run Testing.expect(RuntimeEncoding.equals(value, b"current"), "selected answer stays in original sealed bytes") }
    Option<&[u8]>.None => { run Testing.expect(false, "selected answer exists") }
  }
  let rootNode = match move CacheView.rootNode(&view, 0) {
    Option<Handle>.Some {value} => value
    Option<Handle>.None => { run Testing.expect(false, "imported root guard exists") return () }
  }
  run Testing.expect(rootNode.segment == 0 && rootNode.index == 0, "fresh root retains the imported old guard")
  let dependency = match move CacheView.edge(&view, rootNode, 0) {
    Option<CacheView.Dependency>.Some {value} => value
    Option<CacheView.Dependency>.None => { run Testing.expect(false, "guard dependency resolves") return () }
  }
  run Testing.expect(!dependency.node && dependency.target.segment == 0 && dependency.target.index == 1,
    "the original guard's expected observation remains original")
  let effective = CacheView.placedHandle(&view, dependency.target)
  run Testing.expect(effective.segment == 1 && effective.index == 1, "direct equivalent input placement advances independently")
  match move CacheView.placementFile(&view, dependency.target) {
    Option<Handle>.Some {value} => { run Testing.expect(value.segment == 1 && value.index == 0, "new placement uses its own recorded file snapshot") }
    Option<Handle>.None => { run Testing.expect(false, "input position has a file snapshot") }
  }
  match move CacheView.observation(&view, Handle {segment: 0, index: 0}) {
    Option<Segments.ObservationView>.Some {value} => { run Testing.expect(ContentHash.equals(value.digest, digest(11)), "whole-file dependency retains old expected digest") }
    Option<Segments.ObservationView>.None => { run Testing.expect(false, "old whole-file guard remains addressable") }
  }
  let packs = CacheView.requiredPacks(&view)
  run Testing.expect(packs.length == 1 && ContentHash.equals(packs[0], digest(22)), "unselected old answer's native pack is not required")
  let retained = run CacheView.cloneSegments(&view)
  consume(move view)
  let owner = Frozen<SealedSegment>.get(&List<Frozen<SealedSegment>>.asSlice(&retained)[1])
  match move Segments.rootAnswer(owner, 0) {
    Option<&[u8]>.Some {value} => { run Testing.expect(RuntimeEncoding.equals(value, b"current"), "cloned immutable ownership survives the original view") }
    Option<&[u8]>.None => { run Testing.expect(false, "retained owner remains alive") }
  }
}

test effect fn selectedCacheViewKeepsImportedGuardsAndDirectPlacementOwnership() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run viewClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}
