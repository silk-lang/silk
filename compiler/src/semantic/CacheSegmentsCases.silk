//! Immutable cache segments preserve dependency identity and refuse invalid topology.

import semantic.CacheSegments as Segments {Admission, Descriptor, Edge, Node, Observation, Reference, Root, Segment}
import semantic.ContentHash {ContentHash}
import semantic.StableKey
import silk.collections.bytes {Bytes}
import silk.collections.list {List}
import silk.collections.slice {Slice}
import silk.core.effect {Effect}
import silk.core.option {Option}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.mem.frozen {Frozen}
import silk.testing.testing {AssertionError, Testing}
import silk.num.u64
import silk.num.u32
import silk.num.usize

fn digest(value: usize) -> ContentHash { return ContentHash {high: 0, low: usize.toU64(value)} }
fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut at = usize.ZERO
  while at < left.length { if left[at] != right[at] { return false } at = at + usize.ONE }
  return true
}
effect fn encoded(segment: &Segment) -> Bytes ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  return match move run Segments.encode(segment) {
    Option<Bytes>.Some {value} => move value
    Option<Bytes>.None => { run Testing.expect(false, "valid segment encodes") return Bytes.make() }
  }
}
effect fn decoded(bytes: &[u8]) -> Segment ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  return match move run Segments.decode(bytes, b"compiler-target-profile") {
    Option<Segment>.Some {value} => move value
    Option<Segment>.None => { run Testing.expect(false, "valid segment decodes") return run Segments.make(1, b"compiler-target-profile") }
  }
}
effect fn sample() -> Segment ! OutOfMemoryError ? &mut Allocator {
  let mut segment = run Segments.make(1, b"compiler-target-profile")
  run List<Observation>.append(&mut segment.leaves, Observation {key: run Bytes.copy(b"file/module"),
    digest: digest(11), text: digest(0), position: usize.MAX, file: Option<Reference>.none(), selector: u32.MAX, input: false})
  run List<Observation>.append(&mut segment.leaves, Observation {key: run Bytes.copy(b"declaration/body"),
    digest: digest(12), text: digest(13), position: 7,
    file: Option<Reference>.some(Reference {segment: 0, index: 0}), selector: 4, input: true})
  let mut edges = List<Edge>.make()
  run List<Edge>.append(&mut edges, Edge {node: false, target: Reference {segment: 0, index: 1}})
  run List<Node>.append(&mut segment.nodes, Node {edges: move edges})
  let mut packs = List<ContentHash>.make()
  run List<ContentHash>.append(&mut packs, digest(99))
  run List<Root>.append(&mut segment.roots, Root {key: run Bytes.copy(b"exact-root-key"),
    node: Reference {segment: 0, index: 0}, answer: run Bytes.copy(b"answer"), packs: move packs})
  return move segment
}

effect fn roundTripClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let segment = run sample()
  let bytes = run encoded(&segment)
  let restored = run decoded(Bytes.asSlice(&bytes))
  let repeated = run encoded(&restored)
  run Testing.expect(same(Bytes.asSlice(&bytes), Bytes.asSlice(&repeated)), "all source stamps, positions, keys, answers and pack references round trip exactly")
  run Testing.expect(Segments.validateImports(&restored, &[]), "a self-contained segment needs no external authority")
  let leaves = List<Observation>.asSlice(&restored.leaves)
  run Testing.expect(leaves[1].position == 7 && ContentHash.equals(leaves[1].digest, digest(12))
    && ContentHash.equals(leaves[1].text, digest(13)) && ContentHash.equals(leaves[0].digest, digest(11)),
    "a declaration observation keeps its original file and token fingerprints")
  let admitted = run Segments.admission(&restored, Bytes.asSlice(&bytes))
  run Testing.expect(Bytes.length(&admitted.sourceLeaves) == 1 && Bytes.asSlice(&admitted.sourceLeaves)[0] == 1,
    "only the whole-file leaf is authoritative as a position snapshot")
  match move run Segments.decode(Bytes.asSlice(&bytes), b"different-profile") {
    Option<Segment>.None => {}
    Option<Segment>.Some {..} => { run Testing.expect(false, "a different compiler/profile stamp refuses the segment") }
  }
  let mut damaged = run Bytes.copy(Bytes.asSlice(&bytes))
  let damagedBytes = Bytes.asMutSlice(&mut damaged)
  damagedBytes[0] = 255
  match move run Segments.decode(Bytes.asSlice(&damaged), b"compiler-target-profile") {
    Option<Segment>.None => {}
    Option<Segment>.Some {..} => { run Testing.expect(false, "checksum damage refuses before admission") }
  }
  match move run Segments.decode(Slice.view<u8>(Bytes.asSlice(&bytes), 0, Bytes.length(&bytes) - usize.ONE), b"compiler-target-profile") {
    Option<Segment>.None => {}
    Option<Segment>.Some {..} => { run Testing.expect(false, "truncation refuses transactionally") }
  }
}

effect fn importClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let base = run sample()
  let baseBytes = run encoded(&base)
  let mut admitted = List<Admission>.make()
  run List<Admission>.append(&mut admitted, run Segments.admission(&base, Bytes.asSlice(&baseBytes)))
  let mut segment = run Segments.make(2, b"compiler-target-profile")
  run List<Descriptor>.append(&mut segment.imports, Segments.describe(&base, Bytes.asSlice(&baseBytes)))
  run List<Observation>.append(&mut segment.leaves, Observation {key: run Bytes.copy(b"new/body"), digest: digest(20),
    text: digest(21), position: 8, file: Option<Reference>.some(Reference {segment: 1, index: 0}), selector: 4, input: true})
  run List<Root>.append(&mut segment.roots, Root {key: run Bytes.copy(b"new/check"), node: Reference {segment: 1, index: 0},
    answer: run Bytes.copy(b"depends-on-old-guard"), packs: List<ContentHash>.make()})
  run Testing.expect(!Segments.validateImports(&segment, &[]), "self-declared import descriptors do not grant authority")
  run Testing.expect(Segments.validateImports(&segment, List<Admission>.asSlice(&admitted)), "authenticated imported guards and file snapshots are accepted")
  let bytes = run encoded(&segment)
  let restored = run decoded(Bytes.asSlice(&bytes))
  run Testing.expect(Segments.validateImports(&restored, List<Admission>.asSlice(&admitted)), "wire references preserve exact imported segment ownership")
  let slots1 = List<Observation>.asMutSlice(&mut segment.leaves)
  slots1[0].file = Option<Reference>.some(Reference {segment: 1, index: 1})
  run Testing.expect(!Segments.validateImports(&segment, List<Admission>.asSlice(&admitted)), "an imported input leaf cannot masquerade as a whole-file snapshot")
  let slots2 = List<Observation>.asMutSlice(&mut segment.leaves)
  slots2[0].file = Option<Reference>.some(Reference {segment: 1, index: 0})
  let slots3 = List<Descriptor>.asMutSlice(&mut segment.imports)
  slots3[0].nodes = 2
  run Testing.expect(!Segments.validateImports(&segment, List<Admission>.asSlice(&admitted)), "forged imported topology refuses even when the digest matches")
  let slots4 = List<Descriptor>.asMutSlice(&mut segment.imports)
  slots4[0].nodes = 1
  segment.serial = 1
  match move run Segments.encode(&segment) {
    Option<Bytes>.None => {}
    Option<Bytes>.Some {..} => { run Testing.expect(false, "same-serial imports cannot form a segment cycle") }
  }
}

effect fn topologyClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut segment = run sample()
  let mut edges = List<Edge>.make()
  run List<Edge>.append(&mut edges, Edge {node: true, target: Reference {segment: 0, index: 0}})
  let slots5 = List<Node>.asMutSlice(&mut segment.nodes)
  slots5[0].edges = move edges
  match move run Segments.encode(&segment) {
    Option<Bytes>.None => {}
    Option<Bytes>.Some {..} => { run Testing.expect(false, "self and forward node references refuse before encoding") }
  }
  let slots6 = List<Node>.asMutSlice(&mut segment.nodes)
  slots6[0].edges = List<Edge>.make()
  let slots7 = List<Observation>.asMutSlice(&mut segment.leaves)
  slots7[1].file = Option<Reference>.some(Reference {segment: 0, index: 1})
  match move run Segments.encode(&segment) {
    Option<Bytes>.None => {}
    Option<Bytes>.Some {..} => { run Testing.expect(false, "local position snapshots must name whole files") }
  }
}

test effect fn cacheSegmentsPreserveOriginalObservationAndPacketIdentity() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run roundTripClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}
test effect fn cacheSegmentsAuthenticateImportsAndRejectCycles() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run importClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}
test effect fn cacheSegmentsRefuseInvalidLocalDependencyTopology() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run topologyClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

// These raw edits model a validly framed but malformed cache packet. They recompute the
// content checksum so the structural boundary, not accidental checksum damage, is exercised.
fn overwriteWord(bytes: &mut [u8], at: usize, value: u64) -> () {
  let mut offset = usize.ZERO
  while offset < 8 {
    bytes[at + offset] = u64.toU8(u64.bitAnd(u64.shiftRight(value, usize.toU64((7 - offset) * 8)), 255))
    offset = offset + usize.ONE
  }
}
fn reseal(bytes: &mut Bytes) -> () {
  let length = Bytes.length(&bytes.*)
  let hash = ContentHash.of(Slice.view<u8>(Bytes.asSlice(&bytes.*), 0, length - 16))
  overwriteWord(Bytes.asMutSlice(&mut bytes.*), length - 16, hash.high)
  overwriteWord(Bytes.asMutSlice(&mut bytes.*), length - 8, hash.low)
}
effect fn sealedViewClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let owner = match move run Segments.seal(run sample(), &[]) {
    Option<Segments.SealedSegment>.Some {value} => move value
    Option<Segments.SealedSegment>.None => { run Testing.expect(false, "valid mutable builder seals") return () }
  }
  let key = Segments.rootKey(&owner, 0)
  match &key {
    Option<&[u8]>.Some {value} => { run Testing.expect(same(value, b"exact-root-key"), "borrowed root key is exact") }
    Option<&[u8]>.None => { run Testing.expect(false, "selected root key exists") }
  }
  match move Segments.edge(&owner, 0, 0) {
    Option<Edge>.Some {value} => { run Testing.expect(!value.node && value.target.segment == 0 && value.target.index == 1,
      "lazy dependency access preserves exact local leaf ownership") }
    Option<Edge>.None => { run Testing.expect(false, "valid dependency can be read") }
  }
  run Testing.expect(Segments.anchors(&owner).length == 1 && Segments.anchors(&owner)[0] == 0,
    "only the whole-file observation anchors an otherwise unchanged file")
  let raw = Segments.encoded(&owner)
  let mut footer = StableKey.reader()
  let index = u64.toUsize(StableKey.readWord(Slice.view<u8>(raw, raw.length - 24, 8), &mut footer))
  let directory = Slice.view<u8>(raw, index, raw.length - 24 - index)
  let mut reader = StableKey.reader()
  drop StableKey.readWord(directory, &mut reader)
  let leaves = StableKey.readWord(directory, &mut reader)
  let mut at: u64 = 0
  let mut lastLeafEnd = usize.ZERO
  while at < leaves { lastLeafEnd = u64.toUsize(StableKey.readWord(directory, &mut reader)) at = at + 1 }
  drop StableKey.readWord(directory, &mut reader)
  let firstNode = u64.toUsize(StableKey.readWord(directory, &mut reader))
  let mut badEdge = run Bytes.copy(raw)
  overwriteWord(Bytes.asMutSlice(&mut badEdge), firstNode + 24, 131072)
  reseal(&mut badEdge)
  let broken = match move run Segments.open(move badEdge, b"compiler-target-profile") {
    Option<Segments.SealedSegment>.Some {value} => move value
    Option<Segments.SealedSegment>.None => { run Testing.expect(false, "opening leaves unrequested edge payloads lazy") return () }
  }
  match move Segments.edge(&broken, 0, 0) {
    Option<Edge>.None => {}
    Option<Edge>.Some {..} => { run Testing.expect(false, "a malformed dependency cannot become a usable guard") }
  }
  let mut badSourceKind = run Bytes.copy(raw)
  overwriteWord(Bytes.asMutSlice(&mut badSourceKind), lastLeafEnd - 8, 0)
  reseal(&mut badSourceKind)
  match move run Segments.open(move badSourceKind, b"compiler-target-profile") {
    Option<Segments.SealedSegment>.None => {}
    Option<Segments.SealedSegment>.Some {..} => { run Testing.expect(false, "input metadata cannot be substituted as a whole-file bitmap entry") }
  }
  let mut parents = List<Frozen<Segments.SealedSegment>>.make()
  run List<Frozen<Segments.SealedSegment>>.append(&mut parents, run Frozen<Segments.SealedSegment>.make(move owner))
  let parent = Segments.descriptor(Frozen<Segments.SealedSegment>.get(&List<Frozen<Segments.SealedSegment>>.asSlice(&parents)[0]))
  let mut referenced = usize.ZERO
  while referenced < 2 {
    let mut remote = run Segments.make(2, b"compiler-target-profile")
    run List<Descriptor>.append(&mut remote.imports, parent)
    run List<Observation>.append(&mut remote.leaves, Observation {key: run Bytes.copy(b"remote/input"), digest: digest(31),
      text: digest(32), position: 4, file: Option<Reference>.some(Reference {segment: 1, index: referenced}), selector: 4, input: true})
    let sealed = run Segments.seal(move remote, List<Frozen<Segments.SealedSegment>>.asSlice(&parents))
    let accepted = match &sealed { Option<Segments.SealedSegment>.Some {..} => true _ => false }
    run Testing.expect(accepted == (referenced == usize.ZERO), "opaque imported ownership authenticates whole-file claims and rejects input substitutes")
    referenced = referenced + usize.ONE
  }
}

test effect fn cacheSegmentsSealSourceKindsAndValidateEdgesLazily() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run sealedViewClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}
