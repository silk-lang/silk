//! Optional diagnostic timing for immutable cache adoption and green budget work.
//! Enable with SILK_CACHE_WORK_TRACE; these nested diagnostic timings are not benchmark results.
import semantic.FrontierHost {FrontierHost}
import diagnostic.JsonText
import silk.collections.bytes {Bytes}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.mem.pointer {Pointer}
import silk.num.i64
import silk.num.u64
import silk.num.usize
import silk.platform.native.clock {NativeClock}
import silk.system.system_clock {SystemClock}

effect fn now() -> u64 {
  let instant = run NativeClock.now(true)
  return i64.toU64(SystemClock.seconds(&instant)) * 1000000000 + i64.toU64(SystemClock.nanoseconds(&instant))
}
pub effect fn begin() -> u64 {
  if Pointer.isNullMany<u8>(unsafe FrontierHost.environment(Pointer.fromSlice<u8>(b"SILK_CACHE_WORK_TRACE\0"))) { return 0 }
  return run now()
}
pub effect fn end(label: &[u8], started: u64, first: usize, second: usize) -> ()
! OutOfMemoryError ? &mut Allocator {
  if started == 0 { return () }
  let elapsed = (run now()) - started
  let mut text = run Bytes.copy(b"cache-work ")
  run Bytes.append(&mut text, label)
  run Bytes.append(&mut text, b" ns=")
  run JsonText.appendDecimal(&mut text, u64.toUsize(elapsed))
  run Bytes.append(&mut text, b" a=")
  run JsonText.appendDecimal(&mut text, first)
  run Bytes.append(&mut text, b" b=")
  run JsonText.appendDecimal(&mut text, second)
  run Bytes.append(&mut text, b"\n")
  let bytes = Bytes.asSlice(&text)
  drop unsafe FrontierHost.write(2, Pointer.fromSlice<u8>(bytes), bytes.length)
}
