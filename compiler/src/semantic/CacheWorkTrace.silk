//! Opt-in CPU0 cache-work attribution. SILK_CPU0_CACHE_TRACE enables monotonic aggregate
//! timings and row counts; no observation or row writes an event to a file. Timers nest,
//! diagnostic clocks/bitsets add overhead, and these traces are not benchmark measurements.
import semantic.FrontierHost {FrontierHost}
import semantic.SourceInputs {Selector, Facet}
import silk.collections.bytes {Bytes}
import silk.collections.list {List}
import silk.core.ownership {Copy}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.mem.pointer {Pointer}
import silk.num.i32
import silk.num.u8
import silk.num.i64
import silk.num.u64
import silk.num.usize
import silk.platform.native.clock {NativeClock}
import silk.system.system_clock {SystemClock}

pub fn enabled() -> bool {
  return !Pointer.isNullMany<u8>(unsafe FrontierHost.environment(Pointer.fromSlice<u8>(b"SILK_CPU0_CACHE_TRACE\0")))
}
pub effect fn now() -> u64 {
  let instant = run NativeClock.now(true)
  return i64.toU64(SystemClock.seconds(&instant)) * 1000000000 + i64.toU64(SystemClock.nanoseconds(&instant))
}
pub effect fn begin() -> u64 { return if enabled() { run now() } else { 0 } }
pub effect fn elapsed(start: u64) -> u64 { return if start == 0 { 0 } else { (run now()) - start } }

// The harness may pass an append-only descriptor across compiler, worker and native forks.
// This avoids native coordinator stderr redirection and does not change any production handle.
fn descriptor() -> i32 {
  let raw = unsafe FrontierHost.environment(Pointer.fromSlice<u8>(b"SILK_CPU_TRACE_FD\0"))
  if Pointer.isNullMany<u8>(raw) { return 2 }
  let bytes = unsafe Intrinsic.pointerRequalify<?[*]const u8, [*]const u8>(raw)
  let mut value = usize.ZERO
  let mut at = usize.ZERO
  while at < 10 {
    let byte = unsafe Pointer.read<u8>(unsafe Pointer.at<u8>(bytes, at))
    if byte == 0 { return if at == usize.ZERO { 2 } else { usize.toI32(value) } }
    if byte < '0' || byte > '9' { return 2 }
    let digit = u8.toUsize(byte - '0')
    if value > (2147483647 - digit) / 10 { return 2 }
    value = value * 10 + digit
    at = at + usize.ONE
  }
  return if unsafe Pointer.read<u8>(unsafe Pointer.at<u8>(bytes, at)) == 0 { usize.toI32(value) } else { 2 }
}
extern "C" struct TraceTime { seconds: i64, nanoseconds: i64 }
static if Intrinsic.targetOperatingSystem() == "linux" && Intrinsic.profileText("libc") == "gnu"
  && (Intrinsic.targetArchitecture() == "x86_64" || Intrinsic.targetArchitecture() == "aarch64") {
  @foreign(noCapture: .("value"))
  unsafe extern "C" fn traceClock(clock: i32, value: *mut TraceTime) -> i32 as "clock_gettime"
  unsafe extern "C" fn tracePid() -> i32 as "getpid"
  // gettid has no wrapper in the compiler's minimum glibc ABI; both supported Linux
  // architectures use a 64-bit syscall word and provide the kernel operation directly.
  unsafe extern "C" fn traceSyscall(number: i64) -> i64 as "syscall"
  fn instant() -> u64 {
    let mut value = TraceTime {seconds: 0, nanoseconds: 0}
    if unsafe traceClock(1, Pointer.fromMutRef<TraceTime>(&mut value)) != 0 { return 0 }
    if value.seconds < 0 || value.nanoseconds < 0 { return 0 }
    return i64.toU64(value.seconds) * 1000000000 + i64.toU64(value.nanoseconds)
  }
  fn process() -> usize { return i32.toUsize(unsafe tracePid()) }
  static if Intrinsic.targetArchitecture() == "x86_64" {
    const threadOperation: i64 = 186
  } else {
    const threadOperation: i64 = 178
  }
  fn thread() -> usize {
    let id = unsafe traceSyscall(threadOperation)
    return if id > 0 { i64.toUsize(id) } else { usize.ZERO }
  }
} else {
  fn instant() -> u64 { return 0 }
  fn process() -> usize { return 0 }
  fn thread() -> usize { return 0 }
}
fn append(output: &mut [u8], at: &mut usize, bytes: &[u8]) -> () {
  let mut i = usize.ZERO
  while i < bytes.length && at.* < output.length {
    output[at.*] = bytes[i]
    at.* = at.* + usize.ONE
    i = i + usize.ONE
  }
}
fn decimal(output: &mut [u8], at: &mut usize, value: u64) -> () {
  let mut digits: [u8; 20] = [0; 20]
  let mut held = value
  let mut start: usize = 20
  while true {
    start = start - usize.ONE
    digits[start] = u64.toU8(held % 10) + '0'
    held = held / 10
    if held == 0 { break }
  }
  while start < 20 && at.* < output.length {
    output[at.*] = digits[start]
    at.* = at.* + usize.ONE
    start = start + usize.ONE
  }
}
// One bounded write, no allocation or Effect, so completion Drop hooks can emit points safely.
fn writeRecord(label: &[u8], nanos: u64, first: usize, second: usize, third: usize) -> () {
  if !enabled() || label.length > 256 { return () }
  let timestamp = instant()
  let mut output: [u8; 512] = [0; 512]
  let mut at = usize.ZERO
  append(&mut output, &mut at, b"cpu0-cache ")
  append(&mut output, &mut at, label)
  append(&mut output, &mut at, b" at_ns=")
  decimal(&mut output, &mut at, timestamp)
  append(&mut output, &mut at, b" pid=")
  decimal(&mut output, &mut at, usize.toU64(process()))
  append(&mut output, &mut at, b" tid=")
  decimal(&mut output, &mut at, usize.toU64(thread()))
  append(&mut output, &mut at, b" ns=")
  decimal(&mut output, &mut at, nanos)
  append(&mut output, &mut at, b" a=")
  decimal(&mut output, &mut at, usize.toU64(first))
  append(&mut output, &mut at, b" b=")
  decimal(&mut output, &mut at, usize.toU64(second))
  append(&mut output, &mut at, b" c=")
  decimal(&mut output, &mut at, usize.toU64(third))
  append(&mut output, &mut at, b"\n")
  drop unsafe FrontierHost.write(descriptor(), Pointer.fromSlice<u8>(&output), at)
}
/// An allocation-free point for pure native coordinator and completion hooks.
pub fn point(label: &[u8], first: usize, second: usize) -> () { writeRecord(label, 0, first, second, usize.ZERO) }
// a/b/c are documented by the call site. Each line is one completed aggregate or phase.
pub effect fn emit(label: &[u8], nanos: u64, first: usize, second: usize, third: usize) -> ()
! OutOfMemoryError ? &mut Allocator { writeRecord(label, nanos, first, second, third) }
pub effect fn end(label: &[u8], started: u64, first: usize, second: usize) -> ()
! OutOfMemoryError ? &mut Allocator {
  if started != 0 { run emit(label, run elapsed(started), first, second, usize.ZERO) }
}

struct Bucket { label: &'static [u8], count: usize, bytes: usize, lookup: u64, capture: u64, hashText: u64 }
impl Copy for Bucket {}
pub struct Capture { pub enabled: bool, buckets: List<Bucket> }
pub effect fn capture() -> Capture ! OutOfMemoryError ? &mut Allocator {
  let active = enabled()
  let mut buckets = List<Bucket>.make()
  if active { run List<Bucket>.appendRepeated(&mut buckets,
    Bucket {label: b"", count: 0, bytes: 0, lookup: 0, capture: 0, hashText: 0}, 26) }
  return Capture {enabled: active, buckets: move buckets}
}
fn kind(selector: &Selector) -> usize {
  return match &selector.* {
    Selector.Presence => 0
    Selector.Implementations => 1
    Selector.Inherents => 2
    Selector.Imports => 3
    Selector.VisibleNames {..} => 4
    Selector.Identity {..} => 5
    Selector.Member {..} => 6
    Selector.Name {..} => 7
    Selector.Selection {..} => 8
    Selector.Location {..} => 9
    Selector.Prefix {..} => 10
    Selector.Resolution {..} => 11
    Selector.Request {..} => 12
    Selector.Declaration {facet, ..} => match facet {
      Facet.Alive => 13
      Facet.Identity => 14
      Facet.Arm => 15
      Facet.Import => 16
      Facet.Header => 17
      Facet.Binders => 18
      Facet.Members => 19
      Facet.Operations => 20
      Facet.Parent => 21
      Facet.Body => 22
      Facet.Written => 23
      Facet.Enclosed => 24
      Facet.Directives => 25
    }
  }
}
pub fn record(capture: &mut Capture, selector: &Selector, label: &'static [u8], lookup: u64,
  encoded: u64, hashText: u64, bytes: usize) -> () {
  if !capture.enabled { return () }
  let bucket = &mut List<Bucket>.asMutSlice(&mut capture.buckets)[kind(selector)]
  bucket.label = label
  bucket.count = bucket.count + usize.ONE
  bucket.bytes = bucket.bytes + bytes
  bucket.lookup = bucket.lookup + lookup
  bucket.capture = bucket.capture + encoded
  bucket.hashText = bucket.hashText + hashText
}
pub effect fn report(capture: &Capture) -> () ! OutOfMemoryError ? &mut Allocator {
  let buckets = List<Bucket>.asSlice(&capture.buckets)
  let mut at = usize.ZERO
  while at < buckets.length {
    let bucket = &buckets[at]
    at = at + usize.ONE
    if bucket.count == usize.ZERO { continue }
    let mut label = run Bytes.copy(b"input-capture ")
    run Bytes.append(&mut label, bucket.label)
    run emit(Bytes.asSlice(&label), bucket.capture, bucket.count, bucket.bytes, usize.ZERO)
    Bytes.clear(&mut label)
    run Bytes.append(&mut label, b"input-lookup ")
    run Bytes.append(&mut label, bucket.label)
    run emit(Bytes.asSlice(&label), bucket.lookup, bucket.count, usize.ZERO, usize.ZERO)
    Bytes.clear(&mut label)
    run Bytes.append(&mut label, b"input-hash-text ")
    run Bytes.append(&mut label, bucket.label)
    run emit(Bytes.asSlice(&label), bucket.hashText, bucket.count, bucket.bytes, usize.ZERO)
  }
}

// Visits are diagnostic history, never validity/budget witnesses. They are not rolled back:
// repeat means an immutable row was offered again during this adoption generation.
pub struct Rows {
  pub enabled: bool,
  pub green: List<bool>, pub budget: List<bool>,
  pub greenCalls: usize, pub greenRows: usize, pub greenFirst: usize, pub greenNanos: u64,
  pub budgetCalls: usize, pub budgetRows: usize, pub budgetFirst: usize, pub budgetNanos: u64,
  pub budgetNew: usize, pub directoryNanos: u64, pub directoryBytes: usize,
}
pub effect fn rows(count: usize) -> Rows ! OutOfMemoryError ? &mut Allocator {
  let active = enabled()
  let mut green = List<bool>.make()
  let mut budget = List<bool>.make()
  if active {
    run List<bool>.appendRepeated(&mut green, false, count)
    run List<bool>.appendRepeated(&mut budget, false, count)
  }
  return Rows {enabled: active, green: move green, budget: move budget,
    greenCalls: 0, greenRows: 0, greenFirst: 0, greenNanos: 0,
    budgetCalls: 0, budgetRows: 0, budgetFirst: 0, budgetNanos: 0, budgetNew: 0, directoryNanos: 0, directoryBytes: 0}
}
pub fn visit(rows: &mut Rows, entry: usize, green: bool) -> () {
  if !rows.enabled { return () }
  if green {
    rows.greenRows = rows.greenRows + usize.ONE
    if entry < List<bool>.length(&rows.green) && !List<bool>.get(&rows.green, entry) {
      List<bool>.set(&mut rows.green, entry, true)
      rows.greenFirst = rows.greenFirst + usize.ONE
    }
  } else {
    rows.budgetRows = rows.budgetRows + usize.ONE
    if entry < List<bool>.length(&rows.budget) && !List<bool>.get(&rows.budget, entry) {
      List<bool>.set(&mut rows.budget, entry, true)
      rows.budgetFirst = rows.budgetFirst + usize.ONE
    }
  }
}
