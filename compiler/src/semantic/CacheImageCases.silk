//! A store's cache image holds its clean module checks, reads back under the stamp it was written
//! with, and reads as nothing under any other stamp or when its bytes are damaged.

import semantic.BuildRecord
import semantic.Target {Target as MachineTarget, Id as TargetId}
import semantic.FinalProfile {FinalProfile}
import semantic.ContentHash { ContentHash }
import semantic.CacheImage as CacheImage {Image, Merge, Root}
import semantic.ModuleId {InvalidModulePath, ModuleId}
import semantic.Query { Cycle }
import semantic.Semantic { Request, Semantic }
import semantic.SemanticCaseSupport { makeSemantic, module, present }
import semantic.SourceIndex { RevisionMismatch }
import semantic.SourceRevision { Revision }
import semantic.Types { TypeTable, Types }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.bytes { Bytes }
import silk.core.effect { Effect }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.collections.slice { Slice }
import silk.testing.testing { AssertionError, Testing }
import silk.num.usize

fn library() -> string<'static> {
  return """
pub struct Point {pub x: i32, pub y: i32}
pub fn origin() -> Point {
  return Point { x: 0, y: 0 }
}
"""
}

fn application() -> string<'static> {
  return """
import shape { Point, origin }
fn norm(point: &Point) -> i32 {
  return point.x + point.y
}
pub fn main() -> i32 {
  let first = origin()
  return norm(&first)
}
"""
}

fn otherApplication() -> string<'static> {
  return """
import shape { Point, origin }
fn norm(point: &Point) -> i32 {
  return point.x - point.y
}
pub fn main() -> i32 {
  let first = origin()
  return norm(&first)
}
"""
}

fn broken() -> string<'static> {
  return """
import shape { Point }
fn norm(point: &Point) -> i32 {
  return point.z
}
"""
}

test effect fn cacheImageReadsBackUnderItsStamp() -> ()
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run imageClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn mergedImagesHoldWhatTheyShareOnce() -> ()
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run mergeClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn imageOf(text: string<'static>, cached: bool) -> Image
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
  let app = run module("app.silk")
  let shape = run module("shape.silk")
  let initial = run Revision.publish(&Revision.make(), &app, &run present(text))
  let revision = run Revision.publish(&initial, &shape, &run present(library()))
  let mut store = Semantic.cached(move revision, MachineTarget.forId(TargetId.Aarch64AppleDarwin), Option<FinalProfile>.none())
  if !cached {
    let current = run Revision.publish(&initial, &shape, &run present(library()))
    store = makeSemantic(move current)
  }
  let mut request = Request.make()
  drop run Semantic.checkModule(&mut store, &mut request, &app, &Option<ModuleId>.none())
  drop run Semantic.checkModule(&mut store, &mut request, &shape, &Option<ModuleId>.none())
  return run Semantic.cacheImage(&mut store)
}

effect fn imageClaims() -> ()
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator | &mut Types {
  let image = run imageOf(application(), false)
  // Each module's sweep and escape check is a root, and so is each check of a declaration the
  // sweep covers, beside the roots of its escape walk's record.
  run Testing.expect(checkRoots(&image) == 9, "both clean modules' checks are roots")
  run Testing.expect(CacheImage.nodeCount(&image) > 4 && CacheImage.leafCount(&image) > usize.ZERO,
    "the roots rest on units and source reads")

  let written = run CacheImage.encode(&image, b"silk 1.0")
  let mut read = match move run CacheImage.decode(Bytes.asSlice(&written), b"silk 1.0") {
    Option<Image>.Some {value} => move value
    Option<Image>.None => {
      run Testing.expect(false, "an image reads back under its own stamp")
      return ()
    }
  }
  let again = run CacheImage.encode(&read, b"silk 1.0")
  run Testing.expect(same(Bytes.asSlice(&written), Bytes.asSlice(&again)), "an image read back writes the same bytes")

  // A decoded image holds only its anchors until its leaves are read: each leaf every adoption
  // places, with its key, at its own index.
  let leaves = CacheImage.leaves(&image)
  run Testing.expect(!CacheImage.leavesRead(&read) && CacheImage.leafCount(&read) == leaves.length, "a decoded image reads its leaves on demand")
  let anchors = CacheImage.anchors(&read)
  let mut placedAlways = usize.ZERO
  let mut leafAt = usize.ZERO
  while leafAt < leaves.length {
    if CacheImage.alwaysPlaced(&leaves[leafAt]) { placedAlways = placedAlways + usize.ONE }
    leafAt = leafAt + usize.ONE
  }
  run Testing.expect(anchors.length == placedAlways && anchors.length > usize.ZERO, "the summary holds each leaf every adoption places")
  let mut anchorAt = usize.ZERO
  while anchorAt < anchors.length {
    let at = anchors[anchorAt].at
    run Testing.expect(same(CacheImage.anchorKey(&anchors[anchorAt]), CacheImage.key(&image, at))
      && ContentHash.equals(anchors[anchorAt].leaf.digest, leaves[at].digest) && anchors[anchorAt].leaf.file == leaves[at].file,
      "an anchor is the leaf at its index")
    anchorAt = anchorAt + usize.ONE
  }
  run Testing.expect(run CacheImage.readLeaves(&mut read), "a decoded image's leaves read")
  // Each packed key reads back whatever order the leaves are read in, past the keys written whole
  // too, and each leaf keeps what kind of input it is.
  let readLeaves = CacheImage.leaves(&read)
  run Testing.expect(leaves.length > 16 && readLeaves.length == leaves.length, "the image holds leaves past its first whole key")
  let mut keys = CacheImage.keyCursor()
  let mut back = leaves.length
  while back > usize.ZERO {
    back = back - usize.ONE
    let at = (back * 7) % leaves.length
    run Testing.expect(same(run CacheImage.keyAt(&read, &mut keys, at), CacheImage.key(&image, at)), "a packed key reads back")
    run Testing.expect(readLeaves[at].selector == leaves[at].selector, "a leaf keeps its kind of input")
  }

  // Each escape walk's record reads back and writes the same bytes.
  let prefix = b"silk.escape.record"
  let mut records = usize.ZERO
  let mut rooted = usize.ZERO
  while rooted < List<Root>.length(&image.roots) {
    let root = &List<Root>.asSlice(&image.roots)[rooted]
    rooted = rooted + usize.ONE
    let key = Bytes.asSlice(&root.key)
    if key.length < 8 + prefix.length || !same(Slice.view<u8>(key, 8, prefix.length), prefix) { continue }
    records = records + usize.ONE
    let decoded = run BuildRecord.decode(Bytes.asSlice(&root.answer))
    if let Option<BuildRecord.Record>.Some {value: record} = &decoded {
      let rewritten = run BuildRecord.encode(&record)
      run Testing.expect(same(Bytes.asSlice(&rewritten), Bytes.asSlice(&root.answer)), "a record read back writes the same bytes")
      run Testing.expect(List<BuildRecord.Entry>.length(&record.entries) > usize.ZERO, "a record holds its walk's entries")
    } else {
      run Testing.expect(false, "a record reads back")
    }
  }
  run Testing.expect(records > usize.ZERO, "the escape walks are recorded")

  let upgraded = run CacheImage.decode(Bytes.asSlice(&written), b"silk 1.1")
  run Testing.expect(isNone(&upgraded), "another compiler's image reads as nothing")
  let cut = run CacheImage.decode(Slice.view<u8>(Bytes.asSlice(&written), usize.ZERO, Bytes.length(&written) - usize.ONE), b"silk 1.0")
  run Testing.expect(isNone(&cut), "a truncated image reads as nothing")
  let mut padded = run Bytes.copy(Bytes.asSlice(&written))
  run Bytes.append(&mut padded, b"x")
  let extra = run CacheImage.decode(Bytes.asSlice(&padded), b"silk 1.0")
  run Testing.expect(isNone(&extra), "an image with trailing bytes reads as nothing")

  // A module whose check reports a rejection keeps its sweep, which holds the rejection; the check
  // of the declaration that reports it is left out, and the clean module's checks stay.
  let rejected = run imageOf(broken(), false)
  let kept = checkRoots(&rejected)
  run Testing.expect(kept == 7, "the rejected module's sweep and the clean module's checks stay")

  // Each image's graph and roots files join each other's only.
  let files = run CacheImage.encodeFiles(&image, b"silk 1.0")
  let others = run CacheImage.encodeFiles(&rejected, b"silk 1.0")
  let paired = run joinedFiles(Bytes.asSlice(&files.graph), Bytes.asSlice(&files.roots))
  run Testing.expect(!isNone(&paired), "an image's two files join")
  let mixed = run joinedFiles(Bytes.asSlice(&files.graph), Bytes.asSlice(&others.roots))
  run Testing.expect(isNone(&mixed), "a graph file beside another image's roots reads as nothing")
  return ()
}

effect fn joinedFiles(graph: &[u8], roots: &[u8]) -> Option<Image> ! OutOfMemoryError ? &mut Allocator {
  let read = match move run CacheImage.decodeGraph(graph, b"silk 1.0") {
    Option<CacheImage.Graph>.Some {value} => move value
    Option<CacheImage.Graph>.None => { return Option<Image>.none() }
  }
  return match move run CacheImage.decodeRoots(roots, b"silk 1.0") {
    Option<CacheImage.Roots>.Some {value} => CacheImage.joined(move read, move value)
    Option<CacheImage.Roots>.None => Option<Image>.none()
  }
}

fn isNone(value: &Option<Image>) -> bool {
  return match &value.* {
    Option<Image>.Some {..} => false
    Option<Image>.None => true
  }
}

effect fn mergeClaims() -> ()
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator | &mut Types {
  let image = run imageOf(application(), false)
  let every = run allRoots(&image)
  let mut twice = Merge.make()
  run Merge.add(&mut twice, &image, List<usize>.asSlice(&every))
  run Merge.add(&mut twice, &image, List<usize>.asSlice(&every))
  let merged = Merge.finish(move twice)
  run Testing.expect(List<Root>.length(&merged.roots) == List<Root>.length(&image.roots), "an image merged twice holds each root once")
  run Testing.expect(CacheImage.nodeCount(&merged) <= CacheImage.nodeCount(&image), "an image merged twice holds each node once")
  run Testing.expect(CacheImage.leafCount(&merged) <= CacheImage.leafCount(&image),
    "an image merged twice holds each leaf once")
  // Another program's image names the same checks: each key is held once, as the first image
  // gave it, since that image verified it against the same sources.
  let other = run imageOf(otherApplication(), false)
  let otherRoots = run allRoots(&other)
  let mut both = Merge.make()
  run Merge.add(&mut both, &image, List<usize>.asSlice(&every))
  run Merge.add(&mut both, &other, List<usize>.asSlice(&otherRoots))
  let joinedImage = Merge.finish(move both)
  let joined = List<Root>.length(&joinedImage.roots)
  run Testing.expect(joined == List<Root>.length(&image.roots), "a key another image gave is held once")
  let mut kept = usize.ZERO
  while kept < joined {
    let first = &List<Root>.asSlice(&image.roots)[kept]
    let held = &List<Root>.asSlice(&joinedImage.roots)[kept]
    run Testing.expect(same(Bytes.asSlice(&first.answer), Bytes.asSlice(&held.answer)), "the first image's answer is kept")
    kept = kept + usize.ONE
  }
  // Each merged root rests on a node of the merged image.
  let mut at = usize.ZERO
  while at < joined {
    run Testing.expect(List<Root>.asSlice(&joinedImage.roots)[at].node < CacheImage.nodeCount(&joinedImage), "a merged root names a merged node")
    at = at + usize.ONE
  }
}

effect fn allRoots(image: &Image) -> List<usize> ! OutOfMemoryError ? &mut Allocator {
  let mut roots = List<usize>.make()
  let mut at = usize.ZERO
  while at < List<Root>.length(&image.roots) {
    run List<usize>.append(&mut roots, at)
    at = at + usize.ONE
  }
  return move roots
}

/// The roots that are module checks: every root but those an escape walk's record keeps, whose
/// keys start with a field naming the record.
fn checkRoots(image: &Image) -> usize {
  let prefix = b"silk.escape."
  let mut count = usize.ZERO
  let mut at = usize.ZERO
  while at < List<Root>.length(&image.roots) {
    let key = Bytes.asSlice(&List<Root>.asSlice(&image.roots)[at].key)
    let named = key.length >= 8 + prefix.length && same(Slice.view<u8>(key, 8, prefix.length), prefix)
    if !named {
      count = count + usize.ONE
    }
    at = at + usize.ONE
  }
  return count
}

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

// Command-line caches retain the same evidence and diagnostics as editor stores, even though
// they do not retain the fingerprints used to validate a later in-process edit.
effect fn cachedImageClaims() -> ()
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator | &mut Types {
  let valid = run imageOf(application(), true)
  let revisable = run imageOf(application(), false)
  let written = run CacheImage.encode(&valid, b"cache-mode")
  let expected = run CacheImage.encode(&revisable, b"cache-mode")
  run Testing.expect(same(Bytes.asSlice(&written), Bytes.asSlice(&expected)), "a cached check persists the same source and query evidence")
  let invalid = run imageOf(broken(), true)
  let invalidRevisable = run imageOf(broken(), false)
  let rejected = run CacheImage.encode(&invalid, b"cache-mode")
  let expectedRejected = run CacheImage.encode(&invalidRevisable, b"cache-mode")
  run Testing.expect(same(Bytes.asSlice(&rejected), Bytes.asSlice(&expectedRejected)), "a cached rejection persists the same diagnostic evidence")
}

test effect fn cachedImagesMatchRevisableImages() -> ()
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run cachedImageClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}


// A direct-call position belongs to the entry's reference list, not to the remaining byte stream.
effect fn finalCalleeIndexClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut record = BuildRecord.make(false, false)
  let root = ContentHash {high: 1, low: 2}
  run List<ContentHash>.append(&mut record.roots, root)
  let mut references = List<BuildRecord.Reference>.make()
  let mut at = usize.ZERO
  while at < 41 {
    run List<BuildRecord.Reference>.append(&mut references, BuildRecord.Reference {target: 0, edge: ContentHash {high: 0, low: 0}})
    at = at + usize.ONE
  }
  let mut facts = BuildRecord.unknownFacts()
  facts.flags = BuildRecord.FACT_KNOWN + BuildRecord.FACT_CALLEES
  facts.definition = root
  run List<usize>.append(&mut facts.callees, 40)
  run List<BuildRecord.Entry>.append(&mut record.entries, BuildRecord.Entry {exact: root, hash: 1, family: 0,
    declaration: Bytes.make(), parent: usize.MAX, position: 0, requested: false, alias: usize.MAX, leaf: 0,
    references: move references, summary: ContentHash {high: 0, low: 0}, facts: move facts})
  let written = run BuildRecord.encode(&record)
  if let Option<BuildRecord.Record>.Some {value} = move run BuildRecord.decode(Bytes.asSlice(&written)) {
    let entry = &List<BuildRecord.Entry>.asSlice(&value.entries)[0]
    run Testing.expect(List<usize>.length(&entry.facts.callees) == 1 && List<usize>.get(&entry.facts.callees, 0) == 40,
      "a final entry preserves a direct call near the end of its reference list")
  } else { run Testing.expect(false, "the final direct call must round trip") }
  let invalid = List<BuildRecord.Entry>.asMutSlice(&mut record.entries)
  List<usize>.set(&mut invalid[0].facts.callees, 0, 41)
  let malformed = run BuildRecord.encode(&record)
  let decoded = run BuildRecord.decode(Bytes.asSlice(&malformed))
  run Testing.expect(match &decoded { Option<BuildRecord.Record>.None => true _ => false },
    "an out-of-range direct-call reference is rejected")
}

test effect fn buildRecordFinalCalleeIndexRoundTrips() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run finalCalleeIndexClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}
