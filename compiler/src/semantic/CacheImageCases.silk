//! A store's cache image holds its clean module checks, reads back under the stamp it was written
//! with, and reads as nothing under any other stamp or when its bytes are damaged.

import semantic.BuildRecord
import semantic.CacheImage as CacheImage {Image, Root}
import semantic.ModuleId {InvalidModulePath, ModuleId}
import semantic.Query { Cycle }
import semantic.Semantic { Request, Semantic }
import semantic.SemanticCaseSupport { makeSemantic, module, present }
import semantic.SourceIndex { RevisionMismatch }
import semantic.SourceRevision { Revision }
import semantic.Types { TypeTable, Types }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.bytes { Bytes }
import silk.core.effect { Effect }
import silk.collections.list { List }
import silk.option { Option }
import silk.collections.slice { Slice }
import silk.testing.testing { AssertionError, Testing }
import silk.num.usize

fn library() -> string<'static> {
  return """
pub struct Point {pub x: i32, pub y: i32}
pub fn origin() -> Point {
  return Point { x: 0, y: 0 }
}
"""
}

fn application() -> string<'static> {
  return """
import shape { Point, origin }
fn norm(point: &Point) -> i32 {
  return point.x + point.y
}
pub fn main() -> i32 {
  let first = origin()
  return norm(&first)
}
"""
}

fn broken() -> string<'static> {
  return """
import shape { Point }
fn norm(point: &Point) -> i32 {
  return point.z
}
"""
}

test effect fn cacheImageReadsBackUnderItsStamp() -> ()
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run imageClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn imageOf(text: string<'static>) -> Image
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
  let app = run module("app.silk")
  let shape = run module("shape.silk")
  let initial = run Revision.publish(&Revision.make(), &app, &run present(text))
  let revision = run Revision.publish(&initial, &shape, &run present(library()))
  let mut store = makeSemantic(move revision)
  let mut request = Request.make()
  drop run Semantic.checkModule(&mut store, &mut request, &app, &Option<ModuleId>.none())
  drop run Semantic.checkModule(&mut store, &mut request, &shape, &Option<ModuleId>.none())
  return run Semantic.cacheImage(&mut store)
}

effect fn imageClaims() -> ()
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator | &mut Types {
  let image = run imageOf(application())
  // Each module's sweep and escape check is a root, and so is each check of a declaration the
  // sweep covers, beside the roots of its escape walk's record.
  run Testing.expect(checkRoots(&image) == 9, "both clean modules' checks are roots")
  run Testing.expect(CacheImage.nodeCount(&image) > 4 && List<CacheImage.Leaf>.length(&image.leaves) > usize.ZERO,
    "the roots rest on units and source reads")

  let written = run CacheImage.encode(&image, b"silk 1.0")
  let read = match move run CacheImage.decode(Bytes.asSlice(&written), b"silk 1.0") {
    Option<Image>.Some {value} => move value
    Option<Image>.None => {
      run Testing.expect(false, "an image reads back under its own stamp")
      return ()
    }
  }
  let again = run CacheImage.encode(&read, b"silk 1.0")
  run Testing.expect(same(Bytes.asSlice(&written), Bytes.asSlice(&again)), "an image read back writes the same bytes")

  // Each escape walk's record reads back and writes the same bytes.
  let prefix = b"silk.escape.record"
  let mut records = usize.ZERO
  let mut rooted = usize.ZERO
  while rooted < List<Root>.length(&image.roots) {
    let root = &List<Root>.asSlice(&image.roots)[rooted]
    rooted = rooted + usize.ONE
    let key = Bytes.asSlice(&root.key)
    if key.length < 8 + prefix.length || !same(Slice.view<u8>(key, 8, prefix.length), prefix) { continue }
    records = records + usize.ONE
    let decoded = run BuildRecord.decode(Bytes.asSlice(&root.answer))
    if let Option<BuildRecord.Record>.Some {value: record} = &decoded {
      let rewritten = run BuildRecord.encode(&record)
      run Testing.expect(same(Bytes.asSlice(&rewritten), Bytes.asSlice(&root.answer)), "a record read back writes the same bytes")
      run Testing.expect(List<BuildRecord.Entry>.length(&record.entries) > usize.ZERO, "a record holds its walk's entries")
    } else {
      run Testing.expect(false, "a record reads back")
    }
  }
  run Testing.expect(records > usize.ZERO, "the escape walks are recorded")

  let upgraded = run CacheImage.decode(Bytes.asSlice(&written), b"silk 1.1")
  run Testing.expect(isNone(&upgraded), "another compiler's image reads as nothing")
  let cut = run CacheImage.decode(Slice.view<u8>(Bytes.asSlice(&written), usize.ZERO, Bytes.length(&written) - usize.ONE), b"silk 1.0")
  run Testing.expect(isNone(&cut), "a truncated image reads as nothing")
  let mut padded = run Bytes.copy(Bytes.asSlice(&written))
  run Bytes.append(&mut padded, b"x")
  let extra = run CacheImage.decode(Bytes.asSlice(&padded), b"silk 1.0")
  run Testing.expect(isNone(&extra), "an image with trailing bytes reads as nothing")

  // A module whose check reports a rejection keeps its sweep, which holds the rejection; the check
  // of the declaration that reports it is left out, and the clean module's checks stay.
  let rejected = run imageOf(broken())
  let kept = checkRoots(&rejected)
  run Testing.expect(kept == 7, "the rejected module's sweep and the clean module's checks stay")
  return ()
}

fn isNone(value: &Option<Image>) -> bool {
  return match &value.* {
    Option<Image>.Some {..} => false
    Option<Image>.None => true
  }
}

/// The roots that are module checks: every root but those an escape walk's record keeps, whose
/// keys start with a field naming the record.
fn checkRoots(image: &Image) -> usize {
  let prefix = b"silk.escape."
  let mut count = usize.ZERO
  let mut at = usize.ZERO
  while at < List<Root>.length(&image.roots) {
    let key = Bytes.asSlice(&List<Root>.asSlice(&image.roots)[at].key)
    let named = key.length >= 8 + prefix.length && same(Slice.view<u8>(key, 8, prefix.length), prefix)
    if !named {
      count = count + usize.ONE
    }
    at = at + usize.ONE
  }
  return count
}

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}
