//! The sealed storage primitives over the core storage types.
//!
//! # When to use
//! Use [`StorageOperation`] after the semantic resolver authenticates the sealed `Intrinsic`
//! namespace. Each operation's contract follows the bootstrap catalog and the standard library that
//! calls it; body checking instantiates it from the call's type arguments.
//!
//! # Details
//! The primitives expand to ordinary MIR. Raw-buffer and slot contents stay owned by library code:
//! no primitive discovers or drops initialized elements except `slotDrop` on its one selection.

import silk.option {Option}
import silk.usize

/// One sealed storage primitive.
pub enum StorageOperation {
  /// `rawBufferFrom<T>(allocation: Allocation, count: usize) -> RawBuffer<T>`, unsafe.
  RawBufferFrom,
  /// `rawBufferSlot<T>(buffer: &'a mut RawBuffer<T>, index: usize) -> Slot<'a, T>`, unsafe.
  RawBufferSlot,
  /// `rawBufferCount<T>(buffer: &RawBuffer<T>) -> usize`.
  RawBufferCount,
  /// `rawBufferRead<T: Copy>(buffer: &RawBuffer<T>, index: usize) -> T`, unsafe.
  RawBufferRead,
  /// `rawBufferCopy<T>(destination: &mut RawBuffer<T>, offset: usize, source: &[T], length: usize)`,
  /// unsafe; the ranges may overlap.
  RawBufferCopy,
  /// `rawBufferFill(buffer: &mut RawBuffer<u8>, offset: usize, length: usize, value: u8)`, unsafe.
  RawBufferFill,
  /// `rawBufferView<T>(buffer: &'a RawBuffer<T>, offset: usize, length: usize) -> &'a [T]`, unsafe.
  RawBufferView,
  /// `rawBufferViewMut<T>(buffer: &'a mut RawBuffer<T>, offset: usize, length: usize) -> &'a mut [T]`,
  /// unsafe.
  RawBufferViewMut,
  /// `slotWrite<T>(slot: Slot<T>, value: T) -> ()`, unsafe.
  SlotWrite,
  /// `slotTake<T>(slot: Slot<T>) -> T`, unsafe.
  SlotTake,
  /// `slotDrop<T>(slot: Slot<T>) -> ()`, unsafe.
  SlotDrop,
  /// `slotCopy<T: Copy>(slot: Slot<T>) -> T`, unsafe.
  SlotCopy,
  /// `slotAddress<T>(slot: Slot<T>) -> *mut T`.
  SlotAddress,
  /// `sharedLayout<T>() -> Layout`: the control block's size and alignment.
  SharedLayout,
  /// `sharedFromAllocation<T>(allocation: Allocation, value: T) -> SharedCore<T>`, unsafe.
  SharedFromAllocation,
  /// `sharedClone<T>(self: &SharedCore<T>) -> SharedCore<T>`.
  SharedClone,
  /// `sharedWithMut<T, A>(self: &SharedCore<T>, use: once fn(&mut T) -> A, onConflict: once fn() -> A) -> A`.
  SharedWithMut,
  /// `layoutOf<T>() -> Layout`: the size and alignment of one `T`.
  LayoutOf,
  /// `systemAllocationAcquire(layout: Layout) -> Effect<Allocation ! Intrinsic.StorageFailure>`.
  SystemAllocationAcquire,
  /// `stringUtf8Bytes(value: string<'a>) -> &'a [u8]`.
  StringUtf8Bytes,
  /// `stringFromUtf8Unchecked(bytes: &'a [u8]) -> string<'a>`, unsafe.
  StringFromUtf8Unchecked,
  /// `stringByteLength(value: string) -> usize`.
  StringByteLength,
  /// `replace<T>(place: T, value: T) -> T`: the displaced value of a mutable place.
  Replace,
}

fn operations() -> [StorageOperation; 23] {
  return [
    StorageOperation.RawBufferFrom, StorageOperation.RawBufferSlot, StorageOperation.RawBufferCount,
    StorageOperation.RawBufferRead, StorageOperation.RawBufferCopy, StorageOperation.RawBufferFill,
    StorageOperation.RawBufferView, StorageOperation.RawBufferViewMut, StorageOperation.SlotWrite,
    StorageOperation.SlotTake, StorageOperation.SlotDrop, StorageOperation.SlotCopy, StorageOperation.SlotAddress,
    StorageOperation.SharedLayout, StorageOperation.SharedFromAllocation, StorageOperation.SharedClone,
    StorageOperation.SharedWithMut, StorageOperation.LayoutOf, StorageOperation.SystemAllocationAcquire,
    StorageOperation.StringUtf8Bytes, StorageOperation.StringFromUtf8Unchecked, StorageOperation.StringByteLength,
    StorageOperation.Replace,
  ]
}

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

impl StorageOperation {
  /// The canonical member spelling.
  pub fn spelling(operation: StorageOperation) -> &'static [u8] {
    return match operation {
      StorageOperation.RawBufferFrom => b"rawBufferFrom"
      StorageOperation.RawBufferSlot => b"rawBufferSlot"
      StorageOperation.RawBufferCount => b"rawBufferCount"
      StorageOperation.RawBufferRead => b"rawBufferRead"
      StorageOperation.RawBufferCopy => b"rawBufferCopy"
      StorageOperation.RawBufferFill => b"rawBufferFill"
      StorageOperation.RawBufferView => b"rawBufferView"
      StorageOperation.RawBufferViewMut => b"rawBufferViewMut"
      StorageOperation.SlotWrite => b"slotWrite"
      StorageOperation.SlotTake => b"slotTake"
      StorageOperation.SlotDrop => b"slotDrop"
      StorageOperation.SlotCopy => b"slotCopy"
      StorageOperation.SlotAddress => b"slotAddress"
      StorageOperation.SharedLayout => b"sharedLayout"
      StorageOperation.SharedFromAllocation => b"sharedFromAllocation"
      StorageOperation.SharedClone => b"sharedClone"
      StorageOperation.SharedWithMut => b"sharedWithMut"
      StorageOperation.LayoutOf => b"layoutOf"
      StorageOperation.SystemAllocationAcquire => b"systemAllocationAcquire"
      StorageOperation.StringUtf8Bytes => b"stringUtf8Bytes"
      StorageOperation.StringFromUtf8Unchecked => b"stringFromUtf8Unchecked"
      StorageOperation.StringByteLength => b"stringByteLength"
      StorageOperation.Replace => b"replace"
    }
  }

  /// Selects the storage primitive a sealed member spelling names.
  pub fn lookup(name: &[u8]) -> Option<StorageOperation> {
    let table = operations()
    let listed: &[StorageOperation] = &table
    let mut at = usize.ZERO
    while at < listed.length {
      if same(name, StorageOperation.spelling(listed[at])) {
        return Option.some<StorageOperation>(listed[at])
      }
      at = at + usize.ONE
    }
    return Option.none<StorageOperation>()
  }

  /// The exact number of written value arguments.
  pub fn arity(operation: StorageOperation) -> usize {
    return match operation {
      StorageOperation.RawBufferFrom => 2
      StorageOperation.RawBufferSlot => 2
      StorageOperation.RawBufferCount => usize.ONE
      StorageOperation.RawBufferRead => 2
      StorageOperation.RawBufferCopy => 4
      StorageOperation.RawBufferFill => 4
      StorageOperation.RawBufferView => 3
      StorageOperation.RawBufferViewMut => 3
      StorageOperation.SlotWrite => 2
      StorageOperation.SlotTake => usize.ONE
      StorageOperation.SlotDrop => usize.ONE
      StorageOperation.SlotCopy => usize.ONE
      StorageOperation.SlotAddress => usize.ONE
      StorageOperation.SharedLayout => usize.ZERO
      StorageOperation.SharedFromAllocation => 2
      StorageOperation.SharedClone => usize.ONE
      StorageOperation.SharedWithMut => 3
      StorageOperation.LayoutOf => usize.ZERO
      StorageOperation.SystemAllocationAcquire => usize.ONE
      StorageOperation.StringUtf8Bytes => usize.ONE
      StorageOperation.StringFromUtf8Unchecked => usize.ONE
      StorageOperation.StringByteLength => usize.ONE
      StorageOperation.Replace => 2
    }
  }

  /// The number of written type arguments. `replace` takes its type from its place, so its one
  /// type argument may be omitted.
  pub fn typeArity(operation: StorageOperation) -> usize {
    return match operation {
      StorageOperation.RawBufferFill => usize.ZERO
      StorageOperation.SharedWithMut => 2
      StorageOperation.SystemAllocationAcquire => usize.ZERO
      StorageOperation.StringUtf8Bytes => usize.ZERO
      StorageOperation.StringFromUtf8Unchecked => usize.ZERO
      StorageOperation.StringByteLength => usize.ZERO
      _ => usize.ONE
    }
  }

  /// Whether invoking the primitive requires an unsafe acknowledgement.
  pub fn isUnsafe(operation: StorageOperation) -> bool {
    return match operation {
      StorageOperation.RawBufferCount => false
      StorageOperation.SlotAddress => false
      StorageOperation.SharedLayout => false
      StorageOperation.SharedClone => false
      StorageOperation.SharedWithMut => false
      StorageOperation.LayoutOf => false
      StorageOperation.SystemAllocationAcquire => false
      StorageOperation.StringUtf8Bytes => false
      StorageOperation.StringByteLength => false
      StorageOperation.Replace => false
      _ => true
    }
  }

  /// Whether the target's layout of the call's type arguments is part of the expansion: element
  /// sizes and alignments, or a control block's.
  pub fn measures(operation: StorageOperation) -> bool {
    return operation == StorageOperation.RawBufferFrom || operation == StorageOperation.RawBufferCopy
      || operation == StorageOperation.SharedLayout || operation == StorageOperation.SharedFromAllocation
      || operation == StorageOperation.LayoutOf
  }
}
