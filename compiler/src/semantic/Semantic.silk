        &mut owner.*,
        &mut dependencies.*,
        module,
        caller,
        annotation,
        span,
        &inference,
        constraints,
      )
      let recordType = match move resolvedRecord {
        Result<Shared<Type>, Shared<Rejection>>.Success {value} => move value
        Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
          return Result.failResult<BodyNodeId, Shared<Rejection>>(move error)
        }
      }
      let checkedFields = run checkRecordFields(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
        module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*,
        &recordType, &inference, fields, constraints, contractBody, unsafeAllowed, span)
      let completed = match move checkedFields {
        Result<CheckedRecordFields, Shared<Rejection>>.Success {value} => value
        Result<CheckedRecordFields, Shared<Rejection>>.Failure {error} => {
          return Result.failResult<BodyNodeId, Shared<Rejection>>(move error)
        }
      }
      // The completed literal meets its expectation at the ordinary expected-value boundary.
