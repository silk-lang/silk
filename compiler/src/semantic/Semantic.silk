  declaration: Option<usize>
  rejected: Option<Shared<Rejection>>
}

struct SelectedDeclaration {
  module: usize
  ordinal: usize
}

// Written slots retain their authentic owner when a member opens enclosing binders.
union CallPrefixSlot {
  Type {value: Shared<Type>},
  Lifetime {value: Shared<Lifetime>},
  Row {value: RowParameter},
}

struct CallTarget {
  foreign: bool
  declaration: DeclarationId
  isPublic: bool
  signature: Shared<Result<Answer, NoRejection>>
  explicit: Vector<Argument>
  // The authentic binder each argument fixes; unwritten leading lifetimes are inferred.
  explicitSlots: Vector<CallPrefixSlot>
  prefixOwner: Option<Shared<DeclarationId>>
  prefixLifetimes: usize
  scopeArguments: Vector<Argument>
  inferOwner: bool
  explicitSyntax: bool
}

