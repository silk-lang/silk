//! Lazy name, import, type, signature, constant, and ordinary scalar body queries.
//!
//! # When to use
//! Use [`Semantic`] with one held source revision. Demand one written fact at a time.
//! The store reads an import target only when a requested fact needs its binding.

import hir.Hir {
  Access,
  CallableMode,
  HirId,
  HirRef,
  Module,
  Node,
  OwnerKind,
  ParameterMode,
  Range,
  RangeRef,
  Sign,
}
import hir.Fingerprint
import lexer.Span {Span}
import semantic.DeclarationId {DeclarationId}
import semantic.Lifetime {Intersection, Lifetime}
import semantic.ModuleId {InvalidModulePath, ModuleId}
import semantic.ModuleIndex {CandidateKind, IndexedDeclaration, ModuleIndex, NameObservation}
import semantic.Query {Cycle, Query}
import semantic.Rejection {GenericKind, Rejection, RejectionCode}
import semantic.SourceIndex {
  Event as SourceEvent,
  IndexedSource,
  NoRejection,
  RevisionMismatch,
  SourceIndex,
  SourceResult,
}
import semantic.SourceRevision {Observation, Revision}
import semantic.Type {Argument, Outlives, Requirement, Row, RowParameter, Type}
import semantic.TypedBody {
  Expression as BodyExpression,
  Local as BodyLocal,
  LocalId as BodyLocalId,
  Node as BodyNode,
  NodeId as BodyNodeId,
  NodeKind as BodyNodeKind,
  Origin as BodyOrigin,
  SignatureDependency,
  TypedBody,
}
import silk.allocator {Allocator, OutOfMemoryError}
import silk.bytes {Bytes}
import silk.effect {Effect}
import silk.hash {Hash, Word}
import silk.option {Option}
import silk.pointer {Pointer}
import silk.result {Result}
import silk.shared {Shared}
import silk.u8
import silk.usize
import silk.u64
import silk.vector {Vector}

/// The semantic fact selected by a query key.
pub enum Family {
  /// All candidates for one written name.
  Name,
  /// One imported namespace or selected member.
  Import,
  /// The target of a type alias.
  Alias,
  /// A nominal declaration's identity.
  Identity,
  /// The ordered names or positions declared by one nominal aggregate.
  Members,
  /// The written types of one requested field, position, or variant payload.
  MemberShape,
  /// The binders and declared bounds of a type, alias, interface, or service declaration.
  Contract,
  /// The ordered operation declarations of an interface or service.
  Operations,
  /// The resolved heads of every `impl` declaration in one module.
  Implementations,
  /// The resolved head of one `impl` declaration.
  ImplementationHead,
  /// The published inherent members of one nominal owner across its module's inherent `impl`s.
  InherentMembers,
  /// The types written on a function header.
  Signature,
  /// The written type of a constant declaration, independent of its initializer.
  Constant,
  /// The value of a constant initializer that needs no static execution.
  Initializer,
  /// One checked ordinary function body.
  Body,
}

/// A function contract resolved from its written header, including binders, bounds, and channels.
///
/// # Details
///
/// The contract describes what callers may rely on. Bounds are recorded, not proved; channels are
/// declared upper bounds, not facts derived from the body.
pub struct Signature {
  /// The declaration-owned ordinary type parameters in written order.
  pub typeParameters: Vector<Shared<Type>>
  /// The declaration-owned written and elided lifetime parameters.
  pub lifetimeParameters: Vector<Shared<Lifetime>>
  /// The declaration-owned `?R` requirement-row parameters in written order.
  pub rowParameters: Vector<RowParameter>
  /// The declared binder bounds in written order.
  pub constraints: Vector<Constraint>
  /// The parameter types in written order.
  pub parameters: Vector<Shared<Type>>
  /// The written result type, or unit when omitted. For `effect fn`, the Effect's success type.
  pub result: Shared<Type>
  /// The declared failure type; `never` when omitted.
  pub failure: Shared<Type>
  /// The declared requirement row; empty when omitted.
  pub requirements: Shared<Row>
  /// Whether `effect` was written, so calling constructs an Effect with these channels.
  pub isEffect: bool
  /// Whether `unsafe` was written, so a complete invocation needs an `unsafe` acknowledgement.
  pub isUnsafe: bool
  /// The environment of the Effect constructed by calling an `effect fn`. It is either written, or
  /// elaborated from the captured inputs as the intersection of the regions they retain (`'static`
  /// when they retain none). An `effect fn` whose omitted environment would retain generic stored
  /// contents is rejected, so an `effect fn` always has one. `None` means an ordinary function.
  pub environment: Option<Intersection>
}

/// The binders and bounds declared by a type, alias, interface, or service declaration.
///
/// # Details
///
/// The contract records what every application must satisfy. It proves nothing about a particular
/// application; applying a bounded declaration is rejected until conformance solving exists.
pub struct Contract {
  /// The declaration-owned ordinary type parameters in written order.
  pub typeParameters: Vector<Shared<Type>>
  /// The declaration-owned lifetime parameters in written order.
  pub lifetimeParameters: Vector<Shared<Lifetime>>
  /// The declaration-owned `?R` requirement-row parameters in written order.
  pub rowParameters: Vector<RowParameter>
  /// The declared binder bounds in written order.
  pub constraints: Vector<Constraint>
  /// The implicit `Self` provider of an interface or service, bound after the written binders;
  /// absent for every other declaration.
  pub provider: Option<Shared<Type>>
}

/// One declared generic bound. It states a requirement; it does not select or prove a conformance.
pub union Constraint {
  /// `T: Contract<Arguments>` requires the provider to conform to an interface or service.
  Conforms {pub provider: Shared<Type>, pub contract: Shared<Type>},
  /// `F: fn(A) -> B` or `F: once Effect<A>` binds one exact executable representation that
  /// satisfies the callable or Effect use contract.
  Represents {pub parameter: Shared<Type>, pub contract: Shared<Type>},
  /// `T: 'region` requires the borrowed contents of `T` to remain valid for the region.
  Contents {pub subject: Shared<Type>, pub region: Shared<Lifetime>},
  /// `'longer: 'shorter` requires the first lifetime to cover the second.
  Outlives {pub longer: Shared<Lifetime>, pub shorter: Shared<Lifetime>},
  /// `T: Copy` requires the compiler-sealed Copy property, which no ordinary interface supplies.
  Copyable {pub subject: Shared<Type>},
}

/// A compiler-sealed language property an `impl` may request. It is not an ordinary interface:
/// eligibility is checked by the language, and users cannot supply its behavior.
pub enum SealedProperty {
  /// Duplication without running user code.
  Copy,
  /// One restricted automatic cleanup hook.
  Drop,
}


/// What one `impl` declaration implements.
pub union ImplementationKind {
  /// `impl Owner { ... }` declares inherent members of one nominal owner.
  Inherent,
  /// `impl Contract for Provider` conforms the provider to the head's interface or service.
  Conformance,
  /// `impl Copy for Provider` or `impl Drop for Provider` requests a sealed property.
  Sealed {pub property: SealedProperty},
}

/// An inherent member that is not published, with the anchored reason.
pub struct RejectedMember {
  /// The rejected member declaration.
  pub declaration: Shared<DeclarationId>
  /// Why the member is not an associated item of its owner.
  pub rejection: Shared<Rejection>
}

/// The resolved head of one `impl` declaration, without its members.
///
/// # Details
///
/// The binders are the written `impl` binders followed by lifetimes elided from its heads, with
/// the written bounds recorded, not proved. The provider is what `Self` denotes inside the
/// implementation; its nominal declaration, or its foundational scalar or `string` spelling, is
/// the provider owner. A head claims only that its declaration is well formed and permitted in its
/// module; it proves no conformance and checks no member.
pub struct ImplementationHead {
  /// The `impl` declaration.
  pub declaration: Shared<DeclarationId>
  /// Whether it is inherent, a conformance, or a sealed property.
  pub kind: ImplementationKind
  /// The implementation's binders and bounds.
  pub binders: Contract
  /// The applied interface or service of a conformance; absent otherwise.
  pub contract: Option<Shared<Type>>
  /// The applied provider or inherent owner.
  pub provider: Shared<Type>
}

/// One declared nominal member; tuple positions have no written name.
pub struct Member {
  pub name: Option<Bytes>
  pub isPublic: bool
  pub kind: MemberKind
}

/// The source form of a nominal member.
pub enum MemberKind {
  Field,
  Position,
  EnumCase,
  Variant,
}

/// A constant's value, published only when its initializer needs no static execution.
pub union ConstantValue {
  /// An exact integer at the constant's fixed-width type. Zero is always positive.
  Integer {pub sign: Sign, pub magnitude: Bytes},
  /// A Boolean.
  Boolean {pub value: bool},
}

/// One completed semantic query value.
pub union Value {
  /// The complete syntactic name bucket, including an empty bucket.
  Name {pub bucket: Shared<NameObservation>},
  /// A namespace import's target module.
  Namespace {pub module: ModuleId, pub ordinal: usize},
  /// A selected import's canonical target declaration.
  Selected {pub declaration: DeclarationId, pub module: usize, pub ordinal: usize},
  /// An alias target or nominal type identity.
  Type {pub resolved: Shared<Type>},
  /// Ordered member names without resolving any member's type.
  Members {pub members: Vector<Member>},
  /// Resolved types of only the selected member; zero for a scalar enum case.
  MemberShape {pub types: Vector<Shared<Type>>},
  /// A declaration's binders and bounds.
  Contract {pub contract: Contract},
  /// An interface's or service's operation declarations in written order.
  Operations {pub operations: Vector<Shared<DeclarationId>>},
  /// Every `impl` head of one module in written order; empty when the module has none.
  Implementations {pub heads: Vector<Shared<ImplementationHead>>},
  /// One `impl` declaration's head.
  ImplementationHead {pub head: Shared<ImplementationHead>},
  /// An owner's inherent members. A member that duplicates another or claims an owner item's name
  /// is not published; its anchored rejection is kept instead, and no winner is chosen.
  InherentMembers {pub members: Vector<Shared<DeclarationId>>, pub rejected: Vector<RejectedMember>},
  /// A function's written signature.
  Signature {pub signature: Signature},
  /// A constant's initializer value at the type published by its `Constant` fact.
  Initializer {pub value: Shared<ConstantValue>},
  /// A complete checked ordinary function body with source ownership for its syntax positions.
  Body {
    /// The checked payload, whose local syntax positions match `source`.
    pub body: Shared<TypedBody>,
    /// The current source observation that owns every syntax position in `body`.
    pub source: Shared<Observation>,
  },
}

/// A direct query dependency retained with a completed semantic answer.
pub struct Dependency {
  /// The demanded query family.
  pub family: Family
  /// The module whose namespace or declaration was demanded.
  pub module: ModuleId
  /// The demanded name for a name query, if any.
  pub name: Option<Bytes>
  /// The canonical declaration for a declaration query, if any.
  pub declaration: Option<DeclarationId>
  /// The selected import-member ordinal, absent for namespace imports and other families.
  pub member: Option<usize>
  /// Whether a name query used the importing module's public-member view.
  pub external: bool
}

struct DemandFootprint {
  dependency: Dependency
}

/// A successful fact or anchored semantic rejection.
pub union Outcome {
  /// A resolved fact.
  Success {pub value: Value},
  /// A completed semantic rejection.
  Rejected {pub diagnostic: Shared<Rejection>},
}

/// One completed outcome, direct nested demands, and exact source observations.
pub struct Answer {
  /// The resolved fact or semantic rejection.
  pub outcome: Outcome
  /// Every direct nested query demanded to produce the fact, including memo hits.
  pub dependencies: Vector<Dependency>
  /// Every transitive present or absent source path for revision validation.
  pub sources: Vector<Shared<Observation>>
  footprint: Vector<Shared<DemandFootprint>>
  answerId: usize
  identity: Option<Shared<Value>>
  // A completed body answer owns its direct-result evidence with the Query entry.
  bodyEvidence: Option<Shared<BodyEvidence>>
}

struct Root {
  family: Family
  module: ModuleId
  name: Bytes
  answer: Shared<Result<Answer, NoRejection>>
}

/// The roots and discovered facts of one semantic request.
///
/// # Details
///
/// A request retains only its own roots. A completed answer keeps its transitive demand and source
/// observations, so a cache hit supplies the same discovery evidence to a new request.
pub struct Request {
  roots: Vector<Root>
}

/// One query event in demand order.
pub struct Event {
  /// Whether the query started, reused, or completed.
  pub kind: EventKind
  /// The family of the queried fact.
  pub family: Family
  /// The key ordinal within this held semantic store.
  pub key: usize
}

/// The lifecycle stage of an observable semantic query event.
pub enum EventKind {
  /// The query provider began work on a missing or invalid answer.
  Start,
  /// The query reused a completed answer.
  Hit,
  /// A checked body kept its typed payload after current inputs and child results validated.
  Reuse,
  /// The query provider completed and stored an answer.
  Finish,
}

struct Key {
  family: Family
  module: usize
  name: usize
  declaration: usize
  member: usize
  external: bool
}

impl Copy for Key {}

struct Selection {
  count: usize
  publicCount: usize
  declaration: usize
  member: usize
  kind: CandidateKind
  span: Span
  isPublic: bool
}

impl Copy for Selection {}

struct HeaderSyntax {
  header: Node
  span: Span
}

impl Copy for HeaderSyntax {}

struct PathSyntax {
  segments: Vector<Bytes>
  span: Span
  valid: bool
}

struct WrittenSignature {
  generics: Range
  parameters: Vector<HirId>
  result: Option<HirId>
  failures: HirRef
  requirements: HirRef
  environment: RangeRef
  isEffect: bool
  isUnsafe: bool
  isPublic: bool
  supported: bool
  span: Span
}

union Binder {
  Type {name: Bytes, value: Shared<Type>},
  Lifetime {name: Bytes, value: Shared<Lifetime>},
  // `bound` is the row supplied by an application; an unapplied binder stays a row parameter.
  Row {name: Bytes, value: RowParameter, bound: Option<Shared<Row>>},
}

struct LifetimeElision {
  owner: Option<DeclarationId>
  nextOrdinal: usize
  output: bool
  resultDefault: Option<Shared<Lifetime>>
  generated: Vector<Shared<Lifetime>>
  // Inside a callable contract, an omitted input lifetime is a fresh invocation binder.
  invocation: bool
  // Inside an invocation-quantified contract, a further quantifier is outside the language.
  nested: bool
  // Maps a provisional invocation ordinal to its canonical first-occurrence ordinal; empty when
  // the provisional numbering is already canonical.
  renumber: Vector<usize>
  // Set only while resolving the `Effect` result of a function with no parameters, whose omitted
  // environment is `'static`. The first environment elided under it consumes it.
  staticEnvironment: bool
}

struct Channels {
  failure: Shared<Type>
  requirements: Shared<Row>
}

struct TypeSelection {
  resolved: Option<Shared<Type>>
  rejected: Option<Shared<Rejection>>
}

struct ResolvedAnnotation {
  id: HirId
  result: Result<Shared<Type>, Shared<Rejection>>
}

struct ImportSelection {
  module: Option<usize>
  declaration: Option<usize>
  rejected: Option<Shared<Rejection>>
}

struct SelectedDeclaration {
  module: usize
  ordinal: usize
}

struct CallTarget {
  declaration: DeclarationId
  signature: Shared<Result<Answer, NoRejection>>
}

union CallReference {
  Named {name: Bytes},
  // A value read with no local binding. It selects a module declaration only to reject it: reading
  // a constant, function, or other declaration is outside the scalar body subset.
  Unbound {name: Bytes},
  Qualified {namespace: Bytes, member: Bytes, subjectSpan: Span, memberSpan: Span},
  NonCallable,
  Unsupported,
}

struct CallSyntax {
  id: HirId
  span: Span
  reference: CallReference
}

struct ResolvedCall {
  id: HirId
  result: Result<CallTarget, Shared<Rejection>>
}

struct CheckedControl {
  node: BodyNodeId
  canComplete: bool
}

struct Resolver {
  source: SourceIndex
  modules: Vector<ModuleId>
  names: Vector<Bytes>
  applications: Vector<Shared<Type>>
  keys: Vector<Key>
  active: Vector<Word>
  frames: Vector<SourceFrame>
  events: Vector<Event>
  nextAnswerId: usize
}

struct SourceFrame {
  observations: Vector<Shared<Observation>>
  footprint: Vector<Shared<DemandFootprint>>
  direct: Vector<BodyDependency>
}

struct BodyDependency {
  key: Key
  declaration: Option<Shared<DeclarationId>>
  answerId: usize
  identity: Option<Shared<Value>>
}

struct BodyEvidence {
  direct: Vector<BodyDependency>
}

struct BodyCandidate {
  body: Shared<TypedBody>
  evidence: Shared<BodyEvidence>
  directCount: usize
}

struct Running<'a, 'b> {
  resolver: &'a mut Resolver
  query: &'b mut Query<Word, Answer, NoRejection>
  key: Word
  base: usize
}

/// A serial semantic store for one immutable in-memory revision.
///
/// # Details
///
/// Semantic rejections are completed answers. Provider failures leave a key available for retry.
/// This actor keeps query events and direct dependencies for later request replay.
pub struct Semantic {
  resolver: Resolver
  query: Query<Word, Answer, NoRejection>
}

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

fn validAnswer(answer: &Result<Answer, NoRejection>, source: &SourceIndex) -> bool {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => {
      let observations = Vector.asSlice<Shared<Observation>>(&value.sources)
      let mut at = usize.ZERO
      while at < observations.length {
        if !Shared.with<Observation, bool>(
          &observations[at],
          fn(observed: &Observation) -> bool {
            return SourceIndex.matchesObservation(source, observed)
          },
        ) {
          return false
        }
        at = at + usize.ONE
      }
      return true
    }
    Result<Answer, NoRejection>.Failure {error: _} => false
  }
}

fn sameBucketWith(first: &NameObservation, other: &Shared<NameObservation>) -> bool {
  return Shared.with<NameObservation, bool>(
    other,
    fn(second: &NameObservation) -> bool {
      return NameObservation.equals(first, second)
    },
  )
}

fn sameBuckets(left: &Shared<NameObservation>, right: &Shared<NameObservation>) -> bool {
  return Shared.with<NameObservation, bool>(
    left,
    fn(first: &NameObservation) -> bool {
      return sameBucketWith(first, right)
    },
  )
}

fn reusableTypeKind(value: &Type) -> usize {
  return match & value.* {
    Type.Primitive {..} => usize.ONE
    Type.Unit => 2
    Type.Nominal {..} => 3
    Type.Parameter {..} => 4
    Type.String {..} => 5
    Type.Reference {..} => 6
    Type.Slice {..} => 7
    Type.Pointer {..} => 8
    Type.Array {..} => 9
    Type.Union {..} => 10
    Type.Callable {..} => 11
    Type.Effect {..} => 12
  }
}

fn primitiveLength(value: &Type) -> usize {
  return match & value.* {
    Type.Primitive {name} => Bytes.asSlice(&name).length
    _ => usize.ZERO
  }
}

fn primitiveByte(value: &Type, at: usize) -> u8 {
  return match & value.* {
    Type.Primitive {name} => Bytes.asSlice(&name)[at]
    _ => 0
  }
}

fn sameReusableType(left: &Shared<Type>, right: &Shared<Type>) -> bool {
  let first = Shared.with<Type, usize>(left, reusableTypeKind)
  let second = Shared.with<Type, usize>(right, reusableTypeKind)
  if first != second {
    return false
  }
  if first == 2 {
    return true
  }
  // Nominal type results may share a cached Type handle across answer generations. Recheck.
  if first != usize.ONE {
    return false
  }
  let length = Shared.with<Type, usize>(left, primitiveLength)
  if length != Shared.with<Type, usize>(right, primitiveLength) {
    return false
  }
  let mut at = usize.ZERO
  while at < length {
    let from = Shared.with<Type, u8>(
      left,
      fn(value: &Type) -> u8 {
        return primitiveByte(value, at)
      },
    )
    let to = Shared.with<Type, u8>(
      right,
      fn(value: &Type) -> u8 {
        return primitiveByte(value, at)
      },
    )
    if from != to {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

fn sameValue(left: &Value, right: &Value) -> bool {
  return match & left.* {
    Value.Name {bucket} => match & right.* {
      Value.Name {bucket: other} => sameBuckets(&bucket, &other)
      _ => false
    }
    Value.Namespace {module, ordinal} => match & right.* {
      Value.Namespace {module: other, ordinal: position} => ModuleId.equals(&module, &other) && ordinal == position
      _ => false
    }
    Value.Selected {declaration, module, ordinal} => match & right.* {
      Value.Selected {declaration: other, module: selected, ordinal: position} => DeclarationId.equals(
        &declaration,
        &other,
      ) && module == selected && ordinal == position
      _ => false
    }
    Value.Type {resolved} => match & right.* {
      Value.Type {resolved: other} => sameReusableType(&resolved, &other)
      _ => false
    }
    Value.Members {..} => false
    Value.Contract {..} => false
    Value.Operations {..} => false
    Value.Implementations {..} => false
    Value.ImplementationHead {..} => false
    Value.InherentMembers {..} => false
    Value.MemberShape {..} => false
    Value.Signature {signature} => match & right.* {
      Value.Signature {signature: other} => {
        if signature.isUnsafe != other.isUnsafe || !plainContract(&signature) || !plainContract(
          &other,
        ) {
          return false
        }
        let firstBinders = Vector.asSlice<Shared<Type>>(&signature.typeParameters)
        let secondBinders = Vector.asSlice<Shared<Type>>(&other.typeParameters)
        if firstBinders.length != secondBinders.length {
          return false
        }
        if Vector.length<Shared<Lifetime>>(&signature.lifetimeParameters) != usize.ZERO || Vector.length<
          Shared<Lifetime>,
        >(&other.lifetimeParameters) != usize.ZERO {
          return false
        }
        let mut binderAt = usize.ZERO
        while binderAt < firstBinders.length {
          if !sameReusableType(&firstBinders[binderAt], &secondBinders[binderAt]) {
            return false
          }
          binderAt = binderAt + usize.ONE
        }
        let first = Vector.asSlice<Shared<Type>>(&signature.parameters)
        let second = Vector.asSlice<Shared<Type>>(&other.parameters)
        if first.length != second.length || signature.isEffect != other.isEffect || !sameReusableType(
          &signature.result,
          &other.result,
        ) {
          return false
        }
        let mut at = usize.ZERO
        while at < first.length {
          if !sameReusableType(&first[at], &second[at]) {
            return false
          }
          at = at + usize.ONE
        }
        return true
      }
      _ => false
    }
    Value.Initializer {..} => false
    Value.Body {..} => false
  }
}

fn sameValueWith(first: &Value, other: &Shared<Value>) -> bool {
  return Shared.with<Value, bool>(
    other,
    fn(second: &Value) -> bool {
      return sameValue(first, second)
    },
  )
}

fn sameSharedValue(left: &Shared<Value>, right: &Shared<Value>) -> bool {
  return Shared.with<Value, bool>(
    left,
    fn(first: &Value) -> bool {
      return sameValueWith(first, right)
    },
  )
}

fn isNever(value: &Type) -> bool {
  return match & value.* {
    Type.Union {members} => Vector.length<Shared<Type>>(&members) == usize.ZERO
    _ => false
  }
}

fn emptyRow(row: &Row) -> bool {
  return Vector.length<Requirement>(&row.entries) == usize.ZERO && Vector.length<RowParameter>(
    &row.parameters,
  ) == usize.ZERO
}

// Reuse compares only scalar-wave contracts exactly; a richer contract conservatively differs.
fn plainContract(signature: &Signature) -> bool {
  return Vector.length<RowParameter>(&signature.rowParameters) == usize.ZERO && Vector.length<
    Constraint,
  >(&signature.constraints) == usize.ZERO && Shared.with<Type, bool>(&signature.failure, isNever) && Shared.with<
    Row,
    bool,
  >(&signature.requirements, emptyRow) && noEnvironment(&signature.environment)
}

fn noEnvironment(environment: &Option<Intersection>) -> bool {
  return match & environment.* {
    Option<Intersection>.Some {value: _} => false
    Option<Intersection>.None => true
  }
}

fn copyConstraint(constraint: &Constraint) -> Constraint {
  return match & constraint.* {
    Constraint.Conforms {provider, contract} => Constraint.Conforms {
      provider: Shared.clone<Type>(&provider),
      contract: Shared.clone<Type>(&contract),
    }
    Constraint.Represents {parameter, contract} => Constraint.Represents {
      parameter: Shared.clone<Type>(&parameter),
      contract: Shared.clone<Type>(&contract),
    }
    Constraint.Contents {subject, region} => Constraint.Contents {
      subject: Shared.clone<Type>(&subject),
      region: Shared.clone<Lifetime>(&region),
    }
    Constraint.Outlives {longer, shorter} => Constraint.Outlives {
      longer: Shared.clone<Lifetime>(&longer),
      shorter: Shared.clone<Lifetime>(&shorter),
    }
    Constraint.Copyable {subject} => Constraint.Copyable {subject: Shared.clone<Type>(&subject)}
  }
}

effect fn copySignature(signature: &Signature) -> Value ! OutOfMemoryError ? &mut Allocator {
  let mut environment = Option.none<Intersection>()
  if let Option<Intersection>.Some {value} = &signature.environment {
    environment = Option.some<Intersection>(run Intersection.copy(&value))
  }
  let mut rowParameters = Vector.make<RowParameter>()
  let rows = Vector.asSlice<RowParameter>(&signature.rowParameters)
  let mut rowAt = usize.ZERO
  while rowAt < rows.length {
    run Vector.append<RowParameter>(
      &mut rowParameters,
      RowParameter {
        declaration: Shared.clone<DeclarationId>(&rows[rowAt].declaration),
        ordinal: rows[rowAt].ordinal,
      },
    )
    rowAt = rowAt + usize.ONE
  }
  let mut constraints = Vector.make<Constraint>()
  let declared = Vector.asSlice<Constraint>(&signature.constraints)
  let mut constraintAt = usize.ZERO
  while constraintAt < declared.length {
    run Vector.append<Constraint>(&mut constraints, copyConstraint(&declared[constraintAt]))
    constraintAt = constraintAt + usize.ONE
  }
  let mut typeParameters = Vector.make<Shared<Type>>()
  let binders = Vector.asSlice<Shared<Type>>(&signature.typeParameters)
  let mut binderAt = usize.ZERO
  while binderAt < binders.length {
    run Vector.append<Shared<Type>>(&mut typeParameters, Shared.clone<Type>(&binders[binderAt]))
    binderAt = binderAt + usize.ONE
  }
  let mut lifetimeParameters = Vector.make<Shared<Lifetime>>()
  let lifetimes = Vector.asSlice<Shared<Lifetime>>(&signature.lifetimeParameters)
  let mut lifetimeAt = usize.ZERO
  while lifetimeAt < lifetimes.length {
    run Vector.append<Shared<Lifetime>>(
      &mut lifetimeParameters,
      Shared.clone<Lifetime>(&lifetimes[lifetimeAt]),
    )
    lifetimeAt = lifetimeAt + usize.ONE
  }
  let mut parameters = Vector.make<Shared<Type>>()
  let written = Vector.asSlice<Shared<Type>>(&signature.parameters)
  let mut at = usize.ZERO
  while at < written.length {
    run Vector.append<Shared<Type>>(&mut parameters, Shared.clone<Type>(&written[at]))
    at = at + usize.ONE
  }
  return Value.Signature {
    signature: Signature {
      typeParameters: move typeParameters,
      lifetimeParameters: move lifetimeParameters,
      rowParameters: move rowParameters,
      constraints: move constraints,
      parameters: move parameters,
      result: Shared.clone<Type>(&signature.result),
      failure: Shared.clone<Type>(&signature.failure),
      requirements: Shared.clone<Row>(&signature.requirements),
      isEffect: signature.isEffect,
      isUnsafe: signature.isUnsafe,
      environment: move environment,
    },
  }
}

effect fn identityOf(outcome: &Outcome) -> Option<Shared<Value>> ! OutOfMemoryError ? &mut Allocator {
  return match & outcome.* {
    Outcome.Rejected {diagnostic: _} => Option.none<Shared<Value>>()
    Outcome.Success {value} => {
      let copied = match & value {
        Value.Name {bucket} => Value.Name {bucket: Shared.clone<NameObservation>(&bucket)}
        Value.Namespace {module, ordinal} => Value.Namespace {
          module: run ModuleId.copy(&module),
          ordinal: ordinal,
        }
        Value.Selected {declaration, module, ordinal} => Value.Selected {
          declaration: run DeclarationId.copy(&declaration),
          module: module,
          ordinal: ordinal,
        }
        Value.Type {resolved} => Value.Type {resolved: Shared.clone<Type>(&resolved)}
        Value.Contract {..} => {
          return Option.none<Shared<Value>>()
        }
        Value.Operations {..} => {
          return Option.none<Shared<Value>>()
        }
        Value.Implementations {..} => {
          return Option.none<Shared<Value>>()
        }
        Value.ImplementationHead {..} => {
          return Option.none<Shared<Value>>()
        }
        Value.InherentMembers {..} => {
          return Option.none<Shared<Value>>()
        }
        Value.Members {..} => {
          return Option.none<Shared<Value>>()
        }
        Value.MemberShape {..} => {
          return Option.none<Shared<Value>>()
        }
        Value.Signature {signature} => run copySignature(&signature)
        Value.Initializer {..} => {
          return Option.none<Shared<Value>>()
        }
        Value.Body {..} => {
          return Option.none<Shared<Value>>()
        }
      }
      return Option.some<Shared<Value>>(run Shared.make<Value>(move copied))
    }
  }
}

fn answerIdentity(answer: &Result<Answer, NoRejection>) -> Option<Shared<Value>> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.identity {
      Option<Shared<Value>>.Some {value: observed} => Option.some<Shared<Value>>(
        Shared.clone<Value>(&observed),
      )
      Option<Shared<Value>>.None => Option.none<Shared<Value>>()
    }
    Result<Answer, NoRejection>.Failure {error: _} => Option.none<Shared<Value>>()
  }
}

fn priorAnswerId(answer: &Result<Answer, NoRejection>) -> usize {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => value.answerId
    Result<Answer, NoRejection>.Failure {error: _} => usize.ZERO
  }
}

fn discoveredBy(answer: &Result<Answer, NoRejection>, module: &ModuleId) -> bool {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => {
      let observations = Vector.asSlice<Shared<Observation>>(&value.sources)
      let mut at = usize.ZERO
      while at < observations.length {
        if Shared.with<Observation, bool>(
          &observations[at],
          fn(observed: &Observation) -> bool {
            return Observation.isPresent(observed) && ModuleId.equals(
              Observation.moduleId(observed),
              module,
            )
          },
        ) {
          return true
        }
        at = at + usize.ONE
      }
      return false
    }
    Result<Answer, NoRejection>.Failure {error: _} => false
  }
}

fn demandedBy(answer: &Result<Answer, NoRejection>, family: Family, module: &ModuleId) -> bool {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => {
      let demands = Vector.asSlice<Shared<DemandFootprint>>(&value.footprint)
      let mut at = usize.ZERO
      while at < demands.length {
        if Shared.with<DemandFootprint, bool>(
          &demands[at],
          fn(demanded: &DemandFootprint) -> bool {
            return demanded.dependency.family == family && ModuleId.equals(
              &demanded.dependency.module,
              module,
            )
          },
        ) {
          return true
        }
        at = at + usize.ONE
      }
      return false
    }
    Result<Answer, NoRejection>.Failure {error: _} => false
  }
}

fn footprintCount(answer: &Result<Answer, NoRejection>) -> usize {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => Vector.length<Shared<DemandFootprint>>(
      &value.footprint,
    )
    Result<Answer, NoRejection>.Failure {error: _} => usize.ZERO
  }
}

fn footprintAt(answer: &Result<Answer, NoRejection>, at: usize) -> Option<Shared<DemandFootprint>> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => {
      let demands = Vector.asSlice<Shared<DemandFootprint>>(&value.footprint)
      if at < demands.length {
        return Option.some<Shared<DemandFootprint>>(Shared.clone<DemandFootprint>(&demands[at]))
      }
      return Option.none<Shared<DemandFootprint>>()
    }
    Result<Answer, NoRejection>.Failure {error: _} => Option.none<Shared<DemandFootprint>>()
  }
}

fn observationCount(answer: &Result<Answer, NoRejection>) -> usize {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => Vector.length<Shared<Observation>>(
      &value.sources,
    )
    Result<Answer, NoRejection>.Failure {error: _} => usize.ZERO
  }
}

fn observationAt(answer: &Result<Answer, NoRejection>, at: usize) -> Option<Shared<Observation>> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => {
      let observations = Vector.asSlice<Shared<Observation>>(&value.sources)
      if at < observations.length {
        return Option.some<Shared<Observation>>(Shared.clone<Observation>(&observations[at]))
      }
      return Option.none<Shared<Observation>>()
    }
    Result<Answer, NoRejection>.Failure {error: _} => Option.none<Shared<Observation>>()
  }
}

fn priorCandidate(answer: &Result<Answer, NoRejection>) -> Option<BodyCandidate> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value: previous} => match & previous.outcome {
      Outcome.Success {value: Value.Body {body, source: _}} => match & previous.bodyEvidence {
        Option<Shared<BodyEvidence>>.Some {value: evidence} => Option.some<BodyCandidate>(
          BodyCandidate {
            body: Shared.clone<TypedBody>(&body),
            evidence: Shared.clone<BodyEvidence>(&evidence),
            directCount: Vector.length<Dependency>(&previous.dependencies),
          },
        )
        Option<Shared<BodyEvidence>>.None => Option.none<BodyCandidate>()
      }
      _ => Option.none<BodyCandidate>()
    }
    Result<Answer, NoRejection>.Failure {error: _} => Option.none<BodyCandidate>()
  }
}

fn bodyDependencyAt(evidence: &BodyEvidence, at: usize) -> BodyDependency {
  let direct = Vector.asSlice<BodyDependency>(&evidence.direct)
  let prior = &direct[at]
  let declaration = match & prior.declaration {
    Option<Shared<DeclarationId>>.Some {value} => Option.some<Shared<DeclarationId>>(
      Shared.clone<DeclarationId>(&value),
    )
    Option<Shared<DeclarationId>>.None => Option.none<Shared<DeclarationId>>()
  }
  let identity = match & prior.identity {
    Option<Shared<Value>>.Some {value} => Option.some<Shared<Value>>(Shared.clone<Value>(&value))
    Option<Shared<Value>>.None => Option.none<Shared<Value>>()
  }
  return BodyDependency {
    key: prior.key,
    declaration: move declaration,
    answerId: prior.answerId,
    identity: move identity,
  }
}

fn isSuccessfulBody(outcome: &Outcome) -> bool {
  return match & outcome.* {
    Outcome.Success {value: Value.Body {..}} => true
    _ => false
  }
}

effect fn recordRoot(
  request: &mut Request,
  family: Family,
  module: &ModuleId,
  name: &[u8],
  answer: &Shared<Result<Answer, NoRejection>>,
) -> () ! OutOfMemoryError ? &mut Allocator {
  run Vector.append<Root>(
    &mut request.roots,
    Root {
      family: family,
      module: run ModuleId.copy(module),
      name: run Bytes.copy(name),
      answer: Shared.clone<Result<Answer, NoRejection>>(answer),
    },
  )
  return ()
}

impl Request {
  /// Creates an empty ledger for one independent semantic request.
  pub fn make() -> Request {
    return Request {roots: Vector.make<Root>()}
  }
  /// Returns the number of roots demanded through this request.
  pub fn rootCount(self: &Self) -> usize {
    return Vector.length<Root>(&self.roots)
  }
  /// Reports whether this request demanded the named root.
  pub fn hasRoot(self: &Self, family: Family, module: &ModuleId, name: &[u8]) -> bool {
    let roots = Vector.asSlice<Root>(&self.roots)
    let mut at = usize.ZERO
    while at < roots.length {
      if roots[at].family == family && ModuleId.equals(&roots[at].module, module) && same(
        Bytes.asSlice(&roots[at].name),
        name,
      ) {
        return true
      }
      at = at + usize.ONE
    }
    return false
  }
  /// Reports whether a completed root in this request discovered a present module.
  ///
  /// # Details
  ///
  /// A memoized root replays its nested source observations into this request. An absent module
  /// is evidence for validation, but it is not a discovered present module.
  pub fn hasDiscovered(self: &Self, module: &ModuleId) -> bool {
    let roots = Vector.asSlice<Root>(&self.roots)
    let mut at = usize.ZERO
    while at < roots.length {
      if Shared.with<Result<Answer, NoRejection>, bool>(
        &roots[at].answer,
        fn(answer: &Result<Answer, NoRejection>) -> bool {
          return discoveredBy(answer, module)
        },
      ) {
        return true
      }
      at = at + usize.ONE
    }
    return false
  }
  /// Reports whether a completed root demanded a nested fact in this request.
  pub fn hasDemand(self: &Self, family: Family, module: &ModuleId) -> bool {
    let roots = Vector.asSlice<Root>(&self.roots)
    let mut at = usize.ZERO
    while at < roots.length {
      if roots[at].family == family && ModuleId.equals(&roots[at].module, module) {
        return true
      }
      if Shared.with<Result<Answer, NoRejection>, bool>(
        &roots[at].answer,
        fn(answer: &Result<Answer, NoRejection>) -> bool {
          return demandedBy(answer, family, module)
        },
      ) {
        return true
      }
      at = at + usize.ONE
    }
    return false
  }
}

fn primitive(name: &[u8]) -> bool {
  return same(name, b"bool") || same(name, b"i8") || same(name, b"i16") || same(name, b"i32") || same(
    name,
    b"i64",
  ) || same(name, b"isize") || same(name, b"u8") || same(name, b"u16") || same(name, b"u32") || same(
    name,
    b"u64",
  ) || same(name, b"usize") || same(name, b"f32") || same(name, b"f64") || same(name, b"char")
}

fn sameKey(left: Key, right: Key) -> bool {
  return left.family == right.family && left.module == right.module && left.name == right.name && left.declaration == right.declaration && left.member == right.member && left.external == right.external
}

effect fn internApplication(resolver: &mut Resolver, application: &Shared<Type>) -> usize
! OutOfMemoryError
? &mut Allocator {
  let known = Vector.asSlice<Shared<Type>>(&resolver.applications)
  let mut at = usize.ZERO
  while at < known.length {
    if run Type.equalsShared(&known[at], application) {
      return at
    }
    at = at + usize.ONE
  }
  run Vector.append<Shared<Type>>(&mut resolver.applications, Shared.clone<Type>(application))
  return at
}

fn applicationLength(value: &Type) -> usize {
  return match & value.* {
    Type.Nominal {arguments, ..} => Vector.length<Argument>(&arguments)
    _ => usize.MAX
  }
}

fn applicationArgument(value: &Type, at: usize) -> Option<Argument> {
  return match & value.* {
    Type.Nominal {arguments, ..} => {
      let entries = Vector.asSlice<Argument>(&arguments)
      if at >= entries.length {
        return Option.none<Argument>()
      }
      return match & entries[at] {
        Argument.Type {value: ty} => Option.some<Argument>(
          Argument.Type {value: Shared.clone<Type>(&ty)},
        )
        Argument.Lifetime {value: lifetime} => Option.some<Argument>(
          Argument.Lifetime {value: Shared.clone<Lifetime>(&lifetime)},
        )
        Argument.Row {value: row} => Option.some<Argument>(
          Argument.Row {value: Shared.clone<Row>(&row)},
        )
      }
    }
    _ => Option.none<Argument>()
  }
}

fn applicationMatches(value: &Type, declaration: &DeclarationId) -> bool {
  return match & value.* {
    Type.Nominal {declaration: owner, ..} => DeclarationId.equals(&owner, declaration)
    _ => false
  }
}

effect fn internModule(resolver: &mut Resolver, module: &ModuleId) -> usize
! OutOfMemoryError
? &mut Allocator {
  let known = Vector.asSlice<ModuleId>(&resolver.modules)
  let mut at = usize.ZERO
  while at < known.length {
    if ModuleId.equals(&known[at], module) {
      return at
    }
    at = at + usize.ONE
  }
  run Vector.append<ModuleId>(&mut resolver.modules, run ModuleId.copy(module))
  return at
}

effect fn internName(resolver: &mut Resolver, name: &[u8]) -> usize
! OutOfMemoryError
? &mut Allocator {
  let known = Vector.asSlice<Bytes>(&resolver.names)
  let mut at = usize.ZERO
  while at < known.length {
    if same(Bytes.asSlice(&known[at]), name) {
      return at
    }
    at = at + usize.ONE
  }
  run Vector.append<Bytes>(&mut resolver.names, run Bytes.copy(name))
  return at
}

effect fn internKey(resolver: &mut Resolver, key: Key) -> Word ! OutOfMemoryError ? &mut Allocator {
  let known = Vector.asSlice<Key>(&resolver.keys)
  let mut at = usize.ZERO
  while at < known.length {
    if sameKey(known[at], key) {
      return Hash.word(usize.toU64(at))
    }
    at = at + usize.ONE
  }
  run Vector.append<Key>(&mut resolver.keys, key)
  return Hash.word(usize.toU64(at))
}

effect fn reject(resolver: &Resolver, module: &ModuleId, code: RejectionCode, span: Span) -> Shared<
  Rejection,
> ! OutOfMemoryError ? &mut Allocator {
  return run Shared.make<Rejection>(
    Rejection {
      code: code,
      module: run ModuleId.copy(module),
      span: span,
      path: Vector.make<Shared<DeclarationId>>(),
      expected: usize.ZERO,
      supplied: usize.ZERO,
      parameterName: Bytes.make(),
      expectedKind: GenericKind.Type,
      suppliedKind: GenericKind.Type,
    },
  )
}

effect fn rejectArity(
  resolver: &Resolver,
  module: &ModuleId,
  span: Span,
  expected: usize,
  supplied: usize,
) -> Shared<Rejection> ! OutOfMemoryError ? &mut Allocator {
  return run Shared.make<Rejection>(
    Rejection {
      code: RejectionCode.TypeArity,
      module: run ModuleId.copy(module),
      span: span,
      path: Vector.make<Shared<DeclarationId>>(),
      expected: expected,
      supplied: supplied,
      parameterName: Bytes.make(),
      expectedKind: GenericKind.Type,
      suppliedKind: GenericKind.Type,
    },
  )
}

effect fn rejectKind(
  resolver: &Resolver,
  module: &ModuleId,
  span: Span,
  parameter: &[u8],
  expectedKind: GenericKind,
  supplied: GenericKind,
) -> Shared<Rejection> ! OutOfMemoryError ? &mut Allocator {
  let name = run Bytes.copy(parameter)
  return run Shared.make<Rejection>(
    Rejection {
      code: RejectionCode.TypeArgumentKind,
      module: run ModuleId.copy(module),
      span: span,
      path: Vector.make<Shared<DeclarationId>>(),
      expected: usize.ZERO,
      supplied: usize.ZERO,
      parameterName: move name,
      expectedKind: expectedKind,
      suppliedKind: supplied,
    },
  )
}

effect fn emit(resolver: &mut Resolver, kind: EventKind, key: Word) -> ()
! OutOfMemoryError
? &mut Allocator {
  let selected = Vector.get<Key>(&resolver.keys, u64.toUsize(key.value))
  run Vector.append<Event>(
    &mut resolver.events,
    Event {kind: kind, family: selected.family, key: u64.toUsize(key.value)},
  )
  return ()
}

fn observationAddress(value: &Observation) -> usize {
  return Pointer.address<Observation>(Pointer.fromRef<Observation>(value))
}

fn observationWith(first: &Observation, right: &Shared<Observation>) -> bool {
  return Shared.with<Observation, bool>(
    right,
    fn(second: &Observation) -> bool {
      return Observation.equals(first, second)
    },
  )
}

fn sameObservation(left: &Shared<Observation>, right: &Shared<Observation>) -> bool {
  // A repeated child answer merges the handle it already contributed. Avoid reentrant access.
  if Shared.with<Observation, usize>(left, observationAddress) == Shared.with<Observation, usize>(
    right,
    observationAddress,
  ) {
    return true
  }
  return Shared.with<Observation, bool>(
    left,
    fn(first: &Observation) -> bool {
      return observationWith(first, right)
    },
  )
}

effect fn appendObservation(frame: &mut SourceFrame, observed: &Shared<Observation>) -> ()
! OutOfMemoryError
? &mut Allocator {
  let known = Vector.asSlice<Shared<Observation>>(&frame.observations)
  let mut at = usize.ZERO
  while at < known.length {
    if sameObservation(&known[at], observed) {
      return ()
    }
    at = at + usize.ONE
  }
  run Vector.append<Shared<Observation>>(
    &mut frame.observations,
    Shared.clone<Observation>(observed),
  )
  return ()
}

effect fn mergeEvidence(frame: &mut SourceFrame, answer: &Shared<Result<Answer, NoRejection>>) -> ()
! OutOfMemoryError
? &mut Allocator {
  let sources = Shared.with<Result<Answer, NoRejection>, usize>(answer, observationCount)
  let mut at = usize.ZERO
  while at < sources {
    let observed = Shared.with<Result<Answer, NoRejection>, Option<Shared<Observation>>>(
      answer,
      fn(value: &Result<Answer, NoRejection>) -> Option<Shared<Observation>> {
        return observationAt(value, at)
      },
    )
    if let Option<Shared<Observation>>.Some {value} = move observed {
      run appendObservation(&mut frame.*, &value)
    }
    at = at + usize.ONE
  }
  let demands = Shared.with<Result<Answer, NoRejection>, usize>(answer, footprintCount)
  at = usize.ZERO
  while at < demands {
    let nested = Shared.with<Result<Answer, NoRejection>, Option<Shared<DemandFootprint>>>(
      answer,
      fn(value: &Result<Answer, NoRejection>) -> Option<Shared<DemandFootprint>> {
        return footprintAt(value, at)
      },
    )
    if let Option<Shared<DemandFootprint>>.Some {value} = move nested {
      run Vector.append<Shared<DemandFootprint>>(&mut frame.footprint, move value)
    }
    at = at + usize.ONE
  }
  return ()
}

fn sourceOf<'a>(
  resolver: &'a Resolver,
  answer: &Shared<Result<SourceResult, NoRejection>>,
  module: &ModuleId,
) -> Option<&'a IndexedSource> {
  return SourceIndex.source(&resolver.source, answer, module)
}

effect fn source(resolver: &mut Resolver, module: &ModuleId) -> Shared<
  Result<SourceResult, NoRejection>,
> ! Cycle | OutOfMemoryError ? &mut Allocator {
  let answer = run SourceIndex.demand(&mut resolver.source, module)
  let count = Vector.length<SourceFrame>(&resolver.frames)
  if count > usize.ZERO {
    let frames = Vector.asSlice<SourceFrame>(&resolver.frames)
    let observed = Vector.asSlice<Shared<Observation>>(&frames[count - usize.ONE].observations)
    let mut found = false
    let mut at = usize.ZERO
    while at < observed.length {
      if Shared.with<Observation, bool>(
        &observed[at],
        fn(value: &Observation) -> bool {
          return ModuleId.equals(Observation.moduleId(value), module)
        },
      ) {
        found = true
      }
      at = at + usize.ONE
    }
    if !found {
      let evidence = run Shared.make<Observation>(
        run SourceIndex.captureObservation(&resolver.source, module),
      )
      let mut frames = Vector.asMutSlice<SourceFrame>(&mut resolver.frames)
      run appendObservation(&mut frames[count - usize.ONE], &evidence)
    }
  }
  return move answer
}

effect fn declarationAt(resolver: &mut Resolver, module: &ModuleId, ordinal: usize) -> Option<
  DeclarationId,
> ! Cycle | OutOfMemoryError ? &mut Allocator {
  let answer = run source(&mut resolver.*, module)
  if let Option<&IndexedSource>.Some {value} = move sourceOf(&resolver.*, &answer, module) {
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(value))
    if ordinal < declarations.length {
      return Option.some<DeclarationId>(run DeclarationId.copy(&declarations[ordinal].identity))
    }
  }
  return Option.none<DeclarationId>()
}

effect fn select(resolver: &mut Resolver, module: &ModuleId, name: &[u8], external: bool) -> Selection
! Cycle | OutOfMemoryError
? &mut Allocator {
  let answer = run source(&mut resolver.*, module)
  if let Option<&IndexedSource>.Some {value} = move sourceOf(&resolver.*, &answer, module) {
    let candidates = ModuleIndex.listCandidates(IndexedSource.moduleIndex(value))
    let hir = IndexedSource.authored(value)
    let mut count = usize.ZERO
    let mut publicCount = usize.ZERO
    let mut chosen = Selection {
      count: usize.ZERO,
      publicCount: usize.ZERO,
      declaration: usize.ZERO,
      member: usize.ZERO,
      kind: CandidateKind.Declaration,
      span: Span {start: usize.ZERO, end: usize.ZERO},
      isPublic: false,
    }
    let mut at = usize.ZERO
    while at < candidates.length {
      if same(Bytes.asSlice(&candidates[at].name), name) {
        count = count + usize.ONE
        if candidates[at].isPublic {
          publicCount = publicCount + usize.ONE
        }
        if count == usize.ONE || (external && candidates[at].isPublic && !chosen.isPublic) {
          chosen.declaration = candidates[at].declaration
          chosen.member = candidates[at].ordinal
          chosen.kind = candidates[at].kind
          chosen.span = Module.span(hir, candidates[at].local)
          chosen.isPublic = candidates[at].isPublic
        }
      }
      at = at + usize.ONE
    }
    chosen.count = count
    chosen.publicCount = publicCount
    return chosen
  }
  return Selection {
    count: usize.ZERO,
    publicCount: usize.ZERO,
    declaration: usize.ZERO,
    member: usize.ZERO,
    kind: CandidateKind.Declaration,
    span: Span {start: usize.ZERO, end: usize.ZERO},
    isPublic: false,
  }
}

effect fn header(resolver: &mut Resolver, module: &ModuleId, ordinal: usize) -> Option<HeaderSyntax>
! Cycle | OutOfMemoryError
? &mut Allocator {
  let answer = run source(&mut resolver.*, module)
  if let Option<&IndexedSource>.Some {value} = move sourceOf(&resolver.*, &answer, module) {
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(value))
    if ordinal < declarations.length {
      let hir = IndexedSource.authored(value)
      let id = declarations[ordinal].header
      return Option.some<HeaderSyntax>(
        HeaderSyntax {header: Module.node(hir, id), span: Module.span(hir, id)},
      )
    }
  }
  return Option.none<HeaderSyntax>()
}

effect fn path(resolver: &mut Resolver, module: &ModuleId, id: HirId) -> PathSyntax
! Cycle | OutOfMemoryError
? &mut Allocator {
  let answer = run source(&mut resolver.*, module)
  if let Option<&IndexedSource>.Some {value} = move sourceOf(&resolver.*, &answer, module) {
    let hir = IndexedSource.authored(value)
    let span = Module.span(hir, id)
    if let Node.Path {segments} = Module.node(hir, id) {
      let mut names = Vector.make<Bytes>()
      let mut at = usize.ZERO
      while at < segments.length {
        let child = Module.child(hir, segments, at)
        if let Node.Name {text} = Module.node(hir, child) {
          run Vector.append<Bytes>(&mut names, run Bytes.copy(Module.text(hir, text)))
        } else {
          return PathSyntax {segments: move names, span: span, valid: false}
        }
        at = at + usize.ONE
      }
      return PathSyntax {segments: move names, span: span, valid: segments.length > usize.ZERO}
    }
    return PathSyntax {segments: Vector.make<Bytes>(), span: span, valid: false}
  }
  return PathSyntax {
    segments: Vector.make<Bytes>(),
    span: Span.make(usize.ZERO, usize.ZERO),
    valid: false,
  }
}

// Whether the interface or service directly enclosing `ordinal` is public.
fn contractPublic(hir: &Module, declarations: &[IndexedDeclaration], ordinal: usize) -> bool {
  if let Option<usize>.Some {value: parent} = &declarations[ordinal].parent {
    return match Module.node(hir, declarations[parent].header) {
      Node.InterfaceHeader {isPublic, ..} => isPublic
      Node.ServiceHeader {isPublic, ..} => isPublic
      _ => false
    }
  }
  return false
}

effect fn signatureSyntax(resolver: &mut Resolver, module: &ModuleId, ordinal: usize) -> Option<
  WrittenSignature,
> ! Cycle | OutOfMemoryError ? &mut Allocator {
  let answer = run source(&mut resolver.*, module)
  if let Option<&IndexedSource>.Some {value} = move sourceOf(&resolver.*, &answer, module) {
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(value))
    if ordinal >= declarations.length {
      return Option.none<WrittenSignature>()
    }
    let hir = IndexedSource.authored(value)
    let declarationSpan = Module.span(hir, declarations[ordinal].header)
    let written = Module.node(hir, declarations[ordinal].header)
    let mut callable = Option.none<HirId>()
    let mut isPublic = false
    // Linkage and property clauses are outside the supported header subset.
    let mut plain = true
    if let Node.FunctionHeader {contract, linkage, properties, isPublic: visible, ..} = written {
      callable = Option.some<HirId>(contract)
      isPublic = visible
      plain = !linkage.present && properties.length == usize.ZERO
    }
    if let Node.OperationHeader {contract, properties, ..} = written {
      callable = Option.some<HirId>(contract)
      // An operation has no visibility of its own; it shares its interface's or service's.
      isPublic = contractPublic(hir, declarations, ordinal)
      plain = properties.length == usize.ZERO
    }
    if let Option<HirId>.Some {value: contract} = move callable {
      if let Node.CallableContract {
        generics,
        parameters,
        variadic,
        result,
        failures,
        requirements,
        constraints,
        isEffect,
        isTest,
        environment,
        isUnsafe,
        isStatic,
        ..,
      } = Module.node(hir, contract) {
        let mut params = Vector.make<HirId>()
        let mut at = usize.ZERO
        while at < parameters.length {
          let parameterId = Module.child(hir, parameters, at)
          let mut accepted = false
          if let Node.Parameter {annotation, mode, ..} = Module.node(hir, parameterId) {
            // A `mut` binding prefix is local storage, not contract identity; static parameters
            // need compile-time evaluation.
            if mode != ParameterMode.Static {
              run Vector.append<HirId>(&mut params, annotation)
              accepted = true
            }
          }
          if !accepted {
            return Option.some<WrittenSignature>(
              WrittenSignature {
                generics: generics,
                parameters: move params,
                result: Option.none<HirId>(),
                failures: failures,
                requirements: requirements,
                environment: environment,
                isEffect: isEffect,
                isUnsafe: isUnsafe,
                isPublic: isPublic,
                supported: false,
                span: Module.span(hir, parameterId),
              },
            )
          }
          at = at + usize.ONE
        }
        let mut written = Option.none<HirId>()
        if result.present {
          written = Option.some<HirId>(result.id)
        }
        return Option.some<WrittenSignature>(
          WrittenSignature {
            generics: generics,
            parameters: move params,
            result: move written,
            failures: failures,
            requirements: requirements,
            environment: environment,
            isEffect: isEffect,
            isUnsafe: isUnsafe,
            isPublic: isPublic,
            supported: !variadic && constraints.length == usize.ZERO && !isTest && !isStatic && plain,
            span: Module.span(hir, contract),
          },
        )
      }
      return Option.some<WrittenSignature>(
        WrittenSignature {
          generics: Range.empty(),
          parameters: Vector.make<HirId>(),
          result: Option.none<HirId>(),
          failures: HirRef.absent(),
          requirements: HirRef.absent(),
          environment: RangeRef.absent(),
          isEffect: false,
          isUnsafe: false,
          isPublic: isPublic,
          supported: false,
          span: Module.span(hir, contract),
        },
      )
    }
    return Option.some<WrittenSignature>(
      WrittenSignature {
        generics: Range.empty(),
        parameters: Vector.make<HirId>(),
        result: Option.none<HirId>(),
        failures: HirRef.absent(),
        requirements: HirRef.absent(),
        environment: RangeRef.absent(),
        isEffect: false,
        isUnsafe: false,
        isPublic: false,
        supported: false,
        span: declarationSpan,
      },
    )
  }
  return Option.none<WrittenSignature>()
}

fn selectedType(answer: &Result<Answer, NoRejection>) -> TypeSelection {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: fact} => match & fact {
        Value.Type {resolved} => TypeSelection {
          resolved: Option.some<Shared<Type>>(Shared.clone<Type>(&resolved)),
          rejected: Option.none<Shared<Rejection>>(),
        }
        _ => TypeSelection {
          resolved: Option.none<Shared<Type>>(),
          rejected: Option.none<Shared<Rejection>>(),
        }
      }
      Outcome.Rejected {diagnostic} => TypeSelection {
        resolved: Option.none<Shared<Type>>(),
        rejected: Option.some<Shared<Rejection>>(Shared.clone<Rejection>(&diagnostic)),
      }
    }
    Result<Answer, NoRejection>.Failure {error: _} => TypeSelection {
      resolved: Option.none<Shared<Type>>(),
      rejected: Option.none<Shared<Rejection>>(),
    }
  }
}

fn selectedImport(answer: &Result<Answer, NoRejection>) -> ImportSelection {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: fact} => match & fact {
        Value.Namespace {module: _, ordinal} => ImportSelection {
          module: Option.some<usize>(ordinal),
          declaration: Option.none<usize>(),
          rejected: Option.none<Shared<Rejection>>(),
        }
        Value.Selected {declaration: _, module, ordinal} => ImportSelection {
          module: Option.some<usize>(module),
          declaration: Option.some<usize>(ordinal),
          rejected: Option.none<Shared<Rejection>>(),
        }
        _ => ImportSelection {
          module: Option.none<usize>(),
          declaration: Option.none<usize>(),
          rejected: Option.none<Shared<Rejection>>(),
        }
      }
      Outcome.Rejected {diagnostic} => ImportSelection {
        module: Option.none<usize>(),
        declaration: Option.none<usize>(),
        rejected: Option.some<Shared<Rejection>>(Shared.clone<Rejection>(&diagnostic)),
      }
    }
    Result<Answer, NoRejection>.Failure {error: _} => ImportSelection {
      module: Option.none<usize>(),
      declaration: Option.none<usize>(),
      rejected: Option.none<Shared<Rejection>>(),
    }
  }
}

effect fn dependency(resolver: &mut Resolver, key: Key) -> Dependency
! Cycle | OutOfMemoryError
? &mut Allocator {
  let modules = Vector.asSlice<ModuleId>(&resolver.modules)
  let module = run ModuleId.copy(&modules[key.module])
  let mut name = Option.none<Bytes>()
  if key.family == Family.Name {
    let names = Vector.asSlice<Bytes>(&resolver.names)
    name = Option.some<Bytes>(run Bytes.copy(Bytes.asSlice(&names[key.name])))
  }
  let mut declaration = Option.none<DeclarationId>()
  let mut member = Option.none<usize>()
  if key.family == Family.Import || key.family == Family.Alias || key.family == Family.Identity || key.family == Family.Members || key.family == Family.MemberShape || key.family == Family.Contract || key.family == Family.Operations || key.family == Family.ImplementationHead || key.family == Family.InherentMembers || key.family == Family.Signature || key.family == Family.Constant || key.family == Family.Initializer || key.family == Family.Body {
    declaration = run declarationAt(&mut resolver.*, &module, key.declaration)
  }
  if (key.family == Family.Import || key.family == Family.MemberShape) && key.member != usize.MAX {
    member = Option.some<usize>(key.member)
  }
  return Dependency {
    family: key.family,
    module: move module,
    name: move name,
    declaration: move declaration,
    member: move member,
    external: key.external,
  }
}

effect fn cycleAnswer(resolver: &mut Resolver, key: Key, span: Span) -> Shared<
  Result<Answer, NoRejection>,
> ! Cycle | OutOfMemoryError ? &mut Allocator {
  let modules = Vector.asSlice<ModuleId>(&resolver.modules)
  let activeKeys = Vector.asSlice<Word>(&resolver.active)
  let current = Vector.get<Key>(
    &resolver.keys,
    u64.toUsize(activeKeys[activeKeys.length - usize.ONE].value),
  )
  let module = run ModuleId.copy(&modules[current.module])
  let repeated = run ModuleId.copy(&modules[key.module])
  let mut path = Vector.make<Shared<DeclarationId>>()
  let mut withinCycle = false
  let mut at = usize.ZERO
  while at < Vector.length<Word>(&resolver.active) {
    let active = Vector.get<Word>(&resolver.active, at)
    let existing = Vector.get<Key>(&resolver.keys, u64.toUsize(active.value))
    if sameKey(existing, key) {
      withinCycle = true
    }
    if withinCycle && (existing.family == Family.Alias || existing.family == Family.Import || existing.family == Family.Initializer) {
      let ownerModule = Vector.asSlice<ModuleId>(&resolver.modules)
      let owner = run ModuleId.copy(&ownerModule[existing.module])
      let found = run declarationAt(&mut resolver.*, &owner, existing.declaration)
      if let Option<DeclarationId>.Some {value} = move found {
        run Vector.append<Shared<DeclarationId>>(
          &mut path,
          run Shared.make<DeclarationId>(move value),
        )
      }
    }
    at = at + usize.ONE
  }
  let found = run declarationAt(&mut resolver.*, &repeated, key.declaration)
  if let Option<DeclarationId>.Some {value} = move found {
    run Vector.append<Shared<DeclarationId>>(&mut path, run Shared.make<DeclarationId>(move value))
  }
  let rejection = run Shared.make<Rejection>(
    Rejection {
      code: RejectionCode.Cycle,
      module: move module,
      span: span,
      path: move path,
      expected: usize.ZERO,
      supplied: usize.ZERO,
      parameterName: Bytes.make(),
      expectedKind: GenericKind.Type,
      suppliedKind: GenericKind.Type,
    },
  )
  return run Shared.make<Result<Answer, NoRejection>>(
    Result.succeed<Answer, NoRejection>(
      Answer {
        outcome: Outcome.Rejected {diagnostic: move rejection},
        dependencies: Vector.make<Dependency>(),
        sources: Vector.make<Shared<Observation>>(),
        footprint: Vector.make<Shared<DemandFootprint>>(),
        answerId: usize.ZERO,
        identity: Option.none<Shared<Value>>(),
        bodyEvidence: Option.none<Shared<BodyEvidence>>(),
      },
    ),
  )
}

effect fn resolve(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  key: Key,
  candidate: Option<BodyCandidate>,
) -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  return match key.family {
    Family.Name => run resolveBucket(&mut resolver.*, &mut owner.*, key)
    Family.Import => run resolveImport(&mut resolver.*, &mut owner.*, key)
    Family.Alias => run resolveAlias(&mut resolver.*, &mut owner.*, key)
    Family.Identity => run resolveIdentity(&mut resolver.*, &mut owner.*, key)
    Family.Members => run resolveMembers(&mut resolver.*, &mut owner.*, key)
    Family.MemberShape => run resolveMemberShape(&mut resolver.*, &mut owner.*, key)
    Family.Contract => run resolveContract(&mut resolver.*, &mut owner.*, key)
    Family.Operations => run resolveOperations(&mut resolver.*, &mut owner.*, key)
    Family.Implementations => run resolveImplementations(&mut resolver.*, &mut owner.*, key)
    Family.ImplementationHead => run resolveImplementationHead(&mut resolver.*, &mut owner.*, key)
    Family.InherentMembers => run resolveInherentMembers(&mut resolver.*, &mut owner.*, key)
    Family.Signature => run resolveSignature(&mut resolver.*, &mut owner.*, key)
    Family.Constant => run resolveConstant(&mut resolver.*, &mut owner.*, key)
    Family.Initializer => run resolveInitializer(&mut resolver.*, &mut owner.*, key)
    Family.Body => run resolveBody(&mut resolver.*, &mut owner.*, key, move candidate)
  }
}

effect fn withRunning<'a, 'b>(
  resolver: &'a mut Resolver,
  query: &'b mut Query<Word, Answer, NoRejection>,
  key: Word,
  candidate: Option<BodyCandidate>,
) -> Result<Answer, NoRejection>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let base = Vector.length<Word>(&resolver.active)
  let running = Running {resolver: move resolver, query: move query, key: key, base: base}
  let use = effect fn(resource: &mut Running<'a, 'b>) -> Result<Answer, NoRejection>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator {
    run Vector.append<Word>(&mut resource.resolver.*.active, resource.key)
    run Vector.append<SourceFrame>(
      &mut resource.resolver.*.frames,
      SourceFrame {
        observations: Vector.make<Shared<Observation>>(),
        footprint: Vector.make<Shared<DemandFootprint>>(),
        direct: Vector.make<BodyDependency>(),
      },
    )
    let selected = Vector.get<Key>(&resource.resolver.keys, u64.toUsize(resource.key.value))
    let mut value = run resolve(
      &mut resource.resolver.*,
      &mut resource.query.*,
      selected,
      move candidate,
    )
    value.identity = run identityOf(&value.outcome)
    let frame = Vector.remove<SourceFrame>(&mut resource.resolver.*.frames, resource.base)
    let SourceFrame {observations, footprint, direct} = move frame
    value.sources = move observations
    value.footprint = move footprint
    let id = resource.resolver.nextAnswerId
    resource.resolver.nextAnswerId = id + usize.ONE
    value.answerId = id
    if selected.family == Family.Body && isSuccessfulBody(&value.outcome) {
      value.bodyEvidence = Option.some<Shared<BodyEvidence>>(
        run Shared.make<BodyEvidence>(BodyEvidence {direct: move direct}),
      )
    } else {
      drop direct
    }
    return Result.succeed<Answer, NoRejection>(move value)
  }
  let release = effect fn(resource: &mut Running<'a, 'b>) -> () {
    Vector.truncate<SourceFrame>(&mut resource.resolver.*.frames, resource.base)
    Vector.truncate<Word>(&mut resource.resolver.*.active, resource.base)
    return ()
  }
  return run Effect.useReleaseNonParking(move running, move use, move release)
}

effect fn demandRaw(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  key: Key,
  span: Span,
) -> Shared<Result<Answer, NoRejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let word = run internKey(&mut resolver.*, key)
  let mut at = usize.ZERO
  while at < Vector.length<Word>(&resolver.active) {
    let active = Vector.get<Word>(&resolver.active, at)
    if active.value == word.value {
      return run cycleAnswer(&mut resolver.*, key, span)
    }
    at = at + usize.ONE
  }
  let cached = Query.completed(&mut owner.*, word)
  let mut hit = false
  let mut candidate = Option.none<BodyCandidate>()
  if let Option<Shared<Result<Answer, NoRejection>>>.Some {value} = move cached {
    if Shared.with<Result<Answer, NoRejection>, bool>(
      &value,
      fn(completed: &Result<Answer, NoRejection>) -> bool {
        return validAnswer(completed, &resolver.source)
      },
    ) {
      hit = true
    } else {
      if key.family == Family.Body {
        candidate = Shared.with<Result<Answer, NoRejection>, Option<BodyCandidate>>(
          &value,
          priorCandidate,
        )
      }
      Query.forget(&mut owner.*, word)
    }
  }
  let answer = run Query.demand(
    &mut owner.*,
    word,
    effect fn(query: &mut Query<Word, Answer, NoRejection>, demanded: Word) -> Result<
      Answer,
      NoRejection,
    > ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
      run emit(&mut resolver.*, EventKind.Start, demanded)
      return run withRunning(&mut resolver.*, &mut query.*, demanded, move candidate)
    },
  )
  if hit {
    run emit(&mut resolver.*, EventKind.Hit, word)
  } else {
    run emit(&mut resolver.*, EventKind.Finish, word)
  }
  return move answer
}

fn cycleMember(family: Family) -> bool {
  return family == Family.Alias || family == Family.Import || family == Family.Initializer
}

fn cycleDiagnostic(answer: &Result<Answer, NoRejection>) -> Option<Shared<Rejection>> {
  let found = answerRejection(answer)
  if let Option<Shared<Rejection>>.Some {value} = move found {
    if Shared.with<Rejection, bool>(
      &value,
      fn(diagnostic: &Rejection) -> bool {
        return diagnostic.code == RejectionCode.Cycle
      },
    ) {
      return Option.some<Shared<Rejection>>(move value)
    }
  }
  return Option.none<Shared<Rejection>>()
}

// The member's position in the cycle, excluding the closing repeat, or `usize.MAX`.
fn cyclePosition(diagnostic: &Rejection, member: &DeclarationId) -> usize {
  let path = Vector.asSlice<Shared<DeclarationId>>(&diagnostic.path)
  let mut at = usize.ZERO
  while at + usize.ONE < path.length {
    if Shared.with<DeclarationId, bool>(
      &path[at],
      fn(id: &DeclarationId) -> bool {
        return DeclarationId.equals(id, member)
      },
    ) {
      return at
    }
    at = at + usize.ONE
  }
  return usize.MAX
}

fn cycleLength(diagnostic: &Rejection) -> usize {
  return Vector.length<Shared<DeclarationId>>(&diagnostic.path) - usize.ONE
}

fn cycleStep(diagnostic: &Rejection, at: usize) -> Shared<DeclarationId> {
  let path = Vector.asSlice<Shared<DeclarationId>>(&diagnostic.path)
  return Shared.clone<DeclarationId>(&path[at])
}

// A cycle member answers at its own reference to the next member, with the path rotated to start
// at itself. The seed rejection depends on which member a demand entered first; this answer
// depends only on the member and the cycle, so cached members agree in every demand order.
effect fn memberCycleAnswer(
  resolver: &mut Resolver,
  parent: Key,
  answer: &Shared<Result<Answer, NoRejection>>,
  span: Span,
) -> Option<Shared<Result<Answer, NoRejection>>> ! Cycle | OutOfMemoryError ? &mut Allocator {
  if !cycleMember(parent.family) {
    return Option.none<Shared<Result<Answer, NoRejection>>>()
  }
  let found = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
    answer,
    cycleDiagnostic,
  )
  let diagnostic = match move found {
    Option<Shared<Rejection>>.Some {value} => move value
    Option<Shared<Rejection>>.None => {
      return Option.none<Shared<Result<Answer, NoRejection>>>()
    }
  }
  let module = run resolvedModule(&resolver.*, parent.module)
  let owner = run declarationAt(&mut resolver.*, &module, parent.declaration)
  let member = match move owner {
    Option<DeclarationId>.Some {value} => move value
    Option<DeclarationId>.None => {
      return Option.none<Shared<Result<Answer, NoRejection>>>()
    }
  }
  let start = Shared.with<Rejection, usize>(
    &diagnostic,
    fn(cycle: &Rejection) -> usize {
      return cyclePosition(cycle, &member)
    },
  )
  if start == usize.MAX {
    return Option.none<Shared<Result<Answer, NoRejection>>>()
  }
  let count = Shared.with<Rejection, usize>(&diagnostic, cycleLength)
  let mut path = Vector.make<Shared<DeclarationId>>()
  let mut step = usize.ZERO
  while step <= count {
    let mut at = start + step
    if at >= count {
      at = at - count
    }
    let item = Shared.with<Rejection, Shared<DeclarationId>>(
      &diagnostic,
      fn(cycle: &Rejection) -> Shared<DeclarationId> {
        return cycleStep(cycle, at)
      },
    )
    run Vector.append<Shared<DeclarationId>>(&mut path, move item)
    step = step + usize.ONE
  }
  let rejection = run Shared.make<Rejection>(
    Rejection {
      code: RejectionCode.Cycle,
      module: move module,
      span: span,
      path: move path,
      expected: usize.ZERO,
      supplied: usize.ZERO,
      parameterName: Bytes.make(),
      expectedKind: GenericKind.Type,
      suppliedKind: GenericKind.Type,
    },
  )
  return Option.some<Shared<Result<Answer, NoRejection>>>(
    run Shared.make<Result<Answer, NoRejection>>(
      Result.succeed<Answer, NoRejection>(
        Answer {
          outcome: Outcome.Rejected {diagnostic: move rejection},
          dependencies: Vector.make<Dependency>(),
          sources: Vector.make<Shared<Observation>>(),
          footprint: Vector.make<Shared<DemandFootprint>>(),
          answerId: usize.ZERO,
          identity: Option.none<Shared<Value>>(),
          bodyEvidence: Option.none<Shared<BodyEvidence>>(),
        },
      ),
    ),
  )
}

effect fn demandChild(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  key: Key,
  span: Span,
) -> Shared<Result<Answer, NoRejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let answer = run demandRaw(&mut resolver.*, &mut owner.*, key, span)
  let edge = run dependency(&mut resolver.*, key)
  let active = Vector.asSlice<Word>(&resolver.active)
  let parent = Vector.get<Key>(&resolver.keys, u64.toUsize(active[active.length - usize.ONE].value))
  let mut bodyDependency = Option.none<BodyDependency>()
  if parent.family == Family.Body {
    let declaration = match & edge.declaration {
      Option<DeclarationId>.Some {value} => Option.some<Shared<DeclarationId>>(
        run Shared.make<DeclarationId>(run DeclarationId.copy(&value)),
      )
      Option<DeclarationId>.None => Option.none<Shared<DeclarationId>>()
    }
    bodyDependency = Option.some<BodyDependency>(
      BodyDependency {
        key: key,
        declaration: move declaration,
        answerId: Shared.with<Result<Answer, NoRejection>, usize>(&answer, priorAnswerId),
        identity: Shared.with<Result<Answer, NoRejection>, Option<Shared<Value>>>(
          &answer,
          answerIdentity,
        ),
      },
    )
  }
  let footprint = run Shared.make<DemandFootprint>(
    DemandFootprint {dependency: run dependency(&mut resolver.*, key)},
  )
  run Vector.append<Dependency>(&mut dependencies.*, move edge)
  let own = run memberCycleAnswer(&mut resolver.*, parent, &answer, span)
  let count = Vector.length<SourceFrame>(&resolver.frames)
  let mut frames = Vector.asMutSlice<SourceFrame>(&mut resolver.frames)
  run Vector.append<Shared<DemandFootprint>>(
    &mut frames[count - usize.ONE].footprint,
    move footprint,
  )
  if let Option<BodyDependency>.Some {value} = move bodyDependency {
    run Vector.append<BodyDependency>(&mut frames[count - usize.ONE].direct, move value)
  }
  run mergeEvidence(&mut frames[count - usize.ONE], &answer)
  // The frame keeps the child's evidence; a cycle member publishes its own rejection instead.
  if let Option<Shared<Result<Answer, NoRejection>>>.Some {value} = move own {
    return move value
  }
  return move answer
}

effect fn resolvedModule(resolver: &Resolver, ordinal: usize) -> ModuleId
! OutOfMemoryError
? &mut Allocator {
  let modules = Vector.asSlice<ModuleId>(&resolver.modules)
  return run ModuleId.copy(&modules[ordinal])
}

effect fn resolvedName(resolver: &Resolver, ordinal: usize) -> Bytes
! OutOfMemoryError
? &mut Allocator {
  let names = Vector.asSlice<Bytes>(&resolver.names)
  return run Bytes.copy(Bytes.asSlice(&names[ordinal]))
}

effect fn resolveBucket(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  key: Key,
) -> Answer ! Cycle | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let module = run resolvedModule(&resolver.*, key.module)
  let name = run resolvedName(&resolver.*, key.name)
  let sourceAnswer = run source(&mut resolver.*, &module)
  let bucket = run SourceIndex.observeName(
    &mut resolver.source,
    &sourceAnswer,
    &module,
    Bytes.asSlice(&name),
  )
  if let Option<Shared<NameObservation>>.Some {value} = move bucket {
    return Answer {
      outcome: Outcome.Success {value: Value.Name {bucket: move value}},
      dependencies: Vector.make<Dependency>(),
      sources: Vector.make<Shared<Observation>>(),
      footprint: Vector.make<Shared<DemandFootprint>>(),
      answerId: usize.ZERO,
      identity: Option.none<Shared<Value>>(),
      bodyEvidence: Option.none<Shared<BodyEvidence>>(),
    }
  }
  let diagnostic = run reject(
    &resolver.*,
    &module,
    RejectionCode.MissingModule,
    Span.make(usize.ZERO, usize.ZERO),
  )
  return Answer {
    outcome: Outcome.Rejected {diagnostic: move diagnostic},
    dependencies: Vector.make<Dependency>(),
    sources: Vector.make<Shared<Observation>>(),
    footprint: Vector.make<Shared<DemandFootprint>>(),
    answerId: usize.ZERO,
    identity: Option.none<Shared<Value>>(),
    bodyEvidence: Option.none<Shared<BodyEvidence>>(),
  }
}

effect fn importedMember(resolver: &mut Resolver, module: &ModuleId, ordinal: usize, member: usize) -> Option<
  PathSyntax,
> ! Cycle | OutOfMemoryError ? &mut Allocator {
  let answer = run source(&mut resolver.*, module)
  if let Option<&IndexedSource>.Some {value} = move sourceOf(&resolver.*, &answer, module) {
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(value))
    if ordinal < declarations.length {
      let hir = IndexedSource.authored(value)
      if let Node.ImportHeader {members, ..} = Module.node(hir, declarations[ordinal].header) {
        if members.present && member < members.range.length {
          let id = Module.child(hir, members.range, member)
          if let Node.ImportMember {name, ..} = Module.node(hir, id) {
            if let Node.Name {text} = Module.node(hir, name) {
              let mut names = Vector.make<Bytes>()
              run Vector.append<Bytes>(&mut names, run Bytes.copy(Module.text(hir, text)))
              return Option.some<PathSyntax>(
                PathSyntax {segments: move names, span: Module.span(hir, name), valid: true},
              )
            }
            return Option.some<PathSyntax>(
              PathSyntax {
                segments: Vector.make<Bytes>(),
                span: Module.span(hir, name),
                valid: false,
              },
            )
          }
        }
      }
    }
  }
  return Option.none<PathSyntax>()
}

effect fn modulePath(syntax: &PathSyntax) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let segments = Vector.asSlice<Bytes>(&syntax.segments)
  let mut joined = Bytes.make()
  let mut at = usize.ZERO
  while at < segments.length {
    if at > usize.ZERO {
      run Bytes.append(&mut joined, b"/")
    }
    run Bytes.append(&mut joined, Bytes.asSlice(&segments[at]))
    at = at + usize.ONE
  }
  run Bytes.append(&mut joined, b".silk")
  return move joined
}

effect fn resolveImport(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  key: Key,
) -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let module = run resolvedModule(&resolver.*, key.module)
  let mut dependencies = Vector.make<Dependency>()
  let written = run header(&mut resolver.*, &module, key.declaration)
  if let Option<HeaderSyntax>.Some {value} = move written {
    if let Node.ImportHeader {path: importPath, isPublic, members, ..} = value.header {
      if isPublic && !members.present {
        let diagnostic = run reject(&resolver.*, &module, RejectionCode.Unsupported, value.span)
        return Answer {
          outcome: Outcome.Rejected {diagnostic: move diagnostic},
          dependencies: move dependencies,
          sources: Vector.make<Shared<Observation>>(),
          footprint: Vector.make<Shared<DemandFootprint>>(),
          answerId: usize.ZERO,
          identity: Option.none<Shared<Value>>(),
          bodyEvidence: Option.none<Shared<BodyEvidence>>(),
        }
      }
      let targetPath = run path(&mut resolver.*, &module, importPath)
      if !targetPath.valid {
        let diagnostic = run reject(
          &resolver.*,
          &module,
          RejectionCode.Unsupported,
          targetPath.span,
        )
        return Answer {
          outcome: Outcome.Rejected {diagnostic: move diagnostic},
          dependencies: move dependencies,
          sources: Vector.make<Shared<Observation>>(),
          footprint: Vector.make<Shared<DemandFootprint>>(),
          answerId: usize.ZERO,
          identity: Option.none<Shared<Value>>(),
          bodyEvidence: Option.none<Shared<BodyEvidence>>(),
        }
      }
      let targetText = run modulePath(&targetPath)
      let target = run ModuleId.make(
        ModuleId.sourceOrigin(&module),
        ModuleId.packageIdentity(&module),
        Bytes.asSlice(&targetText),
      )
      let targetSource = run source(&mut resolver.*, &target)
      if let Option<&IndexedSource>.None = move sourceOf(&resolver.*, &targetSource, &target) {
        let diagnostic = run reject(
          &resolver.*,
          &module,
          RejectionCode.MissingModule,
          targetPath.span,
        )
        return Answer {
          outcome: Outcome.Rejected {diagnostic: move diagnostic},
          dependencies: move dependencies,
          sources: Vector.make<Shared<Observation>>(),
          footprint: Vector.make<Shared<DemandFootprint>>(),
          answerId: usize.ZERO,
          identity: Option.none<Shared<Value>>(),
          bodyEvidence: Option.none<Shared<BodyEvidence>>(),
        }
      }
      let targetOrdinal = run internModule(&mut resolver.*, &target)
      if key.member == usize.MAX {
        return Answer {
          outcome: Outcome.Success {
            value: Value.Namespace {module: move target, ordinal: targetOrdinal},
          },
          dependencies: move dependencies,
          sources: Vector.make<Shared<Observation>>(),
          footprint: Vector.make<Shared<DemandFootprint>>(),
          answerId: usize.ZERO,
          identity: Option.none<Shared<Value>>(),
          bodyEvidence: Option.none<Shared<BodyEvidence>>(),
        }
      }
      let selected = run importedMember(&mut resolver.*, &module, key.declaration, key.member)
      if let Option<PathSyntax>.Some {value: member} = move selected {
        if !member.valid {
          let diagnostic = run reject(&resolver.*, &module, RejectionCode.Unsupported, member.span)
          return Answer {
            outcome: Outcome.Rejected {diagnostic: move diagnostic},
            dependencies: move dependencies,
            sources: Vector.make<Shared<Observation>>(),
            footprint: Vector.make<Shared<DemandFootprint>>(),
            answerId: usize.ZERO,
            identity: Option.none<Shared<Value>>(),
            bodyEvidence: Option.none<Shared<BodyEvidence>>(),
          }
        }
        let names = Vector.asSlice<Bytes>(&member.segments)
        let selectedName = Bytes.asSlice(&names[usize.ZERO])
        let nameOrdinal = run internName(&mut resolver.*, selectedName)
        let lookup = Key {
          family: Family.Name,
          module: targetOrdinal,
          name: nameOrdinal,
          declaration: usize.ZERO,
          member: usize.ZERO,
          external: true,
        }
        let observed = run demandChild(
          &mut resolver.*,
          &mut owner.*,
          &mut dependencies,
          lookup,
          member.span,
        )
        drop observed
        let candidate = run select(&mut resolver.*, &target, selectedName, true)
        if candidate.count == usize.ZERO || candidate.publicCount == usize.ZERO || candidate.count > usize.ONE {
          let mut code = RejectionCode.Collision
          if candidate.count == usize.ZERO {
            code = RejectionCode.UnknownMember
          } else if candidate.publicCount == usize.ZERO {
            code = RejectionCode.PrivateMember
          }
          let diagnostic = run reject(&resolver.*, &module, code, member.span)
          return Answer {
            outcome: Outcome.Rejected {diagnostic: move diagnostic},
            dependencies: move dependencies,
            sources: Vector.make<Shared<Observation>>(),
            footprint: Vector.make<Shared<DemandFootprint>>(),
            answerId: usize.ZERO,
            identity: Option.none<Shared<Value>>(),
            bodyEvidence: Option.none<Shared<BodyEvidence>>(),
          }
        }
        if candidate.kind == CandidateKind.ImportMember {
          let nestedKey = Key {
            family: Family.Import,
            module: targetOrdinal,
            name: usize.ZERO,
            declaration: candidate.declaration,
            member: candidate.member,
            external: false,
          }
          let nested = run demandChild(
            &mut resolver.*,
            &mut owner.*,
            &mut dependencies,
            nestedKey,
            member.span,
          )
          let binding = Shared.with<Result<Answer, NoRejection>, ImportSelection>(
            &nested,
            selectedImport,
          )
          if let Option<Shared<Rejection>>.Some {value: diagnostic} = move binding.rejected {
            return Answer {
              outcome: Outcome.Rejected {diagnostic: move diagnostic},
              dependencies: move dependencies,
              sources: Vector.make<Shared<Observation>>(),
              footprint: Vector.make<Shared<DemandFootprint>>(),
              answerId: usize.ZERO,
              identity: Option.none<Shared<Value>>(),
              bodyEvidence: Option.none<Shared<BodyEvidence>>(),
            }
          }
          if let Option<usize>.Some {value: targetModuleOrdinal} = move binding.module {
            if let Option<usize>.Some {value: resolvedDeclaration} = move binding.declaration {
              let canonical = run resolvedModule(&resolver.*, targetModuleOrdinal)
              let declaration = run declarationAt(&mut resolver.*, &canonical, resolvedDeclaration)
              if let Option<DeclarationId>.Some {value: id} = move declaration {
                return Answer {
                  outcome: Outcome.Success {
                    value: Value.Selected {
                      declaration: move id,
                      module: targetModuleOrdinal,
                      ordinal: resolvedDeclaration,
                    },
                  },
                  dependencies: move dependencies,
                  sources: Vector.make<Shared<Observation>>(),
                  footprint: Vector.make<Shared<DemandFootprint>>(),
                  answerId: usize.ZERO,
                  identity: Option.none<Shared<Value>>(),
                  bodyEvidence: Option.none<Shared<BodyEvidence>>(),
                }
              }
            }
          }
        }
        if candidate.kind != CandidateKind.Declaration {
          let diagnostic = run reject(&resolver.*, &module, RejectionCode.Unsupported, member.span)
          return Answer {
            outcome: Outcome.Rejected {diagnostic: move diagnostic},
            dependencies: move dependencies,
            sources: Vector.make<Shared<Observation>>(),
            footprint: Vector.make<Shared<DemandFootprint>>(),
            answerId: usize.ZERO,
            identity: Option.none<Shared<Value>>(),
            bodyEvidence: Option.none<Shared<BodyEvidence>>(),
          }
        }
        let declaration = run declarationAt(&mut resolver.*, &target, candidate.declaration)
        if let Option<DeclarationId>.Some {value: id} = move declaration {
          return Answer {
            outcome: Outcome.Success {
              value: Value.Selected {
                declaration: move id,
                module: targetOrdinal,
                ordinal: candidate.declaration,
              },
            },
            dependencies: move dependencies,
            sources: Vector.make<Shared<Observation>>(),
            footprint: Vector.make<Shared<DemandFootprint>>(),
            answerId: usize.ZERO,
            identity: Option.none<Shared<Value>>(),
            bodyEvidence: Option.none<Shared<BodyEvidence>>(),
          }
        }
      }
    }
    let diagnostic = run reject(&resolver.*, &module, RejectionCode.Unsupported, value.span)
    return Answer {
      outcome: Outcome.Rejected {diagnostic: move diagnostic},
      dependencies: move dependencies,
      sources: Vector.make<Shared<Observation>>(),
      footprint: Vector.make<Shared<DemandFootprint>>(),
      answerId: usize.ZERO,
      identity: Option.none<Shared<Value>>(),
      bodyEvidence: Option.none<Shared<BodyEvidence>>(),
    }
  }
  let diagnostic = run reject(
    &resolver.*,
    &module,
    RejectionCode.Unsupported,
    Span.make(usize.ZERO, usize.ZERO),
  )
  return Answer {
    outcome: Outcome.Rejected {diagnostic: move diagnostic},
    dependencies: move dependencies,
    sources: Vector.make<Shared<Observation>>(),
    footprint: Vector.make<Shared<DemandFootprint>>(),
    answerId: usize.ZERO,
    identity: Option.none<Shared<Value>>(),
    bodyEvidence: Option.none<Shared<BodyEvidence>>(),
  }
}

effect fn typeNode(resolver: &mut Resolver, module: &ModuleId, id: HirId) -> Option<HeaderSyntax>
! Cycle | OutOfMemoryError
? &mut Allocator {
  let answer = run source(&mut resolver.*, module)
  if let Option<&IndexedSource>.Some {value} = move sourceOf(&resolver.*, &answer, module) {
    let hir = IndexedSource.authored(value)
    return Option.some<HeaderSyntax>(
      HeaderSyntax {header: Module.node(hir, id), span: Module.span(hir, id)},
    )
  }
  return Option.none<HeaderSyntax>()
}

effect fn typeChild(resolver: &mut Resolver, module: &ModuleId, range: Range, at: usize) -> Option<
  HirId,
> ! Cycle | OutOfMemoryError ? &mut Allocator {
  let answer = run source(&mut resolver.*, module)
  if let Option<&IndexedSource>.Some {value} = move sourceOf(&resolver.*, &answer, module) {
    return Option.some<HirId>(Module.child(IndexedSource.authored(value), range, at))
  }
  return Option.none<HirId>()
}

effect fn lifetimeAt(resolver: &mut Resolver, module: &ModuleId, id: HirId, binders: &[Binder]) -> Result<
  Shared<Lifetime>,
  Shared<Rejection>,
> ! Cycle | OutOfMemoryError ? &mut Allocator {
  let syntax = run typeNode(&mut resolver.*, module, id)
  if let Option<HeaderSyntax>.Some {value} = move syntax {
    if let Node.Lifetime {name} = value.header {
      let named = run typeNode(&mut resolver.*, module, name)
      if let Option<HeaderSyntax>.Some {value: token} = move named {
        if let Node.Name {text} = token.header {
          let source = run source(&mut resolver.*, module)
          if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(
            &resolver.*,
            &source,
            module,
          ) {
            let spelling = Module.text(IndexedSource.authored(indexed), text)
            if same(spelling, b"'static") {
              return Result.succeed<Shared<Lifetime>, Shared<Rejection>>(
                run Shared.make<Lifetime>(Lifetime.Static),
              )
            }
            let mut at = usize.ZERO
            while at < binders.length {
              if let Binder.Lifetime {name: bound, value: lifetime} = &binders[at] {
                if same(Bytes.asSlice(&bound), spelling) {
                  return Result.succeed<Shared<Lifetime>, Shared<Rejection>>(
                    Shared.clone<Lifetime>(&lifetime),
                  )
                }
              }
              at = at + usize.ONE
            }
            return Result.failResult<Shared<Lifetime>, Shared<Rejection>>(
              run reject(&resolver.*, module, RejectionCode.UnknownLifetime, value.span),
            )
          }
        }
      }
    }
    return Result.failResult<Shared<Lifetime>, Shared<Rejection>>(
      run reject(&resolver.*, module, RejectionCode.InvalidLifetime, value.span),
    )
  }
  return Result.failResult<Shared<Lifetime>, Shared<Rejection>>(
    run reject(
      &resolver.*,
      module,
      RejectionCode.InvalidLifetime,
      Span.make(usize.ZERO, usize.ZERO),
    ),
  )
}

effect fn elidedLifetime(
  resolver: &mut Resolver,
  module: &ModuleId,
  span: Span,
  elision: &mut LifetimeElision,
) -> Result<Shared<Lifetime>, Shared<Rejection>> ! OutOfMemoryError ? &mut Allocator {
  if elision.output {
    if let Option<Shared<Lifetime>>.Some {value} = &elision.resultDefault {
      return Result.succeed<Shared<Lifetime>, Shared<Rejection>>(Shared.clone<Lifetime>(&value))
    }
    return Result.failResult<Shared<Lifetime>, Shared<Rejection>>(
      run reject(&resolver.*, module, RejectionCode.AmbiguousLifetime, span),
    )
  }
  if elision.invocation {
    if elision.nested {
      return Result.failResult<Shared<Lifetime>, Shared<Rejection>>(
        run reject(&resolver.*, module, RejectionCode.NestedQuantifier, span),
      )
    }
    let lifetime = run Shared.make<Lifetime>(
      Lifetime.Invocation {ordinal: renumbered(&elision.renumber, elision.nextOrdinal)},
    )
    elision.nextOrdinal = elision.nextOrdinal + usize.ONE
    run Vector.append<Shared<Lifetime>>(&mut elision.generated, Shared.clone<Lifetime>(&lifetime))
    return Result.succeed<Shared<Lifetime>, Shared<Rejection>>(move lifetime)
  }
  if let Option<DeclarationId>.Some {value: owner} = &elision.owner {
    let lifetime = run Shared.make<Lifetime>(
      Lifetime.Parameter {declaration: run DeclarationId.copy(&owner), ordinal: elision.nextOrdinal},
    )
    elision.nextOrdinal = elision.nextOrdinal + usize.ONE
    run Vector.append<Shared<Lifetime>>(&mut elision.generated, Shared.clone<Lifetime>(&lifetime))
    return Result.succeed<Shared<Lifetime>, Shared<Rejection>>(move lifetime)
  }
  // Body-local elided lifetimes have no represented owner yet.
  return Result.failResult<Shared<Lifetime>, Shared<Rejection>>(
    run reject(&resolver.*, module, RejectionCode.Unsupported, span),
  )
}

effect fn writtenOrElidedLifetime(
  resolver: &mut Resolver,
  module: &ModuleId,
  written: HirRef,
  span: Span,
  binders: &[Binder],
  elision: &mut LifetimeElision,
) -> Result<Shared<Lifetime>, Shared<Rejection>> ! Cycle | OutOfMemoryError ? &mut Allocator {
  if written.present {
    return run lifetimeAt(&mut resolver.*, module, written.id, binders)
  }
  return run elidedLifetime(&mut resolver.*, module, span, &mut elision.*)
}

effect fn templateBinders(resolver: &mut Resolver, module: &ModuleId, ordinal: usize) -> Result<
  Vector<Binder>,
  Shared<Rejection>,
> ! Cycle | OutOfMemoryError ? &mut Allocator {
  let mut binders = Vector.make<Binder>()
  let identity = run declarationAt(&mut resolver.*, module, ordinal)
  let answer = run source(&mut resolver.*, module)
  if let Option<&IndexedSource>.Some {value} = move sourceOf(&resolver.*, &answer, module) {
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(value))
    if ordinal >= declarations.length {
      return Result.succeed<Vector<Binder>, Shared<Rejection>>(move binders)
    }
    let hir = IndexedSource.authored(value)
    let written = Module.node(hir, declarations[ordinal].header)
    let mut generics = Range.empty()
    // Bounds are recorded by the declaration's Contract or Signature; a use that needs one proved
    // is rejected where the declaration is applied.
    if let Node.FunctionHeader {contract, ..} = written {
      if let Node.CallableContract {generics: parameters, ..} = Module.node(hir, contract) {
        generics = parameters
      }
    }
    if let Node.OperationHeader {contract, ..} = written {
      if let Node.CallableContract {generics: parameters, ..} = Module.node(hir, contract) {
        generics = parameters
      }
    }
    if let Node.StructHeader {generics: parameters, ..} = written {
      generics = parameters
    }
    if let Node.TupleHeader {generics: parameters, ..} = written {
      generics = parameters
    }
    if let Node.UnionHeader {generics: parameters, ..} = written {
      generics = parameters
    }
    if let Node.ServiceHeader {generics: parameters, ..} = written {
      generics = parameters
    }
    if let Node.InterfaceHeader {generics: parameters, ..} = written {
      generics = parameters
    }
    if let Node.AliasHeader {generics: parameters, ..} = written {
      generics = parameters
    }
    if let Node.ImplHeader {generics: parameters, ..} = written {
      generics = parameters
    }
    let generated = omittedFieldLifetimes(hir, written)
    if generics.length == usize.ZERO && generated == usize.ZERO {
      return Result.succeed<Vector<Binder>, Shared<Rejection>>(move binders)
    }
    if let Option<DeclarationId>.Some {value: owner} = move identity {
      let mut at = usize.ZERO
      while at < generics.length {
        let parameter = Module.child(hir, generics, at)
        let syntax = Module.node(hir, parameter)
        if let Node.RowParameter {name} = syntax {
          if let Node.Name {text} = Module.node(hir, name) {
            let spelling = Module.text(hir, text)
            if hasBinder(Vector.asSlice<Binder>(&binders), spelling) {
              return Result.failResult<Vector<Binder>, Shared<Rejection>>(
                run reject(
                  &resolver.*,
                  module,
                  RejectionCode.DuplicateTypeParameter,
                  Module.span(hir, parameter),
                ),
              )
            }
            run Vector.append<Binder>(
              &mut binders,
              Binder.Row {
                name: run Bytes.copy(spelling),
                value: RowParameter {
                  declaration: run Shared.make<DeclarationId>(run DeclarationId.copy(&owner)),
                  ordinal: at,
                },
                bound: Option.none<Shared<Row>>(),
              },
            )
            at = at + usize.ONE
            continue
          }
        }
        if let Node.TypeParameter {name, ..} = syntax {
          if let Node.Name {text} = Module.node(hir, name) {
            let spelling = Module.text(hir, text)
            let prior = Vector.asSlice<Binder>(&binders)
            let mut before = usize.ZERO
            while before < prior.length {
              if same(binderName(&prior[before]), spelling) {
                return Result.failResult<Vector<Binder>, Shared<Rejection>>(
                  run reject(
                    &resolver.*,
                    module,
                    RejectionCode.DuplicateTypeParameter,
                    Module.span(hir, parameter),
                  ),
                )
              }
              before = before + usize.ONE
            }
            let parameterOwner = run DeclarationId.copy(&owner)
            let parameterType = run Shared.make<Type>(
              Type.Parameter {declaration: move parameterOwner, ordinal: at},
            )
            run Vector.append<Binder>(
              &mut binders,
              Binder.Type {name: run Bytes.copy(spelling), value: move parameterType},
            )
            at = at + usize.ONE
            continue
          }
        }
        if let Node.LifetimeParameter {name, ..} = syntax {
          if let Node.Name {text} = Module.node(hir, name) {
            let spelling = Module.text(hir, text)
            if same(spelling, b"'static") {
              return Result.failResult<Vector<Binder>, Shared<Rejection>>(
                run reject(
                  &resolver.*,
                  module,
                  RejectionCode.InvalidLifetime,
                  Module.span(hir, parameter),
                ),
              )
            }
            let prior = Vector.asSlice<Binder>(&binders)
            let mut before = usize.ZERO
            while before < prior.length {
              if same(binderName(&prior[before]), spelling) {
                return Result.failResult<Vector<Binder>, Shared<Rejection>>(
                  run reject(
                    &resolver.*,
                    module,
                    RejectionCode.DuplicateLifetimeParameter,
                    Module.span(hir, parameter),
                  ),
                )
              }
              before = before + usize.ONE
            }
            run Vector.append<Binder>(
              &mut binders,
              Binder.Lifetime {
                name: run Bytes.copy(spelling),
                value: run Shared.make<Lifetime>(
                  Lifetime.Parameter {declaration: run DeclarationId.copy(&owner), ordinal: at},
                ),
              },
            )
            at = at + usize.ONE
            continue
          }
        }
        return Result.failResult<Vector<Binder>, Shared<Rejection>>(
          run reject(&resolver.*, module, RejectionCode.Unsupported, Module.span(hir, parameter)),
        )
      }
      // LIFE-003: each omitted borrowed field lifetime is an independent declaration parameter,
      // bound after the written binders in field order. It has no spelling a use could name.
      let mut index = usize.ZERO
      while index < generated {
        run Vector.append<Binder>(
          &mut binders,
          Binder.Lifetime {
            name: Bytes.make(),
            value: run Shared.make<Lifetime>(
              Lifetime.Parameter {declaration: run DeclarationId.copy(&owner), ordinal: at + index},
            ),
          },
        )
        index = index + usize.ONE
      }
      return Result.succeed<Vector<Binder>, Shared<Rejection>>(move binders)
    }
  }
  return Result.failResult<Vector<Binder>, Shared<Rejection>>(
    run reject(&resolver.*, module, RejectionCode.Unsupported, Span.make(usize.ZERO, usize.ZERO)),
  )
}

// Counts the lifetimes one written type leaves to declaration elision: an omitted borrow, slice, or
// `string` lifetime, including inside type arguments, array elements, pointees, and union members.
// Callable and Effect contracts, nominal lifetime arguments, and aliases are not counted; a field
// whose resolution needs more generated lifetimes than this stays an unsupported member shape.
fn omittedLifetimes(hir: &Module, id: HirId) -> usize {
  return match Module.node(hir, id) {
    Node.ReferenceType {referent, lifetime, ..} => absentLifetime(lifetime) + omittedLifetimes(
      hir,
      referent,
    )
    Node.SliceType {element, lifetime, ..} => absentLifetime(lifetime) + omittedLifetimes(
      hir,
      element,
    )
    Node.PointerType {pointee, ..} => omittedLifetimes(hir, pointee)
    Node.FixedArrayType {element, ..} => omittedLifetimes(hir, element)
    Node.UnionType {members} => omittedIn(hir, members)
    Node.NamedType {path, ..} => bareString(hir, path)
    Node.AppliedType {arguments, ..} => match Module.node(hir, arguments) {
      Node.TypeArguments {arguments: supplied, ..} => omittedIn(hir, supplied)
      _ => usize.ZERO
    }
    _ => usize.ZERO
  }
}

fn absentLifetime(lifetime: HirRef) -> usize {
  if lifetime.present {
    return usize.ZERO
  }
  return usize.ONE
}

fn omittedIn(hir: &Module, types: Range) -> usize {
  let mut count = usize.ZERO
  let mut at = usize.ZERO
  while at < types.length {
    count = count + omittedLifetimes(hir, Module.child(hir, types, at))
    at = at + usize.ONE
  }
  return count
}

// One for an unapplied `string`, whose view lifetime is then omitted.
fn bareString(hir: &Module, path: HirId) -> usize {
  if let Node.Path {segments} = Module.node(hir, path) {
    if segments.length == usize.ONE {
      if let Node.Name {text} = Module.node(hir, Module.child(hir, segments, usize.ZERO)) {
        if same(Module.text(hir, text), b"string") {
          return usize.ONE
        }
      }
    }
  }
  return usize.ZERO
}

// The generated lifetime parameters of a struct, tuple, or union header, in field order.
fn omittedFieldLifetimes(hir: &Module, header: Node) -> usize {
  let mut count = usize.ZERO
  if let Node.StructHeader {fields, ..} = header {
    count = fieldLifetimes(hir, fields)
  }
  if let Node.TupleHeader {elements, ..} = header {
    count = omittedIn(hir, elements)
  }
  if let Node.UnionHeader {variants, ..} = header {
    let mut at = usize.ZERO
    while at < variants.length {
      if let Node.Variant {fields, ..} = Module.node(hir, Module.child(hir, variants, at)) {
        count = count + fieldLifetimes(hir, fields)
      }
      at = at + usize.ONE
    }
  }
  return count
}

fn fieldLifetimes(hir: &Module, fields: Range) -> usize {
  let mut count = usize.ZERO
  let mut at = usize.ZERO
  while at < fields.length {
    if let Node.Field {annotation, ..} = Module.node(hir, Module.child(hir, fields, at)) {
      count = count + omittedLifetimes(hir, annotation)
    }
    at = at + usize.ONE
  }
  return count
}

fn copyBound(bound: &Option<Shared<Row>>) -> Option<Shared<Row>> {
  return match & bound.* {
    Option<Shared<Row>>.Some {value} => Option.some<Shared<Row>>(Shared.clone<Row>(&value))
    Option<Shared<Row>>.None => Option.none<Shared<Row>>()
  }
}

fn binderName(binder: &Binder) -> &[u8] {
  return match & binder.* {
    Binder.Type {name, ..} => Bytes.asSlice(&name)
    Binder.Lifetime {name, ..} => Bytes.asSlice(&name)
    Binder.Row {name, ..} => Bytes.asSlice(&name)
  }
}

fn hasBinder(binders: &[Binder], spelling: &[u8]) -> bool {
  let mut at = usize.ZERO
  while at < binders.length {
    if same(binderName(&binders[at]), spelling) {
      return true
    }
    at = at + usize.ONE
  }
  return false
}

effect fn bindArguments(template: &[Binder], arguments: &[Argument]) -> Vector<Binder>
! OutOfMemoryError
? &mut Allocator {
  let mut applied = Vector.make<Binder>()
  let mut at = usize.ZERO
  while at < template.length {
    let bound = match & template[at] {
      Binder.Type {name, value: original} => match & arguments[at] {
        Argument.Type {value} => Binder.Type {
          name: run Bytes.copy(Bytes.asSlice(&name)),
          value: Shared.clone<Type>(&value),
        }
        _ => Binder.Type {
          name: run Bytes.copy(Bytes.asSlice(&name)),
          value: Shared.clone<Type>(&original),
        }
      }
      Binder.Lifetime {name, value: original} => match & arguments[at] {
        Argument.Lifetime {value} => Binder.Lifetime {
          name: run Bytes.copy(Bytes.asSlice(&name)),
          value: Shared.clone<Lifetime>(&value),
        }
        _ => Binder.Lifetime {
          name: run Bytes.copy(Bytes.asSlice(&name)),
          value: Shared.clone<Lifetime>(&original),
        }
      }
      Binder.Row {name, value, bound: prior} => Binder.Row {
        name: run Bytes.copy(Bytes.asSlice(&name)),
        value: RowParameter {
          declaration: Shared.clone<DeclarationId>(&value.declaration),
          ordinal: value.ordinal,
        },
        bound: match & arguments[at] {
          Argument.Row {value: supplied} => Option.some<Shared<Row>>(Shared.clone<Row>(&supplied))
          _ => copyBound(&prior)
        },
      }
    }
    run Vector.append<Binder>(&mut applied, move bound)
    at = at + usize.ONE
  }
  return move applied
}

effect fn typeFromAnswer(answer: &Shared<Result<Answer, NoRejection>>) -> TypeSelection {
  return Shared.with<Result<Answer, NoRejection>, TypeSelection>(answer, selectedType)
}

fn privateNominal(resolved: &Type) -> bool {
  return match & resolved.* {
    Type.Nominal {isPublic, arguments, ..} => {
      if !isPublic {
        return true
      }
      let values = Vector.asSlice<Argument>(&arguments)
      let mut at = usize.ZERO
      while at < values.length {
        if let Argument.Type {value} = &values[at] {
          if Shared.with<Type, bool>(&value, privateNominal) {
            return true
          }
        }
        if let Argument.Row {value: row} = &values[at] {
          if Shared.with<Row, bool>(&row, privateRow) {
            return true
          }
        }
        at = at + usize.ONE
      }
      return false
    }
    Type.Reference {referent, ..} => Shared.with<Type, bool>(&referent, privateNominal)
    Type.Slice {element, ..} => Shared.with<Type, bool>(&element, privateNominal)
    Type.Pointer {pointee, ..} => Shared.with<Type, bool>(&pointee, privateNominal)
    Type.Array {element, ..} => Shared.with<Type, bool>(&element, privateNominal)
    Type.Union {members} => anyPrivate(&members)
    Type.Callable {parameters, result, ..} => anyPrivate(&parameters) || Shared.with<Type, bool>(
      &result,
      privateNominal,
    )
    Type.Effect {success, failure, requirements, ..} => Shared.with<Type, bool>(
      &success,
      privateNominal,
    ) || Shared.with<Type, bool>(&failure, privateNominal) || Shared.with<Row, bool>(
      &requirements,
      privateRow,
    )
    _ => false
  }
}

fn anyPrivate(types: &Vector<Shared<Type>>) -> bool {
  let values = Vector.asSlice<Shared<Type>>(types)
  let mut at = usize.ZERO
  while at < values.length {
    if Shared.with<Type, bool>(&values[at], privateNominal) {
      return true
    }
    at = at + usize.ONE
  }
  return false
}

fn privateRow(row: &Row) -> bool {
  let entries = Vector.asSlice<Requirement>(&row.entries)
  let mut at = usize.ZERO
  while at < entries.length {
    if Shared.with<Type, bool>(&entries[at].capability, privateNominal) {
      return true
    }
    at = at + usize.ONE
  }
  return false
}

fn outerLifetime(resolved: &Type) -> Option<Shared<Lifetime>> {
  return match & resolved.* {
    Type.Reference {lifetime, ..} => Option.some<Shared<Lifetime>>(
      Shared.clone<Lifetime>(&lifetime),
    )
    Type.Slice {lifetime, ..} => Option.some<Shared<Lifetime>>(Shared.clone<Lifetime>(&lifetime))
    Type.String {lifetime} => Option.some<Shared<Lifetime>>(Shared.clone<Lifetime>(&lifetime))
    _ => Option.none<Shared<Lifetime>>()
  }
}

effect fn exposedPrivate(
  resolver: &mut Resolver,
  module: &ModuleId,
  typeId: HirId,
  resolved: &Shared<Type>,
  publicContract: bool,
) -> Option<Shared<Rejection>> ! Cycle | OutOfMemoryError ? &mut Allocator {
  if !publicContract || !Shared.with<Type, bool>(resolved, privateNominal) {
    return Option.none<Shared<Rejection>>()
  }
  let syntax = run typeNode(&mut resolver.*, module, typeId)
  if let Option<HeaderSyntax>.Some {value} = move syntax {
    return Option.some<Shared<Rejection>>(
      run reject(&resolver.*, module, RejectionCode.PrivateTypeExposure, value.span),
    )
  }
  return Option.some<Shared<Rejection>>(
    run reject(
      &resolver.*,
      module,
      RejectionCode.PrivateTypeExposure,
      Span.make(usize.ZERO, usize.ZERO),
    ),
  )
}

fn rowBinderCount(binders: &[Binder]) -> usize {
  let mut count = usize.ZERO
  let mut at = usize.ZERO
  while at < binders.length {
    if let Binder.Row {..} = &binders[at] {
      count = count + usize.ONE
    }
    at = at + usize.ONE
  }
  return count
}

fn headerGenerics(header: Node) -> Range {
  return match header {
    Node.StructHeader {generics, ..} => generics
    Node.TupleHeader {generics, ..} => generics
    Node.UnionHeader {generics, ..} => generics
    Node.ServiceHeader {generics, ..} => generics
    Node.InterfaceHeader {generics, ..} => generics
    Node.AliasHeader {generics, ..} => generics
    _ => Range.empty()
  }
}

// Whether a type, alias, interface, or service declaration writes a bound that needs proof: an
// interface, service, or representation bound. Lifetime bounds are recorded without a proof claim.
effect fn declaresBounds(resolver: &mut Resolver, module: &ModuleId, ordinal: usize) -> bool
! Cycle | OutOfMemoryError
? &mut Allocator {
  let written = run header(&mut resolver.*, module, ordinal)
  if let Option<HeaderSyntax>.Some {value} = move written {
    let generics = headerGenerics(value.header)
    let mut at = usize.ZERO
    while at < generics.length {
      let child = run typeChild(&mut resolver.*, module, generics, at)
      if let Option<HirId>.Some {value: parameterId} = move child {
        let syntax = run typeNode(&mut resolver.*, module, parameterId)
        if let Option<HeaderSyntax>.Some {value: parameter} = move syntax {
          if let Node.TypeParameter {bounds, ..} = parameter.header {
            let mut boundAt = usize.ZERO
            while boundAt < bounds.length {
              let bound = run typeChild(&mut resolver.*, module, bounds, boundAt)
              if let Option<HirId>.Some {value: boundId} = move bound {
                let boundSyntax = run typeNode(&mut resolver.*, module, boundId)
                if let Option<HeaderSyntax>.Some {value: boundNode} = move boundSyntax {
                  let mut lifetimeBound = false
                  if let Node.Lifetime {..} = boundNode.header {
                    lifetimeBound = true
                  }
                  if !lifetimeBound {
                    return true
                  }
                }
              }
              boundAt = boundAt + usize.ONE
            }
          }
        }
      }
      at = at + usize.ONE
    }
  }
  return false
}

effect fn declarationType(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  moduleOrdinal: usize,
  declaration: usize,
  anchor: &ModuleId,
  span: Span,
  application: Option<HirId>,
  callerBinders: &[Binder],
  callerElision: &mut LifetimeElision,
) -> Result<Shared<Type>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let module = run resolvedModule(&resolver.*, moduleOrdinal)
  let written = run header(&mut resolver.*, &module, declaration)
  if let Option<HeaderSyntax>.Some {value} = move written {
    let family = match value.header {
      Node.AliasHeader {..} => Family.Alias
      Node.StructHeader {..} => Family.Identity
      Node.TupleHeader {..} => Family.Identity
      Node.EnumHeader {..} => Family.Identity
      Node.UnionHeader {..} => Family.Identity
      Node.ServiceHeader {..} => Family.Identity
      Node.InterfaceHeader {..} => Family.Identity
      Node.RoleHeader {..} => Family.Identity
      _ => {
        return Result.failResult<Shared<Type>, Shared<Rejection>>(
          run reject(&resolver.*, anchor, RejectionCode.NotType, span),
        )
      }
    }
    let template = run templateBinders(&mut resolver.*, &module, declaration)
    let binders = match move template {
      Result<Vector<Binder>, Shared<Rejection>>.Success {value: found} => move found
      Result<Vector<Binder>, Shared<Rejection>>.Failure {error} => {
        return Result.failResult<Shared<Type>, Shared<Rejection>>(move error)
      }
    }
    // An interface or representation bound constrains every application; proving it needs
    // conformance solving. Lifetime bounds stay recorded in the declaration's contract.
    let bounded = run declaresBounds(&mut resolver.*, &module, declaration)
    if bounded && Vector.length<Binder>(&binders) > usize.ZERO {
      return Result.failResult<Shared<Type>, Shared<Rejection>>(
        run reject(&resolver.*, anchor, RejectionCode.Unsupported, span),
      )
    }
    let rowBinders = rowBinderCount(Vector.asSlice<Binder>(&binders))
    let mut rowSyntax = HirRef.absent()
    let mut argumentIds = Range.empty()
    let mut argumentSpan = span
    let mut hasApplication = false
    if let Option<HirId>.Some {value: id} = move application {
      hasApplication = true
      let syntax = run typeNode(&mut resolver.*, anchor, id)
      if let Option<HeaderSyntax>.Some {value: argumentSyntax} = move syntax {
        argumentSpan = argumentSyntax.span
        if let Node.TypeArguments {arguments, environment, failures, requirements} = argumentSyntax.header {
          // One `? Row` suffix supplies the sole row binder; several row binders cannot be written.
          if requirements.present && rowBinders > usize.ONE {
            return Result.failResult<Shared<Type>, Shared<Rejection>>(
              run reject(&resolver.*, anchor, RejectionCode.Unsupported, argumentSpan),
            )
          }
          if requirements.present && rowBinders == usize.ONE {
            rowSyntax = requirements
          }
          if environment.present || failures.present || (requirements.present && rowBinders == usize.ZERO) {
            let mut suppliedKind = GenericKind.Lifetime
            if failures.present {
              suppliedKind = GenericKind.Failure
            }
            if requirements.present {
              suppliedKind = GenericKind.Requirement
            }
            return Result.failResult<Shared<Type>, Shared<Rejection>>(
              run rejectKind(&resolver.*, anchor, argumentSpan, b"", GenericKind.Type, suppliedKind),
            )
          }
          argumentIds = arguments
        } else {
          return Result.failResult<Shared<Type>, Shared<Rejection>>(
            run reject(&resolver.*, anchor, RejectionCode.Unsupported, argumentSpan),
          )
        }
      }
    }
    let expected = Vector.length<Binder>(&binders)
    if expected == usize.ZERO && hasApplication {
      return Result.failResult<Shared<Type>, Shared<Rejection>>(
        run rejectArity(&resolver.*, anchor, argumentSpan, expected, argumentIds.length),
      )
    }
    let mut arguments = Vector.make<Argument>()
    let mut argumentAt = usize.ZERO
    let callerModule = run internModule(&mut resolver.*, anchor)
    let parameters = Vector.asSlice<Binder>(&binders)
    let mut binderAt = usize.ZERO
    while binderAt < parameters.length {
      let mut supplied = Option.none<HirId>()
      let mut suppliedKind = GenericKind.Type
      let mut suppliedSpan = argumentSpan
      if argumentAt < argumentIds.length {
        supplied = run typeChild(&mut resolver.*, anchor, argumentIds, argumentAt)
        if let Option<HirId>.Some {value: argumentId} = &supplied {
          let source = run typeNode(&mut resolver.*, anchor, argumentId)
          if let Option<HeaderSyntax>.Some {value: argumentNode} = move source {
            suppliedSpan = argumentNode.span
            if let Node.Lifetime {..} = argumentNode.header {
              suppliedKind = GenericKind.Lifetime
            }
            if let Node.RequirementSelector {..} = argumentNode.header {
              suppliedKind = GenericKind.Requirement
            }
          }
        }
      }
      if let Binder.Lifetime {name, ..} = &parameters[binderAt] {
        if suppliedKind == GenericKind.Lifetime && argumentAt < argumentIds.length {
          if let Option<HirId>.Some {value: argumentId} = move supplied {
            let resolved = run lifetimeAt(&mut resolver.*, anchor, argumentId, callerBinders)
            match move resolved {
              Result<Shared<Lifetime>, Shared<Rejection>>.Success {value: lifetime} => {
                run Vector.append<Argument>(
                  &mut arguments,
                  Argument.Lifetime {value: move lifetime},
                )
              }
              Result<Shared<Lifetime>, Shared<Rejection>>.Failure {error} => {
                return Result.failResult<Shared<Type>, Shared<Rejection>>(move error)
              }
            }
            argumentAt = argumentAt + usize.ONE
          }
        } else {
          let elided = run elidedLifetime(
            &mut resolver.*,
            anchor,
            suppliedSpan,
            &mut callerElision.*,
          )
          match move elided {
            Result<Shared<Lifetime>, Shared<Rejection>>.Success {value: lifetime} => {
              run Vector.append<Argument>(&mut arguments, Argument.Lifetime {value: move lifetime})
            }
            Result<Shared<Lifetime>, Shared<Rejection>>.Failure {error} => {
              return Result.failResult<Shared<Type>, Shared<Rejection>>(move error)
            }
          }
        }
      } else if let Binder.Row {name, ..} = &parameters[binderAt] {
        if !rowSyntax.present {
          return Result.failResult<Shared<Type>, Shared<Rejection>>(
            run rejectKind(
              &resolver.*,
              anchor,
              argumentSpan,
              Bytes.asSlice(&name),
              GenericKind.Requirement,
              GenericKind.Type,
            ),
          )
        }
        let suppliedRow = run resolveChannels(
          &mut resolver.*,
          &mut owner.*,
          &mut dependencies.*,
          callerModule,
          anchor,
          HirRef.absent(),
          rowSyntax,
          callerBinders,
          &mut callerElision.*,
        )
        match move suppliedRow {
          Result<Channels, Shared<Rejection>>.Success {value: channels} => {
            run Vector.append<Argument>(
              &mut arguments,
              Argument.Row {value: move channels.requirements},
            )
          }
          Result<Channels, Shared<Rejection>>.Failure {error} => {
            return Result.failResult<Shared<Type>, Shared<Rejection>>(move error)
          }
        }
      } else if let Binder.Type {name, ..} = &parameters[binderAt] {
        if let Option<HirId>.Some {value: argumentId} = move supplied {
          if suppliedKind != GenericKind.Type {
            return Result.failResult<Shared<Type>, Shared<Rejection>>(
              run rejectKind(
                &resolver.*,
                anchor,
                suppliedSpan,
                Bytes.asSlice(&name),
                GenericKind.Type,
                suppliedKind,
              ),
            )
          }
          let resolved = run resolveType(
            &mut resolver.*,
            &mut owner.*,
            &mut dependencies.*,
            callerModule,
            argumentId,
            callerBinders,
            &mut callerElision.*,
          )
          match move resolved {
            Result<Shared<Type>, Shared<Rejection>>.Success {value: ty} => {
              run Vector.append<Argument>(&mut arguments, Argument.Type {value: move ty})
            }
            Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
              return Result.failResult<Shared<Type>, Shared<Rejection>>(move error)
            }
          }
          argumentAt = argumentAt + usize.ONE
        } else {
          return Result.failResult<Shared<Type>, Shared<Rejection>>(
            run rejectArity(&resolver.*, anchor, argumentSpan, expected, argumentIds.length),
          )
        }
      }
      binderAt = binderAt + usize.ONE
    }
    if argumentAt != argumentIds.length {
      return Result.failResult<Shared<Type>, Shared<Rejection>>(
        run rejectArity(&resolver.*, anchor, argumentSpan, expected, argumentIds.length),
      )
    }
    let key = Key {
      family: family,
      module: moduleOrdinal,
      name: usize.ZERO,
      declaration: declaration,
      member: usize.ZERO,
      external: false,
    }
    let answer = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, key, span)
    let selected = run typeFromAnswer(&answer)
    if let Option<Shared<Type>>.Some {value: resolved} = move selected.resolved {
      if family == Family.Alias {
        if let Node.AliasHeader {target, ..} = value.header {
          let applied = run bindArguments(
            Vector.asSlice<Binder>(&binders),
            Vector.asSlice<Argument>(&arguments),
          )
          // The alias query validates the declaration. A use expands under the caller's
          // elision context, so an omitted alias lifetime remains fresh per use.
          return run resolveType(
            &mut resolver.*,
            &mut owner.*,
            &mut dependencies.*,
            moduleOrdinal,
            target,
            Vector.asSlice<Binder>(&applied),
            &mut callerElision.*,
          )
        }
      }
      if expected > usize.ZERO {
        let found = run declarationAt(&mut resolver.*, &module, declaration)
        if let Option<DeclarationId>.Some {value: id} = move found {
          let isPublic = match value.header {
            Node.StructHeader {isPublic, ..} => isPublic
            Node.TupleHeader {isPublic, ..} => isPublic
            Node.UnionHeader {isPublic, ..} => isPublic
            Node.ServiceHeader {isPublic, ..} => isPublic
            Node.InterfaceHeader {isPublic, ..} => isPublic
            _ => false
          }
          return Result.succeed<Shared<Type>, Shared<Rejection>>(
            run Shared.make<Type>(
              Type.Nominal {declaration: move id, isPublic: isPublic, arguments: move arguments},
            ),
          )
        }
      }
      return Result.succeed<Shared<Type>, Shared<Rejection>>(move resolved)
    }
    if let Option<Shared<Rejection>>.Some {value: diagnostic} = move selected.rejected {
      return Result.failResult<Shared<Type>, Shared<Rejection>>(move diagnostic)
    }
  }
  return Result.failResult<Shared<Type>, Shared<Rejection>>(
    run reject(&resolver.*, anchor, RejectionCode.Unsupported, span),
  )
}

effect fn selectDeclaration(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  moduleOrdinal: usize,
  anchor: &ModuleId,
  name: &[u8],
  external: bool,
  span: Span,
  wrongKind: RejectionCode,
) -> Result<SelectedDeclaration, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let module = run resolvedModule(&resolver.*, moduleOrdinal)
  let nameOrdinal = run internName(&mut resolver.*, name)
  let key = Key {
    family: Family.Name,
    module: moduleOrdinal,
    name: nameOrdinal,
    declaration: usize.ZERO,
    member: usize.ZERO,
    external: external,
  }
  let observed = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, key, span)
  drop observed
  let selected = run select(&mut resolver.*, &module, name, external)
  if selected.count == usize.ZERO {
    let mut code = RejectionCode.UnknownName
    if external {
      code = RejectionCode.UnknownMember
    }
    return Result.failResult<SelectedDeclaration, Shared<Rejection>>(
      run reject(&resolver.*, anchor, code, span),
    )
  }
  if external && selected.publicCount == usize.ZERO {
    return Result.failResult<SelectedDeclaration, Shared<Rejection>>(
      run reject(&resolver.*, anchor, RejectionCode.PrivateMember, span),
    )
  }
  if selected.count > usize.ONE {
    return Result.failResult<SelectedDeclaration, Shared<Rejection>>(
      run reject(&resolver.*, anchor, RejectionCode.Collision, span),
    )
  }
  if selected.kind == CandidateKind.ImportMember {
    let importKey = Key {
      family: Family.Import,
      module: moduleOrdinal,
      name: usize.ZERO,
      declaration: selected.declaration,
      member: selected.member,
      external: false,
    }
    let imported = run demandChild(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies.*,
      importKey,
      span,
    )
    let binding = Shared.with<Result<Answer, NoRejection>, ImportSelection>(
      &imported,
      selectedImport,
    )
    if let Option<Shared<Rejection>>.Some {value} = move binding.rejected {
      return Result.failResult<SelectedDeclaration, Shared<Rejection>>(move value)
    }
    if let Option<usize>.Some {value: targetModule} = move binding.module {
      if let Option<usize>.Some {value: declaration} = move binding.declaration {
        return Result.succeed<SelectedDeclaration, Shared<Rejection>>(
          SelectedDeclaration {module: targetModule, ordinal: declaration},
        )
      }
    }
  }
  if selected.kind == CandidateKind.Declaration {
    return Result.succeed<SelectedDeclaration, Shared<Rejection>>(
      SelectedDeclaration {module: moduleOrdinal, ordinal: selected.declaration},
    )
  }
  return Result.failResult<SelectedDeclaration, Shared<Rejection>>(
    run reject(&resolver.*, anchor, wrongKind, span),
  )
}

effect fn namedType(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  moduleOrdinal: usize,
  anchor: &ModuleId,
  name: &[u8],
  external: bool,
  span: Span,
  application: Option<HirId>,
  binders: &[Binder],
  elision: &mut LifetimeElision,
) -> Result<Shared<Type>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let selected = run selectDeclaration(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies.*,
    moduleOrdinal,
    anchor,
    name,
    external,
    span,
    RejectionCode.NotType,
  )
  match move selected {
    Result<SelectedDeclaration, Shared<Rejection>>.Success {value} => {
      return run declarationType(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies.*,
        value.module,
        value.ordinal,
        anchor,
        span,
        move application,
        binders,
        &mut elision.*,
      )
    }
    Result<SelectedDeclaration, Shared<Rejection>>.Failure {error} => {
      return Result.failResult<Shared<Type>, Shared<Rejection>>(move error)
    }
  }
}

fn decimalU64(digits: &[u8]) -> Option<u64> {
  if digits.length == usize.ZERO || !fitsMagnitude(digits, b"18446744073709551615") {
    return Option.none<u64>()
  }
  let mut value: u64 = 0
  let mut at = usize.ZERO
  while at < digits.length {
    if digits[at] < 48 || digits[at] > 57 {
      return Option.none<u64>()
    }
    value = value * 10 + u8.toU64(digits[at] - 48)
    at = at + usize.ONE
  }
  return Option.some<u64>(value)
}

effect fn pointerAlignment(resolver: &mut Resolver, module: &ModuleId, qualifiers: Range) -> Result<
  Option<u64>,
  Shared<Rejection>,
> ! Cycle | OutOfMemoryError ? &mut Allocator {
  let mut alignment = Option.none<u64>()
  let mut seenAddressSpace = false
  let mut at = usize.ZERO
  while at < qualifiers.length {
    let child = run typeChild(&mut resolver.*, module, qualifiers, at)
    if let Option<HirId>.Some {value: id} = move child {
      let syntax = run typeNode(&mut resolver.*, module, id)
      if let Option<HeaderSyntax>.Some {value: qualifier} = move syntax {
        if let Node.PointerQualifier {name, value} = qualifier.header {
          let named = run typeNode(&mut resolver.*, module, name)
          let digits = run typeNode(&mut resolver.*, module, value)
          if let Option<HeaderSyntax>.Some {value: nameNode} = move named {
            if let Option<HeaderSyntax>.Some {value: numberNode} = move digits {
              if let Node.Name {text} = nameNode.header {
                if let Node.IntegerLiteral {magnitude, ..} = numberNode.header {
                  let sourceAnswer = run source(&mut resolver.*, module)
                  if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(
                    &resolver.*,
                    &sourceAnswer,
                    module,
                  ) {
                    let hir = IndexedSource.authored(indexed)
                    let label = Module.text(hir, text)
                    let parsed = decimalU64(Module.text(hir, magnitude))
                    if let Option<u64>.Some {value: count} = move parsed {
                      if same(label, b"align") {
                        let vacant = match & alignment {
                          Option<u64>.None => true
                          Option<u64>.Some {value: _} => false
                        }
                        if vacant && count > 0 && count <= 536870912 && u64.bitAnd(count, count - 1) == 0 {
                          alignment = Option.some<u64>(count)
                          at = at + usize.ONE
                          continue
                        }
                      }
                      if same(label, b"addrspace") && !seenAddressSpace && count == 0 {
                        seenAddressSpace = true
                        at = at + usize.ONE
                        continue
                      }
                    }
                  }
                }
              }
            }
          }
        }
        return Result.failResult<Option<u64>, Shared<Rejection>>(
          run reject(&resolver.*, module, RejectionCode.InvalidPointerQualifier, qualifier.span),
        )
      }
    }
    return Result.failResult<Option<u64>, Shared<Rejection>>(
      run reject(
        &resolver.*,
        module,
        RejectionCode.InvalidPointerQualifier,
        Span.make(usize.ZERO, usize.ZERO),
      ),
    )
  }
  return Result.succeed<Option<u64>, Shared<Rejection>>(move alignment)
}

effect fn qualifiedType(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  moduleOrdinal: usize,
  module: &ModuleId,
  segments: &[Bytes],
  span: Span,
  application: Option<HirId>,
  binders: &[Binder],
  elision: &mut LifetimeElision,
) -> Result<Shared<Type>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let namespace = Bytes.asSlice(&segments[usize.ZERO])
  let selected = run select(&mut resolver.*, module, namespace, false)
  let nameOrdinal = run internName(&mut resolver.*, namespace)
  let nameKey = Key {
    family: Family.Name,
    module: moduleOrdinal,
    name: nameOrdinal,
    declaration: usize.ZERO,
    member: usize.ZERO,
    external: false,
  }
  let observed = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, nameKey, span)
  drop observed
  if selected.count != usize.ONE || selected.kind != CandidateKind.ImportModule {
    let mut code = RejectionCode.NotType
    if selected.count == usize.ZERO {
      code = RejectionCode.UnknownName
    } else if selected.count > usize.ONE {
      code = RejectionCode.Collision
    }
    return Result.failResult<Shared<Type>, Shared<Rejection>>(
      run reject(&resolver.*, module, code, span),
    )
  }
  let importKey = Key {
    family: Family.Import,
    module: moduleOrdinal,
    name: usize.ZERO,
    declaration: selected.declaration,
    member: usize.MAX,
    external: false,
  }
  let imported = run demandChild(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies.*,
    importKey,
    span,
  )
  let binding = Shared.with<Result<Answer, NoRejection>, ImportSelection>(&imported, selectedImport)
  if let Option<Shared<Rejection>>.Some {value: diagnostic} = move binding.rejected {
    return Result.failResult<Shared<Type>, Shared<Rejection>>(move diagnostic)
  }
  if let Option<usize>.Some {value: targetModule} = move binding.module {
    return run namedType(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies.*,
      targetModule,
      module,
      Bytes.asSlice(&segments[usize.ONE]),
      true,
      span,
      move application,
      binders,
      &mut elision.*,
    )
  }
  return Result.failResult<Shared<Type>, Shared<Rejection>>(
    run reject(&resolver.*, module, RejectionCode.Unsupported, span),
  )
}

fn borrowedOrBare(value: &Type) -> bool {
  return match & value.* {
    Type.Reference {..} => true
    Type.Slice {..} => true
    Type.Callable {..} => true
    Type.Effect {..} => true
    _ => false
  }
}

effect fn resolveUnion(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  moduleOrdinal: usize,
  module: &ModuleId,
  written: Range,
  binders: &[Binder],
  elision: &mut LifetimeElision,
) -> Result<Shared<Type>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let mut members = Vector.make<Shared<Type>>()
  let mut at = usize.ZERO
  while at < written.length {
    let child = run typeChild(&mut resolver.*, module, written, at)
    if let Option<HirId>.Some {value: memberId} = move child {
      let resolved = run resolveType(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies.*,
        moduleOrdinal,
        memberId,
        binders,
        &mut elision.*,
      )
      match move resolved {
        Result<Shared<Type>, Shared<Rejection>>.Success {value: ty} => {
          if Shared.with<Type, bool>(&ty, borrowedOrBare) {
            let syntax = run typeNode(&mut resolver.*, module, memberId)
            let mut span = Span.make(usize.ZERO, usize.ZERO)
            if let Option<HeaderSyntax>.Some {value} = move syntax {
              span = value.span
            }
            return Result.failResult<Shared<Type>, Shared<Rejection>>(
              run reject(&resolver.*, module, RejectionCode.InvalidUnionMember, span),
            )
          }
          run Type.joinMember(&mut members, &ty)
        }
        Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
          return Result.failResult<Shared<Type>, Shared<Rejection>>(move error)
        }
      }
    }
    at = at + usize.ONE
  }
  let joined = Vector.asSlice<Shared<Type>>(&members)
  if joined.length == usize.ONE {
    return Result.succeed<Shared<Type>, Shared<Rejection>>(Shared.clone<Type>(&joined[usize.ZERO]))
  }
  return Result.succeed<Shared<Type>, Shared<Rejection>>(
    run Shared.make<Type>(Type.Union {members: move members}),
  )
}

// Resolves a written `'a & 'b` environment to its canonical intersection. A written but empty
// environment is invalid rather than a request for elision.
effect fn writtenEnvironment(
  resolver: &mut Resolver,
  module: &ModuleId,
  regions: Range,
  span: Span,
  binders: &[Binder],
) -> Result<Intersection, Shared<Rejection>> ! Cycle | OutOfMemoryError ? &mut Allocator {
  if regions.length == usize.ZERO {
    return Result.failResult<Intersection, Shared<Rejection>>(
      run reject(&resolver.*, module, RejectionCode.InvalidLifetime, span),
    )
  }
  let mut members = Vector.make<Shared<Lifetime>>()
  let mut at = usize.ZERO
  while at < regions.length {
    let child = run typeChild(&mut resolver.*, module, regions, at)
    if let Option<HirId>.Some {value: id} = move child {
      let resolved = run lifetimeAt(&mut resolver.*, module, id, binders)
      match move resolved {
        Result<Shared<Lifetime>, Shared<Rejection>>.Success {value} => {
          run Vector.append<Shared<Lifetime>>(&mut members, move value)
        }
        Result<Shared<Lifetime>, Shared<Rejection>>.Failure {error} => {
          return Result.failResult<Intersection, Shared<Rejection>>(move error)
        }
      }
    }
    at = at + usize.ONE
  }
  return Result.succeed<Intersection, Shared<Rejection>>(
    run Intersection.of(Vector.asSlice<Shared<Lifetime>>(&members)),
  )
}

// An omitted environment elides to one region.
effect fn elidedEnvironment(
  resolver: &mut Resolver,
  module: &ModuleId,
  span: Span,
  binders: &[Binder],
  elision: &mut LifetimeElision,
) -> Result<Intersection, Shared<Rejection>> ! Cycle | OutOfMemoryError ? &mut Allocator {
  if elision.staticEnvironment {
    elision.staticEnvironment = false
    let none = Vector.make<Shared<Lifetime>>()
    return Result.succeed<Intersection, Shared<Rejection>>(
      run Intersection.of(Vector.asSlice<Shared<Lifetime>>(&none)),
    )
  }
  let elided = run writtenOrElidedLifetime(
    &mut resolver.*,
    module,
    HirRef.absent(),
    span,
    binders,
    &mut elision.*,
  )
  return match move elided {
    Result<Shared<Lifetime>, Shared<Rejection>>.Success {value} => {
      let mut regions = Vector.make<Shared<Lifetime>>()
      run Vector.append<Shared<Lifetime>>(&mut regions, move value)
      return Result.succeed<Intersection, Shared<Rejection>>(
        run Intersection.of(Vector.asSlice<Shared<Lifetime>>(&regions)),
      )
    }
    Result<Shared<Lifetime>, Shared<Rejection>>.Failure {error} => Result.failResult<
      Intersection,
      Shared<Rejection>,
    >(move error)
  }
}

effect fn resolveEffect(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  moduleOrdinal: usize,
  module: &ModuleId,
  span: Span,
  application: Option<HirId>,
  mode: CallableMode,
  binders: &[Binder],
  elision: &mut LifetimeElision,
) -> Result<Shared<Type>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let mut supplied = Range.empty()
  let mut argumentSpan = span
  let mut declared = Option.none<Range>()
  let mut failures = HirRef.absent()
  let mut requirements = HirRef.absent()
  if let Option<HirId>.Some {value: id} = move application {
    let syntax = run typeNode(&mut resolver.*, module, id)
    if let Option<HeaderSyntax>.Some {value} = move syntax {
      argumentSpan = value.span
      if let Node.TypeArguments {
        arguments,
        environment: written,
        failures: failure,
        requirements: row,
      } = value.header {
        if written.present {
          declared = Option.some<Range>(written.range)
        }
        supplied = arguments
        failures = failure
        requirements = row
      }
    }
  }
  if supplied.length != usize.ONE {
    return Result.failResult<Shared<Type>, Shared<Rejection>>(
      run rejectArity(&resolver.*, module, argumentSpan, usize.ONE, supplied.length),
    )
  }
  let retained = match move declared {
    Option<Range>.Some {value: regions} => run writtenEnvironment(
      &mut resolver.*,
      module,
      regions,
      argumentSpan,
      binders,
    )
    Option<Range>.None => run elidedEnvironment(
      &mut resolver.*,
      module,
      span,
      binders,
      &mut elision.*,
    )
  }
  let region = match move retained {
    Result<Intersection, Shared<Rejection>>.Success {value: found} => run Shared.make<Intersection>(
      move found,
    )
    Result<Intersection, Shared<Rejection>>.Failure {error} => {
      return Result.failResult<Shared<Type>, Shared<Rejection>>(move error)
    }
  }
  // The parameterless default covers only the result's own environment, written or not.
  elision.staticEnvironment = false
  let successId = run typeChild(&mut resolver.*, module, supplied, usize.ZERO)
  let mut success = run Shared.make<Type>(Type.Unit)
  if let Option<HirId>.Some {value: id} = move successId {
    let syntax = run typeNode(&mut resolver.*, module, id)
    if let Option<HeaderSyntax>.Some {value} = move syntax {
      let mut kind = GenericKind.Type
      if let Node.Lifetime {..} = value.header {
        kind = GenericKind.Lifetime
      }
      if let Node.RequirementSelector {..} = value.header {
        kind = GenericKind.Requirement
      }
      if kind != GenericKind.Type {
        return Result.failResult<Shared<Type>, Shared<Rejection>>(
          run rejectKind(&resolver.*, module, value.span, b"", GenericKind.Type, kind),
        )
      }
    }
    let resolved = run resolveType(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies.*,
      moduleOrdinal,
      id,
      binders,
      &mut elision.*,
    )
    success = match move resolved {
      Result<Shared<Type>, Shared<Rejection>>.Success {value: ty} => move ty
      Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
        return Result.failResult<Shared<Type>, Shared<Rejection>>(move error)
      }
    }
  }
  let channels = run resolveChannels(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies.*,
    moduleOrdinal,
    module,
    failures,
    requirements,
    binders,
    &mut elision.*,
  )
  match move channels {
    Result<Channels, Shared<Rejection>>.Success {value} => {
      return Result.succeed<Shared<Type>, Shared<Rejection>>(
        run Shared.make<Type>(
          Type.Effect {
            mode: mode,
            environment: move region,
            success: move success,
            failure: move value.failure,
            requirements: move value.requirements,
          },
        ),
      )
    }
    Result<Channels, Shared<Rejection>>.Failure {error} => {
      return Result.failResult<Shared<Type>, Shared<Rejection>>(move error)
    }
  }
}

// Resolves a written `! E` and `? R`; omission is `never` and the empty row, not inference.
effect fn resolveChannels(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  moduleOrdinal: usize,
  module: &ModuleId,
  failures: HirRef,
  requirements: HirRef,
  binders: &[Binder],
  elision: &mut LifetimeElision,
) -> Result<Channels, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let mut failure = run Shared.make<Type>(Type.Union {members: Vector.make<Shared<Type>>()})
  if failures.present {
    let resolved = run resolveType(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies.*,
      moduleOrdinal,
      failures.id,
      binders,
      &mut elision.*,
    )
    failure = match move resolved {
      Result<Shared<Type>, Shared<Rejection>>.Success {value: ty} => move ty
      Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
        return Result.failResult<Channels, Shared<Rejection>>(move error)
      }
    }
  }
  let mut row = Row.empty()
  if requirements.present {
    let syntax = run typeNode(&mut resolver.*, module, requirements.id)
    if let Option<HeaderSyntax>.Some {value} = move syntax {
      if let Node.RequirementRow {members} = value.header {
        let mut at = usize.ZERO
        while at < members.length {
          let child = run typeChild(&mut resolver.*, module, members, at)
          if let Option<HirId>.Some {value: memberId} = move child {
            let added = run requireMember(
              &mut resolver.*,
              &mut owner.*,
              &mut dependencies.*,
              moduleOrdinal,
              module,
              memberId,
              binders,
              &mut elision.*,
              &mut row,
            )
            if let Option<Shared<Rejection>>.Some {value: diagnostic} = move added {
              return Result.failResult<Channels, Shared<Rejection>>(move diagnostic)
            }
          }
          at = at + usize.ONE
        }
      }
    }
  }
  return Result.succeed<Channels, Shared<Rejection>>(
    Channels {failure: move failure, requirements: run Shared.make<Row>(move row)},
  )
}

// Adds one written row member. `never` adds nothing; a bare name may select a `?R` binder.
effect fn requireMember(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  moduleOrdinal: usize,
  module: &ModuleId,
  id: HirId,
  binders: &[Binder],
  elision: &mut LifetimeElision,
  row: &mut Row,
) -> Option<Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let syntax = run typeNode(&mut resolver.*, module, id)
  let mut span = Span.make(usize.ZERO, usize.ZERO)
  if let Option<HeaderSyntax>.Some {value} = move syntax {
    span = value.span
    if let Node.Requirement {access, capability, rolePath, ..} = value.header {
      let resolved = run resolveType(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies.*,
        moduleOrdinal,
        capability,
        binders,
        &mut elision.*,
      )
      let capability = match move resolved {
        Result<Shared<Type>, Shared<Rejection>>.Success {value: ty} => move ty
        Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
          return Option.some<Shared<Rejection>>(move error)
        }
      }
      let kind = Shared.with<Type, OwnerKind>(&capability, nominalKind)
      if kind != OwnerKind.Service {
        let mut code = RejectionCode.InvalidRequirement
        // A generic capability needs conformance evidence, which this wave does not solve.
        if Shared.with<Type, bool>(&capability, isTypeParameter) {
          code = RejectionCode.Unsupported
        }
        return Option.some<Shared<Rejection>>(run reject(&resolver.*, module, code, span))
      }
      let mut roleType = Option.none<Shared<Type>>()
      if rolePath.present {
        let selected = run roleDeclaration(
          &mut resolver.*,
          &mut owner.*,
          &mut dependencies.*,
          moduleOrdinal,
          module,
          rolePath.id,
          binders,
          &mut elision.*,
        )
        match move selected {
          Result<Shared<Type>, Shared<Rejection>>.Success {value: declaration} => {
            roleType = Option.some<Shared<Type>>(move declaration)
          }
          Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
            return Option.some<Shared<Rejection>>(move error)
          }
        }
      }
      run Row.require(
        &mut row.*,
        Requirement {capability: move capability, roleType: move roleType, access: access},
      )
      return Option.none<Shared<Rejection>>()
    }
    if let Node.NamedType {path: written, hasMode, ..} = value.header {
      let parsed = run path(&mut resolver.*, module, written)
      let segments = Vector.asSlice<Bytes>(&parsed.segments)
      if !hasMode && parsed.valid && segments.length == usize.ONE {
        let name = Bytes.asSlice(&segments[usize.ZERO])
        if same(name, b"never") {
          return Option.none<Shared<Rejection>>()
        }
        let mut at = usize.ZERO
        while at < binders.length {
          if let Binder.Row {name: spelled, value: parameter, bound} = &binders[at] {
            if same(Bytes.asSlice(&spelled), name) {
              // An applied declaration splices its supplied row in place of the binder.
              if let Option<Shared<Row>>.Some {value: supplied} = &bound {
                run Row.merge(&mut row.*, &supplied)
              } else {
                run Row.include(
                  &mut row.*,
                  RowParameter {
                    declaration: Shared.clone<DeclarationId>(&parameter.declaration),
                    ordinal: parameter.ordinal,
                  },
                )
              }
              return Option.none<Shared<Rejection>>()
            }
          }
          at = at + usize.ONE
        }
      }
    }
    if let Node.RowWithout {..} = value.header {
      return Option.some<Shared<Rejection>>(
        run reject(&resolver.*, module, RejectionCode.Unsupported, span),
      )
    }
  }
  return Option.some<Shared<Rejection>>(
    run reject(&resolver.*, module, RejectionCode.InvalidRequirement, span),
  )
}

fn executableContract(value: &Type) -> bool {
  return match & value.* {
    Type.Callable {..} => true
    Type.Effect {..} => true
    _ => false
  }
}

fn nominalKind(value: &Type) -> OwnerKind {
  return match & value.* {
    Type.Nominal {declaration, ..} => DeclarationId.kind(&declaration)
    _ => OwnerKind.Damaged
  }
}

fn isTypeParameter(value: &Type) -> bool {
  return match & value.* {
    Type.Parameter {..} => true
    _ => false
  }
}

// Resolves the `at` path of a requirement through ordinary type lookup, keeping its identity demand.
effect fn roleDeclaration(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  moduleOrdinal: usize,
  module: &ModuleId,
  id: HirId,
  binders: &[Binder],
  elision: &mut LifetimeElision,
) -> Result<Shared<Type>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let parsed = run path(&mut resolver.*, module, id)
  let segments = Vector.asSlice<Bytes>(&parsed.segments)
  let mut resolved = Result.failResult<Shared<Type>, Shared<Rejection>>(
    run reject(&resolver.*, module, RejectionCode.InvalidRequirement, parsed.span),
  )
  if parsed.valid && segments.length == usize.ONE {
    resolved = run namedType(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies.*,
      moduleOrdinal,
      module,
      Bytes.asSlice(&segments[usize.ZERO]),
      false,
      parsed.span,
      Option.none<HirId>(),
      binders,
      &mut elision.*,
    )
  } else if parsed.valid && segments.length == 2 {
    resolved = run qualifiedType(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies.*,
      moduleOrdinal,
      module,
      segments,
      parsed.span,
      Option.none<HirId>(),
      binders,
      &mut elision.*,
    )
  }
  let selected = match move resolved {
    Result<Shared<Type>, Shared<Rejection>>.Success {value} => move value
    Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
      return Result.failResult<Shared<Type>, Shared<Rejection>>(move error)
    }
  }
  if Shared.with<Type, OwnerKind>(&selected, nominalKind) == OwnerKind.Role {
    return Result.succeed<Shared<Type>, Shared<Rejection>>(move selected)
  }
  return Result.failResult<Shared<Type>, Shared<Rejection>>(
    run reject(&resolver.*, module, RejectionCode.InvalidRequirement, parsed.span),
  )
}

effect fn copyBinder(binder: &Binder) -> Binder ! OutOfMemoryError ? &mut Allocator {
  return match & binder.* {
    Binder.Type {name, value} => Binder.Type {
      name: run Bytes.copy(Bytes.asSlice(&name)),
      value: Shared.clone<Type>(&value),
    }
    Binder.Lifetime {name, value} => Binder.Lifetime {
      name: run Bytes.copy(Bytes.asSlice(&name)),
      value: Shared.clone<Lifetime>(&value),
    }
    Binder.Row {name, value, bound} => Binder.Row {
      name: run Bytes.copy(Bytes.asSlice(&name)),
      value: RowParameter {
        declaration: Shared.clone<DeclarationId>(&value.declaration),
        ordinal: value.ordinal,
      },
      bound: copyBound(&bound),
    }
  }
}

// Adds the written `for<...>` binders as invocation lifetimes ahead of the surrounding binders, so
// they shadow a surrounding lifetime of the same name inside the contract.
effect fn quantifiedScope(
  resolver: &mut Resolver,
  module: &ModuleId,
  quantified: Range,
  binders: &[Binder],
  renumber: &Vector<usize>,
) -> Result<Vector<Binder>, Shared<Rejection>> ! Cycle | OutOfMemoryError ? &mut Allocator {
  let mut scope = Vector.make<Binder>()
  let mut at = usize.ZERO
  while at < quantified.length {
    let child = run typeChild(&mut resolver.*, module, quantified, at)
    let mut accepted = false
    let mut span = Span.make(usize.ZERO, usize.ZERO)
    if let Option<HirId>.Some {value: parameterId} = move child {
      let syntax = run typeNode(&mut resolver.*, module, parameterId)
      if let Option<HeaderSyntax>.Some {value} = move syntax {
        span = value.span
        if let Node.LifetimeParameter {name, ..} = value.header {
          let named = run typeNode(&mut resolver.*, module, name)
          if let Option<HeaderSyntax>.Some {value: token} = move named {
            if let Node.Name {text} = token.header {
              let sourceAnswer = run source(&mut resolver.*, module)
              if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(
                &resolver.*,
                &sourceAnswer,
                module,
              ) {
                let spelling = run Bytes.copy(Module.text(IndexedSource.authored(indexed), text))
                if same(Bytes.asSlice(&spelling), b"'static") || hasBinder(
                  Vector.asSlice<Binder>(&scope),
                  Bytes.asSlice(&spelling),
                ) {
                  return Result.failResult<Vector<Binder>, Shared<Rejection>>(
                    run reject(&resolver.*, module, RejectionCode.InvalidLifetime, span),
                  )
                }
                run Vector.append<Binder>(
                  &mut scope,
                  Binder.Lifetime {
                    name: move spelling,
                    value: run Shared.make<Lifetime>(
                      Lifetime.Invocation {ordinal: renumbered(renumber, at)},
                    ),
                  },
                )
                accepted = true
              }
            }
          }
        }
      }
    }
    if !accepted {
      return Result.failResult<Vector<Binder>, Shared<Rejection>>(
        run reject(&resolver.*, module, RejectionCode.InvalidLifetime, span),
      )
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < binders.length {
    run Vector.append<Binder>(&mut scope, run copyBinder(&binders[at]))
    at = at + usize.ONE
  }
  return Result.succeed<Vector<Binder>, Shared<Rejection>>(move scope)
}

// Records the `'longer: 'shorter` bounds written on `for<...>` binders.
effect fn invocationBounds(
  resolver: &mut Resolver,
  module: &ModuleId,
  quantified: Range,
  scope: &[Binder],
  renumber: &Vector<usize>,
) -> Result<Vector<Outlives>, Shared<Rejection>> ! Cycle | OutOfMemoryError ? &mut Allocator {
  let mut bounds = Vector.make<Outlives>()
  let mut at = usize.ZERO
  while at < quantified.length {
    let child = run typeChild(&mut resolver.*, module, quantified, at)
    if let Option<HirId>.Some {value: parameterId} = move child {
      let syntax = run typeNode(&mut resolver.*, module, parameterId)
      if let Option<HeaderSyntax>.Some {value} = move syntax {
        if let Node.LifetimeParameter {bounds: written, ..} = value.header {
          let mut boundAt = usize.ZERO
          while boundAt < written.length {
            let bound = run typeChild(&mut resolver.*, module, written, boundAt)
            if let Option<HirId>.Some {value: boundId} = move bound {
              let resolved = run lifetimeAt(&mut resolver.*, module, boundId, scope)
              match move resolved {
                Result<Shared<Lifetime>, Shared<Rejection>>.Success {value: shorter} => {
                  run Vector.append<Outlives>(
                    &mut bounds,
                    Outlives {
                      longer: run Shared.make<Lifetime>(
                        Lifetime.Invocation {ordinal: renumbered(renumber, at)},
                      ),
                      shorter: move shorter,
                    },
                  )
                }
                Result<Shared<Lifetime>, Shared<Rejection>>.Failure {error} => {
                  return Result.failResult<Vector<Outlives>, Shared<Rejection>>(move error)
                }
              }
            }
            boundAt = boundAt + usize.ONE
          }
        }
      }
    }
    at = at + usize.ONE
  }
  return Result.succeed<Vector<Outlives>, Shared<Rejection>>(move bounds)
}

// Resolves `for<'call> once fn<'env>(A) -> B`. Omitted parameter lifetimes are fresh invocation
// binders and an omitted result lifetime uses the sole borrowed parameter; quantified contracts
// do not nest.
struct CallableParts {
  inputs: Vector<Shared<Type>>
  output: Shared<Type>
  outlives: Vector<Outlives>
  allocated: usize
}

// Resolves a callable contract's binder bounds, parameters and result under one numbering of its
// invocation binders.
effect fn callableParts(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  moduleOrdinal: usize,
  module: &ModuleId,
  syntax: Node,
  binders: &[Binder],
  nested: bool,
  renumber: &Vector<usize>,
) -> Result<CallableParts, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let mut quantified = Range.empty()
  let mut parameters = Range.empty()
  let mut result = HirId {index: usize.ZERO}
  if let Node.CallableType {binders: written, parameters: inputs, result: output, ..} = syntax {
    quantified = written
    parameters = inputs
    result = output
  }
  let scoped = run quantifiedScope(&mut resolver.*, module, quantified, binders, renumber)
  let scope = match move scoped {
    Result<Vector<Binder>, Shared<Rejection>>.Success {value: found} => move found
    Result<Vector<Binder>, Shared<Rejection>>.Failure {error} => {
      return Result.failResult<CallableParts, Shared<Rejection>>(move error)
    }
  }
  let declaredBounds = run invocationBounds(
    &mut resolver.*,
    module,
    quantified,
    Vector.asSlice<Binder>(&scope),
    renumber,
  )
  let outlives = match move declaredBounds {
    Result<Vector<Outlives>, Shared<Rejection>>.Success {value: found} => move found
    Result<Vector<Outlives>, Shared<Rejection>>.Failure {error} => {
      return Result.failResult<CallableParts, Shared<Rejection>>(move error)
    }
  }
  let mut copied = Vector.make<usize>()
  let slots = Vector.asSlice<usize>(renumber)
  let mut slot = usize.ZERO
  while slot < slots.length {
    run Vector.append<usize>(&mut copied, slots[slot])
    slot = slot + usize.ONE
  }
  let mut invocation = LifetimeElision {
    owner: Option.none<DeclarationId>(),
    nextOrdinal: quantified.length,
    output: false,
    resultDefault: Option.none<Shared<Lifetime>>(),
    generated: Vector.make<Shared<Lifetime>>(),
    invocation: true,
    nested: nested,
    renumber: move copied,
    staticEnvironment: false,
  }
  let mut inputs = Vector.make<Shared<Type>>()
  let mut borrowed = usize.ZERO
  let mut candidate = Option.none<Shared<Lifetime>>()
  let mut at = usize.ZERO
  while at < parameters.length {
    let child = run typeChild(&mut resolver.*, module, parameters, at)
    if let Option<HirId>.Some {value: parameterId} = move child {
      let resolved = run resolveType(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies.*,
        moduleOrdinal,
        parameterId,
        Vector.asSlice<Binder>(&scope),
        &mut invocation,
      )
      match move resolved {
        Result<Shared<Type>, Shared<Rejection>>.Success {value: ty} => {
          let outer = Shared.with<Type, Option<Shared<Lifetime>>>(&ty, outerLifetime)
          if let Option<Shared<Lifetime>>.Some {value: lifetime} = move outer {
            borrowed = borrowed + usize.ONE
            candidate = Option.some<Shared<Lifetime>>(move lifetime)
          }
          run Vector.append<Shared<Type>>(&mut inputs, move ty)
        }
        Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
          return Result.failResult<CallableParts, Shared<Rejection>>(move error)
        }
      }
    }
    at = at + usize.ONE
  }
  invocation.output = true
  if borrowed == usize.ONE {
    invocation.resultDefault = move candidate
  }
  let output = run resolveType(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies.*,
    moduleOrdinal,
    result,
    Vector.asSlice<Binder>(&scope),
    &mut invocation,
  )
  return match move output {
    Result<Shared<Type>, Shared<Rejection>>.Success {value: ty} => Result.succeed<
      CallableParts,
      Shared<Rejection>,
    >(
      CallableParts {
        inputs: move inputs,
        output: move ty,
        outlives: move outlives,
        allocated: invocation.nextOrdinal,
      },
    )
    Result<Shared<Type>, Shared<Rejection>>.Failure {error} => Result.failResult<
      CallableParts,
      Shared<Rejection>,
    >(move error)
  }
}

fn renumbered(renumber: &Vector<usize>, ordinal: usize) -> usize {
  let slots = Vector.asSlice<usize>(renumber)
  if ordinal < slots.length {
    return slots[ordinal]
  }
  return ordinal
}

effect fn resolveCallable(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  moduleOrdinal: usize,
  module: &ModuleId,
  syntax: Node,
  span: Span,
  binders: &[Binder],
  elision: &mut LifetimeElision,
) -> Result<Shared<Type>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  if let Node.CallableType {mode, isUnsafe, binders: quantified, environment, ..} = syntax {
    if elision.invocation && quantified.length > usize.ZERO {
      return Result.failResult<Shared<Type>, Shared<Rejection>>(
        run reject(&resolver.*, module, RejectionCode.NestedQuantifier, span),
      )
    }
    let retained = run writtenOrElidedLifetime(
      &mut resolver.*,
      module,
      environment,
      span,
      binders,
      &mut elision.*,
    )
    let mut regions = Vector.make<Shared<Lifetime>>()
    match move retained {
      Result<Shared<Lifetime>, Shared<Rejection>>.Success {value: found} => {
        run Vector.append<Shared<Lifetime>>(&mut regions, move found)
      }
      Result<Shared<Lifetime>, Shared<Rejection>>.Failure {error} => {
        return Result.failResult<Shared<Type>, Shared<Rejection>>(move error)
      }
    }
    let region = run Shared.make<Intersection>(
      run Intersection.of(Vector.asSlice<Shared<Lifetime>>(&regions)),
    )
    // The first pass numbers written binders by position and elided ones by allocation. Numbering
    // by first use drops unused binders; equality then compares contracts up to a renaming.
    let provisional = Vector.make<usize>()
    let first = run callableParts(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies.*,
      moduleOrdinal,
      module,
      syntax,
      binders,
      elision.invocation,
      &provisional,
    )
    let firstParts = match move first {
      Result<CallableParts, Shared<Rejection>>.Success {value} => move value
      Result<CallableParts, Shared<Rejection>>.Failure {error} => {
        return Result.failResult<Shared<Type>, Shared<Rejection>>(move error)
      }
    }
    // A contract inside another contract's invocation context cannot quantify, so it owns no
    // binders. Its invocation lifetimes belong to the enclosing contract, which numbers them.
    if elision.invocation {
      return Result.succeed<Shared<Type>, Shared<Rejection>>(
        run Shared.make<Type>(
          Type.Callable {
            mode: mode,
            isUnsafe: isUnsafe,
            environment: move region,
            invocationBinders: usize.ZERO,
            invocationBounds: move firstParts.outlives,
            parameters: move firstParts.inputs,
            result: move firstParts.output,
          },
        ),
      )
    }
    let mut order = Vector.make<usize>()
    let inputs = Vector.asSlice<Shared<Type>>(&firstParts.inputs)
    let mut at = usize.ZERO
    while at < inputs.length {
      run Type.collectInvocations(&inputs[at], &mut order)
      at = at + usize.ONE
    }
    run Type.collectInvocations(&firstParts.output, &mut order)
    let bounds = Vector.asSlice<Outlives>(&firstParts.outlives)
    at = usize.ZERO
    while at < bounds.length {
      run Type.collectLifetime(&bounds[at].longer, &mut order)
      run Type.collectLifetime(&bounds[at].shorter, &mut order)
      at = at + usize.ONE
    }
    let used = Vector.asSlice<usize>(&order)
    let mut canonical = used.length == firstParts.allocated
    at = usize.ZERO
    while canonical && at < used.length {
      canonical = used[at] == at
      at = at + usize.ONE
    }
    let mut parts = move firstParts
    if !canonical {
      let mut renumber = Vector.make<usize>()
      at = usize.ZERO
      while at < parts.allocated {
        run Vector.append<usize>(&mut renumber, usize.MAX)
        at = at + usize.ONE
      }
      let slots = Vector.asMutSlice<usize>(&mut renumber)
      at = usize.ZERO
      while at < used.length {
        slots[used[at]] = at
        at = at + usize.ONE
      }
      let second = run callableParts(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies.*,
        moduleOrdinal,
        module,
        syntax,
        binders,
        elision.invocation,
        &renumber,
      )
      parts = match move second {
        Result<CallableParts, Shared<Rejection>>.Success {value} => move value
        Result<CallableParts, Shared<Rejection>>.Failure {error} => {
          return Result.failResult<Shared<Type>, Shared<Rejection>>(move error)
        }
      }
    }
    return Result.succeed<Shared<Type>, Shared<Rejection>>(
      run Shared.make<Type>(
        Type.Callable {
          mode: mode,
          isUnsafe: isUnsafe,
          environment: move region,
          invocationBinders: Vector.length<usize>(&order),
          invocationBounds: move parts.outlives,
          parameters: move parts.inputs,
          result: move parts.output,
        },
      ),
    )
  }
  return Result.failResult<Shared<Type>, Shared<Rejection>>(
    run reject(&resolver.*, module, RejectionCode.Unsupported, span),
  )
}

effect fn resolveType(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  moduleOrdinal: usize,
  id: HirId,
  binders: &[Binder],
  elision: &mut LifetimeElision,
) -> Result<Shared<Type>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let module = run resolvedModule(&resolver.*, moduleOrdinal)
  let syntax = run typeNode(&mut resolver.*, &module, id)
  if let Option<HeaderSyntax>.Some {value} = move syntax {
    let mut selected = value.header
    let mut application = Option.none<HirId>()
    if let Node.AppliedType {target, arguments} = selected {
      let writtenTarget = run typeNode(&mut resolver.*, &module, target)
      if let Option<HeaderSyntax>.Some {value: named} = move writtenTarget {
        selected = named.header
        application = Option.some<HirId>(arguments)
      }
    }
    if let Node.UnitType {} = selected {
      if let Option<HirId>.Some {value: arguments} = move application {
        let written = run typeNode(&mut resolver.*, &module, arguments)
        if let Option<HeaderSyntax>.Some {value: found} = move written {
          if let Node.TypeArguments {arguments: supplied, ..} = found.header {
            return Result.failResult<Shared<Type>, Shared<Rejection>>(
              run rejectArity(&resolver.*, &module, found.span, usize.ZERO, supplied.length),
            )
          }
        }
      }
      return Result.succeed<Shared<Type>, Shared<Rejection>>(run Shared.make<Type>(Type.Unit))
    }
    if let Node.NamedType {path: typeName, hasMode, mode} = selected {
      let parsed = run path(&mut resolver.*, &module, typeName)
      if !parsed.valid {
        return Result.failResult<Shared<Type>, Shared<Rejection>>(
          run reject(&resolver.*, &module, RejectionCode.Unsupported, value.span),
        )
      }
      let segments = Vector.asSlice<Bytes>(&parsed.segments)
      // The builtin `Effect<A ! E ? R>` needs no import; only a binder can shadow its spelling.
      if segments.length == usize.ONE && same(Bytes.asSlice(&segments[usize.ZERO]), b"Effect") && !hasBinder(
        binders,
        b"Effect",
      ) {
        let mut access = CallableMode.Shared
        if hasMode {
          access = mode
        }
        return run resolveEffect(
          &mut resolver.*,
          &mut owner.*,
          &mut dependencies.*,
          moduleOrdinal,
          &module,
          value.span,
          move application,
          access,
          binders,
          &mut elision.*,
        )
      }
      if hasMode {
        return Result.failResult<Shared<Type>, Shared<Rejection>>(
          run reject(&resolver.*, &module, RejectionCode.Unsupported, value.span),
        )
      }
      if segments.length == usize.ONE {
        let name = Bytes.asSlice(&segments[usize.ZERO])
        let known = binders
        let mut at = usize.ZERO
        while at < known.length {
          if let Binder.Row {name: bound, ..} = &known[at] {
            if same(Bytes.asSlice(&bound), name) {
              return Result.failResult<Shared<Type>, Shared<Rejection>>(
                run rejectKind(
                  &resolver.*,
                  &module,
                  parsed.span,
                  name,
                  GenericKind.Type,
                  GenericKind.Requirement,
                ),
              )
            }
          }
          if let Binder.Type {name: bound, value: ty} = &known[at] {
            if same(Bytes.asSlice(&bound), name) {
              if let Option<HirId>.Some {value: arguments} = move application {
                let written = run typeNode(&mut resolver.*, &module, arguments)
                if let Option<HeaderSyntax>.Some {value: found} = move written {
                  if let Node.TypeArguments {arguments: supplied, ..} = found.header {
                    return Result.failResult<Shared<Type>, Shared<Rejection>>(
                      run rejectArity(&resolver.*, &module, found.span, usize.ZERO, supplied.length),
                    )
                  }
                }
              }
              return Result.succeed<Shared<Type>, Shared<Rejection>>(Shared.clone<Type>(&ty))
            }
          }
          at = at + usize.ONE
        }
        if same(name, b"string") {
          let mut writtenLifetime = HirRef.absent()
          if let Option<HirId>.Some {value: arguments} = move application {
            let written = run typeNode(&mut resolver.*, &module, arguments)
            if let Option<HeaderSyntax>.Some {value: found} = move written {
              if let Node.TypeArguments {arguments: supplied, environment, failures, requirements} = found.header {
                if environment.present || failures.present || requirements.present || supplied.length != usize.ONE {
                  return Result.failResult<Shared<Type>, Shared<Rejection>>(
                    run rejectArity(&resolver.*, &module, found.span, usize.ONE, supplied.length),
                  )
                }
                let child = run typeChild(&mut resolver.*, &module, supplied, usize.ZERO)
                if let Option<HirId>.Some {value: lifetimeId} = move child {
                  writtenLifetime = HirRef.of(lifetimeId)
                }
              }
            }
          }
          let lifetime = run writtenOrElidedLifetime(
            &mut resolver.*,
            &module,
            writtenLifetime,
            value.span,
            binders,
            &mut elision.*,
          )
          match move lifetime {
            Result<Shared<Lifetime>, Shared<Rejection>>.Success {value: valid} => {
              return Result.succeed<Shared<Type>, Shared<Rejection>>(
                run Shared.make<Type>(Type.String {lifetime: move valid}),
              )
            }
            Result<Shared<Lifetime>, Shared<Rejection>>.Failure {error} => {
              return Result.failResult<Shared<Type>, Shared<Rejection>>(move error)
            }
          }
        }
        if primitive(name) {
          if let Option<HirId>.Some {value: arguments} = move application {
            let written = run typeNode(&mut resolver.*, &module, arguments)
            if let Option<HeaderSyntax>.Some {value: found} = move written {
              if let Node.TypeArguments {arguments: supplied, ..} = found.header {
                return Result.failResult<Shared<Type>, Shared<Rejection>>(
                  run rejectArity(&resolver.*, &module, found.span, usize.ZERO, supplied.length),
                )
              }
            }
          }
          return Result.succeed<Shared<Type>, Shared<Rejection>>(
            run Shared.make<Type>(Type.Primitive {name: run Bytes.copy(name)}),
          )
        }
        if same(name, b"never") {
          if let Option<HirId>.Some {value: arguments} = move application {
            let written = run typeNode(&mut resolver.*, &module, arguments)
            if let Option<HeaderSyntax>.Some {value: found} = move written {
              if let Node.TypeArguments {arguments: supplied, ..} = found.header {
                return Result.failResult<Shared<Type>, Shared<Rejection>>(
                  run rejectArity(&resolver.*, &module, found.span, usize.ZERO, supplied.length),
                )
              }
            }
          }
          return Result.succeed<Shared<Type>, Shared<Rejection>>(
            run Shared.make<Type>(Type.Union {members: Vector.make<Shared<Type>>()}),
          )
        }
        return run namedType(
          &mut resolver.*,
          &mut owner.*,
          &mut dependencies.*,
          moduleOrdinal,
          &module,
          name,
          false,
          parsed.span,
          move application,
          binders,
          &mut elision.*,
        )
      }
      if segments.length == 2 {
        return run qualifiedType(
          &mut resolver.*,
          &mut owner.*,
          &mut dependencies.*,
          moduleOrdinal,
          &module,
          segments,
          parsed.span,
          move application,
          binders,
          &mut elision.*,
        )
      }
    }
    if let Node.ReferenceType {referent, access, lifetime, roleName} = selected {
      if roleName.present {
        return Result.failResult<Shared<Type>, Shared<Rejection>>(
          run reject(&resolver.*, &module, RejectionCode.Unsupported, value.span),
        )
      }
      let valid = run writtenOrElidedLifetime(
        &mut resolver.*,
        &module,
        lifetime,
        value.span,
        binders,
        &mut elision.*,
      )
      let region = match move valid {
        Result<Shared<Lifetime>, Shared<Rejection>>.Success {value: found} => move found
        Result<Shared<Lifetime>, Shared<Rejection>>.Failure {error} => {
          return Result.failResult<Shared<Type>, Shared<Rejection>>(move error)
        }
      }
      let resolved = run resolveType(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies.*,
        moduleOrdinal,
        referent,
        binders,
        &mut elision.*,
      )
      match move resolved {
        Result<Shared<Type>, Shared<Rejection>>.Success {value: ty} => {
          return Result.succeed<Shared<Type>, Shared<Rejection>>(
            run Shared.make<Type>(
              Type.Reference {referent: move ty, access: access, lifetime: move region},
            ),
          )
        }
        Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
          return Result.failResult<Shared<Type>, Shared<Rejection>>(move error)
        }
      }
    }
    if let Node.SliceType {element, access, lifetime} = selected {
      let valid = run writtenOrElidedLifetime(
        &mut resolver.*,
        &module,
        lifetime,
        value.span,
        binders,
        &mut elision.*,
      )
      let region = match move valid {
        Result<Shared<Lifetime>, Shared<Rejection>>.Success {value: found} => move found
        Result<Shared<Lifetime>, Shared<Rejection>>.Failure {error} => {
          return Result.failResult<Shared<Type>, Shared<Rejection>>(move error)
        }
      }
      let resolved = run resolveType(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies.*,
        moduleOrdinal,
        element,
        binders,
        &mut elision.*,
      )
      match move resolved {
        Result<Shared<Type>, Shared<Rejection>>.Success {value: ty} => {
          return Result.succeed<Shared<Type>, Shared<Rejection>>(
            run Shared.make<Type>(
              Type.Slice {element: move ty, access: access, lifetime: move region},
            ),
          )
        }
        Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
          return Result.failResult<Shared<Type>, Shared<Rejection>>(move error)
        }
      }
    }
    if let Node.PointerType {pointee, access, nullable, multiplicity, qualifiers} = selected {
      let validated = run pointerAlignment(&mut resolver.*, &module, qualifiers)
      let alignment = match move validated {
        Result<Option<u64>, Shared<Rejection>>.Success {value: found} => move found
        Result<Option<u64>, Shared<Rejection>>.Failure {error} => {
          return Result.failResult<Shared<Type>, Shared<Rejection>>(move error)
        }
      }
      let resolved = run resolveType(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies.*,
        moduleOrdinal,
        pointee,
        binders,
        &mut elision.*,
      )
      match move resolved {
        Result<Shared<Type>, Shared<Rejection>>.Success {value: ty} => {
          return Result.succeed<Shared<Type>, Shared<Rejection>>(
            run Shared.make<Type>(
              Type.Pointer {
                pointee: move ty,
                access: access,
                nullable: nullable,
                multiplicity: multiplicity,
                alignment: move alignment,
              },
            ),
          )
        }
        Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
          return Result.failResult<Shared<Type>, Shared<Rejection>>(move error)
        }
      }
    }
    if let Node.FixedArrayType {element, length} = selected {
      let lengthSyntax = run typeNode(&mut resolver.*, &module, length)
      if let Option<HeaderSyntax>.Some {value: writtenLength} = move lengthSyntax {
        if let Node.IntegerLiteral {sign, magnitude, suffix, ..} = writtenLength.header {
          if sign == Sign.Positive && !suffix.present {
            let sourceAnswer = run source(&mut resolver.*, &module)
            if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(
              &resolver.*,
              &sourceAnswer,
              &module,
            ) {
              let extent = run Bytes.copy(Module.text(IndexedSource.authored(indexed), magnitude))
              let resolved = run resolveType(
                &mut resolver.*,
                &mut owner.*,
                &mut dependencies.*,
                moduleOrdinal,
                element,
                binders,
                &mut elision.*,
              )
              match move resolved {
                Result<Shared<Type>, Shared<Rejection>>.Success {value: ty} => {
                  return Result.succeed<Shared<Type>, Shared<Rejection>>(
                    run Shared.make<Type>(Type.Array {element: move ty, extent: move extent}),
                  )
                }
                Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
                  return Result.failResult<Shared<Type>, Shared<Rejection>>(move error)
                }
              }
            }
          }
        }
        let mut anchor = writtenLength.span
        if anchor.end <= anchor.start {
          anchor = value.span
        }
        return Result.failResult<Shared<Type>, Shared<Rejection>>(
          run reject(&resolver.*, &module, RejectionCode.Unsupported, anchor),
        )
      }
    }
    if let Node.UnionType {members} = selected {
      return run resolveUnion(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies.*,
        moduleOrdinal,
        &module,
        members,
        binders,
        &mut elision.*,
      )
    }
    if let Node.CallableType {..} = selected {
      return run resolveCallable(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies.*,
        moduleOrdinal,
        &module,
        selected,
        value.span,
        binders,
        &mut elision.*,
      )
    }
    if let Node.Lifetime {..} = selected {
      return Result.failResult<Shared<Type>, Shared<Rejection>>(
        run reject(&resolver.*, &module, RejectionCode.InvalidLifetime, value.span),
      )
    }
    return Result.failResult<Shared<Type>, Shared<Rejection>>(
      run reject(&resolver.*, &module, RejectionCode.Unsupported, value.span),
    )
  }
  return Result.failResult<Shared<Type>, Shared<Rejection>>(
    run reject(&resolver.*, &module, RejectionCode.Unsupported, Span.make(usize.ZERO, usize.ZERO)),
  )
}

effect fn resolveAlias(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  key: Key,
) -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let module = run resolvedModule(&resolver.*, key.module)
  let mut dependencies = Vector.make<Dependency>()
  let written = run header(&mut resolver.*, &module, key.declaration)
  if let Option<HeaderSyntax>.Some {value} = move written {
    if let Node.AliasHeader {target, isPublic, ..} = value.header {
      let template = run templateBinders(&mut resolver.*, &module, key.declaration)
      let binders = match move template {
        Result<Vector<Binder>, Shared<Rejection>>.Success {value: found} => move found
        Result<Vector<Binder>, Shared<Rejection>>.Failure {error} => {
          return Answer {
            outcome: Outcome.Rejected {diagnostic: move error},
            dependencies: move dependencies,
            sources: Vector.make<Shared<Observation>>(),
            footprint: Vector.make<Shared<DemandFootprint>>(),
            answerId: usize.ZERO,
            identity: Option.none<Shared<Value>>(),
            bodyEvidence: Option.none<Shared<BodyEvidence>>(),
          }
        }
      }
      let mut elision = LifetimeElision {
        owner: run declarationAt(&mut resolver.*, &module, key.declaration),
        nextOrdinal: Vector.length<Binder>(&binders),
        output: false,
        resultDefault: Option.none<Shared<Lifetime>>(),
        generated: Vector.make<Shared<Lifetime>>(),
        invocation: false,
        nested: false,
        renumber: Vector.make<usize>(),
        staticEnvironment: false,
      }
      let resolved = run resolveType(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies,
        key.module,
        target,
        Vector.asSlice<Binder>(&binders),
        &mut elision,
      )
      match move resolved {
        Result<Shared<Type>, Shared<Rejection>>.Success {value: ty} => {
          let exposure = run exposedPrivate(&mut resolver.*, &module, target, &ty, isPublic)
          if let Option<Shared<Rejection>>.Some {value: diagnostic} = move exposure {
            return Answer {
              outcome: Outcome.Rejected {diagnostic: move diagnostic},
              dependencies: move dependencies,
              sources: Vector.make<Shared<Observation>>(),
              footprint: Vector.make<Shared<DemandFootprint>>(),
              answerId: usize.ZERO,
              identity: Option.none<Shared<Value>>(),
              bodyEvidence: Option.none<Shared<BodyEvidence>>(),
            }
          }
          return Answer {
            outcome: Outcome.Success {value: Value.Type {resolved: move ty}},
            dependencies: move dependencies,
            sources: Vector.make<Shared<Observation>>(),
            footprint: Vector.make<Shared<DemandFootprint>>(),
            answerId: usize.ZERO,
            identity: Option.none<Shared<Value>>(),
            bodyEvidence: Option.none<Shared<BodyEvidence>>(),
          }
        }
        Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
          return Answer {
            outcome: Outcome.Rejected {diagnostic: move error},
            dependencies: move dependencies,
            sources: Vector.make<Shared<Observation>>(),
            footprint: Vector.make<Shared<DemandFootprint>>(),
            answerId: usize.ZERO,
            identity: Option.none<Shared<Value>>(),
            bodyEvidence: Option.none<Shared<BodyEvidence>>(),
          }
        }
      }
    }
    let diagnostic = run reject(&resolver.*, &module, RejectionCode.Unsupported, value.span)
    return Answer {
      outcome: Outcome.Rejected {diagnostic: move diagnostic},
      dependencies: move dependencies,
      sources: Vector.make<Shared<Observation>>(),
      footprint: Vector.make<Shared<DemandFootprint>>(),
      answerId: usize.ZERO,
      identity: Option.none<Shared<Value>>(),
      bodyEvidence: Option.none<Shared<BodyEvidence>>(),
    }
  }
  let diagnostic = run reject(
    &resolver.*,
    &module,
    RejectionCode.Unsupported,
    Span.make(usize.ZERO, usize.ZERO),
  )
  return Answer {
    outcome: Outcome.Rejected {diagnostic: move diagnostic},
    dependencies: move dependencies,
    sources: Vector.make<Shared<Observation>>(),
    footprint: Vector.make<Shared<DemandFootprint>>(),
    answerId: usize.ZERO,
    identity: Option.none<Shared<Value>>(),
    bodyEvidence: Option.none<Shared<BodyEvidence>>(),
  }
}

effect fn resolveIdentity(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  key: Key,
) -> Answer ! Cycle | OutOfMemoryError ? &mut Allocator {
  let module = run resolvedModule(&resolver.*, key.module)
  let written = run header(&mut resolver.*, &module, key.declaration)
  if let Option<HeaderSyntax>.Some {value} = move written {
    let allowed = match value.header {
      Node.StructHeader {..} => true
      Node.TupleHeader {..} => true
      Node.EnumHeader {..} => true
      Node.UnionHeader {..} => true
      Node.ServiceHeader {..} => true
      Node.InterfaceHeader {..} => true
      Node.RoleHeader {..} => true
      _ => false
    }
    let isPublic = match value.header {
      Node.StructHeader {isPublic, ..} => isPublic
      Node.TupleHeader {isPublic, ..} => isPublic
      Node.EnumHeader {isPublic, ..} => isPublic
      Node.UnionHeader {isPublic, ..} => isPublic
      Node.ServiceHeader {isPublic, ..} => isPublic
      Node.InterfaceHeader {isPublic, ..} => isPublic
      Node.RoleHeader {isPublic, ..} => isPublic
      _ => false
    }
    if allowed {
      let found = run declarationAt(&mut resolver.*, &module, key.declaration)
      if let Option<DeclarationId>.Some {value: id} = move found {
        return Answer {
          outcome: Outcome.Success {
            value: Value.Type {
              resolved: run Shared.make<Type>(
                Type.Nominal {
                  declaration: move id,
                  isPublic: isPublic,
                  arguments: Vector.make<Argument>(),
                },
              ),
            },
          },
          dependencies: Vector.make<Dependency>(),
          sources: Vector.make<Shared<Observation>>(),
          footprint: Vector.make<Shared<DemandFootprint>>(),
          answerId: usize.ZERO,
          identity: Option.none<Shared<Value>>(),
          bodyEvidence: Option.none<Shared<BodyEvidence>>(),
        }
      }
    }
    let diagnostic = run reject(&resolver.*, &module, RejectionCode.Unsupported, value.span)
    return Answer {
      outcome: Outcome.Rejected {diagnostic: move diagnostic},
      dependencies: Vector.make<Dependency>(),
      sources: Vector.make<Shared<Observation>>(),
      footprint: Vector.make<Shared<DemandFootprint>>(),
      answerId: usize.ZERO,
      identity: Option.none<Shared<Value>>(),
      bodyEvidence: Option.none<Shared<BodyEvidence>>(),
    }
  }
  let diagnostic = run reject(
    &resolver.*,
    &module,
    RejectionCode.Unsupported,
    Span.make(usize.ZERO, usize.ZERO),
  )
  return Answer {
    outcome: Outcome.Rejected {diagnostic: move diagnostic},
    dependencies: Vector.make<Dependency>(),
    sources: Vector.make<Shared<Observation>>(),
    footprint: Vector.make<Shared<DemandFootprint>>(),
    answerId: usize.ZERO,
    identity: Option.none<Shared<Value>>(),
    bodyEvidence: Option.none<Shared<BodyEvidence>>(),
  }
}

fn memberSuccess(value: Value, dependencies: Vector<Dependency>) -> Answer {
  return Answer {
    outcome: Outcome.Success {value: move value},
    dependencies: move dependencies,
    sources: Vector.make<Shared<Observation>>(),
    footprint: Vector.make<Shared<DemandFootprint>>(),
    answerId: usize.ZERO,
    identity: Option.none<Shared<Value>>(),
    bodyEvidence: Option.none<Shared<BodyEvidence>>(),
  }
}

fn memberRejected(diagnostic: Shared<Rejection>, dependencies: Vector<Dependency>) -> Answer {
  return Answer {
    outcome: Outcome.Rejected {diagnostic: move diagnostic},
    dependencies: move dependencies,
    sources: Vector.make<Shared<Observation>>(),
    footprint: Vector.make<Shared<DemandFootprint>>(),
    answerId: usize.ZERO,
    identity: Option.none<Shared<Value>>(),
    bodyEvidence: Option.none<Shared<BodyEvidence>>(),
  }
}

effect fn writtenMember(hir: &Module, id: HirId, kind: MemberKind) -> Option<Member>
! OutOfMemoryError
? &mut Allocator {
  if kind == MemberKind.Position {
    return Option.some<Member>(Member {name: Option.none<Bytes>(), isPublic: true, kind: kind})
  }
  let node = Module.node(hir, id)
  let mut name = HirId {index: usize.ZERO}
  let mut isPublic = true
  if let Node.Field {name: field, isPublic: visible, ..} = node {
    name = field
    isPublic = visible
  } else if let Node.EnumMember {name: member, ..} = node {
    name = member
  } else if let Node.Variant {name: variant, ..} = node {
    name = variant
  } else {
    return Option.none<Member>()
  }
  if let Node.Name {text} = Module.node(hir, name) {
    return Option.some<Member>(
      Member {
        name: Option.some<Bytes>(run Bytes.copy(Module.text(hir, text))),
        isPublic: isPublic,
        kind: kind,
      },
    )
  }
  return Option.none<Member>()
}

fn memberSameName(left: &Member, right: &Member) -> bool {
  return match & left.name {
    Option<Bytes>.Some {value: first} => match & right.name {
      Option<Bytes>.Some {value: second} => same(Bytes.asSlice(&first), Bytes.asSlice(&second))
      Option<Bytes>.None => false
    }
    Option<Bytes>.None => false
  }
}

effect fn resolveMembers(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  key: Key,
) -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let module = run resolvedModule(&resolver.*, key.module)
  let mut dependencies = Vector.make<Dependency>()
  let written = run header(&mut resolver.*, &module, key.declaration)
  if let Option<HeaderSyntax>.Some {value} = move written {
    let identityKey = Key {
      family: Family.Identity,
      module: key.module,
      name: usize.ZERO,
      declaration: key.declaration,
      member: usize.ZERO,
      external: false,
    }
    let identity = run demandChild(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies,
      identityKey,
      value.span,
    )
    let selected = run typeFromAnswer(&identity)
    if let Option<Shared<Rejection>>.Some {value: diagnostic} = move selected.rejected {
      return memberRejected(move diagnostic, move dependencies)
    }
    let mut range = Range.empty()
    let mut kind = MemberKind.Field
    if let Node.StructHeader {fields, ..} = value.header {
      range = fields
    } else if let Node.TupleHeader {elements, ..} = value.header {
      range = elements
      kind = MemberKind.Position
    } else if let Node.EnumHeader {members, ..} = value.header {
      range = members
      kind = MemberKind.EnumCase
    } else if let Node.UnionHeader {variants, ..} = value.header {
      range = variants
      kind = MemberKind.Variant
    } else {
      return memberRejected(
        run reject(&resolver.*, &module, RejectionCode.Unsupported, value.span),
        move dependencies,
      )
    }
    let sourceAnswer = run source(&mut resolver.*, &module)
    if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(
      &resolver.*,
      &sourceAnswer,
      &module,
    ) {
      let hir = IndexedSource.authored(indexed)
      let mut members = Vector.make<Member>()
      let mut at = usize.ZERO
      while at < range.length {
        let child = Module.child(hir, range, at)
        let candidate = run writtenMember(hir, child, kind)
        if let Option<Member>.Some {value: member} = move candidate {
          let prior = Vector.asSlice<Member>(&members)
          let mut before = usize.ZERO
          while before < prior.length {
            if memberSameName(&prior[before], &member) {
              return memberRejected(
                run reject(&resolver.*, &module, RejectionCode.Collision, Module.span(hir, child)),
                move dependencies,
              )
            }
            before = before + usize.ONE
          }
          run Vector.append<Member>(&mut members, move member)
        } else {
          return memberRejected(
            run reject(&resolver.*, &module, RejectionCode.Unsupported, Module.span(hir, child)),
            move dependencies,
          )
        }
        at = at + usize.ONE
      }
      return memberSuccess(Value.Members {members: move members}, move dependencies)
    }
    return memberRejected(
      run reject(&resolver.*, &module, RejectionCode.Unsupported, value.span),
      move dependencies,
    )
  }
  return memberRejected(
    run reject(&resolver.*, &module, RejectionCode.Unsupported, Span.make(usize.ZERO, usize.ZERO)),
    move dependencies,
  )
}

fn binderKind(binder: &Binder) -> GenericKind {
  return match & binder.* {
    Binder.Type {..} => GenericKind.Type
    Binder.Lifetime {..} => GenericKind.Lifetime
    Binder.Row {..} => GenericKind.Requirement
  }
}

fn argumentKind(argument: &Argument) -> GenericKind {
  return match & argument.* {
    Argument.Type {..} => GenericKind.Type
    Argument.Lifetime {..} => GenericKind.Lifetime
    Argument.Row {..} => GenericKind.Requirement
  }
}

effect fn resolveMemberShape(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  key: Key,
) -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let module = run resolvedModule(&resolver.*, key.module)
  let mut dependencies = Vector.make<Dependency>()
  let written = run header(&mut resolver.*, &module, key.declaration)
  if let Option<HeaderSyntax>.Some {value} = move written {
    let namesKey = Key {
      family: Family.Members,
      module: key.module,
      name: usize.ZERO,
      declaration: key.declaration,
      member: usize.ZERO,
      external: false,
    }
    let names = run demandChild(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies,
      namesKey,
      value.span,
    )
    let rejected = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
      &names,
      answerRejection,
    )
    if let Option<Shared<Rejection>>.Some {value: diagnostic} = move rejected {
      return memberRejected(move diagnostic, move dependencies)
    }
    let mut range = Range.empty()
    let mut kind = MemberKind.Field
    if let Node.StructHeader {fields, ..} = value.header {
      range = fields
    } else if let Node.TupleHeader {elements, ..} = value.header {
      range = elements
      kind = MemberKind.Position
    } else if let Node.EnumHeader {members, ..} = value.header {
      range = members
      kind = MemberKind.EnumCase
    } else if let Node.UnionHeader {variants, ..} = value.header {
      range = variants
      kind = MemberKind.Variant
    } else {
      return memberRejected(
        run reject(&resolver.*, &module, RejectionCode.Unsupported, value.span),
        move dependencies,
      )
    }
    if key.member >= range.length {
      return memberRejected(
        run reject(&resolver.*, &module, RejectionCode.UnknownMember, value.span),
        move dependencies,
      )
    }
    let found = run declarationAt(&mut resolver.*, &module, key.declaration)
    let applications = Vector.asSlice<Shared<Type>>(&resolver.applications)
    let application = Shared.clone<Type>(&applications[key.name])
    if let Option<DeclarationId>.Some {value: declaration} = move found {
      if !Shared.with<Type, bool>(
        &application,
        fn(ty: &Type) -> bool {
          return applicationMatches(ty, &declaration)
        },
      ) {
        return memberRejected(
          run reject(&resolver.*, &module, RejectionCode.NotType, value.span),
          move dependencies,
        )
      }
    } else {
      return memberRejected(
        run reject(&resolver.*, &module, RejectionCode.NotType, value.span),
        move dependencies,
      )
    }
    let template = run templateBinders(&mut resolver.*, &module, key.declaration)
    let binders = match move template {
      Result<Vector<Binder>, Shared<Rejection>>.Success {value: resolvedBinders} => move resolvedBinders
      Result<Vector<Binder>, Shared<Rejection>>.Failure {error} => {
        return memberRejected(move error, move dependencies)
      }
    }
    let mut arguments = Vector.make<Argument>()
    let count = Shared.with<Type, usize>(&application, applicationLength)
    if count != Vector.length<Binder>(&binders) {
      return memberRejected(
        run rejectArity(&resolver.*, &module, value.span, Vector.length<Binder>(&binders), count),
        move dependencies,
      )
    }
    let mut at = usize.ZERO
    while at < count {
      let supplied = Shared.with<Type, Option<Argument>>(
        &application,
        fn(ty: &Type) -> Option<Argument> {
          return applicationArgument(ty, at)
        },
      )
      if let Option<Argument>.Some {value: argument} = move supplied {
        run Vector.append<Argument>(&mut arguments, move argument)
      }
      at = at + usize.ONE
    }
    let parameters = Vector.asSlice<Binder>(&binders)
    let supplied = Vector.asSlice<Argument>(&arguments)
    let mut argumentAt = usize.ZERO
    while argumentAt < count {
      let expectedKind = binderKind(&parameters[argumentAt])
      let suppliedKind = argumentKind(&supplied[argumentAt])
      if expectedKind != suppliedKind {
        return memberRejected(
          run rejectKind(
            &resolver.*,
            &module,
            value.span,
            binderName(&parameters[argumentAt]),
            expectedKind,
            suppliedKind,
          ),
          move dependencies,
        )
      }
      argumentAt = argumentAt + usize.ONE
    }
    let applied = run bindArguments(
      Vector.asSlice<Binder>(&binders),
      Vector.asSlice<Argument>(&arguments),
    )
    let mut annotations = Vector.make<HirId>()
    let sourceAnswer = run source(&mut resolver.*, &module)
    if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(
      &resolver.*,
      &sourceAnswer,
      &module,
    ) {
      let hir = IndexedSource.authored(indexed)
      let member = Module.child(hir, range, key.member)
      if kind == MemberKind.Position {
        run Vector.append<HirId>(&mut annotations, member)
      } else if kind == MemberKind.Field {
        if let Node.Field {annotation, ..} = Module.node(hir, member) {
          run Vector.append<HirId>(&mut annotations, annotation)
        }
      } else if kind == MemberKind.Variant {
        if let Node.Variant {fields, ..} = Module.node(hir, member) {
          let mut fieldAt = usize.ZERO
          while fieldAt < fields.length {
            let field = Module.child(hir, fields, fieldAt)
            if let Node.Field {annotation, ..} = Module.node(hir, field) {
              run Vector.append<HirId>(&mut annotations, annotation)
            } else {
              return memberRejected(
                run reject(&resolver.*, &module, RejectionCode.Unsupported, Module.span(hir, field)),
                move dependencies,
              )
            }
            fieldAt = fieldAt + usize.ONE
          }
        }
      }
    } else {
      return memberRejected(
        run reject(&resolver.*, &module, RejectionCode.Unsupported, value.span),
        move dependencies,
      )
    }
    drop sourceAnswer
    let mut elision = LifetimeElision {
      owner: run declarationAt(&mut resolver.*, &module, key.declaration),
      nextOrdinal: Vector.length<Binder>(&binders),
      output: false,
      resultDefault: Option.none<Shared<Lifetime>>(),
      generated: Vector.make<Shared<Lifetime>>(),
      invocation: false,
      nested: false,
      renumber: Vector.make<usize>(),
      staticEnvironment: false,
    }
    let mut types = Vector.make<Shared<Type>>()
    let writtenTypes = Vector.asSlice<HirId>(&annotations)
    let mut typeAt = usize.ZERO
    while typeAt < writtenTypes.length {
      let resolved = run resolveType(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies,
        key.module,
        writtenTypes[typeAt],
        Vector.asSlice<Binder>(&applied),
        &mut elision,
      )
      match move resolved {
        Result<Shared<Type>, Shared<Rejection>>.Success {value: ty} => {
          let existential = run existentialRejection(
            &mut resolver.*,
            &module,
            writtenTypes[typeAt],
            &ty,
          )
          if let Option<Shared<Rejection>>.Some {value: diagnostic} = move existential {
            return memberRejected(move diagnostic, move dependencies)
          }
          run Vector.append<Shared<Type>>(&mut types, move ty)
        }
        Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
          return memberRejected(move error, move dependencies)
        }
      }
      typeAt = typeAt + usize.ONE
    }
    let generatedCount = Vector.length<Shared<Lifetime>>(&elision.generated)
    if generatedCount > usize.ZERO {
      return memberRejected(
        run reject(&resolver.*, &module, RejectionCode.Unsupported, value.span),
        move dependencies,
      )
    }
    return memberSuccess(Value.MemberShape {types: move types}, move dependencies)
  }
  return memberRejected(
    run reject(&resolver.*, &module, RejectionCode.Unsupported, Span.make(usize.ZERO, usize.ZERO)),
    move dependencies,
  )
}

// Records one written bound. It checks that the contract is an interface or service application;
// whether any provider conforms is a later question.
effect fn declareBound(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  moduleOrdinal: usize,
  module: &ModuleId,
  binder: &Binder,
  boundId: HirId,
  binders: &[Binder],
  elision: &mut LifetimeElision,
  isPublic: bool,
  constraints: &mut Vector<Constraint>,
) -> Option<Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let syntax = run typeNode(&mut resolver.*, module, boundId)
  let mut span = Span.make(usize.ZERO, usize.ZERO)
  let mut isLifetime = false
  if let Option<HeaderSyntax>.Some {value} = move syntax {
    span = value.span
    if let Node.Lifetime {..} = value.header {
      isLifetime = true
    }
  }
  if isLifetime {
    let resolved = run lifetimeAt(&mut resolver.*, module, boundId, binders)
    let region = match move resolved {
      Result<Shared<Lifetime>, Shared<Rejection>>.Success {value} => move value
      Result<Shared<Lifetime>, Shared<Rejection>>.Failure {error} => {
        return Option.some<Shared<Rejection>>(move error)
      }
    }
    if let Binder.Type {value: subject, ..} = &binder.* {
      run Vector.append<Constraint>(
        &mut constraints.*,
        Constraint.Contents {subject: Shared.clone<Type>(&subject), region: move region},
      )
      return Option.none<Shared<Rejection>>()
    }
    if let Binder.Lifetime {value: longer, ..} = &binder.* {
      run Vector.append<Constraint>(
        &mut constraints.*,
        Constraint.Outlives {longer: Shared.clone<Lifetime>(&longer), shorter: move region},
      )
      return Option.none<Shared<Rejection>>()
    }
  }
  if let Binder.Type {value: provider, ..} = &binder.* {
    let sealed = run sealedProperty(&mut resolver.*, module, boundId, binders)
    if let Option<SealedProperty>.Some {value: property} = move sealed {
      // Only Copy is a bound; Drop is requested by an `impl`, never required of a parameter.
      let copyable = match property {
        SealedProperty.Copy => true
        SealedProperty.Drop => false
      }
      if !copyable {
        return Option.some<Shared<Rejection>>(
          run reject(&resolver.*, module, RejectionCode.InvalidBound, span),
        )
      }
      let prior = Vector.asSlice<Constraint>(&constraints.*)
      let mut at = usize.ZERO
      while at < prior.length {
        if let Constraint.Copyable {subject} = &prior[at] {
          if run Type.equalsShared(&subject, &provider) {
            return Option.some<Shared<Rejection>>(
              run reject(&resolver.*, module, RejectionCode.DuplicateBound, span),
            )
          }
        }
        at = at + usize.ONE
      }
      run Vector.append<Constraint>(
        &mut constraints.*,
        Constraint.Copyable {subject: Shared.clone<Type>(&provider)},
      )
      return Option.none<Shared<Rejection>>()
    }
    let resolved = run resolveType(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies.*,
      moduleOrdinal,
      boundId,
      binders,
      &mut elision.*,
    )
    let contract = match move resolved {
      Result<Shared<Type>, Shared<Rejection>>.Success {value} => move value
      Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
        return Option.some<Shared<Rejection>>(move error)
      }
    }
    let exposure = run exposedPrivate(&mut resolver.*, module, boundId, &contract, isPublic)
    if let Option<Shared<Rejection>>.Some {value} = move exposure {
      return Option.some<Shared<Rejection>>(move value)
    }
    // A callable or Effect contract makes the parameter a representation parameter.
    if Shared.with<Type, bool>(&contract, executableContract) {
      run Vector.append<Constraint>(
        &mut constraints.*,
        Constraint.Represents {parameter: Shared.clone<Type>(&provider), contract: move contract},
      )
      return Option.none<Shared<Rejection>>()
    }
    // A service is an interface with dependency eligibility; both are valid static bounds.
    let kind = Shared.with<Type, OwnerKind>(&contract, nominalKind)
    if kind != OwnerKind.Interface && kind != OwnerKind.Service {
      return Option.some<Shared<Rejection>>(
        run reject(&resolver.*, module, RejectionCode.InvalidBound, span),
      )
    }
    let prior = Vector.asSlice<Constraint>(&constraints.*)
    let mut at = usize.ZERO
    while at < prior.length {
      if let Constraint.Conforms {provider: earlier, contract: applied} = &prior[at] {
        let sameProvider = run Type.equalsShared(&earlier, &provider)
        let sameContract = run Type.equalsShared(&applied, &contract)
        if sameProvider && sameContract {
          return Option.some<Shared<Rejection>>(
            run reject(&resolver.*, module, RejectionCode.DuplicateBound, span),
          )
        }
      }
      at = at + usize.ONE
    }
    run Vector.append<Constraint>(
      &mut constraints.*,
      Constraint.Conforms {provider: Shared.clone<Type>(&provider), contract: move contract},
    )
    return Option.none<Shared<Rejection>>()
  }
  return Option.some<Shared<Rejection>>(
    run reject(&resolver.*, module, RejectionCode.InvalidBound, span),
  )
}

effect fn resolveConstraints(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  moduleOrdinal: usize,
  module: &ModuleId,
  generics: Range,
  binders: &[Binder],
  elision: &mut LifetimeElision,
  isPublic: bool,
) -> Result<Vector<Constraint>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let mut constraints = Vector.make<Constraint>()
  let mut at = usize.ZERO
  // Template binders are one-to-one with the written generic list.
  while at < generics.length && at < binders.length {
    let child = run typeChild(&mut resolver.*, module, generics, at)
    let mut bounds = Range.empty()
    if let Option<HirId>.Some {value: parameterId} = move child {
      let syntax = run typeNode(&mut resolver.*, module, parameterId)
      if let Option<HeaderSyntax>.Some {value} = move syntax {
        if let Node.TypeParameter {bounds: written, ..} = value.header {
          bounds = written
        }
        if let Node.LifetimeParameter {bounds: written, ..} = value.header {
          bounds = written
        }
      }
    }
    let mut boundAt = usize.ZERO
    while boundAt < bounds.length {
      let bound = run typeChild(&mut resolver.*, module, bounds, boundAt)
      if let Option<HirId>.Some {value: boundId} = move bound {
        let failed = run declareBound(
          &mut resolver.*,
          &mut owner.*,
          &mut dependencies.*,
          moduleOrdinal,
          module,
          &binders[at],
          boundId,
          binders,
          &mut elision.*,
          isPublic,
          &mut constraints,
        )
        if let Option<Shared<Rejection>>.Some {value} = move failed {
          return Result.failResult<Vector<Constraint>, Shared<Rejection>>(move value)
        }
      }
      boundAt = boundAt + usize.ONE
    }
    at = at + usize.ONE
  }
  return Result.succeed<Vector<Constraint>, Shared<Rejection>>(move constraints)
}

effect fn resolveContract(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  key: Key,
) -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let module = run resolvedModule(&resolver.*, key.module)
  let mut dependencies = Vector.make<Dependency>()
  let written = run header(&mut resolver.*, &module, key.declaration)
  if let Option<HeaderSyntax>.Some {value} = move written {
    let isPublic = match value.header {
      Node.StructHeader {isPublic, ..} => isPublic
      Node.TupleHeader {isPublic, ..} => isPublic
      Node.EnumHeader {isPublic, ..} => isPublic
      Node.UnionHeader {isPublic, ..} => isPublic
      Node.ServiceHeader {isPublic, ..} => isPublic
      Node.InterfaceHeader {isPublic, ..} => isPublic
      Node.AliasHeader {isPublic, ..} => isPublic
      Node.RoleHeader {isPublic, ..} => isPublic
      _ => {
        return memberRejected(
          run reject(&resolver.*, &module, RejectionCode.NotType, value.span),
          move dependencies,
        )
      }
    }
    let template = run templateBinders(&mut resolver.*, &module, key.declaration)
    let binders = match move template {
      Result<Vector<Binder>, Shared<Rejection>>.Success {value: found} => move found
      Result<Vector<Binder>, Shared<Rejection>>.Failure {error} => {
        return memberRejected(move error, move dependencies)
      }
    }
    let contractOwner = isContractHeader(value.header)
    if contractOwner {
      let none = Vector.make<Binder>()
      let conflict = run scopedBinderRejection(
        &mut resolver.*,
        &module,
        headerGenerics(value.header),
        Vector.asSlice<Binder>(&none),
        true,
      )
      if let Option<Shared<Rejection>>.Some {value: diagnostic} = move conflict {
        return memberRejected(move diagnostic, move dependencies)
      }
    }
    let lists = run parametersOf(Vector.asSlice<Binder>(&binders))
    let mut elision = LifetimeElision {
      owner: run declarationAt(&mut resolver.*, &module, key.declaration),
      nextOrdinal: Vector.length<Binder>(&binders),
      output: false,
      resultDefault: Option.none<Shared<Lifetime>>(),
      generated: Vector.make<Shared<Lifetime>>(),
      invocation: false,
      nested: false,
      renumber: Vector.make<usize>(),
      staticEnvironment: false,
    }
    let declared = run resolveConstraints(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies,
      key.module,
      &module,
      headerGenerics(value.header),
      Vector.asSlice<Binder>(&binders),
      &mut elision,
      isPublic,
    )
    let constraints = match move declared {
      Result<Vector<Constraint>, Shared<Rejection>>.Success {value: found} => move found
      Result<Vector<Constraint>, Shared<Rejection>>.Failure {error} => {
        return memberRejected(move error, move dependencies)
      }
    }
    // A bound's omitted lifetime would add a declaration lifetime its applications cannot name.
    if Vector.length<Shared<Lifetime>>(&elision.generated) > usize.ZERO {
      return memberRejected(
        run reject(&resolver.*, &module, RejectionCode.Unsupported, value.span),
        move dependencies,
      )
    }
    let mut provider = Option.none<Shared<Type>>()
    if contractOwner {
      let identity = run declarationAt(&mut resolver.*, &module, key.declaration)
      if let Option<DeclarationId>.Some {value: contract} = move identity {
        provider = Option.some<Shared<Type>>(
          run Shared.make<Type>(
            Type.Parameter {declaration: move contract, ordinal: Vector.length<Binder>(&binders)},
          ),
        )
      }
    }
    return memberSuccess(
      Value.Contract {
        contract: Contract {
          typeParameters: move lists.types,
          lifetimeParameters: move lists.lifetimes,
          rowParameters: move lists.rows,
          constraints: move constraints,
          provider: move provider,
        },
      },
      move dependencies,
    )
  }
  return memberRejected(
    run reject(&resolver.*, &module, RejectionCode.Unsupported, Span.make(usize.ZERO, usize.ZERO)),
    move dependencies,
  )
}

// The written name node of one generic binder, absent for damaged binder syntax.
fn binderNameId(parameter: Node) -> HirRef {
  return match parameter {
    Node.TypeParameter {name, ..} => HirRef.of(name)
    Node.RowParameter {name} => HirRef.of(name)
    Node.LifetimeParameter {name, ..} => HirRef.of(name)
    _ => HirRef.absent()
  }
}

// Rejects a written binder that reuses a spelling already bound around it. The implicit `Self`
// provider reserves its name. An inherent member's restated owner binder is a refinement and never
// reaches this check; restating an interface, service, or conformance binder has no settled meaning,
// so that form stays `Unsupported` rather than choosing shadowing or refinement.
effect fn scopedBinderRejection(
  resolver: &mut Resolver,
  module: &ModuleId,
  generics: Range,
  enclosing: &[Binder],
  reservesSelf: bool,
) -> Option<Shared<Rejection>> ! Cycle | OutOfMemoryError ? &mut Allocator {
  let answer = run source(&mut resolver.*, module)
  if let Option<&IndexedSource>.Some {value} = move sourceOf(&resolver.*, &answer, module) {
    let hir = IndexedSource.authored(value)
    let mut at = usize.ZERO
    while at < generics.length {
      let parameter = Module.child(hir, generics, at)
      let name = binderNameId(Module.node(hir, parameter))
      if name.present {
        if let Node.Name {text} = Module.node(hir, name.id) {
          let spelling = Module.text(hir, text)
          if reservesSelf && same(spelling, b"Self") {
            return Option.some<Shared<Rejection>>(
              run reject(
                &resolver.*,
                module,
                RejectionCode.DuplicateTypeParameter,
                Module.span(hir, parameter),
              ),
            )
          }
          if hasBinder(enclosing, spelling) {
            return Option.some<Shared<Rejection>>(
              run reject(&resolver.*, module, RejectionCode.Unsupported, Module.span(hir, parameter)),
            )
          }
        }
      }
      at = at + usize.ONE
    }
  }
  return Option.none<Shared<Rejection>>()
}

// The implicit `Self` provider of an interface or service, bound after its written binders.
effect fn selfBinder(owner: DeclarationId, writtenCount: usize) -> Binder
! OutOfMemoryError
? &mut Allocator {
  return Binder.Type {
    name: run Bytes.copy(b"Self"),
    value: run Shared.make<Type>(Type.Parameter {declaration: move owner, ordinal: writtenCount}),
  }
}

fn headProvider(head: &ImplementationHead) -> Shared<Type> {
  return Shared.clone<Type>(&head.provider)
}

// `Self` inside an implementation denotes its applied provider.
effect fn providerBinder(provider: Shared<Type>) -> Binder ! OutOfMemoryError ? &mut Allocator {
  return Binder.Type {name: run Bytes.copy(b"Self"), value: move provider}
}

fn isContractHeader(header: Node) -> bool {
  return match header {
    Node.InterfaceHeader {..} => true
    Node.ServiceHeader {..} => true
    _ => false
  }
}

// The binders visible around a nested declaration's own binders. An interface or service operation
// sees its contract's written binders followed by the implicit `Self` provider. An `impl` member
// sees the implementation's written binders and `Self` as the head's applied provider. A top-level
// declaration sees none.
effect fn enclosingScope(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  moduleOrdinal: usize,
  module: &ModuleId,
  ordinal: usize,
) -> Result<Vector<Binder>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let mut parent = usize.MAX
  let answer = run source(&mut resolver.*, module)
  if let Option<&IndexedSource>.Some {value} = move sourceOf(&resolver.*, &answer, module) {
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(value))
    if ordinal < declarations.length {
      if let Option<usize>.Some {value: enclosing} = &declarations[ordinal].parent {
        parent = enclosing
      }
    }
  }
  if parent == usize.MAX {
    return Result.succeed<Vector<Binder>, Shared<Rejection>>(Vector.make<Binder>())
  }
  let written = run header(&mut resolver.*, module, parent)
  if let Option<HeaderSyntax>.Some {value} = move written {
    if let Node.ImplHeader {..} = value.header {
      let headKey = Key {
        family: Family.ImplementationHead,
        module: moduleOrdinal,
        name: usize.ZERO,
        declaration: parent,
        member: usize.ZERO,
        external: false,
      }
      let child = run demandChild(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies.*,
        headKey,
        value.span,
      )
      let head = Shared.with<Result<Answer, NoRejection>, Option<Shared<ImplementationHead>>>(
        &child,
        headOf,
      )
      if let Option<Shared<ImplementationHead>>.Some {value: found} = move head {
        let template = run templateBinders(&mut resolver.*, module, parent)
        let mut binders = match move template {
          Result<Vector<Binder>, Shared<Rejection>>.Success {value: listed} => move listed
          Result<Vector<Binder>, Shared<Rejection>>.Failure {error} => {
            return Result.failResult<Vector<Binder>, Shared<Rejection>>(move error)
          }
        }
        let provider = Shared.with<ImplementationHead, Shared<Type>>(&found, headProvider)
        run Vector.append<Binder>(&mut binders, run providerBinder(move provider))
        return Result.succeed<Vector<Binder>, Shared<Rejection>>(move binders)
      }
      let failed = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
        &child,
        answerRejection,
      )
      if let Option<Shared<Rejection>>.Some {value: diagnostic} = move failed {
        return Result.failResult<Vector<Binder>, Shared<Rejection>>(move diagnostic)
      }
      return Result.failResult<Vector<Binder>, Shared<Rejection>>(
        run reject(&resolver.*, module, RejectionCode.Unsupported, value.span),
      )
    }
    if !isContractHeader(value.header) {
      return Result.succeed<Vector<Binder>, Shared<Rejection>>(Vector.make<Binder>())
    }
  }
  let template = run templateBinders(&mut resolver.*, module, parent)
  let mut binders = match move template {
    Result<Vector<Binder>, Shared<Rejection>>.Success {value} => move value
    Result<Vector<Binder>, Shared<Rejection>>.Failure {error} => {
      return Result.failResult<Vector<Binder>, Shared<Rejection>>(move error)
    }
  }
  let identity = run declarationAt(&mut resolver.*, module, parent)
  if let Option<DeclarationId>.Some {value: contract} = move identity {
    let count = Vector.length<Binder>(&binders)
    run Vector.append<Binder>(&mut binders, run selfBinder(move contract, count))
  }
  return Result.succeed<Vector<Binder>, Shared<Rejection>>(move binders)
}

// Whether a declaration is a member of an inherent `impl`, whose owner binders it may refine.
effect fn refinesEnclosing(resolver: &mut Resolver, module: &ModuleId, ordinal: usize) -> bool
! Cycle | OutOfMemoryError
? &mut Allocator {
  let answer = run source(&mut resolver.*, module)
  if let Option<&IndexedSource>.Some {value} = move sourceOf(&resolver.*, &answer, module) {
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(value))
    if ordinal < declarations.length {
      if let Option<usize>.Some {value: parent} = &declarations[ordinal].parent {
        let hir = IndexedSource.authored(value)
        return isImplementationHeader(hir, &declarations[parent]) && !isConformanceHeader(
          hir,
          &declarations[parent],
        )
      }
    }
  }
  return false
}

// The enclosing binder that an own binder restates with the same spelling and kind, if refinable.
effect fn restatedBinder(binders: &Vector<Binder>, at: usize, visible: &[Binder], refines: bool) -> Option<
  Binder,
> ! OutOfMemoryError ? &mut Allocator {
  if !refines {
    return Option.none<Binder>()
  }
  let current = Vector.asSlice<Binder>(binders)
  let mut index = usize.ZERO
  while index < visible.length {
    if same(binderName(&visible[index]), binderName(&current[at])) && binderKind(&visible[index]) == binderKind(
      &current[at],
    ) {
      return Option.some<Binder>(run copyBinder(&visible[index]))
    }
    index = index + usize.ONE
  }
  return Option.none<Binder>()
}

effect fn binderAt(binders: &Vector<Binder>, at: usize) -> Binder ! OutOfMemoryError ? &mut Allocator {
  let current = Vector.asSlice<Binder>(binders)
  return run copyBinder(&current[at])
}

// The identity of the declaration directly enclosing `ordinal`, if any.
effect fn enclosingIdentity(resolver: &mut Resolver, module: &ModuleId, ordinal: usize) -> Option<
  DeclarationId,
> ! Cycle | OutOfMemoryError ? &mut Allocator {
  let mut parent = usize.MAX
  let answer = run source(&mut resolver.*, module)
  if let Option<&IndexedSource>.Some {value} = move sourceOf(&resolver.*, &answer, module) {
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(value))
    if ordinal < declarations.length {
      if let Option<usize>.Some {value: enclosing} = &declarations[ordinal].parent {
        parent = enclosing
      }
    }
  }
  if parent == usize.MAX {
    return Option.none<DeclarationId>()
  }
  return run declarationAt(&mut resolver.*, module, parent)
}

effect fn collectConstraint(
  constraint: &Constraint,
  owner: &DeclarationId,
  types: &mut Vector<usize>,
  regions: &mut Vector<usize>,
  rows: &mut Vector<usize>,
) -> () ! OutOfMemoryError ? &mut Allocator {
  match & constraint.* {
    Constraint.Conforms {provider, contract} => {
      run Type.collectOwned(&provider, owner, &mut types.*, &mut regions.*, &mut rows.*)
      run Type.collectOwned(&contract, owner, &mut types.*, &mut regions.*, &mut rows.*)
    }
    Constraint.Represents {parameter, contract} => {
      run Type.collectOwned(&parameter, owner, &mut types.*, &mut regions.*, &mut rows.*)
      run Type.collectOwned(&contract, owner, &mut types.*, &mut regions.*, &mut rows.*)
    }
    Constraint.Contents {subject, region} => {
      run Type.collectOwned(&subject, owner, &mut types.*, &mut regions.*, &mut rows.*)
      run Type.collectOwnedLifetime(&region, owner, &mut regions.*)
    }
    Constraint.Outlives {longer, shorter} => {
      run Type.collectOwnedLifetime(&longer, owner, &mut regions.*)
      run Type.collectOwnedLifetime(&shorter, owner, &mut regions.*)
    }
    Constraint.Copyable {subject} => {
      run Type.collectOwned(&subject, owner, &mut types.*, &mut regions.*, &mut rows.*)
    }
  }
  return ()
}

// The ordinals in ascending order, so owner binders keep their declaration order.
effect fn sortedOrdinals(values: &Vector<usize>) -> Vector<usize> ! OutOfMemoryError ? &mut Allocator {
  let mut sorted = Vector.make<usize>()
  let source = Vector.asSlice<usize>(values)
  let mut at = usize.ZERO
  while at < source.length {
    run Vector.append<usize>(&mut sorted, source[at])
    let mut position = Vector.length<usize>(&sorted) - usize.ONE
    while position > usize.ZERO && Vector.get<usize>(&sorted, position - usize.ONE) > Vector.get<usize>(
      &sorted,
      position,
    ) {
      let earlier = Vector.get<usize>(&sorted, position - usize.ONE)
      let later = Vector.get<usize>(&sorted, position)
      Vector.set<usize>(&mut sorted, position - usize.ONE, later)
      Vector.set<usize>(&mut sorted, position, earlier)
      position = position - usize.ONE
    }
    at = at + usize.ONE
  }
  return move sorted
}

fn enclosedBy(declaration: &IndexedDeclaration, parent: usize) -> bool {
  return match & declaration.parent {
    Option<usize>.Some {value} => value == parent
    Option<usize>.None => false
  }
}

fn writesBody(hir: &Module, declaration: HirId) -> bool {
  if let Node.Declaration {body, ..} = Module.node(hir, declaration) {
    if let Node.CallableBody {block} = Module.node(hir, body) {
      return block.present
    }
  }
  return false
}

effect fn resolveOperations(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  key: Key,
) -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let module = run resolvedModule(&resolver.*, key.module)
  let dependencies = Vector.make<Dependency>()
  let answer = run source(&mut resolver.*, &module)
  if let Option<&IndexedSource>.Some {value} = move sourceOf(&resolver.*, &answer, &module) {
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(value))
    if key.declaration < declarations.length {
      let hir = IndexedSource.authored(value)
      let contractHeader = declarations[key.declaration].header
      if !isContractHeader(Module.node(hir, contractHeader)) {
        return memberRejected(
          run reject(&resolver.*, &module, RejectionCode.Unsupported, Module.span(hir, contractHeader)),
          move dependencies,
        )
      }
      let mut operations = Vector.make<Shared<DeclarationId>>()
      let mut names = Vector.make<Bytes>()
      let mut at = usize.ZERO
      while at < declarations.length {
        if enclosedBy(&declarations[at], key.declaration) {
          let memberHeader = declarations[at].header
          let span = Module.span(hir, memberHeader)
          let mut spelling = Option.none<Bytes>()
          if let Node.OperationHeader {name, isPublic, ..} = Module.node(hir, memberHeader) {
            if !isPublic && !writesBody(hir, declarations[at].local) {
              if let Node.Name {text} = Module.node(hir, name) {
                spelling = Option.some<Bytes>(run Bytes.copy(Module.text(hir, text)))
              }
            }
          }
          if let Option<Bytes>.Some {value: operation} = move spelling {
            let prior = Vector.asSlice<Bytes>(&names)
            let mut before = usize.ZERO
            while before < prior.length {
              if same(Bytes.asSlice(&prior[before]), Bytes.asSlice(&operation)) {
                return memberRejected(
                  run reject(&resolver.*, &module, RejectionCode.Collision, span),
                  move dependencies,
                )
              }
              before = before + usize.ONE
            }
            run Vector.append<Bytes>(&mut names, move operation)
            run Vector.append<Shared<DeclarationId>>(
              &mut operations,
              run Shared.make<DeclarationId>(run DeclarationId.copy(&declarations[at].identity)),
            )
          } else {
            return memberRejected(
              run reject(&resolver.*, &module, RejectionCode.InvalidContractMember, span),
              move dependencies,
            )
          }
        }
        at = at + usize.ONE
      }
      return memberSuccess(Value.Operations {operations: move operations}, move dependencies)
    }
  }
  return memberRejected(
    run reject(&resolver.*, &module, RejectionCode.Unsupported, Span.make(usize.ZERO, usize.ZERO)),
    move dependencies,
  )
}

// The one operation or function named `name` directly inside the declaration at `parent`; a
// repeated name has no winner and yields the later declaration's span instead.
struct MemberLookup {
  ordinal: Option<usize>
  repeated: Option<Span>
}

effect fn memberOrdinal(resolver: &mut Resolver, module: &ModuleId, parent: usize, name: &[u8]) -> MemberLookup
! Cycle | OutOfMemoryError
? &mut Allocator {
  let mut found = Option.none<usize>()
  let answer = run source(&mut resolver.*, module)
  if let Option<&IndexedSource>.Some {value} = move sourceOf(&resolver.*, &answer, module) {
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(value))
    let hir = IndexedSource.authored(value)
    let mut at = usize.ZERO
    while at < declarations.length {
      if enclosedBy(&declarations[at], parent) {
        let written = match Module.node(hir, declarations[at].header) {
          Node.OperationHeader {name: spelled, ..} => HirRef.of(spelled)
          Node.FunctionHeader {name: spelled, ..} => HirRef.of(spelled)
          _ => HirRef.absent()
        }
        if written.present {
          if let Node.Name {text} = Module.node(hir, written.id) {
            if same(Module.text(hir, text), name) {
              if let Option<usize>.Some {..} = &found {
                return MemberLookup {
                  ordinal: Option.none<usize>(),
                  repeated: Option.some<Span>(Module.span(hir, declarations[at].header)),
                }
              }
              found = Option.some<usize>(at)
            }
          }
        }
      }
      at = at + usize.ONE
    }
  }
  return MemberLookup {ordinal: move found, repeated: Option.none<Span>()}
}

// What an owner's inherent member list says about one member name.
struct InherentLookup {
  published: Option<Shared<DeclarationId>>
  rejected: Option<Shared<Rejection>>
}

fn inherentLookup(answer: &Result<Answer, NoRejection>, member: &[u8]) -> InherentLookup {
  let mut lookup = InherentLookup {
    published: Option.none<Shared<DeclarationId>>(),
    rejected: Option.none<Shared<Rejection>>(),
  }
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.InherentMembers {members, rejected}} = &value.outcome {
      let listed = Vector.asSlice<Shared<DeclarationId>>(&members)
      let mut at = usize.ZERO
      while at < listed.length {
        if Shared.with<DeclarationId, bool>(
          &listed[at],
          fn(declaration: &DeclarationId) -> bool {
            return DeclarationId.named(declaration, member)
          },
        ) {
          lookup.published = Option.some<Shared<DeclarationId>>(Shared.clone<DeclarationId>(&listed[at]))
        }
        at = at + usize.ONE
      }
      let refused = Vector.asSlice<RejectedMember>(&rejected)
      at = usize.ZERO
      while at < refused.length {
        if Shared.with<DeclarationId, bool>(
          &refused[at].declaration,
          fn(declaration: &DeclarationId) -> bool {
            return DeclarationId.named(declaration, member)
          },
        ) {
          lookup.rejected = Option.some<Shared<Rejection>>(Shared.clone<Rejection>(&refused[at].rejection))
        }
        at = at + usize.ONE
      }
    }
  }
  return move lookup
}

// The index ordinal of a declaration identity in the held source of `module`.
effect fn ordinalOfIdentity(resolver: &mut Resolver, module: &ModuleId, identity: &Shared<DeclarationId>) -> Option<
  usize,
> ! Cycle | OutOfMemoryError ? &mut Allocator {
  let answer = run source(&mut resolver.*, module)
  if let Option<&IndexedSource>.Some {value} = move sourceOf(&resolver.*, &answer, module) {
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(value))
    let mut at = usize.ZERO
    while at < declarations.length {
      let candidate = &declarations[at].identity
      if Shared.with<DeclarationId, bool>(
        identity,
        fn(declaration: &DeclarationId) -> bool {
          return DeclarationId.equals(candidate, declaration)
        },
      ) {
        return Option.some<usize>(at)
      }
      at = at + usize.ONE
    }
  }
  return Option.none<usize>()
}

// The ordinal of the `occurrence`th top-level `impl` declaration of a module.
effect fn implementationOrdinal(resolver: &mut Resolver, module: &ModuleId, occurrence: usize) -> Option<
  usize,
> ! Cycle | OutOfMemoryError ? &mut Allocator {
  let answer = run source(&mut resolver.*, module)
  if let Option<&IndexedSource>.Some {value} = move sourceOf(&resolver.*, &answer, module) {
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(value))
    let hir = IndexedSource.authored(value)
    let mut seen = usize.ZERO
    let mut at = usize.ZERO
    while at < declarations.length {
      if isImplementationHeader(hir, &declarations[at]) && topLevel(&declarations[at]) {
        if seen == occurrence {
          return Option.some<usize>(at)
        }
        seen = seen + usize.ONE
      }
      at = at + usize.ONE
    }
  }
  return Option.none<usize>()
}

// A root answer for a member the held revision does not contain.
effect fn rejectAbsent(resolver: &mut Resolver, module: &ModuleId, span: Span) -> Shared<
  Result<Answer, NoRejection>,
> ! Cycle | OutOfMemoryError ? &mut Allocator {
  let diagnostic = run reject(&resolver.*, module, RejectionCode.UnknownMember, span)
  return run rootRejection(&mut resolver.*, module, move diagnostic)
}

// A root answer that rejects with `diagnostic` while observing the module's current source.
effect fn rootRejection(resolver: &mut Resolver, module: &ModuleId, diagnostic: Shared<Rejection>) -> Shared<
  Result<Answer, NoRejection>,
> ! Cycle | OutOfMemoryError ? &mut Allocator {
  let mut sources = Vector.make<Shared<Observation>>()
  run Vector.append<Shared<Observation>>(
    &mut sources,
    run Shared.make<Observation>(run SourceIndex.captureObservation(&resolver.source, module)),
  )
  return run Shared.make<Result<Answer, NoRejection>>(
    Result.succeed<Answer, NoRejection>(
      Answer {
        outcome: Outcome.Rejected {diagnostic: move diagnostic},
        dependencies: Vector.make<Dependency>(),
        sources: move sources,
        footprint: Vector.make<Shared<DemandFootprint>>(),
        answerId: usize.ZERO,
        identity: Option.none<Shared<Value>>(),
        bodyEvidence: Option.none<Shared<BodyEvidence>>(),
      },
    ),
  )
}

// The sealed property a bare `Copy` or `Drop` spelling names. Like `Effect`, these are language
// bindings that need no import, so module lookup never selects them; only a binder shadows them.
effect fn sealedProperty(resolver: &mut Resolver, module: &ModuleId, id: HirId, binders: &[Binder]) -> Option<
  SealedProperty,
> ! Cycle | OutOfMemoryError ? &mut Allocator {
  let syntax = run typeNode(&mut resolver.*, module, id)
  if let Option<HeaderSyntax>.Some {value} = move syntax {
    if let Node.NamedType {path: typeName, hasMode, ..} = value.header {
      if !hasMode {
        let parsed = run path(&mut resolver.*, module, typeName)
        let segments = Vector.asSlice<Bytes>(&parsed.segments)
        if parsed.valid && segments.length == usize.ONE {
          let name = Bytes.asSlice(&segments[usize.ZERO])
          if !hasBinder(binders, name) {
            if same(name, b"Copy") {
              return Option.some<SealedProperty>(SealedProperty.Copy)
            }
            if same(name, b"Drop") {
              return Option.some<SealedProperty>(SealedProperty.Drop)
            }
          }
        }
      }
    }
  }
  return Option.none<SealedProperty>()
}

// Rejects a value type that applies an interface or service; they are contracts, not existentials.
effect fn existentialRejection(resolver: &mut Resolver, module: &ModuleId, id: HirId, value: &Shared<Type>) -> Option<
  Shared<Rejection>,
> ! Cycle | OutOfMemoryError ? &mut Allocator {
  if !Shared.with<Type, bool>(value, Type.mentionsContract) {
    return Option.none<Shared<Rejection>>()
  }
  let syntax = run typeNode(&mut resolver.*, module, id)
  let mut span = Span.make(usize.ZERO, usize.ZERO)
  if let Option<HeaderSyntax>.Some {value: written} = move syntax {
    span = written.span
  }
  return Option.some<Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.NotType, span))
}

// Whether a nominal type is declared in `module`; false for every other type.
fn declaredIn(value: &Type, module: &ModuleId) -> bool {
  return match & value.* {
    Type.Nominal {declaration, ..} => ModuleId.equals(DeclarationId.moduleId(&declaration), module)
    _ => false
  }
}

fn isNominalType(value: &Type) -> bool {
  return match & value.* {
    Type.Nominal {..} => true
    _ => false
  }
}

// A scalar or borrowed `string` provider has no declaring module.
fn foundationalProvider(value: &Type) -> bool {
  return match & value.* {
    Type.Primitive {..} => true
    Type.Unit => true
    Type.String {..} => true
    _ => false
  }
}

// The implementation-owned ordinal an argument names, or `usize.MAX` for any other argument.
fn argumentOrdinal(argument: &Argument, implementation: &DeclarationId) -> usize {
  return match & argument.* {
    Argument.Type {value} => Shared.with<Type, usize>(
      &value,
      fn(node: &Type) -> usize {
        return Type.parameterOrdinalOf(node, implementation)
      },
    )
    Argument.Lifetime {value} => Shared.with<Lifetime, usize>(
      &value,
      fn(region: &Lifetime) -> usize {
        return lifetimeOrdinalOf(region, implementation)
      },
    )
    Argument.Row {..} => usize.MAX
  }
}

// Whether a nominal owner's arguments are exactly the implementation's binders, each once: the
// written binders in declaration order, and lifetimes elided from the head wherever they occur.
fn wholeFamily(value: &Type, implementation: &DeclarationId, writtenCount: usize, binderCount: usize) -> bool {
  if let Type.Nominal {arguments, ..} = &value.* {
    let supplied = Vector.asSlice<Argument>(&arguments)
    if supplied.length != binderCount {
      return false
    }
    let mut nextWritten = usize.ZERO
    let mut at = usize.ZERO
    while at < supplied.length {
      let ordinal = argumentOrdinal(&supplied[at], implementation)
      if ordinal < writtenCount {
        if ordinal != nextWritten {
          return false
        }
        nextWritten = nextWritten + usize.ONE
      } else if ordinal >= binderCount {
        return false
      }
      at = at + usize.ONE
    }
    return nextWritten == writtenCount
  }
  return false
}

// The written spelling and arguments of an inherent head that names a declaration of its module.
struct InherentOwner {
  name: Bytes
  application: Option<HirId>
  span: Span
}

// An inherent owner is a struct, tuple, union, enum, service, or interface declaration.
fn inherentOwnerKind(value: &Type) -> bool {
  let kind = nominalKind(value)
  return kind == OwnerKind.Struct || kind == OwnerKind.Tuple || kind == OwnerKind.Union || kind == OwnerKind.Enumeration || kind == OwnerKind.Service || kind == OwnerKind.Interface
}

// Checks that an inherent head spells one declaration of its own module; an import, qualified
// path, alias, or foundational spelling is not an owner. An absent name is left to ordinary lookup.
effect fn inherentOwnerSyntax(resolver: &mut Resolver, module: &ModuleId, subject: HirId) -> Result<
  InherentOwner,
  Shared<Rejection>,
> ! Cycle | OutOfMemoryError ? &mut Allocator {
  let syntax = run typeNode(&mut resolver.*, module, subject)
  let mut span = Span.make(usize.ZERO, usize.ZERO)
  let mut named = HirRef.absent()
  let mut application = Option.none<HirId>()
  if let Option<HeaderSyntax>.Some {value} = move syntax {
    span = value.span
    if let Node.NamedType {path: written, hasMode, ..} = value.header {
      if !hasMode {
        named = HirRef.of(written)
      }
    }
    if let Node.AppliedType {target, arguments} = value.header {
      let applied = run typeNode(&mut resolver.*, module, target)
      if let Option<HeaderSyntax>.Some {value: found} = move applied {
        if let Node.NamedType {path: written, hasMode, ..} = found.header {
          if !hasMode {
            named = HirRef.of(written)
            application = Option.some<HirId>(arguments)
          }
        }
      }
    }
  }
  if named.present {
    let parsed = run path(&mut resolver.*, module, named.id)
    let segments = Vector.asSlice<Bytes>(&parsed.segments)
    if parsed.valid && segments.length == usize.ONE {
      let name = Bytes.asSlice(&segments[usize.ZERO])
      let selected = run select(&mut resolver.*, module, name, false)
      let mut owned = selected.count != usize.ONE
      if selected.count == usize.ZERO && (primitive(name) || same(name, b"string") || same(name, b"Effect")) {
        owned = false
      }
      if selected.count == usize.ONE && selected.kind == CandidateKind.Declaration {
        let declared = run header(&mut resolver.*, module, selected.declaration)
        owned = true
        if let Option<HeaderSyntax>.Some {value: found} = move declared {
          if let Node.AliasHeader {..} = found.header {
            owned = false
          }
        }
      }
      if owned {
        return Result.succeed<InherentOwner, Shared<Rejection>>(
          InherentOwner {name: run Bytes.copy(name), application: move application, span: span},
        )
      }
    }
  }
  return Result.failResult<InherentOwner, Shared<Rejection>>(
    run reject(&resolver.*, module, RejectionCode.InvalidInherentHead, span),
  )
}

fn lifetimeOrdinalOf(region: &Lifetime, owner: &DeclarationId) -> usize {
  if let Lifetime.Parameter {declaration, ordinal} = &region.* {
    if DeclarationId.equals(&declaration, owner) {
      return ordinal
    }
  }
  return usize.MAX
}

effect fn resolveImplementationHead(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  key: Key,
) -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let module = run resolvedModule(&resolver.*, key.module)
  let mut dependencies = Vector.make<Dependency>()
  let written = run header(&mut resolver.*, &module, key.declaration)
  let found = run declarationAt(&mut resolver.*, &module, key.declaration)
  let mut span = Span.make(usize.ZERO, usize.ZERO)
  let mut generics = Range.empty()
  let mut subject = HirId {index: usize.ZERO}
  let mut target = HirRef.absent()
  let mut isImplementation = false
  if let Option<HeaderSyntax>.Some {value} = move written {
    span = value.span
    if let Node.ImplHeader {generics: parameters, subject: named, target: provided} = value.header {
      generics = parameters
      subject = named
      target = provided
      isImplementation = true
    }
  }
  let implementation = match move found {
    Option<DeclarationId>.Some {value} => move value
    Option<DeclarationId>.None => {
      return memberRejected(
        run reject(&resolver.*, &module, RejectionCode.Unsupported, span),
        move dependencies,
      )
    }
  }
  if !isImplementation {
    return memberRejected(
      run reject(&resolver.*, &module, RejectionCode.Unsupported, span),
      move dependencies,
    )
  }
  let template = run templateBinders(&mut resolver.*, &module, key.declaration)
  let binders = match move template {
    Result<Vector<Binder>, Shared<Rejection>>.Success {value} => move value
    Result<Vector<Binder>, Shared<Rejection>>.Failure {error} => {
      return memberRejected(move error, move dependencies)
    }
  }
  // `Self` is bound inside every implementation, so no written binder may claim it.
  let none = Vector.make<Binder>()
  let conflict = run scopedBinderRejection(
    &mut resolver.*,
    &module,
    generics,
    Vector.asSlice<Binder>(&none),
    true,
  )
  if let Option<Shared<Rejection>>.Some {value: diagnostic} = move conflict {
    return memberRejected(move diagnostic, move dependencies)
  }
  let writtenCount = Vector.length<Binder>(&binders)
  // LIFE-003: lifetimes omitted from the heads become the implementation's own parameters.
  let mut elision = LifetimeElision {
    owner: Option.some<DeclarationId>(run DeclarationId.copy(&implementation)),
    nextOrdinal: writtenCount,
    output: false,
    resultDefault: Option.none<Shared<Lifetime>>(),
    generated: Vector.make<Shared<Lifetime>>(),
    invocation: false,
    nested: false,
    renumber: Vector.make<usize>(),
    staticEnvironment: false,
  }
  let mut kind = ImplementationKind.Inherent
  let mut contract = Option.none<Shared<Type>>()
  let mut providerId = subject
  // An inherent owner is looked up in module scope only, so a same-spelled declaration of this
  // module wins over a builtin spelling, and an import or alias is never an owner.
  let mut inherentOwner = Option.none<InherentOwner>()
  if !target.present {
    let checked = run inherentOwnerSyntax(&mut resolver.*, &module, subject)
    match move checked {
      Result<InherentOwner, Shared<Rejection>>.Success {value} => {
        inherentOwner = Option.some<InherentOwner>(move value)
      }
      Result<InherentOwner, Shared<Rejection>>.Failure {error} => {
        return memberRejected(move error, move dependencies)
      }
    }
  }
  if target.present {
    providerId = target.id
    kind = ImplementationKind.Conformance
    let sealed = run sealedProperty(
      &mut resolver.*,
      &module,
      subject,
      Vector.asSlice<Binder>(&binders),
    )
    if let Option<SealedProperty>.Some {value: property} = move sealed {
      kind = ImplementationKind.Sealed {property: property}
    } else {
      let resolved = run resolveType(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies,
        key.module,
        subject,
        Vector.asSlice<Binder>(&binders),
        &mut elision,
      )
      let applied = match move resolved {
        Result<Shared<Type>, Shared<Rejection>>.Success {value} => move value
        Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
          return memberRejected(move error, move dependencies)
        }
      }
      let contractKind = Shared.with<Type, OwnerKind>(&applied, nominalKind)
      if contractKind != OwnerKind.Interface && contractKind != OwnerKind.Service {
        let syntax = run typeNode(&mut resolver.*, &module, subject)
        let mut at = span
        if let Option<HeaderSyntax>.Some {value} = move syntax {
          at = value.span
        }
        return memberRejected(
          run reject(&resolver.*, &module, RejectionCode.InvalidBound, at),
          move dependencies,
        )
      }
      contract = Option.some<Shared<Type>>(move applied)
    }
  }
  let mut resolvedProvider = Result.failResult<Shared<Type>, Shared<Rejection>>(
    run reject(&resolver.*, &module, RejectionCode.Unsupported, span),
  )
  if let Option<InherentOwner>.Some {value: named} = move inherentOwner {
    let InherentOwner {name: ownerName, application, span: ownerSpan} = move named
    resolvedProvider = run namedType(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies,
      key.module,
      &module,
      Bytes.asSlice(&ownerName),
      false,
      ownerSpan,
      move application,
      Vector.asSlice<Binder>(&binders),
      &mut elision,
    )
  } else {
    resolvedProvider = run resolveType(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies,
      key.module,
      providerId,
      Vector.asSlice<Binder>(&binders),
      &mut elision,
    )
  }
  let provider = match move resolvedProvider {
    Result<Shared<Type>, Shared<Rejection>>.Success {value} => move value
    Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
      return memberRejected(move error, move dependencies)
    }
  }
  let providerSyntax = run typeNode(&mut resolver.*, &module, providerId)
  let mut providerSpan = span
  if let Option<HeaderSyntax>.Some {value} = move providerSyntax {
    providerSpan = value.span
  }
  let nominal = Shared.with<Type, bool>(&provider, isNominalType)
  let foundational = Shared.with<Type, bool>(&provider, foundationalProvider)
  let inherent = match & kind {
    ImplementationKind.Inherent => true
    _ => false
  }
  if inherent && !Shared.with<Type, bool>(&provider, inherentOwnerKind) {
    return memberRejected(
      run reject(&resolver.*, &module, RejectionCode.InvalidInherentHead, providerSpan),
      move dependencies,
    )
  }
  // IMPL-001: a provider needs one canonical nominal identity, or is a scalar or `string`.
  if !nominal && !foundational {
    return memberRejected(
      run reject(&resolver.*, &module, RejectionCode.InvalidProvider, providerSpan),
      move dependencies,
    )
  }
  let generatedByHeads = Vector.length<Shared<Lifetime>>(&elision.generated)
  let declared = run resolveConstraints(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies,
    key.module,
    &module,
    generics,
    Vector.asSlice<Binder>(&binders),
    &mut elision,
    false,
  )
  let constraints = match move declared {
    Result<Vector<Constraint>, Shared<Rejection>>.Success {value} => move value
    Result<Vector<Constraint>, Shared<Rejection>>.Failure {error} => {
      return memberRejected(move error, move dependencies)
    }
  }
  // A bound's omitted lifetime would add an implementation lifetime no head can determine.
  if Vector.length<Shared<Lifetime>>(&elision.generated) != generatedByHeads {
    return memberRejected(
      run reject(&resolver.*, &module, RejectionCode.Unsupported, span),
      move dependencies,
    )
  }
  let providerLocal = Shared.with<Type, bool>(
    &provider,
    fn(value: &Type) -> bool {
      return declaredIn(value, &module)
    },
  )
  let binderCount = writtenCount + generatedByHeads
  // IMPL-004: an interface conformance belongs to the interface's or the nominal provider's
  // module; a service conformance and a sealed property belong to the provider's module.
  let mut permitted = true
  if let ImplementationKind.Sealed {..} = &kind {
    permitted = providerLocal
  }
  if let Option<Shared<Type>>.Some {value: applied} = &contract {
    let contractLocal = Shared.with<Type, bool>(
      &applied,
      fn(value: &Type) -> bool {
        return declaredIn(value, &module)
      },
    )
    let serviceContract = Shared.with<Type, OwnerKind>(&applied, nominalKind) == OwnerKind.Service
    permitted = providerLocal || (!serviceContract && contractLocal)
  }
  if !permitted {
    return memberRejected(
      run reject(&resolver.*, &module, RejectionCode.ConformanceOwner, span),
      move dependencies,
    )
  }
  // An inherent head belongs to every instantiation of an owner of this module: its arguments are
  // the implementation's own unbounded binders, written ones in declaration order, each once.
  if inherent {
    let family = Shared.with<Type, bool>(
      &provider,
      fn(value: &Type) -> bool {
        return wholeFamily(value, &implementation, writtenCount, binderCount)
      },
    )
    if !providerLocal || !family || Vector.length<Constraint>(&constraints) > usize.ZERO {
      return memberRejected(
        run reject(&resolver.*, &module, RejectionCode.InvalidInherentHead, providerSpan),
        move dependencies,
      )
    }
  }
  let lists = run parametersOf(Vector.asSlice<Binder>(&binders))
  let mut lifetimes = move lists.lifetimes
  let generated = Vector.asSlice<Shared<Lifetime>>(&elision.generated)
  let mut generatedAt = usize.ZERO
  while generatedAt < generated.length {
    run Vector.append<Shared<Lifetime>>(&mut lifetimes, Shared.clone<Lifetime>(&generated[generatedAt]))
    generatedAt = generatedAt + usize.ONE
  }
  let head = ImplementationHead {
    declaration: run Shared.make<DeclarationId>(move implementation),
    kind: move kind,
    binders: Contract {
      typeParameters: move lists.types,
      lifetimeParameters: move lifetimes,
      rowParameters: move lists.rows,
      constraints: move constraints,
      provider: Option.none<Shared<Type>>(),
    },
    contract: move contract,
    provider: move provider,
  }
  return memberSuccess(
    Value.ImplementationHead {head: run Shared.make<ImplementationHead>(move head)},
    move dependencies,
  )
}

fn headOf(answer: &Result<Answer, NoRejection>) -> Option<Shared<ImplementationHead>> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.ImplementationHead {head}} => Option.some<
        Shared<ImplementationHead>,
      >(Shared.clone<ImplementationHead>(&head))
      _ => Option.none<Shared<ImplementationHead>>()
    }
    Result<Answer, NoRejection>.Failure {error: _} => Option.none<Shared<ImplementationHead>>()
  }
}

fn isImplementationHeader(hir: &Module, declaration: &IndexedDeclaration) -> bool {
  return match Module.node(hir, declaration.header) {
    Node.ImplHeader {..} => true
    _ => false
  }
}

// An `impl Contract for Provider` header, as opposed to an inherent `impl Owner`.
fn isConformanceHeader(hir: &Module, declaration: &IndexedDeclaration) -> bool {
  return match Module.node(hir, declaration.header) {
    Node.ImplHeader {target, ..} => target.present
    _ => false
  }
}

fn topLevel(declaration: &IndexedDeclaration) -> bool {
  return match & declaration.parent {
    Option<usize>.Some {..} => false
    Option<usize>.None => true
  }
}

effect fn resolveImplementations(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  key: Key,
) -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let module = run resolvedModule(&resolver.*, key.module)
  let mut dependencies = Vector.make<Dependency>()
  let mut ordinals = Vector.make<usize>()
  let mut nested = Option.none<Span>()
  let answer = run source(&mut resolver.*, &module)
  if let Option<&IndexedSource>.Some {value} = move sourceOf(&resolver.*, &answer, &module) {
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(value))
    let hir = IndexedSource.authored(value)
    let mut at = usize.ZERO
    while at < declarations.length {
      if isConformanceHeader(hir, &declarations[at]) {
        if topLevel(&declarations[at]) {
          run Vector.append<usize>(&mut ordinals, at)
        } else {
          nested = Option.some<Span>(Module.span(hir, declarations[at].header))
        }
      }
      at = at + usize.ONE
    }
  }
  drop answer
  // A module-level conditional group is being removed from the language; until then an `impl`
  // inside one cannot be counted as present or absent.
  if let Option<Span>.Some {value: grouped} = move nested {
    return memberRejected(
      run reject(&resolver.*, &module, RejectionCode.Unsupported, grouped),
      move dependencies,
    )
  }
  let mut heads = Vector.make<Shared<ImplementationHead>>()
  let listed = Vector.asSlice<usize>(&ordinals)
  let mut at = usize.ZERO
  while at < listed.length {
    let headKey = Key {
      family: Family.ImplementationHead,
      module: key.module,
      name: usize.ZERO,
      declaration: listed[at],
      member: usize.ZERO,
      external: false,
    }
    let child = run demandChild(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies,
      headKey,
      Span.make(usize.ZERO, usize.ZERO),
    )
    let head = Shared.with<Result<Answer, NoRejection>, Option<Shared<ImplementationHead>>>(
      &child,
      headOf,
    )
    if let Option<Shared<ImplementationHead>>.Some {value} = move head {
      run Vector.append<Shared<ImplementationHead>>(&mut heads, move value)
    } else {
      let failed = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
        &child,
        answerRejection,
      )
      if let Option<Shared<Rejection>>.Some {value: diagnostic} = move failed {
        return memberRejected(move diagnostic, move dependencies)
      }
    }
    at = at + usize.ONE
  }
  return memberSuccess(Value.Implementations {heads: move heads}, move dependencies)
}

// Whether a head's provider is the nominal `owner`.
fn headProvides(head: &ImplementationHead, owner: &DeclarationId) -> bool {
  return Shared.with<Type, bool>(
    &head.provider,
    fn(provider: &Type) -> bool {
      return match & provider.* {
        Type.Nominal {declaration, ..} => DeclarationId.equals(&declaration, owner)
        _ => false
      }
    },
  )
}

// Whether an owner's own associated items already claim `name`.
fn ownerClaims(answer: &Result<Answer, NoRejection>, name: &[u8]) -> bool {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Members {members}} => {
        let listed = Vector.asSlice<Member>(&members)
        let mut at = usize.ZERO
        while at < listed.length {
          if let Option<Bytes>.Some {value: spelled} = &listed[at].name {
            if same(Bytes.asSlice(&spelled), name) {
              return true
            }
          }
          at = at + usize.ONE
        }
        return false
      }
      Outcome.Success {value: Value.Operations {operations}} => {
        let listed = Vector.asSlice<Shared<DeclarationId>>(&operations)
        let mut at = usize.ZERO
        while at < listed.length {
          if Shared.with<DeclarationId, bool>(
            &listed[at],
            fn(operation: &DeclarationId) -> bool {
              return DeclarationId.named(operation, name)
            },
          ) {
            return true
          }
          at = at + usize.ONE
        }
        return false
      }
      _ => false
    }
    Result<Answer, NoRejection>.Failure {error: _} => false
  }
}

// One written member of an inherent `impl`, with whether it can be an associated member at all.
struct InherentCandidate {
  ordinal: usize
  name: Bytes
  span: Span
  admissible: bool
}

effect fn inherentCandidates(resolver: &mut Resolver, module: &ModuleId, implementation: usize) -> Vector<
  InherentCandidate,
> ! Cycle | OutOfMemoryError ? &mut Allocator {
  let mut candidates = Vector.make<InherentCandidate>()
  let answer = run source(&mut resolver.*, module)
  if let Option<&IndexedSource>.Some {value} = move sourceOf(&resolver.*, &answer, module) {
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(value))
    let hir = IndexedSource.authored(value)
    let mut at = usize.ZERO
    while at < declarations.length {
      if enclosedBy(&declarations[at], implementation) {
        let written = Module.node(hir, declarations[at].header)
        let mut name = HirRef.absent()
        // A mapping only makes sense in a conformance, and a Drop hook belongs to `impl Drop`.
        let mut admissible = false
        if let Node.FunctionHeader {name: spelled, ..} = written {
          name = HirRef.of(spelled)
          admissible = true
        }
        if let Node.ImplAliasHeader {name: spelled, ..} = written {
          name = HirRef.of(spelled)
        }
        if name.present {
          if let Node.Name {text} = Module.node(hir, name.id) {
            let spelling = Module.text(hir, text)
            if same(spelling, b"drop") {
              admissible = false
            }
            run Vector.append<InherentCandidate>(
              &mut candidates,
              InherentCandidate {
                ordinal: at,
                name: run Bytes.copy(spelling),
                span: Module.span(hir, declarations[at].header),
                admissible: admissible,
              },
            )
          }
        }
      }
      at = at + usize.ONE
    }
  }
  return move candidates
}

effect fn rejectRelated(
  module: &ModuleId,
  span: Span,
  related: Option<DeclarationId>,
) -> Shared<Rejection> ! OutOfMemoryError ? &mut Allocator {
  let mut path = Vector.make<Shared<DeclarationId>>()
  if let Option<DeclarationId>.Some {value} = move related {
    run Vector.append<Shared<DeclarationId>>(&mut path, run Shared.make<DeclarationId>(move value))
  }
  return run Shared.make<Rejection>(
    Rejection {
      code: RejectionCode.Collision,
      module: run ModuleId.copy(module),
      span: span,
      path: move path,
      expected: usize.ZERO,
      supplied: usize.ZERO,
      parameterName: Bytes.make(),
      expectedKind: GenericKind.Type,
      suppliedKind: GenericKind.Type,
    },
  )
}

effect fn resolveInherentMembers(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  key: Key,
) -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let module = run resolvedModule(&resolver.*, key.module)
  let mut dependencies = Vector.make<Dependency>()
  let written = run header(&mut resolver.*, &module, key.declaration)
  let found = run declarationAt(&mut resolver.*, &module, key.declaration)
  let mut claimedBy = Family.Members
  let mut span = Span.make(usize.ZERO, usize.ZERO)
  let mut generatedValue = false
  let mut isOwner = false
  if let Option<HeaderSyntax>.Some {value} = move written {
    span = value.span
    isOwner = match value.header {
      Node.StructHeader {..} => true
      Node.TupleHeader {..} => true
      Node.UnionHeader {..} => true
      Node.EnumHeader {..} => true
      Node.ServiceHeader {..} => true
      Node.InterfaceHeader {..} => true
      _ => false
    }
    if isContractHeader(value.header) {
      claimedBy = Family.Operations
    }
    if let Node.EnumHeader {..} = value.header {
      generatedValue = true
    }
  }
  let ownerId = match move found {
    Option<DeclarationId>.Some {value} => move value
    Option<DeclarationId>.None => {
      return memberRejected(
        run reject(&resolver.*, &module, RejectionCode.Unsupported, span),
        move dependencies,
      )
    }
  }
  if !isOwner {
    return memberRejected(
      run reject(&resolver.*, &module, RejectionCode.NotType, span),
      move dependencies,
    )
  }
  let claimsKey = Key {
    family: claimedBy,
    module: key.module,
    name: usize.ZERO,
    declaration: key.declaration,
    member: usize.ZERO,
    external: false,
  }
  let claims = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies, claimsKey, span)
  if Shared.with<Result<Answer, NoRejection>, bool>(&claims, hasRejection) {
    let failed = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
      &claims,
      answerRejection,
    )
    if let Option<Shared<Rejection>>.Some {value: diagnostic} = move failed {
      return memberRejected(move diagnostic, move dependencies)
    }
  }
  // Only this module can declare the owner's inherent members; a rejected head publishes none.
  let mut implementations = Vector.make<usize>()
  let answer = run source(&mut resolver.*, &module)
  if let Option<&IndexedSource>.Some {value} = move sourceOf(&resolver.*, &answer, &module) {
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(value))
    let hir = IndexedSource.authored(value)
    let mut at = usize.ZERO
    while at < declarations.length {
      if isImplementationHeader(hir, &declarations[at]) && !isConformanceHeader(hir, &declarations[at]) && topLevel(
        &declarations[at],
      ) {
        run Vector.append<usize>(&mut implementations, at)
      }
      at = at + usize.ONE
    }
  }
  drop answer
  let mut candidates = Vector.make<InherentCandidate>()
  let listed = Vector.asSlice<usize>(&implementations)
  let mut at = usize.ZERO
  while at < listed.length {
    let headKey = Key {
      family: Family.ImplementationHead,
      module: key.module,
      name: usize.ZERO,
      declaration: listed[at],
      member: usize.ZERO,
      external: false,
    }
    let child = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies, headKey, span)
    let head = Shared.with<Result<Answer, NoRejection>, Option<Shared<ImplementationHead>>>(
      &child,
      headOf,
    )
    if let Option<Shared<ImplementationHead>>.Some {value} = move head {
      let owned = Shared.with<ImplementationHead, bool>(
        &value,
        fn(implementation: &ImplementationHead) -> bool {
          return headProvides(implementation, &ownerId)
        },
      )
      if owned {
        let written = run inherentCandidates(&mut resolver.*, &module, listed[at])
        let entries = Vector.asSlice<InherentCandidate>(&written)
        let mut entryAt = usize.ZERO
        while entryAt < entries.length {
          run Vector.append<InherentCandidate>(
            &mut candidates,
            InherentCandidate {
              ordinal: entries[entryAt].ordinal,
              name: run Bytes.copy(Bytes.asSlice(&entries[entryAt].name)),
              span: entries[entryAt].span,
              admissible: entries[entryAt].admissible,
            },
          )
          entryAt = entryAt + usize.ONE
        }
      }
    }
    at = at + usize.ONE
  }
  let mut members = Vector.make<Shared<DeclarationId>>()
  let mut rejected = Vector.make<RejectedMember>()
  let all = Vector.asSlice<InherentCandidate>(&candidates)
  let mut candidateAt = usize.ZERO
  while candidateAt < all.length {
    let name = Bytes.asSlice(&all[candidateAt].name)
    let claimed = Shared.with<Result<Answer, NoRejection>, bool>(
      &claims,
      fn(value: &Result<Answer, NoRejection>) -> bool {
        return ownerClaims(value, name)
      },
    ) || (generatedValue && same(name, b"value"))
    let mut other = usize.MAX
    let mut otherAt = usize.ZERO
    while otherAt < all.length {
      if otherAt != candidateAt && same(Bytes.asSlice(&all[otherAt].name), name) {
        other = all[otherAt].ordinal
      }
      otherAt = otherAt + usize.ONE
    }
    let identity = run declarationAt(&mut resolver.*, &module, all[candidateAt].ordinal)
    if let Option<DeclarationId>.Some {value: declared} = move identity {
      let member = run Shared.make<DeclarationId>(move declared)
      if !all[candidateAt].admissible || claimed {
        run Vector.append<RejectedMember>(
          &mut rejected,
          RejectedMember {
            declaration: move member,
            rejection: run reject(
              &resolver.*,
              &module,
              RejectionCode.InvalidInherentMember,
              all[candidateAt].span,
            ),
          },
        )
      } else if other != usize.MAX {
        let related = run declarationAt(&mut resolver.*, &module, other)
        run Vector.append<RejectedMember>(
          &mut rejected,
          RejectedMember {
            declaration: move member,
            rejection: run rejectRelated(&module, all[candidateAt].span, move related),
          },
        )
      } else {
        run Vector.append<Shared<DeclarationId>>(&mut members, move member)
      }
    }
    candidateAt = candidateAt + usize.ONE
  }
  return memberSuccess(
    Value.InherentMembers {members: move members, rejected: move rejected},
    move dependencies,
  )
}

struct BinderLists {
  types: Vector<Shared<Type>>
  lifetimes: Vector<Shared<Lifetime>>
  rows: Vector<RowParameter>
}

effect fn parametersOf(binders: &[Binder]) -> BinderLists ! OutOfMemoryError ? &mut Allocator {
  let mut lists = BinderLists {
    types: Vector.make<Shared<Type>>(),
    lifetimes: Vector.make<Shared<Lifetime>>(),
    rows: Vector.make<RowParameter>(),
  }
  let mut at = usize.ZERO
  while at < binders.length {
    if let Binder.Type {value, ..} = &binders[at] {
      run Vector.append<Shared<Type>>(&mut lists.types, Shared.clone<Type>(&value))
    }
    if let Binder.Lifetime {value, ..} = &binders[at] {
      run Vector.append<Shared<Lifetime>>(&mut lists.lifetimes, Shared.clone<Lifetime>(&value))
    }
    if let Binder.Row {value, ..} = &binders[at] {
      run Vector.append<RowParameter>(
        &mut lists.rows,
        RowParameter {
          declaration: Shared.clone<DeclarationId>(&value.declaration),
          ordinal: value.ordinal,
        },
      )
    }
    at = at + usize.ONE
  }
  return move lists
}

// Whether a written result is the builtin `Effect`, as resolved by `resolveType`.
effect fn effectResult(resolver: &mut Resolver, module: &ModuleId, id: HirId, binders: &[Binder]) -> bool
! Cycle | OutOfMemoryError
? &mut Allocator {
  let written = run typeNode(&mut resolver.*, module, id)
  if let Option<HeaderSyntax>.Some {value} = move written {
    let mut target = value.header
    if let Node.AppliedType {target: applied, ..} = value.header {
      let named = run typeNode(&mut resolver.*, module, applied)
      if let Option<HeaderSyntax>.Some {value: found} = move named {
        target = found.header
      }
    }
    if let Node.NamedType {path: typeName, ..} = target {
      let parsed = run path(&mut resolver.*, module, typeName)
      let segments = Vector.asSlice<Bytes>(&parsed.segments)
      return parsed.valid && segments.length == usize.ONE && same(
        Bytes.asSlice(&segments[usize.ZERO]),
        b"Effect",
      ) && !hasBinder(binders, b"Effect")
    }
  }
  return false
}

// The declaration's representation contracts, indexed by the bound parameter's binder ordinal.
effect fn representationsOf(owner: &DeclarationId, binderCount: usize, constraints: &[Constraint]) -> Vector<
  Option<Shared<Type>>,
> ! OutOfMemoryError ? &mut Allocator {
  let mut table = Vector.make<Option<Shared<Type>>>()
  let mut at = usize.ZERO
  while at < binderCount {
    run Vector.append<Option<Shared<Type>>>(&mut table, Option.none<Shared<Type>>())
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < constraints.length {
    if let Constraint.Represents {parameter, contract} = &constraints[at] {
      let ordinal = Shared.with<Type, usize>(
        &parameter,
        fn(node: &Type) -> usize {
          return Type.parameterOrdinalOf(node, owner)
        },
      )
      if ordinal < binderCount {
        Vector.set<Option<Shared<Type>>>(
          &mut table,
          ordinal,
          Option.some<Shared<Type>>(Shared.clone<Type>(&contract)),
        )
      }
    }
    at = at + usize.ONE
  }
  return move table
}

effect fn resolveSignature(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  key: Key,
) -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let module = run resolvedModule(&resolver.*, key.module)
  let written = run signatureSyntax(&mut resolver.*, &module, key.declaration)
  let mut dependencies = Vector.make<Dependency>()
  if let Option<WrittenSignature>.Some {value} = move written {
    if !value.supported {
      let diagnostic = run reject(&resolver.*, &module, RejectionCode.Unsupported, value.span)
      return Answer {
        outcome: Outcome.Rejected {diagnostic: move diagnostic},
        dependencies: move dependencies,
        sources: Vector.make<Shared<Observation>>(),
        footprint: Vector.make<Shared<DemandFootprint>>(),
        answerId: usize.ZERO,
        identity: Option.none<Shared<Value>>(),
        bodyEvidence: Option.none<Shared<BodyEvidence>>(),
      }
    }
    let template = run templateBinders(&mut resolver.*, &module, key.declaration)
    let mut binders = match move template {
      Result<Vector<Binder>, Shared<Rejection>>.Success {value: found} => move found
      Result<Vector<Binder>, Shared<Rejection>>.Failure {error} => {
        return Answer {
          outcome: Outcome.Rejected {diagnostic: move error},
          dependencies: move dependencies,
          sources: Vector.make<Shared<Observation>>(),
          footprint: Vector.make<Shared<DemandFootprint>>(),
          answerId: usize.ZERO,
          identity: Option.none<Shared<Value>>(),
          bodyEvidence: Option.none<Shared<BodyEvidence>>(),
        }
      }
    }
    let identified = run declarationAt(&mut resolver.*, &module, key.declaration)
    let signatureOwner = match move identified {
      Option<DeclarationId>.Some {value: found} => move found
      Option<DeclarationId>.None => {
        return memberRejected(
          run reject(&resolver.*, &module, RejectionCode.Unsupported, value.span),
          move dependencies,
        )
      }
    }
    // The signature's own binders come first, one-to-one with its written generic list; the
    // enclosing contract's binders and `Self` follow and keep their own declaration identities.
    let ownCount = Vector.length<Binder>(&binders)
    let scope = run enclosingScope(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies,
      key.module,
      &module,
      key.declaration,
    )
    let enclosing = match move scope {
      Result<Vector<Binder>, Shared<Rejection>>.Success {value: found} => move found
      Result<Vector<Binder>, Shared<Rejection>>.Failure {error} => {
        return memberRejected(move error, move dependencies)
      }
    }
    let visible = Vector.asSlice<Binder>(&enclosing)
    // An inherent member may restate an owner binder to add bounds for that member alone; the
    // restated binder keeps the owner's identity. Elsewhere a restated spelling stays unsupported.
    let refines = run refinesEnclosing(&mut resolver.*, &module, key.declaration)
    let none = Vector.make<Binder>()
    let mut restatable = visible
    if refines {
      restatable = Vector.asSlice<Binder>(&none)
    }
    let conflict = run scopedBinderRejection(
      &mut resolver.*,
      &module,
      value.generics,
      restatable,
      hasBinder(visible, b"Self"),
    )
    if let Option<Shared<Rejection>>.Some {value: diagnostic} = move conflict {
      return memberRejected(move diagnostic, move dependencies)
    }
    let mut own = Vector.make<Binder>()
    let mut ownAt = usize.ZERO
    while ownAt < ownCount {
      let restated = run restatedBinder(&binders, ownAt, visible, refines)
      if let Option<Binder>.Some {value: binder} = move restated {
        Vector.set<Binder>(&mut binders, ownAt, move binder)
      } else {
        run Vector.append<Binder>(&mut own, run binderAt(&binders, ownAt))
      }
      ownAt = ownAt + usize.ONE
    }
    let lists = run parametersOf(Vector.asSlice<Binder>(&own))
    let mut visibleAt = usize.ZERO
    while visibleAt < visible.length {
      run Vector.append<Binder>(&mut binders, run copyBinder(&visible[visibleAt]))
      visibleAt = visibleAt + usize.ONE
    }
    let mut lifetimeParameters = move lists.lifetimes
    let mut elision = LifetimeElision {
      owner: Option.some<DeclarationId>(run DeclarationId.copy(&signatureOwner)),
      nextOrdinal: ownCount,
      output: false,
      resultDefault: Option.none<Shared<Lifetime>>(),
      generated: Vector.make<Shared<Lifetime>>(),
      invocation: false,
      nested: false,
      renumber: Vector.make<usize>(),
      staticEnvironment: false,
    }
    let declared = run resolveConstraints(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies,
      key.module,
      &module,
      value.generics,
      Vector.asSlice<Binder>(&binders),
      &mut elision,
      value.isPublic,
    )
    let constraints = match move declared {
      Result<Vector<Constraint>, Shared<Rejection>>.Success {value: found} => move found
      Result<Vector<Constraint>, Shared<Rejection>>.Failure {error} => {
        return memberRejected(move error, move dependencies)
      }
    }
    let representations = run representationsOf(
      &signatureOwner,
      ownCount,
      Vector.asSlice<Constraint>(&constraints),
    )
    let mut environment = Option.none<Intersection>()
    if value.environment.present {
      let written = run writtenEnvironment(
        &mut resolver.*,
        &module,
        value.environment.range,
        value.span,
        Vector.asSlice<Binder>(&binders),
      )
      match move written {
        Result<Intersection, Shared<Rejection>>.Success {value: region} => {
          environment = Option.some<Intersection>(move region)
        }
        Result<Intersection, Shared<Rejection>>.Failure {error} => {
          return memberRejected(move error, move dependencies)
        }
      }
    }
    let mut parameters = Vector.make<Shared<Type>>()
    let mut inputCount = usize.ZERO
    let mut inputLifetime = Option.none<Shared<Lifetime>>()
    // The regions every input would retain if captured, and the first input whose stored contents
    // are unknown because they involve a type parameter without a representation contract.
    let mut retained = Vector.make<Shared<Lifetime>>()
    let mut hasUnknown = false
    let mut unknownSpan = Span.make(usize.ZERO, usize.ZERO)
    let entries = Vector.asSlice<HirId>(&value.parameters)
    let mut at = usize.ZERO
    while at < entries.length {
      let resolved = run resolveType(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies,
        key.module,
        entries[at],
        Vector.asSlice<Binder>(&binders),
        &mut elision,
      )
      match move resolved {
        Result<Shared<Type>, Shared<Rejection>>.Success {value: ty} => {
          let existential = run existentialRejection(&mut resolver.*, &module, entries[at], &ty)
          if let Option<Shared<Rejection>>.Some {value: diagnostic} = move existential {
            return memberRejected(move diagnostic, move dependencies)
          }
          let exposure = run exposedPrivate(
            &mut resolver.*,
            &module,
            entries[at],
            &ty,
            value.isPublic,
          )
          if let Option<Shared<Rejection>>.Some {value: diagnostic} = move exposure {
            return Answer {
              outcome: Outcome.Rejected {diagnostic: move diagnostic},
              dependencies: move dependencies,
              sources: Vector.make<Shared<Observation>>(),
              footprint: Vector.make<Shared<DemandFootprint>>(),
              answerId: usize.ZERO,
              identity: Option.none<Shared<Value>>(),
              bodyEvidence: Option.none<Shared<BodyEvidence>>(),
            }
          }
          let outer = Shared.with<Type, Option<Shared<Lifetime>>>(&ty, outerLifetime)
          if let Option<Shared<Lifetime>>.Some {value: lifetime} = move outer {
            inputCount = inputCount + usize.ONE
            inputLifetime = Option.some<Shared<Lifetime>>(move lifetime)
          }
          let known = run Type.retainedRegions(
            &ty,
            &signatureOwner,
            Vector.asSlice<Option<Shared<Type>>>(&representations),
            &mut retained,
          )
          if !known && !hasUnknown {
            hasUnknown = true
            let written = run typeNode(&mut resolver.*, &module, entries[at])
            if let Option<HeaderSyntax>.Some {value: parameterSyntax} = move written {
              unknownSpan = parameterSyntax.span
            }
          }
          run Vector.append<Shared<Type>>(&mut parameters, move ty)
        }
        Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
          return Answer {
            outcome: Outcome.Rejected {diagnostic: move error},
            dependencies: move dependencies,
            sources: Vector.make<Shared<Observation>>(),
            footprint: Vector.make<Shared<DemandFootprint>>(),
            answerId: usize.ZERO,
            identity: Option.none<Shared<Value>>(),
            bodyEvidence: Option.none<Shared<BodyEvidence>>(),
          }
        }
      }
      at = at + usize.ONE
    }
    let mut result = run Shared.make<Type>(Type.Unit)
    elision.output = true
    // An `effect fn` captures every input, so its omitted environment is the intersection of the
    // regions its inputs retain: borrows, nominal lifetime arguments, and callable or Effect
    // environments, including a representation parameter's contract environment; `'static` when
    // they retain none. A callable's or Effect's channels are not stored, but stored contents
    // involving any other type parameter have no nameable region, so the environment must be
    // written.
    if value.isEffect && !value.environment.present {
      if hasUnknown {
        return memberRejected(
          run reject(&resolver.*, &module, RejectionCode.AmbiguousLifetime, unknownSpan),
          move dependencies,
        )
      }
      environment = Option.some<Intersection>(
        run Intersection.of(Vector.asSlice<Shared<Lifetime>>(&retained)),
      )
    }
    if inputCount == usize.ONE {
      elision.resultDefault = move inputLifetime
    }
    // Inputs that retain nothing give an ordinary function's omitted `Effect` result environment
    // nothing to retain. An `effect fn` success type gets no such default. Otherwise the
    // established elision applies.
    let closed = !value.isEffect && !hasUnknown && Vector.length<Shared<Lifetime>>(&retained) == usize.ZERO
    if let Option<HirId>.Some {value: id} = move value.result {
      if closed {
        elision.staticEnvironment = run effectResult(
          &mut resolver.*,
          &module,
          id,
          Vector.asSlice<Binder>(&binders),
        )
      }
      let resolved = run resolveType(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies,
        key.module,
        id,
        Vector.asSlice<Binder>(&binders),
        &mut elision,
      )
      match move resolved {
        Result<Shared<Type>, Shared<Rejection>>.Success {value: ty} => {
          let existential = run existentialRejection(&mut resolver.*, &module, id, &ty)
          if let Option<Shared<Rejection>>.Some {value: diagnostic} = move existential {
            return memberRejected(move diagnostic, move dependencies)
          }
          let exposure = run exposedPrivate(&mut resolver.*, &module, id, &ty, value.isPublic)
          if let Option<Shared<Rejection>>.Some {value: diagnostic} = move exposure {
            return Answer {
              outcome: Outcome.Rejected {diagnostic: move diagnostic},
              dependencies: move dependencies,
              sources: Vector.make<Shared<Observation>>(),
              footprint: Vector.make<Shared<DemandFootprint>>(),
              answerId: usize.ZERO,
              identity: Option.none<Shared<Value>>(),
              bodyEvidence: Option.none<Shared<BodyEvidence>>(),
            }
          }
          result = move ty
        }
        Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
          return Answer {
            outcome: Outcome.Rejected {diagnostic: move error},
            dependencies: move dependencies,
            sources: Vector.make<Shared<Observation>>(),
            footprint: Vector.make<Shared<DemandFootprint>>(),
            answerId: usize.ZERO,
            identity: Option.none<Shared<Value>>(),
            bodyEvidence: Option.none<Shared<BodyEvidence>>(),
          }
        }
      }
    }
    if value.failures.present && !value.isEffect {
      let syntax = run typeNode(&mut resolver.*, &module, value.failures.id)
      if let Option<HeaderSyntax>.Some {value: channel} = move syntax {
        return memberRejected(
          run reject(&resolver.*, &module, RejectionCode.EffectChannelOnOrdinary, channel.span),
          move dependencies,
        )
      }
    }
    if value.requirements.present && !value.isEffect {
      let syntax = run typeNode(&mut resolver.*, &module, value.requirements.id)
      if let Option<HeaderSyntax>.Some {value: channel} = move syntax {
        return memberRejected(
          run reject(&resolver.*, &module, RejectionCode.EffectChannelOnOrdinary, channel.span),
          move dependencies,
        )
      }
    }
    let resolvedChannels = run resolveChannels(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies,
      key.module,
      &module,
      value.failures,
      value.requirements,
      Vector.asSlice<Binder>(&binders),
      &mut elision,
    )
    let channels = match move resolvedChannels {
      Result<Channels, Shared<Rejection>>.Success {value: found} => move found
      Result<Channels, Shared<Rejection>>.Failure {error} => {
        return memberRejected(move error, move dependencies)
      }
    }
    if value.failures.present {
      let exposure = run exposedPrivate(
        &mut resolver.*,
        &module,
        value.failures.id,
        &channels.failure,
        value.isPublic,
      )
      if let Option<Shared<Rejection>>.Some {value: diagnostic} = move exposure {
        return memberRejected(move diagnostic, move dependencies)
      }
    }
    if value.isPublic && Shared.with<Row, bool>(&channels.requirements, privateRow) {
      let syntax = run typeNode(&mut resolver.*, &module, value.requirements.id)
      if let Option<HeaderSyntax>.Some {value: channel} = move syntax {
        return memberRejected(
          run reject(&resolver.*, &module, RejectionCode.PrivateTypeExposure, channel.span),
          move dependencies,
        )
      }
    }
    let generated = Vector.asSlice<Shared<Lifetime>>(&elision.generated)
    let mut generatedAt = usize.ZERO
    while generatedAt < generated.length {
      run Vector.append<Shared<Lifetime>>(
        &mut lifetimeParameters,
        Shared.clone<Lifetime>(&generated[generatedAt]),
      )
      generatedAt = generatedAt + usize.ONE
    }
    // An inherent member's contract lists the owner binders it mentions, every one when it names
    // `Self`, in declaration order, before the member's own binders.
    let mut typeParameters = Vector.make<Shared<Type>>()
    let mut allLifetimes = Vector.make<Shared<Lifetime>>()
    let mut rowParameters = Vector.make<RowParameter>()
    if refines {
      let enclosingOwner = run enclosingIdentity(&mut resolver.*, &module, key.declaration)
      if let Option<DeclarationId>.Some {value: implementation} = move enclosingOwner {
        let mut types = Vector.make<usize>()
        let mut regions = Vector.make<usize>()
        let mut rows = Vector.make<usize>()
        let written = Vector.asSlice<Shared<Type>>(&parameters)
        let mut writtenAt = usize.ZERO
        while writtenAt < written.length {
          run Type.collectOwned(&written[writtenAt], &implementation, &mut types, &mut regions, &mut rows)
          writtenAt = writtenAt + usize.ONE
        }
        run Type.collectOwned(&result, &implementation, &mut types, &mut regions, &mut rows)
        run Type.collectOwned(&channels.failure, &implementation, &mut types, &mut regions, &mut rows)
        run Type.collectOwnedRow(
          &channels.requirements,
          &implementation,
          &mut types,
          &mut regions,
          &mut rows,
        )
        let declared = Vector.asSlice<Constraint>(&constraints)
        let mut declaredAt = usize.ZERO
        while declaredAt < declared.length {
          run collectConstraint(&declared[declaredAt], &implementation, &mut types, &mut regions, &mut rows)
          declaredAt = declaredAt + usize.ONE
        }
        let sharedOwner = run Shared.make<DeclarationId>(run DeclarationId.copy(&implementation))
        let sortedTypes = run sortedOrdinals(&types)
        let typeOrdinals = Vector.asSlice<usize>(&sortedTypes)
        let mut ordinalAt = usize.ZERO
        while ordinalAt < typeOrdinals.length {
          run Vector.append<Shared<Type>>(
            &mut typeParameters,
            run Shared.make<Type>(
              Type.Parameter {
                declaration: run DeclarationId.copy(&implementation),
                ordinal: typeOrdinals[ordinalAt],
              },
            ),
          )
          ordinalAt = ordinalAt + usize.ONE
        }
        let sortedRegions = run sortedOrdinals(&regions)
        let regionOrdinals = Vector.asSlice<usize>(&sortedRegions)
        ordinalAt = usize.ZERO
        while ordinalAt < regionOrdinals.length {
          run Vector.append<Shared<Lifetime>>(
            &mut allLifetimes,
            run Shared.make<Lifetime>(
              Lifetime.Parameter {
                declaration: run DeclarationId.copy(&implementation),
                ordinal: regionOrdinals[ordinalAt],
              },
            ),
          )
          ordinalAt = ordinalAt + usize.ONE
        }
        let sortedRows = run sortedOrdinals(&rows)
        let rowOrdinals = Vector.asSlice<usize>(&sortedRows)
        ordinalAt = usize.ZERO
        while ordinalAt < rowOrdinals.length {
          run Vector.append<RowParameter>(
            &mut rowParameters,
            RowParameter {
              declaration: Shared.clone<DeclarationId>(&sharedOwner),
              ordinal: rowOrdinals[ordinalAt],
            },
          )
          ordinalAt = ordinalAt + usize.ONE
        }
      }
    }
    let ownTypes = Vector.asSlice<Shared<Type>>(&lists.types)
    let mut listedAt = usize.ZERO
    while listedAt < ownTypes.length {
      run Vector.append<Shared<Type>>(&mut typeParameters, Shared.clone<Type>(&ownTypes[listedAt]))
      listedAt = listedAt + usize.ONE
    }
    let ownLifetimes = Vector.asSlice<Shared<Lifetime>>(&lifetimeParameters)
    listedAt = usize.ZERO
    while listedAt < ownLifetimes.length {
      run Vector.append<Shared<Lifetime>>(&mut allLifetimes, Shared.clone<Lifetime>(&ownLifetimes[listedAt]))
      listedAt = listedAt + usize.ONE
    }
    let ownRows = Vector.asSlice<RowParameter>(&lists.rows)
    listedAt = usize.ZERO
    while listedAt < ownRows.length {
      run Vector.append<RowParameter>(
        &mut rowParameters,
        RowParameter {
          declaration: Shared.clone<DeclarationId>(&ownRows[listedAt].declaration),
          ordinal: ownRows[listedAt].ordinal,
        },
      )
      listedAt = listedAt + usize.ONE
    }
    return Answer {
      outcome: Outcome.Success {
        value: Value.Signature {
          signature: Signature {
            typeParameters: move typeParameters,
            lifetimeParameters: move allLifetimes,
            rowParameters: move rowParameters,
            constraints: move constraints,
            parameters: move parameters,
            result: move result,
            failure: move channels.failure,
            requirements: move channels.requirements,
            isEffect: value.isEffect,
            isUnsafe: value.isUnsafe,
            environment: move environment,
          },
        },
      },
      dependencies: move dependencies,
      sources: Vector.make<Shared<Observation>>(),
      footprint: Vector.make<Shared<DemandFootprint>>(),
      answerId: usize.ZERO,
      identity: Option.none<Shared<Value>>(),
      bodyEvidence: Option.none<Shared<BodyEvidence>>(),
    }
  }
  let diagnostic = run reject(
    &resolver.*,
    &module,
    RejectionCode.Unsupported,
    Span.make(usize.ZERO, usize.ZERO),
  )
  return Answer {
    outcome: Outcome.Rejected {diagnostic: move diagnostic},
    dependencies: move dependencies,
    sources: Vector.make<Shared<Observation>>(),
    footprint: Vector.make<Shared<DemandFootprint>>(),
    answerId: usize.ZERO,
    identity: Option.none<Shared<Value>>(),
    bodyEvidence: Option.none<Shared<BodyEvidence>>(),
  }
}

fn signatureResult(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Signature {signature}} => Option.some<Shared<Type>>(
        Shared.clone<Type>(&signature.result),
      )
      _ => Option.none<Shared<Type>>()
    }
    Result<Answer, NoRejection>.Failure {error: _} => Option.none<Shared<Type>>()
  }
}

fn signatureParameterCount(answer: &Result<Answer, NoRejection>) -> usize {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Signature {signature}} => Vector.length<Shared<Type>>(
        &signature.parameters,
      )
      _ => usize.ZERO
    }
    Result<Answer, NoRejection>.Failure {error: _} => usize.ZERO
  }
}

// Type and row binders make a generic contract; lifetime-only binders do not.
fn signatureGenericCount(answer: &Result<Answer, NoRejection>) -> usize {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Signature {signature}} => Vector.length<Shared<Type>>(
        &signature.typeParameters,
      ) + Vector.length<RowParameter>(&signature.rowParameters)
      _ => usize.ZERO
    }
    Result<Answer, NoRejection>.Failure {error: _} => usize.ZERO
  }
}

fn signatureParameter(answer: &Result<Answer, NoRejection>, at: usize) -> Option<Shared<Type>> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Signature {signature}} => {
        let parameters = Vector.asSlice<Shared<Type>>(&signature.parameters)
        if at < parameters.length {
          return Option.some<Shared<Type>>(Shared.clone<Type>(&parameters[at]))
        }
        return Option.none<Shared<Type>>()
      }
      _ => Option.none<Shared<Type>>()
    }
    Result<Answer, NoRejection>.Failure {error: _} => Option.none<Shared<Type>>()
  }
}

// Effect construction and unsafe acknowledgement are outside the scalar body subset.
fn signatureOutsideScalarBodies(answer: &Result<Answer, NoRejection>) -> bool {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Signature {signature}} => signature.isEffect || signature.isUnsafe
      _ => false
    }
    Result<Answer, NoRejection>.Failure {error: _} => false
  }
}

fn answerRejection(answer: &Result<Answer, NoRejection>) -> Option<Shared<Rejection>> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Rejected {diagnostic} => Option.some<Shared<Rejection>>(
        Shared.clone<Rejection>(&diagnostic),
      )
      _ => Option.none<Shared<Rejection>>()
    }
    Result<Answer, NoRejection>.Failure {error: _} => Option.none<Shared<Rejection>>()
  }
}

fn fixedIntegerName(name: &[u8]) -> bool {
  return same(name, b"i8") || same(name, b"i16") || same(name, b"i32") || same(name, b"i64") || same(
    name,
    b"u8",
  ) || same(name, b"u16") || same(name, b"u32") || same(name, b"u64")
}

fn scalarType(typeValue: &Type) -> bool {
  return match & typeValue.* {
    Type.Unit => true
    Type.Primitive {name} => same(Bytes.asSlice(&name), b"bool") || fixedIntegerName(
      Bytes.asSlice(&name),
    )
    _ => false
  }
}

fn fixedIntegerType(typeValue: &Type) -> bool {
  return match & typeValue.* {
    Type.Primitive {name} => fixedIntegerName(Bytes.asSlice(&name))
    _ => false
  }
}

fn sameSharedType(left: &Shared<Type>, right: &Shared<Type>) -> bool {
  return Shared.with<Type, usize>(left, scalarCode) == Shared.with<Type, usize>(right, scalarCode)
}

fn scalarCode(typeValue: &Type) -> usize {
  return match & typeValue.* {
    Type.Unit => 1
    Type.Primitive {name} => {
      let spelling = Bytes.asSlice(&name)
      if same(spelling, b"bool") {
        return 2
      }
      if same(spelling, b"i8") {
        return 3
      }
      if same(spelling, b"i16") {
        return 4
      }
      if same(spelling, b"i32") {
        return 5
      }
      if same(spelling, b"i64") {
        return 6
      }
      if same(spelling, b"u8") {
        return 7
      }
      if same(spelling, b"u16") {
        return 8
      }
      if same(spelling, b"u32") {
        return 9
      }
      if same(spelling, b"u64") {
        return 10
      }
      return usize.ZERO
    }
    _ => usize.ZERO
  }
}

fn fitsMagnitude(magnitude: &[u8], maximum: &[u8]) -> bool {
  if magnitude.length != maximum.length {
    return magnitude.length < maximum.length
  }
  let mut at = usize.ZERO
  while at < magnitude.length {
    if magnitude[at] != maximum[at] {
      return magnitude[at] < maximum[at]
    }
    at = at + usize.ONE
  }
  return true
}

fn fitsInteger(name: &[u8], sign: Sign, magnitude: &[u8]) -> bool {
  if sign == Sign.Negative && magnitude.length == 1 && magnitude[0] == 48 {
    return true
  }
  if same(name, b"i8") {
    if sign == Sign.Negative {
      return fitsMagnitude(magnitude, b"128")
    }
    return fitsMagnitude(magnitude, b"127")
  }
  if same(name, b"i16") {
    if sign == Sign.Negative {
      return fitsMagnitude(magnitude, b"32768")
    }
    return fitsMagnitude(magnitude, b"32767")
  }
  if same(name, b"i32") {
    if sign == Sign.Negative {
      return fitsMagnitude(magnitude, b"2147483648")
    }
    return fitsMagnitude(magnitude, b"2147483647")
  }
  if same(name, b"i64") {
    if sign == Sign.Negative {
      return fitsMagnitude(magnitude, b"9223372036854775808")
    }
    return fitsMagnitude(magnitude, b"9223372036854775807")
  }
  if sign == Sign.Negative {
    return false
  }
  if same(name, b"u8") {
    return fitsMagnitude(magnitude, b"255")
  }
  if same(name, b"u16") {
    return fitsMagnitude(magnitude, b"65535")
  }
  if same(name, b"u32") {
    return fitsMagnitude(magnitude, b"4294967295")
  }
  if same(name, b"u64") {
    return fitsMagnitude(magnitude, b"18446744073709551615")
  }
  return false
}

effect fn primitiveType(name: &[u8]) -> Shared<Type> ! OutOfMemoryError ? &mut Allocator {
  return run Shared.make<Type>(Type.Primitive {name: run Bytes.copy(name)})
}

effect fn bodyRejection(resolver: &Resolver, module: &ModuleId, code: RejectionCode, span: Span) -> Result<
  BodyNodeId,
  Shared<Rejection>,
> ! OutOfMemoryError ? &mut Allocator {
  return Result.failResult<BodyNodeId, Shared<Rejection>>(run reject(resolver, module, code, span))
}

effect fn collectCall(hir: &Module, expression: HirId, calls: &mut Vector<CallSyntax>) -> ()
! OutOfMemoryError
? &mut Allocator {
  if let Node.IdentifierExpression {name, binding} = Module.node(hir, expression) {
    if !binding.present {
      if let Node.Name {text} = Module.node(hir, name) {
        run Vector.append<CallSyntax>(
          &mut calls.*,
          CallSyntax {
            id: expression,
            span: Module.span(hir, name),
            reference: CallReference.Unbound {name: run Bytes.copy(Module.text(hir, text))},
          },
        )
      }
    }
    return ()
  }
  if let Node.CallExpression {callee, generics, arguments} = Module.node(hir, expression) {
    let mut reference = CallReference.Unsupported
    if !generics.present {
      match Module.node(hir, callee) {
        Node.IdentifierExpression {name, binding} => {
          if binding.present {
            reference = CallReference.NonCallable
          } else if let Node.Name {text} = Module.node(hir, name) {
            reference = CallReference.Named {name: run Bytes.copy(Module.text(hir, text))}
          }
        }
        Node.FieldExpression {subject, field} => {
          if let Node.IdentifierExpression {name, binding} = Module.node(hir, subject) {
            if !binding.present {
              if let Node.Name {text: namespace} = Module.node(hir, name) {
                if let Node.Name {text: member} = Module.node(hir, field) {
                  reference = CallReference.Qualified {
                    namespace: run Bytes.copy(Module.text(hir, namespace)),
                    member: run Bytes.copy(Module.text(hir, member)),
                    subjectSpan: Module.span(hir, subject),
                    memberSpan: Module.span(hir, field),
                  }
                }
              }
            }
          }
        }
        Node.IntegerLiteral {..} => {
          reference = CallReference.NonCallable
        }
        Node.BooleanLiteral {..} => {
          reference = CallReference.NonCallable
        }
        Node.UnitLiteral => {
          reference = CallReference.NonCallable
        }
        _ => ()
      }
    }
    run Vector.append<CallSyntax>(
      &mut calls.*,
      CallSyntax {id: expression, span: Module.span(hir, callee), reference: move reference},
    )
    let mut at = usize.ZERO
    while at < arguments.length {
      run collectCall(hir, Module.child(hir, arguments, at), &mut calls.*)
      at = at + usize.ONE
    }
  }
  return ()
}

effect fn collectBodySyntax(
  hir: &Module,
  written: Range,
  annotations: &mut Vector<HirId>,
  calls: &mut Vector<CallSyntax>,
) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < written.length {
    let statement = Module.child(hir, written, at)
    match Module.node(hir, statement) {
      Node.ReturnStatement {value} => {
        if value.present {
          run collectCall(hir, value.id, &mut calls.*)
        }
      }
      Node.ExpressionStatement {expression} => {
        run collectCall(hir, expression, &mut calls.*)
      }
      Node.BindingStatement {mutable, isStatic, annotation, initializer, ..} => {
        if !mutable && !isStatic && annotation.present {
          run Vector.append<HirId>(&mut annotations.*, annotation.id)
        }
        run collectCall(hir, initializer, &mut calls.*)
      }
      Node.ConditionalStatement {condition, thenBranch, elseBranch} => {
        run collectCall(hir, condition, &mut calls.*)
        if let Node.Block {statements} = Module.node(hir, thenBranch) {
          run collectBodySyntax(hir, statements, &mut annotations.*, &mut calls.*)
        }
        let mut otherwise = elseBranch
        while otherwise.present {
          match Module.node(hir, otherwise.id) {
            Node.Block {statements} => {
              run collectBodySyntax(hir, statements, &mut annotations.*, &mut calls.*)
              otherwise = HirRef.absent()
            }
            Node.ConditionalStatement {
              condition: nextCondition,
              thenBranch: nextThen,
              elseBranch: nextElse,
            } => {
              run collectCall(hir, nextCondition, &mut calls.*)
              if let Node.Block {statements} = Module.node(hir, nextThen) {
                run collectBodySyntax(hir, statements, &mut annotations.*, &mut calls.*)
              }
              otherwise = nextElse
            }
            _ => {
              otherwise = HirRef.absent()
            }
          }
        }
      }
      _ => ()
    }
    at = at + usize.ONE
  }
  return ()
}

effect fn callTarget(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  module: &ModuleId,
  moduleOrdinal: usize,
  syntax: &CallSyntax,
) -> Result<CallTarget, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let span = syntax.span
  let mut selected = Result.failResult<SelectedDeclaration, Shared<Rejection>>(
    run reject(&resolver.*, module, RejectionCode.Unsupported, span),
  )
  match & syntax.reference {
    CallReference.Named {name} => {
      selected = run selectDeclaration(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies.*,
        moduleOrdinal,
        module,
        Bytes.asSlice(&name),
        false,
        span,
        RejectionCode.NotCallable,
      )
    }
    CallReference.Qualified {namespace, member, subjectSpan, memberSpan} => {
      let namespaceName = Bytes.asSlice(&namespace)
      let nameKey = Key {
        family: Family.Name,
        module: moduleOrdinal,
        name: run internName(&mut resolver.*, namespaceName),
        declaration: usize.ZERO,
        member: usize.ZERO,
        external: false,
      }
      let observed = run demandChild(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies.*,
        nameKey,
        subjectSpan,
      )
      drop observed
      let namespaceBinding = run select(&mut resolver.*, module, namespaceName, false)
      if namespaceBinding.count == usize.ZERO {
        return Result.failResult<CallTarget, Shared<Rejection>>(
          run reject(&resolver.*, module, RejectionCode.UnknownName, subjectSpan),
        )
      }
      if namespaceBinding.count > usize.ONE {
        return Result.failResult<CallTarget, Shared<Rejection>>(
          run reject(&resolver.*, module, RejectionCode.Collision, subjectSpan),
        )
      }
      if namespaceBinding.kind != CandidateKind.ImportModule {
        return Result.failResult<CallTarget, Shared<Rejection>>(
          run reject(&resolver.*, module, RejectionCode.NotCallable, subjectSpan),
        )
      }
      let importKey = Key {
        family: Family.Import,
        module: moduleOrdinal,
        name: usize.ZERO,
        declaration: namespaceBinding.declaration,
        member: usize.MAX,
        external: false,
      }
      let imported = run demandChild(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies.*,
        importKey,
        subjectSpan,
      )
      let binding = Shared.with<Result<Answer, NoRejection>, ImportSelection>(
        &imported,
        selectedImport,
      )
      if let Option<Shared<Rejection>>.Some {value} = move binding.rejected {
        return Result.failResult<CallTarget, Shared<Rejection>>(move value)
      }
      if let Option<usize>.Some {value: targetModule} = move binding.module {
        selected = run selectDeclaration(
          &mut resolver.*,
          &mut owner.*,
          &mut dependencies.*,
          targetModule,
          module,
          Bytes.asSlice(&member),
          true,
          memberSpan,
          RejectionCode.NotCallable,
        )
      }
    }
    CallReference.Unbound {name} => {
      let found = run selectDeclaration(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies.*,
        moduleOrdinal,
        module,
        Bytes.asSlice(&name),
        false,
        span,
        RejectionCode.Unsupported,
      )
      if let Result<SelectedDeclaration, Shared<Rejection>>.Failure {error} = move found {
        return Result.failResult<CallTarget, Shared<Rejection>>(move error)
      }
      return Result.failResult<CallTarget, Shared<Rejection>>(
        run reject(&resolver.*, module, RejectionCode.Unsupported, span),
      )
    }
    CallReference.NonCallable => {
      return Result.failResult<CallTarget, Shared<Rejection>>(
        run reject(&resolver.*, module, RejectionCode.NotCallable, span),
      )
    }
    CallReference.Unsupported => {
      return Result.failResult<CallTarget, Shared<Rejection>>(
        run reject(&resolver.*, module, RejectionCode.Unsupported, span),
      )
    }
  }
  let target = match move selected {
    Result<SelectedDeclaration, Shared<Rejection>>.Success {value} => value
    Result<SelectedDeclaration, Shared<Rejection>>.Failure {error} => {
      return Result.failResult<CallTarget, Shared<Rejection>>(move error)
    }
  }
  let targetModule = run resolvedModule(&resolver.*, target.module)
  let written = run header(&mut resolver.*, &targetModule, target.ordinal)
  if let Option<HeaderSyntax>.Some {value} = move written {
    if let Node.FunctionHeader {..} = value.header {
      let signatureKey = Key {
        family: Family.Signature,
        module: target.module,
        name: usize.ZERO,
        declaration: target.ordinal,
        member: usize.ZERO,
        external: false,
      }
      let signature = run demandChild(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies.*,
        signatureKey,
        span,
      )
      let failure = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
        &signature,
        answerRejection,
      )
      if let Option<Shared<Rejection>>.Some {value: diagnostic} = move failure {
        return Result.failResult<CallTarget, Shared<Rejection>>(move diagnostic)
      }
      if Shared.with<Result<Answer, NoRejection>, usize>(&signature, signatureGenericCount) > usize.ZERO {
        return Result.failResult<CallTarget, Shared<Rejection>>(
          run reject(&resolver.*, module, RejectionCode.Unsupported, span),
        )
      }
      let identity = run declarationAt(&mut resolver.*, &targetModule, target.ordinal)
      if let Option<DeclarationId>.Some {value: declaration} = move identity {
        return Result.succeed<CallTarget, Shared<Rejection>>(
          CallTarget {declaration: move declaration, signature: move signature},
        )
      }
    }
  }
  return Result.failResult<CallTarget, Shared<Rejection>>(
    run reject(&resolver.*, module, RejectionCode.NotCallable, span),
  )
}

effect fn resolvedCall(calls: &[ResolvedCall], id: HirId) -> Option<
  Result<CallTarget, Shared<Rejection>>,
> ! OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < calls.length {
    if calls[at].id.index == id.index {
      return match & calls[at].result {
        Result<CallTarget, Shared<Rejection>>.Success {value} => Option.some<
          Result<CallTarget, Shared<Rejection>>,
        >(
          Result.succeed<CallTarget, Shared<Rejection>>(
            CallTarget {
              declaration: run DeclarationId.copy(&value.declaration),
              signature: Shared.clone<Result<Answer, NoRejection>>(&value.signature),
            },
          ),
        )
        Result<CallTarget, Shared<Rejection>>.Failure {error} => Option.some<
          Result<CallTarget, Shared<Rejection>>,
        >(Result.failResult<CallTarget, Shared<Rejection>>(Shared.clone<Rejection>(&error)))
      }
    }
    at = at + usize.ONE
  }
  return Option.none<Result<CallTarget, Shared<Rejection>>>()
}

effect fn checkExpression(
  resolver: &Resolver,
  module: &ModuleId,
  hir: &Module,
  locals: &[BodyLocal],
  calls: &[ResolvedCall],
  nodes: &mut Vector<BodyNode>,
  signatures: &mut Vector<SignatureDependency>,
  requiredBodies: &mut Vector<DeclarationId>,
  expression: HirId,
  expected: &Option<Shared<Type>>,
) -> Result<BodyNodeId, Shared<Rejection>> ! OutOfMemoryError ? &mut Allocator {
  let span = Module.span(hir, expression)
  let mut ty = run Shared.make<Type>(Type.Unit)
  let mut form = BodyExpression.Unit
  match Module.node(hir, expression) {
    Node.IntegerLiteral {sign, magnitude, suffix, ..} => {
      let mut selected = b"i32"
      let mut contextual = false
      if suffix.present {
        selected = Module.text(hir, suffix.symbol)
      } else if let Option<Shared<Type>>.Some {value} = &expected.* {
        if Shared.with<Type, bool>(&value, fixedIntegerType) {
          contextual = true
        }
      }
      if contextual {
        if let Option<Shared<Type>>.Some {value} = &expected.* {
          let fits = Shared.with<Type, bool>(
            &value,
            fn(resolved: &Type) -> bool {
              return match & resolved.* {
                Type.Primitive {name} => fitsInteger(
                  Bytes.asSlice(&name),
                  sign,
                  Module.text(hir, magnitude),
                )
                _ => false
              }
            },
          )
          if !fits {
            return run bodyRejection(&resolver.*, module, RejectionCode.IntegerOutOfRange, span)
          }
          ty = Shared.clone<Type>(&value)
        }
      } else {
        if !fixedIntegerName(selected) {
          return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
        }
        if !fitsInteger(selected, sign, Module.text(hir, magnitude)) {
          return run bodyRejection(&resolver.*, module, RejectionCode.IntegerOutOfRange, span)
        }
        ty = run primitiveType(selected)
      }
      form = BodyExpression.Integer {literal: expression}
    }
    Node.BooleanLiteral {value} => {
      ty = run primitiveType(b"bool")
      form = BodyExpression.Boolean {value: value}
    }
    Node.UnitLiteral => {
      form = BodyExpression.Unit
    }
    Node.IdentifierExpression {name, binding} => {
      if !binding.present {
        // The module-name lookup ran before checking; it rejects a declared or absent name.
        let found = run resolvedCall(calls, expression)
        if let Option<Result<CallTarget, Shared<Rejection>>>.Some {value} = move found {
          if let Result<CallTarget, Shared<Rejection>>.Failure {error} = move value {
            return Result.failResult<BodyNodeId, Shared<Rejection>>(move error)
          }
        }
        return run bodyRejection(
          resolver,
          module,
          RejectionCode.UnknownName,
          Module.span(hir, name),
        )
      }
      let mut at = usize.ZERO
      let mut found = false
      while at < locals.length {
        if locals[at].origin.syntax.index == binding.id.index {
          ty = Shared.clone<Type>(&locals[at].ty)
          form = BodyExpression.Local {local: BodyLocalId {index: at}}
          found = true
          break
        }
        at = at + usize.ONE
      }
      if found == false {
        return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
      }
    }
    Node.CallExpression {callee: _, generics, arguments} => {
      if generics.present {
        return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
      }
      let found = run resolvedCall(calls, expression)
      let target = match move found {
        Option<Result<CallTarget, Shared<Rejection>>>.Some {value} => match move value {
          Result<CallTarget, Shared<Rejection>>.Success {value: target} => target
          Result<CallTarget, Shared<Rejection>>.Failure {error} => {
            return Result.failResult<BodyNodeId, Shared<Rejection>>(move error)
          }
        }
        Option<Result<CallTarget, Shared<Rejection>>>.None => {
          return run bodyRejection(resolver, module, RejectionCode.Unsupported, span)
        }
      }
      let parameterCount = Shared.with<Result<Answer, NoRejection>, usize>(
        &target.signature,
        signatureParameterCount,
      )
      if arguments.length > parameterCount {
        return run bodyRejection(&resolver.*, module, RejectionCode.CallArity, span)
      }
      if arguments.length == usize.ZERO && parameterCount > usize.ZERO {
        return run bodyRejection(&resolver.*, module, RejectionCode.RedundantCall, span)
      }
      if Shared.with<Result<Answer, NoRejection>, bool>(
        &target.signature,
        signatureOutsideScalarBodies,
      ) {
        return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
      }
      let result = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
        &target.signature,
        signatureResult,
      )
      if let Option<Shared<Type>>.Some {value: callResult} = move result {
        if !Shared.with<Type, bool>(&callResult, scalarType) {
          return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
        }
        ty = move callResult
      } else {
        return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
      }
      let mut typedArguments = Vector.make<BodyNodeId>()
      let parameterOffset = parameterCount - arguments.length
      let mut at = usize.ZERO
      while at < arguments.length {
        let parameter = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
          &target.signature,
          fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> {
            return signatureParameter(answer, at + parameterOffset)
          },
        )
        if let Option<Shared<Type>>.Some {value: parameterType} = move parameter {
          if !Shared.with<Type, bool>(&parameterType, scalarType) {
            return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
          }
          let argument = run checkExpression(
            resolver,
            module,
            hir,
            locals,
            calls,
            &mut nodes.*,
            &mut signatures.*,
            &mut requiredBodies.*,
            Module.child(hir, arguments, at),
            &Option.some<Shared<Type>>(move parameterType),
          )
          match move argument {
            Result<BodyNodeId, Shared<Rejection>>.Success {value: node} => {
              run Vector.append<BodyNodeId>(&mut typedArguments, node)
            }
            Result<BodyNodeId, Shared<Rejection>>.Failure {error} => {
              return Result.failResult<BodyNodeId, Shared<Rejection>>(move error)
            }
          }
        } else {
          return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
        }
        at = at + usize.ONE
      }
      if arguments.length < parameterCount {
        return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
      }
      run Vector.append<SignatureDependency>(
        &mut signatures.*,
        SignatureDependency {declaration: run DeclarationId.copy(&target.declaration)},
      )
      run Vector.append<DeclarationId>(
        &mut requiredBodies.*,
        run DeclarationId.copy(&target.declaration),
      )
      form = BodyExpression.DirectCall {
        declaration: run DeclarationId.copy(&target.declaration),
        arguments: move typedArguments,
      }
    }
    _ => {
      return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
    }
  }
  if let Option<Shared<Type>>.Some {value} = &expected.* {
    if !sameSharedType(&ty, &value) {
      return run bodyRejection(&resolver.*, module, RejectionCode.TypeMismatch, span)
    }
  }
  let index = Vector.length<BodyNode>(&nodes.*)
  run Vector.append<BodyNode>(
    &mut nodes.*,
    BodyNode {
      origin: BodyOrigin {syntax: expression, span: span},
      kind: BodyNodeKind.Expression {ty: move ty, form: move form},
    },
  )
  return Result.succeed<BodyNodeId, Shared<Rejection>>(BodyNodeId {index: index})
}

fn rejectedBody(diagnostic: Shared<Rejection>, dependencies: Vector<Dependency>) -> Answer {
  return Answer {
    outcome: Outcome.Rejected {diagnostic: move diagnostic},
    dependencies: move dependencies,
    sources: Vector.make<Shared<Observation>>(),
    footprint: Vector.make<Shared<DemandFootprint>>(),
    answerId: usize.ZERO,
    identity: Option.none<Shared<Value>>(),
    bodyEvidence: Option.none<Shared<BodyEvidence>>(),
  }
}

fn sameBinderName(hir: &Module, left: HirId, right: HirId) -> bool {
  if let Node.Name {text: leftName} = Module.node(hir, left) {
    if let Node.Name {text: rightName} = Module.node(hir, right) {
      return same(Module.text(hir, leftName), Module.text(hir, rightName))
    }
  }
  return false
}

effect fn checkBlock(
  resolver: &Resolver,
  module: &ModuleId,
  hir: &Module,
  locals: &mut Vector<BodyLocal>,
  annotations: &[ResolvedAnnotation],
  calls: &[ResolvedCall],
  nodes: &mut Vector<BodyNode>,
  signatures: &mut Vector<SignatureDependency>,
  requiredBodies: &mut Vector<DeclarationId>,
  block: HirId,
  resultType: &Shared<Type>,
) -> Result<CheckedControl, Shared<Rejection>> ! OutOfMemoryError ? &mut Allocator {
  if let Node.Block {statements: written} = Module.node(hir, block) {
    let mut bindings = Vector.make<HirId>()
    let mut statements = Vector.make<BodyNodeId>()
    let checked = run checkStatements(
      resolver,
      module,
      hir,
      &mut locals.*,
      &mut bindings,
      annotations,
      calls,
      &mut nodes.*,
      &mut signatures.*,
      &mut requiredBodies.*,
      &mut statements,
      written,
      resultType,
    )
    let canComplete = match move checked {
      Result<bool, Shared<Rejection>>.Success {value} => value
      Result<bool, Shared<Rejection>>.Failure {error} => {
        return Result.failResult<CheckedControl, Shared<Rejection>>(move error)
      }
    }
    let node = BodyNodeId {index: Vector.length<BodyNode>(&nodes.*)}
    run Vector.append<BodyNode>(
      &mut nodes.*,
      BodyNode {
        origin: BodyOrigin {syntax: block, span: Module.span(hir, block)},
        kind: BodyNodeKind.Block {statements: move statements, canComplete: canComplete},
      },
    )
    return Result.succeed<CheckedControl, Shared<Rejection>>(
      CheckedControl {node: node, canComplete: canComplete},
    )
  }
  return Result.failResult<CheckedControl, Shared<Rejection>>(
    run reject(resolver, module, RejectionCode.Unsupported, Module.span(hir, block)),
  )
}

effect fn checkConditional(
  resolver: &Resolver,
  module: &ModuleId,
  hir: &Module,
  locals: &mut Vector<BodyLocal>,
  annotations: &[ResolvedAnnotation],
  calls: &[ResolvedCall],
  nodes: &mut Vector<BodyNode>,
  signatures: &mut Vector<SignatureDependency>,
  requiredBodies: &mut Vector<DeclarationId>,
  statement: HirId,
  resultType: &Shared<Type>,
) -> Result<CheckedControl, Shared<Rejection>> ! OutOfMemoryError ? &mut Allocator {
  if let Node.ConditionalStatement {condition, thenBranch, elseBranch} = Module.node(hir, statement) {
    let checkedCondition = run checkExpression(
      resolver,
      module,
      hir,
      Vector.asSlice<BodyLocal>(&locals.*),
      calls,
      &mut nodes.*,
      &mut signatures.*,
      &mut requiredBodies.*,
      condition,
      &Option.none<Shared<Type>>(),
    )
    let conditionNode = match move checkedCondition {
      Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
      Result<BodyNodeId, Shared<Rejection>>.Failure {error} => {
        return Result.failResult<CheckedControl, Shared<Rejection>>(move error)
      }
    }
    let boolType = run primitiveType(b"bool")
    let conditionType = match & Vector.asSlice<BodyNode>(&nodes.*)[conditionNode.index].kind {
      BodyNodeKind.Expression {ty, ..} => Shared.clone<Type>(&ty)
      _ => {
        return Result.failResult<CheckedControl, Shared<Rejection>>(
          run reject(resolver, module, RejectionCode.Unsupported, Module.span(hir, condition)),
        )
      }
    }
    if !sameSharedType(&conditionType, &boolType) {
      return Result.failResult<CheckedControl, Shared<Rejection>>(
        run reject(resolver, module, RejectionCode.ConditionNotBool, Module.span(hir, condition)),
      )
    }
    let checkedThen = run checkBlock(
      resolver,
      module,
      hir,
      &mut locals.*,
      annotations,
      calls,
      &mut nodes.*,
      &mut signatures.*,
      &mut requiredBodies.*,
      thenBranch,
      resultType,
    )
    let thenControl = match move checkedThen {
      Result<CheckedControl, Shared<Rejection>>.Success {value} => value
      Result<CheckedControl, Shared<Rejection>>.Failure {error} => {
        return Result.failResult<CheckedControl, Shared<Rejection>>(move error)
      }
    }
    let mut checkedElse = Option.none<BodyNodeId>()
    let mut elseCanComplete = true
    if elseBranch.present {
      let otherwise = match Module.node(hir, elseBranch.id) {
        Node.Block {..} => run checkBlock(
          resolver,
          module,
          hir,
          &mut locals.*,
          annotations,
          calls,
          &mut nodes.*,
          &mut signatures.*,
          &mut requiredBodies.*,
          elseBranch.id,
          resultType,
        )
        Node.ConditionalStatement {..} => run checkConditional(
          resolver,
          module,
          hir,
          &mut locals.*,
          annotations,
          calls,
          &mut nodes.*,
          &mut signatures.*,
          &mut requiredBodies.*,
          elseBranch.id,
          resultType,
        )
        _ => Result.failResult<CheckedControl, Shared<Rejection>>(
          run reject(resolver, module, RejectionCode.Unsupported, Module.span(hir, elseBranch.id)),
        )
      }
      match move otherwise {
        Result<CheckedControl, Shared<Rejection>>.Success {value} => {
          checkedElse = Option.some<BodyNodeId>(value.node)
          elseCanComplete = value.canComplete
        }
        Result<CheckedControl, Shared<Rejection>>.Failure {error} => {
          return Result.failResult<CheckedControl, Shared<Rejection>>(move error)
        }
      }
    }
    let canComplete = thenControl.canComplete || elseCanComplete
    let node = BodyNodeId {index: Vector.length<BodyNode>(&nodes.*)}
    run Vector.append<BodyNode>(
      &mut nodes.*,
      BodyNode {
        origin: BodyOrigin {syntax: statement, span: Module.span(hir, statement)},
        kind: BodyNodeKind.Branch {
          condition: conditionNode,
          thenBranch: thenControl.node,
          elseBranch: move checkedElse,
          canComplete: canComplete,
        },
      },
    )
    return Result.succeed<CheckedControl, Shared<Rejection>>(
      CheckedControl {node: node, canComplete: canComplete},
    )
  }
  return Result.failResult<CheckedControl, Shared<Rejection>>(
    run reject(resolver, module, RejectionCode.Unsupported, Module.span(hir, statement)),
  )
}

effect fn checkStatements(
  resolver: &Resolver,
  module: &ModuleId,
  hir: &Module,
  locals: &mut Vector<BodyLocal>,
  bindings: &mut Vector<HirId>,
  annotations: &[ResolvedAnnotation],
  calls: &[ResolvedCall],
  nodes: &mut Vector<BodyNode>,
  signatures: &mut Vector<SignatureDependency>,
  requiredBodies: &mut Vector<DeclarationId>,
  statements: &mut Vector<BodyNodeId>,
  written: Range,
  resultType: &Shared<Type>,
) -> Result<bool, Shared<Rejection>> ! OutOfMemoryError ? &mut Allocator {
  let mut reachable = true
  let mut at = usize.ZERO
  while at < written.length {
    let statement = Module.child(hir, written, at)
    let span = Module.span(hir, statement)
    match Module.node(hir, statement) {
      Node.ConditionalStatement {..} => {
        let checked = run checkConditional(
          resolver,
          module,
          hir,
          &mut locals.*,
          annotations,
          calls,
          &mut nodes.*,
          &mut signatures.*,
          &mut requiredBodies.*,
          statement,
          resultType,
        )
        match move checked {
          Result<CheckedControl, Shared<Rejection>>.Success {value} => {
            run Vector.append<BodyNodeId>(&mut statements.*, value.node)
            reachable = reachable && value.canComplete
          }
          Result<CheckedControl, Shared<Rejection>>.Failure {error} => {
            return Result.failResult<bool, Shared<Rejection>>(move error)
          }
        }
      }
      Node.ReturnStatement {value: returned} => {
        if span.start == span.end && returned.present {
          match Module.node(hir, returned.id) {
            Node.UnitLiteral => {
              at = at + usize.ONE
              continue
            }
            _ => ()
          }
        }
        let mut checked = Option.none<BodyNodeId>()
        if returned.present {
          let expected = Option.some<Shared<Type>>(Shared.clone<Type>(resultType))
          let expression = run checkExpression(
            resolver,
            module,
            hir,
            Vector.asSlice<BodyLocal>(&locals.*),
            calls,
            &mut nodes.*,
            &mut signatures.*,
            &mut requiredBodies.*,
            returned.id,
            &expected,
          )
          match move expression {
            Result<BodyNodeId, Shared<Rejection>>.Success {value: node} => {
              checked = Option.some<BodyNodeId>(node)
            }
            Result<BodyNodeId, Shared<Rejection>>.Failure {error} => {
              return Result.failResult<bool, Shared<Rejection>>(move error)
            }
          }
        } else if Shared.with<Type, usize>(resultType, scalarCode) != 1 {
          return Result.failResult<bool, Shared<Rejection>>(
            run reject(&resolver.*, module, RejectionCode.TypeMismatch, span),
          )
        }
        let node = BodyNodeId {index: Vector.length<BodyNode>(&nodes.*)}
        run Vector.append<BodyNode>(
          &mut nodes.*,
          BodyNode {
            origin: BodyOrigin {syntax: statement, span: span},
            kind: BodyNodeKind.Return {value: move checked},
          },
        )
        run Vector.append<BodyNodeId>(&mut statements.*, node)
        reachable = false
      }
      Node.ExpressionStatement {expression} => {
        let checked = run checkExpression(
          resolver,
          module,
          hir,
          Vector.asSlice<BodyLocal>(&locals.*),
          calls,
          &mut nodes.*,
          &mut signatures.*,
          &mut requiredBodies.*,
          expression,
          &Option.none<Shared<Type>>(),
        )
        match move checked {
          Result<BodyNodeId, Shared<Rejection>>.Success {value: node} => {
            run Vector.append<BodyNodeId>(&mut statements.*, node)
          }
          Result<BodyNodeId, Shared<Rejection>>.Failure {error} => {
            return Result.failResult<bool, Shared<Rejection>>(move error)
          }
        }
      }
      Node.BindingStatement {name, mutable, isStatic, annotation, initializer} => {
        if mutable || isStatic {
          return Result.failResult<bool, Shared<Rejection>>(
            run reject(&resolver.*, module, RejectionCode.Unsupported, span),
          )
        }
        let known = Vector.asSlice<HirId>(&bindings.*)
        let mut prior = usize.ZERO
        while prior < known.length {
          if sameBinderName(hir, name, known[prior]) {
            return Result.failResult<bool, Shared<Rejection>>(
              run reject(&resolver.*, module, RejectionCode.Collision, Module.span(hir, name)),
            )
          }
          prior = prior + usize.ONE
        }
        let mut expected = Option.none<Shared<Type>>()
        if annotation.present {
          let mut found = false
          let mut selected = usize.ZERO
          while selected < annotations.length {
            if annotations[selected].id.index == annotation.id.index {
              found = true
              match & annotations[selected].result {
                Result<Shared<Type>, Shared<Rejection>>.Success {value} => {
                  if !Shared.with<Type, bool>(&value, scalarType) {
                    return Result.failResult<bool, Shared<Rejection>>(
                      run reject(
                        &resolver.*,
                        module,
                        RejectionCode.Unsupported,
                        Module.span(hir, annotation.id),
                      ),
                    )
                  }
                  expected = Option.some<Shared<Type>>(Shared.clone<Type>(&value))
                }
                Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
                  return Result.failResult<bool, Shared<Rejection>>(Shared.clone<Rejection>(&error))
                }
              }
              break
            }
            selected = selected + usize.ONE
          }
          if !found {
            return Result.failResult<bool, Shared<Rejection>>(
              run reject(
                &resolver.*,
                module,
                RejectionCode.Unsupported,
                Module.span(hir, annotation.id),
              ),
            )
          }
        }
        let checked = run checkExpression(
          resolver,
          module,
          hir,
          Vector.asSlice<BodyLocal>(&locals.*),
          calls,
          &mut nodes.*,
          &mut signatures.*,
          &mut requiredBodies.*,
          initializer,
          &expected,
        )
        let initializerNode = match move checked {
          Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
          Result<BodyNodeId, Shared<Rejection>>.Failure {error} => {
            return Result.failResult<bool, Shared<Rejection>>(move error)
          }
        }
        let checkedNodes = Vector.asSlice<BodyNode>(&nodes.*)
        let ty = match & checkedNodes[initializerNode.index].kind {
          BodyNodeKind.Expression {ty, ..} => Shared.clone<Type>(&ty)
          _ => {
            return Result.failResult<bool, Shared<Rejection>>(
              run reject(&resolver.*, module, RejectionCode.Unsupported, span),
            )
          }
        }
        let local = BodyLocalId {index: Vector.length<BodyLocal>(&locals.*)}
        run Vector.append<BodyLocal>(
          &mut locals.*,
          BodyLocal {
            origin: BodyOrigin {syntax: statement, span: Module.span(hir, name)},
            ty: move ty,
          },
        )
        run Vector.append<HirId>(&mut bindings.*, name)
        let node = BodyNodeId {index: Vector.length<BodyNode>(&nodes.*)}
        run Vector.append<BodyNode>(
          &mut nodes.*,
          BodyNode {
            origin: BodyOrigin {syntax: statement, span: span},
            kind: BodyNodeKind.LocalBinding {local: local, initializer: initializerNode},
          },
        )
        run Vector.append<BodyNodeId>(&mut statements.*, node)
      }
      _ => {
        return Result.failResult<bool, Shared<Rejection>>(
          run reject(&resolver.*, module, RejectionCode.Unsupported, span),
        )
      }
    }
    at = at + usize.ONE
  }
  return Result.succeed<bool, Shared<Rejection>>(reachable)
}

effect fn currentKey(resolver: &mut Resolver, prior: &BodyDependency) -> Option<Key>
! Cycle | OutOfMemoryError
? &mut Allocator {
  let previous = prior.key
  if previous.family == Family.Name {
    return Option.some<Key>(previous)
  }
  let module = run resolvedModule(&resolver.*, previous.module)
  let answer = run source(&mut resolver.*, &module)
  if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(&resolver.*, &answer, &module) {
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(indexed))
    let mut found = Option.none<usize>()
    let mut at = usize.ZERO
    while at < declarations.length {
      let matches = match & prior.declaration {
        Option<Shared<DeclarationId>>.Some {value: old} => Shared.with<DeclarationId, bool>(
          &old,
          fn(previous: &DeclarationId) -> bool {
            return DeclarationId.equals(previous, &declarations[at].identity)
          },
        )
        Option<Shared<DeclarationId>>.None => false
      }
      if !declarations[at].ambiguous && matches {
        if let Option<usize>.Some {value: _} = &found {
          return Option.none<Key>()
        }
        found = Option.some<usize>(at)
      }
      at = at + usize.ONE
    }
    if let Option<usize>.Some {value} = move found {
      return Option.some<Key>(
        Key {
          family: previous.family,
          module: previous.module,
          name: previous.name,
          declaration: value,
          member: previous.member,
          external: previous.external,
        },
      )
    }
  }
  return Option.none<Key>()
}

effect fn reuseBody(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  key: Key,
  candidate: BodyCandidate,
) -> Option<Answer>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let BodyCandidate {body, evidence, directCount} = move candidate
  let module = run resolvedModule(&resolver.*, key.module)
  let sourceAnswer = run source(&mut resolver.*, &module)
  let mut validInput = false
  if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(
    &resolver.*,
    &sourceAnswer,
    &module,
  ) {
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(indexed))
    if key.declaration < declarations.length && !declarations[key.declaration].ambiguous {
      let hir = IndexedSource.authored(indexed)
      let header = run Fingerprint.header(hir, declarations[key.declaration].local)
      let implementation = run Fingerprint.body(hir, declarations[key.declaration].local)
      validInput = Shared.with<TypedBody, bool>(
        &body,
        fn(checked: &TypedBody) -> bool {
          return TypedBody.matchesInput(
            checked,
            indexed,
            key.declaration,
            Vector.asSlice<u8>(&header),
            Vector.asSlice<u8>(&implementation),
          )
        },
      )
    }
  }
  if !validInput {
    return Option.none<Answer>()
  }
  let count = Shared.with<BodyEvidence, usize>(
    &evidence,
    fn(owned: &BodyEvidence) -> usize {
      return Vector.length<BodyDependency>(&owned.direct)
    },
  )
  if count != directCount {
    return Option.none<Answer>()
  }
  let mut dependencies = Vector.make<Dependency>()
  let mut at = usize.ZERO
  while at < count {
    let prior = Shared.with<BodyEvidence, BodyDependency>(
      &evidence,
      fn(owned: &BodyEvidence) -> BodyDependency {
        return bodyDependencyAt(owned, at)
      },
    )
    let current = run currentKey(&mut resolver.*, &prior)
    let selected = match move current {
      Option<Key>.Some {value} => value
      Option<Key>.None => {
        return Option.none<Answer>()
      }
    }
    let now = run demandChild(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies,
      selected,
      Span.make(usize.ZERO, usize.ZERO),
    )
    if prior.answerId == Shared.with<Result<Answer, NoRejection>, usize>(&now, priorAnswerId) && prior.answerId != usize.ZERO {
      at = at + usize.ONE
      continue
    }
    let previousIdentity = match & prior.identity {
      Option<Shared<Value>>.Some {value} => Option.some<Shared<Value>>(Shared.clone<Value>(&value))
      Option<Shared<Value>>.None => Option.none<Shared<Value>>()
    }
    let currentIdentity = Shared.with<Result<Answer, NoRejection>, Option<Shared<Value>>>(
      &now,
      answerIdentity,
    )
    let matching = match move previousIdentity {
      Option<Shared<Value>>.Some {value: first} => match move currentIdentity {
        Option<Shared<Value>>.Some {value: second} => sameSharedValue(&first, &second)
        Option<Shared<Value>>.None => false
      }
      Option<Shared<Value>>.None => false
    }
    if !matching {
      return Option.none<Answer>()
    }
    at = at + usize.ONE
  }
  return Option.some<Answer>(
    Answer {
      outcome: Outcome.Success {
        value: Value.Body {
          body: move body,
          source: run Shared.make<Observation>(
            run SourceIndex.captureObservation(&resolver.source, &module),
          ),
        },
      },
      dependencies: move dependencies,
      sources: Vector.make<Shared<Observation>>(),
      footprint: Vector.make<Shared<DemandFootprint>>(),
      answerId: usize.ZERO,
      identity: Option.none<Shared<Value>>(),
      bodyEvidence: Option.none<Shared<BodyEvidence>>(),
    },
  )
}

// The written form of one constant initializer, read before any nested demand.
union InitializerSyntax {
  Missing,
  Integer {sign: Sign, magnitude: Bytes, suffix: Option<Bytes>},
  Boolean {value: bool},
  Named {name: Bytes},
  Other,
}

struct WrittenInitializer {
  syntax: InitializerSyntax
  span: Span
}

// CONST-001 admits one primitive scalar or `string`; `char` follows the lexical constant forms.
fn constantType(value: &Type) -> bool {
  return match & value.* {
    Type.Primitive {..} => true
    Type.String {..} => true
    _ => false
  }
}

fn pointerSized(value: &Type) -> bool {
  return match & value.* {
    Type.Primitive {name} => same(Bytes.asSlice(&name), b"usize") || same(
      Bytes.asSlice(&name),
      b"isize",
    )
    _ => false
  }
}

fn initializerValue(answer: &Result<Answer, NoRejection>) -> Option<Shared<ConstantValue>> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Initializer {value: found}} => Option.some<
        Shared<ConstantValue>,
      >(Shared.clone<ConstantValue>(&found))
      _ => Option.none<Shared<ConstantValue>>()
    }
    Result<Answer, NoRejection>.Failure {error: _} => Option.none<Shared<ConstantValue>>()
  }
}

effect fn resolveConstant(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  key: Key,
) -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let module = run resolvedModule(&resolver.*, key.module)
  let mut dependencies = Vector.make<Dependency>()
  let written = run header(&mut resolver.*, &module, key.declaration)
  let mut span = Span.make(usize.ZERO, usize.ZERO)
  if let Option<HeaderSyntax>.Some {value} = move written {
    span = value.span
    if let Node.ConstantHeader {annotation, ..} = value.header {
      if !annotation.present {
        return memberRejected(
          run reject(&resolver.*, &module, RejectionCode.InvalidConstant, value.span),
          move dependencies,
        )
      }
      let noBinders = Vector.make<Binder>()
      // A constant is static data, so an omitted `string` lifetime is `'static`.
      let mut elision = LifetimeElision {
        owner: Option.none<DeclarationId>(),
        nextOrdinal: usize.ZERO,
        output: true,
        resultDefault: Option.some<Shared<Lifetime>>(run Shared.make<Lifetime>(Lifetime.Static)),
        generated: Vector.make<Shared<Lifetime>>(),
        invocation: false,
        nested: false,
        renumber: Vector.make<usize>(),
        staticEnvironment: false,
      }
      let resolved = run resolveType(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies,
        key.module,
        annotation.id,
        Vector.asSlice<Binder>(&noBinders),
        &mut elision,
      )
      return match move resolved {
        Result<Shared<Type>, Shared<Rejection>>.Success {value: ty} => {
          if Shared.with<Type, bool>(&ty, constantType) {
            return memberSuccess(Value.Type {resolved: move ty}, move dependencies)
          }
          let mut annotationSpan = value.span
          let annotationSyntax = run typeNode(&mut resolver.*, &module, annotation.id)
          if let Option<HeaderSyntax>.Some {value: typeSyntax} = move annotationSyntax {
            annotationSpan = typeSyntax.span
          }
          return memberRejected(
            run reject(&resolver.*, &module, RejectionCode.InvalidConstant, annotationSpan),
            move dependencies,
          )
        }
        Result<Shared<Type>, Shared<Rejection>>.Failure {error} => memberRejected(
          move error,
          move dependencies,
        )
      }
    }
  }
  // Foreign statics and package parameters are not constants; they stay outside this family.
  return memberRejected(
    run reject(&resolver.*, &module, RejectionCode.Unsupported, span),
    move dependencies,
  )
}

effect fn initializerSyntax(
  resolver: &mut Resolver,
  module: &ModuleId,
  ordinal: usize,
  fallback: Span,
) -> WrittenInitializer ! Cycle | OutOfMemoryError ? &mut Allocator {
  let answer = run source(&mut resolver.*, module)
  if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(&resolver.*, &answer, module) {
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(indexed))
    if ordinal < declarations.length {
      let hir = IndexedSource.authored(indexed)
      if let Node.Declaration {body, ..} = Module.node(hir, declarations[ordinal].local) {
        if let Node.InitializerBody {value} = Module.node(hir, body) {
          if !value.present {
            return WrittenInitializer {syntax: InitializerSyntax.Missing, span: fallback}
          }
          let span = Module.span(hir, value.id)
          return match Module.node(hir, value.id) {
            Node.IntegerLiteral {sign, magnitude, suffix, ..} => {
              let mut written = Option.none<Bytes>()
              if suffix.present {
                written = Option.some<Bytes>(run Bytes.copy(Module.text(hir, suffix.symbol)))
              }
              let digits = Module.text(hir, magnitude)
              let mut canonical = sign
              if digits.length == usize.ONE && digits[0] == 48 {
                canonical = Sign.Positive
              }
              return WrittenInitializer {
                syntax: InitializerSyntax.Integer {
                  sign: canonical,
                  magnitude: run Bytes.copy(digits),
                  suffix: move written,
                },
                span: span,
              }
            }
            Node.BooleanLiteral {value: written} => WrittenInitializer {
              syntax: InitializerSyntax.Boolean {value: written},
              span: span,
            }
            Node.IdentifierExpression {name, ..} => {
              if let Node.Name {text} = Module.node(hir, name) {
                return WrittenInitializer {
                  syntax: InitializerSyntax.Named {name: run Bytes.copy(Module.text(hir, text))},
                  span: span,
                }
              }
              return WrittenInitializer {syntax: InitializerSyntax.Other, span: span}
            }
            _ => WrittenInitializer {syntax: InitializerSyntax.Other, span: span}
          }
        }
      }
    }
  }
  return WrittenInitializer {syntax: InitializerSyntax.Other, span: fallback}
}

effect fn resolveInitializer(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  key: Key,
) -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let module = run resolvedModule(&resolver.*, key.module)
  let mut dependencies = Vector.make<Dependency>()
  // The value demand starts from the separately demandable type fact of the same declaration.
  let declared = run demandChild(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies,
    Key {
      family: Family.Constant,
      module: key.module,
      name: usize.ZERO,
      declaration: key.declaration,
      member: usize.ZERO,
      external: false,
    },
    Span.make(usize.ZERO, usize.ZERO),
  )
  let selected = Shared.with<Result<Answer, NoRejection>, TypeSelection>(&declared, selectedType)
  if let Option<Shared<Rejection>>.Some {value} = move selected.rejected {
    return memberRejected(move value, move dependencies)
  }
  let ty = match move selected.resolved {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => {
      return memberRejected(
        run reject(
          &resolver.*,
          &module,
          RejectionCode.Unsupported,
          Span.make(usize.ZERO, usize.ZERO),
        ),
        move dependencies,
      )
    }
  }
  let mut fallback = Span.make(usize.ZERO, usize.ZERO)
  let declaredHeader = run header(&mut resolver.*, &module, key.declaration)
  if let Option<HeaderSyntax>.Some {value} = move declaredHeader {
    fallback = value.span
  }
  let written = run initializerSyntax(&mut resolver.*, &module, key.declaration, fallback)
  let WrittenInitializer {syntax, span} = move written
  let mut code = RejectionCode.InvalidConstant
  match move syntax {
    InitializerSyntax.Integer {sign, magnitude, suffix} => {
      if Shared.with<Type, bool>(&ty, pointerSized) {
        // Pointer-sized ranges belong to the selected target, which is not chosen here.
        code = RejectionCode.Unsupported
      } else if Shared.with<Type, bool>(&ty, fixedIntegerType) && Shared.with<Type, bool>(
        &ty,
        fn(resolved: &Type) -> bool {
          return match & resolved.* {
            Type.Primitive {name} => {
              let spelling = Bytes.asSlice(&name)
              if let Option<Bytes>.Some {value: suffixName} = &suffix {
                if !same(Bytes.asSlice(&suffixName), spelling) {
                  return false
                }
              }
              return fitsInteger(spelling, sign, Bytes.asSlice(&magnitude))
            }
            _ => false
          }
        },
      ) {
        return memberSuccess(
          Value.Initializer {
            value: run Shared.make<ConstantValue>(
              ConstantValue.Integer {sign: sign, magnitude: move magnitude},
            ),
          },
          move dependencies,
        )
      }
    }
    InitializerSyntax.Boolean {value} => {
      if Shared.with<Type, usize>(&ty, scalarCode) == 2 {
        return memberSuccess(
          Value.Initializer {
            value: run Shared.make<ConstantValue>(ConstantValue.Boolean {value: value}),
          },
          move dependencies,
        )
      }
    }
    InitializerSyntax.Named {name} => {
      let target = run selectDeclaration(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies,
        key.module,
        &module,
        Bytes.asSlice(&name),
        false,
        span,
        RejectionCode.Unsupported,
      )
      let found = match move target {
        Result<SelectedDeclaration, Shared<Rejection>>.Success {value} => value
        Result<SelectedDeclaration, Shared<Rejection>>.Failure {error} => {
          return memberRejected(move error, move dependencies)
        }
      }
      let targetModule = run resolvedModule(&resolver.*, found.module)
      let mut isConstant = false
      let targetHeader = run header(&mut resolver.*, &targetModule, found.ordinal)
      if let Option<HeaderSyntax>.Some {value} = move targetHeader {
        if let Node.ConstantHeader {..} = value.header {
          isConstant = true
        }
      }
      if !isConstant {
        // Reading any other declaration here needs static evaluation.
        return memberRejected(
          run reject(&resolver.*, &module, RejectionCode.Unsupported, span),
          move dependencies,
        )
      }
      // The type edge is demanded before, and independently of, the value edge.
      let referencedType = run demandChild(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies,
        Key {
          family: Family.Constant,
          module: found.module,
          name: usize.ZERO,
          declaration: found.ordinal,
          member: usize.ZERO,
          external: false,
        },
        span,
      )
      let referenced = Shared.with<Result<Answer, NoRejection>, TypeSelection>(
        &referencedType,
        selectedType,
      )
      if let Option<Shared<Rejection>>.Some {value} = move referenced.rejected {
        return memberRejected(move value, move dependencies)
      }
      let mut matches = false
      if let Option<Shared<Type>>.Some {value: other} = move referenced.resolved {
        matches = run Type.equalsShared(&ty, &other)
      }
      if !matches {
        return memberRejected(
          run reject(&resolver.*, &module, RejectionCode.TypeMismatch, span),
          move dependencies,
        )
      }
      let referencedValue = run demandChild(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies,
        Key {
          family: Family.Initializer,
          module: found.module,
          name: usize.ZERO,
          declaration: found.ordinal,
          member: usize.ZERO,
          external: false,
        },
        span,
      )
      let failure = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
        &referencedValue,
        answerRejection,
      )
      if let Option<Shared<Rejection>>.Some {value} = move failure {
        return memberRejected(move value, move dependencies)
      }
      let copied = Shared.with<Result<Answer, NoRejection>, Option<Shared<ConstantValue>>>(
        &referencedValue,
        initializerValue,
      )
      if let Option<Shared<ConstantValue>>.Some {value} = move copied {
        return memberSuccess(Value.Initializer {value: move value}, move dependencies)
      }
      code = RejectionCode.Unsupported
    }
    InitializerSyntax.Missing => {}
    InitializerSyntax.Other => {
      // Calls, operators, and other literal kinds need static evaluation or unported scalar rules.
      code = RejectionCode.Unsupported
    }
  }
  return memberRejected(run reject(&resolver.*, &module, code, span), move dependencies)
}

effect fn resolveBody(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  key: Key,
  candidate: Option<BodyCandidate>,
) -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  if let Option<BodyCandidate>.Some {value} = move candidate {
    let reused = run reuseBody(&mut resolver.*, &mut owner.*, key, move value)
    if let Option<Answer>.Some {value: answer} = move reused {
      let word = run internKey(&mut resolver.*, key)
      run emit(&mut resolver.*, EventKind.Reuse, word)
      return move answer
    }
    let count = Vector.length<SourceFrame>(&resolver.frames)
    let stale = Vector.remove<SourceFrame>(&mut resolver.frames, count - usize.ONE)
    drop stale
    run Vector.append<SourceFrame>(
      &mut resolver.frames,
      SourceFrame {
        observations: Vector.make<Shared<Observation>>(),
        footprint: Vector.make<Shared<DemandFootprint>>(),
        direct: Vector.make<BodyDependency>(),
      },
    )
  }
  let module = run resolvedModule(&resolver.*, key.module)
  let signatureKey = Key {
    family: Family.Signature,
    module: key.module,
    name: usize.ZERO,
    declaration: key.declaration,
    member: usize.ZERO,
    external: false,
  }
  let mut dependencies = Vector.make<Dependency>()
  let signatureAnswer = run demandChild(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies,
    signatureKey,
    Span.make(usize.ZERO, usize.ZERO),
  )
  let signatureFailure = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
    &signatureAnswer,
    answerRejection,
  )
  if let Option<Shared<Rejection>>.Some {value} = move signatureFailure {
    return rejectedBody(move value, move dependencies)
  }
  let selectedResult = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
    &signatureAnswer,
    signatureResult,
  )
  let resultType = match move selectedResult {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => {
      return rejectedBody(
        run reject(
          &resolver.*,
          &module,
          RejectionCode.Unsupported,
          Span.make(usize.ZERO, usize.ZERO),
        ),
        move dependencies,
      )
    }
  }
  let parameterCount = Shared.with<Result<Answer, NoRejection>, usize>(
    &signatureAnswer,
    signatureParameterCount,
  )
  let typeParameterCount = Shared.with<Result<Answer, NoRejection>, usize>(
    &signatureAnswer,
    signatureGenericCount,
  )
  if typeParameterCount > usize.ZERO {
    let written = run header(&mut resolver.*, &module, key.declaration)
    if let Option<HeaderSyntax>.Some {value} = move written {
      return rejectedBody(
        run reject(&resolver.*, &module, RejectionCode.Unsupported, value.span),
        move dependencies,
      )
    }
  }
  let restricted = Shared.with<Result<Answer, NoRejection>, bool>(
    &signatureAnswer,
    signatureOutsideScalarBodies,
  )
  let sourceAnswer = run source(&mut resolver.*, &module)
  let mut annotationIds = Vector.make<HirId>()
  let mut writtenCalls = Vector.make<CallSyntax>()
  if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(
    &resolver.*,
    &sourceAnswer,
    &module,
  ) {
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(indexed))
    if key.declaration < declarations.length {
      let hir = IndexedSource.authored(indexed)
      if let Node.Declaration {body, ..} = Module.node(hir, declarations[key.declaration].local) {
        if let Node.CallableBody {block} = Module.node(hir, body) {
          if block.present {
            if let Node.Block {statements} = Module.node(hir, block.id) {
              run collectBodySyntax(hir, statements, &mut annotationIds, &mut writtenCalls)
            }
          }
        }
      }
    }
  }
  let mut annotations = Vector.make<ResolvedAnnotation>()
  let noBinders = Vector.make<Binder>()
  let mut noElision = LifetimeElision {
    owner: Option.none<DeclarationId>(),
    nextOrdinal: usize.ZERO,
    output: false,
    resultDefault: Option.none<Shared<Lifetime>>(),
    generated: Vector.make<Shared<Lifetime>>(),
    invocation: false,
    nested: false,
    renumber: Vector.make<usize>(),
    staticEnvironment: false,
  }
  let writtenAnnotations = Vector.asSlice<HirId>(&annotationIds)
  let mut annotationAt = usize.ZERO
  while annotationAt < writtenAnnotations.length {
    let id = writtenAnnotations[annotationAt]
    let result = run resolveType(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies,
      key.module,
      id,
      Vector.asSlice<Binder>(&noBinders),
      &mut noElision,
    )
    run Vector.append<ResolvedAnnotation>(
      &mut annotations,
      ResolvedAnnotation {id: id, result: move result},
    )
    annotationAt = annotationAt + usize.ONE
  }
  let mut resolvedCalls = Vector.make<ResolvedCall>()
  let callSyntax = Vector.asSlice<CallSyntax>(&writtenCalls)
  let mut callAt = usize.ZERO
  while callAt < callSyntax.length {
    let result = run callTarget(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies,
      &module,
      key.module,
      &callSyntax[callAt],
    )
    run Vector.append<ResolvedCall>(
      &mut resolvedCalls,
      ResolvedCall {id: callSyntax[callAt].id, result: move result},
    )
    callAt = callAt + usize.ONE
  }
  if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(
    &resolver.*,
    &sourceAnswer,
    &module,
  ) {
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(indexed))
    if key.declaration < declarations.length {
      let declaration = &declarations[key.declaration]
      let hir = IndexedSource.authored(indexed)
      let headerId = declaration.header
      let headerSpan = Module.span(hir, headerId)
      if restricted || !Shared.with<Type, bool>(&resultType, scalarType) {
        return rejectedBody(
          run reject(&resolver.*, &module, RejectionCode.Unsupported, headerSpan),
          move dependencies,
        )
      }
      if let Node.FunctionHeader {contract, ..} = Module.node(hir, headerId) {
        if let Node.CallableContract {parameters: writtenParameters, ..} = Module.node(
          hir,
          contract,
        ) {
          if writtenParameters.length != parameterCount {
            return rejectedBody(
              run reject(&resolver.*, &module, RejectionCode.Unsupported, headerSpan),
              move dependencies,
            )
          }
          let mut locals = Vector.make<BodyLocal>()
          let mut at = usize.ZERO
          while at < parameterCount {
            let parameterId = Module.child(hir, writtenParameters, at)
            let selected = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
              &signatureAnswer,
              fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> {
                return signatureParameter(answer, at)
              },
            )
            if let Option<Shared<Type>>.Some {value: parameterType} = move selected {
              if !Shared.with<Type, bool>(&parameterType, scalarType) {
                return rejectedBody(
                  run reject(
                    &resolver.*,
                    &module,
                    RejectionCode.Unsupported,
                    Module.span(hir, parameterId),
                  ),
                  move dependencies,
                )
              }
              if let Node.Parameter {name, mode, ..} = Module.node(hir, parameterId) {
                if mode == ParameterMode.Value {
                  let mut prior = usize.ZERO
                  while prior < Vector.length<BodyLocal>(&locals) {
                    let earlierId = Vector.asSlice<BodyLocal>(&locals)[prior].origin.syntax
                    if let Node.Parameter {name: earlier, ..} = Module.node(hir, earlierId) {
                      if sameBinderName(hir, name, earlier) {
                        return rejectedBody(
                          run reject(
                            &resolver.*,
                            &module,
                            RejectionCode.Collision,
                            Module.span(hir, name),
                          ),
                          move dependencies,
                        )
                      }
                    }
                    prior = prior + usize.ONE
                  }
                  run Vector.append<BodyLocal>(
                    &mut locals,
                    BodyLocal {
                      origin: BodyOrigin {syntax: parameterId, span: Module.span(hir, name)},
                      ty: move parameterType,
                    },
                  )
                } else {
                  return rejectedBody(
                    run reject(
                      &resolver.*,
                      &module,
                      RejectionCode.Unsupported,
                      Module.span(hir, parameterId),
                    ),
                    move dependencies,
                  )
                }
              } else {
                return rejectedBody(
                  run reject(
                    &resolver.*,
                    &module,
                    RejectionCode.Unsupported,
                    Module.span(hir, parameterId),
                  ),
                  move dependencies,
                )
              }
            } else {
              return rejectedBody(
                run reject(&resolver.*, &module, RejectionCode.Unsupported, headerSpan),
                move dependencies,
              )
            }
            at = at + usize.ONE
          }
          if let Node.Declaration {body, ..} = Module.node(hir, declaration.local) {
            if let Node.CallableBody {block} = Module.node(hir, body) {
              if block.present {
                if let Node.Block {..} = Module.node(hir, block.id) {
                  let mut nodes = Vector.make<BodyNode>()
                  let mut signatureDependencies = Vector.make<SignatureDependency>()
                  run Vector.append<SignatureDependency>(
                    &mut signatureDependencies,
                    SignatureDependency {declaration: run DeclarationId.copy(&declaration.identity)},
                  )
                  let mut requiredBodies = Vector.make<DeclarationId>()
                  let checked = run checkBlock(
                    &resolver.*,
                    &module,
                    hir,
                    &mut locals,
                    Vector.asSlice<ResolvedAnnotation>(&annotations),
                    Vector.asSlice<ResolvedCall>(&resolvedCalls),
                    &mut nodes,
                    &mut signatureDependencies,
                    &mut requiredBodies,
                    block.id,
                    &resultType,
                  )
                  let control = match move checked {
                    Result<CheckedControl, Shared<Rejection>>.Success {value} => value
                    Result<CheckedControl, Shared<Rejection>>.Failure {error} => {
                      return rejectedBody(move error, move dependencies)
                    }
                  }
                  if control.canComplete && Shared.with<Type, usize>(&resultType, scalarCode) != 1 {
                    let mut returnSpan = Module.span(hir, block.id)
                    if Module.causeRange(hir, block.id).length == usize.ZERO && returnSpan.end > returnSpan.start {
                      returnSpan = Span.make(returnSpan.end - usize.ONE, returnSpan.end)
                    }
                    return rejectedBody(
                      run reject(&resolver.*, &module, RejectionCode.MissingReturn, returnSpan),
                      move dependencies,
                    )
                  }
                  let body = run TypedBody.make(
                    indexed,
                    key.declaration,
                    move locals,
                    move nodes,
                    control.node,
                    move signatureDependencies,
                    move requiredBodies,
                  )
                  return Answer {
                    outcome: Outcome.Success {
                      value: Value.Body {
                        body: run Shared.make<TypedBody>(move body),
                        source: run Shared.make<Observation>(
                          run Observation.copy(IndexedSource.sourceObservation(indexed)),
                        ),
                      },
                    },
                    dependencies: move dependencies,
                    sources: Vector.make<Shared<Observation>>(),
                    footprint: Vector.make<Shared<DemandFootprint>>(),
                    answerId: usize.ZERO,
                    identity: Option.none<Shared<Value>>(),
                    bodyEvidence: Option.none<Shared<BodyEvidence>>(),
                  }
                }
              }
            }
          }
        }
      }
      return rejectedBody(
        run reject(&resolver.*, &module, RejectionCode.Unsupported, headerSpan),
        move dependencies,
      )
    }
  }
  return rejectedBody(
    run reject(&resolver.*, &module, RejectionCode.Unsupported, Span.make(usize.ZERO, usize.ZERO)),
    move dependencies,
  )
}

fn hasRejection(answer: &Result<Answer, NoRejection>) -> bool {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Rejected {diagnostic: _} => true
      Outcome.Success {value: _} => false
    }
    Result<Answer, NoRejection>.Failure {error: _} => false
  }
}

effect fn rejectRoot(
  resolver: &mut Resolver,
  module: &ModuleId,
  bucket: Key,
  code: RejectionCode,
  span: Span,
) -> Shared<Result<Answer, NoRejection>> ! Cycle | OutOfMemoryError ? &mut Allocator {
  let mut dependencies = Vector.make<Dependency>()
  run Vector.append<Dependency>(&mut dependencies, run dependency(&mut resolver.*, bucket))
  let mut sources = Vector.make<Shared<Observation>>()
  run Vector.append<Shared<Observation>>(
    &mut sources,
    run Shared.make<Observation>(run SourceIndex.captureObservation(&resolver.source, module)),
  )
  let diagnostic = run reject(&resolver.*, module, code, span)
  return run Shared.make<Result<Answer, NoRejection>>(
    Result.succeed<Answer, NoRejection>(
      Answer {
        outcome: Outcome.Rejected {diagnostic: move diagnostic},
        dependencies: move dependencies,
        sources: move sources,
        footprint: Vector.make<Shared<DemandFootprint>>(),
        answerId: usize.ZERO,
        identity: Option.none<Shared<Value>>(),
        bodyEvidence: Option.none<Shared<BodyEvidence>>(),
      },
    ),
  )
}

effect fn demandNamed(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  module: &ModuleId,
  name: &[u8],
  family: Family,
) -> Shared<Result<Answer, NoRejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let moduleOrdinal = run internModule(&mut resolver.*, module)
  let nameOrdinal = run internName(&mut resolver.*, name)
  let bucketKey = Key {
    family: Family.Name,
    module: moduleOrdinal,
    name: nameOrdinal,
    declaration: usize.ZERO,
    member: usize.ZERO,
    external: false,
  }
  let observed = run demandRaw(
    &mut resolver.*,
    &mut owner.*,
    bucketKey,
    Span.make(usize.ZERO, usize.ZERO),
  )
  if Shared.with<Result<Answer, NoRejection>, bool>(&observed, hasRejection) {
    return move observed
  }
  drop observed
  let selected = run select(&mut resolver.*, module, name, false)
  if selected.count != usize.ONE {
    let mut code = RejectionCode.Collision
    if selected.count == usize.ZERO {
      code = RejectionCode.UnknownName
    }
    return run rejectRoot(&mut resolver.*, module, bucketKey, code, selected.span)
  }
  if selected.kind != CandidateKind.Declaration {
    return run rejectRoot(
      &mut resolver.*,
      module,
      bucketKey,
      RejectionCode.Unsupported,
      selected.span,
    )
  }
  let key = Key {
    family: family,
    module: moduleOrdinal,
    name: usize.ZERO,
    declaration: selected.declaration,
    member: usize.ZERO,
    external: false,
  }
  return run demandRaw(&mut resolver.*, &mut owner.*, key, selected.span)
}

impl Semantic {
  /// Creates a lazy semantic store for one held in-memory source revision.
  pub fn make(revision: Revision) -> Semantic {
    return Semantic {
      resolver: Resolver {
        source: SourceIndex.make(move revision),
        modules: Vector.make<ModuleId>(),
        names: Vector.make<Bytes>(),
        applications: Vector.make<Shared<Type>>(),
        keys: Vector.make<Key>(),
        active: Vector.make<Word>(),
        frames: Vector.make<SourceFrame>(),
        events: Vector.make<Event>(),
        nextAnswerId: usize.ONE,
      },
      query: Query.make<Word, Answer, NoRejection>(),
    }
  }
  /// Selects a new immutable source revision and validates completed facts on their next demand.
  ///
  /// # Details
  ///
  /// Exact source observations keep unchanged answers reusable. A checked body can keep its typed
  /// payload across another declaration's edit after its own inputs and child results validate.
  /// Changed source positions or incomplete evidence force a new body check.
  pub fn revise(self: &mut Self, revision: Revision) -> () {
    SourceIndex.revise(&mut self.resolver.source, move revision)
    return ()
  }
  /// Borrows the semantic query lifecycle events in demand order.
  pub fn eventLog(self: &Self) -> &[Event] {
    return Vector.asSlice<Event>(&self.resolver.events)
  }
  /// Borrows source reads and complete positive or negative name observations.
  pub fn sourceEvents(self: &Self) -> &[SourceEvent] {
    return SourceIndex.eventLog(&self.resolver.source)
  }
  /// Returns a complete name bucket, including an empty bucket, without resolving imports or types.
  /// Returns an anchored `MissingModule` rejection if the source path is absent.
  pub effect fn demandName(self: &mut Self, request: &mut Request, module: &ModuleId, name: &[u8]) -> Shared<
    Result<Answer, NoRejection>,
  > ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
    let moduleOrdinal = run internModule(&mut self.resolver, module)
    let nameOrdinal = run internName(&mut self.resolver, name)
    let key = Key {
      family: Family.Name,
      module: moduleOrdinal,
      name: nameOrdinal,
      declaration: usize.ZERO,
      member: usize.ZERO,
      external: false,
    }
    let answer = run demandRaw(
      &mut self.resolver,
      &mut self.query,
      key,
      Span.make(usize.ZERO, usize.ZERO),
    )
    run recordRoot(&mut request.*, Family.Name, module, name, &answer)
    return move answer
  }
  /// Resolves a nongeneric type alias only when the caller requests its target.
  /// Returns an anchored rejection for an absent name, unsupported target, or alias cycle.
  pub effect fn demandAlias(self: &mut Self, request: &mut Request, module: &ModuleId, name: &[u8]) -> Shared<
    Result<Answer, NoRejection>,
  > ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
    let answer = run demandNamed(&mut self.resolver, &mut self.query, module, name, Family.Alias)
    run recordRoot(&mut request.*, Family.Alias, module, name, &answer)
    return move answer
  }
  /// Returns a nongeneric nominal identity without resolving fields, members, or layout.
  /// Returns an anchored rejection if the name does not identify a supported nominal declaration.
  pub effect fn demandIdentity(
    self: &mut Self,
    request: &mut Request,
    module: &ModuleId,
    name: &[u8],
  ) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator {
    let answer = run demandNamed(&mut self.resolver, &mut self.query, module, name, Family.Identity)
    run recordRoot(&mut request.*, Family.Identity, module, name, &answer)
    return move answer
  }
  /// Enumerates the written fields, tuple positions, enum cases, or union variants of a nominal.
  /// Member types and target layout remain undemanded.
  pub effect fn demandMembers(
    self: &mut Self,
    request: &mut Request,
    module: &ModuleId,
    name: &[u8],
  ) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator {
    let answer = run demandNamed(&mut self.resolver, &mut self.query, module, name, Family.Members)
    run recordRoot(&mut request.*, Family.Members, module, name, &answer)
    return move answer
  }
  /// Resolves only one member's written types under a canonical nominal application.
  /// A struct field or tuple position has one type; a union variant has its ordered payload
  /// types; a scalar enum case has none. The member is selected by its enumeration ordinal.
  pub effect fn demandMemberShape(
    self: &mut Self,
    request: &mut Request,
    module: &ModuleId,
    name: &[u8],
    member: usize,
    application: &Shared<Type>,
  ) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator {
    let moduleOrdinal = run internModule(&mut self.resolver, module)
    let nameOrdinal = run internName(&mut self.resolver, name)
    let bucketKey = Key {
      family: Family.Name,
      module: moduleOrdinal,
      name: nameOrdinal,
      declaration: usize.ZERO,
      member: usize.ZERO,
      external: false,
    }
    let observed = run demandRaw(
      &mut self.resolver,
      &mut self.query,
      bucketKey,
      Span.make(usize.ZERO, usize.ZERO),
    )
    if Shared.with<Result<Answer, NoRejection>, bool>(&observed, hasRejection) {
      run recordRoot(&mut request.*, Family.MemberShape, module, name, &observed)
      return move observed
    }
    drop observed
    let selected = run select(&mut self.resolver, module, name, false)
    if selected.count != usize.ONE || selected.kind != CandidateKind.Declaration {
      let mut code = RejectionCode.Collision
      if selected.count == usize.ZERO {
        code = RejectionCode.UnknownName
      } else if selected.kind != CandidateKind.Declaration {
        code = RejectionCode.NotType
      }
      let rejected = run rejectRoot(&mut self.resolver, module, bucketKey, code, selected.span)
      run recordRoot(&mut request.*, Family.MemberShape, module, name, &rejected)
      return move rejected
    }
    let applicationOrdinal = run internApplication(&mut self.resolver, application)
    let key = Key {
      family: Family.MemberShape,
      module: moduleOrdinal,
      name: applicationOrdinal,
      declaration: selected.declaration,
      member: member,
      external: false,
    }
    let answer = run demandRaw(&mut self.resolver, &mut self.query, key, selected.span)
    run recordRoot(&mut request.*, Family.MemberShape, module, name, &answer)
    return move answer
  }
  /// Resolves the binders and declared bounds of a type, alias, interface, or service declaration.
  ///
  /// # Details
  ///
  /// This does not demand the declaration's identity or members, and it proves no bound; an
  /// application of a bounded declaration is rejected as unsupported where it is written.
  pub effect fn demandContract(
    self: &mut Self,
    request: &mut Request,
    module: &ModuleId,
    name: &[u8],
  ) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator {
    let answer = run demandNamed(&mut self.resolver, &mut self.query, module, name, Family.Contract)
    run recordRoot(&mut request.*, Family.Contract, module, name, &answer)
    return move answer
  }
  /// Enumerates an interface's or service's operation declarations in written order.
  ///
  /// # Details
  ///
  /// Only member headers are read; no operation signature is resolved. A field, an operation body,
  /// a visibility modifier on an operation, or another non-operation member rejects with
  /// `InvalidContractMember`, and a repeated operation name rejects at the later operation.
  pub effect fn demandOperations(
    self: &mut Self,
    request: &mut Request,
    module: &ModuleId,
    name: &[u8],
  ) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator {
    let answer = run demandNamed(
      &mut self.resolver,
      &mut self.query,
      module,
      name,
      Family.Operations,
    )
    run recordRoot(&mut request.*, Family.Operations, module, name, &answer)
    return move answer
  }
  /// Resolves the written signature of one interface or service operation without reading a body.
  ///
  /// # Details
  ///
  /// The operation resolves under its contract's binders and implicit `Self` provider, while its
  /// own binders keep the operation's identity. The contract's operation list is demanded first,
  /// so an invalid member list rejects here too. An absent operation rejects with `UnknownMember`.
  pub effect fn demandOperation(
    self: &mut Self,
    request: &mut Request,
    module: &ModuleId,
    contract: &[u8],
    operation: &[u8],
  ) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator {
    let listed = run demandNamed(
      &mut self.resolver,
      &mut self.query,
      module,
      contract,
      Family.Operations,
    )
    if Shared.with<Result<Answer, NoRejection>, bool>(&listed, hasRejection) {
      run recordRoot(&mut request.*, Family.Signature, module, operation, &listed)
      return move listed
    }
    drop listed
    let selected = run select(&mut self.resolver, module, contract, false)
    let lookup = run memberOrdinal(&mut self.resolver, module, selected.declaration, operation)
    if let Option<usize>.Some {value: ordinal} = move lookup.ordinal {
      let key = Key {
        family: Family.Signature,
        module: run internModule(&mut self.resolver, module),
        name: usize.ZERO,
        declaration: ordinal,
        member: usize.ZERO,
        external: false,
      }
      let answer = run demandRaw(&mut self.resolver, &mut self.query, key, selected.span)
      run recordRoot(&mut request.*, Family.Signature, module, operation, &answer)
      return move answer
    }
    // The contract's name is the nearest written anchor for an absent operation.
    let absent = run rejectAbsent(&mut self.resolver, module, selected.span)
    run recordRoot(&mut request.*, Family.Signature, module, operation, &absent)
    return move absent
  }
  /// Resolves the heads of every top-level conformance and sealed-property `impl` in one module, in
  /// written order.
  ///
  /// # Details
  ///
  /// Each head is the implementation's binders, including lifetimes elided from its heads, with
  /// its applied contract and provider. Only header names and applications are resolved; no member
  /// or body is read. An empty list observes that the module declares none. One rejected head
  /// rejects the list, because the module's membership is then unknown. Inherent `impl`s are
  /// reached through their owner with `demandInherentMembers`.
  pub effect fn demandImplementations(self: &mut Self, request: &mut Request, module: &ModuleId) -> Shared<
    Result<Answer, NoRejection>,
  > ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
    let key = Key {
      family: Family.Implementations,
      module: run internModule(&mut self.resolver, module),
      name: usize.ZERO,
      declaration: usize.ZERO,
      member: usize.ZERO,
      external: false,
    }
    let answer = run demandRaw(
      &mut self.resolver,
      &mut self.query,
      key,
      Span.make(usize.ZERO, usize.ZERO),
    )
    run recordRoot(&mut request.*, Family.Implementations, module, b"", &answer)
    return move answer
  }
  /// Enumerates the inherent members an owner publishes across its module's inherent `impl`s.
  ///
  /// # Details
  ///
  /// Only the owner's module is read; a rejected head publishes no member. A member whose name
  /// repeats another member, or an owner field, variant, enum member, generated operation, or
  /// contract operation, is not published, and its anchored rejection is kept; no winner is chosen
  /// by source order. Member signatures are not resolved.
  pub effect fn demandInherentMembers(
    self: &mut Self,
    request: &mut Request,
    module: &ModuleId,
    name: &[u8],
  ) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator {
    let answer = run demandNamed(
      &mut self.resolver,
      &mut self.query,
      module,
      name,
      Family.InherentMembers,
    )
    run recordRoot(&mut request.*, Family.InherentMembers, module, name, &answer)
    return move answer
  }
  /// Resolves the signature of `member`, an inherent member of the owner declaration `owner`.
  ///
  /// # Details
  ///
  /// The owner's published members decide the answer. A member that repeats another member's name
  /// or claims an owner item's name returns its kept rejection; no winner is chosen by source
  /// order. A member of a rejected inherent head is not published. An absent member rejects with
  /// `UnknownMember`.
  pub effect fn demandInherentMember(
    self: &mut Self,
    request: &mut Request,
    module: &ModuleId,
    owner: &[u8],
    member: &[u8],
  ) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator {
    let listed = run demandNamed(
      &mut self.resolver,
      &mut self.query,
      module,
      owner,
      Family.InherentMembers,
    )
    if Shared.with<Result<Answer, NoRejection>, bool>(&listed, hasRejection) {
      run recordRoot(&mut request.*, Family.Signature, module, member, &listed)
      return move listed
    }
    let lookup = Shared.with<Result<Answer, NoRejection>, InherentLookup>(
      &listed,
      fn(answer: &Result<Answer, NoRejection>) -> InherentLookup {
        return inherentLookup(answer, member)
      },
    )
    drop listed
    let InherentLookup {published, rejected} = move lookup
    if let Option<Shared<DeclarationId>>.Some {value: declaration} = move published {
      let found = run ordinalOfIdentity(&mut self.resolver, module, &declaration)
      if let Option<usize>.Some {value: ordinal} = move found {
        let key = Key {
          family: Family.Signature,
          module: run internModule(&mut self.resolver, module),
          name: usize.ZERO,
          declaration: ordinal,
          member: usize.ZERO,
          external: false,
        }
        let answer = run demandRaw(
          &mut self.resolver,
          &mut self.query,
          key,
          Span.make(usize.ZERO, usize.ZERO),
        )
        run recordRoot(&mut request.*, Family.Signature, module, member, &answer)
        return move answer
      }
    }
    if let Option<Shared<Rejection>>.Some {value: diagnostic} = move rejected {
      let kept = run rootRejection(&mut self.resolver, module, move diagnostic)
      run recordRoot(&mut request.*, Family.Signature, module, member, &kept)
      return move kept
    }
    // The owner's name is the nearest written anchor for an absent member.
    let selected = run select(&mut self.resolver, module, owner, false)
    let absent = run rejectAbsent(&mut self.resolver, module, selected.span)
    run recordRoot(&mut request.*, Family.Signature, module, member, &absent)
    return move absent
  }
  /// Resolves the signature of the function `member` declared in a module's `occurrence`th
  /// top-level `impl`, under that implementation's binders with `Self` as its applied provider.
  ///
  /// # Details
  ///
  /// A name declared twice in that `impl` rejects with `Collision` rather than choosing either. A
  /// rejected head rejects its members with the head's diagnostic. Owner-wide inherent uniqueness
  /// is decided by `demandInherentMember`.
  pub effect fn demandImplementationMember(
    self: &mut Self,
    request: &mut Request,
    module: &ModuleId,
    occurrence: usize,
    member: &[u8],
  ) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator {
    let moduleOrdinal = run internModule(&mut self.resolver, module)
    let implementation = run implementationOrdinal(&mut self.resolver, module, occurrence)
    if let Option<usize>.Some {value: parent} = move implementation {
      let lookup = run memberOrdinal(&mut self.resolver, module, parent, member)
      if let Option<Span>.Some {value: span} = move lookup.repeated {
        let diagnostic = run reject(&self.resolver, module, RejectionCode.Collision, span)
        let repeated = run rootRejection(&mut self.resolver, module, move diagnostic)
        run recordRoot(&mut request.*, Family.Signature, module, member, &repeated)
        return move repeated
      }
      if let Option<usize>.Some {value: ordinal} = move lookup.ordinal {
        let key = Key {
          family: Family.Signature,
          module: moduleOrdinal,
          name: usize.ZERO,
          declaration: ordinal,
          member: usize.ZERO,
          external: false,
        }
        let answer = run demandRaw(
          &mut self.resolver,
          &mut self.query,
          key,
          Span.make(usize.ZERO, usize.ZERO),
        )
        run recordRoot(&mut request.*, Family.Signature, module, member, &answer)
        return move answer
      }
    }
    let absent = run rejectAbsent(&mut self.resolver, module, Span.make(usize.ZERO, usize.ZERO))
    run recordRoot(&mut request.*, Family.Signature, module, member, &absent)
    return move absent
  }
  /// Resolves a function's written parameter and result types without reading its body.
  /// Returns an anchored rejection for an unsupported header or referenced type.
  pub effect fn demandSignature(
    self: &mut Self,
    request: &mut Request,
    module: &ModuleId,
    name: &[u8],
  ) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator {
    let answer = run demandNamed(
      &mut self.resolver,
      &mut self.query,
      module,
      name,
      Family.Signature,
    )
    run recordRoot(&mut request.*, Family.Signature, module, name, &answer)
    return move answer
  }
  /// Resolves a constant's written type without reading its initializer.
  ///
  /// # Details
  ///
  /// The type is one primitive scalar or `string`, whose omitted lifetime is `'static`. Any other
  /// type is an anchored `InvalidConstant` rejection.
  pub effect fn demandConstant(
    self: &mut Self,
    request: &mut Request,
    module: &ModuleId,
    name: &[u8],
  ) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator {
    let answer = run demandNamed(&mut self.resolver, &mut self.query, module, name, Family.Constant)
    run recordRoot(&mut request.*, Family.Constant, module, name, &answer)
    return move answer
  }
  /// Publishes a constant's value when its initializer needs no static execution.
  ///
  /// # Details
  ///
  /// The value demand first demands the constant's type. An exact Boolean or fixed-width integer
  /// literal is the value. A bare name of another constant demands that constant's type, then its
  /// value, so a repeated initializer path is a `Cycle` rejection while both types stay available.
  ///
  /// # Gotchas
  ///
  /// Every other initializer, including a pointer-sized integer, floating-point, text, call, or
  /// operator, is an anchored `Unsupported` rejection rather than a provisional value.
  pub effect fn demandInitializer(
    self: &mut Self,
    request: &mut Request,
    module: &ModuleId,
    name: &[u8],
  ) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator {
    let answer = run demandNamed(
      &mut self.resolver,
      &mut self.query,
      module,
      name,
      Family.Initializer,
    )
    run recordRoot(&mut request.*, Family.Initializer, module, name, &answer)
    return move answer
  }
  /// Checks one demanded ordinary function body with fixed-width integer, Boolean, or unit types.
  ///
  /// # Details
  ///
  /// The body accepts exact literals, immutable locals, full direct calls, returns, and unit
  /// fallthrough. A direct call reads the callee signature and records its required runtime body.
  /// It does not check the callee body. A completed answer replays its current source and
  /// signature evidence into each request that demands it. A validated body reuse records a
  /// `Reuse` event after the query starts; it does not record a cache hit.
  ///
  /// # Gotchas
  ///
  /// An unsupported expression or statement produces an anchored rejection. A checked body does
  /// not execute the function or prove that all functions in a program are valid.
  pub effect fn demandBody(self: &mut Self, request: &mut Request, module: &ModuleId, name: &[u8]) -> Shared<
    Result<Answer, NoRejection>,
  > ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
    let answer = run demandNamed(&mut self.resolver, &mut self.query, module, name, Family.Body)
    run recordRoot(&mut request.*, Family.Body, module, name, &answer)
    return move answer
  }
}
