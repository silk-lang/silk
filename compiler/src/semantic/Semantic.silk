  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
    run selectRequest(&mut self.resolver, &request.*)
    let answer = run demandNamed(
      &mut self.resolver,
      &mut self.query,
      module,
      name,
      Family.Signature,
    )
    run recordRoot(&mut request.*, Family.Signature, module, name, &answer)
    return move answer
  }
  /// Resolves a constant's written type without reading its initializer.
  ///
  /// # Details
  ///
  /// The type is one primitive scalar or `string`, whose omitted lifetime is `'static`. Any other
  /// type is an anchored `InvalidConstant` rejection.
  pub effect fn demandConstant(
    self: &mut Self,
    request: &mut Request,
    module: &ModuleId,
    name: &[u8],
  ) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
    run selectRequest(&mut self.resolver, &request.*)
    let answer = run demandNamed(&mut self.resolver, &mut self.query, module, name, Family.Constant)
    run recordRoot(&mut request.*, Family.Constant, module, name, &answer)
    return move answer
  }
  /// Resolves one registered package parameter's header without evaluating its default.
  pub effect fn demandParameterSchema(
    self: &mut Self,
    request: &mut Request,
    module: &ModuleId,
    name: &[u8],
  ) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
    run selectRequest(&mut self.resolver, &request.*)
    if !Request.hasRegisteredSchemaModule(&request.*, module) {
      let diagnostic = run reject(
        &self.resolver,
        module,
        RejectionCode.UnregisteredParameter,
        Span.make(usize.ZERO, usize.ZERO),
      )
      let answer = run rootRejection(&mut self.resolver, module, move diagnostic)
      run recordRoot(&mut request.*, Family.ParameterSchema, module, name, &answer)
      return move answer
    }
    let conditional = run conditionalParameterSpan(&mut self.resolver, module, name)
    if let Option<Span>.Some {value: span} = move conditional {
      let diagnostic = run reject(&self.resolver, module, RejectionCode.ConditionalParameter, span)
      let answer = run rootRejection(&mut self.resolver, module, move diagnostic)
      run recordRoot(&mut request.*, Family.ParameterSchema, module, name, &answer)
      return move answer
    }
    let answer = run demandNamed(
      &mut self.resolver,
      &mut self.query,
      module,
      name,
      Family.ParameterSchema,
    )
    run recordRoot(&mut request.*, Family.ParameterSchema, module, name, &answer)
    return move answer
  }
  /// Evaluates one registered parameter's exact source default through the held static machine.
  pub effect fn demandParameterDefault(
    self: &mut Self,
    request: &mut Request,
    identity: &DeclarationId,
  ) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
    run selectRequest(&mut self.resolver, &request.*)
    let module = DeclarationId.moduleId(identity)
    let spelled = run DeclarationId.copySpelling(identity)
    let name = Bytes.asSlice(&spelled)
    if !Request.hasRegisteredSchemaModule(&request.*, module) {
      let diagnostic = run reject(&self.resolver, module, RejectionCode.UnregisteredParameter, Span.make(usize.ZERO, usize.ZERO))
      let answer = run rootRejection(&mut self.resolver, module, move diagnostic)
      run recordRoot(&mut request.*, Family.ParameterDefault, module, name, &answer)
      return move answer
    }
    let moduleOrdinal = run internModule(&mut self.resolver, module)
    let owned = run Shared<DeclarationId>.make(DeclarationId.copy(identity))
    let found = run ordinalOfIdentity(&mut self.resolver, module, &owned)
    let ordinal = match move found {
      Option<usize>.Some {value} => value
      Option<usize>.None => {
        let absent = run rejectAbsent(&mut self.resolver, module, Span.make(usize.ZERO, usize.ZERO), RejectionCode.IdentityUnavailable)
        run recordRoot(&mut request.*, Family.ParameterDefault, module, name, &absent)
        return move absent
      }
    }
    let declarationAccess265Request = Key {
      family: Family.ParameterDefault, module: moduleOrdinal, name: usize.ZERO,
      declaration: ordinal, member: usize.ZERO, external: false,
    }
    let declarationAccess265 = run internDeclaration(&mut self.resolver, declarationAccess265Request)
    let key = declarationAccess265
    let answer = run demandRaw(&mut self.resolver, &mut self.query, key, Span.make(usize.ZERO, usize.ZERO))
    run recordRoot(&mut request.*, Family.ParameterDefault, module, name, &answer)
    return move answer
  }
  /// Projects a retained parameter location through its declaration in the current source.
  /// A successful default whose declaration is gone belongs to an obsolete revision.
  pub effect fn parameterSpan(self: &mut Self, identity: &DeclarationId, location: Location) -> Span
  ! Cycle | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
    if let Option<Anchor>.Some {value: anchor} = move run declarationAnchor(&mut self.resolver, identity) {
      return Anchor.span(&anchor, location)
    }
    fail RevisionMismatch {}
  }
  /// Demands every parameter header in each explicitly registered source module.
  /// Imports alone never add schemas. Registered modules are visited in canonical order.
  pub effect fn demandRegisteredParameters(self: &mut Self, request: &mut Request) -> Result<
    Vector<RegisteredParameter>,
    Shared<Rejection>,
  > ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
    let mut results = Vector<RegisteredParameter>.make()
    let mut moduleAt = usize.ZERO
    while moduleAt < Request.registeredSchemaModules(&request.*).length {
      let selected = Request.registeredSchemaModules(&request.*)
      let module = ModuleId.copy(&selected[moduleAt])
      let loaded = run namespaceSource(&mut self.resolver, &module)
      // Existing non-parameter declarations can become parameters without adding a name.
      run recordEnumerationHeaders(&mut self.resolver, &module, &loaded)
      let mut names = Vector<RegisteredName>.make()
      if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(
        &self.resolver,
        &loaded,
        &module,
      ) {
        let hir = IndexedSource.authored(indexed)
        let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(indexed))
        let mut at = usize.ZERO
        while at < declarations.length {
          let topLevel = match & declarations[at].parent {
            Option<usize>.None => true
            Option<usize>.Some {value: _} => false
          }
          if topLevel && DeclarationId.kind(&declarations[at].identity) == OwnerKind.PackageParameter {
            if let Node.PackageParameterHeader {name, ..} = Module.node(
              hir,
              declarations[at].header,
            ) {
              if let Node.Name {text} = Module.node(hir, name) {
                run Vector<RegisteredName>.append(&mut names, RegisteredName {
                  name: run Bytes.copy(Module.text(hir, text)),
                  identity: DeclarationId.copy(&declarations[at].identity),
                })
              }
            }
          }
          at = at + usize.ONE
        }
      } else {
        return Result<Vector<RegisteredParameter>, Shared<Rejection>>.failResult(
          run reject(
            &self.resolver,
            &module,
            RejectionCode.MissingModule,
            Span.make(usize.ZERO, usize.ZERO),
          ),
        )
      }
      while Vector<RegisteredName>.length(&names) > usize.ZERO {
        let listed = Vector<RegisteredName>.remove(&mut names, usize.ZERO)
        let answer = run Semantic.demandParameterSchema(
          &mut self.*, &mut request.*, &module, Bytes.asSlice(&listed.name),
        )
        run Vector<RegisteredParameter>.append(&mut results, RegisteredParameter {
          module: ModuleId.copy(&module),
          name: move listed.name,
          identity: move listed.identity,
          answer: move answer,
        })
      }
      moduleAt = moduleAt + usize.ONE
    }
    return Result<Vector<RegisteredParameter>, Shared<Rejection>>.succeed(move results)
  }
  /// Publishes a constant's value when its initializer needs no static execution.
  ///
  /// # Details
  ///
  /// The value demand first demands the constant's type. An exact Boolean or integer literal
  /// within its selected target range is the value. A bare name of another constant demands that
  /// constant's type, then its value, so a repeated initializer path is a `Cycle` rejection while
  /// both types stay available.
  ///
  /// # Gotchas
  ///
  /// Every other initializer, including floating-point, text, call, or operator, is an anchored
  /// `Unsupported` rejection rather than a provisional value.
  pub effect fn demandInitializer(
    self: &mut Self,
    request: &mut Request,
    module: &ModuleId,
    name: &[u8],
  ) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
    run selectRequest(&mut self.resolver, &request.*)
    let answer = run demandNamed(
      &mut self.resolver,
      &mut self.query,
      module,
      name,
      Family.Initializer,
    )
    run recordRoot(&mut request.*, Family.Initializer, module, name, &answer)
    return move answer
  }
  /// Types one demanded ordinary function body against its written signature.
  ///
  /// # Details
  ///
  /// Scalar bodies retain the existing fully checked result. A generic body is typed once with
  /// symbolic parameters; its `TypedBody.Stage.ContractTyped` result retains safety obligations
  /// for later ownership, lifetime, cleanup, and Effect checking. A direct ordinary call reads
  /// the callee signature and records its required runtime body without checking that body.
  /// Completed answers replay current source and signature evidence into each request.
  ///
  /// # Gotchas
  ///
  /// An unsupported expression or statement produces an anchored rejection. Contract typing does
  /// not establish executable readiness or full body safety.
  pub effect fn demandBody(self: &mut Self, request: &mut Request, module: &ModuleId, name: &[u8]) -> Shared<
    Result<Answer, NoRejection>,
  > ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
    run selectRequest(&mut self.resolver, &request.*)
    let answer = run demandNamed(&mut self.resolver, &mut self.query, module, name, Family.Body)
    run recordRoot(&mut request.*, Family.Body, module, name, &answer)
    return move answer
  }
  /// The anchor a typed body's origins count from in the store's current source; absent when the
  /// body's declaration is gone. A body and its MIR keep positions relative to it, so reading
  /// one back as source text depends on where the declaration is now (incremental v2 §3.5).
  pub effect fn bodyAnchor(self: &mut Self, body: &Shared<TypedBody>) -> Option<Anchor> ! Cycle | OutOfMemoryError ? &mut Allocator {
    let declaration = Shared<TypedBody>.with<DeclarationId>(body, fn(checked: &TypedBody) -> DeclarationId {
      return DeclarationId.copy(TypedBody.declarationId(checked))
    })
    return run declarationAnchor(&mut self.resolver, &declaration)
  }
  /// The anchor an instance's MIR origins count from; drop glue has none.
  pub effect fn mirAnchor(self: &mut Self, instance: &InstanceKey) -> Option<Anchor> ! Cycle | OutOfMemoryError ? &mut Allocator {
    return run instanceAnchor(&mut self.resolver, instance)
  }
  /// Types one exact authored function/operation through the same identity gates as SignatureOf.
  /// Unsupported and rejection answers remain their actual discriminants; no-body syntax never
  /// gains a fabricated checked body. This is ordinary abstract Body, not selected executable MIR.
  pub effect fn demandBodyOf(self: &mut Self, request: &mut Request, declaration: &DeclarationId) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
    run selectRequest(&mut self.resolver, &request.*)
    let module = DeclarationId.moduleId(declaration)
    let identity = run Shared<DeclarationId>.make(DeclarationId.copy(declaration))
    let found = run ordinalOfIdentity(&mut self.resolver, module, &identity)
    let span = Span.make(usize.ZERO, usize.ZERO)
    let answer = match move found {
      Option<usize>.None => run rejectAbsent(&mut self.resolver, module, span, RejectionCode.IdentityUnavailable)
      Option<usize>.Some {value: ordinal} => run requestMemberBody(
        &mut self.resolver, &mut self.query, &mut request.*, module, ordinal, span)
    }
    let spelled = run DeclarationId.copySpelling(declaration)
    run recordRoot(&mut request.*, Family.Body, module, Bytes.asSlice(&spelled), &answer)
    return move answer
  }
  /// Demands the drop glue MIR of one type through the `Family.Mir` key the instance worklist
  /// interns for it. A type that mentions no declaration has no glue and answers `LayoutUnsupported`.
  pub effect fn demandGlueMir(self: &mut Self, request: &mut Request, ty: &Shared<Type>, sourceOwner: &DeclarationId) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
    run selectRequest(&mut self.resolver, &request.*)
    let span = Span.make(usize.ZERO, usize.ZERO)
    let glueResult = match move run InstanceKey.dropGlue(ty, sourceOwner) {
      Result<Option<InstanceKey>, CanonicalizationFailure>.Success {value: canonicalGlue} => move canonicalGlue
      Result<Option<InstanceKey>, CanonicalizationFailure>.Failure {..} => {
        return run Shared<Result<Answer, NoRejection>>.make(Result<Answer, NoRejection>.succeed(memberRejected(
          run canonicalRejection(&mut self.resolver, sourceOwner, span), Vector<Dependency>.make())))
      }
    }
    let instance = match move glueResult {
      Option<InstanceKey>.Some {value} => move value
      Option<InstanceKey>.None => {
        return run Shared<Result<Answer, NoRejection>>.make(Result<Answer, NoRejection>.succeed(memberSuccess(Value.LayoutUnsupported, Vector<Dependency>.make())))
      }
    }
    let identity = InstanceKey.identity(&instance)
    let owner = DeclarationId.copyShared(&identity)
    let module = ModuleId.copy(DeclarationId.moduleId(&owner))
    let location = match move run locationOfInstance(&mut self.resolver, &instance) {
      Option<InstanceLocation>.Some {value} => value
      Option<InstanceLocation>.None => {
        return run Shared<Result<Answer, NoRejection>>.make(Result<Answer, NoRejection>.succeed(memberRejected(
          run reject(&self.resolver, &module, RejectionCode.IdentityUnavailable, span), Vector<Dependency>.make())))
      }
    }
    let name = run internBackendInstance(&mut self.resolver, &instance, false)
    let declarationAccess266Request = Key {
      family: Family.Mir, module: location.module, name: name, declaration: location.declaration, member: instanceMember(&instance), external: false,
    }
    let declarationAccess266 = run internDeclaration(&mut self.resolver, declarationAccess266Request)
    let answer = run demandRaw(&mut self.resolver, &mut self.query, declarationAccess266, span)
    run recordRoot(&mut request.*, Family.Mir, &module, b"", &answer)
    return run anchorCanonicalAnswer(&mut self.resolver, &answer, sourceOwner, span)
  }
  /// Demands the MIR of one declaration's named instance for diagnostic sweeps. A declaration
  /// with open binders answers its open-instance gap. A declaration with requirements is lowered
  /// only under the providers its callers bind, so a sweep has no instance to demand: none.
  pub effect fn demandMirOf(self: &mut Self, request: &mut Request, declaration: &DeclarationId) -> Option<Shared<Result<Answer, NoRejection>>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
    let signature = run Semantic.demandSignatureOf(&mut self.*, &mut request.*, declaration)
    let requirements = run signatureRequirements(&signature)
    let provided = Shared<Row>.with<bool>(&requirements, fn(row: &Row) -> bool {
      return Vector<Requirement>.length(&row.entries) > usize.ZERO || Vector<RowParameter>.length(&row.parameters) > usize.ZERO
        || Vector<RowSubtraction>.length(&row.subtractions) > usize.ZERO
    })
    if provided { return Option<Shared<Result<Answer, NoRejection>>>.none() }
    run selectRequest(&mut self.resolver, &request.*)
    let span = Span.make(usize.ZERO, usize.ZERO)
    let identity = run Shared<DeclarationId>.make(DeclarationId.copy(declaration))
    let instance = run InstanceKey.named(&identity)
    let module = ModuleId.copy(DeclarationId.moduleId(declaration))
    let location = match move run locationOfInstance(&mut self.resolver, &instance) {
      Option<InstanceLocation>.Some {value} => value
      Option<InstanceLocation>.None => {
        return Option<Shared<Result<Answer, NoRejection>>>.some(run Shared<Result<Answer, NoRejection>>.make(Result<Answer, NoRejection>.succeed(memberRejected(
          run reject(&self.resolver, &module, RejectionCode.IdentityUnavailable, span), Vector<Dependency>.make()))))
      }
    }
    let name = run internBackendInstance(&mut self.resolver, &instance, false)
    let declarationAccess267Request = Key {
      family: Family.Mir, module: location.module, name: name, declaration: location.declaration, member: instanceMember(&instance), external: false,
    }
    let declarationAccess267 = run internDeclaration(&mut self.resolver, declarationAccess267Request)
    let answer = run demandRaw(&mut self.resolver, &mut self.query, declarationAccess267, span)
    run recordRoot(&mut request.*, Family.Mir, &module, b"", &answer)
    return Option<Shared<Result<Answer, NoRejection>>>.some(move answer)
  }
  /// Demands MIR for one complete semantic environment before runtime identity can be reused.
  /// Header validation and admission precede the exact-application query cache; target callees
  /// remain body-lazy. The instance key numbers the application's caller regions canonically;
  /// `'static` and region sharing remain exact evidence even when emitted instructions coincide.
  pub effect fn demandApplicationMir(self: &mut Self, request: &mut Request, application: &Application) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
    let declaredModule = Application.bodyDeclaration(application)
    let module = ModuleId.copy(DeclarationId.moduleId(declaredModule))
    let span = Span.make(usize.ZERO, usize.ZERO)
    let checked = run Semantic.validateApplication(&mut self.*, &mut request.*, application, &module, span)
    let environment = match move checked {
      Result<Application, Shared<Rejection>>.Success {value} => move value
      Result<Application, Shared<Rejection>>.Failure {error} => {
        return run Shared<Result<Answer, NoRejection>>.make(Result<Answer, NoRejection>.succeed(memberRejected(move error, Vector<Dependency>.make())))
      }
    }
    let mut admission = Admission.make()
    let admitted = run Admission.enter(&mut admission, &environment, Edge.Direct)
    let open = match move admitted { Decision.Open => true _ => false }
    if open {
      let identity = run Shared<DeclarationId>.make(DeclarationId.copy(Application.bodyDeclaration(&environment)))
      return run Shared<Result<Answer, NoRejection>>.make(Result<Answer, NoRejection>.succeed(memberSuccess(
        Value.Unsupported {gap: run Shared<BackendGap>.make(BackendGap.make(GapCode.OpenInstance, &identity, span))}, Vector<Dependency>.make())))
    }
    // Every region pattern of an application shares one backend instance (IMPL-007), so a root
    // proves its own conformance bounds before reuse: a conformance head can accept one region
    // pattern and refuse another, and the answer must not depend on which was demanded first.
    let refused = run rootConformanceRefusal(&mut self.resolver, &mut self.query, &environment, &module, span)
    if let Option<Shared<Rejection>>.Some {value: diagnostic} = move refused {
      return run Shared<Result<Answer, NoRejection>>.make(Result<Answer, NoRejection>.succeed(memberRejected(move diagnostic,
        Vector<Dependency>.make())))
    }
    let instance = match move run InstanceKey.function(move environment) {
      Result<InstanceKey, CanonicalizationFailure>.Success {value: canonicalKey} => move canonicalKey
      Result<InstanceKey, CanonicalizationFailure>.Failure {..} => {
        return run Shared<Result<Answer, NoRejection>>.make(Result<Answer, NoRejection>.succeed(memberRejected(
          run canonicalRejection(&mut self.resolver, declaredModule, span), Vector<Dependency>.make())))
      }
    }
    let found = run locationOfInstance(&mut self.resolver, &instance)
    let location = match move found {
      Option<InstanceLocation>.Some {value} => value
      _ => { return CompilerBug.panic(b"MissingRetainedFact: demandApplicationMir") }
    }
    let name = run internBackendInstance(&mut self.resolver, &instance, false)
    let declarationAccess268Request = Key {
      family: Family.Mir, module: location.module, name: name, declaration: location.declaration, member: usize.ZERO, external: false,
    }
    let declarationAccess268 = run internDeclaration(&mut self.resolver, declarationAccess268Request)
    let answer = run demandRaw(&mut self.resolver, &mut self.query, declarationAccess268, span)
    run recordRoot(&mut request.*, Family.Mir, &module, b"", &answer)
    return run anchorCanonicalAnswer(&mut self.resolver, &answer, declaredModule, span)
  }
  /// Demands MIR for one exact reached instance, such as a call's callee key with its providers, for
  /// a program that does or does not observe diagnostics (failure observer note N1).
  /// `sourceOwner` and `span` identify the authentic requester, independently of a generated key.
  /// A zero span requests that actual owner's original header; it is never a published refusal.
  pub effect fn demandInstanceMir(self: &mut Self, request: &mut Request, instance: &InstanceKey, sourceOwner: &DeclarationId, span: Span, observing: bool) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
    let declared = DeclarationId.copyShared(&InstanceKey.identity(instance))
    let module = ModuleId.copy(DeclarationId.moduleId(&declared))
    let querySpan = Span.make(usize.ZERO, usize.ZERO)
    let location = match move run locationOfInstance(&mut self.resolver, instance) {
      Option<InstanceLocation>.Some {value} => value
      _ => { return run Shared<Result<Answer, NoRejection>>.make(Result<Answer, NoRejection>.succeed(memberRejected(
        run reject(&self.resolver, &module, RejectionCode.IdentityUnavailable, querySpan), Vector<Dependency>.make()))) }
    }
    let name = run internBackendInstance(&mut self.resolver, instance, observing)
    let declarationAccess269Request = Key {
      family: Family.Mir, module: location.module, name: name, declaration: location.declaration, member: instanceMember(instance), external: false,
    }
    let declarationAccess269 = run internDeclaration(&mut self.resolver, declarationAccess269Request)
    let answer = run demandRaw(&mut self.resolver, &mut self.query, declarationAccess269, querySpan)
    run recordRoot(&mut request.*, Family.Mir, &module, b"", &answer)
    return run anchorCanonicalAnswer(&mut self.resolver, &answer, sourceOwner, span)
  }
  /// Source-validates one instance and returns its immutable content-keyed LLVM answer.
  /// The source owner/span belong to its requester; generated instance identity is not source.
  /// A zero span asks for the actual requesting owner's authored header.
  pub effect fn demandInstanceText(
    self: &mut Self,
    request: &mut Request,
    instance: &InstanceKey,
    sourceOwner: &DeclarationId,
    span: Span,
    observing: bool,
  ) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
    run selectRequest(&mut self.resolver, &request.*)
    let declared = DeclarationId.copyShared(&InstanceKey.identity(instance))
    let module = ModuleId.copy(DeclarationId.moduleId(&declared))
    // The glue of a sealed core belongs to no source module.
    let sealed = SealedCore.declarationCore(&declared)
    if let Option<SealedKind>.None = move sealed { drop run internModule(&mut self.resolver, &module) }
    let querySpan = Span.make(usize.ZERO, usize.ZERO)
    let location = match move run locationOfInstance(&mut self.resolver, instance) {
      Option<InstanceLocation>.Some {value} => value
      _ => {
        return run Shared<Result<Answer, NoRejection>>.make(
          Result<Answer, NoRejection>.succeed(
            memberRejected(
              run reject(&self.resolver, &module, RejectionCode.IdentityUnavailable, querySpan),
              Vector<Dependency>.make(),
            ),
          ),
        )
      }
    }
    let name = run internBackendInstance(&mut self.resolver, instance, observing)
    let declarationAccess270Request = Key {
      family: Family.EmissionInputs,
      module: location.module,
      name: name,
      declaration: location.declaration,
      member: instanceMember(instance),
      external: false,
    }
    let declarationAccess270 = run internDeclaration(&mut self.resolver, declarationAccess270Request)
    let key = declarationAccess270
    let prepared = run demandRaw(&mut self.resolver, &mut self.query, key, querySpan)
    run recordRoot(&mut request.*, Family.EmissionInputs, &module, b"", &prepared)
    let answer = run demandPreparedText(&mut self.resolver, &mut self.query, key, &prepared)
    run recordRoot(&mut request.*, Family.LlvmText, &module, b"", &answer)
    return run anchorCanonicalAnswer(&mut self.resolver, &answer, sourceOwner, span)
  }
  /// Immutable definition arena; positions are published only by completed LLVM text queries.
  pub fn instanceTexts(self: &Self) -> &[InstanceDefinition] {
    return Vector<InstanceDefinition>.asSlice(&self.resolver.llvmValues)
  }
  /// Demands the selected residual body of one function under its complete semantic application.
  ///
  /// # Details
  /// The answer types only the residual its selection pass chose, with static results embedded.
  /// Equal semantic applications share one selected body; the declaration's abstract body is a
  /// different query and is never used for a function with static work.
  pub effect fn demandSelectedBody(self: &mut Self, request: &mut Request, application: &Application) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
    run selectRequest(&mut self.resolver, &request.*)
    let declared = Application.bodyDeclaration(application)
    let module = ModuleId.copy(DeclarationId.moduleId(declared))
    let moduleOrdinal = run internModule(&mut self.resolver, &module)
    let identity = run Shared<DeclarationId>.make(DeclarationId.copy(declared))
    let found = run ordinalOfIdentity(&mut self.resolver, &module, &identity)
    let ordinal = match move found {
      Option<usize>.Some {value} => value
      _ => {
        return run Shared<Result<Answer, NoRejection>>.make(Result<Answer, NoRejection>.succeed(memberRejected(
          run reject(&self.resolver, &module, RejectionCode.IdentityUnavailable, Span.make(usize.ZERO, usize.ZERO)), Vector<Dependency>.make())))
      }
    }
    let interned = run internSelectedApplication(&mut self.resolver, application)
    let declarationAccess271Request = Key {
      family: Family.Body, module: moduleOrdinal, name: usize.ZERO, declaration: ordinal, member: interned + usize.ONE, external: false,
    }
    let declarationAccess271 = run internDeclaration(&mut self.resolver, declarationAccess271Request)
    let answer = run demandRaw(&mut self.resolver, &mut self.query, declarationAccess271, Span.make(usize.ZERO, usize.ZERO))
    run recordRoot(&mut request.*, Family.Body, &module, b"", &answer)
    return move answer
  }
  /// Demands the backend-neutral body graph for one named function.
  pub effect fn demandMir(self: &mut Self, request: &mut Request, module: &ModuleId, name: &[u8]) -> Shared<
    Result<Answer, NoRejection>,
  > ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
    run selectRequest(&mut self.resolver, &request.*)
    let answer = run demandNamed(&mut self.resolver, &mut self.query, module, name, Family.Mir)
    run recordRoot(&mut request.*, Family.Mir, module, name, &answer)
    return move answer
  }
  /// Demands backend-neutral target layout facts for one runtime type.
  pub effect fn demandLayout(self: &mut Self, request: &mut Request, module: &ModuleId, ty: &Shared<Type>) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
    run selectRequest(&mut self.resolver, &request.*)
    let moduleOrdinal = run internModule(&mut self.resolver, module)
    let application = run internErasedType(&mut self.resolver, ty)
    let declarationAccess272Request = Key {
      family: Family.Layout, module: moduleOrdinal, name: application,
      declaration: usize.ZERO, member: usize.ZERO, external: false,
    }
    let declarationAccess272 = run internDeclaration(&mut self.resolver, declarationAccess272Request)
    let answer = run demandRaw(&mut self.resolver, &mut self.query, declarationAccess272, Span.make(usize.ZERO, usize.ZERO))
    run recordRoot(&mut request.*, Family.Layout, module, b"", &answer)
    return move answer
  }
  /// Returns an owned handle to one cached layout answer.
  pub fn layoutAt(self: &Self, index: usize) -> Option<Shared<BackendLayout>> {
    let layouts = Vector<Shared<BackendLayout>>.asSlice(&self.resolver.layoutValues)
    if index >= layouts.length { return Option<Shared<BackendLayout>>.none() }
    return Option<Shared<BackendLayout>>.some(Shared<BackendLayout>.clone(&layouts[index]))
  }
  /// Borrows a MIR graph named by a `Value.Mir` answer from this store.
  pub fn mirAt(self: &Self, index: usize) -> Option<&MirFunction> {
    let functions = Vector<MirFunction>.asSlice(&self.resolver.mirValues)
    if index >= functions.length {
      return Option<&MirFunction>.none()
    }
    return Option<&MirFunction>.some(&functions[index])
  }
  /// Builds a finite reachable-key closure rooted at one application, as a build does at a
  /// changing-static edge. Only certified evidence admits such a chain; `limit` bounds its nodes.
  /// The root is validated like any demanded application; its incoming edge is Direct in the
  /// root's module at the authentic original header, with no caller or ancestors.
  pub effect fn closeStaticChain(self: &mut Self, request: &mut Request, root: &Application, limit: usize) -> StaticClosure
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
    run selectRequest(&mut self.resolver, &request.*)
    let module = ModuleId.copy(DeclarationId.moduleId(Application.bodyDeclaration(root)))
    let span = run authoredRequestSpan(&mut self.resolver, Application.bodyDeclaration(root), Span.make(usize.ZERO, usize.ZERO))
    let checked = run Semantic.validateApplication(&mut self.*, &mut request.*, root, &module, span)
    let validated = match move checked {
      Result<Application, Shared<Rejection>>.Success {value} => move value
      Result<Application, Shared<Rejection>>.Failure {error} => { return StaticClosure.Rejected {diagnostic: move error} }
    }
    let incoming = ClosureIncoming {caller: Option<Application>.none(), edge: Edge.Direct, module: move module, span: span}
    let ancestors = Admission.make()
    return run closeChain(&mut self.*, &ancestors, &validated, move incoming, limit)
  }
  /// Builds an artifact whose roots are the active C exports of the selected runtime source and of
  /// the request's application module, which is what `import Intrinsic.application` binds inside
  /// the runtime. Checks the loaded root-package declarations supplied by source ownership, then
  /// emits only reached instances and joins their definitions in content-symbol order.
  pub effect fn buildRuntime(self: &mut Self, request: &mut Request, runtime: &ModuleId,
    rootPackage: &[ModuleId], closureNodes: usize) -> BackendBuild
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
    run selectRequest(&mut self.resolver, &request.*)
    let mut checked = run Semantic.checkDeclarations(&mut self.*, &mut request.*, rootPackage)
    if Vector<Shared<Rejection>>.length(&checked.rejections) > usize.ZERO {
      let first = Vector<Shared<Rejection>>.remove(&mut checked.rejections, usize.ZERO)
      return BackendBuild.Rejected {
        first: move first,
        further: move checked.rejections,
        gaps: move checked.gaps
      }
    }
    if Vector<Shared<BackendGap>>.length(&checked.gaps) > usize.ZERO {
      return BackendBuild.Unsupported { gaps: move checked.gaps }
    }
    let origin = Span.make(usize.ZERO, usize.ZERO)
    let listed = match move run exportCandidates(&mut self.resolver, runtime) {
      Option<Vector<ExportCandidate>>.Some {value} => move value
      Option<Vector<ExportCandidate>>.None => {
        return refusedBuild(run reject(&self.resolver, runtime, RejectionCode.MissingModule, origin))
      }
    }
    let mut roots = Vector<BuildRoot>.make()
    let mut gaps = Vector<Shared<BackendGap>>.make()
    let refused = run Semantic.rootExports(&mut self.*, &mut request.*, runtime, &listed, &mut roots, &mut gaps)
    if let Option<Shared<Rejection>>.Some {value} = move refused {
      return refusedBuild(move value)
    }
    if Vector<Shared<BackendGap>>.length(&gaps) > usize.ZERO {
      return BackendBuild.Unsupported {gaps: move gaps}
    }
    // A runtime whose arms select no export for this target provides no artifact root.
    if Vector<BuildRoot>.length(&roots) == usize.ZERO {
      return refusedBuild(run reject(&self.resolver, runtime, RejectionCode.UnknownFunction, origin))
    }
    // The application's own C exports are roots beside the runtime's, so foreign code can call them.
    let mut application = Option<ModuleId>.none()
    if let Option<ModuleId>.Some {value} = &request.application {
      application = Option<ModuleId>.some(ModuleId.copy(&value))
    }
    if let Option<ModuleId>.Some {value: applicationModule} = move application {
      let candidates = run exportCandidates(&mut self.resolver, &applicationModule)
      if let Option<Vector<ExportCandidate>>.Some {value: exported} = move candidates {
        let refusedExport = run Semantic.rootExports(&mut self.*, &mut request.*, &applicationModule, &exported, &mut roots, &mut gaps)
        if let Option<Shared<Rejection>>.Some {value} = move refusedExport {
          return refusedBuild(move value)
        }
        if Vector<Shared<BackendGap>>.length(&gaps) > usize.ZERO {
          return BackendBuild.Unsupported {gaps: move gaps}
        }
      }
    }
    return run Semantic.buildFrom(&mut self.*, runtime, Vector<BuildRoot>.asSlice(&roots), origin, closureNodes, false,
      &Option<FrameSelection>.none())
  }
  // Roots every active C export `module` declares. Signature gaps are collected beside the roots;
  // any other refusal is returned.
  effect fn rootExports(self: &mut Self, request: &mut Request, module: &ModuleId, listed: &Vector<ExportCandidate>,
    roots: &mut Vector<BuildRoot>, gaps: &mut Vector<Shared<BackendGap>>) -> Option<Shared<Rejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
    let moduleOrdinal = run internModule(&mut self.resolver, module)
    // Root lookups observe governing conditions without a dependent answer.
    let mut rootConditions = Vector<Dependency>.make()
    let candidates = Vector<ExportCandidate>.asSlice(listed)
    let mut at = usize.ZERO
    while at < candidates.length {
      let candidate = &candidates[at]
      at = at + usize.ONE
      let active = run available(&mut self.resolver, &mut self.query, &mut rootConditions, module, candidate.declaration, candidate.span)
      let present = match move active {
        Result<bool, Shared<Rejection>>.Success {value} => value
        Result<bool, Shared<Rejection>>.Failure {error} => { return Option<Shared<Rejection>>.some(move error) }
      }
      if !present { continue }
      let declared = run declarationAt(&mut self.resolver, module, candidate.declaration)
      let function = match move declared {
        Option<DeclarationId>.Some {value} => run Shared<DeclarationId>.make(move value)
        Option<DeclarationId>.None => {
          return Option<Shared<Rejection>>.some(run reject(&self.resolver, module, RejectionCode.UnknownFunction, candidate.span))
        }
      }
      let declarationAccess273Request = Key {family: Family.Signature, module: moduleOrdinal, name: usize.ZERO, declaration: candidate.declaration, member: usize.ZERO, external: false}
      let declarationAccess273 = run internDeclaration(&mut self.resolver, declarationAccess273Request)
      let signature = run demandRaw(
        &mut self.resolver,
        &mut self.query,
        declarationAccess273,
        candidate.span,
      )
      run recordRoot(&mut request.*, Family.Signature, module, Bytes.asSlice(&candidate.name), &signature)
      let failure = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(&signature, answerRejection)
      if let Option<Shared<Rejection>>.Some {value} = move failure {
        let code = Shared<Rejection>.with<RejectionCode>(&value, fn(rejection: &Rejection) -> RejectionCode {
          return rejection.code
        })
        let mut coverageGap = BackendGap.forRejection(code)
        if code == RejectionCode.Unsupported { coverageGap = Option<GapCode>.some(GapCode.SignatureForm) }
        if let Option<GapCode>.Some {value: gapCode} = move coverageGap {
          run Vector<Shared<BackendGap>>.append(&mut gaps.*, run Shared<BackendGap>.make(BackendGap.fromRejection(gapCode, &function, &value)))
          continue
        }
        return Option<Shared<Rejection>>.some(move value)
      }
      let symbol = run Shared<Bytes>.make(run Bytes.copy(Bytes.asSlice(&candidate.symbol)))
      run Vector<BuildRoot>.append(&mut roots.*, BuildRoot {key: InstanceKey.Export {function: move function, symbol: move symbol}, span: candidate.span})
    }
    return Option<Shared<Rejection>>.none()
  }
  // Walks the instance graph from the roots. A program that runs any `observeDiagnostics` scope is
  // walked again with every function observing diagnostics (failure observer note N1). A program
  // that reaches a suspension boundary is walked again with its closed suspendable set and the
  // selected execution-storage exports as further roots (SUSP private lowering model).
  effect fn buildFrom(self: &mut Self, module: &ModuleId, roots: &[BuildRoot], entrySpan: Span, closureNodes: usize,
    observing: bool, frames: &Option<FrameSelection>) -> BackendBuild
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
    let mut pending = Vector<BackendVisit>.make()
    let mut rootAt = roots.length
    // The worklist is a stack: push in reverse so roots are entered in their listed order.
    while rootAt > usize.ZERO {
      rootAt = rootAt - usize.ONE
      run Vector<BackendVisit>.append(
        &mut pending,
        BackendVisit.Enter {
          key: InstanceKey.copy(&roots[rootAt].key),
          edge: Edge.Direct,
          span: roots[rootAt].span,
          module: ModuleId.copy(module),
          cleanup: Option<Shared<Type>>.none(),
        },
      )
    }
    let mut observes = false
    let mut summaries = Vector<SuspensionSummary>.make()
    let mut admission = Admission.make()
    // Applications admitted by a finite closure certificate during this build.
    let mut certified = Vector<Application>.make()
    let mut certifiedLookup = InternIndex.make()
    let mut visited = Vector<InstanceKey>.make()
    let mut visitedLookup = InternIndex.make()
    let mut emitted = Vector<CollectedText>.make()
    let mut gaps = Vector<Shared<BackendGap>>.make()
    let mut refusals = Vector<Shared<Rejection>>.make()
    // Each cleanup root's owned-structure answers reached during this build.
    let mut cleanupAnswers = Vector<CleanupAnswer>.make()
    // Backend instances published by this walk, and the text each emitted; every other region
    // pattern of an instance resolves to that text.
    let mut walked = Vector<bool>.make()
    let mut texts = Vector<usize>.make()
    while Vector<BackendVisit>.length(&pending) > usize.ZERO {
      let visit = match move Vector<BackendVisit>.pop(&mut pending) {
        Option<BackendVisit>.Some {value} => move value
        Option<BackendVisit>.None => {
          break
        }
      }
      let entered = match move visit {
        BackendVisit.Leave => {
          Admission.leave(&mut admission)
          continue
        }
        BackendVisit.Enter {key: instance, edge, span, module: sourceModule, cleanup} => BackendRequest {
          key: move instance,
          edge: move edge,
          span: span,
          module: move sourceModule,
          cleanup: move cleanup,
        }
      }
      let instance = move entered.key
      let mut leave = false
      // Entry shims and drop glue carry no application to admit; only function instances specialize.
      if let Option<Shared<Application>>.Some {..} = move InstanceKey.application(&instance) {
        let application = run InstanceKey.selected(&instance)
        // A Drop hook drop glue reaches is selected by the cleanup of the value its run started from.
        let mut reaching = move entered.edge
        if let Option<Shared<Type>>.Some {value: owner} = &entered.cleanup {
          reaching = Edge.Cleanup {owner: Shared<Type>.clone(&owner)}
        }
        let enteredEdge = Edge.copy(&reaching)
        let decision = run Admission.enter(&mut admission, &application, move reaching)
        match move decision {
          Decision.Entered => {
            leave = true
          }
          Decision.ChangingStatic {..} => {
            let mut admitted = false
            let known = Vector<Application>.asSlice(&certified)
            let mut knownAt = InternIndex.first(&certifiedLookup, Application.hash(&application))
            while knownAt != usize.MAX {
              if run Application.equals(&known[knownAt], &application) {
                admitted = true
                break
              }
              knownAt = InternIndex.after(&certifiedLookup, knownAt)
            }
            if !admitted {
              let ancestorPath = run Admission.path(&admission)
              let ancestorSlice = Vector<Application>.asSlice(&ancestorPath)
              let mut caller = Option<Application>.none()
              if ancestorSlice.length > usize.ZERO {
                caller = Option<Application>.some(run Application.copy(&ancestorSlice[ancestorSlice.length - usize.ONE]))
              }
              let incoming = ClosureIncoming {caller: move caller, edge: Edge.copy(&enteredEdge), module: ModuleId.copy(&entered.module), span: entered.span}
              let closure = run closeChain(&mut self.*, &admission, &application, move incoming, closureNodes)
              match move closure {
                StaticClosure.Certified {evidence} => {
                  let reached = Vector<Application>.asSlice(&evidence.nodes)
                  let mut reachedAt = usize.ZERO
                  while reachedAt < reached.length {
                    run Vector<Application>.append(&mut certified, run Application.copy(&reached[reachedAt]))
                    run InternIndex.record(&mut certifiedLookup, Application.hash(&reached[reachedAt]))
                    reachedAt = reachedAt + usize.ONE
                  }
                }
                StaticClosure.NotProven {diagnostic} => {
                  run Vector<Shared<Rejection>>.append(&mut refusals, move diagnostic)
                  continue
                }
                StaticClosure.Rejected {diagnostic} => {
                  run Vector<Shared<Rejection>>.append(&mut refusals, move diagnostic)
                  continue
                }
                StaticClosure.Unsupported {gaps: found} => {
                  let reached = Vector<Shared<BackendGap>>.asSlice(&found)
                  let mut reachedAt = usize.ZERO
                  while reachedAt < reached.length {
                    run Vector<Shared<BackendGap>>.append(&mut gaps, Shared<BackendGap>.clone(&reached[reachedAt]))
                    reachedAt = reachedAt + usize.ONE
                  }
                  continue
                }
              }
            }
            run Admission.enterChain(&mut admission, &application, move enteredEdge)
            leave = true
          }
          Decision.Reused {..} => {}
          Decision.Open => {
            let identity = InstanceKey.identity(&instance)
            let diagnostic = run reject(&self.resolver, &entered.module, RejectionCode.Unsupported, entered.span)
            run Vector<Shared<BackendGap>>.append(
              &mut gaps,
              run Shared<BackendGap>.make(
                BackendGap.fromRejection(GapCode.OpenInstance, &identity, &diagnostic),
              ),
            )
            continue
          }
          Decision.Rejected {path} => {
            if !run cleanupAdmits(&mut self.resolver, &mut self.query, &mut cleanupAnswers, &admission, &application,
              &enteredEdge, Vector<Application>.asSlice(&path)) {
              run Vector<Shared<Rejection>>.append(&mut refusals,
                run rejectSpecialization(&entered.module, entered.span, Option<RelatedSite>.none(), move path))
              continue
            }
            run Admission.enterChain(&mut admission, &application, move enteredEdge)
            leave = true
          }
        }
      }
      if run applicationVisited(Vector<InstanceKey>.asSlice(&visited), &visitedLookup, &instance) {
        if leave {
          Admission.leave(&mut admission)
        }
        continue
      }
      if leave {
        run Vector<BackendVisit>.append(&mut pending, BackendVisit.Leave)
      }
      run Vector<InstanceKey>.append(&mut visited, InstanceKey.copy(&instance))
      run InternIndex.record(&mut visitedLookup, InstanceKey.runtimeHash(&instance))
      let found = run locationOfInstance(&mut self.resolver, &instance)
      let location = match move found {
        Option<InstanceLocation>.Some {value} => value
        Option<InstanceLocation>.None => {
          let identity = InstanceKey.identity(&instance)
          run Vector<Shared<BackendGap>>.append(&mut gaps,
            run Shared<BackendGap>.make(BackendGap.make(GapCode.CalleeModule, &identity, entered.span)))
          continue
        }
      }
      let member = instanceMember(&instance)
      // MIR is lowered once per mode; a suspendable instance's emission adds its frame facts.
      // Region patterns of one application share a backend instance, and the first pattern
      // reached publishes its body.
      let lowered = run internBackendInstance(&mut self.resolver, &instance, observing)
      if !run firstInWalk(&mut walked, lowered) {
        let shared = textOf(Vector<usize>.asSlice(&texts), lowered)
        if shared != usize.MAX {
          run Vector<CollectedText>.append(&mut emitted, CollectedText {key: InstanceKey.copy(&instance), index: shared})
        }
        continue
      }
      let declarationAccess274Request = Key {
          family: Family.Mir,
          module: location.module,
          name: lowered,
          declaration: location.declaration,
          member: member,
          external: false,
        }
      let declarationAccess274 = run internDeclaration(&mut self.resolver, declarationAccess274Request)
      let mir = run demandRaw(
        &mut self.resolver,
        &mut self.query,
        declarationAccess274,
        Span.make(usize.ZERO, usize.ZERO),
      )
      let mut mirIndex = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(&mir, answerMirIndex)
      let mut suspension = Option<CoroutineFacts>.none()
      if let Option<FrameSelection>.Some {value: selection} = &frames.* {
        if let Option<usize>.Some {value: loweredIndex} = &mirIndex {
          if run FrameSelection.contains(&selection, &instance) {
            let functions = Vector<MirFunction>.asSlice(&self.resolver.mirValues)
            suspension = Option<CoroutineFacts>.some(run FrameSelection.facts(&selection, &functions[loweredIndex]))
          }
        }
      }
      let backendName = run internBackendVariant(&mut self.resolver, &instance, observing, &suspension)
      // A frame variant's cancel exits can drop owners its other paths move away, so its own MIR
      // names the references to visit.
      if let Option<CoroutineFacts>.Some {..} = &suspension {
        let declarationAccess275Request = Key {
            family: Family.Mir,
            module: location.module,
            name: backendName,
            declaration: location.declaration,
            member: member,
            external: false,
          }
        let declarationAccess275 = run internDeclaration(&mut self.resolver, declarationAccess275Request)
        let variant = run demandRaw(
          &mut self.resolver,
          &mut self.query,
          declarationAccess275,
          Span.make(usize.ZERO, usize.ZERO),
        )
        mirIndex = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(&variant, answerMirIndex)
      }
      let declarationAccess276Request = Key {
        family: Family.EmissionInputs,
        module: location.module,
        name: backendName,
        declaration: location.declaration,
        member: member,
        external: false,
      }
      let declarationAccess276 = run internDeclaration(&mut self.resolver, declarationAccess276Request)
      let key = declarationAccess276
      let prepared = run demandRaw(
        &mut self.resolver,
        &mut self.query,
        key,
        Span.make(usize.ZERO, usize.ZERO),
      )
      let answer = run demandPreparedText(&mut self.resolver, &mut self.query, key, &prepared)
      let canonicalFailure = Shared<Result<Answer, NoRejection>>.with<Option<CanonicalizationFailure>>(&answer, answerCanonicalizationFailure)
      if let Option<CanonicalizationFailure>.Some {..} = move canonicalFailure {
        run Vector<Shared<Rejection>>.append(&mut refusals, run reject(&self.resolver, &entered.module,
          RejectionCode.Unsupported, entered.span))
        continue
      }
      let rejected = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(
        &answer,
        answerRejection,
      )
      if let Option<Shared<Rejection>>.Some {value} = move rejected {
        let code = Shared<Rejection>.with<Option<GapCode>>(&value, fn(diagnostic: &Rejection) -> Option<GapCode> {
          return BackendGap.forRejection(diagnostic.code)
        })
        if let Option<GapCode>.Some {value: gapCode} = move code {
          let identity = InstanceKey.identity(&instance)
          run Vector<Shared<BackendGap>>.append(&mut gaps,
            run Shared<BackendGap>.make(BackendGap.fromRejection(gapCode, &identity, &value)))
          continue
        }
        run Vector<Shared<Rejection>>.append(&mut refusals, move value)
        continue
      }
      let gap = Shared<Result<Answer, NoRejection>>.with<Option<Shared<BackendGap>>>(
        &answer,
        answerBackendGap,
      )
      // Validate every exact application before collecting its content answer.
      if let Option<Shared<BackendGap>>.Some {value} = move gap {
        run Vector<Shared<BackendGap>>.append(&mut gaps, move value)
        continue
      }
      let index = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(
        &answer,
        answerLlvmTextIndex,
      )
      if let Option<usize>.Some {value} = move index {
        run Vector<CollectedText>.append(
          &mut emitted,
          CollectedText {key: InstanceKey.copy(&instance), index: value},
        )
        run recordText(&mut texts, lowered, value)
      }
      if let Option<usize>.Some {value: selectedMir} = move mirIndex {
        let anchor = run instanceAnchor(&mut self.resolver, &instance)
        let functions = Vector<MirFunction>.asSlice(&self.resolver.mirValues)
        if functions[selectedMir].observes { observes = true }
        let callerModule = resolvedModule(&self.resolver, location.module)
        let instances = Vector<BackendInstance>.asSlice(&self.resolver.backendInstances)
        run Vector<SuspensionSummary>.append(&mut summaries,
          run SuspensionSummary.make(&functions[selectedMir], &instance, &callerModule, &anchor))
        // Drop glue passes its root on to the child glue and Drop hook it reaches; a function's
        // own references start outside any cleanup.
        let mut passed = Option<Shared<Type>>.none()
        let mut generatedGlue = false
        if let Option<Shared<Type>>.Some {value: glued} = move InstanceKey.glueType(&instance) {
          generatedGlue = true
          passed = Option<Shared<Type>>.some(move glued)
          if let Option<Shared<Type>>.Some {value: root} = &entered.cleanup {
            passed = Option<Shared<Type>>.some(Shared<Type>.clone(&root))
          }
        }
        let references = Vector<MirReference>.asSlice(&functions[selectedMir].references)
        let mut edge = usize.ZERO
        while edge < references.length {
          // Generated glue references have no authored origin. Carry the demand-local cleanup
          // request through every generated descendant instead of publishing its synthetic zero.
          let mut requestSpan = anchoredSpan(&anchor, references[edge].origin)
          let mut requestModule = ModuleId.copy(&callerModule)
          if generatedGlue {
            requestSpan = entered.span
            requestModule = ModuleId.copy(&entered.module)
          }
          run Vector<BackendVisit>.append(
            &mut pending,
            BackendVisit.Enter {
              key: InstanceKey.copy(&references[edge].key),
              edge: Edge.copy(&references[edge].edge),
              span: requestSpan,
              module: move requestModule,
              cleanup: copyCleanupRoot(&passed),
            },
          )
          edge = edge + usize.ONE
        }
      }
    }
    if Vector<Shared<Rejection>>.length(&refusals) > usize.ZERO {
      let first = Vector<Shared<Rejection>>.remove(&mut refusals, usize.ZERO)
      return BackendBuild.Rejected {first: move first, further: move refusals, gaps: move gaps}
    }
    if observes && !observing {
      return run Semantic.buildFrom(&mut self.*, module, roots, entrySpan, closureNodes, true, frames)
    }
    if Vector<Shared<BackendGap>>.length(&gaps) > usize.ZERO {
      return BackendBuild.Unsupported {gaps: move gaps}
    }
    let selecting = match &frames.* {
      Option<FrameSelection>.Some {..} => false
      Option<FrameSelection>.None => true
    }
    if selecting {
      let reached = Vector<SuspensionSummary>.asSlice(&summaries)
      let suspendable = run closeSuspendable(reached)
      let marked = Vector<bool>.asSlice(&suspendable)
      let mut caller = usize.ZERO
      while caller < reached.length {
        let callbacks = Vector<CallbackBoundary>.asSlice(&reached[caller].callbacks)
        let mut callback = usize.ZERO
        while callback < callbacks.length {
          if run callbackSuspends(reached, marked, &callbacks[callback].key) {
            return refusedBuild(run reject(&self.resolver, &reached[caller].module,
              RejectionCode.ForeignCallback, callbacks[callback].span))
          }
          callback = callback + usize.ONE
        }
        caller = caller + usize.ONE
      }
      // A local-shared access is held while its callback runs, so nothing that callback reaches
      // may run an Effect or notify an execution (SHARED-003). The pass covers every reached
      // access, before any code is emitted.
      let mut escapes = run localSharedEscapes(&self.resolver, reached)
      if Vector<Shared<Rejection>>.length(&escapes) > usize.ZERO {
        let first = Vector<Shared<Rejection>>.remove(&mut escapes, usize.ZERO)
        return BackendBuild.Rejected {first: move first, further: move escapes, gaps: Vector<Shared<BackendGap>>.make()}
      }
      let mut first = usize.MAX
      let mut at = usize.ZERO
      while at < marked.length && first == usize.MAX {
        if marked[at] { first = at }
        at = at + usize.ONE
      }
      if first != usize.MAX {
        let mut origin = first
        at = usize.ZERO
        while at < reached.length {
          if let Option<Span>.Some {..} = &reached[at].boundary {
            origin = at
            break
          }
          at = at + usize.ONE
        }
        let boundary = match &reached[origin].boundary {
          Option<Span>.Some {value} => value
          Option<Span>.None => entrySpan
        }
        let storage = match &self.resolver.executionStorage {
          Option<ExecutionStorage>.Some {value} => run ExecutionStorage.copy(&value)
          Option<ExecutionStorage>.None => {
            return refusedBuild(run reject(&self.resolver, &reached[origin].module, RejectionCode.InvalidConfiguration, boundary))
          }
        }
        let mut selection = FrameSelection.make()
        at = usize.ZERO
        while at < marked.length {
          if marked[at] { run FrameSelection.include(&mut selection, &reached[at].key) }
          at = at + usize.ONE
        }
        let mut extended = Vector<BuildRoot>.make()
        at = usize.ZERO
        while at < roots.length {
          run Vector<BuildRoot>.append(&mut extended, BuildRoot {key: InstanceKey.copy(&roots[at].key), span: roots[at].span})
          at = at + usize.ONE
        }
        let exports = run storageExports(&mut self.resolver, &mut self.query, &storage)
        if Vector<StorageExport>.length(&exports) != 4 {
          return refusedBuild(run reject(&self.resolver, &reached[origin].module, RejectionCode.InvalidConfiguration, boundary))
        }
        let selected = Vector<StorageExport>.asSlice(&exports)
        at = usize.ZERO
        while at < selected.length {
          run FrameSelection.bind(&mut selection, run Bytes.copy(Bytes.asSlice(&selected[at].symbol)))
          run Vector<BuildRoot>.append(&mut extended, BuildRoot {key: InstanceKey.copy(&selected[at].key), span: boundary})
          at = at + usize.ONE
        }
        let chosen = Option<FrameSelection>.some(move selection)
        return run Semantic.buildFrom(&mut self.*, module, Vector<BuildRoot>.asSlice(&extended), entrySpan, closureNodes,
          observing, &chosen)
      }
    }
    return run assembleEmission(
      &self.resolver,
      Vector<CollectedText>.asSlice(&emitted),
      module,
      entrySpan,
    )
  }
}

// Records that a walk reached one backend instance; answers whether this is the first time.
effect fn firstInWalk(walked: &mut Vector<bool>, name: usize) -> bool ! OutOfMemoryError ? &mut Allocator {
  while Vector<bool>.length(&walked.*) <= name {
    run Vector<bool>.append(&mut walked.*, false)
  }
  let mut marks = Vector<bool>.asMutSlice(&mut walked.*)
  if marks[name] { return false }
  marks[name] = true
  return true
}

fn textOf(texts: &[usize], name: usize) -> usize {
  if name < texts.length { return texts[name] }
  return usize.MAX
}

effect fn recordText(texts: &mut Vector<usize>, name: usize, text: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  while Vector<usize>.length(&texts.*) <= name {
    run Vector<usize>.append(&mut texts.*, usize.MAX)
  }
  let mut slots = Vector<usize>.asMutSlice(&mut texts.*)
  slots[name] = text
  return ()
}

// Whether one candidate lies within one cleanup root's owned structure (GEN-006), answered once
// per build.
struct CleanupAnswer {
  root: Shared<Type>
  candidate: Shared<Type>
  within: bool
}

fn copyCleanupRoot(root: &Option<Shared<Type>>) -> Option<Shared<Type>> {
  return match &root.* {
    Option<Shared<Type>>.Some {value} => Option<Shared<Type>>.some(Shared<Type>.clone(&value))
    Option<Shared<Type>>.None => Option<Shared<Type>>.none()
  }
}

// A re-entry the ordinary recursion guard rejects is admitted while it runs inside a Drop hook's
// cleanup and its type arguments stay within the cleanup root's finite owned structure (GEN-006,
// bootstrap `cleanupPermitsSpecialization`). The measure is replayed along the active path only
// when such a re-entry occurs; every argument other than a type argument stays runtime-equal.
effect fn cleanupAdmits(resolver: &mut Resolver, query: &mut Query<Answer, NoRejection>,
  answers: &mut Vector<CleanupAnswer>, admission: &Admission, application: &Application, edge: &Edge,
  rejected: &[Application]) -> bool
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  if rejected.length == usize.ZERO || !run Application.sameNonTypeArguments(&rejected[usize.ZERO], application) {
    return false
  }
  let path = run Admission.path(admission)
  let edges = run Admission.edges(admission)
  let applications = Vector<Application>.asSlice(&path)
  let reached = Vector<Edge>.asSlice(&edges)
  let mut measure = Option<Shared<Type>>.none()
  let mut at = usize.ZERO
  while at < applications.length {
    let next = run cleanupTransition(&mut resolver.*, &mut query.*, &mut answers.*, &measure, &applications[at], &reached[at])
    measure = move next
    at = at + usize.ONE
  }
  let admitted = run cleanupTransition(&mut resolver.*, &mut query.*, &mut answers.*, &measure, application, edge)
  return match &admitted { Option<Shared<Type>>.Some {..} => true _ => false }
}

// The cleanup measure after one step (bootstrap `cleanupTransition`). A Drop hook selected from an
// unmeasured step starts a measure at the value whose cleanup selected it. Inside a measure, a hook
// keeps the root only while that value lies within the root's owned structure, and every step only
// while each of its type arguments does; otherwise the measure ends and the ordinary guard applies.
effect fn cleanupTransition(resolver: &mut Resolver, query: &mut Query<Answer, NoRejection>,
  answers: &mut Vector<CleanupAnswer>, measure: &Option<Shared<Type>>, application: &Application, edge: &Edge)
  -> Option<Shared<Type>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let root = match &measure.* {
    Option<Shared<Type>>.Some {value} => Shared<Type>.clone(&value)
    Option<Shared<Type>>.None => {
      return match &edge.* {
        Edge.Cleanup {owner} => Option<Shared<Type>>.some(Shared<Type>.clone(&owner))
        _ => Option<Shared<Type>>.none()
      }
    }
  }
  if let Edge.Cleanup {owner} = &edge.* {
    if !run withinCleanup(&mut resolver.*, &mut query.*, &mut answers.*, &root, &owner) {
      return Option<Shared<Type>>.none()
    }
  }
  let bindings = run Application.bindings(application)
  let listed = Vector<Binding>.asSlice(&bindings)
  let mut at = usize.ZERO
  while at < listed.length {
    if let Argument.Type {value} = &listed[at].value {
      if !run withinCleanup(&mut resolver.*, &mut query.*, &mut answers.*, &root, &value) {
        return Option<Shared<Type>>.none()
      }
    }
    at = at + usize.ONE
  }
  return Option<Shared<Type>>.some(move root)
}

// Whether `candidate` is runtime-equal to the root or lies within its owned structure: a
// structural part, or a field of a nominal application within it.
effect fn withinCleanup(resolver: &mut Resolver, query: &mut Query<Answer, NoRejection>,
  answers: &mut Vector<CleanupAnswer>, root: &Shared<Type>, candidate: &Shared<Type>) -> bool
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let known = Vector<CleanupAnswer>.asSlice(&answers.*)
  let mut at = usize.ZERO
  while at < known.length {
    if run Type.runtimeEqualsShared(&known[at].candidate, candidate) {
      if run Type.runtimeEqualsShared(&known[at].root, root) { return known[at].within }
    }
    at = at + usize.ONE
  }
  let mut unfolded = Vector<Shared<Type>>.make()
  let mut path = Vector<Shared<Type>>.make()
  let within = run searchCleanup(&mut resolver.*, &mut query.*, root, candidate, &mut unfolded, &mut path)
  run Vector<CleanupAnswer>.append(&mut answers.*, CleanupAnswer {root: Shared<Type>.clone(root),
    candidate: Shared<Type>.clone(candidate), within: within})
  return within
}

// Searches a value's structural parts and the fields of each nominal application within it. A
// nominal declaration unfolds beneath itself only at a strictly smaller instantiation, and each
// application unfolds once, so the search is finite.
effect fn searchCleanup(resolver: &mut Resolver, query: &mut Query<Answer, NoRejection>, value: &Shared<Type>,
  candidate: &Shared<Type>, unfolded: &mut Vector<Shared<Type>>, path: &mut Vector<Shared<Type>>) -> bool
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  if run Type.runtimeEqualsShared(value, candidate) { return true }
  let children = run RuntimeType.inputs(value)
  let parts = Vector<Shared<Type>>.asSlice(&children)
  let mut at = usize.ZERO
  while at < parts.length {
    if run searchCleanup(&mut resolver.*, &mut query.*, &parts[at], candidate, &mut unfolded.*, &mut path.*) { return true }
    at = at + usize.ONE
  }
  if !Shared<Type>.with<bool>(value, isNominalType) { return false }
  if run containsRuntimeType(Vector<Shared<Type>>.asSlice(&unfolded.*), value) { return false }
  let enclosing = Vector<Shared<Type>>.asSlice(&path.*)
  at = enclosing.length
  while at > usize.ZERO {
    at = at - usize.ONE
    if sameNominal(&enclosing[at], value) {
      if !run strictlySmallerNominal(value, &enclosing[at]) { return false }
      break
    }
  }
  run Vector<Shared<Type>>.append(&mut unfolded.*, Shared<Type>.clone(value))
  let mut dependencies = Vector<Dependency>.make()
  let fields = match move run nominalParts(&mut resolver.*, &mut query.*, &mut dependencies, value, Span.make(usize.ZERO, usize.ZERO)) {
    Result<Vector<Shared<Type>>, Shared<Rejection>>.Success {value: found} => move found
    Result<Vector<Shared<Type>>, Shared<Rejection>>.Failure {error} => {
      drop error
      return false
    }
  }
  let depth = Vector<Shared<Type>>.length(&path.*)
  run Vector<Shared<Type>>.append(&mut path.*, Shared<Type>.clone(value))
  let listed = Vector<Shared<Type>>.asSlice(&fields)
  let mut found = false
  at = usize.ZERO
  while at < listed.length && !found {
    found = run searchCleanup(&mut resolver.*, &mut query.*, &listed[at], candidate, &mut unfolded.*, &mut path.*)
    at = at + usize.ONE
  }
  Vector<Shared<Type>>.truncate(&mut path.*, depth)
  return found
}

effect fn containsRuntimeType(values: &[Shared<Type>], value: &Shared<Type>) -> bool ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut at = usize.ZERO
  while at < values.length {
    if run Type.runtimeEqualsShared(&values[at], value) { return true }
    at = at + usize.ONE
  }
  return false
}

// Every type argument of a same-declaration application equals the prior one's or lies strictly
// inside it, and at least one lies strictly inside.
effect fn strictlySmallerNominal(candidate: &Shared<Type>, prior: &Shared<Type>) -> bool ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let next = run RuntimeType.inputs(candidate)
  let previous = run RuntimeType.inputs(prior)
  let second = Vector<Shared<Type>>.asSlice(&next)
  let first = Vector<Shared<Type>>.asSlice(&previous)
  if first.length != second.length { return false }
  let mut strict = false
  let mut at = usize.ZERO
  while at < first.length {
    if !run Type.runtimeEqualsShared(&first[at], &second[at]) {
      if !run Type.strictRuntimeSubterm(&second[at], &first[at]) { return false }
      strict = true
    }
    at = at + usize.ONE
  }
  return strict
}

fn slotCount(slots: &Vector<StaticSlot>) -> usize {
  return Vector<StaticSlot>.length(slots)
}

fn slotAt(slots: &Vector<StaticSlot>, at: usize) -> StaticSlot {
  let listed = Vector<StaticSlot>.asSlice(slots)
  return StaticSlot {ordinal: listed[at].ordinal, value: StaticValue.copy(&listed[at].value)}
}

struct CollectedText {
  key: InstanceKey
  index: usize
}

// Orders positions by their symbol bytes with a stable bottom-up merge, so emission ordering stays
// O(n log n) in the number of collected definitions.
effect fn symbolOrder(symbols: &[Bytes]) -> Vector<usize>
! OutOfMemoryError ? &mut Allocator {
  let mut order = Vector<usize>.make()
  let mut merged = Vector<usize>.make()
  let mut at = usize.ZERO
  while at < symbols.length {
    run Vector<usize>.append(&mut order, at)
    run Vector<usize>.append(&mut merged, at)
    at = at + usize.ONE
  }
  let mut width = usize.ONE
  while width < symbols.length {
    let source = Vector<usize>.asSlice(&order)
    let target = Vector<usize>.asMutSlice(&mut merged)
    let mut low = usize.ZERO
    while low < symbols.length {
      let mut middle = low + width
      if middle > symbols.length { middle = symbols.length }
      let mut high = middle + width
      if high > symbols.length { high = symbols.length }
      let mut left = low
      let mut right = middle
      let mut placed = low
      while placed < high {
        // Take the right run only when strictly earlier, so equal symbols keep their order.
        if right < high && (left == middle || bytesLess(Bytes.asSlice(&symbols[source[right]]),
          Bytes.asSlice(&symbols[source[left]]))) {
          target[placed] = source[right]
          right = right + usize.ONE
        } else {
          target[placed] = source[left]
          left = left + usize.ONE
        }
        placed = placed + usize.ONE
      }
      low = high
    }
    let settled = Vector<usize>.asMutSlice(&mut order)
    let next = Vector<usize>.asSlice(&merged)
    at = usize.ZERO
    while at < next.length {
      settled[at] = next[at]
      at = at + usize.ONE
    }
    width = width + width
  }
  return move order
}

effect fn emissionOrder(plan: &EmissionPlan) -> Vector<usize>
! OutOfMemoryError ? &mut Allocator {
  let entries = Vector<EmissionIdentity>.asSlice(&plan.identities)
  let mut symbols = Vector<Bytes>.make()
  let mut at = usize.ZERO
  while at < entries.length {
    run Vector<Bytes>.append(&mut symbols, run Bytes.copy(Bytes.asSlice(&entries[at].symbol)))
    at = at + usize.ONE
  }
  return run symbolOrder(Vector<Bytes>.asSlice(&symbols))
}

effect fn emissionDeclarations(resolver: &Resolver, reached: &[CollectedText]) -> Option<
  Vector<LlvmText.Declaration>,
> ! BackendGap | OutOfMemoryError ? &mut Allocator {
  let inputs = Vector<InstanceDefinition>.asSlice(&resolver.llvmValues)
  let mut declarations = Vector<LlvmText.Declaration>.make()
  let mut at = usize.ZERO
  while at < reached.length {
    let entries = Vector<LlvmText.Declaration>.asSlice(&inputs[reached[at].index].foreign)
    let mut entry = usize.ZERO
    while entry < entries.length {
      if !run appendDistinctForeignDeclaration(&mut declarations, &entries[entry]) {
        return Option<Vector<LlvmText.Declaration>>.none()
      }
      entry = entry + usize.ONE
    }
    at = at + usize.ONE
  }
  return Option<Vector<LlvmText.Declaration>>.some(move declarations)
}

effect fn appendEmissionDeclarations(text: &mut Bytes, declarations: &Vector<LlvmText.Declaration>) -> ()
! OutOfMemoryError ? &mut Allocator {
  let entries = Vector<LlvmText.Declaration>.asSlice(declarations)
  let mut symbols = Vector<Bytes>.make()
  let mut at = usize.ZERO
  while at < entries.length {
    run Vector<Bytes>.append(&mut symbols, run Bytes.copy(Bytes.asSlice(&entries[at].symbol)))
    at = at + usize.ONE
  }
  let order = run symbolOrder(Vector<Bytes>.asSlice(&symbols))
  run appendOrderedDeclarations(&mut text.*, declarations, Vector<usize>.asSlice(&order))
  return ()
}

effect fn appendOrderedDeclarations(text: &mut Bytes, declarations: &Vector<LlvmText.Declaration>, order: &[usize]) -> ()
! OutOfMemoryError ? &mut Allocator {
  let entries = Vector<LlvmText.Declaration>.asSlice(declarations)
  let mut at = usize.ZERO
  while at < order.length {
    run Bytes.append(&mut text.*, Bytes.asSlice(&entries[order[at]].text))
    at = at + usize.ONE
  }
  return ()
}

effect fn appendResolvedDefinitions(
  resolver: &Resolver,
  reached: &[CollectedText],
  plan: &EmissionPlan,
  order: &[usize],
  text: &mut Bytes,
) -> Vector<usize> ! BackendGap | OutOfMemoryError ? &mut Allocator {
  let inputs = Vector<InstanceDefinition>.asSlice(&resolver.llvmValues)
  let identities = Vector<EmissionIdentity>.asSlice(&plan.identities)
  let mut unchecked = Vector<usize>.make()
  let mut at = usize.ZERO
  while at < uncheckedReasonCount() {
    run Vector<usize>.append(&mut unchecked, usize.ZERO)
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < order.length {
    let identity = &identities[order[at]]
    let input = &inputs[reached[identity.representative].index]
    run Bytes.append(&mut text.*, Bytes.asSlice(&input.text))
    run Bytes.append(&mut text.*, b"\n")
    let reason = uncheckedReason(identity.borrow)
    if reason != usize.MAX {
      let mut counts = Vector<usize>.asMutSlice(&mut unchecked)
      counts[reason] = counts[reason] + usize.ONE
    }
    at = at + usize.ONE
  }
  return move unchecked
}

effect fn assembleEmission(
  resolver: &Resolver,
  reached: &[CollectedText],
  module: &ModuleId,
  span: Span,
) -> BackendBuild ! OutOfMemoryError ? &mut Allocator {
  let assembled = run Effect.result(assembleEmissionChecked(resolver, reached, module, span))
  return match move assembled {
    Result<BackendBuild, BackendGap | OutOfMemoryError>.Success {value} => move value
    Result<BackendBuild, BackendGap | OutOfMemoryError>.Failure {error} => match move error {
      BackendGap {code, owner, source} => {
        let mut gaps = Vector<Shared<BackendGap>>.make()
        run Vector<Shared<BackendGap>>.append(&mut gaps,
          run Shared<BackendGap>.make(BackendGap {code: code, owner: move owner, source: move source}))
        return BackendBuild.Unsupported {gaps: move gaps}
      }
      OutOfMemoryError {} => { fail OutOfMemoryError {} }
    }
  }
}

effect fn assembleEmissionChecked(
  resolver: &Resolver,
  reached: &[CollectedText],
  module: &ModuleId,
  span: Span,
) -> BackendBuild ! BackendGap | OutOfMemoryError ? &mut Allocator {
  let mut plan = EmissionPlan.empty()
  let values = Vector<InstanceDefinition>.asSlice(&resolver.llvmValues)
  let mut at = usize.ZERO
  while at < reached.length {
    let value = &values[reached[at].index]
    run EmissionPlan.include(
      &mut plan,
      &reached[at].key,
      Bytes.asSlice(&value.encoding),
      Bytes.asSlice(&value.symbol),
      value.borrow,
    )
    at = at + usize.ONE
  }
  if EmissionPlan.hasSymbolConflict(&plan) {
    return CompilerBug.panic(b"InstanceSymbolConflict")
  }
  let foreign = match move run emissionDeclarations(resolver, reached) {
    Option<Vector<LlvmText.Declaration>>.Some {value} => move value
    Option<Vector<LlvmText.Declaration>>.None => {
      return refusedBuild(run reject(resolver, module, RejectionCode.ForeignSymbolConflict, span))
    }
  }
  let mut text = run LlvmText.declarations(&resolver.target)
  run appendEmissionDeclarations(&mut text, &foreign)
  let order = run emissionOrder(&plan)
  let unchecked = run appendResolvedDefinitions(
    resolver,
    reached,
    &plan,
    Vector<usize>.asSlice(&order),
    &mut text,
  )
  return BackendBuild.Module {text: move text, unchecked: move unchecked, plan: move plan}
}

effect fn applicationVisited(visited: &[InstanceKey], lookup: &InternIndex, instance: &InstanceKey) -> bool
! OutOfMemoryError
? &mut Allocator {
  let mut at = InternIndex.first(lookup, InstanceKey.runtimeHash(instance))
  while at != usize.MAX {
    if run InstanceKey.sameApplication(&visited[at], instance) {
      return true
    }
    at = InternIndex.after(lookup, at)
  }
  return false
}


// Returns false when a declaration with the same symbol but different text was already collected.
effect fn appendDistinctForeignDeclaration(
  declarations: &mut Vector<LlvmText.Declaration>,
  entry: &LlvmText.Declaration,
) -> bool ! OutOfMemoryError ? &mut Allocator {
  let prior = Vector<LlvmText.Declaration>.asSlice(&declarations.*)
  let mut seen = false
  let mut check = usize.ZERO
  while check < prior.length {
    if same(Bytes.asSlice(&prior[check].symbol), Bytes.asSlice(&entry.symbol)) {
      if !same(Bytes.asSlice(&prior[check].contract), Bytes.asSlice(&entry.contract))
        || !same(Bytes.asSlice(&prior[check].text), Bytes.asSlice(&entry.text)) {
        return false
      }
      seen = true
    }
    check = check + usize.ONE
  }
  if !seen {
    run Vector<LlvmText.Declaration>.append(
      &mut declarations.*,
      LlvmText.Declaration {
        contract: run Bytes.copy(Bytes.asSlice(&entry.contract)),
        symbol: run Bytes.copy(Bytes.asSlice(&entry.symbol)),
        text: run Bytes.copy(Bytes.asSlice(&entry.text)),
      },
    )
  }
  return true
}

union BackendVisit {
  /// `cleanup` is the root whose cleanup reached this instance through drop glue: the value a
  /// function dropped, carried unchanged through nested glue to the Drop hooks it selects.
  Enter {key: InstanceKey, edge: Edge, span: Span, module: ModuleId, cleanup: Option<Shared<Type>>},
  Leave,
}

// One artifact root: the generated C entry or one selected runtime C export, at its source span.
struct BuildRoot {
  key: InstanceKey
  span: Span
}

struct CallbackBoundary {
  key: InstanceKey
  span: Span
}

// One escape site of a reached instance's own body (SHARED-003).
struct SummaryEscape {
  kind: MirAccessEscape
  span: Span
}

// One reached instance's suspension summary: the boundary it runs, if any, its direct Silk
// callees and each call's span, and the local-shared accesses it holds with their callbacks.
struct SuspensionSummary {
  key: InstanceKey
  module: ModuleId
  boundary: Option<Span>
  callees: Vector<InstanceKey>
  calls: Vector<Span>
  callbacks: Vector<CallbackBoundary>
  accesses: Vector<CallbackBoundary>
  escapes: Vector<SummaryEscape>
}

impl SuspensionSummary {
  effect fn make(function: &MirFunction, instance: &InstanceKey, module: &ModuleId, anchor: &Option<Anchor>) -> SuspensionSummary
  ! OutOfMemoryError ? &mut Allocator {
    let mut callees = Vector<InstanceKey>.make()
    let mut calls = Vector<Span>.make()
    let mut callbacks = Vector<CallbackBoundary>.make()
    let blocks = Vector<MirBlock>.asSlice(&function.blocks)
    let mut at = usize.ZERO
    while at < blocks.length {
      if let MirTerminator.Call {callee: MirCallee.Instance {key}, origin, ..} = &blocks[at].terminator {
        run Vector<InstanceKey>.append(&mut callees, InstanceKey.copy(&key))
        run Vector<Span>.append(&mut calls, anchoredSpan(anchor, origin))
      }
      let statements = Vector<MirStatement>.asSlice(&blocks[at].statements)
      let mut statement = usize.ZERO
      while statement < statements.length {
        if let MirStatement.Assign {value: MirRvalue.FunctionAddress {key}, origin, ..} = &statements[statement] {
          if InstanceKey.fixedLinkage(&key) {
            run Vector<CallbackBoundary>.append(&mut callbacks, CallbackBoundary {key: InstanceKey.copy(&key), span: anchoredSpan(anchor, origin)})
          }
        }
        statement = statement + usize.ONE
      }
      at = at + usize.ONE
    }
    let mut boundary = Option<Span>.none()
    if let Option<BodyOrigin>.Some {value: origin} = &function.suspension { boundary = Option<Span>.some(anchoredSpan(anchor, origin)) }
    let mut accesses = Vector<CallbackBoundary>.make()
    let held = Vector<MirSharedAccess>.asSlice(&function.accesses)
    at = usize.ZERO
    while at < held.length {
      run Vector<CallbackBoundary>.append(&mut accesses, CallbackBoundary {key: InstanceKey.copy(&held[at].callback), span: anchoredSpan(anchor, held[at].origin)})
      at = at + usize.ONE
    }
    let mut escapes = Vector<SummaryEscape>.make()
    let sites = Vector<MirEscapeSite>.asSlice(&function.escapes)
    at = usize.ZERO
    while at < sites.length {
      run Vector<SummaryEscape>.append(&mut escapes, SummaryEscape {kind: sites[at].kind, span: anchoredSpan(anchor, sites[at].origin)})
      at = at + usize.ONE
    }
    return SuspensionSummary {
      key: InstanceKey.copy(instance),
      module: ModuleId.copy(module),
      boundary: move boundary,
      callees: move callees,
      calls: move calls,
      callbacks: move callbacks,
      accesses: move accesses,
      escapes: move escapes,
    }
  }
}

// An address may select only a synchronous C export. Runtime roots may still drive frames;
// the restriction belongs to the function pointer formation, after its transitive graph closes.
effect fn callbackSuspends(summaries: &[SuspensionSummary], marked: &[bool], key: &InstanceKey) -> bool
! OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < summaries.length {
    if run InstanceKey.sameApplication(&summaries[at].key, key) {
      let callees = Vector<InstanceKey>.asSlice(&summaries[at].callees)
      let mut callee = usize.ZERO
      while callee < callees.length {
        let mut target = usize.ZERO
        while target < summaries.length {
          if marked[target] && run InstanceKey.sameApplication(&summaries[target].key, &callees[callee]) { return true }
          target = target + usize.ONE
        }
        callee = callee + usize.ONE
      }
    }
    at = at + usize.ONE
  }
  return false
}

// One resolved call of a summary: the callee's summary position and the call's index.
struct CallEdge {
  target: usize
  call: usize
}

// Each summary's direct callees as summary positions, in call order.
effect fn summaryEdges(summaries: &[SuspensionSummary]) -> Vector<Vector<CallEdge>> ! OutOfMemoryError ? &mut Allocator {
  let mut lookup = InternIndex.make()
  let mut at = usize.ZERO
  while at < summaries.length {
    run InternIndex.record(&mut lookup, InstanceKey.runtimeHash(&summaries[at].key))
    at = at + usize.ONE
  }
  let mut edges = Vector<Vector<CallEdge>>.make()
  at = usize.ZERO
  while at < summaries.length {
    let mut targets = Vector<CallEdge>.make()
    let callees = Vector<InstanceKey>.asSlice(&summaries[at].callees)
    let mut callee = usize.ZERO
    while callee < callees.length {
      let mut found = InternIndex.first(&lookup, InstanceKey.runtimeHash(&callees[callee]))
      while found != usize.MAX {
        if run InstanceKey.sameInstance(&summaries[found].key, &callees[callee]) {
          run Vector<CallEdge>.append(&mut targets, CallEdge {target: found, call: callee})
          break
        }
        found = InternIndex.after(&lookup, found)
      }
      callee = callee + usize.ONE
    }
    run Vector<Vector<CallEdge>>.append(&mut edges, move targets)
    at = at + usize.ONE
  }
  return move edges
}

// Marks the reached instances that can suspend: each one that runs a boundary, then each one
// that calls a marked instance directly, to a fixed point. Fixed-linkage shims are never marked;
// they call a suspendable instance's ordinary symbol, which drives its frames.
effect fn closeSuspendable(summaries: &[SuspensionSummary]) -> Vector<bool> ! OutOfMemoryError ? &mut Allocator {
  let mut marked = Vector<bool>.make()
  let mut at = usize.ZERO
  while at < summaries.length {
    let origin = match &summaries[at].boundary {
      Option<Span>.Some {..} => true
      Option<Span>.None => false
    }
    run Vector<bool>.append(&mut marked, origin && !InstanceKey.fixedLinkage(&summaries[at].key))
    at = at + usize.ONE
  }
  let edges = run summaryEdges(summaries)
  let following = Vector<Vector<CallEdge>>.asSlice(&edges)
  let mut changed = true
  while changed {
    changed = false
    at = usize.ZERO
    while at < summaries.length {
      let current = Vector<bool>.asSlice(&marked)
      if !current[at] && !InstanceKey.fixedLinkage(&summaries[at].key) {
        let targets = Vector<CallEdge>.asSlice(&following[at])
        let mut edge = usize.ZERO
        let mut reaches = false
        while edge < targets.length {
          if current[targets[edge].target] { reaches = true }
          edge = edge + usize.ONE
        }
        if reaches {
          let updated = Vector<bool>.asMutSlice(&mut marked)
          updated[at] = true
          changed = true
        }
      }
      at = at + usize.ONE
    }
  }
  return move marked
}

// One reported local-shared access escape: the escape's own site and the call it relates to.
struct EscapeReport {
  module: ModuleId
  span: Span
  relatedModule: ModuleId
  related: Span
}

fn runCall(escapes: &[SummaryEscape], span: Span) -> bool {
  let mut at = usize.ZERO
  while at < escapes.length {
    if escapes[at].kind == MirAccessEscape.Suspension && sameSpan(escapes[at].span, span) { return true }
    at = at + usize.ONE
  }
  return false
}

fn sameSpan(left: Span, right: Span) -> bool {
  return left.start == right.start && left.end == right.end
}

fn reportedEscape(reports: &[EscapeReport], module: &ModuleId, span: Span, site: &RelatedSite) -> bool {
  let mut at = usize.ZERO
  while at < reports.length {
    if sameSpan(reports[at].span, span) && sameSpan(reports[at].related, site.span) && ModuleId.equals(&reports[at].module, module)
      && ModuleId.equals(&reports[at].relatedModule, &site.module) { return true }
    at = at + usize.ONE
  }
  return false
}

fn sharesDeclaration(left: &[DeclarationId], right: &[DeclarationId]) -> bool {
  let mut at = usize.ZERO
  while at < left.length {
    let mut other = usize.ZERO
    while other < right.length {
      if DeclarationId.equals(&left[at], &right[other]) { return true }
      other = other + usize.ONE
    }
    at = at + usize.ONE
  }
  return false
}

// The callable declarations an instance's application carries: what its callable parameters were
// specialized over.
effect fn carriedCallables(key: &InstanceKey) -> Vector<DeclarationId> ! OutOfMemoryError ? &mut Allocator {
  let mut carried = Vector<DeclarationId>.make()
  if let Option<Shared<Application>>.Some {value: application} = move InstanceKey.application(key) {
    let count = Shared<Application>.with<usize>(&application, Application.typeCount)
    let mut at = usize.ZERO
    while at < count {
      let argument = Shared<Application>.with<Option<Shared<Type>>>(&application, fn(selected: &Application) -> Option<Shared<Type>> {
        return Application.typeAt(selected, at)
      })
      if let Option<Shared<Type>>.Some {value} = move argument { run Type.appendCallableTargets(&value, &mut carried) }
      at = at + usize.ONE
    }
  }
  return move carried
}

// The calls where a held access's callback entered its access wrappers (SHARED-003). A wrapper
// instance is specialized over the callable it forwards, so callers are walked upward while they
// carry a callable the instance they call carries; the first caller that carries none of them named
// the callback itself. An access holder that carries no callable names its callback at the access.
effect fn accessEntries(summaries: &[SuspensionSummary], calls: &[Vector<CallEdge>], carried: &[Vector<DeclarationId>],
  holder: usize, access: Span) -> Vector<RelatedSite> ! OutOfMemoryError ? &mut Allocator {
  let mut sites = Vector<RelatedSite>.make()
  let mut pending = Vector<usize>.make()
  let mut visited = Vector<bool>.make()
  while Vector<bool>.length(&visited) < summaries.length { run Vector<bool>.append(&mut visited, false) }
  if Vector<DeclarationId>.length(&carried[holder]) > usize.ZERO { run Vector<usize>.append(&mut pending, holder) }
  else { run Vector<RelatedSite>.append(&mut sites, RelatedSite {module: ModuleId.copy(&summaries[holder].module), span: access}) }
  let mut head = usize.ZERO
  while head < Vector<usize>.length(&pending) {
    let current = Vector<usize>.get(&pending, head)
    head = head + usize.ONE
    let mut called = false
    let mut caller = usize.ZERO
    while caller < summaries.length {
      let edges = Vector<CallEdge>.asSlice(&calls[caller])
      let mut edge = usize.ZERO
      while edge < edges.length {
        if edges[edge].target == current {
          called = true
          if sharesDeclaration(Vector<DeclarationId>.asSlice(&carried[caller]), Vector<DeclarationId>.asSlice(&carried[current])) {
            let marks = Vector<bool>.asMutSlice(&mut visited)
            if !marks[caller] {
              marks[caller] = true
              run Vector<usize>.append(&mut pending, caller)
            }
          } else {
            let span = Vector<Span>.get(&summaries[caller].calls, edges[edge].call)
            run Vector<RelatedSite>.append(&mut sites, RelatedSite {module: ModuleId.copy(&summaries[caller].module), span: span})
          }
        }
        edge = edge + usize.ONE
      }
      caller = caller + usize.ONE
    }
    if !called && current == holder {
      run Vector<RelatedSite>.append(&mut sites, RelatedSite {module: ModuleId.copy(&summaries[holder].module), span: access})
    }
  }
  return move sites
}

// Every local-shared access escape of the reached instances (SHARED-003). From each held access,
// its callback and every instance the callback reaches through direct calls are walked
// breadth-first in call order. Each escape site found is reported at its own span and related to
// the call where the callback entered its access wrappers, once per pair.
effect fn localSharedEscapes(resolver: &Resolver, summaries: &[SuspensionSummary]) -> Vector<Shared<Rejection>>
! OutOfMemoryError ? &mut Allocator {
  let mut found = Vector<Shared<Rejection>>.make()
  let mut reports = Vector<EscapeReport>.make()
  let edges = run summaryEdges(summaries)
  let calls = Vector<Vector<CallEdge>>.asSlice(&edges)
  let mut carriedBy = Vector<Vector<DeclarationId>>.make()
  let mut at = usize.ZERO
  while at < summaries.length {
    run Vector<Vector<DeclarationId>>.append(&mut carriedBy, run carriedCallables(&summaries[at].key))
    at = at + usize.ONE
  }
  let carried = Vector<Vector<DeclarationId>>.asSlice(&carriedBy)
  let mut holder = usize.ZERO
  while holder < summaries.length {
    let accesses = Vector<CallbackBoundary>.asSlice(&summaries[holder].accesses)
    let mut access = usize.ZERO
    while access < accesses.length {
      let mut callback = usize.MAX
      at = usize.ZERO
      while at < summaries.length && callback == usize.MAX {
        if run InstanceKey.sameInstance(&summaries[at].key, &accesses[access].key) { callback = at }
        at = at + usize.ONE
      }
      if callback != usize.MAX {
        let entries = run accessEntries(summaries, calls, carried, holder, accesses[access].span)
        let sites = Vector<RelatedSite>.asSlice(&entries)
        let mut queue = Vector<usize>.make()
        let mut queued = Vector<bool>.make()
        while Vector<bool>.length(&queued) < summaries.length { run Vector<bool>.append(&mut queued, false) }
        run Vector<usize>.append(&mut queue, callback)
        let start = Vector<bool>.asMutSlice(&mut queued)
        start[callback] = true
        let mut head = usize.ZERO
        while head < Vector<usize>.length(&queue) {
          let reached = Vector<usize>.get(&queue, head)
          head = head + usize.ONE
          let escapes = Vector<SummaryEscape>.asSlice(&summaries[reached].escapes)
          let mut escape = usize.ZERO
          while escape < escapes.length {
            let mut site = usize.ZERO
            while site < sites.length {
              if !reportedEscape(Vector<EscapeReport>.asSlice(&reports), &summaries[reached].module, escapes[escape].span, &sites[site]) {
                run Vector<EscapeReport>.append(&mut reports, EscapeReport {module: ModuleId.copy(&summaries[reached].module),
                  span: escapes[escape].span, relatedModule: ModuleId.copy(&sites[site].module), related: sites[site].span})
                run Vector<Shared<Rejection>>.append(&mut found, run rejectWithRelated(resolver, &summaries[reached].module,
                  RejectionCode.LocalSharedAccessEscape, escapes[escape].span,
                  Option<RelatedSite>.some(RelatedSite {module: ModuleId.copy(&sites[site].module), span: sites[site].span})))
              }
              site = site + usize.ONE
            }
            escape = escape + usize.ONE
          }
          // A run's own calls are the escape already reported at the run, so they are not walked.
          let next = Vector<CallEdge>.asSlice(&calls[reached])
          let mut edge = usize.ZERO
          while edge < next.length {
            let marks = Vector<bool>.asMutSlice(&mut queued)
            let span = Vector<Span>.get(&summaries[reached].calls, next[edge].call)
            if !marks[next[edge].target] && !runCall(escapes, span) {
              marks[next[edge].target] = true
              run Vector<usize>.append(&mut queue, next[edge].target)
            }
            edge = edge + usize.ONE
          }
        }
      }
      access = access + usize.ONE
    }
    holder = holder + usize.ONE
  }
  return move found
}

// The closed suspendable set of one build and the storage export symbols its frames use.
struct FrameSelection {
  suspendable: Vector<InstanceKey>
  lookup: InternIndex
  symbols: Vector<Bytes>
}

impl FrameSelection {
  fn make() -> FrameSelection {
    return FrameSelection {suspendable: Vector<InstanceKey>.make(), lookup: InternIndex.make(),
      symbols: Vector<Bytes>.make()}
  }

  effect fn include(self: &mut Self, key: &InstanceKey) -> () ! OutOfMemoryError ? &mut Allocator {
    run Vector<InstanceKey>.append(&mut self.suspendable, InstanceKey.copy(key))
    run InternIndex.record(&mut self.lookup, InstanceKey.runtimeHash(key))
  }

  // Binds the next operation in create, acquire, release, destroy order.
  effect fn bind(self: &mut Self, symbol: Bytes) -> () ! OutOfMemoryError ? &mut Allocator {
    run Vector<Bytes>.append(&mut self.symbols, move symbol)
  }

  effect fn contains(self: &Self, key: &InstanceKey) -> bool ! OutOfMemoryError ? &mut Allocator {
    let entry = run FrameSelection.position(self, key)
    return entry != usize.MAX
  }

  // The suspendable entry that is `key`'s backend instance, or `usize.MAX`.
  effect fn position(self: &Self, key: &InstanceKey) -> usize ! OutOfMemoryError ? &mut Allocator {
    let listed = Vector<InstanceKey>.asSlice(&self.suspendable)
    let mut at = InternIndex.first(&self.lookup, InstanceKey.runtimeHash(key))
    while at != usize.MAX {
      if run InstanceKey.sameInstance(&listed[at], key) { return at }
      at = InternIndex.after(&self.lookup, at)
    }
    return usize.MAX
  }

  // The emission facts of one suspendable instance: its suspendable direct callees in first-call
  // order and the storage symbols.
  effect fn facts(self: &Self, function: &MirFunction) -> CoroutineFacts ! OutOfMemoryError ? &mut Allocator {
    let mut callees = Vector<InstanceKey>.make()
    let blocks = Vector<MirBlock>.asSlice(&function.blocks)
    let mut at = usize.ZERO
    while at < blocks.length {
      if let MirTerminator.Call {callee: MirCallee.Instance {key}, ..} = &blocks[at].terminator {
        let entry = run FrameSelection.position(self, &key)
        if entry != usize.MAX {
          let listed = Vector<InstanceKey>.asSlice(&callees)
          let mut seen = false
          let mut prior = usize.ZERO
          while prior < listed.length && !seen {
            seen = run InstanceKey.sameInstance(&listed[prior], &key)
            prior = prior + usize.ONE
          }
          if !seen { run Vector<InstanceKey>.append(&mut callees, InstanceKey.copy(&key)) }
        }
      }
      at = at + usize.ONE
    }
    let symbols = Vector<Bytes>.asSlice(&self.symbols)
    return CoroutineFacts {
      callees: move callees,
      create: run Bytes.copy(Bytes.asSlice(&symbols[usize.ZERO])),
      acquire: run Bytes.copy(Bytes.asSlice(&symbols[usize.ONE])),
      release: run Bytes.copy(Bytes.asSlice(&symbols[2])),
      destroy: run Bytes.copy(Bytes.asSlice(&symbols[3])),
    }
  }
}

// One selected storage operation's export root and its symbol.
struct StorageExport {
  key: InstanceKey
  symbol: Bytes
}

// The exports of the four storage operations in create, acquire, release, destroy order, stopping
// at the first binding that names no active C export.
effect fn storageExports(resolver: &mut Resolver, query: &mut Query<Answer, NoRejection>, storage: &ExecutionStorage)
  -> Vector<StorageExport>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut found = Vector<StorageExport>.make()
  let created = run storageExport(&mut resolver.*, &mut query.*, &storage.create)
  if let Option<StorageExport>.Some {value} = move created { run Vector<StorageExport>.append(&mut found, move value) }
  else { return move found }
  let acquired = run storageExport(&mut resolver.*, &mut query.*, &storage.acquire)
  if let Option<StorageExport>.Some {value} = move acquired { run Vector<StorageExport>.append(&mut found, move value) }
  else { return move found }
  let released = run storageExport(&mut resolver.*, &mut query.*, &storage.release)
  if let Option<StorageExport>.Some {value} = move released { run Vector<StorageExport>.append(&mut found, move value) }
  else { return move found }
  let destroyed = run storageExport(&mut resolver.*, &mut query.*, &storage.destroy)
  if let Option<StorageExport>.Some {value} = move destroyed { run Vector<StorageExport>.append(&mut found, move value) }
  return move found
}

// Finds the active C export a storage binding names, without recognizing its module or name.
effect fn storageExport(resolver: &mut Resolver, query: &mut Query<Answer, NoRejection>, binding: &StorageBinding)
  -> Option<StorageExport>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let exported = run exportCandidates(&mut resolver.*, &binding.module)
  let listed = match move exported {
    Option<Vector<ExportCandidate>>.Some {value} => move value
    Option<Vector<ExportCandidate>>.None => { return Option<StorageExport>.none() }
  }
  let candidates = Vector<ExportCandidate>.asSlice(&listed)
  let mut conditions = Vector<Dependency>.make()
  let mut at = usize.ZERO
  while at < candidates.length {
    let candidate = &candidates[at]
    at = at + usize.ONE
    if !same(Bytes.asSlice(&candidate.name), Bytes.asSlice(&binding.declaration)) { continue }
    let active = run available(&mut resolver.*, &mut query.*, &mut conditions, &binding.module, candidate.declaration, candidate.span)
    let present = match move active {
      Result<bool, Shared<Rejection>>.Success {value} => value
      Result<bool, Shared<Rejection>>.Failure {..} => false
    }
    if !present { continue }
    let declared = run declarationAt(&mut resolver.*, &binding.module, candidate.declaration)
    if let Option<DeclarationId>.Some {value} = move declared {
      let function = run Shared<DeclarationId>.make(move value)
      let symbol = run Shared<Bytes>.make(run Bytes.copy(Bytes.asSlice(&candidate.symbol)))
      return Option<StorageExport>.some(StorageExport {
        key: InstanceKey.Export {function: move function, symbol: move symbol},
        symbol: run Bytes.copy(Bytes.asSlice(&candidate.symbol)),
      })
    }
  }
  return Option<StorageExport>.none()
}

// One module-level C export a runtime source declares, before its arms are evaluated.
struct ExportCandidate {
  declaration: usize
  name: Bytes
  symbol: Bytes
  span: Span
}

// Lists every module-level `export "C" fn` of one source, or absence when the source is missing.
effect fn exportCandidates(resolver: &mut Resolver, module: &ModuleId) -> Option<Vector<ExportCandidate>>
! Cycle | OutOfMemoryError ? &mut Allocator {
  let answer = run namespaceSource(&mut resolver.*, module)
  run recordEnumerationHeaders(&mut resolver.*, module, &answer)
  if let Option<&IndexedSource>.Some {value} = move sourceOf(&resolver.*, &answer, module) {
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(value))
    let hir = IndexedSource.authored(value)
    let mut found = Vector<ExportCandidate>.make()
    let mut at = usize.ZERO
    while at < declarations.length {
      let topLevel = match &declarations[at].parent {
        Option<usize>.None => true
        Option<usize>.Some {..} => false
      }
      if topLevel {
        if let Node.FunctionHeader {name, linkage, ..} = Module.node(hir, declarations[at].header) {
          if linkage.present {
            if let Node.Linkage {direction, symbol, ..} = Module.node(hir, linkage.id) {
              if direction == LinkageDirection.Export {
                let mut written = Bytes.make()
                if let Node.Name {text} = Module.node(hir, name) { written = run Bytes.copy(Module.text(hir, text)) }
                let mut linked = run Bytes.copy(Bytes.asSlice(&written))
                if symbol.present {
                  if let Node.TextLiteral {value: text} = Module.node(hir, symbol.id) { linked = run Bytes.copy(Module.text(hir, text)) }
                }
                run Vector<ExportCandidate>.append(&mut found, ExportCandidate {
                  declaration: at, name: move written, symbol: move linked, span: Module.span(hir, declarations[at].header),
                })
              }
            }
          }
        }
      }
      at = at + usize.ONE
    }
    return Option<Vector<ExportCandidate>>.some(move found)
  }
  return Option<Vector<ExportCandidate>>.none()
}

struct BackendRequest {
  key: InstanceKey
  edge: Edge
  span: Span
  module: ModuleId
  cleanup: Option<Shared<Type>>
}

// One demand-local finite-closure transaction rooted at a changing-static edge. It follows every
// lowered successor of every reached node, applies the non-static growth guard from the build's
// own ancestors, and certifies only a complete closed node set. Per-node answers are ordinary
// cached queries and never authorize closure on their own.
effect<'owner & 'env> fn closeChain<'owner, 'env>(semantic: &'owner mut Semantic, ancestors: &'env Admission, root: &'env Application, incoming: ClosureIncoming, limit: usize) -> StaticClosure
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let rootKey = match move run InstanceKey.function(run Application.copy(root)) {
    Result<InstanceKey, CanonicalizationFailure>.Success {value: canonicalKey} => move canonicalKey
    Result<InstanceKey, CanonicalizationFailure>.Failure {..} => {
      return StaticClosure.Rejected {diagnostic: run reject(&semantic.resolver,
        &incoming.module, RejectionCode.Unsupported, incoming.span)}
    }
  }
  let mut pending = Vector<ClosureVisit>.make()
  run Vector<ClosureVisit>.append(&mut pending, ClosureVisit.Enter {
    key: move rootKey, from: usize.MAX, edge: Edge.copy(&incoming.edge), module: ModuleId.copy(&incoming.module), span: incoming.span,
  })
  let ancestorPath = run Admission.path(ancestors)
  let draft = ClosureDraft {
    pending: move pending,
    nodes: Vector<Application>.make(),
    edges: Vector<ClosureEdge>.make(),
    admission: run Admission.copy(ancestors),
  }
  // Semantic stays outside the resource: the transaction owns only its drafts.
  let use = effect fn(resource: &mut ClosureDraft) -> StaticClosure
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
    return run walkChain(&mut semantic.*, &mut resource.*, limit, &incoming, Vector<Application>.asSlice(&ancestorPath))
  }
  // Drafts never outlive the transaction: success copies the evidence out first.
  let release = effect fn(resource: &mut ClosureDraft) -> () {
    Vector<ClosureVisit>.clear(&mut resource.pending)
    Vector<Application>.clear(&mut resource.nodes)
    Vector<ClosureEdge>.clear(&mut resource.edges)
    return ()
  }
  return run Effect.useReleaseNonParking(move draft, move use, move release)
}

effect fn copyClosureIncoming(incoming: &ClosureIncoming) -> ClosureIncoming ! OutOfMemoryError ? &mut Allocator {
  let mut caller = Option<Application>.none()
  if let Option<Application>.Some {value} = &incoming.caller { caller = Option<Application>.some(run Application.copy(&value)) }
  return ClosureIncoming {caller: move caller, edge: Edge.copy(&incoming.edge), module: ModuleId.copy(&incoming.module), span: incoming.span}
}

effect fn closureGap(code: GapCode, application: &Application, span: Span) -> StaticClosure ! OutOfMemoryError ? &mut Allocator {
  let identity = run Shared<DeclarationId>.make(DeclarationId.copy(Application.bodyDeclaration(application)))
  let mut gaps = Vector<Shared<BackendGap>>.make()
  run Vector<Shared<BackendGap>>.append(&mut gaps, run Shared<BackendGap>.make(BackendGap.make(code, &identity, span)))
  return StaticClosure.Unsupported {gaps: move gaps}
}

// Admits one reached node of a closure transaction: the growth guard, deduplication, the node
// budget, and its complete lowered successors. A returned outcome ends the transaction.
effect fn enterChainNode(semantic: &mut Semantic, draft: &mut ClosureDraft, key: InstanceKey, from: usize, edge: Edge, module: ModuleId, span: Span, incoming: &ClosureIncoming, limit: usize) -> Option<StaticClosure>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  // Drop glue carries no static arguments, so it never extends a changing-static chain; the build
  // worklist reaches it and the hooks it calls.
  if let Option<Shared<Type>>.Some {..} = move InstanceKey.glueType(&key) { return Option<StaticClosure>.none() }
  let application = run InstanceKey.selected(&key)
  let root = RelatedSite {module: ModuleId.copy(&incoming.module), span: incoming.span}
  let decision = run Admission.enter(&mut draft.admission, &application, Edge.copy(&edge))
  let mut leave = false
  match move decision {
    Decision.Entered => { leave = true }
    Decision.ChangingStatic {..} => {
      run Admission.enterChain(&mut draft.admission, &application, Edge.copy(&edge))
      leave = true
    }
    Decision.Reused {..} => {}
    Decision.Open => { return Option<StaticClosure>.some(run closureGap(GapCode.OpenInstance, &application, span)) }
    Decision.Rejected {path} => {
      return Option<StaticClosure>.some(StaticClosure.Rejected {diagnostic: run rejectSpecialization(&module, span, Option<RelatedSite>.some(move root), move path)})
    }
  }
  let known = Vector<Application>.asSlice(&draft.nodes)
  let mut found = usize.MAX
  let mut at = usize.ZERO
  while at < known.length {
    if run Application.equals(&known[at], &application) {
      found = at
      break
    }
    at = at + usize.ONE
  }
  if found != usize.MAX {
    if from != usize.MAX {
      run Vector<ClosureEdge>.append(&mut draft.edges, ClosureEdge {from: from, to: found, edge: Edge.copy(&edge), module: ModuleId.copy(&module), span: span})
    }
    if leave { Admission.leave(&mut draft.admission) }
    return Option<StaticClosure>.none()
  }
  if Vector<Application>.length(&draft.nodes) >= limit {
    let mut path = run Admission.path(&draft.admission)
    if !leave { run Vector<Application>.append(&mut path, run Application.copy(&application)) }
    return Option<StaticClosure>.some(StaticClosure.NotProven {diagnostic: run rejectNotProven(&module, span, Option<RelatedSite>.some(move root), move path, limit)})
  }
  let node = Vector<Application>.length(&draft.nodes)
  run Vector<Application>.append(&mut draft.nodes, run Application.copy(&application))
  if from != usize.MAX {
    run Vector<ClosureEdge>.append(&mut draft.edges, ClosureEdge {from: from, to: node, edge: Edge.copy(&edge), module: ModuleId.copy(&module), span: span})
  }
  let located = run locationOfInstance(&mut semantic.resolver, &key)
  let location = match move located {
    Option<InstanceLocation>.Some {value} => value
    Option<InstanceLocation>.None => { return Option<StaticClosure>.some(run closureGap(GapCode.CalleeModule, &application, span)) }
  }
  let backendName = run internBackendInstance(&mut semantic.resolver, &key, false)
  let declarationAccess277Request = Key {
    family: Family.EmissionInputs, module: location.module, name: backendName, declaration: location.declaration, member: usize.ZERO, external: false,
  }
  let declarationAccess277 = run internDeclaration(&mut semantic.resolver, declarationAccess277Request)
  let instanceAnswer = run demandRaw(&mut semantic.resolver, &mut semantic.query, declarationAccess277, Span.make(usize.ZERO, usize.ZERO))
  let instanceCanonicalFailure = Shared<Result<Answer, NoRejection>>.with<Option<CanonicalizationFailure>>(&instanceAnswer, answerCanonicalizationFailure)
  if let Option<CanonicalizationFailure>.Some {..} = move instanceCanonicalFailure {
    return Option<StaticClosure>.some(StaticClosure.Rejected {diagnostic: run reject(&semantic.resolver,
      &module, RejectionCode.Unsupported, span)})
  }
  let instanceRejection = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(&instanceAnswer, answerRejection)
  if let Option<Shared<Rejection>>.Some {value} = move instanceRejection { return Option<StaticClosure>.some(StaticClosure.Rejected {diagnostic: move value}) }
  let instanceGap = Shared<Result<Answer, NoRejection>>.with<Option<Shared<BackendGap>>>(&instanceAnswer, answerBackendGap)
  if let Option<Shared<BackendGap>>.Some {value} = move instanceGap {
    let mut gaps = Vector<Shared<BackendGap>>.make()
    run Vector<Shared<BackendGap>>.append(&mut gaps, move value)
    return Option<StaticClosure>.some(StaticClosure.Unsupported {gaps: move gaps})
  }
  let declarationAccess278Request = Key {
    family: Family.Mir, module: location.module, name: backendName, declaration: location.declaration, member: usize.ZERO, external: false,
  }
  let declarationAccess278 = run internDeclaration(&mut semantic.resolver, declarationAccess278Request)
  let mir = run demandRaw(&mut semantic.resolver, &mut semantic.query, declarationAccess278, Span.make(usize.ZERO, usize.ZERO))
  let canonicalFailure = Shared<Result<Answer, NoRejection>>.with<Option<CanonicalizationFailure>>(&mir, answerCanonicalizationFailure)
  if let Option<CanonicalizationFailure>.Some {..} = move canonicalFailure {
    return Option<StaticClosure>.some(StaticClosure.Rejected {diagnostic: run reject(&semantic.resolver,
      &module, RejectionCode.Unsupported, span)})
  }
  let mirRejection = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(&mir, answerRejection)
  if let Option<Shared<Rejection>>.Some {value} = move mirRejection { return Option<StaticClosure>.some(StaticClosure.Rejected {diagnostic: move value}) }
  let mirGap = Shared<Result<Answer, NoRejection>>.with<Option<Shared<BackendGap>>>(&mir, answerBackendGap)
  if let Option<Shared<BackendGap>>.Some {value} = move mirGap {
    let mut gaps = Vector<Shared<BackendGap>>.make()
    run Vector<Shared<BackendGap>>.append(&mut gaps, move value)
    return Option<StaticClosure>.some(StaticClosure.Unsupported {gaps: move gaps})
  }
  let mirIndex = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(&mir, answerMirIndex)
  let lowered = match move mirIndex {
    Option<usize>.Some {value} => value
    Option<usize>.None => { return Option<StaticClosure>.some(run closureGap(GapCode.TypedForm, &application, span)) }
  }
  if leave { run Vector<ClosureVisit>.append(&mut draft.pending, ClosureVisit.Leave) }
  let callerModule = resolvedModule(&semantic.resolver, location.module)
  let anchor = run instanceAnchor(&mut semantic.resolver, &key)
  let functions = Vector<MirFunction>.asSlice(&semantic.resolver.mirValues)
  let references = Vector<MirReference>.asSlice(&functions[lowered].references)
  let mut reference = usize.ZERO
  while reference < references.length {
    run Vector<ClosureVisit>.append(&mut draft.pending, ClosureVisit.Enter {
      key: InstanceKey.copy(&references[reference].key), from: node, edge: Edge.copy(&references[reference].edge),
      module: ModuleId.copy(&callerModule), span: anchoredSpan(&anchor, references[reference].origin),
    })
    reference = reference + usize.ONE
  }
  return Option<StaticClosure>.none()
}

effect fn walkChain(semantic: &mut Semantic, draft: &mut ClosureDraft, limit: usize, incoming: &ClosureIncoming, ancestors: &[Application]) -> StaticClosure
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  while Vector<ClosureVisit>.length(&draft.pending) > usize.ZERO {
    let last = Vector<ClosureVisit>.length(&draft.pending) - usize.ONE
    let visit = Vector<ClosureVisit>.remove(&mut draft.pending, last)
    match move visit {
      ClosureVisit.Leave => { Admission.leave(&mut draft.admission) }
      ClosureVisit.Enter {key, from, edge, module, span} => {
        let outcome = run enterChainNode(&mut semantic.*, &mut draft.*, move key, from, move edge, move module, span, incoming, limit)
        if let Option<StaticClosure>.Some {value} = move outcome { return move value }
      }
    }
  }
  let mut nodes = Vector<Application>.make()
  let listed = Vector<Application>.asSlice(&draft.nodes)
  let mut at = usize.ZERO
  while at < listed.length {
    run Vector<Application>.append(&mut nodes, run Application.copy(&listed[at]))
    at = at + usize.ONE
  }
  let mut edges = Vector<ClosureEdge>.make()
  let recorded = Vector<ClosureEdge>.asSlice(&draft.edges)
  at = usize.ZERO
  while at < recorded.length {
    run Vector<ClosureEdge>.append(&mut edges, ClosureEdge {
      from: recorded[at].from, to: recorded[at].to, edge: Edge.copy(&recorded[at].edge), module: ModuleId.copy(&recorded[at].module), span: recorded[at].span,
    })
    at = at + usize.ONE
  }
  let mut path = Vector<Application>.make()
  at = usize.ZERO
  while at < ancestors.length {
    run Vector<Application>.append(&mut path, run Application.copy(&ancestors[at]))
    at = at + usize.ONE
  }
  return StaticClosure.Certified {evidence: FiniteClosureEvidence {
    incoming: run copyClosureIncoming(incoming), ancestors: move path, nodes: move nodes, edges: move edges,
  }}
}

// A closure that the node budget ended before it closed: the pending path, the budget reached, and
// the module and span of the changing-static edge that opened the transaction.
effect fn rejectNotProven(module: &ModuleId, span: Span, related: Option<RelatedSite>, path: Vector<Application>, limit: usize) -> Shared<Rejection>
! OutOfMemoryError ? &mut Allocator {
  return run Shared<Rejection>.make(
    Rejection {
      code: RejectionCode.StaticRecursionNotProven,
      module: ModuleId.copy(module),
      span: span,
      related: move related,
      path: Vector<Shared<DeclarationId>>.make(),
      expected: limit,
      supplied: limit,
      parameterName: Bytes.make(),
      expectedKind: GenericKind.Type,
      suppliedKind: GenericKind.Type,
      witness: Option<WitnessProblem>.none(),
      termination: TerminationStep.Peer,
      staticFailure: Option<StaticDiagnostic>.none(),
      specialization: move path,
    },
  )
}

// `related` is the site of the changing-static edge whose closure transaction reached the growth.
effect fn rejectSpecialization(module: &ModuleId, span: Span, related: Option<RelatedSite>, path: Vector<Application>) -> Shared<
  Rejection,
> ! OutOfMemoryError ? &mut Allocator {
  return run Shared<Rejection>.make(
    Rejection {
      code: RejectionCode.ExpandingSpecialization,
      module: ModuleId.copy(module),
      span: span,
      related: move related,
      path: Vector<Shared<DeclarationId>>.make(),
      expected: usize.ZERO,
      supplied: usize.ZERO,
      parameterName: Bytes.make(),
      expectedKind: GenericKind.Type,
      suppliedKind: GenericKind.Type,
      witness: Option<WitnessProblem>.none(),
      termination: TerminationStep.Peer,
      staticFailure: Option<StaticDiagnostic>.none(),
      specialization: move path,
    },
  )
}

fn absurd<T>() -> T {
  let boom = 1 / 0
  return absurd<T>()
}

fn callableInvocationMode(value: &Type) -> CallableMode {
  return match &value.* {
    Type.Callable {mode, ..} => mode
    Type.Effect {mode, ..} => mode
    Type.CallableValue {contract, ..} => Shared<Type>.with<CallableMode>(&contract, callableInvocationMode)
    Type.CallableWitnessResult {witness} => {
      let recipe = Shared<WitnessRecipe>.with<WitnessRecipe>(&witness, CallableWitness.copy)
      return Shared<Type>.with<CallableMode>(&recipe.result, callableInvocationMode)
    }
    Type.CallableResult {contract, ..} => Shared<Type>.with<CallableMode>(&contract, callableInvocationMode)
    Type.CallableStage {contract, ..} => Shared<Type>.with<CallableMode>(&contract, callableInvocationMode)
    Type.CallableSchema {schema, ..} => Shared<Type>.with<CallableMode>(&sectionSchemaContract(&schema), callableInvocationMode)
    Type.EffectComposite {contract, ..} => Shared<Type>.with<CallableMode>(&contract, callableInvocationMode)
    Type.EffectJoin {contract, ..} => Shared<Type>.with<CallableMode>(&contract, callableInvocationMode)
    Type.OpaqueRepresentation {contract, ..} => Shared<Type>.with<CallableMode>(&contract, callableInvocationMode)
    _ => CallableMode.Once
  }
}

// A section blueprint binds target variables; selected values remain separate free evidence.
effect fn sectionContextUndetermined(contract: &Shared<Type>, owner: &DeclarationId) -> bool
! OutOfMemoryError ? &mut Allocator {
  let facts = match move run CallableContract.ofType(contract) {
    Option<CallableFacts>.Some {value} => move value
    _ => { return false }
  }
  let parameters = Vector<Shared<Type>>.asSlice(&facts.parameters)
  let mut at = usize.ZERO
  while at < parameters.length {
    if run typeMentionsOwner(&parameters[at], owner) { return true }
    at = at + usize.ONE
  }
  return run typeMentionsOwner(&facts.result, owner)
}

effect fn sectionInferenceOwner(resolver: &mut Resolver, target: &DeclarationId) -> DeclarationId
! OutOfMemoryError ? &mut Allocator {
  let mut scope = run Bytes.copy(b"\0section-use")
  run RuntimeEncoding.word(&mut scope, usize.toU64(resolver.nextInferenceId))
  resolver.nextInferenceId = resolver.nextInferenceId + usize.ONE
  return run DeclarationId.inference(target, Bytes.asSlice(&scope))
}

// Admission specializes a comparison contract, never the immutable value or its runtime key.
// Target binders are opened before the context is introduced, including recursive owner uses.
// With a pending call owner, positions mentioning its still-open variables are not evidence, and
// a contract those positions leave undetermined is absent rather than rejected.
effect fn contextualCallableContract(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, module: &ModuleId, declared: &[Constraint], actual: &Shared<Type>,
  promised: &Shared<Type>, pending: &Option<DeclarationId>, span: Span) -> Result<Option<Shared<Type>>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let schema = match move Shared<Type>.with<Option<Shared<SectionSchema>>>(actual, sectionSchemaOf) {
    Option<Shared<SectionSchema>>.Some {value} => move value
    _ => { return Result<Option<Shared<Type>>, Shared<Rejection>>.succeed(run valueCallableContract(actual, declared)) }
  }
  let mut wanted = match move run CallableContract.ofType(promised) {
    Option<CallableFacts>.Some {value} => move value
    _ => { return Result<Option<Shared<Type>>, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Unsupported, span)) }
  }
  let copied = run CallableSchema.copy(&schema)
  let target = DeclarationId.copyShared(&copied.target)
  let fresh = run sectionInferenceOwner(&mut resolver.*, &target)
  // Only the offered owner is inferable. A promise's invocation regions remain rigid and
  // cannot acquire the enclosing body's local-loan premises.
  let rigid = run DeclarationId.inference(&fresh, b"\0quantified-promise")
  let quantified = wanted.invocationBinders != usize.ZERO
  let mut premises = run copyConstraints(declared)
  if quantified {
    let original = Vector<Shared<Type>>.asSlice(&wanted.parameters)
    let mut parameters = Vector<Shared<Type>>.make()
    let mut at = usize.ZERO
    while at < original.length {
      if Type.containsInvocationQuantifier(&original[at]) {
        return Result<Option<Shared<Type>>, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Unsupported, span))
      }
      run Vector<Shared<Type>>.append(&mut parameters, run Type.openInvocation(&original[at], &rigid))
      at = at + usize.ONE
    }
    if Type.containsInvocationQuantifier(&wanted.result) {
      return Result<Option<Shared<Type>>, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Unsupported, span))
    }
    wanted.parameters = move parameters
    wanted.result = run Type.openInvocation(&wanted.result, &rigid)
    let bounds = Vector<Outlives>.asSlice(&wanted.invocationBounds)
    at = usize.ZERO
    while at < bounds.length {
      run Vector<Constraint>.append(&mut premises, Constraint.Outlives {
        longer: run Type.openInvocationLifetime(&bounds[at].longer, &rigid),
        shorter: run Type.openInvocationLifetime(&bounds[at].shorter, &rigid)})
      at = at + usize.ONE
    }
    // A marked `for<use 'call>` promise lends every input for the whole invocation extent.
    run invocationUseConstraints(Vector<Shared<Type>>.asSlice(&wanted.parameters), wanted.invocationUse,
      &Option<DeclarationId>.some(DeclarationId.copy(&rigid)), &mut premises)
  }
  // The section's own lifetimes stay open, held as evidence, so a bound below can shorten an
  // environment binder its captures fixed (`outlivesShortenedBinders`), as an invocation does.
  let mut held = Vector<Binding>.make()
  let actualInputs = run sectionFieldInputs(actual)
  let opened = match move run sectionSchemaSignature(&mut resolver.*, &mut owner.*, &mut dependencies.*, &schema,
    Vector<CallableFieldInput>.asSlice(&actualInputs), &fresh, module, span, true, &mut held) {
    Result<Shared<Result<Answer, NoRejection>>, Shared<Rejection>>.Success {value} => move value
    Result<Shared<Result<Answer, NoRejection>>, Shared<Rejection>>.Failure {error} => { return Result<Option<Shared<Type>>, Shared<Rejection>>.failResult(move error) }
  }
  let facts = match move Shared<Result<Answer, NoRejection>>.with<Option<SignatureFacts>>(&opened, signatureFacts) {
    Option<SignatureFacts>.Some {value} => move value
    _ => { return Result<Option<Shared<Type>>, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Unsupported, span)) }
  }
  if quantified && (Type.containsInvocationQuantifier(&facts.result) || Type.containsInvocationQuantifier(&facts.failure)) {
    return Result<Option<Shared<Type>>, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Unsupported, span))
  }
  let parameters = Vector<Shared<Type>>.asSlice(&wanted.parameters)
  if parameters.length != facts.parameters {
    return Result<Option<Shared<Type>>, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.IncompatibleCallableSignature, span))
  }
  let mut variables = Vector<Shared<DeclarationId>>.make()
  run Vector<Shared<DeclarationId>>.append(&mut variables, run Shared<DeclarationId>.make(DeclarationId.copy(&fresh)))
  let mut inferred = move held
  let mut at = usize.ZERO
  while at < parameters.length {
    let pattern = match move Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(&opened,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> { return signatureParameter(answer, at) }) {
      Option<Shared<Type>>.Some {value} => move value
      _ => { fail RevisionMismatch {} }
    }
    if quantified && Type.containsInvocationQuantifier(&pattern) {
      return Result<Option<Shared<Type>>, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Unsupported, span))
    }
    if !run mentionsPending(&parameters[at], pending) {
      run inferSectionCallableShape(&pattern, &parameters[at], Vector<Shared<DeclarationId>>.asSlice(&variables), &mut inferred)
    }
    at = at + usize.ONE
  }
  // Invoking an `effect fn` target constructs its Effect, whose channels carry the written result.
  let mut wantedResult = Shared<Type>.clone(&wanted.result)
  if facts.isEffect {
    let delayed = Shared<Type>.with<Option<EffectChannels>>(&wanted.result, effectChannels)
    if let Option<EffectChannels>.Some {value: channels} = move delayed {
      if !run mentionsPending(&channels.failure, pending) {
        run inferSectionCallableShape(&facts.failure, &channels.failure, Vector<Shared<DeclarationId>>.asSlice(&variables), &mut inferred)
      }
      wantedResult = move channels.success
    }
  }
  if !run mentionsPending(&wantedResult, pending) {
    run inferSectionCallableShape(&facts.result, &wantedResult, Vector<Shared<DeclarationId>>.asSlice(&variables), &mut inferred)
  }
  let freshIdentity = run Shared<DeclarationId>.make(DeclarationId.copy(&fresh))
  let inferenceFailure = run inferFromProviderBounds(&mut resolver.*, &mut owner.*, &mut dependencies.*, module,
    &opened, &freshIdentity, Vector<Constraint>.asSlice(&premises), &mut inferred, span)
  if let Option<Shared<Rejection>>.Some {value} = move inferenceFailure {
    return Result<Option<Shared<Type>>, Shared<Rejection>>.failResult(move value)
  }
  let undetermined = match &pending.* { Option<DeclarationId>.Some {..} => true _ => false }
  let mut closing = Vector<Binding>.make()
  if quantified {
    let mut request = Request.make()
    let source = match move run resolveTargetSchema(&mut resolver.*, &mut owner.*, &mut request,
      &mut dependencies.*, true, &target, span) {
      Option<TargetSchema>.Some {value} => move value
      _ => { return Result<Option<Shared<Type>>, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Unsupported, span)) }
    }
    let mapped = run quantifiedSectionSlots(&copied, &source, &opened, &fresh, &rigid,
      Vector<Binding>.asSlice(&inferred), wanted.invocationBinders)
    let slots = match move mapped {
      Option<Vector<QuantifiedSectionSlot>>.Some {value} => move value
      // Deferred type/row evidence containing invocation regions needs its own recipe proof.
      _ => { return Result<Option<Shared<Type>>, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Unsupported, span)) }
    }
    let retained = Vector<QuantifiedSectionSlot>.asSlice(&slots)
    let mut at = usize.ZERO
    while at < retained.length {
      if sectionInferenceOrdinal(&source, &opened, retained[at].original) != retained[at].dense {
        fail RevisionMismatch {}
      }
      run Vector<Binding>.append(&mut closing, Binding {
        declaration: run Shared<DeclarationId>.make(DeclarationId.copy(&rigid)), ordinal: retained[at].invocation,
        value: Argument.Lifetime {value: run Shared<Lifetime>.make(Lifetime.Invocation {ordinal: retained[at].invocation})}})
      at = at + usize.ONE
    }
  }
  drop run outlivesShortenedBinders(&mut resolver.*, &mut owner.*, &mut dependencies.*, &opened, &fresh, &mut inferred,
    Vector<Constraint>.asSlice(&premises), span)
  let mut bounds = Vector<Constraint>.make()
  at = usize.ZERO
  while at < facts.constraints {
    let bound = Shared<Result<Answer, NoRejection>>.with<Option<Constraint>>(&opened,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Constraint> { return signatureConstraintAt(answer, at) })
    if let Option<Constraint>.Some {value} = move bound {
      let applied = run bindConstraint(&value, Vector<Binding>.asSlice(&inferred))
      if run constraintMentionsOwner(&applied, &fresh) {
        if undetermined { return Result<Option<Shared<Type>>, Shared<Rejection>>.succeed(Option<Shared<Type>>.none()) }
        return Result<Option<Shared<Type>>, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.IncompatibleCallableSignature, span))
      }
      run Vector<Constraint>.append(&mut bounds, move applied)
    }
    at = at + usize.ONE
  }
  let failed = run proveAppliedBounds(&mut resolver.*, &mut owner.*, &mut dependencies.*, &premises,
    Vector<Constraint>.asSlice(&bounds), module, span, Option<BodyOrigin>.none())
  if let Option<Shared<Rejection>>.Some {value} = move failed { return Result<Option<Shared<Type>>, Shared<Rejection>>.failResult(move value) }
  let assigned = Vector<Binding>.asSlice(&inferred)
  let mut result = run Type.applyBindings(&facts.result, assigned, true)
  if facts.isEffect {
    let constructed = match move run effectValueResult(&mut resolver.*, &mut owner.*, &mut dependencies.*, &opened, assigned,
      Shared<Type>.clone(&result), run Type.applyBindings(&facts.failure, assigned, true),
      run Row.applyBindings(&facts.requirements, assigned, true), declared, span) {
      Result<Shared<Type>, Shared<Rejection>>.Success {value} => move value
      Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result<Option<Shared<Type>>, Shared<Rejection>>.failResult(move error) }
    }
    result = move constructed
  }
  let mut invocationBounds = Vector<Outlives>.make()
  let obligations = Vector<Constraint>.asSlice(&bounds)
  at = usize.ZERO
  while at < obligations.length {
    if let Constraint.Outlives {longer, shorter} = &obligations[at] {
      run Vector<Outlives>.append(&mut invocationBounds, Outlives {
        longer: run Type.applyLifetimeBindings(&longer, Vector<Binding>.asSlice(&closing)),
        shorter: run Type.applyLifetimeBindings(&shorter, Vector<Binding>.asSlice(&closing))})
    }
    at = at + usize.ONE
  }
  let mut invocationBinders = wanted.invocationBinders
  let mut invocationUse = wanted.invocationUse
  if !quantified {
    let source = match move run CallableContract.ofType(&copied.contract) {
      Option<CallableFacts>.Some {value} => move value
      _ => { fail RevisionMismatch {} }
    }
    invocationBinders = source.invocationBinders
    invocationUse = source.invocationUse
  }
  let contract = run sectionInstantiatedContract(&opened, &copied.contract, assigned, move result,
    invocationBinders, invocationUse, move invocationBounds)
  if run typeMentionsOwner(&contract, &fresh) {
    if undetermined { return Result<Option<Shared<Type>>, Shared<Rejection>>.succeed(Option<Shared<Type>>.none()) }
    return Result<Option<Shared<Type>>, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.IncompatibleCallableSignature, span))
  }
  if quantified {
    if run quantifiedSectionEnvironment(&contract, &fresh, &rigid) {
      return Result<Option<Shared<Type>>, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Unsupported, span))
    }
  }
  let closed = run Type.applyBindings(&contract, Vector<Binding>.asSlice(&closing), true)
  let retainsRigid = run typeMentionsOwner(&closed, &rigid)
  let retainsFresh = run typeMentionsOwner(&closed, &fresh)
  if retainsRigid || retainsFresh {
    return Result<Option<Shared<Type>>, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Unsupported, span))
  }
  return Result<Option<Shared<Type>>, Shared<Rejection>>.succeed(Option<Shared<Type>>.some(move closed))
}

// All three coordinates are proof-local. The immutable schema keeps its original ordinals.
struct QuantifiedSectionSlot {
  original: usize
  dense: usize
  invocation: usize
}

effect fn quantifiedSectionSlots(recipe: &SectionSchema, source: &TargetSchema,
  opened: &Shared<Result<Answer, NoRejection>>, fresh: &DeclarationId, rigid: &DeclarationId,
  inferred: &[Binding], count: usize) -> Option<Vector<QuantifiedSectionSlot>>
! OutOfMemoryError ? &mut Allocator {
  let own = Vector<ApplicationSlot>.asSlice(&source.own)
  let mut mapped = Vector<QuantifiedSectionSlot>.make()
  let mut at = usize.ZERO
  while at < inferred.length {
    if run argumentMentionsOwner(&inferred[at].value, rigid) {
      let identity = DeclarationId.copyShared(&inferred[at].declaration)
      if !DeclarationId.equals(&identity, fresh) { return Option<Vector<QuantifiedSectionSlot>>.none() }
      let invocation = match &inferred[at].value {
        Argument.Lifetime {value} => ownedLifetimeOrdinal(&value, rigid)
        _ => usize.MAX
      }
      if invocation >= count { return Option<Vector<QuantifiedSectionSlot>>.none() }
      let mut found = false
      let mut slot = usize.ZERO
      while slot < own.length {
        if own[slot].kind == GenericKind.Lifetime && containsOrdinal(&recipe.deferred, own[slot].ordinal)
          && sectionInferenceOrdinal(source, opened, own[slot].ordinal) == inferred[at].ordinal {
          run Vector<QuantifiedSectionSlot>.append(&mut mapped, QuantifiedSectionSlot {
            original: own[slot].ordinal, dense: inferred[at].ordinal, invocation: invocation})
          found = true
        }
        slot = slot + usize.ONE
      }
      if !found { return Option<Vector<QuantifiedSectionSlot>>.none() }
    }
    at = at + usize.ONE
  }
  return Option<Vector<QuantifiedSectionSlot>>.some(move mapped)
}

// Retained storage cannot depend on one invocation's private proof or quantifier.
effect fn quantifiedSectionEnvironment(contract: &Shared<Type>, fresh: &DeclarationId, rigid: &DeclarationId) -> bool
! OutOfMemoryError ? &mut Allocator {
  let facts = match move run CallableContract.ofType(contract) {
    Option<CallableFacts>.Some {value} => move value _ => { return true }
  }
  let regions = run callableEnvironmentRegions(&facts.environment)
  let listed = Vector<Shared<Lifetime>>.asSlice(&regions)
  let mut at = usize.ZERO
  while at < listed.length {
    let mut owned = Vector<usize>.make()
    run Type.collectOwnedLifetime(&listed[at], fresh, &mut owned)
    run Type.collectOwnedLifetime(&listed[at], rigid, &mut owned)
    run Type.collectLifetime(&listed[at], &mut owned)
    if Vector<usize>.length(&owned) != usize.ZERO { return true }
    at = at + usize.ONE
  }
  return false
}

// Whether a contextual position still mentions the calling inference's open variables.
effect fn mentionsPending(value: &Shared<Type>, pending: &Option<DeclarationId>) -> bool
! OutOfMemoryError ? &mut Allocator {
  return match &pending.* {
    Option<DeclarationId>.Some {value: caller} => run typeMentionsOwner(value, &caller)
    Option<DeclarationId>.None => false
  }
}

// Learn referent variables even when reference access or validity differs. This is inference
// only: CallableContract.compare proves the direction of access and lifetime conversion.
effect fn inferSectionCallableShape(pattern: &Shared<Type>, actual: &Shared<Type>,
  variables: &[Shared<DeclarationId>], inferred: &mut Vector<Binding>) -> ()
! OutOfMemoryError ? &mut Allocator | &mut Types {
  drop run Type.unify(pattern, actual, variables, Comparison.Exact, &mut inferred.*)
  let left = run Type.copy(pattern)
  let right = run Type.copy(actual)
  match move left {
    Type.Reference {referent, ..} => {
      if let Type.Reference {referent: other, ..} = move right {
        run inferSectionCallableShape(&referent, &other, variables, &mut inferred.*)
      }
    }
    Type.Slice {element, ..} => {
      if let Type.Slice {element: other, ..} = move right {
        run inferSectionCallableShape(&element, &other, variables, &mut inferred.*)
      }
    }
    _ => ()
  }
}

// The section's invocation contract under one use's bindings. The use supplies the instantiated
// result; like the blueprint's, it retains the regions the section captured.
effect fn sectionInstantiatedContract(signature: &Shared<Result<Answer, NoRejection>>, visible: &Shared<Type>, bindings: &[Binding],
  result: Shared<Type>, invocationBinders: usize, invocationUse: usize, invocationBounds: Vector<Outlives>) -> Shared<Type>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let facts = match move Shared<Result<Answer, NoRejection>>.with<Option<SignatureFacts>>(signature, signatureFacts) {
    Option<SignatureFacts>.Some {value} => move value _ => { return absurd<Shared<Type>>() }
  }
  let shape = match move run CallableContract.ofType(visible) {
    Option<CallableFacts>.Some {value} => move value _ => { return absurd<Shared<Type>>() }
  }
  let mut parameters = Vector<Shared<Type>>.make()
  let mut at = usize.ZERO
  while at < facts.parameters {
    let parameter = match move Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(signature,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> { return signatureParameter(answer, at) }) {
      Option<Shared<Type>>.Some {value} => move value _ => { return absurd<Shared<Type>>() }
    }
    run Vector<Shared<Type>>.append(&mut parameters, run Type.applyBindings(&parameter, bindings, true))
    at = at + usize.ONE
  }
  let regions = run callableEnvironmentRegions(&shape.environment)
  return run Types.intern(Type.Callable {mode: shape.mode, isUnsafe: shape.isUnsafe, environment: move shape.environment,
    invocationBinders: invocationBinders, invocationUse: invocationUse, invocationBounds: move invocationBounds,
    parameters: move parameters, result: run capturedEffectResult(move result, Vector<Shared<Lifetime>>.asSlice(&regions))})
}

union NamedSectionTarget {
  Application {value: Application, isPublic: bool},
  Schema {target: Shared<DeclarationId>, selected: Vector<Binding>, deferred: Vector<usize>},
}

fn genericSectionType(value: &Type) -> bool {
  return match &value.* { Type.CallableSchema {..} => true _ => false }
}

// Lifetime evidence is supplied by the remaining invocation operands, not stored as a capture. An
// `effect fn` target constructs its Effect at that invocation, so it defers the same way. A result
// that is itself an Effect value still needs the separate staging recipe: inspect the selected
// source result contract so a generic representation cannot hide an Effect after substitution.
effect fn sectionLifetimeDeferral(target: &DeclarationId, signature: &Shared<Result<Answer, NoRejection>>,
  inferred: &[Binding], declared: &[Constraint]) -> bool ! OutOfMemoryError ? &mut Allocator | &mut Types {
  if DeclarationId.kind(target) == OwnerKind.Anonymous { return true }
  let facts = match move Shared<Result<Answer, NoRejection>>.with<Option<SignatureFacts>>(signature, signatureFacts) {
    Option<SignatureFacts>.Some {value} => move value _ => { return false }
  }
  let result = run Type.applyBindings(&facts.result, inferred, true)
  let mut constraints = run copyConstraints(declared)
  let mut at = usize.ZERO
  while at < facts.constraints {
    let bound = Shared<Result<Answer, NoRejection>>.with<Option<Constraint>>(signature,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Constraint> { return signatureConstraintAt(answer, at) })
    if let Option<Constraint>.Some {value} = move bound {
      run Vector<Constraint>.append(&mut constraints, run bindConstraint(&value, inferred))
    }
    at = at + usize.ONE
  }
  return !(run sectionResultEffect(&result, Vector<Constraint>.asSlice(&constraints)))
}

// A promised union can select an exact Effect representation in one member. Check each
// selected member's exposed contract, including contracts supplied by caller premises.
effect fn sectionResultEffect(result: &Shared<Type>, constraints: &[Constraint]) -> bool
! OutOfMemoryError ? &mut Allocator | &mut Types {
  if Shared<Type>.with<bool>(result, effectStorageType) { return true }
  let selected = run Type.copy(result)
  if let Type.Union {members} = move selected {
    let listed = Vector<Shared<Type>>.asSlice(&members)
    let mut at = usize.ZERO
    while at < listed.length {
      if run sectionResultEffect(&listed[at], constraints) { return true }
      at = at + usize.ONE
    }
    return false
  }
  let exposed = run valueCallableContract(result, constraints)
  if let Option<Shared<Type>>.Some {value} = move exposed {
    return Shared<Type>.with<bool>(&value, effectStorageType)
  }
  return false
}

fn anonymousSectionType(value: &Type) -> bool {
  return match &value.* {
    Type.CallableSchema {schema, ..} => Shared<SectionSchema>.with<bool>(&schema, anonymousSectionRecipe)
    _ => false
  }
}

fn anonymousSectionRecipe(recipe: &SectionSchema) -> bool {
  return Shared<DeclarationId>.with<bool>(&recipe.target,
    fn(identity: &DeclarationId) -> bool { return DeclarationId.kind(identity) == OwnerKind.Anonymous })
}

fn sectionSchemaOf(value: &Type) -> Option<Shared<SectionSchema>> {
  return match &value.* { Type.CallableSchema {schema, ..} => Option<Shared<SectionSchema>>.some(Shared<SectionSchema>.clone(&schema)) _ => Option<Shared<SectionSchema>>.none() }
}

// The field inputs of a generic named section's capture record; empty for any other type.
effect fn sectionFieldInputs(value: &Shared<Type>) -> Vector<CallableFieldInput> ! OutOfMemoryError ? &mut Allocator {
  return match move run Type.copy(value) {
    Type.CallableSchema {fieldInputs, ..} => move fieldInputs
    _ => Vector<CallableFieldInput>.make()
  }
}

fn sectionSchemaContract(value: &Shared<SectionSchema>) -> Shared<Type> {
  return Shared<SectionSchema>.with<Shared<Type>>(value, fn(schema: &SectionSchema) -> Shared<Type> {
    return Shared<Type>.clone(&schema.contract)
  })
}

effect fn bindConstraint(value: &Constraint, bindings: &[Binding]) -> Constraint
! OutOfMemoryError ? &mut Allocator | &mut Types {
  return match &value.* {
    Constraint.Conforms {provider, contract} => Constraint.Conforms {
      provider: run Type.applyBindings(&provider, bindings, true), contract: run Type.applyBindings(&contract, bindings, true)}
    Constraint.Represents {parameter, contract} => Constraint.Represents {
      parameter: run Type.applyBindings(&parameter, bindings, true), contract: run Type.applyBindings(&contract, bindings, true)}
    Constraint.Contents {subject, region} => Constraint.Contents {
      subject: run Type.applyBindings(&subject, bindings, true), region: run Type.applyLifetimeBindings(&region, bindings)}
    Constraint.Outlives {longer, shorter} => Constraint.Outlives {
      longer: run Type.applyLifetimeBindings(&longer, bindings), shorter: run Type.applyLifetimeBindings(&shorter, bindings)}
    Constraint.Copyable {subject} => Constraint.Copyable {subject: run Type.applyBindings(&subject, bindings, true)}
    Constraint.Property {subject, property} => Constraint.Property {subject: run Type.applyBindings(&subject, bindings, true), property: property}
    Constraint.Provides {provider, selector, source} => Constraint.Provides {provider: run Type.applyBindings(&provider, bindings, true),
      selector: run Row.applyBindings(&selector, bindings, true), source: run Row.applyBindings(&source, bindings, true)}
    Constraint.FailureSubset {selected, source} => Constraint.FailureSubset {selected: run Type.applyBindings(&selected, bindings, true),
      source: run Type.applyBindings(&source, bindings, true)}
    Constraint.RequirementSubset {selected, source} => Constraint.RequirementSubset {selected: run Row.applyBindings(&selected, bindings, true),
      source: run Row.applyBindings(&source, bindings, true)}
  }
}

struct SectionSelection {
  selected: Vector<Binding>
  deferred: Vector<usize>
}

// The parameters of a `count`-parameter signature a section leaves open when its `supplied`
// arguments fill the ordinals from `first`: a section supplies a suffix, a bound method value its
// receiver, parameter zero (CALL-003).
effect fn openParameters(count: usize, first: usize, supplied: usize) -> Vector<usize>
! OutOfMemoryError ? &mut Allocator {
  let mut open = Vector<usize>.make()
  let mut at = usize.ZERO
  while at < count {
    if at < first || at >= first + supplied { run Vector<usize>.append(&mut open, at) }
    at = at + usize.ONE
  }
  return move open
}

// Collects the binders a section's still-unsupplied `open` parameters mention, including the
// invocation contracts of representation parameters they name. Only these are evidence a later
// invocation supplies; false when the signature lacks one of those parameters.
effect fn sectionEvidence(inference: &Shared<Result<Answer, NoRejection>>, fresh: &DeclarationId, inferred: &[Binding],
  open: &[usize], types: &mut Vector<usize>, lifetimes: &mut Vector<usize>, rows: &mut Vector<usize>) -> bool
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut at = usize.ZERO
  while at < open.length {
    let ordinal = open[at]
    let parameter = match move Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(inference,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> { return signatureParameter(answer, ordinal) }) {
      Option<Shared<Type>>.Some {value} => move value
      _ => { return false }
    }
    let applied = run Type.applyBindings(&parameter, inferred, true)
    run Type.collectOwned(&applied, fresh, &mut types.*, &mut lifetimes.*, &mut rows.*)
    at = at + usize.ONE
  }
  // Both written callable parameters and authored F: fn bounds expose their invocation
  // contract as part of the remaining parameter's source shape.
  let boundCount = Shared<Result<Answer, NoRejection>>.with<usize>(inference, signatureConstraintCount)
  let mut expanded = true
  while expanded {
    let before = Vector<usize>.length(&types.*) + Vector<usize>.length(&lifetimes.*) + Vector<usize>.length(&rows.*)
    at = usize.ZERO
    while at < boundCount {
      let bound = Shared<Result<Answer, NoRejection>>.with<Option<Constraint>>(inference,
        fn(answer: &Result<Answer, NoRejection>) -> Option<Constraint> { return signatureConstraintAt(answer, at) })
      if let Option<Constraint>.Some {value: Constraint.Represents {parameter, contract}} = move bound {
        let applied = run Type.applyBindings(&parameter, inferred, true)
        if run sectionEligibleRepresentation(&applied, fresh, &types.*) {
          let shape = run Type.applyBindings(&contract, inferred, true)
          run Type.collectOwned(&shape, fresh, &mut types.*, &mut lifetimes.*, &mut rows.*)
        }
      }
      at = at + usize.ONE
    }
    expanded = before != Vector<usize>.length(&types.*) + Vector<usize>.length(&lifetimes.*) + Vector<usize>.length(&rows.*)
  }
  return true
}

// Construction and later staging share the same bound-versus-free binder selection rule.
effect fn sectionSelection(resolver: &Resolver, module: &ModuleId, target: &DeclarationId,
  schema: &TargetSchema, inference: &Shared<Result<Answer, NoRejection>>,
  fresh: &DeclarationId, inferred: &[Binding], open: &[usize], constraints: &[Constraint], contextual: bool, span: Span)
  -> Result<SectionSelection, Shared<Rejection>>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  // Only variables mentioned by still-unsupplied parameters may be deferred. Result-only or
  // unused variables are not evidence available at a later invocation.
  let mut eligibleTypes = Vector<usize>.make()
  let mut eligibleLifetimes = Vector<usize>.make()
  let mut eligibleRows = Vector<usize>.make()
  if !run sectionEvidence(inference, fresh, inferred, open, &mut eligibleTypes, &mut eligibleLifetimes, &mut eligibleRows) {
    return Result<SectionSelection, Shared<Rejection>>.failResult(run reject(resolver, module, RejectionCode.Unsupported, span))
  }
  let boundCount = Shared<Result<Answer, NoRejection>>.with<usize>(inference, signatureConstraintCount)
  // An omitted provision selector `?S` whose provider or source row waits for a deferred operand
  // is inferred at the invocation (`inferProvidedSelectors`), so it defers with that operand. Any
  // other open selector has no later evidence and stays a named deferral. A written selector is
  // proved once the invocation infers the row.
  let freshIdentity = run Shared<DeclarationId>.make(DeclarationId.copy(fresh))
  let mut at = usize.ZERO
  while at < boundCount {
    let bound = Shared<Result<Answer, NoRejection>>.with<Option<Constraint>>(inference,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Constraint> { return signatureConstraintAt(answer, at) })
    if let Option<Constraint>.Some {value: Constraint.Provides {provider, selector, source}} = move bound {
      let applied = run Row.applyBindings(&selector, inferred, true)
      if run argumentMentionsOwner(&Argument.Row {value: Shared<Row>.clone(&applied)}, fresh) {
        let ordinal = Shared<Row>.with<usize>(&selector, fn(row: &Row) -> usize { return selectorOrdinalIn(row, &freshIdentity) })
        let appliedProvider = run Type.applyBindings(&provider, inferred, true)
        let appliedSource = run Row.applyBindings(&source, inferred, true)
        let providerPending = run typeMentionsOwner(&appliedProvider, fresh)
        let sourcePending = run argumentMentionsOwner(&Argument.Row {value: move appliedSource}, fresh)
        if ordinal == usize.MAX || !(providerPending || sourcePending) {
          return Result<SectionSelection, Shared<Rejection>>.failResult(run reject(resolver, module, RejectionCode.ProviderSectionUnavailable, span))
        }
        if !containsOrdinal(&eligibleRows, ordinal) { run Vector<usize>.append(&mut eligibleRows, ordinal) }
      }
    }
    at = at + usize.ONE
  }
  // With an expected callable contract, a binder only the result mentions would be inferred from
  // it; without one it is uninferred.
  let mut resultTypes = Vector<usize>.make()
  let mut resultLifetimes = Vector<usize>.make()
  let mut resultRows = Vector<usize>.make()
  let declaredResult = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(inference, signatureResult)
  if let Option<Shared<Type>>.Some {value: written} = move declaredResult {
    if contextual {
      let applied = run Type.applyBindings(&written, inferred, true)
      run Type.collectOwned(&applied, fresh, &mut resultTypes, &mut resultLifetimes, &mut resultRows)
    }
  }
  let ownSlots = Vector<ApplicationSlot>.asSlice(&schema.own)
  let count = ownSlots.length
  let mut selected = Vector<Binding>.make()
  let mut deferred = Vector<usize>.make()
  at = usize.ZERO
  while at < count {
    let dense = sectionInferenceOrdinal(schema, inference, ownSlots[at].ordinal)
    if dense == usize.MAX { return Result<SectionSelection, Shared<Rejection>>.failResult(run reject(resolver, module, RejectionCode.Unsupported, span)) }
    let supplied = bindingArgument(inferred, fresh, dense)
    if let Option<Argument>.Some {value} = move supplied {
      if run argumentMentionsOwner(&value, fresh) { return Result<SectionSelection, Shared<Rejection>>.failResult(run reject(resolver, module, RejectionCode.UninferredParameter, span)) }
      run Vector<Binding>.append(&mut selected, Binding {declaration: run Shared<DeclarationId>.make(DeclarationId.copy(target)),
        ordinal: ownSlots[at].ordinal, value: move value})
    } else {
      if !containsOrdinal(&eligibleTypes, dense) && !containsOrdinal(&eligibleLifetimes, dense) && !containsOrdinal(&eligibleRows, dense) {
        if containsOrdinal(&resultTypes, dense) || containsOrdinal(&resultRows, dense) {
          return Result<SectionSelection, Shared<Rejection>>.failResult(run reject(resolver, module, RejectionCode.SectionResultInferenceUnavailable, span))
        }
        return Result<SectionSelection, Shared<Rejection>>.failResult(run reject(resolver, module, RejectionCode.UninferredParameter, span))
      }
      // Rows are inferred at invocation like types. Eligible ordinary lifetime slots reopen
      // under their original schema identity; Effect-valued lifetime recipes remain separate.
      if !containsOrdinal(&eligibleTypes, dense) && !containsOrdinal(&eligibleRows, dense)
        && !(containsOrdinal(&eligibleLifetimes, dense) && (run sectionLifetimeDeferral(target, inference, inferred, constraints))) {
        return Result<SectionSelection, Shared<Rejection>>.failResult(run reject(resolver, module, RejectionCode.Unsupported, span))
      }
      run Vector<usize>.append(&mut deferred, ownSlots[at].ordinal)
    }
    at = at + usize.ONE
  }
  return Result<SectionSelection, Shared<Rejection>>.succeed(SectionSelection {
    selected: move selected, deferred: move deferred})
}

fn copySpan(value: &Option<Span>) -> Option<Span> {
  return match &value.* { Option<Span>.Some {value: span} => Option<Span>.some(span) Option<Span>.None => Option<Span>.none() }
}

effect fn copyNamedCallableEvidence(value: &NamedCallableEvidence) -> NamedCallableEvidence
! OutOfMemoryError ? &mut Allocator {
  let pending = match &value.pending {
    Option<DeclarationId>.Some {value: owner} => Option<DeclarationId>.some(DeclarationId.copy(&owner))
    Option<DeclarationId>.None => Option<DeclarationId>.none()
  }
  return NamedCallableEvidence {contract: Shared<Type>.clone(&value.contract), pending: move pending, call: copySpan(&value.call)}
}

// One invocation of a quantified promise binds a fresh region. An offered function whose result
// depends on a lifetime that region binds would let it outlive the invocation, so the selection is
// an incompatible callable rather than a deferral (CALLABLE-001, LIFE-004).
effect fn promisedInvocationEscape(inference: &Shared<Result<Answer, NoRejection>>, fresh: &DeclarationId,
  inferred: &[Binding], promised: &Option<NamedCallableEvidence>) -> bool
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let evidence = match &promised.* {
    Option<NamedCallableEvidence>.Some {value} => run copyNamedCallableEvidence(&value)
    Option<NamedCallableEvidence>.None => { return false }
  }
  let contract = match move run CallableContract.ofType(&evidence.contract) {
    Option<CallableFacts>.Some {value} => move value
    Option<CallableFacts>.None => { return false }
  }
  // Only a promised result independent of the invocation is judged here; a result the promise
  // relates to its invocation regions is the contract comparison's, and one the enclosing call
  // still infers is that call's inference.
  if contract.invocationBinders == usize.ZERO || Type.mentionsInvocation(&contract.result)
    || run mentionsPending(&contract.result, &evidence.pending) { return false }
  let facts = match move Shared<Result<Answer, NoRejection>>.with<Option<SignatureFacts>>(inference, signatureFacts) {
    Option<SignatureFacts>.Some {value} => move value
    Option<SignatureFacts>.None => { return false }
  }
  let parameters = Vector<Shared<Type>>.asSlice(&contract.parameters)
  if parameters.length != facts.parameters { return false }
  let mut bound = Vector<usize>.make()
  let mut at = usize.ZERO
  while at < parameters.length {
    let pattern = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(inference,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> { return signatureParameter(answer, at) })
    if let Option<Shared<Type>>.Some {value} = move pattern {
      run Type.collectInvocationBound(&run Type.applyBindings(&value, inferred, true), &parameters[at], fresh, &mut bound)
    }
    at = at + usize.ONE
  }
  if Vector<usize>.length(&bound) == usize.ZERO { return false }
  // Invoking an `effect fn` stores its arguments in the Effect it constructs (EFF-001), so that
  // Effect retains every region an invocation binds in them.
  if facts.isEffect { return true }
  let mut lifetimes = Vector<usize>.make()
  run Type.collectExposedLifetimes(&run Type.applyBindings(&facts.result, inferred, true), fresh, &mut lifetimes)
  let escaping = Vector<usize>.asSlice(&lifetimes)
  at = usize.ZERO
  while at < escaping.length {
    if containsOrdinal(&bound, escaping[at]) { return true }
    at = at + usize.ONE
  }
  return false
}

// A named function used as a value takes the type and row binders no supplied argument fixed
// from the callable contract its use site promises: the offered parameters accept the promised
// ones and the offered result is the promised result (CALLABLE-001). This includes the binders of
// an enclosing generic impl, as in `Option.some` passed as a `once fn(u8) -> Option<u8>`.
// Lifetime binders stay open, so the invocation's operands supply them as for any section.
effect fn inferFromPromisedContract(inference: &Shared<Result<Answer, NoRejection>>, fresh: &DeclarationId,
  promised: &Option<NamedCallableEvidence>, inferred: &mut Vector<Binding>) -> ()
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let evidence = match &promised.* {
    Option<NamedCallableEvidence>.Some {value} => run copyNamedCallableEvidence(&value)
    Option<NamedCallableEvidence>.None => { return () }
  }
  let wanted = match move run CallableContract.ofType(&evidence.contract) {
    Option<CallableFacts>.Some {value} => move value
    Option<CallableFacts>.None => { return () }
  }
  let facts = match move Shared<Result<Answer, NoRejection>>.with<Option<SignatureFacts>>(inference, signatureFacts) {
    Option<SignatureFacts>.Some {value} => move value
    Option<SignatureFacts>.None => { return () }
  }
  let parameters = Vector<Shared<Type>>.asSlice(&wanted.parameters)
  if parameters.length != facts.parameters { return () }
  let mut variables = Vector<Shared<DeclarationId>>.make()
  run Vector<Shared<DeclarationId>>.append(&mut variables, run Shared<DeclarationId>.make(DeclarationId.copy(fresh)))
  let mut learned = Vector<Binding>.make()
  let known = Vector<Binding>.asSlice(&inferred.*)
  let mut at = usize.ZERO
  while at < known.length {
    run Vector<Binding>.append(&mut learned, Binding {declaration: Shared<DeclarationId>.clone(&known[at].declaration),
      ordinal: known[at].ordinal, value: Argument.copy(&known[at].value)})
    at = at + usize.ONE
  }
  let start = known.length
  at = usize.ZERO
  while at < parameters.length {
    let pattern = match move Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(inference,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> { return signatureParameter(answer, at) }) {
      Option<Shared<Type>>.Some {value} => move value
      Option<Shared<Type>>.None => { return () }
    }
    if !run mentionsPending(&parameters[at], &evidence.pending) {
      run inferSectionCallableShape(&pattern, &parameters[at], Vector<Shared<DeclarationId>>.asSlice(&variables), &mut learned)
    }
    at = at + usize.ONE
  }
  // Invoking an `effect fn` constructs an Effect; its written result is the success channel.
  let mut wantedResult = Shared<Type>.clone(&wanted.result)
  if facts.isEffect {
    let delayed = Shared<Type>.with<Option<EffectChannels>>(&wanted.result, effectChannels)
    if let Option<EffectChannels>.Some {value: channels} = move delayed {
      if !run mentionsPending(&channels.failure, &evidence.pending) {
        run inferSectionCallableShape(&facts.failure, &channels.failure,
          Vector<Shared<DeclarationId>>.asSlice(&variables), &mut learned)
      }
      wantedResult = move channels.success
    }
  }
  if !run mentionsPending(&wantedResult, &evidence.pending) {
    run inferSectionCallableShape(&facts.result, &wantedResult,
      Vector<Shared<DeclarationId>>.asSlice(&variables), &mut learned)
  }
  // A representation binder needs an exact callable or Effect, which a promised contract is not.
  let mut representations = Vector<usize>.make()
  let bounds = Shared<Result<Answer, NoRejection>>.with<usize>(inference, signatureConstraintCount)
  at = usize.ZERO
  while at < bounds {
    let bound = Shared<Result<Answer, NoRejection>>.with<Option<Constraint>>(inference,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Constraint> { return signatureConstraintAt(answer, at) })
    if let Option<Constraint>.Some {value: Constraint.Represents {parameter, ..}} = move bound {
      let ordinal = Shared<Type>.with<usize>(&parameter, fn(value: &Type) -> usize { return Type.parameterOrdinalOf(value, fresh) })
      if ordinal != usize.MAX { run Vector<usize>.append(&mut representations, ordinal) }
    }
    at = at + usize.ONE
  }
  // A promised region stands for the use site's call, not for this value's invocations, so a
  // binding that lends one is left to the invocation as well, as is a callable or Effect contract.
  let found = Vector<Binding>.asSlice(&learned)
  at = start
  while at < found.length {
    let deferred = match &found[at].value {
      Argument.Lifetime {..} => true
      Argument.Type {value} => Type.containsViewBorrow(&value) || Shared<Type>.with<bool>(&value, fn(ty: &Type) -> bool {
        return match &ty.* { Type.Callable {..} => true Type.Effect {..} => true _ => false }
      })
      Argument.Row {..} => false
    }
    let open = match move bindingArgumentAt(Vector<Binding>.asSlice(&inferred.*), found[at].ordinal) {
      Option<Argument>.Some {..} => false
      Option<Argument>.None => true
    }
    let pending = match &evidence.pending {
      Option<DeclarationId>.Some {value} => run argumentMentionsOwner(&found[at].value, &value)
      Option<DeclarationId>.None => false
    }
    if !deferred && !pending && open && !containsOrdinal(&representations, found[at].ordinal) {
      run Vector<Binding>.append(&mut inferred.*, Binding {declaration: Shared<DeclarationId>.clone(&found[at].declaration),
        ordinal: found[at].ordinal, value: Argument.copy(&found[at].value)})
    }
    at = at + usize.ONE
  }
  return ()
}

// A result-only section binder has inference evidence when an expected callable contract is
// present, or when a whole function is used as a value: its consumer proves a contract. A value
// whose use site already knows that contract takes such binders from it before any deferral.
fn sectionContext(expected: &Option<Shared<Type>>, valueConstruction: bool) -> bool {
  return valueConstruction || match &expected.* {
    Option<Shared<Type>>.Some {value} => Shared<Type>.with<bool>(&value, callableType)
    _ => false
  }
}

effect fn finishDeferredNamedSection(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  request: &mut Request, dependencies: &mut Vector<Dependency>, module: &ModuleId, cursor: &AuthoredCursor, caller: &DeclarationId,
  nodes: &mut Vector<BodyNode>, expression: HirId, span: Span, target: &DeclarationId,
  signature: &Shared<Result<Answer, NoRejection>>, applied: &[Argument], inference: &Shared<Result<Answer, NoRejection>>,
  fresh: &DeclarationId, inferred: &[Binding], open: &[usize], first: usize, arguments: Vector<BodyNodeId>,
  constraints: &[Constraint], expected: &Option<Shared<Type>>, mismatchCode: RejectionCode, contractBody: bool, contextual: bool)
  -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let resolved = run resolveTargetSchema(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, true, target, span)
  let schema = match move resolved {
    Option<TargetSchema>.Some {value} => move value
    _ => { return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span) }
  }
  if Shared<Result<Answer, NoRejection>>.with<usize>(signature, signatureStaticCount) != usize.ZERO {
    return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
  }

  let mut choice = match move run sectionSelection(&resolver.*, module, target, &schema, inference,
    fresh, inferred, open, constraints, contextual, span) {
    Result<SectionSelection, Shared<Rejection>>.Success {value} => move value
    Result<SectionSelection, Shared<Rejection>>.Failure {error} => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move error) }
  }
  let scoped = match move run sectionScopeSelection(&resolver.*, module, &schema, signature, applied, fresh, inferred, span) {
    Result<Vector<Binding>, Shared<Rejection>>.Success {value} => move value
    Result<Vector<Binding>, Shared<Rejection>>.Failure {error} => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move error) }
  }
  let enclosing = Vector<Binding>.asSlice(&scoped)
  let mut scopeAt = usize.ZERO
  while scopeAt < enclosing.length {
    run Vector<Binding>.append(&mut choice.selected, Binding {declaration: Shared<DeclarationId>.clone(&enclosing[scopeAt].declaration),
      ordinal: enclosing[scopeAt].ordinal, value: Argument.copy(&enclosing[scopeAt].value)})
    scopeAt = scopeAt + usize.ONE
  }
  let mut fixedBounds = Vector<Constraint>.make()
  let bounds = Shared<Result<Answer, NoRejection>>.with<usize>(inference, signatureConstraintCount)
  let mut at = usize.ZERO
  while at < bounds {
    let found = Shared<Result<Answer, NoRejection>>.with<Option<Constraint>>(inference,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Constraint> { return signatureConstraintAt(answer, at) })
    if let Option<Constraint>.Some {value} = move found {
      let applied = run bindConstraint(&value, inferred)
      if !run constraintMentionsOwner(&applied, fresh) { run Vector<Constraint>.append(&mut fixedBounds, move applied) }
    }
    at = at + usize.ONE
  }
  let declared = run copyConstraints(constraints)
  let refused = run proveAppliedBounds(&mut resolver.*, &mut owner.*, &mut dependencies.*, &declared,
    Vector<Constraint>.asSlice(&fixedBounds), module, span, Option<BodyOrigin>.none())
  if let Option<Shared<Rejection>>.Some {value} = move refused { return Result<BodyNodeId, Shared<Rejection>>.failResult(move value) }
  let mut result = match move Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(signature, signatureResult) {
    Option<Shared<Type>>.Some {value} => move value
    _ => { return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span) }
  }
  let noBindings = Vector<Binding>.make()
  if Shared<Result<Answer, NoRejection>>.with<bool>(signature, signatureIsEffect) {
    // Run access is proved with the caller's bounds over the target's open parameters; a Copy
    // proof that needs the target's own bounds fails, which only makes the access stricter.
    let promised = match move run effectValueResult(&mut resolver.*, &mut owner.*, &mut dependencies.*, signature,
      Vector<Binding>.asSlice(&noBindings), Shared<Type>.clone(&result), run signatureFailure(signature), run signatureRequirements(signature),
      constraints, span) {
      Result<Shared<Type>, Shared<Rejection>>.Success {value} => move value
      Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move error) }
    }
    result = move promised
  }
  return run finishNamedSection(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor, caller, &mut nodes.*,
    expression, span, signature, Vector<Binding>.asSlice(&noBindings),
    NamedSectionTarget.Schema {target: run Shared<DeclarationId>.make(DeclarationId.copy(target)),
      selected: move choice.selected, deferred: move choice.deferred}, open, first, move arguments, move result, constraints, expected, mismatchCode, contractBody)
}

effect fn sectionEligibleRepresentation(value: &Shared<Type>, owner: &DeclarationId, eligible: &Vector<usize>) -> bool
! OutOfMemoryError ? &mut Allocator {
  let mut types = Vector<usize>.make()
  let mut lifetimes = Vector<usize>.make()
  let mut rows = Vector<usize>.make()
  run Type.collectOwned(value, owner, &mut types, &mut lifetimes, &mut rows)
  let found = Vector<usize>.asSlice(&types)
  let mut at = usize.ZERO
  while at < found.length {
    if containsOrdinal(eligible, found[at]) { return true }
    at = at + usize.ONE
  }
  return false
}

// Open target variables before inserting selected caller evidence. In a recursive owner the
// selected evidence may have the very same declaration/ordinal as a bound blueprint variable.
effect fn sectionOriginalSignature(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, target: &DeclarationId, span: Span) -> Shared<Result<Answer, NoRejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let targetModuleAt = knownModuleOrdinal(&resolver.*, DeclarationId.moduleId(target))
  if targetModuleAt == usize.MAX { fail InvalidModulePath {} }
  let targetModule = resolvedModule(&resolver.*, targetModuleAt)
  let identity = run Shared<DeclarationId>.make(DeclarationId.copy(target))
  let targetAt = match move run ordinalOfIdentity(&mut resolver.*, &targetModule, &identity) {
    Option<usize>.Some {value} => value _ => { fail RevisionMismatch {} }
  }
  let declarationAccess279Request = Key {
    family: Family.Signature, module: targetModuleAt, name: usize.ZERO, declaration: targetAt,
    member: usize.ZERO, external: false}
  let declarationAccess279 = run internDeclaration(&mut resolver.*, declarationAccess279Request)
  return run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, declarationAccess279, span)
}

// Opening a signature lists participating scope slots first, then every own slot. Selection
// retains original owner/ordinal pairs; the fresh dense ordinal exists only for inference.
fn sectionInferenceOrdinal(schema: &TargetSchema, opened: &Shared<Result<Answer, NoRejection>>, original: usize) -> usize {
  let count = Shared<Result<Answer, NoRejection>>.with<usize>(opened, signatureBinderCount)
  let slots = Vector<ApplicationSlot>.asSlice(&schema.own)
  if count < slots.length { return usize.MAX }
  let mut at = usize.ZERO
  while at < slots.length {
    if slots[at].ordinal == original { return count - slots.length + at }
    at = at + usize.ONE
  }
  return usize.MAX
}

effect fn sectionScopeInferenceOrdinal(schema: &TargetSchema, original: &Shared<Result<Answer, NoRejection>>,
  identity: &DeclarationId, ordinal: usize) -> usize ! OutOfMemoryError ? &mut Allocator {
  let scopes = Vector<ApplicationScope>.asSlice(&schema.scopes)
  let mut dense = usize.ZERO
  let mut scopeAt = usize.ZERO
  while scopeAt < scopes.length {
    let owner = DeclarationId.copyShared(&scopes[scopeAt].owner)
    let slots = Vector<ApplicationSlot>.asSlice(&scopes[scopeAt].slots)
    let mut at = usize.ZERO
    while at < slots.length {
      if Shared<Result<Answer, NoRejection>>.with<bool>(original,
        fn(answer: &Result<Answer, NoRejection>) -> bool { return signatureListsSlot(answer, &owner, slots[at]) }) {
        if DeclarationId.equals(identity, &owner) && slots[at].ordinal == ordinal { return dense }
        dense = dense + usize.ONE
      }
      at = at + usize.ONE
    }
    scopeAt = scopeAt + usize.ONE
  }
  return usize.MAX
}

// An enclosing impl's binders are fixed when a section is constructed, by written arguments, the
// supplied suffix, an applied owner or a function value's promised contract, and travel as
// selected owner evidence. Only the target's own binders may wait for the invocation; a schema
// cannot defer an impl binder. An applied owner's signature lists none of the impl's slots: its
// application supplies each of them in order, as `resolveAppliedInherent` does. Otherwise an impl
// slot the signature does not list has no evidence at construction.
effect fn sectionScopeSelection(resolver: &Resolver, module: &ModuleId, schema: &TargetSchema,
  original: &Shared<Result<Answer, NoRejection>>, applied: &[Argument], fresh: &DeclarationId, inferred: &[Binding], span: Span)
  -> Result<Vector<Binding>, Shared<Rejection>>
! OutOfMemoryError ? &mut Allocator {
  let mut selected = Vector<Binding>.make()
  let scopes = Vector<ApplicationScope>.asSlice(&schema.scopes)
  let mut scopeAt = usize.ZERO
  while scopeAt < scopes.length {
    let owner = DeclarationId.copyShared(&scopes[scopeAt].owner)
    let slots = Vector<ApplicationSlot>.asSlice(&scopes[scopeAt].slots)
    let mut at = usize.ZERO
    while at < slots.length {
      let dense = run sectionScopeInferenceOrdinal(schema, original, &owner, slots[at].ordinal)
      let mut supplied = Option<Argument>.none()
      if dense != usize.MAX { supplied = bindingArgument(inferred, fresh, dense) }
      else if slots[at].ordinal < applied.length { supplied = Option<Argument>.some(Argument.copy(&applied[slots[at].ordinal])) }
      let value = match move supplied {
        Option<Argument>.Some {value} => move value
        Option<Argument>.None => { return Result<Vector<Binding>, Shared<Rejection>>.failResult(run reject(resolver, module, RejectionCode.Unsupported, span)) }
      }
      if run argumentMentionsOwner(&value, fresh) {
        return Result<Vector<Binding>, Shared<Rejection>>.failResult(run reject(resolver, module, RejectionCode.UninferredParameter, span))
      }
      run Vector<Binding>.append(&mut selected, Binding {declaration: Shared<DeclarationId>.clone(&scopes[scopeAt].owner),
        ordinal: slots[at].ordinal, value: move value})
      at = at + usize.ONE
    }
    scopeAt = scopeAt + usize.ONE
  }
  return Result<Vector<Binding>, Shared<Rejection>>.succeed(move selected)
}

// Every retained enclosing slot remains free construction evidence, including phantom slots.
effect fn sectionScopeArguments(schema: &TargetSchema, selected: &[Binding]) -> Option<Vector<Argument>>
! OutOfMemoryError ? &mut Allocator {
  let mut output = Vector<Argument>.make()
  let scopes = Vector<ApplicationScope>.asSlice(&schema.scopes)
  let mut scopeAt = usize.ZERO
  while scopeAt < scopes.length {
    let owner = DeclarationId.copyShared(&scopes[scopeAt].owner)
    let slots = Vector<ApplicationSlot>.asSlice(&scopes[scopeAt].slots)
    let mut at = usize.ZERO
    while at < slots.length {
      let argument = bindingArgument(selected, &owner, slots[at].ordinal)
      if let Option<Argument>.Some {value} = move argument { run Vector<Argument>.append(&mut output, move value) }
      else { return Option<Vector<Argument>>.none() }
      at = at + usize.ONE
    }
    scopeAt = scopeAt + usize.ONE
  }
  return Option<Vector<Argument>>.some(move output)
}

// The target parameters a section already bound, in capture order, opened onto `fresh` like its
// invocation signature, so a held binder's variance in them is known when the invocation would
// move it.
effect fn sectionCapturedParameters(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, schema: &Shared<SectionSchema>, inputs: &[CallableFieldInput],
  fresh: &DeclarationId, module: &ModuleId, span: Span) -> Result<Vector<Shared<Type>>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let copied = run CallableSchema.copy(schema)
  let target = DeclarationId.copyShared(&copied.target)
  let original = run sectionOriginalSignature(&mut resolver.*, &mut owner.*, &mut dependencies.*, &target, span)
  let mut request = Request.make()
  let resolved = match move run resolveTargetSchema(&mut resolver.*, &mut owner.*, &mut request,
    &mut dependencies.*, true, &target, span) {
    Option<TargetSchema>.Some {value} => move value
    _ => { return Result<Vector<Shared<Type>>, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Unsupported, span)) }
  }
  let opened = match move run callInferenceSignature(&resolver.*, &original, &resolved, fresh, false, module, span) {
    Result<Shared<Result<Answer, NoRejection>>, Shared<Rejection>>.Success {value} => move value
    Result<Shared<Result<Answer, NoRejection>>, Shared<Rejection>>.Failure {error} => { return Result<Vector<Shared<Type>>, Shared<Rejection>>.failResult(move error) }
  }
  let all = run signatureParameterTypes(&opened)
  let listed = Vector<Shared<Type>>.asSlice(&all)
  let mut captured = Vector<Shared<Type>>.make()
  let mut at = usize.ZERO
  while at < inputs.length {
    if let Option<usize>.Some {value: ordinal} = move CallableFieldInput.parameter(&inputs[at]) {
      if ordinal >= listed.length {
        return Result<Vector<Shared<Type>>, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Unsupported, span))
      }
      run Vector<Shared<Type>>.append(&mut captured, Shared<Type>.clone(&listed[ordinal]))
    }
    at = at + usize.ONE
  }
  return Result<Vector<Shared<Type>>, Shared<Rejection>>.succeed(move captured)
}

// The section's invocation signature: the target parameters its `inputs` leave open, in order.
// With `holdLifetimes`, selected target lifetimes stay open binders and are appended to `held` as
// inference evidence, so an invocation can tell a lifetime its section bound from a written one.
effect fn sectionSchemaSignature(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, schema: &Shared<SectionSchema>, inputs: &[CallableFieldInput], fresh: &DeclarationId,
  module: &ModuleId, span: Span, holdLifetimes: bool, held: &mut Vector<Binding>)
  -> Result<Shared<Result<Answer, NoRejection>>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let copied = run CallableSchema.copy(schema)
  let target = DeclarationId.copyShared(&copied.target)
  let original = run sectionOriginalSignature(&mut resolver.*, &mut owner.*, &mut dependencies.*, &target, span)
  let mut request = Request.make()
  let resolved = match move run resolveTargetSchema(&mut resolver.*, &mut owner.*, &mut request,
    &mut dependencies.*, true, &target, span) {
    Option<TargetSchema>.Some {value} => move value
    _ => { return Result<Shared<Result<Answer, NoRejection>>, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Unsupported, span)) }
  }
  let opened = match move run callInferenceSignature(&resolver.*, &original, &resolved, fresh, false, module, span) {
    Result<Shared<Result<Answer, NoRejection>>, Shared<Rejection>>.Success {value} => move value
    Result<Shared<Result<Answer, NoRejection>>, Shared<Rejection>>.Failure {error} => { return Result<Shared<Result<Answer, NoRejection>>, Shared<Rejection>>.failResult(move error) }
  }
  let facts = match move Shared<Result<Answer, NoRejection>>.with<Option<SignatureFacts>>(&opened, signatureFacts) {
    Option<SignatureFacts>.Some {value} => move value
    _ => { return Result<Shared<Result<Answer, NoRejection>>, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Unsupported, span)) }
  }
  let mut seed = Vector<Binding>.make()
  let chosen = Vector<Binding>.asSlice(&copied.selected)
  let mut at = usize.ZERO
  while at < chosen.length {
    let identity = DeclarationId.copyShared(&chosen[at].declaration)
    let own = DeclarationId.equals(&target, &identity)
    let mut dense = run sectionScopeInferenceOrdinal(&resolved, &original, &identity, chosen[at].ordinal)
    if own { dense = sectionInferenceOrdinal(&resolved, &opened, chosen[at].ordinal) }
    if dense != usize.MAX {
      let selected = Binding {declaration: run Shared<DeclarationId>.make(DeclarationId.copy(fresh)),
        ordinal: dense, value: Argument.copy(&chosen[at].value)}
      let lifetime = match &chosen[at].value { Argument.Lifetime {..} => true _ => false }
      if own && lifetime && holdLifetimes {
        run Vector<Binding>.append(&mut held.*, move selected)
      } else {
        run Vector<Binding>.append(&mut seed, move selected)
      }
    }
    at = at + usize.ONE
  }
  let remaining = match move run CallableContract.ofType(&copied.contract) {
    Option<CallableFacts>.Some {value} => Vector<Shared<Type>>.length(&value.parameters)
    _ => { return Result<Shared<Result<Answer, NoRejection>>, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Unsupported, span)) }
  }
  let mut parameters = Vector<Shared<Type>>.make()
  at = usize.ZERO
  while at < remaining {
    let ordinal = CallableFieldInput.openOrdinal(inputs, at)
    let parameter = match move Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(&opened,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> { return signatureParameter(answer, ordinal) }) {
      Option<Shared<Type>>.Some {value} => move value
      _ => { fail RevisionMismatch {} }
    }
    run Vector<Shared<Type>>.append(&mut parameters, run Type.applyBindings(&parameter, Vector<Binding>.asSlice(&seed), true))
    at = at + usize.ONE
  }
  let mut types = Vector<Shared<Type>>.make()
  let mut lifetimes = Vector<Shared<Lifetime>>.make()
  let mut rows = Vector<RowParameter>.make()
  at = usize.ZERO
  while at < facts.binders {
    let binder = Shared<Result<Answer, NoRejection>>.with<Option<InferenceBinder>>(&opened,
      fn(answer: &Result<Answer, NoRejection>) -> Option<InferenceBinder> { return inferenceBinderAt(answer, at) })
    match move binder {
      Option<InferenceBinder>.Some {value: InferenceBinder.Type {value}} => { run Vector<Shared<Type>>.append(&mut types, move value) }
      Option<InferenceBinder>.Some {value: InferenceBinder.Lifetime {value}} => { run Vector<Shared<Lifetime>>.append(&mut lifetimes, move value) }
      Option<InferenceBinder>.Some {value: InferenceBinder.Row {value}} => { run Vector<RowParameter>.append(&mut rows, move value) }
      _ => { fail RevisionMismatch {} }
    }
    at = at + usize.ONE
  }
  let mut constraints = Vector<Constraint>.make()
  at = usize.ZERO
  while at < facts.constraints {
    let bound = Shared<Result<Answer, NoRejection>>.with<Option<Constraint>>(&opened,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Constraint> { return signatureConstraintAt(answer, at) })
    if let Option<Constraint>.Some {value} = move bound {
      run Vector<Constraint>.append(&mut constraints, run bindConstraint(&value, Vector<Binding>.asSlice(&seed)))
    }
    at = at + usize.ONE
  }
  let value = memberSuccess(Value.Signature {signature: Signature {
    typeParameters: move types, callableParameterStart: facts.callableParameterStart,
    lifetimeParameters: move lifetimes, rowParameters: move rows, parameters: move parameters,
    constraints: move constraints, result: run Type.applyBindings(&facts.result, Vector<Binding>.asSlice(&seed), true),
    failure: run Type.applyBindings(&facts.failure, Vector<Binding>.asSlice(&seed), true),
    requirements: run Row.applyBindings(&facts.requirements, Vector<Binding>.asSlice(&seed), true),
    isEffect: facts.isEffect, isVariadic: facts.isVariadic, isUnsafe: facts.isUnsafe, isStatic: false,
    staticSlots: Vector<usize>.make(), environment: Option<Intersection>.none()}}, Vector<Dependency>.make())
  return Result<Shared<Result<Answer, NoRejection>>, Shared<Rejection>>.succeed(
    run Shared<Result<Answer, NoRejection>>.make(Result<Answer, NoRejection>.succeed(move value)))
}

// Complete immutable construction evidence with this invocation's fresh inference result.
// No application or function key is published while any deferred target slot is absent.
effect fn schemaCallableCall(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, body: &Shared<TypedBody>, node: BodyNodeId, caller: &Application,
  callerBindings: &[Binding], projections: &[RuntimeProjection], inputs: CallableCallInputs, schema: Shared<SectionSchema>,
  captures: Vector<Shared<Type>>, fieldInputs: Vector<CallableFieldInput>, written: &[Shared<Type>], anchor: &Anchor) -> Result<MirCallTarget, PreparationFailure>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let module = DeclarationId.moduleId(Application.bodyDeclaration(caller))
  let mut premises = match move run closedApplicationPremises(&mut resolver.*, &mut owner.*, &mut dependencies.*,
    caller, callerBindings, BodyOrigin.span(inputs.origin, anchor)) {
    Option<Vector<Constraint>>.Some {value} => move value _ => { return Result<MirCallTarget, PreparationFailure>.failResult(PreparationFailure.Coverage {code: GapCode.TypedForm}) }
  }
  run retainedCallRelations(body, BodyOrigin.span(inputs.origin, anchor), callerBindings, &mut premises, anchor)
  let application = match move run schemaCallableApplication(&mut resolver.*, &mut owner.*, &mut dependencies.*,
    module, callerBindings, Vector<Constraint>.asSlice(&premises), &schema, Vector<CallableFieldInput>.asSlice(&fieldInputs),
    written, BodyOrigin.span(inputs.origin, anchor)) {
    Result<Application, PreparationFailure>.Success {value} => move value
    Result<Application, PreparationFailure>.Failure {error} => { return Result<MirCallTarget, PreparationFailure>.failResult(move error) }
  }
  let mode = Shared<Type>.with<CallableMode>(&sectionSchemaContract(&schema), callableInvocationMode)
  if DeclarationId.kind(Application.bodyDeclaration(&application)) == OwnerKind.Anonymous && Vector<CallableFieldInput>.length(&fieldInputs) == usize.ZERO {
    let environment = run Type.callableSchema(move schema, move captures, move fieldInputs)
    return run anonymousCallableCall(&mut resolver.*, &mut owner.*, &mut dependencies.*, body, node, caller,
      callerBindings, projections, move inputs, mode, move environment, run Shared<Application>.make(move application), written, false, anchor)
  }
  return run sectionCallableCall(&mut resolver.*, &mut owner.*, &mut dependencies.*, body, node, caller,
    callerBindings, projections, move inputs, mode, run Shared<Application>.make(move application), move captures, move fieldInputs, written, anchor)
}

// The region relations a body retained for one call's operands, those whose origin lies within
// the call, are premises of that call's bound proofs at lowering as they were at typing.
effect fn retainedCallRelations(body: &Shared<TypedBody>, span: Span, bindings: &[Binding], premises: &mut Vector<Constraint>, anchor: &Anchor) -> ()
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let count = Shared<TypedBody>.with<usize>(body, bodyObligationCount)
  let mut at = usize.ZERO
  while at < count {
    let found = Shared<TypedBody>.with<Option<RetainedRelation>>(body,
      fn(value: &TypedBody) -> Option<RetainedRelation> { return retainedRelationAt(value, at, anchor) })
    if let Option<RetainedRelation>.Some {value: relation} = move found {
      if relation.span.start >= span.start && relation.span.end <= span.end {
        let premise = Constraint.Outlives {longer: Shared<Lifetime>.clone(&relation.offered),
          shorter: Shared<Lifetime>.clone(&relation.wanted)}
        run Vector<Constraint>.append(&mut premises.*, run bindConstraint(&premise, bindings))
      }
    }
    at = at + usize.ONE
  }
  // A region the instance binds to a lifetime parameter is valid for the whole call, so it covers
  // that parameter and, through it, every loan rooted in the body. Lowering proves bounds over
  // the bound regions while a body's own loans stay local, as they were at typing.
  at = usize.ZERO
  while at < bindings.length {
    if let Argument.Lifetime {value: region} = &bindings[at].value {
      let parameter = Lifetime.Parameter {declaration: DeclarationId.copyShared(&bindings[at].declaration), ordinal: bindings[at].ordinal}
      run Vector<Constraint>.append(&mut premises.*, Constraint.Outlives {longer: Shared<Lifetime>.clone(&region),
        shorter: run Shared<Lifetime>.make(move parameter)})
    }
    at = at + usize.ONE
  }
  return ()
}

// One retained region relation and the source span of the value it admitted.
struct RetainedRelation {
  span: Span
  offered: Shared<Lifetime>
  wanted: Shared<Lifetime>
}

fn bodyObligationCount(body: &TypedBody) -> usize {
  let stage = TypedBody.checkingStage(body)
  if let BodyStage.ContractTyped {obligations} = &stage.* { return Vector<BodySafetyObligation>.length(&obligations) }
  return usize.ZERO
}

fn retainedRelationAt(body: &TypedBody, at: usize, anchor: &Anchor) -> Option<RetainedRelation> {
  let stage = TypedBody.checkingStage(body)
  if let BodyStage.ContractTyped {obligations} = &stage.* {
    let entries = Vector<BodySafetyObligation>.asSlice(&obligations)
    if at < entries.length {
      if let BodySafetyObligation.RegionRelation {origin, offered, wanted} = &entries[at] {
        return Option<RetainedRelation>.some(RetainedRelation {span: BodyOrigin.span(origin, anchor), offered: Shared<Lifetime>.clone(&offered),
          wanted: Shared<Lifetime>.clone(&wanted)})
      }
    }
  }
  return Option<RetainedRelation>.none()
}

// Whether a section's bounds hold under its inferred bindings and the caller's premises; a bound
// still naming an unbound binder of the section does not.
effect fn sectionApplicationBounds(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, opened: &Shared<Result<Answer, NoRejection>>, fresh: &DeclarationId,
  inferred: &[Binding], declared: &Vector<Constraint>, module: &ModuleId, span: Span) -> bool
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let boundsCount = Shared<Result<Answer, NoRejection>>.with<usize>(opened, signatureConstraintCount)
  let mut appliedBounds = Vector<Constraint>.make()
  let mut boundAt = usize.ZERO
  while boundAt < boundsCount {
    let bound = Shared<Result<Answer, NoRejection>>.with<Option<Constraint>>(opened,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Constraint> { return signatureConstraintAt(answer, boundAt) })
    if let Option<Constraint>.Some {value} = move bound {
      let selected = run bindConstraint(&value, inferred)
      if run constraintMentionsOwner(&selected, fresh) { return false }
      run Vector<Constraint>.append(&mut appliedBounds, move selected)
    }
    boundAt = boundAt + usize.ONE
  }
  let failure = run proveAppliedBounds(&mut resolver.*, &mut owner.*, &mut dependencies.*, declared,
    Vector<Constraint>.asSlice(&appliedBounds), module, span, Option<BodyOrigin>.none())
  if let Option<Shared<Rejection>>.Some {..} = move failure { return false }
  return true
}

// Selects the original schema application from checked operand types, without replaying transfers.
effect fn schemaCallableApplication(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, module: &ModuleId, callerBindings: &[Binding], premises: &[Constraint],
  schema: &Shared<SectionSchema>, inputs: &[CallableFieldInput], supplied: &[Shared<Type>], span: Span)
  -> Result<Application, PreparationFailure>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let copied = run CallableSchema.copy(schema)
  let target = DeclarationId.copyShared(&copied.target)
  let mut request = Request.make()
  let sourceSchema = match move run resolveTargetSchema(&mut resolver.*, &mut owner.*, &mut request,
    &mut dependencies.*, true, &target, span) {
    Option<TargetSchema>.Some {value} => move value
    _ => { return Result<Application, PreparationFailure>.failResult(PreparationFailure.Coverage {code: GapCode.TypedForm}) }
  }
  let fresh = run sectionInferenceOwner(&mut resolver.*, &target)
  // The section's own lifetimes stay open, held as evidence, so the bounds below can shorten an
  // environment binder exactly as the invocation's checking did (`shortenedEnvironmentBinder`).
  let mut held = Vector<Binding>.make()
  let opened = match move run sectionSchemaSignature(&mut resolver.*, &mut owner.*, &mut dependencies.*, schema, inputs, &fresh,
    module, span, true, &mut held) {
    Result<Shared<Result<Answer, NoRejection>>, Shared<Rejection>>.Success {value} => move value
    _ => { return Result<Application, PreparationFailure>.failResult(PreparationFailure.Coverage {code: GapCode.TypedForm}) }
  }
  let mut variables = Vector<Shared<DeclarationId>>.make()
  run Vector<Shared<DeclarationId>>.append(&mut variables, run Shared<DeclarationId>.make(DeclarationId.copy(&fresh)))
  let mut inferred = Vector<Binding>.make()
  let evidence = Vector<Binding>.asSlice(&held)
  let mut heldAt = usize.ZERO
  while heldAt < evidence.length {
    run Vector<Binding>.append(&mut inferred, Binding {declaration: Shared<DeclarationId>.clone(&evidence[heldAt].declaration),
      ordinal: evidence[heldAt].ordinal, value: run Argument.applyBindings(&evidence[heldAt].value, callerBindings, true)})
    heldAt = heldAt + usize.ONE
  }
  let mut operandAt = usize.ZERO
  while operandAt < supplied.length {
    let pattern = match move Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(&opened,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> { return signatureParameter(answer, operandAt) }) {
      Option<Shared<Type>>.Some {value} => move value
      _ => { return Result<Application, PreparationFailure>.failResult(PreparationFailure.Coverage {code: GapCode.TypedForm}) }
    }
    let actual = run Type.applyBindings(&supplied[operandAt], callerBindings, true)
    run inferSectionCallableShape(&pattern, &actual, Vector<Shared<DeclarationId>>.asSlice(&variables), &mut inferred)
    operandAt = operandAt + usize.ONE
  }
  let freshIdentity = run Shared<DeclarationId>.make(DeclarationId.copy(&fresh))
  let inferenceFailure = run inferFromProviderBounds(&mut resolver.*, &mut owner.*, &mut dependencies.*, module,
    &opened, &freshIdentity, premises, &mut inferred, span)
  if let Option<Shared<Rejection>>.Some {..} = move inferenceFailure {
    return Result<Application, PreparationFailure>.failResult(PreparationFailure.Coverage {code: GapCode.TypedForm})
  }
  let selectorFailure = run inferProvidedSelectors(&mut resolver.*, &mut owner.*, &mut dependencies.*, module,
    &opened, &freshIdentity, &fresh, premises, &mut inferred, span)
  if let Option<Shared<Rejection>>.Some {..} = move selectorFailure {
    return Result<Application, PreparationFailure>.failResult(PreparationFailure.Coverage {code: GapCode.TypedForm})
  }
  let declared = run copyConstraints(premises)
  let mut shortened = false
  let mut proved = run sectionApplicationBounds(&mut resolver.*, &mut owner.*, &mut dependencies.*, &opened, &fresh,
    Vector<Binding>.asSlice(&inferred), &declared, module, span)
  if !proved {
    // A piped Effect may retain a region the held environment binder does not cover, and a
    // `'longer: 'binder` bound may name a region the held binder outlives; each shortens to the meet
    // exactly as the invocation's checking did, then the bounds are proved again.
    let captured = match move run sectionCapturedParameters(&mut resolver.*, &mut owner.*, &mut dependencies.*, schema,
      inputs, &fresh, module, span) {
      Result<Vector<Shared<Type>>, Shared<Rejection>>.Success {value} => move value
      _ => { return Result<Application, PreparationFailure>.failResult(PreparationFailure.Coverage {code: GapCode.TypedForm}) }
    }
    let noExplicit = Vector<usize>.make()
    let boundsCount = Shared<Result<Answer, NoRejection>>.with<usize>(&opened, signatureConstraintCount)
    let mut boundAt = usize.ZERO
    while boundAt < boundsCount {
      let bound = Shared<Result<Answer, NoRejection>>.with<Option<Constraint>>(&opened,
        fn(answer: &Result<Answer, NoRejection>) -> Option<Constraint> { return signatureConstraintAt(answer, boundAt) })
      if let Option<Constraint>.Some {value: Constraint.Represents {parameter: representation, contract}} = move bound {
        let source = run Type.applyBindings(&representation, Vector<Binding>.asSlice(&inferred), true)
        if run shortenedEnvironmentBinder(&mut resolver.*, &mut owner.*, &mut dependencies.*, &contract, &source, &opened,
          Vector<Shared<Type>>.asSlice(&captured), &fresh, Vector<Shared<DeclarationId>>.asSlice(&variables), &mut inferred,
          Vector<usize>.asSlice(&noExplicit), premises, span) {
          shortened = true
        }
      }
      boundAt = boundAt + usize.ONE
    }
    if run outlivesShortenedBinders(&mut resolver.*, &mut owner.*, &mut dependencies.*, &opened, &fresh, &mut inferred,
      premises, span) {
      shortened = true
    }
    if shortened {
      proved = run sectionApplicationBounds(&mut resolver.*, &mut owner.*, &mut dependencies.*, &opened, &fresh,
        Vector<Binding>.asSlice(&inferred), &declared, module, span)
    }
  }
  if !proved { return Result<Application, PreparationFailure>.failResult(PreparationFailure.Coverage {code: GapCode.TypedForm}) }
  let mut bindings = Vector<Binding>.make()
  let selected = Vector<Binding>.asSlice(&copied.selected)
  let mut at = usize.ZERO
  while at < selected.length {
    // A held lifetime that the bounds shortened takes that region; every other selection is as bound.
    let mut value = Argument.copy(&selected[at].value)
    let own = Shared<DeclarationId>.with<bool>(&selected[at].declaration,
      fn(declaration: &DeclarationId) -> bool { return DeclarationId.equals(declaration, &target) })
    let lifetime = match &selected[at].value { Argument.Lifetime {..} => true _ => false }
    if shortened && own && lifetime {
      let dense = sectionInferenceOrdinal(&sourceSchema, &opened, selected[at].ordinal)
      if let Option<Argument>.Some {value: settled} = move bindingArgument(Vector<Binding>.asSlice(&inferred), &fresh, dense) {
        value = move settled
      }
    }
    run Vector<Binding>.append(&mut bindings, Binding {declaration: Shared<DeclarationId>.clone(&selected[at].declaration),
      ordinal: selected[at].ordinal, value: move value})
    at = at + usize.ONE
  }
  let deferred = Vector<usize>.asSlice(&copied.deferred)
  at = usize.ZERO
  while at < deferred.length {
    let found = bindingArgument(Vector<Binding>.asSlice(&inferred), &fresh, sectionInferenceOrdinal(&sourceSchema, &opened, deferred[at]))
    let argument = match move found {
      Option<Argument>.Some {value} => run Argument.applyBindings(&value, callerBindings, true)
      _ => { return Result<Application, PreparationFailure>.failResult(PreparationFailure.Coverage {code: GapCode.TypedForm}) }
    }
    if run argumentMentionsOwner(&argument, &fresh) { return Result<Application, PreparationFailure>.failResult(PreparationFailure.Coverage {code: GapCode.TypedForm}) }
    run Vector<Binding>.append(&mut bindings, Binding {declaration: Shared<DeclarationId>.clone(&copied.target),
      ordinal: deferred[at], value: move argument})
    at = at + usize.ONE
  }
  let slots = Vector<ApplicationSlot>.asSlice(&sourceSchema.own)
  let mut arguments = Vector<Argument>.make()
  at = usize.ZERO
  while at < slots.length {
    let argument = match move bindingArgument(Vector<Binding>.asSlice(&bindings), &target, slots[at].ordinal) {
      Option<Argument>.Some {value} => move value
      _ => { return Result<Application, PreparationFailure>.failResult(PreparationFailure.Coverage {code: GapCode.TypedForm}) }
    }
    if run argumentMentionsOwner(&argument, &fresh) { return Result<Application, PreparationFailure>.failResult(PreparationFailure.Coverage {code: GapCode.TypedForm}) }
    run Vector<Argument>.append(&mut arguments, move argument)
    at = at + usize.ONE
  }
  let original = run sectionOriginalSignature(&mut resolver.*, &mut owner.*, &mut dependencies.*, &target, span)
  let scopes = match move run sectionScopeArguments(&sourceSchema, Vector<Binding>.asSlice(&bindings)) {
    Option<Vector<Argument>>.Some {value} => move value
    _ => { return Result<Application, PreparationFailure>.failResult(PreparationFailure.Coverage {code: GapCode.TypedForm}) }
  }
  let application = match move run checkedDirectApplication(&mut resolver.*, &mut owner.*, &mut request,
    &mut dependencies.*, &target, &original, move arguments, &scopes, module, span) {
    Result<Application, Shared<Rejection>>.Success {value} => move value
    _ => { return Result<Application, PreparationFailure>.failResult(PreparationFailure.Coverage {code: GapCode.TypedForm}) }
  }
  return Result<Application, PreparationFailure>.succeed(move application)
}

// The first conformance bound a complete root application fails to prove. Region relations are
// checked by the caller's typing; only a conformance can select code by region.
effect fn rootConformanceRefusal(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  application: &Application, module: &ModuleId, span: Span) -> Option<Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut dependencies = Vector<Dependency>.make()
  let bindings = run Application.bindings(application)
  let declared = match move run closedApplicationPremises(&mut resolver.*, &mut owner.*, &mut dependencies, application,
    Vector<Binding>.asSlice(&bindings), span) {
    Option<Vector<Constraint>>.Some {value} => move value
    Option<Vector<Constraint>>.None => { return Option<Shared<Rejection>>.none() }
  }
  let mut conformances = Vector<Constraint>.make()
  let listed = Vector<Constraint>.asSlice(&declared)
  let mut at = usize.ZERO
  while at < listed.length {
    if let Constraint.Conforms {provider, contract} = &listed[at] {
      run Vector<Constraint>.append(&mut conformances, Constraint.Conforms {provider: Shared<Type>.clone(&provider),
        contract: Shared<Type>.clone(&contract)})
    }
    at = at + usize.ONE
  }
  let assumptions = Vector<Constraint>.make()
  return run proveAppliedBounds(&mut resolver.*, &mut owner.*, &mut dependencies, &assumptions,
    Vector<Constraint>.asSlice(&conformances), module, span, Option<BodyOrigin>.none())
}

// The caller body's premises (`bodyPremises`) under the application's bindings: what lowering may
// assume while it proves a call again, exactly as typing assumed it.
effect fn closedApplicationPremises(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, caller: &Application, bindings: &[Binding], span: Span) -> Option<Vector<Constraint>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let bodyOwner = run Shared<DeclarationId>.make(DeclarationId.copy(Application.bodyDeclaration(caller)))
  let location = match move run locationOfIdentity(&mut resolver.*, &bodyOwner) {
    Option<InstanceLocation>.Some {value} => value _ => { return Option<Vector<Constraint>>.none() }
  }
  let premises = match move run bodyPremises(&mut resolver.*, &mut owner.*, &mut dependencies.*, location.module,
    location.declaration) {
    Result<Vector<Constraint>, Shared<Rejection>>.Success {value} => move value
    _ => { return Option<Vector<Constraint>>.none() }
  }
  let listed = Vector<Constraint>.asSlice(&premises)
  let mut output = Vector<Constraint>.make()
  let mut at = usize.ZERO
  while at < listed.length {
    run Vector<Constraint>.append(&mut output, run bindConstraint(&listed[at], bindings))
    at = at + usize.ONE
  }
  return Option<Vector<Constraint>>.some(move output)
}

// The finalized header retains only listed original slots. Optional phantom impl parameters
// remain absent, matching ordinary application admission, while hidden representations are own slots.
effect fn formalOpaqueApplication(resolver: &mut Resolver, module: &ModuleId, declaration: usize,
  producer: &DeclarationId, types: &[Shared<Type>], lifetimes: &[Shared<Lifetime>], rows: &[RowParameter]) -> Application
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut own = Vector<Argument>.make()
  let mut ownOrdinals = Vector<usize>.make()
  let mut scopes = Vector<ScopeBinding>.make()
  let mut identity = DeclarationId.copy(producer)
  let mut ordinal = declaration
  while true {
    let mut selected = Vector<ApplicationSlot>.make()
    let mut at = usize.ZERO
    while at < types.length + lifetimes.length + rows.length {
      if let Option<ApplicationSlot>.Some {value} = move ownedSlot(types, lifetimes, rows, &identity, at) {
        run insertApplicationSlot(&mut selected, value)
      }
      at = at + usize.ONE
    }
    let slots = Vector<ApplicationSlot>.asSlice(&selected)
    let mut arguments = Vector<Argument>.make()
    at = usize.ZERO
    while at < slots.length {
      run Vector<Argument>.append(&mut arguments, run scopeArgument(&identity, slots[at].ordinal, slots[at].kind))
      at = at + usize.ONE
    }
    let ordinals = run applicationOrdinals(slots)
    if DeclarationId.equals(&identity, producer) { own = move arguments ownOrdinals = move ordinals }
    else if slots.length > usize.ZERO {
      run Vector<ScopeBinding>.insert(&mut scopes, usize.ZERO, ScopeBinding {
        owner: run Shared<DeclarationId>.make(DeclarationId.copy(&identity)),
        arguments: move arguments, argumentOrdinals: move ordinals})
    }
    let parent = run enclosingIdentity(&mut resolver.*, module, ordinal)
    if let Option<DeclarationId>.Some {value} = move parent {
      identity = move value
      let shared = run Shared<DeclarationId>.make(DeclarationId.copy(&identity))
      let found = run ordinalOfIdentity(&mut resolver.*, module, &shared)
      ordinal = match move found { Option<usize>.Some {value: next} => next _ => { fail RevisionMismatch {} } }
    } else { break }
  }
  return Application {target: SpecializationTarget.Named {declaration: DeclarationId.copy(producer)},
    arguments: move own, argumentOrdinals: move ownOrdinals, scopes: move scopes, statics: Vector<StaticSlot>.make()}
}


fn nominalTestReferenceRegion(value: &Type) -> Option<Shared<Lifetime>> {
  if let Type.Reference {access, lifetime, ..} = &value.* {
    if access == Access.Shared { return Option<Shared<Lifetime>>.some(Shared<Lifetime>.clone(&lifetime)) }
  }
  return Option<Shared<Lifetime>>.none()
}

fn nominalTestBodyRegion(checked: &TypedBody) -> Option<Shared<Lifetime>> {
  let nodes = TypedBody.nodeSlice(checked)
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {ty, ..} = &nodes[at].kind {
      let borrowed = Shared<Type>.with<Option<Shared<Lifetime>>>(&ty, nominalTestReferenceRegion)
      if let Option<Shared<Lifetime>>.Some {value} = move borrowed { return Option<Shared<Lifetime>>.some(move value) }
    }
    at = at + usize.ONE
  }
  return Option<Shared<Lifetime>>.none()
}

fn nominalTestParameterRegion(value: &Type) -> Option<Shared<Lifetime>> {
  if let Type.Nominal {arguments, ..} = &value.* {
    let listed = Vector<Argument>.asSlice(&arguments)
    if listed.length == usize.ONE {
      if let Argument.Lifetime {value: validity} = &listed[usize.ZERO] {
        return Option<Shared<Lifetime>>.some(Shared<Lifetime>.clone(&validity))
      }
    }
  }
  return Option<Shared<Lifetime>>.none()
}

// A caller-owned Local cannot be written as a source generic argument. This private actor test
// uses the real checked loan and source signatures, differing only in explicit-ordinal metadata.
effect fn nominalRegionExplicitOrdinalClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run ModuleId.make(b"memory", b"example", b"nominal-explicit-local.silk")
  let authored = Option<Bytes>.some(run Bytes.copy(b"struct Request<'a> { value: string<'a> }\nfn caller() -> i32 { let value = 1 let loan = &value return 0 }\nfn target<'a>(client: &'a i32, value: Request<'a>) -> i32 { return 42 }\nfn staticValue(value: Request<'static>) -> i32 { return 0 }\n"))
  let revision = run Revision.publish(&Revision.make(), &id, &authored)
  let mut store = Semantic.make(move revision, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu), Option<FinalProfile>.none())
  let mut request = Request.make()
  let inventory = run Semantic.demandSourceInventory(&mut store, &mut request, &id)
  let syntax = match move inventory {
    SourceInventory.Present {syntax, ..} => move syntax
    _ => { run Testing.expect(false, "the actual source census must be present") return () }
  }
  let functions = Vector<NamedFunction>.asSlice(&syntax.functions)
  run Testing.expect(functions.length == 3, "the source supplies exactly the caller and two real signatures")
  let caller = DeclarationId.copy(&functions[usize.ZERO].declaration.identity)
  let declared = DeclarationId.copy(&functions[usize.ONE].declaration.identity)
  run Testing.expect(DeclarationId.named(&caller, b"caller") && DeclarationId.named(&declared, b"target"),
    "caller and callee are full source-derived canonical identities")
  let answer = run Semantic.demandBody(&mut store, &mut request, &id, b"caller")
  let body = match move Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(&answer, answerTypedBody) {
    Option<Shared<TypedBody>>.Some {value} => move value
    _ => { run Testing.expect(false, "the loan comes from a genuinely successful checked body") return () }
  }
  let observed = Shared<TypedBody>.with<Option<Shared<Lifetime>>>(&body, nominalTestBodyRegion)
  let region = match move observed {
    Option<Shared<Lifetime>>.Some {value} => move value
    _ => { run Testing.expect(false, "the checked caller retains its actual reference lifetime") return () }
  }
  run Testing.expect(callerLocalRegion(&region, &caller), "this is the actual caller's Local, not a foreign loan")
  let signature = run Semantic.demandSignature(&mut store, &mut request, &id, b"target")
  let original = match move Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(&signature,
    fn(value: &Result<Answer, NoRejection>) -> Option<Shared<Type>> { return signatureParameter(value, usize.ONE) }) {
    Option<Shared<Type>>.Some {value} => move value
    _ => { run Testing.expect(false, "the original parameter comes from the checked target header") return () }
  }
  let staticSignature = run Semantic.demandSignature(&mut store, &mut request, &id, b"staticValue")
  let evidence = match move Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(&staticSignature,
    fn(value: &Result<Answer, NoRejection>) -> Option<Shared<Type>> { return signatureParameter(value, usize.ZERO) }) {
    Option<Shared<Type>>.Some {value} => move value
    _ => { run Testing.expect(false, "the Static nominal is actual source signature evidence") return () }
  }
  let writtenRegion = match move Shared<Type>.with<Option<Shared<Lifetime>>>(&original, nominalTestParameterRegion) {
    Option<Shared<Lifetime>>.Some {value} => move value
    _ => { run Testing.expect(false, "the original nominal has one actual lifetime slot") return () }
  }
  let ordinal = Shared<Lifetime>.with<usize>(&writtenRegion,
    fn(value: &Lifetime) -> usize { return lifetimeOrdinalOf(value, &declared) })
  run Testing.expect(ordinal != usize.MAX, "the explicit slot is the original source callee's actual lifetime ordinal")
  let fresh = run DeclarationId.inference(&declared, b"explicit-local-negative")
  let parameter = run Type.renameParameters(&original, &declared, &fresh)
  let mut variables = Vector<Shared<DeclarationId>>.make()
  let variable = run Shared<DeclarationId>.make(DeclarationId.copy(&fresh))
  run Vector<Shared<DeclarationId>>.append(&mut variables, Shared<DeclarationId>.clone(&variable))
  let mut bindings = Vector<Binding>.make()
  run Vector<Binding>.append(&mut bindings, Binding {declaration: Shared<DeclarationId>.clone(&variable),
    ordinal: ordinal, value: Argument.Lifetime {value: Shared<Lifetime>.clone(&region)}})
  let pattern = run Type.applyBindings(&parameter, Vector<Binding>.asSlice(&bindings), true)
  let initialSlice = Vector<Binding>.asSlice(&bindings)
  let initialBinding = &initialSlice[usize.ZERO]
  let mut originalProof = Vector<Binding>.make()
  run Vector<Binding>.append(&mut originalProof, Binding {declaration: Shared<DeclarationId>.clone(&initialBinding.declaration),
    ordinal: initialBinding.ordinal, value: Argument.copy(&initialBinding.value)})
  let originalFailure = run Type.unify(&parameter, &evidence, Vector<Shared<DeclarationId>>.asSlice(&variables), Comparison.Exact, &mut originalProof)
  run Testing.expect(match &originalFailure { Unification.Unified => false _ => true }, "the implicit operand starts with a real exact mismatch")
  let mut dependencies = Vector<Dependency>.make()
  let mut explicit = Vector<usize>.make()
  let premises = Vector<Constraint>.make()
  let implicit = run relatedCallArgument(&mut store.resolver, &mut store.query, &mut dependencies,
    &parameter, &pattern, &evidence, &fresh, &caller, Vector<Shared<DeclarationId>>.asSlice(&variables),
    Vector<Binding>.asSlice(&bindings), Vector<usize>.asSlice(&explicit), Vector<Constraint>.asSlice(&premises), Span.make(usize.ZERO, usize.ONE))
  let mut implicitProven = false
  if let Option<RelatedArgument>.Some {value} = &implicit {
    implicitProven = Vector<RegionPair>.length(&value.relations) == usize.ZERO
  }
  run Testing.expect(implicitProven,
    "the implicit slot has a real tracked covariant member proof, and Static storage needs no open relation")
  run Testing.expect(Vector<Dependency>.length(&dependencies) > usize.ZERO, "the proof retains actual member-query dependencies")
  run Vector<usize>.append(&mut explicit, ordinal)
  let fixed = run relatedCallArgument(&mut store.resolver, &mut store.query, &mut dependencies,
    &parameter, &pattern, &evidence, &fresh, &caller, Vector<Shared<DeclarationId>>.asSlice(&variables),
    Vector<Binding>.asSlice(&bindings), Vector<usize>.asSlice(&explicit), Vector<Constraint>.asSlice(&premises), Span.make(usize.ZERO, usize.ONE))
  // A written slot never moves, but Static storage still meets it by proven covariant subtyping.
  let mut fixedProven = false
  if let Option<RelatedArgument>.Some {value} = &fixed {
    fixedProven = Vector<RegionPair>.length(&value.relations) == usize.ZERO && run Type.equalsShared(&value.ty, &pattern)
  }
  run Testing.expect(fixedProven,
    "an explicitly fixed caller-local slot admits Static storage at exactly that slot with no open relation")
  run Testing.expect(Vector<Binding>.length(&bindings) == usize.ONE, "candidate proofs never append real inference bindings")
  let retainedSlice = Vector<Binding>.asSlice(&bindings)
  let retained = &retainedSlice[usize.ZERO]
  let unchanged = match &retained.value {
    Argument.Lifetime {value} => Lifetime.equalsShared(&value, &region)
    _ => false
  }
  run Testing.expect(unchanged, "candidate proofs never replace the real caller-local binding")
  let mut proof = Vector<Binding>.make()
  run Vector<Binding>.append(&mut proof, Binding {declaration: Shared<DeclarationId>.clone(&retained.declaration), ordinal: retained.ordinal,
    value: Argument.copy(&retained.value)})
  let rejected = run Type.unify(&parameter, &evidence, Vector<Shared<DeclarationId>>.asSlice(&variables), Comparison.Exact, &mut proof)
  run Testing.expect(match &rejected { Unification.Unified => false _ => true }, "the original Static operand still fails exact inference")
  return ()
}

test effect fn nominalRegionRelationExcludesExplicitCallerLocal() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  run nominalRegionExplicitOrdinalClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  return ()
}

fn iterationFactCount(iterations: &Vector<IterationFacts>) -> usize { return Vector<IterationFacts>.length(iterations) }

effect fn iterationCalls(iterations: &Shared<Vector<IterationFacts>>, ordinal: usize) -> Vector<ResolvedCall>
! OutOfMemoryError ? &mut Allocator {
  let count = Shared<Vector<IterationFacts>>.with<usize>(iterations, fn(value: &Vector<IterationFacts>) -> usize {
    let entries = Vector<IterationFacts>.asSlice(value)
    return Vector<ResolvedCall>.length(&entries[ordinal].calls)
  })
  let mut copied = Vector<ResolvedCall>.make()
  let mut at = usize.ZERO
  while at < count {
    // The callback only borrows one stored fact; its owned copy is made outside the borrow.
    let target = Shared<Vector<IterationFacts>>.with<Option<SelectionFact>>(iterations, fn(value: &Vector<IterationFacts>) -> Option<SelectionFact> {
      let entries = Vector<IterationFacts>.asSlice(value)
      let calls = Vector<ResolvedCall>.asSlice(&entries[ordinal].calls)
      return selectedFact(calls, calls[at].id)
    })
    let id = Shared<Vector<IterationFacts>>.with<HirId>(iterations, fn(value: &Vector<IterationFacts>) -> HirId {
      let entries = Vector<IterationFacts>.asSlice(value)
      return Vector<ResolvedCall>.asSlice(&entries[ordinal].calls)[at].id
    })
    if let Option<SelectionFact>.Some {value} = move target {
      run Vector<ResolvedCall>.append(&mut copied, ResolvedCall {id: id, result: Result<ResolvedTarget, Shared<Rejection>>.succeed(ResolvedTarget.Selected {fact: move value})})
    }
    at = at + usize.ONE
  }
  return move copied
}

// Scope identity is the original for plus ordinal; node/local ranges authenticate all generated
// ordinary operations. No HIR cloning, source-span perturbation, or runtime iteration survives.
effect fn checkStaticFor(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, request: &mut Request,
  dependencies: &mut Vector<Dependency>, module: &ModuleId, cursor: &AuthoredCursor, caller: &DeclarationId,
  locals: &mut Vector<BodyLocal>, annotations: &[ResolvedAnnotation], calls: &[ResolvedCall], nodes: &mut Vector<BodyNode>,
  signatures: &mut Vector<SignatureDependency>, requiredBodies: &mut Vector<DeclarationId>, statement: HirId, body: HirId,
  resultType: &Shared<Type>, constraints: &[Constraint], contractBody: bool, staticBody: bool, loopDepth: usize, unsafeAllowed: bool)
-> Result<CheckedControl, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  if staticBody { return run checkStaticFunctionFor(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
    module, cursor, caller, &mut locals.*, annotations, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*,
    statement, body, resultType, constraints, contractBody, loopDepth, unsafeAllowed) }
  let selected = selectedFact(calls, statement)
  let iterations = match move selected {
    Option<SelectionFact>.Some {value: SelectionFact.StaticFor {iterations}} => move iterations
    _ => { return Result<CheckedControl, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Unsupported, run bodySpan(&resolver.source, cursor, statement))) }
  }
  let length = Shared<Vector<IterationFacts>>.with<usize>(&iterations, iterationFactCount)
  let mut retained = Vector<BodyNodeId>.make()
  // The expansion completes only when every occurrence can; an occurrence that always returns or
  // fails ends the generated block like any other diverging statement.
  let mut completes = true
  let mut ordinal = usize.ZERO
  while ordinal < length {
    let mut annotationIds = Vector<HirId>.make()
    let mut writtenCalls = Vector<CallSyntax>.make()
    let mut declaration = usize.MAX
    if let Option<&IndexedSource>.Some {value: indexed} = move SourceIndex.sourceAtCursor(&resolver.source, cursor) {
      let hir = IndexedSource.authored(indexed)
      let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(indexed))
      let mut at = usize.ZERO
      while at < declarations.length {
        if DeclarationId.equals(&declarations[at].identity, caller) { declaration = at }
        at = at + usize.ONE
      }
      if let Node.Block {statements} = Module.node(hir, body) { run collectBodySyntax(hir, statements, &mut annotationIds, &mut writtenCalls) }
    }
    if declaration == usize.MAX { fail InvalidModulePath {} }
    let moduleOrdinal = knownModuleOrdinal(&resolver.*, module)
    let resolved = run resolveBodyFacts(&mut resolver.*, &mut owner.*, &mut dependencies.*, module,
      moduleOrdinal, declaration, &annotationIds, &writtenCalls)
    let facts = match move resolved {
      Result<BodyFacts, Shared<Rejection>>.Success {value} => move value
      Result<BodyFacts, Shared<Rejection>>.Failure {error} => { return Result<CheckedControl, Shared<Rejection>>.failResult(move error) }
    }
    let BodyFacts {annotations: selectedAnnotations, calls: ordinaryCalls} = move facts
    let mut scopedCalls = run iterationCalls(&iterations, ordinal)
    // Copy ordinary targets after the occurrence's selected facts, so selection always wins.
    let targets = Vector<ResolvedCall>.asSlice(&ordinaryCalls)
    let mut at = usize.ZERO
    while at < targets.length {
      let target = match &targets[at].result {
        Result<ResolvedTarget, Shared<Rejection>>.Success {value} => Result<ResolvedTarget, Shared<Rejection>>.succeed(run copyResolvedTarget(&value))
        Result<ResolvedTarget, Shared<Rejection>>.Failure {error} => Result<ResolvedTarget, Shared<Rejection>>.failResult(Shared<Rejection>.clone(&error))
      }
      run Vector<ResolvedCall>.append(&mut scopedCalls, ResolvedCall {id: targets[at].id, result: move target})
      at = at + usize.ONE
    }
    let nodeStart = Vector<BodyNode>.length(&nodes.*)
    let localStart = Vector<BodyLocal>.length(&locals.*)
    let checked = run checkBlock(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module, cursor, caller,
      &mut locals.*, Vector<ResolvedAnnotation>.asSlice(&selectedAnnotations), Vector<ResolvedCall>.asSlice(&scopedCalls),
      &mut nodes.*, &mut signatures.*, &mut requiredBodies.*, body, resultType, constraints, contractBody, staticBody, loopDepth, unsafeAllowed)
    let control = match move checked {
      Result<CheckedControl, Shared<Rejection>>.Success {value} => move value
      Result<CheckedControl, Shared<Rejection>>.Failure {error} => { return Result<CheckedControl, Shared<Rejection>>.failResult(move error) }
    }
    let end = Vector<BodyNode>.length(&nodes.*)
    let refusal = run generatedLoan(&nodes.*, nodeStart, end, localStart, caller, &run cursorAnchor(cursor))
    if let Option<Span>.Some {value} = move refusal {
      let site = run bodySpan(&resolver.source, cursor, statement)
      return Result<CheckedControl, Shared<Rejection>>.failResult(run rejectIteration(&mut resolver.*, module,
        caller, RejectionCode.Unsupported, value, site, ordinal))
    }
    run recordOccurrence(&mut resolver.*, StaticIteration {syntax: run anchoredNode(cursor, statement), ordinal: ordinal,
      nodeStart: nodeStart, nodeEnd: end, localStart: localStart, localEnd: Vector<BodyLocal>.length(&locals.*)})
    run Vector<BodyNodeId>.append(&mut retained, control.node)
    if !control.canComplete { completes = false }
    ordinal = ordinal + usize.ONE
  }
  let node = BodyNodeId {index: Vector<BodyNode>.length(&nodes.*)}
  run Vector<BodyNode>.append(&mut nodes.*, BodyNode {origin: run bodyOrigin(&resolver.source, cursor, statement),
    kind: BodyNodeKind.Block {statements: move retained, canComplete: completes}})
  return Result<CheckedControl, Shared<Rejection>>.succeed(CheckedControl {node: node, canComplete: completes})
}

effect fn recordOccurrence(resolver: &mut Resolver, fact: StaticIteration) -> () ! OutOfMemoryError ? &mut Allocator {
  let popped = Vector<BodyFrame>.pop(&mut resolver.bodies)
  if let Option<BodyFrame>.Some {value} = move popped {
    let mut frame = move value
    run Vector<StaticIteration>.append(&mut frame.occurrences, move fact)
    run Vector<BodyFrame>.append(&mut resolver.bodies, move frame)
  }
  return ()
}

effect fn takeOccurrenceFacts(resolver: &mut Resolver, output: &mut Vector<StaticIteration>) -> () ! OutOfMemoryError ? &mut Allocator {
  let popped = Vector<BodyFrame>.pop(&mut resolver.bodies)
  if let Option<BodyFrame>.Some {value} = move popped {
    let mut frame = move value
    let facts = Vector<StaticIteration>.asSlice(&frame.occurrences)
    let mut at = usize.ZERO
    while at < facts.length {
      let StaticIteration {syntax, ordinal, nodeStart, nodeEnd, localStart, localEnd} = &facts[at]
      run Vector<StaticIteration>.append(&mut output.*, StaticIteration {syntax: syntax, ordinal: ordinal,
        nodeStart: nodeStart, nodeEnd: nodeEnd, localStart: localStart, localEnd: localEnd})

      at = at + usize.ONE
    }
    run Vector<BodyFrame>.append(&mut resolver.bodies, move frame)
  }
  return ()
}

// A loan minted inside one static-for occurrence keeps its syntax-keyed region, which every
// occurrence of that syntax shares. That is sound while the loan stays inside its occurrence:
// each occurrence is checked over its own nodes, regions select no code, and a place declared
// outside the iteration keeps the region its declaration gave it. A value written to such a place
// therefore must not retain a region minted here, borrow storage the occurrence declares, or copy
// a reference held by a local the occurrence declares. A written value checks against the
// place's type, so its own type names the outside region; the operands show what it retains.
effect fn generatedLoan(nodes: &Vector<BodyNode>, start: usize, end: usize, localStart: usize, caller: &DeclarationId, anchor: &Anchor) -> Option<Span>
! OutOfMemoryError ? &mut Allocator {
  let written = Vector<BodyNode>.asSlice(nodes)
  let mut at = start
  while at < end {
    let mut escaping = Option<BodyNodeId>.none()
    match &written[at].kind {
      BodyNodeKind.Assignment {local, value} => { if local.index < localStart { escaping = Option<BodyNodeId>.some(value) } }
      BodyNodeKind.PlaceAssignment {target, value} => {
        if outsideIterationPlace(written, target, localStart) { escaping = Option<BodyNodeId>.some(value) }
      }
      _ => ()
    }
    if let Option<BodyNodeId>.Some {value: stored} = move escaping {
      if let BodyNodeKind.Expression {ty, ..} = &written[stored.index].kind {
        let mut regions = Vector<Shared<Lifetime>>.make()
        let representations = Vector<Option<Shared<Type>>>.make()
        let known = run Type.retainedRegions(&ty, caller, Vector<Option<Shared<Type>>>.asSlice(&representations), &mut regions)
        drop known
        if Vector<Shared<Lifetime>>.length(&regions) > usize.ZERO {
          let operand = run generatedOperand(written, stored, localStart, caller, anchor)
          if let Option<Span>.Some {value: retained} = move operand {
            return Option<Span>.some(retained)
          }
        }
        let captured = Vector<Shared<Lifetime>>.asSlice(&regions)
        let mut regionAt = usize.ZERO
        while regionAt < captured.length {
          let ordinal = Shared<Lifetime>.with<usize>(&captured[regionAt], fn(region: &Lifetime) -> usize {
            return match &region.* {
              Lifetime.Local {declaration, ordinal: localOrdinal} => {
                if DeclarationId.equals(&declaration, caller) { return localOrdinal }
                return usize.MAX
              }
              _ => usize.MAX
            }
          })
          if ordinal != usize.MAX {
            let mut generated = start
            while generated < end {
              if written[generated].origin.node == ordinal { return Option<Span>.some(BodyOrigin.span(written[generated].origin, anchor)) }
              generated = generated + usize.ONE
            }
          }
          regionAt = regionAt + usize.ONE
        }
      }
    }
    at = at + usize.ONE
  }
  return Option<Span>.none()
}

// The first operand of a written value that borrows storage the occurrence declares, or reads a
// reference-retaining local the occurrence declares. Operands are visited through every child,
// including nested blocks, branches and match arms, so no retained path is skipped.
effect fn generatedOperand(nodes: &[BodyNode], value: BodyNodeId, localStart: usize, caller: &DeclarationId, anchor: &Anchor) -> Option<Span>
! OutOfMemoryError ? &mut Allocator {
  let mut pending = Vector<BodyNodeId>.make()
  run Vector<BodyNodeId>.append(&mut pending, value)
  while Vector<BodyNodeId>.length(&pending) > usize.ZERO {
    let popped = Vector<BodyNodeId>.pop(&mut pending)
    let next = match move popped {
      Option<BodyNodeId>.Some {value: found} => found
      Option<BodyNodeId>.None => { return Option<Span>.none() }
    }
    if next.index >= nodes.length { continue }
    match &nodes[next.index].kind {
      BodyNodeKind.Expression {form: BodyExpression.Borrow {value: borrowed, ..}, ..} => {
        if insideIterationPlace(nodes, borrowed, localStart) { return Option<Span>.some(BodyOrigin.span(nodes[next.index].origin, anchor)) }
      }
      BodyNodeKind.Expression {ty, form: BodyExpression.Local {local}} => {
        if local.index >= localStart {
          let mut regions = Vector<Shared<Lifetime>>.make()
          let representations = Vector<Option<Shared<Type>>>.make()
          let known = run Type.retainedRegions(&ty, caller, Vector<Option<Shared<Type>>>.asSlice(&representations), &mut regions)
          drop known
          if Vector<Shared<Lifetime>>.length(&regions) > usize.ZERO { return Option<Span>.some(BodyOrigin.span(nodes[next.index].origin, anchor)) }
        }
      }
      _ => ()
    }
    run appendOperands(nodes, next, &mut pending)
  }
  return Option<Span>.none()
}

// Appends every child of one checked node.
effect fn appendOperands(nodes: &[BodyNode], id: BodyNodeId, pending: &mut Vector<BodyNodeId>) -> () ! OutOfMemoryError ? &mut Allocator {
  match &nodes[id.index].kind {
    BodyNodeKind.Block {statements, ..} => { run appendAll(Vector<BodyNodeId>.asSlice(&statements), &mut pending.*) }
    BodyNodeKind.LocalBinding {initializer, ..} => { run Vector<BodyNodeId>.append(&mut pending.*, initializer) }
    BodyNodeKind.MutableBinding {initializer, ..} => { run Vector<BodyNodeId>.append(&mut pending.*, initializer) }
    BodyNodeKind.Assignment {value, ..} => { run Vector<BodyNodeId>.append(&mut pending.*, value) }
    BodyNodeKind.PlaceAssignment {target, value} => {
      run Vector<BodyNodeId>.append(&mut pending.*, target)
      run Vector<BodyNodeId>.append(&mut pending.*, value)
    }
    BodyNodeKind.Drop {value, ..} => { run Vector<BodyNodeId>.append(&mut pending.*, value) }
    BodyNodeKind.Return {value} => {
      if let Option<BodyNodeId>.Some {value: returned} = &value { run Vector<BodyNodeId>.append(&mut pending.*, returned) }
    }
    BodyNodeKind.Fail {value} => { run Vector<BodyNodeId>.append(&mut pending.*, value) }
    BodyNodeKind.Branch {condition, thenBranch, elseBranch, ..} => {
      run Vector<BodyNodeId>.append(&mut pending.*, condition)
      run Vector<BodyNodeId>.append(&mut pending.*, thenBranch)
      if let Option<BodyNodeId>.Some {value: other} = &elseBranch { run Vector<BodyNodeId>.append(&mut pending.*, other) }
    }
    BodyNodeKind.While {condition, body} => {
      run Vector<BodyNodeId>.append(&mut pending.*, condition)
      run Vector<BodyNodeId>.append(&mut pending.*, body)
    }
    BodyNodeKind.Expression {form, ..} => {
      match &form {
        BodyExpression.Aggregate {fields} => { run appendFields(Vector<BodyAggregateField>.asSlice(&fields), &mut pending.*) }
        BodyExpression.Callable {fields, ..} => { run appendFields(Vector<BodyAggregateField>.asSlice(&fields), &mut pending.*) }
        BodyExpression.VariantConstruct {fields, ..} => { run appendFields(Vector<BodyAggregateField>.asSlice(&fields), &mut pending.*) }
        BodyExpression.DirectCall {arguments, ..} => { run appendAll(Vector<BodyNodeId>.asSlice(&arguments), &mut pending.*) }
        BodyExpression.ForeignCall {arguments, ..} => { run appendAll(Vector<BodyNodeId>.asSlice(&arguments), &mut pending.*) }
        BodyExpression.IntrinsicCall {arguments, ..} => { run appendAll(Vector<BodyNodeId>.asSlice(&arguments), &mut pending.*) }
        BodyExpression.StorageCall {arguments, ..} => { run appendAll(Vector<BodyNodeId>.asSlice(&arguments), &mut pending.*) }
        BodyExpression.InterfaceCall {arguments, ..} => { run appendAll(Vector<BodyNodeId>.asSlice(&arguments), &mut pending.*) }
        BodyExpression.CallableCall {callee, arguments, ..} => {
          run Vector<BodyNodeId>.append(&mut pending.*, callee)
          run appendAll(Vector<BodyNodeId>.asSlice(&arguments), &mut pending.*)
        }
        BodyExpression.StagedCallable {callee, arguments, ..} => {
          run Vector<BodyNodeId>.append(&mut pending.*, callee)
          run appendAll(Vector<BodyNodeId>.asSlice(&arguments), &mut pending.*)
        }
        BodyExpression.Match {subject, arms, ..} => {
          run Vector<BodyNodeId>.append(&mut pending.*, subject)
          let listed = Vector<BodyMatchArm>.asSlice(&arms)
          let mut arm = usize.ZERO
          while arm < listed.length {
            if let Option<BodyNodeId>.Some {value: guard} = &listed[arm].guard { run Vector<BodyNodeId>.append(&mut pending.*, guard) }
            run Vector<BodyNodeId>.append(&mut pending.*, listed[arm].result)
            arm = arm + usize.ONE
          }
        }
        BodyExpression.Index {value, index} => {
          run Vector<BodyNodeId>.append(&mut pending.*, value)
          run Vector<BodyNodeId>.append(&mut pending.*, index)
        }
        BodyExpression.ConcreteInfix {left, right, ..} => {
          run Vector<BodyNodeId>.append(&mut pending.*, left)
          run Vector<BodyNodeId>.append(&mut pending.*, right)
        }
        BodyExpression.ConcretePrefix {operand, ..} => { run Vector<BodyNodeId>.append(&mut pending.*, operand) }
        BodyExpression.Borrow {value, ..} => { run Vector<BodyNodeId>.append(&mut pending.*, value) }
        BodyExpression.PointerWeaken {value} => { run Vector<BodyNodeId>.append(&mut pending.*, value) }
        BodyExpression.Dereference {value} => { run Vector<BodyNodeId>.append(&mut pending.*, value) }
        BodyExpression.Field {value, ..} => { run Vector<BodyNodeId>.append(&mut pending.*, value) }
        BodyExpression.ArraySlice {value, ..} => { run Vector<BodyNodeId>.append(&mut pending.*, value) }
        BodyExpression.SliceLength {value} => { run Vector<BodyNodeId>.append(&mut pending.*, value) }
        BodyExpression.ArrayLength {value, ..} => { run Vector<BodyNodeId>.append(&mut pending.*, value) }
        BodyExpression.EnumValue {value} => { run Vector<BodyNodeId>.append(&mut pending.*, value) }
        BodyExpression.UnionInject {value, ..} => { run Vector<BodyNodeId>.append(&mut pending.*, value) }
        BodyExpression.UnionWiden {value} => { run Vector<BodyNodeId>.append(&mut pending.*, value) }
        BodyExpression.Move {value, ..} => { run Vector<BodyNodeId>.append(&mut pending.*, value) }
        BodyExpression.Run {value, ..} => { run Vector<BodyNodeId>.append(&mut pending.*, value) }
        _ => ()
      }
    }
    _ => ()
  }
  return ()
}

effect fn appendAll(values: &[BodyNodeId], pending: &mut Vector<BodyNodeId>) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < values.length {
    run Vector<BodyNodeId>.append(&mut pending.*, values[at])
    at = at + usize.ONE
  }
  return ()
}

effect fn appendFields(fields: &[BodyAggregateField], pending: &mut Vector<BodyNodeId>) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < fields.length {
    run Vector<BodyNodeId>.append(&mut pending.*, fields[at].value)
    at = at + usize.ONE
  }
  return ()
}

// Whether a checked place is storage the occurrence declares: it is rooted in a local declared
// inside the iteration. A dereference reaches a referent the place does not own.
fn insideIterationPlace(nodes: &[BodyNode], value: BodyNodeId, localStart: usize) -> bool {
  let mut selected = value
  while selected.index < nodes.length {
    let mut parent = selected
    match &nodes[selected.index].kind {
      BodyNodeKind.Expression {form: BodyExpression.Local {local}, ..} => {return local.index >= localStart}
      BodyNodeKind.Expression {form: BodyExpression.Field {value: subject, ..}, ..} => {parent = subject}
      BodyNodeKind.Expression {form: BodyExpression.Index {value: subject, ..}, ..} => {parent = subject}
      _ => {return false}
    }
    if parent.index >= selected.index {return false}
    selected = parent
  }
  return false
}

// Whether a checked place may lie outside the occurrence: it is rooted in a local declared before
// the iteration, or it is reached through a dereference, whose referent may be anywhere.
fn outsideIterationPlace(nodes: &[BodyNode], value: BodyNodeId, localStart: usize) -> bool {
  let mut selected = value
  while selected.index < nodes.length {
    let mut parent = selected
    match &nodes[selected.index].kind {
      BodyNodeKind.Expression {form: BodyExpression.Local {local}, ..} => {return local.index < localStart}
      BodyNodeKind.Expression {form: BodyExpression.Field {value: subject, ..}, ..} => {parent = subject}
      BodyNodeKind.Expression {form: BodyExpression.Index {value: subject, ..}, ..} => {parent = subject}
      BodyNodeKind.Expression {form: BodyExpression.Dereference {..}, ..} => {return true}
      _ => {return false}
    }
    // A checked place only points to its already checked subject, never a temporary or a cycle.
    if parent.index >= selected.index {return false}
    selected = parent
  }
  return false
}

// The diagnostic keeps the authored failure span and original static-for ordinal; generated
// identities are never synthesized as source declarations or encoded by changing byte spans.
effect fn rejectIteration(resolver: &mut Resolver, module: &ModuleId, site: &DeclarationId,
  code: RejectionCode, span: Span, forSpan: Span, ordinal: usize) -> Shared<Rejection>
! Cycle | OutOfMemoryError ? &mut Allocator {
  run recordLocationIdentity(&mut resolver.*, site)
  let mut arguments = Vector<Shared<StaticData>>.make()
  run Vector<Shared<StaticData>>.append(&mut arguments, run Shared<StaticData>.make(StaticData.Integer {
    ty: StaticIntegerType.Usize, sign: StaticSign.Positive, magnitude: usize.toU64(ordinal),
  }))
  let mut trace = Vector<StaticExecution.TraceStep>.make()
  // The original HIR id is source identity, while the primary diagnostic span stays authored.
  // Static selection owns the for's source observation; it cannot be a synthetic binder.
  run Vector<StaticExecution.TraceStep>.append(&mut trace, StaticExecution.TraceStep {
    name: run Bytes.copy(b"static for"), arguments: move arguments, span: forSpan,
    site: Option<DeclarationId>.some(DeclarationId.copy(site)),
  })
  let failure = StaticDiagnostic {fault: StaticFault.Unsupported, code: b"", span: span,
    site: Option<DeclarationId>.some(DeclarationId.copy(site)), target: resolver.target,
    message: Option<Bytes>.none(), origin: Option<Span>.none(), originSite: Option<DeclarationId>.none(), byteOffset: Option<u64>.none(),
    rejection: Option<Shared<Rejection>>.none(), needed: Option<StaticNeeded>.none(),
    missing: Option<StaticExecution.MissingFact>.none(), trace: move trace}
  return run Shared<Rejection>.make(Rejection {
    code: code, module: ModuleId.copy(module), span: span, related: Option<RelatedSite>.none(),
    path: Vector<Shared<DeclarationId>>.make(), expected: usize.ZERO, supplied: usize.ZERO,
    parameterName: Bytes.make(), expectedKind: GenericKind.Type, suppliedKind: GenericKind.Type,
    witness: Option<WitnessProblem>.none(), termination: TerminationStep.Peer,
    staticFailure: Option<StaticDiagnostic>.some(move failure), specialization: Vector<Application>.make(),
  })
}


// The lexical blocks under checking retain only their completed checked statement roots. A
// nested arm replays its parent's prefix and its own prefix from the application's arguments;
// sibling arm checking therefore cannot mutate the evaluator state another arm observes.
effect fn pushStaticPrefix(resolver: &mut Resolver) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut frames = Vector<BodyFrame>.asMutSlice(&mut resolver.bodies)
  if frames.length > usize.ZERO { run Vector<Vector<StaticPrefixWork>>.append(&mut frames[frames.length - usize.ONE].staticPrefixes, Vector<StaticPrefixWork>.make()) }
  return ()
}
fn popStaticPrefix(resolver: &mut Resolver) {
  let mut frames = Vector<BodyFrame>.asMutSlice(&mut resolver.bodies)
  if frames.length > usize.ZERO { drop Vector<Vector<StaticPrefixWork>>.pop(&mut frames[frames.length - usize.ONE].staticPrefixes) }
}
effect fn rememberStaticPrefix(resolver: &mut Resolver, statements: &[BodyNodeId], nodes: &[BodyNode], anchor: &Anchor) -> ()
! OutOfMemoryError ? &mut Allocator {
  let mut syntax = Vector<StaticPrefixWork>.make()
  let mut at = usize.ZERO
  while at < statements.length {
    let node = &nodes[statements[at].index]
    let mut work = StaticPrefixWork.Statement {syntax: BodyOrigin.syntax(node.origin, anchor)}
    if let BodyNodeKind.Expression {..} = &node.kind {work = StaticPrefixWork.Expression {syntax: BodyOrigin.syntax(node.origin, anchor)}}
    run Vector<StaticPrefixWork>.append(&mut syntax, move work)
    at = at + usize.ONE
  }
  let mut frames = Vector<BodyFrame>.asMutSlice(&mut resolver.bodies)
  if frames.length > usize.ZERO {
    let mut prefixes = Vector<Vector<StaticPrefixWork>>.asMutSlice(&mut frames[frames.length - usize.ONE].staticPrefixes)
    if prefixes.length > usize.ZERO { prefixes[prefixes.length - usize.ONE] = move syntax }
  }
  return ()
}

struct PreparedStaticPrefix {
  prefix: Vector<StaticPrefixWork>
  instance: Application
  sourceAnswer: Shared<Result<SourceResult, NoRejection>>
  checked: StaticExecution.CheckedRoot
  arguments: Vector<StaticBinding>
  target: MachineTarget
  expressionSpan: Span
  site: DeclarationId
}

effect fn staticPrefixExpression(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, module: &ModuleId, cursor: &AuthoredCursor, caller: &DeclarationId,
  locals: &[BodyLocal], nodes: &[BodyNode], root: BodyNodeId, expression: HirId)
-> Result<Shared<StaticData>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let prepared = run prepareStaticPrefix(&mut resolver.*, &mut owner.*, &mut dependencies.*,
    module, cursor, caller, locals, nodes, root, expression)
  return match move prepared {
    Result<PreparedStaticPrefix, Shared<Rejection>>.Success {value} => run evaluatePreparedStaticPrefix(
      &mut resolver.*, &mut owner.*, &mut dependencies.*, module, expression, move value)
    Result<PreparedStaticPrefix, Shared<Rejection>>.Failure {error} => Result<Shared<StaticData>, Shared<Rejection>>.failResult(move error)
  }
}

effect fn prepareStaticPrefix(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, module: &ModuleId, cursor: &AuthoredCursor, caller: &DeclarationId,
  locals: &[BodyLocal], nodes: &[BodyNode], root: BodyNodeId, expression: HirId)
-> Result<PreparedStaticPrefix, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let mut application = Option<Application>.none()
  let mut prefix = Vector<StaticPrefixWork>.make()
  let frames = Vector<BodyFrame>.asSlice(&resolver.bodies)
  if frames.length > usize.ZERO {
    let frame = &frames[frames.length - usize.ONE]
    if let Option<Application>.Some {value} = &frame.staticApplication { application = Option<Application>.some(run Application.copy(&value)) }
    let blocks = Vector<Vector<StaticPrefixWork>>.asSlice(&frame.staticPrefixes)
    let mut block = usize.ZERO
    while block < blocks.length {
      let statements = Vector<StaticPrefixWork>.asSlice(&blocks[block])
      let mut at = usize.ZERO
      while at < statements.length { run Vector<StaticPrefixWork>.append(&mut prefix, StaticExecution.copyPrefix(&statements[at]))
        at = at + usize.ONE }
      block = block + usize.ONE
    }
  }
  let instance = match move application {
    Option<Application>.Some {value} => move value
    Option<Application>.None => { return Result<PreparedStaticPrefix, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.StaticPhaseViolation, run bodySpan(&resolver.source, cursor, expression))) }
  }
  let sourceAnswer = run syntaxNodeSource(&mut resolver.*, module, expression)
  let mut occurrenceFacts = Vector<StaticIteration>.make()
  run takeOccurrenceFacts(&mut resolver.*, &mut occurrenceFacts)
  let copied = run TypedBody.checkpoint(caller, locals, nodes, root, move occurrenceFacts)
  let body = run Shared<TypedBody>.make(move copied)
  let checked = StaticExecution.checkedCheckpoint(move body)
  let mut arguments = Vector<StaticBinding>.make()
  let values = Vector<StaticSlot>.asSlice(&instance.statics)
  let mut at = usize.ZERO
  while at < values.length {
    if values[at].ordinal >= locals.length { fail InvalidModulePath {} }
    run Vector<StaticBinding>.append(&mut arguments, StaticBinding {module: ModuleId.copy(module),
      binder: run originSyntax(cursor, locals[values[at].ordinal].origin), value: StaticValue.copy(&values[at].value)})
    at = at + usize.ONE
  }
  let target = resolver.target
  let expressionSpan = run bodySpan(&resolver.source, cursor, expression)
  return Result<PreparedStaticPrefix, Shared<Rejection>>.succeed(PreparedStaticPrefix {
    prefix: move prefix,
    instance: move instance,
    sourceAnswer: move sourceAnswer,
    checked: move checked,
    arguments: move arguments,
    target: target,
    expressionSpan: expressionSpan,
    site: DeclarationId.copy(caller),
  })
}

effect fn evaluatePreparedStaticPrefix(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, module: &ModuleId, expression: HirId, prepared: PreparedStaticPrefix)
-> Result<Shared<StaticData>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let PreparedStaticPrefix {prefix, instance, sourceAnswer, checked, arguments, target, expressionSpan, site} = move prepared
  let port = inFlightStaticPort(&mut resolver.*, &mut owner.*, &mut dependencies.*)
  let mut machine = run StaticExecution.make(move port, module, StaticExecution.defaultLimits())
  run StaticExecution.useInstance(&mut machine, &instance)
  let bound = Vector<StaticBinding>.asSlice(&arguments)
  let completed = Vector<StaticPrefixWork>.asSlice(&prefix)
  let mut bindings = Vector<StaticBinding>.make()
  while StaticExecution.steps(&machine) < StaticExecution.stepLimit(&machine) {
    let supplied = Vector<StaticBinding>.asSlice(&bindings)
    let attempted = run Effect.result(StaticExecution.evaluatePrefix(&mut machine, &checked, bound, supplied, completed, expression))
    match move attempted {
      Result<Shared<StaticData>, StaticDiagnostic | OutOfMemoryError>.Success {value} => {
        return Result<Shared<StaticData>, Shared<Rejection>>.succeed(move value)
      }
      Result<Shared<StaticData>, StaticDiagnostic | OutOfMemoryError>.Failure {error} => {
        let ended = run staticEvaluationRejection(&mut machine, &mut bindings, module, move error)
        if let Option<Shared<Rejection>>.Some {value: rejected} = move ended {
          return Result<Shared<StaticData>, Shared<Rejection>>.failResult(move rejected)
        }
      }
    }
  }
  let failedPort = StaticExecution.port(&mut machine)
  return Result<Shared<StaticData>, Shared<Rejection>>.failResult(run rejectStatic(&mut failedPort.resolver.*, module,
    StaticDiagnostic {fault: StaticFault.StepLimit, code: b"SEM0179", span: expressionSpan, site: Option<DeclarationId>.some(move site), target: target,
      message: Option<Bytes>.none(), origin: Option<Span>.none(), originSite: Option<DeclarationId>.none(), byteOffset: Option<u64>.none(),
      rejection: Option<Shared<Rejection>>.none(), needed: Option<StaticNeeded>.none(),
      missing: Option<StaticExecution.MissingFact>.none(), trace: Vector<StaticExecution.TraceStep>.make()}))
}


// A static function expands the iterable inside the current evaluator-local context. Each
// generated scope receives its exact element type, and later iterations replay earlier checked
// iterations before reading outer mutable slots (STATIC-005, STATIC-010).
effect fn checkStaticFunctionFor(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, request: &mut Request,
  dependencies: &mut Vector<Dependency>, module: &ModuleId, cursor: &AuthoredCursor, caller: &DeclarationId,
  locals: &mut Vector<BodyLocal>, annotations: &[ResolvedAnnotation], calls: &[ResolvedCall], nodes: &mut Vector<BodyNode>,
  signatures: &mut Vector<SignatureDependency>, requiredBodies: &mut Vector<DeclarationId>, statement: HirId, body: HirId,
  resultType: &Shared<Type>, constraints: &[Constraint], contractBody: bool, loopDepth: usize, unsafeAllowed: bool)
-> Result<CheckedControl, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let written = run bodyNode(&resolver.source, cursor, statement)
  let mut binding = HirId {index: usize.MAX}
  let mut iterable = HirId {index: usize.MAX}
  if let Node.StaticForStatement {binding: binder, iterable: expression, ..} = written { binding = binder
    iterable = expression }
  if binding.index == usize.MAX { fail InvalidModulePath {} }
  // Like a reached static condition, the iterable has no enclosing body call facts. Its helper
  // calls are resolved here while an empty collection still leaves the iteration body silent.
  let resolvedIterable = run staticReachedFacts(&mut resolver.*, &mut owner.*, &mut dependencies.*,
    module, cursor, caller, iterable)
  let iterableFacts = match move resolvedIterable {
    Result<BodyFacts, Shared<Rejection>>.Success {value} => move value
    Result<BodyFacts, Shared<Rejection>>.Failure {error} => {return Result<CheckedControl, Shared<Rejection>>.failResult(move error)}
  }
  let BodyFacts {annotations: iterableAnnotations, calls: iterableTargets} = move iterableFacts
  let mut iterableCalls = move iterableTargets
  run carrySelectionFacts(calls, &mut iterableCalls)
  let checked = run checkStatementExpression(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
    module, cursor, caller, &mut locals.*, Vector<ResolvedAnnotation>.asSlice(&iterableAnnotations), resultType,
    loopDepth, Vector<ResolvedCall>.asSlice(&iterableCalls), &mut nodes.*,
    &mut signatures.*, &mut requiredBodies.*, iterable, &Option<Shared<Type>>.none(), RejectionCode.TypeMismatch, constraints, contractBody, true, unsafeAllowed, false)
  let iterableNode = match move checked {
    Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
    Result<BodyNodeId, Shared<Rejection>>.Failure {error} => { return Result<CheckedControl, Shared<Rejection>>.failResult(move error) }
  }
  let evaluated = run staticPrefixExpression(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor, caller,
    Vector<BodyLocal>.asSlice(&locals.*), Vector<BodyNode>.asSlice(&nodes.*), iterableNode, iterable)
  let sequence = match move evaluated {
    Result<Shared<StaticData>, Shared<Rejection>>.Success {value} => move value
    Result<Shared<StaticData>, Shared<Rejection>>.Failure {error} => { return Result<CheckedControl, Shared<Rejection>>.failResult(move error) }
  }
  let length = Shared<StaticData>.with<usize>(&sequence, StaticValue.sequenceLength)
  if length == usize.MAX { return Result<CheckedControl, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.StaticPhaseViolation, run bodySpan(&resolver.source, cursor, iterable))) }
  let declaredElement = match &Vector<BodyNode>.asSlice(&nodes.*)[iterableNode.index].kind {
    BodyNodeKind.Expression {ty, ..} => Shared<Type>.with<Option<Shared<Type>>>(&ty, CheckedIntrinsic.staticSequenceElement)
    _ => Option<Shared<Type>>.none()
  }
  let mut retained = Vector<BodyNodeId>.make()
  run pushStaticPrefix(&mut resolver.*)
  let mut ordinal = usize.ZERO
  while ordinal < length {
    let element = match move Shared<StaticData>.with<Option<Shared<StaticData>>>(&sequence,
      fn(data: &StaticData) -> Option<Shared<StaticData>> { return StaticValue.sequenceElement(data, ordinal) }) {
      Option<Shared<StaticData>>.Some {value} => move value
      Option<Shared<StaticData>>.None => { fail InvalidModulePath {} }
    }
    let iterableSpan = run bodySpan(&resolver.source, cursor, iterable)
    let exact = Shared<StaticData>.with<Option<Shared<Type>>>(&element, fn(data: &StaticData) -> Option<Shared<Type>> {
      return match &data.* {
        StaticData.Field {ty, ..} => Option<Shared<Type>>.some(Shared<Type>.clone(&ty))
        StaticData.Aggregate {ty, ..} => Option<Shared<Type>>.some(Shared<Type>.clone(&ty))
        StaticData.Sequence {ty, ..} => Option<Shared<Type>>.some(Shared<Type>.clone(&ty))
        StaticData.Text {..} => match &declaredElement {
          Option<Shared<Type>>.Some {value: textType} => Option<Shared<Type>>.some(Shared<Type>.clone(&textType))
          Option<Shared<Type>>.None => Option<Shared<Type>>.none()
        }
        _ => Option<Shared<Type>>.none()
      }
    })
    let elementType = match move exact {
      Option<Shared<Type>>.Some {value} => move value
      Option<Shared<Type>>.None => match move run embeddedType(&mut resolver.*, &mut owner.*, &mut dependencies.*, &element, iterableSpan) {
        Option<Shared<Type>>.Some {value} => move value
        Option<Shared<Type>>.None => { popStaticPrefix(&mut resolver.*)
          return Result<CheckedControl, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.StaticPhaseViolation, run bodySpan(&resolver.source, cursor, iterable))) }
      }
    }
    let localStart = Vector<BodyLocal>.length(&locals.*)
    run Vector<BodyLocal>.append(&mut locals.*, BodyLocal {origin: run bodyOrigin(&resolver.source, cursor, binding),
      ty: move elementType, mutable: false, meetDepth: Option<usize>.none()})
    run appendStaticPrefix(&mut resolver.*, StaticPrefixWork.Binding {binder: binding, start: Vector<BodyNode>.length(&nodes.*), value: StaticValue.copy(&element)})
    let nodeStart = Vector<BodyNode>.length(&nodes.*)
    let selectedFacts = run staticReachedFacts(&mut resolver.*, &mut owner.*, &mut dependencies.*,
      module, cursor, caller, body)
    let facts = match move selectedFacts {
      Result<BodyFacts, Shared<Rejection>>.Success {value} => move value
      Result<BodyFacts, Shared<Rejection>>.Failure {error} => { removeStaticPrefixTail(&mut resolver.*)
        popStaticPrefix(&mut resolver.*)
        return Result<CheckedControl, Shared<Rejection>>.failResult(move error) }
    }
    let BodyFacts {annotations: scopedAnnotations, calls: scopedCalls} = move facts
    let checkedBody = run checkBlock(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
      module, cursor, caller, &mut locals.*, Vector<ResolvedAnnotation>.asSlice(&scopedAnnotations),
      Vector<ResolvedCall>.asSlice(&scopedCalls), &mut nodes.*, &mut signatures.*, &mut requiredBodies.*,
      body, resultType, constraints, contractBody, true, loopDepth, unsafeAllowed)
    removeStaticPrefixTail(&mut resolver.*)
    let control = match move checkedBody {
      Result<CheckedControl, Shared<Rejection>>.Success {value} => move value
      Result<CheckedControl, Shared<Rejection>>.Failure {error} => { popStaticPrefix(&mut resolver.*)
          return Result<CheckedControl, Shared<Rejection>>.failResult(move error) }
    }
    let end = Vector<BodyNode>.length(&nodes.*)
    run recordOccurrence(&mut resolver.*, StaticIteration {syntax: run anchoredNode(cursor, statement), ordinal: ordinal,
      nodeStart: nodeStart, nodeEnd: end, localStart: localStart, localEnd: Vector<BodyLocal>.length(&locals.*)})
    run Vector<BodyNodeId>.append(&mut retained, control.node)
    run appendStaticPrefix(&mut resolver.*, StaticPrefixWork.Iteration {syntax: body, start: nodeStart,
      end: end, binder: binding, value: StaticValue.copy(&element)})
    ordinal = ordinal + usize.ONE
  }
  popStaticPrefix(&mut resolver.*)
  let node = BodyNodeId {index: Vector<BodyNode>.length(&nodes.*)}
  run Vector<BodyNode>.append(&mut nodes.*, BodyNode {origin: run bodyOrigin(&resolver.source, cursor, statement),
    kind: BodyNodeKind.Block {statements: move retained, canComplete: true}})
  return Result<CheckedControl, Shared<Rejection>>.succeed(CheckedControl {node: node, canComplete: true})
}

effect fn appendStaticPrefix(resolver: &mut Resolver, work: StaticPrefixWork) -> ()
! OutOfMemoryError ? &mut Allocator {
  let mut frames = Vector<BodyFrame>.asMutSlice(&mut resolver.bodies)
  let mut prefixes = Vector<Vector<StaticPrefixWork>>.asMutSlice(&mut frames[frames.length - usize.ONE].staticPrefixes)
  return run Vector<StaticPrefixWork>.append(&mut prefixes[prefixes.length - usize.ONE], move work)
}
fn removeStaticPrefixTail(resolver: &mut Resolver) {
  let mut frames = Vector<BodyFrame>.asMutSlice(&mut resolver.bodies)
  let mut prefixes = Vector<Vector<StaticPrefixWork>>.asMutSlice(&mut frames[frames.length - usize.ONE].staticPrefixes)
  drop Vector<StaticPrefixWork>.pop(&mut prefixes[prefixes.length - usize.ONE])
}


// Ordinary routing for the selected static iteration scope. An empty sequence never reaches
// this demand, so its body names and signatures contribute no diagnostics or dependencies.
effect fn staticReachedFacts(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, module: &ModuleId, cursor: &AuthoredCursor,
  caller: &DeclarationId, body: HirId) -> Result<BodyFacts, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut annotationIds = Vector<HirId>.make()
  let mut writtenCalls = Vector<CallSyntax>.make()
  let mut declaration = usize.MAX
  if let Option<&IndexedSource>.Some {value: indexed} = move SourceIndex.sourceAtCursor(&resolver.source, cursor) {
    let hir = IndexedSource.authored(indexed)
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(indexed))
    let mut at = usize.ZERO
    while at < declarations.length {
      if DeclarationId.equals(&declarations[at].identity, caller) { declaration = at }
      at = at + usize.ONE
    }
    if let Node.Block {statements} = Module.node(hir, body) {
      run collectBodySyntax(hir, statements, &mut annotationIds, &mut writtenCalls)
    } else {run collectCall(hir, body, &mut annotationIds, &mut writtenCalls)}
  }
  if declaration == usize.MAX { fail InvalidModulePath {} }
  let moduleOrdinal = knownModuleOrdinal(&resolver.*, module)
  return run resolveBodyFacts(&mut resolver.*, &mut owner.*, &mut dependencies.*, module,
    moduleOrdinal, declaration, &annotationIds, &writtenCalls)
}

fn reflectedMemberCount(answer: &Result<Answer, NoRejection>) -> usize {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Members {members, ..}} = &value.outcome {return Vector<Member>.length(&members)}
  }
  return usize.ZERO
}
fn reflectedMemberVisible(answer: &Result<Answer, NoRejection>, at: usize) -> bool {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Members {members, ..}} = &value.outcome {
      let listed = Vector<Member>.asSlice(&members)
      if at < listed.length {return listed[at].isPublic}
    }
  }
  return false
}
effect fn reflectedMemberLabel(answer: &Shared<Result<Answer, NoRejection>>, at: usize) -> Bytes
! OutOfMemoryError ? &mut Allocator {
  let count = Shared<Result<Answer, NoRejection>>.with<usize>(answer, fn(found: &Result<Answer, NoRejection>) -> usize {
    return reflectedLabelLength(found, at)
  })
  let mut label = run Bytes.zeroed(count)
  let copied = Shared<Result<Answer, NoRejection>>.with<bool>(answer, fn(found: &Result<Answer, NoRejection>) -> bool {
    return copyReflectedLabel(found, at, &mut label)
  })
  drop copied
  return move label
}
fn reflectedLabelLength(answer: &Result<Answer, NoRejection>, at: usize) -> usize {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Members {members, ..}} = &value.outcome {
      let listed = Vector<Member>.asSlice(&members)
      if at < listed.length {if let Option<Bytes>.Some {value: name} = &listed[at].name {return Bytes.length(&name)}}
    }
  }
  return usize.ZERO
}
fn copyReflectedLabel(answer: &Result<Answer, NoRejection>, at: usize, output: &mut Bytes) -> bool {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Members {members, ..}} = &value.outcome {
      let listed = Vector<Member>.asSlice(&members)
      if at < listed.length {if let Option<Bytes>.Some {value: name} = &listed[at].name {return copyReflectionBytes(&name, &mut output.*)}}
    }
  }
  return false
}
fn copyReflectionBytes(input: &Bytes, output: &mut Bytes) -> bool {
  let source = Bytes.asSlice(input)
  let mut target = Bytes.asMutSlice(&mut output.*)
  if source.length != target.length {return false}
  let mut at = usize.ZERO
  while at < source.length {target[at] = source[at] at = at + usize.ONE}
  return true
}
effect fn reflectedAnonymousLabel(occurrence: &Shared<AnonymousOccurrence>, ordinal: usize) -> Bytes
! OutOfMemoryError ? &mut Allocator {
  let count = Shared<AnonymousOccurrence>.with<usize>(occurrence, fn(found: &AnonymousOccurrence) -> usize {
    let labels = Vector<Bytes>.asSlice(&found.labels)
    if ordinal < labels.length {return Bytes.length(&labels[ordinal])}
    return usize.ZERO
  })
  let mut label = run Bytes.zeroed(count)
  let copied = Shared<AnonymousOccurrence>.with<bool>(occurrence, fn(found: &AnonymousOccurrence) -> bool {
    let labels = Vector<Bytes>.asSlice(&found.labels)
    if ordinal < labels.length {return copyReflectionBytes(&labels[ordinal], &mut label)}
    return false
  })
  drop copied
  return move label
}
