      ty = move completedType
      form = BodyExpression.Aggregate {fields: move completedFields}
    }
    Node.FieldExpression {subject, field} => {
      if !staticBody {
        return run checkFieldAccess(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
          module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*,
          &mut requiredBodies.*, expression, subject, field, span, expected, constraints, contractBody,
          unsafeAllowed)
