effect fn checkSourceCompileErrorExpression<'scope>(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut List<Dependency>,
  module: &ModuleId,
  cursor: &AuthoredCursor,
  caller: &DeclarationId,
  statementScope: &mut StatementScope<'scope>,
  calls: &[ResolvedCall],
  nodes: &mut List<BodyNode>,
  signatures: &mut List<SignatureDependency>,
  requiredBodies: &mut List<DeclarationId>,
  expression: HirId,
  span: Span,
  expected: &Option<Shared<Type>>, mismatchCode: RejectionCode,
  constraints: &[Constraint],
  contractBody: bool,
  staticBody: bool,
  unsafeAllowed: bool,
  initialType: Shared<Type>,
  initialForm: BodyExpression,
  initialDiverges: bool,
  message: HirId,
) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let mut ty = move initialType
  let mut form = move initialForm
  let mut diverges = initialDiverges
  if !staticBody {
    return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
  }
  let textType = Option<Shared<Type>>.some(
    run intrinsicValueType(IntrinsicValueKind.StaticText),
  )
  let checked = run checkExpression(
    &mut resolver.*,
    &mut owner.*,
    &mut request.*,
    &mut dependencies.*,
    module,
    cursor,
    caller,
    &mut statementScope.*,
    calls,
    &mut nodes.*,
    &mut signatures.*,
    &mut requiredBodies.*,
    message,
    &textType, RejectionCode.TypeMismatch,
    constraints,
    contractBody,
    staticBody,
    unsafeAllowed,
  )
  let messageNode = match move checked {
    Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
    Result<BodyNodeId, Shared<Rejection>>.Failure {error} => {
      return Result<BodyNodeId, Shared<Rejection>>.failResult(move error)
    }
  }
  ty = run Types.intern(Type.Union {members: List<Shared<Type>>.make()})
  form = BodyExpression.CompileError {message: messageNode}
  diverges = true
  return run finishExpression(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor, caller, constraints, &mut nodes.*,
    expression, span, move ty, move form,
    diverges, expected, mismatchCode, contractBody, staticBody)
}

effect fn checkSourceIdentifierExpression<'scope>(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  module: &ModuleId,
  cursor: &AuthoredCursor,
  caller: &DeclarationId,
  statementScope: &mut StatementScope<'scope>,
  calls: &[ResolvedCall],
  nodes: &mut List<BodyNode>,
  expression: HirId,
  span: Span,
  expected: &Option<Shared<Type>>, mismatchCode: RejectionCode,
  constraints: &[Constraint],
  contractBody: bool,
  staticBody: bool,
  initialType: Shared<Type>,
  initialForm: BodyExpression,
  initialDiverges: bool,
  name: HirId,
  binding: HirRef,
) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let mut ty = move initialType
  let mut form = move initialForm
  let mut diverges = initialDiverges
  let found = run checkedIdentifier(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor,
    List<BodyLocal>.asSlice(&statementScope.locals.*), calls, List<BodyNode>.asSlice(&nodes.*),
    expression, name, binding.present, binding.id, span, staticBody)
  let identifier = match move found {
    Result<CheckedIdentifier, Shared<Rejection>>.Success {value} => move value
    Result<CheckedIdentifier, Shared<Rejection>>.Failure {error} => {
      return Result<BodyNodeId, Shared<Rejection>>.failResult(move error)
    }
  }
  let CheckedIdentifier {ty: identifierType, form: identifierForm} = move identifier
  ty = move identifierType
  form = move identifierForm
  return run finishExpression(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor, caller, constraints, &mut nodes.*,
    expression, span, move ty, move form,
    diverges, expected, mismatchCode, contractBody, staticBody)
}

effect fn checkSourceArrayExpression<'scope>(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut List<Dependency>,
  module: &ModuleId,
  cursor: &AuthoredCursor,
  caller: &DeclarationId,
  statementScope: &mut StatementScope<'scope>,
  calls: &[ResolvedCall],
  nodes: &mut List<BodyNode>,
  signatures: &mut List<SignatureDependency>,
  requiredBodies: &mut List<DeclarationId>,
  expression: HirId,
  span: Span,
  expected: &Option<Shared<Type>>, mismatchCode: RejectionCode,
  constraints: &[Constraint],
  contractBody: bool,
  staticBody: bool,
  unsafeAllowed: bool,
  initialType: Shared<Type>,
  initialForm: BodyExpression,
  initialDiverges: bool,
  elements: Range,
) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let mut ty = move initialType
  let mut form = move initialForm
  let mut diverges = initialDiverges
  let mut elementType = Option<Shared<Type>>.none()
  let mut inferElement = true
  if let Option<ArrayShape>.Some {value: array} = move contextualArrayShape(expected) {
    if array.length != elements.length { return run bodyRejection(&resolver.*, module, RejectionCode.ArrayLengthMismatch, span) }
    elementType = Option<Shared<Type>>.some(move array.element)
    inferElement = false
  }
  if elements.length == usize.ZERO && inferElement {
    return run bodyRejection(&resolver.*, module, RejectionCode.UninferredArrayElement, span)
  }
  let mut operands = List<BodyAggregateField>.make()
  // Without a context type, an element type that holds regions does not fix the later elements'
  // regions: each element is checked alone and they join at the meet of their regions, which every
  // element outlives by covariant subtyping (LIFE-002), as match arms do.
  let mut joining = false
  let mut produced = List<ArmResult>.make()
  let mut at = usize.ZERO
  while at < elements.length {
    let child = run bodyChild(&resolver.source, cursor, elements, at)
    let mut context = match &elementType {
      Option<Shared<Type>>.Some {value} => Option<Shared<Type>>.some(Shared<Type>.clone(&value))
      Option<Shared<Type>>.None => Option<Shared<Type>>.none()
    }
    if joining { context = Option<Shared<Type>>.none() }
    let checked = run checkArrayElement(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
      module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*,
      child, &context, constraints, contractBody, staticBody, unsafeAllowed)
    let node = match move checked {
      Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
      Result<BodyNodeId, Shared<Rejection>>.Failure {error} => {
        return Result<BodyNodeId, Shared<Rejection>>.failResult(move error)
      }
    }
    if inferElement {
      elementType = bodyExpressionType(List<BodyNode>.asSlice(&nodes.*), &node)
      inferElement = false
      if let Option<Shared<Type>>.Some {value: first} = &elementType {
        let mut atoms = List<Shared<Lifetime>>.make()
        run Type.everyRegionAtom(&first, &mut atoms)
        joining = List<Shared<Lifetime>>.length(&atoms) != usize.ZERO
      }
    }
    if joining {
      if let Option<Shared<Type>>.Some {value: elementResult} = move bodyExpressionType(List<BodyNode>.asSlice(&nodes.*), &node) {
        run List<ArmResult>.append(&mut produced, ArmResult {arm: at, ty: move elementResult})
      }
    }
    run List<BodyAggregateField>.append(&mut operands, BodyAggregateField {index: at, value: node})
    at = at + usize.ONE
  }
  if joining {
    let results = List<ArmResult>.asSlice(&produced)
    let mut differ = results.length != elements.length
    at = usize.ONE
    while at < results.length && !differ {
      differ = !run Type.equalsShared(&results[usize.ZERO].ty, &results[at].ty)
      at = at + usize.ONE
    }
    if differ {
      let mut wanted = move elementType
      let mut met = false
      if results.length == elements.length {
        if let Option<Shared<Type>>.Some {value: shared} = move run regionJoin(&mut resolver.*, &mut owner.*, &mut dependencies.*,
          caller, constraints, results, span) {
          wanted = Option<Shared<Type>>.some(move shared)
          met = true
        }
      }
      // Without a meet, every later element must be admitted to the first one's type, as with a
      // context type.
      let mut admitted = usize.ONE
      if met { admitted = usize.ZERO }
      while admitted < elements.length {
        let child = run bodyChild(&resolver.source, cursor, elements, admitted)
        let childSpan = run bodySpan(&resolver.source, cursor, child)
        let previous = List<BodyAggregateField>.asSlice(&operands)[admitted].value
        let accepted = match move run admitExpectedValue(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, caller,
          constraints, &mut nodes.*, previous, &wanted, RejectionCode.ArrayElementMismatch, childSpan, !met, false) {
          Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
          Result<BodyNodeId, Shared<Rejection>>.Failure {error} => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move error) }
        }
        let mut listed = List<BodyAggregateField>.asMutSlice(&mut operands)
        listed[admitted].value = accepted
        admitted = admitted + usize.ONE
      }
      elementType = move wanted
    }
  }
  let selected = match move elementType {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => { return run bodyRejection(&resolver.*, module, RejectionCode.UninferredArrayElement, span) }
  }
  ty = run Types.intern(Type.Array {element: move selected, extent: run Type.extentText(elements.length)})
  form = BodyExpression.Aggregate {fields: move operands, written: List<Shared<Lifetime>>.make(), section: Option<SectionRetention>.none()}
  return run finishExpression(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor, caller, constraints, &mut nodes.*,
    expression, span, move ty, move form,
    diverges, expected, mismatchCode, contractBody, staticBody)
}

effect fn arrayRepeatCount<'scope>(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, module: &ModuleId, cursor: &AuthoredCursor,
  scope: &StatementScope<'scope>, calls: &[ResolvedCall], count: HirId,
) -> Result<usize, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let span = run bodySpan(&resolver.source, cursor, count)
  let evaluated = match move selectedFact(calls, count) {
    Option<SelectionFact>.Some {value: SelectionFact.Embedded {value, ..}} => move value
    _ => match move run staticExpression(&mut resolver.*, &mut owner.*, &mut dependencies.*,
      module, Option<usize>.none(), count, StaticRootExpectation.IntegerExtent, scope.staticBinders, scope.staticValues) {
      Result<Shared<StaticData>, Shared<Rejection>>.Success {value} => move value
      Result<Shared<StaticData>, Shared<Rejection>>.Failure {error} => {
        return Result<usize, Shared<Rejection>>.failResult(move error)
      }
    }
  }
  if StaticConstant.arrayLengthExceeds(&evaluated) {
    return Result<usize, Shared<Rejection>>.failResult(
      run reject(&resolver.*, module, RejectionCode.IntegerOutOfRange, span))
  }
  if let Option<Bytes>.Some {value: extent} = move run StaticConstant.extent(&evaluated, resolver.target.pointerBits()) {
    if let Option<usize>.Some {value} = move Type.extentValue(Bytes.asSlice(&extent)) {
      return Result<usize, Shared<Rejection>>.succeed(value)
    }
  }
  return Result<usize, Shared<Rejection>>.failResult(
    run constantRejection(module, span, b"an array repeat count must be a non-negative integer known at compile time"))
}

effect fn checkSourceArrayRepeatExpression<'scope>(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, request: &mut Request,
  dependencies: &mut List<Dependency>, module: &ModuleId, cursor: &AuthoredCursor,
  caller: &DeclarationId, statementScope: &mut StatementScope<'scope>, calls: &[ResolvedCall],
  nodes: &mut List<BodyNode>, signatures: &mut List<SignatureDependency>,
  requiredBodies: &mut List<DeclarationId>, expression: HirId, span: Span,
  expected: &Option<Shared<Type>>, mismatchCode: RejectionCode, constraints: &[Constraint],
  contractBody: bool, staticBody: bool, unsafeAllowed: bool, value: HirId, count: HirId,
) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let length = match move run arrayRepeatCount(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor, &statementScope.*, calls, count) {
    Result<usize, Shared<Rejection>>.Success {value: length} => length
    Result<usize, Shared<Rejection>>.Failure {error} => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move error) }
  }
  let mut elementType = Option<Shared<Type>>.none()
  if let Option<ArrayShape>.Some {value: array} = move contextualArrayShape(expected) {
    if array.length != length { return run bodyRejection(&resolver.*, module, RejectionCode.ArrayLengthMismatch, span) }
    elementType = Option<Shared<Type>>.some(move array.element)
  }
  let operand = match move run checkArrayElement(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
    module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*,
    value, &elementType, constraints, contractBody, staticBody, unsafeAllowed) {
    Result<BodyNodeId, Shared<Rejection>>.Success {value: node} => node
    Result<BodyNodeId, Shared<Rejection>>.Failure {error} => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move error) }
  }
  let selected = match move bodyExpressionType(List<BodyNode>.asSlice(&nodes.*), &operand) {
    Option<Shared<Type>>.Some {value: ty} => move ty
    Option<Shared<Type>>.None => { fail RevisionMismatch {} }
  }
  if length > usize.ONE {
    let copied = match move run copyType(&mut resolver.*, &mut owner.*, &mut dependencies.*, &selected, constraints, span) {
      Result<bool, Shared<Rejection>>.Success {value: copied} => copied
      Result<bool, Shared<Rejection>>.Failure {error} => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move error) }
    }
    if !copied { return run bodyRejection(&resolver.*, module, RejectionCode.MissingConformance, run bodySpan(&resolver.source, cursor, value)) }
  }
  let ty = run Types.intern(Type.Array {element: move selected, extent: run Type.extentText(length)})
  return run finishExpression(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor, caller, constraints, &mut nodes.*,
    expression, span, move ty, BodyExpression.ArrayRepeat {value: operand, count: length},
    false, expected, mismatchCode, contractBody, staticBody)
}

effect fn checkSourceTupleExpression<'scope>(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut List<Dependency>,
  module: &ModuleId,
  cursor: &AuthoredCursor,
  caller: &DeclarationId,
  statementScope: &mut StatementScope<'scope>,
  calls: &[ResolvedCall],
  nodes: &mut List<BodyNode>,
  signatures: &mut List<SignatureDependency>,
  requiredBodies: &mut List<DeclarationId>,
  expression: HirId,
  span: Span,
  expected: &Option<Shared<Type>>, mismatchCode: RejectionCode,
  constraints: &[Constraint],
  contractBody: bool,
  staticBody: bool,
  unsafeAllowed: bool,
  opaqueConstruction: bool,
  initialType: Shared<Type>,
  initialForm: BodyExpression,
  initialDiverges: bool,
  elements: Range,
) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let mut ty = move initialType
  let mut form = move initialForm
  let mut diverges = initialDiverges
  if staticBody { return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span) }
  let mut selected = match move namedAggregateExpectation(expected, OwnerKind.Tuple) {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => {
      return run checkAnonymousAggregate(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
        module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*,
        expression, elements, true, expected, mismatchCode, constraints, contractBody, unsafeAllowed, span)
    }
  }
  let mut inference = Option<InferredAggregateTarget>.none()
  if opaqueConstruction {
    inference = match move run inferredContextualAggregate(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, caller, &selected, span) {
      Result<Option<InferredAggregateTarget>, Shared<Rejection>>.Success {value} => move value
      Result<Option<InferredAggregateTarget>, Shared<Rejection>>.Failure {error} => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move error) }
    }
  }
  if let Option<InferredAggregateTarget>.Some {value} = &inference { selected = Shared<Type>.clone(&value.ty) }
  let queried = run checkedTupleElements(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, &selected, span)
  let fields = match move queried {
    Result<List<Shared<Type>>, Shared<Rejection>>.Success {value} => move value
    Result<List<Shared<Type>>, Shared<Rejection>>.Failure {error} => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move error) }
  }
  let mut admitted = Option<Shared<Type>>.none()
  if let Option<InferredAggregateTarget>.None = &inference {
    if let Option<Shared<Type>>.Some {value} = &expected.* { admitted = Option<Shared<Type>>.some(Shared<Type>.clone(&value)) }
  }
  return run checkPositionalAggregate(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
    module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*,
    expression, CallArguments.Written {range: elements}, &selected, List<Shared<Type>>.asSlice(&fields), &inference, &admitted, mismatchCode,
    constraints, contractBody, staticBody, unsafeAllowed)

}

effect fn checkSourceOrdinalExpression<'scope>(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut List<Dependency>,
  module: &ModuleId,
  cursor: &AuthoredCursor,
  caller: &DeclarationId,
  statementScope: &mut StatementScope<'scope>,
  calls: &[ResolvedCall],
  nodes: &mut List<BodyNode>,
  signatures: &mut List<SignatureDependency>,
  requiredBodies: &mut List<DeclarationId>,
  expression: HirId,
  span: Span,
  expected: &Option<Shared<Type>>, mismatchCode: RejectionCode,
  constraints: &[Constraint],
  contractBody: bool,
  staticBody: bool,
  unsafeAllowed: bool,
  initialType: Shared<Type>,
  initialForm: BodyExpression,
  initialDiverges: bool,
  subject: HirId,
  ordinal: HirId,
) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let mut ty = move initialType
  let mut form = move initialForm
  let mut diverges = initialDiverges
  if staticBody { return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span) }
  let checked = run checkedProjectionSubject(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
    module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*,
    subject, constraints, contractBody, unsafeAllowed)
  let subjectNode = match move checked {
    Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
    Result<BodyNodeId, Shared<Rejection>>.Failure {error} => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move error) }
  }
  let evidence = bodyExpressionType(List<BodyNode>.asSlice(&nodes.*), &subjectNode)
  let subjectType = match move evidence {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => { return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span) }
  }
  let fields = run checkedTupleElements(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, &subjectType, span)
  let elements = match move fields {
    Result<List<Shared<Type>>, Shared<Rejection>>.Success {value} => move value
    Result<List<Shared<Type>>, Shared<Rejection>>.Failure {error} => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move error) }
  }
  let mut index = usize.MAX
  if let Node.IntegerLiteral {sign, magnitude, ..} = run bodyNode(&resolver.source, cursor, ordinal) {
    let digits = run bodyText(&resolver.source, cursor, magnitude)
    if sign == Sign.Positive {
      if let Option<usize>.Some {value} = move Type.extentValue(Bytes.asSlice(&digits)) { index = value }
    }
  }
  let positions = List<Shared<Type>>.asSlice(&elements)
  if index >= positions.length {
    let written = match run bodyNode(&resolver.source, cursor, ordinal) {
      Node.IntegerLiteral {magnitude, ..} => run bodyText(&resolver.source, cursor, magnitude)
      _ => Bytes.make()
    }
    return Result<BodyNodeId, Shared<Rejection>>.failResult(run tupleElementRejection(module,
      run bodySpan(&resolver.source, cursor, ordinal), &subjectType, Bytes.asSlice(&written), positions.length))
  }
  ty = Shared<Type>.clone(&positions[index])
  form = BodyExpression.Field {value: subjectNode, index: index, declared: Shared<Type>.clone(&positions[index])}
  return run finishExpression(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor, caller, constraints, &mut nodes.*,
    expression, span, move ty, move form,
    diverges, expected, mismatchCode, contractBody, staticBody)
}

effect fn checkSourceIndexExpression<'scope>(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut List<Dependency>,
  module: &ModuleId,
  cursor: &AuthoredCursor,
  caller: &DeclarationId,
  statementScope: &mut StatementScope<'scope>,
  calls: &[ResolvedCall],
  nodes: &mut List<BodyNode>,
  signatures: &mut List<SignatureDependency>,
  requiredBodies: &mut List<DeclarationId>,
  expression: HirId,
  span: Span,
  expected: &Option<Shared<Type>>, mismatchCode: RejectionCode,
  constraints: &[Constraint],
  contractBody: bool,
  staticBody: bool,
  unsafeAllowed: bool,
  initialType: Shared<Type>,
  initialForm: BodyExpression,
  initialDiverges: bool,
  subject: HirId,
  index: HirId,
) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let mut ty = move initialType
  let mut form = move initialForm
  let mut diverges = initialDiverges
  if staticBody { return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span) }
  let checked = run checkedProjectionSubject(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
    module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*,
    subject, constraints, contractBody, unsafeAllowed)
  let subjectNode = match move checked {
    Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
    Result<BodyNodeId, Shared<Rejection>>.Failure {error} => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move error) }
  }
  let subjectType = match move bodyExpressionType(List<BodyNode>.asSlice(&nodes.*), &subjectNode) {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => { return run bodyRejection(&resolver.*, module, RejectionCode.NotIndexable, span) }
  }
  let mut knownLength = Option<usize>.none()
  let mut selectedElement = Option<Shared<Type>>.none()
  if let Option<ArrayShape>.Some {value: array} = move Type.arrayShape(&subjectType) {
    knownLength = Option<usize>.some(array.length)
    selectedElement = Option<Shared<Type>>.some(move array.element)
  } else {
    selectedElement = Type.sliceElement(&subjectType)
  }
  let element = match move selectedElement {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => {
      let rejected = run typeHoleRejection(module, RejectionCode.NotIndexable, run bodySpan(&resolver.source, cursor, subject), b"actual", &subjectType)
      return Result<BodyNodeId, Shared<Rejection>>.failResult(run stringHint(move rejected, &subjectType, b"1"))
    }
  }
  let indexType = Option<Shared<Type>>.some(run primitiveType(b"usize"))
  let checkedIndex = run checkExpression(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
    module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*,
    index, &indexType, RejectionCode.InvalidIndexType, constraints, contractBody, false, unsafeAllowed)
  let indexNode = match move checkedIndex {
    Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
    Result<BodyNodeId, Shared<Rejection>>.Failure {error} => {
      return Result<BodyNodeId, Shared<Rejection>>.failResult(move error)
    }
  }
  let mut staticElement = usize.MAX
  if let Node.IntegerLiteral {sign, magnitude, ..} = run bodyNode(&resolver.source, cursor, index) {
    let digits = run bodyText(&resolver.source, cursor, magnitude)
    if sign == Sign.Positive {
      if let Option<usize>.Some {value} = move Type.extentValue(Bytes.asSlice(&digits)) {
        if let Option<usize>.Some {value: count} = &knownLength {
          if value >= count { return run bodyRejection(&resolver.*, module, RejectionCode.IndexOutOfRange, run bodySpan(&resolver.source, cursor, index)) }
          staticElement = value
        }
      }
    }
  }
  ty = move element
  form = BodyExpression.Index {value: subjectNode, index: indexNode, element: staticElement}
  return run finishExpression(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor, caller, constraints, &mut nodes.*,
    expression, span, move ty, move form,
    diverges, expected, mismatchCode, contractBody, staticBody)
}

effect fn checkSourceRecordExpression<'scope>(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut List<Dependency>,
  module: &ModuleId,
  cursor: &AuthoredCursor,
  caller: &DeclarationId,
  statementScope: &mut StatementScope<'scope>,
  calls: &[ResolvedCall],
  nodes: &mut List<BodyNode>,
  signatures: &mut List<SignatureDependency>,
  requiredBodies: &mut List<DeclarationId>,
  expression: HirId,
  span: Span,
  expected: &Option<Shared<Type>>, mismatchCode: RejectionCode,
  constraints: &[Constraint],
  contractBody: bool,
  staticBody: bool,
  unsafeAllowed: bool,
  opaqueConstruction: bool,
  initialType: Shared<Type>,
  initialForm: BodyExpression,
  initialDiverges: bool,
  fields: Range,
) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let mut ty = move initialType
  let mut form = move initialForm
  let mut diverges = initialDiverges
  if staticBody { return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span) }
  let mut recordType = match move namedAggregateExpectation(expected, OwnerKind.Struct) {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => {
      return run checkAnonymousAggregate(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
        module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*,
        expression, fields, false, expected, mismatchCode, constraints, contractBody, unsafeAllowed, span)
    }
  }
  let mut inference = Option<InferredAggregateTarget>.none()
  if opaqueConstruction {
    inference = match move run inferredContextualAggregate(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, caller, &recordType, span) {
      Result<Option<InferredAggregateTarget>, Shared<Rejection>>.Success {value} => move value
      Result<Option<InferredAggregateTarget>, Shared<Rejection>>.Failure {error} => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move error) }
    }
  }
  if let Option<InferredAggregateTarget>.Some {value} = &inference { recordType = Shared<Type>.clone(&value.ty) }
  let checkedFields = run checkRecordFields(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
    module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*,
    &recordType, &inference, fields, expression, constraints, contractBody, staticBody, unsafeAllowed, span)
  let completed = match move checkedFields {
    Result<CheckedRecordFields, Shared<Rejection>>.Success {value} => move value
    Result<CheckedRecordFields, Shared<Rejection>>.Failure {error} => {
      return Result<BodyNodeId, Shared<Rejection>>.failResult(move error)
    }
  }
  if let Option<InferredAggregateTarget>.Some {..} = &inference {
    return run finishExpression(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor, caller, constraints, &mut nodes.*,
      expression, span, move completed.ty,
      BodyExpression.Aggregate {fields: move completed.fields, written: List<Shared<Lifetime>>.make(), section: Option<SectionRetention>.none()}, false, &Option<Shared<Type>>.none(), RejectionCode.TypeMismatch, contractBody, false)
  }
  ty = move completed.ty
  form = BodyExpression.Aggregate {fields: move completed.fields, written: List<Shared<Lifetime>>.make(), section: Option<SectionRetention>.none()}
  return run finishExpression(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor, caller, constraints, &mut nodes.*,
    expression, span, move ty, move form,
    diverges, expected, mismatchCode, contractBody, staticBody)
}

effect fn checkSourceMemberExpression<'scope>(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut List<Dependency>,
  module: &ModuleId,
  cursor: &AuthoredCursor,
  caller: &DeclarationId,
  statementScope: &mut StatementScope<'scope>,
  calls: &[ResolvedCall],
  nodes: &mut List<BodyNode>,
  signatures: &mut List<SignatureDependency>,
  requiredBodies: &mut List<DeclarationId>,
  expression: HirId,
  span: Span,
  expected: &Option<Shared<Type>>, mismatchCode: RejectionCode,
  constraints: &[Constraint],
  contractBody: bool,
  staticBody: bool,
  unsafeAllowed: bool,
  initialType: Shared<Type>,
  initialForm: BodyExpression,
  initialDiverges: bool,
  selector: HirId,
  fields: RangeRef,
) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let mut ty = move initialType
  let mut form = move initialForm
  let mut diverges = initialDiverges
  if staticBody { return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span) }
  let mut subject = HirId {index: usize.ZERO}
  let mut member = HirId {index: usize.ZERO}
  match move checkedMemberSelector(run bodyNode(&resolver.source, cursor, selector)) {
    Option<CheckedMemberSelector>.Some {value: selectedMember} => {
      subject = selectedMember.subject
      member = selectedMember.member
    }
    Option<CheckedMemberSelector>.None => { return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span) }
  }
  let resolved = run recordAnnotation(
    &mut resolver.*, &mut owner.*, &mut dependencies.*, module, caller, subject, span, constraints,
  )
  let unionType = match move resolved {
    Result<Shared<Type>, Shared<Rejection>>.Success {value} => move value
    Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
      return Result<BodyNodeId, Shared<Rejection>>.failResult(move error)
    }
  }
  let memberName = match move checkedMemberName(run bodyNode(&resolver.source, cursor, member)) {
    Option<Symbol>.Some {value: memberSymbol} => run bodyText(&resolver.source, cursor, memberSymbol)
    Option<Symbol>.None => { return CompilerBug.panic(b"MissingRetainedFact: checkSourceMemberExpression") }
  }
  let mut selection = Option<Result<SelectedVariant, Shared<Rejection>>>.none()
  let elided = run elidedLifetimeOwner(caller)
  if run typeMentionsOwner(&unionType, &elided) {
    // A qualifier that elides a lifetime constructs through the union's inference
    // transaction: its operands or a same-union expectation supply each one (LIFE-003).
    let inferredTarget = run inferredRecordAnnotation(
      &mut resolver.*, &mut owner.*, &mut dependencies.*, module, caller, subject, constraints, span, true,
    )
    let target = match move inferredTarget {
      Result<Option<InferredAggregateTarget>, Shared<Rejection>>.Success {value: Option<InferredAggregateTarget>.Some {value}} => move value
      Result<Option<InferredAggregateTarget>, Shared<Rejection>>.Failure {error} => {
        return Result<BodyNodeId, Shared<Rejection>>.failResult(move error)
      }
      _ => { return run bodyRejection(&resolver.*, module, RejectionCode.BodyLifetimeElisionUnavailable, span) }
    }
    let nominal = match move run nominalUnionOf(&mut resolver.*, &target.ty) {
      Option<NominalUnion>.Some {value} => value
      Option<NominalUnion>.None => { return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span) }
    }
    let selected = run selectedVariant(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, &target.ty,
      nominal, Bytes.asSlice(&memberName), span)
    match move selected {
      Result<SelectedVariant, Shared<Rejection>>.Success {value} => {
        let mut variant = move value
        variant.inference = Option<InferredAggregateTarget>.some(move target)
        selection = Option<Result<SelectedVariant, Shared<Rejection>>>.some(
          Result<SelectedVariant, Shared<Rejection>>.succeed(move variant),
        )
      }
      Result<SelectedVariant, Shared<Rejection>>.Failure {error} => {
        return Result<BodyNodeId, Shared<Rejection>>.failResult(move error)
      }
    }
  } else {
    selection = run selectAppliedVariant(
      &mut resolver.*, &mut owner.*, &mut dependencies.*, module, &unionType,
      Bytes.asSlice(&memberName), span,
    )
  }
  let chosen = match move selection {
    Option<Result<SelectedVariant, Shared<Rejection>>>.Some {value} => move value
    Option<Result<SelectedVariant, Shared<Rejection>>>.None => {
      return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
    }
  }
  let mut writtenFields = Range.empty()
  if fields.present { writtenFields = fields.range }
  return run checkVariantConstruct(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
    module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*,
    expression, move chosen, writtenFields, expected, mismatchCode, constraints, contractBody, staticBody, unsafeAllowed, span)

}

effect fn checkSourceStructExpression<
  'scope
>(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut List<Dependency>,
  module: &ModuleId,
  cursor: &AuthoredCursor,
  caller: &DeclarationId,
  statementScope: &mut StatementScope<'scope>,
  calls: &[ResolvedCall],
  nodes: &mut List<BodyNode>,
  signatures: &mut List<SignatureDependency>,
  requiredBodies: &mut List<DeclarationId>,
  expression: HirId,
  span: Span,
  expected: &Option<Shared<Type>>, mismatchCode: RejectionCode,
  constraints: &[Constraint],
  contractBody: bool,
  staticBody: bool,
  unsafeAllowed: bool,
  initialType: Shared<Type>,
  initialForm: BodyExpression,
  initialDiverges: bool,
  annotation: HirId,
  fields: Range,
) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let mut ty = move initialType
  let mut form = move initialForm
  let mut diverges = initialDiverges
  let variantPair = run namedPathPair(&resolver.source, cursor, annotation)
  if let Option<QualifiedBodyName>.Some {value: pair} = move variantPair {
    let selection = run selectVariant(&mut resolver.*, &mut owner.*, &mut dependencies.*, module,
      Bytes.asSlice(&pair.namespace), Bytes.asSlice(&pair.member), expected, span)
    if let Option<Result<SelectedVariant, Shared<Rejection>>>.Some {value: chosen} = move selection {
      return run checkVariantConstruct(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
        module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*,
        expression, move chosen, fields, expected, mismatchCode, constraints, contractBody, staticBody, unsafeAllowed, span)
    }
  }
  let inferredTarget = run inferredRecordAnnotation(
    &mut resolver.*, &mut owner.*, &mut dependencies.*, module, caller, annotation, constraints, span, false,
  )
  let inference = match move inferredTarget {
    Result<Option<InferredAggregateTarget>, Shared<Rejection>>.Success {value} => move value
    Result<Option<InferredAggregateTarget>, Shared<Rejection>>.Failure {error} => {
      return Result<BodyNodeId, Shared<Rejection>>.failResult(move error)
    }
  }
  let resolvedRecord = run recordConstructionType(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies.*,
    module,
    caller,
    annotation,
    span,
    &inference,
    constraints,
  )
  let recordType = match move resolvedRecord {
    Result<Shared<Type>, Shared<Rejection>>.Success {value} => move value
    Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
      return Result<BodyNodeId, Shared<Rejection>>.failResult(move error)
    }
  }
  let checkedFields = run checkRecordFields(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
    module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*,
    &recordType, &inference, fields, expression, constraints, contractBody, staticBody, unsafeAllowed, span)
  let completed = match move checkedFields {
    Result<CheckedRecordFields, Shared<Rejection>>.Success {value} => move value
    Result<CheckedRecordFields, Shared<Rejection>>.Failure {error} => {
      return Result<BodyNodeId, Shared<Rejection>>.failResult(move error)
    }
  }
  // The completed literal meets its expectation at the ordinary expected-value boundary. A literal
  // of a type without arguments, or whose annotation writes them all, infers none of its lifetimes.
  let CheckedRecordFields {ty: completedType, fields: completedFields} = move completed
  ty = move completedType
  let mut written = List<Shared<Lifetime>>.make()
  match &inference {
    Option<InferredAggregateTarget>.Some {value} => {
      let listed = List<Shared<Lifetime>>.asSlice(&value.written)
      let mut at = usize.ZERO
      while at < listed.length {
        run List<Shared<Lifetime>>.append(&mut written, Shared<Lifetime>.clone(&listed[at]))
        at = at + usize.ONE
      }
    }
    Option<InferredAggregateTarget>.None => { run namedLifetimes(&ty, &mut written) }
  }
  form = BodyExpression.Aggregate {fields: move completedFields, written: move written, section: Option<SectionRetention>.none()}
  return run finishExpression(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor, caller, constraints, &mut nodes.*,
    expression, span, move ty, move form,
    diverges, expected, mismatchCode, contractBody, staticBody)
}

effect fn checkSourceFieldExpression<'scope>(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut List<Dependency>,
  module: &ModuleId,
  cursor: &AuthoredCursor,
  caller: &DeclarationId,
  statementScope: &mut StatementScope<'scope>,
  calls: &[ResolvedCall],
  nodes: &mut List<BodyNode>,
  signatures: &mut List<SignatureDependency>,
  requiredBodies: &mut List<DeclarationId>,
  expression: HirId,
  span: Span,
  expected: &Option<Shared<Type>>, mismatchCode: RejectionCode,
  constraints: &[Constraint],
  contractBody: bool,
  staticBody: bool,
  unsafeAllowed: bool,
  initialType: Shared<Type>,
  initialForm: BodyExpression,
  initialDiverges: bool,
  subject: HirId,
  field: HirId,
) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let mut ty = move initialType
  let mut form = move initialForm
  let mut diverges = initialDiverges
  if !staticBody {
    return run checkFieldAccess(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
      module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*,
      &mut requiredBodies.*, expression, subject, field, span, expected, mismatchCode, constraints, contractBody,
      unsafeAllowed)
  }
  // Enum and nullary union members are static values, typed as runtime bodies type them.
  // Other qualified names stay call references.
  let staticQualified = run bodyQualifiedName(&resolver.source, cursor, expression)
  if let Option<QualifiedBodyName>.Some {value: written} = move staticQualified {
    let selection = run checkedEnumSelection(&mut resolver.*, &mut owner.*, &mut dependencies.*,
      module, Bytes.asSlice(&written.namespace), Bytes.asSlice(&written.member), span, false)
    if let Option<Result<EnumSelection, Shared<Rejection>>>.Some {value: selected} = move selection {
      let chosen = match move selected {
        Result<EnumSelection, Shared<Rejection>>.Success {value: choice} => move choice
        Result<EnumSelection, Shared<Rejection>>.Failure {error} => {
          return Result<BodyNodeId, Shared<Rejection>>.failResult(move error)
        }
      }
      if let EnumSelection.Member {ty: enumType, member} = move chosen {
        let index = List<BodyNode>.length(&nodes.*)
        run List<BodyNode>.append(&mut nodes.*, BodyNode {
          origin: run originAt(cursor, expression, span),
          kind: BodyNodeKind.Expression {ty: move enumType, form: BodyExpression.EnumMember {member: member}},
        })
        return run checkExpectedValue(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, caller, constraints, &mut nodes.*,
          BodyNodeId {index: index}, expected, mismatchCode, span)
      }
      return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
    }
    let variantSelection = run selectVariant(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies.*,
      module,
      Bytes.asSlice(&written.namespace),
      Bytes.asSlice(&written.member),
      expected,
      span
    )
    if let Option<Result<SelectedVariant, Shared<Rejection>>>.Some {
      value: selected
    } = move variantSelection {
      let variant = match move selected {
        Result<SelectedVariant, Shared<Rejection>>.Success { value } => move value
        Result<SelectedVariant, Shared<Rejection>>.Failure { error } => {
          return Result<BodyNodeId, Shared<Rejection>>.failResult(move error)
        }
      }
      if variant.shape.braces {
        return run bodyRejection(&resolver.*, module, RejectionCode.CallArity, span)
      }
      return run checkVariantConstruct(
        &mut resolver.*,
        &mut owner.*,
        &mut request.*,
        &mut dependencies.*,
        module,
        cursor,
        caller,
        &mut statementScope.*,
        calls,
        &mut nodes.*,
        &mut signatures.*,
        &mut requiredBodies.*,
        expression,
        Result<SelectedVariant, Shared<Rejection>>.succeed(move variant),
        Range.empty(),
        expected,
        mismatchCode,
        constraints,
        contractBody,
        staticBody,
        unsafeAllowed,
        span
      )
    }
  }
  let found = run resolvedCall(calls, expression)
  let resolved = match move found {
    Option<Result<ResolvedTarget, Shared<Rejection>>>.Some {value} => move value
    // Not a call reference: a field read of a static value, checked as a runtime body checks it
    // (STATIC-005). A static body has no references, so the subject is the aggregate itself.
    Option<Result<ResolvedTarget, Shared<Rejection>>>.None => {
      let checked = run checkExpression(&mut resolver.*, &mut owner.*, &mut request.*,
        &mut dependencies.*, module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*,
        &mut signatures.*, &mut requiredBodies.*, subject, &Option<Shared<Type>>.none(), RejectionCode.TypeMismatch,
        constraints, contractBody, true, unsafeAllowed)
      let subjectNode = match move checked {
        Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
        Result<BodyNodeId, Shared<Rejection>>.Failure {error} => {
          return Result<BodyNodeId, Shared<Rejection>>.failResult(move error)
        }
      }
      return run projectFieldValue(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
        module, cursor, caller, &mut statementScope.*, calls, &mut signatures.*, &mut requiredBodies.*, constraints,
        &mut nodes.*, expression, subject, field, span, subjectNode, expected, mismatchCode, contractBody, true, unsafeAllowed)
    }
  }
  match move resolved {
    Result<ResolvedTarget, Shared<Rejection>>.Success {
      value: ResolvedTarget.Constant {declaration, ty: constantType},
    } => {
      ty = move constantType
      form = BodyExpression.Constant {
        declaration: run Shared<DeclarationId>.make(move declaration),
      }
    }
    Result<ResolvedTarget, Shared<Rejection>>.Failure {error} => {
      return Result<BodyNodeId, Shared<Rejection>>.failResult(move error)
    }
    _ => {
      return run bodyRejection(
        &resolver.*,
        module,
        RejectionCode.UnknownProjectedField,
        run bodySpan(&resolver.source, cursor, field),
      )
    }
  }
  return run finishExpression(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor, caller, constraints, &mut nodes.*,
    expression, span, move ty, move form,
    diverges, expected, mismatchCode, contractBody, staticBody)
}

effect fn checkSourceMatchExpression<'scope>(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut List<Dependency>,
  module: &ModuleId,
  cursor: &AuthoredCursor,
  caller: &DeclarationId,
  statementScope: &mut StatementScope<'scope>,
  calls: &[ResolvedCall],
  nodes: &mut List<BodyNode>,
  signatures: &mut List<SignatureDependency>,
  requiredBodies: &mut List<DeclarationId>,
  expression: HirId,
  span: Span,
  expected: &Option<Shared<Type>>, mismatchCode: RejectionCode,
  constraints: &[Constraint],
  contractBody: bool,
  staticBody: bool,
  unsafeAllowed: bool,
  initialType: Shared<Type>,
  initialForm: BodyExpression,
  access: MatchAccess,
  subject: HirId,
  arms: Range,
) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let mut ty = move initialType
  let mut form = move initialForm
  if staticBody { return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span) }
  let checkedSubject = run checkExpression(&mut resolver.*, &mut owner.*, &mut request.*,
    &mut dependencies.*, module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*,
    &mut signatures.*, &mut requiredBodies.*, subject, &Option<Shared<Type>>.none(), RejectionCode.TypeMismatch,
    constraints, contractBody, false, unsafeAllowed)
  let subjectNode = match move checkedSubject {
    Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
    Result<BodyNodeId, Shared<Rejection>>.Failure {error} => {
      return Result<BodyNodeId, Shared<Rejection>>.failResult(move error)
    }
  }
  let subjectType = match move bodyExpressionType(List<BodyNode>.asSlice(&nodes.*), &subjectNode) {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => { return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span) }
  }
  let subjectMembers = run subjectScalarEnum(&mut resolver.*, &mut owner.*, &mut dependencies.*, &subjectType, span)
  let members = match move subjectMembers {
    Option<Result<Shared<Result<Answer, NoRejection>>, Shared<Rejection>>>.Some {value: selected} => match move selected {
      Result<Shared<Result<Answer, NoRejection>>, Shared<Rejection>>.Success {value} => move value
      Result<Shared<Result<Answer, NoRejection>>, Shared<Rejection>>.Failure {error} => {
        return Result<BodyNodeId, Shared<Rejection>>.failResult(move error)
      }
    }
    Option<Result<Shared<Result<Answer, NoRejection>>, Shared<Rejection>>>.None => {
      return run checkRecordMatch(&mut resolver.*, &mut owner.*, &mut request.*,
        &mut dependencies.*, module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*,
        &mut signatures.*, &mut requiredBodies.*, expression, subjectNode, &subjectType,
        access, MatchArms.Written {arms: arms}, expected, mismatchCode, constraints, contractBody, unsafeAllowed, span)
    }
  }
  return run checkScalarEnumMatch(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module, cursor,
    caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*, expression,
    subjectNode, &subjectType, &members, access, MatchArms.Written {arms: arms}, expected, mismatchCode, constraints,
    contractBody, unsafeAllowed, span)
}

// An `if` used as a value (IF-002): a `match` over its `bool` condition whose first arm selects
// `true` and whose second takes the rest. Its branches are value blocks, or a chained `if`
// expression, and their values join as `match` arm results do.
effect fn checkSourceConditionalExpression<'scope>(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, request: &mut Request,
  dependencies: &mut List<Dependency>, module: &ModuleId, cursor: &AuthoredCursor, caller: &DeclarationId,
  statementScope: &mut StatementScope<'scope>, calls: &[ResolvedCall], nodes: &mut List<BodyNode>,
  signatures: &mut List<SignatureDependency>, requiredBodies: &mut List<DeclarationId>, expression: HirId, span: Span,
  expected: &Option<Shared<Type>>, mismatchCode: RejectionCode, constraints: &[Constraint], contractBody: bool,
  staticBody: bool, unsafeAllowed: bool, condition: HirId, thenBranch: HirId, elseBranch: HirRef,
) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  if staticBody { return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span) }
  // The parser keeps an `if` without a final `else` out of expression positions.
  if !elseBranch.present { return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span) }
  let checkedCondition = run checkExpression(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module,
    cursor, caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*, condition,
    &Option<Shared<Type>>.none(), RejectionCode.TypeMismatch, constraints, contractBody, false, unsafeAllowed)
  let conditionNode = match move checkedCondition {
    Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
    Result<BodyNodeId, Shared<Rejection>>.Failure {error} => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move error) }
  }
  let conditionType = match move bodyExpressionType(List<BodyNode>.asSlice(&nodes.*), &conditionNode) {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => { return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span) }
  }
  let boolType = run primitiveType(b"bool")
  if !run Type.equalsShared(&conditionType, &boolType) {
    return Result<BodyNodeId, Shared<Rejection>>.failResult(run typeHoleRejection(module, RejectionCode.ConditionNotBool,
      run bodySpan(&resolver.source, cursor, condition), b"actual", &conditionType))
  }
  let mut resultType = copyExpected(expected)
  let mut join = emptyArmJoin()
  let mut checkedArms = List<BodyMatchArm>.make()
  let mut at = usize.ZERO
  while at < 2 {
    let mut branch = thenBranch
    let mut pattern = BodyPattern.Boolean {value: true}
    if at == usize.ONE {
      branch = elseBranch.id
      pattern = BodyPattern.Universal
    }
    let armSpan = run bodySpan(&resolver.source, cursor, branch)
    let checkedResult = run checkArmResult(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module,
      cursor, caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*,
      HirRef.of(branch), branch, &resultType,
      match &expected.* { Option<Shared<Type>>.Some {..} => mismatchCode Option<Shared<Type>>.None => RejectionCode.IncompatibleMatchResults },
      constraints, contractBody, unsafeAllowed, true)
    let armResult = match move checkedResult {
      Result<CheckedArmResult, Shared<Rejection>>.Success {value} => move value
      Result<CheckedArmResult, Shared<Rejection>>.Failure {error} => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move error) }
    }
    // As in a match, only a borrowed view supplies the other branch's expected type.
    let unset = match &resultType {
      Option<Shared<Type>>.Some {..} => false
      Option<Shared<Type>>.None => true
    }
    if unset && !armResult.block {
      if let Option<Shared<Type>>.Some {value: produced} = &armResult.ty {
        if Shared<Type>.with<bool>(&produced, borrowedView) { resultType = Option<Shared<Type>>.some(Shared<Type>.clone(&produced)) }
      }
    }
    run joinArm(&mut join, List<BodyMatchArm>.length(&checkedArms), &armResult.ty, armResult.block)
    run List<BodyMatchArm>.append(&mut checkedArms, BodyMatchArm {
      origin: run originAt(cursor, branch, armSpan),
      pattern: move pattern, tests: List<BodyPatternTest>.make(), guard: Option<BodyNodeId>.none(), result: armResult.node,
      bindings: List<BodyNodeId>.make(),
    })
    at = at + usize.ONE
  }
  drop resultType
  run adoptLiteralArms(&resolver.*, cursor, &mut nodes.*, List<BodyMatchArm>.asSlice(&checkedArms), &mut join)
  let joinedType = match move run joinedMatchType(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, caller, constraints,
    &mut nodes.*, &mut checkedArms, move join, span) {
    Result<Shared<Type>, Shared<Rejection>>.Success {value} => move value
    Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result<BodyNodeId, Shared<Rejection>>.failResult(run ifBranchRejection(move error)) }
  }
  let diverges = Shared<Type>.with<bool>(&joinedType, neverType)
  let index = List<BodyNode>.length(&nodes.*)
  run List<BodyNode>.append(&mut nodes.*, BodyNode {
    origin: run originAt(cursor, expression, span),
    kind: BodyNodeKind.Expression {ty: move joinedType, form: BodyExpression.Match {subject: conditionNode, access: BodySubjectAccess.Copy,
      tags: usize.ZERO, domain: 2, arms: move checkedArms, syntax: BodyMatchSyntax.Match}},
  })
  if diverges { return Result<BodyNodeId, Shared<Rejection>>.succeed(BodyNodeId {index: index}) }
  return run checkExpectedValue(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, caller, constraints, &mut nodes.*,
    BodyNodeId {index: index}, expected, mismatchCode, span)
}

// A match, or an `if let`, over a scalar enum subject: each arm selects members or is `_`; an
// `if let` mismatch path is an unwritten `_` arm that may be redundant (PATT-010).
effect fn checkScalarEnumMatch<'scope>(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, request: &mut Request,
  dependencies: &mut List<Dependency>, module: &ModuleId, cursor: &AuthoredCursor,
  caller: &DeclarationId, statementScope: &mut StatementScope<'scope>, calls: &[ResolvedCall], nodes: &mut List<BodyNode>,
  signatures: &mut List<SignatureDependency>, requiredBodies: &mut List<DeclarationId>,
  expression: HirId, subjectNode: BodyNodeId, subjectType: &Shared<Type>, members: &Shared<Result<Answer, NoRejection>>,
  access: MatchAccess, arms: MatchArms, expected: &Option<Shared<Type>>, mismatchCode: RejectionCode,
  constraints: &[Constraint], contractBody: bool, unsafeAllowed: bool, span: Span,
) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  // Scalar enum arms bind nothing, so a shared borrow reads the Copy tag like a plain match.
  if access == MatchAccess.Mutable {
    return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
  }
  let mut subjectAccess = BodySubjectAccess.Copy
  if access == MatchAccess.Move {
    subjectAccess = match move run consumingMatchAccess(&mut resolver.*, &mut owner.*, &mut dependencies.*, module,
      cursor, List<BodyNode>.asSlice(&nodes.*), subjectNode, subjectType, constraints, span) {
      Result<BodySubjectAccess, Shared<Rejection>>.Success {value} => move value
      Result<BodySubjectAccess, Shared<Rejection>>.Failure {error} => {
        return Result<BodyNodeId, Shared<Rejection>>.failResult(move error)
      }
    }
  }
  // Unguarded arms cover members; a guarded arm can still fall through to a later arm.
  let count = Shared<Result<Answer, NoRejection>>.with<usize>(members, scalarEnumCount)
  // The pattern span of the first unguarded arm that covers each member.
  let mut covering = List<Option<Span>>.make()
  while List<Option<Span>>.length(&covering) < count { run List<Option<Span>>.append(&mut covering, Option<Span>.none()) }
  let mut coveredCount = usize.ZERO
  let mut universal = false
  let mut resultType = match &expected.* {
    Option<Shared<Type>>.Some {value} => Option<Shared<Type>>.some(Shared<Type>.clone(&value))
    Option<Shared<Type>>.None => Option<Shared<Type>>.none()
  }
  let mut join = emptyArmJoin()
  let mut checkedArms = List<BodyMatchArm>.make()
  let mut at = usize.ZERO
  let armCount = matchArmCount(arms)
  while at < armCount {
    let mut armId = expression
    let mut pattern = expression
    let mut guard = HirRef.absent()
    let mut result = HirRef.absent()
    let mut fallback = false
    match arms {
      MatchArms.Written {arms: written} => {
        armId = run bodyChild(&resolver.source, cursor, written, at)
        if let Node.MatchArm {pattern: writtenPattern, guard: writtenGuard, result: writtenResult} = run bodyNode(&resolver.source, cursor, armId) {
          pattern = writtenPattern
          guard = writtenGuard
          result = HirRef.of(writtenResult)
        } else {
          return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, run bodySpan(&resolver.source, cursor, armId))
        }
      }
      MatchArms.Conditional {pattern: selected, thenBranch, elseBranch} => {
        if at == usize.ZERO {
          armId = thenBranch
          pattern = selected
          result = HirRef.of(thenBranch)
        } else {
          fallback = true
          if elseBranch.present { armId = elseBranch.id }
          result = elseBranch
        }
      }
      MatchArms.Binding {..} => { return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span) }
    }
    let armSpan = run bodySpan(&resolver.source, cursor, armId)
    let patternSpan = run bodySpan(&resolver.source, cursor, pattern)
    // An arm after `_` is reported as a whole (SEM0160). A repeated unguarded member reports
    // SEM0159 even after complete coverage; another arm after complete coverage is unreachable
    // (SEM0043), also as a whole.
    if universal && !fallback {
      return run bodyRejection(&resolver.*, module, RejectionCode.EnumMatchArmAfterWildcard, armSpan)
    }
    let mut checkedScalar = CheckedScalarPattern {pattern: BodyPattern.Universal, ordinal: usize.MAX}
    let bindingsFrom = List<BodyNode>.length(&nodes.*)
    let mut binder = false
    if !fallback {
      // `Color c` binds the whole enum value and, like `_`, covers every member.
      if let Node.BindingPattern {annotation, name, shadowsLocal} = run bodyNode(&resolver.source, cursor, pattern) {
        if shadowsLocal {
          return Result<BodyNodeId, Shared<Rejection>>.failResult(
            run bindingConflictRejection(module, run bodySpan(&resolver.source, cursor, name), b""))
        }
        if !annotation.present { return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, patternSpan) }
        let written = run patternMemberType(&mut resolver.*, module, statementScope.annotations, annotation.id, patternSpan)
        let writtenType = match move written {
          Result<Shared<Type>, Shared<Rejection>>.Success {value} => move value
          Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move error) }
        }
        if !run Type.equalsShared(&writtenType, subjectType) {
          return run bodyRejection(&resolver.*, module, RejectionCode.MatchMemberNotInScrutinee, patternSpan)
        }
        run List<BodyNode>.append(&mut nodes.*, BodyNode {
          origin: run originAt(cursor, pattern, patternSpan),
          kind: BodyNodeKind.Expression {ty: Shared<Type>.clone(subjectType),
            form: BodyExpression.PatternBinding {subject: subjectNode, path: List<BodyPlaceStep>.make(), access: bindingAccess(access),
              declared: Shared<Type>.clone(subjectType)}},
        })
        binder = true
      }
    }
    if binder && coveredCount == count {
      let unreachableSpan = match arms {
        MatchArms.Written {..} => armSpan
        _ => patternSpan
      }
      return run bodyRejection(&resolver.*, module, RejectionCode.UnreachableMatchArm, unreachableSpan)
    }
    if !fallback && !binder {
      let scalar = run checkScalarEnumPattern(&mut resolver.*, &mut owner.*, &mut dependencies.*,
        module, cursor, pattern, patternSpan, subjectType, List<Option<Span>>.asSlice(&covering))
      checkedScalar = match move scalar {
        Result<CheckedScalarPattern, Shared<Rejection>>.Success {value} => move value
        Result<CheckedScalarPattern, Shared<Rejection>>.Failure {error} => {
          return Result<BodyNodeId, Shared<Rejection>>.failResult(move error)
        }
      }
      if coveredCount == count {
        let unreachableSpan = match arms {
          MatchArms.Written {..} => armSpan
          _ => patternSpan
        }
        return run bodyRejection(&resolver.*, module, RejectionCode.UnreachableMatchArm, unreachableSpan)
      }
    }
    let ordinal = checkedScalar.ordinal
    let checkedPattern = move checkedScalar.pattern
    let armBindings = run declaredBindings(List<BodyNode>.asSlice(&nodes.*), bindingsFrom, subjectNode)
    let mut checkedGuard = Option<BodyNodeId>.none()
    if guard.present {
      let tested = run checkMatchGuard(&mut resolver.*, &mut owner.*, &mut request.*,
        &mut dependencies.*, module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*,
        &mut signatures.*, &mut requiredBodies.*, guard.id, constraints, contractBody, unsafeAllowed)
      let guardNode = match move tested {
        Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
        Result<BodyNodeId, Shared<Rejection>>.Failure {error} => {
          return Result<BodyNodeId, Shared<Rejection>>.failResult(move error)
        }
      }
      checkedGuard = Option<BodyNodeId>.some(guardNode)
    } else if ordinal == usize.MAX {
      universal = true
    } else {
      let mut marks = List<Option<Span>>.asMutSlice(&mut covering)
      marks[ordinal] = Option<Span>.some(patternSpan)
      coveredCount = coveredCount + usize.ONE
    }
    let yields = yieldsArms(&statementScope.*, expression)
    let checkedResult = run checkArmResult(&mut resolver.*, &mut owner.*, &mut request.*,
      &mut dependencies.*, module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*,
      &mut signatures.*, &mut requiredBodies.*, result, armId, &resultType, match &expected.* { Option<Shared<Type>>.Some {..} => mismatchCode Option<Shared<Type>>.None => RejectionCode.IncompatibleMatchResults }, constraints, contractBody, unsafeAllowed,
      yields)
    let armResult = match move checkedResult {
      Result<CheckedArmResult, Shared<Rejection>>.Success {value} => move value
      Result<CheckedArmResult, Shared<Rejection>>.Failure {error} => {
        return Result<BodyNodeId, Shared<Rejection>>.failResult(move error)
      }
    }
    let resultNode = armResult.node
    // As in a record match, only a borrowed view supplies later arms' expected type.
    let unset = match &resultType {
      Option<Shared<Type>>.Some {..} => false
      Option<Shared<Type>>.None => true
    }
    if unset && !armResult.block {
      if let Option<Shared<Type>>.Some {value: produced} = &armResult.ty {
        if Shared<Type>.with<bool>(&produced, borrowedView) { resultType = Option<Shared<Type>>.some(Shared<Type>.clone(&produced)) }
      }
    }
    run joinArm(&mut join, List<BodyMatchArm>.length(&checkedArms), &armResult.ty, armResult.block)
    run List<BodyMatchArm>.append(&mut checkedArms, BodyMatchArm {
      origin: run originAt(cursor, armId, armSpan),
      pattern: move checkedPattern, tests: List<BodyPatternTest>.make(), guard: move checkedGuard, result: resultNode,
      bindings: move armBindings,
    })
    at = at + usize.ONE
  }
  if !universal && coveredCount != count {
    let mut uncovered = List<usize>.make()
    let marks = List<Option<Span>>.asSlice(&covering)
    let mut mark = usize.ZERO
    while mark < marks.length {
      if let Option<Span>.None = &marks[mark] { run List<usize>.append(&mut uncovered, mark) }
      mark = mark + usize.ONE
    }
    return Result<BodyNodeId, Shared<Rejection>>.failResult(
      run missingMembersRejection(module, RejectionCode.MissingEnumMember, span, &members, List<usize>.asSlice(&uncovered)))
  }
  drop resultType
  run adoptLiteralArms(&resolver.*, cursor, &mut nodes.*, List<BodyMatchArm>.asSlice(&checkedArms), &mut join)
  let conditional = match arms {
    MatchArms.Conditional {..} => true
    _ => false
  }
  let matchType = match move run joinedMatchType(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, caller, constraints,
    &mut nodes.*, &mut checkedArms, move join, span) {
    Result<Shared<Type>, Shared<Rejection>>.Success {value} => move value
    Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
      if !conditional { return Result<BodyNodeId, Shared<Rejection>>.failResult(move error) }
      return Result<BodyNodeId, Shared<Rejection>>.failResult(run ifBranchRejection(move error))
    }
  }
  let diverges = Shared<Type>.with<bool>(&matchType, neverType)
  let syntax = match arms {
    MatchArms.Written {..} => BodyMatchSyntax.Match
    _ => BodyMatchSyntax.IfLet
  }
  let index = List<BodyNode>.length(&nodes.*)
  run List<BodyNode>.append(&mut nodes.*, BodyNode {
    origin: run originAt(cursor, expression, span),
    kind: BodyNodeKind.Expression {ty: move matchType, form: BodyExpression.Match {subject: subjectNode, access: move subjectAccess,
      tags: usize.ZERO, domain: count, arms: move checkedArms, syntax: syntax}},
  })
  // A match whose arms all transfer is `never`, which every context accepts.
  if diverges { return Result<BodyNodeId, Shared<Rejection>>.succeed(BodyNodeId {index: index}) }
  return run checkExpectedValue(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, caller, constraints, &mut nodes.*,
    BodyNodeId {index: index}, expected, mismatchCode, span)

}

effect fn checkSourceBorrowExpression<'scope>(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut List<Dependency>,
  module: &ModuleId,
  cursor: &AuthoredCursor,
  caller: &DeclarationId,
  statementScope: &mut StatementScope<'scope>,
  calls: &[ResolvedCall],
  nodes: &mut List<BodyNode>,
  signatures: &mut List<SignatureDependency>,
  requiredBodies: &mut List<DeclarationId>,
  expression: HirId,
  span: Span,
  expected: &Option<Shared<Type>>, mismatchCode: RejectionCode,
  constraints: &[Constraint],
  contractBody: bool,
  staticBody: bool,
  unsafeAllowed: bool,
  initialType: Shared<Type>,
  initialForm: BodyExpression,
  initialDiverges: bool,
  access: Access,
  operand: HirId,
) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let mut ty = move initialType
  let mut form = move initialForm
  let mut diverges = initialDiverges
  let checked = run checkBorrowOperand(&mut resolver.*, &mut owner.*, &mut request.*,
    &mut dependencies.*, module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*,
    &mut requiredBodies.*, expression, access, operand, expected, mismatchCode, false, false, run anchoredNode(cursor, expression),
    usize.MAX, constraints, contractBody, staticBody, unsafeAllowed)
  let borrowed = match move checked {
    Result<CheckedBorrow, Shared<Rejection>>.Success {value} => move value
    Result<CheckedBorrow, Shared<Rejection>>.Failure {error} => {
      return Result<BodyNodeId, Shared<Rejection>>.failResult(move error)
    }
  }
  ty = move borrowed.ty
  form = BodyExpression.Borrow {access: access, value: borrowed.value}
  return run finishExpression(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor, caller, constraints, &mut nodes.*,
    expression, span, move ty, move form,
    diverges, expected, mismatchCode, contractBody, staticBody)
}

effect fn checkSourceReferentExpression<'scope>(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut List<Dependency>,
  module: &ModuleId,
  cursor: &AuthoredCursor,
  caller: &DeclarationId,
  statementScope: &mut StatementScope<'scope>,
  calls: &[ResolvedCall],
  nodes: &mut List<BodyNode>,
  signatures: &mut List<SignatureDependency>,
  requiredBodies: &mut List<DeclarationId>,
  expression: HirId,
  span: Span,
  expected: &Option<Shared<Type>>, mismatchCode: RejectionCode,
  constraints: &[Constraint],
  contractBody: bool,
  staticBody: bool,
  unsafeAllowed: bool,
  initialType: Shared<Type>,
  initialForm: BodyExpression,
  initialDiverges: bool,
  subject: HirId,
) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let mut ty = move initialType
  let mut form = move initialForm
  let mut diverges = initialDiverges
  if staticBody {
    return run bodyRejection(&resolver.*, module, RejectionCode.StaticPhaseViolation, span)
  }
  let checked = run checkExpression(
    &mut resolver.*,
    &mut owner.*,
    &mut request.*,
    &mut dependencies.*,
    module,
    cursor,
    caller,
    &mut statementScope.*,
    calls,
    &mut nodes.*,
    &mut signatures.*,
    &mut requiredBodies.*,
    subject,
    &Option<Shared<Type>>.none(), RejectionCode.TypeMismatch,
    constraints,
    contractBody,
    staticBody,
    unsafeAllowed,
  )
  let operandNode = match move checked {
    Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
    Result<BodyNodeId, Shared<Rejection>>.Failure {error} => {
      return Result<BodyNodeId, Shared<Rejection>>.failResult(move error)
    }
  }
  let subjectType = match move bodyExpressionType(
    List<BodyNode>.asSlice(&nodes.*),
    &operandNode,
  ) {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => {
      return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
    }
  }
  let rawPointer = Shared<Type>.with<bool>(
    &subjectType,
    fn(value: &Type) -> bool {
      return match & value.* {
        Type.Pointer {..} => true
        _ => false
      }
    },
  )
  if rawPointer && !unsafeAllowed {
    return run bodyRejection(&resolver.*, module, RejectionCode.UnsafeAcknowledgement, span)
  }
  let pointee = Shared<Type>.with<Option<Shared<Type>>>(
    &subjectType,
    fn(value: &Type) -> Option<Shared<Type>> {
      return match & value.* {
        Type.Reference {referent, ..} => Option<Shared<Type>>.some(
          Shared<Type>.clone(&referent),
        )
        Type.Pointer {pointee, nullable, multiplicity, ..} => {
          if unsafeAllowed && !nullable && multiplicity == Multiplicity.Single {
            return Option<Shared<Type>>.some(Shared<Type>.clone(&pointee))
          }
          return Option<Shared<Type>>.none()
        }
        _ => Option<Shared<Type>>.none()
      }
    },
  )
  ty = match move pointee {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => {
      return run bodyRejection(&resolver.*, module, RejectionCode.InvalidReferentProjection, span)
    }
  }
  form = BodyExpression.Dereference {value: operandNode}
  return run finishExpression(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor, caller, constraints, &mut nodes.*,
    expression, span, move ty, move form,
    diverges, expected, mismatchCode, contractBody, staticBody)
}

effect fn checkSourceUnsafeExpression(
  resolver: &mut Resolver,
  module: &ModuleId,
  span: Span,
  initialType: Shared<Type>,
  initialForm: BodyExpression,
  initialDiverges: bool,
) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let mut ty = move initialType
  let mut form = move initialForm
  let mut diverges = initialDiverges
  return run bodyRejection(&resolver.*, module, RejectionCode.UnsafeInvocation, span)

}

effect fn checkSourceMoveExpression<'scope>(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut List<Dependency>,
  module: &ModuleId,
  cursor: &AuthoredCursor,
  caller: &DeclarationId,
  statementScope: &mut StatementScope<'scope>,
  calls: &[ResolvedCall],
  nodes: &mut List<BodyNode>,
  signatures: &mut List<SignatureDependency>,
  requiredBodies: &mut List<DeclarationId>,
  expression: HirId,
  span: Span,
  expected: &Option<Shared<Type>>, mismatchCode: RejectionCode,
  constraints: &[Constraint],
  contractBody: bool,
  staticBody: bool,
  unsafeAllowed: bool,
  initialType: Shared<Type>,
  initialForm: BodyExpression,
  initialDiverges: bool,
  operand: HirId,
) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let mut ty = move initialType
  let mut form = move initialForm
  let mut diverges = initialDiverges
  // A move records the place it consumes; a later safety stage checks that the place is still
  // owned here. Static bodies move only a named local as a whole.
  if staticBody {
    if let Node.IdentifierExpression {binding, ..} = run bodyNode(
      &resolver.source,
      cursor,
      operand,
    ) {
      if !binding.present {
        return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
      }
    } else {
      return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
    }
  }
  let checked = run checkExpression(
    &mut resolver.*,
    &mut owner.*,
    &mut request.*,
    &mut dependencies.*,
    module,
    cursor,
    caller,
    &mut statementScope.*,
    calls,
    &mut nodes.*,
    &mut signatures.*,
    &mut requiredBodies.*,
    operand,
    // A move transfers the place's stored value; its operand is not constructed from the
    // surrounding value context. Preserve that exact stored type here, then admit the
    // completed move at the ordinary expected-value boundary below.
    &Option<Shared<Type>>.none(), RejectionCode.TypeMismatch,
    constraints,
    contractBody,
    staticBody,
    unsafeAllowed,
  )
  let operandNode = match move checked {
    Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
    Result<BodyNodeId, Shared<Rejection>>.Failure {error} => {
      return Result<BodyNodeId, Shared<Rejection>>.failResult(move error)
    }
  }
  ty = match & List<BodyNode>.asSlice(&nodes.*)[operandNode.index].kind {
    BodyNodeKind.Expression {ty: operandType, ..} => Shared<Type>.clone(&operandType)
    _ => {
      return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
    }
  }
  let consumed = match move run consumedPlace(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor, List<BodyNode>.asSlice(&nodes.*), operandNode, false, false, span, span, constraints) {
    Result<Option<BodyConsumedPlace>, Shared<Rejection>>.Success {value} => move value
    Result<Option<BodyConsumedPlace>, Shared<Rejection>>.Failure {error} => {
      return Result<BodyNodeId, Shared<Rejection>>.failResult(move error)
    }
  }
  form = BodyExpression.Move {value: operandNode, consumed: move consumed}
  return run finishExpression(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor, caller, constraints, &mut nodes.*,
    expression, span, move ty, move form,
    diverges, expected, mismatchCode, contractBody, staticBody)
}

effect fn checkSourcePrefixExpression<'scope>(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut List<Dependency>,
  module: &ModuleId,
  cursor: &AuthoredCursor,
  caller: &DeclarationId,
  statementScope: &mut StatementScope<'scope>,
  calls: &[ResolvedCall],
  nodes: &mut List<BodyNode>,
  signatures: &mut List<SignatureDependency>,
  requiredBodies: &mut List<DeclarationId>,
  expression: HirId,
  span: Span,
  expected: &Option<Shared<Type>>, mismatchCode: RejectionCode,
  constraints: &[Constraint],
  contractBody: bool,
  staticBody: bool,
  unsafeAllowed: bool,
  initialType: Shared<Type>,
  initialForm: BodyExpression,
  initialDiverges: bool,
  operator: PrefixOperator,
  operatorAnchor: Span,
  operand: HirId,
) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let mut ty = move initialType
  let mut form = move initialForm
  let mut diverges = initialDiverges
  let checked = run checkExpression(
    &mut resolver.*,
    &mut owner.*,
    &mut request.*,
    &mut dependencies.*,
    module,
    cursor,
    caller,
    &mut statementScope.*,
    calls,
    &mut nodes.*,
    &mut signatures.*,
    &mut requiredBodies.*,
    operand,
    expected, mismatchCode,
    constraints,
    contractBody,
    staticBody,
    unsafeAllowed,
  )
  let operandNode = match move checked {
    Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
    Result<BodyNodeId, Shared<Rejection>>.Failure {error} => {
      return Result<BodyNodeId, Shared<Rejection>>.failResult(move error)
    }
  }
  let operandType = match move bodyExpressionType(
    List<BodyNode>.asSlice(&nodes.*),
    &operandNode,
  ) {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => {
      return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, operatorAnchor)
    }
  }
  let family = run operatorFamily(&mut resolver.*, &operandType)
  let concrete = Operator.prefix(operator, family)
  let closed = match & concrete {
    Option<Operator.ResultType>.Some {value: _} => true
    Option<Operator.ResultType>.None => false
  }
  let mut operands = List<Shared<Type>>.make()
  run List<Shared<Type>>.append(&mut operands, Shared<Type>.clone(&operandType))
  let spelling = OperatorSpelling.Prefix {operator: operator}
  let operandSlice = List<Shared<Type>>.asSlice(&operands)
  let called = run checkedSelectedOperator(
    &mut resolver.*, caller, List<BodyNode>.asSlice(&nodes.*),
    &mut owner.*,
    &mut request.*,
    &mut dependencies.*,
    &mut signatures.*,
    &mut requiredBodies.*,
    &spelling,
    operandSlice,
    constraints,
    closed,
    module,
    operatorAnchor,
    operandNode,
    Option<BodyNodeId>.none(),
    unsafeAllowed,
  )
  let overload = match move called {
    Result<Option<CheckedOperatorCall>, Shared<Rejection>>.Success {value} => move value
    Result<Option<CheckedOperatorCall>, Shared<Rejection>>.Failure {error} => {
      return Result<BodyNodeId, Shared<Rejection>>.failResult(run operatorFailure(&resolver.*, module, cursor,
        List<BodyNode>.asSlice(&nodes.*), &[operandNode], move error))
    }
  }
  if let Option<CheckedOperatorCall>.Some {value: accepted} = move overload {
    let CheckedOperatorCall {ty: resultType, form: selectedForm} = move accepted
    ty = move resultType
    form = move selectedForm
  } else if let Option<Operator.ResultType>.Some {value: result} = move concrete {
    ty = match result {
      OperatorResultType.Operand => Shared<Type>.clone(&operandType)
      OperatorResultType.Boolean => run primitiveType(b"bool")
    }
    if !staticBody {
      if let Option<Shared<Rejection>>.Some {value: trap} = move run constantNegationTrap(&mut resolver.*, &mut owner.*, &mut dependencies.*,
        module, cursor, List<BodyNode>.asSlice(&nodes.*), operator, operandNode, &ty, span) {
        return Result<BodyNodeId, Shared<Rejection>>.failResult(move trap)
      }
    }
    form = BodyExpression.ConcretePrefix {operator: operator, operand: operandNode}
  } else {
    let missing = run operatorRejection(module, RejectionCode.MissingOperator, operatorAnchor, prefixSpelling(operator), operandSlice,
      false)
    return Result<BodyNodeId, Shared<Rejection>>.failResult(run operatorFailure(&resolver.*, module, cursor,
      List<BodyNode>.asSlice(&nodes.*), &[operandNode], move missing))
  }
  return run finishExpression(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor, caller, constraints, &mut nodes.*,
    expression, span, move ty, move form,
    diverges, expected, mismatchCode, contractBody, staticBody)
}

effect fn checkSourceInfixExpression<'scope>(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut List<Dependency>,
  module: &ModuleId,
  cursor: &AuthoredCursor,
  caller: &DeclarationId,
  statementScope: &mut StatementScope<'scope>,
  calls: &[ResolvedCall],
  nodes: &mut List<BodyNode>,
  signatures: &mut List<SignatureDependency>,
  requiredBodies: &mut List<DeclarationId>,
  expression: HirId,
  span: Span,
  expected: &Option<Shared<Type>>, mismatchCode: RejectionCode,
  constraints: &[Constraint],
  contractBody: bool,
  staticBody: bool,
  unsafeAllowed: bool,
  initialType: Shared<Type>,
  initialForm: BodyExpression,
  initialDiverges: bool,
  operator: InfixOperator,
  operatorAnchor: Span,
  left: HirId,
  right: HirId,
) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let mut ty = move initialType
  let mut form = move initialForm
  let mut diverges = initialDiverges
  let leftLiteral = run literalOperand(&resolver.source, cursor, left)
  let rightLiteral = run literalOperand(&resolver.source, cursor, right)
  // A bare literal, or arithmetic over bare literals such as `(1 + 2)`, has no fixed type before
  // its other operand is known. Checking that operand first only selects a literal type; the
  // retained pair preserves runtime order.
  let mut firstExpression = left
  let mut secondExpression = right
  let swapped = leftLiteral && !rightLiteral
  if swapped {
    firstExpression = right
    secondExpression = left
  }
  let firstContextual = match run bodyNode(&resolver.source, cursor, firstExpression) {
    Node.CharacterLiteral {..} => true
    Node.IntegerLiteral {suffix, ..} => !suffix.present
    Node.FloatingLiteral {suffix, ..} => !suffix.present
    Node.InfixExpression {..} => true
    Node.PrefixExpression {..} => true
    _ => false
  }
  let secondContextual = match run bodyNode(&resolver.source, cursor, secondExpression) {
    Node.CharacterLiteral {..} => true
    Node.IntegerLiteral {suffix, ..} => !suffix.present
    Node.FloatingLiteral {suffix, ..} => !suffix.present
    Node.InfixExpression {..} => true
    Node.PrefixExpression {..} => true
    _ => false
  }
  let mut firstExpected = Option<Shared<Type>>.none()
  if firstContextual {
    if let Option<Shared<Type>>.Some {value} = &expected.* {
      if Shared<Type>.with<bool>(
        &value,
        fn(ty: &Type) -> bool {
          return fixedIntegerType(ty) || pointerSizedIntegerType(ty) || Operator.family(ty, false) == OperatorFamily.Floating
        },
      ) {
        firstExpected = Option<Shared<Type>>.some(Shared<Type>.clone(&value))
      }
    }
  }
  let first = run checkOperatorOperand(
    &mut resolver.*,
    &mut owner.*,
    &mut request.*,
    &mut dependencies.*,
    module,
    cursor,
    caller,
    &mut statementScope.*,
    calls,
    &mut nodes.*,
    &mut signatures.*,
    &mut requiredBodies.*,
    firstExpression,
    &firstExpected, RejectionCode.TypeMismatch,
    constraints,
    contractBody,
    staticBody,
    unsafeAllowed,
  )
  let firstOperand = match move first {
    Result<CheckedOperand, Shared<Rejection>>.Success {value} => move value
    Result<CheckedOperand, Shared<Rejection>>.Failure {error} => {
      return Result<BodyNodeId, Shared<Rejection>>.failResult(move error)
    }
  }
  let CheckedOperand {node: firstNode, ty: firstType} = move firstOperand
  let mut secondExpected = Option<Shared<Type>>.none()
  if secondContextual && Shared<Type>.with<bool>(
    &firstType,
    fn(ty: &Type) -> bool {
      return fixedIntegerType(ty) || pointerSizedIntegerType(ty) || Operator.family(ty, false) == OperatorFamily.Floating || Operator.family(ty, false) == OperatorFamily.Character
    },
  ) {
    secondExpected = Option<Shared<Type>>.some(Shared<Type>.clone(&firstType))
  }
  let second = run checkOperatorOperand(
    &mut resolver.*,
    &mut owner.*,
    &mut request.*,
    &mut dependencies.*,
    module,
    cursor,
    caller,
    &mut statementScope.*,
    calls,
    &mut nodes.*,
    &mut signatures.*,
    &mut requiredBodies.*,
    secondExpression,
    &secondExpected, RejectionCode.TypeMismatch,
    constraints,
    contractBody,
    staticBody,
    unsafeAllowed,
  )
  let secondOperand = match move second {
    Result<CheckedOperand, Shared<Rejection>>.Success {value} => move value
    Result<CheckedOperand, Shared<Rejection>>.Failure {error} => {
      return Result<BodyNodeId, Shared<Rejection>>.failResult(move error)
    }
  }
  let pair = orderCheckedOperands(
    swapped,
    CheckedOperand {node: firstNode, ty: move firstType},
    move secondOperand,
  )
  let CheckedOperands {leftNode, leftType, rightNode, rightType} = move pair
  let leftFamily = run operatorFamily(&mut resolver.*, &leftType)
  let rightFamily = run operatorFamily(&mut resolver.*, &rightType)
  let sameType = run Type.equalsShared(&leftType, &rightType)
  let mut concrete = Operator.infix(operator, leftFamily, rightFamily, sameType)
  if (operator == InfixOperator.And || operator == InfixOperator.Or) && sameType && leftFamily == OperatorFamily.Boolean && rightFamily == OperatorFamily.Boolean {
    concrete = Option<OperatorResultType>.some(OperatorResultType.Boolean)
  }
  let closed = match & concrete {
    Option<Operator.ResultType>.Some {value: _} => true
    Option<Operator.ResultType>.None => false
  }
  let mut operands = List<Shared<Type>>.make()
  run List<Shared<Type>>.append(&mut operands, Shared<Type>.clone(&leftType))
  run List<Shared<Type>>.append(&mut operands, Shared<Type>.clone(&rightType))
  let spelling = OperatorSpelling.Infix {operator: operator}
  let operandSlice = List<Shared<Type>>.asSlice(&operands)
  let called = run checkedSelectedOperator(
    &mut resolver.*, caller, List<BodyNode>.asSlice(&nodes.*),
    &mut owner.*,
    &mut request.*,
    &mut dependencies.*,
    &mut signatures.*,
    &mut requiredBodies.*,
    &spelling,
    operandSlice,
    constraints,
    closed,
    module,
    operatorAnchor,
    leftNode,
    Option<BodyNodeId>.some(rightNode),
    unsafeAllowed,
  )
  let mut operandNodes = List<BodyNodeId>.make()
  run List<BodyNodeId>.append(&mut operandNodes, leftNode)
  run List<BodyNodeId>.append(&mut operandNodes, rightNode)
  let overload = match move called {
    Result<Option<CheckedOperatorCall>, Shared<Rejection>>.Success {value} => move value
    Result<Option<CheckedOperatorCall>, Shared<Rejection>>.Failure {error} => {
      return Result<BodyNodeId, Shared<Rejection>>.failResult(run operatorFailure(&resolver.*, module, cursor,
        List<BodyNode>.asSlice(&nodes.*), List<BodyNodeId>.asSlice(&operandNodes), move error))
    }
  }
  if let Option<CheckedOperatorCall>.Some {value: accepted} = move overload {
    let predicate = run operatorPredicate(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor, &mut nodes.*, operator,
      expression, span, move accepted)
    let finished = match move predicate {
      Result<CheckedOperatorCall, Shared<Rejection>>.Success {value} => move value
      Result<CheckedOperatorCall, Shared<Rejection>>.Failure {error} => {
        return Result<BodyNodeId, Shared<Rejection>>.failResult(move error)
      }
    }
    let CheckedOperatorCall {ty: resultType, form: selectedForm} = move finished
    ty = move resultType
    form = move selectedForm
  } else if let Option<Operator.ResultType>.Some {value: result} = move concrete {
    ty = match result {
      OperatorResultType.Operand => Shared<Type>.clone(&leftType)
      OperatorResultType.Boolean => run primitiveType(b"bool")
    }
    if !staticBody {
      if let Option<Shared<Rejection>>.Some {value: trap} = move run constantArithmeticTrap(&mut resolver.*, &mut owner.*, &mut dependencies.*,
        module, cursor, List<BodyNode>.asSlice(&nodes.*), operator, leftNode, rightNode, &ty, span) {
        return Result<BodyNodeId, Shared<Rejection>>.failResult(move trap)
      }
    }
    form = BodyExpression.ConcreteInfix {
      operator: operator,
      left: leftNode,
      right: rightNode,
    }
  } else {
    let borrowed = run borrowedOperatorApplies(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, &spelling,
      operandSlice, constraints, module, operatorAnchor)
    let missing = run operatorRejection(module, missingInfixCode(operator, leftFamily, rightFamily), operatorAnchor,
      infixSpelling(operator), operandSlice, borrowed)
    return Result<BodyNodeId, Shared<Rejection>>.failResult(run operatorFailure(&resolver.*, module, cursor,
      List<BodyNode>.asSlice(&nodes.*), List<BodyNodeId>.asSlice(&operandNodes), move missing))
  }
  return run finishExpression(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor, caller, constraints, &mut nodes.*,
    expression, span, move ty, move form,
    diverges, expected, mismatchCode, contractBody, staticBody)
}

// Reports an operand whose type comes only from context: an unsuffixed literal, or arithmetic and
// bitwise operators whose every leaf is one. A comparison or logical operator yields `bool`.
effect fn literalOperand(source: &SourceIndex, cursor: &AuthoredCursor, id: HirId) -> bool
! RevisionMismatch {
  return match run bodyNode(source, cursor, id) {
    Node.CharacterLiteral {..} => true
    Node.IntegerLiteral {suffix, ..} => !suffix.present
    Node.FloatingLiteral {suffix, ..} => !suffix.present
    Node.PrefixExpression {operator: PrefixOperator.Not, ..} => false
    Node.PrefixExpression {operand, ..} => run literalOperand(source, cursor, operand)
    Node.InfixExpression {operator, left, right, ..} => {
      if comparisonOrLogical(operator) || !(run literalOperand(source, cursor, left)) {
        return false
      }
      return run literalOperand(source, cursor, right)
    }
    _ => false
  }
}

fn comparisonOrLogical(operator: InfixOperator) -> bool {
  return match operator {
    InfixOperator.Equals => true
    InfixOperator.NotEquals => true
    InfixOperator.LessThan => true
    InfixOperator.LessOrEqual => true
    InfixOperator.GreaterThan => true
    InfixOperator.GreaterOrEqual => true
    InfixOperator.And => true
    InfixOperator.Or => true
    _ => false
  }
}

// The written spelling of a prefix operator.
fn prefixSpelling(operator: PrefixOperator) -> &'static [u8] {
  return match operator {
    PrefixOperator.Negate => b"-"
    PrefixOperator.Not => b"!"
    PrefixOperator.BitwiseNot => b"~"
  }
}

// The written spelling of an infix operator.
fn infixSpelling(operator: InfixOperator) -> &'static [u8] {
  return match operator {
    InfixOperator.Add => b"+"
    InfixOperator.Subtract => b"-"
    InfixOperator.Multiply => b"*"
    InfixOperator.Divide => b"/"
    InfixOperator.Remainder => b"%"
    InfixOperator.Equals => b"=="
    InfixOperator.NotEquals => b"!="
    InfixOperator.LessThan => b"<"
    InfixOperator.LessOrEqual => b"<="
    InfixOperator.GreaterThan => b">"
    InfixOperator.GreaterOrEqual => b">="
    InfixOperator.And => b"&&"
    InfixOperator.Or => b"||"
    InfixOperator.BitAnd => b"&"
    InfixOperator.BitOr => b"|"
    InfixOperator.BitXor => b"^"
  }
}

// An operator no overload or built-in rule accepts. SEM0135 names the operator and its operand
// types when each type has an exact spelling; another `code` carries no argument.
// An operator that accepts no operands of these types, `failure`, unless an operand is a partial
// application written as a call with too few arguments, such as `add(2, 3) == 5` for a
// three-parameter `add` (CALLABLE-001): the forgotten argument is the likelier mistake, so that
// call's arity (SEM0007) is reported at the operand instead.
effect fn operatorFailure(resolver: &Resolver, module: &ModuleId, cursor: &AuthoredCursor, nodes: &[BodyNode],
  operands: &[BodyNodeId], failure: Shared<Rejection>) -> Shared<Rejection> ! RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let missing = Shared<Rejection>.with<bool>(&failure, fn(diagnostic: &Rejection) -> bool {
    return diagnostic.code == RejectionCode.MissingOperator
  })
  if !missing { return move failure }
  let mut at = usize.ZERO
  while at < operands.length {
    let index = operands[at].index
    if index < nodes.length {
      if let BodyNodeKind.Expression {form: BodyExpression.Aggregate {fields, section: Option<SectionRetention>.Some {value: retained}, ..}, ..} = &nodes[index].kind {
        let supplied = List<BodyAggregateField>.length(&fields)
        if retained.first > usize.ZERO && supplied > usize.ZERO {
          let span = run originSpan(cursor, nodes[index].origin)
          drop failure
          return run wrongArityRejection(resolver, module, span, retained.first + supplied, supplied)
        }
      }
    }
    at = at + usize.ONE
  }
  return move failure
}

// SEM0135, naming the operands when they print; `borrowed` tells the reader to compare shared
// borrows instead (`borrowedOperatorApplies`).
effect fn operatorRejection(module: &ModuleId, code: RejectionCode, span: Span, operator: &[u8], operands: &[Shared<Type>],
  borrowed: bool) -> Shared<Rejection> ! OutOfMemoryError ? &mut Allocator {
  let mut diagnostic = run makeRejection(code, module, span)
  if code == RejectionCode.MissingOperator {
    let mut spelled = Bytes.make()
    let mut named = true
    let mut at = usize.ZERO
    while named && at < operands.length {
      // An operand read through a reference carries the reference's local lifetime, which is
      // spelled elided, as the signature that introduced it writes it.
      let mut shown = run TypeText.display(&operands[at], module)
      if let Option<Bytes>.None = &shown { shown = run TypeText.displayElided(&operands[at], module) }
      if let Option<Bytes>.Some {value: text} = move shown {
        if at > usize.ZERO { run Bytes.append(&mut spelled, b", ") }
        run Bytes.append(&mut spelled, Bytes.asSlice(&text))
      } else {
        named = false
      }
      at = at + usize.ONE
    }
    if named {
      run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"operator"), value: run Bytes.copy(operator)})
      run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"operands"), value: move spelled})
      let mut choice: &'static [u8] = b"0"
      if borrowed { choice = b"1" }
      // `+` on two strings, as other languages join text, points at `String.append`.
      if same(operator, b"+") && operands.length == 2 && Shared<Type>.with<bool>(&operands[usize.ZERO], stringType)
        && Shared<Type>.with<bool>(&operands[usize.ONE], stringType) { choice = b"2" }
      run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"template"), value: run Bytes.copy(choice)})
    }
  }
  // OP-011: an enum operator names the enum, and both enums when they differ.
  if code == RejectionCode.CrossEnumEquality && operands.length == 2 {
    if let Option<Bytes>.Some {value: left} = move run TypeText.display(&operands[usize.ZERO], module) {
      if let Option<Bytes>.Some {value: right} = move run TypeText.display(&operands[usize.ONE], module) {
        run vectorArgument(&mut diagnostic, b"left", Bytes.asSlice(&left))
        run vectorArgument(&mut diagnostic, b"right", Bytes.asSlice(&right))
      }
    }
  }
  if code == RejectionCode.EnumOrdering || code == RejectionCode.EnumIntegerMismatch {
    let mut at = usize.ZERO
    while at < operands.length {
      if Shared<Type>.with<OwnerKind>(&operands[at], nominalKind) == OwnerKind.Enumeration {
        if let Option<Bytes>.Some {value: shown} = move run TypeText.display(&operands[at], module) {
          let name = run unqualifiedName(Bytes.asSlice(&shown))
          run vectorArgument(&mut diagnostic, b"enumName", Bytes.asSlice(&name))
          run vectorArgument(&mut diagnostic, b"operator", operator)
          // Equality between an enum and another type has its own template.
          if code == RejectionCode.EnumIntegerMismatch { run vectorArgument(&mut diagnostic, b"template", b"2") }
        }
        at = operands.length
      } else {
        at = at + usize.ONE
      }
    }
  }
  return run Shared<Rejection>.make(move diagnostic)
}

// Whether an unaccepted operator over two values of one type would accept shared borrows of them,
// as `Equal` and `Order` do: `a == b` on such a type is told to write `&a == &b`.
effect fn borrowedOperatorApplies(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  request: &mut Request, dependencies: &mut List<Dependency>, requested: &Operator.Spelling, operands: &[Shared<Type>],
  declared: &[Constraint], module: &ModuleId, span: Span) -> bool
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  if operands.length != 2 || !run Type.equalsShared(&operands[0], &operands[1]) { return false }
  let value = Shared<Type>.with<bool>(&operands[0], fn(ty: &Type) -> bool {
    return match &ty.* { Type.Reference {..} => false Type.Pointer {..} => false Type.Nominal {..} => true _ => false }
  })
  if !value { return false }
  let mut borrowed = List<Shared<Type>>.make()
  let mut at = usize.ZERO
  while at < operands.length {
    run List<Shared<Type>>.append(&mut borrowed, run Types.intern(Type.Reference {referent: Shared<Type>.clone(&operands[at]),
      access: Access.Shared, lifetime: run Shared<Lifetime>.make(Lifetime.Static)}))
    at = at + usize.ONE
  }
  // The probe's dependencies are the body's: a later `impl Equal` must bring the hint.
  let selected = run selectOperator(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, requested,
    List<Shared<Type>>.asSlice(&borrowed), declared, false, module, span)
  return match &selected {
    Result<Option<SelectedOperator>, Shared<Rejection>>.Success {value: Option<SelectedOperator>.Some {..}} => true
    _ => false
  }
}

// OP-011: an unaccepted operator over a scalar enum names the enum rule at the operator. Ordering
// never applies to an enum; equality needs one canonical enum on both sides.
fn missingInfixCode(operator: InfixOperator, left: OperatorFamily, right: OperatorFamily) -> RejectionCode {
  if left != OperatorFamily.ScalarEnum && right != OperatorFamily.ScalarEnum {
    return RejectionCode.MissingOperator
  }
  return match operator {
    InfixOperator.LessThan => RejectionCode.EnumOrdering
    InfixOperator.LessOrEqual => RejectionCode.EnumOrdering
    InfixOperator.GreaterThan => RejectionCode.EnumOrdering
    InfixOperator.GreaterOrEqual => RejectionCode.EnumOrdering
    InfixOperator.Equals => equalityEnumCode(left, right)
    InfixOperator.NotEquals => equalityEnumCode(left, right)
    _ => RejectionCode.MissingOperator
  }
}

fn equalityEnumCode(left: OperatorFamily, right: OperatorFamily) -> RejectionCode {
  if left == OperatorFamily.ScalarEnum && right == OperatorFamily.ScalarEnum {
    return RejectionCode.CrossEnumEquality
  }
  return RejectionCode.EnumIntegerMismatch
}

// An inequality or ordering operator reads its bound interface result (OP-009): `!=` negates
// `Equal.equals`, and `<`, `<=`, `>` and `>=` compare `Order.compare`'s `Ordering` with one member,
// in written operand order. Every other operator's value is the operation's result itself.
effect fn operatorPredicate(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, module: &ModuleId, cursor: &AuthoredCursor, nodes: &mut List<BodyNode>, operator: InfixOperator,
  expression: HirId, span: Span, called: CheckedOperatorCall) -> Result<CheckedOperatorCall, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let ordering = operator == InfixOperator.LessThan || operator == InfixOperator.LessOrEqual
    || operator == InfixOperator.GreaterThan || operator == InfixOperator.GreaterOrEqual
  if operator != InfixOperator.NotEquals && !ordering {
    return Result<CheckedOperatorCall, Shared<Rejection>>.succeed(move called)
  }
  let CheckedOperatorCall {ty: resultType, form: callForm} = move called
  let call = BodyNodeId {index: List<BodyNode>.length(&nodes.*)}
  run List<BodyNode>.append(&mut nodes.*, BodyNode {origin: run originAt(cursor, expression, span),
    kind: BodyNodeKind.Expression {ty: Shared<Type>.clone(&resultType), form: move callForm}})
  let boolean = run primitiveType(b"bool")
  if !ordering {
    return Result<CheckedOperatorCall, Shared<Rejection>>.succeed(CheckedOperatorCall {ty: move boolean,
      form: BodyExpression.ConcretePrefix {operator: PrefixOperator.Not, operand: call}})
  }
  let members = match move run subjectScalarEnum(&mut resolver.*, &mut owner.*, &mut dependencies.*, &resultType, span) {
    Option<Result<Shared<Result<Answer, NoRejection>>, Shared<Rejection>>>.Some {value: found} => match move found {
      Result<Shared<Result<Answer, NoRejection>>, Shared<Rejection>>.Success {value} => move value
      Result<Shared<Result<Answer, NoRejection>>, Shared<Rejection>>.Failure {error} => {
        return Result<CheckedOperatorCall, Shared<Rejection>>.failResult(move error)
      }
    }
    Option<Result<Shared<Result<Answer, NoRejection>>, Shared<Rejection>>>.None => {
      return Result<CheckedOperatorCall, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.MissingOperator, span))
    }
  }
  let less = operator == InfixOperator.LessThan || operator == InfixOperator.GreaterOrEqual
  let mut selected = Option<ScalarEnumMember>.none()
  if less {
    selected = Shared<Result<Answer, NoRejection>>.with<Option<ScalarEnumMember>>(&members,
      fn(answer: &Result<Answer, NoRejection>) -> Option<ScalarEnumMember> { return scalarEnumMember(answer, b"Less") })
  } else {
    selected = Shared<Result<Answer, NoRejection>>.with<Option<ScalarEnumMember>>(&members,
      fn(answer: &Result<Answer, NoRejection>) -> Option<ScalarEnumMember> { return scalarEnumMember(answer, b"Greater") })
  }
  let member = match move selected {
    Option<ScalarEnumMember>.Some {value} => value.value
    Option<ScalarEnumMember>.None => {
      return Result<CheckedOperatorCall, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.MissingOperator, span))
    }
  }
  let compared = BodyNodeId {index: List<BodyNode>.length(&nodes.*)}
  run List<BodyNode>.append(&mut nodes.*, BodyNode {origin: run originAt(cursor, expression, span),
    kind: BodyNodeKind.Expression {ty: move resultType, form: BodyExpression.EnumMember {member: member}}})
  let mut comparison = InfixOperator.NotEquals
  if operator == InfixOperator.LessThan || operator == InfixOperator.GreaterThan { comparison = InfixOperator.Equals }
  return Result<CheckedOperatorCall, Shared<Rejection>>.succeed(CheckedOperatorCall {ty: move boolean,
    form: BodyExpression.ConcreteInfix {operator: comparison, left: call, right: compared}})
}

// Environment handles can alias. Copy their member handles separately before any comparison.
effect fn callableEnvironmentRegions(environment: &Shared<Intersection>) -> List<Shared<Lifetime>>
! OutOfMemoryError ? &mut Allocator {
  let mut regions = List<Shared<Lifetime>>.make()
  let mut at = usize.ZERO
  while true {
    let region = Shared<Intersection>.with<Option<Shared<Lifetime>>>(environment,
      fn(value: &Intersection) -> Option<Shared<Lifetime>> {
        let members = List<LifetimeMember>.asSlice(&value.members)
        if at < members.length { return Option<Shared<Lifetime>>.some(Shared<Lifetime>.clone(&members[at].region)) }
        return Option<Shared<Lifetime>>.none()
      })
    if let Option<Shared<Lifetime>>.Some {value} = move region {
      run List<Shared<Lifetime>>.append(&mut regions, move value)
    } else { break }
    at = at + usize.ONE
  }
  return move regions
}

// The relations an admission leaves to the admitting body's region check. A loan region local to
// `caller` that no premise relates to a promised non-static region is deferred as a pair, as
// `admitsRegion` does for a reference, rather than refused: a reborrow of a parameter's referent
// gets its own body-local region, which the region check relates to its source (BORROW-005).
struct RegionDeferral {
  caller: DeclarationId,
  pairs: List<RegionPair>,
}

// Whether every offered environment region outlives some promised one. Without a deferral each
// must be proved by the declared premises.
effect fn callableEnvironmentOutlives(source: &Shared<Intersection>, target: &Shared<Intersection>, declared: &[Constraint],
  deferral: &mut Option<RegionDeferral>)
  -> bool ! OutOfMemoryError ? &mut Allocator {
  let first = run callableEnvironmentRegions(source)
  let mut second = run callableEnvironmentRegions(target)
  if List<Shared<Lifetime>>.length(&second) == usize.ZERO {
    run List<Shared<Lifetime>>.append(&mut second, run Shared<Lifetime>.make(Lifetime.Static))
  }
  let offered = List<Shared<Lifetime>>.asSlice(&first)
  let promised = List<Shared<Lifetime>>.asSlice(&second)
  let mut at = usize.ZERO
  while at < offered.length {
    let mut found = false
    let mut other = usize.ZERO
    while !found && other < promised.length {
      found = run knownOutlives(declared, &offered[at], &promised[other])
      other = other + usize.ONE
    }
    if !found {
      if let Option<RegionDeferral>.Some {value: open} = &mut deferral.* {
        if callerLocalRegion(&offered[at], &open.caller) {
          // Outliving any one promised member outlives their meet.
          other = usize.ZERO
          while !found && other < promised.length {
            if !Shared<Lifetime>.with<bool>(&promised[other], staticLifetime) {
              run List<RegionPair>.append(&mut open.pairs, RegionPair {offered: Shared<Lifetime>.clone(&offered[at]),
                wanted: Shared<Lifetime>.clone(&promised[other]), inferredStatic: Option<Shared<Lifetime>>.none()})
              found = true
            }
            other = other + usize.ONE
          }
        }
      }
    }
    if !found { return false }
    at = at + usize.ONE
  }
  return true
}

// Comparison returns obligations; only the caller's authenticated premises prove them.
// Under `RegionProof.RegionCheck` the body's region check relates the signatures' regions, so only
// a relation naming a region the contract quantifies over its invocations is typing's: it holds for
// every invocation or not at all, as rustc's higher-ranked subtyping does.
effect fn proveValueRelation(relation: &CallableContract.ValueRelation, premises: &[Constraint], proof: RegionProof) -> bool
! OutOfMemoryError ? &mut Allocator {
  let required = List<Outlives>.asSlice(&relation.outlives)
  let mut at = usize.ZERO
  while at < required.length {
    let quantified = Lifetime.anyAtom(&required[at].longer, invocationRegion) || Lifetime.anyAtom(&required[at].shorter, invocationRegion)
    if (proof == RegionProof.Typing || quantified) && !run knownOutlives(premises, &required[at].longer, &required[at].shorter) { return false }
    at = at + usize.ONE
  }
  let environments = List<CallableContract.EnvironmentRelation>.asSlice(&relation.environments)
  at = usize.ZERO
  while at < environments.length {
    if proof == RegionProof.RegionCheck {
      if !run quantifiedEnvironmentOutlives(&environments[at].source, &environments[at].target, premises) { return false }
    } else {
      let mut strict = Option<RegionDeferral>.none()
      if !run callableEnvironmentOutlives(&environments[at].source, &environments[at].target, premises, &mut strict) { return false }
    }
    at = at + usize.ONE
  }
  return true
}

// Whether every offered environment region naming a region the contract quantifies over its
// invocations outlives some promised one; the region check relates the other offered regions.
effect fn quantifiedEnvironmentOutlives(source: &Shared<Intersection>, target: &Shared<Intersection>, declared: &[Constraint]) -> bool
! OutOfMemoryError ? &mut Allocator {
  let first = run callableEnvironmentRegions(source)
  let mut second = run callableEnvironmentRegions(target)
  if List<Shared<Lifetime>>.length(&second) == usize.ZERO {
    run List<Shared<Lifetime>>.append(&mut second, run Shared<Lifetime>.make(Lifetime.Static))
  }
  let offered = List<Shared<Lifetime>>.asSlice(&first)
  let promised = List<Shared<Lifetime>>.asSlice(&second)
  let mut at = usize.ZERO
  while at < offered.length {
    if Lifetime.anyAtom(&offered[at], invocationRegion) {
      let mut found = false
      let mut other = usize.ZERO
      while !found && other < promised.length {
        found = run knownOutlives(declared, &offered[at], &promised[other])
        other = other + usize.ONE
      }
      if !found { return false }
    }
    at = at + usize.ONE
  }
  return true
}

// A local contents marker is an unresolved finite-body obligation. It cannot establish a
// public callable promise merely because the offered invocation signature is compatible.
effect fn unresolvedLocalCallableContents(value: &Shared<Type>, declared: &[Constraint]) -> bool
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let copied = run Type.copy(value)
  return match move copied {
    Type.CallableValue {contract, captures, ..} => run unresolvedLocalCaptureFields(&contract, List<Shared<Type>>.asSlice(&captures), declared)
    Type.CallableSchema {schema, captures, ..} => {
      let contract = Shared<SectionSchema>.with<Shared<Type>>(&schema,
        fn(value: &SectionSchema) -> Shared<Type> { return Shared<Type>.clone(&value.contract) })
      return run unresolvedLocalCaptureFields(&contract, List<Shared<Type>>.asSlice(&captures), declared)
    }
    Type.CallableStage {base, contract, captures, ..} => {
      if run unresolvedLocalCallableContents(&base, declared) { return true }
      return run unresolvedLocalCaptureFields(&contract, List<Shared<Type>>.asSlice(&captures), declared)
    }
    _ => {
      let mut components = List<Shared<Type>>.make()
      run Type.storedComponents(value, &mut components)
      let stored = List<Shared<Type>>.asSlice(&components)
      let mut at = usize.ZERO
      while at < stored.length {
        if run unresolvedLocalCallableContents(&stored[at], declared) { return true }
        at = at + usize.ONE
      }
      return false
    }
  }
}

fn localContentsRegion(value: &Lifetime) -> bool {
  return match &value.* { Lifetime.Local {..} => true Lifetime.Supplied {..} => true _ => false }
}

fn localContentsEnvironment(value: &Intersection) -> bool {
  let members = List<LifetimeMember>.asSlice(&value.members)
  let mut at = usize.ZERO
  while at < members.length {
    if Shared<Lifetime>.with<bool>(&members[at].region, localContentsRegion) { return true }
    at = at + usize.ONE
  }
  return false
}

fn localContentsContract(value: &Type) -> bool {
  return match &value.* { Type.Callable {environment, ..} => Shared<Intersection>.with<bool>(&environment, localContentsEnvironment) _ => false }
}

effect fn unresolvedLocalCaptureFields(contract: &Shared<Type>, captures: &[Shared<Type>], declared: &[Constraint]) -> bool
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let local = Shared<Type>.with<bool>(contract, localContentsContract)
  if !local { return false }
  let mut at = usize.ZERO
  while at < captures.length {
    if run unresolvedLocalCallableContents(&captures[at], declared) { return true }
    let mut parameters = List<Shared<Type>>.make()
    run Type.storedParameters(&captures[at], &mut parameters)
    let listed = List<Shared<Type>>.asSlice(&parameters)
    if listed.length != usize.ZERO {
      let owner = match move run Type.copy(&listed[usize.ZERO]) {
        Type.Parameter {declaration, ..} => move declaration
        _ => { return true }
      }
      let mut regions = List<Shared<Lifetime>>.make()
      let mut unresolved = List<Shared<Type>>.make()
      if !run captureContents(&captures[at], &owner, declared, &mut regions, &mut unresolved) { return true }
      if List<Shared<Type>>.length(&unresolved) != usize.ZERO { return true }
    }
    at = at + usize.ONE
  }
  return false
}

// A callable value whose parameter leaves out a member of the union its promise passes, such as an
// `Effect.catchAll` handler that accepts `Oops` for the failures `Oops | LogError`. A promise that
// returns an Effect is a failure handler (SEM0067); any other is a signature mismatch (SEM0076).
// None when every parameter accepts each member it can be passed.
// The spelling of a failure type: its members joined by ` | `, or none when one has no spelling.
// `Effect.catch<S>` whose `S` is not a failure of the handled Effect (SEM0067), naming `S` and the
// failures the Effect has.
effect fn selectedFailureRejection(module: &ModuleId, span: Span, selected: &Shared<Type>, source: &Shared<Type>)
-> Shared<Rejection> ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut diagnostic = run makeRejection(RejectionCode.InvalidEffectHandler, module, span)
  if let Option<Bytes>.Some {value: chosen} = move run failureText(module, selected) {
    let mut detail = run Bytes.copy(b"`")
    run Bytes.append(&mut detail, Bytes.asSlice(&chosen))
    run Bytes.append(&mut detail, b"` is not a failure of the handled Effect")
    if Shared<Type>.with<bool>(source, neverType) {
      run Bytes.append(&mut detail, b", which cannot fail")
    } else if let Option<Bytes>.Some {value: failures} = move run failureText(module, source) {
      run Bytes.append(&mut detail, b", which fails with `")
      run Bytes.append(&mut detail, Bytes.asSlice(&failures))
      run Bytes.append(&mut detail, b"`")
    }
    run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"detail"), value: move detail})
  }
  return run Shared<Rejection>.make(move diagnostic)
}

effect fn failureText(viewer: &ModuleId, ty: &Shared<Type>) -> Option<Bytes> ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let members = run Type.failureMembers(ty)
  let listed = List<Shared<Type>>.asSlice(&members)
  if listed.length <= usize.ONE { return run TypeText.display(ty, viewer) }
  let mut text = Bytes.make()
  let mut at = usize.ZERO
  while at < listed.length {
    match move run TypeText.display(&listed[at], viewer) {
      Option<Bytes>.Some {value} => {
        if at != usize.ZERO { run Bytes.append(&mut text, b" | ") }
        run Bytes.append(&mut text, Bytes.asSlice(&value))
      }
      Option<Bytes>.None => { return Option<Bytes>.none() }
    }
    at = at + usize.ONE
  }
  return Option<Bytes>.some(move text)
}

// A failure handler that is a plain `fn` returning a value where an Effect is promised, as in
// `Effect.catchAll(load(), recover)` with `fn recover(error: Problem) -> i32` (SEM0067). None when
// the promise does not return an Effect or the handler's result could still be one.
effect fn plainHandler(module: &ModuleId, offered: &CallableFacts, wanted: &CallableFacts, span: Span)
-> Option<Shared<Rejection>> ! OutOfMemoryError ? &mut Allocator | &mut Types {
  if !Shared<Type>.with<bool>(&wanted.result, bareEffect) || Shared<Type>.with<bool>(&offered.result, bareEffect)
    || Type.hasOpenParameters(&offered.result) {
    return Option<Shared<Rejection>>.none()
  }
  if let Option<Shared<Type>>.Some {..} = Shared<Type>.with<Option<Shared<Type>>>(&offered.result, delayedEffectContract) {
    return Option<Shared<Rejection>>.none()
  }
  let returned = match move run TypeText.display(&offered.result, module) {
    Option<Bytes>.Some {value} => move value
    Option<Bytes>.None => { return Option<Shared<Rejection>>.none() }
  }
  let mut detail = run Bytes.copy(b"the handler is a plain `fn` that returns `")
  run Bytes.append(&mut detail, Bytes.asSlice(&returned))
  run Bytes.append(&mut detail, b"`, but a handler returns the Effect that recovers; declare it `effect fn` with the same parameter and result")
  let mut diagnostic = run makeRejection(RejectionCode.InvalidEffectHandler, module, span)
  run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"detail"), value: move detail})
  return Option<Shared<Rejection>>.some(run Shared<Rejection>.make(move diagnostic))
}

effect fn narrowerParameter(module: &ModuleId, offered: &CallableFacts, wanted: &CallableFacts, span: Span)
-> Option<Shared<Rejection>> ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let accepted = List<Shared<Type>>.asSlice(&offered.parameters)
  let passed = List<Shared<Type>>.asSlice(&wanted.parameters)
  let mut at = usize.ZERO
  while at < accepted.length && at < passed.length {
    let members = run Type.failureMembers(&passed[at])
    let handler = Shared<Type>.with<bool>(&wanted.result, bareEffect)
    // A handler of an Effect with one failure is compared the same way: its parameter must accept it.
    let mut minimum = usize.ONE
    if handler { minimum = usize.ZERO }
    if !Type.hasOpenParameters(&passed[at]) && List<Shared<Type>>.length(&members) > minimum {
      let missing = run Type.uncoveredFailures(&accepted[at], &passed[at])
      let listed = List<Shared<Type>>.asSlice(&missing)
      if listed.length != usize.ZERO {
        let mut code = RejectionCode.IncompatibleCallableSignature
        if handler { code = RejectionCode.InvalidEffectHandler }
        let mut diagnostic = run makeRejection(code, module, span)
        let parameter = run failureText(module, &accepted[at])
        let mut names = Bytes.make()
        let mut named = true
        let mut member = usize.ZERO
        while member < listed.length {
          match move run TypeText.display(&listed[member], module) {
            Option<Bytes>.Some {value} => {
              if member != usize.ZERO { run Bytes.append(&mut names, b"`, `") }
              run Bytes.append(&mut names, Bytes.asSlice(&value))
            }
            Option<Bytes>.None => { named = false }
          }
          member = member + usize.ONE
        }
        if let Option<Bytes>.Some {value: accepts} = move parameter {
          if named && handler {
            let mut detail = run Bytes.copy(b"its parameter type `")
            run Bytes.append(&mut detail, Bytes.asSlice(&accepts))
            run Bytes.append(&mut detail, b"` does not accept `")
            run Bytes.append(&mut detail, Bytes.asSlice(&names))
            if listed.length == usize.ONE {
              run Bytes.append(&mut detail, b"`, a failure of the handled Effect; add it to the parameter's union")
            } else {
              run Bytes.append(&mut detail, b"`, failures of the handled Effect; add them to the parameter's union")
            }
            run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"detail"), value: move detail})
          }
        }
        return Option<Shared<Rejection>>.some(run Shared<Rejection>.make(move diagnostic))
      }
    }
    at = at + usize.ONE
  }
  return Option<Shared<Rejection>>.none()
}

effect fn proveCallableBound(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, module: &ModuleId, declared: &[Constraint],
  parameter: &Shared<Type>, contract: &Shared<Type>, span: Span, deferral: &mut Option<RegionDeferral>, proof: RegionProof,
) -> Option<Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let determined = Option<DeclarationId>.none()
  let source = match move run contextualCallableContract(&mut resolver.*, &mut owner.*, &mut dependencies.*, module,
    declared, parameter, contract, &determined, span) {
    Result<Option<Shared<Type>>, Shared<Rejection>>.Success {value} => move value
    Result<Option<Shared<Type>>, Shared<Rejection>>.Failure {error} => { return Option<Shared<Rejection>>.some(move error) }
  }
  let sourceType = match move source {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => {
      // An abstract representation may still need substitution; a closed non-callable
      // value is a proved signature mismatch.
      let mut code = RejectionCode.IncompatibleCallableSignature
      let reference = Shared<Type>.with<bool>(parameter, fn(value: &Type) -> bool {
        return match &value.* { Type.Reference {..} => true _ => false }
      })
      if Type.hasOpenParameters(parameter) && !reference { code = RejectionCode.Unsupported }
      return Option<Shared<Rejection>>.some(run reject(&resolver.*, module, code, span))
    }
  }
  let sourceFacts = run CallableContract.ofType(&sourceType)
  let targetFacts = run CallableContract.ofType(contract)
  if let Option<CallableFacts>.Some {value: offered} = move sourceFacts {
    if let Option<CallableFacts>.Some {value: wanted} = move targetFacts {
      let compared = run CallableContract.compare(&offered, &wanted)
      let relation = match move compared {
        Result<CallableContract.Relation, CallableFailure>.Success {value} => move value
        Result<CallableContract.Relation, CallableFailure>.Failure {error} => {
          if let Option<Shared<Rejection>>.Some {value: narrower} = move run narrowerParameter(module, &offered, &wanted, span) {
            return Option<Shared<Rejection>>.some(move narrower)
          }
          if let Option<Shared<Rejection>>.Some {value: plain} = move run plainHandler(module, &offered, &wanted, span) {
            return Option<Shared<Rejection>>.some(move plain)
          }
          let code = match error { CallableFailure.Incompatible => RejectionCode.IncompatibleCallableSignature
            CallableFailure.Unsupported => RejectionCode.Unsupported }
          return Option<Shared<Rejection>>.some(run reject(&resolver.*, module, code, span))
        }
      }
      // That the offered environment outlives the promised one is the bound's region part (`F: 'e`),
      // which a body's region check holds from the call's contract.
      if proof == RegionProof.Typing
        && !run callableEnvironmentOutlives(&relation.sourceEnvironment, &relation.targetEnvironment, declared, &mut deferral.*) {
        let mut code = RejectionCode.UnsatisfiedLifetimeBound
        if run unresolvedLocalCallableContents(parameter, declared) { code = RejectionCode.Unsupported }
        return Option<Shared<Rejection>>.some(run reject(&resolver.*, module, code, span))
      }
      let mut premises = run copyConstraints(declared)
      let provided = List<Outlives>.asSlice(&relation.provided)
      let mut at = usize.ZERO
      while at < provided.length {
        run List<Constraint>.append(&mut premises, Constraint.Outlives {
          longer: Shared<Lifetime>.clone(&provided[at].longer), shorter: Shared<Lifetime>.clone(&provided[at].shorter),
          },
        )
        at = at + usize.ONE
      }
      run invocationUseConstraints(List<Shared<Type>>.asSlice(&wanted.parameters), wanted.invocationUse,
        &Option<DeclarationId>.none(), &mut premises)
      if !run proveValueRelation(&relation.required, List<Constraint>.asSlice(&premises), proof) {
        return Option<Shared<Rejection>>.some(run reject(&resolver.*, module, RejectionCode.IncompatibleCallableSignature, span))
      }
      return Option<Shared<Rejection>>.none()
    }
  }
  let effectsBound = run effectBound(&sourceType, contract)
  if let Option<EffectBound>.Some {value: effects} = move effectsBound {
    return run proveEffectBound(&resolver.*, module, declared, &effects, span, proof)
  }
  return Option<Shared<Rejection>>.some(run reject(&resolver.*, module, RejectionCode.IncompatibleCallableSignature, span),
  )
}

// One offered exact Effect contract and the use contract it must satisfy.
struct EffectBound {
  offered: EffectParts,
  wanted: EffectParts,
}

struct EffectParts {
  mode: CallableMode,
  environment: Shared<Intersection>,
  success: Shared<Type>,
  failure: Shared<Type>,
  requirements: Shared<Row>,
}

fn effectParts(value: &Type) -> Option<EffectParts> {
  return match &value.* {
    Type.Effect {mode, environment, success, failure, requirements} => Option<EffectParts>.some(EffectParts {
      mode: mode, environment: Shared<Intersection>.clone(&environment), success: Shared<Type>.clone(&success),
      failure: Shared<Type>.clone(&failure), requirements: Shared<Row>.clone(&requirements),
    })
    Type.CallableValue {contract, ..} => Shared<Type>.with<Option<EffectParts>>(&contract, effectParts)
    Type.CallableWitnessResult {witness} => Shared<WitnessRecipe>.with<Option<EffectParts>>(&witness, fn(recipe: &WitnessRecipe) -> Option<EffectParts> {
      if !recipe.constructs { return Option<EffectParts>.none() }
      return Shared<Type>.with<Option<EffectParts>>(&recipe.result, effectParts)
    })
    Type.EffectComposite {contract, ..} => Shared<Type>.with<Option<EffectParts>>(&contract, effectParts)
    Type.EffectJoin {contract, ..} => Shared<Type>.with<Option<EffectParts>>(&contract, effectParts)
    Type.OpaqueRepresentation {contract, ..} => Shared<Type>.with<Option<EffectParts>>(&contract, effectParts)
    _ => Option<EffectParts>.none()
  }
}

effect fn effectBound(source: &Shared<Type>, target: &Shared<Type>) -> Option<EffectBound> ! OutOfMemoryError ? &mut Allocator {
  let offered = Shared<Type>.with<Option<EffectParts>>(source, effectParts)
  let wanted = Shared<Type>.with<Option<EffectParts>>(target, effectParts)
  if let Option<EffectParts>.Some {value: left} = move offered {
    if let Option<EffectParts>.Some {value: right} = move wanted {
      return Option<EffectBound>.some(EffectBound {offered: move left, wanted: move right})
    }
  }
  return Option<EffectBound>.none()
}

fn runStrength(mode: CallableMode) -> usize {
  return match mode { CallableMode.Shared => usize.ZERO CallableMode.Mutable => usize.ONE CallableMode.Once => 2 }
}

// An exact Effect satisfies a use contract whose run access it permits, whose channels cover its
// own and whose environment it outlives (EFF-013, REP-002). Under `RegionProof.RegionCheck` the
// environment part is the region check's.
effect fn proveEffectBound(resolver: &Resolver, module: &ModuleId, declared: &[Constraint], bound: &EffectBound, span: Span,
  proof: RegionProof) -> Option<Shared<Rejection>> ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut strict = Option<RegionDeferral>.none()
  if run admitsEffectParts(&bound.offered, &bound.wanted, declared, &mut strict, proof) { return Option<Shared<Rejection>>.none() }
  return Option<Shared<Rejection>>.some(run reject(resolver, module, RejectionCode.IncompatibleCallableSignature, span))
}

// The offered channels and whole canonical environment infer the promised slots. A bound is
// covariant in its environment: when the exact equation leaves open promised members, each takes
// the complete offered meet, never a constituent or partition. Admission proves the full contract.
effect fn inferEffectBound(fresh: &DeclarationId, inferred: &mut List<Binding>, bound: &EffectBound,
  declared: &[Constraint])
  -> () ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut variables = List<Shared<DeclarationId>>.make()
  run List<Shared<DeclarationId>>.append(&mut variables, run Shared<DeclarationId>.make(DeclarationId.copy(fresh)))
  let mut patterns = List<Shared<Type>>.make()
  let mut evidence = List<Shared<Type>>.make()
  run List<Shared<Type>>.append(&mut patterns, Shared<Type>.clone(&bound.wanted.success))
  run List<Shared<Type>>.append(&mut evidence, Shared<Type>.clone(&bound.offered.success))
  run List<Shared<Type>>.append(&mut patterns, Shared<Type>.clone(&bound.wanted.failure))
  run List<Shared<Type>>.append(&mut evidence, Shared<Type>.clone(&bound.offered.failure))
  run List<Shared<Type>>.append(&mut patterns, run rowCarrier(&bound.wanted.requirements))
  run List<Shared<Type>>.append(&mut evidence, run rowCarrier(&bound.offered.requirements))
  let unified = run Type.unifyAll(List<Shared<Type>>.asSlice(&patterns), List<Shared<Type>>.asSlice(&evidence),
    List<Shared<DeclarationId>>.asSlice(&variables), Comparison.Exact, &mut inferred.*)
  let joint = match &unified { Unification.Unified => true _ => false }
  if !joint {
    // A failure the call already fixed wider, as `E` fixed by a handler `onAny(error: Overdrawn |
    // Frozen)` before an Effect failing with `Frozen` is piped in, still covers the offered one
    // (the bound's proof checks it); the success and requirements are inferred without it.
    let failurePattern = List<Shared<Type>>.remove(&mut patterns, usize.ONE)
    let failureEvidence = List<Shared<Type>>.remove(&mut evidence, usize.ONE)
    drop run Type.unifyAll(List<Shared<Type>>.asSlice(&patterns), List<Shared<Type>>.asSlice(&evidence),
      List<Shared<DeclarationId>>.asSlice(&variables), Comparison.Exact, &mut inferred.*)
    drop run Type.unify(&failurePattern, &failureEvidence, List<Shared<DeclarationId>>.asSlice(&variables), Comparison.Exact,
      &mut inferred.*)
  }
  drop unified
  let carrier = run Types.intern(Type.Effect {
    mode: bound.wanted.mode, environment: Shared<Intersection>.clone(&bound.wanted.environment),
    success: Shared<Type>.clone(&bound.wanted.success), failure: Shared<Type>.clone(&bound.wanted.failure),
    requirements: Shared<Row>.clone(&bound.wanted.requirements)})
  let environment = run Type.unifyEnvironments(&bound.wanted.environment, &bound.offered.environment, &carrier,
    List<Shared<DeclarationId>>.asSlice(&variables), &mut inferred.*)
  drop environment
  let given = run callableEnvironmentRegions(&bound.offered.environment)
  let sources = List<Shared<Lifetime>>.asSlice(&given)
  let mut at = usize.ZERO
  while at < sources.length {
    if ownedLifetimeOrdinal(&sources[at], fresh) != usize.MAX { return () }
    at = at + usize.ONE
  }
  let offered = run Lifetime.meet(sources)
  let regions = run callableEnvironmentRegions(&bound.wanted.environment)
  let targets = List<Shared<Lifetime>>.asSlice(&regions)
  at = usize.ZERO
  while at < targets.length {
    let ordinal = ownedLifetimeOrdinal(&targets[at], fresh)
    if ordinal != usize.MAX {
      let known = bindingArgument(List<Binding>.asSlice(&inferred.*), fresh, ordinal)
      if let Option<Argument>.None = move known {
        run List<Binding>.append(&mut inferred.*, Binding {
          declaration: run Shared<DeclarationId>.make(DeclarationId.copy(fresh)), ordinal: ordinal,
          value: Argument.Lifetime {value: Shared<Lifetime>.clone(&offered)},
        })
      }
    }
    at = at + usize.ONE
  }
  return ()
}

// A representation parameter first acquires its exact value type from an operand. Its
// promised signature can then infer ordinary type parameters and an elided environment.
// SEM0052 for an Effect that can fail with `failure` passed where the callee requires one that
// cannot, suggesting `Effect.result` to turn its errors into the value.
effect fn failingEffectRejection(module: &ModuleId, span: Span, failure: &Shared<Type>) -> Shared<Rejection>
! OutOfMemoryError ? &mut Allocator {
  let mut diagnostic = run makeRejection(RejectionCode.TypeArgumentInference, module, span)
  diagnostic.arguments = List<MessageArgument>.make()
  run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"template"), value: run Bytes.copy(b"1")})
  let errors = match move run TypeText.displayElided(failure, module) {
    Option<Bytes>.Some {value} => move value
    Option<Bytes>.None => run Bytes.copy(b"an error")
  }
  run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"errors"), value: move errors})
  return run Shared<Rejection>.make(move diagnostic)
}

// Whether `rejection` is the failing-Effect form of SEM0052, which names the Effect's errors.
fn failingEffectNamed(rejection: &Rejection) -> bool {
  let listed = List<MessageArgument>.asSlice(&rejection.arguments)
  let mut at = usize.ZERO
  while at < listed.length {
    if same(Bytes.asSlice(&listed[at].name), b"errors") { return true }
    at = at + usize.ONE
  }
  return false
}

effect fn inferCallableBound(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, module: &ModuleId, fresh: &DeclarationId,
  declared: &[Constraint], inferred: &mut List<Binding>, parameter: &Shared<Type>, contract: &Shared<Type>, span: Span,
)
  -> Option<Shared<Rejection>> ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let actual = run Type.applyBindings(parameter, List<Binding>.asSlice(&inferred.*), true)
  let promised = run Type.applyBindings(contract, List<Binding>.asSlice(&inferred.*), true)
  let mut pending = Option<DeclarationId>.none()
  if Shared<Type>.with<bool>(&actual, genericSectionType) && run sectionContextUndetermined(&promised, fresh) {
    // A generic function value has no exact contract until its use selects one. The positions
    // this call already determined, such as the parameters, may select it; its instantiated
    // result is then evidence for the still-open positions. Otherwise it stays deferred. A
    // selection the determined positions reject is the call's error, not a deferral.
    pending = Option<DeclarationId>.some(DeclarationId.copy(fresh))
  }
  let selected = run contextualCallableContract(&mut resolver.*, &mut owner.*, &mut dependencies.*, module,
    declared, &actual, &promised, &pending, span)
  let source = match move selected {
    Result<Option<Shared<Type>>, Shared<Rejection>>.Success {value} => move value
    Result<Option<Shared<Type>>, Shared<Rejection>>.Failure {error} => { return Option<Shared<Rejection>>.some(move error) }
  }
  let sourceType = match move source {
    Option<Shared<Type>>.Some {value} => move value
    _ => { return Option<Shared<Rejection>>.none() }
  }
  let effectsBound = run effectBound(&sourceType, &promised)
  if let Option<EffectBound>.Some {value: effects} = move effectsBound {
    // An Effect that can fail, such as an `effect fn` call with `! OutOfMemoryError`, offered
    // where one that cannot is required, as by `Pool.spawn`, determines no binding.
    if Shared<Type>.with<bool>(&effects.wanted.failure, neverType) && !Shared<Type>.with<bool>(&effects.offered.failure, neverType) {
      return Option<Shared<Rejection>>.some(run failingEffectRejection(module, span, &effects.offered.failure))
    }
    run inferEffectBound(fresh, &mut inferred.*, &effects, declared)
    return Option<Shared<Rejection>>.none()
  }
  let sourceFacts = run CallableContract.ofType(&sourceType)
  let targetFacts = run CallableContract.ofType(&promised)
  if let Option<CallableFacts>.Some {value: offered} = move sourceFacts {
    if let Option<CallableFacts>.Some {value: wanted} = move targetFacts {
      // A binder-free offer satisfies a quantified promise for every invocation, as comparison
      // admits; the promise's opened regions stay rigid evidence.
      if offered.invocationBinders != wanted.invocationBinders && offered.invocationBinders != usize.ZERO {
        return Option<Shared<Rejection>>.none()
      }
      let mut variables = List<Shared<DeclarationId>>.make()
      run List<Shared<DeclarationId>>.append(&mut variables, run Shared<DeclarationId>.make(DeclarationId.copy(fresh)),
      )
      let rigid = run DeclarationId.inference(fresh, b"\0callable-bound-rigids")
      let mark = List<Binding>.length(&inferred.*)
      let mut trial = List<Binding>.make()
      let current = List<Binding>.asSlice(&inferred.*)
      let mut copyAt = usize.ZERO
      while copyAt < current.length {
        run List<Binding>.append(&mut trial, Binding {declaration: Shared<DeclarationId>.clone(&current[copyAt].declaration),
          ordinal: current[copyAt].ordinal, value: Argument.copy(&current[copyAt].value),
          },
        )
        copyAt = copyAt + usize.ONE
      }
      let provided = List<Shared<Type>>.asSlice(&offered.parameters)
      let expected = List<Shared<Type>>.asSlice(&wanted.parameters)
      let mut at = usize.ZERO
      while at < provided.length && at < expected.length {
        let pattern = run Type.openInvocation(&expected[at], &rigid)
        let evidence = run Type.openInvocation(&provided[at], &rigid)
        let compared = run Type.unify(&pattern, &evidence, List<Shared<DeclarationId>>.asSlice(&variables), Comparison.Exact, &mut trial,
        )
        drop compared
        at = at + usize.ONE
      }
      let pattern = run Type.openInvocation(&wanted.result, &rigid)
      let evidence = run Type.openInvocation(&offered.result, &rigid)
      // A delayed Effect result is covariant in its run access, so its channels and environment
      // are the evidence; the comparison later proves the access.
      let delayed = run effectBound(&evidence, &pattern)
      if let Option<EffectBound>.Some {value: effects} = move delayed {
        run inferEffectBound(fresh, &mut trial, &effects, declared)
      } else {
        let compared = run Type.unify(&pattern, &evidence, List<Shared<DeclarationId>>.asSlice(&variables), Comparison.Exact, &mut trial,
        )
        drop compared
      }
      let added = List<Binding>.asSlice(&trial)
      let mut checkAt = mark
      while checkAt < added.length {
        if run argumentMentionsOwner(&added[checkAt].value, &rigid) {
          let mut code = RejectionCode.TypeArgumentInference
          // An Effect result needs Effect environment and run-mode inference (named effect-form gap).
          if Shared<Type>.with<bool>(&offered.result, bareEffect) { code = RejectionCode.EffectFormUnavailable }
          return Option<Shared<Rejection>>.some(run reject(&resolver.*, module, code, span))
        }
        checkAt = checkAt + usize.ONE
      }
      inferred.* = move trial
      let environment = run Type.unifyEnvironments(&wanted.environment, &offered.environment, &promised,
        List<Shared<DeclarationId>>.asSlice(&variables), &mut inferred.*)
      drop environment
    }
  }
  return Option<Shared<Rejection>>.none()
}

// A callable use contract belongs to an exact value or one declared representation bound.
// Argument ownership includes the reference descriptor around an exact callable; invocation
// still requires the programmer's explicit referent projection.
effect fn callableArgumentContract(value: &Shared<Type>, constraints: &[Constraint]) -> Option<Shared<Type>>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let copied = run Type.copy(value)
  if let Type.Reference {referent, ..} = move copied {
    return run callableArgumentContract(&referent, constraints)
  }
  return run valueCallableContract(value, constraints)
}

// The callable use contract of an exact callable value, or none for a value that is itself a
// contract or whose use contract is not a callable contract.
effect fn exactCallableContract(value: &Shared<Type>, constraints: &[Constraint]) -> Option<Shared<Type>>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  if Shared<Type>.with<bool>(value, callableContractType) { return Option<Shared<Type>>.none() }
  if let Option<Shared<Type>>.Some {value: contract} = move run valueCallableContract(value, constraints) {
    if Shared<Type>.with<bool>(&contract, callableContractType) { return Option<Shared<Type>>.some(move contract) }
  }
  return Option<Shared<Type>>.none()
}

fn callableContractType(value: &Type) -> bool {
  return match &value.* { Type.Callable {..} => true _ => false }
}

fn callableModeStrength(mode: CallableMode) -> usize {
  return match mode { CallableMode.Shared => usize.ZERO CallableMode.Mutable => usize.ONE CallableMode.Once => 2 }
}

// An exact callable's use contract `used` read at the invocation mode a written contract asks
// for, when that mode asks no more of it: a shared callable serves a `mut fn` or `once fn` use and
// a mutable one a `once fn` use, as it would bound to a parameter of that contract (CALLABLE-002).
effect fn weakenedCallableContract(used: &Shared<Type>, written: &Shared<Type>) -> Option<Shared<Type>>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let wanted = Shared<Type>.with<Option<CallableMode>>(written, fn(value: &Type) -> Option<CallableMode> {
    return match &value.* { Type.Callable {mode, ..} => Option<CallableMode>.some(mode) _ => Option<CallableMode>.none() }
  })
  let mode = match move wanted {
    Option<CallableMode>.Some {value} => value
    Option<CallableMode>.None => { return Option<Shared<Type>>.none() }
  }
  let copied = run Type.copy(used)
  if let Type.Callable {mode: offered, isUnsafe, environment, invocationBinders, invocationUse, invocationBounds, parameters, result} = move copied {
    if offered != mode && callableModeStrength(offered) < callableModeStrength(mode) {
      return Option<Shared<Type>>.some(run Types.intern(Type.Callable {mode: mode, isUnsafe: isUnsafe, environment: move environment,
        invocationBinders: invocationBinders, invocationUse: invocationUse, invocationBounds: move invocationBounds,
        parameters: move parameters, result: move result}))
    }
  }
  return Option<Shared<Type>>.none()
}

effect fn valueCallableContract(value: &Shared<Type>, constraints: &[Constraint]) -> Option<Shared<Type>,
>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let copied = run Type.copy(value)
  match move copied {
    Type.ForeignFunction {signature, ..} => { return Option<Shared<Type>>.some(move signature) }
    Type.CallableValue {contract, ..} => { return Option<Shared<Type>>.some(move contract) }
    Type.CallableView {contract, ..} => { return Option<Shared<Type>>.some(move contract) }
    Type.CallableOrigin {contract, ..} => { return Option<Shared<Type>>.some(move contract) }
    Type.CallableWitnessResult {witness} => { return Option<Shared<Type>>.some(Shared<WitnessRecipe>.with<Shared<Type>>(&witness,
      CallableWitness.resultType)) }
    Type.CallableResult {contract, ..} => { return Option<Shared<Type>>.some(move contract) }
    Type.CallableStage {contract, ..} => { return Option<Shared<Type>>.some(move contract) }
    Type.CallableSchema {schema, ..} => { return Option<Shared<Type>>.some(sectionSchemaContract(&schema)) }
    Type.EffectComposite {contract, ..} => { return Option<Shared<Type>>.some(move contract) }
    Type.EffectJoin {contract, ..} => { return Option<Shared<Type>>.some(move contract) }
    Type.Callable {..} => { return Option<Shared<Type>>.some(Shared<Type>.clone(value)) }
    // An Effect produced by invoking a callable value is its own use contract.
    Type.Effect {..} => { return Option<Shared<Type>>.some(Shared<Type>.clone(value)) }
    Type.Reference {..} => { return Option<Shared<Type>>.none() }
    Type.OpaqueRepresentation {contract, ..} => { return run valueCallableContract(&contract, constraints) }
    _ => ()
  }
  let mut at = usize.ZERO
  while at < constraints.length {
    if let Constraint.Represents {parameter, contract} = &constraints[at] {
      if run Type.equalsShared(value, &parameter) { return Option<Shared<Type>>.some(Shared<Type>.clone(&contract)) }
    }
    at = at + usize.ONE
  }
  return Option<Shared<Type>>.none()
}

// Whether `value` is a representation parameter, whose contract a `Represents` constraint states.
effect fn representedValue(value: &Shared<Type>, constraints: &[Constraint]) -> bool ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut at = usize.ZERO
  while at < constraints.length {
    if let Constraint.Represents {parameter, ..} = &constraints[at] {
      if run Type.equalsShared(value, &parameter) { return true }
    }
    at = at + usize.ONE
  }
  return false
}

// `input: 'call` for every input of a contract whose `for<use 'call>` binder has canonical ordinal
// `marked`: an obligation on a caller, or a premise inside a checked callback. With an `opener`,
// the inputs are already opened in that invocation and the binder is opened the same way.
effect fn invocationUseConstraints(inputs: &[Shared<Type>], marked: usize, opener: &Option<DeclarationId>,
  constraints: &mut List<Constraint>) -> () ! OutOfMemoryError ? &mut Allocator {
  if marked == usize.MAX { return () }
  let mut region = run Shared<Lifetime>.make(Lifetime.Invocation {ordinal: marked})
  if let Option<DeclarationId>.Some {value: caller} = &opener.* { region = run Type.openInvocationLifetime(&region, &caller) }
  let mut at = usize.ZERO
  while at < inputs.length {
    run List<Constraint>.append(&mut constraints.*, Constraint.Contents {
      subject: Shared<Type>.clone(&inputs[at]), region: Shared<Lifetime>.clone(&region)})
    at = at + usize.ONE
  }
}

// Open only this call's quantified regions. The ordinary argument checker can then infer them
// using the same Signature representation and outlives prover as a named call.
effect fn callableInferenceSignature(contract: &Shared<Type>, fresh: &DeclarationId, supplied: usize) -> Option<Shared<Result<Answer, NoRejection>>,
>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let copied = run Type.copy(contract)
  if let Type.Callable {isUnsafe, invocationBinders, invocationUse, invocationBounds, parameters, result, ..} = move copied {
    let mut regions = List<Shared<Lifetime>>.make()
    let mut opened = List<Shared<Type>>.make()
    let mut bounds = List<Constraint>.make()
    let mut representations = List<Shared<Type>>.make()
    let mut representationOrdinal = invocationBinders
    let mut callableParameterStart = usize.MAX
    let mut at = usize.ZERO
    while at < invocationBinders {
      run List<Shared<Lifetime>>.append(&mut regions, run Shared<Lifetime>.make(Lifetime.Parameter {
        declaration: DeclarationId.copy(fresh), ordinal: at},
      ),
      )
      at = at + usize.ONE
    }
    let listed = List<Shared<Type>>.asSlice(&parameters)
    let mut firstSupplied = listed.length
    if supplied <= listed.length { firstSupplied = listed.length - supplied }
    at = usize.ZERO
    while at < listed.length {
      let parameter = run Type.openInvocation(&listed[at], fresh)
      // Leading unsupplied parameters remain public contracts of the constructed section.
      let mut reified = Option<CallableParameter.CallableParameter>.none()
      if at >= firstSupplied { reified = run CallableParameter.reify(&parameter, fresh, representationOrdinal) }
      match move reified {
        Option<CallableParameter.CallableParameter>.Some {value} => {
          if callableParameterStart == usize.MAX { callableParameterStart = representationOrdinal }
          let slots = List<CallableParameter.RepresentationSlot>.asSlice(&value.slots)
          let mut slotAt = usize.ZERO
          while slotAt < slots.length {
            run List<Shared<Type>>.append(&mut representations, Shared<Type>.clone(&slots[slotAt].representation))
            run List<Constraint>.append(&mut bounds, Constraint.Represents {
              parameter: Shared<Type>.clone(&slots[slotAt].representation), contract: Shared<Type>.clone(&slots[slotAt].contract)})
            representationOrdinal = representationOrdinal + usize.ONE
            slotAt = slotAt + usize.ONE
          }
          run List<Shared<Type>>.append(&mut opened, move value.ty)
        }
        _ => { run List<Shared<Type>>.append(&mut opened, move parameter) }
      }
      at = at + usize.ONE
    }
    // The caller supplies every input for the marked invocation extent (LIFE-004).
    run invocationUseConstraints(List<Shared<Type>>.asSlice(&opened), invocationUse,
      &Option<DeclarationId>.some(DeclarationId.copy(fresh)), &mut bounds)
    let promised = List<Outlives>.asSlice(&invocationBounds)
    at = usize.ZERO
    while at < promised.length {
      run List<Constraint>.append(&mut bounds, Constraint.Outlives {
        longer: run Type.openInvocationLifetime(&promised[at].longer, fresh),
        shorter: run Type.openInvocationLifetime(&promised[at].shorter, fresh),
      },
      )
      at = at + usize.ONE
    }
    let answer = memberSuccess(Value.Signature {signature: Signature {
      typeParameters: move representations,
      callableParameterStart: callableParameterStart, lifetimeParameters: move regions,
      rowParameters: List<RowParameter>.make(), constraints: move bounds, parameters: move opened,
      result: run Type.openInvocation(&result, fresh), failure: run primitiveType(b"never"),
      requirements: run Shared<Row>.make(Row.empty()), isEffect: false, isVariadic: false, isUnsafe: isUnsafe,
      isStatic: false, staticSlots: List<usize>.make(), environment: Option<Intersection>.none(), environmentWritten: false,
      environmentExempt: usize.MAX,
    },
      }, List<Dependency>.make(),
    )
    return Option<Shared<Result<Answer, NoRejection>>>.some(run Shared<Result<Answer, NoRejection>>.make(Result<Answer, NoRejection>.succeed(move answer)),
    )
  }
  return Option<Shared<Result<Answer, NoRejection>>>.none()
}

effect fn checkCallableInvocation<'scope>(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, request: &mut Request,
  dependencies: &mut List<Dependency>, module: &ModuleId, cursor: &AuthoredCursor,
  caller: &DeclarationId, statementScope: &mut StatementScope<'scope>, calls: &[ResolvedCall], nodes: &mut List<BodyNode>,
  signatures: &mut List<SignatureDependency>, requiredBodies: &mut List<DeclarationId>,
  expression: HirId, callee: HirId, generics: HirRef, arguments: CallArguments, pipeline: bool,
  expected: &Option<Shared<Type>>, mismatchCode: RejectionCode, constraints: &[Constraint], contractBody: bool,
  staticBody: bool, unsafeAllowed: bool, callAcknowledged: bool,
) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let span = run bodySpan(&resolver.source, cursor, expression)
  let calleeSpan = run bodySpan(&resolver.source, cursor, callee)
  if staticBody { return run bodyRejection(&resolver.*, module, RejectionCode.StaticPhaseViolation, span) }
  let checked = run checkExpression(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
    module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*,
    &mut requiredBodies.*, callee, &Option<Shared<Type>>.none(), RejectionCode.TypeMismatch, constraints, contractBody, false, unsafeAllowed,
  )
  let target = match move checked {
    Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
    Result<BodyNodeId, Shared<Rejection>>.Failure {error} => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move error) }
  }
  return run invokeCallableValue(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
    module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*,
    expression, callee, target, generics, arguments, pipeline, expected, mismatchCode, constraints, contractBody,
    unsafeAllowed, callAcknowledged)
}

// Whether every one of a callable's invocation regions is bound at this site.
fn invocationBindersBound(bindings: &[Binding], fresh: &DeclarationId, binders: usize) -> bool {
  let mut ordinal = usize.ZERO
  while ordinal < binders {
    if !invocationRegionBound(bindings, fresh, ordinal) { return false }
    ordinal = ordinal + usize.ONE
  }
  return true
}

fn invocationRegionBound(bindings: &[Binding], fresh: &DeclarationId, ordinal: usize) -> bool {
  let mut at = usize.ZERO
  while at < bindings.length {
    if bindings[at].ordinal == ordinal && declarationEqualsShared(fresh, &bindings[at].declaration) { return true }
    at = at + usize.ONE
  }
  return false
}

// Invokes an already checked callable place. Field dispatch supplies its projected target here
// so the record expression and every ownership transfer are checked exactly once.
effect fn invokeCallableValue<'scope>(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, request: &mut Request,
  dependencies: &mut List<Dependency>, module: &ModuleId, cursor: &AuthoredCursor,
  caller: &DeclarationId, statementScope: &mut StatementScope<'scope>, calls: &[ResolvedCall], nodes: &mut List<BodyNode>,
  signatures: &mut List<SignatureDependency>, requiredBodies: &mut List<DeclarationId>,
  expression: HirId, callee: HirId, checkedTarget: BodyNodeId, generics: HirRef, arguments: CallArguments, pipeline: bool,
  expected: &Option<Shared<Type>>, mismatchCode: RejectionCode, constraints: &[Constraint], contractBody: bool,
  unsafeAllowed: bool, callAcknowledged: bool,
) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let span = run bodySpan(&resolver.source, cursor, expression)
  let calleeSpan = run bodySpan(&resolver.source, cursor, callee)
  let mut target = checkedTarget
  let actual = match move bodyExpressionType(List<BodyNode>.asSlice(&nodes.*), &target) {
    Option<Shared<Type>>.Some {value} => move value
    _ => { return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span) }
  }
  let contract = match move run valueCallableContract(&actual, constraints) {
    Option<Shared<Type>>.Some {value} => move value
    _ => { return run bodyRejection(&resolver.*, module, RejectionCode.NotCallable, calleeSpan) }
  }
  if generics.present { return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span) }
  let mut inferenceScope = Bytes.make()
  run Bytes.append(&mut inferenceScope, b"\0callable-inference")
  run RuntimeEncoding.declaration(&mut inferenceScope, caller)
  run RuntimeEncoding.word(&mut inferenceScope, usize.toU64(expression.index))
  run RuntimeEncoding.word(&mut inferenceScope, usize.toU64(resolver.nextInferenceId))
  resolver.nextInferenceId = resolver.nextInferenceId + usize.ONE
  let fresh = run DeclarationId.inference(caller, Bytes.asSlice(&inferenceScope))
  let schema = Shared<Type>.with<Option<Shared<SectionSchema>>>(&actual, sectionSchemaOf)
  let schemaInputs = run sectionFieldInputs(&actual)
  // A section's bound lifetimes are inference evidence, not written lifetimes of its contract.
  let mut inferred = List<Binding>.make()
  let inference = match &schema {
    Option<Shared<SectionSchema>>.Some {value} => match move run sectionSchemaSignature(&mut resolver.*,
      &mut owner.*, &mut dependencies.*, &value, List<CallableFieldInput>.asSlice(&schemaInputs), &fresh, module, span,
      true, &mut inferred) {
      Result<Shared<Result<Answer, NoRejection>>, Shared<Rejection>>.Success {value: opened} => move opened
      Result<Shared<Result<Answer, NoRejection>>, Shared<Rejection>>.Failure {error} => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move error) }
    }
    Option<Shared<SectionSchema>>.None => match move run callableInferenceSignature(&contract, &fresh, CallArguments.length(arguments)) {
      Option<Shared<Result<Answer, NoRejection>>>.Some {value} => move value
      _ => { return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span) }
    }
  }
  let mut captured = List<Shared<Type>>.make()
  if let Option<Shared<SectionSchema>>.Some {value} = &schema {
    captured = match move run sectionCapturedParameters(&mut resolver.*, &mut owner.*, &mut dependencies.*, &value,
      List<CallableFieldInput>.asSlice(&schemaInputs), &fresh, module, span) {
      Result<List<Shared<Type>>, Shared<Rejection>>.Success {value: parameters} => move parameters
      Result<List<Shared<Type>>, Shared<Rejection>>.Failure {error} => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move error) }
    }
  }
  let facts = match move Shared<Result<Answer, NoRejection>>.with<Option<SignatureFacts>>(&inference, signatureFacts,
  ) {
    Option<SignatureFacts>.Some {value} => move value
    _ => { return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span) }
  }
  let supplied = CallArguments.length(arguments)
  if pipeline && facts.parameters != usize.ONE {
    return run bodyRejection(&resolver.*, module, RejectionCode.CallArity, span)
  }
  if supplied > facts.parameters || (supplied == usize.ZERO && facts.parameters != usize.ZERO) {
    return run bodyRejection(&resolver.*, module, RejectionCode.CallArity, span)
  }
  if Shared<Type>.with<bool>(&actual, nativeFunctionPointer) && supplied != facts.parameters {
    return run bodyRejection(&resolver.*, module, RejectionCode.CallArity, span)
  }
  let remaining = facts.parameters - supplied
  let partial = remaining != usize.ZERO
  if !partial && facts.isUnsafe && !unsafeAllowed && !callAcknowledged { return run bodyRejection(&resolver.*, module, RejectionCode.UnsafeAcknowledgement, span) }
  if !facts.isUnsafe && callAcknowledged { return run bodyRejection(&resolver.*, module, RejectionCode.UnsafeInvocation, span) }
  let invocationMode = Shared<Type>.with<CallableMode>(&contract, callableInvocationMode)
  let mut mode = invocationMode
  if partial && invocationMode != CallableMode.Shared { mode = CallableMode.Once }
  let stored = storedExecutableField(List<BodyNode>.asSlice(&nodes.*), target)
  let exclusiveDenied = invocationMode == CallableMode.Mutable && checkedPlace(List<BodyNode>.asSlice(&nodes.*), target) &&
    !mutablePlace(List<BodyNode>.asSlice(&nodes.*), List<BodyLocal>.asSlice(&statementScope.locals.*), target)
  let takeDenied = mode == CallableMode.Once && !ownedExecutableReceiver(List<BodyNode>.asSlice(&nodes.*), target)
  if stored && (exclusiveDenied || takeDenied) {
    return run bodyRejection(&resolver.*, module, RejectionCode.StoredCallableInvocationAccess, span)
  }
  if invocationMode == CallableMode.Mutable && checkedPlace(List<BodyNode>.asSlice(&nodes.*), target,
  ) &&
    !mutablePlace(List<BodyNode>.asSlice(&nodes.*), List<BodyLocal>.asSlice(&statementScope.locals.*), target,
  ) {
    return run bodyRejection(&resolver.*, module, RejectionCode.InvalidCallableInvocationAccess, calleeSpan,
    )
  }
  if mode == CallableMode.Once {
    let consumed = match move run consumedPlace(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor,
      List<BodyNode>.asSlice(&nodes.*), target, false, false, calleeSpan, calleeSpan, constraints) {
      Result<Option<BodyConsumedPlace>, Shared<Rejection>>.Success {value} => move value
      Result<Option<BodyConsumedPlace>, Shared<Rejection>>.Failure {error} => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move error) }
    }
    let consumedTarget = BodyNodeId {index: List<BodyNode>.length(&nodes.*)}
    let consumedType = match move bodyExpressionType(List<BodyNode>.asSlice(&nodes.*), &target) {
      Option<Shared<Type>>.Some {value} => move value _ => { return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span) }
    }
    run List<BodyNode>.append(&mut nodes.*, BodyNode {origin: run originAt(cursor, callee, calleeSpan),
      kind: BodyNodeKind.Expression {ty: move consumedType, form: BodyExpression.Move {value: target, consumed: move consumed},
        },
      },
    )
    target = consumedTarget
  }
  let mut variables = List<Shared<DeclarationId>>.make()
  run List<Shared<DeclarationId>>.append(&mut variables, run Shared<DeclarationId>.make(DeclarationId.copy(&fresh)),
  )
  let mut operands = List<BodyNodeId>.make()
  let mut declaredParameters = List<Shared<Type>>.make()
  let noOrdinals = List<usize>.make()
  let outerExact = resolver.exactLocalRegions
  if let Option<Shared<SectionSchema>>.Some {..} = &schema { resolver.exactLocalRegions = true }
  let mut at = usize.ZERO
  while at < supplied {
    let parameter = match move Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(&inference,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> { return signatureParameter(answer, remaining + at) },
    ) {
      Option<Shared<Type>>.Some {value} => move value
      _ => {
        resolver.exactLocalRegions = outerExact
        return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
      }
    }
    run List<Shared<Type>>.append(&mut declaredParameters, Shared<Type>.clone(&parameter))
    let argument = run bodyArgument(&resolver.source, cursor, arguments, at)
    let typed = run checkInferredCallArgument(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
      module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*,
      argument, &parameter, &inference, List<Shared<Type>>.asSlice(&captured), &fresh,
      List<Shared<DeclarationId>>.asSlice(&variables), List<usize>.asSlice(&noOrdinals), false,
      &mut inferred,
      expression, span, constraints, contractBody, false, unsafeAllowed,
    )
    match move typed {
      Result<BodyNodeId, Shared<Rejection>>.Success {value} => { run List<BodyNodeId>.append(&mut operands, value) }
      Result<BodyNodeId, Shared<Rejection>>.Failure {error} => {
        resolver.exactLocalRegions = outerExact
        return Result<BodyNodeId, Shared<Rejection>>.failResult(move error)
      }
    }
    at = at + usize.ONE
  }
  resolver.exactLocalRegions = outerExact
  // A marked `for<use 'call>` binder names this invocation's own extent (LIFE-004). When no input
  // fixes it, the call supplies its local region; a partial application keeps it open.
  if !partial {
    let marked = Shared<Type>.with<usize>(&contract, fn(value: &Type) -> usize {
      return match &value.* { Type.Callable {invocationUse, ..} => invocationUse _ => usize.MAX }
    })
    if marked != usize.MAX && !invocationRegionBound(List<Binding>.asSlice(&inferred), &fresh, marked) {
      run List<Binding>.append(&mut inferred, Binding {declaration: run Shared<DeclarationId>.make(DeclarationId.copy(&fresh)),
        ordinal: marked, value: Argument.Lifetime {value: run Shared<Lifetime>.make(run localRegion(cursor, caller, expression, marked))}})
    }
  }
  // A section fixes its staged arguments' regions, so it can close over a quantified callable only
  // when those arguments bind every invocation region; a region left open would stay quantified.
  if partial && !Shared<Type>.with<bool>(&actual, anonymousSectionType) && !invocationBindersBound(
    List<Binding>.asSlice(&inferred), &fresh, Shared<Type>.with<usize>(&contract, fn(value: &Type) -> usize {
      return match &value.* { Type.Callable {invocationBinders, ..} => invocationBinders _ => usize.ZERO }
    })) {
    return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
  }
  // A section's deferred `?S` selector is inferred once its operands solve the provider and source.
  let freshIdentity = run Shared<DeclarationId>.make(DeclarationId.copy(&fresh))
  let selectorFailure = run inferProvidedSelectors(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, &inference,
    &freshIdentity, &fresh, constraints, &mut inferred, span)
  if let Option<Shared<Rejection>>.Some {value} = move selectorFailure { return Result<BodyNodeId, Shared<Rejection>>.failResult(move value) }
  let mut applied = List<Constraint>.make()
  at = usize.ZERO
  while at < facts.constraints {
    let bound = Shared<Result<Answer, NoRejection>>.with<Option<Constraint>>(&inference,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Constraint> { return signatureConstraintAt(answer, at) },
    )
    if let Option<Constraint>.Some {value} = move bound {
      let selected = run bindConstraint(&value, List<Binding>.asSlice(&inferred))
      if run constraintMentionsOwner(&selected, &fresh) {
        if partial && Shared<Type>.with<bool>(&actual, genericSectionType) {
          at = at + usize.ONE
          continue
        }
        return run bodyRejection(&resolver.*, module, RejectionCode.TypeArgumentInference, span)
      }
      run List<Constraint>.append(&mut applied, move selected)
    }
    at = at + usize.ONE
  }
  let declared = run copyConstraints(constraints)
  let failure = run proveAppliedBounds(&mut resolver.*, &mut owner.*, &mut dependencies.*, &declared,
    List<Constraint>.asSlice(&applied), module, span, RegionProof.RegionCheck)
  if let Option<Shared<Rejection>>.Some {value} = move failure { return Result<BodyNodeId, Shared<Rejection>>.failResult(move value) }
  let mut result = run Type.applyBindings(&facts.result, List<Binding>.asSlice(&inferred), true)
  // Invoking a generic `effect fn` section constructs the Effect its contract promises (EFF-001).
  if facts.isEffect {
    if let Option<Shared<SectionSchema>>.Some {..} = &schema {
      let constructed = run invokedEffect(&contract, Shared<Type>.clone(&result), run Type.applyBindings(&facts.failure, List<Binding>.asSlice(&inferred), true),
        run Row.applyBindings(&facts.requirements, List<Binding>.asSlice(&inferred), true))
      // The Effect also stores the operands this invocation supplies, so it retains their regions
      // as a direct `effect fn` call does (LIFE-004); a deferred borrow cannot escape through it.
      let retained = match move run invokedEffectRegions(&constructed, List<BodyNode>.asSlice(&nodes.*),
        List<BodyNodeId>.asSlice(&operands), caller, run anchoredNode(cursor, expression), constraints) {
        Option<Shared<Type>>.Some {value} => move value
        _ => { return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span) }
      }
      result = move retained
    }
  }
  if partial {
    return run finishCallableSection(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor, caller,
      &mut nodes.*, expression, span, target, mode, &contract, &inference, &fresh,
      List<Binding>.asSlice(&inferred), remaining, move operands, move result, constraints, expected, mismatchCode, contractBody,
    )
  }
  if run typeMentionsOwner(&result, &fresh) { return run bodyRejection(&resolver.*, module, RejectionCode.TypeArgumentInference, span) }
  if Shared<Type>.with<bool>(&result, rawCallableType) {
    let selected = originalCallableApplication(&actual)
    if facts.binders == usize.ZERO {
      if let Option<Shared<Application>>.Some {value} = move selected {
        let application = run Application.copyShared(&value)
        result = match move run callableResultType(&mut resolver.*, &mut owner.*, &mut dependencies.*,
          &application, constraints, span) {
          Result<Shared<Type>, Shared<Rejection>>.Success {value: returned} => move returned
          Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move error) }
        }
      } else {
        result = run deferredCallableResult(&actual, Shared<Type>.clone(&result), List<BodyNode>.asSlice(&nodes.*), List<BodyNodeId>.asSlice(&operands), &fresh, List<Binding>.asSlice(&inferred))
      }
    } else {
      result = run deferredCallableResult(&actual, Shared<Type>.clone(&result), List<BodyNode>.asSlice(&nodes.*), List<BodyNodeId>.asSlice(&operands), &fresh, List<Binding>.asSlice(&inferred))
    }
  }
  result = match move run normalizeCallableResult(&mut resolver.*, &mut owner.*, &mut dependencies.*, module,
    constraints, &result, span) {
    Result<Shared<Type>, Shared<Rejection>>.Success {value} => move value
    Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move error) }
  }
  // An `effect fn` value's invocation constructs the Effect its contract promises (EFF-001).
  let constructsEffect = Shared<Type>.with<bool>(&result, bareEffect)
  if constructsEffect {
    let exact = run invokedConstruction(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, caller, &actual,
      List<BodyNode>.asSlice(&nodes.*), List<BodyNodeId>.asSlice(&operands),
      List<Constraint>.asSlice(&declared), constraints, run anchoredNode(cursor, expression), span)
    match move exact {
      Result<Option<Shared<Type>>, Shared<Rejection>>.Success {value} => {
        if let Option<Shared<Type>>.Some {value: constructed} = move value { result = move constructed }
      }
      Result<Option<Shared<Type>>, Shared<Rejection>>.Failure {error} => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move error) }
    }
  }
  let kept = run callableKept(&mut resolver.*, &mut owner.*, &mut dependencies.*, &inference,
    List<Shared<Type>>.asSlice(&declaredParameters), List<Binding>.asSlice(&inferred), &contract, caller, span)
  return run finishExpression(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor, caller, constraints, &mut nodes.*,
    expression, span, move result,
    BodyExpression.CallableCall {callee: target, mode: mode, arguments: move operands,
      inference: run Shared<DeclarationId>.make(move fresh), bindings: run Shared<List<Binding>>.make(move inferred), pipeline: pipeline,
      constructs: constructsEffect, kept: move kept,
    },
    false, expected, mismatchCode, contractBody, false,
  )
}

// Invoking an `effect fn` value with every remaining operand constructs the exact Effect of
// calling its named target directly (EFF-001): the value's stored arguments keep their parameter
// ordinals and the supplied operands fill the others in order, with the target's channels and
// the run access and regions those stored arguments decide, as a written construction's. A
// generic section selects its target application from the operands exactly as lowering selects
// the one a run calls. An anonymous target stores the invoked value as its environment input, as
// staging it does: by value when the invocation consumes it, else as the invocation's loan.
// Absent for an abstract representation or a section whose application its operands do not yet
// select: only an immediate `run` executes those.
effect fn invokedConstruction(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, module: &ModuleId, caller: &DeclarationId, callee: &Shared<Type>,
  nodes: &[BodyNode], operands: &[BodyNodeId], premises: &[Constraint], constraints: &[Constraint],
  site: usize, span: Span) -> Result<Option<Shared<Type>>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut isPublic = false
  let mut application = Option<Shared<Application>>.none()
  let mut stored = List<Shared<Type>>.make()
  let mut inputs = List<CallableFieldInput>.make()
  let mut promised = Option<EffectChannels>.none()
  match move run Type.copy(callee) {
    Type.CallableValue {isPublic: visible, application: selected, contract: used, captures, fieldInputs, ..} => {
      let invoked = Shared<Type>.with<Option<Shared<Type>>>(&used, callableResult)
      if let Option<Shared<Type>>.Some {value: result} = move invoked {
        promised = Shared<Type>.with<Option<EffectChannels>>(&result, effectChannels)
      }
      let kind = Shared<Application>.with<OwnerKind>(&selected, fn(value: &Application) -> OwnerKind {
        return DeclarationId.kind(Application.bodyDeclaration(value))
      })
      isPublic = visible
      stored = move captures
      inputs = move fieldInputs
      let literal = kind == OwnerKind.Anonymous || kind == OwnerKind.EffectBlock
      if literal && List<CallableFieldInput>.length(&inputs) == usize.ZERO {
        // The invocation consumes a once callee, so the Effect owns it; otherwise the Effect holds
        // the invocation's loan of it, whose access its own run access follows (EFFECT-OWN-002).
        let invocation = Shared<Type>.with<CallableMode>(&used, callableInvocationMode)
        let mut environment = Shared<Type>.clone(callee)
        if invocation != CallableMode.Once {
          let mut access = Access.Shared
          if invocation == CallableMode.Mutable { access = Access.Mutable }
          environment = run Types.intern(Type.Reference {referent: Shared<Type>.clone(callee), access: access,
            lifetime: run Shared<Lifetime>.make(Lifetime.Local {declaration: DeclarationId.copy(caller), ordinal: site, binder: usize.MAX})})
        }
        // The literal's captures are its own environment's fields, which the stored value holds.
        stored = List<Shared<Type>>.make()
        run List<Shared<Type>>.append(&mut stored, move environment)
        run List<CallableFieldInput>.append(&mut inputs, CallableFieldInput.Environment)
      }
      application = Option<Shared<Application>>.some(move selected)
    }
    Type.CallableSchema {schema, captures, fieldInputs, ..} => {
      let mut supplied = List<Shared<Type>>.make()
      let mut at = usize.ZERO
      while at < operands.length {
        match move bodyExpressionType(nodes, &operands[at]) {
          Option<Shared<Type>>.Some {value} => { run List<Shared<Type>>.append(&mut supplied, move value) }
          Option<Shared<Type>>.None => { return Result<Option<Shared<Type>>, Shared<Rejection>>.succeed(Option<Shared<Type>>.none()) }
        }
        at = at + usize.ONE
      }
      let identity = List<Binding>.make()
      let selected = run schemaCallableApplication(&mut resolver.*, &mut owner.*, &mut dependencies.*, module,
        List<Binding>.asSlice(&identity), premises, &schema, List<CallableFieldInput>.asSlice(&fieldInputs),
        List<Shared<Type>>.asSlice(&supplied), span)
      let chosen = match move selected {
        Result<Application, PreparationFailure>.Success {value} => move value
        Result<Application, PreparationFailure>.Failure {..} => { return Result<Option<Shared<Type>>, Shared<Rejection>>.succeed(Option<Shared<Type>>.none()) }
      }
      let target = DeclarationId.copy(Application.bodyDeclaration(&chosen))
      if DeclarationId.kind(&target) == OwnerKind.Anonymous {
        return Result<Option<Shared<Type>>, Shared<Rejection>>.succeed(Option<Shared<Type>>.none())
      }
      isPublic = run publicFunction(&mut resolver.*, &target)
      application = Option<Shared<Application>>.some(run Shared<Application>.make(move chosen))
      stored = move captures
      inputs = move fieldInputs
    }
    _ => { return Result<Option<Shared<Type>>, Shared<Rejection>>.succeed(Option<Shared<Type>>.none()) }
  }
  let target = match move application {
    Option<Shared<Application>>.Some {value} => move value
    Option<Shared<Application>>.None => { return Result<Option<Shared<Type>>, Shared<Rejection>>.succeed(Option<Shared<Type>>.none()) }
  }
  // An anonymous target has no declaration signature; its value's contract promises the channels.
  let anonymous = Shared<Application>.with<bool>(&target, fn(value: &Application) -> bool {
    let kind = DeclarationId.kind(Application.bodyDeclaration(value))
    return kind == OwnerKind.Anonymous || kind == OwnerKind.EffectBlock
  })
  let mut resolved = Option<EffectChannels>.none()
  if anonymous { resolved = move promised } else { resolved = run applicationChannels(&mut resolver.*, &mut owner.*, &mut dependencies.*, &target) }
  let channels = match move resolved {
    Option<EffectChannels>.Some {value} => move value
    Option<EffectChannels>.None => { return Result<Option<Shared<Type>>, Shared<Rejection>>.succeed(Option<Shared<Type>>.none()) }
  }
  let fields = List<Shared<Type>>.asSlice(&stored)
  let slots = List<CallableFieldInput>.asSlice(&inputs)
  let mut arguments = List<StoredArgument>.make()
  // An original anonymous environment comes first, as the invocation passes it.
  let mut environment = usize.ZERO
  while environment < slots.length {
    let original = match slots[environment] { CallableFieldInput.Environment => true _ => false }
    if original {
      // A stored loan is held, not moved: an exclusive one makes the Effect's run exclusive.
      let held = Shared<Type>.with<bool>(&fields[environment], fn(value: &Type) -> bool {
        return match &value.* { Type.Reference {..} => true _ => false }
      })
      run List<StoredArgument>.append(&mut arguments, StoredArgument {ty: Shared<Type>.clone(&fields[environment]), moved: !held,
        input: CallableFieldInput.Environment})
    }
    environment = environment + usize.ONE
  }
  let mut hidden = usize.ZERO
  if List<StoredArgument>.length(&arguments) != usize.ZERO { hidden = usize.ONE }
  let count = operands.length + slots.length - hidden
  let mut parameter = usize.ZERO
  let mut operand = usize.ZERO
  while parameter < count {
    let mut slot = usize.ZERO
    while slot < slots.length && !callableInputParameter(&slots[slot], parameter) { slot = slot + usize.ONE }
    if slot < slots.length {
      run List<StoredArgument>.append(&mut arguments, StoredArgument {ty: Shared<Type>.clone(&fields[slot]), moved: false,
        input: CallableFieldInput.Argument {parameter: parameter}})
    } else {
      if operand == operands.length { return Result<Option<Shared<Type>>, Shared<Rejection>>.succeed(Option<Shared<Type>>.none()) }
      match move bodyExpressionType(nodes, &operands[operand]) {
        Option<Shared<Type>>.Some {value} => {
          run List<StoredArgument>.append(&mut arguments, StoredArgument {ty: move value, moved: movedBodyValue(nodes, operands[operand]),
            input: CallableFieldInput.Argument {parameter: parameter}})
        }
        Option<Shared<Type>>.None => { return Result<Option<Shared<Type>>, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Unsupported, span)) }
      }
      operand = operand + usize.ONE
    }
    parameter = parameter + usize.ONE
  }
  let built = match move run storedEffect(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, caller,
    List<StoredArgument>.asSlice(&arguments), move channels.success, move channels.failure, move channels.requirements,
    constraints, site, span) {
    Result<EffectConstruction, Shared<Rejection>>.Success {value} => move value
    Result<EffectConstruction, Shared<Rejection>>.Failure {error} => { return Result<Option<Shared<Type>>, Shared<Rejection>>.failResult(move error) }
  }
  let EffectConstruction {contract, captures, fieldInputs} = move built
  return Result<Option<Shared<Type>>, Shared<Rejection>>.succeed(Option<Shared<Type>>.some(
    run Type.callableValue(isPublic, move target, move contract, move captures, move fieldInputs)))
}

// The channels of one closed target application, resolved exactly as a direct call of it
// resolves its signature, so an invoked construction and a written one have equal contracts.
effect fn applicationChannels(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, application: &Shared<Application>) -> Option<EffectChannels>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let selected = run Application.copyShared(application)
  let declared = DeclarationId.copy(Application.bodyDeclaration(&selected))
  let moduleAt = knownModuleOrdinal(&resolver.*, DeclarationId.moduleId(&declared))
  if moduleAt == usize.MAX { fail InvalidModulePath {} }
  let targetModule = resolvedModule(&resolver.*, moduleAt)
  let identity = run Shared<DeclarationId>.make(move declared)
  let ordinal = match move run ordinalOfIdentity(&mut resolver.*, &targetModule, &identity) {
    Option<usize>.Some {value} => value
    Option<usize>.None => { return Option<EffectChannels>.none() }
  }
  let closed = Option<Application>.some(move selected)
  let declarationAccess129Request = Key {family: Family.Signature,
    module: moduleAt, name: usize.ZERO, declaration: ordinal, member: usize.ZERO, external: false}
  let declarationAccess129 = run internDeclaration(&mut resolver.*, declarationAccess129Request)
  let mut applied = run resolveSignatureUnder(&mut resolver.*, &mut owner.*, declarationAccess129,
    List<Dependency>.make(), Option<List<Argument>>.none(), Option<List<Argument>>.none(), &closed)
  while List<Dependency>.length(&applied.dependencies) > usize.ZERO {
    let edge = List<Dependency>.remove(&mut applied.dependencies, usize.ZERO)
    run List<Dependency>.append(&mut dependencies.*, move edge)
  }
  return match & applied.outcome {
    Outcome.Success {value: Value.Signature {signature}} => Option<EffectChannels>.some(EffectChannels {
      success: Shared<Type>.clone(&signature.result), failure: Shared<Type>.clone(&signature.failure),
      requirements: Shared<Row>.clone(&signature.requirements)})
    _ => Option<EffectChannels>.none()
  }
}

// Whether a function declaration is public; visibility never changes a type's identity.
effect fn publicFunction(resolver: &mut Resolver, identity: &DeclarationId) -> bool
! Cycle | InvalidModulePath | OutOfMemoryError ? &mut Allocator {
  let moduleAt = knownModuleOrdinal(&resolver.*, DeclarationId.moduleId(identity))
  if moduleAt == usize.MAX { fail InvalidModulePath {} }
  let declaredModule = resolvedModule(&resolver.*, moduleAt)
  let shared = run Shared<DeclarationId>.make(DeclarationId.copy(identity))
  let ordinal = match move run ordinalOfIdentity(&mut resolver.*, &declaredModule, &shared) {
    Option<usize>.Some {value} => value
    Option<usize>.None => { return false }
  }
  let declared = run observedHeader(&mut resolver.*, &declaredModule, ordinal, SourceFacet.Identity)
  if let Option<HeaderSyntax>.Some {value: written} = move declared {
    if let Node.FunctionHeader {isPublic, ..} = written.header { return isPublic }
  }
  return false
}

// The contract's promised run access and retained regions, with this invocation's channels.
// Invocation operands add no region: an operand Effect whose caller-local environment the fixed
// binder does not name is admitted only under relations to the binder's regions that the body's
// region check proves (`relatedEffectEnvironment`), so the promised environment bounds it, and a borrowed remaining
// parameter or an unfixed environment binder is still a deferral. Lifting that deferral must add
// the operands' retained regions here (LIFE-004).
// `constructed`, an Effect an invocation constructs, with every region its supplied operands
// retain joined into its environment; none when an operand's contents cannot be captured.
effect fn invokedEffectRegions(constructed: &Shared<Type>, nodes: &[BodyNode], operands: &[BodyNodeId], caller: &DeclarationId,
  site: usize, constraints: &[Constraint]) -> Option<Shared<Type>> ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let copied = run Type.copy(constructed)
  if let Type.Effect {mode, environment, success, failure, requirements} = move copied {
    let mut regions = run callableEnvironmentRegions(&environment)
    let mut at = usize.ZERO
    while at < operands.length {
      if let Option<Shared<Type>>.Some {value: ty} = move bodyExpressionType(nodes, &operands[at]) {
        if !run captureRetainedRegions(&ty, caller, site, constraints, &mut regions) { return Option<Shared<Type>>.none() }
      }
      at = at + usize.ONE
    }
    return Option<Shared<Type>>.some(run Types.intern(Type.Effect {mode: mode,
      environment: run Shared<Intersection>.make(run Intersection.of(List<Shared<Lifetime>>.asSlice(&regions))),
      success: move success, failure: move failure, requirements: move requirements}))
  }
  return Option<Shared<Type>>.some(Shared<Type>.clone(constructed))
}

effect fn invokedEffect(contract: &Shared<Type>, success: Shared<Type>, failure: Shared<Type>, requirements: Shared<Row>) -> Shared<Type>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let promised = match move run Type.copy(contract) {
    Type.Callable {result, ..} => move result
    _ => { return absurd<Shared<Type>>() }
  }
  return match move run Type.copy(&promised) {
    Type.Effect {mode, environment, ..} => run Types.intern(Type.Effect {mode: mode, environment: move environment,
      success: move success, failure: move failure, requirements: move requirements})
    _ => absurd<Shared<Type>>()
  }
}

// Preserve checked type evidence only. Argument ownership remains at the original invocation.
effect fn deferredCallableResult(producer: &Shared<Type>, contract: Shared<Type>, nodes: &[BodyNode],
  operands: &[BodyNodeId], inference: &DeclarationId, bindings: &[Binding]) -> Shared<Type> ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut arguments = List<Shared<Type>>.make()
  let mut at = usize.ZERO
  while at < operands.length {
    let ty = match move bodyExpressionType(nodes, &operands[at]) {
      Option<Shared<Type>>.Some {value} => move value _ => absurd<Shared<Type>>()
    }
    run List<Shared<Type>>.append(&mut arguments, move ty)
    at = at + usize.ONE
  }
  let mut selected = List<Argument>.make()
  let mut selectedOrdinals = List<usize>.make()
  at = usize.ZERO
  while at < bindings.length {
    if Shared<DeclarationId>.with<bool>(&bindings[at].declaration, fn(value: &DeclarationId) -> bool { return DeclarationId.equals(value, inference) }) {
      run List<Argument>.append(&mut selected, Argument.copy(&bindings[at].value))
      run List<usize>.append(&mut selectedOrdinals, bindings[at].ordinal)
    }
    at = at + usize.ONE
  }
  return run Types.intern(Type.CallableResult {producer: Shared<Type>.clone(producer), contract: move contract,
    arguments: move arguments, selected: move selected, selectedOrdinals: move selectedOrdinals})
}

fn originalCallableApplication(value: &Shared<Type>) -> Option<Shared<Application>> {
  let nested = Shared<Type>.with<Option<Shared<Type>>>(value, fn(ty: &Type) -> Option<Shared<Type>> {
    return match &ty.* {
      Type.CallableView {representation, ..} => Option<Shared<Type>>.some(Shared<Type>.clone(&representation))
      _ => Option<Shared<Type>>.none()
    }
  })
  if let Option<Shared<Type>>.Some {value: storage} = move nested { return originalCallableApplication(&storage) }
  return Shared<Type>.with<Option<Shared<Application>>>(value, fn(ty: &Type) -> Option<Shared<Application>> {
    return match &ty.* {
      Type.CallableValue {application, ..} => Option<Shared<Application>>.some(Shared<Application>.clone(&application))
      _ => Option<Shared<Application>>.none()
    }
  })
}

fn movedBodyValue(nodes: &[BodyNode], node: BodyNodeId) -> bool {
  return match &nodes[node.index].kind {
    BodyNodeKind.Expression {form: BodyExpression.Move {..}, ..} => true
    _ => false
  }
}

// The operands a node takes by value: call arguments (a method receiver has its own pass), fields
// of a constructed value, a match arm's value, a returned or failed value, a binding's initializer
// and an assigned value. Borrows, projections and match subjects have their own access rules (OWN-002).
effect fn byValueOperands(nodes: &[BodyNode], at: usize, operands: &mut List<BodyNodeId>) -> ()
! OutOfMemoryError ? &mut Allocator {
  match &nodes[at].kind {
    BodyNodeKind.Expression {form, ..} => {
      match &form {
        BodyExpression.DirectCall {arguments, receiverPass, ..} => {
          run appendByValueArguments(List<BodyNodeId>.asSlice(&arguments), passesReceiver(&receiverPass), &mut operands.*)
        }
        BodyExpression.InterfaceCall {arguments, receiverPass, ..} => {
          run appendByValueArguments(List<BodyNodeId>.asSlice(&arguments), passesReceiver(&receiverPass), &mut operands.*)
        }
        BodyExpression.ForeignCall {arguments, ..} => {
          run appendByValueArguments(List<BodyNodeId>.asSlice(&arguments), false, &mut operands.*)
        }
        BodyExpression.CallableCall {arguments, ..} => {
          run appendByValueArguments(List<BodyNodeId>.asSlice(&arguments), false, &mut operands.*)
        }
        // A staged argument is captured by value, so staging an affine place, an exclusive view
        // included, says `move` or `&mut` (CALLABLE-002).
        BodyExpression.StagedCallable {arguments, ..} => {
          run appendByValueArguments(List<BodyNodeId>.asSlice(&arguments), false, &mut operands.*)
        }
        BodyExpression.Aggregate {fields, ..} => { run appendByValueFields(List<BodyAggregateField>.asSlice(&fields), &mut operands.*) }
        BodyExpression.ArrayRepeat {value, ..} => { run List<BodyNodeId>.append(&mut operands.*, value) }
        BodyExpression.VariantConstruct {fields, ..} => {
          run appendByValueFields(List<BodyAggregateField>.asSlice(&fields), &mut operands.*)
        }
        BodyExpression.UnionInject {value, ..} => { run List<BodyNodeId>.append(&mut operands.*, value) }
        // An expression match yields its selected arm's value.
        BodyExpression.Match {arms, ..} => {
          let listed = List<BodyMatchArm>.asSlice(&arms)
          let mut arm = usize.ZERO
          while arm < listed.length {
            run List<BodyNodeId>.append(&mut operands.*, listed[arm].result)
            arm = arm + usize.ONE
          }
        }
        _ => {}
      }
    }
    BodyNodeKind.Return {value} => {
      if let Option<BodyNodeId>.Some {value: returned} = &value { run List<BodyNodeId>.append(&mut operands.*, returned) }
    }
    BodyNodeKind.Fail {value} => { run List<BodyNodeId>.append(&mut operands.*, value) }
    BodyNodeKind.LocalBinding {initializer, ..} => { run List<BodyNodeId>.append(&mut operands.*, initializer) }
    BodyNodeKind.MutableBinding {initializer, ..} => { run List<BodyNodeId>.append(&mut operands.*, initializer) }
    BodyNodeKind.Assignment {value, ..} => { run List<BodyNodeId>.append(&mut operands.*, value) }
    BodyNodeKind.PlaceAssignment {value, ..} => { run List<BodyNodeId>.append(&mut operands.*, value) }
    _ => {}
  }
  return ()
}

fn passesReceiver(pass: &Option<BodyReceiverPass>) -> bool {
  return match &pass.* {
    Option<BodyReceiverPass>.Some {..} => true
    Option<BodyReceiverPass>.None => false
  }
}

effect fn appendByValueArguments(arguments: &[BodyNodeId], receiver: bool, operands: &mut List<BodyNodeId>) -> ()
! OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  if receiver { at = usize.ONE }
  while at < arguments.length {
    run List<BodyNodeId>.append(&mut operands.*, arguments[at])
    at = at + usize.ONE
  }
  return ()
}

effect fn appendByValueFields(fields: &[BodyAggregateField], operands: &mut List<BodyNodeId>) -> ()
! OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < fields.length {
    run List<BodyNodeId>.append(&mut operands.*, fields[at].value)
    at = at + usize.ONE
  }
  return ()
}

// This body's and its named enclosing declarations' parameters are rigid under bodyPremises.
// Their identity authenticates the domain, not a relation: every pair still needs a premise.
// Invocation, unrelated-owner and local atoms remain for the point/environment proof.
fn declaredBodyRegion(region: &Shared<Lifetime>, caller: &DeclarationId) -> bool {
  return Lifetime.allAtoms(region, fn(value: &Lifetime) -> bool {
    return match &value.* {
      Lifetime.Static => true
      Lifetime.Parameter {declaration, ..} => DeclarationId.equals(&declaration, caller)
        || (!anonymousOwner(&declaration) && DeclarationId.isPrefixOf(&declaration, caller))
      _ => false
    }
  })
}

/// The codes a body that is not borrow-checked may be missing: those the region check reports for
/// loans and for region relations. Its typing and moves are checked whatever the status, so their
/// codes are never missing.
pub effect fn uncheckedBodyCodes() -> List<RejectionCode> ! OutOfMemoryError ? &mut Allocator {
  let mut codes = run livenessCodes()
  run List<RejectionCode>.append(&mut codes, RejectionCode.UnsatisfiedLifetimeBound)
  return move codes
}

// An affine place taken by value must say `move`: the first such operand in node order is
// `ExplicitMoveRequired` at that operand (OWN-002, the bootstrap's `OWN0003`). An exclusive
// reference or slice is affine too, so forwarding one is written `&mut values` (BORROW-005).
// An operand rooted at a borrowing match binding cannot leave its arm even with `move`, so that
// escape is reported first, as `MatchBorrowEscape` (the bootstrap's `OWN0006`). An affine field or
// element of a value that is no place cannot be taken at all: the rest of that value has no owner
// to leave its hole in (OWN-004), so it is `ExtractionBoundary` (the bootstrap's `OWN0002`), or
// `BorrowedExtraction` when the projection reads through a borrow.
effect fn implicitAffineUse(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, module: &ModuleId, cursor: &AuthoredCursor, nodes: &[BodyNode],
  constraints: &[Constraint], anchor: &Anchor) -> Option<Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut operands = List<BodyNodeId>.make()
  let mut at = usize.ZERO
  while at < nodes.length {
    run byValueOperands(nodes, at, &mut operands)
    at = at + usize.ONE
  }
  let listed = List<BodyNodeId>.asSlice(&operands)
  at = usize.ZERO
  while at < listed.length {
    let operand = listed[at]
    let projected = valueProjection(nodes, operand)
    if (projected || checkedPlace(nodes, operand)) && !movedBodyValue(nodes, operand) {
      if let BodyNodeKind.Expression {ty, ..} = &nodes[operand.index].kind {
        let span = BodyOrigin.span(nodes[operand.index].origin, anchor)
        let copied = match move run copyType(&mut resolver.*, &mut owner.*, &mut dependencies.*, &ty, constraints, span) {
          Result<bool, Shared<Rejection>>.Success {value} => value
          Result<bool, Shared<Rejection>>.Failure {error} => { return Option<Shared<Rejection>>.some(move error) }
        }
        if !copied {
          let mut code = RejectionCode.ExplicitMoveRequired
          match move run consumption(&resolver.source, cursor, nodes, operand) {
            Consumption.Escape {..} => { code = RejectionCode.MatchBorrowEscape }
            Consumption.Boundary => { if projected { code = RejectionCode.ExtractionBoundary } }
            Consumption.Borrowed => { if projected { code = RejectionCode.BorrowedExtraction } }
            _ => {}
          }
          if code == RejectionCode.ExplicitMoveRequired {
            return Option<Shared<Rejection>>.some(run explicitMoveRejection(module, span, &ty))
          }
          return Option<Shared<Rejection>>.some(run reject(&resolver.*, module, code, span))
        }
      }
    }
    at = at + usize.ONE
  }
  return Option<Shared<Rejection>>.none()
}

// Staging carries the original target and capture order forward. It is an aggregate
// construction, so unsafe acknowledgement belongs to its eventual invocation.
// Retention for a callable contract, shared by invocation and suffix staging. The environment
// remains a possible destination, as do required services and opaque conformances.
effect fn callableKept(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, dependencies: &mut List<Dependency>,
  signature: &Shared<Result<Answer, NoRejection>>, parameterTypes: &[Shared<Type>], bindings: &[Binding],
  contract: &Shared<Type>, caller: &DeclarationId, span: Span) -> Shared<List<KeptRegions>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  // A callable value's parameters are read like a declared parameter list. Its environment, which
  // its use contract bounds, can also keep an argument whose instantiated parameter type names a
  // lifetime parameter, `'static` or a type parameter, which outlive the call: so such an argument
  // is kept in the environment's regions too. `'static` holds no body loan. A contract parameter
  // naming a type parameter can store through a conformance its contract does not carry, into
  // storage of any such parameter's instantiation.
  let mut generic = false
  let mut opaque = false
  let mut at = usize.ZERO
  while at < parameterTypes.length {
    if run Type.namesTypeParameter(&parameterTypes[at]) { generic = true }
    let applied = run Type.applyBindings(&parameterTypes[at], bindings, true)
    if run Type.namesTypeParameter(&applied) { opaque = true }
    at = at + usize.ONE
  }
  let noOwn = List<Shared<Lifetime>>.make()
  let binders = run signatureLifetimeList(signature)
  let covariant = run covariantSlots(&mut resolver.*, &mut owner.*, &mut dependencies.*, parameterTypes, span)
  // The callee is checked under its contract's bounds and what its types imply, and its environment
  // keeps whatever a slot of an argument outlives it by those bounds.
  let premises = run calleeKeptBounds(&mut resolver.*, &mut owner.*, &mut dependencies.*, signature, parameterTypes, span)
  let mut places = List<List<KeptPlace>>.make()
  at = usize.ZERO
  while at < parameterTypes.length {
    run List<List<KeptPlace>>.append(&mut places, run keptPlaces(&mut resolver.*, &mut owner.*, &mut dependencies.*, &parameterTypes[at], span))
    at = at + usize.ONE
  }
  let mut held = List<Shared<Lifetime>>.make()
  run Type.environmentRegions(contract, &mut held, false)
  let parameterKept = run Type.keptRegions(parameterTypes, List<KeptBound>.asSlice(&premises), bindings,
    false, List<Shared<Lifetime>>.asSlice(&noOwn), List<CovariantSlot>.asSlice(&covariant), List<List<KeptPlace>>.asSlice(&places),
    List<Shared<Lifetime>>.asSlice(&held))
  // Any argument can reach storage of a type parameter's instantiation through a conformance.
  let mut conformed = List<Shared<Lifetime>>.make()
  if generic { run Type.storingInstantiations(parameterTypes, bindings, &mut conformed, List<CovariantSlot>.asSlice(&covariant)) }
  let mut kept = List<KeptRegions>.make()
  let recorded = List<KeptRegions>.asSlice(&parameterKept)
  at = usize.ZERO
  while at < recorded.length {
    let mut outer = run copyRegions(List<Shared<Lifetime>>.asSlice(&recorded[at].outer))
    let mut whole = run copyRegions(List<Shared<Lifetime>>.asSlice(&recorded[at].whole))
    let mut outerApproximate = run copyRegions(List<Shared<Lifetime>>.asSlice(&recorded[at].outerApproximate))
    let mut wholeApproximate = run copyRegions(List<Shared<Lifetime>>.asSlice(&recorded[at].wholeApproximate))
    let mut heldType = false
    let mut lasting = false
    let mut carriesHeld = false
    if at < parameterTypes.length {
      let applied = run Type.applyBindings(&parameterTypes[at], bindings, true)
      heldType = run Type.namesHeldAtom(&applied)
      lasting = run Type.outerLasting(&parameterTypes[at], caller, List<Shared<Lifetime>>.asSlice(&binders))
      // A type parameter of the caller holds no loan of its body, so what the argument carries can
      // be kept there only through a region its type names that outlives the invocation.
      carriesHeld = run Type.namesLastingRegion(&applied, caller, List<Shared<Lifetime>>.asSlice(&binders))
    }
    // The argument's own borrow is kept beyond the invocation only when its parameter names a region
    // outliving it; what the argument carries, wherever its type can be stored. A conformance's reach
    // into a type parameter's instantiation is approximate.
    let instantiated = List<Shared<Lifetime>>.asSlice(&conformed)
    let mut extra = usize.ZERO
    while extra < instantiated.length {
      if lasting { run List<Shared<Lifetime>>.append(&mut outerApproximate, Shared<Lifetime>.clone(&instantiated[extra])) }
      run List<Shared<Lifetime>>.append(&mut wholeApproximate, Shared<Lifetime>.clone(&instantiated[extra]))
      extra = extra + usize.ONE
    }
    if heldType {
      let regions = List<Shared<Lifetime>>.asSlice(&held)
      let mut each = usize.ZERO
      while each < regions.length {
        if lasting {
          run List<Shared<Lifetime>>.append(&mut outer, Shared<Lifetime>.clone(&regions[each]))
          run List<Shared<Lifetime>>.append(&mut outerApproximate, Shared<Lifetime>.clone(&regions[each]))
        }
        if carriesHeld {
          run List<Shared<Lifetime>>.append(&mut whole, Shared<Lifetime>.clone(&regions[each]))
          run List<Shared<Lifetime>>.append(&mut wholeApproximate, Shared<Lifetime>.clone(&regions[each]))
        }
        each = each + usize.ONE
      }
    }
    // A conformance can reach a loan wherever it lies in the argument, so every slot keeps it
    // approximately; the environment reaches a slot only as `keptRegions` relates it.
    let mut slots = run copyKeptSlots(List<KeptSlot>.asSlice(&recorded[at].slots))
    let mut each = usize.ZERO
    let widened = List<KeptSlot>.asMutSlice(&mut slots)
    while each < widened.length {
      extra = usize.ZERO
      while extra < instantiated.length {
        run List<Shared<Lifetime>>.append(&mut widened[each].keptApproximate, Shared<Lifetime>.clone(&instantiated[extra]))
        extra = extra + usize.ONE
      }
      each = each + usize.ONE
    }
    run List<KeptRegions>.append(&mut kept, KeptRegions {outer: move outer, whole: move whole,
      outerApproximate: move outerApproximate, wholeApproximate: move wholeApproximate, undescribed: false, slots: move slots})
    at = at + usize.ONE
  }
  // Where an instantiation is still a type parameter of the caller, whatever it reaches is unknown
  // here: an argument whose parameter names a region outliving the invocation (see
  // `Type.namesLastingRegion`) is undescribed.
  if opaque {
    let mut entries = List<KeptRegions>.asMutSlice(&mut kept)
    at = usize.ZERO
    while at < entries.length && at < parameterTypes.length {
      if run Type.namesLastingRegion(&parameterTypes[at], caller, List<Shared<Lifetime>>.asSlice(&binders)) { entries[at].undescribed = true }
      at = at + usize.ONE
    }
  }
  return run Shared<List<KeptRegions>>.make(move kept)
}

// A section's deferred runtime recipe is not evidence that its capture contract is closed.
// Check the exact inference-owned binder handles, including rows, under the actual bindings.
// Unresolved sections retain the existing conservative capture policy.
effect fn sectionBindingsClosed(signature: &Shared<Result<Answer, NoRejection>>, bindings: &[Binding], fresh: &DeclarationId) -> bool
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let count = Shared<Result<Answer, NoRejection>>.with<usize>(signature, signatureBinderCount)
  let mut at = usize.ZERO
  while at < count {
    let binder = Shared<Result<Answer, NoRejection>>.with<Option<InferenceBinder>>(signature,
      fn(answer: &Result<Answer, NoRejection>) -> Option<InferenceBinder> { return inferenceBinderAt(answer, at) })
    let mut selected = Option<Argument>.none()
    match move binder {
      Option<InferenceBinder>.Some {value: InferenceBinder.Type {value}} => {
        selected = Option<Argument>.some(Argument.Type {value: move value})
      }
      Option<InferenceBinder>.Some {value: InferenceBinder.Lifetime {value}} => {
        selected = Option<Argument>.some(Argument.Lifetime {value: move value})
      }
      Option<InferenceBinder>.Some {value: InferenceBinder.Row {value}} => {
        let mut row = Row.empty()
        run Row.include(&mut row, move value)
        selected = Option<Argument>.some(Argument.Row {value: run Shared<Row>.make(move row)})
      }
      _ => { return false }
    }
    let original = match move selected {
      Option<Argument>.Some {value} => move value
      _ => { return false }
    }
    if !run argumentMentionsOwner(&original, fresh) { return false }
    let applied = run Argument.applyBindings(&original, bindings, true)
    if run argumentMentionsOwner(&applied, fresh) { return false }
    at = at + usize.ONE
  }
  return true
}

effect fn finishCallableSection(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, module: &ModuleId, cursor: &AuthoredCursor, caller: &DeclarationId,
  nodes: &mut List<BodyNode>, expression: HirId, span: Span, callee: BodyNodeId,
  transport: CallableMode, visible: &Shared<Type>, signature: &Shared<Result<Answer, NoRejection>>,
  fresh: &DeclarationId, bindings: &[Binding], remaining: usize, arguments: List<BodyNodeId>,
  result: Shared<Type>, constraints: &[Constraint], expected: &Option<Shared<Type>>, mismatchCode: RejectionCode, contractBody: bool)
  -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let baseType = match move bodyExpressionType(List<BodyNode>.asSlice(&nodes.*), &callee) {
    Option<Shared<Type>>.Some {value} => move value
    _ => { return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span) }
  }
  let invocationBinders = Shared<Type>.with<usize>(visible, fn(value: &Type) -> usize {
    return match &value.* { Type.Callable {invocationBinders, ..} => invocationBinders _ => usize.ZERO }
  })
  let originalMode = Shared<Type>.with<CallableMode>(visible, callableInvocationMode)
  let isUnsafe = Shared<Result<Answer, NoRejection>>.with<bool>(signature, signatureUnsafe)
  // Anonymous schemas map invocation lifetimes back to their declaration slots. Named
  // quantified sections and row staging retain their separate source-recipe boundary.
  let schema = Shared<Type>.with<Option<Shared<SectionSchema>>>(&baseType, sectionSchemaOf)
  let generic = match &schema { Option<Shared<SectionSchema>>.Some {..} => true _ => false }
  if (!invocationBindersBound(bindings, fresh, invocationBinders) && !Shared<Type>.with<bool>(&baseType, anonymousSectionType))
    || (!generic && run typeMentionsOwner(&result, fresh)) {
    return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
  }
  let mut suffixMode = CallableMode.Shared
  let mut captures = List<Shared<Type>>.make()
  let mut regions = List<Shared<Lifetime>>.make()
  if !run captureRetainedRegions(&baseType, caller, run anchoredNode(cursor, expression), constraints, &mut regions) {
    return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
  }
  let supplied = List<BodyNodeId>.asSlice(&arguments)
  let mut at = usize.ZERO
  while at < supplied.length {
    let ty = match move bodyExpressionType(List<BodyNode>.asSlice(&nodes.*), &supplied[at]) {
      Option<Shared<Type>>.Some {value} => move value
      _ => { return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span) }
    }
    let mutableReference = Shared<Type>.with<bool>(&ty, fn(value: &Type) -> bool {
      return match &value.* { Type.Reference {access, ..} => access == Access.Mutable
        Type.Slice {access, ..} => access == Access.Mutable _ => false }
    })
    if mutableReference && !movedBodyValue(List<BodyNode>.asSlice(&nodes.*), supplied[at]) {
      if suffixMode == CallableMode.Shared { suffixMode = CallableMode.Mutable }
    } else {
      let copied = run copyType(&mut resolver.*, &mut owner.*, &mut dependencies.*, &ty, constraints, span)
      match move copied {
        Result<bool, Shared<Rejection>>.Success {value} => { if !value { suffixMode = CallableMode.Once } }
        Result<bool, Shared<Rejection>>.Failure {error} => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move error) }
      }
    }
    if !run captureRetainedRegions(&ty, caller, run anchoredNode(cursor, expression), constraints, &mut regions) {
      return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
    }
    run List<Shared<Type>>.append(&mut captures, move ty)
    at = at + usize.ONE
  }
  let mut parameters = List<Shared<Type>>.make()
  at = usize.ZERO
  while at < remaining {
    let raw = match move Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(signature,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> { return signatureParameter(answer, at) }) {
      Option<Shared<Type>>.Some {value} => move value
      _ => { return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span) }
    }
    run List<Shared<Type>>.append(&mut parameters, run Type.applyBindings(&raw, bindings, true))
    at = at + usize.ONE
  }
  let mut mode = originalMode
  if suffixMode == CallableMode.Once { mode = CallableMode.Once }
  if suffixMode == CallableMode.Mutable && mode == CallableMode.Shared { mode = CallableMode.Mutable }
  let contract = run Types.intern(Type.Callable {mode: mode, isUnsafe: isUnsafe,
    environment: run Shared<Intersection>.make(run Intersection.of(List<Shared<Lifetime>>.asSlice(&regions))),
    invocationBinders: usize.ZERO, invocationUse: usize.MAX, invocationBounds: List<Outlives>.make(), parameters: move parameters, result: move result})
  let ty = match move schema {
    Option<Shared<SectionSchema>>.Some {value} => match move run stagedSectionSchema(&mut resolver.*, &mut owner.*, &mut dependencies.*, module,
      &baseType, &value, move contract, signature, fresh, bindings, remaining, move captures,
      constraints, sectionContext(expected, false), span) {
      Result<Shared<Type>, Shared<Rejection>>.Success {value: ty} => move ty
      Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move error) }
    }
    _ => run Type.stagedCallable(move baseType, move contract, move captures, remaining, suffixMode, caller)
  }
  let parameterTypes = run signatureParameterTypes(signature)
  let kept = run callableKept(&mut resolver.*, &mut owner.*, &mut dependencies.*, signature,
    List<Shared<Type>>.asSlice(&parameterTypes), bindings, visible, caller, span)
  return run finishExpression(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor, caller, constraints, &mut nodes.*,
    expression, span, move ty,
    BodyExpression.StagedCallable {callee: callee, mode: transport, arguments: move arguments,
      retention: SectionRetention {kept: move kept, first: remaining, closed: run sectionBindingsClosed(signature, bindings, fresh),
        written: run Shared<List<usize>>.make(List<usize>.make())}},
    false, expected, mismatchCode, contractBody, false)
}

// Generic staging keeps a bound target blueprint while selecting evidence supplied at this
// construction. Captures append physically; their input ordinals still name the original target.
effect fn stagedSectionSchema(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, module: &ModuleId, base: &Shared<Type>,
  recipe: &Shared<SectionSchema>, contract: Shared<Type>, signature: &Shared<Result<Answer, NoRejection>>,
  fresh: &DeclarationId, bindings: &[Binding], remaining: usize, captures: List<Shared<Type>>, constraints: &[Constraint], contextual: bool, span: Span)
  -> Result<Shared<Type>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let copied = run CallableSchema.copy(recipe)
  let target = DeclarationId.copyShared(&copied.target)
  let mut request = Request.make()
  let sourceSchema = match move run resolveTargetSchema(&mut resolver.*, &mut owner.*, &mut request,
    &mut dependencies.*, true, &target, span) {
    Option<TargetSchema>.Some {value} => move value
    _ => { return Result<Shared<Type>, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Unsupported, span)) }
  }
  let mut evidence = List<Binding>.make()
  let fixed = List<Binding>.asSlice(&copied.selected)
  let mut at = usize.ZERO
  while at < fixed.length {
    if declarationEqualsShared(&target, &fixed[at].declaration) {
      run List<Binding>.append(&mut evidence, Binding {
        declaration: run Shared<DeclarationId>.make(DeclarationId.copy(fresh)), ordinal: sectionInferenceOrdinal(&sourceSchema, signature, fixed[at].ordinal),
        value: Argument.copy(&fixed[at].value)})
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < bindings.length {
    run List<Binding>.append(&mut evidence, Binding {declaration: Shared<DeclarationId>.clone(&bindings[at].declaration),
      ordinal: bindings[at].ordinal, value: Argument.copy(&bindings[at].value)})
    at = at + usize.ONE
  }
  // A deferred `?S` selector is inferred once this invocation solves its provider and source row.
  let freshIdentity = run Shared<DeclarationId>.make(DeclarationId.copy(fresh))
  let selectorFailure = run inferProvidedSelectors(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, signature,
    &freshIdentity, fresh, constraints, &mut evidence, span)
  if let Option<Shared<Rejection>>.Some {value} = move selectorFailure {
    return Result<Shared<Type>, Shared<Rejection>>.failResult(move value)
  }
  let open = run openParameters(remaining, remaining, usize.ZERO)
  let selected = match move run sectionSelection(&resolver.*, module, &target, &sourceSchema, signature,
    fresh, List<Binding>.asSlice(&evidence), List<usize>.asSlice(&open), constraints, contextual, span) {
    Result<SectionSelection, Shared<Rejection>>.Success {value} => move value
    Result<SectionSelection, Shared<Rejection>>.Failure {error} => { return Result<Shared<Type>, Shared<Rejection>>.failResult(move error) }
  }
  let mut choice = move selected
  at = usize.ZERO
  while at < fixed.length {
    if !declarationEqualsShared(&target, &fixed[at].declaration) {
      run List<Binding>.append(&mut choice.selected, Binding {declaration: Shared<DeclarationId>.clone(&fixed[at].declaration),
        ordinal: fixed[at].ordinal, value: Argument.copy(&fixed[at].value)})
    }
    at = at + usize.ONE
  }
  let written = match move run CallableContract.ofType(&copied.contract) {
    Option<CallableFacts>.Some {value} => move value _ => { return absurd<Result<Shared<Type>, Shared<Rejection>>>() }
  }
  let current = match move run CallableContract.ofType(&contract) {
    Option<CallableFacts>.Some {value} => move value _ => { return absurd<Result<Shared<Type>, Shared<Rejection>>>() }
  }
  let mut parameters = List<Shared<Type>>.make()
  let original = List<Shared<Type>>.asSlice(&written.parameters)
  at = usize.ZERO
  while at < remaining {
    if at >= original.length { return absurd<Result<Shared<Type>, Shared<Rejection>>>() }
    run List<Shared<Type>>.append(&mut parameters, Shared<Type>.clone(&original[at]))
    at = at + usize.ONE
  }
  let blueprint = run Types.intern(Type.Callable {mode: current.mode, isUnsafe: written.isUnsafe,
    environment: move current.environment, invocationBinders: written.invocationBinders,
    invocationUse: written.invocationUse, invocationBounds: move written.invocationBounds, parameters: move parameters, result: move written.result})
  let mut fields = List<Shared<Type>>.make()
  let mut inputs = List<CallableFieldInput>.make()
  let storage = run Type.copy(base)
  if let Type.CallableSchema {captures: previous, fieldInputs, ..} = move storage {
    let oldFields = List<Shared<Type>>.asSlice(&previous)
    let oldInputs = List<CallableFieldInput>.asSlice(&fieldInputs)
    if DeclarationId.kind(&target) == OwnerKind.Anonymous && oldInputs.length == usize.ZERO {
      run List<Shared<Type>>.append(&mut fields, Shared<Type>.clone(base))
      run List<CallableFieldInput>.append(&mut inputs, CallableFieldInput.Environment)
    } else {
    at = usize.ZERO
    while at < oldFields.length {
      if at >= oldInputs.length { return absurd<Result<Shared<Type>, Shared<Rejection>>>() }
      run List<Shared<Type>>.append(&mut fields, Shared<Type>.clone(&oldFields[at]))
      run List<CallableFieldInput>.append(&mut inputs, oldInputs[at])
      at = at + usize.ONE
    }
    }
  } else { return absurd<Result<Shared<Type>, Shared<Rejection>>>() }
  let supplied = List<Shared<Type>>.asSlice(&captures)
  at = usize.ZERO
  while at < supplied.length {
    run List<Shared<Type>>.append(&mut fields, Shared<Type>.clone(&supplied[at]))
    run List<CallableFieldInput>.append(&mut inputs, CallableFieldInput.Argument {parameter: remaining + at})
    at = at + usize.ONE
  }
  if List<usize>.length(&choice.deferred) == usize.ZERO {
    // A completed schema has the same source identity as direct section construction.
    // Preserve original sparse slots, checked target selection and public visibility.
    let slots = List<ApplicationSlot>.asSlice(&sourceSchema.own)
    let mut arguments = List<Argument>.make()
    at = usize.ZERO
    while at < slots.length {
      let argument = match move bindingArgument(List<Binding>.asSlice(&choice.selected), &target, slots[at].ordinal) {
        Option<Argument>.Some {value} => move value
        _ => { return Result<Shared<Type>, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Unsupported, span)) }
      }
      run List<Argument>.append(&mut arguments, move argument)
      at = at + usize.ONE
    }
    let original = run sectionOriginalSignature(&mut resolver.*, &mut owner.*, &mut dependencies.*, &target, span)
    let scopes = match move run sectionScopeArguments(&sourceSchema, List<Binding>.asSlice(&choice.selected)) {
      Option<List<Argument>>.Some {value} => move value
      _ => { return Result<Shared<Type>, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Unsupported, span)) }
    }
    let application = match move run checkedDirectApplication(&mut resolver.*, &mut owner.*, &mut request,
      &mut dependencies.*, &target, &original, move arguments, &scopes, module, span) {
      Result<Application, Shared<Rejection>>.Success {value} => move value
      Result<Application, Shared<Rejection>>.Failure {error} => { return Result<Shared<Type>, Shared<Rejection>>.failResult(move error) }
    }
    let identity = run Shared<DeclarationId>.make(DeclarationId.copy(&target))
    let ordinal = match move run ordinalOfIdentity(&mut resolver.*, DeclarationId.moduleId(&target), &identity) {
      Option<usize>.Some {value} => value
      _ => { return Result<Shared<Type>, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Unsupported, span)) }
    }
    let written = match move run signatureSyntax(&mut resolver.*, DeclarationId.moduleId(&target), ordinal) {
      Option<WrittenSignature>.Some {value} => move value
      _ => { return Result<Shared<Type>, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Unsupported, span)) }
    }
    let exposed = run Type.applyBindings(&blueprint, List<Binding>.asSlice(&choice.selected), true)
    return Result<Shared<Type>, Shared<Rejection>>.succeed(run Type.callableValue(written.isPublic,
      run Shared<Application>.make(move application), move exposed, move fields, move inputs))
  }
  let schema = run Shared<SectionSchema>.make(SectionSchema {target: move copied.target, contract: move blueprint,
    selected: move choice.selected, deferred: move choice.deferred})
  return Result<Shared<Type>, Shared<Rejection>>.succeed(run Type.callableSchema(move schema, move fields, move inputs))
}

// The composition intrinsic a pipeline's call target resolved to, if any.
effect fn pipedComposition(calls: &[ResolvedCall], target: HirId) -> Option<ResolvedTarget> ! OutOfMemoryError ? &mut Allocator {
  let found = run resolvedCall(calls, target)
  if let Option<Result<ResolvedTarget, Shared<Rejection>>>.Some {value: resolved} = move found {
    if let Result<ResolvedTarget, Shared<Rejection>>.Success {value} = move resolved {
      let composition = match &value { ResolvedTarget.Composition {..} => true _ => false }
      if composition { return Option<ResolvedTarget>.some(move value) }
    }
  }
  return Option<ResolvedTarget>.none()
}

// A call or pipeline (`checkInvocationOnce`). A pipeline into a call section whose type
// arguments the section alone does not determine is checked again as the direct call it stands
// for, `f(input, rest)`, so a handler that misses a failure of the piped Effect is named (SEM0067).
// The retry is keyed by the call section, whose target the call table resolved.
effect fn checkInvocation<'scope>(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, request: &mut Request,
  dependencies: &mut List<Dependency>, module: &ModuleId, cursor: &AuthoredCursor,
  caller: &DeclarationId, statementScope: &mut StatementScope<'scope>, calls: &[ResolvedCall], nodes: &mut List<BodyNode>,
  signatures: &mut List<SignatureDependency>, requiredBodies: &mut List<DeclarationId>,
  expression: HirId, input: CallInput, expected: &Option<Shared<Type>>, mismatchCode: RejectionCode, constraints: &[Constraint],
  contractBody: bool, staticBody: bool, unsafeAllowed: bool, callAcknowledged: bool, valueConstruction: bool,
  promised: &Option<NamedCallableEvidence>,
) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let first = run checkInvocationOnce(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module,
    cursor, caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*, expression, input,
    expected, mismatchCode, constraints, contractBody, staticBody, unsafeAllowed, callAcknowledged, valueConstruction, promised)
  let checked = run pipelinePrecedenceNote(&resolver.source, cursor, input, move first)
  // A static body has no callable values, so its pipeline into a call section is the direct call.
  let staticPipeline = staticBody && match &checked {
    Result<BodyNodeId, Shared<Rejection>>.Failure {error} => Shared<Rejection>.with<bool>(&error,
      fn(value: &Rejection) -> bool { return value.code == RejectionCode.StaticPhaseViolation })
    _ => false
  }
  let undetermined = match &checked {
    Result<BodyNodeId, Shared<Rejection>>.Failure {error} => Shared<Rejection>.with<bool>(&error,
      fn(value: &Rejection) -> bool { return value.code == RejectionCode.TypeArgumentInference })
    _ => false
  }
  if !(undetermined || staticPipeline) || !input.pipeline { return move checked }
  let piped = match input.arguments {
    CallArguments.Single {expression: value} => value
    _ => { return move checked }
  }
  let direct = match run bodyNode(&resolver.source, cursor, input.callee) {
    Node.CallExpression {callee, generics, arguments: rest} => CallInput {
      callee: callee, generics: generics, arguments: CallArguments.Piped {input: piped, range: rest}, pipeline: false}
    _ => { return move checked }
  }
  // `input |> f()` names no argument of its own, as at run time, where it calls `f` with none.
  if let CallArguments.Piped {range: rest, ..} = direct.arguments {
    if staticPipeline && rest.length == usize.ZERO {
      return run bodyRejection(&resolver.*, module, RejectionCode.RedundantCall, run bodySpan(&resolver.source, cursor, input.callee))
    }
  }
  let retried = run checkInvocationOnce(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module,
    cursor, caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*, input.callee, direct,
    expected, mismatchCode, constraints, contractBody, staticBody, unsafeAllowed, callAcknowledged, valueConstruction, promised)
  if staticPipeline {
    if let Result<BodyNodeId, Shared<Rejection>>.Success {..} = &retried { return move retried }
    return move checked
  }
  let handler = match &retried {
    Result<BodyNodeId, Shared<Rejection>>.Failure {error} => Shared<Rejection>.with<bool>(&error,
      fn(value: &Rejection) -> bool { return value.code == RejectionCode.InvalidEffectHandler })
    _ => false
  }
  if handler { return move retried }
  return move checked
}

// `input |> f(a) != b` reads as `input |> (f(a) != b)`: a pipe binds more loosely than an infix
// operator, so `f(a)` is called without the piped input. A wrong argument count inside that left
// operand gets a note saying how to pipe into the call first.
effect fn pipelinePrecedenceNote(source: &SourceIndex, cursor: &AuthoredCursor, input: CallInput,
  checked: Result<BodyNodeId, Shared<Rejection>>) -> Result<BodyNodeId, Shared<Rejection>>
! RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  if !input.pipeline { return move checked }
  let left = match run bodyNode(source, cursor, input.callee) {
    Node.InfixExpression {left: operand, ..} => operand
    _ => { return move checked }
  }
  let call = match run bodyNode(source, cursor, left) { Node.CallExpression {..} => true _ => false }
  if !call { return move checked }
  let within = run bodySpan(source, cursor, left)
  if let Result<BodyNodeId, Shared<Rejection>>.Failure {error} = &checked {
    let arity = Shared<Rejection>.with<bool>(&error, fn(value: &Rejection) -> bool {
      return value.code == RejectionCode.CallArity && value.span.start >= within.start && value.span.end <= within.end
    })
    if arity {
      run appendRejectionArgument(&error, b"note",
        b"`|>` binds more loosely than an infix operator, so this call does not receive the piped value; write `(value |> call(...)) == other` to pipe into the call first")
    }
  }
  return move checked
}

effect fn checkInvocationOnce<'scope>(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, request: &mut Request,
  dependencies: &mut List<Dependency>, module: &ModuleId, cursor: &AuthoredCursor,
  caller: &DeclarationId, statementScope: &mut StatementScope<'scope>, calls: &[ResolvedCall], nodes: &mut List<BodyNode>,
  signatures: &mut List<SignatureDependency>, requiredBodies: &mut List<DeclarationId>,
  expression: HirId, input: CallInput, expected: &Option<Shared<Type>>, mismatchCode: RejectionCode, constraints: &[Constraint],
  contractBody: bool, staticBody: bool, unsafeAllowed: bool, callAcknowledged: bool, valueConstruction: bool,
  promised: &Option<NamedCallableEvidence>,
) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let CallInput {callee, generics, arguments, pipeline} = input
  let span = run bodySpan(&resolver.source, cursor, expression)
  let mut ty = run Types.intern(Type.Unit)
  let mut form = BodyExpression.Unit
  let calleeSyntax = run bodyNode(&resolver.source, cursor, callee)
  // `inner |> Intrinsic.bindRequirement<S>(provider)` supplies the piped Effect as the first part.
  if pipeline {
    if let Node.CallExpression {arguments: rest, ..} = calleeSyntax {
      if let CallArguments.Single {expression: piped} = arguments {
        let composed = run pipedComposition(calls, callee)
        if let Option<ResolvedTarget>.Some {value: ResolvedTarget.Composition {operation, written}} = move composed {
          if staticBody { return run bodyRejection(&resolver.*, module, RejectionCode.StaticPhaseViolation, span) }
          return run checkComposition(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module, cursor,
            caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*, expression, span,
            operation, move written, CallArguments.Piped {input: piped, range: rest}, expected, mismatchCode, constraints, contractBody,
            unsafeAllowed)
        }
      }
    }
  }
  let valueTarget = callableExpressionTarget(calleeSyntax)
  if valueTarget {
    return run checkCallableInvocation(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
      module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*,
      expression, callee, generics, arguments, pipeline, expected, mismatchCode, constraints, contractBody, staticBody, unsafeAllowed, callAcknowledged,
    )
  }
  let qualified = run bodyQualifiedName(&resolver.source, cursor, callee)
  if !staticBody {
    if let Option<QualifiedBodyName>.Some {value} = &qualified {
      let mut selection = Option<Result<EnumSelection, Shared<Rejection>>>.none()
      if let Option<HirId>.None = &value.application {
        selection = run checkedEnumSelection(&mut resolver.*, &mut owner.*, &mut dependencies.*,
          module, Bytes.asSlice(&value.namespace), Bytes.asSlice(&value.member), span, true,
        )
      }
      if let Option<Result<EnumSelection, Shared<Rejection>>>.Some {value: selected} = move selection {
        let chosen = match move selected {
          Result<EnumSelection, Shared<Rejection>>.Success {value: choice} => move choice
          Result<EnumSelection, Shared<Rejection>>.Failure {error} => {
            return Result<BodyNodeId, Shared<Rejection>>.failResult(move error)
          }
        }
        if let EnumSelection.Value {ty: enumType, representation} = move chosen {
          if generics.present { return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span) }
          if CallArguments.length(arguments) != usize.ONE { return run bodyRejection(&resolver.*, module, RejectionCode.CallArity, span) }
          let argument = run bodyArgument(&resolver.source, cursor, arguments, usize.ZERO)
          let checked = run checkExpression(&mut resolver.*, &mut owner.*, &mut request.*,
            &mut dependencies.*, module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*,
            &mut signatures.*, &mut requiredBodies.*, argument, &Option<Shared<Type>>.some(move enumType), RejectionCode.TypeMismatch,
            constraints, contractBody, false, unsafeAllowed,
          )
          let operand = match move checked {
            Result<BodyNodeId, Shared<Rejection>>.Success {value: node} => node
            Result<BodyNodeId, Shared<Rejection>>.Failure {error} => {
              return Result<BodyNodeId, Shared<Rejection>>.failResult(move error)
            }
          }
          let index = List<BodyNode>.length(&nodes.*)
          run List<BodyNode>.append(&mut nodes.*, BodyNode {
            origin: run originAt(cursor, expression, span),
            kind: BodyNodeKind.Expression {ty: move representation, form: BodyExpression.EnumValue {value: operand},
              },
          },
          )
          return run checkExpectedValue(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, caller, constraints, &mut nodes.*,
            BodyNodeId {index: index}, expected, mismatchCode, span,
          )
        }
        return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
      }
    }
  }
  let receiverSpelling = match & qualified {
    Option<QualifiedBodyName>.Some {..} => false
    Option<QualifiedBodyName>.None => true
  }
  if let Option<QualifiedBodyName>.Some {value: name} = move qualified {
    let moduleOrdinal = knownModuleOrdinal(&resolver.*, module)
    if moduleOrdinal == usize.MAX {
      fail InvalidModulePath {}
    }
    let selection = run bodyQualifierDeclaration(&mut resolver.*, &mut owner.*, &mut dependencies.*, moduleOrdinal, module, &name)
    if let Result<QualifierDeclaration, Shared<Rejection>>.Success {value: qualifierTarget} = move selection {
      let QualifierDeclaration {selected: target, fixed: fixedContract, lifetimeAlias: unusedAlias, aliasLifetimes: unusedLifetimes} = move qualifierTarget
      drop unusedAlias
      drop unusedLifetimes
      let declaredModule = resolvedModule(&resolver.*, target.module)
      let written = run header(&mut resolver.*, &declaredModule, target.ordinal)
      if let Option<HeaderSyntax>.Some {value: named} = move written {
        if let Node.InterfaceHeader {isPublic, ..} = named.header {
          // An interface qualifier exposes its contract operations and its inherent members; only an
          // operation is an interface call, and an inherent member is an ordinary declaration call.
          let operation = run memberOrdinal(&mut resolver.*, &declaredModule, target.ordinal, Bytes.asSlice(&name.member))
          let mut contractOperation = false
          if let Option<usize>.Some {..} = &operation.ordinal { contractOperation = true }
          if let Option<Span>.Some {..} = &operation.repeated { contractOperation = true }
          if contractOperation {
            return run checkQualifiedInterfaceCall(
              &mut resolver.*,
              &mut owner.*,
              &mut request.*,
              &mut dependencies.*,
              module,
              cursor,
              caller,
              &mut statementScope.*,
              calls,
              &mut nodes.*,
              &mut signatures.*,
              &mut requiredBodies.*,
              expression,
              generics,
              arguments,
              expected, mismatchCode,
              constraints,
              contractBody,
              staticBody,
              &name,
              move target,
              move fixedContract,
              isPublic,
              unsafeAllowed,
              callAcknowledged,
            )
          }
        }
        // SERV-003: a service operation that takes its `Self` as an operand is an ordinary interface
        // operation call; only an operation served from the run site's row is a service call.
        if let Node.ServiceHeader {isPublic, ..} = named.header {
          let operation = run memberOrdinal(&mut resolver.*, &declaredModule, target.ordinal, Bytes.asSlice(&name.member))
          if let Option<usize>.Some {value: ordinal} = move operation.ordinal {
            let declarationAccess130Request = Key {
              family: Family.Signature, module: target.module, name: usize.ZERO, declaration: ordinal,
              member: usize.ZERO, external: false,
            }
            let declarationAccess130 = run internDeclaration(&mut resolver.*, declarationAccess130Request)
            let signature = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, declarationAccess130, name.subjectSpan)
            if run selfOperandOperation(&mut resolver.*, &declaredModule, target.ordinal, &signature) {
              return run checkQualifiedInterfaceCall(
                &mut resolver.*,
                &mut owner.*,
                &mut request.*,
                &mut dependencies.*,
                module,
                cursor,
                caller,
                &mut statementScope.*,
                calls,
                &mut nodes.*,
                &mut signatures.*,
                &mut requiredBodies.*,
                expression,
                generics,
                arguments,
                expected, mismatchCode,
                constraints,
                contractBody,
                staticBody,
                &name,
                move target,
                move fixedContract,
                isPublic,
                unsafeAllowed,
                callAcknowledged,
              )
            }
          }
        }
      }
    }
  }
  if receiverSpelling {
    if let Node.FieldExpression {subject, field} = run bodyNode(
      &resolver.source,
      cursor,
      callee) {
      return run checkReceiverCall(
        &mut resolver.*,
        &mut owner.*,
        &mut request.*,
        &mut dependencies.*,
        module,
        cursor,
        caller,
        &mut statementScope.*,
        calls,
        &mut nodes.*,
        &mut signatures.*,
        &mut requiredBodies.*,
        expression,
        callee,
        subject,
        field,
        generics,
        arguments,
        pipeline,
        expected, mismatchCode,
        constraints,
        contractBody,
        staticBody,
        unsafeAllowed,
        callAcknowledged,
      )
    }
  }
  let found = run resolvedCall(calls, expression)
  let resolved = match move found {
    Option<Result<ResolvedTarget, Shared<Rejection>>>.Some {value} => match move value {
      Result<ResolvedTarget, Shared<Rejection>>.Success {value: target} => move target
      Result<ResolvedTarget, Shared<Rejection>>.Failure {error} => {
        return Result<BodyNodeId, Shared<Rejection>>.failResult(move error)
      }
    }
    Option<Result<ResolvedTarget, Shared<Rejection>>>.None => {
      return run bodyRejection(&resolver.*, module, RejectionCode.CallTargetUnavailable, span)
    }
  }
  let target = match move resolved {
    ResolvedTarget.Function {target} => move target
    ResolvedTarget.Tuple {ty: tupleType, elements} => {
      if callAcknowledged { return run bodyRejection(&resolver.*, module, RejectionCode.UnsafeInvocation, span) }
      return run checkPositionalAggregate(&mut resolver.*, &mut owner.*, &mut request.*,
        &mut dependencies.*, module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*,
        &mut signatures.*, &mut requiredBodies.*, expression, arguments,
        &tupleType, List<Shared<Type>>.asSlice(&elements), &Option<InferredAggregateTarget>.none(), expected, mismatchCode,
        constraints, contractBody, staticBody, unsafeAllowed,
      )
    }
    ResolvedTarget.Constant {..} => {
      return run bodyRejection(&resolver.*, module, RejectionCode.NotCallable, span)
    }
    ResolvedTarget.ForeignStatic {..} => {
      return run bodyRejection(&resolver.*, module, RejectionCode.NotCallable, span)
    }
    ResolvedTarget.Composition {operation, written} => {
      if staticBody { return run bodyRejection(&resolver.*, module, RejectionCode.StaticPhaseViolation, span) }
      return run checkComposition(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module, cursor,
        caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*, expression, span,
        operation, move written, arguments, expected, mismatchCode, constraints, contractBody, unsafeAllowed)
    }
    ResolvedTarget.Selected {..} => {
      return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
    }
    ResolvedTarget.Storage {operation, typeArguments} => {
      if staticBody { return run bodyRejection(&resolver.*, module, RejectionCode.StaticPhaseViolation, span) }
      return run checkStorageCall(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module, cursor,
        caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*, expression, span,
        operation, move typeArguments, arguments, expected, mismatchCode, constraints, contractBody, unsafeAllowed, callAcknowledged)
    }
    ResolvedTarget.Intrinsic {member, typeArguments} => {
      let mutableField = intrinsicIsPrimitive(member, IntrinsicPrimitive.BorrowFieldMut)
      if intrinsicIsPrimitive(member, IntrinsicPrimitive.BorrowField) || mutableField {
        if callAcknowledged { return run bodyRejection(&resolver.*, module, RejectionCode.UnsafeInvocation, span) }
        return run checkBorrowFieldCall(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
          module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*,
          &mut requiredBodies.*, expression, span, mutableField, List<Shared<Type>>.asSlice(&typeArguments), arguments,
          expected, mismatchCode, constraints, contractBody, staticBody, unsafeAllowed)
      }
      if intrinsicIsPrimitive(member, IntrinsicPrimitive.MakeVariant) || intrinsicIsPrimitive(member, IntrinsicPrimitive.IsVariant) {
        if callAcknowledged { return run bodyRejection(&resolver.*, module, RejectionCode.UnsafeInvocation, span) }
        if intrinsicIsPrimitive(member, IntrinsicPrimitive.MakeVariant) {
          return run checkMakeVariantCall(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
            module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*,
            &mut requiredBodies.*, expression, span, List<Shared<Type>>.asSlice(&typeArguments), arguments,
            expected, mismatchCode, constraints, contractBody, staticBody, unsafeAllowed)
        }
        return run checkIsVariantCall(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
          module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*,
          &mut requiredBodies.*, expression, span, List<Shared<Type>>.asSlice(&typeArguments), arguments,
          expected, mismatchCode, constraints, contractBody, staticBody, unsafeAllowed)
      }
      if CheckedIntrinsic.isTestDiscovery(member) {
        if callAcknowledged { return run bodyRejection(&resolver.*, module, RejectionCode.UnsafeInvocation, span) }
        return run checkTestDiscoveryCall(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
          module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*,
          &mut requiredBodies.*, expression, span, member, List<Shared<Type>>.asSlice(&typeArguments), arguments,
          expected, mismatchCode, constraints, contractBody, staticBody, unsafeAllowed)
      }
      if callAcknowledged && !intrinsicIsUnsafe(member) {
        return run bodyRejection(&resolver.*, module, RejectionCode.UnsafeInvocation, span)
      }
      if intrinsicIsUnsafe(member) && !unsafeAllowed && !callAcknowledged {
        return run bodyRejection(&resolver.*, module, RejectionCode.UnsafeAcknowledgement, span)
      }
      if staticBody == intrinsicIsRuntime(member) {
        let mut diagnostic = run makeRejection(RejectionCode.StaticPhaseViolation, module, span)
        // A static intrinsic in runtime code names the intrinsic, before any target is selected.
        // The bootstrap admits the runtime intrinsics that static bodies reach, so that direction
        // has no wording and stays code-only.
        if let IntrinsicMember.Primitive {primitive} = member {
          if !staticBody {
            let mut operation = run Bytes.copy(b"Intrinsic.")
            run Bytes.append(&mut operation, CheckedIntrinsic.spelling(primitive))
            run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"operation"), value: move operation})
            run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"template"), value: run Bytes.copy(b"1")})
          }
        }
        return Result<BodyNodeId, Shared<Rejection>>.failResult(run Shared<Rejection>.make(move diagnostic))
      }
      if CallArguments.length(arguments) != intrinsicArity(member) {
        return run bodyRejection(&resolver.*, module, RejectionCode.CallArity, span)
      }
      if intrinsicIsAtomic(member) {
        return run checkAtomicCall(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
          module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*,
          &mut requiredBodies.*, expression, span, member, List<Shared<Type>>.asSlice(&typeArguments), arguments,
          expected, mismatchCode, constraints, contractBody, unsafeAllowed)
      }
      if intrinsicIsReflection(member) {
        return run checkReflectionCall(
          &mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module, cursor, caller,
          &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*, expression, span, member,
          List<Shared<Type>>.asSlice(&typeArguments), arguments, expected, mismatchCode, constraints, contractBody,
          staticBody, unsafeAllowed,
        )
      }
      // A generic primitive is instantiated from its type arguments; others have closed kinds. A
      // checked scalar operation returns through its `present` and `absent` carriers.
      let generic = intrinsicIsGeneric(member)
      let instantiation = List<Shared<Type>>.asSlice(&typeArguments)
      // A vector operation names its vector as its one type argument (SIMD-003).
      if let Option<IntrinsicVectorRefusal>.Some {value: refusal} = move CheckedIntrinsic.vectorRefusal(member, instantiation,
        u32.toUsize(resolver.target.pointerBits())) {
        if let IntrinsicMember.Primitive {primitive} = member {
          return Result<BodyNodeId, Shared<Rejection>>.failResult(run vectorOperationRejection(module, span, primitive, instantiation, refusal))
        }
      }
      // An architecture operation needs its target and CPU feature (SIMD-007).
      if let IntrinsicMember.Primitive {primitive: archPrimitive} = member {
        let mut signature = CheckedIntrinsic.archSignature(archPrimitive, usize.ZERO)
        if signature.arity != usize.ZERO { signature = CheckedIntrinsic.archFor(archPrimitive, &instantiation[usize.ZERO]) }
        let mut listed = List<Bytes>.make()
        if signature.arity != usize.ZERO {
          let callerIdentity = run Shared<DeclarationId>.make(DeclarationId.copy(caller))
          if let Option<usize>.Some {value: callerOrdinal} = move run ordinalOfIdentity(&mut resolver.*, module, &callerIdentity) {
            listed = run declarationFeatures(&mut resolver.*, module, callerOrdinal)
          }
        }
        if signature.arity != usize.ZERO && !archAdmitted(&resolver.*, signature, List<Bytes>.asSlice(&listed)) {
          let mut diagnostic = run makeRejection(RejectionCode.UnavailableArchOperation, module, span)
          let mut operation = run Bytes.copy(b"Intrinsic.")
          run Bytes.append(&mut operation, CheckedIntrinsic.spelling(archPrimitive))
          let mut requirement = run Bytes.copy(signature.architecture)
          run Bytes.append(&mut requirement, b" with ")
          run Bytes.append(&mut requirement, signature.feature)
          run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"operation"), value: move operation})
          run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"requirement"), value: move requirement})
          return Result<BodyNodeId, Shared<Rejection>>.failResult(run Shared<Rejection>.make(move diagnostic))
        }
      }
      let mut carriers = usize.MAX
      if let Option<usize>.Some {value: start} = move intrinsicCarrierStart(member) { carriers = start }
      let mut checkedArguments = List<BodyNodeId>.make()
      let mut firstArgument = Option<Shared<Type>>.none()
      let mut at = usize.ZERO
      while at < CallArguments.length(arguments) {
        if intrinsicIsPrimitive(member, IntrinsicPrimitive.SimdShuffle) && at == 2 {
          let indices = run shuffleArgument(&resolver.*, module, cursor, calls, &mut nodes.*, expression, arguments, instantiation, span)
          match move indices {
            Result<BodyNodeId, Shared<Rejection>>.Success {value} => run List<BodyNodeId>.append(&mut checkedArguments, value)
            Result<BodyNodeId, Shared<Rejection>>.Failure {error} => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move error) }
          }
          at = at + usize.ONE
          continue
        }
        let mut kind = IntrinsicValueKind.Text
        let mut context = Option<Shared<Type>>.none()
        // A carrier is checked without context, as a composition operand is; its offered contract
        // is then compared with the carrier contract. A named function carrier takes the binders its
        // target leaves open, such as a generic impl's, from that contract.
        let mut contract = Option<Shared<Type>>.none()
        if generic {
          context = run intrinsicGenericParameter(member, instantiation, at)
        } else if at >= carriers {
          contract = run intrinsicCarrierContract(member, instantiation, at)
        } else {
          kind = match move intrinsicParameterKind(member, at) {
            Option<IntrinsicValueKind>.Some {value} => value
            Option<IntrinsicValueKind>.None => {
              return run bodyRejection(&resolver.*, module, RejectionCode.CallArity, span)
            }
          }
          if intrinsicContextual(kind) {
            context = Option<Shared<Type>>.some(run intrinsicValueType(kind))
          }
        }
        let argumentId = run bodyArgument(&resolver.source, cursor, arguments, at)
        let mut namedValue = Option<Result<BodyNodeId, Shared<Rejection>>>.none()
        if let Option<Shared<Type>>.Some {value: carrier} = &contract {
          let promised = Option<NamedCallableEvidence>.some(NamedCallableEvidence {
            contract: Shared<Type>.clone(&carrier), pending: Option<DeclarationId>.none(), call: Option<Span>.none()})
          namedValue = run checkNamedValue(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
            module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*,
            argumentId, &context, RejectionCode.TypeMismatch, &promised, constraints, contractBody, staticBody, unsafeAllowed)
        }
        let checked = match move namedValue {
          Option<Result<BodyNodeId, Shared<Rejection>>>.Some {value: valueResult} => move valueResult
          Option<Result<BodyNodeId, Shared<Rejection>>>.None => run checkExpression(&mut resolver.*, &mut owner.*,
            &mut request.*, &mut dependencies.*, module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*,
            &mut signatures.*, &mut requiredBodies.*, argumentId, &context, RejectionCode.TypeMismatch, constraints, contractBody, staticBody, unsafeAllowed)
        }
        let mut argumentNode = match move checked {
          Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
          Result<BodyNodeId, Shared<Rejection>>.Failure {error} => {
            return Result<BodyNodeId, Shared<Rejection>>.failResult(move error)
          }
        }
        // A pointer argument takes the ordinary immediate weakening to its instantiated parameter.
        if let Option<Shared<Type>>.Some {value: parameterType} = &context {
          if generic {
            let noVariables = List<Shared<DeclarationId>>.make()
            let noBindings = List<Binding>.make()
            argumentNode = run pointerArgument(&mut nodes.*, argumentNode, &parameterType,
              List<Shared<DeclarationId>>.asSlice(&noVariables), List<Binding>.asSlice(&noBindings))
          }
        }
        if at >= carriers {
          let carried = run carrierArgument(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor, &mut nodes.*,
            argumentNode, argumentId, &contract, RejectionCode.TypeMismatch, constraints)
          argumentNode = match move carried {
            Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
            Result<BodyNodeId, Shared<Rejection>>.Failure {error} => {
              return Result<BodyNodeId, Shared<Rejection>>.failResult(move error)
            }
          }
          run List<BodyNodeId>.append(&mut checkedArguments, argumentNode)
          at = at + usize.ONE
          continue
        }
        let evidence = bodyExpressionType(List<BodyNode>.asSlice(&nodes.*), &argumentNode)
        let mut valid = false
        if let Option<Shared<Type>>.Some {value: argumentType} = move evidence {
          if !generic {
            let closedKind = kind
            valid = Shared<Type>.with<bool>(
              &argumentType,
              fn(resolved: &Type) -> bool {
                return intrinsicMatches(closedKind, resolved)
              },
            )
          } else {
            if let Option<Shared<Type>>.Some {value: parameterType} = &context {
              valid = run Type.equalsShared(&argumentType, &parameterType)
              // A selected instance body types the argument in its closed application, while the
              // written type arguments still name the caller's binders.
              if !valid {
                let appliedParameter = run selectedBodyComparedType(&resolver.*, &parameterType)
                let appliedArgument = run selectedBodyComparedType(&resolver.*, &argumentType)
                valid = run Type.equalsShared(&appliedArgument, &appliedParameter)
              }
            } else {
              valid = run intrinsicGenericArgument(member, instantiation, at, &argumentType)
            }
          }
          if at == usize.ZERO { firstArgument = Option<Shared<Type>>.some(move argumentType) }
        }
        if !valid {
          return run bodyRejection(&resolver.*, module, RejectionCode.TypeMismatch, span)
        }
        run List<BodyNodeId>.append(&mut checkedArguments, argumentNode)
        at = at + usize.ONE
      }
      if generic {
        // A view keeps its argument's exact slice type, including the caller's loan.
        let mut instantiated = move firstArgument
        // An anchored borrow keeps its anchor's loan.
        if intrinsicIsPrimitive(member, IntrinsicPrimitive.PointerBorrow) || intrinsicIsPrimitive(member, IntrinsicPrimitive.PointerBorrowMut) ||
          intrinsicIsPrimitive(member, IntrinsicPrimitive.PointerBorrowMany) || intrinsicIsPrimitive(member, IntrinsicPrimitive.PointerBorrowManyMut) {
          let mut anchored = Option<Shared<Type>>.none()
          if let Option<Shared<Type>>.Some {value: anchor} = &instantiated {
            anchored = run CheckedIntrinsic.anchoredResult(member, instantiation, &anchor)
          }
          instantiated = move anchored
        } else if !intrinsicIsPrimitive(member, IntrinsicPrimitive.SliceView) {
          instantiated = run intrinsicGenericResult(member, instantiation)
        }
        ty = match move instantiated {
          Option<Shared<Type>>.Some {value} => move value
          Option<Shared<Type>>.None => {
            return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
          }
        }
        if !run intrinsicQualifies(member, instantiation) {
          return run bodyRejection(&resolver.*, module, RejectionCode.InvalidPointerQualifier, span)
        }
        if intrinsicIsPrimitive(member, IntrinsicPrimitive.PointerRead) || intrinsicIsPrimitive(member, IntrinsicPrimitive.PointerReadUnaligned) {
          let readable = run copyType(&mut resolver.*, &mut owner.*, &mut dependencies.*, &ty, constraints, span)
          let copied = match move readable {
            Result<bool, Shared<Rejection>>.Success {value} => value
            Result<bool, Shared<Rejection>>.Failure {error} => {
              return Result<BodyNodeId, Shared<Rejection>>.failResult(move error)
            }
          }
          if !copied {
            return run bodyRejection(&resolver.*, module, RejectionCode.MissingConformance, span)
          }
        }
      } else if carriers != usize.MAX {
        // Both carriers produce the call's result type argument.
        ty = Shared<Type>.clone(&instantiation[usize.ZERO])
      } else {
        ty = match move intrinsicResultKind(member) {
          Option<IntrinsicValueKind>.Some {value: resultKind} => run intrinsicValueType(resultKind)
          Option<IntrinsicValueKind>.None => {
            return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
          }
        }
      }
      if intrinsicIsPrimitive(member, IntrinsicPrimitive.Assembly) {
        let admitted = run assemblyAdmitted(&resolver.*, cursor, List<BodyNode>.asSlice(&nodes.*),
          List<BodyNodeId>.asSlice(&checkedArguments), &ty)
        if !admitted { return run bodyRejection(&resolver.*, module, RejectionCode.InvalidConfiguration, span) }
      }
      let index = List<BodyNode>.length(&nodes.*)
      run List<BodyNode>.append(
        &mut nodes.*,
        BodyNode {
          origin: run originAt(cursor, expression, span),
          kind: BodyNodeKind.Expression {
            ty: move ty,
            form: BodyExpression.IntrinsicCall {
              member: member,
              arguments: move checkedArguments},
          },
        },
      )
      // The result meets an expected type as any other value does, with the same conversions.
      return run checkExpectedValue(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, caller, constraints, &mut nodes.*,
        BodyNodeId {index: index}, expected, mismatchCode, span)
    }
  }
  return run checkDeclarationCall(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module, cursor,
    caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*, expression, span,
    move target, arguments, pipeline, &Option<CallReceiver>.none(), expected, mismatchCode, constraints, contractBody, staticBody,
    unsafeAllowed, callAcknowledged, valueConstruction, promised)
}

// A call of one selected declaration: its binders are opened under a private inference owner,
// fixed by a written prefix, inferred from the operands and an expected result, and its applied
// bounds proven. A receiver call supplies its already adapted receiver as argument zero.
// Checks a call of a named declaration. A call with fewer arguments than parameters is a partial
// application (CALLABLE-001); where a plain value is expected it cannot fit, and the forgotten
// arguments are the likelier mistake, so the mismatch is reported as the call's arity (SEM0007).
effect fn checkDeclarationCall<'scope>(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, request: &mut Request,
  dependencies: &mut List<Dependency>, module: &ModuleId, cursor: &AuthoredCursor,
  caller: &DeclarationId, statementScope: &mut StatementScope<'scope>, calls: &[ResolvedCall], nodes: &mut List<BodyNode>,
  signatures: &mut List<SignatureDependency>, requiredBodies: &mut List<DeclarationId>,
  expression: HirId, span: Span, target: CallTarget, arguments: CallArguments, pipeline: bool,
  receiver: &Option<CallReceiver>, expected: &Option<Shared<Type>>, mismatchCode: RejectionCode, constraints: &[Constraint],
  contractBody: bool, staticBody: bool, unsafeAllowed: bool, callAcknowledged: bool, valueConstruction: bool,
  promised: &Option<NamedCallableEvidence>,
) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let supplied = CallArguments.length(arguments)
  let parameterCount = Shared<Result<Answer, NoRejection>>.with<usize>(&target.signature, signatureParameterCount)
  let variadic = Shared<Result<Answer, NoRejection>>.with<bool>(&target.signature, signatureIsVariadic)
  let mut valueWanted = false
  if let Option<Shared<Type>>.Some {value: wanted} = &expected.* { valueWanted = Shared<Type>.with<bool>(&wanted, plainValueType) }
  let section = valueWanted && !pipeline && !valueConstruction && !variadic && supplied > usize.ZERO && supplied < parameterCount
  let mut absentReceiver = false
  if let Option<CallReceiver>.None = &receiver.* { absentReceiver = true }
  let checked = run checkDeclarationCallForm(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module, cursor,
    caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*, expression, span, move target,
    arguments, pipeline, receiver, expected, mismatchCode, constraints, contractBody, staticBody, unsafeAllowed,
    callAcknowledged, valueConstruction, promised)
  if let Result<BodyNodeId, Shared<Rejection>>.Failure {error} = &checked {
    // Only a mismatch of the call's own value: an argument's mismatch stays its own diagnostic.
    let mismatch = Shared<Rejection>.with<bool>(&error, fn(diagnostic: &Rejection) -> bool {
      return (valueMismatchReason(diagnostic.code) || diagnostic.code == mismatchCode)
        && diagnostic.span.start == span.start && diagnostic.span.end == span.end
    })
    if section && absentReceiver && mismatch {
      return Result<BodyNodeId, Shared<Rejection>>.failResult(run wrongArityRejection(&resolver.*, module, span, parameterCount, supplied))
    }
  }
  return move checked
}

// Whether `value` is a plain value type, which a partial application can never be: not a callable,
// an opaque representation, a generic parameter, or an Effect.
fn plainValueType(value: &Type) -> bool {
  return match &value.* {
    Type.Primitive {..} => true
    Type.Unit => true
    Type.Nominal {..} => true
    Type.String {..} => true
    Type.Slice {..} => true
    Type.Array {..} => true
    Type.Vector {..} => true
    Type.Union {..} => true
    _ => false
  }
}

effect fn checkDeclarationCallForm<'scope>(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, request: &mut Request,
  dependencies: &mut List<Dependency>, module: &ModuleId, cursor: &AuthoredCursor,
  caller: &DeclarationId, statementScope: &mut StatementScope<'scope>, calls: &[ResolvedCall], nodes: &mut List<BodyNode>,
  signatures: &mut List<SignatureDependency>, requiredBodies: &mut List<DeclarationId>,
  expression: HirId, span: Span, target: CallTarget, arguments: CallArguments, pipeline: bool,
  receiver: &Option<CallReceiver>, expected: &Option<Shared<Type>>, mismatchCode: RejectionCode, constraints: &[Constraint],
  contractBody: bool, staticBody: bool, unsafeAllowed: bool, callAcknowledged: bool, valueConstruction: bool,
  promised: &Option<NamedCallableEvidence>,
) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut ty = run Types.intern(Type.Unit)
  let mut form = BodyExpression.Unit
  // A runtime body reaches a static function only through its selection pass, which embeds the
  // result; an unselected runtime body cannot call one. A static function's own body may.
  if !staticBody {
    let callee = Shared<Result<Answer, NoRejection>>.with<Option<SignatureFacts>>(&target.signature, signatureFacts,
    )
    if let Option<SignatureFacts>.Some {value: facts} = move callee {
      if facts.isStatic { return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span) }
    }
  }
  let foreignCall = target.foreign
  let variadic = Shared<Result<Answer, NoRejection>>.with<bool>(&target.signature, signatureIsVariadic)
  if variadic && !foreignCall { return run bodyRejection(&resolver.*, module, RejectionCode.ForeignVariadic, span) }
  if foreignCall {
    let lanes = Shared<Result<Answer, NoRejection>>.with<usize>(&target.signature, signatureParameterCount)
    let mut lane = usize.ZERO
    while lane <= lanes {
      let checked = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(&target.signature,
        fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> {
          if lane == lanes { return signatureResult(answer) }
          return signatureParameterAt(answer, lane)
        })
      if let Option<Shared<Type>>.Some {value: laneType} = move checked {
        if let Option<Shared<Rejection>>.Some {value: refused} = move run foreignTypeGap(&mut resolver.*, module, &laneType, span) {
          return Result<BodyNodeId, Shared<Rejection>>.failResult(move refused)
        }
        if let Option<Shared<Rejection>>.Some {value: unavailable} = move run foreignVectorRejection(&resolver.*, module, &laneType, span) {
          return Result<BodyNodeId, Shared<Rejection>>.failResult(move unavailable)
        }
      }
      lane = lane + usize.ONE
    }
  }
  let parameterCount = Shared<Result<Answer, NoRejection>>.with<usize>(
    &target.signature,
    signatureParameterCount,
  )
  if pipeline && parameterCount != usize.ONE {
    return run bodyRejection(&resolver.*, module, RejectionCode.CallArity, span)
  }
  // A receiver operand is argument zero; the written arguments follow it. A bound method value
  // writes none, so its section captures parameter zero instead of a suffix.
  let mut receiverCount = usize.ZERO
  let mut bound = false
  if let Option<CallReceiver>.Some {value: operand} = &receiver.* {
    receiverCount = usize.ONE
    bound = operand.bound
    if target.foreign { return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span) }
    let written = CallArguments.length(arguments)
    if pipeline || (bound && written != usize.ZERO) || (!bound && written + usize.ONE != parameterCount) {
      return run bodyRejection(&resolver.*, module, RejectionCode.CallArity, span)
    }
  }
  let actualCount = CallArguments.length(arguments) + receiverCount
  if variadic {
    if parameterCount == usize.ZERO { return run bodyRejection(&resolver.*, module, RejectionCode.ForeignVariadic, span) }
    if actualCount < parameterCount { return run bodyRejection(&resolver.*, module, RejectionCode.CallArity, span) }
  } else {
    let shape = callArityRejection(parameterCount, actualCount)
    if let Option<RejectionCode>.Some {value: reason} = move shape {
      // Both counts include a receiver, as the bootstrap counts them.
      if !valueConstruction && reason == RejectionCode.CallArity {
        return Result<BodyNodeId, Shared<Rejection>>.failResult(
          run wrongArityRejection(&resolver.*, module, span, parameterCount, actualCount))
      }
      if !valueConstruction { return run bodyRejection(&resolver.*, module, reason, span) }
    }
  }
  if foreignCall && CallArguments.length(arguments) < parameterCount {
    return run bodyRejection(&resolver.*, module, RejectionCode.ForeignFunctionNotFirstClass, span)
  }
  let effectTarget = Shared<Result<Answer, NoRejection>>.with<bool>(&target.signature, signatureIsEffect)
  let unsafeCall = foreignCall || Shared<Result<Answer, NoRejection>>.with<bool>(
    &target.signature,
    signatureUnsafe,
  )
  let fullInvocation = !bound && (actualCount == parameterCount || (variadic && actualCount >= parameterCount))
  if !valueConstruction && fullInvocation && unsafeCall && !unsafeAllowed && !callAcknowledged {
    return run bodyRejection(&resolver.*, module, RejectionCode.UnsafeAcknowledgement, span)
  }
  if fullInvocation && callAcknowledged && !unsafeCall {
    return run bodyRejection(&resolver.*, module, RejectionCode.UnsafeInvocation, span)
  }
  let mut inferenceScope = Bytes.make()
  run Bytes.append(&mut inferenceScope, b"\0call-inference")
  run RuntimeEncoding.declaration(&mut inferenceScope, caller)
  run RuntimeEncoding.word(&mut inferenceScope, usize.toU64(span.start))
  run RuntimeEncoding.word(&mut inferenceScope, usize.toU64(span.end))
  run RuntimeEncoding.word(&mut inferenceScope, usize.toU64(resolver.nextInferenceId))
  resolver.nextInferenceId = resolver.nextInferenceId + usize.ONE
  let freshOwner = run DeclarationId.inference(&target.declaration, Bytes.asSlice(&inferenceScope))
  let inferenceSchema = run resolveTargetSchema(
    &mut resolver.*,
    &mut owner.*,
    &mut request.*,
    &mut dependencies.*,
    true,
    &target.declaration,
    span,
  )
  let schema = match move inferenceSchema {
    Option<TargetSchema>.Some {value} => move value
    Option<TargetSchema>.None => { return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span) }
  }
  let originalInference = match move run callInferenceSignature(
    &resolver.*,
    &target.signature,
    &schema,
    &freshOwner,
    List<Argument>.length(&target.scopeArguments) != usize.ZERO,
    module,
    span,
  ) {
    Result<Shared<Result<Answer, NoRejection>>, Shared<Rejection>>.Success {value} => move value
    Result<Shared<Result<Answer, NoRejection>>, Shared<Rejection>>.Failure {error} => {
      return Result<BodyNodeId, Shared<Rejection>>.failResult(move error)
    }
  }
  let originalBinderCount = Shared<Result<Answer, NoRejection>>.with<usize>(
    &originalInference,
    signatureBinderCount,
  )
  let callOwner = run Shared<DeclarationId>.make(DeclarationId.copy(&freshOwner))
  let mut variables = List<Shared<DeclarationId>>.make()
  run List<Shared<DeclarationId>>.append(
    &mut variables,
    Shared<DeclarationId>.clone(&callOwner))
  let mut inferred = List<Binding>.make()
  let explicit = List<Argument>.asSlice(&target.explicit)
  let writtenSlots = List<CallPrefixSlot>.asSlice(&target.explicitSlots)
  if writtenSlots.length != explicit.length { fail RevisionMismatch {} }
  let mut mappedExplicitOrdinals = List<usize>.make()
  let mut templateBindings = List<Binding>.make()
  if let Option<Shared<DeclarationId>>.Some {value: templateOwner} = &target.prefixOwner {
    let mut at = usize.ZERO
    while at < target.prefixLifetimes {
      run List<Binding>.append(&mut templateBindings, Binding {
        declaration: Shared<DeclarationId>.clone(&templateOwner), ordinal: at,
        value: Argument.Lifetime {value: run Shared<Lifetime>.make(Lifetime.Parameter {
          declaration: DeclarationId.copy(&freshOwner), ordinal: originalBinderCount + at})}})
      at = at + usize.ONE
    }
  } else if target.prefixLifetimes != usize.ZERO { fail RevisionMismatch {} }
  let mut binderAt = usize.ZERO
  while binderAt < explicit.length {
    let ordinal = run callPrefixInferenceOrdinal(&writtenSlots[binderAt], &schema, &target.signature, &originalInference)
    if ordinal == usize.MAX || ordinal >= originalBinderCount {
      return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
    }
    run List<usize>.append(&mut mappedExplicitOrdinals, ordinal)
    let value = run Argument.applyBindings(&explicit[binderAt], List<Binding>.asSlice(&templateBindings), true)
    run List<Binding>.append(
      &mut inferred,
      Binding {
        declaration: Shared<DeclarationId>.clone(&callOwner),
        ordinal: ordinal,
        value: move value,
      },
    )
    binderAt = binderAt + usize.ONE
  }
  let explicitOrdinals = List<usize>.asSlice(&mappedExplicitOrdinals)
  let mut inference = Shared<Result<Answer, NoRejection>>.clone(&originalInference)
  if target.prefixLifetimes != usize.ZERO {
    let expanded = run callPrefixInferenceSignature(&originalInference, &freshOwner, target.prefixLifetimes, List<Binding>.asSlice(&inferred))
    inference = move expanded
  }
  let binderCount = originalBinderCount + target.prefixLifetimes
  let mut typedArguments = List<BodyNodeId>.make()
  let mut variadicArguments = List<CAbi.VariadicArgument>.make()
  // `parameterOffset` parameters stay open; the supplied arguments fill those from `firstSupplied`.
  let mut parameterOffset = usize.ZERO
  if !variadic { parameterOffset = parameterCount - actualCount }
  let mut firstSupplied = parameterOffset
  if bound { firstSupplied = usize.ZERO }
  let open = run openParameters(parameterCount, firstSupplied, actualCount)
  // A callee's static parameters take the values this body's selection pass evaluated for this
  // call; they are never runtime operands. An unselected body cannot supply them.
  let staticCount = Shared<Result<Answer, NoRejection>>.with<usize>(&target.signature, signatureStaticCount,
  )
  let mut suppliedStatics = Option<Shared<List<StaticSlot>>>.none()
  // Static field operands reflected again at the owner regions this call's other operands supply.
  let mut retypedStatics = List<StaticSlot>.make()
  if staticCount > usize.ZERO {
    suppliedStatics = staticArgumentsFact(calls, expression)
    if let Option<Shared<List<StaticSlot>>>.None = &suppliedStatics {
      // A receiver call's callee is known only now: the body selects again with its slots.
      if receiverCount != usize.ZERO {
        run discoverStaticCall(&mut resolver.*, &target.signature, expression, receiverCount)
        return Result<BodyNodeId, Shared<Rejection>>.failResult(run staticArgumentsGap(module, span, b"1"))
      }
      return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
    }
  }
  let mut at = usize.ZERO
  while at < actualCount {
    if variadic && at >= parameterCount {
      let argumentId = run bodyArgument(&resolver.source, cursor, arguments, at - receiverCount)
      let argumentSpan = run bodySpan(&resolver.source, cursor, argumentId)
      let checked = run checkExpression(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
        module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*,
        argumentId, &Option<Shared<Type>>.none(), RejectionCode.TypeMismatch, constraints, contractBody, staticBody, unsafeAllowed)
      let node = match move checked {
        Result<BodyNodeId, Shared<Rejection>>.Success {value: checkedNode} => checkedNode
        Result<BodyNodeId, Shared<Rejection>>.Failure {error: rejectedTail} => {
          return Result<BodyNodeId, Shared<Rejection>>.failResult(move rejectedTail)
        }
      }
      let tailType = bodyExpressionType(List<BodyNode>.asSlice(&nodes.*), &node)
      let actual = match move tailType {
        Option<Shared<Type>>.Some {value: checkedType} => move checkedType
        Option<Shared<Type>>.None => { return run bodyRejection(&resolver.*, module, RejectionCode.ForeignType, argumentSpan) }
      }
      let promoted = run CAbi.promoteVariadic(&actual)
      match move promoted {
        Option<CAbi.VariadicArgument>.Some {value: tail} => run List<CAbi.VariadicArgument>.append(&mut variadicArguments, move tail)
        Option<CAbi.VariadicArgument>.None => { return run bodyRejection(&resolver.*, module, RejectionCode.ForeignType, argumentSpan) }
      }
      run List<BodyNodeId>.append(&mut typedArguments, node)
      at = at + usize.ONE
      continue
    }
    let parameter = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(
      &inference,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> {
        return signatureParameter(answer, at + firstSupplied)
      },
    )
    let staticValue = match &suppliedStatics {
      Option<Shared<List<StaticSlot>>>.Some {value: slots} => Shared<
List<StaticSlot>,
      >.with<
Option<Shared<StaticData>>,
      >(&slots,
        fn(listed: &List<StaticSlot>) -> Option<Shared<StaticData>> { return staticSlotValue(listed, at + firstSupplied) },
      )
      Option<Shared<List<StaticSlot>>>.None => Option<Shared<StaticData>>.none()
    }
    if let Option<Shared<StaticData>>.Some {value: original} = move staticValue {
      // Static operands participate in the same exact call inference as runtime operands.
      // Their canonical type is evidence; their value remains solely in the application.
      let argumentId = run bodyArgument(&resolver.source, cursor, arguments, at - receiverCount)
      let argumentSpan = run bodySpan(&resolver.source, cursor, argumentId)
      let declared = match move parameter {
        Option<Shared<Type>>.Some {value} => move value
        Option<Shared<Type>>.None => { return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span) }
      }
      let bodyBindings = run selectedBodyBindings(&resolver.*)
      let assigned = List<Binding>.asMutSlice(&mut inferred)
      let mut bindingAt = usize.ZERO
      while bindingAt < assigned.length {
        let old = Argument.copy(&assigned[bindingAt].value)
        assigned[bindingAt].value = run Argument.applyBindings(&old, List<Binding>.asSlice(&bodyBindings), true)
        bindingAt = bindingAt + usize.ONE
      }
      let pattern = run Type.applyBindings(&declared, List<Binding>.asSlice(&inferred), true)
      let compared = run Type.applyBindings(&pattern, List<Binding>.asSlice(&bodyBindings), true)
      let mut supplied = move original
      let regioned = run regionedStaticField(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, &compared, &supplied, argumentSpan)
      if let Option<Shared<StaticData>>.Some {value: retyped} = move regioned {
        run List<StaticSlot>.append(&mut retypedStatics, StaticSlot {ordinal: at + firstSupplied, value: StaticValue.copy(&retyped)})
        supplied = move retyped
      }
      if Type.hasOpenParameters(&compared) {
        let evidence = match move run staticArgumentType(&mut resolver.*, &mut owner.*, &mut dependencies.*, &supplied, argumentSpan) {
          Option<Shared<Type>>.Some {value} => move value
          Option<Shared<Type>>.None => { return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, argumentSpan) }
        }
        let failed = run matchCallArgument(&resolver.*, module, argumentSpan, &compared, &evidence,
          List<Shared<DeclarationId>>.asSlice(&variables), &mut inferred, constraints, RejectionCode.TypeMismatch)
        if let Option<Shared<Rejection>>.Some {value} = move failed {
          return Result<BodyNodeId, Shared<Rejection>>.failResult(move value)
        }
      }
      let specialized = run Type.applyBindings(&declared, List<Binding>.asSlice(&inferred), true)
      let exact = run Type.applyBindings(&specialized, List<Binding>.asSlice(&bodyBindings), true)
      if Type.hasOpenParameters(&exact) {
        return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, argumentSpan)
      }
      if !run StaticValue.matchesType(&supplied, &exact) {
        return run staticArgumentMismatch(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, &supplied, &exact,
          argumentSpan)
      }
      at = at + usize.ONE
      continue
    }
    if let Option<Shared<Type>>.Some {value: parameterType} = move parameter {
      let ordinal = Shared<Type>.with<usize>(
        &parameterType,
        fn(value: &Type) -> usize {
          return Type.parameterOrdinalOf(value, &freshOwner)
        },
      )
      if ordinal != usize.MAX && ordinal >= binderCount {
        return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
      }
      if let Option<CallReceiver>.Some {value: operand} = &receiver.* {
        if at == usize.ZERO {
          let mut failed = Option<Shared<Rejection>>.none()
          if operand.open {
            // An open receiver meets its parameter as the explicit `&place` or by-value operand would.
            let actual = match move bodyExpressionType(List<BodyNode>.asSlice(&nodes.*), &operand.node) {
              Option<Shared<Type>>.Some {value} => move value
              Option<Shared<Type>>.None => { return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, operand.memberSpan) }
            }
            let pattern = run callArgumentType(&parameterType, &target.signature, &freshOwner, List<Binding>.asSlice(&inferred),
              caller, expression, false, &run cursorAnchor(cursor))
            failed = run matchArgumentRegions(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, caller, &parameterType,
              &pattern, &actual, &target.signature, &freshOwner, List<Shared<DeclarationId>>.asSlice(&variables), &mut inferred,
              explicitOrdinals, constraints, List<BodyNode>.asSlice(&nodes.*), operand.memberSpan, operand.memberSpan, false)
          } else {
            failed = run matchReceiverOperand(&mut resolver.*, &mut owner.*, &mut dependencies.*, module,
              List<BodyNode>.asSlice(&nodes.*), &operand, &parameterType, &freshOwner, caller,
              List<Shared<DeclarationId>>.asSlice(&variables), explicitOrdinals, &mut inferred, constraints)
          }
          if let Option<Shared<Rejection>>.Some {value} = move failed {
            return Result<BodyNodeId, Shared<Rejection>>.failResult(move value)
          }
          run List<BodyNodeId>.append(&mut typedArguments, operand.node)
          at = at + usize.ONE
          continue
        }
      }
      let argumentId = run bodyArgument(&resolver.source, cursor, arguments, at - receiverCount)
      let noCaptures = List<Shared<Type>>.make()
      let argument = run checkInferredCallArgument(&mut resolver.*, &mut owner.*, &mut request.*,
        &mut dependencies.*, module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*,
        &mut requiredBodies.*, argumentId, &parameterType, &inference, List<Shared<Type>>.asSlice(&noCaptures), &freshOwner,
        List<Shared<DeclarationId>>.asSlice(&variables), explicitOrdinals, target.explicitSyntax,
        &mut inferred, expression, span,
        constraints, contractBody, staticBody, unsafeAllowed,
      )
      match move argument {
        Result<BodyNodeId, Shared<Rejection>>.Success {value: node} => {
          let checked = List<BodyNode>.asSlice(&nodes.*)
          let evidence = match & checked[node.index].kind {
            BodyNodeKind.Expression {ty: argumentType, ..} => Shared<Type>.clone(&argumentType)
            _ => {
              return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
            }
          }
          if !contractBody && !staticBody && !Shared<Type>.with<bool>(&evidence, runtimeType) {
            return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
          }
          run List<BodyNodeId>.append(&mut typedArguments, node)
        }
        Result<BodyNodeId, Shared<Rejection>>.Failure {error} => {
          return Result<BodyNodeId, Shared<Rejection>>.failResult(move error)
        }
      }
    } else {
      return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
    }
    at = at + usize.ONE
  }
  // A whole generic function used where its exact type `typeof(f<...>)` is expected takes the
  // binders that type names; the value is still compared with the expected type.
  if valueConstruction && actualCount == usize.ZERO && List<Binding>.length(&inferred) == usize.ZERO && target.prefixLifetimes == usize.ZERO {
    run bindExpectedApplication(expected, &target.declaration, &callOwner, originalBinderCount, &mut inferred)
  }
  if valueConstruction && List<Binding>.length(&inferred) < binderCount {
    run inferFromPromisedContract(&inference, &freshOwner, promised, &mut inferred)
  }
  if valueConstruction && run promisedInvocationEscape(&inference, &freshOwner, List<Binding>.asSlice(&inferred), promised) {
    // A written contract is incompatible at the operand (CALLABLE-001). A contract the call infers
    // fails as that call's lifetime relation (LIFE-002) where the value could not defer the
    // region to a later invocation; otherwise the call's own inference reports it.
    let inferredBy = match &promised.* {
      Option<NamedCallableEvidence>.Some {value} => copySpan(&value.call)
      Option<NamedCallableEvidence>.None => Option<Span>.none()
    }
    match move inferredBy {
      Option<Span>.None => { return run bodyRejection(&resolver.*, module, RejectionCode.IncompatibleCallableSignature, span) }
      Option<Span>.Some {value: callSpan} => {
        if !run sectionLifetimeDeferral(&target.declaration, &inference, List<Binding>.asSlice(&inferred), constraints) {
          return run bodyRejection(&resolver.*, module, RejectionCode.UnsatisfiedLifetimeBound, callSpan)
        }
      }
    }
  }
  if List<Binding>.length(&inferred) < binderCount {
    let inferredFromProvider = run inferFromProviderBounds(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies.*,
      module,
      &inference,
      &callOwner,
      constraints,
      &mut inferred,
      span,
    )
    if let Option<Shared<Rejection>>.Some {value} = move inferredFromProvider {
      return Result<BodyNodeId, Shared<Rejection>>.failResult(move value)
    }
  }
  if List<Binding>.length(&inferred) < binderCount {
    let selectedKeys = run inferProvidedSelectors(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies.*,
      module,
      &inference,
      &callOwner,
      &freshOwner,
      constraints,
      &mut inferred,
      span,
    )
    if let Option<Shared<Rejection>>.Some {value} = move selectedKeys {
      return Result<BodyNodeId, Shared<Rejection>>.failResult(move value)
    }
  }
  // An `effect<'env> fn` environment that no parameter mentions is inferred from what the call
  // captures (lifetimes reference): the region a borrowed argument retains, else 'static. A
  // section, including a whole generic `effect fn` used as a value, has not captured its remaining
  // operands yet: a binder they mention stays open for the invocation, and any other environment
  // binder is fixed by the supplied suffix the same way.
  let mut environmentAt = usize.ZERO
  let mut pendingTypes = List<usize>.make()
  let mut pendingLifetimes = List<usize>.make()
  let mut pendingRows = List<usize>.make()
  if parameterOffset != usize.ZERO && !run sectionEvidence(&inference, &freshOwner, List<Binding>.asSlice(&inferred),
    List<usize>.asSlice(&open), &mut pendingTypes, &mut pendingLifetimes, &mut pendingRows) {
    environmentAt = originalBinderCount
  }
  while environmentAt < originalBinderCount {
    let open = match move bindingArgumentAt(List<Binding>.asSlice(&inferred), environmentAt) {
      Option<Argument>.Some {..} => false
      Option<Argument>.None => !containsOrdinal(&pendingLifetimes, environmentAt) && Shared<Result<Answer, NoRejection>>.with<bool>(&inference,
        fn(answer: &Result<Answer, NoRejection>) -> bool { return signatureEnvironmentBinder(answer, environmentAt) })
    }
    if open {
      let region = match move capturedRegion(List<BodyNode>.asSlice(&nodes.*), List<BodyNodeId>.asSlice(&typedArguments)) {
        Option<Shared<Lifetime>>.Some {value} => move value
        Option<Shared<Lifetime>>.None => run Shared<Lifetime>.make(Lifetime.Static)
      }
      run List<Binding>.append(&mut inferred, Binding {
        declaration: Shared<DeclarationId>.clone(&callOwner), ordinal: environmentAt,
        value: Argument.Lifetime {value: move region},
      })
    }
    environmentAt = environmentAt + usize.ONE
  }
  // Only a binder that nothing but the call's use fixed, and that use left 'static, may shorten.
  let mut defaultedOrdinals = List<usize>.make()
  if parameterOffset == usize.ZERO && !valueConstruction && !bound {
    run bindUseLifetimes(&inference, &freshOwner, &callOwner, originalBinderCount, expected, effectTarget, &mut inferred,
      &mut defaultedOrdinals)
  }
  if target.prefixLifetimes != usize.ZERO {
    run bindCallPrefixResult(&inference, &freshOwner, originalBinderCount, binderCount, expected, effectTarget, &mut inferred)
    run bindOutcomeCallPrefixRegions(&inference, &freshOwner, caller, run originAt(cursor, expression, span), originalBinderCount, binderCount, &mut inferred)
    if parameterOffset != usize.ZERO {
      run localizeSectionCallPrefixRegions(&inference, &freshOwner, caller, expression, originalBinderCount,
        List<usize>.asSlice(&open), &mut inferred, &run cursorAnchor(cursor))
    }
    inferred = match move run closeCallPrefixBindings(List<Binding>.asSlice(&inferred), &freshOwner,
      &target.prefixOwner, originalBinderCount, binderCount) {
      Option<List<Binding>>.Some {value} => move value
      Option<List<Binding>>.None => {
        return run bodyRejection(&resolver.*, module, RejectionCode.BodyLifetimeElisionUnavailable, span)
      }
    }
  }
  if target.prefixLifetimes != usize.ZERO {
    let scoped = List<Argument>.asSlice(&target.scopeArguments)
    let mut scopeAt = usize.ZERO
    while scopeAt < scoped.length {
      if run argumentMentionsOwner(&scoped[scopeAt], &freshOwner) {
        return run bodyRejection(&resolver.*, module, RejectionCode.UninferredParameter, span)
      }
      if let Option<Shared<DeclarationId>>.Some {value: template} = &target.prefixOwner {
        let pending = DeclarationId.copyShared(&template)
        if run argumentMentionsOwner(&scoped[scopeAt], &pending) {
          return run bodyRejection(&resolver.*, module, RejectionCode.BodyLifetimeElisionUnavailable, span)
        }
      }
      scopeAt = scopeAt + usize.ONE
    }
  }
  run boundShortenedBinders(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, &inference, &freshOwner,
    &mut inferred, explicitOrdinals, constraints, caller, expression, span, &run cursorAnchor(cursor))
  // A binder shortens only in a runtime body with an enforced completion proof
  // (`BodyFrame.shortened`). Under several bounds it shortens to the meet of their longer regions,
  // the longest region every bound still proves; the borrow check holds each loan of that meet.
  let shortening = !staticBody && finiteResultBodyFrame(&resolver.*, caller)
  let mut pinnedOrdinals = List<usize>.make()
  let mut pinnedAt = usize.ZERO
  while pinnedAt < originalBinderCount {
    if !shortening || !containsOrdinal(&defaultedOrdinals, pinnedAt) || fixedOrdinal(explicitOrdinals, pinnedAt) {
      run List<usize>.append(&mut pinnedOrdinals, pinnedAt)
    }
    pinnedAt = pinnedAt + usize.ONE
  }
  if run outlivesShortenedBinders(&mut resolver.*, &mut owner.*, &mut dependencies.*, &inference, &freshOwner,
    &mut inferred, List<usize>.asSlice(&pinnedOrdinals), constraints, span) {
    run recordShortened(&mut resolver.*, span)
  }
  if shortening {
    run evidenceShortenedBinders(&mut resolver.*, &mut owner.*, &mut dependencies.*, &inference, &freshOwner,
      &mut inferred, explicitOrdinals, constraints, caller, List<BodyNode>.asSlice(&nodes.*), span)
    if parameterOffset == usize.ZERO {
      run environmentShortenedBinders(&mut resolver.*, &mut owner.*, &mut dependencies.*, &inference, &freshOwner,
        &mut inferred, explicitOrdinals, caller, List<BodyNode>.asSlice(&nodes.*), List<BodyNodeId>.asSlice(&typedArguments), span)
    }
  }
  let mut unresolvedAt = usize.ZERO
  while unresolvedAt < originalBinderCount {
    let evidence = bindingArgumentAt(List<Binding>.asSlice(&inferred), unresolvedAt)
    if let Option<Argument>.None = move evidence {
      if parameterOffset != usize.ZERO {
        return run finishDeferredNamedSection(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
          module, cursor, caller, &mut nodes.*, expression, span, &target.declaration, &target.signature,
          List<Argument>.asSlice(&target.scopeArguments),
          &originalInference, &freshOwner, List<Binding>.asSlice(&inferred), List<usize>.asSlice(&open), firstSupplied,
          move typedArguments, run writtenLifetimeBinders(List<CallPrefixSlot>.asSlice(&target.explicitSlots),
            List<Argument>.asSlice(&target.explicit), &target.declaration),
          constraints, expected, mismatchCode, contractBody, sectionContext(expected, valueConstruction))
      }
      // Without a written type-argument prefix the call as a whole is uninferable (SEM0052); an
      // explicit prefix leaves one named parameter undetermined (SEM0099).
      let wholeCall = Shared<Result<Answer, NoRejection>>.with<bool>(&target.signature, wholeCallInference)
      if !target.explicitSyntax && wholeCall {
        return Result<BodyNodeId, Shared<Rejection>>.failResult(run inferenceRejection(
          &resolver.*, module, cursor, expression, span, receiver, &target.declaration))
      }
      return run bodyRejection(&resolver.*, module, RejectionCode.UninferredParameter, span)
    }
    unresolvedAt = unresolvedAt + usize.ONE
  }
  // Only rigid caller evidence crosses into canonical signature resolution and publication.
  let canonicalOwner = run Shared<DeclarationId>.make(DeclarationId.copy(&target.declaration))
  let completed = List<Binding>.asSlice(&inferred)
  let mut completedAt = usize.ZERO
  while completedAt < completed.length {
    if run argumentMentionsOwner(&completed[completedAt].value, &freshOwner) {
      return run bodyRejection(&resolver.*, module, RejectionCode.UninferredParameter, span)
    }
    completedAt = completedAt + usize.ONE
  }
  // Written arguments are already bindings; skipped lifetimes were inferred beside them.
  let mut specialized = List<Argument>.make()
  let mut specializeAt = usize.ZERO
  while specializeAt < originalBinderCount {
    let evidence = bindingArgumentAt(List<Binding>.asSlice(&inferred), specializeAt)
    match move evidence {
      Option<Argument>.Some {value} => run List<Argument>.append(&mut specialized, move value)
      Option<Argument>.None => {
        return run bodyRejection(&resolver.*, module, RejectionCode.UninferredParameter, span)
      }
    }
    specializeAt = specializeAt + usize.ONE
  }
  let published = List<Argument>.asSlice(&specialized)
  let mut publishedAt = usize.ZERO
  while publishedAt < published.length {
    if run argumentMentionsOwner(&published[publishedAt], &freshOwner) {
      return run bodyRejection(&resolver.*, module, RejectionCode.UninferredParameter, span)
    }
    publishedAt = publishedAt + usize.ONE
  }
  let mut result = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(
    &inference,
    signatureResult,
  )
  let mut failureType = run signatureFailure(&inference)
  let mut requirementRow = run signatureRequirements(&inference)
  let mut directApplication = Option<Application>.none()
  let mut appliedBounds = List<Constraint>.make()
  if originalBinderCount == usize.ZERO {
    let boundCount = Shared<Result<Answer, NoRejection>>.with<usize>(
      &target.signature,
      signatureConstraintCount,
    )
    let mut boundAt = usize.ZERO
    while boundAt < boundCount {
      let bound = Shared<Result<Answer, NoRejection>>.with<Option<Constraint>>(
        &target.signature,
        fn(answer: &Result<Answer, NoRejection>) -> Option<Constraint> {
          return signatureConstraint(answer, boundAt)
        },
      )
      if let Option<Constraint>.Some {value} = move bound {
        run List<Constraint>.append(&mut appliedBounds, move value)
      }
      boundAt = boundAt + usize.ONE
    }
  }
  if originalBinderCount > usize.ZERO {
    let selected = run checkedDirectApplication(
      &mut resolver.*,
      &mut owner.*,
      &mut request.*,
      &mut dependencies.*,
      &target.declaration,
      &target.signature,
      run copyArguments(List<Argument>.asSlice(&specialized)),
      &target.scopeArguments,
      module,
      span,
    )
    directApplication = match move selected {
      Result<Application, Shared<Rejection>>.Success {value} => Option<Application>.some(move value)
      Result<Application, Shared<Rejection>>.Failure {error} => {
        return Result<BodyNodeId, Shared<Rejection>>.failResult(move error)
      }
    }
    let targetModuleOrdinal = knownModuleOrdinal(
      &resolver.*,
      DeclarationId.moduleId(&target.declaration),
    )
    if targetModuleOrdinal == usize.MAX {
      fail InvalidModulePath {}
    }
    let targetModule = resolvedModule(&resolver.*, targetModuleOrdinal)
    let declaration = run ordinalOfIdentity(&mut resolver.*, &targetModule, &canonicalOwner)
    let targetOrdinal = match move declaration {
      Option<usize>.Some {value} => value
      Option<usize>.None => {
        return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
      }
    }
    let declarationAccess131Request = Key {
        family: Family.Signature,
        module: targetModuleOrdinal,
        name: usize.ZERO,
        declaration: targetOrdinal,
        member: usize.ZERO,
        external: false,
      }
    let declarationAccess131 = run internDeclaration(&mut resolver.*, declarationAccess131Request)
    // Resolving the callee's header again under the application gives its signature with the
    // application substituted, so the cached signature is substituted instead. An `effect fn`
    // whose environment is elaborated keeps it only while the application leaves the inputs'
    // retained regions as substitution gives them (`elaboratedEnvironmentHolds`).
    let facts = Shared<Result<Answer, NoRejection>>.with<Option<SignatureFacts>>(&target.signature, signatureFacts)
    let mut substituted = Option<Answer>.none()
    if let Option<SignatureFacts>.Some {value: known} = &facts {
      if !known.isStatic && known.staticSlots == usize.ZERO {
        if let Option<Application>.Some {value: chosen} = &directApplication {
          let bindings = run Application.bindings(&chosen)
          // Only the bounds, parameters, channels and environment are read below, so the
          // callee's own binder lists are left empty.
          let answer = run substitutedSignature(&target.signature, &known, List<Shared<Type>>.make(),
            List<Shared<Lifetime>>.make(), List<RowParameter>.make(), known.callableParameterStart,
            List<Binding>.asSlice(&bindings))
          if !known.isEffect || known.environmentWritten
            || run elaboratedEnvironmentHolds(&target.signature, &known, &answer, &target.declaration, List<Binding>.asSlice(&bindings)) {
            substituted = Option<Answer>.some(move answer)
          }
        }
      }
    }
    let mut applied = match move substituted {
      Option<Answer>.Some {value} => move value
      Option<Answer>.None => run resolveSignatureUnder(
        &mut resolver.*,
        &mut owner.*,
        declarationAccess131,
        List<Dependency>.make(),
        Option<List<Argument>>.none(),
        Option<List<Argument>>.none(),
        &directApplication,
      )
    }
    while List<Dependency>.length(&applied.dependencies) > usize.ZERO {
      let edge = List<Dependency>.remove(&mut applied.dependencies, usize.ZERO)
      run List<Dependency>.append(&mut dependencies.*, move edge)
    }
    match & applied.outcome {
      Outcome.Success {value: Value.Signature {signature}} => {
        if target.prefixLifetimes != usize.ZERO {
          if run signatureMentionsOwner(&signature, &freshOwner) {
            return run bodyRejection(&resolver.*, module, RejectionCode.UninferredParameter, span)
          }
          if let Option<Shared<DeclarationId>>.Some {value: template} = &target.prefixOwner {
            let pending = DeclarationId.copyShared(&template)
            if run signatureMentionsOwner(&signature, &pending) {
              return run bodyRejection(&resolver.*, module, RejectionCode.BodyLifetimeElisionUnavailable, span)
            }
          }
        }
        appliedBounds = run copyConstraints(List<Constraint>.asSlice(&signature.constraints))
        result = Option<Shared<Type>>.some(Shared<Type>.clone(&signature.result))
        failureType = Shared<Type>.clone(&signature.failure)
        requirementRow = Shared<Row>.clone(&signature.requirements)
      }
      Outcome.Rejected {..} => {
        return Result<BodyNodeId, Shared<Rejection>>.failResult(forwardedCause(&applied.outcome))
      }
      Outcome.Unavailable {..} => {
        return Result<BodyNodeId, Shared<Rejection>>.failResult(forwardedCause(&applied.outcome))
      }
      _ => {
        result = Option<Shared<Type>>.none()
      }
    }
  }
  let canonicalBounds = List<Constraint>.asSlice(&appliedBounds)
  let mut boundAt = usize.ZERO
  while boundAt < canonicalBounds.length {
    if run constraintMentionsOwner(&canonicalBounds[boundAt], &freshOwner) {
      return run bodyRejection(&resolver.*, module, RejectionCode.UninferredParameter, span)
    }
    boundAt = boundAt + usize.ONE
  }
  let declaredBounds = run copyConstraints(constraints)
  let failed = run proveAppliedBounds(&mut resolver.*, &mut owner.*, &mut dependencies.*, &declaredBounds,
    List<Constraint>.asSlice(&appliedBounds), module, span, RegionProof.RegionCheck)
  if let Option<Shared<Rejection>>.Some {value} = move failed {
    return Result<BodyNodeId, Shared<Rejection>>.failResult(move value)
  }
  let callResult = match move result {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => {
      return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
    }
  }
  let mut ownedTypes = List<usize>.make()
  let mut ownedLifetimes = List<usize>.make()
  let mut ownedRows = List<usize>.make()
  run Type.collectOwned(
    &callResult,
    &freshOwner,
    &mut ownedTypes,
    &mut ownedLifetimes,
    &mut ownedRows,
  )
  run Type.collectOwned(&failureType, &freshOwner, &mut ownedTypes, &mut ownedLifetimes, &mut ownedRows)
  run Type.collectOwnedRow(&requirementRow, &freshOwner, &mut ownedTypes, &mut ownedLifetimes, &mut ownedRows)
  if List<usize>.length(&ownedTypes) > usize.ZERO || List<usize>.length(&ownedLifetimes) > usize.ZERO || List<
    usize,
  >.length(&ownedRows) > usize.ZERO {
    return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
  }
  ty = move callResult
  if !staticBody && Shared<Type>.with<bool>(&ty, effectStorageType) {
    return run bodyRejection(&resolver.*, module, RejectionCode.EffectFormUnavailable, span)
  }
  if !contractBody && !staticBody && !Shared<Type>.with<bool>(&ty, runtimeType) {
    return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
  }
  run List<SignatureDependency>.append(
    &mut signatures.*,
    SignatureDependency {declaration: DeclarationId.copy(&target.declaration)},
  )
  if foreignCall {
    form = BodyExpression.ForeignCall {declaration: DeclarationId.copy(&target.declaration), arguments: move typedArguments,
      variadicArguments: run Shared<List<CAbi.VariadicArgument>>.make(move variadicArguments),
    }
  } else {
    run List<DeclarationId>.append(
      &mut requiredBodies.*,
      DeclarationId.copy(&target.declaration),
    )
    let mustSelectApplication = match & directApplication {
      Option<Application>.Some {..} => false
      Option<Application>.None => true
    }
    if mustSelectApplication {
      let selected = run checkedDirectApplication(
        &mut resolver.*,
        &mut owner.*,
        &mut request.*,
        &mut dependencies.*,
        &target.declaration,
        &target.signature,
        move specialized,
        &target.scopeArguments,
        module,
        span,
      )
      directApplication = match move selected {
        Result<Application, Shared<Rejection>>.Success {value} => Option<Application>.some(
          move value,
        )
        Result<Application, Shared<Rejection>>.Failure {error} => {
          return Result<BodyNodeId, Shared<Rejection>>.failResult(move error)
        }
      }
    }
    let mut application = match move directApplication {
      Option<Application>.Some {value} => move value
      Option<Application>.None => {
        return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
      }
    }
    if let Option<Shared<List<StaticSlot>>>.Some {value: slots} = &suppliedStatics {
      application.statics = run copySharedStaticSlots(&slots)
      let retyped = List<StaticSlot>.asSlice(&retypedStatics)
      let held = List<StaticSlot>.asMutSlice(&mut application.statics)
      let mut slotAt = usize.ZERO
      while slotAt < held.length {
        let mut retypedAt = usize.ZERO
        while retypedAt < retyped.length {
          if retyped[retypedAt].ordinal == held[slotAt].ordinal { held[slotAt].value = StaticValue.copy(&retyped[retypedAt].value) }
          retypedAt = retypedAt + usize.ONE
        }
        slotAt = slotAt + usize.ONE
      }
    }
    if run Type.containsOpaque(&ty, &target.declaration) {
      ty = run Type.finishOpaqueApplication(&ty, &application)
    }
    if parameterOffset > usize.ZERO || valueConstruction || bound {
      // Dense inference slots do not retain enclosing binder ownership. The closed application
      // retains the original function and owner slots needed by the visible section contract.
      let sectionBindings = run Application.bindings(&application)
      let mut sectionResult = Shared<Type>.clone(&ty)
      if effectTarget {
        sectionResult = match move run effectValueResult(&mut resolver.*, &mut owner.*, &mut dependencies.*,
          &target.signature, List<Binding>.asSlice(&sectionBindings), move ty,
          run Type.applyBindings(&failureType, List<Binding>.asSlice(&inferred), true),
          run Row.applyBindings(&requirementRow, List<Binding>.asSlice(&inferred), true), constraints, span) {
          Result<Shared<Type>, Shared<Rejection>>.Success {value} => move value
          Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move error) }
        }
      }
      let declared = run signatureParameterTypes(&target.signature)
      let kept = run keptArguments(&mut resolver.*, &mut owner.*, &mut dependencies.*, &target.signature,
        List<Binding>.asSlice(&sectionBindings), List<Shared<Type>>.length(&declared), true, caller, span)
      return run finishNamedSection(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor, caller,
        &mut nodes.*, expression, span, &target.signature, List<Binding>.asSlice(&sectionBindings), move kept, true,
        NamedSectionTarget.Application {value: move application, isPublic: target.isPublic}, List<usize>.asSlice(&open),
        firstSupplied, move typedArguments, move sectionResult, run writtenLifetimeBinders(List<CallPrefixSlot>.asSlice(&target.explicitSlots),
          List<Argument>.asSlice(&target.explicit), &target.declaration), constraints, expected, mismatchCode, contractBody,
      )
    }
    if effectTarget {
      // Calling an `effect fn` constructs an Effect whose exact representation is this
      // application with its written arguments as stored fields (EFF-001, REP-001).
      let construction = run effectConstruction(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, caller,
        List<BodyNode>.asSlice(&nodes.*), &application, List<BodyNodeId>.asSlice(&typedArguments), move ty,
        move failureType, move requirementRow, constraints, run anchoredNode(cursor, expression), target.isPublic, span)
      ty = match move construction {
        Result<Shared<Type>, Shared<Rejection>>.Success {value} => move value
        Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move error) }
      }
    }
    if !effectTarget && Shared<Type>.with<bool>(&ty, rawCallableType) {
      ty = match move run callableResultType(&mut resolver.*, &mut owner.*, &mut dependencies.*, &application, constraints, span) {
        Result<Shared<Type>, Shared<Rejection>>.Success {value} => move value
        Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move error) }
      }
    }
    let mut receiverPass = Option<BodyReceiverPass>.none()
    if let Option<CallReceiver>.Some {value: operand} = &receiver.* { receiverPass = Option<BodyReceiverPass>.some(operand.pass) }
    let applied = run Application.bindings(&application)
    let kept = run keptArguments(&mut resolver.*, &mut owner.*, &mut dependencies.*, &target.signature, List<Binding>.asSlice(&applied),
      List<BodyNodeId>.length(&typedArguments), true, caller, span)
    // Each argument's parameter type under the arguments the source wrote for the call: its own
    // generics, and its owner's when a qualifier writes them. Every other binder is neutralized, a
    // lifetime to 'static and a row to the empty row. An unwritten type becomes `()` where the
    // parameter type names it only beneath views, whose well-formedness already bounds it by their
    // regions, and `&'static ()` where it names it elsewhere. So a parameter type names only
    // universal lifetime parameters exactly when its written arguments and its views do, and only
    // then can it pin its argument.
    let mut written = List<Shared<Type>>.make()
    let ownWritten = run writtenCallBindings(List<CallPrefixSlot>.asSlice(&target.explicitSlots), List<Argument>.asSlice(&target.explicit))
    let unit = run Types.intern(Type.Unit)
    // An owner the call infers was not written, as for a lent receiver with a written list: that
    // list binds only the member's own binders, so the owner's are neutralized with the unwritten.
    let viewed = run writtenCallApplication(List<Binding>.asSlice(&applied), List<Binding>.asSlice(&ownWritten),
      &target.declaration, !target.inferOwner, &unit)
    let staticUnit = run Types.intern(Type.Reference {referent: Shared<Type>.clone(&unit), access: Access.Shared,
      lifetime: run Shared<Lifetime>.make(Lifetime.Static)})
    let chosen = run writtenCallApplication(List<Binding>.asSlice(&applied), List<Binding>.asSlice(&ownWritten),
      &target.declaration, !target.inferOwner, &staticUnit)
    let unwritten = run unwrittenCallTypes(List<Binding>.asSlice(&applied), List<Binding>.asSlice(&ownWritten),
      &target.declaration, !target.inferOwner)
    let count = List<BodyNodeId>.length(&typedArguments)
    let mut at = usize.ZERO
    while at < count {
      let parameter = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(&target.signature,
        fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> { return signatureParameterAt(answer, at) })
      if let Option<Shared<Type>>.Some {value: declared} = &parameter {
        let mut bindings = List<Binding>.asSlice(&viewed)
        if Type.namesParameterOutsideView(&declared, List<Binding>.asSlice(&unwritten)) { bindings = List<Binding>.asSlice(&chosen) }
        run List<Shared<Type>>.append(&mut written, run Type.applyBindings(&declared, bindings, true))
      }
      at = at + usize.ONE
    }
    if List<Shared<Type>>.length(&written) != count { written = List<Shared<Type>>.make() }
    form = BodyExpression.DirectCall {
      written: move written,
      writtenLifetimes: run Shared<List<usize>>.make(run writtenLifetimeBinders(List<CallPrefixSlot>.asSlice(&target.explicitSlots),
        List<Argument>.asSlice(&target.explicit), &target.declaration)),
      declaration: DeclarationId.copy(&target.declaration),
      application: run Shared<Application>.make(move application),
      receiverPass: move receiverPass,
      constructs: effectTarget,
      arguments: move typedArguments,
      kept: move kept,
    }
  }
  return run finishExpression(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor, caller, constraints, &mut nodes.*,
    expression, span, move ty, move form,
    false, expected, mismatchCode, contractBody, staticBody,
  )
}


// An `effect fn` value or section promises the Effect its invocation constructs (EFF-001), whose
// run access follows its parameters exactly as a written construction's (EFFECT-OWN-002). A
// section's captured regions join the environment when the section is finished (LIFE-004).
effect fn effectValueResult(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, signature: &Shared<Result<Answer, NoRejection>>, bindings: &[Binding],
  success: Shared<Type>, failure: Shared<Type>, requirements: Shared<Row>, constraints: &[Constraint], span: Span)
  -> Result<Shared<Type>, Shared<Rejection>> ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let written = run signatureParameterTypes(signature)
  let declared = List<Shared<Type>>.asSlice(&written)
  let mut applied = List<Shared<Type>>.make()
  let mut at = usize.ZERO
  while at < declared.length {
    run List<Shared<Type>>.append(&mut applied, run Type.applyBindings(&declared[at], bindings, true))
    at = at + usize.ONE
  }
  let runMode = match move run storedRunMode(&mut resolver.*, &mut owner.*, &mut dependencies.*,
    List<Shared<Type>>.asSlice(&applied), constraints, span) {
    Result<CallableMode, Shared<Rejection>>.Success {value} => value
    Result<CallableMode, Shared<Rejection>>.Failure {error} => { return Result<Shared<Type>, Shared<Rejection>>.failResult(move error) }
  }
  return Result<Shared<Type>, Shared<Rejection>>.succeed(run Types.intern(Type.Effect {mode: runMode,
    environment: run Shared<Intersection>.make(Intersection {members: List<LifetimeMember>.make()}),
    success: move success, failure: move failure, requirements: move requirements}))
}

// The Effect a section constructs stores its captured arguments, so it retains their regions.
effect fn capturedEffectResult(result: Shared<Type>, regions: &[Shared<Lifetime>]) -> Shared<Type>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  if regions.length == usize.ZERO { return move result }
  return match move run Type.copy(&result) {
    Type.Effect {mode, success, failure, requirements, ..} => run Types.intern(Type.Effect {mode: mode,
      environment: run Shared<Intersection>.make(run Intersection.of(regions)), success: move success,
      failure: move failure, requirements: move requirements})
    _ => move result
  }
}

// The Effect contract one `effect fn` call constructs, with the stored arguments that decide it.
struct EffectConstruction {
  contract: Shared<Type>,
  captures: List<Shared<Type>>,
  fieldInputs: List<CallableFieldInput>,
}

// The exact Effect constructed by calling an `effect fn`: its stored arguments decide the run
// access and retained environment exactly as a section's supplied arguments do.
effect fn effectConstruction(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, module: &ModuleId, caller: &DeclarationId, nodes: &[BodyNode],
  application: &Application, arguments: &[BodyNodeId], success: Shared<Type>, failure: Shared<Type>,
  requirements: Shared<Row>, constraints: &[Constraint], site: usize, isPublic: bool, span: Span) -> Result<Shared<Type>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let constructed = run constructEffect(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, caller, nodes,
    arguments, move success, move failure, move requirements, constraints, site, span)
  let built = match move constructed {
    Result<EffectConstruction, Shared<Rejection>>.Success {value} => move value
    Result<EffectConstruction, Shared<Rejection>>.Failure {error} => { return Result<Shared<Type>, Shared<Rejection>>.failResult(move error) }
  }
  let EffectConstruction {contract, captures, fieldInputs} = move built
  let inputs = run originalFieldInputs(application, List<CallableFieldInput>.asSlice(&fieldInputs))
  let target = run Shared<Application>.make(run Application.copy(application))
  return Result<Shared<Type>, Shared<Rejection>>.succeed(run Type.callableValue(isPublic, move target, move contract, move captures, move inputs))
}

// A static argument is part of the application, never a stored field, so each stored argument
// names its target parameter by original ordinal, after the static slots that precede it.
effect fn originalFieldInputs(application: &Application, inputs: &[CallableFieldInput]) -> List<CallableFieldInput>
! OutOfMemoryError ? &mut Allocator {
  let statics = List<StaticSlot>.asSlice(&application.statics)
  let mut mapped = List<CallableFieldInput>.make()
  let mut at = usize.ZERO
  while at < inputs.length {
    let mut input = inputs[at]
    if let CallableFieldInput.Argument {parameter} = inputs[at] {
      input = CallableFieldInput.Argument {parameter: runtimeLaneOrdinal(statics, parameter)}
    }
    run List<CallableFieldInput>.append(&mut mapped, input)
    at = at + usize.ONE
  }
  return move mapped
}

// The original parameter ordinal of the runtime lane `lane`, skipping static parameters.
fn runtimeLaneOrdinal(statics: &[StaticSlot], lane: usize) -> usize {
  let mut ordinal = usize.ZERO
  let mut remaining = lane
  while true {
    if !staticOrdinal(statics, ordinal) {
      if remaining == usize.ZERO { return ordinal }
      remaining = remaining - usize.ONE
    }
    ordinal = ordinal + usize.ONE
  }
  return ordinal
}

fn staticOrdinal(statics: &[StaticSlot], ordinal: usize) -> bool {
  let mut at = usize.ZERO
  while at < statics.length {
    if statics[at].ordinal == ordinal { return true }
    at = at + usize.ONE
  }
  return false
}

// The Effect contract a call stores its written arguments into, before any representation
// names the target that will run it.
effect fn constructEffect(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, module: &ModuleId, caller: &DeclarationId, nodes: &[BodyNode],
  arguments: &[BodyNodeId], success: Shared<Type>, failure: Shared<Type>, requirements: Shared<Row>,
  constraints: &[Constraint], site: usize, span: Span) -> Result<EffectConstruction, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut stored = List<StoredArgument>.make()
  let mut at = usize.ZERO
  while at < arguments.length {
    let ty = match move bodyExpressionType(nodes, &arguments[at]) {
      Option<Shared<Type>>.Some {value} => move value
      _ => { return Result<EffectConstruction, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Unsupported, span)) }
    }
    run List<StoredArgument>.append(&mut stored, StoredArgument {ty: move ty, moved: movedBodyValue(nodes, arguments[at]),
      input: CallableFieldInput.Argument {parameter: at}})
    at = at + usize.ONE
  }
  return run storedEffect(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, caller,
    List<StoredArgument>.asSlice(&stored), move success, move failure, move requirements, constraints, site, span)
}

// One target argument an Effect construction stores, and whether its place was moved into it.
struct StoredArgument {
  ty: Shared<Type>,
  moved: bool,
  input: CallableFieldInput,
}

// The exact Effect contract over the target arguments a construction stores in parameter order:
// a stored exclusive loan makes its run exclusive and a stored affine value makes it once
// (EFFECT-OWN-002), and it retains every stored region (LIFE-004).
effect fn storedEffect(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, module: &ModuleId, caller: &DeclarationId, arguments: &[StoredArgument],
  success: Shared<Type>, failure: Shared<Type>, requirements: Shared<Row>, constraints: &[Constraint], site: usize,
  span: Span) -> Result<EffectConstruction, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut mode = CallableMode.Shared
  let mut captures = List<Shared<Type>>.make()
  let mut fieldInputs = List<CallableFieldInput>.make()
  let mut regions = List<Shared<Lifetime>>.make()
  let mut at = usize.ZERO
  while at < arguments.length {
    let ty = Shared<Type>.clone(&arguments[at].ty)
    let mutableReference = Shared<Type>.with<bool>(&ty, fn(value: &Type) -> bool {
      return match &value.* { Type.Reference {access, ..} => access == Access.Mutable
        Type.Slice {access, ..} => access == Access.Mutable _ => false }
    })
    if mutableReference && !arguments[at].moved {
      if mode == CallableMode.Shared { mode = CallableMode.Mutable }
    } else {
      let copied = run copyType(&mut resolver.*, &mut owner.*, &mut dependencies.*, &ty, constraints, span)
      match move copied {
        Result<bool, Shared<Rejection>>.Success {value} => { if !value { mode = CallableMode.Once } }
        Result<bool, Shared<Rejection>>.Failure {error} => { return Result<EffectConstruction, Shared<Rejection>>.failResult(move error) }
      }
    }
    if !run captureRetainedRegions(&ty, caller, site, constraints, &mut regions) {
      return Result<EffectConstruction, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Unsupported, span))
    }
    run List<Shared<Type>>.append(&mut captures, move ty)
    run List<CallableFieldInput>.append(&mut fieldInputs, arguments[at].input)
    at = at + usize.ONE
  }
  let contract = run Types.intern(Type.Effect {mode: mode,
    environment: run Shared<Intersection>.make(run Intersection.of(List<Shared<Lifetime>>.asSlice(&regions))),
    success: move success, failure: move failure, requirements: move requirements})
  return Result<EffectConstruction, Shared<Rejection>>.succeed(EffectConstruction {contract: move contract, captures: move captures,
    fieldInputs: move fieldInputs})
}

// A named section stores its supplied arguments in written capture order, filling the target
// parameters from `first`. Its target remains the ordinary function application; the `open`
// parameters are the visible invocation contract. `written` are the target's own lifetime binders
// whose arguments the source wrote.
effect fn finishNamedSection(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, module: &ModuleId, cursor: &AuthoredCursor, caller: &DeclarationId,
  nodes: &mut List<BodyNode>, expression: HirId, span: Span,
  signature: &Shared<Result<Answer, NoRejection>>, bindings: &[Binding], kept: Shared<List<KeptRegions>>, closed: bool, target: NamedSectionTarget,
  open: &[usize], first: usize, arguments: List<BodyNodeId>, result: Shared<Type>, written: List<usize>, constraints: &[Constraint],
  expected: &Option<Shared<Type>>, mismatchCode: RejectionCode, contractBody: bool) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut mode = CallableMode.Shared
  let mut captures = List<Shared<Type>>.make()
  let mut fieldInputs = List<CallableFieldInput>.make()
  let mut fields = List<BodyAggregateField>.make()
  let mut regions = List<Shared<Lifetime>>.make()
  let supplied = List<BodyNodeId>.asSlice(&arguments)
  let mut at = usize.ZERO
  while at < supplied.length {
    let ty = match move bodyExpressionType(List<BodyNode>.asSlice(&nodes.*), &supplied[at]) {
      Option<Shared<Type>>.Some {value} => move value
      _ => { return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span) }
    }
    let mutableReference = Shared<Type>.with<bool>(&ty, fn(value: &Type) -> bool {
      return match &value.* { Type.Reference {access, ..} => access == Access.Mutable
        Type.Slice {access, ..} => access == Access.Mutable _ => false }
    })
    if mutableReference && !movedBodyValue(List<BodyNode>.asSlice(&nodes.*), supplied[at]) {
      if mode == CallableMode.Shared { mode = CallableMode.Mutable }
    } else {
      let copied = run copyType(&mut resolver.*, &mut owner.*, &mut dependencies.*, &ty, constraints, span)
      match move copied {
        Result<bool, Shared<Rejection>>.Success {value} => { if !value { mode = CallableMode.Once } }
        Result<bool, Shared<Rejection>>.Failure {error} => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move error) }
      }
    }
    if !run captureRetainedRegions(&ty, caller, run anchoredNode(cursor, expression), constraints, &mut regions) {
      return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
    }
    run List<Shared<Type>>.append(&mut captures, move ty)
    run List<CallableFieldInput>.append(&mut fieldInputs, CallableFieldInput.Argument {parameter: first + at})
    run List<BodyAggregateField>.append(&mut fields, BodyAggregateField {index: at, value: supplied[at]})
    at = at + usize.ONE
  }
  let mut parameters = List<Shared<Type>>.make()
  let mut parameterAt = usize.ZERO
  while parameterAt < open.length {
    let ordinal = open[parameterAt]
    let selected = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(signature,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> { return signatureParameter(answer, ordinal) })
    if let Option<Shared<Type>>.Some {value} = move selected {
      run List<Shared<Type>>.append(&mut parameters, run Type.applyBindings(&value, bindings, true))
    } else { return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span) }
    parameterAt = parameterAt + usize.ONE
  }
  let contract = run Types.intern(Type.Callable {mode: mode,
    isUnsafe: Shared<Result<Answer, NoRejection>>.with<bool>(signature, signatureUnsafe),
    environment: run Shared<Intersection>.make(run Intersection.of(List<Shared<Lifetime>>.asSlice(&regions))),
    invocationBinders: usize.ZERO, invocationUse: usize.MAX, invocationBounds: List<Outlives>.make(),
    parameters: move parameters, result: run capturedEffectResult(move result, List<Shared<Lifetime>>.asSlice(&regions))})
  let ty = match move target {
    NamedSectionTarget.Application {value, isPublic} => run Type.callableValue(isPublic, run Shared<Application>.make(move value), move contract, move captures, move fieldInputs)
    NamedSectionTarget.Schema {target: identity, selected, deferred} => run Type.callableSchema(
      run Shared<SectionSchema>.make(SectionSchema {target: move identity, contract: move contract,
        selected: move selected, deferred: move deferred}), move captures, move fieldInputs)
  }
  return run finishExpression(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor, caller, constraints, &mut nodes.*,
    expression, span, move ty,
    BodyExpression.Aggregate {fields: move fields, written: List<Shared<Lifetime>>.make(), section: Option<SectionRetention>.some(SectionRetention {kept: move kept, first: first, closed: closed,
      written: run Shared<List<usize>>.make(move written)})}, false, expected, mismatchCode, contractBody, false)
}

effect fn finishExpression(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, dependencies: &mut List<Dependency>,
  module: &ModuleId, cursor: &AuthoredCursor, caller: &DeclarationId, constraints: &[Constraint], nodes: &mut List<BodyNode>, expression: HirId, span: Span,
  ty: Shared<Type>, form: BodyExpression, diverges: bool, expected: &Option<Shared<Type>>, mismatchCode: RejectionCode,
  contractBody: bool, staticBody: bool,
) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  if !diverges {
    if let Option<Shared<Type>>.Some {value} = &expected.* {
      if !run Type.equalsShared(&ty, &value) {
        let rawIndex = List<BodyNode>.length(&nodes.*)
        run List<BodyNode>.append(&mut nodes.*, BodyNode {
          origin: run originAt(cursor, expression, span), kind: BodyNodeKind.Expression {ty: move ty, form: move form},
        })
        return run checkExpectedValue(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, caller, constraints, &mut nodes.*,
          BodyNodeId {index: rawIndex}, expected, mismatchCode, span)
      }
    }
  }
  let index = List<BodyNode>.length(&nodes.*)
  run List<BodyNode>.append(
    &mut nodes.*,
    BodyNode {
      origin: run originAt(cursor, expression, span),
      kind: BodyNodeKind.Expression {ty: move ty, form: move form},
    },
  )
  return Result<BodyNodeId, Shared<Rejection>>.succeed(BodyNodeId {index: index})
}

fn bodyHasLoans(nodes: &[BodyNode]) -> bool {
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {ty, form} = &nodes[at].kind {
      if !Shared<Type>.with<bool>(&ty, scalarType) {
        return true
      }
      if let BodyExpression.Dereference {..} = &form {
        return true
      }
    }
    at = at + usize.ONE
  }
  return false
}

fn bodyHasReceiverPass(nodes: &[BodyNode]) -> bool {
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {form, ..} = &nodes[at].kind {
      match & form {
        BodyExpression.DirectCall {receiverPass, ..} => {
          if let Option<BodyReceiverPass>.Some {..} = &receiverPass {
            return true
          }
        }
        BodyExpression.InterfaceCall {receiverPass, ..} => {
          if let Option<BodyReceiverPass>.Some {..} = &receiverPass {
            return true
          }
        }
        _ => ()
      }
    }
    at = at + usize.ONE
  }
  return false
}

// How a borrowed-view loan accesses its place, as OWN0010 names it; capitalized to open a message.
fn loanAccess(exclusive: bool, leading: bool) -> &'static [u8] {
  if exclusive && leading { return b"A mutable" }
  if exclusive { return b"mutable" }
  if leading { return b"A shared" }
  return b"shared"
}

effect fn rejectedBody(diagnostic: Shared<Rejection>, dependencies: List<Dependency>) -> Answer
! OutOfMemoryError ? &mut Allocator {
  return Answer {
    outcome: run rejectedOutcome(move diagnostic),
    dependencies: move dependencies,
  }
}

// A rejected body that reports several diagnostics of its own, in the order checking found them.
fn rejectedBodyDiagnostics(diagnostics: List<Shared<Rejection>>, dependencies: List<Dependency>) -> Answer {
  return partialBodyDiagnostics(move diagnostics, Option<Shared<TypedBody>>.none(), move dependencies)
}

// A rejected body's diagnostics with what an editor reads of the statements it still checked.
fn partialBodyDiagnostics(diagnostics: List<Shared<Rejection>>, partial: Option<Shared<TypedBody>>, dependencies: List<Dependency>)
-> Answer {
  let listed = List<Shared<Rejection>>.asSlice(&diagnostics)
  let mut at = usize.ZERO
  while at < listed.length {
    // A read of an unavailable binding is never rendered (Julia's cascade decision).
    if dependentFailure(&listed[at]) { return CompilerBug.panic(b"an answer carries a read of an unavailable binding") }
    at = at + usize.ONE
  }
  return Answer {outcome: Outcome.Rejected {diagnostics: move diagnostics, partial: move partial}, dependencies: move dependencies}
}

fn sameBinderName(hir: &Module, left: HirId, right: HirId) -> bool {
  if let Node.Name {text: leftName} = Module.node(hir, left) {
    if let Node.Name {text: rightName} = Module.node(hir, right) {
      return same(Module.text(hir, leftName), Module.text(hir, rightName))
    }
  }
  return false
}

effect fn bodyNode(source: &SourceIndex, cursor: &AuthoredCursor, id: HirId) -> Node
! RevisionMismatch {
  if let Option<Node>.Some {value} = move SourceIndex.authoredNode(source, cursor, id) {
    return value
  }
  fail RevisionMismatch {}
}

// An operation argument's context. As at a direct call (inferredReferentLifetimes), the operation's
// own regions inside a borrowed referent are inferred from the operand: a referent context would
// carry the operation's stand-ins and compare them invariantly with the operand's regions.
effect fn operationArgumentContext(
  source: &SourceIndex,
  cursor: &AuthoredCursor,
  expression: HirId,
  parameter: &Shared<Type>,
  operation: &DeclarationId,
  caller: &DeclarationId,
) -> Option<Shared<Type>>
! RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  if !Shared<Type>.with<bool>(parameter, runtimeType) || run inferredReferentLifetimes(parameter, operation) {
    return Option<Shared<Type>>.none()
  }
  // As at a direct call, a value operand supplies an operation's own lifetime evidence.
  // Do not compare it with the operation's stand-ins before argument inference runs.
  let borrowing = match run bodyNode(source, cursor, expression) {
    Node.BorrowExpression { .. } => true
    _ => false
  }
  if
    !borrowing {
    let mut types = List<usize>.make()
    let mut lifetimes = List<usize>.make()
    let mut rows = List<usize>.make()
    run Type.collectOwned(parameter, operation, &mut types, &mut lifetimes, &mut rows)
    if List<usize>.length(&lifetimes) > usize.ZERO {
      return Option<Shared<Type>>.none()
    }
  }
  return run referenceArgumentContext(source, cursor, expression, &Option<Shared<Type>>.some(Shared<Type>.clone(parameter)), caller)
}

// Reference arguments supply lifetime evidence to call inference. A written borrow needs
// the parameter's shape for reborrowing, but its region belongs to the caller.
effect fn referenceArgumentContext(
  source: &SourceIndex,
  cursor: &AuthoredCursor,
  expression: HirId,
  context: &Option<Shared<Type>>,
  caller: &DeclarationId,
) -> Option<Shared<Type>>
! RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  if let Option<Shared<Type>>.Some {value: expectedType} = &context.* {
    let isReference = Shared<Type>.with<bool>(
      &expectedType,
      fn(value: &Type) -> bool {
        return match & value.* {
          Type.Reference {..} => true
          Type.Slice {..} => true
          _ => false
        }
      },
    )
    if !isReference {
      return Option<Shared<Type>>.some(Shared<Type>.clone(&expectedType))
    }
    // Slice calls validate the actual loan after conversion in the shared exact unifier. Only a
    // borrowed array literal keeps the slice context, for its element inference.
    if let Option<Shared<Type>>.Some {value: element} = move Type.sliceElement(&expectedType) {
      if let Node.BorrowExpression {operand, ..} = run bodyNode(source, cursor, expression) {
        match run bodyNode(source, cursor, operand) {
          Node.ArrayExpression {..} => { return run callerReferenceType(&expectedType, caller, expression, &run cursorAnchor(cursor), usize.MAX) }
          Node.ArrayRepeatExpression {..} => {
            return run callerReferenceType(&expectedType, caller, expression, &run cursorAnchor(cursor), usize.MAX)
          }
          _ => ()
        }
      }
      return Option<Shared<Type>>.none()
    }
    if let Node.BorrowExpression {..} = run bodyNode(source, cursor, expression) {
      return run callerReferenceType(&expectedType, caller, expression, &run cursorAnchor(cursor), usize.MAX)
    }
  }
  return Option<Shared<Type>>.none()
}

effect fn callerReferenceType(
  expectedType: &Shared<Type>,
  caller: &DeclarationId,
  expression: HirId, anchor: &Anchor, binder: usize,
) -> Option<Shared<Type>> ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let region = run Shared<Lifetime>.make(
    anchoredRegion(anchor, caller, expression, binder),
  )
  let shape = Shared<Type>.with<Option<Type>>(
    expectedType,
    fn(value: &Type) -> Option<Type> {
      return match & value.* {
        Type.Reference {referent, access, ..} => Option<Type>.some(
          Type.Reference {
            referent: Shared<Type>.clone(&referent),
            access: access,
            lifetime: Shared<Lifetime>.clone(&region),
          },
        )
        Type.Slice {element, access, ..} => Option<Type>.some(Type.Slice {
          element: Shared<Type>.clone(&element), access: access, lifetime: Shared<Lifetime>.clone(&region),
        })
        _ => Option<Type>.none()
      }
    },
  )
  if let Option<Type>.Some {value: referenceType} = move shape {
    return Option<Shared<Type>>.some(run Types.intern(move referenceType))
  }
  return Option<Shared<Type>>.none()
}

fn borrowedArraySlice(actual: &Type) -> Option<Type> {
  if let Type.Reference {referent, access, lifetime} = &actual.* {
    return Shared<Type>.with<Option<Type>>(&referent, fn(target: &Type) -> Option<Type> {
      if let Type.Array {element, ..} = &target.* {
        return Option<Type>.some(Type.Slice {
          element: Shared<Type>.clone(&element), access: access,
          lifetime: Shared<Lifetime>.clone(&lifetime),
        })
      }
      return Option<Type>.none()
    })
  }
  return Option<Type>.none()
}

effect fn sliceArgument(nodes: &mut List<BodyNode>, node: BodyNodeId, parameter: &Shared<Type>) -> BodyNodeId
! OutOfMemoryError ? &mut Allocator | &mut Types {
  if let Option<Shared<Type>>.None = move Type.sliceElement(parameter) { return node }
  let actual = match move bodyExpressionType(List<BodyNode>.asSlice(&nodes.*), &node) {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => { return node }
  }
  let shape = Shared<Type>.with<Option<Type>>(&actual, borrowedArraySlice)
  if let Option<Type>.Some {value: candidate} = move shape {
    let source = Shared<Type>.with<Option<Shared<Type>>>(&actual, fn(value: &Type) -> Option<Shared<Type>> {
      if let Type.Reference {referent, ..} = &value.* { return Option<Shared<Type>>.some(Shared<Type>.clone(&referent)) }
      return Option<Shared<Type>>.none()
    })
    if let Option<Shared<Type>>.Some {value: arrayType} = move source {
      if let Option<ArrayShape>.Some {value: array} = move Type.arrayShape(&arrayType) {
        let origin = List<BodyNode>.asSlice(&nodes.*)[node.index].origin
        let index = List<BodyNode>.length(&nodes.*)
        run List<BodyNode>.append(&mut nodes.*, BodyNode {origin: origin, kind: BodyNodeKind.Expression {
          ty: run Types.intern(move candidate), form: BodyExpression.ArraySlice {value: node, count: array.length},
        }})
        return BodyNodeId {index: index}
      }
    }
  }
  return node
}

// Fresh local loans in one inference transaction share one caller-owned region. Reborrows must
// retain their source descriptor's nonlocal lifetime, including a written parameter or Static.
// Any retained source-validity goal follows the same fresh borrow identity as its new type.
effect fn setBorrowRegion(
  nodes: &mut List<BodyNode>, node: BodyNodeId, caller: &DeclarationId, ordinal: usize, binder: usize,
) -> () ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let borrowed = bodyExpressionType(List<BodyNode>.asSlice(&nodes.*), &node)
  if let Option<Shared<Type>>.Some {value} = move borrowed {
    let shape = run Type.copy(&value)
    if let Type.Reference {referent, access, lifetime: previousLifetime} = move shape {
      if !callerLocalRegion(&previousLifetime, caller) { return () }
      let region = run Shared<Lifetime>.make(Lifetime.Local {declaration: DeclarationId.copy(caller), ordinal: ordinal, binder: binder})
      let actual = run Types.intern(Type.Reference {referent: move referent, access: access,
        lifetime: Shared<Lifetime>.clone(&region)})
      let previous = List<BodyNode>.remove(&mut nodes.*, node.index)
      let form = match move previous.kind {
        BodyNodeKind.Expression {form, ty: previousType} => move form
        _ => { return () }
      }
      run List<BodyNode>.insert(&mut nodes.*, node.index, BodyNode {
        origin: previous.origin,
        kind: BodyNodeKind.Expression {ty: move actual, form: move form},
      })
    }
  }
  return ()
}

// Each expected-value boundary carries its own mismatch reason. Nested operands install their
// own expectations, so a propagated error keeps its original reason without span-based relabeling.
// Every immediate expected-value boundary retains the actual node before conversion. Fields and
// selected call results use this same path rather than rejecting qualifiers before the common tail.
// A value that differs from its expectation only in covariant regions meets it by lifetime
// subtyping (`admitsRegions`); the boundary node then carries the expected type, and each
// caller-local relation it could not prove is left to the body's region check.

// More specific type relations own their established reasons even at a return or field boundary.
// Array/index/condition/failure obligations retain their own reason; they are not conversions.
// Admission retries use the relation failure family, independently of its public diagnostic code.
fn valueMismatchReason(code: RejectionCode) -> bool {
  return match code {
    RejectionCode.TypeMismatch => true
    RejectionCode.StructFieldTypeMismatch => true
    RejectionCode.AssignmentTypeMismatch => true
    RejectionCode.ReturnTypeMismatch => true
    RejectionCode.IncompatibleUnionConversion => true
    RejectionCode.WrongEnumMember => true
    RejectionCode.EnumIntegerMismatch => true
    _ => false
  }
}

fn valueMismatchCode(
  actual: &Shared<Type>,
  expected: &Shared<Type>,
  ordinary: RejectionCode
) -> RejectionCode {
  if ordinary != RejectionCode.TypeMismatch && ordinary != RejectionCode.StructFieldTypeMismatch
    && ordinary != RejectionCode.AssignmentTypeMismatch
    && ordinary != RejectionCode.ReturnTypeMismatch {
    return ordinary
  }
  if Shared<Type>.with<bool>(actual, unionType) || Shared<Type>.with<bool>(expected, unionType)
    || Shared<Type>.with<bool>(expected, neverType) {
    return RejectionCode.IncompatibleUnionConversion
  }
  let actualEnum = Shared<Type>.with<OwnerKind>(actual, nominalKind) == OwnerKind.Enumeration
  let expectedEnum = Shared<Type>.with<OwnerKind>(expected, nominalKind) == OwnerKind.Enumeration
  if actualEnum && expectedEnum {
    return RejectionCode.WrongEnumMember
  }
  if (actualEnum && Shared<Type>.with<bool>(expected, integerValueType))
    || (expectedEnum && Shared<Type>.with<bool>(actual, integerValueType)) {
    return RejectionCode.EnumIntegerMismatch
  }
  return ordinary
}

fn integerValueType(value: &Type) -> bool {
  if let Type.Primitive { name } = &value.* {
    let selected = StaticExecution.integerType(Bytes.asSlice(&name))
    return match move selected {
      Option<StaticIntegerType>.Some { .. } => true
      Option<StaticIntegerType>.None => false
    }
  }
  return false
}

effect fn checkExpectedValue(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, dependencies: &mut List<Dependency>,
  module: &ModuleId, caller: &DeclarationId, constraints: &[Constraint], nodes: &mut List<BodyNode>, node: BodyNodeId,
  expected: &Option<Shared<Type>>, mismatchCode: RejectionCode, span: Span,
) -> Result<BodyNodeId, Shared<Rejection>> ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  return run admitExpectedValue(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, caller, constraints,
    &mut nodes.*, node, expected, mismatchCode, span, true, false)
}

// `checkExpectedValue` with the caller choosing whether a caller-local region may meet a region
// the caller does not own under a relation left to the region check (`relateUnowned`), and whether the admission is
// only a `tentative` meet. A view that differs only in its region is admitted unless the meet is
// tentative: that caller falls back from the mismatch to its declared type.
effect fn admitExpectedValue(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, dependencies: &mut List<Dependency>,
  module: &ModuleId, caller: &DeclarationId, constraints: &[Constraint], nodes: &mut List<BodyNode>, node: BodyNodeId,
  expected: &Option<Shared<Type>>, mismatchCode: RejectionCode, span: Span, relateUnowned: bool, tentative: bool,
) -> Result<BodyNodeId, Shared<Rejection>> ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  if let Option<Shared<Type>>.Some {value} = &expected.* {
    let actual = match move bodyExpressionType(List<BodyNode>.asSlice(&nodes.*), &node) {
      Option<Shared<Type>>.Some {value: selected} => move selected
      Option<Shared<Type>>.None => { return run bodyRejection(&resolver.*, module, mismatchCode, span) }
    }
    if Shared<Type>.with<bool>(&actual, neverType) { return Result<BodyNodeId, Shared<Rejection>>.succeed(node) }
    if privateOriginPhase(&resolver.*).phase == usize.ONE && (pendingCallableSelection(&actual) || pendingCallableSelection(&value)) {
      return Result<BodyNodeId, Shared<Rejection>>.succeed(node)
    }
    let wanted = run originComparedType(&resolver.*, &value)
    let offered = run originComparedType(&resolver.*, &actual)
    let publicCallable = Shared<Type>.with<bool>(&value, fn(ty: &Type) -> bool {
      return match &ty.* { Type.Callable {..} => true Type.OpaqueRepresentation {..} => true _ => false }
    })
    if publicCallable {
      let declared = List<Constraint>.make()
      if run unresolvedLocalCallableContents(&actual, List<Constraint>.asSlice(&declared)) {
        return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
      }
    }
    if run Type.equalsShared(&offered, &wanted) { return Result<BodyNodeId, Shared<Rejection>>.succeed(node) }
    // An exact callable whose use contract is the written callable contract keeps its exact
    // type, as it would bound to a parameter of that contract.
    if publicCallable {
      if let Option<Shared<Type>>.Some {value: used} = move run exactCallableContract(&actual, constraints) {
        let usedCompared = run originComparedType(&resolver.*, &used)
        if run Type.equalsShared(&usedCompared, &wanted) { return Result<BodyNodeId, Shared<Rejection>>.succeed(node) }
        if let Option<Shared<Type>>.Some {value: weakened} = move run weakenedCallableContract(&used, &value) {
          let weakenedCompared = run originComparedType(&resolver.*, &weakened)
          if run Type.equalsShared(&weakenedCompared, &wanted) { return Result<BodyNodeId, Shared<Rejection>>.succeed(node) }
        }
      }
    }
    // A selected ordinary call may return a closed application type while its enclosing
    // function still writes the same result with its own binders, and a local initialized from
    // it keeps that closed type. Compare such a value in the nearest selected body's domain
    // without changing its node or loan obligations.
    let appliedWanted = run selectedBodyComparedType(&resolver.*, &wanted)
    let appliedOffered = run selectedBodyComparedType(&resolver.*, &offered)
    if run Type.equalsShared(&appliedWanted, &appliedOffered) {
      return Result<BodyNodeId, Shared<Rejection>>.succeed(node)
    }
    let injected = run unionArgument(&mut nodes.*, node, &value)
    if injected.index != node.index { return Result<BodyNodeId, Shared<Rejection>>.succeed(injected) }
    // A value that differs from exactly one union member only in covariant regions meets that
    // member by lifetime subtyping and is then injected as it, as it would meet the member alone.
    let mut candidates = List<Shared<Type>>.make()
    if Shared<Type>.with<bool>(&value, unionType) { candidates = run Type.failureMembers(&value) }
    let member = run regionAdmittedMember(&mut resolver.*, &mut owner.*, &mut dependencies.*, caller, constraints,
      &offered, List<Shared<Type>>.asSlice(&candidates), relateUnowned, span)
    if let Option<AdmittedMember>.Some {value: admitted} = move member {
      if relationsAdmitted(&resolver.*, List<RegionPair>.asSlice(&admitted.deferred)) {
        run retypeNode(&mut nodes.*, node, move admitted.member)
        let retyped = run unionArgument(&mut nodes.*, node, &value)
        if retyped.index != node.index { return Result<BodyNodeId, Shared<Rejection>>.succeed(retyped) }
      }
    }
    let sliced = run sliceArgument(&mut nodes.*, node, &value)
    let variables = List<Shared<DeclarationId>>.make()
    let bindings = List<Binding>.make()
    let converted = run pointerArgument(&mut nodes.*, sliced, &value,
      List<Shared<DeclarationId>>.asSlice(&variables), List<Binding>.asSlice(&bindings))
    let adapted = match move bodyExpressionType(List<BodyNode>.asSlice(&nodes.*), &converted) {
      Option<Shared<Type>>.Some {value: selected} => move selected
      Option<Shared<Type>>.None => { return run bodyRejection(&resolver.*, module, mismatchCode, span) }
    }
    let compared = run originComparedType(&resolver.*, &adapted)
    if run Type.equalsShared(&compared, &wanted) { return Result<BodyNodeId, Shared<Rejection>>.succeed(converted) }
    // A declared Effect contract stores an exact Effect it admits as itself: a one-alternative
    // join behind that contract (EFF-009, EFF-013).
    let declared = List<Constraint>.make()
    let mut strict = Option<RegionDeferral>.none()
    if Shared<Type>.with<bool>(&value, bareEffect) && Shared<Type>.with<bool>(&actual, joinableEffect)
      && run admitsEffect(&actual, &value, List<Constraint>.asSlice(&declared), &mut strict, RegionProof.Typing) {
      let joined = run Types.intern(Type.EffectJoin {contract: Shared<Type>.clone(&value), alternatives: run joinAlternatives(&actual)})
      run retypeNode(&mut nodes.*, node, move joined)
      return Result<BodyNodeId, Shared<Rejection>>.succeed(node)
    }
    let mut deferred = List<RegionPair>.make()
    let regions = run admitsRegions(&mut resolver.*, &mut owner.*, &mut dependencies.*, &compared, &wanted, caller, constraints,
      true, &mut deferred, span)
    if regions && (relateUnowned || ownedRelations(List<RegionPair>.asSlice(&deferred), caller)) {
      if relationsAdmitted(&resolver.*, List<RegionPair>.asSlice(&deferred)) {
        run retypeNode(&mut nodes.*, converted, Shared<Type>.clone(&value))
        return Result<BodyNodeId, Shared<Rejection>>.succeed(converted)
      }
    }
    // A view that differs only in its region keeps the expected type: the region check proves its
    // region outlives the expected one, or reports the borrow that cannot (LIFE-002).
    if !tentative && run viewRegionDifference(&compared, &wanted) {
      run retypeNode(&mut nodes.*, converted, Shared<Type>.clone(&value))
      return Result<BodyNodeId, Shared<Rejection>>.succeed(converted)
    }
    let code = valueMismatchCode(&compared, &wanted, mismatchCode)
    return Result<BodyNodeId, Shared<Rejection>>.failResult(run typeMismatchRejection(&resolver.*, module, code, span, &value, &actual))
  }
  return Result<BodyNodeId, Shared<Rejection>>.succeed(node)
}

// A view keeps its actual storage region through conversion. Classify its failed validity
// requirement only when access and element or referent type agree, directly or as the elements of
// an array; other differences remain type mismatches. A slice is classified at every boundary. With `references`, a reference is
// classified too when its region holds a loan rooted in this body; otherwise a call argument keeps
// reference mismatches for the argument's subtyping fallback.
effect fn failedViewValidity(actual: &Shared<Type>, expected: &Shared<Type>,
  constraints: &[Constraint], caller: &DeclarationId, references: bool) -> Option<Shared<Lifetime>> ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let written = run Type.copy(expected)
  let mut offeredRegion = Option<Shared<Lifetime>>.none()
  let mut wantedRegion = Option<Shared<Lifetime>>.none()
  match move run Type.copy(actual) {
    Type.Slice {element, access, lifetime} => {
      if let Type.Slice {element: target, access: targetAccess, lifetime: targetRegion} = move written {
        if access == targetAccess && run Type.equalsShared(&element, &target) {
          offeredRegion = Option<Shared<Lifetime>>.some(move lifetime)
          wantedRegion = Option<Shared<Lifetime>>.some(move targetRegion)
        }
      }
    }
    Type.Reference {referent, access, lifetime} => {
      if let Type.Reference {referent: target, access: targetAccess, lifetime: targetRegion} = move written {
        if references && bodyLoanRegion(&lifetime, caller) && access == targetAccess && run Type.equalsShared(&referent, &target) {
          offeredRegion = Option<Shared<Lifetime>>.some(move lifetime)
          wantedRegion = Option<Shared<Lifetime>>.some(move targetRegion)
        }
      }
    }
    // An array of views fails where its elements do, when its extent is the expected one; a rigid
    // static reference element is classified as a rigid static reference parameter is.
    Type.Array {element, extent} => {
      if let Type.Array {element: target, ..} = move written {
        let aligned = run Types.intern(Type.Array {element: Shared<Type>.clone(&target), extent: move extent})
        if run Type.equalsShared(&aligned, expected) {
          let staticElement = Shared<Type>.with<bool>(&target, fn(value: &Type) -> bool {
            if let Type.Reference {lifetime, ..} = &value.* { return Shared<Lifetime>.with<bool>(&lifetime, staticLifetime) }
            return false
          })
          return run failedViewValidity(&element, &target, constraints, caller, references || staticElement)
        }
      }
    }
    _ => {}
  }
  if let Option<Shared<Lifetime>>.Some {value: offered} = move offeredRegion {
    if let Option<Shared<Lifetime>>.Some {value: wanted} = move wantedRegion {
      if !run knownOutlives(constraints, &offered, &wanted) {
        return Option<Shared<Lifetime>>.some(move offered)
      }
    }
  }
  return Option<Shared<Lifetime>>.none()
}

// Whether `actual` is the view `expected` names in another region: a slice of the same access and
// element, or a reference of the same access and referent.
effect fn viewRegionDifference(actual: &Shared<Type>, expected: &Shared<Type>) -> bool ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let written = run Type.copy(expected)
  match move run Type.copy(actual) {
    Type.Slice {element, access, ..} => {
      if let Type.Slice {element: target, access: targetAccess, ..} = move written {
        return access == targetAccess && run Type.equalsShared(&element, &target)
      }
    }
    Type.Reference {referent, access, ..} => {
      if let Type.Reference {referent: target, access: targetAccess, ..} = move written {
        return access == targetAccess && run Type.equalsShared(&referent, &target)
      }
    }
    _ => {}
  }
  return false
}

// Whether `region` names a loan region of the checked body.
fn bodyLoanRegion(region: &Shared<Lifetime>, caller: &DeclarationId) -> bool {
  let mut at = usize.ZERO
  while at < Lifetime.atomCount(region) {
    let atom = Lifetime.atomAt(region, at)
    let local = Shared<Lifetime>.with<bool>(&atom, fn(value: &Lifetime) -> bool {
      if let Lifetime.Local {declaration, ..} = &value.* { return DeclarationId.equals(&declaration, caller) }
      return false
    })
    if local { return true }
    at = at + usize.ONE
  }
  return false
}

// A call with the wrong number of arguments, carrying both counts for the WrongCallArity template.
effect fn wrongArityRejection(resolver: &Resolver, module: &ModuleId, span: Span, expected: usize, supplied: usize)
-> Shared<Rejection> ! OutOfMemoryError ? &mut Allocator {
  let mut diagnostic = run makeRejection(RejectionCode.CallArity, module, span)
  let mut expectedText = Bytes.make()
  run appendDecimal(&mut expectedText, expected)
  let mut suppliedText = Bytes.make()
  run appendDecimal(&mut suppliedText, supplied)
  let mut word = run Bytes.copy(b"arguments")
  if expected == usize.ONE { word = run Bytes.copy(b"argument") }
  run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"expectedCount"), value: move expectedText})
  run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"expectedCountWord"), value: move word})
  run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"actualCount"), value: move suppliedText})
  return run Shared<Rejection>.make(move diagnostic)
}

// A non-Copy value consumed without `move` (OWN0003). A `&mut` reference gets its own template:
// lending it again with `&mut r` is usually the fix, the reborrow Rust makes implicitly.
effect fn explicitMoveRejection(module: &ModuleId, span: Span, ty: &Shared<Type>) -> Shared<Rejection>
! OutOfMemoryError ? &mut Allocator {
  let mut diagnostic = run makeRejection(RejectionCode.ExplicitMoveRequired, module, span)
  let exclusive = Shared<Type>.with<bool>(ty, fn(value: &Type) -> bool {
    return match &value.* { Type.Reference {access, ..} => access == Access.Mutable _ => false }
  })
  if exclusive {
    diagnostic.arguments = List<MessageArgument>.make()
    run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"template"), value: run Bytes.copy(b"1")})
  }
  return run Shared<Rejection>.make(move diagnostic)
}

// `mut F` or `once F` where `F` is not `Effect`: the mode belongs before a parameter name or `fn`.
effect fn modeBeforeTypeName(module: &ModuleId, span: Span, segments: &[Bytes], mode: CallableMode) -> Shared<Rejection>
! OutOfMemoryError ? &mut Allocator {
  let mut diagnostic = run makeRejection(RejectionCode.ModeBeforeTypeName, module, span)
  let mut name = Bytes.make()
  let mut at = usize.ZERO
  while at < segments.length {
    if at > usize.ZERO { run Bytes.append(&mut name, b".") }
    run Bytes.append(&mut name, Bytes.asSlice(&segments[at]))
    at = at + usize.ONE
  }
  let mut template = b"0"
  if mode == CallableMode.Once { template = b"1" }
  diagnostic.arguments = List<MessageArgument>.make()
  run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"template"), value: run Bytes.copy(template)})
  run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"name"), value: move name})
  return run Shared<Rejection>.make(move diagnostic)
}

// A value-type mismatch, carrying the `expected` and `actual` type text when its code's template
// spells exactly the declared type and the value's type and both have exact spellings.
// Appends the `expected` and `actual` text of two mismatched types as `TypeText.mismatch` writes
// them, spelling each type parameter of the innermost declaration body's own source as it is
// written there, with a note for each such parameter that it stands for any type; false, adding
// nothing, when either type has no exact spelling.
effect fn appendNamedMismatch(viewer: &ModuleId, resolver: &Resolver, expected: &Shared<Type>, actual: &Shared<Type>,
  arguments: &mut List<MessageArgument>) -> bool ! OutOfMemoryError ? &mut Allocator {
  let mut names = List<TypeText.Named>.make()
  let mut notes = List<Bytes>.make()
  let mut known = usize.ZERO
  while true {
    let mut wanted = Bytes.make()
    let mut offered = Bytes.make()
    if run TypeText.mismatchNamed(expected, actual, viewer, &mut names, &mut wanted, &mut offered) {
      run List<MessageArgument>.append(&mut arguments.*, MessageArgument {name: run Bytes.copy(b"expected"), value: move wanted})
      run List<MessageArgument>.append(&mut arguments.*, MessageArgument {name: run Bytes.copy(b"actual"), value: move offered})
      let written = List<Bytes>.asSlice(&notes)
      let mut at = usize.ZERO
      while at < written.length {
        run List<MessageArgument>.append(&mut arguments.*, MessageArgument {name: run Bytes.copy(b"note"),
          value: run Bytes.copy(Bytes.asSlice(&written[at]))})
        at = at + usize.ONE
      }
      return true
    }
    // Each pass meets at most one unspelled parameter per type, so retry while one is found.
    let count = List<TypeText.Named>.length(&names)
    if count == known { return run appendLifetimeMismatch(viewer, expected, actual, &mut arguments.*) }
    if !run spellParameters(resolver, &mut names, &mut notes) { return false }
    known = count
  }
  return false
}

// Two types that print the same with every non-static lifetime elided, such as `List<Name<'a>>`
// and `List<Name<'b>>`, differ only in their lifetimes: both are named, with a note saying so.
effect fn appendLifetimeMismatch(viewer: &ModuleId, expected: &Shared<Type>, actual: &Shared<Type>,
  arguments: &mut List<MessageArgument>) -> bool ! OutOfMemoryError ? &mut Allocator {
  let wanted = match move run TypeText.displayElided(expected, viewer) {
    Option<Bytes>.Some {value} => move value
    Option<Bytes>.None => { return false }
  }
  let offered = match move run TypeText.displayElided(actual, viewer) {
    Option<Bytes>.Some {value} => move value
    Option<Bytes>.None => { return false }
  }
  if !same(Bytes.asSlice(&wanted), Bytes.asSlice(&offered)) { return false }
  run List<MessageArgument>.append(&mut arguments.*, MessageArgument {name: run Bytes.copy(b"expected"), value: move wanted})
  run List<MessageArgument>.append(&mut arguments.*, MessageArgument {name: run Bytes.copy(b"actual"), value: move offered})
  run List<MessageArgument>.append(&mut arguments.*, MessageArgument {name: run Bytes.copy(b"note"),
    value: run Bytes.copy(b"the two types differ only in their lifetimes")})
  return true
}

// Fills each unspelled entry of `names` from the source of the innermost declaration body, adding
// a note to `notes` for each; false when one has no spelling there, such as a parameter of a
// declaration in another module.
effect fn spellParameters(resolver: &Resolver, names: &mut List<TypeText.Named>, notes: &mut List<Bytes>) -> bool
! OutOfMemoryError ? &mut Allocator {
  let bodies = List<BodyFrame>.asSlice(&resolver.bodies)
  let mut at = bodies.length
  while at > usize.ZERO {
    at = at - usize.ONE
    if let Option<AuthoredCursor>.Some {value} = &bodies[at].naming {
      if let Option<&IndexedSource>.Some {value: indexed} = move SourceIndex.sourceAtCursor(&resolver.source, &value) {
        return run spellParametersIn(indexed, &mut names.*, &mut notes.*)
      }
      return false
    }
    if bodies[at].root { return false }
  }
  return false
}

// Fills the unspelled entries of `names` from the generic parameters written in `indexed`, adding
// a note to `notes` for each, such as "`T` is a type parameter of `wrap`, so it can be any type".
effect fn spellParametersIn(indexed: &IndexedSource, names: &mut List<TypeText.Named>, notes: &mut List<Bytes>) -> bool
! OutOfMemoryError ? &mut Allocator {
  let index = IndexedSource.moduleIndex(indexed)
  let declarations = ModuleIndex.listDeclarations(index)
  let hir = IndexedSource.authored(indexed)
  let listed = List<TypeText.Named>.asMutSlice(&mut names.*)
  let mut entry = usize.ZERO
  while entry < listed.length {
    if Bytes.length(&listed[entry].spelling) == usize.ZERO {
      let ordinal = match move ModuleIndex.ordinalOf(index, &listed[entry].declaration) {
        Option<usize>.Some {value} => value
        Option<usize>.None => { return false }
      }
      let generics = writtenGenerics(hir, Module.node(hir, declarations[ordinal].header))
      if listed[entry].ordinal >= generics.length { return false }
      let parameter = Module.node(hir, Module.child(hir, generics, listed[entry].ordinal))
      let bounded = match parameter {
        Node.TypeParameter {bounds, ..} => bounds.length > usize.ZERO
        _ => false
      }
      let spelled = match parameter {
        Node.TypeParameter {name, ..} => match Module.node(hir, name) {
          Node.Name {text} => run Bytes.copy(Module.text(hir, text))
          _ => Bytes.make()
        }
        _ => Bytes.make()
      }
      if Bytes.length(&spelled) == usize.ZERO { return false }
      let owner = run DeclarationId.copySpelling(&listed[entry].declaration)
      if Bytes.length(&owner) > usize.ZERO {
        let mut note = run Bytes.copy(b"`")
        run Bytes.append(&mut note, Bytes.asSlice(&spelled))
        run Bytes.append(&mut note, b"` is a type parameter of `")
        run Bytes.append(&mut note, Bytes.asSlice(&owner))
        if bounded {
          run Bytes.append(&mut note, b"`, so it can be any type that meets its bounds")
        } else {
          run Bytes.append(&mut note, b"`, so it can be any type")
        }
        run List<Bytes>.append(&mut notes.*, move note)
      }
      listed[entry].spelling = move spelled
    }
    entry = entry + usize.ONE
  }
  return true
}

// An Effect has no type spelling, so a message names it by its success, as "an Effect of `i32`";
// none for any other type.
effect fn unrunEffectText(viewer: &ModuleId, ty: &Shared<Type>) -> Option<Bytes> ! OutOfMemoryError ? &mut Allocator {
  let mut unrun = Shared<Type>.with<Option<Shared<Type>>>(ty, delayedEffectContract)
  if Shared<Type>.with<bool>(ty, bareEffect) { unrun = Option<Shared<Type>>.some(Shared<Type>.clone(ty)) }
  if let Option<Shared<Type>>.Some {value: contract} = move unrun {
    let mut text = run Bytes.copy(b"an Effect")
    let success = Shared<Type>.with<Option<Shared<Type>>>(&contract, fn(value: &Type) -> Option<Shared<Type>> {
      return match &value.* { Type.Effect {success, ..} => Option<Shared<Type>>.some(Shared<Type>.clone(&success)) _ => Option<Shared<Type>>.none() }
    })
    if let Option<Shared<Type>>.Some {value: succeeds} = move success {
      if let Option<Bytes>.Some {value: spelled} = move run TypeText.display(&succeeds, viewer) {
        run Bytes.append(&mut text, b" of `")
        run Bytes.append(&mut text, Bytes.asSlice(&spelled))
        run Bytes.append(&mut text, b"`")
      }
    }
    return Option<Bytes>.some(move text)
  }
  return Option<Bytes>.none()
}

// A Silk function or closure value, which has no C address.
fn silkCallableType(value: &Type) -> bool {
  return match &value.* {
    Type.Callable {..} => true
    Type.CallableValue {..} => true
    Type.CallableView {..} => true
    Type.CallableOrigin {..} => true
    Type.CallableSchema {..} => true
    _ => false
  }
}

// A value of one enum where another or an integer was expected names both types; for an enum
// against an integer, the template says which way the conversion went.
effect fn enumMismatchArguments(
  module: &ModuleId, code: RejectionCode, expected: &Shared<Type>, actual: &Shared<Type>, diagnostic: &mut Rejection,
) -> () ! OutOfMemoryError ? &mut Allocator {
  if code != RejectionCode.WrongEnumMember && code != RejectionCode.EnumIntegerMismatch { return }
  let expectedText = match move run TypeText.display(expected, module) {
    Option<Bytes>.Some {value} => move value
    Option<Bytes>.None => { return }
  }
  let actualText = match move run TypeText.display(actual, module) {
    Option<Bytes>.Some {value} => move value
    Option<Bytes>.None => { return }
  }
  if code == RejectionCode.WrongEnumMember {
    run vectorArgument(&mut diagnostic.*, b"expected", Bytes.asSlice(&expectedText))
    run vectorArgument(&mut diagnostic.*, b"actual", Bytes.asSlice(&actualText))
    return
  }
  if Shared<Type>.with<OwnerKind>(actual, nominalKind) == OwnerKind.Enumeration {
    let name = run unqualifiedName(Bytes.asSlice(&actualText))
    run vectorArgument(&mut diagnostic.*, b"enumName", Bytes.asSlice(&name))
    run vectorArgument(&mut diagnostic.*, b"integer", Bytes.asSlice(&expectedText))
    run vectorArgument(&mut diagnostic.*, b"template", b"1")
  } else {
    let name = run unqualifiedName(Bytes.asSlice(&expectedText))
    run vectorArgument(&mut diagnostic.*, b"enumName", Bytes.asSlice(&name))
    run vectorArgument(&mut diagnostic.*, b"integer", Bytes.asSlice(&actualText))
    run vectorArgument(&mut diagnostic.*, b"template", b"0")
  }
}

effect fn typeMismatchRejection(
  resolver: &Resolver, module: &ModuleId, code: RejectionCode, span: Span, expected: &Shared<Type>, actual: &Shared<Type>,
) -> Shared<Rejection> ! OutOfMemoryError ? &mut Allocator {
  let mut diagnostic = run makeRejection(code, module, span)
  let named = code == RejectionCode.TypeMismatch || code == RejectionCode.ReturnTypeMismatch || code == RejectionCode.AssignmentTypeMismatch
    || code == RejectionCode.StructFieldTypeMismatch || code == RejectionCode.ConditionNotBool
    || code == RejectionCode.ArrayElementMismatch
  // An Effect where its success was expected was made but never run, as in `let x = f()` for an
  // `effect fn f() -> i32`; the message says so instead of naming no types.
  let expectsEffect = Shared<Type>.with<bool>(expected, bareEffect) || match Shared<Type>.with<Option<Shared<Type>>>(expected, delayedEffectContract) {
    Option<Shared<Type>>.Some {..} => true
    Option<Shared<Type>>.None => false
  }
  if named && !expectsEffect {
    if let Option<Bytes>.Some {value: effectText} = move run unrunEffectText(module, actual) {
      if let Option<Bytes>.Some {value: expectedText} = move run TypeText.display(expected, module) {
        let mut actualText = move effectText
        run Bytes.append(&mut actualText, b" that is never run (write `run` before the call that makes it)")
        run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"expected"), value: move expectedText})
        run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"actual"), value: move actualText})
        return run Shared<Rejection>.make(move diagnostic)
      }
    }
  }
  // A Silk function where C wants a function pointer says to pass an `export "C"` function.
  if code == RejectionCode.TypeMismatch && Shared<Type>.with<bool>(expected, nativeFunctionPointer)
    && Shared<Type>.with<bool>(actual, silkCallableType) {
    run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"template"), value: run Bytes.copy(b"1")})
    return run Shared<Rejection>.make(move diagnostic)
  }
  if named {
    if let Option<Bytes>.Some {value: expectedText} = move run TypeText.display(expected, module) {
      if let Option<Bytes>.Some {value: actualText} = move run TypeText.display(actual, module) {
        run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"expected"), value: move expectedText})
        run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"actual"), value: move actualText})
      }
    }
  }
  if code == RejectionCode.TypeMismatch { run appendBorrowHint(module, expected, actual, &mut diagnostic.arguments) }
  run enumMismatchArguments(module, code, expected, actual, &mut diagnostic)
  // A call argument whose types differ in a lifetime, such as `string<'static>` fixed by an
  // earlier `'static` argument against a borrowed `string`, still names both, with any other
  // lifetime written as elided.
  // The same holds for a binding's or field's declared `string` against a call's result.
  let lifetimeAware = code == RejectionCode.TypeMismatch || code == RejectionCode.ReturnTypeMismatch
    || code == RejectionCode.AssignmentTypeMismatch || code == RejectionCode.StructFieldTypeMismatch
    || code == RejectionCode.ArrayElementMismatch
  if lifetimeAware && List<MessageArgument>.length(&diagnostic.arguments) == usize.ZERO {
    let named = run appendNamedMismatch(module, resolver, expected, actual, &mut diagnostic.arguments)
  }
  // A narrowing names the members the target lacks.
  if code == RejectionCode.IncompatibleUnionConversion {
    run appendMissingMembers(module, expected, actual, &mut diagnostic.arguments)
  }
  // Two callables that print no type are two functions or closures, each of its own type.
  if code == RejectionCode.AssignmentTypeMismatch && List<MessageArgument>.length(&diagnostic.arguments) == usize.ZERO
    && Shared<Type>.with<bool>(expected, callableValueForm) && Shared<Type>.with<bool>(actual, callableValueForm) {
    run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"template"), value: run Bytes.copy(b"1")})
  }
  return run Shared<Rejection>.make(move diagnostic)
}

// A plain value passed for a borrow of a type the call has not fixed yet, as in
// `StdoutWriter.print("{}", 5)`, prints no expected type; when no other text names the types,
// the message says to borrow the value.
effect fn appendBorrowHint(module: &ModuleId, expected: &Shared<Type>, actual: &Shared<Type>, arguments: &mut List<MessageArgument>)
-> () ! OutOfMemoryError ? &mut Allocator {
  if List<MessageArgument>.length(&arguments.*) != usize.ZERO { return () }
  if !Shared<Type>.with<bool>(expected, isReferenceType) || Shared<Type>.with<bool>(actual, isReferenceType) { return () }
  if let Option<Bytes>.Some {value: actualText} = move run TypeText.display(actual, module) {
    run List<MessageArgument>.append(&mut arguments.*, MessageArgument {name: run Bytes.copy(b"template"), value: run Bytes.copy(b"2")})
    run List<MessageArgument>.append(&mut arguments.*, MessageArgument {name: run Bytes.copy(b"actual"), value: move actualText})
  }
  return ()
}

// `let _ = e`, which reads as a discard elsewhere; the message points at `drop e` (SEM0087).
effect fn letDiscardRejection(module: &ModuleId, span: Span) -> Shared<Rejection> ! OutOfMemoryError ? &mut Allocator {
  let mut diagnostic = run makeRejection(RejectionCode.ExplicitDiscard, module, span)
  diagnostic.arguments = List<MessageArgument>.make()
  run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"template"), value: run Bytes.copy(b"1")})
  return run Shared<Rejection>.make(move diagnostic)
}

// An expression statement whose result cannot be ignored (SEM0087, template 0, which names the
// result type; template 1 is the `let _ = e` message).
effect fn statementResultRejection(module: &ModuleId, span: Span, discarded: &Shared<Type>) -> Shared<Rejection>
! OutOfMemoryError ? &mut Allocator {
  let mut diagnostic = run makeRejection(RejectionCode.ExplicitDiscard, module, span)
  if let Option<Bytes>.Some {value: text} = move run TypeText.display(discarded, module) {
    run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"actual"), value: move text})
  }
  run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"template"), value: run Bytes.copy(b"0")})
  return run Shared<Rejection>.make(move diagnostic)
}

// A rejection whose template names one type in `hole`, filled when the type prints exactly.
effect fn typeHoleRejection(module: &ModuleId, code: RejectionCode, span: Span, hole: &[u8], ty: &Shared<Type>)
-> Shared<Rejection> ! OutOfMemoryError ? &mut Allocator {
  let mut diagnostic = run makeRejection(code, module, span)
  if let Option<Bytes>.Some {value: text} = move run TypeText.display(ty, module) {
    run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(hole), value: move text})
  }
  return run Shared<Rejection>.make(move diagnostic)
}

// A match guard that is not `bool`, naming the guard's type when it prints exactly.
effect fn guardTypeRejection(
  resolver: &Resolver, module: &ModuleId, span: Span, guardType: &Option<Shared<Type>>,
) -> Result<BodyNodeId, Shared<Rejection>> ! OutOfMemoryError ? &mut Allocator {
  let mut diagnostic = run makeRejection(RejectionCode.MatchGuardNotBool, module, span)
  if let Option<Shared<Type>>.Some {value: ty} = &guardType.* {
    if let Option<Bytes>.Some {value: actualText} = move run TypeText.display(&ty, module) {
      run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"actual"), value: move actualText})
    }
  }
  return Result<BodyNodeId, Shared<Rejection>>.failResult(run Shared<Rejection>.make(move diagnostic))
}

// Names `field` on a struct-field type mismatch from its initializer. A mismatch inside a nested
// initializer already names its own field and is returned unchanged.
effect fn namedFieldRejection(diagnostic: Shared<Rejection>, field: &[u8]) -> Shared<Rejection>
  ! OutOfMemoryError ? &mut Allocator {
  let count = Shared<Rejection>.with<usize>(&diagnostic, fn(value: &Rejection) -> usize {
    if value.code != RejectionCode.StructFieldTypeMismatch { return usize.MAX }
    let listed = List<MessageArgument>.asSlice(&value.arguments)
    let mut at = usize.ZERO
    while at < listed.length {
      if same(Bytes.asSlice(&listed[at].name), b"field") { return usize.MAX }
      at = at + usize.ONE
    }
    return listed.length
  })
  if count == usize.MAX { return move diagnostic }
  let mut arguments = List<MessageArgument>.make()
  let mut at = usize.ZERO
  while at < count {
    let name = run argumentBytes(&diagnostic, at, true)
    let value = run argumentBytes(&diagnostic, at, false)
    run List<MessageArgument>.append(&mut arguments, MessageArgument {name: move name, value: move value})
    at = at + usize.ONE
  }
  run List<MessageArgument>.append(&mut arguments, MessageArgument {name: run Bytes.copy(b"field"), value: run Bytes.copy(field)})
  Shared<Rejection>.withMut<()>(&diagnostic, fn(value: &mut Rejection) -> () { value.arguments = move arguments })
  return move diagnostic
}

// A copy of the name, or else the value, of argument `index` of `diagnostic`.
// Adds one named message argument to a rejection in place.
effect fn appendRejectionArgument(diagnostic: &Shared<Rejection>, name: &[u8], value: &[u8]) -> ()
  ! OutOfMemoryError ? &mut Allocator {
  let count = Shared<Rejection>.with<usize>(diagnostic, fn(rejection: &Rejection) -> usize {
    return List<MessageArgument>.length(&rejection.arguments)
  })
  let mut arguments = List<MessageArgument>.make()
  let mut at = usize.ZERO
  while at < count {
    let copiedName = run argumentBytes(diagnostic, at, true)
    let copiedValue = run argumentBytes(diagnostic, at, false)
    run List<MessageArgument>.append(&mut arguments, MessageArgument {name: move copiedName, value: move copiedValue})
    at = at + usize.ONE
  }
  run List<MessageArgument>.append(&mut arguments, MessageArgument {name: run Bytes.copy(name), value: run Bytes.copy(value)})
  Shared<Rejection>.withMut<()>(diagnostic, fn(rejection: &mut Rejection) -> () { rejection.arguments = move arguments })
  return ()
}

effect fn argumentBytes(diagnostic: &Shared<Rejection>, index: usize, name: bool) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let length = Shared<Rejection>.with<usize>(diagnostic, fn(value: &Rejection) -> usize {
    let listed = List<MessageArgument>.asSlice(&value.arguments)
    if name { return Bytes.length(&listed[index].name) }
    return Bytes.length(&listed[index].value)
  })
  let mut copied = Bytes.make()
  let mut at = usize.ZERO
  while at < length {
    let byte = Shared<Rejection>.with<u8>(diagnostic, fn(value: &Rejection) -> u8 {
      let listed = List<MessageArgument>.asSlice(&value.arguments)
      if name { return Bytes.asSlice(&listed[index].name)[at] }
      return Bytes.asSlice(&listed[index].value)[at]
    })
    run Bytes.append(&mut copied, &[byte])
    at = at + usize.ONE
  }
  return move copied
}

fn unionType(value: &Type) -> bool {
  return match &value.* { Type.Union {..} => true _ => false }
}

struct AdmittedMember {
  member: Shared<Type>,
  deferred: List<RegionPair>,
}

// The one candidate member that `offered` meets by covariant region subtyping, with the relations
// that leaves open; none when no candidate or several candidates admit it.
effect fn regionAdmittedMember(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, dependencies: &mut List<Dependency>,
  caller: &DeclarationId, constraints: &[Constraint], offered: &Shared<Type>, listed: &[Shared<Type>],
  relateUnowned: bool, span: Span,
) -> Option<AdmittedMember> ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut chosen = Option<AdmittedMember>.none()
  let mut at = usize.ZERO
  while at < listed.length {
    let wanted = run originComparedType(&resolver.*, &listed[at])
    let mut deferred = List<RegionPair>.make()
    let admitted = run admitsRegions(&mut resolver.*, &mut owner.*, &mut dependencies.*, offered, &wanted, caller,
      constraints, true, &mut deferred, span)
    if admitted && (relateUnowned || ownedRelations(List<RegionPair>.asSlice(&deferred), caller)) {
      if let Option<AdmittedMember>.Some {..} = &chosen { return Option<AdmittedMember>.none() }
      chosen = Option<AdmittedMember>.some(AdmittedMember {member: Shared<Type>.clone(&listed[at]), deferred: move deferred})
    }
    at = at + usize.ONE
  }
  return move chosen
}

// Whether every deferred pair relates two regions of the caller's own body.
fn ownedRelations(pairs: &[RegionPair], caller: &DeclarationId) -> bool {
  let mut at = usize.ZERO
  while at < pairs.length {
    if !callerLocalRegion(&pairs[at].wanted, caller) { return false }
    at = at + usize.ONE
  }
  return true
}

// Whether a type retains a region through a reference, slice, `string`, array element or nominal
// argument. `'static` counts only when `countStatic` is set.
effect fn carriesRegion(value: &Shared<Type>, countStatic: bool) -> bool ! OutOfMemoryError ? &mut Allocator {
  match move run Type.copy(value) {
    Type.String {lifetime} => { return countStatic || !Shared<Lifetime>.with<bool>(&lifetime, staticLifetime) }
    Type.Reference {referent, lifetime, ..} => {
      return countStatic || !Shared<Lifetime>.with<bool>(&lifetime, staticLifetime) || run carriesRegion(&referent, countStatic)
    }
    Type.Slice {element, lifetime, ..} => {
      return countStatic || !Shared<Lifetime>.with<bool>(&lifetime, staticLifetime) || run carriesRegion(&element, countStatic)
    }
    Type.Array {element, ..} => { return run carriesRegion(&element, countStatic) }
    Type.Nominal {arguments, ..} => {
      let listed = List<Argument>.asSlice(&arguments)
      let mut at = usize.ZERO
      while at < listed.length {
        if let Argument.Lifetime {value: region} = &listed[at] {
          if countStatic || !Shared<Lifetime>.with<bool>(&region, staticLifetime) { return true }
        }
        if let Argument.Type {value: argument} = &listed[at] {
          if run carriesRegion(&argument, countStatic) { return true }
        }
        at = at + usize.ONE
      }
    }
    _ => {}
  }
  return false
}

// The common validity of two regions: either one when they are equal, otherwise their meet.
effect fn meetRegion(left: &Shared<Lifetime>, right: &Shared<Lifetime>) -> Shared<Lifetime>
! OutOfMemoryError ? &mut Allocator {
  if Lifetime.equalsShared(left, right) { return Shared<Lifetime>.clone(left) }
  let mut regions = List<Shared<Lifetime>>.make()
  run List<Shared<Lifetime>>.append(&mut regions, Shared<Lifetime>.clone(left))
  run List<Shared<Lifetime>>.append(&mut regions, Shared<Lifetime>.clone(right))
  return run Lifetime.meet(List<Shared<Lifetime>>.asSlice(&regions))
}

// `left` with each reference, slice, `string` and nominal lifetime argument region where it differs
// from `right` replaced by their meet; array elements, referents and type arguments meet the same
// way. None when the two differ in anything but regions. The result says nothing about variance:
// the caller proves that both types meet it by covariant subtyping (`admitsRegions`).
effect fn meetRegions(left: &Shared<Type>, right: &Shared<Type>) -> Option<Shared<Type>>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  if run Type.equalsShared(left, right) { return Option<Shared<Type>>.some(Shared<Type>.clone(left)) }
  let other = run Type.copy(right)
  match move run Type.copy(left) {
    Type.String {lifetime} => {
      if let Type.String {lifetime: written} = move other {
        return Option<Shared<Type>>.some(run Types.intern(Type.String {lifetime: run meetRegion(&lifetime, &written)}))
      }
    }
    Type.Reference {referent, access, lifetime} => {
      if let Type.Reference {referent: written, access: writtenAccess, lifetime: writtenLifetime} = move other {
        if access != writtenAccess { return Option<Shared<Type>>.none() }
        let met = run meetRegions(&referent, &written)
        if let Option<Shared<Type>>.Some {value: inner} = move met {
          return Option<Shared<Type>>.some(run Types.intern(Type.Reference {referent: move inner, access: access,
            lifetime: run meetRegion(&lifetime, &writtenLifetime)}))
        }
      }
    }
    Type.Slice {element, access, lifetime} => {
      if let Type.Slice {element: written, access: writtenAccess, lifetime: writtenLifetime} = move other {
        if access != writtenAccess { return Option<Shared<Type>>.none() }
        let met = run meetRegions(&element, &written)
        if let Option<Shared<Type>>.Some {value: inner} = move met {
          return Option<Shared<Type>>.some(run Types.intern(Type.Slice {element: move inner, access: access,
            lifetime: run meetRegion(&lifetime, &writtenLifetime)}))
        }
      }
    }
    Type.Array {element, extent} => {
      if let Type.Array {element: written, extent: writtenExtent} = move other {
        if !same(Bytes.asSlice(&extent), Bytes.asSlice(&writtenExtent)) { return Option<Shared<Type>>.none() }
        let met = run meetRegions(&element, &written)
        if let Option<Shared<Type>>.Some {value: inner} = move met {
          return Option<Shared<Type>>.some(run Types.intern(Type.Array {element: move inner,
            extent: run Bytes.copy(Bytes.asSlice(&extent))}))
        }
      }
    }
    Type.Nominal {declaration, isPublic, arguments} => {
      if let Type.Nominal {declaration: writtenDeclaration, arguments: writtenArguments, ..} = move other {
        let listed = List<Argument>.asSlice(&arguments)
        let writtenListed = List<Argument>.asSlice(&writtenArguments)
        if !DeclarationId.equals(&declaration, &writtenDeclaration) || listed.length != writtenListed.length {
          return Option<Shared<Type>>.none()
        }
        let mut met = List<Argument>.make()
        let mut at = usize.ZERO
        while at < listed.length {
          let mut next = Option<Argument>.none()
          if let Argument.Lifetime {value: region} = &listed[at] {
            if let Argument.Lifetime {value: writtenRegion} = &writtenListed[at] {
              next = Option<Argument>.some(Argument.Lifetime {value: run meetRegion(&region, &writtenRegion)})
            }
          } else if let Argument.Type {value: argument} = &listed[at] {
            if let Argument.Type {value: writtenArgument} = &writtenListed[at] {
              let inner = run meetRegions(&argument, &writtenArgument)
              if let Option<Shared<Type>>.Some {value: metArgument} = move inner {
                next = Option<Argument>.some(Argument.Type {value: move metArgument})
              }
            }
          } else if run sameExactArgument(&listed[at], &writtenListed[at]) {
            next = Option<Argument>.some(Argument.copy(&listed[at]))
          }
          match move next {
            Option<Argument>.Some {value} => { run List<Argument>.append(&mut met, move value) }
            Option<Argument>.None => { return Option<Shared<Type>>.none() }
          }
          at = at + usize.ONE
        }
        return Option<Shared<Type>>.some(run Types.intern(Type.Nominal {declaration: DeclarationId.copy(&declaration),
          isPublic: isPublic, arguments: move met}))
      }
    }
    _ => {}
  }
  return Option<Shared<Type>>.none()
}

// The shared loan an exclusive reference or slice gives up where `written` is a shared loan of the
// same form; none for any other pair.
// The initializer a binding annotation that elides a lifetime describes. The annotation admits
// the initializer's own type, a union member it injects into, or the slice of a borrowed array;
// whichever it admits supplies every lifetime the annotation elides (LIFE-003).
effect fn describedBinding(
  resolver: &Resolver, module: &ModuleId, nodes: &mut List<BodyNode>, node: BodyNodeId,
  written: &Shared<Type>, elided: &DeclarationId, span: Span,
) -> Result<BodyNodeId, Shared<Rejection>> ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let actual = match move bodyExpressionType(List<BodyNode>.asSlice(&nodes.*), &node) {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => { return run bodyRejection(resolver, module, RejectionCode.AssignmentTypeMismatch, span) }
  }
  if Shared<Type>.with<bool>(&actual, neverType) { return Result<BodyNodeId, Shared<Rejection>>.succeed(node) }
  let exact = run inferredAnnotation(written, &actual, elided)
  if let Option<Shared<Type>>.Some {..} = &exact { return Result<BodyNodeId, Shared<Rejection>>.succeed(node) }
  // A written callable contract describes an exact callable through its use contract; the
  // binding keeps the exact type, as a parameter of that contract would.
  let declared = List<Constraint>.make()
  if let Option<Shared<Type>>.Some {value: used} = move run exactCallableContract(&actual, List<Constraint>.asSlice(&declared)) {
    if Shared<Type>.with<bool>(written, callableContractType) {
      let contracted = run inferredAnnotation(written, &used, elided)
      if let Option<Shared<Type>>.Some {..} = &contracted { return Result<BodyNodeId, Shared<Rejection>>.succeed(node) }
      if let Option<Shared<Type>>.Some {value: weakened} = move run weakenedCallableContract(&used, written) {
        let relaxed = run inferredAnnotation(written, &weakened, elided)
        if let Option<Shared<Type>>.Some {..} = &relaxed { return Result<BodyNodeId, Shared<Rejection>>.succeed(node) }
      }
    }
  }
  if Shared<Type>.with<bool>(written, sourceUnion) {
    let ordered = run UnionProjection.members(written)
    let members = match move ordered {
      Option<List<Shared<Type>>>.Some {value} => move value
      Option<List<Shared<Type>>>.None => { return run bodyRejection(resolver, module, RejectionCode.AssignmentTypeMismatch, span) }
    }
    let listed = List<Shared<Type>>.asSlice(&members)
    let mut variables = List<Shared<DeclarationId>>.make()
    run List<Shared<DeclarationId>>.append(&mut variables, run Shared<DeclarationId>.make(DeclarationId.copy(elided)))
    let mut selected = Option<List<Binding>>.none()
    let mut at = usize.ZERO
    while at < listed.length {
      let mut bindings = List<Binding>.make()
      let unified = run Type.unify(&listed[at], &actual, List<Shared<DeclarationId>>.asSlice(&variables),
        Comparison.Exact, &mut bindings)
      let describes = match &unified {
        Unification.Unified => true
        _ => false
      }
      if describes {
        if let Option<List<Binding>>.Some {..} = &selected {
          return run bodyRejection(resolver, module, RejectionCode.AmbiguousLifetime, span)
        }
        selected = Option<List<Binding>>.some(move bindings)
      }
      at = at + usize.ONE
    }
    let chosen = match move selected {
      Option<List<Binding>>.Some {value} => move value
      Option<List<Binding>>.None => { return run bodyRejection(resolver, module, RejectionCode.AssignmentTypeMismatch, span) }
    }
    // A lifetime another member elides is described by no part of this initializer.
    let filled = run Type.applyBindings(written, List<Binding>.asSlice(&chosen), true)
    if run typeMentionsOwner(&filled, elided) {
      return run bodyRejection(resolver, module, RejectionCode.AmbiguousLifetime, span)
    }
    let injected = run unionArgument(&mut nodes.*, node, &filled)
    if injected.index != node.index { return Result<BodyNodeId, Shared<Rejection>>.succeed(injected) }
    return run bodyRejection(resolver, module, RejectionCode.AssignmentTypeMismatch, span)
  }
  let sliced = run sliceArgument(&mut nodes.*, node, written)
  if sliced.index != node.index {
    let adapted = match move bodyExpressionType(List<BodyNode>.asSlice(&nodes.*), &sliced) {
      Option<Shared<Type>>.Some {value} => move value
      Option<Shared<Type>>.None => { return run bodyRejection(resolver, module, RejectionCode.AssignmentTypeMismatch, span) }
    }
    let converted = run inferredAnnotation(written, &adapted, elided)
    if let Option<Shared<Type>>.Some {..} = &converted { return Result<BodyNodeId, Shared<Rejection>>.succeed(sliced) }
  }
  let code = valueMismatchCode(&actual, written, RejectionCode.AssignmentTypeMismatch)
  return Result<BodyNodeId, Shared<Rejection>>.failResult(run typeMismatchRejection(resolver, module, code, span, written, &actual))
}

// A producer returns ownership of its exact environment. Reuse the place classification of
// ordinary consuming operands; contract admission cannot make an affine local into a copy.
effect fn transferCallableReturn(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, module: &ModuleId, cursor: &AuthoredCursor,
  nodes: &mut List<BodyNode>, node: BodyNodeId, constraints: &[Constraint], span: Span)
  -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let actual = match move bodyExpressionType(List<BodyNode>.asSlice(&nodes.*), &node) {
    Option<Shared<Type>>.Some {value} => move value
    _ => { fail RevisionMismatch {} }
  }
  if Shared<Type>.with<bool>(&actual, neverType) { return Result<BodyNodeId, Shared<Rejection>>.succeed(node) }
  let copied = run copyType(&mut resolver.*, &mut owner.*, &mut dependencies.*, &actual, constraints, span)
  let copy = match move copied {
    Result<bool, Shared<Rejection>>.Success {value} => value
    Result<bool, Shared<Rejection>>.Failure {error} => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move error) }
  }
  if copy { return Result<BodyNodeId, Shared<Rejection>>.succeed(node) }
  let nested = match &List<BodyNode>.asSlice(&nodes.*)[node.index].kind {
    BodyNodeKind.Expression {form: BodyExpression.Move {value, consumed}, ..} => match &consumed {
      Option<BodyConsumedPlace>.None => Option<BodyNodeId>.some(value)
      _ => Option<BodyNodeId>.none()
    }
    _ => Option<BodyNodeId>.none()
  }
  if let Option<BodyNodeId>.Some {value} = move nested {
    let operandSpan = run originSpan(cursor, List<BodyNode>.asSlice(&nodes.*)[value.index].origin)
    let transferred = run transferCallableReturn(&mut resolver.*, &mut owner.*, &mut dependencies.*,
      module, cursor, &mut nodes.*, value, constraints, operandSpan)
    let selected = match move transferred {
      Result<BodyNodeId, Shared<Rejection>>.Success {value: accepted} => accepted
      Result<BodyNodeId, Shared<Rejection>>.Failure {error} => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move error) }
    }
    if selected.index != value.index { run replaceCallableReturnMove(&mut nodes.*, node, selected) }
    return Result<BodyNodeId, Shared<Rejection>>.succeed(node)
  }
  // A match constructs its result on the selected arm. Its being an rvalue does not make
  // an affine place used by an arm copyable; preserve each arm's own transfer metadata.
  let mut armNodes = List<BodyNodeId>.make()
  let listedNodes = List<BodyNode>.asSlice(&nodes.*)
  if let BodyNodeKind.Expression {form: BodyExpression.Match {arms, ..}, ..} = &listedNodes[node.index].kind {
    let listed = List<BodyMatchArm>.asSlice(&arms)
    let mut at = usize.ZERO
    while at < listed.length {
      run List<BodyNodeId>.append(&mut armNodes, listed[at].result)
      at = at + usize.ONE
    }
  }
  let returnedArms = List<BodyNodeId>.asSlice(&armNodes)
  if returnedArms.length != usize.ZERO {
    let mut at = usize.ZERO
    while at < returnedArms.length {
      let armNode = returnedArms[at]
      let expression = bodyExpressionType(List<BodyNode>.asSlice(&nodes.*), &armNode)
      if let Option<Shared<Type>>.Some {..} = move expression {
        let armSpan = run originSpan(cursor, List<BodyNode>.asSlice(&nodes.*)[armNode.index].origin)
        let transferred = run transferCallableReturn(&mut resolver.*, &mut owner.*, &mut dependencies.*,
          module, cursor, &mut nodes.*, armNode, constraints, armSpan)
        let selected = match move transferred {
          Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
          Result<BodyNodeId, Shared<Rejection>>.Failure {error} => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move error) }
        }
        if selected.index != armNode.index { run replaceCallableReturnArm(&mut nodes.*, node, at, selected) }
      }
      at = at + usize.ONE
    }
    return Result<BodyNodeId, Shared<Rejection>>.succeed(node)
  }
  let transfer = run consumption(&resolver.source, cursor, List<BodyNode>.asSlice(&nodes.*), node)
  let mut code = RejectionCode.ExplicitMoveRequired
  match move transfer {
    Consumption.Rvalue => { return Result<BodyNodeId, Shared<Rejection>>.succeed(node) }
    Consumption.Borrowed => { code = RejectionCode.BorrowedExtraction }
    Consumption.Boundary => { code = RejectionCode.ExtractionBoundary }
    Consumption.Escape {..} => { code = RejectionCode.MatchBorrowEscape }
    Consumption.PlaceBinding => { code = RejectionCode.Unsupported }
    Consumption.Place {..} => {
      let movedPattern = match &List<BodyNode>.asSlice(&nodes.*)[node.index].kind {
        BodyNodeKind.Expression {form: BodyExpression.PatternBinding {access, ..}, ..} => access == BodyBindingAccess.Moved
        _ => false
      }
      if movedPattern {
        let selected = run consumedPlace(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor,
          List<BodyNode>.asSlice(&nodes.*), node, false, false, span, span, constraints)
        let consumed = match move selected {
          Result<Option<BodyConsumedPlace>, Shared<Rejection>>.Success {value} => move value
          Result<Option<BodyConsumedPlace>, Shared<Rejection>>.Failure {error} => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move error) }
        }
        let origin = List<BodyNode>.asSlice(&nodes.*)[node.index].origin
        let moved = BodyNodeId {index: List<BodyNode>.length(&nodes.*)}
        run List<BodyNode>.append(&mut nodes.*, BodyNode {origin: origin, kind: BodyNodeKind.Expression {
          ty: move actual, form: BodyExpression.Move {value: node, consumed: move consumed}}})
        return Result<BodyNodeId, Shared<Rejection>>.succeed(moved)
      }
      // A raw contract parameter is still a source callable view, requiring retained-view
      // lowering. Its concrete representation must not be guessed to be an owned environment.
      if Shared<Type>.with<bool>(&actual, fn(ty: &Type) -> bool { return match &ty.* { Type.Callable {..} => true _ => false } }) {
        return Result<BodyNodeId, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Unsupported, span))
      }
    }
  }
  if code == RejectionCode.ExplicitMoveRequired {
    return Result<BodyNodeId, Shared<Rejection>>.failResult(run explicitMoveRejection(module, span, &actual))
  }
  return Result<BodyNodeId, Shared<Rejection>>.failResult(run reject(&resolver.*, module, code, span))
}

effect fn replaceCallableReturnArm(nodes: &mut List<BodyNode>, node: BodyNodeId, arm: usize, result: BodyNodeId) -> ()
! RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let previous = List<BodyNode>.remove(&mut nodes.*, node.index)
  if let BodyNodeKind.Expression {ty, form} = move previous.kind {
    if let BodyExpression.Match {subject, access, tags, domain, arms, syntax} = move form {
      let mut selected = move arms
      let previousArm = List<BodyMatchArm>.remove(&mut selected, arm)
      run List<BodyMatchArm>.insert(&mut selected, arm, BodyMatchArm {origin: previousArm.origin,
        pattern: move previousArm.pattern, tests: move previousArm.tests, guard: move previousArm.guard, result: result,
        bindings: move previousArm.bindings})
      run List<BodyNode>.insert(&mut nodes.*, node.index, BodyNode {origin: previous.origin,
        kind: BodyNodeKind.Expression {ty: move ty, form: BodyExpression.Match {subject: subject,
          access: move access, tags: tags, domain: domain, arms: move selected, syntax: syntax}}})
      return ()
    }
  }
  fail RevisionMismatch {}
}

effect fn replaceCallableReturnMove(nodes: &mut List<BodyNode>, node: BodyNodeId, operand: BodyNodeId) -> ()
! RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let previous = List<BodyNode>.remove(&mut nodes.*, node.index)
  if let BodyNodeKind.Expression {ty, form} = move previous.kind {
    if let BodyExpression.Move {consumed, ..} = move form {
      run List<BodyNode>.insert(&mut nodes.*, node.index, BodyNode {origin: previous.origin,
        kind: BodyNodeKind.Expression {ty: move ty, form: BodyExpression.Move {value: operand, consumed: move consumed}}})
      return ()
    }
  }
  fail RevisionMismatch {}
}

// The bindings a call's written generic arguments give the binders their slots name.
// The ordinals of `target`'s own lifetime binders whose arguments the source wrote.
effect fn writtenLifetimeBinders(slots: &[CallPrefixSlot], values: &[Argument], target: &DeclarationId) -> List<usize>
! OutOfMemoryError ? &mut Allocator {
  let bindings = run writtenCallBindings(slots, values)
  let listed = List<Binding>.asSlice(&bindings)
  let mut ordinals = List<usize>.make()
  let mut at = usize.ZERO
  while at < listed.length {
    if let Argument.Lifetime {..} = &listed[at].value {
      if declarationEqualsShared(target, &listed[at].declaration) { run List<usize>.append(&mut ordinals, listed[at].ordinal) }
    }
    at = at + usize.ONE
  }
  return move ordinals
}

effect fn writtenCallBindings(slots: &[CallPrefixSlot], values: &[Argument]) -> List<Binding> ! OutOfMemoryError ? &mut Allocator {
  let mut bindings = List<Binding>.make()
  if slots.length != values.length { return move bindings }
  let mut at = usize.ZERO
  while at < slots.length {
    let binder = match &slots[at] {
      CallPrefixSlot.Lifetime {value} => Shared<Lifetime>.with<Option<SlotBinder>>(&value, fn(lifetime: &Lifetime) -> Option<SlotBinder> {
        if let Lifetime.Parameter {declaration, ordinal} = &lifetime.* {
          return Option<SlotBinder>.some(SlotBinder {declaration: DeclarationId.copy(&declaration), ordinal: ordinal})
        }
        return Option<SlotBinder>.none()
      })
      CallPrefixSlot.Type {value} => Shared<Type>.with<Option<SlotBinder>>(&value, fn(ty: &Type) -> Option<SlotBinder> {
        if let Type.Parameter {declaration, ordinal} = &ty.* {
          return Option<SlotBinder>.some(SlotBinder {declaration: DeclarationId.copy(&declaration), ordinal: ordinal})
        }
        return Option<SlotBinder>.none()
      })
      CallPrefixSlot.Row {value} => Option<SlotBinder>.some(SlotBinder {declaration: DeclarationId.copyShared(&value.declaration), ordinal: value.ordinal})
    }
    if let Option<SlotBinder>.Some {value: found} = move binder {
      run List<Binding>.append(&mut bindings, Binding {declaration: run Shared<DeclarationId>.make(move found.declaration),
        ordinal: found.ordinal, value: copyArgument(&values[at])})
    }
    at = at + usize.ONE
  }
  return move bindings
}

// Whether the source wrote a call's binding: the call's own generics name its binder
// (`ownWritten`) or, with `ownerWritten`, it belongs to the callee's owner, whose arguments a
// qualifier wrote.
fn writtenCallBinding(binding: &Binding, ownWritten: &[Binding], callee: &DeclarationId, ownerWritten: bool) -> bool {
  let binder = DeclarationId.copyShared(&binding.declaration)
  let mut kept = ownerWritten && !DeclarationId.equals(&binder, callee) && DeclarationId.isPrefixOf(&binder, callee)
  let mut each = usize.ZERO
  while !kept && each < ownWritten.length {
    kept = binding.ordinal == ownWritten[each].ordinal
      && Shared<DeclarationId>.with<bool>(&ownWritten[each].declaration, fn(written: &DeclarationId) -> bool { return DeclarationId.equals(written, &binder) })
    each = each + usize.ONE
  }
  return kept
}

// A call's application with every binding the source did not write neutralized: a lifetime to
// 'static, a row to the empty row and a type to `neutralType`.
effect fn writtenCallApplication(applied: &[Binding], ownWritten: &[Binding], callee: &DeclarationId, ownerWritten: bool,
  neutralType: &Shared<Type>) -> List<Binding> ! OutOfMemoryError ? &mut Allocator {
  let mut chosen = List<Binding>.make()
  let mut at = usize.ZERO
  while at < applied.length {
    if writtenCallBinding(&applied[at], ownWritten, callee, ownerWritten) {
      run List<Binding>.append(&mut chosen, Binding {declaration: Shared<DeclarationId>.clone(&applied[at].declaration),
        ordinal: applied[at].ordinal, value: copyArgument(&applied[at].value)})
    } else {
      let mut neutral = Argument.Lifetime {value: run Shared<Lifetime>.make(Lifetime.Static)}
      if let Argument.Type {..} = &applied[at].value {
        neutral = Argument.Type {value: Shared<Type>.clone(neutralType)}
      } else if let Argument.Row {..} = &applied[at].value {
        neutral = Argument.Row {value: run Shared<Row>.make(Row.empty())}
      }
      run List<Binding>.append(&mut chosen, Binding {declaration: Shared<DeclarationId>.clone(&applied[at].declaration),
        ordinal: applied[at].ordinal, value: move neutral})
    }
    at = at + usize.ONE
  }
  return move chosen
}

// The type bindings of a call's application the source did not write.
effect fn unwrittenCallTypes(applied: &[Binding], ownWritten: &[Binding], callee: &DeclarationId, ownerWritten: bool)
-> List<Binding> ! OutOfMemoryError ? &mut Allocator {
  let mut unwritten = List<Binding>.make()
  let mut at = usize.ZERO
  while at < applied.length {
    if let Argument.Type {..} = &applied[at].value {
      if !writtenCallBinding(&applied[at], ownWritten, callee, ownerWritten) {
        run List<Binding>.append(&mut unwritten, Binding {declaration: Shared<DeclarationId>.clone(&applied[at].declaration),
          ordinal: applied[at].ordinal, value: copyArgument(&applied[at].value)})
      }
    }
    at = at + usize.ONE
  }
  return move unwritten
}

// The binder a written call argument's slot names.
struct SlotBinder {
  declaration: DeclarationId,
  ordinal: usize,
}

// One result component and its complete path through owned record fields. References and
// elements are boundaries: this evidence never invents a path into their stored contents.
struct ResultBorrowPart {
  ty: Shared<Type>,
  fields: List<usize>,
}

// Enumerate before call inference, while the nested fields' authored binders remain distinct.
// An unreadable record or a walk beyond the finite structural bound supplies no exact mapping.
effect fn resultBorrowParts(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, value: &Shared<Type>, path: &[usize], parts: &mut List<ResultBorrowPart>, span: Span)
-> bool ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  if path.length > holdDepth() { return false }
  let mut members = List<Shared<Type>>.make()
  let mut record = false
  match move run Type.copy(value) {
    Type.Nominal {declaration, ..} => {
      let count = run recordFieldCount(&mut resolver.*, DeclarationId.moduleId(&declaration), value, span)
      if let Result<usize, Shared<Rejection>>.Success {value: fields} = move count {
        members = run storedMemberTypes(&mut resolver.*, &mut owner.*, &mut dependencies.*, value, span)
        if List<Shared<Type>>.length(&members) != fields { return false }
        record = true
      } else {
        if DeclarationId.kind(&declaration) == OwnerKind.Struct { return false }
      }
    }
    Type.Anonymous {members: fields, ..} => { members = move fields record = true }
    _ => ()
  }
  if record {
    let fields = List<Shared<Type>>.asSlice(&members)
    let mut at = usize.ZERO
    while at < fields.length {
      let mut nested = run copySlots(path)
      run List<usize>.append(&mut nested, at)
      if !run resultBorrowParts(&mut resolver.*, &mut owner.*, &mut dependencies.*, &fields[at],
        List<usize>.asSlice(&nested), &mut parts.*, span) { return false }
      at = at + usize.ONE
    }
  } else {
    run List<ResultBorrowPart>.append(&mut parts.*, ResultBorrowPart {ty: Shared<Type>.clone(value), fields: run copySlots(path)})
  }
  return true
}

// The outlives facts a callee's signature lets its body assume, as atom pairs: a value whose region
// is `longer` may be placed where `shorter` is wanted.
struct RetainedFlows {
  longer: List<Shared<Lifetime>>,
  shorter: List<Shared<Lifetime>>,
}

// Records that every atom of `longer` may be placed where an atom of `shorter` is wanted.
effect fn flowBetween(flows: &mut RetainedFlows, longer: &Shared<Lifetime>, shorter: &Shared<Lifetime>) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut source = usize.ZERO
  while source < Lifetime.atomCount(longer) {
    let mut target = usize.ZERO
    while target < Lifetime.atomCount(shorter) {
      run List<Shared<Lifetime>>.append(&mut flows.longer, Lifetime.atomAt(longer, source))
      run List<Shared<Lifetime>>.append(&mut flows.shorter, Lifetime.atomAt(shorter, target))
      target = target + usize.ONE
    }
    source = source + usize.ONE
  }
  return ()
}

// Records the bounds `value` implies by being well formed and appends every lifetime atom it names
// to `atoms`. False when it names a type parameter, whose instantiation can hold any region, or a
// form this reading does not describe.
effect fn retainedTypeFlows(value: &Shared<Type>, flows: &mut RetainedFlows, atoms: &mut List<Shared<Lifetime>>) -> bool
! OutOfMemoryError ? &mut Allocator {
  return match move run Type.copy(value) {
    Type.Primitive {..} => true
    Type.Unit => true
    Type.String {lifetime} => {
      run appendRetainedAtoms(&mut atoms.*, &lifetime)
      return true
    }
    Type.Reference {referent, lifetime, ..} => run retainedContainedFlows(&referent, &lifetime, &mut flows.*, &mut atoms.*)
    Type.Slice {element, lifetime, ..} => run retainedContainedFlows(&element, &lifetime, &mut flows.*, &mut atoms.*)
    Type.Array {element, ..} => run retainedTypeFlows(&element, &mut flows.*, &mut atoms.*)
    Type.Anonymous {members, ..} => run retainedMemberFlows(List<Shared<Type>>.asSlice(&members), &mut flows.*, &mut atoms.*)
    Type.Union {members} => run retainedMemberFlows(List<Shared<Type>>.asSlice(&members), &mut flows.*, &mut atoms.*)
    Type.Nominal {arguments, ..} => {
      let mut inner = List<Shared<Lifetime>>.make()
      let listed = List<Argument>.asSlice(&arguments)
      let mut at = usize.ZERO
      while at < listed.length {
        if let Argument.Lifetime {value: argument} = &listed[at] {
          run appendRetainedAtoms(&mut inner, &argument)
        } else if let Argument.Type {value: argument} = &listed[at] {
          if !run retainedTypeFlows(&argument, &mut flows.*, &mut inner) { return false }
        } else {
          return false
        }
        at = at + usize.ONE
      }
      let named = List<Shared<Lifetime>>.asSlice(&inner)
      let mut source = usize.ZERO
      while source < named.length {
        let mut target = usize.ZERO
        while target < named.length {
          if source != target { run flowBetween(&mut flows.*, &named[source], &named[target]) }
          target = target + usize.ONE
        }
        run appendRetainedAtoms(&mut atoms.*, &named[source])
        source = source + usize.ONE
      }
      return true
    }
    _ => false
  }
}

effect fn retainedMemberFlows(members: &[Shared<Type>], flows: &mut RetainedFlows, atoms: &mut List<Shared<Lifetime>>) -> bool
! OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < members.length {
    if !run retainedTypeFlows(&members[at], &mut flows.*, &mut atoms.*) { return false }
    at = at + usize.ONE
  }
  return true
}

// Records that every atom `inside` names outlives `region`.
effect fn retainedContainedFlows(inside: &Shared<Type>, region: &Shared<Lifetime>, flows: &mut RetainedFlows, atoms: &mut List<Shared<Lifetime>>)
-> bool ! OutOfMemoryError ? &mut Allocator {
  let mut inner = List<Shared<Lifetime>>.make()
  if !run retainedTypeFlows(inside, &mut flows.*, &mut inner) { return false }
  let named = List<Shared<Lifetime>>.asSlice(&inner)
  let mut at = usize.ZERO
  while at < named.length {
    run flowBetween(&mut flows.*, &named[at], region)
    run appendRetainedAtoms(&mut atoms.*, &named[at])
    at = at + usize.ONE
  }
  run appendRetainedAtoms(&mut atoms.*, region)
  return true
}

effect fn appendRetainedAtoms(atoms: &mut List<Shared<Lifetime>>, region: &Shared<Lifetime>) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < Lifetime.atomCount(region) {
    run List<Shared<Lifetime>>.append(&mut atoms.*, Lifetime.atomAt(region, at))
    at = at + usize.ONE
  }
  return ()
}

// A call transaction can give distinct local arguments the same inferred region. For diagnostics,
// keep the callee's lifetime binders distinct while applying its type/row arguments, then follow
// only inputs its returned storage can retain (LIFE-004). Effect construction captures every input.
effect fn executableCallOrigins(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  application: &Application,
  arguments: &[BodyNodeId],
  constructs: bool,
  span: Span
) -> List<BodyNodeId>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
  let mut selected = List<BodyNodeId>.make()
  if constructs {
    run appendAll(arguments, &mut selected)
    return move selected
  }
  let declaration = Application.bodyDeclaration(application)
  let signature = run sectionOriginalSignature(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies.*,
    declaration,
    span
  )
  let result = match move Shared<
    Result<Answer, NoRejection>
  >.with<Option<Shared<Type>>>(&signature, signatureResult) {
    Option<Shared<Type>>.Some { value } => move value
    _ => {
      fail RevisionMismatch {}
    }
  }
  let supplied = run Application.bindings(application)
  let allBindings = List<Binding>.asSlice(&supplied)
  let mut partial = List<Binding>.make()
  let mut at = usize.ZERO
  while at < allBindings.length {
    if let Argument.Lifetime { .. } = &allBindings[at].value {
      at = at + usize.ONE
      continue
    }
    run List<
      Binding
    >.append(
      &mut partial,
      Binding {
        declaration: Shared<DeclarationId>.clone(&allBindings[at].declaration),
        ordinal: allBindings[at].ordinal,
        value: Argument.copy(&allBindings[at].value),
      }
    )
    at = at + usize.ONE
  }
  let bindings = List<Binding>.asSlice(&partial)
  let mut constraints = List<Constraint>.make()
  let count = Shared<Result<Answer, NoRejection>>.with<usize>(&signature, signatureConstraintCount)
  at = usize.ZERO
  while at < count {
    let bound = Shared<
      Result<Answer, NoRejection>
    >.with<
      Option<Constraint>
    >(
      &signature,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Constraint> {
        return signatureConstraintAt(answer, at)
      }
    )
    if let Option<Constraint>.Some { value } = move bound {
      run List<Constraint>.append(&mut constraints, run applyConstraintBindings(&value, bindings))
    }
    at = at + usize.ONE
  }
  let declared = List<Constraint>.asSlice(&constraints)
  let binderCount = Shared<
    Result<Answer, NoRejection>
  >.with<usize>(&signature, signatureBinderCount)
  let representations = run representationsOf(declaration, binderCount, declared)
  let views = List<Option<Shared<Type>>>.asSlice(&representations)
  let mut retained = List<Shared<Lifetime>>.make()
  let known = run Type.retainedRegions(
    &run Type.applyBindings(&result, bindings, true),
    declaration,
    views,
    &mut retained, false
  )
  let output = List<Shared<Lifetime>>.asSlice(&retained)
  let written = run signatureParameterTypes(&signature)
  let parameters = List<Shared<Type>>.asSlice(&written)
  at = usize.ZERO
  while at < arguments.length {
    let mut keeps = !known || at >= parameters.length
    if at < parameters.length {
      let parameter = run Type.applyBindings(&parameters[at], bindings, true)
      let mut regions = List<Shared<Lifetime>>.make()
      if
        !run Type.retainedRegions(&parameter, declaration, views, &mut regions, false) {
        keeps = true
      }
      let mut required = usize.ZERO
      while required < output.length && !keeps {
        keeps = run callerContentsCover(declared, &parameter, &output[required])
        required = required + usize.ONE
      }
      let input = List<Shared<Lifetime>>.asSlice(&regions)
      let mut source = usize.ZERO
      while source < input.length && !keeps {
        let mut target = usize.ZERO
        while target < output.length && !keeps {
          keeps = run knownOutlives(declared, &input[source], &output[target])
          target = target + usize.ONE
        }
        source = source + usize.ONE
      }
    }
    if keeps {
      run List<BodyNodeId>.append(&mut selected, arguments[at])
    }
    at = at + usize.ONE
  }
  return move selected
}

// Producer-owned contract admission preserves the actual returned environment and target.
// The returned environment's local regions identify retained loans, rather than loans made
// while its body runs. Follow their capture operands to report OWN0018 at the borrowed root.
effect fn executableBorrowOrigin(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  nodes: &[BodyNode],
  node: BodyNodeId,
  caller: &DeclarationId,
  captured: bool,
  remaining: usize,
  span: Span
) -> Option<BodyOrigin>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
  if remaining == usize.ZERO {
    return Option<BodyOrigin>.none()
  }
  let entry = &nodes[node.index]
  let actual = match &entry.kind {
    BodyNodeKind.Expression { ty, .. } => Shared<Type>.clone(&ty)
    _ => {
      return Option<BodyOrigin>.none()
    }
  }
  let mut atoms = List<Shared<Lifetime>>.make()
  run Type.regionAtoms(&actual, &mut atoms)
  let regions = List<Shared<Lifetime>>.asSlice(&atoms)
  let mut local = false
  let mut at = usize.ZERO
  while at < regions.length {
    if callerLocalRegion(&regions[at], caller) {
      local = true
    }
    at = at + usize.ONE
  }
  if
    !local {
    return Option<BodyOrigin>.none()
  }
  if let BodyNodeKind.Expression { form, .. } = &entry.kind {
    let mut operands = List<BodyNodeId>.make()
    match &form {
      BodyExpression.Borrow { value, .. } => {
        let descriptor = match move bodyExpressionType(nodes, &value) {
          Option<Shared<Type>>.Some {
            value: borrowed
          } => Shared<Type>.with<bool>(&borrowed, borrowedView)
          _ => false
        }
        if
          !descriptor && ownedExecutableReceiver(nodes, value) {
          return Option<BodyOrigin>.some(entry.origin)
        }
      }
      BodyExpression.Local { local: binding } => {
        if captured && Shared<Type>.with<bool>(&actual, borrowedView) {
          return Option<BodyOrigin>.some(entry.origin)
        }

        // An immutable or mutable binding carries its initializer's environment. Search only
        // earlier nodes, so a local read cannot invent a capture from a later statement.
        let mut index = node.index
        while index != usize.ZERO {
          index = index - usize.ONE
          match &nodes[index].kind {
            BodyNodeKind.LocalBinding { local: candidate, initializer } => {
              if candidate.index == binding.index {
                return run executableBorrowOrigin(
                  &mut resolver.*,
                  &mut owner.*,
                  &mut dependencies.*,
                  nodes,
                  initializer,
                  caller,
                  captured,
                  remaining - usize.ONE,
                  span
                )
              }
            }
            BodyNodeKind.MutableBinding { local: candidate, initializer } => {
              if candidate.index == binding.index {
                return run executableBorrowOrigin(
                  &mut resolver.*,
                  &mut owner.*,
                  &mut dependencies.*,
                  nodes,
                  initializer,
                  caller,
                  captured,
                  remaining - usize.ONE,
                  span
                )
              }
            }
            _ => ()
          }
        }
      }
      BodyExpression.Callable { fields, .. } => {
        run appendByValueFields(List<BodyAggregateField>.asSlice(&fields), &mut operands)
      }

      // Named sections store trailing captures as ordinary aggregate fields.
      BodyExpression.Aggregate { fields, .. } => {
        run appendByValueFields(List<BodyAggregateField>.asSlice(&fields), &mut operands)
      }
      BodyExpression.ArrayRepeat {value, count} => {
        if count != usize.ZERO { run List<BodyNodeId>.append(&mut operands, value) }
      }
      BodyExpression.DirectCall { application, arguments, constructs, .. } => {
        let selected = run Application.copyShared(&application)
        operands = run executableCallOrigins(
          &mut resolver.*,
          &mut owner.*,
          &mut dependencies.*,
          &selected,
          List<BodyNodeId>.asSlice(&arguments),
          constructs,
          span
        )
      }
      BodyExpression.StagedCallable { callee, arguments, .. } => {
        run List<BodyNodeId>.append(&mut operands, callee)
        let values = List<BodyNodeId>.asSlice(&arguments)
        at = usize.ZERO
        while at < values.length {
          run List<BodyNodeId>.append(&mut operands, values[at])
          at = at + usize.ONE
        }
      }
      BodyExpression.Move { value, .. } => {
        return run executableBorrowOrigin(
          &mut resolver.*,
          &mut owner.*,
          &mut dependencies.*,
          nodes,
          value,
          caller,
          captured,
          remaining - usize.ONE,
          span
        )
      }
      BodyExpression.ArraySlice { value, .. } => {
        return run executableBorrowOrigin(
          &mut resolver.*,
          &mut owner.*,
          &mut dependencies.*,
          nodes,
          value,
          caller,
          captured,
          remaining - usize.ONE,
          span
        )
      }
      _ => ()
    }
    let values = List<BodyNodeId>.asSlice(&operands)
    at = usize.ZERO
    while at < values.length {
      let origin = run executableBorrowOrigin(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies.*,
        nodes,
        values[at],
        caller,
        true,
        remaining - usize.ONE,
        span
      )
      if let Option<BodyOrigin>.Some { .. } = &origin {
        return move origin
      }
      at = at + usize.ONE
    }
  }
  return Option<BodyOrigin>.none()
}

effect fn executableReturnRejection(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  module: &ModuleId,
  cursor: &AuthoredCursor,
  caller: &DeclarationId,
  nodes: &[BodyNode],
  node: BodyNodeId,
  failure: Shared<Rejection>,
  span: Span
) -> Shared<Rejection>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
  let lifetime = Shared<Rejection>.with<bool>(
    &failure,
    fn(diagnostic: &Rejection) -> bool {
      return diagnostic.code == RejectionCode.UnsatisfiedLifetimeBound
        || diagnostic.code == RejectionCode.ReturnTypeMismatch
        || valueMismatchReason(diagnostic.code)
    }
  )
  if lifetime {
    let found = run executableBorrowOrigin(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies.*,
      nodes,
      node,
      caller,
      false,
      nodes.length,
      span
    )
    if let Option<BodyOrigin>.Some { value: origin } = move found {
      // The second template names the borrowed local, filled from the borrow's own text.
      let mut diagnostic = run makeRejection(RejectionCode.ExecutableBorrowEscape, module, run originSpan(cursor, origin))
      diagnostic.related = Option<RelatedSite>.some(RelatedSite { module: ModuleId.copy(module), span: span })
      run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"template"), value: run Bytes.copy(b"1")})
      return run Shared<Rejection>.make(move diagnostic)
    }
  }
  return move failure
}

effect fn provePlainCallableReturn(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, module: &ModuleId, producer: &DeclarationId, nodes: &[BodyNode], node: BodyNodeId,
  contract: &Shared<Type>, declared: &[Constraint], span: Span) -> Option<Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let actual = match move bodyExpressionType(nodes, &node) {
    Option<Shared<Type>>.Some {value} => move value
    _ => { fail RevisionMismatch {} }
  }
  if Shared<Type>.with<bool>(&actual, neverType) { return Option<Shared<Rejection>>.none() }
  // A returned callable may retain a reborrow's body-local loan; the body's region check relates it
  // to the promised environment like a returned reference's (BORROW-005, LIFE-002).
  let mut deferral = Option<RegionDeferral>.some(RegionDeferral {caller: DeclarationId.copy(producer),
    pairs: List<RegionPair>.make()})
  let rejected = run proveCallableBound(&mut resolver.*, &mut owner.*, &mut dependencies.*, module,
    declared, &actual, contract, span, &mut deferral, RegionProof.Typing)
  if let Option<Shared<Rejection>>.Some {value} = move rejected {
    let mismatch = Shared<Rejection>.with<bool>(&value, fn(diagnostic: &Rejection) -> bool {
      return valueMismatchReason(diagnostic.code) || diagnostic.code == RejectionCode.IncompatibleCallableSignature
    })
    if mismatch { return Option<Shared<Rejection>>.some(run reject(&resolver.*, module, RejectionCode.ReturnTypeMismatch, span)) }
    return Option<Shared<Rejection>>.some(move value)
  }
  return run deferredReturnRefusal(&resolver.*, module, move deferral, span)
}

// The refusal of a return admission whose deferred relations nothing would relate: outside a body
// there is no region check to leave them to.
effect fn deferredReturnRefusal(resolver: &Resolver, module: &ModuleId, deferral: Option<RegionDeferral>, span: Span)
-> Option<Shared<Rejection>> ! OutOfMemoryError ? &mut Allocator {
  if let Option<RegionDeferral>.Some {value: open} = move deferral {
    if !relationsAdmitted(&resolver.*, List<RegionPair>.asSlice(&open.pairs)) {
      return Option<Shared<Rejection>>.some(run reject(&resolver.*, module, RejectionCode.ReturnTypeMismatch, span))
    }
  }
  return Option<Shared<Rejection>>.none()
}

effect fn proveOpaqueReturn(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, module: &ModuleId, producer: &DeclarationId,
  nodes: &[BodyNode], node: BodyNodeId, result: &Shared<Type>, declared: &[Constraint], span: Span)
  -> Option<Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let actual = match move bodyExpressionType(nodes, &node) {
    Option<Shared<Type>>.Some {value} => move value
    _ => { return Option<Shared<Rejection>>.some(run reject(&resolver.*, module, RejectionCode.ReturnTypeMismatch, span)) }
  }
  // An operand that exits supplies no outer construction. Its nested returns have their own
  // admission sites and reachable evidence; never is compatible with every result contract.
  if Shared<Type>.with<bool>(&actual, neverType) { return Option<Shared<Rejection>>.none() }
  let found = run Type.opaqueEvidence(&actual, result, producer)
  let evidence = match move found {
    Option<List<OpaqueEvidence>>.Some {value} => move value
    _ => { return Option<Shared<Rejection>>.some(run reject(&resolver.*, module, RejectionCode.ReturnTypeMismatch, span)) }
  }
  let leaves = List<OpaqueEvidence>.asSlice(&evidence)
  let mut at = usize.ZERO
  while at < leaves.length {
    let family = run Type.copy(&leaves[at].family)
    if let Type.OpaqueRepresentation {contract, detached, nonParking, ..} = move family {
      let effectContract = Shared<Type>.with<bool>(&contract, fn(ty: &Type) -> bool {
        return match &ty.* { Type.Effect {..} => true _ => false }
      })
      if effectContract {
        // An Effect with no exact representation, such as an interface operation's declared
        // `Effect<...>` result, has no storage to realize (named effect-form gap).
        if !Shared<Type>.with<bool>(&leaves[at].actual, joinableEffect) && !run representationParameter(&leaves[at].actual, declared) {
          return Option<Shared<Rejection>>.some(run reject(&resolver.*, module, RejectionCode.EffectFormUnavailable, span))
        }
        // A returned Effect may retain a reborrow's body-local loan; that relation to the promised
        // environment stays open on the body like a returned reference's (BORROW-005, LIFE-002).
        let mut deferral = Option<RegionDeferral>.some(RegionDeferral {caller: DeclarationId.copy(producer),
          pairs: List<RegionPair>.make()})
        if !run admitsEffect(&leaves[at].actual, &contract, declared, &mut deferral, RegionProof.Typing) {
          return Option<Shared<Rejection>>.some(run reject(&resolver.*, module, RejectionCode.ReturnTypeMismatch, span))
        }
        let retained = run deferredReturnRefusal(&resolver.*, module, move deferral, span)
        if let Option<Shared<Rejection>>.Some {value} = move retained { return Option<Shared<Rejection>>.some(move value) }
        // A detached family retains no caller loan, which callers and the borrow walk rely on, so
        // the exact Effect it returns must prove it (EXEC-004).
        if detached && !run provesDetached(declared, &leaves[at].actual, module) {
          return Option<Shared<Rejection>>.some(run reject(&resolver.*, module, RejectionCode.UnsatisfiedExecutableProperty, span))
        }
        at = at + usize.ONE
        continue
      }
      let mut callableDeferral = Option<RegionDeferral>.some(RegionDeferral {caller: DeclarationId.copy(producer),
        pairs: List<RegionPair>.make()})
      let failed = run proveCallableBound(&mut resolver.*, &mut owner.*, &mut dependencies.*, module,
        declared, &leaves[at].actual, &contract, span, &mut callableDeferral, RegionProof.Typing)
      if let Option<Shared<Rejection>>.Some {value} = move failed {
        let incompatible = Shared<Rejection>.with<bool>(&value, fn(diagnostic: &Rejection) -> bool {
          return valueMismatchReason(diagnostic.code) || diagnostic.code == RejectionCode.IncompatibleCallableSignature
        })
        if incompatible {
          return Option<Shared<Rejection>>.some(run reject(&resolver.*, module, RejectionCode.ReturnTypeMismatch, span))
        }
        return Option<Shared<Rejection>>.some(move value)
      }
      let retained = run deferredReturnRefusal(&resolver.*, module, move callableDeferral, span)
      if let Option<Shared<Rejection>>.Some {value} = move retained { return Option<Shared<Rejection>>.some(move value) }
      let unknown = run unknownOwnedCallableTypeReturn(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, &leaves[at].actual, span)
      if let Option<Shared<Rejection>>.Some {value} = move unknown { return Option<Shared<Rejection>>.some(move value) }
      // Sealed executable properties still need their own proof; contract admission does not
      // silently discharge them or the body's retained borrow-analysis obligations.
      if detached || nonParking {
        return Option<Shared<Rejection>>.some(run reject(&resolver.*, module, RejectionCode.Unsupported, span))
      }
    } else { fail RevisionMismatch {} }
    at = at + usize.ONE
  }
  return Option<Shared<Rejection>>.none()
}

// Whether the Effect contract `wanted` admits the exact Effect `offered` (EFF-009, EFF-013): its
// success converts (an equal type, a member of a wider union, or `never`), its failures and
// requirements are covered, it permits the promised run access, and its environment outlives
// the promised one. A representation parameter offers its bound's contract.
effect fn admitsEffect(offered: &Shared<Type>, wanted: &Shared<Type>, declared: &[Constraint],
  deferral: &mut Option<RegionDeferral>, proof: RegionProof) -> bool
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut given = Shared<Type>.with<Option<EffectParts>>(offered, effectParts)
  let missing = match &given { Option<EffectParts>.None => true _ => false }
  if missing {
    let mut at = usize.ZERO
    while at < declared.length {
      if let Constraint.Represents {parameter, contract} = &declared[at] {
        if run Type.equalsShared(offered, &parameter) { given = Shared<Type>.with<Option<EffectParts>>(&contract, effectParts) }
      }
      at = at + usize.ONE
    }
  }
  let left = match move given {
    Option<EffectParts>.Some {value} => move value
    Option<EffectParts>.None => { return false }
  }
  let right = match move Shared<Type>.with<Option<EffectParts>>(wanted, effectParts) {
    Option<EffectParts>.Some {value} => move value
    Option<EffectParts>.None => { return false }
  }
  return run admitsEffectParts(&left, &right, declared, &mut deferral.*, proof)
}

// Whether an offered Effect satisfies a wanted contract: its run access is no stronger, the wanted
// channels cover the offered ones, and its environment outlives the wanted one (EFF-013), which
// under `RegionProof.RegionCheck` the region check proves instead.
effect fn admitsEffectParts(left: &EffectParts, right: &EffectParts, declared: &[Constraint],
  deferral: &mut Option<RegionDeferral>, proof: RegionProof) -> bool
! OutOfMemoryError ? &mut Allocator | &mut Types {
  // A nested Effect family admits any Effect its contract admits (EFF-013).
  let success = match move Shared<Type>.with<Option<Shared<Type>>>(&right.success, effectFamilyContract) {
    Option<Shared<Type>>.Some {value: family} => run admitsEffect(&left.success, &family, declared, &mut deferral.*, proof)
    Option<Shared<Type>>.None => run Type.coversFailure(&right.success, &left.success)
  }
  return runStrength(left.mode) <= runStrength(right.mode)
    && success
    && (run Type.coversFailure(&right.failure, &left.failure))
    && (run Row.covers(&right.requirements, &left.requirements)) == RowCoverage.Covered
    && (proof == RegionProof.RegionCheck || run callableEnvironmentOutlives(&left.environment, &right.environment, declared, &mut deferral.*))
}

// Whether an Effect contract's success is itself a producer's Effect family.
fn nestedFamily(value: &Type) -> bool {
  return match &value.* {
    Type.Effect {success, ..} => match move Shared<Type>.with<Option<Shared<Type>>>(&success, effectFamilyContract) {
      Option<Shared<Type>>.Some {..} => true
      Option<Shared<Type>>.None => false
    }
    _ => false
  }
}

// The declared contract of a producer's Effect family, absent for any other type.
fn effectFamilyContract(value: &Type) -> Option<Shared<Type>> {
  if let Type.OpaqueRepresentation {contract, ..} = &value.* {
    if Shared<Type>.with<bool>(&contract, bareEffect) { return Option<Shared<Type>>.some(Shared<Type>.clone(&contract)) }
  }
  return Option<Shared<Type>>.none()
}

// Whether a declaration writes an explicit `some<...>` result, which keeps one realization
// (REP-005) rather than joining distinct returned Effects.
effect fn writtenOpaqueResult(resolver: &mut Resolver, module: &ModuleId, ordinal: usize) -> bool
! Cycle | OutOfMemoryError ? &mut Allocator {
  let written = run signatureSyntax(&mut resolver.*, module, ordinal)
  if let Option<WrittenSignature>.Some {value} = move written {
    if let Option<HirId>.Some {value: result} = move value.result {
      let syntax = run typeNode(&mut resolver.*, module, result)
      if let Option<HeaderSyntax>.Some {value: found} = move syntax {
        if let Node.OpaqueResultType {..} = found.header { return true }
      }
    }
  }
  return false
}

// A declared `Effect<...>` result stores whichever Effect a return selects: when the returns
// construct distinct exact Effects, each is injected into their finite join behind the declared
// contract, which every return was proven to satisfy (EFF-013).
effect fn joinEffectReturns(resolver: &Resolver, module: &ModuleId, nodes: &mut List<BodyNode>, contract: &Shared<Type>, anchor: &Anchor)
  -> Option<Shared<Rejection>> ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut returns = List<usize>.make()
  let mut alternatives = List<Shared<Type>>.make()
  let listed = List<BodyNode>.asSlice(&nodes.*)
  let mut at = usize.ZERO
  while at < listed.length {
    let mut returned = usize.MAX
    if let BodyNodeKind.Return {value: written} = &listed[at].kind {
      if let Option<BodyNodeId>.Some {value: node} = &written { returned = node.index }
    }
    if returned != usize.MAX {
      let value = BodyNodeId {index: returned}
      let produced = bodyExpressionType(listed, &value)
      if let Option<Shared<Type>>.Some {value: ty} = move produced {
        if !Shared<Type>.with<bool>(&ty, neverType) {
          run List<usize>.append(&mut returns, at)
          let stored = run joinAlternatives(&ty)
          let values = List<Shared<Type>>.asSlice(&stored)
          let mut item = usize.ZERO
          while item < values.length {
            if (run joinAlternative(List<Shared<Type>>.asSlice(&alternatives), &values[item])) == usize.MAX {
              run List<Shared<Type>>.append(&mut alternatives, Shared<Type>.clone(&values[item]))
            }
            item = item + usize.ONE
          }
        }
      }
    }
    at = at + usize.ONE
  }
  if List<Shared<Type>>.length(&alternatives) < 2 { return Option<Shared<Rejection>>.none() }
  let joined = run Types.intern(Type.EffectJoin {contract: Shared<Type>.clone(contract), alternatives: move alternatives})
  let sites = List<usize>.asSlice(&returns)
  at = usize.ZERO
  while at < sites.length {
    let node = BodyNodeId {index: sites[at]}
    let mut returned = usize.MAX
    if let BodyNodeKind.Return {value: written} = &List<BodyNode>.asSlice(&nodes.*)[node.index].kind {
      if let Option<BodyNodeId>.Some {value: selected} = &written { returned = selected.index }
    }
    let value = BodyNodeId {index: returned}
    let span = BodyOrigin.span(List<BodyNode>.asSlice(&nodes.*)[value.index].origin, anchor)
    let injected = match move run injectJoined(&mut nodes.*, value, &joined) {
      Option<BodyNodeId>.Some {value: selected} => selected
      Option<BodyNodeId>.None => { return Option<Shared<Rejection>>.some(run reject(resolver, module, RejectionCode.NestedEffectJoinUnavailable, span)) }
    }
    let previous = List<BodyNode>.remove(&mut nodes.*, node.index)
    run List<BodyNode>.insert(&mut nodes.*, node.index, BodyNode {origin: previous.origin,
      kind: BodyNodeKind.Return {value: Option<BodyNodeId>.some(injected)}})
    at = at + usize.ONE
  }
  return Option<Shared<Rejection>>.none()
}

// Whether a value is a representation parameter, whose argument supplies its exact storage.
effect fn representationParameter(value: &Shared<Type>, declared: &[Constraint]) -> bool ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut at = usize.ZERO
  while at < declared.length {
    if let Constraint.Represents {parameter, ..} = &declared[at] {
      if run Type.equalsShared(value, &parameter) { return true }
    }
    at = at + usize.ONE
  }
  return false
}

// Whether a value is an exact Effect a finite join may hold (EFF-013): an `effect fn`
// construction or Effect literal, a composition, a producer's Effect family, or a join.
fn joinableEffect(value: &Type) -> bool {
  return match &value.* {
    Type.CallableValue {contract, ..} => Shared<Type>.with<bool>(&contract, bareEffect)
    // An `effect fn` interface construction awaiting its witness is that witness's exact Effect.
    Type.CallableWitnessResult {witness} => Shared<WitnessRecipe>.with<bool>(&witness,
      fn(recipe: &WitnessRecipe) -> bool { return recipe.constructs })
    Type.EffectComposite {..} => true
    Type.EffectJoin {..} => true
    Type.OpaqueRepresentation {contract, ..} => Shared<Type>.with<bool>(&contract, bareEffect)
    _ => false
  }
}

// The exact Effects a value stores: a join's alternatives, or the value itself.
effect fn joinAlternatives(value: &Shared<Type>) -> List<Shared<Type>> ! OutOfMemoryError ? &mut Allocator {
  let copied = run Type.copy(value)
  if let Type.EffectJoin {alternatives, ..} = move copied { return move alternatives }
  let mut single = List<Shared<Type>>.make()
  run List<Shared<Type>>.append(&mut single, Shared<Type>.clone(value))
  return move single
}

// Replaces a checked expression's type; its storage is unchanged, as for a join view.
effect fn retypeNode(nodes: &mut List<BodyNode>, node: BodyNodeId, ty: Shared<Type>) -> () ! OutOfMemoryError ? &mut Allocator {
  let previous = List<BodyNode>.remove(&mut nodes.*, node.index)
  let form = match move previous.kind {
    BodyNodeKind.Expression {form, ..} => move form
    _ => absurd<BodyExpression>()
  }
  run List<BodyNode>.insert(&mut nodes.*, node.index, BodyNode {origin: previous.origin,
    kind: BodyNodeKind.Expression {ty: move ty, form: move form}})
  return ()
}

// Whether every value of a type is Copy. Scalars, the unit value, enums and shared references
// always are; a nominal record or union is Copy only when its module declares `impl Copy` for it,
// read through that module's Implementations query so the decision depends on the declaration; a
// structural union or fixed array is Copy when every member is.
effect fn copyType(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, ty: &Shared<Type>, constraints: &[Constraint], span: Span,
) -> Result<bool, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let active = List<Shared<Type>>.make()
  return run copyTypeWithin(&mut resolver.*, &mut owner.*, &mut dependencies.*, ty, constraints, span,
    List<Shared<Type>>.asSlice(&active))
}

// Discharge each ancestor independently when this edge consumes one of its concrete structural
// parts. A<B> -> B finishes A's obligation even if B later stores A<i32>. Do not discard an entire
// prefix: a descent through X<B<[i32; 1]>> must retain an older B<i32> growth obligation.
effect fn storedPropertyAncestors(ty: &Shared<Type>, active: &[Shared<Type>]) -> List<Shared<Type>>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut retained = List<Shared<Type>>.make()
  let mut at = usize.ZERO
  while at < active.length {
    if !run Type.strictRuntimeSubterm(ty, &active[at]) {
      run List<Shared<Type>>.append(&mut retained, Shared<Type>.clone(&active[at]))
    }
    at = at + usize.ONE
  }
  return move retained
}

fn storedPropertyCycle(ty: &Shared<Type>, active: &[Shared<Type>]) -> bool {
  let mut at = usize.ZERO
  while at < active.length {
    if sameNominal(ty, &active[at]) { return true }
    at = at + usize.ONE
  }
  return false
}

effect fn copyTypeWithin(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, ty: &Shared<Type>, constraints: &[Constraint], span: Span,
  active: &[Shared<Type>],
) -> Result<bool, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  // No sealed core is Copy; no source premise or conformance can make one Copy.
  if let Option<SealedKind>.Some {..} = move SealedCore.coreOf(ty) {
    return Result<bool, Shared<Rejection>>.succeed(false)
  }

  let mut premise = usize.ZERO
  while premise < constraints.length {
    if let Constraint.Copyable {subject} = &constraints[premise] {
      if run Type.equalsShared(ty, &subject) { return Result<bool, Shared<Rejection>>.succeed(true) }
    }
    if let Constraint.Represents {parameter, contract} = &constraints[premise] {
      if (run Type.equalsShared(ty, &parameter)) && Shared<Type>.with<bool>(&contract, sharedCallableType) {
        return Result<bool, Shared<Rejection>>.succeed(true)
      }
    }
    premise = premise + usize.ONE
  }
  let simple = Shared<Type>.with<bool>(ty, fn(value: &Type) -> bool {
    return match &value.* {
      Type.Unit => true
      // Every scalar primitive, including floats and `char`, is Copy.
      Type.Primitive {name} => primitive(Bytes.asSlice(&name))
      // A SIMD vector or mask is a plain value of its lanes (SIMD-001).
      Type.Vector {..} => true
      Type.Reference {access, ..} => access == Access.Shared
      Type.Slice {access, ..} => access == Access.Shared
      // A raw pointer holds no ownership or loan, so every pointee and qualifier is Copy.
      Type.ForeignFunction {..} => true
      Type.Pointer {..} => true
      // `string` is a Copy view (TEXT-001).
      Type.String {..} => true
      Type.Callable {mode, ..} => mode == CallableMode.Shared
      Type.CallableValue {contract, ..} => Shared<Type>.with<CallableMode>(&contract, callableInvocationMode) == CallableMode.Shared
      Type.CallableOrigin {contract, ..} => Shared<Type>.with<CallableMode>(&contract, callableInvocationMode) == CallableMode.Shared
      Type.CallableWitnessResult {witness} => {
        let recipe = Shared<WitnessRecipe>.with<WitnessRecipe>(&witness, CallableWitness.copy)
        return Shared<Type>.with<CallableMode>(&recipe.result, callableInvocationMode) == CallableMode.Shared
      }
      Type.CallableResult {contract, ..} => Shared<Type>.with<CallableMode>(&contract, callableInvocationMode) == CallableMode.Shared
      Type.CallableStage {contract, ..} => Shared<Type>.with<CallableMode>(&contract, callableInvocationMode) == CallableMode.Shared
      Type.CallableSchema {schema, ..} => Shared<Type>.with<CallableMode>(&sectionSchemaContract(&schema), callableInvocationMode) == CallableMode.Shared
      Type.CallableView {contract, ..} => Shared<Type>.with<bool>(&contract, sharedCallableType)
      Type.OpaqueRepresentation {contract, ..} => Shared<Type>.with<bool>(&contract, sharedCallableType)
      Type.Nominal {..} => nominalKind(value) == OwnerKind.Enumeration
      _ => false
    }
  })
  if simple { return Result<bool, Shared<Rejection>>.succeed(true) }
  let mut nested = run storedPropertyAncestors(ty, active)
  let node = run Type.copy(ty)
  // A closed producer's Effect family is Copy exactly when the storage it realizes to is: its
  // environment is Copy when every capture is (CAPTURE-002). The declared contract alone never is.
  // Inside its own producer a family is not yet realized, so it is not proven Copy there; a
  // capture of it is reported as an inline layout cycle where its layout is demanded.
  if let Type.OpaqueRepresentation {application, ..} = &node {
    if Type.hasOpenRuntimeParameters(ty) { return Result<bool, Shared<Rejection>>.succeed(false) }
    if run activeOpaqueProducer(&mut resolver.*, &application) { return Result<bool, Shared<Rejection>>.succeed(false) }
    let storage = match move run realizedOpaqueStorage(&mut resolver.*, &mut owner.*, &mut dependencies.*, &application, ty, span) {
      Result<Shared<Type>, Shared<Rejection>>.Success {value} => move value
      Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result<bool, Shared<Rejection>>.failResult(move error) }
    }
    return run copyTypeWithin(&mut resolver.*, &mut owner.*, &mut dependencies.*, &storage, constraints, span,
      List<Shared<Type>>.asSlice(&nested))
  }
  let mut members = List<Shared<Type>>.make()
  let mut composite = false
  if let Type.Union {members: listedMembers} = &node {
    members = run copyTypes(List<Shared<Type>>.asSlice(&listedMembers))
    composite = true
  }
  // A join is Copy only when every alternative it may store is (CAPTURE-002).
  if let Type.EffectJoin {alternatives, ..} = &node {
    members = run copyTypes(List<Shared<Type>>.asSlice(&alternatives))
    composite = true
  }
  if let Type.Array {element, ..} = &node {
    run List<Shared<Type>>.append(&mut members, Shared<Type>.clone(&element))
    composite = true
  }
  if composite {
    let listed = List<Shared<Type>>.asSlice(&members)
    let mut at = usize.ZERO
    while at < listed.length {
      let member = run copyTypeWithin(&mut resolver.*, &mut owner.*, &mut dependencies.*, &listed[at], constraints, span,
        List<Shared<Type>>.asSlice(&nested))
      match move member {
        Result<bool, Shared<Rejection>>.Success {value} => { if !value { return Result<bool, Shared<Rejection>>.succeed(false) } }
        Result<bool, Shared<Rejection>>.Failure {error} => { return Result<bool, Shared<Rejection>>.failResult(move error) }
      }
      at = at + usize.ONE
    }
    return Result<bool, Shared<Rejection>>.succeed(true)
  }
  // Growing<i32> -> Growing<[i32; 1]> and exact inline cycles cannot prove Copy. NotCopy
  // makes the selecting implementation reject its field loudly at its own module and impl
  // span, rather than attaching an enclosing span to the repeated type's declaration module.
  if storedPropertyCycle(ty, List<Shared<Type>>.asSlice(&nested)) {
    return Result<bool, Shared<Rejection>>.succeed(false)
  }
  run List<Shared<Type>>.append(&mut nested, Shared<Type>.clone(ty))
  return run implementsSealedWithin(&mut resolver.*, &mut owner.*, &mut dependencies.*, ty, SealedProperty.Copy,
    constraints, span, List<Shared<Type>>.asSlice(&nested))
}

// Whether `ty` has thread property `property` (THREAD-002). A premise `T: Transferable` or
// `T: Concurrent` proves itself; scalars, text and enums always hold; a raw pointer never does,
// since it may alias storage another thread uses. A shared borrow moves or shares its referent's
// shared access, so it needs a Concurrent referent; an exclusive borrow needs the property itself.
// A structural or nominal aggregate holds when every stored part does, and an `impl` of the
// property in the declaring module asserts it for a nominal whose parts cannot prove it
// (THREAD-003). An exact nominal repeat is coinductive; a growing repeat cannot be proved.
effect fn threadSafeWithin(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, ty: &Shared<Type>, property: SealedProperty, constraints: &[Constraint],
  span: Span, active: &[Shared<Type>],
) -> Result<bool, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut premise = usize.ZERO
  while premise < constraints.length {
    if let Constraint.ThreadSafe {subject, property: assumed} = &constraints[premise] {
      if assumed == property && run Type.equalsShared(ty, &subject) {
        return Result<bool, Shared<Rejection>>.succeed(true)
      }
    }
    premise = premise + usize.ONE
  }
  let mut nested = run storedPropertyAncestors(ty, active)
  let mut parts = List<Shared<Type>>.make()
  let mut partProperty = property
  // Allocation storage is owned outright; a buffer or slot is as safe as its element. A shared
  // core counts references without atomics, and an execution package is bound to its executor.
  if let Option<SealedKind>.Some {value: core} = move SealedCore.coreOf(ty) {
    return match core {
      SealedKind.Allocation => Result<bool, Shared<Rejection>>.succeed(true)
      SealedKind.StorageFailure => Result<bool, Shared<Rejection>>.succeed(true)
      SealedKind.RawBuffer => match move SealedCore.element(ty) {
        Option<Shared<Type>>.Some {value} => run threadSafeWithin(&mut resolver.*, &mut owner.*, &mut dependencies.*,
          &value, property, constraints, span, List<Shared<Type>>.asSlice(&nested))
        Option<Shared<Type>>.None => Result<bool, Shared<Rejection>>.succeed(false)
      }
      SealedKind.Slot => match move SealedCore.element(ty) {
        Option<Shared<Type>>.Some {value} => run threadSafeWithin(&mut resolver.*, &mut owner.*, &mut dependencies.*,
          &value, property, constraints, span, List<Shared<Type>>.asSlice(&nested))
        Option<Shared<Type>>.None => Result<bool, Shared<Rejection>>.succeed(false)
      }
      _ => Result<bool, Shared<Rejection>>.succeed(false)
    }
  }
  let node = run Type.copy(ty)
  match &node {
    Type.Unit => { return Result<bool, Shared<Rejection>>.succeed(true) }
    Type.Primitive {..} => { return Result<bool, Shared<Rejection>>.succeed(true) }
    Type.String {..} => { return Result<bool, Shared<Rejection>>.succeed(true) }
    Type.ForeignFunction {..} => { return Result<bool, Shared<Rejection>>.succeed(true) }
    Type.Reference {referent, access, ..} => {
      if access == Access.Shared { partProperty = SealedProperty.Concurrent }
      run List<Shared<Type>>.append(&mut parts, Shared<Type>.clone(&referent))
    }
    Type.Slice {element, access, ..} => {
      if access == Access.Shared { partProperty = SealedProperty.Concurrent }
      run List<Shared<Type>>.append(&mut parts, Shared<Type>.clone(&element))
    }
    Type.Array {element, ..} => { run List<Shared<Type>>.append(&mut parts, Shared<Type>.clone(&element)) }
    Type.Union {members} => { parts = run copyTypes(List<Shared<Type>>.asSlice(&members)) }
    Type.Anonymous {members, ..} => { parts = run copyTypes(List<Shared<Type>>.asSlice(&members)) }
    Type.CallableValue {captures, ..} => { parts = run copyTypes(List<Shared<Type>>.asSlice(&captures)) }
    Type.CallableSchema {captures, ..} => { parts = run copyTypes(List<Shared<Type>>.asSlice(&captures)) }
    Type.CallableView {representation, ..} => { run List<Shared<Type>>.append(&mut parts, Shared<Type>.clone(&representation)) }
    Type.EffectComposite {parts: stored, ..} => { parts = run copyTypes(List<Shared<Type>>.asSlice(&stored)) }
    Type.EffectJoin {alternatives, ..} => { parts = run copyTypes(List<Shared<Type>>.asSlice(&alternatives)) }
    Type.CallableStage {base, captures, ..} => {
      run List<Shared<Type>>.append(&mut parts, Shared<Type>.clone(&base))
      let supplied = List<Shared<Type>>.asSlice(&captures)
      let mut at = usize.ZERO
      while at < supplied.length {
        run List<Shared<Type>>.append(&mut parts, Shared<Type>.clone(&supplied[at]))
        at = at + usize.ONE
      }
    }
    // A closed producer's family is as safe as the storage it realizes to, as for Copy.
    Type.OpaqueRepresentation {application, ..} => {
      if Type.hasOpenRuntimeParameters(ty) { return Result<bool, Shared<Rejection>>.succeed(false) }
      if run activeOpaqueProducer(&mut resolver.*, &application) { return Result<bool, Shared<Rejection>>.succeed(false) }
      let storage = match move run realizedOpaqueStorage(&mut resolver.*, &mut owner.*, &mut dependencies.*, &application, ty, span) {
        Result<Shared<Type>, Shared<Rejection>>.Success {value} => move value
        Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result<bool, Shared<Rejection>>.failResult(move error) }
      }
      run List<Shared<Type>>.append(&mut parts, move storage)
    }
    Type.Nominal {..} => {
      if nominalKind(&node) == OwnerKind.Enumeration { return Result<bool, Shared<Rejection>>.succeed(true) }
      let mut at = usize.ZERO
      while at < active.length {
        if run Type.equalsShared(ty, &active[at]) { return Result<bool, Shared<Rejection>>.succeed(true) }
        at = at + usize.ONE
      }
      if storedPropertyCycle(ty, List<Shared<Type>>.asSlice(&nested)) {
        return Result<bool, Shared<Rejection>>.succeed(false)
      }
      run List<Shared<Type>>.append(&mut nested, Shared<Type>.clone(ty))
      let asserted = run implementsSealedWithin(&mut resolver.*, &mut owner.*, &mut dependencies.*, ty, property,
        constraints, span, List<Shared<Type>>.asSlice(&nested))
      match move asserted {
        Result<bool, Shared<Rejection>>.Success {value} => { if value { return Result<bool, Shared<Rejection>>.succeed(true) } }
        Result<bool, Shared<Rejection>>.Failure {error} => { return Result<bool, Shared<Rejection>>.failResult(move error) }
      }
      parts = match move run nominalParts(&mut resolver.*, &mut owner.*, &mut dependencies.*, ty, span) {
        Result<List<Shared<Type>>, Shared<Rejection>>.Success {value} => move value
        Result<List<Shared<Type>>, Shared<Rejection>>.Failure {error} => { return Result<bool, Shared<Rejection>>.failResult(move error) }
      }
    }
    _ => { return Result<bool, Shared<Rejection>>.succeed(false) }
  }
  let listed = List<Shared<Type>>.asSlice(&parts)
  let mut at = usize.ZERO
  while at < listed.length {
    let part = run threadSafeWithin(&mut resolver.*, &mut owner.*, &mut dependencies.*, &listed[at], partProperty,
      constraints, span, List<Shared<Type>>.asSlice(&nested))
    match move part {
      Result<bool, Shared<Rejection>>.Success {value} => { if !value { return Result<bool, Shared<Rejection>>.succeed(false) } }
      Result<bool, Shared<Rejection>>.Failure {error} => { return Result<bool, Shared<Rejection>>.failResult(move error) }
    }
    at = at + usize.ONE
  }
  return Result<bool, Shared<Rejection>>.succeed(true)
}

// A selected sealed head retains the exact provider match for its hook application.
struct SealedMatch {
  declaration: Shared<DeclarationId>,
  bindings: List<Binding>,
  span: Span,
}

// Bound absence is distinct from missing proof. In particular, unavailable evidence may never
// suppress a potentially applicable Drop hook.
enum BoundProof { Proven, Rejected, Unavailable }

effect fn boundProof(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, bound: &Constraint, declared: &[Constraint],
  context: &DeclarationId, module: &ModuleId, span: Span,
  active: &[Shared<Type>],
) -> Result<BoundProof, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  if let Constraint.Copyable {subject} = &bound.* {
    if let Option<SealedKind>.Some {..} = move SealedCore.coreOf(&subject) {
      return Result<BoundProof, Shared<Rejection>>.succeed(BoundProof.Rejected)
    }
  }

  let mut at = usize.ZERO
  while at < declared.length {
    if run sameConstraint(bound, &declared[at]) {
      return Result<BoundProof, Shared<Rejection>>.succeed(BoundProof.Proven)
    }
    at = at + usize.ONE
  }
  if let Constraint.Copyable {subject} = &bound.* {
    let copied = run copyTypeWithin(&mut resolver.*, &mut owner.*, &mut dependencies.*, &subject, declared, span, active)
    return match move copied {
      Result<bool, Shared<Rejection>>.Success {value} => {
        if value { return Result<BoundProof, Shared<Rejection>>.succeed(BoundProof.Proven) }
        if Type.hasOpenRuntimeParameters(&subject) {
          return Result<BoundProof, Shared<Rejection>>.succeed(BoundProof.Unavailable)
        }
        return Result<BoundProof, Shared<Rejection>>.succeed(BoundProof.Rejected)
      }
      Result<bool, Shared<Rejection>>.Failure {error} => Result<BoundProof, Shared<Rejection>>.failResult(move error)
    }
  }
  if let Constraint.ThreadSafe {subject, property} = &bound.* {
    let safe = run threadSafeWithin(&mut resolver.*, &mut owner.*, &mut dependencies.*, &subject, property, declared, span, active)
    return match move safe {
      Result<bool, Shared<Rejection>>.Success {value} => {
        if value { return Result<BoundProof, Shared<Rejection>>.succeed(BoundProof.Proven) }
        if Type.hasOpenRuntimeParameters(&subject) {
          return Result<BoundProof, Shared<Rejection>>.succeed(BoundProof.Unavailable)
        }
        return Result<BoundProof, Shared<Rejection>>.succeed(BoundProof.Rejected)
      }
      Result<bool, Shared<Rejection>>.Failure {error} => Result<BoundProof, Shared<Rejection>>.failResult(move error)
    }
  }
  if let Constraint.Outlives {longer, shorter} = &bound.* {
    if run knownOutlives(declared, &longer, &shorter) {
      return Result<BoundProof, Shared<Rejection>>.succeed(BoundProof.Proven)
    }
    if Lifetime.anyAtom(&longer, localLifetime) && Shared<Lifetime>.with<bool>(&shorter, staticLifetime) {
      return Result<BoundProof, Shared<Rejection>>.succeed(BoundProof.Rejected)
    }
    return Result<BoundProof, Shared<Rejection>>.succeed(BoundProof.Unavailable)
  }
  if let Constraint.Contents {subject, region} = &bound.* {
    let representations = List<Option<Shared<Type>>>.make()
    let mut retained = List<Shared<Lifetime>>.make()
    if !run Type.retainedRegions(&subject, context, List<Option<Shared<Type>>>.asSlice(&representations), &mut retained, false) {
      return Result<BoundProof, Shared<Rejection>>.succeed(BoundProof.Unavailable)
    }
    let regions = List<Shared<Lifetime>>.asSlice(&retained)
    at = usize.ZERO
    while at < regions.length {
      if !run knownOutlives(declared, &regions[at], &region) {
        if Lifetime.anyAtom(&regions[at], localLifetime) && Shared<Lifetime>.with<bool>(&region, staticLifetime) {
          return Result<BoundProof, Shared<Rejection>>.succeed(BoundProof.Rejected)
        }
        return Result<BoundProof, Shared<Rejection>>.succeed(BoundProof.Unavailable)
      }
      at = at + usize.ONE
    }
    return Result<BoundProof, Shared<Rejection>>.succeed(BoundProof.Proven)
  }
  if let Constraint.Conforms {provider, contract} = &bound.* {
    let goal = ConformanceGoal {provider: Shared<Type>.clone(&provider), contract: Shared<Type>.clone(&contract)}
    let mut request = Request.make()
    let mut chain = List<ConformanceGoal>.make()
    let mut steps = List<ConformanceStep>.make()
    let avoid = Option<Shared<DeclarationId>>.some(run Shared<DeclarationId>.make(DeclarationId.copy(context)))
    let failed = run proveGoal(&mut resolver.*, &mut owner.*, &mut request, &mut dependencies.*,
      true, &avoid, &goal, declared, module, span, &mut chain, &mut steps)
    if let Option<Shared<Rejection>>.Some {value} = move failed {
      let missing = Shared<Rejection>.with<bool>(&value, fn(problem: &Rejection) -> bool {
        return problem.code == RejectionCode.MissingConformance
      })
      if missing {
        if !Type.hasOpenParameters(&provider) && !Type.hasOpenParameters(&contract) {
          return Result<BoundProof, Shared<Rejection>>.succeed(BoundProof.Rejected)
        }
        return Result<BoundProof, Shared<Rejection>>.succeed(BoundProof.Unavailable)
      }
      if Shared<Rejection>.with<bool>(&value, fn(problem: &Rejection) -> bool {
        return problem.code == RejectionCode.Unsupported
      }) {
        return Result<BoundProof, Shared<Rejection>>.succeed(BoundProof.Unavailable)
      }
      return Result<BoundProof, Shared<Rejection>>.failResult(move value)
    }
    return Result<BoundProof, Shared<Rejection>>.succeed(BoundProof.Proven)
  }
  // A closed callable representation is proved as a call's bound is (`proveCallableBound`): a sealed
  // `impl<F: fn(i32) -> i32> Copy for Parser<F>` then applies to each realized field, whose Copy
  // property decides the instance (BORROW-008). An open one waits for its instance.
  if let Constraint.Represents {parameter, contract} = &bound.* {
    if Type.hasOpenRuntimeParameters(&parameter) {
      return Result<BoundProof, Shared<Rejection>>.succeed(BoundProof.Unavailable)
    }
    let mut strict = Option<RegionDeferral>.none()
    let failed = run proveCallableBound(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, declared,
      &parameter, &contract, span, &mut strict, RegionProof.Typing)
    if let Option<Shared<Rejection>>.Some {value} = move failed {
      if Shared<Rejection>.with<bool>(&value, fn(problem: &Rejection) -> bool { return problem.code == RejectionCode.Unsupported }) {
        return Result<BoundProof, Shared<Rejection>>.succeed(BoundProof.Unavailable)
      }
      return Result<BoundProof, Shared<Rejection>>.succeed(BoundProof.Rejected)
    }
    return Result<BoundProof, Shared<Rejection>>.succeed(BoundProof.Proven)
  }
  // Executable property proofs are later-stage facts. Exact lexical evidence above is usable now;
  // lack of a concrete prover remains explicit rather than absence of the head.
  return Result<BoundProof, Shared<Rejection>>.succeed(BoundProof.Unavailable)
}

// Exact applicability and retained substitutions of one sealed-property head.
effect fn sealedHeadMatch(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, head: &Shared<ImplementationHead>,
  ty: &Shared<Type>, property: SealedProperty, declared: &[Constraint], module: &ModuleId, span: Span,
) -> Result<Option<SealedMatch>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let active = List<Shared<Type>>.make()
  return run sealedHeadMatchWithin(&mut resolver.*, &mut owner.*, &mut dependencies.*, head, ty, property,
    declared, module, span, List<Shared<Type>>.asSlice(&active))
}

// The coherence verdict of one sealed head, demanded from the module that declares it.
effect fn sealedCoherence(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, head: &Shared<ImplementationHead>, module: &ModuleId, span: Span,
) -> Option<Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let declaration = Shared<ImplementationHead>.with<Shared<DeclarationId>>(
    head, fn(value: &ImplementationHead) -> Shared<DeclarationId> { return Shared<DeclarationId>.clone(&value.declaration) },
  )
  let headModule = Shared<DeclarationId>.with<usize>(&declaration, fn(value: &DeclarationId) -> usize {
    return knownModuleOrdinal(&resolver.*, DeclarationId.moduleId(value))
  })
  if headModule == usize.MAX { fail InvalidModulePath {} }
  let headSource = resolvedModule(&resolver.*, headModule)
  let position = match move run ordinalOfIdentity(&mut resolver.*, &headSource, &declaration) {
    Option<usize>.Some {value} => value
    Option<usize>.None => { return CompilerBug.panic(b"MissingRetainedFact: sealedCoherence") }
  }
  let declarationAccess132Request = Key {
    family: Family.Coherence, module: headModule, name: usize.ZERO, declaration: position, member: usize.ZERO, external: false,
  }
  let declarationAccess132 = run internDeclaration(&mut resolver.*, declarationAccess132Request)
  let coherence = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, declarationAccess132, span)
  return Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(&coherence, answerCause)
}

effect fn sealedHeadMatchWithin(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, head: &Shared<ImplementationHead>,
  ty: &Shared<Type>, property: SealedProperty, declared: &[Constraint], module: &ModuleId, span: Span,
  active: &[Shared<Type>],
) -> Result<Option<SealedMatch>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let headSpan = Shared<ImplementationHead>.with<Span>(head, fn(value: &ImplementationHead) -> Span { return value.span })
  let matchesProperty = Shared<ImplementationHead>.with<bool>(head, fn(value: &ImplementationHead) -> bool {
    return match &value.kind {
      ImplementationKind.Sealed {property: found} => found == property
      _ => false
    }
  })
  if !matchesProperty { return Result<Option<SealedMatch>, Shared<Rejection>>.succeed(Option<SealedMatch>.none()) }
  // Every head requesting the property must be coherent before any of them may be selected.
  let incoherent = run sealedCoherence(&mut resolver.*, &mut owner.*, &mut dependencies.*, head, module, span)
  if let Option<Shared<Rejection>>.Some {value} = move incoherent {
    return Result<Option<SealedMatch>, Shared<Rejection>>.failResult(move value)
  }
  let declaration = Shared<ImplementationHead>.with<Shared<DeclarationId>>(
    head, fn(value: &ImplementationHead) -> Shared<DeclarationId> { return Shared<DeclarationId>.clone(&value.declaration) },
  )
  let provider = Shared<ImplementationHead>.with<Shared<Type>>(
    head, fn(value: &ImplementationHead) -> Shared<Type> { return Shared<Type>.clone(&value.provider) },
  )
  // Most heads name another type: their outer nodes already decide that unification is distinct.
  if Type.headsDistinct(&provider, ty) {
    return Result<Option<SealedMatch>, Shared<Rejection>>.succeed(Option<SealedMatch>.none())
  }
  let mut variables = List<Shared<DeclarationId>>.make()
  run List<Shared<DeclarationId>>.append(&mut variables, Shared<DeclarationId>.clone(&declaration))
  let context = DeclarationId.copyShared(&declaration)
  let mut patterns = List<Shared<Type>>.make()
  run List<Shared<Type>>.append(&mut patterns, move provider)
  let mut instances = List<Shared<Type>>.make()
  run List<Shared<Type>>.append(&mut instances, Shared<Type>.clone(ty))
  let mut bindings = List<Binding>.make()
  let matched = run Type.unifyAll(List<Shared<Type>>.asSlice(&patterns), List<Shared<Type>>.asSlice(&instances),
    List<Shared<DeclarationId>>.asSlice(&variables), Comparison.Exact, &mut bindings)
  if exactHeadUndetermined(&matched) {
    return Result<Option<SealedMatch>, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Unsupported, span))
  }
  if !exactHeadMatched(&matched) { return Result<Option<SealedMatch>, Shared<Rejection>>.succeed(Option<SealedMatch>.none()) }
  let count = Shared<ImplementationHead>.with<usize>(head, headConstraintCount)
  let mut at = usize.ZERO
  let mut unavailable = false
  while at < count {
    let written = match move Shared<ImplementationHead>.with<Option<Constraint>>(
      head, fn(value: &ImplementationHead) -> Option<Constraint> { return headConstraintAt(value, at) },
    ) {
      Option<Constraint>.Some {value} => move value
      Option<Constraint>.None => {
        return Result<Option<SealedMatch>, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Unsupported, span))
      }
    }
    let applied = run applyConstraintBindings(&written, List<Binding>.asSlice(&bindings))
    let mut proofSpan = span
    if property == SealedProperty.Copy { proofSpan = headSpan }
    let proved = run boundProof(&mut resolver.*, &mut owner.*, &mut dependencies.*, &applied, declared, &context, module, proofSpan, active)
    match move proved {
      Result<BoundProof, Shared<Rejection>>.Success {value} => match value {
        BoundProof.Proven => ()
        BoundProof.Rejected => { return Result<Option<SealedMatch>, Shared<Rejection>>.succeed(Option<SealedMatch>.none()) }
        BoundProof.Unavailable => { unavailable = true }
      }
      Result<BoundProof, Shared<Rejection>>.Failure {error} => {
        return Result<Option<SealedMatch>, Shared<Rejection>>.failResult(move error)
      }
    }
    at = at + usize.ONE
  }
  if unavailable {
    // Check every premise first: a disproved bound rules out the head regardless of bound order.
    // Abstract Copy may conservatively be affine and an abstract thread property may be unproved;
    // unavailable Drop evidence remains a loud gap.
    if property != SealedProperty.Drop && Type.hasOpenParameters(ty) {
      return Result<Option<SealedMatch>, Shared<Rejection>>.succeed(Option<SealedMatch>.none())
    }
    return Result<Option<SealedMatch>, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Unsupported, span))
  }
  return Result<Option<SealedMatch>, Shared<Rejection>>.succeed(Option<SealedMatch>.some(
    SealedMatch {declaration: move declaration, bindings: move bindings, span: headSpan},
  ))
}

// Whether the declaring module of a nominal type implements sealed `property` for exactly it, read
// through that module's Implementations query so the decision depends on the declaration.
effect fn implementsSealed(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, ty: &Shared<Type>, property: SealedProperty, declared: &[Constraint], span: Span,
) -> Result<bool, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let active = List<Shared<Type>>.make()
  return run implementsSealedWithin(&mut resolver.*, &mut owner.*, &mut dependencies.*, ty, property,
    declared, span, List<Shared<Type>>.asSlice(&active))
}

effect fn implementsSealedWithin(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, ty: &Shared<Type>, property: SealedProperty, declared: &[Constraint], span: Span,
  active: &[Shared<Type>],
) -> Result<bool, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  if !Shared<Type>.with<bool>(ty, isNominalType) { return Result<bool, Shared<Rejection>>.succeed(false) }
  let module = declaringModuleOrdinal(&resolver.*, ty)
  if module == usize.MAX { return Result<bool, Shared<Rejection>>.succeed(false) }
  let siteModule = resolvedModule(&resolver.*, module)
  // Shapes, as in `sealedCandidates`: a head proving its obligations reaches this catalog.
  let declarationAccess133Request = Key {
    family: Family.ImplementationShapes, module: module, name: usize.ZERO,
    declaration: usize.ZERO, member: usize.ZERO, external: false,
  }
  let declarationAccess133 = run internDeclaration(&mut resolver.*, declarationAccess133Request)
  let listKey = declarationAccess133
  let listed = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, listKey, span)
  let failed = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(&listed, answerCause)
  if let Option<Shared<Rejection>>.Some {value} = move failed { return Result<bool, Shared<Rejection>>.failResult(move value) }
  // A head can match only through its provider's owner, or through a provider without one, so
  // only those two buckets of the catalog are read, merged back into head order.
  let ownerHash = Shared<Type>.with<u64>(ty, providerOwnerHash)
  let mut owned = Shared<Result<Answer, NoRejection>>.with<usize>(&listed,
    fn(answer: &Result<Answer, NoRejection>) -> usize { return firstOwnedHead(answer, ownerHash) })
  let mut unowned = Shared<Result<Answer, NoRejection>>.with<usize>(&listed,
    fn(answer: &Result<Answer, NoRejection>) -> usize { return firstOwnedHead(answer, unownedProviderHash) })
  while owned != usize.MAX || unowned != usize.MAX {
    let mut at = owned
    if unowned < at { at = unowned }
    if at == owned {
      owned = Shared<Result<Answer, NoRejection>>.with<usize>(&listed,
        fn(answer: &Result<Answer, NoRejection>) -> usize { return nextOwnedHead(answer, at) })
    } else {
      unowned = Shared<Result<Answer, NoRejection>>.with<usize>(&listed,
        fn(answer: &Result<Answer, NoRejection>) -> usize { return nextOwnedHead(answer, at) })
    }
    let candidate = Shared<Result<Answer, NoRejection>>.with<Option<Shared<ImplementationHead>>>(
      &listed, fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<ImplementationHead>> {
        return implementationAt(answer, at)
      },
    )
    if let Option<Shared<ImplementationHead>>.Some {value: head} = move candidate {
      let matched = run sealedHeadMatchWithin(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies.*,
        &head,
        ty,
        property,
        declared,
        &siteModule,
        span,
        active,
      )
      match move matched {
        Result<Option<SealedMatch>, Shared<Rejection>>.Success {value} => {
          if let Option<SealedMatch>.Some {value: selected} = move value {
            if property == SealedProperty.Copy {
              let dropping = run implementsSealedWithin(&mut resolver.*, &mut owner.*, &mut dependencies.*, ty,
                SealedProperty.Drop, declared, selected.span, active)
              match move dropping {
                Result<bool, Shared<Rejection>>.Success {value: ownDrop} => {
                  if ownDrop {
                    return Result<bool, Shared<Rejection>>.failResult(run copyConformanceRejection(&siteModule, selected.span, ty,
                      Option<&Shared<Type>>.none()))
                  }
                }
                Result<bool, Shared<Rejection>>.Failure {error} => { return Result<bool, Shared<Rejection>>.failResult(move error) }
              }
              let stored = run nominalParts(&mut resolver.*, &mut owner.*, &mut dependencies.*, ty, selected.span)
              let fields = match move stored {
                Result<List<Shared<Type>>, Shared<Rejection>>.Success {value: parts} => move parts
                Result<List<Shared<Type>>, Shared<Rejection>>.Failure {error} => { return Result<bool, Shared<Rejection>>.failResult(move error) }
              }
              let parts = List<Shared<Type>>.asSlice(&fields)
              let mut field = usize.ZERO
              while field < parts.length {
                let copied = run copyTypeWithin(&mut resolver.*, &mut owner.*, &mut dependencies.*, &parts[field], declared, selected.span, active)
                match move copied {
                  Result<bool, Shared<Rejection>>.Success {value: isCopy} => {
                    if !isCopy {
                      return Result<bool, Shared<Rejection>>.failResult(run copyConformanceRejection(&siteModule, selected.span, ty,
                        Option<&Shared<Type>>.some(&parts[field])))
                    }
                  }
                  Result<bool, Shared<Rejection>>.Failure {error} => { return Result<bool, Shared<Rejection>>.failResult(move error) }
                }
                field = field + usize.ONE
              }
            }
            return Result<bool, Shared<Rejection>>.succeed(true)
          }
        }
        Result<Option<SealedMatch>, Shared<Rejection>>.Failure {error} => {
          return Result<bool, Shared<Rejection>>.failResult(move error)
        }
      }
    }
  }
  return Result<bool, Shared<Rejection>>.succeed(false)
}

// Whether a nominal type that names a type parameter, at any depth, has a `Drop` impl for some
// instantiation: a head written for particular arguments, or under bounds this body cannot prove,
// runs at an instance even when no head matches the open type here. Only cleanup asks this, so a
// generic body never takes such a value's cleanup for none.
effect fn specializedDrop(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, ty: &Shared<Type>, span: Span,
) -> Result<bool, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  if !Type.hasOpenRuntimeParameters(ty) { return Result<bool, Shared<Rejection>>.succeed(false) }
  let named = Shared<Type>.with<Option<DeclarationId>>(ty, fn(node: &Type) -> Option<DeclarationId> {
    if let Type.Nominal {declaration, ..} = &node.* { return Option<DeclarationId>.some(DeclarationId.copy(&declaration)) }
    return Option<DeclarationId>.none()
  })
  let target = match move named {
    Option<DeclarationId>.Some {value} => move value
    Option<DeclarationId>.None => { return Result<bool, Shared<Rejection>>.succeed(false) }
  }
  let module = declaringModuleOrdinal(&resolver.*, ty)
  if module == usize.MAX { return Result<bool, Shared<Rejection>>.succeed(false) }
  let request = Key {
    family: Family.Implementations, module: module, name: usize.ZERO,
    declaration: usize.ZERO, member: usize.ZERO, external: false,
  }
  let listKey = run internDeclaration(&mut resolver.*, request)
  let listed = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, listKey, span)
  let failed = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(&listed, answerCause)
  if let Option<Shared<Rejection>>.Some {value} = move failed { return Result<bool, Shared<Rejection>>.failResult(move value) }
  let ownerHash = Shared<Type>.with<u64>(ty, providerOwnerHash)
  let mut at = Shared<Result<Answer, NoRejection>>.with<usize>(&listed,
    fn(answer: &Result<Answer, NoRejection>) -> usize { return firstOwnedHead(answer, ownerHash) })
  while at != usize.MAX {
    let candidate = Shared<Result<Answer, NoRejection>>.with<Option<Shared<ImplementationHead>>>(
      &listed, fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<ImplementationHead>> {
        return implementationAt(answer, at)
      },
    )
    if let Option<Shared<ImplementationHead>>.Some {value: head} = move candidate {
      let sealed = Shared<ImplementationHead>.with<bool>(&head, fn(value: &ImplementationHead) -> bool {
        return match &value.kind {
          ImplementationKind.Sealed {property} => property == SealedProperty.Drop
          _ => false
        }
      })
      let provider = Shared<ImplementationHead>.with<Shared<Type>>(
        &head, fn(value: &ImplementationHead) -> Shared<Type> { return Shared<Type>.clone(&value.provider) },
      )
      let provided = Shared<Type>.with<bool>(&provider, fn(node: &Type) -> bool {
        if let Type.Nominal {declaration, ..} = &node.* { return DeclarationId.equals(&declaration, &target) }
        return false
      })
      if sealed && provided { return Result<bool, Shared<Rejection>>.succeed(true) }
    }
    at = Shared<Result<Answer, NoRejection>>.with<usize>(&listed,
      fn(answer: &Result<Answer, NoRejection>) -> usize { return nextOwnedHead(answer, at) })
  }
  return Result<bool, Shared<Rejection>>.succeed(false)
}

// An aggregate that contains itself inline (SEM0020), naming it when it has an exact spelling.
effect fn inlineRecursionRejection(module: &ModuleId, span: Span, owner: &Shared<Type>) -> Shared<Rejection>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut diagnostic = run makeRejection(RejectionCode.InlineRecursiveAggregate, module, span)
  if let Option<Bytes>.Some {value: spelled} = move run TypeText.display(owner, module) {
    run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"members"), value: move spelled})
  }
  return run Shared<Rejection>.make(move diagnostic)
}

// Whether `ty` stores the nominal `root` inside itself inline, through record fields, variant
// payloads, union members or array elements, so `root` has no finite layout (SEM0020). A sealed
// core such as `Box` and every reference, pointer, slice or callable holds its referent out of line.
// Revisits follow `cleanupFree`: a nominal whose arguments shrink to a strict subterm is not a
// repeat. A repeat of another nominal stops the descent; that nominal reports its own cycle.
effect fn inlineRecursion(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, ty: &Shared<Type>, root: &Shared<Type>, visiting: &mut List<Shared<Type>>,
  span: Span,
) -> Result<bool, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  if let Option<SealedKind>.Some {..} = move SealedCore.coreOf(ty) {
    return Result<bool, Shared<Rejection>>.succeed(false)
  }
  let node = run Type.copy(ty)
  let mut active = run storedPropertyAncestors(ty, List<Shared<Type>>.asSlice(&visiting.*))
  let mut parts = List<Shared<Type>>.make()
  match &node {
    Type.Array {element, ..} => { run List<Shared<Type>>.append(&mut parts, Shared<Type>.clone(&element)) }
    Type.Union {members} => { parts = run copyTypes(List<Shared<Type>>.asSlice(&members)) }
    Type.Anonymous {members, ..} => { parts = run copyTypes(List<Shared<Type>>.asSlice(&members)) }
    Type.Nominal {..} => {
      if storedPropertyCycle(ty, List<Shared<Type>>.asSlice(&active)) {
        return Result<bool, Shared<Rejection>>.succeed(sameNominal(ty, root))
      }
      parts = match move run nominalParts(&mut resolver.*, &mut owner.*, &mut dependencies.*, ty, span) {
        Result<List<Shared<Type>>, Shared<Rejection>>.Success {value} => move value
        Result<List<Shared<Type>>, Shared<Rejection>>.Failure {error} => { return Result<bool, Shared<Rejection>>.failResult(move error) }
      }
      run List<Shared<Type>>.append(&mut active, Shared<Type>.clone(ty))
    }
    _ => { return Result<bool, Shared<Rejection>>.succeed(false) }
  }
  let listed = List<Shared<Type>>.asSlice(&parts)
  let mut at = usize.ZERO
  while at < listed.length {
    match move run inlineRecursion(&mut resolver.*, &mut owner.*, &mut dependencies.*, &listed[at], root, &mut active, span) {
      Result<bool, Shared<Rejection>>.Success {value} => { if value { return Result<bool, Shared<Rejection>>.succeed(true) } }
      Result<bool, Shared<Rejection>>.Failure {error} => { return Result<bool, Shared<Rejection>>.failResult(move error) }
    }
    at = at + usize.ONE
  }
  return Result<bool, Shared<Rejection>>.succeed(false)
}

// Whether dropping a value of this type runs no cleanup: no `impl Drop` anywhere in its owned
// structure (record fields, variant payloads, union members, array elements). Copy types, scalars,
// views and enums are cleanup-free; an unresolved type parameter is free only when a declared
// premise proves it Copy. Revisiting a nominal declaration requires finite structural descent;
// impossible inline cycles retain a loud gap.
effect fn cleanupFree(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, ty: &Shared<Type>, constraints: &[Constraint], visiting: &mut List<Shared<Type>>,
  span: Span,
) -> Result<bool, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  // A sealed core's cleanup is its own: allocations release, shared cores count references.
  if let Option<SealedKind>.Some {value: core} = move SealedCore.coreOf(ty) {
    return Result<bool, Shared<Rejection>>.succeed(!SealedCore.ownsCleanup(core))
  }

  let node = run Type.copy(ty)
  let mut active = run storedPropertyAncestors(ty, List<Shared<Type>>.asSlice(&visiting.*))
  let mut parts = List<Shared<Type>>.make()
  match &node {
    // Only a declared premise proves an abstract parameter Copy, such as `K: Copy` or a shared
    // callable representation; Copy and Drop are exclusive, so such a parameter owns no cleanup.
    Type.Parameter {..} => { return run copyType(&mut resolver.*, &mut owner.*, &mut dependencies.*, ty, constraints, span) }
    Type.OpaqueRepresentation {..} => { return run copyType(&mut resolver.*, &mut owner.*, &mut dependencies.*, ty, constraints, span) }
    Type.Array {element, ..} => { run List<Shared<Type>>.append(&mut parts, Shared<Type>.clone(&element)) }
    Type.Union {members} => { parts = run copyTypes(List<Shared<Type>>.asSlice(&members)) }
    Type.Anonymous {members, ..} => { parts = run copyTypes(List<Shared<Type>>.asSlice(&members)) }
    Type.CallableValue {captures, ..} => { parts = run copyTypes(List<Shared<Type>>.asSlice(&captures)) }
    Type.CallableSchema {captures, ..} => { parts = run copyTypes(List<Shared<Type>>.asSlice(&captures)) }
    Type.EffectComposite {parts: stored, ..} => { parts = run copyTypes(List<Shared<Type>>.asSlice(&stored)) }
    Type.EffectJoin {alternatives, ..} => { parts = run copyTypes(List<Shared<Type>>.asSlice(&alternatives)) }
    Type.CallableStage {base, captures, ..} => {
      run List<Shared<Type>>.append(&mut parts, Shared<Type>.clone(&base))
      let supplied = List<Shared<Type>>.asSlice(&captures)
      let mut at = usize.ZERO
      while at < supplied.length {
        run List<Shared<Type>>.append(&mut parts, Shared<Type>.clone(&supplied[at]))
        at = at + usize.ONE
      }
    }
    Type.Nominal {..} => {
      let copied = run copyType(&mut resolver.*, &mut owner.*, &mut dependencies.*, ty, constraints, span)
      match move copied {
        Result<bool, Shared<Rejection>>.Success {value} => { if value { return Result<bool, Shared<Rejection>>.succeed(true) } }
        Result<bool, Shared<Rejection>>.Failure {error} => { return Result<bool, Shared<Rejection>>.failResult(move error) }
      }
      let dropped = run implementsSealed(&mut resolver.*, &mut owner.*, &mut dependencies.*, ty, SealedProperty.Drop, constraints, span)
      match move dropped {
        Result<bool, Shared<Rejection>>.Success {value} => { if value { return Result<bool, Shared<Rejection>>.succeed(false) } }
        Result<bool, Shared<Rejection>>.Failure {error} => { return Result<bool, Shared<Rejection>>.failResult(move error) }
      }
      let specialized = run specializedDrop(&mut resolver.*, &mut owner.*, &mut dependencies.*, ty, span)
      match move specialized {
        Result<bool, Shared<Rejection>>.Success {value} => { if value { return Result<bool, Shared<Rejection>>.succeed(false) } }
        Result<bool, Shared<Rejection>>.Failure {error} => { return Result<bool, Shared<Rejection>>.failResult(move error) }
      }
      if storedPropertyCycle(ty, List<Shared<Type>>.asSlice(&active)) {
        let declaringModule = resolvedModule(&resolver.*, declaringModuleOrdinal(&resolver.*, ty))
        let declaration = run ordinalOfProvider(&mut resolver.*, &declaringModule, ty)
        // Derive both parts of the site from this declaration. The incoming span may belong
        // to an imported caller or a different stored nominal declaration.
        let mut declarationSpan = Span.make(usize.ZERO, usize.ZERO)
        if let Option<usize>.Some {value: ordinal} = move declaration {
          let writtenHeader = run scopedHeader(&mut resolver.*, &declaringModule, ordinal)
          if let Option<HeaderSyntax>.Some {value: written} = move writtenHeader {
            declarationSpan = written.span
          }
        }
        return Result<bool, Shared<Rejection>>.failResult(run reject(&resolver.*, &declaringModule,
          RejectionCode.InlineStorageUnavailable, declarationSpan))
      }
      let gathered = run nominalParts(&mut resolver.*, &mut owner.*, &mut dependencies.*, ty, span)
      parts = match move gathered {
        Result<List<Shared<Type>>, Shared<Rejection>>.Success {value} => move value
        Result<List<Shared<Type>>, Shared<Rejection>>.Failure {error} => { return Result<bool, Shared<Rejection>>.failResult(move error) }
      }
      run List<Shared<Type>>.append(&mut active, Shared<Type>.clone(ty))
    }
    _ => { return Result<bool, Shared<Rejection>>.succeed(true) }
  }
  let listed = List<Shared<Type>>.asSlice(&parts)
  let mut at = usize.ZERO
  let mut free = true
  while at < listed.length && free {
    let part = run cleanupFree(&mut resolver.*, &mut owner.*, &mut dependencies.*, &listed[at], constraints, &mut active, span)
    match move part {
      Result<bool, Shared<Rejection>>.Success {value} => { free = value }
      Result<bool, Shared<Rejection>>.Failure {error} => { return Result<bool, Shared<Rejection>>.failResult(move error) }
    }
    at = at + usize.ONE
  }
  return Result<bool, Shared<Rejection>>.succeed(free)
}

// `cleanupFree` from a fresh root. A closed nominal type's verdict reads no premise, so it is
// shared through its `CleanupFree` unit: the bodies of one generic function's instances often
// hold the same large record, and each walking its fields made them quadratic together. A key
// that fails is walked here again, so the rejection stays this body's own as before.
effect fn sharedCleanupFree(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, ty: &Shared<Type>, constraints: &[Constraint], span: Span,
) -> Result<bool, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let nominal = Shared<Type>.with<bool>(ty, fn(value: &Type) -> bool {
    return match &value.* { Type.Nominal {..} => true _ => false }
  })
  if nominal && !Type.hasOpenRuntimeParameters(ty) {
    let erased = run internErasedType(&mut resolver.*, ty)
    let request = Key {
      family: Family.CleanupFree, module: usize.ZERO, name: erased, declaration: usize.ZERO, member: usize.ZERO, external: false,
    }
    let unit = run internDeclaration(&mut resolver.*, request)
    let answer = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, unit, span)
    let verdict = Shared<Result<Answer, NoRejection>>.with<Option<bool>>(&answer, cleanupFreeVerdict)
    if let Option<bool>.Some {value} = move verdict { return Result<bool, Shared<Rejection>>.succeed(value) }
  }
  let mut visiting = List<Shared<Type>>.make()
  return run cleanupFree(&mut resolver.*, &mut owner.*, &mut dependencies.*, ty, constraints, &mut visiting, span)
}

effect fn resolveCleanupFree(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, key: Key) -> Answer
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let types = List<Shared<Type>>.asSlice(&resolver.erasedTypes)
  let ty = Shared<Type>.clone(&types[key.name])
  let mut dependencies = List<Dependency>.make()
  let mut visiting = List<Shared<Type>>.make()
  let none = List<Constraint>.make()
  let free = run cleanupFree(&mut resolver.*, &mut owner.*, &mut dependencies, &ty, List<Constraint>.asSlice(&none), &mut visiting,
    Span.make(usize.ZERO, usize.ZERO))
  return match move free {
    Result<bool, Shared<Rejection>>.Success {value} => memberSuccess(Value.CleanupFree {holds: value}, move dependencies)
    Result<bool, Shared<Rejection>>.Failure {error} => run memberRejected(move error, move dependencies)
  }
}

fn cleanupFreeVerdict(answer: &Result<Answer, NoRejection>) -> Option<bool> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.CleanupFree {holds}} => Option<bool>.some(holds)
      _ => Option<bool>.none()
    }
    Result<Answer, NoRejection>.Failure {error: _} => Option<bool>.none()
  }
}

// Every owned part of a nominal record, tuple record or union: field types in order, then each
// variant's payload types, under the type's own application.
effect fn nominalParts(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, ty: &Shared<Type>, span: Span,
) -> Result<List<Shared<Type>>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut parts = List<Shared<Type>>.make()
  let moduleOrdinal = declaringModuleOrdinal(&resolver.*, ty)
  if moduleOrdinal == usize.MAX { return Result<List<Shared<Type>>, Shared<Rejection>>.succeed(move parts) }
  let declaredModule = resolvedModule(&resolver.*, moduleOrdinal)
  let ordinal = run ordinalOfProvider(&mut resolver.*, &declaredModule, ty)
  let declaration = match move ordinal {
    Option<usize>.Some {value} => value
    Option<usize>.None => { return Result<List<Shared<Type>>, Shared<Rejection>>.succeed(move parts) }
  }
  let mut count = usize.ZERO
  let written = run scopedHeader(&mut resolver.*, &declaredModule, declaration)
  if let Option<HeaderSyntax>.Some {value} = move written {
    match value.header {
      Node.StructHeader {fields, ..} => { count = fields.length }
      Node.TupleHeader {elements, ..} => { count = elements.length }
      Node.UnionHeader {variants, ..} => { count = variants.length }
      _ => ()
    }
  }
  let application = run internApplication(&mut resolver.*, ty)
  let mut member = usize.ZERO
  while member < count {
    let declarationAccess134Request = Key {
      family: Family.MemberShape, module: moduleOrdinal, name: application,
      declaration: declaration, member: member, external: false,
    }
    let declarationAccess134 = run internDeclaration(&mut resolver.*, declarationAccess134Request)
    let shape = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, declarationAccess134, span)
    let rejected = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(&shape, answerCause)
    if let Option<Shared<Rejection>>.Some {value} = move rejected {
      return Result<List<Shared<Type>>, Shared<Rejection>>.failResult(move value)
    }
    let mut at = usize.ZERO
    while true {
      let part = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(&shape, fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> {
        return shapeTypeAt(answer, at)
      })
      match move part {
        Option<Shared<Type>>.Some {value} => { run List<Shared<Type>>.append(&mut parts, move value) }
        Option<Shared<Type>>.None => { break }
      }
      at = at + usize.ONE
    }
    member = member + usize.ONE
  }
  return Result<List<Shared<Type>>, Shared<Rejection>>.succeed(move parts)
}

fn zeroDigits(digits: &[u8]) -> bool {
  let mut at = usize.ZERO
  while at < digits.length {
    if digits[at] != '0' { return false }
    at = at + usize.ONE
  }
  return true
}

fn scalarSubject(value: &Type) -> bool {
  return scalarType(value) || pointerSizedIntegerType(value)
}

// A match subject with no finite member set: an integer, `bool`, `char` or float value, matched
// by `_` or a whole-value type binder such as `char c`.
fn matchScalarSubject(value: &Type) -> bool {
  if scalarSubject(value) { return true }
  return match &value.* {
    Type.Primitive {name} => same(Bytes.asSlice(&name), b"char") || same(Bytes.asSlice(&name), b"f32") || same(Bytes.asSlice(&name), b"f64")
    _ => false
  }
}

// Source record identity is valid during abstract body checking. Runtime completeness belongs
// to MIR realization and Layout, never to admission of a caller-owned generic pattern.
effect fn declaredRecord(resolver: &mut Resolver, value: &Shared<Type>) -> bool
! Cycle | OutOfMemoryError ? &mut Allocator {
  let moduleOrdinal = declaringModuleOrdinal(&resolver.*, value)
  if moduleOrdinal == usize.MAX { return false }
  let declaredModule = resolvedModule(&resolver.*, moduleOrdinal)
  let ordinal = run ordinalOfProvider(&mut resolver.*, &declaredModule, value)
  if let Option<usize>.Some {value: declaration} = move ordinal {
    let written = run scopedHeader(&mut resolver.*, &declaredModule, declaration)
    if let Option<HeaderSyntax>.Some {value: syntax} = move written {
      if let Node.StructHeader {..} = syntax.header { return true }
    }
  }
  return false
}

// Source members may retain exact callable or generic evidence before monomorphization. A nominal
// member has its own finite identity even while its arguments are open (`Empty<T>` in `List<T>`).
// Every physical layout and source ordinal still requires the complete canonical storage map.
fn sourceUnionMember(value: &Shared<Type>) -> bool {
  return Shared<Type>.with<bool>(value, scalarSubject)
    || Type.closedCallableStorage(value) || Shared<Type>.with<bool>(value, fn(ty: &Type) -> bool {
      return match &ty.* {
        Type.Unit => true
        // Floating-point and `char` members are ordinary scalar values (UNION-001).
        Type.Primitive {name} => primitive(Bytes.asSlice(&name))
        Type.Nominal {..} => true
        Type.Array {element, ..} => sourceUnionMember(&element)
        // A text view is a Copy descriptor member (UNION-001).
        Type.String {..} => true
        // A raw pointer is a Copy address with no borrow lifetime (UNION-001).
        Type.Pointer {..} => true
        Type.Parameter {..} => true
        Type.CallableValue {..} => true
        Type.CallableSchema {..} => true
        Type.CallableView {..} => true
        Type.CallableOrigin {..} => true
        Type.CallableResult {..} => true
        Type.CallableStage {..} => true
        Type.CallableWitnessResult {..} => true
        Type.OpaqueRepresentation {contract, ..} => Shared<Type>.with<bool>(&contract, callableType) || Shared<Type>.with<bool>(&contract, bareEffect)
        _ => false
      }
    })
}

fn sourceUnion(value: &Type) -> bool {
  if let Type.Union {members} = &value.* {
    let listed = List<Shared<Type>>.asSlice(&members)
    let mut at = usize.ZERO
    while at < listed.length {
      if !sourceUnionMember(&listed[at]) { return false }
      at = at + usize.ONE
    }
    return true
  }
  return false
}

// An owned return may inject its original transferred payload at the outer boundary only.
// Nested records and descriptor referents already have their complete source storage shape.
effect fn opaqueUnionArgument(nodes: &mut List<BodyNode>, node: BodyNodeId,
  expected: &Shared<Type>, producer: &DeclarationId) -> BodyNodeId
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let actual = match move bodyExpressionType(List<BodyNode>.asSlice(&nodes.*), &node) {
    Option<Shared<Type>>.Some {value} => move value
    _ => { return node }
  }
  if Shared<Type>.with<bool>(&actual, fn(ty: &Type) -> bool {
    return match &ty.* { Type.Union {..} => true _ => false }
  }) { return node }
  let ordered = match move run UnionProjection.members(expected) {
    Option<List<Shared<Type>>>.Some {value} => move value
    _ => { return node }
  }
  let members = List<Shared<Type>>.asSlice(&ordered)
  let mut selected = usize.MAX
  let mut at = usize.ZERO
  while at < members.length {
    let own = run Type.containsOpaque(&members[at], producer)
    let exact = run Type.equalsShared(&actual, &members[at])
    if !own && exact {
      selected = at
      break
    }
    at = at + usize.ONE
  }
  if selected == usize.MAX {
    at = usize.ZERO
    while at < members.length {
      let evidence = run Type.opaqueEvidence(&actual, &members[at], producer)
      if let Option<List<OpaqueEvidence>>.Some {..} = move evidence {
        selected = at
        break
      }
      at = at + usize.ONE
    }
  }
  if selected == usize.MAX { return node }
  let origin = List<BodyNode>.asSlice(&nodes.*)[node.index].origin
  let index = List<BodyNode>.length(&nodes.*)
  run List<BodyNode>.append(&mut nodes.*, BodyNode {origin: origin,
    kind: BodyNodeKind.Expression {ty: Shared<Type>.clone(expected),
      form: BodyExpression.UnionInject {tag: selected, value: node}},
  })
  return BodyNodeId {index: index}
}

effect fn unionArgument(nodes: &mut List<BodyNode>, node: BodyNodeId, expected: &Shared<Type>)
-> BodyNodeId ! OutOfMemoryError ? &mut Allocator | &mut Types {
  if !Shared<Type>.with<bool>(expected, sourceUnion) { return node }
  let actual = match move bodyExpressionType(List<BodyNode>.asSlice(&nodes.*), &node) {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => { return node }
  }
  let ordered = run UnionProjection.members(expected)
  let canonical = match move ordered {
    Option<List<Shared<Type>>>.Some {value} => move value
    Option<List<Shared<Type>>>.None => { return node }
  }
  let members = List<Shared<Type>>.asSlice(&canonical)
  let mut at = usize.ZERO
  while at < members.length {
    if run Type.equalsShared(&members[at], &actual) {
      let origin = List<BodyNode>.asSlice(&nodes.*)[node.index].origin
      let index = List<BodyNode>.length(&nodes.*)
      run List<BodyNode>.append(&mut nodes.*, BodyNode {origin: origin,
        kind: BodyNodeKind.Expression {ty: Shared<Type>.clone(expected), form: BodyExpression.UnionInject {tag: at, value: node}},
      })
      return BodyNodeId {index: index}
    }
    at = at + usize.ONE
  }
  // A narrower union widens when each of its members is a member of the expected union.
  if !Shared<Type>.with<bool>(&actual, sourceUnion) || run Type.equalsShared(&actual, expected) { return node }
  let narrower = match move run UnionProjection.members(&actual) {
    Option<List<Shared<Type>>>.Some {value} => move value
    Option<List<Shared<Type>>>.None => { return node }
  }
  let offered = List<Shared<Type>>.asSlice(&narrower)
  at = usize.ZERO
  while at < offered.length {
    let mut found = false
    let mut member = usize.ZERO
    while !found && member < members.length {
      found = run Type.equalsShared(&members[member], &offered[at])
      member = member + usize.ONE
    }
    if !found { return node }
    at = at + usize.ONE
  }
  let origin = List<BodyNode>.asSlice(&nodes.*)[node.index].origin
  let index = List<BodyNode>.length(&nodes.*)
  run List<BodyNode>.append(&mut nodes.*, BodyNode {origin: origin,
    kind: BodyNodeKind.Expression {ty: Shared<Type>.clone(expected), form: BodyExpression.UnionWiden {value: node}},
  })
  return BodyNodeId {index: index}
}

// The access, nullability and written alignment an expected raw pointer accepts. `aligned` is
// false for the natural alignment requirement, which has no written `alignment`.
struct PointerExpectation {
  access: Access,
  nullable: bool,
  aligned: bool,
  alignment: u64,
}

impl Copy for PointerExpectation {}

fn pointerExpectation(value: &Type) -> Option<PointerExpectation> {
  if let Type.Pointer {access, nullable, alignment, ..} = &value.* {
    let mut expected = PointerExpectation {access: access, nullable: nullable, aligned: false, alignment: 0}
    if let Option<u64>.Some {value: written} = &alignment {
      expected.aligned = true
      expected.alignment = written
    }
    return Option<PointerExpectation>.some(expected)
  }
  return Option<PointerExpectation>.none()
}

// Whether an actual alignment requirement weakens to the expected one: any requirement weakens to
// `align(1)`, and a written alignment weakens to a smaller written one. Natural alignment is not
// compared numerically, so it weakens only to `align(1)`.
fn alignmentWeakens(actual: &Option<u64>, expected: PointerExpectation) -> bool {
  if !expected.aligned { return false }
  return match &actual.* {
    Option<u64>.Some {value} => value > expected.alignment
    Option<u64>.None => expected.alignment == 1
  }
}

// An immediate pointer conversion may remove mutation capability, add nullability and weaken
// alignment, preserving every other actual qualifier. Exact comparison of a copied transaction
// proves invariant pointee/extent and prior bindings; ordinary argument matching still owns the
// real transaction.
effect fn pointerArgument(
  nodes: &mut List<BodyNode>, node: BodyNodeId, parameter: &Shared<Type>,
  variables: &[Shared<DeclarationId>], bindings: &[Binding],
) -> BodyNodeId ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let expectation = match move Shared<Type>.with<Option<PointerExpectation>>(parameter, pointerExpectation) {
    Option<PointerExpectation>.Some {value} => value
    Option<PointerExpectation>.None => { return node }
  }
  let actual = match move bodyExpressionType(List<BodyNode>.asSlice(&nodes.*), &node) {
    Option<Shared<Type>>.Some {value} => run Type.copy(&value)
    Option<Shared<Type>>.None => { return node }
  }
  if let Type.Pointer {pointee, access, nullable, multiplicity, alignment} = move actual {
    let weakenAccess = access == Access.Mutable && expectation.access == Access.Shared
    let addNullability = !nullable && expectation.nullable
    let weakenAlignment = alignmentWeakens(&alignment, expectation)
    if !weakenAccess && !addNullability && !weakenAlignment { return node }
    let mut weakenedAccess = access
    if weakenAccess { weakenedAccess = Access.Shared }
    let mut weakenedAlignment = move alignment
    if weakenAlignment { weakenedAlignment = Option<u64>.some(expectation.alignment) }
    let weakened = run Types.intern(Type.Pointer {
      pointee: move pointee, access: weakenedAccess, nullable: nullable || addNullability,
      multiplicity: multiplicity, alignment: move weakenedAlignment,
    })
    let mut proof = List<Binding>.make()
    let mut at = usize.ZERO
    while at < bindings.length {
      run List<Binding>.append(&mut proof, Binding {
        declaration: Shared<DeclarationId>.clone(&bindings[at].declaration),
        ordinal: bindings[at].ordinal, value: Argument.copy(&bindings[at].value),
      })
      at = at + usize.ONE
    }
    let proved = run Type.unify(parameter, &weakened, variables, Comparison.Exact, &mut proof)
    match move proved {
      Unification.Unified => {
        let origin = List<BodyNode>.asSlice(&nodes.*)[node.index].origin
        let index = List<BodyNode>.length(&nodes.*)
        run List<BodyNode>.append(&mut nodes.*, BodyNode {origin: origin,
          kind: BodyNodeKind.Expression {ty: move weakened, form: BodyExpression.PointerWeaken {value: node}},
        })
        return BodyNodeId {index: index}
      }
      _ => ()
    }
  }
  return node
}

effect fn unionHasMember(unionType: &Shared<Type>, member: &Shared<Type>) -> bool
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut at = usize.ZERO
  while true {
    let candidate = Shared<Type>.with<Option<Shared<Type>>>(unionType,
      fn(value: &Type) -> Option<Shared<Type>> {
        if let Type.Union {members} = &value.* {
          let values = List<Shared<Type>>.asSlice(&members)
          if at < values.length { return Option<Shared<Type>>.some(Shared<Type>.clone(&values[at])) }
        }
        return Option<Shared<Type>>.none()
      },
    )
    let selected = match move candidate {
      Option<Shared<Type>>.Some {value} => move value
      Option<Shared<Type>>.None => { break }
    }
    if run Type.equalsShared(&selected, member) {
      return true
    }
    at = at + usize.ONE
  }
  return false
}

fn pendingOriginRoot(value: &Type) -> bool {
  return match &value.* {
    Type.CallableOrigin {..} => true
    Type.CallableWitnessResult {..} => true
    Type.CallableResult {..} => true
    Type.CallableStage {..} => true
    Type.CallableView {representation, ..} => Shared<Type>.with<bool>(&representation, pendingOriginRoot)
    _ => false
  }
}

effect fn deferredOriginComparison(first: &Shared<Type>, second: &Shared<Type>, declared: &[Constraint]) -> bool
! OutOfMemoryError ? &mut Allocator | &mut Types {
  if run Type.equalsShared(first, second) { return true }
  if !pendingCallableSelection(first) && !pendingCallableSelection(second) { return false }
  if Shared<Type>.with<bool>(first, pendingOriginRoot) || Shared<Type>.with<bool>(second, pendingOriginRoot) {
    let wanted = run valueCallableContract(first, declared)
    let offered = run valueCallableContract(second, declared)
    if let Option<Shared<Type>>.Some {value: promised} = move wanted {
      if let Option<Shared<Type>>.Some {value: actual} = move offered { return run Type.equalsShared(&promised, &actual) }
    }
    return false
  }
  let children = match move run Type.comparisonChildren(first, second) {
    Option<List<ComparisonChild>>.Some {value} => move value
    _ => { return false }
  }
  let pairs = List<ComparisonChild>.asSlice(&children)
  let mut at = usize.ZERO
  while at < pairs.length {
    if !run deferredOriginComparison(&pairs[at].left, &pairs[at].right, declared) { return false }
    at = at + usize.ONE
  }
  return true
}

// A residual body retains authored symbolic types, while selected static values carry the
// complete application's caller-region domain. Compare them only under that same application.
// The nearest Body decides the context; an abstract nested body never inherits outer bindings.
effect fn selectedBodyBindings(resolver: &Resolver) -> List<Binding>
! OutOfMemoryError ? &mut Allocator {
  let active = List<Word>.asSlice(&resolver.active)
  let keys = List<ScopedKey>.asSlice(&resolver.keys)
  let mut at = active.length
  while at > usize.ZERO {
    at = at - usize.ONE
    let key = keys[u64.toUsize(active[at].value)].key
    if key.family == Family.Body {
      if key.member == usize.ZERO { break }
      let application = run selectedApplicationAt(resolver, key.member - usize.ONE)
      return run Application.bindings(&application)
    }
  }
  return List<Binding>.make()
}

effect fn selectedBodyComparedType(resolver: &Resolver, value: &Shared<Type>) -> Shared<Type>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let bindings = run selectedBodyBindings(resolver)
  return run Type.applyBindings(value, List<Binding>.asSlice(&bindings), true)
}

// An exact static operand type may be phase-only. This evidence never admits a runtime node.
// A static argument whose value does not have its parameter's exact type (SEM0012), naming both
// types, and for a reflected field the field it describes, since one `static for` passes each.
// Checks an interface operation call's selected static operand against its parameter type under
// the call's assignments and this body's selected bindings. The value selects the witness
// instance; it is never a runtime operand.
effect fn interfaceStaticOperand(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, module: &ModuleId, parameterType: &Shared<Type>, inferred: &[Binding],
  value: &Shared<StaticData>, span: Span) -> Option<Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let bodyBindings = run selectedBodyBindings(&resolver.*)
  let specialized = run Type.applyBindings(parameterType, inferred, true)
  let exact = run Type.applyBindings(&specialized, List<Binding>.asSlice(&bodyBindings), true)
  if Type.hasOpenParameters(&exact) { return Option<Shared<Rejection>>.some(run reject(&resolver.*, module, RejectionCode.Unsupported, span)) }
  if run StaticValue.matchesType(value, &exact) { return Option<Shared<Rejection>>.none() }
  return match move run staticArgumentMismatch(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, value, &exact, span) {
    Result<BodyNodeId, Shared<Rejection>>.Failure {error} => Option<Shared<Rejection>>.some(move error)
    Result<BodyNodeId, Shared<Rejection>>.Success {..} => Option<Shared<Rejection>>.none()
  }
}

effect fn staticArgumentMismatch(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, module: &ModuleId, value: &Shared<StaticData>, expected: &Shared<Type>,
  span: Span) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let error = match move run staticArgumentType(&mut resolver.*, &mut owner.*, &mut dependencies.*, value, span) {
    Option<Shared<Type>>.Some {value: actual} => run typeMismatchRejection(&resolver.*, module, RejectionCode.TypeMismatch,
      span, expected, &actual)
    Option<Shared<Type>>.None => run reject(&resolver.*, module, RejectionCode.TypeMismatch, span)
  }
  let reflected = Shared<StaticData>.with<Option<StaticValue.FieldParts>>(value, StaticValue.fieldParts)
  if let Option<StaticValue.FieldParts>.Some {value: field} = move reflected {
    let label = run StaticValue.copySharedBytes(&field.label)
    if Bytes.length(&label) != usize.ZERO {
      let mut note = run Bytes.copy(b"the argument describes field ")
      run appendQuoted(&mut note, Bytes.asSlice(&label))
      run appendRejectionArgument(&error, b"note", Bytes.asSlice(&note))
    }
  }
  return Result<BodyNodeId, Shared<Rejection>>.failResult(move error)
}

effect fn staticArgumentType(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, value: &Shared<StaticData>, span: Span) -> Option<Shared<Type>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let retained = Shared<StaticData>.with<Option<Shared<Type>>>(value, fn(data: &StaticData) -> Option<Shared<Type>> {
    return match &data.* {
      StaticData.Field {ty, ..} => Option<Shared<Type>>.some(Shared<Type>.clone(&ty))
      StaticData.Sequence {ty, ..} => Option<Shared<Type>>.some(Shared<Type>.clone(&ty))
      StaticData.Aggregate {ty, ..} => Option<Shared<Type>>.some(Shared<Type>.clone(&ty))
      _ => Option<Shared<Type>>.none()
    }
  })
  if let Option<Shared<Type>>.Some {value: exact} = move retained {
    return Option<Shared<Type>>.some(move exact)
  }
  return run embeddedType(&mut resolver.*, &mut owner.*, &mut dependencies.*, value, span)
}

// A field capability names its owner with the regions its reflection was written at, such as the
// call regions of `Reflect.fields<Greet>()`, while the call's runtime operands supply the owner's
// regions here. A member is selected by its owner's identity and ordinal, never by a region, so a
// capability whose owner differs from the parameter's only in regions is the same capability,
// reflected again at that owner. None when the operand is no such capability.
effect fn regionedStaticField(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, module: &ModuleId, parameter: &Shared<Type>, supplied: &Shared<StaticData>, span: Span)
-> Option<Shared<StaticData>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let field = match move Shared<StaticData>.with<Option<StaticValue.FieldParts>>(supplied, StaticValue.fieldParts) {
    Option<StaticValue.FieldParts>.Some {value} => move value
    Option<StaticValue.FieldParts>.None => { return Option<Shared<StaticData>>.none() }
  }
  // A variant descriptor names only its union, so it is the same variant at the parameter's union.
  if let Option<Shared<Type>>.Some {value: writtenUnion} = move Shared<Type>.with<Option<Shared<Type>>>(&field.ty, CheckedIntrinsic.variantOwner) {
    let wantedUnion = match move Shared<Type>.with<Option<Shared<Type>>>(parameter, CheckedIntrinsic.variantOwner) {
      Option<Shared<Type>>.Some {value} => move value
      Option<Shared<Type>>.None => { return Option<Shared<StaticData>>.none() }
    }
    if Type.hasOpenParameters(&wantedUnion) || run Type.equalsShared(&wantedUnion, &writtenUnion) { return Option<Shared<StaticData>>.none() }
    if !run Type.runtimeEqualsShared(&wantedUnion, &writtenUnion) { return Option<Shared<StaticData>>.none() }
    return match StaticValue.reflectedVariant(Shared<Type>.clone(parameter), field.ordinal, move field.label, move field.authorization) {
      Option<StaticData>.Some {value} => Option<Shared<StaticData>>.some(run Shared<StaticData>.make(move value))
      Option<StaticData>.None => Option<Shared<StaticData>>.none()
    }
  }
  let written = match move Shared<Type>.with<Option<CheckedIntrinsic.FieldTypes>>(&field.ty, CheckedIntrinsic.fieldTypes) {
    Option<CheckedIntrinsic.FieldTypes>.Some {value} => move value
    Option<CheckedIntrinsic.FieldTypes>.None => { return Option<Shared<StaticData>>.none() }
  }
  let wanted = match move Shared<Type>.with<Option<CheckedIntrinsic.FieldTypes>>(parameter, CheckedIntrinsic.fieldTypes) {
    Option<CheckedIntrinsic.FieldTypes>.Some {value} => move value
    Option<CheckedIntrinsic.FieldTypes>.None => { return Option<Shared<StaticData>>.none() }
  }
  if Type.hasOpenParameters(&wanted.owner) || run Type.equalsShared(&wanted.owner, &written.owner) { return Option<Shared<StaticData>>.none() }
  if !run Type.runtimeEqualsShared(&wanted.owner, &written.owner) { return Option<Shared<StaticData>>.none() }
  let member = match move run checkedReflectedMember(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, &wanted.owner, &field, span) {
    Result<CheckedRecordMember, Shared<Rejection>>.Success {value} => move value
    Result<CheckedRecordMember, Shared<Rejection>>.Failure {error} => {
      drop error
      return Option<Shared<StaticData>>.none()
    }
  }
  return run StaticValue.retypedField(supplied, run CheckedIntrinsic.fieldType(&wanted.owner, &member.ty))
}

effect fn originComparedType(resolver: &Resolver, value: &Shared<Type>) -> Shared<Type>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let phase = privateOriginPhase(resolver)
  if phase.phase != 3 { return Shared<Type>.clone(value) }
  let application = run selectedApplicationAt(resolver, phase.application)
  let bindings = run Application.bindings(&application)
  return run Type.applyBindings(value, List<Binding>.asSlice(&bindings), true)
}

effect fn matchCallArgument(
  resolver: &Resolver,
  module: &ModuleId,
  span: Span,
  parameter: &Shared<Type>,
  evidence: &Shared<Type>,
  variables: &[Shared<DeclarationId>],
  inferred: &mut List<Binding>,
  constraints: &[Constraint],
  mismatchCode: RejectionCode,
) -> Option<Shared<Rejection>> ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let phase = privateOriginPhase(resolver)
  if phase.phase == 3 {
    let application = run selectedApplicationAt(resolver, phase.application)
    let applied = run Application.bindings(&application)
    let bindings = List<Binding>.asSlice(&applied)
    let assigned = List<Binding>.asMutSlice(&mut inferred.*)
    let mut at = usize.ZERO
    while at < assigned.length {
      let old = Argument.copy(&assigned[at].value)
      assigned[at].value = run Argument.applyBindings(&old, bindings, true)
      at = at + usize.ONE
    }
  }
  // A selected body can retain an authored parameter in an argument node after a static
  // operand fixed this call's fresh binder to its closed instance. Compare both in that
  // body's application domain; keep the residual node and inference ownership unchanged.
  let bodyBindings = run selectedBodyBindings(resolver)
  // The residual body keeps its authored types, so a call whose operands already agree there
  // infers its binders there too: the application's caller regions never leak into a result,
  // where a written `'a` would no longer name it.
  if List<Binding>.length(&bodyBindings) != usize.ZERO && phase.phase != 3 {
    let mut authored = run copyBindings(List<Binding>.asSlice(&inferred.*))
    if let Unification.Unified = run Type.unify(parameter, evidence, variables, Comparison.Exact, &mut authored) {
      inferred.* = move authored
      return Option<Shared<Rejection>>.none()
    }
  }
  let bodyAssigned = List<Binding>.asMutSlice(&mut inferred.*)
  let mut bindingAt = usize.ZERO
  while bindingAt < bodyAssigned.length {
    let old = Argument.copy(&bodyAssigned[bindingAt].value)
    bodyAssigned[bindingAt].value = run Argument.applyBindings(&old, List<Binding>.asSlice(&bodyBindings), true)
    bindingAt = bindingAt + usize.ONE
  }
  let originWanted = run originComparedType(resolver, parameter)
  let originOffered = run originComparedType(resolver, evidence)
  let wantedType = run Type.applyBindings(&originWanted, List<Binding>.asSlice(&bodyBindings), true)
  let offeredType = run Type.applyBindings(&originOffered, List<Binding>.asSlice(&bodyBindings), true)
  let matched = run Type.unify(&wantedType, &offeredType, variables, Comparison.Exact, &mut inferred.*)
  match move matched {
    Unification.Unified => {
      return Option<Shared<Rejection>>.none()
    }
    Unification.Distinct => {
      // A diverging operand has no value, so every parameter accepts it, as at an expected value.
      if Shared<Type>.with<bool>(evidence, neverType) { return Option<Shared<Rejection>>.none() }
      if phase.phase == usize.ONE {
        // Earlier operands may have placed the pending recipe inside this inferred parameter.
        let pattern = run Type.applyBindings(parameter, List<Binding>.asSlice(&inferred.*), true)
        if (pendingCallableSelection(&pattern) || pendingCallableSelection(evidence))
          && run deferredOriginComparison(&pattern, evidence, constraints) { return Option<Shared<Rejection>>.none() }
      }
      // A source callable contract needs an exact representation binder before it can
      // accept a closure or section value. Deferred callable admission is a gap.
      if Shared<Type>.with<bool>(parameter, fn(value: &Type) -> bool {
        return match &value.* { Type.Callable {..} => true _ => false }
      }) && Shared<Type>.with<bool>(evidence, fn(value: &Type) -> bool {
        return match &value.* { Type.CallableSchema {..} => true Type.CallableValue {..} => true Type.CallableStage {..} => true _ => false }
      }) { return Option<Shared<Rejection>>.some(run reject(resolver, module, RejectionCode.Unsupported, span)) }
      // Closed-record unions are injected before matching; any other exact member injection is a
      // valid program whose representation is still deferred.
      if !Shared<Type>.with<bool>(parameter, sourceUnion) && run unionHasMember(parameter, evidence) {
        return Option<Shared<Rejection>>.some(run reject(resolver, module,
          RejectionCode.UnionFormUnavailable, span))
      }
      // Name both types where they print exactly, with the bindings earlier operands fixed, such
      // as a `'static` lifetime that an earlier literal argument chose for the call.
      let shown = run Type.applyBindings(&wantedType, List<Binding>.asSlice(&inferred.*), true)
      let code = valueMismatchCode(&offeredType, &wantedType, mismatchCode)
      let mut diagnostic = run makeRejection(code, module, span)
      if code == RejectionCode.TypeMismatch {
        let named = run appendNamedMismatch(module, resolver, &shown, &offeredType, &mut diagnostic.arguments)
        run appendBorrowHint(module, &shown, &offeredType, &mut diagnostic.arguments)
      }
      run enumMismatchArguments(module, code, &shown, &offeredType, &mut diagnostic)
      return Option<Shared<Rejection>>.some(run Shared<Rejection>.make(move diagnostic))
    }
    Unification.Undetermined {at: undecided} => {
      drop undecided
      return Option<Shared<Rejection>>.some(
        run reject(resolver, module, RejectionCode.Unsupported, span),
      )
    }
  }
}

effect fn bodySpan(source: &SourceIndex, cursor: &AuthoredCursor, id: HirId) -> Span
! RevisionMismatch {
  if let Option<Span>.Some {value} = move SourceIndex.authoredSpan(source, cursor, id) {
    return value
  }
  fail RevisionMismatch {}
}

// `cursor` anchored at the declaration at `ordinal`, whose body it reads.
fn anchoredCursor(source: &SourceIndex, cursor: Option<AuthoredCursor>, ordinal: usize) -> Option<AuthoredCursor> {
  if let Option<AuthoredCursor>.Some {value} = &cursor {
    if let Option<Anchor>.Some {value: anchor} = move SourceIndex.declarationAnchor(source, &value, ordinal) {
      return Option<AuthoredCursor>.some(AuthoredCursor.anchored(&value, &anchor))
    }
  }
  return Option<AuthoredCursor>.none()
}

// The anchor of the body read through `cursor`. Only a body check builds origins, and it reads
// through a cursor anchored at its declaration; a module cursor here is a broken invariant.
effect fn cursorAnchor(cursor: &AuthoredCursor) -> Anchor ! RevisionMismatch {
  if let Option<Anchor>.Some {value} = move AuthoredCursor.anchor(cursor) {
    return move value
  }
  fail RevisionMismatch {}
}

// The origin of node `syntax` at `span` in the body read through `cursor`.
effect fn originAt(cursor: &AuthoredCursor, syntax: HirId, span: Span) -> BodyOrigin ! RevisionMismatch {
  return BodyOrigin.at(&run cursorAnchor(cursor), syntax, span)
}

// The origin of node `syntax`, at its own span, in the body read through `cursor`.
effect fn bodyOrigin(source: &SourceIndex, cursor: &AuthoredCursor, syntax: HirId) -> BodyOrigin ! RevisionMismatch {
  return run originAt(cursor, syntax, run bodySpan(source, cursor, syntax))
}

// The current node an origin of the body read through `cursor` names.
effect fn originSyntax(cursor: &AuthoredCursor, origin: BodyOrigin) -> HirId ! RevisionMismatch {
  return BodyOrigin.syntax(origin, &run cursorAnchor(cursor))
}

// The current span an origin of the body read through `cursor` names.
effect fn originSpan(cursor: &AuthoredCursor, origin: BodyOrigin) -> Span ! RevisionMismatch {
  return BodyOrigin.span(origin, &run cursorAnchor(cursor))
}

// Node `syntax` counted from the anchor of the body read through `cursor`, as typed bodies store
// literal nodes and body-local region ordinals, so an edit above the declaration leaves it equal.
effect fn anchoredNode(cursor: &AuthoredCursor, syntax: HirId) -> usize ! RevisionMismatch {
  return Anchor.node(&run cursorAnchor(cursor), syntax)
}

// The anchor of the declaration at `ordinal` in `module`'s current source.
effect fn positionAnchor(resolver: &mut Resolver, module: &ModuleId, ordinal: usize) -> Option<Anchor>
! Cycle | OutOfMemoryError ? &mut Allocator {
  let answer = run observedDeclaration(&mut resolver.*, module, ordinal, SourceFacet.Body)
  if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(&resolver.*, &answer, module) {
    return IndexedSource.anchorOf(indexed, ordinal)
  }
  return Option<Anchor>.none()
}

// The anchor `declaration`'s typed body and MIR origins count from, in its current source; absent
// when the declaration is gone. An anonymous literal takes its enclosing declaration's anchor.
effect fn declarationAnchor(resolver: &mut Resolver, declaration: &DeclarationId) -> Option<Anchor>
! Cycle | OutOfMemoryError ? &mut Allocator {
  let module = ModuleId.copy(DeclarationId.moduleId(declaration))
  let answer = run observedSource(&mut resolver.*, &module, SourceSelector.Identity {identity: DeclarationId.copy(declaration)})
  if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(&resolver.*, &answer, &module) {
    if let Option<usize>.Some {value: ordinal} = move ModuleIndex.ordinalOf(IndexedSource.moduleIndex(indexed), declaration) {
      return IndexedSource.anchorOf(indexed, ordinal)
    }
  }
  return Option<Anchor>.none()
}

// The anchor `instance`'s MIR origins count from; drop glue has no authored body and no anchor.
effect fn instanceAnchor(resolver: &mut Resolver, instance: &InstanceKey) -> Option<Anchor>
! Cycle | OutOfMemoryError ? &mut Allocator {
  if let InstanceKey.DropGlue {..} = &instance.* { return Option<Anchor>.none() }
  let identity = DeclarationId.copyShared(&InstanceKey.identity(instance))
  return run declarationAnchor(&mut resolver.*, &identity)
}

// The current span of `origin`, counted from `anchor`; an origin without an anchor has no
// authored position.
fn anchoredSpan(anchor: &Option<Anchor>, origin: BodyOrigin) -> Span {
  if !Location.isAuthored(origin.location) {return Span.make(usize.ZERO, usize.ZERO)}
  return match &anchor.* {
    Option<Anchor>.Some {value} => BodyOrigin.span(origin, &value)
    Option<Anchor>.None => Span.make(usize.ZERO, usize.ZERO)
  }
}

// The body-local region `caller` opens at `syntax` for inferred binder `binder` of its call or
// literal, or for the expression's own loan when `binder` is `usize.MAX`.
effect fn localRegion(cursor: &AuthoredCursor, caller: &DeclarationId, syntax: HirId, binder: usize) -> Lifetime ! RevisionMismatch {
  return anchoredRegion(&run cursorAnchor(cursor), caller, syntax, binder)
}

// `localRegion` in the body `anchor` starts.
fn anchoredRegion(anchor: &Anchor, caller: &DeclarationId, syntax: HirId, binder: usize) -> Lifetime {
  return Lifetime.Local {declaration: DeclarationId.copy(caller), ordinal: Anchor.node(anchor, syntax), binder: binder}
}

effect fn bodyArgument(source: &SourceIndex, cursor: &AuthoredCursor, arguments: CallArguments, at: usize) -> HirId
! RevisionMismatch {
  return match arguments {
    CallArguments.Written {range} => run bodyChild(source, cursor, range, at)
    CallArguments.Single {expression} => expression
    CallArguments.Piped {input, range} => {
      if at == usize.ZERO { return input }
      return run bodyChild(source, cursor, range, at - usize.ONE)
    }
  }
}

effect fn bodyChild(source: &SourceIndex, cursor: &AuthoredCursor, range: Range, at: usize) -> HirId
! RevisionMismatch {
  if let Option<HirId>.Some {value} = move SourceIndex.authoredChild(source, cursor, range, at) {
    return value
  }
  fail RevisionMismatch {}
}

// ASSEMBLY-001/002: one checked `Intrinsic.assembly` use writes literal metadata, and its lanes
// and metadata satisfy the selected target's machine contract.
effect fn assemblyAdmitted(resolver: &Resolver, cursor: &AuthoredCursor, nodes: &[BodyNode],
  arguments: &[BodyNodeId], result: &Shared<Type>) -> bool
! RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  if arguments.length != 7 { return false }
  let mut texts = List<Bytes>.make()
  let mut at = usize.ZERO
  while at < 4 {
    let mut literal = Option<HirId>.none()
    if let BodyNodeKind.Expression {form, ..} = &nodes[arguments[at].index].kind {
      if let BodyExpression.Text {literal: written} = &form { literal = Option<HirId>.some(Anchor.hir(&run cursorAnchor(cursor), written)) }
    }
    let syntax = match move literal {
      Option<HirId>.Some {value} => value
      Option<HirId>.None => { return false }
    }
    let written = match run bodyNode(&resolver.source, cursor, syntax) {
      Node.TextLiteral {value} => run bodyText(&resolver.source, cursor, value)
      _ => { return false }
    }
    run List<Bytes>.append(&mut texts, move written)
    at = at + usize.ONE
  }
  let mut flags = List<bool>.make()
  while at < 6 {
    let mut flag = Option<bool>.none()
    if let BodyNodeKind.Expression {form, ..} = &nodes[arguments[at].index].kind {
      if let BodyExpression.Boolean {value} = &form { flag = Option<bool>.some(value) }
    }
    match move flag {
      Option<bool>.Some {value} => run List<bool>.append(&mut flags, value)
      Option<bool>.None => { return false }
    }
    at = at + usize.ONE
  }
  // The operand tuple is a literal: unit, or one positional tuple expression.
  let mut lanes = List<AssemblyLane>.make()
  let mut literalTuple = false
  if let BodyNodeKind.Expression {ty, form} = &nodes[arguments[6].index].kind {
    match &form {
      BodyExpression.Unit => { literalTuple = true }
      BodyExpression.Aggregate {..} => {
        literalTuple = true
        let count = Shared<Type>.with<usize>(&ty, fn(value: &Type) -> usize {
          return match &value.* {
            Type.Anonymous {members, ..} => List<Shared<Type>>.length(&members)
            _ => usize.ZERO
          }
        })
        let mut member = usize.ZERO
        while member < count {
          let lane = Shared<Type>.with<AssemblyLane>(&ty, fn(value: &Type) -> AssemblyLane {
            if let Type.Anonymous {members, ..} = &value.* {
              let listed = List<Shared<Type>>.asSlice(&members)
              return NativeAssembly.laneOf(&listed[member])
            }
            return AssemblyLane.Unavailable
          })
          run List<AssemblyLane>.append(&mut lanes, lane)
          member = member + usize.ONE
        }
      }
      _ => ()
    }
  }
  if !literalTuple { return false }
  let written = List<Bytes>.asSlice(&texts)
  let flagged = List<bool>.asSlice(&flags)
  return run NativeAssembly.admits(resolver.target.id(), Bytes.asSlice(&written[0]), Bytes.asSlice(&written[1]),
    Bytes.asSlice(&written[2]), Bytes.asSlice(&written[3]), flagged[0], flagged[1], NativeAssembly.laneOf(result),
    List<AssemblyLane>.asSlice(&lanes))
}

effect fn bodyText(source: &SourceIndex, cursor: &AuthoredCursor, symbol: Symbol) -> Bytes
! RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  if let Option<&[u8]>.Some {value} = move SourceIndex.authoredText(source, cursor, symbol) {
    return run Bytes.copy(value)
  }
  fail RevisionMismatch {}
}

// Whether a call without a written prefix that leaves a binder open is uninferable as a whole
// (SEM0052), as the bootstrap decides before solving bounds: no requirement-row binders, and no
// bound that could itself determine a parameter (a generic contract, a representation, or a
// provider or subset selection).
fn wholeCallInference(answer: &Result<Answer, NoRejection>) -> bool {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Signature {signature}} = &value.outcome {
      if List<RowParameter>.length(&signature.rowParameters) != usize.ZERO { return false }
      let bounds = List<Constraint>.asSlice(&signature.constraints)
      let mut at = usize.ZERO
      while at < bounds.length {
        let settled = match &bounds[at] {
          Constraint.Copyable {..} => true
          Constraint.ThreadSafe {..} => true
          Constraint.Property {..} => true
          Constraint.Contents {..} => true
          Constraint.Outlives {..} => true
          Constraint.Conforms {contract, ..} => Shared<Type>.with<bool>(&contract, nongenericNominal)
          _ => false
        }
        if !settled { return false }
        at = at + usize.ONE
      }
      return true
    }
  }
  return false
}

fn nongenericNominal(value: &Type) -> bool {
  return match &value.* {
    Type.Nominal {arguments, ..} => List<Argument>.length(&arguments) == usize.ZERO
    _ => false
  }
}

// SEM0052 for a call whose type arguments its values cannot all determine, naming the callee as
// written (`pick`, `Tools.pick`, `S.h`) or, for a receiver call, as `Owner.member`.
effect fn inferenceRejection(
  resolver: &Resolver, module: &ModuleId, cursor: &AuthoredCursor, expression: HirId, span: Span,
  receiver: &Option<CallReceiver>, declaration: &DeclarationId,
) -> Shared<Rejection> ! RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let mut diagnostic = run makeRejection(RejectionCode.TypeArgumentInference, module, span)
  let mut target = Option<Bytes>.none()
  if let Option<CallReceiver>.Some {..} = &receiver.* {
    if DeclarationId.ownerCount(declaration) == 2 && DeclarationId.ownerNamed(declaration, usize.ZERO) {
      let mut named = run DeclarationId.copyOwnerName(declaration, usize.ZERO)
      run Bytes.append(&mut named, b".")
      let member = run DeclarationId.copySpelling(declaration)
      run Bytes.append(&mut named, Bytes.asSlice(&member))
      target = Option<Bytes>.some(move named)
    }
  } else if let Node.CallExpression {callee, ..} = run bodyNode(&resolver.source, cursor, expression) {
    target = run writtenCallee(&resolver.source, cursor, callee)
  }
  if let Option<Bytes>.Some {value} = move target {
    run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"target"), value: move value})
  }
  return run Shared<Rejection>.make(move diagnostic)
}

// The dotted namespace path a callee is written as, such as `Tools.pick`; none for any other
// callee, including a projection from a value.
effect fn writtenCallee(source: &SourceIndex, cursor: &AuthoredCursor, callee: HirId) -> Option<Bytes>
! RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  match run bodyNode(source, cursor, callee) {
    Node.IdentifierExpression {name, binding} => {
      if binding.present { return Option<Bytes>.none() }
      if let Node.Name {text} = run bodyNode(source, cursor, name) {
        return Option<Bytes>.some(run bodyText(source, cursor, text))
      }
    }
    Node.FieldExpression {subject, field} => {
      if let Option<Bytes>.Some {value: prefix} = move run writtenCallee(source, cursor, subject) {
        if let Node.Name {text} = run bodyNode(source, cursor, field) {
          let mut written = move prefix
          run Bytes.append(&mut written, b".")
          let member = run bodyText(source, cursor, text)
          run Bytes.append(&mut written, Bytes.asSlice(&member))
          return Option<Bytes>.some(move written)
        }
      }
    }
    _ => ()
  }
  return Option<Bytes>.none()
}

// A two-segment written path such as `Status.Ready` in a member pattern.
effect fn bodyPathPair(source: &SourceIndex, cursor: &AuthoredCursor, path: HirId) -> Option<QualifiedBodyName>
! RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  if let Node.Path {segments} = run bodyNode(source, cursor, path) {
    if segments.length == 2 {
      let first = run bodyChild(source, cursor, segments, usize.ZERO)
      let second = run bodyChild(source, cursor, segments, usize.ONE)
      if let Node.Name {text: namespaceSymbol} = run bodyNode(source, cursor, first) {
        if let Node.Name {text: memberSymbol} = run bodyNode(source, cursor, second) {
          return Option<QualifiedBodyName>.some(QualifiedBodyName {
            intrinsic: false,
            namespace: run bodyText(source, cursor, namespaceSymbol),
            member: run bodyText(source, cursor, memberSymbol),
            subjectSpan: run bodySpan(source, cursor, first),
            application: Option<HirId>.none(),
          })
        }
      }
    }
  }
  return Option<QualifiedBodyName>.none()
}

effect fn bodyQualifiedName(source: &SourceIndex, cursor: &AuthoredCursor, callee: HirId) -> Option<
  QualifiedBodyName,
> ! RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  if let Node.FieldExpression {subject, field} = run bodyNode(source, cursor, callee) {
    if let Node.IdentifierExpression {name, binding} = run bodyNode(source, cursor, subject) {
      if !binding.present {
        if let Node.Name {text: namespaceSymbol} = run bodyNode(source, cursor, name) {
          if let Node.Name {text: memberSymbol} = run bodyNode(source, cursor, field) {
            return Option<QualifiedBodyName>.some(
              QualifiedBodyName {
                intrinsic: false,
                namespace: run bodyText(source, cursor, namespaceSymbol),
                member: run bodyText(source, cursor, memberSymbol),
                subjectSpan: run bodySpan(source, cursor, subject),
                application: Option<HirId>.none(),
              },
            )
          }
        }
      }
    }
  }
  // An applied qualifier such as `Make<i32>.make` parses as a field-free member selector.
  if let Node.MemberExpression {selector, fields} = run bodyNode(source, cursor, callee) {
    if fields.present { return Option<QualifiedBodyName>.none() }
    if let Node.MemberSelector {subject, member} = run bodyNode(source, cursor, selector) {
      if let Node.AppliedType {target, ..} = run bodyNode(source, cursor, subject) {
        if let Node.NamedType {path, hasMode, ..} = run bodyNode(source, cursor, target) {
          if !hasMode {
            if let Node.Path {segments} = run bodyNode(source, cursor, path) {
              if segments.length == 2 {
                let first = run bodyChild(source, cursor, segments, usize.ZERO)
                let second = run bodyChild(source, cursor, segments, usize.ONE)
                if let Node.Name {text: prefix} = run bodyNode(source, cursor, first) {
                  let namespace = run bodyText(source, cursor, prefix)
                  if same(Bytes.asSlice(&namespace), b"Intrinsic") {
                    if let Node.Name {text: declaration} = run bodyNode(source, cursor, second) {
                      if let Node.Name {text: memberSymbol} = run bodyNode(source, cursor, member) {
                        return Option<QualifiedBodyName>.some(QualifiedBodyName {
                          intrinsic: true, namespace: run bodyText(source, cursor, declaration),
                          member: run bodyText(source, cursor, memberSymbol), subjectSpan: run bodySpan(source, cursor, subject),
                          application: Option<HirId>.some(subject),
                        })
                      }
                    }
                  }
                }
              }
              if segments.length == usize.ONE {
                let first = run bodyChild(source, cursor, segments, usize.ZERO)
                if let Node.Name {text: namespaceSymbol} = run bodyNode(source, cursor, first) {
                  if let Node.Name {text: memberSymbol} = run bodyNode(source, cursor, member) {
                    return Option<QualifiedBodyName>.some(QualifiedBodyName {
                      intrinsic: false,
                      namespace: run bodyText(source, cursor, namespaceSymbol),
                      member: run bodyText(source, cursor, memberSymbol),
                      subjectSpan: run bodySpan(source, cursor, subject),
                      application: Option<HirId>.some(subject),
                    })
                  }
                }
              }
            }
          }
        }
      }
    }
  }
  return Option<QualifiedBodyName>.none()
}

effect fn unsupportedBody(resolver: &Resolver, module: &ModuleId, span: Span) -> Result<
  PreparedBody,
  Shared<Rejection>,
> ! OutOfMemoryError ? &mut Allocator {
  return Result<PreparedBody, Shared<Rejection>>.failResult(
    run reject(&resolver.*, module, RejectionCode.Unsupported, span),
  )
}

// The written signature of a function, or of a contract operation, whose body is its default.
fn namedCallableContract(hir: &Module, header: HirId) -> Option<HirId> {
  return match Module.node(hir, header) {
    Node.FunctionHeader {contract, ..} => Option<HirId>.some(contract)
    Node.OperationHeader {contract, ..} => Option<HirId>.some(contract)
    _ => Option<HirId>.none()
  }
}

fn functionHeaderContract(hir: &Module, header: HirId) -> Option<HirId> {
  if let Node.CallableContract {..} = Module.node(hir, header) { return Option<HirId>.some(header) }
  if let Node.FunctionHeader {contract, ..} = Module.node(hir, header) {
    return Option<HirId>.some(contract)
  }
  // A contract operation's header, whose body is the operation's default.
  if let Node.OperationHeader {contract, ..} = Module.node(hir, header) {
    return Option<HirId>.some(contract)
  }
  return Option<HirId>.none()
}

fn mutableParameter(hir: &Module, parameter: HirId) -> bool {
  if let Node.Parameter {mode, ..} = Module.node(hir, parameter) {
    return mode == ParameterMode.Mutable
  }
  return false
}

fn staticParameter(hir: &Module, parameter: HirId) -> bool {
  if let Node.Parameter {mode, ..} = Module.node(hir, parameter) {
    return mode == ParameterMode.Static
  }
  return false
}

// Value and mutable runtime parameters have storage identified by their written name.
fn valueParameterName(hir: &Module, parameter: HirId, staticBody: bool) -> Option<HirId> {
  if let Node.Parameter {name, mode, ..} = Module.node(hir, parameter) {
    if mode == ParameterMode.Value || mode == ParameterMode.Mutable || (staticBody && mode == ParameterMode.Static) {
      return Option<HirId>.some(name)
    }
  }
  return Option<HirId>.none()
}

fn collidesWithParameter(hir: &Module, locals: &List<BodyLocal>, name: HirId, anchor: &Anchor) -> bool {
  let earlier = List<BodyLocal>.asSlice(locals)
  let mut prior = usize.ZERO
  while prior < earlier.length {
    let earlierId = BodyOrigin.syntax(earlier[prior].origin, anchor)
    if let Node.Parameter {name: earlierName, ..} = Module.node(hir, earlierId) {
      if sameBinderName(hir, name, earlierName) {
        return true
      }
    }
    prior = prior + usize.ONE
  }
  return false
}

fn callableBodyBlock(hir: &Module, local: HirId) -> Option<HirId> {
  if let Node.CallableExpression {body, ..} = Module.node(hir, local) {
    if let Node.Block {..} = Module.node(hir, body) { return Option<HirId>.some(body) }
    return Option<HirId>.none()
  }
  let body = match Module.node(hir, local) {
    Node.Declaration {body, ..} => body
    _ => {
      return Option<HirId>.none()
    }
  }
  let writtenBlock = match Module.node(hir, body) {
    Node.CallableBody {block} => block
    _ => {
      return Option<HirId>.none()
    }
  }
  if !writtenBlock.present {
    return Option<HirId>.none()
  }
  if let Node.Block {..} = Module.node(hir, writtenBlock.id) {
    return Option<HirId>.some(writtenBlock.id)
  }
  return Option<HirId>.none()
}

// Copy only the declaration-owned facts needed by the effectful checker. The source-index HIR
// loan ends with this preparation, so later semantic demands can borrow the resolver mutably.
struct PreparedCallableContract {
  parameters: Range,
  isStatic: bool,
}

fn preparedCallableContract(node: Node) -> Option<PreparedCallableContract> {
  return match node {
    Node.CallableContract {parameters, isStatic, ..} => Option<PreparedCallableContract>.some(
      PreparedCallableContract {parameters: parameters, isStatic: isStatic})
    _ => Option<PreparedCallableContract>.none()
  }
}

effect fn prepareBody(
  resolver: &Resolver,
  module: &ModuleId,
  indexed: &IndexedSource,
  ordinal: usize,
  signature: &Shared<Result<Answer, NoRejection>>,
  parameterCount: usize,
  contractBody: bool,
  selectedBody: bool,
) -> Result<PreparedBody, Shared<Rejection>> ! OutOfMemoryError ? &mut Allocator {
  let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(indexed))
  if ordinal >= declarations.length {
    return Result<PreparedBody, Shared<Rejection>>.failResult(
      run reject(&resolver.*, module, RejectionCode.Unsupported, Span.make(usize.ZERO, usize.ZERO)),
    )
  }
  let declaration = &declarations[ordinal]
  let hir = IndexedSource.authored(indexed)
  let headerSpan = Module.span(hir, declaration.header)
  let anchor = match move IndexedSource.anchorOf(indexed, ordinal) {
    Option<Anchor>.Some {value} => move value
    Option<Anchor>.None => {
      return run unsupportedBody(&resolver.*, module, headerSpan)
    }
  }
  let mut staticBody = false
  let contractNode = match move functionHeaderContract(hir, declaration.header) {
    Option<HirId>.Some {value} => value
    Option<HirId>.None => {
      return run unsupportedBody(&resolver.*, module, headerSpan)
    }
  }
  let mut writtenParameters = Range.empty()
  match move preparedCallableContract(Module.node(hir, contractNode)) {
    Option<PreparedCallableContract>.Some {value} => {
      staticBody = value.isStatic
      writtenParameters = value.parameters
    }
    Option<PreparedCallableContract>.None => {
      return run unsupportedBody(&resolver.*, module, headerSpan)
    }
  }
  if writtenParameters.length != parameterCount {
    return run unsupportedBody(&resolver.*, module, headerSpan)
  }
  let mut locals = List<BodyLocal>.make()
  let mut abstractBody = contractBody
  let mut at = usize.ZERO
  while at < parameterCount {
    let parameterId = Module.child(hir, writtenParameters, at)
    let selected = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(
      signature,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> {
        return signatureParameter(answer, at)
      },
    )
    let parameterType = match move selected {
      Option<Shared<Type>>.Some {value} => move value
      Option<Shared<Type>>.None => {
        return run unsupportedBody(&resolver.*, module, headerSpan)
      }
    }
    if !Shared<Type>.with<bool>(&parameterType, scalarType) {
      abstractBody = true
    }
    // A selected body's static parameter has no storage: its reads are the selection's Embedded
    // values. Only an abstract body would need one, and no abstract body checks static work.
    if selectedBody && !staticBody && staticParameter(hir, parameterId) {
      at = at + usize.ONE
      continue
    }
    let name = match move valueParameterName(hir, parameterId, staticBody) {
      Option<HirId>.Some {value} => value
      Option<HirId>.None => {
        if mutableParameter(hir, parameterId) {
          return Result<PreparedBody, Shared<Rejection>>.failResult(
            run reject(&resolver.*, module, RejectionCode.MutableParameterUnavailable, Module.span(hir, parameterId)),
          )
        }
        return run unsupportedBody(&resolver.*, module, Module.span(hir, parameterId))
      }
    }
    if collidesWithParameter(hir, &locals, name, &anchor) {
      return Result<PreparedBody, Shared<Rejection>>.failResult(
        run reject(&resolver.*, module, RejectionCode.DuplicateParameterName, Module.span(hir, name)),
      )
    }
    run List<BodyLocal>.append(
      &mut locals,
      BodyLocal {
        origin: BodyOrigin.at(&anchor, parameterId, Module.span(hir, name)),
        ty: move parameterType,
        mutable: mutableParameter(hir, parameterId),
        meetDepth: Option<usize>.none(),
        written: true,
      },
    )
    at = at + usize.ONE
  }
  let block = match move callableBodyBlock(hir, declaration.local) {
    Option<HirId>.Some {value} => value
    Option<HirId>.None => {
      return run unsupportedBody(&resolver.*, module, headerSpan)
    }
  }
  return Result<PreparedBody, Shared<Rejection>>.succeed(
    PreparedBody {
      block: block,
      identity: DeclarationId.copy(&declaration.identity),
      locals: move locals,
      contractBody: abstractBody,
      staticBody: staticBody,
    },
  )
}

// A block in any position but a runtime body's root: a recovered statement list fails it with the
// list's last failure, the earlier ones staying in the body frame's recovered sink.
effect fn checkBlock(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut List<Dependency>,
  module: &ModuleId,
  cursor: &AuthoredCursor,
  caller: &DeclarationId,
  locals: &mut List<BodyLocal>,
  annotations: &[ResolvedAnnotation],
  calls: &[ResolvedCall],
  nodes: &mut List<BodyNode>,
  signatures: &mut List<SignatureDependency>,
  requiredBodies: &mut List<DeclarationId>,
  block: HirId,
  resultType: &Shared<Type>,
  constraints: &[Constraint],
  contractBody: bool,
  staticBody: bool,
  loopDepth: usize,
  unsafeAllowed: bool,
) -> Result<CheckedControl, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let listed = run checkBlockList(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
    module, cursor, caller, &mut locals.*, annotations, calls, &mut nodes.*, &mut signatures.*,
    &mut requiredBodies.*, block, resultType, constraints, contractBody, staticBody, loopDepth,
    unsafeAllowed, &BlockTail.Discarded)
  return match move listed {
    BlockList.Checked {control} => Result<CheckedControl, Shared<Rejection>>.succeed(move control)
    BlockList.Recovered {failure, ..} => Result<CheckedControl, Shared<Rejection>>.failResult(move failure)
    BlockList.Failed {error} => Result<CheckedControl, Shared<Rejection>>.failResult(move error)
  }
}

// What a block does with its last expression statement. A statement block discards it, which
// only a `()` or `never` value may be (STMT-001); a block in value position yields it as the
// block's value, checked against the value's expected type (BLOCK-001).
union BlockTail {
  Discarded,
  Yielded {expected: Option<Shared<Type>>, mismatchCode: RejectionCode},
}

// How a block checked; see `StatementList`.
union BlockList {
  Checked {control: CheckedControl},
  Recovered {control: CheckedControl, failure: Shared<Rejection>},
  Failed {error: Shared<Rejection>},
}

effect fn checkBlockList(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut List<Dependency>,
  module: &ModuleId,
  cursor: &AuthoredCursor,
  caller: &DeclarationId,
  locals: &mut List<BodyLocal>,
  annotations: &[ResolvedAnnotation],
  calls: &[ResolvedCall],
  nodes: &mut List<BodyNode>,
  signatures: &mut List<SignatureDependency>,
  requiredBodies: &mut List<DeclarationId>,
  block: HirId,
  resultType: &Shared<Type>,
  constraints: &[Constraint],
  contractBody: bool,
  staticBody: bool,
  loopDepth: usize,
  unsafeAllowed: bool,
  tail: &BlockTail,
) -> BlockList
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  if let Node.Block {statements: written} = run bodyNode(&resolver.source, cursor, block) {
    let mut bindings = List<Symbol>.make()
    let mut statements = List<BodyNodeId>.make()
    let mut yielded = Option<BodyNodeId>.none()
    if staticBody { run pushStaticPrefix(&mut resolver.*) }
    let checked = run checkStatements(
      &mut resolver.*,
      &mut owner.*,
      &mut request.*,
      &mut dependencies.*,
      module,
      cursor,
      caller,
      &mut locals.*,
      &mut bindings,
      annotations,
      calls,
      &mut nodes.*,
      &mut signatures.*,
      &mut requiredBodies.*,
      &mut statements,
      written,
      resultType,
      constraints,
      contractBody,
      staticBody,
      loopDepth,
      unsafeAllowed,
      tail,
      &mut yielded,
    )
    if staticBody { popStaticPrefix(&mut resolver.*) }
    let mut canComplete = false
    let mut failure = Option<Shared<Rejection>>.none()
    match move checked {
      StatementList.Checked {reachable} => {
        // A checked statement list holds no recovered statement.
        let checkedStatements = List<BodyNodeId>.asSlice(&statements)
        let checkedNodes = List<BodyNode>.asSlice(&nodes.*)
        let mut each = usize.ZERO
        while each < checkedStatements.length {
          if let BodyNodeKind.Recovered {..} = &checkedNodes[checkedStatements[each].index].kind {
            return CompilerBug.panic(b"a checked statement list holds a recovered statement")
          }
          each = each + usize.ONE
        }
        canComplete = reachable
      }
      StatementList.Recovered {reachable, failure: last} => {
        canComplete = reachable
        failure = Option<Shared<Rejection>>.some(move last)
      }
      StatementList.Failed {error} => { return BlockList.Failed {error: move error} }
    }
    let node = BodyNodeId {index: List<BodyNode>.length(&nodes.*)}
    run List<BodyNode>.append(
      &mut nodes.*,
      BodyNode {
        origin: run bodyOrigin(&resolver.source, cursor, block),
        kind: BodyNodeKind.Block {statements: move statements, value: move yielded, canComplete: canComplete},
      },
    )
    let control = CheckedControl {node: node, canComplete: canComplete}
    if let Option<Shared<Rejection>>.Some {value} = move failure {
      return BlockList.Recovered {control: move control, failure: move value}
    }
    return BlockList.Checked {control: move control}
  }
  return BlockList.Failed {error:
    run reject(
      &resolver.*,
      module,
      RejectionCode.Unsupported,
      run bodySpan(&resolver.source, cursor, block),
    ),
  }
}

effect fn checkConditional(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut List<Dependency>,
  module: &ModuleId,
  cursor: &AuthoredCursor,
  caller: &DeclarationId,
  locals: &mut List<BodyLocal>,
  annotations: &[ResolvedAnnotation],
  calls: &[ResolvedCall],
  nodes: &mut List<BodyNode>,
  signatures: &mut List<SignatureDependency>,
  requiredBodies: &mut List<DeclarationId>,
  statement: HirId,
  resultType: &Shared<Type>,
  constraints: &[Constraint],
  contractBody: bool,
  staticBody: bool,
  loopDepth: usize,
  unsafeAllowed: bool,
) -> Result<CheckedControl, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  if let Node.ConditionalStatement {condition, thenBranch, elseBranch} = run bodyNode(
    &resolver.source,
    cursor,
    statement,
  ) {
    let checkedCondition = run checkStatementExpression(
      &mut resolver.*,
      &mut owner.*,
      &mut request.*,
      &mut dependencies.*,
      module,
      cursor,
      caller,
      &mut locals.*,
      annotations,
      resultType,
      loopDepth,
      calls,
      &mut nodes.*,
      &mut signatures.*,
      &mut requiredBodies.*,
      condition,
      &Option<Shared<Type>>.none(), RejectionCode.TypeMismatch,
      constraints,
      contractBody,
      staticBody,
      unsafeAllowed, false,
    )
    let conditionNode = match move checkedCondition {
      Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
      Result<BodyNodeId, Shared<Rejection>>.Failure {error} => {
        return Result<CheckedControl, Shared<Rejection>>.failResult(move error)
      }
    }
    let boolType = run primitiveType(b"bool")
    let conditionType = match & List<BodyNode>.asSlice(&nodes.*)[conditionNode.index].kind {
      BodyNodeKind.Expression {ty, ..} => Shared<Type>.clone(&ty)
      _ => {
        return Result<CheckedControl, Shared<Rejection>>.failResult(
          run reject(
            &resolver.*,
            module,
            RejectionCode.Unsupported,
            run bodySpan(&resolver.source, cursor, condition),
          ),
        )
      }
    }
    if !run Type.equalsShared(&conditionType, &boolType) {
      return Result<CheckedControl, Shared<Rejection>>.failResult(
        run typeHoleRejection(
          module,
          RejectionCode.ConditionNotBool,
          run bodySpan(&resolver.source, cursor, condition),
          b"actual",
          &conditionType,
        ),
      )
    }
    let checkedThen = run checkBlock(
      &mut resolver.*,
      &mut owner.*,
      &mut request.*,
      &mut dependencies.*,
      module,
      cursor,
      caller,
      &mut locals.*,
      annotations,
      calls,
      &mut nodes.*,
      &mut signatures.*,
      &mut requiredBodies.*,
      thenBranch,
      resultType,
      constraints,
      contractBody,
      staticBody,
      loopDepth,
      unsafeAllowed,
    )
    let thenControl = match move checkedThen {
      Result<CheckedControl, Shared<Rejection>>.Success {value} => move value
      Result<CheckedControl, Shared<Rejection>>.Failure {error} => {
        return Result<CheckedControl, Shared<Rejection>>.failResult(
          run blockArmValueRejection(&resolver.*, module, cursor, thenBranch, move error, b"4"),
        )
      }
    }
    let mut checkedElse = Option<BodyNodeId>.none()
    let mut elseCanComplete = true
    if elseBranch.present {
      let otherwise = run checkControl(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
        module, cursor, caller, &mut locals.*, annotations, calls, &mut nodes.*, &mut signatures.*,
        &mut requiredBodies.*, elseBranch.id, resultType, constraints, contractBody, staticBody, loopDepth, unsafeAllowed)
      match move otherwise {
        Result<CheckedControl, Shared<Rejection>>.Success {value} => {
          checkedElse = Option<BodyNodeId>.some(value.node)
          elseCanComplete = value.canComplete
        }
        Result<CheckedControl, Shared<Rejection>>.Failure {error} => {
          return Result<CheckedControl, Shared<Rejection>>.failResult(
            run blockArmValueRejection(&resolver.*, module, cursor, elseBranch.id, move error, b"4"),
          )
        }
      }
    }
    let canComplete = thenControl.canComplete || elseCanComplete
    let node = BodyNodeId {index: List<BodyNode>.length(&nodes.*)}
    run List<BodyNode>.append(
      &mut nodes.*,
      BodyNode {
        origin: run bodyOrigin(&resolver.source, cursor, statement),
        kind: BodyNodeKind.Branch {
          condition: conditionNode,
          thenBranch: thenControl.node,
          elseBranch: move checkedElse,
          canComplete: canComplete,
        },
      },
    )
    return Result<CheckedControl, Shared<Rejection>>.succeed(
      CheckedControl {node: node, canComplete: canComplete},
    )
  }
  return Result<CheckedControl, Shared<Rejection>>.failResult(
    run reject(
      &resolver.*,
      module,
      RejectionCode.Unsupported,
      run bodySpan(&resolver.source, cursor, statement),
    ),
  )
}

// One statement-level control body: a block, or an `if` / `if let` reached through `else`.
effect fn checkControl(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, request: &mut Request,
  dependencies: &mut List<Dependency>, module: &ModuleId, cursor: &AuthoredCursor, caller: &DeclarationId,
  locals: &mut List<BodyLocal>, annotations: &[ResolvedAnnotation], calls: &[ResolvedCall],
  nodes: &mut List<BodyNode>, signatures: &mut List<SignatureDependency>,
  requiredBodies: &mut List<DeclarationId>, statement: HirId, resultType: &Shared<Type>,
  constraints: &[Constraint], contractBody: bool, staticBody: bool, loopDepth: usize, unsafeAllowed: bool,
) -> Result<CheckedControl, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  return match run bodyNode(&resolver.source, cursor, statement) {
    Node.Block {..} => run checkBlock(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
      module, cursor, caller, &mut locals.*, annotations, calls, &mut nodes.*, &mut signatures.*,
      &mut requiredBodies.*, statement, resultType, constraints, contractBody, staticBody, loopDepth, unsafeAllowed)
    Node.ConditionalStatement {..} => run checkConditional(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
      module, cursor, caller, &mut locals.*, annotations, calls, &mut nodes.*, &mut signatures.*,
      &mut requiredBodies.*, statement, resultType, constraints, contractBody, staticBody, loopDepth, unsafeAllowed)
    Node.PatternConditionalStatement {pattern, subject, thenBranch, elseBranch} => run checkPatternStatement(
      &mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module, cursor, caller, &mut locals.*,
      annotations, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*, statement, subject,
      MatchArms.Conditional {pattern: pattern, thenBranch: thenBranch, elseBranch: elseBranch},
      resultType, constraints, contractBody, staticBody, loopDepth, unsafeAllowed)
    _ => Result<CheckedControl, Shared<Rejection>>.failResult(
      run reject(&resolver.*, module, RejectionCode.Unsupported, run bodySpan(&resolver.source, cursor, statement)),
    )
  }
}

// `if let P = e` and `let P = e` check as a statement-position match over `e`, whose written
// syntax chooses the access: `&e` shares, `&mut e` borrows exclusively, `move e` consumes and a
// bare `e` reads one Copy value (PATT-002).
effect fn checkPatternStatement(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, request: &mut Request,
  dependencies: &mut List<Dependency>, module: &ModuleId, cursor: &AuthoredCursor, caller: &DeclarationId,
  locals: &mut List<BodyLocal>, annotations: &[ResolvedAnnotation], calls: &[ResolvedCall],
  nodes: &mut List<BodyNode>, signatures: &mut List<SignatureDependency>,
  requiredBodies: &mut List<DeclarationId>, statement: HirId, subject: HirId, arms: MatchArms,
  resultType: &Shared<Type>, constraints: &[Constraint], contractBody: bool, staticBody: bool,
  loopDepth: usize, unsafeAllowed: bool,
) -> Result<CheckedControl, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let span = run bodySpan(&resolver.source, cursor, statement)
  if staticBody {
    return Result<CheckedControl, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Unsupported, span))
  }
  // A statement's branches are statement blocks, whose values it discards.
  let mut statementScope = StatementScope {locals: &mut locals.*, annotations: annotations, resultType: resultType, loopDepth: loopDepth,
    staticBinders: &[], staticValues: &[], discarded: HirRef.of(statement)}
  let checked = run checkPatternMatch(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module, cursor,
    caller, &mut statementScope, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*, statement, subject, arms,
    &Option<Shared<Type>>.none(), RejectionCode.TypeMismatch, constraints, contractBody, unsafeAllowed)
  let node = match move checked {
    Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
    Result<BodyNodeId, Shared<Rejection>>.Failure {error} => { return Result<CheckedControl, Shared<Rejection>>.failResult(move error) }
  }
  let diverges = match &List<BodyNode>.asSlice(&nodes.*)[node.index].kind {
    BodyNodeKind.Expression {ty, ..} => Shared<Type>.with<bool>(&ty, neverType)
    _ => false
  }
  return Result<CheckedControl, Shared<Rejection>>.succeed(CheckedControl {node: node, canComplete: !diverges})
}

// The match an `if let`, a destructuring `let` or an `if let` expression checks as, over `subject`.
effect fn checkPatternMatch<'scope>(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, request: &mut Request,
  dependencies: &mut List<Dependency>, module: &ModuleId, cursor: &AuthoredCursor, caller: &DeclarationId,
  statementScope: &mut StatementScope<'scope>, calls: &[ResolvedCall], nodes: &mut List<BodyNode>,
  signatures: &mut List<SignatureDependency>, requiredBodies: &mut List<DeclarationId>, statement: HirId, subject: HirId,
  arms: MatchArms, expected: &Option<Shared<Type>>, mismatchCode: RejectionCode, constraints: &[Constraint],
  contractBody: bool, unsafeAllowed: bool,
) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let span = run bodySpan(&resolver.source, cursor, statement)
  let mut access = MatchAccess.Default
  let mut operand = subject
  match run bodyNode(&resolver.source, cursor, subject) {
    Node.BorrowExpression {access: borrowed, operand: borrowedOperand} => {
      access = MatchAccess.Shared
      if borrowed == Access.Mutable { access = MatchAccess.Mutable }
      operand = borrowedOperand
    }
    Node.MoveExpression {operand: movedOperand} => {
      access = MatchAccess.Move
      operand = movedOperand
    }
    _ => ()
  }
  let checkedSubject = run checkExpression(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module,
    cursor, caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*,
    operand, &Option<Shared<Type>>.none(), RejectionCode.TypeMismatch, constraints, contractBody, false, unsafeAllowed)
  let subjectNode = match move checkedSubject {
    Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
    Result<BodyNodeId, Shared<Rejection>>.Failure {error} => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move error) }
  }
  let subjectType = match move bodyExpressionType(List<BodyNode>.asSlice(&nodes.*), &subjectNode) {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => {
      return Result<BodyNodeId, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Unsupported, span))
    }
  }
  // An `if let` over a scalar enum selects members like the equivalent enum match.
  let mut enumMembers = Option<Shared<Result<Answer, NoRejection>>>.none()
  if let MatchArms.Conditional {..} = arms {
    match move run subjectScalarEnum(&mut resolver.*, &mut owner.*, &mut dependencies.*, &subjectType, span) {
      Option<Result<Shared<Result<Answer, NoRejection>>, Shared<Rejection>>>.Some {value: selected} => match move selected {
        Result<Shared<Result<Answer, NoRejection>>, Shared<Rejection>>.Success {value} => {
          enumMembers = Option<Shared<Result<Answer, NoRejection>>>.some(move value)
        }
        Result<Shared<Result<Answer, NoRejection>>, Shared<Rejection>>.Failure {error} => {
          return Result<BodyNodeId, Shared<Rejection>>.failResult(move error)
        }
      }
      Option<Result<Shared<Result<Answer, NoRejection>>, Shared<Rejection>>>.None => ()
    }
  }
  return match move enumMembers {
    Option<Shared<Result<Answer, NoRejection>>>.Some {value: members} => run checkScalarEnumMatch(&mut resolver.*,
      &mut owner.*, &mut request.*, &mut dependencies.*, module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*,
      &mut signatures.*, &mut requiredBodies.*, statement, subjectNode, &subjectType, &members, access, arms,
      expected, mismatchCode, constraints, contractBody, unsafeAllowed, span)
    Option<Shared<Result<Answer, NoRejection>>>.None => run checkRecordMatch(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module,
      cursor, caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*,
      statement, subjectNode, &subjectType, access, arms, expected, mismatchCode, constraints, contractBody,
      unsafeAllowed, span)
  }
}

struct BodyFacts {
  annotations: List<ResolvedAnnotation>,
  calls: List<ResolvedCall>,
}

// The premises a body may assume: its signature's bounds and its inputs' well-formedness, including
// their stored fields (LIFE-002). An anonymous callable or `effect {}` block is checked inside its
// enclosing body, so it also assumes that body's premises. Typing and lowering both read this one
// set, so a call that typing proved is proved again under the same premises.
// A header-only demand records the dependency without checking any runtime callee body.
effect fn bodyPremises(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, moduleOrdinal: usize, declaration: usize,
) -> Result<List<Constraint>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let declarationAccess135Request = Key {
    family: Family.BodyPremises, module: moduleOrdinal, name: usize.ZERO,
    declaration: declaration, member: usize.ZERO, external: false,
  }
  let declarationAccess135 = run internDeclaration(&mut resolver.*, declarationAccess135Request)
  let answer = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, declarationAccess135, Span.make(usize.ZERO, usize.ZERO))
  let rejected = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(&answer, answerCause)
  if let Option<Shared<Rejection>>.Some {value} = move rejected {
    return Result<List<Constraint>, Shared<Rejection>>.failResult(move value)
  }
  let count = Shared<Result<Answer, NoRejection>>.with<usize>(&answer, bodyPremiseCount)
  let mut premises = List<Constraint>.make()
  let mut at = usize.ZERO
  while at < count {
    let premise = Shared<Result<Answer, NoRejection>>.with<Option<Constraint>>(&answer,
      fn(value: &Result<Answer, NoRejection>) -> Option<Constraint> { return bodyPremiseAt(value, at) })
    if let Option<Constraint>.Some {value} = move premise { run List<Constraint>.append(&mut premises, move value) }
    at = at + usize.ONE
  }
  return Result<List<Constraint>, Shared<Rejection>>.succeed(move premises)
}

fn bodyPremiseCount(answer: &Result<Answer, NoRejection>) -> usize {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.BodyPremises {constraints}} = &value.outcome { return List<Constraint>.length(&constraints) }
  }
  return usize.ZERO
}

fn bodyPremiseAt(answer: &Result<Answer, NoRejection>, at: usize) -> Option<Constraint> {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.BodyPremises {constraints}} = &value.outcome {
      let listed = List<Constraint>.asSlice(&constraints)
      if at < listed.length { return Option<Constraint>.some(copyConstraint(&listed[at])) }
    }
  }
  return Option<Constraint>.none()
}

// Computes `bodyPremises` for one declaration; each child demand is recorded on the answer.
effect fn resolveBodyPremises(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, key: Key) -> Answer
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut dependencies = List<Dependency>.make()
  let declarationAccess136 = declarationPosition(&resolver.*, key)
  let computed = run computeBodyPremises(&mut resolver.*, &mut owner.*, &mut dependencies, key.module, declarationAccess136)
  return match move computed {
    Result<List<Constraint>, Shared<Rejection>>.Success {value} => memberSuccess(
      Value.BodyPremises {constraints: move value}, move dependencies)
    Result<List<Constraint>, Shared<Rejection>>.Failure {error} => run memberRejected(move error, move dependencies)
  }
}

effect fn computeBodyPremises(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, moduleOrdinal: usize, declaration: usize,
) -> Result<List<Constraint>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let module = resolvedModule(&resolver.*, moduleOrdinal)
  let mut constraints = match move run enclosingBodyPremises(&mut resolver.*, &mut owner.*, &mut dependencies.*,
    &module, moduleOrdinal, declaration) {
    Result<List<Constraint>, Shared<Rejection>>.Success {value} => move value
    Result<List<Constraint>, Shared<Rejection>>.Failure {error} => {
      return Result<List<Constraint>, Shared<Rejection>>.failResult(move error)
    }
  }
  // An `effect {}` block declares no bounds; its signature is derived from the body being checked.
  if run effectBlockHeader(&mut resolver.*, &module, declaration) {
    return Result<List<Constraint>, Shared<Rejection>>.succeed(move constraints)
  }
  let declarationAccess137Request = Key {
    family: Family.Signature, module: moduleOrdinal, name: usize.ZERO,
    declaration: declaration, member: usize.ZERO, external: false,
  }
  let declarationAccess137 = run internDeclaration(&mut resolver.*, declarationAccess137Request)
  let signature = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, declarationAccess137, Span.make(usize.ZERO, usize.ZERO))
  let rejected = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(&signature, answerCause)
  if let Option<Shared<Rejection>>.Some {value} = move rejected {
    return Result<List<Constraint>, Shared<Rejection>>.failResult(move value)
  }
  let count = Shared<Result<Answer, NoRejection>>.with<usize>(&signature, signatureConstraintCount)
  let mut at = usize.ZERO
  while at < count {
    let selected = Shared<Result<Answer, NoRejection>>.with<Option<Constraint>>(&signature,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Constraint> { return signatureConstraint(answer, at) })
    if let Option<Constraint>.Some {value} = move selected { run List<Constraint>.append(&mut constraints, move value) }
    at = at + usize.ONE
  }
  // A member body is checked under its implementation head's bounds, so
  // `impl<T: Serialize> Serialize for List<T>` may call `Serialize.serialize` on a `T`.
  let headFailure = run appendHeadBounds(&mut resolver.*, &mut owner.*, &mut dependencies.*, &module, moduleOrdinal,
    declaration, false, &mut constraints)
  if let Option<Shared<Rejection>>.Some {value} = move headFailure {
    return Result<List<Constraint>, Shared<Rejection>>.failResult(move value)
  }
  // A default operation body is checked for any provider of its contract, so it may call the
  // contract's own operations on `Self`.
  run appendContractSelfBound(&mut resolver.*, &module, declaration, &mut constraints)
  run appendBodyPremises(&mut resolver.*, &module, declaration, &signature, &mut constraints)
  run appendRepresentationPremises(&mut constraints)
  if let Option<DeclarationId>.Some {value: caller} = move run declarationAt(&mut resolver.*, &module, declaration) {
    run appendStoredInputPremises(&mut resolver.*, &mut owner.*, &mut dependencies.*, &caller, &signature, &mut constraints)
  }
  return Result<List<Constraint>, Shared<Rejection>>.succeed(move constraints)
}

// The premises of the body that lexically encloses an anonymous callable or `effect {}` block; none
// for any other declaration.
effect fn enclosingBodyPremises(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, module: &ModuleId, moduleOrdinal: usize, declaration: usize)
  -> Result<List<Constraint>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let none = List<Constraint>.make()
  let identity = match move run declarationAt(&mut resolver.*, module, declaration) {
    Option<DeclarationId>.Some {value} => move value
    Option<DeclarationId>.None => { return Result<List<Constraint>, Shared<Rejection>>.succeed(move none) }
  }
  let kind = DeclarationId.kind(&identity)
  if kind != OwnerKind.Anonymous && kind != OwnerKind.EffectBlock {
    return Result<List<Constraint>, Shared<Rejection>>.succeed(move none)
  }
  let mut parent = usize.MAX
  let answer = run observedDeclaration(&mut resolver.*, module, declaration, SourceFacet.Parent)
  if let Option<&IndexedSource>.Some {value} = move sourceOf(&resolver.*, &answer, module) {
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(value))
    if declaration < declarations.length {
      if let Option<usize>.Some {value: enclosing} = &declarations[declaration].parent { parent = enclosing }
    }
  }
  if parent == usize.MAX { return Result<List<Constraint>, Shared<Rejection>>.succeed(move none) }
  return run bodyPremises(&mut resolver.*, &mut owner.*, &mut dependencies.*, moduleOrdinal, parent)
}

// The stored-data premises of every input (`appendStoredFieldPremises`).
effect fn appendStoredInputPremises(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, caller: &DeclarationId, signature: &Shared<Result<Answer, NoRejection>>,
  constraints: &mut List<Constraint>) -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let parameters = Shared<Result<Answer, NoRejection>>.with<usize>(signature, signatureParameterCount)
  let mut visited = List<StoredShape>.make()
  let mut listed = ListedPremises {lookup: InternIndex.make(), positions: List<usize>.make()}
  let mut reached = ReachedTypes {held: List<Shared<Type>>.make(), inputs: List<bool>.make(), lookup: InternIndex.make()}
  let mut at = usize.ZERO
  while at < List<Constraint>.length(&constraints.*) {
    run recordPremise(&mut listed, List<Constraint>.asSlice(&constraints.*), at)
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < parameters {
    let parameter = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(signature,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> { return signatureParameterAt(answer, at) })
    if let Option<Shared<Type>>.Some {value: ty} = move parameter {
      run appendStoredFieldPremises(&mut resolver.*, &mut owner.*, &mut dependencies.*, caller, &ty, &mut visited,
        &mut reached, &mut listed, &mut constraints.*)
    }
    at = at + usize.ONE
  }
  return ()
}

// LIFE-002 well-formedness of an input's stored data, which the body may assume like a borrowed
// input's own contents premise. A stored loan `&'r T` implies `T: 'r`; a struct, tuple or union
// value satisfies its declaration's region bounds, and each field, element and variant payload is
// well formed under the value's application, at any depth. So an input `Request<'r, 'c>` whose
// field is `&'r mut Connection<'c>` implies `Connection<'c>: 'r`.
//
// Premises are atomic (`appendContentsPremises`), so two applications of one declaration with the
// same `StoredShape` imply the same premises; each shape is read once. Shapes are finite, which
// ends recursive and growing declarations without losing a premise.
effect fn appendStoredFieldPremises(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, caller: &DeclarationId, value: &Shared<Type>, visited: &mut List<StoredShape>,
  reached: &mut ReachedTypes, listed: &mut ListedPremises, constraints: &mut List<Constraint>) -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  // A stored member is often the very handle its application also holds as an argument, and walking
  // one handle again lists nothing new.
  if !run reachType(&mut reached.*, value, true) { return () }
  let borrowed = Shared<Type>.with<Option<Constraint>>(value, inputLoanPremise)
  if let Option<Constraint>.Some {value: Constraint.Contents {subject, region}} = move borrowed {
    run appendStoredContents(&subject, &region, caller, &mut listed.*, &mut constraints.*)
    return run appendStoredFieldPremises(&mut resolver.*, &mut owner.*, &mut dependencies.*, caller, &subject,
      &mut visited.*, &mut reached.*, &mut listed.*, &mut constraints.*)
  }
  // Type arguments and structural members are well formed too (`S<&'a T>` implies `T: 'a`).
  let mut found = List<Shared<Type>>.make()
  run Type.storedComponents(value, &mut found)
  let components = List<Shared<Type>>.asSlice(&found)
  let mut at = usize.ZERO
  while at < components.length {
    run appendStoredFieldPremises(&mut resolver.*, &mut owner.*, &mut dependencies.*, caller, &components[at],
      &mut visited.*, &mut reached.*, &mut listed.*, &mut constraints.*)
    at = at + usize.ONE
  }
  if !run newStoredShape(value, &mut visited.*) { return () }
  // Only a declaration with loaded source has bounds and members to read.
  if declaringModuleOrdinal(&resolver.*, value) == usize.MAX { return () }
  let span = Span.make(usize.ZERO, usize.ZERO)
  let declared = run providerDeclaredBounds(&mut resolver.*, &mut owner.*, &mut dependencies.*, value, span)
  let bounds = List<Constraint>.asSlice(&declared)
  at = usize.ZERO
  while at < bounds.length {
    match &bounds[at] {
      Constraint.Outlives {longer, shorter} => {
        if !run knownOutlives(List<Constraint>.asSlice(&constraints.*), &longer, &shorter) {
          run List<Constraint>.append(&mut constraints.*, Constraint.Outlives {longer: Shared<Lifetime>.clone(&longer),
            shorter: Shared<Lifetime>.clone(&shorter)})
          run recordPremise(&mut listed.*, List<Constraint>.asSlice(&constraints.*), List<Constraint>.length(&constraints.*) - usize.ONE)
        }
      }
      Constraint.Contents {subject, region} => { run appendStoredContents(&subject, &region, caller, &mut listed.*, &mut constraints.*) }
      _ => ()
    }
    at = at + usize.ONE
  }
  let members = run storedMemberTypes(&mut resolver.*, &mut owner.*, &mut dependencies.*, value, span)
  let stored = List<Shared<Type>>.asSlice(&members)
  at = usize.ZERO
  while at < stored.length {
    run appendStoredFieldPremises(&mut resolver.*, &mut owner.*, &mut dependencies.*, caller, &stored[at],
      &mut visited.*, &mut reached.*, &mut listed.*, &mut constraints.*)
    at = at + usize.ONE
  }
  return ()
}

/// How many exact applications of already-read stored shapes one implied-bound walk reads. A resource
/// control, not a proof: a walk that needs more leaves the call's bounds unproved.
const storedApplicationRevisits: usize = 64

// Whether the implied-bound walk reads `value`'s stored members: its stored shape is new, or it is a
// new exact application of a shape already read. Two applications of one shape can imply opposite
// bounds (`M<&'a &'b T>` and `M<&'b &'a T>`), so the shape alone does not settle what is owed. The
// shapes are finitely many, but a polymorphically recursive one has unboundedly many applications, so
// the revisits are bounded and None reports a walk that stopped short.
effect fn readStoredApplication(value: &Shared<Type>, visited: &mut List<StoredShape>, walked: &mut List<Shared<Type>>,
  revisits: &mut usize) -> Option<bool> ! OutOfMemoryError ? &mut Allocator | &mut Types {
  if run newStoredShape(value, &mut visited.*) {
    run List<Shared<Type>>.append(&mut walked.*, Shared<Type>.clone(value))
    return Option<bool>.some(true)
  }
  let kind = Shared<Type>.with<OwnerKind>(value, nominalKind)
  if kind != OwnerKind.Struct && kind != OwnerKind.Tuple && kind != OwnerKind.Union { return Option<bool>.some(false) }
  let shape = match move run storedShape(value) {
    Option<StoredShape>.Some {value: found} => move found
    Option<StoredShape>.None => { return Option<bool>.some(false) }
  }
  if closedStoredShape(&shape) { return Option<bool>.some(false) }
  let seen = List<Shared<Type>>.asSlice(&walked.*)
  let mut at = usize.ZERO
  while at < seen.length {
    if run Type.equalsShared(&seen[at], value) { return Option<bool>.some(false) }
    at = at + usize.ONE
  }
  if revisits.* >= storedApplicationRevisits { return Option<bool>.none() }
  revisits.* = revisits.* + usize.ONE
  run List<Shared<Type>>.append(&mut walked.*, Shared<Type>.clone(value))
  return Option<bool>.some(true)
}

// Whether `value` is a struct, tuple or union application whose stored shape the walk has not read
// yet, recording it in `visited`. A closed application's stored data names no region or type
// parameter, so it implies nothing a body can use and is never read.
effect fn newStoredShape(value: &Shared<Type>, visited: &mut List<StoredShape>) -> bool
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let kind = Shared<Type>.with<OwnerKind>(value, nominalKind)
  if kind != OwnerKind.Struct && kind != OwnerKind.Tuple && kind != OwnerKind.Union { return false }
  let shape = match move run storedShape(value) {
    Option<StoredShape>.Some {value: found} => move found
    Option<StoredShape>.None => { return false }
  }
  if closedStoredShape(&shape) { return false }
  let seen = List<StoredShape>.asSlice(&visited.*)
  let mut at = usize.ZERO
  while at < seen.length {
    if seen[at].hash == shape.hash && run sameStoredShape(&seen[at], &shape) { return false }
    at = at + usize.ONE
  }
  run List<StoredShape>.append(&mut visited.*, move shape)
  return true
}

// The field, element and variant payload types of a nominal application, under its arguments. A
// declaration without loaded source stores nothing to read.
effect fn storedMemberTypes(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, value: &Shared<Type>, span: Span) -> List<Shared<Type>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut types = List<Shared<Type>>.make()
  let moduleOrdinal = declaringModuleOrdinal(&resolver.*, value)
  if moduleOrdinal == usize.MAX { return move types }
  let declaredModule = resolvedModule(&resolver.*, moduleOrdinal)
  let declaration = match move run ordinalOfProvider(&mut resolver.*, &declaredModule, value) {
    Option<usize>.Some {value: found} => found
    _ => { return move types }
  }
  let members = run storedMemberCount(&mut resolver.*, &declaredModule, declaration)
  let application = run internApplication(&mut resolver.*, value)
  let mut member = usize.ZERO
  while member < members {
    let declarationAccess138Request = Key {
      family: Family.MemberShape, module: moduleOrdinal, name: application,
      declaration: declaration, member: member, external: false,
    }
    let declarationAccess138 = run internDeclaration(&mut resolver.*, declarationAccess138Request)
    let shaped = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, declarationAccess138, span)
    let count = Shared<Result<Answer, NoRejection>>.with<usize>(&shaped, shapeLength)
    let mut part = usize.ZERO
    while count != usize.MAX && part < count {
      let stored = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(&shaped,
        fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> { return shapeTypeAt(answer, part) })
      if let Option<Shared<Type>>.Some {value: memberType} = move stored { run List<Shared<Type>>.append(&mut types, move memberType) }
      part = part + usize.ONE
    }
    member = member + usize.ONE
  }
  return move types
}

// `appendContentsPremises` for the stored-data walk: the same atomic premises, but a premise is
// skipped only when it is already listed, so the walk never searches the growing set's outlives graph.
effect fn appendStoredContents(subject: &Shared<Type>, region: &Shared<Lifetime>, caller: &DeclarationId,
  listed: &mut ListedPremises, constraints: &mut List<Constraint>) -> () ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut stored = List<Shared<Type>>.make()
  run List<Shared<Type>>.append(&mut stored, Shared<Type>.clone(subject))
  run Type.storedParameters(subject, &mut stored)
  let mut retained = List<Shared<Lifetime>>.make()
  let representations = List<Option<Shared<Type>>>.make()
  let known = run Type.retainedRegions(subject, caller, List<Option<Shared<Type>>>.asSlice(&representations), &mut retained, false)
  drop known
  let types = List<Shared<Type>>.asSlice(&stored)
  let mut at = usize.ZERO
  while at < types.length {
    run appendDistinctConstraint(&mut listed.*, &mut constraints.*, Constraint.Contents {subject: Shared<Type>.clone(&types[at]),
      region: Shared<Lifetime>.clone(region)})
    at = at + usize.ONE
  }
  let lifetimes = List<Shared<Lifetime>>.asSlice(&retained)
  at = usize.ZERO
  while at < lifetimes.length {
    run appendDistinctConstraint(&mut listed.*, &mut constraints.*, Constraint.Outlives {longer: Shared<Lifetime>.clone(&lifetimes[at]),
      shorter: Shared<Lifetime>.clone(region)})
    at = at + usize.ONE
  }
  return ()
}

effect fn appendDistinctConstraint(listed: &mut ListedPremises, constraints: &mut List<Constraint>, constraint: Constraint) -> ()
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let premises = List<Constraint>.asSlice(&constraints.*)
  let positions = List<usize>.asSlice(&listed.positions)
  let mut at = InternIndex.first(&listed.lookup, premiseHash(&constraint))
  while at != usize.MAX {
    if run sameConstraint(&premises[positions[at]], &constraint) { return () }
    at = InternIndex.after(&listed.lookup, at)
  }
  run List<Constraint>.append(&mut constraints.*, move constraint)
  return run recordPremise(&mut listed.*, List<Constraint>.asSlice(&constraints.*), List<Constraint>.length(&constraints.*) - usize.ONE)
}

// The Outlives and Contents premises a stored-data walk has listed, by hash, so skipping a listed
// premise is one probe rather than a scan of every premise, which grows with each nested borrow.
struct ListedPremises {
  lookup: InternIndex,
  positions: List<usize>,
}

effect fn recordPremise(listed: &mut ListedPremises, constraints: &[Constraint], at: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  match &constraints[at] {
    Constraint.Outlives {..} => {}
    Constraint.Contents {..} => {}
    _ => { return () }
  }
  run List<usize>.append(&mut listed.positions, at)
  return run InternIndex.record(&mut listed.lookup, premiseHash(&constraints[at]))
}

// Consistent with `sameConstraint` for Outlives and Contents; every other premise shares one hash.
fn premiseHash(constraint: &Constraint) -> u64 {
  return match &constraint.* {
    Constraint.Outlives {longer, shorter} => Hash.combine(Hash.combine(1, Lifetime.hash(&longer)), Lifetime.hash(&shorter))
    Constraint.Contents {subject, region} => Hash.combine(Hash.combine(2, Type.hash(&subject)), Lifetime.hash(&region))
    _ => 0
  }
}

// The fields of a struct, elements of a tuple or variants of a union, as `MemberShape` numbers them.
effect fn storedMemberCount(resolver: &mut Resolver, module: &ModuleId, declaration: usize) -> usize
! Cycle | OutOfMemoryError ? &mut Allocator {
  return match move run scopedHeader(&mut resolver.*, module, declaration) {
    Option<HeaderSyntax>.Some {value} => match value.header {
      Node.StructHeader {fields, ..} => fields.length
      Node.TupleHeader {elements, ..} => elements.length
      Node.UnionHeader {variants, ..} => variants.length
      _ => usize.ZERO
    }
    Option<HeaderSyntax>.None => usize.ZERO
  }
}

// What the stored-data premises of one nominal application depend on: its declaration and, per
// argument, a lifetime or row as given, or the distinct regions and type parameters a type argument
// retains. Atomic premises see a type argument only through those.
struct StoredShape {
  declaration: DeclarationId,
  arguments: List<StoredShapeArgument>,
  // Consistent with `sameStoredShape`, so a walk compares only shapes that share it.
  hash: u64,
}

union StoredShapeArgument {
  Lifetime {value: Shared<Lifetime>},
  Row {value: Shared<Row>},
  Retained {regions: List<Shared<Lifetime>>, regionLookup: InternIndex, parameters: List<Shared<Type>>},
}

effect fn storedShape(value: &Shared<Type>) -> Option<StoredShape> ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let copied = run Type.copy(value)
  if let Type.Nominal {declaration, arguments, ..} = move copied {
    let listed = List<Argument>.asSlice(&arguments)
    let mut shaped = List<StoredShapeArgument>.make()
    let mut hashed = DeclarationId.hash(&declaration)
    let mut at = usize.ZERO
    while at < listed.length {
      match &listed[at] {
        Argument.Lifetime {value: lifetime} => {
          hashed = Hash.combine(hashed, Lifetime.hash(&lifetime))
          run List<StoredShapeArgument>.append(&mut shaped, StoredShapeArgument.Lifetime {value: Shared<Lifetime>.clone(&lifetime)})
        }
        Argument.Row {value: row} => {
          hashed = Hash.combine(hashed, 1)
          run List<StoredShapeArgument>.append(&mut shaped, StoredShapeArgument.Row {value: Shared<Row>.clone(&row)})
        }
        Argument.Type {value: argument} => {
          let mut found = List<Shared<Lifetime>>.make()
          run Type.regionAtoms(&argument, &mut found)
          // The distinct regions, by hash; a set's hash ignores order as `sameLifetimeSet` does.
          let mut regions = List<Shared<Lifetime>>.make()
          let mut regionLookup = InternIndex.make()
          let mut regionSum: u64 = 0
          let atoms = List<Shared<Lifetime>>.asSlice(&found)
          let mut atom = usize.ZERO
          while atom < atoms.length {
            let regionHash = Lifetime.hash(&atoms[atom])
            let distinct = List<Shared<Lifetime>>.asSlice(&regions)
            let mut listedAt = InternIndex.first(&regionLookup, regionHash)
            while listedAt != usize.MAX && !Lifetime.equalsShared(&distinct[listedAt], &atoms[atom]) {
              listedAt = InternIndex.after(&regionLookup, listedAt)
            }
            if listedAt == usize.MAX {
              run List<Shared<Lifetime>>.append(&mut regions, Shared<Lifetime>.clone(&atoms[atom]))
              run InternIndex.record(&mut regionLookup, regionHash)
              regionSum = u64.wrappingAdd(regionSum, regionHash)
            }
            atom = atom + usize.ONE
          }
          hashed = Hash.combine(Hash.combine(hashed, usize.toU64(List<Shared<Lifetime>>.length(&regions))), regionSum)
          let mut stored = List<Shared<Type>>.make()
          if Shared<Type>.with<bool>(&argument, isTypeParameter) { run List<Shared<Type>>.append(&mut stored, Shared<Type>.clone(&argument)) }
          run Type.storedParameters(&argument, &mut stored)
          let mut parameters = List<Shared<Type>>.make()
          let candidates = List<Shared<Type>>.asSlice(&stored)
          let mut parameterSum: u64 = 0
          atom = usize.ZERO
          while atom < candidates.length {
            if !run typeListed(List<Shared<Type>>.asSlice(&parameters), &candidates[atom]) {
              run List<Shared<Type>>.append(&mut parameters, Shared<Type>.clone(&candidates[atom]))
              parameterSum = u64.wrappingAdd(parameterSum, Type.hash(&candidates[atom]))
            }
            atom = atom + usize.ONE
          }
          hashed = Hash.combine(Hash.combine(hashed, usize.toU64(List<Shared<Type>>.length(&parameters))), parameterSum)
          run List<StoredShapeArgument>.append(&mut shaped, StoredShapeArgument.Retained {regions: move regions, regionLookup: move regionLookup, parameters: move parameters})
        }
      }
      at = at + usize.ONE
    }
    return Option<StoredShape>.some(StoredShape {declaration: move declaration, arguments: move shaped, hash: hashed})
  }
  return Option<StoredShape>.none()
}

// Every argument is `'static` or a type that retains no region but `'static` and no type parameter.
fn closedStoredShape(shape: &StoredShape) -> bool {
  let listed = List<StoredShapeArgument>.asSlice(&shape.arguments)
  let mut at = usize.ZERO
  while at < listed.length {
    let closed = match &listed[at] {
      StoredShapeArgument.Lifetime {value} => Shared<Lifetime>.with<bool>(&value, staticLifetime)
      StoredShapeArgument.Row {..} => false
      StoredShapeArgument.Retained {regions, parameters, ..} => List<Shared<Type>>.length(&parameters) == usize.ZERO
        && staticRegions(List<Shared<Lifetime>>.asSlice(&regions))
    }
    if !closed { return false }
    at = at + usize.ONE
  }
  return true
}

fn staticRegions(regions: &[Shared<Lifetime>]) -> bool {
  let mut at = usize.ZERO
  while at < regions.length {
    if !Shared<Lifetime>.with<bool>(&regions[at], staticLifetime) { return false }
    at = at + usize.ONE
  }
  return true
}

effect fn sameStoredShape(left: &StoredShape, right: &StoredShape) -> bool ! OutOfMemoryError ? &mut Allocator | &mut Types {
  if !DeclarationId.equals(&left.declaration, &right.declaration) { return false }
  let first = List<StoredShapeArgument>.asSlice(&left.arguments)
  let second = List<StoredShapeArgument>.asSlice(&right.arguments)
  if first.length != second.length { return false }
  let mut at = usize.ZERO
  while at < first.length {
    let same = match &first[at] {
      StoredShapeArgument.Lifetime {value: one} => match &second[at] {
        StoredShapeArgument.Lifetime {value: other} => Lifetime.equalsShared(&one, &other)
        _ => false
      }
      StoredShapeArgument.Row {value: one} => match &second[at] {
        StoredShapeArgument.Row {value: other} => run Row.equalsShared(&one, &other)
        _ => false
      }
      StoredShapeArgument.Retained {regions, parameters, ..} => match &second[at] {
        StoredShapeArgument.Retained {regions: otherRegions, regionLookup: otherLookup, parameters: otherParameters} =>
          sameLifetimeSet(List<Shared<Lifetime>>.asSlice(&regions), List<Shared<Lifetime>>.asSlice(&otherRegions), &otherLookup)
            && run sameTypeSet(List<Shared<Type>>.asSlice(&parameters), List<Shared<Type>>.asSlice(&otherParameters))
        _ => false
      }
    }
    if !same { return false }
    at = at + usize.ONE
  }
  return true
}

effect fn typeListed(listed: &[Shared<Type>], value: &Shared<Type>) -> bool ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut at = usize.ZERO
  while at < listed.length {
    if run Type.equalsShared(&listed[at], value) { return true }
    at = at + usize.ONE
  }
  return false
}

// Equal sets of distinct regions, in any order.
// Equal sets of distinct regions, in any order; `lookup` indexes `right` by `Lifetime.hash`.
fn sameLifetimeSet(left: &[Shared<Lifetime>], right: &[Shared<Lifetime>], lookup: &InternIndex) -> bool {
  if left.length != right.length { return false }
  let mut at = usize.ZERO
  while at < left.length {
    let mut found = InternIndex.first(lookup, Lifetime.hash(&left[at]))
    while found != usize.MAX && !Lifetime.equalsShared(&right[found], &left[at]) { found = InternIndex.after(lookup, found) }
    if found == usize.MAX { return false }
    at = at + usize.ONE
  }
  return true
}

// Equal sets of distinct types, in any order.
effect fn sameTypeSet(left: &[Shared<Type>], right: &[Shared<Type>]) -> bool ! OutOfMemoryError ? &mut Allocator | &mut Types {
  if left.length != right.length { return false }
  let mut at = usize.ZERO
  while at < left.length {
    if !run typeListed(right, &left[at]) { return false }
    at = at + usize.ONE
  }
  return true
}

// A callable-representation parameter (`S: once fn<'env>(…)`, REP-001) is always instantiated by a
// callable, whose retained contents its environment bounds (LIFE-004), and a call proves that of
// the callable it supplies. So the body may assume the parameter outlives that environment.
effect fn appendRepresentationPremises(constraints: &mut List<Constraint>) -> () ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut implied = List<Constraint>.make()
  let listed = List<Constraint>.asSlice(&constraints.*)
  let mut at = usize.ZERO
  while at < listed.length {
    if let Constraint.Represents {parameter, contract} = &listed[at] {
      let mut regions = List<Shared<Lifetime>>.make()
      run Type.environmentRegions(&contract, &mut regions, true)
      if List<Shared<Lifetime>>.length(&regions) > usize.ZERO {
        run List<Constraint>.append(&mut implied, Constraint.Contents {subject: Shared<Type>.clone(&parameter),
          region: run Lifetime.meet(List<Shared<Lifetime>>.asSlice(&regions))})
      }
    }
    at = at + usize.ONE
  }
  let added = List<Constraint>.asSlice(&implied)
  at = usize.ZERO
  while at < added.length {
    run List<Constraint>.append(&mut constraints.*, copyConstraint(&added[at]))
    at = at + usize.ONE
  }
  return ()
}

// The input a written environment does not cover (LIFE-004), as a parameter position, or
// `usize.MAX`: a first input whose uninstantiated type, aliases resolved, is a borrow. As a service
// witness it is the provider the provision lends, and no call relates it to the operation's
// environment. A service operation's own first input is its
// witness's second, which the witness assumes, so an operation exempts none. The one rule for the
// body that assumes the environment and for every call, section and operation that owes it.
fn environmentExemptInput(parameters: &[Shared<Type>], serviceOperation: bool) -> usize {
  if serviceOperation || parameters.length == usize.ZERO { return usize.MAX }
  if Shared<Type>.with<bool>(&parameters[0], fn(node: &Type) -> bool { return match &node.* { Type.Reference {..} => true _ => false } }) {
    return usize.ZERO
  }
  return usize.MAX
}

// LIFE-002 input well-formedness and LIFE-004 written capture validity are local body
// antecedents. They are never added to the signature's universally required bounds. The input the
// written environment does not cover (`environmentExemptInput`) gets no LIFE-004 premise.
effect fn appendBodyPremises(
  resolver: &mut Resolver,
  module: &ModuleId,
  declaration: usize,
  signature: &Shared<Result<Answer, NoRejection>>,
  constraints: &mut List<Constraint>
) -> ()
  ! Cycle | OutOfMemoryError
  ? &mut Allocator | &mut Types {
  let written = run signatureSyntax(&mut resolver.*, module, declaration)
  let present = match &written {
    Option<WrittenSignature>.Some { value } => value.isEffect && value.environment.present
    Option<WrittenSignature>.None => false
  }
  let identity = run declarationAt(&mut resolver.*, module, declaration)
  let caller = match move identity {
    Option<DeclarationId>.Some { value } => move value
    Option<DeclarationId>.None => {
      return ()
    }
  }
  let facts = Shared<
    Result<Answer, NoRejection>,
  >.with<
    Option<SignatureFacts>,
  >(signature, signatureFacts)
  if let Option<SignatureFacts>.Some { value: shape } = move facts {
    let regions = run environmentRegions(signature, shape.environment)
    let environment = run Lifetime.meet(List<Shared<Lifetime>>.asSlice(&regions))
    let mut parameterAt = usize.ZERO
    while parameterAt < shape.parameters {
      let parameter = Shared<
        Result<Answer, NoRejection>,
      >.with<
        Option<Shared<Type>>,
      >(
        signature,
        fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> {
          return signatureParameterAt(answer, parameterAt)
        }
      )
      if let Option<Shared<Type>>.Some { value: ty } = move parameter {
        run appendInputPremises(&ty, &caller, &mut constraints.*)
        if present && parameterAt != shape.environmentExempt {
          run appendContentsPremises(&ty, &environment, &caller, &mut constraints.*)
        }
      }
      parameterAt = parameterAt + usize.ONE
    }
  }
  return ()
}

// A borrowed input implies its referent's contents cover the borrow. Traverse stored nested
// inputs, including the referent itself, but never the inputs/results of a callable contract.
effect fn appendInputPremises(
  value: &Shared<Type>,
  caller: &DeclarationId,
  constraints: &mut List<Constraint>
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator | &mut Types {
  // Inner premises come first, so a region an inner borrow already bounds is proved through it
  // rather than repeated at every enclosing level, which kept `&&...&T` quadratic in premises.
  let mut components = List<Shared<Type>>.make()
  let borrowed = Shared<Type>.with<Option<Constraint>>(value, inputLoanPremise)
  let mut loan = Option<Constraint>.none()
  match move borrowed {
    Option<Constraint>.Some { value: Constraint.Contents { subject, region } } => {
      run List<Shared<Type>>.append(&mut components, Shared<Type>.clone(&subject))
      loan = Option<Constraint>.some(Constraint.Contents {subject: move subject, region: move region})
    }
    _ => {
      run Type.storedComponents(value, &mut components)
    }
  }
  let listed = List<Shared<Type>>.asSlice(&components)
  let mut at = usize.ZERO
  while at < listed.length {
    run appendInputPremises(&listed[at], caller, &mut constraints.*)
    at = at + usize.ONE
  }
  if let Option<Constraint>.Some {value: Constraint.Contents {subject, region}} = move loan {
    run appendContentsPremises(&subject, &region, caller, &mut constraints.*)
  }
  return ()
}

fn inputLoanPremise(value: &Type) -> Option<Constraint> {
  return match &value.* {
    Type.Reference {
      referent,
      lifetime,
      ..
    } => Option<
      Constraint,
    >.some(
      Constraint.Contents {
        subject: Shared<Type>.clone(&referent),
        region: Shared<Lifetime>.clone(&lifetime)
      }
    )
    Type.Slice {
      element,
      lifetime,
      ..
    } => Option<
      Constraint,
    >.some(
      Constraint.Contents {
        subject: Shared<Type>.clone(&element),
        region: Shared<Lifetime>.clone(&lifetime)
      }
    )
    _ => Option<Constraint>.none()
  }
}

// Preserve both unknown stored type parameters and known retained regions. A bound on a
// compound referent also gives each stored parameter its own original-owner Contents premise.
effect fn appendContentsPremises(
  subject: &Shared<Type>,
  region: &Shared<Lifetime>,
  caller: &DeclarationId,
  constraints: &mut List<Constraint>
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator | &mut Types {
  let mut stored = List<Shared<Type>>.make()
  run List<Shared<Type>>.append(&mut stored, Shared<Type>.clone(subject))
  run Type.storedParameters(subject, &mut stored)
  let listed = List<Shared<Type>>.asSlice(&stored)
  let mut at = usize.ZERO
  while at < listed.length {
    if
      !run callerContentsCover(List<Constraint>.asSlice(&constraints.*), &listed[at], region) {
      run List<
        Constraint,
      >.append(
        &mut constraints.*,
        Constraint.Contents {
          subject: Shared<Type>.clone(&listed[at]),
          region: Shared<Lifetime>.clone(region)
        }
      )
    }
    at = at + usize.ONE
  }
  let mut retained = List<Shared<Lifetime>>.make()
  let representations = List<Option<Shared<Type>>>.make()
  let known = run Type.retainedRegions(
    subject,
    caller,
    List<Option<Shared<Type>>>.asSlice(&representations),
    &mut retained, false
  )
  // One proof answers every retained region; each premise this adds extends it in place.
  let lifetimes = List<Shared<Lifetime>>.asSlice(&retained)
  let mut proof = run outlivesProof(List<Constraint>.asSlice(&constraints.*), region, lifetimes)
  at = usize.ZERO
  while at < lifetimes.length {
    if !provenOutlives(&proof, &lifetimes[at], region) {
      run List<Constraint>.append(&mut constraints.*,
        Constraint.Outlives {longer: Shared<Lifetime>.clone(&lifetimes[at]), shorter: Shared<Lifetime>.clone(region)})
      run assumeOutlives(&mut proof, &lifetimes[at], region)
    }
    at = at + usize.ONE
  }
  return ()
}

// Prepare ordinary facts only for syntax reached by the enclosing body or selected static arm.
effect fn resolveBodyFacts(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  module: &ModuleId,
  moduleOrdinal: usize,
  declaration: usize,
  annotationIds: &List<HirId>,
  writtenCalls: &List<CallSyntax>,
) -> Result<BodyFacts, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let mut annotations = List<ResolvedAnnotation>.make()
  let scope = run bodyScope(&mut resolver.*, &mut owner.*, &mut dependencies.*, moduleOrdinal, module, declaration)
  let scoped = match move scope {
    Result<BodyScope, Shared<Rejection>>.Success {value} => move value
    Result<BodyScope, Shared<Rejection>>.Failure {error} => { return Result<BodyFacts, Shared<Rejection>>.failResult(move error) }
  }
  let BodyScope {binders, ..} = move scoped
  let constraints = match move run bodyPremises(&mut resolver.*, &mut owner.*, &mut dependencies.*, moduleOrdinal, declaration) {
    Result<List<Constraint>, Shared<Rejection>>.Success {value} => move value
    Result<List<Constraint>, Shared<Rejection>>.Failure {error} => { return Result<BodyFacts, Shared<Rejection>>.failResult(move error) }
  }
  // LIFE-003: an omitted lifetime in a body annotation is inferred from the value it describes.
  let declared = run declarationAt(&mut resolver.*, module, declaration)
  let mut elidedOwner = Option<DeclarationId>.none()
  if let Option<DeclarationId>.Some {value: caller} = &declared {
    elidedOwner = Option<DeclarationId>.some(run elidedLifetimeOwner(&caller))
  }
  let mut bodyElision = LifetimeElision {
    owner: move elidedOwner,
    nextOrdinal: usize.ZERO,
    output: false,
    resultDefault: Option<Shared<Lifetime>>.none(),
    generated: List<Shared<Lifetime>>.make(),
    invocation: false,
    nested: false,
    renumber: List<usize>.make(),
    staticEnvironment: false,
    supplied: Option<List<Argument>>.none(),
    assumptions: Option<List<Constraint>>.some(run copyConstraints(List<Constraint>.asSlice(&constraints))),
    deferred: Option<List<DeferredBounds>>.none(),
  }
  let writtenAnnotations = List<HirId>.asSlice(annotationIds)
  let mut annotationAt = usize.ZERO
  while annotationAt < writtenAnnotations.length {
    let id = writtenAnnotations[annotationAt]
    let result = run resolveType(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies.*,
      moduleOrdinal,
      id,
      List<Binder>.asSlice(&binders),
      &mut bodyElision,
    )
    run List<ResolvedAnnotation>.append(
      &mut annotations,
      ResolvedAnnotation {id: id, result: move result},
    )
    annotationAt = annotationAt + usize.ONE
  }
  let mut resolvedCalls = List<ResolvedCall>.make()
  let callSyntax = List<CallSyntax>.asSlice(writtenCalls)
  let mut callAt = usize.ZERO
  while callAt < callSyntax.length {
    let result = run callTarget(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies.*,
      module,
      moduleOrdinal,
      &callSyntax[callAt],
      List<Binder>.asSlice(&binders),
      List<Constraint>.asSlice(&constraints),
    )
    run List<ResolvedCall>.append(
      &mut resolvedCalls,
      ResolvedCall {id: callSyntax[callAt].id, result: move result},
    )
    callAt = callAt + usize.ONE
  }
  return Result<BodyFacts, Shared<Rejection>>.succeed(
    BodyFacts {annotations: move annotations, calls: move resolvedCalls},
  )
}

// The selected arm's freshly resolved facts keep the enclosing selection's static facts.
effect fn carrySelectionFacts(calls: &[ResolvedCall], output: &mut List<ResolvedCall>) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < calls.length {
    let fact = selectedFact(calls, calls[at].id)
    if let Option<SelectionFact>.Some {value} = move fact {
      if let Result<ResolvedTarget, Shared<Rejection>>.Success {value: ResolvedTarget.Selected {..}} = &calls[at].result {
        run List<ResolvedCall>.append(&mut output.*, ResolvedCall {
          id: calls[at].id,
          result: Result<ResolvedTarget, Shared<Rejection>>.succeed(ResolvedTarget.Selected {fact: move value}),
        })
      }
    }
    at = at + usize.ONE
  }
  return ()
}

struct StaticConditionalInput {
  condition: HirId,
  thenBranch: HirId,
  elseBranch: HirRef,
}

fn staticConditionalInput(node: Node) -> Option<StaticConditionalInput> {
  return match node {
    Node.StaticConditionalStatement {condition, thenBranch, elseBranch} => Option<StaticConditionalInput>.some(
      StaticConditionalInput {condition: condition, thenBranch: thenBranch, elseBranch: elseBranch})
    _ => Option<StaticConditionalInput>.none()
  }
}

enum StaticConditionalArm {
  Block,
  Conditional,
  Unavailable,
}

fn staticConditionalArm(node: Node) -> StaticConditionalArm {
  return match node {
    Node.Block {..} => StaticConditionalArm.Block
    Node.StaticConditionalStatement {..} => StaticConditionalArm.Conditional
    _ => StaticConditionalArm.Unavailable
  }
}

effect fn checkStaticConditional(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut List<Dependency>,
  module: &ModuleId,
  cursor: &AuthoredCursor,
  caller: &DeclarationId,
  locals: &mut List<BodyLocal>,
  annotations: &[ResolvedAnnotation],
  calls: &[ResolvedCall],
  nodes: &mut List<BodyNode>,
  signatures: &mut List<SignatureDependency>,
  requiredBodies: &mut List<DeclarationId>,
  statement: HirId,
  resultType: &Shared<Type>,
  constraints: &[Constraint],
  contractBody: bool,
  staticBody: bool,
  loopDepth: usize,
  unsafeAllowed: bool,
) -> Result<CheckedControl, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  if let Option<StaticConditionalInput>.Some {value: StaticConditionalInput {condition, thenBranch, elseBranch}} = move staticConditionalInput(run bodyNode(
    &resolver.source, cursor, statement,
  )) {
    // A runtime body reads the decision its selection pass evaluated; an unselected runtime body
    // has no decision and cannot check static control. A static function's body is wholly
    // compile-time, so its condition is evaluated here. Either way the inactive arm contributes
    // no body facts or diagnostics.
    let mut chooseThen = false
    if staticBody {
      // The enclosing body deliberately skips static conditions. Resolve only this reached
      // condition's calls before typing it in the current argument and local-value context.
      let resolvedCondition = run staticReachedFacts(&mut resolver.*, &mut owner.*, &mut dependencies.*,
        module, cursor, caller, condition)
      let conditionFacts = match move resolvedCondition {
        Result<BodyFacts, Shared<Rejection>>.Success {value} => move value
        Result<BodyFacts, Shared<Rejection>>.Failure {error} => {return Result<CheckedControl, Shared<Rejection>>.failResult(move error)}
      }
      let BodyFacts {annotations: conditionAnnotations, calls: conditionTargets} = move conditionFacts
      let mut conditionCalls = move conditionTargets
      run carrySelectionFacts(calls, &mut conditionCalls)
      let checked = run checkStatementExpression(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
        module, cursor, caller, &mut locals.*, List<ResolvedAnnotation>.asSlice(&conditionAnnotations), resultType, loopDepth,
        List<ResolvedCall>.asSlice(&conditionCalls), &mut nodes.*,
        &mut signatures.*, &mut requiredBodies.*, condition, &Option<Shared<Type>>.some(run primitiveType(b"bool")), RejectionCode.ConditionNotBool,
        constraints, contractBody, true, unsafeAllowed, false)
      let conditionNode = match move checked {
        Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
        Result<BodyNodeId, Shared<Rejection>>.Failure {error} => { return Result<CheckedControl, Shared<Rejection>>.failResult(move error) }
      }
      let evaluated = run staticPrefixExpression(&mut resolver.*, &mut owner.*, &mut dependencies.*, module,
        cursor, caller, List<BodyLocal>.asSlice(&locals.*), List<BodyNode>.asSlice(&nodes.*), conditionNode, condition)
      let value = match move evaluated {
        Result<Shared<StaticData>, Shared<Rejection>>.Success {value} => move value
        Result<Shared<StaticData>, Shared<Rejection>>.Failure {error} => {
          return Result<CheckedControl, Shared<Rejection>>.failResult(move error)
        }
      }
      let flag = Shared<StaticData>.with<Option<bool>>(&value, fn(fact: &StaticData) -> Option<bool> {
        return match &fact.* {
          StaticData.Boolean {value: answer} => Option<bool>.some(answer)
          _ => Option<bool>.none()
        }
      })
      chooseThen = match move flag {
        Option<bool>.Some {value: answer} => answer
        Option<bool>.None => {
          return Result<CheckedControl, Shared<Rejection>>.failResult(
            run reject(&resolver.*, module, RejectionCode.ConditionNotBool, run bodySpan(&resolver.source, cursor, condition)),
          )
        }
      }
    } else {
      let decision = selectedFact(calls, condition)
      match move decision {
        Option<SelectionFact>.Some { value: SelectionFact.Condition { selected: chosen } } => {
          chooseThen = chosen
        }
        _ => {
          // An abstract runtime body can still select a closed condition, such as `true`,
          // without inventing its generic arguments. Dependent expansions are kept outside
          // this declaration sweep; any actual static failure remains its own rejection.
          let identity = run Shared<DeclarationId>.make(DeclarationId.copy(caller))
          let ordinal = run ordinalOfIdentity(&mut resolver.*, module, &identity)
          let evaluated = run staticExpression(
            &mut resolver.*,
            &mut owner.*,
            &mut dependencies.*,
            module,
            move ordinal,
            condition,
            StaticRootExpectation.Boolean, &[], &[],
          )
          let value = match move evaluated {
            Result<Shared<StaticData>, Shared<Rejection>>.Success { value } => move value
            Result<Shared<StaticData>, Shared<Rejection>>.Failure { error } => {
              return Result<CheckedControl, Shared<Rejection>>.failResult(move error)
            }
          }
          chooseThen = Shared<StaticData>.with<bool>(
            &value,
            fn(fact: &StaticData) -> bool {
              return match &fact.* {
                StaticData.Boolean { value: flag } => flag
                _ => false
              }
            }
          )
        }
      }
    }
    let mut selectedArm = HirRef.absent()
    if chooseThen { selectedArm = HirRef.of(thenBranch) } else { selectedArm = elseBranch }
    let mut annotationIds = List<HirId>.make()
    let mut writtenCalls = List<CallSyntax>.make()
    let mut declaration = usize.MAX
    if let Option<&IndexedSource>.Some {value: indexed} = move SourceIndex.sourceAtCursor(&resolver.source, cursor) {
      let hir = IndexedSource.authored(indexed)
      let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(indexed))
      let mut at = usize.ZERO
      while at < declarations.length {
        if DeclarationId.equals(&declarations[at].identity, caller) { declaration = at }
        at = at + usize.ONE
      }
      if selectedArm.present {
        if let Node.Block {statements} = Module.node(hir, selectedArm.id) {
          run collectBodySyntax(hir, statements, &mut annotationIds, &mut writtenCalls)
        }
      }
    }
    if declaration == usize.MAX { fail InvalidModulePath {} }
    let moduleOrdinal = knownModuleOrdinal(&resolver.*, module)
    let resolved = run resolveBodyFacts(
      &mut resolver.*, &mut owner.*, &mut dependencies.*, module,
      moduleOrdinal, declaration, &annotationIds, &writtenCalls,
    )
    let selectedFacts = match move resolved {
      Result<BodyFacts, Shared<Rejection>>.Success {value: preparedFacts} => move preparedFacts
      Result<BodyFacts, Shared<Rejection>>.Failure {error} => {
        return Result<CheckedControl, Shared<Rejection>>.failResult(move error)
      }
    }
    let BodyFacts {annotations: selectedAnnotations, calls: armFacts} = move selectedFacts
    let mut selectedCalls = move armFacts
    run carrySelectionFacts(calls, &mut selectedCalls)
    let mut retained = List<BodyNodeId>.make()
    let mut canComplete = true
    if selectedArm.present {
      let checked = match staticConditionalArm(run bodyNode(&resolver.source, cursor, selectedArm.id)) {
        StaticConditionalArm.Block => run checkBlock(
          &mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
          module, cursor, caller, &mut locals.*, List<ResolvedAnnotation>.asSlice(&selectedAnnotations),
          List<ResolvedCall>.asSlice(&selectedCalls), &mut nodes.*,
          &mut signatures.*, &mut requiredBodies.*, selectedArm.id, resultType,
          constraints, contractBody, staticBody, loopDepth, unsafeAllowed,
        )
        StaticConditionalArm.Conditional => run checkStaticConditional(
          &mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
          module, cursor, caller, &mut locals.*, annotations, calls, &mut nodes.*,
          &mut signatures.*, &mut requiredBodies.*, selectedArm.id, resultType,
          constraints, contractBody, staticBody, loopDepth, unsafeAllowed,
        )
        StaticConditionalArm.Unavailable => Result<CheckedControl, Shared<Rejection>>.failResult(
          run reject(
            &resolver.*, module, RejectionCode.Unsupported,
            run bodySpan(&resolver.source, cursor, selectedArm.id),
          ),
        )
      }
      match move checked {
        Result<CheckedControl, Shared<Rejection>>.Success {value: control} => {
          run List<BodyNodeId>.append(&mut retained, control.node)
          canComplete = control.canComplete
        }
        Result<CheckedControl, Shared<Rejection>>.Failure {error} => {
          return Result<CheckedControl, Shared<Rejection>>.failResult(move error)
        }
      }
    }
    let node = BodyNodeId {index: List<BodyNode>.length(&nodes.*)}
    run List<BodyNode>.append(
      &mut nodes.*,
      BodyNode {
        origin: run bodyOrigin(&resolver.source, cursor, statement),
        kind: BodyNodeKind.Block {statements: move retained, value: Option<BodyNodeId>.none(), canComplete: canComplete},
      },
    )
    return Result<CheckedControl, Shared<Rejection>>.succeed(
      CheckedControl {node: node, canComplete: canComplete},
    )
  }
  return Result<CheckedControl, Shared<Rejection>>.failResult(
    run reject(
      &resolver.*, module, RejectionCode.Unsupported,
      run bodySpan(&resolver.source, cursor, statement),
    ),
  )
}

/// Whether an earlier binding in the block already uses this interned name.
fn bindingNameCollides(known: &[Symbol], name: usize) -> bool {
  let mut prior = usize.ZERO
  while prior < known.length {
    if name == known[prior].index {
      return true
    }
    prior = prior + usize.ONE
  }
  return false
}

fn indexOfAnnotation(annotations: &[ResolvedAnnotation], id: HirId) -> Option<usize> {
  let mut selected = usize.ZERO
  while selected < annotations.length {
    if annotations[selected].id.index == id.index {
      return Option<usize>.some(selected)
    }
    selected = selected + usize.ONE
  }
  return Option<usize>.none()
}

/// The type written on a binding, rejected when a runtime binding names a non-runtime type.
effect fn bindingAnnotationType(
  resolver: &Resolver,
  module: &ModuleId,
  cursor: &AuthoredCursor,
  annotations: &[ResolvedAnnotation],
  annotation: HirId,
  contractBody: bool,
  staticBody: bool,
) -> Result<Shared<Type>, Shared<Rejection>> ! RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let selected = match move indexOfAnnotation(annotations, annotation) {
    Option<usize>.Some {value} => value
    Option<usize>.None => {
      return Result<Shared<Type>, Shared<Rejection>>.failResult(
        run reject(
          resolver,
          module,
          RejectionCode.Unsupported,
          run bodySpan(&resolver.source, cursor, annotation),
        ),
      )
    }
  }
  match & annotations[selected].result {
    Result<Shared<Type>, Shared<Rejection>>.Success {value} => {
      // A declared Effect contract stores the exact Effect its initializer admits (EFF-013).
      if !contractBody && !staticBody && !Shared<Type>.with<bool>(&value, runtimeType) && !Shared<Type>.with<bool>(&value, bareEffect) {
        return Result<Shared<Type>, Shared<Rejection>>.failResult(
          run reject(
            resolver,
            module,
            RejectionCode.Unsupported,
            run bodySpan(&resolver.source, cursor, annotation),
          ),
        )
      }
      return Result<Shared<Type>, Shared<Rejection>>.succeed(Shared<Type>.clone(&value))
    }
    Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
      return Result<Shared<Type>, Shared<Rejection>>.failResult(Shared<Rejection>.clone(&error))
    }
  }
}

/// The mutable local an identifier assignment target is bound to, if any.
fn mutableLocalOf(resolver: &Resolver, locals: &[BodyLocal], binding: HirRef, anchor: &Anchor) -> Option<BodyLocalId> {
  if !binding.present {
    return Option<BodyLocalId>.none()
  }
  let mut localAt = usize.ZERO
  while localAt < locals.length {
    if BodyOrigin.syntax(locals[localAt].origin, anchor).index == binding.id.index && locals[localAt].mutable && !completedOccurrenceContains(resolver, localAt, true) {
      return Option<BodyLocalId>.some(BodyLocalId {index: localAt})
    }
    localAt = localAt + usize.ONE
  }
  return Option<BodyLocalId>.none()
}

// The local a whole-local assignment target names; none for a field, element or other place.
fn assignedLocal(nodes: &[BodyNode], destination: BodyNodeId) -> Option<BodyLocalId> {
  if let BodyNodeKind.Expression {form: BodyExpression.Local {local}, ..} = &nodes[destination.index].kind {
    return Option<BodyLocalId>.some(local)
  }
  return Option<BodyLocalId>.none()
}

// Admits a value assigned to a local whose type retains a region (LIFE-003). An unannotated
// reassignable binding assigned at its own loop depth meets its regions with the value's: the
// local, its assignment target and every later use take the meet, which both the earlier value
// and the new one outlive. An assignment inside a deeper loop cannot widen the binding, because
// uses earlier in that loop were checked at its previous type, so the value meets the binding's
// type as it stands. Either way a caller-local region that would have to outlive a region the
// body does not own is a mismatch rather than a relation left to the region check.
effect fn assignLocalValue(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, dependencies: &mut List<Dependency>,
  module: &ModuleId, caller: &DeclarationId, constraints: &[Constraint], locals: &mut List<BodyLocal>,
  nodes: &mut List<BodyNode>, destination: BodyNodeId, node: BodyNodeId, loopDepth: usize, span: Span,
) -> Result<BodyNodeId, Shared<Rejection>> ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let local = match move assignedLocal(List<BodyNode>.asSlice(&nodes.*), destination) {
    Option<BodyLocalId>.Some {value} => value
    Option<BodyLocalId>.None => { return run bodyRejection(&resolver.*, module, RejectionCode.InvalidAssignmentPlace, span) }
  }
  let listed = List<BodyLocal>.asSlice(&locals.*)
  let declared = Shared<Type>.clone(&listed[local.index].ty)
  let origin = listed[local.index].origin
  let mutable = listed[local.index].mutable
  let written = listed[local.index].written
  let mut meets = false
  if let Option<usize>.Some {value: depth} = &listed[local.index].meetDepth { meets = depth == loopDepth }
  if meets {
    let offeredType = bodyExpressionType(List<BodyNode>.asSlice(&nodes.*), &node)
    if let Option<Shared<Type>>.Some {value: offered} = move offeredType {
      let meetType = run meetRegions(&declared, &offered)
      if let Option<Shared<Type>>.Some {value: met} = move meetType {
        let mut deferred = List<RegionPair>.make()
        let admitted = run admitsRegions(&mut resolver.*, &mut owner.*, &mut dependencies.*, &declared, &met, caller,
          constraints, true, &mut deferred, span)
        if admitted && List<RegionPair>.length(&deferred) == usize.ZERO {
          let wanted = Option<Shared<Type>>.some(Shared<Type>.clone(&met))
          let value = run admitExpectedValue(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, caller,
            constraints, &mut nodes.*, node, &wanted, RejectionCode.AssignmentTypeMismatch, span, false, true)
          if let Result<BodyNodeId, Shared<Rejection>>.Success {value: accepted} = move value {
            List<BodyLocal>.set(&mut locals.*, local.index, BodyLocal {origin: origin, ty: Shared<Type>.clone(&met),
              mutable: mutable, meetDepth: Option<usize>.some(loopDepth), written: written})
            run retypeNode(&mut nodes.*, destination, move met)
            return Result<BodyNodeId, Shared<Rejection>>.succeed(accepted)
          }
        }
      }
    }
  }
  let wanted = Option<Shared<Type>>.some(move declared)
  return run admitExpectedValue(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, caller, constraints,
    &mut nodes.*, node, &wanted, RejectionCode.AssignmentTypeMismatch, span, false, false)
}

/// Checks `target = value` in a runtime body, returning the new place-assignment node.
effect fn checkPlaceAssignment(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut List<Dependency>,
  module: &ModuleId,
  cursor: &AuthoredCursor,
  caller: &DeclarationId,
  locals: &mut List<BodyLocal>,
  annotations: &[ResolvedAnnotation],
  resultType: &Shared<Type>,
  loopDepth: usize,
  calls: &[ResolvedCall],
  nodes: &mut List<BodyNode>,
  signatures: &mut List<SignatureDependency>,
  requiredBodies: &mut List<DeclarationId>,
  statement: HirId,
  span: Span,
  target: HirId,
  value: HirId,
  constraints: &[Constraint],
  contractBody: bool,
  unsafeAllowed: bool,
) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let checked = run checkStatementExpression(
    &mut resolver.*,
    &mut owner.*,
    &mut request.*,
    &mut dependencies.*,
    module,
    cursor,
    caller,
    &mut locals.*,
    annotations,
    resultType,
    loopDepth,
    calls,
    &mut nodes.*,
    &mut signatures.*,
    &mut requiredBodies.*,
    target,
    &Option<Shared<Type>>.none(), RejectionCode.AssignmentTypeMismatch,
    constraints,
    contractBody,
    false,
    unsafeAllowed, false,
  )
  let destination = match move checked {
    Result<BodyNodeId, Shared<Rejection>>.Success {value: acceptedNode} => acceptedNode
    Result<BodyNodeId, Shared<Rejection>>.Failure {error} => {
      return Result<BodyNodeId, Shared<Rejection>>.failResult(move error)
    }
  }
  // ASSIGN-001: the target names one writable place rooted in a binding; a temporary result,
  // and any field, element or referent reached through one, is not a destination.
  let targetSpan = run bodySpan(&resolver.source, cursor, target)
  if !bindingRootedPlace(List<BodyNode>.asSlice(&nodes.*), destination) {
    let mut refused = run makeRejection(RejectionCode.InvalidAssignmentPlace, module, targetSpan)
    // A C static is read-only from Silk; the message says so.
    if let BodyNodeKind.Expression {form: BodyExpression.ForeignStatic {..}, ..} = &List<BodyNode>.asSlice(&nodes.*)[destination.index].kind {
      run List<MessageArgument>.append(&mut refused.arguments, MessageArgument {name: run Bytes.copy(b"template"), value: run Bytes.copy(b"1")})
    }
    return Result<BodyNodeId, Shared<Rejection>>.failResult(run Shared<Rejection>.make(move refused))
  }
  if !assignablePlace(
    List<BodyNode>.asSlice(&nodes.*),
    List<BodyLocal>.asSlice(&locals.*),
    destination,
  ) {
    let code = assignmentPlaceCode(List<BodyNode>.asSlice(&nodes.*), destination)
    return Result<BodyNodeId, Shared<Rejection>>.failResult(run reject(&resolver.*, module, code, targetSpan))
  }
  let expected = bodyExpressionType(List<BodyNode>.asSlice(&nodes.*), &destination)
  // A local whose type retains a region takes the value's own type first, so the assignment can
  // meet the two regions or refuse a relation it cannot prove.
  // An unannotated binding at its own loop depth also meets a `'static` region: an initializer such
  // as `C.defaults()` fixes a lifetime only its result names to `'static`, and a later value with a
  // shorter region narrows the binding rather than being refused (LIFE-003).
  let assigned = assignedLocal(List<BodyNode>.asSlice(&nodes.*), destination)
  let mut regioned = false
  if let Option<BodyLocalId>.Some {value: local} = &assigned {
    let mut meets = false
    if let Option<usize>.Some {value: depth} = &List<BodyLocal>.asSlice(&locals.*)[local.index].meetDepth { meets = depth == loopDepth }
    if let Option<Shared<Type>>.Some {value: declared} = &expected { regioned = run carriesRegion(&declared, meets) }
  }
  let mut valueExpected = Option<Shared<Type>>.none()
  if !regioned {
    valueExpected = match &expected {
      Option<Shared<Type>>.Some {value: declared} => Option<Shared<Type>>.some(Shared<Type>.clone(&declared))
      Option<Shared<Type>>.None => Option<Shared<Type>>.none()
    }
  }
  let replacement = run checkStatementExpression(
    &mut resolver.*,
    &mut owner.*,
    &mut request.*,
    &mut dependencies.*,
    module,
    cursor,
    caller,
    &mut locals.*,
    annotations,
    resultType,
    loopDepth,
    calls,
    &mut nodes.*,
    &mut signatures.*,
    &mut requiredBodies.*,
    value,
    &valueExpected, RejectionCode.AssignmentTypeMismatch,
    constraints,
    contractBody,
    false,
    unsafeAllowed, false,
  )
  let mut replacementNode = match move replacement {
    Result<BodyNodeId, Shared<Rejection>>.Success {value: acceptedNode} => acceptedNode
    Result<BodyNodeId, Shared<Rejection>>.Failure {error} => {
      return Result<BodyNodeId, Shared<Rejection>>.failResult(move error)
    }
  }
  if regioned {
    let valueSpan = run bodySpan(&resolver.source, cursor, value)
    let admitted = run assignLocalValue(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, caller, constraints,
      &mut locals.*, &mut nodes.*, destination, replacementNode, loopDepth, valueSpan)
    replacementNode = match move admitted {
      Result<BodyNodeId, Shared<Rejection>>.Success {value: acceptedNode} => acceptedNode
      Result<BodyNodeId, Shared<Rejection>>.Failure {error} => {
        return Result<BodyNodeId, Shared<Rejection>>.failResult(move error)
      }
    }
  }
  let node = BodyNodeId {index: List<BodyNode>.length(&nodes.*)}
  run List<BodyNode>.append(
    &mut nodes.*,
    BodyNode {
      origin: run originAt(cursor, statement, span),
      kind: BodyNodeKind.PlaceAssignment {target: destination, value: replacementNode},
    },
  )
  return Result<BodyNodeId, Shared<Rejection>>.succeed(node)
}

// How a statement list checked. A recovered list checked every statement but some that bound
// nothing and failed; each left a `Recovered` node, its last failure is the list's own, and the
// earlier ones are in the body frame's recovered sink. Only a runtime body's root list is
// rejected as recovered (`checkPreparedBody`); every other list fails with that failure.
union StatementList {
  Checked {reachable: bool},
  Recovered {reachable: bool, failure: Shared<Rejection>},
  Failed {error: Shared<Rejection>},
}

// A typed `let` whose initializer alone failed, which still declares its binding.
struct RecoveredBinding {
  name: HirId,
  symbol: Symbol,
  mutable: bool,
  ty: Shared<Type>,
}

// The binding a failed `let x: T = ...` still declares when only its initializer failed: `x` has its
// written type, so the statements after it read a `T` and report their own errors instead of
// failing silently. Only a type that holds no view qualifies, as its local needs nothing of the
// initializer's regions; none for any other statement or failure.
effect fn recoveredTypedBinding(resolver: &Resolver, module: &ModuleId, cursor: &AuthoredCursor, caller: &DeclarationId,
  annotations: &[ResolvedAnnotation], statement: HirId, failure: &Shared<Rejection>, contractBody: bool, staticBody: bool)
-> Option<RecoveredBinding> ! RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  if let Node.BindingStatement {name, mutable, isStatic, annotation, initializer} = run bodyNode(&resolver.source, cursor, statement) {
    if isStatic || !annotation.present { return Option<RecoveredBinding>.none() }
    let symbol = match run bodyNode(&resolver.source, cursor, name) {
      Node.Name {text} => text
      _ => { return Option<RecoveredBinding>.none() }
    }
    let written = run bodySpan(&resolver.source, cursor, initializer)
    let failed = Shared<Rejection>.with<Span>(failure, fn(value: &Rejection) -> Span { return value.span })
    if failed.start < written.start || failed.end > written.end { return Option<RecoveredBinding>.none() }
    let declared = match move run bindingAnnotationType(resolver, module, cursor, annotations, annotation.id, contractBody, staticBody) {
      Result<Shared<Type>, Shared<Rejection>>.Success {value} => move value
      Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
        drop error
        return Option<RecoveredBinding>.none()
      }
    }
    let elided = run elidedLifetimeOwner(caller)
    let mentions = run typeMentionsOwner(&declared, &elided)
    if mentions || Shared<Type>.with<bool>(&declared, Type.holdsView) {
      return Option<RecoveredBinding>.none()
    }
    return Option<RecoveredBinding>.some(RecoveredBinding {name: name, symbol: symbol, mutable: mutable, ty: move declared})
  }
  return Option<RecoveredBinding>.none()
}

effect fn checkStatements(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut List<Dependency>,
  module: &ModuleId,
  cursor: &AuthoredCursor,
  caller: &DeclarationId,
  locals: &mut List<BodyLocal>,
  bindings: &mut List<Symbol>,
  annotations: &[ResolvedAnnotation],
  calls: &[ResolvedCall],
  nodes: &mut List<BodyNode>,
  signatures: &mut List<SignatureDependency>,
  requiredBodies: &mut List<DeclarationId>,
  statements: &mut List<BodyNodeId>,
  written: Range,
  resultType: &Shared<Type>,
  constraints: &[Constraint],
  contractBody: bool,
  staticBody: bool,
  loopDepth: usize,
  unsafeAllowed: bool,
  tail: &BlockTail,
  yielded: &mut Option<BodyNodeId>,
) -> StatementList
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let mut reachable = true
  // In a runtime body, a failed statement does not stop the list: the statements after it are
  // still checked, and the list is recovered once they are, with its last failure. Each earlier
  // failure is recorded before the next statement records its own, so the body keeps source order.
  // A failed `let` binds nothing, unless only the initializer of a typed `let` failed, and a
  // statement that fails only by reading what it would have bound fails silently
  // (`UnavailableBinding`).
  let mut pending = Option<Shared<Rejection>>.none()
  let mut last = Option<Shared<Rejection>>.none()
  let mut silent = Option<Shared<Rejection>>.none()
  let mut at = usize.ZERO
  while at < written.length {
    if let Option<Shared<Rejection>>.Some {value} = move pending { run recordRecovered(&mut resolver.*, move value) }
    pending = Option<Shared<Rejection>>.none()
    let statement = run bodyChild(&resolver.source, cursor, written, at)
    let span = run bodySpan(&resolver.source, cursor, statement)
    if staticBody { run rememberStaticPrefix(&mut resolver.*, List<BodyNodeId>.asSlice(&statements.*), List<BodyNode>.asSlice(&nodes.*), &run cursorAnchor(cursor)) }
    let writtenNode = run bodyNode(&resolver.source, cursor, statement)
    // Keep the selected-conditional recursion outside the other statement variants' temporaries.
    if writtenStaticConditional(&writtenNode) {
        let checked = run checkStaticConditional(
          &mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
          module, cursor, caller, &mut locals.*, annotations, calls, &mut nodes.*,
          &mut signatures.*, &mut requiredBodies.*, statement, resultType,
          constraints, contractBody, staticBody, loopDepth, unsafeAllowed,
        )
        match move checked {
          Result<CheckedControl, Shared<Rejection>>.Success {value} => {
            run List<BodyNodeId>.append(&mut statements.*, value.node)
            reachable = reachable && value.canComplete
          }
          Result<CheckedControl, Shared<Rejection>>.Failure {error} => {
            return StatementList.Failed {error: move error}
          }
        }
    } else {
      // A static body stops at any failure: its later statements evaluate the checked prefix at
      // compile time, and a prefix missing a statement would run a different program.
      let nodeMark = List<BodyNode>.length(&nodes.*)
      let localMark = List<BodyLocal>.length(&locals.*)
      let bindingMark = List<Symbol>.length(&bindings.*)
      let occurrenceMark = frameOccurrenceCount(&resolver.*)
      // The last statement of a block in value position may be its value.
      let mut tailValue = Option<HirId>.none()
      if at + usize.ONE == written.length {
        if let BlockTail.Yielded {..} = &tail.* { tailValue = run yieldedStatement(&resolver.source, cursor, statement) }
      }
      let checked = match move tailValue {
        Option<HirId>.Some {value: expression} => run checkYieldedStatement(
          &mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module, cursor, caller, &mut locals.*,
          annotations, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*, &mut statements.*, &mut yielded.*,
          expression, reachable, resultType, tail, constraints, contractBody, staticBody, loopDepth, unsafeAllowed)
        Option<HirId>.None => run checkWrittenStatement(
          &mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
          module, cursor, caller, &mut locals.*, &mut bindings.*, annotations, calls,
          &mut nodes.*, &mut signatures.*, &mut requiredBodies.*, &mut statements.*,
          statement, span, move writtenNode, reachable, resultType, constraints,
          contractBody, staticBody, loopDepth, unsafeAllowed,
        )
      }
      match move checked {
        Result<bool, Shared<Rejection>>.Success {value} => { reachable = value }
        Result<bool, Shared<Rejection>>.Failure {error} => {
          if staticBody { return StatementList.Failed {error: move error} }
          // The failed statement leaves only a recovered node: none of its partial nodes, locals,
          // names or static iteration facts reach the statements after it or
          // the ownership check.
          List<BodyNode>.truncate(&mut nodes.*, nodeMark)
          List<BodyLocal>.truncate(&mut locals.*, localMark)
          List<Symbol>.truncate(&mut bindings.*, bindingMark)
          truncateFrameOccurrences(&mut resolver.*, occurrenceMark)
          run List<BodyNodeId>.append(&mut statements.*, BodyNodeId {index: List<BodyNode>.length(&nodes.*)})
          let typed = run recoveredTypedBinding(&resolver.*, module, cursor, caller, annotations, statement, &error,
            contractBody, staticBody)
          let mut resumes = writtenResumes(&resolver.source, cursor, span)
          // A path past a recovered binding would read a local that holds nothing.
          if let Option<RecoveredBinding>.Some {..} = &typed { resumes = false }
          run List<BodyNode>.append(&mut nodes.*, BodyNode {origin: run originAt(cursor, statement, span), kind: BodyNodeKind.Recovered {resumes: resumes}})
          match move typed {
            Option<RecoveredBinding>.Some {value: binding} => {
              run List<BodyLocal>.append(&mut locals.*, BodyLocal {
                origin: run originAt(cursor, statement, run bodySpan(&resolver.source, cursor, binding.name)),
                ty: move binding.ty, mutable: binding.mutable, meetDepth: Option<usize>.none(), written: true,
              })
              run List<Symbol>.append(&mut bindings.*, binding.symbol)
            }
            Option<RecoveredBinding>.None => { run recordFailedStatement(&mut resolver.*, module, span) }
          }
          if dependentFailure(&error) {
            silent = Option<Shared<Rejection>>.some(move error)
          } else {
            last = Option<Shared<Rejection>>.some(Shared<Rejection>.clone(&error))
            pending = Option<Shared<Rejection>>.some(move error)
          }
        }
      }
    }
    at = at + usize.ONE
  }
  // The last failure is the list's own; statements after it succeeded and recorded nothing.
  if let Option<Shared<Rejection>>.Some {value} = move last {
    if let Option<Shared<Rejection>>.None = &pending { run takeRecovered(&mut resolver.*, &value) }
    return StatementList.Recovered {reachable: reachable, failure: move value}
  }
  // Only reads of unavailable bindings failed here; the failure that made them unavailable is
  // reported where it happened, and this list still fails silently.
  if let Option<Shared<Rejection>>.Some {value} = move silent {
    return StatementList.Recovered {reachable: reachable, failure: move value}
  }
  return StatementList.Checked {reachable: reachable}
}

// The expression a block's last statement would yield: an expression statement's expression, or
// an `if` or `if let` whose `else` chain ends in a block, which is then an `if` expression.
effect fn yieldedStatement(source: &SourceIndex, cursor: &AuthoredCursor, statement: HirId) -> Option<HirId>
! RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  return match run bodyNode(source, cursor, statement) {
    Node.ExpressionStatement {expression} => Option<HirId>.some(expression)
    Node.ConditionalStatement {..} => {
      if run selectsValue(source, cursor, statement) { return Option<HirId>.some(statement) }
      return Option<HirId>.none()
    }
    Node.PatternConditionalStatement {..} => {
      if run selectsValue(source, cursor, statement) { return Option<HirId>.some(statement) }
      return Option<HirId>.none()
    }
    _ => Option<HirId>.none()
  }
}

// Whether every `else if` link of conditional `id` ends in an `else` block.
effect fn selectsValue(source: &SourceIndex, cursor: &AuthoredCursor, id: HirId) -> bool
! RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let mut current = id
  while true {
    let otherwise = match run bodyNode(source, cursor, current) {
      Node.ConditionalStatement {elseBranch, ..} => elseBranch
      Node.PatternConditionalStatement {elseBranch, ..} => elseBranch
      Node.Block {..} => { return true }
      _ => { return false }
    }
    if !otherwise.present { return false }
    current = otherwise.id
  }
  return false
}

// A value block's last statement: a `()` or `never` value stays a statement, as in a statement
// block, and any other value is the block's value.
effect fn checkYieldedStatement(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, request: &mut Request,
  dependencies: &mut List<Dependency>, module: &ModuleId, cursor: &AuthoredCursor, caller: &DeclarationId,
  locals: &mut List<BodyLocal>, annotations: &[ResolvedAnnotation], calls: &[ResolvedCall],
  nodes: &mut List<BodyNode>, signatures: &mut List<SignatureDependency>, requiredBodies: &mut List<DeclarationId>,
  statements: &mut List<BodyNodeId>, yielded: &mut Option<BodyNodeId>, expression: HirId, initialReachable: bool,
  resultType: &Shared<Type>, tail: &BlockTail, constraints: &[Constraint], contractBody: bool, staticBody: bool,
  loopDepth: usize, unsafeAllowed: bool,
) -> Result<bool, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut expected = Option<Shared<Type>>.none()
  let mut mismatchCode = RejectionCode.TypeMismatch
  if let BlockTail.Yielded {expected: wanted, mismatchCode: code} = &tail.* {
    expected = copyExpected(&wanted)
    mismatchCode = code
  }
  let checked = run checkStatementExpression(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
    module, cursor, caller, &mut locals.*, annotations, resultType, loopDepth, calls, &mut nodes.*, &mut signatures.*,
    &mut requiredBodies.*, expression, &expected, mismatchCode, constraints, contractBody, staticBody, unsafeAllowed, false)
  let node = match move checked {
    Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
    Result<BodyNodeId, Shared<Rejection>>.Failure {error} => { return Result<bool, Shared<Rejection>>.failResult(move error) }
  }
  let mut statement = true
  let mut diverges = false
  if let BodyNodeKind.Expression {ty, ..} = &List<BodyNode>.asSlice(&nodes.*)[node.index].kind {
    statement = Shared<Type>.with<bool>(&ty, unitOrNever)
    diverges = Shared<Type>.with<bool>(&ty, neverType)
  }
  if !statement {
    yielded.* = Option<BodyNodeId>.some(node)
    return Result<bool, Shared<Rejection>>.succeed(initialReachable)
  }
  run List<BodyNodeId>.append(&mut statements.*, node)
  return Result<bool, Shared<Rejection>>.succeed(initialReachable && !diverges)
}

// Whether the written statement at `span` surely lets a path continue past it. Its check failed,
// so this reads its tokens and fails closed: it holds only when every token is a literal, `true`,
// `false`, `if`, `else`, `while`, a brace or plain punctuation. Any name may be `never`-typed, any
// operator may dispatch to an implementation returning `never`, and any call, `run` or exit may
// end the path. An unknown source never resumes.
fn writtenResumes(source: &SourceIndex, cursor: &AuthoredCursor, span: Span) -> bool {
  if let Option<&IndexedSource>.Some {value} = move SourceIndex.sourceAtCursor(source, cursor) {
    let unit = IndexedSource.sourceUnit(value)
    let tokens = List<Token.Token>.asSlice(&unit.syntax.tokens)
    let mut at = usize.ZERO
    while at < tokens.length {
      let written = Token.span(tokens[at])
      if written.start >= span.start && written.end <= span.end {
        let inert = match Token.kind(tokens[at]) {
          TokenKind.Whitespace => true
          TokenKind.LineComment => true
          TokenKind.DocComment => true
          TokenKind.DecimalInteger => true
          TokenKind.DecimalFloat => true
          TokenKind.DurationLiteral => true
          TokenKind.TextLiteral => true
          TokenKind.ByteStringLiteral => true
          TokenKind.CharLiteral => true
          TokenKind.TrueKeyword => true
          TokenKind.FalseKeyword => true
          TokenKind.IfKeyword => true
          TokenKind.ElseKeyword => true
          TokenKind.WhileKeyword => true
          TokenKind.LeftBrace => true
          TokenKind.RightBrace => true
          TokenKind.Semicolon => true
          TokenKind.Comma => true
          _ => false
        }
        if !inert { return false }
      }
      at = at + usize.ONE
    }
    return true
  }
  return false
}

fn writtenStaticConditional(node: &Node) -> bool {
  return match &node.* {
    Node.StaticConditionalStatement {..} => true
    _ => false
  }
}

effect fn checkWrittenStatement(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut List<Dependency>,
  module: &ModuleId,
  cursor: &AuthoredCursor,
  caller: &DeclarationId,
  locals: &mut List<BodyLocal>,
  bindings: &mut List<Symbol>,
  annotations: &[ResolvedAnnotation],
  calls: &[ResolvedCall],
  nodes: &mut List<BodyNode>,
  signatures: &mut List<SignatureDependency>,
  requiredBodies: &mut List<DeclarationId>,
  statements: &mut List<BodyNodeId>,
  statement: HirId,
  span: Span,
  writtenNode: Node,
  initialReachable: bool,
  resultType: &Shared<Type>,
  constraints: &[Constraint],
  contractBody: bool,
  staticBody: bool,
  loopDepth: usize,
  unsafeAllowed: bool,
) -> Result<bool, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
    match writtenNode {
      Node.StaticForStatement {body, ..} => {
        return run checkWrittenStaticFor(
          &mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module,
          cursor, caller, &mut locals.*, annotations, calls,
          &mut nodes.*, &mut signatures.*, &mut requiredBodies.*, &mut statements.*, statement,
          initialReachable, resultType, constraints, contractBody, staticBody,
          loopDepth, unsafeAllowed, body,
        )
      }
      Node.ConditionalStatement {..} => {
        return run checkWrittenConditional(
          &mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module,
          cursor, caller, &mut locals.*, annotations, calls,
          &mut nodes.*, &mut signatures.*, &mut requiredBodies.*, &mut statements.*, statement,
          initialReachable, resultType, constraints, contractBody, staticBody,
          loopDepth, unsafeAllowed,
        )
      }
      Node.PatternConditionalStatement {..} => {
        return run checkWrittenPatternConditional(
          &mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module,
          cursor, caller, &mut locals.*, annotations, calls,
          &mut nodes.*, &mut signatures.*, &mut requiredBodies.*, &mut statements.*, statement,
          initialReachable, resultType, constraints, contractBody, staticBody,
          loopDepth, unsafeAllowed,
        )
      }
      Node.PatternBindingStatement {pattern, initializer} => {
        return run checkWrittenPatternBinding(
          &mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module,
          cursor, caller, &mut locals.*, annotations, calls,
          &mut nodes.*, &mut signatures.*, &mut requiredBodies.*, &mut statements.*, statement,
          initialReachable, resultType, constraints, contractBody, staticBody,
          loopDepth, unsafeAllowed, pattern, initializer,
        )
      }
      Node.ReturnStatement {value: returned} => {
        return run checkWrittenReturn(
          &mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module,
          cursor, caller, &mut locals.*, annotations, calls,
          &mut nodes.*, &mut signatures.*, &mut requiredBodies.*, &mut statements.*, statement,
          span, initialReachable, resultType, constraints, contractBody,
          staticBody, loopDepth, unsafeAllowed, returned,
        )
      }
      Node.ExpressionStatement {expression} => {
        return run checkWrittenExpression(
          &mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module,
          cursor, caller, &mut locals.*, annotations, calls,
          &mut nodes.*, &mut signatures.*, &mut requiredBodies.*, &mut statements.*, initialReachable,
          resultType, constraints, contractBody, staticBody, loopDepth,
          unsafeAllowed, expression,
        )
      }
      Node.BindingStatement {name, mutable, isStatic, annotation, initializer} => {
        return run checkWrittenBinding(
          &mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module,
          cursor, caller, &mut locals.*, &mut bindings.*, annotations,
          calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*, &mut statements.*,
          statement, span, initialReachable, resultType, constraints,
          contractBody, staticBody, loopDepth, unsafeAllowed, name,
          mutable, isStatic, annotation, initializer,
        )
      }
      Node.UnsafeStatement {body} => {
        return run checkWrittenUnsafe(
          &mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module,
          cursor, caller, &mut locals.*, annotations, calls,
          &mut nodes.*, &mut signatures.*, &mut requiredBodies.*, &mut statements.*, span,
          initialReachable, resultType, constraints, contractBody, staticBody,
          loopDepth, body,
        )
      }
      Node.AssignmentStatement {target, value} => {
        return run checkWrittenAssignment(
          &mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module,
          cursor, caller, &mut locals.*, annotations, calls,
          &mut nodes.*, &mut signatures.*, &mut requiredBodies.*, &mut statements.*, statement,
          span, initialReachable, resultType, constraints, contractBody,
          staticBody, loopDepth, unsafeAllowed, target, value,
        )
      }
      Node.WhileStatement {condition, body} => {
        return run checkWrittenWhile(
          &mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module,
          cursor, caller, &mut locals.*, annotations, calls,
          &mut nodes.*, &mut signatures.*, &mut requiredBodies.*, &mut statements.*, statement,
          span, initialReachable, resultType, constraints, contractBody,
          staticBody, loopDepth, unsafeAllowed, condition, body,
        )
      }
      Node.FailStatement {isMove, value} => {
        return run checkWrittenFail(
          &mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module,
          cursor, caller, &mut locals.*, annotations, calls,
          &mut nodes.*, &mut signatures.*, &mut requiredBodies.*, &mut statements.*, statement,
          span, initialReachable, resultType, constraints, contractBody,
          staticBody, loopDepth, unsafeAllowed, isMove, value,
        )
      }
      Node.DropStatement {value} => {
        return run checkWrittenDrop(
          &mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module,
          cursor, caller, &mut locals.*, annotations, calls,
          &mut nodes.*, &mut signatures.*, &mut requiredBodies.*, &mut statements.*, statement,
          span, initialReachable, resultType, constraints, contractBody,
          staticBody, loopDepth, unsafeAllowed, value,
        )
      }
      Node.BreakStatement => {
        return run checkWrittenBreak(
          &mut resolver.*, module, cursor, &mut nodes.*, &mut statements.*, statement,
          span, initialReachable, loopDepth,
        )
      }
      Node.ContinueStatement => {
        return run checkWrittenContinue(
          &mut resolver.*, module, cursor, &mut nodes.*, &mut statements.*, statement,
          span, initialReachable, loopDepth,
        )
      }
      _ => {
        return Result<bool, Shared<Rejection>>.failResult(
          run reject(&resolver.*, module, RejectionCode.Unsupported, span),
        )
      }
    }
}

effect fn checkWrittenStaticFor(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut List<Dependency>,
  module: &ModuleId,
  cursor: &AuthoredCursor,
  caller: &DeclarationId,
  locals: &mut List<BodyLocal>,
  annotations: &[ResolvedAnnotation],
  calls: &[ResolvedCall],
  nodes: &mut List<BodyNode>,
  signatures: &mut List<SignatureDependency>,
  requiredBodies: &mut List<DeclarationId>,
  statements: &mut List<BodyNodeId>,
  statement: HirId,
  initialReachable: bool,
  resultType: &Shared<Type>,
  constraints: &[Constraint],
  contractBody: bool,
  staticBody: bool,
  loopDepth: usize,
  unsafeAllowed: bool,
  writtenBody: HirId,
) -> Result<bool, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let body = writtenBody
  let mut reachable = initialReachable
        let checked = run checkStaticFor(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
          module, cursor, caller, &mut locals.*, annotations, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*,
          statement, body, resultType, constraints, contractBody, staticBody, loopDepth, unsafeAllowed)
        match move checked {
          Result<CheckedControl, Shared<Rejection>>.Success {value} => {
            run List<BodyNodeId>.append(&mut statements.*, value.node)
            reachable = reachable && value.canComplete
          }
          Result<CheckedControl, Shared<Rejection>>.Failure {error} => { return Result<bool, Shared<Rejection>>.failResult(move error) }
        }
  return Result<bool, Shared<Rejection>>.succeed(reachable)
}

effect fn checkWrittenConditional(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut List<Dependency>,
  module: &ModuleId,
  cursor: &AuthoredCursor,
  caller: &DeclarationId,
  locals: &mut List<BodyLocal>,
  annotations: &[ResolvedAnnotation],
  calls: &[ResolvedCall],
  nodes: &mut List<BodyNode>,
  signatures: &mut List<SignatureDependency>,
  requiredBodies: &mut List<DeclarationId>,
  statements: &mut List<BodyNodeId>,
  statement: HirId,
  initialReachable: bool,
  resultType: &Shared<Type>,
  constraints: &[Constraint],
  contractBody: bool,
  staticBody: bool,
  loopDepth: usize,
  unsafeAllowed: bool,

) -> Result<bool, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let mut reachable = initialReachable
        let checked = run checkConditional(
          &mut resolver.*,
          &mut owner.*,
          &mut request.*,
          &mut dependencies.*,
          module,
          cursor,
          caller,
          &mut locals.*,
          annotations,
          calls,
          &mut nodes.*,
          &mut signatures.*,
          &mut requiredBodies.*,
          statement,
          resultType,
          constraints,
          contractBody,
          staticBody,
          loopDepth,
          unsafeAllowed,
        )
        match move checked {
          Result<CheckedControl, Shared<Rejection>>.Success {value} => {
            run List<BodyNodeId>.append(&mut statements.*, value.node)
            reachable = reachable && value.canComplete
          }
          Result<CheckedControl, Shared<Rejection>>.Failure {error} => {
            return Result<bool, Shared<Rejection>>.failResult(move error)
          }
        }
  return Result<bool, Shared<Rejection>>.succeed(reachable)
}

effect fn checkWrittenPatternConditional(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut List<Dependency>,
  module: &ModuleId,
  cursor: &AuthoredCursor,
  caller: &DeclarationId,
  locals: &mut List<BodyLocal>,
  annotations: &[ResolvedAnnotation],
  calls: &[ResolvedCall],
  nodes: &mut List<BodyNode>,
  signatures: &mut List<SignatureDependency>,
  requiredBodies: &mut List<DeclarationId>,
  statements: &mut List<BodyNodeId>,
  statement: HirId,
  initialReachable: bool,
  resultType: &Shared<Type>,
  constraints: &[Constraint],
  contractBody: bool,
  staticBody: bool,
  loopDepth: usize,
  unsafeAllowed: bool,

) -> Result<bool, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let mut reachable = initialReachable
        let checked = run checkControl(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
          module, cursor, caller, &mut locals.*, annotations, calls, &mut nodes.*, &mut signatures.*,
          &mut requiredBodies.*, statement, resultType, constraints, contractBody, staticBody, loopDepth, unsafeAllowed)
        match move checked {
          Result<CheckedControl, Shared<Rejection>>.Success {value} => {
            run List<BodyNodeId>.append(&mut statements.*, value.node)
            reachable = reachable && value.canComplete
          }
          Result<CheckedControl, Shared<Rejection>>.Failure {error} => {
            return Result<bool, Shared<Rejection>>.failResult(move error)
          }
        }
  return Result<bool, Shared<Rejection>>.succeed(reachable)
}

effect fn checkWrittenPatternBinding(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut List<Dependency>,
  module: &ModuleId,
  cursor: &AuthoredCursor,
  caller: &DeclarationId,
  locals: &mut List<BodyLocal>,
  annotations: &[ResolvedAnnotation],
  calls: &[ResolvedCall],
  nodes: &mut List<BodyNode>,
  signatures: &mut List<SignatureDependency>,
  requiredBodies: &mut List<DeclarationId>,
  statements: &mut List<BodyNodeId>,
  statement: HirId,
  initialReachable: bool,
  resultType: &Shared<Type>,
  constraints: &[Constraint],
  contractBody: bool,
  staticBody: bool,
  loopDepth: usize,
  unsafeAllowed: bool,
  writtenPattern: HirId,
  writtenInitializer: HirId,
) -> Result<bool, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let pattern = writtenPattern
  let initializer = writtenInitializer
  let mut reachable = initialReachable
        // `let _ = e` is not a second discard statement; intentional discard is `drop e` (SEM0087).
        if let Node.UniversalPattern {..} = run bodyNode(&resolver.source, cursor, pattern) {
          return Result<bool, Shared<Rejection>>.failResult(
            run letDiscardRejection(module, run bodySpan(&resolver.source, cursor, pattern)),
          )
        }
        let checked = run checkPatternStatement(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
          module, cursor, caller, &mut locals.*, annotations, calls, &mut nodes.*, &mut signatures.*,
          &mut requiredBodies.*, statement, initializer, MatchArms.Binding {pattern: pattern}, resultType,
          constraints, contractBody, staticBody, loopDepth, unsafeAllowed)
        match move checked {
          Result<CheckedControl, Shared<Rejection>>.Success {value} => {
            run List<BodyNodeId>.append(&mut statements.*, value.node)
          }
          Result<CheckedControl, Shared<Rejection>>.Failure {error} => {
            return Result<bool, Shared<Rejection>>.failResult(move error)
          }
        }
  return Result<bool, Shared<Rejection>>.succeed(reachable)
}

effect fn checkWrittenReturn(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut List<Dependency>,
  module: &ModuleId,
  cursor: &AuthoredCursor,
  caller: &DeclarationId,
  locals: &mut List<BodyLocal>,
  annotations: &[ResolvedAnnotation],
  calls: &[ResolvedCall],
  nodes: &mut List<BodyNode>,
  signatures: &mut List<SignatureDependency>,
  requiredBodies: &mut List<DeclarationId>,
  statements: &mut List<BodyNodeId>,
  statement: HirId,
  span: Span,
  initialReachable: bool,
  resultType: &Shared<Type>,
  constraints: &[Constraint],
  contractBody: bool,
  staticBody: bool,
  loopDepth: usize,
  unsafeAllowed: bool,
  writtenReturned: HirRef,
) -> Result<bool, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let returned = writtenReturned
  let mut reachable = initialReachable
        if span.start == span.end && returned.present {
          match run bodyNode(&resolver.source, cursor, returned.id) {
            Node.UnitLiteral => {
              return Result<bool, Shared<Rejection>>.succeed(reachable)
            }
            _ => ()
          }
        }
        let mut checked = Option<BodyNodeId>.none()
        // A deriving `effect {}` body's success type is the join of what it returns (EFF-002).
        let deriving = derivingBody(&resolver.*)
        if returned.present {
          // Only this producer may establish its own opaque result. Check the construction at
          // its exact type first; an ordinary expected-value boundary must keep families exact.
          let opaqueResult = run Type.containsOpaque(resultType, caller)
          let callableResult = Shared<Type>.with<bool>(resultType, fn(ty: &Type) -> bool {
            return match &ty.* { Type.Callable {..} => true _ => false }
          })
          if opaqueResult {
            let supportedContext = Shared<Type>.with<bool>(resultType, fn(ty: &Type) -> bool {
              return match &ty.* { Type.OpaqueRepresentation {..} => true Type.Nominal {..} => true Type.Union {..} => true _ => false }
            })
            if !supportedContext {
              let constructionSpan = run bodySpan(&resolver.source, cursor, returned.id)
              return Result<bool, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Unsupported, constructionSpan))
            }
          }
          let mut expected = Option<Shared<Type>>.none()
          let mut opaqueConstruction = false
          if !opaqueResult && !callableResult { expected = Option<Shared<Type>>.some(Shared<Type>.clone(resultType)) }
          if opaqueResult && !deriving {
            let kind = Shared<Type>.with<OwnerKind>(resultType, nominalKind)
            let literal = run bodyNode(&resolver.source, cursor, returned.id)
            let contextual = match literal {
              Node.RecordExpression {..} => kind == OwnerKind.Struct
              Node.TupleExpression {..} => kind == OwnerKind.Tuple
              _ => false
            }
            if contextual {
              expected = Option<Shared<Type>>.some(Shared<Type>.clone(resultType))
              opaqueConstruction = true
            }
            // A returned `effect {}` block takes its channels from the declared Effect (EFF-011).
            if let Node.EffectExpression {..} = literal {
              let declared = Shared<Type>.with<Option<Shared<Type>>>(resultType, effectFamilyContract)
              if let Option<Shared<Type>>.Some {value: contract} = move declared {
                // A nested family's success is realized from the block, so the block derives it.
                if !Shared<Type>.with<bool>(&contract, nestedFamily) { expected = Option<Shared<Type>>.some(move contract) }
              }
            }
          }
          if deriving { expected = Option<Shared<Type>>.none() }
          let expression = run checkStatementExpression(
            &mut resolver.*,
            &mut owner.*,
            &mut request.*,
            &mut dependencies.*,
            module,
            cursor,
            caller,
            &mut locals.*,
            annotations,
            resultType,
            loopDepth,
            calls,
            &mut nodes.*,
            &mut signatures.*,
            &mut requiredBodies.*,
            returned.id,
            &expected, RejectionCode.ReturnTypeMismatch,
            constraints,
            contractBody,
            staticBody,
            unsafeAllowed, opaqueConstruction,
          )
          match move expression {
            Result<BodyNodeId, Shared<Rejection>>.Success {value: node} => {
              let mut returnedNode = node
              if opaqueResult || callableResult {
                let returnSpan = run originSpan(cursor, List<BodyNode>.asSlice(&nodes.*)[node.index].origin)
                let mut failure = Option<Shared<Rejection>>.none()
                if opaqueResult {
                  failure = run proveOpaqueReturn(&mut resolver.*, &mut owner.*, &mut dependencies.*,
                    module, caller, List<BodyNode>.asSlice(&nodes.*), node, resultType, constraints, returnSpan)
                } else {
                  failure = run provePlainCallableReturn(&mut resolver.*, &mut owner.*, &mut dependencies.*,
                    module, caller, List<BodyNode>.asSlice(&nodes.*), node, resultType, constraints, returnSpan)
                }
                if let Option<Shared<Rejection>>.Some {value} = move failure {
                  return Result<bool, Shared<Rejection>>.failResult(run executableReturnRejection(&mut resolver.*, &mut owner.*, &mut dependencies.*, module,
                    cursor, caller, List<BodyNode>.asSlice(&nodes.*), node, move value, returnSpan))
                }
                let transferred = run transferCallableReturn(&mut resolver.*, &mut owner.*, &mut dependencies.*,
                  module, cursor, &mut nodes.*, node, constraints, returnSpan)
                match move transferred {
                  Result<BodyNodeId, Shared<Rejection>>.Success {value} => { returnedNode = value }
                  Result<BodyNodeId, Shared<Rejection>>.Failure {error} => { return Result<bool, Shared<Rejection>>.failResult(move error) }
                }
              }
              if opaqueResult || callableResult {
                let returnSpan = run originSpan(cursor, List<BodyNode>.asSlice(&nodes.*)[returnedNode.index].origin)
                let unknown = run unknownOwnedCallableReturn(&mut resolver.*, &mut owner.*, &mut dependencies.*,
                  module, List<BodyNode>.asSlice(&nodes.*), returnedNode, returnSpan)
                if let Option<Shared<Rejection>>.Some {value} = move unknown {
                  return Result<bool, Shared<Rejection>>.failResult(move value)
                }
              }
              if opaqueResult {
                returnedNode = run opaqueUnionArgument(&mut nodes.*, returnedNode, resultType, caller)
              }
              checked = Option<BodyNodeId>.some(returnedNode)
              if deriving {
                let returnedType = bodyExpressionType(List<BodyNode>.asSlice(&nodes.*), &returnedNode)
                run deriveChannels(&mut resolver.*, move returnedType, Option<Shared<Type>>.none(), Option<Shared<Type>>.none(),
                  Option<Shared<Row>>.none())
              }
            }
            Result<BodyNodeId, Shared<Rejection>>.Failure {error} => {
              let wanted = run valueCallableContract(resultType, constraints)
              if let Option<Shared<Type>>.Some {..} = move wanted {
                let entries = List<BodyNode>.asSlice(&nodes.*)
                let construction = run bodySpan(&resolver.source, cursor, returned.id)
                let mut index = entries.length
                while index != usize.ZERO {
                  index = index - usize.ONE
                  let actualSpan = run originSpan(cursor, entries[index].origin)
                  if actualSpan.start == construction.start && actualSpan.end == construction.end {
                    return Result<bool, Shared<Rejection>>.failResult(run executableReturnRejection(&mut resolver.*, &mut owner.*, &mut dependencies.*, module,
                      cursor, caller, entries, BodyNodeId {index: index}, move error, construction))
                  }
                }
              }
              return Result<bool, Shared<Rejection>>.failResult(move error)
            }
          }
        } else if deriving {
          run deriveChannels(&mut resolver.*, Option<Shared<Type>>.some(run Types.intern(Type.Unit)), Option<Shared<Type>>.none(),
            Option<Shared<Type>>.none(), Option<Shared<Row>>.none())
        } else if Shared<Type>.with<usize>(resultType, scalarCode) != 1 {
          return Result<bool, Shared<Rejection>>.failResult(
            run reject(&resolver.*, module, RejectionCode.ReturnTypeMismatch, span),
          )
        }
        let node = BodyNodeId {index: List<BodyNode>.length(&nodes.*)}
        run List<BodyNode>.append(
          &mut nodes.*,
          BodyNode {
            origin: run originAt(cursor, statement, span),
            kind: BodyNodeKind.Return {value: move checked},
          },
        )
        run List<BodyNodeId>.append(&mut statements.*, node)
        reachable = false
  return Result<bool, Shared<Rejection>>.succeed(reachable)
}

effect fn checkWrittenExpression(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut List<Dependency>,
  module: &ModuleId,
  cursor: &AuthoredCursor,
  caller: &DeclarationId,
  locals: &mut List<BodyLocal>,
  annotations: &[ResolvedAnnotation],
  calls: &[ResolvedCall],
  nodes: &mut List<BodyNode>,
  signatures: &mut List<SignatureDependency>,
  requiredBodies: &mut List<DeclarationId>,
  statements: &mut List<BodyNodeId>,
  initialReachable: bool,
  resultType: &Shared<Type>,
  constraints: &[Constraint],
  contractBody: bool,
  staticBody: bool,
  loopDepth: usize,
  unsafeAllowed: bool,
  writtenExpression: HirId,
) -> Result<bool, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let expression = writtenExpression
  let mut reachable = initialReachable
        let checked = run checkDiscardedExpression(
          &mut resolver.*,
          &mut owner.*,
          &mut request.*,
          &mut dependencies.*,
          module,
          cursor,
          caller,
          &mut locals.*,
          annotations,
          resultType,
          loopDepth,
          calls,
          &mut nodes.*,
          &mut signatures.*,
          &mut requiredBodies.*,
          expression,
          constraints,
          contractBody,
          staticBody,
          unsafeAllowed,
        )
        match move checked {
          Result<BodyNodeId, Shared<Rejection>>.Success {value: node} => {
            let diverges = match & List<BodyNode>.asSlice(&nodes.*)[node.index].kind {
              BodyNodeKind.Expression {ty, ..} => Shared<Type>.with<bool>(&ty, neverType)
              _ => false
            }
            // STMT-001: only a `()` or `never` result may stand alone; any other value, an Effect
            // construction included, is bound, returned, run or explicitly dropped.
            let ignorable = match & List<BodyNode>.asSlice(&nodes.*)[node.index].kind {
              BodyNodeKind.Expression {ty, ..} => Shared<Type>.with<bool>(&ty, unitOrNever)
              _ => true
            }
            if !ignorable {
              let discarded = match & List<BodyNode>.asSlice(&nodes.*)[node.index].kind {
                BodyNodeKind.Expression {ty, ..} => Shared<Type>.clone(&ty)
                _ => run Types.intern(Type.Unit)
              }
              let discardSpan = run bodySpan(&resolver.source, cursor, expression)
              // An Effect has no type spelling, so the message names its success and how to run it.
              if let Option<Bytes>.Some {value: effectText} = move run unrunEffectText(module, &discarded) {
                let mut actual = move effectText
                run Bytes.append(&mut actual, b" that is never run (write `run` before it to run it, or `drop` it to discard it)")
                let mut diagnostic = run makeRejection(RejectionCode.ExplicitDiscard, module, discardSpan)
                run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"actual"), value: move actual})
                run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"template"), value: run Bytes.copy(b"3")})
                return Result<bool, Shared<Rejection>>.failResult(run Shared<Rejection>.make(move diagnostic))
              }
              return Result<bool, Shared<Rejection>>.failResult(run statementResultRejection(module, discardSpan, &discarded))
            }
            run List<BodyNodeId>.append(&mut statements.*, node)
            if diverges {
              reachable = false
            }
          }
          Result<BodyNodeId, Shared<Rejection>>.Failure {error} => {
            return Result<bool, Shared<Rejection>>.failResult(move error)
          }
        }
  return Result<bool, Shared<Rejection>>.succeed(reachable)
}

effect fn checkWrittenBinding(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut List<Dependency>,
  module: &ModuleId,
  cursor: &AuthoredCursor,
  caller: &DeclarationId,
  locals: &mut List<BodyLocal>,
  bindings: &mut List<Symbol>,
  annotations: &[ResolvedAnnotation],
  calls: &[ResolvedCall],
  nodes: &mut List<BodyNode>,
  signatures: &mut List<SignatureDependency>,
  requiredBodies: &mut List<DeclarationId>,
  statements: &mut List<BodyNodeId>,
  statement: HirId,
  span: Span,
  initialReachable: bool,
  resultType: &Shared<Type>,
  constraints: &[Constraint],
  contractBody: bool,
  staticBody: bool,
  loopDepth: usize,
  unsafeAllowed: bool,
  writtenName: HirId,
  writtenMutable: bool,
  writtenIsStatic: bool,
  writtenAnnotation: HirRef,
  writtenInitializer: HirId,
) -> Result<bool, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let name = writtenName
  let mutable = writtenMutable
  let isStatic = writtenIsStatic
  let annotation = writtenAnnotation
  let initializer = writtenInitializer
  let mut reachable = initialReachable
        if isStatic {
          // The selection pass evaluated this binding; its later reads are embedded values and it
          // has no runtime local. An unselected body cannot hold static state.
          if staticBindingFact(calls, statement) {
            return Result<bool, Shared<Rejection>>.succeed(reachable)
          }
          return Result<bool, Shared<Rejection>>.failResult(
            run reject(&resolver.*, module, RejectionCode.Unsupported, span),
          )
        }
        // The block's names belong to one authored string table. Linux matrix samples
        // spent repeated seconds copying HIR/name bytes inside this collision scan.
        let binderName = match run bodyNode(&resolver.source, cursor, name) {
          Node.Name {text} => Option<Symbol>.some(text)
          _ => Option<Symbol>.none()
        }
        if let Option<Symbol>.Some {value: symbol} = &binderName {
          if bindingNameCollides(List<Symbol>.asSlice(&bindings.*), symbol.index) {
            return Result<bool, Shared<Rejection>>.failResult(
              run reject(
                &resolver.*,
                module,
                RejectionCode.RebindingName,
                run bodySpan(&resolver.source, cursor, name),
              ),
            )
          }
        }
        let mut expected = Option<Shared<Type>>.none()
        // An annotation that elides a lifetime describes the initializer's own regions, so the
        // initializer is checked on its own and supplies each elided lifetime (LIFE-003).
        let mut described = Option<Shared<Type>>.none()
        let elided = run elidedLifetimeOwner(caller)
        if annotation.present {
          let declared = run bindingAnnotationType(
            &resolver.*, module, cursor, annotations, annotation.id, contractBody, staticBody,
          )
          match move declared {
            Result<Shared<Type>, Shared<Rejection>>.Success {value} => {
              if run typeMentionsOwner(&value, &elided) {
                // An empty array literal holds no value to supply an elided lifetime, and it is
                // valid for every region, so `'static` fills each one (LIFE-003).
                if run emptyArrayLiteral(&resolver.source, cursor, initializer) {
                  expected = Option<Shared<Type>>.some(run staticElided(&value, &elided))
                } else {
                  described = Option<Shared<Type>>.some(move value)
                }
              } else {
                expected = Option<Shared<Type>>.some(move value)
              }
            }
            Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
              return Result<bool, Shared<Rejection>>.failResult(move error)
            }
          }
        }
        let checked = run checkStatementExpression(
          &mut resolver.*,
          &mut owner.*,
          &mut request.*,
          &mut dependencies.*,
          module,
          cursor,
          caller,
          &mut locals.*,
          annotations,
          resultType,
          loopDepth,
          calls,
          &mut nodes.*,
          &mut signatures.*,
          &mut requiredBodies.*,
          initializer,
          &expected, RejectionCode.AssignmentTypeMismatch,
          constraints,
          contractBody,
          staticBody,
          unsafeAllowed, false,
        )
        let mut initializerNode = match move checked {
          Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
          Result<BodyNodeId, Shared<Rejection>>.Failure {error} => {
            return Result<bool, Shared<Rejection>>.failResult(move error)
          }
        }
        if let Option<Shared<Type>>.Some {value: annotated} = &described {
          let admitted = run describedBinding(&resolver.*, module, &mut nodes.*, initializerNode, &annotated, &elided,
            run bodySpan(&resolver.source, cursor, initializer))
          initializerNode = match move admitted {
            Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
            Result<BodyNodeId, Shared<Rejection>>.Failure {error} => {
              return Result<bool, Shared<Rejection>>.failResult(move error)
            }
          }
        }
        let checkedNodes = List<BodyNode>.asSlice(&nodes.*)
        let ty = match & checkedNodes[initializerNode.index].kind {
          BodyNodeKind.Expression {ty, ..} => Shared<Type>.clone(&ty)
          _ => {
            return Result<bool, Shared<Rejection>>.failResult(
              run reject(&resolver.*, module, RejectionCode.Unsupported, span),
            )
          }
        }
        let mut meetDepth = Option<usize>.none()
        if mutable && !annotation.present { meetDepth = Option<usize>.some(loopDepth) }
        let local = BodyLocalId {index: List<BodyLocal>.length(&locals.*)}
        run List<BodyLocal>.append(
          &mut locals.*,
          BodyLocal {
            origin: run originAt(cursor, statement, run bodySpan(&resolver.source, cursor, name)),
            ty: move ty,
            mutable: mutable,
            meetDepth: move meetDepth,
            written: annotation.present,
          },
        )
        if let Option<Symbol>.Some {value: symbol} = move binderName {
          run List<Symbol>.append(&mut bindings.*, symbol)
        }
        let node = BodyNodeId {index: List<BodyNode>.length(&nodes.*)}
        let mut bindingKind = BodyNodeKind.LocalBinding {local: local, initializer: initializerNode}
        if mutable {
          bindingKind = BodyNodeKind.MutableBinding {local: local, initializer: initializerNode}
        }
        run List<BodyNode>.append(
          &mut nodes.*,
          BodyNode {origin: run originAt(cursor, statement, span), kind: move bindingKind},
        )
        run List<BodyNodeId>.append(&mut statements.*, node)
  return Result<bool, Shared<Rejection>>.succeed(reachable)
}

effect fn checkWrittenUnsafe(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut List<Dependency>,
  module: &ModuleId,
  cursor: &AuthoredCursor,
  caller: &DeclarationId,
  locals: &mut List<BodyLocal>,
  annotations: &[ResolvedAnnotation],
  calls: &[ResolvedCall],
  nodes: &mut List<BodyNode>,
  signatures: &mut List<SignatureDependency>,
  requiredBodies: &mut List<DeclarationId>,
  statements: &mut List<BodyNodeId>,
  span: Span,
  initialReachable: bool,
  resultType: &Shared<Type>,
  constraints: &[Constraint],
  contractBody: bool,
  staticBody: bool,
  loopDepth: usize,
  writtenBody: HirId,
) -> Result<bool, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let body = writtenBody
  let mut reachable = initialReachable
        if staticBody {
          return Result<bool, Shared<Rejection>>.failResult(
            run reject(&resolver.*, module, RejectionCode.StaticPhaseViolation, span),
          )
        }
        let checked = run checkBlock(
          &mut resolver.*,
          &mut owner.*,
          &mut request.*,
          &mut dependencies.*,
          module,
          cursor,
          caller,
          &mut locals.*,
          annotations,
          calls,
          &mut nodes.*,
          &mut signatures.*,
          &mut requiredBodies.*,
          body,
          resultType,
          constraints,
          contractBody,
          staticBody,
          loopDepth,
          true,
        )
        match move checked {
          Result<CheckedControl, Shared<Rejection>>.Success {value} => {
            run List<BodyNodeId>.append(&mut statements.*, value.node)
            reachable = value.canComplete
          }
          Result<CheckedControl, Shared<Rejection>>.Failure {error} => {
            return Result<bool, Shared<Rejection>>.failResult(move error)
          }
        }
  return Result<bool, Shared<Rejection>>.succeed(reachable)
}

effect fn checkWrittenAssignment(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut List<Dependency>,
  module: &ModuleId,
  cursor: &AuthoredCursor,
  caller: &DeclarationId,
  locals: &mut List<BodyLocal>,
  annotations: &[ResolvedAnnotation],
  calls: &[ResolvedCall],
  nodes: &mut List<BodyNode>,
  signatures: &mut List<SignatureDependency>,
  requiredBodies: &mut List<DeclarationId>,
  statements: &mut List<BodyNodeId>,
  statement: HirId,
  span: Span,
  initialReachable: bool,
  resultType: &Shared<Type>,
  constraints: &[Constraint],
  contractBody: bool,
  staticBody: bool,
  loopDepth: usize,
  unsafeAllowed: bool,
  writtenTarget: HirId,
  writtenValue: HirId,
) -> Result<bool, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let target = writtenTarget
  let value = writtenValue
  let mut reachable = initialReachable
        if !staticBody {
          let checked = run checkPlaceAssignment(
            &mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module, cursor,
            caller, &mut locals.*, annotations, resultType, loopDepth, calls, &mut nodes.*,
            &mut signatures.*, &mut requiredBodies.*, statement, span, target, value,
            constraints, contractBody, unsafeAllowed,
          )
          match move checked {
            Result<BodyNodeId, Shared<Rejection>>.Success {value: node} => {
              run List<BodyNodeId>.append(&mut statements.*, node)
            }
            Result<BodyNodeId, Shared<Rejection>>.Failure {error} => {
              return Result<bool, Shared<Rejection>>.failResult(move error)
            }
          }
          return Result<bool, Shared<Rejection>>.succeed(reachable)
        }
        let mut selected = Option<BodyLocalId>.none()
        if let Node.IdentifierExpression {binding, ..} = run bodyNode(
          &resolver.source,
          cursor,
          target,
        ) {
          selected = mutableLocalOf(&resolver.*, List<BodyLocal>.asSlice(&locals.*), binding, &run cursorAnchor(cursor))
        }
        let local = match move selected {
          Option<BodyLocalId>.Some {value: found} => found
          Option<BodyLocalId>.None => {
            return Result<bool, Shared<Rejection>>.failResult(
              run reject(
                &resolver.*,
                module,
                RejectionCode.StaticPhaseViolation,
                run bodySpan(&resolver.source, cursor, target),
              ),
            )
          }
        }
        let available = List<BodyLocal>.asSlice(&locals.*)
        let expected = Option<Shared<Type>>.some(Shared<Type>.clone(&available[local.index].ty))
        let checked = run checkStatementExpression(
          &mut resolver.*,
          &mut owner.*,
          &mut request.*,
          &mut dependencies.*,
          module,
          cursor,
          caller,
          &mut locals.*,
          annotations,
          resultType,
          loopDepth,
          calls,
          &mut nodes.*,
          &mut signatures.*,
          &mut requiredBodies.*,
          value,
          &expected, RejectionCode.AssignmentTypeMismatch,
          constraints,
          contractBody,
          staticBody,
          unsafeAllowed, false,
        )
        let replacement = match move checked {
          Result<BodyNodeId, Shared<Rejection>>.Success {value: found} => found
          Result<BodyNodeId, Shared<Rejection>>.Failure {error} => {
            return Result<bool, Shared<Rejection>>.failResult(move error)
          }
        }
        let node = BodyNodeId {index: List<BodyNode>.length(&nodes.*)}
        run List<BodyNode>.append(
          &mut nodes.*,
          BodyNode {
            origin: run originAt(cursor, statement, span),
            kind: BodyNodeKind.Assignment {local: local, value: replacement},
          },
        )
        run List<BodyNodeId>.append(&mut statements.*, node)
  return Result<bool, Shared<Rejection>>.succeed(reachable)
}

effect fn checkWrittenWhile(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut List<Dependency>,
  module: &ModuleId,
  cursor: &AuthoredCursor,
  caller: &DeclarationId,
  locals: &mut List<BodyLocal>,
  annotations: &[ResolvedAnnotation],
  calls: &[ResolvedCall],
  nodes: &mut List<BodyNode>,
  signatures: &mut List<SignatureDependency>,
  requiredBodies: &mut List<DeclarationId>,
  statements: &mut List<BodyNodeId>,
  statement: HirId,
  span: Span,
  initialReachable: bool,
  resultType: &Shared<Type>,
  constraints: &[Constraint],
  contractBody: bool,
  staticBody: bool,
  loopDepth: usize,
  unsafeAllowed: bool,
  writtenCondition: HirId,
  writtenBody: HirId,
) -> Result<bool, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let condition = writtenCondition
  let body = writtenBody
  let mut reachable = initialReachable
        let boolType = Option<Shared<Type>>.some(run primitiveType(b"bool"))
        let checkedCondition = run checkStatementExpression(
          &mut resolver.*,
          &mut owner.*,
          &mut request.*,
          &mut dependencies.*,
          module,
          cursor,
          caller,
          &mut locals.*,
          annotations,
          resultType,
          loopDepth,
          calls,
          &mut nodes.*,
          &mut signatures.*,
          &mut requiredBodies.*,
          condition,
          &boolType, RejectionCode.ConditionNotBool,
          constraints,
          contractBody,
          staticBody,
          unsafeAllowed, false,
        )
        let conditionNode = match move checkedCondition {
          Result<BodyNodeId, Shared<Rejection>>.Success {value: found} => found
          Result<BodyNodeId, Shared<Rejection>>.Failure {error} => {
            return Result<bool, Shared<Rejection>>.failResult(move error)
          }
        }
        let checkedBody = run checkBlock(
          &mut resolver.*,
          &mut owner.*,
          &mut request.*,
          &mut dependencies.*,
          module,
          cursor,
          caller,
          &mut locals.*,
          annotations,
          calls,
          &mut nodes.*,
          &mut signatures.*,
          &mut requiredBodies.*,
          body,
          resultType,
          constraints,
          contractBody,
          staticBody,
          loopDepth + usize.ONE,
          unsafeAllowed,
        )
        let bodyNode = match move checkedBody {
          Result<CheckedControl, Shared<Rejection>>.Success {value: found} => found.node
          Result<CheckedControl, Shared<Rejection>>.Failure {error} => {
            return Result<bool, Shared<Rejection>>.failResult(move error)
          }
        }
        let node = BodyNodeId {index: List<BodyNode>.length(&nodes.*)}
        run List<BodyNode>.append(
          &mut nodes.*,
          BodyNode {
            origin: run originAt(cursor, statement, span),
            kind: BodyNodeKind.While {condition: conditionNode, body: bodyNode},
          },
        )
        run List<BodyNodeId>.append(&mut statements.*, node)
        // `while true` without a `break` of its own never completes.
        let checkedNodes = List<BodyNode>.asSlice(&nodes.*)
        if let BodyNodeKind.Expression {form: BodyExpression.Boolean {value: always}, ..} = &checkedNodes[conditionNode.index].kind {
          if always && !run breaksLoop(checkedNodes, bodyNode) { reachable = false }
        }
  return Result<bool, Shared<Rejection>>.succeed(reachable)
}

effect fn checkWrittenFail(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut List<Dependency>,
  module: &ModuleId,
  cursor: &AuthoredCursor,
  caller: &DeclarationId,
  locals: &mut List<BodyLocal>,
  annotations: &[ResolvedAnnotation],
  calls: &[ResolvedCall],
  nodes: &mut List<BodyNode>,
  signatures: &mut List<SignatureDependency>,
  requiredBodies: &mut List<DeclarationId>,
  statements: &mut List<BodyNodeId>,
  statement: HirId,
  span: Span,
  initialReachable: bool,
  resultType: &Shared<Type>,
  constraints: &[Constraint],
  contractBody: bool,
  staticBody: bool,
  loopDepth: usize,
  unsafeAllowed: bool,
  writtenIsMove: bool,
  writtenValue: HirId,
) -> Result<bool, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let isMove = writtenIsMove
  let value = writtenValue
  let mut reachable = initialReachable
        if staticBody {
          return Result<bool, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.StaticPhaseViolation, span))
        }
        let enclosing = run currentBodyChannels(&resolver.*)
        let deriving = derivingBody(&resolver.*)
        if !enclosing.isEffect {
          let mut diagnostic = run makeRejection(RejectionCode.FailOutsideEffect, module, span)
          run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"function"), value: run DeclarationId.copySpelling(caller)})
          return Result<bool, Shared<Rejection>>.failResult(run Shared<Rejection>.make(move diagnostic))
        }
        let valueSpan = run bodySpan(&resolver.source, cursor, value)
        // An effect fn that declares no failure has no member this payload could inhabit.
        if !deriving && Shared<Type>.with<bool>(&enclosing.failure, neverType) {
          return Result<bool, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.UndeclaredFailure, valueSpan))
        }
        // A moved operand is checked as written; its transfer is then widened into the channel. A
        // deriving body's failure type is the join of what it fails with.
        let mut context = Option<Shared<Type>>.some(Shared<Type>.clone(&enclosing.failure))
        if isMove || deriving { context = Option<Shared<Type>>.none() }
        let checked = run checkStatementExpression(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
          module, cursor, caller, &mut locals.*, annotations, resultType, loopDepth, calls, &mut nodes.*,
          &mut signatures.*, &mut requiredBodies.*, value, &context, RejectionCode.UndeclaredFailure, constraints,
          contractBody, staticBody, unsafeAllowed, false)
        let mut operand = match move checked {
          Result<BodyNodeId, Shared<Rejection>>.Success {value: node} => node
          Result<BodyNodeId, Shared<Rejection>>.Failure {error} => {
            return Result<bool, Shared<Rejection>>.failResult(move error)
          }
        }
        // `fail move value` transfers the operand exactly as a `move` expression does (FAIL-002).
        if isMove {
          let operandType = match move bodyExpressionType(List<BodyNode>.asSlice(&nodes.*), &operand) {
            Option<Shared<Type>>.Some {value: selected} => move selected
            Option<Shared<Type>>.None => { return Result<bool, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Unsupported, valueSpan)) }
          }
          let consumed = match move run consumedPlace(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor,
            List<BodyNode>.asSlice(&nodes.*), operand, false, false, valueSpan, span, constraints) {
            Result<Option<BodyConsumedPlace>, Shared<Rejection>>.Success {value: place} => move place
            Result<Option<BodyConsumedPlace>, Shared<Rejection>>.Failure {error} => { return Result<bool, Shared<Rejection>>.failResult(move error) }
          }
          let moved = BodyNodeId {index: List<BodyNode>.length(&nodes.*)}
          run List<BodyNode>.append(&mut nodes.*, BodyNode {origin: run originAt(cursor, value, valueSpan),
            kind: BodyNodeKind.Expression {ty: move operandType, form: BodyExpression.Move {value: operand, consumed: move consumed}}})
          operand = moved
        }
        if deriving {
          let failedType = match move bodyExpressionType(List<BodyNode>.asSlice(&nodes.*), &operand) {
            Option<Shared<Type>>.Some {value: selected} => move selected
            Option<Shared<Type>>.None => { return Result<bool, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Unsupported, valueSpan)) }
          }
          run deriveChannels(&mut resolver.*, Option<Shared<Type>>.none(), Option<Shared<Type>>.some(move failedType),
            Option<Shared<Type>>.none(), Option<Shared<Row>>.none())
        }
        let mut channel = Option<Shared<Type>>.some(Shared<Type>.clone(&enclosing.failure))
        if deriving { channel = Option<Shared<Type>>.none() }
        let adapted = run checkExpectedValue(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, caller, constraints, &mut nodes.*,
          operand, &channel, RejectionCode.UndeclaredFailure, valueSpan)
        let failed = match move adapted {
          Result<BodyNodeId, Shared<Rejection>>.Success {value: node} => node
          Result<BodyNodeId, Shared<Rejection>>.Failure {..} => {
            return Result<bool, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.UndeclaredFailure, valueSpan))
          }
        }
        let node = BodyNodeId {index: List<BodyNode>.length(&nodes.*)}
        run List<BodyNode>.append(&mut nodes.*, BodyNode {
          origin: run originAt(cursor, statement, span), kind: BodyNodeKind.Fail {value: failed},
        })
        run List<BodyNodeId>.append(&mut statements.*, node)
        reachable = false
  return Result<bool, Shared<Rejection>>.succeed(reachable)
}

effect fn checkWrittenDrop(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut List<Dependency>,
  module: &ModuleId,
  cursor: &AuthoredCursor,
  caller: &DeclarationId,
  locals: &mut List<BodyLocal>,
  annotations: &[ResolvedAnnotation],
  calls: &[ResolvedCall],
  nodes: &mut List<BodyNode>,
  signatures: &mut List<SignatureDependency>,
  requiredBodies: &mut List<DeclarationId>,
  statements: &mut List<BodyNodeId>,
  statement: HirId,
  span: Span,
  initialReachable: bool,
  resultType: &Shared<Type>,
  constraints: &[Constraint],
  contractBody: bool,
  staticBody: bool,
  loopDepth: usize,
  unsafeAllowed: bool,
  writtenValue: HirId,
) -> Result<bool, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let value = writtenValue
  let mut reachable = initialReachable
        if staticBody {
          return Result<bool, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Unsupported, span))
        }
        let checked = run checkStatementExpression(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
          module, cursor, caller, &mut locals.*, annotations, resultType, loopDepth, calls, &mut nodes.*,
          &mut signatures.*, &mut requiredBodies.*, value, &Option<Shared<Type>>.none(), RejectionCode.TypeMismatch, constraints,
          contractBody, staticBody, unsafeAllowed, false)
        let operand = match move checked {
          Result<BodyNodeId, Shared<Rejection>>.Success {value: node} => node
          Result<BodyNodeId, Shared<Rejection>>.Failure {error} => {
            return Result<bool, Shared<Rejection>>.failResult(move error)
          }
        }
        let operandType = match move bodyExpressionType(List<BodyNode>.asSlice(&nodes.*), &operand) {
          Option<Shared<Type>>.Some {value: selected} => move selected
          Option<Shared<Type>>.None => {
            return Result<bool, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Unsupported, span))
          }
        }
        let copied = match move run copyType(&mut resolver.*, &mut owner.*, &mut dependencies.*, &operandType, constraints, span) {
          Result<bool, Shared<Rejection>>.Success {value: answer} => answer
          Result<bool, Shared<Rejection>>.Failure {error} => { return Result<bool, Shared<Rejection>>.failResult(move error) }
        }
        let operandSpan = run bodySpan(&resolver.source, cursor, value)
        let consumed = match move run consumedPlace(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor, List<BodyNode>.asSlice(&nodes.*), operand, copied, true, operandSpan, span, constraints) {
          Result<Option<BodyConsumedPlace>, Shared<Rejection>>.Success {value: place} => move place
          Result<Option<BodyConsumedPlace>, Shared<Rejection>>.Failure {error} => {
            return Result<bool, Shared<Rejection>>.failResult(move error)
          }
        }
        let node = BodyNodeId {index: List<BodyNode>.length(&nodes.*)}
        run List<BodyNode>.append(&mut nodes.*, BodyNode {
          origin: run originAt(cursor, statement, span),
          kind: BodyNodeKind.Drop {value: operand, consumed: move consumed},
        })
        run List<BodyNodeId>.append(&mut statements.*, node)
  return Result<bool, Shared<Rejection>>.succeed(reachable)
}

effect fn checkWrittenBreak(
  resolver: &mut Resolver,
  module: &ModuleId, cursor: &AuthoredCursor,
  nodes: &mut List<BodyNode>,
  statements: &mut List<BodyNodeId>,
  statement: HirId,
  span: Span,
  initialReachable: bool,
  loopDepth: usize,

) -> Result<bool, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let mut reachable = initialReachable
        if loopDepth == usize.ZERO {
          return Result<bool, Shared<Rejection>>.failResult(
            run reject(&resolver.*, module, RejectionCode.TransferOutsideLoop, span),
          )
        }
        let node = BodyNodeId {index: List<BodyNode>.length(&nodes.*)}
        run List<BodyNode>.append(
          &mut nodes.*,
          BodyNode {origin: run originAt(cursor, statement, span), kind: BodyNodeKind.Break},
        )
        run List<BodyNodeId>.append(&mut statements.*, node)
        reachable = false
  return Result<bool, Shared<Rejection>>.succeed(reachable)
}

effect fn checkWrittenContinue(
  resolver: &mut Resolver,
  module: &ModuleId, cursor: &AuthoredCursor,
  nodes: &mut List<BodyNode>,
  statements: &mut List<BodyNodeId>,
  statement: HirId,
  span: Span,
  initialReachable: bool,
  loopDepth: usize,

) -> Result<bool, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let mut reachable = initialReachable
        if loopDepth == usize.ZERO {
          return Result<bool, Shared<Rejection>>.failResult(
            run reject(&resolver.*, module, RejectionCode.TransferOutsideLoop, span),
          )
        }
        let node = BodyNodeId {index: List<BodyNode>.length(&nodes.*)}
        run List<BodyNode>.append(
          &mut nodes.*,
          BodyNode {origin: run originAt(cursor, statement, span), kind: BodyNodeKind.Continue},
        )
        run List<BodyNodeId>.append(&mut statements.*, node)
        reachable = false
  return Result<bool, Shared<Rejection>>.succeed(reachable)
}

struct WrittenInitializer {
  expression: Option<HirId>,
  span: Span,
}

// A schema header must start with an admitted value constructor. Nominal member shapes are
// checked when the concrete schema is assembled, after forward declarations become available.
fn parameterTypeHead(value: &Type) -> bool {
  return match & value.* {
    Type.Primitive {name} => {
      let spelling = Bytes.asSlice(&name)
      return same(spelling, b"bool") || fixedIntegerName(spelling) || pointerSizedIntegerName(
        spelling,
      )
    }
    Type.String {..} => true
    Type.Array {element, ..} => Shared<Type>.with<bool>(&element, parameterTypeHead)
    Type.Nominal {declaration, ..} => {
      let kind = DeclarationId.kind(&declaration)
      return kind == OwnerKind.Struct || kind == OwnerKind.Enumeration || kind == OwnerKind.Union
    }
    _ => false
  }
}

fn pointerSized(value: &Type) -> bool {
  return match & value.* {
    Type.Primitive {name} => same(Bytes.asSlice(&name), b"usize") || same(
      Bytes.asSlice(&name),
      b"isize",
    )
    _ => false
  }
}

fn initializerValue(answer: &Result<Answer, NoRejection>) -> Option<Shared<StaticData>> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Initializer {value: found}} => Option<
        Shared<StaticData>,
      >.some(Shared<StaticData>.clone(&found))
      _ => Option<Shared<StaticData>>.none()
    }
    Result<Answer, NoRejection>.Failure {error: _} => Option<Shared<StaticData>>.none()
  }
}

// A package parameter declaration that cannot join the parameter schema (SEM0214), with `reason`.
effect fn parameterSchemaRejection(module: &ModuleId, span: Span, reason: &[u8]) -> Shared<Rejection>
! OutOfMemoryError ? &mut Allocator {
  let mut diagnostic = run makeRejection(RejectionCode.InvalidParameterSchema, module, span)
  run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"message"), value: run Bytes.copy(reason)})
  return run Shared<Rejection>.make(move diagnostic)
}

// A package parameter rejection with `code`, whose message names the parameter: `before`, the
// parameter's name, then `after`.
effect fn namedParameterRejection(code: RejectionCode, module: &ModuleId, span: Span, name: &[u8], before: &[u8], after: &[u8])
-> Shared<Rejection> ! OutOfMemoryError ? &mut Allocator {
  let mut diagnostic = run makeRejection(code, module, span)
  let mut message = run Bytes.copy(before)
  run Bytes.append(&mut message, name)
  run Bytes.append(&mut message, after)
  run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"message"), value: move message})
  return run Shared<Rejection>.make(move diagnostic)
}

// MODULE-STATIC-003: a package parameter declared inside a module-level `static if` arm.
effect fn conditionalParameterRejection(module: &ModuleId, span: Span, name: &[u8]) -> Shared<Rejection>
! OutOfMemoryError ? &mut Allocator {
  return run namedParameterRejection(RejectionCode.ConditionalParameter, module, span, name, b"package parameter `",
    b"` is declared inside a module-level `static if`; parameters are fixed before `static if` selects declarations, so a `param` cannot be conditional")
}

// Whether `rejection` is a bare `code` rejection whose message has no argument yet, such as a
// static root that does not have its expected type.
fn bareRejection(rejection: &Shared<Rejection>, code: RejectionCode) -> bool {
  return Shared<Rejection>.with<bool>(rejection, fn(value: &Rejection) -> bool {
    return value.code == code && List<MessageArgument>.length(&value.arguments) == usize.ZERO
  })
}

fn rejectionSpan(rejection: &Shared<Rejection>) -> Span {
  return Shared<Rejection>.with<Span>(rejection, fn(value: &Rejection) -> Span { return value.span })
}

// SEM0086 with its `{detail}`, which says what part of the constant contract the declaration breaks.
effect fn constantRejection(module: &ModuleId, span: Span, detail: &[u8]) -> Shared<Rejection>
! OutOfMemoryError ? &mut Allocator {
  let mut diagnostic = run makeRejection(RejectionCode.InvalidConstant, module, span)
  run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"detail"),
    value: run Bytes.copy(detail)})
  return run Shared<Rejection>.make(move diagnostic)
}

// The SEM0086 detail for a type outside the constant contract, naming the type when it prints.
effect fn constantTypeDetail(viewer: &ModuleId, ty: &Shared<Type>) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut detail = Bytes.make()
  if let Option<Bytes>.Some {value: text} = move run TypeText.display(ty, viewer) {
    detail = run Bytes.copy(b"a constant cannot have type `")
    run Bytes.append(&mut detail, Bytes.asSlice(&text))
    run Bytes.append(&mut detail, b"`")
  } else {
    detail = run Bytes.copy(b"a constant cannot have this type")
  }
  run Bytes.append(&mut detail, b"; its type must be `bool`, `char`, an integer or float primitive, `string`, a fixed array of these, or a struct or enum")
  return move detail
}

// The SEM0086 detail for an initializer whose value is not exactly the declared constant type.
effect fn constantValueDetail(viewer: &ModuleId, ty: &Shared<Type>) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  if let Option<Bytes>.Some {value: text} = move run TypeText.display(ty, viewer) {
    let mut detail = run Bytes.copy(b"the initializer must evaluate at compile time to exactly `")
    run Bytes.append(&mut detail, Bytes.asSlice(&text))
    run Bytes.append(&mut detail, b"`")
    return move detail
  }
  return run Bytes.copy(b"the initializer must evaluate at compile time to exactly the declared type")
}

// A SEM0086 rejection with no detail, located where it was, given the detail `detail`; any other
// rejection is returned unchanged.
effect fn detailedConstantRejection(rejection: Shared<Rejection>, detail: &[u8]) -> Shared<Rejection>
! OutOfMemoryError ? &mut Allocator {
  if !bareRejection(&rejection, RejectionCode.InvalidConstant) { return move rejection }
  let module = Shared<Rejection>.with<ModuleId>(&rejection,
    fn(value: &Rejection) -> ModuleId { return ModuleId.copy(&value.module) })
  return run constantRejection(&module, rejectionSpan(&rejection), detail)
}

effect fn resolveParameterSchema(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  key: Key,
) -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let module = resolvedModule(&resolver.*, key.module)
  let mut dependencies = List<Dependency>.make()
  let declarationAccess139 = declarationPosition(&resolver.*, key)
  let written = run header(&mut resolver.*, &module, declarationAccess139)
  // MODULE-STATIC-003: configuration precedes module selection, so no package parameter is
  // declared inside a module-level `static if` arm.
  let declarationAccess140 = declarationPosition(&resolver.*, key)
  let governing = run armOf(&mut resolver.*, &module, declarationAccess140)
  if let Option<Arm>.Some {..} = &governing {
    let mut span = Span.make(usize.ZERO, usize.ZERO)
    if let Option<HeaderSyntax>.Some {value: syntax} = &written { span = syntax.span }
    let declarationAccessConditional = declarationPosition(&resolver.*, key)
    let mut name = Bytes.make()
    if let Option<DeclarationId>.Some {value: declaration} = move run declarationAt(&mut resolver.*, &module, declarationAccessConditional) {
      name = run DeclarationId.copySpelling(&declaration)
    }
    return run memberRejected(run conditionalParameterRejection(&module, span, Bytes.asSlice(&name)), move dependencies)
  }
  if let Option<HeaderSyntax>.Some {value} = move written {
    if let Node.PackageParameterHeader {isPublic, annotation, ..} = value.header {
      let source = run source(&mut resolver.*, &module)
      let mut hasDefault = false
      let mut hasValidation = false
      if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(
        &resolver.*,
        &source,
        &module,
      ) {
        let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(indexed))
        let declarationAccess141 = declarationPosition(&resolver.*, key)
        if declarationAccess141 < declarations.length {
          let hir = IndexedSource.authored(indexed)
          let declarationAccess142 = declarationPosition(&resolver.*, key)
          if let Node.Declaration {body, ..} = Module.node(hir, declarations[declarationAccess142].local) {
            if let Node.PackageParameterBody {default, validation} = Module.node(hir, body) {
              hasDefault = default.present
              hasValidation = validation.present
            }
          }
        }
      }
      if !isPublic && !hasDefault {
        return run memberRejected(
          run parameterSchemaRejection(&module, value.span, b"a private package parameter needs a default value"),
          move dependencies,
        )
      }
      let noBinders = List<Binder>.make()
      let mut elision = LifetimeElision {
        owner: Option<DeclarationId>.none(),
        nextOrdinal: usize.ZERO,
        output: true,
        resultDefault: Option<Shared<Lifetime>>.some(run Shared<Lifetime>.make(Lifetime.Static)),
        generated: List<Shared<Lifetime>>.make(),
        invocation: false,
        nested: false,
        renumber: List<usize>.make(),
        staticEnvironment: false,
        supplied: Option<List<Argument>>.none(),
        assumptions: Option<List<Constraint>>.none(),
        deferred: Option<List<DeferredBounds>>.none(),
      }
      let resolved = run resolveType(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies,
        key.module,
        annotation,
        List<Binder>.asSlice(&noBinders),
        &mut elision,
      )
      return match move resolved {
        Result<Shared<Type>, Shared<Rejection>>.Success {value: ty} => {
          if Type.hasOpenParameters(&ty) || !Shared<Type>.with<bool>(&ty, parameterTypeHead) {
            return run memberRejected(
              run parameterSchemaRejection(&module, value.span,
                b"a package parameter's type must be bool, an integer, a string, or a fixed array of them"),
              move dependencies,
            )
          }
          let declarationAccess143 = declarationPosition(&resolver.*, key)
          let identity = run declarationAt(&mut resolver.*, &module, declarationAccess143)
          if let Option<DeclarationId>.Some {value: declaration} = move identity {
            return memberSuccess(
              Value.ParameterSchema {
                schema: run Shared<ParameterSchema>.make(
                  ParameterSchema {
                    declaration: move declaration,
                    ty: move ty,
                    isPublic: isPublic,
                    hasDefault: hasDefault,
                    hasValidation: hasValidation,
                    span: value.span,
                  },
                ),
              },
              move dependencies,
            )
          }
          return run memberRejected(
            run reject(&resolver.*, &module, RejectionCode.InvalidParameterSchema, value.span),
            move dependencies,
          )
        }
        Result<Shared<Type>, Shared<Rejection>>.Failure {error} => run memberRejected(
          move error,
          move dependencies,
        )
      }
    }
    return run memberRejected(
      run reject(&resolver.*, &module, RejectionCode.InvalidParameterSchema, value.span),
      move dependencies,
    )
  }
  return run memberRejected(
    run reject(
      &resolver.*,
      &module,
      RejectionCode.InvalidParameterSchema,
      Span.make(usize.ZERO, usize.ZERO),
    ),
    move dependencies,
  )
}

fn selectedParameterSchema(answer: &Result<Answer, NoRejection>) -> Option<Shared<ParameterSchema>> {
  return match &answer.* {
    Result<Answer, NoRejection>.Success {value} => match &value.outcome {
      Outcome.Success {value: Value.ParameterSchema {schema}} => Option<Shared<ParameterSchema>>.some(
        Shared<ParameterSchema>.clone(&schema),
      )
      _ => Option<Shared<ParameterSchema>>.none()
    }
    Result<Answer, NoRejection>.Failure {error: _} => Option<Shared<ParameterSchema>>.none()
  }
}

struct WrittenDefault {
  expression: Option<HirId>,
  span: Span,
}

effect fn parameterDefaultSyntax(
  resolver: &mut Resolver,
  module: &ModuleId,
  ordinal: usize,
  fallback: Span,
) -> WrittenDefault ! Cycle | OutOfMemoryError ? &mut Allocator {
  let answer = run source(&mut resolver.*, module)
  if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(&resolver.*, &answer, module) {
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(indexed))
    if ordinal < declarations.length {
      let hir = IndexedSource.authored(indexed)
      if let Node.Declaration {body, ..} = Module.node(hir, declarations[ordinal].local) {
        if let Node.PackageParameterBody {default, ..} = Module.node(hir, body) {
          if default.present {
            return WrittenDefault {
              expression: Option<HirId>.some(default.id),
              span: Module.span(hir, default.id),
            }
          }
        }
      }
    }
  }
  return WrittenDefault {expression: Option<HirId>.none(), span: fallback}
}

effect fn resolveParameterDefault(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  key: Key,
) -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let module = resolvedModule(&resolver.*, key.module)
  let mut dependencies = List<Dependency>.make()
  let declared = run demandChild(
    &mut resolver.*, &mut owner.*, &mut dependencies,
    Key {
      family: Family.ParameterSchema, module: key.module, name: usize.ZERO,
      declaration: key.declaration, member: usize.ZERO, external: false,
    },
    Span.make(usize.ZERO, usize.ZERO),
  )
  let selected = Shared<Result<Answer, NoRejection>>.with<Option<Shared<ParameterSchema>>>(
    &declared, selectedParameterSchema,
  )
  let schema = match move selected {
    Option<Shared<ParameterSchema>>.Some {value} => move value
    Option<Shared<ParameterSchema>>.None => {
      let rejected = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(
        &declared, answerCause,
      )
      if let Option<Shared<Rejection>>.Some {value} = move rejected {
        return run memberRejected(move value, move dependencies)
      }
      return run memberRejected(
        run reject(&resolver.*, &module, RejectionCode.InvalidParameterSchema, Span.make(usize.ZERO, usize.ZERO)),
        move dependencies,
      )
    }
  }
  let declaredType = Shared<ParameterSchema>.with<Shared<Type>>(
    &schema,
    fn(header: &ParameterSchema) -> Shared<Type> { return Shared<Type>.clone(&header.ty) },
  )
  let fallback = Shared<ParameterSchema>.with<Span>(
    &schema,
    fn(header: &ParameterSchema) -> Span { return header.span },
  )
  let declarationAccess144 = declarationPosition(&resolver.*, key)
  let written = run parameterDefaultSyntax(&mut resolver.*, &module, declarationAccess144, fallback)
  let expression = match move written.expression {
    Option<HirId>.Some {value} => value
    Option<HirId>.None => {
      return run memberRejected(
        run reject(&resolver.*, &module, RejectionCode.InvalidParameterSchema, written.span),
        move dependencies,
      )
    }
  }
  let declarationAccess145 = declarationPosition(&resolver.*, key)
  let evaluated = run staticExpression(
    &mut resolver.*, &mut owner.*, &mut dependencies,
    &module, Option<usize>.some(declarationAccess145), expression,
    StaticRootExpectation.Resolved {ty: Shared<Type>.clone(&declaredType), mismatchCode: RejectionCode.InvalidParameterSchema},
    &[], &[],
  )
  // A default that does not have the parameter's type names the parameter and that type.
  let declaration = Shared<ParameterSchema>.with<DeclarationId>(&schema,
    fn(header: &ParameterSchema) -> DeclarationId { return DeclarationId.copy(&header.declaration) })
  let name = run DeclarationId.copySpelling(&declaration)
  let mut expected = run Bytes.copy(b"` does not have its type")
  if let Option<Bytes>.Some {value: spelled} = move run TypeText.display(&declaredType, &module) {
    run Bytes.append(&mut expected, b" `")
    run Bytes.append(&mut expected, Bytes.asSlice(&spelled))
    run Bytes.append(&mut expected, b"`")
  }
  return match move evaluated {
    Result<Shared<StaticData>, Shared<Rejection>>.Success {value} => {
      if run StaticValue.matchesType(&value, &declaredType) {
        return memberSuccess(
          Value.ParameterDefault {value: move value, span: written.span},
          move dependencies,
        )
      }
      return run memberRejected(
        run namedParameterRejection(RejectionCode.InvalidParameterSchema, &module, written.span, Bytes.asSlice(&name),
          b"the default value of package parameter `", Bytes.asSlice(&expected)),
        move dependencies,
      )
    }
    Result<Shared<StaticData>, Shared<Rejection>>.Failure {error} => {
      if bareRejection(&error, RejectionCode.InvalidParameterSchema) {
        return run memberRejected(
          run namedParameterRejection(RejectionCode.InvalidParameterSchema, &module, rejectionSpan(&error), Bytes.asSlice(&name),
            b"the default value of package parameter `", Bytes.asSlice(&expected)),
          move dependencies,
        )
      }
      return run memberRejected(move error, move dependencies)
    }
  }
}

effect fn resolveConstant(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  key: Key,
) -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let module = resolvedModule(&resolver.*, key.module)
  let mut dependencies = List<Dependency>.make()
  let declarationAccess146 = declarationPosition(&resolver.*, key)
  let written = run header(&mut resolver.*, &module, declarationAccess146)
  let mut span = Span.make(usize.ZERO, usize.ZERO)
  if let Option<HeaderSyntax>.Some {value} = move written {
    span = value.span
    if let Node.ConstantHeader {annotation, ..} = value.header {
      if !annotation.present {
        let mut diagnostic = run makeRejection(RejectionCode.InvalidConstant, &module, value.span)
        run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"detail"),
          value: run Bytes.copy(b"a constant requires a type annotation, as in `const NAME: i32 = 5`")})
        return run memberRejected(run Shared<Rejection>.make(move diagnostic), move dependencies)
      }
      let noBinders = List<Binder>.make()
      // A constant is static data, so an omitted `string` lifetime is `'static`.
      let mut elision = LifetimeElision {
        owner: Option<DeclarationId>.none(),
        nextOrdinal: usize.ZERO,
        output: true,
        resultDefault: Option<Shared<Lifetime>>.some(run Shared<Lifetime>.make(Lifetime.Static)),
        generated: List<Shared<Lifetime>>.make(),
        invocation: false,
        nested: false,
        renumber: List<usize>.make(),
        staticEnvironment: false,
        supplied: Option<List<Argument>>.none(),
        assumptions: Option<List<Constraint>>.none(),
        deferred: Option<List<DeferredBounds>>.none(),
      }
      let resolved = run resolveType(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies,
        key.module,
        annotation.id,
        List<Binder>.asSlice(&noBinders),
        &mut elision,
      )
      return match move resolved {
        Result<Shared<Type>, Shared<Rejection>>.Success {value: ty} => {
          if Shared<Type>.with<bool>(&ty, StaticConstant.typeAllowed) {
            return memberSuccess(Value.Type {resolved: move ty}, move dependencies)
          }
          let mut annotationSpan = value.span
          let annotationSyntax = run typeNode(&mut resolver.*, &module, annotation.id)
          if let Option<HeaderSyntax>.Some {value: typeSyntax} = move annotationSyntax {
            annotationSpan = typeSyntax.span
          }
          let detail = run constantTypeDetail(&module, &ty)
          return run memberRejected(
            run constantRejection(&module, annotationSpan, Bytes.asSlice(&detail)),
            move dependencies,
          )
        }
        Result<Shared<Type>, Shared<Rejection>>.Failure {error} => run memberRejected(
          move error,
          move dependencies,
        )
      }
    }
  }
  // Foreign statics and package parameters are not constants; they stay outside this family.
  return run memberRejected(
    run reject(&resolver.*, &module, RejectionCode.Unsupported, span),
    move dependencies,
  )
}

// Loads `module` and observes `declaration`'s written header and body. A declaration the source
// no longer holds is guarded by the whole file.
effect fn observedWholeDeclaration(resolver: &mut Resolver, module: &ModuleId, declaration: &DeclarationId)
-> Shared<Result<SourceResult, NoRejection>> ! Cycle | OutOfMemoryError ? &mut Allocator {
  let answer = run demandSource(&mut resolver.*, module)
  if recordingUnit(&resolver.*) == usize.MAX { return move answer }
  let mut position = Option<usize>.none()
  if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(&resolver.*, &answer, module) {
    position = ModuleIndex.ordinalOf(IndexedSource.moduleIndex(indexed), declaration)
  }
  if let Option<usize>.Some {value: ordinal} = move position {
    let written = run observedDeclarationIn(&mut resolver.*, module, move answer, ordinal, SourceFacet.Written)
    return run observedDeclarationIn(&mut resolver.*, module, move written, ordinal, SourceFacet.Body)
  }
  drop answer
  return run source(&mut resolver.*, module)
}

effect fn initializerSyntax(
  resolver: &mut Resolver,
  module: &ModuleId,
  ordinal: usize,
  fallback: Span,
) -> WrittenInitializer ! Cycle | OutOfMemoryError ? &mut Allocator {
  // The initializer is the declaration's body, so an edit elsewhere in the file leaves it alone.
  let answer = run observedDeclaration(&mut resolver.*, module, ordinal, SourceFacet.Body)
  let mut lost = true
  if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(&resolver.*, &answer, module) {
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(indexed))
    if ordinal < declarations.length {
      lost = false
      let hir = IndexedSource.authored(indexed)
      if let Node.Declaration {body, ..} = Module.node(hir, declarations[ordinal].local) {
        if let Node.InitializerBody {value} = Module.node(hir, body) {
          if value.present {
            return WrittenInitializer {
              expression: Option<HirId>.some(value.id),
              span: Module.span(hir, value.id),
            }
          }
        }
      }
    }
  }
  // A missing declaration has no body to observe; the whole file guards its return.
  if lost { drop run source(&mut resolver.*, module) }
  return WrittenInitializer {expression: Option<HirId>.none(), span: fallback}
}

effect fn staticSpan(resolver: &mut Resolver, module: &ModuleId, id: HirId) -> Span
! Cycle | OutOfMemoryError
? &mut Allocator {
  let answer = run observedSyntax(&mut resolver.*, module, id)
  if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(&resolver.*, &answer, module) {
    return Module.span(IndexedSource.authored(indexed), id)
  }
  return Span.make(usize.ZERO, usize.ZERO)
}

// A phase-only static value embedded into runtime code. A direct `let` initializer reports the whole
// binding and a direct call argument reports the argument, with the bootstrap's wording; any other
// position stays code-only at the embedded expression. Runtime code is checked before any target is
// selected. The module scan runs only on this rejection path.
effect fn embeddedPhaseRejection(resolver: &mut Resolver, module: &ModuleId, syntax: HirId, span: Span) -> Shared<Rejection>
! Cycle | OutOfMemoryError
? &mut Allocator {
  let mut site = span
  let mut operation: &[u8] = b""
  let answer = run source(&mut resolver.*, module)
  if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(&resolver.*, &answer, module) {
    let hir = IndexedSource.authored(indexed)
    let mut at = usize.ZERO
    while at < Module.length(hir) && operation.length == usize.ZERO {
      let id = HirId {index: at}
      match Module.node(hir, id) {
        Node.BindingStatement {initializer, isStatic, ..} => {
          if !isStatic && initializer.index == syntax.index {
            site = Module.span(hir, id)
            operation = b"runtime binding of a phase-only value"
          }
        }
        Node.CallExpression {arguments, ..} => {
          let mut argument = usize.ZERO
          while argument < arguments.length {
            if Module.child(hir, arguments, argument).index == syntax.index { operation = b"runtime call argument with a phase-only type" }
            argument = argument + usize.ONE
          }
        }
        _ => ()
      }
      at = at + usize.ONE
    }
  }
  let mut diagnostic = run makeRejection(RejectionCode.StaticPhaseViolation, module, site)
  if operation.length > usize.ZERO {
    run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"operation"), value: run Bytes.copy(operation)})
    run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"template"), value: run Bytes.copy(b"2")})
  }
  return run Shared<Rejection>.make(move diagnostic)
}

// A static body's call of an ordinary fn (SEM0176); the report names the callee as written.
effect fn runtimeCallRejection(module: &ModuleId, span: Span) -> Shared<Rejection> ! OutOfMemoryError ? &mut Allocator {
  let mut diagnostic = run makeRejection(RejectionCode.StaticPhaseViolation, module, span)
  run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"template"), value: run Bytes.copy(b"6")})
  return run Shared<Rejection>.make(move diagnostic)
}

// The type-fact key of one canonical constant, or absence when this store has not indexed the
// constant's module and declaration. Its initializer shares the module and declaration ordinals.
effect fn constantKey(resolver: &mut Resolver, declaration: &Shared<DeclarationId>) -> Option<Key>
! Cycle | OutOfMemoryError
? &mut Allocator {
  let moduleOrdinal = Shared<DeclarationId>.with<usize>(declaration, fn(identity: &DeclarationId) -> usize {
    return knownModuleOrdinal(&resolver.*, DeclarationId.moduleId(identity))
  })
  if moduleOrdinal == usize.MAX { return Option<Key>.none() }
  let targetModule = resolvedModule(&resolver.*, moduleOrdinal)
  let family = Shared<DeclarationId>.with<Family>(declaration,
    fn(identity: &DeclarationId) -> Family {
      if DeclarationId.kind(identity) == OwnerKind.PackageParameter { return Family.ParameterSchema }
      return Family.Constant
    })
  let located = run ordinalOfIdentity(&mut resolver.*, &targetModule, declaration)
  if let Option<usize>.Some {value} = move located {
    let declarationRequest = Key {family: family, module: moduleOrdinal, name: usize.ZERO,
      declaration: value, member: usize.ZERO, external: false}
    let selected = run internDeclaration(&mut resolver.*, declarationRequest)
    return Option<Key>.some(selected)
  }
  return Option<Key>.none()
}

// A read of a package parameter the build's schema does not register (SEM0214): only the root
// module of the root package declares parameters. It is reported at the declaration in its own
// module, since `use` locates the read in another module.
effect fn unregisteredParameter(resolver: &mut Resolver, module: &ModuleId, ordinal: usize, identity: &DeclarationId, use: Span)
-> Shared<Rejection> ! Cycle | OutOfMemoryError ? &mut Allocator {
  let mut span = use
  if let Option<HeaderSyntax>.Some {value: written} = move run header(&mut resolver.*, module, ordinal) { span = written.span }
  let mut diagnostic = run makeRejection(RejectionCode.UnregisteredParameter, module, span)
  let mut message = run Bytes.copy(b"package parameter `")
  let name = run DeclarationId.copySpelling(identity)
  run Bytes.append(&mut message, Bytes.asSlice(&name))
  run Bytes.append(&mut message, b"` is not declared in the root package's root module, the only module that may declare `param`")
  run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"message"), value: move message})
  return run Shared<Rejection>.make(move diagnostic)
}

// Reads one effective package value. Overrides stop dependency traversal before its default.
effect fn parameterValue(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, key: Key, span: Span,
) -> Result<Option<Shared<StaticData>>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let module = resolvedModule(&resolver.*, key.module)
  let declarationAccess148 = declarationPosition(&resolver.*, key)
  let identity = match move run declarationAt(&mut resolver.*, &module, declarationAccess148) {
    Option<DeclarationId>.Some {value} => move value
    Option<DeclarationId>.None => {
      return Result<Option<Shared<StaticData>>, Shared<Rejection>>.failResult(
        run reject(&resolver.*, &module, RejectionCode.InvalidParameterSchema, span))
    }
  }
  let declarationAccess149Request = Key {family: Family.ProfileInput, module: key.module, name: usize.ZERO,
      declaration: usize.ZERO, member: usize.ZERO, external: false}
  let declarationAccess149 = run internDeclaration(&mut resolver.*, declarationAccess149Request)
  let observed = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*,
    declarationAccess149, span)
  drop observed
  let mut assembling = false
  let mut unregistered = false
  if let Option<ParameterAssembly>.Some {value: assembly} = &resolver.parameterAssembly {
    assembling = true
    let registered = List<DeclarationId>.asSlice(&assembly.parameters)
    let mut found = false
    let mut at = usize.ZERO
    while at < registered.length {
      if DeclarationId.equals(&registered[at], &identity) { found = true }
      at = at + usize.ONE
    }
    if !found { unregistered = true }
    let bindings = List<ProfileEntry>.asSlice(&assembly.bindings)
    at = usize.ZERO
    while found && at < bindings.length {
      if DeclarationId.equals(&bindings[at].declaration, &identity) {
        return Result<Option<Shared<StaticData>>, Shared<Rejection>>.succeed(
          Option<Shared<StaticData>>.some(Shared<StaticData>.clone(&bindings[at].value)))
      }
      at = at + usize.ONE
    }
  }
  if unregistered {
    return Result<Option<Shared<StaticData>>, Shared<Rejection>>.failResult(
      run unregisteredParameter(&mut resolver.*, &module, declarationAccess148, &identity, span))
  }
  if assembling {
    let answer = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*,
      Key {family: Family.ParameterDefault, module: key.module, name: usize.ZERO,
        declaration: key.declaration, member: usize.ZERO, external: false}, span)
    let rejected = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(&answer, answerCause)
    if let Option<Shared<Rejection>>.Some {value} = move rejected {
      return Result<Option<Shared<StaticData>>, Shared<Rejection>>.failResult(move value)
    }
    return Result<Option<Shared<StaticData>>, Shared<Rejection>>.succeed(
      Shared<Result<Answer, NoRejection>>.with<Option<Shared<StaticData>>>(&answer,
        fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<StaticData>> {
          return match &answer.* {
            Result<Answer, NoRejection>.Success {value} => match &value.outcome {
              Outcome.Success {value: Value.ParameterDefault {value: data, ..}} =>
                Option<Shared<StaticData>>.some(Shared<StaticData>.clone(&data))
              _ => Option<Shared<StaticData>>.none()
            }
            _ => Option<Shared<StaticData>>.none()
          }
        }))
  }
  let mut profiled = false
  if let Option<&FinalProfile>.Some {value: profile} = move selectedProfile(&resolver.*) {
    if let Option<&ProfileEntry>.Some {value: entry} = move FinalProfile.parameter(profile, &identity) {
      return Result<Option<Shared<StaticData>>, Shared<Rejection>>.succeed(
        Option<Shared<StaticData>>.some(Shared<StaticData>.clone(&entry.value)))
    }
    profiled = true
  }
  if profiled {
    return Result<Option<Shared<StaticData>>, Shared<Rejection>>.failResult(
      run unregisteredParameter(&mut resolver.*, &module, declarationAccess148, &identity, span))
  }
  return Result<Option<Shared<StaticData>>, Shared<Rejection>>.failResult(
    run reject(&resolver.*, &module, RejectionCode.ProfileInputUnavailable, span))
}

// One constant's published value from its content-keyed initializer answer. Every reader shares
// that answer and records the same value edge; a rejected initializer rejects the reader. `None`
// means the answer published no value.
effect fn constantInitializer(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  constant: Key,
  span: Span,
) -> Result<Option<Shared<StaticData>>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  if constant.family == Family.ParameterSchema {
    return run parameterValue(&mut resolver.*, &mut owner.*, &mut dependencies.*, constant, span)
  }
  let referenced = run demandChild(
    &mut resolver.*, &mut owner.*, &mut dependencies.*,
    Key {
      family: Family.Initializer, module: constant.module, name: usize.ZERO,
      declaration: constant.declaration, member: usize.ZERO, external: false,
    },
    span,
  )
  let failure = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(
    &referenced, answerCause,
  )
  if let Option<Shared<Rejection>>.Some {value} = move failure {
    return Result<Option<Shared<StaticData>>, Shared<Rejection>>.failResult(move value)
  }
  let value = Shared<Result<Answer, NoRejection>>.with<Option<Shared<StaticData>>>(
    &referenced, initializerValue,
  )
  return Result<Option<Shared<StaticData>>, Shared<Rejection>>.succeed(move value)
}

// A body reads a constant at its declared type alone. Static execution demands the value if it
// reaches the read, and MIR preparation demands it for a runtime body, so an edit to the value
// alone never reruns this body's checking. A package value is the exception: its value comes from
// the selected profile, so a runtime read embeds it now and a missing input rejects at the read.
effect fn constantRead(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  module: &ModuleId,
  declaration: DeclarationId,
  span: Span,
  staticBody: bool,
) -> Result<BodyExpression, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let identity = run Shared<DeclarationId>.make(move declaration)
  if staticBody { return Result<BodyExpression, Shared<Rejection>>.succeed(BodyExpression.Constant {declaration: move identity}) }
  let located = run constantKey(&mut resolver.*, &identity)
  let parameter = match move located {
    Option<Key>.Some {value} => value
    Option<Key>.None => {
      return Result<BodyExpression, Shared<Rejection>>.succeed(BodyExpression.Constant {declaration: move identity})
    }
  }
  if parameter.family != Family.ParameterSchema {
    return Result<BodyExpression, Shared<Rejection>>.succeed(BodyExpression.Constant {declaration: move identity})
  }
  let published = run constantInitializer(&mut resolver.*, &mut owner.*, &mut dependencies.*, parameter, span)
  let selected = match move published {
    Result<Option<Shared<StaticData>>, Shared<Rejection>>.Success {value} => move value
    Result<Option<Shared<StaticData>>, Shared<Rejection>>.Failure {error} => {
      return Result<BodyExpression, Shared<Rejection>>.failResult(move error)
    }
  }
  return match move selected {
    Option<Shared<StaticData>>.Some {value} => Result<BodyExpression, Shared<Rejection>>.succeed(
      BodyExpression.Embedded {value: move value},
    )
    Option<Shared<StaticData>>.None => Result<BodyExpression, Shared<Rejection>>.failResult(
      run reject(&resolver.*, module, RejectionCode.InvalidConstant, span),
    )
  }
}

// The published value of each constant a runtime body reads, demanded for its lowering. Checking
// the body needed only the constants' types; a rejected initializer rejects the lowering.
effect fn bodyConstantValues(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  typed: &Shared<TypedBody>,
) -> Result<List<MirConstantValue>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let mut read = List<Shared<DeclarationId>>.make()
  let count = Shared<TypedBody>.with<usize>(typed, fn(body: &TypedBody) -> usize { return TypedBody.nodeSlice(body).length })
  let mut at = usize.ZERO
  while at < count {
    let named = Shared<TypedBody>.with<Option<Shared<DeclarationId>>>(typed, fn(body: &TypedBody) -> Option<Shared<DeclarationId>> {
      return match &TypedBody.nodeSlice(body)[at].kind {
        BodyNodeKind.Expression {form: BodyExpression.Constant {declaration}, ..} => Option<Shared<DeclarationId>>.some(Shared<DeclarationId>.clone(&declaration))
        _ => Option<Shared<DeclarationId>>.none()
      }
    })
    if let Option<Shared<DeclarationId>>.Some {value: declaration} = move named {
      let listed = List<Shared<DeclarationId>>.asSlice(&read)
      let mut seen = false
      let mut index = usize.ZERO
      while index < listed.length && !seen {
        seen = sameDeclarationShared(&listed[index], &declaration)
        index = index + usize.ONE
      }
      if !seen { run List<Shared<DeclarationId>>.append(&mut read, move declaration) }
    }
    at = at + usize.ONE
  }
  let mut values = List<MirConstantValue>.make()
  let constants = List<Shared<DeclarationId>>.asSlice(&read)
  at = usize.ZERO
  while at < constants.length {
    let located = run constantKey(&mut resolver.*, &constants[at])
    if let Option<Key>.Some {value: constant} = move located {
      let published = run constantInitializer(&mut resolver.*, &mut owner.*, &mut dependencies.*, constant,
        Span.make(usize.ZERO, usize.ZERO))
      match move published {
        Result<Option<Shared<StaticData>>, Shared<Rejection>>.Success {value: Option<Shared<StaticData>>.Some {value}} => {
          run List<MirConstantValue>.append(&mut values, MirConstantValue {declaration: Shared<DeclarationId>.clone(&constants[at]), value: move value})
        }
        Result<Option<Shared<StaticData>>, Shared<Rejection>>.Success {..} => {}
        Result<Option<Shared<StaticData>>, Shared<Rejection>>.Failure {error} => {
          return Result<List<MirConstantValue>, Shared<Rejection>>.failResult(move error)
        }
      }
    }
    at = at + usize.ONE
  }
  return Result<List<MirConstantValue>, Shared<Rejection>>.succeed(move values)
}

// This loan is short: the machine resumes only after the reached constant's query facts
// have been recorded on the same active provider dependency ledger.
effect fn staticResolveNeeded<'source>(
  port: &mut StaticPort<'source>,
  module: &ModuleId,
  declaration: &Shared<DeclarationId>,
  span: Span,
) -> Result<Option<Shared<StaticData>>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let located = run constantKey(&mut port.resolver.*, declaration)
  let constant = match move located {
    Option<Key>.Some {value} => value
    Option<Key>.None => {
      return Result<Option<Shared<StaticData>>, Shared<Rejection>>.failResult(
        run reject(&port.resolver.*, module, RejectionCode.InvalidConstant, span),
      )
    }
  }
  let declared = run demandChild(&mut port.resolver.*, &mut port.query.*, &mut port.dependencies.*, constant, span)
  let referencedType = Shared<Result<Answer, NoRejection>>.with<TypeSelection>(&declared, selectedType)
  if let Option<Shared<Rejection>>.Some {value} = move referencedType.rejected {
    return Result<Option<Shared<StaticData>>, Shared<Rejection>>.failResult(move value)
  }
  return run constantInitializer(&mut port.resolver.*, &mut port.query.*, &mut port.dependencies.*, constant, span)
}

/// Resolves the constant a static evaluation needed and supplies it as a binding. Answers whether
/// a binding was supplied, so the caller can evaluate again.
effect fn supplyNeededConstant<'source>(
  machine: &mut StaticExecution.Machine<'source>,
  bindings: &mut List<StaticBinding>,
  reached: StaticNeeded,
  failedSpan: Span,
) -> Result<bool, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let resolved = run staticResolveNeeded(
    StaticExecution.port(&mut machine.*), &reached.module, &reached.declaration, failedSpan,
  )
  let constant = match move resolved {
    Result<Option<Shared<StaticData>>, Shared<Rejection>>.Success {value} => move value
    Result<Option<Shared<StaticData>>, Shared<Rejection>>.Failure {error} => {
      return Result<bool, Shared<Rejection>>.failResult(move error)
    }
  }
  if let Option<Shared<StaticData>>.Some {value: found} = move constant {
    run List<StaticBinding>.append(
      &mut bindings.*, StaticBinding {
        module: move reached.module, binder: reached.expression, value: move found,
      },
    )
    return Result<bool, Shared<Rejection>>.succeed(true)
  }
  return Result<bool, Shared<Rejection>>.succeed(false)
}

/// Settles a failed static evaluation. Answers `None` after supplying a needed constant, so the
/// caller can evaluate again, and otherwise the rejection that ends evaluation.
effect fn staticEvaluationRejection<'source>(
  machine: &mut StaticExecution.Machine<'source>,
  bindings: &mut List<StaticBinding>,
  module: &ModuleId,
  failure: StaticDiagnostic | OutOfMemoryError,
) -> Option<Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  match move failure {
    StaticDiagnostic {fault, code, span: failedSpan, target: diagnosticTarget, message, origin, byteOffset, rejection, needed, missing, trace} => {
      if let Option<Shared<Rejection>>.Some {value: rejected} = move rejection {
        return Option<Shared<Rejection>>.some(run relocatedStaticRejection(module, move rejected, &trace))
      }
      if let Option<StaticNeeded>.Some {value: reached} = move needed {
        if StaticExecution.steps(&machine.*) >= StaticExecution.stepLimit(&machine.*) {
          let port = StaticExecution.port(&mut machine.*)
          return Option<Shared<Rejection>>.some(
            run rejectStatic(
              &port.resolver.*, module,
              StaticDiagnostic {
                fault: StaticFault.StepLimit, code: b"SEM0179", span: failedSpan,
                target: diagnosticTarget, message: Option<Bytes>.none(), origin: Option<Span>.none(),
                byteOffset: Option<u64>.none(),
                rejection: Option<Shared<Rejection>>.none(),
                needed: Option<StaticNeeded>.none(), missing: Option<StaticExecution.MissingFact>.none(),
                trace: move trace,
              },
            ),
          )
        }
        let supplied = run supplyNeededConstant(&mut machine.*, &mut bindings.*, move reached, failedSpan)
        let bound = match move supplied {
          Result<bool, Shared<Rejection>>.Success {value} => value
          Result<bool, Shared<Rejection>>.Failure {error} => {
            return Option<Shared<Rejection>>.some(move error)
          }
        }
        if bound {
          return Option<Shared<Rejection>>.none()
        }
      }
      let port = StaticExecution.port(&mut machine.*)
      return Option<Shared<Rejection>>.some(
        run rejectStatic(
          &port.resolver.*, module,
          StaticDiagnostic {
            fault: fault, code: code, span: failedSpan, target: diagnosticTarget,
            message: move message, origin: move origin, byteOffset: move byteOffset,
            rejection: Option<Shared<Rejection>>.none(),
            needed: Option<StaticNeeded>.none(), missing: move missing, trace: move trace,
          },
        ),
      )
    }
    OutOfMemoryError {} => { fail OutOfMemoryError {} }
  }
}

effect fn staticExpression(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  module: &ModuleId,
  declaration: Option<usize>,
  id: HirId,
  expectation: StaticRootExpectation,
  binders: &[StaticRootBinder],
  initialBindings: &[StaticBinding],
) -> Result<Shared<StaticData>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let span = run staticSpan(&mut resolver.*, module, id)
  let checkedAnswer = Result<Answer, NoRejection>.succeed(run checkedStaticRoot(
    &mut resolver.*, &mut owner.*, &mut dependencies.*,
    module, move declaration, id, move expectation,
    binders, initialBindings,
  ))
  let checked = match move StaticExecution.checkedRoot(&checkedAnswer) {
    Option<StaticExecution.CheckedRoot>.Some {value} => move value
    Option<StaticExecution.CheckedRoot>.None => {
      if let Option<Shared<Rejection>>.Some {value} = move answerCause(&checkedAnswer) {
        return Result<Shared<StaticData>, Shared<Rejection>>.failResult(move value)
      }
      return Result<Shared<StaticData>, Shared<Rejection>>.failResult(
        run reject(&resolver.*, module, RejectionCode.InvalidConstant, span),
      )
    }
  }
  let target = resolver.target
  let mut machine = run StaticExecution.make(
    inFlightStaticPort(&mut resolver.*, &mut owner.*, &mut dependencies.*),
    module,
    StaticExecution.defaultLimits(),
  )
  let mut bindings = List<StaticBinding>.make()
  let mut copiedBindings = false
  while StaticExecution.steps(&machine) < StaticExecution.stepLimit(&machine) {
    let mut supplied = initialBindings
    if copiedBindings { supplied = List<StaticBinding>.asSlice(&bindings) }
    let outcome = run Effect.result(StaticExecution.evaluate(
      &mut machine, &checked, supplied, id,
    ))
    match move outcome {
      Result<Shared<StaticData>, StaticDiagnostic | OutOfMemoryError>.Success {value} => {
        return Result<Shared<StaticData>, Shared<Rejection>>.succeed(move value)
      }
      Result<Shared<StaticData>, StaticDiagnostic | OutOfMemoryError>.Failure {error: evaluationFailure} => {
        let ended = run staticEvaluationRejection(
          &mut machine, &mut bindings, module, move evaluationFailure,
        )
        if let Option<Shared<Rejection>>.Some {value: rejected} = move ended {
          return Result<Shared<StaticData>, Shared<Rejection>>.failResult(move rejected)
        }
        if !copiedBindings {
          let mut at = usize.ZERO
          while at < initialBindings.length {
            run List<StaticBinding>.append(&mut bindings, StaticBinding {
              module: ModuleId.copy(&initialBindings[at].module), binder: initialBindings[at].binder,
              value: StaticValue.copy(&initialBindings[at].value),
            })
            at = at + usize.ONE
          }
          copiedBindings = true
        }
      }
    }
  }
  let port = StaticExecution.port(&mut machine)
  return Result<Shared<StaticData>, Shared<Rejection>>.failResult(
    run rejectStatic(
      &port.resolver.*, module,
      StaticDiagnostic {
        fault: StaticFault.StepLimit, code: b"SEM0179", span: span,
        target: target, message: Option<Bytes>.none(), origin: Option<Span>.none(),
        byteOffset: Option<u64>.none(),
        rejection: Option<Shared<Rejection>>.none(),
        needed: Option<StaticNeeded>.none(), missing: Option<StaticExecution.MissingFact>.none(),
        trace: List<StaticExecution.TraceStep>.make(),
      },
    ),
  )
}

effect fn resolveInitializer(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  key: Key,
) -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let module = resolvedModule(&resolver.*, key.module)
  let mut dependencies = List<Dependency>.make()
  let declared = run demandChild(
    &mut resolver.*, &mut owner.*, &mut dependencies,
    Key {
      family: Family.Constant, module: key.module, name: usize.ZERO,
      declaration: key.declaration, member: usize.ZERO, external: false,
    },
    Span.make(usize.ZERO, usize.ZERO),
  )
  let selected = Shared<Result<Answer, NoRejection>>.with<TypeSelection>(&declared, selectedType)
  if let Option<Shared<Rejection>>.Some {value} = move selected.rejected {
    return run memberRejected(move value, move dependencies)
  }
  let ty = match move selected.resolved {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => {
      return run memberRejected(
        run reject(&resolver.*, &module, RejectionCode.InvalidConstant, Span.make(usize.ZERO, usize.ZERO)),
        move dependencies,
      )
    }
  }
  let mut fallback = Span.make(usize.ZERO, usize.ZERO)
  let declarationAccess150 = declarationPosition(&resolver.*, key)
  let declaredHeader = run header(&mut resolver.*, &module, declarationAccess150)
  if let Option<HeaderSyntax>.Some {value} = move declaredHeader { fallback = value.span }
  let declarationAccess151 = declarationPosition(&resolver.*, key)
  let written = run initializerSyntax(&mut resolver.*, &module, declarationAccess151, fallback)
  let expression = match move written.expression {
    Option<HirId>.Some {value} => value
    Option<HirId>.None => {
      return run memberRejected(
        run constantRejection(&module, written.span, b"a constant requires an initializer, as in `const NAME: i32 = 5`"),
        move dependencies,
      )
    }
  }
  let declarationAccess152 = declarationPosition(&resolver.*, key)
  let attempted = run staticExpression(
    &mut resolver.*, &mut owner.*, &mut dependencies,
    &module, Option<usize>.some(declarationAccess152), expression,
    StaticRootExpectation.Resolved {ty: Shared<Type>.clone(&ty), mismatchCode: RejectionCode.InvalidConstant},
    &[], &[],
  )
  match move attempted {
    Result<Shared<StaticData>, Shared<Rejection>>.Success {value} => {
      if run StaticConstant.admits(&ty, &value) {
        return memberSuccess(Value.Initializer {value: move value}, move dependencies)
      }
      let mut detail = run constantValueDetail(&module, &ty)
      run Bytes.append(&mut detail, b", holding no references, allocated memory or Drop cleanup")
      return run memberRejected(
        run constantRejection(&module, written.span, Bytes.asSlice(&detail)),
        move dependencies,
      )
    }
    Result<Shared<StaticData>, Shared<Rejection>>.Failure {error} => {
      let detail = run constantValueDetail(&module, &ty)
      return run memberRejected(run detailedConstantRejection(move error, Bytes.asSlice(&detail)), move dependencies)
    }
  }
}

// MODULE-STATIC-002: a module-level `static if` evaluates its condition as an ordinary static
// `bool` expression. Only arms a demand reaches are selected; inactive declarations stay unchecked.
effect fn resolveCondition(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  key: Key,
) -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let module = resolvedModule(&resolver.*, key.module)
  let mut dependencies = List<Dependency>.make()
  let declarationAccess153 = declarationPosition(&resolver.*, key)
  let written = run header(&mut resolver.*, &module, declarationAccess153)
  let mut condition = Option<HirId>.none()
  let mut span = Span.make(usize.ZERO, usize.ZERO)
  if let Option<HeaderSyntax>.Some {value: syntax} = move written {
    span = syntax.span
    if let Node.ConditionalHeader {condition: expression} = syntax.header {
      condition = Option<HirId>.some(expression)
    }
  }
  let root = match move condition {
    Option<HirId>.Some {value} => value
    Option<HirId>.None => {
      return run memberRejected(run reject(&resolver.*, &module, RejectionCode.Unsupported, span), move dependencies)
    }
  }
  let declarationAccess154 = declarationPosition(&resolver.*, key)
  let evaluated = run staticExpression(
    &mut resolver.*, &mut owner.*, &mut dependencies,
    &module, Option<usize>.some(declarationAccess154), root, StaticRootExpectation.Inferred,
    &[], &[],
  )
  let data = match move evaluated {
    Result<Shared<StaticData>, Shared<Rejection>>.Success {value} => move value
    Result<Shared<StaticData>, Shared<Rejection>>.Failure {error} => {
      return run memberRejected(move error, move dependencies)
    }
  }
  let flag = Shared<StaticData>.with<Option<bool>>(&data, fn(fact: &StaticData) -> Option<bool> {
    return match &fact.* {
      StaticData.Boolean {value: answer} => Option<bool>.some(answer)
      _ => Option<bool>.none()
    }
  })
  if let Option<bool>.Some {value: holds} = move flag {
    return memberSuccess(Value.Condition {holds: holds}, move dependencies)
  }
  let conditionSpan = run staticSpan(&mut resolver.*, &module, root)
  return run memberRejected(
    run reject(&resolver.*, &module, RejectionCode.ConditionNotBool, conditionSpan),
    move dependencies,
  )
}

fn checkedRootType(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Body {body, ..}} => Shared<TypedBody>.with<Option<Shared<Type>>>(
        &body,
        fn(checked: &TypedBody) -> Option<Shared<Type>> {
          let root = TypedBody.rootNode(checked)
          let nodes = TypedBody.nodeSlice(checked)
          if root.index < nodes.length {
            if let BodyNodeKind.Expression {ty, ..} = &nodes[root.index].kind {
              return Option<Shared<Type>>.some(Shared<Type>.clone(&ty))
            }
          }
          return Option<Shared<Type>>.none()
        },
      )
      _ => Option<Shared<Type>>.none()
    }
    Result<Answer, NoRejection>.Failure {error: _} => Option<Shared<Type>>.none()
  }
}

fn checkedRootMatches(
  answer: &Result<Answer, NoRejection>,
  declaration: &DeclarationId,
  syntax: HirId, anchor: &Anchor,
) -> bool {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Body {body}} => {
        return Shared<TypedBody>.with<bool>(&body, fn(checked: &TypedBody) -> bool {
          let root = TypedBody.rootNode(checked)
          let nodes = TypedBody.nodeSlice(checked)
          return DeclarationId.equals(TypedBody.declarationId(checked), declaration) &&
            root.index < nodes.length && BodyOrigin.syntax(nodes[root.index].origin, anchor).index == syntax.index
        })
      }
      _ => false
    }
    Result<Answer, NoRejection>.Failure {error: _} => false
  }
}

fn staticParameterPosition(hir: &Module, header: HirId, syntax: HirId) -> Option<usize> {
  if let Option<HirId>.Some {value: contract} = namedCallableContract(hir, header) {
    if let Node.CallableContract {parameters, ..} = Module.node(hir, contract) {
      let mut at = usize.ZERO
      while at < parameters.length {
        let parameter = Module.child(hir, parameters, at)
        if parameter.index == syntax.index {
          if let Node.Parameter {mode, ..} = Module.node(hir, parameter) {
            if mode == ParameterMode.Static {
              return Option<usize>.some(at)
            }
          }
          return Option<usize>.none()
        }
        at = at + usize.ONE
      }
    }
  }
  return Option<usize>.none()
}

fn bareExtentTree(hir: &Module, expression: HirId) -> bool {
  return match Module.node(hir, expression) {
    Node.IntegerLiteral {suffix, ..} => !suffix.present
    Node.InfixExpression {operator, left, right, ..} => {
      if operator != InfixOperator.Add && operator != InfixOperator.Subtract &&
        operator != InfixOperator.Multiply && operator != InfixOperator.Divide &&
        operator != InfixOperator.Remainder && operator != InfixOperator.BitAnd &&
        operator != InfixOperator.BitOr && operator != InfixOperator.BitXor {
        return false
      }
      return bareExtentTree(hir, left) && bareExtentTree(hir, right)
    }
    _ => false
  }
}

effect fn staticRootAnnotationType(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  module: &ModuleId,
  moduleOrdinal: usize,
  declarationOrdinal: usize,
  syntax: HirId,
  genericBinders: &[Binder],
) -> Result<Shared<Type>, Shared<Rejection>> ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut elision = LifetimeElision {
    owner: run declarationAt(&mut resolver.*, module, declarationOrdinal),
    nextOrdinal: genericBinders.length,
    output: false,
    resultDefault: Option<Shared<Lifetime>>.none(),
    generated: List<Shared<Lifetime>>.make(),
    invocation: false,
    nested: false,
    renumber: List<usize>.make(),
    staticEnvironment: false,
    supplied: Option<List<Argument>>.none(),
    assumptions: Option<List<Constraint>>.none(),
    deferred: Option<List<DeferredBounds>>.none(),
  }
  return run resolveType(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies.*,
    moduleOrdinal,
    syntax,
    genericBinders,
    &mut elision,
  )
}

/// Array extents can be checked while their written type is being resolved. The nearest
/// enclosing declaration owns the retained HIR IDs and source observation. Answers `usize.MAX`
/// when no declaration encloses the root.
fn nearestEnclosingDeclaration(hir: &Module, declarations: &[IndexedDeclaration], root: HirId) -> usize {
  let candidateSpan = Module.span(hir, root)
  let mut ordinal = usize.MAX
  let mut at = usize.ZERO
  let mut width = usize.MAX
  while at < declarations.length {
    let span = Module.span(hir, declarations[at].local)
    if span.start <= candidateSpan.start && candidateSpan.end <= span.end && span.end - span.start < width {
      ordinal = at
      width = span.end - span.start
    }
    at = at + usize.ONE
  }
  return ordinal
}

/// Whether a static body may call the declaration, which must itself be `static`.
effect fn staticCallAllowed(resolver: &mut Resolver, calledDeclaration: &DeclarationId) -> bool
! Cycle | OutOfMemoryError
? &mut Allocator {
  let called = DeclarationId.copy(calledDeclaration)
  let targetModuleOrdinal = knownModuleOrdinal(&resolver.*, DeclarationId.moduleId(&called))
  if targetModuleOrdinal == usize.MAX {
    return false
  }
  let targetModule = resolvedModule(&resolver.*, targetModuleOrdinal)
  let sharedCalled = run Shared<DeclarationId>.make(move called)
  let selected = run ordinalOfIdentity(&mut resolver.*, &targetModule, &sharedCalled)
  if let Option<usize>.Some {value: position} = move selected {
    let written = run signatureSyntax(&mut resolver.*, &targetModule, position)
    if let Option<WrittenSignature>.Some {value} = move written {
      return value.isStatic
    }
  }
  return false
}

/// The span of the first node a static body may not contain: a call to an interface operation or
/// declaration that is not `static`.
// A call that a static root cannot make; `ordinary` when it calls an ordinary fn rather than an
// interface operation.
struct StaticCallViolation {span: Span, ordinary: bool}

effect fn staticPhaseViolation(resolver: &mut Resolver, nodes: &[BodyNode], anchor: &Anchor) -> Option<StaticCallViolation>
! Cycle | OutOfMemoryError
? &mut Allocator {
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {form: BodyExpression.InterfaceCall {operation, ..}, ..} = &nodes[at].kind {
      if !run staticCallAllowed(&mut resolver.*, &operation) {
        return Option<StaticCallViolation>.some(StaticCallViolation {span: BodyOrigin.span(nodes[at].origin, anchor), ordinary: false})
      }
    }
    if let BodyNodeKind.Expression {
      form: BodyExpression.DirectCall {declaration: calledDeclaration, ..},
      ..,
    } = &nodes[at].kind {
      let allowed = run staticCallAllowed(&mut resolver.*, &calledDeclaration)
      if !allowed {
        return Option<StaticCallViolation>.some(StaticCallViolation {span: BodyOrigin.span(nodes[at].origin, anchor), ordinary: true})
      }
    }
    at = at + usize.ONE
  }
  return Option<StaticCallViolation>.none()
}

/// Checks only the expression selected for static evaluation. Inactive arms of a mixed body
/// never enter this checker, so they retain static-if selection silence.
// The interface bounds a static root in a function body may assume: the function's own and its
// implementation head's `T: Contract` bounds.
effect fn staticRootBounds(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, module: &ModuleId, moduleOrdinal: usize, declaration: usize)
  -> Result<List<Constraint>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let signatureRequest = Key {
    family: Family.Signature, module: moduleOrdinal, name: usize.ZERO,
    declaration: declaration, member: usize.ZERO, external: false,
  }
  let signatureKey = run internDeclaration(&mut resolver.*, signatureRequest)
  let signature = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, signatureKey, Span.make(usize.ZERO, usize.ZERO))
  if let Option<Shared<Rejection>>.Some {value} = move Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(&signature, answerCause) {
    return Result<List<Constraint>, Shared<Rejection>>.failResult(move value)
  }
  let mut written = List<Constraint>.make()
  let count = Shared<Result<Answer, NoRejection>>.with<usize>(&signature, signatureConstraintCount)
  let mut at = usize.ZERO
  while at < count {
    let selected = Shared<Result<Answer, NoRejection>>.with<Option<Constraint>>(&signature,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Constraint> { return signatureConstraint(answer, at) })
    if let Option<Constraint>.Some {value} = move selected { run List<Constraint>.append(&mut written, move value) }
    at = at + usize.ONE
  }
  let headFailure = run appendHeadBounds(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, moduleOrdinal,
    declaration, false, &mut written)
  if let Option<Shared<Rejection>>.Some {value} = move headFailure {
    return Result<List<Constraint>, Shared<Rejection>>.failResult(move value)
  }
  let mut bounds = List<Constraint>.make()
  let listed = List<Constraint>.asSlice(&written)
  at = usize.ZERO
  while at < listed.length {
    if let Constraint.Conforms {..} = &listed[at] { run List<Constraint>.append(&mut bounds, copyConstraint(&listed[at])) }
    at = at + usize.ONE
  }
  return Result<List<Constraint>, Shared<Rejection>>.succeed(move bounds)
}

// A static root checks first without its function's bounds, so an ordinary root never depends on
// the function's signature, which may itself wait on the body. Only a refused root in a generic
// function's body is checked again under the bounds, as a bounded call or a `static` interface
// operation needs them.
effect fn checkedStaticRoot(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  module: &ModuleId,
  declaration: Option<usize>,
  root: HirId,
  expectation: StaticRootExpectation,
  binders: &[StaticRootBinder],
  bindings: &[StaticBinding],
) -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let retry = match &expectation {
    StaticRootExpectation.Inferred => StaticRootExpectation.Inferred
    StaticRootExpectation.Boolean => StaticRootExpectation.Boolean
    StaticRootExpectation.IntegerExtent => StaticRootExpectation.IntegerExtent
    StaticRootExpectation.Resolved {ty, mismatchCode} => StaticRootExpectation.Resolved {ty: Shared<Type>.clone(&ty), mismatchCode: mismatchCode}
    StaticRootExpectation.Annotation {syntax} => StaticRootExpectation.Annotation {syntax: syntax}
  }
  let again = match &declaration {
    Option<usize>.Some {value} => Option<usize>.some(value)
    Option<usize>.None => Option<usize>.none()
  }
  let unbounded = run checkedStaticRootUnder(&mut resolver.*, &mut owner.*, &mut dependencies.*, module,
    move declaration, root, move expectation, binders, bindings, false)
  if let Option<Shared<Rejection>>.None = move Outcome.cause(&unbounded.outcome) { return move unbounded }
  return run checkedStaticRootUnder(&mut resolver.*, &mut owner.*, &mut dependencies.*, module,
    move again, root, move retry, binders, bindings, true)
}

effect fn checkedStaticRootUnder(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  module: &ModuleId,
  declaration: Option<usize>,
  root: HirId,
  expectation: StaticRootExpectation,
  binders: &[StaticRootBinder],
  bindings: &[StaticBinding],
  bounded: bool,
) -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut sourceAnswer = run demandSource(&mut resolver.*, module)
  let mut writtenCalls = List<CallSyntax>.make()
  let mut rootSpan = Span.make(usize.ZERO, usize.ZERO)
  let mut ordinal = usize.MAX
  let mut extentLiteralTree = false
  // Whether the root sits in a function's body rather than in a header or a type declaration.
  let mut inBody = false
  let mut lost = true
  let mut present = false
  if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(
    &resolver.*,
    &sourceAnswer,
    module,
  ) {
    present = true
    let hir = IndexedSource.authored(indexed)
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(indexed))
    if let Option<usize>.Some {value} = &declaration {
      ordinal = value
    } else {
      ordinal = nearestEnclosingDeclaration(hir, declarations, root)
    }
    lost = ordinal >= declarations.length
  }
  // The root and everything the check reads beside it (the declaration's parameters and the
  // static bindings before the root) sit in its declaration, so the check observes that
  // declaration's written header and body rather than the whole file.
  if lost || recordingUnit(&resolver.*) == usize.MAX {
    sourceAnswer = run source(&mut resolver.*, module)
  } else {
    let loaded = move sourceAnswer
    let written = run observedDeclarationIn(&mut resolver.*, module, move loaded, ordinal, SourceFacet.Written)
    sourceAnswer = run observedDeclarationIn(&mut resolver.*, module, move written, ordinal, SourceFacet.Body)
  }
  if lost && present {
    return run rejectedBody(
      run reject(
        &resolver.*,
        module,
        RejectionCode.Unsupported,
        Span.make(usize.ZERO, usize.ZERO),
      ),
      List<Dependency>.make(),
    )
  }
  if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(
    &resolver.*,
    &sourceAnswer,
    module,
  ) {
    let hir = IndexedSource.authored(indexed)
    extentLiteralTree = bareExtentTree(hir, root)
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(indexed))
    let declarationSpan = Module.span(hir, declarations[ordinal].local)
    rootSpan = Module.span(hir, root)
    if let Node.Declaration {header, body, ..} = Module.node(hir, declarations[ordinal].local) {
      let callable = match Module.node(hir, header) { Node.FunctionHeader {..} => true Node.OperationHeader {..} => true _ => false }
      let bodySpan = Module.span(hir, body)
      inBody = callable && bodySpan.start <= rootSpan.start && rootSpan.end <= bodySpan.end
    }
    if rootSpan.start < declarationSpan.start || rootSpan.end > declarationSpan.end {
      return run rejectedBody(
        run reject(&resolver.*, module, RejectionCode.Unsupported, rootSpan),
        List<Dependency>.make(),
      )
    }
    let mut rootAnnotations = List<HirId>.make()
    run collectCall(hir, root, &mut rootAnnotations, &mut writtenCalls)
  } else {
    return run rejectedBody(
      run reject(
        &resolver.*,
        module,
        RejectionCode.MissingModule,
        Span.make(usize.ZERO, usize.ZERO),
      ),
      List<Dependency>.make(),
    )
  }
  let template = run templateBinders(&mut resolver.*, module, ordinal)
  let genericBinders = match move template {
    Result<List<Binder>, Shared<Rejection>>.Success {value} => move value
    Result<List<Binder>, Shared<Rejection>>.Failure {error} => {
      return run rejectedBody(move error, List<Dependency>.make())
    }
  }
  let moduleOrdinal = run internModule(&mut resolver.*, module)
  // A root in a generic function's body assumes the function's and its implementation head's
  // interface bounds, so it can call a bounded function or a `static` interface operation through
  // them. Only bounds are read: a root never waits on the stored-input premises a body proves.
  let mut constraints = List<Constraint>.make()
  if bounded && inBody && List<Binder>.length(&genericBinders) != usize.ZERO {
    let bounds = match move run staticRootBounds(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, moduleOrdinal, ordinal) {
      Result<List<Constraint>, Shared<Rejection>>.Success {value} => move value
      Result<List<Constraint>, Shared<Rejection>>.Failure {error} => {
        return run rejectedBody(move error, List<Dependency>.make())
      }
    }
    constraints = move bounds
  }
  let mut expected = Option<Shared<Type>>.none()
  let mut rootMismatch = RejectionCode.TypeMismatch
  match move expectation {
    StaticRootExpectation.Inferred => {}
    StaticRootExpectation.Boolean => {
      rootMismatch = RejectionCode.ConditionNotBool
      expected = Option<Shared<Type>>.some(run primitiveType(b"bool"))
    }
    StaticRootExpectation.IntegerExtent => {
      if extentLiteralTree {
        expected = Option<Shared<Type>>.some(run primitiveType(b"u64"))
      }
    }
    StaticRootExpectation.Resolved {ty, mismatchCode} => {
      rootMismatch = mismatchCode
      expected = Option<Shared<Type>>.some(move ty)
    }
    StaticRootExpectation.Annotation {syntax} => {
      rootMismatch = RejectionCode.AssignmentTypeMismatch
      let resolved = run staticRootAnnotationType(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies.*,
        module,
        moduleOrdinal,
        ordinal,
        syntax,
        List<Binder>.asSlice(&genericBinders),
      )
      expected = match move resolved {
        Result<Shared<Type>, Shared<Rejection>>.Success {value} => Option<Shared<Type>>.some(
          move value,
        )
        Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
          return run rejectedBody(move error, List<Dependency>.make())
        }
      }
    }
  }
  let mut resolvedCalls = List<ResolvedCall>.make()
  let calls = List<CallSyntax>.asSlice(&writtenCalls)
  let mut callAt = usize.ZERO
  while callAt < calls.length {
    let result = run callTarget(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies.*,
      module,
      moduleOrdinal,
      &calls[callAt],
      List<Binder>.asSlice(&genericBinders),
      List<Constraint>.asSlice(&constraints),
    )
    run List<ResolvedCall>.append(
      &mut resolvedCalls,
      ResolvedCall {id: calls[callAt].id, result: move result},
    )
    callAt = callAt + usize.ONE
  }
  let opened = run SourceIndex.authoredCursor(&mut resolver.source, &sourceAnswer, module)
  let available = anchoredCursor(&resolver.source, move opened, ordinal)
  let cursor = match move available {
    Option<AuthoredCursor>.Some {value} => move value
    Option<AuthoredCursor>.None => {
      return run rejectedBody(
        run reject(&resolver.*, module, RejectionCode.Unsupported, rootSpan),
        List<Dependency>.make(),
      )
    }
  }
  let rootAnchor = run cursorAnchor(&cursor)
  let mut locals = List<BodyLocal>.make()
  let identity = run declarationAt(&mut resolver.*, module, ordinal)
  let ownerIdentity = match move identity {
    Option<DeclarationId>.Some {value} => move value
    Option<DeclarationId>.None => {
      return run rejectedBody(
        run reject(&resolver.*, module, RejectionCode.Unsupported, rootSpan),
        List<Dependency>.make(),
      )
    }
  }
  let mut binderAt = usize.ZERO
  while binderAt < binders.length {
    let mut syntax = HirId {index: usize.ZERO}
    let mut selectedType = Option<Shared<Type>>.none()
    match & binders[binderAt] {
      StaticRootBinder.Parameter {syntax: parameter} => {
        syntax = parameter
        let mut position = Option<usize>.none()
        if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(
          &resolver.*,
          &sourceAnswer,
          module,
        ) {
          let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(indexed))
          position = staticParameterPosition(
            IndexedSource.authored(indexed),
            declarations[ordinal].header,
            syntax,
          )
        }
        let parameterAt = match move position {
          Option<usize>.Some {value} => value
          Option<usize>.None => {
            return run rejectedBody(
              run reject(
                &resolver.*,
                module,
                RejectionCode.StaticPhaseViolation,
                run bodySpan(&resolver.source, &cursor, syntax),
              ),
              List<Dependency>.make(),
            )
          }
        }
        let declarationAccess155Request = Key {
            family: Family.Signature,
            module: moduleOrdinal,
            name: usize.ZERO,
            declaration: ordinal,
            member: usize.ZERO,
            external: false,
          }
        let declarationAccess155 = run internDeclaration(&mut resolver.*, declarationAccess155Request)
        let signature = run demandChild(
          &mut resolver.*,
          &mut owner.*,
          &mut dependencies.*,
          declarationAccess155,
          rootSpan,
        )
        let failure = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(
          &signature,
          answerCause,
        )
        if let Option<Shared<Rejection>>.Some {value: diagnostic} = move failure {
          return run rejectedBody(move diagnostic, List<Dependency>.make())
        }
        selectedType = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(
          &signature,
          fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> {
            return signatureParameter(answer, parameterAt)
          },
        )
      }
      StaticRootBinder.Iteration {syntax: forStatement, evidence} => {
        let written = run bodyNode(&resolver.source, &cursor, forStatement)
        let mut iterable = HirId {index: usize.MAX}
        let mut body = HirId {index: usize.MAX}
        if let Node.StaticForStatement {binding, iterable: expression, body: block} = written {
          syntax = binding
          iterable = expression
          body = block
        }
        if iterable.index == usize.MAX {
          return run rejectedBody(run reject(&resolver.*, module, RejectionCode.StaticPhaseViolation, rootSpan), List<Dependency>.make())
        }
        let bodyRange = run bodySpan(&resolver.source, &cursor, body)
        if rootSpan.start < bodyRange.start || rootSpan.end > bodyRange.end {
          return run rejectedBody(run reject(&resolver.*, module, RejectionCode.StaticPhaseViolation, rootSpan), List<Dependency>.make())
        }
        let checked = StaticExecution.iterationChecked(&evidence)
        if !Shared<Result<Answer, NoRejection>>.with<bool>(&checked, fn(answer: &Result<Answer, NoRejection>) -> bool {
          return checkedRootMatches(answer, &ownerIdentity, iterable, &rootAnchor)
        }) {
          return run rejectedBody(run reject(&resolver.*, module, RejectionCode.StaticPhaseViolation, rootSpan), List<Dependency>.make())
        }
        selectedType = StaticExecution.iterationType(&evidence)
      }
      StaticRootBinder.Binding {syntax: binding, checked} => {
        syntax = binding
        let mut initializer = HirId {index: usize.MAX}
        let mut annotation = HirId {index: usize.MAX}
        if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(
          &resolver.*,
          &sourceAnswer,
          module,
        ) {
          let hir = IndexedSource.authored(indexed)
          if syntax.index < List<Node>.length(&hir.nodes) {
            if let Node.BindingStatement {isStatic, initializer: written, annotation: declared, ..} = Module.node(
              hir,
              syntax,
            ) {
              if isStatic && Module.span(hir, syntax).end <= rootSpan.start {
                initializer = written
                if declared.present {
                  annotation = declared.id
                }
              }
            }
          }
        }
        if initializer.index == usize.MAX {
          return run rejectedBody(
            run reject(&resolver.*, module, RejectionCode.StaticPhaseViolation, rootSpan),
            List<Dependency>.make(),
          )
        }
        let matches = Shared<Result<Answer, NoRejection>>.with<bool>(
          &checked,
          fn(answer: &Result<Answer, NoRejection>) -> bool {
            return checkedRootMatches(answer, &ownerIdentity, initializer, &rootAnchor)
          },
        )
        if !matches {
          return run rejectedBody(
            run reject(
              &resolver.*,
              module,
              RejectionCode.Unsupported,
              run bodySpan(&resolver.source, &cursor, syntax),
            ),
            List<Dependency>.make(),
          )
        }
        selectedType = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(
          &checked,
          checkedRootType,
        )
        if annotation.index != usize.MAX {
          let resolved = run staticRootAnnotationType(
            &mut resolver.*,
            &mut owner.*,
            &mut dependencies.*,
            module,
            moduleOrdinal,
            ordinal,
            annotation,
            List<Binder>.asSlice(&genericBinders),
          )
          let declaredType = match move resolved {
            Result<Shared<Type>, Shared<Rejection>>.Success {value} => move value
            Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
              return run rejectedBody(move error, List<Dependency>.make())
            }
          }
          let matching = match & selectedType {
            Option<Shared<Type>>.Some {value} => run Type.equalsShared(&value, &declaredType)
            Option<Shared<Type>>.None => false
          }
          if !matching {
            return run rejectedBody(
              run reject(
                &resolver.*,
                module,
                RejectionCode.AssignmentTypeMismatch,
                run bodySpan(&resolver.source, &cursor, annotation),
              ),
              List<Dependency>.make(),
            )
          }
        }
      }
    }
    let ty = match move selectedType {
      Option<Shared<Type>>.Some {value} => move value
      Option<Shared<Type>>.None => {
        return run rejectedBody(
          run reject(&resolver.*, module, RejectionCode.Unsupported, rootSpan),
          List<Dependency>.make(),
        )
      }
    }
    run List<BodyLocal>.append(
      &mut locals,
      BodyLocal {
        origin: run bodyOrigin(&resolver.source, &cursor, syntax),
        ty: move ty,
        mutable: false,
        meetDepth: Option<usize>.none(),
        written: true,
      },
    )
    binderAt = binderAt + usize.ONE
  }
  let mut nodes = List<BodyNode>.make()
  let mut signatureDependencies = List<SignatureDependency>.make()
  let mut requiredBodies = List<DeclarationId>.make()
  let mut request = Request.make()
  let noAnnotations = List<ResolvedAnnotation>.make()
  let unitResult = run Types.intern(Type.Unit)
  let mut statementScope = StatementScope {locals: &mut locals, annotations: List<ResolvedAnnotation>.asSlice(&noAnnotations),
    resultType: &unitResult, loopDepth: usize.ZERO, staticBinders: binders, staticValues: bindings, discarded: HirRef.absent()}
  // A static root is its own body outside every Effect.
  run List<BodyFrame>.append(&mut resolver.*.bodies, BodyFrame {isEffect: false, isTest: false,
    failure: run Types.intern(Type.Union {members: List<Shared<Type>>.make()}),
    requirements: run Shared<Row>.make(Row.empty()), derived: Option<DerivedChannels>.none(),
    occurrences: List<StaticIteration>.make(), staticApplication: Option<Application>.none(), staticPrefixes: List<List<StaticPrefixWork>>.make(), recovered: List<Shared<Rejection>>.make(), failedStatements: List<FailedStatement>.make(), shortened: List<Span>.make(), signature: Option<Shared<Result<Answer, NoRejection>>>.none(), root: true, runOperand: Option<HirId>.none(), naming: Option<AuthoredCursor>.none()})
  let checked = run checkExpression(
    &mut resolver.*,
    &mut owner.*,
    &mut request,
    &mut dependencies.*,
    module,
    &cursor,
    &ownerIdentity,
    &mut statementScope,
    List<ResolvedCall>.asSlice(&resolvedCalls),
    &mut nodes,
    &mut signatureDependencies,
    &mut requiredBodies,
    root,
    &expected, rootMismatch,
    List<Constraint>.asSlice(&constraints),
    false,
    true,
    false,
  )
  let closed = closeBodyFrame(&mut resolver.*)
  let ClosedBody {recovered, shortened} = move closed
  drop statementScope
  let rootNode = match move checked {
    Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
    Result<BodyNodeId, Shared<Rejection>>.Failure {error} => {
      return rejectedBodyDiagnostics(run failedBodyDiagnostics(move recovered, move error), List<Dependency>.make())
    }
  }
  if List<Shared<Rejection>>.length(&recovered) != usize.ZERO { return CompilerBug.panic(b"a checked static root recovered a diagnostic") }
  if List<Span>.length(&shortened) != usize.ZERO { return CompilerBug.panic(b"a static root shortened a call binder") }
  let violation = run staticPhaseViolation(&mut resolver.*, List<BodyNode>.asSlice(&nodes), &run cursorAnchor(&cursor))
  if let Option<StaticCallViolation>.Some {value: violating} = move violation {
    if violating.ordinary {
      return run rejectedBody(run runtimeCallRejection(module, violating.span), List<Dependency>.make())
    }
    return run rejectedBody(
      run reject(&resolver.*, module, RejectionCode.StaticPhaseViolation, violating.span),
      List<Dependency>.make(),
    )
  }
  let indexed = match move sourceOf(&resolver.*, &sourceAnswer, module) {
    Option<&IndexedSource>.Some {value} => value
    Option<&IndexedSource>.None => {
      return run rejectedBody(
        run reject(&resolver.*, module, RejectionCode.Unsupported, rootSpan),
        List<Dependency>.make(),
      )
    }
  }
  let stage = BodyStage.FullyChecked
  let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(indexed))
  let declaration = &declarations[ordinal].identity
  let body = run TypedBody.make(
    declaration,
    move locals,
    move nodes,
    rootNode,
    move signatureDependencies,
    List<DeclarationId>.make(),
    move stage,
    List<StaticIteration>.make(),
  )
  return memberSuccess(
    Value.Body {
      body: run Shared<TypedBody>.make(move body),
    },
    List<Dependency>.make(),
  )
}

// A lowering defect is never a program verdict: stop before the MIR can be cached or emitted.
// Every fact the check reads joins `dependencies`, so a revision that changes one re-verifies
// the body. The check runs only when `selectMirVerification` asked for it (tests and CI), so a
// shipped compiler pays neither its dataflow nor its dependency edges.
effect fn verifyLowered(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, dependencies: &mut List<Dependency>,
  function: &MirFunction) -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  if !resolver.verifyMir { return () }
  if !(run MirVerification.callDestinationsFresh(function)) {
    let mut reason = run Bytes.copy(b"lowered MIR of ")
    let symbol = run InstanceKey.encoding(&function.key)
    run Bytes.append(&mut reason, Bytes.asSlice(&symbol))
    run Bytes.append(&mut reason, b" calls into a destination that is not fresh:")
    let listing = run MirVerification.describe(function)
    run Bytes.append(&mut reason, Bytes.asSlice(&listing))
    return CompilerBug.panic(Bytes.asSlice(&reason))
  }
  let mut found = run unexcusedUses(&mut resolver.*, &mut owner.*, &mut dependencies.*, function)
  if let Option<UseAfterDrop>.Some {value: misuse} = move List<UseAfterDrop>.pop(&mut found) {
    let mut reason = run Bytes.copy(b"lowered MIR of ")
    let symbol = run InstanceKey.encoding(&function.key)
    run Bytes.append(&mut reason, Bytes.asSlice(&symbol))
    run Bytes.append(&mut reason, b" uses storage after the drop of local ")
    run appendDecimal(&mut reason, misuse.dropped)
    run Bytes.append(&mut reason, b" (block ")
    run appendDecimal(&mut reason, misuse.block)
    run Bytes.append(&mut reason, b", statement ")
    run appendDecimal(&mut reason, misuse.statement)
    run Bytes.append(&mut reason, b"):")
    let listing = run MirVerification.describe(function)
    run Bytes.append(&mut reason, Bytes.asSlice(&listing))
    return CompilerBug.panic(Bytes.asSlice(&reason))
  }
}

// The uses after drop in `function` that no semantic fact excuses. A part read after its owner's
// drop is excused when it runs no cleanup and refers to no other storage; a drop that touches a
// view its value holds directly is excused unless the value's type has its own `Drop`. A fact
// that cannot be decided excuses the use: the check reports only what is certain.
effect fn unexcusedUses(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, dependencies: &mut List<Dependency>,
  function: &MirFunction) -> List<UseAfterDrop>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let flows = run callFlows(&mut resolver.*, &mut owner.*, &mut dependencies.*, function)
  let mut found = run MirVerification.useAfterDrop(function, List<Option<List<bool>>>.asSlice(&flows))
  let mut kept = List<UseAfterDrop>.make()
  while List<UseAfterDrop>.length(&found) != usize.ZERO {
    let misuse = match move List<UseAfterDrop>.pop(&mut found) {
      Option<UseAfterDrop>.Some {value} => move value
      Option<UseAfterDrop>.None => { return move kept }
    }
    let mut excused = false
    if let Option<Shared<Type>>.Some {value: part} = &misuse.read {
      if !MirVerification.carriesView(&part) {
        let mut visiting = List<Shared<Type>>.make()
        let premises = List<Constraint>.make()
        excused = match move run cleanupFree(&mut resolver.*, &mut owner.*, &mut dependencies.*, &part, List<Constraint>.asSlice(&premises),
          &mut visiting, Span.make(usize.ZERO, usize.ZERO)) {
          Result<bool, Shared<Rejection>>.Success {value} => value
          Result<bool, Shared<Rejection>>.Failure {..} => true
        }
      }
    }
    if let Option<Shared<Type>>.Some {value: dropped} = &misuse.observer {
      let premises = List<Constraint>.make()
      excused = match move run dropImplementation(&mut resolver.*, &mut owner.*, &mut dependencies.*, &dropped, List<Constraint>.asSlice(&premises)) {
        Result<Option<SealedMatch>, Shared<Rejection>>.Success {value: Option<SealedMatch>.Some {..}} => false
        _ => true
      }
    }
    if !excused { run List<UseAfterDrop>.append(&mut kept, move misuse) }
  }
  return move kept
}

// Per block, which arguments of the call ending it certainly pass a view into its result, read
// from the callee's declared signature; `None` where the signature does not tell, so none does.
// Only a body that drops a temporary has views to carry, so only it reads signatures.
effect fn callFlows(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, dependencies: &mut List<Dependency>,
  function: &MirFunction) -> List<Option<List<bool>>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut flows = List<Option<List<bool>>>.make()
  if !MirVerification.dropsTemporary(function) { return move flows }
  let blocks = List<MirBlock>.asSlice(&function.blocks)
  let mut at = usize.ZERO
  while at < blocks.length {
    let mut flow = Option<List<bool>>.none()
    if let MirTerminator.Call {callee: MirCallee.Instance {key: InstanceKey.Function {application, ..}}, arguments, destination, ..} = &blocks[at].terminator {
      let named = Shared<Application>.with<Option<DeclarationId>>(&application, fn(value: &Application) -> Option<DeclarationId> {
        return match &value.target {
          SpecializationTarget.Named {declaration} => Option<DeclarationId>.some(DeclarationId.copy(&declaration))
          _ => Option<DeclarationId>.none()
        }
      })
      if let Option<DeclarationId>.Some {value: declaration} = move named {
        let module = ModuleId.copy(DeclarationId.moduleId(&declaration))
        let moduleOrdinal = run internModule(&mut resolver.*, &module)
        let identity = run Shared<DeclarationId>.make(move declaration)
        if let Option<usize>.Some {value: ordinal} = move run ordinalOfIdentity(&mut resolver.*, &module, &identity) {
          let request = Key {family: Family.Signature, module: moduleOrdinal, name: usize.ZERO, declaration: ordinal, member: usize.ZERO, external: false}
          let interned = run internDeclaration(&mut resolver.*, request)
          let header = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, interned, Span.make(usize.ZERO, usize.ZERO))
          // A member of an `impl` also assumes the impl's outlives bounds.
          let mut bounds = List<Constraint>.make()
          if let Option<DeclarationId>.Some {value: enclosing} = move run enclosingIdentity(&mut resolver.*, &module, ordinal) {
            if DeclarationId.kind(&enclosing) == OwnerKind.Implementation {
              let parent = run Shared<DeclarationId>.make(move enclosing)
              if let Option<usize>.Some {value: parentOrdinal} = move run ordinalOfIdentity(&mut resolver.*, &module, &parent) {
                let headKey = Key {family: Family.ImplementationHead, module: moduleOrdinal, name: usize.ZERO, declaration: parentOrdinal, member: usize.ZERO, external: false}
                let headInterned = run internDeclaration(&mut resolver.*, headKey)
                let answer = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, headInterned, Span.make(usize.ZERO, usize.ZERO))
                if let Option<Shared<ImplementationHead>>.Some {value: head} = move Shared<Result<Answer, NoRejection>>.with<Option<Shared<ImplementationHead>>>(&answer, headOf) {
                  let count = Shared<ImplementationHead>.with<usize>(&head, fn(value: &ImplementationHead) -> usize { return List<Constraint>.length(&value.binders.constraints) })
                  let mut bound = usize.ZERO
                  while bound < count {
                    run List<Constraint>.append(&mut bounds, Shared<ImplementationHead>.with<Constraint>(&head, fn(value: &ImplementationHead) -> Constraint {
                      let declared = List<Constraint>.asSlice(&value.binders.constraints)
                      return copyConstraint(&declared[bound])
                    }))
                    bound = bound + usize.ONE
                  }
                }
              }
            }
          }
          // A fused `run` of an `effect fn` writes the success value, which only the declared result
          // describes; a call that builds an Effect stores every argument.
          let locals = List<MirLocal>.asSlice(&function.locals)
          let built = Shared<Type>.with<bool>(&locals[destination.local].ty, buildsExecution)
          if List<MirProjection>.length(&destination.projections) == usize.ZERO {
            let next = run signatureFlows(&header, List<MirOperand>.length(&arguments), built, List<Constraint>.asSlice(&bounds))
            flow = move next
          }
        }
      }
    }
    run List<Option<List<bool>>>.append(&mut flows, move flow)
    at = at + usize.ONE
  }
  return move flows
}

// One type parameter a declared type mentions.
struct FlowParameter {
  declaration: DeclarationId,
  ordinal: usize,
}

// Which arguments certainly pass a view of what they borrow into the result, so that using the
// result needs the argument's borrow alive. An Effect the call builds stores every argument. A
// borrowed argument's view sits at its parameter's outer region: it reaches the result when the
// result names that region, or a region a declared outlives bound chain leads it to. An argument
// passed as a bare type parameter reaches a result whose shape names that parameter. Every other
// argument, and every argument of a signature this cannot read, carries nothing, so an uncertain
// view never produces a report.
effect fn signatureFlows(header: &Shared<Result<Answer, NoRejection>>, count: usize, built: bool, assumed: &[Constraint])
-> Option<List<bool>>
! OutOfMemoryError ? &mut Allocator {
  let constructs = Shared<Result<Answer, NoRejection>>.with<bool>(header, signatureIsEffect)
  let variadic = Shared<Result<Answer, NoRejection>>.with<bool>(header, signatureIsVariadic)
  let statics = Shared<Result<Answer, NoRejection>>.with<usize>(header, signatureStaticCount)
  if variadic || statics != usize.ZERO { return Option<List<bool>>.none() }
  let parameters = run signatureParameterTypes(header)
  let declared = List<Shared<Type>>.asSlice(&parameters)
  if declared.length != count { return Option<List<bool>>.none() }
  let mut carried = List<bool>.make()
  let mut at = usize.ZERO
  if constructs && built {
    while at < count {
      run List<bool>.append(&mut carried, true)
      at = at + usize.ONE
    }
    return Option<List<bool>>.some(move carried)
  }
  if built { return Option<List<bool>>.none() }
  let result = match move Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(header, signatureResult) {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => { return Option<List<bool>>.none() }
  }
  let mut produced = List<Shared<Lifetime>>.make()
  run Type.regionAtoms(&result, &mut produced)
  let mut named = List<FlowParameter>.make()
  let shaped = run flowParameters(&mut named, &result)
  // Each declared `'longer: 'shorter`, atom by atom.
  let mut longer = List<Shared<Lifetime>>.make()
  let mut shorter = List<Shared<Lifetime>>.make()
  at = usize.ZERO
  while at < assumed.length {
    run outlivesEdges(&mut longer, &mut shorter, &assumed[at])
    at = at + usize.ONE
  }
  let bounds = Shared<Result<Answer, NoRejection>>.with<usize>(header, signatureConstraintCount)
  at = usize.ZERO
  while at < bounds {
    let bound = Shared<Result<Answer, NoRejection>>.with<Option<Constraint>>(header, fn(answer: &Result<Answer, NoRejection>) -> Option<Constraint> {
      return signatureConstraint(answer, at)
    })
    if let Option<Constraint>.Some {value: constraint} = move bound { run outlivesEdges(&mut longer, &mut shorter, &constraint) }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < declared.length {
    let mut flows = false
    if let Option<Shared<Lifetime>>.Some {value: region} = move Shared<Type>.with<Option<Shared<Lifetime>>>(&declared[at], flowRegion) {
      flows = run regionReaches(&region, List<Shared<Lifetime>>.asSlice(&produced), List<Shared<Lifetime>>.asSlice(&longer),
        List<Shared<Lifetime>>.asSlice(&shorter))
    }
    if let Option<FlowParameter>.Some {value: parameter} = move Shared<Type>.with<Option<FlowParameter>>(&declared[at], flowParameter) {
      flows = shaped && namesParameter(List<FlowParameter>.asSlice(&named), &parameter)
    }
    run List<bool>.append(&mut carried, flows)
    at = at + usize.ONE
  }
  return Option<List<bool>>.some(move carried)
}

effect fn outlivesEdges(longer: &mut List<Shared<Lifetime>>, shorter: &mut List<Shared<Lifetime>>, constraint: &Constraint) -> ()
! OutOfMemoryError ? &mut Allocator {
  if let Constraint.Outlives {longer: from, shorter: to} = &constraint.* {
    let sources = Lifetime.atomCount(&from)
    let targets = Lifetime.atomCount(&to)
    let mut source = usize.ZERO
    while source < sources {
      let mut target = usize.ZERO
      while target < targets {
        run List<Shared<Lifetime>>.append(&mut longer.*, Lifetime.atomAt(&from, source))
        run List<Shared<Lifetime>>.append(&mut shorter.*, Lifetime.atomAt(&to, target))
        target = target + usize.ONE
      }
      source = source + usize.ONE
    }
  }
}

fn listsRegion(regions: &[Shared<Lifetime>], region: &Shared<Lifetime>) -> bool {
  let mut at = usize.ZERO
  while at < regions.length {
    if Lifetime.equalsShared(&regions[at], region) { return true }
    at = at + usize.ONE
  }
  return false
}

// Whether some atom of `region`, or a region declared bounds make it outlive, is named in
// `produced`.
effect fn regionReaches(region: &Shared<Lifetime>, produced: &[Shared<Lifetime>], longer: &[Shared<Lifetime>], shorter: &[Shared<Lifetime>]) -> bool
! OutOfMemoryError ? &mut Allocator {
  let mut reached = List<Shared<Lifetime>>.make()
  let count = Lifetime.atomCount(region)
  let mut at = usize.ZERO
  while at < count {
    let atom = Lifetime.atomAt(region, at)
    if !listsRegion(List<Shared<Lifetime>>.asSlice(&reached), &atom) { run List<Shared<Lifetime>>.append(&mut reached, move atom) }
    at = at + usize.ONE
  }
  let mut next = usize.ZERO
  while next < List<Shared<Lifetime>>.length(&reached) {
    let listed = List<Shared<Lifetime>>.asSlice(&reached)
    let current = Shared<Lifetime>.clone(&listed[next])
    if listsRegion(produced, &current) { return true }
    let mut edge = usize.ZERO
    while edge < longer.length {
      if Lifetime.equalsShared(&longer[edge], &current) && !listsRegion(List<Shared<Lifetime>>.asSlice(&reached), &shorter[edge]) {
        run List<Shared<Lifetime>>.append(&mut reached, Shared<Lifetime>.clone(&shorter[edge]))
      }
      edge = edge + usize.ONE
    }
    next = next + usize.ONE
  }
  return false
}

fn namesParameter(named: &[FlowParameter], parameter: &FlowParameter) -> bool {
  let mut at = usize.ZERO
  while at < named.length {
    if named[at].ordinal == parameter.ordinal && DeclarationId.equals(&named[at].declaration, &parameter.declaration) { return true }
    at = at + usize.ONE
  }
  return false
}

// Whether a call result of this type is an execution value that stores its inputs rather than
// a result computed from them.
fn buildsExecution(value: &Type) -> bool {
  return match &value.* {
    Type.Primitive {..} => false
    Type.Unit => false
    Type.Parameter {..} => false
    Type.String {..} => false
    Type.Reference {..} => false
    Type.Slice {..} => false
    Type.Pointer {..} => false
    Type.Array {..} => false
    Type.Nominal {..} => false
    Type.Union {..} => false
    Type.Anonymous {..} => false
    _ => true
  }
}

// The declared shapes whose type parameters the walk can name.
fn flowShape(value: &Type) -> usize {
  return match &value.* {
    Type.Primitive {..} => usize.ZERO
    Type.Unit => usize.ZERO
    Type.Parameter {..} => usize.ZERO
    Type.String {..} => usize.ZERO
    Type.Reference {..} => usize.ONE
    Type.Slice {..} => usize.ONE
    Type.Array {..} => usize.ONE
    Type.Nominal {..} => usize.ONE
    Type.Union {..} => usize.ONE
    _ => usize.MAX
  }
}

// The outer region of a borrowed parameter.
fn flowRegion(value: &Type) -> Option<Shared<Lifetime>> {
  return match &value.* {
    Type.String {lifetime} => Option<Shared<Lifetime>>.some(Shared<Lifetime>.clone(&lifetime))
    Type.Reference {lifetime, ..} => Option<Shared<Lifetime>>.some(Shared<Lifetime>.clone(&lifetime))
    Type.Slice {lifetime, ..} => Option<Shared<Lifetime>>.some(Shared<Lifetime>.clone(&lifetime))
    _ => Option<Shared<Lifetime>>.none()
  }
}

fn flowParameter(value: &Type) -> Option<FlowParameter> {
  return match &value.* {
    Type.Parameter {declaration, ordinal} => Option<FlowParameter>.some(FlowParameter {declaration: DeclarationId.copy(&declaration), ordinal: ordinal})
    _ => Option<FlowParameter>.none()
  }
}

fn flowChildCount(value: &Type) -> usize {
  return match &value.* {
    Type.Reference {..} => usize.ONE
    Type.Slice {..} => usize.ONE
    Type.Array {..} => usize.ONE
    Type.Nominal {arguments, ..} => List<Argument>.length(&arguments)
    Type.Union {members} => List<Shared<Type>>.length(&members)
    _ => usize.ZERO
  }
}

fn flowChildAt(value: &Type, at: usize) -> Option<Shared<Type>> {
  return match &value.* {
    Type.Reference {referent, ..} => Option<Shared<Type>>.some(Shared<Type>.clone(&referent))
    Type.Slice {element, ..} => Option<Shared<Type>>.some(Shared<Type>.clone(&element))
    Type.Array {element, ..} => Option<Shared<Type>>.some(Shared<Type>.clone(&element))
    Type.Nominal {arguments, ..} => match &List<Argument>.asSlice(&arguments)[at] {
      Argument.Type {value: argument} => Option<Shared<Type>>.some(Shared<Type>.clone(&argument))
      _ => Option<Shared<Type>>.none()
    }
    Type.Union {members} => unionMember(&members, at)
    _ => Option<Shared<Type>>.none()
  }
}

fn unionMember(members: &List<Shared<Type>>, at: usize) -> Option<Shared<Type>> {
  let listed = List<Shared<Type>>.asSlice(members)
  return Option<Shared<Type>>.some(Shared<Type>.clone(&listed[at]))
}

// Appends the type parameters `value` names; false when a part of it is a shape the walk does
// not read, so a parameter it names may be missed.
effect fn flowParameters(named: &mut List<FlowParameter>, value: &Shared<Type>) -> bool ! OutOfMemoryError ? &mut Allocator {
  if Shared<Type>.with<usize>(value, flowShape) == usize.MAX { return false }
  if let Option<FlowParameter>.Some {value: parameter} = move Shared<Type>.with<Option<FlowParameter>>(value, flowParameter) {
    run List<FlowParameter>.append(&mut named.*, move parameter)
  }
  let mut complete = true
  let count = Shared<Type>.with<usize>(value, flowChildCount)
  let mut at = usize.ZERO
  while at < count {
    let child = Shared<Type>.with<Option<Shared<Type>>>(value, fn(node: &Type) -> Option<Shared<Type>> { return flowChildAt(node, at) })
    if let Option<Shared<Type>>.Some {value: nested} = move child {
      if !run flowParameters(&mut named.*, &nested) { complete = false }
    }
    at = at + usize.ONE
  }
  return complete
}

// Marks the lowered function `answer` names live, with the helpers lowered right after it.
fn markLiveMir(resolver: &Resolver, live: &mut List<bool>, answer: &Shared<Result<Answer, NoRejection>>) -> () {
  let index = match move Shared<Result<Answer, NoRejection>>.with<Option<usize>>(answer, answerMirIndex) {
    Option<usize>.Some {value} => value
    Option<usize>.None => { return () }
  }
  let functions = List<MirFunction>.asSlice(&resolver.mirValues)
  let mut marks = List<bool>.asMutSlice(&mut live.*)
  if index >= marks.length { return () }
  marks[index] = true
  let mut at = index + usize.ONE
  while at < marks.length {
    if let InstanceKey.Helper {..} = &functions[at].key {
      marks[at] = true
      at = at + usize.ONE
    } else {
      return ()
    }
  }
  return ()
}

// Drops what a lowered function holds, keeping its key so helper lookups still read it.
fn emptyMir(function: &mut MirFunction) -> () {
  function.parameters = List<Shared<Type>>.make()
  function.locals = List<MirLocal>.make()
  function.blocks = List<MirBlock>.make()
  function.references = List<MirReference>.make()
  function.externs = List<Shared<DeclarationId>>.make()
  function.contexts = List<Mir.ContextText>.make()
  function.traps = List<Mir.TrapSite>.make()
  function.nonParking = List<MirNonParkingRun>.make()
  function.cancels = List<Mir.Cancel>.make()
  function.accesses = List<MirSharedAccess>.make()
  function.escapes = List<MirEscapeSite>.make()
  return ()
}

effect fn storeMir(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, function: MirFunction, dependencies: List<Dependency>) -> Answer
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let mut read = move dependencies
  let mut compacted = move function
  run MirCoalesce.coalesce(&mut compacted)
  run verifyLowered(&mut resolver.*, &mut owner.*, &mut read, &compacted)
  run MirFunction.compact(&mut compacted)
  let function = move compacted
  let index = List<MirFunction>.length(&resolver.mirValues)
  run List<MirFunction>.append(&mut resolver.*.mirValues, move function)
  return memberSuccess(Value.Mir {index: index}, move read)
}

// Helpers follow their creator, where their own queries find them.
effect fn storeLowered(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, lowered: Lowered, dependencies: List<Dependency>) -> Answer
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let Lowered {function, helpers} = move lowered
  let mut read = move dependencies
  let mut coalesced = move helpers
  let mut changed = List<MirFunction>.asMutSlice(&mut coalesced)
  let mut at = usize.ZERO
  while at < changed.length {
    run MirCoalesce.coalesce(&mut changed[at])
    at = at + usize.ONE
  }
  let helpers = move coalesced
  let listed = List<MirFunction>.asSlice(&helpers)
  at = usize.ZERO
  while at < listed.length {
    run verifyLowered(&mut resolver.*, &mut owner.*, &mut read, &listed[at])
    at = at + usize.ONE
  }
  let answer = run storeMir(&mut resolver.*, &mut owner.*, move function, move read)
  let mut pending = move helpers
  while List<MirFunction>.length(&pending) > usize.ZERO {
    let mut helper = List<MirFunction>.remove(&mut pending, usize.ZERO)
    run MirFunction.compact(&mut helper)
    run List<MirFunction>.append(&mut resolver.*.mirValues, move helper)
  }
  return move answer
}

// A helper's MIR is lowered with its creator's; this answer selects it after the creator's.
effect fn resolveHelperMir(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, instance: &InstanceKey,
  creator: &InstanceKey, node: usize, ordinal: usize, purpose: HelperRole, observing: bool) -> Answer
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut dependencies = List<Dependency>.make()
  let identity = InstanceKey.identity(creator)
  let gap = Value.Unsupported {gap: run Shared<BackendGap>.make(BackendGap.make(GapCode.CoreType, &identity, Span.make(usize.ZERO, usize.ZERO)))}
  let location = match move run locationOfInstance(&mut resolver.*, creator) {
    Option<InstanceLocation>.Some {value} => value
    Option<InstanceLocation>.None => { return memberSuccess(move gap, move dependencies) }
  }
  let name = run internBackendInstance(&mut resolver.*, creator, observing)
  let declarationAccess156Request = Key {
    family: Family.Mir, module: location.module, name: name, declaration: location.declaration, member: instanceMember(creator),
    external: false,
  }
  let declarationAccess156 = run internDeclaration(&mut resolver.*, declarationAccess156Request)
  let created = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies, declarationAccess156, Span.make(usize.ZERO, usize.ZERO))
  let selected = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(&created, fn(answer: &Result<Answer, NoRejection>) -> Option<usize> {
    return match & answer.* {
      Result<Answer, NoRejection>.Success {value} => match & value.outcome {
        Outcome.Success {value: Value.Mir {index}} => Option<usize>.some(index)
        _ => Option<usize>.none()
      }
      Result<Answer, NoRejection>.Failure {..} => Option<usize>.none()
    }
  })
  let index = match move selected {
    Option<usize>.Some {value} => value
    Option<usize>.None => { return memberSuccess(move gap, move dependencies) }
  }
  let stored = List<MirFunction>.asSlice(&resolver.mirValues)
  let mut at = index + usize.ONE
  let mut helping = true
  while helping && at < stored.length {
    helping = false
    if let InstanceKey.Helper {node: site, ordinal: position, purpose: selectedPurpose, ..} = &stored[at].key {
      helping = true
      if site == node && position == ordinal && selectedPurpose == purpose && run InstanceKey.sameApplication(&stored[at].key, instance) {
        return memberSuccess(Value.Mir {index: at}, move dependencies)
      }
    }
    at = at + usize.ONE
  }
  return memberSuccess(move gap, move dependencies)
}

// A semantic deferral reached while preparing MIR retains its exact authored diagnostic.
// Genuine errors remain rejected; only the centralized named coverage codes become gaps.
effect fn mirRejection(identity: &Shared<DeclarationId>, diagnostic: Shared<Rejection>, dependencies: List<Dependency>) -> Answer
! OutOfMemoryError ? &mut Allocator {
  let code = Shared<Rejection>.with<Option<GapCode>>(&diagnostic, fn(value: &Rejection) -> Option<GapCode> {
    return BackendGap.forRejection(value.code)
  })
  if let Option<GapCode>.Some {value} = move code {
    return memberSuccess(Value.Unsupported {
      gap: run Shared<BackendGap>.make(BackendGap.fromRejection(value, identity, &diagnostic)),
    }, move dependencies)
  }
  return run memberRejected(move diagnostic, move dependencies)
}

fn bodyCoverageGap(hir: &Module, span: Span) -> GapCode {
  let mut at = usize.ZERO
  while at < Module.length(hir) {
    let id = HirId {index: at}
    let origin = Module.span(hir, id)
    if origin.start == span.start && origin.end == span.end {
      match Module.node(hir, id) {
        // An `effect fn` contract the checker defers (Step 9).
        Node.CallableContract {isEffect, ..} => {
          if isEffect { return GapCode.EffectForm }
        }
        Node.FieldExpression {..} => {
          return GapCode.FieldProjection
        }
        Node.OrdinalExpression {..} => {
          return GapCode.FieldProjection
        }
        Node.IndexExpression {..} => {
          return GapCode.IndexProjection
        }
        _ => ()
      }
    }
    at = at + usize.ONE
  }
  return GapCode.TypedForm
}


// MIR preparation either lacks a lowering form or failed to canonicalize a complete semantic
// region domain. The latter is a source diagnostic, never an invented declaration-level gap.
union PreparationFailure {
  Coverage {code: GapCode},
  Canonicalization {reason: CanonicalizationFailure},
  Rejected {diagnostic: Shared<Rejection>},
}

// Preserve the caller's actual source origin when a complete key cannot be formed.
effect fn preparationAnswer(resolver: &Resolver, identity: &Shared<DeclarationId>, module: &ModuleId,
  span: Span, failure: PreparationFailure, dependencies: List<Dependency>) -> Answer
! OutOfMemoryError ? &mut Allocator {
  return match move failure {
    PreparationFailure.Coverage {code} => memberSuccess(Value.Unsupported {
      gap: run Shared<BackendGap>.make(BackendGap.make(code, identity, span))}, move dependencies)
    PreparationFailure.Canonicalization {..} => run memberRejected(
      run reject(resolver, module, RejectionCode.Unsupported, span), move dependencies)
    PreparationFailure.Rejected {diagnostic} => run memberRejected(move diagnostic, move dependencies)
  }
}

// Generated glue queries cache refusal without a requesting source origin. The actual body or
// worklist caller anchors canonicalization failure when it consumes this completed fact.
// Diagnostics keep the ordinary MIR rule: a backend-category refusal remains a gap carrying it.
effect fn preparationQueryAnswer(identity: &Shared<DeclarationId>, failure: PreparationFailure,
  dependencies: List<Dependency>) -> Answer ! OutOfMemoryError ? &mut Allocator {
  return match move failure {
    PreparationFailure.Coverage {code} => memberSuccess(Value.Unsupported {
      gap: run Shared<BackendGap>.make(BackendGap.make(code, identity, Span.make(usize.ZERO, usize.ZERO)))}, move dependencies)
    PreparationFailure.Canonicalization {reason} => memberSuccess(
      Value.CanonicalizationFailed {reason: reason}, move dependencies)
    PreparationFailure.Rejected {diagnostic} => run mirRejection(identity, move diagnostic, move dependencies)
  }
}

// Root requests have no operand span. In that lane only, locate the authentic original header;
// a missing source identity is an invalid module path, never a fabricated zero-span refusal.
effect fn authoredRequestSpan(resolver: &mut Resolver, sourceOwner: &DeclarationId, span: Span) -> Span
! Cycle | InvalidModulePath | OutOfMemoryError ? &mut Allocator {
  if span.start != usize.ZERO || span.end != usize.ZERO { return span }
  let module = DeclarationId.moduleId(sourceOwner)
  let identity = run Shared<DeclarationId>.make(DeclarationId.copy(sourceOwner))
  let ordinal = match move run ordinalOfIdentity(&mut resolver.*, module, &identity) {
    Option<usize>.Some {value} => value
    _ => { fail InvalidModulePath {} }
  }
  let authored = match move run scopedHeader(&mut resolver.*, module, ordinal) {
    Option<HeaderSyntax>.Some {value} => value
    _ => { fail InvalidModulePath {} }
  }
  return authored.span
}

effect fn canonicalRejection(resolver: &mut Resolver, sourceOwner: &DeclarationId, span: Span) -> Shared<Rejection>
! Cycle | InvalidModulePath | OutOfMemoryError ? &mut Allocator {
  let anchor = run authoredRequestSpan(&mut resolver.*, sourceOwner, span)
  return run reject(&resolver.*, DeclarationId.moduleId(sourceOwner), RejectionCode.Unsupported, anchor)
}

// The query member that selects an instance's MIR producer: an ordinary or selected body, drop
// glue, a C export shim, or a helper.
fn instanceMember(instance: &InstanceKey) -> usize {
  return match &instance.* {
    InstanceKey.Function {..} => usize.ZERO
    InstanceKey.DropGlue {..} => usize.MAX - usize.ONE
    InstanceKey.Export {..} => exportMember()
    InstanceKey.Helper {..} => usize.MAX - 3
  }
}

// The query member of a C export shim; distinct from glue and every selected body.
fn exportMember() -> usize { return usize.MAX - 2 }

// One glue child, or absence when its type mentions no declaration that could own cleanup.
effect fn glueChild(index: usize, ty: &Shared<Type>, sourceOwner: &DeclarationId)
-> Result<Option<GlueChild>, PreparationFailure> ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let keyed = match move run InstanceKey.dropGlue(ty, sourceOwner) {
    Result<Option<InstanceKey>, CanonicalizationFailure>.Success {value} => move value
    Result<Option<InstanceKey>, CanonicalizationFailure>.Failure {error: reason} => {
      return Result<Option<GlueChild>, PreparationFailure>.failResult(PreparationFailure.Canonicalization {reason: reason})
    }
  }
  return match move keyed {
    Option<InstanceKey>.Some {value} => Result<Option<GlueChild>, PreparationFailure>.succeed(
      Option<GlueChild>.some(GlueChild {index: index, ty: Shared<Type>.clone(ty), glue: move value}))
    Option<InstanceKey>.None => Result<Option<GlueChild>, PreparationFailure>.succeed(Option<GlueChild>.none())
  }
}

// Whether a glue child of `ty` runs cleanup: its owned structure carries `impl Drop`.
effect fn glueNeeds(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, dependencies: &mut List<Dependency>,
  ty: &Shared<Type>) -> Result<bool, PreparationFailure>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut visiting = List<Shared<Type>>.make()
  let premises = List<Constraint>.make()
  return match move run cleanupFree(&mut resolver.*, &mut owner.*, &mut dependencies.*, ty, List<Constraint>.asSlice(&premises),
    &mut visiting, Span.make(usize.ZERO, usize.ZERO)) {
    Result<bool, Shared<Rejection>>.Success {value} => Result<bool, PreparationFailure>.succeed(!value)
    Result<bool, Shared<Rejection>>.Failure {error} => Result<bool, PreparationFailure>.failResult(PreparationFailure.Rejected {diagnostic: move error})
  }
}

// Appends the children among `types` that need cleanup, keyed by position. Failure without a
// rejection means one has no glue.
effect fn appendGlueChildren(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, dependencies: &mut List<Dependency>,
  children: &mut List<GlueChild>, types: &[Shared<Type>], sourceOwner: &DeclarationId) -> Result<(), PreparationFailure>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut at = usize.ZERO
  while at < types.length {
    let needed = match move run glueNeeds(&mut resolver.*, &mut owner.*, &mut dependencies.*, &types[at]) {
      Result<bool, PreparationFailure>.Success {value} => value
      Result<bool, PreparationFailure>.Failure {error} => { return Result<(), PreparationFailure>.failResult(move error) }
    }
    if needed {
      let keyedChild = match move run glueChild(at, &types[at], sourceOwner) {
        Result<Option<GlueChild>, PreparationFailure>.Success {value: childKey} => move childKey
        Result<Option<GlueChild>, PreparationFailure>.Failure {error: diagnostic} => {
          return Result<(), PreparationFailure>.failResult(move diagnostic)
        }
      }
      let child = match move keyedChild {
        Option<GlueChild>.Some {value} => move value
        Option<GlueChild>.None => { return Result<(), PreparationFailure>.failResult(PreparationFailure.Coverage {code: GapCode.Cleanup}) }
      }
      run List<GlueChild>.append(&mut children.*, move child)
    }
    at = at + usize.ONE
  }
  return Result<(), PreparationFailure>.succeed(())
}

// Whether a type has no runtime layout (STATIC-009): it mentions a descriptor or StaticSequence, or
// it names a struct or tuple whose fields transitively do. Unions follow once their payloads are
// admitted as static values.
struct PhaseNominal { module: usize, declaration: usize }

effect fn phaseOnlyType(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, ty: &Shared<Type>, span: Span) -> bool
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  if Type.mentionsPhaseOnly(ty) { return true }
  let erased = run internErasedType(&mut resolver.*, ty)
  let declarationAccess157Request = Key {
    family: Family.PhaseOnly, module: usize.ZERO, name: erased, declaration: usize.ZERO, member: usize.ZERO, external: false,
  }
  let declarationAccess157 = run internDeclaration(&mut resolver.*, declarationAccess157Request)
  let answer = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, declarationAccess157, span)
  return Shared<Result<Answer, NoRejection>>.with<bool>(&answer, phaseOnlyHolds)
}

// Walks one type from a fresh root. The walk reads only type structure, never a region, so its
// answer is the same for every type equal to the key's up to lifetime erasure.
effect fn resolvePhaseOnly(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, key: Key) -> Answer
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let types = List<Shared<Type>>.asSlice(&resolver.erasedTypes)
  let ty = Shared<Type>.clone(&types[key.name])
  let mut dependencies = List<Dependency>.make()
  let mut visited = List<PhaseNominal>.make()
  let mut inspected = InspectedApplications {held: List<Shared<Type>>.make(), lookup: InternIndex.make()}
  let holds = run phaseOnlyWithin(&mut resolver.*, &mut owner.*, &mut dependencies, &ty, Span.make(usize.ZERO, usize.ZERO), &mut visited, &mut inspected)
  return memberSuccess(Value.PhaseOnly {holds: holds}, move dependencies)
}

// Application handles one phase-only walk already inspected. Each handle is retained so its
// address stays unique for the walk.
struct InspectedApplications {
  held: List<Shared<Type>>,
  lookup: InternIndex,
}

fn inspectedApplication(inspected: &InspectedApplications, address: usize) -> bool {
  let held = List<Shared<Type>>.asSlice(&inspected.held)
  let mut at = InternIndex.first(&inspected.lookup, usize.toU64(address))
  while at != usize.MAX {
    if Shared<Type>.with<usize>(&held[at], typeAddress) == address { return true }
    at = InternIndex.after(&inspected.lookup, at)
  }
  return false
}

fn phaseOnlyHolds(answer: &Result<Answer, NoRejection>) -> bool {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.PhaseOnly {holds}} => holds
      _ => false
    }
    Result<Answer, NoRejection>.Failure {error: _} => false
  }
}

effect fn phaseOnlyWithin(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, ty: &Shared<Type>, span: Span, visited: &mut List<PhaseNominal>, inspected: &mut InspectedApplications) -> bool
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  if Type.mentionsPhaseOnly(ty) { return true }
  let mut parts = List<Shared<Type>>.make()
  run Type.nominalParts(ty, &mut parts)
  let nominals = List<Shared<Type>>.asSlice(&parts)
  let mut at = usize.ZERO
  while at < nominals.length {
    let part = &nominals[at]
    at = at + usize.ONE
    // Generic arguments and stored fields reach the same application handle along many paths: a
    // field typed by a parameter is the argument's own handle. Inspect each handle once, by
    // address, so a chain of nested wrappers costs one pass per level rather than a structural
    // comparison against every application already seen. The declaration check below bounds the walk.
    let address = Shared<Type>.with<usize>(part, typeAddress)
    if inspectedApplication(&inspected.*, address) { continue }
    let moduleOrdinal = declaringModuleOrdinal(&resolver.*, part)
    if moduleOrdinal == usize.MAX { continue }
    let module = resolvedModule(&resolver.*, moduleOrdinal)
    let declaration = match move run ordinalOfProvider(&mut resolver.*, &module, part) {
      Option<usize>.Some {value} => value
      Option<usize>.None => { continue }
    }
    // Re-expanding a recursive declaration cannot introduce a new field family. Track the
    // declaration rather than its arguments, since `Next<Box<T>>` grows without repeating a type.
    let seen = List<PhaseNominal>.asSlice(&visited.*)
    let mut repeated = false
    let mut seenAt = usize.ZERO
    while seenAt < seen.length && !repeated {
      repeated = seen[seenAt].module == moduleOrdinal && seen[seenAt].declaration == declaration
      seenAt = seenAt + usize.ONE
    }
    if repeated { continue }
    run List<Shared<Type>>.append(&mut inspected.held, Shared<Type>.clone(part))
    run InternIndex.record(&mut inspected.lookup, usize.toU64(address))
    let written = match move run scopedHeader(&mut resolver.*, &module, declaration) {
      Option<HeaderSyntax>.Some {value} => value
      Option<HeaderSyntax>.None => { continue }
    }
    let mut count = usize.MAX
    if let Node.StructHeader {fields, ..} = written.header { count = fields.length }
    if let Node.TupleHeader {elements, ..} = written.header { count = elements.length }
    if count == usize.MAX { continue }
    let depth = List<PhaseNominal>.length(&visited.*)
    run List<PhaseNominal>.append(&mut visited.*, PhaseNominal {module: moduleOrdinal, declaration: declaration})
    let application = run internApplication(&mut resolver.*, part)
    let mut member = usize.ZERO
    while member < count {
      let declarationAccess158Request = Key {
        family: Family.MemberShape, module: moduleOrdinal, name: application, declaration: declaration, member: member, external: false,
      }
      let declarationAccess158 = run internDeclaration(&mut resolver.*, declarationAccess158Request)
      let shaped = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, declarationAccess158, span)
      let shapedField = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(&shaped, singleMemberType)
      if let Option<Shared<Type>>.Some {value: field} = move shapedField {
        if run phaseOnlyWithin(&mut resolver.*, &mut owner.*, &mut dependencies.*, &field, span, &mut visited.*, &mut inspected.*) { return true }
      }
      member = member + usize.ONE
    }
    List<PhaseNominal>.truncate(&mut visited.*, depth)
  }
  return false
}

// The children a value of `ty` cleans after its Drop hook. Failure without a rejection is a cleanup
// form this backend cannot lower yet: an Effect environment, a generic nominal union, or
// a type whose member shapes have no layout.
effect fn glueChildren(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, dependencies: &mut List<Dependency>,
  ty: &Shared<Type>, sourceOwner: &DeclarationId) -> Result<GlueChildren, PreparationFailure>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let unsupported = Result<GlueChildren, PreparationFailure>.failResult(PreparationFailure.Coverage {code: GapCode.Cleanup})
  let node = run Type.copy(ty)
  if let Type.Array {element, ..} = &node {
    let count = match move Type.arrayShape(ty) {
      Option<ArrayShape>.Some {value: shape} => shape.length
      Option<ArrayShape>.None => { return move unsupported }
    }
    let needed = match move run glueNeeds(&mut resolver.*, &mut owner.*, &mut dependencies.*, &element) {
      Result<bool, PreparationFailure>.Success {value} => value
      Result<bool, PreparationFailure>.Failure {error} => { return Result<GlueChildren, PreparationFailure>.failResult(move error) }
    }
    if !needed {
      return Result<GlueChildren, PreparationFailure>.succeed(GlueChildren.Fields {fields: List<GlueChild>.make()})
    }
    let keyedElement = match move run glueChild(usize.ZERO, &element, sourceOwner) {
      Result<Option<GlueChild>, PreparationFailure>.Success {value: childKey} => move childKey
      Result<Option<GlueChild>, PreparationFailure>.Failure {error: diagnostic} => {
        return Result<GlueChildren, PreparationFailure>.failResult(move diagnostic)
      }
    }
    return match move keyedElement {
      Option<GlueChild>.Some {value} => Result<GlueChildren, PreparationFailure>.succeed(GlueChildren.Elements {element: move value, count: count})
      Option<GlueChild>.None => move unsupported
    }
  }
  if let Type.Union {..} = &node {
    let members = match move run Type.canonicalUnionMembers(ty) {
      Option<List<Shared<Type>>>.Some {value} => move value
      Option<List<Shared<Type>>>.None => { return move unsupported }
    }
    let mut children = List<GlueChild>.make()
    let appended = run appendGlueChildren(&mut resolver.*, &mut owner.*, &mut dependencies.*, &mut children, List<Shared<Type>>.asSlice(&members), sourceOwner)
    if let Result<(), PreparationFailure>.Failure {error} = move appended {
      return Result<GlueChildren, PreparationFailure>.failResult(move error)
    }
    return Result<GlueChildren, PreparationFailure>.succeed(GlueChildren.Members {
      members: move children, count: List<Shared<Type>>.length(&members),
    })
  }
  let recordFields = run Type.recordFields(ty)
  if let Option<List<Shared<Type>>>.Some {value: members} = move recordFields {
    let mut children = List<GlueChild>.make()
    let appended = run appendGlueChildren(&mut resolver.*, &mut owner.*, &mut dependencies.*, &mut children, List<Shared<Type>>.asSlice(&members), sourceOwner)
    if let Result<(), PreparationFailure>.Failure {error} = move appended {
      return Result<GlueChildren, PreparationFailure>.failResult(move error)
    }
    return Result<GlueChildren, PreparationFailure>.succeed(GlueChildren.Fields {fields: move children})
  }
  if !Shared<Type>.with<bool>(ty, isNominalType) { return move unsupported }
  let moduleOrdinal = declaringModuleOrdinal(&resolver.*, ty)
  if moduleOrdinal == usize.MAX { return move unsupported }
  let module = resolvedModule(&resolver.*, moduleOrdinal)
  let declaration = match move run ordinalOfProvider(&mut resolver.*, &module, ty) {
    Option<usize>.Some {value} => value
    Option<usize>.None => { return move unsupported }
  }
  let written = match move run header(&mut resolver.*, &module, declaration) {
    Option<HeaderSyntax>.Some {value} => value
    Option<HeaderSyntax>.None => { return move unsupported }
  }
  // A scalar enum is Copy and never admits a Drop hook (ENUM-003).
  if let Node.EnumHeader {..} = written.header {
    return Result<GlueChildren, PreparationFailure>.succeed(GlueChildren.Fields {fields: List<GlueChild>.make()})
  }
  if let Node.UnionHeader {variants, ..} = written.header {
    let nominal = NominalUnion {module: moduleOrdinal, declaration: declaration, count: variants.length}
    let mut listed = List<GlueVariant>.make()
    let mut tag = usize.ZERO
    while tag < nominal.count {
      let shape = match move run variantShape(&mut resolver.*, &mut owner.*, &mut dependencies.*, &module, ty, &nominal, tag, written.span) {
        Result<VariantShape, Shared<Rejection>>.Success {value} => move value
        Result<VariantShape, Shared<Rejection>>.Failure {error} => {
          return Result<GlueChildren, PreparationFailure>.failResult(PreparationFailure.Rejected {diagnostic: move error})
        }
      }
      let mut fields = List<GlueChild>.make()
      let appended = run appendGlueChildren(&mut resolver.*, &mut owner.*, &mut dependencies.*, &mut fields, List<Shared<Type>>.asSlice(&shape.types), sourceOwner)
      if let Result<(), PreparationFailure>.Failure {error} = move appended {
        return Result<GlueChildren, PreparationFailure>.failResult(move error)
      }
      if List<GlueChild>.length(&fields) > usize.ZERO {
        run List<GlueVariant>.append(&mut listed, GlueVariant {tag: tag, fields: move fields})
      }
      tag = tag + usize.ONE
    }
    return Result<GlueChildren, PreparationFailure>.succeed(GlueChildren.Variants {variants: move listed, count: nominal.count})
  }
  let mut count = usize.MAX
  if let Node.StructHeader {fields, ..} = written.header { count = fields.length }
  if let Node.TupleHeader {elements, ..} = written.header { count = elements.length }
  if count == usize.MAX { return move unsupported }
  let application = run internApplication(&mut resolver.*, ty)
  let mut types = List<Shared<Type>>.make()
  let mut at = usize.ZERO
  while at < count {
    let declarationAccess159Request = Key {
      family: Family.MemberShape, module: moduleOrdinal, name: application, declaration: declaration, member: at, external: false,
    }
    let declarationAccess159 = run internDeclaration(&mut resolver.*, declarationAccess159Request)
    let shaped = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, declarationAccess159, written.span)
    let rejected = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(&shaped, answerCause)
    if let Option<Shared<Rejection>>.Some {value} = move rejected {
      return Result<GlueChildren, PreparationFailure>.failResult(PreparationFailure.Rejected {diagnostic: move value})
    }
    let field = match move Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(&shaped, singleMemberType) {
      Option<Shared<Type>>.Some {value} => move value
      Option<Shared<Type>>.None => { return move unsupported }
    }
    run List<Shared<Type>>.append(&mut types, move field)
    at = at + usize.ONE
  }
  let mut children = List<GlueChild>.make()
  let appended = run appendGlueChildren(&mut resolver.*, &mut owner.*, &mut dependencies.*, &mut children, List<Shared<Type>>.asSlice(&types), sourceOwner)
  if let Result<(), PreparationFailure>.Failure {error} = move appended {
    return Result<GlueChildren, PreparationFailure>.failResult(move error)
  }
  return Result<GlueChildren, PreparationFailure>.succeed(GlueChildren.Fields {fields: move children})
}

fn dropMember(answer: &Result<Answer, NoRejection>) -> Option<Shared<DeclarationId>> {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.ImplementationMembers {members}} = &value.outcome {
      let listed = List<ImplementationMember>.asSlice(&members)
      let mut at = usize.ZERO
      while at < listed.length {
        if let ImplementationMember.Inline {declaration, ..} = &listed[at] {
          if Shared<DeclarationId>.with<bool>(&declaration, fn(value: &DeclarationId) -> bool { return DeclarationId.named(value, b"drop") }) {
            return Option<Shared<DeclarationId>>.some(Shared<DeclarationId>.clone(&declaration))
          }
        }
        at = at + usize.ONE
      }
    }
  }
  return Option<Shared<DeclarationId>>.none()
}

// The provider's sealed `impl Drop` head, found through the implementation query of the module
// that may own it rather than by spelling; absence for a type with no hook (DROP-002).
effect fn dropImplementation(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, dependencies: &mut List<Dependency>,
  ty: &Shared<Type>, declared: &[Constraint]) -> Result<Option<SealedMatch>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let span = Span.make(usize.ZERO, usize.ZERO)
  if !Shared<Type>.with<bool>(ty, isNominalType) { return Result<Option<SealedMatch>, Shared<Rejection>>.succeed(Option<SealedMatch>.none()) }
  let moduleOrdinal = declaringModuleOrdinal(&resolver.*, ty)
  if moduleOrdinal == usize.MAX { return Result<Option<SealedMatch>, Shared<Rejection>>.succeed(Option<SealedMatch>.none()) }
  let siteModule = resolvedModule(&resolver.*, moduleOrdinal)
  let declarationAccess160Request = Key {
    family: Family.Implementations, module: moduleOrdinal, name: usize.ZERO, declaration: usize.ZERO, member: usize.ZERO, external: false,
  }
  let declarationAccess160 = run internDeclaration(&mut resolver.*, declarationAccess160Request)
  let listed = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, declarationAccess160, span)
  let failed = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(&listed, answerCause)
  if let Option<Shared<Rejection>>.Some {value} = move failed {
    return Result<Option<SealedMatch>, Shared<Rejection>>.failResult(move value)
  }
  let count = Shared<Result<Answer, NoRejection>>.with<usize>(&listed, implementationCount)
  let mut at = usize.ZERO
  while at < count {
    let candidate = Shared<Result<Answer, NoRejection>>.with<Option<Shared<ImplementationHead>>>(&listed,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<ImplementationHead>> { return implementationAt(answer, at) })
    if let Option<Shared<ImplementationHead>>.Some {value: head} = move candidate {
      let applies = run sealedHeadMatch(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies.*,
        &head,
        ty,
        SealedProperty.Drop,
        declared,
        &siteModule,
        span,
      )
      let matched = match move applies {
        Result<Option<SealedMatch>, Shared<Rejection>>.Success {value} => move value
        Result<Option<SealedMatch>, Shared<Rejection>>.Failure {error} => {
          return Result<Option<SealedMatch>, Shared<Rejection>>.failResult(move error)
        }
      }
      // Coherence admits at most one matching head, so the first match is the hook.
      if let Option<SealedMatch>.Some {value} = move matched {
        return Result<Option<SealedMatch>, Shared<Rejection>>.succeed(Option<SealedMatch>.some(move value))
      }
    }
    at = at + usize.ONE
  }
  return Result<Option<SealedMatch>, Shared<Rejection>>.succeed(Option<SealedMatch>.none())
}

// The instance of the provider's `impl Drop` hook, found through the sealed-property implementation
// query rather than by spelling. The hook's own elided borrow lifetime takes `'static`, which the
// runtime identity erases; the impl's binders come from its exact provider-head match.
effect fn dropHook(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, dependencies: &mut List<Dependency>,
  ty: &Shared<Type>) -> Result<Option<InstanceKey>, PreparationFailure>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let span = Span.make(usize.ZERO, usize.ZERO)
  let declared = List<Constraint>.make()
  let implementation = match move run dropImplementation(&mut resolver.*, &mut owner.*, &mut dependencies.*, ty, List<Constraint>.asSlice(&declared)) {
    Result<Option<SealedMatch>, Shared<Rejection>>.Success {value: found} => match move found {
      Option<SealedMatch>.Some {value} => move value
      Option<SealedMatch>.None => { return Result<Option<InstanceKey>, PreparationFailure>.succeed(Option<InstanceKey>.none()) }
    }
    Result<Option<SealedMatch>, Shared<Rejection>>.Failure {error} => {
      return Result<Option<InstanceKey>, PreparationFailure>.failResult(PreparationFailure.Rejected {diagnostic: move error})
    }
  }
  let moduleOrdinal = declaringModuleOrdinal(&resolver.*, ty)
  let unsupported = Result<Option<InstanceKey>, PreparationFailure>.failResult(PreparationFailure.Coverage {code: GapCode.Cleanup})
  let module = resolvedModule(&resolver.*, moduleOrdinal)
  let implOrdinal = match move run ordinalOfIdentity(&mut resolver.*, &module, &implementation.declaration) {
    Option<usize>.Some {value} => value
    Option<usize>.None => { return move unsupported }
  }
  let declarationAccess161Request = Key {
    family: Family.ImplementationMembers, module: moduleOrdinal, name: usize.ZERO, declaration: implOrdinal, member: usize.ZERO, external: false,
  }
  let declarationAccess161 = run internDeclaration(&mut resolver.*, declarationAccess161Request)
  let members = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, declarationAccess161, span)
  let membersFailed = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(&members, answerCause)
  if let Option<Shared<Rejection>>.Some {value} = move membersFailed {
    return Result<Option<InstanceKey>, PreparationFailure>.failResult(PreparationFailure.Rejected {diagnostic: move value})
  }
  let hook = match move Shared<Result<Answer, NoRejection>>.with<Option<Shared<DeclarationId>>>(&members, dropMember) {
    Option<Shared<DeclarationId>>.Some {value} => DeclarationId.copyShared(&value)
    Option<Shared<DeclarationId>>.None => { return move unsupported }
  }
  let mut request = Request.make()
  let schema = match move run resolveTargetSchema(&mut resolver.*, &mut owner.*, &mut request, &mut dependencies.*, true, &hook, span) {
    Option<TargetSchema>.Some {value} => move value
    Option<TargetSchema>.None => { return move unsupported }
  }
  let slots = List<ApplicationSlot>.asSlice(&schema.own)
  let mut arguments = List<Argument>.make()
  let mut at = usize.ZERO
  while at < slots.length {
    if slots[at].kind != GenericKind.Lifetime { return move unsupported }
    run List<Argument>.append(&mut arguments, Argument.Lifetime {value: run Shared<Lifetime>.make(Lifetime.Static)})
    at = at + usize.ONE
  }
  let mut scopes = List<ScopeBinding>.make()
  let expected = List<ApplicationScope>.asSlice(&schema.scopes)
  at = usize.ZERO
  while at < expected.length {
    let scopeOwner = DeclarationId.copyShared(&expected[at].owner)
    let scopeSlots = List<ApplicationSlot>.asSlice(&expected[at].slots)
    let mut values = List<Argument>.make()
    let mut index = usize.ZERO
    while index < scopeSlots.length {
      let argument = match move bindingArgument(List<Binding>.asSlice(&implementation.bindings), &scopeOwner, scopeSlots[index].ordinal) {
        Option<Argument>.Some {value} => move value
        Option<Argument>.None => { return move unsupported }
      }
      run List<Argument>.append(&mut values, move argument)
      index = index + usize.ONE
    }
    run List<ScopeBinding>.append(&mut scopes, ScopeBinding {
      owner: Shared<DeclarationId>.clone(&expected[at].owner), arguments: move values,
      argumentOrdinals: run applicationOrdinals(scopeSlots),
    })
    at = at + usize.ONE
  }
  let application = Application {target: SpecializationTarget.Named {declaration: move hook}, arguments: move arguments,
    argumentOrdinals: run applicationOrdinals(slots), scopes: move scopes, statics: List<StaticSlot>.make()}
  if !run TargetSchema.accepts(&schema, &application) { return move unsupported }
  let hookKey = match move run InstanceKey.function(move application) {
    Result<InstanceKey, CanonicalizationFailure>.Success {value: canonicalKey} => move canonicalKey
    Result<InstanceKey, CanonicalizationFailure>.Failure {error: reason} => {
      return Result<Option<InstanceKey>, PreparationFailure>.failResult(PreparationFailure.Canonicalization {reason: reason})
    }
  }
  return Result<Option<InstanceKey>, PreparationFailure>.succeed(Option<InstanceKey>.some(move hookKey))
}

// The root and size of one consuming site whose recorded place is a projection, read under a short
// body borrow: its owner local (or MAX), its match subject node (or MAX), its step count and the
// moved value's type.
struct PartialSite {
  local: usize,
  subject: usize,
  steps: usize,
  moved: Shared<Type>,
}

fn consumedOf(kind: &BodyNodeKind) -> Option<&BodyConsumedPlace> {
  return match &kind.* {
    BodyNodeKind.Expression {form, ..} => match &form {
      BodyExpression.Move {consumed, ..} => recordedPlace(&consumed)
      BodyExpression.Match {access, ..} => match &access {
        BodySubjectAccess.Consume {consumed} => recordedPlace(&consumed)
        _ => Option<&BodyConsumedPlace>.none()
      }
      _ => Option<&BodyConsumedPlace>.none()
    }
    BodyNodeKind.Drop {consumed, ..} => recordedPlace(&consumed)
    _ => Option<&BodyConsumedPlace>.none()
  }
}

fn recordedPlace(consumed: &Option<BodyConsumedPlace>) -> Option<&BodyConsumedPlace> {
  return match &consumed.* {
    Option<BodyConsumedPlace>.Some {value} => Option<&BodyConsumedPlace>.some(&value)
    Option<BodyConsumedPlace>.None => Option<&BodyConsumedPlace>.none()
  }
}

fn partialSiteAt(body: &TypedBody, at: usize) -> Option<PartialSite> {
  let nodes = TypedBody.nodeSlice(body)
  let consumed = match move consumedOf(&nodes[at].kind) {
    Option<&BodyConsumedPlace>.Some {value} => value
    Option<&BodyConsumedPlace>.None => { return Option<PartialSite>.none() }
  }
  let steps = List<BodyPlaceStep>.length(&consumed.steps)
  let mut local = usize.MAX
  let mut subject = usize.MAX
  match &consumed.root {
    BodyPlaceRoot.Local {local: root} => { local = root.index }
    BodyPlaceRoot.Subject {subject: root} => { subject = root.index }
  }
  if steps == usize.ZERO { return Option<PartialSite>.none() }
  // A drop's moved value is its operand; a move's or match's is the node's own value.
  let mut typed = at
  if let BodyNodeKind.Drop {value, ..} = &nodes[at].kind { typed = value.index }
  if let BodyNodeKind.Expression {form: BodyExpression.Match {subject: matched, ..}, ..} = &nodes[at].kind { typed = matched.index }
  if let BodyNodeKind.Expression {ty, ..} = &nodes[typed].kind {
    return Option<PartialSite>.some(PartialSite {local: local, subject: subject, steps: steps, moved: Shared<Type>.clone(&ty)})
  }
  return Option<PartialSite>.none()
}

// The arms of a consuming match at node `at`, or zero for any other node.
fn consumingArmCount(body: &TypedBody, at: usize) -> usize {
  let nodes = TypedBody.nodeSlice(body)
  return match &nodes[at].kind {
    BodyNodeKind.Expression {form: BodyExpression.Match {access: BodySubjectAccess.Consume {..}, arms, ..}, ..} => List<BodyMatchArm>.length(&arms)
    _ => usize.ZERO
  }
}

// A by-value binding declared at node `at` that owns a projection of its consumed subject.
fn bindingSiteAt(body: &TypedBody, at: usize) -> Option<PartialSite> {
  let nodes = TypedBody.nodeSlice(body)
  if let BodyNodeKind.Expression {ty, form: BodyExpression.PatternBinding {subject, path, access, ..}} = &nodes[at].kind {
    let steps = List<BodyPlaceStep>.length(&path)
    if access == BodyBindingAccess.Moved && steps != usize.ZERO {
      return Option<PartialSite>.some(PartialSite {local: usize.MAX, subject: subject.index, steps: steps, moved: Shared<Type>.clone(&ty)})
    }
  }
  return Option<PartialSite>.none()
}

fn partialStepAt(body: &TypedBody, at: usize, step: usize) -> Option<BodyPlaceStep> {
  let nodes = TypedBody.nodeSlice(body)
  if let Option<&BodyConsumedPlace>.Some {value: consumed} = move consumedOf(&nodes[at].kind) {
    return copiedStep(List<BodyPlaceStep>.asSlice(&consumed.steps), step)
  }
  if let BodyNodeKind.Expression {form: BodyExpression.PatternBinding {path, ..}, ..} = &nodes[at].kind {
    return copiedStep(List<BodyPlaceStep>.asSlice(&path), step)
  }
  return Option<BodyPlaceStep>.none()
}

fn copiedStep(steps: &[BodyPlaceStep], step: usize) -> Option<BodyPlaceStep> {
  if step >= steps.length { return Option<BodyPlaceStep>.none() }
  return match &steps[step] {
    BodyPlaceStep.Member {tag, ty, source} => Option<BodyPlaceStep>.some(BodyPlaceStep.Member {tag: tag, ty: Shared<Type>.clone(&ty), source: Shared<Type>.clone(&source)})
    BodyPlaceStep.VariantField {tag, field} => Option<BodyPlaceStep>.some(BodyPlaceStep.VariantField {tag: tag, field: field})
    BodyPlaceStep.Field {index} => Option<BodyPlaceStep>.some(BodyPlaceStep.Field {index: index})
    BodyPlaceStep.Element {index} => Option<BodyPlaceStep>.some(BodyPlaceStep.Element {index: index})
  }
}

fn localTypeAt(body: &TypedBody, local: usize) -> Shared<Type> {
  let locals = TypedBody.localSlice(body)
  return Shared<Type>.clone(&locals[local].ty)
}

fn nodeTypeAt(body: &TypedBody, at: usize) -> Option<Shared<Type>> {
  let nodes = TypedBody.nodeSlice(body)
  if let BodyNodeKind.Expression {ty, ..} = &nodes[at].kind { return Option<Shared<Type>>.some(Shared<Type>.clone(&ty)) }
  return Option<Shared<Type>>.none()
}

// The child type one step selects among the children glue would drop, if that child needs cleanup.
fn steppedChild(children: &GlueChildren, step: &BodyPlaceStep) -> Option<Shared<Type>> {
  let listed = match &children.* {
    GlueChildren.Fields {fields} => match &step.* {
      BodyPlaceStep.Field {index} => childType(&fields, index)
      _ => Option<Shared<Type>>.none()
    }
    GlueChildren.Elements {element, ..} => match &step.* {
      BodyPlaceStep.Element {..} => Option<Shared<Type>>.some(Shared<Type>.clone(&element.ty))
      _ => Option<Shared<Type>>.none()
    }
    GlueChildren.Members {members, ..} => match &step.* {
      BodyPlaceStep.Member {tag, ..} => childType(&members, tag)
      _ => Option<Shared<Type>>.none()
    }
    GlueChildren.Variants {variants, ..} => match &step.* {
      BodyPlaceStep.VariantField {tag, field} => {
        let listed = List<GlueVariant>.asSlice(&variants)
        let mut at = usize.ZERO
        while at < listed.length {
          if listed[at].tag == tag { return childType(&listed[at].fields, field) }
          at = at + usize.ONE
        }
        return Option<Shared<Type>>.none()
      }
      _ => Option<Shared<Type>>.none()
    }
  }
  return move listed
}

fn childType(children: &List<GlueChild>, index: usize) -> Option<Shared<Type>> {
  let listed = List<GlueChild>.asSlice(children)
  let mut at = usize.ZERO
  while at < listed.length {
    if listed[at].index == index { return Option<Shared<Type>>.some(Shared<Type>.clone(&listed[at].ty)) }
    at = at + usize.ONE
  }
  return Option<Shared<Type>>.none()
}

effect fn stepProjection(step: &BodyPlaceStep) -> MirProjection ! OutOfMemoryError ? &mut Allocator {
  return match &step.* {
    BodyPlaceStep.Field {index} => MirProjection.Field {index: index}
    BodyPlaceStep.Element {index} => MirProjection.ConstIndex {index: index}
    BodyPlaceStep.Member {tag, ty, ..} => MirProjection.Payload {index: tag, ty: Shared<Type>.clone(&ty)}
    BodyPlaceStep.VariantField {tag, field} => MirProjection.VariantField {variant: tag, field: field}
  }
}

// Cleanup uses the same complete physical union map as payload access and match tags.
effect fn projectedPartialStep(step: &BodyPlaceStep, bindings: &[Binding], projections: &[RuntimeProjection])
  -> Option<BodyPlaceStep> ! OutOfMemoryError ? &mut Allocator | &mut Types {
  match &step.* {
    BodyPlaceStep.Member {tag, source, ..} => {
      let mapped = run UnionProjection.member(&source, tag, bindings, projections)
      return match move mapped {
        Option<UnionProjection.Member>.Some {value} => Option<BodyPlaceStep>.some(
          BodyPlaceStep.Member {tag: value.tag, ty: move value.ty, source: Shared<Type>.clone(&source)})
        _ => Option<BodyPlaceStep>.none()
      }
    }
    BodyPlaceStep.Field {index} => { return Option<BodyPlaceStep>.some(BodyPlaceStep.Field {index: index}) }
    BodyPlaceStep.Element {index} => { return Option<BodyPlaceStep>.some(BodyPlaceStep.Element {index: index}) }
    BodyPlaceStep.VariantField {tag, field} => {
      return Option<BodyPlaceStep>.some(BodyPlaceStep.VariantField {tag: tag, field: field})
    }
  }
}

// For each consuming site that moves a projection needing cleanup, and each by-value binding of a
// consuming match that owns such a projection of its evaluated subject (MATCH-002), the owners its
// path leaves and the children each would still drop. A site whose owners have no recipe gets
// none, and lowering reports the `cleanup` gap there.
effect fn partialRemainders(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, dependencies: &mut List<Dependency>,
  module: &ModuleId, sourceOwner: &DeclarationId, typed: &Shared<TypedBody>, bindings: &[Binding], projections: &[RuntimeProjection], anchor: &Anchor) -> Result<List<Remainder>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut remainders = List<Remainder>.make()
  let count = Shared<TypedBody>.with<usize>(typed, fn(body: &TypedBody) -> usize { return TypedBody.nodeSlice(body).length })
  let mut at = usize.ZERO
  while at < count {
    let site = Shared<TypedBody>.with<Option<PartialSite>>(typed, fn(body: &TypedBody) -> Option<PartialSite> { return partialSiteAt(body, at) })
    if let Option<PartialSite>.Some {value: found} = move site {
      match move run siteRemainder(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, sourceOwner, typed, at, &found, bindings, projections, anchor) {
        Result<Option<Remainder>, Shared<Rejection>>.Success {value} => {
          if let Option<Remainder>.Some {value: remainder} = move value { run List<Remainder>.append(&mut remainders, move remainder) }
        }
        Result<Option<Remainder>, Shared<Rejection>>.Failure {error} => { return Result<List<Remainder>, Shared<Rejection>>.failResult(move error) }
      }
    }
    let arms = Shared<TypedBody>.with<usize>(typed, fn(body: &TypedBody) -> usize { return consumingArmCount(body, at) })
    let mut arm = usize.ZERO
    while arm < arms {
      let mut binding = usize.ZERO
      while true {
        let declaration = match move TypedBody.armBinding(typed, BodyNodeId {index: at}, arm, binding) {
          Option<BodyNodeId>.Some {value} => value
          Option<BodyNodeId>.None => { break }
        }
        let bound = Shared<TypedBody>.with<Option<PartialSite>>(typed, fn(body: &TypedBody) -> Option<PartialSite> { return bindingSiteAt(body, declaration.index) })
        if let Option<PartialSite>.Some {value: found} = move bound {
          match move run siteRemainder(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, sourceOwner, typed, declaration.index, &found, bindings, projections, anchor) {
            Result<Option<Remainder>, Shared<Rejection>>.Success {value} => {
              if let Option<Remainder>.Some {value: remainder} = move value { run List<Remainder>.append(&mut remainders, move remainder) }
            }
            Result<Option<Remainder>, Shared<Rejection>>.Failure {error} => { return Result<List<Remainder>, Shared<Rejection>>.failResult(move error) }
          }
        }
        binding = binding + usize.ONE
      }
      arm = arm + usize.ONE
    }
    at = at + usize.ONE
  }
  return Result<List<Remainder>, Shared<Rejection>>.succeed(move remainders)
}

// The remainder of one site `at` whose moved value needs cleanup, or none when it needs none or its
// owners have no recipe.
effect fn siteRemainder(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, dependencies: &mut List<Dependency>,
  module: &ModuleId, sourceOwner: &DeclarationId, typed: &Shared<TypedBody>, at: usize, found: &PartialSite, bindings: &[Binding], projections: &[RuntimeProjection], anchor: &Anchor)
  -> Result<Option<Remainder>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let declared = List<Constraint>.make()
  let moved = run RuntimeType.applyBindings(&found.moved, bindings, projections)
  let mut visiting = List<Shared<Type>>.make()
  let free = match move run cleanupFree(&mut resolver.*, &mut owner.*, &mut dependencies.*, &moved, List<Constraint>.asSlice(&declared),
    &mut visiting, Span.make(usize.ZERO, usize.ZERO)) {
    Result<bool, Shared<Rejection>>.Success {value} => value
    Result<bool, Shared<Rejection>>.Failure {error} => { return Result<Option<Remainder>, Shared<Rejection>>.failResult(move error) }
  }
  if free { return Result<Option<Remainder>, Shared<Rejection>>.succeed(Option<Remainder>.none()) }
  let local = found.local
  let subject = found.subject
  let mut root = Option<Shared<Type>>.none()
  if local != usize.MAX {
    root = Option<Shared<Type>>.some(Shared<TypedBody>.with<Shared<Type>>(typed, fn(body: &TypedBody) -> Shared<Type> { return localTypeAt(body, local) }))
  } else {
    root = Shared<TypedBody>.with<Option<Shared<Type>>>(typed, fn(body: &TypedBody) -> Option<Shared<Type>> { return nodeTypeAt(body, subject) })
  }
  let written = match move root {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => { return Result<Option<Remainder>, Shared<Rejection>>.succeed(Option<Remainder>.none()) }
  }
  let mut current = run RuntimeType.applyBindings(&written, bindings, projections)
  let mut steps = List<MirProjection>.make()
  let mut levels = List<RemainderLevel>.make()
  let mut step = usize.ZERO
  while step < found.steps {
    let selected = Shared<TypedBody>.with<Option<BodyPlaceStep>>(typed, fn(body: &TypedBody) -> Option<BodyPlaceStep> { return partialStepAt(body, at, step) })
    let path = match move selected {
      Option<BodyPlaceStep>.Some {value} => move value
      Option<BodyPlaceStep>.None => { return Result<Option<Remainder>, Shared<Rejection>>.succeed(Option<Remainder>.none()) }
    }
    let span = Shared<TypedBody>.with<Span>(typed,
      fn(body: &TypedBody) -> Span { return BodyOrigin.span(TypedBody.nodeSlice(body)[at].origin, anchor) })
    let physical = match move run projectedPartialStep(&path, bindings, projections) {
      Option<BodyPlaceStep>.Some {value} => move value
      Option<BodyPlaceStep>.None => {
        return Result<Option<Remainder>, Shared<Rejection>>.failResult(
          run reject(&resolver.*, module, RejectionCode.UnionFormUnavailable, span))
      }
    }
    let hook = match move run dropImplementation(&mut resolver.*, &mut owner.*, &mut dependencies.*, &current, List<Constraint>.asSlice(&declared)) {
      Result<Option<SealedMatch>, Shared<Rejection>>.Success {value} => move value
      Result<Option<SealedMatch>, Shared<Rejection>>.Failure {error} => { return Result<Option<Remainder>, Shared<Rejection>>.failResult(move error) }
    }
    let hooked = match &hook {
      Option<SealedMatch>.Some {..} => true
      Option<SealedMatch>.None => false
    }
    let children = match move run glueChildren(&mut resolver.*, &mut owner.*, &mut dependencies.*, &current,
      sourceOwner) {
      Result<GlueChildren, PreparationFailure>.Success {value} => move value
      Result<GlueChildren, PreparationFailure>.Failure {error} => match move error {
        PreparationFailure.Rejected {diagnostic} => { return Result<Option<Remainder>, Shared<Rejection>>.failResult(move diagnostic) }
        PreparationFailure.Coverage {..} => { return Result<Option<Remainder>, Shared<Rejection>>.succeed(Option<Remainder>.none()) }
        PreparationFailure.Canonicalization {..} => { return Result<Option<Remainder>, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Unsupported, span)) }
      }
    }
    let next = match move steppedChild(&children, &physical) {
      Option<Shared<Type>>.Some {value} => move value
      Option<Shared<Type>>.None => { return Result<Option<Remainder>, Shared<Rejection>>.succeed(Option<Remainder>.none()) }
    }
    run List<MirProjection>.append(&mut steps, run stepProjection(&physical))
    run List<RemainderLevel>.append(&mut levels, RemainderLevel {hooked: hooked, children: move children})
    current = run RuntimeType.project(&next, projections)
    step = step + usize.ONE
  }
  return Result<Option<Remainder>, Shared<Rejection>>.succeed(Option<Remainder>.some(Remainder {node: at, steps: move steps, levels: move levels}))
}

// The glue of one sealed core, following the bootstrap's cleanup: an allocation releases its
// system storage through its reclaim context, a raw buffer releases its allocation without
// discovering elements, and a shared core counts references and cleans its value and control block
// with the last handle.
effect fn resolveCoreGlue(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, dependencies: List<Dependency>,
  instance: InstanceKey, ty: &Shared<Type>, core: SealedKind, observing: bool) -> Answer
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut tracked = move dependencies
  let identity = InstanceKey.identity(&instance)
  let gap = Value.Unsupported {gap: run Shared<BackendGap>.make(BackendGap.make(GapCode.Cleanup, &identity, Span.make(usize.ZERO, usize.ZERO)))}
  let anchor = DeclarationId.copyShared(&identity)
  if core == SealedKind.Allocation {
    let free = run SealedCore.cFunction(&anchor, SealedFunction.Free)
    let function = run DropGlue.lowerCore(move instance, ty, CoreCleanup.Allocation {free: move free}, observing)
    return run storeMir(&mut resolver.*, &mut owner.*, move function, move tracked)
  }
  let allocationType = run SealedCore.allocationBeside(&anchor)
  if core == SealedKind.RawBuffer {
    let allocationKey = match move run glueChild(SealedCore.ordinal(CoreField.BufferAllocation), &allocationType, &anchor) {
      Result<Option<GlueChild>, PreparationFailure>.Success {value: preparedChild} => move preparedChild
      Result<Option<GlueChild>, PreparationFailure>.Failure {error: failure} => {
        return run preparationQueryAnswer(&identity, move failure, move tracked)
      }
    }
    let allocation = match move allocationKey {
      Option<GlueChild>.Some {value} => move value
      Option<GlueChild>.None => { return memberSuccess(move gap, move tracked) }
    }
    let mut fields = List<GlueChild>.make()
    run List<GlueChild>.append(&mut fields, move allocation)
    let function = run DropGlue.lower(DropGlue {key: move instance, ty: Shared<Type>.clone(ty), hook: Option<InstanceKey>.none(),
      children: GlueChildren.Fields {fields: move fields}}, observing)
    return run storeMir(&mut resolver.*, &mut owner.*, move function, move tracked)
  }
  // A package drops its unstarted body, its readiness state and endpoint where they need cleanup,
  // and then releases its handle's authority over its own allocation, which the header holds; the
  // header's result is always moved out.
  if core == SealedKind.ExecutionBlock {
    let listed = match move run SealedCore.fields(ty) {
      Option<List<Shared<Type>>>.Some {value} => move value
      Option<List<Shared<Type>>>.None => { return memberSuccess(move gap, move tracked) }
    }
    let entries = List<Shared<Type>>.asSlice(&listed)
    let mut children = List<Option<GlueChild>>.make()
    let mut field = SealedCore.ordinal(CoreField.PackageBody)
    while field <= SealedCore.ordinal(CoreField.PackageEndpoint) {
      let needed = match move run glueNeeds(&mut resolver.*, &mut owner.*, &mut tracked, &entries[field]) {
        Result<bool, PreparationFailure>.Success {value} => value
        Result<bool, PreparationFailure>.Failure {error} => { return run preparationQueryAnswer(&identity, move error, move tracked) }
      }
      let mut prepared = Option<GlueChild>.none()
      if needed {
        prepared = match move run glueChild(field, &entries[field], &anchor) {
          Result<Option<GlueChild>, PreparationFailure>.Success {value: preparedChild} => move preparedChild
          Result<Option<GlueChild>, PreparationFailure>.Failure {error: failure} => {
            return run preparationQueryAnswer(&identity, move failure, move tracked)
          }
        }
      }
      run List<Option<GlueChild>>.append(&mut children, move prepared)
      field = field + usize.ONE
    }
    let selected = match move run glueChild(SealedCore.ordinal(CoreField.HeaderAllocation), &allocationType, &anchor) {
      Result<Option<GlueChild>, PreparationFailure>.Success {value} => move value
      Result<Option<GlueChild>, PreparationFailure>.Failure {error: failure} => {
        return run preparationQueryAnswer(&identity, move failure, move tracked)
      }
    }
    let allocation = match move selected {
      Option<GlueChild>.Some {value: child} => move child
      Option<GlueChild>.None => { return memberSuccess(move gap, move tracked) }
    }
    let endpoint = List<Option<GlueChild>>.remove(&mut children, 2)
    let ready = List<Option<GlueChild>>.remove(&mut children, usize.ONE)
    let unstarted = List<Option<GlueChild>>.remove(&mut children, usize.ZERO)
    let function = run DropGlue.lowerCore(move instance, ty, CoreCleanup.Package {body: move unstarted, ready: move ready,
      endpoint: move endpoint, allocation: move allocation}, observing)
    return run storeMir(&mut resolver.*, &mut owner.*, move function, move tracked)
  }
  // A reference releases one unit of authority and, with the last, the package's allocation.
  if core == SealedKind.ExecutionRef {
    let selected = match move run glueChild(SealedCore.ordinal(CoreField.HeaderAllocation), &allocationType, &anchor) {
      Result<Option<GlueChild>, PreparationFailure>.Success {value} => move value
      Result<Option<GlueChild>, PreparationFailure>.Failure {error: failure} => {
        return run preparationQueryAnswer(&identity, move failure, move tracked)
      }
    }
    let allocation = match move selected {
      Option<GlueChild>.Some {value: child} => move child
      Option<GlueChild>.None => { return memberSuccess(move gap, move tracked) }
    }
    let unit = run Types.intern(Type.Unit)
    let header = run SealedCore.headerBeside(&anchor, &unit)
    let function = run DropGlue.lowerCore(move instance, ty, CoreCleanup.Reference {header: move header, allocation: move allocation},
      observing)
    return run storeMir(&mut resolver.*, &mut owner.*, move function, move tracked)
  }
  // An unstarted Execution releases its package through the package's own erased glue.
  if core == SealedKind.Execution {
    let result = match move SealedCore.element(ty) {
      Option<Shared<Type>>.Some {value} => move value
      Option<Shared<Type>>.None => { return memberSuccess(move gap, move tracked) }
    }
    let header = run SealedCore.headerBeside(&anchor, &result)
    let function = run DropGlue.lowerCore(move instance, ty, CoreCleanup.Execution {header: move header}, observing)
    return run storeMir(&mut resolver.*, &mut owner.*, move function, move tracked)
  }
  if core != SealedKind.SharedCore { return memberSuccess(move gap, move tracked) }
  let element = match move SealedCore.element(ty) {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => { return memberSuccess(move gap, move tracked) }
  }
  let needed = match move run glueNeeds(&mut resolver.*, &mut owner.*, &mut tracked, &element) {
    Result<bool, PreparationFailure>.Success {value} => value
    Result<bool, PreparationFailure>.Failure {error} => { return run preparationQueryAnswer(&identity, move error, move tracked) }
  }
  let mut value = Option<GlueChild>.none()
  if needed {
    let valueKey = match move run glueChild(SealedCore.ordinal(CoreField.BlockValue), &element, &anchor) {
      Result<Option<GlueChild>, PreparationFailure>.Success {value: preparedChild} => move preparedChild
      Result<Option<GlueChild>, PreparationFailure>.Failure {error: failure} => {
        return run preparationQueryAnswer(&identity, move failure, move tracked)
      }
    }
    value = match move valueKey {
      Option<GlueChild>.Some {value: child} => Option<GlueChild>.some(move child)
      Option<GlueChild>.None => { return memberSuccess(move gap, move tracked) }
    }
  }
  let allocationKey = match move run glueChild(SealedCore.ordinal(CoreField.BlockAllocation), &allocationType, &anchor) {
    Result<Option<GlueChild>, PreparationFailure>.Success {value: preparedChild} => move preparedChild
    Result<Option<GlueChild>, PreparationFailure>.Failure {error: failure} => {
      return run preparationQueryAnswer(&identity, move failure, move tracked)
    }
  }
  let allocation = match move allocationKey {
    Option<GlueChild>.Some {value: child} => move child
    Option<GlueChild>.None => { return memberSuccess(move gap, move tracked) }
  }
  let block = match move run SealedCore.fieldType(ty, CoreField.CoreBlock) {
    Option<Shared<Type>>.Some {value: addressed} => move addressed
    Option<Shared<Type>>.None => { return memberSuccess(move gap, move tracked) }
  }
  let function = run DropGlue.lowerCore(move instance, ty, CoreCleanup.Shared {block: move block, value: move value,
    allocation: move allocation}, observing)
  return run storeMir(&mut resolver.*, &mut owner.*, move function, move tracked)
}

// Drop glue reads its type's Drop hook and member shapes, never a function body. A cleanup form
// this backend cannot lower yet is the `cleanup` gap, attributed to the glue's owner declaration.
effect fn resolveGlueMir(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, instance: InstanceKey, ty: &Shared<Type>,
  observing: bool) -> Answer
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut dependencies = List<Dependency>.make()
  let identity = InstanceKey.identity(&instance)
  let gap = Value.Unsupported {gap: run Shared<BackendGap>.make(BackendGap.make(GapCode.Cleanup, &identity, Span.make(usize.ZERO, usize.ZERO)))}
  // A sealed core cleans its own storage; source can install no hook on it.
  if let Option<SealedKind>.Some {value: core} = move SealedCore.coreOf(ty) {
    return run resolveCoreGlue(&mut resolver.*, &mut owner.*, move dependencies, move instance, ty, core, observing)
  }
  let hook = match move run dropHook(&mut resolver.*, &mut owner.*, &mut dependencies, ty) {
    Result<Option<InstanceKey>, PreparationFailure>.Success {value} => move value
    Result<Option<InstanceKey>, PreparationFailure>.Failure {error} => { return run preparationQueryAnswer(&identity, move error, move dependencies) }
  }
  let children = match move run glueChildren(&mut resolver.*, &mut owner.*, &mut dependencies, ty,
    &DeclarationId.copyShared(&identity)) {
    Result<GlueChildren, PreparationFailure>.Success {value} => move value
    Result<GlueChildren, PreparationFailure>.Failure {error} => { return run preparationQueryAnswer(&identity, move error, move dependencies) }
  }
  let function = run DropGlue.lower(DropGlue {key: move instance, ty: Shared<Type>.clone(ty), hook: move hook, children: move children}, observing)
  return run storeMir(&mut resolver.*, &mut owner.*, move function, move dependencies)
}

// An origin demand cannot read a body whose own checking is waiting on that origin. This
// boundary retains a precise unavailable result instead of publishing partial return evidence.
fn activeSemanticKey(resolver: &Resolver, key: Key) -> bool {
  let context = demandContext(resolver, key)
  let origin = originContext(resolver, key)
  let active = List<Word>.asSlice(&resolver.active)
  let keys = List<ScopedKey>.asSlice(&resolver.keys)
  let mut at = usize.ZERO
  while at < active.length {
    let scoped = &keys[u64.toUsize(active[at].value)]
    if scoped.application == resolver.currentApplication && scoped.profile == resolver.profileSlot
      && scoped.condition == context && sameOriginContext(&scoped.origin, &origin) && sameKey(scoped.key, key) { return true }
    at = at + usize.ONE
  }
  return false
}

// Reconstruct the ordinary specialization path from this origin transaction's scoped query
// frames. Check growth before reading another body, including cached target bodies. Changing
// statics may finish a bounded finite chain; reaching the node limit is a gap, not an infinite
// specialization proof. Abstract source applications keep their declared proof obligations.
// Why a callable origin transaction refuses an application.
union OriginRefusal {
  /// The transaction reached its node bound.
  Bounded {module: ModuleId},
  /// The application grows a recursive specialization along `path`.
  Growing {path: List<Application>},
}

effect fn callableOriginAdmission(resolver: &Resolver, application: &Application, context: usize)
  -> Option<OriginRefusal> ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let active = List<Word>.asSlice(&resolver.active)
  let keys = List<ScopedKey>.asSlice(&resolver.keys)
  let mut admission = Admission.make()
  let mut count = usize.ZERO
  let mut at = usize.ZERO
  while at <= active.length {
    let mut next = Option<Application>.none()
    if at == active.length { count = count + usize.ONE next = Option<Application>.some(run Application.copy(application)) }
    else {
      let scoped = &keys[u64.toUsize(active[at].value)]
      if scoped.key.family == Family.CallableOrigin { count = count + usize.ONE }
      if scoped.application == resolver.currentApplication && scoped.profile == resolver.profileSlot
        && scoped.condition == context && scoped.key.family == Family.CallableOrigin {
        next = Option<Application>.some(run selectedApplicationAt(resolver, scoped.key.name))
      }
    }
    // Context partitions proof comparisons, but never resets the transaction's depth bound.
    if count > staticClosureNodes {
      return Option<OriginRefusal>.some(OriginRefusal.Bounded {module: ModuleId.copy(DeclarationId.moduleId(Application.bodyDeclaration(application)))})
    }
    if let Option<Application>.Some {value} = move next {
      match move run Admission.enter(&mut admission, &value, Edge.Direct) {
        Decision.Rejected {path} => {
          return Option<OriginRefusal>.some(OriginRefusal.Growing {path: move path})
        }
        Decision.ChangingStatic {..} => { run Admission.enterChain(&mut admission, &value, Edge.Direct) }
        Decision.Open => {}
        Decision.Entered => {}
        Decision.Reused {..} => {}
      }
    }
    at = at + usize.ONE
  }
  return Option<OriginRefusal>.none()
}

effect fn callableResultType(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, application: &Application, declared: &[Constraint], span: Span)
  -> Result<Shared<Type>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let private = privateOriginPhase(&resolver.*)
  if private.phase != usize.ZERO {
    let sourceSignature = run sectionOriginalSignature(&mut resolver.*, &mut owner.*, &mut dependencies.*,
      Application.bodyDeclaration(application), span)
    let writtenResult = match move Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(&sourceSignature, signatureResult) {
      Option<Shared<Type>>.Some {value} => move value
      _ => { return Result<Shared<Type>, Shared<Rejection>>.failResult(run reject(&resolver.*,
        DeclarationId.moduleId(Application.bodyDeclaration(application)), RejectionCode.Unsupported, span)) }
    }
    let sourceBindings = run Application.bindings(application)
    let sourceContract = run Type.applyBindings(&writtenResult, List<Binding>.asSlice(&sourceBindings), true)
    let parent = run selectedApplicationAt(&resolver.*, private.application)
    if private.phase != usize.ONE {
      // The solve map contains canonical source applications. A replayed call can still
      // carry a closed result recipe in its selected arguments after owner substitution.
      // Normalize those free channels before lookup, just as an explicit Origin does.
      let substituted = run Shared<Application>.make(run Application.substitute(application, &parent))
      let canonical = match move run normalizeCallableApplication(&mut resolver.*, &mut owner.*, &mut dependencies.*,
        DeclarationId.moduleId(Application.bodyDeclaration(application)), declared, &substituted, span) {
        Result<Application, Shared<Rejection>>.Success {value} => move value
        Result<Application, Shared<Rejection>>.Failure {error} => { return Result<Shared<Type>, Shared<Rejection>>.failResult(move error) }
      }
      let selected = run Shared<Application>.make(move canonical)
      let found = run originSolution(&resolver.*, private.plan, &selected)
      if let Option<Shared<Type>>.Some {value} = move found {
        let exposed = run Type.callableView(move value, move sourceContract)
        return Result<Shared<Type>, Shared<Rejection>>.succeed(run callableResultView(&exposed, declared))
      }
      if private.phase == 3 {
        return Result<Shared<Type>, Shared<Rejection>>.failResult(run reject(&resolver.*,
          DeclarationId.moduleId(Application.bodyDeclaration(application)), RejectionCode.Unsupported, span))
      }
    }
    return Result<Shared<Type>, Shared<Rejection>>.succeed(run Types.intern(Type.CallableOrigin {
      application: run Shared<Application>.make(run Application.copy(application)), contract: move sourceContract}))
  }
  let identity = run Shared<DeclarationId>.make(DeclarationId.copy(Application.bodyDeclaration(application)))
  let module = DeclarationId.moduleId(Application.bodyDeclaration(application))
  let ordinal = match move run ordinalOfIdentity(&mut resolver.*, module, &identity) {
    Option<usize>.Some {value} => value
    _ => { return Result<Shared<Type>, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Unsupported, span)) }
  }
  let name = run internSelectedApplication(&mut resolver.*, application)
  let declarationAccess162Request = Key {family: Family.CallableOrigin, module: knownModuleOrdinal(&resolver.*, module),
    name: name, declaration: ordinal, member: usize.ZERO, external: false}
  let declarationAccess162 = run internDeclaration(&mut resolver.*, declarationAccess162Request)
  let key = declarationAccess162
  if activeSemanticKey(&resolver.*, key) {
    return Result<Shared<Type>, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Unsupported, span))
  }
  let refusal = run callableOriginAdmission(&resolver.*, application, demandContext(&resolver.*, key))
  match move refusal {
    Option<OriginRefusal>.Some {value: OriginRefusal.Bounded {module: bounded}} => {
      return Result<Shared<Type>, Shared<Rejection>>.failResult(run reject(&resolver.*, &bounded, RejectionCode.Unsupported, span))
    }
    Option<OriginRefusal>.Some {value: OriginRefusal.Growing {path}} => {
      return Result<Shared<Type>, Shared<Rejection>>.failResult(run rejectSpecialization(&mut resolver.*, span, Option<RelatedSite>.none(), move path))
    }
    Option<OriginRefusal>.None => ()
  }
  let answer = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, key, span)
  let rejected = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(&answer, answerCause)
  if let Option<Shared<Rejection>>.Some {value} = move rejected { return Result<Shared<Type>, Shared<Rejection>>.failResult(move value) }
  let found = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(&answer, resolvedTypeAnswer)
  if let Option<Shared<Type>>.Some {value} = move found {
    return Result<Shared<Type>, Shared<Rejection>>.succeed(run callableResultView(&value, declared))
  }
  return Result<Shared<Type>, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Unsupported, span))
}

// Erase a redundant parameter view only after its exact public contract is proved by the
// current source premises. A weaker Once/Mutable permission remains a distinct view.
effect fn callableResultView(value: &Shared<Type>, declared: &[Constraint]) -> Shared<Type>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let copied = run Type.copy(value)
  if let Type.CallableView {representation, contract} = move copied {
    let exposed = run valueCallableContract(&representation, declared)
    if let Option<Shared<Type>>.Some {value: originalContract} = move exposed {
      if run Type.equalsShared(&originalContract, &contract) { return move representation }
    }
  }
  return Shared<Type>.clone(value)
}

fn originProducerCount(resolver: &Resolver, plan: usize) -> usize {
  let plans = List<CallableOrigin.Plan>.asSlice(&resolver.originPlans)
  return List<CallableOrigin.Producer>.length(&plans[plan].producers)
}

fn originProducerApplication(resolver: &Resolver, plan: usize, at: usize) -> Shared<Application> {
  let plans = List<CallableOrigin.Plan>.asSlice(&resolver.originPlans)
  let producers = List<CallableOrigin.Producer>.asSlice(&plans[plan].producers)
  return Shared<Application>.clone(&producers[at].application)
}

effect fn originRootSolution(resolver: &Resolver, plan: usize) -> Option<Shared<Type>>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let plans = List<CallableOrigin.Plan>.asSlice(&resolver.originPlans)
  return run CallableOrigin.solution(List<CallableOrigin.Solution>.asSlice(&plans[plan].solutions), &plans[plan].root)
}

effect fn originSolution(resolver: &Resolver, plan: usize, application: &Shared<Application>) -> Option<Shared<Type>>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let plans = List<CallableOrigin.Plan>.asSlice(&resolver.originPlans)
  return run CallableOrigin.solution(List<CallableOrigin.Solution>.asSlice(&plans[plan].solutions), application)
}

fn originPlanIndex(answer: &Result<Answer, NoRejection>) -> Option<usize> {
  return match &answer.* {
    Result<Answer, NoRejection>.Success {value} => match &value.outcome {
      Outcome.Success {value: Value.OriginPlan {index}} => Option<usize>.some(index)
      _ => Option<usize>.none()
    }
    _ => Option<usize>.none()
  }
}

effect fn originBodyKey(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, module: &ModuleId, key: Key, application: usize) -> Result<Key, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let selected = run selectedApplicationAt(&resolver.*, application)
  let declarationAccess163 = declarationPosition(&resolver.*, key)
  let routing = run needsStaticResidualization(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, key.module, declarationAccess163)
  let mut residual = DeclarationId.kind(Application.bodyDeclaration(&selected)) == OwnerKind.Anonymous
  match move routing {
    Result<bool, Shared<Rejection>>.Success {value} => { residual = residual || value }
    Result<bool, Shared<Rejection>>.Failure {error} => { return Result<Key, Shared<Rejection>>.failResult(move error) }
  }
  let mut member = usize.ZERO
  if residual { member = application + usize.ONE }
  return Result<Key, Shared<Rejection>>.succeed(Key {family: Family.Body, module: key.module,
    name: usize.ZERO, declaration: key.declaration, member: member, external: false})
}

// Draft bodies are query-partitioned source evidence. Their ordinary ownership/contract checks
// remain active; only origin-dependent exact inference is postponed for mandatory exact replay.
effect fn resolveOriginDraft(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, key: Key)
  -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let module = resolvedModule(&resolver.*, key.module)
  let mut dependencies = List<Dependency>.make()
  let bodyKey = match move run originBodyKey(&mut resolver.*, &mut owner.*, &mut dependencies, &module, key, key.name) {
    Result<Key, Shared<Rejection>>.Success {value} => value
    Result<Key, Shared<Rejection>>.Failure {error} => { return run memberRejected(move error, move dependencies) }
  }
  let answer = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies, bodyKey, Span.make(usize.ZERO, usize.ZERO))
  let rejected = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(&answer, answerCause)
  if let Option<Shared<Rejection>>.Some {value} = move rejected { return run memberRejected(move value, move dependencies) }
  let selected = Shared<Result<Answer, NoRejection>>.with<Option<Value>>(&answer, copiedOriginBody)
  if let Option<Value>.Some {value} = move selected { return memberSuccess(move value, move dependencies) }
  return run memberRejected(run reject(&resolver.*, &module, RejectionCode.Unsupported, Span.make(usize.ZERO, usize.ZERO)), move dependencies)
}

fn copiedOriginBody(answer: &Result<Answer, NoRejection>) -> Option<Value> {
  return match &answer.* {
    Result<Answer, NoRejection>.Success {value} => match &value.outcome {
      Outcome.Success {value: Value.Body {body}} => Option<Value>.some(Value.Body {
        body: Shared<TypedBody>.clone(&body)})
      _ => Option<Value>.none()
    }
    _ => Option<Value>.none()
  }
}

effect fn gatherOriginProducer(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, selected: &Shared<Application>, producers: &mut List<CallableOrigin.Producer>,
  admission: &mut Admission, span: Span) -> Option<Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let application = run Application.copyShared(selected)
  let identity = Application.bodyDeclaration(&application)
  let module = DeclarationId.moduleId(identity)
  let mut leave = false
  match move run Admission.enter(&mut admission.*, &application, Edge.Direct) {
    Decision.Entered => { leave = true }
    Decision.ChangingStatic {..} => { run Admission.enterChain(&mut admission.*, &application, Edge.Direct) leave = true }
    Decision.Rejected {path} => { return Option<Shared<Rejection>>.some(run rejectSpecialization(&mut resolver.*, span, Option<RelatedSite>.none(), move path)) }
    Decision.Reused {..} => {}
    Decision.Open => {}
  }
  let previous = run CallableOrigin.producerIndex(List<CallableOrigin.Producer>.asSlice(&producers.*), selected)
  if let Option<usize>.Some {..} = move previous {
    if leave { Admission.leave(&mut admission.*) }
    return Option<Shared<Rejection>>.none()
  }
  if List<CallableOrigin.Producer>.length(&producers.*) >= staticClosureNodes {
    return Option<Shared<Rejection>>.some(run reject(&resolver.*, module, RejectionCode.Unsupported, span))
  }
  let declaration = run Shared<DeclarationId>.make(DeclarationId.copy(identity))
  let ordinal = match move run ordinalOfIdentity(&mut resolver.*, module, &declaration) {
    Option<usize>.Some {value} => value
    _ => { return Option<Shared<Rejection>>.some(run reject(&resolver.*, module, RejectionCode.Unsupported, span)) }
  }
  let bindings = run Application.bindings(&application)
  let signature = run sectionOriginalSignature(&mut resolver.*, &mut owner.*, &mut dependencies.*, identity, span)
  let written = match move Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(&signature, signatureResult) {
    Option<Shared<Type>>.Some {value} => move value
    _ => { return Option<Shared<Rejection>>.some(run reject(&resolver.*, module, RejectionCode.Unsupported, span)) }
  }
  let contract = run Type.applyBindings(&written, List<Binding>.asSlice(&bindings), true)
  if !Shared<Type>.with<bool>(&contract, rawCallableType) {
    return Option<Shared<Rejection>>.some(run reject(&resolver.*, module, RejectionCode.Unsupported, span))
  }
  let name = run internSelectedApplication(&mut resolver.*, &application)
  let anchor = run resultTypeAnchor(&mut resolver.*, module, ordinal)
  let moduleOrdinal = knownModuleOrdinal(&resolver.*, module)
  let declarationAccess164Request = Key {
    family: Family.OriginDraft, module: moduleOrdinal, name: name,
    declaration: ordinal, member: usize.ZERO, external: false}
  let declarationAccess164 = run internDeclaration(&mut resolver.*, declarationAccess164Request)
  let bodyAnswer = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, declarationAccess164, anchor)
  let rejected = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(&bodyAnswer, answerCause)
  if let Option<Shared<Rejection>>.Some {value} = move rejected { return Option<Shared<Rejection>>.some(move value) }
  let body = match move Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(&bodyAnswer, answerTypedBody) {
    Option<Shared<TypedBody>>.Some {value} => move value
    _ => { return Option<Shared<Rejection>>.some(run reject(&resolver.*, module, RejectionCode.Unsupported, anchor)) }
  }
  let returned = match move run CallableOrigin.inputs(&body, List<Binding>.asSlice(&bindings)) {
    Option<List<Shared<Type>>>.Some {value} => move value
    _ => { return Option<Shared<Rejection>>.some(run reject(&resolver.*, module, RejectionCode.Unsupported, anchor)) }
  }
  let demands = run CallableOrigin.demands(&body, List<Binding>.asSlice(&bindings))
  let values = List<Shared<Type>>.asSlice(&demands)
  let mut edges = List<Shared<Application>>.make()
  let mut at = usize.ZERO
  while at < values.length {
    let mut found = run Type.callableOriginApplications(&values[at])
    let count = List<Shared<Application>>.length(&found)
    let mut item = usize.ZERO
    while item < count {
      run List<Shared<Application>>.append(&mut edges, List<Shared<Application>>.remove(&mut found, usize.ZERO))
      item = item + usize.ONE
    }
    at = at + usize.ONE
  }
  // Register before following a recursive edge. No provisional ordinary origin answer exists.
  run List<CallableOrigin.Producer>.append(&mut producers.*, CallableOrigin.Producer {
    application: Shared<Application>.clone(selected), contract: move contract, returns: move returned, demands: move demands})
  // A selected generic instantiation cannot make an invalid ordinary authored template valid.
  // Collect its symbolic owner schema in the same transaction, and strictly replay that producer
  // as well. Mixed/static bodies intentionally validate their selected residual instead.
  if DeclarationId.kind(identity) != OwnerKind.Anonymous {
    let routing = run needsStaticResidualization(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, moduleOrdinal, ordinal)
    let selectedOnly = match move routing {
      Result<bool, Shared<Rejection>>.Success {value} => value
      Result<bool, Shared<Rejection>>.Failure {error} => { return Option<Shared<Rejection>>.some(move error) }
    }
    if !selectedOnly {
      let source = run CallableOrigin.sourceApplication(&application)
      if !run Application.equals(&source, &application) {
        let symbolic = run Shared<Application>.make(move source)
        let refused = run gatherOriginProducer(&mut resolver.*, &mut owner.*, &mut dependencies.*, &symbolic,
          &mut producers.*, &mut admission.*, anchor)
        if let Option<Shared<Rejection>>.Some {value} = move refused { return Option<Shared<Rejection>>.some(move value) }
      }
    }
  }
  let successors = List<Shared<Application>>.asSlice(&edges)
  at = usize.ZERO
  while at < successors.length {
    let refused = run gatherOriginProducer(&mut resolver.*, &mut owner.*, &mut dependencies.*, &successors[at],
      &mut producers.*, &mut admission.*, anchor)
    if let Option<Shared<Rejection>>.Some {value} = move refused { return Option<Shared<Rejection>>.some(move value) }
    at = at + usize.ONE
  }
  if leave { Admission.leave(&mut admission.*) }
  return Option<Shared<Rejection>>.none()
}

effect fn originProducerCopy(resolver: &Resolver, plan: usize, at: usize) -> CallableOrigin.Producer
! OutOfMemoryError ? &mut Allocator {
  let plans = List<CallableOrigin.Plan>.asSlice(&resolver.originPlans)
  let producers = List<CallableOrigin.Producer>.asSlice(&plans[plan].producers)
  return run CallableOrigin.copyProducer(&producers[at])
}

fn originEvidenceIndex(answer: &Result<Answer, NoRejection>) -> Option<usize> {
  return match &answer.* {
    Result<Answer, NoRejection>.Success {value} => match &value.outcome {
      Outcome.Success {value: Value.OriginEvidence {index}} => Option<usize>.some(index)
      _ => Option<usize>.none()
    }
    _ => Option<usize>.none()
  }
}

effect fn originEvidenceCopy(resolver: &Resolver, index: usize) -> CallableOrigin.Producer
! OutOfMemoryError ? &mut Allocator {
  let evidence = List<CallableOrigin.Producer>.asSlice(&resolver.originEvidence)
  return run CallableOrigin.copyProducer(&evidence[index])
}

effect fn originEdges(values: &[Shared<Type>], output: &mut List<Shared<Application>>)
  -> () ! OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < values.length {
    let mut edges = run Type.callableOriginApplications(&values[at])
    let count = List<Shared<Application>>.length(&edges)
    let mut item = usize.ZERO
    while item < count {
      run List<Shared<Application>>.append(&mut output.*, List<Shared<Application>>.remove(&mut edges, usize.ZERO))
      item = item + usize.ONE
    }
    at = at + usize.ONE
  }
  return ()
}

// Every solving round has immutable evidence and its own query context. Normalization may reveal
// a higher-order producer or canonicalize an application's free argument channels, so closure is
// tested only after both the candidate map and the producer evidence have reached a fixed point.
effect fn resolveOriginGraph(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, key: Key)
  -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let application = run selectedApplicationAt(&resolver.*, key.name)
  let selected = run Shared<Application>.make(run Application.copy(&application))
  let module = DeclarationId.moduleId(Application.bodyDeclaration(&application))
  let declarationAccess165 = declarationPosition(&resolver.*, key)
  let anchor = run resultTypeAnchor(&mut resolver.*, module, declarationAccess165)
  let mut dependencies = List<Dependency>.make()
  let mut producers = List<CallableOrigin.Producer>.make()
  let mut admission = Admission.make()
  let refused = run gatherOriginProducer(&mut resolver.*, &mut owner.*, &mut dependencies, &selected, &mut producers, &mut admission, anchor)
  if let Option<Shared<Rejection>>.Some {value} = move refused { return run memberRejected(move value, move dependencies) }
  let mut root = Shared<Application>.clone(&selected)
  let mut round = usize.ZERO
  while round < staticClosureNodes {
    let solutions = run CallableOrigin.seeds(List<CallableOrigin.Producer>.asSlice(&producers))
    let complete = List<CallableOrigin.Solution>.length(&solutions) == List<CallableOrigin.Producer>.length(&producers)
    let count = List<CallableOrigin.Producer>.length(&producers)
    let plan = List<CallableOrigin.Plan>.length(&resolver.originPlans)
    run List<CallableOrigin.Plan>.append(&mut resolver.originPlans, CallableOrigin.Plan {requested: Shared<Application>.clone(&selected), root: Shared<Application>.clone(&root), producers: move producers, solutions: move solutions})
    let mut next = List<CallableOrigin.Producer>.make()
    let mut edges = List<Shared<Application>>.make()
    let mut changed = false
    let mut at = usize.ZERO
    while at < count {
      let original = run originProducerCopy(&resolver.*, plan, at)
      let producer = run Application.copyShared(&original.application)
      let identity = run Shared<DeclarationId>.make(DeclarationId.copy(Application.bodyDeclaration(&producer)))
      let producerModule = DeclarationId.moduleId(Application.bodyDeclaration(&producer))
      let ordinal = match move run ordinalOfIdentity(&mut resolver.*, producerModule, &identity) {
        Option<usize>.Some {value} => value
        _ => { return run memberRejected(run reject(&resolver.*, producerModule, RejectionCode.Unsupported, anchor), move dependencies) }
      }
      let interned = run internSelectedApplication(&mut resolver.*, &producer)
      let moduleOrdinal = knownModuleOrdinal(&resolver.*, producerModule)
      let declarationAccess166Request = Key {
        family: Family.OriginSolve, module: moduleOrdinal, name: plan, declaration: ordinal,
        member: interned + usize.ONE, external: false}
      let declarationAccess166 = run internDeclaration(&mut resolver.*, declarationAccess166Request)
      let solved = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies, declarationAccess166, anchor)
      let rejected = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(&solved, answerCause)
      if let Option<Shared<Rejection>>.Some {value} = move rejected { return run memberRejected(move value, move dependencies) }
      let evidence = match move Shared<Result<Answer, NoRejection>>.with<Option<usize>>(&solved, originEvidenceIndex) {
        Option<usize>.Some {value} => value
        _ => { return run memberRejected(run reject(&resolver.*, producerModule, RejectionCode.Unsupported, anchor), move dependencies) }
      }
      let normalized = run originEvidenceCopy(&resolver.*, evidence)
      if !run CallableOrigin.sameProducer(&original, &normalized) { changed = true }
      run originEdges(List<Shared<Type>>.asSlice(&normalized.demands), &mut edges)
      run originEdges(List<Shared<Type>>.asSlice(&normalized.returns), &mut edges)
      let contract = [Shared<Type>.clone(&normalized.contract)]
      run originEdges(&contract, &mut edges)
      if at == usize.ZERO { root = Shared<Application>.clone(&normalized.application) }
      if !run CallableOrigin.appendProducer(&mut next, move normalized) {
        return run memberRejected(run reject(&resolver.*, producerModule, RejectionCode.Unsupported, anchor), move dependencies)
      }
      at = at + usize.ONE
    }
    let successors = List<Shared<Application>>.asSlice(&edges)
    at = usize.ZERO
    while at < successors.length {
      let refused = run gatherOriginProducer(&mut resolver.*, &mut owner.*, &mut dependencies,
        &successors[at], &mut next, &mut admission, anchor)
      if let Option<Shared<Rejection>>.Some {value} = move refused { return run memberRejected(move value, move dependencies) }
      at = at + usize.ONE
    }
    changed = changed || List<CallableOrigin.Producer>.length(&next) != count
    if !changed {
      if complete { return memberSuccess(Value.OriginPlan {index: plan}, move dependencies) }
      return run memberRejected(run reject(&resolver.*, module, RejectionCode.Unsupported, anchor), move dependencies)
    }
    producers = move next
    round = round + usize.ONE
  }
  return run memberRejected(run reject(&resolver.*, module, RejectionCode.Unsupported, anchor), move dependencies)
}

// Solving normalizes already checked source evidence under the producer's own applied premises.
// It does not publish a Body answer or claim that a candidate origin has passed exact replay.
effect fn resolveOriginSolve(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, key: Key)
  -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let application = run selectedApplicationAt(&resolver.*, key.member - usize.ONE)
  let selected = run Shared<Application>.make(run Application.copy(&application))
  let module = DeclarationId.moduleId(Application.bodyDeclaration(&application))
  let declarationAccess167 = declarationPosition(&resolver.*, key)
  let anchor = run resultTypeAnchor(&mut resolver.*, module, declarationAccess167)
  let plans = List<CallableOrigin.Plan>.asSlice(&resolver.originPlans)
  let found = run CallableOrigin.producerIndex(List<CallableOrigin.Producer>.asSlice(&plans[key.name].producers), &selected)
  let index = match move found {
    Option<usize>.Some {value} => value
    _ => { return run memberRejected(run reject(&resolver.*, module, RejectionCode.Unsupported, anchor), List<Dependency>.make()) }
  }
  let producer = run originProducerCopy(&resolver.*, key.name, index)
  let mut dependencies = List<Dependency>.make()
  let bindings = run Application.bindings(&application)
  let declared = match move run closedApplicationPremises(&mut resolver.*, &mut owner.*, &mut dependencies,
    &application, List<Binding>.asSlice(&bindings), anchor) {
    Option<List<Constraint>>.Some {value} => move value
    _ => { return run memberRejected(run reject(&resolver.*, module, RejectionCode.Unsupported, anchor), move dependencies) }
  }
  let premises = List<Constraint>.asSlice(&declared)
  let canonical = match move run normalizeCallableApplication(&mut resolver.*, &mut owner.*, &mut dependencies,
    module, premises, &producer.application, anchor) {
    Result<Application, Shared<Rejection>>.Success {value} => move value
    Result<Application, Shared<Rejection>>.Failure {error} => { return run memberRejected(move error, move dependencies) }
  }
  let contract = match move run normalizeCallableChildren(&mut resolver.*, &mut owner.*, &mut dependencies,
    module, premises, &producer.contract, anchor) {
    Result<Shared<Type>, Shared<Rejection>>.Success {value} => move value
    Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return run memberRejected(move error, move dependencies) }
  }
  let returns = match move run normalizeCallableTypes(&mut resolver.*, &mut owner.*, &mut dependencies,
    module, premises, List<Shared<Type>>.asSlice(&producer.returns), anchor) {
    Result<List<Shared<Type>>, Shared<Rejection>>.Success {value} => move value
    Result<List<Shared<Type>>, Shared<Rejection>>.Failure {error} => { return run memberRejected(move error, move dependencies) }
  }
  let demands = match move run normalizeCallableTypes(&mut resolver.*, &mut owner.*, &mut dependencies,
    module, premises, List<Shared<Type>>.asSlice(&producer.demands), anchor) {
    Result<List<Shared<Type>>, Shared<Rejection>>.Success {value} => move value
    Result<List<Shared<Type>>, Shared<Rejection>>.Failure {error} => { return run memberRejected(move error, move dependencies) }
  }
  let output = List<CallableOrigin.Producer>.length(&resolver.originEvidence)
  run List<CallableOrigin.Producer>.append(&mut resolver.originEvidence, CallableOrigin.Producer {
    application: run Shared<Application>.make(move canonical), contract: move contract, returns: move returns, demands: move demands})
  return memberSuccess(Value.OriginEvidence {index: output}, move dependencies)
}

effect fn resolveOriginValidate(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, key: Key)
  -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let module = resolvedModule(&resolver.*, key.module)
  let mut dependencies = List<Dependency>.make()
  let application = run selectedApplicationAt(&resolver.*, key.member - usize.ONE)
  let bodyKey = match move run originBodyKey(&mut resolver.*, &mut owner.*, &mut dependencies, &module, key, key.member - usize.ONE) {
    Result<Key, Shared<Rejection>>.Success {value} => value
    Result<Key, Shared<Rejection>>.Failure {error} => { return run memberRejected(move error, move dependencies) }
  }
  let checked = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies, bodyKey, Span.make(usize.ZERO, usize.ZERO))
  let rejected = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(&checked, answerCause)
  if let Option<Shared<Rejection>>.Some {value} = move rejected { return run memberRejected(move value, move dependencies) }
  let body = match move Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(&checked, answerTypedBody) {
    Option<Shared<TypedBody>>.Some {value} => move value
    _ => { return run memberRejected(run reject(&resolver.*, &module, RejectionCode.Unsupported, Span.make(usize.ZERO, usize.ZERO)), move dependencies) }
  }
  let bindings = run Application.bindings(&application)
  let returned = match move run CallableOrigin.inputs(&body, List<Binding>.asSlice(&bindings)) {
    Option<List<Shared<Type>>>.Some {value} => move value
    _ => { return run memberRejected(run reject(&resolver.*, &module, RejectionCode.Unsupported, Span.make(usize.ZERO, usize.ZERO)), move dependencies) }
  }
  let declared = match move run closedApplicationPremises(&mut resolver.*, &mut owner.*, &mut dependencies,
    &application, List<Binding>.asSlice(&bindings), Span.make(usize.ZERO, usize.ZERO)) {
    Option<List<Constraint>>.Some {value} => move value
    _ => { return run memberRejected(run reject(&resolver.*, &module, RejectionCode.Unsupported, Span.make(usize.ZERO, usize.ZERO)), move dependencies) }
  }
  let mut normalized = List<Shared<Type>>.make()
  let inputs = List<Shared<Type>>.asSlice(&returned)
  let mut at = usize.ZERO
  while at < inputs.length {
    let resolved = match move run normalizeCallableResult(&mut resolver.*, &mut owner.*, &mut dependencies,
      &module, List<Constraint>.asSlice(&declared), &inputs[at], Span.make(usize.ZERO, usize.ZERO)) {
      Result<Shared<Type>, Shared<Rejection>>.Success {value} => move value
      Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return run memberRejected(move error, move dependencies) }
    }
    run List<Shared<Type>>.append(&mut normalized, move resolved)
    at = at + usize.ONE
  }
  let common = run CallableOrigin.common(List<Shared<Type>>.asSlice(&normalized))
  let selected = run Shared<Application>.make(run Application.copy(&application))
  let expected = run originSolution(&resolver.*, key.name, &selected)
  if let Option<Shared<Type>>.Some {value} = move common {
    if let Option<Shared<Type>>.Some {value: candidate} = move expected {
      let values = [move value, move candidate]
      let agreed = run CallableOrigin.common(&values)
      if let Option<Shared<Type>>.Some {..} = move agreed {
        return memberSuccess(Value.OriginPlan {index: key.name}, move dependencies)
      }
    }
  }
  let declarationAccess168 = declarationPosition(&resolver.*, key)
  let anchor = run resultTypeAnchor(&mut resolver.*, &module, declarationAccess168)
  return run memberRejected(run reject(&resolver.*, &module, RejectionCode.Unsupported, anchor), move dependencies)
}

effect fn resolveCallableOrigin(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, key: Key)
  -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let application = run selectedApplicationAt(&resolver.*, key.name)
  let module = DeclarationId.moduleId(Application.bodyDeclaration(&application))
  let declarationAccess169 = declarationPosition(&resolver.*, key)
  let anchor = run resultTypeAnchor(&mut resolver.*, module, declarationAccess169)
  let mut dependencies = List<Dependency>.make()
  let graph = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies, Key {
    family: Family.OriginGraph, module: key.module, name: key.name, declaration: key.declaration, member: usize.ZERO, external: false}, anchor)
  let failed = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(&graph, answerCause)
  if let Option<Shared<Rejection>>.Some {value} = move failed { return run memberRejected(move value, move dependencies) }
  let plan = match move Shared<Result<Answer, NoRejection>>.with<Option<usize>>(&graph, originPlanIndex) {
    Option<usize>.Some {value} => value
    _ => { return run memberRejected(run reject(&resolver.*, module, RejectionCode.Unsupported, anchor), move dependencies) }
  }
  let count = originProducerCount(&resolver.*, plan)
  let mut at = usize.ZERO
  while at < count {
    let selected = originProducerApplication(&resolver.*, plan, at)
    let producer = run Application.copyShared(&selected)
    let identity = run Shared<DeclarationId>.make(DeclarationId.copy(Application.bodyDeclaration(&producer)))
    let producerModule = DeclarationId.moduleId(Application.bodyDeclaration(&producer))
    let ordinal = match move run ordinalOfIdentity(&mut resolver.*, producerModule, &identity) {
      Option<usize>.Some {value} => value
      _ => { return run memberRejected(run reject(&resolver.*, producerModule, RejectionCode.Unsupported, anchor), move dependencies) }
    }
    let interned = run internSelectedApplication(&mut resolver.*, &producer)
    let moduleOrdinal = knownModuleOrdinal(&resolver.*, producerModule)
    let declarationAccess170Request = Key {
      family: Family.OriginValidate, module: moduleOrdinal, name: plan,
      declaration: ordinal, member: interned + usize.ONE, external: false}
    let declarationAccess170 = run internDeclaration(&mut resolver.*, declarationAccess170Request)
    let checked = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies, declarationAccess170, anchor)
    let rejected = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(&checked, answerCause)
    if let Option<Shared<Rejection>>.Some {value} = move rejected { return run memberRejected(move value, move dependencies) }
    at = at + usize.ONE
  }
  let found = run originRootSolution(&resolver.*, plan)
  if let Option<Shared<Type>>.Some {value} = move found { return memberSuccess(Value.Type {resolved: move value}, move dependencies) }
  return run memberRejected(run reject(&resolver.*, module, RejectionCode.Unsupported, anchor), move dependencies)
}

// `missing` for a union conversion: the members of `actual` that `expected` does not hold, each
// printed as its type. A structural union has no printed form of its own, so the message names
// members one by one; nothing is added when one of them has no spelling.
effect fn appendMissingMembers(module: &ModuleId, expected: &Shared<Type>, actual: &Shared<Type>, arguments: &mut List<MessageArgument>)
-> () ! OutOfMemoryError ? &mut Allocator {
  let sourceMembers = run unionMemberCopies(actual)
  let targetMembers = run unionMemberCopies(expected)
  let sources = List<Shared<Type>>.asSlice(&sourceMembers)
  let targets = List<Shared<Type>>.asSlice(&targetMembers)
  let mut targetTexts = List<Bytes>.make()
  let mut each = usize.ZERO
  while each < targets.length {
    match move run TypeText.display(&targets[each], module) {
      Option<Bytes>.Some {value} => { run List<Bytes>.append(&mut targetTexts, move value) }
      Option<Bytes>.None => { return () }
    }
    each = each + usize.ONE
  }
  let held = List<Bytes>.asSlice(&targetTexts)
  let mut missing = Bytes.make()
  // Members compare by their printed types, which name each member uniquely.
  let mut at = usize.ZERO
  while at < sources.length {
    let text = match move run TypeText.display(&sources[at], module) {
      Option<Bytes>.Some {value} => move value
      Option<Bytes>.None => { return () }
    }
    let mut found = false
    each = usize.ZERO
    while each < held.length {
      if same(Bytes.asSlice(&held[each]), Bytes.asSlice(&text)) { found = true }
      each = each + usize.ONE
    }
    if !found {
      if Bytes.length(&missing) > usize.ZERO { run Bytes.append(&mut missing, b", ") }
      run Bytes.append(&mut missing, Bytes.asSlice(&text))
    }
    at = at + usize.ONE
  }
  if Bytes.length(&missing) == usize.ZERO { return () }
  run List<MessageArgument>.append(&mut arguments.*, MessageArgument {name: run Bytes.copy(b"missing"), value: move missing})
  run List<MessageArgument>.append(&mut arguments.*, MessageArgument {name: run Bytes.copy(b"template"), value: run Bytes.copy(b"1")})
  return ()
}

// The members of `ty` printed one by one and joined with `, `; none when one has no spelling.
effect fn memberList(ty: &Shared<Type>, module: &ModuleId) -> Option<Bytes> ! OutOfMemoryError ? &mut Allocator {
  let members = run unionMemberCopies(ty)
  let listed = List<Shared<Type>>.asSlice(&members)
  let mut joined = Bytes.make()
  let mut at = usize.ZERO
  while at < listed.length {
    let text = match move run TypeText.display(&listed[at], module) {
      Option<Bytes>.Some {value} => move value
      Option<Bytes>.None => { return Option<Bytes>.none() }
    }
    if at > usize.ZERO { run Bytes.append(&mut joined, b", ") }
    run Bytes.append(&mut joined, Bytes.asSlice(&text))
    at = at + usize.ONE
  }
  return Option<Bytes>.some(move joined)
}

// A union's members, or the type itself as its only member.
effect fn unionMemberCopies(value: &Shared<Type>) -> List<Shared<Type>> ! OutOfMemoryError ? &mut Allocator {
  let mut found = List<Shared<Type>>.make()
  if !Shared<Type>.with<bool>(value, unionType) {
    run List<Shared<Type>>.append(&mut found, Shared<Type>.clone(value))
    return move found
  }
  let count = Type.partCount(value)
  let mut at = usize.ZERO
  while at < count {
    if let Option<Shared<Type>>.Some {value: member} = move Type.partAt(value, at) {
      run List<Shared<Type>>.append(&mut found, move member)
    }
    at = at + usize.ONE
  }
  return move found
}

// A callable value in any of its typed forms: a function, a closure, a section or a bound method.
fn callableValueForm(value: &Type) -> bool {
  return match &value.* {
    Type.CallableValue {..} => true
    Type.CallableSchema {..} => true
    Type.CallableStage {..} => true
    Type.CallableResult {..} => true
    Type.CallableOrigin {..} => true
    Type.CallableWitnessResult {..} => true
    Type.CallableView {..} => true
    _ => false
  }
}

fn rawCallableType(value: &Type) -> bool {
  return match &value.* { Type.Callable {..} => true _ => false }
}

effect fn resultTypeAnchor(resolver: &mut Resolver, module: &ModuleId, ordinal: usize) -> Span
! Cycle | OutOfMemoryError ? &mut Allocator {
  let written = run signatureSyntax(&mut resolver.*, module, ordinal)
  if let Option<WrittenSignature>.Some {value} = move written {
    if let Option<HirId>.Some {value: result} = move value.result {
      let observed = run source(&mut resolver.*, module)
      if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(&resolver.*, &observed, module) {
        return Module.span(IndexedSource.authored(indexed), result)
      }
    }
  }
  return Span.make(usize.ZERO, usize.ZERO)
}

struct OpaqueReturnEnvelope {
  source: Shared<Type>,
  payload: BodyNodeId,
  tag: usize,
}
fn opaqueReturnEnvelope(body: &TypedBody, node: BodyNodeId) -> Option<OpaqueReturnEnvelope> {
  let nodes = TypedBody.nodeSlice(body)
  if let BodyNodeKind.Expression {ty, form: BodyExpression.UnionInject {value, tag}} = &nodes[node.index].kind {
    return Option<OpaqueReturnEnvelope>.some(OpaqueReturnEnvelope {source: Shared<Type>.clone(&ty), payload: value, tag: tag})
  }
  return Option<OpaqueReturnEnvelope>.none()
}

effect fn opaqueBodyEvidence(body: &Shared<TypedBody>, application: &Application, result: &Shared<Type>,
  family: &Shared<Type>, anchor: &Anchor) -> List<OpaqueLeaf> ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let bindings = run Application.bindings(application)
  let reached = run ReturnFlow.collect(body)
  let returns = List<BodyNodeId>.asSlice(&reached)
  let mut evidence = List<OpaqueLeaf>.make()
  let mut at = usize.ZERO
  while at < returns.length {
      let node = returns[at]
      let mut operand = node
      let mut promised = Shared<Type>.clone(result)
      let envelope = Shared<TypedBody>.with<Option<OpaqueReturnEnvelope>>(body,
        fn(value: &TypedBody) -> Option<OpaqueReturnEnvelope> { return opaqueReturnEnvelope(value, node) })
      if let Option<OpaqueReturnEnvelope>.Some {value} = move envelope {
        if run Type.containsOpaque(&value.source, Application.bodyDeclaration(application)) {
          operand = value.payload
          let ordered = run UnionProjection.members(&value.source)
          if let Option<List<Shared<Type>>>.Some {value: members} = move ordered {
            let listed = List<Shared<Type>>.asSlice(&members)
            if value.tag < listed.length {
              promised = run Type.applyBindings(&listed[value.tag], List<Binding>.asSlice(&bindings), true)
            }
          }
        }
      }
      let actual = Shared<TypedBody>.with<Option<Shared<Type>>>(body,
        fn(value: &TypedBody) -> Option<Shared<Type>> { return bodyExpressionType(TypedBody.nodeSlice(value), &operand) })
      if let Option<Shared<Type>>.Some {value} = move actual {
        let closed = run Type.applyBindings(&value, List<Binding>.asSlice(&bindings), true)
        let found = run Type.opaqueEvidence(&closed, &promised, Application.bodyDeclaration(application))
        if let Option<List<OpaqueEvidence>>.Some {value: leaves} = move found {
          let listed = List<OpaqueEvidence>.asSlice(&leaves)
          let span = Shared<TypedBody>.with<Span>(body,
            fn(value: &TypedBody) -> Span { return BodyOrigin.span(TypedBody.nodeSlice(value)[node.index].origin, anchor) })
          let mut leaf = usize.ZERO
          while leaf < listed.length {
            if run Type.equalsShared(&listed[leaf].family, family) {
              run List<OpaqueLeaf>.append(&mut evidence, OpaqueLeaf {ty: Shared<Type>.clone(&listed[leaf].actual), span: span})
            }
            leaf = leaf + usize.ONE
          }
        }
      }
    at = at + usize.ONE
  }
  return move evidence
}

// Runtime storage follows substituted nominal fields, not phantom arguments or callable proofs.
// Descriptor referents are discovery dependencies, but do not contribute inline size cycles.
effect fn opaqueStoredInputs(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, value: &Shared<Type>, inlineOnly: bool, span: Span)
  -> Result<List<Shared<Type>>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let nominal = Shared<Type>.with<bool>(value, isNominalType)
  if nominal { return run nominalParts(&mut resolver.*, &mut owner.*, &mut dependencies.*, value, span) }
  let descriptor = Shared<Type>.with<bool>(value, fn(ty: &Type) -> bool {
    return match &ty.* { Type.Reference {..} => true Type.Pointer {..} => true Type.Slice {..} => true _ => false }
  })
  let contract = Shared<Type>.with<bool>(value, fn(ty: &Type) -> bool {
    return match &ty.* { Type.Callable {..} => true _ => false }
  })
  if contract || (inlineOnly && descriptor) {
    return Result<List<Shared<Type>>, Shared<Rejection>>.succeed(List<Shared<Type>>.make())
  }
  return Result<List<Shared<Type>>, Shared<Rejection>>.succeed(run RuntimeType.inputs(value))
}

effect fn gatherOpaqueInputs(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, value: &Shared<Type>, producers: &mut List<OpaqueProducer>,
  discovery: &mut List<Shared<Type>>, admission: &mut Admission, span: Span) -> Option<Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  if let Option<Shared<Application>>.Some {..} = move Type.opaqueApplication(value) {
    return run gatherOpaqueProducer(&mut resolver.*, &mut owner.*, &mut dependencies.*, value,
      &mut producers.*, &mut discovery.*, &mut admission.*, span)
  }
  let previous = List<Shared<Type>>.asSlice(&discovery.*)
  let mut known = usize.ZERO
  while known < previous.length {
    if run Type.equalsShared(&previous[known], value) { return Option<Shared<Rejection>>.none() }
    known = known + usize.ONE
  }
  if previous.length >= staticClosureNodes {
    let families = List<OpaqueProducer>.asSlice(&producers.*)
    let application = match move Type.opaqueApplication(&families[usize.ZERO].family) {
      Option<Shared<Application>>.Some {value: root} => run Application.copyShared(&root)
      _ => { fail RevisionMismatch {} }
    }
    return Option<Shared<Rejection>>.some(run reject(&resolver.*,
      DeclarationId.moduleId(Application.bodyDeclaration(&application)), RejectionCode.Unsupported, span))
  }
  run List<Shared<Type>>.append(&mut discovery.*, Shared<Type>.clone(value))
  let found = run opaqueStoredInputs(&mut resolver.*, &mut owner.*, &mut dependencies.*, value, false, span)
  let children = match move found { Result<List<Shared<Type>>, Shared<Rejection>>.Success {value: inputs} => move inputs
    Result<List<Shared<Type>>, Shared<Rejection>>.Failure {error} => { return Option<Shared<Rejection>>.some(move error) } }
  let listed = List<Shared<Type>>.asSlice(&children)
  let mut at = usize.ZERO
  while at < listed.length {
    let failure = run gatherOpaqueInputs(&mut resolver.*, &mut owner.*, &mut dependencies.*, &listed[at],
      &mut producers.*, &mut discovery.*, &mut admission.*, span)
    if let Option<Shared<Rejection>>.Some {value: rejected} = move failure { return Option<Shared<Rejection>>.some(move rejected) }
    at = at + usize.ONE
  }
  return Option<Shared<Rejection>>.none()
}

// The complete transaction owns its admission path. No evidence is published until every
// selected body closes; a recursive forwarding edge does not re-enter this query family.
effect fn gatherOpaqueProducer(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, family: &Shared<Type>, producers: &mut List<OpaqueProducer>,
  discovery: &mut List<Shared<Type>>, admission: &mut Admission, incoming: Span) -> Option<Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let selected = match move Type.opaqueApplication(family) {
    Option<Shared<Application>>.Some {value} => move value
    _ => { fail RevisionMismatch {} }
  }
  let application = run Application.copyShared(&selected)
  let identity = Application.bodyDeclaration(&application)
  let module = DeclarationId.moduleId(identity)
  let decision = run Admission.enter(&mut admission.*, &application, Edge.Direct)
  let mut leave = false
  match move decision {
    Decision.Entered => { leave = true }
    Decision.Reused {..} => {}
    Decision.ChangingStatic {..} => {
      run Admission.enterChain(&mut admission.*, &application, Edge.Direct)
      leave = true
    }
    Decision.Rejected {path} => {
      return Option<Shared<Rejection>>.some(run rejectSpecialization(&mut resolver.*, incoming, Option<RelatedSite>.none(), move path))
    }
    Decision.Open => { return Option<Shared<Rejection>>.some(run reject(&resolver.*, module, RejectionCode.Unsupported, incoming)) }
  }
  let previous = run OpaqueRealization.indexOf(List<OpaqueProducer>.asSlice(&producers.*), family)
  if let Option<usize>.Some {..} = move previous {
    if leave { Admission.leave(&mut admission.*) }
    return Option<Shared<Rejection>>.none()
  }
  // Changing-static discovery has the same bounded finite-certificate policy as the existing
  // closure transaction. This bound is not a proof that an unfinished graph is infinite.
  if List<OpaqueProducer>.length(&producers.*) >= staticClosureNodes {
    return Option<Shared<Rejection>>.some(run reject(&resolver.*, module, RejectionCode.Unsupported, incoming))
  }
  let declaration = run Shared<DeclarationId>.make(DeclarationId.copy(identity))
  let ordinal = match move run ordinalOfIdentity(&mut resolver.*, module, &declaration) {
    Option<usize>.Some {value} => value
    _ => { return Option<Shared<Rejection>>.some(run reject(&resolver.*, module, RejectionCode.Unsupported, incoming)) }
  }
  let moduleOrdinal = knownModuleOrdinal(&resolver.*, module)
  let anchor = run resultTypeAnchor(&mut resolver.*, module, ordinal)
  let declarationAccess171Request = Key {
    family: Family.Signature, module: moduleOrdinal, name: usize.ZERO, declaration: ordinal, member: usize.ZERO, external: false}
  let declarationAccess171 = run internDeclaration(&mut resolver.*, declarationAccess171Request)
  let signature = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, declarationAccess171, anchor)
  let failure = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(&signature, answerCause)
  if let Option<Shared<Rejection>>.Some {value} = move failure { return Option<Shared<Rejection>>.some(move value) }
  let declared = match move Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(&signature, signatureResult) {
    Option<Shared<Type>>.Some {value} => move value
    _ => { return Option<Shared<Rejection>>.some(run reject(&resolver.*, module, RejectionCode.Unsupported, anchor)) }
  }
  let bindings = run Application.bindings(&application)
  let finished = run Type.finishOpaqueApplication(&declared, &application)
  let result = run Type.applyBindings(&finished, List<Binding>.asSlice(&bindings), true)
  let staticCount = Shared<Result<Answer, NoRejection>>.with<usize>(&signature, signatureStaticCount)
  if staticCount != List<StaticSlot>.length(&application.statics) {
    return Option<Shared<Rejection>>.some(run reject(&resolver.*, module, RejectionCode.Unsupported, anchor))
  }
  let routing = run needsStaticResidualization(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, moduleOrdinal, ordinal)
  let mut bodyMember = usize.ZERO
  match move routing {
    Result<bool, Shared<Rejection>>.Success {value} => {
      if value {
        let interned = run internSelectedApplication(&mut resolver.*, &application)
        bodyMember = interned + usize.ONE
      }
    }
    Result<bool, Shared<Rejection>>.Failure {error} => { return Option<Shared<Rejection>>.some(move error) }
  }
  let declarationAccess172Request = Key {
    family: Family.Body, module: moduleOrdinal, name: usize.ZERO, declaration: ordinal, member: bodyMember, external: false}
  let declarationAccess172 = run internDeclaration(&mut resolver.*, declarationAccess172Request)
  let bodyAnswer = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, declarationAccess172, anchor)
  let rejected = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(&bodyAnswer, answerCause)
  if let Option<Shared<Rejection>>.Some {value} = move rejected { return Option<Shared<Rejection>>.some(move value) }
  let body = match move Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(&bodyAnswer, answerTypedBody) {
    Option<Shared<TypedBody>>.Some {value} => move value
    _ => { return Option<Shared<Rejection>>.some(run reject(&resolver.*, module, RejectionCode.Unsupported, anchor)) }
  }
  let bodyAnchor = match move run declarationAnchor(&mut resolver.*, Application.bodyDeclaration(&application)) {
    Option<Anchor>.Some {value} => move value
    Option<Anchor>.None => { return Option<Shared<Rejection>>.some(run reject(&resolver.*, module, RejectionCode.Unsupported, anchor)) }
  }
  let evidence = run opaqueBodyEvidence(&body, &application, &result, family, &bodyAnchor)
  // Copy the discovery edges before appending this producer: recursive gathering may grow its
  // list, and a borrowed evidence slice must not survive that mutation.
  let listed = List<OpaqueLeaf>.asSlice(&evidence)
  let mut edges = List<OpaqueLeaf>.make()
  let mut at = usize.ZERO
  while at < listed.length {
    run List<OpaqueLeaf>.append(&mut edges, OpaqueLeaf {ty: Shared<Type>.clone(&listed[at].ty), span: listed[at].span})
    at = at + usize.ONE
  }
  run List<OpaqueProducer>.append(&mut producers.*, OpaqueProducer {family: Shared<Type>.clone(family), anchor: anchor, evidence: move evidence})
  let successors = List<OpaqueLeaf>.asSlice(&edges)
  at = usize.ZERO
  while at < successors.length {
    let failed = run gatherOpaqueInputs(&mut resolver.*, &mut owner.*, &mut dependencies.*, &successors[at].ty,
      &mut producers.*, &mut discovery.*, &mut admission.*, successors[at].span)
    if let Option<Shared<Rejection>>.Some {value} = move failed { return Option<Shared<Rejection>>.some(move value) }
    at = at + usize.ONE
  }
  if leave { Admission.leave(&mut admission.*) }
  return Option<Shared<Rejection>>.none()
}

effect fn validateOpaqueStorage(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, producers: &[OpaqueProducer],
  realized: &[OpaqueRealization.Realization], value: &Shared<Type>, producer: usize,
  active: &mut List<usize>, types: &mut List<Shared<Type>>) -> Option<Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let selected = run OpaqueRealization.indexOf(producers, value)
  if let Option<usize>.Some {value: index} = move selected {
    let ancestors = List<usize>.asSlice(&active.*)
    let mut at = usize.ZERO
    while at < ancestors.length {
      if ancestors[at] == index {
        let application = match move Type.opaqueApplication(&producers[index].family) {
          Option<Shared<Application>>.Some {value: family} => run Application.copyShared(&family)
          _ => { fail RevisionMismatch {} }
        }
        return Option<Shared<Rejection>>.some(run reject(&resolver.*,
          DeclarationId.moduleId(Application.bodyDeclaration(&application)), RejectionCode.InlineOpaqueLayoutCycle,
          producers[index].anchor))
      }
      at = at + usize.ONE
    }
    run List<usize>.append(&mut active.*, index)
    // A family boundary starts a new physical leaf. Equal leaves of different families must
    // expose their forwarding captures before ordinary recursive-type ancestry can stop them.
    let mut leafTypes = List<Shared<Type>>.make()
    let failure = run validateOpaqueStorage(&mut resolver.*, &mut owner.*, &mut dependencies.*, producers,
      realized, &realized[index].storage, index, &mut active.*, &mut leafTypes)
    let last = List<usize>.length(&active.*) - usize.ONE
    drop List<usize>.remove(&mut active.*, last)
    return move failure
  }
  let ancestors = List<Shared<Type>>.asSlice(&types.*)
  let mut at = usize.ZERO
  let mut exhausted = ancestors.length >= staticClosureNodes
  while at < ancestors.length {
    if run Type.equalsShared(&ancestors[at], value) { exhausted = true }
    at = at + usize.ONE
  }
  if exhausted {
    let application = match move Type.opaqueApplication(&producers[producer].family) {
      Option<Shared<Application>>.Some {value: family} => run Application.copyShared(&family)
      _ => { fail RevisionMismatch {} }
    }
    return Option<Shared<Rejection>>.some(run reject(&resolver.*,
      DeclarationId.moduleId(Application.bodyDeclaration(&application)), RejectionCode.Unsupported, producers[producer].anchor))
  }
  run List<Shared<Type>>.append(&mut types.*, Shared<Type>.clone(value))
  let found = run opaqueStoredInputs(&mut resolver.*, &mut owner.*, &mut dependencies.*, value, true, producers[producer].anchor)
  let inputs = match move found { Result<List<Shared<Type>>, Shared<Rejection>>.Success {value: fields} => move fields
    Result<List<Shared<Type>>, Shared<Rejection>>.Failure {error} => { return Option<Shared<Rejection>>.some(move error) } }
  let fields = List<Shared<Type>>.asSlice(&inputs)
  at = usize.ZERO
  while at < fields.length {
    let failure = run validateOpaqueStorage(&mut resolver.*, &mut owner.*, &mut dependencies.*, producers,
      realized, &fields[at], producer, &mut active.*, &mut types.*)
    if let Option<Shared<Rejection>>.Some {value: error} = move failure { return Option<Shared<Rejection>>.some(move error) }
    at = at + usize.ONE
  }
  let last = List<Shared<Type>>.length(&types.*) - usize.ONE
  drop List<Shared<Type>>.remove(&mut types.*, last)
  return Option<Shared<Rejection>>.none()
}

fn resolvedTypeAnswer(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Type {resolved}} = &value.outcome {
      return Option<Shared<Type>>.some(Shared<Type>.clone(&resolved))
    }
  }
  return Option<Shared<Type>>.none()
}

effect fn resolveOpaqueRealization(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, key: Key)
  -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let known = List<Shared<Type>>.asSlice(&resolver.applications)
  let root = Shared<Type>.clone(&known[key.name])
  let mut dependencies = List<Dependency>.make()
  let mut producers = List<OpaqueProducer>.make()
  let mut discovery = List<Shared<Type>>.make()
  let mut admission = Admission.make()
  let failed = run gatherOpaqueProducer(&mut resolver.*, &mut owner.*, &mut dependencies, &root, &mut producers,
    &mut discovery, &mut admission, Span.make(usize.ZERO, usize.ZERO))
  if let Option<Shared<Rejection>>.Some {value} = move failed { return run memberRejected(move value, move dependencies) }
  let solved = run OpaqueRealization.solve(List<OpaqueProducer>.asSlice(&producers))
  match move solved {
    Result<List<OpaqueRealization.Realization>, OpaqueRealization.Failure>.Success {value} => {
      let listed = List<OpaqueRealization.Realization>.asSlice(&value)
      let families = List<OpaqueProducer>.asSlice(&producers)
      let mut at = usize.ZERO
      while at < families.length {
        let mut active = List<usize>.make()
        let mut types = List<Shared<Type>>.make()
        let refused = run validateOpaqueStorage(&mut resolver.*, &mut owner.*, &mut dependencies, families,
          listed, &families[at].family, at, &mut active, &mut types)
        if let Option<Shared<Rejection>>.Some {value: error} = move refused { return run memberRejected(move error, move dependencies) }
        at = at + usize.ONE
      }
      return memberSuccess(Value.Type {resolved: Shared<Type>.clone(&listed[usize.ZERO].storage)}, move dependencies)
    }
    Result<List<OpaqueRealization.Realization>, OpaqueRealization.Failure>.Failure {error} => {
      let listed = List<OpaqueProducer>.asSlice(&producers)
      let selected = run Type.copy(&listed[error.producer].family)
      let identity = match move selected { Type.OpaqueRepresentation {application, ..} => run Application.copyShared(&application)
        _ => { fail RevisionMismatch {} } }
      let code = match error.kind { OpaqueFailureKind.Divergent => RejectionCode.DivergentOpaqueRealization
        OpaqueFailureKind.Cycle => RejectionCode.OpaqueRealizationCycle OpaqueFailureKind.Missing => RejectionCode.MissingOpaqueRealization }
      let module = DeclarationId.moduleId(Application.bodyDeclaration(&identity))
      let evidence = List<OpaqueLeaf>.asSlice(&listed[error.producer].evidence)
      let mut related = Option<RelatedSite>.none()
      if error.kind == OpaqueFailureKind.Divergent && evidence.length != usize.ZERO {
        related = Option<RelatedSite>.some(RelatedSite {module: ModuleId.copy(module), span: evidence[usize.ZERO].span})
      }
      return run memberRejected(run rejectWithRelated(&resolver.*, module, code,
        listed[error.producer].anchor, move related), move dependencies)
    }
  }
}

// Abstract callable parameters can reveal a schema only after ordinary substitution. Resolve
// staging through the same target signature and bound proof as source-visible schema staging.
effect fn stagedRuntimeSchema(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, caller: &Application, callerBindings: &[Binding],
  base: &Shared<Type>, contract: Shared<Type>, captures: List<Shared<Type>>, remaining: usize,
  suffixMode: CallableMode, span: Span)
  -> Result<Shared<Type>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let module = DeclarationId.moduleId(Application.bodyDeclaration(caller))
  let premises = match move run closedApplicationPremises(&mut resolver.*, &mut owner.*, &mut dependencies.*,
    caller, callerBindings, span) {
    Option<List<Constraint>>.Some {value} => move value
    _ => { return Result<Shared<Type>, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Unsupported, span)) }
  }
  let fields = match move run normalizeCallableTypes(&mut resolver.*, &mut owner.*, &mut dependencies.*, module,
    List<Constraint>.asSlice(&premises), List<Shared<Type>>.asSlice(&captures), span) {
    Result<List<Shared<Type>>, Shared<Rejection>>.Success {value} => move value
    Result<List<Shared<Type>>, Shared<Rejection>>.Failure {error} => { return Result<Shared<Type>, Shared<Rejection>>.failResult(move error) }
  }
  let exposed = match move run normalizeCallableChildren(&mut resolver.*, &mut owner.*, &mut dependencies.*, module,
    List<Constraint>.asSlice(&premises), &contract, span) {
    Result<Shared<Type>, Shared<Rejection>>.Success {value} => move value
    Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result<Shared<Type>, Shared<Rejection>>.failResult(move error) }
  }
  return run stagedCallableSchema(&mut resolver.*, &mut owner.*, &mut dependencies.*, module,
    List<Constraint>.asSlice(&premises), base, move exposed, move fields, remaining, suffixMode, span)
}

// Source provenance and physical projection share the same immutable schema selection.
effect fn stagedCallableSchema(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, module: &ModuleId, premises: &[Constraint],
  base: &Shared<Type>, contract: Shared<Type>, captures: List<Shared<Type>>, remaining: usize,
  suffixMode: CallableMode, span: Span) -> Result<Shared<Type>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let recipe = match move Shared<Type>.with<Option<Shared<SectionSchema>>>(base, sectionSchemaOf) {
    Option<Shared<SectionSchema>>.Some {value} => move value
    _ => { return Result<Shared<Type>, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Unsupported, span)) }
  }
  let copied = run CallableSchema.copy(&recipe)
  let target = DeclarationId.copyShared(&copied.target)
  let fresh = run sectionInferenceOwner(&mut resolver.*, &target)
  let mut unheld = List<Binding>.make()
  let baseInputs = run sectionFieldInputs(base)
  let opened = match move run sectionSchemaSignature(&mut resolver.*, &mut owner.*, &mut dependencies.*,
    &recipe, List<CallableFieldInput>.asSlice(&baseInputs), &fresh, module, span, false, &mut unheld) {
    Result<Shared<Result<Answer, NoRejection>>, Shared<Rejection>>.Success {value} => move value
    Result<Shared<Result<Answer, NoRejection>>, Shared<Rejection>>.Failure {error} => {
      return Result<Shared<Type>, Shared<Rejection>>.failResult(move error)
    }
  }
  let count = Shared<Result<Answer, NoRejection>>.with<usize>(&opened, signatureParameterCount)
  let supplied = List<Shared<Type>>.asSlice(&captures)
  if remaining + supplied.length != count {
    return Result<Shared<Type>, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.CallArity, span))
  }
  let mut variables = List<Shared<DeclarationId>>.make()
  run List<Shared<DeclarationId>>.append(&mut variables, run Shared<DeclarationId>.make(DeclarationId.copy(&fresh)))
  let mut inferred = List<Binding>.make()
  let mut at = usize.ZERO
  while at < supplied.length {
    let pattern = match move Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(&opened,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> { return signatureParameter(answer, remaining + at) }) {
      Option<Shared<Type>>.Some {value} => move value
      _ => { fail RevisionMismatch {} }
    }
    run inferSectionCallableShape(&pattern, &supplied[at], List<Shared<DeclarationId>>.asSlice(&variables), &mut inferred)
    at = at + usize.ONE
  }
  let freshIdentity = run Shared<DeclarationId>.make(DeclarationId.copy(&fresh))
  let inferenceFailure = run inferFromProviderBounds(&mut resolver.*, &mut owner.*, &mut dependencies.*, module,
    &opened, &freshIdentity,
    premises, &mut inferred, span)
  if let Option<Shared<Rejection>>.Some {value} = move inferenceFailure {
    return Result<Shared<Type>, Shared<Rejection>>.failResult(move value)
  }
  // Shape inference may learn variables through a valid access conversion. Prove every fixed
  // suffix after inference instead of treating a discarded unification failure as evidence.
  at = usize.ZERO
  while at < supplied.length {
    let pattern = match move Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(&opened,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> { return signatureParameter(answer, remaining + at) }) {
      Option<Shared<Type>>.Some {value} => move value
      _ => { fail RevisionMismatch {} }
    }
    let selected = run Type.applyBindings(&pattern, List<Binding>.asSlice(&inferred), true)
    let required = match move run CallableContract.compareValue(&supplied[at], &selected) {
      Result<CallableContract.ValueRelation, CallableFailure>.Success {value} => move value
      Result<CallableContract.ValueRelation, CallableFailure>.Failure {error} => {
        let code = match error { CallableFailure.Incompatible => RejectionCode.IncompatibleCallableSignature _ => RejectionCode.Unsupported }
        return Result<Shared<Type>, Shared<Rejection>>.failResult(run reject(&resolver.*, module, code, span))
      }
    }
    if !run proveValueRelation(&required, premises, RegionProof.Typing) {
      return Result<Shared<Type>, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.IncompatibleCallableSignature, span))
    }
    at = at + usize.ONE
  }
  let mut fixedBounds = List<Constraint>.make()
  let bounds = Shared<Result<Answer, NoRejection>>.with<usize>(&opened, signatureConstraintCount)
  at = usize.ZERO
  while at < bounds {
    let bound = Shared<Result<Answer, NoRejection>>.with<Option<Constraint>>(&opened,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Constraint> { return signatureConstraintAt(answer, at) })
    if let Option<Constraint>.Some {value} = move bound {
      let applied = run bindConstraint(&value, List<Binding>.asSlice(&inferred))
      if !run constraintMentionsOwner(&applied, &fresh) { run List<Constraint>.append(&mut fixedBounds, move applied) }
    }
    at = at + usize.ONE
  }
  let declared = run copyConstraints(premises)
  let refused = run proveAppliedBounds(&mut resolver.*, &mut owner.*, &mut dependencies.*, &declared,
    List<Constraint>.asSlice(&fixedBounds), module, span, RegionProof.Typing)
  if let Option<Shared<Rejection>>.Some {value} = move refused {
    return Result<Shared<Type>, Shared<Rejection>>.failResult(move value)
  }
  // The source promise determines transport; exact storage retains the actual invocation mode.
  let actual = match move run CallableContract.ofType(&copied.contract) {
    Option<CallableFacts>.Some {value} => move value
    _ => { return absurd<Result<Shared<Type>, Shared<Rejection>>>() }
  }
  let mut mode = actual.mode
  if suffixMode == CallableMode.Once { mode = CallableMode.Once }
  if suffixMode == CallableMode.Mutable && mode == CallableMode.Shared { mode = CallableMode.Mutable }
  let normalized = match move run Type.copy(&contract) {
    Type.Callable {isUnsafe, environment, invocationBinders, invocationUse, invocationBounds, parameters, result, ..} => Type.Callable {
      mode: mode, isUnsafe: isUnsafe, environment: move environment, invocationBinders: invocationBinders, invocationUse: invocationUse,
      invocationBounds: move invocationBounds, parameters: move parameters, result: move result,
    }
    _ => { return absurd<Result<Shared<Type>, Shared<Rejection>>>() }
  }
  return run stagedSectionSchema(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, base,
    &recipe, run Types.intern(move normalized), &opened, &fresh, List<Binding>.asSlice(&inferred), remaining, move captures, premises, true, span)
}

effect fn collectRuntimeProjection(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, caller: &Application, bindings: &[Binding], value: &Shared<Type>,
  projections: &mut List<RuntimeProjection>, visiting: &mut ActiveProjections, span: Span)
  -> Option<Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let previous = run RuntimeType.resolved(value, List<RuntimeProjection>.asSlice(&projections.*))
  if let Option<Shared<Type>>.Some {..} = move previous {
    return Option<Shared<Rejection>>.none()
  }
  // Each level of a nested type is one entry, so compare only entries with an equal hash: a full
  // comparison against every active ancestor would make a deep nesting cubic.
  let hashed = Type.hash(value)
  let active = List<Shared<Type>>.asSlice(&visiting.types)
  let activeHashes = List<u64>.asSlice(&visiting.hashes)
  let mut at = usize.ZERO
  while at < active.length {
    if activeHashes[at] == hashed && run Type.equalsShared(&active[at], value) {
      return Option<Shared<Rejection>>.some(run reject(&resolver.*, DeclarationId.moduleId(Application.bodyDeclaration(caller)), RejectionCode.Unsupported, span))
    }
    at = at + usize.ONE
  }
  run List<Shared<Type>>.append(&mut visiting.types, Shared<Type>.clone(value))
  run List<u64>.append(&mut visiting.hashes, hashed)
  let result = run collectRuntimeProjectionInputs(&mut resolver.*, &mut owner.*, &mut dependencies.*, caller,
    bindings, value, &mut projections.*, &mut visiting.*, span)
  let last = List<Shared<Type>>.length(&visiting.types) - usize.ONE
  drop List<Shared<Type>>.remove(&mut visiting.types, last)
  List<u64>.truncate(&mut visiting.hashes, last)
  return move result
}

// The types a runtime projection walk is inside, with their hashes, to refuse a cycle.
struct ActiveProjections {
  types: List<Shared<Type>>,
  hashes: List<u64>,
}

// Whether a producer's body is being checked on the current query path. Its family's realization
// reads that body, so demanding it there would only rediscover the active query as a cycle.
effect fn activeOpaqueProducer(resolver: &mut Resolver, application: &Shared<Application>) -> bool
! Cycle | OutOfMemoryError ? &mut Allocator {
  resolver.pathReads = resolver.pathReads + usize.ONE
  let selected = run Application.copyShared(application)
  let identity = run Shared<DeclarationId>.make(DeclarationId.copy(Application.bodyDeclaration(&selected)))
  let module = DeclarationId.moduleId(Application.bodyDeclaration(&selected))
  let ordinal = match move run ordinalOfIdentity(&mut resolver.*, module, &identity) {
    Option<usize>.Some {value: found} => found
    _ => { return false }
  }
  let moduleOrdinal = knownModuleOrdinal(&resolver.*, module)
  let active = List<Word>.asSlice(&resolver.active)
  let keys = List<ScopedKey>.asSlice(&resolver.keys)
  let mut at = usize.ZERO
  while at < active.length {
    let key = keys[u64.toUsize(active[at].value)].key
    let declarationAccess173 = declarationPosition(&resolver.*, key)
    if key.family == Family.Body && key.module == moduleOrdinal && declarationAccess173 == ordinal { return true }
    at = at + usize.ONE
  }
  return false
}

// The finite storage an opaque producer family realizes to (EFF-013), demanded once per family.
effect fn realizedOpaqueStorage(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, application: &Shared<Application>, family: &Shared<Type>, span: Span)
  -> Result<Shared<Type>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let selected = run Application.copyShared(application)
  let identity = run Shared<DeclarationId>.make(DeclarationId.copy(Application.bodyDeclaration(&selected)))
  let module = DeclarationId.moduleId(Application.bodyDeclaration(&selected))
  let ordinal = match move run ordinalOfIdentity(&mut resolver.*, module, &identity) {
    Option<usize>.Some {value: found} => found
    _ => { return Result<Shared<Type>, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Unsupported, span)) }
  }
  let name = run internApplication(&mut resolver.*, family)
  let moduleOrdinal = knownModuleOrdinal(&resolver.*, module)
  let declarationAccess174Request = Key {
    family: Family.OpaqueRealization, module: moduleOrdinal, name: name,
    declaration: ordinal, member: usize.ZERO, external: false}
  let declarationAccess174 = run internDeclaration(&mut resolver.*, declarationAccess174Request)
  let answer = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, declarationAccess174, span)
  let refused = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(&answer, answerCause)
  if let Option<Shared<Rejection>>.Some {value: error} = move refused { return Result<Shared<Type>, Shared<Rejection>>.failResult(move error) }
  return match move Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(&answer, resolvedTypeAnswer) {
    Option<Shared<Type>>.Some {value: realized} => Result<Shared<Type>, Shared<Rejection>>.succeed(move realized)
    _ => Result<Shared<Type>, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Unsupported, span))
  }
}

effect fn collectRuntimeProjectionInputs(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, caller: &Application, bindings: &[Binding], value: &Shared<Type>,
  projections: &mut List<RuntimeProjection>, visiting: &mut ActiveProjections, span: Span)
  -> Option<Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let children = run RuntimeType.inputs(value)
  let inputs = List<Shared<Type>>.asSlice(&children)
  let mut at = usize.ZERO
  while at < inputs.length {
    let refused = run collectRuntimeProjection(&mut resolver.*, &mut owner.*, &mut dependencies.*, caller,
      bindings, &inputs[at], &mut projections.*, &mut visiting.*, span)
    if let Option<Shared<Rejection>>.Some {value: error} = move refused {
      return Option<Shared<Rejection>>.some(move error)
    }
    at = at + usize.ONE
  }
  let copied = run Type.copy(value)
  if let Type.OpaqueRepresentation {application, ..} = &copied {
    let storage = match move run realizedOpaqueStorage(&mut resolver.*, &mut owner.*, &mut dependencies.*, &application, value, span) {
      Result<Shared<Type>, Shared<Rejection>>.Success {value: realized} => move realized
      Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Option<Shared<Rejection>>.some(move error) }
    }
    let storageFailure = run collectRuntimeProjectionInputs(&mut resolver.*, &mut owner.*, &mut dependencies.*, caller,
      bindings, &storage, &mut projections.*, &mut visiting.*, span)
    if let Option<Shared<Rejection>>.Some {value: error} = move storageFailure { return Option<Shared<Rejection>>.some(move error) }
    let projected = run RuntimeType.project(&storage, List<RuntimeProjection>.asSlice(&projections.*))
    run List<RuntimeProjection>.append(&mut projections.*, RuntimeProjection {source: Shared<Type>.clone(value), storage: move projected})
    return Option<Shared<Rejection>>.none()
  }
  if let Type.CallableWitnessResult {..} = &copied {
    let module = DeclarationId.moduleId(Application.bodyDeclaration(caller))
    let premises = match move run closedApplicationPremises(&mut resolver.*, &mut owner.*, &mut dependencies.*, caller, bindings, span) {
      Option<List<Constraint>>.Some {value: declared} => move declared
      _ => { return Option<Shared<Rejection>>.some(run reject(&resolver.*, module, RejectionCode.Unsupported, span)) }
    }
    let storage = match move run normalizeCallableResult(&mut resolver.*, &mut owner.*, &mut dependencies.*, module,
      List<Constraint>.asSlice(&premises), value, span) {
      Result<Shared<Type>, Shared<Rejection>>.Success {value: realized} => move realized
      Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Option<Shared<Rejection>>.some(move error) }
    }
    if Type.containsCallableWitness(&storage) {
      return Option<Shared<Rejection>>.some(run reject(&resolver.*, module, RejectionCode.Unsupported, span))
    }
    let storageFailure = run collectRuntimeProjection(&mut resolver.*, &mut owner.*, &mut dependencies.*, caller,
      bindings, &storage, &mut projections.*, &mut visiting.*, span)
    if let Option<Shared<Rejection>>.Some {value: error} = move storageFailure { return Option<Shared<Rejection>>.some(move error) }
    let projected = run RuntimeType.project(&storage, List<RuntimeProjection>.asSlice(&projections.*))
    run List<RuntimeProjection>.append(&mut projections.*, RuntimeProjection {source: Shared<Type>.clone(value), storage: move projected})
    return Option<Shared<Rejection>>.none()
  }
  if let Type.CallableResult {producer, contract, arguments, selected, selectedOrdinals} = &copied {
    let realizedProducer = run RuntimeType.project(&producer, List<RuntimeProjection>.asSlice(&projections.*))
    let module = DeclarationId.moduleId(Application.bodyDeclaration(caller))
    let premises = match move run closedApplicationPremises(&mut resolver.*, &mut owner.*, &mut dependencies.*, caller, bindings, span) {
      Option<List<Constraint>>.Some {value: declared} => move declared
      _ => { return Option<Shared<Rejection>>.some(run reject(&resolver.*, module, RejectionCode.Unsupported, span)) }
    }
    let storage = match move run selectedCallableResult(&mut resolver.*, &mut owner.*, &mut dependencies.*, module,
      bindings, List<Constraint>.asSlice(&premises), &realizedProducer, &arguments, &contract, &selected, &selectedOrdinals, span) {
      Result<Shared<Type>, Shared<Rejection>>.Success {value: realized} => move realized
      Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Option<Shared<Rejection>>.some(move error) }
    }
    let storageFailure = run collectRuntimeProjection(&mut resolver.*, &mut owner.*, &mut dependencies.*, caller,
      bindings, &storage, &mut projections.*, &mut visiting.*, span)
    if let Option<Shared<Rejection>>.Some {value: error} = move storageFailure { return Option<Shared<Rejection>>.some(move error) }
    let projected = run RuntimeType.project(&storage, List<RuntimeProjection>.asSlice(&projections.*))
    run List<RuntimeProjection>.append(&mut projections.*, RuntimeProjection {source: Shared<Type>.clone(value), storage: move projected})
    return Option<Shared<Rejection>>.none()
  }
  if let Type.CallableStage {base, contract, captures, remaining, suffixMode} = move copied {
    let realizedBase = run RuntimeType.project(&base, List<RuntimeProjection>.asSlice(&projections.*))
    let storage = match move run stagedRuntimeSchema(&mut resolver.*, &mut owner.*, &mut dependencies.*, caller,
      bindings, &realizedBase, move contract, move captures, remaining, suffixMode, span) {
      Result<Shared<Type>, Shared<Rejection>>.Success {value: realized} => move realized
      Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Option<Shared<Rejection>>.some(move error) }
    }
    let projected = run RuntimeType.project(&storage, List<RuntimeProjection>.asSlice(&projections.*))
    run List<RuntimeProjection>.append(&mut projections.*, RuntimeProjection {
      source: Shared<Type>.clone(value), storage: move projected})
  }
  return Option<Shared<Rejection>>.none()
}

// Resolve only source invocation recipes. Opaque families, public views and physical capture
// identity remain semantic proof data; MIR preparation performs its separate storage projection.
effect fn normalizeCallableResult(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, module: &ModuleId, premises: &[Constraint], value: &Shared<Type>, span: Span)
  -> Result<Shared<Type>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  if privateOriginPhase(&resolver.*).phase == usize.ONE {
    return Result<Shared<Type>, Shared<Rejection>>.succeed(Shared<Type>.clone(value))
  }
  // Settled immutable source types have no normalization query or constructor work to perform.
  // Avoid repeated deep copies during finite graph solving and its mandatory whole-body replay.
  if !Type.needsCallableNormalization(value) {
    return Result<Shared<Type>, Shared<Rejection>>.succeed(Shared<Type>.clone(value))
  }
  let copied = run Type.copy(value)
  if let Type.CallableWitnessResult {witness} = &copied {
    return run normalizeCallableWitness(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, premises, &witness, span)
  }
  if let Type.CallableOrigin {application, contract} = &copied {
    let canonical = match move run normalizeCallableApplication(&mut resolver.*, &mut owner.*, &mut dependencies.*,
      module, premises, &application, span) {
      Result<Application, Shared<Rejection>>.Success {value: normalizedApplication} => move normalizedApplication
      Result<Application, Shared<Rejection>>.Failure {error} => { return Result<Shared<Type>, Shared<Rejection>>.failResult(move error) }
    }
    let exposed = match move run normalizeCallableChildren(&mut resolver.*, &mut owner.*, &mut dependencies.*,
      module, premises, &contract, span) {
      Result<Shared<Type>, Shared<Rejection>>.Success {value: normalizedContract} => move normalizedContract
      Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result<Shared<Type>, Shared<Rejection>>.failResult(move error) }
    }
    let selected = move canonical
    let found = match move run callableResultType(&mut resolver.*, &mut owner.*, &mut dependencies.*,
      &selected, premises, span) {
      Result<Shared<Type>, Shared<Rejection>>.Success {value: resolvedOrigin} => move resolvedOrigin
      Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result<Shared<Type>, Shared<Rejection>>.failResult(move error) }
    }
    return Result<Shared<Type>, Shared<Rejection>>.succeed(run Type.callableView(move found, move exposed))
  }
  if let Type.CallableView {representation, contract} = &copied {
    let original = match move run normalizeCallableResult(&mut resolver.*, &mut owner.*, &mut dependencies.*, module,
      premises, &representation, span) {
      Result<Shared<Type>, Shared<Rejection>>.Success {value: normalized} => move normalized
      Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result<Shared<Type>, Shared<Rejection>>.failResult(move error) }
    }
    let exposed = match move run normalizeCallableChildren(&mut resolver.*, &mut owner.*, &mut dependencies.*, module,
      premises, &contract, span) {
      Result<Shared<Type>, Shared<Rejection>>.Success {value: normalized} => move normalized
      Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result<Shared<Type>, Shared<Rejection>>.failResult(move error) }
    }
    return Result<Shared<Type>, Shared<Rejection>>.succeed(run Type.callableView(move original, move exposed))
  }
  if let Type.Reference {access, lifetime, referent} = &copied {
    let normalized = match move run normalizeCallableResult(&mut resolver.*, &mut owner.*, &mut dependencies.*, module,
      premises, &referent, span) {
      Result<Shared<Type>, Shared<Rejection>>.Success {value: original} => move original
      Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result<Shared<Type>, Shared<Rejection>>.failResult(move error) }
    }
    return Result<Shared<Type>, Shared<Rejection>>.succeed(run Types.intern(Type.Reference {
      access: access, lifetime: Shared<Lifetime>.clone(&lifetime), referent: move normalized}))
  }
  if let Type.CallableStage {base, contract, captures, remaining, suffixMode} = move copied {
    if Type.hasOpenRuntimeParameters(value) { return Result<Shared<Type>, Shared<Rejection>>.succeed(Shared<Type>.clone(value)) }
    let original = match move run normalizeCallableResult(&mut resolver.*, &mut owner.*, &mut dependencies.*, module,
      premises, &base, span) {
      Result<Shared<Type>, Shared<Rejection>>.Success {value: normalized} => move normalized
      Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result<Shared<Type>, Shared<Rejection>>.failResult(move error) }
    }
    let fields = match move run normalizeCallableTypes(&mut resolver.*, &mut owner.*, &mut dependencies.*, module,
      premises, List<Shared<Type>>.asSlice(&captures), span) {
      Result<List<Shared<Type>>, Shared<Rejection>>.Success {value: normalized} => move normalized
      Result<List<Shared<Type>>, Shared<Rejection>>.Failure {error} => { return Result<Shared<Type>, Shared<Rejection>>.failResult(move error) }
    }
    let exposed = match move run normalizeCallableChildren(&mut resolver.*, &mut owner.*, &mut dependencies.*, module,
      premises, &contract, span) {
      Result<Shared<Type>, Shared<Rejection>>.Success {value: normalized} => move normalized
      Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result<Shared<Type>, Shared<Rejection>>.failResult(move error) }
    }
    if privateOriginPhase(&resolver.*).phase == 2 && (pendingCallableSelection(&original) || pendingCallableSelection(&exposed)) {
      return Result<Shared<Type>, Shared<Rejection>>.succeed(run Types.intern(Type.CallableStage {base: move original, contract: move exposed, captures: move fields, remaining: remaining, suffixMode: suffixMode}))
    }
    let storage = callableProducerStorage(&original)
    let schema = Shared<Type>.with<Option<Shared<SectionSchema>>>(&storage, sectionSchemaOf)
    if let Option<Shared<SectionSchema>>.Some {..} = move schema {
      // Target selection computes the physical invocation mode. Retain the producer's weaker
      // public permission independently, just as direct Value/View staging does.
      let publicContract = Shared<Type>.clone(&exposed)
      let staged = match move run stagedCallableSchema(&mut resolver.*, &mut owner.*, &mut dependencies.*, module,
        premises, &storage, move exposed, move fields, remaining, suffixMode, span) {
        Result<Shared<Type>, Shared<Rejection>>.Success {value: normalized} => move normalized
        Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result<Shared<Type>, Shared<Rejection>>.failResult(move error) }
      }
      return Result<Shared<Type>, Shared<Rejection>>.succeed(run Type.callableView(move staged, move publicContract))
    }
    let target = originalCallableApplication(&original)
    if let Option<Shared<Application>>.Some {value: application} = move target {
      let recorded = run Application.copyShared(&application)
      return Result<Shared<Type>, Shared<Rejection>>.succeed(run Type.stagedCallable(move original, move exposed,
        move fields, remaining, suffixMode, Application.bodyDeclaration(&recorded)))
    }
    return Result<Shared<Type>, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Unsupported, span))
  }
  let recipe = run Type.copy(value)
  if let Type.CallableResult {producer, contract, arguments, selected, selectedOrdinals} = &recipe {
    if Type.hasOpenRuntimeParameters(value) { return Result<Shared<Type>, Shared<Rejection>>.succeed(Shared<Type>.clone(value)) }
    let original = match move run normalizeCallableResult(&mut resolver.*, &mut owner.*, &mut dependencies.*, module,
      premises, &producer, span) {
      Result<Shared<Type>, Shared<Rejection>>.Success {value: normalized} => move normalized
      Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result<Shared<Type>, Shared<Rejection>>.failResult(move error) }
    }
    let inputs = match move run normalizeCallableTypes(&mut resolver.*, &mut owner.*, &mut dependencies.*, module,
      premises, List<Shared<Type>>.asSlice(&arguments), span) {
      Result<List<Shared<Type>>, Shared<Rejection>>.Success {value: normalized} => move normalized
      Result<List<Shared<Type>>, Shared<Rejection>>.Failure {error} => { return Result<Shared<Type>, Shared<Rejection>>.failResult(move error) }
    }
    let values = match move run normalizeCallableArguments(&mut resolver.*, &mut owner.*, &mut dependencies.*, module,
      premises, List<Argument>.asSlice(&selected), span) {
      Result<List<Argument>, Shared<Rejection>>.Success {value: normalized} => move normalized
      Result<List<Argument>, Shared<Rejection>>.Failure {error} => { return Result<Shared<Type>, Shared<Rejection>>.failResult(move error) }
    }
    let exposed = match move run normalizeCallableChildren(&mut resolver.*, &mut owner.*, &mut dependencies.*, module,
      premises, &contract, span) {
      Result<Shared<Type>, Shared<Rejection>>.Success {value: normalized} => move normalized
      Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result<Shared<Type>, Shared<Rejection>>.failResult(move error) }
    }
    if privateOriginPhase(&resolver.*).phase == 2 && (pendingCallableSelection(&original) || pendingCallableSelection(&exposed)) {
      let mut ordinals = List<usize>.make()
      let slots = List<usize>.asSlice(&selectedOrdinals)
      let mut at = usize.ZERO
      while at < slots.length { run List<usize>.append(&mut ordinals, slots[at]) at = at + usize.ONE }
      return Result<Shared<Type>, Shared<Rejection>>.succeed(run Types.intern(Type.CallableResult {producer: move original, contract: move exposed, arguments: move inputs, selected: move values, selectedOrdinals: move ordinals}))
    }
    let none = List<Binding>.make()
    return run selectedCallableResult(&mut resolver.*, &mut owner.*, &mut dependencies.*, module,
      List<Binding>.asSlice(&none), premises, &original, &inputs, &exposed, &values, &selectedOrdinals, span)
  }
  return run normalizeCallableChildren(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, premises, value, span)
}

// An `effect fn` operation's Effect is the selected witness's construction: its application with
// the call's arguments as stored fields, exactly as calling the witness directly constructs it.
// A witness that borrows an owned operand would store a loan of a temporary (named gap).
effect fn witnessConstruction(resolver: &Resolver, module: &ModuleId, witness: ResolvedWitness, recipe: &WitnessRecipe,
  contract: Shared<Type>, span: Span) -> Result<Shared<Type>, Shared<Rejection>> ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let ResolvedWitness {application, operands} = move witness
  let passes = List<OperandPass>.asSlice(&operands)
  let mut captures = List<Shared<Type>>.make()
  let mut fieldInputs = List<CallableFieldInput>.make()
  let mut at = usize.ZERO
  while at < passes.length {
    if let OperandPass.Borrow {..} = &passes[at] {
      return Result<Shared<Type>, Shared<Rejection>>.failResult(run reject(resolver, module, RejectionCode.InterfaceEffectUnavailable, span))
    }
    run List<Shared<Type>>.append(&mut captures, CallableWitness.argumentAt(recipe, at))
    run List<CallableFieldInput>.append(&mut fieldInputs, CallableFieldInput.Argument {parameter: at})
    at = at + usize.ONE
  }
  return Result<Shared<Type>, Shared<Rejection>>.succeed(run Type.callableValue(false, run Shared<Application>.make(move application),
    move contract, move captures, move fieldInputs))
}

// All channels are free checked call-site evidence. Original operation and binding owners stay
// fixed while their values normalize; no interface declaration is invented as an executable key.
effect fn normalizeCallableWitness(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, module: &ModuleId, premises: &[Constraint], witness: &Shared<WitnessRecipe>, span: Span)
  -> Result<Shared<Type>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let original = Shared<WitnessRecipe>.with<WitnessRecipe>(witness, CallableWitness.copy)
  let mut channels = List<Shared<Type>>.make()
  run List<Shared<Type>>.append(&mut channels, Shared<Type>.clone(&original.contract))
  run List<Shared<Type>>.append(&mut channels, Shared<Type>.clone(&original.provider))
  run List<Shared<Type>>.append(&mut channels, Shared<Type>.clone(&original.result))
  let mut normalized = match move run normalizeCallableTypes(&mut resolver.*, &mut owner.*, &mut dependencies.*,
    module, premises, List<Shared<Type>>.asSlice(&channels), span) {
    Result<List<Shared<Type>>, Shared<Rejection>>.Success {value} => move value
    Result<List<Shared<Type>>, Shared<Rejection>>.Failure {error} => { return Result<Shared<Type>, Shared<Rejection>>.failResult(move error) }
  }
  let contract = List<Shared<Type>>.remove(&mut normalized, usize.ZERO)
  let provider = List<Shared<Type>>.remove(&mut normalized, usize.ZERO)
  let result = List<Shared<Type>>.remove(&mut normalized, usize.ZERO)
  let mut bindings = List<Binding>.make()
  let mut at = usize.ZERO
  while at < CallableWitness.bindingCount(&original) {
    let binding = CallableWitness.bindingAt(&original, at)
    let selected = match move run normalizeCallableArgument(&mut resolver.*, &mut owner.*, &mut dependencies.*,
      module, premises, &binding.value, span) {
      Result<Argument, Shared<Rejection>>.Success {value} => move value
      Result<Argument, Shared<Rejection>>.Failure {error} => { return Result<Shared<Type>, Shared<Rejection>>.failResult(move error) }
    }
    run List<Binding>.append(&mut bindings, Binding {declaration: move binding.declaration, ordinal: binding.ordinal, value: move selected})
    at = at + usize.ONE
  }
  let mut arguments = List<Shared<Type>>.make()
  at = usize.ZERO
  while at < CallableWitness.argumentCount(&original) {
    let selected = match move run normalizeCallableResult(&mut resolver.*, &mut owner.*, &mut dependencies.*,
      module, premises, &CallableWitness.argumentAt(&original, at), span) {
      Result<Shared<Type>, Shared<Rejection>>.Success {value} => move value
      Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result<Shared<Type>, Shared<Rejection>>.failResult(move error) }
    }
    run List<Shared<Type>>.append(&mut arguments, move selected)
    at = at + usize.ONE
  }
  let recipe = WitnessRecipe {operation: move original.operation, contract: move contract, provider: move provider, result: move result,
    bindings: run Shared<List<Binding>>.make(move bindings), arguments: run Shared<List<Shared<Type>>>.make(move arguments),
    loans: move original.loans, constructs: original.constructs}
  let exposed = Shared<Type>.clone(&recipe.result)
  let candidate = run Types.intern(Type.CallableWitnessResult {witness: run Shared<WitnessRecipe>.make(CallableWitness.copy(&recipe))})
  if Type.hasOpenRuntimeParameters(&candidate) {
    return Result<Shared<Type>, Shared<Rejection>>.succeed(move candidate)
  }
  let mut request = Request.make()
  let witnessApplication = match move run completedWitnessApplication(&mut resolver.*, &mut owner.*, &mut request,
    &mut dependencies.*, &recipe, module, span) {
    Result<ResolvedWitness, Shared<Rejection>>.Success {value} => move value
    Result<ResolvedWitness, Shared<Rejection>>.Failure {error} => { return Result<Shared<Type>, Shared<Rejection>>.failResult(move error) }
  }
  if recipe.constructs {
    return run witnessConstruction(&resolver.*, module, move witnessApplication, &recipe, move exposed, span)
  }
  let selected = match move run callableResultType(&mut resolver.*, &mut owner.*, &mut dependencies.*,
    &witnessApplication.application, premises, span) {
    Result<Shared<Type>, Shared<Rejection>>.Success {value} => move value
    Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result<Shared<Type>, Shared<Rejection>>.failResult(move error) }
  }
  return Result<Shared<Type>, Shared<Rejection>>.succeed(run Type.callableView(move selected, move exposed))
}

// Source normalization preserves declarations, opaque families and bound schema blueprints.
// Only free selected application channels and semantic child values may reveal closed recipes.
effect fn normalizeCallableChildren(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, module: &ModuleId, premises: &[Constraint], source: &Shared<Type>, span: Span)
  -> Result<Shared<Type>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  // Direct contract walkers also reach settled trees without the result entry point.
  if !Type.needsCallableNormalization(source) {
    return Result<Shared<Type>, Shared<Rejection>>.succeed(Shared<Type>.clone(source))
  }
  let copied = run Type.copy(source)
  match move copied {
    Type.CallableValue {isPublic, application, contract, captures, fieldInputs, ..} => {
      let selected = match move run normalizeCallableApplication(&mut resolver.*, &mut owner.*, &mut dependencies.*,
        module, premises, &application, span) {
        Result<Application, Shared<Rejection>>.Success {value} => move value
        Result<Application, Shared<Rejection>>.Failure {error} => { return Result<Shared<Type>, Shared<Rejection>>.failResult(move error) }
      }
      let fields = match move run normalizeCallableTypes(&mut resolver.*, &mut owner.*, &mut dependencies.*,
        module, premises, List<Shared<Type>>.asSlice(&captures), span) {
        Result<List<Shared<Type>>, Shared<Rejection>>.Success {value} => move value
        Result<List<Shared<Type>>, Shared<Rejection>>.Failure {error} => { return Result<Shared<Type>, Shared<Rejection>>.failResult(move error) }
      }
      let exposed = match move run normalizeCallableChildren(&mut resolver.*, &mut owner.*, &mut dependencies.*, module,
        premises, &contract, span) {
        Result<Shared<Type>, Shared<Rejection>>.Success {value} => move value
        Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result<Shared<Type>, Shared<Rejection>>.failResult(move error) }
      }
      return Result<Shared<Type>, Shared<Rejection>>.succeed(run Type.callableValue(isPublic,
        run Shared<Application>.make(move selected), move exposed, move fields, move fieldInputs))
    }
    Type.CallableSchema {schema, captures, fieldInputs, ..} => {
      let mut selected = run CallableSchema.copy(&schema)
      let arguments = List<Binding>.asMutSlice(&mut selected.selected)
      let mut at = usize.ZERO
      while at < arguments.length {
        let resolved = match move run normalizeCallableArgument(&mut resolver.*, &mut owner.*, &mut dependencies.*,
          module, premises, &arguments[at].value, span) {
          Result<Argument, Shared<Rejection>>.Success {value} => move value
          Result<Argument, Shared<Rejection>>.Failure {error} => { return Result<Shared<Type>, Shared<Rejection>>.failResult(move error) }
        }
        arguments[at].value = move resolved
        at = at + usize.ONE
      }
      let fields = match move run normalizeCallableTypes(&mut resolver.*, &mut owner.*, &mut dependencies.*,
        module, premises, List<Shared<Type>>.asSlice(&captures), span) {
        Result<List<Shared<Type>>, Shared<Rejection>>.Success {value} => move value
        Result<List<Shared<Type>>, Shared<Rejection>>.Failure {error} => { return Result<Shared<Type>, Shared<Rejection>>.failResult(move error) }
      }
      // contract/parameter/result blueprints retain the target's own bound variables unchanged.
      return Result<Shared<Type>, Shared<Rejection>>.succeed(run Type.callableSchema(
        run Shared<SectionSchema>.make(move selected), move fields, move fieldInputs))
    }
    Type.EffectComposite {operation, selector, contract, parts} => {
      let selected = match move run normalizeCallableResult(&mut resolver.*, &mut owner.*, &mut dependencies.*,
        module, premises, &selector, span) {
        Result<Shared<Type>, Shared<Rejection>>.Success {value} => move value
        Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result<Shared<Type>, Shared<Rejection>>.failResult(move error) }
      }
      let exposed = match move run normalizeCallableChildren(&mut resolver.*, &mut owner.*, &mut dependencies.*,
        module, premises, &contract, span) {
        Result<Shared<Type>, Shared<Rejection>>.Success {value} => move value
        Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result<Shared<Type>, Shared<Rejection>>.failResult(move error) }
      }
      let fields = match move run normalizeCallableTypes(&mut resolver.*, &mut owner.*, &mut dependencies.*,
        module, premises, List<Shared<Type>>.asSlice(&parts), span) {
        Result<List<Shared<Type>>, Shared<Rejection>>.Success {value} => move value
        Result<List<Shared<Type>>, Shared<Rejection>>.Failure {error} => { return Result<Shared<Type>, Shared<Rejection>>.failResult(move error) }
      }
      return Result<Shared<Type>, Shared<Rejection>>.succeed(run Types.intern(Type.EffectComposite {
        operation: operation, selector: move selected, contract: move exposed, parts: move fields}))
    }
    Type.Callable {mode, isUnsafe, environment, invocationBinders, invocationUse, invocationBounds, parameters, result} => {
      let inputs = match move run normalizeCallableTypes(&mut resolver.*, &mut owner.*, &mut dependencies.*, module,
        premises, List<Shared<Type>>.asSlice(&parameters), span) {
        Result<List<Shared<Type>>, Shared<Rejection>>.Success {value} => move value
        Result<List<Shared<Type>>, Shared<Rejection>>.Failure {error} => { return Result<Shared<Type>, Shared<Rejection>>.failResult(move error) }
      }
      let output = match move run normalizeCallableResult(&mut resolver.*, &mut owner.*, &mut dependencies.*, module,
        premises, &result, span) {
        Result<Shared<Type>, Shared<Rejection>>.Success {value} => move value
        Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result<Shared<Type>, Shared<Rejection>>.failResult(move error) }
      }
      return Result<Shared<Type>, Shared<Rejection>>.succeed(run Types.intern(Type.Callable {
        mode: mode, isUnsafe: isUnsafe, environment: move environment, invocationBinders: invocationBinders, invocationUse: invocationUse,
        invocationBounds: move invocationBounds, parameters: move inputs, result: move output}))
    }
    Type.Nominal {declaration, isPublic, arguments} => {
      let selected = match move run normalizeCallableArguments(&mut resolver.*, &mut owner.*, &mut dependencies.*,
        module, premises, List<Argument>.asSlice(&arguments), span) {
        Result<List<Argument>, Shared<Rejection>>.Success {value} => move value
        Result<List<Argument>, Shared<Rejection>>.Failure {error} => { return Result<Shared<Type>, Shared<Rejection>>.failResult(move error) }
      }
      return Result<Shared<Type>, Shared<Rejection>>.succeed(run Types.intern(Type.Nominal {
        declaration: move declaration, isPublic: isPublic, arguments: move selected}))
    }
    Type.OpaqueRepresentation {application, contract, detached, nonParking} => {
      let selected = match move run normalizeCallableApplication(&mut resolver.*, &mut owner.*, &mut dependencies.*,
        module, premises, &application, span) {
        Result<Application, Shared<Rejection>>.Success {value} => move value
        Result<Application, Shared<Rejection>>.Failure {error} => { return Result<Shared<Type>, Shared<Rejection>>.failResult(move error) }
      }
      let exposed = match move run normalizeCallableChildren(&mut resolver.*, &mut owner.*, &mut dependencies.*, module,
        premises, &contract, span) {
        Result<Shared<Type>, Shared<Rejection>>.Success {value} => move value
        Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result<Shared<Type>, Shared<Rejection>>.failResult(move error) }
      }
      return Result<Shared<Type>, Shared<Rejection>>.succeed(run Types.intern(Type.OpaqueRepresentation {
        application: run Shared<Application>.make(move selected), contract: move exposed, detached: detached, nonParking: nonParking}))
    }
    Type.Anonymous {occurrence, members} => {
      let selected = match move run normalizeCallableTypes(&mut resolver.*, &mut owner.*, &mut dependencies.*,
        module, premises, List<Shared<Type>>.asSlice(&members), span) {
        Result<List<Shared<Type>>, Shared<Rejection>>.Success {value} => move value
        Result<List<Shared<Type>>, Shared<Rejection>>.Failure {error} => { return Result<Shared<Type>, Shared<Rejection>>.failResult(move error) }
      }
      return Result<Shared<Type>, Shared<Rejection>>.succeed(run Types.intern(Type.Anonymous {occurrence: move occurrence, members: move selected}))
    }
    Type.Union {members} => {
      let selected = match move run normalizeCallableTypes(&mut resolver.*, &mut owner.*, &mut dependencies.*,
        module, premises, List<Shared<Type>>.asSlice(&members), span) {
        Result<List<Shared<Type>>, Shared<Rejection>>.Success {value} => move value
        Result<List<Shared<Type>>, Shared<Rejection>>.Failure {error} => { return Result<Shared<Type>, Shared<Rejection>>.failResult(move error) }
      }
      let mut joined = List<Shared<Type>>.make()
      let listed = List<Shared<Type>>.asSlice(&selected)
      let mut at = usize.ZERO
      while at < listed.length { run Type.joinMember(&mut joined, &listed[at]) at = at + usize.ONE }
      let canonical = List<Shared<Type>>.asSlice(&joined)
      if canonical.length == usize.ONE {
        return Result<Shared<Type>, Shared<Rejection>>.succeed(Shared<Type>.clone(&canonical[usize.ZERO]))
      }
      return Result<Shared<Type>, Shared<Rejection>>.succeed(run Types.intern(Type.Union {members: move joined}))
    }
    Type.Array {element, extent} => {
      let selected = match move run normalizeCallableResult(&mut resolver.*, &mut owner.*, &mut dependencies.*,
        module, premises, &element, span) {
        Result<Shared<Type>, Shared<Rejection>>.Success {value} => move value
        Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result<Shared<Type>, Shared<Rejection>>.failResult(move error) }
      }
      return Result<Shared<Type>, Shared<Rejection>>.succeed(run Types.intern(Type.Array {element: move selected, extent: move extent}))
    }
    Type.Slice {element, access, lifetime} => {
      let selected = match move run normalizeCallableResult(&mut resolver.*, &mut owner.*, &mut dependencies.*,
        module, premises, &element, span) {
        Result<Shared<Type>, Shared<Rejection>>.Success {value} => move value
        Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result<Shared<Type>, Shared<Rejection>>.failResult(move error) }
      }
      return Result<Shared<Type>, Shared<Rejection>>.succeed(run Types.intern(Type.Slice {element: move selected, access: access, lifetime: move lifetime}))
    }
    Type.Pointer {pointee, access, nullable, multiplicity, alignment} => {
      let selected = match move run normalizeCallableResult(&mut resolver.*, &mut owner.*, &mut dependencies.*,
        module, premises, &pointee, span) {
        Result<Shared<Type>, Shared<Rejection>>.Success {value} => move value
        Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result<Shared<Type>, Shared<Rejection>>.failResult(move error) }
      }
      return Result<Shared<Type>, Shared<Rejection>>.succeed(run Types.intern(Type.Pointer {pointee: move selected, access: access, nullable: nullable, multiplicity: multiplicity, alignment: move alignment}))
    }
    Type.TypeDescriptor {owner: described} => {
      let selected = match move run normalizeCallableResult(&mut resolver.*, &mut owner.*, &mut dependencies.*,
        module, premises, &described, span) {
        Result<Shared<Type>, Shared<Rejection>>.Success {value} => move value
        Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result<Shared<Type>, Shared<Rejection>>.failResult(move error) }
      }
      return Result<Shared<Type>, Shared<Rejection>>.succeed(run Types.intern(Type.TypeDescriptor {owner: move selected}))
    }
    _ => { return Result<Shared<Type>, Shared<Rejection>>.succeed(Shared<Type>.clone(source)) }
  }
}

effect fn normalizeCallableTypes(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, module: &ModuleId, premises: &[Constraint], values: &[Shared<Type>], span: Span)
  -> Result<List<Shared<Type>>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut output = List<Shared<Type>>.make()
  let mut at = usize.ZERO
  while at < values.length {
    let selected = match move run normalizeCallableResult(&mut resolver.*, &mut owner.*, &mut dependencies.*,
      module, premises, &values[at], span) {
      Result<Shared<Type>, Shared<Rejection>>.Success {value} => move value
      Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result<List<Shared<Type>>, Shared<Rejection>>.failResult(move error) }
    }
    run List<Shared<Type>>.append(&mut output, move selected)
    at = at + usize.ONE
  }
  return Result<List<Shared<Type>>, Shared<Rejection>>.succeed(move output)
}

effect fn normalizeCallableArgument(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, module: &ModuleId, premises: &[Constraint], source: &Argument, span: Span)
  -> Result<Argument, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  if let Argument.Type {value: ty} = &source.* {
    let selected = match move run normalizeCallableResult(&mut resolver.*, &mut owner.*, &mut dependencies.*,
      module, premises, &ty, span) {
      Result<Shared<Type>, Shared<Rejection>>.Success {value} => move value
      Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result<Argument, Shared<Rejection>>.failResult(move error) }
    }
    return Result<Argument, Shared<Rejection>>.succeed(Argument.Type {value: move selected})
  }
  return Result<Argument, Shared<Rejection>>.succeed(Argument.copy(source))
}

effect fn normalizeCallableArguments(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, module: &ModuleId, premises: &[Constraint], values: &[Argument], span: Span)
  -> Result<List<Argument>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut output = List<Argument>.make()
  let mut at = usize.ZERO
  while at < values.length {
    let selected = match move run normalizeCallableArgument(&mut resolver.*, &mut owner.*, &mut dependencies.*,
      module, premises, &values[at], span) {
      Result<Argument, Shared<Rejection>>.Success {value} => move value
      Result<Argument, Shared<Rejection>>.Failure {error} => { return Result<List<Argument>, Shared<Rejection>>.failResult(move error) }
    }
    run List<Argument>.append(&mut output, move selected)
    at = at + usize.ONE
  }
  return Result<List<Argument>, Shared<Rejection>>.succeed(move output)
}

effect fn normalizeCallableApplication(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, module: &ModuleId, premises: &[Constraint], source: &Shared<Application>, span: Span)
  -> Result<Application, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut selected = run Application.copyShared(source)
  let arguments = match move run normalizeCallableArguments(&mut resolver.*, &mut owner.*, &mut dependencies.*,
    module, premises, List<Argument>.asSlice(&selected.arguments), span) {
    Result<List<Argument>, Shared<Rejection>>.Success {value} => move value
    Result<List<Argument>, Shared<Rejection>>.Failure {error} => { return Result<Application, Shared<Rejection>>.failResult(move error) }
  }
  selected.arguments = move arguments
  let scopes = List<ScopeBinding>.asMutSlice(&mut selected.scopes)
  let mut at = usize.ZERO
  while at < scopes.length {
    let supplied = match move run normalizeCallableArguments(&mut resolver.*, &mut owner.*, &mut dependencies.*,
      module, premises, List<Argument>.asSlice(&scopes[at].arguments), span) {
      Result<List<Argument>, Shared<Rejection>>.Success {value} => move value
      Result<List<Argument>, Shared<Rejection>>.Failure {error} => { return Result<Application, Shared<Rejection>>.failResult(move error) }
    }
    scopes[at].arguments = move supplied
    at = at + usize.ONE
  }
  return Result<Application, Shared<Rejection>>.succeed(move selected)
}

// Target selection reads through public views and storage loans without changing their contracts.
fn callableProducerStorage(value: &Shared<Type>) -> Shared<Type> {
  let nested = Shared<Type>.with<Option<Shared<Type>>>(value, fn(node: &Type) -> Option<Shared<Type>> {
    return match &node.* {
      Type.CallableView {representation, ..} => Option<Shared<Type>>.some(Shared<Type>.clone(&representation))
      Type.Reference {referent, ..} => Option<Shared<Type>>.some(Shared<Type>.clone(&referent))
      _ => Option<Shared<Type>>.none()
    }
  })
  if let Option<Shared<Type>>.Some {value: child} = move nested { return callableProducerStorage(&child) }
  return Shared<Type>.clone(value)
}

effect fn selectedCallableResult(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, module: &ModuleId, bindings: &[Binding], premises: &[Constraint], producer: &Shared<Type>,
  arguments: &List<Shared<Type>>, contract: &Shared<Type>, selected: &List<Argument>, selectedOrdinals: &List<usize>, span: Span)
  -> Result<Shared<Type>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let original = callableProducerStorage(producer)
  let retained = originalCallableApplication(&original)
  let mut application = Option<Application>.none()
  if let Option<Shared<Application>>.Some {value} = move retained {
    let recorded = run Application.copyShared(&value)
    if DeclarationId.kind(Application.bodyDeclaration(&recorded)) == OwnerKind.Anonymous {
      let target = DeclarationId.copy(Application.bodyDeclaration(&recorded))
      let signature = run sectionOriginalSignature(&mut resolver.*, &mut owner.*, &mut dependencies.*, &target, span)
      let applied = run anonymousInvocationApplication(&recorded, &signature, List<Argument>.asSlice(selected), List<usize>.asSlice(selectedOrdinals))
      if let Result<Application, PreparationFailure>.Success {value: closed} = move applied { application = Option<Application>.some(move closed) }
    } else { application = Option<Application>.some(move recorded) }
  } else {
    let schema = Shared<Type>.with<Option<Shared<SectionSchema>>>(&original, sectionSchemaOf)
    if let Option<Shared<SectionSchema>>.Some {value} = move schema {
      let originalInputs = run sectionFieldInputs(&original)
      let found = run schemaCallableApplication(&mut resolver.*, &mut owner.*, &mut dependencies.*, module,
        bindings, premises, &value, List<CallableFieldInput>.asSlice(&originalInputs), List<Shared<Type>>.asSlice(arguments), span)
      if let Result<Application, PreparationFailure>.Success {value: closed} = move found { application = Option<Application>.some(move closed) }
    }
  }
  let closed = match move application { Option<Application>.Some {value} => move value
    _ => { return Result<Shared<Type>, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Unsupported, span)) } }
  let result = match move run callableResultType(&mut resolver.*, &mut owner.*, &mut dependencies.*, &closed, premises, span) {
    Result<Shared<Type>, Shared<Rejection>>.Success {value} => move value
    Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result<Shared<Type>, Shared<Rejection>>.failResult(move error) }
  }
  return Result<Shared<Type>, Shared<Rejection>>.succeed(run Type.callableView(move result, Shared<Type>.clone(contract)))
}

// The authored owner graph is finite even when its concrete pointer applications grow.
// Inspect symbolic fields before substitutions can erase a latent T | Leaf union.
struct UnionStorageBlueprint {
  hasUnion: bool,
  changesRepresentation: bool,
  unknown: bool,
}

fn unionStorageShape(value: &Type) -> bool {
  return match &value.* { Type.Union {..} => true _ => false }
}

fn unionStorageProjectionForm(value: &Type) -> bool {
  return match &value.* {
    Type.OpaqueRepresentation {..} => true
    Type.CallableView {..} => true
    Type.CallableOrigin {..} => true
    Type.CallableResult {..} => true
    Type.CallableWitnessResult {..} => true
    Type.CallableStage {..} => true
    _ => false
  }
}

effect fn unionStorageIdentity(value: &Shared<Type>) -> Option<Shared<Type>>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let copied = run Type.copy(value)
  if let Type.Nominal {declaration, isPublic, arguments} = move copied {
    let listed = List<Argument>.asSlice(&arguments)
    let mut generic = List<Argument>.make()
    let mut at = usize.ZERO
    while at < listed.length {
      match &listed[at] {
        Argument.Type {..} => run List<Argument>.append(&mut generic, Argument.Type {
          value: run Types.intern(Type.Parameter {declaration: DeclarationId.copy(&declaration), ordinal: at})})
        Argument.Lifetime {..} => run List<Argument>.append(&mut generic, Argument.Lifetime {
          value: run Shared<Lifetime>.make(Lifetime.Parameter {declaration: DeclarationId.copy(&declaration), ordinal: at})})
        // A changing static or row family needs its own symbolic storage proof.
        _ => { return Option<Shared<Type>>.none() }
      }
      at = at + usize.ONE
    }
    return Option<Shared<Type>>.some(run Types.intern(Type.Nominal {
      declaration: move declaration, isPublic: isPublic, arguments: move generic}))
  }
  return Option<Shared<Type>>.none()
}

effect fn unionStorageBlueprint(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, value: &Shared<Type>, projections: &[RuntimeProjection],
  owners: &mut List<Shared<Type>>, facts: &mut UnionStorageBlueprint, span: Span) -> Option<Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  if Shared<Type>.with<bool>(value, unionStorageShape) { facts.hasUnion = true }
  if Shared<Type>.with<bool>(value, unionStorageProjectionForm) { facts.changesRepresentation = true }
  let projected = run RuntimeType.project(value, projections)
  if !run Type.equalsShared(value, &projected) { facts.changesRepresentation = true }
  // Check actual finite argument trees independently of the nominal-owner cutoff.
  let children = run RuntimeType.inputs(value)
  let listed = List<Shared<Type>>.asSlice(&children)
  let mut at = usize.ZERO
  while at < listed.length {
    let rejected = run unionStorageBlueprint(&mut resolver.*, &mut owner.*, &mut dependencies.*,
      &listed[at], projections, &mut owners.*, &mut facts.*, span)
    if let Option<Shared<Rejection>>.Some {value: error} = move rejected { return Option<Shared<Rejection>>.some(move error) }
    at = at + usize.ONE
  }
  if !Shared<Type>.with<bool>(value, isNominalType) { return Option<Shared<Rejection>>.none() }
  let earlier = List<Shared<Type>>.asSlice(&owners.*)
  at = usize.ZERO
  while at < earlier.length {
    if sameNominal(value, &earlier[at]) { return Option<Shared<Rejection>>.none() }
    at = at + usize.ONE
  }
  run List<Shared<Type>>.append(&mut owners.*, Shared<Type>.clone(value))
  let identity = match move run unionStorageIdentity(value) {
    Option<Shared<Type>>.Some {value: symbolic} => move symbolic
    _ => {
      facts.unknown = true
      return Option<Shared<Rejection>>.none()
    }
  }
  let parts = match move run nominalParts(&mut resolver.*, &mut owner.*, &mut dependencies.*, &identity, span) {
    Result<List<Shared<Type>>, Shared<Rejection>>.Success {value: fields} => move fields
    Result<List<Shared<Type>>, Shared<Rejection>>.Failure {error} => { return Option<Shared<Rejection>>.some(move error) }
  }
  let fields = List<Shared<Type>>.asSlice(&parts)
  at = usize.ZERO
  while at < fields.length {
    let rejected = run unionStorageBlueprint(&mut resolver.*, &mut owner.*, &mut dependencies.*,
      &fields[at], projections, &mut owners.*, &mut facts.*, span)
    if let Option<Shared<Rejection>>.Some {value: error} = move rejected { return Option<Shared<Rejection>>.some(move error) }
    at = at + usize.ONE
  }
  return Option<Shared<Rejection>>.none()
}

// A descriptor can carry a union without generating an injection or payload operation.
// Ordinary generic alias collapse precedes this check; only representation projection must
// preserve an injective map. Tag-bearing operations validate their original ordinals separately.
effect fn validateRuntimeUnionMaps(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, value: &Shared<Type>, bindings: &[Binding], projections: &[RuntimeProjection],
  visited: &mut List<Shared<Type>>, visitedLookup: &mut InternIndex, active: &mut List<Shared<Type>>, module: &ModuleId, span: Span)
-> Option<Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let closed = run Type.applyBindings(value, bindings, true)
  let empty = List<Binding>.make()
  let noBindings = List<Binding>.asSlice(&empty)
  let hashed = Type.hash(&closed)
  if run knownType(List<Shared<Type>>.asSlice(&visited.*), &visitedLookup.*, &closed, hashed) { return Option<Shared<Rejection>>.none() }
  let mut at = usize.ZERO
  let storage = run RuntimeType.project(&closed, projections)
  if Shared<Type>.with<bool>(&closed, unionStorageShape) && !Shared<Type>.with<bool>(&closed, neverType)
    && !run Type.equalsShared(&closed, &storage) {
    let mapped = run UnionProjection.map(&closed, noBindings, projections)
    if let Option<List<UnionProjection.Member>>.None = move mapped {
      return Option<Shared<Rejection>>.some(run reject(&resolver.*, module, RejectionCode.UnionFormUnavailable, span))
    }
  }
  run List<Shared<Type>>.append(&mut visited.*, Shared<Type>.clone(&closed))
  run InternIndex.record(&mut visitedLookup.*, hashed)
  let nominal = Shared<Type>.with<bool>(&closed, isNominalType)
  // Finite argument subtrees are checked even when a later field edge repeats its owner.
  let children = run RuntimeType.inputs(&closed)
  let listed = List<Shared<Type>>.asSlice(&children)
  at = usize.ZERO
  while at < listed.length {
    let rejected = run validateRuntimeUnionMaps(&mut resolver.*, &mut owner.*, &mut dependencies.*, &listed[at],
      noBindings, projections, &mut visited.*, &mut visitedLookup.*, &mut active.*, module, span)
    if let Option<Shared<Rejection>>.Some {value: error} = move rejected { return Option<Shared<Rejection>>.some(move error) }
    at = at + usize.ONE
  }
  if !nominal { return Option<Shared<Rejection>>.none() }
  // This proof covers ABI changes introduced through projected nominal arguments. An unchanged
  // descriptor referent does not demand unrelated field validity (including elided field binders).
  if run Type.equalsShared(&closed, &storage) { return Option<Shared<Rejection>>.none() }
  let path = List<Shared<Type>>.asSlice(&active.*)
  at = usize.ZERO
  while at < path.length {
    if sameNominal(&closed, &path[at]) {
      let mut owners = List<Shared<Type>>.make()
      let mut facts = UnionStorageBlueprint {hasUnion: false, changesRepresentation: false, unknown: false}
      let rejected = run unionStorageBlueprint(&mut resolver.*, &mut owner.*, &mut dependencies.*, &closed,
        projections, &mut owners, &mut facts, span)
      if let Option<Shared<Rejection>>.Some {value: error} = move rejected { return Option<Shared<Rejection>>.some(move error) }
      if facts.unknown || (facts.hasUnion && facts.changesRepresentation) {
        return Option<Shared<Rejection>>.some(run reject(&resolver.*, module, RejectionCode.UnionFormUnavailable, span))
      }
      return Option<Shared<Rejection>>.none()
    }
    at = at + usize.ONE
  }
  run List<Shared<Type>>.append(&mut active.*, Shared<Type>.clone(&closed))
  let parts = match move run nominalParts(&mut resolver.*, &mut owner.*, &mut dependencies.*, &closed, span) {
    Result<List<Shared<Type>>, Shared<Rejection>>.Success {value: fields} => move fields
    Result<List<Shared<Type>>, Shared<Rejection>>.Failure {error} => { return Option<Shared<Rejection>>.some(move error) }
  }
  let fields = List<Shared<Type>>.asSlice(&parts)
  at = usize.ZERO
  while at < fields.length {
    let rejected = run validateRuntimeUnionMaps(&mut resolver.*, &mut owner.*, &mut dependencies.*, &fields[at],
      noBindings, projections, &mut visited.*, &mut visitedLookup.*, &mut active.*, module, span)
    if let Option<Shared<Rejection>>.Some {value: error} = move rejected { return Option<Shared<Rejection>>.some(move error) }
    at = at + usize.ONE
  }
  drop List<Shared<Type>>.pop(&mut active.*)
  return Option<Shared<Rejection>>.none()
}

effect fn runtimeProjections(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, caller: &Application, bindings: &[Binding], body: &Shared<TypedBody>,
  result: &Shared<Type>, parameters: &[Shared<Type>], anchor: &Anchor) -> Result<List<RuntimeProjection>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let locals = Shared<TypedBody>.with<usize>(body, fn(value: &TypedBody) -> usize { return TypedBody.localSlice(value).length })
  let nodes = Shared<TypedBody>.with<usize>(body, fn(value: &TypedBody) -> usize { return TypedBody.nodeSlice(value).length })
  let span = Shared<TypedBody>.with<Span>(body, fn(value: &TypedBody) -> Span {
    return BodyOrigin.span(TypedBody.nodeSlice(value)[TypedBody.rootNode(value).index].origin, anchor)
  })
  // Most written types repeat across a body's locals and nodes, and an equal written type closes
  // to an equal type, so each distinct one is bound and walked once, in first-written order.
  // Projection evidence is keyed by exact identity, so the written types are compared exactly.
  let mut written = List<Shared<Type>>.make()
  let mut writtenLookup = InternIndex.make()
  let mut closedTypes = List<Shared<Type>>.make()
  let mut at = usize.ZERO
  while at < locals + nodes + parameters.length + usize.ONE {
    let candidate = runtimeProjectionType(body, result, parameters, locals, nodes, at)
    if let Option<Shared<Type>>.Some {value} = move candidate {
      let hashed = Type.hash(&value)
      let found = run exactTypeAt(List<Shared<Type>>.asSlice(&written), &writtenLookup, &value, hashed)
      if found == List<Shared<Type>>.length(&written) {
        run List<Shared<Type>>.append(&mut closedTypes, run Type.applyBindings(&value, bindings, true))
        run List<Shared<Type>>.append(&mut written, move value)
        run InternIndex.record(&mut writtenLookup, hashed)
      }
    }
    at = at + usize.ONE
  }
  let closed = List<Shared<Type>>.asSlice(&closedTypes)
  let mut projections = List<RuntimeProjection>.make()
  let mut visiting = ActiveProjections {types: List<Shared<Type>>.make(), hashes: List<u64>.make()}
  at = usize.ZERO
  while at < closed.length {
    let refused = run collectRuntimeProjection(&mut resolver.*, &mut owner.*, &mut dependencies.*, caller,
      bindings, &closed[at], &mut projections, &mut visiting, span)
    if let Option<Shared<Rejection>>.Some {value: error} = move refused {
      return Result<List<RuntimeProjection>, Shared<Rejection>>.failResult(move error)
    }
    at = at + usize.ONE
  }
  let noBindings = List<Binding>.make()
  let mut mapped = List<Shared<Type>>.make()
  let mut mappedLookup = InternIndex.make()
  let mut mappingPath = List<Shared<Type>>.make()
  at = usize.ZERO
  while at < closed.length {
    let rejected = run validateRuntimeUnionMaps(&mut resolver.*, &mut owner.*, &mut dependencies.*, &closed[at],
      List<Binding>.asSlice(&noBindings), List<RuntimeProjection>.asSlice(&projections), &mut mapped, &mut mappedLookup,
      &mut mappingPath, DeclarationId.moduleId(Application.bodyDeclaration(caller)), span)
    if let Option<Shared<Rejection>>.Some {value: error} = move rejected {
      return Result<List<RuntimeProjection>, Shared<Rejection>>.failResult(move error)
    }
    at = at + usize.ONE
  }
  let realized = List<RuntimeProjection>.asSlice(&projections)
  at = usize.ZERO
  while at < realized.length {
    let rejected = run validateRuntimeUnionMaps(&mut resolver.*, &mut owner.*, &mut dependencies.*, &realized[at].storage,
      bindings, realized, &mut mapped, &mut mappedLookup, &mut mappingPath, DeclarationId.moduleId(Application.bodyDeclaration(caller)), span)
    if let Option<Shared<Rejection>>.Some {value: error} = move rejected {
      return Result<List<RuntimeProjection>, Shared<Rejection>>.failResult(move error)
    }
    at = at + usize.ONE
  }
  return Result<List<RuntimeProjection>, Shared<Rejection>>.succeed(move projections)
}

fn runtimeProjectionType(body: &Shared<TypedBody>, result: &Shared<Type>, parameters: &[Shared<Type>],
  locals: usize, nodes: usize, at: usize) -> Option<Shared<Type>> {
  if at < locals { return Option<Shared<Type>>.some(Shared<TypedBody>.with<Shared<Type>>(body,
    fn(value: &TypedBody) -> Shared<Type> {
      let listed = TypedBody.localSlice(value)
      return Shared<Type>.clone(&listed[at].ty)
    })) }
  if at < locals + nodes { return Shared<TypedBody>.with<Option<Shared<Type>>>(body,
    fn(value: &TypedBody) -> Option<Shared<Type>> { return nodeTypeAt(value, at - locals) }) }
  if at < locals + nodes + parameters.length {
    return Option<Shared<Type>>.some(Shared<Type>.clone(&parameters[at - locals - nodes]))
  }
  return Option<Shared<Type>>.some(Shared<Type>.clone(result))
}

// What the region check reads of one typed body besides the body itself (`RegionCheck.Input`),
// owned here so that `regionInput` can lend it together with the body.
struct RegionFacts {
  parameters: usize,
  // Whether the body is anonymous, and its by-reference captures.
  anonymous: bool,
  environment: List<EnvironmentAlias>,
  result: Shared<Type>,
  failure: Shared<Type>,
  unit: Shared<Type>,
  premises: List<RegionPremise>,
  parameterPremises: List<ContentsBound>,
  representations: List<RegionRepresentation>,
  contracts: List<CallContract>,
  constructions: List<ConstructionShape>,
  variances: List<DeclaredVariance>,
  drops: List<DeclaredDrop>,
}

fn regionInput<'a>(facts: &'a RegionFacts, identity: &'a DeclarationId, locals: &'a [BodyLocal], nodes: &'a [BodyNode],
  root: BodyNodeId) -> RegionInput<'a> {
  return RegionInput<'a> {owner: identity, locals: locals, parameters: facts.parameters, nodes: nodes, root: root,
    result: &facts.result, failure: &facts.failure, unit: &facts.unit, premises: List<RegionPremise>.asSlice(&facts.premises),
    parameterPremises: List<ContentsBound>.asSlice(&facts.parameterPremises),
    representations: List<RegionRepresentation>.asSlice(&facts.representations),
    contracts: List<CallContract>.asSlice(&facts.contracts), constructions: List<ConstructionShape>.asSlice(&facts.constructions),
    variances: List<DeclaredVariance>.asSlice(&facts.variances), drops: List<DeclaredDrop>.asSlice(&facts.drops),
    anonymous: facts.anonymous, environment: List<EnvironmentAlias>.asSlice(&facts.environment)}
}

// A copy of an anonymous body's region requirements, for its construction.
effect fn copyRequirements(required: &[BodyRegionRequirement]) -> List<BodyRegionRequirement> ! OutOfMemoryError ? &mut Allocator {
  let mut copied = List<BodyRegionRequirement>.make()
  let mut at = usize.ZERO
  while at < required.length {
    run List<BodyRegionRequirement>.append(&mut copied, BodyRegionRequirement {longer: Shared<Lifetime>.clone(&required[at].longer),
      shorter: Shared<Lifetime>.clone(&required[at].shorter), site: required[at].site})
    at = at + usize.ONE
  }
  return move copied
}

// Builds the facts the region check reads about a typed body. The first `parameters` locals are typed
// by the body's signature: an anonymous body's captured outer locals, then its own parameters.
// `signatures` are those whose implied bounds the body assumes: its own, and an anonymous body's
// enclosing root body's. `constraints` are the bounds it declares or inherits.
effect fn regionFacts(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, dependencies: &mut List<Dependency>,
  identity: &DeclarationId, signatures: &[Shared<Result<Answer, NoRejection>>], result: &Shared<Type>, failure: &Shared<Type>,
  parameters: usize, locals: &[BodyLocal], nodes: &[BodyNode], root: BodyNodeId, constraints: &[Constraint], anchor: &Anchor,
) -> Result<RegionFacts, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let span = BodyOrigin.span(nodes[root.index].origin, anchor)
  let mut premises = List<RegionPremise>.make()
  let mut parameterPremises = List<ContentsBound>.make()
  let mut representations = List<RegionRepresentation>.make()
  run regionPremises(&mut resolver.*, &mut owner.*, &mut dependencies.*, identity, signatures, constraints, span, &mut premises,
    &mut parameterPremises, &mut representations)
  run sectionRepresentations(&mut resolver.*, &mut owner.*, &mut dependencies.*, nodes, span, &mut representations)
  let providers = run bodyProviders(signatures)
  let contracts = run callContracts(&mut resolver.*, &mut owner.*, &mut dependencies.*, identity, nodes, constraints,
    List<Shared<Type>>.asSlice(&providers), anchor)
  let constructions = run constructionShapes(&mut resolver.*, &mut owner.*, &mut dependencies.*, nodes, anchor)
  let declarations = run bodyDeclarations(locals, nodes, result, failure)
  let named = List<DeclarationId>.asSlice(&declarations)
  let mut variances = List<DeclaredVariance>.make()
  let mut drops = List<DeclaredDrop>.make()
  let mut at = usize.ZERO
  while at < named.length {
    if let Option<List<Variance>>.Some {value} = move run declarationVariances(&mut resolver.*, &mut owner.*, &mut dependencies.*,
      &named[at], span) {
      run List<DeclaredVariance>.append(&mut variances, DeclaredVariance {declaration: DeclarationId.copy(&named[at]), binders: move value})
    }
    if let Option<List<DropUse>>.Some {value} = move run declarationDrops(&mut resolver.*, &mut owner.*, &mut dependencies.*,
      &named[at], span) {
      run List<DeclaredDrop>.append(&mut drops, DeclaredDrop {declaration: DeclarationId.copy(&named[at]), binders: move value})
    }
    at = at + usize.ONE
  }
  return Result<RegionFacts, Shared<Rejection>>.succeed(RegionFacts {parameters: parameters, anonymous: false,
    environment: List<EnvironmentAlias>.make(), result: Shared<Type>.clone(result),
    failure: Shared<Type>.clone(failure), unit: run Types.intern(Type.Unit), premises: move premises, parameterPremises: move parameterPremises,
    representations: move representations, contracts: move contracts, constructions: move constructions,
    variances: move variances, drops: move drops})
}

// Every nominal declaration the body's types name. The check reads their `Variance` answers to relate
// their applications and their `DropObservation` answers to find what cleanup reads; a declaration
// without an answer has its binders related invariantly and its cleanup taken to read every region.
// A section's contract leaves its target's deferred binders open, and a binder that represents a
// callable or Effect parameter stands for the contract its target's signature gives it, as an
// enclosing representation parameter does (`regionPremises`).
effect fn sectionRepresentations(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, dependencies: &mut List<Dependency>,
  nodes: &[BodyNode], span: Span, representations: &mut List<RegionRepresentation>) -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut targets = List<DeclarationId>.make()
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {ty, ..} = &nodes[at].kind {
      let target = Shared<Type>.with<Option<DeclarationId>>(&ty, fn(value: &Type) -> Option<DeclarationId> {
        return match &value.* {
          Type.CallableSchema {schema, ..} => Option<DeclarationId>.some(Shared<SectionSchema>.with<DeclarationId>(&schema,
            fn(staged: &SectionSchema) -> DeclarationId { return DeclarationId.copyShared(&staged.target) }))
          _ => Option<DeclarationId>.none()
        }
      })
      if let Option<DeclarationId>.Some {value: declaration} = move target {
        let listed = List<DeclarationId>.asSlice(&targets)
        let mut seen = false
        let mut each = usize.ZERO
        while each < listed.length {
          if DeclarationId.equals(&listed[each], &declaration) { seen = true }
          each = each + usize.ONE
        }
        if !seen { run List<DeclarationId>.append(&mut targets, move declaration) }
      }
    }
    at = at + usize.ONE
  }
  let listed = List<DeclarationId>.asSlice(&targets)
  at = usize.ZERO
  while at < listed.length {
    let signature = run sectionOriginalSignature(&mut resolver.*, &mut owner.*, &mut dependencies.*, &listed[at], span)
    let count = Shared<Result<Answer, NoRejection>>.with<usize>(&signature, signatureConstraintCount)
    let mut index = usize.ZERO
    while index < count {
      let bound = Shared<Result<Answer, NoRejection>>.with<Option<Constraint>>(&signature,
        fn(answer: &Result<Answer, NoRejection>) -> Option<Constraint> { return signatureConstraint(answer, index) })
      if let Option<Constraint>.Some {value} = &bound {
        if let Constraint.Represents {parameter, contract} = &value {
          run List<RegionRepresentation>.append(&mut representations.*, RegionRepresentation {parameter: Shared<Type>.clone(&parameter),
            contract: Shared<Type>.clone(&contract)})
        }
      }
      index = index + usize.ONE
    }
    at = at + usize.ONE
  }
  return ()
}

effect fn bodyDeclarations(locals: &[BodyLocal], nodes: &[BodyNode], result: &Shared<Type>, failure: &Shared<Type>)
  -> List<DeclarationId> ! OutOfMemoryError ? &mut Allocator {
  let mut pending = List<Shared<Type>>.make()
  run List<Shared<Type>>.append(&mut pending, Shared<Type>.clone(result))
  run List<Shared<Type>>.append(&mut pending, Shared<Type>.clone(failure))
  let mut at = usize.ZERO
  while at < locals.length {
    run List<Shared<Type>>.append(&mut pending, Shared<Type>.clone(&locals[at].ty))
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {ty, ..} = &nodes[at].kind {
      run List<Shared<Type>>.append(&mut pending, Shared<Type>.clone(&ty))
    }
    at = at + usize.ONE
  }
  let mut named = List<DeclarationId>.make()
  while List<Shared<Type>>.length(&pending) != usize.ZERO {
    let last = List<Shared<Type>>.length(&pending) - usize.ONE
    let ty = List<Shared<Type>>.remove(&mut pending, last)
    let declared = Shared<Type>.with<Option<DeclarationId>>(&ty, fn(node: &Type) -> Option<DeclarationId> {
      return match &node.* {
        Type.Nominal {declaration, ..} => Option<DeclarationId>.some(DeclarationId.copy(&declaration))
        _ => Option<DeclarationId>.none()
      }
    })
    if let Option<DeclarationId>.Some {value: declaration} = move declared {
      if !declarationListed(List<DeclarationId>.asSlice(&named), &declaration) {
        run List<DeclarationId>.append(&mut named, move declaration)
      }
    }
    let parts = Type.partCount(&ty)
    let mut part = usize.ZERO
    while part < parts {
      if let Option<Shared<Type>>.Some {value} = move Type.partAt(&ty, part) {
        run List<Shared<Type>>.append(&mut pending, move value)
      }
      part = part + usize.ONE
    }
  }
  return move named
}

fn declarationListed(named: &[DeclarationId], declaration: &DeclarationId) -> bool {
  let mut at = usize.ZERO
  while at < named.length {
    if DeclarationId.equals(&named[at], declaration) { return true }
    at = at + usize.ONE
  }
  return false
}

// What cleanup of `declaration` observes of each binder, when its `DropObservation` answer has one.
effect fn declarationDrops(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, dependencies: &mut List<Dependency>,
  declaration: &DeclarationId, span: Span) -> Option<List<DropUse>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let key = match move run nominalKey(&mut resolver.*, Family.DropObservation, declaration) {
    Option<Key>.Some {value} => value
    Option<Key>.None => { return Option<List<DropUse>>.none() }
  }
  let answer = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, key, span)
  let count = Shared<Result<Answer, NoRejection>>.with<usize>(&answer, dropUseCount)
  if count == usize.MAX { return Option<List<DropUse>>.none() }
  let mut binders = List<DropUse>.make()
  let mut at = usize.ZERO
  while at < count {
    run List<DropUse>.append(&mut binders, Shared<Result<Answer, NoRejection>>.with<DropUse>(&answer,
      fn(value: &Result<Answer, NoRejection>) -> DropUse { return dropUseAt(value, at) }))
    at = at + usize.ONE
  }
  return Option<List<DropUse>>.some(move binders)
}

// How many binders a `DropObservation` answer lists; `usize.MAX` for any other answer.
fn dropUseCount(answer: &Result<Answer, NoRejection>) -> usize {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.DropObservation {binders}} = &value.outcome { return List<DropUse>.length(&binders) }
  }
  return usize.MAX
}

fn dropUseAt(answer: &Result<Answer, NoRejection>, at: usize) -> DropUse {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.DropObservation {binders}} = &value.outcome {
      let listed = List<DropUse>.asSlice(&binders)
      if at < listed.length { return listed[at] }
    }
  }
  return DropUse.Observed
}

// The variance of each binder of `declaration`, when its `Variance` answer has one.
effect fn declarationVariances(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, dependencies: &mut List<Dependency>,
  declaration: &DeclarationId, span: Span) -> Option<List<Variance>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let key = match move run nominalKey(&mut resolver.*, Family.Variance, declaration) {
    Option<Key>.Some {value} => value
    Option<Key>.None => { return Option<List<Variance>>.none() }
  }
  let answer = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, key, span)
  let count = Shared<Result<Answer, NoRejection>>.with<usize>(&answer, varianceCount)
  if count == usize.MAX { return Option<List<Variance>>.none() }
  let mut binders = List<Variance>.make()
  let mut at = usize.ZERO
  while at < count {
    run List<Variance>.append(&mut binders, Shared<Result<Answer, NoRejection>>.with<Variance>(&answer,
      fn(value: &Result<Answer, NoRejection>) -> Variance { return varianceAt(value, at) }))
    at = at + usize.ONE
  }
  return Option<List<Variance>>.some(move binders)
}

// How many binders a `Variance` answer lists; `usize.MAX` for any other answer.
fn varianceCount(answer: &Result<Answer, NoRejection>) -> usize {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Variance {binders}} = &value.outcome { return List<Variance>.length(&binders) }
  }
  return usize.MAX
}

// The bounds the body assumes between two of its universal lifetimes: its declared bounds and those
// its signatures imply, with each contents bound reduced to the regions its subject names.
// `representations` are the contracts its type parameters represent.
effect fn regionPremises(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, dependencies: &mut List<Dependency>,
  identity: &DeclarationId, signatures: &[Shared<Result<Answer, NoRejection>>], constraints: &[Constraint], span: Span,
  premises: &mut List<RegionPremise>, parameterPremises: &mut List<ContentsBound>, representations: &mut List<RegionRepresentation>) -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut assumed = run copyConstraints(constraints)
  let mut at = usize.ZERO
  while at < signatures.length {
    let implied = run signatureImpliedBounds(&mut resolver.*, &mut owner.*, &mut dependencies.*, &signatures[at], false, span)
    run appendConstraints(&mut assumed, List<Constraint>.asSlice(&implied))
    at = at + usize.ONE
  }
  let edges = run contentsOutlives(List<Constraint>.asSlice(&assumed), identity)
  let listed = List<Constraint>.asSlice(&edges)
  at = usize.ZERO
  while at < listed.length {
    if let Constraint.Outlives {longer, shorter} = &listed[at] {
      if universalLifetime(&longer, identity) && universalLifetime(&shorter, identity) {
        run List<RegionPremise>.append(&mut premises.*, RegionPremise {longer: Shared<Lifetime>.clone(&longer),
          shorter: Shared<Lifetime>.clone(&shorter)})
      }
    }
    // What a type parameter's values hold stays a premise on the parameter itself.
    if let Constraint.Contents {subject, region} = &listed[at] {
      let mut stored = List<Shared<Type>>.make()
      run Type.storedParameters(&subject, &mut stored)
      if List<Shared<Type>>.length(&stored) != usize.ZERO && universalLifetime(&region, identity) {
        run List<ContentsBound>.append(&mut parameterPremises.*, ContentsBound {subject: Shared<Type>.clone(&subject),
          region: Shared<Lifetime>.clone(&region)})
      }
    }
    at = at + usize.ONE
  }
  // A callable representation bound `F: fn<'e>(..)` holds `F: 'e`, as a call owes it (`appendRegionBound`),
  // and a value of `F` stands for its contract.
  let declared = List<Constraint>.asSlice(&assumed)
  at = usize.ZERO
  while at < declared.length {
    if let Constraint.Represents {parameter, contract} = &declared[at] {
      run List<RegionRepresentation>.append(&mut representations.*, RegionRepresentation {parameter: Shared<Type>.clone(&parameter),
        contract: Shared<Type>.clone(&contract)})
      if let Option<Shared<Lifetime>>.Some {value: region} = move run representedRegion(&contract) {
        if universalLifetime(&region, identity) {
          run List<ContentsBound>.append(&mut parameterPremises.*, ContentsBound {subject: Shared<Type>.clone(&parameter),
            region: move region})
        }
      }
    }
    at = at + usize.ONE
  }
  return ()
}

// A selected body checks one application of its declaration, whose static callees were selected under
// that application's arguments. Each lifetime parameter it binds to a caller's universal region
// (`'static` or a supplied atom) is that region, so the two outlive each other.
effect fn selectedPremises(application: &Application, identity: &DeclarationId, premises: &mut List<RegionPremise>) -> ()
! OutOfMemoryError ? &mut Allocator {
  let bindings = run Application.bindings(application)
  let listed = List<Binding>.asSlice(&bindings)
  let mut at = usize.ZERO
  while at < listed.length {
    if let Argument.Lifetime {value} = &listed[at].value {
      if universalLifetime(&value, identity) {
        let parameter = run Shared<Lifetime>.make(Lifetime.Parameter {declaration: DeclarationId.copyShared(&listed[at].declaration),
          ordinal: listed[at].ordinal})
        run List<RegionPremise>.append(&mut premises.*, RegionPremise {longer: Shared<Lifetime>.clone(&parameter),
          shorter: Shared<Lifetime>.clone(&value)})
        run List<RegionPremise>.append(&mut premises.*, RegionPremise {longer: Shared<Lifetime>.clone(&value), shorter: move parameter})
      }
    }
    at = at + usize.ONE
  }
  return ()
}

// One contract per call the region check instantiates, keyed by its own node or by the immediate
// `run` that executes it (EFF-003): a direct or interface call, a callable invocation, a call that
// constructs an Effect no immediate run executes (EFF-001), a named function's section, and a
// storage primitive checked as a call to its catalog contract. `identity` is the checked body's
// declaration and `providers` the services its signatures require.
effect fn callContracts(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, dependencies: &mut List<Dependency>,
  identity: &DeclarationId, nodes: &[BodyNode], constraints: &[Constraint], providers: &[Shared<Type>], anchor: &Anchor)
  -> List<CallContract>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let runners = run immediateRunners(nodes)
  let ran = List<usize>.asSlice(&runners)
  let mut implied = List<ImpliedEntry>.make()
  let mut contracts = List<CallContract>.make()
  let mut at = usize.ZERO
  while at < nodes.length {
    let running = ran[at] != usize.MAX
    let mut call = BodyNodeId {index: at}
    if running { call = BodyNodeId {index: ran[at]} }
    let span = BodyOrigin.span(nodes[at].origin, anchor)
    let mut contract = Option<CallContract>.none()
    let unlisted = List<usize>.make()
    if let BodyNodeKind.Expression {form, ty} = &nodes[at].kind {
      if let BodyExpression.DirectCall {application, constructs, arguments, written: writtenTypes, writtenLifetimes, receiverPass, ..} = &form {
        let selected = run Application.copyShared(&application)
        let supplied = run Application.bindings(&selected)
        let callee = Application.bodyDeclaration(&selected)
        if let Option<Key>.Some {value: key} = move run signatureKey(&mut resolver.*, callee) {
          let shape = ContractShape {form: constructionForm(running, constructs), first: usize.ZERO,
            arguments: List<BodyNodeId>.length(&arguments), ranValue: running && !constructs,
            ownerWritten: match &receiverPass { Option<BodyReceiverPass>.None => true _ => false }}
          let wrote = run sharedOrdinals(&writtenLifetimes)
          contract = run signatureContract(&mut resolver.*, &mut owner.*, &mut dependencies.*, identity, call, key, callee,
            List<Binding>.asSlice(&supplied), List<Shared<Type>>.asSlice(&writtenTypes), List<usize>.asSlice(&wrote), shape, providers,
            &mut implied, span)
        }
      }
      if let BodyExpression.InterfaceCall {contract: selected, provider, operation, bindings, isEffect, arguments, ..} = &form {
        if let Option<Key>.Some {value: key} = move run operationKey(&mut resolver.*, &selected, &provider, &operation) {
          let supplied = run sharedBindings(&bindings)
          let shape = ContractShape {form: constructionForm(running, isEffect), first: usize.ZERO,
            arguments: List<BodyNodeId>.length(&arguments), ranValue: running && !isEffect,
            ownerWritten: false}
          let unwritten = List<Shared<Type>>.make()
          contract = run signatureContract(&mut resolver.*, &mut owner.*, &mut dependencies.*, identity, call, key, &operation,
            List<Binding>.asSlice(&supplied), List<Shared<Type>>.asSlice(&unwritten), List<usize>.asSlice(&unlisted), shape, providers,
            &mut implied, span)
        }
      }
      if let BodyExpression.CallableCall {callee, arguments, inference, bindings, constructs, ..} = &form {
        if let Option<Shared<Type>>.Some {value: calleeType} = move bodyExpressionType(nodes, &callee) {
          let supplied = run sharedBindings(&bindings)
          let shape = ContractShape {form: constructionForm(running, constructs), first: usize.ZERO,
            arguments: List<BodyNodeId>.length(&arguments), ranValue: running, ownerWritten: false}
          let staging = run sectionStaging(&calleeType)
          let owed = run sectionOwed(&mut resolver.*, &mut owner.*, &mut dependencies.*, &staging, &mut implied, span)
          contract = run invocationContract(&mut resolver.*, &mut owner.*, &mut dependencies.*, identity, &calleeType,
            DeclarationId.copyShared(&inference), List<Binding>.asSlice(&supplied), call, shape, constraints, &staging, &owed, span)
        }
      }
      // A staged callable stores its operands as the callee value's parameters from `first`; the
      // callee's invocation binders are fresh at the stage.
      if let BodyExpression.StagedCallable {callee, retention, ..} = &form {
        if let Option<Shared<Type>>.Some {value: calleeType} = move bodyExpressionType(nodes, &callee) {
          let mut scope = Bytes.make()
          run Bytes.append(&mut scope, b"\0region-stage")
          run RuntimeEncoding.word(&mut scope, usize.toU64(at))
          let fresh = run DeclarationId.inference(identity, Bytes.asSlice(&scope))
          let shape = ContractShape {form: ContractForm.Section, first: retention.first, arguments: usize.MAX, ranValue: false,
            ownerWritten: false}
          let unbound = List<Binding>.make()
          let unowed = SectionOwed {bounds: List<Constraint>.make(), represented: List<Binding>.make(), captured: List<Shared<Type>>.make()}
          let unstaged = Option<SectionStaging>.none()
          contract = run invocationContract(&mut resolver.*, &mut owner.*, &mut dependencies.*, identity, &calleeType, move fresh,
            List<Binding>.asSlice(&unbound), call, shape, constraints, &unstaged, &unowed, span)
        }
      }
      if let BodyExpression.Aggregate {section: Option<SectionRetention>.Some {value: retention}, ..} = &form {
        if let Option<Shared<Application>>.Some {value: application} = move Shared<Type>.with<Option<Shared<Application>>>(&ty, sectionApplication) {
          let selected = run Application.copyShared(&application)
          let supplied = run Application.bindings(&selected)
          let callee = Application.bodyDeclaration(&selected)
          if let Option<Key>.Some {value: key} = move run signatureKey(&mut resolver.*, callee) {
            let shape = ContractShape {form: ContractForm.Section, first: retention.first, arguments: usize.MAX, ranValue: false,
            ownerWritten: false}
            let unwritten = List<Shared<Type>>.make()
            let wrote = run sharedOrdinals(&retention.written)
            contract = run signatureContract(&mut resolver.*, &mut owner.*, &mut dependencies.*, identity, call, key, callee,
              List<Binding>.asSlice(&supplied), List<Shared<Type>>.asSlice(&unwritten), List<usize>.asSlice(&wrote), shape, providers,
              &mut implied, span)
          }
        } else if let Option<Shared<SectionSchema>>.Some {value: schema} = move Shared<Type>.with<Option<Shared<SectionSchema>>>(&ty, sectionSchema) {
          // A section whose target still defers some of its arguments stages that target with the
          // arguments it selected.
          let selected = run CallableSchema.copy(&schema)
          let callee = DeclarationId.copyShared(&selected.target)
          if let Option<Key>.Some {value: key} = move run signatureKey(&mut resolver.*, &callee) {
            let shape = ContractShape {form: ContractForm.Section, first: retention.first, arguments: usize.MAX, ranValue: false,
            ownerWritten: false}
            let unwritten = List<Shared<Type>>.make()
            let wrote = run sharedOrdinals(&retention.written)
            contract = run signatureContract(&mut resolver.*, &mut owner.*, &mut dependencies.*, identity, call, key, &callee,
              List<Binding>.asSlice(&selected.selected), List<Shared<Type>>.asSlice(&unwritten), List<usize>.asSlice(&wrote), shape,
              providers, &mut implied, span)
          }
        }
      }
      if let BodyExpression.StorageCall {operation, arguments, ..} = &form {
        if storageContractCall(operation) {
          contract = run storageContract(nodes, call, List<BodyNodeId>.asSlice(&arguments))
        }
      }
    }
    if let Option<CallContract>.Some {value} = move contract { run List<CallContract>.append(&mut contracts, move value) }
    at = at + usize.ONE
  }
  return move contracts
}

effect fn sharedOrdinals(value: &Shared<List<usize>>) -> List<usize> ! OutOfMemoryError ? &mut Allocator {
  let count = Shared<List<usize>>.with<usize>(value, fn(listed: &List<usize>) -> usize { return List<usize>.length(listed) })
  let mut copied = List<usize>.make()
  let mut at = usize.ZERO
  while at < count {
    run List<usize>.append(&mut copied, Shared<List<usize>>.with<usize>(value, fn(listed: &List<usize>) -> usize {
      return List<usize>.asSlice(listed)[at]
    }))
    at = at + usize.ONE
  }
  return move copied
}

// A call that constructs an Effect no immediate run executes builds that Effect (EFF-001); any
// other call runs its callee.
fn constructionForm(running: bool, constructs: bool) -> ContractForm {
  if constructs && !running { return ContractForm.Effect }
  return ContractForm.Call
}

// The function application a named section stages.
fn sectionApplication(value: &Type) -> Option<Shared<Application>> {
  return match &value.* {
    Type.CallableValue {application, ..} => Option<Shared<Application>>.some(Shared<Application>.clone(&application))
    _ => Option<Shared<Application>>.none()
  }
}

// The target a named section stages while some of its arguments are deferred.
fn sectionSchema(value: &Type) -> Option<Shared<SectionSchema>> {
  return match &value.* {
    Type.CallableSchema {schema, ..} => Option<Shared<SectionSchema>>.some(Shared<SectionSchema>.clone(&schema))
    _ => Option<Shared<SectionSchema>>.none()
  }
}

// The named function a section stages and the bindings its selected arguments fixed.
struct SectionStaging {
  target: DeclarationId,
  selected: List<Binding>,
  // Which parameter of the target each stored value supplies, in storage order.
  inputs: List<CallableFieldInput>,
}

// What a callable value of type `value` stages when it is a section of a named function: a schema's
// target, or the application of a value none of whose fields is an anonymous body's environment.
effect fn sectionStaging(value: &Shared<Type>) -> Option<SectionStaging> ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let copied = run Type.copy(value)
  match move copied {
    Type.CallableSchema {schema, fieldInputs, ..} => {
      let selected = run CallableSchema.copy(&schema)
      return Option<SectionStaging>.some(SectionStaging {target: DeclarationId.copyShared(&selected.target),
        selected: run copyBindings(List<Binding>.asSlice(&selected.selected)), inputs: move fieldInputs})
    }
    Type.CallableValue {application, fieldInputs, ..} => {
      let inputs = List<CallableFieldInput>.asSlice(&fieldInputs)
      if inputs.length == usize.ZERO { return Option<SectionStaging>.none() }
      let mut at = usize.ZERO
      while at < inputs.length {
        if let CallableFieldInput.Environment = &inputs[at] { return Option<SectionStaging>.none() }
        at = at + usize.ONE
      }
      let applied = run Application.copyShared(&application)
      return Option<SectionStaging>.some(SectionStaging {target: DeclarationId.copy(Application.bodyDeclaration(&applied)),
        selected: run Application.bindings(&applied), inputs: move fieldInputs})
    }
    _ => ()
  }
  return Option<SectionStaging>.none()
}

// What each invocation of a section (`staging`) owes its target: the bounds the target declares
// and its signature implies on its own lifetime binders, which each invocation opens, under the
// selections it keeps (`sectionFixed`), each open representation parameter as the contract it
// represents (REP-001), and the target parameter each stored value supplies.
struct SectionOwed {
  bounds: List<Constraint>,
  represented: List<Binding>,
  captured: List<Shared<Type>>,
}

effect fn sectionOwed(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, dependencies: &mut List<Dependency>,
  staging: &Option<SectionStaging>, implied: &mut List<ImpliedEntry>, span: Span) -> SectionOwed
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut owed = List<Constraint>.make()
  let mut represented = List<Binding>.make()
  let mut captured = List<Shared<Type>>.make()
  if let Option<SectionStaging>.Some {value: section} = &staging.* {
    if let Option<Key>.Some {value: key} = move run signatureKey(&mut resolver.*, &section.target) {
      let signature = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, key, span)
      if let Option<Shared<Rejection>>.Some {..} = move Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(&signature, answerCause) {
        return SectionOwed {bounds: move owed, represented: move represented, captured: move captured}
      }
      let fixed = run sectionFixed(List<Binding>.asSlice(&section.selected), &section.target)
      let selected = List<Binding>.asSlice(&fixed)
      let declared = run signatureParameterTypes(&signature)
      let parameters = List<Shared<Type>>.asSlice(&declared)
      let inputs = List<CallableFieldInput>.asSlice(&section.inputs)
      let mut input = usize.ZERO
      while input < inputs.length {
        let parameter = match &inputs[input] {
          CallableFieldInput.Argument {parameter} => parameter
          CallableFieldInput.Represented {parameter, ..} => parameter
          CallableFieldInput.Environment => usize.MAX
        }
        if parameter >= parameters.length { return SectionOwed {bounds: move owed, represented: move represented, captured: List<Shared<Type>>.make()} }
        run List<Shared<Type>>.append(&mut captured, run Type.applyBindings(&parameters[parameter], selected, true))
        input = input + usize.ONE
      }
      let count = Shared<Result<Answer, NoRejection>>.with<usize>(&signature, signatureConstraintCount)
      let mut at = usize.ZERO
      while at < count {
        let bound = Shared<Result<Answer, NoRejection>>.with<Option<Constraint>>(&signature,
          fn(answer: &Result<Answer, NoRejection>) -> Option<Constraint> { return signatureConstraintAt(answer, at) })
        if let Option<Constraint>.Some {value} = move bound {
          if let Constraint.Represents {parameter, contract} = &value {
            let slot = Shared<Type>.with<usize>(&parameter, fn(node: &Type) -> usize {
              return match &node.* {
                Type.Parameter {declaration, ordinal} => {
                  if DeclarationId.equals(&declaration, &section.target) { return ordinal }
                  return usize.MAX
                }
                _ => usize.MAX
              }
            })
            if slot != usize.MAX && !Type.mentionsInvocation(&contract) {
              run List<Binding>.append(&mut represented, Binding {declaration: run Shared<DeclarationId>.make(DeclarationId.copy(&section.target)),
                ordinal: slot, value: Argument.Type {value: run Type.applyBindings(&contract, selected, true)}})
            }
          }
          let applied = run bindConstraint(&value, selected)
          if owedPerInvocation(&applied, &section.target) && !run holdsOpenParameter(&applied, &section.target) {
            run List<Constraint>.append(&mut owed, move applied)
          }
        }
        at = at + usize.ONE
      }
      let assumed = run calleeImplied(&mut resolver.*, &mut owner.*, &mut dependencies.*, key, &signature, &mut implied.*, span)
      let listed = List<Constraint>.asSlice(&assumed)
      at = usize.ZERO
      while at < listed.length {
        let applied = run bindConstraint(&listed[at], selected)
        if owedPerInvocation(&applied, &section.target) && !run holdsOpenParameter(&applied, &section.target) {
          run List<Constraint>.append(&mut owed, move applied)
        }
        at = at + usize.ONE
      }
    }
  }
  return SectionOwed {bounds: move owed, represented: move represented, captured: move captured}
}

// The selections of a section of `target` each invocation keeps: every selection but `target`'s own
// lifetime binders, which each invocation opens afresh and meets with the values the section
// stored. The construction already proved what the binders the source wrote owe.
effect fn sectionFixed(selected: &[Binding], target: &DeclarationId) -> List<Binding> ! OutOfMemoryError ? &mut Allocator {
  let mut fixed = List<Binding>.make()
  let mut at = usize.ZERO
  while at < selected.length {
    let lifetime = match &selected[at].value { Argument.Lifetime {..} => true _ => false }
    if !lifetime || !declarationEqualsShared(target, &selected[at].declaration) {
      run List<Binding>.append(&mut fixed, Binding {declaration: Shared<DeclarationId>.clone(&selected[at].declaration),
        ordinal: selected[at].ordinal, value: Argument.copy(&selected[at].value)})
    }
    at = at + usize.ONE
  }
  return move fixed
}

// Whether bound `value` is one each invocation of a section of `target` owes: it names a lifetime
// binder of `target` the section left open, since the construction already proved every bound its
// selected arguments fix.
fn owedPerInvocation(value: &Constraint, target: &DeclarationId) -> bool {
  return match &value.* {
    Constraint.Outlives {longer, shorter} => opensBinder(&longer, target) || opensBinder(&shorter, target)
    Constraint.Contents {subject, region} => {
      if opensBinder(&region, target) { return true }
      let count = Type.lifetimeCount(&subject)
      let mut at = usize.ZERO
      while at < count {
        if let Option<Shared<Lifetime>>.Some {value: lifetime} = move Type.lifetimeAt(&subject, at) {
          if opensBinder(&lifetime, target) { return true }
        }
        at = at + usize.ONE
      }
      return false
    }
    _ => false
  }
}

// Whether `lifetime` has an atom that is a lifetime binder of `target`.
fn opensBinder(lifetime: &Shared<Lifetime>, target: &DeclarationId) -> bool {
  return !Lifetime.allAtoms(lifetime, fn(atom: &Lifetime) -> bool {
    return match &atom.* { Lifetime.Parameter {declaration, ..} => !DeclarationId.equals(&declaration, target) _ => true }
  })
}

// Whether contents bound `value` is about a type parameter of `target` the section left open, whose
// contents each invocation's argument supplies and the invocation relates itself.
effect fn holdsOpenParameter(value: &Constraint, target: &DeclarationId) -> bool ! OutOfMemoryError ? &mut Allocator {
  if let Constraint.Contents {subject, ..} = &value.* {
    let mut stored = List<Shared<Type>>.make()
    run Type.storedParameters(&subject, &mut stored)
    let listed = List<Shared<Type>>.asSlice(&stored)
    let mut at = usize.ZERO
    while at < listed.length {
      let open = Shared<Type>.with<bool>(&listed[at], fn(node: &Type) -> bool {
        return match &node.* { Type.Parameter {declaration, ..} => DeclarationId.equals(&declaration, target) _ => false }
      })
      if open { return true }
      at = at + usize.ONE
    }
  }
  return false
}

// The distinct service instances the checked body's signatures require: what a call's requirement
// is provided by while the call runs. An anonymous body's row repeats the instances its enclosing
// body provides, which are one provider each.
effect fn bodyProviders(signatures: &[Shared<Result<Answer, NoRejection>>]) -> List<Shared<Type>>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut required = List<Shared<Type>>.make()
  let mut at = usize.ZERO
  while at < signatures.length {
    let row = run signatureRequirements(&signatures[at])
    run appendCapabilities(&row, &mut required)
    at = at + usize.ONE
  }
  let listed = List<Shared<Type>>.asSlice(&required)
  let mut providers = List<Shared<Type>>.make()
  at = usize.ZERO
  while at < listed.length {
    let mut seen = false
    let mut other = usize.ZERO
    while other < List<Shared<Type>>.length(&providers) && !seen {
      seen = run Type.equalsShared(&List<Shared<Type>>.asSlice(&providers)[other], &listed[at])
      other = other + usize.ONE
    }
    if !seen { run List<Shared<Type>>.append(&mut providers, Shared<Type>.clone(&listed[at])) }
    at = at + usize.ONE
  }
  return move providers
}

effect fn appendCapabilities(row: &Shared<Row>, capabilities: &mut List<Shared<Type>>) -> () ! OutOfMemoryError ? &mut Allocator {
  let count = Shared<Row>.with<usize>(row, fn(value: &Row) -> usize { return List<Requirement>.length(&value.entries) })
  let mut at = usize.ZERO
  while at < count {
    run List<Shared<Type>>.append(&mut capabilities.*, Shared<Row>.with<Shared<Type>>(row, fn(value: &Row) -> Shared<Type> {
      return Shared<Type>.clone(&List<Requirement>.asSlice(&value.entries)[at].capability)
    }))
    at = at + usize.ONE
  }
  return ()
}

// Pairs each service `row` requires with the one service of the same declaration in `providers`.
// A service the caller requires more than once, or not at all, is provided where the region check
// cannot see it, so it is left out.
effect fn providedRequirements(row: &Shared<Row>, providers: &[Shared<Type>]) -> List<ProvidedRequirement>
! OutOfMemoryError ? &mut Allocator {
  let mut required = List<Shared<Type>>.make()
  run appendCapabilities(row, &mut required)
  let services = List<Shared<Type>>.asSlice(&required)
  let mut paired = List<ProvidedRequirement>.make()
  let mut at = usize.ZERO
  while at < services.length {
    if let Option<DeclarationId>.Some {value: wanted} = move Shared<Type>.with<Option<DeclarationId>>(&services[at], nominalDeclaration) {
      let mut found = usize.MAX
      let mut matches = usize.ZERO
      let mut other = usize.ZERO
      while other < providers.length {
        if let Option<DeclarationId>.Some {value: provider} = move Shared<Type>.with<Option<DeclarationId>>(&providers[other], nominalDeclaration) {
          if DeclarationId.equals(&provider, &wanted) {
            found = other
            matches = matches + usize.ONE
          }
        }
        other = other + usize.ONE
      }
      if matches == usize.ONE {
        run List<ProvidedRequirement>.append(&mut paired, ProvidedRequirement {required: Shared<Type>.clone(&services[at]),
          provided: Shared<Type>.clone(&providers[found])})
      }
    }
    at = at + usize.ONE
  }
  return move paired
}

fn nominalDeclaration(value: &Type) -> Option<DeclarationId> {
  return match &value.* {
    Type.Nominal {declaration, ..} => Option<DeclarationId>.some(DeclarationId.copy(&declaration))
    _ => Option<DeclarationId>.none()
  }
}

// For each node, the immediate `run` whose operand it is, or `usize.MAX`.
effect fn immediateRunners(nodes: &[BodyNode]) -> List<usize> ! OutOfMemoryError ? &mut Allocator {
  let mut runners = List<usize>.make()
  let mut at = usize.ZERO
  while at < nodes.length {
    run List<usize>.append(&mut runners, usize.MAX)
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {form: BodyExpression.Run {value, access}, ..} = &nodes[at].kind {
      if access == RunAccess.Immediate { List<usize>.set(&mut runners, value.index, at) }
    }
    at = at + usize.ONE
  }
  return move runners
}

// The Signature key of `target`, or none when this revision does not index it.
effect fn signatureKey(resolver: &mut Resolver, target: &DeclarationId) -> Option<Key> ! Cycle | OutOfMemoryError ? &mut Allocator {
  let moduleAt = knownModuleOrdinal(&resolver.*, DeclarationId.moduleId(target))
  if moduleAt == usize.MAX { return Option<Key>.none() }
  let module = resolvedModule(&resolver.*, moduleAt)
  let identity = run Shared<DeclarationId>.make(DeclarationId.copy(target))
  let position = match move run ordinalOfIdentity(&mut resolver.*, &module, &identity) {
    Option<usize>.Some {value} => value
    Option<usize>.None => { return Option<Key>.none() }
  }
  return Option<Key>.some(run internDeclaration(&mut resolver.*, Key {family: Family.Signature, module: moduleAt, name: usize.ZERO,
    declaration: position, member: usize.ZERO, external: false}))
}

// The AppliedOperation key of `operation` selected for `provider` under `contract`, as
// `selectOperationCall` demands it, or none when this revision does not index it.
effect fn operationKey(resolver: &mut Resolver, contract: &Shared<Type>, provider: &Shared<Type>, operation: &DeclarationId) -> Option<Key>
! Cycle | OutOfMemoryError ? &mut Allocator | &mut Types {
  let moduleAt = declaringModuleOrdinal(&resolver.*, contract)
  if moduleAt == usize.MAX { return Option<Key>.none() }
  let module = resolvedModule(&resolver.*, moduleAt)
  let identity = run Shared<DeclarationId>.make(DeclarationId.copy(operation))
  let position = match move run ordinalOfIdentity(&mut resolver.*, &module, &identity) {
    Option<usize>.Some {value} => value
    Option<usize>.None => { return Option<Key>.none() }
  }
  let contractKey = run internApplication(&mut resolver.*, contract)
  let providerKey = run internApplication(&mut resolver.*, provider)
  return Option<Key>.some(run internDeclaration(&mut resolver.*, Key {family: Family.AppliedOperation, module: moduleAt,
    name: contractKey, declaration: position, member: providerKey, external: false}))
}

// How one call meets the signature it instantiates: its contract's form, a section's first supplied
// parameter, how many arguments the call passes (`usize.MAX` for a section, which supplies a
// suffix), whether it runs the Effect value a plain function returns (`ranValue`), and whether
// the generic arguments it writes include its owner's (`ownerWritten`), which a receiver's type
// supplies instead for a method call.
struct ContractShape {
  form: ContractForm,
  first: usize,
  arguments: usize,
  ranValue: bool,
  ownerWritten: bool,
}

impl Copy for ContractShape {}

// The contract of calling the signature at `key`: its parameter and result types, its declared and
// implied bounds, and, for a call that runs it, the caller's services that provide its requirements,
// under every binding of the call except the callee's own lifetime binders the call infers, which
// the check numbers afresh for each call. A ran value's result is that Effect's success. Its
// parameters are the runtime ones, one per operand: a static parameter's argument has none. None
// when that arity differs from the call's or a ran result is no Effect.
effect fn signatureContract(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, dependencies: &mut List<Dependency>,
  identity: &DeclarationId, call: BodyNodeId, key: Key, callee: &DeclarationId, supplied: &[Binding], writtenTypes: &[Shared<Type>],
  writtenLifetimes: &[usize], shape: ContractShape, providers: &[Shared<Type>], implied: &mut List<ImpliedEntry>, span: Span)
  -> Option<CallContract>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let signature = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, key, span)
  if let Option<Shared<Rejection>>.Some {..} = move Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(&signature, answerCause) {
    return Option<CallContract>.none()
  }
  let declared = run runtimeParameterTypes(&signature)
  let written = List<Shared<Type>>.asSlice(&declared)
  if shape.arguments != usize.MAX && written.length != shape.arguments { return Option<CallContract>.none() }
  let declaredResult = match move Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(&signature, signatureResult) {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => { return Option<CallContract>.none() }
  }
  let mut wrote = List<Shared<Lifetime>>.make()
  if writtenTypes.length == written.length {
    let mut typeAt = usize.ZERO
    while typeAt < written.length {
      run writtenBinders(&written[typeAt], &writtenTypes[typeAt], callee, shape.ownerWritten, &mut wrote)
      typeAt = typeAt + usize.ONE
    }
  }
  let mut lifetimeAt = usize.ZERO
  while lifetimeAt < writtenLifetimes.length {
    run List<Shared<Lifetime>>.append(&mut wrote, run Shared<Lifetime>.make(Lifetime.Parameter {
      declaration: DeclarationId.copy(callee), ordinal: writtenLifetimes[lifetimeAt]}))
    lifetimeAt = lifetimeAt + usize.ONE
  }
  let binding = run contractBindings(supplied, callee, identity, &wrote)
  let applied = List<Binding>.asSlice(&binding)
  let pinned = run pinnedLifetimes(supplied, identity, &wrote, written, &declaredResult)
  let mut result = run Type.applyBindings(&declaredResult, applied, true)
  if shape.ranValue {
    result = match move effectSuccess(&result) {
      Option<Shared<Type>>.Some {value} => move value
      Option<Shared<Type>>.None => { return Option<CallContract>.none() }
    }
  }
  let mut parameters = List<Shared<Type>>.make()
  let mut at = usize.ZERO
  while at < written.length {
    let parameter = run representedParameter(&written[at], &signature)
    run List<Shared<Type>>.append(&mut parameters, run Type.applyBindings(&parameter, applied, true))
    at = at + usize.ONE
  }
  let mut bounds = List<RegionPremise>.make()
  let mut contents = List<ContentsBound>.make()
  let count = Shared<Result<Answer, NoRejection>>.with<usize>(&signature, signatureConstraintCount)
  at = usize.ZERO
  while at < count {
    let bound = Shared<Result<Answer, NoRejection>>.with<Option<Constraint>>(&signature,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Constraint> { return signatureConstraintAt(answer, at) })
    if let Option<Constraint>.Some {value} = move bound {
      run appendRegionBound(&run bindConstraint(&value, applied), &mut bounds, &mut contents)
    }
    at = at + usize.ONE
  }
  let assumed = run calleeImplied(&mut resolver.*, &mut owner.*, &mut dependencies.*, key, &signature, &mut implied.*, span)
  let listed = List<Constraint>.asSlice(&assumed)
  at = usize.ZERO
  while at < listed.length {
    run appendRegionBound(&run bindConstraint(&listed[at], applied), &mut bounds, &mut contents)
    at = at + usize.ONE
  }
  let mut requirements = List<ProvidedRequirement>.make()
  if shape.form == ContractForm.Call {
    let row = run Row.applyBindings(&run signatureRequirements(&signature), applied, true)
    requirements = run providedRequirements(&row, providers)
  }
  return Option<CallContract>.some(CallContract {call: call, form: shape.form, first: shape.first,
    binders: Option<DeclarationId>.some(DeclarationId.copy(callee)), parameters: move parameters, result: move result,
    bounds: move bounds, contents: move contents, requirements: move requirements, pinned: move pinned,
    captured: List<Shared<Type>>.make()})
}

// The contract a representation parameter (REP-001) declares, or any other parameter type itself:
// the call relates the callable it supplies to that contract, in its variances, and not to the
// exact representation the call binds. The region check leaves the lifetimes a contract quantifies
// over its invocations unrelated.
effect fn representedParameter(written: &Shared<Type>, signature: &Shared<Result<Answer, NoRejection>>) -> Shared<Type>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let count = Shared<Result<Answer, NoRejection>>.with<usize>(signature, signatureConstraintCount)
  let mut at = usize.ZERO
  while at < count {
    let bound = Shared<Result<Answer, NoRejection>>.with<Option<Constraint>>(signature,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Constraint> { return signatureConstraintAt(answer, at) })
    if let Option<Constraint>.Some {value: Constraint.Represents {parameter, contract}} = move bound {
      let same = run Type.equalsShared(written, &parameter)
      if same { return move contract }
    }
    at = at + usize.ONE
  }
  return Shared<Type>.clone(written)
}

// The bounds one callee's parameter and result types imply, in its own terms, computed once per
// callee of a body.
struct ImpliedEntry {
  key: Key,
  bounds: List<Constraint>,
}

effect fn calleeImplied(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, dependencies: &mut List<Dependency>,
  key: Key, signature: &Shared<Result<Answer, NoRejection>>, cache: &mut List<ImpliedEntry>, span: Span) -> List<Constraint>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let entries = List<ImpliedEntry>.asSlice(&cache.*)
  let mut at = usize.ZERO
  while at < entries.length {
    if sameKey(entries[at].key, key) { return run copyConstraints(List<Constraint>.asSlice(&entries[at].bounds)) }
    at = at + usize.ONE
  }
  // Only the call's own premises are wanted here, so nothing is owed to the active body frame.
  let implied = run signatureImpliedBounds(&mut resolver.*, &mut owner.*, &mut dependencies.*, signature, false, span)
  run List<ImpliedEntry>.append(&mut cache.*, ImpliedEntry {key: key, bounds: run copyConstraints(List<Constraint>.asSlice(&implied))})
  return move implied
}

// The contract of invoking a callable value of type `callee` (CALLABLE-002): its use contract's
// parameters and result with the invocation binders opened for `inference` and left as written,
// the bounds written on them and those its parameter and result types imply, and its
// `for<use 'call>` contents (LIFE-004), under the invocation's other bindings. A run of the
// invocation results in its Effect's success. A section of a named function (`staging`) leaves
// the target's binders its selected arguments did not fix to each invocation, which owes what the
// target's declared and implied bounds require of them (`owing`). A representation parameter's
// contract is written in the caller's signature, so the caller's lifetimes it names are pinned.
effect fn invocationContract(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, dependencies: &mut List<Dependency>,
  identity: &DeclarationId, callee: &Shared<Type>, fresh: DeclarationId, supplied: &[Binding], call: BodyNodeId, shape: ContractShape,
  constraints: &[Constraint], staging: &Option<SectionStaging>, owing: &SectionOwed, span: Span) -> Option<CallContract>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let ran = shape.ranValue
  let form = shape.form
  let selected = match move run valueCallableContract(callee, constraints) {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => { return Option<CallContract>.none() }
  }
  let copied = run Type.copy(&selected)
  if let Type.Callable {invocationBinders, invocationUse, invocationBounds, parameters, result, ..} = move copied {
    let mut binders = DeclarationId.copy(&fresh)
    let mut staged = false
    if invocationBinders == usize.ZERO && invocationUse == usize.MAX {
      if let Option<SectionStaging>.Some {value: section} = &staging.* {
        binders = DeclarationId.copy(&section.target)
        staged = true
      }
    }
    let declared = List<Shared<Type>>.asSlice(&parameters)
    if shape.arguments != usize.MAX && declared.length != shape.arguments { return Option<CallContract>.none() }
    let unwritten = List<Shared<Lifetime>>.make()
    let binding = run contractBindings(supplied, &binders, identity, &unwritten)
    let applied = List<Binding>.asSlice(&binding)
    // A section's open representation parameter stands for the contract it represents, as it
    // does at a direct call of the target.
    let mut represented = List<Binding>.make()
    if staged { represented = run copyBindings(List<Binding>.asSlice(&owing.represented)) }
    let representations = List<Binding>.asSlice(&represented)
    let mut opened = List<Shared<Type>>.make()
    let mut at = usize.ZERO
    while at < declared.length {
      let parameter = run Type.applyBindings(&declared[at], representations, true)
      run List<Shared<Type>>.append(&mut opened, run Type.openInvocation(&parameter, &fresh))
      at = at + usize.ONE
    }
    let mut used = List<Constraint>.make()
    run invocationUseConstraints(List<Shared<Type>>.asSlice(&opened), invocationUse, &Option<DeclarationId>.some(DeclarationId.copy(&fresh)),
      &mut used)
    let representedResult = run Type.applyBindings(&result, representations, true)
    let openedResult = run Type.openInvocation(&representedResult, &fresh)
    // The target assumes its parameter and result types are well formed, as a direct call's callee
    // does, so the invocation owes the bounds they imply.
    let mut typed = List<Shared<Type>>.make()
    at = usize.ZERO
    while at < declared.length {
      run List<Shared<Type>>.append(&mut typed, Shared<Type>.clone(&List<Shared<Type>>.asSlice(&opened)[at]))
      at = at + usize.ONE
    }
    run List<Shared<Type>>.append(&mut typed, Shared<Type>.clone(&openedResult))
    let wellFormed = run impliedSignatureBounds(&mut resolver.*, &mut owner.*, &mut dependencies.*, List<Shared<Type>>.asSlice(&typed),
      declared.length, &Option<Shared<Lifetime>>.none(), usize.MAX, false, span)
    run appendConstraints(&mut used, List<Constraint>.asSlice(&wellFormed))
    let inputs = List<Shared<Type>>.asSlice(&opened)
    let mut instantiated = List<Shared<Type>>.make()
    at = usize.ZERO
    while at < inputs.length {
      run List<Shared<Type>>.append(&mut instantiated, run Type.applyBindings(&inputs[at], applied, true))
      at = at + usize.ONE
    }
    let mut returned = run Type.applyBindings(&openedResult, applied, true)
    if ran {
      returned = match move effectSuccess(&returned) {
        Option<Shared<Type>>.Some {value} => move value
        Option<Shared<Type>>.None => { return Option<CallContract>.none() }
      }
    }
    let mut bounds = List<RegionPremise>.make()
    let written = List<Outlives>.asSlice(&invocationBounds)
    at = usize.ZERO
    while at < written.length {
      run List<RegionPremise>.append(&mut bounds, RegionPremise {
        longer: run Type.applyLifetimeBindings(&run Type.openInvocationLifetime(&written[at].longer, &fresh), applied),
        shorter: run Type.applyLifetimeBindings(&run Type.openInvocationLifetime(&written[at].shorter, &fresh), applied)})
      at = at + usize.ONE
    }
    let mut contents = List<ContentsBound>.make()
    let listed = List<Constraint>.asSlice(&used)
    at = usize.ZERO
    while at < listed.length {
      run appendRegionBound(&run bindConstraint(&listed[at], applied), &mut bounds, &mut contents)
      at = at + usize.ONE
    }
    // The caller's universal lifetimes a section's selected arguments fixed in what it owes stay
    // those lifetimes at every invocation.
    let mut pinned = List<Shared<Lifetime>>.make()
    if staged {
      let before = List<RegionPremise>.length(&bounds)
      let beforeContents = List<ContentsBound>.length(&contents)
      at = usize.ZERO
      let owed = List<Constraint>.asSlice(&owing.bounds)
      while at < owed.length {
        run appendRegionBound(&run bindConstraint(&owed[at], applied), &mut bounds, &mut contents)
        at = at + usize.ONE
      }
      let added = List<RegionPremise>.asSlice(&bounds)
      at = before
      while at < added.length {
        if universalLifetime(&added[at].longer, identity) { run List<Shared<Lifetime>>.append(&mut pinned, Shared<Lifetime>.clone(&added[at].longer)) }
        if universalLifetime(&added[at].shorter, identity) { run List<Shared<Lifetime>>.append(&mut pinned, Shared<Lifetime>.clone(&added[at].shorter)) }
        at = at + usize.ONE
      }
      let addedContents = List<ContentsBound>.asSlice(&contents)
      at = beforeContents
      while at < addedContents.length {
        if universalLifetime(&addedContents[at].region, identity) {
          run List<Shared<Lifetime>>.append(&mut pinned, Shared<Lifetime>.clone(&addedContents[at].region))
        }
        at = at + usize.ONE
      }
    }
    if !staged && run representedValue(callee, constraints) {
      let typed = List<Shared<Type>>.asSlice(&instantiated)
      at = usize.ZERO
      while at < typed.length {
        run enclosingLifetimes(&typed[at], identity, &mut pinned)
        at = at + usize.ONE
      }
      run enclosingLifetimes(&returned, identity, &mut pinned)
      let owed = List<RegionPremise>.asSlice(&bounds)
      at = usize.ZERO
      while at < owed.length {
        if universalLifetime(&owed[at].longer, identity) { run List<Shared<Lifetime>>.append(&mut pinned, Shared<Lifetime>.clone(&owed[at].longer)) }
        if universalLifetime(&owed[at].shorter, identity) { run List<Shared<Lifetime>>.append(&mut pinned, Shared<Lifetime>.clone(&owed[at].shorter)) }
        at = at + usize.ONE
      }
      let held = List<ContentsBound>.asSlice(&contents)
      at = usize.ZERO
      while at < held.length {
        if universalLifetime(&held[at].region, identity) { run List<Shared<Lifetime>>.append(&mut pinned, Shared<Lifetime>.clone(&held[at].region)) }
        at = at + usize.ONE
      }
    }
    let mut captured = List<Shared<Type>>.make()
    if staged {
      let stored = List<Shared<Type>>.asSlice(&owing.captured)
      at = usize.ZERO
      while at < stored.length {
        let parameter = run Type.applyBindings(&stored[at], representations, true)
        run List<Shared<Type>>.append(&mut captured, run Type.applyBindings(&parameter, applied, true))
        at = at + usize.ONE
      }
    }
    drop fresh
    return Option<CallContract>.some(CallContract {call: call, form: form, first: shape.first, binders: Option<DeclarationId>.some(move binders),
      parameters: move instantiated, result: move returned, bounds: move bounds, contents: move contents,
      requirements: List<ProvidedRequirement>.make(), pinned: move pinned, captured: move captured})
  }
  return Option<CallContract>.none()
}

// A storage primitive's catalog contract as typing instantiated it. Typing states each result in the
// regions of the operands it views or reaches, so the operands' types are the parameters and the
// call's own type is the result.
effect fn storageContract(nodes: &[BodyNode], call: BodyNodeId, arguments: &[BodyNodeId]) -> Option<CallContract>
! OutOfMemoryError ? &mut Allocator {
  let mut parameters = List<Shared<Type>>.make()
  let mut at = usize.ZERO
  while at < arguments.length {
    match move bodyExpressionType(nodes, &arguments[at]) {
      Option<Shared<Type>>.Some {value} => { run List<Shared<Type>>.append(&mut parameters, move value) }
      Option<Shared<Type>>.None => { return Option<CallContract>.none() }
    }
    at = at + usize.ONE
  }
  let result = match move bodyExpressionType(nodes, &call) {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => { return Option<CallContract>.none() }
  }
  return Option<CallContract>.some(CallContract {call: call, form: ContractForm.Call, first: usize.ZERO,
    binders: Option<DeclarationId>.none(), parameters: move parameters, result: move result, bounds: List<RegionPremise>.make(),
    contents: List<ContentsBound>.make(), requirements: List<ProvidedRequirement>.make(), pinned: List<Shared<Lifetime>>.make(),
    captured: List<Shared<Type>>.make()})
}

// Every binding of a call except the lifetime binders `callee` owns that the call infers, which
// stay unbound for the check to number afresh. A binder the call wrote (`written`) as a lifetime the
// caller's body (`identity`) cannot choose keeps it.
effect fn contractBindings(supplied: &[Binding], callee: &DeclarationId, identity: &DeclarationId, written: &List<Shared<Lifetime>>)
  -> List<Binding> ! OutOfMemoryError ? &mut Allocator {
  let wrote = List<Shared<Lifetime>>.asSlice(written)
  let mut kept = List<Binding>.make()
  let mut at = usize.ZERO
  while at < supplied.length {
    let mut own = false
    if let Argument.Lifetime {value: bound} = &supplied[at].value {
      if declarationEqualsShared(callee, &supplied[at].declaration) {
        let binder = run Shared<Lifetime>.make(Lifetime.Parameter {declaration: DeclarationId.copyShared(&supplied[at].declaration),
          ordinal: supplied[at].ordinal})
        own = !(containsLifetime(wrote, &binder) && universalLifetime(&bound, identity))
      }
    }
    if !own {
      run List<Binding>.append(&mut kept, Binding {declaration: Shared<DeclarationId>.clone(&supplied[at].declaration),
        ordinal: supplied[at].ordinal, value: Argument.copy(&supplied[at].value)})
    }
    at = at + usize.ONE
  }
  return move kept
}

// The caller's universal lifetimes a call fixes rather than infers: each lifetime it wrote for a
// binder (`written`), and each lifetime parameter of a declaration enclosing the caller's body
// (`identity`) that the callee's declared parameter or result types name.
effect fn pinnedLifetimes(supplied: &[Binding], identity: &DeclarationId, written: &List<Shared<Lifetime>>,
  declared: &[Shared<Type>], result: &Shared<Type>) -> List<Shared<Lifetime>> ! OutOfMemoryError ? &mut Allocator {
  let wrote = List<Shared<Lifetime>>.asSlice(written)
  let mut pinned = List<Shared<Lifetime>>.make()
  let mut at = usize.ZERO
  while at < supplied.length {
    if let Argument.Lifetime {value: bound} = &supplied[at].value {
      let binder = run Shared<Lifetime>.make(Lifetime.Parameter {declaration: DeclarationId.copyShared(&supplied[at].declaration),
        ordinal: supplied[at].ordinal})
      if containsLifetime(wrote, &binder) && universalLifetime(&bound, identity) {
        run List<Shared<Lifetime>>.append(&mut pinned, Shared<Lifetime>.clone(&bound))
      }
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < declared.length {
    run enclosingLifetimes(&declared[at], identity, &mut pinned)
    at = at + usize.ONE
  }
  run enclosingLifetimes(result, identity, &mut pinned)
  return move pinned
}

// Appends each lifetime `value` names whose atoms are all parameters of declarations enclosing
// `identity`.
effect fn enclosingLifetimes(value: &Shared<Type>, identity: &DeclarationId, found: &mut List<Shared<Lifetime>>) -> ()
! OutOfMemoryError ? &mut Allocator {
  let regions = Type.lifetimeCount(value)
  let mut at = usize.ZERO
  while at < regions {
    if let Option<Shared<Lifetime>>.Some {value: lifetime} = move Type.lifetimeAt(value, at) {
      let enclosing = Lifetime.allAtoms(&lifetime, fn(atom: &Lifetime) -> bool {
        if let Lifetime.Parameter {declaration, ..} = &atom.* { return DeclarationId.isPrefixOf(&declaration, identity) }
        return false
      })
      if enclosing && !containsLifetime(List<Shared<Lifetime>>.asSlice(&found.*), &lifetime) {
        run List<Shared<Lifetime>>.append(&mut found.*, move lifetime)
      }
    }
    at = at + usize.ONE
  }
  let children = Type.partCount(value)
  at = usize.ZERO
  while at < children {
    if let Option<Shared<Type>>.Some {value: child} = move Type.partAt(value, at) {
      run enclosingLifetimes(&child, identity, &mut found.*)
    }
    at = at + usize.ONE
  }
  return ()
}

fn containsLifetime(listed: &[Shared<Lifetime>], wanted: &Shared<Lifetime>) -> bool {
  let mut at = usize.ZERO
  while at < listed.length {
    if Lifetime.equalsShared(&listed[at], wanted) { return true }
    at = at + usize.ONE
  }
  return false
}

// Appends each lifetime parameter the parameter type `declared` names where `written`, the same
// type under the generic arguments the call wrote, names a lifetime other than 'static: typing
// neutralizes every binder the call leaves to inference to 'static there. Only `callee`'s own
// binders count unless the call writes its owner's too (`owners`).
effect fn writtenBinders(declared: &Shared<Type>, written: &Shared<Type>, callee: &DeclarationId, owners: bool,
  found: &mut List<Shared<Lifetime>>) -> ()
! OutOfMemoryError ? &mut Allocator {
  let regions = Type.lifetimeCount(declared)
  let children = Type.partCount(declared)
  if regions != Type.lifetimeCount(written) || children != Type.partCount(written) { return () }
  let mut at = usize.ZERO
  while at < regions {
    if let Option<Shared<Lifetime>>.Some {value: binder} = move Type.lifetimeAt(declared, at) {
      if let Option<Shared<Lifetime>>.Some {value: bound} = move Type.lifetimeAt(written, at) {
        let parameter = Shared<Lifetime>.with<bool>(&binder, fn(region: &Lifetime) -> bool {
          if let Lifetime.Parameter {declaration, ..} = &region.* { return owners || DeclarationId.equals(&declaration, callee) }
          return false
        })
        let chosen = Shared<Lifetime>.with<bool>(&bound, fn(region: &Lifetime) -> bool {
          return match &region.* { Lifetime.Static => false _ => true }
        })
        if parameter && chosen && !containsLifetime(List<Shared<Lifetime>>.asSlice(&found.*), &binder) {
          run List<Shared<Lifetime>>.append(&mut found.*, move binder)
        }
      }
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < children {
    if let Option<Shared<Type>>.Some {value: inner} = move Type.partAt(declared, at) {
      if let Option<Shared<Type>>.Some {value: applied} = move Type.partAt(written, at) {
        run writtenBinders(&inner, &applied, callee, owners, &mut found.*)
      }
    }
    at = at + usize.ONE
  }
  return ()
}

effect fn sharedBindings(value: &Shared<List<Binding>>) -> List<Binding> ! OutOfMemoryError ? &mut Allocator {
  let count = Shared<List<Binding>>.with<usize>(value, fn(listed: &List<Binding>) -> usize { return List<Binding>.length(listed) })
  let mut copied = List<Binding>.make()
  let mut at = usize.ZERO
  while at < count {
    let binding = Shared<List<Binding>>.with<Binding>(value, fn(listed: &List<Binding>) -> Binding {
      let current = List<Binding>.asSlice(listed)
      return Binding {declaration: Shared<DeclarationId>.clone(&current[at].declaration), ordinal: current[at].ordinal,
        value: Argument.copy(&current[at].value)}
    })
    run List<Binding>.append(&mut copied, move binding)
    at = at + usize.ONE
  }
  return move copied
}

// Files an outlives bound as a region bound, a contents bound as itself, and a callable
// representation bound as the contents bound it implies; the check reads no other kind of bound.
effect fn appendRegionBound(bound: &Constraint, bounds: &mut List<RegionPremise>, contents: &mut List<ContentsBound>) -> ()
! OutOfMemoryError ? &mut Allocator {
  if let Constraint.Outlives {longer, shorter} = &bound.* {
    run List<RegionPremise>.append(&mut bounds.*, RegionPremise {longer: Shared<Lifetime>.clone(&longer),
      shorter: Shared<Lifetime>.clone(&shorter)})
  }
  if let Constraint.Contents {subject, region} = &bound.* {
    run List<ContentsBound>.append(&mut contents.*, ContentsBound {subject: Shared<Type>.clone(&subject),
      region: Shared<Lifetime>.clone(&region)})
  }
  if let Constraint.Represents {parameter, contract} = &bound.* {
    let represented = run representedRegion(&contract)
    if let Option<Shared<Lifetime>>.Some {value: region} = move represented {
      run List<ContentsBound>.append(&mut contents.*, ContentsBound {subject: Shared<Type>.clone(&parameter),
        region: move region})
    }
  }
  return ()
}

// The region a callable or Effect representation bound's parameter outlives: the meet of the
// contract's promised environment, `'static` when it promises none, so `F: fn<'e>(..)` and
// `F: once Effect<'e; ..>` hold `F: 'e`. None for any other contract.
effect fn representedRegion(contract: &Shared<Type>) -> Option<Shared<Lifetime>> ! OutOfMemoryError ? &mut Allocator {
  let mut environment = match move run Type.copy(contract) {
    Type.Effect {environment, ..} => Option<Shared<Intersection>>.some(move environment)
    _ => Option<Shared<Intersection>>.none()
  }
  if let Option<CallableFacts>.Some {value} = move run CallableContract.ofType(contract) {
    environment = Option<Shared<Intersection>>.some(Shared<Intersection>.clone(&value.environment))
  }
  if let Option<Shared<Intersection>>.Some {value} = &environment {
    let regions = run callableEnvironmentRegions(&value)
    return Option<Shared<Lifetime>>.some(run Lifetime.meet(List<Shared<Lifetime>>.asSlice(&regions)))
  }
  return Option<Shared<Lifetime>>.none()
}

fn effectSuccess(value: &Shared<Type>) -> Option<Shared<Type>> {
  return Shared<Type>.with<Option<Shared<Type>>>(value, fn(ty: &Type) -> Option<Shared<Type>> {
    return match &ty.* {
      Type.Effect {success, ..} => Option<Shared<Type>>.some(Shared<Type>.clone(&success))
      _ => Option<Shared<Type>>.none()
    }
  })
}

// One shape per construction whose operands are stored at declared field types, in the lifetimes of
// the constructed node's own type: a callable's or named section's captures (CALLABLE-001), a staged
// callable's callee and stored operands, and a nominal record's or variant's fields with its type's
// declared outlives and contents bounds, which the region check holds at the construction (LIFE-002).
effect fn constructionShapes(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, dependencies: &mut List<Dependency>,
  nodes: &[BodyNode], anchor: &Anchor) -> List<ConstructionShape>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut shapes = List<ConstructionShape>.make()
  let mut at = usize.ZERO
  while at < nodes.length {
    let mut fields = Option<List<Shared<Type>>>.none()
    let mut bounds = List<RegionPremise>.make()
    let mut contents = List<ContentsBound>.make()
    if let BodyNodeKind.Expression {ty, form} = &nodes[at].kind {
      let span = BodyOrigin.span(nodes[at].origin, anchor)
      let mut nominal = false
      if let BodyExpression.Callable {fields: written, ..} = &form {
        fields = run capturedFields(&ty, List<BodyAggregateField>.asSlice(&written))
      }
      if let BodyExpression.Aggregate {fields: written, ..} = &form {
        fields = run capturedFields(&ty, List<BodyAggregateField>.asSlice(&written))
        if let Option<List<Shared<Type>>>.None = &fields {
          fields = run memberFields(&mut resolver.*, &mut owner.*, &mut dependencies.*, &ty, usize.MAX,
            List<BodyAggregateField>.asSlice(&written), span)
          nominal = true
        }
      }
      if let BodyExpression.VariantConstruct {tag, fields: written} = &form {
        fields = run memberFields(&mut resolver.*, &mut owner.*, &mut dependencies.*, &ty, tag,
          List<BodyAggregateField>.asSlice(&written), span)
        nominal = true
      }
      if let BodyExpression.StagedCallable {arguments, ..} = &form {
        fields = run stagedFields(&ty, List<BodyNodeId>.length(&arguments))
      }
      if nominal {
        let declared = run providerDeclaredBounds(&mut resolver.*, &mut owner.*, &mut dependencies.*, &ty, span)
        let listed = List<Constraint>.asSlice(&declared)
        let mut boundAt = usize.ZERO
        while boundAt < listed.length {
          run appendRegionBound(&listed[boundAt], &mut bounds, &mut contents)
          boundAt = boundAt + usize.ONE
        }
      }
    }
    if let Option<List<Shared<Type>>>.Some {value} = move fields {
      run List<ConstructionShape>.append(&mut shapes, ConstructionShape {node: BodyNodeId {index: at}, fields: move value,
        bounds: move bounds, contents: move contents})
    }
    at = at + usize.ONE
  }
  return move shapes
}

// A callable environment's capture types in operand order: each operand's field names its capture.
effect fn capturedFields(value: &Shared<Type>, written: &[BodyAggregateField]) -> Option<List<Shared<Type>>>
! OutOfMemoryError ? &mut Allocator {
  let copied = run Type.copy(value)
  let captures = match move copied {
    Type.CallableValue {captures, ..} => move captures
    Type.CallableSchema {captures, ..} => move captures
    _ => { return Option<List<Shared<Type>>>.none() }
  }
  let listed = List<Shared<Type>>.asSlice(&captures)
  let mut fields = List<Shared<Type>>.make()
  let mut at = usize.ZERO
  while at < written.length {
    if written[at].index >= listed.length { return Option<List<Shared<Type>>>.none() }
    run List<Shared<Type>>.append(&mut fields, Shared<Type>.clone(&listed[written[at].index]))
    at = at + usize.ONE
  }
  return Option<List<Shared<Type>>>.some(move fields)
}

// A staged callable stores its callee as its base and each supplied operand as the next capture.
// A flattened environment no longer separates the callee from its captures, so it has no shape.
effect fn stagedFields(value: &Shared<Type>, supplied: usize) -> Option<List<Shared<Type>>> ! OutOfMemoryError ? &mut Allocator {
  let copied = run Type.copy(value)
  if let Type.CallableStage {base, captures, ..} = move copied {
    let listed = List<Shared<Type>>.asSlice(&captures)
    if listed.length != supplied { return Option<List<Shared<Type>>>.none() }
    let mut fields = List<Shared<Type>>.make()
    run List<Shared<Type>>.append(&mut fields, move base)
    let mut at = usize.ZERO
    while at < listed.length {
      run List<Shared<Type>>.append(&mut fields, Shared<Type>.clone(&listed[at]))
      at = at + usize.ONE
    }
    return Option<List<Shared<Type>>>.some(move fields)
  }
  return Option<List<Shared<Type>>>.none()
}

// The declared type of each written field of a nominal record (`tag` is `usize.MAX`) or of variant
// `tag`, instantiated for the constructed type itself, as its MemberShape answers state them.
effect fn memberFields(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, dependencies: &mut List<Dependency>,
  value: &Shared<Type>, tag: usize, written: &[BodyAggregateField], span: Span) -> Option<List<Shared<Type>>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let moduleAt = declaringModuleOrdinal(&resolver.*, value)
  if moduleAt == usize.MAX { return Option<List<Shared<Type>>>.none() }
  let module = resolvedModule(&resolver.*, moduleAt)
  let declaration = match move run ordinalOfProvider(&mut resolver.*, &module, value) {
    Option<usize>.Some {value: position} => position
    Option<usize>.None => { return Option<List<Shared<Type>>>.none() }
  }
  let application = run internApplication(&mut resolver.*, value)
  let mut variant = Option<Shared<Result<Answer, NoRejection>>>.none()
  if tag != usize.MAX {
    let key = run internDeclaration(&mut resolver.*, Key {family: Family.MemberShape, module: moduleAt, name: application,
      declaration: declaration, member: tag, external: false})
    variant = Option<Shared<Result<Answer, NoRejection>>>.some(run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, key, span))
  }
  let mut fields = List<Shared<Type>>.make()
  let mut at = usize.ZERO
  while at < written.length {
    let part = written[at].index
    let mut field = Option<Shared<Type>>.none()
    if let Option<Shared<Result<Answer, NoRejection>>>.Some {value: shaped} = &variant {
      field = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(&shaped,
        fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> { return shapeTypeAt(answer, part) })
    } else {
      let key = run internDeclaration(&mut resolver.*, Key {family: Family.MemberShape, module: moduleAt, name: application,
        declaration: declaration, member: part, external: false})
      let shaped = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, key, span)
      field = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(&shaped, singleMemberType)
    }
    match move field {
      Option<Shared<Type>>.Some {value: declared} => { run List<Shared<Type>>.append(&mut fields, move declared) }
      Option<Shared<Type>>.None => { return Option<List<Shared<Type>>>.none() }
    }
    at = at + usize.ONE
  }
  return Option<List<Shared<Type>>>.some(move fields)
}

fn localPlace(nodes: &[BodyNode], at: usize) -> bool {
  return match &nodes[at].kind {
    BodyNodeKind.Expression {form: BodyExpression.Local {..}, ..} => true
    _ => false
  }
}

// The position of a type equal to `value` among `listed`, whose hashes `lookup` records in order,
// or `listed.length` when none is.
// The index of the type in `listed` with `value`'s runtime representation. Both users ask questions
// of the representation only, and comparing lifetimes would keep every borrow's own reference type
// apart: those types share one hash, so a body with many borrows would scan them all each time.
effect fn knownTypeAt(listed: &[Shared<Type>], lookup: &InternIndex, value: &Shared<Type>, hashed: u64) -> usize
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut at = InternIndex.first(lookup, hashed)
  while at != usize.MAX {
    if run Type.runtimeEqualsShared(&listed[at], value) { return at }
    at = InternIndex.after(lookup, at)
  }
  return listed.length
}

effect fn knownType(listed: &[Shared<Type>], lookup: &InternIndex, value: &Shared<Type>, hashed: u64) -> bool
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let at = run knownTypeAt(listed, lookup, value, hashed)
  return at < listed.length
}

// `knownTypeAt` by exact semantic identity rather than runtime layout.
effect fn exactTypeAt(listed: &[Shared<Type>], lookup: &InternIndex, value: &Shared<Type>, hashed: u64) -> usize
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut at = InternIndex.first(lookup, hashed)
  while at != usize.MAX {
    if run Type.equalsShared(&listed[at], value) { return at }
    at = InternIndex.after(lookup, at)
  }
  return listed.length
}

effect fn cleanupNeeds(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, body: &Shared<TypedBody>, bindings: &[Binding], projections: &[RuntimeProjection],
  constraints: &[Constraint], anchor: &Anchor,
) -> Result<CleanupNeeds, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let span = Shared<TypedBody>.with<Span>(body, fn(value: &TypedBody) -> Span {
    let nodes = TypedBody.nodeSlice(value)
    return BodyOrigin.span(nodes[TypedBody.rootNode(value).index].origin, anchor)
  })
  let localCount = Shared<TypedBody>.with<usize>(body, fn(value: &TypedBody) -> usize { return TypedBody.localSlice(value).length })
  let nodeCount = Shared<TypedBody>.with<usize>(body, fn(value: &TypedBody) -> usize { return TypedBody.nodeSlice(value).length })
  let mut known = List<Shared<Type>>.make()
  let mut knownLookup = InternIndex.make()
  let mut verdicts = List<bool>.make()
  let mut localNeeds = List<bool>.make()
  let mut nodeNeeds = List<bool>.make()
  let mut at = usize.ZERO
  while at < localCount + nodeCount {
    let written = Shared<TypedBody>.with<Option<Shared<Type>>>(body, fn(value: &TypedBody) -> Option<Shared<Type>> {
      let locals = TypedBody.localSlice(value)
      if at < localCount { return Option<Shared<Type>>.some(Shared<Type>.clone(&locals[at].ty)) }
      let nodes = TypedBody.nodeSlice(value)
      if let BodyNodeKind.Expression {ty, ..} = &nodes[at - localCount].kind {
        return Option<Shared<Type>>.some(Shared<Type>.clone(&ty))
      }
      return Option<Shared<Type>>.none()
    })
    let mut needs = false
    if let Option<Shared<Type>>.Some {value: ty} = move written {
      // Keyed by the exact written type: equal written types close to equal types, so a repeat
      // skips the substitution as well as the verdict.
      let listed = List<Shared<Type>>.asSlice(&known)
      let hashed = Type.hash(&ty)
      let scan = run exactTypeAt(listed, &knownLookup, &ty, hashed)
      if scan < listed.length {
        needs = List<bool>.asSlice(&verdicts)[scan]
      } else {
        let closed = run RuntimeType.applyBindings(&ty, bindings, projections)
        let free = run sharedCleanupFree(&mut resolver.*, &mut owner.*, &mut dependencies.*, &closed, constraints, span)
        needs = match move free {
          Result<bool, Shared<Rejection>>.Success {value} => !value
          Result<bool, Shared<Rejection>>.Failure {error} => { return Result<CleanupNeeds, Shared<Rejection>>.failResult(move error) }
        }
        run List<Shared<Type>>.append(&mut known, move ty)
        run InternIndex.record(&mut knownLookup, hashed)
        run List<bool>.append(&mut verdicts, needs)
      }
    }
    if at < localCount {
      run List<bool>.append(&mut localNeeds, needs)
    } else {
      run List<bool>.append(&mut nodeNeeds, needs)
    }
    at = at + usize.ONE
  }
  return Result<CleanupNeeds, Shared<Rejection>>.succeed(CleanupNeeds {locals: move localNeeds, nodes: move nodeNeeds})
}

// A callable retains an ordinary function application. Its hidden environment parameter is
// passed directly; there is no code pointer, adapter declaration, or separate closure key.
effect fn concreteCallableCall(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, body: &Shared<TypedBody>, node: BodyNodeId,
  caller: &Application, callerBindings: &[Binding], projections: &[RuntimeProjection], inputs: CallableCallInputs, written: &[Shared<Type>], anchor: &Anchor) -> Result<MirCallTarget, PreparationFailure>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut receiver = run RuntimeType.applyBindings(&inputs.receiver, callerBindings, projections)
  let mut dereferences = usize.ZERO
  while true {
    let copied = run Type.copy(&receiver)
    if let Type.Reference {referent, ..} = move copied {
      receiver = move referent
      dereferences = dereferences + usize.ONE
    } else { break }
  }
  let selected = run originalCallableCall(&mut resolver.*, &mut owner.*, &mut dependencies.*, body, node,
    caller, callerBindings, projections, move inputs, move receiver, dereferences, written, anchor)
  return match move selected {
    Result<MirCallTarget, PreparationFailure>.Success {value} => {
      let mut target = move value
      if dereferences != usize.ZERO {
        if let Option<MirStoredArguments>.Some {value: stored} = &target.stored {
          if stored.consumes { return Result<MirCallTarget, PreparationFailure>.failResult(PreparationFailure.Coverage {code: GapCode.TypedForm}) }
        }
      }
      target.receiverDereferences = dereferences
      return Result<MirCallTarget, PreparationFailure>.succeed(move target)
    }
    Result<MirCallTarget, PreparationFailure>.Failure {error} => Result<MirCallTarget, PreparationFailure>.failResult(move error)
  }
}

effect fn originalCallableCall(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, body: &Shared<TypedBody>, node: BodyNodeId,
  caller: &Application, callerBindings: &[Binding], projections: &[RuntimeProjection], inputs: CallableCallInputs,
  receiver: Shared<Type>, dereferences: usize, written: &[Shared<Type>], anchor: &Anchor) -> Result<MirCallTarget, PreparationFailure>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let exact = run Type.copy(&receiver)
  match move exact {
    Type.CallableSchema {schema, captures, fieldInputs, ..} => {
      if dereferences != usize.ZERO && Shared<Type>.with<CallableMode>(&sectionSchemaContract(&schema), callableInvocationMode) == CallableMode.Once {
        return Result<MirCallTarget, PreparationFailure>.failResult(PreparationFailure.Coverage {code: GapCode.TypedForm})
      }
      return run schemaCallableCall(&mut resolver.*, &mut owner.*, &mut dependencies.*, body, node,
        caller, callerBindings, projections, move inputs, move schema, move captures, move fieldInputs, written, anchor)
    }
    Type.CallableValue {application, contract, captures, fieldInputs, ..} => {
      let invocationMode = Shared<Type>.with<CallableMode>(&contract, callableInvocationMode)
      // A named `effect fn` construction with no written arguments is a section with no fields.
      let named = Shared<Application>.with<bool>(&application, fn(value: &Application) -> bool {
        let kind = DeclarationId.kind(Application.bodyDeclaration(value))
        return kind != OwnerKind.Anonymous && kind != OwnerKind.EffectBlock
      })
      if dereferences != usize.ZERO && invocationMode == CallableMode.Once {
        return Result<MirCallTarget, PreparationFailure>.failResult(PreparationFailure.Coverage {code: GapCode.TypedForm})
      }
      if List<CallableFieldInput>.length(&fieldInputs) != usize.ZERO || named {
        return run sectionCallableCall(&mut resolver.*, &mut owner.*, &mut dependencies.*, body, node, caller,
          callerBindings, projections, move inputs, invocationMode, move application, move captures, move fieldInputs, written, anchor)
      }
      return run anonymousCallableCall(&mut resolver.*, &mut owner.*, &mut dependencies.*, body, node, caller,
        callerBindings, projections, move inputs, invocationMode, move receiver, move application, written, true, anchor)
    }
    _ => { return Result<MirCallTarget, PreparationFailure>.failResult(PreparationFailure.Coverage {code: GapCode.TypedForm}) }
  }
}

// ABI admission uses the same tracked original-result evidence as source calls and definitions.
effect fn callableInvocationResult(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, application: &Application, written: &Shared<Type>, bindings: &[Binding],
  projections: &[RuntimeProjection], span: Span) -> Result<Shared<Type>, PreparationFailure>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut result = run Type.applyBindings(written, bindings, true)
  if Shared<Type>.with<bool>(&result, rawCallableType) {
    let declared = List<Constraint>.make()
    result = match move run callableResultType(&mut resolver.*, &mut owner.*, &mut dependencies.*,
      application, List<Constraint>.asSlice(&declared), span) {
      Result<Shared<Type>, Shared<Rejection>>.Success {value} => move value
      Result<Shared<Type>, Shared<Rejection>>.Failure {..} => { return Result<Shared<Type>, PreparationFailure>.failResult(PreparationFailure.Coverage {code: GapCode.TypedForm}) }
    }
  }
  return Result<Shared<Type>, PreparationFailure>.succeed(run RuntimeType.project(&result, projections))
}

// Whether a section call stores no argument, so every operand is written.
// Whether a target's callable reaches its environment through a shared loan, or has none.
fn sharedEnvironment(target: &MirCallTarget) -> bool {
  if let Option<MirStoredArguments>.Some {value: stored} = &target.stored {
    if stored.consumes { return false }
    return match &stored.environment {
      Option<MirStoredEnvironment>.None => true
      Option<MirStoredEnvironment>.Some {value: input} => sharedLoan(&input.borrow)
    }
  }
  // An anonymous body receives its whole environment first.
  let operands = List<MirCallOperand>.asSlice(&target.operands)
  return operands.length != usize.ZERO && sharedLoan(&operands[usize.ZERO].borrow)
}

fn sharedLoan(borrow: &Option<Access>) -> bool {
  return match &borrow.* {
    Option<Access>.Some {value} => value == Access.Shared
    Option<Access>.None => false
  }
}

fn callableInputParameter(input: &CallableFieldInput, at: usize) -> bool {
  return match move CallableFieldInput.parameter(input) { Option<usize>.Some {value} => value == at _ => false }
}

effect fn sectionCallableCall(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, body: &Shared<TypedBody>, node: BodyNodeId, caller: &Application,
  callerBindings: &[Binding], projections: &[RuntimeProjection], inputs: CallableCallInputs, mode: CallableMode,
  recorded: Shared<Application>, captures: List<Shared<Type>>, fieldInputs: List<CallableFieldInput>,
  written: &[Shared<Type>], anchor: &Anchor) -> Result<MirCallTarget, PreparationFailure>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let recipe = run Application.copyShared(&recorded)
  let application = run Application.substitute(&recipe, caller)
  let key = match move run InstanceKey.function(run Application.copy(&application)) {
    Result<InstanceKey, CanonicalizationFailure>.Success {value: canonicalKey} => move canonicalKey
    Result<InstanceKey, CanonicalizationFailure>.Failure {error: reason} => {
      return Result<MirCallTarget, PreparationFailure>.failResult(PreparationFailure.Canonicalization {reason: reason})
    }
  }
  let location = match move run locationOfInstance(&mut resolver.*, &key) {
    Option<InstanceLocation>.Some {value} => value
    _ => { fail InvalidModulePath {} }
  }
  let declarationAccess175Request = Key {
    family: Family.Signature, module: location.module, name: usize.ZERO,
    declaration: location.declaration, member: usize.ZERO, external: false,
  }
  let declarationAccess175 = run internDeclaration(&mut resolver.*, declarationAccess175Request)
  let signature = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, declarationAccess175, BodyOrigin.span(inputs.origin, anchor))
  let facts = match move Shared<Result<Answer, NoRejection>>.with<Option<SignatureFacts>>(&signature, signatureFacts) {
    Option<SignatureFacts>.Some {value} => move value
    _ => { return Result<MirCallTarget, PreparationFailure>.failResult(PreparationFailure.Coverage {code: GapCode.SignatureForm}) }
  }
  let fields = List<Shared<Type>>.asSlice(&captures)
  let slots = List<CallableFieldInput>.asSlice(&fieldInputs)
  let mut environmentField = usize.MAX
  let mut slotAt = usize.ZERO
  while slotAt < slots.length {
    let isEnvironment = match &slots[slotAt] { CallableFieldInput.Environment => true _ => false }
    if isEnvironment {
      if environmentField != usize.MAX { return Result<MirCallTarget, PreparationFailure>.failResult(PreparationFailure.Coverage {code: GapCode.WitnessOperand}) }
      environmentField = slotAt
    }
    slotAt = slotAt + usize.ONE
  }
  let mut hidden = usize.ZERO
  if environmentField != usize.MAX { hidden = usize.ONE }
  // A static parameter's value is part of the application; it has no runtime lane or field.
  let staticSlots = run signatureStaticSlots(&signature, facts.staticSlots)
  let statics = List<usize>.asSlice(&staticSlots)
  if fields.length != slots.length || facts.parameters - statics.length + hidden != inputs.count + fields.length {
    return Result<MirCallTarget, PreparationFailure>.failResult(PreparationFailure.Coverage {code: GapCode.WitnessOperand})
  }
  let bindings = run Application.bindings(&application)
  let assigned = List<Binding>.asSlice(&bindings)
  let result = match move run callableInvocationResult(&mut resolver.*, &mut owner.*, &mut dependencies.*,
    &application, &facts.result, assigned, projections, BodyOrigin.span(inputs.origin, anchor)) {
    Result<Shared<Type>, PreparationFailure>.Success {value} => move value
    Result<Shared<Type>, PreparationFailure>.Failure {error} => { return Result<MirCallTarget, PreparationFailure>.failResult(move error) }
  }
  let mut wanted = run RuntimeType.applyBindings(&inputs.result, callerBindings, projections)
  // Invoking an `effect fn` value constructs its Effect; only its run calls the instance (D4). A
  // run already has the instance's result type, which may itself be an Effect, so only a
  // constructed Effect is unwrapped to its success.
  if facts.isEffect && !run Type.runtimeEqualsShared(&wanted, &result) {
    let promised = Shared<Type>.with<Option<EffectChannels>>(&wanted, effectChannels)
    if let Option<EffectChannels>.Some {value: channels} = move promised { wanted = move channels.success }
  }
  if !run Type.runtimeEqualsShared(&wanted, &result) { return Result<MirCallTarget, PreparationFailure>.failResult(PreparationFailure.Coverage {code: GapCode.WitnessOperand}) }
  let mut operands = List<MirCallOperand>.make()
  let mut environment = Option<MirStoredEnvironment>.none()
  if environmentField != usize.MAX {
    let original = DeclarationId.kind(Application.bodyDeclaration(&application))
    if original != OwnerKind.Anonymous && original != OwnerKind.EffectBlock {
      return Result<MirCallTarget, PreparationFailure>.failResult(PreparationFailure.Coverage {code: GapCode.WitnessOperand})
    }
    let actual = Shared<Type>.clone(&fields[environmentField])
    let environmentMode = Shared<Type>.with<CallableMode>(&actual, callableInvocationMode)
    let mut parameter = Shared<Type>.clone(&actual)
    let mut borrow = Option<Access>.none()
    if environmentMode != CallableMode.Once {
      let access = match environmentMode { CallableMode.Mutable => Access.Mutable _ => Access.Shared }
      borrow = Option<Access>.some(access)
      parameter = run Types.intern(Type.Reference {referent: Shared<Type>.clone(&actual), access: access,
        lifetime: run Shared<Lifetime>.make(Lifetime.Local {
          declaration: DeclarationId.copy(Application.bodyDeclaration(caller)), ordinal: inputs.origin.node, binder: usize.MAX,
        })})
    }
    environment = Option<MirStoredEnvironment>.some(MirStoredEnvironment {field: environmentField,
      parameter: Shared<Type>.clone(&parameter), borrow: match &borrow { Option<Access>.Some {value} => Option<Access>.some(value) _ => Option<Access>.none() }})
    run List<MirCallOperand>.append(&mut operands, MirCallOperand {value: move actual, parameter: move parameter, borrow: move borrow})
  }
  // A stored argument keeps its original parameter ordinal; the written operands fill the rest.
  let mut lanes = List<MirStoredLane>.make()
  let mut at = usize.ZERO
  let mut lane = usize.ZERO
  while at < facts.parameters {
    if isStaticIndex(statics, at) {
      at = at + usize.ONE
      continue
    }
    let raw = match move Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(&signature,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> { return signatureParameter(answer, at) }) {
      Option<Shared<Type>>.Some {value} => move value
      _ => { return Result<MirCallTarget, PreparationFailure>.failResult(PreparationFailure.Coverage {code: GapCode.WitnessOperand}) }
    }
    let parameter = run RuntimeType.applyBindings(&raw, assigned, projections)
    let mut actual = Shared<Type>.clone(&parameter)
    let mut selected = usize.ZERO
    while selected < slots.length && !callableInputParameter(&slots[selected], at) { selected = selected + usize.ONE }
    if selected < slots.length {
      actual = Shared<Type>.clone(&fields[selected])
      run List<MirStoredLane>.append(&mut lanes, MirStoredLane.Field {index: selected})
    } else {
      if lane >= inputs.count { return Result<MirCallTarget, PreparationFailure>.failResult(PreparationFailure.Coverage {code: GapCode.WitnessOperand}) }
      if lane >= written.length { fail RevisionMismatch {} }
      actual = run RuntimeType.applyBindings(&written[lane], callerBindings, projections)
      run List<MirStoredLane>.append(&mut lanes, MirStoredLane.Written)
      lane = lane + usize.ONE
    }
    if !run sectionOperandRuntimeCompatible(&actual, &parameter) { return Result<MirCallTarget, PreparationFailure>.failResult(PreparationFailure.Coverage {code: GapCode.WitnessOperand}) }
    run List<MirCallOperand>.append(&mut operands, MirCallOperand {value: move actual, parameter: move parameter, borrow: Option<Access>.none()})
    at = at + usize.ONE
  }
  return Result<MirCallTarget, PreparationFailure>.succeed(MirCallTarget {node: node, receiverDereferences: usize.ZERO, key: move key,
    application: move application, edge: Edge.Direct, operands: move operands,
    stored: Option<MirStoredArguments>.some(MirStoredArguments {environment: move environment, lanes: move lanes, consumes: mode == CallableMode.Once}),
    providers: List<MirProviderSource>.make(), dispatch: Option<MirProviderSource>.none(), witnessFailure: Option<Shared<Type>>.none(), nonParking: false, vacuous: false})
}

// Typed invocation already proves access and lifetime obligations. Weakening one exclusive
// reference or slice descriptor to shared access preserves its ABI and its exact referent.
effect fn sectionOperandRuntimeCompatible(actual: &Shared<Type>, parameter: &Shared<Type>) -> bool
! OutOfMemoryError ? &mut Allocator | &mut Types {
  if run Type.runtimeEqualsShared(actual, parameter) { return true }
  if run widenedOperand(actual, parameter) { return true }
  let source = run Type.copy(actual)
  let target = run Type.copy(parameter)
  return match move source {
    Type.Reference {referent, access, ..} => match move target {
      Type.Reference {referent: wanted, access: other, ..} => {
        if access != Access.Mutable || other != Access.Shared { return false }
        return run Type.runtimeEqualsShared(&referent, &wanted)
      }
      _ => false
    }
    Type.Slice {element, access, ..} => match move target {
      Type.Slice {element: wanted, access: other, ..} => {
        if access != Access.Mutable || other != Access.Shared { return false }
        return run Type.runtimeEqualsShared(&element, &wanted)
      }
      _ => false
    }
    _ => false
  }
}

// Whether an operand at a member of its parameter's wider structural union is widened into it at
// the call, as the `Frozen` a handler `fn(error: Overdrawn | Frozen)` receives (MIR
// `widenCallOperands`).
effect fn widenedOperand(actual: &Shared<Type>, parameter: &Shared<Type>) -> bool
! OutOfMemoryError ? &mut Allocator | &mut Types {
  if !Shared<Type>.with<bool>(parameter, unionType) { return false }
  let wider = match move run Type.canonicalUnionMembers(parameter) {
    Option<List<Shared<Type>>>.Some {value} => move value
    Option<List<Shared<Type>>>.None => { return false }
  }
  let members = List<Shared<Type>>.asSlice(&wider)
  let mut narrower = List<Shared<Type>>.make()
  match move run Type.canonicalUnionMembers(actual) {
    Option<List<Shared<Type>>>.Some {value} => { narrower = move value }
    Option<List<Shared<Type>>>.None => { run List<Shared<Type>>.append(&mut narrower, Shared<Type>.clone(actual)) }
  }
  let listed = List<Shared<Type>>.asSlice(&narrower)
  let mut at = usize.ZERO
  while at < listed.length {
    let mut found = false
    let mut other = usize.ZERO
    while !found && other < members.length {
      found = run Type.runtimeEqualsShared(&listed[at], &members[other])
      other = other + usize.ONE
    }
    if !found { return false }
    at = at + usize.ONE
  }
  return true
}

effect fn anonymousCallableCall(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, body: &Shared<TypedBody>, node: BodyNodeId, caller: &Application,
  callerBindings: &[Binding], projections: &[RuntimeProjection], inputs: CallableCallInputs, invocationMode: CallableMode, receiver: Shared<Type>,
  recorded: Shared<Application>, written: &[Shared<Type>], selectInvocation: bool, anchor: &Anchor) -> Result<MirCallTarget, PreparationFailure>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let abstractTarget = run Application.copyShared(&recorded)
  let closedOwner = run Application.substitute(&abstractTarget, caller)
  if !literalKind(Application.bodyDeclaration(&closedOwner)) {
    return Result<MirCallTarget, PreparationFailure>.failResult(PreparationFailure.Coverage {code: GapCode.TypedForm})
  }
  let signatureOwner = run Shared<DeclarationId>.make(DeclarationId.copy(Application.bodyDeclaration(&closedOwner)))
  let location = match move run locationOfIdentity(&mut resolver.*, &signatureOwner) {
    Option<InstanceLocation>.Some {value} => value
    _ => { fail InvalidModulePath {} }
  }
  let targetModule = resolvedModule(&resolver.*, location.module)
  let enclosing = run enclosingIdentity(&mut resolver.*, &targetModule, location.declaration)
  if let Option<DeclarationId>.Some {value: parentIdentity} = move enclosing {
    let parentHandle = run Shared<DeclarationId>.make(move parentIdentity)
    let selectedParent = run ordinalOfIdentity(&mut resolver.*, &targetModule, &parentHandle)
    if let Option<usize>.Some {value: parentOrdinal} = move selectedParent {
      let declarationAccess176Request = Key {
        family: Family.Signature, module: location.module, name: usize.ZERO, declaration: parentOrdinal,
        member: usize.ZERO, external: false,
      }
      let declarationAccess176 = run internDeclaration(&mut resolver.*, declarationAccess176Request)
      let parentSignature = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, declarationAccess176, BodyOrigin.span(inputs.origin, anchor))
      // The literal's body is read from its parent's unselected body, which no static argument
      // specializes, so it is refused at the literal with the workaround (SEM0245, template 1).
      if Shared<Result<Answer, NoRejection>>.with<usize>(&parentSignature, signatureStaticCount) > usize.ZERO {
        let mut literal = b"An anonymous function"
        if run effectBlockHeader(&mut resolver.*, &targetModule, location.declaration) { literal = b"An `effect {}` block" }
        let mut function = Bytes.make()
        run appendQuoted(&mut function, Bytes.asSlice(&run ownName(&parentHandle)))
        let mut diagnostic = run makeRejection(RejectionCode.UnspecializedLiteral, &targetModule,
          run declarationSpan(&mut resolver.*, &targetModule, location.declaration))
        run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"template"), value: run Bytes.copy(b"1")})
        run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"literal"), value: run Bytes.copy(literal)})
        run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"function"), value: move function})
        return Result<MirCallTarget, PreparationFailure>.failResult(PreparationFailure.Rejected {diagnostic: run Shared<Rejection>.make(move diagnostic)})
      }
    }
  }
  let declarationAccess177Request = Key {
    family: Family.Signature, module: location.module, name: usize.ZERO, declaration: location.declaration,
    member: usize.ZERO, external: false,
  }
  let declarationAccess177 = run internDeclaration(&mut resolver.*, declarationAccess177Request)
  let signature = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, declarationAccess177, BodyOrigin.span(inputs.origin, anchor))
  let selected = Shared<Result<Answer, NoRejection>>.with<Option<SignatureFacts>>(&signature, signatureFacts)
  let target = match move selected {
    Option<SignatureFacts>.Some {value} => move value
    _ => { return Result<MirCallTarget, PreparationFailure>.failResult(PreparationFailure.Coverage {code: GapCode.SignatureForm}) }
  }
  if target.parameters != inputs.count { return Result<MirCallTarget, PreparationFailure>.failResult(PreparationFailure.Coverage {code: GapCode.WitnessOperand}) }
  let count = Shared<List<Binding>>.with<usize>(&inputs.bindings, fn(value: &List<Binding>) -> usize { return List<Binding>.length(value) })
  let mut invocationValues = List<Argument>.make()
  let mut selectedOrdinals = List<usize>.make()
  let mut at = usize.ZERO
  while selectInvocation && at < count {
    let recordedBinding = Shared<List<Binding>>.with<Binding>(&inputs.bindings, fn(value: &List<Binding>) -> Binding {
      let current = List<Binding>.asSlice(value)
      return Binding {declaration: Shared<DeclarationId>.clone(&current[at].declaration), ordinal: current[at].ordinal, value: Argument.copy(&current[at].value)}
    })
    let freshIdentity = DeclarationId.copyShared(&inputs.inference)
    if !Shared<DeclarationId>.with<bool>(&recordedBinding.declaration, fn(value: &DeclarationId) -> bool { return DeclarationId.equals(value, &freshIdentity) }) {
      return Result<MirCallTarget, PreparationFailure>.failResult(PreparationFailure.Coverage {code: GapCode.WitnessOperand})
    }
    run List<Argument>.append(&mut invocationValues, run Argument.applyBindings(&recordedBinding.value, callerBindings, true))
    run List<usize>.append(&mut selectedOrdinals, recordedBinding.ordinal)
    at = at + usize.ONE
  }
  let mut application = move closedOwner
  if selectInvocation {
    application = match move run anonymousInvocationApplication(&application, &signature,
      List<Argument>.asSlice(&invocationValues), List<usize>.asSlice(&selectedOrdinals)) {
      Result<Application, PreparationFailure>.Success {value} => move value
      Result<Application, PreparationFailure>.Failure {error} => { return Result<MirCallTarget, PreparationFailure>.failResult(move error) }
    }
  }
  let targetBindings = run Application.bindings(&application)
  let mut wanted = run RuntimeType.applyBindings(&inputs.result, callerBindings, projections)
  let result = match move run callableInvocationResult(&mut resolver.*, &mut owner.*, &mut dependencies.*,
    &application, &target.result, List<Binding>.asSlice(&targetBindings), projections, BodyOrigin.span(inputs.origin, anchor)) {
    Result<Shared<Type>, PreparationFailure>.Success {value} => move value
    Result<Shared<Type>, PreparationFailure>.Failure {error} => { return Result<MirCallTarget, PreparationFailure>.failResult(move error) }
  }
  // Invoking an anonymous `effect fn` constructs its Effect, which this call runs at once (D1).
  let invoked = Shared<Type>.with<bool>(&receiver, fn(value: &Type) -> bool {
    return match &value.* { Type.CallableValue {contract, ..} => Shared<Type>.with<bool>(&contract, callableType) _ => false }
  })
  if target.isEffect && invoked {
    let promised = Shared<Type>.with<Option<EffectChannels>>(&wanted, effectChannels)
    if let Option<EffectChannels>.Some {value: channels} = move promised { wanted = move channels.success }
  }
  if !run Type.runtimeEqualsShared(&wanted, &result) { return Result<MirCallTarget, PreparationFailure>.failResult(PreparationFailure.Coverage {code: GapCode.WitnessOperand}) }
  let mut operands = List<MirCallOperand>.make()
  let mut parameter = Shared<Type>.clone(&receiver)
  let mut borrow = Option<Access>.none()
  if invocationMode != CallableMode.Once {
    let access = match invocationMode { CallableMode.Mutable => Access.Mutable _ => Access.Shared }
    borrow = Option<Access>.some(access)
    let calleeOrigin = Shared<TypedBody>.with<BodyOrigin>(body, fn(value: &TypedBody) -> BodyOrigin { return TypedBody.nodeSlice(value)[inputs.callee.index].origin })
    parameter = run Types.intern(Type.Reference {referent: Shared<Type>.clone(&receiver), access: access,
      lifetime: run Shared<Lifetime>.make(Lifetime.Local {declaration: DeclarationId.copy(Application.bodyDeclaration(caller)), ordinal: calleeOrigin.node,
        binder: usize.MAX})})
  }
  run List<MirCallOperand>.append(&mut operands, MirCallOperand {value: move receiver, parameter: move parameter, borrow: move borrow})
  at = usize.ZERO
  while at < inputs.count {
    if at >= written.length { fail RevisionMismatch {} }
    let actual = run RuntimeType.applyBindings(&written[at], callerBindings, projections)
    let written = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(&signature,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> { return signatureParameter(answer, at) })
    let raw = match move written { Option<Shared<Type>>.Some {value} => move value _ => { fail RevisionMismatch {} } }
    let parameter = run RuntimeType.applyBindings(&raw, List<Binding>.asSlice(&targetBindings), projections)
    if !run Type.runtimeEqualsShared(&actual, &parameter) {
      if !run widenedOperand(&actual, &parameter) {
        return Result<MirCallTarget, PreparationFailure>.failResult(PreparationFailure.Coverage {code: GapCode.WitnessOperand})
      }
    }
    run List<MirCallOperand>.append(&mut operands, MirCallOperand {value: move actual, parameter: move parameter, borrow: Option<Access>.none()})
    at = at + usize.ONE
  }
  let calleeKey = match move run InstanceKey.function(run Application.copy(&application)) {
    Result<InstanceKey, CanonicalizationFailure>.Success {value: canonicalKey} => move canonicalKey
    Result<InstanceKey, CanonicalizationFailure>.Failure {error: reason} => {
      return Result<MirCallTarget, PreparationFailure>.failResult(PreparationFailure.Canonicalization {reason: reason})
    }
  }
  return Result<MirCallTarget, PreparationFailure>.succeed(MirCallTarget {node: node, receiverDereferences: usize.ZERO, key: move calleeKey,
    application: move application, edge: Edge.Direct, operands: move operands,
    stored: Option<MirStoredArguments>.none(), providers: List<MirProviderSource>.make(), dispatch: Option<MirProviderSource>.none(),
    witnessFailure: Option<Shared<Type>>.none(), nonParking: false, vacuous: false})
}

// Public invocation regions are numbered independently of the original anonymous header slots.
// The checked ordinal/value evidence maps through that same original header for both uses.
effect fn anonymousInvocationApplication(recorded: &Application, signature: &Shared<Result<Answer, NoRejection>>,
  selected: &[Argument], selectedOrdinals: &[usize]) -> Result<Application, PreparationFailure>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let slots = run anonymousInvocationSlots(signature, Application.bodyDeclaration(recorded))
  let ordinals = List<usize>.asSlice(&slots)
  if selected.length != selectedOrdinals.length { return Result<Application, PreparationFailure>.failResult(PreparationFailure.Coverage {code: GapCode.WitnessOperand}) }
  // CallableContract.compare admits a binder-free offer for every quantified invocation.
  // Those public regions constrain the caller's loans, not the concrete target's header;
  // retain its enclosing application without inventing invocation slots for them.
  if ordinals.length == usize.ZERO {
    return Result<Application, PreparationFailure>.succeed(run Application.copy(recorded))
  }
  let mut invocation = List<Binding>.make()
  let mut at = usize.ZERO
  while at < selected.length {
    if selectedOrdinals[at] >= ordinals.length { return Result<Application, PreparationFailure>.failResult(PreparationFailure.Coverage {code: GapCode.WitnessOperand}) }
    run List<Binding>.append(&mut invocation, Binding {declaration: run Shared<DeclarationId>.make(DeclarationId.copy(Application.bodyDeclaration(recorded))),
      ordinal: ordinals[selectedOrdinals[at]], value: Argument.copy(&selected[at])})
    at = at + usize.ONE
  }
  return Result<Application, PreparationFailure>.succeed(run Application.applyBindings(recorded, List<Binding>.asSlice(&invocation)))
}

// Whether a run expands through a prepared plan: a composition, a finite join, or a producer's
// Effect family realized as either (D4, EFF-013).
fn compositeType(value: &Type) -> bool {
  return match &value.* {
    Type.EffectComposite {..} => true
    Type.EffectJoin {..} => true
    Type.OpaqueRepresentation {..} => true
    _ => false
  }
}

// One alternative a stored join holds: the Effect to run, and its tag and payload type in the
// join's union storage.
struct StoredAlternative {
  alternative: Shared<Type>,
  tag: usize,
  storage: Shared<Type>,
}

// The alternatives of a finite join, or of the union storage a producer's join realizes;
// absent for any other Effect. A join whose storage collapsed has no injective tag map.
effect fn storedAlternatives(ty: &Shared<Type>, projections: &[RuntimeProjection]) -> Option<Result<List<StoredAlternative>, PreparationFailure>>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut output = List<StoredAlternative>.make()
  let copied = run Type.copy(ty)
  match move copied {
    Type.EffectJoin {alternatives, ..} => {
      let listed = List<Shared<Type>>.asSlice(&alternatives)
      if listed.length == usize.ONE {
        run List<StoredAlternative>.append(&mut output, StoredAlternative {alternative: Shared<Type>.clone(&listed[usize.ZERO]),
          tag: usize.ZERO, storage: Shared<Type>.clone(&listed[usize.ZERO])})
        return Option<Result<List<StoredAlternative>, PreparationFailure>>.some(Result<List<StoredAlternative>, PreparationFailure>.succeed(move output))
      }
      let none = List<Binding>.make()
      let mapped = match move run UnionProjection.map(ty, List<Binding>.asSlice(&none), projections) {
        Option<List<UnionProjection.Member>>.Some {value} => move value
        Option<List<UnionProjection.Member>>.None => {
          return Option<Result<List<StoredAlternative>, PreparationFailure>>.some(Result<List<StoredAlternative>, PreparationFailure>.failResult(PreparationFailure.Coverage {code: GapCode.UnionForm}))
        }
      }
      let members = List<UnionProjection.Member>.asSlice(&mapped)
      let mut at = usize.ZERO
      while at < listed.length {
        run List<StoredAlternative>.append(&mut output, StoredAlternative {alternative: Shared<Type>.clone(&listed[at]),
          tag: members[at].tag, storage: Shared<Type>.clone(&members[at].ty)})
        at = at + usize.ONE
      }
    }
    Type.Union {..} => {
      let canonical = match move run Type.canonicalUnionMembers(ty) {
        Option<List<Shared<Type>>>.Some {value} => move value
        Option<List<Shared<Type>>>.None => {
          return Option<Result<List<StoredAlternative>, PreparationFailure>>.some(Result<List<StoredAlternative>, PreparationFailure>.failResult(PreparationFailure.Coverage {code: GapCode.UnionForm}))
        }
      }
      let listed = List<Shared<Type>>.asSlice(&canonical)
      let mut at = usize.ZERO
      while at < listed.length {
        run List<StoredAlternative>.append(&mut output, StoredAlternative {alternative: Shared<Type>.clone(&listed[at]),
          tag: at, storage: Shared<Type>.clone(&listed[at])})
        at = at + usize.ONE
      }
    }
    _ => { return Option<Result<List<StoredAlternative>, PreparationFailure>>.none() }
  }
  return Option<Result<List<StoredAlternative>, PreparationFailure>>.some(Result<List<StoredAlternative>, PreparationFailure>.succeed(move output))
}

// Prepares the run of one exact Effect: a construction's or block's runner, or a composition whose
// parts are prepared first. Returns the step's index; the root is the last step (D4).
effect fn compositePlan(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, body: &Shared<TypedBody>, node: BodyNodeId, caller: &Application,
  callerBindings: &[Binding], projections: &[RuntimeProjection], identity: &Shared<DeclarationId>, ty: &Shared<Type>,
  origin: BodyOrigin, own: &[ProviderEntry], bound: &mut List<BoundProvider>, module: &ModuleId,
  steps: &mut List<MirRunPlan>, anchor: &Anchor) -> Result<usize, PreparationFailure>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  // A producer's Effect family runs through the storage its returns realize (EFF-013), and an
  // interface operation's Effect through the storage its selected witness realizes (EFF-001).
  if Shared<Type>.with<bool>(ty, fn(value: &Type) -> bool {
    return match &value.* { Type.OpaqueRepresentation {..} => true Type.CallableWitnessResult {..} => true _ => false }
  }) {
    let realized = match move run RuntimeType.resolved(ty, projections) {
      Option<Shared<Type>>.Some {value} => move value
      Option<Shared<Type>>.None => { return Result<usize, PreparationFailure>.failResult(PreparationFailure.Coverage {code: GapCode.EffectForm}) }
    }
    return run compositePlan(&mut resolver.*, &mut owner.*, &mut dependencies.*, body, node, caller, callerBindings,
      projections, identity, &realized, origin, own, &mut bound.*, module, &mut steps.*, anchor)
  }
  // A finite join runs only the selected alternative's own plan (EFF-013, D1).
  let stored = run storedAlternatives(ty, projections)
  if let Option<Result<List<StoredAlternative>, PreparationFailure>>.Some {value: found} = move stored {
    let alternatives = match move found {
      Result<List<StoredAlternative>, PreparationFailure>.Success {value} => move value
      Result<List<StoredAlternative>, PreparationFailure>.Failure {error} => { return Result<usize, PreparationFailure>.failResult(move error) }
    }
    let listed = List<StoredAlternative>.asSlice(&alternatives)
    let mut arms = List<MirJoinArm>.make()
    let mut at = usize.ZERO
    while at < listed.length {
      let step = match move run compositePlan(&mut resolver.*, &mut owner.*, &mut dependencies.*, body, node, caller, callerBindings,
        projections, identity, &listed[at].alternative, origin, own, &mut bound.*, module, &mut steps.*, anchor) {
        Result<usize, PreparationFailure>.Success {value} => value
        Result<usize, PreparationFailure>.Failure {error} => { return Result<usize, PreparationFailure>.failResult(move error) }
      }
      run List<MirJoinArm>.append(&mut arms, MirJoinArm {step: step, tag: listed[at].tag, ty: Shared<Type>.clone(&listed[at].storage)})
      at = at + usize.ONE
    }
    run List<MirRunPlan>.append(&mut steps.*, MirRunPlan.Join {arms: move arms, tagged: listed.length > usize.ONE})
    return Result<usize, PreparationFailure>.succeed(List<MirRunPlan>.length(&steps.*) - usize.ONE)
  }
  // An exclusive view lent to a `mut` or `once` parameter, or the bare reference it normalizes
  // to, runs the lender's own plan through that reference (EFFECT-OWN-002).
  let lender = Shared<Type>.with<Option<Shared<Type>>>(ty, lentStorage)
  if let Option<Shared<Type>>.Some {value: referent} = move lender {
    let inner = match move run compositePlan(&mut resolver.*, &mut owner.*, &mut dependencies.*, body, node, caller,
      callerBindings, projections, identity, &referent, origin, own, &mut bound.*, module, &mut steps.*, anchor) {
      Result<usize, PreparationFailure>.Success {value} => value
      Result<usize, PreparationFailure>.Failure {error} => { return Result<usize, PreparationFailure>.failResult(move error) }
    }
    run List<MirRunPlan>.append(&mut steps.*, MirRunPlan.Lent {inner: inner})
    return Result<usize, PreparationFailure>.succeed(List<MirRunPlan>.length(&steps.*) - usize.ONE)
  }
  let channels = match move Shared<Type>.with<Option<EffectChannels>>(ty, effectChannels) {
    Option<EffectChannels>.Some {value} => move value
    Option<EffectChannels>.None => { return Result<usize, PreparationFailure>.failResult(PreparationFailure.Coverage {code: GapCode.EffectForm}) }
  }
  let shape = run Type.copy(ty)
  match move shape {
    Type.EffectComposite {operation, selector, parts, ..} => {
      let stored = List<Shared<Type>>.asSlice(&parts)
      // A binding serves its selected key with the stored provider for part 0's run only (D2 rule 2).
      if bindingComposition(operation) {
        let owned = operation == Composition.BindOwned
        // An owned provider that needs cleanup is dropped on both exits of the inner run.
        let mut providerDrop = Option<MirProviderDrop>.none()
        if owned {
          let cleanup = match move run ownedCleanup(&mut resolver.*, &mut owner.*, &mut dependencies.*, &stored[usize.ONE], origin, anchor) {
            Result<Option<Shared<Type>>, PreparationFailure>.Success {value} => move value
            Result<Option<Shared<Type>>, PreparationFailure>.Failure {error} => { return Result<usize, PreparationFailure>.failResult(move error) }
          }
          if let Option<Shared<Type>>.Some {value: dropped} = move cleanup {
            let protected = match move partChannels(&stored[usize.ZERO]) {
              Option<EffectChannels>.Some {value} => move value
              Option<EffectChannels>.None => { return Result<usize, PreparationFailure>.failResult(PreparationFailure.Coverage {code: GapCode.EffectForm}) }
            }
            providerDrop = Option<MirProviderDrop>.some(MirProviderDrop {provider: move dropped, innerFailure: move protected.failure})
          }
        }
        let mut access = Access.Mutable
        if operation == Composition.BindShared { access = Access.Shared }
        let provider = match move Shared<Type>.with<Option<Shared<Type>>>(&stored[usize.ONE], fn(value: &Type) -> Option<Shared<Type>> {
          if owned { return Option<Shared<Type>>.none() }
          return match &value.* { Type.Reference {referent, ..} => Option<Shared<Type>>.some(Shared<Type>.clone(&referent)) _ => Option<Shared<Type>>.none() }
        }) {
          Option<Shared<Type>>.Some {value} => move value
          Option<Shared<Type>>.None => Shared<Type>.clone(&stored[usize.ONE])
        }
        let address = run Types.intern(Type.Reference {referent: Shared<Type>.clone(&provider), access: access,
          lifetime: run Shared<Lifetime>.make(Lifetime.Static)})
        let key = match move run carriedKey(&selector) {
          Option<Requirement>.Some {value} => move value
          Option<Requirement>.None => { return Result<usize, PreparationFailure>.failResult(PreparationFailure.Coverage {code: GapCode.EffectForm}) }
        }
        run List<BoundProvider>.append(&mut bound.*, BoundProvider {key: move key, owned: owned, access: access,
          provider: move provider, address: move address})
        let inner = run compositePlan(&mut resolver.*, &mut owner.*, &mut dependencies.*, body, node, caller, callerBindings,
          projections, identity, &stored[usize.ZERO], origin, own, &mut bound.*, module, &mut steps.*, anchor)
        drop List<BoundProvider>.pop(&mut bound.*)
        let innerStep = match move inner {
          Result<usize, PreparationFailure>.Success {value} => value
          Result<usize, PreparationFailure>.Failure {error} => { return Result<usize, PreparationFailure>.failResult(move error) }
        }
        run List<MirRunPlan>.append(&mut steps.*, MirRunPlan.Bind {inner: innerStep, providerDrop: move providerDrop})
        return Result<usize, PreparationFailure>.succeed(List<MirRunPlan>.length(&steps.*) - usize.ONE)
      }
      if operation == Composition.Observe {
        // The body runs under this observer; its callback is reached through the observer record (N1).
        let callback = match move run observerTarget(&mut resolver.*, &mut owner.*, &mut dependencies.*, body, node, caller,
          callerBindings, projections, identity, &stored[usize.ONE], &stored[usize.ZERO], origin, anchor) {
          Result<MirCallTarget, PreparationFailure>.Success {value} => move value
          Result<MirCallTarget, PreparationFailure>.Failure {error} => { return Result<usize, PreparationFailure>.failResult(move error) }
        }
        let stateDrop = match move run ownedCleanup(&mut resolver.*, &mut owner.*, &mut dependencies.*, &stored[usize.ZERO], origin, anchor) {
          Result<Option<Shared<Type>>, PreparationFailure>.Success {value} => move value
          Result<Option<Shared<Type>>, PreparationFailure>.Failure {error} => { return Result<usize, PreparationFailure>.failResult(move error) }
        }
        let callbackDrop = match move run ownedCleanup(&mut resolver.*, &mut owner.*, &mut dependencies.*, &stored[usize.ONE], origin, anchor) {
          Result<Option<Shared<Type>>, PreparationFailure>.Success {value} => move value
          Result<Option<Shared<Type>>, PreparationFailure>.Failure {error} => { return Result<usize, PreparationFailure>.failResult(move error) }
        }
        let inner = match move run compositePlan(&mut resolver.*, &mut owner.*, &mut dependencies.*, body, node, caller,
          callerBindings, projections, identity, &stored[2], origin, own, &mut bound.*, module, &mut steps.*, anchor) {
          Result<usize, PreparationFailure>.Success {value} => value
          Result<usize, PreparationFailure>.Failure {error} => { return Result<usize, PreparationFailure>.failResult(move error) }
        }
        let address = run Types.intern(Type.Reference {referent: Shared<Type>.clone(&stored[usize.ZERO]), access: Access.Mutable,
          lifetime: run Shared<Lifetime>.make(Lifetime.Static)})
        // Every diagnostic the body reports invokes the callback, so it owes the NonParking proof
        // the observation intrinsic declares, unless a premise of the caller carries it or this whole
        // composite.
        let carriedPart = run carriesNonParking(&mut resolver.*, &mut owner.*, &mut dependencies.*, caller, callerBindings,
          projections, &stored[usize.ONE], BodyOrigin.span(origin, anchor))
        let carriedWhole = run carriesNonParking(&mut resolver.*, &mut owner.*, &mut dependencies.*, caller, callerBindings,
          projections, ty, BodyOrigin.span(origin, anchor))
        let owed = !carriedPart && !carriedWhole
        let lent = run Types.intern(Type.Reference {referent: Shared<Type>.clone(&stored[usize.ONE]), access: Access.Shared,
          lifetime: run Shared<Lifetime>.make(Lifetime.Static)})
        run List<MirRunPlan>.append(&mut steps.*, MirRunPlan.Observe {inner: inner, state: move address, stateDrop: move stateDrop,
          callable: move lent, callbackDrop: move callbackDrop, callback: move callback, owed: owed})
        return Result<usize, PreparationFailure>.succeed(List<MirRunPlan>.length(&steps.*) - usize.ONE)
      }
      if operation == Composition.UseRelease {
        // Both callables receive a fresh exclusive loan of the owned resource (D4).
        let lent = run Types.intern(Type.Reference {referent: Shared<Type>.clone(&stored[usize.ZERO]), access: Access.Mutable,
          lifetime: run Shared<Lifetime>.make(Lifetime.Local {
            declaration: DeclarationId.copy(Application.bodyDeclaration(caller)), ordinal: origin.node, binder: usize.MAX})})
        let use = match move run invokedTarget(&mut resolver.*, &mut owner.*, &mut dependencies.*, body, node, caller, callerBindings,
          projections, identity, &stored[usize.ONE], &lent, origin, anchor) {
          Result<InvokedTarget, PreparationFailure>.Success {value} => move value
          Result<InvokedTarget, PreparationFailure>.Failure {error} => { return Result<usize, PreparationFailure>.failResult(move error) }
        }
        let release = match move run invokedTarget(&mut resolver.*, &mut owner.*, &mut dependencies.*, body, node, caller,
          callerBindings, projections, identity, &stored[2], &lent, origin, anchor) {
          Result<InvokedTarget, PreparationFailure>.Success {value} => move value
          Result<InvokedTarget, PreparationFailure>.Failure {error} => { return Result<usize, PreparationFailure>.failResult(move error) }
        }
        // Both callables are invoked on every path; a loaned invocation would leave an owning one undropped.
        if (use.mode != CallableMode.Once && run ownsCleanup(&mut resolver.*, &mut owner.*, &mut dependencies.*, &stored[usize.ONE], origin, anchor))
          || (release.mode != CallableMode.Once && run ownsCleanup(&mut resolver.*, &mut owner.*, &mut dependencies.*, &stored[2], origin, anchor)) {
          return Result<usize, PreparationFailure>.failResult(PreparationFailure.Coverage {code: GapCode.Cleanup})
        }
        let resourceDrop = match move run ownedCleanup(&mut resolver.*, &mut owner.*, &mut dependencies.*, &stored[usize.ZERO], origin, anchor) {
          Result<Option<Shared<Type>>, PreparationFailure>.Success {value} => move value
          Result<Option<Shared<Type>>, PreparationFailure>.Failure {error} => { return Result<usize, PreparationFailure>.failResult(move error) }
        }
        let InvokedTarget {target: useCall, channels: useChannels, ..} = move use
        // A failure waits for the release; a frame cancelled meanwhile drops it.
        let useFailureDrop = match move run ownedCleanup(&mut resolver.*, &mut owner.*, &mut dependencies.*, &useChannels.failure, origin, anchor) {
          Result<Option<Shared<Type>>, PreparationFailure>.Success {value} => move value
          Result<Option<Shared<Type>>, PreparationFailure>.Failure {error} => { return Result<usize, PreparationFailure>.failResult(move error) }
        }
        let InvokedTarget {target: releaseCall, channels: releaseChannels, ..} = move release
        let useServed = match move run provideCall(&mut resolver.*, &mut owner.*, &mut dependencies.*, move useCall, own,
          List<BoundProvider>.asSlice(&bound.*), projections, module, BodyOrigin.span(origin, anchor)) {
          Result<MirCallTarget, PreparationFailure>.Success {value} => move value
          Result<MirCallTarget, PreparationFailure>.Failure {error} => { return Result<usize, PreparationFailure>.failResult(move error) }
        }
        let releaseServed = match move run provideCall(&mut resolver.*, &mut owner.*, &mut dependencies.*, move releaseCall, own,
          List<BoundProvider>.asSlice(&bound.*), projections, module, BodyOrigin.span(origin, anchor)) {
          Result<MirCallTarget, PreparationFailure>.Success {value} => move value
          Result<MirCallTarget, PreparationFailure>.Failure {error} => { return Result<usize, PreparationFailure>.failResult(move error) }
        }
        // A release's NonParking proof is owed here unless a premise of the caller carries it, or
        // carries this whole composite, whose entry obligation covers every part and drop. A
        // carried release does not cover the resource the run drops after it.
        let carriedPart = run carriesNonParking(&mut resolver.*, &mut owner.*, &mut dependencies.*, caller, callerBindings,
          projections, &stored[2], BodyOrigin.span(origin, anchor))
        let carriedWhole = run carriesNonParking(&mut resolver.*, &mut owner.*, &mut dependencies.*, caller, callerBindings,
          projections, ty, BodyOrigin.span(origin, anchor))
        let owed = !carriedPart && !carriedWhole
        let resourceOwed = !carriedWhole
        run List<MirRunPlan>.append(&mut steps.*, MirRunPlan.UseRelease {lent: move lent, use: move useServed,
          useSuccess: move useChannels.success, useFailure: move useChannels.failure, useFailureDrop: move useFailureDrop,
          release: move releaseServed,
          releaseSuccess: move releaseChannels.success, releaseFailure: move releaseChannels.failure, resourceDrop: move resourceDrop,
          owed: owed, resourceOwed: resourceOwed})
        return Result<usize, PreparationFailure>.succeed(List<MirRunPlan>.length(&steps.*) - usize.ONE)
      }
      // A suspension runs its deferred child at an explicit boundary (SUSP-001).
      if operation == Composition.Suspend {
        let deferred = match move run compositePlan(&mut resolver.*, &mut owner.*, &mut dependencies.*, body, node, caller,
          callerBindings, projections, identity, &stored[usize.ZERO], origin, own, &mut bound.*, module, &mut steps.*, anchor) {
          Result<usize, PreparationFailure>.Success {value} => value
          Result<usize, PreparationFailure>.Failure {error} => { return Result<usize, PreparationFailure>.failResult(move error) }
        }
        run List<MirRunPlan>.append(&mut steps.*, MirRunPlan.Suspend {inner: deferred})
        return Result<usize, PreparationFailure>.succeed(List<MirRunPlan>.length(&steps.*) - usize.ONE)
      }
      if operation != Composition.CatchFailure && operation != Composition.Finalize && operation != Composition.FinalizeNonParking {
        return Result<usize, PreparationFailure>.failResult(PreparationFailure.Coverage {code: GapCode.EffectForm})
      }
      let inner = match move run compositePlan(&mut resolver.*, &mut owner.*, &mut dependencies.*, body, node, caller, callerBindings,
        projections, identity, &stored[usize.ZERO], origin, own, &mut bound.*, module, &mut steps.*, anchor) {
        Result<usize, PreparationFailure>.Success {value} => value
        Result<usize, PreparationFailure>.Failure {error} => { return Result<usize, PreparationFailure>.failResult(move error) }
      }
      let protected = match move partChannels(&stored[usize.ZERO]) {
        Option<EffectChannels>.Some {value} => move value
        Option<EffectChannels>.None => { return Result<usize, PreparationFailure>.failResult(PreparationFailure.Coverage {code: GapCode.EffectForm}) }
      }
      if operation != Composition.CatchFailure {
        // The finalizer is itself an exact Effect. NonParking is a compile-time bound (D4): the run owes
        // its proof unless a premise of the caller carries it, or carries this whole composite.
        let finalizer = match move run compositePlan(&mut resolver.*, &mut owner.*, &mut dependencies.*, body, node, caller,
          callerBindings, projections, identity, &stored[usize.ONE], origin, own, &mut bound.*, module, &mut steps.*, anchor) {
          Result<usize, PreparationFailure>.Success {value} => value
          Result<usize, PreparationFailure>.Failure {error} => { return Result<usize, PreparationFailure>.failResult(move error) }
        }
        let cleanup = match move partChannels(&stored[usize.ONE]) {
          Option<EffectChannels>.Some {value} => move value
          Option<EffectChannels>.None => { return Result<usize, PreparationFailure>.failResult(PreparationFailure.Coverage {code: GapCode.EffectForm}) }
        }
        // Cancelling the protected part drops a parking finalizer unrun.
        let finalizerDrop = match move run ownedCleanup(&mut resolver.*, &mut owner.*, &mut dependencies.*, &stored[usize.ONE], origin, anchor) {
          Result<Option<Shared<Type>>, PreparationFailure>.Success {value} => move value
          Result<Option<Shared<Type>>, PreparationFailure>.Failure {error} => { return Result<usize, PreparationFailure>.failResult(move error) }
        }
        // A failure waits for the finalizer; a frame cancelled meanwhile drops it.
        let innerFailureDrop = match move run ownedCleanup(&mut resolver.*, &mut owner.*, &mut dependencies.*, &protected.failure, origin, anchor) {
          Result<Option<Shared<Type>>, PreparationFailure>.Success {value} => move value
          Result<Option<Shared<Type>>, PreparationFailure>.Failure {error} => { return Result<usize, PreparationFailure>.failResult(move error) }
        }
        let nonParking = operation == Composition.FinalizeNonParking
        let carriedPart = run carriesNonParking(&mut resolver.*, &mut owner.*, &mut dependencies.*, caller, callerBindings,
          projections, &stored[usize.ONE], BodyOrigin.span(origin, anchor))
        let carriedWhole = run carriesNonParking(&mut resolver.*, &mut owner.*, &mut dependencies.*, caller, callerBindings,
          projections, ty, BodyOrigin.span(origin, anchor))
        let owed = nonParking && !carriedPart && !carriedWhole
        run List<MirRunPlan>.append(&mut steps.*, MirRunPlan.Finalize {inner: inner, innerFailure: move protected.failure,
          innerFailureDrop: move innerFailureDrop, finalizer: finalizer, finalizerSuccess: move cleanup.success, nonParking: nonParking,
          finalizerDrop: move finalizerDrop, owed: owed})
        return Result<usize, PreparationFailure>.succeed(List<MirRunPlan>.length(&steps.*) - usize.ONE)
      }
      let handler = match move run invokedTarget(&mut resolver.*, &mut owner.*, &mut dependencies.*, body, node, caller,
        callerBindings, projections, identity, &stored[usize.ONE], &selector, origin, anchor) {
        Result<InvokedTarget, PreparationFailure>.Success {value} => move value
        Result<InvokedTarget, PreparationFailure>.Failure {error} => { return Result<usize, PreparationFailure>.failResult(move error) }
      }
      let InvokedTarget {target: handlerCall, channels: handlerChannels, mode: handlerMode} = move handler
      let handlerServed = match move run provideCall(&mut resolver.*, &mut owner.*, &mut dependencies.*, move handlerCall, own,
        List<BoundProvider>.asSlice(&bound.*), projections, module, BodyOrigin.span(origin, anchor)) {
        Result<MirCallTarget, PreparationFailure>.Success {value} => move value
        Result<MirCallTarget, PreparationFailure>.Failure {error} => { return Result<usize, PreparationFailure>.failResult(move error) }
      }
      // Only the selected path consumes the handler; every other exit drops an owning one.
      let handlerDrop = match move run ownedCleanup(&mut resolver.*, &mut owner.*, &mut dependencies.*, &stored[usize.ONE], origin, anchor) {
        Result<Option<Shared<Type>>, PreparationFailure>.Success {value} => move value
        Result<Option<Shared<Type>>, PreparationFailure>.Failure {error} => { return Result<usize, PreparationFailure>.failResult(move error) }
      }
      if let Option<Shared<Type>>.Some {..} = &handlerDrop {
        if handlerMode != CallableMode.Once { return Result<usize, PreparationFailure>.failResult(PreparationFailure.Coverage {code: GapCode.Cleanup}) }
      }
      run List<MirRunPlan>.append(&mut steps.*, MirRunPlan.Catch {selector: move selector, inner: inner,
        innerFailure: move protected.failure, handler: move handlerServed, handlerSuccess: move handlerChannels.success,
        handlerFailure: move handlerChannels.failure, handlerDrop: move handlerDrop})
    }
    Type.CallableValue {contract, ..} => {
      let mode = Shared<Type>.with<CallableMode>(&contract, callableInvocationMode)
      // A stored part runs once per exit; a loaned run never consumes, so nothing would drop it.
      if mode != CallableMode.Once {
        if run ownsCleanup(&mut resolver.*, &mut owner.*, &mut dependencies.*, ty, origin, anchor) { return Result<usize, PreparationFailure>.failResult(PreparationFailure.Coverage {code: GapCode.Cleanup}) }
      }
      let inputs = CallableCallInputs {receiver: Shared<Type>.clone(ty), inference: Shared<DeclarationId>.clone(identity),
        bindings: run Shared<List<Binding>>.make(List<Binding>.make()), mode: mode, callee: node,
        result: Shared<Type>.clone(&channels.success), count: usize.ZERO, origin: origin}
      let written = List<Shared<Type>>.make()
      let constructed = match move run concreteCallableCall(&mut resolver.*, &mut owner.*, &mut dependencies.*, body, node, caller,
        callerBindings, projections, move inputs, List<Shared<Type>>.asSlice(&written), anchor) {
        Result<MirCallTarget, PreparationFailure>.Success {value} => move value
        Result<MirCallTarget, PreparationFailure>.Failure {error} => { return Result<usize, PreparationFailure>.failResult(move error) }
      }
      let target = match move run provideCall(&mut resolver.*, &mut owner.*, &mut dependencies.*, move constructed, own,
        List<BoundProvider>.asSlice(&bound.*), projections, module, BodyOrigin.span(origin, anchor)) {
        Result<MirCallTarget, PreparationFailure>.Success {value} => move value
        Result<MirCallTarget, PreparationFailure>.Failure {error} => { return Result<usize, PreparationFailure>.failResult(move error) }
      }
      run List<MirRunPlan>.append(&mut steps.*, MirRunPlan.Runner {target: move target, success: move channels.success,
        failure: move channels.failure})
    }
    _ => { return Result<usize, PreparationFailure>.failResult(PreparationFailure.Coverage {code: GapCode.EffectForm}) }
  }
  return Result<usize, PreparationFailure>.succeed(List<MirRunPlan>.length(&steps.*) - usize.ONE)
}

// The runtime storage types an instance's own `Intrinsic.NonParking` premises bind, or none when its
// premises are unavailable.
effect fn nonParkingSubjects(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, caller: &Application, callerBindings: &[Binding], projections: &[RuntimeProjection],
  span: Span) -> Option<List<Shared<Type>>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let premises = match move run closedApplicationPremises(&mut resolver.*, &mut owner.*, &mut dependencies.*, caller,
    callerBindings, span) {
    Option<List<Constraint>>.Some {value} => move value
    Option<List<Constraint>>.None => { return Option<List<Shared<Type>>>.none() }
  }
  let listed = List<Constraint>.asSlice(&premises)
  let mut subjects = List<Shared<Type>>.make()
  let mut at = usize.ZERO
  while at < listed.length {
    if let Constraint.Property {subject, property} = &listed[at] {
      if property == IntrinsicProperty.NonParking {
        run List<Shared<Type>>.append(&mut subjects, run RuntimeType.project(&subject, projections))
      }
    }
    at = at + usize.ONE
  }
  return Option<List<Shared<Type>>>.some(move subjects)
}

// Whether an `Intrinsic.NonParking` premise of the caller binds the stored part `part`. Such a
// part's proof is the caller instance's own entry obligation, checked against the same type, so
// the site owes none (the bootstrap's `carriesNonParkingProof`).
effect fn carriesNonParking(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, caller: &Application, callerBindings: &[Binding], projections: &[RuntimeProjection],
  part: &Shared<Type>, span: Span) -> bool
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let subjects = match move run nonParkingSubjects(&mut resolver.*, &mut owner.*, &mut dependencies.*, caller, callerBindings,
    projections, span) {
    Option<List<Shared<Type>>>.Some {value} => move value
    Option<List<Shared<Type>>>.None => { return false }
  }
  let stored = run RuntimeType.project(part, projections)
  let listed = List<Shared<Type>>.asSlice(&subjects)
  let mut at = usize.ZERO
  while at < listed.length {
    if run Type.runtimeEqualsShared(&listed[at], &stored) { return true }
    at = at + usize.ONE
  }
  return false
}

// Appends the instances that run a value of the closed runtime type `ty` to `targets`, the
// declaration of a callable schema, each of whose uses opens its own instance, to `declarations`,
// and the types whose drop glue running or dropping the value executes in place to `glues`.
// Answers
// false when some part of it has no exact executable target: the bootstrap's
// `Unavailable:exact execution target`, which leaves the NonParking proof unproved (SEM0139).
effect fn executableTargets(ty: &Shared<Type>, targets: &mut List<InstanceKey>, declarations: &mut List<Shared<DeclarationId>>,
  glues: &mut List<Shared<Type>>) -> bool
! OutOfMemoryError ? &mut Allocator | &mut Types {
  // The value may be dropped unrun, such as a cancelled finalizer, which runs its glue in place.
  run List<Shared<Type>>.append(&mut glues.*, Shared<Type>.clone(ty))
  let shape = run Type.copy(ty)
  match move shape {
    Type.CallableValue {application, ..} => {
      let key = match move run InstanceKey.function(run Application.copyShared(&application)) {
        Result<InstanceKey, CanonicalizationFailure>.Success {value} => move value
        Result<InstanceKey, CanonicalizationFailure>.Failure {..} => { return false }
      }
      run List<InstanceKey>.append(&mut targets.*, move key)
      return true
    }
    Type.EffectComposite {operation, parts, ..} => {
      let stored = List<Shared<Type>>.asSlice(&parts)
      // The executable parts of each composition: a binding's provider, a bracket's resource and
      // an observer's state are data, reached only through the instances that run the others.
      let mut first = usize.ZERO
      let mut last = usize.ZERO
      if operation == Composition.CatchFailure || operation == Composition.Finalize || operation == Composition.FinalizeNonParking {
        last = usize.ONE
      } else if operation == Composition.UseRelease || operation == Composition.Observe {
        first = usize.ONE
        last = 2
      }
      if last >= stored.length { return false }
      // The runner drops its data parts in place: a bracket's resource, a binding's provider and
      // an observer's state.
      let mut part = usize.ZERO
      while part < stored.length {
        run List<Shared<Type>>.append(&mut glues.*, Shared<Type>.clone(&stored[part]))
        part = part + usize.ONE
      }
      let mut at = first
      while at <= last {
        if !run executableTargets(&stored[at], &mut targets.*, &mut declarations.*, &mut glues.*) { return false }
        at = at + usize.ONE
      }
      return true
    }
    Type.EffectJoin {alternatives, ..} => {
      let listed = List<Shared<Type>>.asSlice(&alternatives)
      let mut at = usize.ZERO
      while at < listed.length {
        if !run executableTargets(&listed[at], &mut targets.*, &mut declarations.*, &mut glues.*) { return false }
        at = at + usize.ONE
      }
      return listed.length > usize.ZERO
    }
    Type.CallableSchema {schema, ..} => {
      let target = Shared<SectionSchema>.with<Shared<DeclarationId>>(&schema, fn(value: &SectionSchema) -> Shared<DeclarationId> {
        return Shared<DeclarationId>.clone(&value.target)
      })
      run List<Shared<DeclarationId>>.append(&mut declarations.*, move target)
      return true
    }
    Type.CallableView {representation, ..} => { return run executableTargets(&representation, &mut targets.*, &mut declarations.*, &mut glues.*) }
    Type.Reference {referent, ..} => { return run executableTargets(&referent, &mut targets.*, &mut declarations.*, &mut glues.*) }
    _ => { return false }
  }
}

// Whether `key` is a plain function whose result is an Effect value, which its caller runs. A
// function whose signature is unavailable answers true.
effect fn returnsEffectValue(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, key: &InstanceKey) -> bool
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  if let Option<Shared<Application>>.None = move InstanceKey.application(key) { return false }
  let identity = InstanceKey.identity(key)
  let location = match move run locationOfIdentity(&mut resolver.*, &identity) {
    Option<InstanceLocation>.Some {value} => value
    Option<InstanceLocation>.None => { return true }
  }
  let request = Key {family: Family.Signature, module: location.module, name: usize.ZERO, declaration: location.declaration,
    member: usize.ZERO, external: false}
  let interned = run internDeclaration(&mut resolver.*, request)
  let signature = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, interned, Span.make(usize.ZERO, usize.ZERO))
  let facts = match move Shared<Result<Answer, NoRejection>>.with<Option<SignatureFacts>>(&signature, signatureFacts) {
    Option<SignatureFacts>.Some {value} => move value
    Option<SignatureFacts>.None => { return true }
  }
  if facts.isEffect { return false }
  let channels = Shared<Type>.with<Option<EffectChannels>>(&facts.result, effectChannels)
  return match &channels { Option<EffectChannels>.Some {..} => true Option<EffectChannels>.None => false }
}

// An instance's entry NonParking obligations: each of its own `Intrinsic.NonParking` premises,
// owed by the call that reaches the instance, against the instances that run the bound value.
effect fn entryNonParking(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, caller: &Application, callerBindings: &[Binding], projections: &[RuntimeProjection])
  -> List<MirNonParkingRun>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut obligations = List<MirNonParkingRun>.make()
  let subjects = match move run nonParkingSubjects(&mut resolver.*, &mut owner.*, &mut dependencies.*, caller, callerBindings,
    projections, Span.make(usize.ZERO, usize.ZERO)) {
    Option<List<Shared<Type>>>.Some {value} => move value
    Option<List<Shared<Type>>>.None => {
      run List<MirNonParkingRun>.append(&mut obligations, MirNonParkingRun {callees: List<InstanceKey>.make(),
        glues: List<Shared<Type>>.make(), declarations: List<Shared<DeclarationId>>.make(), exact: false,
        origin: Option<BodyOrigin>.none()})
      return move obligations
    }
  }
  let listed = List<Shared<Type>>.asSlice(&subjects)
  let mut at = usize.ZERO
  while at < listed.length {
    let mut callees = List<InstanceKey>.make()
    let mut declarations = List<Shared<DeclarationId>>.make()
    let mut glues = List<Shared<Type>>.make()
    let mut exact = run executableTargets(&listed[at], &mut callees, &mut declarations, &mut glues)
    // A plain function that returns an Effect value hands it to its caller to run, so the instance
    // alone does not run everything the bound value starts. Such a target is not exact until a
    // returned composite's parts can be targeted.
    let reached = List<InstanceKey>.asSlice(&callees)
    let mut callee = usize.ZERO
    while exact && callee < reached.length {
      if run returnsEffectValue(&mut resolver.*, &mut owner.*, &mut dependencies.*, &reached[callee]) { exact = false }
      callee = callee + usize.ONE
    }
    run List<MirNonParkingRun>.append(&mut obligations, MirNonParkingRun {callees: move callees, glues: move glues,
      declarations: move declarations, exact: exact, origin: Option<BodyOrigin>.none()})
    at = at + usize.ONE
  }
  return move obligations
}

// The channels of a stored Effect part, read through a lent view or reference to its lender.
fn partChannels(value: &Shared<Type>) -> Option<EffectChannels> {
  let lender = Shared<Type>.with<Option<Shared<Type>>>(value, lentStorage)
  if let Option<Shared<Type>>.Some {value: referent} = move lender {
    return Shared<Type>.with<Option<EffectChannels>>(&referent, effectChannels)
  }
  return Shared<Type>.with<Option<EffectChannels>>(value, effectChannels)
}

// Whether `value` is an Effect or callable value an exclusive view may lend.
fn lendableValue(value: &Type) -> bool {
  return match &value.* {
    Type.Reference {..} => false
    Type.CallableValue {..} => true
    Type.EffectComposite {..} => true
    Type.EffectJoin {..} => true
    _ => callableInvocationMode(value) != CallableMode.Once
  }
}

// The lender storage an exclusive Effect view or reference runs through, if `value` is one.
fn lentStorage(value: &Type) -> Option<Shared<Type>> {
  return match &value.* {
    Type.CallableView {representation, ..} => Shared<Type>.with<Option<Shared<Type>>>(&representation, lentStorage)
    Type.Reference {referent, access, ..} => {
      if access != Access.Mutable { return Option<Shared<Type>>.none() }
      return Option<Shared<Type>>.some(Shared<Type>.clone(&referent))
    }
    _ => Option<Shared<Type>>.none()
  }
}

// The target size, alignment and stride of one closed runtime type, demanded through the layout
// query.
effect fn measuredLayout(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, ty: &Shared<Type>, span: Span) -> Option<LayoutMetrics>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let application = run internErasedType(&mut resolver.*, ty)
  let declarationAccess178Request = Key {family: Family.Layout, module: usize.ZERO,
    name: application, declaration: usize.ZERO, member: usize.ZERO, external: false}
  let declarationAccess178 = run internDeclaration(&mut resolver.*, declarationAccess178Request)
  let layout = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, declarationAccess178, span)
  let selected = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(&layout, layoutIndex)
  if let Option<usize>.Some {value} = move selected {
    let layouts = List<Shared<BackendLayout>>.asSlice(&resolver.layoutValues)
    return Option<LayoutMetrics>.some(Shared<BackendLayout>.with<LayoutMetrics>(&layouts[value], BackendLayout.metrics))
  }
  return Option<LayoutMetrics>.none()
}

// One closed written type argument of a storage call.
effect fn storageInstanceType(body: &Shared<TypedBody>, node: BodyNodeId, at: usize, callerBindings: &[Binding],
  projections: &[RuntimeProjection]) -> Shared<Type> ! RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let written = TypedBody.storageTypeArgument(body, node, at)
  return match move written {
    Option<Shared<Type>>.Some {value} => run RuntimeType.applyBindings(&value, callerBindings, projections)
    Option<Shared<Type>>.None => { fail RevisionMismatch {} }
  }
}

// A schema's contract is an original bound blueprint, not its selected invocation result.
// Select from the actual operands and caller premises before checking the storage promise.
effect fn storageInvocationResult(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, caller: &Application,
  callerBindings: &[Binding], projections: &[RuntimeProjection], receiver: &Shared<Type>, contract: &Shared<Type>,
  written: &[Shared<Type>], span: Span) -> Result<Shared<Type>, PreparationFailure>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut callable = Shared<Type>.clone(receiver)
  while true {
    let copied = run Type.copy(&callable)
    if let Type.Reference {referent, ..} = move copied { callable = move referent } else { break }
  }
  let schema = Shared<Type>.with<Option<Shared<SectionSchema>>>(&callable, sectionSchemaOf)
  if let Option<Shared<SectionSchema>>.Some {value: recipe} = move schema {
    let module = DeclarationId.moduleId(Application.bodyDeclaration(caller))
    let premises = match move run closedApplicationPremises(&mut resolver.*, &mut owner.*, &mut dependencies.*,
      caller, callerBindings, span) {
      Option<List<Constraint>>.Some {value} => move value
      _ => { return Result<Shared<Type>, PreparationFailure>.failResult(PreparationFailure.Coverage {code: GapCode.TypedForm}) }
    }
    let callableInputs = run sectionFieldInputs(&callable)
    let selected = match move run schemaCallableApplication(&mut resolver.*, &mut owner.*, &mut dependencies.*,
      module, callerBindings, List<Constraint>.asSlice(&premises), &recipe, List<CallableFieldInput>.asSlice(&callableInputs),
      written, span) {
      Result<Application, PreparationFailure>.Success {value} => move value
      Result<Application, PreparationFailure>.Failure {error} => { return Result<Shared<Type>, PreparationFailure>.failResult(move error) }
    }
    let application = run Application.substitute(&selected, caller)
    let signature = run sectionOriginalSignature(&mut resolver.*, &mut owner.*, &mut dependencies.*,
      Application.bodyDeclaration(&application), span)
    let facts = match move Shared<Result<Answer, NoRejection>>.with<Option<SignatureFacts>>(&signature, signatureFacts) {
      Option<SignatureFacts>.Some {value} => move value
      _ => { return Result<Shared<Type>, PreparationFailure>.failResult(PreparationFailure.Coverage {code: GapCode.SignatureForm}) }
    }
    // An effect fn invocation constructs an Effect rather than returning its runner's success.
    // Storage does not yet prepare that construction; do not admit the success as its result.
    if facts.isEffect { return Result<Shared<Type>, PreparationFailure>.failResult(PreparationFailure.Coverage {code: GapCode.TypedForm}) }
    let bindings = run Application.bindings(&application)
    return run callableInvocationResult(&mut resolver.*, &mut owner.*, &mut dependencies.*, &application,
      &facts.result, List<Binding>.asSlice(&bindings), projections, span)
  }
  let result = match move Shared<Type>.with<Option<Shared<Type>>>(contract, callableResult) {
    Option<Shared<Type>>.Some {value} => move value
    _ => { return Result<Shared<Type>, PreparationFailure>.failResult(PreparationFailure.Coverage {code: GapCode.TypedForm}) }
  }
  return Result<Shared<Type>, PreparationFailure>.succeed(run RuntimeType.applyBindings(&result, callerBindings, projections))
}

// The prepared invocation and actual result of one storage callback, independently checked
// against the primitive's promise. Only its conflict policy may diverge instead of producing it.
effect fn storageCallableTarget(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, body: &Shared<TypedBody>, node: BodyNodeId, argument: BodyNodeId, caller: &Application,
  callerBindings: &[Binding], projections: &[RuntimeProjection], identity: &Shared<DeclarationId>, own: &[ProviderEntry],
  module: &ModuleId, written: List<Shared<Type>>, promised: &Shared<Type>, divergent: bool,
  targets: &mut List<MirCallTarget>, results: &mut List<Shared<Type>>, anchor: &Anchor)
-> Option<PreparationFailure> ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let callable = Shared<TypedBody>.with<Option<Shared<Type>>>(body, fn(value: &TypedBody) -> Option<Shared<Type>> {
    return nodeTypeAt(value, argument.index)
  })
  let receiver = match move callable {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => { return Option<PreparationFailure>.some(PreparationFailure.Coverage {code: GapCode.TypedForm}) }
  }
  let origin = Shared<TypedBody>.with<BodyOrigin>(body, fn(value: &TypedBody) -> BodyOrigin { return TypedBody.nodeSlice(value)[argument.index].origin })
  let closed = run RuntimeType.applyBindings(&receiver, callerBindings, projections)
  let none = List<Constraint>.make()
  let contract = match move run valueCallableContract(&closed, List<Constraint>.asSlice(&none)) {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => { return Option<PreparationFailure>.some(PreparationFailure.Coverage {code: GapCode.TypedForm}) }
  }
  let result = match move run storageInvocationResult(&mut resolver.*, &mut owner.*, &mut dependencies.*, caller,
    callerBindings, projections, &closed, &contract, List<Shared<Type>>.asSlice(&written), BodyOrigin.span(origin, anchor)) {
    Result<Shared<Type>, PreparationFailure>.Success {value} => move value
    Result<Shared<Type>, PreparationFailure>.Failure {error} => { return Option<PreparationFailure>.some(move error) }
  }
  let exact = run Type.runtimeEqualsShared(&result, promised)
  let diverges = divergent && Shared<Type>.with<bool>(&result, neverType)
  if !exact && !diverges { return Option<PreparationFailure>.some(PreparationFailure.Coverage {code: GapCode.WitnessOperand}) }
  let inputs = CallableCallInputs {receiver: move receiver, inference: Shared<DeclarationId>.clone(identity),
    bindings: run Shared<List<Binding>>.make(List<Binding>.make()), mode: Shared<Type>.with<CallableMode>(&contract, callableInvocationMode),
    callee: argument, result: Shared<Type>.clone(&result), count: List<Shared<Type>>.length(&written), origin: origin}
  let constructed = match move run concreteCallableCall(&mut resolver.*, &mut owner.*, &mut dependencies.*, body, node, caller,
    callerBindings, projections, move inputs, List<Shared<Type>>.asSlice(&written), anchor) {
    Result<MirCallTarget, PreparationFailure>.Success {value} => move value
    Result<MirCallTarget, PreparationFailure>.Failure {error} => { return Option<PreparationFailure>.some(move error) }
  }
  let unbound = List<BoundProvider>.make()
  let target = match move run provideCall(&mut resolver.*, &mut owner.*, &mut dependencies.*, move constructed, own,
    List<BoundProvider>.asSlice(&unbound), projections, module, BodyOrigin.span(origin, anchor)) {
    Result<MirCallTarget, PreparationFailure>.Success {value} => move value
    Result<MirCallTarget, PreparationFailure>.Failure {error} => { return Option<PreparationFailure>.some(move error) }
  }
  run List<MirCallTarget>.append(&mut targets.*, move target)
  run List<Shared<Type>>.append(&mut results.*, move result)
  return Option<PreparationFailure>.none()
}

// What one storage primitive's expansion needs from this instance: the measured layout of its
// element or control block, the sealed C allocator declarations, the element's cleanup verdict
// and `sharedWithMut`'s prepared invocations.
effect fn storagePlan(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, body: &Shared<TypedBody>, node: BodyNodeId, operation: StorageOperation,
  caller: &Application, callerBindings: &[Binding], projections: &[RuntimeProjection], identity: &Shared<DeclarationId>,
  own: &[ProviderEntry], module: &ModuleId, span: Span, anchor: &Anchor) -> Result<MirStoragePlan, PreparationFailure>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let allocation = run SealedCore.identity(SealedKind.Allocation)
  let mut externs = List<Shared<DeclarationId>>.make()
  run List<Shared<DeclarationId>>.append(&mut externs, run SealedCore.cFunction(&allocation, SealedFunction.Malloc))
  run List<Shared<DeclarationId>>.append(&mut externs, run SealedCore.cFunction(&allocation, SealedFunction.Free))
  run List<Shared<DeclarationId>>.append(&mut externs, run SealedCore.cFunction(&allocation, SealedFunction.Memmove))
  run List<Shared<DeclarationId>>.append(&mut externs, run SealedCore.cFunction(&allocation, SealedFunction.Memset))
  let mut element = run Types.intern(Type.Unit)
  if StorageOperation.typeArity(operation) > usize.ZERO || operation == StorageOperation.Replace {
    element = run storageInstanceType(body, node, usize.ZERO, callerBindings, projections)
  }
  let mut size = usize.ZERO
  let mut alignment = usize.ONE
  if StorageOperation.measures(operation) {
    let mut measured = Shared<Type>.clone(&element)
    if operation == StorageOperation.SharedLayout || operation == StorageOperation.SharedFromAllocation {
      measured = run SealedCore.applied(SealedKind.SharedBlock, &element)
    }
    // An execution package is measured whole: its header, body, readiness endpoint and allocation.
    if operation == StorageOperation.ExecutionLayout || operation == StorageOperation.ExecutionFromAllocation {
      let mut packaged = List<Shared<Type>>.make()
      let mut argument = usize.ZERO
      while argument < StorageOperation.typeArity(operation) {
        run List<Shared<Type>>.append(&mut packaged, run storageInstanceType(body, node, argument, callerBindings, projections))
        argument = argument + usize.ONE
      }
      measured = run SealedCore.packageBeside(&allocation, List<Shared<Type>>.asSlice(&packaged))
    }
    let facts = match move run measuredLayout(&mut resolver.*, &mut owner.*, &mut dependencies.*, &measured, span) {
      Option<LayoutMetrics>.Some {value} => value
      Option<LayoutMetrics>.None => { return Result<MirStoragePlan, PreparationFailure>.failResult(PreparationFailure.Coverage {code: GapCode.ScalarLayout}) }
    }
    size = facts.size
    alignment = facts.alignment
    // Raw-buffer storage holds consecutive elements one stride apart.
    if operation == StorageOperation.RawBufferFrom || operation == StorageOperation.RawBufferCopy {
      size = match move LayoutMetrics.stride(&facts) {
        Option<usize>.Some {value} => value
        Option<usize>.None => { return Result<MirStoragePlan, PreparationFailure>.failResult(PreparationFailure.Coverage {code: GapCode.ScalarLayout}) }
      }
    }
  }
  let mut cleanup = false
  if operation == StorageOperation.SlotDrop {
    cleanup = match move run glueNeeds(&mut resolver.*, &mut owner.*, &mut dependencies.*, &element) {
      Result<bool, PreparationFailure>.Success {value} => value
      Result<bool, PreparationFailure>.Failure {error} => { return Result<MirStoragePlan, PreparationFailure>.failResult(move error) }
    }
  }
  let mut targets = List<MirCallTarget>.make()
  let mut results = List<Shared<Type>>.make()
  if operation == StorageOperation.SharedWithMut {
    let promised = run storageInstanceType(body, node, usize.ONE, callerBindings, projections)
    let useArgument = match move TypedBody.storageArgument(body, node, usize.ONE) {
      Option<BodyNodeId>.Some {value} => value
      Option<BodyNodeId>.None => { fail RevisionMismatch {} }
    }
    let conflictArgument = match move TypedBody.storageArgument(body, node, 2) {
      Option<BodyNodeId>.Some {value} => value
      Option<BodyNodeId>.None => { fail RevisionMismatch {} }
    }
    // The value is lent exclusively for the invocation alone.
    let site = Shared<TypedBody>.with<BodyOrigin>(body, fn(value: &TypedBody) -> BodyOrigin { return TypedBody.nodeSlice(value)[node.index].origin })
    let mut lent = List<Shared<Type>>.make()
    run List<Shared<Type>>.append(&mut lent, run Types.intern(Type.Reference {referent: Shared<Type>.clone(&element),
      access: Access.Mutable, lifetime: run Shared<Lifetime>.make(Lifetime.Local {
        declaration: DeclarationId.copy(Application.bodyDeclaration(caller)), ordinal: site.node, binder: usize.MAX})}))
    let selected = run storageCallableTarget(&mut resolver.*, &mut owner.*, &mut dependencies.*, body, node, useArgument, caller,
      callerBindings, projections, identity, own, module, move lent, &promised, false, &mut targets, &mut results, anchor)
    if let Option<PreparationFailure>.Some {value} = move selected { return Result<MirStoragePlan, PreparationFailure>.failResult(move value) }
    let policy = run storageCallableTarget(&mut resolver.*, &mut owner.*, &mut dependencies.*, body, node, conflictArgument, caller,
      callerBindings, projections, identity, own, module, List<Shared<Type>>.make(), &promised, true, &mut targets, &mut results, anchor)
    if let Option<PreparationFailure>.Some {value} = move policy { return Result<MirStoragePlan, PreparationFailure>.failResult(move value) }
  }
  // A completed activation passes the branch state and the result to its completion callback.
  if operation == StorageOperation.ExecutionDrive {
    let completion = match move TypedBody.storageArgument(body, node, 2) {
      Option<BodyNodeId>.Some {value} => value
      Option<BodyNodeId>.None => { fail RevisionMismatch {} }
    }
    let mut passed = List<Shared<Type>>.make()
    run List<Shared<Type>>.append(&mut passed, run storageInstanceType(body, node, usize.ONE, callerBindings, projections))
    run List<Shared<Type>>.append(&mut passed, Shared<Type>.clone(&element))
    let unit = run Types.intern(Type.Unit)
    let completed = run storageCallableTarget(&mut resolver.*, &mut owner.*, &mut dependencies.*, body, node, completion, caller,
      callerBindings, projections, identity, own, module, move passed, &unit, false, &mut targets, &mut results, anchor)
    if let Option<PreparationFailure>.Some {value} = move completed { return Result<MirStoragePlan, PreparationFailure>.failResult(move value) }    // A relinquished activation hands the branch state and the Execution back to `onSuspend`.
    let suspension = match move TypedBody.storageArgument(body, node, 3) {
      Option<BodyNodeId>.Some {value} => value
      Option<BodyNodeId>.None => { fail RevisionMismatch {} }
    }
    let mut returned = List<Shared<Type>>.make()
    run List<Shared<Type>>.append(&mut returned, run storageInstanceType(body, node, usize.ONE, callerBindings, projections))
    run List<Shared<Type>>.append(&mut returned, run SealedCore.applied(SealedKind.Execution, &element))
    let suspended = run storageCallableTarget(&mut resolver.*, &mut owner.*, &mut dependencies.*, body, node, suspension, caller,
      callerBindings, projections, identity, own, module, move returned, &unit, false, &mut targets, &mut results, anchor)
    if let Option<PreparationFailure>.Some {value} = move suspended { return Result<MirStoragePlan, PreparationFailure>.failResult(move value) }
  }
  let mut steps = List<MirRunPlan>.make()
  if operation == StorageOperation.ExecutionFromAllocation {
    let prepared = run executionHelperPlans(&mut resolver.*, &mut owner.*, &mut dependencies.*, body, node, caller, callerBindings,
      projections, identity, own, module, &mut targets, &mut results, &mut steps, anchor)
    if let Option<PreparationFailure>.Some {value} = move prepared { return Result<MirStoragePlan, PreparationFailure>.failResult(move value) }
  }
  return Result<MirStoragePlan, PreparationFailure>.succeed(MirStoragePlan {node: node, size: size, alignment: alignment, externs: move externs,
    cleanup: cleanup, targets: move targets, results: move results, steps: move steps})
}

// What a package's erased helpers run, prepared at the site that adopts it: the body as one run
// into its result, and the readiness endpoint invoked with a shared loan of its readiness state.
effect fn executionHelperPlans(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, body: &Shared<TypedBody>, node: BodyNodeId, caller: &Application,
  callerBindings: &[Binding], projections: &[RuntimeProjection], identity: &Shared<DeclarationId>, own: &[ProviderEntry],
  module: &ModuleId, targets: &mut List<MirCallTarget>, results: &mut List<Shared<Type>>, steps: &mut List<MirRunPlan>, anchor: &Anchor)
  -> Option<PreparationFailure> ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let bodyArgument = match move TypedBody.storageArgument(body, node, usize.ONE) {
    Option<BodyNodeId>.Some {value} => value
    Option<BodyNodeId>.None => { fail RevisionMismatch {} }
  }
  let endpointArgument = match move TypedBody.storageArgument(body, node, 3) {
    Option<BodyNodeId>.Some {value} => value
    Option<BodyNodeId>.None => { fail RevisionMismatch {} }
  }
  let origin = Shared<TypedBody>.with<BodyOrigin>(body, fn(value: &TypedBody) -> BodyOrigin { return TypedBody.nodeSlice(value)[bodyArgument.index].origin })
  let written = match move Shared<TypedBody>.with<Option<Shared<Type>>>(body, fn(value: &TypedBody) -> Option<Shared<Type>> {
    return nodeTypeAt(value, bodyArgument.index)
  }) {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => { return Option<PreparationFailure>.some(PreparationFailure.Coverage {code: GapCode.TypedForm}) }
  }
  let closed = run Type.applyBindings(&written, callerBindings, true)
  if Shared<Type>.with<bool>(&closed, compositeType) {
    let mut bound = List<BoundProvider>.make()
    let prepared = run compositePlan(&mut resolver.*, &mut owner.*, &mut dependencies.*, body, bodyArgument, caller, callerBindings,
      projections, identity, &closed, origin, own, &mut bound, module, &mut steps.*, anchor)
    if let Result<usize, PreparationFailure>.Failure {error} = move prepared { return Option<PreparationFailure>.some(move error) }
  } else {
    let channels = match move Shared<Type>.with<Option<EffectChannels>>(&closed, effectChannels) {
      Option<EffectChannels>.Some {value} => move value
      Option<EffectChannels>.None => { return Option<PreparationFailure>.some(PreparationFailure.Coverage {code: GapCode.EffectForm}) }
    }
    let inputs = CallableCallInputs {receiver: move written, inference: Shared<DeclarationId>.clone(identity),
      bindings: run Shared<List<Binding>>.make(List<Binding>.make()), mode: Shared<Type>.with<CallableMode>(&closed, callableInvocationMode),
      callee: bodyArgument, result: Shared<Type>.clone(&channels.success), count: usize.ZERO, origin: origin}
    let none = List<Shared<Type>>.make()
    let constructed = match move run concreteCallableCall(&mut resolver.*, &mut owner.*, &mut dependencies.*, body, bodyArgument, caller,
      callerBindings, projections, move inputs, List<Shared<Type>>.asSlice(&none), anchor) {
      Result<MirCallTarget, PreparationFailure>.Success {value} => move value
      Result<MirCallTarget, PreparationFailure>.Failure {error} => { return Option<PreparationFailure>.some(move error) }
    }
    let unbound = List<BoundProvider>.make()
    let target = match move run provideCall(&mut resolver.*, &mut owner.*, &mut dependencies.*, move constructed, own,
      List<BoundProvider>.asSlice(&unbound), projections, module, BodyOrigin.span(origin, anchor)) {
      Result<MirCallTarget, PreparationFailure>.Success {value} => move value
      Result<MirCallTarget, PreparationFailure>.Failure {error} => { return Option<PreparationFailure>.some(move error) }
    }
    run List<MirRunPlan>.append(&mut steps.*, MirRunPlan.Runner {target: move target, success: move channels.success,
      failure: move channels.failure})
  }
  let state = run storageInstanceType(body, node, 2, callerBindings, projections)
  let mut lent = List<Shared<Type>>.make()
  run List<Shared<Type>>.append(&mut lent, run Types.intern(Type.Reference {referent: move state, access: Access.Shared,
    lifetime: run Shared<Lifetime>.make(Lifetime.Static)}))
  let unit = run Types.intern(Type.Unit)
  return run storageCallableTarget(&mut resolver.*, &mut owner.*, &mut dependencies.*, body, node, endpointArgument, caller,
    callerBindings, projections, identity, own, module, move lent, &unit, false, &mut targets.*, &mut results.*, anchor)
}

// A stored callable invoked with one argument, and the channels of the Effect its invocation runs.
struct InvokedTarget {
  target: MirCallTarget,
  channels: EffectChannels,
  mode: CallableMode,
}

// The observer callback's call `callback(&mut state, event, first, second, identity, origin) ->
// usize` (failure observer note N1). The observation's adapter invokes it repeatedly through a
// shared loan of the stored callable, so a callable that consumes or exclusively lends its
// environment, or that needs providers, is not supported.
effect fn observerTarget(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, body: &Shared<TypedBody>, node: BodyNodeId, caller: &Application,
  callerBindings: &[Binding], projections: &[RuntimeProjection], identity: &Shared<DeclarationId>, callable: &Shared<Type>,
  state: &Shared<Type>, origin: BodyOrigin, anchor: &Anchor) -> Result<MirCallTarget, PreparationFailure>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let none = List<Constraint>.make()
  let contract = match move run valueCallableContract(callable, List<Constraint>.asSlice(&none)) {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => { return Result<MirCallTarget, PreparationFailure>.failResult(PreparationFailure.Coverage {code: GapCode.ObserverCallback}) }
  }
  let word = run Types.intern(Type.Primitive {name: run Bytes.copy(b"usize")})
  let text = run Types.intern(Type.String {lifetime: run Shared<Lifetime>.make(Lifetime.Static)})
  let mut written = List<Shared<Type>>.make()
  run List<Shared<Type>>.append(&mut written, run Types.intern(Type.Reference {referent: Shared<Type>.clone(state),
    access: Access.Mutable, lifetime: run Shared<Lifetime>.make(Lifetime.Static)}))
  run List<Shared<Type>>.append(&mut written, run Types.intern(Type.Primitive {name: run Bytes.copy(b"u8")}))
  run List<Shared<Type>>.append(&mut written, Shared<Type>.clone(&word))
  run List<Shared<Type>>.append(&mut written, Shared<Type>.clone(&word))
  run List<Shared<Type>>.append(&mut written, Shared<Type>.clone(&text))
  run List<Shared<Type>>.append(&mut written, move text)
  let inputs = CallableCallInputs {receiver: Shared<Type>.clone(callable), inference: Shared<DeclarationId>.clone(identity),
    bindings: run Shared<List<Binding>>.make(List<Binding>.make()), mode: Shared<Type>.with<CallableMode>(&contract, callableInvocationMode),
    callee: node, result: move word, count: 6, origin: origin}
  let target = match move run concreteCallableCall(&mut resolver.*, &mut owner.*, &mut dependencies.*, body, node, caller,
    callerBindings, projections, move inputs, List<Shared<Type>>.asSlice(&written), anchor) {
    Result<MirCallTarget, PreparationFailure>.Success {value} => move value
    Result<MirCallTarget, PreparationFailure>.Failure {error} => { return Result<MirCallTarget, PreparationFailure>.failResult(move error) }
  }
  let shared = sharedEnvironment(&target)
  let served = List<MirProviderSource>.length(&target.providers) == usize.ZERO && match &target.dispatch {
    Option<MirProviderSource>.None => true
    _ => false
  }
  if !shared || !served || target.receiverDereferences != usize.ZERO {
    return Result<MirCallTarget, PreparationFailure>.failResult(PreparationFailure.Coverage {code: GapCode.ObserverCallback})
  }
  return Result<MirCallTarget, PreparationFailure>.succeed(move target)
}

effect fn invokedTarget(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, body: &Shared<TypedBody>, node: BodyNodeId, caller: &Application,
  callerBindings: &[Binding], projections: &[RuntimeProjection], identity: &Shared<DeclarationId>, callable: &Shared<Type>,
  argument: &Shared<Type>, origin: BodyOrigin, anchor: &Anchor) -> Result<InvokedTarget, PreparationFailure>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let none = List<Constraint>.make()
  let contract = match move run valueCallableContract(callable, List<Constraint>.asSlice(&none)) {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => { return Result<InvokedTarget, PreparationFailure>.failResult(PreparationFailure.Coverage {code: GapCode.EffectForm}) }
  }
  let chosen = run invokedSchemaContract(callable, &contract, argument)
  let invoked = match move Shared<Type>.with<Option<Shared<Type>>>(&chosen, callableResult) {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => { return Result<InvokedTarget, PreparationFailure>.failResult(PreparationFailure.Coverage {code: GapCode.EffectForm}) }
  }
  let channels = match move Shared<Type>.with<Option<EffectChannels>>(&invoked, effectChannels) {
    Option<EffectChannels>.Some {value} => move value
    Option<EffectChannels>.None => { return Result<InvokedTarget, PreparationFailure>.failResult(PreparationFailure.Coverage {code: GapCode.EffectForm}) }
  }
  let mode = Shared<Type>.with<CallableMode>(&contract, callableInvocationMode)
  let mut written = List<Shared<Type>>.make()
  run List<Shared<Type>>.append(&mut written, Shared<Type>.clone(argument))
  let inputs = CallableCallInputs {receiver: Shared<Type>.clone(callable), inference: Shared<DeclarationId>.clone(identity),
    bindings: run Shared<List<Binding>>.make(List<Binding>.make()), mode: mode, callee: node,
    result: Shared<Type>.clone(&channels.success), count: usize.ONE, origin: origin}
  return match move run concreteCallableCall(&mut resolver.*, &mut owner.*, &mut dependencies.*, body, node, caller,
    callerBindings, projections, move inputs, List<Shared<Type>>.asSlice(&written), anchor) {
    Result<MirCallTarget, PreparationFailure>.Success {value} => Result<InvokedTarget, PreparationFailure>.succeed(InvokedTarget {target: move value,
      channels: move channels, mode: mode})
    Result<MirCallTarget, PreparationFailure>.Failure {error} => Result<InvokedTarget, PreparationFailure>.failResult(move error)
  }
}

// A generic function value invoked with one argument, such as the handler `caught` for
// `effect fn caught<E>(error: E)`, is selected by that argument: its one parameter binds the
// target's variables, and the bound contract gives the invocation's result.
effect fn invokedSchemaContract(callable: &Shared<Type>, contract: &Shared<Type>, argument: &Shared<Type>) -> Shared<Type>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let schema = match move Shared<Type>.with<Option<Shared<SectionSchema>>>(callable, sectionSchemaOf) {
    Option<Shared<SectionSchema>>.Some {value} => move value
    _ => { return Shared<Type>.clone(contract) }
  }
  let target = Shared<SectionSchema>.with<Shared<DeclarationId>>(&schema, fn(value: &SectionSchema) -> Shared<DeclarationId> {
    return Shared<DeclarationId>.clone(&value.target)
  })
  let parts = run Type.copy(contract)
  if let Type.Callable {parameters, ..} = move parts {
    let accepted = List<Shared<Type>>.asSlice(&parameters)
    if accepted.length != usize.ONE { return Shared<Type>.clone(contract) }
    let mut variables = List<Shared<DeclarationId>>.make()
    run List<Shared<DeclarationId>>.append(&mut variables, move target)
    let mut bindings = List<Binding>.make()
    drop run Type.unify(&accepted[usize.ZERO], argument, List<Shared<DeclarationId>>.asSlice(&variables), Comparison.Exact,
      &mut bindings)
    return run Type.applyBindings(contract, List<Binding>.asSlice(&bindings), true)
  }
  return Shared<Type>.clone(contract)
}

// The prepared invocations of a checked scalar operation's carriers: `present` with the produced
// scalar and `absent` with nothing, both producing the call's result. A carrier that owns cleanup
// records its type so the path that does not invoke it drops it.
effect fn carrierPlan(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, body: &Shared<TypedBody>, node: BodyNodeId, caller: &Application,
  callerBindings: &[Binding], projections: &[RuntimeProjection], identity: &Shared<DeclarationId>,
  operation: ScalarOperation, result: &Shared<Type>, own: &[ProviderEntry], module: &ModuleId, anchor: &Anchor) -> Result<MirCarrierPlan, PreparationFailure>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let start = ScalarOperation.arity(operation)
  let produced = run primitiveType(ScalarOperation.scalarSpelling(ScalarOperation.result(operation)))
  let mut targets = List<MirCallTarget>.make()
  let mut drops = List<Option<Shared<Type>>>.make()
  let mut at = usize.ZERO
  while at < 2 {
    let argument = match move TypedBody.callArgument(body, node, start + at) {
      Option<CallArgument>.Some {value} => move value
      Option<CallArgument>.None => { fail RevisionMismatch {} }
    }
    // Cleanup acts on the carrier's realized storage, including an opaque returned callable.
    let closed = run RuntimeType.applyBindings(&argument.ty, callerBindings, projections)
    let cleanup = match move run ownedCleanup(&mut resolver.*, &mut owner.*, &mut dependencies.*, &closed, argument.origin, anchor) {
      Result<Option<Shared<Type>>, PreparationFailure>.Success {value} => move value
      Result<Option<Shared<Type>>, PreparationFailure>.Failure {error} => { return Result<MirCarrierPlan, PreparationFailure>.failResult(move error) }
    }
    run List<Option<Shared<Type>>>.append(&mut drops, move cleanup)
    let none = List<Constraint>.make()
    let contract = match move run valueCallableContract(&argument.ty, List<Constraint>.asSlice(&none)) {
      Option<Shared<Type>>.Some {value} => move value
      Option<Shared<Type>>.None => { return Result<MirCarrierPlan, PreparationFailure>.failResult(PreparationFailure.Coverage {code: GapCode.TypedForm}) }
    }
    let mut written = List<Shared<Type>>.make()
    if at == usize.ZERO { run List<Shared<Type>>.append(&mut written, Shared<Type>.clone(&produced)) }
    let inputs = CallableCallInputs {receiver: Shared<Type>.clone(&argument.ty), inference: Shared<DeclarationId>.clone(identity),
      bindings: run Shared<List<Binding>>.make(List<Binding>.make()), mode: Shared<Type>.with<CallableMode>(&contract, callableInvocationMode),
      callee: node, result: Shared<Type>.clone(result), count: List<Shared<Type>>.length(&written), origin: argument.origin}
    let target = match move run concreteCallableCall(&mut resolver.*, &mut owner.*, &mut dependencies.*, body, node, caller,
      callerBindings, projections, move inputs, List<Shared<Type>>.asSlice(&written), anchor) {
      Result<MirCallTarget, PreparationFailure>.Success {value} => move value
      Result<MirCallTarget, PreparationFailure>.Failure {error} => { return Result<MirCarrierPlan, PreparationFailure>.failResult(move error) }
    }
    let unbound = List<BoundProvider>.make()
    let served = match move run provideCall(&mut resolver.*, &mut owner.*, &mut dependencies.*, move target, own,
      List<BoundProvider>.asSlice(&unbound), projections, module, BodyOrigin.span(argument.origin, anchor)) {
      Result<MirCallTarget, PreparationFailure>.Success {value} => move value
      Result<MirCallTarget, PreparationFailure>.Failure {error} => { return Result<MirCarrierPlan, PreparationFailure>.failResult(move error) }
    }
    run List<MirCallTarget>.append(&mut targets, move served)
    at = at + usize.ONE
  }
  let present = List<MirCallTarget>.remove(&mut targets, usize.ZERO)
  let absent = List<MirCallTarget>.remove(&mut targets, usize.ZERO)
  let presentDrop = List<Option<Shared<Type>>>.remove(&mut drops, usize.ZERO)
  let absentDrop = List<Option<Shared<Type>>>.remove(&mut drops, usize.ZERO)
  return Result<MirCarrierPlan, PreparationFailure>.succeed(MirCarrierPlan {node: node, present: move present, absent: move absent,
    presentDrop: move presentDrop, absentDrop: move absentDrop})
}

// Whether a stored part owns cleanup; an unanswerable verdict is treated as owning.
effect fn ownsCleanup(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, part: &Shared<Type>, origin: BodyOrigin, anchor: &Anchor) -> bool
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  return match move run ownedCleanup(&mut resolver.*, &mut owner.*, &mut dependencies.*, part, origin, anchor) {
    Result<Option<Shared<Type>>, PreparationFailure>.Success {value: Option<Shared<Type>>.None} => false
    _ => true
  }
}

// A stored part's type when an exit that does not consume it must drop it.
effect fn ownedCleanup(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, part: &Shared<Type>, origin: BodyOrigin, anchor: &Anchor) -> Result<Option<Shared<Type>>, PreparationFailure>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut visiting = List<Shared<Type>>.make()
  let premises = List<Constraint>.make()
  let free = match move run cleanupFree(&mut resolver.*, &mut owner.*, &mut dependencies.*, part, List<Constraint>.asSlice(&premises),
    &mut visiting, BodyOrigin.span(origin, anchor)) {
    Result<bool, Shared<Rejection>>.Success {value} => value
    Result<bool, Shared<Rejection>>.Failure {..} => { return Result<Option<Shared<Type>>, PreparationFailure>.failResult(PreparationFailure.Coverage {code: GapCode.Cleanup}) }
  }
  if free { return Result<Option<Shared<Type>>, PreparationFailure>.succeed(Option<Shared<Type>>.none()) }
  return Result<Option<Shared<Type>>, PreparationFailure>.succeed(Option<Shared<Type>>.some(Shared<Type>.clone(part)))
}

fn constructedEffect(value: &Type) -> bool {
  return match &value.* {
    Type.CallableValue {contract, ..} => Shared<Type>.with<bool>(&contract, fn(selected: &Type) -> bool {
      return match &selected.* { Type.Effect {..} => true _ => false }
    })
    _ => false
  }
}

// An effect fn call or `effect fn` value invocation that is not itself run only constructs its
// Effect (D1); its row is served where that value runs, so the call's target is never called here.
// Whether `node` is an `effect fn` interface call whose Effect is stored rather than run in place.
fn storedInterfaceEffect(body: &TypedBody, node: BodyNodeId) -> bool {
  let nodes = TypedBody.nodeSlice(body)
  if let BodyNodeKind.Expression {form: BodyExpression.InterfaceCall {isEffect, ..}, ..} = &nodes[node.index].kind {
    return isEffect && !ranInPlace(nodes, node.index)
  }
  return false
}

fn constructedOnly(body: &TypedBody, node: BodyNodeId) -> bool {
  let nodes = TypedBody.nodeSlice(body)
  let constructs = match &nodes[node.index].kind {
    BodyNodeKind.Expression {ty, form: BodyExpression.DirectCall {..}} => Shared<Type>.with<bool>(&ty, constructedEffect)
    BodyNodeKind.Expression {form: BodyExpression.CallableCall {constructs: invoked, ..}, ..} => invoked
    _ => false
  }
  if !constructs { return false }
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {form: BodyExpression.Run {value, ..}, ..} = &nodes[at].kind {
      if value.index == node.index { return false }
    }
    at = at + usize.ONE
  }
  return true
}

// One provider stored by a binding that encloses a composed run, outermost first (D2 rule 2).
struct BoundProvider {
  key: Requirement,
  owned: bool,
  access: Access,
  provider: Shared<Type>,
  address: Shared<Type>,
}

// The providers serving one callee row, in its canonical key order, and where each comes from.
struct RowProviders {
  sources: List<MirProviderSource>,
  entries: List<ProviderEntry>,
}

// Whether a declaration is an operation of a service rather than a function with a body.
fn serviceOperation(id: &DeclarationId) -> bool {
  let count = DeclarationId.ownerCount(id)
  return count > usize.ONE && DeclarationId.ownerKind(id, count - 2) == OwnerKind.Service
}

// The canonical service-role key order (G3): runtime encodings of capability, then role.
effect fn keyEncoding(entry: &Requirement, owner: &DeclarationId) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut encoded = run Type.runtimeEncoding(&entry.capability, owner)
  if let Option<Shared<Type>>.Some {value: roleValue} = &entry.roleType {
    let roleBytes = run Type.runtimeEncoding(&roleValue, owner)
    run Bytes.append(&mut encoded, Bytes.asSlice(&roleBytes))
  }
  return move encoded
}

fn bytesBefore(left: &[u8], right: &[u8]) -> bool {
  let mut at = usize.ZERO
  while at < left.length && at < right.length {
    if left[at] != right[at] { return left[at] < right[at] }
    at = at + usize.ONE
  }
  return left.length < right.length
}

fn encodedBefore(encodings: &List<Bytes>, slot: usize) -> bool {
  let listed = List<Bytes>.asSlice(encodings)
  return bytesBefore(Bytes.asSlice(&listed[slot]), Bytes.asSlice(&listed[slot - usize.ONE]))
}

// The entries of a closed row in canonical key order, never source order.
effect fn canonicalEntries(row: &Shared<Row>, owner: &DeclarationId) -> List<Requirement> ! OutOfMemoryError ? &mut Allocator {
  let mut entries = run Row.entryList(row)
  let mut encodings = List<Bytes>.make()
  let listed = List<Requirement>.asSlice(&entries)
  let mut at = usize.ZERO
  while at < listed.length {
    run List<Bytes>.append(&mut encodings, run keyEncoding(&listed[at], owner))
    at = at + usize.ONE
  }
  // ponytail: insertion sort; rows hold a handful of keys.
  let mut sorted = usize.ONE
  while sorted < List<Requirement>.length(&entries) {
    let mut slot = sorted
    while slot > usize.ZERO && encodedBefore(&encodings, slot) {
      let key = List<Requirement>.remove(&mut entries, slot)
      run List<Requirement>.insert(&mut entries, slot - usize.ONE, move key)
      let bytes = List<Bytes>.remove(&mut encodings, slot)
      run List<Bytes>.insert(&mut encodings, slot - usize.ONE, move bytes)
      slot = slot - usize.ONE
    }
    sorted = sorted + usize.ONE
  }
  return move entries
}

// The callee's substituted requirement row in canonical key order, each entry served by the
// innermost enclosing binding of its key, else by this instance's own provider (D2).
effect fn rowProviders(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, application: &Application, own: &[ProviderEntry], bound: &[BoundProvider],
  span: Span) -> Result<RowProviders, PreparationFailure>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let signatureOwner = run Shared<DeclarationId>.make(DeclarationId.copy(Application.bodyDeclaration(application)))
  let location = match move run locationOfIdentity(&mut resolver.*, &signatureOwner) {
    Option<InstanceLocation>.Some {value} => value
    _ => { fail InvalidModulePath {} }
  }
  let declarationAccess179Request = Key {
    family: Family.Signature, module: location.module, name: usize.ZERO,
    declaration: location.declaration, member: usize.ZERO, external: false,
  }
  let declarationAccess179 = run internDeclaration(&mut resolver.*, declarationAccess179Request)
  let signature = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, declarationAccess179, span)
  let declared = run signatureRequirements(&signature)
  let bindings = run Application.bindings(application)
  let row = run Row.applyBindings(&declared, List<Binding>.asSlice(&bindings), true)
  if Row.hasOpenRuntimeParameters(&row) { return Result<RowProviders, PreparationFailure>.failResult(PreparationFailure.Coverage {code: GapCode.EffectForm}) }
  let ordered = run canonicalEntries(&row, Application.bodyDeclaration(application))
  let listed = List<Requirement>.asSlice(&ordered)
  let mut sources = List<MirProviderSource>.make()
  let mut entries = List<ProviderEntry>.make()
  let mut at = usize.ZERO
  while at < listed.length {
    let mut found = false
    let mut depth = bound.length
    while !found && depth > usize.ZERO {
      depth = depth - usize.ONE
      if run Requirement.keyEquals(&bound[depth].key, &listed[at]) {
        run List<MirProviderSource>.append(&mut sources, MirProviderSource.Bound {depth: depth, owned: bound[depth].owned,
          access: bound[depth].access, address: Shared<Type>.clone(&bound[depth].address)})
        run List<ProviderEntry>.append(&mut entries, ProviderEntry {key: Requirement.copy(&listed[at]),
          provider: Shared<Type>.clone(&bound[depth].provider)})
        found = true
      }
    }
    let mut ownAt = usize.ZERO
    while !found && ownAt < own.length {
      if run Requirement.keyEquals(&own[ownAt].key, &listed[at]) {
        run List<MirProviderSource>.append(&mut sources, MirProviderSource.Own {index: ownAt})
        run List<ProviderEntry>.append(&mut entries, ProviderEntry {key: Requirement.copy(&listed[at]),
          provider: Shared<Type>.clone(&own[ownAt].provider)})
        found = true
      }
      ownAt = ownAt + usize.ONE
    }
    // Requirement coverage was proven by the checker (SEM0071); an unserved entry is a gap.
    if !found { return Result<RowProviders, PreparationFailure>.failResult(PreparationFailure.Coverage {code: GapCode.EffectForm}) }
    at = at + usize.ONE
  }
  return Result<RowProviders, PreparationFailure>.succeed(RowProviders {sources: move sources, entries: move entries})
}

// The one row entry naming the service that owns `operation`, by position; absent when the row
// names that service under no role or several (witness checking refuses the latter).
fn dispatchedEntry(entries: &[ProviderEntry], operation: &DeclarationId) -> usize {
  let mut found = usize.MAX
  let mut at = usize.ZERO
  while at < entries.length {
    let owns = Shared<Type>.with<bool>(&entries[at].key.capability, fn(value: &Type) -> bool {
      return match &value.* { Type.Nominal {declaration, ..} => DeclarationId.isPrefixOf(&declaration, operation) _ => false }
    })
    if owns {
      if found != usize.MAX { return usize.MAX }
      found = at
    }
    at = at + usize.ONE
  }
  return found
}

// Completes a call target with its callee's providers (D2). A service operation dispatches to the
// witness of its service for the serving provider's type; that witness's own row is served from
// the same environment, and its own declared failure types the call's failure edge (D3).
effect fn provideCall(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, target: MirCallTarget, own: &[ProviderEntry], bound: &[BoundProvider],
  projections: &[RuntimeProjection], module: &ModuleId, span: Span) -> Result<MirCallTarget, PreparationFailure>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut call = move target
  // Providers are matched in the call edge's actual regions; the rebuilt key numbers them.
  let application = run Application.copy(&call.application)
  let operation = DeclarationId.copy(Application.bodyDeclaration(&application))
  let served = match move run rowProviders(&mut resolver.*, &mut owner.*, &mut dependencies.*, &application, own, bound, span) {
    Result<RowProviders, PreparationFailure>.Success {value} => move value
    Result<RowProviders, PreparationFailure>.Failure {error} => { return Result<MirCallTarget, PreparationFailure>.failResult(move error) }
  }
  if !serviceOperation(&operation) {
    if List<ProviderEntry>.length(&served.entries) != usize.ZERO {
      call.key = match move run InstanceKey.withProviders(move application, move served.entries) {
    Result<InstanceKey, CanonicalizationFailure>.Success {value: canonicalKey} => move canonicalKey
    Result<InstanceKey, CanonicalizationFailure>.Failure {error: reason} => {
      return Result<MirCallTarget, PreparationFailure>.failResult(PreparationFailure.Canonicalization {reason: reason})
    }
  }
      call.providers = move served.sources
    }
    return Result<MirCallTarget, PreparationFailure>.succeed(move call)
  }
  // The operation's row names its own service; that entry's provider receives the call.
  let dispatch = dispatchedEntry(List<ProviderEntry>.asSlice(&served.entries), &operation)
  if dispatch == usize.MAX { return Result<MirCallTarget, PreparationFailure>.failResult(PreparationFailure.Coverage {code: GapCode.EffectForm}) }
  let mut request = Request.make()
  let servedEntries = List<ProviderEntry>.asSlice(&served.entries)
  let capability = Shared<Type>.clone(&servedEntries[dispatch].key.capability)
  let provider = Shared<Type>.clone(&servedEntries[dispatch].provider)
  // A `never` provider serves its key vacuously (`Option<never>.none()`): no provider value exists,
  // so the call is never reached and selects no witness.
  if Shared<Type>.with<bool>(&provider, neverType) {
    call.vacuous = true
    return Result<MirCallTarget, PreparationFailure>.succeed(move call)
  }
  let selected = run resolveWitnessApplication(&mut resolver.*, &mut owner.*, &mut request, &mut dependencies.*, true,
    &capability, &provider, &operation, module, span)
  let witness = match move selected {
    Result<ResolvedWitness, Shared<Rejection>>.Success {value} => move value
    Result<ResolvedWitness, Shared<Rejection>>.Failure {..} => { return Result<MirCallTarget, PreparationFailure>.failResult(PreparationFailure.Coverage {code: GapCode.WitnessOperand}) }
  }
  // The witness mapping names the operation's own binders; the call supplies their arguments.
  // Lifetimes lent to the witness are erased at runtime; the caller's loans were already checked.
  let passes = List<OperandPass>.asSlice(&witness.operands)
  let mut lent = run Application.bindings(&application)
  let mut at = usize.ZERO
  while at < passes.length {
    if let OperandPass.Borrow {lifetimeOrdinal, ..} = &passes[at] {
      run List<Binding>.append(&mut lent, Binding {
        declaration: run Shared<DeclarationId>.make(DeclarationId.copy(Application.bodyDeclaration(&witness.application))),
        ordinal: lifetimeOrdinal, value: Argument.Lifetime {value: run Shared<Lifetime>.make(Lifetime.Static)},
      })
    }
    at = at + usize.ONE
  }
  let mut closed = run Application.applyBindings(&witness.application, List<Binding>.asSlice(&lent))
  // EFF-009 bounds the witness's failure by the operation's, so it may be narrower (even `never`).
  let signatureOwner = run Shared<DeclarationId>.make(DeclarationId.copy(Application.bodyDeclaration(&closed)))
  let location = match move run locationOfIdentity(&mut resolver.*, &signatureOwner) {
    Option<InstanceLocation>.Some {value} => value
    Option<InstanceLocation>.None => { fail InvalidModulePath {} }
  }
  let declarationAccess180Request = Key {family: Family.Signature,
    module: location.module, name: usize.ZERO, declaration: location.declaration, member: usize.ZERO, external: false}
  let declarationAccess180 = run internDeclaration(&mut resolver.*, declarationAccess180Request)
  let signature = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, declarationAccess180, span)
  let facts = match move Shared<Result<Answer, NoRejection>>.with<Option<SignatureFacts>>(&signature, signatureFacts) {
    Option<SignatureFacts>.Some {value} => move value
    Option<SignatureFacts>.None => { return Result<MirCallTarget, PreparationFailure>.failResult(PreparationFailure.Coverage {code: GapCode.SignatureForm}) }
  }
  // The operation's static arguments select the witness instance. Conformance matches static
  // parameters in order, so each value moves to the witness's static slot at the same position.
  let suppliedStatics = List<StaticSlot>.asSlice(&application.statics)
  if suppliedStatics.length > usize.ZERO {
    let witnessSlots = run signatureStaticSlots(&signature, facts.staticSlots)
    let slots = List<usize>.asSlice(&witnessSlots)
    if slots.length != suppliedStatics.length {
      return Result<MirCallTarget, PreparationFailure>.failResult(PreparationFailure.Coverage {code: GapCode.WitnessOperand})
    }
    let mut statics = List<StaticSlot>.make()
    let mut staticAt = usize.ZERO
    while staticAt < slots.length {
      run List<StaticSlot>.append(&mut statics, StaticSlot {ordinal: slots[staticAt], value: StaticValue.copy(&suppliedStatics[staticAt].value)})
      staticAt = staticAt + usize.ONE
    }
    closed.statics = move statics
  }
  let witnessBindings = run Application.bindings(&closed)
  let declaredFailure = run RuntimeType.applyBindings(&facts.failure, List<Binding>.asSlice(&witnessBindings), projections)
  let servedSources = List<MirProviderSource>.asSlice(&served.sources)
  let receiver = MirProviderSource.copy(&servedSources[dispatch])
  let witnessRow = match move run rowProviders(&mut resolver.*, &mut owner.*, &mut dependencies.*, &closed, own, bound, span) {
    Result<RowProviders, PreparationFailure>.Success {value} => move value
    Result<RowProviders, PreparationFailure>.Failure {error} => { return Result<MirCallTarget, PreparationFailure>.failResult(move error) }
  }
  call.application = run Application.copy(&closed)
  call.key = match move run InstanceKey.withProviders(move closed, move witnessRow.entries) {
    Result<InstanceKey, CanonicalizationFailure>.Success {value: canonicalKey} => move canonicalKey
    Result<InstanceKey, CanonicalizationFailure>.Failure {error: reason} => {
      return Result<MirCallTarget, PreparationFailure>.failResult(PreparationFailure.Canonicalization {reason: reason})
    }
  }
  call.providers = move witnessRow.sources
  // An operation's own default body takes no receiver; its row reaches the same provider.
  if !DeclarationId.equals(Application.bodyDeclaration(&call.application), &operation) {
    call.dispatch = Option<MirProviderSource>.some(move receiver)
  }
  call.witnessFailure = Option<Shared<Type>>.some(move declaredFailure)
  call.edge = Edge.Witness
  call.nonParking = run operationNonParking(&mut resolver.*, &operation)
  return Result<MirCallTarget, PreparationFailure>.succeed(move call)
}

// Whether a service operation's header declares `with Intrinsic.nonParking()`: each call then owes
// the NonParking proof for the witness its provider selects (SEM0139).
effect fn operationNonParking(resolver: &mut Resolver, operation: &DeclarationId) -> bool
! Cycle | OutOfMemoryError ? &mut Allocator {
  let identity = run Shared<DeclarationId>.make(DeclarationId.copy(operation))
  let location = match move run locationOfIdentity(&mut resolver.*, &identity) {
    Option<InstanceLocation>.Some {value} => value
    Option<InstanceLocation>.None => { return false }
  }
  let module = resolvedModule(&resolver.*, location.module)
  let answer = run observedDeclaration(&mut resolver.*, &module, location.declaration, SourceFacet.Header)
  if let Option<&IndexedSource>.Some {value} = move sourceOf(&resolver.*, &answer, &module) {
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(value))
    if location.declaration >= declarations.length { return false }
    let hir = IndexedSource.authored(value)
    if let Node.OperationHeader {properties, ..} = Module.node(hir, declarations[location.declaration].header) {
      return properties.length == usize.ONE && nonParkingProperties(hir, properties)
    }
  }
  return false
}

fn providerEntryCount(values: &List<ProviderEntry>) -> usize { return List<ProviderEntry>.length(values) }

// This instance's own providers, copied out of its key in canonical key order.
effect fn instanceProviders(instance: &InstanceKey) -> List<ProviderEntry> ! OutOfMemoryError ? &mut Allocator {
  let mut copied = List<ProviderEntry>.make()
  if let Option<Shared<List<ProviderEntry>>>.Some {value: listed} = move InstanceKey.providers(instance) {
    let count = Shared<List<ProviderEntry>>.with<usize>(&listed, providerEntryCount)
    let mut at = usize.ZERO
    while at < count {
      let entry = Shared<List<ProviderEntry>>.with<ProviderEntry>(&listed, fn(values: &List<ProviderEntry>) -> ProviderEntry {
        let entries = List<ProviderEntry>.asSlice(values)
        return ProviderEntry.copy(&entries[at])
      })
      run List<ProviderEntry>.append(&mut copied, move entry)
      at = at + usize.ONE
    }
  }
  return move copied
}

// The address type of each own provider, as the hidden parameter's local type.
effect fn providerAddresses(own: &[ProviderEntry]) -> List<Shared<Type>> ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut addresses = List<Shared<Type>>.make()
  let mut at = usize.ZERO
  while at < own.length {
    run List<Shared<Type>>.append(&mut addresses, run Types.intern(Type.Reference {referent: Shared<Type>.clone(&own[at].provider),
      access: own[at].key.access, lifetime: run Shared<Lifetime>.make(Lifetime.Static)}))
    at = at + usize.ONE
  }
  return move addresses
}

fn callableResult(value: &Type) -> Option<Shared<Type>> {
  return match &value.* { Type.Callable {result, ..} => Option<Shared<Type>>.some(Shared<Type>.clone(&result)) _ => Option<Shared<Type>>.none() }
}

// Builds the C ABI shim of one exported definition after classifying every lane. A lane outside
// the immediate scalar and pointer subset keeps its named C ABI gap.
effect fn exportShim(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: List<Dependency>,
  identity: &Shared<DeclarationId>,
  key: Key,
  symbol: &Shared<Bytes>,
  written: ForeignHeader,
  observing: bool,
) -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut evidence = move dependencies
  let declarationAccess181 = declarationPosition(&resolver.*, key)
  let location = InstanceLocation {module: key.module, declaration: declarationAccess181}
  let classified = run Effect.result(cSignature(&mut resolver.*, &mut owner.*, &mut evidence, identity, location, move written))
  let signature = match move classified {
    Result<CAbi.Signature, BackendGap | Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError>.Success {value} => move value
    Result<CAbi.Signature, BackendGap | Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError>.Failure {error} => match move error {
      BackendGap {code, owner: gapOwner, source} => {
        return memberSuccess(
          Value.Unsupported {gap: run Shared<BackendGap>.make(BackendGap {code: code, owner: move gapOwner, source: move source})},
          move evidence,
        )
      }
      Cycle {} => { fail Cycle {} }
      InvalidModulePath {} => { fail InvalidModulePath {} }
      RevisionMismatch {} => { fail RevisionMismatch {} }
      OutOfMemoryError {} => { fail OutOfMemoryError {} }
    }
  }
  let lanes = List<CAbi.Lane>.asSlice(&signature.parameters)
  let mut parameters = List<Shared<Type>>.make()
  let mut at = usize.ZERO
  while at < lanes.length {
    run List<Shared<Type>>.append(&mut parameters, Shared<Type>.clone(&lanes[at].ty))
    at = at + usize.ONE
  }
  let shim = run MirFunction.cExport(identity, symbol, List<Shared<Type>>.asSlice(&parameters), &signature.result.ty, observing)
  return run storeMir(&mut resolver.*, &mut owner.*, move shim, move evidence)
}

// Whether `instance` runs an interface operation itself under a structural union `Self`: the
// witness a union provider selects (UNION-003).
effect fn unionDispatched(instance: &InstanceKey) -> bool ! OutOfMemoryError ? &mut Allocator {
  if let InstanceKey.Function {..} = &instance.* {
    let application = run InstanceKey.selected(instance)
    if let SpecializationTarget.Operation {provider, operation, implementation, ..} = &application.target {
      return DeclarationId.equals(&operation, &implementation) && Shared<Type>.with<bool>(&provider, unionType)
    }
  }
  return false
}

// The dispatch body of a union operation instance: one arm per member calls that member's witness.
struct DispatchTarget {
  contract: Shared<Type>,
  provider: Shared<Type>,
}

effect fn dispatchGap(code: GapCode, identity: &Shared<DeclarationId>) -> Value ! OutOfMemoryError ? &mut Allocator {
  return Value.Unsupported {gap: run Shared<BackendGap>.make(BackendGap.make(code, identity, Span.make(usize.ZERO, usize.ZERO)))}
}

effect fn resolveUnionDispatchMir(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, key: Key,
  instance: InstanceKey, identity: &Shared<DeclarationId>, observing: bool) -> Answer
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut dependencies = List<Dependency>.make()
  let span = Span.make(usize.ZERO, usize.ZERO)
  let application = run InstanceKey.selected(&instance)
  let target = match &application.target {
    SpecializationTarget.Operation {contract, provider, ..} => DispatchTarget {contract: Shared<Type>.clone(&contract),
      provider: Shared<Type>.clone(&provider)}
    _ => { return memberSuccess(run dispatchGap(GapCode.WitnessOperand, identity), move dependencies) }
  }
  let contract = move target.contract
  let provider = move target.provider
  let operation = DeclarationId.copy(Application.bodyDeclaration(&application))
  let module = ModuleId.copy(DeclarationId.moduleId(&operation))
  let signature = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies, Key {family: Family.Signature,
    module: key.module, name: usize.ZERO, declaration: key.declaration, member: usize.ZERO, external: false}, span)
  if let Option<Shared<Rejection>>.Some {value} = move Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(
    &signature, answerCause) {
    return run memberRejected(move value, move dependencies)
  }
  let bindings = run Application.bindings(&application)
  let noProjections = List<RuntimeProjection>.make()
  let projections = List<RuntimeProjection>.asSlice(&noProjections)
  let mut parameters = List<Shared<Type>>.make()
  let count = Shared<Result<Answer, NoRejection>>.with<usize>(&signature, signatureParameterCount)
  let mut at = usize.ZERO
  while at < count {
    let written = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(&signature,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> { return signatureParameterAt(answer, at) })
    match move written {
      Option<Shared<Type>>.Some {value} => {
        run List<Shared<Type>>.append(&mut parameters, run RuntimeType.applyBindings(&value, List<Binding>.asSlice(&bindings), projections))
      }
      Option<Shared<Type>>.None => { return memberSuccess(run dispatchGap(GapCode.SignatureForm, identity), move dependencies) }
    }
    at = at + usize.ONE
  }
  let writtenResult = match move Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(&signature, signatureResult) {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => { return memberSuccess(run dispatchGap(GapCode.SignatureForm, identity), move dependencies) }
  }
  let result = run RuntimeType.applyBindings(&writtenResult, List<Binding>.asSlice(&bindings), projections)
  let writtenFailure = run signatureFailure(&signature)
  let failure = run Type.applyBindings(&writtenFailure, List<Binding>.asSlice(&bindings), true)
  let fails = !Shared<Type>.with<bool>(&failure, neverType)
  let own = run instanceProviders(&instance)
  let addresses = run providerAddresses(List<ProviderEntry>.asSlice(&own))
  // Tags number the canonical physical members.
  let members = match move run Type.canonicalUnionMembers(&provider) {
    Option<List<Shared<Type>>>.Some {value} => move value
    Option<List<Shared<Type>>>.None => { return memberSuccess(run dispatchGap(GapCode.WitnessOperand, identity), move dependencies) }
  }
  let listed = List<Shared<Type>>.asSlice(&members)
  let mut arms = List<DispatchArm>.make()
  let mut request = Request.make()
  at = usize.ZERO
  while at < listed.length {
    let selected = run resolveWitnessApplication(&mut resolver.*, &mut owner.*, &mut request, &mut dependencies, true,
      &contract, &listed[at], &operation, &module, span)
    let witness = match move selected {
      Result<ResolvedWitness, Shared<Rejection>>.Success {value} => move value
      Result<ResolvedWitness, Shared<Rejection>>.Failure {error} => { return run mirRejection(identity, move error, move dependencies) }
    }
    // Each operand passes unchanged: a member witness that borrows a by-value operand is not admitted.
    let passes = List<OperandPass>.asSlice(&witness.operands)
    let mut pass = usize.ZERO
    while pass < passes.length {
      if let OperandPass.Borrow {..} = &passes[pass] { return memberSuccess(run dispatchGap(GapCode.WitnessOperand, identity), move dependencies) }
      pass = pass + usize.ONE
    }
    let closed = run Application.applyBindings(&witness.application, List<Binding>.asSlice(&bindings))
    let unbound = List<BoundProvider>.make()
    let served = match move run rowProviders(&mut resolver.*, &mut owner.*, &mut dependencies, &closed,
      List<ProviderEntry>.asSlice(&own), List<BoundProvider>.asSlice(&unbound), span) {
      Result<RowProviders, PreparationFailure>.Success {value} => move value
      Result<RowProviders, PreparationFailure>.Failure {error} => { return run preparationQueryAnswer(identity, move error, move dependencies) }
    }
    let mut sources = List<usize>.make()
    let given = List<MirProviderSource>.asSlice(&served.sources)
    let mut source = usize.ZERO
    while source < given.length {
      match &given[source] {
        MirProviderSource.Own {index} => { run List<usize>.append(&mut sources, index) }
        _ => { return memberSuccess(run dispatchGap(GapCode.EffectForm, identity), move dependencies) }
      }
      source = source + usize.ONE
    }
    let mut calleeKey = Result<InstanceKey, CanonicalizationFailure>.failResult(CanonicalizationFailure.Resource)
    if List<ProviderEntry>.length(&served.entries) != usize.ZERO {
      calleeKey = run InstanceKey.withProviders(move closed, move served.entries)
    } else {
      calleeKey = run InstanceKey.function(move closed)
    }
    let callee = match move calleeKey {
      Result<InstanceKey, CanonicalizationFailure>.Success {value} => move value
      Result<InstanceKey, CanonicalizationFailure>.Failure {error: reason} => {
        return run preparationQueryAnswer(identity, PreparationFailure.Canonicalization {reason: reason}, move dependencies)
      }
    }
    // The member witness's failure must be this operation's own; a narrower one is not admitted yet.
    let calleeFailure = match move run witnessFailureType(&mut resolver.*, &mut owner.*, &mut dependencies, &callee, span) {
      Option<Shared<Type>>.Some {value} => move value
      Option<Shared<Type>>.None => { return memberSuccess(run dispatchGap(GapCode.SignatureForm, identity), move dependencies) }
    }
    let memberFails = !Shared<Type>.with<bool>(&calleeFailure, neverType)
    if memberFails && !sameReusableType(&calleeFailure, &failure) {
      return memberSuccess(run dispatchGap(GapCode.WitnessOperand, identity), move dependencies)
    }
    run List<DispatchArm>.append(&mut arms, DispatchArm {tag: at, member: Shared<Type>.clone(&listed[at]), callee: move callee,
      providers: move sources, fails: memberFails})
    at = at + usize.ONE
  }
  let function = run UnionDispatch.lower(UnionDispatch {key: move instance, result: move result, parameters: move parameters,
    providers: move addresses, failure: move failure, fails: fails, count: listed.length, arms: move arms}, observing)
  return run storeMir(&mut resolver.*, &mut owner.*, move function, move dependencies)
}

// The declared failure of the instance `callee` runs, under its application.
effect fn witnessFailureType(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, dependencies: &mut List<Dependency>,
  callee: &InstanceKey, span: Span) -> Option<Shared<Type>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let application = run InstanceKey.selected(callee)
  let location = match move run locationOfInstance(&mut resolver.*, callee) {
    Option<InstanceLocation>.Some {value} => value
    Option<InstanceLocation>.None => { return Option<Shared<Type>>.none() }
  }
  let signatureKey = run internDeclaration(&mut resolver.*, Key {family: Family.Signature, module: location.module,
    name: usize.ZERO, declaration: location.declaration, member: usize.ZERO, external: false})
  let signature = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, signatureKey, span)
  if Shared<Result<Answer, NoRejection>>.with<bool>(&signature, hasRejection) { return Option<Shared<Type>>.none() }
  let declared = run signatureFailure(&signature)
  let bindings = run Application.bindings(&application)
  return Option<Shared<Type>>.some(run Type.applyBindings(&declared, List<Binding>.asSlice(&bindings), true))
}

effect fn lowerMir(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  key: Key,
) -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let instances = List<BackendInstance>.asSlice(&resolver.backendInstances)
  let instance = InstanceKey.copy(&instances[key.name].key)
  let observing = instances[key.name].observing
  // A suspendable instance's frame variant records the cancel exit of each suspension point.
  let mut suspending = Option<List<InstanceKey>>.none()
  if let Option<CoroutineFacts>.Some {value: facts} = &instances[key.name].suspension {
    let mut callees = List<InstanceKey>.make()
    let listed = List<InstanceKey>.asSlice(&facts.callees)
    let mut at = usize.ZERO
    while at < listed.length {
      run List<InstanceKey>.append(&mut callees, InstanceKey.copy(&listed[at]))
      at = at + usize.ONE
    }
    suspending = Option<List<InstanceKey>>.some(move callees)
  }
  if let InstanceKey.Helper {creator, node, ordinal, purpose} = &instance {
    let creating = Shared<InstanceKey>.with<InstanceKey>(&creator, InstanceKey.copy)
    return run resolveHelperMir(&mut resolver.*, &mut owner.*, &instance, &creating, node, ordinal, purpose, observing)
  }
  if let Option<Shared<Type>>.Some {value: glued} = move InstanceKey.glueType(&instance) {
    return run resolveGlueMir(&mut resolver.*, &mut owner.*, move instance, &glued, observing)
  }
  let module = resolvedModule(&resolver.*, key.module)
  let declarationAccess182 = declarationPosition(&resolver.*, key)
  let declared = run declarationAt(&mut resolver.*, &module, declarationAccess182)
  let identity = match move declared {
    Option<DeclarationId>.Some {value} => run Shared<DeclarationId>.make(move value)
    Option<DeclarationId>.None => {
      return run memberRejected(
        run reject(
          &resolver.*,
          &module,
          RejectionCode.Unsupported,
          Span.make(usize.ZERO, usize.ZERO),
        ),
        List<Dependency>.make(),
      )
    }
  }
  if run unionDispatched(&instance) {
    return run resolveUnionDispatchMir(&mut resolver.*, &mut owner.*, key, move instance, &identity, observing)
  }
  // Typed origins count from the declaration's anchor; MIR keeps them relative and reads them
  // back against it only for a diagnostic, a gap or an observed trap label.
  let declarationAccess183 = declarationPosition(&resolver.*, key)
  let anchor = match move run positionAnchor(&mut resolver.*, &module, declarationAccess183) {
    Option<Anchor>.Some {value} => move value
    Option<Anchor>.None => {
      return run memberRejected(
        run reject(&resolver.*, &module, RejectionCode.Unsupported, Span.make(usize.ZERO, usize.ZERO)),
        List<Dependency>.make(),
      )
    }
  }
  let mut dependencies = List<Dependency>.make()
  let signature = run demandChild(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies,
    Key {
      family: Family.Signature,
      module: key.module,
      name: usize.ZERO,
      declaration: key.declaration,
      member: usize.ZERO,
      external: false,
    },
    Span.make(usize.ZERO, usize.ZERO),
  )
  let failure = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(
    &signature,
    answerCause,
  )
  if let Option<Shared<Rejection>>.Some {value} = move failure {
    let code = Shared<Rejection>.with<RejectionCode>(
      &value,
      fn(rejection: &Rejection) -> RejectionCode {
        return rejection.code
      },
    )
    let mut coverageGap = BackendGap.forRejection(code)
    if code == RejectionCode.Unsupported { coverageGap = Option<GapCode>.some(GapCode.SignatureForm) }
    if let Option<GapCode>.Some {value: gapCode} = move coverageGap {
      return memberSuccess(
        Value.Unsupported {
          gap: run Shared<BackendGap>.make(BackendGap.fromRejection(gapCode, &identity, &value)),
        },
        move dependencies,
      )
    }
    return run memberRejected(move value, move dependencies)
  }
  let selected = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(
    &signature,
    signatureResult,
  )
  let mut result = match move selected {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => {
      return memberSuccess(
        Value.Unsupported {
          gap: run Shared<BackendGap>.make(
            BackendGap.make(GapCode.SignatureForm, &identity, Span.make(usize.ZERO, usize.ZERO)),
          ),
        },
        move dependencies,
      )
    }
  }
  let declarationAccess184 = declarationPosition(&resolver.*, key)
  let written = run signatureSyntax(&mut resolver.*, &module, declarationAccess184)
  if let Option<WrittenSignature>.Some {value} = move written {
    if value.isStatic {
      return memberSuccess(
        Value.Unsupported {
          gap: run Shared<BackendGap>.make(
            BackendGap.make(GapCode.StaticResidualization, &identity, value.span),
          ),
        },
        move dependencies,
      )
    }
  }
  let declarationAccess185 = declarationPosition(&resolver.*, key)
  let selectedHeader = run header(&mut resolver.*, &module, declarationAccess185)
  let mut linked = false
  if let Option<HeaderSyntax>.Some {value: syntax} = move selectedHeader {
    if let Node.FunctionHeader {linkage, ..} = syntax.header { linked = linkage.present }
  }
  if linked {
    let declarationAccess186 = declarationPosition(&resolver.*, key)
    let foreign = run foreignHeader(&mut resolver.*, &module, declarationAccess186)
    if !foreign.exported {
      let code = match move foreign.gap {
        Option<GapCode>.Some {value: reason} => reason
        Option<GapCode>.None => GapCode.ForeignContract
      }
      return memberSuccess(
        Value.Unsupported {
          gap: run Shared<BackendGap>.make(BackendGap.make(code, &identity, foreign.span)),
        },
        move dependencies,
      )
    }
    if let Option<Shared<Bytes>>.Some {value: symbol} = move InstanceKey.exportSymbol(&instance) {
      return run exportShim(&mut resolver.*, &mut owner.*, move dependencies, &identity, key, &symbol, move foreign, observing)
    }
    // The exported definition's own body lowers below like any ordinary function.
  }
  if key.member == exportMember() {
    return run memberRejected(
      run reject(&resolver.*, &module, RejectionCode.Unsupported, Span.make(usize.ZERO, usize.ZERO)),
      move dependencies,
    )
  }
  // A function with static work lowers the selected body for this application, never an
  // abstract all-arms body.
  let declarationAccess187 = declarationPosition(&resolver.*, key)
  let routing = run needsStaticResidualization(
    &mut resolver.*, &mut owner.*, &mut dependencies, &module, key.module, declarationAccess187,
  )
  let mut bodyMember = usize.ZERO
  match move routing {
    Result<bool, Shared<Rejection>>.Success {value: routed} => {
      if routed || Shared<DeclarationId>.with<bool>(&identity, literalKind) {
        let application = run InstanceKey.selected(&instance)
        let interned = run internSelectedApplication(&mut resolver.*, &application)
        bodyMember = interned + usize.ONE
      }
    }
    Result<bool, Shared<Rejection>>.Failure {error} => {
      return run mirRejection(&identity, move error, move dependencies)
    }
  }
  let bodyAnswer = run demandChild(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies,
    Key {
      family: Family.Body,
      module: key.module,
      name: usize.ZERO,
      declaration: key.declaration,
      member: bodyMember,
      external: false,
    },
    Span.make(usize.ZERO, usize.ZERO),
  )
  let bodyFailure = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(
    &bodyAnswer,
    answerCause,
  )
  if let Option<Shared<Rejection>>.Some {value} = move bodyFailure {
    let coverageGap = Shared<Rejection>.with<Option<GapCode>>(&value, fn(rejection: &Rejection) -> Option<GapCode> {
      return BackendGap.forRejection(rejection.code)
    })
    if let Option<GapCode>.Some {value: gapCode} = move coverageGap {
      return memberSuccess(
        Value.Unsupported {
          gap: run Shared<BackendGap>.make(BackendGap.fromRejection(gapCode, &identity, &value)),
        },
        move dependencies,
      )
    }
    let unsupported = Shared<Rejection>.with<bool>(
      &value,
      fn(rejection: &Rejection) -> bool {
        return rejection.code == RejectionCode.Unsupported
      },
    )
    if unsupported {
      let span = Shared<Rejection>.with<Span>(
        &value,
        fn(rejection: &Rejection) -> Span {
          return rejection.span
        },
      )
      let operationInputs = Shared<Rejection>.with<bool>(&value, fn(diagnostic: &Rejection) -> bool {
        return List<Shared<DeclarationId>>.length(&diagnostic.path) == usize.ONE
      })
      if operationInputs {
        let operation = Shared<Rejection>.with<Shared<DeclarationId>>(&value, fn(diagnostic: &Rejection) -> Shared<DeclarationId> {
          let path = List<Shared<DeclarationId>>.asSlice(&diagnostic.path)
          return Shared<DeclarationId>.clone(&path[usize.ZERO])
        })
        let declared = DeclarationId.copyShared(&operation)
        let operationModule = DeclarationId.moduleId(&declared)
        let ordinal = run ordinalOfIdentity(&mut resolver.*, operationModule, &operation)
        if let Option<usize>.Some {value: at} = move ordinal {
          let parent = run enclosingIdentity(&mut resolver.*, operationModule, at)
          if let Option<DeclarationId>.Some {value: parentIdentity} = move parent {
            let parentKind = DeclarationId.kind(&parentIdentity)
            if parentKind == OwnerKind.Interface || parentKind == OwnerKind.Service {
              return memberSuccess(Value.Unsupported {
                gap: run Shared<BackendGap>.make(BackendGap.fromRejection(GapCode.GenericOperation, &identity, &value)),
              }, move dependencies)
            }
          }
        }
      }
      let authoredOrdinal = rejectionModuleOrdinal(&resolver.*, &value)
      if authoredOrdinal == usize.MAX { return run memberRejected(move value, move dependencies) }
      let authoredModule = resolvedModule(&resolver.*, authoredOrdinal)
      let sourceAnswer = run source(&mut resolver.*, &authoredModule)
      let coverage = match move sourceOf(&resolver.*, &sourceAnswer, &authoredModule) {
        Option<&IndexedSource>.Some {value: indexed} => bodyCoverageGap(
          IndexedSource.authored(indexed),
          span,
        )
        Option<&IndexedSource>.None => {
          return run memberRejected(
            run reject(&resolver.*, &authoredModule, RejectionCode.MissingModule, span),
            move dependencies,
          )
        }
      }
      return memberSuccess(
        Value.Unsupported {
          gap: run Shared<BackendGap>.make(BackendGap.fromRejection(coverage, &identity, &value)),
        },
        move dependencies,
      )
    }
    let profileInput = Shared<Rejection>.with<bool>(
      &value,
      fn(rejection: &Rejection) -> bool {
        return rejection.code == RejectionCode.ProfileInputUnavailable
      },
    )
    if profileInput {
      return memberSuccess(
        Value.Unsupported {
          gap: run Shared<BackendGap>.make(BackendGap.fromRejection(GapCode.ProfileInput, &identity, &value)),
        },
        move dependencies,
      )
    }
    return run memberRejected(move value, move dependencies)
  }
  let body = Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(
    &bodyAnswer,
    answerTypedBody,
  )
  let checkedBody = match move body {
    Option<Shared<TypedBody>>.Some {value} => move value
    Option<Shared<TypedBody>>.None => {
      return memberSuccess(
        Value.Unsupported {
          gap: run Shared<BackendGap>.make(
            BackendGap.make(GapCode.TypedForm, &identity, Span.make(usize.ZERO, usize.ZERO)),
          ),
        },
        move dependencies,
      )
    }
  }
  let hasEnvironment = Shared<TypedBody>.with<bool>(&checkedBody, fn(value: &TypedBody) -> bool {
    let environment = TypedBody.environmentOf(value)
    return match &environment.* { Option<BodyEnvironment>.Some {..} => true _ => false }
  })
  let typed = move checkedBody
  // Resolve checked call targets before borrowing the caller's authored HIR. Proof queries
  // are MIR children, while target bodies remain deferred to the admitted instance worklist.
  let callerApplication = run InstanceKey.selected(&instance)
  if Shared<Type>.with<bool>(&result, rawCallableType) {
    result = match move run callableResultType(&mut resolver.*, &mut owner.*, &mut dependencies,
      &callerApplication, List<Constraint>.asSlice(&List<Constraint>.make()), Span.make(usize.ZERO, usize.ZERO)) {
      Result<Shared<Type>, Shared<Rejection>>.Success {value} => move value
      Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return run mirRejection(&identity, move error, move dependencies) }
    }
  }
  let callerBindings = run Application.bindings(&callerApplication)
  // Runtime lanes only: a static parameter's value is part of the instance key, not an operand.
  let mut parameters = List<Shared<Type>>.make()
  if hasEnvironment {
    run List<Shared<Type>>.append(&mut parameters, Shared<TypedBody>.with<Shared<Type>>(&typed, fn(value: &TypedBody) -> Shared<Type> {
      let locals = TypedBody.localSlice(value)
      return Shared<Type>.clone(&locals[usize.ZERO].ty)
    }))
  }
  let count = Shared<Result<Answer, NoRejection>>.with<usize>(&signature, signatureParameterCount)
  let staticCount = Shared<Result<Answer, NoRejection>>.with<usize>(&signature, signatureStaticCount)
  let staticSlots = run signatureStaticSlots(&signature, staticCount)
  let mut at = usize.ZERO
  while at < count {
    if !isStaticIndex(List<usize>.asSlice(&staticSlots), at) {
      let selected = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(
        &signature,
        fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> {
          return signatureParameterAt(answer, at)
        },
      )
      if let Option<Shared<Type>>.Some {value} = move selected {
        run List<Shared<Type>>.append(&mut parameters, move value)
      }
    }
    at = at + usize.ONE
  }
  let projections = match move run runtimeProjections(&mut resolver.*, &mut owner.*, &mut dependencies,
    &callerApplication, List<Binding>.asSlice(&callerBindings), &typed, &result, List<Shared<Type>>.asSlice(&parameters), &anchor) {
    Result<List<RuntimeProjection>, Shared<Rejection>>.Success {value} => move value
    Result<List<RuntimeProjection>, Shared<Rejection>>.Failure {error} => { return run mirRejection(&identity, move error, move dependencies) }
  }
  let storageProjection = List<RuntimeProjection>.asSlice(&projections)
  let own = run instanceProviders(&instance)
  let premiseCount = Shared<Result<Answer, NoRejection>>.with<usize>(&signature, signatureConstraintCount)
  let mut premises = List<Constraint>.make()
  let mut premiseAt = usize.ZERO
  while premiseAt < premiseCount {
    let premise = Shared<Result<Answer, NoRejection>>.with<Option<Constraint>>(&signature,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Constraint> { return signatureConstraint(answer, premiseAt) })
    if let Option<Constraint>.Some {value} = move premise { run List<Constraint>.append(&mut premises, move value) }
    premiseAt = premiseAt + usize.ONE
  }
  let needs = match move run cleanupNeeds(&mut resolver.*, &mut owner.*, &mut dependencies, &typed, List<Binding>.asSlice(&callerBindings),
    storageProjection, List<Constraint>.asSlice(&premises), &anchor) {
    Result<CleanupNeeds, Shared<Rejection>>.Success {value} => move value
    Result<CleanupNeeds, Shared<Rejection>>.Failure {error} => { return run mirRejection(&identity, move error, move dependencies) }
  }
  let mut calls = List<MirCallTarget>.make()
  let mut plans = List<MirNodePlan>.make()
  let mut storage = List<MirStoragePlan>.make()
  let mut carriers = List<MirCarrierPlan>.make()
  let mut witnessIntrinsics = List<MirWitnessIntrinsic>.make()
  let reachedCalls = run MirFunction.callNodes(&typed)
  let callNodes = List<BodyNodeId>.asSlice(&reachedCalls)
  let mut callAt = usize.ZERO
  let mut callRequest = Request.make()
  while callAt < callNodes.length {
    let node = callNodes[callAt]
    if let Option<StorageOperation>.Some {value: operation} = move TypedBody.storageOperation(&typed, node) {
      let site = Shared<TypedBody>.with<Span>(&typed, fn(value: &TypedBody) -> Span { return BodyOrigin.span(TypedBody.nodeSlice(value)[node.index].origin, &anchor) })
      match move run storagePlan(&mut resolver.*, &mut owner.*, &mut dependencies, &typed, node, operation, &callerApplication,
        List<Binding>.asSlice(&callerBindings), storageProjection, &identity, List<ProviderEntry>.asSlice(&own), &module, site, &anchor) {
        Result<MirStoragePlan, PreparationFailure>.Success {value} => { run List<MirStoragePlan>.append(&mut storage, move value) }
        Result<MirStoragePlan, PreparationFailure>.Failure {error} => {
          return run preparationAnswer(&resolver.*, &identity, &module, site, move error, move dependencies)
        }
      }
    }
    let direct = TypedBody.directApplication(&typed, node)
    if let Option<Shared<Application>>.Some {value: recordedApplication} = move direct {
      let recorded = run Application.copyShared(&recordedApplication)
      let closed = run Application.substitute(&recorded, &callerApplication)
      let mut operands = List<MirCallOperand>.make()
      let mut at = usize.ZERO
      while true {
        let selected = TypedBody.callArgument(&typed, node, at)
        let argument = match move selected { Option<CallArgument>.Some {value} => move value _ => { break } }
        let ty = run RuntimeType.applyBindings(&argument.ty, List<Binding>.asSlice(&callerBindings), storageProjection)
        run List<MirCallOperand>.append(&mut operands, MirCallOperand {value: Shared<Type>.clone(&ty), parameter: move ty, borrow: Option<Access>.none()})
        at = at + usize.ONE
      }
      let calleeKey = match move run InstanceKey.function(run Application.copy(&closed)) {
        Result<InstanceKey, CanonicalizationFailure>.Success {value: canonicalKey} => move canonicalKey
        Result<InstanceKey, CanonicalizationFailure>.Failure {error: reason} => {
          return run preparationAnswer(&resolver.*, &identity, &module,
            Shared<TypedBody>.with<Span>(&typed, fn(value: &TypedBody) -> Span { return BodyOrigin.span(TypedBody.nodeSlice(value)[node.index].origin, &anchor) }),
            PreparationFailure.Canonicalization {reason: reason}, move dependencies)
        }
      }
      run List<MirCallTarget>.append(&mut calls, MirCallTarget {
        node: node, receiverDereferences: usize.ZERO, key: move calleeKey, application: move closed, edge: Edge.Direct, operands: move operands,
        stored: Option<MirStoredArguments>.none(), providers: List<MirProviderSource>.make(), dispatch: Option<MirProviderSource>.none(),
        witnessFailure: Option<Shared<Type>>.none(), nonParking: false, vacuous: false,
      })
    }
    // A stored Effect runs through its exact representation's runner, like a callable with no new
    // arguments: its environment supplies the stored arguments or the block's captures (D1).
    let stored = TypedBody.runOperand(&typed, node)
    let mut composed = Option<RunOperand>.none()
    let mut plain = Option<RunOperand>.none()
    if let Option<RunOperand>.Some {value: operand} = move stored {
      let closed = run Type.applyBindings(&operand.receiver, List<Binding>.asSlice(&callerBindings), true)
      if Shared<Type>.with<bool>(&closed, compositeType) { composed = Option<RunOperand>.some(move operand) }
      else { plain = Option<RunOperand>.some(move operand) }
    }
    // A composed Effect expands at its run site through a prepared plan of ordinary targets (D4).
    if let Option<RunOperand>.Some {value: operand} = move composed {
      let closed = run Type.applyBindings(&operand.receiver, List<Binding>.asSlice(&callerBindings), true)
      let mut steps = List<MirRunPlan>.make()
      let mut bound = List<BoundProvider>.make()
      let prepared = run compositePlan(&mut resolver.*, &mut owner.*, &mut dependencies, &typed, node, &callerApplication,
        List<Binding>.asSlice(&callerBindings), storageProjection, &identity, &closed, operand.origin, List<ProviderEntry>.asSlice(&own),
        &mut bound, &module, &mut steps, &anchor)
      match move prepared {
        Result<usize, PreparationFailure>.Success {..} => { run List<MirNodePlan>.append(&mut plans, MirNodePlan {node: node, steps: move steps}) }
        Result<usize, PreparationFailure>.Failure {error} => {
          return run preparationAnswer(&resolver.*, &identity, &module, BodyOrigin.span(operand.origin, &anchor), move error, move dependencies)
        }
      }
    }
    if let Option<RunOperand>.Some {value: operand} = move plain {
      let mode = Shared<Type>.with<CallableMode>(&operand.receiver, callableInvocationMode)
      let inputs = CallableCallInputs {receiver: move operand.receiver, inference: Shared<DeclarationId>.clone(&identity),
        bindings: run Shared<List<Binding>>.make(List<Binding>.make()), mode: mode, callee: operand.callee,
        result: move operand.result, count: usize.ZERO, origin: operand.origin}
      let none = List<Shared<Type>>.make()
      let selected = run concreteCallableCall(&mut resolver.*, &mut owner.*, &mut dependencies, &typed, node,
        &callerApplication, List<Binding>.asSlice(&callerBindings), storageProjection, move inputs, List<Shared<Type>>.asSlice(&none), &anchor)
      match move selected {
        Result<MirCallTarget, PreparationFailure>.Success {value} => { run List<MirCallTarget>.append(&mut calls, move value) }
        Result<MirCallTarget, PreparationFailure>.Failure {error} => {
          return run preparationAnswer(&resolver.*, &identity, &module, Shared<TypedBody>.with<Span>(&typed, fn(value: &TypedBody) -> Span { return BodyOrigin.span(TypedBody.nodeSlice(value)[node.index].origin, &anchor) }), move error, move dependencies)
        }
      }
    }
    let callable = TypedBody.callableCall(&typed, node)
    if let Option<CallableCallInputs>.Some {value: inputs} = move callable {
      if Shared<Type>.with<bool>(&inputs.receiver, nativeFunctionPointer) {
        callAt = callAt + usize.ONE
        continue
      }
      let mut written = List<Shared<Type>>.make()
      let mut writtenAt = usize.ZERO
      while writtenAt < inputs.count {
        let selectedArgument = TypedBody.callArgument(&typed, node, writtenAt)
        let argument = match move selectedArgument { Option<CallArgument>.Some {value} => move value _ => { fail RevisionMismatch {} } }
        run List<Shared<Type>>.append(&mut written, run Type.applyBindings(&argument.ty, List<Binding>.asSlice(&callerBindings), true))
        writtenAt = writtenAt + usize.ONE
      }
      let selected = run concreteCallableCall(&mut resolver.*, &mut owner.*, &mut dependencies, &typed, node,
        &callerApplication, List<Binding>.asSlice(&callerBindings), storageProjection, move inputs, List<Shared<Type>>.asSlice(&written), &anchor)
      match move selected {
        Result<MirCallTarget, PreparationFailure>.Success {value} => { run List<MirCallTarget>.append(&mut calls, move value) }
        Result<MirCallTarget, PreparationFailure>.Failure {error} => {
          return run preparationAnswer(&resolver.*, &identity, &module, Shared<TypedBody>.with<Span>(&typed, fn(value: &TypedBody) -> Span { return BodyOrigin.span(TypedBody.nodeSlice(value)[node.index].origin, &anchor) }), move error, move dependencies)
        }
      }
    }
    // A checked scalar operation invokes exactly one of its carriers.
    if let Option<IntrinsicCallInputs>.Some {value: intrinsic} = move TypedBody.intrinsicCall(&typed, node) {
      if let IntrinsicMember.Scalar {operation} = intrinsic.member {
        if ScalarOperation.checked(operation) {
          let prepared = run carrierPlan(&mut resolver.*, &mut owner.*, &mut dependencies, &typed, node, &callerApplication,
            List<Binding>.asSlice(&callerBindings), storageProjection, &identity, operation, &intrinsic.result,
            List<ProviderEntry>.asSlice(&own), &module, &anchor)
          match move prepared {
            Result<MirCarrierPlan, PreparationFailure>.Success {value} => { run List<MirCarrierPlan>.append(&mut carriers, move value) }
            Result<MirCarrierPlan, PreparationFailure>.Failure {error} => {
              return run preparationAnswer(&resolver.*, &identity, &module, BodyOrigin.span(intrinsic.origin, &anchor), move error, move dependencies)
            }
          }
        }
      }
    }
    let selectedCall = TypedBody.interfaceCall(&typed, node)
    // A stored `effect fn` interface construction calls nothing here: its type is the selected
    // witness's exact Effect, and a later run calls that runner (EFF-001).
    let constructedHere = Shared<TypedBody>.with<bool>(&typed, fn(value: &TypedBody) -> bool { return storedInterfaceEffect(value, node) })
    if let Option<InterfaceCallInputs>.Some {value: inputs} = move selectedCall {
      if constructedHere {
        callAt = callAt + usize.ONE
        continue
      }
      let operation = DeclarationId.copyShared(&inputs.operation)
      let contract = run Type.applyBindings(&inputs.contract, List<Binding>.asSlice(&callerBindings), true)
      let provider = run Type.applyBindings(&inputs.provider, List<Binding>.asSlice(&callerBindings), true)
      let count = Shared<List<Binding>>.with<usize>(&inputs.bindings, fn(values: &List<Binding>) -> usize { return List<Binding>.length(values) })
      let mut invocation = List<Binding>.make()
      let mut bindingAt = usize.ZERO
      while bindingAt < count {
        let recorded = Shared<List<Binding>>.with<Binding>(&inputs.bindings, fn(values: &List<Binding>) -> Binding {
          let entries = List<Binding>.asSlice(values)
          return Binding {declaration: Shared<DeclarationId>.clone(&entries[bindingAt].declaration),
            ordinal: entries[bindingAt].ordinal, value: Argument.copy(&entries[bindingAt].value)}
        })
        run List<Binding>.append(&mut invocation, Binding {declaration: move recorded.declaration, ordinal: recorded.ordinal,
          value: run Argument.applyBindings(&recorded.value, List<Binding>.asSlice(&callerBindings), true)})
        bindingAt = bindingAt + usize.ONE
      }
      let mut actualArguments = List<Shared<Type>>.make()
      let mut actualLoans = List<WitnessLoan>.make()
      // A static operand is part of the witness's instance key, never a runtime operand; its
      // parameter position still takes a place among the witness's operands.
      let operationStatics = run copySharedStaticSlots(&inputs.statics)
      let staticOrdinals = List<StaticSlot>.asSlice(&operationStatics)
      let mut runtimeAt = usize.ZERO
      let mut at = usize.ZERO
      while at < inputs.count + staticOrdinals.length {
        if staticSlotAt(staticOrdinals, at) != usize.MAX {
          run List<Shared<Type>>.append(&mut actualArguments, run Types.intern(Type.Unit))
          run List<WitnessLoan>.append(&mut actualLoans, WitnessLoan {region: Option<Shared<Lifetime>>.some(run Shared<Lifetime>.make(Lifetime.Static))})
          at = at + usize.ONE
          continue
        }
        let selected = TypedBody.callArgument(&typed, node, runtimeAt)
        let argument = match move selected { Option<CallArgument>.Some {value} => move value _ => { fail RevisionMismatch {} } }
        run List<Shared<Type>>.append(&mut actualArguments, run Type.applyBindings(&argument.ty, List<Binding>.asSlice(&callerBindings), true))
        run List<WitnessLoan>.append(&mut actualLoans, WitnessLoan {region: Option<Shared<Lifetime>>.some(run Shared<Lifetime>.make(Lifetime.Local {
          declaration: DeclarationId.copy(Application.bodyDeclaration(&callerApplication)), ordinal: argument.origin.node, binder: usize.MAX}))})
        runtimeAt = runtimeAt + usize.ONE
        at = at + usize.ONE
      }
      let recipe = WitnessRecipe {operation: run Shared<DeclarationId>.make(move operation), contract: move contract, provider: move provider,
        result: Shared<Type>.clone(&inputs.result), bindings: run Shared<List<Binding>>.make(move invocation),
        arguments: run Shared<List<Shared<Type>>>.make(move actualArguments), loans: run Shared<List<WitnessLoan>>.make(move actualLoans), constructs: false}
      // A scalar intrinsic witness lowers in place over the call's operands; it calls no instance.
      let recipeOperation = DeclarationId.copyShared(&recipe.operation)
      let intrinsicWitness = run resolveWitnessIntrinsic(&mut resolver.*, &mut owner.*, &mut callRequest, &mut dependencies,
        &recipe.contract, &recipe.provider, &recipeOperation, &module, BodyOrigin.span(inputs.origin, &anchor))
      if let Option<IntrinsicMember>.Some {value: member} = move intrinsicWitness {
        let mut admitted = inputs.count == intrinsicArity(member)
        at = usize.ZERO
        while admitted && at < inputs.count {
          let selected = TypedBody.callArgument(&typed, node, at)
          let argument = match move selected { Option<CallArgument>.Some {value} => move value _ => { fail RevisionMismatch {} } }
          let actual = run RuntimeType.applyBindings(&argument.ty, List<Binding>.asSlice(&callerBindings), storageProjection)
          admitted = match move intrinsicParameterKind(member, at) {
            Option<IntrinsicValueKind>.Some {value: kind} => Shared<Type>.with<bool>(&actual, fn(value: &Type) -> bool { return intrinsicMatches(kind, value) })
            Option<IntrinsicValueKind>.None => false
          }
          at = at + usize.ONE
        }
        if admitted {
          let expected = run RuntimeType.applyBindings(&inputs.result, List<Binding>.asSlice(&callerBindings), storageProjection)
          admitted = match move intrinsicResultKind(member) {
            Option<IntrinsicValueKind>.Some {value: kind} => Shared<Type>.with<bool>(&expected, fn(value: &Type) -> bool { return intrinsicMatches(kind, value) })
            Option<IntrinsicValueKind>.None => false
          }
        }
        if !admitted {
          return memberSuccess(Value.Unsupported {gap: run Shared<BackendGap>.make(BackendGap.make(GapCode.WitnessOperand, &identity, BodyOrigin.span(inputs.origin, &anchor)))}, move dependencies)
        }
        run List<MirWitnessIntrinsic>.append(&mut witnessIntrinsics, MirWitnessIntrinsic {node: node, member: member})
        callAt = callAt + usize.ONE
        continue
      }
      let witness = match move run completedWitnessApplication(&mut resolver.*, &mut owner.*, &mut callRequest,
        &mut dependencies, &recipe, &module, BodyOrigin.span(inputs.origin, &anchor)) {
        Result<ResolvedWitness, Shared<Rejection>>.Success {value} => move value
        Result<ResolvedWitness, Shared<Rejection>>.Failure {error} => { return run mirRejection(&identity, move error, move dependencies) }
      }
      let mut selectedWitness = run Application.copy(&witness.application)
      // The witness's static slots take the operation's static values in order; only its runtime
      // operands pass at the call.
      let mut runtimePasses = List<OperandPass>.make()
      let allPasses = List<OperandPass>.asSlice(&witness.operands)
      at = usize.ZERO
      while at < allPasses.length {
        if staticSlotAt(staticOrdinals, at) == usize.MAX { run List<OperandPass>.append(&mut runtimePasses, allPasses[at]) }
        at = at + usize.ONE
      }
      let mut witnessStatics = List<usize>.make()
      if staticOrdinals.length > usize.ZERO {
        let witnessIdentity = run Shared<DeclarationId>.make(DeclarationId.copy(Application.bodyDeclaration(&selectedWitness)))
        let witnessLocation = match move run locationOfIdentity(&mut resolver.*, &witnessIdentity) {
          Option<InstanceLocation>.Some {value} => value
          Option<InstanceLocation>.None => { fail InvalidModulePath {} }
        }
        let witnessSignatureRequest = Key {family: Family.Signature, module: witnessLocation.module, name: usize.ZERO,
          declaration: witnessLocation.declaration, member: usize.ZERO, external: false}
        let witnessSignatureKey = run internDeclaration(&mut resolver.*, witnessSignatureRequest)
        let witnessSignature = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies, witnessSignatureKey, BodyOrigin.span(inputs.origin, &anchor))
        let witnessCount = Shared<Result<Answer, NoRejection>>.with<usize>(&witnessSignature, signatureStaticCount)
        witnessStatics = run signatureStaticSlots(&witnessSignature, witnessCount)
        let slots = List<usize>.asSlice(&witnessStatics)
        if slots.length != staticOrdinals.length {
          return memberSuccess(Value.Unsupported {gap: run Shared<BackendGap>.make(BackendGap.make(GapCode.WitnessOperand, &identity, BodyOrigin.span(inputs.origin, &anchor)))}, move dependencies)
        }
        let mut statics = List<StaticSlot>.make()
        let mut staticAt = usize.ZERO
        while staticAt < slots.length {
          run List<StaticSlot>.append(&mut statics, StaticSlot {ordinal: slots[staticAt], value: StaticValue.copy(&staticOrdinals[staticAt].value)})
          staticAt = staticAt + usize.ONE
        }
        selectedWitness.statics = move statics
      }
      let application = &selectedWitness
      let passes = List<OperandPass>.asSlice(&runtimePasses)
      let targetBindings = run Application.bindings(application)
      let targetKey = match move run InstanceKey.function(run Application.copy(application)) {
        Result<InstanceKey, CanonicalizationFailure>.Success {value: canonicalKey} => move canonicalKey
        Result<InstanceKey, CanonicalizationFailure>.Failure {error: reason} => {
          return run preparationAnswer(&resolver.*, &identity, &module, BodyOrigin.span(inputs.origin, &anchor),
            PreparationFailure.Canonicalization {reason: reason}, move dependencies)
        }
      }
      let targetLocation = run locationOfInstance(&mut resolver.*, &targetKey)
      let location = match move targetLocation { Option<InstanceLocation>.Some {value} => value _ => { fail InvalidModulePath {} } }
      let declarationAccess188Request = Key {family: Family.Signature, module: location.module, name: usize.ZERO, declaration: location.declaration, member: usize.ZERO, external: false}
      let declarationAccess188 = run internDeclaration(&mut resolver.*, declarationAccess188Request)
      let targetSignature = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies,
        declarationAccess188, BodyOrigin.span(inputs.origin, &anchor))
      let facts = Shared<Result<Answer, NoRejection>>.with<Option<SignatureFacts>>(&targetSignature, signatureFacts)
      let target = match move facts { Option<SignatureFacts>.Some {value} => move value _ => { return memberSuccess(Value.Unsupported {
        gap: run Shared<BackendGap>.make(BackendGap.make(GapCode.SignatureForm, &identity, BodyOrigin.span(inputs.origin, &anchor)))}, move dependencies) } }
      let mut promisedResult = Shared<Type>.clone(&inputs.result)
      let mut witnessFailure = Option<Shared<Type>>.none()
      // An `effect fn` witness runs as the one call its enclosing `run` executes (Effect note D1).
      // That call's failure edge is typed by the witness's own declared failure, which EFF-009
      // bounds by the promised one (D3).
      if target.isEffect {
        let promised = match move Shared<Type>.with<Option<EffectChannels>>(&inputs.result, effectChannels) {
          Option<EffectChannels>.Some {value} => move value
          Option<EffectChannels>.None => { return memberSuccess(Value.Unsupported {gap: run Shared<BackendGap>.make(
            BackendGap.make(GapCode.InterfaceEffectWitness, &identity, BodyOrigin.span(inputs.origin, &anchor)))}, move dependencies) }
        }
        witnessFailure = Option<Shared<Type>>.some(run RuntimeType.applyBindings(&target.failure, List<Binding>.asSlice(&targetBindings),
          storageProjection))
        promisedResult = move promised.success
      }
      let expectedResult = run RuntimeType.applyBindings(&promisedResult, List<Binding>.asSlice(&callerBindings), storageProjection)
      let targetResult = match move run callableInvocationResult(&mut resolver.*, &mut owner.*, &mut dependencies,
        application, &target.result, List<Binding>.asSlice(&targetBindings), storageProjection, BodyOrigin.span(inputs.origin, &anchor)) {
        Result<Shared<Type>, PreparationFailure>.Success {value} => move value
        Result<Shared<Type>, PreparationFailure>.Failure {error} => { return run preparationAnswer(&resolver.*, &identity, &module, BodyOrigin.span(inputs.origin, &anchor), move error, move dependencies) }
      }
      if target.parameters != passes.length + List<usize>.length(&witnessStatics) || !run Type.runtimeEqualsShared(&expectedResult, &targetResult) {
        return memberSuccess(Value.Unsupported {gap: run Shared<BackendGap>.make(BackendGap.make(GapCode.WitnessOperand, &identity, BodyOrigin.span(inputs.origin, &anchor)))}, move dependencies)
      }
      // Header proof already established result/failure/row correspondence. This boundary
      // additionally guards concrete operand storage before any target-neutral call is emitted.
      let mut operands = List<MirCallOperand>.make()
      let witnessSlots = List<usize>.asSlice(&witnessStatics)
      let mut parameterAt = usize.ZERO
      at = usize.ZERO
      while at < passes.length {
        while isStaticIndex(witnessSlots, parameterAt) { parameterAt = parameterAt + usize.ONE }
        let selected = TypedBody.callArgument(&typed, node, at)
        let argument = match move selected { Option<CallArgument>.Some {value} => move value _ => { fail RevisionMismatch {} } }
        let actual = run RuntimeType.applyBindings(&argument.ty, List<Binding>.asSlice(&callerBindings), storageProjection)
        let selectedParameter = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(&targetSignature,
          fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> { return signatureParameter(answer, parameterAt) })
        parameterAt = parameterAt + usize.ONE
        let raw = match move selectedParameter { Option<Shared<Type>>.Some {value} => move value _ => { fail RevisionMismatch {} } }
        let parameter = run RuntimeType.applyBindings(&raw, List<Binding>.asSlice(&targetBindings), storageProjection)
        let mut borrow = Option<Access>.none()
        let mut compared = Shared<Type>.clone(&parameter)
        if let OperandPass.Borrow {access, ..} = &passes[at] {
          borrow = Option<Access>.some(access)
          compared = operandTarget(&parameter)
        }
        if !run Type.runtimeEqualsShared(&actual, &compared) {
          return memberSuccess(Value.Unsupported {gap: run Shared<BackendGap>.make(BackendGap.make(GapCode.WitnessOperand, &identity, BodyOrigin.span(inputs.origin, &anchor)))}, move dependencies)
        }
        run List<MirCallOperand>.append(&mut operands, MirCallOperand {value: move actual, parameter: move parameter, borrow: move borrow})
        at = at + usize.ONE
      }
      run List<MirCallTarget>.append(&mut calls, MirCallTarget {
        node: node, receiverDereferences: usize.ZERO, key: move targetKey, application: run Application.copy(application),
        edge: Edge.Witness, operands: move operands,
        stored: Option<MirStoredArguments>.none(), providers: List<MirProviderSource>.make(), dispatch: Option<MirProviderSource>.none(),
        witnessFailure: move witnessFailure, nonParking: false, vacuous: false,
      })
    }
    callAt = callAt + usize.ONE
  }
  // Each callee's requirement row is served from this instance's own providers (D2 rule 1).
  let mut provided = List<MirCallTarget>.make()
  // Reversed once and popped in order: removing each from the front moved every call after it,
  // quadratic in the calls of a large body (a `static for` over thousands of fields).
  let mut queued = List<MirCallTarget>.make()
  while true {
    match move List<MirCallTarget>.pop(&mut calls) {
      Option<MirCallTarget>.Some {value} => { run List<MirCallTarget>.append(&mut queued, move value) }
      Option<MirCallTarget>.None => { break }
    }
  }
  while true {
    let pending = match move List<MirCallTarget>.pop(&mut queued) {
      Option<MirCallTarget>.Some {value} => move value
      Option<MirCallTarget>.None => { break }
    }
    let site = Shared<TypedBody>.with<Span>(&typed, fn(value: &TypedBody) -> Span { return BodyOrigin.span(TypedBody.nodeSlice(value)[pending.node.index].origin, &anchor) })
    if Shared<TypedBody>.with<bool>(&typed, fn(value: &TypedBody) -> bool { return constructedOnly(value, pending.node) }) {
      run List<MirCallTarget>.append(&mut provided, move pending)
      continue
    }
    let none = List<BoundProvider>.make()
    match move run provideCall(&mut resolver.*, &mut owner.*, &mut dependencies, move pending, List<ProviderEntry>.asSlice(&own),
      List<BoundProvider>.asSlice(&none), storageProjection, &module, site) {
      Result<MirCallTarget, PreparationFailure>.Success {value} => { run List<MirCallTarget>.append(&mut provided, move value) }
      Result<MirCallTarget, PreparationFailure>.Failure {error} => {
        return run preparationAnswer(&resolver.*, &identity, &module, site, move error, move dependencies)
      }
    }
  }
  let addresses = run providerAddresses(List<ProviderEntry>.asSlice(&own))
  let remainders = match move run partialRemainders(&mut resolver.*, &mut owner.*, &mut dependencies, &module, Application.bodyDeclaration(&callerApplication), &typed, List<Binding>.asSlice(&callerBindings), storageProjection, &anchor) {
    Result<List<Remainder>, Shared<Rejection>>.Success {value} => move value
    Result<List<Remainder>, Shared<Rejection>>.Failure {error} => { return run mirRejection(&identity, move error, move dependencies) }
  }
  let entry = run entryNonParking(&mut resolver.*, &mut owner.*, &mut dependencies, &callerApplication,
    List<Binding>.asSlice(&callerBindings), storageProjection)
  let constants = match move run bodyConstantValues(&mut resolver.*, &mut owner.*, &mut dependencies, &typed) {
    Result<List<MirConstantValue>, Shared<Rejection>>.Success {value} => move value
    Result<List<MirConstantValue>, Shared<Rejection>>.Failure {error} => { return run mirRejection(&identity, move error, move dependencies) }
  }
  let failureType = run signatureFailure(&signature)
  // Lowering reads only literals of this declaration's body, through the anchor whose body read
  // guards them, so an edit elsewhere in the module keeps the MIR. The site labels of an observing
  // program count lines from the start of the file, which only the whole file guards.
  let mut sourceAnswer = run demandSource(&mut resolver.*, &module)
  if observing { sourceAnswer = run source(&mut resolver.*, &module) }
  let lowered = match move sourceOf(&resolver.*, &sourceAnswer, &module) {
    Option<&IndexedSource>.Some {value: indexed} => run Effect.result(
      MirFunction.lower(
        InstanceKey.copy(&instance),
        &typed,
        IndexedSource.authored(indexed),
        &result,
        &failureType,
        List<Shared<Type>>.asSlice(&parameters),
        List<Shared<Type>>.asSlice(&addresses),
        move provided,
        move plans,
        move storage,
        move carriers,
        move witnessIntrinsics,
        move remainders,
        move needs,
        move projections,
        SourceUnit.bytes(IndexedSource.sourceUnit(indexed)),
        &anchor,
        observing,
        standardRoot(&resolver.*),
        move suspending,
        move constants,
      ),
    )
    Option<&IndexedSource>.None => {
      return run memberRejected(
        run reject(
          &resolver.*,
          &module,
          RejectionCode.Unsupported,
          Span.make(usize.ZERO, usize.ZERO),
        ),
        move dependencies,
      )
    }
  }
  let mut completed = match move lowered {
    Result<Lowered, BackendGap | CanonicalizationFailure | OutOfMemoryError>.Success {value} => move value
    Result<Lowered, BackendGap | CanonicalizationFailure | OutOfMemoryError>.Failure {error} => {
      return match move error {
        BackendGap {code, owner: gapOwner, source} => memberSuccess(
          Value.Unsupported {
            gap: run Shared<BackendGap>.make(
              BackendGap.anchored(BackendGap {code: code, owner: move gapOwner, source: move source}, &anchor),
            ),
          },
          move dependencies,
        )
        CanonicalizationFailure reason => memberSuccess(
          Value.CanonicalizationFailed {reason: reason}, move dependencies)
        OutOfMemoryError {} => {
          fail OutOfMemoryError {}
        }
      }
    }
  }
  let mut owed = move entry
  while List<MirNonParkingRun>.length(&owed) > usize.ZERO {
    run List<MirNonParkingRun>.append(&mut completed.function.nonParking, List<MirNonParkingRun>.remove(&mut owed, usize.ZERO))
  }
  // A function with `features` compiles for them (SIMD-009).
  let listedFeatures = run declarationFeatures(&mut resolver.*, &module, declarationAccess182)
  completed.function.features = run featureAttribute(&resolver.*, List<Bytes>.asSlice(&listedFeatures))
  completed.function.inlining = run declarationInlining(&mut resolver.*, &module, declarationAccess182)
  return run storeLowered(&mut resolver.*, &mut owner.*, move completed, move dependencies)
}

fn singleMemberType(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.MemberShape {types}} = &value.outcome {
      let fields = List<Shared<Type>>.asSlice(&types)
      if fields.length == usize.ONE { return Option<Shared<Type>>.some(Shared<Type>.clone(&fields[usize.ZERO])) }
    }
  }
  return Option<Shared<Type>>.none()
}

effect fn storeLayout(resolver: &mut Resolver, computed: Option<BackendLayout>, dependencies: List<Dependency>) -> Answer
! OutOfMemoryError ? &mut Allocator {
  return match move computed {
    Option<BackendLayout>.Some {value} => {
      let index = List<Shared<BackendLayout>>.length(&resolver.layoutValues)
      run List<Shared<BackendLayout>>.append(&mut resolver.*.layoutValues, run Shared<BackendLayout>.make(move value))
      run List<Bytes>.append(&mut resolver.*.layoutContents, Bytes.make())
      return memberSuccess(Value.Layout {index: index}, move dependencies)
    }
    Option<BackendLayout>.None => memberSuccess(Value.LayoutUnsupported, move dependencies)
  }
}

effect fn resolveLayout(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, key: Key) -> Answer
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let types = List<Shared<Type>>.asSlice(&resolver.erasedTypes)
  if key.name >= types.length {
    return memberSuccess(Value.LayoutUnsupported, List<Dependency>.make())
  }
  let ty = Shared<Type>.clone(&types[key.name])
  let scalar = BackendLayout.scalar(&ty, &resolver.target)
  if let Option<BackendLayout>.Some {value} = move scalar {
    return run storeLayout(&mut resolver.*, Option<BackendLayout>.some(move value), List<Dependency>.make())
  }
  if Shared<Type>.with<bool>(&ty, fn(value: &Type) -> bool { return match &value.* { Type.String {..} => true _ => false } }) {
    let text = run BackendLayout.text(&resolver.target)
    return run storeLayout(&mut resolver.*, move text, List<Dependency>.make())
  }
  if let Option<ArrayShape>.Some {value: array} = move Type.arrayShape(&ty) {
    let mut dependencies = List<Dependency>.make()
    let elementKey = run internErasedType(&mut resolver.*, &array.element)
    let declarationAccess189Request = Key {
      family: Family.Layout, module: key.module, name: elementKey,
      declaration: usize.ZERO, member: usize.ZERO, external: false,
    }
    let declarationAccess189 = run internDeclaration(&mut resolver.*, declarationAccess189Request)
    let child = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies, declarationAccess189, Span.make(usize.ZERO, usize.ZERO))
    let rejected = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(&child, answerCause)
    if let Option<Shared<Rejection>>.Some {value} = move rejected {
      return run memberRejected(move value, move dependencies)
    }
    let selected = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(&child, answerLayoutIndex)
    if let Option<usize>.Some {value: index} = move selected {
      let layouts = List<Shared<BackendLayout>>.asSlice(&resolver.layoutValues)
      let metrics = Shared<BackendLayout>.with<LayoutMetrics>(&layouts[index], BackendLayout.metrics)
      return run storeLayout(&mut resolver.*, BackendLayout.sequence(&array.element, array.length, metrics), move dependencies)
    }
    return memberSuccess(Value.LayoutUnsupported, move dependencies)
  }
  if let Option<Shared<Type>>.Some {value: element} = move Type.sliceElement(&ty) {
    let mut dependencies = List<Dependency>.make()
    let elementKey = run internErasedType(&mut resolver.*, &element)
    let declarationAccess190Request = Key {
      family: Family.Layout, module: key.module, name: elementKey,
      declaration: usize.ZERO, member: usize.ZERO, external: false,
    }
    let declarationAccess190 = run internDeclaration(&mut resolver.*, declarationAccess190Request)
    let child = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies, declarationAccess190, Span.make(usize.ZERO, usize.ZERO))
    let rejected = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(&child, answerCause)
    if let Option<Shared<Rejection>>.Some {value} = move rejected {
      return run memberRejected(move value, move dependencies)
    }
    let selected = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(&child, answerLayoutIndex)
    if let Option<usize>.Some {value: index} = move selected {
      let layouts = List<Shared<BackendLayout>>.asSlice(&resolver.layoutValues)
      let metrics = Shared<BackendLayout>.with<LayoutMetrics>(&layouts[index], BackendLayout.metrics)
      let computed = BackendLayout.slice(&element, metrics, &resolver.target)
      return run storeLayout(&mut resolver.*, move computed, move dependencies)
    }
    return memberSuccess(Value.LayoutUnsupported, move dependencies)
  }
  // Storage requires a complete canonical member set, independently of source admission.
  let orderedUnion = run Type.canonicalUnionMembers(&ty)
  if let Option<List<Shared<Type>>>.Some {value: canonical} = move orderedUnion {
    let mut dependencies = List<Dependency>.make()
    let mut inputs = List<LayoutFieldInput>.make()
    let listed = List<Shared<Type>>.asSlice(&canonical)
    let mut at = usize.ZERO
    while at < listed.length {
      let memberType = Shared<Type>.clone(&listed[at])
      let memberKey = run internErasedType(&mut resolver.*, &memberType)
      let declarationAccess191Request = Key {
        family: Family.Layout, module: key.module, name: memberKey,
        declaration: usize.ZERO, member: usize.ZERO, external: false,
      }
      let declarationAccess191 = run internDeclaration(&mut resolver.*, declarationAccess191Request)
      let child = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies, declarationAccess191, Span.make(usize.ZERO, usize.ZERO))
      let rejected = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(&child, answerCause)
      if let Option<Shared<Rejection>>.Some {value} = move rejected {
        return run memberRejected(move value, move dependencies)
      }
      let selected = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(&child, answerLayoutIndex)
      let index = match move selected {
        Option<usize>.Some {value} => value
        Option<usize>.None => { return memberSuccess(Value.LayoutUnsupported, move dependencies) }
      }
      let layouts = List<Shared<BackendLayout>>.asSlice(&resolver.layoutValues)
      let metrics = Shared<BackendLayout>.with<LayoutMetrics>(&layouts[index], BackendLayout.metrics)
      run List<LayoutFieldInput>.append(&mut inputs, LayoutFieldInput {ty: move memberType, metrics: metrics})
      at = at + usize.ONE
    }
    let computed = run BackendLayout.tagged(List<LayoutFieldInput>.asSlice(&inputs))
    return run storeLayout(&mut resolver.*, move computed, move dependencies)
  }
  // Anonymous aggregates, callable environments and sealed cores have ordinary ordered record
  // storage; a core's fields match the bootstrap's layout (SealedCore).
  let mut structuralFields = run Type.recordFields(&ty)
  let unstructured = match &structuralFields { Option<List<Shared<Type>>>.None => true _ => false }
  if unstructured { structuralFields = run SealedCore.fields(&ty) }
  if let Option<List<Shared<Type>>>.Some {value: members} = move structuralFields {
    let mut dependencies = List<Dependency>.make()
    let mut inputs = List<LayoutFieldInput>.make()
    let listed = List<Shared<Type>>.asSlice(&members)
    let mut at = usize.ZERO
    while at < listed.length {
      let memberKey = run internErasedType(&mut resolver.*, &listed[at])
      let declarationAccess192Request = Key {
        family: Family.Layout, module: key.module, name: memberKey,
        declaration: usize.ZERO, member: usize.ZERO, external: false,
      }
      let declarationAccess192 = run internDeclaration(&mut resolver.*, declarationAccess192Request)
      let child = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies, declarationAccess192, Span.make(usize.ZERO, usize.ZERO))
      let rejected = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(&child, answerCause)
      if let Option<Shared<Rejection>>.Some {value} = move rejected {
        return run memberRejected(move value, move dependencies)
      }
      let selected = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(&child, answerLayoutIndex)
      let index = match move selected {
        Option<usize>.Some {value} => value
        Option<usize>.None => { return memberSuccess(Value.LayoutUnsupported, move dependencies) }
      }
      let layouts = List<Shared<BackendLayout>>.asSlice(&resolver.layoutValues)
      let metrics = Shared<BackendLayout>.with<LayoutMetrics>(&layouts[index], BackendLayout.metrics)
      run List<LayoutFieldInput>.append(&mut inputs, LayoutFieldInput {ty: Shared<Type>.clone(&listed[at]), metrics: metrics})
      at = at + usize.ONE
    }
    let computed = run BackendLayout.record(List<LayoutFieldInput>.asSlice(&inputs))
    return run storeLayout(&mut resolver.*, move computed, move dependencies)
  }
  let moduleOrdinal = declaringModuleOrdinal(&resolver.*, &ty)
  if moduleOrdinal == usize.MAX {
    return memberSuccess(Value.LayoutUnsupported, List<Dependency>.make())
  }
  let module = resolvedModule(&resolver.*, moduleOrdinal)
  let ordinal = run ordinalOfProvider(&mut resolver.*, &module, &ty)
  let declaration = match move ordinal {
    Option<usize>.Some {value} => value
    Option<usize>.None => { return memberSuccess(Value.LayoutUnsupported, List<Dependency>.make()) }
  }
  let written = run header(&mut resolver.*, &module, declaration)
  let writtenHeader = match move written {
    Option<HeaderSyntax>.Some {value} => value
    Option<HeaderSyntax>.None => { return memberSuccess(Value.LayoutUnsupported, List<Dependency>.make()) }
  }
  // A scalar enum has exactly its representation's layout (ENUM-003) and keeps nominal identity.
  if let Node.EnumHeader {..} = writtenHeader.header {
    let mut dependencies = List<Dependency>.make()
    let selected = run scalarEnumMembers(&mut resolver.*, &mut owner.*, &mut dependencies, moduleOrdinal, declaration, writtenHeader.span)
    let members = match move selected {
      Result<Shared<Result<Answer, NoRejection>>, Shared<Rejection>>.Success {value} => move value
      Result<Shared<Result<Answer, NoRejection>>, Shared<Rejection>>.Failure {error} => {
        return run memberRejected(move error, move dependencies)
      }
    }
    let representation = Shared<Result<Answer, NoRejection>>.with<Option<StaticIntegerType>>(&members, scalarEnumRepresentation)
    if let Option<StaticIntegerType>.Some {value: integer} = move representation {
      let backing = run primitiveType(StaticConstant.integerName(integer))
      let computed = BackendLayout.scalar(&backing, &resolver.target)
      return run storeLayout(&mut resolver.*, move computed, move dependencies)
    }
    return memberSuccess(Value.LayoutUnsupported, move dependencies)
  }
  // A complete nominal-union instance lays out each substituted variant like a record after a
  // declaration-order tag.
  if let Node.UnionHeader {variants, ..} = writtenHeader.header {
    let mut dependencies = List<Dependency>.make()
    let nominal = NominalUnion {module: moduleOrdinal, declaration: declaration, count: variants.length}
    let mut records = List<Shared<BackendLayout>>.make()
    let mut tag = usize.ZERO
    while tag < nominal.count {
      let shaped = run variantShape(&mut resolver.*, &mut owner.*, &mut dependencies, &module, &ty, &nominal, tag, writtenHeader.span)
      let shape = match move shaped {
        Result<VariantShape, Shared<Rejection>>.Success {value} => move value
        Result<VariantShape, Shared<Rejection>>.Failure {error} => { return run memberRejected(move error, move dependencies) }
      }
      let fieldTypes = List<Shared<Type>>.asSlice(&shape.types)
      let mut inputs = List<LayoutFieldInput>.make()
      let mut at = usize.ZERO
      while at < fieldTypes.length {
        let fieldKey = run internErasedType(&mut resolver.*, &fieldTypes[at])
        let declarationAccess193Request = Key {
          family: Family.Layout, module: key.module, name: fieldKey,
          declaration: usize.ZERO, member: usize.ZERO, external: false,
        }
        let declarationAccess193 = run internDeclaration(&mut resolver.*, declarationAccess193Request)
        let child = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies, declarationAccess193, writtenHeader.span)
        let rejectedChild = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(&child, answerCause)
        if let Option<Shared<Rejection>>.Some {value} = move rejectedChild { return run memberRejected(move value, move dependencies) }
        let childIndex = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(&child, answerLayoutIndex)
        let index = match move childIndex {
          Option<usize>.Some {value} => value
          Option<usize>.None => { return memberSuccess(Value.LayoutUnsupported, move dependencies) }
        }
        let layouts = List<Shared<BackendLayout>>.asSlice(&resolver.layoutValues)
        let metrics = Shared<BackendLayout>.with<LayoutMetrics>(&layouts[index], BackendLayout.metrics)
        run List<LayoutFieldInput>.append(&mut inputs, LayoutFieldInput {ty: Shared<Type>.clone(&fieldTypes[at]), metrics: metrics})
        at = at + usize.ONE
      }
      let record = run BackendLayout.record(List<LayoutFieldInput>.asSlice(&inputs))
      match move record {
        Option<BackendLayout>.Some {value} => { run List<Shared<BackendLayout>>.append(&mut records, run Shared<BackendLayout>.make(move value)) }
        Option<BackendLayout>.None => { return memberSuccess(Value.LayoutUnsupported, move dependencies) }
      }
      tag = tag + usize.ONE
    }
    let computed = run BackendLayout.variants(List<Shared<BackendLayout>>.asSlice(&records), nominal.count)
    return run storeLayout(&mut resolver.*, move computed, move dependencies)
  }
  let mut count = usize.MAX
  if let Node.StructHeader {fields, ..} = writtenHeader.header { count = fields.length }
  if let Node.TupleHeader {elements, ..} = writtenHeader.header { count = elements.length }
  if count == usize.MAX {
    return memberSuccess(Value.LayoutUnsupported, List<Dependency>.make())
  }
  let application = run internApplication(&mut resolver.*, &ty)
  let mut dependencies = List<Dependency>.make()
  let mut inputs = List<LayoutFieldInput>.make()
  let mut at = usize.ZERO
  while at < count {
    let declarationAccess194Request = Key {
      family: Family.MemberShape, module: moduleOrdinal, name: application,
      declaration: declaration, member: at, external: false,
    }
    let declarationAccess194 = run internDeclaration(&mut resolver.*, declarationAccess194Request)
    let shaped = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies, declarationAccess194, writtenHeader.span)
    let rejected = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(&shaped, answerCause)
    if let Option<Shared<Rejection>>.Some {value} = move rejected {
      return run memberRejected(move value, move dependencies)
    }
    let field = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(&shaped, singleMemberType)
    let fieldType = match move field {
      Option<Shared<Type>>.Some {value} => move value
      Option<Shared<Type>>.None => { return memberSuccess(Value.LayoutUnsupported, move dependencies) }
    }
    let fieldKey = run internErasedType(&mut resolver.*, &fieldType)
    let declarationAccess195Request = Key {
      family: Family.Layout, module: key.module, name: fieldKey,
      declaration: usize.ZERO, member: usize.ZERO, external: false,
    }
    let declarationAccess195 = run internDeclaration(&mut resolver.*, declarationAccess195Request)
    let child = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies, declarationAccess195, writtenHeader.span)
    let rejectedChild = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(&child, answerCause)
    if let Option<Shared<Rejection>>.Some {value} = move rejectedChild {
      return run memberRejected(move value, move dependencies)
    }
    let childIndex = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(&child, answerLayoutIndex)
    let index = match move childIndex {
      Option<usize>.Some {value} => value
      Option<usize>.None => { return memberSuccess(Value.LayoutUnsupported, move dependencies) }
    }
    let layouts = List<Shared<BackendLayout>>.asSlice(&resolver.layoutValues)
    let metrics = Shared<BackendLayout>.with<LayoutMetrics>(&layouts[index], BackendLayout.metrics)
    run List<LayoutFieldInput>.append(&mut inputs, LayoutFieldInput {ty: move fieldType, metrics: metrics})
    at = at + usize.ONE
  }
  let computed = run BackendLayout.record(List<LayoutFieldInput>.asSlice(&inputs))
  return run storeLayout(&mut resolver.*, move computed, move dependencies)
}

/// One runtime type needed by a MIR local or projected operand.
pub struct LayoutDemand {
  pub ty: Shared<Type>,
  pub span: Span,
}

fn dereferencedType(value: &Type) -> Option<Shared<Type>> {
  return match & value.* {
    Type.Reference {referent, ..} => Option<Shared<Type>>.some(Shared<Type>.clone(&referent))
    Type.Pointer {pointee, ..} => Option<Shared<Type>>.some(Shared<Type>.clone(&pointee))
    _ => Option<Shared<Type>>.none()
  }
}

effect fn appendProjectedLayoutDemands(
  function: &MirFunction,
  place: &MirPlace,
  span: Span,
  needed: &mut List<LayoutDemand>,
) -> () ! OutOfMemoryError ? &mut Allocator {
  let locals = List<MirLocal>.asSlice(&function.locals)
  let mut ty = Shared<Type>.clone(&locals[place.local].ty)
  let projections = List<MirProjection>.asSlice(&place.projections)
  let mut at = usize.ZERO
  while at < projections.length {
    match & projections[at] {
      MirProjection.Deref => ()
      _ => {
        return ()
      }
    }
    let pointee = Shared<Type>.with<Option<Shared<Type>>>(&ty, dereferencedType)
    ty = match move pointee {
      Option<Shared<Type>>.Some {value} => move value
      Option<Shared<Type>>.None => {
        return ()
      }
    }
    run List<LayoutDemand>.append(
      &mut needed.*,
      LayoutDemand {ty: Shared<Type>.clone(&ty), span: span},
    )
    at = at + usize.ONE
  }
  return ()
}

effect fn appendOperandLayoutDemands(function: &MirFunction, operand: &MirOperand, span: Span, needed: &mut List<LayoutDemand>) -> ()
! OutOfMemoryError ? &mut Allocator {
  match &operand.* {
    MirOperand.Copy {place} => run appendProjectedLayoutDemands(function, &place, span, &mut needed.*)
    MirOperand.Move {place} => run appendProjectedLayoutDemands(function, &place, span, &mut needed.*)
    // A constant's program-lifetime storage is laid out from its type's layout.
    MirOperand.StaticValue {ty, ..} => run List<LayoutDemand>.append(&mut needed.*, LayoutDemand {ty: Shared<Type>.clone(&ty), span: span})
    _ => ()
  }
  return ()
}

// Projected loads, stores, and address formation of an assignment depend on referent layouts.
effect fn appendStatementLayoutDemands(
  function: &MirFunction,
  statement: &MirStatement,
  needed: &mut List<LayoutDemand>, anchor: &Option<Anchor>,
) -> () ! OutOfMemoryError ? &mut Allocator {
  if let MirStatement.Assign {destination, value, origin} = &statement.* {
    run appendProjectedLayoutDemands(function, &destination, anchoredSpan(anchor, origin), &mut needed.*)
    match & value {
      MirRvalue.Ref {place, ..} => run appendProjectedLayoutDemands(
        function,
        &place,
        anchoredSpan(anchor, origin),
        &mut needed.*,
      )
      MirRvalue.Slice {data, count} => {
        run appendOperandLayoutDemands(function, &data, anchoredSpan(anchor, origin), &mut needed.*)
        run appendOperandLayoutDemands(function, &count, anchoredSpan(anchor, origin), &mut needed.*)
      }
      MirRvalue.Convert {value: operand, ..} => run appendOperandLayoutDemands(function, &operand, anchoredSpan(anchor, origin), &mut needed.*)
      MirRvalue.Fits {value: operand, ..} => run appendOperandLayoutDemands(function, &operand, anchoredSpan(anchor, origin), &mut needed.*)
      MirRvalue.ScalarUnary {value: operand, ..} => run appendOperandLayoutDemands(function, &operand, anchoredSpan(anchor, origin), &mut needed.*)
      MirRvalue.ScalarBinary {left, right, ..} => {
        run appendOperandLayoutDemands(function, &left, anchoredSpan(anchor, origin), &mut needed.*)
        run appendOperandLayoutDemands(function, &right, anchoredSpan(anchor, origin), &mut needed.*)
      }
      MirRvalue.AddressIntegerConversion {operand, ..} => run appendOperandLayoutDemands(function, &operand, anchoredSpan(anchor, origin), &mut needed.*)
      MirRvalue.SliceLength {place} => run appendProjectedLayoutDemands(function, &place, anchoredSpan(anchor, origin), &mut needed.*)
      MirRvalue.SliceData {place} => run appendProjectedLayoutDemands(function, &place, anchoredSpan(anchor, origin), &mut needed.*)
      MirRvalue.PointerOffset {element, ..} => run List<LayoutDemand>.append(
        &mut needed.*,
        LayoutDemand {ty: Shared<Type>.clone(&element), span: anchoredSpan(anchor, origin)},
      )
      MirRvalue.StackAllocate {count, element} => {
        run appendOperandLayoutDemands(function, &count, anchoredSpan(anchor, origin), &mut needed.*)
        run List<LayoutDemand>.append(&mut needed.*, LayoutDemand {ty: Shared<Type>.clone(&element), span: anchoredSpan(anchor, origin)})
      }
      MirRvalue.Discriminant {place} => run appendProjectedLayoutDemands(function, &place, anchoredSpan(anchor, origin), &mut needed.*)
      MirRvalue.AddressOf {place, ..} => run appendProjectedLayoutDemands(
        function,
        &place,
        anchoredSpan(anchor, origin),
        &mut needed.*,
      )
      MirRvalue.Use {value: operand} => run appendOperandLayoutDemands(function, &operand, anchoredSpan(anchor, origin), &mut needed.*)
      _ => ()
    }
  }
  // A drop forms the address of its place before calling the place type's glue.
  if let MirStatement.Drop {destination, origin, ..} = &statement.* {
    run appendProjectedLayoutDemands(function, &destination, anchoredSpan(anchor, origin), &mut needed.*)
  }
  return ()
}

/// Collects complete local and projected-place layout demands for an ordinary MIR body.
pub effect fn mirLayoutDemands(function: &MirFunction, anchor: &Option<Anchor>) -> List<LayoutDemand>
! OutOfMemoryError ? &mut Allocator {
  let locals = List<MirLocal>.asSlice(&function.locals)
  let mut copied = List<LayoutDemand>.make()
  let mut at = usize.ZERO
  while at < locals.length {
    run List<LayoutDemand>.append(
      &mut copied,
      LayoutDemand {ty: Shared<Type>.clone(&locals[at].ty), span: anchoredSpan(anchor, locals[at].origin)},
    )
    at = at + usize.ONE
  }
  // Projected loads, stores, and address formation also depend on their referent layouts.
  let blocks = List<MirBlock>.asSlice(&function.blocks)
  let mut blockAt = usize.ZERO
  while blockAt < blocks.length {
    let statements = List<MirStatement>.asSlice(&blocks[blockAt].statements)
    let mut statementAt = usize.ZERO
    while statementAt < statements.length {
      run appendStatementLayoutDemands(function, &statements[statementAt], &mut copied, anchor)
      statementAt = statementAt + usize.ONE
    }
    // A call reads each argument in place, so a projected argument needs its referent layouts too.
    if let MirTerminator.Call {arguments, origin, ..} = &blocks[blockAt].terminator {
      let listed = List<MirOperand>.asSlice(&arguments)
      let mut argumentAt = usize.ZERO
      while argumentAt < listed.length {
        run appendOperandLayoutDemands(function, &listed[argumentAt], anchoredSpan(anchor, origin), &mut copied)
        argumentAt = argumentAt + usize.ONE
      }
    }
    blockAt = blockAt + usize.ONE
  }
  return move copied
}

effect fn copyMirLocalTypes(resolver: &Resolver, index: usize, anchor: &Option<Anchor>) -> List<LayoutDemand>
! OutOfMemoryError ? &mut Allocator {
  let functions = List<MirFunction>.asSlice(&resolver.mirValues)
  return run mirLayoutDemands(&functions[index], anchor)
}

// Exported entries and indirect calls need the same nested vector feature checks as imports.
effect fn copyMirCValues(resolver: &Resolver, index: usize, anchor: &Option<Anchor>) -> List<LayoutDemand>
! OutOfMemoryError ? &mut Allocator {
  let function = &List<MirFunction>.asSlice(&resolver.mirValues)[index]
  let mut copied = List<LayoutDemand>.make()
  if InstanceKey.fixedLinkage(&function.key) {
    let span = anchoredSpan(anchor, List<MirLocal>.asSlice(&function.locals)[usize.ZERO].origin)
    run List<LayoutDemand>.append(&mut copied, LayoutDemand {ty: Shared<Type>.clone(&function.result), span: span})
    let parameters = List<Shared<Type>>.asSlice(&function.parameters)
    let mut at = usize.ZERO
    while at < parameters.length {
      run List<LayoutDemand>.append(&mut copied, LayoutDemand {ty: Shared<Type>.clone(&parameters[at]), span: span})
      at = at + usize.ONE
    }
  }
  let blocks = List<MirBlock>.asSlice(&function.blocks)
  let mut at = usize.ZERO
  while at < blocks.length {
    if let MirTerminator.Call {callee: MirCallee.NativeIndirect {signature, ..}, origin, ..} = &blocks[at].terminator {
      run List<LayoutDemand>.append(&mut copied, LayoutDemand {ty: Shared<Type>.clone(&signature), span: anchoredSpan(anchor, origin)})
    }
    at = at + usize.ONE
  }
  return move copied
}

// Closed scalar native contracts retain memory/locality identity; the legacy noCapture hint creates
// no loan. A synchronous callbacks tuple, or a threadCallbacks tuple whose callbacks may run on
// another thread, must name every written C pointer parameter exactly once.
fn admittedForeignProperties(hir: &Module, properties: Range, parameters: Range) -> bool {
  if let Option<ForeignContract>.Some {..} = move NativeForeign.declarationContract(hir, properties) {
    return !hasCallbackParameter(hir, parameters)
  }
  let mut fields = usize.ZERO
  let mut callbacks = false
  let mut at = usize.ZERO
  while at < properties.length {
    if let Node.PropertyClause {namespace, operation, properties: written} = Module.node(hir, Module.child(hir, properties, at)) {
      if !nameIs(hir, namespace, b"Intrinsic") || !nameIs(hir, operation, b"foreign") { return false }
      let mut field = usize.ZERO
      while field < written.length {
        if let Node.Property {name, value} = Module.node(hir, Module.child(hir, written, field)) {
          if nameIs(hir, name, b"noCapture") {
            if !capturesPointerParameters(hir, value, parameters) { return false }
          } else if nameIs(hir, name, b"module") || nameIs(hir, name, b"name") {
            field = field + usize.ONE
            continue
          } else if nameIs(hir, name, b"callbacks") || nameIs(hir, name, b"threadCallbacks") {
            if callbacks || !capturesCallbackParameters(hir, value, parameters) { return false }
            callbacks = true
          } else { return false }
        } else {
          return false
        }
        fields = fields + usize.ONE
        field = field + usize.ONE
      }
    } else {
      return false
    }
    at = at + usize.ONE
  }
  return fields <= usize.ONE && (!hasCallbackParameter(hir, parameters) || callbacks)
}

// A callable header's admitted properties: none, or one field-free `Intrinsic.nonParking()`.
// On a service operation the property makes each call owe the NonParking proof for its selected
// witness (`operationNonParking`); the build proves it (SEM0139). Every other property is a gap.
fn nonParkingProperties(hir: &Module, properties: Range) -> bool {
  if properties.length == usize.ZERO { return true }
  if properties.length != usize.ONE { return false }
  if let Node.PropertyClause {namespace, operation, properties: written} = Module.node(hir, Module.child(hir, properties, usize.ZERO)) {
    return nameIs(hir, namespace, b"Intrinsic") && nameIs(hir, operation, b"nonParking") && written.length == usize.ZERO
  }
  return false
}

// A `module with ...` declaration's first property clause, rejected: no property applies to a
// module, so a clause outside the property vocabulary is unknown (SEM0235) and a known one, which
// describes a function, is misplaced (SEM0236). No clause is silently ignored.
effect fn modulePropertyRejection(resolver: &mut Resolver, module: &ModuleId, ordinal: usize) -> Option<Shared<Rejection>>
! Cycle | OutOfMemoryError ? &mut Allocator {
  let observed = run source(&mut resolver.*, module)
  let mut refused = Option<HeaderConflict>.none()
  if let Option<&IndexedSource>.Some {value} = move sourceOf(&resolver.*, &observed, module) {
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(value))
    let hir = IndexedSource.authored(value)
    if ordinal < declarations.length {
      if let Node.ModulePropertyHeader {properties} = Module.node(hir, declarations[ordinal].header) {
        if let Option<Span>.Some {value: clause} = move unknownProperty(hir, properties) {
          refused = conflictAt(RejectionCode.UnknownProperty, clause)
        } else if properties.length > usize.ZERO {
          refused = conflictAt(RejectionCode.MisplacedProperty, Module.span(hir, Module.child(hir, properties, usize.ZERO)))
        }
      }
    }
  }
  drop observed
  if let Option<HeaderConflict>.Some {value: conflict} = move refused {
    return Option<Shared<Rejection>>.some(run reject(&resolver.*, module, conflict.code, conflict.span))
  }
  return Option<Shared<Rejection>>.none()
}

// The span of the first `Intrinsic.foreign(...)` or `Intrinsic.machine(...)` header property
// clause, which describe an `extern` function only, on a declaration that has no foreign linkage
// (SEM0236). With `featuresAllowed`, an ordinary function's `Intrinsic.machine(features: ...)`
// clause is admitted (SIMD-009), and so is an inline clause, which only an ordinary function's
// body can honor; any other declaration's inline clause is misplaced.
fn misplacedProperty(hir: &Module, properties: Range, featuresAllowed: bool) -> Option<Span> {
  let mut at = usize.ZERO
  while at < properties.length {
    let clause = Module.child(hir, properties, at)
    if let Node.PropertyClause {namespace, operation, properties: written} = Module.node(hir, clause) {
      let features = featuresAllowed && nameIs(hir, operation, b"machine") && featuresOnly(hir, written)
      if nameIs(hir, namespace, b"Intrinsic") && (nameIs(hir, operation, b"foreign") || nameIs(hir, operation, b"machine")) && !features {
        return Option<Span>.some(Module.span(hir, clause))
      }
      if !featuresAllowed && nameIs(hir, namespace, b"Intrinsic") && inlineOperation(hir, operation) {
        return Option<Span>.some(Module.span(hir, clause))
      }
    }
    at = at + usize.ONE
  }
  return Option<Span>.none()
}

// Whether a property clause's fields are one or more `features:` entries and nothing else.
fn featuresOnly(hir: &Module, written: Range) -> bool {
  if written.length == usize.ZERO { return false }
  let mut field = usize.ZERO
  while field < written.length {
    if let Node.Property {name, ..} = Module.node(hir, Module.child(hir, written, field)) {
      if !nameIs(hir, name, b"features") { return false }
    } else {
      return false
    }
    field = field + usize.ONE
  }
  return true
}

// Whether an ordinary function's property clauses are all admitted: at most one field-free
// `Intrinsic.nonParking()`, at most one `Intrinsic.machine(features: ...)` (SIMD-009) and at most
// one field-free inline clause.
fn plainProperties(hir: &Module, properties: Range) -> bool {
  if nonParkingProperties(hir, properties) { return true }
  let mut parking = usize.ZERO
  let mut machine = usize.ZERO
  let mut inlining = usize.ZERO
  let mut at = usize.ZERO
  while at < properties.length {
    if let Node.PropertyClause {namespace, operation, properties: written} = Module.node(hir, Module.child(hir, properties, at)) {
      if !nameIs(hir, namespace, b"Intrinsic") { return false }
      if nameIs(hir, operation, b"nonParking") && written.length == usize.ZERO {
        parking = parking + usize.ONE
      } else if nameIs(hir, operation, b"machine") && featuresOnly(hir, written) {
        machine = machine + usize.ONE
      } else if inlineOperation(hir, operation) && written.length == usize.ZERO {
        inlining = inlining + usize.ONE
      } else {
        return false
      }
    } else {
      return false
    }
    at = at + usize.ONE
  }
  return parking <= usize.ONE && machine <= usize.ONE && inlining <= usize.ONE
}

// Whether a property clause's operation is `inline`, `inlineAlways` or `inlineNever`.
fn inlineOperation(hir: &Module, operation: HirId) -> bool {
  return nameIs(hir, operation, b"inline") || nameIs(hir, operation, b"inlineAlways") || nameIs(hir, operation, b"inlineNever")
}

// The span of the first `Intrinsic` inline clause among `properties`.
fn inlineClause(hir: &Module, properties: Range) -> Option<Span> {
  let mut at = usize.ZERO
  while at < properties.length {
    let clause = Module.child(hir, properties, at)
    if let Node.PropertyClause {namespace, operation, ..} = Module.node(hir, clause) {
      if nameIs(hir, namespace, b"Intrinsic") && inlineOperation(hir, operation) { return Option<Span>.some(Module.span(hir, clause)) }
    }
    at = at + usize.ONE
  }
  return Option<Span>.none()
}

// Whether a written parameter type is a callable or an `Effect`. Such a function, like `Effect.map`
// or `catchAll`, is mostly the call of its argument; inlining it lets the optimizer run that
// argument's code in place instead of through an out-of-line wrapper, so it asks for inlining
// unless an inline clause says otherwise.
fn takesCallable(hir: &Module, contract: HirId) -> bool {
  if let Node.CallableContract {parameters, ..} = Module.node(hir, contract) {
    let mut at = usize.ZERO
    while at < parameters.length {
      if let Node.Parameter {annotation, ..} = Module.node(hir, Module.child(hir, parameters, at)) {
        if callableParameterType(hir, annotation) { return true }
      }
      at = at + usize.ONE
    }
  }
  return false
}

fn callableParameterType(hir: &Module, annotation: HirId) -> bool {
  let mut named = annotation
  if let Node.AppliedType {target, ..} = Module.node(hir, annotation) { named = target }
  return match Module.node(hir, named) {
    Node.CallableType {..} => true
    Node.NamedType {path, ..} => match Module.node(hir, path) {
      Node.Path {segments} => segments.length == usize.ONE && nameIs(hir, Module.child(hir, segments, usize.ZERO), b"Effect")
      _ => nameIs(hir, path, b"Effect")
    }
    _ => false
  }
}

// Whether a declaration's body is at most two statements and none of them is a loop, such as
// `Effect.result` or `catchAll`: a wrapper that mostly runs its callable or `Effect` argument. Its
// failure path still carries observer events, so LLVM's size estimate keeps it out of line in a
// hot loop even with `inlinehint`, while inlining it costs about one call of its argument.
fn forwardingBody(hir: &Module, declaration: HirId) -> bool {
  if let Node.Declaration {body, ..} = Module.node(hir, declaration) {
    if let Node.CallableBody {block} = Module.node(hir, body) {
      if !block.present { return false }
      if let Node.Block {statements} = Module.node(hir, block.id) {
        if statements.length > 2 { return false }
        let mut at = usize.ZERO
        while at < statements.length {
          let looping = match Module.node(hir, Module.child(hir, statements, at)) {
            Node.WhileStatement {..} => true
            Node.StaticForStatement {..} => true
            _ => false
          }
          if looping { return false }
          at = at + usize.ONE
        }
        return true
      }
    }
  }
  return false
}

// How a declaration's inline clause asks its callers to inline it, a hint for a function that takes
// a callable or an `Effect` (always, for a forwarding wrapper), and `Default` for any other
// declaration.
effect fn declarationInlining(resolver: &mut Resolver, module: &ModuleId, ordinal: usize) -> MirInlining
! Cycle | OutOfMemoryError ? &mut Allocator {
  let answer = run observedDeclaration(&mut resolver.*, module, ordinal, SourceFacet.Header)
  let mut inlining = MirInlining.Default
  if let Option<&IndexedSource>.Some {value} = move sourceOf(&resolver.*, &answer, module) {
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(value))
    if ordinal < declarations.length {
      let hir = IndexedSource.authored(value)
      if let Node.FunctionHeader {properties, linkage, contract, ..} = Module.node(hir, declarations[ordinal].header) {
        if !linkage.present && takesCallable(hir, contract) {
          inlining = MirInlining.Hint
          if forwardingBody(hir, declarations[ordinal].local) { inlining = MirInlining.Always }
        }
        let mut at = usize.ZERO
        while !linkage.present && at < properties.length {
          if let Node.PropertyClause {namespace, operation, ..} = Module.node(hir, Module.child(hir, properties, at)) {
            if nameIs(hir, namespace, b"Intrinsic") {
              if nameIs(hir, operation, b"inline") { inlining = MirInlining.Hint }
              if nameIs(hir, operation, b"inlineAlways") { inlining = MirInlining.Always }
              if nameIs(hir, operation, b"inlineNever") { inlining = MirInlining.Never }
            }
          }
          at = at + usize.ONE
        }
      }
    }
  }
  return inlining
}

// The clause and value of the first `features:` entry of an `Intrinsic.machine(...)` clause.
fn featuresProperty(hir: &Module, properties: Range) -> Option<FeaturesProperty> {
  let mut at = usize.ZERO
  while at < properties.length {
    let clause = Module.child(hir, properties, at)
    if let Node.PropertyClause {namespace, operation, properties: written} = Module.node(hir, clause) {
      if nameIs(hir, namespace, b"Intrinsic") && nameIs(hir, operation, b"machine") {
        let mut field = usize.ZERO
        while field < written.length {
          if let Node.Property {name, value} = Module.node(hir, Module.child(hir, written, field)) {
            if nameIs(hir, name, b"features") {
              return Option<FeaturesProperty>.some(FeaturesProperty {clause: clause, value: value})
            }
          }
          field = field + usize.ONE
        }
      }
    }
    at = at + usize.ONE
  }
  return Option<FeaturesProperty>.none()
}

struct FeaturesProperty {
  clause: HirId,
  value: HirId,
}

// The entries of a `features:` value: a tuple of text literals, or one parenthesized literal.
// A non-literal entry is returned as its span in `invalid`, and so is an empty list, which `empty`
// marks.
effect fn featureEntries(hir: &Module, value: HirId) -> FeatureEntries ! OutOfMemoryError ? &mut Allocator {
  let mut names = List<Bytes>.make()
  let mut spans = List<Span>.make()
  let mut invalid = Option<Span>.none()
  let mut empty = false
  if let Node.UnitLiteral = Module.node(hir, value) {
    empty = true
    invalid = Option<Span>.some(Module.span(hir, value))
  } else if let Node.TupleExpression {elements} = Module.node(hir, value) {
    let mut at = usize.ZERO
    while at < elements.length {
      let element = Module.child(hir, elements, at)
      if let Node.TextLiteral {value: text} = Module.node(hir, element) {
        run List<Bytes>.append(&mut names, run Bytes.copy(Module.text(hir, text)))
        run List<Span>.append(&mut spans, Module.span(hir, element))
      } else if let Option<Span>.None = &invalid {
        invalid = Option<Span>.some(Module.span(hir, element))
      }
      at = at + usize.ONE
    }
    if elements.length == usize.ZERO {
      empty = true
      invalid = Option<Span>.some(Module.span(hir, value))
    }
  } else if let Node.TextLiteral {value: text} = Module.node(hir, value) {
    run List<Bytes>.append(&mut names, run Bytes.copy(Module.text(hir, text)))
    run List<Span>.append(&mut spans, Module.span(hir, value))
  } else {
    invalid = Option<Span>.some(Module.span(hir, value))
  }
  return FeatureEntries {names: move names, spans: move spans, invalid: move invalid, empty: empty}
}

struct FeatureEntries {
  names: List<Bytes>,
  spans: List<Span>,
  invalid: Option<Span>,
  empty: bool,
}

// The first conflict of a function's `features:` list: an empty list or an entry outside the
// target's catalog (SEM0242), a `static` function (SEM0236), or a function not declared `unsafe`
// (SEM0243).
effect fn featuresConflict(resolver: &Resolver, hir: &Module, property: &FeaturesProperty, isUnsafe: bool,
  isStatic: bool, name: &[u8], span: Span) -> Option<HeaderConflict> ! OutOfMemoryError ? &mut Allocator {
  let entries = run featureEntries(hir, property.value)
  if let Option<Span>.Some {value: invalid} = &entries.invalid {
    if entries.empty {
      let mut arguments = List<MessageArgument>.make()
      run List<MessageArgument>.append(&mut arguments, MessageArgument {name: run Bytes.copy(b"template"), value: run Bytes.copy(b"1")})
      run List<MessageArgument>.append(&mut arguments, MessageArgument {name: run Bytes.copy(b"target"), value: run Bytes.copy(resolver.target.name())})
      return Option<HeaderConflict>.some(HeaderConflict {code: RejectionCode.UnknownFunctionFeature, span: invalid, arguments: move arguments})
    }
    return run featureConflict(resolver, invalid, b"a non-literal entry")
  }
  let names = List<Bytes>.asSlice(&entries.names)
  let spans = List<Span>.asSlice(&entries.spans)
  let mut at = usize.ZERO
  while at < names.length {
    if !resolver.target.supportsFeature(Bytes.asSlice(&names[at])) {
      return run featureConflict(resolver, spans[at], Bytes.asSlice(&names[at]))
    }
    at = at + usize.ONE
  }
  if isStatic { return conflictAt(RejectionCode.MisplacedProperty, Module.span(hir, property.clause)) }
  if !isUnsafe { return run namedHeaderConflict(RejectionCode.FeatureFunctionRequiresUnsafe, span, b"name", name) }
  return Option<HeaderConflict>.none()
}

effect fn featureConflict(resolver: &Resolver, span: Span, feature: &[u8]) -> Option<HeaderConflict>
! OutOfMemoryError ? &mut Allocator {
  let mut arguments = List<MessageArgument>.make()
  run List<MessageArgument>.append(&mut arguments, MessageArgument {name: run Bytes.copy(b"template"), value: run Bytes.copy(b"0")})
  run List<MessageArgument>.append(&mut arguments, MessageArgument {name: run Bytes.copy(b"feature"), value: run Bytes.copy(feature)})
  run List<MessageArgument>.append(&mut arguments, MessageArgument {name: run Bytes.copy(b"target"), value: run Bytes.copy(resolver.target.name())})
  return Option<HeaderConflict>.some(HeaderConflict {code: RejectionCode.UnknownFunctionFeature, span: span, arguments: move arguments})
}

// The CPU features a declaration's `with Intrinsic.machine(features: ...)` clause lists, as
// written; empty for any other declaration (SIMD-009). Reads the header facet only.
effect fn declarationFeatures(resolver: &mut Resolver, module: &ModuleId, ordinal: usize) -> List<Bytes>
! Cycle | OutOfMemoryError ? &mut Allocator {
  let answer = run observedDeclaration(&mut resolver.*, module, ordinal, SourceFacet.Header)
  if let Option<&IndexedSource>.Some {value} = move sourceOf(&resolver.*, &answer, module) {
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(value))
    if ordinal < declarations.length {
      let hir = IndexedSource.authored(value)
      if let Node.FunctionHeader {properties, linkage, ..} = Module.node(hir, declarations[ordinal].header) {
        if !linkage.present {
          if let Option<FeaturesProperty>.Some {value: property} = move featuresProperty(hir, properties) {
            let entries = run featureEntries(hir, property.value)
            return move entries.names
          }
        }
      }
    }
  }
  return List<Bytes>.make()
}

// Whether enabling every feature of `listed` enables `feature`, through the transitive closure of
// the target's implications.
fn featureEnabled(target: &MachineTarget, listed: &[Bytes], feature: &[u8]) -> bool {
  let mut at = usize.ZERO
  while at < listed.length {
    if featureReaches(target, Bytes.asSlice(&listed[at]), feature, target.featureCount()) { return true }
    at = at + usize.ONE
  }
  return false
}

fn featureReaches(target: &MachineTarget, from: &[u8], to: &[u8], depth: usize) -> bool {
  if same(from, to) { return true }
  if depth == usize.ZERO { return false }
  let mut at = usize.ZERO
  while at < target.featureCount() {
    let next = target.feature(at)
    if target.implies(from, next) && featureReaches(target, next, to, depth - usize.ONE) { return true }
    at = at + usize.ONE
  }
  return false
}

// The LLVM `target-features` text of a function that lists `listed`: every catalog feature that
// the profile or the list's closure enables, as `+name` entries. Empty when nothing is listed.
effect fn featureAttribute(resolver: &Resolver, listed: &[Bytes]) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut text = Bytes.make()
  if listed.length == usize.ZERO { return move text }
  let mut at = usize.ZERO
  while at < resolver.target.featureCount() {
    let feature = resolver.target.feature(at)
    if profileFeature(resolver, feature) || featureEnabled(&resolver.target, listed, feature) {
      if Bytes.length(&text) > usize.ZERO { run Bytes.append(&mut text, b",") }
      run Bytes.append(&mut text, b"+")
      run Bytes.append(&mut text, feature)
    }
    at = at + usize.ONE
  }
  return move text
}

// The span of the first header property clause that is, or has an argument, outside the
// language's property vocabulary (SEM0235): `Intrinsic.foreign(memory:, locality:, noCapture:, callbacks:,
// threadCallbacks:)`,
// `Intrinsic.machine(naked:, noReturn:, features:)` and the argument-free `Intrinsic.nonParking()`,
// `Intrinsic.inline()`, `Intrinsic.inlineAlways()` and `Intrinsic.inlineNever()`. Whether
// a known property is admitted where it is written stays the position's own question.
fn unknownProperty(hir: &Module, properties: Range) -> Option<Span> {
  let mut at = usize.ZERO
  while at < properties.length {
    let clause = Module.child(hir, properties, at)
    if let Node.PropertyClause {namespace, operation, properties: written} = Module.node(hir, clause) {
      let foreign = nameIs(hir, operation, b"foreign")
      let machine = nameIs(hir, operation, b"machine")
      if !nameIs(hir, namespace, b"Intrinsic") || (!foreign && !machine && !nameIs(hir, operation, b"nonParking") && !inlineOperation(hir, operation)) {
        return Option<Span>.some(Module.span(hir, clause))
      }
      let mut field = usize.ZERO
      while field < written.length {
        if let Node.Property {name, ..} = Module.node(hir, Module.child(hir, written, field)) {
          let known = (foreign && (nameIs(hir, name, b"memory") || nameIs(hir, name, b"locality") || nameIs(hir, name, b"noCapture")
            || nameIs(hir, name, b"callbacks") || nameIs(hir, name, b"threadCallbacks") || nameIs(hir, name, b"module") || nameIs(hir, name, b"name"))) || (machine && (nameIs(hir, name, b"naked") || nameIs(hir, name, b"noReturn") || nameIs(hir, name, b"features")))
          if !known { return Option<Span>.some(Module.span(hir, clause)) }
        }
        field = field + usize.ONE
      }
    }
    at = at + usize.ONE
  }
  return Option<Span>.none()
}

fn nameIs(hir: &Module, id: HirId, spelling: &[u8]) -> bool {
  return match Module.node(hir, id) {
    Node.Name {text} => same(Module.text(hir, text), spelling)
    _ => false
  }
}

fn capturesPointerParameters(hir: &Module, value: HirId, parameters: Range) -> bool {
  if let Node.TupleExpression {elements} = Module.node(hir, value) {
    let mut at = usize.ZERO
    while at < elements.length {
      let element = Module.child(hir, elements, at)
      if let Node.TextLiteral {value: text} = Module.node(hir, element) {
        if !pointerParameterNamed(hir, parameters, Module.text(hir, text)) { return false }
        let mut earlier = usize.ZERO
        while earlier < at {
          if let Node.TextLiteral {value: previous} = Module.node(hir, Module.child(hir, elements, earlier)) {
            if same(Module.text(hir, previous), Module.text(hir, text)) { return false }
          }
          earlier = earlier + usize.ONE
        }
      } else {
        return false
      }
      at = at + usize.ONE
    }
    return true
  }
  return false
}

// The `callbacks` field naming every C function-pointer parameter, as `callbacks: ("compare",)`.
effect fn callbacksField(hir: &Module, parameters: Range) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut field = run Bytes.copy(b"callbacks: (")
  let mut count = usize.ZERO
  let mut at = usize.ZERO
  while at < parameters.length {
    if let Node.Parameter {name, annotation, ..} = Module.node(hir, Module.child(hir, parameters, at)) {
      if let Node.ForeignFunctionType {..} = Module.node(hir, annotation) {
        if let Node.Name {text} = Module.node(hir, name) {
          if count > usize.ZERO { run Bytes.append(&mut field, b", ") }
          run Bytes.append(&mut field, b"\"")
          run Bytes.append(&mut field, Module.text(hir, text))
          run Bytes.append(&mut field, b"\"")
          count = count + usize.ONE
        }
      }
    }
    at = at + usize.ONE
  }
  if count == usize.ONE { run Bytes.append(&mut field, b",") }
  run Bytes.append(&mut field, b")")
  return move field
}

fn hasCallbackParameter(hir: &Module, parameters: Range) -> bool {
  let mut at = usize.ZERO
  while at < parameters.length {
    if let Node.Parameter {annotation, ..} = Module.node(hir, Module.child(hir, parameters, at)) {
      if let Node.ForeignFunctionType {..} = Module.node(hir, annotation) { return true }
    }
    at = at + usize.ONE
  }
  return false
}

fn capturesCallbackParameters(hir: &Module, value: HirId, parameters: Range) -> bool {
  if let Node.TupleExpression {elements} = Module.node(hir, value) {
    let mut at = usize.ZERO
    while at < elements.length {
      let mut selected = false
      if let Node.TextLiteral {value: spelling} = Module.node(hir, Module.child(hir, elements, at)) {
        let mut parameter = usize.ZERO
        while parameter < parameters.length {
          if let Node.Parameter {name, annotation, ..} = Module.node(hir, Module.child(hir, parameters, parameter)) {
            if nameIs(hir, name, Module.text(hir, spelling)) {
              selected = true
            }
          }
          parameter = parameter + usize.ONE
        }
        let mut earlier = usize.ZERO
        while earlier < at {
          if let Node.TextLiteral {value: previous} = Module.node(hir, Module.child(hir, elements, earlier)) {
            if same(Module.text(hir, previous), Module.text(hir, spelling)) { return false }
          }
          earlier = earlier + usize.ONE
        }
      }
      if !selected { return false }
      at = at + usize.ONE
    }
    let mut parameter = usize.ZERO
    while parameter < parameters.length {
      if let Node.Parameter {name, annotation, ..} = Module.node(hir, Module.child(hir, parameters, parameter)) {
        if let Node.ForeignFunctionType {..} = Module.node(hir, annotation) {
          let mut listed = false
          let mut entry = usize.ZERO
          while entry < elements.length {
            if let Node.TextLiteral {value: spelling} = Module.node(hir, Module.child(hir, elements, entry)) {
              if nameIs(hir, name, Module.text(hir, spelling)) { listed = true }
            }
            entry = entry + usize.ONE
          }
          if !listed { return false }
        }
      }
      parameter = parameter + usize.ONE
    }
    return true
  }
  return false
}

fn pointerParameterNamed(hir: &Module, parameters: Range, spelling: &[u8]) -> bool {
  let mut at = usize.ZERO
  while at < parameters.length {
    if let Node.Parameter {name, annotation, ..} = Module.node(hir, Module.child(hir, parameters, at)) {
      if nameIs(hir, name, spelling) {
        return match Module.node(hir, annotation) {
          Node.PointerType {..} => true
          _ => false
        }
      }
    }
    at = at + usize.ONE
  }
  return false
}

effect fn normalizedNoCapture(hir: &Module, properties: Range, parameters: Range) -> List<usize>
! OutOfMemoryError ? &mut Allocator {
  let mut selected = List<usize>.make()
  let mut parameter = usize.ZERO
  while parameter < parameters.length {
    if let Node.Parameter {name, ..} = Module.node(hir, Module.child(hir, parameters, parameter)) {
      let mut retained = false
      let mut clause = usize.ZERO
      while clause < properties.length {
        if let Node.PropertyClause {properties: fields, ..} = Module.node(hir, Module.child(hir, properties, clause)) {
          let mut field = usize.ZERO
          while field < fields.length {
            if let Node.Property {name: property, value} = Module.node(hir, Module.child(hir, fields, field)) {
              if nameIs(hir, property, b"noCapture") {
                if let Node.TupleExpression {elements} = Module.node(hir, value) {
                  let mut entry = usize.ZERO
                  while entry < elements.length {
                    if let Node.TextLiteral {value: spelling} = Module.node(hir, Module.child(hir, elements, entry)) {
                      if nameIs(hir, name, Module.text(hir, spelling)) { retained = true }
                    }
                    entry = entry + usize.ONE
                  }
                }
              }
            }
            field = field + usize.ONE
          }
        }
        clause = clause + usize.ONE
      }
      if retained { run List<usize>.append(&mut selected, parameter) }
    }
    parameter = parameter + usize.ONE
  }
  return move selected
}

// Whether declaration `ordinal` of `module` is a function with C linkage, imported or exported.
effect fn linked(resolver: &mut Resolver, module: &ModuleId, ordinal: usize) -> bool
! Cycle | OutOfMemoryError ? &mut Allocator {
  let observed = run source(&mut resolver.*, module)
  if let Option<&IndexedSource>.Some {value} = move sourceOf(&resolver.*, &observed, module) {
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(value))
    let hir = IndexedSource.authored(value)
    if ordinal < declarations.length {
      if let Node.FunctionHeader {linkage, ..} = Module.node(hir, declarations[ordinal].header) {
        return linkage.present
      }
    }
  }
  return false
}

struct ForeignHeader {
  importModule: Bytes,
  importName: Bytes,
  behavior: ForeignContract,
  noCapture: List<usize>,
  symbol: Bytes,
  gap: Option<GapCode>,
  span: Span,
  /// Whether the linkage defines this declaration for C callers (`export`) rather than importing it.
  exported: bool,
  /// Whether the declaration is a C object (`static`) rather than a function.
  global: bool,
  /// The `callbacks` field a function with C function-pointer parameters needs when its
  /// properties do not name each of them once, as `callbacks: ("compare",)`; empty otherwise.
  callbacks: Bytes,
}

// Classifies one linked function or static header. A function import must be `unsafe`; an export
// is an ordinary definition whose C lanes are checked separately. Both admit only the C ABI, no
// generic, effect or static contract. Closed synchronous callback lanes retain their own C signatures. Variadic imports have fixed parameters
// followed by integer-only call-local tails. A static admits no
// linkage properties.
effect fn foreignHeader(resolver: &mut Resolver, module: &ModuleId, ordinal: usize) -> ForeignHeader
! Cycle | OutOfMemoryError ? &mut Allocator {
  let observed = run source(&mut resolver.*, module)
  if let Option<&IndexedSource>.Some {value} = move sourceOf(&resolver.*, &observed, module) {
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(value))
    let hir = IndexedSource.authored(value)
    if ordinal < declarations.length {
      let span = Module.span(hir, declarations[ordinal].header)
      if let Node.StaticHeader {name, linkage, properties, ..} = Module.node(hir, declarations[ordinal].header) {
        if let Node.Linkage {direction, abi, symbol} = Module.node(hir, linkage) {
          let mut symbolName = Bytes.make()
          if let Node.Name {text} = Module.node(hir, name) { symbolName = run Bytes.copy(Module.text(hir, text)) }
          if symbol.present {
            if let Node.TextLiteral {value: text} = Module.node(hir, symbol.id) { symbolName = run Bytes.copy(Module.text(hir, text)) }
          }
          let mut gap = Option<GapCode>.none()
          if properties.length > usize.ZERO { gap = Option<GapCode>.some(GapCode.ForeignContract) }
          let mut c = false
          if let Node.TextLiteral {value: text} = Module.node(hir, abi) { c = same(Module.text(hir, text), b"C") }
          if !c { gap = Option<GapCode>.some(GapCode.ForeignAbi) }
          return ForeignHeader {importModule: Bytes.make(), importName: Bytes.make(), behavior: ForeignContract.conservative(), noCapture: List<usize>.make(), symbol: move symbolName, gap: move gap, span: span, exported: direction == LinkageDirection.Export, global: true, callbacks: Bytes.make()}
        }
      }
      if let Node.FunctionHeader {name, contract, linkage, properties, ..} = Module.node(hir, declarations[ordinal].header) {
        if linkage.present {
          if let Node.Linkage {direction, abi, symbol} = Module.node(hir, linkage.id) {
            let exported = direction == LinkageDirection.Export
            let mut symbolName = Bytes.make()
            if let Node.Name {text} = Module.node(hir, name) { symbolName = run Bytes.copy(Module.text(hir, text)) }
            if symbol.present {
              if let Node.TextLiteral {value: text} = Module.node(hir, symbol.id) { symbolName = run Bytes.copy(Module.text(hir, text)) }
            }
            let mut gap = Option<GapCode>.none()
            let mut behavior = ForeignContract.conservative()
            let mut noCapture = List<usize>.make()
            let mut callbacks = Bytes.make()
            if let Option<ForeignContract>.Some {value: literalBehavior} = move NativeForeign.declarationContract(hir, properties) { behavior = literalBehavior }
            if let Node.CallableContract {variadic, generics, parameters, result, isEffect, isStatic, isUnsafe, ..} = Module.node(hir, contract) {
              noCapture = run normalizedNoCapture(hir, properties, parameters)
              if !admittedForeignProperties(hir, properties, parameters) {
                gap = Option<GapCode>.some(GapCode.ForeignContract)
                if hasCallbackParameter(hir, parameters) {
                  gap = Option<GapCode>.some(GapCode.CAbiCallback)
                  callbacks = run callbacksField(hir, parameters)
                }
              }
              // Returned function pointers still need a proved returned-callback contract.
              if result.present {
                if let Node.ForeignFunctionType {..} = Module.node(hir, result.id) { gap = Option<GapCode>.some(GapCode.CAbiCallback) }
              }
              if variadic && (exported || parameters.length == usize.ZERO) { gap = Option<GapCode>.some(GapCode.CAbiVariadic) }
              if variadic {
                if let Node.Declaration {body: definition, ..} = Module.node(hir, declarations[ordinal].local) {
                  if let Node.CallableBody {block} = Module.node(hir, definition) {
                    if block.present { gap = Option<GapCode>.some(GapCode.CAbiVariadic) }
                  }
                }
              }
              if exported && !isUnsafe {
                let asserted = NativeForeign.contract(hir, properties)
                match move asserted {
                  Option<ForeignContract>.Some {value: assertedBehavior} => {
                    if !ForeignContract.same(assertedBehavior, ForeignContract.conservative()) { gap = Option<GapCode>.some(GapCode.ForeignContract) }
                  }
                  Option<ForeignContract>.None => { if properties.length > usize.ZERO { gap = Option<GapCode>.some(GapCode.ForeignContract) } }
                }
              }
              if generics.length > usize.ZERO || isEffect || isStatic || (!isUnsafe && !exported) {
                gap = Option<GapCode>.some(GapCode.ForeignContract)
              }
            }
            let mut c = false
            if let Node.TextLiteral {value: text} = Module.node(hir, abi) { c = same(Module.text(hir, text), b"C") }
            if !c { gap = Option<GapCode>.some(GapCode.ForeignAbi) }
            let mut importModule = Bytes.make()
            let mut importName = Bytes.make()
            let mut modulePresent = false
            let mut namePresent = false
            let mut clause = usize.ZERO
            while clause < properties.length {
              if let Node.PropertyClause {properties: fields, ..} = Module.node(hir, Module.child(hir, properties, clause)) {
                let mut field = usize.ZERO
                while field < fields.length {
                  if let Node.Property {name: property, value: propertyValue} = Module.node(hir, Module.child(hir, fields, field)) {
                    let isModule = nameIs(hir, property, b"module")
                    let isName = nameIs(hir, property, b"name")
                    if isModule || isName {
                      if exported || !same(MachineTarget.objectFormat(&resolver.target), b"wasm") || (isModule && modulePresent) || (isName && namePresent) {
                        gap = Option<GapCode>.some(GapCode.ForeignContract)
                      }
                      if isModule { modulePresent = true } else { namePresent = true }
                      if let Node.TextLiteral {value: text} = Module.node(hir, propertyValue) {
                        let bytes = Module.text(hir, text)
                        if !NativeForeign.validWasmName(bytes) { gap = Option<GapCode>.some(GapCode.ForeignContract) }
                        if isModule { importModule = run Bytes.copy(bytes) } else { importName = run Bytes.copy(bytes) }
                      } else { gap = Option<GapCode>.some(GapCode.ForeignContract) }
                    }
                  }
                  field = field + usize.ONE
                }
              }
              clause = clause + usize.ONE
            }
            if namePresent && !modulePresent { gap = Option<GapCode>.some(GapCode.ForeignContract) }
            if modulePresent && !namePresent { importName = run Bytes.copy(Bytes.asSlice(&symbolName)) }
            return ForeignHeader {importModule: move importModule, importName: move importName, behavior: behavior, noCapture: move noCapture, symbol: move symbolName, gap: move gap, span: span, exported: exported, global: false, callbacks: move callbacks}
          }
        }
      }
    }
  }
  return ForeignHeader {importModule: Bytes.make(), importName: Bytes.make(), behavior: ForeignContract.conservative(), noCapture: List<usize>.make(), symbol: Bytes.make(), gap: Option<GapCode>.some(GapCode.ForeignAbi), span: Span.make(usize.ZERO, usize.ZERO), exported: false, global: false, callbacks: Bytes.make()}
}

fn backendUnit(layout: LayoutMetrics) -> bool {
  return match layout.abi { BackendAbi.Unit => true
    _ => false
  }
}

fn layoutIndex(answer: &Result<Answer, NoRejection>) -> Option<usize> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Layout {index}} => Option<usize>.some(index)
      _ => Option<usize>.none()
    }
    _ => Option<usize>.none()
  }
}

// Demand the complete representation tree before C classification. Every child demand remains
// a dependency of the foreign declaration, so edits to nested fields invalidate its ABI.
effect fn foreignLayouts(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, ty: &Shared<Type>, declaration: &Shared<DeclarationId>, span: Span,
  output: &mut TypeLayouts) -> ()
! BackendGap | Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let callable = run Type.copy(ty)
  if let Type.Callable {parameters, result, ..} = move callable {
    run foreignLayouts(&mut resolver.*, &mut owner.*, &mut dependencies.*, &result, declaration, span, &mut output.*)
    let listed = List<Shared<Type>>.asSlice(&parameters)
    let mut at = usize.ZERO
    while at < listed.length {
      run foreignLayouts(&mut resolver.*, &mut owner.*, &mut dependencies.*, &listed[at], declaration, span, &mut output.*)
      at = at + usize.ONE
    }
    return ()
  }
  if (run TypeLayouts.firstMatching(&output.*, ty)) != usize.MAX { return () }
  let vectorBits = Shared<Type>.with<usize>(ty, CAbi.vectorBits)
  if vectorBits != usize.ZERO {
    let passed = match move CAbi.vectorFeature(&resolver.target, vectorBits) {
      Option<&'static [u8]>.Some {value: feature} => profileFeature(&resolver.*, feature)
      Option<&'static [u8]>.None => false
    }
    if !passed { fail BackendGap.make(GapCode.CAbiVector, declaration, span) }
  }
  let application = run internErasedType(&mut resolver.*, ty)
  let request = Key {family: Family.Layout, module: usize.ZERO, name: application, declaration: usize.ZERO, member: usize.ZERO, external: false}
  let key = run internDeclaration(&mut resolver.*, request)
  let answer = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, key, span)
  let index = match move Shared<Result<Answer, NoRejection>>.with<Option<usize>>(&answer, layoutIndex) {
    Option<usize>.Some {value} => value
    _ => { fail BackendGap.make(GapCode.CAbiAggregate, declaration, span) }
  }
  let layouts = List<Shared<BackendLayout>>.asSlice(&resolver.layoutValues)
  let layout = Shared<BackendLayout>.clone(&layouts[index])
  run TypeLayouts.append(&mut output.*, TypeLayout {ty: Shared<Type>.clone(ty), layout: Shared<BackendLayout>.clone(&layout)})
  let count = Shared<BackendLayout>.with<usize>(&layout, BackendLayout.childCount)
  let mut at = usize.ZERO
  while at < count {
    let child = Shared<BackendLayout>.with<Option<Shared<Type>>>(&layout, fn(value: &BackendLayout) -> Option<Shared<Type>> {
      return BackendLayout.childAt(value, at)
    })
    if let Option<Shared<Type>>.Some {value} = move child {
      run foreignLayouts(&mut resolver.*, &mut owner.*, &mut dependencies.*, &value, declaration, span, &mut output.*)
    }
    at = at + usize.ONE
  }
  return ()
}

effect fn foreignLane(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, dependencies: &mut List<Dependency>, ty: &Shared<Type>, declaration: &Shared<DeclarationId>, span: Span, result: bool) -> CAbi.Lane
! BackendGap | Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  if !CAbi.supported(&resolver.target) { fail BackendGap.make(GapCode.CAbiTarget, declaration, span) }
  if Shared<Type>.with<bool>(ty, fn(value: &Type) -> bool {
    return match &value.* { Type.Callable {..} => true _ => false }
  }) { fail BackendGap.make(GapCode.CAbiCallback, declaration, span) }
  if !(run foreignAdmitted(&mut resolver.*, ty)) { fail BackendGap.make(GapCode.ForeignContract, declaration, span) }
  let mut layouts = TypeLayouts.make()
  run foreignLayouts(&mut resolver.*, &mut owner.*, &mut dependencies.*, ty, declaration, span, &mut layouts)
  if let Option<CAbi.Lane>.Some {value} = move run CAbi.classify(ty, &layouts, &resolver.target, result) { return move value }
  fail BackendGap.make(GapCode.CAbiAggregate, declaration, span)
}

effect fn copyMirExterns(resolver: &Resolver, index: usize) -> List<Shared<DeclarationId>> ! OutOfMemoryError ? &mut Allocator {
  let functions = List<MirFunction>.asSlice(&resolver.mirValues)
  let entries = List<Shared<DeclarationId>>.asSlice(&functions[index].externs)
  let mut copied = List<Shared<DeclarationId>>.make()
  let mut at = usize.ZERO
  while at < entries.length {
    run List<Shared<DeclarationId>>.append(&mut copied, Shared<DeclarationId>.clone(&entries[at]))
    at = at + usize.ONE
  }
  return move copied
}

effect fn foreignSignature(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  declaration: &Shared<DeclarationId>,
) -> CAbi.Signature
! BackendGap | Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  // The C allocator functions the storage primitives expand to have compiler-owned signatures.
  let sealed = Shared<DeclarationId>.with<Option<SealedFunction>>(declaration, SealedCore.declarationFunction)
  if let Option<SealedFunction>.Some {value: selected} = move sealed {
    let span = Span.make(usize.ZERO, usize.ZERO)
    let resultType = run SealedCore.cResult(selected)
    let result = run foreignLane(&mut resolver.*, &mut owner.*, &mut dependencies.*, &resultType, declaration, span, true)
    let written = run SealedCore.cParameters(selected)
    let listed = List<Shared<Type>>.asSlice(&written)
    let mut lanes = List<CAbi.Lane>.make()
    let mut at = usize.ZERO
    while at < listed.length {
      run List<CAbi.Lane>.append(&mut lanes, run foreignLane(&mut resolver.*, &mut owner.*, &mut dependencies.*, &listed[at],
        declaration, span, false))
      at = at + usize.ONE
    }
    return CAbi.Signature {importModule: Bytes.make(), importName: Bytes.make(), behavior: ForeignContract.conservative(), noCapture: List<usize>.make(), declaration: Shared<DeclarationId>.clone(declaration), symbol: run Bytes.copy(SealedCore.cSymbol(selected)),
      source: GapSource.Declaration {declaration: Shared<DeclarationId>.clone(declaration), span: span}, result: move result, parameters: move lanes, global: false, variadic: false}
  }
  let key = run InstanceKey.named(declaration)
  let found = run locationOfInstance(&mut resolver.*, &key)
  let location = match move found {
    Option<InstanceLocation>.Some {value} => value
    Option<InstanceLocation>.None => {
      fail BackendGap.make(GapCode.CalleeModule, declaration, Span.make(usize.ZERO, usize.ZERO))
    }
  }
  let module = resolvedModule(&resolver.*, location.module)
  let written = run foreignHeader(&mut resolver.*, &module, location.declaration)
  // A Silk call to an exported definition calls its C symbol, as an import of the same symbol
  // binds to the export.
  return run cSignature(&mut resolver.*, &mut owner.*, &mut dependencies.*, declaration, location, move written)
}

// Classifies the C lanes of one linked function whose header admitted the C contract.
fn nativeFunctionPointer(value: &Type) -> bool {
  return match &value.* { Type.ForeignFunction {..} => true _ => false }
}

// A callback that may run on another thread, after the call that received it has returned, takes
// no reference: no loan of the caller's could last until it runs.
fn referenceFreeCallback(value: &Type) -> bool {
  if let Type.ForeignFunction {signature, ..} = &value.* {
    return Shared<Type>.with<bool>(&signature, referenceFreeParameters)
  }
  return false
}

fn referenceFreeParameters(value: &Type) -> bool {
  if let Type.Callable {parameters, ..} = &value.* {
    let listed = List<Shared<Type>>.asSlice(&parameters)
    let mut at = usize.ZERO
    while at < listed.length {
      if Shared<Type>.with<bool>(&listed[at], borrowedLane) { return false }
      at = at + usize.ONE
    }
    return true
  }
  return false
}

fn borrowedLane(value: &Type) -> bool {
  return match &value.* { Type.Reference {..} => true Type.Slice {..} => true _ => false }
}

// Header spelling alone cannot identify aliased C pointer lanes. Authenticate the callback tuple
// again against the resolved C signature, including aliases and exact completeness. A thread
// tuple's callbacks must also be reference-free.
fn resolvedCallbackTuple(hir: &Module, value: HirId, parameters: Range, lanes: &[CAbi.Lane], thread: bool) -> bool {
  let mut count = usize.ZERO
  let mut at = usize.ZERO
  while at < lanes.length {
    if Shared<Type>.with<bool>(&lanes[at].ty, nativeFunctionPointer) { count = count + usize.ONE }
    at = at + usize.ONE
  }
  if let Node.TupleExpression {elements} = Module.node(hir, value) {
    if elements.length != count { return false }
    at = usize.ZERO
    while at < elements.length {
      let mut selected = false
      if let Node.TextLiteral {value: spelling} = Module.node(hir, Module.child(hir, elements, at)) {
        let mut parameter = usize.ZERO
        while parameter < parameters.length && parameter < lanes.length {
          if let Node.Parameter {name, ..} = Module.node(hir, Module.child(hir, parameters, parameter)) {
            if nameIs(hir, name, Module.text(hir, spelling)) {
              selected = Shared<Type>.with<bool>(&lanes[parameter].ty, nativeFunctionPointer)
              if thread && selected { selected = Shared<Type>.with<bool>(&lanes[parameter].ty, referenceFreeCallback) }
            }
          }
          parameter = parameter + usize.ONE
        }
      }
      if !selected { return false }
      at = at + usize.ONE
    }
    return true
  }
  return false
}

effect fn resolvedCallbackParameters(resolver: &mut Resolver, location: InstanceLocation, lanes: &[CAbi.Lane]) -> bool
! Cycle | OutOfMemoryError ? &mut Allocator {
  let module = resolvedModule(&resolver.*, location.module)
  let observed = run source(&mut resolver.*, &module)
  if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(&resolver.*, &observed, &module) {
    let hir = IndexedSource.authored(indexed)
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(indexed))
    if let Node.FunctionHeader {contract, properties, ..} = Module.node(hir, declarations[location.declaration].header) {
      if let Node.CallableContract {parameters, ..} = Module.node(hir, contract) {
        let mut clause = usize.ZERO
        while clause < properties.length {
          if let Node.PropertyClause {properties: fields, ..} = Module.node(hir, Module.child(hir, properties, clause)) {
            let mut field = usize.ZERO
            while field < fields.length {
              if let Node.Property {name, value} = Module.node(hir, Module.child(hir, fields, field)) {
                if nameIs(hir, name, b"callbacks") { return resolvedCallbackTuple(hir, value, parameters, lanes, false) }
                if nameIs(hir, name, b"threadCallbacks") { return resolvedCallbackTuple(hir, value, parameters, lanes, true) }
              }
              field = field + usize.ONE
            }
          }
          clause = clause + usize.ONE
        }
      }
    }
  }
  let mut at = usize.ZERO
  while at < lanes.length {
    if Shared<Type>.with<bool>(&lanes[at].ty, nativeFunctionPointer) { return false }
    at = at + usize.ONE
  }
  return true
}

effect fn cSignature(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  declaration: &Shared<DeclarationId>,
  location: InstanceLocation,
  written: ForeignHeader,
) -> CAbi.Signature
! BackendGap | Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  if let Option<GapCode>.Some {value} = move written.gap {
    fail BackendGap.make(value, declaration, written.span)
  }
  if written.global {
    if !CAbi.fullBoundary(&resolver.target) { fail BackendGap.make(GapCode.CAbiTarget, declaration, written.span) }
    // A C object has one lane: the value its address holds.
    let selected = run foreignStaticType(&mut resolver.*, &mut owner.*, &mut dependencies.*, location.module, location.declaration, written.span)
    let objectType = match move selected {
      Result<Shared<Type>, Shared<Rejection>>.Success {value} => move value
      Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { fail BackendGap.fromRejection(GapCode.ForeignStatic, declaration, &error) }
    }
    let object = run foreignLane(&mut resolver.*, &mut owner.*, &mut dependencies.*, &objectType, declaration, written.span, true)
    return CAbi.Signature {
      importModule: Bytes.make(), importName: Bytes.make(),
      behavior: ForeignContract.conservative(), noCapture: List<usize>.make(),
      declaration: Shared<DeclarationId>.clone(declaration),
      symbol: move written.symbol,
      source: GapSource.Declaration {declaration: Shared<DeclarationId>.clone(declaration), span: written.span},
      result: move object,
      parameters: List<CAbi.Lane>.make(),
      global: true,
      variadic: false,
    }
  }
  let declarationAccess197Request = Key {
      family: Family.Signature,
      module: location.module,
      name: usize.ZERO,
      declaration: location.declaration,
      member: usize.ZERO,
      external: false,
    }
  let declarationAccess197 = run internDeclaration(&mut resolver.*, declarationAccess197Request)
  let signature = run demandChild(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies.*,
    declarationAccess197,
    written.span,
  )
  let selected = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(
    &signature,
    signatureResult,
  )
  let resultType = match move selected {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => {
      fail BackendGap.make(GapCode.SignatureForm, declaration, written.span)
    }
  }
  if Shared<Type>.with<bool>(&resultType, nativeFunctionPointer) {
    fail BackendGap.make(GapCode.CAbiCallback, declaration, written.span)
  }
  let result = run foreignLane(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies.*,
    &resultType,
    declaration,
    written.span,
    true,
  )
  let mut parameters = List<CAbi.Lane>.make()
  let count = Shared<Result<Answer, NoRejection>>.with<usize>(&signature, signatureParameterCount)
  let mut at = usize.ZERO
  while at < count {
    let selected = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(
      &signature,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> {
        return signatureParameterAt(answer, at)
      },
    )
    if let Option<Shared<Type>>.Some {value} = move selected {
      let lane = run foreignLane(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies.*,
        &value,
        declaration,
        written.span,
        false,
      )
      if backendUnit(lane.layout) {
        fail BackendGap.make(GapCode.UnitParameter, declaration, written.span)
      }
      run List<CAbi.Lane>.append(&mut parameters, move lane)
    }
    at = at + usize.ONE
  }
  CAbi.assignArguments(&mut parameters, &result, &resolver.target)
  let callbacksComplete = run resolvedCallbackParameters(&mut resolver.*, location, List<CAbi.Lane>.asSlice(&parameters))
  if !callbacksComplete { fail BackendGap.make(GapCode.CAbiCallback, declaration, written.span) }
  let variadic = Shared<Result<Answer, NoRejection>>.with<bool>(&signature, signatureIsVariadic)
  if variadic && !CAbi.fullBoundary(&resolver.target) { fail BackendGap.make(GapCode.CAbiTarget, declaration, written.span) }
  return CAbi.Signature {
    importModule: move written.importModule, importName: move written.importName,
    behavior: written.behavior, noCapture: move written.noCapture,
    declaration: Shared<DeclarationId>.clone(declaration),
    symbol: move written.symbol,
    source: GapSource.Declaration {declaration: Shared<DeclarationId>.clone(declaration), span: written.span},
    result: move result,
    parameters: move parameters,
    global: false,
    variadic: variadic,
  }
}

struct EmissionInputs {
  mir: usize,
  layouts: List<TypeLayout>,
  foreign: List<CAbi.Signature>,
  llvm: usize,
  /// The instance's own canonical encoding, kept for its definition; callee encodings are content
  /// input only.
  encoding: Bytes,
  identities: List<InstanceIdentity>,
  /// The facts of a suspendable instance, which make its definition a coroutine.
  suspension: Option<CoroutineFacts>,
  /// The anchor the instance's MIR origins count from, which positions an emission gap. It is not
  /// content: a gap's text consumes this preparation, so a moved declaration retries the gap.
  anchor: Option<Anchor>,
}

// Content subjects retain the latest validated preparation. Successful text answers are immutable;
// a gap's text consumes its producing unit, so a retry after an edit uses current origins. In a revisable store a
// subject is named by the 128-bit content hash of its exact content encoding; the encoding itself is
// not retained, and that one hash also supplies the subject's lookup word. A one-shot store never revises,
// so no later demand brings equal content back: its subjects carry no digest.
struct LlvmInput {
  digest: Option<ContentHash>,
  emission: usize,
  dependencies: List<Dependency>,
  // The EmissionInputs unit that last prepared this subject. A gap in its text is retried after
  // that unit reruns, since the gap's origins come from its preparation.
  producer: usize,
}

fn layoutDemandAt(types: &List<LayoutDemand>, index: usize) -> LayoutDemand {
  let entries = List<LayoutDemand>.asSlice(types)
  return LayoutDemand {ty: Shared<Type>.clone(&entries[index].ty), span: entries[index].span}
}

effect fn copyEmissionDependencies(values: &[Dependency]) -> List<Dependency>
! OutOfMemoryError
? &mut Allocator {
  let mut result = List<Dependency>.make()
  run List<Dependency>.reserveExact(&mut result, values.length)
  let mut at = usize.ZERO
  while at < values.length {
    run List<Dependency>.append(&mut result, values[at])
    at = at + usize.ONE
  }
  return move result
}

effect fn appendSignatureContent(
  output: &mut Bytes,
  signature: &Shared<Result<Answer, NoRejection>>,
  declaration: &DeclarationId,
  coordinates: &mut Coordinates,
) -> () ! OutOfMemoryError ? &mut Allocator {
  let count = Shared<Result<Answer, NoRejection>>.with<usize>(signature, signatureParameterCount)
  run RuntimeEncoding.word(&mut output.*, usize.toU64(count))
  let mut at = usize.ZERO
  while at < count {
    let selected = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(
      signature,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> {
        return signatureParameterAt(answer, at)
      },
    )
    if let Option<Shared<Type>>.Some {value} = move selected {
      let encoded = run Type.encoding(&value, declaration, true, &mut coordinates.*)
      run RuntimeEncoding.field(&mut output.*, Bytes.asSlice(&encoded))
    }
    at = at + usize.ONE
  }
  let selected = Shared<Result<Answer, NoRejection>>.with<Option<SignatureFacts>>(
    signature,
    signatureFacts,
  )
  if let Option<SignatureFacts>.Some {value: facts} = move selected {
    let result = run Type.encoding(&facts.result, declaration, true, &mut coordinates.*)
    let failure = run Type.encoding(&facts.failure, declaration, true, &mut coordinates.*)
    let required = run Row.encoding(&facts.requirements, declaration, true, &mut coordinates.*)
    run RuntimeEncoding.field(&mut output.*, Bytes.asSlice(&result))
    run RuntimeEncoding.field(&mut output.*, Bytes.asSlice(&failure))
    run RuntimeEncoding.field(&mut output.*, Bytes.asSlice(&required))
  }
  return ()
}

// Read headers and signature answers only. This terminates for recursive instance references.
effect fn emissionSignatureContent(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  callees: &[InstanceKey],
  coordinates: &mut Coordinates,
) -> Bytes ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut result = Bytes.make()
  let mut at = usize.ZERO
  while at < callees.length {
    if let InstanceKey.Function {..} = &callees[at] {
      let located = run locationOfInstance(&mut resolver.*, &callees[at])
      if let Option<InstanceLocation>.Some {value: location} = move located {
        let declarationAccess198Request = Key {
            family: Family.Signature,
            module: location.module,
            name: usize.ZERO,
            declaration: location.declaration,
            member: usize.ZERO,
            external: false,
          }
        let declarationAccess198 = run internDeclaration(&mut resolver.*, declarationAccess198Request)
        let signature = run demandChild(
          &mut resolver.*,
          &mut owner.*,
          &mut dependencies.*,
          declarationAccess198,
          Span.make(usize.ZERO, usize.ZERO),
        )
        let identityHandle = InstanceKey.identity(&callees[at])
        let identity = DeclarationId.copyShared(&identityHandle)
        run appendSignatureContent(&mut result, &signature, &identity, &mut coordinates.*)
        // Header syntax also covers written binders, bounds, static slots and Effect channels.
        // Loading the source still records its dependency when the fingerprint is cached, and when
        // a one-shot build, which never digests the content, skips the fingerprint.
        let mut fresh = Option<HeaderFingerprint>.none()
        let module = resolvedModule(&resolver.*, location.module)
        let mut fingerprintIndex = usize.MAX
        if recording(&resolver.*) {
          let rawKey = Key {family: Family.Identity, module: location.module, name: usize.ZERO,
            declaration: location.declaration, member: usize.ZERO, external: false}
          let stableKey = run internDeclaration(&mut resolver.*, rawKey)
          fingerprintIndex = stableKey.declaration
        }
        let loaded = run source(&mut resolver.*, &module)
        if recording(&resolver.*) {
          if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(
            &resolver.*,
            &loaded,
            &module,
          ) {
            let index = IndexedSource.moduleIndex(indexed)
            let revision = ModuleIndex.sourceRevision(index)
            let known = cachedHeader(&resolver.*, location.module, fingerprintIndex, revision)
            if known != usize.MAX {
              let cached = List<HeaderFingerprint>.asSlice(&resolver.headerFingerprints)
              run RuntimeEncoding.field(&mut result, List<u8>.asSlice(&cached[known].bytes))
            } else {
              let declarations = ModuleIndex.listDeclarations(index)
              let bytes = run Fingerprint.header(
                IndexedSource.authored(indexed),
                declarations[location.declaration].header,
              )
              run RuntimeEncoding.field(&mut result, List<u8>.asSlice(&bytes))
              fresh = Option<HeaderFingerprint>.some(HeaderFingerprint {
                module: location.module, index: fingerprintIndex, revision: revision, bytes: move bytes,
              })
            }
          }
        }
        if let Option<HeaderFingerprint>.Some {value: entry} = move fresh {
          run List<HeaderFingerprint>.append(&mut resolver.headerFingerprints, move entry)
          run InternIndex.record(&mut resolver.headerFingerprintLookup, headerKey(location.module, fingerprintIndex))
        }
      }
    }
    at = at + usize.ONE
  }
  return move result
}

// One callee declaration's header fingerprint, valid for the source revision it was read from.
struct HeaderFingerprint {
  module: usize,
  index: usize,
  revision: usize,
  bytes: List<u8>,
}

fn headerKey(module: usize, index: usize) -> u64 {
  return Hash.combine(Hash.mix(&Hash.seed(0), usize.toU64(module)), usize.toU64(index))
}

// The cached fingerprint of the declaration at `location` read from `revision`, or `usize.MAX`.
fn cachedHeader(resolver: &Resolver, module: usize, index: usize, revision: usize) -> usize {
  let cached = List<HeaderFingerprint>.asSlice(&resolver.headerFingerprints)
  let mut at = InternIndex.first(&resolver.headerFingerprintLookup, headerKey(module, index))
  while at != usize.MAX {
    if cached[at].module == module && cached[at].index == index && cached[at].revision == revision {
      return at
    }
    at = InternIndex.after(&resolver.headerFingerprintLookup, at)
  }
  return usize.MAX
}

// Whether an interned subject is named by `digest`. Only a revisable store interns, so every
// subject it looks up carries a digest.
fn namedBy(stored: &Option<ContentHash>, digest: ContentHash) -> bool {
  return match &stored.* {
    Option<ContentHash>.Some {value} => ContentHash.equals(value, digest)
    Option<ContentHash>.None => false
  }
}

// `identity` is the content digest a revisable build records, and none in a one-shot build.
effect fn internLlvmInput(
  resolver: &mut Resolver,
  emission: usize,
  identity: Option<ContentHash>,
  dependencies: &[Dependency],
) -> usize ! OutOfMemoryError ? &mut Allocator {
  // The running EmissionInputs unit prepared this subject.
  let producer = u64.toUsize(List<Word>.get(&resolver.active, List<Word>.length(&resolver.active) - usize.ONE).value)
  let copied = run copyEmissionDependencies(dependencies)
  // Interning only serves a later revision that re-demands equal content (AGENTS.md one-shot rule).
  let mut at = usize.MAX
  if let Option<ContentHash>.Some {value: digest} = &identity {
    let inputs = List<LlvmInput>.asSlice(&resolver.llvmInputs)
    at = InternIndex.first(&resolver.llvmInputLookup, digest.low)
    while at != usize.MAX {
      if namedBy(&inputs[at].digest, digest) {
        break
      }
      at = InternIndex.after(&resolver.llvmInputLookup, at)
    }
  }
  if at != usize.MAX {
    // Equal successful content keeps its completed answer. A source-validated gap retries
    // with the latest origins and dependency evidence after an edit.
    let current = List<LlvmInput>.asMutSlice(&mut resolver.llvmInputs)
    current[at].emission = emission
    current[at].dependencies = move copied
    current[at].producer = producer
  } else {
    at = List<LlvmInput>.length(&resolver.llvmInputs)
    // A store records every subject or none, so lookup entries stay aligned with subjects.
    if let Option<ContentHash>.Some {value: digest} = &identity {
      run InternIndex.record(&mut resolver.llvmInputLookup, digest.low)
    }
    run List<LlvmInput>.append(
      &mut resolver.llvmInputs,
      LlvmInput {
        digest: move identity,
        emission: emission,
        dependencies: move copied,
        producer: producer,
      },
    )
  }
  return at
}

effect fn observeLlvmGap(resolver: &mut Resolver, subject: usize) -> ()
! OutOfMemoryError
? &mut Allocator {
  let producer = List<LlvmInput>.asSlice(&resolver.llvmInputs)[subject].producer
  let unit = u64.toUsize(List<Word>.get(&resolver.active, List<Word>.length(&resolver.active) - usize.ONE).value)
  return run Graph.record(&mut resolver.graph, unit, Dependee.UnitResult {unit: producer})
}

// Pure query over a complete immutable content subject. Its dependency ledger records the
// prepared MIR/layout/signature facts; its validity follows from content, not source revisions.
effect fn resolveLlvmText(resolver: &mut Resolver, key: Key) -> Answer
! OutOfMemoryError
? &mut Allocator | &mut Types {
  let subjects = List<LlvmInput>.asSlice(&resolver.llvmInputs)
  let subject = &subjects[key.name]
  let inputs = List<EmissionInputs>.asSlice(&resolver.emissionInputs)
  let input = &inputs[subject.emission]
  let functions = List<MirFunction>.asSlice(&resolver.mirValues)
  let function = &functions[input.mir]
  let dependencies = run copyEmissionDependencies(List<Dependency>.asSlice(&subject.dependencies))
  let emitted = run Effect.result(
    LlvmCode.emit(
      function,
      &resolver.target,
      List<TypeLayout>.asSlice(&input.layouts),
      List<CAbi.Signature>.asSlice(&input.foreign),
      List<InstanceIdentity>.asSlice(&input.identities),
      &input.suspension,
      resolver.fastPathIr,
    ),
  )
  let text = match move emitted {
    Result<Bytes, BackendGap | OutOfMemoryError>.Success {value} => move value
    Result<Bytes, BackendGap | OutOfMemoryError>.Failure {error} => match move error {
      BackendGap {code, owner, source} => {
        let raised = BackendGap {code: code, owner: move owner, source: move source}
        let placed = match &input.anchor {
          Option<Anchor>.Some {value: anchor} => BackendGap.anchored(move raised, &anchor)
          Option<Anchor>.None => move raised
        }
        let gap = run Shared<BackendGap>.make(move placed)
        run observeLlvmGap(&mut resolver.*, key.name)
        return memberSuccess(Value.Unsupported {gap: move gap}, move dependencies)
      }
      OutOfMemoryError {} => {
        fail OutOfMemoryError {}
      }
    }
  }
  let foreign = run Effect.result(
    LlvmCode.foreignDeclarations(List<CAbi.Signature>.asSlice(&input.foreign)),
  )
  let declarations = match move foreign {
    Result<List<LlvmCode.Declaration>, BackendGap | OutOfMemoryError>.Success {value} => move value
    Result<List<LlvmCode.Declaration>, BackendGap | OutOfMemoryError>.Failure {error} => match move error {
      BackendGap {code, owner, source} => {
        let gap = run Shared<BackendGap>.make(
          BackendGap {code: code, owner: move owner, source: move source},
        )
        run observeLlvmGap(&mut resolver.*, key.name)
        return memberSuccess(Value.Unsupported {gap: move gap}, move dependencies)
      }
      OutOfMemoryError {} => {
        fail OutOfMemoryError {}
      }
    }
  }
  let identities = List<InstanceIdentity>.asSlice(&input.identities)
  // Emission compares identities only for equality, so a definition keeps a digest of its
  // identity's encoding, which is all a cache image holds of it.
  let value = InstanceDefinition {
    encoding: run digestBytes(recordDigest(Bytes.asSlice(&input.encoding))),
    symbol: run Bytes.copy(Bytes.asSlice(&identities[usize.ZERO].symbol)),
    text: move text,
    foreign: move declarations,
    borrow: function.borrow,
  }
  let index = List<InstanceDefinition>.length(&resolver.llvmValues)
  run List<InstanceDefinition>.append(&mut resolver.llvmValues, move value)
  return memberSuccess(Value.LlvmText {index: index}, move dependencies)
}

effect fn demandPreparedText(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  key: Key,
  prepared: &Shared<Result<Answer, NoRejection>>,
) -> Shared<Result<Answer, NoRejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let index = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(
    prepared,
    answerEmissionInputsIndex,
  )
  if let Option<usize>.Some {value} = move index {
    let inputs = List<EmissionInputs>.asSlice(&resolver.emissionInputs)
    let content = inputs[value].llvm
    return run demandRaw(
      &mut resolver.*,
      &mut owner.*,
      Key {
        family: Family.LlvmText,
        module: key.module,
        name: content,
        declaration: key.declaration,
        member: key.member,
        external: false,
      },
      Span.make(usize.ZERO, usize.ZERO),
    )
  }
  return Shared<Result<Answer, NoRejection>>.clone(prepared)
}

effect fn resolveEmissionInputs(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  key: Key,
) -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let module = resolvedModule(&resolver.*, key.module)
  let mut dependencies = List<Dependency>.make()
  let variants = List<BackendInstance>.asSlice(&resolver.backendInstances)
  let variantKey = InstanceKey.copy(&variants[key.name].key)
  let variantObserving = variants[key.name].observing
  let suspension = run copySuspension(&variants[key.name].suspension)
  // A suspendable instance emits its frame variant's MIR, which carries the cancel exits.
  let mut lowered = key.name
  if let Option<CoroutineFacts>.None = &suspension {
    lowered = run exactBackendVariant(&mut resolver.*, &variantKey, variantObserving, &Option<CoroutineFacts>.none())
  }
  let mir = run demandChild(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies,
    Key {
      family: Family.Mir,
      module: key.module,
      name: lowered,
      declaration: key.declaration,
      member: key.member,
      external: false,
    },
    Span.make(usize.ZERO, usize.ZERO),
  )
  let canonicalFailure = Shared<Result<Answer, NoRejection>>.with<Option<CanonicalizationFailure>>(&mir, answerCanonicalizationFailure)
  if let Option<CanonicalizationFailure>.Some {value: reason} = move canonicalFailure {
    return memberSuccess(Value.CanonicalizationFailed {reason: reason}, move dependencies)
  }
  let rejected = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(
    &mir,
    answerCause,
  )
  if let Option<Shared<Rejection>>.Some {value} = move rejected {
    return run memberRejected(move value, move dependencies)
  }
  let gap = Shared<Result<Answer, NoRejection>>.with<Option<Shared<BackendGap>>>(
    &mir,
    answerBackendGap,
  )
  if let Option<Shared<BackendGap>>.Some {value} = move gap {
    return memberSuccess(Value.Unsupported {gap: move value}, move dependencies)
  }
  let selected = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(&mir, answerMirIndex)
  let mirIndex = match move selected {
    Option<usize>.Some {value} => value
    Option<usize>.None => {
      return run memberRejected(
        run reject(
          &resolver.*,
          &module,
          RejectionCode.Unsupported,
          Span.make(usize.ZERO, usize.ZERO),
        ),
        move dependencies,
      )
    }
  }
  let externs = run copyMirExterns(&resolver.*, mirIndex)
  let entries = List<Shared<DeclarationId>>.asSlice(&externs)
  let mut foreign = List<CAbi.Signature>.make()
  let mut foreignAt = usize.ZERO
  while foreignAt < entries.length {
    let classified = run Effect.result(foreignSignature(&mut resolver.*, &mut owner.*, &mut dependencies, &entries[foreignAt]))
    match move classified {
      Result<CAbi.Signature, BackendGap | Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError>.Success {value} => { run List<CAbi.Signature>.append(&mut foreign, move value) }
      Result<CAbi.Signature, BackendGap | Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError>.Failure {error} => match move error {
        BackendGap {code, owner: gapOwner, source} => { return memberSuccess(Value.Unsupported {gap: run Shared<BackendGap>.make(BackendGap {code: code, owner: move gapOwner, source: move source})}, move dependencies) }
        Cycle {} => { fail Cycle {} }
        InvalidModulePath {} => { fail InvalidModulePath {} }
        RevisionMismatch {} => { fail RevisionMismatch {} }
        OutOfMemoryError {} => { fail OutOfMemoryError {} }
      }
    }
    foreignAt = foreignAt + usize.ONE
  }
  // Layout demand spans and emission gaps name positions in the instance's current source.
  let anchor = run instanceAnchor(&mut resolver.*, &variantKey)
  let cValues = run copyMirCValues(&resolver.*, mirIndex, &anchor)
  let cTypes = List<LayoutDemand>.asSlice(&cValues)
  let cDeclaration = InstanceKey.identity(&variantKey)
  let mut cLayouts = TypeLayouts.make()
  let mut cAt = usize.ZERO
  while cAt < cTypes.length {
    let validated = run Effect.result(foreignLayouts(&mut resolver.*, &mut owner.*, &mut dependencies,
      &cTypes[cAt].ty, &cDeclaration, cTypes[cAt].span, &mut cLayouts))
    if let Result<(), BackendGap | Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError>.Failure {error} = move validated {
      match move error {
        BackendGap {code, owner: gapOwner, source} => { return memberSuccess(Value.Unsupported {gap: run Shared<BackendGap>.make(BackendGap {code: code, owner: move gapOwner, source: move source})}, move dependencies) }
        Cycle {} => { fail Cycle {} }
        InvalidModulePath {} => { fail InvalidModulePath {} }
        RevisionMismatch {} => { fail RevisionMismatch {} }
        OutOfMemoryError {} => { fail OutOfMemoryError {} }
      }
    }
    cAt = cAt + usize.ONE
  }
  let mut types = run copyMirLocalTypes(&resolver.*, mirIndex, &anchor)
  let mut layouts = List<TypeLayout>.make()
  // Content indices of the supplied layouts, in supply order.
  let mut contentIndices = List<usize>.make()
  let layoutDeclaration = InstanceKey.identity(&variantKey)
  let layoutOwner = DeclarationId.copyShared(&layoutDeclaration)
  // Interned layout ordinals already supplied; each entry is keyed by its own ordinal.
  let mut supplied = InternIndex.make()
  let mut at = usize.ZERO
  while at < List<LayoutDemand>.length(&types) {
    let needed = layoutDemandAt(&types, at)
    let application = run internErasedType(&mut resolver.*, &needed.ty)
    if InternIndex.first(&supplied, usize.toU64(application)) != usize.MAX {
      at = at + usize.ONE
      continue
    }
    let declarationAccess199Request = Key {
        family: Family.Layout,
        module: key.module,
        name: application,
        declaration: usize.ZERO,
        member: usize.ZERO,
        external: false,
      }
    let declarationAccess199 = run internDeclaration(&mut resolver.*, declarationAccess199Request)
    let layout = run demandChild(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies,
      declarationAccess199,
      needed.span,
    )
    let layoutUnsupported = Shared<Result<Answer, NoRejection>>.with<bool>(
      &layout,
      answerLayoutUnsupported,
    )
    if layoutUnsupported {
      let functions = List<MirFunction>.asSlice(&resolver.mirValues)
      let identity = InstanceKey.identity(&functions[mirIndex].key)
      let mut code = GapCode.ScalarLayout
      if Shared<Type>.with<bool>(
        &needed.ty,
        fn(value: &Type) -> bool {
          return match & value.* {
            Type.Slice {..} => true
            _ => false
          }
        },
      ) {
        code = GapCode.SliceLayout
      }
      return memberSuccess(
        Value.Unsupported {
          gap: run Shared<BackendGap>.make(BackendGap.make(code, &identity, needed.span)),
        },
        move dependencies,
      )
    }
    let layoutFailure = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(
      &layout,
      answerCause,
    )
    if let Option<Shared<Rejection>>.Some {value} = move layoutFailure {
      return run memberRejected(move value, move dependencies)
    }
    let selectedLayout = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(
      &layout,
      answerLayoutIndex,
    )
    let layoutIndex = match move selectedLayout {
      Option<usize>.Some {value} => value
      Option<usize>.None => {
        return run memberRejected(
          run reject(&resolver.*, &module, RejectionCode.Unsupported, needed.span),
          move dependencies,
        )
      }
    }
    let resolvedLayouts = List<Shared<BackendLayout>>.asSlice(&resolver.layoutValues)
    let facts = Shared<BackendLayout>.clone(&resolvedLayouts[layoutIndex])
    let typeLayout = TypeLayout {ty: Shared<Type>.clone(&needed.ty), layout: Shared<BackendLayout>.clone(&facts)}
    run List<usize>.append(&mut contentIndices, layoutIndex)
    run List<TypeLayout>.append(&mut layouts, move typeLayout)
    run InternIndex.record(&mut supplied, usize.toU64(application))
    let count = Shared<BackendLayout>.with<usize>(&facts, BackendLayout.childCount)
    let mut fieldAt = usize.ZERO
    while fieldAt < count {
      let selectedField = Shared<BackendLayout>.with<Option<Shared<Type>>>(&facts,
        fn(layout: &BackendLayout) -> Option<Shared<Type>> {
          return BackendLayout.childAt(layout, fieldAt)
        },
      )
      if let Option<Shared<Type>>.Some {value} = move selectedField {
        run List<LayoutDemand>.append(&mut types, LayoutDemand {ty: move value, span: needed.span})
      }
      fieldAt = fieldAt + usize.ONE
    }
    // A lent Effect or callable runs its lender's storage, including the lender's own parts,
    // through the reference; a reference layout has no children, so demand the referent.
    let lent = Shared<Type>.with<Option<Shared<Type>>>(&needed.ty, lentStorage)
    if let Option<Shared<Type>>.Some {value: referent} = move lent {
      if Shared<Type>.with<bool>(&referent, lendableValue) {
        run List<LayoutDemand>.append(&mut types, LayoutDemand {ty: move referent, span: needed.span})
      }
    }
    at = at + usize.ONE
  }
  // Code identity erases regions: every region pattern of an application is one definition.
  let mut coordinates = RuntimeEncoding.codeCoordinates()
  let initialFunctions = List<MirFunction>.asSlice(&resolver.mirValues)
  let recipe = run InstanceRecipe.make(&initialFunctions[mirIndex])
  let callees = List<InstanceKey>.asSlice(&recipe.callees)
  let encoded = run InstanceText.encodings(&recipe, &mut coordinates)
  let identities = run InstanceText.identities(&recipe, List<Bytes>.asSlice(&encoded))
  // The content digest only serves a later revision (AGENTS.md one-shot rule), so a one-shot
  // build never assembles the content.
  let mut identity = Option<ContentHash>.none()
  if recording(&resolver.*) {
    let signatures = run emissionSignatureContent(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies,
      callees,
      &mut coordinates,
    )
    // One layout value answers one interned layout type, and a type runtime-equal to the
    // interned one encodes identically, so the first supply's content serves every later instance.
    let indices = List<usize>.asSlice(&contentIndices)
    let supplied = List<TypeLayout>.asSlice(&layouts)
    let mut contentLength = usize.ZERO
    let mut contentAt = usize.ZERO
    while contentAt < indices.length {
      let known = List<Bytes>.asSlice(&resolver.layoutContents)
      if Bytes.length(&known[indices[contentAt]]) == usize.ZERO {
        let encodedLayout = run InstanceText.layoutContent(&supplied[contentAt], &layoutOwner)
        List<Bytes>.set(&mut resolver.layoutContents, indices[contentAt], move encodedLayout)
      }
      let cached = List<Bytes>.asSlice(&resolver.layoutContents)
      contentLength = contentLength + Bytes.length(&cached[indices[contentAt]])
      contentAt = contentAt + usize.ONE
    }
    // Each supplied layout's cached content, copied once into a buffer sized for all of it.
    let cachedContents = List<Bytes>.asSlice(&resolver.layoutContents)
    let mut layoutContent = Bytes.make()
    run Bytes.reserveExact(&mut layoutContent, contentLength)
    contentAt = usize.ZERO
    while contentAt < indices.length {
      run Bytes.append(&mut layoutContent, Bytes.asSlice(&cachedContents[indices[contentAt]]))
      contentAt = contentAt + usize.ONE
    }
    let digest = run InstanceText.contentDigest(
      &recipe,
      &resolver.target,
      List<TypeLayout>.length(&layouts),
      Bytes.asSlice(&layoutContent),
      List<CAbi.Signature>.asSlice(&foreign),
      Bytes.asSlice(&signatures),
      List<Bytes>.asSlice(&encoded),
      &suspension,
    )
    identity = Option<ContentHash>.some(digest)
  }
  let encodedSlice = List<Bytes>.asSlice(&encoded)
  let own = run Bytes.copy(Bytes.asSlice(&encodedSlice[usize.ZERO]))
  let index = List<EmissionInputs>.length(&resolver.emissionInputs)
  run List<EmissionInputs>.append(&mut resolver.*.emissionInputs,
    EmissionInputs {
      mir: mirIndex,
      layouts: move layouts,
      foreign: move foreign,
      llvm: usize.MAX,
      encoding: move own,
      identities: move identities,
      suspension: move suspension,
      anchor: move anchor,
    },
  )
  let llvm = run internLlvmInput(
    &mut resolver.*,
    index,
    move identity,
    List<Dependency>.asSlice(&dependencies),
  )
  let inputs = List<EmissionInputs>.asMutSlice(&mut resolver.emissionInputs)
  inputs[index].llvm = llvm
  return memberSuccess(Value.EmissionInputs {index: index}, move dependencies)
}

// Whether one function body contains static control or static state anywhere in its own
// statements: blocks, conditionals, `if let`, loops, `unsafe` and match-arm blocks alike. The walk
// follows owned children only (`ownedChildren`, the HIR verifier's complete field walk), so a
// node's position or span never bounds it. A nested callable's or Effect's body is a separate body
// and is not entered. Static arms are recognized syntactically and never semantically inspected.
effect fn bodyHasStaticWork(hir: &Module, block: HirId) -> bool ! OutOfMemoryError ? &mut Allocator {
  let mut pending = List<HirId>.make()
  let mut owned = List<HirId>.make()
  run List<HirId>.append(&mut pending, block)
  while List<HirId>.length(&pending) > usize.ZERO {
    let last = List<HirId>.length(&pending) - usize.ONE
    let id = List<HirId>.remove(&mut pending, last)
    match Module.node(hir, id) {
      Node.CallableExpression {..} => { continue }
      Node.EffectExpression {..} => { continue }
      Node.StaticConditionalStatement {..} => { return true }
      Node.StaticForStatement {..} => { return true }
      Node.BindingStatement {isStatic, ..} => {
        if isStatic { return true }
      }
      _ => ()
    }
    let storage = move owned
    owned = run collectOwnedChildren(hir, id, move storage)
    let children = List<HirId>.asSlice(&owned)
    let mut at = usize.ZERO
    while at < children.length {
      run List<HirId>.append(&mut pending, children[at])
      at = at + usize.ONE
    }
  }
  return false
}

// Whether one function body writes a call through a member, `value.method(argument)` or
// `Interface.operation(argument)`, with an argument that could fill a static parameter: only such
// a call's callee is found by checking rather than routing.
effect fn bodyHasMemberCall(hir: &Module, block: HirId) -> bool ! OutOfMemoryError ? &mut Allocator {
  let mut pending = List<HirId>.make()
  let mut owned = List<HirId>.make()
  run List<HirId>.append(&mut pending, block)
  while List<HirId>.length(&pending) > usize.ZERO {
    let last = List<HirId>.length(&pending) - usize.ONE
    let id = List<HirId>.remove(&mut pending, last)
    if let Node.CallExpression {callee, arguments, ..} = Module.node(hir, id) {
      if arguments.length > usize.ZERO {
        if let Node.FieldExpression {..} = Module.node(hir, callee) { return true }
      }
    }
    let storage = move owned
    owned = run collectOwnedChildren(hir, id, move storage)
    let children = List<HirId>.asSlice(&owned)
    let mut at = usize.ZERO
    while at < children.length {
      run List<HirId>.append(&mut pending, children[at])
      at = at + usize.ONE
    }
  }
  return false
}

// Whether checking the static function at `declaration` reads its argument values. Only static
// control and static bindings consult them while the body is checked, nested callables included,
// so a body without any checks once for all argument values; execution still receives each call's
// values. A body that cannot be read is assumed to read them. The answer is kept per source
// revision, since every interpreted call asks it.
effect fn staticBodyReadsValues(resolver: &mut Resolver, module: &ModuleId, declaration: usize) -> bool
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let moduleOrdinal = run internModule(&mut resolver.*, module)
  let sourceAnswer = run observedDeclaration(&mut resolver.*, module, declaration, SourceFacet.Body)
  let mut reads = true
  let mut fresh = Option<StaticReads>.none()
  if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(&resolver.*, &sourceAnswer, module) {
    let index = IndexedSource.moduleIndex(indexed)
    let revision = ModuleIndex.sourceRevision(index)
    let known = cachedReads(&resolver.*, moduleOrdinal, declaration, revision)
    if known != usize.MAX {
      reads = List<StaticReads>.asSlice(&resolver.staticReads)[known].reads
    } else {
      let declarations = ModuleIndex.listDeclarations(index)
      if declaration < declarations.length {
        let hir = IndexedSource.authored(indexed)
        if let Node.Declaration {body, ..} = Module.node(hir, declarations[declaration].local) {
          if let Node.CallableBody {block} = Module.node(hir, body) {
            if block.present { reads = run staticWorkAnywhere(hir, block.id) }
          }
        }
      }
      fresh = Option<StaticReads>.some(StaticReads {module: moduleOrdinal, declaration: declaration, revision: revision, reads: reads})
    }
  }
  if let Option<StaticReads>.Some {value: entry} = move fresh {
    run List<StaticReads>.append(&mut resolver.staticReads, move entry)
    run InternIndex.record(&mut resolver.staticReadsLookup, headerKey(moduleOrdinal, declaration))
  }
  return reads
}

// Whether one static function's body reads its argument values while checked, valid for the
// source revision it was read from.
struct StaticReads {
  module: usize,
  declaration: usize,
  revision: usize,
  reads: bool,
}

// The cached entry for the static function at `declaration` read from `revision`, or `usize.MAX`.
fn cachedReads(resolver: &Resolver, module: usize, declaration: usize, revision: usize) -> usize {
  let cached = List<StaticReads>.asSlice(&resolver.staticReads)
  let mut at = InternIndex.first(&resolver.staticReadsLookup, headerKey(module, declaration))
  while at != usize.MAX {
    if cached[at].module == module && cached[at].declaration == declaration && cached[at].revision == revision {
      return at
    }
    at = InternIndex.after(&resolver.staticReadsLookup, at)
  }
  return usize.MAX
}

// Whether any static control or static binding is written under `root`, including inside nested
// callables.
effect fn staticWorkAnywhere(hir: &Module, root: HirId) -> bool ! OutOfMemoryError ? &mut Allocator {
  let mut pending = List<HirId>.make()
  let mut owned = List<HirId>.make()
  run List<HirId>.append(&mut pending, root)
  while List<HirId>.length(&pending) > usize.ZERO {
    let last = List<HirId>.length(&pending) - usize.ONE
    let id = List<HirId>.remove(&mut pending, last)
    match Module.node(hir, id) {
      Node.StaticConditionalStatement {..} => { return true }
      Node.StaticForStatement {..} => { return true }
      Node.BindingStatement {isStatic, ..} => {
        if isStatic { return true }
      }
      _ => ()
    }
    let storage = move owned
    owned = run collectOwnedChildren(hir, id, move storage)
    let children = List<HirId>.asSlice(&owned)
    let mut at = usize.ZERO
    while at < children.length {
      run List<HirId>.append(&mut pending, children[at])
      at = at + usize.ONE
    }
  }
  return false
}

// The single routing fact for a runtime function: true when it has static parameters, static
// control or state, or calls a static helper whose result is embedded. Its `StaticRouting` unit
// computes it once per declaration and revision.
effect fn needsStaticResidualization(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  module: &ModuleId,
  moduleOrdinal: usize,
  declaration: usize,
) -> Result<bool, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let routingRequest = Key {
    family: Family.StaticRouting, module: moduleOrdinal, name: usize.ZERO,
    declaration: declaration, member: usize.ZERO, external: false,
  }
  let routing = run internDeclaration(&mut resolver.*, routingRequest)
  let answer = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, routing, Span.make(usize.ZERO, usize.ZERO))
  let rejected = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(&answer, answerCause)
  if let Option<Shared<Rejection>>.Some {value} = move rejected {
    return Result<bool, Shared<Rejection>>.failResult(move value)
  }
  return Result<bool, Shared<Rejection>>.succeed(Shared<Result<Answer, NoRejection>>.with<bool>(&answer, staticRoutingHolds))
}

fn staticRoutingHolds(answer: &Result<Answer, NoRejection>) -> bool {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.StaticRouting {holds}} = &value.outcome { return holds }
  }
  return false
}

effect fn resolveStaticRouting(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, key: Key) -> Answer
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut dependencies = List<Dependency>.make()
  let declaration = declarationPosition(&resolver.*, key)
  let module = resolvedModule(&resolver.*, key.module)
  let computed = run computeStaticRouting(&mut resolver.*, &mut owner.*, &mut dependencies, &module, key.module, declaration)
  return match move computed {
    Result<bool, Shared<Rejection>>.Success {value} => memberSuccess(Value.StaticRouting {holds: value}, move dependencies)
    Result<bool, Shared<Rejection>>.Failure {error} => run memberRejected(move error, move dependencies)
  }
}

// Resolves the annotations and calls written in a function's body (`Family.BodyFacts`), so its
// routing and its checking share one resolution of each call.
effect fn resolveBodyFactsUnit(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, key: Key) -> Answer
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut dependencies = List<Dependency>.make()
  let declaration = declarationPosition(&resolver.*, key)
  let module = resolvedModule(&resolver.*, key.module)
  let facts = run writtenBodyFacts(&mut resolver.*, &mut owner.*, &mut dependencies, &module, key.module, declaration)
  let resolved = match move facts {
    Result<BodyFacts, Shared<Rejection>>.Success {value} => move value
    Result<BodyFacts, Shared<Rejection>>.Failure {error} => { return run memberRejected(move error, move dependencies) }
  }
  while List<usize>.length(&resolver.bodyFactsSlots) <= key.declaration {
    run List<usize>.append(&mut resolver.bodyFactsSlots, usize.MAX)
  }
  let mut slot = List<usize>.get(&resolver.bodyFactsSlots, key.declaration)
  if slot == usize.MAX {
    slot = List<Option<BodyFacts>>.length(&resolver.bodyFacts)
    run List<Option<BodyFacts>>.append(&mut resolver.bodyFacts, Option<BodyFacts>.some(move resolved))
    List<usize>.set(&mut resolver.bodyFactsSlots, key.declaration, slot)
  } else {
    let held = List<Option<BodyFacts>>.asMutSlice(&mut resolver.bodyFacts)
    held[slot] = Option<BodyFacts>.some(move resolved)
  }
  return memberSuccess(Value.BodyFacts {index: slot}, move dependencies)
}

// Resolves the annotations and calls written in the body of the function at `declaration`.
effect fn writtenBodyFacts(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, dependencies: &mut List<Dependency>,
  module: &ModuleId, moduleOrdinal: usize, declaration: usize) -> Result<BodyFacts, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let sourceAnswer = run observedDeclaration(&mut resolver.*, module, declaration, SourceFacet.Body)
  let mut annotationIds = List<HirId>.make()
  let mut writtenCalls = List<CallSyntax>.make()
  if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(&resolver.*, &sourceAnswer, module) {
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(indexed))
    if declaration < declarations.length {
      let hir = IndexedSource.authored(indexed)
      if let Node.Declaration {body, ..} = Module.node(hir, declarations[declaration].local) {
        if let Node.CallableBody {block} = Module.node(hir, body) {
          if block.present {
            if let Node.Block {statements} = Module.node(hir, block.id) {
              run collectBodySyntax(hir, statements, &mut annotationIds, &mut writtenCalls)
            }
          }
        }
      }
    }
  }
  return run resolveBodyFacts(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, moduleOrdinal, declaration,
    &annotationIds, &writtenCalls)
}

// Body facts taken from their slot (`takeBodyFacts`), which `usize.MAX` names when they were
// resolved again instead.
struct TakenFacts {
  facts: BodyFacts,
  slot: usize,
}

// Takes the body facts of the function at `declaration` (`Family.BodyFacts`) out of their slot.
// Facts another reader took are resolved again here, recording what they read against this run,
// which already depends on the facts' unit.
effect fn takeBodyFacts(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, dependencies: &mut List<Dependency>,
  module: &ModuleId, moduleOrdinal: usize, declaration: usize) -> Result<TakenFacts, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let request = Key {
    family: Family.BodyFacts, module: moduleOrdinal, name: usize.ZERO,
    declaration: declaration, member: usize.ZERO, external: false,
  }
  let interned = run internDeclaration(&mut resolver.*, request)
  let answer = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, interned, Span.make(usize.ZERO, usize.ZERO))
  let rejected = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(&answer, answerCause)
  if let Option<Shared<Rejection>>.Some {value} = move rejected {
    return Result<TakenFacts, Shared<Rejection>>.failResult(move value)
  }
  let slot = Shared<Result<Answer, NoRejection>>.with<usize>(&answer, fn(result: &Result<Answer, NoRejection>) -> usize {
    if let Result<Answer, NoRejection>.Success {value} = &result.* {
      if let Outcome.Success {value: Value.BodyFacts {index}} = &value.outcome { return index }
    }
    return usize.MAX
  })
  if slot == usize.MAX { return CompilerBug.panic(b"MissingRetainedFact: takeBodyFacts") }
  let held = List<Option<BodyFacts>>.asMutSlice(&mut resolver.bodyFacts)
  let taken = Intrinsic.replace(held[slot], Option<BodyFacts>.none())
  if let Option<BodyFacts>.Some {value} = move taken {
    return Result<TakenFacts, Shared<Rejection>>.succeed(TakenFacts {facts: move value, slot: slot})
  }
  return match move run writtenBodyFacts(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, moduleOrdinal, declaration) {
    Result<BodyFacts, Shared<Rejection>>.Success {value} => Result<TakenFacts, Shared<Rejection>>.succeed(TakenFacts {facts: move value, slot: usize.MAX})
    Result<BodyFacts, Shared<Rejection>>.Failure {error} => Result<TakenFacts, Shared<Rejection>>.failResult(move error)
  }
}

// Puts facts `takeBodyFacts` took back in their slot, for the function's checking.
fn returnBodyFacts(resolver: &mut Resolver, taken: TakenFacts) -> () {
  let TakenFacts {facts, slot} = move taken
  if slot != usize.MAX {
    let held = List<Option<BodyFacts>>.asMutSlice(&mut resolver.bodyFacts)
    held[slot] = Option<BodyFacts>.some(move facts)
  }
  return ()
}

// Computes `needsStaticResidualization`. Syntactic markers decide first; only otherwise are the
// written callees' headers read. No callee runtime body is demanded and no static arm is
// semantically inspected.
effect fn computeStaticRouting(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  module: &ModuleId,
  moduleOrdinal: usize,
  declaration: usize,
) -> Result<bool, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  drop run observedDeclaration(&mut resolver.*, module, declaration, SourceFacet.Header)
  let sourceAnswer = run observedDeclaration(&mut resolver.*, module, declaration, SourceFacet.Body)
  let mut marked = false
  let mut memberCalls = false
  if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(&resolver.*, &sourceAnswer, module) {
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(indexed))
    if declaration < declarations.length {
      let hir = IndexedSource.authored(indexed)
      if let Node.Declaration {header, body, ..} = Module.node(hir, declarations[declaration].local) {
        if let Option<HirId>.Some {value: contract} = namedCallableContract(hir, header) {
          if let Node.CallableContract {parameters, ..} = Module.node(hir, contract) {
            let mut at = usize.ZERO
            while at < parameters.length {
              if let Node.Parameter {mode, ..} = Module.node(hir, Module.child(hir, parameters, at)) {
                if mode == ParameterMode.Static { marked = true }
              }
              at = at + usize.ONE
            }
          }
        }
        if let Node.CallableBody {block} = Module.node(hir, body) {
          if block.present {
            if !marked { marked = run bodyHasStaticWork(hir, block.id) }
            if !marked { memberCalls = run bodyHasMemberCall(hir, block.id) }
          }
        }
      }
    }
  }
  if marked { return Result<bool, Shared<Rejection>>.succeed(true) }
  let facts = run takeBodyFacts(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, moduleOrdinal, declaration)
  let taken = match move facts {
    Result<TakenFacts, Shared<Rejection>>.Success {value} => move value
    Result<TakenFacts, Shared<Rejection>>.Failure {error} => { return Result<bool, Shared<Rejection>>.failResult(move error) }
  }
  let mut routed = Result<bool, Shared<Rejection>>.succeed(false)
  let calls = List<ResolvedCall>.asSlice(&taken.facts.calls)
  let mut at = usize.ZERO
  while at < calls.length {
    let decided = run resolvedCallPhase(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, &calls[at])
    match move decided {
      Result<CallPhase, Shared<Rejection>>.Success {value: phase} => {
        match move phase {
          CallPhase.Runtime => {}
          _ => {
            routed = Result<bool, Shared<Rejection>>.succeed(true)
            break
          }
        }
      }
      Result<CallPhase, Shared<Rejection>>.Failure {error} => {
        routed = Result<bool, Shared<Rejection>>.failResult(move error)
        break
      }
    }
    at = at + usize.ONE
  }
  returnBodyFacts(&mut resolver.*, move taken)
  // A method call's callee is known only once the body is checked: a body whose check reports a
  // method call with static parameters selects its static arguments too.
  let mut unrouted = false
  if let Result<bool, Shared<Rejection>>.Success {value} = &routed { unrouted = !value && memberCalls }
  if unrouted {
    let bodyRequest = Key {
      family: Family.Body, module: moduleOrdinal, name: usize.ZERO, declaration: declaration, member: usize.ZERO, external: false,
    }
    let bodyKey = run internDeclaration(&mut resolver.*, bodyRequest)
    let checked = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, bodyKey, Span.make(usize.ZERO, usize.ZERO))
    if Shared<Result<Answer, NoRejection>>.with<bool>(&checked, reportsReceiverStatics) {
      return Result<bool, Shared<Rejection>>.succeed(true)
    }
  }
  return move routed
}

// Whether a checked body reports a method or interface operation call whose static arguments no
// selection supplied.
fn reportsReceiverStatics(answer: &Result<Answer, NoRejection>) -> bool {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Rejected {diagnostics, ..} = &value.outcome {
      let listed = List<Shared<Rejection>>.asSlice(&diagnostics)
      let mut at = usize.ZERO
      while at < listed.length {
        let receiver = Shared<Rejection>.with<bool>(&listed[at], fn(rejection: &Rejection) -> bool {
          return rejection.code == RejectionCode.StaticArgumentsThroughCall
        })
        if receiver { return true }
        at = at + usize.ONE
      }
    }
  }
  return false
}

/// The static slots of one call whose callee only type checking finds, such as a method call
/// `value.scaled(2)`: its slots are positions among the written arguments, each recorded at
/// `offset` past its position, the callee's parameter index once a receiver is counted.
pub struct StaticCallHint {
  pub call: HirId,
  pub slots: List<usize>,
  pub types: List<Option<Shared<Type>>>,
  pub offset: usize,
}

/// How a selection pass treats one reached call, read from the callee's tracked header.
pub union CallPhase {
  /// An ordinary runtime call.
  Runtime,
  /// A `static fn`: the selection pass executes it and embeds its result.
  Static,
  /// A runtime function with `static` parameters at these original indices: the selection pass
  /// evaluates those arguments, and the call keeps only its runtime operands. Each slot's closed
  /// declared type is its argument's expected type; a type written in callee binders is absent.
  StaticSlots {pub slots: List<usize>, pub types: List<Option<Shared<Type>>>},
}

// The phase of one resolved call, read from the callee's tracked Signature. Routing and the
// selection pass share this fact; a fresh store interns the callee module, and an unresolved or
// rejected header is a precise rejection rather than an ordinary runtime call.
effect fn resolvedCallPhase(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  module: &ModuleId,
  call: &ResolvedCall,
) -> Result<CallPhase, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  if let Result<ResolvedTarget, Shared<Rejection>>.Success {
    value: ResolvedTarget.Intrinsic {member, typeArguments}
  } = &call.result {
    // Catalog and metadata reads are static; a test's callable takes its descriptor statically.
    if intrinsicIsPrimitive(member, IntrinsicPrimitive.Tests) || intrinsicIsPrimitive(member, IntrinsicPrimitive.TestInfo) {
      return Result<CallPhase, Shared<Rejection>>.succeed(CallPhase.Static)
    }
    if intrinsicIsPrimitive(member, IntrinsicPrimitive.TestFunction) {
      let mut slots = List<usize>.make()
      run List<usize>.append(&mut slots, usize.ZERO)
      let mut types = List<Option<Shared<Type>>>.make()
      run List<Option<Shared<Type>>>.append(&mut types, Option<Shared<Type>>.none())
      return Result<CallPhase, Shared<Rejection>>.succeed(CallPhase.StaticSlots {slots: move slots, types: move types})
    }
    // An atomic operation takes its memory orderings statically, as text (ATOMIC-001).
    if let Option<usize>.Some {value: start} = move CheckedIntrinsic.orderingStart(member) {
      let mut slots = List<usize>.make()
      let mut types = List<Option<Shared<Type>>>.make()
      let mut at = start
      while at < intrinsicArity(member) {
        run List<usize>.append(&mut slots, at)
        run List<Option<Shared<Type>>>.append(&mut types, Option<Shared<Type>>.some(run CheckedIntrinsic.staticTextType()))
        at = at + usize.ONE
      }
      return Result<CallPhase, Shared<Rejection>>.succeed(CallPhase.StaticSlots {slots: move slots, types: move types})
    }
    // A shuffle takes its lane indices statically, as a `[usize; M]` array (SIMD-006).
    if intrinsicIsPrimitive(member, IntrinsicPrimitive.SimdShuffle) {
      let arguments = List<Shared<Type>>.asSlice(&typeArguments)
      let mut expected = Option<Shared<Type>>.none()
      if arguments.length == 2 && !Type.hasOpenParameters(&arguments[usize.ONE]) {
        expected = run CheckedIntrinsic.shuffleIndices(&arguments[usize.ONE])
      }
      let mut slots = List<usize>.make()
      run List<usize>.append(&mut slots, 2)
      let mut types = List<Option<Shared<Type>>>.make()
      run List<Option<Shared<Type>>>.append(&mut types, move expected)
      return Result<CallPhase, Shared<Rejection>>.succeed(CallPhase.StaticSlots {slots: move slots, types: move types})
    }
    // `makeVariant` takes its variant first and `isVariant` second; both name the union first.
    if intrinsicIsPrimitive(member, IntrinsicPrimitive.MakeVariant) || intrinsicIsPrimitive(member, IntrinsicPrimitive.IsVariant) {
      let span = run staticSpan(&mut resolver.*, module, call.id)
      let arguments = List<Shared<Type>>.asSlice(&typeArguments)
      let making = intrinsicIsPrimitive(member, IntrinsicPrimitive.MakeVariant)
      let mut written: usize = usize.ONE
      if making { written = 2 }
      if arguments.length != written && arguments.length != usize.ZERO {
        return Result<CallPhase, Shared<Rejection>>.failResult(run rejectArity(&resolver.*, module, span, written, arguments.length))
      }
      let mut slots = List<usize>.make()
      if making { run List<usize>.append(&mut slots, usize.ZERO) } else { run List<usize>.append(&mut slots, usize.ONE) }
      let mut types = List<Option<Shared<Type>>>.make()
      let mut expected = Option<Shared<Type>>.none()
      if arguments.length != usize.ZERO && !Type.hasOpenParameters(&arguments[usize.ZERO]) {
        expected = Option<Shared<Type>>.some(run CheckedIntrinsic.variantType(&arguments[usize.ZERO]))
      }
      run List<Option<Shared<Type>>>.append(&mut types, move expected)
      return Result<CallPhase, Shared<Rejection>>.succeed(CallPhase.StaticSlots {slots: move slots, types: move types})
    }
    if intrinsicIsPrimitive(member, IntrinsicPrimitive.BorrowField) || intrinsicIsPrimitive(member, IntrinsicPrimitive.BorrowFieldMut) {
      let span = run staticSpan(&mut resolver.*, module, call.id)
      let arguments = List<Shared<Type>>.asSlice(&typeArguments)
      if arguments.length != 2 && arguments.length != usize.ZERO {
        return Result<CallPhase, Shared<Rejection>>.failResult(
          run rejectArity(&resolver.*, module, span, 2, arguments.length))
      }
      let mut slots = List<usize>.make()
      run List<usize>.append(&mut slots, usize.ONE)
      let mut types = List<Option<Shared<Type>>>.make()
      let mut expected = Option<Shared<Type>>.none()
      if arguments.length == 2 {
        let descriptor = run CheckedIntrinsic.fieldType(&arguments[usize.ZERO], &arguments[usize.ONE])
        if !Type.hasOpenParameters(&descriptor) { expected = Option<Shared<Type>>.some(move descriptor) }
      }
      run List<Option<Shared<Type>>>.append(&mut types, move expected)
      return Result<CallPhase, Shared<Rejection>>.succeed(CallPhase.StaticSlots {slots: move slots, types: move types})
    }
  }
  if let Result<ResolvedTarget, Shared<Rejection>>.Success {value: ResolvedTarget.Function {target}} = &call.result {
    let callSpan = run staticSpan(&mut resolver.*, module, call.id)
    let calleeModule = ModuleId.copy(DeclarationId.moduleId(&target.declaration))
    let calleeModuleOrdinal = run internModule(&mut resolver.*, &calleeModule)
    let identity = run Shared<DeclarationId>.make(DeclarationId.copy(&target.declaration))
    let position = run ordinalOfIdentity(&mut resolver.*, &calleeModule, &identity)
    let ordinal = match move position {
      Option<usize>.Some {value} => value
      Option<usize>.None => {
        return CompilerBug.panic(b"MissingRetainedFact: resolvedCallPhase")
      }
    }
    let declarationAccess200Request = Key {family: Family.Signature, module: calleeModuleOrdinal, name: usize.ZERO, declaration: ordinal, member: usize.ZERO, external: false}
    let declarationAccess200 = run internDeclaration(&mut resolver.*, declarationAccess200Request)
    let header = run demandChild(
      &mut resolver.*, &mut owner.*, &mut dependencies.*,
      declarationAccess200,
      callSpan,
    )
    let facts = Shared<Result<Answer, NoRejection>>.with<Option<SignatureFacts>>(&header, signatureFacts)
    return match move facts {
      Option<SignatureFacts>.Some {value: signature} => {
        if signature.isStatic { return Result<CallPhase, Shared<Rejection>>.succeed(CallPhase.Static) }
        if signature.staticSlots == usize.ZERO { return Result<CallPhase, Shared<Rejection>>.succeed(CallPhase.Runtime) }
        let slots = run signatureStaticSlots(&header, signature.staticSlots)
        let mut types = List<Option<Shared<Type>>>.make()
        let listed = List<usize>.asSlice(&slots)
        let mut slotAt = usize.ZERO
        while slotAt < listed.length {
          let index = listed[slotAt]
          let declared = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(&header,
            fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> { return signatureParameter(answer, index) })
          let mut closedType = Option<Shared<Type>>.none()
          if let Option<Shared<Type>>.Some {value} = move declared {
            if !Type.hasOpenParameters(&value) { closedType = Option<Shared<Type>>.some(move value) }
          }
          run List<Option<Shared<Type>>>.append(&mut types, move closedType)
          slotAt = slotAt + usize.ONE
        }
        return Result<CallPhase, Shared<Rejection>>.succeed(CallPhase.StaticSlots {slots: move slots, types: move types})
      }
      Option<SignatureFacts>.None => {
        let refused = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(&header, answerCause)
        if let Option<Shared<Rejection>>.Some {value: reason} = move refused {
          return Result<CallPhase, Shared<Rejection>>.failResult(move reason)
        }
        return Result<CallPhase, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Unsupported, callSpan))
      }
    }
  }
  return Result<CallPhase, Shared<Rejection>>.succeed(CallPhase.Runtime)
}

// Resolves one written call inside a declaration's body and reads its callee's phase.
effect fn writtenCallPhase(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  module: &ModuleId,
  declaration: usize,
  call: HirId,
) -> Result<CallPhase, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let sourceAnswer = run observedSyntax(&mut resolver.*, module, call)
  let mut written = List<CallSyntax>.make()
  if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(&resolver.*, &sourceAnswer, module) {
    let mut phaseAnnotations = List<HirId>.make()
    run collectCall(IndexedSource.authored(indexed), call, &mut phaseAnnotations, &mut written)
  }
  let collected = List<CallSyntax>.asSlice(&written)
  let mut at = usize.ZERO
  while at < collected.length {
    if collected[at].id.index == call.index {
      let template = run templateBinders(&mut resolver.*, module, declaration)
      let binders = match move template {
        Result<List<Binder>, Shared<Rejection>>.Success {value} => move value
        Result<List<Binder>, Shared<Rejection>>.Failure {error} => { return Result<CallPhase, Shared<Rejection>>.failResult(move error) }
      }
      let moduleOrdinal = run internModule(&mut resolver.*, module)
      let constraints = match move run bodyPremises(&mut resolver.*, &mut owner.*, &mut dependencies.*, moduleOrdinal, declaration) {
        Result<List<Constraint>, Shared<Rejection>>.Success {value} => move value
        Result<List<Constraint>, Shared<Rejection>>.Failure {error} => { return Result<CallPhase, Shared<Rejection>>.failResult(move error) }
      }
      let target = run callTarget(
        &mut resolver.*, &mut owner.*, &mut dependencies.*, module, moduleOrdinal, &collected[at],
        List<Binder>.asSlice(&binders),
        List<Constraint>.asSlice(&constraints),
      )
      let resolved = ResolvedCall {id: call, result: move target}
      return run resolvedCallPhase(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, &resolved)
    }
    at = at + usize.ONE
  }
  return Result<CallPhase, Shared<Rejection>>.succeed(CallPhase.Runtime)
}

// The interned selected application a Body member names.
effect fn selectedApplicationAt(resolver: &Resolver, at: usize) -> Application ! OutOfMemoryError ? &mut Allocator {
  let known = List<Application>.asSlice(&resolver.selectedApplications)
  return run Application.copy(&known[at])
}

// Interns one selected body's complete semantic application; equal semantic inputs share it.
effect fn internSelectedApplication(resolver: &mut Resolver, application: &Application) -> usize
! OutOfMemoryError
? &mut Allocator | &mut Types {
  let hashed = Application.hash(application)
  let known = List<Application>.asSlice(&resolver.selectedApplications)
  let mut at = InternIndex.first(&resolver.selectedApplicationLookup, hashed)
  while at != usize.MAX {
    if run Application.equals(&known[at], application) {
      return at
    }
    at = InternIndex.after(&resolver.selectedApplicationLookup, at)
  }
  let interned = known.length
  run List<Application>.append(&mut resolver.*.selectedApplications, run Application.copy(application))
  run InternIndex.record(&mut resolver.selectedApplicationLookup, hashed)
  return interned
}

fn staticScalarCode(value: &StaticData) -> usize {
  return match & value.* {
    StaticData.Unit => 1
    StaticData.Boolean {..} => 2
    StaticData.Integer {ty, ..} => match ty {
      StaticIntegerType.U8 => 3
      StaticIntegerType.U16 => 4
      StaticIntegerType.U32 => 5
      StaticIntegerType.U64 => 6
      StaticIntegerType.Usize => 7
      StaticIntegerType.I8 => 8
      StaticIntegerType.I16 => 9
      StaticIntegerType.I32 => 10
      StaticIntegerType.I64 => 11
      StaticIntegerType.Isize => 12
    }
    StaticData.Float {ty, ..} => match ty {
      StaticFloatType.F32 => 13
      StaticFloatType.F64 => 14
    }
    _ => 0
  }
}

fn staticScalarName(code: usize) -> &'static [u8] {
  if code == 2 { return b"bool" }
  if code == 3 { return b"u8" }
  if code == 4 { return b"u16" }
  if code == 5 { return b"u32" }
  if code == 6 { return b"u64" }
  if code == 7 { return b"usize" }
  if code == 8 { return b"i8" }
  if code == 9 { return b"i16" }
  if code == 10 { return b"i32" }
  if code == 11 { return b"i64" }
  if code == 12 { return b"isize" }
  if code == 13 { return b"f32" }
  return b"f64"
}

// The exact runtime type of an embedded static value: scalars, scalar enums, and fixed arrays and
// cleanup-free structs of embeddable values, which MIR materializes. Text uses immutable
// program-lifetime bytes and a character retains its exact Unicode scalar type. An enum's type is
// its declaration identity's type. Sealed reflection descriptors have no runtime embedding.
effect fn embeddedType(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, dependencies: &mut List<Dependency>,
  value: &Shared<StaticData>, span: Span,
) -> Option<Shared<Type>> ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let text = Shared<StaticData>.with<bool>(value, fn(data: &StaticData) -> bool {
    return match &data.* {StaticData.Text {..} => true _ => false}
  })
  if text { return Option<Shared<Type>>.some(run Types.intern(Type.String {lifetime: run Shared<Lifetime>.make(Lifetime.Static)})) }
  let character = Shared<StaticData>.with<bool>(value, fn(data: &StaticData) -> bool {
    return match &data.* {StaticData.Character {..} => true _ => false}
  })
  if character { return Option<Shared<Type>>.some(run Types.intern(Type.Primitive {name: run Bytes.copy(b"char")})) }
  let code = Shared<StaticData>.with<usize>(value, staticScalarCode)
  if code == usize.ONE { return Option<Shared<Type>>.some(run Types.intern(Type.Unit)) }
  if code != usize.ZERO {
    return Option<Shared<Type>>.some(run Types.intern(Type.Primitive {name: run Bytes.copy(staticScalarName(code))}))
  }
  let enumOwner = Shared<StaticData>.with<Option<Shared<DeclarationId>>>(value, fn(data: &StaticData) -> Option<Shared<DeclarationId>> {
    return match & data.* {
      StaticData.Enum {declaration, ..} => Option<Shared<DeclarationId>>.some(Shared<DeclarationId>.clone(&declaration))
      _ => Option<Shared<DeclarationId>>.none()
    }
  })
  if let Option<Shared<DeclarationId>>.Some {value: declaration} = move enumOwner {
    let located = run locationOfIdentity(&mut resolver.*, &declaration)
    let location = match move located {
      Option<InstanceLocation>.Some {value: found} => found
      Option<InstanceLocation>.None => { return Option<Shared<Type>>.none() }
    }
    let declarationAccess201Request = Key {
      family: Family.Identity, module: location.module, name: usize.ZERO,
      declaration: location.declaration, member: usize.ZERO, external: false,
    }
    let declarationAccess201 = run internDeclaration(&mut resolver.*, declarationAccess201Request)
    let identity = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, declarationAccess201, span)
    let selection = run typeFromAnswer(&identity)
    return move selection.resolved
  }
  let arrayType = Shared<StaticData>.with<Option<Shared<Type>>>(value, embeddedArrayType)
  if let Option<Shared<Type>>.Some {value: ty} = move arrayType {
    let count = Shared<StaticData>.with<usize>(value, aggregateFieldCount)
    let mut at = usize.ZERO
    while at < count {
      let child = Shared<StaticData>.with<Option<Shared<StaticData>>>(value, fn(data: &StaticData) -> Option<Shared<StaticData>> {
        return StaticValue.field(data, at)
      })
      let element = match move child {
        Option<Shared<StaticData>>.Some {value: found} => move found
        Option<Shared<StaticData>>.None => { return Option<Shared<Type>>.none() }
      }
      let elementType = run embeddedType(&mut resolver.*, &mut owner.*, &mut dependencies.*, &element, span)
      if let Option<Shared<Type>>.None = move elementType { return Option<Shared<Type>>.none() }
      at = at + usize.ONE
    }
    return Option<Shared<Type>>.some(move ty)
  }
  let structType = Shared<StaticData>.with<Option<Shared<Type>>>(value, fn(data: &StaticData) -> Option<Shared<Type>> {
    if !StaticValue.isStruct(data) { return Option<Shared<Type>>.none() }
    return match & data.* {
      StaticData.Aggregate {ty, ..} => Option<Shared<Type>>.some(Shared<Type>.clone(&ty))
      _ => Option<Shared<Type>>.none()
    }
  })
  if let Option<Shared<Type>>.Some {value: ty} = move structType {
    let count = Shared<StaticData>.with<usize>(value, aggregateFieldCount)
    let mut at = usize.ZERO
    while at < count {
      let child = Shared<StaticData>.with<Option<Shared<StaticData>>>(value, fn(data: &StaticData) -> Option<Shared<StaticData>> {
        return StaticValue.field(data, at)
      })
      let field = match move child {
        Option<Shared<StaticData>>.Some {value: found} => move found
        Option<Shared<StaticData>>.None => { return Option<Shared<Type>>.none() }
      }
      let fieldType = run embeddedType(&mut resolver.*, &mut owner.*, &mut dependencies.*, &field, span)
      if let Option<Shared<Type>>.None = move fieldType { return Option<Shared<Type>>.none() }
      at = at + usize.ONE
    }
    return Option<Shared<Type>>.some(move ty)
  }
  return Option<Shared<Type>>.none()
}

fn aggregateFieldCount(data: &StaticData) -> usize {
  return match & data.* {
    StaticData.Aggregate {fields, ..} => List<Shared<StaticData>>.length(&fields)
    _ => usize.ZERO
  }
}

// The type of a fixed-array static value; a nominal aggregate is not an array.
fn embeddedArrayType(data: &StaticData) -> Option<Shared<Type>> {
  if let StaticData.Aggregate {ty, variant, ..} = &data.* {
    if let Option<usize>.Some {..} = &variant { return Option<Shared<Type>>.none() }
    let isArray = Shared<Type>.with<bool>(&ty, fn(shape: &Type) -> bool {
      return match & shape.* {
        Type.Array {..} => true
        _ => false
      }
    })
    if isArray { return Option<Shared<Type>>.some(Shared<Type>.clone(&ty)) }
  }
  return Option<Shared<Type>>.none()
}

effect fn selectionBody(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  module: &ModuleId,
  application: &Application,
  constants: &[StaticBinding],
  hints: &[StaticCallHint],
) -> MixedSelection ! MixedDiagnostic | StaticDiagnostic | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut machine = run MixedBody.make(
    inFlightStaticPort(&mut resolver.*, &mut owner.*, &mut dependencies.*), module,
    StaticExecution.defaultLimits(), MixedBody.defaultResidualLimit(),
  )
  let mut at = usize.ZERO
  while at < constants.length {
    run MixedBody.supplyConstant(&mut machine, StaticBinding {module: ModuleId.copy(&constants[at].module),
      binder: constants[at].binder, value: StaticValue.copy(&constants[at].value)})
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < hints.length {
    run MixedBody.supplyCallHint(&mut machine, run copyStaticCallHint(&hints[at]))
    at = at + usize.ONE
  }
  return run MixedBody.specialize(&mut machine, application)
}

// Runs the single selection pass for one selected application and publishes its static results
// as per-syntax facts. Static parameters have no argument source yet and stay an explicit gap.
effect fn selectionFacts(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  module: &ModuleId,
  application: &Application,
  hints: &[StaticCallHint],
) -> Result<List<ResolvedCall>, Shared<Rejection>> ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  // A reached constant is resolved by its own declaration and the selection runs again with it,
  // as a static evaluation settles a needed constant.
  let mut constants = List<StaticBinding>.make()
  while true {
    let attempted = run Effect.result(selectionBody(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, application,
      List<StaticBinding>.asSlice(&constants), hints))
    let failure = match move attempted {
      Result<MixedSelection, MixedDiagnostic | StaticDiagnostic | OutOfMemoryError>.Success {value} => {
        return run selectionContextFacts(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, &value)
      }
      Result<MixedSelection, MixedDiagnostic | StaticDiagnostic | OutOfMemoryError>.Failure {error} => move error
    }
    match move failure {
      OutOfMemoryError {} => { fail OutOfMemoryError {} }
      MixedDiagnostic {code, span, rejection, occurrence, ..} => {
        if let Option<Shared<Rejection>>.Some {value: reason} = move rejection {
          return Result<List<ResolvedCall>, Shared<Rejection>>.failResult(move reason)
        }
        if let Option<MixedBody.IterationOccurrence>.Some {value} = move occurrence {
          let forSpan = run staticSpan(&mut resolver.*, module, value.syntax)
          return Result<List<ResolvedCall>, Shared<Rejection>>.failResult(run rejectIteration(&resolver.*, module, code, span, forSpan, value.ordinal))
        }
        return Result<List<ResolvedCall>, Shared<Rejection>>.failResult(run reject(&resolver.*, module, code, span))
      }
      StaticDiagnostic {fault, code, span, target, message, origin, byteOffset, rejection, needed, missing, trace} => {
        if let Option<Shared<Rejection>>.Some {value: reason} = move rejection {
          return Result<List<ResolvedCall>, Shared<Rejection>>.failResult(run relocatedStaticRejection(module, move reason, &trace))
        }
        if let Option<StaticNeeded>.Some {value: reached} = move needed {
          if List<StaticBinding>.length(&constants) < 4096 {
            let mut port = inFlightStaticPort(&mut resolver.*, &mut owner.*, &mut dependencies.*)
            let resolved = run staticResolveNeeded(&mut port, &reached.module, &reached.declaration, span)
            drop port
            let constant = match move resolved {
              Result<Option<Shared<StaticData>>, Shared<Rejection>>.Success {value} => move value
              Result<Option<Shared<StaticData>>, Shared<Rejection>>.Failure {error} => {
                return Result<List<ResolvedCall>, Shared<Rejection>>.failResult(move error)
              }
            }
            if let Option<Shared<StaticData>>.Some {value: found} = move constant {
              run List<StaticBinding>.append(&mut constants, StaticBinding {module: move reached.module,
                binder: reached.expression, value: move found})
              continue
            }
          }
        }
        return Result<List<ResolvedCall>, Shared<Rejection>>.failResult(run rejectStatic(&resolver.*, module, StaticDiagnostic {
          fault: fault, code: move code, span: span, target: move target, message: move message, origin: move origin,
          byteOffset: move byteOffset, rejection: Option<Shared<Rejection>>.none(), needed: Option<StaticNeeded>.none(),
          missing: move missing, trace: move trace,
        }))
      }
    }
  }
  return absurd<Result<List<ResolvedCall>, Shared<Rejection>>>()
}

effect fn selectionContextFacts(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, module: &ModuleId, selected: &MixedSelection) -> Result<List<ResolvedCall>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut facts = List<ResolvedCall>.make()
  let embedded = List<MixedEmbedded>.asSlice(&selected.embedded)
  let mut at = usize.ZERO
  while at < embedded.length {
    let embeddedSpan = run staticSpan(&mut resolver.*, module, embedded[at].syntax)
    let ty = run embeddedType(&mut resolver.*, &mut owner.*, &mut dependencies.*, &embedded[at].value, embeddedSpan)
    let exact = match move ty {
      Option<Shared<Type>>.Some {value} => move value
      Option<Shared<Type>>.None => {
        let unsupportedSpan = run staticSpan(&mut resolver.*, module, embedded[at].syntax)
        // A reflected descriptor has no runtime representation to embed.
        let described = Shared<StaticData>.with<Option<Shared<Type>>>(&embedded[at].value, fn(data: &StaticData) -> Option<Shared<Type>> {
          return match &data.* {
            StaticData.Aggregate {ty: aggregateType, ..} => Option<Shared<Type>>.some(Shared<Type>.clone(&aggregateType))
            _ => Option<Shared<Type>>.none()
          }
        })
        let mut phaseOnly = Shared<StaticData>.with<bool>(&embedded[at].value, fn(data: &StaticData) -> bool {
          return match &data.* { StaticData.Sequence {..} => true StaticData.Field {..} => true _ => false }
        })
        if let Option<Shared<Type>>.Some {value: aggregate} = move described {
          phaseOnly = run phaseOnlyType(&mut resolver.*, &mut owner.*, &mut dependencies.*, &aggregate, unsupportedSpan)
        }
        if phaseOnly {
          return Result<List<ResolvedCall>, Shared<Rejection>>.failResult(
            run embeddedPhaseRejection(&mut resolver.*, module, embedded[at].syntax, unsupportedSpan),
          )
        }
        return Result<List<ResolvedCall>, Shared<Rejection>>.failResult(
          run reject(&resolver.*, module, RejectionCode.Unsupported, unsupportedSpan),
        )
      }
    }
    run List<ResolvedCall>.append(&mut facts, ResolvedCall {
      id: embedded[at].syntax,
      result: Result<ResolvedTarget, Shared<Rejection>>.succeed(ResolvedTarget.Selected {
        fact: SelectionFact.Embedded {value: Shared<StaticData>.clone(&embedded[at].value), ty: move exact},
      }),
    })
    at = at + usize.ONE
  }
  let decisions = List<MixedDecision>.asSlice(&selected.decisions)
  at = usize.ZERO
  while at < decisions.length {
    run List<ResolvedCall>.append(&mut facts, ResolvedCall {
      id: decisions[at].condition,
      result: Result<ResolvedTarget, Shared<Rejection>>.succeed(ResolvedTarget.Selected {
        fact: SelectionFact.Condition {selected: decisions[at].selected},
      }),
    })
    at = at + usize.ONE
  }
  let bindings = List<StaticBinding>.asSlice(&selected.staticBindings)
  at = usize.ZERO
  while at < bindings.length {
    run List<ResolvedCall>.append(&mut facts, ResolvedCall {
      id: bindings[at].binder,
      result: Result<ResolvedTarget, Shared<Rejection>>.succeed(ResolvedTarget.Selected {
        fact: SelectionFact.StaticBinding {value: StaticValue.copy(&bindings[at].value)},
      }),
    })
    at = at + usize.ONE
  }
  let calls = List<MixedStaticArguments>.asSlice(&selected.staticArguments)
  at = usize.ZERO
  while at < calls.length {
    run List<ResolvedCall>.append(&mut facts, ResolvedCall {
      id: calls[at].call,
      result: Result<ResolvedTarget, Shared<Rejection>>.succeed(ResolvedTarget.Selected {
        fact: SelectionFact.StaticArguments {
          slots: run Shared<List<StaticSlot>>.make(run copyStaticSlots(List<StaticSlot>.asSlice(&calls[at].slots))),
        },
      }),
    })
    at = at + usize.ONE
  }
  let loops = List<MixedBody.StaticForSelection>.asSlice(&selected.iterations)
  at = usize.ZERO
  while at < loops.length {
    let selectedIterations = List<MixedBody.Iteration>.asSlice(&loops[at].iterations)
    let mut iterations = List<IterationFacts>.make()
    let mut ordinal = usize.ZERO
    while ordinal < selectedIterations.length {
      let child = run MixedBody.copySharedBody(&selectedIterations[ordinal].selection)
      let nested = run selectionContextFacts(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, &child)
      let calls = match move nested {
        Result<List<ResolvedCall>, Shared<Rejection>>.Success {value} => move value
        Result<List<ResolvedCall>, Shared<Rejection>>.Failure {error} => { return Result<List<ResolvedCall>, Shared<Rejection>>.failResult(move error) }
      }
      run List<IterationFacts>.append(&mut iterations, IterationFacts {ordinal: selectedIterations[ordinal].ordinal, calls: move calls})
      ordinal = ordinal + usize.ONE
    }
    run List<ResolvedCall>.append(&mut facts, ResolvedCall {id: loops[at].syntax,
      result: Result<ResolvedTarget, Shared<Rejection>>.succeed(ResolvedTarget.Selected {
        fact: SelectionFact.StaticFor {iterations: run Shared<List<IterationFacts>>.make(move iterations)},
      })})
    at = at + usize.ONE
  }
  return Result<List<ResolvedCall>, Shared<Rejection>>.succeed(move facts)
}

// Anonymous callables, anonymous `effect fn`s and `effect {}` blocks: literals whose body their
// lexical owner's body retains.
fn literalKind(identity: &DeclarationId) -> bool {
  return DeclarationId.kind(identity) == OwnerKind.Anonymous || DeclarationId.kind(identity) == OwnerKind.EffectBlock
}

struct AnonymousChild {
  body: Shared<TypedBody>,
}

// Anonymous bodies are retained by their lexical owner's body query. Following that query
// preserves source validation and cache-hit dependency replay, without a side registration table.
fn anonymousChild(body: &TypedBody, identity: &DeclarationId) -> Option<Shared<TypedBody>> {
  let nodes = TypedBody.nodeSlice(body)
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {form: BodyExpression.Callable {body: child, ..}, ..} = &nodes[at].kind {
      if Shared<TypedBody>.with<bool>(&child, fn(value: &TypedBody) -> bool {
        return DeclarationId.equals(TypedBody.declarationId(value), identity)
      }) { return Option<Shared<TypedBody>>.some(Shared<TypedBody>.clone(&child)) }
    }
    at = at + usize.ONE
  }
  return Option<Shared<TypedBody>>.none()
}

fn anonymousChildAnswer(answer: &Result<Answer, NoRejection>, identity: &DeclarationId) -> Option<AnonymousChild> {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Body {body}} = &value.outcome {
      let selected = Shared<TypedBody>.with<Option<Shared<TypedBody>>>(&body, fn(value: &TypedBody) -> Option<Shared<TypedBody>> {
        return anonymousChild(value, identity)
      })
      if let Option<Shared<TypedBody>>.Some {value: child} = move selected {
        return Option<AnonymousChild>.some(AnonymousChild {body: move child})
      }
    }
  }
  return Option<AnonymousChild>.none()
}

// Whether declaration `declaration` of `module` is a static template the declaration sweep defers
// (`StaticTemplate.reason`), so no selection over its unbound binders checks its body.
effect fn deferredStaticTemplate(resolver: &mut Resolver, module: &ModuleId, declaration: usize) -> bool
! Cycle | OutOfMemoryError ? &mut Allocator {
  drop run observedDeclaration(&mut resolver.*, module, declaration, SourceFacet.Header)
  let sourceAnswer = run observedDeclaration(&mut resolver.*, module, declaration, SourceFacet.Body)
  if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(&resolver.*, &sourceAnswer, module) {
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(indexed))
    if declaration < declarations.length {
      if let Option<StaticTemplate.Reason>.Some {..} = move run StaticTemplate.reason(IndexedSource.authored(indexed), declarations, declaration) {
        return true
      }
      return false
    }
  }
  return true
}

effect fn resolveAnonymousBody(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, key: Key,
  identity: &DeclarationId) -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let module = resolvedModule(&resolver.*, key.module)
  let mut dependencies = List<Dependency>.make()
  let declarationAccess202 = declarationPosition(&resolver.*, key)
  let enclosing = match move run enclosingIdentity(&mut resolver.*, &module, declarationAccess202) {
    Option<DeclarationId>.Some {value} => move value
    _ => { return run rejectedBody(run reject(&resolver.*, &module, RejectionCode.Unsupported, Span.make(usize.ZERO, usize.ZERO)), move dependencies) }
  }
  let handle = run Shared<DeclarationId>.make(DeclarationId.copy(&enclosing))
  let parent = match move run ordinalOfIdentity(&mut resolver.*, &module, &handle) {
    Option<usize>.Some {value} => value
    _ => { return run rejectedBody(run reject(&resolver.*, &module, RejectionCode.Unsupported, Span.make(usize.ZERO, usize.ZERO)), move dependencies) }
  }
  let mut parentMember = usize.ZERO
  // An unselected literal of a runtime body with static work, such as a call with a static
  // template, reads that body as its selected application, as the declaration sweep checks it:
  // the body's unselected answer holds no literals, so an `effect {}` block there had no signature.
  if key.member == usize.ZERO && !literalKind(&enclosing) {
    let routing = run needsStaticResidualization(&mut resolver.*, &mut owner.*, &mut dependencies, &module, key.module, parent)
    let residual = match move routing {
      Result<bool, Shared<Rejection>>.Success {value} => value
      Result<bool, Shared<Rejection>>.Failure {error} => { return run rejectedBody(move error, move dependencies) }
    }
    if residual {
      let parentSignatureRequest = Key {
        family: Family.Signature, module: key.module, name: usize.ZERO, declaration: parent, member: usize.ZERO, external: false,
      }
      let parentSignatureKey = run internDeclaration(&mut resolver.*, parentSignatureRequest)
      let parentSignature = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies, parentSignatureKey, Span.make(usize.ZERO, usize.ZERO))
      let mut unselected = Shared<Result<Answer, NoRejection>>.with<bool>(&parentSignature, signatureIsStatic)
        || Shared<Result<Answer, NoRejection>>.with<usize>(&parentSignature, signatureStaticCount) != usize.ZERO
      // An open template selects over its own unbound binders, as the sweep checks it, unless its
      // static expansions depend on them: that template is deferred and has no such body.
      if !unselected && Shared<Result<Answer, NoRejection>>.with<usize>(&parentSignature, signatureNonLifetimeBinderCount) != usize.ZERO {
        unselected = run deferredStaticTemplate(&mut resolver.*, &module, parent)
      }
      if !unselected {
        let instance = run InstanceKey.named(&handle)
        let application = run InstanceKey.selected(&instance)
        let selectedParent = run internSelectedApplication(&mut resolver.*, &application)
        parentMember = selectedParent + usize.ONE
      }
    }
  }
  if key.member != usize.ZERO {
    let childApplication = run selectedApplicationAt(&resolver.*, key.member - usize.ONE)
    let mut arguments = List<Argument>.make()
    let mut ordinals = List<usize>.make()
    let mut scopes = List<ScopeBinding>.make()
    let childScopes = List<ScopeBinding>.asSlice(&childApplication.scopes)
    let mut at = usize.ZERO
    while at < childScopes.length {
      if Shared<DeclarationId>.with<bool>(&childScopes[at].owner, fn(value: &DeclarationId) -> bool { return DeclarationId.equals(value, &enclosing) }) {
        let own = run ScopeBinding.copy(&childScopes[at])
        let ScopeBinding {arguments: values, argumentOrdinals: slots, ..} = move own
        arguments = move values
        ordinals = move slots
      } else { run List<ScopeBinding>.append(&mut scopes, run ScopeBinding.copy(&childScopes[at])) }
      at = at + usize.ONE
    }
    let routing = run needsStaticResidualization(&mut resolver.*, &mut owner.*, &mut dependencies, &module, key.module, parent)
    let selected = match move routing {
      Result<bool, Shared<Rejection>>.Success {value} => value
      Result<bool, Shared<Rejection>>.Failure {error} => { return run rejectedBody(move error, move dependencies) }
    }
    if selected || literalKind(&enclosing) {
      let application = Application {target: SpecializationTarget.Named {declaration: DeclarationId.copy(&enclosing)},
        arguments: move arguments, argumentOrdinals: move ordinals, scopes: move scopes, statics: List<StaticSlot>.make()}
      let selectedParent = run internSelectedApplication(&mut resolver.*, &application)
      parentMember = selectedParent + usize.ONE
    }
  }
  let declarationAccess203Request = Key {
    family: Family.Body, module: key.module, name: usize.ZERO, declaration: parent, member: parentMember, external: false,
  }
  let declarationAccess203 = run internDeclaration(&mut resolver.*, declarationAccess203Request)
  let parentAnswer = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies, declarationAccess203, Span.make(usize.ZERO, usize.ZERO))
  let rejected = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(&parentAnswer, answerCause)
  if let Option<Shared<Rejection>>.Some {value} = move rejected { return run rejectedBody(move value, move dependencies) }
  let selected = Shared<Result<Answer, NoRejection>>.with<Option<AnonymousChild>>(&parentAnswer,
    fn(answer: &Result<Answer, NoRejection>) -> Option<AnonymousChild> { return anonymousChildAnswer(answer, identity) })
  if let Option<AnonymousChild>.Some {value} = move selected {
    return memberSuccess(Value.Body {body: move value.body}, move dependencies)
  }
  return run rejectedBody(run reject(&resolver.*, &module, RejectionCode.Unsupported, Span.make(usize.ZERO, usize.ZERO)), move dependencies)
}

// The bounds of the implementation enclosing member `declaration` become premises of its body, as
// the bootstrap checks `impl<T: Printable> Printable for Box<T>` members with `T: Printable`.
// Specialization proves them for each selected application before the member is reached.
// `Self: Contract<Binders>` for an operation declared, with its default body, in an interface or
// service; nothing for any other declaration.
effect fn appendContractSelfBound(resolver: &mut Resolver, module: &ModuleId, declaration: usize,
  constraints: &mut List<Constraint>) -> () ! Cycle | OutOfMemoryError ? &mut Allocator | &mut Types {
  let enclosing = match move run enclosingIdentity(&mut resolver.*, module, declaration) {
    Option<DeclarationId>.Some {value} => move value
    Option<DeclarationId>.None => { return () }
  }
  let kind = DeclarationId.kind(&enclosing)
  if kind != OwnerKind.Service && kind != OwnerKind.Interface { return () }
  let enclosingShared = run Shared<DeclarationId>.make(DeclarationId.copy(&enclosing))
  let parent = match move run ordinalOfIdentity(&mut resolver.*, module, &enclosingShared) {
    Option<usize>.Some {value} => value
    Option<usize>.None => { return () }
  }
  let binders = match move run templateBinders(&mut resolver.*, module, parent) {
    Result<List<Binder>, Shared<Rejection>>.Success {value} => move value
    Result<List<Binder>, Shared<Rejection>>.Failure {..} => { return () }
  }
  let written = List<Binder>.asSlice(&binders)
  let mut arguments = List<Argument>.make()
  let mut at = usize.ZERO
  while at < written.length {
    run List<Argument>.append(&mut arguments, run binderArgument(&written[at]))
    at = at + usize.ONE
  }
  // The contract type carries the declaration's own visibility, as every resolved spelling of it does.
  let mut isPublic = true
  if let Option<HeaderSyntax>.Some {value} = move run header(&mut resolver.*, module, parent) {
    isPublic = match value.header {
      Node.InterfaceHeader {isPublic: declaredPublic, ..} => declaredPublic
      Node.ServiceHeader {isPublic: declaredPublic, ..} => declaredPublic
      _ => true
    }
  }
  let provider = run Types.intern(Type.Parameter {declaration: DeclarationId.copy(&enclosing), ordinal: written.length})
  let contract = run Types.intern(Type.Nominal {declaration: move enclosing, isPublic: isPublic, arguments: move arguments})
  return run List<Constraint>.append(&mut constraints.*, Constraint.Conforms {provider: move provider, contract: move contract})
}

effect fn appendHeadBounds(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, dependencies: &mut List<Dependency>,
  module: &ModuleId, moduleOrdinal: usize, declaration: usize, claimed: bool, constraints: &mut List<Constraint>,
) -> Option<Shared<Rejection>> ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let enclosing = match move run enclosingIdentity(&mut resolver.*, module, declaration) {
    Option<DeclarationId>.Some {value} => move value
    Option<DeclarationId>.None => { return Option<Shared<Rejection>>.none() }
  }
  if DeclarationId.kind(&enclosing) != OwnerKind.Implementation { return Option<Shared<Rejection>>.none() }
  let enclosingShared = run Shared<DeclarationId>.make(move enclosing)
  let parent = match move run ordinalOfIdentity(&mut resolver.*, module, &enclosingShared) {
    Option<usize>.Some {value} => value
    Option<usize>.None => { fail InvalidModulePath {} }
  }
  let declarationAccess204Request = Key {family: Family.ImplementationHead,
    module: moduleOrdinal, name: usize.ZERO, declaration: parent, member: usize.ZERO, external: false}
  let declarationAccess204 = run internDeclaration(&mut resolver.*, declarationAccess204Request)
  let answer = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, declarationAccess204,
    Span.make(usize.ZERO, usize.ZERO))
  let rejected = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(&answer, answerCause)
  if let Option<Shared<Rejection>>.Some {value} = move rejected { return Option<Shared<Rejection>>.some(move value) }
  let head = match move Shared<Result<Answer, NoRejection>>.with<Option<Shared<ImplementationHead>>>(&answer, headOf) {
    Option<Shared<ImplementationHead>>.Some {value} => move value
    Option<Shared<ImplementationHead>>.None => { fail InvalidModulePath {} }
  }
  let count = Shared<ImplementationHead>.with<usize>(&head,
    fn(value: &ImplementationHead) -> usize { return List<Constraint>.length(&value.binders.constraints) })
  let mut at = usize.ZERO
  while at < count {
    let bound = Shared<ImplementationHead>.with<Option<Constraint>>(&head, fn(value: &ImplementationHead) -> Option<Constraint> {
      let listed = List<Constraint>.asSlice(&value.binders.constraints)
      return Option<Constraint>.some(copyConstraint(&listed[at]))
    })
    if let Option<Constraint>.Some {value} = move bound { run List<Constraint>.append(&mut constraints.*, move value) }
    at = at + usize.ONE
  }
  // A conformance's member signatures may assume the conformance they declare, as
  // `impl Domain for Concrete` spells `Values<Self>` where `Values<T: Domain>`; proving it would
  // wait on this same head. A body does not: there it would answer the body's own interface calls.
  if !claimed { return Option<Shared<Rejection>>.none() }
  let claim = Shared<ImplementationHead>.with<Option<Constraint>>(&head, fn(value: &ImplementationHead) -> Option<Constraint> {
    let conforms = match &value.kind {
      ImplementationKind.Conformance => true
      _ => false
    }
    if !conforms { return Option<Constraint>.none() }
    if let Option<Shared<Type>>.Some {value: contract} = &value.contract {
      return Option<Constraint>.some(Constraint.Conforms {provider: Shared<Type>.clone(&value.provider),
        contract: Shared<Type>.clone(&contract)})
    }
    return Option<Constraint>.none()
  })
  if let Option<Constraint>.Some {value} = move claim { run List<Constraint>.append(&mut constraints.*, move value) }
  return Option<Shared<Rejection>>.none()
}

// Owned state crossing body preparation, recursive checking, and final validation.
// Each phase keeps its temporary results out of the next phase's active native frame.
struct BodyCheckInput {
  module: ModuleId,
  signatureAnswer: Shared<Result<Answer, NoRejection>>,
  resultType: Shared<Type>,
  constraints: List<Constraint>,
  sourceAnswer: Shared<Result<SourceResult, NoRejection>>,
  annotations: List<ResolvedAnnotation>,
  resolvedCalls: List<ResolvedCall>,
  staticIterations: List<StaticIteration>,
  block: HirId,
  identity: DeclarationId,
  locals: List<BodyLocal>,
  initialLocals: usize,
  nodes: List<BodyNode>,
  signatureDependencies: List<SignatureDependency>,
  requiredBodies: List<DeclarationId>,
  cursor: AuthoredCursor,
  abstractBody: bool,
  staticBody: bool,
  parameterCount: usize,
  dependencies: List<Dependency>,
}

union BodyPreparation {
  Complete {answer: Answer},
  Check {input: BodyCheckInput},
}

struct BodyFinishInput {
  module: ModuleId,
  signatureAnswer: Shared<Result<Answer, NoRejection>>,
  resultType: Shared<Type>,
  constraints: List<Constraint>,
  sourceAnswer: Shared<Result<SourceResult, NoRejection>>,
  staticIterations: List<StaticIteration>,
  block: HirId,
  identity: DeclarationId,
  locals: List<BodyLocal>,
  initialLocals: usize,
  nodes: List<BodyNode>,
  signatureDependencies: List<SignatureDependency>,
  requiredBodies: List<DeclarationId>,
  cursor: AuthoredCursor,
  abstractBody: bool,
  staticBody: bool,
  dependencies: List<Dependency>,
  control: CheckedControl,
  shortened: List<Span>,
  resolutions: List<BodyResolution>,
}

effect fn resolveBody(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  key: Key,
) -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  // A receiver call's static arguments are evaluated once the checker has found its callee: the
  // check reports the call, and the body is selected and checked again with its slots.
  let mut hints = List<StaticCallHint>.make()
  let outer = Intrinsic.replace(resolver.discoveredStaticCall, Option<StaticCallHint>.none())
  while true {
    let prepared = run prepareBodyQuery(&mut resolver.*, &mut owner.*, key, List<StaticCallHint>.asSlice(&hints))
    let answer = match move prepared {
      BodyPreparation.Complete {answer} => move answer
      BodyPreparation.Check {input} => run checkPreparedBody(&mut resolver.*, &mut owner.*, key, move input)
    }
    let discovered = Intrinsic.replace(resolver.discoveredStaticCall, Option<StaticCallHint>.none())
    if let Option<StaticCallHint>.Some {value: hint} = move discovered {
      if key.member != usize.ZERO && !hinted(List<StaticCallHint>.asSlice(&hints), hint.call) && List<StaticCallHint>.length(&hints) < 4096 {
        run List<StaticCallHint>.append(&mut hints, move hint)
        drop answer
        continue
      }
    }
    resolver.discoveredStaticCall = move outer
    return move answer
  }
  return absurd<Answer>()
}

fn hinted(hints: &[StaticCallHint], call: HirId) -> bool {
  let mut at = usize.ZERO
  while at < hints.length {
    if hints[at].call.index == call.index { return true }
    at = at + usize.ONE
  }
  return false
}

effect fn copyStaticCallHint(hint: &StaticCallHint) -> StaticCallHint ! OutOfMemoryError ? &mut Allocator {
  let mut slots = List<usize>.make()
  let mut types = List<Option<Shared<Type>>>.make()
  let listed = List<usize>.asSlice(&hint.slots)
  let typed = List<Option<Shared<Type>>>.asSlice(&hint.types)
  let mut at = usize.ZERO
  while at < listed.length {
    run List<usize>.append(&mut slots, listed[at])
    let mut ty = Option<Shared<Type>>.none()
    if let Option<Shared<Type>>.Some {value} = &typed[at] { ty = Option<Shared<Type>>.some(Shared<Type>.clone(&value)) }
    run List<Option<Shared<Type>>>.append(&mut types, move ty)
    at = at + usize.ONE
  }
  return StaticCallHint {call: hint.call, slots: move slots, types: move types, offset: hint.offset}
}

effect fn prepareBodyQuery(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  key: Key,
  hints: &[StaticCallHint],
) -> BodyPreparation ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let literalModule = resolvedModule(&resolver.*, key.module)
  let declarationAccess205 = declarationPosition(&resolver.*, key)
  let literalIdentity = run declarationAt(&mut resolver.*, &literalModule, declarationAccess205)
  if let Option<DeclarationId>.Some {value} = move literalIdentity {
    if literalKind(&value) { return BodyPreparation.Complete {answer: run resolveAnonymousBody(&mut resolver.*, &mut owner.*, key, &value)}}
  }
  let module = resolvedModule(&resolver.*, key.module)
  let signatureKey = Key {
    family: Family.Signature,
    module: key.module,
    name: usize.ZERO,
    declaration: key.declaration,
    member: usize.ZERO,
    external: false,
  }
  let mut dependencies = List<Dependency>.make()
  let signatureAnswer = run demandChild(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies,
    signatureKey,
    Span.make(usize.ZERO, usize.ZERO),
  )
  let signatureFailure = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(
    &signatureAnswer,
    answerCause,
  )
  if let Option<Shared<Rejection>>.Some {value} = move signatureFailure {
    return BodyPreparation.Complete {answer: run rejectedBody(move value, move dependencies)}
  }
  let selectedResult = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(
    &signatureAnswer,
    signatureResult,
  )
  let resultType = match move selectedResult {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => {
      return BodyPreparation.Complete {answer: run rejectedBody(
        run reject(
          &resolver.*,
          &module,
          RejectionCode.Unsupported,
          Span.make(usize.ZERO, usize.ZERO),
        ),
        move dependencies,
      )}
    }
  }
  let parameterCount = Shared<Result<Answer, NoRejection>>.with<usize>(
    &signatureAnswer,
    signatureParameterCount,
  )
  let binderCount = Shared<Result<Answer, NoRejection>>.with<usize>(
    &signatureAnswer,
    signatureBinderCount,
  )
  let mut contractBody = binderCount > usize.ZERO || !Shared<Type>.with<bool>(
    &resultType,
    scalarType,
  )
  let declarationAccess206 = declarationPosition(&resolver.*, key)
  let constraints = match move run bodyPremises(&mut resolver.*, &mut owner.*, &mut dependencies, key.module, declarationAccess206) {
    Result<List<Constraint>, Shared<Rejection>>.Success {value} => move value
    Result<List<Constraint>, Shared<Rejection>>.Failure {error} => {
      return BodyPreparation.Complete {answer: run rejectedBody(move error, move dependencies)}
    }
  }
  let sourcePosition = declarationPosition(&resolver.*, key)
  let sourceAnswer = run observedDeclaration(&mut resolver.*, &module, sourcePosition, SourceFacet.Body)
  let facts = run takeBodyFacts(&mut resolver.*, &mut owner.*, &mut dependencies, &module, key.module, sourcePosition)
  let bodyFacts = match move facts {
    Result<TakenFacts, Shared<Rejection>>.Success {value: taken} => move taken.facts
    Result<TakenFacts, Shared<Rejection>>.Failure {error} => {
      return BodyPreparation.Complete {answer: run rejectedBody(move error, move dependencies)}
    }
  }
  let BodyFacts {annotations, calls: writtenFacts} = move bodyFacts
  let mut resolvedCalls = move writtenFacts
  let mut staticIterations = List<StaticIteration>.make()
  // A Body key whose member names a selected application checks only that selection's residual.
  if key.member != usize.ZERO && !Shared<Result<Answer, NoRejection>>.with<bool>(&signatureAnswer, signatureIsStatic) {
    // Selection runs inside the complete semantic application, so generic and scoped bodies
    // reach the static callees their own bindings select.
    let application = run selectedApplicationAt(&resolver.*, key.member - usize.ONE)
    let selection = run selectionFacts(&mut resolver.*, &mut owner.*, &mut dependencies, &module, &application, hints)
    match move selection {
      Result<List<ResolvedCall>, Shared<Rejection>>.Success {value: selectedSet} => {
        let selectedFacts = List<ResolvedCall>.asSlice(&selectedSet)
        let mut factAt = usize.ZERO
        while factAt < selectedFacts.length {
          let fact = selectedFact(selectedFacts, selectedFacts[factAt].id)
          if let Option<SelectionFact>.Some {value} = move fact {
            run List<ResolvedCall>.append(&mut resolvedCalls, ResolvedCall {
              id: selectedFacts[factAt].id,
              result: Result<ResolvedTarget, Shared<Rejection>>.succeed(ResolvedTarget.Selected {fact: move value}),
            })
          }
          factAt = factAt + usize.ONE
        }
      }
      Result<List<ResolvedCall>, Shared<Rejection>>.Failure {error} => {
        return BodyPreparation.Complete {answer: run rejectedBody(move error, move dependencies)}
      }
    }
  }
  let declarationAccess210 = declarationPosition(&resolver.*, key)
  let prepared = match move sourceOf(&resolver.*, &sourceAnswer, &module) {
    Option<&IndexedSource>.Some {value: indexed} => run prepareBody(
      &resolver.*,
      &module,
      indexed,
      declarationAccess210,
      &signatureAnswer,
      parameterCount,
      contractBody,
      key.member != usize.ZERO,
    )
    Option<&IndexedSource>.None => Result<PreparedBody, Shared<Rejection>>.failResult(
      run reject(&resolver.*, &module, RejectionCode.Unsupported, Span.make(usize.ZERO, usize.ZERO)),
    )
  }
  let preparedBody = match move prepared {
    Result<PreparedBody, Shared<Rejection>>.Success {value} => move value
    Result<PreparedBody, Shared<Rejection>>.Failure {error} => {
      return BodyPreparation.Complete {answer: run rejectedBody(move error, move dependencies)}
    }
  }
  let PreparedBody {block, identity, locals: preparedLocals, contractBody: abstractBody, staticBody} = move preparedBody
  let mut locals = move preparedLocals
  let initialLocals = List<BodyLocal>.length(&locals)
  let mut nodes = List<BodyNode>.make()
  let mut signatureDependencies = List<SignatureDependency>.make()
  run List<SignatureDependency>.append(
    &mut signatureDependencies,
    SignatureDependency {declaration: DeclarationId.copy(&identity)},
  )
  let mut requiredBodies = List<DeclarationId>.make()
  let opened = run SourceIndex.authoredCursor(&mut resolver.source, &sourceAnswer, &module)
  let declarationAccess211 = declarationPosition(&resolver.*, key)
  let available = anchoredCursor(&resolver.source, move opened, declarationAccess211)
  let cursor = match move available {
    Option<AuthoredCursor>.Some {value} => move value
    Option<AuthoredCursor>.None => {
      return BodyPreparation.Complete {answer: run rejectedBody(
        run reject(
          &resolver.*,
          &module,
          RejectionCode.Unsupported,
          Span.make(usize.ZERO, usize.ZERO),
        ),
        move dependencies,
      )}
    }
  }
  return BodyPreparation.Check {input: BodyCheckInput {
    module: move module,
    signatureAnswer: move signatureAnswer,
    resultType: move resultType,
    constraints: move constraints,
    sourceAnswer: move sourceAnswer,
    annotations: move annotations,
    resolvedCalls: move resolvedCalls,
    staticIterations: move staticIterations,
    block: block,
    identity: move identity,
    locals: move locals,
    initialLocals: initialLocals,
    nodes: move nodes,
    signatureDependencies: move signatureDependencies,
    requiredBodies: move requiredBodies,
    cursor: move cursor,
    abstractBody: abstractBody,
    staticBody: staticBody,
    parameterCount: parameterCount,
    dependencies: move dependencies,
  }}
}

// The first move or loan conflict of a runtime body rejected for statements it recovered past. A
// recovered statement ends every path through it, so a conflict found here has its move or loan
// and its use on a path of checked statements only. Only conflicts between a move or loan and its
// use are kept; a lifetime bound or a fact that could not be built adds nothing to a body that is
// rejected anyway.
effect fn recoveredOwnership(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, dependencies: &mut List<Dependency>,
  module: &ModuleId, cursor: &AuthoredCursor, identity: &DeclarationId, signatures: &[Shared<Result<Answer, NoRejection>>],
  result: &Shared<Type>, failure: &Shared<Type>, parameters: usize, locals: &[BodyLocal], nodes: &[BodyNode],
  constraints: &[Constraint], root: BodyNodeId) -> Option<Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let anchor = run cursorAnchor(cursor)
  let facts = match move run regionFacts(&mut resolver.*, &mut owner.*, &mut dependencies.*, identity, signatures, result, failure,
    parameters, locals, nodes, root, constraints, &anchor) {
    Result<RegionFacts, Shared<Rejection>>.Success {value} => move value
    Result<RegionFacts, Shared<Rejection>>.Failure {..} => { return Option<Shared<Rejection>>.none() }
  }
  if run Progress.due(&resolver.progress) {
    let shown = run shownName(&mut resolver.*, identity)
    run Progress.show(&mut resolver.progress, Bytes.asSlice(&shown))
  }
  run Progress.enterBorrowCheck(&mut resolver.progress)
  let verdict = run checkRegions(&regionInput(&facts, identity, locals, nodes, root))
  run Progress.leaveBorrowCheck(&mut resolver.progress)
  if Progress.timing(&resolver.progress) {
    let timed = run shownName(&mut resolver.*, identity)
    run Progress.timeBorrowCheck(&mut resolver.progress, Bytes.asSlice(&timed))
  }
  if verdict.outcome != RegionOutcome.Conflict || !pathConflict(verdict.code) { return Option<Shared<Rejection>>.none() }
  let mut related = Option<RelatedSite>.none()
  if let Option<Location>.Some {value: earlier} = &verdict.earlier {
    related = Option<RelatedSite>.some(RelatedSite {module: ModuleId.copy(module), span: Anchor.span(&anchor, earlier)})
  }
  return Option<Shared<Rejection>>.some(run rejectWithRelated(&resolver.*, module, verdict.code, Anchor.span(&anchor, verdict.access), move related))
}

// Whether a borrow-check conflict needs only the path from its move or loan to its use.
fn pathConflict(code: RejectionCode) -> bool {
  return match code {
    RejectionCode.UseAfterMove => true
    RejectionCode.LoanConflict => true
    RejectionCode.AccessDuringLoan => true
    RejectionCode.OverlappingAssignment => true
    RejectionCode.GuardConsumesPattern => true
    _ => false
  }
}

// Places `diagnostic` before the first listed diagnostic that starts after it.
effect fn insertByPosition(diagnostics: &mut List<Shared<Rejection>>, diagnostic: Shared<Rejection>) -> () ! OutOfMemoryError ? &mut Allocator {
  let start = Shared<Rejection>.with<usize>(&diagnostic, rejectionStart)
  let mut ordered = List<Shared<Rejection>>.make()
  let mut pending = Option<Shared<Rejection>>.some(move diagnostic)
  let listed = List<Shared<Rejection>>.asSlice(&diagnostics.*)
  let mut at = usize.ZERO
  while at < listed.length {
    if Shared<Rejection>.with<usize>(&listed[at], rejectionStart) > start {
      if let Option<Shared<Rejection>>.Some {value} = move pending { run List<Shared<Rejection>>.append(&mut ordered, move value) }
      pending = Option<Shared<Rejection>>.none()
    }
    run List<Shared<Rejection>>.append(&mut ordered, Shared<Rejection>.clone(&listed[at]))
    at = at + usize.ONE
  }
  if let Option<Shared<Rejection>>.Some {value} = move pending { run List<Shared<Rejection>>.append(&mut ordered, move value) }
  diagnostics.* = move ordered
  return ()
}

fn rejectionStart(rejection: &Rejection) -> usize {
  return rejection.span.start
}

effect fn checkPreparedBody(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, key: Key, input: BodyCheckInput)
-> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let BodyCheckInput {module, signatureAnswer, resultType, constraints, sourceAnswer, annotations, resolvedCalls, staticIterations: preparedIterations, block, identity, locals: preparedLocals, initialLocals, nodes: preparedNodes, signatureDependencies: preparedSignatureDependencies, requiredBodies: preparedRequiredBodies, cursor, abstractBody, staticBody, parameterCount, dependencies: preparedDependencies} = move input
  let mut staticIterations = move preparedIterations
  let mut locals = move preparedLocals
  let mut nodes = move preparedNodes
  let mut signatureDependencies = move preparedSignatureDependencies
  let mut requiredBodies = move preparedRequiredBodies
  let mut dependencies = move preparedDependencies
  let mut operationRequest = Request.make()
  run enterBodyFrame(&mut resolver.*, &signatureAnswer, true, Option<AuthoredCursor>.some(AuthoredCursor.copy(&cursor)))
  if declaredTest(&resolver.*, &sourceAnswer, &module, key) { run markTestBody(&mut resolver.*) }
  if staticBody {
    run selectStaticBodyApplication(&mut resolver.*, &mut owner.*, &mut operationRequest, &mut dependencies,
      key, parameterCount, &signatureAnswer, &identity, &cursor, block)
  }
  let checked = run checkBlockList(
    &mut resolver.*,
    &mut owner.*,
    &mut operationRequest,
    &mut dependencies,
    &module,
    &cursor,
    &identity,
    &mut locals,
    List<ResolvedAnnotation>.asSlice(&annotations),
    List<ResolvedCall>.asSlice(&resolvedCalls),
    &mut nodes,
    &mut signatureDependencies,
    &mut requiredBodies,
    block,
    &resultType,
    List<Constraint>.asSlice(&constraints),
    abstractBody,
    staticBody,
    usize.ZERO,
    false,
    &BlockTail.Discarded,
  )
  run takeOccurrenceFacts(&mut resolver.*, &mut staticIterations)
  let closed = closeBodyFrame(&mut resolver.*)
  let ClosedBody {recovered, shortened} = move closed
  let control = match move checked {
    BlockList.Checked {control} => move control
    BlockList.Recovered {control, failure} => {
      // Static bodies stop at their first failed statement.
      if staticBody { return CompilerBug.panic(b"a static body recovered a statement") }
      // The body is rejected: its ownership conflict on the paths around the recovered
      // statements joins what typing reported, and nothing else of it is used.
      let mut diagnostics = run failedBodyDiagnostics(move recovered, move failure)
      let mut signatures = List<Shared<Result<Answer, NoRejection>>>.make()
      run List<Shared<Result<Answer, NoRejection>>>.append(&mut signatures, Shared<Result<Answer, NoRejection>>.clone(&signatureAnswer))
      let failureType = run signatureFailure(&signatureAnswer)
      let conflict = run recoveredOwnership(&mut resolver.*, &mut owner.*, &mut dependencies, &module, &cursor,
        &identity, List<Shared<Result<Answer, NoRejection>>>.asSlice(&signatures), &resultType, &failureType, initialLocals,
        List<BodyLocal>.asSlice(&locals), List<BodyNode>.asSlice(&nodes), List<Constraint>.asSlice(&constraints), control.node)
      if let Option<Shared<Rejection>>.Some {value} = move conflict { run insertByPosition(&mut diagnostics, move value) }
      // An editor still resolves the statements around the ones that failed.
      let mut partial = Option<Shared<TypedBody>>.none()
      if resolver.editorTables {
        let resolutions = run editorResolutions(&resolver.source, &cursor, List<ResolvedAnnotation>.asSlice(&annotations),
          List<ResolvedCall>.asSlice(&resolvedCalls), List<BodyNode>.asSlice(&nodes))
        let body = run TypedBody.make(&identity, move locals, move nodes, control.node, move signatureDependencies,
          move requiredBodies, BodyStage.ContractTyped, move staticIterations)
        partial = Option<Shared<TypedBody>>.some(run Shared<TypedBody>.make(TypedBody.withResolutions(move body, move resolutions)))
      }
      return partialBodyDiagnostics(move diagnostics, move partial, move dependencies)
    }
    BlockList.Failed {error} => {
      return rejectedBodyDiagnostics(run failedBodyDiagnostics(move recovered, move error), move dependencies)
    }
  }
  if List<Shared<Rejection>>.length(&recovered) != usize.ZERO { return CompilerBug.panic(b"a checked body recovered a diagnostic") }
  // A static body runs at compile time over static values; like the borrow check, the move
  // requirement covers runtime bodies.
  if !staticBody {
    let implicit = run implicitAffineUse(&mut resolver.*, &mut owner.*, &mut dependencies, &module, &cursor,
      List<BodyNode>.asSlice(&nodes), List<Constraint>.asSlice(&constraints), &run cursorAnchor(&cursor))
    if let Option<Shared<Rejection>>.Some {value: rejection} = move implicit {
      return run rejectedBody(move rejection, move dependencies)
    }
  }
  let mut resolutions = List<BodyResolution>.make()
  if resolver.editorTables {
    resolutions = run editorResolutions(&resolver.source, &cursor, List<ResolvedAnnotation>.asSlice(&annotations),
      List<ResolvedCall>.asSlice(&resolvedCalls), List<BodyNode>.asSlice(&nodes))
  }
  return run finishCheckedBody(&mut resolver.*, &mut owner.*, key, BodyFinishInput {
    module: move module,
    signatureAnswer: move signatureAnswer,
    resultType: move resultType,
    constraints: move constraints,
    sourceAnswer: move sourceAnswer,
    staticIterations: move staticIterations,
    block: block,
    identity: move identity,
    locals: move locals,
    initialLocals: initialLocals,
    nodes: move nodes,
    signatureDependencies: move signatureDependencies,
    requiredBodies: move requiredBodies,
    cursor: move cursor,
    abstractBody: abstractBody,
    staticBody: staticBody,
    dependencies: move dependencies,
    control: move control,
    shortened: move shortened,
    resolutions: move resolutions,
  })
}

// The names a checked body's own syntax resolves, for an editor: the types its annotations write,
// the declarations its calls and value reads select, and the locals, fields and receiver members
// its nodes use.
effect fn editorResolutions(source: &SourceIndex, cursor: &AuthoredCursor, annotations: &[ResolvedAnnotation],
  calls: &[ResolvedCall], nodes: &[BodyNode]) -> List<BodyResolution>
! RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let mut resolutions = List<BodyResolution>.make()
  let mut at = usize.ZERO
  while at < annotations.length {
    if let Result<Shared<Type>, Shared<Rejection>>.Success {value: ty} = &annotations[at].result {
      run List<BodyResolution>.append(&mut resolutions, BodyResolution {origin: run bodyOrigin(source, cursor, annotations[at].id),
        referent: BodyReferent.Type {ty: Shared<Type>.clone(&ty)}})
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < calls.length {
    let selected = match &calls[at].result {
      Result<ResolvedTarget, Shared<Rejection>>.Success {value: ResolvedTarget.Function {target}} => Option<DeclarationId>.some(DeclarationId.copy(&target.declaration))
      Result<ResolvedTarget, Shared<Rejection>>.Success {value: ResolvedTarget.Constant {declaration, ..}} => Option<DeclarationId>.some(DeclarationId.copy(&declaration))
      Result<ResolvedTarget, Shared<Rejection>>.Success {value: ResolvedTarget.ForeignStatic {declaration, ..}} => Option<DeclarationId>.some(DeclarationId.copy(&declaration))
      _ => Option<DeclarationId>.none()
    }
    if let Option<DeclarationId>.Some {value: declaration} = move selected {
      let name = run writtenName(source, cursor, calls[at].id)
      run List<BodyResolution>.append(&mut resolutions, BodyResolution {origin: run bodyOrigin(source, cursor, name),
        referent: BodyReferent.Declaration {declaration: run Shared<DeclarationId>.make(move declaration)}})
    }
    at = at + usize.ONE
  }
  let anchor = run cursorAnchor(cursor)
  at = usize.ZERO
  while at < nodes.length {
    let origin = nodes[at].origin
    match &nodes[at].kind {
      BodyNodeKind.Expression {form: BodyExpression.Local {local}, ..} => {
        run List<BodyResolution>.append(&mut resolutions, BodyResolution {origin: origin, referent: BodyReferent.Local {local: local}})
      }
      BodyNodeKind.Expression {form: BodyExpression.Field {value, index, ..}, ..} => {
        if let BodyNodeKind.Expression {ty: owner, ..} = &nodes[value.index].kind {
          if let Node.FieldExpression {field, ..} = run bodyNode(source, cursor, BodyOrigin.syntax(origin, &anchor)) {
            run List<BodyResolution>.append(&mut resolutions, BodyResolution {origin: run bodyOrigin(source, cursor, field),
              referent: BodyReferent.Field {owner: Shared<Type>.clone(&owner), index: index}})
          }
        }
      }
      BodyNodeKind.Expression {form: BodyExpression.DirectCall {declaration, receiverPass: Option<BodyReceiverPass>.Some {..}, ..}, ..} => {
        run appendReceiverMember(source, cursor, &anchor, origin, &declaration, &mut resolutions)
      }
      BodyNodeKind.Expression {form: BodyExpression.InterfaceCall {operation, receiverPass: Option<BodyReceiverPass>.Some {..}, ..}, ..} => {
        run appendReceiverMember(source, cursor, &anchor, origin, &operation, &mut resolutions)
      }
      _ => ()
    }
    at = at + usize.ONE
  }
  return move resolutions
}

// A receiver call's member name, as `push` in `items.push(value)`, selects `declaration`.
effect fn appendReceiverMember(source: &SourceIndex, cursor: &AuthoredCursor, anchor: &Anchor, origin: BodyOrigin,
  declaration: &DeclarationId, resolutions: &mut List<BodyResolution>) -> ()
! RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  if let Option<CallInput>.Some {value: input} = move CallInput.ofNode(run bodyNode(source, cursor, BodyOrigin.syntax(origin, anchor))) {
    if let Node.FieldExpression {field, ..} = run bodyNode(source, cursor, input.callee) {
      run List<BodyResolution>.append(&mut resolutions.*, BodyResolution {origin: run bodyOrigin(source, cursor, field),
        referent: BodyReferent.Declaration {declaration: run Shared<DeclarationId>.make(DeclarationId.copy(declaration))}})
    }
  }
  return ()
}

// The name a call or value read writes for its target: the callee's last segment, as `length` in
// `List.length(items)`, or the identifier itself.
effect fn writtenName(source: &SourceIndex, cursor: &AuthoredCursor, id: HirId) -> HirId ! RevisionMismatch {
  let mut named = id
  if let Option<CallInput>.Some {value: input} = move CallInput.ofNode(run bodyNode(source, cursor, id)) {
    named = input.callee
  }
  return match run bodyNode(source, cursor, named) {
    Node.IdentifierExpression {name, ..} => name
    Node.FieldExpression {field, ..} => field
    _ => named
  }
}

effect fn selectStaticBodyApplication(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  operationRequest: &mut Request,
  dependencies: &mut List<Dependency>,
  key: Key,
  parameterCount: usize,
  signatureAnswer: &Shared<Result<Answer, NoRejection>>,
  identity: &DeclarationId,
  cursor: &AuthoredCursor,
  block: HirId,
) -> () ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut staticApplication = Option<Application>.none()
  if key.member != usize.ZERO {
    staticApplication = Option<Application>.some(run selectedApplicationAt(&resolver.*, key.member - usize.ONE))
  } else if parameterCount == usize.ZERO && Shared<Result<Answer, NoRejection>>.with<usize>(signatureAnswer, signatureBinderCount) == usize.ZERO {
    // A closed, zero-argument static declaration needs no caller specialization. Preserve
    // ordinary Body queries for these declarations while refusing any missing owner slots.
    let applicationSpan = run bodySpan(&resolver.source, cursor, block)
    let schema = run resolveTargetSchema(&mut resolver.*, &mut owner.*, &mut operationRequest.*,
      &mut dependencies.*, true, identity, applicationSpan)
    if let Option<TargetSchema>.Some {value: targetSchema} = move schema {
      let application = Application {target: SpecializationTarget.Named {declaration: DeclarationId.copy(identity)},
        arguments: List<Argument>.make(), argumentOrdinals: List<usize>.make(),
        scopes: List<ScopeBinding>.make(), statics: List<StaticSlot>.make()}
      if run TargetSchema.accepts(&targetSchema, &application) {
        staticApplication = Option<Application>.some(move application)
      }
    }
  }
  let mut frames = List<BodyFrame>.asMutSlice(&mut resolver.bodies)
  frames[frames.length - usize.ONE].staticApplication = move staticApplication
  return ()
}

effect fn finishCheckedBody(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, key: Key, finished: BodyFinishInput)
-> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let BodyFinishInput {module, signatureAnswer, resultType, constraints, sourceAnswer, staticIterations: preparedIterations, block, identity, locals: preparedLocals, initialLocals, nodes: preparedNodes, signatureDependencies: preparedSignatureDependencies, requiredBodies: preparedRequiredBodies, cursor, abstractBody, staticBody, dependencies: preparedDependencies, control, shortened, resolutions} = move finished
  let mut staticIterations = move preparedIterations
  let mut locals = move preparedLocals
  let mut nodes = move preparedNodes
  let mut signatureDependencies = move preparedSignatureDependencies
  let mut requiredBodies = move preparedRequiredBodies
  let mut dependencies = move preparedDependencies
  let family = Shared<Type>.with<Option<Shared<Type>>>(&resultType, effectFamilyContract)
  let declarationAccess212 = declarationPosition(&resolver.*, key)
  if !run writtenOpaqueResult(&mut resolver.*, &module, declarationAccess212) {
    if let Option<Shared<Type>>.Some {value: contract} = move family {
      let refused = run joinEffectReturns(&resolver.*, &module, &mut nodes, &contract, &run cursorAnchor(&cursor))
      if let Option<Shared<Rejection>>.Some {value} = move refused { return run rejectedBody(move value, move dependencies) }
    }
  }
  let availability = run captureAvailability(&resolver.*, &module, &cursor, List<BodyNode>.asSlice(&nodes), control.node, initialLocals, List<Constraint>.asSlice(&constraints))
  if let Option<Shared<Rejection>>.Some {value} = move availability {
    return run rejectedBody(move value, move dependencies)
  }
  if staticBody {
    let violation = run staticPhaseViolation(&mut resolver.*, List<BodyNode>.asSlice(&nodes), &run cursorAnchor(&cursor))
    if let Option<StaticCallViolation>.Some {value: violating} = move violation {
      if violating.ordinary {
        return run rejectedBody(run runtimeCallRejection(&module, violating.span), move dependencies)
      }
      return run rejectedBody(run reject(&resolver.*, &module, RejectionCode.StaticPhaseViolation, violating.span), move dependencies)
    }
    requiredBodies = List<DeclarationId>.make()
  }
  if control.canComplete && Shared<Type>.with<usize>(&resultType, scalarCode) != 1 {
    if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(
      &resolver.*,
      &sourceAnswer,
      &module,
    ) {
      let hir = IndexedSource.authored(indexed)
      let mut returnSpan = Module.span(hir, block)
      if Module.causeRange(hir, block).length == usize.ZERO && returnSpan.end > returnSpan.start {
        returnSpan = Span.make(returnSpan.end - usize.ONE, returnSpan.end)
      }
      return run rejectedBody(
        run typeHoleRejection(&module, RejectionCode.MissingReturn, returnSpan, b"expected", &resultType),
        move dependencies,
      )
    }
    return run rejectedBody(
      run reject(&resolver.*, &module, RejectionCode.Unsupported, Span.make(usize.ZERO, usize.ZERO)),
      move dependencies,
    )
  }
  let needsObligations = abstractBody || bodyHasReceiverPass(List<BodyNode>.asSlice(&nodes)) || bodyHasLoans(List<BodyNode>.asSlice(&nodes))
  // No checker covers a static body yet: a body that needs its obligations stays contract-typed, and
  // each result-only call that shortened a binder is refused, since no proof can publish it.
  let mut stage = BodyStage.FullyChecked
  if staticBody {
    let refusals = run shortenedBodyRefusals(&resolver.*, &module, List<Span>.asSlice(&shortened))
    if List<Shared<Rejection>>.length(&refusals) != usize.ZERO {
      return rejectedBodyDiagnostics(move refusals, move dependencies)
    }
    if needsObligations { stage = BodyStage.ContractTyped }
  } else {
    let cleanupAnchor = run cursorAnchor(&cursor)
    let mut signatures = List<Shared<Result<Answer, NoRejection>>>.make()
    run List<Shared<Result<Answer, NoRejection>>>.append(&mut signatures, Shared<Result<Answer, NoRejection>>.clone(&signatureAnswer))
    let failureType = run signatureFailure(&signatureAnswer)
    let mut facts = match move run regionFacts(&mut resolver.*, &mut owner.*, &mut dependencies, &identity,
      List<Shared<Result<Answer, NoRejection>>>.asSlice(&signatures), &resultType, &failureType, initialLocals,
      List<BodyLocal>.asSlice(&locals), List<BodyNode>.asSlice(&nodes), control.node, List<Constraint>.asSlice(&constraints), &cleanupAnchor) {
      Result<RegionFacts, Shared<Rejection>>.Success {value} => move value
      Result<RegionFacts, Shared<Rejection>>.Failure {error} => { return run rejectedBody(move error, move dependencies) }
    }
    if key.member != usize.ZERO {
      let selected = run selectedApplicationAt(&resolver.*, key.member - usize.ONE)
      run selectedPremises(&selected, &identity, &mut facts.premises)
    }
    if run Progress.due(&resolver.progress) {
      let shown = run shownName(&mut resolver.*, &identity)
      run Progress.show(&mut resolver.progress, Bytes.asSlice(&shown))
    }
    run Progress.enterBorrowCheck(&mut resolver.progress)
    // The borrow check's working sets all die with it, so they come from a bump arena instead of
    // the heap; only the verdict outlives it, and it keeps its own chunks alive.
    let mut arena = Arena.withOptions(Allocator.systemAllocatorProvider(),
      ArenaOptions {firstChunkBytes: 65536, maximumChunkBytes: 65536})
    let verdict = run checkRegions(&regionInput(&facts, &identity, List<BodyLocal>.asSlice(&locals), List<BodyNode>.asSlice(&nodes), control.node))
      |> Effect.provideMut<Allocator>(&mut arena)
    run Progress.leaveBorrowCheck(&mut resolver.progress)
    if Progress.timing(&resolver.progress) {
      let timed = run shownName(&mut resolver.*, &identity)
      run Progress.timeBorrowCheck(&mut resolver.progress, Bytes.asSlice(&timed))
    }
    if verdict.outcome == RegionOutcome.Conflict {
      // Every conflict the body reports, ordered by span as the bootstrap lists them.
      let listed = List<RegionReport>.asSlice(&verdict.reports)
      let mut diagnostics = List<Shared<Rejection>>.make()
      let mut at = usize.ZERO
      while at < listed.length {
        let mut diagnostic = run makeRejection(listed[at].code, &module, Anchor.span(&cleanupAnchor, listed[at].access))
        if listed[at].related {
          diagnostic.related = Option<RelatedSite>.some(RelatedSite {module: ModuleId.copy(&module), span: Anchor.span(&cleanupAnchor, listed[at].earlier)})
        }
        // A conflicting borrow names the access of the rejected borrow and of the active loan.
        if listed[at].code == RejectionCode.LoanConflict {
          run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"requested"), value: run Bytes.copy(loanAccess(listed[at].requestedExclusive, true))})
          run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"existing"), value: run Bytes.copy(loanAccess(listed[at].existingExclusive, false))})
        }
        // An access during a loan says what it does to the borrowed place.
        if listed[at].code == RejectionCode.AccessDuringLoan {
          let verb = match listed[at].verb {
            RegionConflictVerb.Reading => b"Reading"
            RegionConflictVerb.Assigning => b"Assigning"
            RegionConflictVerb.Moving => b"Moving"
            RegionConflictVerb.Dropping => b"Dropping"
            RegionConflictVerb.Matching => b"Matching on"
          }
          run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"access"), value: run Bytes.copy(verb)})
        }
        // A value kept for `'static`, such as a fiber's child, that borrows from the body says so.
        if listed[at].code == RejectionCode.UnsatisfiedLifetimeBound && verdict.outlivesStatic {
          diagnostic.arguments = List<MessageArgument>.make()
          run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"template"), value: run Bytes.copy(b"1")})
        }
        run List<Shared<Rejection>>.append(&mut diagnostics, run Shared<Rejection>.make(move diagnostic))
        at = at + usize.ONE
      }
      return rejectedBodyDiagnostics(move diagnostics, move dependencies)
    }
  }
  if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(
    &resolver.*,
    &sourceAnswer,
    &module,
  ) {
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(indexed))
    let declarationAccess213 = declarationPosition(&resolver.*, key)
    let declaration = &declarations[declarationAccess213].identity
    let body = run TypedBody.make(
      declaration,
      move locals,
      move nodes,
      control.node,
      move signatureDependencies,
      move requiredBodies,
      move stage,
      move staticIterations,
    )
    return Answer {
      outcome: Outcome.Success {
        value: Value.Body {
          body: run Shared<TypedBody>.make(TypedBody.withResolutions(move body, move resolutions)),
        },
      },
      dependencies: move dependencies,
    }
  }
  return run rejectedBody(
    run reject(&resolver.*, &module, RejectionCode.Unsupported, Span.make(usize.ZERO, usize.ZERO)),
    move dependencies,
  )
}

fn hasRejection(answer: &Result<Answer, NoRejection>) -> bool {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Rejected {..} => true
      Outcome.Unavailable {..} => true
      Outcome.Success {value: _} => false
    }
    Result<Answer, NoRejection>.Failure {error: _} => false
  }
}

effect fn rejectRoot(
  resolver: &mut Resolver,
  module: &ModuleId,
  bucket: Key,
  code: RejectionCode,
  span: Span,
) -> Shared<Result<Answer, NoRejection>> ! Cycle | OutOfMemoryError ? &mut Allocator {
  let mut dependencies = List<Dependency>.make()
  run List<Dependency>.append(&mut dependencies, dependency(bucket))
  let diagnostic = run reject(&resolver.*, module, code, span)
  return run Shared<Result<Answer, NoRejection>>.make(
    Result<Answer, NoRejection>.succeed(
      Answer {
        outcome: run rejectedOutcome(move diagnostic),
        dependencies: move dependencies,
      },
    ),
  )
}

// Named demand roots retain the namespace selected by their query family.
fn missingRootName(family: Family) -> RejectionCode {
  return match family {
    Family.Signature => RejectionCode.UnknownFunction
    Family.Body => RejectionCode.UnknownFunction
    Family.Mir => RejectionCode.UnknownFunction
    Family.Constant => RejectionCode.UnknownName
    Family.Initializer => RejectionCode.UnknownName
    Family.ParameterSchema => RejectionCode.UnknownName
    Family.ParameterDefault => RejectionCode.UnknownName
    _ => RejectionCode.UnknownType
  }
}

effect fn demandNamed(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  module: &ModuleId,
  name: &[u8],
  family: Family,
) -> Shared<Result<Answer, NoRejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let moduleOrdinal = run internModule(&mut resolver.*, module)
  let nameOrdinal = run internName(&mut resolver.*, name)
  let declarationAccess214Request = Key {
    family: Family.Name,
    module: moduleOrdinal,
    name: nameOrdinal,
    declaration: usize.ZERO,
    member: usize.ZERO,
    external: false,
  }
  let declarationAccess214 = run internDeclaration(&mut resolver.*, declarationAccess214Request)
  let bucketKey = declarationAccess214
  let observed = run demandRaw(
    &mut resolver.*,
    &mut owner.*,
    bucketKey,
    Span.make(usize.ZERO, usize.ZERO),
  )
  if Shared<Result<Answer, NoRejection>>.with<bool>(&observed, hasRejection) {
    return move observed
  }
  drop observed
  // A root lookup observes governing conditions without a dependent answer.
  let mut rootConditions = List<Dependency>.make()
  let selectedSelection = run select(&mut resolver.*, &mut owner.*, &mut rootConditions, module, name, false)
  let selected = match move selectedSelection {
    Result<Selection, Shared<Rejection>>.Success {value: selectedValue} => selectedValue
    Result<Selection, Shared<Rejection>>.Failure {error} => {
      return run rootRejection(&mut resolver.*, module, move error)
    }
  }
  if selected.count != usize.ONE {
    let mut code = RejectionCode.Collision
    if selected.count == usize.ZERO {
      code = missingRootName(family)
    }
    return run rejectRoot(&mut resolver.*, module, bucketKey, code, selected.span)
  }
  if selected.kind != CandidateKind.Declaration {
    return run rejectRoot(
      &mut resolver.*,
      module,
      bucketKey,
      RejectionCode.Unsupported,
      selected.span,
    )
  }
  let mut backendName = usize.ZERO
  if family == Family.Mir {
    let declared = run declarationAt(&mut resolver.*, module, selected.declaration)
    let identity = match move declared {
      Option<DeclarationId>.Some {value} => run Shared<DeclarationId>.make(move value)
      Option<DeclarationId>.None => {
        return run rejectRoot(
          &mut resolver.*,
          module,
          bucketKey,
          RejectionCode.UnknownFunction,
          selected.span,
        )
      }
    }
    let instance = run InstanceKey.named(&identity)
    backendName = run internBackendInstance(&mut resolver.*, &instance, false)
  }
  let declarationAccess215Request = Key {
    family: family,
    module: moduleOrdinal,
    name: backendName,
    declaration: selected.declaration,
    member: usize.ZERO,
    external: false,
  }
  let declarationAccess215 = run internDeclaration(&mut resolver.*, declarationAccess215Request)
  let key = declarationAccess215
  return run demandRaw(&mut resolver.*, &mut owner.*, key, selected.span)
}

fn copyGoal(goal: &ConformanceGoal) -> ConformanceGoal {
  return ConformanceGoal {
    contract: Shared<Type>.clone(&goal.contract),
    provider: Shared<Type>.clone(&goal.provider),
  }
}

effect fn declaredGoal(constraints: &[Constraint], goal: &ConformanceGoal) -> Option<Constraint>
! OutOfMemoryError
? &mut Allocator | &mut Types {
  // A concrete application must establish real evidence even if its caller supplied a copied
  // constraint. Declared bounds are assumptions only for goals that still contain open binders.
  if !Type.hasOpenParameters(&goal.provider) && !Type.hasOpenParameters(&goal.contract) {
    return Option<Constraint>.none()
  }
  let mut at = usize.ZERO
  while at < constraints.length {
    if let Constraint.Conforms {provider, contract} = &constraints[at] {
      // Exact identity, including lifetimes and all interface arguments, is declared evidence.
      let sameProvider = run Type.equalsShared(&provider, &goal.provider)
      let sameContract = run Type.equalsShared(&contract, &goal.contract)
      if sameProvider && sameContract {
        return Option<Constraint>.some(
          Constraint.Conforms {
            provider: Shared<Type>.clone(&provider),
            contract: Shared<Type>.clone(&contract),
          },
        )
      }
    }
    at = at + usize.ONE
  }
  return Option<Constraint>.none()
}

fn matchedArgument(bindings: &[Binding], owner: &Shared<DeclarationId>, ordinal: usize) -> Option<
  Argument,
> {
  let mut at = usize.ZERO
  while at < bindings.length {
    if bindings[at].ordinal == ordinal && sameDeclarationShared(&bindings[at].declaration, owner) {
      return Option<Argument>.some(copyArgument(&bindings[at].value))
    }
    at = at + usize.ONE
  }
  return Option<Argument>.none()
}

// Re-resolve the written bounds under the exact head bindings. This uses the same canonical type
// resolver as declaration checking, including nested type, lifetime, and requirement-row arguments.
// No second type matcher or partial type substitution is introduced for proof.
effect fn appliedConstraints(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  head: &Shared<ImplementationHead>,
  bindings: &[Binding],
  goal: &ConformanceGoal,
) -> Result<List<Constraint>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let identity = Shared<ImplementationHead>.with<Shared<DeclarationId>>(
    head,
    fn(value: &ImplementationHead) -> Shared<DeclarationId> {
      return Shared<DeclarationId>.clone(&value.declaration)
    },
  )
  let moduleOrdinal = Shared<DeclarationId>.with<usize>(
    &identity,
    fn(value: &DeclarationId) -> usize {
      return knownModuleOrdinal(&resolver.*, DeclarationId.moduleId(value))
    },
  )
  if moduleOrdinal == usize.MAX {
    fail InvalidModulePath {}
  }
  let module = resolvedModule(&resolver.*, moduleOrdinal)
  let located = run ordinalOfIdentity(&mut resolver.*, &module, &identity)
  let ordinal = match move located {
    Option<usize>.Some {value} => value
    Option<usize>.None => {
      return CompilerBug.panic(b"MissingRetainedFact: appliedConstraints")
    }
  }
  let written = run scopedHeader(&mut resolver.*, &module, ordinal)
  let mut generics = Range.empty()
  let mut subject = HirId {index: usize.ZERO}
  let mut target = HirRef.absent()
  let mut clauses = Range.empty()
  let mut span = Span.make(usize.ZERO, usize.ZERO)
  if let Option<HeaderSyntax>.Some {value} = move written {
    span = value.span
    if let Node.ImplHeader {generics: parameters, subject: named, target: provided, constraints: headClauses} = value.header {
      generics = parameters
      subject = named
      target = provided
      clauses = headClauses
    }
  }
  if !target.present {
    return Result<List<Constraint>, Shared<Rejection>>.failResult(
      run reject(&resolver.*, &module, RejectionCode.Unsupported, span),
    )
  }
  let template = run templateBinders(&mut resolver.*, &module, ordinal)
  let formal = match move template {
    Result<List<Binder>, Shared<Rejection>>.Success {value} => move value
    Result<List<Binder>, Shared<Rejection>>.Failure {error} => {
      return Result<List<Constraint>, Shared<Rejection>>.failResult(move error)
    }
  }
  let mut arguments = List<Argument>.make()
  let writtenCount = List<Binder>.length(&formal)
  let mut retained = Option<GoalSlots>.none()
  let mut at = usize.ZERO
  while at < writtenCount {
    let found = matchedArgument(bindings, &identity, at)
    if let Option<Argument>.Some {value} = move found {
      run List<Argument>.append(&mut arguments, move value)
    } else {
      // The head's own parameter applies to itself, which proves none of its bounds.
      let binder = &List<Binder>.asSlice(&formal)[at]
      if !run goalFixes(&mut retained, goal, &identity, binderKind(binder), at) {
        return Result<List<Constraint>, Shared<Rejection>>.failResult(
          run reject(&resolver.*, &module, RejectionCode.Unsupported, span),
        )
      }
      run List<Argument>.append(&mut arguments, run binderArgument(binder))
    }
    at = at + usize.ONE
  }
  let applied = run bindArguments(
    List<Binder>.asSlice(&formal),
    List<Argument>.asSlice(&arguments),
  )
  let declared = run declarationAt(&mut resolver.*, &module, ordinal)
  let implementation = match move declared {
    Option<DeclarationId>.Some {value} => move value
    Option<DeclarationId>.None => {
      return CompilerBug.panic(b"MissingRetainedFact: appliedConstraints")
    }
  }
  let mut elision = LifetimeElision {
    owner: Option<DeclarationId>.some(move implementation),
    nextOrdinal: writtenCount,
    output: false,
    resultDefault: Option<Shared<Lifetime>>.none(),
    generated: List<Shared<Lifetime>>.make(),
    invocation: false,
    nested: false,
    renumber: List<usize>.make(),
    staticEnvironment: false,
    supplied: Option<List<Argument>>.none(),
    assumptions: Option<List<Constraint>>.none(),
    deferred: Option<List<DeferredBounds>>.none(),
  }
  let bounds = run resolveConstraints(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies.*,
    moduleOrdinal,
    &module,
    generics,
    List<Binder>.asSlice(&applied),
    &mut elision,
    false,
    BoundPhase.Application,
  )
  let mut constraints = match move bounds {
    Result<List<Constraint>, Shared<Rejection>>.Success {value} => move value
    Result<List<Constraint>, Shared<Rejection>>.Failure {error} => {
      return Result<List<Constraint>, Shared<Rejection>>.failResult(move error)
    }
  }
  // As in the head itself, the applied bounds are premises of the applied heads: a provider whose
  // own declaration bounds name a bound argument is well formed under them. They remain this
  // application's obligations, which the caller proves.
  elision.assumptions = Option<List<Constraint>>.some(run copyConstraints(List<Constraint>.asSlice(&constraints)))
  let contract = run resolveType(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies.*,
    moduleOrdinal,
    subject,
    List<Binder>.asSlice(&applied),
    &mut elision,
  )
  if let Result<Shared<Type>, Shared<Rejection>>.Failure {error} = move contract {
    return Result<List<Constraint>, Shared<Rejection>>.failResult(move error)
  }
  let provider = run resolveType(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies.*,
    moduleOrdinal,
    target.id,
    List<Binder>.asSlice(&applied),
    &mut elision,
  )
  if let Result<Shared<Type>, Shared<Rejection>>.Failure {error} = move provider {
    return Result<List<Constraint>, Shared<Rejection>>.failResult(move error)
  }
  // The head's `where` clause is an obligation of each application, like its inline bounds.
  let providers = run declareProviders(&mut resolver.*, &mut owner.*, &mut dependencies.*, moduleOrdinal, &module, clauses,
    List<Binder>.asSlice(&applied), &mut elision, &mut constraints)
  if let Option<Shared<Rejection>>.Some {value: diagnostic} = move providers {
    return Result<List<Constraint>, Shared<Rejection>>.failResult(move diagnostic)
  }
  return Result<List<Constraint>, Shared<Rejection>>.succeed(move constraints)
}

// Bound application is a query so named types and aliases in the written header are resolved
// under an active dependency owner. The key includes both normalized goal applications.
effect fn resolveProofBounds(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  key: Key,
) -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let module = resolvedModule(&resolver.*, key.module)
  let mut dependencies = List<Dependency>.make()
  let headAnswer = run demandChild(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies,
    Key {
      family: Family.ImplementationHead,
      module: key.module,
      name: usize.ZERO,
      declaration: key.declaration,
      member: usize.ZERO,
      external: false,
    },
    Span.make(usize.ZERO, usize.ZERO),
  )
  let found = Shared<Result<Answer, NoRejection>>.with<Option<Shared<ImplementationHead>>>(
    &headAnswer,
    headOf,
  )
  let head = match move found {
    Option<Shared<ImplementationHead>>.Some {value} => move value
    Option<Shared<ImplementationHead>>.None => {
      let rejected = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(
        &headAnswer,
        answerCause,
      )
      let diagnostic = match move rejected {
        Option<Shared<Rejection>>.Some {value} => move value
        Option<Shared<Rejection>>.None => CompilerBug.panic(b"MissingRetainedFact: resolveProofBounds")
      }
      return run memberRejected(move diagnostic, move dependencies)
    }
  }
  let applications = List<Shared<Type>>.asSlice(&resolver.applications)
  let goal = ConformanceGoal {
    contract: Shared<Type>.clone(&applications[key.name]),
    provider: Shared<Type>.clone(&applications[key.member]),
  }
  let mut bindings = List<Binding>.make()
  let matched = run matchConformanceHead(&head, &goal, &mut bindings)
  if !exactHeadMatched(&matched) {
    let span = Shared<ImplementationHead>.with<Span>(
      &head,
      fn(value: &ImplementationHead) -> Span {
        return value.span
      },
    )
    return run memberRejected(
      run reject(&resolver.*, &module, RejectionCode.Unsupported, span),
      move dependencies,
    )
  }
  let applied = run appliedConstraints(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies,
    &head,
    List<Binding>.asSlice(&bindings),
    &goal,
  )
  return match move applied {
    Result<List<Constraint>, Shared<Rejection>>.Success {value} => memberSuccess(
      Value.ProofBounds {constraints: move value},
      move dependencies,
    )
    Result<List<Constraint>, Shared<Rejection>>.Failure {error} => run memberRejected(
      move error,
      move dependencies,
    )
  }
}

fn proofBoundCount(answer: &Result<Answer, NoRejection>) -> usize {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.ProofBounds {constraints}} = &value.outcome {
      return List<Constraint>.length(&constraints)
    }
  }
  return usize.MAX
}

fn proofBoundAt(answer: &Result<Answer, NoRejection>, at: usize) -> Option<Constraint> {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.ProofBounds {constraints}} = &value.outcome {
      let written = List<Constraint>.asSlice(&constraints)
      if at < written.length {
        return Option<Constraint>.some(copyConstraint(&written[at]))
      }
    }
  }
  return Option<Constraint>.none()
}

effect fn matchConformanceHead(
  head: &Shared<ImplementationHead>,
  goal: &ConformanceGoal,
  bindings: &mut List<Binding>,
) -> Unification ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let terms = Shared<ImplementationHead>.with<Option<HeadTerms>>(head, headTerms)
  let found = match move terms {
    Option<HeadTerms>.Some {value} => move value
    Option<HeadTerms>.None => {
      return Unification.Distinct
    }
  }
  let mut left = List<Shared<Type>>.make()
  // Establish the selected head from its provider before deciding contract rows whose keys
  // mention those arguments. An earlier undetermined set comparison cannot be proof evidence.
  run List<Shared<Type>>.append(&mut left, Shared<Type>.clone(&found.provider))
  run List<Shared<Type>>.append(&mut left, Shared<Type>.clone(&found.contract))
  let mut right = List<Shared<Type>>.make()
  run List<Shared<Type>>.append(&mut right, Shared<Type>.clone(&goal.provider))
  run List<Shared<Type>>.append(&mut right, Shared<Type>.clone(&goal.contract))
  let mut variables = List<Shared<DeclarationId>>.make()
  run List<Shared<DeclarationId>>.append(&mut variables, move found.declaration)
  let matched = run Type.unifyAll(
    List<Shared<Type>>.asSlice(&left),
    List<Shared<Type>>.asSlice(&right),
    List<Shared<DeclarationId>>.asSlice(&variables),
    Comparison.Exact,
    &mut bindings.*,
  )
  if !exactHeadMatched(&matched) { return move matched }
  return run admitRepresentations(head, List<Shared<DeclarationId>>.asSlice(&variables), &mut bindings.*)
}

// REP-001: a head admits a matched exact representation only through its contract, which also
// binds the head parameters that occur only in that contract. A written contract stands for
// itself. The bindings are restored unless every representation is admitted.
effect fn admitRepresentations(head: &Shared<ImplementationHead>, variables: &[Shared<DeclarationId>],
  bindings: &mut List<Binding>) -> Unification ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let bounds = run headRepresentations(head)
  return run admitBounds(List<Constraint>.asSlice(&bounds), variables, Comparison.Exact, &mut bindings.*)
}

// Admits each representation bound whose parameter is fixed to a type by its contract. A bound
// still naming an open variable is left to the caller.
effect fn admitBounds(bounds: &[Constraint], variables: &[Shared<DeclarationId>], comparison: Comparison,
  bindings: &mut List<Binding>) -> Unification ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mark = List<Binding>.length(&bindings.*)
  let mut at = usize.ZERO
  while at < bounds.length {
    if let Constraint.Represents {parameter, contract} = &bounds[at] {
      let selected = run Type.applyBindings(&parameter, List<Binding>.asSlice(&bindings.*), true)
      if !Shared<Type>.with<bool>(&selected, fn(value: &Type) -> bool { return openVariable(value, variables) }) {
        let mut admitted = Option<Shared<Type>>.some(Shared<Type>.clone(&selected))
        if !Shared<Type>.with<bool>(&selected, writtenUseContract) {
          let none = List<Constraint>.make()
          admitted = run valueCallableContract(&selected, List<Constraint>.asSlice(&none))
        }
        let mut satisfied = Unification.Distinct
        if let Option<Shared<Type>>.Some {value: offered} = move admitted {
          satisfied = run Type.unify(&contract, &offered, variables, comparison, &mut bindings.*)
        }
        if !exactHeadMatched(&satisfied) {
          List<Binding>.truncate(&mut bindings.*, mark)
          return move satisfied
        }
      }
    }
    at = at + usize.ONE
  }
  return Unification.Unified
}

fn openVariable(value: &Type, variables: &[Shared<DeclarationId>]) -> bool {
  if let Type.Parameter {declaration, ..} = &value.* {
    let mut at = usize.ZERO
    while at < variables.length {
      if declarationEqualsShared(&declaration, &variables[at]) { return true }
      at = at + usize.ONE
    }
  }
  return false
}

// The representation bounds of a head, each naming which exact representations one of its
// binders admits.
effect fn headRepresentations(head: &Shared<ImplementationHead>) -> List<Constraint> ! OutOfMemoryError ? &mut Allocator {
  let count = Shared<ImplementationHead>.with<usize>(head, headConstraintCount)
  let mut bounds = List<Constraint>.make()
  let mut at = usize.ZERO
  while at < count {
    let bound = Shared<ImplementationHead>.with<Constraint>(head, fn(value: &ImplementationHead) -> Constraint {
      let constraints = List<Constraint>.asSlice(&value.binders.constraints)
      return copyConstraint(&constraints[at])
    })
    match move bound {
      Constraint.Represents {parameter, contract} => {
        run List<Constraint>.append(&mut bounds, Constraint.Represents {parameter: move parameter, contract: move contract})
      }
      _ => ()
    }
    at = at + usize.ONE
  }
  return move bounds
}

fn writtenUseContract(value: &Type) -> bool {
  return match &value.* { Type.Callable {..} => true Type.Effect {..} => true _ => false }
}

fn exactHeadMatched(answer: &Unification) -> bool {
  return match & answer.* {
    Unification.Unified => true
    _ => false
  }
}

fn exactHeadUndetermined(answer: &Unification) -> bool {
  return match & answer.* {
    Unification.Undetermined {..} => true
    _ => false
  }
}

// A call that does not prove its callee's `?S in R` requirement-row premise (SEM0234), naming
// both rows when each is a concrete row of displayable keys.
effect fn premiseRejection(module: &ModuleId, span: Span, selected: &Shared<Row>, source: &Shared<Row>) -> Shared<Rejection>
! OutOfMemoryError ? &mut Allocator {
  let mut diagnostic = run makeRejection(RejectionCode.UnprovedRequirementPremise, module, span)
  if let Option<Bytes>.Some {value: selectedText} = move run rowText(module, selected) {
    if let Option<Bytes>.Some {value: sourceText} = move run rowText(module, source) {
      run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"selected"), value: move selectedText})
      run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"source"), value: move sourceText})
    }
  }
  return run Shared<Rejection>.make(move diagnostic)
}

// The written spelling of a concrete requirement row, such as `&mut Counter | &Label`; none for
// an empty row, a row naming a parameter or an exclusion, a named role, or an undisplayable key.
effect fn rowText(viewer: &ModuleId, row: &Shared<Row>) -> Option<Bytes> ! OutOfMemoryError ? &mut Allocator {
  let count = Shared<Row>.with<usize>(row, fn(value: &Row) -> usize {
    if List<RowParameter>.length(&value.parameters) > usize.ZERO || List<RowSubtraction>.length(&value.subtractions) > usize.ZERO {
      return usize.ZERO
    }
    let entries = List<Requirement>.asSlice(&value.entries)
    let mut at = usize.ZERO
    while at < entries.length {
      if let Option<Shared<Type>>.Some {..} = &entries[at].roleType { return usize.ZERO }
      at = at + usize.ONE
    }
    return entries.length
  })
  if count == usize.ZERO { return Option<Bytes>.none() }
  let mut text = Bytes.make()
  let mut at = usize.ZERO
  while at < count {
    let capability = Shared<Row>.with<Shared<Type>>(row, fn(value: &Row) -> Shared<Type> {
      return Shared<Type>.clone(&List<Requirement>.asSlice(&value.entries)[at].capability)
    })
    let mutable = Shared<Row>.with<bool>(row, fn(value: &Row) -> bool {
      return List<Requirement>.asSlice(&value.entries)[at].access == Access.Mutable
    })
    let spelled = match move run TypeText.display(&capability, viewer) {
      Option<Bytes>.Some {value} => move value
      Option<Bytes>.None => { return Option<Bytes>.none() }
    }
    if at > usize.ZERO { run Bytes.append(&mut text, b" | ") }
    if mutable { run Bytes.append(&mut text, b"&mut ") } else { run Bytes.append(&mut text, b"&") }
    run Bytes.append(&mut text, Bytes.asSlice(&spelled))
    at = at + usize.ONE
  }
  return Option<Bytes>.some(move text)
}

// A goal no implementation head matches (SEM0121), naming the goal and the missing implementation
// when both types have an exact spelling. A `debuggable` provider of a missing `Display` gets a
// hint at the `{value:?}` placeholder, which prints its `Debug` form.
effect fn missingConformance(module: &ModuleId, span: Span, goal: &ConformanceGoal, debuggable: bool) -> Shared<Rejection>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut diagnostic = run makeRejection(RejectionCode.MissingConformance, module, span)
  // A provider with a borrowed lifetime, such as a `string` argument, is spelled as written.
  if let Option<Bytes>.Some {value: provider} = move run TypeText.displayElided(&goal.provider, module) {
    // A template placeholder whose type the value lacks, such as `{:x}` on a string, says what
    // the placeholder needs rather than naming the standard library's interface.
    let placeholder = Shared<Type>.with<usize>(&goal.contract, templateContract)
    if placeholder != usize.ZERO {
      let mut choice = Bytes.make()
      run appendDecimal(&mut choice, placeholder)
      run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"template"), value: move choice})
      run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"type"), value: move provider})
      return run Shared<Rejection>.make(move diagnostic)
    }
    if let Option<Bytes>.Some {value: contract} = move run TypeText.display(&goal.contract, module) {
      let mut text = run Bytes.copy(b"`")
      run Bytes.append(&mut text, Bytes.asSlice(&provider))
      run Bytes.append(&mut text, b": ")
      run Bytes.append(&mut text, Bytes.asSlice(&contract))
      run Bytes.append(&mut text, b"`")
      let mut detail = run Bytes.copy(b"no implementation of `")
      run Bytes.append(&mut detail, Bytes.asSlice(&contract))
      run Bytes.append(&mut detail, b"` exists for `")
      run Bytes.append(&mut detail, Bytes.asSlice(&provider))
      run Bytes.append(&mut detail, b"`")
      if debuggable {
        run Bytes.append(&mut detail, b"; it implements `silk.format.Debug`, so a template prints it with `{value:?}`")
      }
      run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"goal"), value: move text})
      run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"detail"), value: move detail})
    }
  }
  return run Shared<Rejection>.make(move diagnostic)
}

// The SEM0121 template for a `silk.format` interface that a template placeholder asks of its
// value: 1 for a base type, 2 for `e` or `E`, 3 for a width or precision read from a field; 0 for
// any other contract.
fn templateContract(contract: &Type) -> usize {
  let declaration = match nominalOf(contract) {
    Option<DeclarationId>.Some {value} => move value
    Option<DeclarationId>.None => { return usize.ZERO }
  }
  if DeclarationId.ownerCount(&declaration) != usize.ONE { return usize.ZERO }
  let standard = ModuleId.withPath<bool>(DeclarationId.moduleId(&declaration), fn(path: &[u8]) -> bool {
    return same(path, b"silk/format.silk")
  })
  if !standard { return usize.ZERO }
  if DeclarationId.named(&declaration, b"RadixDisplay") { return usize.ONE }
  if DeclarationId.named(&declaration, b"ExponentDisplay") { return 2 }
  if DeclarationId.named(&declaration, b"CountArgument") { return 3 }
  return usize.ZERO
}

// Whether `goal` asks for the standard `Display` and its provider proves the standard `Debug`
// instead. The probe keeps its own chain and steps, so it never joins the failed proof.
effect fn provesDebugInstead(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut List<Dependency>,
  nested: bool,
  avoid: &Option<Shared<DeclarationId>>,
  goal: &ConformanceGoal,
  declared: &[Constraint],
  siteModule: &ModuleId,
  siteSpan: Span,
) -> bool
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let display = match move Shared<Type>.with<Option<DeclarationId>>(&goal.contract, nominalOf) {
    Option<DeclarationId>.Some {value} => move value
    Option<DeclarationId>.None => { return false }
  }
  if DeclarationId.ownerCount(&display) != usize.ONE || !DeclarationId.named(&display, b"Display") { return false }
  let standard = ModuleId.withPath<bool>(DeclarationId.moduleId(&display), fn(path: &[u8]) -> bool {
    return same(path, b"silk/format.silk")
  })
  if !standard { return false }
  let mut owners = List<OwnerStep>.make()
  run List<OwnerStep>.append(&mut owners, OwnerStep {kind: DeclarationId.ownerKind(&display, usize.ZERO),
    name: Option<Bytes>.some(run Bytes.copy(b"Debug")), occurrence: usize.ZERO})
  let debug = run DeclarationId.fromParts(ModuleId.copy(DeclarationId.moduleId(&display)), move owners)
  let contract = run Types.intern(Type.Nominal {declaration: move debug, isPublic: true, arguments: List<Argument>.make()})
  let probe = ConformanceGoal {contract: move contract, provider: Shared<Type>.clone(&goal.provider)}
  let mut chain = List<ConformanceGoal>.make()
  let mut steps = List<ConformanceStep>.make()
  let failed = run proveGoal(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, nested, avoid, &probe,
    declared, siteModule, siteSpan, &mut chain, &mut steps)
  if let Option<Shared<Rejection>>.Some {..} = move failed { return false }
  return true
}

effect fn proofFailure(resolver: &Resolver, module: &ModuleId, code: RejectionCode, span: Span) -> Shared<
  Rejection,
> ! OutOfMemoryError ? &mut Allocator {
  return run reject(resolver, &module, code, span)
}

// Root proofs record the demanded fact on their request. A proof made while validating a
// witness instead records each fact as a child of that witness, so edits invalidate the answer.
effect fn proofDemand(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut List<Dependency>,
  key: Key,
  span: Span,
  nested: bool,
) -> Shared<Result<Answer, NoRejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  if nested {
    return run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, key, span)
  }
  let family = key.family
  let moduleOrdinal = key.module
  let answer = run demandRaw(&mut resolver.*, &mut owner.*, key, span)
  let module = resolvedModule(&resolver.*, moduleOrdinal)
  run recordRoot(&mut request.*, family, &module, b"", &answer)
  return move answer
}

effect fn proveGoal(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut List<Dependency>,
  nested: bool,
  avoid: &Option<Shared<DeclarationId>>,
  goal: &ConformanceGoal,
  declared: &[Constraint],
  siteModule: &ModuleId,
  siteSpan: Span,
  chain: &mut List<ConformanceGoal>,
  steps: &mut List<ConformanceStep>,
) -> Option<Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let mark = List<ConformanceGoal>.length(&chain.*)
  run List<ConformanceGoal>.append(&mut chain.*, copyGoal(goal))
  let assumed = run declaredGoal(declared, goal)
  if let Option<Constraint>.Some {value: bound} = move assumed {
    run List<ConformanceStep>.append(
      &mut steps.*,
      ConformanceStep {
        goal: copyGoal(goal),
        evidence: ConformanceEvidence.Declared {bound: move bound},
      },
    )
    List<ConformanceGoal>.truncate(&mut chain.*, mark)
    return Option<Shared<Rejection>>.none()
  }
  if Shared<Type>.with<bool>(&goal.provider, unionType) {
    let failed = run proveUnionGoal(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, nested, avoid,
      goal, declared, siteModule, siteSpan, &mut chain.*, &mut steps.*)
    List<ConformanceGoal>.truncate(&mut chain.*, mark)
    return move failed
  }
  let contractModuleOrdinal = declaringModuleOrdinal(&resolver.*, &goal.contract)
  if contractModuleOrdinal == usize.MAX {
    fail InvalidModulePath {}
  }
  let contractModule = resolvedModule(&resolver.*, contractModuleOrdinal)
  let contractOrdinal = run ordinalOfProvider(&mut resolver.*, &contractModule, &goal.contract)
  let contractPosition = match move contractOrdinal {
    Option<usize>.Some {value} => value
    Option<usize>.None => {
      fail InvalidModulePath {}
    }
  }
  let providerApplication = run internApplication(&mut resolver.*, &goal.provider)
  let declarationAccess216Request = Key {
      family: Family.ConformanceHeads,
      module: contractModuleOrdinal,
      name: providerApplication,
      declaration: contractPosition,
      member: usize.ZERO,
      external: false,
    }
  let declarationAccess216 = run internDeclaration(&mut resolver.*, declarationAccess216Request)
  let bucket = run proofDemand(
    &mut resolver.*,
    &mut owner.*,
    &mut request.*,
    &mut dependencies.*,
    declarationAccess216,
    siteSpan,
    nested,
  )
  let failed = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(
    &bucket,
    answerCause,
  )
  if let Option<Shared<Rejection>>.Some {value} = move failed {
    return Option<Shared<Rejection>>.some(move value)
  }
  let count = Shared<Result<Answer, NoRejection>>.with<usize>(&bucket, bucketCount)
  let mut heads = List<Shared<ImplementationHead>>.make()
  let mut at = usize.ZERO
  while at < count {
    let candidate = Shared<Result<Answer, NoRejection>>.with<Option<Shared<ImplementationHead>>>(
      &bucket,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<ImplementationHead>> {
        return bucketAt(answer, at)
      },
    )
    if let Option<Shared<ImplementationHead>>.Some {value: head} = move candidate {
      let identity = Shared<ImplementationHead>.with<Shared<DeclarationId>>(
        &head,
        fn(value: &ImplementationHead) -> Shared<DeclarationId> {
          return Shared<DeclarationId>.clone(&value.declaration)
        },
      )
      let moduleOrdinal = Shared<DeclarationId>.with<usize>(
        &identity,
        fn(value: &DeclarationId) -> usize {
          return knownModuleOrdinal(&resolver.*, DeclarationId.moduleId(value))
        },
      )
      if moduleOrdinal == usize.MAX {
        fail InvalidModulePath {}
      }
      let module = resolvedModule(&resolver.*, moduleOrdinal)
      let ordinal = run ordinalOfIdentity(&mut resolver.*, &module, &identity)
      let position = match move ordinal {
        Option<usize>.Some {value} => value
        Option<usize>.None => {
          return CompilerBug.panic(b"MissingRetainedFact: proveGoal")
        }
      }
      let implementation = run declarationAt(&mut resolver.*, &module, position)
      if let Option<DeclarationId>.None = move implementation {
        return CompilerBug.panic(b"MissingRetainedFact: proveGoal")
      }
      // The entire owner bucket must be coherent before a candidate may become applicable.
      let declarationAccess217Request = Key {
          family: Family.Coherence,
          module: moduleOrdinal,
          name: usize.ZERO,
          declaration: position,
          member: usize.ZERO,
          external: false,
        }
      let declarationAccess217 = run internDeclaration(&mut resolver.*, declarationAccess217Request)
      let coherence = run proofDemand(
        &mut resolver.*,
        &mut owner.*,
        &mut request.*,
        &mut dependencies.*,
        declarationAccess217,
        siteSpan,
        nested,
      )
      let rejected = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(
        &coherence,
        answerCause,
      )
      if let Option<Shared<Rejection>>.Some {value} = move rejected {
        return Option<Shared<Rejection>>.some(move value)
      }
      run List<Shared<ImplementationHead>>.append(&mut heads, move head)
    }
    at = at + usize.ONE
  }
  let mut selected = Option<Shared<ImplementationHead>>.none()
  let mut selectedBindings = List<Binding>.make()
  let mut undecided = false
  let coherent = List<Shared<ImplementationHead>>.asSlice(&heads)
  at = usize.ZERO
  while at < coherent.length {
    let mut bindings = List<Binding>.make()
    let answer = run matchConformanceHead(&coherent[at], goal, &mut bindings)
    if exactHeadMatched(&answer) {
      if let Option<Shared<ImplementationHead>>.Some {value: _} = &selected {
        return Option<Shared<Rejection>>.some(
          run proofFailure(&resolver.*, siteModule, RejectionCode.OverlappingConformance, siteSpan),
        )
      }
      selected = Option<Shared<ImplementationHead>>.some(
        Shared<ImplementationHead>.clone(&coherent[at]),
      )
      selectedBindings = move bindings
    }
    if exactHeadUndetermined(&answer) {
      undecided = true
    }
    at = at + usize.ONE
  }
  let head = match move selected {
    Option<Shared<ImplementationHead>>.Some {value} => move value
    Option<Shared<ImplementationHead>>.None => {
      if undecided {
        return Option<Shared<Rejection>>.some(
          run proofFailure(&resolver.*, siteModule, RejectionCode.Unsupported, siteSpan),
        )
      }
      let debuggable = run provesDebugInstead(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, nested,
        avoid, goal, declared, siteModule, siteSpan)
      return Option<Shared<Rejection>>.some(run missingConformance(siteModule, siteSpan, goal, debuggable))
    }
  }
  if undecided {
    return Option<Shared<Rejection>>.some(
      run proofFailure(&resolver.*, siteModule, RejectionCode.Unsupported, siteSpan),
    )
  }
  let identity = Shared<ImplementationHead>.with<Shared<DeclarationId>>(
    &head,
    fn(value: &ImplementationHead) -> Shared<DeclarationId> {
      return Shared<DeclarationId>.clone(&value.declaration)
    },
  )
  let moduleOrdinal = Shared<DeclarationId>.with<usize>(
    &identity,
    fn(value: &DeclarationId) -> usize {
      return knownModuleOrdinal(&resolver.*, DeclarationId.moduleId(value))
    },
  )
  if moduleOrdinal == usize.MAX {
    fail InvalidModulePath {}
  }
  let module = resolvedModule(&resolver.*, moduleOrdinal)
  let located = run ordinalOfIdentity(&mut resolver.*, &module, &identity)
  let ordinal = match move located {
    Option<usize>.Some {value} => value
    Option<usize>.None => {
      return CompilerBug.panic(b"MissingRetainedFact: proveGoal")
    }
  }
  let contractApplication = run internApplication(&mut resolver.*, &goal.contract)
  let boundProviderApplication = run internApplication(&mut resolver.*, &goal.provider)
  let declarationAccess218Request = Key {
      family: Family.ProofBounds,
      module: moduleOrdinal,
      name: contractApplication,
      declaration: ordinal,
      member: boundProviderApplication,
      external: false,
    }
  let declarationAccess218 = run internDeclaration(&mut resolver.*, declarationAccess218Request)
  let bounds = run proofDemand(
    &mut resolver.*,
    &mut owner.*,
    &mut request.*,
    &mut dependencies.*,
    declarationAccess218,
    siteSpan,
    nested,
  )
  let rejected = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(
    &bounds,
    answerCause,
  )
  if let Option<Shared<Rejection>>.Some {value} = move rejected {
    return Option<Shared<Rejection>>.some(move value)
  }
  let boundCount = Shared<Result<Answer, NoRejection>>.with<usize>(&bounds, proofBoundCount)
  if boundCount == usize.MAX {
    return Option<Shared<Rejection>>.some(
      run proofFailure(&resolver.*, siteModule, RejectionCode.Unsupported, siteSpan),
    )
  }
  let mut required = List<Constraint>.make()
  let mut bound = usize.ZERO
  while bound < boundCount {
    let found = Shared<Result<Answer, NoRejection>>.with<Option<Constraint>>(
      &bounds,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Constraint> {
        return proofBoundAt(answer, bound)
      },
    )
    if let Option<Constraint>.Some {value} = move found {
      run List<Constraint>.append(&mut required, move value)
    }
    bound = bound + usize.ONE
  }
  let all = List<Constraint>.asSlice(&required)
  at = usize.ZERO
  while at < all.length {
    // A selected implementation's row exclusion is an obligation of the caller, just as it is
    // for a direct call; a declared open-row premise or covered concrete row proves it.
    if let Constraint.RequirementSubset {selected: selectedRow, source: sourceRow} = &all[at] {
      let mut assumed = false
      let mut premise = usize.ZERO
      while premise < declared.length && !assumed {
        assumed = run sameConstraint(&all[at], &declared[premise])
        premise = premise + usize.ONE
      }
      let premises = run rowPremises(declared)
      if !assumed && !run Row.knownSubset(&selectedRow, &sourceRow, List<RowPremise>.asSlice(&premises)) {
        return Option<Shared<Rejection>>.some(
          run premiseRejection(siteModule, siteSpan, &selectedRow, &sourceRow),
        )
      }
      at = at + usize.ONE
      continue
    }
    // Matching the head already admitted each representation by its contract (REP-001).
    if let Constraint.Represents {..} = &all[at] {
      at = at + usize.ONE
      continue
    }
    // The selected head's own outlives premise never chose it; the caller proves it (LIFE-002).
    // A well-formed provider satisfies its declaration's own bounds, so a premise those bounds
    // imply for the provider's arguments holds wherever the head matches (IMPL-007's implied set).
    if let Constraint.Outlives {longer, shorter} = &all[at] {
      if !run knownOutlives(declared, &longer, &shorter) {
        let mut premised = run copyConstraints(declared)
        let implied = run providerDeclaredBounds(&mut resolver.*, &mut owner.*, &mut dependencies.*, &goal.provider, siteSpan)
        run appendConstraints(&mut premised, List<Constraint>.asSlice(&implied))
        if !run knownOutlives(List<Constraint>.asSlice(&premised), &longer, &shorter) {
          return Option<Shared<Rejection>>.some(
            run proofFailure(&resolver.*, siteModule, unprovedOutlivesCode(&longer, &shorter), siteSpan),
          )
        }
      }
      at = at + usize.ONE
      continue
    }
    if let Constraint.Conforms {provider, contract} = &all[at] {
      let requirement = ConformanceGoal {
        contract: Shared<Type>.clone(&contract),
        provider: Shared<Type>.clone(&provider),
      }
      let failed = run proveGoal(
        &mut resolver.*,
        &mut owner.*,
        &mut request.*,
        &mut dependencies.*,
        nested,
        avoid,
        &requirement,
        declared,
        siteModule,
        siteSpan,
        &mut chain.*,
        &mut steps.*,
      )
      if let Option<Shared<Rejection>>.Some {value} = move failed {
        return Option<Shared<Rejection>>.some(move value)
      }
    } else if let Constraint.Copyable {subject} = &all[at] {
      let failed = run proveCopyable(&mut resolver.*, &mut owner.*, &mut dependencies.*, &subject, declared, siteModule, siteSpan)
      if let Option<Shared<Rejection>>.Some {value} = move failed {
        return Option<Shared<Rejection>>.some(move value)
      }
    } else if let Constraint.ThreadSafe {subject, property} = &all[at] {
      let failed = run proveThreadSafe(&mut resolver.*, &mut owner.*, &mut dependencies.*, &subject, property, declared,
        siteModule, siteSpan)
      if let Option<Shared<Rejection>>.Some {value} = move failed {
        return Option<Shared<Rejection>>.some(move value)
      }
    } else if let Constraint.Provides {provider, selector, source} = &all[at] {
      // A selected head's `where Provider provides S from R` clause is proved like a direct call's.
      let failed = run proveProvides(&mut resolver.*, &mut owner.*, &mut dependencies.*, &provider, &selector, &source,
        declared, siteModule, siteSpan)
      if let Option<Shared<Rejection>>.Some {value} = move failed {
        return Option<Shared<Rejection>>.some(move value)
      }
    } else if let Constraint.Property {subject, property} = &all[at] {
      // A selected head's property premise is owed by the caller, just like a direct call's bound.
      // Only Detached has a proof here; preserve the rejection of other selected-head properties.
      if property != IntrinsicProperty.Detached {
        return Option<Shared<Rejection>>.some(
          run proofFailure(&resolver.*, siteModule, RejectionCode.Unsupported, siteSpan),
        )
      }
      if !run provesDetached(declared, &subject, siteModule) {
        return Option<Shared<Rejection>>.some(
          run proofFailure(&resolver.*, siteModule, RejectionCode.UnsatisfiedExecutableProperty, siteSpan),
        )
      }
    } else {
      return Option<Shared<Rejection>>.some(
        run proofFailure(&resolver.*, siteModule, RejectionCode.Unsupported, siteSpan),
      )
    }
    at = at + usize.ONE
  }
  // A coherent head and satisfied bounds still do not prove that its operations implement the
  // contract. Demand the deterministic static witnesses before admitting concrete evidence.
  if let Option<Shared<DeclarationId>>.Some {value: forbidden} = &avoid.* {
    if sameDeclarationShared(&identity, &forbidden) {
      return Option<Shared<Rejection>>.some(
        run proofFailure(&resolver.*, siteModule, RejectionCode.Unsupported, siteSpan),
      )
    }
  }
  let declarationAccess219Request = Key {
      family: Family.Witnesses,
      module: moduleOrdinal,
      name: usize.ZERO,
      declaration: ordinal,
      member: usize.ZERO,
      external: false,
    }
  let declarationAccess219 = run internDeclaration(&mut resolver.*, declarationAccess219Request)
  let witnesses = run proofDemand(
    &mut resolver.*,
    &mut owner.*,
    &mut request.*,
    &mut dependencies.*,
    declarationAccess219,
    siteSpan,
    nested,
  )
  let invalid = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(
    &witnesses,
    answerCause,
  )
  if let Option<Shared<Rejection>>.Some {value} = move invalid {
    return Option<Shared<Rejection>>.some(move value)
  }
  run List<ConformanceStep>.append(
    &mut steps.*,
    ConformanceStep {
      goal: copyGoal(goal),
      evidence: ConformanceEvidence.Concrete {head: move head, bindings: move selectedBindings},
    },
  )
  List<ConformanceGoal>.truncate(&mut chain.*, mark)
  return Option<Shared<Rejection>>.none()
}

// The members of a structural union, in canonical order; none for any other type.
effect fn unionMembers(provider: &Shared<Type>) -> List<Shared<Type>> ! OutOfMemoryError ? &mut Allocator {
  let mut members = List<Shared<Type>>.make()
  let count = Shared<Type>.with<usize>(provider, fn(value: &Type) -> usize {
    return match &value.* { Type.Union {members: listed} => List<Shared<Type>>.length(&listed) _ => usize.ZERO }
  })
  let mut at = usize.ZERO
  while at < count {
    let member = Shared<Type>.with<Shared<Type>>(provider, fn(value: &Type) -> Shared<Type> {
      if let Type.Union {members: listed} = &value.* { return Shared<Type>.clone(&List<Shared<Type>>.asSlice(&listed)[at]) }
      return Shared<Type>.clone(provider)
    })
    run List<Shared<Type>>.append(&mut members, move member)
    at = at + usize.ONE
  }
  return move members
}

fn referenceTo(value: &Type, referent: &Shared<Type>) -> bool {
  if let Type.Reference {referent: written, ..} = &value.* { return sameReusableType(&written, referent) }
  return false
}

// A structural union conforms to a reference-only contract when each member does (UNION-003).
// Every operation receives `self` through a reference and names `Self` nowhere else, so a call
// dispatches on the receiver's tag to its member's witness with the same remaining operands.
// Each member's proof records its own steps first; the union's step comes last.
effect fn proveUnionGoal(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut List<Dependency>,
  nested: bool,
  avoid: &Option<Shared<DeclarationId>>,
  goal: &ConformanceGoal,
  declared: &[Constraint],
  siteModule: &ModuleId,
  siteSpan: Span,
  chain: &mut List<ConformanceGoal>,
  steps: &mut List<ConformanceStep>,
) -> Option<Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let members = run unionMembers(&goal.provider)
  let listed = List<Shared<Type>>.asSlice(&members)
  // `never` has no members, so it takes a reference-only interface vacuously: no value ever
  // reaches an operation. `()` stands in for a member to find where an operation names `Self`.
  let mut representative = run Types.intern(Type.Unit)
  if listed.length > usize.ZERO { representative = Shared<Type>.clone(&listed[usize.ZERO]) }
  let contractModuleOrdinal = declaringModuleOrdinal(&resolver.*, &goal.contract)
  if contractModuleOrdinal == usize.MAX {
    return Option<Shared<Rejection>>.some(run missingConformance(siteModule, siteSpan, goal, false))
  }
  let contractModule = resolvedModule(&resolver.*, contractModuleOrdinal)
  let contractPosition = match move run ordinalOfProvider(&mut resolver.*, &contractModule, &goal.contract) {
    Option<usize>.Some {value} => value
    Option<usize>.None => { return Option<Shared<Rejection>>.some(run missingConformance(siteModule, siteSpan, goal, false)) }
  }
  let operationsKey = run internDeclaration(&mut resolver.*, Key {family: Family.Operations, module: contractModuleOrdinal,
    name: usize.ZERO, declaration: contractPosition, member: usize.ZERO, external: false})
  let operations = run proofDemand(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, operationsKey,
    siteSpan, nested)
  if let Option<Shared<Rejection>>.Some {value} = move Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(
    &operations, answerCause) {
    return Option<Shared<Rejection>>.some(move value)
  }
  // Each operation is read under the union and under one member: a parameter, result or failure
  // that differs between the two names `Self`.
  let contractKey = run internApplication(&mut resolver.*, &goal.contract)
  let unionKey = run internApplication(&mut resolver.*, &goal.provider)
  let memberKey = run internApplication(&mut resolver.*, &representative)
  let count = Shared<Result<Answer, NoRejection>>.with<usize>(&operations, listedOperationCount)
  let mut at = usize.ZERO
  while at < count {
    let operation = match move Shared<Result<Answer, NoRejection>>.with<Option<Shared<DeclarationId>>>(&operations,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<DeclarationId>> { return listedOperation(answer, at) }) {
      Option<Shared<DeclarationId>>.Some {value} => move value
      Option<Shared<DeclarationId>>.None => { return Option<Shared<Rejection>>.some(run missingConformance(siteModule, siteSpan, goal, false)) }
    }
    let position = match move run ordinalOfIdentity(&mut resolver.*, &contractModule, &operation) {
      Option<usize>.Some {value} => value
      Option<usize>.None => { return Option<Shared<Rejection>>.some(run missingConformance(siteModule, siteSpan, goal, false)) }
    }
    let underUnionKey = run internDeclaration(&mut resolver.*, Key {family: Family.AppliedOperation,
      module: contractModuleOrdinal, name: contractKey, declaration: position, member: unionKey, external: false})
    let underUnion = run proofDemand(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, underUnionKey,
      siteSpan, nested)
    let underMemberKey = run internDeclaration(&mut resolver.*, Key {family: Family.AppliedOperation,
      module: contractModuleOrdinal, name: contractKey, declaration: position, member: memberKey, external: false})
    let underMember = run proofDemand(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, underMemberKey,
      siteSpan, nested)
    if !run dispatchableOperation(&underUnion, &underMember, &goal.provider) {
      return Option<Shared<Rejection>>.some(run undispatchableUnion(siteModule, siteSpan, goal, &operation))
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < listed.length {
    let memberGoal = ConformanceGoal {contract: Shared<Type>.clone(&goal.contract), provider: Shared<Type>.clone(&listed[at])}
    let failed = run proveGoal(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, nested, avoid,
      &memberGoal, declared, siteModule, siteSpan, &mut chain.*, &mut steps.*)
    if let Option<Shared<Rejection>>.Some {value} = move failed {
      return Option<Shared<Rejection>>.some(move value)
    }
    at = at + usize.ONE
  }
  run List<ConformanceStep>.append(&mut steps.*, ConformanceStep {goal: copyGoal(goal), evidence: ConformanceEvidence.Union})
  return Option<Shared<Rejection>>.none()
}

// SEM0121 for a union provider and a contract whose `operation` cannot dispatch on the tag.
effect fn undispatchableUnion(module: &ModuleId, span: Span, goal: &ConformanceGoal, operation: &Shared<DeclarationId>)
  -> Shared<Rejection> ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut diagnostic = run makeRejection(RejectionCode.MissingConformance, module, span)
  let provider = run unionText(module, &goal.provider)
  if let Option<Bytes>.Some {value: contract} = move run TypeText.display(&goal.contract, module) {
    let mut text = run Bytes.copy(b"`")
    run Bytes.append(&mut text, Bytes.asSlice(&provider))
    run Bytes.append(&mut text, b": ")
    run Bytes.append(&mut text, Bytes.asSlice(&contract))
    run Bytes.append(&mut text, b"`")
    let name = Shared<DeclarationId>.with<DeclarationId>(operation, DeclarationId.copy)
    let spelling = run DeclarationId.copySpelling(&name)
    let mut detail = run Bytes.copy(b"a union takes an interface only when each operation receives `self` by reference and names `Self` nowhere else, and `")
    run Bytes.append(&mut detail, Bytes.asSlice(&spelling))
    run Bytes.append(&mut detail, b"` does not")
    run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"goal"), value: move text})
    run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"detail"), value: move detail})
  }
  return run Shared<Rejection>.make(move diagnostic)
}

// A union's members joined by ` | `, each as TypeText shows it.
effect fn unionText(viewer: &ModuleId, provider: &Shared<Type>) -> Bytes ! OutOfMemoryError ? &mut Allocator | &mut Types {
  if let Option<Bytes>.Some {value} = move run TypeText.display(provider, viewer) { return move value }
  let members = run unionMembers(provider)
  let listed = List<Shared<Type>>.asSlice(&members)
  let mut text = Bytes.make()
  let mut at = usize.ZERO
  while at < listed.length {
    if at > usize.ZERO { run Bytes.append(&mut text, b" | ") }
    if let Option<Bytes>.Some {value} = move run TypeText.display(&listed[at], viewer) { run Bytes.append(&mut text, Bytes.asSlice(&value)) }
    at = at + usize.ONE
  }
  return move text
}

// Whether one operation, read under the union and under one member, receives `self` through a
// reference to the union and names `Self` in no other parameter, its result or its failure.
effect fn dispatchableOperation(underUnion: &Shared<Result<Answer, NoRejection>>,
  underMember: &Shared<Result<Answer, NoRejection>>, provider: &Shared<Type>) -> bool
! OutOfMemoryError ? &mut Allocator | &mut Types {
  if Shared<Result<Answer, NoRejection>>.with<bool>(underUnion, hasRejection)
    || Shared<Result<Answer, NoRejection>>.with<bool>(underMember, hasRejection) {
    return false
  }
  let count = Shared<Result<Answer, NoRejection>>.with<usize>(underUnion, signatureParameterCount)
  if count == usize.ZERO || count != Shared<Result<Answer, NoRejection>>.with<usize>(underMember, signatureParameterCount) {
    return false
  }
  let mut at = usize.ZERO
  while at < count {
    let unionParameter = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(underUnion,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> { return signatureParameterAt(answer, at) })
    let memberParameter = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(underMember,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> { return signatureParameterAt(answer, at) })
    if at == usize.ZERO {
      let receiver = match move unionParameter { Option<Shared<Type>>.Some {value} => move value _ => { return false } }
      if !Shared<Type>.with<bool>(&receiver, fn(value: &Type) -> bool { return referenceTo(value, provider) }) {
        return false
      }
    } else if !sameTypeOption(&unionParameter, &memberParameter) {
      return false
    }
    at = at + usize.ONE
  }
  let unionResult = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(underUnion, signatureResult)
  let memberResult = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(underMember, signatureResult)
  if !sameTypeOption(&unionResult, &memberResult) {
    return false
  }
  let unionFailure = run signatureFailure(underUnion)
  let memberFailure = run signatureFailure(underMember)
  return sameReusableType(&unionFailure, &memberFailure)
}

struct ResolvedWitness {
  application: Application,
  operands: List<OperandPass>,
}

effect fn copyBindings(values: &[Binding]) -> List<Binding> ! OutOfMemoryError ? &mut Allocator {
  let mut copied = List<Binding>.make()
  let mut at = usize.ZERO
  while at < values.length {
    run List<Binding>.append(&mut copied, Binding {declaration: Shared<DeclarationId>.clone(&values[at].declaration),
      ordinal: values[at].ordinal, value: Argument.copy(&values[at].value)})
    at = at + usize.ONE
  }
  return move copied
}

// The witnesses of the concrete conformance a proved goal selects, with the head bindings that
// matched both contract and provider.
struct ProvenWitnesses {
  witnesses: Shared<Result<Answer, NoRejection>>,
  bindings: List<Binding>,
}

// A head lifetime that names only a `provides` loan region in the head's where clause is fixed by
// no goal: the provision holds whatever the loan's region, so selection binds it to `'static`, as a
// witness's own provides-only lifetime is (`providesOnlyLifetime`).
effect fn bindHeadLoanRegions(head: &Shared<ImplementationHead>, owner: &Shared<DeclarationId>, count: usize,
  bindings: &mut List<Binding>) -> () ! OutOfMemoryError ? &mut Allocator {
  let identity = DeclarationId.copyShared(owner)
  let constraints = Shared<ImplementationHead>.with<usize>(head, headConstraintCount)
  let mut ordinal = usize.ZERO
  while ordinal < count {
    let unbound = match move bindingArgument(List<Binding>.asSlice(&bindings.*), &identity, ordinal) {
      Option<Argument>.None => true
      _ => false
    }
    let mut loan = false
    let mut at = usize.ZERO
    while unbound && !loan && at < constraints {
      let bound = Shared<ImplementationHead>.with<Option<Constraint>>(head,
        fn(value: &ImplementationHead) -> Option<Constraint> { return headConstraintAt(value, at) })
      if let Option<Constraint>.Some {value: Constraint.Provides {provider, ..}} = move bound {
        let borrowed = run Type.copy(&provider)
        if let Type.Reference {referent, lifetime, ..} = move borrowed {
          loan = ownedLifetimeOrdinal(&lifetime, &identity) == ordinal && !run usesOwnedLifetime(&referent, &identity, ordinal)
        }
      }
      at = at + usize.ONE
    }
    if loan {
      run List<Binding>.append(&mut bindings.*, Binding {declaration: Shared<DeclarationId>.clone(owner), ordinal: ordinal,
        value: Argument.Lifetime {value: run Shared<Lifetime>.make(Lifetime.Static)}})
    }
    ordinal = ordinal + usize.ONE
  }
  return ()
}

// Exact unification omits identity bindings, so a head parameter that the goal names unchanged,
// as in a recursive call from the head's own member, has no binding. The head's slots that the
// goal retains, by kind and ordinal, tell such a fixed slot from an undetermined one. Recording a
// self-binding instead would put a cycle in the unifier's acyclic substitution graph.
struct GoalSlots {
  types: List<usize>,
  regions: List<usize>,
  rows: List<usize>,
}

// Whether `goal` retains `identity`'s slot unchanged. `slots` caches the goal's owned slots,
// collected on the first unbound slot.
effect fn goalFixes(slots: &mut Option<GoalSlots>, goal: &ConformanceGoal, identity: &Shared<DeclarationId>,
  kind: GenericKind, ordinal: usize) -> bool
! OutOfMemoryError ? &mut Allocator {
  if let Option<GoalSlots>.None = &slots.* {
    let owner = DeclarationId.copyShared(identity)
    let mut collected = GoalSlots {types: List<usize>.make(), regions: List<usize>.make(), rows: List<usize>.make()}
    run Type.collectOwned(&goal.provider, &owner, &mut collected.types, &mut collected.regions, &mut collected.rows)
    run Type.collectOwned(&goal.contract, &owner, &mut collected.types, &mut collected.regions, &mut collected.rows)
    slots.* = Option<GoalSlots>.some(move collected)
  }
  if let Option<GoalSlots>.Some {value} = &slots.* {
    return match kind {
      GenericKind.Type => containsOrdinal(&value.types, ordinal)
      GenericKind.Lifetime => containsOrdinal(&value.regions, ordinal)
      GenericKind.Requirement => containsOrdinal(&value.rows, ordinal)
      _ => false
    }
  }
  return false
}

// Whether the proof's bindings and `goal` together fix every slot of `head`. A slot the goal
// retains stays the head's own parameter in the witness application.
effect fn fixedHeadArguments(head: &Shared<ImplementationHead>, identity: &Shared<DeclarationId>,
  count: usize, bindings: &[Binding], goal: &ConformanceGoal) -> bool
! OutOfMemoryError ? &mut Allocator {
  let owner = DeclarationId.copyShared(identity)
  let mut retained = Option<GoalSlots>.none()
  let mut at = usize.ZERO
  while at < count {
    let found = Shared<ImplementationHead>.with<Option<ApplicationSlot>>(head,
      fn(value: &ImplementationHead) -> Option<ApplicationSlot> { return headOwnedSlot(value, &owner, at) })
    let slot = match move found {
      Option<ApplicationSlot>.Some {value} => value
      _ => { return false }
    }
    if let Option<Argument>.None = move bindingArgument(bindings, &owner, slot.ordinal) {
      if !run goalFixes(&mut retained, goal, identity, slot.kind, slot.ordinal) { return false }
    }
    at = at + usize.ONE
  }
  return true
}

// Consume the existing proof's root step, whose head matched both contract and provider. Nested
// callers record these same proof facts as children of their MIR answer.
effect fn provenWitnesses(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut List<Dependency>,
  nested: bool,
  contract: &Shared<Type>,
  provider: &Shared<Type>,
  siteModule: &ModuleId,
  siteSpan: Span,
) -> Result<Option<ProvenWitnesses>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let goal = ConformanceGoal {
    contract: Shared<Type>.clone(contract), provider: Shared<Type>.clone(provider),
  }
  let mut chain = List<ConformanceGoal>.make()
  let mut steps = List<ConformanceStep>.make()
  let declared = List<Constraint>.make()
  let avoid = Option<Shared<DeclarationId>>.none()
  let failed = run proveGoal(
    &mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, nested, &avoid,
    &goal, List<Constraint>.asSlice(&declared), siteModule, siteSpan, &mut chain, &mut steps,
  )
  if let Option<Shared<Rejection>>.Some {value} = move failed {
    return Result<Option<ProvenWitnesses>, Shared<Rejection>>.failResult(move value)
  }
  let complete = List<ConformanceStep>.asSlice(&steps)
  if complete.length > usize.ZERO {
    if let ConformanceEvidence.Concrete {head, bindings} = &complete[complete.length - usize.ONE].evidence {
      let identity = Shared<ImplementationHead>.with<Shared<DeclarationId>>(&head,
        fn(value: &ImplementationHead) -> Shared<DeclarationId> {
          return Shared<DeclarationId>.clone(&value.declaration)
        })
      let headOwner = DeclarationId.copyShared(&identity)
      let count = Shared<ImplementationHead>.with<usize>(&head, headBinderCount)
      let mut selected = run copyBindings(List<Binding>.asSlice(&bindings))
      run bindHeadLoanRegions(&head, &identity, count, &mut selected)
      if run fixedHeadArguments(&head, &identity, count, List<Binding>.asSlice(&selected), &goal) {
        let moduleOrdinal = knownModuleOrdinal(&resolver.*, DeclarationId.moduleId(&headOwner))
        if moduleOrdinal == usize.MAX { fail InvalidModulePath {} }
        let module = resolvedModule(&resolver.*, moduleOrdinal)
        let found = run ordinalOfIdentity(&mut resolver.*, &module, &identity)
        if let Option<usize>.Some {value: ordinal} = move found {
          let declarationAccess220Request = Key {
            family: Family.Witnesses, module: moduleOrdinal, name: usize.ZERO,
            declaration: ordinal, member: usize.ZERO, external: false,
          }
          let declarationAccess220 = run internDeclaration(&mut resolver.*, declarationAccess220Request)
          let witnesses = run proofDemand(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, declarationAccess220, siteSpan, nested)
          return Result<Option<ProvenWitnesses>, Shared<Rejection>>.succeed(Option<ProvenWitnesses>.some(
            ProvenWitnesses {witnesses: move witnesses, bindings: move selected}))
        }
      }
    }
  }
  return Result<Option<ProvenWitnesses>, Shared<Rejection>>.succeed(Option<ProvenWitnesses>.none())
}

// The application of the source function the proved conformance maps `operation` to. No target
// body or invocation-specific inference identity participates in this application.
effect fn resolveWitnessApplication(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut List<Dependency>,
  nested: bool,
  contract: &Shared<Type>,
  provider: &Shared<Type>,
  operation: &DeclarationId,
  siteModule: &ModuleId,
  siteSpan: Span,
) -> Result<ResolvedWitness, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let proven = match move run provenWitnesses(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, nested,
    contract, provider, siteModule, siteSpan) {
    Result<Option<ProvenWitnesses>, Shared<Rejection>>.Success {value} => move value
    Result<Option<ProvenWitnesses>, Shared<Rejection>>.Failure {error} => { return Result<ResolvedWitness, Shared<Rejection>>.failResult(move error) }
  }
  if let Option<ProvenWitnesses>.Some {value: selected} = move proven {
    let witnesses = Shared<Result<Answer, NoRejection>>.clone(&selected.witnesses)
    let mapped = run mappedWitnessApplication(&witnesses, operation, List<Binding>.asSlice(&selected.bindings))
    if let Option<Application>.Some {value} = move mapped {
      let schema = run resolveTargetSchema(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, nested,
        Application.bodyDeclaration(&value), siteSpan)
      if let Option<TargetSchema>.Some {value: targetSchema} = move schema {
        if run TargetSchema.accepts(&targetSchema, &value) {
          let count = Shared<Result<Answer, NoRejection>>.with<usize>(&witnesses, fn(answer: &Result<Answer, NoRejection>) -> usize { return witnessOperandsCount(answer, operation) })
          let mut operands = List<OperandPass>.make()
          let mut at = usize.ZERO
          while at < count {
            let pass = Shared<Result<Answer, NoRejection>>.with<OperandPass>(&witnesses, fn(answer: &Result<Answer, NoRejection>) -> OperandPass { return witnessOperandAt(answer, operation, at) })
            run List<OperandPass>.append(&mut operands, pass)
            at = at + usize.ONE
          }
          return Result<ResolvedWitness, Shared<Rejection>>.succeed(ResolvedWitness {application: move value, operands: move operands})
        }
      }
    }
  }
  return Result<ResolvedWitness, Shared<Rejection>>.failResult(
    run reject(&resolver.*, siteModule, RejectionCode.Unsupported, siteSpan),
  )
}

// The scalar intrinsic the proved conformance maps `operation` to, when it maps one. An unproved
// goal selects none here; the source-function path reports it.
effect fn resolveWitnessIntrinsic(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut List<Dependency>,
  contract: &Shared<Type>,
  provider: &Shared<Type>,
  operation: &DeclarationId,
  siteModule: &ModuleId,
  siteSpan: Span,
) -> Option<IntrinsicMember>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let proven = run provenWitnesses(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, true,
    contract, provider, siteModule, siteSpan)
  if let Result<Option<ProvenWitnesses>, Shared<Rejection>>.Success {value: Option<ProvenWitnesses>.Some {value: selected}} = move proven {
    let implementation = Shared<Result<Answer, NoRejection>>.with<Option<WitnessImplementation>>(&selected.witnesses,
      fn(answer: &Result<Answer, NoRejection>) -> Option<WitnessImplementation> { return witnessFor(answer, operation) })
    if let Option<WitnessImplementation>.Some {value: WitnessImplementation.Intrinsic {member}} = move implementation {
      return Option<IntrinsicMember>.some(member)
    }
  }
  return Option<IntrinsicMember>.none()
}

// Header witness mappings retain original implementation slots. Invocation assignments and
// actual caller loans fill those slots before source origin selection or direct MIR admission.
effect fn completedWitnessApplication(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  request: &mut Request, dependencies: &mut List<Dependency>, recipe: &WitnessRecipe,
  module: &ModuleId, span: Span) -> Result<ResolvedWitness, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let operation = DeclarationId.copyShared(&recipe.operation)
  // A union provider's witness is the operation itself under `Self := U`; its instance dispatches
  // on the receiver's tag (UNION-003), so every operand passes as written.
  if Shared<Type>.with<bool>(&recipe.provider, unionType) {
    let application = run unionOperationApplication(recipe, &operation)
    let mut operands = List<OperandPass>.make()
    let mut at = usize.ZERO
    while at < CallableWitness.argumentCount(recipe) {
      run List<OperandPass>.append(&mut operands, OperandPass.Value)
      at = at + usize.ONE
    }
    return Result<ResolvedWitness, Shared<Rejection>>.succeed(ResolvedWitness {application: move application, operands: move operands})
  }
  let selected = run resolveWitnessApplication(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
    true, &recipe.contract, &recipe.provider, &operation, module, span)
  let witness = match move selected {
    Result<ResolvedWitness, Shared<Rejection>>.Success {value} => move value
    Result<ResolvedWitness, Shared<Rejection>>.Failure {error} => { return Result<ResolvedWitness, Shared<Rejection>>.failResult(move error) }
  }
  let passes = List<OperandPass>.asSlice(&witness.operands)
  if passes.length != CallableWitness.argumentCount(recipe) || passes.length != CallableWitness.loanCount(recipe) {
    return Result<ResolvedWitness, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Unsupported, span))
  }
  let mut invocation = List<Binding>.make()
  let mut at = usize.ZERO
  while at < CallableWitness.bindingCount(recipe) {
    run List<Binding>.append(&mut invocation, CallableWitness.bindingAt(recipe, at))
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < passes.length {
    if let OperandPass.Borrow {lifetimeOrdinal, ..} = &passes[at] {
      run List<Binding>.append(&mut invocation, Binding {
        declaration: run Shared<DeclarationId>.make(DeclarationId.copy(Application.bodyDeclaration(&witness.application))),
        ordinal: lifetimeOrdinal, value: Argument.Lifetime {value: match move CallableWitness.loanAt(recipe, at) {
          Option<Shared<Lifetime>>.Some {value} => move value
          _ => { return Result<ResolvedWitness, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Unsupported, span)) }
        }}})
    }
    at = at + usize.ONE
  }
  let application = run Application.applyBindings(&witness.application, List<Binding>.asSlice(&invocation))
  return Result<ResolvedWitness, Shared<Rejection>>.succeed(ResolvedWitness {application: move application, operands: move witness.operands})
}

// The application of interface operation `operation` itself: its own binders take the
// invocation's assignments, and its interface's binders take the contract's arguments and then
// the provider as `Self`.
effect fn unionOperationApplication(recipe: &WitnessRecipe, operation: &DeclarationId) -> Application
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut arguments = List<Argument>.make()
  let mut ordinals = List<usize>.make()
  let mut at = usize.ZERO
  while at < CallableWitness.bindingCount(recipe) {
    let binding = CallableWitness.bindingAt(recipe, at)
    let own = Shared<DeclarationId>.with<bool>(&binding.declaration, fn(value: &DeclarationId) -> bool {
      return DeclarationId.equals(value, operation)
    })
    if own {
      run List<Argument>.append(&mut arguments, move binding.value)
      run List<usize>.append(&mut ordinals, binding.ordinal)
    }
    at = at + usize.ONE
  }
  let mut enclosing = List<Argument>.make()
  let mut enclosingOrdinals = List<usize>.make()
  let mut count = Shared<Type>.with<usize>(&recipe.contract, applicationLength)
  if count == usize.MAX { count = usize.ZERO }
  at = usize.ZERO
  while at < count {
    let argument = Shared<Type>.with<Option<Argument>>(&recipe.contract, fn(value: &Type) -> Option<Argument> {
      return applicationArgument(value, at)
    })
    if let Option<Argument>.Some {value} = move argument {
      run List<usize>.append(&mut enclosingOrdinals, List<Argument>.length(&enclosing))
      run List<Argument>.append(&mut enclosing, move value)
    }
    at = at + usize.ONE
  }
  run List<usize>.append(&mut enclosingOrdinals, List<Argument>.length(&enclosing))
  run List<Argument>.append(&mut enclosing, Argument.Type {value: Shared<Type>.clone(&recipe.provider)})
  let contractOwner = run DeclarationId.enclosing(operation, DeclarationId.ownerCount(operation) - usize.ONE)
  let mut scopes = List<ScopeBinding>.make()
  run List<ScopeBinding>.append(&mut scopes, ScopeBinding {owner: run Shared<DeclarationId>.make(move contractOwner),
    arguments: move enclosing, argumentOrdinals: move enclosingOrdinals})
  let target = SpecializationTarget.Operation {contract: Shared<Type>.clone(&recipe.contract),
    provider: Shared<Type>.clone(&recipe.provider), operation: DeclarationId.copy(operation), implementation: DeclarationId.copy(operation)}
  return Application {target: move target, arguments: move arguments,
    argumentOrdinals: move ordinals, scopes: move scopes, statics: List<StaticSlot>.make()}
}

struct WitnessEntry {
  value: Argument,
  ordinal: usize,
}

struct WitnessScope {
  owner: Shared<DeclarationId>,
  count: usize,
}

fn selectedWitness(answer: &Result<Answer, NoRejection>, operation: &DeclarationId) -> usize {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Witnesses {witnesses}} = &value.outcome {
      let listed = List<Witness>.asSlice(&witnesses)
      let mut at = usize.ZERO
      while at < listed.length {
        if Shared<DeclarationId>.with<bool>(&listed[at].operation, fn(id: &DeclarationId) -> bool { return DeclarationId.equals(id, operation) }) { return at }
        at = at + usize.ONE
      }
    }
  }
  return usize.MAX
}

fn witnessOperandsCount(answer: &Result<Answer, NoRejection>, operation: &DeclarationId) -> usize {
  let selected = selectedWitness(answer, operation)
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Witnesses {witnesses}} = &value.outcome {
      let listed = List<Witness>.asSlice(&witnesses)
      if selected < listed.length { return List<OperandPass>.length(&listed[selected].operands) }
    }
  }
  return usize.ZERO
}

fn witnessOperandAt(answer: &Result<Answer, NoRejection>, operation: &DeclarationId, at: usize) -> OperandPass {
  let selected = selectedWitness(answer, operation)
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Witnesses {witnesses}} = &value.outcome {
      let listed = List<Witness>.asSlice(&witnesses)
      if selected < listed.length {
        let operands = List<OperandPass>.asSlice(&listed[selected].operands)
        if at < operands.length { return operands[at] }
      }
    }
  }
  return absurd<OperandPass>()
}

fn witnessEntry(answer: &Result<Answer, NoRejection>, operation: &DeclarationId, scope: usize, at: usize) -> Option<WitnessEntry> {
  let selected = selectedWitness(answer, operation)
  if selected == usize.MAX { return Option<WitnessEntry>.none() }
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Witnesses {witnesses}} = &value.outcome {
      let listed = List<Witness>.asSlice(&witnesses)
      let witness = &listed[selected]
      if scope == usize.MAX {
        let values = List<Argument>.asSlice(&witness.arguments)
        let ordinals = List<usize>.asSlice(&witness.argumentOrdinals)
        if at < values.length && at < ordinals.length { return Option<WitnessEntry>.some(WitnessEntry {value: Argument.copy(&values[at]), ordinal: ordinals[at]}) }
      } else {
        let scopes = List<ScopeBinding>.asSlice(&witness.scopes)
        if scope < scopes.length {
          let values = List<Argument>.asSlice(&scopes[scope].arguments)
          let ordinals = List<usize>.asSlice(&scopes[scope].argumentOrdinals)
          if at < values.length && at < ordinals.length { return Option<WitnessEntry>.some(WitnessEntry {value: Argument.copy(&values[at]), ordinal: ordinals[at]}) }
        }
      }
    }
  }
  return Option<WitnessEntry>.none()
}

fn witnessScope(answer: &Result<Answer, NoRejection>, operation: &DeclarationId, at: usize) -> Option<WitnessScope> {
  let selected = selectedWitness(answer, operation)
  if selected != usize.MAX {
    if let Result<Answer, NoRejection>.Success {value} = &answer.* {
      if let Outcome.Success {value: Value.Witnesses {witnesses}} = &value.outcome {
        let listed = List<Witness>.asSlice(&witnesses)
        let selectedWitness = &listed[selected]
        let scopes = List<ScopeBinding>.asSlice(&selectedWitness.scopes)
        if at < scopes.length { return Option<WitnessScope>.some(WitnessScope {owner: Shared<DeclarationId>.clone(&scopes[at].owner), count: List<Argument>.length(&scopes[at].arguments)}) }
      }
    }
  }
  return Option<WitnessScope>.none()
}

// Witness.arguments is already ordered by the actual target's binders, including mapped
// implementations whose binder order or arity differs from the conformance head's.
effect fn mappedWitnessApplication(
  answer: &Shared<Result<Answer, NoRejection>>,
  operation: &DeclarationId,
  recipeBindings: &[Binding],
) -> Option<Application> ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let selected = Shared<Result<Answer, NoRejection>>.with<Option<WitnessImplementation>>(answer,
    fn(value: &Result<Answer, NoRejection>) -> Option<WitnessImplementation> {
      return witnessFor(value, operation)
    })
  if let Option<WitnessImplementation>.Some {value: WitnessImplementation.Declaration {declaration: target}} = move selected {
    let count = Shared<Result<Answer, NoRejection>>.with<usize>(answer,
      fn(value: &Result<Answer, NoRejection>) -> usize { return witnessArgumentsCount(value, operation) })
    let mut arguments = List<Argument>.make()
    let mut ordinals = List<usize>.make()
    let mut at = usize.ZERO
    while at < count {
      let selected = Shared<Result<Answer, NoRejection>>.with<Option<WitnessEntry>>(answer,
        fn(value: &Result<Answer, NoRejection>) -> Option<WitnessEntry> { return witnessEntry(value, operation, usize.MAX, at) })
      if let Option<WitnessEntry>.Some {value} = move selected {
        run List<Argument>.append(&mut arguments, run Argument.applyBindings(&value.value, recipeBindings, true))
        run List<usize>.append(&mut ordinals, value.ordinal)
      } else { return Option<Application>.none() }
      at = at + usize.ONE
    }
    let mut scopes = List<ScopeBinding>.make()
    at = usize.ZERO
    while true {
      let selectedScope = Shared<Result<Answer, NoRejection>>.with<Option<WitnessScope>>(answer,
        fn(value: &Result<Answer, NoRejection>) -> Option<WitnessScope> { return witnessScope(value, operation, at) })
      let scope = match move selectedScope { Option<WitnessScope>.Some {value} => move value _ => { break } }
      let mut values = List<Argument>.make()
      let mut slots = List<usize>.make()
      let mut index = usize.ZERO
      while index < scope.count {
        let entry = Shared<Result<Answer, NoRejection>>.with<Option<WitnessEntry>>(answer,
          fn(value: &Result<Answer, NoRejection>) -> Option<WitnessEntry> { return witnessEntry(value, operation, at, index) })
        if let Option<WitnessEntry>.Some {value} = move entry {
          run List<Argument>.append(&mut values, run Argument.applyBindings(&value.value, recipeBindings, true))
          run List<usize>.append(&mut slots, value.ordinal)
        } else { return Option<Application>.none() }
        index = index + usize.ONE
      }
      run List<ScopeBinding>.append(&mut scopes, ScopeBinding {owner: move scope.owner, arguments: move values, argumentOrdinals: move slots})
      at = at + usize.ONE
    }
    return Option<Application>.some(Application {
      target: SpecializationTarget.Named {declaration: DeclarationId.copyShared(&target)}, arguments: move arguments, argumentOrdinals: move ordinals, scopes: move scopes,
      statics: List<StaticSlot>.make(),
    })
  }
  return Option<Application>.none()
}

fn witnessArgumentsCount(answer: &Result<Answer, NoRejection>, operation: &DeclarationId) -> usize {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Witnesses {witnesses}} = &value.outcome {
      let listed = List<Witness>.asSlice(&witnesses)
      let mut at = usize.ZERO
      while at < listed.length {
        if Shared<DeclarationId>.with<bool>(&listed[at].operation,
          fn(value: &DeclarationId) -> bool { return DeclarationId.equals(value, operation) }) {
          return List<Argument>.length(&listed[at].arguments)
        }
        at = at + usize.ONE
      }
    }
  }
  return usize.ZERO
}

struct ReferenceReceiver {
  referent: Shared<Type>,
  mode: BodyReceiverPass,
}

// A receiver operand is the first parameter taking `Self` by value or by either borrow mode.
// Call arguments and the expected result do not participate in this eligibility check.
effect fn receiverPosition(signature: &Shared<Result<Answer, NoRejection>>, provider: &Shared<Type>) -> Option<
  ReceiverPosition,
> ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let count = Shared<Result<Answer, NoRejection>>.with<usize>(signature, signatureParameterCount)
  if count == usize.ZERO {
    return Option<ReceiverPosition>.none()
  }
  let at = usize.ZERO
  let parameter = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(
    signature,
    fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> {
      return signatureParameter(answer, at)
    },
  )
  if let Option<Shared<Type>>.Some {value} = move parameter {
    if run Type.equalsShared(&value, provider) {
      return Option<ReceiverPosition>.some(
        ReceiverPosition {ordinal: at, mode: BodyReceiverPass.Take},
      )
    }
    let reference = Shared<Type>.with<Option<ReferenceReceiver>>(
      &value,
      fn(parameterType: &Type) -> Option<ReferenceReceiver> {
        return match & parameterType.* {
          Type.Reference {referent, access, ..} => Option<ReferenceReceiver>.some(
            ReferenceReceiver {
              referent: Shared<Type>.clone(&referent),
              mode: match access {
                Access.Shared => BodyReceiverPass.Shared
                Access.Mutable => BodyReceiverPass.Mutable
              },
            },
          )
          _ => Option<ReferenceReceiver>.none()
        }
      },
    )
    if let Option<ReferenceReceiver>.Some {value: borrowed} = move reference {
      if run Type.equalsShared(&borrowed.referent, provider) {
        return Option<ReceiverPosition>.some(ReceiverPosition {ordinal: at, mode: borrowed.mode})
      }
    }
  }
  return Option<ReceiverPosition>.none()
}

// An owner's own names answer before any conformance lookup. A rejected or private inherent
// member, field, or receiver-less associated function is never rescued by an interface operation.
effect fn selectInherentReceiverCall(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut List<Dependency>,
  nested: bool,
  provider: &Shared<Type>,
  member: &[u8],
  inferOwner: bool,
  requireReceiver: bool,
  siteModule: &ModuleId,
  siteSpan: Span,
) -> Result<InherentCallChoice, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let moduleOrdinal = declaringModuleOrdinal(&resolver.*, provider)
  if moduleOrdinal == usize.MAX {
    return Result<InherentCallChoice, Shared<Rejection>>.succeed(InherentCallChoice.Missing)
  }
  let module = resolvedModule(&resolver.*, moduleOrdinal)
  let found = run ordinalOfProvider(&mut resolver.*, &module, provider)
  let ownerOrdinal = match move found {
    Option<usize>.Some {value} => value
    Option<usize>.None => {
      return Result<InherentCallChoice, Shared<Rejection>>.succeed(InherentCallChoice.Missing)
    }
  }
  let declarationAccess221 = run inherentMemberKey(&mut resolver.*, moduleOrdinal, ownerOrdinal, member)
  let own = run proofDemand(
    &mut resolver.*,
    &mut owner.*,
    &mut request.*,
    &mut dependencies.*,
    declarationAccess221,
    siteSpan,
    nested,
  )
  let failure = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(
    &own,
    answerCause,
  )
  if let Option<Shared<Rejection>>.Some {value} = move failure {
    return Result<InherentCallChoice, Shared<Rejection>>.failResult(move value)
  }
  let lookup = Shared<Result<Answer, NoRejection>>.with<InherentLookup>(
    &own,
    fn(answer: &Result<Answer, NoRejection>) -> InherentLookup {
      return projectedMember(answer)
    },
  )
  if let Option<Shared<Rejection>>.Some {value} = move lookup.rejected {
    return Result<InherentCallChoice, Shared<Rejection>>.failResult(move value)
  }
  if let Option<Shared<DeclarationId>>.Some {value: declaration} = move lookup.published {
    let ordinal = run ordinalOfIdentity(&mut resolver.*, &module, &declaration)
    if let Option<usize>.Some {value: position} = move ordinal {
      // Only the member's visibility and linkage are read here; its signature is a unit.
      let written = run observedHeader(&mut resolver.*, &module, position, SourceFacet.Identity)
      let mut published = true
      let mut foreign = false
      if let Option<HeaderSyntax>.Some {value} = move written {
        if let Node.FunctionHeader {isPublic, linkage, ..} = value.header {
          foreign = linkage.present
          published = isPublic
          if !isPublic && !ModuleId.equals(siteModule, &module) {
            return Result<InherentCallChoice, Shared<Rejection>>.failResult(
              run reject(&resolver.*, siteModule, RejectionCode.PrivateMember, siteSpan),
            )
          }
        }
      }
      let mut family = Family.AppliedInherent
      let mut providerKey = run internApplication(&mut resolver.*, provider)
      if inferOwner {
        // An unapplied owner is an inference template, not an application whose declaration-owned
        // arguments are already fixed. Its authored signature keeps the impl binders open.
        family = Family.Signature
        providerKey = usize.ZERO
      }
      let declarationAccess222Request = Key {
          family: family,
          module: moduleOrdinal,
          name: providerKey,
          declaration: position,
          member: usize.ZERO,
          external: false,
        }
      let declarationAccess222 = run internDeclaration(&mut resolver.*, declarationAccess222Request)
      let signature = run proofDemand(
        &mut resolver.*,
        &mut owner.*,
        &mut request.*,
        &mut dependencies.*,
        declarationAccess222,
        siteSpan,
        nested,
      )
      let failure = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(
        &signature,
        answerCause,
      )
      if let Option<Shared<Rejection>>.Some {value} = move failure {
        return Result<InherentCallChoice, Shared<Rejection>>.failResult(move value)
      }
      let receiver = run receiverPosition(&signature, provider)
      let mut validReceiver = !requireReceiver
      if let Option<ReceiverPosition>.Some {value} = &receiver {
        validReceiver = validReceiver || value.ordinal == usize.ZERO
      }
      if validReceiver {
        let identity = run declarationAt(&mut resolver.*, &module, position)
        if let Option<DeclarationId>.Some {value: selected} = move identity {
          let mut scopeArguments = List<Argument>.make()
          if !inferOwner { scopeArguments = run typeApplicationArguments(provider) }
          return Result<InherentCallChoice, Shared<Rejection>>.succeed(
            InherentCallChoice.Selected {
              target: CallTarget {
                foreign: foreign,
                declaration: move selected,
                isPublic: published,
                signature: move signature,
                explicit: List<Argument>.make(),
                explicitSlots: List<CallPrefixSlot>.make(), prefixOwner: Option<Shared<DeclarationId>>.none(), prefixLifetimes: usize.ZERO,
                scopeArguments: move scopeArguments,
                inferOwner: inferOwner,
                explicitSyntax: false,
              },
              receiver: move receiver,
            },
          )
        }
      }
      return Result<InherentCallChoice, Shared<Rejection>>.failResult(
        run reject(&resolver.*, siteModule, RejectionCode.AssociatedFunctionOnValue, siteSpan),
      )
    }
  }
  let declarationAccess223Request = Key {
      family: Family.Members,
      module: moduleOrdinal,
      name: usize.ZERO,
      declaration: ownerOrdinal,
      member: usize.ZERO,
      external: false,
    }
  let declarationAccess223 = run internDeclaration(&mut resolver.*, declarationAccess223Request)
  let claims = run proofDemand(
    &mut resolver.*,
    &mut owner.*,
    &mut request.*,
    &mut dependencies.*,
    declarationAccess223,
    siteSpan,
    nested,
  )
  if Shared<Result<Answer, NoRejection>>.with<bool>(
    &claims,
    fn(answer: &Result<Answer, NoRejection>) -> bool {
      return ownerClaims(answer, member)
    },
  ) {
    return Result<InherentCallChoice, Shared<Rejection>>.succeed(InherentCallChoice.Claimed)
  }
  return Result<InherentCallChoice, Shared<Rejection>>.succeed(InherentCallChoice.Missing)
}

// The chosen supplier's operation is proven and called once receiver selection is unambiguous.
effect fn selectedReceiverOperation(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut List<Dependency>,
  nested: bool,
  provider: &Shared<Type>,
  declared: &[Constraint],
  siteModule: &ModuleId,
  siteSpan: Span,
  candidates: &[MethodSupplier],
  selected: Option<usize>,
) -> Result<Option<SelectedReceiverOperation>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let index = match move selected {
    Option<usize>.Some {value} => value
    Option<usize>.None => {
      return Result<Option<SelectedReceiverOperation>, Shared<Rejection>>.succeed(
        Option<SelectedReceiverOperation>.none(),
      )
    }
  }
  let chosen = &candidates[index]
  let module = resolvedModule(&resolver.*, chosen.operationModule)
  let operation = run declarationAt(&mut resolver.*, &module, chosen.operationOrdinal)
  let identity = match move operation {
    Option<DeclarationId>.Some {value} => move value
    Option<DeclarationId>.None => {
      return Result<Option<SelectedReceiverOperation>, Shared<Rejection>>.succeed(
        Option<SelectedReceiverOperation>.none(),
      )
    }
  }
  let found = run selectOperationCall(
    &mut resolver.*,
    &mut owner.*,
    &mut request.*,
    &mut dependencies.*,
    nested,
    &chosen.contract,
    provider,
    &identity,
    declared,
    siteModule,
    siteSpan,
  )
  let operationCall = match move found {
    Result<OperationCall, Shared<Rejection>>.Success {value} => move value
    Result<OperationCall, Shared<Rejection>>.Failure {error} => {
      return Result<Option<SelectedReceiverOperation>, Shared<Rejection>>.failResult(move error)
    }
  }
  let mut selectedCall = move operationCall
  selectedCall.receiver = Option<ReceiverPosition>.some(chosen.receiver)
  return Result<Option<SelectedReceiverOperation>, Shared<Rejection>>.succeed(
    Option<SelectedReceiverOperation>.some(
      SelectedReceiverOperation {
        contract: Shared<Type>.clone(&chosen.contract),
        call: move selectedCall,
      },
    ),
  )
}

fn isInterfaceHeader(written: Option<HeaderSyntax>) -> bool {
  if let Option<HeaderSyntax>.Some {value} = move written {
    if let Node.InterfaceHeader {..} = value.header {
      return true
    }
  }
  return false
}

// One listed operation of a bound interface supplies the receiver call when its name matches and
// its applied signature takes the provider as receiver.
effect fn appendBoundOperationSupplier(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut List<Dependency>,
  nested: bool,
  provider: &Shared<Type>,
  member: &[u8],
  contract: &Shared<Type>,
  contractModule: usize,
  module: &ModuleId,
  listed: &Shared<Result<Answer, NoRejection>>,
  operationAtIndex: usize,
  siteSpan: Span,
  candidates: &mut List<MethodSupplier>,
  selection: &mut CallSelection,
) -> Result<(), Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let operation = Shared<Result<Answer, NoRejection>>.with<Option<Shared<DeclarationId>>>(
    listed,
    fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<DeclarationId>> {
      return operationAt(answer, operationAtIndex)
    },
  )
  let identity = match move operation {
    Option<Shared<DeclarationId>>.Some {value} => move value
    Option<Shared<DeclarationId>>.None => {
      return Result<(), Shared<Rejection>>.succeed(())
    }
  }
  let named = Shared<DeclarationId>.with<bool>(
    &identity,
    fn(value: &DeclarationId) -> bool {
      return DeclarationId.named(value, member)
    },
  )
  if !named {
    return Result<(), Shared<Rejection>>.succeed(())
  }
  let sourceOrdinal = run ordinalOfIdentity(&mut resolver.*, module, &identity)
  let operationOrdinal = match move sourceOrdinal {
    Option<usize>.Some {value} => value
    Option<usize>.None => {
      return Result<(), Shared<Rejection>>.succeed(())
    }
  }
  let contractKey = run internApplication(&mut resolver.*, contract)
  let providerKey = run internApplication(&mut resolver.*, provider)
  let declarationAccess224Request = Key {
      family: Family.AppliedOperation,
      module: contractModule,
      name: contractKey,
      declaration: operationOrdinal,
      member: providerKey,
      external: false,
    }
  let declarationAccess224 = run internDeclaration(&mut resolver.*, declarationAccess224Request)
  let signature = run proofDemand(
    &mut resolver.*,
    &mut owner.*,
    &mut request.*,
    &mut dependencies.*,
    declarationAccess224,
    siteSpan,
    nested,
  )
  let failure = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(
    &signature,
    answerCause,
  )
  if let Option<Shared<Rejection>>.Some {value} = move failure {
    return Result<(), Shared<Rejection>>.failResult(move value)
  }
  let receiver = run receiverPosition(&signature, provider)
  let receiverPositionValue = match move receiver {
    Option<ReceiverPosition>.Some {value} => value
    Option<ReceiverPosition>.None => {
      return Result<(), Shared<Rejection>>.succeed(())
    }
  }
  let index = List<MethodSupplier>.length(&candidates.*)
  run List<MethodSupplier>.append(
    &mut candidates.*,
    MethodSupplier {
      contract: Shared<Type>.clone(contract),
      operationModule: contractModule,
      operationOrdinal: operationOrdinal,
      receiver: receiverPositionValue,
    },
  )
  CallSelection.add(&mut selection.*, index)
  return Result<(), Shared<Rejection>>.succeed(())
}

// The operations of one written interface bound supply receiver methods for the provider.
effect fn appendBoundContractSuppliers(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut List<Dependency>,
  nested: bool,
  provider: &Shared<Type>,
  member: &[u8],
  contract: &Shared<Type>,
  siteSpan: Span,
  candidates: &mut List<MethodSupplier>,
  selection: &mut CallSelection,
) -> Result<(), Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let contractModule = declaringModuleOrdinal(&resolver.*, contract)
  if contractModule == usize.MAX {
    fail InvalidModulePath {}
  }
  let module = resolvedModule(&resolver.*, contractModule)
  let contractOrdinal = run ordinalOfProvider(&mut resolver.*, &module, contract)
  let position = match move contractOrdinal {
    Option<usize>.Some {value} => value
    Option<usize>.None => {
      return Result<(), Shared<Rejection>>.succeed(())
    }
  }
  let written = run observedHeader(&mut resolver.*, &module, position, SourceFacet.Identity)
  if !isInterfaceHeader(move written) {
    return Result<(), Shared<Rejection>>.succeed(())
  }
  let declarationAccess225Request = Key {
      family: Family.Operations,
      module: contractModule,
      name: usize.ZERO,
      declaration: position,
      member: usize.ZERO,
      external: false,
    }
  let declarationAccess225 = run internDeclaration(&mut resolver.*, declarationAccess225Request)
  let listed = run proofDemand(
    &mut resolver.*,
    &mut owner.*,
    &mut request.*,
    &mut dependencies.*,
    declarationAccess225,
    siteSpan,
    nested,
  )
  let failure = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(
    &listed,
    answerCause,
  )
  if let Option<Shared<Rejection>>.Some {value} = move failure {
    return Result<(), Shared<Rejection>>.failResult(move value)
  }
  let count = Shared<Result<Answer, NoRejection>>.with<usize>(&listed, operationCount)
  let mut operationAtIndex = usize.ZERO
  while operationAtIndex < count {
    let added = run appendBoundOperationSupplier(
      &mut resolver.*,
      &mut owner.*,
      &mut request.*,
      &mut dependencies.*,
      nested,
      provider,
      member,
      contract,
      contractModule,
      &module,
      &listed,
      operationAtIndex,
      siteSpan,
      &mut candidates.*,
      &mut selection.*,
    )
    if let Result<(), Shared<Rejection>>.Failure {error} = move added {
      return Result<(), Shared<Rejection>>.failResult(move error)
    }
    operationAtIndex = operationAtIndex + usize.ONE
  }
  return Result<(), Shared<Rejection>>.succeed(())
}

// Only a conformance bound on exactly this provider can supply receiver methods.
effect fn appendBoundConstraintSuppliers(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut List<Dependency>,
  nested: bool,
  provider: &Shared<Type>,
  member: &[u8],
  constraint: &Constraint,
  siteSpan: Span,
  candidates: &mut List<MethodSupplier>,
  selection: &mut CallSelection,
) -> Result<(), Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  if let Constraint.Conforms {provider: bounded, contract} = &constraint.* {
    if run Type.equalsShared(provider, &bounded) {
      return run appendBoundContractSuppliers(
        &mut resolver.*,
        &mut owner.*,
        &mut request.*,
        &mut dependencies.*,
        nested,
        provider,
        member,
        &contract,
        siteSpan,
        &mut candidates.*,
        &mut selection.*,
      )
    }
  }
  return Result<(), Shared<Rejection>>.succeed(())
}

// For an abstract provider, only its written interface bounds can supply receiver methods.
// Choose the supplier by name and receiver contract before considering call arguments.
effect fn selectBoundReceiverCall(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut List<Dependency>,
  nested: bool,
  provider: &Shared<Type>,
  member: &[u8],
  declared: &[Constraint],
  siteModule: &ModuleId,
  siteSpan: Span,
) -> Result<Option<SelectedReceiverOperation>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let mut candidates = List<MethodSupplier>.make()
  let mut selection = CallSelection.make()
  let mut at = usize.ZERO
  while at < declared.length {
    let added = run appendBoundConstraintSuppliers(
      &mut resolver.*,
      &mut owner.*,
      &mut request.*,
      &mut dependencies.*,
      nested,
      provider,
      member,
      &declared[at],
      siteSpan,
      &mut candidates,
      &mut selection,
    )
    if let Result<(), Shared<Rejection>>.Failure {error} = move added {
      return Result<Option<SelectedReceiverOperation>, Shared<Rejection>>.failResult(move error)
    }
    at = at + usize.ONE
  }
  if CallSelection.ambiguous(&selection) {
    return Result<Option<SelectedReceiverOperation>, Shared<Rejection>>.failResult(
      run ambiguousOperationRejection(siteModule, RejectionCode.AmbiguousBoundMethod, siteSpan, member, b"parameter", provider,
        List<MethodSupplier>.asSlice(&candidates)),
    )
  }
  let selected = CallSelection.unique(&selection)
  return run selectedReceiverOperation(
    &mut resolver.*,
    &mut owner.*,
    &mut request.*,
    &mut dependencies.*,
    nested,
    provider,
    declared,
    siteModule,
    siteSpan,
    List<MethodSupplier>.asSlice(&candidates),
    move selected,
  )
}

fn alreadyVisible(interfaces: &[VisibleInterface], module: usize, ordinal: usize) -> bool {
  let mut at = usize.ZERO
  while at < interfaces.length {
    if interfaces[at].module == module && interfaces[at].ordinal == ordinal {
      return true
    }
    at = at + usize.ONE
  }
  return false
}

// Only declarations the caller can name contribute method suppliers. A namespace import opens
// the imported module's public namespace; it does not activate or hide any conformance head.
effect fn appendInterfaceNames(
  resolver: &mut Resolver,
  module: &ModuleId,
  moduleOrdinal: usize,
  external: bool,
  names: &mut List<VisibleName>,
) -> () ! Cycle | OutOfMemoryError ? &mut Allocator {
  let answer = run observedSource(&mut resolver.*, module, SourceSelector.VisibleNames {namespaces: false, external: external})
  let mut scanKind = ModuleScanKind.InterfaceNames
  if external { scanKind = ModuleScanKind.ExternalInterfaceNames }
  let mut fresh = Option<ModuleScan>.none()
  if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(&resolver.*, &answer, module) {
    let index = IndexedSource.moduleIndex(indexed)
    let revision = ModuleIndex.sourceRevision(index)
    let known = cachedScan(&resolver.*, moduleOrdinal, scanKind, revision)
    if known != usize.MAX {
      let found = List<Bytes>.asSlice(&List<ModuleScan>.asSlice(&resolver.moduleScans)[known].names)
      let mut at = usize.ZERO
      while at < found.length {
        run List<VisibleName>.append(&mut names.*,
          VisibleName {module: moduleOrdinal, name: run Bytes.copy(Bytes.asSlice(&found[at])), external: external})
        at = at + usize.ONE
      }
    } else {
      let candidates = ModuleIndex.listCandidates(index)
      let declarations = ModuleIndex.listDeclarations(index)
      let hir = IndexedSource.authored(indexed)
      let mut scanned = List<Bytes>.make()
      let mut at = usize.ZERO
      while at < candidates.length {
        let candidate = &candidates[at]
        if (!external || candidate.isPublic) && candidate.kind != CandidateKind.ImportModule {
          let mut possible = candidate.kind == CandidateKind.ImportMember
          if candidate.kind == CandidateKind.Declaration && candidate.declaration < declarations.length {
            if let Node.InterfaceHeader {..} = Module.node(
              hir,
              declarations[candidate.declaration].header,
            ) {
              possible = true
            }
          }
          if possible {
            run List<VisibleName>.append(
              &mut names.*,
              VisibleName {
                module: moduleOrdinal,
                name: run Bytes.copy(Bytes.asSlice(&candidate.name)),
                external: external,
              },
            )
            run List<Bytes>.append(&mut scanned, run Bytes.copy(Bytes.asSlice(&candidate.name)))
          }
        }
        at = at + usize.ONE
      }
      fresh = Option<ModuleScan>.some(ModuleScan {module: moduleOrdinal, kind: scanKind, revision: revision,
        ordinals: List<usize>.make(), names: move scanned})
    }
  }
  if let Option<ModuleScan>.Some {value: entry} = move fresh { run recordScan(&mut resolver.*, move entry) }
  return ()
}

// What one whole-module scan found, valid for the source revision it read.
struct ModuleScan {
  module: usize,
  kind: ModuleScanKind,
  revision: usize,
  ordinals: List<usize>,
  names: List<Bytes>,
}

enum ModuleScanKind { InterfaceNames, ExternalInterfaceNames, InherentImplementations }

fn scanKey(module: usize, kind: ModuleScanKind) -> u64 {
  let mut tag: usize = 0
  if kind == ModuleScanKind.ExternalInterfaceNames { tag = 1 }
  if kind == ModuleScanKind.InherentImplementations { tag = 2 }
  return headerKey(module, tag)
}

// The cached scan of `kind` over `module` read from `revision`, or `usize.MAX`.
fn cachedScan(resolver: &Resolver, module: usize, kind: ModuleScanKind, revision: usize) -> usize {
  let cached = List<ModuleScan>.asSlice(&resolver.moduleScans)
  let mut at = InternIndex.first(&resolver.moduleScanLookup, scanKey(module, kind))
  while at != usize.MAX {
    if cached[at].module == module && cached[at].kind == kind && cached[at].revision == revision { return at }
    at = InternIndex.after(&resolver.moduleScanLookup, at)
  }
  return usize.MAX
}

effect fn recordScan(resolver: &mut Resolver, entry: ModuleScan) -> () ! OutOfMemoryError ? &mut Allocator {
  let key = scanKey(entry.module, entry.kind)
  run List<ModuleScan>.append(&mut resolver.moduleScans, move entry)
  run InternIndex.record(&mut resolver.moduleScanLookup, key)
  return ()
}

effect fn visibleInterfaces(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut List<Dependency>,
  siteModule: &ModuleId,
  siteSpan: Span,
) -> Result<List<VisibleInterface>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let siteOrdinal = run internModule(&mut resolver.*, siteModule)
  let mut names = List<VisibleName>.make()
  run appendInterfaceNames(&mut resolver.*, siteModule, siteOrdinal, false, &mut names)
  let mut namespaces = List<Bytes>.make()
  let answer = run observedSource(&mut resolver.*, siteModule, SourceSelector.VisibleNames {namespaces: true, external: false})
  if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(
    &resolver.*,
    &answer,
    siteModule,
  ) {
    let candidates = ModuleIndex.listCandidates(IndexedSource.moduleIndex(indexed))
    let mut at = usize.ZERO
    while at < candidates.length {
      if candidates[at].kind == CandidateKind.ImportModule {
        run List<Bytes>.append(
          &mut namespaces,
          run Bytes.copy(Bytes.asSlice(&candidates[at].name)),
        )
      }
      at = at + usize.ONE
    }
  }
  let imported = List<Bytes>.asSlice(&namespaces)
  let mut namespaceAt = usize.ZERO
  while namespaceAt < imported.length {
    // Method syntax names no interface; an invisible namespace contributes none, and a failed
    // governing condition fails the call.
    let scanned = run scannedSelection(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies.*,
      siteModule,
      Bytes.asSlice(&imported[namespaceAt]),
      false,
    )
    let namespaceSelection = match move scanned {
      Result<Option<Selection>, Shared<Rejection>>.Success {value} => move value
      Result<Option<Selection>, Shared<Rejection>>.Failure {error} => {
        return Result<List<VisibleInterface>, Shared<Rejection>>.failResult(move error)
      }
    }
    let mut selected = emptySelection()
    if let Option<Selection>.Some {value: visibleNamespace} = move namespaceSelection {
      selected = visibleNamespace
    }
    if selected.count == usize.ONE && selected.kind == CandidateKind.ImportModule {
      let declarationAccess226Request = Key {
          family: Family.Import,
          module: siteOrdinal,
          name: usize.ZERO,
          declaration: selected.declaration,
          member: usize.MAX,
          external: false,
        }
      let declarationAccess226 = run internDeclaration(&mut resolver.*, declarationAccess226Request)
      let answer = run proofDemand(
        &mut resolver.*,
        &mut owner.*,
        &mut request.*,
        &mut dependencies.*,
        declarationAccess226,
        siteSpan,
        true,
      )
      let binding = Shared<Result<Answer, NoRejection>>.with<ImportSelection>(
        &answer,
        fn(answer: &Result<Answer, NoRejection>) -> ImportSelection { return selectedImport(&resolver.*, answer) },
      )
      if let Option<usize>.Some {value: targetOrdinal} = move binding.module {
        let target = resolvedModule(&resolver.*, targetOrdinal)
        run appendInterfaceNames(&mut resolver.*, &target, targetOrdinal, true, &mut names)
      }
    }
    namespaceAt = namespaceAt + usize.ONE
  }
  let mut interfaces = List<VisibleInterface>.make()
  let candidates = List<VisibleName>.asSlice(&names)
  let mut at = usize.ZERO
  while at < candidates.length {
    let candidateModule = resolvedModule(&resolver.*, candidates[at].module)
    let scannedName = run scannedSelection(
      &mut resolver.*, &mut owner.*, &mut dependencies.*, &candidateModule,
      Bytes.asSlice(&candidates[at].name), candidates[at].external,
    )
    let nameSelection = match move scannedName {
      Result<Option<Selection>, Shared<Rejection>>.Success {value} => move value
      Result<Option<Selection>, Shared<Rejection>>.Failure {error} => {
        return Result<List<VisibleInterface>, Shared<Rejection>>.failResult(move error)
      }
    }
    if let Option<Selection>.None = move nameSelection {
      at = at + usize.ONE
      continue
    }
    let selected = run selectDeclaration(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies.*,
      candidates[at].module,
      siteModule,
      Bytes.asSlice(&candidates[at].name),
      candidates[at].external,
      siteSpan,
      RejectionCode.UnknownType, RejectionCode.NotType, false)
    if let Result<SelectedDeclaration, Shared<Rejection>>.Success {value: declaration} = move selected {
      if !alreadyVisible(
        List<VisibleInterface>.asSlice(&interfaces),
        declaration.module,
        declaration.ordinal,
      ) {
        let module = resolvedModule(&resolver.*, declaration.module)
        let written = run scopedHeader(&mut resolver.*, &module, declaration.ordinal)
        if let Option<HeaderSyntax>.Some {value} = move written {
          if let Node.InterfaceHeader {..} = value.header {
            run List<VisibleInterface>.append(
              &mut interfaces,
              VisibleInterface {module: declaration.module, ordinal: declaration.ordinal},
            )
          }
        }
      }
    }
    at = at + usize.ONE
  }
  return Result<List<VisibleInterface>, Shared<Rejection>>.succeed(move interfaces)
}

// The provider fixes an impl head before its interface arguments are considered. Re-resolve an
// open contract under those exact bindings; call arguments and expected results never infer them.
effect fn appliedHeadContract(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  head: &Shared<ImplementationHead>,
  bindings: &[Binding],
  siteModule: &ModuleId,
  siteSpan: Span,
) -> Result<Shared<Type>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let terms = Shared<ImplementationHead>.with<Option<HeadTerms>>(head, headTerms)
  let found = match move terms {
    Option<HeadTerms>.Some {value} => move value
    Option<HeadTerms>.None => {
      return Result<Shared<Type>, Shared<Rejection>>.failResult(
        run reject(&resolver.*, siteModule, RejectionCode.Unsupported, siteSpan),
      )
    }
  }
  if !Type.hasOpenParameters(&found.contract) {
    return Result<Shared<Type>, Shared<Rejection>>.succeed(move found.contract)
  }
  let moduleOrdinal = Shared<DeclarationId>.with<usize>(
    &found.declaration,
    fn(value: &DeclarationId) -> usize {
      return knownModuleOrdinal(&resolver.*, DeclarationId.moduleId(value))
    },
  )
  if moduleOrdinal == usize.MAX {
    fail InvalidModulePath {}
  }
  let module = resolvedModule(&resolver.*, moduleOrdinal)
  let located = run ordinalOfIdentity(&mut resolver.*, &module, &found.declaration)
  let ordinal = match move located {
    Option<usize>.Some {value} => value
    Option<usize>.None => {
      return CompilerBug.panic(b"MissingRetainedFact: appliedHeadContract")
    }
  }
  let written = run header(&mut resolver.*, &module, ordinal)
  let subject = match move written {
    Option<HeaderSyntax>.Some {value} => match value.header {
      Node.ImplHeader {subject, ..} => subject
      _ => {
        return Result<Shared<Type>, Shared<Rejection>>.failResult(
          run reject(&resolver.*, siteModule, RejectionCode.Unsupported, siteSpan),
        )
      }
    }
    Option<HeaderSyntax>.None => {
      return Result<Shared<Type>, Shared<Rejection>>.failResult(
        run reject(&resolver.*, siteModule, RejectionCode.Unsupported, siteSpan),
      )
    }
  }
  let template = run templateBinders(&mut resolver.*, &module, ordinal)
  let formal = match move template {
    Result<List<Binder>, Shared<Rejection>>.Success {value} => move value
    Result<List<Binder>, Shared<Rejection>>.Failure {error} => {
      return Result<Shared<Type>, Shared<Rejection>>.failResult(move error)
    }
  }
  let mut arguments = List<Argument>.make()
  let count = List<Binder>.length(&formal)
  let mut at = usize.ZERO
  while at < count {
    let found = matchedArgument(bindings, &found.declaration, at)
    let argument = match move found {
      Option<Argument>.Some {value} => move value
      Option<Argument>.None => {
        return Result<Shared<Type>, Shared<Rejection>>.failResult(
          run reject(&resolver.*, siteModule, RejectionCode.Unsupported, siteSpan),
        )
      }
    }
    run List<Argument>.append(&mut arguments, move argument)
    at = at + usize.ONE
  }
  let applied = run bindArguments(
    List<Binder>.asSlice(&formal),
    List<Argument>.asSlice(&arguments),
  )
  let mut elision = LifetimeElision {
    owner: run declarationAt(&mut resolver.*, &module, ordinal),
    nextOrdinal: count,
    output: false,
    resultDefault: Option<Shared<Lifetime>>.none(),
    generated: List<Shared<Lifetime>>.make(),
    invocation: false,
    nested: false,
    renumber: List<usize>.make(),
    staticEnvironment: false,
    supplied: Option<List<Argument>>.none(),
    assumptions: Option<List<Constraint>>.none(),
    deferred: Option<List<DeferredBounds>>.none(),
  }
  let resolved = run resolveType(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies.*,
    moduleOrdinal,
    subject,
    List<Binder>.asSlice(&applied),
    &mut elision,
  )
  let resolvedContract = match move resolved {
    Result<Shared<Type>, Shared<Rejection>>.Success {value} => move value
    Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result<Shared<Type>, Shared<Rejection>>.failResult(move error) }
  }
  // The written contract names the head's hidden representations again, in the same order, and
  // the match has bound each one to its exact representation (REP-001).
  let first = Shared<ImplementationHead>.with<usize>(head, fn(value: &ImplementationHead) -> usize {
    return headBinderCount(value) - value.reified
  })
  let mut slots = List<CallableParameter.RepresentationSlot>.make()
  let identity = DeclarationId.copyShared(&found.declaration)
  let reified = run CallableParameter.reifyArguments(&resolvedContract, &identity, first, &mut slots)
  return Result<Shared<Type>, Shared<Rejection>>.succeed(run Type.applyBindings(&reified, bindings, true))
}

// Two suppliers of the same operation through the same contract are one candidate.
effect fn hasMethodSupplier(
  existing: &[MethodSupplier],
  operationModule: usize,
  operationOrdinal: usize,
  contract: &Shared<Type>,
) -> bool ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut prior = usize.ZERO
  while prior < existing.length {
    if existing[prior].operationModule == operationModule && existing[prior].operationOrdinal == operationOrdinal && run Type.equalsShared(
      &existing[prior].contract,
      contract,
    ) {
      return true
    }
    prior = prior + usize.ONE
  }
  return false
}

// One conformance head of the provider's bucket supplies the receiver call when it matches the
// provider exactly and its applied signature takes the provider as receiver.
effect fn appendConcreteHeadSupplier(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut List<Dependency>,
  nested: bool,
  provider: &Shared<Type>,
  providerKey: usize,
  bucket: &Shared<Result<Answer, NoRejection>>,
  headAt: usize,
  visibleInterface: &VisibleInterface,
  operationOrdinal: usize,
  siteModule: &ModuleId,
  siteSpan: Span,
  candidates: &mut List<MethodSupplier>,
  selection: &mut CallSelection,
) -> Result<(), Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let candidate = Shared<Result<Answer, NoRejection>>.with<Option<Shared<ImplementationHead>>>(
    bucket,
    fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<ImplementationHead>> {
      return bucketAt(answer, headAt)
    },
  )
  let head = match move candidate {
    Option<Shared<ImplementationHead>>.Some {value} => move value
    Option<Shared<ImplementationHead>>.None => {
      return Result<(), Shared<Rejection>>.succeed(())
    }
  }
  let terms = Shared<ImplementationHead>.with<Option<HeadTerms>>(&head, headTerms)
  let termsValue = match move terms {
    Option<HeadTerms>.Some {value} => move value
    Option<HeadTerms>.None => {
      return Result<(), Shared<Rejection>>.succeed(())
    }
  }
  let mut variables = List<Shared<DeclarationId>>.make()
  run List<Shared<DeclarationId>>.append(
    &mut variables,
    Shared<DeclarationId>.clone(&termsValue.declaration),
  )
  let mut bindings = List<Binding>.make()
  let mut matched = run Type.unify(
    &termsValue.provider,
    provider,
    List<Shared<DeclarationId>>.asSlice(&variables),
    Comparison.Exact,
    &mut bindings,
  )
  if exactHeadMatched(&matched) {
    matched = run admitRepresentations(&head, List<Shared<DeclarationId>>.asSlice(&variables), &mut bindings)
  }
  if exactHeadUndetermined(&matched) {
    return Result<(), Shared<Rejection>>.failResult(
      run reject(&resolver.*, siteModule, RejectionCode.Unsupported, siteSpan),
    )
  }
  if !exactHeadMatched(&matched) {
    return Result<(), Shared<Rejection>>.succeed(())
  }
  let applied = run appliedHeadContract(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies.*,
    &head,
    List<Binding>.asSlice(&bindings),
    siteModule,
    siteSpan,
  )
  let contract = match move applied {
    Result<Shared<Type>, Shared<Rejection>>.Success {value: appliedContract} => move appliedContract
    Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
      return Result<(), Shared<Rejection>>.failResult(move error)
    }
  }
  return run appendContractSupplier(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, nested, provider,
    providerKey, move contract, visibleInterface, operationOrdinal, siteSpan, &mut candidates.*, &mut selection.*)
}

// The operation of one applied contract is a supplier when its receiver is the provider.
effect fn appendContractSupplier(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut List<Dependency>,
  nested: bool,
  provider: &Shared<Type>,
  providerKey: usize,
  contract: Shared<Type>,
  visibleInterface: &VisibleInterface,
  operationOrdinal: usize,
  siteSpan: Span,
  candidates: &mut List<MethodSupplier>,
  selection: &mut CallSelection,
) -> Result<(), Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let contractKey = run internApplication(&mut resolver.*, &contract)
  let declarationAccess227Request = Key {
      family: Family.AppliedOperation,
      module: visibleInterface.module,
      name: contractKey,
      declaration: operationOrdinal,
      member: providerKey,
      external: false,
    }
  let declarationAccess227 = run internDeclaration(&mut resolver.*, declarationAccess227Request)
  let signature = run proofDemand(
    &mut resolver.*,
    &mut owner.*,
    &mut request.*,
    &mut dependencies.*,
    declarationAccess227,
    siteSpan,
    nested,
  )
  let failure = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(
    &signature,
    answerCause,
  )
  if let Option<Shared<Rejection>>.Some {value: diagnostic} = move failure {
    return Result<(), Shared<Rejection>>.failResult(move diagnostic)
  }
  let receiver = run receiverPosition(&signature, provider)
  let receiverPositionValue = match move receiver {
    Option<ReceiverPosition>.Some {value} => value
    Option<ReceiverPosition>.None => {
      return Result<(), Shared<Rejection>>.succeed(())
    }
  }
  let duplicate = run hasMethodSupplier(
    List<MethodSupplier>.asSlice(&candidates.*),
    visibleInterface.module,
    operationOrdinal,
    &contract,
  )
  if duplicate {
    return Result<(), Shared<Rejection>>.succeed(())
  }
  let index = List<MethodSupplier>.length(&candidates.*)
  run List<MethodSupplier>.append(
    &mut candidates.*,
    MethodSupplier {
      contract: move contract,
      operationModule: visibleInterface.module,
      operationOrdinal: operationOrdinal,
      receiver: receiverPositionValue,
    },
  )
  CallSelection.add(&mut selection.*, index)
  return Result<(), Shared<Rejection>>.succeed(())
}

// One named operation of a visible interface is a supplier through every conformance head the
// receiver type matches.
effect fn appendConcreteOperationSuppliers(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut List<Dependency>,
  nested: bool,
  provider: &Shared<Type>,
  providerKey: usize,
  member: &[u8],
  listed: &Shared<Result<Answer, NoRejection>>,
  operationAtIndex: usize,
  visibleInterface: &VisibleInterface,
  module: &ModuleId,
  siteModule: &ModuleId,
  siteSpan: Span,
  candidates: &mut List<MethodSupplier>,
  selection: &mut CallSelection,
) -> Result<(), Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let operation = Shared<Result<Answer, NoRejection>>.with<Option<Shared<DeclarationId>>>(
    listed,
    fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<DeclarationId>> {
      return operationAt(answer, operationAtIndex)
    },
  )
  let identity = match move operation {
    Option<Shared<DeclarationId>>.Some {value} => move value
    Option<Shared<DeclarationId>>.None => {
      return Result<(), Shared<Rejection>>.succeed(())
    }
  }
  if !Shared<DeclarationId>.with<bool>(
    &identity,
    fn(value: &DeclarationId) -> bool {
      return DeclarationId.named(value, member)
    },
  ) {
    return Result<(), Shared<Rejection>>.succeed(())
  }
  let located = run ordinalOfIdentity(&mut resolver.*, module, &identity)
  let operationOrdinal = match move located {
    Option<usize>.Some {value} => value
    Option<usize>.None => {
      return Result<(), Shared<Rejection>>.succeed(())
    }
  }
  if Shared<Type>.with<bool>(provider, unionType) {
    return run appendUnionOperationSuppliers(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, nested,
      provider, providerKey, member, listed, operationAtIndex, visibleInterface, operationOrdinal, module, siteModule, siteSpan,
      &mut candidates.*, &mut selection.*)
  }
  let declarationAccess228Request = Key {
      family: Family.ConformanceHeads,
      module: visibleInterface.module,
      name: providerKey,
      declaration: visibleInterface.ordinal,
      member: usize.ZERO,
      external: false,
    }
  let declarationAccess228 = run internDeclaration(&mut resolver.*, declarationAccess228Request)
  let bucket = run proofDemand(
    &mut resolver.*,
    &mut owner.*,
    &mut request.*,
    &mut dependencies.*,
    declarationAccess228,
    siteSpan,
    nested,
  )
  let failure = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(
    &bucket,
    answerCause,
  )
  if let Option<Shared<Rejection>>.Some {value} = move failure {
    return Result<(), Shared<Rejection>>.failResult(move value)
  }
  let count = Shared<Result<Answer, NoRejection>>.with<usize>(&bucket, bucketCount)
  let mut headAt = usize.ZERO
  while headAt < count {
    let added = run appendConcreteHeadSupplier(
      &mut resolver.*,
      &mut owner.*,
      &mut request.*,
      &mut dependencies.*,
      nested,
      provider,
      providerKey,
      &bucket,
      headAt,
      visibleInterface,
      operationOrdinal,
      siteModule,
      siteSpan,
      &mut candidates.*,
      &mut selection.*,
    )
    if let Result<(), Shared<Rejection>>.Failure {error} = move added {
      return Result<(), Shared<Rejection>>.failResult(move error)
    }
    headAt = headAt + usize.ONE
  }
  return Result<(), Shared<Rejection>>.succeed(())
}

// A union receiver takes an operation through each contract its first member supplies, when the
// union itself conforms to that contract (UNION-003): every member does and the operation
// dispatches on the tag.
effect fn appendUnionOperationSuppliers(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut List<Dependency>,
  nested: bool,
  provider: &Shared<Type>,
  providerKey: usize,
  member: &[u8],
  listed: &Shared<Result<Answer, NoRejection>>,
  operationAtIndex: usize,
  visibleInterface: &VisibleInterface,
  operationOrdinal: usize,
  module: &ModuleId,
  siteModule: &ModuleId,
  siteSpan: Span,
  candidates: &mut List<MethodSupplier>,
  selection: &mut CallSelection,
) -> Result<(), Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let members = run unionMembers(provider)
  if List<Shared<Type>>.length(&members) == usize.ZERO {
    return Result<(), Shared<Rejection>>.succeed(())
  }
  let first = Shared<Type>.clone(&List<Shared<Type>>.asSlice(&members)[usize.ZERO])
  let firstKey = run internApplication(&mut resolver.*, &first)
  let mut found = List<MethodSupplier>.make()
  let mut foundSelection = CallSelection.make()
  let added = run appendConcreteOperationSuppliers(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
    nested, &first, firstKey, member, listed, operationAtIndex, visibleInterface, module, siteModule, siteSpan, &mut found,
    &mut foundSelection)
  if let Result<(), Shared<Rejection>>.Failure {error} = move added {
    return Result<(), Shared<Rejection>>.failResult(move error)
  }
  let suppliers = List<MethodSupplier>.asSlice(&found)
  let avoid = Option<Shared<DeclarationId>>.none()
  let mut refused = Option<Shared<Rejection>>.none()
  let mut proven = false
  let mut at = usize.ZERO
  while at < suppliers.length {
    let goal = ConformanceGoal {contract: Shared<Type>.clone(&suppliers[at].contract), provider: Shared<Type>.clone(provider)}
    let mut chain = List<ConformanceGoal>.make()
    let mut steps = List<ConformanceStep>.make()
    let empty = List<Constraint>.make()
    let failed = run proveGoal(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, nested, &avoid, &goal,
      List<Constraint>.asSlice(&empty), siteModule, siteSpan, &mut chain, &mut steps)
    match move failed {
      Option<Shared<Rejection>>.Some {value} => {
        if let Option<Shared<Rejection>>.None = &refused { refused = Option<Shared<Rejection>>.some(move value) }
      }
      Option<Shared<Rejection>>.None => {
        proven = true
        let appended = run appendContractSupplier(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, nested,
          provider, providerKey, Shared<Type>.clone(&suppliers[at].contract), visibleInterface, operationOrdinal, siteSpan,
          &mut candidates.*, &mut selection.*)
        if let Result<(), Shared<Rejection>>.Failure {error} = move appended {
          return Result<(), Shared<Rejection>>.failResult(move error)
        }
      }
    }
    at = at + usize.ONE
  }
  // The first member names the operation but the union does not conform: say why rather than
  // reporting a missing method.
  if !proven {
    if let Option<Shared<Rejection>>.Some {value} = move refused {
      return Result<(), Shared<Rejection>>.failResult(move value)
    }
  }
  return Result<(), Shared<Rejection>>.succeed(())
}

// Every operation of one visible interface that carries the requested name is a candidate.
effect fn appendVisibleInterfaceSuppliers(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut List<Dependency>,
  nested: bool,
  provider: &Shared<Type>,
  providerKey: usize,
  member: &[u8],
  visibleInterface: &VisibleInterface,
  siteModule: &ModuleId,
  siteSpan: Span,
  candidates: &mut List<MethodSupplier>,
  selection: &mut CallSelection,
) -> Result<(), Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let module = resolvedModule(&resolver.*, visibleInterface.module)
  let declarationAccess229Request = Key {
      family: Family.Operations,
      module: visibleInterface.module,
      name: usize.ZERO,
      declaration: visibleInterface.ordinal,
      member: usize.ZERO,
      external: false,
    }
  let declarationAccess229 = run internDeclaration(&mut resolver.*, declarationAccess229Request)
  let listed = run proofDemand(
    &mut resolver.*,
    &mut owner.*,
    &mut request.*,
    &mut dependencies.*,
    declarationAccess229,
    siteSpan,
    nested,
  )
  let failure = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(
    &listed,
    answerCause,
  )
  if let Option<Shared<Rejection>>.Some {value} = move failure {
    return Result<(), Shared<Rejection>>.failResult(move value)
  }
  let operationCountValue = Shared<Result<Answer, NoRejection>>.with<usize>(
    &listed,
    operationCount,
  )
  let mut operationAtIndex = usize.ZERO
  while operationAtIndex < operationCountValue {
    let added = run appendConcreteOperationSuppliers(
      &mut resolver.*,
      &mut owner.*,
      &mut request.*,
      &mut dependencies.*,
      nested,
      provider,
      providerKey,
      member,
      &listed,
      operationAtIndex,
      visibleInterface,
      &module,
      siteModule,
      siteSpan,
      &mut candidates.*,
      &mut selection.*,
    )
    if let Result<(), Shared<Rejection>>.Failure {error} = move added {
      return Result<(), Shared<Rejection>>.failResult(move error)
    }
    operationAtIndex = operationAtIndex + usize.ONE
  }
  return Result<(), Shared<Rejection>>.succeed(())
}

// Concrete receiver syntax sees only interfaces nameable at this call site. Heads come from each
// interface/provider owner bucket; the receiver type alone must determine an applicable head.
effect fn selectConcreteReceiverCall(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut List<Dependency>,
  nested: bool,
  provider: &Shared<Type>,
  member: &[u8],
  declared: &[Constraint],
  siteModule: &ModuleId,
  siteSpan: Span,
) -> Result<Option<SelectedReceiverOperation>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let scannedInterfaces = run visibleInterfaces(
    &mut resolver.*,
    &mut owner.*,
    &mut request.*,
    &mut dependencies.*,
    siteModule,
    siteSpan,
  )
  let visible = match move scannedInterfaces {
    Result<List<VisibleInterface>, Shared<Rejection>>.Success {value} => move value
    Result<List<VisibleInterface>, Shared<Rejection>>.Failure {error} => {
      return Result<Option<SelectedReceiverOperation>, Shared<Rejection>>.failResult(move error)
    }
  }
  let interfaces = List<VisibleInterface>.asSlice(&visible)
  let mut candidates = List<MethodSupplier>.make()
  let mut selection = CallSelection.make()
  let providerKey = run internApplication(&mut resolver.*, provider)
  let mut at = usize.ZERO
  while at < interfaces.length {
    let added = run appendVisibleInterfaceSuppliers(
      &mut resolver.*,
      &mut owner.*,
      &mut request.*,
      &mut dependencies.*,
      nested,
      provider,
      providerKey,
      member,
      &interfaces[at],
      siteModule,
      siteSpan,
      &mut candidates,
      &mut selection,
    )
    if let Result<(), Shared<Rejection>>.Failure {error} = move added {
      return Result<Option<SelectedReceiverOperation>, Shared<Rejection>>.failResult(move error)
    }
    at = at + usize.ONE
  }
  if CallSelection.ambiguous(&selection) {
    return Result<Option<SelectedReceiverOperation>, Shared<Rejection>>.failResult(
      run ambiguousOperationRejection(siteModule, RejectionCode.AmbiguousConformanceMethod, siteSpan, member, b"receiver", provider,
        List<MethodSupplier>.asSlice(&candidates)),
    )
  }
  let selected = CallSelection.unique(&selection)
  return run selectedReceiverOperation(
    &mut resolver.*,
    &mut owner.*,
    &mut request.*,
    &mut dependencies.*,
    nested,
    provider,
    declared,
    siteModule,
    siteSpan,
    List<MethodSupplier>.asSlice(&candidates),
    move selected,
  )
}

fn witnessFor(answer: &Result<Answer, NoRejection>, operation: &DeclarationId) -> Option<WitnessImplementation> {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Witnesses {witnesses}} = &value.outcome {
      let listed = List<Witness>.asSlice(&witnesses)
      let mut at = usize.ZERO
      while at < listed.length {
        if Shared<DeclarationId>.with<bool>(
          &listed[at].operation,
          fn(found: &DeclarationId) -> bool {
            return DeclarationId.equals(found, operation)
          },
        ) {
          return Option<WitnessImplementation>.some(copyWitnessImplementation(&listed[at].implementation))
        }
        at = at + usize.ONE
      }
    }
  }
  return Option<WitnessImplementation>.none()
}

// Operand inference opens only the operation's own lifetime slots. In particular a recursive
// use keeps the caller's same-declaration parameters rigid, and original ordinals are not dense
// positions in a signature's grouped lifetime list. The private owner never enters a query key.
effect fn inferOperatorOperands(
  resolver: &mut Resolver,
  signature: &Shared<Result<Answer, NoRejection>>,
  operation: &DeclarationId,
  operands: &[Shared<Type>],
) -> Option<List<Binding>> ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let count = Shared<Result<Answer, NoRejection>>.with<usize>(&signature.*, signatureParameterCount)
  if count != operands.length { return Option<List<Binding>>.none() }
  let mut scope = run Bytes.copy(b"\0operator-use")
  run RuntimeEncoding.word(&mut scope, usize.toU64(resolver.nextInferenceId))
  resolver.nextInferenceId = resolver.nextInferenceId + usize.ONE
  let fresh = run DeclarationId.inference(operation, Bytes.asSlice(&scope))
  let mut opening = List<Binding>.make()
  let lifetimeCount = Shared<Result<Answer, NoRejection>>.with<usize>(signature, signatureLifetimeCount)
  let mut at = usize.ZERO
  while at < lifetimeCount {
    let region = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Lifetime>>>(signature,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Lifetime>> { return signatureLifetimeAt(answer, at) })
    if let Option<Shared<Lifetime>>.Some {value} = move region {
      let ordinal = Shared<Lifetime>.with<usize>(&value, fn(lifetime: &Lifetime) -> usize {
        return match &lifetime.* {
          Lifetime.Parameter {declaration, ordinal} => {
            if DeclarationId.equals(&declaration, operation) { return ordinal }
            return usize.MAX
          }
          _ => usize.MAX
        }
      })
      if ordinal != usize.MAX {
        run List<Binding>.append(&mut opening, Binding {
          declaration: run Shared<DeclarationId>.make(DeclarationId.copy(operation)), ordinal: ordinal,
          value: Argument.Lifetime {value: run Shared<Lifetime>.make(Lifetime.Parameter {
            declaration: DeclarationId.copy(&fresh), ordinal: ordinal})}})
      }
    }
    at = at + usize.ONE
  }
  let mut parameters = List<Shared<Type>>.make()
  at = usize.ZERO
  while at < count {
    let parameter = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(
      &signature.*,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> {
        return signatureParameter(answer, at)
      },
    )
    let parameterType = match move parameter {
      Option<Shared<Type>>.Some {value} => move value
      Option<Shared<Type>>.None => { return Option<List<Binding>>.none() }
    }
    run List<Shared<Type>>.append(&mut parameters,
      run Type.applyBindings(&parameterType, List<Binding>.asSlice(&opening), true))
    at = at + usize.ONE
  }
  let mut variables = List<Shared<DeclarationId>>.make()
  run List<Shared<DeclarationId>>.append(&mut variables, run Shared<DeclarationId>.make(DeclarationId.copy(&fresh)))
  let mut learned = List<Binding>.make()
  let compared = run Type.unifyAll(List<Shared<Type>>.asSlice(&parameters), operands,
    List<Shared<DeclarationId>>.asSlice(&variables), Comparison.Exact, &mut learned)
  let unified = match &compared { Unification.Unified => true _ => false }
  if unified {
    let inferred = List<Binding>.asSlice(&learned)
    let mut canonical = List<Binding>.make()
    at = usize.ZERO
    while at < inferred.length {
      let own = Shared<DeclarationId>.with<bool>(&inferred[at].declaration,
        fn(identity: &DeclarationId) -> bool { return DeclarationId.equals(identity, &fresh) })
      let lifetime = match &inferred[at].value { Argument.Lifetime {..} => true _ => false }
      let permitted = Shared<Result<Answer, NoRejection>>.with<bool>(signature,
        fn(answer: &Result<Answer, NoRejection>) -> bool { return signatureLifetimeBinder(answer, inferred[at].ordinal) })
      if !own || !lifetime || !permitted { return Option<List<Binding>>.none() }
      if run argumentMentionsOwner(&inferred[at].value, &fresh) { return Option<List<Binding>>.none() }
      run List<Binding>.append(&mut canonical, Binding {
        declaration: run Shared<DeclarationId>.make(DeclarationId.copy(operation)), ordinal: inferred[at].ordinal,
        value: Argument.copy(&inferred[at].value)})
      at = at + usize.ONE
    }
    // Publication uses the original signature and a single substitution pass. Prove those
    // canonical equations too; a private comparison's success alone is not its call recipe.
    at = usize.ZERO
    while at < operands.length {
      let original = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(signature,
        fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> { return signatureParameter(answer, at) })
      if let Option<Shared<Type>>.Some {value} = move original {
        let applied = run Type.applyBindings(&value, List<Binding>.asSlice(&canonical), true)
        if !run Type.equalsShared(&applied, &operands[at]) { return Option<List<Binding>>.none() }
      } else { return Option<List<Binding>>.none() }
      at = at + usize.ONE
    }
    return Option<List<Binding>>.some(move canonical)
  }
  return Option<List<Binding>>.none()
}

// Eligibility reads only written operands. Result, witness, obligations and expected expression
// type cannot narrow two suppliers accepting identical operands. Each probe owns its bindings.
effect fn matchesOperatorOperands(resolver: &mut Resolver, signature: &Shared<Result<Answer, NoRejection>>,
  operation: &Shared<DeclarationId>, operands: &[Shared<Type>]) -> bool
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let identity = DeclarationId.copyShared(operation)
  return match move run inferOperatorOperands(&mut resolver.*, signature, &identity, operands) {
    Option<List<Binding>>.Some {..} => true
    Option<List<Binding>>.None => false
  }
}

// An open implementation head is outside this concrete candidate path. Only retain an
// Unsupported boundary if its operand pattern can actually accept the written operands.
effect fn openOperatorCouldMatch(
  signature: &Shared<Result<Answer, NoRejection>>,
  operands: &[Shared<Type>],
  head: &Shared<ImplementationHead>,
) -> bool ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let count = Shared<Result<Answer, NoRejection>>.with<usize>(&signature.*, signatureParameterCount)
  if count != operands.length {
    return false
  }
  let mut parameters = List<Shared<Type>>.make()
  let mut at = usize.ZERO
  while at < count {
    let parameter = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(
      &signature.*,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> {
        return signatureParameter(answer, at)
      },
    )
    if let Option<Shared<Type>>.Some {value} = move parameter {
      run List<Shared<Type>>.append(&mut parameters, move value)
    } else {
      return false
    }
    at = at + usize.ONE
  }
  let identity = Shared<ImplementationHead>.with<Shared<DeclarationId>>(
    head,
    fn(value: &ImplementationHead) -> Shared<DeclarationId> {
      return Shared<DeclarationId>.clone(&value.declaration)
    },
  )
  let mut variables = List<Shared<DeclarationId>>.make()
  run List<Shared<DeclarationId>>.append(&mut variables, move identity)
  let mut bindings = List<Binding>.make()
  let compared = run Type.unifyAll(
    List<Shared<Type>>.asSlice(&parameters),
    operands,
    List<Shared<DeclarationId>>.asSlice(&variables),
    Comparison.Exact,
    &mut bindings,
  )
  return match move compared {
    Unification.Distinct => false
    _ => true
  }
}

// Without a provider-owned operand, a provider-only implementation module cannot be found from
// an unqualified expression. Keep that unsettled shape explicit when its operand pattern fits.
effect fn unanchoredOperatorCouldMatch(
  signature: &Shared<Result<Answer, NoRejection>>,
  operands: &[Shared<Type>],
  contract: &Shared<DeclarationId>,
  operation: &Shared<DeclarationId>,
  selfOrdinal: usize,
) -> bool ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let count = Shared<Result<Answer, NoRejection>>.with<usize>(&signature.*, signatureParameterCount)
  if count != operands.length {
    return false
  }
  let mut parameters = List<Shared<Type>>.make()
  let mut at = usize.ZERO
  while at < count {
    let parameter = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(
      &signature.*,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> {
        return signatureParameter(answer, at)
      },
    )
    let parameterType = match move parameter {
      Option<Shared<Type>>.Some {value} => move value
      Option<Shared<Type>>.None => {
        return false
      }
    }
    let owns = Shared<DeclarationId>.with<bool>(
      contract,
      fn(identity: &DeclarationId) -> bool {
        return Type.occurrences(&parameterType, identity, selfOrdinal) > usize.ZERO
      },
    )
    if owns {
      return false
    }
    run List<Shared<Type>>.append(&mut parameters, move parameterType)
    at = at + usize.ONE
  }
  let mut variables = List<Shared<DeclarationId>>.make()
  run List<Shared<DeclarationId>>.append(&mut variables, Shared<DeclarationId>.clone(contract))
  run List<Shared<DeclarationId>>.append(&mut variables, Shared<DeclarationId>.clone(operation))
  let mut bindings = List<Binding>.make()
  let compared = run Type.unifyAll(
    List<Shared<Type>>.asSlice(&parameters),
    operands,
    List<Shared<DeclarationId>>.asSlice(&variables),
    Comparison.Exact,
    &mut bindings,
  )
  return match move compared {
    Unification.Distinct => false
    _ => true
  }
}

// The supplier is already fixed before this call. Prove its exact application, then demand the
// same substituted operation signature for qualified, receiver, and operator syntax. A concrete
// proof names the checked witness body; a declared proof leaves that choice to specialization.
effect fn selectOperationCall(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut List<Dependency>,
  nested: bool,
  contract: &Shared<Type>,
  provider: &Shared<Type>,
  operation: &DeclarationId,
  declared: &[Constraint],
  siteModule: &ModuleId,
  siteSpan: Span,
) -> Result<OperationCall, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let contractModule = declaringModuleOrdinal(&resolver.*, contract)
  if contractModule == usize.MAX {
    fail InvalidModulePath {}
  }
  let module = resolvedModule(&resolver.*, contractModule)
  let identity = run Shared<DeclarationId>.make(DeclarationId.copy(operation))
  let ordinal = run ordinalOfIdentity(&mut resolver.*, &module, &identity)
  let position = match move ordinal {
    Option<usize>.Some {value} => value
    Option<usize>.None => {
      return Result<OperationCall, Shared<Rejection>>.failResult(
        run reject(&resolver.*, siteModule, RejectionCode.UnknownOperation, siteSpan),
      )
    }
  }
  let contractOrdinal = run ordinalOfProvider(&mut resolver.*, &module, contract)
  let contractPosition = match move contractOrdinal {
    Option<usize>.Some {value} => value
    Option<usize>.None => {
      return Result<OperationCall, Shared<Rejection>>.failResult(
        run reject(&resolver.*, siteModule, RejectionCode.UnknownOperation, siteSpan),
      )
    }
  }
  let declarationAccess230Request = Key {
      family: Family.Operations,
      module: contractModule,
      name: usize.ZERO,
      declaration: contractPosition,
      member: usize.ZERO,
      external: false,
    }
  let declarationAccess230 = run internDeclaration(&mut resolver.*, declarationAccess230Request)
  let operations = run proofDemand(
    &mut resolver.*,
    &mut owner.*,
    &mut request.*,
    &mut dependencies.*,
    declarationAccess230,
    siteSpan,
    nested,
  )
  let invalidOperations = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(
    &operations,
    answerCause,
  )
  if let Option<Shared<Rejection>>.Some {value} = move invalidOperations {
    return Result<OperationCall, Shared<Rejection>>.failResult(move value)
  }
  if Shared<Result<Answer, NoRejection>>.with<usize>(
    &operations,
    fn(answer: &Result<Answer, NoRejection>) -> usize {
      return operationIndex(answer, operation)
    },
  ) == usize.MAX {
    return Result<OperationCall, Shared<Rejection>>.failResult(
      run reject(&resolver.*, siteModule, RejectionCode.UnknownOperation, siteSpan),
    )
  }
  let goal = ConformanceGoal {
    contract: Shared<Type>.clone(contract),
    provider: Shared<Type>.clone(provider),
  }
  let mut chain = List<ConformanceGoal>.make()
  let mut steps = List<ConformanceStep>.make()
  let avoid = Option<Shared<DeclarationId>>.none()
  let failed = run proveGoal(
    &mut resolver.*,
    &mut owner.*,
    &mut request.*,
    &mut dependencies.*,
    nested,
    &avoid,
    &goal,
    declared,
    siteModule,
    siteSpan,
    &mut chain,
    &mut steps,
  )
  if let Option<Shared<Rejection>>.Some {value} = move failed {
    return Result<OperationCall, Shared<Rejection>>.failResult(move value)
  }
  let contractKey = run internApplication(&mut resolver.*, contract)
  let providerKey = run internApplication(&mut resolver.*, provider)
  let declarationAccess231Request = Key {
      family: Family.AppliedOperation,
      module: contractModule,
      name: contractKey,
      declaration: position,
      member: providerKey,
      external: false,
    }
  let declarationAccess231 = run internDeclaration(&mut resolver.*, declarationAccess231Request)
  let signature = run proofDemand(
    &mut resolver.*,
    &mut owner.*,
    &mut request.*,
    &mut dependencies.*,
    declarationAccess231,
    siteSpan,
    nested,
  )
  let invalid = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(
    &signature,
    answerCause,
  )
  if let Option<Shared<Rejection>>.Some {value} = move invalid {
    return Result<OperationCall, Shared<Rejection>>.failResult(move value)
  }
  let mut implementation = Option<Shared<DeclarationId>>.none()
  let complete = List<ConformanceStep>.asSlice(&steps)
  if complete.length > usize.ZERO {
    if let ConformanceEvidence.Concrete {head, ..} = &complete[complete.length - usize.ONE].evidence {
      let witnessOwner = Shared<ImplementationHead>.with<Shared<DeclarationId>>(
        &head,
        fn(value: &ImplementationHead) -> Shared<DeclarationId> {
          return Shared<DeclarationId>.clone(&value.declaration)
        },
      )
      let witnessModule = Shared<DeclarationId>.with<usize>(
        &witnessOwner,
        fn(value: &DeclarationId) -> usize {
          return knownModuleOrdinal(&resolver.*, DeclarationId.moduleId(value))
        },
      )
      if witnessModule == usize.MAX {
        fail InvalidModulePath {}
      }
      let witnessSource = resolvedModule(&resolver.*, witnessModule)
      let found = run ordinalOfIdentity(&mut resolver.*, &witnessSource, &witnessOwner)
      let witnessOrdinal = match move found {
        Option<usize>.Some {value} => value
        Option<usize>.None => {
          return Result<OperationCall, Shared<Rejection>>.failResult(
            run reject(&resolver.*, siteModule, RejectionCode.UnknownOperation, siteSpan),
          )
        }
      }
      let declarationAccess232Request = Key {
          family: Family.Witnesses,
          module: witnessModule,
          name: usize.ZERO,
          declaration: witnessOrdinal,
          member: usize.ZERO,
          external: false,
        }
      let declarationAccess232 = run internDeclaration(&mut resolver.*, declarationAccess232Request)
      let witnesses = run proofDemand(
        &mut resolver.*,
        &mut owner.*,
        &mut request.*,
        &mut dependencies.*,
        declarationAccess232,
        siteSpan,
        nested,
      )
      let mapped = Shared<Result<Answer, NoRejection>>.with<Option<WitnessImplementation>>(
        &witnesses,
        fn(answer: &Result<Answer, NoRejection>) -> Option<WitnessImplementation> {
          return witnessFor(answer, operation)
        },
      )
      if let Option<WitnessImplementation>.Some {value} = move mapped {
        // A scalar intrinsic witness runs in place and has no body to require.
        if let WitnessImplementation.Declaration {declaration} = move value {
          implementation = Option<Shared<DeclarationId>>.some(move declaration)
        }
      } else {
        return Result<OperationCall, Shared<Rejection>>.failResult(
          run reject(&resolver.*, siteModule, RejectionCode.IncompatibleWitness, siteSpan),
        )
      }
    }
  }
  return Result<OperationCall, Shared<Rejection>>.succeed(
    OperationCall {
      operation: DeclarationId.copy(operation),
      implementation: move implementation,
      signature: move signature,
      proof: ConformanceProof {steps: move steps},
      receiver: Option<ReceiverPosition>.none(),
    },
  )
}

effect fn appendVisibleOperatorInterface(
  resolver: &mut Resolver,
  location: SelectedDeclaration,
  visible: &mut List<Shared<DeclarationId>>,
) -> () ! Cycle | OutOfMemoryError ? &mut Allocator {
  let target = resolvedModule(&resolver.*, location.module)
  let written = run scopedHeader(&mut resolver.*, &target, location.ordinal)
  if let Option<HeaderSyntax>.Some {value} = move written {
    if let Node.InterfaceHeader {..} = value.header {
      let sourceAnswer = run observedDeclaration(&mut resolver.*, &target, location.ordinal, SourceFacet.Alive)
      let found = run SourceIndex.sharedIdentity(&mut resolver.source, &sourceAnswer, &target, location.ordinal)
      if let Option<Shared<DeclarationId>>.Some {value: identity} = move found {
        let prior = List<Shared<DeclarationId>>.asSlice(&visible.*)
        let mut before = usize.ZERO
        while before < prior.length {
          if sameDeclarationShared(&prior[before], &identity) {
            return ()
          }
          before = before + usize.ONE
        }
        run List<Shared<DeclarationId>>.append(&mut visible.*, move identity)
      }
    }
  }
  return ()
}

// Whether conditional `conditional` of module `moduleOrdinal` is the condition whose evaluation
// context the running demand belongs to (see `ScopedKey.condition`).
fn evaluatingCondition(resolver: &Resolver, moduleOrdinal: usize, conditional: usize) -> bool {
  let active = List<Word>.asSlice(&resolver.active)
  if active.length == usize.ZERO {
    return false
  }
  let runningWord = u64.toUsize(active[active.length - usize.ONE].value)
  let running = List<ScopedKey>.get(&resolver.keys, runningWord)
  let mut contextWord = running.condition
  if running.key.family == Family.Condition {
    contextWord = runningWord
  }
  if contextWord == usize.MAX {
    return false
  }
  let context = List<ScopedKey>.get(&resolver.keys, contextWord).key
  let declarationAccess233 = declarationPosition(&resolver.*, context)
  return context.module == moduleOrdinal && declarationAccess233 == conditional
}

// Whether an enclosing module-level arm of `ordinal` belongs to the condition being evaluated.
fn armChainEvaluated(resolver: &Resolver, moduleOrdinal: usize, declarations: &[IndexedDeclaration], ordinal: usize) -> bool {
  let mut current = ordinal
  while true {
    if let Option<Arm>.Some {value: arm} = &declarations[current].arm {
      if evaluatingCondition(resolver, moduleOrdinal, arm.conditional) { return true }
      current = arm.conditional
    } else {
      return false
    }
  }
  return false
}

// Whether every candidate of `name` sits in an arm of the condition being evaluated.
effect fn guardedByEvaluatedCondition(resolver: &mut Resolver, module: &ModuleId, name: &[u8]) -> bool
! Cycle | OutOfMemoryError
? &mut Allocator {
  let moduleOrdinal = knownModuleOrdinal(&resolver.*, module)
  if moduleOrdinal == usize.MAX {
    return false
  }
  let answer = run observedName(&mut resolver.*, module, name, true)
  if let Option<&IndexedSource>.Some {value} = move sourceOf(&resolver.*, &answer, module) {
    let index = IndexedSource.moduleIndex(value)
    let candidates = ModuleIndex.listCandidates(index)
    let declarations = ModuleIndex.listDeclarations(index)
    let mut found = false
    let mut at = ModuleIndex.firstCandidateNamed(index, name)
    while at != usize.MAX {
      found = true
      if !armChainEvaluated(&resolver.*, moduleOrdinal, declarations, candidates[at].declaration) {
        return false
      }
      at = ModuleIndex.nextCandidateNamed(index, at)
    }
    return found
  }
  return false
}

// MODULE-STATIC-002: interface scans for operator and method syntax name no declaration, and an
// unrelated declaration is never checked to determine a condition. Inside a condition's evaluation
// context a name whose candidates all sit in that condition's arms is invisible; elsewhere a name
// is visible when a selected arm admits it. `None` means not visible.
effect fn scannedSelection(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  module: &ModuleId,
  name: &[u8],
  external: bool,
) -> Result<Option<Selection>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  if run guardedByEvaluatedCondition(&mut resolver.*, module, name) {
    return Result<Option<Selection>, Shared<Rejection>>.succeed(Option<Selection>.none())
  }
  let outcome = run select(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, name, external)
  return match move outcome {
    Result<Selection, Shared<Rejection>>.Success {value} => {
      if value.count == usize.ZERO {
        return Result<Option<Selection>, Shared<Rejection>>.succeed(Option<Selection>.none())
      }
      return Result<Option<Selection>, Shared<Rejection>>.succeed(Option<Selection>.some(value))
    }
    Result<Selection, Shared<Rejection>>.Failure {error} => Result<Option<Selection>, Shared<Rejection>>.failResult(move error)
  }
}

// OP-009 and INTR-008: discover the public interface declarations in the compiler-owned source.
// The shared source supplies their names and identities; library aliases add no operator bindings.
effect fn collectOperatorInterfaces(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  module: &ModuleId,
  span: Span,
) -> Result<List<Shared<DeclarationId>>, Shared<Rejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
  let mut visible = List<Shared<DeclarationId>>.make()
  let sealedModule = canonicalModule(
    &resolver.*,
    run PackageGraph.target(&resolver.packages, module, SealedOperators.path())
  )
  let ordinal = run internModule(&mut resolver.*, &sealedModule)
  let mut names = List<VisibleName>.make()

  // Observe absence too: revising a closure to name a sealed member invalidates discovery.
  run appendInterfaceNames(&mut resolver.*, &sealedModule, ordinal, true, &mut names)
  let candidates = List<VisibleName>.asSlice(&names)
  let mut at = usize.ZERO
  while at < candidates.length {
    let selected = run selectDeclaration(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies.*,
      ordinal,
      &sealedModule,
      Bytes.asSlice(&candidates[at].name),
      true,
      span,
      RejectionCode.UnknownType, RejectionCode.NotType, false)
    let location = match move selected {
      Result<SelectedDeclaration, Shared<Rejection>>.Success { value } => move value
      Result<SelectedDeclaration, Shared<Rejection>>.Failure { error } => {
        return Result<List<Shared<DeclarationId>>, Shared<Rejection>>.failResult(move error)
      }
    }
    run appendVisibleOperatorInterface(&mut resolver.*, move location, &mut visible)
    at = at + usize.ONE
  }
  return Result<List<Shared<DeclarationId>>, Shared<Rejection>>.succeed(move visible)
}

/// The selected discovery root of a test build and its package-relative module directory.
struct Discovery {
  root: ModuleId,
  directory: Bytes,
  // The package's exported modules, discovered beside the root even when it imports none of them.
  exports: List<ModuleId>,
}

/// One discovered test (TEST-004): its declaration, the metadata `Intrinsic.testInfo` reports, and
/// the exact callable type `Intrinsic.testFunction` produces.
pub struct TestEntry {
  pub declaration: Shared<DeclarationId>,
  /// The stable identity: `project:<module>` followed by the declaration's owner steps.
  pub identity: Bytes,
  pub name: Bytes,
  /// The module's logical path inside its module directory, without `.silk`.
  pub module: Bytes,
  /// The package-relative logical path of the module's file.
  pub path: Bytes,
  /// `silk-test-v1:` and the SHA-256 of the authored header and body (TEST-005).
  pub fingerprint: Bytes,
  pub callable: Shared<Type>,
}

/// The tests of one discovery root ordered by module, name and identity, and the catalog identity
/// that every descriptor of this catalog carries.
pub struct TestCatalog {
  pub identity: Bytes,
  /// The SHA-256 the identity spells, compared when a revision revalidates the catalog.
  pub digest: [u8; 32],
  pub entries: List<TestEntry>,
}

fn catalogDigest(catalog: &TestCatalog) -> [u8; 32] { return catalog.digest }

fn sameTestCatalog(left: &Shared<TestCatalog>, right: &Shared<TestCatalog>) -> bool {
  return sameDigest(Shared<TestCatalog>.with<[u8; 32]>(left, catalogDigest), Shared<TestCatalog>.with<[u8; 32]>(right, catalogDigest))
}

fn testCatalogOf(answer: &Result<Answer, NoRejection>) -> Option<Shared<TestCatalog>> {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Tests {catalog}} = &value.outcome {
      return Option<Shared<TestCatalog>>.some(Shared<TestCatalog>.clone(&catalog))
    }
  }
  return Option<Shared<TestCatalog>>.none()
}

// The catalog answer, or the rejection that stopped discovery.
effect fn answeredTests(resolver: &Resolver, answer: &Shared<Result<Answer, NoRejection>>, module: &ModuleId, span: Span)
-> Result<Shared<TestCatalog>, Shared<Rejection>> ! OutOfMemoryError ? &mut Allocator {
  let refused = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(answer, answerCause)
  if let Option<Shared<Rejection>>.Some {value} = move refused {
    return Result<Shared<TestCatalog>, Shared<Rejection>>.failResult(move value)
  }
  return match move Shared<Result<Answer, NoRejection>>.with<Option<Shared<TestCatalog>>>(answer, testCatalogOf) {
    Option<Shared<TestCatalog>>.Some {value} => Result<Shared<TestCatalog>, Shared<Rejection>>.succeed(move value)
    Option<Shared<TestCatalog>>.None => Result<Shared<TestCatalog>, Shared<Rejection>>.failResult(
      run reject(resolver, module, RejectionCode.Unsupported, span))
  }
}

effect fn appendDecimal(output: &mut Bytes, value: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  if value >= 10 { run appendDecimal(&mut output.*, value / 10) }
  let digit = [usize.toU8(value % 10) + 48]
  return run Bytes.append(&mut output.*, &digit)
}

// Standard-library modules are toolchain-owned: they never contribute tests, and discovery does
// not descend into them (TEST-003).
fn toolchainModule(module: &ModuleId) -> bool {
  return ModuleId.withPath<bool>(module, fn(path: &[u8]) -> bool {
    let prefix = b"silk/"
    if path.length < prefix.length { return false }
    let mut at = usize.ZERO
    while at < prefix.length {
      if path[at] != prefix[at] { return false }
      at = at + usize.ONE
    }
    return true
  })
}

// A logical path without its `.silk` extension.
effect fn moduleName(module: &ModuleId) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut name = run ModuleId.copyPath(module)
  let path = Bytes.asSlice(&name)
  let mut length = path.length
  if length >= 5 && path[length - 5] == 46 && path[length - 4] == 115 && path[length - 3] == 105 &&
    path[length - 2] == 108 && path[length - 1] == 107 { length = length - 5 }
  Bytes.truncate(&mut name, length)
  return move name
}

fn ownerKindName(kind: OwnerKind) -> &'static [u8] {
  return match kind {
    OwnerKind.Function => b"function"
    OwnerKind.Conditional => b"conditional"
    OwnerKind.Implementation => b"implementation"
    OwnerKind.Interface => b"interface"
    OwnerKind.Service => b"service"
    _ => b"declaration"
  }
}

// `project:<module>` followed by `/<kind>=<name>#<occurrence>` for each owner step, parent first.
effect fn testIdentity(module: &[u8], declaration: &DeclarationId) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut identity = run Bytes.copy(b"project:")
  run Bytes.append(&mut identity, module)
  let mut step = usize.ZERO
  while step < DeclarationId.ownerCount(declaration) {
    run Bytes.append(&mut identity, b"/")
    run Bytes.append(&mut identity, ownerKindName(DeclarationId.ownerKind(declaration, step)))
    if DeclarationId.ownerNamed(declaration, step) {
      run Bytes.append(&mut identity, b"=")
      let ownerName = run DeclarationId.copyOwnerName(declaration, step)
      run Bytes.append(&mut identity, Bytes.asSlice(&ownerName))
    }
    run Bytes.append(&mut identity, b"#")
    run appendDecimal(&mut identity, DeclarationId.ownerOccurrence(declaration, step))
    step = step + usize.ONE
  }
  return move identity
}

effect fn appendFramed(state: &mut Sha256, bytes: &[u8]) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut length = Bytes.make()
  let mut remaining = usize.toU64(bytes.length)
  let mut at = usize.ZERO
  while at < 8 {
    run Bytes.append(&mut length, &[u64.toU8(u64.bitAnd(remaining, 255))])
    remaining = u64.shiftRight(remaining, 8)
    at = at + usize.ONE
  }
  Sha256.update(&mut state.*, Bytes.asSlice(&length))
  Sha256.update(&mut state.*, bytes)
  return ()
}

// `silk-test-v1:` and the SHA-256 of the framed domain, header encoding and body encoding of the
// declaration at `id` (TEST-005).
effect fn testFingerprint(hir: &Module, id: HirId) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut state = Sha256.make()
  run appendFramed(&mut state, b"silk:test-fingerprint:v1")
  let header = run Fingerprint.header(hir, id)
  run appendFramed(&mut state, List<u8>.asSlice(&header))
  let body = run Fingerprint.body(hir, id)
  run appendFramed(&mut state, List<u8>.asSlice(&body))
  let digest = state.finish()
  let mut text = List<u8>.make()
  run Fingerprint.appendHex(&mut text, &digest)
  let mut fingerprint = run Bytes.copy(b"silk-test-v1:")
  run Bytes.append(&mut fingerprint, List<u8>.asSlice(&text))
  return move fingerprint
}

fn testBefore(left: &TestEntry, right: &TestEntry) -> bool {
  if !same(Bytes.asSlice(&left.module), Bytes.asSlice(&right.module)) { return bytesBefore(Bytes.asSlice(&left.module), Bytes.asSlice(&right.module)) }
  if !same(Bytes.asSlice(&left.name), Bytes.asSlice(&right.name)) { return bytesBefore(Bytes.asSlice(&left.name), Bytes.asSlice(&right.name)) }
  return bytesBefore(Bytes.asSlice(&left.identity), Bytes.asSlice(&right.identity))
}

/// The exact value of naming a test function: its application with no captures and a shared
/// invocation contract that takes nothing and returns the call's result, the constructed Effect
/// of a `test effect fn` (TEST-004). `Intrinsic.testFunction` publishes exactly this type.
effect fn testCallableType(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, declaration: &DeclarationId, signature: &Shared<Result<Answer, NoRejection>>,
  isPublic: bool, module: &ModuleId, span: Span) -> Result<Shared<Type>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut request = Request.make()
  let scope = List<Argument>.make()
  let selected = run checkedDirectApplication(&mut resolver.*, &mut owner.*, &mut request, &mut dependencies.*,
    declaration, signature, List<Argument>.make(), &scope, module, span)
  let application = match move selected {
    Result<Application, Shared<Rejection>>.Success {value} => move value
    Result<Application, Shared<Rejection>>.Failure {error} => { return Result<Shared<Type>, Shared<Rejection>>.failResult(move error) }
  }
  let success = match move Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(signature, signatureResult) {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => {
      return Result<Shared<Type>, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Unsupported, span))
    }
  }
  let mut result = Shared<Type>.clone(&success)
  if Shared<Result<Answer, NoRejection>>.with<bool>(signature, signatureIsEffect) {
    let bindings = run Application.bindings(&application)
    let none = List<Constraint>.make()
    let failure = run signatureFailure(signature)
    let requirements = run signatureRequirements(signature)
    let constructed = run effectValueResult(&mut resolver.*, &mut owner.*, &mut dependencies.*, signature,
      List<Binding>.asSlice(&bindings), move success, move failure, move requirements, List<Constraint>.asSlice(&none), span)
    result = match move constructed {
      Result<Shared<Type>, Shared<Rejection>>.Success {value} => move value
      Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result<Shared<Type>, Shared<Rejection>>.failResult(move error) }
    }
  }
  let regions = List<Shared<Lifetime>>.make()
  let contract = run Types.intern(Type.Callable {mode: CallableMode.Shared,
    isUnsafe: Shared<Result<Answer, NoRejection>>.with<bool>(signature, signatureUnsafe),
    environment: run Shared<Intersection>.make(run Intersection.of(List<Shared<Lifetime>>.asSlice(&regions))),
    invocationBinders: usize.ZERO, invocationUse: usize.MAX, invocationBounds: List<Outlives>.make(),
    parameters: List<Shared<Type>>.make(), result: move result})
  return Result<Shared<Type>, Shared<Rejection>>.succeed(run Type.callableValue(isPublic, run Shared<Application>.make(move application),
    move contract, List<Shared<Type>>.make(), List<CallableFieldInput>.make()))
}

// The selected discovery root's catalog, demanded as a dependency of the current query.
effect fn selectedTests(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, module: &ModuleId, span: Span) -> Result<Shared<TestCatalog>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let root = match &resolver.discovery {
    Option<Discovery>.Some {value} => ModuleId.copy(&value.root)
    Option<Discovery>.None => {
      return Result<Shared<TestCatalog>, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.StaticPhaseViolation, span))
    }
  }
  let rootOrdinal = run internModule(&mut resolver.*, &root)
  let declarationAccess234Request = Key {
    family: Family.Tests, module: rootOrdinal, name: usize.ZERO, declaration: usize.ZERO,
    member: usize.ZERO, external: false}
  let declarationAccess234 = run internDeclaration(&mut resolver.*, declarationAccess234Request)
  let answer = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, declarationAccess234, span)
  return run answeredTests(&resolver.*, &answer, module, span)
}

effect fn copyCatalogIdentity(catalog: &Shared<TestCatalog>) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let length = Shared<TestCatalog>.with<usize>(catalog, fn(held: &TestCatalog) -> usize { return Bytes.length(&held.identity) })
  let mut copied = run Bytes.zeroed(length)
  let target = Bytes.asMutSlice(&mut copied)
  let mut at = usize.ZERO
  while at < length {
    target[at] = Shared<TestCatalog>.with<u8>(catalog, fn(held: &TestCatalog) -> u8 { return Bytes.asSlice(&held.identity)[at] })
    at = at + usize.ONE
  }
  return move copied
}

// One catalog entry a descriptor names.
struct SelectedTest {
  catalog: Shared<TestCatalog>,
  ordinal: usize,
  callable: Shared<Type>,
}

// A descriptor is honored only for the current catalog: its identity must be this catalog's and
// its exact callable type the entry's (TEST-004).
effect fn selectedTestEntry(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, descriptor: &Shared<StaticData>, module: &ModuleId, span: Span)
-> Result<SelectedTest, Shared<Rejection>> ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let parts = match move run StaticValue.testDescriptorParts(descriptor) {
    Option<StaticValue.TestDescriptorParts>.Some {value} => move value
    Option<StaticValue.TestDescriptorParts>.None => {
      return Result<SelectedTest, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.StaticPhaseViolation, span))
    }
  }
  let catalog = match move run selectedTests(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, span) {
    Result<Shared<TestCatalog>, Shared<Rejection>>.Success {value} => move value
    Result<Shared<TestCatalog>, Shared<Rejection>>.Failure {error} => { return Result<SelectedTest, Shared<Rejection>>.failResult(move error) }
  }
  let current = Shared<TestCatalog>.with<bool>(&catalog, fn(held: &TestCatalog) -> bool {
    return same(Bytes.asSlice(&held.identity), Bytes.asSlice(&parts.catalog)) && parts.ordinal < List<TestEntry>.length(&held.entries)
  })
  if !current {
    return Result<SelectedTest, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.StaticPhaseViolation, span))
  }
  let callable = Shared<TestCatalog>.with<Shared<Type>>(&catalog, fn(held: &TestCatalog) -> Shared<Type> {
    let entries = List<TestEntry>.asSlice(&held.entries)
    return Shared<Type>.clone(&entries[parts.ordinal].callable)
  })
  if !run Type.equalsShared(&callable, &parts.callable) {
    return Result<SelectedTest, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.StaticPhaseViolation, span))
  }
  return Result<SelectedTest, Shared<Rejection>>.succeed(SelectedTest {catalog: move catalog, ordinal: parts.ordinal, callable: move callable})
}

// A copy of text field `field` of catalog entry `ordinal`, numbered as in `testInfoText`.
effect fn entryText(catalog: &Shared<TestCatalog>, ordinal: usize, field: usize) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let length = Shared<TestCatalog>.with<usize>(catalog, fn(held: &TestCatalog) -> usize {
    let entries = List<TestEntry>.asSlice(&held.entries)
    return Bytes.length(testInfoText(&entries[ordinal], field))
  })
  let mut copied = run Bytes.zeroed(length)
  let target = Bytes.asMutSlice(&mut copied)
  let mut at = usize.ZERO
  while at < length {
    target[at] = Shared<TestCatalog>.with<u8>(catalog, fn(held: &TestCatalog) -> u8 {
      let entries = List<TestEntry>.asSlice(&held.entries)
      let text = Bytes.asSlice(testInfoText(&entries[ordinal], field))
      return text[at]
    })
    at = at + usize.ONE
  }
  return move copied
}

// The five text fields of one entry's `TestInfo`, in field order.
effect fn testInfoTexts(selected: &SelectedTest) -> List<Bytes> ! OutOfMemoryError ? &mut Allocator {
  let mut texts = List<Bytes>.make()
  let mut field = usize.ZERO
  while field < CheckedIntrinsic.testInfoFieldCount() {
    run List<Bytes>.append(&mut texts, run entryText(&selected.catalog, selected.ordinal, field))
    field = field + usize.ONE
  }
  return move texts
}

fn testInfoText(entry: &TestEntry, field: usize) -> &Bytes {
  if field == usize.ZERO { return &entry.identity }
  if field == usize.ONE { return &entry.name }
  if field == 2 { return &entry.module }
  if field == 3 { return &entry.path }
  return &entry.fingerprint
}

// One written `test` declaration found while scanning a project module.
struct WrittenTest {
  ordinal: usize,
  isPublic: bool,
  fingerprint: Bytes,
}

// The project modules reached from the root through active imports, each once, contribute every
// `test` declaration whose arm is selected. Each one's signature is demanded, so an invalid entry
// rejects the catalog at its TEST-001 site even when a runtime filter would skip it.
effect fn resolveTests(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  key: Key,
) -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let root = resolvedModule(&resolver.*, key.module)
  let mut directory = Bytes.make()
  if let Option<Discovery>.Some {value} = &resolver.discovery {
    directory = run Bytes.copy(Bytes.asSlice(&value.directory))
  }
  let span = Span.make(usize.ZERO, usize.ZERO)
  let mut dependencies = List<Dependency>.make()
  let mut pending = List<ModuleId>.make()
  run List<ModuleId>.append(&mut pending, ModuleId.copy(&root))
  if let Option<Discovery>.Some {value} = &resolver.discovery {
    let exported = List<ModuleId>.asSlice(&value.exports)
    let mut exportAt = usize.ZERO
    while exportAt < exported.length {
      let mut known = !ModuleId.samePackage(&exported[exportAt], &root)
      let queued = List<ModuleId>.asSlice(&pending)
      let mut queuedAt = usize.ZERO
      while !known && queuedAt < queued.length {
        known = ModuleId.equals(&queued[queuedAt], &exported[exportAt])
        queuedAt = queuedAt + usize.ONE
      }
      if !known { run List<ModuleId>.append(&mut pending, ModuleId.copy(&exported[exportAt])) }
      exportAt = exportAt + usize.ONE
    }
  }
  let mut entries = List<TestEntry>.make()
  let mut visited = usize.ZERO
  while visited < List<ModuleId>.length(&pending) {
    let waiting = List<ModuleId>.asSlice(&pending)
    let module = ModuleId.copy(&waiting[visited])
    visited = visited + usize.ONE
    let moduleOrdinal = run internModule(&mut resolver.*, &module)
    let mut imports = List<usize>.make()
    let mut tests = List<WrittenTest>.make()
    let sourceAnswer = run source(&mut resolver.*, &module)
    if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(&resolver.*, &sourceAnswer, &module) {
      let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(indexed))
      let hir = IndexedSource.authored(indexed)
      let mut at = usize.ZERO
      while at < declarations.length {
        if DeclarationId.kind(&declarations[at].identity) == OwnerKind.Import {
          run List<usize>.append(&mut imports, at)
        } else if let Node.FunctionHeader {contract, isPublic, ..} = Module.node(hir, declarations[at].header) {
          if let Node.CallableContract {isTest, ..} = Module.node(hir, contract) {
            if isTest {
              run List<WrittenTest>.append(&mut tests, WrittenTest {ordinal: at, isPublic: isPublic,
                fingerprint: run testFingerprint(hir, declarations[at].local)})
            }
          }
        }
        at = at + usize.ONE
      }
    }
    let listed = List<usize>.asSlice(&imports)
    let mut importAt = usize.ZERO
    while importAt < listed.length {
      let active = run available(&mut resolver.*, &mut owner.*, &mut dependencies, &module, listed[importAt], span)
      let selected = match move active {
        Result<bool, Shared<Rejection>>.Success {value} => value
        Result<bool, Shared<Rejection>>.Failure {error} => { return run memberRejected(move error, move dependencies) }
      }
      if selected {
        let declarationAccess235Request = Key {
          family: Family.Import, module: moduleOrdinal, name: usize.ZERO, declaration: listed[importAt],
          member: usize.MAX, external: false}
        let declarationAccess235 = run internDeclaration(&mut resolver.*, declarationAccess235Request)
        let binding = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies, declarationAccess235, span)
        let imported = Shared<Result<Answer, NoRejection>>.with<ImportSelection>(&binding, fn(answer: &Result<Answer, NoRejection>) -> ImportSelection { return selectedImport(&resolver.*, answer) })
        if let Option<Shared<Rejection>>.Some {value} = move imported.rejected { return run memberRejected(move value, move dependencies) }
        if let Option<usize>.Some {value: targetOrdinal} = move imported.module {
          let target = resolvedModule(&resolver.*, targetOrdinal)
          // Discovery stays in the root's package: dependencies contribute no tests (TEST-003).
          let mut known = toolchainModule(&target) || !ModuleId.samePackage(&target, &root)
          let queued = List<ModuleId>.asSlice(&pending)
          let mut queuedAt = usize.ZERO
          while !known && queuedAt < queued.length {
            known = ModuleId.equals(&queued[queuedAt], &target)
            queuedAt = queuedAt + usize.ONE
          }
          if !known { run List<ModuleId>.append(&mut pending, move target) }
        }
      }
      importAt = importAt + usize.ONE
    }
    if !toolchainModule(&module) {
      let moduleText = run moduleName(&module)
      let mut path = run Bytes.copy(Bytes.asSlice(&directory))
      if Bytes.length(&directory) > usize.ZERO { run Bytes.append(&mut path, b"/") }
      run ModuleId.appendPath(&module, &mut path)
      let mut written = move tests
      while List<WrittenTest>.length(&written) > usize.ZERO {
        let test = List<WrittenTest>.remove(&mut written, usize.ZERO)
        let active = run available(&mut resolver.*, &mut owner.*, &mut dependencies, &module, test.ordinal, span)
        let selected = match move active {
          Result<bool, Shared<Rejection>>.Success {value} => value
          Result<bool, Shared<Rejection>>.Failure {error} => { return run memberRejected(move error, move dependencies) }
        }
        if selected {
          let declarationAccess236Request = Key {
            family: Family.Signature, module: moduleOrdinal, name: usize.ZERO, declaration: test.ordinal,
            member: usize.ZERO, external: false}
          let declarationAccess236 = run internDeclaration(&mut resolver.*, declarationAccess236Request)
          let signature = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies, declarationAccess236, span)
          let refused = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(&signature, answerCause)
          if let Option<Shared<Rejection>>.Some {value} = move refused { return run memberRejected(move value, move dependencies) }
          let declaration = match move run declarationAt(&mut resolver.*, &module, test.ordinal) {
            Option<DeclarationId>.Some {value} => move value
            Option<DeclarationId>.None => {
              return run memberRejected(run reject(&resolver.*, &module, RejectionCode.Unsupported, span), move dependencies)
            }
          }
          // Associated `test` members are rejected by their signature above; only module-level
          // functions remain candidates.
          let callable = match move run testCallableType(&mut resolver.*, &mut owner.*, &mut dependencies, &declaration,
            &signature, test.isPublic, &module, span) {
            Result<Shared<Type>, Shared<Rejection>>.Success {value} => move value
            Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return run memberRejected(move error, move dependencies) }
          }
          let identity = run testIdentity(Bytes.asSlice(&moduleText), &declaration)
          let name = run DeclarationId.copySpelling(&declaration)
          run List<TestEntry>.append(&mut entries, TestEntry {
            name: move name, declaration: run Shared<DeclarationId>.make(move declaration), identity: move identity,
            module: run Bytes.copy(Bytes.asSlice(&moduleText)), path: run Bytes.copy(Bytes.asSlice(&path)),
            fingerprint: move test.fingerprint, callable: move callable,
          })
        }
      }
    }
  }
  // Insertion order by module, then name, then identity, as the bootstrap catalogs tests.
  let mut ordered = List<TestEntry>.make()
  while List<TestEntry>.length(&entries) > usize.ZERO {
    let candidates = List<TestEntry>.asSlice(&entries)
    let mut first = usize.ZERO
    let mut at = usize.ONE
    while at < candidates.length {
      if testBefore(&candidates[at], &candidates[first]) { first = at }
      at = at + usize.ONE
    }
    run List<TestEntry>.append(&mut ordered, List<TestEntry>.remove(&mut entries, first))
  }
  let mut state = Sha256.make()
  run appendFramed(&mut state, b"silk:test-catalog:v1")
  let rootPath = run ModuleId.copyPath(&root)
  run appendFramed(&mut state, Bytes.asSlice(&rootPath))
  let catalogued = List<TestEntry>.asSlice(&ordered)
  let mut at = usize.ZERO
  while at < catalogued.length {
    run appendFramed(&mut state, Bytes.asSlice(&catalogued[at].identity))
    run appendFramed(&mut state, Bytes.asSlice(&catalogued[at].path))
    run appendFramed(&mut state, Bytes.asSlice(&catalogued[at].fingerprint))
    at = at + usize.ONE
  }
  let digest = state.finish()
  let mut hex = List<u8>.make()
  run Fingerprint.appendHex(&mut hex, &digest)
  let mut identity = run Bytes.copy(b"silk-test-catalog-v1:")
  run Bytes.append(&mut identity, List<u8>.asSlice(&hex))
  return memberSuccess(Value.Tests {catalog: run Shared<TestCatalog>.make(TestCatalog {identity: move identity, digest: digest, entries: move ordered})},
    move dependencies)
}

// Discovery has one source-validated answer per module and query scope. Its import/name
// dependencies belong to that answer, rather than to every operator expression's body ledger.
effect fn resolveOperatorInterfaces(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  key: Key,
) -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let module = resolvedModule(&resolver.*, key.module)
  let mut dependencies = List<Dependency>.make()
  let discovered = run collectOperatorInterfaces(
    &mut resolver.*, &mut owner.*, &mut dependencies, &module,
    Span.make(usize.ZERO, usize.ZERO),
  )
  let interfaces = match move discovered {
    Result<List<Shared<DeclarationId>>, Shared<Rejection>>.Success {value} => move value
    Result<List<Shared<DeclarationId>>, Shared<Rejection>>.Failure {error} => {
      return run memberRejected(move error, move dependencies)
    }
  }
  return memberSuccess(Value.OperatorInterfaces {interfaces: move interfaces}, move dependencies)
}

fn operatorInterfaceCount(answer: &Result<Answer, NoRejection>) -> usize {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.OperatorInterfaces {interfaces}} = &value.outcome {
      return List<Shared<DeclarationId>>.length(&interfaces)
    }
  }
  return usize.ZERO
}

fn operatorInterfaceAt(answer: &Result<Answer, NoRejection>, at: usize) -> Option<Shared<DeclarationId>> {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.OperatorInterfaces {interfaces}} = &value.outcome {
      let listed = List<Shared<DeclarationId>>.asSlice(&interfaces)
      if at < listed.length { return Option<Shared<DeclarationId>>.some(Shared<DeclarationId>.clone(&listed[at])) }
    }
  }
  return Option<Shared<DeclarationId>>.none()
}

// Name-selection failures have no expression location inside the shared discovery query.
// Import and declaration diagnostics already own their source spans and remain unchanged.
fn operatorDiscoverySiteCode(diagnostic: &Rejection) -> Option<RejectionCode> {
  if diagnostic.span.start == usize.ZERO && diagnostic.span.end == usize.ZERO {
    let code = diagnostic.code
    if code == RejectionCode.UnknownName || code == RejectionCode.UnknownType || code == RejectionCode.UnknownFunction || code == RejectionCode.UnknownActor || code == RejectionCode.IdentityUnavailable || code == RejectionCode.UnknownOperation || code == RejectionCode.UnknownImportedMember ||
      code == RejectionCode.PrivateMember || code == RejectionCode.Collision || code == RejectionCode.NotType {
      return Option<RejectionCode>.some(code)
    }
  }
  return Option<RejectionCode>.none()
}

fn concreteOperatorGoal(head: &ImplementationHead, contractIdentity: &DeclarationId) -> Option<
  ConformanceGoal,
> {
  return match & head.kind {
    ImplementationKind.Conformance => {
      if let Option<Shared<Type>>.Some {value: contract} = &head.contract {
        if Shared<Type>.with<bool>(
          &contract,
          fn(value: &Type) -> bool {
            return applicationMatches(value, contractIdentity)
          },
        ) {
          return Option<ConformanceGoal>.some(
            ConformanceGoal {
              contract: Shared<Type>.clone(&contract),
              provider: Shared<Type>.clone(&head.provider),
            },
          )
        }
      }
      return Option<ConformanceGoal>.none()
    }
    _ => Option<ConformanceGoal>.none()
  }
}

effect fn appendOperatorModule(modules: &mut List<usize>, ordinal: usize) -> ()
! OutOfMemoryError
? &mut Allocator {
  if ordinal == usize.MAX {
    return ()
  }
  let listed = List<usize>.asSlice(&modules.*)
  let mut at = usize.ZERO
  while at < listed.length {
    if listed[at] == ordinal {
      return ()
    }
    at = at + usize.ONE
  }
  run List<usize>.append(&mut modules.*, ordinal)
  return ()
}

// One operation of a bound interface supplies the operator when it carries the requested mark
// and its applied signature accepts the operands.
effect fn gatherBoundOperation(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  suppliers: &mut List<OperatorCandidate>,
  choice: &mut CallSelection,
  requested: &Operator.Spelling,
  operands: &[Shared<Type>],
  contract: &Shared<Type>,
  provider: &Shared<Type>,
  contractModule: &ModuleId,
  moduleOrdinal: usize,
  listed: &Shared<Result<Answer, NoRejection>>,
  listedAt: usize,
  siteModule: &ModuleId,
  siteSpan: Span,
) -> Result<(), Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let supplied = Shared<Result<Answer, NoRejection>>.with<Option<Shared<DeclarationId>>>(
    listed,
    fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<DeclarationId>> {
      return listedOperation(answer, listedAt)
    },
  )
  let operation = match move supplied {
    Option<Shared<DeclarationId>>.Some {value} => move value
    Option<Shared<DeclarationId>>.None => {
      return Result<(), Shared<Rejection>>.succeed(())
    }
  }
  let marker = run operationMarks(&mut resolver.*, siteModule, contractModule, &operation, requested)
  let valueOnly = match move marker {
    Option<bool>.Some {value} => value
    Option<bool>.None => {
      return Result<(), Shared<Rejection>>.succeed(())
    }
  }
  let foundOrdinal = run ordinalOfIdentity(&mut resolver.*, contractModule, &operation)
  let operationOrdinal = match move foundOrdinal {
    Option<usize>.Some {value} => value
    Option<usize>.None => {
      return Result<(), Shared<Rejection>>.succeed(())
    }
  }
  let contractKey = run internApplication(&mut resolver.*, contract)
  let providerKey = run internApplication(&mut resolver.*, provider)
  let declarationAccess237Request = Key {
      family: Family.AppliedOperation,
      module: moduleOrdinal,
      name: contractKey,
      declaration: operationOrdinal,
      member: providerKey,
      external: false,
    }
  let declarationAccess237 = run internDeclaration(&mut resolver.*, declarationAccess237Request)
  let signature = run demandChild(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies.*,
    declarationAccess237,
    siteSpan,
  )
  let invalid = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(
    &signature,
    answerCause,
  )
  if let Option<Shared<Rejection>>.Some {value} = move invalid {
    return Result<(), Shared<Rejection>>.failResult(move value)
  }
  if !run matchesOperatorOperands(&mut resolver.*, &signature, &operation, operands) {
    return Result<(), Shared<Rejection>>.succeed(())
  }
  if !valueOnly {
    return Result<(), Shared<Rejection>>.failResult(
      run reject(&resolver.*, siteModule, RejectionCode.Unsupported, siteSpan),
    )
  }
  run addOperatorCandidate(
    &mut suppliers.*,
    &mut choice.*,
    contract,
    provider,
    moduleOrdinal,
    operationOrdinal,
  )
  return Result<(), Shared<Rejection>>.succeed(())
}

// The operations of one written interface bound can supply the requested operator.
effect fn gatherBoundContract(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  suppliers: &mut List<OperatorCandidate>,
  choice: &mut CallSelection,
  requested: &Operator.Spelling,
  operands: &[Shared<Type>],
  provider: &Shared<Type>,
  contract: &Shared<Type>,
  siteModule: &ModuleId,
  siteSpan: Span,
) -> Result<(), Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let moduleOrdinal = declaringModuleOrdinal(&resolver.*, contract)
  if moduleOrdinal == usize.MAX {
    return Result<(), Shared<Rejection>>.succeed(())
  }
  let contractModule = resolvedModule(&resolver.*, moduleOrdinal)
  let found = run ordinalOfProvider(&mut resolver.*, &contractModule, contract)
  let contractOrdinal = match move found {
    Option<usize>.Some {value} => value
    Option<usize>.None => {
      return Result<(), Shared<Rejection>>.succeed(())
    }
  }
  let declarationAccess238Request = Key {
      family: Family.Operations,
      module: moduleOrdinal,
      name: usize.ZERO,
      declaration: contractOrdinal,
      member: usize.ZERO,
      external: false,
    }
  let declarationAccess238 = run internDeclaration(&mut resolver.*, declarationAccess238Request)
  let listed = run demandChild(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies.*,
    declarationAccess238,
    siteSpan,
  )
  let rejected = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(
    &listed,
    answerCause,
  )
  if let Option<Shared<Rejection>>.Some {value} = move rejected {
    return Result<(), Shared<Rejection>>.failResult(move value)
  }
  let count = Shared<Result<Answer, NoRejection>>.with<usize>(&listed, listedOperationCount)
  let mut at = usize.ZERO
  while at < count {
    let gathered = run gatherBoundOperation(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies.*,
      &mut suppliers.*,
      &mut choice.*,
      requested,
      operands,
      contract,
      provider,
      &contractModule,
      moduleOrdinal,
      &listed,
      at,
      siteModule,
      siteSpan,
    )
    if let Result<(), Shared<Rejection>>.Failure {error} = move gathered {
      return Result<(), Shared<Rejection>>.failResult(move error)
    }
    at = at + usize.ONE
  }
  return Result<(), Shared<Rejection>>.succeed(())
}

// A bound whose provider and contract are both closed is proven concretely, not through the bound.
effect fn gatherBoundConstraint(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  suppliers: &mut List<OperatorCandidate>,
  choice: &mut CallSelection,
  requested: &Operator.Spelling,
  operands: &[Shared<Type>],
  constraint: &Constraint,
  siteModule: &ModuleId,
  siteSpan: Span,
) -> Result<(), Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  if let Constraint.Conforms {provider, contract} = &constraint.* {
    if Type.hasOpenParameters(&provider) || Type.hasOpenParameters(&contract) {
      return run gatherBoundContract(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies.*,
        &mut suppliers.*,
        &mut choice.*,
        requested,
        operands,
        &provider,
        &contract,
        siteModule,
        siteSpan,
      )
    }
  }
  return Result<(), Shared<Rejection>>.succeed(())
}

effect fn gatherBoundOperator(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  suppliers: &mut List<OperatorCandidate>,
  choice: &mut CallSelection,
  requested: &Operator.Spelling,
  operands: &[Shared<Type>],
  declared: &[Constraint],
  siteModule: &ModuleId,
  siteSpan: Span,
) -> Result<(), Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let mut boundAt = usize.ZERO
  while boundAt < declared.length {
    let gathered = run gatherBoundConstraint(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies.*,
      &mut suppliers.*,
      &mut choice.*,
      requested,
      operands,
      &declared[boundAt],
      siteModule,
      siteSpan,
    )
    if let Result<(), Shared<Rejection>>.Failure {error} = move gathered {
      return Result<(), Shared<Rejection>>.failResult(move error)
    }
    boundAt = boundAt + usize.ONE
  }
  return Result<(), Shared<Rejection>>.succeed(())
}

// One conformance head of an operand owner supplies the operator when its applied signature
// accepts the operands. A generic head only reports that it might match, by returning true.
effect fn gatherConcreteHead(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  suppliers: &mut List<OperatorCandidate>,
  choice: &mut CallSelection,
  operands: &[Shared<Type>],
  contractIdentity: &DeclarationId,
  moduleOrdinal: usize,
  operationOrdinal: usize,
  operation: &Shared<DeclarationId>,
  valueOnly: bool,
  heads: &Shared<Result<Answer, NoRejection>>,
  headAt: usize,
  siteModule: &ModuleId,
  siteSpan: Span,
) -> Result<bool, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let candidate = Shared<Result<Answer, NoRejection>>.with<Option<Shared<ImplementationHead>>>(
    heads,
    fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<ImplementationHead>> {
      return implementationAt(answer, headAt)
    },
  )
  let head = match move candidate {
    Option<Shared<ImplementationHead>>.Some {value} => move value
    Option<Shared<ImplementationHead>>.None => {
      return Result<bool, Shared<Rejection>>.succeed(false)
    }
  }
  let goal = Shared<ImplementationHead>.with<Option<ConformanceGoal>>(
    &head,
    fn(value: &ImplementationHead) -> Option<ConformanceGoal> {
      return concreteOperatorGoal(value, contractIdentity)
    },
  )
  let mut applied = match move goal {
    Option<ConformanceGoal>.Some {value} => move value
    Option<ConformanceGoal>.None => {
      return Result<bool, Shared<Rejection>>.succeed(false)
    }
  }
  // A generic head, as `impl<T: Add<T, T>> Add<Value<T>, Value<T>> for Value<T>`, takes its
  // application from the operands: they bind its parameters exactly as they would a call's, and
  // the closed goal is gathered like any concrete head. Its bounds are proven with the goal after
  // selection, as every candidate's are.
  if Type.hasOpenParameters(&applied.contract) || Type.hasOpenParameters(&applied.provider) {
    let closed = run operandAppliedGoal(&mut resolver.*, &mut owner.*, &mut dependencies.*, &applied, operands, &head,
      operation, moduleOrdinal, operationOrdinal, siteSpan)
    match move closed {
      Result<Option<ConformanceGoal>, Shared<Rejection>>.Success {value: Option<ConformanceGoal>.Some {value: chosen}} => {
        applied = move chosen
      }
      Result<Option<ConformanceGoal>, Shared<Rejection>>.Success {value: Option<ConformanceGoal>.None} => ()
      Result<Option<ConformanceGoal>, Shared<Rejection>>.Failure {error} => {
        return Result<bool, Shared<Rejection>>.failResult(move error)
      }
    }
  }
  let contractKey = run internApplication(&mut resolver.*, &applied.contract)
  let providerKey = run internApplication(&mut resolver.*, &applied.provider)
  let declarationAccess239Request = Key {
      family: Family.AppliedOperation,
      module: moduleOrdinal,
      name: contractKey,
      declaration: operationOrdinal,
      member: providerKey,
      external: false,
    }
  let declarationAccess239 = run internDeclaration(&mut resolver.*, declarationAccess239Request)
  let signature = run demandChild(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies.*,
    declarationAccess239,
    siteSpan,
  )
  let rejected = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(
    &signature,
    answerCause,
  )
  if let Option<Shared<Rejection>>.Some {value} = move rejected {
    return Result<bool, Shared<Rejection>>.failResult(move value)
  }
  if Type.hasOpenParameters(&applied.contract) || Type.hasOpenParameters(&applied.provider) {
    let couldMatch = run openOperatorCouldMatch(&signature, operands, &head)
    return Result<bool, Shared<Rejection>>.succeed(couldMatch)
  }
  if !run matchesOperatorOperands(&mut resolver.*, &signature, operation, operands) {
    return Result<bool, Shared<Rejection>>.succeed(false)
  }
  if !valueOnly {
    return Result<bool, Shared<Rejection>>.failResult(
      run reject(&resolver.*, siteModule, RejectionCode.Unsupported, siteSpan),
    )
  }
  run addOperatorCandidate(
    &mut suppliers.*,
    &mut choice.*,
    &applied.contract,
    &applied.provider,
    moduleOrdinal,
    operationOrdinal,
  )
  return Result<bool, Shared<Rejection>>.succeed(false)
}

// The closed goal an open operator head takes from the operands, or none when the operands do not
// bind every one of its parameters. The head's applied operation signature, in the head's own
// parameters, is matched against the operands.
effect fn operandAppliedGoal(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  open: &ConformanceGoal,
  operands: &[Shared<Type>],
  head: &Shared<ImplementationHead>,
  operation: &Shared<DeclarationId>,
  moduleOrdinal: usize,
  operationOrdinal: usize,
  siteSpan: Span,
) -> Result<Option<ConformanceGoal>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let contractKey = run internApplication(&mut resolver.*, &open.contract)
  let providerKey = run internApplication(&mut resolver.*, &open.provider)
  let request = Key {family: Family.AppliedOperation, module: moduleOrdinal, name: contractKey,
    declaration: operationOrdinal, member: providerKey, external: false}
  let interned = run internDeclaration(&mut resolver.*, request)
  let signature = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, interned, siteSpan)
  if let Option<Shared<Rejection>>.Some {value} = move Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(
    &signature, answerCause) {
    return Result<Option<ConformanceGoal>, Shared<Rejection>>.failResult(move value)
  }
  let count = Shared<Result<Answer, NoRejection>>.with<usize>(&signature, signatureParameterCount)
  if count != operands.length { return Result<Option<ConformanceGoal>, Shared<Rejection>>.succeed(Option<ConformanceGoal>.none()) }
  let mut parameters = List<Shared<Type>>.make()
  let mut at = usize.ZERO
  while at < count {
    let parameter = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(&signature,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> { return signatureParameter(answer, at) })
    match move parameter {
      Option<Shared<Type>>.Some {value} => { run List<Shared<Type>>.append(&mut parameters, move value) }
      Option<Shared<Type>>.None => { return Result<Option<ConformanceGoal>, Shared<Rejection>>.succeed(Option<ConformanceGoal>.none()) }
    }
    at = at + usize.ONE
  }
  let identity = Shared<ImplementationHead>.with<Shared<DeclarationId>>(head,
    fn(value: &ImplementationHead) -> Shared<DeclarationId> { return Shared<DeclarationId>.clone(&value.declaration) })
  let mut variables = List<Shared<DeclarationId>>.make()
  run List<Shared<DeclarationId>>.append(&mut variables, move identity)
  // The operation's own lifetimes, as the elided one of `equals(left: &Self, right: &Self)`, take
  // the operands' regions, so a comparison operator's borrowed operands match too.
  run List<Shared<DeclarationId>>.append(&mut variables, Shared<DeclarationId>.clone(operation))
  let mut bindings = List<Binding>.make()
  let compared = run Type.unifyAll(List<Shared<Type>>.asSlice(&parameters), operands,
    List<Shared<DeclarationId>>.asSlice(&variables), Comparison.Exact, &mut bindings)
  if let Unification.Unified = move compared {
    let contract = run Type.applyBindings(&open.contract, List<Binding>.asSlice(&bindings), true)
    let provider = run Type.applyBindings(&open.provider, List<Binding>.asSlice(&bindings), true)
    if !Type.hasOpenParameters(&contract) && !Type.hasOpenParameters(&provider) {
      return Result<Option<ConformanceGoal>, Shared<Rejection>>.succeed(
        Option<ConformanceGoal>.some(ConformanceGoal {contract: move contract, provider: move provider}))
    }
  }
  return Result<Option<ConformanceGoal>, Shared<Rejection>>.succeed(Option<ConformanceGoal>.none())
}

// The implementation heads that one operand owner declares for the operation are candidates.
// Returns whether any generic head might match.
effect fn gatherOwnerHeads(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  suppliers: &mut List<OperatorCandidate>,
  choice: &mut CallSelection,
  operands: &[Shared<Type>],
  contractIdentity: &DeclarationId,
  moduleOrdinal: usize,
  operationOrdinal: usize,
  operation: &Shared<DeclarationId>,
  valueOnly: bool,
  ownerModule: usize,
  siteModule: &ModuleId,
  siteSpan: Span,
) -> Result<bool, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let declarationAccess240Request = Key {
      family: Family.Implementations,
      module: ownerModule,
      name: usize.ZERO,
      declaration: usize.ZERO,
      member: usize.ZERO,
      external: false,
    }
  let declarationAccess240 = run internDeclaration(&mut resolver.*, declarationAccess240Request)
  let heads = run demandChild(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies.*,
    declarationAccess240,
    siteSpan,
  )
  let failed = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(
    &heads,
    answerCause,
  )
  if let Option<Shared<Rejection>>.Some {value} = move failed {
    return Result<bool, Shared<Rejection>>.failResult(move value)
  }
  let headCount = Shared<Result<Answer, NoRejection>>.with<usize>(&heads, implementationCount)
  let mut openHead = false
  let mut headAt = usize.ZERO
  while headAt < headCount {
    let gathered = run gatherConcreteHead(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies.*,
      &mut suppliers.*,
      &mut choice.*,
      operands,
      contractIdentity,
      moduleOrdinal,
      operationOrdinal,
      operation,
      valueOnly,
      &heads,
      headAt,
      siteModule,
      siteSpan,
    )
    let open = match move gathered {
      Result<bool, Shared<Rejection>>.Success {value} => value
      Result<bool, Shared<Rejection>>.Failure {error} => {
        return Result<bool, Shared<Rejection>>.failResult(move error)
      }
    }
    if open {
      openHead = true
    }
    headAt = headAt + usize.ONE
  }
  return Result<bool, Shared<Rejection>>.succeed(openHead)
}

// One marked operation of the operator interface is gathered through every operand owner.
// Returns whether any generic head might match.
effect fn gatherConcreteOperation(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  suppliers: &mut List<OperatorCandidate>,
  choice: &mut CallSelection,
  requested: &Operator.Spelling,
  operands: &[Shared<Type>],
  contractIdentity: &DeclarationId,
  sharedIdentity: &Shared<DeclarationId>,
  contractModule: &ModuleId,
  moduleOrdinal: usize,
  selfOrdinal: usize,
  modules: &[usize],
  listed: &Shared<Result<Answer, NoRejection>>,
  listedAt: usize,
  siteModule: &ModuleId,
  siteSpan: Span,
) -> Result<bool, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let found = Shared<Result<Answer, NoRejection>>.with<Option<Shared<DeclarationId>>>(
    listed,
    fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<DeclarationId>> {
      return listedOperation(answer, listedAt)
    },
  )
  let operation = match move found {
    Option<Shared<DeclarationId>>.Some {value} => move value
    Option<Shared<DeclarationId>>.None => {
      return Result<bool, Shared<Rejection>>.succeed(false)
    }
  }
  let marker = run operationMarks(&mut resolver.*, siteModule, contractModule, &operation, requested)
  let valueOnly = match move marker {
    Option<bool>.Some {value} => value
    Option<bool>.None => {
      return Result<bool, Shared<Rejection>>.succeed(false)
    }
  }
  let operationPosition = run ordinalOfIdentity(&mut resolver.*, contractModule, &operation)
  let operationOrdinal = match move operationPosition {
    Option<usize>.Some {value} => value
    Option<usize>.None => {
      return Result<bool, Shared<Rejection>>.succeed(false)
    }
  }
  if selfOrdinal != usize.MAX {
    let declarationAccess241Request = Key {
        family: Family.Signature,
        module: moduleOrdinal,
        name: usize.ZERO,
        declaration: operationOrdinal,
        member: usize.ZERO,
        external: false,
      }
    let declarationAccess241 = run internDeclaration(&mut resolver.*, declarationAccess241Request)
    let rawSignature = run demandChild(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies.*,
      declarationAccess241,
      siteSpan,
    )
    let rawFailure = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(
      &rawSignature,
      answerCause,
    )
    if let Option<Shared<Rejection>>.Some {value} = move rawFailure {
      return Result<bool, Shared<Rejection>>.failResult(move value)
    }
    if run unanchoredOperatorCouldMatch(
      &rawSignature,
      operands,
      sharedIdentity,
      &operation,
      selfOrdinal,
    ) {
      return Result<bool, Shared<Rejection>>.failResult(
        run reject(&resolver.*, siteModule, RejectionCode.Unsupported, siteSpan),
      )
    }
  }
  let mut openOperation = false
  let mut ownerAt = usize.ZERO
  while ownerAt < modules.length {
    let gathered = run gatherOwnerHeads(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies.*,
      &mut suppliers.*,
      &mut choice.*,
      operands,
      contractIdentity,
      moduleOrdinal,
      operationOrdinal,
      &operation,
      valueOnly,
      modules[ownerAt],
      siteModule,
      siteSpan,
    )
    let open = match move gathered {
      Result<bool, Shared<Rejection>>.Success {value} => value
      Result<bool, Shared<Rejection>>.Failure {error} => {
        return Result<bool, Shared<Rejection>>.failResult(move error)
      }
    }
    if open {
      openOperation = true
    }
    ownerAt = ownerAt + usize.ONE
  }
  return Result<bool, Shared<Rejection>>.succeed(openOperation)
}

// Gathers every marked operation of one visible operator interface. Returns whether any generic
// head might match.
effect fn gatherInterfaceOperators(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  suppliers: &mut List<OperatorCandidate>,
  choice: &mut CallSelection,
  requested: &Operator.Spelling,
  operands: &[Shared<Type>],
  sharedIdentity: &Shared<DeclarationId>,
  siteModule: &ModuleId,
  siteSpan: Span,
) -> Result<bool, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let contractIdentity = DeclarationId.copyShared(sharedIdentity)
  let moduleOrdinal = knownModuleOrdinal(&resolver.*, DeclarationId.moduleId(&contractIdentity))
  if moduleOrdinal == usize.MAX {
    fail InvalidModulePath {}
  }
  let contractModule = resolvedModule(&resolver.*, moduleOrdinal)
  let position = run ordinalOfIdentity(&mut resolver.*, &contractModule, sharedIdentity)
  let interfaceOrdinal = match move position {
    Option<usize>.Some {value} => value
    Option<usize>.None => {
      fail InvalidModulePath {}
    }
  }
  let declarationAccess242Request = Key {
      family: Family.Contract,
      module: moduleOrdinal,
      name: usize.ZERO,
      declaration: interfaceOrdinal,
      member: usize.ZERO,
      external: false,
    }
  let declarationAccess242 = run internDeclaration(&mut resolver.*, declarationAccess242Request)
  let contractAnswer = run demandChild(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies.*,
    declarationAccess242,
    siteSpan,
  )
  let contractFailure = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(
    &contractAnswer,
    answerCause,
  )
  if let Option<Shared<Rejection>>.Some {value} = move contractFailure {
    return Result<bool, Shared<Rejection>>.failResult(move value)
  }
  let providerParameter = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(
    &contractAnswer,
    contractProvider,
  )
  let selfOrdinal = match move providerParameter {
    Option<Shared<Type>>.Some {value} => Shared<Type>.with<usize>(
      &value,
      fn(ty: &Type) -> usize {
        return Type.parameterOrdinalOf(ty, &contractIdentity)
      },
    )
    Option<Shared<Type>>.None => usize.MAX
  }
  let declarationAccess243Request = Key {
      family: Family.Operations,
      module: moduleOrdinal,
      name: usize.ZERO,
      declaration: interfaceOrdinal,
      member: usize.ZERO,
      external: false,
    }
  let declarationAccess243 = run internDeclaration(&mut resolver.*, declarationAccess243Request)
  let listed = run demandChild(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies.*,
    declarationAccess243,
    siteSpan,
  )
  let invalid = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(
    &listed,
    answerCause,
  )
  if let Option<Shared<Rejection>>.Some {value} = move invalid {
    return Result<bool, Shared<Rejection>>.failResult(move value)
  }
  let mut modules = List<usize>.make()
  run appendOperatorModule(&mut modules, moduleOrdinal)
  let mut operandAt = usize.ZERO
  while operandAt < operands.length {
    // A comparison operand is written as a reference; its owner is the referent's (OP-009).
    let referent = Shared<Type>.with<Option<Shared<Type>>>(&operands[operandAt], providerTarget)
    let owned = match move referent { Option<Shared<Type>>.Some {value} => move value _ => Shared<Type>.clone(&operands[operandAt]) }
    run appendOperatorModule(&mut modules, declaringModuleOrdinal(&resolver.*, &owned))
    operandAt = operandAt + usize.ONE
  }
  let count = Shared<Result<Answer, NoRejection>>.with<usize>(&listed, listedOperationCount)
  let mut openInterface = false
  let mut listedAt = usize.ZERO
  while listedAt < count {
    let gathered = run gatherConcreteOperation(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies.*,
      &mut suppliers.*,
      &mut choice.*,
      requested,
      operands,
      &contractIdentity,
      sharedIdentity,
      &contractModule,
      moduleOrdinal,
      selfOrdinal,
      List<usize>.asSlice(&modules),
      &listed,
      listedAt,
      siteModule,
      siteSpan,
    )
    let open = match move gathered {
      Result<bool, Shared<Rejection>>.Success {value} => value
      Result<bool, Shared<Rejection>>.Failure {error} => {
        return Result<bool, Shared<Rejection>>.failResult(move error)
      }
    }
    if open {
      openInterface = true
    }
    listedAt = listedAt + usize.ONE
  }
  return Result<bool, Shared<Rejection>>.succeed(openInterface)
}

// Concrete candidates come only from the operator interface's own bucket and the operands'
// owner buckets. Their complete conformance proof still runs after one supplier is selected.
effect fn gatherConcreteOperator(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  suppliers: &mut List<OperatorCandidate>,
  choice: &mut CallSelection,
  requested: &Operator.Spelling,
  operands: &[Shared<Type>],
  siteModule: &ModuleId,
  siteSpan: Span,
) -> Result<(), Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let moduleOrdinal = run internModule(&mut resolver.*, siteModule)
  let declarationAccess244Request = Key {family: Family.OperatorInterfaces, module: moduleOrdinal, name: usize.ZERO,
      declaration: usize.ZERO, member: usize.ZERO, external: false}
  let declarationAccess244 = run internDeclaration(&mut resolver.*, declarationAccess244Request)
  let visible = run demandChild(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies.*,
    declarationAccess244,
    siteSpan,
  )
  let rejected = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(&visible, answerCause)
  if let Option<Shared<Rejection>>.Some {value} = move rejected {
    let siteCode = Shared<Rejection>.with<Option<RejectionCode>>(&value, operatorDiscoverySiteCode)
    if let Option<RejectionCode>.Some {value: code} = move siteCode {
      return Result<(), Shared<Rejection>>.failResult(run reject(&resolver.*, siteModule, code, siteSpan))
    }
    return Result<(), Shared<Rejection>>.failResult(move value)
  }
  let mut openCandidate = false
  let count = Shared<Result<Answer, NoRejection>>.with<usize>(&visible, operatorInterfaceCount)
  let mut interfaceAt = usize.ZERO
  while interfaceAt < count {
    let found = Shared<Result<Answer, NoRejection>>.with<Option<Shared<DeclarationId>>>(&visible,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<DeclarationId>> {
        return operatorInterfaceAt(answer, interfaceAt)
      })
    let shared = match move found {
      Option<Shared<DeclarationId>>.Some {value} => move value
      Option<Shared<DeclarationId>>.None => { fail InvalidModulePath {} }
    }
    let gathered = run gatherInterfaceOperators(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies.*,
      &mut suppliers.*,
      &mut choice.*,
      requested,
      operands,
      &shared,
      siteModule,
      siteSpan,
    )
    let open = match move gathered {
      Result<bool, Shared<Rejection>>.Success {value} => value
      Result<bool, Shared<Rejection>>.Failure {error} => {
        return Result<(), Shared<Rejection>>.failResult(move error)
      }
    }
    if open {
      openCandidate = true
    }
    interfaceAt = interfaceAt + usize.ONE
  }
  if openCandidate {
    // Generic heads need operand-derived application before candidate comparison (unit 5).
    return Result<(), Shared<Rejection>>.failResult(
      run reject(&resolver.*, siteModule, RejectionCode.Unsupported, siteSpan),
    )
  }
  return Result<(), Shared<Rejection>>.succeed(())
}

// All interface suppliers are collected before proof; more than one is ambiguous.
effect fn selectOperator(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut List<Dependency>,
  requested: &Operator.Spelling,
  operands: &[Shared<Type>],
  declared: &[Constraint],
  closed: bool,
  siteModule: &ModuleId,
  siteSpan: Span,
) -> Result<Option<SelectedOperator>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  // Concrete scalar operands always use the built-in operator (OP-009).
  if closed {
    return Result<Option<SelectedOperator>, Shared<Rejection>>.succeed(Option<SelectedOperator>.none())
  }
  let mut suppliers = List<OperatorCandidate>.make()
  let mut choice = CallSelection.make()
  let bound = run gatherBoundOperator(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies.*,
    &mut suppliers,
    &mut choice,
    requested,
    operands,
    declared,
    siteModule,
    siteSpan,
  )
  if let Result<(), Shared<Rejection>>.Failure {error} = move bound {
    return Result<Option<SelectedOperator>, Shared<Rejection>>.failResult(move error)
  }
  let mut concreteOperands = true
  let mut operandAt = usize.ZERO
  while operandAt < operands.length {
    // Caller validity regions do not make a concrete provider generic. Preserve those regions
    // in operand matching; only unresolved runtime type/row shape blocks concrete discovery.
    if Type.hasOpenRuntimeParameters(&operands[operandAt]) {
      concreteOperands = false
      break
    }
    operandAt = operandAt + usize.ONE
  }
  if concreteOperands {
    let concrete = run gatherConcreteOperator(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies.*,
      &mut suppliers,
      &mut choice,
      requested,
      operands,
      siteModule,
      siteSpan,
    )
    if let Result<(), Shared<Rejection>>.Failure {error} = move concrete {
      return Result<Option<SelectedOperator>, Shared<Rejection>>.failResult(move error)
    }
  }
  if CallSelection.ambiguous(&choice) {
    return Result<Option<SelectedOperator>, Shared<Rejection>>.failResult(
      run reject(&resolver.*, siteModule, RejectionCode.AmbiguousOperator, siteSpan),
    )
  }
  let selected = match move CallSelection.unique(&choice) {
    Option<usize>.Some {value} => value
    Option<usize>.None => {
      return Result<Option<SelectedOperator>, Shared<Rejection>>.succeed(
        Option<SelectedOperator>.none(),
      )
    }
  }
  let candidate = List<OperatorCandidate>.remove(&mut suppliers, selected)
  let module = resolvedModule(&resolver.*, candidate.operationModule)
  let operation = run declarationAt(&mut resolver.*, &module, candidate.operationOrdinal)
  let identity = match move operation {
    Option<DeclarationId>.Some {value} => move value
    Option<DeclarationId>.None => {
      return Result<Option<SelectedOperator>, Shared<Rejection>>.failResult(
        run reject(&resolver.*, siteModule, RejectionCode.MissingOperator, siteSpan),
      )
    }
  }
  let chosen = run selectOperationCall(
    &mut resolver.*,
    &mut owner.*,
    &mut request.*,
    &mut dependencies.*,
    true,
    &candidate.contract,
    &candidate.provider,
    &identity,
    declared,
    siteModule,
    siteSpan,
  )
  match move chosen {
    Result<OperationCall, Shared<Rejection>>.Success {value} => {
      return Result<Option<SelectedOperator>, Shared<Rejection>>.succeed(
        Option<SelectedOperator>.some(
          SelectedOperator {
            contract: move candidate.contract,
            provider: move candidate.provider,
            call: move value,
          },
        ),
      )
    }
    Result<OperationCall, Shared<Rejection>>.Failure {error} => {
      return Result<Option<SelectedOperator>, Shared<Rejection>>.failResult(move error)
    }
  }
}

// A type application or checked call is already inside a semantic query. Proof facts must be
// children of that query so an edited conformance invalidates the completed application.
// A borrow region, or an instance's caller region that numbers one; neither outlives `'static`.
fn localLifetime(value: &Lifetime) -> bool { return match &value.* { Lifetime.Local {..} => true Lifetime.Supplied {..} => true _ => false } }
fn staticLifetime(value: &Lifetime) -> bool { return match &value.* { Lifetime.Static => true _ => false } }
// Anonymous `fn` literals are `Anonymous`; anonymous `effect fn` literals share `EffectBlock`.
fn anonymousOwner(declaration: &DeclarationId) -> bool {
  let kind = DeclarationId.kind(declaration)
  return kind == OwnerKind.Anonymous || kind == OwnerKind.EffectBlock
}
fn namedLifetime(value: &Lifetime) -> bool {
  return match &value.* { Lifetime.Local {..} => true Lifetime.Supplied {..} => true Lifetime.Parameter {..} => true _ => false }
}

// A selected implementation head's `'static` premise over a borrow region or a declared binder
// holds only through a written caller premise, so once those fail it is unsatisfied (bootstrap
// SEM0212). Any other unproved head relation stays outside the native proof.
fn unprovedOutlivesCode(longer: &Shared<Lifetime>, shorter: &Shared<Lifetime>) -> RejectionCode {
  if Shared<Lifetime>.with<bool>(shorter, staticLifetime)
    && (Lifetime.anyAtom(longer, localLifetime) || Lifetime.allAtoms(longer, namedLifetime)) {
    return RejectionCode.UnsatisfiedLifetimeBound
  }
  return RejectionCode.Unsupported
}

// The type a provision's provider must make conform to the selected service: the referent of a
// borrowed provider, otherwise the owned provider itself.
fn providerTarget(provider: &Type) -> Option<Shared<Type>> {
  if let Type.Reference {referent, ..} = &provider.* {
    return Option<Shared<Type>>.some(Shared<Type>.clone(&referent))
  }
  return Option<Shared<Type>>.none()
}

// Whether a provider capture can expose exclusive access: an exclusive borrow or an owned value.
fn providerExclusive(provider: &Type) -> bool {
  return match & provider.* {
    Type.Reference {access, ..} => access == Access.Mutable
    _ => true
  }
}

// Whether `target` supplies `capability`, by identity or by one coherent conformance. A missing
// conformance is `false`; any other proof failure, such as ambiguous witnesses, is a rejection.
effect fn providerConforms(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  target: &Shared<Type>,
  capability: &Shared<Type>,
  declared: &[Constraint],
  module: &ModuleId,
  span: Span,
) -> Result<bool, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  if run Type.equalsShared(target, capability) {
    return Result<bool, Shared<Rejection>>.succeed(true)
  }
  // `never` has no values, so it serves every service vacuously: an explicit absent provider such
  // as `Option<never>.none()` selects a key without ever running one of its operations.
  if Shared<Type>.with<bool>(target, neverType) {
    return Result<bool, Shared<Rejection>>.succeed(true)
  }
  let goal = ConformanceGoal {contract: Shared<Type>.clone(capability), provider: Shared<Type>.clone(target)}
  let mut request = Request.make()
  let mut chain = List<ConformanceGoal>.make()
  let mut steps = List<ConformanceStep>.make()
  let avoid = Option<Shared<DeclarationId>>.none()
  let failure = run proveGoal(&mut resolver.*, &mut owner.*, &mut request, &mut dependencies.*, true, &avoid,
    &goal, declared, module, span, &mut chain, &mut steps)
  if let Option<Shared<Rejection>>.Some {value} = move failure {
    let missing = Shared<Rejection>.with<bool>(&value, fn(problem: &Rejection) -> bool {
      return problem.code == RejectionCode.MissingConformance
    })
    if missing {
      return Result<bool, Shared<Rejection>>.succeed(false)
    }
    return Result<bool, Shared<Rejection>>.failResult(move value)
  }
  return Result<bool, Shared<Rejection>>.succeed(true)
}

// Selects the one source-row entry a provision satisfies (SERV-007). An explicit `selector` names
// its key; otherwise every entry whose service the provider conforms to is a candidate, whatever
// its access. A shared borrow satisfies only a shared entry; any candidate it cannot satisfy is
// reported before ambiguity. The complete candidate set decides, so row order never chooses.
effect fn selectProvided(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  provider: &Shared<Type>,
  selector: &Option<Requirement>,
  source: &Shared<Row>,
  declared: &[Constraint],
  module: &ModuleId,
  span: Span,
) -> Result<Requirement, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let mut target = Shared<Type>.clone(provider)
  let borrowed = Shared<Type>.with<Option<Shared<Type>>>(provider, providerTarget)
  if let Option<Shared<Type>>.Some {value: referent} = move borrowed {
    target = move referent
  }
  let exclusive = Shared<Type>.with<bool>(provider, providerExclusive)
  let entries = run Row.entryList(source)
  let listed = List<Requirement>.asSlice(&entries)
  let mut conforming = usize.ZERO
  let mut weak = false
  let mut listedSelector = false
  let mut chosen = Option<Requirement>.none()
  let mut at = usize.ZERO
  while at < listed.length {
    let mut named = true
    if let Option<Requirement>.Some {value: key} = &selector.* {
      named = run Requirement.keyEquals(&listed[at], &key)
    }
    if named {
      listedSelector = true
      let conformed = run providerConforms(&mut resolver.*, &mut owner.*, &mut dependencies.*, &target,
        &listed[at].capability, declared, module, span)
      let conforms = match move conformed {
        Result<bool, Shared<Rejection>>.Success {value} => value
        Result<bool, Shared<Rejection>>.Failure {error} => {
          return Result<Requirement, Shared<Rejection>>.failResult(move error)
        }
      }
      if conforms {
        conforming = conforming + usize.ONE
        if !exclusive && listed[at].access != Access.Shared {
          weak = true
        }
        chosen = Option<Requirement>.some(Requirement.copy(&listed[at]))
      }
    }
    at = at + usize.ONE
  }
  // Like the bootstrap solver, a surviving candidate's access mismatch is reported before ambiguity.
  let mut code = RejectionCode.MissingProvidedKey
  if conforming > usize.ZERO && weak {
    code = RejectionCode.InsufficientProviderAccess
  } else if conforming > usize.ONE {
    code = RejectionCode.AmbiguousProvidedKey
  } else if conforming == usize.ONE {
    if let Option<Requirement>.Some {value} = move chosen {
      return Result<Requirement, Shared<Rejection>>.succeed(move value)
    }
  }
  if code == RejectionCode.MissingProvidedKey {
    return Result<Requirement, Shared<Rejection>>.failResult(
      run unmatchedProviderRejection(module, span, &target, selector, source, listedSelector),
    )
  }
  return Result<Requirement, Shared<Rejection>>.failResult(run reject(&resolver.*, module, code, span))
}

// A provision that satisfies no entry of the Effect's requirement row (SEM0123), naming the
// provider, the service a written selector names and the row when each prints exactly. Template 1:
// the selector names a service the row does not list; 2: the provider does not implement the
// selected service; 3: no selector, and the provider implements none of the row's services.
effect fn unmatchedProviderRejection(module: &ModuleId, span: Span, provider: &Shared<Type>, selector: &Option<Requirement>,
  source: &Shared<Row>, listedSelector: bool) -> Shared<Rejection> ! OutOfMemoryError ? &mut Allocator {
  let mut diagnostic = run makeRejection(RejectionCode.MissingProvidedKey, module, span)
  let providerText = run TypeText.display(provider, module)
  let rowSpelled = run rowText(module, source)
  let mut selected = Option<Bytes>.none()
  if let Option<Requirement>.Some {value: key} = &selector.* {
    selected = run TypeText.display(&key.capability, module)
    if let Option<Bytes>.None = &selected { return run Shared<Rejection>.make(move diagnostic) }
  }
  let hasProvider = match &providerText { Option<Bytes>.Some {..} => true _ => false }
  let hasRow = match &rowSpelled { Option<Bytes>.Some {..} => true _ => false }
  let hasSelection = match &selected { Option<Bytes>.Some {..} => true _ => false }
  // Template 1 needs the row and the selection; 2 the provider and the selection; 3 the provider and the row.
  let mut choice: &'static [u8] = b"3"
  let mut usable = hasProvider && hasRow
  if hasSelection && !listedSelector {
    choice = b"1"
    usable = hasRow
  } else if hasSelection {
    choice = b"2"
    usable = hasProvider
  }
  if !usable { return run Shared<Rejection>.make(move diagnostic) }
  if let Option<Bytes>.Some {value} = move providerText {
    run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"provider"), value: move value})
  }
  if let Option<Bytes>.Some {value} = move rowSpelled {
    run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"row"), value: move value})
  }
  if let Option<Bytes>.Some {value} = move selected {
    run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"service"), value: move value})
  }
  run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"template"), value: run Bytes.copy(choice)})
  return run Shared<Rejection>.make(move diagnostic)
}

// The one service-role key a closed selector row names, or `None` for any other cardinality.
effect fn selectorKey(selector: &Shared<Row>) -> Option<Requirement> ! OutOfMemoryError ? &mut Allocator {
  let mut entries = run Row.entryList(selector)
  if List<Requirement>.length(&entries) != usize.ONE {
    return Option<Requirement>.none()
  }
  return Option<Requirement>.some(List<Requirement>.remove(&mut entries, usize.ZERO))
}

// Proves one applied `provides` bound. A bound still mentioning caller parameters must be one of
// the caller's own declared bounds, which `proveAppliedBounds` accepts before reaching this.
// Whether a declared `provides` bound names this selection and source for a provider borrowed with
// the same access to the same referent, whatever the borrow's region.
effect fn declaredProvidesThroughBorrow(declared: &[Constraint], provider: &Shared<Type>, selector: &Shared<Row>,
  source: &Shared<Row>) -> bool ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let wanted = Shared<Type>.with<Option<BorrowedProvider>>(provider, borrowedProvider)
  let loan = match move wanted { Option<BorrowedProvider>.Some {value} => move value _ => { return false } }
  let mut at = usize.ZERO
  while at < declared.length {
    if let Constraint.Provides {provider: written, selector: writtenSelector, source: writtenSource} = &declared[at] {
      let candidate = Shared<Type>.with<Option<BorrowedProvider>>(&written, borrowedProvider)
      if let Option<BorrowedProvider>.Some {value: premise} = move candidate {
        if premise.access == loan.access {
          let sameReferent = run Type.equalsShared(&premise.referent, &loan.referent)
          if sameReferent {
            let sameSelector = run Row.equalsShared(&writtenSelector, selector)
            if sameSelector {
              if run Row.equalsShared(&writtenSource, source) { return true }
              // The premise already proves the provider conforms to the one selected service with
              // this access; any source row listing that key admits the same selection (SERV-007).
              if run listsSelectedKey(source, selector, loan.access) { return true }
              if run premiseSourceDecides(&writtenSource, source, selector, declared) { return true }
            }
          }
        }
      }
    }
    at = at + usize.ONE
  }
  return false
}

// Whether a premise drawn from part of `source` still decides its selection: `source` contains the
// premise's source row, and declared `?R in Without<R, S>` premises prove that every other part
// holds none of the selected keys, so the selected entry and its access are the premise's own
// (SERV-007). An open selector is decided this way without knowing its key.
effect fn premiseSourceDecides(writtenSource: &Shared<Row>, source: &Shared<Row>, selector: &Shared<Row>,
  declared: &[Constraint]) -> bool ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let noPremises = List<RowPremise>.make()
  if !run Row.knownSubset(writtenSource, source, List<RowPremise>.asSlice(&noPremises)) { return false }
  let terms = Shared<Row>.with<usize>(source, fn(row: &Row) -> usize { return List<RowSubtraction>.length(&row.subtractions) })
  if terms != usize.ZERO { return false }
  let mut rest = Row.empty()
  let entries = run Row.entryList(source)
  let listed = List<Requirement>.asSlice(&entries)
  let mut at = usize.ZERO
  while at < listed.length {
    let mut part = Row.empty()
    run Row.require(&mut part, Requirement.copy(&listed[at]))
    let single = run Shared<Row>.make(move part)
    if !run Row.knownSubset(&single, writtenSource, List<RowPremise>.asSlice(&noPremises)) {
      run Row.require(&mut rest, Requirement.copy(&listed[at]))
    }
    at = at + usize.ONE
  }
  let sourceCount = Shared<Row>.with<usize>(source, fn(row: &Row) -> usize { return List<RowParameter>.length(&row.parameters) })
  let writtenCount = Shared<Row>.with<usize>(writtenSource, fn(row: &Row) -> usize { return List<RowParameter>.length(&row.parameters) })
  at = usize.ZERO
  while at < sourceCount {
    let parameter = Shared<Row>.with<RowParameter>(source, fn(row: &Row) -> RowParameter {
      let values = List<RowParameter>.asSlice(&row.parameters)
      return RowParameter {declaration: Shared<DeclarationId>.clone(&values[at].declaration), ordinal: values[at].ordinal}
    })
    // Both rows may share one declaration handle, so compare against a copy, never a nested access.
    let declared = DeclarationId.copyShared(&parameter.declaration)
    let mut covered = false
    let mut other = usize.ZERO
    while !covered && other < writtenCount {
      covered = Shared<Row>.with<bool>(writtenSource, fn(row: &Row) -> bool {
        let values = List<RowParameter>.asSlice(&row.parameters)
        return values[other].ordinal == parameter.ordinal && declarationEqualsShared(&declared, &values[other].declaration)
      })
      other = other + usize.ONE
    }
    if !covered { run Row.include(&mut rest, move parameter) }
    at = at + usize.ONE
  }
  let remainder = run Shared<Row>.make(move rest)
  let mut disjoint = Row.empty()
  run Row.subtract(&mut disjoint, &remainder, selector)
  let bounded = run Shared<Row>.make(move disjoint)
  let premises = run rowPremises(declared)
  return run Row.knownSubset(&remainder, &bounded, List<RowPremise>.asSlice(&premises))
}

// Whether a source row lists the one service-role key a selector names, at an access a capture
// with `access` satisfies.
effect fn listsSelectedKey(source: &Shared<Row>, selector: &Shared<Row>, access: Access) -> bool
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let key = match move run selectorKey(selector) {
    Option<Requirement>.Some {value} => move value
    Option<Requirement>.None => { return false }
  }
  let entries = run Row.entryList(source)
  let listed = List<Requirement>.asSlice(&entries)
  let mut at = usize.ZERO
  while at < listed.length {
    if run Requirement.keyEquals(&listed[at], &key) {
      return access != Access.Shared || listed[at].access == Access.Shared
    }
    at = at + usize.ONE
  }
  return false
}

struct BorrowedProvider {
  referent: Shared<Type>,
  access: Access,
}

fn borrowedProvider(value: &Type) -> Option<BorrowedProvider> {
  return match &value.* {
    Type.Reference {referent, access, ..} => Option<BorrowedProvider>.some(
      BorrowedProvider {referent: Shared<Type>.clone(&referent), access: access})
    _ => Option<BorrowedProvider>.none()
  }
}

effect fn proveProvides(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  provider: &Shared<Type>,
  selector: &Shared<Row>,
  source: &Shared<Row>,
  declared: &[Constraint],
  module: &ModuleId,
  span: Span,
) -> Option<Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  // A declared bound covers the same selection through any shorter borrow of its provider: a
  // provides fact is keyed by access and provider type, and the loan's region is checked where the
  // provider argument is borrowed.
  if run declaredProvidesThroughBorrow(declared, provider, selector, source) { return Option<Shared<Rejection>>.none() }
  // Without a matching caller bound, an open source row, provider or selector is proved only
  // through the one key a selector lists and present in the source row, by a provider whose
  // implementation head its constructor selects under the caller's premises. Anything else, and
  // any failure to prove it, stays Unsupported here.
  if Row.hasOpenRuntimeParameters(source) || Type.hasOpenRuntimeParameters(provider) || Row.hasOpenRuntimeParameters(selector) {
    let mut target = Shared<Type>.clone(provider)
    let borrowed = Shared<Type>.with<Option<Shared<Type>>>(provider, providerTarget)
    if let Option<Shared<Type>>.Some {value: referent} = move borrowed {
      target = move referent
    }
    let listed = Shared<Row>.with<bool>(selector, fn(row: &Row) -> bool {
      return List<Requirement>.length(&row.entries) == usize.ONE && List<RowParameter>.length(&row.parameters) == usize.ZERO
        && List<RowSubtraction>.length(&row.subtractions) == usize.ZERO
    })
    // An open source row may later strengthen a listed key's access, so only an exclusive or owned
    // capture is decided before it is known.
    let capture = !Row.hasOpenRuntimeParameters(source) || Shared<Type>.with<bool>(provider, providerExclusive)
    // A bare type parameter conforms only through the caller's declared bound, as `W: Writer`, so
    // against a closed source row its failure is final.
    let parameter = Shared<Type>.with<bool>(&target, isTypeParameter)
    if listed && capture && (parameter || providerCanSelectHead(&target)) {
      let openKey = run selectorKey(selector)
      let openSelected = run selectProvided(&mut resolver.*, &mut owner.*, &mut dependencies.*, provider, &openKey, source,
        declared, module, span)
      match move openSelected {
        Result<Requirement, Shared<Rejection>>.Success {value} => {
          drop value
          return Option<Shared<Rejection>>.none()
        }
        Result<Requirement, Shared<Rejection>>.Failure {error} => {
          if parameter && !Row.hasOpenRuntimeParameters(source) { return Option<Shared<Rejection>>.some(move error) }
        }
      }
    }
    return Option<Shared<Rejection>>.some(run reject(&resolver.*, module, RejectionCode.Unsupported, span))
  }
  // A selector names exactly one service-role key (SERV-007).
  let key = run selectorKey(selector)
  if let Option<Requirement>.None = &key {
    return Option<Shared<Rejection>>.some(run reject(&resolver.*, module, RejectionCode.ProviderSelectorCardinality, span))
  }
  let selected = run selectProvided(&mut resolver.*, &mut owner.*, &mut dependencies.*, provider, &key, source,
    declared, module, span)
  if let Result<Requirement, Shared<Rejection>>.Failure {error} = move selected {
    return Option<Shared<Rejection>>.some(move error)
  }
  return Option<Shared<Rejection>>.none()
}

fn selectorOrdinalIn(row: &Row, fresh: &Shared<DeclarationId>) -> usize {
  return Shared<DeclarationId>.with<usize>(
    fresh,
    fn(declaration: &DeclarationId) -> usize {
      return rowParameterOrdinal(row, declaration)
    },
  )
}

// Infers each omitted `provides` selector `?S` of a call (SERV-007): once the provider and source
// row are solved and concrete, `S` binds to the one compatible stored entry, access included.
// A partial source row is never selection evidence; its selector stays uninferred.
effect fn inferProvidedSelectors(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  module: &ModuleId,
  signature: &Shared<Result<Answer, NoRejection>>,
  callOwner: &Shared<DeclarationId>,
  fresh: &DeclarationId,
  declared: &[Constraint],
  inferred: &mut List<Binding>,
  span: Span,
) -> Option<Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let count = Shared<Result<Answer, NoRejection>>.with<usize>(signature, signatureConstraintCount)
  let mut boundAt = usize.ZERO
  while boundAt < count {
    let bound = Shared<Result<Answer, NoRejection>>.with<Option<Constraint>>(
      signature,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Constraint> {
        return signatureConstraint(answer, boundAt)
      },
    )
    boundAt = boundAt + usize.ONE
    if let Option<Constraint>.Some {value: Constraint.Provides {provider, selector, source}} = move bound {
      let ordinal = Shared<Row>.with<usize>(
        &selector,
        fn(row: &Row) -> usize {
          return selectorOrdinalIn(row, callOwner)
        },
      )
      if ordinal == usize.MAX {
        continue
      }
      let supplied = bindingArgumentAt(List<Binding>.asSlice(&inferred.*), ordinal)
      if let Option<Argument>.Some {..} = move supplied {
        continue
      }
      let appliedProvider = run Type.applyBindings(&provider, List<Binding>.asSlice(&inferred.*), true)
      let appliedSource = run Row.applyBindings(&source, List<Binding>.asSlice(&inferred.*), true)
      if run typeMentionsOwner(&appliedProvider, fresh) {
        continue
      }
      if run argumentMentionsOwner(&Argument.Row {value: Shared<Row>.clone(&appliedSource)}, fresh) {
        continue
      }
      if Row.hasOpenRuntimeParameters(&appliedSource) || Type.hasOpenRuntimeParameters(&appliedProvider) {
        continue
      }
      let selected = run selectProvided(&mut resolver.*, &mut owner.*, &mut dependencies.*, &appliedProvider,
        &Option<Requirement>.none(), &appliedSource, declared, module, span)
      let entry = match move selected {
        Result<Requirement, Shared<Rejection>>.Success {value} => move value
        Result<Requirement, Shared<Rejection>>.Failure {error} => {
          return Option<Shared<Rejection>>.some(move error)
        }
      }
      let mut row = Row.empty()
      run Row.require(&mut row, move entry)
      run List<Binding>.append(
        &mut inferred.*,
        Binding {
          declaration: Shared<DeclarationId>.clone(callOwner),
          ordinal: ordinal,
          value: Argument.Row {value: run Shared<Row>.make(move row)},
        },
      )
    }
  }
  return Option<Shared<Rejection>>.none()
}

// A caller's complete contents premise may cover a shorter use region. Only declared caller
// facts enter this proof: the selected operation's applied obligations cannot justify themselves.
effect fn callerContentsCover(declared: &[Constraint], subject: &Shared<Type>, region: &Shared<Lifetime>) -> bool
! OutOfMemoryError ? &mut Allocator | &mut Types {
  return match move run coveringContentsPremise(declared, subject, region) {
    Option<Shared<Lifetime>>.Some {..} => true
    Option<Shared<Lifetime>>.None => false
  }
}

// The region of the first caller contents premise on `subject` that covers `region`.
effect fn coveringContentsPremise(declared: &[Constraint], subject: &Shared<Type>, region: &Shared<Lifetime>)
  -> Option<Shared<Lifetime>> ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut at = usize.ZERO
  while at < declared.length {
    if let Constraint.Contents {subject: premiseSubject, region: premiseRegion} = &declared[at] {
      let sameSubject = run Type.equalsShared(subject, &premiseSubject)
      if sameSubject {
        if run knownOutlives(declared, &premiseRegion, region) {
          return Option<Shared<Lifetime>>.some(Shared<Lifetime>.clone(&premiseRegion))
        }
      }
    }
    at = at + usize.ONE
  }
  return Option<Shared<Lifetime>>.none()
}

// Whether an applied type is `Intrinsic.Detached`: it retains no caller lexical or provider loan
// (EXEC-004). A borrow, a borrowed capture and a provided requirement each surface as a region the
// type retains, including through an Effect or callable environment, so every retained region must
// be `'static`. A type parameter stored inside it is detached only through its own declared premise.
effect fn provesDetached(assumptions: &[Constraint], subject: &Shared<Type>, module: &ModuleId) -> bool
! OutOfMemoryError ? &mut Allocator | &mut Types {
  // A parameter's own Detached premise is proved by every caller, whatever its bound's environment.
  let mut alone = List<Shared<Type>>.make()
  run List<Shared<Type>>.append(&mut alone, Shared<Type>.clone(subject))
  if run detachedParameters(assumptions, List<Shared<Type>>.asSlice(&alone)) { return true }
  let anchor = run DeclarationId.fromParts(ModuleId.copy(module), List<OwnerStep>.make())
  let mut retained = List<Shared<Lifetime>>.make()
  let mut unresolved = List<Shared<Type>>.make()
  if !run captureContents(subject, &anchor, assumptions, &mut retained, &mut unresolved) {
    let mut alone = List<Shared<Type>>.make()
    run List<Shared<Type>>.append(&mut alone, Shared<Type>.clone(subject))
    return run detachedParameters(assumptions, List<Shared<Type>>.asSlice(&alone))
  }
  let regions = List<Shared<Lifetime>>.asSlice(&retained)
  let mut at = usize.ZERO
  while at < regions.length {
    if !Shared<Lifetime>.with<bool>(&regions[at], staticLifetime) { return false }
    at = at + usize.ONE
  }
  return run detachedParameters(assumptions, List<Shared<Type>>.asSlice(&unresolved))
}

// Whether each stored type parameter carries a declared Detached or `'static` contents premise.
effect fn detachedParameters(assumptions: &[Constraint], parameters: &[Shared<Type>]) -> bool
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut at = usize.ZERO
  while at < parameters.length {
    let mut premised = false
    let mut premise = usize.ZERO
    while premise < assumptions.length && !premised {
      if let Constraint.Property {subject, property} = &assumptions[premise] {
        premised = property == IntrinsicProperty.Detached && run Type.equalsShared(&subject, &parameters[at])
      }
      if let Constraint.Contents {subject, region} = &assumptions[premise] {
        premised = Shared<Lifetime>.with<bool>(&region, staticLifetime) && run Type.equalsShared(&subject, &parameters[at])
      }
      premise = premise + usize.ONE
    }
    if !premised { return false }
    at = at + usize.ONE
  }
  return true
}

// `T: Copy` holds of a type the sealed Copy property admits under the caller's premises. A selected
// implementation head's bound and a call's applied bound prove it alike.
effect fn proveCopyable(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  subject: &Shared<Type>,
  declared: &[Constraint],
  module: &ModuleId,
  span: Span,
) -> Option<Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  return match move run copyType(&mut resolver.*, &mut owner.*, &mut dependencies.*, subject, declared, span) {
    Result<bool, Shared<Rejection>>.Success {value} => {
      if value { return Option<Shared<Rejection>>.none() }
      // A `T: Copy` bound on a type that is not Copy, such as `List.get` or `Pointer.read` of a
      // move-only element, is an unproved conformance (SEM0121), never a gap.
      let mut diagnostic = run makeRejection(RejectionCode.MissingConformance, module, span)
      if let Option<Bytes>.Some {value: typeText} = move run TypeText.display(subject, module) {
        let mut goal = run Bytes.copy(b"`")
        run Bytes.append(&mut goal, Bytes.asSlice(&typeText))
        run Bytes.append(&mut goal, b": Copy`")
        run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"goal"), value: move goal})
        run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"detail"),
          value: run Bytes.copy(b"the callee requires a `Copy` type argument here, and this type does not implement `Copy`")})
      }
      return Option<Shared<Rejection>>.some(run Shared<Rejection>.make(move diagnostic))
    }
    Result<bool, Shared<Rejection>>.Failure {error} => Option<Shared<Rejection>>.some(move error)
  }
}

// `T: Transferable` or `T: Concurrent` holds of a type the thread property admits under the
// caller's premises (THREAD-004). An unproved one is a missing conformance (SEM0121).
effect fn proveThreadSafe(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  subject: &Shared<Type>,
  property: SealedProperty,
  declared: &[Constraint],
  module: &ModuleId,
  span: Span,
) -> Option<Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let active = List<Shared<Type>>.make()
  let safe = run threadSafeWithin(&mut resolver.*, &mut owner.*, &mut dependencies.*, subject, property, declared, span,
    List<Shared<Type>>.asSlice(&active))
  return match move safe {
    Result<bool, Shared<Rejection>>.Success {value} => {
      if value { return Option<Shared<Rejection>>.none() }
      let mut name = b"Concurrent"
      if property == SealedProperty.Transferable { name = b"Transferable" }
      let mut diagnostic = run makeRejection(RejectionCode.MissingConformance, module, span)
      if let Option<Bytes>.Some {value: typeText} = move run TypeText.display(subject, module) {
        let mut goal = run Bytes.copy(b"`")
        run Bytes.append(&mut goal, Bytes.asSlice(&typeText))
        run Bytes.append(&mut goal, b": ")
        run Bytes.append(&mut goal, name)
        run Bytes.append(&mut goal, b"`")
        let mut detail = run Bytes.copy(b"the callee requires a `")
        run Bytes.append(&mut detail, name)
        run Bytes.append(&mut detail, b"` type argument here, and this type has a part that cannot cross threads")
        run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"goal"), value: move goal})
        run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"detail"), value: move detail})
      }
      return Option<Shared<Rejection>>.some(run Shared<Rejection>.make(move diagnostic))
    }
    Result<bool, Shared<Rejection>>.Failure {error} => Option<Shared<Rejection>>.some(move error)
  }
}

// The declared premises with each contents premise's retained regions as outlives edges: a
// premise `T: 'r` (such as an input borrow's implied well-formedness) makes every region `T`
// retains outlive `'r`.
effect fn contentsOutlives(declared: &[Constraint], caller: &DeclarationId) -> List<Constraint>
! OutOfMemoryError ? &mut Allocator {
  let mut edges = run copyConstraints(declared)
  let representations = List<Option<Shared<Type>>>.make()
  let mut at = usize.ZERO
  while at < declared.length {
    if let Constraint.Contents {subject, region} = &declared[at] {
      let mut retained = List<Shared<Lifetime>>.make()
      // Contents describe stored values: a callable contributes its environment, not future
      // inputs/results, and a stored reference contributes its own region, not its referent.
      // Unknown stored parameters retain their Contents premise without hiding known regions.
      drop run Type.retainedRegions(&subject, caller, List<Option<Shared<Type>>>.asSlice(&representations), &mut retained, false)
      let regions = List<Shared<Lifetime>>.asSlice(&retained)
      let mut regionAt = usize.ZERO
      while regionAt < regions.length {
        run List<Constraint>.append(&mut edges, Constraint.Outlives {longer: Shared<Lifetime>.clone(&regions[regionAt]),
          shorter: Shared<Lifetime>.clone(&region)})
        regionAt = regionAt + usize.ONE
      }
    }
    at = at + usize.ONE
  }
  return move edges
}

// Who proves the region bounds (`'a: 'b`, `T: 'a`) of an application. At a declaration typing does:
// a signature, a declared type's well-formedness, a conformance head. Inside a body the region check
// does, from the call's contract (`CallContract`) or the construction's shape (`ConstructionShape`),
// so typing neither proves nor refuses them there.
enum RegionProof {
  Typing,
  RegionCheck
}

effect fn proveAppliedBounds(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  declared: &List<Constraint>,
  bounds: &[Constraint],
  module: &ModuleId,
  span: Span,
  proof: RegionProof,
) -> Option<Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let mut request = Request.make()
  let mut chain = List<ConformanceGoal>.make()
  let mut steps = List<ConformanceStep>.make()
  let avoid = Option<Shared<DeclarationId>>.none()
  // Contents premises' outlives edges are derived once per proof, on its first outlives bound.
  let mut implied = List<Constraint>.make()
  let mut derived = false
  let mut at = usize.ZERO
  while at < bounds.length {
    let assumptions = List<Constraint>.asSlice(declared)
    let mut premise = usize.ZERO
    let mut assumed = false
    while premise < assumptions.length && !assumed {
      assumed = run sameConstraint(&bounds[at], &assumptions[premise])
      premise = premise + usize.ONE
    }
    if assumed { at = at + usize.ONE continue }
    // NonParking is a transitive property of the reached program: each instance whose premises
    // bind it owes the proof at its entry, and the build proves it after closing the external
    // parks (`nonParkingViolations`, SEM0139).
    if let Constraint.Property {subject, property} = &bounds[at] {
      if property == IntrinsicProperty.NonParking { at = at + usize.ONE continue }
      if !run provesDetached(assumptions, &subject, module) {
        return Option<Shared<Rejection>>.some(run reject(&resolver.*, module, RejectionCode.UnsatisfiedExecutableProperty, span))
      }
      at = at + usize.ONE
      continue
    }
    if let Constraint.Copyable {subject} = &bounds[at] {
      let failed = run proveCopyable(&mut resolver.*, &mut owner.*, &mut dependencies.*, &subject, assumptions, module, span)
      if let Option<Shared<Rejection>>.Some {value} = move failed { return Option<Shared<Rejection>>.some(move value) }
      at = at + usize.ONE
      continue
    }
    if let Constraint.ThreadSafe {subject, property} = &bounds[at] {
      let failed = run proveThreadSafe(&mut resolver.*, &mut owner.*, &mut dependencies.*, &subject, property, assumptions,
        module, span)
      if let Option<Shared<Rejection>>.Some {value} = move failed { return Option<Shared<Rejection>>.some(move value) }
      at = at + usize.ONE
      continue
    }
    if let Constraint.Outlives {longer, shorter} = &bounds[at] {
      if proof == RegionProof.RegionCheck { at = at + usize.ONE continue }
      if !derived {
        let anchor = run DeclarationId.fromParts(ModuleId.copy(module), List<OwnerStep>.make())
        implied = run contentsOutlives(assumptions, &anchor)
        derived = true
      }
      if !run knownOutlives(List<Constraint>.asSlice(&implied), &longer, &shorter) {
        let mut code = RejectionCode.Unsupported
        if Lifetime.anyAtom(&longer, localLifetime) && Shared<Lifetime>.with<bool>(&shorter, staticLifetime) {
          code = RejectionCode.UnsatisfiedLifetimeBound
        }
        return Option<Shared<Rejection>>.some(run reject(&resolver.*, module, code, span))
      }
      at = at + usize.ONE
      continue
    }
    if let Constraint.Contents {subject, region} = &bounds[at] {
      if proof == RegionProof.RegionCheck { at = at + usize.ONE continue }
      // A caller premise `T: 'r` covers a use region `'r` encloses.
      if let Option<Shared<Lifetime>>.Some {..} = move run coveringContentsPremise(assumptions, &subject, &region) {
        at = at + usize.ONE
        continue
      }
      // A bare type parameter's contents are known only through a declared premise, which
      // `coveringContentsPremise` already consulted. Without one, only a local region is admitted:
      // every type its declaration names outlives it.
      if Shared<Type>.with<bool>(&subject, isTypeParameter) {
        if !Lifetime.allAtoms(&region, localLifetime) {
          return Option<Shared<Rejection>>.some(run reject(&resolver.*, module, RejectionCode.Unsupported, span))
        }
        at = at + usize.ONE
        continue
      }
      // Every named region the subject retains must cover the bound's region. As in the
      // bootstrap's type-outlives proof, a type parameter stored inside the subject with no
      // declared contents premise names no region here.
      let anchor = run DeclarationId.fromParts(ModuleId.copy(module), List<OwnerStep>.make())
      let mut retained = List<Shared<Lifetime>>.make()
      let mut unresolved = List<Shared<Type>>.make()
      if !run captureContents(&subject, &anchor, assumptions, &mut retained, &mut unresolved) {
        return Option<Shared<Rejection>>.some(run reject(&resolver.*, module, RejectionCode.Unsupported, span))
      }
      let regions = List<Shared<Lifetime>>.asSlice(&retained)
      let mut regionAt = usize.ZERO
      while regionAt < regions.length {
        if !run knownOutlives(List<Constraint>.asSlice(declared), &regions[regionAt], &region) {
          return Option<Shared<Rejection>>.some(run reject(&resolver.*, module, RejectionCode.UnsatisfiedLifetimeBound, span))
        }
        regionAt = regionAt + usize.ONE
      }
      at = at + usize.ONE
      continue
    }
    if let Constraint.Represents {parameter, contract} = &bounds[at] {
      let mut strict = Option<RegionDeferral>.none()
      let failed = run proveCallableBound(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, List<Constraint>.asSlice(declared),
        &parameter, &contract, span, &mut strict, proof)
      if let Option<Shared<Rejection>>.Some {value} = move failed { return Option<Shared<Rejection>>.some(move value) }
      at = at + usize.ONE
      continue
    }
    // `S in E` holds when `S` names at least one failure and each is a member of `E` (FAIL-005).
    if let Constraint.FailureSubset {selected, source} = &bounds[at] {
      let members = run failureMembers(&selected)
      if List<Shared<Type>>.length(&members) == usize.ZERO || !run Type.coversFailure(&source, &selected) {
        return Option<Shared<Rejection>>.some(run selectedFailureRejection(module, span, &selected, &source))
      }
      at = at + usize.ONE
      continue
    }
    // `?S in R` holds when `R` promises every entry and row parameter of `S`, directly or through
    // the declared `?S in R` premises; an undecided row is not solved here (bootstrap `isImplied`).
    if let Constraint.RequirementSubset {selected, source} = &bounds[at] {
      let premises = run rowPremises(assumptions)
      if !run Row.knownSubset(&selected, &source, List<RowPremise>.asSlice(&premises)) {
        return Option<Shared<Rejection>>.some(run premiseRejection(module, span, &selected, &source))
      }
      at = at + usize.ONE
      continue
    }
    if let Constraint.Provides {provider, selector, source} = &bounds[at] {
      let failed = run proveProvides(&mut resolver.*, &mut owner.*, &mut dependencies.*, &provider, &selector, &source,
        List<Constraint>.asSlice(declared), module, span)
      if let Option<Shared<Rejection>>.Some {value} = move failed { return Option<Shared<Rejection>>.some(move value) }
      at = at + usize.ONE
      continue
    }
    if let Constraint.Conforms {provider, contract} = &bounds[at] {
      let goal = ConformanceGoal {
        contract: Shared<Type>.clone(&contract),
        provider: Shared<Type>.clone(&provider),
      }
      // A known constructor can prove a conditional head using the caller's rigid arguments and
      // premises. A bare unknown provider still requires a declared goal.
      if !providerCanSelectHead(&provider) && (Type.hasOpenRuntimeParameters(&provider) || Type.hasOpenRuntimeParameters(&contract)) {
        let assumed = run declaredGoal(List<Constraint>.asSlice(declared), &goal)
        if let Option<Constraint>.None = move assumed {
          return Option<Shared<Rejection>>.some(
            run reject(&resolver.*, module, RejectionCode.Unsupported, span),
          )
        }
      }
      let failure = run proveGoal(
        &mut resolver.*,
        &mut owner.*,
        &mut request,
        &mut dependencies.*,
        true,
        &avoid,
        &goal,
        List<Constraint>.asSlice(declared),
        module,
        span,
        &mut chain,
        &mut steps,
      )
      if let Option<Shared<Rejection>>.Some {value} = move failure {
        return Option<Shared<Rejection>>.some(move value)
      }
    } else {
      return Option<Shared<Rejection>>.some(
        run reject(&resolver.*, module, RejectionCode.Unsupported, span),
      )
    }
    at = at + usize.ONE
  }
  return Option<Shared<Rejection>>.none()
}

/// Constructs a short loan from an active semantic provider's split state.
fn inFlightStaticPort<'source>(
  resolver: &'source mut Resolver,
  query: &'source mut Query<Answer, NoRejection>,
  dependencies: &'source mut List<Dependency>,
) -> StaticPort<'source> {
  return StaticPort {resolver: move resolver, query: move query, dependencies: move dependencies}
}

// The provider of a sealed `impl Drop` head; absent for every other implementation kind.
fn sealedDropProvider(head: &ImplementationHead) -> Option<Shared<Type>> {
  return match &head.kind {
    ImplementationKind.Sealed {property} => {
      if property != SealedProperty.Drop { return Option<Shared<Type>>.none() }
      return Option<Shared<Type>>.some(Shared<Type>.clone(&head.provider))
    }
    _ => Option<Shared<Type>>.none()
  }
}

// Whether `value` is the nominal `declaration` under any type and lifetime arguments.
fn nominalDeclares(value: &Type, declaration: &DeclarationId) -> bool {
  return match &value.* { Type.Nominal {declaration: owner, ..} => DeclarationId.equals(&owner, declaration) _ => false }
}

/// A header-only documentation lookup. Namespace aliases retain their actual module; selected
/// imports retain their canonical declaration rather than the alias's authored identity.
pub union DocumentationBinding {
  Declaration {pub identity: DeclarationId, pub isPublic: bool},
  Namespace {pub module: ModuleId, pub isPublic: bool},
}

impl<'source> StaticPort<'source> {
  /// Borrows one exact parsed source from this query port.
  pub fn sourceAtCursor(self: &Self, cursor: &AuthoredCursor) -> Option<&IndexedSource> {
    return SourceIndex.sourceAtCursor(&self.resolver.source, cursor)
  }
  /// Borrows authored HIR from one authenticated source for the duration of this port loan.
  pub fn authoredAtCursor(self: &Self, cursor: &AuthoredCursor) -> Option<&Module> {
    let indexed = SourceIndex.sourceAtCursor(&self.resolver.source, cursor)
    if let Option<&IndexedSource>.Some {value} = move indexed {
      return Option<&Module>.some(IndexedSource.authored(value))
    }
    return Option<&Module>.none()
  }
  /// The target of the held semantic revision.
  pub fn target(self: &Self) -> MachineTarget {
    return self.resolver.target
  }
  /// Logical facts are frozen before defaults, then retained by the published profile.
  pub fn profileFacts<'a>(self: &'a Self) -> Option<&'a InitialProfile> {
    if let Option<&FinalProfile>.Some {value} = move selectedProfile(&self.resolver.*) {
      return Option<&InitialProfile>.some(FinalProfile.facts(value))
    }
    return match &self.resolver.assemblyFacts {
      Option<InitialProfile>.Some {value} => Option<&InitialProfile>.some(&value)
      Option<InitialProfile>.None => Option<&InitialProfile>.none()
    }
  }
  /// Records the active profile input as a logical dependency of the reached static query.
  pub effect fn demandProfile(self: &mut Self, module: &ModuleId, span: Span) -> ()
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
    let moduleOrdinal = run internModule(&mut self.resolver.*, module)
    let declarationAccess245Request = Key {
        family: Family.ProfileInput, module: moduleOrdinal, name: usize.ZERO,
        declaration: usize.ZERO, member: usize.ZERO, external: false,
      }
    let declarationAccess245 = run internDeclaration(&mut self.resolver, declarationAccess245Request)
    let observed = run demandChild(
      &mut self.resolver.*, &mut self.query.*, &mut self.dependencies.*,
      declarationAccess245,
      span,
    )
    drop observed
    return ()
  }
  /// Demands one exact authored source on the port's held revision.
  pub effect fn authoredCursor(self: &mut Self, module: &ModuleId) -> Option<AuthoredCursor>
  ! Cycle | OutOfMemoryError
  ? &mut Allocator {
    let answer = run source(&mut self.resolver.*, module)
    return run SourceIndex.authoredCursor(&mut self.resolver.*.source, &answer, module)
  }
  /// `authoredCursor` for reading one declaration: it observes only that declaration's written
  /// header and body, so an edit elsewhere in its module leaves the reader alone.
  pub effect fn declarationCursor(self: &mut Self, declaration: &DeclarationId) -> Option<AuthoredCursor>
  ! Cycle | OutOfMemoryError
  ? &mut Allocator {
    let module = DeclarationId.moduleId(declaration)
    let answer = run observedWholeDeclaration(&mut self.resolver.*, module, declaration)
    return run SourceIndex.authoredCursor(&mut self.resolver.*.source, &answer, module)
  }
  /// The module a standard-library `path`, such as `silk/i32.silk`, names when `module` writes it.
  pub effect fn standardModule(self: &Self, module: &ModuleId, path: &[u8]) -> ModuleId
  ! InvalidModulePath | OutOfMemoryError
  ? &mut Allocator {
    return canonicalModule(&self.resolver.*, run PackageGraph.target(&self.resolver.*.packages, module, path))
  }
  /// Copies a source call's checked identity and arguments without resolving its spelling again.
  pub effect fn copyDirectCall(self: &mut Self, body: &Shared<TypedBody>, syntax: HirId, window: Range) -> Option<StaticCall>
  ! Cycle | InvalidModulePath | OutOfMemoryError ? &mut Allocator {
    let declaration = Shared<TypedBody>.with<DeclarationId>(body, fn(checked: &TypedBody) -> DeclarationId {
      return DeclarationId.copy(TypedBody.declarationId(checked))
    })
    let anchor = match move run declarationAnchor(&mut self.resolver.*, &declaration) {
      Option<Anchor>.Some {value} => move value
      Option<Anchor>.None => { return Option<StaticCall>.none() }
    }
    let mut receiver = false
    let selected = Shared<TypedBody>.with<Option<Shared<Application>>>(body, fn(checked: &TypedBody) -> Option<Shared<Application>> {
      let nodes = TypedBody.nodeSlice(checked)
      let mut at = usize.ZERO
      while at < nodes.length {
        if at >= window.start && at - window.start < window.length && Anchor.hir(&anchor, nodes[at].origin.node).index == syntax.index {
          if let BodyNodeKind.Expression {form: BodyExpression.DirectCall {application, receiverPass, ..}, ..} = &nodes[at].kind {
            if let Option<BodyReceiverPass>.Some {..} = &receiverPass { receiver = true }
            return Option<Shared<Application>>.some(Shared<Application>.clone(&application))
          }
        }
        at = at + usize.ONE
      }
      return Option<Shared<Application>>.none()
    })
    if let Option<Shared<Application>>.Some {value} = move selected {
      return Option<StaticCall>.some(StaticCall {application: run Application.copyShared(&value), receiver: receiver})
    }
    return Option<StaticCall>.none()
  }

  /// The witness application of a checked interface operation call once `bindings`, the
  /// executing frame's, close its contract and provider: what static evaluation runs for a
  /// `static` operation. Absent when `syntax` is no interface call in `window`.
  pub effect fn copyInterfaceCall(self: &mut Self, body: &Shared<TypedBody>, syntax: HirId, window: Range,
    bindings: &[Binding], span: Span) -> Option<Application>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
    let declaration = Shared<TypedBody>.with<DeclarationId>(body, fn(checked: &TypedBody) -> DeclarationId {
      return DeclarationId.copy(TypedBody.declarationId(checked))
    })
    let anchor = match move run declarationAnchor(&mut self.resolver.*, &declaration) {
      Option<Anchor>.Some {value} => move value
      Option<Anchor>.None => { return Option<Application>.none() }
    }
    let found = Shared<TypedBody>.with<Option<BodyNodeId>>(body, fn(checked: &TypedBody) -> Option<BodyNodeId> {
      let nodes = TypedBody.nodeSlice(checked)
      let mut at = usize.ZERO
      while at < nodes.length {
        if at >= window.start && at - window.start < window.length && Anchor.hir(&anchor, nodes[at].origin.node).index == syntax.index {
          if let BodyNodeKind.Expression {form: BodyExpression.InterfaceCall {..}, ..} = &nodes[at].kind {
            return Option<BodyNodeId>.some(BodyNodeId {index: at})
          }
        }
        at = at + usize.ONE
      }
      return Option<BodyNodeId>.none()
    })
    let node = match move found {
      Option<BodyNodeId>.Some {value} => value
      Option<BodyNodeId>.None => { return Option<Application>.none() }
    }
    let inputs = match move TypedBody.interfaceCall(body, node) {
      Option<InterfaceCallInputs>.Some {value} => move value
      Option<InterfaceCallInputs>.None => { return Option<Application>.none() }
    }
    let count = Shared<List<Binding>>.with<usize>(&inputs.bindings, fn(values: &List<Binding>) -> usize { return List<Binding>.length(values) })
    let mut invocation = List<Binding>.make()
    let mut at = usize.ZERO
    while at < count {
      let recorded = Shared<List<Binding>>.with<Binding>(&inputs.bindings, fn(values: &List<Binding>) -> Binding {
        let entries = List<Binding>.asSlice(values)
        return Binding {declaration: Shared<DeclarationId>.clone(&entries[at].declaration),
          ordinal: entries[at].ordinal, value: Argument.copy(&entries[at].value)}
      })
      run List<Binding>.append(&mut invocation, Binding {declaration: move recorded.declaration, ordinal: recorded.ordinal,
        value: run Argument.applyBindings(&recorded.value, bindings, true)})
      at = at + usize.ONE
    }
    // Static operands are values, not loans: a borrowed one lends for the whole evaluation.
    let mut arguments = List<Shared<Type>>.make()
    let mut loans = List<WitnessLoan>.make()
    at = usize.ZERO
    while at < inputs.count {
      let argument = match move TypedBody.callArgument(body, node, at) {
        Option<CallArgument>.Some {value} => move value
        Option<CallArgument>.None => { return Option<Application>.none() }
      }
      run List<Shared<Type>>.append(&mut arguments, run Type.applyBindings(&argument.ty, bindings, true))
      run List<WitnessLoan>.append(&mut loans, WitnessLoan {region: Option<Shared<Lifetime>>.some(run Shared<Lifetime>.make(Lifetime.Static))})
      at = at + usize.ONE
    }
    let recipe = WitnessRecipe {operation: Shared<DeclarationId>.clone(&inputs.operation),
      contract: run Type.applyBindings(&inputs.contract, bindings, true), provider: run Type.applyBindings(&inputs.provider, bindings, true),
      result: Shared<Type>.clone(&inputs.result), bindings: run Shared<List<Binding>>.make(move invocation),
      arguments: run Shared<List<Shared<Type>>>.make(move arguments), loans: run Shared<List<WitnessLoan>>.make(move loans), constructs: false}
    let module = ModuleId.copy(DeclarationId.moduleId(&declaration))
    let mut request = Request.make()
    let resolved = run completedWitnessApplication(&mut self.resolver.*, &mut self.query.*, &mut request,
      &mut self.dependencies.*, &recipe, &module, span)
    return match move resolved {
      Result<ResolvedWitness, Shared<Rejection>>.Success {value} => Option<Application>.some(move value.application)
      Result<ResolvedWitness, Shared<Rejection>>.Failure {..} => Option<Application>.none()
    }
  }

  /// Whether a sealed `impl Drop` head in the nominal's declaring module names it at any
  /// instantiation. An unreadable implementation list
  /// counts as Drop, so static admission refuses rather than guessing cleanup freedom.
  pub effect fn declaresDrop(self: &mut Self, declaration: &DeclarationId, span: Span) -> bool
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
    let moduleOrdinal = run internModule(&mut self.resolver.*, DeclarationId.moduleId(declaration))
    let declarationAccess246Request = Key {
      family: Family.Implementations, module: moduleOrdinal, name: usize.ZERO, declaration: usize.ZERO, member: usize.ZERO,
      external: false,
    }
    let declarationAccess246 = run internDeclaration(&mut self.resolver, declarationAccess246Request)
    let listed = run demandChild(&mut self.resolver.*, &mut self.query.*, &mut self.dependencies.*, declarationAccess246, span)
    let rejected = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(&listed, answerCause)
    if let Option<Shared<Rejection>>.Some {..} = move rejected { return true }
    let count = Shared<Result<Answer, NoRejection>>.with<usize>(&listed, implementationCount)
    let mut at = usize.ZERO
    while at < count {
      let candidate = Shared<Result<Answer, NoRejection>>.with<Option<Shared<ImplementationHead>>>(&listed,
        fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<ImplementationHead>> { return implementationAt(answer, at) })
      if let Option<Shared<ImplementationHead>>.Some {value: head} = move candidate {
        let provider = Shared<ImplementationHead>.with<Option<Shared<Type>>>(&head, sealedDropProvider)
        if let Option<Shared<Type>>.Some {value: owner} = move provider {
          if Shared<Type>.with<bool>(&owner, fn(value: &Type) -> bool { return nominalDeclares(value, declaration) }) { return true }
        }
      }
      at = at + usize.ONE
    }
    return false
  }

  /// A static function's checked body is selected by every evaluator argument (STATIC-001).
  /// Shares the caller's depth budget with static selections reached while checking its body.
  /// The transient counter is restored on every completion, including a typed failed query.
  pub effect fn demandStaticBody<'request>(self: &'request mut Self, application: &Application, arguments: &[Shared<StaticData>], span: Span, depthLimit: usize)
  -> Option<Shared<Result<Answer, NoRejection>>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | StaticDiagnostic ? &mut Allocator | &mut Types {
    let previousDepth = self.resolver.staticDemandDepth
    let previousLimit = self.resolver.staticDemandLimit
    let mut limit = previousLimit
    if depthLimit < limit {limit = depthLimit}
    if previousDepth >= limit {
      fail StaticDiagnostic {fault: StaticFault.DepthLimit, code: b"SEM0180", span: span, target: self.resolver.target,
        message: Option<Bytes>.none(), origin: Option<Span>.none(), byteOffset: Option<u64>.none(),
        rejection: Option<Shared<Rejection>>.none(), needed: Option<StaticNeeded>.none(),
        missing: Option<StaticExecution.MissingFact>.none(), trace: List<StaticExecution.TraceStep>.make()}
    }
    self.resolver.staticDemandDepth = previousDepth + usize.ONE
    self.resolver.staticDemandLimit = limit
    let reservation = StaticDemandReservation<'source, 'request> {
      port: move self, depth: previousDepth, limit: previousLimit,
    }
    let use = effect fn(resource: &mut StaticDemandReservation<'source, 'request>) -> Option<Shared<Result<Answer, NoRejection>>>
    ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
      return run StaticPort.demandStaticBodyUnchecked(&mut resource.port.*, application, arguments, span)
    }
    let release = effect fn(resource: &mut StaticDemandReservation<'source, 'request>) -> () {
      resource.port.resolver.staticDemandDepth = resource.depth
      resource.port.resolver.staticDemandLimit = resource.limit
      return ()
    }
    return run Effect.useReleaseNonParking(move reservation, move use, move release)
  }

  effect fn demandStaticBodyUnchecked(self: &mut Self, application: &Application, arguments: &[Shared<StaticData>], span: Span)
  -> Option<Shared<Result<Answer, NoRejection>>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
    let declaration = Application.bodyDeclaration(application)
    let module = DeclarationId.moduleId(declaration)
    let identity = run Shared<DeclarationId>.make(DeclarationId.copy(declaration))
    let selected = run ordinalOfIdentity(&mut self.resolver.*, module, &identity)
    if let Option<usize>.Some {value: ordinal} = move selected {
      let mut selectedApplication = run Application.copy(application)
      let mut statics = List<StaticSlot>.make()
      // A body whose checking never reads its argument values is checked once for all of them.
      if run staticBodyReadsValues(&mut self.resolver.*, module, ordinal) {
        let mut at = usize.ZERO
        while at < arguments.length {
          run List<StaticSlot>.append(&mut statics, StaticSlot {ordinal: at, value: StaticValue.copy(&arguments[at])})
          at = at + usize.ONE
        }
      }
      selectedApplication.statics = move statics
      let member = run internSelectedApplication(&mut self.resolver.*, &selectedApplication)
      let moduleOrdinal = run internModule(&mut self.resolver.*, module)
      let declarationAccess247Request = Key {
        family: Family.Body, module: moduleOrdinal, name: usize.ZERO, declaration: ordinal,
        member: member + usize.ONE, external: false}
      let declarationAccess247 = run internDeclaration(&mut self.resolver, declarationAccess247Request)
      let answer = run demandChild(&mut self.resolver.*, &mut self.query.*, &mut self.dependencies.*, declarationAccess247, span)
      return Option<Shared<Result<Answer, NoRejection>>>.some(move answer)
    }
    return Option<Shared<Result<Answer, NoRejection>>>.none()
  }

  /// The selected discovery root's catalog as one `Intrinsic.Tests` sequence of descriptors, in
  /// catalog order (TEST-004). Without a discovery root this is a static-phase rejection at `span`.
  pub effect fn tests(self: &mut Self, module: &ModuleId, span: Span) -> Result<StaticData, Shared<Rejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
    let catalog = match move run selectedTests(&mut self.resolver.*, &mut self.query.*, &mut self.dependencies.*, module, span) {
      Result<Shared<TestCatalog>, Shared<Rejection>>.Success {value} => move value
      Result<Shared<TestCatalog>, Shared<Rejection>>.Failure {error} => { return Result<StaticData, Shared<Rejection>>.failResult(move error) }
    }
    let count = Shared<TestCatalog>.with<usize>(&catalog, fn(held: &TestCatalog) -> usize { return List<TestEntry>.length(&held.entries) })
    let mut elements = List<Shared<StaticData>>.make()
    let mut at = usize.ZERO
    while at < count {
      let callable = Shared<TestCatalog>.with<Shared<Type>>(&catalog, fn(held: &TestCatalog) -> Shared<Type> {
        let entries = List<TestEntry>.asSlice(&held.entries)
        return Shared<Type>.clone(&entries[at].callable)
      })
      let identity = run copyCatalogIdentity(&catalog)
      let descriptor = match move run StaticValue.testDescriptor(run CheckedIntrinsic.testType(&callable), move identity, at) {
        Option<StaticData>.Some {value} => move value
        Option<StaticData>.None => { return Result<StaticData, Shared<Rejection>>.failResult(run reject(&self.resolver.*, module, RejectionCode.StaticPhaseViolation, span)) }
      }
      run List<Shared<StaticData>>.append(&mut elements, run Shared<StaticData>.make(move descriptor))
      at = at + usize.ONE
    }
    return match move StaticValue.testCatalog(run CheckedIntrinsic.testsType(), move elements) {
      Option<StaticData>.Some {value} => Result<StaticData, Shared<Rejection>>.succeed(move value)
      Option<StaticData>.None => Result<StaticData, Shared<Rejection>>.failResult(run reject(&self.resolver.*, module, RejectionCode.StaticPhaseViolation, span))
    }
  }
  /// One descriptor's `Intrinsic.TestInfo`, authenticated against the current catalog (TEST-004).
  pub effect fn testInfo(self: &mut Self, descriptor: &Shared<StaticData>, module: &ModuleId, span: Span) -> Result<StaticData, Shared<Rejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
    let selected = run selectedTestEntry(&mut self.resolver.*, &mut self.query.*, &mut self.dependencies.*, descriptor, module, span)
    let entry = match move selected {
      Result<SelectedTest, Shared<Rejection>>.Success {value} => move value
      Result<SelectedTest, Shared<Rejection>>.Failure {error} => { return Result<StaticData, Shared<Rejection>>.failResult(move error) }
    }
    let texts = run testInfoTexts(&entry)
    return match move run StaticValue.testInfo(run CheckedIntrinsic.testInfoType(), move texts) {
      Option<StaticData>.Some {value} => Result<StaticData, Shared<Rejection>>.succeed(move value)
      Option<StaticData>.None => Result<StaticData, Shared<Rejection>>.failResult(run reject(&self.resolver.*, module, RejectionCode.StaticPhaseViolation, span))
    }
  }

  /// Reflects one closed aggregate through tracked members and exact applied member shapes.
  /// The original reflecting declaration travels with each capability through all source helpers.
  /// `authorization` decides which fields are visible; a rejection reports in `site`, the module
  /// whose code `span` points into.
  pub effect fn reflectedFields(self: &mut Self, ty: &Shared<Type>, authorization: &DeclarationId, site: &ModuleId, span: Span)
  -> Result<StaticData, Shared<Rejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
    let described = run Type.copy(ty)
    let mut elements = List<Shared<StaticData>>.make()
    let declaredModule = DeclarationId.moduleId(authorization)
    let authority = run Shared<DeclarationId>.make(DeclarationId.copy(authorization))
    if let Type.Anonymous {occurrence, members} = &described {
      let listed = List<Shared<Type>>.asSlice(&members)
      let positional = AnonymousOccurrence.isPositional(&occurrence)
      let mut ordinal = usize.ZERO
      while ordinal < listed.length {
        let mut kind: u8 = 0
        let mut label = Bytes.make()
        if positional {kind = 1} else {
          label = run reflectedAnonymousLabel(&occurrence, ordinal)
        }
        let descriptor = run CheckedIntrinsic.fieldType(ty, &listed[ordinal])
        let field = match move StaticValue.reflectedField(move descriptor, ordinal, kind, run Shared<Bytes>.make(move label), Shared<DeclarationId>.clone(&authority)) {
          Option<StaticData>.Some {value} => move value
          Option<StaticData>.None => {return Result<StaticData, Shared<Rejection>>.failResult(run reject(&self.resolver.*, site, RejectionCode.StaticPhaseViolation, span))}
        }
        run List<Shared<StaticData>>.append(&mut elements, run Shared<StaticData>.make(move field))
        ordinal = ordinal + usize.ONE
      }
    } else if let Type.Nominal {declaration, ..} = &described {
      let kind = DeclarationId.kind(&declaration)
      if kind != OwnerKind.Struct && kind != OwnerKind.Tuple {
        return Result<StaticData, Shared<Rejection>>.failResult(run reject(&self.resolver.*, site, RejectionCode.StaticPhaseViolation, span))
      }
      let ownerModule = DeclarationId.moduleId(&declaration)
      let ordinal = match move run ordinalOfIdentity(&mut self.resolver.*, ownerModule, &run Shared<DeclarationId>.make(DeclarationId.copy(&declaration))) {
        Option<usize>.Some {value} => value
        Option<usize>.None => {return Result<StaticData, Shared<Rejection>>.failResult(run reject(&self.resolver.*, site, RejectionCode.StaticPhaseViolation, span))}
      }
      let module = run internModule(&mut self.resolver.*, ownerModule)
      let application = run internApplication(&mut self.resolver.*, ty)
      let declarationAccess248Request = Key {
        family: Family.Members, module: module, name: usize.ZERO, declaration: ordinal, member: usize.ZERO, external: false}
      let declarationAccess248 = run internDeclaration(&mut self.resolver, declarationAccess248Request)
      let members = run demandChild(&mut self.resolver.*, &mut self.query.*, &mut self.dependencies.*, declarationAccess248, span)
      let rejected = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(&members, answerCause)
      if let Option<Shared<Rejection>>.Some {value} = move rejected {return Result<StaticData, Shared<Rejection>>.failResult(move value)}
      let count = Shared<Result<Answer, NoRejection>>.with<usize>(&members, reflectedMemberCount)
      let mut at = usize.ZERO
      while at < count {
        let visible = Shared<Result<Answer, NoRejection>>.with<bool>(&members, fn(answer: &Result<Answer, NoRejection>) -> bool {
          return reflectedMemberVisible(answer, at)
        })
        if visible || ModuleId.equals(declaredModule, ownerModule) {
          let declarationAccess249Request = Key {
            family: Family.MemberShape, module: module, name: application, declaration: ordinal, member: at, external: false}
          let declarationAccess249 = run internDeclaration(&mut self.resolver, declarationAccess249Request)
          let shaped = run demandChild(&mut self.resolver.*, &mut self.query.*, &mut self.dependencies.*, declarationAccess249, span)
          let failure = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(&shaped, answerCause)
          if let Option<Shared<Rejection>>.Some {value} = move failure {return Result<StaticData, Shared<Rejection>>.failResult(move value)}
          let valueType = match move Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(&shaped, singleMemberShapeType) {
            Option<Shared<Type>>.Some {value} => move value
            Option<Shared<Type>>.None => {return Result<StaticData, Shared<Rejection>>.failResult(run reject(&self.resolver.*, site, RejectionCode.StaticPhaseViolation, span))}
          }
          let descriptor = run CheckedIntrinsic.fieldType(ty, &valueType)
          let mut fieldKind: u8 = 0
          let mut label = Bytes.make()
          if kind == OwnerKind.Tuple {fieldKind = 1} else {label = run reflectedMemberLabel(&members, at)}
          let field = match move StaticValue.reflectedField(move descriptor, at, fieldKind, run Shared<Bytes>.make(move label), Shared<DeclarationId>.clone(&authority)) {
            Option<StaticData>.Some {value} => move value
            Option<StaticData>.None => {return Result<StaticData, Shared<Rejection>>.failResult(run reject(&self.resolver.*, site, RejectionCode.StaticPhaseViolation, span))}
          }
          run List<Shared<StaticData>>.append(&mut elements, run Shared<StaticData>.make(move field))
        }
        at = at + usize.ONE
      }
    } else {return Result<StaticData, Shared<Rejection>>.failResult(run reject(&self.resolver.*, site, RejectionCode.StaticPhaseViolation, span))}
    let collection = run CheckedIntrinsic.fieldsType(ty)
    return match move run StaticValue.reflectedFields(move collection, move elements) {
      Option<StaticData>.Some {value} => Result<StaticData, Shared<Rejection>>.succeed(move value)
      Option<StaticData>.None => Result<StaticData, Shared<Rejection>>.failResult(run reject(&self.resolver.*, site, RejectionCode.StaticPhaseViolation, span))
    }
  }
  /// Reflects the variants of one closed nominal union in declaration order, each named by its
  /// tag. Variants have no visibility of their own; `authorization` travels with each descriptor
  /// and decides which of its fields `reflectedVariantFields` lists.
  pub effect fn reflectedVariants(self: &mut Self, ty: &Shared<Type>, authorization: &DeclarationId, site: &ModuleId, span: Span)
  -> Result<StaticData, Shared<Rejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
    let nominal = match move run nominalUnionOf(&mut self.resolver.*, ty) {
      Option<NominalUnion>.Some {value} => value
      Option<NominalUnion>.None => {return Result<StaticData, Shared<Rejection>>.failResult(run reject(&self.resolver.*, site, RejectionCode.StaticPhaseViolation, span))}
    }
    let authority = run Shared<DeclarationId>.make(DeclarationId.copy(authorization))
    let membersRequest = Key {
      family: Family.Members, module: nominal.module, name: usize.ZERO, declaration: nominal.declaration, member: usize.ZERO, external: false}
    let membersKey = run internDeclaration(&mut self.resolver, membersRequest)
    let members = run demandChild(&mut self.resolver.*, &mut self.query.*, &mut self.dependencies.*, membersKey, span)
    let rejected = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(&members, answerCause)
    if let Option<Shared<Rejection>>.Some {value} = move rejected {return Result<StaticData, Shared<Rejection>>.failResult(move value)}
    let descriptor = run CheckedIntrinsic.variantType(ty)
    let mut elements = List<Shared<StaticData>>.make()
    let mut tag = usize.ZERO
    while tag < nominal.count {
      let label = run reflectedMemberLabel(&members, tag)
      let variant = match move StaticValue.reflectedVariant(Shared<Type>.clone(&descriptor), tag, run Shared<Bytes>.make(move label),
        Shared<DeclarationId>.clone(&authority)) {
        Option<StaticData>.Some {value} => move value
        Option<StaticData>.None => {return Result<StaticData, Shared<Rejection>>.failResult(run reject(&self.resolver.*, site, RejectionCode.StaticPhaseViolation, span))}
      }
      run List<Shared<StaticData>>.append(&mut elements, run Shared<StaticData>.make(move variant))
      tag = tag + usize.ONE
    }
    let collection = run CheckedIntrinsic.variantsType(ty)
    return match move run StaticValue.reflectedVariants(move collection, move elements) {
      Option<StaticData>.Some {value} => Result<StaticData, Shared<Rejection>>.succeed(move value)
      Option<StaticData>.None => Result<StaticData, Shared<Rejection>>.failResult(run reject(&self.resolver.*, site, RejectionCode.StaticPhaseViolation, span))
    }
  }
  /// Reflects the fields of the variant `tag` of one closed nominal union at their applied types,
  /// as `Field<Union, Value>` descriptors of kind 2. Only the fields visible from the module of
  /// `authorization` are listed.
  pub effect fn reflectedVariantFields(self: &mut Self, ty: &Shared<Type>, tag: usize, authorization: &Shared<DeclarationId>, site: &ModuleId,
    span: Span) -> Result<StaticData, Shared<Rejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
    let nominal = match move run nominalUnionOf(&mut self.resolver.*, ty) {
      Option<NominalUnion>.Some {value} => value
      Option<NominalUnion>.None => {return Result<StaticData, Shared<Rejection>>.failResult(run reject(&self.resolver.*, site, RejectionCode.StaticPhaseViolation, span))}
    }
    let shape = match move run variantShape(&mut self.resolver.*, &mut self.query.*, &mut self.dependencies.*, site, ty, &nominal, tag, span) {
      Result<VariantShape, Shared<Rejection>>.Success {value} => move value
      Result<VariantShape, Shared<Rejection>>.Failure {error} => {return Result<StaticData, Shared<Rejection>>.failResult(move error)}
    }
    let declaredModule = Shared<DeclarationId>.with<ModuleId>(authorization, fn(identity: &DeclarationId) -> ModuleId {
      return ModuleId.copy(DeclarationId.moduleId(identity))
    })
    let names = List<Bytes>.asSlice(&shape.names)
    let types = List<Shared<Type>>.asSlice(&shape.types)
    let mut elements = List<Shared<StaticData>>.make()
    let mut at = usize.ZERO
    while at < types.length {
      if variantFieldVisible(&self.resolver.*, &declaredModule, &shape, at) {
        let descriptor = run CheckedIntrinsic.fieldType(ty, &types[at])
        let label = run Shared<Bytes>.make(run Bytes.copy(Bytes.asSlice(&names[at])))
        let field = match move StaticValue.reflectedField(move descriptor, at, 2, move label, Shared<DeclarationId>.clone(authorization)) {
          Option<StaticData>.Some {value} => move value
          Option<StaticData>.None => {return Result<StaticData, Shared<Rejection>>.failResult(run reject(&self.resolver.*, site, RejectionCode.StaticPhaseViolation, span))}
        }
        run List<Shared<StaticData>>.append(&mut elements, run Shared<StaticData>.make(move field))
      }
      at = at + usize.ONE
    }
    let collection = run CheckedIntrinsic.fieldsType(ty)
    return match move run StaticValue.reflectedFields(move collection, move elements) {
      Option<StaticData>.Some {value} => Result<StaticData, Shared<Rejection>>.succeed(move value)
      Option<StaticData>.None => Result<StaticData, Shared<Rejection>>.failResult(run reject(&self.resolver.*, site, RejectionCode.StaticPhaseViolation, span))
    }
  }
  /// Demands the exact reached body through the active query and records its dependency edge.
  pub effect fn demandBody(self: &mut Self, declaration: &DeclarationId, span: Span) -> Option<
    Shared<Result<Answer, NoRejection>>,
  > ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
    let module = DeclarationId.moduleId(declaration)
    let identity = run Shared<DeclarationId>.make(DeclarationId.copy(declaration))
    let selected = run ordinalOfIdentity(&mut self.resolver.*, module, &identity)
    if let Option<usize>.Some {value: ordinal} = move selected {
      let moduleOrdinal = run internModule(&mut self.resolver.*, module)
      // A runtime body with static work, such as a call that takes a static template, is checked
      // as its selected application, as the declaration sweep checks it; its unselected body
      // answer holds no table of the names it resolves.
      let mut member = usize.ZERO
      let routing = run needsStaticResidualization(&mut self.resolver.*, &mut self.query.*, &mut self.dependencies.*, module, moduleOrdinal, ordinal)
      let residual = match move routing {
        Result<bool, Shared<Rejection>>.Success {value} => value
        Result<bool, Shared<Rejection>>.Failure {..} => false
      }
      if residual {
        let signatureRequest = Key {family: Family.Signature, module: moduleOrdinal, name: usize.ZERO, declaration: ordinal, member: usize.ZERO, external: false}
        let signatureKey = run internDeclaration(&mut self.resolver, signatureRequest)
        let signature = run demandChild(&mut self.resolver.*, &mut self.query.*, &mut self.dependencies.*, signatureKey, span)
        if !Shared<Result<Answer, NoRejection>>.with<bool>(&signature, signatureIsStatic) {
          let instance = run InstanceKey.named(&identity)
          let application = run InstanceKey.selected(&instance)
          let interned = run internSelectedApplication(&mut self.resolver, &application)
          member = interned + usize.ONE
        }
      }
      let declarationAccess250Request = Key {
          family: Family.Body,
          module: moduleOrdinal,
          name: usize.ZERO,
          declaration: ordinal,
          member: member,
          external: false,
        }
      let declarationAccess250 = run internDeclaration(&mut self.resolver, declarationAccess250Request)
      let answer = run demandChild(
        &mut self.resolver.*,
        &mut self.query.*,
        &mut self.dependencies.*,
        declarationAccess250,
        span,
      )
      return Option<Shared<Result<Answer, NoRejection>>>.some(move answer)
    }
    return Option<Shared<Result<Answer, NoRejection>>>.none()
  }
  /// Demands the selected declaration's written signature in the active query.
  /// The answer retains any semantic rejection alongside canonical parameter types.
  pub effect fn demandSignature(self: &mut Self, declaration: &DeclarationId, span: Span) -> Option<Shared<Result<Answer, NoRejection>>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
    let module = DeclarationId.moduleId(declaration)
    let identity = run Shared<DeclarationId>.make(DeclarationId.copy(declaration))
    let selected = run ordinalOfIdentity(&mut self.resolver.*, module, &identity)
    if let Option<usize>.Some {value: ordinal} = move selected {
      let moduleOrdinal = run internModule(&mut self.resolver.*, module)
      let declarationAccess251Request = Key {
          family: Family.Signature,
          module: moduleOrdinal,
          name: usize.ZERO,
          declaration: ordinal,
          member: usize.ZERO,
          external: false,
        }
      let declarationAccess251 = run internDeclaration(&mut self.resolver, declarationAccess251Request)
      let answer = run demandChild(
        &mut self.resolver.*,
        &mut self.query.*,
        &mut self.dependencies.*,
        declarationAccess251,
        span,
      )
      return Option<Shared<Result<Answer, NoRejection>>>.some(move answer)
    }
    return Option<Shared<Result<Answer, NoRejection>>>.none()
  }
  /// The module-level ordinal of one declaration in its own module, if it is still indexed.
  pub effect fn declarationOrdinal(self: &mut Self, declaration: &DeclarationId) -> Option<usize>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator {
    let identity = run Shared<DeclarationId>.make(DeclarationId.copy(declaration))
    return run ordinalOfIdentity(&mut self.resolver.*, DeclarationId.moduleId(declaration), &identity)
  }
  /// MODULE-STATIC-002: whether one indexed declaration is present, demanding each enclosing
  /// module-level arm's condition as a dependency of the active query.
  pub effect fn declarationAvailable(self: &mut Self, module: &ModuleId, declaration: usize, span: Span) -> Result<bool, Shared<Rejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
    return run available(&mut self.resolver.*, &mut self.query.*, &mut self.dependencies.*, module, declaration, span)
  }
  /// Resolves one documentation name with the same profile admission, collisions, import aliases
  /// and external visibility as language lookup. This never requests a callable signature/body.
  pub effect fn documentationBinding(self: &mut Self, module: &ModuleId, name: &[u8], external: bool)
  -> Result<Option<DocumentationBinding>, Shared<Rejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
    let selected = match move run select(&mut self.resolver.*, &mut self.query.*, &mut self.dependencies.*, module, name, external) {
      Result<Selection, Shared<Rejection>>.Success {value} => value
      Result<Selection, Shared<Rejection>>.Failure {error} => {
        return Result<Option<DocumentationBinding>, Shared<Rejection>>.failResult(move error)
      }
    }
    if selected.count == usize.ZERO || (external && selected.publicCount == usize.ZERO) {
      return Result<Option<DocumentationBinding>, Shared<Rejection>>.succeed(Option<DocumentationBinding>.none())
    }
    if selected.count != usize.ONE {
      return Result<Option<DocumentationBinding>, Shared<Rejection>>.failResult(
        run nameCollision(&self.resolver.*, module, selected, name))
    }
    if selected.kind == CandidateKind.Declaration {
      if let Option<DeclarationId>.Some {value} = move run declarationAt(&mut self.resolver.*, module, selected.declaration) {
        return Result<Option<DocumentationBinding>, Shared<Rejection>>.succeed(
          Option<DocumentationBinding>.some(DocumentationBinding.Declaration {identity: move value, isPublic: selected.isPublic}))
      }
    } else {
      let moduleOrdinal = run internModule(&mut self.resolver.*, module)
      let mut member = selected.member
      if selected.kind == CandidateKind.ImportModule { member = usize.MAX }
      let key = run internDeclaration(&mut self.resolver.*, Key {
        family: Family.Import, module: moduleOrdinal, name: usize.ZERO,
        declaration: selected.declaration, member: member, external: false,
      })
      let answer = run demandChild(&mut self.resolver.*, &mut self.query.*, &mut self.dependencies.*, key, selected.span)
      let binding = documentationImportSelection(&self.resolver.*, &answer)
      if let Option<Shared<Rejection>>.Some {value} = move binding.rejected {
        return Result<Option<DocumentationBinding>, Shared<Rejection>>.failResult(move value)
      }
      if let Option<usize>.Some {value: destination} = move binding.module {
        let target = resolvedModule(&self.resolver.*, destination)
        if let Option<usize>.Some {value: ordinal} = move binding.declaration {
          if let Option<DeclarationId>.Some {value} = move run declarationAt(&mut self.resolver.*, &target, ordinal) {
            return Result<Option<DocumentationBinding>, Shared<Rejection>>.succeed(
              Option<DocumentationBinding>.some(DocumentationBinding.Declaration {identity: move value, isPublic: selected.isPublic}))
          }
        } else {
          return Result<Option<DocumentationBinding>, Shared<Rejection>>.succeed(
            Option<DocumentationBinding>.some(DocumentationBinding.Namespace {module: move target, isPublic: selected.isPublic}))
        }
      }
    }
    return Result<Option<DocumentationBinding>, Shared<Rejection>>.succeed(Option<DocumentationBinding>.none())
  }

  /// What the import declared at `declaration` of `module` names: its module, or with `member`
  /// the selected member at that ordinal; none when the import is rejected.
  pub effect fn documentationImport(self: &mut Self, module: &ModuleId, declaration: usize, member: Option<usize>, span: Span)
  -> Option<DocumentationBinding>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
    let moduleOrdinal = run internModule(&mut self.resolver.*, module)
    let mut selected = usize.MAX
    if let Option<usize>.Some {value} = move member { selected = value }
    let key = run internDeclaration(&mut self.resolver.*, Key {
      family: Family.Import, module: moduleOrdinal, name: usize.ZERO,
      declaration: declaration, member: selected, external: false,
    })
    let answer = run demandChild(&mut self.resolver.*, &mut self.query.*, &mut self.dependencies.*, key, span)
    let binding = documentationImportSelection(&self.resolver.*, &answer)
    if let Option<Shared<Rejection>>.Some {..} = &binding.rejected {
      return Option<DocumentationBinding>.none()
    }
    if let Option<usize>.Some {value: destination} = move binding.module {
      let target = resolvedModule(&self.resolver.*, destination)
      if let Option<usize>.Some {value: ordinal} = move binding.declaration {
        if let Option<DeclarationId>.Some {value} = move run declarationAt(&mut self.resolver.*, &target, ordinal) {
          return Option<DocumentationBinding>.some(DocumentationBinding.Declaration {identity: move value, isPublic: false})
        }
        return Option<DocumentationBinding>.none()
      }
      return Option<DocumentationBinding>.some(DocumentationBinding.Namespace {module: move target, isPublic: false})
    }
    return Option<DocumentationBinding>.none()
  }

  /// Resolves an inherent member through publication, without demanding its signature. Invalid
  /// heads and duplicate members remain semantic rejections, never guessed source winners.
  pub effect fn documentationMember(self: &mut Self, module: &ModuleId, owner: &[u8], name: &[u8])
  -> Result<Option<DeclarationId>, Shared<Rejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
    let answer = run demandNamed(&mut self.resolver.*, &mut self.query.*, module, owner, Family.InherentMembers)
    if let Option<Shared<Rejection>>.Some {value} = move Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(&answer, answerCause) {
      return Result<Option<DeclarationId>, Shared<Rejection>>.failResult(move value)
    }
    let found = Shared<Result<Answer, NoRejection>>.with<InherentLookup>(&answer,
      fn(value: &Result<Answer, NoRejection>) -> InherentLookup { return inherentLookup(value, name) })
    if let Option<Shared<Rejection>>.Some {value} = move found.rejected {
      return Result<Option<DeclarationId>, Shared<Rejection>>.failResult(move value)
    }
    if let Option<Shared<DeclarationId>>.Some {value} = move found.published {
      return Result<Option<DeclarationId>, Shared<Rejection>>.succeed(
        Option<DeclarationId>.some(DeclarationId.copyShared(&value)))
    }
    return Result<Option<DeclarationId>, Shared<Rejection>>.succeed(Option<DeclarationId>.none())
  }

  /// Validates one implementation head without checking members or callable bodies, and reports
  /// whether its nominal provider and contract are both externally published.
  pub effect fn documentationImplementationPublic(self: &mut Self, module: &ModuleId, ordinal: usize, span: Span)
  -> Result<bool, Shared<Rejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
    let moduleOrdinal = run internModule(&mut self.resolver.*, module)
    let key = run internDeclaration(&mut self.resolver.*, Key {
      family: Family.ImplementationHead, module: moduleOrdinal, name: usize.ZERO,
      declaration: ordinal, member: usize.ZERO, external: false,
    })
    let answer = run demandChild(&mut self.resolver.*, &mut self.query.*, &mut self.dependencies.*, key, span)
    if let Option<Shared<Rejection>>.Some {value} = move Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(&answer, answerCause) {
      return Result<bool, Shared<Rejection>>.failResult(move value)
    }
    let head = Shared<Result<Answer, NoRejection>>.with<Option<Shared<ImplementationHead>>>(&answer,
      fn(result: &Result<Answer, NoRejection>) -> Option<Shared<ImplementationHead>> {
        if let Result<Answer, NoRejection>.Success {value} = &result.* {
          if let Outcome.Success {value: Value.ImplementationHead {head}} = &value.outcome {
            return Option<Shared<ImplementationHead>>.some(Shared<ImplementationHead>.clone(&head))
          }
        }
        return Option<Shared<ImplementationHead>>.none()
      })
    if let Option<Shared<ImplementationHead>>.Some {value: resolvedHead} = move head {
      let provider = Shared<ImplementationHead>.with<Option<DeclarationId>>(&resolvedHead,
        fn(head: &ImplementationHead) -> Option<DeclarationId> { return Shared<Type>.with<Option<DeclarationId>>(&head.provider, nominalOf) })
      let contract = Shared<ImplementationHead>.with<Option<DeclarationId>>(&resolvedHead,
        fn(head: &ImplementationHead) -> Option<DeclarationId> {
          if let Option<Shared<Type>>.Some {value: contractType} = &head.contract { return Shared<Type>.with<Option<DeclarationId>>(&contractType, nominalOf) }
          return Option<DeclarationId>.none()
        })
      let mut declarations = List<DeclarationId>.make()
      if let Option<DeclarationId>.Some {value: identity} = move provider { run List<DeclarationId>.append(&mut declarations, move identity) }
      if let Option<DeclarationId>.Some {value: identity} = move contract { run List<DeclarationId>.append(&mut declarations, move identity) }
      let listed = List<DeclarationId>.asSlice(&declarations)
      let mut at = usize.ZERO
      while at < listed.length {
        let spelling = run DeclarationId.copySpelling(&listed[at])
        let selected = run StaticPort.documentationBinding(&mut self.*, DeclarationId.moduleId(&listed[at]), Bytes.asSlice(&spelling), true)
        match move selected {
          Result<Option<DocumentationBinding>, Shared<Rejection>>.Failure {error} => { return Result<bool, Shared<Rejection>>.failResult(move error) }
          Result<Option<DocumentationBinding>, Shared<Rejection>>.Success {value} => {
            if let Option<DocumentationBinding>.None = move value { return Result<bool, Shared<Rejection>>.succeed(false) }
          }
        }
        at = at + usize.ONE
      }
      return Result<bool, Shared<Rejection>>.succeed(true)
    }
    return Result<bool, Shared<Rejection>>.failResult(run reject(&self.resolver.*, module, RejectionCode.Unsupported, span))
  }

  /// Returns an implementation's nominal provider for documentation owner scope. Structural
  /// providers have no nominal owner. The shared implementation-head query authenticates it.
  pub effect fn documentationProvider(self: &mut Self, module: &ModuleId, ordinal: usize, span: Span)
  -> Result<Option<DeclarationId>, Shared<Rejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
    let moduleOrdinal = run internModule(&mut self.resolver.*, module)
    let key = run internDeclaration(&mut self.resolver.*, Key {
      family: Family.ImplementationHead, module: moduleOrdinal, name: usize.ZERO,
      declaration: ordinal, member: usize.ZERO, external: false,
    })
    let answer = run demandChild(&mut self.resolver.*, &mut self.query.*, &mut self.dependencies.*, key, span)
    if let Option<Shared<Rejection>>.Some {value} = move Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(&answer, answerCause) {
      return Result<Option<DeclarationId>, Shared<Rejection>>.failResult(move value)
    }
    let provider = Shared<Result<Answer, NoRejection>>.with<Option<DeclarationId>>(&answer,
      fn(result: &Result<Answer, NoRejection>) -> Option<DeclarationId> {
        if let Result<Answer, NoRejection>.Success {value} = &result.* {
          if let Outcome.Success {value: Value.ImplementationHead {head}} = &value.outcome {
            return Shared<ImplementationHead>.with<Option<DeclarationId>>(&head,
              fn(providerHead: &ImplementationHead) -> Option<DeclarationId> { return Shared<Type>.with<Option<DeclarationId>>(&providerHead.provider, nominalOf) })
          }
        }
        return Option<DeclarationId>.none()
      })
    return Result<Option<DeclarationId>, Shared<Rejection>>.succeed(move provider)
  }
  /// Whether one reached call in a declaration's body names a static function, read from the
  /// callee's tracked header exactly as body routing reads it.
  pub effect fn callPhase(self: &mut Self, module: &ModuleId, declaration: usize, call: HirId) -> Result<CallPhase, Shared<Rejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
    return run writtenCallPhase(&mut self.resolver.*, &mut self.query.*, &mut self.dependencies.*, module, declaration, call)
  }
  /// Checks one reached static expression through the active query, preserving its source IDs.
  /// A mixed body's inactive static arms are never checked by this demand.
  /// Supplies evaluated bindings to nested compile-time counts without re-evaluating their initializers.
  pub effect fn demandCheckedRoot(
    self: &mut Self,
    module: &ModuleId,
    declaration: Option<usize>,
    root: HirId,
    expectation: StaticRootExpectation,
    binders: &[StaticRootBinder],
    bindings: &[StaticBinding],
  ) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
    let answer = run checkedStaticRoot(
      &mut self.resolver.*,
      &mut self.query.*,
      &mut self.dependencies.*,
      module,
      move declaration,
      root,
      move expectation,
      binders,
      bindings,
    )
    return run Shared<Result<Answer, NoRejection>>.make(
      Result<Answer, NoRejection>.succeed(move answer),
    )
  }

  /// Selects an unqualified static demand root through the shared declaration query.
  pub effect fn resolveRootDeclaration(
    self: &mut Self,
    module: &ModuleId,
    name: &[u8],
    span: Span,
  ) -> Result<DeclarationId, Shared<Rejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
    let caller = run internModule(&mut self.resolver.*, module)
    let chosen = run selectDeclaration(
      &mut self.resolver.*,
      &mut self.query.*,
      &mut self.dependencies.*,
      caller,
      module,
      name,
      false,
      span,
      RejectionCode.UnknownFunction, RejectionCode.NotCallable, false)
    return match move chosen {
      Result<SelectedDeclaration, Shared<Rejection>>.Success {value} => {
        let selected = resolvedModule(&self.resolver.*, value.module)
        let declaration = run declarationAt(&mut self.resolver.*, &selected, value.ordinal)
        return match move declaration {
          Option<DeclarationId>.Some {value: identity} => Result<
            DeclarationId,
            Shared<Rejection>,
          >.succeed(move identity)
          Option<DeclarationId>.None => Result<DeclarationId, Shared<Rejection>>.failResult(
            run reject(&self.resolver.*, module, RejectionCode.NotCallable, span),
          )
        }
      }
      Result<SelectedDeclaration, Shared<Rejection>>.Failure {error} => Result<
        DeclarationId,
        Shared<Rejection>,
      >.failResult(move error)
    }
  }
}

// Opens an empty store; a traced one also records every query lifecycle event.
fn openStore(source: SourceIndex, target: MachineTarget, profile: Option<FinalProfile>, tracing: bool) -> Semantic {
  let revisable = SourceIndex.revisable(&source)
  let profileSlot = match &profile {
    Option<FinalProfile>.Some {..} => usize.ONE
    Option<FinalProfile>.None => usize.ZERO
  }
  let selectedTarget = match &profile {
    Option<FinalProfile>.Some {value} => FinalProfile.target(&value)
    Option<FinalProfile>.None => target
  }
  return Semantic {
    resolver: Resolver {
      staticDemandDepth: usize.ZERO,
      staticDemandLimit: usize.MAX,
      discoveredStaticCall: Option<StaticCallHint>.none(),
      source: move source,
      baseTarget: target,
      target: selectedTarget,
      initialProfile: move profile,
      assemblyFacts: Option<InitialProfile>.none(),
      parameterAssembly: Option<ParameterAssembly>.none(),
      nextAssembly: usize.ZERO,
      executionStorage: Option<ExecutionStorage>.none(),
      retention: List<RetentionRoot>.make(),
      editorTables: false,
      discovery: Option<Discovery>.none(),
      packages: PackageGraph.single(),
      profiles: List<FinalProfile>.make(),
      profileSlot: profileSlot,
      mirValues: List<MirFunction>.make(),
      mirReleased: List<bool>.make(),
      mirReleasedCount: usize.ZERO,
      layoutValues: List<Shared<BackendLayout>>.make(),
      layoutContents: List<Bytes>.make(),
      exportedObjects: List<ExportedObject>.make(),
      exportedFunctions: List<LlvmCode.Declaration>.make(),
      emissionInputs: List<EmissionInputs>.make(),
      llvmInputs: List<LlvmInput>.make(),
      llvmValues: List<InstanceDefinition>.make(),
      codegenUnits: false,
      fastPathIr: false,
      packing: false,
      offeredBodies: List<BuildRecord.PackBody>.make(),
      packs: List<HeldPack>.make(),
      modules: List<ModuleId>.make(),
      moduleLookup: InternIndex.make(),
      declarations: DeclarationTable.make(),
      sourceInputs: Inputs.make(),
      declarationChanges: List<DeclarationChange>.make(),
      names: StringTable.make(),
      applications: List<Shared<Type>>.make(),
      applicationLookup: InternIndex.make(),
      erasedTypes: List<Shared<Type>>.make(),
      erasedTypeLookup: InternIndex.make(),
      erasedHandles: List<ErasedHandle>.make(),
      erasedHandleLookup: InternIndex.make(),
      headerFingerprints: List<HeaderFingerprint>.make(),
      headerFingerprintLookup: InternIndex.make(),
      staticReads: List<StaticReads>.make(),
      staticReadsLookup: InternIndex.make(),
      moduleScans: List<ModuleScan>.make(),
      moduleScanLookup: InternIndex.make(),
      backendInstances: List<BackendInstance>.make(),
      claimFree: List<bool>.make(),
      backendInstanceLookup: InternIndex.make(),
      originPlans: List<CallableOrigin.Plan>.make(),
      originEvidence: List<CallableOrigin.Producer>.make(),
      selectedApplications: List<Application>.make(),
      selectedApplicationLookup: InternIndex.make(),
      llvmInputLookup: InternIndex.make(),
      keys: List<ScopedKey>.make(),
      keyLookup: InternIndex.make(),
      currentApplication: usize.MAX,
      active: List<Word>.make(),
      graph: Graph.make(revisable),
      demands: usize.ZERO,
      hits: usize.ZERO,
      runs: usize.ZERO,
      tracing: tracing,
      events: List<Event>.make(),
      staleCauses: List<StaleCause>.make(),
      nextInferenceId: usize.ZERO,
      exactLocalRegions: false,
      bodies: List<BodyFrame>.make(),
      progress: Progress.off(),
      verifyMir: false,
      rootRecorder: usize.MAX,
      currentRun: usize.ZERO,
      impliedWalks: List<ImpliedWalk>.make(),
      impliedLookup: InternIndex.make(),
      impliedRevision: 0,
      runWalks: List<ImpliedWalk>.make(),
      pathFrames: usize.ZERO,
      pathReads: usize.ZERO,
      bodyFacts: List<Option<BodyFacts>>.make(),
      bodyFactsSlots: List<usize>.make(),
    },
    query: Query<Answer, NoRejection>.make(),
    deferredTemplates: List<DeferredStaticTemplate>.make(),
    uncheckedRoot: List<UncheckedBody>.make(),
    moduleMemos: List<ModuleCheckMemo>.make(),
    escapeMemos: List<EscapeMemo>.make(),
    declarationMemos: List<DeclarationMemo>.make(),
    declarationSlots: List<usize>.make(),
    pendingImage: Option<PendingImage>.none(),
    replayReports: List<ReplayReport>.make(),
    carriedUnits: List<usize>.make(),
    carriedRoots: List<usize>.make(),
    checkRuns: usize.ZERO,
    capturedBuild: Option<CapturedBuild>.none(),
    freshBuild: false,
    packedBuild: PackedBuild.make(),
    replay: Option<ReplayState>.none(),
    carriedBuild: List<usize>.make(),
    escapeImage: EscapeImage.make(),
    freshEscapes: false,
  }
}

impl Semantic {
  /// Borrows the held resolver and query for a static demand outside a running provider.
  pub fn staticPort<'source>(self: &'source mut Self, dependencies: &'source mut List<Dependency>) -> StaticPort<
    'source,
  > {
    return StaticPort {
      resolver: &mut self.resolver,
      query: &mut self.query,
      dependencies: move dependencies,
    }
  }
  /// Creates a lazy semantic store for one held revision and explicitly selected target.
  pub fn make(revision: Revision, target: MachineTarget, profile: Option<FinalProfile>) -> Semantic {
    return openStore(SourceIndex.make(move revision), target, move profile, false)
  }
  /// Creates a store for a one-shot build whose revision holds the whole program.
  ///
  /// # Details
  ///
  /// It computes the same answers as [`make`] but records nothing for revision: no dependency
  /// graph and no emission content digests, and no completed answer is ever outdated.
  ///
  /// # Gotchas
  ///
  /// Revising a one-shot store traps.
  pub fn oneShot(revision: Revision, target: MachineTarget, profile: Option<FinalProfile>) -> Semantic {
    return openStore(SourceIndex.oneShot(move revision), target, move profile, false)
  }
  /// Opens a store that also records every query lifecycle event for `eventLog`.
  pub fn traced(revision: Revision, target: MachineTarget, profile: Option<FinalProfile>) -> Semantic {
    return openStore(SourceIndex.make(move revision), target, move profile, true)
  }

  /// Selects a new immutable source revision and validates completed facts on their next demand.
  ///
  /// # Details
  ///
  /// Hands the store the units a driver parsed while loading the program, so each module's first
  /// demand reuses its parse when the bytes are the same.
  pub fn offerParsed(self: &mut Self, units: List<SourceUnit>) -> () {
    SourceIndex.offerParsed(&mut self.resolver.source, move units)
  }
  /// Whether a module whose syntax lowers to `hir`, indexed as `index`, declares a function with a
  /// foreign linkage or a static: the headers a check of foreign symbols reads. Without one, the
  /// module claims no symbol, and a loader that read its source can say so (`offerClaimFree`).
  pub fn claimsForeignSymbols(hir: &Module, index: &ModuleIndex) -> bool {
    let declarations = ModuleIndex.listDeclarations(index)
    let mut at = usize.ZERO
    while at < declarations.length {
      let written = Module.node(hir, declarations[at].header)
      if let Node.FunctionHeader {linkage, ..} = written {
        if linkage.present { return true }
      } else if let Node.StaticHeader {..} = written {
        return true
      }
      at = at + usize.ONE
    }
    return false
  }
  /// Takes `modules`, whose current source the loader read, as declaring no foreign claim: a check
  /// of foreign symbols does not read them (see [`claimsForeignSymbols`]).
  pub effect fn offerClaimFree(self: &mut Self, modules: &[ModuleId]) -> () ! OutOfMemoryError ? &mut Allocator {
    let mut at = usize.ZERO
    while at < modules.length {
      let ordinal = run internModule(&mut self.resolver, &modules[at])
      while List<bool>.length(&self.resolver.claimFree) <= ordinal { run List<bool>.append(&mut self.resolver.claimFree, false) }
      List<bool>.set(&mut self.resolver.claimFree, ordinal, true)
      at = at + usize.ONE
    }
  }
  /// Selects the execution-storage component a build binds when a reached instance suspends.
  pub fn selectExecutionStorage(self: &mut Self, storage: ExecutionStorage) -> () {
    self.resolver.executionStorage = Option<ExecutionStorage>.some(move storage)
  }
  /// Selects the composition's explicit retention roots, which an artifact build keeps beside its
  /// exports (ARTIFACT-003).
  pub fn selectRetention(self: &mut Self, roots: List<RetentionRoot>) -> () {
    self.resolver.retention = move roots
  }
  /// Selects whether checked bodies keep the names they resolve, which an editor reads to answer
  /// hover and go to definition. A build leaves it off and keeps no table.
  pub fn selectEditorTables(self: &mut Self, enabled: bool) -> () {
    self.resolver.editorTables = enabled
  }
  /// Hands the store the reporter that checking and emission advance; `takeProgress` returns it.
  pub fn selectProgress(self: &mut Self, progress: Progress) -> () {
    self.resolver.progress = move progress
  }
  /// Checks every lowered MIR function for uses after drop before it is stored, panicking with a
  /// compiler bug on one. Call it before the first demand, so every MIR answer records the same
  /// dependencies.
  pub fn selectMirVerification(self: &mut Self) -> () {
    self.resolver.verifyMir = true
  }
  /// Returns the reporter `selectProgress` handed over, leaving an off one in its place.
  pub fn takeProgress(self: &mut Self) -> Progress {
    return Intrinsic.replace(self.resolver.progress, Progress.off())
  }
  /// Selects the discovery root of a test build: its tests and their package-relative paths
  /// below `directory`, such as `src`, answer `Intrinsic.tests()` (TEST-003). Without a selection
  /// test discovery is a static-phase rejection.
  /// Selects the package graph of a build that spans several packages (PACKAGE-002). Without a
  /// selection every import path names a module of its importer's own package.
  pub fn selectPackages(self: &mut Self, packages: PackageGraph) -> () {
    self.resolver.packages = move packages
  }
  pub fn selectDiscovery(self: &mut Self, root: ModuleId, directory: Bytes) -> () {
    self.resolver.discovery = Option<Discovery>.some(Discovery {root: move root, directory: move directory,
      exports: List<ModuleId>.make()})
  }
  /// Adds the package's exported modules to the selected discovery root, so their tests are
  /// discovered even when the root imports none of them (TEST-003).
  pub fn selectDiscoveryExports(self: &mut Self, exports: List<ModuleId>) -> () {
    match &mut self.resolver.discovery {
      Option<Discovery>.Some {value} => { value.exports = move exports }
      Option<Discovery>.None => { drop exports }
    }
  }
  /// The identities of a catalog's tests, in catalog order: what the runner's catalog digest binds.
  pub effect fn testIdentities(catalog: &Shared<TestCatalog>) -> List<Bytes> ! OutOfMemoryError ? &mut Allocator {
    let count = Shared<TestCatalog>.with<usize>(catalog, fn(held: &TestCatalog) -> usize { return List<TestEntry>.length(&held.entries) })
    let mut identities = List<Bytes>.make()
    let mut ordinal = usize.ZERO
    while ordinal < count {
      run List<Bytes>.append(&mut identities, run entryText(catalog, ordinal, usize.ZERO))
      ordinal = ordinal + usize.ONE
    }
    return move identities
  }
  /// The selected discovery root's test catalog, in catalog order, or the rejection that stopped
  /// discovery, such as an invalid test declaration (TEST-001).
  pub effect fn demandTests(self: &mut Self, request: &mut Request) -> Result<Shared<TestCatalog>, Shared<Rejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
    run selectRequest(&mut self.resolver, &request.*)
    let root = match &self.resolver.discovery {
      Option<Discovery>.Some {value} => ModuleId.copy(&value.root)
      Option<Discovery>.None => {
        let sealed = run ModuleId.make(b"compiler-sealed-intrinsic", b"silk", b"Intrinsic")
        return Result<Shared<TestCatalog>, Shared<Rejection>>.failResult(
          run reject(&self.resolver, &sealed, RejectionCode.StaticPhaseViolation, Span.make(usize.ZERO, usize.ZERO)))
      }
    }
    let declarationAccess252Request = Key {family: Family.Tests, module: run internModule(&mut self.resolver, &root), name: usize.ZERO,
      declaration: usize.ZERO, member: usize.ZERO, external: false}
    let declarationAccess252 = run internDeclaration(&mut self.resolver, declarationAccess252Request)
    let key = declarationAccess252
    let answer = run demandRaw(&mut self.resolver, &mut self.query, key, Span.make(usize.ZERO, usize.ZERO))
    run recordRoot(&mut request.*, Family.Tests, &root, b"", &answer)
    return run answeredTests(&self.resolver, &answer, &root, Span.make(usize.ZERO, usize.ZERO))
  }
  /// Updates this revisable store to `revision`.
  ///
  /// # Details
  ///
  /// Before any key/cache/location access, all pending observed modules are reconciled.
  /// Surviving identities retain handles; intermediate deletion or absence ends them.
  /// Changed consumed source inputs and raw source readers invalidate their result dependers.
  /// Publication reserves history before mutation; failed reconciliation remains retryable.
  pub effect fn update(self: &mut Self, revision: Revision) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    // Prepare every history append before SourceIndex publishes the new revision. Modules are
    // precisely this session's observed/interned set, not the project's declaration catalog.
    let mut observations = List<List<Observation>>.make()
    let modules = List<ModuleId>.asSlice(&self.resolver.modules)
    let mut at = usize.ZERO
    while at < modules.length {
      let mut history = List<Observation>.make()
      run List<Observation>.append(&mut history, run Revision.observe(&revision, &modules[at]))
      run List<List<Observation>>.append(&mut observations, move history)
      at = at + usize.ONE
    }
    run List<DeclarationChange>.reserve(&mut self.resolver.declarationChanges, modules.length)
    let mut pending = List<DeclarationChange>.asMutSlice(&mut self.resolver.declarationChanges)
    at = usize.ZERO
    while at < pending.length {
      run List<Observation>.reserve(&mut pending[at].observations, usize.ONE)
      at = at + usize.ONE
    }
    Graph.beginRevision(&mut self.resolver.graph)
    self.resolver.claimFree = List<bool>.make()
    let mut changed = run SourceIndex.revise(&mut self.resolver.source, move revision)
    // Remaining appends fit reservations. A failed update above leaves source/history unchanged.
    let mut publishedHistory = List<DeclarationChange>.asMutSlice(&mut self.resolver.declarationChanges)
    at = usize.ZERO
    while at < publishedHistory.length {
      let mut staged = List<List<Observation>>.asMutSlice(&mut observations)
      let observed = List<Observation>.remove(&mut staged[publishedHistory[at].ordinal], usize.ZERO)
      let history = List<Observation>.asSlice(&publishedHistory[at].observations)
      if !Observation.equals(&history[history.length - usize.ONE], &observed) {
        run List<Observation>.append(&mut publishedHistory[at].observations, move observed)
      }
      at = at + usize.ONE
    }
    while List<SourceChange>.length(&changed) > usize.ZERO {
      let change = List<SourceChange>.remove(&mut changed, usize.ZERO)
      let ordinal = knownModuleOrdinal(&self.resolver, &change.module)
      if ordinal != usize.MAX && pendingDeclarationChange(&self.resolver, &change.module) == usize.MAX {
        let mut staged = List<List<Observation>>.asMutSlice(&mut observations)
        let history = Intrinsic.replace(staged[ordinal], List<Observation>.make())
        run List<DeclarationChange>.append(&mut self.resolver.declarationChanges, DeclarationChange {
          module: move change.module, ordinal: ordinal, previous: move change.previous, observations: move history,
        })
        DeclarationTable.invalidate(&mut self.resolver.declarations, ordinal)
      }
    }
    return ()
  }
  /// Reports whether a completed root of `request` demanded a fact of `family` in `module`, itself
  /// or through any unit it consumed. Only a revisable store records what its units consumed.
  pub fn requestDemanded(self: &mut Self, request: &Request, family: Family, module: &ModuleId) -> bool {
    let ordinal = knownModuleOrdinal(&self.resolver, module)
    let roots = List<Root>.asSlice(&request.roots)
    let mut at = usize.ZERO
    while at < roots.length {
      if roots[at].family == family && ModuleId.equals(&roots[at].module, module) {
        return true
      }
      let unit = rootUnit(&mut self.*, &roots[at].answer)
      if ordinal != usize.MAX && unit != usize.MAX {
        Graph.beginTraversal(&mut self.resolver.graph)
        if reachesDemand(&mut self.resolver, unit, family, ordinal) {
          return true
        }
      }
      at = at + usize.ONE
    }
    return false
  }
  /// The exact hash of a completed answer, absent when the answer has a part with no exact
  /// encoding. Equal answers hash equal in every store and revision.
  pub fn fingerprint(answer: &Answer) -> Option<ContentHash> {
    return answerFingerprint(answer)
  }
  /// How many module sweeps and escape checks this store ran rather than reused, so a caller can
  /// tell whether the cache image it read still holds everything this store would write.
  pub fn moduleCheckRuns(self: &Self) -> usize {
    return self.checkRuns
  }
  /// The roots of the image an unlinked `adoptCache` read that this store still holds as they
  /// were: they rest on nothing here, so the image this store writes next carries them over
  /// (`CacheImage.carry`).
  pub fn carried(self: &Self) -> &[usize] {
    return List<usize>.asSlice(&self.carriedRoots)
  }
  /// The build roots of the image an adoption read that the image `cacheImage` wrote last
  /// carries over (`CacheImage.carry`): the definitions a replayed build took from that image.
  pub fn carriedDefinitions(self: &Self) -> &[usize] {
    return List<usize>.asSlice(&self.carriedBuild)
  }
  /// DEBUG
  // DEBUG
  /// Whether the last build walked or replayed anything the image this store read does not hold.
  pub fn buildChanged(self: &Self) -> bool {
    return self.freshBuild || self.freshEscapes
  }
  /// Copies the store's demand counters, and its graph's when it is revisable.
  pub fn statistics(self: &Self) -> Statistics {
    let mut graph = Option<GraphCounters>.none()
    if Graph.recording(&self.resolver.graph) {
      graph = Option<GraphCounters>.some(Graph.counters(&self.resolver.graph))
    }
    return Statistics {demands: self.resolver.demands, hits: self.resolver.hits, runs: self.resolver.runs,
      answers: Query<Answer, NoRejection>.length(&self.query),
      mirFunctions: List<MirFunction>.length(&self.resolver.mirValues) - self.resolver.mirReleasedCount,
      graph: move graph}
  }
  /// Empties every lowered MIR function that no completed answer of the store or root of
  /// `request` names, with the helpers lowered after it, and returns how many it emptied. A unit
  /// that reruns lowers its function again, so the old one is garbage once nothing names it. An
  /// answer held anywhere else must not be read for its MIR afterwards.
  pub effect fn releaseStaleMir(self: &mut Self, request: &Request) -> usize ! OutOfMemoryError ? &mut Allocator {
    let count = List<MirFunction>.length(&self.resolver.mirValues)
    let mut live = List<bool>.make()
    while List<bool>.length(&live) < count { run List<bool>.append(&mut live, false) }
    let slots = Query<Answer, NoRejection>.slots(&self.query)
    let mut slot = usize.ZERO
    while slot < slots {
      if let Option<Shared<Result<Answer, NoRejection>>>.Some {value: answer} = move Query<Answer, NoRejection>.completed(&mut self.query, Word {value: usize.toU64(slot)}) {
        markLiveMir(&self.resolver, &mut live, &answer)
      }
      slot = slot + usize.ONE
    }
    let roots = List<Root>.asSlice(&request.roots)
    let mut at = usize.ZERO
    while at < roots.length {
      markLiveMir(&self.resolver, &mut live, &roots[at].answer)
      at = at + usize.ONE
    }
    while List<bool>.length(&self.resolver.mirReleased) < count { run List<bool>.append(&mut self.resolver.mirReleased, false) }
    let marks = List<bool>.asSlice(&live)
    let mut released = usize.ZERO
    let mut functions = List<MirFunction>.asMutSlice(&mut self.resolver.mirValues)
    let mut freed = List<bool>.asMutSlice(&mut self.resolver.mirReleased)
    at = usize.ZERO
    while at < count {
      if !marks[at] && !freed[at] {
        emptyMir(&mut functions[at])
        freed[at] = true
        released = released + usize.ONE
      }
      at = at + usize.ONE
    }
    self.resolver.mirReleasedCount = self.resolver.mirReleasedCount + released
    return released
  }
  /// Reports whether the unit that completed `answer` read the source of `module`, itself or
  /// through any unit it consumed. Only a revisable store records what its units read.
  pub fn answerRead(self: &mut Self, answer: &Shared<Result<Answer, NoRejection>>, module: &ModuleId) -> bool {
    let ordinal = knownModuleOrdinal(&self.resolver, module)
    let unit = rootUnit(&mut self.*, answer)
    if ordinal == usize.MAX || unit == usize.MAX {
      return false
    }
    Graph.beginTraversal(&mut self.resolver.graph)
    return reachesSource(&mut self.resolver, unit, ordinal)
  }
  /// Counts the modules whose source the unit that completed `answer` read, itself or through any
  /// unit it consumed. Only a revisable store records what its units read.
  pub fn sourcesRead(self: &mut Self, answer: &Shared<Result<Answer, NoRejection>>) -> usize {
    let unit = rootUnit(&mut self.*, answer)
    if unit == usize.MAX {
      return usize.ZERO
    }
    let mut count = usize.ZERO
    let mut ordinal = usize.ZERO
    while ordinal < List<ModuleId>.length(&self.resolver.modules) {
      Graph.beginTraversal(&mut self.resolver.graph)
      if reachesSource(&mut self.resolver, unit, ordinal) {
        count = count + usize.ONE
      }
      ordinal = ordinal + usize.ONE
    }
    return count
  }
  /// Reports whether a completed root of `request` read a module that is present, itself or through
  /// any unit it consumed. An absent module is not discovered. Only a revisable store records what
  /// its units read; a root that is no unit reads only its own module.
  pub fn requestDiscovered(self: &mut Self, request: &Request, module: &ModuleId) -> bool {
    if !SourceIndex.presents(&self.resolver.source, module) {
      return false
    }
    let ordinal = knownModuleOrdinal(&self.resolver, module)
    let roots = List<Root>.asSlice(&request.roots)
    let mut at = usize.ZERO
    while at < roots.length {
      let unit = rootUnit(&mut self.*, &roots[at].answer)
      if unit == usize.MAX {
        if ModuleId.equals(&roots[at].module, module) {
          return true
        }
      } else if ordinal != usize.MAX {
        Graph.beginTraversal(&mut self.resolver.graph)
        if reachesSource(&mut self.resolver, unit, ordinal) {
          return true
        }
      }
      at = at + usize.ONE
    }
    return false
  }
  /// Freezes one assembly's facts before any registered source default is demanded.
  /// A semantic store accepts only the facts for which its target and cached answers were opened.
  pub effect fn bindAssemblyFacts(self: &mut Self, facts: &InitialProfile) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
    let selectedTarget = InitialProfile.target(facts)
    if MachineTarget.id(selectedTarget) != MachineTarget.id(&self.resolver.target) {
      return false
    }
    if let Option<&FinalProfile>.Some {value: active} = move selectedProfile(&self.resolver) {
      if !InitialProfile.sameIdentity(FinalProfile.facts(active), facts) { return false }
    }
    let mut bound = false
    match &self.resolver.assemblyFacts {
      Option<InitialProfile>.Some {value: previous} => {
        if !InitialProfile.sameIdentity(&previous, facts) { return false }
        bound = true
      }
      Option<InitialProfile>.None => {}
    }
    if !bound { self.resolver.assemblyFacts = Option<InitialProfile>.some(run InitialProfile.copy(facts)) }
    if self.resolver.profileSlot == usize.ZERO { self.resolver.profileSlot = usize.MAX }
    return true
  }
  /// Opens one fresh effective-default graph. The caller closes it through a release provider.
  pub fn beginParameterAssembly(self: &mut Self, parameters: List<DeclarationId>, bindings: List<ProfileEntry>) -> usize {
    let previous = self.resolver.profileSlot
    self.resolver.nextAssembly = self.resolver.nextAssembly + usize.ONE
    self.resolver.profileSlot = usize.MAX - self.resolver.nextAssembly
    self.resolver.parameterAssembly = Option<ParameterAssembly>.some(ParameterAssembly {
      parameters: move parameters, bindings: move bindings,
    })
    return previous
  }
  /// Restores the previous complete-profile scope after success, rejection, or cancellation.
  pub fn endParameterAssembly(self: &mut Self, previous: usize) -> () {
    self.resolver.parameterAssembly = Option<ParameterAssembly>.none()
    self.resolver.profileSlot = previous
    return ()
  }
  /// Replaces effective bindings with the complete map before any final predicates execute.
  pub fn selectAssemblyValues(self: &mut Self, values: List<ProfileEntry>) -> () {
    if let Option<ParameterAssembly>.Some {value} = &mut self.resolver.parameterAssembly {
      replaceAssemblyValues(&mut value, move values)
    }
    return ()
  }
  /// Evaluates the written predicate at bool against the current complete assembly map.
  /// A package parameter problem found while assembling the profile (SEM0214), reported at the
  /// parameter's declaration: `before`, the parameter's name, then `after`.
  pub effect fn parameterProblem(self: &mut Self, identity: &DeclarationId, before: &[u8], after: &[u8]) -> Shared<Rejection>
  ! Cycle | OutOfMemoryError ? &mut Allocator {
    let module = DeclarationId.moduleId(identity)
    let owned = run Shared<DeclarationId>.make(DeclarationId.copy(identity))
    let mut span = Span.make(usize.ZERO, usize.ZERO)
    if let Option<usize>.Some {value: ordinal} = move run ordinalOfIdentity(&mut self.resolver, module, &owned) {
      if let Option<HeaderSyntax>.Some {value: written} = move run header(&mut self.resolver, module, ordinal) { span = written.span }
    }
    let name = run DeclarationId.copySpelling(identity)
    return run namedParameterRejection(RejectionCode.InvalidParameterSchema, module, span, Bytes.asSlice(&name), before, after)
  }
  pub effect fn validateParameter(self: &mut Self, request: &mut Request, identity: &DeclarationId) -> Result<(), Shared<Rejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
    run selectRequest(&mut self.resolver, &request.*)
    let module = DeclarationId.moduleId(identity)
    let owned = run Shared<DeclarationId>.make(DeclarationId.copy(identity))
    let ordinal = match move run ordinalOfIdentity(&mut self.resolver, module, &owned) {
      Option<usize>.Some {value} => value
      Option<usize>.None => {
        return Result<(), Shared<Rejection>>.failResult(run reject(&self.resolver, module,
          RejectionCode.InvalidParameterSchema, Span.make(usize.ZERO, usize.ZERO)))
      }
    }
    let answer = run source(&mut self.resolver, module)
    let mut expression = Option<HirId>.none()
    if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(&self.resolver, &answer, module) {
      let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(indexed))
      let hir = IndexedSource.authored(indexed)
      if ordinal < declarations.length {
        if let Node.Declaration {body, ..} = Module.node(hir, declarations[ordinal].local) {
          if let Node.PackageParameterBody {validation, ..} = Module.node(hir, body) {
            if validation.present { expression = Option<HirId>.some(validation.id) }
          }
        }
      }
    }
    if let Option<HirId>.Some {value: predicate} = move expression {
      let mut dependencies = List<Dependency>.make()
      let span = run staticSpan(&mut self.resolver, module, predicate)
      let evaluated = run staticExpression(&mut self.resolver, &mut self.query, &mut dependencies,
        module, Option<usize>.some(ordinal), predicate,
        StaticRootExpectation.Resolved {ty: run primitiveType(b"bool"), mismatchCode: RejectionCode.InvalidParameterSchema}, &[], &[])
      let value = match move evaluated {
        Result<Shared<StaticData>, Shared<Rejection>>.Success {value} => move value
        Result<Shared<StaticData>, Shared<Rejection>>.Failure {error} => {
          // A predicate that is not a `bool` names its parameter.
          if bareRejection(&error, RejectionCode.InvalidParameterSchema) {
            let name = run DeclarationId.copySpelling(identity)
            return Result<(), Shared<Rejection>>.failResult(run namedParameterRejection(RejectionCode.InvalidParameterSchema,
              module, rejectionSpan(&error), Bytes.asSlice(&name), b"the `where` predicate of package parameter `", b"` is not a `bool`"))
          }
          return Result<(), Shared<Rejection>>.failResult(move error)
        }
      }
      if !Shared<StaticData>.with<bool>(&value, fn(data: &StaticData) -> bool {
        return match &data.* { StaticData.Boolean {value: holds} => holds _ => false }
      }) {
        let mut diagnostic = run makeRejection(RejectionCode.ParameterValidationFailed, module, span)
        let mut message = run Bytes.copy(b"the bound value of package parameter `")
        let name = run DeclarationId.copySpelling(identity)
        run Bytes.append(&mut message, Bytes.asSlice(&name))
        run Bytes.append(&mut message, b"` does not satisfy its `where` predicate")
        run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"message"), value: move message})
        return Result<(), Shared<Rejection>>.failResult(run Shared<Rejection>.make(move diagnostic))
      }
    }
    return Result<(), Shared<Rejection>>.succeed(())
  }
  /// Borrows the current request's profile, including its current value origins.
  pub fn profile<'a>(self: &'a Self) -> Option<&'a FinalProfile> {
    return selectedProfile(&self.resolver)
  }
  /// Selects a complete profile by structural content; equal values reuse the same query scope.
  pub effect fn reviseProfile(self: &mut Self, profile: Option<FinalProfile>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator | &mut Types {
    self.resolver.assemblyFacts = Option<InitialProfile>.none()
    let candidate = match move profile {
      Option<FinalProfile>.Some {value} => move value
      Option<FinalProfile>.None => {
        self.resolver.profileSlot = usize.ZERO
        self.resolver.target = self.resolver.baseTarget
        return ()
      }
    }
    let selectedTarget = FinalProfile.target(&candidate)
    if run sameStoredProfile(&self.resolver, &candidate, usize.ONE) {
      self.resolver.initialProfile = Option<FinalProfile>.some(move candidate)
      self.resolver.profileSlot = usize.ONE
      self.resolver.target = selectedTarget
      return ()
    }
    let mut at = usize.ZERO
    while at < List<FinalProfile>.length(&self.resolver.profiles) {
      if run sameStoredProfile(&self.resolver, &candidate, at + 2) {
        let mut current = List<FinalProfile>.asMutSlice(&mut self.resolver.profiles)
        current[at] = move candidate
        self.resolver.profileSlot = at + 2
        self.resolver.target = selectedTarget
        return ()
      }
      at = at + usize.ONE
    }
    let slot = List<FinalProfile>.length(&self.resolver.profiles) + 2
    run List<FinalProfile>.append(&mut self.resolver.profiles, move candidate)
    self.resolver.profileSlot = slot
    self.resolver.target = selectedTarget
    return ()
  }
  /// Borrows the semantic query lifecycle events in demand order; empty unless the store is traced.
  pub fn eventLog(self: &Self) -> &[Event] {
    return List<Event>.asSlice(&self.resolver.events)
  }
  /// Starts or stops recording query lifecycle events, and forgets those already recorded.
  pub fn trace(self: &mut Self, on: bool) -> () {
    self.resolver.tracing = on
    List<Event>.truncate(&mut self.resolver.events, usize.ZERO)
    List<StaleCause>.truncate(&mut self.resolver.staleCauses, usize.ZERO)
  }
  /// Why each outdated unit a traced store reran failed verification, in order.
  pub fn staleCauses(self: &Self) -> &[StaleCause] {
    return List<StaleCause>.asSlice(&self.resolver.staleCauses)
  }
  /// A dependee as a traced replay reports it: a unit's name, or a source input's module and selector.
  pub effect fn dependeeName(self: &mut Self, dependee: Dependee) -> Bytes ! Cycle | OutOfMemoryError ? &mut Allocator {
    return match &dependee {
      Dependee.UnitResult {unit} => run Semantic.unitName(&mut self.*, unit)
      Dependee.SourceFile {module} => {
        let mut name = run Bytes.copy(b"file ")
        run ModuleId.appendPath(&resolvedModule(&self.resolver, module), &mut name)
        return move name
      }
      Dependee.SourceInput {input, module} => {
        let mut name = run Bytes.copy(b"input ")
        run ModuleId.appendPath(&resolvedModule(&self.resolver, module), &mut name)
        run Bytes.append(&mut name, b" ")
        let listed = List<Inputs.Input>.asSlice(&self.resolver.sourceInputs.inputs)
        run Bytes.append(&mut name, Inputs.selectorName(&listed[input].selector))
        return move name
      }
    }
  }
  /// A unit's family and, for a declaration family, the declaration's name: `Body foo.bar`.
  pub effect fn unitName(self: &mut Self, unit: usize) -> Bytes ! Cycle | OutOfMemoryError ? &mut Allocator {
    let selected = List<ScopedKey>.get(&self.resolver.keys, unit).key
    let mut name = run Bytes.copy(familyZone(selected.family))
    let subject = run zoneSubject(&mut self.resolver, selected)
    if Bytes.length(&subject) > usize.ZERO {
      run Bytes.append(&mut name, b" ")
      run Bytes.append(&mut name, Bytes.asSlice(&subject))
    }
    return move name
  }
  /// Borrows the source index provider starts, source reads and completions in demand order.
  pub fn sourceEvents(self: &Self) -> &[SourceEvent] {
    return SourceIndex.eventLog(&self.resolver.source)
  }
  /// The stable bytes of every current unit whose key has a stable form, in unit order: what a
  /// cache written to disk names a unit by, equal in every store that holds the same unit.
  pub effect fn stableUnits(self: &Self) -> List<Bytes> ! OutOfMemoryError ? &mut Allocator {
    let mut encoded = List<Bytes>.make()
    let mut unit = usize.ZERO
    while unit < List<ScopedKey>.length(&self.resolver.keys) {
      if Graph.state(&self.resolver.graph, unit) == UnitState.UpToDate {
        if let Option<Bytes>.Some {value} = move run stableUnit(&self.resolver, unit) {
          run List<Bytes>.append(&mut encoded, move value)
        }
      }
      unit = unit + usize.ONE
    }
    return move encoded
  }
  /// The stable bytes of every source input this store captured, in capture order.
  pub effect fn stableInputs(self: &Self) -> List<Bytes> ! OutOfMemoryError ? &mut Allocator {
    let mut encoded = List<Bytes>.make()
    let mut input = usize.ZERO
    while input < List<Inputs.Input>.length(&self.resolver.sourceInputs.inputs) {
      if let Option<Bytes>.Some {value} = move run stableInput(&self.resolver, input) {
        run List<Bytes>.append(&mut encoded, move value)
      }
      input = input + usize.ONE
    }
    return move encoded
  }
  /// The source input of this store that stable bytes from [`stableInputs`] name, possibly written
  /// by another store, or `usize.MAX` when this store has not captured it.
  pub effect fn findStableInput(self: &mut Self, bytes: &[u8]) -> usize ! Cycle | OutOfMemoryError ? &mut Allocator {
    return match move run placeStableInput(&mut self.resolver, bytes, false, usize.MAX) {
      Option<PlacedInput>.Some {value} => Inputs.find(&self.resolver.sourceInputs, value.module, &value.selector)
      Option<PlacedInput>.None => usize.MAX
    }
  }
  /// Reuses what a cache image from an earlier process still holds. Each leaf is compared with the
  /// current sources, and each node whose leaves all read the same becomes a unit of this store,
  /// current, with the same edges, so a later revision invalidates it as it would a unit this store
  /// ran. Each root resting on such a node becomes its module check's memo, so checking that
  /// module verifies it instead of sweeping it again.
  ///
  /// # Details
  /// An adopted node has no answer and cannot rerun: when an edit makes one outdated, the module
  /// check resting on it sweeps again. Call this once, on a fresh store, after its request and
  /// profile are selected, since a root is reused only when its key under them is the key it was
  /// written with.
  ///
  /// A store that is never revised passes `linked` false: its reused checks then rest on nothing,
  /// and no node becomes a unit, which spares recording the image's edges again.
  pub effect fn adoptCache(self: &mut Self, request: &Request, image: &CacheImage.Image, linked: bool) -> Adopted
    ! Cycle | OutOfMemoryError ? &mut Allocator | &mut Types {
    run selectRequest(&mut self.resolver, request)
    run reconcileSources(&mut self.resolver)
    let mut adopted = Adopted {roots: usize.ZERO, stale: usize.ZERO, nodes: usize.ZERO, changedLeaves: usize.ZERO}
    let leaves = List<CacheImage.Leaf>.asSlice(&image.leaves)
    let mut placed = List<usize>.make()
    // Files first: an input read from a file that reads as the image recorded is unchanged too.
    // Another leaf of the same module can record other bytes: a carried input names the file it
    // was read from, which an edit since can have changed.
    let mut at = usize.ZERO
    while at < leaves.length {
      let mut dependee = usize.MAX
      if !leaves[at].input { dependee = run placeLeaf(&mut self.resolver, &leaves[at], usize.MAX) }
      run List<usize>.append(&mut placed, dependee)
      at = at + usize.ONE
    }
    at = usize.ZERO
    while at < leaves.length {
      if leaves[at].input {
        let file = leaves[at].file
        let mut fileModule = usize.MAX
        if file != usize.MAX { fileModule = List<usize>.get(&placed, file) }
        List<usize>.set(&mut placed, at, run placeLeaf(&mut self.resolver, &leaves[at], fileModule))
      }
      if List<usize>.get(&placed, at) == usize.MAX {
        adopted.changedLeaves = adopted.changedLeaves + usize.ONE
      }
      at = at + usize.ONE
    }
    let mut units = List<usize>.make()
    // Whether a node reads the same once positions are set aside: every leaf it reaches reads as
    // the image recorded, or records only where a span sits (`positionalLeaf`).
    let mut settled = List<bool>.make()
    let nodes = CacheImage.nodeCount(image)
    at = usize.ZERO
    while at < nodes {
      let edges = CacheImage.edgesOf(image, at)
      let mut green = true
      let mut still = true
      let mut edge = usize.ZERO
      while edge < edges.length && still {
        let named = CacheImage.target(edges[edge])
        if CacheImage.namesNode(edges[edge]) {
          green = green && List<usize>.get(&units, named) != usize.MAX
          still = List<bool>.get(&settled, named)
        } else if List<usize>.get(&placed, named) == usize.MAX {
          green = false
          still = run positionalLeaf(&leaves[named])
        }
        edge = edge + usize.ONE
      }
      run List<bool>.append(&mut settled, still)
      let mut unit = usize.MAX
      if green && !linked {
        // Any value but `usize.MAX` marks the node green.
        unit = at
      } else if green {
        let word = run internKey(&mut self.resolver, Key {family: Family.ModuleCheck, module: usize.ZERO, name: 2,
          declaration: usize.MAX, member: at, external: false})
        unit = u64.toUsize(word.value)
        run Graph.startRun(&mut self.resolver.graph, unit)
        edge = usize.ZERO
        while edge < edges.length {
          let named = CacheImage.target(edges[edge])
          if CacheImage.namesNode(edges[edge]) {
            run Graph.record(&mut self.resolver.graph, unit, Dependee.UnitResult {unit: List<usize>.get(&units, named)})
          } else if leaves[named].input {
            let input = List<usize>.get(&placed, named)
            let module = List<Inputs.Input>.asSlice(&self.resolver.sourceInputs.inputs)[input].module
            run Graph.record(&mut self.resolver.graph, unit, Dependee.SourceInput {input: input, module: module})
          } else {
            run Graph.record(&mut self.resolver.graph, unit, Dependee.SourceFile {module: List<usize>.get(&placed, named)})
          }
          edge = edge + usize.ONE
        }
        drop run Graph.finishRun(&mut self.resolver.graph, unit, Option<ContentHash>.none())
        adopted.nodes = adopted.nodes + usize.ONE
      }
      run List<usize>.append(&mut units, unit)
      at = at + usize.ONE
    }
    let roots = List<CacheImage.Root>.asSlice(&image.roots)
    // The build record and the definitions of a build walk sit beside the checks; a build
    // replays them (`replayBuild`).
    let mut recordRoot = usize.MAX
    let mut greenDefinitions = List<usize>.make()
    let mut packRoots = List<usize>.make()
    self.resolver.packs = List<HeldPack>.make()
    // Escape walk records sit beside them too; a check replays them (`replayEscapes`). A linked
    // store sees later revisions, which the image's green nodes do not describe.
    self.escapeImage = EscapeImage.make()
    at = usize.ZERO
    while at < roots.length {
      let root = &roots[at]
      at = at + usize.ONE
      let node = List<usize>.get(&units, root.node)
      let mut exact = Span.make(usize.ZERO, usize.ZERO)
      let kind = buildRootKind(Bytes.asSlice(&root.key), &mut exact)
      if kind == 1 {
        if node != usize.MAX { recordRoot = at - usize.ONE }
        continue
      }
      // A definition's text holds no position: its MIR counts origins from its declaration's
      // anchor, and the site labels of an observing program, which count lines from the start of
      // the file, rest on the whole file. So an unlinked store reuses a definition when only where
      // its declaration sits moved, as when a line is inserted above it.
      if kind == 2 {
        if node != usize.MAX || (!linked && List<bool>.get(&settled, root.node)) {
          run List<usize>.append(&mut greenDefinitions, at - usize.ONE)
        }
        continue
      }
      // A pack's text is held only with the body the cache offered for it.
      if kind == 5 {
        if node != usize.MAX {
          run List<usize>.append(&mut packRoots, at - usize.ONE)
          if !linked && self.resolver.packing { run Semantic.holdPack(&mut self.*, at - usize.ONE, Bytes.asSlice(&root.answer)) }
        }
        continue
      }
      // An escape record and its entries hold no position either: an entry keeps its summary's
      // digest and the exact keys it reaches, and a replay finds every site from the anchors of
      // the source it reads now.
      if kind == 3 || kind == 4 {
        if (node != usize.MAX || List<bool>.get(&settled, root.node)) && !linked {
          let named = StableKey.view(Bytes.asSlice(&root.key), exact)
          if kind == 3 {
            run List<EscapeRecordRoot>.append(&mut self.escapeImage.records, EscapeRecordRoot {unit: run Bytes.copy(named),
              root: at - usize.ONE, answer: run Bytes.copy(Bytes.asSlice(&root.answer))})
          } else if run DigestSet.add(&mut self.escapeImage.entries, digestOfBytes(named)) {
            run List<usize>.append(&mut self.escapeImage.roots, at - usize.ONE)
          }
        }
        continue
      }
      let key = run readCheckKey(Bytes.asSlice(&root.key))
      let answer = run readCheckAnswer(Bytes.asSlice(&root.answer))
      let mut reused = false
      // A check root holds no position but the spans it reports, which rest on the whole files
      // they point into (`sitedNode`). So an unlinked store reuses it when only where other spans
      // sit moved, as when a line is inserted above it. A linked store needs each node current.
      let positioned = !linked && List<bool>.get(&settled, root.node)
      if let Option<CheckKey>.Some {value: check} = move key {
        if let Option<CheckAnswer>.Some {value: kept} = move answer {
          if node != usize.MAX || positioned {
            let mut resting = node
            if !linked { resting = usize.MAX }
            reused = run Semantic.adoptCheck(&mut self.*, resting, Bytes.asSlice(&root.key), move check, move kept)
          }
        }
      }
      if reused {
        adopted.roots = adopted.roots + usize.ONE
        if !linked { run List<usize>.append(&mut self.carriedRoots, at - usize.ONE) }
      } else { adopted.stale = adopted.stale + usize.ONE }
    }
    self.replay = Option<ReplayState>.none()
    if recordRoot != usize.MAX {
      self.replay = run ReplayState.read(image, recordRoot, List<usize>.asSlice(&greenDefinitions),
        List<HeldPack>.asSlice(&self.resolver.packs), move packRoots)
    }
    return move adopted
  }

  // Holds the pack the image root at `root` describes with the body offered for it, when one was.
  effect fn holdPack(self: &mut Self, root: usize, answer: &[u8]) -> () ! OutOfMemoryError ? &mut Allocator {
    let pack = match move run BuildRecord.decodePack(answer) {
      Option<BuildRecord.Pack>.Some {value} => move value
      Option<BuildRecord.Pack>.None => { return () }
    }
    let members = List<BuildRecord.Member>.asSlice(&pack.members)
    let mut end = usize.ZERO
    if members.length > usize.ZERO { end = members[members.length - usize.ONE].offset + members[members.length - usize.ONE].length }
    let offered = List<BuildRecord.PackBody>.asSlice(&self.resolver.offeredBodies)
    let mut at = usize.ZERO
    while at < offered.length {
      if ContentHash.equals(offered[at].digest, pack.digest) && Bytes.length(&offered[at].bytes) >= end {
        let taken = List<BuildRecord.PackBody>.remove(&mut self.resolver.offeredBodies, at)
        run List<HeldPack>.append(&mut self.resolver.packs, HeldPack {root: root, pack: move pack, body: move taken.bytes})
        return ()
      }
      at = at + usize.ONE
    }
  }

  // Makes one root's module check current, resting on its adopted node unless that is
  // `usize.MAX`, with the memo its answer holds; false when this store names that check by
  // another key, or already holds its memo.
  effect fn adoptCheck(self: &mut Self, node: usize, written: &[u8], check: CheckKey, kept: CheckAnswer) -> bool
    ! OutOfMemoryError ? &mut Allocator {
    let module = run internModule(&mut self.resolver, &check.module)
    let word = run internKey(&mut self.resolver, Key {family: Family.ModuleCheck, module: module, name: check.name,
      declaration: usize.MAX, member: check.member, external: false})
    let unit = u64.toUsize(word.value)
    let same = match move run stableUnit(&self.resolver, unit) {
      Option<Bytes>.Some {value} => same(Bytes.asSlice(&value), written)
      Option<Bytes>.None => false
    }
    if !same || Graph.state(&self.resolver.graph, unit) != UnitState.Absent { return false }
    run Graph.startRun(&mut self.resolver.graph, unit)
    if node != usize.MAX { run Graph.record(&mut self.resolver.graph, unit, Dependee.UnitResult {unit: node}) }
    else { run List<usize>.append(&mut self.carriedUnits, unit) }
    drop run Graph.finishRun(&mut self.resolver.graph, unit, Option<ContentHash>.none())
    let CheckAnswer {kind, concrete, rejections} = move kept
    if kind > 1 {
      let mut named = move concrete
      run Semantic.keepDeclaration(&mut self.*, unit, List<DeclarationId>.remove(&mut named, usize.ZERO), kind == 3, node == usize.MAX)
    } else if kind == 1 {
      run List<EscapeMemo>.append(&mut self.escapeMemos, EscapeMemo {unit: unit, concrete: move concrete,
        result: DeclarationCheckResult {rejections: move rejections, gaps: List<Shared<BackendGap>>.make(),
          unchecked: List<UncheckedDeclaration>.make()}, captured: Option<CapturedBuild>.none(), reads: usize.MAX})
    } else {
      let mut sweep = Sweep.make()
      sweep.concrete = move concrete
      sweep.rejections = move rejections
      run List<ModuleCheckMemo>.append(&mut self.moduleMemos, ModuleCheckMemo {unit: unit, sweep: move sweep,
        deferred: List<DeferredStaticTemplate>.make(), unchecked: List<UncheckedBody>.make()})
    }
    return true
  }
  /// What decides this store's answers besides its sources, for a cache stamp: the target and,
  /// when one is selected, the profile's identity.
  pub effect fn stampIdentity(self: &Self) -> Bytes ! OutOfMemoryError ? &mut Allocator {
    let mut output = Bytes.make()
    run RuntimeEncoding.field(&mut output, MachineTarget.name(&self.resolver.target))
    if let Option<&FinalProfile>.Some {value} = move selectedProfile(&self.resolver) {
      run RuntimeEncoding.field(&mut output, b"profile")
      run FinalProfile.appendIdentity(value, &mut output)
    } else {
      run RuntimeEncoding.field(&mut output, b"no-profile")
    }
    return move output
  }
  /// The image of this store's module checks for a cache on disk: each current module sweep and
  /// escape check, as a root, with every unit and source read it rests on and the rejections it
  /// reports, which also rest on the files their spans point into. A check that left a gap or an
  /// unchecked body, or reported what an image does not carry (`RejectionImage.encode`), is left
  /// out and runs again in the next process. So is a check an unlinked `adoptCache` reused: it
  /// rests on nothing here, and its image carries it (`CacheImage.carry` with `Adopted.carried`).
  pub effect fn cacheImage(self: &mut Self) -> CacheImage.Image ! Cycle | OutOfMemoryError ? &mut Allocator {
    // Input digests and the file digests beside them must describe the same bytes.
    run reconcileSources(&mut self.resolver)
    let mut build = ImageBuild {image: CacheImage.make(), nodes: List<usize>.make(), files: List<usize>.make(),
      inputs: List<usize>.make(), fileModules: List<usize>.make()}
    // A reused check rests on nothing here, so a check resting on it waits for its carried node.
    let reused = List<usize>.asSlice(&self.carriedUnits)
    let mut at = usize.ZERO
    while at < reused.length {
      run slotFor(&mut build.nodes, reused[at])
      List<usize>.set(&mut build.nodes, reused[at], unfit())
      at = at + usize.ONE
    }
    let mut pending = List<PendingCheck>.make()
    let sweeps = List<ModuleCheckMemo>.asSlice(&self.moduleMemos)
    at = usize.ZERO
    while at < sweeps.length {
      let memo = &sweeps[at]
      at = at + usize.ONE
      if List<Shared<BackendGap>>.length(&memo.sweep.gaps) > usize.ZERO
        || List<UncheckedDeclaration>.length(&memo.sweep.unchecked) > usize.ZERO
        || List<DeferredStaticTemplate>.length(&memo.deferred) > usize.ZERO
        || List<UncheckedBody>.length(&memo.unchecked) > usize.ZERO
        || holdsUnit(List<usize>.asSlice(&self.carriedUnits), memo.unit) {
        continue
      }
      let mut sites = List<ModuleId>.make()
      let answer = match move run reportingAnswer(0, List<DeclarationId>.asSlice(&memo.sweep.concrete),
        List<Shared<Rejection>>.asSlice(&memo.sweep.rejections), &mut sites) {
        Option<Bytes>.Some {value} => move value
        Option<Bytes>.None => { continue }
      }
      if let Option<Bytes>.Some {value} = move run imageRoot(&self.resolver, &mut build, memo.unit, move answer, List<ModuleId>.asSlice(&sites)) {
        run List<PendingCheck>.append(&mut pending, PendingCheck {unit: memo.unit, answer: move value, sites: move sites})
      }
    }
    let declarations = List<DeclarationMemo>.asSlice(&self.declarationMemos)
    at = usize.ZERO
    while at < declarations.length {
      let memo = &declarations[at]
      at = at + usize.ONE
      if memo.unit == usize.MAX || memo.carried { continue }
      let mut kind: u64 = 2
      if memo.concrete { kind = 3 }
      let mut named = List<DeclarationId>.make()
      run List<DeclarationId>.append(&mut named, DeclarationId.copy(&memo.identity))
      let answer = run checkAnswer(kind, List<DeclarationId>.asSlice(&named))
      if let Option<Bytes>.Some {value} = move run imageRoot(&self.resolver, &mut build, memo.unit, move answer, &[]) {
        run List<PendingCheck>.append(&mut pending, PendingCheck {unit: memo.unit, answer: move value, sites: List<ModuleId>.make()})
      }
    }
    let escapes = List<EscapeMemo>.asSlice(&self.escapeMemos)
    let mut reports = List<ReplayReport>.make()
    at = usize.ZERO
    while at < escapes.length {
      let memo = &escapes[at]
      at = at + usize.ONE
      // A replay ran no unit of its own; its root rests on the image's record and entries
      // (`imageReplayedChecks`), and when it reports, on what it demanded as well.
      if memo.reads != usize.MAX {
        if List<Shared<Rejection>>.length(&memo.result.rejections) == usize.ZERO
          || List<Shared<BackendGap>>.length(&memo.result.gaps) > usize.ZERO
          || List<UncheckedDeclaration>.length(&memo.result.unchecked) > usize.ZERO {
          continue
        }
        let mut sites = List<ModuleId>.make()
        let answer = match move run reportingAnswer(1, List<DeclarationId>.asSlice(&memo.concrete),
          List<Shared<Rejection>>.asSlice(&memo.result.rejections), &mut sites) {
          Option<Bytes>.Some {value} => move value
          Option<Bytes>.None => { continue }
        }
        let readsNode = run imageUnit(&self.resolver, &mut build, memo.reads)
        if readsNode >= unfit() { continue }
        let node = run sitedNode(&self.resolver, &mut build, readsNode, List<ModuleId>.asSlice(&sites))
        if node == usize.MAX { continue }
        run List<ReplayReport>.append(&mut reports, ReplayReport {unit: memo.unit, node: node, answer: move answer})
        continue
      }
      if List<Shared<BackendGap>>.length(&memo.result.gaps) > usize.ZERO
        || List<UncheckedDeclaration>.length(&memo.result.unchecked) > usize.ZERO
        || holdsUnit(List<usize>.asSlice(&self.carriedUnits), memo.unit) {
        continue
      }
      let mut sites = List<ModuleId>.make()
      let answer = match move run reportingAnswer(1, List<DeclarationId>.asSlice(&memo.concrete),
        List<Shared<Rejection>>.asSlice(&memo.result.rejections), &mut sites) {
        Option<Bytes>.Some {value} => move value
        Option<Bytes>.None => { continue }
      }
      if let Option<Bytes>.Some {value} = move run imageRoot(&self.resolver, &mut build, memo.unit, move answer, List<ModuleId>.asSlice(&sites)) {
        run List<PendingCheck>.append(&mut pending, PendingCheck {unit: memo.unit, answer: move value, sites: move sites})
      }
    }
    self.replayReports = move reports
    // The last build's record and each definition it lowered, on the units it rests on. The
    // definitions a replay took from the image this store read, and a record no build here
    // replaced, stay in that image, which the written one carries them from.
    self.carriedBuild = List<usize>.make()
    if let Option<CapturedBuild>.Some {value: captured} = &self.capturedBuild {
      let entries = List<CapturedEntry>.asSlice(&captured.entries)
      let recorded = List<BuildRecord.Entry>.asSlice(&captured.record.entries)
      at = usize.ZERO
      while at < entries.length {
        let entry = &entries[at]
        let exact = recorded[at].exact
        at = at + usize.ONE
        if entry.carried != usize.MAX {
          run List<usize>.append(&mut self.carriedBuild, entry.carried)
          continue
        }
        if recorded[at - usize.ONE].alias != usize.MAX { continue }
        // An instance that emits no definition still names its references: its root rests on its
        // MIR alone and holds no answer.
        let mirNode = run imageUnit(&self.resolver, &mut build, entry.mirUnit)
        if mirNode >= unfit() { continue }
        let mut node = usize.MAX
        let mut answer = Bytes.make()
        if entry.value == usize.MAX {
          node = run CacheImage.addNode(&mut build.image, &[CacheImage.nodeEdge(mirNode)])
        } else {
          // A definition also rests on every layout its text was emitted against, which its MIR
          // need not read: a generic body indexes or views its element at the element's stride.
          let mut edges = List<usize>.make()
          run List<usize>.append(&mut edges, CacheImage.nodeEdge(mirNode))
          if !run emittedLayoutEdges(&self.resolver, &mut build, entry.emissionUnit, &mut edges) { continue }
          node = run CacheImage.addNode(&mut build.image, List<usize>.asSlice(&edges))
          let values = List<InstanceDefinition>.asSlice(&self.resolver.llvmValues)
          answer = run BuildRecord.encodeDefinition(&values[entry.value])
        }
        run List<CacheImage.Root>.append(&mut build.image.roots, CacheImage.Root {key: run buildEntryKey(exact), node: node,
          answer: move answer})
      }
      // Each pack the build assembled rests on nothing: a replay holds it only for the definitions
      // it lists, each of which rests on its own units. A pack the build reused is carried.
      let fresh = List<BuildRecord.Pack>.asSlice(&self.packedBuild.fresh)
      at = usize.ZERO
      while at < fresh.length {
        let node = run CacheImage.addNode(&mut build.image, &[])
        run List<CacheImage.Root>.append(&mut build.image.roots, CacheImage.Root {key: run buildPackKey(fresh[at].digest), node: node,
          answer: run BuildRecord.encodePack(&fresh[at])})
        at = at + usize.ONE
      }
      let kept = List<usize>.asSlice(&self.packedBuild.kept)
      at = usize.ZERO
      while at < kept.length {
        run List<usize>.append(&mut self.carriedBuild, kept[at])
        at = at + usize.ONE
      }
      // A replayed record is the one the image read holds, on the guard reads that image recorded.
      if captured.carriedRecord != usize.MAX {
        run List<usize>.append(&mut self.carriedBuild, captured.carriedRecord)
      } else {
        let mut node = usize.MAX
        if captured.guard == usize.MAX {
          node = run CacheImage.addNode(&mut build.image, &[])
        } else {
          let guardNode = run imageUnit(&self.resolver, &mut build, captured.guard)
          if guardNode < unfit() { node = run CacheImage.addNode(&mut build.image, &[CacheImage.nodeEdge(guardNode)]) }
        }
        if node != usize.MAX {
          run List<CacheImage.Root>.append(&mut build.image.roots, CacheImage.Root {key: run buildRecordKey(), node: node,
            answer: run BuildRecord.encode(&captured.record)})
        }
      }
    } else if let Option<ReplayState>.Some {value: replay} = &self.replay {
      run List<usize>.append(&mut self.carriedBuild, replay.recordRoot)
      let held = List<usize>.asSlice(&replay.roots)
      at = usize.ZERO
      while at < held.length {
        if held[at] != usize.MAX { run List<usize>.append(&mut self.carriedBuild, held[at]) }
        at = at + usize.ONE
      }
      let packRoots = List<usize>.asSlice(&replay.packRoots)
      at = usize.ZERO
      while at < packRoots.length {
        run List<usize>.append(&mut self.carriedBuild, packRoots[at])
        at = at + usize.ONE
      }
    }
    run Semantic.imageEscapes(&mut self.*, &mut build)
    run Semantic.fileDigests(&mut self.*, &mut build, usize.ZERO)
    let ImageBuild {image, nodes, files, inputs, fileModules} = move build
    self.pendingImage = Option<PendingImage>.some(PendingImage {nodes: move nodes, files: move files, inputs: move inputs,
      fileModules: move fileModules, checks: move pending})
    return move image
  }
  // Fills the digest of each file leaf from the `from`th on with the bytes its module holds now,
  // read once the walk is done.
  effect fn fileDigests(self: &mut Self, build: &mut ImageBuild, from: usize) -> () ! Cycle | OutOfMemoryError ? &mut Allocator {
    let files = List<usize>.length(&build.fileModules)
    let mut file = from
    while file < files {
      let module = resolvedModule(&self.resolver, List<usize>.get(&build.fileModules, file))
      let leaf = List<usize>.get(&build.files, List<usize>.get(&build.fileModules, file))
      let digest = run sourceDigest(&mut self.resolver, &module)
      let mut leaves = List<CacheImage.Leaf>.asMutSlice(&mut build.image.leaves)
      leaves[leaf].digest = digest
      file = file + usize.ONE
    }
  }
  /// Adds to `image`, once `CacheImage.carry` has copied into it what this store reused and given
  /// `nodes`, the node of each check in `carried` order, the checks `cacheImage` could not write
  /// because they rest on a reused check: such a check rests on that check's carried node, so a
  /// module swept again after an edit keeps its root although it reused its other declarations.
  pub effect fn imageCarriedChecks(self: &mut Self, image: &mut CacheImage.Image, nodes: &[usize]) -> ()
    ! Cycle | OutOfMemoryError ? &mut Allocator {
    let held = match move Intrinsic.replace(self.pendingImage, Option<PendingImage>.none()) {
      Option<PendingImage>.Some {value} => move value
      Option<PendingImage>.None => { return () }
    }
    let PendingImage {nodes: built, files, inputs, fileModules, checks} = move held
    let mut build = ImageBuild {image: Intrinsic.replace(image.*, CacheImage.make()), nodes: move built, files: move files,
      inputs: move inputs, fileModules: move fileModules}
    // A unit unfit only for a reused check it reached is looked at again.
    let mut slots = List<usize>.asMutSlice(&mut build.nodes)
    let mut at = usize.ZERO
    while at < slots.length {
      if slots[at] == unfit() { slots[at] = unreached() }
      at = at + usize.ONE
    }
    let reused = List<usize>.asSlice(&self.carriedUnits)
    at = usize.ZERO
    while at < reused.length {
      run slotFor(&mut build.nodes, reused[at])
      let mut node = unfit()
      if at < nodes.length { node = nodes[at] }
      List<usize>.set(&mut build.nodes, reused[at], node)
      at = at + usize.ONE
    }
    let filled = List<usize>.length(&build.fileModules)
    let mut waiting = move checks
    while let Option<PendingCheck>.Some {value: check} = move List<PendingCheck>.pop(&mut waiting) {
      drop run imageRoot(&self.resolver, &mut build, check.unit, move check.answer, List<ModuleId>.asSlice(&check.sites))
    }
    run Semantic.fileDigests(&mut self.*, &mut build, filled)
    image.* = move build.image
  }
  /// Adds to `image`, once `CacheImage.carry` has copied into it what this store reused, the root of
  /// each escape check a replay made current (`replayEscapes`). The root rests on the walk's record
  /// and on the root of every entry the record names, so it stays green while a replay would
  /// agree again, and the next check takes it without replaying. The root of a replay that reports
  /// rests instead on the root of each entry the replay entered or kept, and on what it demanded
  /// and the files its reports point into, which `cacheImage` wrote: a broken body that lowers to
  /// nothing has no entry root, but its MIR is among what the replay demanded. A check whose
  /// record or entries `image` lacks is left out, and replays again.
  pub effect fn imageReplayedChecks(self: &Self, image: &mut CacheImage.Image) -> () ! OutOfMemoryError ? &mut Allocator {
    let memos = List<EscapeMemo>.asSlice(&self.escapeMemos)
    let reports = List<ReplayReport>.asSlice(&self.replayReports)
    let mut replayed = List<usize>.make()
    // The report each replayed check rests on, or `usize.MAX` for one that reports nothing.
    let mut reporting = List<usize>.make()
    let mut at = usize.ZERO
    while at < memos.length {
      let clean = List<Shared<Rejection>>.length(&memos[at].result.rejections) == usize.ZERO
        && List<Shared<BackendGap>>.length(&memos[at].result.gaps) == usize.ZERO
      let mut report = usize.MAX
      let mut listed = usize.ZERO
      while listed < reports.length && report == usize.MAX {
        if reports[listed].unit == memos[at].unit { report = listed }
        listed = listed + usize.ONE
      }
      if let Option<CapturedBuild>.Some {value: captured} = &memos[at].captured {
        if captured.carriedRecord != usize.MAX && (clean || report != usize.MAX) {
          run List<usize>.append(&mut replayed, at)
          run List<usize>.append(&mut reporting, report)
        }
      }
      at = at + usize.ONE
    }
    if List<usize>.length(&replayed) == usize.ZERO { return () }
    // Each root key's first root, which the replayed checks' nodes name.
    let mut keys = ExactSet.make()
    let mut nodes = List<usize>.make()
    let roots = List<CacheImage.Root>.asSlice(&image.roots)
    at = usize.ZERO
    while at < roots.length {
      if run ExactSet.add(&mut keys, Bytes.asSlice(&roots[at].key)) { run List<usize>.append(&mut nodes, roots[at].node) }
      at = at + usize.ONE
    }
    let picked = List<usize>.asSlice(&replayed)
    at = usize.ZERO
    while at < picked.length {
      let memo = &memos[picked[at]]
      let report = List<usize>.get(&reporting, at)
      at = at + usize.ONE
      let stable = match move run stableUnit(&self.resolver, memo.unit) {
        Option<Bytes>.Some {value} => move value
        Option<Bytes>.None => { continue }
      }
      if let Option<CapturedBuild>.Some {value: captured} = &memo.captured {
        let mut edges = List<usize>.make()
        let record = ExactSet.find(&keys, Bytes.asSlice(&run escapeRecordKey(Bytes.asSlice(&stable))))
        if record == usize.MAX { continue }
        run List<usize>.append(&mut edges, CacheImage.nodeEdge(List<usize>.get(&nodes, record)))
        if report != usize.MAX { run List<usize>.append(&mut edges, CacheImage.nodeEdge(reports[report].node)) }
        let entries = List<BuildRecord.Entry>.asSlice(&captured.record.entries)
        let rested = List<CapturedEntry>.asSlice(&captured.entries)
        let mut whole = true
        let mut entry = usize.ZERO
        while entry < entries.length && whole {
          // A replay that reports leaves out an entry it neither entered nor kept: one below a
          // broken body, which what it demanded decides.
          let used = report == usize.MAX || rested[entry].mirUnit != usize.MAX || rested[entry].carried != usize.MAX
          if entries[entry].leaf == 0 && used {
            let found = ExactSet.find(&keys, Bytes.asSlice(&run escapeEntryKey(entries[entry].exact)))
            if found == usize.MAX { whole = false } else { run List<usize>.append(&mut edges, CacheImage.nodeEdge(List<usize>.get(&nodes, found))) }
          }
          entry = entry + usize.ONE
        }
        if !whole { continue }
        let node = run CacheImage.addNode(&mut image.*, List<usize>.asSlice(&edges))
        let mut answer = Bytes.make()
        if report != usize.MAX { answer = run Bytes.copy(Bytes.asSlice(&reports[report].answer)) }
        else { answer = run checkAnswer(1, List<DeclarationId>.asSlice(&memo.concrete)) }
        run List<CacheImage.Root>.append(&mut image.roots, CacheImage.Root {key: move stable, node: node, answer: move answer})
      }
    }
  }
  /// Points each input `image` carries at its module's file as it reads now, once `CacheImage.carry`
  /// has copied into it what this store reused. A carried input names the file leaf of the image it
  /// came from. When that file changed since and this store holds the input with the same digest,
  /// the input takes its declaration's position now and the file leaf of the bytes now, so the next
  /// adoption places it without indexing the module again. Otherwise it keeps its old file, which
  /// no longer reads the same, and the next adoption captures it again.
  pub effect fn imageCarriedFiles(self: &mut Self, image: &mut CacheImage.Image) -> () ! Cycle | OutOfMemoryError ? &mut Allocator {
    // The leaf of each module's file as it reads now, by module ordinal, added when first needed.
    let mut current = List<usize>.make()
    let count = List<CacheImage.Leaf>.length(&image.leaves)
    // The same by the file leaf an input names, so an input of a module whose file reads as it did
    // is passed over without reading its key.
    let mut byFile = List<usize>.make()
    run List<usize>.appendRepeated(&mut byFile, unreached(), count)
    let mut at = usize.ZERO
    while at < count {
      let slot = at
      at = at + usize.ONE
      if !List<CacheImage.Leaf>.asSlice(&image.leaves)[slot].input { continue }
      let file = List<CacheImage.Leaf>.asSlice(&image.leaves)[slot].file
      if file != usize.MAX && file < count && List<usize>.get(&byFile, file) == file { continue }
      let key = run Bytes.copy(Bytes.asSlice(&List<CacheImage.Leaf>.asSlice(&image.leaves)[slot].key))
      let digest = List<CacheImage.Leaf>.asSlice(&image.leaves)[slot].digest
      let mut reader = StableKey.reader()
      let module = match move run StableKey.readModule(Bytes.asSlice(&key), &mut reader) {
        Option<ModuleId>.Some {value} => move value
        Option<ModuleId>.None => { continue }
      }
      let ordinal = run internModule(&mut self.resolver, &module)
      run slotFor(&mut current, ordinal)
      let mut now = List<usize>.get(&current, ordinal)
      if now == unreached() {
        let read = run sourceDigest(&mut self.resolver, &module)
        if file != usize.MAX && ContentHash.equals(List<CacheImage.Leaf>.asSlice(&image.leaves)[file].digest, read) {
          now = file
        } else {
          let mut fileKey = Bytes.make()
          run StableKey.module(&mut fileKey, &module)
          now = List<CacheImage.Leaf>.length(&image.leaves)
          run List<CacheImage.Leaf>.append(&mut image.leaves, CacheImage.Leaf {input: false, key: move fileKey, digest: read,
            position: usize.MAX, file: usize.MAX, text: ContentHash {high: 0, low: 0}})
        }
        List<usize>.set(&mut current, ordinal, now)
      }
      if file != usize.MAX && file < count { List<usize>.set(&mut byFile, file, now) }
      if file == now { continue }
      if file != usize.MAX && ContentHash.equals(List<CacheImage.Leaf>.asSlice(&image.leaves)[file].digest,
        List<CacheImage.Leaf>.asSlice(&image.leaves)[now].digest) { continue }
      let read = match move run StableKey.readSelector(Bytes.asSlice(&key), &mut reader) {
        Option<StableKey.ReadSelector>.Some {value} => move value
        Option<StableKey.ReadSelector>.None => { continue }
      }
      let StableKey.ReadSelector {selector, identity, ..} = move read
      let mut position = usize.MAX
      let mut handle = usize.MAX
      if let Option<DeclarationId>.Some {value: declared} = &identity {
        handle = DeclarationTable.find(&self.resolver.declarations, &declared)
        if handle == usize.MAX { continue }
        position = DeclarationTable.position(&self.resolver.declarations, handle)
        if position == usize.MAX { continue }
      }
      let mut held = move selector
      if handle != usize.MAX {
        let named = move held
        held = StableKey.withHandle(move named, handle)
      }
      let input = Inputs.find(&self.resolver.sourceInputs, ordinal, &held)
      if input == usize.MAX { continue }
      let mut leaves = List<CacheImage.Leaf>.asMutSlice(&mut image.leaves)
      // An input that reads otherwise now, such as where a declaration below an edit sits, is
      // marked changed, so the next adoption knows it without indexing the module again.
      if !ContentHash.equals(List<Inputs.Input>.asSlice(&self.resolver.sourceInputs.inputs)[input].digest, digest) {
        leaves[slot].digest = changedInput()
      }
      leaves[slot].file = now
      leaves[slot].position = position
    }
    run CacheImage.dropUnusedLeaves(&mut image.*)
  }
  // Writes each escape walk record a check here captured, with a root on the MIR of each entry a
  // walk here lowered. A record a replay took from the image this store read, each record no check
  // here replaced, and the green entries those records name that no walk here lowered stay in
  // that image, which the written one carries them from.
  effect fn imageEscapes(self: &mut Self, build: &mut ImageBuild) -> () ! Cycle | OutOfMemoryError ? &mut Allocator {
    let mut written = DigestSet.make()
    let mut named = DigestSet.make()
    let mut carried = List<usize>.make()
    let memos = List<EscapeMemo>.asSlice(&self.escapeMemos)
    let mut at = usize.ZERO
    while at < memos.length {
      let memo = &memos[at]
      at = at + usize.ONE
      if let Option<CapturedBuild>.Some {value: captured} = &memo.captured {
        if let Option<Bytes>.Some {value: unit} = move run stableUnit(&self.resolver, memo.unit) {
          run imageEscapeRecord(&self.resolver, &mut build.*, &captured, Bytes.asSlice(&unit), &mut written, &mut named, &mut carried)
        }
      }
    }
    let records = List<EscapeRecordRoot>.asSlice(&self.escapeImage.records)
    at = usize.ZERO
    while at < records.length {
      run List<usize>.append(&mut carried, records[at].root)
      if let Option<BuildRecord.Record>.Some {value: record} = move run BuildRecord.decode(Bytes.asSlice(&records[at].answer)) {
        let entries = List<BuildRecord.Entry>.asSlice(&record.entries)
        let mut entry = usize.ZERO
        while entry < entries.length {
          if entries[entry].leaf == 0 { drop run DigestSet.add(&mut named, entries[entry].exact) }
          entry = entry + usize.ONE
        }
      }
      at = at + usize.ONE
    }
    let green = List<ContentHash>.asSlice(&self.escapeImage.entries.values)
    at = usize.ZERO
    while at < green.length {
      let exact = green[at]
      if DigestSet.find(&named, exact) != usize.MAX && DigestSet.find(&written, exact) == usize.MAX {
        run List<usize>.append(&mut carried, List<usize>.get(&self.escapeImage.roots, at))
      }
      at = at + usize.ONE
    }
    let listed = List<usize>.asSlice(&carried)
    at = usize.ZERO
    while at < listed.length {
      run List<usize>.append(&mut self.carriedBuild, listed[at])
      at = at + usize.ONE
    }
  }
  /// How many emitted LLVM input subjects carry a content digest. A revisable store names every
  /// subject by its digest so a revision can re-find equal content; a one-shot store names none.
  pub fn digestedLlvmInputs(self: &Self) -> usize {
    let inputs = List<LlvmInput>.asSlice(&self.resolver.llvmInputs)
    let mut count = usize.ZERO
    let mut at = usize.ZERO
    while at < inputs.length {
      if let Option<ContentHash>.Some {..} = &inputs[at].digest {
        count = count + usize.ONE
      }
      at = at + usize.ONE
    }
    return count
  }
  /// The syntax errors of every source this store has loaded, as rejections in load order and
  /// then source order. A loaded module is parsed whole, so its syntax errors reject the program
  /// even where no declaration of it is demanded (MODULE-004).
  pub effect fn syntaxRejections(self: &Self) -> List<Shared<Rejection>> ! OutOfMemoryError ? &mut Allocator {
    let problems = run SourceIndex.syntaxProblems(&self.resolver.source)
    let listed = List<SyntaxProblem>.asSlice(&problems)
    let mut rejections = List<Shared<Rejection>>.make()
    let mut at = usize.ZERO
    while at < listed.length {
      let mut code = Rejection.causeCode(listed[at].code)
      if let DiagnosticDetail.Lexical {diagnostic} = listed[at].detail {
        code = Rejection.lexicalCode(LexicalDiagnostic.code(diagnostic))
      }
      run List<Shared<Rejection>>.append(&mut rejections, run syntaxRejection(&listed[at].module, code, listed[at].span, listed[at].detail,
        List<Bytes>.asSlice(&listed[at].holes)))
      at = at + usize.ONE
    }
    return move rejections
  }

  /// Checks every active declaration loaded from the root package, independently of emission
  /// reachability (MODULE-004). The source provider supplies the exact ownership list; imports
  /// still demand their normal semantic facts but do not enroll dependency modules in the sweep.
  /// Abstract templates retain their obligations until a complete application exists.
  pub effect fn checkDeclarations(
    self: &mut Self,
    request: &mut Request,
    rootPackage: &[ModuleId],
    runtime: &Option<ModuleId>,
  ) -> DeclarationCheckResult
    ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
    ? &mut Allocator | &mut Types {
    let zone = Profiler.zone(b"checkDeclarations")
    run selectRequest(&mut self.resolver, &request.*)
    self.deferredTemplates = List<DeferredStaticTemplate>.make()
    self.uncheckedRoot = List<UncheckedBody>.make()
    let mut modules = List<usize>.make()
    let mut rootAt = usize.ZERO
    while rootAt < rootPackage.length {
      run appendCheckedModule(&mut modules, run internModule(&mut self.resolver, &rootPackage[rootAt]))
      rootAt = rootAt + usize.ONE
    }
    if Graph.recording(&self.resolver.graph) {
      return run Semantic.checkEachModule(&mut self.*, &mut request.*, List<usize>.asSlice(&modules), runtime)
    }
    let mut sweep = Sweep.make()
    let mut moduleAt = usize.ZERO
    while moduleAt < List<usize>.length(&modules) {
      let moduleOrdinal = List<usize>.get(&modules, moduleAt)
      let module = resolvedModule(&self.resolver, moduleOrdinal)
      moduleAt = moduleAt + usize.ONE
      run Semantic.showProgress(&mut self.*, &module)
      run Semantic.sweepModule(&mut self.*, &mut request.*, &module, moduleOrdinal, &Option<DeclarationId>.none(), &mut sweep)
    }
    return run Semantic.finishSweep(&mut self.*, &mut request.*, List<usize>.asSlice(&modules), runtime, move sweep)
  }

  /// Selects whether `buildArtifact` also splits its module into codegen units
  /// (`BackendBuild.Module.units`), so the driver can compile and cache each unit's object apart.
  pub fn selectCodegenUnits(self: &mut Self, split: bool) -> () {
    self.resolver.codegenUnits = split
  }

  /// Selects whether emitted LLVM text is shaped for Clang's unoptimized `-O0` compile, whose fast
  /// instruction selector it then stays on. The cache keeps one image per profile, so text emitted
  /// under one choice is never adopted under the other.
  pub fn selectFastPathIr(self: &mut Self, unoptimized: bool) -> () {
    self.resolver.fastPathIr = unoptimized
  }

  /// Offers the pack bodies a cache keeps beside its image, before `adoptCache` reads the image,
  /// and has each assembled module split into packs (`BackendBuild.Module.units`) for the cache to
  /// store. A replay takes the text of a definition the image holds from its pack.
  pub fn offerPacks(self: &mut Self, bodies: List<BuildRecord.PackBody>) -> () {
    self.resolver.offeredBodies = move bodies
    self.resolver.packing = true
  }

  /// Takes back every pack body `offerPacks` gave, including those of the units a build left
  /// `stored`.
  pub effect fn takePacks(self: &mut Self) -> List<BuildRecord.PackBody> ! OutOfMemoryError ? &mut Allocator {
    let mut bodies = Intrinsic.replace(self.resolver.offeredBodies, List<BuildRecord.PackBody>.make())
    let mut held = Intrinsic.replace(self.resolver.packs, List<HeldPack>.make())
    while List<HeldPack>.length(&held) > usize.ZERO {
      let last = List<HeldPack>.length(&held) - usize.ONE
      let taken = List<HeldPack>.remove(&mut held, last)
      run List<BuildRecord.PackBody>.append(&mut bodies, BuildRecord.PackBody {digest: taken.pack.digest, bytes: move taken.body})
    }
    return move bodies
  }

  effect fn showProgress(self: &mut Self, module: &ModuleId) -> () ! OutOfMemoryError ? &mut Allocator {
    if Progress.timing(&self.resolver.progress) || run Progress.due(&self.resolver.progress) {
      let shown = run ModuleId.copyPath(module)
      run Progress.timeItem(&mut self.resolver.progress, Bytes.asSlice(&shown))
      run Progress.show(&mut self.resolver.progress, Bytes.asSlice(&shown))
    }
    run Progress.advance(&mut self.resolver.progress)
  }

  // A revisable store's `checkDeclarations`: each module's kept sweep, which an unaffected module
  // only verifies, then the foreign symbol claims of every module and the kept escape check of
  // every concrete body. It reports the same rejections as one sweep of every module.
  effect fn checkEachModule(self: &mut Self, request: &mut Request, modules: &[usize], runtime: &Option<ModuleId>)
  -> DeclarationCheckResult
    ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
    ? &mut Allocator | &mut Types {
    let mut result = DeclarationCheckResult {rejections: List<Shared<Rejection>>.make(), gaps: List<Shared<BackendGap>>.make(),
      unchecked: List<UncheckedDeclaration>.make()}
    let mut deferred = List<DeferredStaticTemplate>.make()
    let mut uncheckedBodies = List<UncheckedBody>.make()
    let mut at = usize.ZERO
    while at < modules.length {
      let module = resolvedModule(&self.resolver, modules[at])
      run Semantic.showProgress(&mut self.*, &module)
      let found = run Semantic.keptSweep(&mut self.*, &mut request.*, &module, modules[at])
      at = at + usize.ONE
      let memos = List<ModuleCheckMemo>.asSlice(&self.moduleMemos)
      let mut concrete = List<DeclarationId>.make()
      run mergeSweep(&mut result, &mut concrete, &memos[found].sweep)
      run appendDeferred(&mut deferred, List<DeferredStaticTemplate>.asSlice(&memos[found].deferred))
      run appendUnchecked(&mut uncheckedBodies, List<UncheckedBody>.asSlice(&memos[found].unchecked))
      // Each module keeps the escapes of its own bodies, so an edit reruns its module's walk alone.
      let escapes = run Semantic.keptEscapes(&mut self.*, &mut request.*, modules[at - usize.ONE], modules, List<DeclarationId>.asSlice(&concrete), false)
      run mergeRejections(&mut result.rejections, List<Shared<Rejection>>.asSlice(&escapes.rejections))
      run mergeGaps(&mut result.gaps, List<Shared<BackendGap>>.asSlice(&escapes.gaps))
    }
    // The runtime's walk is the runtime module's time; the claims of every module are no one module's.
    run Progress.endItem(&mut self.resolver.progress)
    let entries = run Semantic.runtimeRoots(&mut self.*, runtime, modules)
    if List<DeclarationId>.length(&entries) > usize.ZERO {
      if let Option<ModuleId>.Some {value: selected} = &runtime.* {
        if Progress.timing(&self.resolver.progress) {
          let shown = run ModuleId.copyPath(&selected)
          run Progress.timeItem(&mut self.resolver.progress, Bytes.asSlice(&shown))
        }
        let runtimeOrdinal = run internModule(&mut self.resolver, &selected)
        let escapes = run Semantic.keptEscapes(&mut self.*, &mut request.*, runtimeOrdinal, modules, List<DeclarationId>.asSlice(&entries), true)
        run appendOutsideRuntime(&mut result.rejections, List<Shared<Rejection>>.asSlice(&escapes.rejections), runtime)
        run mergeGaps(&mut result.gaps, List<Shared<BackendGap>>.asSlice(&escapes.gaps))
        run Progress.endItem(&mut self.resolver.progress)
      }
    }
    let mut conflicts = List<Shared<Rejection>>.make()
    run Semantic.checkForeignClaims(&mut self.*, modules, runtime, &mut conflicts)
    run mergeRejections(&mut result.rejections, List<Shared<Rejection>>.asSlice(&conflicts))
    self.deferredTemplates = move deferred
    self.uncheckedRoot = move uncheckedBodies
    return move result
  }

  // The bound of a walk from the runtime's roots, as `keptEscapes` sets it for the runtime module.
  effect fn runtimeBoundary(self: &mut Self, runtime: &Option<ModuleId>) -> Option<WalkBoundary> ! OutOfMemoryError ? &mut Allocator {
    let own = match &runtime.* {
      Option<ModuleId>.Some {value} => ModuleId.copy(&value)
      Option<ModuleId>.None => { return Option<WalkBoundary>.none() }
    }
    let mut package = ModuleId.copy(&own)
    if self.resolver.currentApplication != usize.MAX { package = resolvedModule(&self.resolver, self.resolver.currentApplication) }
    return Option<WalkBoundary>.some(WalkBoundary {package: move package, own: move own, checked: List<ModuleId>.make(),
      lookup: InternIndex.make(), staticsOnly: true})
  }

  // The C exports of the selected runtime, which a build walks the program from, unless the
  // runtime is itself a checked module. An effect `main` that requires a provider is open, so no
  // concrete body of the package reaches it; walking these roots too, bounded to the entry module
  // and instances with static arguments (`WalkBoundary.staticsOnly`), reaches a library body that
  // a static argument of `main` selects, and `silk check` reports what `silk build` would.
  effect fn runtimeRoots(self: &mut Self, runtime: &Option<ModuleId>, modules: &[usize]) -> List<DeclarationId>
    ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
    ? &mut Allocator | &mut Types {
    let mut roots = List<DeclarationId>.make()
    let selected = match &runtime.* {
      Option<ModuleId>.Some {value} => ModuleId.copy(&value)
      Option<ModuleId>.None => { return move roots }
    }
    let ordinal = run internModule(&mut self.resolver, &selected)
    let mut at = usize.ZERO
    while at < modules.length {
      if modules[at] == ordinal { return move roots }
      at = at + usize.ONE
    }
    let listed = match move run exportCandidates(&mut self.resolver, &selected) {
      Option<List<ExportCandidate>>.Some {value} => move value
      Option<List<ExportCandidate>>.None => { return move roots }
    }
    let mut conditions = List<Dependency>.make()
    let candidates = List<ExportCandidate>.asSlice(&listed)
    at = usize.ZERO
    while at < candidates.length {
      let candidate = &candidates[at]
      at = at + usize.ONE
      let active = run available(&mut self.resolver, &mut self.query, &mut conditions, &selected, candidate.declaration, candidate.span)
      let present = match &active {
        Result<bool, Shared<Rejection>>.Success {value} => value
        Result<bool, Shared<Rejection>>.Failure {..} => false
      }
      if !present { continue }
      if let Option<DeclarationId>.Some {value} = move run declarationAt(&mut self.resolver, &selected, candidate.declaration) {
        run List<DeclarationId>.append(&mut roots, move value)
      }
    }
    return move roots
  }

  /// The rejections `checkDeclarations` would report from one escape walk over every concrete body
  /// of `rootPackage`, instead of each module's own walk, which stops at the plain bodies of the
  /// package's other modules. `silk check --roots` compares the two; nothing is kept.
  pub effect fn wholePackageCheck(
    self: &mut Self,
    request: &mut Request,
    rootPackage: &[ModuleId],
    runtime: &Option<ModuleId>,
  ) -> DeclarationCheckResult
    ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
    ? &mut Allocator | &mut Types {
    run selectRequest(&mut self.resolver, &request.*)
    let mut modules = List<usize>.make()
    let mut rootAt = usize.ZERO
    while rootAt < rootPackage.length {
      run appendCheckedModule(&mut modules, run internModule(&mut self.resolver, &rootPackage[rootAt]))
      rootAt = rootAt + usize.ONE
    }
    if !Graph.recording(&self.resolver.graph) {
      return run Semantic.checkDeclarations(&mut self.*, &mut request.*, rootPackage, runtime)
    }
    let mut result = DeclarationCheckResult {rejections: List<Shared<Rejection>>.make(), gaps: List<Shared<BackendGap>>.make(),
      unchecked: List<UncheckedDeclaration>.make()}
    let mut concrete = List<DeclarationId>.make()
    let listed = List<usize>.asSlice(&modules)
    let mut at = usize.ZERO
    while at < listed.length {
      let module = resolvedModule(&self.resolver, listed[at])
      let found = run Semantic.keptSweep(&mut self.*, &mut request.*, &module, listed[at])
      let memos = List<ModuleCheckMemo>.asSlice(&self.moduleMemos)
      run mergeSweep(&mut result, &mut concrete, &memos[found].sweep)
      at = at + usize.ONE
    }
    let mut conflicts = List<Shared<Rejection>>.make()
    run Semantic.checkForeignClaims(&mut self.*, listed, runtime, &mut conflicts)
    run mergeRejections(&mut result.rejections, List<Shared<Rejection>>.asSlice(&conflicts))
    let escapes = run Semantic.declarationEscapes(&mut self.*, &mut request.*, List<DeclarationId>.asSlice(&concrete),
      &Option<WalkBoundary>.none())
    run mergeRejections(&mut result.rejections, List<Shared<Rejection>>.asSlice(&escapes.rejections))
    run mergeGaps(&mut result.gaps, List<Shared<BackendGap>>.asSlice(&escapes.gaps))
    return move result
  }

  /// Checks one module of the root package as `checkDeclarations` checks each of its modules: its
  /// name collisions, each active declaration as `checkDeclaration` does, its foreign symbol
  /// claims and the escapes of its concrete bodies. Over a package's modules, these results and
  /// `checkForeignConflicts` hold exactly the rejections `checkDeclarations` reports, so an edit
  /// to one module refreshes that module's entry alone.
  ///
  /// Like `checkDeclarations`, it replaces `deferredStaticTemplates` and `uncheckedRootBodies`
  /// with what this check found.
  pub effect fn checkModule(
    self: &mut Self,
    request: &mut Request,
    module: &ModuleId,
    runtime: &Option<ModuleId>,
  ) -> DeclarationCheckResult
    ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
    ? &mut Allocator | &mut Types {
    let zone = Profiler.zone(b"checkModule")
    run selectRequest(&mut self.resolver, &request.*)
    let moduleOrdinal = run internModule(&mut self.resolver, module)
    if !Graph.recording(&self.resolver.graph) {
      self.deferredTemplates = List<DeferredStaticTemplate>.make()
      self.uncheckedRoot = List<UncheckedBody>.make()
      let mut sweep = Sweep.make()
      run Semantic.sweepModule(&mut self.*, &mut request.*, module, moduleOrdinal, &Option<DeclarationId>.none(), &mut sweep)
      return run Semantic.finishSweep(&mut self.*, &mut request.*, &[moduleOrdinal], runtime, move sweep)
    }
    // A revisable store keeps the sweep and the escape check as units, verified when unaffected.
    let found = run Semantic.keptSweep(&mut self.*, &mut request.*, module, moduleOrdinal)
    let mut result = DeclarationCheckResult {rejections: List<Shared<Rejection>>.make(), gaps: List<Shared<BackendGap>>.make(),
      unchecked: List<UncheckedDeclaration>.make()}
    let mut concrete = List<DeclarationId>.make()
    let memos = List<ModuleCheckMemo>.asSlice(&self.moduleMemos)
    run mergeSweep(&mut result, &mut concrete, &memos[found].sweep)
    self.deferredTemplates = run copyDeferred(List<DeferredStaticTemplate>.asSlice(&memos[found].deferred))
    self.uncheckedRoot = run copyUnchecked(List<UncheckedBody>.asSlice(&memos[found].unchecked))
    let mut claims = List<Shared<Rejection>>.make()
    run Semantic.checkForeignClaims(&mut self.*, &[moduleOrdinal], runtime, &mut claims)
    run mergeRejections(&mut result.rejections, List<Shared<Rejection>>.asSlice(&claims))
    let escapes = run Semantic.keptEscapes(&mut self.*, &mut request.*, moduleOrdinal, &[], List<DeclarationId>.asSlice(&concrete), false)
    run mergeRejections(&mut result.rejections, List<Shared<Rejection>>.asSlice(&escapes.rejections))
    run mergeGaps(&mut result.gaps, List<Shared<BackendGap>>.asSlice(&escapes.gaps))
    return move result
  }

  // The memo of `module`'s sweep, run again unless its unit is current or verifies. Its root
  // demands and source reads are recorded against its unit.
  effect fn keptSweep(self: &mut Self, request: &mut Request, module: &ModuleId, moduleOrdinal: usize) -> usize
    ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
    ? &mut Allocator | &mut Types {
    let word = run internKey(&mut self.resolver, Key {family: Family.ModuleCheck, module: moduleOrdinal, name: usize.ZERO,
      declaration: usize.MAX, member: usize.ZERO, external: false})
    let unit = u64.toUsize(word.value)
    let found = memoOf(List<ModuleCheckMemo>.asSlice(&self.moduleMemos), unit)
    if found != usize.MAX {
      if run Semantic.unitCurrent(&mut self.*, unit) { return found }
      drop List<ModuleCheckMemo>.remove(&mut self.moduleMemos, found)
      uncarry(&mut self.carriedUnits, &mut self.carriedRoots, unit)
    }
    run Graph.startRun(&mut self.resolver.graph, unit)
    self.resolver.runs = self.resolver.runs + usize.ONE
    self.checkRuns = self.checkRuns + usize.ONE
    self.resolver.rootRecorder = unit
    let attempted = run Effect.result(Semantic.sweepOnly(&mut self.*, &mut request.*, module, moduleOrdinal))
    self.resolver.rootRecorder = usize.MAX
    // A failed sweep keeps no memo, so the next check sweeps again whatever its unit's edges say.
    let sweep = match move attempted {
      Result<Sweep, Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError>.Success {value} => move value
      Result<Sweep, Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError>.Failure {error} => { fail move error }
    }
    drop run Graph.finishRun(&mut self.resolver.graph, unit, Option<ContentHash>.none())
    run List<ModuleCheckMemo>.append(&mut self.moduleMemos, ModuleCheckMemo {unit: unit, sweep: move sweep,
      deferred: run copyDeferred(List<DeferredStaticTemplate>.asSlice(&self.deferredTemplates)),
      unchecked: run copyUnchecked(List<UncheckedBody>.asSlice(&self.uncheckedRoot))})
    return List<ModuleCheckMemo>.length(&self.moduleMemos) - usize.ONE
  }

  effect fn sweepOnly(self: &mut Self, request: &mut Request, module: &ModuleId, moduleOrdinal: usize) -> Sweep
    ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
    ? &mut Allocator | &mut Types {
    self.deferredTemplates = List<DeferredStaticTemplate>.make()
    self.uncheckedRoot = List<UncheckedBody>.make()
    let mut sweep = Sweep.make()
    run Semantic.sweepModule(&mut self.*, &mut request.*, module, moduleOrdinal, &Option<DeclarationId>.none(), &mut sweep)
    return move sweep
  }

  // The escapes of `concrete`, the concrete bodies of `module`, kept for its check. They run again
  // when the bodies differ or the unit neither is current nor verifies. The walk leaves the plain
  // bodies of the other modules `checked` lists, and of the application's package, to their own
  // checks (`WalkBoundary`), so it rests on this module's bodies and what they instantiate, not
  // on the whole program. Its key names the `checked` modules, since a module that leaves them is
  // walked here again.
  effect fn keptEscapes(self: &mut Self, request: &mut Request, module: usize, checked: &[usize], concrete: &[DeclarationId], staticsOnly: bool)
  -> DeclarationCheckResult
    ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
    ? &mut Allocator | &mut Types {
    let own = resolvedModule(&self.resolver, module)
    let mut package = ModuleId.copy(&own)
    if self.resolver.currentApplication != usize.MAX { package = resolvedModule(&self.resolver, self.resolver.currentApplication) }
    // The application's own modules are always left to their own checks, so only the checked
    // modules of other packages name the unit: adding or renaming a module of the package keeps
    // every other module's unit.
    let mut others = List<ModuleId>.make()
    let mut lookup = InternIndex.make()
    let mut digest: u64 = 0
    let mut at = usize.ZERO
    while at < checked.length {
      let listed = resolvedModule(&self.resolver, checked[at])
      at = at + usize.ONE
      if ModuleId.samePackage(&listed, &package) { continue }
      digest = Hash.mix(&Hash.seed(digest), ModuleId.hash(&listed))
      run InternIndex.record(&mut lookup, ModuleId.hash(&listed))
      run List<ModuleId>.append(&mut others, move listed)
    }
    let mut member = usize.ZERO
    if List<ModuleId>.length(&others) > usize.ZERO { member = u64.toUsize(u64.shiftRight(digest, 1)) }
    let word = run internKey(&mut self.resolver, Key {family: Family.ModuleCheck, module: module, name: usize.ONE,
      declaration: usize.MAX, member: member, external: false})
    let unit = u64.toUsize(word.value)
    let boundary = Option<WalkBoundary>.some(WalkBoundary {package: move package, own: move own, checked: move others,
      lookup: move lookup, staticsOnly: staticsOnly})
    let found = escapeMemoOf(List<EscapeMemo>.asSlice(&self.escapeMemos), unit)
    // The record of this check's last walk in this process, which an edit since may leave true.
    let mut previous = Option<CapturedBuild>.none()
    if found != usize.MAX {
      let memos = List<EscapeMemo>.asSlice(&self.escapeMemos)
      if sameDeclarations(List<DeclarationId>.asSlice(&memos[found].concrete), concrete) && run Semantic.unitCurrent(&mut self.*, unit) {
        let kept = List<EscapeMemo>.asSlice(&self.escapeMemos)
        return run copyCheckResult(&kept[found].result)
      }
      let EscapeMemo {unit: _, concrete: _, result: _, captured: last, reads: _} = List<EscapeMemo>.remove(&mut self.escapeMemos, found)
      previous = move last
      uncarry(&mut self.carriedUnits, &mut self.carriedRoots, unit)
    }
    // The walk an adopted image recorded for this check is replayed when it still describes the
    // check; a walk run here replaces it either way.
    let mut adopted = Option<EscapeRecordRoot>.none()
    if let Option<Bytes>.Some {value: stable} = move run stableUnit(&self.resolver, unit) {
      adopted = EscapeImage.take(&mut self.escapeImage, Bytes.asSlice(&stable))
    }
    let mut kept = Option<EscapeRecordRoot>.none()
    if let Option<EscapeRecordRoot>.Some {value: held} = move adopted {
      let replayed = run Semantic.replayKept(&mut self.*, &mut request.*, module, member, unit, concrete, &boundary,
        Bytes.asSlice(&held.answer), held.root, &[], usize.MAX, false)
      if let Option<DeclarationCheckResult>.Some {value: result} = move replayed { return move result }
      kept = Option<EscapeRecordRoot>.some(move held)
    } else if let Option<CapturedBuild>.Some {value: last} = move previous {
      // In one process, as the language server's, the last walk's own record is replayed as an
      // adopted one is, while the reads of its growth guards hold: an entry is green when its MIR
      // unit is current.
      if last.guard == usize.MAX || run Semantic.unitCurrent(&mut self.*, last.guard) {
        let recorded = run BuildRecord.encode(&last.record)
        let replayed = run Semantic.replayKept(&mut self.*, &mut request.*, module, member, unit, concrete, &boundary,
          Bytes.asSlice(&recorded), last.carriedRecord, List<CapturedEntry>.asSlice(&last.entries), last.guard, true)
        if let Option<DeclarationCheckResult>.Some {value: result} = move replayed { return move result }
      }
    }
    run Graph.startRun(&mut self.resolver.graph, unit)
    self.resolver.runs = self.resolver.runs + usize.ONE
    self.checkRuns = self.checkRuns + usize.ONE
    // The walk's growth guards and static closures read what no MIR reference shows; those reads
    // go to a guard unit, which the check and its record rest on.
    let mut guard = usize.MAX
    if Graph.recording(&self.resolver.graph) {
      let guardWord = run internKey(&mut self.resolver, Key {family: Family.ModuleCheck, module: module, name: 4,
        declaration: usize.MAX, member: member, external: false})
      guard = u64.toUsize(guardWord.value)
      run Graph.startRun(&mut self.resolver.graph, guard)
    }
    self.resolver.rootRecorder = unit
    let mut capture = BuildCapture.walk()
    let attempted = run Effect.result(Semantic.capturedEscapes(&mut self.*, &mut request.*, concrete, &boundary, &mut capture, guard))
    self.resolver.rootRecorder = usize.MAX
    let result = match move attempted {
      Result<DeclarationCheckResult, Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError>.Success {value} => move value
      Result<DeclarationCheckResult, Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError>.Failure {error} => { fail move error }
    }
    let mut captured = Option<CapturedBuild>.none()
    if guard != usize.MAX {
      drop run Graph.finishRun(&mut self.resolver.graph, guard, Option<ContentHash>.none())
      run Graph.record(&mut self.resolver.graph, unit, Dependee.UnitResult {unit: guard})
      if List<Shared<Rejection>>.length(&result.rejections) == usize.ZERO && List<Shared<BackendGap>>.length(&result.gaps) == usize.ZERO
        && List<UncheckedDeclaration>.length(&result.unchecked) == usize.ZERO {
        let mut resting = usize.MAX
        if capture.guarded { resting = guard }
        captured = run BuildCapture.finish(move capture, resting)
      }
    }
    drop run Graph.finishRun(&mut self.resolver.graph, unit, Option<ContentHash>.none())
    // A walk that records nothing, as one that reports does, leaves the adopted record to the next
    // check, which replays it once the walk is back to what the record describes, as after a fix.
    if let Option<CapturedBuild>.None = &captured {
      if let Option<EscapeRecordRoot>.Some {value: held} = move kept {
        run List<EscapeRecordRoot>.append(&mut self.escapeImage.records, move held)
      }
    }
    run List<EscapeMemo>.append(&mut self.escapeMemos, EscapeMemo {unit: unit, concrete: run copyDeclarations(concrete),
      result: run copyCheckResult(&result), captured: move captured, reads: usize.MAX})
    return move result
  }

  // Replays the escape walk record `recorded` for the check `unit` of `module` (`replayEscapes`),
  // or walks it again from the record (`rewalkEscapes`) within `boundary`, and keeps what it found
  // as the check's memo; none when neither can tell what the walk finds.
  effect fn replayKept(self: &mut Self, request: &mut Request, module: usize, member: usize, unit: usize, concrete: &[DeclarationId],
    boundary: &Option<WalkBoundary>, recorded: &[u8], recordRoot: usize, previous: &[CapturedEntry], guard: usize, inProcess: bool)
    -> Option<DeclarationCheckResult>
    ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
    ? &mut Allocator | &mut Types {
    // What the replay demands goes to a unit of its own: the units that decide what a replay
    // that reports finds besides the record's entries, as a broken body's MIR.
    let readsWord = run internKey(&mut self.resolver, Key {family: Family.ModuleCheck, module: module, name: 7,
      declaration: usize.MAX, member: member, external: false})
    let reads = u64.toUsize(readsWord.value)
    run Graph.startRun(&mut self.resolver.graph, reads)
    let recorder = self.resolver.rootRecorder
    self.resolver.rootRecorder = reads
    let attempted = run Effect.result(Semantic.keptReplay(&mut self.*, &mut request.*, concrete, boundary, recorded, recordRoot,
      previous, guard, inProcess))
    self.resolver.rootRecorder = recorder
    drop run Graph.finishRun(&mut self.resolver.graph, reads, Option<ContentHash>.none())
    let replayed = match move attempted {
      Result<Option<EscapeReplay>, Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError>.Success {value} => move value
      Result<Option<EscapeReplay>, Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError>.Failure {error} => { fail move error }
    }
    if let Option<EscapeReplay>.Some {value: replay} = move replayed {
      let EscapeReplay {captured, result} = move replay
      run List<EscapeMemo>.append(&mut self.escapeMemos, EscapeMemo {unit: unit, concrete: run copyDeclarations(concrete),
        result: run copyCheckResult(&result), captured: Option<CapturedBuild>.some(move captured), reads: reads})
      return Option<DeclarationCheckResult>.some(move result)
    }
    return Option<DeclarationCheckResult>.none()
  }

  // `replayEscapes`, or `rewalkEscapes` when the record no longer describes the walk as it is.
  effect fn keptReplay(self: &mut Self, request: &mut Request, concrete: &[DeclarationId], boundary: &Option<WalkBoundary>, recorded: &[u8],
    recordRoot: usize, previous: &[CapturedEntry], guard: usize, inProcess: bool) -> Option<EscapeReplay>
    ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
    ? &mut Allocator | &mut Types {
    // Both read the record decoded once; a replay that succeeds takes it.
    let mut record = match move run BuildRecord.decode(recorded) {
      Option<BuildRecord.Record>.Some {value} => move value
      Option<BuildRecord.Record>.None => { return Option<EscapeReplay>.none() }
    }
    let replayed = run Semantic.replayEscapes(&mut self.*, &mut request.*, concrete, &mut record, recordRoot, previous, guard, inProcess)
    if let Option<EscapeReplay>.Some {..} = &replayed { return move replayed }
    drop replayed
    if let Option<WalkBoundary>.Some {value: walk} = &boundary.* {
      return run Semantic.rewalkEscapes(&mut self.*, &mut request.*, concrete, &walk, &record, previous, inProcess)
    }
    return Option<EscapeReplay>.none()
  }

  // Whether a kept unit reflects the current revision, verifying it when it is outdated.
  effect fn unitCurrent(self: &mut Self, unit: usize) -> bool
    ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
    ? &mut Allocator | &mut Types {
    // An update marks units outdated only once the store reconciles its sources.
    run reconcileSources(&mut self.resolver)
    if Graph.current(&self.resolver.graph, unit) {
      self.resolver.hits = self.resolver.hits + usize.ONE
      return true
    }
    if run verifyUnit(&mut self.resolver, &mut self.query, unit) {
      Graph.markVerified(&mut self.resolver.graph, unit)
      self.resolver.hits = self.resolver.hits + usize.ONE
      return true
    }
    return false
  }

  /// Checks one active declaration: the facets its kind declares, its body, and the escapes of
  /// that body. Name collisions and foreign symbol claims belong to its module's check, so a body
  /// edit reruns no more than this declaration's own units. An inactive declaration, or one its
  /// module no longer holds, reports nothing.
  ///
  /// Like `checkDeclarations`, it replaces `deferredStaticTemplates` and `uncheckedRootBodies`
  /// with what this check found.
  pub effect fn checkDeclaration(
    self: &mut Self,
    request: &mut Request,
    declaration: &DeclarationId,
  ) -> DeclarationCheckResult
    ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
    ? &mut Allocator | &mut Types {
    let zone = Profiler.zone(b"checkDeclaration")
    run selectRequest(&mut self.resolver, &request.*)
    self.deferredTemplates = List<DeferredStaticTemplate>.make()
    self.uncheckedRoot = List<UncheckedBody>.make()
    let module = DeclarationId.moduleId(declaration)
    let moduleOrdinal = run internModule(&mut self.resolver, module)
    let only = Option<DeclarationId>.some(DeclarationId.copy(declaration))
    let mut sweep = Sweep.make()
    run Semantic.sweepModule(&mut self.*, &mut request.*, module, moduleOrdinal, &only, &mut sweep)
    return run Semantic.finishSweep(&mut self.*, &mut request.*, &[], &Option<ModuleId>.none(), move sweep)
  }

  /// Whether `module`'s kept sweep reflects the current revision, verifying it when it is
  /// outdated, so `checkModule` would reuse it rather than sweep the module again. Only a
  /// revisable store keeps sweeps.
  pub effect fn moduleSweepCurrent(self: &mut Self, module: &ModuleId) -> bool
    ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
    ? &mut Allocator | &mut Types {
    if !Graph.recording(&self.resolver.graph) { return false }
    let moduleOrdinal = run internModule(&mut self.resolver, module)
    let word = run internKey(&mut self.resolver, Key {family: Family.ModuleCheck, module: moduleOrdinal, name: usize.ZERO,
      declaration: usize.MAX, member: usize.ZERO, external: false})
    let unit = u64.toUsize(word.value)
    if memoOf(List<ModuleCheckMemo>.asSlice(&self.moduleMemos), unit) == usize.MAX { return false }
    return run Semantic.unitCurrent(&mut self.*, unit)
  }

  /// The declarations a check of `module` sweeps, in the order it sweeps them.
  pub effect fn moduleDeclarations(self: &mut Self, module: &ModuleId) -> List<DeclarationId>
    ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
    ? &mut Allocator | &mut Types {
    let listed = run Semantic.moduleChecks(&mut self.*, module, &Option<DeclarationId>.none())
    let written = List<DeclarationCheck>.asSlice(&listed.declarations)
    let mut declarations = List<DeclarationId>.make()
    let mut at = usize.ZERO
    while at < written.length {
      run List<DeclarationId>.append(&mut declarations, DeclarationId.copy(&written[at].identity))
      at = at + usize.ONE
    }
    return move declarations
  }

  /// Answers the queries a check of `declaration` demands, without the escape check and without
  /// reporting, so a later `checkModule` of its module finds them answered. The language server
  /// runs it one declaration per step to answer requests between them.
  pub effect fn prepareDeclaration(self: &mut Self, request: &mut Request, declaration: &DeclarationId) -> ()
    ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
    ? &mut Allocator | &mut Types {
    run selectRequest(&mut self.resolver, &request.*)
    let deferred = Intrinsic.replace(self.deferredTemplates, List<DeferredStaticTemplate>.make())
    let unchecked = Intrinsic.replace(self.uncheckedRoot, List<UncheckedBody>.make())
    let module = DeclarationId.moduleId(declaration)
    let moduleOrdinal = run internModule(&mut self.resolver, module)
    let only = Option<DeclarationId>.some(DeclarationId.copy(declaration))
    let mut sweep = Sweep.make()
    let attempted = run Effect.result(Semantic.sweepModule(&mut self.*, &mut request.*, module, moduleOrdinal, &only, &mut sweep))
    self.deferredTemplates = move deferred
    self.uncheckedRoot = move unchecked
    if let Result<(), Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError>.Failure {error} = move attempted {
      fail move error
    }
    return ()
  }

  /// The foreign symbol conflicts between modules of the root package, which no one module's
  /// check can see. It may repeat a rejection a module's check reports.
  pub effect fn checkForeignConflicts(
    self: &mut Self,
    request: &mut Request,
    rootPackage: &[ModuleId],
    runtime: &Option<ModuleId>,
  ) -> List<Shared<Rejection>>
    ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
    ? &mut Allocator | &mut Types {
    run selectRequest(&mut self.resolver, &request.*)
    let mut modules = List<usize>.make()
    let mut rootAt = usize.ZERO
    while rootAt < rootPackage.length {
      run appendCheckedModule(&mut modules, run internModule(&mut self.resolver, &rootPackage[rootAt]))
      rootAt = rootAt + usize.ONE
    }
    let mut rejections = List<Shared<Rejection>>.make()
    run Semantic.checkForeignClaims(&mut self.*, List<usize>.asSlice(&modules), runtime, &mut rejections)
    return move rejections
  }

  // Checks a module's name collisions and its declarations, or only the declaration `only` names.
  effect fn sweepModule(
    self: &mut Self,
    request: &mut Request,
    module: &ModuleId,
    moduleOrdinal: usize,
    only: &Option<DeclarationId>,
    sweep: &mut Sweep
  ) -> ()
    ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
    ? &mut Allocator | &mut Types {
    let listed = run Semantic.moduleChecks(&mut self.*, module, only)
    run Semantic.checkNames(&mut self.*, module, List<CheckedName>.asSlice(&listed.names), &mut sweep.rejections)
    let written = List<DeclarationCheck>.asSlice(&listed.declarations)
    let mut at = usize.ZERO
    while at < written.length {
      run Semantic.sweptDeclaration(&mut self.*, &mut request.*, module, moduleOrdinal, &written[at], &mut sweep.*)
      at = at + usize.ONE
    }
    return ()
  }

  // Checks one declaration of a sweep that records its reads in a unit of its own, so a later
  // sweep of the module, after an edit elsewhere in it, reuses a check that found nothing while
  // what it read stands, as an image the next process adopts does too.
  effect fn sweptDeclaration(
    self: &mut Self,
    request: &mut Request,
    module: &ModuleId,
    moduleOrdinal: usize,
    declaration: &DeclarationCheck,
    sweep: &mut Sweep
  ) -> ()
    ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
    ? &mut Allocator | &mut Types {
    let recorder = self.resolver.rootRecorder
    if recorder == usize.MAX || !Graph.recording(&self.resolver.graph) {
      return run Semantic.checkListedDeclaration(&mut self.*, &mut request.*, module, moduleOrdinal, declaration, &mut sweep.*)
    }
    // The identity names the unit, so a declaration written above another keeps both units. Its
    // hash leaves out the kind, which tells a struct from the `impl` block of the same name.
    let named = Hash.combine(DeclarationId.hash(&declaration.identity), contentKind(DeclarationId.kind(&declaration.identity)))
    let member = u64.toUsize(u64.shiftRight(named, 1))
    let word = run internKey(&mut self.resolver, Key {family: Family.ModuleCheck, module: moduleOrdinal, name: 6,
      declaration: usize.MAX, member: member, external: false})
    let unit = u64.toUsize(word.value)
    let found = declarationMemoOf(List<usize>.asSlice(&self.declarationSlots), unit)
    if found != usize.MAX {
      let memos = List<DeclarationMemo>.asSlice(&self.declarationMemos)
      let concrete = memos[found].concrete
      let same = DeclarationId.equals(&memos[found].identity, &declaration.identity)
      if same && run Semantic.unitCurrent(&mut self.*, unit) {
        if concrete { run List<DeclarationId>.append(&mut sweep.concrete, DeclarationId.copy(&declaration.identity)) }
        run Graph.record(&mut self.resolver.graph, recorder, Dependee.UnitResult {unit: unit})
        return ()
      }
      Semantic.forgetDeclaration(&mut self.*, found)
    }
    let rejections = List<Shared<Rejection>>.length(&sweep.rejections)
    let gaps = List<Shared<BackendGap>>.length(&sweep.gaps)
    let unchecked = List<UncheckedDeclaration>.length(&sweep.unchecked)
    let concrete = List<DeclarationId>.length(&sweep.concrete)
    let deferred = List<DeferredStaticTemplate>.length(&self.deferredTemplates)
    let uncheckedBodies = List<UncheckedBody>.length(&self.uncheckedRoot)
    run Graph.startRun(&mut self.resolver.graph, unit)
    self.resolver.rootRecorder = unit
    let attempted = run Effect.result(Semantic.checkListedDeclaration(&mut self.*, &mut request.*, module, moduleOrdinal, declaration, &mut sweep.*))
    self.resolver.rootRecorder = recorder
    if let Result<(), Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError>.Failure {error} = move attempted {
      fail move error
    }
    drop run Graph.finishRun(&mut self.resolver.graph, unit, Option<ContentHash>.none())
    run Graph.record(&mut self.resolver.graph, recorder, Dependee.UnitResult {unit: unit})
    if List<Shared<Rejection>>.length(&sweep.rejections) == rejections && List<Shared<BackendGap>>.length(&sweep.gaps) == gaps
      && List<UncheckedDeclaration>.length(&sweep.unchecked) == unchecked
      && List<DeferredStaticTemplate>.length(&self.deferredTemplates) == deferred
      && List<UncheckedBody>.length(&self.uncheckedRoot) == uncheckedBodies {
      run Semantic.keepDeclaration(&mut self.*, unit, DeclarationId.copy(&declaration.identity),
        List<DeclarationId>.length(&sweep.concrete) > concrete, false)
    }
    return ()
  }

  // Keeps the clean check of one declaration, the unit `unit` names.
  effect fn keepDeclaration(self: &mut Self, unit: usize, identity: DeclarationId, concrete: bool, carried: bool) -> ()
    ! OutOfMemoryError ? &mut Allocator {
    while List<usize>.length(&self.declarationSlots) <= unit { run List<usize>.append(&mut self.declarationSlots, usize.MAX) }
    List<usize>.set(&mut self.declarationSlots, unit, List<DeclarationMemo>.length(&self.declarationMemos))
    run List<DeclarationMemo>.append(&mut self.declarationMemos, DeclarationMemo {unit: unit, identity: move identity,
      concrete: concrete, carried: carried})
  }

  // Drops the declaration check memo `found`, which no longer describes its declaration.
  fn forgetDeclaration(self: &mut Self, found: usize) -> () {
    let held = List<DeclarationMemo>.asSlice(&self.declarationMemos)
    let unit = held[found].unit
    let carried = held[found].carried
    if carried { uncarry(&mut self.carriedUnits, &mut self.carriedRoots, unit) }
    let mut memos = List<DeclarationMemo>.asMutSlice(&mut self.declarationMemos)
    memos[found].unit = usize.MAX
    memos[found].carried = false
    List<usize>.set(&mut self.declarationSlots, unit, usize.MAX)
  }

  // Ends a sweep with the foreign symbol claims of `modules` and the escapes of its concrete bodies.
  effect fn finishSweep(
    self: &mut Self,
    request: &mut Request,
    modules: &[usize],
    runtime: &Option<ModuleId>,
    sweep: Sweep
  ) -> DeclarationCheckResult
    ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
    ? &mut Allocator | &mut Types {
    let mut rejections = move sweep.rejections
    let mut gaps = move sweep.gaps
    run Semantic.checkForeignClaims(&mut self.*, modules, runtime, &mut rejections)
    let mut safety = run Semantic.declarationEscapes(
      &mut self.*,
      &mut request.*,
      List<DeclarationId>.asSlice(&sweep.concrete),
      &Option<WalkBoundary>.none()
    )
    let entries = run Semantic.runtimeRoots(&mut self.*, runtime, modules)
    if List<DeclarationId>.length(&entries) > usize.ZERO {
      let bound = run Semantic.runtimeBoundary(&mut self.*, runtime)
      let entered = run Semantic.declarationEscapes(&mut self.*, &mut request.*, List<DeclarationId>.asSlice(&entries), &bound)
      run appendOutsideRuntime(&mut safety.rejections, List<Shared<Rejection>>.asSlice(&entered.rejections), runtime)
      run mergeGaps(&mut safety.gaps, List<Shared<BackendGap>>.asSlice(&entered.gaps))
    }
    let found = List<Shared<Rejection>>.asSlice(&safety.rejections)
    let mut at = usize.ZERO
    while at < found.length {
      run appendDeclarationRejection(&mut rejections, Shared<Rejection>.clone(&found[at]))
      at = at + usize.ONE
    }
    let missing = List<Shared<BackendGap>>.asSlice(&safety.gaps)
    at = usize.ZERO
    while at < missing.length {
      run appendDeclarationGap(&mut gaps, Shared<BackendGap>.clone(&missing[at]))
      at = at + usize.ONE
    }
    return DeclarationCheckResult { rejections: move rejections, gaps: move gaps, unchecked: move sweep.unchecked }
  }

  // The checkable facts of a module's declarations, or of the one declaration `only` names, and
  // for the whole module the first spelling of each candidate name.
  effect fn moduleChecks(self: &mut Self, module: &ModuleId, only: &Option<DeclarationId>) -> ModuleChecks
    ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
    ? &mut Allocator | &mut Types {
    let mut whole = true
    if let Option<DeclarationId>.Some { .. } = &only.* {
      whole = false
    }
    let mut listed = ModuleChecks { declarations: List<DeclarationCheck>.make(), names: List<CheckedName>.make() }
    let indexed = run source(&mut self.resolver, module)
    if let Option<&IndexedSource>.Some {
      value
    } = move sourceOf(&self.resolver, &indexed, module) {
      let hir = IndexedSource.authored(value)
      let index = IndexedSource.moduleIndex(value)
      let authored = ModuleIndex.listDeclarations(index)
      let candidates = ModuleIndex.listCandidates(index)
      let mut candidateAt = usize.ZERO
      while whole && candidateAt < candidates.length {
        let candidate = &candidates[candidateAt]
        if ModuleIndex.firstCandidateNamed(index, Bytes.asSlice(&candidate.name)) == candidateAt {
          run List<
            CheckedName
          >.append(
            &mut listed.names,
            CheckedName { name: run Bytes.copy(Bytes.asSlice(&candidate.name)), }
          )
        }
        candidateAt = candidateAt + usize.ONE
      }
      let mut ordinal = usize.ZERO
      while ordinal < authored.length {
        let mut wanted = true
        if let Option<DeclarationId>.Some { value: chosen } = &only.* {
          wanted = DeclarationId.equals(&authored[ordinal].identity, &chosen)
        }
        if wanted {
          let declaration = &authored[ordinal]
          let mut body = false
          let mut staticWork = false
          let callable = match Module.node(hir, declaration.header) {
            Node.FunctionHeader { .. } => true
            Node.OperationHeader { .. } => true
            _ => false
          }
          let conditional = match Module.node(hir, declaration.header) {
            Node.ConditionalHeader { .. } => true
            _ => false
          }
          let alias = match Module.node(hir, declaration.header) {
            Node.AliasHeader { .. } => true
            _ => false
          }
          let mut default = false
          let mut blockSpan = Span.make(usize.ZERO, usize.ZERO)
          let conformance = match Module.node(hir, declaration.header) {
            Node.ImplHeader { target, .. } => target.present
            _ => false
          }
          let mut inherentMapping = Option<usize>.none()
          if let Node.ImplAliasHeader { .. } = Module.node(hir, declaration.header) {
            if let Option<usize>.Some { value: parent } = &declaration.parent {
              if let Node.ImplHeader { target, .. } = Module.node(hir, authored[parent].header) {
                if !target.present { inherentMapping = Option<usize>.some(parent) }
              }
            }
          }
          if let Node.Declaration { body: syntax, .. } = Module.node(hir, declaration.local) {
            match Module.node(hir, syntax) {
              Node.CallableBody { block } => {
                body = block.present
                if block.present {
                  staticWork = run bodyHasStaticWork(hir, block.id)
                  blockSpan = Module.span(hir, block.id)
                }
              }
              Node.PackageParameterBody { default: written, .. } => {
                default = written.present
              }
              _ => ()
            }
          }
          run List<
            DeclarationCheck
          >.append(
            &mut listed.declarations,
            DeclarationCheck {
              identity: DeclarationId.copy(&declaration.identity),
              ordinal: ordinal,
              span: Module.span(hir, declaration.header),
              block: blockSpan,
              body: body,
              callable: callable,
              conditional: conditional,
              alias: alias,
              open: declarationOpen(hir, authored, ordinal),
              staticWork: staticWork,
              default: default,
              conformance: conformance,
              deferred: run StaticTemplate.reason(hir, authored, ordinal),
              inherentMapping: move inherentMapping,
            }
          )
        }
        ordinal = ordinal + usize.ONE
      }
    }
    drop indexed
    return move listed
  }

  // Name collisions are static errors even when no use selects a winner (NAME-003).
  // Inactive arms can leave a bucket empty; their names do not reject the compilation.
  effect fn checkNames(self: &mut Self, module: &ModuleId, named: &[CheckedName], rejections: &mut List<Shared<Rejection>>) -> ()
    ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
    ? &mut Allocator | &mut Types {
    let mut nameAt = usize.ZERO
    while nameAt < named.length {
      let mut conditions = List<Dependency>.make()
      let selection = run select(
        &mut self.resolver,
        &mut self.query,
        &mut conditions,
        module,
        Bytes.asSlice(&named[nameAt].name),
        false
      )
      match move selection {
        Result<Selection, Shared<Rejection>>.Failure { error } => {
          run appendDeclarationRejection(&mut rejections.*, move error)
        }
        Result<Selection, Shared<Rejection>>.Success { value } => {
          if value.count > usize.ONE {
            run appendDeclarationRejection(&mut rejections.*, run nameCollision(&self.resolver, module, value, Bytes.asSlice(&named[nameAt].name)))
          }
        }
      }
      nameAt = nameAt + usize.ONE
    }
    return ()
  }

  // Checks one declaration of a module sweep, adding what it finds to `sweep`.
  effect fn checkListedDeclaration(
    self: &mut Self,
    request: &mut Request,
    module: &ModuleId,
    moduleOrdinal: usize,
    declaration: &DeclarationCheck,
    sweep: &mut Sweep
  ) -> ()
    ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
    ? &mut Allocator | &mut Types {
    let selected = run requestAvailability(
      &mut self.resolver,
      &mut self.query,
      &mut request.*,
      module,
      declaration.ordinal,
      declaration.span
    )
    match move selected {
      Result<bool, Shared<Rejection>>.Failure { error } => {
        run appendDeclarationRejection(&mut sweep.rejections, move error)
        return ()
      }
      Result<bool, Shared<Rejection>>.Success { value } => {
        if
          !value {
          return ()
        }
      }
    }
    let kind = DeclarationId.kind(&declaration.identity)
    let mut families = List<Family>.make()
    match kind {
      OwnerKind.Function => {
        // Authored callables are typed here; damaged header syntax is reported separately.
        if
          !declaration.callable {
          return ()
        }
        let signature = run Semantic.demandSignatureOf(
          &mut self.*,
          &mut request.*,
          &declaration.identity
        )
        run appendCheckedAnswer(&mut sweep.rejections, &mut sweep.gaps, &mut self.query, &declaration.identity, &signature)
        if declaration.body {
          if let Option<StaticTemplate.Reason>.Some { value } = &declaration.deferred {
            run List<
              DeferredStaticTemplate
            >.append(
              &mut self.deferredTemplates,
              DeferredStaticTemplate {
                declaration: DeclarationId.copy(&declaration.identity),
                reason: value,
              }
            )
            return ()
          }
          let body = run Semantic.checkedDeclarationBody(
            &mut self.*,
            &mut request.*,
            declaration,
            &signature
          )
          run appendCheckedAnswer(&mut sweep.rejections, &mut sweep.gaps, &mut self.query, &declaration.identity, &body)
          // Only a concrete body's sweep status is the status of the instance a build reaches.
          // An open template is checked abstractly and a deferred one not at all here, while
          // the instances a build reaches are checked in their own right. An open template no
          // reached instance emits still counts by its abstract status, so the gap receipt does
          // not pass over a template nothing instantiates. A static function's body runs only in
          // static evaluation over static values, which the runtime borrow check does not cover
          // (`values = StaticSequence.append(move values, x)` is valid there), so it is not an
          // unchecked runtime body.
          let staticFunction = Shared<Result<Answer, NoRejection>>.with<bool>(&signature, signatureIsStatic)
          if !declaration.open && !staticFunction {
            run recordUnchecked(&mut self.uncheckedRoot, module, declaration.block,
              Shared<Result<Answer, NoRejection>>.with<usize>(&body, bodyUnchecked))
          }
          if Shared<Result<Answer, NoRejection>>.with<bool>(&body, bodyAnswerPresent) {
            // A body no escape walk starts from is left out, so a later escape check, which may
            // run in another process, does not resolve its signature again to learn that.
            if !declaration.open && !run signatureStartsNoWalk(&signature) {
              run List<
                DeclarationId
              >.append(&mut sweep.concrete, DeclarationId.copy(&declaration.identity))
            }
            let borrow = Shared<Result<Answer, NoRejection>>.with<BodyBorrowStatus>(&body, bodyAnswerBorrowStatus)
            if borrow != BodyBorrowStatus.Checked && !staticFunction {
              run List<UncheckedDeclaration>.append(
                &mut sweep.unchecked,
                UncheckedDeclaration { identity: DeclarationId.copy(&declaration.identity), borrow: borrow }
              )
            }
          }
        }
      }
      OwnerKind.Static => {
        let mut dependencies = List<Dependency>.make()
        let checked = run declaredStaticType(
          &mut self.resolver,
          &mut self.query,
          &mut dependencies,
          moduleOrdinal,
          declaration.ordinal,
          declaration.span
        )
        if let Result<Shared<Type>, Shared<Rejection>>.Failure { error } = move checked {
          run appendDeclarationRejection(&mut sweep.rejections, move error)
        } else {
          // An exported static defines its C object from a statically evaluated initializer.
          let linked = run foreignHeader(&mut self.resolver, module, declaration.ordinal)
          if linked.exported {
            let valued = run exportedStaticValue(
              &mut self.resolver,
              &mut self.query,
              &mut dependencies,
              moduleOrdinal,
              declaration.ordinal,
              declaration.span
            )
            if let Result<Shared<StaticData>, Shared<Rejection>>.Failure { error } = move valued {
              run appendDeclarationRejection(&mut sweep.rejections, move error)
            }
          }
        }
      }
      OwnerKind.Import => {
        run List<Family>.append(&mut families, Family.Import)
      }
      OwnerKind.Alias => {
        // An ImplAliasHeader maps an operation and is checked by its parent's witness
        // queries; it is not an AliasHeader defining a type alias. An inherent impl has no
        // operation to map, so its owner's member list rejects the mapping (SEM0195).
        if declaration.alias {
          run List<Family>.append(&mut families, Family.Alias)
        }
        if let Option<usize>.Some { value: implementation } = &declaration.inherentMapping {
          let refusal = run inherentMemberRefusal(&mut self.resolver, &mut self.query, module, implementation, declaration.ordinal)
          if let Option<Shared<Result<Answer, NoRejection>>>.Some { value: refused } = move refusal {
            run appendDeclarationAnswer(&mut sweep.rejections, &mut self.query, &refused)
          }
        }
      }
      OwnerKind.Constant => {
        run List<Family>.append(&mut families, Family.Initializer)
      }
      OwnerKind.Conditional => {
        // Static arm groups are transparent scopes, not a second condition declaration.
        if declaration.conditional {
          run List<Family>.append(&mut families, Family.Condition)
        }
      }
      OwnerKind.PackageParameter => {
        run List<Family>.append(&mut families, Family.ParameterSchema)
        if declaration.default {
          run List<Family>.append(&mut families, Family.ParameterDefault)
        }
      }
      OwnerKind.Struct => {
        run List<Family>.append(&mut families, Family.Contract)
        run List<Family>.append(&mut families, Family.Members)
      }
      OwnerKind.Tuple => {
        run List<Family>.append(&mut families, Family.Contract)
        run List<Family>.append(&mut families, Family.Members)
      }
      OwnerKind.Enumeration => {
        run List<Family>.append(&mut families, Family.Contract)
        run List<Family>.append(&mut families, Family.Members)
      }
      OwnerKind.Union => {
        run List<Family>.append(&mut families, Family.Contract)
        run List<Family>.append(&mut families, Family.Members)
      }
      OwnerKind.Service => {
        run List<Family>.append(&mut families, Family.Contract)
        run List<Family>.append(&mut families, Family.Operations)
      }
      OwnerKind.Interface => {
        run List<Family>.append(&mut families, Family.Contract)
        run List<Family>.append(&mut families, Family.Operations)
      }
      OwnerKind.Role => {
        run List<Family>.append(&mut families, Family.Contract)
      }
      OwnerKind.Implementation => {
        let implementationKey = run internDeclaration(
          &mut self.resolver,
          Key {
            family: Family.ImplementationHead,
            module: moduleOrdinal,
            name: usize.ZERO,
            declaration: declaration.ordinal,
            member: usize.ZERO,
            external: false,
          }
        )
        let head = run demandRaw(
          &mut self.resolver,
          &mut self.query,
          implementationKey,
          declaration.span
        )
        run appendDeclarationAnswer(&mut sweep.rejections, &mut self.query, &head)
        if declaration.conformance {
          run List<Family>.append(&mut families, Family.ImplementationMembers)
          run List<Family>.append(&mut families, Family.Coherence)
          if Shared<Result<Answer, NoRejection>>.with<bool>(&head, checkedConformanceHead) {
            run List<Family>.append(&mut families, Family.Witnesses)
          }
        }
      }
      OwnerKind.ModuleProperty => {
        if let Option<Shared<Rejection>>.Some { value } = move run modulePropertyRejection(&mut self.resolver, module, declaration.ordinal) {
          run appendDeclarationRejection(&mut sweep.rejections, move value)
        }
      }

      // Literal bodies are checked by their owning Body query. Damaged syntax is reported
      // by syntaxRejections; module properties are consumed when the profile is assembled.
      _ => ()
    }
    let demanded = List<Family>.asSlice(&families)
    let mut familyAt = usize.ZERO
    while familyAt < demanded.length {
      let family = demanded[familyAt]
      familyAt = familyAt + usize.ONE
      let mut member = usize.ZERO
      if family == Family.Import {
        member = usize.MAX
      }
      let declarationKey = run internDeclaration(
        &mut self.resolver,
        Key {
          family: family,
          module: moduleOrdinal,
          name: usize.ZERO,
          declaration: declaration.ordinal,
          member: member,
          external: false,
        }
      )
      let answer = run demandRaw(
        &mut self.resolver,
        &mut self.query,
        declarationKey,
        declaration.span
      )
      run appendDeclarationAnswer(&mut sweep.rejections, &mut self.query, &answer)
      if family == Family.Members {
        let count = Shared<
          Result<Answer, NoRejection>
        >.with<usize>(&answer, declarationMemberCount)
        if count > usize.ZERO {
          let application = run checkedAggregateApplication(
            &mut self.resolver,
            &mut self.query,
            moduleOrdinal,
            declaration.ordinal,
            declaration.span
          )
          match move application {
            Result<usize, Shared<Rejection>>.Failure { error } => {
              run appendDeclarationRejection(&mut sweep.rejections, move error)
            }
            Result<usize, Shared<Rejection>>.Success { value: applied } => {
              let mut memberAt = usize.ZERO
              while memberAt < count {
                let memberKey = run internDeclaration(
                  &mut self.resolver,
                  Key {
                    family: Family.MemberShape,
                    module: moduleOrdinal,
                    name: applied,
                    declaration: declaration.ordinal,
                    member: memberAt,
                    external: false,
                  }
                )
                let shape = run demandRaw(
                  &mut self.resolver,
                  &mut self.query,
                  memberKey,
                  declaration.span
                )
                run appendDeclarationAnswer(&mut sweep.rejections, &mut self.query, &shape)
                memberAt = memberAt + usize.ONE
              }
              // An aggregate that stores itself inline has no finite layout (SEM0020), whether or
              // not any body uses it.
              let owner = Shared<Type>.clone(&List<Shared<Type>>.asSlice(&self.resolver.applications)[applied])
              let mut visiting = List<Shared<Type>>.make()
              let mut layoutDependencies = List<Dependency>.make()
              let recursion = run inlineRecursion(&mut self.resolver, &mut self.query, &mut layoutDependencies, &owner, &owner,
                &mut visiting, declaration.span)
              let recursive = match move recursion {
                Result<bool, Shared<Rejection>>.Success { value } => value
                Result<bool, Shared<Rejection>>.Failure { .. } => false
              }
              if recursive {
                run appendDeclarationRejection(&mut sweep.rejections, run inlineRecursionRejection(module, declaration.span, &owner))
              }
            }
          }
        }
      }
    }
    return ()
  }

  // A runtime declaration needs no invented arguments or providers to select its closed static
  // work. Use the same Body selection as a reached named instance, so closed static-for expansions
  // and static call arguments receive authentic facts before checking. An open template selects
  // over its own unbound binders; work that depends on them was deferred before this sweep.
  effect fn checkedDeclarationBody(
    self: &mut Self,
    request: &mut Request,
    declaration: &DeclarationCheck,
    signature: &Shared<Result<Answer, NoRejection>>
  ) -> Shared<Result<Answer, NoRejection>>
    ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
    ? &mut Allocator | &mut Types {
    if !Shared<Result<Answer, NoRejection>>.with<bool>(signature, signatureIsStatic) {
      let mut selected = declaration.staticWork
      if
        !selected {
        // Static callees also require real selection even without a written static marker.
        let module = DeclarationId.moduleId(&declaration.identity)
        let moduleOrdinal = knownModuleOrdinal(&self.resolver, module)
        let mut dependencies = List<Dependency>.make()
        let routing = run needsStaticResidualization(
          &mut self.resolver,
          &mut self.query,
          &mut dependencies,
          module,
          moduleOrdinal,
          declaration.ordinal
        )
        match move routing {
          Result<bool, Shared<Rejection>>.Success { value } => {
            selected = value
          }
          Result<bool, Shared<Rejection>>.Failure { error } => {
            return run Shared<
              Result<Answer, NoRejection>
            >.make(
              Result<Answer, NoRejection>.succeed(run memberRejected(move error, move dependencies))
            )
          }
        }
      }
      if selected {
        let identity = run Shared<DeclarationId>.make(DeclarationId.copy(&declaration.identity))
        let instance = run InstanceKey.named(&identity)
        let application = run InstanceKey.selected(&instance)
        return run Semantic.demandSelectedBody(&mut self.*, &mut request.*, &application)
      }
    }
    return run Semantic.demandBodyOf(&mut self.*, &mut request.*, &declaration.identity)
  }

  /// The bodies structurally deferred by the last loaded-declaration sweep. This is coverage
  /// evidence, never a checked Body answer. Selected applications still demand their exact Body.
  pub fn deferredStaticTemplates(self: &Self) -> &[DeferredStaticTemplate] {
    return List<DeferredStaticTemplate>.asSlice(&self.deferredTemplates)
  }

  /// The concrete root-package bodies the last loaded-declaration sweep left without borrow
  /// checking, reached or not, in sweep order. Open and deferred templates are not listed: the
  /// instances a build reaches are checked separately. The emitted count covers only the reached
  /// instances, so an unreached unchecked body is visible here alone.
  pub fn uncheckedRootBodies(self: &Self) -> &[UncheckedBody] {
    return List<UncheckedBody>.asSlice(&self.uncheckedRoot)
  }

  // Checks OWN0016 using a MIR-only closure. No declaration added here becomes an emission root.
  // Open templates and provider-dependent declarations keep their Body obligations; they do not
  // acquire fabricated runtime instances merely because the module is loaded.
  effect fn declarationEscapes(
    self: &mut Self,
    request: &mut Request,
    declarations: &[DeclarationId],
    boundary: &Option<WalkBoundary>,
  ) -> DeclarationCheckResult
    ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
    ? &mut Allocator | &mut Types {
    let mut capture = BuildCapture.walk()
    return run Semantic.capturedEscapes(&mut self.*, &mut request.*, declarations, boundary, &mut capture, usize.MAX)
  }

  // The MIR answer of `declaration`'s plain body when an escape walk starts from it: none for an
  // open template, a static body or one with static arguments, and for a body that lowers to none.
  effect fn escapeRootMir(self: &mut Self, request: &mut Request, declaration: &DeclarationId) -> Option<Shared<Result<Answer, NoRejection>>>
    ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
    ? &mut Allocator | &mut Types {
    let signature = run Semantic.demandSignatureOf(&mut self.*, &mut request.*, declaration)
    if run signatureStartsNoWalk(&signature) { return Option<Shared<Result<Answer, NoRejection>>>.none() }
    return run Semantic.demandMirOf(&mut self.*, &mut request.*, declaration)
  }

  // `declarationEscapes`, captured into `capture` as a record of the walk (`BuildRecord`) when
  // `guard` is a unit, which then holds the reads of the walk's growth guards and static closures.
  effect fn capturedEscapes(
    self: &mut Self,
    request: &mut Request,
    declarations: &[DeclarationId],
    boundary: &Option<WalkBoundary>,
    capture: &mut BuildCapture,
    guard: usize,
  ) -> DeclarationCheckResult
    ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
    ? &mut Allocator | &mut Types {
    let capturing = guard != usize.MAX
    let mut pending = List<BackendVisit>.make()
    // How each pending visit was reached, as in a build walk.
    let mut origins = List<VisitOrigin>.make()
    let mut summaries = List<SuspensionSummary>.make()
    let mut result = DeclarationCheckResult {
      rejections: List<Shared<Rejection>>.make(),
      gaps: List<Shared<BackendGap>>.make(),
      unchecked: List<UncheckedDeclaration>.make()
    }
    let mut visited = List<InstanceKey>.make()
    let mut lookup = InternIndex.make()
    let mut admission = Admission.make()
    let mut certified = List<Application>.make()
    let mut certifiedLookup = InternIndex.make()
    let mut cleanupAnswers = List<CleanupAnswer>.make()
    // Plain bodies a bounded walk left to their own module's check, walked after all only when a
    // callback boundary needs the call graph below it (`localSharedEscapes`).
    let mut left = List<BackendVisit>.make()
    let mut leftOrigins = List<VisitOrigin>.make()
    let mut foreign = ForeignDeclarations {seen: List<ForeignDeclaration>.make(), lookup: InternIndex.make()}
    let mut bounded = false
    if let Option<WalkBoundary>.Some {..} = &boundary.* { bounded = true }
    let mut at = usize.ZERO
    while at < declarations.length {
      let declaration = &declarations[at]
      at = at + usize.ONE
      let lowered = run Semantic.escapeRootMir(&mut self.*, &mut request.*, declaration)
      if let Option<Shared<Result<Answer, NoRejection>>>.Some { value: rawAnswer } = move lowered {
        let span = run authoredRequestSpan(
          &mut self.resolver,
          declaration,
          Span.make(usize.ZERO, usize.ZERO)
        )
        let answer = run anchorCanonicalAnswer(&mut self.resolver, &rawAnswer, declaration, span)
        let identity = run Shared<DeclarationId>.make(DeclarationId.copy(declaration))
        let instance = run InstanceKey.named(&identity)
        run appendCheckedAnswer(&mut result.rejections, &mut result.gaps, &mut self.query, declaration, &answer)
        let index = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(&answer, answerMirIndex)
        if let Option<usize>.Some { .. } = move index {
          let module = DeclarationId.moduleId(declaration)
          run List<VisitOrigin>.append(&mut origins, VisitOrigin {parent: usize.MAX, position: List<ContentHash>.length(&capture.roots),
            requested: false})
          if capturing { run List<ContentHash>.append(&mut capture.roots, run keyDigest(&instance, capture.patterns)) }
          run List<
            BackendVisit
          >.append(
            &mut pending,
            BackendVisit.Enter {
              key: move instance,
              edge: Edge.Direct,
              span: span,
              module: ModuleId.copy(module),
              cleanup: Option<Shared<Type>>.none(),
              requester: Option<RelatedSite>.none()
            }
          )
        }
      }
    }
    // Whether the walk already looked for local-shared escapes in the summaries it ends with.
    let mut escapesChecked = false
    while true {
      // A bounded walk that reached a callback access walks the left bodies the callback's calls
      // reach after all, and everything they reach, until no call below a callback is left. Only
      // an escape found then walks every left body, so it is reported as a whole walk reports it.
      if List<BackendVisit>.length(&pending) == usize.ZERO {
        if List<BackendVisit>.length(&left) == usize.ZERO || !anyCallbackAccess(List<SuspensionSummary>.asSlice(&summaries)) {
          break
        }
        pending = run belowCallbacks(List<SuspensionSummary>.asSlice(&summaries), &mut left, &mut leftOrigins, &mut origins)
        if List<BackendVisit>.length(&pending) == usize.ZERO {
          let found = run localSharedEscapes(&self.resolver, List<SuspensionSummary>.asSlice(&summaries))
          if List<Shared<Rejection>>.length(&found) == usize.ZERO {
            escapesChecked = true
            break
          }
          pending = Intrinsic.replace(left, List<BackendVisit>.make())
          origins = Intrinsic.replace(leftOrigins, List<VisitOrigin>.make())
        }
        bounded = false
      }
      let visit = match move List<BackendVisit>.pop(&mut pending) {
        Option<BackendVisit>.Some { value } => move value
        _ => {
          break
        }
      }
      let origin = match move List<VisitOrigin>.pop(&mut origins) {
        Option<VisitOrigin>.Some {value} => value
        Option<VisitOrigin>.None => { return CompilerBug.panic(b"a pending escape visit has no origin") }
      }
      let entered = match move visit {
        BackendVisit.Leave => {
          Admission.leave(&mut admission)
          continue
        }
        BackendVisit.Enter {
          key,
          edge,
          span,
          module,
          cleanup,
          requester
        } => BackendRequest {
          key: move key,
          edge: move edge,
          span: span,
          module: move module,
          cleanup: move cleanup,
          requester: move requester,
        }
      }
      let instance = move entered.key

      // Imported C declarations have checked headers and no authored body to summarize. They
      // remain foreign edges, exactly as in the executable walk; no MIR body is fabricated.
      if run walkedForeign(&mut self.resolver, &mut foreign, &instance) {
        if capturing { run BuildCapture.reached(&mut capture.*, &instance, origin, BuildRecord.FOREIGN) }
        continue
      }
      if bounded {
        if let Option<WalkBoundary>.Some {value: walk} = &boundary.* {
          if run walkedElsewhere(&walk, &instance) {
            if capturing {
              run BuildCapture.reached(&mut capture.*, &instance, origin, BuildRecord.LEFT)
              let reached = List<CaptureEntry>.length(&capture.entries) - usize.ONE
              BuildCapture.flag(&mut capture.*, reached, BuildRecord.FACT_ELSEWHERE)
            }
            run List<BackendVisit>.append(&mut left, BackendVisit.Enter {key: move instance, edge: move entered.edge,
              span: entered.span, module: move entered.module, cleanup: move entered.cleanup, requester: move entered.requester})
            run List<VisitOrigin>.append(&mut leftOrigins, origin)
            continue
          }
        }
      }
      let mut leave = false
      if let Option<Shared<Application>>.Some { .. } = move InstanceKey.application(&instance) {
        let application = run InstanceKey.selected(&instance)

        // A Drop hook drop glue reaches is selected by the cleanup of the value its run started from.
        let mut reaching = move entered.edge
        if let Option<Shared<Type>>.Some { value: owner } = &entered.cleanup {
          reaching = Edge.Cleanup { owner: Shared<Type>.clone(&owner) }
        }
        let enteredEdge = Edge.copy(&reaching)
        let refused = run Admission.enter(&mut admission, &application, move reaching)
        let decision = run admitOwnedDescent(&mut self.resolver, &mut self.query, &mut admission, &application, &enteredEdge, move refused)
        match move decision {
          Decision.Entered => {
            leave = true
          }
          Decision.ChangingStatic { .. } => {
            let mut admitted = false
            let known = List<Application>.asSlice(&certified)
            let mut knownAt = InternIndex.first(&certifiedLookup, Application.hash(&application))
            while knownAt != usize.MAX {
              if run Application.equals(&known[knownAt], &application) {
                admitted = true
                break
              }
              knownAt = InternIndex.after(&certifiedLookup, knownAt)
            }
            if
              !admitted {
              let ancestorPath = run Admission.path(&admission)
              let ancestorSlice = List<Application>.asSlice(&ancestorPath)
              let mut caller = Option<Application>.none()
              if ancestorSlice.length > usize.ZERO {
                caller = Option<
                  Application
                >.some(run Application.copy(&ancestorSlice[ancestorSlice.length - usize.ONE]))
              }
              let incoming = ClosureIncoming {
                caller: move caller,
                edge: Edge.copy(&enteredEdge),
                module: ModuleId.copy(&entered.module),
                span: entered.span
              }
              let recorder = self.resolver.rootRecorder
              if capturing {
                self.resolver.rootRecorder = guard
                capture.guarded = true
              }
              let closure = run closeChain(
                &mut self.*,
                &admission,
                &application,
                move incoming,
                staticClosureNodes
              )
              self.resolver.rootRecorder = recorder
              match move closure {
                StaticClosure.Certified { evidence } => {
                  let reached = List<Application>.asSlice(&evidence.nodes)
                  let mut reachedAt = usize.ZERO
                  while reachedAt < reached.length {
                    run List<
                      Application
                    >.append(&mut certified, run Application.copy(&reached[reachedAt]))
                    run InternIndex.record(
                      &mut certifiedLookup,
                      Application.hash(&reached[reachedAt])
                    )
                    reachedAt = reachedAt + usize.ONE
                  }
                }
                StaticClosure.NotProven { diagnostic } => {
                  run List<Shared<Rejection>>.append(&mut result.rejections, move diagnostic)
                  continue
                }
                StaticClosure.Rejected { diagnostic } => {
                  run List<Shared<Rejection>>.append(&mut result.rejections, move diagnostic)
                  continue
                }
                StaticClosure.Unsupported { gaps: found } => {
                  let reached = List<Shared<BackendGap>>.asSlice(&found)
                  let mut reachedAt = usize.ZERO
                  while reachedAt < reached.length {
                    run List<
                      Shared<BackendGap>
                    >.append(&mut result.gaps, Shared<BackendGap>.clone(&reached[reachedAt]))
                    reachedAt = reachedAt + usize.ONE
                  }
                  continue
                }
              }
            }
            run Admission.enterChain(&mut admission, &application, move enteredEdge)
            leave = true
          }
          Decision.Reused { .. } => {}
          Decision.Open => {
            let identity = InstanceKey.identity(&instance)
            let diagnostic = run reject(
              &self.resolver,
              &entered.module,
              RejectionCode.Unsupported,
              entered.span
            )
            run List<
              Shared<BackendGap>
            >.append(
              &mut result.gaps,
              run Shared<
                BackendGap
              >.make(BackendGap.fromRejection(GapCode.OpenInstance, &identity, &diagnostic),),
            )
            continue
          }
          Decision.Rejected { path } => {
            let recorder = self.resolver.rootRecorder
            if capturing {
              self.resolver.rootRecorder = guard
              capture.guarded = true
            }
            let mut admitted = run cleanupAdmits(
              &mut self.resolver,
              &mut self.query,
              &mut cleanupAnswers,
              &admission,
              &application,
              &enteredEdge,
              List<Application>.asSlice(&path)
            )
            if !admitted {
              admitted = run ownedDescentAdmits(
                &mut self.resolver,
                &mut self.query,
                &mut cleanupAnswers,
                &admission,
                &application,
                List<Application>.asSlice(&path)
              )
            }
            self.resolver.rootRecorder = recorder
            if !admitted {
              run List<
                Shared<Rejection>
              >.append(
                &mut result.rejections,
                run rejectSpecialization(
                  &mut self.resolver,
                  entered.span,
                  Option<RelatedSite>.none(),
                  move path
                )
              )
              continue
            }
            run Admission.enterChain(&mut admission, &application, move enteredEdge)
            leave = true
          }
        }
      }
      // Every region pattern of an application runs one definition, whose MIR is one body
      // (`internBackendInstance`), so a pattern after the first adds nothing to walk; the record
      // names each instance by that definition, and a rewalk visits by it too.
      if run definitionVisited(List<InstanceKey>.asSlice(&visited), &lookup, &instance) {
        if leave {
          Admission.leave(&mut admission)
        }
        continue
      }
      if leave {
        run List<BackendVisit>.append(&mut pending, BackendVisit.Leave)
        run List<VisitOrigin>.append(&mut origins, VisitOrigin {parent: usize.MAX, position: usize.ZERO, requested: false})
      }
      let entry = List<CaptureEntry>.length(&capture.entries)
      if capturing {
        run BuildCapture.enter(&mut capture.*, &instance, origin)
        // A rewalk decides from the record whether a bounded walk would leave the instance.
        if let Option<WalkBoundary>.Some {value: walk} = &boundary.* {
          if run walkedElsewhere(&walk, &instance) { BuildCapture.flag(&mut capture.*, entry, BuildRecord.FACT_ELSEWHERE) }
        }
      }
      run InternIndex.record(&mut lookup, InstanceKey.runtimeHash(&instance))
      run List<InstanceKey>.append(&mut visited, InstanceKey.copy(&instance))
      let identity = DeclarationId.copyShared(&InstanceKey.identity(&instance))
      let answer = run Semantic.demandInstanceMir(
        &mut self.*,
        &mut request.*,
        &instance,
        &identity,
        entered.span,
        false
      )
      let reportedBefore = List<Shared<Rejection>>.length(&result.rejections)
      run appendCheckedAnswer(&mut result.rejections, &mut result.gaps, &mut self.query, &identity, &answer)
      // A refusal inside a toolchain body reached from user code belongs at the user's call.
      let site = requestSite(&entered.requester, &entered.module, entered.span)
      run relocateRequested(&mut result.rejections, reportedBefore, &site.module, site.span)
      let index = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(&answer, answerMirIndex)
      if let Option<usize>.Some { value } = move index {
        let anchor = run instanceAnchor(&mut self.resolver, &instance)
        if capturing { BuildCapture.lowered(&mut capture.*, entry, run instanceMirUnit(&mut self.resolver, &instance, false)) }
        let module = DeclarationId.moduleId(&identity)
        let functions = List<MirFunction>.asSlice(&self.resolver.mirValues)
        let function = &functions[value]
        let summary = run SuspensionSummary.make(function, &instance, module, &anchor, &entered.module, entered.span)
        if capturing {
          let digest = run summaryDigest(&summary, function.observes, capture.patterns)
          run BuildCapture.references(&mut capture.*, entry, &instance, List<MirReference>.asSlice(&function.references), digest)
          run BuildCapture.walked(&mut capture.*, entry, &summary)
        }
        run List<SuspensionSummary>.append(&mut summaries, move summary)
        let mut cleanup = copyCleanupRoot(&entered.cleanup)
        if let Option<Shared<Type>>.Some { value: root } = move InstanceKey.glueType(&instance) {
          if let Option<Shared<Type>>.None = &cleanup {
            cleanup = Option<Shared<Type>>.some(move root)
          }
        }
        let references = List<MirReference>.asSlice(&function.references)
        at = references.length
        while at > usize.ZERO {
          at = at - usize.ONE
          run List<
            BackendVisit
          >.append(
            &mut pending,
            BackendVisit.Enter {
              key: InstanceKey.copy(&references[at].key),
              edge: Edge.copy(&references[at].edge),
              span: anchoredSpan(&anchor, references[at].origin),
              module: ModuleId.copy(module),
              cleanup: copyCleanupRoot(&cleanup),
              requester: successorRequester(&entered.requester, &entered.module, entered.span, module)
            }
          )
          run List<VisitOrigin>.append(&mut origins, VisitOrigin {parent: entry, position: at, requested: false})
        }
      }
    }
    let mut escapes = List<Shared<Rejection>>.make()
    if !escapesChecked { escapes = run localSharedEscapes(&self.resolver, List<SuspensionSummary>.asSlice(&summaries)) }
    let found = List<Shared<Rejection>>.asSlice(&escapes)
    at = usize.ZERO
    while at < found.length {
      run appendDeclarationRejection(&mut result.rejections, Shared<Rejection>.clone(&found[at]))
      at = at + usize.ONE
    }
    return move result
  }

  /// The selected import members that IMPORT-003 rejects (unknown, private, or claimed twice) in
  /// every loaded module, checked when the module is reached rather than when a use demands the
  /// member. Checking a member can load the module it names, whose imports are checked in turn.
  pub effect fn importRejections(self: &mut Self, request: &mut Request) -> List<Shared<Rejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
    let mut rejections = List<Shared<Rejection>>.make()
    let mut at = usize.ZERO
    while at < SourceIndex.slotCount(&self.resolver.source) {
      let present = match move SourceIndex.presentModule(&self.resolver.source, at) {
        Option<&ModuleId>.Some {value} => Option<ModuleId>.some(ModuleId.copy(value))
        Option<&ModuleId>.None => Option<ModuleId>.none()
      }
      if let Option<ModuleId>.Some {value: module} = move present {
        let mut found = run Semantic.moduleImportRejections(&mut self.*, &mut request.*, &module)
        while List<Shared<Rejection>>.length(&found) > usize.ZERO {
          run List<Shared<Rejection>>.append(&mut rejections, List<Shared<Rejection>>.remove(&mut found, usize.ZERO))
        }
      }
      at = at + usize.ONE
    }
    return move rejections
  }
  /// The selected members of `module`'s active imports that IMPORT-003 rejects, in written order.
  /// A revisable store keeps the check as a module check unit, so a cache image holds a module
  /// whose imports were clean and the next process takes it without reading the module.
  pub effect fn moduleImportRejections(self: &mut Self, request: &mut Request, module: &ModuleId) -> List<Shared<Rejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
    run selectRequest(&mut self.resolver, &request.*)
    let moduleOrdinal = run internModule(&mut self.resolver, module)
    if !Graph.recording(&self.resolver.graph) { return run Semantic.importChecks(&mut self.*, module, moduleOrdinal) }
    let word = run internKey(&mut self.resolver, Key {family: Family.ModuleCheck, module: moduleOrdinal, name: 5,
      declaration: usize.MAX, member: usize.ZERO, external: false})
    let unit = u64.toUsize(word.value)
    let found = memoOf(List<ModuleCheckMemo>.asSlice(&self.moduleMemos), unit)
    if found != usize.MAX {
      if run Semantic.unitCurrent(&mut self.*, unit) {
        let memos = List<ModuleCheckMemo>.asSlice(&self.moduleMemos)
        return run copyRejections(List<Shared<Rejection>>.asSlice(&memos[found].sweep.rejections))
      }
      drop List<ModuleCheckMemo>.remove(&mut self.moduleMemos, found)
      uncarry(&mut self.carriedUnits, &mut self.carriedRoots, unit)
    }
    run Graph.startRun(&mut self.resolver.graph, unit)
    self.resolver.runs = self.resolver.runs + usize.ONE
    self.resolver.rootRecorder = unit
    let attempted = run Effect.result(Semantic.importChecks(&mut self.*, module, moduleOrdinal))
    self.resolver.rootRecorder = usize.MAX
    // A failed check keeps no memo, so the next one runs again whatever its unit's edges say.
    let rejections = match move attempted {
      Result<List<Shared<Rejection>>, Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError>.Success {value} => move value
      Result<List<Shared<Rejection>>, Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError>.Failure {error} => { fail move error }
    }
    drop run Graph.finishRun(&mut self.resolver.graph, unit, Option<ContentHash>.none())
    let mut sweep = Sweep.make()
    sweep.rejections = run copyRejections(List<Shared<Rejection>>.asSlice(&rejections))
    run List<ModuleCheckMemo>.append(&mut self.moduleMemos, ModuleCheckMemo {unit: unit, sweep: move sweep,
      deferred: List<DeferredStaticTemplate>.make(), unchecked: List<UncheckedBody>.make()})
    return move rejections
  }
  effect fn importChecks(self: &mut Self, module: &ModuleId, moduleOrdinal: usize) -> List<Shared<Rejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
    let mut rejections = List<Shared<Rejection>>.make()
    let selections = run selectedImportMembers(&mut self.resolver, module)
    let listed = List<ImportMembers>.asSlice(&selections)
    let span = Span.make(usize.ZERO, usize.ZERO)
    // Governing conditions are observed without a dependent answer, as for build roots.
    let mut conditions = List<Dependency>.make()
    let mut at = usize.ZERO
    while at < listed.length {
      let active = run available(&mut self.resolver, &mut self.query, &mut conditions, module, listed[at].declaration, span)
      let mut selected = false
      match move active {
        Result<bool, Shared<Rejection>>.Success {value} => { selected = value }
        Result<bool, Shared<Rejection>>.Failure {error} => { run List<Shared<Rejection>>.append(&mut rejections, move error) }
      }
      let mut member = usize.ZERO
      while selected && member < listed[at].members {
        let declarationAccess253Request = Key {
          family: Family.Import, module: moduleOrdinal, name: usize.ZERO,
          declaration: listed[at].declaration, member: member, external: false,
        }
        let declarationAccess253 = run internDeclaration(&mut self.resolver, declarationAccess253Request)
        let answer = run demandRaw(&mut self.resolver, &mut self.query, declarationAccess253, span)
        let reported = run reportedDiagnostics(&mut self.query, &answer)
        let listed = List<Shared<Rejection>>.asSlice(&reported)
        let mut reportedAt = usize.ZERO
        while reportedAt < listed.length {
          run List<Shared<Rejection>>.append(&mut rejections, Shared<Rejection>.clone(&listed[reportedAt]))
          reportedAt = reportedAt + usize.ONE
        }
        member = member + usize.ONE
      }
      at = at + usize.ONE
    }
    return move rejections
  }
  /// Borrows the module whose namespace or declaration a recorded dependency demanded.
  pub fn dependencyModule(self: &Self, dependency: &Dependency) -> &ModuleId {
    let modules = List<ModuleId>.asSlice(&self.resolver.modules)
    return &modules[dependency.module]
  }
  /// Borrows the demanded spelling of a name dependency, absent for other families.
  pub fn dependencyName(self: &Self, dependency: &Dependency) -> Option<&[u8]> {
    if dependency.family != Family.Name {
      return Option<&[u8]>.none()
    }
    return Option<&[u8]>.some(StringTable.get(&self.resolver.names, Symbol {index: dependency.name}))
  }
  /// Copies the canonical declaration a declaration dependency demanded, in the held source
  /// revision. Other families and lost declaration handles return `None`.
  pub effect fn dependencyDeclaration(
    self: &mut Self,
    dependency: &Dependency
  ) -> Option<DeclarationId>
    ! Cycle | OutOfMemoryError
    ? &mut Allocator {
    if dependency.declaration == usize.MAX {
      return Option<DeclarationId>.none()
    }
    let module = resolvedModule(&self.resolver, dependency.module)
    drop run demandSource(&mut self.resolver, &module)
    let position = DeclarationTable.position(&self.resolver.declarations, dependency.declaration)
    return run declarationAt(&mut self.resolver, &module, position)
  }
  /// Copies named authored addresses and actual import namespaces from one canonical source.
  /// Syntax does not admit bodies. Absent source and condition/import refusals retain observations.
  pub effect fn demandSourceInventory(self: &mut Self, request: &mut Request, module: &ModuleId) -> SourceInventory
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
    run selectRequest(&mut self.resolver, &request.*)
    let answer = run source(&mut self.resolver, module)
    let observation = run SourceIndex.captureObservation(&self.resolver.source, module)
    let indexed = match move sourceOf(&self.resolver, &answer, module) {
      Option<&IndexedSource>.Some {value} => value
      Option<&IndexedSource>.None => {
        if Observation.isPresent(&observation) { fail RevisionMismatch {} }
        return SourceInventory.Absent {observation: move observation}
      }
    }
    let sourceDigest = Sha256.hash(SourceUnit.bytes(IndexedSource.sourceUnit(indexed)))
    let copied = run ModuleIndex.copyFunctionInventory(IndexedSource.moduleIndex(indexed), IndexedSource.sourceUnit(indexed))
    let mut syntax = match move copied {
      Option<FunctionInventory>.Some {value} => move value
      Option<FunctionInventory>.None => { fail RevisionMismatch {} }
    }
    let authenticated = run SourceIndex.authoredCursor(&mut self.resolver.source, &answer, module)
    let cursor = match move authenticated {
      Option<AuthoredCursor>.Some {value} => move value
      Option<AuthoredCursor>.None => { fail RevisionMismatch {} }
    }
    let owned = List<NamedFunction>.asMutSlice(&mut syntax.functions)
    let mut checked = usize.ZERO
    while checked < owned.length {
      let nameSpan = SourceIndex.authoredSpan(&self.resolver.source, &cursor, owned[checked].name)
      owned[checked].nameSpan = match move nameSpan {
        Option<Span>.Some {value} => value
        Option<Span>.None => { fail RevisionMismatch {} }
      }
      checked = checked + usize.ONE
    }
    drop answer
    let mut availability = List<Result<bool, Shared<Rejection>>>.make()
    let functions = List<NamedFunction>.asSlice(&syntax.functions)
    let mut at = usize.ZERO
    while at < functions.length {
      run List<Result<bool, Shared<Rejection>>>.append(&mut availability,
        run requestAvailability(&mut self.resolver, &mut self.query, &mut request.*, module, functions[at].ordinal, functions[at].headerSpan))
      at = at + usize.ONE
    }
    let moduleOrdinal = run internModule(&mut self.resolver, module)
    let mut imports = List<InventoryImport>.make()
    let written = List<IndexedDeclaration>.asSlice(&syntax.imports)
    at = usize.ZERO
    while at < written.length {
      let identity = run Shared<DeclarationId>.make(DeclarationId.copy(&written[at].identity))
      let found = run ordinalOfIdentity(&mut self.resolver, module, &identity)
      if let Option<usize>.Some {value: declaration} = move found {
        let declarationAccess254Request = Key {
          family: Family.Import, module: moduleOrdinal, name: usize.ZERO,
          declaration: declaration, member: usize.MAX, external: false,
        }
        let declarationAccess254 = run internDeclaration(&mut self.resolver, declarationAccess254Request)
        let target = run demandRaw(&mut self.resolver, &mut self.query, declarationAccess254, Span.make(usize.ZERO, usize.ZERO))
        let spelled = run DeclarationId.copySpelling(&written[at].identity)
        run recordRoot(&mut request.*, Family.Import, module, Bytes.asSlice(&spelled), &target)
        run List<InventoryImport>.append(&mut imports, InventoryImport {
          declaration: DeclarationId.copy(&written[at].identity), answer: move target,
        })
      } else { fail RevisionMismatch {} }
      at = at + usize.ONE
    }
    return SourceInventory.Present {observation: move observation, sourceDigest: sourceDigest,
      syntax: move syntax, availability: move availability, imports: move imports}
  }
  /// Resolves a nongeneric type alias only when the caller requests its target.
  /// Returns an anchored rejection for an absent name, unsupported target, or alias cycle.
  pub effect fn demandAlias(self: &mut Self, request: &mut Request, module: &ModuleId, name: &[u8]) -> Shared<
    Result<Answer, NoRejection>,
  > ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
    run selectRequest(&mut self.resolver, &request.*)
    let answer = run demandNamed(&mut self.resolver, &mut self.query, module, name, Family.Alias)
    run recordRoot(&mut request.*, Family.Alias, module, name, &answer)
    return move answer
  }
  /// Returns a nongeneric nominal identity without resolving fields, members, or layout.
  /// Returns an anchored rejection if the name does not identify a supported nominal declaration.
  pub effect fn demandIdentity(
    self: &mut Self,
    request: &mut Request,
    module: &ModuleId,
    name: &[u8],
  ) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
    run selectRequest(&mut self.resolver, &request.*)
    let answer = run demandNamed(&mut self.resolver, &mut self.query, module, name, Family.Identity)
    run recordRoot(&mut request.*, Family.Identity, module, name, &answer)
    return move answer
  }
  /// Enumerates the written fields, tuple positions, enum cases, or union variants of a nominal.
  /// Member types and target layout remain undemanded.
  pub effect fn demandMembers(
    self: &mut Self,
    request: &mut Request,
    module: &ModuleId,
    name: &[u8],
  ) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
    run selectRequest(&mut self.resolver, &request.*)
    let answer = run demandNamed(&mut self.resolver, &mut self.query, module, name, Family.Members)
    run recordRoot(&mut request.*, Family.Members, module, name, &answer)
    return move answer
  }
  /// Resolves only one member's written types under a canonical nominal application.
  /// A struct field or tuple position has one type; a union variant has its ordered payload
  /// types; a scalar enum case has none. The member is selected by its enumeration ordinal.
  pub effect fn demandMemberShape(
    self: &mut Self,
    request: &mut Request,
    module: &ModuleId,
    name: &[u8],
    member: usize,
    application: &Shared<Type>,
  ) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
    run selectRequest(&mut self.resolver, &request.*)
    let moduleOrdinal = run internModule(&mut self.resolver, module)
    let nameOrdinal = run internName(&mut self.resolver, name)
    let declarationAccess255Request = Key {
      family: Family.Name,
      module: moduleOrdinal,
      name: nameOrdinal,
      declaration: usize.ZERO,
      member: usize.ZERO,
      external: false,
    }
    let declarationAccess255 = run internDeclaration(&mut self.resolver, declarationAccess255Request)
    let bucketKey = declarationAccess255
    let observed = run demandRaw(
      &mut self.resolver,
      &mut self.query,
      bucketKey,
      Span.make(usize.ZERO, usize.ZERO),
    )
    if Shared<Result<Answer, NoRejection>>.with<bool>(&observed, hasRejection) {
      run recordRoot(&mut request.*, Family.MemberShape, module, name, &observed)
      return move observed
    }
    drop observed
    // A root lookup observes governing conditions without a dependent answer.
    let mut rootConditions = List<Dependency>.make()
    let selectedSelection = run select(&mut self.resolver, &mut self.query, &mut rootConditions, module, name, false)
    let selected = match move selectedSelection {
      Result<Selection, Shared<Rejection>>.Success {value: selectedValue} => selectedValue
      Result<Selection, Shared<Rejection>>.Failure {error} => {
        let kept = run rootRejection(&mut self.resolver, module, move error)
        run recordRoot(&mut request.*, Family.MemberShape, module, name, &kept)
        return move kept
      }
    }
    if selected.count != usize.ONE || selected.kind != CandidateKind.Declaration {
      let mut code = RejectionCode.Collision
      if selected.count == usize.ZERO {
        code = RejectionCode.UnknownType
      } else if selected.kind != CandidateKind.Declaration {
        code = RejectionCode.NotType
      }
      let rejected = run rejectRoot(&mut self.resolver, module, bucketKey, code, selected.span)
      run recordRoot(&mut request.*, Family.MemberShape, module, name, &rejected)
      return move rejected
    }
    let applicationOrdinal = run internApplication(&mut self.resolver, application)
    let declarationAccess256Request = Key {
      family: Family.MemberShape,
      module: moduleOrdinal,
      name: applicationOrdinal,
      declaration: selected.declaration,
      member: member,
      external: false,
    }
    let declarationAccess256 = run internDeclaration(&mut self.resolver, declarationAccess256Request)
    let key = declarationAccess256
    let answer = run demandRaw(&mut self.resolver, &mut self.query, key, selected.span)
    run recordRoot(&mut request.*, Family.MemberShape, module, name, &answer)
    return move answer
  }
  /// Resolves the binders and declared bounds of a type, alias, interface, or service declaration.
  ///
  /// # Details
  ///
  /// This does not demand the declaration's identity or members, and it proves no bound; an
  /// application of a bounded declaration is rejected as unsupported where it is written.
  pub effect fn demandContract(
    self: &mut Self,
    request: &mut Request,
    module: &ModuleId,
    name: &[u8],
