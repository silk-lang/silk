          Option<NominalUnion>.None => { return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span) }
        }
        let selected = run selectedVariant(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, &target.ty,
