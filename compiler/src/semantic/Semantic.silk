            }
          }
        }
      }
      ty = move element
      form = BodyExpression.Index {value: subjectNode, index: indexNode}
    }
    Node.RecordExpression {fields} => {
      if staticBody { return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span) }
      let mut recordType = match move namedAggregateExpectation(expected, OwnerKind.Struct) {
        Option<Shared<Type>>.Some {value} => value
        Option<Shared<Type>>.None => {
          return run checkAnonymousAggregate(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
            module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*,
            expression, fields, false, expected, constraints, contractBody, unsafeAllowed, span)
        }
      }
      let mut inference = Option.none<InferredAggregateTarget>()
      if opaqueConstruction {
        inference = match move run inferredContextualAggregate(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, caller, &recordType, span) {
          Result<Option<InferredAggregateTarget>, Shared<Rejection>>.Success {value} => move value
          Result<Option<InferredAggregateTarget>, Shared<Rejection>>.Failure {error} => { return Result.failResult<BodyNodeId, Shared<Rejection>>(move error) }
        }
      }
      if let Option<InferredAggregateTarget>.Some {value} = &inference { recordType = Shared.clone<Type>(&value.ty) }
      let checkedFields = run checkRecordFields(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
        module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*,
        &recordType, &inference, fields, constraints, contractBody, unsafeAllowed, span)
      let completed = match move checkedFields {
        Result<CheckedRecordFields, Shared<Rejection>>.Success {value} => value
        Result<CheckedRecordFields, Shared<Rejection>>.Failure {error} => {
          return Result.failResult<BodyNodeId, Shared<Rejection>>(move error)
        }
      }
      if let Option<InferredAggregateTarget>.Some {..} = &inference {
        return run finishExpression(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, caller, constraints, &mut nodes.*,
          expression, span, move completed.ty,
          BodyExpression.Aggregate {fields: move completed.fields}, false, &Option.none<Shared<Type>>(), contractBody, false)
      }
      ty = move completed.ty
      form = BodyExpression.Aggregate {fields: move completed.fields}
    }
    Node.MemberExpression {selector, fields} => {
      if staticBody { return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span) }
      let mut subject = HirId {index: usize.ZERO}
      let mut member = HirId {index: usize.ZERO}
      match run bodyNode(&resolver.source, cursor, selector) {
        Node.MemberSelector {subject: writtenSubject, member: writtenMember} => {
          subject = writtenSubject
          member = writtenMember
        }
        _ => { return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span) }
      }
      let resolved = run recordAnnotation(
        &mut resolver.*, &mut owner.*, &mut dependencies.*, module, caller, subject, span, constraints,
      )
      let unionType = match move resolved {
        Result<Shared<Type>, Shared<Rejection>>.Success {value} => value
        Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
          return Result.failResult<BodyNodeId, Shared<Rejection>>(move error)
