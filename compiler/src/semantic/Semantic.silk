        }
        let ordinal = checkedScalar.ordinal
        let checkedPattern = move checkedScalar.pattern
        let mut checkedGuard = Option.none<BodyNodeId>()
        if guard.present {
          let tested = run checkMatchGuard(&mut resolver.*, &mut owner.*, &mut request.*,
            &mut dependencies.*, module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*,
            &mut signatures.*, &mut requiredBodies.*, guard.id, constraints, contractBody, unsafeAllowed)
          let guardNode = match move tested {
            Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
            Result<BodyNodeId, Shared<Rejection>>.Failure {error} => {
