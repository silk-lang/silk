struct CallPrefix {
  arguments: Vector<Argument>
  slots: Vector<CallPrefixSlot>
  owner: Option<Shared<DeclarationId>>
  lifetimes: usize
}

// Advisory positions for selecting a named callable, separate from a concrete expected type.
// The pending owner is the consumer call's private inference identity, never the target's.
struct NamedCallableEvidence {
  contract: Shared<Type>
  pending: Option<DeclarationId>
}

// A selected body's static result for one authored syntax node. The checker consumes these
// facts; it never evaluates static work itself.
union SelectionFact {
  // A static value used at runtime at its exact type: a `let static` read or static-helper call.
  Embedded {value: Shared<StaticData>, ty: Shared<Type>},
  // The evaluated condition of one static conditional.
  Condition {selected: bool},
  // A `let static` statement and its value, which has no runtime local.
  StaticBinding {value: Shared<StaticData>},
  // A call to a runtime function with `static` parameters: the values the selection pass
  // evaluated for them, at the callee's original parameter indices.
  StaticArguments {slots: Shared<Vector<StaticSlot>>},
  StaticFor {iterations: Shared<Vector<IterationFacts>>},
}

struct IterationFacts {
  ordinal: usize
  calls: Vector<ResolvedCall>
}

// An authored name resolves to a source function, a constant, a sealed primitive, or a selected
// body's static fact.
union ResolvedTarget {
  Function {target: CallTarget},
  Constant {declaration: DeclarationId, ty: Shared<Type>},
  /// An imported C static read by value, with its admitted scalar or pointer type.
  ForeignStatic {declaration: DeclarationId, ty: Shared<Type>},
  Intrinsic {member: IntrinsicMember, typeArguments: Vector<Shared<Type>>},
  /// A sealed Effect composition intrinsic and its written type and row arguments.
  Composition {operation: Composition, written: Vector<Argument>},
  /// A sealed core storage primitive and its written type arguments.
  Storage {operation: StorageOperation, typeArguments: Vector<Shared<Type>>},
  Tuple {ty: Shared<Type>, elements: Vector<Shared<Type>>},
  Selected {fact: SelectionFact},
}

// A selected static operation. The caller uses the contract signature, while `implementation`
// names the concrete body required at runtime; a declared bound has no concrete body yet, and a
// scalar intrinsic witness runs in place without one.
struct OperationCall {
  operation: DeclarationId
  implementation: Option<Shared<DeclarationId>>
  signature: Shared<Result<Answer, NoRejection>>
  proof: ConformanceProof
  receiver: Option<ReceiverPosition>
}

struct OperatorCandidate {
  contract: Shared<Type>
  provider: Shared<Type>
  operationModule: usize
  operationOrdinal: usize
}

struct SelectedOperator {
  contract: Shared<Type>
  provider: Shared<Type>
  call: OperationCall
}

// Duplicate bound spellings or the same head observed from two permitted owner buckets still
// name one supplier. Coherence of that exact goal is checked by the common proof after selection.
effect fn addOperatorCandidate(
  suppliers: &mut Vector<OperatorCandidate>,
  choice: &mut CallSelection,
  contract: &Shared<Type>,
  provider: &Shared<Type>,
  operationModule: usize,
  operationOrdinal: usize,
) -> () ! OutOfMemoryError ? &mut Allocator {
  let listed = Vector.asSlice<OperatorCandidate>(&suppliers.*)
  let mut at = usize.ZERO
  while at < listed.length {
    if listed[at].operationModule == operationModule && listed[at].operationOrdinal == operationOrdinal {
      let sameContract = run Type.equalsShared(&listed[at].contract, contract)
      let sameProvider = run Type.equalsShared(&listed[at].provider, provider)
      if sameContract && sameProvider {
        return ()
      }
    }
    at = at + usize.ONE
  }
  let ordinal = Vector.length<OperatorCandidate>(&suppliers.*)
  run Vector.append<OperatorCandidate>(
    &mut suppliers.*,
    OperatorCandidate {
      contract: Shared.clone<Type>(contract),
      provider: Shared.clone<Type>(provider),
      operationModule: operationModule,
      operationOrdinal: operationOrdinal,
    },
  )
  CallSelection.add(&mut choice.*, ordinal)
  return ()
}

struct ReceiverPosition {
  ordinal: usize
  mode: BodyReceiverPass
}

struct MethodSupplier {
  contract: Shared<Type>
  operationModule: usize
  operationOrdinal: usize
  receiver: ReceiverPosition
}

struct SelectedReceiverOperation {
  contract: Shared<Type>
  call: OperationCall
}

union ReceiverCallChoice {
  Inherent {target: CallTarget, receiver: ReceiverPosition},
  Interface {selected: SelectedReceiverOperation},
}

struct VisibleName {
  module: usize
