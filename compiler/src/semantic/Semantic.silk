  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
    run selectRequest(&mut self.resolver, &request.*)
    let answer = run demandNamed(&mut self.resolver, &mut self.query, module, name, Family.Contract)
    run recordRoot(&mut request.*, Family.Contract, module, name, &answer)
    return move answer
  }
  /// Resolves the variance of each binder of a struct, tuple, union, or enum (LIFE-002), as
  /// `Value.Variance` in complete binder order.
  ///
  /// # Details
  ///
  /// Only binders and member shapes are read, never a body or a layout. A recursive or mutually
  /// recursive declaration reaches its least fixed point inside the one query, so ordinary
  /// recursion is not a cycle. Any other declaration rejects as unsupported.
  pub effect fn demandVariance(
    self: &mut Self,
    request: &mut Request,
    module: &ModuleId,
    name: &[u8],
  ) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
    run selectRequest(&mut self.resolver, &request.*)
    let answer = run demandNamed(&mut self.resolver, &mut self.query, module, name, Family.Variance)
    run recordRoot(&mut request.*, Family.Variance, module, name, &answer)
    return move answer
  }
  /// Resolves what cleanup of a struct, tuple, union, or enum observes of each binder (LIFE-005),
  /// as `Value.DropObservation` in complete binder order.
  ///
  /// # Details
  ///
  /// Only binders, member shapes and the implementation shapes that may hold a `Drop` hook are
  /// read. Recursion is resolved inside the one query, as for `demandVariance`.
  pub effect fn demandDropObservation(
    self: &mut Self,
    request: &mut Request,
    module: &ModuleId,
    name: &[u8],
  ) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
