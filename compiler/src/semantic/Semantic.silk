            }
          }
          checkedGuard = Option.some<BodyNodeId>(guardNode)
        } else if ordinal == usize.MAX {
          universal = true
        } else {
          let mut marks = Vector.asMutSlice<bool>(&mut covered)
          marks[ordinal] = true
          coveredCount = coveredCount + usize.ONE
        }
        let checkedResult = run checkArmResult(&mut resolver.*, &mut owner.*, &mut request.*,
          &mut dependencies.*, module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*,
          &mut signatures.*, &mut requiredBodies.*, HirRef.of(result), armId, &resultType, constraints, contractBody, unsafeAllowed)
        let armResult = match move checkedResult {
          Result<CheckedArmResult, Shared<Rejection>>.Success {value} => value
          Result<CheckedArmResult, Shared<Rejection>>.Failure {error} => {
            return Result.failResult<BodyNodeId, Shared<Rejection>>(move error)
          }
        }
        let resultNode = armResult.node
        // Only expression arms supply the expected type of later expression arms; a block never does.
        let unset = match &resultType {
          Option<Shared<Type>>.Some {..} => false
          Option<Shared<Type>>.None => true
        }
        if unset && !armResult.block {
          if let Option<Shared<Type>>.Some {value: produced} = &armResult.ty {
            if !Shared.with<Type, bool>(&produced, joinableEffect) { resultType = Option.some<Shared<Type>>(Shared.clone<Type>(&produced)) }
          }
        }
        run joinArm(&mut join, Vector.length<BodyMatchArm>(&checkedArms), &armResult.ty)
        run Vector.append<BodyMatchArm>(&mut checkedArms, BodyMatchArm {
          origin: BodyOrigin {syntax: armId, span: armSpan},
          pattern: move checkedPattern, tests: Vector.make<BodyPatternTest>(), guard: move checkedGuard, result: resultNode,
          bindings: Vector.make<BodyNodeId>(),
        })
        at = at + usize.ONE
      }
      if !universal && coveredCount != count {
        return run bodyRejection(&resolver.*, module, RejectionCode.MissingEnumMember, span)
      }
      drop resultType
      let matchType = match move run joinedMatchType(&resolver.*, module, &mut nodes.*, &mut checkedArms, move join, span) {
        Result<Shared<Type>, Shared<Rejection>>.Success {value} => value
        Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result.failResult<BodyNodeId, Shared<Rejection>>(move error) }
      }
      let diverges = Shared.with<Type, bool>(&matchType, neverType)
      let index = Vector.length<BodyNode>(&nodes.*)
      run Vector.append<BodyNode>(&mut nodes.*, BodyNode {
        origin: BodyOrigin {syntax: expression, span: span},
        kind: BodyNodeKind.Expression {ty: move matchType, form: BodyExpression.Match {subject: subjectNode, access: move subjectAccess,
          tags: usize.ZERO, domain: count, arms: move checkedArms, syntax: BodyMatchSyntax.Match}},
      })
      // A match whose arms all transfer is `never`, which every context accepts.
      if diverges { return Result.succeed<BodyNodeId, Shared<Rejection>>(BodyNodeId {index: index}) }
      return run checkExpectedValue(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, caller, constraints, &mut nodes.*,
        BodyNodeId {index: index}, expected, span)
    }
    Node.BorrowExpression {access, operand} => {
      let checked = run checkBorrowOperand(&mut resolver.*, &mut owner.*, &mut request.*,
        &mut dependencies.*, module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*,
        &mut requiredBodies.*, expression, access, operand, expected, false, expression.index,
        constraints, contractBody, staticBody, unsafeAllowed)
      let borrowed = match move checked {
        Result<CheckedBorrow, Shared<Rejection>>.Success {value} => move value
        Result<CheckedBorrow, Shared<Rejection>>.Failure {error} => {
          return Result.failResult<BodyNodeId, Shared<Rejection>>(move error)
        }
      }
      ty = move borrowed.ty
      form = BodyExpression.Borrow {access: access, value: borrowed.value}
    }
    Node.ReferentExpression {subject} => {
      if staticBody {
        return run bodyRejection(&resolver.*, module, RejectionCode.StaticPhaseViolation, span)
      }
      let checked = run checkExpression(
        &mut resolver.*,
        &mut owner.*,
        &mut request.*,
        &mut dependencies.*,
        module,
        cursor,
        caller,
        &mut statementScope.*,
        calls,
        &mut nodes.*,
        &mut signatures.*,
        &mut requiredBodies.*,
        subject,
        &Option.none<Shared<Type>>(),
        constraints,
        contractBody,
        staticBody,
        unsafeAllowed,
      )
      let operandNode = match move checked {
        Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
        Result<BodyNodeId, Shared<Rejection>>.Failure {error} => {
          return Result.failResult<BodyNodeId, Shared<Rejection>>(move error)
        }
      }
      let subjectType = match move bodyExpressionType(
        Vector.asSlice<BodyNode>(&nodes.*),
        &operandNode,
      ) {
        Option<Shared<Type>>.Some {value} => value
        Option<Shared<Type>>.None => {
          return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
        }
      }
      let rawPointer = Shared.with<Type, bool>(
        &subjectType,
        fn(value: &Type) -> bool {
          return match & value.* {
            Type.Pointer {..} => true
            _ => false
          }
        },
      )
      if rawPointer && !unsafeAllowed {
        return run bodyRejection(&resolver.*, module, RejectionCode.UnsafeAcknowledgement, span)
      }
      let pointee = Shared.with<Type, Option<Shared<Type>>>(
        &subjectType,
        fn(value: &Type) -> Option<Shared<Type>> {
          return match & value.* {
            Type.Reference {referent, ..} => Option.some<Shared<Type>>(
              Shared.clone<Type>(&referent),
            )
            Type.Pointer {pointee, nullable, multiplicity, ..} => {
              if unsafeAllowed && !nullable && multiplicity == Multiplicity.Single {
                return Option.some<Shared<Type>>(Shared.clone<Type>(&pointee))
              }
              return Option.none<Shared<Type>>()
            }
            _ => Option.none<Shared<Type>>()
          }
        },
      )
      ty = match move pointee {
        Option<Shared<Type>>.Some {value} => value
        Option<Shared<Type>>.None => {
          return run bodyRejection(&resolver.*, module, RejectionCode.TypeMismatch, span)
        }
      }
      form = BodyExpression.Dereference {value: operandNode}
    }
    Node.UnsafeExpression {..} => {
      return run bodyRejection(&resolver.*, module, RejectionCode.UnsafeInvocation, span)
    }
    Node.MoveExpression {operand} => {
      // A move records the place it consumes; a later safety stage checks that the place is still
      // owned here. Static bodies move only a named local as a whole.
      if staticBody {
        if let Node.IdentifierExpression {binding, ..} = run bodyNode(
          &resolver.source,
          cursor,
          operand,
        ) {
          if !binding.present {
            return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
          }
        } else {
          return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
        }
      }
      let checked = run checkExpression(
        &mut resolver.*,
        &mut owner.*,
        &mut request.*,
        &mut dependencies.*,
        module,
        cursor,
        caller,
        &mut statementScope.*,
        calls,
        &mut nodes.*,
        &mut signatures.*,
        &mut requiredBodies.*,
        operand,
        // A move transfers the place's stored value; its operand is not constructed from the
        // surrounding value context. Preserve that exact stored type here, then admit the
        // completed move at the ordinary expected-value boundary below.
        &Option.none<Shared<Type>>(),
        constraints,
        contractBody,
        staticBody,
        unsafeAllowed,
      )
      let operandNode = match move checked {
        Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
        Result<BodyNodeId, Shared<Rejection>>.Failure {error} => {
          return Result.failResult<BodyNodeId, Shared<Rejection>>(move error)
        }
      }
      ty = match & Vector.asSlice<BodyNode>(&nodes.*)[operandNode.index].kind {
        BodyNodeKind.Expression {ty: operandType, ..} => Shared.clone<Type>(&operandType)
        _ => {
          return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
        }
      }
      let consumed = match move run consumedPlace(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor, Vector.asSlice<BodyNode>(&nodes.*), operandNode, false, false, span, span, constraints) {
        Result<Option<BodyConsumedPlace>, Shared<Rejection>>.Success {value} => value
        Result<Option<BodyConsumedPlace>, Shared<Rejection>>.Failure {error} => {
          return Result.failResult<BodyNodeId, Shared<Rejection>>(move error)
        }
      }
      form = BodyExpression.Move {value: operandNode, consumed: move consumed}
    }
    Node.PrefixExpression {operator, operatorAnchor, operand} => {
      let checked = run checkExpression(
        &mut resolver.*,
        &mut owner.*,
        &mut request.*,
        &mut dependencies.*,
        module,
        cursor,
        caller,
        &mut statementScope.*,
        calls,
        &mut nodes.*,
        &mut signatures.*,
        &mut requiredBodies.*,
        operand,
        expected,
        constraints,
        contractBody,
        staticBody,
        unsafeAllowed,
      )
      let operandNode = match move checked {
        Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
        Result<BodyNodeId, Shared<Rejection>>.Failure {error} => {
          return Result.failResult<BodyNodeId, Shared<Rejection>>(move error)
        }
      }
      let operandType = match move bodyExpressionType(
        Vector.asSlice<BodyNode>(&nodes.*),
        &operandNode,
      ) {
        Option<Shared<Type>>.Some {value} => value
        Option<Shared<Type>>.None => {
          return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, operatorAnchor)
        }
      }
      let family = run operatorFamily(&mut resolver.*, &operandType)
      let concrete = Operator.prefix(operator, family)
      let closed = match & concrete {
        Option<Operator.ResultType>.Some {value: _} => true
        Option<Operator.ResultType>.None => false
      }
      let mut operands = Vector.make<Shared<Type>>()
      run Vector.append<Shared<Type>>(&mut operands, Shared.clone<Type>(&operandType))
      let spelling = OperatorSpelling.Prefix {operator: operator}
      let operandSlice = Vector.asSlice<Shared<Type>>(&operands)
      let called = run checkedSelectedOperator(
        &mut resolver.*, caller, Vector.asSlice<BodyNode>(&nodes.*),
        &mut owner.*,
        &mut request.*,
        &mut dependencies.*,
        &mut signatures.*,
        &mut requiredBodies.*,
        &spelling,
        operandSlice,
        constraints,
        closed,
        module,
        operatorAnchor,
        operandNode,
        Option.none<BodyNodeId>(),
        unsafeAllowed,
      )
      let overload = match move called {
        Result<Option<CheckedOperatorCall>, Shared<Rejection>>.Success {value} => value
        Result<Option<CheckedOperatorCall>, Shared<Rejection>>.Failure {error} => {
          return Result.failResult<BodyNodeId, Shared<Rejection>>(move error)
        }
      }
      if let Option<CheckedOperatorCall>.Some {value: accepted} = move overload {
        let CheckedOperatorCall {ty: resultType, form: selectedForm} = move accepted
        ty = move resultType
        form = move selectedForm
      } else if let Option<Operator.ResultType>.Some {value: result} = move concrete {
        ty = match result {
          OperatorResultType.Operand => Shared.clone<Type>(&operandType)
          OperatorResultType.Boolean => run primitiveType(b"bool")
        }
        form = BodyExpression.ConcretePrefix {operator: operator, operand: operandNode}
      } else {
        return run bodyRejection(
          &resolver.*,
          module,
          RejectionCode.MissingOperator,
          operatorAnchor,
        )
      }
    }
    Node.InfixExpression {operator, operatorAnchor, left, right} => {
      let leftLiteral = match run bodyNode(&resolver.source, cursor, left) {
        Node.CharacterLiteral {..} => true
        Node.IntegerLiteral {suffix, ..} => !suffix.present
        Node.FloatingLiteral {suffix, ..} => !suffix.present
        _ => false
      }
      let rightLiteral = match run bodyNode(&resolver.source, cursor, right) {
        Node.IntegerLiteral {..} => true
        Node.FloatingLiteral {..} => true
        Node.CharacterLiteral {..} => true
        _ => false
      }
      // A bare literal has no fixed type before its other operand is known. Checking that
      // operand first only selects a literal type; the retained pair preserves runtime order.
      let mut firstExpression = left
      let mut secondExpression = right
      let swapped = leftLiteral && !rightLiteral
      if swapped {
        firstExpression = right
        secondExpression = left
      }
      let firstContextual = match run bodyNode(&resolver.source, cursor, firstExpression) {
        Node.CharacterLiteral {..} => true
        Node.IntegerLiteral {suffix, ..} => !suffix.present
        Node.FloatingLiteral {suffix, ..} => !suffix.present
        Node.InfixExpression {..} => true
        Node.PrefixExpression {..} => true
        _ => false
      }
      let secondContextual = match run bodyNode(&resolver.source, cursor, secondExpression) {
        Node.CharacterLiteral {..} => true
        Node.IntegerLiteral {suffix, ..} => !suffix.present
        Node.FloatingLiteral {suffix, ..} => !suffix.present
        Node.InfixExpression {..} => true
        Node.PrefixExpression {..} => true
        _ => false
      }
      let mut firstExpected = Option.none<Shared<Type>>()
      if firstContextual {
        if let Option<Shared<Type>>.Some {value} = &expected.* {
          if Shared.with<Type, bool>(
            &value,
            fn(ty: &Type) -> bool {
              return fixedIntegerType(ty) || pointerSizedIntegerType(ty) || Operator.family(ty, false) == OperatorFamily.Floating
            },
          ) {
            firstExpected = Option.some<Shared<Type>>(Shared.clone<Type>(&value))
          }
        }
      }
      let first = run checkOperatorOperand(
        &mut resolver.*,
        &mut owner.*,
        &mut request.*,
        &mut dependencies.*,
        module,
        cursor,
        caller,
        &mut statementScope.*,
        calls,
        &mut nodes.*,
        &mut signatures.*,
        &mut requiredBodies.*,
        firstExpression,
        &firstExpected,
        constraints,
        contractBody,
        staticBody,
        unsafeAllowed,
      )
      let firstOperand = match move first {
        Result<CheckedOperand, Shared<Rejection>>.Success {value} => value
        Result<CheckedOperand, Shared<Rejection>>.Failure {error} => {
          return Result.failResult<BodyNodeId, Shared<Rejection>>(move error)
        }
      }
      let CheckedOperand {node: firstNode, ty: firstType} = move firstOperand
      let mut secondExpected = Option.none<Shared<Type>>()
      if secondContextual && Shared.with<Type, bool>(
        &firstType,
        fn(ty: &Type) -> bool {
          return fixedIntegerType(ty) || pointerSizedIntegerType(ty) || Operator.family(ty, false) == OperatorFamily.Floating || Operator.family(ty, false) == OperatorFamily.Character
        },
      ) {
        secondExpected = Option.some<Shared<Type>>(Shared.clone<Type>(&firstType))
      }
      let second = run checkOperatorOperand(
        &mut resolver.*,
        &mut owner.*,
        &mut request.*,
        &mut dependencies.*,
        module,
        cursor,
        caller,
        &mut statementScope.*,
        calls,
        &mut nodes.*,
        &mut signatures.*,
        &mut requiredBodies.*,
        secondExpression,
        &secondExpected,
        constraints,
        contractBody,
        staticBody,
        unsafeAllowed,
      )
      let secondOperand = match move second {
        Result<CheckedOperand, Shared<Rejection>>.Success {value} => value
        Result<CheckedOperand, Shared<Rejection>>.Failure {error} => {
          return Result.failResult<BodyNodeId, Shared<Rejection>>(move error)
        }
      }
      let pair = orderCheckedOperands(
        swapped,
        CheckedOperand {node: firstNode, ty: move firstType},
        move secondOperand,
      )
      let CheckedOperands {leftNode, leftType, rightNode, rightType} = move pair
      let leftFamily = run operatorFamily(&mut resolver.*, &leftType)
      let rightFamily = run operatorFamily(&mut resolver.*, &rightType)
      let sameType = run Type.equalsShared(&leftType, &rightType)
      let mut concrete = Operator.infix(operator, leftFamily, rightFamily, sameType)
      if (operator == InfixOperator.And || operator == InfixOperator.Or) && sameType && leftFamily == OperatorFamily.Boolean && rightFamily == OperatorFamily.Boolean {
        concrete = Option.some<OperatorResultType>(OperatorResultType.Boolean)
      }
      let closed = match & concrete {
        Option<Operator.ResultType>.Some {value: _} => true
        Option<Operator.ResultType>.None => false
      }
      let mut operands = Vector.make<Shared<Type>>()
      run Vector.append<Shared<Type>>(&mut operands, Shared.clone<Type>(&leftType))
      run Vector.append<Shared<Type>>(&mut operands, Shared.clone<Type>(&rightType))
      let spelling = OperatorSpelling.Infix {operator: operator}
      let operandSlice = Vector.asSlice<Shared<Type>>(&operands)
      let called = run checkedSelectedOperator(
        &mut resolver.*, caller, Vector.asSlice<BodyNode>(&nodes.*),
        &mut owner.*,
        &mut request.*,
        &mut dependencies.*,
        &mut signatures.*,
        &mut requiredBodies.*,
        &spelling,
        operandSlice,
        constraints,
        closed,
        module,
        operatorAnchor,
        leftNode,
        Option.some<BodyNodeId>(rightNode),
        unsafeAllowed,
      )
      let overload = match move called {
        Result<Option<CheckedOperatorCall>, Shared<Rejection>>.Success {value} => value
        Result<Option<CheckedOperatorCall>, Shared<Rejection>>.Failure {error} => {
          return Result.failResult<BodyNodeId, Shared<Rejection>>(move error)
        }
      }
      if let Option<CheckedOperatorCall>.Some {value: accepted} = move overload {
        let CheckedOperatorCall {ty: resultType, form: selectedForm} = move accepted
        ty = move resultType
        form = move selectedForm
      } else if let Option<Operator.ResultType>.Some {value: result} = move concrete {
        ty = match result {
          OperatorResultType.Operand => Shared.clone<Type>(&leftType)
          OperatorResultType.Boolean => run primitiveType(b"bool")
        }
        form = BodyExpression.ConcreteInfix {
          operator: operator,
          left: leftNode,
          right: rightNode,
        }
      } else {
        return run bodyRejection(
          &resolver.*,
          module,
          RejectionCode.MissingOperator,
          operatorAnchor,
        )
      }
    }
    _ => {
      return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
    }
  }
  return run finishExpression(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, caller, constraints, &mut nodes.*,
    expression, span, move ty, move form,
    diverges, expected, contractBody, staticBody)
}

// Environment handles can alias. Copy their member handles separately before any comparison.
effect fn callableEnvironmentRegions(environment: &Shared<Intersection>) -> Vector<Shared<Lifetime>>
! OutOfMemoryError ? &mut Allocator {
  let mut regions = Vector.make<Shared<Lifetime>>()
  let mut at = usize.ZERO
  while true {
    let region = Shared.with<Intersection, Option<Shared<Lifetime>>>(environment,
      fn(value: &Intersection) -> Option<Shared<Lifetime>> {
        let members = Vector.asSlice<LifetimeMember>(&value.members)
        if at < members.length { return Option.some<Shared<Lifetime>>(Shared.clone<Lifetime>(&members[at].region)) }
        return Option.none<Shared<Lifetime>>()
      })
    if let Option<Shared<Lifetime>>.Some {value} = move region {
      run Vector.append<Shared<Lifetime>>(&mut regions, move value)
    } else { break }
    at = at + usize.ONE
  }
  return move regions
}

effect fn callableEnvironmentOutlives(source: &Shared<Intersection>, target: &Shared<Intersection>, declared: &[Constraint])
  -> bool ! OutOfMemoryError ? &mut Allocator {
  let first = run callableEnvironmentRegions(source)
  let mut second = run callableEnvironmentRegions(target)
  if Vector.length<Shared<Lifetime>>(&second) == usize.ZERO {
    run Vector.append<Shared<Lifetime>>(&mut second, run Shared.make<Lifetime>(Lifetime.Static))
  }
  let offered = Vector.asSlice<Shared<Lifetime>>(&first)
  let promised = Vector.asSlice<Shared<Lifetime>>(&second)
  let mut at = usize.ZERO
  while at < offered.length {
    let mut found = false
    let mut other = usize.ZERO
    while !found && other < promised.length {
      found = run knownOutlives(declared, &offered[at], &promised[other])
      other = other + usize.ONE
    }
    if !found { return false }
    at = at + usize.ONE
  }
  return true
}

// Comparison returns obligations; only the caller's authenticated premises prove them.
effect fn proveValueRelation(relation: &CallableContract.ValueRelation, premises: &[Constraint]) -> bool
! OutOfMemoryError ? &mut Allocator {
  let required = Vector.asSlice<Outlives>(&relation.outlives)
  let mut at = usize.ZERO
  while at < required.length {
    if !run knownOutlives(premises, &required[at].longer, &required[at].shorter) { return false }
    at = at + usize.ONE
  }
  let environments = Vector.asSlice<CallableContract.EnvironmentRelation>(&relation.environments)
  at = usize.ZERO
  while at < environments.length {
    if !run callableEnvironmentOutlives(&environments[at].source, &environments[at].target, premises) { return false }
    at = at + usize.ONE
  }
  return true
}

// A local contents marker is an unresolved finite-body obligation. It cannot establish a
// public callable promise merely because the offered invocation signature is compatible.
effect fn unresolvedLocalCallableContents(value: &Shared<Type>, declared: &[Constraint]) -> bool
! OutOfMemoryError ? &mut Allocator {
  let copied = run Type.copy(value)
  return match move copied {
    Type.CallableValue {contract, captures, ..} => run unresolvedLocalCaptureFields(&contract, Vector.asSlice<Shared<Type>>(&captures), declared)
    Type.CallableSchema {schema, captures, ..} => {
      let contract = Shared.with<SectionSchema, Shared<Type>>(&schema,
        fn(value: &SectionSchema) -> Shared<Type> { return Shared.clone<Type>(&value.contract) })
      return run unresolvedLocalCaptureFields(&contract, Vector.asSlice<Shared<Type>>(&captures), declared)
    }
    Type.CallableStage {base, contract, captures, ..} => {
      if run unresolvedLocalCallableContents(&base, declared) { return true }
      return run unresolvedLocalCaptureFields(&contract, Vector.asSlice<Shared<Type>>(&captures), declared)
    }
    _ => {
      let mut components = Vector.make<Shared<Type>>()
      run Type.storedComponents(value, &mut components)
      let stored = Vector.asSlice<Shared<Type>>(&components)
      let mut at = usize.ZERO
      while at < stored.length {
        if run unresolvedLocalCallableContents(&stored[at], declared) { return true }
        at = at + usize.ONE
      }
      return false
    }
  }
}

fn localContentsRegion(value: &Lifetime) -> bool {
  return match &value.* { Lifetime.Local {..} => true Lifetime.Supplied {..} => true _ => false }
}

fn localContentsEnvironment(value: &Intersection) -> bool {
  let members = Vector.asSlice<LifetimeMember>(&value.members)
  let mut at = usize.ZERO
  while at < members.length {
    if Shared.with<Lifetime, bool>(&members[at].region, localContentsRegion) { return true }
    at = at + usize.ONE
  }
  return false
}

fn localContentsContract(value: &Type) -> bool {
  return match &value.* { Type.Callable {environment, ..} => Shared.with<Intersection, bool>(&environment, localContentsEnvironment) _ => false }
}

effect fn unresolvedLocalCaptureFields(contract: &Shared<Type>, captures: &[Shared<Type>], declared: &[Constraint]) -> bool
! OutOfMemoryError ? &mut Allocator {
  let local = Shared.with<Type, bool>(contract, localContentsContract)
  if !local { return false }
  let mut at = usize.ZERO
  while at < captures.length {
    if run unresolvedLocalCallableContents(&captures[at], declared) { return true }
    let mut parameters = Vector.make<Shared<Type>>()
    run Type.storedParameters(&captures[at], &mut parameters)
    let listed = Vector.asSlice<Shared<Type>>(&parameters)
    if listed.length != usize.ZERO {
      let owner = match move run Type.copy(&listed[usize.ZERO]) {
        Type.Parameter {declaration, ..} => move declaration
        _ => { return true }
      }
      let mut regions = Vector.make<Shared<Lifetime>>()
      let mut unresolved = Vector.make<Shared<Type>>()
      if !run captureContents(&captures[at], &owner, declared, &mut regions, &mut unresolved) { return true }
      if Vector.length<Shared<Type>>(&unresolved) != usize.ZERO { return true }
    }
    at = at + usize.ONE
  }
  return false
}

effect fn proveCallableBound(resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, module: &ModuleId, declared: &[Constraint],
  parameter: &Shared<Type>, contract: &Shared<Type>, span: Span,
) -> Option<Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let determined = Option.none<DeclarationId>()
  let source = match move run contextualCallableContract(&mut resolver.*, &mut owner.*, &mut dependencies.*, module,
    declared, parameter, contract, &determined, span) {
    Result<Option<Shared<Type>>, Shared<Rejection>>.Success {value} => move value
    Result<Option<Shared<Type>>, Shared<Rejection>>.Failure {error} => { return Option.some<Shared<Rejection>>(move error) }
  }
  let sourceType = match move source {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => {
      // An abstract representation may still need substitution; a closed non-callable
      // value is a proved signature mismatch.
      let mut code = RejectionCode.TypeMismatch
      let reference = Shared.with<Type, bool>(parameter, fn(value: &Type) -> bool {
        return match &value.* { Type.Reference {..} => true _ => false }
      })
      if Type.hasOpenParameters(parameter) && !reference { code = RejectionCode.Unsupported }
      return Option.some<Shared<Rejection>>(run reject(&resolver.*, module, code, span))
    }
  }
  let sourceFacts = run CallableContract.ofType(&sourceType)
  let targetFacts = run CallableContract.ofType(contract)
  if let Option<CallableFacts>.Some {value: offered} = move sourceFacts {
    if let Option<CallableFacts>.Some {value: wanted} = move targetFacts {
      let compared = run CallableContract.compare(&offered, &wanted)
      let relation = match move compared {
        Result<CallableContract.Relation, CallableFailure>.Success {value} => move value
        Result<CallableContract.Relation, CallableFailure>.Failure {error} => {
          let code = match error { CallableFailure.Incompatible => RejectionCode.IncompatibleCallableSignature
            CallableFailure.Unsupported => RejectionCode.Unsupported }
          return Option.some<Shared<Rejection>>(run reject(&resolver.*, module, code, span))
        }
      }
      if !run callableEnvironmentOutlives(&relation.sourceEnvironment, &relation.targetEnvironment, declared,
      ) {
        let mut code = RejectionCode.UnsatisfiedLifetimeBound
        if run unresolvedLocalCallableContents(parameter, declared) { code = RejectionCode.Unsupported }
        return Option.some<Shared<Rejection>>(run reject(&resolver.*, module, code, span))
      }
      let mut premises = run copyConstraints(declared)
      let provided = Vector.asSlice<Outlives>(&relation.provided)
      let mut at = usize.ZERO
      while at < provided.length {
        run Vector.append<Constraint>(&mut premises, Constraint.Outlives {
          longer: Shared.clone<Lifetime>(&provided[at].longer), shorter: Shared.clone<Lifetime>(&provided[at].shorter),
          },
        )
        at = at + usize.ONE
      }
      run invocationUseConstraints(Vector.asSlice<Shared<Type>>(&wanted.parameters), wanted.invocationUse,
        &Option.none<DeclarationId>(), &mut premises)
      if !run proveValueRelation(&relation.required, Vector.asSlice<Constraint>(&premises)) {
        return Option.some<Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.IncompatibleCallableSignature, span))
      }
      return Option.none<Shared<Rejection>>()
    }
  }
  let effectsBound = run effectBound(&sourceType, contract)
  if let Option<EffectBound>.Some {value: effects} = move effectsBound {
    return run proveEffectBound(&resolver.*, module, declared, &effects, span)
  }
  return Option.some<Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.IncompatibleCallableSignature, span),
  )
}

// One offered exact Effect contract and the use contract it must satisfy.
struct EffectBound {
  offered: EffectParts
  wanted: EffectParts
}

struct EffectParts {
  mode: CallableMode
  environment: Shared<Intersection>
  success: Shared<Type>
  failure: Shared<Type>
  requirements: Shared<Row>
}

fn effectParts(value: &Type) -> Option<EffectParts> {
  return match &value.* {
    Type.Effect {mode, environment, success, failure, requirements} => Option.some<EffectParts>(EffectParts {
      mode: mode, environment: Shared.clone<Intersection>(&environment), success: Shared.clone<Type>(&success),
      failure: Shared.clone<Type>(&failure), requirements: Shared.clone<Row>(&requirements),
    })
    Type.CallableValue {contract, ..} => Shared.with<Type, Option<EffectParts>>(&contract, effectParts)
    Type.EffectComposite {contract, ..} => Shared.with<Type, Option<EffectParts>>(&contract, effectParts)
    Type.EffectJoin {contract, ..} => Shared.with<Type, Option<EffectParts>>(&contract, effectParts)
    Type.OpaqueRepresentation {contract, ..} => Shared.with<Type, Option<EffectParts>>(&contract, effectParts)
    _ => Option.none<EffectParts>()
  }
}

effect fn effectBound(source: &Shared<Type>, target: &Shared<Type>) -> Option<EffectBound> ! OutOfMemoryError ? &mut Allocator {
  let offered = Shared.with<Type, Option<EffectParts>>(source, effectParts)
  let wanted = Shared.with<Type, Option<EffectParts>>(target, effectParts)
  if let Option<EffectParts>.Some {value: left} = move offered {
    if let Option<EffectParts>.Some {value: right} = move wanted {
      return Option.some<EffectBound>(EffectBound {offered: move left, wanted: move right})
    }
  }
  return Option.none<EffectBound>()
}

fn runStrength(mode: CallableMode) -> usize {
  return match mode { CallableMode.Shared => usize.ZERO CallableMode.Mutable => usize.ONE CallableMode.Once => 2 }
}

// An exact Effect satisfies a use contract with the same channels whose run access it permits and
// whose environment outlives the promised one (EFF-013, REP-002).
effect fn proveEffectBound(resolver: &Resolver, module: &ModuleId, declared: &[Constraint], bound: &EffectBound, span: Span)
  -> Option<Shared<Rejection>> ! OutOfMemoryError ? &mut Allocator {
  let compatible = runStrength(bound.offered.mode) <= runStrength(bound.wanted.mode)
    && (run Type.equalsShared(&bound.offered.success, &bound.wanted.success))
    && (run Type.equalsShared(&bound.offered.failure, &bound.wanted.failure))
    && (run Row.equalsShared(&bound.offered.requirements, &bound.wanted.requirements))
    && (run callableEnvironmentOutlives(&bound.offered.environment, &bound.wanted.environment, declared))
  if compatible { return Option.none<Shared<Rejection>>() }
  return Option.some<Shared<Rejection>>(run reject(resolver, module, RejectionCode.IncompatibleCallableSignature, span))
}

// The offered channels and whole canonical environment infer the promised slots. Environment
// equations with several unknowns stay undecided; later admission proves all actual obligations.
effect fn inferEffectBound(fresh: &DeclarationId, inferred: &mut Vector<Binding>, bound: &EffectBound,
  declared: &[Constraint])
  -> () ! OutOfMemoryError ? &mut Allocator {
  let mut variables = Vector.make<Shared<DeclarationId>>()
  run Vector.append<Shared<DeclarationId>>(&mut variables, run Shared.make<DeclarationId>(run DeclarationId.copy(fresh)))
  let mut patterns = Vector.make<Shared<Type>>()
  let mut evidence = Vector.make<Shared<Type>>()
  run Vector.append<Shared<Type>>(&mut patterns, Shared.clone<Type>(&bound.wanted.success))
  run Vector.append<Shared<Type>>(&mut evidence, Shared.clone<Type>(&bound.offered.success))
  run Vector.append<Shared<Type>>(&mut patterns, Shared.clone<Type>(&bound.wanted.failure))
  run Vector.append<Shared<Type>>(&mut evidence, Shared.clone<Type>(&bound.offered.failure))
  run Vector.append<Shared<Type>>(&mut patterns, run rowCarrier(&bound.wanted.requirements))
  run Vector.append<Shared<Type>>(&mut evidence, run rowCarrier(&bound.offered.requirements))
  let unified = run Type.unifyAll(Vector.asSlice<Shared<Type>>(&patterns), Vector.asSlice<Shared<Type>>(&evidence),
    Vector.asSlice<Shared<DeclarationId>>(&variables), Comparison.Exact, &mut inferred.*)
  drop unified
  let carrier = run Shared.make<Type>(Type.Effect {
    mode: bound.wanted.mode, environment: Shared.clone<Intersection>(&bound.wanted.environment),
    success: Shared.clone<Type>(&bound.wanted.success), failure: Shared.clone<Type>(&bound.wanted.failure),
    requirements: Shared.clone<Row>(&bound.wanted.requirements)})
  let environment = run Type.unifyEnvironments(&bound.wanted.environment, &bound.offered.environment, &carrier,
    Vector.asSlice<Shared<DeclarationId>>(&variables), &mut inferred.*)
  drop environment
  return ()
}

// A representation parameter first acquires its exact value type from an operand. Its
// promised signature can then infer ordinary type parameters and an elided environment.
effect fn inferCallableBound(resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, module: &ModuleId, fresh: &DeclarationId,
  declared: &[Constraint], inferred: &mut Vector<Binding>, parameter: &Shared<Type>, contract: &Shared<Type>, span: Span,
)
  -> Option<Shared<Rejection>> ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let actual = run Type.applyBindings(parameter, Vector.asSlice<Binding>(&inferred.*), true)
  let promised = run Type.applyBindings(contract, Vector.asSlice<Binding>(&inferred.*), true)
  let mut pending = Option.none<DeclarationId>()
  if Shared.with<Type, bool>(&actual, genericSectionType) && run sectionContextUndetermined(&promised, fresh) {
    // A generic function value has no exact contract until its use selects one. The positions
    // this call already determined, such as the parameters, may select it; its instantiated
    // result is then evidence for the still-open positions. Otherwise it stays deferred. A
    // selection the determined positions reject is the call's error, not a deferral.
    pending = Option.some<DeclarationId>(run DeclarationId.copy(fresh))
  }
  let selected = run contextualCallableContract(&mut resolver.*, &mut owner.*, &mut dependencies.*, module,
    declared, &actual, &promised, &pending, span)
  let source = match move selected {
    Result<Option<Shared<Type>>, Shared<Rejection>>.Success {value} => move value
    Result<Option<Shared<Type>>, Shared<Rejection>>.Failure {error} => { return Option.some<Shared<Rejection>>(move error) }
  }
  let sourceType = match move source {
    Option<Shared<Type>>.Some {value} => move value
    _ => { return Option.none<Shared<Rejection>>() }
  }
  let effectsBound = run effectBound(&sourceType, &promised)
  if let Option<EffectBound>.Some {value: effects} = move effectsBound {
    run inferEffectBound(fresh, &mut inferred.*, &effects, declared)
    return Option.none<Shared<Rejection>>()
  }
  let sourceFacts = run CallableContract.ofType(&sourceType)
  let targetFacts = run CallableContract.ofType(&promised)
  if let Option<CallableFacts>.Some {value: offered} = move sourceFacts {
    if let Option<CallableFacts>.Some {value: wanted} = move targetFacts {
      // A binder-free offer satisfies a quantified promise for every invocation, as comparison
      // admits; the promise's opened regions stay rigid evidence.
      if offered.invocationBinders != wanted.invocationBinders && offered.invocationBinders != usize.ZERO {
        return Option.none<Shared<Rejection>>()
      }
      let mut variables = Vector.make<Shared<DeclarationId>>()
      run Vector.append<Shared<DeclarationId>>(&mut variables, run Shared.make<DeclarationId>(run DeclarationId.copy(fresh)),
      )
      let rigid = run DeclarationId.inference(fresh, b"\0callable-bound-rigids")
      let mark = Vector.length<Binding>(&inferred.*)
      let mut trial = Vector.make<Binding>()
      let current = Vector.asSlice<Binding>(&inferred.*)
      let mut copyAt = usize.ZERO
      while copyAt < current.length {
        run Vector.append<Binding>(&mut trial, Binding {declaration: Shared.clone<DeclarationId>(&current[copyAt].declaration),
          ordinal: current[copyAt].ordinal, value: Argument.copy(&current[copyAt].value),
          },
        )
        copyAt = copyAt + usize.ONE
      }
      let provided = Vector.asSlice<Shared<Type>>(&offered.parameters)
      let expected = Vector.asSlice<Shared<Type>>(&wanted.parameters)
      let mut at = usize.ZERO
      while at < provided.length && at < expected.length {
        let pattern = run Type.openInvocation(&expected[at], &rigid)
        let evidence = run Type.openInvocation(&provided[at], &rigid)
        let compared = run Type.unify(&pattern, &evidence, Vector.asSlice<Shared<DeclarationId>>(&variables), Comparison.Exact, &mut trial,
        )
        drop compared
        at = at + usize.ONE
      }
      let pattern = run Type.openInvocation(&wanted.result, &rigid)
      let evidence = run Type.openInvocation(&offered.result, &rigid)
      // A delayed Effect result is covariant in its run access, so its channels and environment
      // are the evidence; the comparison later proves the access.
      let delayed = run effectBound(&evidence, &pattern)
      if let Option<EffectBound>.Some {value: effects} = move delayed {
        run inferEffectBound(fresh, &mut trial, &effects, declared)
      } else {
        let compared = run Type.unify(&pattern, &evidence, Vector.asSlice<Shared<DeclarationId>>(&variables), Comparison.Exact, &mut trial,
        )
        drop compared
      }
      let added = Vector.asSlice<Binding>(&trial)
      let mut checkAt = mark
      while checkAt < added.length {
        if run argumentMentionsOwner(&added[checkAt].value, &rigid) {
          let mut code = RejectionCode.TypeArgumentInference
          // An Effect result needs Effect environment and run-mode inference (named effect-form gap).
          if Shared.with<Type, bool>(&offered.result, bareEffect) { code = RejectionCode.EffectFormUnavailable }
          return Option.some<Shared<Rejection>>(run reject(&resolver.*, module, code, span))
        }
        checkAt = checkAt + usize.ONE
      }
      inferred.* = move trial
      let environment = run Type.unifyEnvironments(&wanted.environment, &offered.environment, &promised,
        Vector.asSlice<Shared<DeclarationId>>(&variables), &mut inferred.*)
      drop environment
    }
  }
  return Option.none<Shared<Rejection>>()
}

// A callable use contract belongs to an exact value or one declared representation bound.
// Argument ownership includes the reference descriptor around an exact callable; invocation
// still requires the programmer's explicit referent projection.
effect fn callableArgumentContract(value: &Shared<Type>, constraints: &[Constraint]) -> Option<Shared<Type>>
! OutOfMemoryError ? &mut Allocator {
  let copied = run Type.copy(value)
  if let Type.Reference {referent, ..} = move copied {
    return run callableArgumentContract(&referent, constraints)
  }
  return run valueCallableContract(value, constraints)
}

effect fn valueCallableContract(value: &Shared<Type>, constraints: &[Constraint]) -> Option<Shared<Type>,
>
! OutOfMemoryError ? &mut Allocator {
  let copied = run Type.copy(value)
  match move copied {
    Type.CallableValue {contract, ..} => { return Option.some<Shared<Type>>(move contract) }
    Type.CallableView {contract, ..} => { return Option.some<Shared<Type>>(move contract) }
    Type.CallableOrigin {contract, ..} => { return Option.some<Shared<Type>>(move contract) }
    Type.CallableWitnessResult {witness} => { return Option.some<Shared<Type>>(Shared.with<WitnessRecipe, Shared<Type>>(&witness,
      CallableWitness.resultType)) }
    Type.CallableResult {contract, ..} => { return Option.some<Shared<Type>>(move contract) }
    Type.CallableStage {contract, ..} => { return Option.some<Shared<Type>>(move contract) }
    Type.CallableSchema {schema, ..} => { return Option.some<Shared<Type>>(sectionSchemaContract(&schema)) }
    Type.EffectComposite {contract, ..} => { return Option.some<Shared<Type>>(move contract) }
    Type.EffectJoin {contract, ..} => { return Option.some<Shared<Type>>(move contract) }
    Type.Callable {..} => { return Option.some<Shared<Type>>(Shared.clone<Type>(value)) }
    // An Effect produced by invoking a callable value is its own use contract.
    Type.Effect {..} => { return Option.some<Shared<Type>>(Shared.clone<Type>(value)) }
    Type.Reference {..} => { return Option.none<Shared<Type>>() }
    Type.OpaqueRepresentation {contract, ..} => { return run valueCallableContract(&contract, constraints) }
    _ => ()
  }
  let mut at = usize.ZERO
  while at < constraints.length {
    if let Constraint.Represents {parameter, contract} = &constraints[at] {
      if run Type.equalsShared(value, &parameter) { return Option.some<Shared<Type>>(Shared.clone<Type>(&contract)) }
    }
    at = at + usize.ONE
  }
  return Option.none<Shared<Type>>()
}

// `input: 'call` for every input of a contract whose `for<use 'call>` binder has canonical ordinal
// `marked`: an obligation on a caller, or a premise inside a checked callback. With an `opener`,
// the inputs are already opened in that invocation and the binder is opened the same way.
effect fn invocationUseConstraints(inputs: &[Shared<Type>], marked: usize, opener: &Option<DeclarationId>,
  constraints: &mut Vector<Constraint>) -> () ! OutOfMemoryError ? &mut Allocator {
  if marked == usize.MAX { return () }
  let mut region = run Shared.make<Lifetime>(Lifetime.Invocation {ordinal: marked})
  if let Option<DeclarationId>.Some {value: caller} = &opener.* { region = run Type.openInvocationLifetime(&region, &caller) }
  let mut at = usize.ZERO
  while at < inputs.length {
    run Vector.append<Constraint>(&mut constraints.*, Constraint.Contents {
      subject: Shared.clone<Type>(&inputs[at]), region: Shared.clone<Lifetime>(&region)})
    at = at + usize.ONE
  }
}

// Open only this call's quantified regions. The ordinary argument checker can then infer them
// using the same Signature representation and outlives prover as a named call.
effect fn callableInferenceSignature(contract: &Shared<Type>, fresh: &DeclarationId, supplied: usize) -> Option<Shared<Result<Answer, NoRejection>>,
>
! OutOfMemoryError ? &mut Allocator {
  let copied = run Type.copy(contract)
  if let Type.Callable {isUnsafe, invocationBinders, invocationUse, invocationBounds, parameters, result, ..} = move copied {
    let mut regions = Vector.make<Shared<Lifetime>>()
    let mut opened = Vector.make<Shared<Type>>()
    let mut bounds = Vector.make<Constraint>()
    let mut representations = Vector.make<Shared<Type>>()
    let mut representationOrdinal = invocationBinders
    let mut callableParameterStart = usize.MAX
    let mut at = usize.ZERO
    while at < invocationBinders {
      run Vector.append<Shared<Lifetime>>(&mut regions, run Shared.make<Lifetime>(Lifetime.Parameter {
        declaration: run DeclarationId.copy(fresh), ordinal: at},
      ),
      )
      at = at + usize.ONE
    }
    let listed = Vector.asSlice<Shared<Type>>(&parameters)
    let mut firstSupplied = listed.length
    if supplied <= listed.length { firstSupplied = listed.length - supplied }
    at = usize.ZERO
    while at < listed.length {
      let parameter = run Type.openInvocation(&listed[at], fresh)
      // Leading unsupplied parameters remain public contracts of the constructed section.
      let mut reified = Option.none<CallableParameter.CallableParameter>()
      if at >= firstSupplied { reified = run CallableParameter.reify(&parameter, fresh, representationOrdinal) }
      match move reified {
        Option<CallableParameter.CallableParameter>.Some {value} => {
          if callableParameterStart == usize.MAX { callableParameterStart = representationOrdinal }
          let slots = Vector.asSlice<CallableParameter.RepresentationSlot>(&value.slots)
          let mut slotAt = usize.ZERO
          while slotAt < slots.length {
            run Vector.append<Shared<Type>>(&mut representations, Shared.clone<Type>(&slots[slotAt].representation))
            run Vector.append<Constraint>(&mut bounds, Constraint.Represents {
              parameter: Shared.clone<Type>(&slots[slotAt].representation), contract: Shared.clone<Type>(&slots[slotAt].contract)})
            representationOrdinal = representationOrdinal + usize.ONE
            slotAt = slotAt + usize.ONE
          }
          run Vector.append<Shared<Type>>(&mut opened, move value.ty)
        }
        _ => { run Vector.append<Shared<Type>>(&mut opened, move parameter) }
      }
      at = at + usize.ONE
    }
    // The caller supplies every input for the marked invocation extent (LIFE-004).
    run invocationUseConstraints(Vector.asSlice<Shared<Type>>(&opened), invocationUse,
      &Option.some<DeclarationId>(run DeclarationId.copy(fresh)), &mut bounds)
    let promised = Vector.asSlice<Outlives>(&invocationBounds)
    at = usize.ZERO
    while at < promised.length {
      run Vector.append<Constraint>(&mut bounds, Constraint.Outlives {
        longer: run Type.openInvocationLifetime(&promised[at].longer, fresh),
        shorter: run Type.openInvocationLifetime(&promised[at].shorter, fresh),
      },
      )
      at = at + usize.ONE
    }
    let answer = memberSuccess(Value.Signature {signature: Signature {
      typeParameters: move representations,
      callableParameterStart: callableParameterStart, lifetimeParameters: move regions,
      rowParameters: Vector.make<RowParameter>(), constraints: move bounds, parameters: move opened,
      result: run Type.openInvocation(&result, fresh), failure: run primitiveType(b"never"),
      requirements: run Shared.make<Row>(Row.empty()), isEffect: false, isVariadic: false, isUnsafe: isUnsafe,
      isStatic: false, staticSlots: Vector.make<usize>(), environment: Option.none<Intersection>(),
    },
      }, Vector.make<Dependency>(),
    )
    return Option.some<Shared<Result<Answer, NoRejection>>>(run Shared.make<Result<Answer, NoRejection>>(Result.succeed<Answer, NoRejection>(move answer)),
    )
  }
  return Option.none<Shared<Result<Answer, NoRejection>>>()
}

effect fn checkCallableInvocation<'scope>(
  resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>, request: &mut Request,
  dependencies: &mut Vector<Dependency>, module: &ModuleId, cursor: &AuthoredCursor,
  caller: &DeclarationId, statementScope: &mut StatementScope<'scope>, calls: &[ResolvedCall], nodes: &mut Vector<BodyNode>,
  signatures: &mut Vector<SignatureDependency>, requiredBodies: &mut Vector<DeclarationId>,
  expression: HirId, callee: HirId, generics: HirRef, arguments: CallArguments, pipeline: bool,
  expected: &Option<Shared<Type>>, constraints: &[Constraint], contractBody: bool,
  staticBody: bool, unsafeAllowed: bool, callAcknowledged: bool,
) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let span = run bodySpan(&resolver.source, cursor, expression)
  let calleeSpan = run bodySpan(&resolver.source, cursor, callee)
  if staticBody { return run bodyRejection(&resolver.*, module, RejectionCode.StaticPhaseViolation, span) }
  let checked = run checkExpression(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
    module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*,
    &mut requiredBodies.*, callee, &Option.none<Shared<Type>>(), constraints, contractBody, false, unsafeAllowed,
  )
  let target = match move checked {
    Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
    Result<BodyNodeId, Shared<Rejection>>.Failure {error} => { return Result.failResult<BodyNodeId, Shared<Rejection>>(move error) }
  }
  return run invokeCallableValue(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
    module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*,
    expression, callee, target, generics, arguments, pipeline, expected, constraints, contractBody,
    unsafeAllowed, callAcknowledged)
}

fn invocationRegionBound(bindings: &[Binding], fresh: &DeclarationId, ordinal: usize) -> bool {
  let mut at = usize.ZERO
  while at < bindings.length {
    if bindings[at].ordinal == ordinal && declarationEqualsShared(fresh, &bindings[at].declaration) { return true }
    at = at + usize.ONE
  }
  return false
}

// Invokes an already checked callable place. Field dispatch supplies its projected target here
// so the record expression and every ownership transfer are checked exactly once.
effect fn invokeCallableValue<'scope>(
  resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>, request: &mut Request,
  dependencies: &mut Vector<Dependency>, module: &ModuleId, cursor: &AuthoredCursor,
  caller: &DeclarationId, statementScope: &mut StatementScope<'scope>, calls: &[ResolvedCall], nodes: &mut Vector<BodyNode>,
  signatures: &mut Vector<SignatureDependency>, requiredBodies: &mut Vector<DeclarationId>,
  expression: HirId, callee: HirId, checkedTarget: BodyNodeId, generics: HirRef, arguments: CallArguments, pipeline: bool,
  expected: &Option<Shared<Type>>, constraints: &[Constraint], contractBody: bool,
  unsafeAllowed: bool, callAcknowledged: bool,
) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let span = run bodySpan(&resolver.source, cursor, expression)
  let calleeSpan = run bodySpan(&resolver.source, cursor, callee)
  let mut target = checkedTarget
  let actual = match move bodyExpressionType(Vector.asSlice<BodyNode>(&nodes.*), &target) {
    Option<Shared<Type>>.Some {value} => move value
    _ => { return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span) }
  }
  let contract = match move run valueCallableContract(&actual, constraints) {
    Option<Shared<Type>>.Some {value} => move value
    _ => { return run bodyRejection(&resolver.*, module, RejectionCode.NotCallable, calleeSpan) }
  }
  if generics.present { return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span) }
  let mut inferenceScope = Bytes.make()
  run Bytes.append(&mut inferenceScope, b"\0callable-inference")
  run RuntimeEncoding.declaration(&mut inferenceScope, caller)
  run RuntimeEncoding.word(&mut inferenceScope, usize.toU64(expression.index))
  run RuntimeEncoding.word(&mut inferenceScope, usize.toU64(resolver.nextInferenceId))
  resolver.nextInferenceId = resolver.nextInferenceId + usize.ONE
  let fresh = run DeclarationId.inference(caller, Bytes.asSlice(&inferenceScope))
  let schema = Shared.with<Type, Option<Shared<SectionSchema>>>(&actual, sectionSchemaOf)
  // A section's bound lifetimes are inference evidence, not written lifetimes of its contract.
  let mut inferred = Vector.make<Binding>()
  let inference = match &schema {
    Option<Shared<SectionSchema>>.Some {value} => match move run sectionSchemaSignature(&mut resolver.*,
      &mut owner.*, &mut dependencies.*, &value, &fresh, module, span, true, &mut inferred) {
      Result<Shared<Result<Answer, NoRejection>>, Shared<Rejection>>.Success {value: opened} => move opened
      Result<Shared<Result<Answer, NoRejection>>, Shared<Rejection>>.Failure {error} => { return Result.failResult<BodyNodeId, Shared<Rejection>>(move error) }
    }
    Option<Shared<SectionSchema>>.None => match move run callableInferenceSignature(&contract, &fresh, CallArguments.length(arguments)) {
      Option<Shared<Result<Answer, NoRejection>>>.Some {value} => move value
      _ => { return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span) }
    }
  }
  let mut captured = Vector.make<Shared<Type>>()
  if let Option<Shared<SectionSchema>>.Some {value} = &schema {
    captured = match move run sectionCapturedParameters(&mut resolver.*, &mut owner.*, &mut dependencies.*, &value, &fresh,
      module, span) {
      Result<Vector<Shared<Type>>, Shared<Rejection>>.Success {value: parameters} => move parameters
      Result<Vector<Shared<Type>>, Shared<Rejection>>.Failure {error} => { return Result.failResult<BodyNodeId, Shared<Rejection>>(move error) }
    }
  }
  let facts = match move Shared.with<Result<Answer, NoRejection>, Option<SignatureFacts>>(&inference, signatureFacts,
  ) {
    Option<SignatureFacts>.Some {value} => move value
    _ => { return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span) }
  }
  let supplied = CallArguments.length(arguments)
  if pipeline && facts.parameters != usize.ONE {
    return run bodyRejection(&resolver.*, module, RejectionCode.CallArity, span)
  }
  if supplied > facts.parameters || (supplied == usize.ZERO && facts.parameters != usize.ZERO) {
    return run bodyRejection(&resolver.*, module, RejectionCode.CallArity, span)
  }
  let remaining = facts.parameters - supplied
  let partial = remaining != usize.ZERO
  if !partial && facts.isUnsafe && !unsafeAllowed && !callAcknowledged { return run bodyRejection(&resolver.*, module, RejectionCode.UnsafeAcknowledgement, span) }
  if !facts.isUnsafe && callAcknowledged { return run bodyRejection(&resolver.*, module, RejectionCode.UnsafeInvocation, span) }
  let invocationMode = Shared.with<Type, CallableMode>(&contract, callableInvocationMode)
  let mut mode = invocationMode
  if partial && invocationMode != CallableMode.Shared { mode = CallableMode.Once }
  if invocationMode == CallableMode.Mutable && checkedPlace(Vector.asSlice<BodyNode>(&nodes.*), target,
  ) &&
    !mutablePlace(Vector.asSlice<BodyNode>(&nodes.*), Vector.asSlice<BodyLocal>(&statementScope.locals.*), target,
  ) {
    return run bodyRejection(&resolver.*, module, RejectionCode.InvalidCallableInvocationAccess, calleeSpan,
    )
  }
  if mode == CallableMode.Once {
    let consumed = match move run consumedPlace(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor,
      Vector.asSlice<BodyNode>(&nodes.*), target, false, false, calleeSpan, calleeSpan, constraints) {
      Result<Option<BodyConsumedPlace>, Shared<Rejection>>.Success {value} => move value
      Result<Option<BodyConsumedPlace>, Shared<Rejection>>.Failure {error} => { return Result.failResult<BodyNodeId, Shared<Rejection>>(move error) }
    }
    let consumedTarget = BodyNodeId {index: Vector.length<BodyNode>(&nodes.*)}
    let consumedType = match move bodyExpressionType(Vector.asSlice<BodyNode>(&nodes.*), &target) {
      Option<Shared<Type>>.Some {value} => move value _ => { return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span) }
    }
    run Vector.append<BodyNode>(&mut nodes.*, BodyNode {origin: BodyOrigin {syntax: callee, span: calleeSpan},
      kind: BodyNodeKind.Expression {ty: move consumedType, form: BodyExpression.Move {value: target, consumed: move consumed},
        },
      },
    )
    target = consumedTarget
  }
  let mut variables = Vector.make<Shared<DeclarationId>>()
  run Vector.append<Shared<DeclarationId>>(&mut variables, run Shared.make<DeclarationId>(run DeclarationId.copy(&fresh)),
  )
  let mut operands = Vector.make<BodyNodeId>()
  let noOrdinals = Vector.make<usize>()
  let relationMark = retainedRelationCount(&resolver.*)
  let mut at = usize.ZERO
  while at < supplied {
    let parameter = match move Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(&inference,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> { return signatureParameter(answer, remaining + at) },
    ) {
      Option<Shared<Type>>.Some {value} => move value
      _ => { return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span) }
    }
    let argument = run bodyArgument(&resolver.source, cursor, arguments, at)
    let typed = run checkInferredCallArgument(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
      module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*,
      argument, &parameter, &inference, Vector.asSlice<Shared<Type>>(&captured), &fresh,
      Vector.asSlice<Shared<DeclarationId>>(&variables), Vector.asSlice<usize>(&noOrdinals), false,
      &mut inferred,
      expression, span, constraints, contractBody, false, unsafeAllowed,
    )
    match move typed {
      Result<BodyNodeId, Shared<Rejection>>.Success {value} => { run Vector.append<BodyNodeId>(&mut operands, value) }
      Result<BodyNodeId, Shared<Rejection>>.Failure {error} => { return Result.failResult<BodyNodeId, Shared<Rejection>>(move error) }
    }
    at = at + usize.ONE
  }
  // A marked `for<use 'call>` binder names this invocation's own extent (LIFE-004). When no input
  // fixes it, the call supplies its local region; a partial application keeps it open.
  if !partial {
    let marked = Shared.with<Type, usize>(&contract, fn(value: &Type) -> usize {
      return match &value.* { Type.Callable {invocationUse, ..} => invocationUse _ => usize.MAX }
    })
    if marked != usize.MAX && !invocationRegionBound(Vector.asSlice<Binding>(&inferred), &fresh, marked) {
      run Vector.append<Binding>(&mut inferred, Binding {declaration: run Shared.make<DeclarationId>(run DeclarationId.copy(&fresh)),
        ordinal: marked, value: Argument.Lifetime {value: run Shared.make<Lifetime>(Lifetime.Local {
          declaration: run DeclarationId.copy(caller), ordinal: expression.index})}})
    }
  }
  if partial && !Shared.with<Type, bool>(&actual, anonymousSectionType)
    && Shared.with<Type, usize>(&contract, fn(value: &Type) -> usize {
    return match &value.* { Type.Callable {invocationBinders, ..} => invocationBinders _ => usize.ZERO }
  }) != usize.ZERO {
    return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
  }
  // A section's deferred `?S` selector is inferred once its operands solve the provider and source.
  let freshIdentity = run Shared.make<DeclarationId>(run DeclarationId.copy(&fresh))
  let selectorFailure = run inferProvidedSelectors(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, &inference,
    &freshIdentity, &fresh, constraints, &mut inferred, span)
  if let Option<Shared<Rejection>>.Some {value} = move selectorFailure { return Result.failResult<BodyNodeId, Shared<Rejection>>(move value) }
  let mut applied = Vector.make<Constraint>()
  at = usize.ZERO
  while at < facts.constraints {
    let bound = Shared.with<Result<Answer, NoRejection>, Option<Constraint>>(&inference,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Constraint> { return signatureConstraintAt(answer, at) },
    )
    if let Option<Constraint>.Some {value} = move bound {
      let selected = run bindConstraint(&value, Vector.asSlice<Binding>(&inferred))
      if run constraintMentionsOwner(&selected, &fresh) {
        if partial && Shared.with<Type, bool>(&actual, genericSectionType) {
          at = at + usize.ONE
          continue
        }
        return run bodyRejection(&resolver.*, module, RejectionCode.UninferredParameter, span)
      }
      run Vector.append<Constraint>(&mut applied, move selected)
    }
    at = at + usize.ONE
  }
  let mut declared = run copyConstraints(constraints)
  run retainedRelationPremises(&resolver.*, relationMark, &mut declared)
  let failure = run proveAppliedBounds(&mut resolver.*, &mut owner.*, &mut dependencies.*, &declared,
    Vector.asSlice<Constraint>(&applied), module, span,
  )
  if let Option<Shared<Rejection>>.Some {value} = move failure { return Result.failResult<BodyNodeId, Shared<Rejection>>(move value) }
  let mut result = run Type.applyBindings(&facts.result, Vector.asSlice<Binding>(&inferred), true)
  // Invoking a generic `effect fn` section constructs the Effect its contract promises (EFF-001).
  if facts.isEffect {
    if let Option<Shared<SectionSchema>>.Some {..} = &schema {
      let constructed = run invokedEffect(&contract, Shared.clone<Type>(&result), run Type.applyBindings(&facts.failure, Vector.asSlice<Binding>(&inferred), true),
        run Row.applyBindings(&facts.requirements, Vector.asSlice<Binding>(&inferred), true))
      result = move constructed
    }
  }
  if partial {
    return run finishCallableSection(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, caller,
      &mut nodes.*, expression, span, target, mode, &contract, &inference, &fresh,
      Vector.asSlice<Binding>(&inferred), remaining, move operands, move result, constraints, expected, contractBody,
    )
  }
  if run typeMentionsOwner(&result, &fresh) { return run bodyRejection(&resolver.*, module, RejectionCode.UninferredParameter, span) }
  if Shared.with<Type, bool>(&result, rawCallableType) {
    let selected = originalCallableApplication(&actual)
    if facts.binders == usize.ZERO {
      if let Option<Shared<Application>>.Some {value} = move selected {
        let application = run Application.copyShared(&value)
        result = match move run callableResultType(&mut resolver.*, &mut owner.*, &mut dependencies.*,
          &application, constraints, span) {
          Result<Shared<Type>, Shared<Rejection>>.Success {value: returned} => move returned
          Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result.failResult<BodyNodeId, Shared<Rejection>>(move error) }
        }
      } else {
        result = run deferredCallableResult(&actual, Shared.clone<Type>(&result), Vector.asSlice<BodyNode>(&nodes.*), Vector.asSlice<BodyNodeId>(&operands), &fresh, Vector.asSlice<Binding>(&inferred))
      }
    } else {
      result = run deferredCallableResult(&actual, Shared.clone<Type>(&result), Vector.asSlice<BodyNode>(&nodes.*), Vector.asSlice<BodyNodeId>(&operands), &fresh, Vector.asSlice<Binding>(&inferred))
    }
  }
  result = match move run normalizeCallableResult(&mut resolver.*, &mut owner.*, &mut dependencies.*, module,
    constraints, &result, span) {
    Result<Shared<Type>, Shared<Rejection>>.Success {value} => move value
    Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result.failResult<BodyNodeId, Shared<Rejection>>(move error) }
  }
  // An `effect fn` value's invocation constructs the Effect its contract promises (EFF-001).
  let constructsEffect = Shared.with<Type, bool>(&result, bareEffect)
  if constructsEffect {
    let exact = run invokedConstruction(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, caller, &actual,
      Vector.asSlice<BodyNode>(&nodes.*), Vector.asSlice<BodyNodeId>(&operands),
      Vector.asSlice<Constraint>(&declared), constraints, expression.index, span)
    match move exact {
      Result<Option<Shared<Type>>, Shared<Rejection>>.Success {value} => {
        if let Option<Shared<Type>>.Some {value: constructed} = move value { result = move constructed }
      }
      Result<Option<Shared<Type>>, Shared<Rejection>>.Failure {error} => { return Result.failResult<BodyNodeId, Shared<Rejection>>(move error) }
    }
  }
  return run finishExpression(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, caller, constraints, &mut nodes.*,
    expression, span, move result,
    BodyExpression.CallableCall {callee: target, mode: mode, arguments: move operands,
      inference: run Shared.make<DeclarationId>(move fresh), bindings: run Shared.make<Vector<Binding>>(move inferred), pipeline: pipeline,
      constructs: constructsEffect,
    },
    false, expected, contractBody, false,
  )
}

// Invoking an `effect fn` value with every remaining operand constructs the exact Effect of
// calling its named target directly (EFF-001): the value's stored arguments and the supplied
// operands become the target's arguments in parameter order, with the target's channels and
// the run access and regions those stored arguments decide, as a written construction's. A
// generic section selects its target application from the operands exactly as lowering selects
// the one a run calls. Absent for an anonymous target, an abstract representation, or a section
// whose application its operands do not yet select: only an immediate `run` executes those.
effect fn invokedConstruction(resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, module: &ModuleId, caller: &DeclarationId, callee: &Shared<Type>,
  nodes: &[BodyNode], operands: &[BodyNodeId], premises: &[Constraint], constraints: &[Constraint],
  site: usize, span: Span) -> Result<Option<Shared<Type>>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let mut isPublic = false
  let mut application = Option.none<Shared<Application>>()
  let mut stored = Vector.make<Shared<Type>>()
  let mut inputs = Vector.make<CallableFieldInput>()
  match move run Type.copy(callee) {
    Type.CallableValue {isPublic: visible, application: selected, captures, fieldInputs, ..} => {
      let named = Shared.with<Application, bool>(&selected, fn(value: &Application) -> bool {
        let kind = DeclarationId.kind(Application.bodyDeclaration(value))
        return kind != OwnerKind.Anonymous && kind != OwnerKind.EffectBlock
      })
      if !named { return Result.succeed<Option<Shared<Type>>, Shared<Rejection>>(Option.none<Shared<Type>>()) }
      isPublic = visible
      application = Option.some<Shared<Application>>(move selected)
      stored = move captures
      inputs = move fieldInputs
    }
    Type.CallableSchema {schema, captures, fieldInputs, ..} => {
      let mut supplied = Vector.make<Shared<Type>>()
      let mut at = usize.ZERO
      while at < operands.length {
        match move bodyExpressionType(nodes, &operands[at]) {
          Option<Shared<Type>>.Some {value} => { run Vector.append<Shared<Type>>(&mut supplied, move value) }
          Option<Shared<Type>>.None => { return Result.succeed<Option<Shared<Type>>, Shared<Rejection>>(Option.none<Shared<Type>>()) }
        }
        at = at + usize.ONE
      }
      let identity = Vector.make<Binding>()
      let selected = run schemaCallableApplication(&mut resolver.*, &mut owner.*, &mut dependencies.*, module,
        Vector.asSlice<Binding>(&identity), premises, &schema, Vector.asSlice<Shared<Type>>(&supplied), span)
      let chosen = match move selected {
        Result<Application, PreparationFailure>.Success {value} => move value
        Result<Application, PreparationFailure>.Failure {..} => { return Result.succeed<Option<Shared<Type>>, Shared<Rejection>>(Option.none<Shared<Type>>()) }
      }
      let target = run DeclarationId.copy(Application.bodyDeclaration(&chosen))
      if DeclarationId.kind(&target) == OwnerKind.Anonymous {
        return Result.succeed<Option<Shared<Type>>, Shared<Rejection>>(Option.none<Shared<Type>>())
      }
      isPublic = run publicFunction(&mut resolver.*, &target)
      application = Option.some<Shared<Application>>(run Shared.make<Application>(move chosen))
      stored = move captures
      inputs = move fieldInputs
    }
    _ => { return Result.succeed<Option<Shared<Type>>, Shared<Rejection>>(Option.none<Shared<Type>>()) }
  }
  let target = match move application {
    Option<Shared<Application>>.Some {value} => value
    Option<Shared<Application>>.None => { return Result.succeed<Option<Shared<Type>>, Shared<Rejection>>(Option.none<Shared<Type>>()) }
  }
  let channels = match move run applicationChannels(&mut resolver.*, &mut owner.*, &mut dependencies.*, &target) {
    Option<EffectChannels>.Some {value} => value
    Option<EffectChannels>.None => { return Result.succeed<Option<Shared<Type>>, Shared<Rejection>>(Option.none<Shared<Type>>()) }
  }
  let fields = Vector.asSlice<Shared<Type>>(&stored)
  let slots = Vector.asSlice<CallableFieldInput>(&inputs)
  let mut arguments = Vector.make<StoredArgument>()
  let count = operands.length + slots.length
  let mut parameter = usize.ZERO
  while parameter < count {
    if parameter < operands.length {
      match move bodyExpressionType(nodes, &operands[parameter]) {
        Option<Shared<Type>>.Some {value} => {
          run Vector.append<StoredArgument>(&mut arguments, StoredArgument {ty: move value, moved: movedBodyValue(nodes, operands[parameter])})
        }
        Option<Shared<Type>>.None => { return Result.failResult<Option<Shared<Type>>, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.Unsupported, span)) }
      }
    } else {
      let mut slot = usize.ZERO
      while slot < slots.length && !callableInputParameter(&slots[slot], parameter) { slot = slot + usize.ONE }
      // A stored original environment is not an ordinary target argument.
      if slot == slots.length { return Result.succeed<Option<Shared<Type>>, Shared<Rejection>>(Option.none<Shared<Type>>()) }
      run Vector.append<StoredArgument>(&mut arguments, StoredArgument {ty: Shared.clone<Type>(&fields[slot]), moved: false})
    }
    parameter = parameter + usize.ONE
  }
  let built = match move run storedEffect(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, caller,
    Vector.asSlice<StoredArgument>(&arguments), move channels.success, move channels.failure, move channels.requirements,
    constraints, site, span) {
    Result<EffectConstruction, Shared<Rejection>>.Success {value} => value
    Result<EffectConstruction, Shared<Rejection>>.Failure {error} => { return Result.failResult<Option<Shared<Type>>, Shared<Rejection>>(move error) }
  }
  let EffectConstruction {contract, captures, fieldInputs} = move built
  return Result.succeed<Option<Shared<Type>>, Shared<Rejection>>(Option.some<Shared<Type>>(
    run Type.callableValue(isPublic, move target, move contract, move captures, move fieldInputs)))
}

// The channels of one closed target application, resolved exactly as a direct call of it
// resolves its signature, so an invoked construction and a written one have equal contracts.
effect fn applicationChannels(resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, application: &Shared<Application>) -> Option<EffectChannels>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let selected = run Application.copyShared(application)
  let declared = run DeclarationId.copy(Application.bodyDeclaration(&selected))
  let moduleAt = knownModuleOrdinal(&resolver.*, DeclarationId.moduleId(&declared))
  if moduleAt == usize.MAX { fail InvalidModulePath {} }
  let targetModule = run resolvedModule(&resolver.*, moduleAt)
  let identity = run Shared.make<DeclarationId>(move declared)
  let ordinal = match move run ordinalOfIdentity(&mut resolver.*, &targetModule, &identity) {
    Option<usize>.Some {value} => value
    Option<usize>.None => { return Option.none<EffectChannels>() }
  }
  let closed = Option.some<Application>(move selected)
  let mut applied = run resolveSignatureUnder(&mut resolver.*, &mut owner.*, Key {family: Family.Signature,
    module: moduleAt, name: usize.ZERO, declaration: ordinal, member: usize.ZERO, external: false},
    Vector.make<Dependency>(), Option.none<Vector<Argument>>(), Option.none<Vector<Argument>>(), &closed)
  while Vector.length<Dependency>(&applied.dependencies) > usize.ZERO {
    let edge = Vector.remove<Dependency>(&mut applied.dependencies, usize.ZERO)
    run Vector.append<Dependency>(&mut dependencies.*, move edge)
  }
  return match & applied.outcome {
    Outcome.Success {value: Value.Signature {signature}} => Option.some<EffectChannels>(EffectChannels {
      success: Shared.clone<Type>(&signature.result), failure: Shared.clone<Type>(&signature.failure),
      requirements: Shared.clone<Row>(&signature.requirements)})
    _ => Option.none<EffectChannels>()
  }
}

// Whether a function declaration is public; visibility never changes a type's identity.
effect fn publicFunction(resolver: &mut Resolver, identity: &DeclarationId) -> bool
! Cycle | InvalidModulePath | OutOfMemoryError ? &mut Allocator {
  let moduleAt = knownModuleOrdinal(&resolver.*, DeclarationId.moduleId(identity))
  if moduleAt == usize.MAX { fail InvalidModulePath {} }
  let declaredModule = run resolvedModule(&resolver.*, moduleAt)
  let shared = run Shared.make<DeclarationId>(run DeclarationId.copy(identity))
  let ordinal = match move run ordinalOfIdentity(&mut resolver.*, &declaredModule, &shared) {
    Option<usize>.Some {value} => value
    Option<usize>.None => { return false }
  }
  let declared = run header(&mut resolver.*, &declaredModule, ordinal)
  if let Option<HeaderSyntax>.Some {value: written} = move declared {
    if let Node.FunctionHeader {isPublic, ..} = written.header { return isPublic }
  }
  return false
}

// The contract's promised run access and retained regions, with this invocation's channels.
// Invocation operands add no region: an operand Effect whose caller-local environment the fixed
// binder does not name is admitted only under retained relations to the binder's regions
// (`relatedEffectEnvironment`), so the promised environment bounds it, and a borrowed remaining
// parameter or an unfixed environment binder is still a deferral. Lifting that deferral must add
// the operands' retained regions here (LIFE-004).
effect fn invokedEffect(contract: &Shared<Type>, success: Shared<Type>, failure: Shared<Type>, requirements: Shared<Row>) -> Shared<Type>
! OutOfMemoryError ? &mut Allocator {
  let promised = match move run Type.copy(contract) {
    Type.Callable {result, ..} => result
    _ => { return absurd<Shared<Type>>() }
  }
  return match move run Type.copy(&promised) {
    Type.Effect {mode, environment, ..} => run Shared.make<Type>(Type.Effect {mode: mode, environment: move environment,
      success: move success, failure: move failure, requirements: move requirements})
    _ => absurd<Shared<Type>>()
  }
}

// Preserve checked type evidence only. Argument ownership remains at the original invocation.
effect fn deferredCallableResult(producer: &Shared<Type>, contract: Shared<Type>, nodes: &[BodyNode],
  operands: &[BodyNodeId], inference: &DeclarationId, bindings: &[Binding]) -> Shared<Type> ! OutOfMemoryError ? &mut Allocator {
  let mut arguments = Vector.make<Shared<Type>>()
  let mut at = usize.ZERO
  while at < operands.length {
    let ty = match move bodyExpressionType(nodes, &operands[at]) {
      Option<Shared<Type>>.Some {value} => move value _ => absurd<Shared<Type>>()
    }
    run Vector.append<Shared<Type>>(&mut arguments, move ty)
    at = at + usize.ONE
  }
  let mut selected = Vector.make<Argument>()
  let mut selectedOrdinals = Vector.make<usize>()
  at = usize.ZERO
  while at < bindings.length {
    if Shared.with<DeclarationId, bool>(&bindings[at].declaration, fn(value: &DeclarationId) -> bool { return DeclarationId.equals(value, inference) }) {
      run Vector.append<Argument>(&mut selected, Argument.copy(&bindings[at].value))
      run Vector.append<usize>(&mut selectedOrdinals, bindings[at].ordinal)
    }
    at = at + usize.ONE
  }
  return run Shared.make<Type>(Type.CallableResult {producer: Shared.clone<Type>(producer), contract: move contract,
    arguments: move arguments, selected: move selected, selectedOrdinals: move selectedOrdinals})
}

fn originalCallableApplication(value: &Shared<Type>) -> Option<Shared<Application>> {
  let nested = Shared.with<Type, Option<Shared<Type>>>(value, fn(ty: &Type) -> Option<Shared<Type>> {
    return match &ty.* {
      Type.CallableView {representation, ..} => Option.some<Shared<Type>>(Shared.clone<Type>(&representation))
      _ => Option.none<Shared<Type>>()
    }
  })
  if let Option<Shared<Type>>.Some {value: storage} = move nested { return originalCallableApplication(&storage) }
  return Shared.with<Type, Option<Shared<Application>>>(value, fn(ty: &Type) -> Option<Shared<Application>> {
    return match &ty.* {
      Type.CallableValue {application, ..} => Option.some<Shared<Application>>(Shared.clone<Application>(&application))
      _ => Option.none<Shared<Application>>()
    }
  })
}

fn movedBodyValue(nodes: &[BodyNode], node: BodyNodeId) -> bool {
  return match &nodes[node.index].kind {
    BodyNodeKind.Expression {form: BodyExpression.Move {..}, ..} => true
    _ => false
  }
}

// Staging carries the original target and capture order forward. It is an aggregate
// construction, so unsafe acknowledgement belongs to its eventual invocation.
effect fn finishCallableSection(resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, module: &ModuleId, caller: &DeclarationId,
  nodes: &mut Vector<BodyNode>, expression: HirId, span: Span, callee: BodyNodeId,
  transport: CallableMode, visible: &Shared<Type>, signature: &Shared<Result<Answer, NoRejection>>,
  fresh: &DeclarationId, bindings: &[Binding], remaining: usize, arguments: Vector<BodyNodeId>,
  result: Shared<Type>, constraints: &[Constraint], expected: &Option<Shared<Type>>, contractBody: bool)
  -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let baseType = match move bodyExpressionType(Vector.asSlice<BodyNode>(&nodes.*), &callee) {
    Option<Shared<Type>>.Some {value} => move value
    _ => { return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span) }
  }
  let invocationBinders = Shared.with<Type, usize>(visible, fn(value: &Type) -> usize {
    return match &value.* { Type.Callable {invocationBinders, ..} => invocationBinders _ => usize.ZERO }
  })
  let originalMode = Shared.with<Type, CallableMode>(visible, callableInvocationMode)
  let isUnsafe = Shared.with<Result<Answer, NoRejection>, bool>(signature, signatureUnsafe)
  // Anonymous schemas map invocation lifetimes back to their declaration slots. Named
  // quantified sections and row staging retain their separate source-recipe boundary.
  let schema = Shared.with<Type, Option<Shared<SectionSchema>>>(&baseType, sectionSchemaOf)
  let generic = match &schema { Option<Shared<SectionSchema>>.Some {..} => true _ => false }
  if (invocationBinders != usize.ZERO && !Shared.with<Type, bool>(&baseType, anonymousSectionType))
    || (!generic && run typeMentionsOwner(&result, fresh)) {
    return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
  }
  let mut suffixMode = CallableMode.Shared
  let mut captures = Vector.make<Shared<Type>>()
  let mut regions = Vector.make<Shared<Lifetime>>()
  if !run captureRetainedRegions(&baseType, caller, expression.index, constraints, &mut regions) {
    return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
  }
  let supplied = Vector.asSlice<BodyNodeId>(&arguments)
  let mut at = usize.ZERO
  while at < supplied.length {
    let ty = match move bodyExpressionType(Vector.asSlice<BodyNode>(&nodes.*), &supplied[at]) {
      Option<Shared<Type>>.Some {value} => move value
      _ => { return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span) }
    }
    let mutableReference = Shared.with<Type, bool>(&ty, fn(value: &Type) -> bool {
      return match &value.* { Type.Reference {access, ..} => access == Access.Mutable
        Type.Slice {access, ..} => access == Access.Mutable _ => false }
    })
    if mutableReference && !movedBodyValue(Vector.asSlice<BodyNode>(&nodes.*), supplied[at]) {
      if suffixMode == CallableMode.Shared { suffixMode = CallableMode.Mutable }
    } else {
      let copied = run copyType(&mut resolver.*, &mut owner.*, &mut dependencies.*, &ty, constraints, span)
      match move copied {
        Result<bool, Shared<Rejection>>.Success {value} => { if !value { suffixMode = CallableMode.Once } }
        Result<bool, Shared<Rejection>>.Failure {error} => { return Result.failResult<BodyNodeId, Shared<Rejection>>(move error) }
      }
    }
    if !run captureRetainedRegions(&ty, caller, expression.index, constraints, &mut regions) {
      return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
    }
    run Vector.append<Shared<Type>>(&mut captures, move ty)
    at = at + usize.ONE
  }
  let mut parameters = Vector.make<Shared<Type>>()
  at = usize.ZERO
  while at < remaining {
    let raw = match move Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(signature,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> { return signatureParameter(answer, at) }) {
      Option<Shared<Type>>.Some {value} => move value
      _ => { return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span) }
    }
    run Vector.append<Shared<Type>>(&mut parameters, run Type.applyBindings(&raw, bindings, true))
    at = at + usize.ONE
  }
  let mut mode = originalMode
  if suffixMode == CallableMode.Once { mode = CallableMode.Once }
  if suffixMode == CallableMode.Mutable && mode == CallableMode.Shared { mode = CallableMode.Mutable }
  let contract = run Shared.make<Type>(Type.Callable {mode: mode, isUnsafe: isUnsafe,
    environment: run Shared.make<Intersection>(run Intersection.of(Vector.asSlice<Shared<Lifetime>>(&regions))),
    invocationBinders: usize.ZERO, invocationUse: usize.MAX, invocationBounds: Vector.make<Outlives>(), parameters: move parameters, result: move result})
  let ty = match move schema {
    Option<Shared<SectionSchema>>.Some {value} => match move run stagedSectionSchema(&mut resolver.*, &mut owner.*, &mut dependencies.*, module,
      &baseType, &value, move contract, signature, fresh, bindings, remaining, move captures,
      constraints, sectionContext(expected, false), span) {
      Result<Shared<Type>, Shared<Rejection>>.Success {value: ty} => move ty
      Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result.failResult<BodyNodeId, Shared<Rejection>>(move error) }
    }
    _ => run Type.stagedCallable(move baseType, move contract, move captures, remaining, suffixMode, caller)
  }
  return run finishExpression(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, caller, constraints, &mut nodes.*,
    expression, span, move ty,
    BodyExpression.StagedCallable {callee: callee, mode: transport, arguments: move arguments},
    false, expected, contractBody, false)
}

// Generic staging keeps a bound target blueprint while selecting evidence supplied at this
// construction. Captures append physically; their input ordinals still name the original target.
effect fn stagedSectionSchema(resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, module: &ModuleId, base: &Shared<Type>,
  recipe: &Shared<SectionSchema>, contract: Shared<Type>, signature: &Shared<Result<Answer, NoRejection>>,
  fresh: &DeclarationId, bindings: &[Binding], remaining: usize, captures: Vector<Shared<Type>>, constraints: &[Constraint], contextual: bool, span: Span)
  -> Result<Shared<Type>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let copied = run CallableSchema.copy(recipe)
  let target = run DeclarationId.copyShared(&copied.target)
  let mut request = Request.make()
  let sourceSchema = match move run resolveTargetSchema(&mut resolver.*, &mut owner.*, &mut request,
    &mut dependencies.*, true, &target, span) {
    Option<TargetSchema>.Some {value} => move value
    _ => { return Result.failResult<Shared<Type>, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.Unsupported, span)) }
  }
  let mut evidence = Vector.make<Binding>()
  let fixed = Vector.asSlice<Binding>(&copied.selected)
  let mut at = usize.ZERO
  while at < fixed.length {
    if declarationEqualsShared(&target, &fixed[at].declaration) {
      run Vector.append<Binding>(&mut evidence, Binding {
        declaration: run Shared.make<DeclarationId>(run DeclarationId.copy(fresh)), ordinal: sectionInferenceOrdinal(&sourceSchema, signature, fixed[at].ordinal),
        value: Argument.copy(&fixed[at].value)})
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < bindings.length {
    run Vector.append<Binding>(&mut evidence, Binding {declaration: Shared.clone<DeclarationId>(&bindings[at].declaration),
      ordinal: bindings[at].ordinal, value: Argument.copy(&bindings[at].value)})
    at = at + usize.ONE
  }
  // A deferred `?S` selector is inferred once this invocation solves its provider and source row.
  let freshIdentity = run Shared.make<DeclarationId>(run DeclarationId.copy(fresh))
  let selectorFailure = run inferProvidedSelectors(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, signature,
    &freshIdentity, fresh, constraints, &mut evidence, span)
  if let Option<Shared<Rejection>>.Some {value} = move selectorFailure {
    return Result.failResult<Shared<Type>, Shared<Rejection>>(move value)
  }
  let selected = match move run sectionSelection(&resolver.*, module, &target, &sourceSchema, signature,
    fresh, Vector.asSlice<Binding>(&evidence), remaining, constraints, contextual, span) {
    Result<SectionSelection, Shared<Rejection>>.Success {value} => move value
    Result<SectionSelection, Shared<Rejection>>.Failure {error} => { return Result.failResult<Shared<Type>, Shared<Rejection>>(move error) }
  }
  let mut choice = move selected
  at = usize.ZERO
  while at < fixed.length {
    if !declarationEqualsShared(&target, &fixed[at].declaration) {
      run Vector.append<Binding>(&mut choice.selected, Binding {declaration: Shared.clone<DeclarationId>(&fixed[at].declaration),
        ordinal: fixed[at].ordinal, value: Argument.copy(&fixed[at].value)})
    }
    at = at + usize.ONE
  }
  let written = match move run CallableContract.ofType(&copied.contract) {
    Option<CallableFacts>.Some {value} => move value _ => { return absurd<Result<Shared<Type>, Shared<Rejection>>>() }
  }
  let current = match move run CallableContract.ofType(&contract) {
    Option<CallableFacts>.Some {value} => move value _ => { return absurd<Result<Shared<Type>, Shared<Rejection>>>() }
  }
  let mut parameters = Vector.make<Shared<Type>>()
  let original = Vector.asSlice<Shared<Type>>(&written.parameters)
  at = usize.ZERO
  while at < remaining {
    if at >= original.length { return absurd<Result<Shared<Type>, Shared<Rejection>>>() }
    run Vector.append<Shared<Type>>(&mut parameters, Shared.clone<Type>(&original[at]))
    at = at + usize.ONE
  }
  let blueprint = run Shared.make<Type>(Type.Callable {mode: current.mode, isUnsafe: written.isUnsafe,
    environment: move current.environment, invocationBinders: written.invocationBinders,
    invocationUse: written.invocationUse, invocationBounds: move written.invocationBounds, parameters: move parameters, result: move written.result})
  let mut fields = Vector.make<Shared<Type>>()
  let mut inputs = Vector.make<CallableFieldInput>()
  let storage = run Type.copy(base)
  if let Type.CallableSchema {captures: previous, fieldInputs, ..} = move storage {
    let oldFields = Vector.asSlice<Shared<Type>>(&previous)
    let oldInputs = Vector.asSlice<CallableFieldInput>(&fieldInputs)
    if DeclarationId.kind(&target) == OwnerKind.Anonymous && oldInputs.length == usize.ZERO {
      run Vector.append<Shared<Type>>(&mut fields, Shared.clone<Type>(base))
      run Vector.append<CallableFieldInput>(&mut inputs, CallableFieldInput.Environment)
    } else {
    at = usize.ZERO
    while at < oldFields.length {
      if at >= oldInputs.length { return absurd<Result<Shared<Type>, Shared<Rejection>>>() }
      run Vector.append<Shared<Type>>(&mut fields, Shared.clone<Type>(&oldFields[at]))
      run Vector.append<CallableFieldInput>(&mut inputs, oldInputs[at])
      at = at + usize.ONE
    }
    }
  } else { return absurd<Result<Shared<Type>, Shared<Rejection>>>() }
  let supplied = Vector.asSlice<Shared<Type>>(&captures)
  at = usize.ZERO
  while at < supplied.length {
    run Vector.append<Shared<Type>>(&mut fields, Shared.clone<Type>(&supplied[at]))
    run Vector.append<CallableFieldInput>(&mut inputs, CallableFieldInput.Argument {parameter: remaining + at})
    at = at + usize.ONE
  }
  if Vector.length<usize>(&choice.deferred) == usize.ZERO {
    // A completed schema has the same source identity as direct section construction.
    // Preserve original sparse slots, checked target selection and public visibility.
    let slots = Vector.asSlice<ApplicationSlot>(&sourceSchema.own)
    let mut arguments = Vector.make<Argument>()
    at = usize.ZERO
    while at < slots.length {
      let argument = match move bindingArgument(Vector.asSlice<Binding>(&choice.selected), &target, slots[at].ordinal) {
        Option<Argument>.Some {value} => move value
        _ => { return Result.failResult<Shared<Type>, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.Unsupported, span)) }
      }
      run Vector.append<Argument>(&mut arguments, move argument)
      at = at + usize.ONE
    }
    let original = run sectionOriginalSignature(&mut resolver.*, &mut owner.*, &mut dependencies.*, &target, span)
    let scopes = match move run sectionScopeArguments(&sourceSchema, Vector.asSlice<Binding>(&choice.selected)) {
      Option<Vector<Argument>>.Some {value} => move value
      _ => { return Result.failResult<Shared<Type>, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.Unsupported, span)) }
    }
    let application = match move run checkedDirectApplication(&mut resolver.*, &mut owner.*, &mut request,
      &mut dependencies.*, &target, &original, move arguments, &scopes, module, span) {
      Result<Application, Shared<Rejection>>.Success {value} => move value
      Result<Application, Shared<Rejection>>.Failure {error} => { return Result.failResult<Shared<Type>, Shared<Rejection>>(move error) }
    }
    let identity = run Shared.make<DeclarationId>(run DeclarationId.copy(&target))
    let ordinal = match move run ordinalOfIdentity(&mut resolver.*, DeclarationId.moduleId(&target), &identity) {
      Option<usize>.Some {value} => value
      _ => { return Result.failResult<Shared<Type>, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.Unsupported, span)) }
    }
    let written = match move run signatureSyntax(&mut resolver.*, DeclarationId.moduleId(&target), ordinal) {
      Option<WrittenSignature>.Some {value} => move value
      _ => { return Result.failResult<Shared<Type>, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.Unsupported, span)) }
    }
    let exposed = run Type.applyBindings(&blueprint, Vector.asSlice<Binding>(&choice.selected), true)
    return Result.succeed<Shared<Type>, Shared<Rejection>>(run Type.callableValue(written.isPublic,
      run Shared.make<Application>(move application), move exposed, move fields, move inputs))
  }
  let schema = run Shared.make<SectionSchema>(SectionSchema {target: move copied.target, contract: move blueprint,
    selected: move choice.selected, deferred: move choice.deferred})
  return Result.succeed<Shared<Type>, Shared<Rejection>>(run Type.callableSchema(move schema, move fields, move inputs))
}

// The composition intrinsic a pipeline's call target resolved to, if any.
effect fn pipedComposition(calls: &[ResolvedCall], target: HirId) -> Option<ResolvedTarget> ! OutOfMemoryError ? &mut Allocator {
  let found = run resolvedCall(calls, target)
  if let Option<Result<ResolvedTarget, Shared<Rejection>>>.Some {value: resolved} = move found {
    if let Result<ResolvedTarget, Shared<Rejection>>.Success {value} = move resolved {
      let composition = match &value { ResolvedTarget.Composition {..} => true _ => false }
      if composition { return Option.some<ResolvedTarget>(move value) }
    }
  }
  return Option.none<ResolvedTarget>()
}

effect fn checkInvocation<'scope>(
  resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>, request: &mut Request,
  dependencies: &mut Vector<Dependency>, module: &ModuleId, cursor: &AuthoredCursor,
  caller: &DeclarationId, statementScope: &mut StatementScope<'scope>, calls: &[ResolvedCall], nodes: &mut Vector<BodyNode>,
  signatures: &mut Vector<SignatureDependency>, requiredBodies: &mut Vector<DeclarationId>,
  expression: HirId, input: CallInput, expected: &Option<Shared<Type>>, constraints: &[Constraint],
  contractBody: bool, staticBody: bool, unsafeAllowed: bool, callAcknowledged: bool, valueConstruction: bool,
  promised: &Option<NamedCallableEvidence>,
) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let CallInput {callee, generics, arguments, pipeline} = input
  let span = run bodySpan(&resolver.source, cursor, expression)
  let mut ty = run Shared.make<Type>(Type.Unit)
  let mut form = BodyExpression.Unit
  let calleeSyntax = run bodyNode(&resolver.source, cursor, callee)
  // `inner |> Intrinsic.bindRequirement<S>(provider)` supplies the piped Effect as the first part.
  if pipeline {
    if let Node.CallExpression {arguments: rest, ..} = calleeSyntax {
      if let CallArguments.Single {expression: piped} = arguments {
        let composed = run pipedComposition(calls, callee)
        if let Option<ResolvedTarget>.Some {value: ResolvedTarget.Composition {operation, written}} = move composed {
          if staticBody { return run bodyRejection(&resolver.*, module, RejectionCode.StaticPhaseViolation, span) }
          return run checkComposition(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module, cursor,
            caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*, expression, span,
            operation, move written, CallArguments.Piped {input: piped, range: rest}, expected, constraints, contractBody,
            unsafeAllowed)
        }
      }
    }
  }
  let valueTarget = callableExpressionTarget(calleeSyntax)
  if valueTarget {
    return run checkCallableInvocation(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
      module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*,
      expression, callee, generics, arguments, pipeline, expected, constraints, contractBody, staticBody, unsafeAllowed, callAcknowledged,
    )
  }
  let qualified = run bodyQualifiedName(&resolver.source, cursor, callee)
  if !staticBody {
    if let Option<QualifiedBodyName>.Some {value} = &qualified {
      let mut selection = Option.none<Result<EnumSelection, Shared<Rejection>>>()
      if let Option<HirId>.None = &value.application {
        selection = run checkedEnumSelection(&mut resolver.*, &mut owner.*, &mut dependencies.*,
          module, Bytes.asSlice(&value.namespace), Bytes.asSlice(&value.member), span, true,
        )
      }
      if let Option<Result<EnumSelection, Shared<Rejection>>>.Some {value: selected} = move selection {
        let chosen = match move selected {
          Result<EnumSelection, Shared<Rejection>>.Success {value: choice} => choice
          Result<EnumSelection, Shared<Rejection>>.Failure {error} => {
            return Result.failResult<BodyNodeId, Shared<Rejection>>(move error)
          }
        }
        if let EnumSelection.Value {ty: enumType, representation} = move chosen {
          if generics.present { return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span) }
          if CallArguments.length(arguments) != usize.ONE { return run bodyRejection(&resolver.*, module, RejectionCode.CallArity, span) }
          let argument = run bodyArgument(&resolver.source, cursor, arguments, usize.ZERO)
          let checked = run checkExpression(&mut resolver.*, &mut owner.*, &mut request.*,
            &mut dependencies.*, module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*,
            &mut signatures.*, &mut requiredBodies.*, argument, &Option.some<Shared<Type>>(move enumType),
            constraints, contractBody, false, unsafeAllowed,
          )
          let operand = match move checked {
            Result<BodyNodeId, Shared<Rejection>>.Success {value: node} => node
            Result<BodyNodeId, Shared<Rejection>>.Failure {error} => {
              return Result.failResult<BodyNodeId, Shared<Rejection>>(move error)
            }
          }
          let index = Vector.length<BodyNode>(&nodes.*)
          run Vector.append<BodyNode>(&mut nodes.*, BodyNode {
            origin: BodyOrigin {syntax: expression, span: span},
            kind: BodyNodeKind.Expression {ty: move representation, form: BodyExpression.EnumValue {value: operand},
              },
          },
          )
          return run checkExpectedValue(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, caller, constraints, &mut nodes.*,
            BodyNodeId {index: index}, expected, span,
          )
        }
        return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
      }
    }
  }
  let receiverSpelling = match & qualified {
    Option<QualifiedBodyName>.Some {..} => false
    Option<QualifiedBodyName>.None => true
  }
  if let Option<QualifiedBodyName>.Some {value: name} = move qualified {
    let moduleOrdinal = knownModuleOrdinal(&resolver.*, module)
    if moduleOrdinal == usize.MAX {
      fail InvalidModulePath {}
    }
    let selection = run selectDeclaration(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies.*,
      moduleOrdinal,
      module,
      Bytes.asSlice(&name.namespace),
      false,
      name.subjectSpan,
      RejectionCode.NotCallable,
    )
    if let Result<SelectedDeclaration, Shared<Rejection>>.Success {value: target} = move selection {
      let declaredModule = run resolvedModule(&resolver.*, target.module)
      let written = run header(&mut resolver.*, &declaredModule, target.ordinal)
      if let Option<HeaderSyntax>.Some {value: named} = move written {
        if let Node.InterfaceHeader {isPublic, ..} = named.header {
          if pipeline { return run bodyRejection(&resolver.*, module, RejectionCode.PipelineInterfaceUnavailable, span,
            ) }
          return run checkQualifiedInterfaceCall(
            &mut resolver.*,
            &mut owner.*,
            &mut request.*,
            &mut dependencies.*,
            module,
            cursor,
            caller,
            &mut statementScope.*,
            calls,
            &mut nodes.*,
            &mut signatures.*,
            &mut requiredBodies.*,
            expression,
            generics,
            arguments,
            expected,
            constraints,
            contractBody,
            &name,
            move target,
            isPublic,
            unsafeAllowed,
            callAcknowledged,
          )
        }
      }
    }
  }
  if receiverSpelling {
    if let Node.FieldExpression {subject, field} = run bodyNode(
      &resolver.source,
      cursor,
      callee) {
      return run checkReceiverCall(
        &mut resolver.*,
        &mut owner.*,
        &mut request.*,
        &mut dependencies.*,
        module,
        cursor,
        caller,
        &mut statementScope.*,
        calls,
        &mut nodes.*,
        &mut signatures.*,
        &mut requiredBodies.*,
        expression,
        callee,
        subject,
        field,
        generics,
        arguments,
        pipeline,
        expected,
        constraints,
        contractBody,
        staticBody,
        unsafeAllowed,
        callAcknowledged,
      )
    }
  }
  let found = run resolvedCall(calls, expression)
  let resolved = match move found {
    Option<Result<ResolvedTarget, Shared<Rejection>>>.Some {value} => match move value {
      Result<ResolvedTarget, Shared<Rejection>>.Success {value: target} => target
      Result<ResolvedTarget, Shared<Rejection>>.Failure {error} => {
        return Result.failResult<BodyNodeId, Shared<Rejection>>(move error)
      }
    }
    Option<Result<ResolvedTarget, Shared<Rejection>>>.None => {
      return run bodyRejection(&resolver.*, module, RejectionCode.CallTargetUnavailable, span)
    }
  }
  let target = match move resolved {
    ResolvedTarget.Function {target} => target
    ResolvedTarget.Tuple {ty: tupleType, elements} => {
      if callAcknowledged { return run bodyRejection(&resolver.*, module, RejectionCode.UnsafeInvocation, span) }
      return run checkPositionalAggregate(&mut resolver.*, &mut owner.*, &mut request.*,
        &mut dependencies.*, module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*,
        &mut signatures.*, &mut requiredBodies.*, expression, arguments,
        &tupleType, Vector.asSlice<Shared<Type>>(&elements), &Option.none<InferredAggregateTarget>(), expected,
        constraints, contractBody, staticBody, unsafeAllowed,
      )
    }
    ResolvedTarget.Constant {..} => {
      return run bodyRejection(&resolver.*, module, RejectionCode.NotCallable, span)
    }
    ResolvedTarget.ForeignStatic {..} => {
      return run bodyRejection(&resolver.*, module, RejectionCode.NotCallable, span)
    }
    ResolvedTarget.Composition {operation, written} => {
      if staticBody { return run bodyRejection(&resolver.*, module, RejectionCode.StaticPhaseViolation, span) }
      return run checkComposition(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module, cursor,
        caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*, expression, span,
        operation, move written, arguments, expected, constraints, contractBody, unsafeAllowed)
    }
    ResolvedTarget.Selected {..} => {
      return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
    }
    ResolvedTarget.Storage {operation, typeArguments} => {
      if staticBody { return run bodyRejection(&resolver.*, module, RejectionCode.StaticPhaseViolation, span) }
      return run checkStorageCall(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module, cursor,
        caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*, expression, span,
        operation, move typeArguments, arguments, expected, constraints, contractBody, unsafeAllowed, callAcknowledged)
    }
    ResolvedTarget.Intrinsic {member, typeArguments} => {
      if callAcknowledged && !intrinsicIsUnsafe(member) {
        return run bodyRejection(&resolver.*, module, RejectionCode.UnsafeInvocation, span)
      }
      if intrinsicIsUnsafe(member) && !unsafeAllowed && !callAcknowledged {
        return run bodyRejection(&resolver.*, module, RejectionCode.UnsafeAcknowledgement, span)
      }
      if staticBody == intrinsicIsRuntime(member) {
        return run bodyRejection(&resolver.*, module, RejectionCode.StaticPhaseViolation, span)
      }
      if CheckedIntrinsic.sequencePending(member) { return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span) }
      if CallArguments.length(arguments) != intrinsicArity(member) {
        return run bodyRejection(&resolver.*, module, RejectionCode.CallArity, span)
      }
      if intrinsicIsReflection(member) {
        return run checkReflectionCall(
          &mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module, cursor, caller,
          &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*, expression, span, member,
          Vector.asSlice<Shared<Type>>(&typeArguments), arguments, expected, constraints, contractBody,
          staticBody, unsafeAllowed,
        )
      }
      // A generic primitive is instantiated from its type arguments; others have closed kinds. A
      // checked scalar operation returns through its `present` and `absent` carriers.
      let generic = intrinsicIsGeneric(member)
      let instantiation = Vector.asSlice<Shared<Type>>(&typeArguments)
      let mut carriers = usize.MAX
      if let Option<usize>.Some {value: start} = move intrinsicCarrierStart(member) { carriers = start }
      let mut checkedArguments = Vector.make<BodyNodeId>()
      let mut firstArgument = Option.none<Shared<Type>>()
      let mut at = usize.ZERO
      while at < CallArguments.length(arguments) {
        let mut kind = IntrinsicValueKind.Text
        let mut context = Option.none<Shared<Type>>()
        // A carrier is checked without context, as a composition operand is; its offered contract
        // is then compared with the carrier contract. A named function carrier takes the binders its
        // target leaves open, such as a generic impl's, from that contract.
        let mut contract = Option.none<Shared<Type>>()
        if generic {
          context = run intrinsicGenericParameter(member, instantiation, at)
        } else if at >= carriers {
          contract = run intrinsicCarrierContract(member, instantiation, at)
        } else {
          kind = match move intrinsicParameterKind(member, at) {
            Option<IntrinsicValueKind>.Some {value} => value
            Option<IntrinsicValueKind>.None => {
              return run bodyRejection(&resolver.*, module, RejectionCode.CallArity, span)
            }
          }
          if intrinsicContextual(kind) {
            context = Option.some<Shared<Type>>(run intrinsicValueType(kind))
          }
        }
        let argumentId = run bodyArgument(&resolver.source, cursor, arguments, at)
        let mut namedValue = Option.none<Result<BodyNodeId, Shared<Rejection>>>()
        if let Option<Shared<Type>>.Some {value: carrier} = &contract {
          let promised = Option.some<NamedCallableEvidence>(NamedCallableEvidence {
            contract: Shared.clone<Type>(&carrier), pending: Option.none<DeclarationId>()})
          namedValue = run checkNamedValue(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
            module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*,
            argumentId, &context, &promised, constraints, contractBody, staticBody, unsafeAllowed)
        }
        let checked = match move namedValue {
          Option<Result<BodyNodeId, Shared<Rejection>>>.Some {value: valueResult} => move valueResult
          Option<Result<BodyNodeId, Shared<Rejection>>>.None => run checkExpression(&mut resolver.*, &mut owner.*,
            &mut request.*, &mut dependencies.*, module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*,
            &mut signatures.*, &mut requiredBodies.*, argumentId, &context, constraints, contractBody, staticBody, unsafeAllowed)
        }
        let mut argumentNode = match move checked {
          Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
          Result<BodyNodeId, Shared<Rejection>>.Failure {error} => {
            return Result.failResult<BodyNodeId, Shared<Rejection>>(move error)
          }
        }
        // A pointer argument takes the ordinary immediate weakening to its instantiated parameter.
        if let Option<Shared<Type>>.Some {value: parameterType} = &context {
          if generic {
            let noVariables = Vector.make<Shared<DeclarationId>>()
            let noBindings = Vector.make<Binding>()
            argumentNode = run pointerArgument(&mut nodes.*, argumentNode, &parameterType,
              Vector.asSlice<Shared<DeclarationId>>(&noVariables), Vector.asSlice<Binding>(&noBindings))
          }
        }
        if at >= carriers {
          let carried = run carrierArgument(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor, &mut nodes.*,
            argumentNode, argumentId, &contract, constraints)
          argumentNode = match move carried {
            Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
            Result<BodyNodeId, Shared<Rejection>>.Failure {error} => {
              return Result.failResult<BodyNodeId, Shared<Rejection>>(move error)
            }
          }
          run Vector.append<BodyNodeId>(&mut checkedArguments, argumentNode)
          at = at + usize.ONE
          continue
        }
        let evidence = bodyExpressionType(Vector.asSlice<BodyNode>(&nodes.*), &argumentNode)
        let mut valid = false
        if let Option<Shared<Type>>.Some {value: argumentType} = move evidence {
          if !generic {
            let closedKind = kind
            valid = Shared.with<Type, bool>(
              &argumentType,
              fn(resolved: &Type) -> bool {
                return intrinsicMatches(closedKind, resolved)
              },
            )
          } else {
            if let Option<Shared<Type>>.Some {value: parameterType} = &context {
              valid = run Type.equalsShared(&argumentType, &parameterType)
            } else {
              valid = run intrinsicGenericArgument(member, instantiation, at, &argumentType)
            }
          }
          if at == usize.ZERO { firstArgument = Option.some<Shared<Type>>(move argumentType) }
        }
        if !valid {
          return run bodyRejection(&resolver.*, module, RejectionCode.TypeMismatch, span)
        }
        run Vector.append<BodyNodeId>(&mut checkedArguments, argumentNode)
        at = at + usize.ONE
      }
      if generic {
        // A view keeps its argument's exact slice type, including the caller's loan.
        let mut instantiated = move firstArgument
        if !intrinsicIsPrimitive(member, IntrinsicPrimitive.SliceView) {
          instantiated = run intrinsicGenericResult(member, instantiation)
        }
        ty = match move instantiated {
          Option<Shared<Type>>.Some {value} => value
          Option<Shared<Type>>.None => {
            return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
          }
        }
        if !run intrinsicQualifies(member, instantiation) {
          return run bodyRejection(&resolver.*, module, RejectionCode.InvalidPointerQualifier, span)
        }
        if intrinsicIsPrimitive(member, IntrinsicPrimitive.PointerRead) || intrinsicIsPrimitive(member, IntrinsicPrimitive.PointerReadUnaligned) {
          let readable = run copyType(&mut resolver.*, &mut owner.*, &mut dependencies.*, &ty, constraints, span)
          let copied = match move readable {
            Result<bool, Shared<Rejection>>.Success {value} => value
            Result<bool, Shared<Rejection>>.Failure {error} => {
              return Result.failResult<BodyNodeId, Shared<Rejection>>(move error)
            }
          }
          if !copied {
            return run bodyRejection(&resolver.*, module, RejectionCode.MissingConformance, span)
          }
        }
      } else if carriers != usize.MAX {
        // Both carriers produce the call's result type argument.
        ty = Shared.clone<Type>(&instantiation[usize.ZERO])
      } else {
        ty = match move intrinsicResultKind(member) {
          Option<IntrinsicValueKind>.Some {value: resultKind} => run intrinsicValueType(resultKind)
          Option<IntrinsicValueKind>.None => {
            return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
          }
        }
      }
      if intrinsicIsPrimitive(member, IntrinsicPrimitive.Assembly) {
        let admitted = run assemblyAdmitted(&resolver.*, cursor, Vector.asSlice<BodyNode>(&nodes.*),
          Vector.asSlice<BodyNodeId>(&checkedArguments), &ty)
        if !admitted { return run bodyRejection(&resolver.*, module, RejectionCode.InvalidConfiguration, span) }
      }
      if let Option<Shared<Type>>.Some {value} = &expected.* {
        if !run Type.equalsShared(&ty, &value) {
          return run bodyRejection(&resolver.*, module, RejectionCode.TypeMismatch, span)
        }
      }
      let index = Vector.length<BodyNode>(&nodes.*)
      run Vector.append<BodyNode>(
        &mut nodes.*,
        BodyNode {
          origin: BodyOrigin {syntax: expression, span: span},
          kind: BodyNodeKind.Expression {
            ty: move ty,
            form: BodyExpression.IntrinsicCall {
              member: member,
              arguments: move checkedArguments},
          },
        },
      )
      return Result.succeed<BodyNodeId, Shared<Rejection>>(BodyNodeId {index: index})
    }
  }
  // A runtime body reaches a static function only through its selection pass, which embeds the
  // result; an unselected runtime body cannot call one. A static function's own body may.
  if !staticBody {
    let callee = Shared.with<Result<Answer, NoRejection>, Option<SignatureFacts>>(&target.signature, signatureFacts,
    )
    if let Option<SignatureFacts>.Some {value: facts} = move callee {
      if facts.isStatic { return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span) }
    }
  }
  let foreignCall = target.foreign
  let variadic = Shared.with<Result<Answer, NoRejection>, bool>(&target.signature, signatureIsVariadic)
  if variadic && !foreignCall { return run bodyRejection(&resolver.*, module, RejectionCode.ForeignVariadic, span) }
  if foreignCall {
    let gap = Shared.with<Result<Answer, NoRejection>, Option<RejectionCode>>(&target.signature, foreignSignatureGap,
    )
    if let Option<RejectionCode>.Some {value} = move gap { return run bodyRejection(&resolver.*, module, value, span) }
  }
  let parameterCount = Shared.with<Result<Answer, NoRejection>, usize>(
    &target.signature,
    signatureParameterCount,
  )
  if pipeline && parameterCount != usize.ONE {
    return run bodyRejection(&resolver.*, module, RejectionCode.CallArity, span)
  }
  let actualCount = CallArguments.length(arguments)
  if variadic {
    if parameterCount == usize.ZERO { return run bodyRejection(&resolver.*, module, RejectionCode.ForeignVariadic, span) }
    if actualCount < parameterCount { return run bodyRejection(&resolver.*, module, RejectionCode.CallArity, span) }
  } else {
    let shape = callArityRejection(parameterCount, actualCount)
    if let Option<RejectionCode>.Some {value: reason} = move shape {
      if !valueConstruction { return run bodyRejection(&resolver.*, module, reason, span) }
    }
  }
  if foreignCall && CallArguments.length(arguments) < parameterCount {
    return run bodyRejection(&resolver.*, module, RejectionCode.ForeignFunctionNotFirstClass, span)
  }
  let effectTarget = Shared.with<Result<Answer, NoRejection>, bool>(&target.signature, signatureIsEffect)
  let unsafeCall = foreignCall || Shared.with<Result<Answer, NoRejection>, bool>(
    &target.signature,
    signatureUnsafe,
  )
  let fullInvocation = actualCount == parameterCount || (variadic && actualCount >= parameterCount)
  if !valueConstruction && fullInvocation && unsafeCall && !unsafeAllowed && !callAcknowledged {
    return run bodyRejection(&resolver.*, module, RejectionCode.UnsafeAcknowledgement, span)
  }
  if fullInvocation && callAcknowledged && !unsafeCall {
    return run bodyRejection(&resolver.*, module, RejectionCode.UnsafeInvocation, span)
  }
  let mut inferenceScope = Bytes.make()
  run Bytes.append(&mut inferenceScope, b"\0call-inference")
  run RuntimeEncoding.declaration(&mut inferenceScope, caller)
  run RuntimeEncoding.word(&mut inferenceScope, usize.toU64(span.start))
  run RuntimeEncoding.word(&mut inferenceScope, usize.toU64(span.end))
  run RuntimeEncoding.word(&mut inferenceScope, usize.toU64(resolver.nextInferenceId))
  resolver.nextInferenceId = resolver.nextInferenceId + usize.ONE
  let freshOwner = run DeclarationId.inference(&target.declaration, Bytes.asSlice(&inferenceScope))
  let inferenceSchema = run resolveTargetSchema(
    &mut resolver.*,
    &mut owner.*,
    &mut request.*,
    &mut dependencies.*,
    true,
    &target.declaration,
    span,
  )
  let schema = match move inferenceSchema {
    Option<TargetSchema>.Some {value} => move value
    Option<TargetSchema>.None => { return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span) }
  }
  let originalInference = match move run callInferenceSignature(
    &resolver.*,
    &target.signature,
    &schema,
    &freshOwner,
    module,
    span,
  ) {
    Result<Shared<Result<Answer, NoRejection>>, Shared<Rejection>>.Success {value} => move value
    Result<Shared<Result<Answer, NoRejection>>, Shared<Rejection>>.Failure {error} => {
      return Result.failResult<BodyNodeId, Shared<Rejection>>(move error)
    }
  }
  let originalBinderCount = Shared.with<Result<Answer, NoRejection>, usize>(
    &originalInference,
    signatureBinderCount,
  )
  let callOwner = run Shared.make<DeclarationId>(run DeclarationId.copy(&freshOwner))
  let mut variables = Vector.make<Shared<DeclarationId>>()
  run Vector.append<Shared<DeclarationId>>(
    &mut variables,
    Shared.clone<DeclarationId>(&callOwner))
  let mut inferred = Vector.make<Binding>()
  let explicit = Vector.asSlice<Argument>(&target.explicit)
  let writtenSlots = Vector.asSlice<CallPrefixSlot>(&target.explicitSlots)
  if writtenSlots.length != explicit.length { fail RevisionMismatch {} }
  let mut mappedExplicitOrdinals = Vector.make<usize>()
  let mut templateBindings = Vector.make<Binding>()
  if let Option<Shared<DeclarationId>>.Some {value: templateOwner} = &target.prefixOwner {
    let mut at = usize.ZERO
    while at < target.prefixLifetimes {
      run Vector.append<Binding>(&mut templateBindings, Binding {
        declaration: Shared.clone<DeclarationId>(&templateOwner), ordinal: at,
        value: Argument.Lifetime {value: run Shared.make<Lifetime>(Lifetime.Parameter {
          declaration: run DeclarationId.copy(&freshOwner), ordinal: originalBinderCount + at})}})
      at = at + usize.ONE
    }
  } else if target.prefixLifetimes != usize.ZERO { fail RevisionMismatch {} }
  let mut binderAt = usize.ZERO
  while binderAt < explicit.length {
    let ordinal = run callPrefixInferenceOrdinal(&writtenSlots[binderAt], &schema, &target.signature, &originalInference)
    if ordinal == usize.MAX || ordinal >= originalBinderCount {
      return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
    }
    run Vector.append<usize>(&mut mappedExplicitOrdinals, ordinal)
    let value = run Argument.applyBindings(&explicit[binderAt], Vector.asSlice<Binding>(&templateBindings), true)
    run Vector.append<Binding>(
      &mut inferred,
      Binding {
        declaration: Shared.clone<DeclarationId>(&callOwner),
        ordinal: ordinal,
        value: move value,
      },
    )
    binderAt = binderAt + usize.ONE
  }
  let explicitOrdinals = Vector.asSlice<usize>(&mappedExplicitOrdinals)
  let mut inference = Shared.clone<Result<Answer, NoRejection>>(&originalInference)
  if target.prefixLifetimes != usize.ZERO {
    let expanded = run callPrefixInferenceSignature(&originalInference, &freshOwner, target.prefixLifetimes, Vector.asSlice<Binding>(&inferred))
    inference = move expanded
  }
  let binderCount = originalBinderCount + target.prefixLifetimes
  let mut typedArguments = Vector.make<BodyNodeId>()
  let mut variadicArguments = Vector.make<CAbi.VariadicArgument>()
  let mut parameterOffset = usize.ZERO
  if !variadic { parameterOffset = parameterCount - actualCount }
  // A callee's static parameters take the values this body's selection pass evaluated for this
  // call; they are never runtime operands. An unselected body cannot supply them.
  let staticCount = Shared.with<Result<Answer, NoRejection>, usize>(&target.signature, signatureStaticCount,
  )
  let mut suppliedStatics = Option.none<Shared<Vector<StaticSlot>>>()
  if staticCount > usize.ZERO {
    suppliedStatics = staticArgumentsFact(calls, expression)
    if let Option<Shared<Vector<StaticSlot>>>.None = &suppliedStatics {
      return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
    }
  }
  let relationMark = retainedRelationCount(&resolver.*)
  let mut at = usize.ZERO
  while at < actualCount {
    if variadic && at >= parameterCount {
      let argumentId = run bodyArgument(&resolver.source, cursor, arguments, at)
      let argumentSpan = run bodySpan(&resolver.source, cursor, argumentId)
      let checked = run checkExpression(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
        module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*,
        argumentId, &Option.none<Shared<Type>>(), constraints, contractBody, staticBody, unsafeAllowed)
      let node = match move checked {
        Result<BodyNodeId, Shared<Rejection>>.Success {value: checkedNode} => checkedNode
        Result<BodyNodeId, Shared<Rejection>>.Failure {error: rejectedTail} => {
          return Result.failResult<BodyNodeId, Shared<Rejection>>(move rejectedTail)
        }
      }
      let tailType = bodyExpressionType(Vector.asSlice<BodyNode>(&nodes.*), &node)
      let actual = match move tailType {
        Option<Shared<Type>>.Some {value: checkedType} => move checkedType
        Option<Shared<Type>>.None => { return run bodyRejection(&resolver.*, module, RejectionCode.ForeignType, argumentSpan) }
      }
      let promoted = run CAbi.promoteVariadic(&actual)
      match move promoted {
        Option<CAbi.VariadicArgument>.Some {value: tail} => run Vector.append<CAbi.VariadicArgument>(&mut variadicArguments, move tail)
        Option<CAbi.VariadicArgument>.None => { return run bodyRejection(&resolver.*, module, RejectionCode.ForeignType, argumentSpan) }
      }
      run Vector.append<BodyNodeId>(&mut typedArguments, node)
      at = at + usize.ONE
      continue
    }
    let parameter = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
      &inference,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> {
        return signatureParameter(answer, at + parameterOffset)
      },
    )
    let staticValue = match &suppliedStatics {
      Option<Shared<Vector<StaticSlot>>>.Some {value: slots} => Shared.with<Vector<StaticSlot>, Option<Shared<StaticData>>,
      >(&slots,
        fn(listed: &Vector<StaticSlot>) -> Option<Shared<StaticData>> { return staticSlotValue(listed, at + parameterOffset) },
      )
      Option<Shared<Vector<StaticSlot>>>.None => Option.none<Shared<StaticData>>()
    }
    if let Option<Shared<StaticData>>.Some {value: supplied} = move staticValue {
      // The static value must already have the declared parameter type; a parameter written in
      // the callee's binders would need inference from a static value, which is unsupported.
      let argumentId = run bodyArgument(&resolver.source, cursor, arguments, at)
      let argumentSpan = run bodySpan(&resolver.source, cursor, argumentId)
      let declared = match move parameter {
        Option<Shared<Type>>.Some {value} => value
        Option<Shared<Type>>.None => { return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span) }
      }
      if Type.hasOpenParameters(&declared) {
        return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, argumentSpan)
      }
      if !run StaticValue.matchesType(&supplied, &declared) {
        return run bodyRejection(&resolver.*, module, RejectionCode.TypeMismatch, argumentSpan)
      }
      at = at + usize.ONE
      continue
    }
    if let Option<Shared<Type>>.Some {value: parameterType} = move parameter {
      let ordinal = Shared.with<Type, usize>(
        &parameterType,
        fn(value: &Type) -> usize {
          return Type.parameterOrdinalOf(value, &freshOwner)
        },
      )
      if ordinal != usize.MAX && ordinal >= binderCount {
        return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
      }
      let argumentId = run bodyArgument(&resolver.source, cursor, arguments, at)
      let noCaptures = Vector.make<Shared<Type>>()
      let argument = run checkInferredCallArgument(&mut resolver.*, &mut owner.*, &mut request.*,
        &mut dependencies.*, module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*,
        &mut requiredBodies.*, argumentId, &parameterType, &inference, Vector.asSlice<Shared<Type>>(&noCaptures), &freshOwner,
        Vector.asSlice<Shared<DeclarationId>>(&variables), explicitOrdinals, target.explicitSyntax,
        &mut inferred, expression, span,
        constraints, contractBody, staticBody, unsafeAllowed,
      )
      match move argument {
        Result<BodyNodeId, Shared<Rejection>>.Success {value: node} => {
          let checked = Vector.asSlice<BodyNode>(&nodes.*)
          let evidence = match & checked[node.index].kind {
            BodyNodeKind.Expression {ty: argumentType, ..} => Shared.clone<Type>(&argumentType)
            _ => {
              return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
            }
          }
          if !contractBody && !staticBody && !Shared.with<Type, bool>(&evidence, runtimeType) {
            return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
          }
          run Vector.append<BodyNodeId>(&mut typedArguments, node)
        }
        Result<BodyNodeId, Shared<Rejection>>.Failure {error} => {
          return Result.failResult<BodyNodeId, Shared<Rejection>>(move error)
        }
      }
    } else {
      return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
    }
    at = at + usize.ONE
  }
  if valueConstruction && Vector.length<Binding>(&inferred) < binderCount {
    run inferFromPromisedContract(&inference, &freshOwner, promised, &mut inferred)
  }
  if Vector.length<Binding>(&inferred) < binderCount {
    let inferredFromProvider = run inferFromProviderBounds(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies.*,
      module,
      &inference,
      &callOwner,
      constraints,
      &mut inferred,
      span,
    )
    if let Option<Shared<Rejection>>.Some {value} = move inferredFromProvider {
      return Result.failResult<BodyNodeId, Shared<Rejection>>(move value)
    }
  }
  if Vector.length<Binding>(&inferred) < binderCount {
    let selectedKeys = run inferProvidedSelectors(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies.*,
      module,
      &inference,
      &callOwner,
      &freshOwner,
      constraints,
      &mut inferred,
      span,
    )
    if let Option<Shared<Rejection>>.Some {value} = move selectedKeys {
      return Result.failResult<BodyNodeId, Shared<Rejection>>(move value)
    }
  }
  // An `effect<'env> fn` environment that no parameter mentions is inferred from what the call
  // captures (lifetimes reference): the region a borrowed argument retains, else 'static. A
  // section, including a whole generic `effect fn` used as a value, has not captured its remaining
  // operands yet: a binder they mention stays open for the invocation, and any other environment
  // binder is fixed by the supplied suffix the same way.
  let mut environmentAt = usize.ZERO
  let mut pendingTypes = Vector.make<usize>()
  let mut pendingLifetimes = Vector.make<usize>()
  let mut pendingRows = Vector.make<usize>()
  if parameterOffset != usize.ZERO && !run sectionEvidence(&inference, &freshOwner, Vector.asSlice<Binding>(&inferred),
    parameterOffset, &mut pendingTypes, &mut pendingLifetimes, &mut pendingRows) {
    environmentAt = originalBinderCount
  }
  while environmentAt < originalBinderCount {
    let open = match move bindingArgumentAt(Vector.asSlice<Binding>(&inferred), environmentAt) {
      Option<Argument>.Some {..} => false
      Option<Argument>.None => !containsOrdinal(&pendingLifetimes, environmentAt) && Shared.with<Result<Answer, NoRejection>, bool>(&inference,
        fn(answer: &Result<Answer, NoRejection>) -> bool { return signatureEnvironmentBinder(answer, environmentAt) })
    }
    if open {
      let region = match move capturedRegion(Vector.asSlice<BodyNode>(&nodes.*), Vector.asSlice<BodyNodeId>(&typedArguments)) {
        Option<Shared<Lifetime>>.Some {value} => value
        Option<Shared<Lifetime>>.None => run Shared.make<Lifetime>(Lifetime.Static)
      }
      run Vector.append<Binding>(&mut inferred, Binding {
        declaration: Shared.clone<DeclarationId>(&callOwner), ordinal: environmentAt,
        value: Argument.Lifetime {value: move region},
      })
    }
    environmentAt = environmentAt + usize.ONE
  }
  if parameterOffset == usize.ZERO && !valueConstruction {
    run bindUseLifetimes(&inference, &freshOwner, &callOwner, originalBinderCount, expected, effectTarget, &mut inferred)
  }
  if target.prefixLifetimes != usize.ZERO {
    run bindCallPrefixResult(&inference, &freshOwner, originalBinderCount, binderCount, expected, effectTarget, &mut inferred)
    run bindOutcomeCallPrefixRegions(&inference, &freshOwner, originalBinderCount, binderCount, &mut inferred)
    if parameterOffset != usize.ZERO {
      run localizeSectionCallPrefixRegions(&inference, &freshOwner, caller, expression, originalBinderCount,
        parameterOffset, &mut inferred)
    }
    inferred = match move run closeCallPrefixBindings(Vector.asSlice<Binding>(&inferred), &freshOwner,
      &target.prefixOwner, originalBinderCount, binderCount) {
      Option<Vector<Binding>>.Some {value} => move value
      Option<Vector<Binding>>.None => {
        return run bodyRejection(&resolver.*, module, RejectionCode.BodyLifetimeElisionUnavailable, span)
      }
    }
  }
  if target.prefixLifetimes != usize.ZERO {
    let scoped = Vector.asSlice<Argument>(&target.scopeArguments)
    let mut scopeAt = usize.ZERO
    while scopeAt < scoped.length {
      if run argumentMentionsOwner(&scoped[scopeAt], &freshOwner) {
        return run bodyRejection(&resolver.*, module, RejectionCode.UninferredParameter, span)
      }
      if let Option<Shared<DeclarationId>>.Some {value: template} = &target.prefixOwner {
        let pending = run DeclarationId.copyShared(&template)
        if run argumentMentionsOwner(&scoped[scopeAt], &pending) {
          return run bodyRejection(&resolver.*, module, RejectionCode.BodyLifetimeElisionUnavailable, span)
        }
      }
      scopeAt = scopeAt + usize.ONE
    }
  }
  run boundShortenedBinders(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, &inference, &freshOwner,
    &mut inferred, explicitOrdinals, constraints, caller, expression, span)
  let mut unresolvedAt = usize.ZERO
  while unresolvedAt < originalBinderCount {
    let evidence = bindingArgumentAt(Vector.asSlice<Binding>(&inferred), unresolvedAt)
    if let Option<Argument>.None = move evidence {
      if parameterOffset != usize.ZERO {
        return run finishDeferredNamedSection(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
          module, caller, &mut nodes.*, expression, span, &target.declaration, &target.signature,
          &originalInference, &freshOwner, Vector.asSlice<Binding>(&inferred), parameterOffset,
          move typedArguments, constraints, expected, contractBody, sectionContext(expected, valueConstruction))
      }
      return run bodyRejection(&resolver.*, module, RejectionCode.UninferredParameter, span)
    }
    unresolvedAt = unresolvedAt + usize.ONE
  }
  // Only rigid caller evidence crosses into canonical signature resolution and publication.
  let canonicalOwner = run Shared.make<DeclarationId>(run DeclarationId.copy(&target.declaration))
  let completed = Vector.asSlice<Binding>(&inferred)
  let mut completedAt = usize.ZERO
  while completedAt < completed.length {
    if run argumentMentionsOwner(&completed[completedAt].value, &freshOwner) {
      return run bodyRejection(&resolver.*, module, RejectionCode.UninferredParameter, span)
    }
    completedAt = completedAt + usize.ONE
  }
  // Written arguments are already bindings; skipped lifetimes were inferred beside them.
  let mut specialized = Vector.make<Argument>()
  let mut specializeAt = usize.ZERO
  while specializeAt < originalBinderCount {
    let evidence = bindingArgumentAt(Vector.asSlice<Binding>(&inferred), specializeAt)
    match move evidence {
      Option<Argument>.Some {value} => run Vector.append<Argument>(&mut specialized, move value)
      Option<Argument>.None => {
        return run bodyRejection(&resolver.*, module, RejectionCode.UninferredParameter, span)
      }
    }
    specializeAt = specializeAt + usize.ONE
  }
  let published = Vector.asSlice<Argument>(&specialized)
  let mut publishedAt = usize.ZERO
  while publishedAt < published.length {
    if run argumentMentionsOwner(&published[publishedAt], &freshOwner) {
      return run bodyRejection(&resolver.*, module, RejectionCode.UninferredParameter, span)
    }
    publishedAt = publishedAt + usize.ONE
  }
  let mut result = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
    &inference,
    signatureResult,
  )
  let mut failureType = run signatureFailure(&inference)
  let mut requirementRow = run signatureRequirements(&inference)
  let mut directApplication = Option.none<Application>()
  let mut appliedBounds = Vector.make<Constraint>()
  if originalBinderCount == usize.ZERO {
    let boundCount = Shared.with<Result<Answer, NoRejection>, usize>(
      &target.signature,
      signatureConstraintCount,
    )
    let mut boundAt = usize.ZERO
    while boundAt < boundCount {
      let bound = Shared.with<Result<Answer, NoRejection>, Option<Constraint>>(
        &target.signature,
        fn(answer: &Result<Answer, NoRejection>) -> Option<Constraint> {
          return signatureConstraint(answer, boundAt)
        },
      )
      if let Option<Constraint>.Some {value} = move bound {
        run Vector.append<Constraint>(&mut appliedBounds, move value)
      }
      boundAt = boundAt + usize.ONE
    }
  }
  if originalBinderCount > usize.ZERO {
    let selected = run checkedDirectApplication(
      &mut resolver.*,
      &mut owner.*,
      &mut request.*,
      &mut dependencies.*,
      &target.declaration,
      &target.signature,
      run copyArguments(Vector.asSlice<Argument>(&specialized)),
      &target.scopeArguments,
      module,
      span,
    )
    directApplication = match move selected {
      Result<Application, Shared<Rejection>>.Success {value} => Option.some<Application>(move value)
      Result<Application, Shared<Rejection>>.Failure {error} => {
        return Result.failResult<BodyNodeId, Shared<Rejection>>(move error)
      }
    }
    let targetModuleOrdinal = knownModuleOrdinal(
      &resolver.*,
      DeclarationId.moduleId(&target.declaration),
    )
    if targetModuleOrdinal == usize.MAX {
      fail InvalidModulePath {}
    }
    let targetModule = run resolvedModule(&resolver.*, targetModuleOrdinal)
    let declaration = run ordinalOfIdentity(&mut resolver.*, &targetModule, &canonicalOwner)
    let targetOrdinal = match move declaration {
      Option<usize>.Some {value} => value
      Option<usize>.None => {
        return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
      }
    }
    let mut applied = run resolveSignatureUnder(
      &mut resolver.*,
      &mut owner.*,
      Key {
        family: Family.Signature,
        module: targetModuleOrdinal,
        name: usize.ZERO,
        declaration: targetOrdinal,
        member: usize.ZERO,
        external: false,
      },
      Vector.make<Dependency>(),
      Option.none<Vector<Argument>>(),
      Option.none<Vector<Argument>>(),
      &directApplication,
    )
    while Vector.length<Dependency>(&applied.dependencies) > usize.ZERO {
      let edge = Vector.remove<Dependency>(&mut applied.dependencies, usize.ZERO)
      run Vector.append<Dependency>(&mut dependencies.*, move edge)
    }
    match & applied.outcome {
      Outcome.Success {value: Value.Signature {signature}} => {
        if target.prefixLifetimes != usize.ZERO {
          if run signatureMentionsOwner(&signature, &freshOwner) {
            return run bodyRejection(&resolver.*, module, RejectionCode.UninferredParameter, span)
          }
          if let Option<Shared<DeclarationId>>.Some {value: template} = &target.prefixOwner {
            let pending = run DeclarationId.copyShared(&template)
            if run signatureMentionsOwner(&signature, &pending) {
              return run bodyRejection(&resolver.*, module, RejectionCode.BodyLifetimeElisionUnavailable, span)
            }
          }
        }
        appliedBounds = run copyConstraints(Vector.asSlice<Constraint>(&signature.constraints))
        result = Option.some<Shared<Type>>(Shared.clone<Type>(&signature.result))
        failureType = Shared.clone<Type>(&signature.failure)
        requirementRow = Shared.clone<Row>(&signature.requirements)
      }
      Outcome.Rejected {diagnostic} => {
        return Result.failResult<BodyNodeId, Shared<Rejection>>(
          Shared.clone<Rejection>(&diagnostic),
        )
      }
      _ => {
        result = Option.none<Shared<Type>>()
      }
    }
  }
  let canonicalBounds = Vector.asSlice<Constraint>(&appliedBounds)
  let mut boundAt = usize.ZERO
  while boundAt < canonicalBounds.length {
    if run constraintMentionsOwner(&canonicalBounds[boundAt], &freshOwner) {
      return run bodyRejection(&resolver.*, module, RejectionCode.UninferredParameter, span)
    }
    boundAt = boundAt + usize.ONE
  }
  let mut declaredBounds = run copyConstraints(constraints)
  run retainedRelationPremises(&resolver.*, relationMark, &mut declaredBounds)
  let failed = run proveAppliedBounds(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies.*,
    &declaredBounds,
    Vector.asSlice<Constraint>(&appliedBounds),
    module,
    span,
  )
  if let Option<Shared<Rejection>>.Some {value} = move failed {
    return Result.failResult<BodyNodeId, Shared<Rejection>>(move value)
  }
  let callResult = match move result {
    Option<Shared<Type>>.Some {value} => value
    Option<Shared<Type>>.None => {
      return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
    }
  }
  let mut ownedTypes = Vector.make<usize>()
  let mut ownedLifetimes = Vector.make<usize>()
  let mut ownedRows = Vector.make<usize>()
  run Type.collectOwned(
    &callResult,
    &freshOwner,
    &mut ownedTypes,
    &mut ownedLifetimes,
    &mut ownedRows,
  )
  run Type.collectOwned(&failureType, &freshOwner, &mut ownedTypes, &mut ownedLifetimes, &mut ownedRows)
  run Type.collectOwnedRow(&requirementRow, &freshOwner, &mut ownedTypes, &mut ownedLifetimes, &mut ownedRows)
  if Vector.length<usize>(&ownedTypes) > usize.ZERO || Vector.length<usize>(&ownedLifetimes) > usize.ZERO || Vector.length<
    usize,
  >(&ownedRows) > usize.ZERO {
    return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
  }
  ty = move callResult
  if !staticBody && Shared.with<Type, bool>(&ty, effectStorageType) {
    return run bodyRejection(&resolver.*, module, RejectionCode.EffectFormUnavailable, span)
  }
  if !contractBody && !staticBody && !Shared.with<Type, bool>(&ty, runtimeType) {
    return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
  }
  run Vector.append<SignatureDependency>(
    &mut signatures.*,
    SignatureDependency {declaration: run DeclarationId.copy(&target.declaration)},
  )
  if foreignCall {
    form = BodyExpression.ForeignCall {declaration: run DeclarationId.copy(&target.declaration), arguments: move typedArguments,
      variadicArguments: run Shared.make<Vector<CAbi.VariadicArgument>>(move variadicArguments),
    }
  } else {
    run Vector.append<DeclarationId>(
      &mut requiredBodies.*,
      run DeclarationId.copy(&target.declaration),
    )
    let mustSelectApplication = match & directApplication {
      Option<Application>.Some {..} => false
      Option<Application>.None => true
    }
    if mustSelectApplication {
      let selected = run checkedDirectApplication(
        &mut resolver.*,
        &mut owner.*,
        &mut request.*,
        &mut dependencies.*,
        &target.declaration,
        &target.signature,
        move specialized,
        &target.scopeArguments,
        module,
        span,
      )
      directApplication = match move selected {
        Result<Application, Shared<Rejection>>.Success {value} => Option.some<Application>(
          move value,
        )
        Result<Application, Shared<Rejection>>.Failure {error} => {
          return Result.failResult<BodyNodeId, Shared<Rejection>>(move error)
        }
      }
    }
    let mut application = match move directApplication {
      Option<Application>.Some {value} => move value
      Option<Application>.None => {
        return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
      }
    }
    if let Option<Shared<Vector<StaticSlot>>>.Some {value: slots} = &suppliedStatics {
      application.statics = run copySharedStaticSlots(&slots)
    }
    if run Type.containsOpaque(&ty, &target.declaration) {
      ty = run Type.finishOpaqueApplication(&ty, &application)
    }
    if parameterOffset > usize.ZERO || valueConstruction {
      // Dense inference slots do not retain enclosing binder ownership. The closed application
      // retains the original function and owner slots needed by the visible section contract.
      let sectionBindings = run Application.bindings(&application)
      let mut sectionResult = Shared.clone<Type>(&ty)
      if effectTarget {
        sectionResult = match move run effectValueResult(&mut resolver.*, &mut owner.*, &mut dependencies.*,
          &target.signature, Vector.asSlice<Binding>(&sectionBindings), move ty,
          run Type.applyBindings(&failureType, Vector.asSlice<Binding>(&inferred), true),
          run Row.applyBindings(&requirementRow, Vector.asSlice<Binding>(&inferred), true), constraints, span) {
          Result<Shared<Type>, Shared<Rejection>>.Success {value} => value
          Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result.failResult<BodyNodeId, Shared<Rejection>>(move error) }
        }
      }
      return run finishNamedSection(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, caller,
        &mut nodes.*, expression, span, &target.signature, Vector.asSlice<Binding>(&sectionBindings),
        NamedSectionTarget.Application {value: move application, isPublic: target.isPublic}, parameterOffset, move typedArguments, move sectionResult, constraints, expected, contractBody,
      )
    }
    if effectTarget {
      // Calling an `effect fn` constructs an Effect whose exact representation is this
      // application with its written arguments as stored fields (EFF-001, REP-001).
      let construction = run effectConstruction(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, caller,
        Vector.asSlice<BodyNode>(&nodes.*), &application, Vector.asSlice<BodyNodeId>(&typedArguments), move ty,
        move failureType, move requirementRow, constraints, expression.index, target.isPublic, span)
      ty = match move construction {
        Result<Shared<Type>, Shared<Rejection>>.Success {value} => value
        Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result.failResult<BodyNodeId, Shared<Rejection>>(move error) }
      }
    }
    if !effectTarget && Shared.with<Type, bool>(&ty, rawCallableType) {
      ty = match move run callableResultType(&mut resolver.*, &mut owner.*, &mut dependencies.*, &application, constraints, span) {
        Result<Shared<Type>, Shared<Rejection>>.Success {value} => move value
        Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result.failResult<BodyNodeId, Shared<Rejection>>(move error) }
      }
    }
    form = BodyExpression.DirectCall {
      declaration: run DeclarationId.copy(&target.declaration),
      application: run Shared.make<Application>(move application),
      receiverPass: Option.none<BodyReceiverPass>(),
      arguments: move typedArguments,
    }
  }
  return run finishExpression(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, caller, constraints, &mut nodes.*,
    expression, span, move ty, move form,
    false, expected, contractBody, staticBody,
  )
}

// An `effect fn` value or section promises the Effect its invocation constructs (EFF-001), whose
// run access follows its parameters exactly as a written construction's (EFFECT-OWN-002). A
// section's captured regions join the environment when the section is finished (LIFE-004).
effect fn effectValueResult(resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, signature: &Shared<Result<Answer, NoRejection>>, bindings: &[Binding],
  success: Shared<Type>, failure: Shared<Type>, requirements: Shared<Row>, constraints: &[Constraint], span: Span)
  -> Result<Shared<Type>, Shared<Rejection>> ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let written = run signatureParameterTypes(signature)
  let declared = Vector.asSlice<Shared<Type>>(&written)
  let mut applied = Vector.make<Shared<Type>>()
  let mut at = usize.ZERO
  while at < declared.length {
    run Vector.append<Shared<Type>>(&mut applied, run Type.applyBindings(&declared[at], bindings, true))
    at = at + usize.ONE
  }
  let runMode = match move run storedRunMode(&mut resolver.*, &mut owner.*, &mut dependencies.*,
    Vector.asSlice<Shared<Type>>(&applied), constraints, span) {
    Result<CallableMode, Shared<Rejection>>.Success {value} => value
    Result<CallableMode, Shared<Rejection>>.Failure {error} => { return Result.failResult<Shared<Type>, Shared<Rejection>>(move error) }
  }
  return Result.succeed<Shared<Type>, Shared<Rejection>>(run Shared.make<Type>(Type.Effect {mode: runMode,
    environment: run Shared.make<Intersection>(Intersection {members: Vector.make<LifetimeMember>()}),
    success: move success, failure: move failure, requirements: move requirements}))
}

// The Effect a section constructs stores its captured arguments, so it retains their regions.
effect fn capturedEffectResult(result: Shared<Type>, regions: &[Shared<Lifetime>]) -> Shared<Type>
! OutOfMemoryError ? &mut Allocator {
  if regions.length == usize.ZERO { return move result }
  return match move run Type.copy(&result) {
    Type.Effect {mode, success, failure, requirements, ..} => run Shared.make<Type>(Type.Effect {mode: mode,
      environment: run Shared.make<Intersection>(run Intersection.of(regions)), success: move success,
      failure: move failure, requirements: move requirements})
    _ => move result
  }
}

// The Effect contract one `effect fn` call constructs, with the stored arguments that decide it.
struct EffectConstruction {
  contract: Shared<Type>
  captures: Vector<Shared<Type>>
  fieldInputs: Vector<CallableFieldInput>
}

// The exact Effect constructed by calling an `effect fn`: its stored arguments decide the run
// access and retained environment exactly as a section's supplied arguments do.
effect fn effectConstruction(resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, module: &ModuleId, caller: &DeclarationId, nodes: &[BodyNode],
  application: &Application, arguments: &[BodyNodeId], success: Shared<Type>, failure: Shared<Type>,
  requirements: Shared<Row>, constraints: &[Constraint], site: usize, isPublic: bool, span: Span) -> Result<Shared<Type>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let constructed = run constructEffect(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, caller, nodes,
    arguments, move success, move failure, move requirements, constraints, site, span)
  let built = match move constructed {
    Result<EffectConstruction, Shared<Rejection>>.Success {value} => value
    Result<EffectConstruction, Shared<Rejection>>.Failure {error} => { return Result.failResult<Shared<Type>, Shared<Rejection>>(move error) }
  }
  let EffectConstruction {contract, captures, fieldInputs} = move built
  let target = run Shared.make<Application>(run Application.copy(application))
  return Result.succeed<Shared<Type>, Shared<Rejection>>(run Type.callableValue(isPublic, move target, move contract, move captures, move fieldInputs))
}

// The Effect contract a call stores its written arguments into, before any representation
// names the target that will run it.
effect fn constructEffect(resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, module: &ModuleId, caller: &DeclarationId, nodes: &[BodyNode],
  arguments: &[BodyNodeId], success: Shared<Type>, failure: Shared<Type>, requirements: Shared<Row>,
  constraints: &[Constraint], site: usize, span: Span) -> Result<EffectConstruction, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let mut stored = Vector.make<StoredArgument>()
  let mut at = usize.ZERO
  while at < arguments.length {
    let ty = match move bodyExpressionType(nodes, &arguments[at]) {
      Option<Shared<Type>>.Some {value} => move value
      _ => { return Result.failResult<EffectConstruction, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.Unsupported, span)) }
    }
    run Vector.append<StoredArgument>(&mut stored, StoredArgument {ty: move ty, moved: movedBodyValue(nodes, arguments[at])})
    at = at + usize.ONE
  }
  return run storedEffect(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, caller,
    Vector.asSlice<StoredArgument>(&stored), move success, move failure, move requirements, constraints, site, span)
}

// One target argument an Effect construction stores, and whether its place was moved into it.
struct StoredArgument {
  ty: Shared<Type>
  moved: bool
}

// The exact Effect contract over the target arguments a construction stores in parameter order:
// a stored exclusive loan makes its run exclusive and a stored affine value makes it once
// (EFFECT-OWN-002), and it retains every stored region (LIFE-004).
effect fn storedEffect(resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, module: &ModuleId, caller: &DeclarationId, arguments: &[StoredArgument],
  success: Shared<Type>, failure: Shared<Type>, requirements: Shared<Row>, constraints: &[Constraint], site: usize,
  span: Span) -> Result<EffectConstruction, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let mut mode = CallableMode.Shared
  let mut captures = Vector.make<Shared<Type>>()
  let mut fieldInputs = Vector.make<CallableFieldInput>()
  let mut regions = Vector.make<Shared<Lifetime>>()
  let mut at = usize.ZERO
  while at < arguments.length {
    let ty = Shared.clone<Type>(&arguments[at].ty)
    let mutableReference = Shared.with<Type, bool>(&ty, fn(value: &Type) -> bool {
      return match &value.* { Type.Reference {access, ..} => access == Access.Mutable
        Type.Slice {access, ..} => access == Access.Mutable _ => false }
    })
    if mutableReference && !arguments[at].moved {
      if mode == CallableMode.Shared { mode = CallableMode.Mutable }
    } else {
      let copied = run copyType(&mut resolver.*, &mut owner.*, &mut dependencies.*, &ty, constraints, span)
      match move copied {
        Result<bool, Shared<Rejection>>.Success {value} => { if !value { mode = CallableMode.Once } }
        Result<bool, Shared<Rejection>>.Failure {error} => { return Result.failResult<EffectConstruction, Shared<Rejection>>(move error) }
      }
    }
    if !run captureRetainedRegions(&ty, caller, site, constraints, &mut regions) {
      return Result.failResult<EffectConstruction, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.Unsupported, span))
    }
    run Vector.append<Shared<Type>>(&mut captures, move ty)
    run Vector.append<CallableFieldInput>(&mut fieldInputs, CallableFieldInput.Argument {parameter: at})
    at = at + usize.ONE
  }
  let contract = run Shared.make<Type>(Type.Effect {mode: mode,
    environment: run Shared.make<Intersection>(run Intersection.of(Vector.asSlice<Shared<Lifetime>>(&regions))),
    success: move success, failure: move failure, requirements: move requirements})
  return Result.succeed<EffectConstruction, Shared<Rejection>>(EffectConstruction {contract: move contract, captures: move captures,
    fieldInputs: move fieldInputs})
}

// A named section stores its supplied suffix in written capture order. Its target remains the
// ordinary function application; the unsupplied prefix is the visible invocation contract.
effect fn finishNamedSection(resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, module: &ModuleId, caller: &DeclarationId,
  nodes: &mut Vector<BodyNode>, expression: HirId, span: Span,
  signature: &Shared<Result<Answer, NoRejection>>, bindings: &[Binding], target: NamedSectionTarget,
  remaining: usize, arguments: Vector<BodyNodeId>, result: Shared<Type>, constraints: &[Constraint],
  expected: &Option<Shared<Type>>, contractBody: bool) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let mut mode = CallableMode.Shared
  let mut captures = Vector.make<Shared<Type>>()
  let mut fieldInputs = Vector.make<CallableFieldInput>()
  let mut fields = Vector.make<BodyAggregateField>()
  let mut regions = Vector.make<Shared<Lifetime>>()
  let supplied = Vector.asSlice<BodyNodeId>(&arguments)
  let mut at = usize.ZERO
  while at < supplied.length {
    let ty = match move bodyExpressionType(Vector.asSlice<BodyNode>(&nodes.*), &supplied[at]) {
      Option<Shared<Type>>.Some {value} => move value
      _ => { return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span) }
    }
    let mutableReference = Shared.with<Type, bool>(&ty, fn(value: &Type) -> bool {
      return match &value.* { Type.Reference {access, ..} => access == Access.Mutable
        Type.Slice {access, ..} => access == Access.Mutable _ => false }
    })
    if mutableReference && !movedBodyValue(Vector.asSlice<BodyNode>(&nodes.*), supplied[at]) {
      if mode == CallableMode.Shared { mode = CallableMode.Mutable }
    } else {
      let copied = run copyType(&mut resolver.*, &mut owner.*, &mut dependencies.*, &ty, constraints, span)
      match move copied {
        Result<bool, Shared<Rejection>>.Success {value} => { if !value { mode = CallableMode.Once } }
        Result<bool, Shared<Rejection>>.Failure {error} => { return Result.failResult<BodyNodeId, Shared<Rejection>>(move error) }
      }
    }
    if !run captureRetainedRegions(&ty, caller, expression.index, constraints, &mut regions) {
      return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
    }
    run Vector.append<Shared<Type>>(&mut captures, move ty)
    run Vector.append<CallableFieldInput>(&mut fieldInputs, CallableFieldInput.Argument {parameter: remaining + at})
    run Vector.append<BodyAggregateField>(&mut fields, BodyAggregateField {index: at, value: supplied[at]})
    at = at + usize.ONE
  }
  let mut parameters = Vector.make<Shared<Type>>()
  let mut parameterAt = usize.ZERO
  while parameterAt < remaining {
    let selected = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(signature,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> { return signatureParameter(answer, parameterAt) })
    if let Option<Shared<Type>>.Some {value} = move selected {
      run Vector.append<Shared<Type>>(&mut parameters, run Type.applyBindings(&value, bindings, true))
    } else { return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span) }
    parameterAt = parameterAt + usize.ONE
  }
  let contract = run Shared.make<Type>(Type.Callable {mode: mode,
    isUnsafe: Shared.with<Result<Answer, NoRejection>, bool>(signature, signatureUnsafe),
    environment: run Shared.make<Intersection>(run Intersection.of(Vector.asSlice<Shared<Lifetime>>(&regions))),
    invocationBinders: usize.ZERO, invocationUse: usize.MAX, invocationBounds: Vector.make<Outlives>(),
    parameters: move parameters, result: run capturedEffectResult(move result, Vector.asSlice<Shared<Lifetime>>(&regions))})
  let ty = match move target {
    NamedSectionTarget.Application {value, isPublic} => run Type.callableValue(isPublic, run Shared.make<Application>(move value), move contract, move captures, move fieldInputs)
    NamedSectionTarget.Schema {target: identity, selected, deferred} => run Type.callableSchema(
      run Shared.make<SectionSchema>(SectionSchema {target: move identity, contract: move contract,
        selected: move selected, deferred: move deferred}), move captures, move fieldInputs)
  }
  return run finishExpression(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, caller, constraints, &mut nodes.*,
    expression, span, move ty,
    BodyExpression.Aggregate {fields: move fields}, false, expected, contractBody, false)
}

effect fn finishExpression(
  resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>, dependencies: &mut Vector<Dependency>,
  module: &ModuleId, caller: &DeclarationId, constraints: &[Constraint], nodes: &mut Vector<BodyNode>, expression: HirId, span: Span,
  ty: Shared<Type>, form: BodyExpression, diverges: bool, expected: &Option<Shared<Type>>,
  contractBody: bool, staticBody: bool,
) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  if !diverges {
    if let Option<Shared<Type>>.Some {value} = &expected.* {
      if !run Type.equalsShared(&ty, &value) {
        let rawIndex = Vector.length<BodyNode>(&nodes.*)
        run Vector.append<BodyNode>(&mut nodes.*, BodyNode {
          origin: BodyOrigin {syntax: expression, span: span}, kind: BodyNodeKind.Expression {ty: move ty, form: move form},
        })
        return run checkExpectedValue(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, caller, constraints, &mut nodes.*,
          BodyNodeId {index: rawIndex}, expected, span)
      }
    }
  }
  let index = Vector.length<BodyNode>(&nodes.*)
  run Vector.append<BodyNode>(
    &mut nodes.*,
    BodyNode {
      origin: BodyOrigin {syntax: expression, span: span},
      kind: BodyNodeKind.Expression {ty: move ty, form: move form},
    },
  )
  return Result.succeed<BodyNodeId, Shared<Rejection>>(BodyNodeId {index: index})
}

fn bodyHasLoans(nodes: &[BodyNode]) -> bool {
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {ty, form} = &nodes[at].kind {
      if !Shared.with<Type, bool>(&ty, scalarType) {
        return true
      }
      if let BodyExpression.Dereference {..} = &form {
        return true
      }
    }
    at = at + usize.ONE
  }
  return false
}

fn bodyHasReceiverPass(nodes: &[BodyNode]) -> bool {
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {form, ..} = &nodes[at].kind {
      match & form {
        BodyExpression.DirectCall {receiverPass, ..} => {
          if let Option<BodyReceiverPass>.Some {..} = &receiverPass {
            return true
          }
        }
        BodyExpression.InterfaceCall {receiverPass, ..} => {
          if let Option<BodyReceiverPass>.Some {..} = &receiverPass {
            return true
          }
        }
        _ => ()
      }
    }
    at = at + usize.ONE
  }
  return false
}

effect fn retainReceiverPass(
  node: &BodyNode,
  receiverPass: &Option<BodyReceiverPass>,
  arguments: &Vector<BodyNodeId>,
  obligations: &mut Vector<BodySafetyObligation>,
) -> () ! OutOfMemoryError ? &mut Allocator {
  if let Option<BodyReceiverPass>.Some {value: mode} = &receiverPass.* {
    let supplied = Vector.asSlice<BodyNodeId>(arguments)
    if supplied.length > usize.ZERO {
      run Vector.append<BodySafetyObligation>(
        &mut obligations.*,
        BodySafetyObligation.ReceiverPass {
          origin: BodyOrigin {syntax: node.origin.syntax, span: node.origin.span},
          receiver: BodyNodeId {index: supplied[usize.ZERO].index},
          mode: mode,
        },
      )
    }
  }
  return ()
}

effect fn retainCallableInvocation(node: &BodyNode, nodes: &[BodyNode], callee: BodyNodeId,
  mode: CallableMode, obligations: &mut Vector<BodySafetyObligation>) -> ()
! OutOfMemoryError ? &mut Allocator {
  if let BodyNodeKind.Expression {ty: receiver, ..} = &nodes[callee.index].kind {
    run Vector.append<BodySafetyObligation>(&mut obligations.*, BodySafetyObligation.CallableInvocation {
      origin: node.origin, callee: callee, contract: Shared.clone<Type>(&receiver),
    })
    let pass = match mode {
      CallableMode.Shared => BodyReceiverPass.Shared
      CallableMode.Mutable => BodyReceiverPass.Mutable
      CallableMode.Once => BodyReceiverPass.Take
    }
    run Vector.append<BodySafetyObligation>(&mut obligations.*, BodySafetyObligation.ReceiverPass {
      origin: node.origin, receiver: callee, mode: pass,
    })
  }
  return ()
}

effect fn retainCaptureContents(caller: &DeclarationId, node: &BodyNode, ty: &Shared<Type>, constraints: &[Constraint],
  obligations: &mut Vector<BodySafetyObligation>) -> () ! OutOfMemoryError ? &mut Allocator {
  let copied = run Type.copy(ty)
  match move copied {
    Type.CallableValue {contract, captures, ..} => run retainCaptureFields(caller, node, &contract, Vector.asSlice<Shared<Type>>(&captures), constraints, &mut obligations.*)
    Type.CallableSchema {schema, captures, ..} => {
      let contract = Shared.with<SectionSchema, Shared<Type>>(&schema,
        fn(value: &SectionSchema) -> Shared<Type> { return Shared.clone<Type>(&value.contract) })
      run retainCaptureFields(caller, node, &contract, Vector.asSlice<Shared<Type>>(&captures), constraints, &mut obligations.*)
    }
    Type.CallableStage {contract, captures, ..} => run retainCaptureFields(caller, node, &contract, Vector.asSlice<Shared<Type>>(&captures), constraints, &mut obligations.*)
    _ => ()
  }
  return ()
}

effect fn retainCaptureFields(caller: &DeclarationId, node: &BodyNode, contract: &Shared<Type>, captures: &[Shared<Type>],
  constraints: &[Constraint], obligations: &mut Vector<BodySafetyObligation>) -> ()
! OutOfMemoryError ? &mut Allocator {
  let environment = Shared.with<Type, Option<Shared<Intersection>>>(contract,
    fn(value: &Type) -> Option<Shared<Intersection>> {
      return match &value.* { Type.Callable {environment, ..} => Option.some<Shared<Intersection>>(Shared.clone<Intersection>(&environment)) _ => Option.none<Shared<Intersection>>() }
    })
  if let Option<Shared<Intersection>>.Some {value} = move environment {
    let regions = run callableEnvironmentRegions(&value)
    let listed = Vector.asSlice<Shared<Lifetime>>(&regions)
    let mut at = usize.ZERO
    while at < listed.length {
      let local = Shared.with<Lifetime, bool>(&listed[at], fn(region: &Lifetime) -> bool {
        return match &region.* { Lifetime.Local {declaration, ordinal} => ordinal == node.origin.syntax.index && DeclarationId.equals(&declaration, caller) _ => false }
      })
      if local {
        let mut field = usize.ZERO
        while field < captures.length {
          let mut known = Vector.make<Shared<Lifetime>>()
          let mut unresolved = Vector.make<Shared<Type>>()
          let admitted = run captureContents(&captures[field], caller, constraints, &mut known, &mut unresolved)
          let subjects = Vector.asSlice<Shared<Type>>(&unresolved)
          let mut subject = usize.ZERO
          while subject < subjects.length {
            run Vector.append<BodySafetyObligation>(&mut obligations.*, BodySafetyObligation.Contents {
              origin: node.origin, subject: Shared.clone<Type>(&subjects[subject]), region: Shared.clone<Lifetime>(&listed[at])})
            subject = subject + usize.ONE
          }
          field = field + usize.ONE
        }
        return ()
      }
      at = at + usize.ONE
    }
  }
  return ()
}

effect fn retainNodeObligations(caller: &DeclarationId, node: &BodyNode, nodes: &[BodyNode], constraints: &[Constraint], obligations: &mut Vector<BodySafetyObligation>) -> ()
! OutOfMemoryError ? &mut Allocator {
  if let BodyNodeKind.Expression {ty, form} = &node.kind {
    run retainCaptureContents(caller, node, &ty, constraints, &mut obligations.*)
    match & form {
      BodyExpression.Borrow {..} => {
        run Vector.append<BodySafetyObligation>(
          &mut obligations.*,
          BodySafetyObligation.WholeValue {origin: node.origin, ty: Shared.clone<Type>(&ty)},
        )
      }
      BodyExpression.Aggregate {..} => {
        run Vector.append<BodySafetyObligation>(&mut obligations.*,
          BodySafetyObligation.WholeValue {origin: node.origin, ty: Shared.clone<Type>(&ty)})
      }
      BodyExpression.Callable {..} => {
        run Vector.append<BodySafetyObligation>(&mut obligations.*,
          BodySafetyObligation.WholeValue {origin: node.origin, ty: Shared.clone<Type>(&ty)})
      }
      BodyExpression.CallableCall {callee, mode, ..} => {
        run retainCallableInvocation(node, nodes, callee, mode, &mut obligations.*)
      }
      BodyExpression.StagedCallable {callee, mode, ..} => {
        run Vector.append<BodySafetyObligation>(&mut obligations.*,
          BodySafetyObligation.WholeValue {origin: node.origin, ty: Shared.clone<Type>(&ty)})
        let pass = match mode { CallableMode.Shared => BodyReceiverPass.Shared _ => BodyReceiverPass.Take }
        run Vector.append<BodySafetyObligation>(&mut obligations.*, BodySafetyObligation.ReceiverPass {
          origin: node.origin, receiver: callee,
          mode: pass,
        })
      }
      BodyExpression.ArraySlice {..} => {
        run Vector.append<BodySafetyObligation>(&mut obligations.*,
          BodySafetyObligation.WholeValue {origin: node.origin, ty: Shared.clone<Type>(&ty)})
      }
      // A union value and its member places retain ownership and cleanup work; the matched
      // subject's own node already retains its whole-value obligation.
      BodyExpression.UnionInject {..} => {
        run Vector.append<BodySafetyObligation>(&mut obligations.*,
          BodySafetyObligation.WholeValue {origin: node.origin, ty: Shared.clone<Type>(&ty)})
      }
      BodyExpression.VariantConstruct {..} => {
        run Vector.append<BodySafetyObligation>(&mut obligations.*,
          BodySafetyObligation.WholeValue {origin: node.origin, ty: Shared.clone<Type>(&ty)})
      }
      BodyExpression.PatternBinding {..} => {
        if !Shared.with<Type, bool>(&ty, scalarType) {
          run Vector.append<BodySafetyObligation>(&mut obligations.*,
            BodySafetyObligation.WholeValue {origin: node.origin, ty: Shared.clone<Type>(&ty)})
        }
      }
      BodyExpression.Local {..} => {
        if !Shared.with<Type, bool>(&ty, scalarType) {
          run Vector.append<BodySafetyObligation>(
            &mut obligations.*,
            BodySafetyObligation.WholeValue {
              origin: BodyOrigin {syntax: node.origin.syntax, span: node.origin.span},
              ty: Shared.clone<Type>(&ty),
            },
          )
        }
      }
      BodyExpression.DirectCall {declaration, receiverPass, arguments, ..} => {
        run Vector.append<BodySafetyObligation>(
          &mut obligations.*,
          BodySafetyObligation.Invocation {
            origin: BodyOrigin {syntax: node.origin.syntax, span: node.origin.span},
            declaration: run DeclarationId.copy(&declaration),
          },
        )
        run retainReceiverPass(node, &receiverPass, &arguments, &mut obligations.*)
      }
      BodyExpression.InterfaceCall {operation, receiverPass, arguments, ..} => {
        run Vector.append<BodySafetyObligation>(
          &mut obligations.*,
          BodySafetyObligation.Invocation {
            origin: BodyOrigin {syntax: node.origin.syntax, span: node.origin.span},
            declaration: run DeclarationId.copy(&operation),
          },
        )
        run retainReceiverPass(node, &receiverPass, &arguments, &mut obligations.*)
      }
      _ => ()
    }
  }
  return ()
}

// Contract typing retains the source places whose ownership, lifetime, and cleanup safety must
// be discharged later, followed by the region relations its typing admitted without proof. A
// successful contract-typed body is not a full safety result.
effect fn bodySafetyObligations(caller: &DeclarationId, locals: &[BodyLocal], nodes: &[BodyNode], constraints: &[Constraint],
  relations: Vector<BodySafetyObligation>) -> Vector<BodySafetyObligation> ! OutOfMemoryError ? &mut Allocator {
  let mut retained = move relations
  let mut obligations = Vector.make<BodySafetyObligation>()
  let mut localAt = usize.ZERO
  while localAt < locals.length {
    let local = &locals[localAt]
    if !Shared.with<Type, bool>(&local.ty, scalarType) {
      run Vector.append<BodySafetyObligation>(
        &mut obligations,
        BodySafetyObligation.WholeValue {
          origin: BodyOrigin {syntax: local.origin.syntax, span: local.origin.span},
          ty: Shared.clone<Type>(&local.ty),
        },
      )
    }
    localAt = localAt + usize.ONE
  }
  let mut at = usize.ZERO
  while at < nodes.length {
    let node = &nodes[at]
    run retainNodeObligations(caller, node, nodes, constraints, &mut obligations)
    at = at + usize.ONE
  }
  while Vector.length<BodySafetyObligation>(&retained) > usize.ZERO {
    let relation = Vector.remove<BodySafetyObligation>(&mut retained, usize.ZERO)
    run Vector.append<BodySafetyObligation>(&mut obligations, move relation)
  }
  return move obligations
}

fn rejectedBody(diagnostic: Shared<Rejection>, dependencies: Vector<Dependency>) -> Answer {
  return Answer {
    outcome: Outcome.Rejected {diagnostic: move diagnostic},
    dependencies: move dependencies,
    sources: Vector.make<Shared<Observation>>(),
    footprint: Vector.make<Shared<DemandFootprint>>(),
    answerId: usize.ZERO,
    identity: Option.none<Shared<Value>>(),
    bodyEvidence: Option.none<Shared<BodyEvidence>>(),
  }
}

fn sameBinderName(hir: &Module, left: HirId, right: HirId) -> bool {
  if let Node.Name {text: leftName} = Module.node(hir, left) {
    if let Node.Name {text: rightName} = Module.node(hir, right) {
      return same(Module.text(hir, leftName), Module.text(hir, rightName))
    }
  }
  return false
}

effect fn bodyNode(source: &SourceIndex, cursor: &AuthoredCursor, id: HirId) -> Node
! RevisionMismatch {
  if let Option<Node>.Some {value} = move SourceIndex.authoredNode(source, cursor, id) {
    return value
  }
  fail RevisionMismatch {}
}

// An operation argument's context. As at a direct call (inferredReferentLifetimes), the operation's
// own regions inside a borrowed referent are inferred from the operand: a referent context would
// carry the operation's stand-ins and compare them invariantly with the operand's regions.
effect fn operationArgumentContext(
  source: &SourceIndex,
  cursor: &AuthoredCursor,
  expression: HirId,
  parameter: &Shared<Type>,
  operation: &DeclarationId,
  caller: &DeclarationId,
) -> Option<Shared<Type>>
! RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  if !Shared.with<Type, bool>(parameter, runtimeType) || run inferredReferentLifetimes(parameter, operation) {
    return Option.none<Shared<Type>>()
  }
  return run referenceArgumentContext(source, cursor, expression, &Option.some<Shared<Type>>(Shared.clone<Type>(parameter)), caller)
}

// Reference arguments supply lifetime evidence to call inference. A written borrow needs
// the parameter's shape for reborrowing, but its region belongs to the caller.
effect fn referenceArgumentContext(
  source: &SourceIndex,
  cursor: &AuthoredCursor,
  expression: HirId,
  context: &Option<Shared<Type>>,
  caller: &DeclarationId,
) -> Option<Shared<Type>>
! RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  if let Option<Shared<Type>>.Some {value: expectedType} = &context.* {
    let isReference = Shared.with<Type, bool>(
      &expectedType,
      fn(value: &Type) -> bool {
        return match & value.* {
          Type.Reference {..} => true
          Type.Slice {..} => true
          _ => false
        }
      },
    )
    if !isReference {
      return Option.some<Shared<Type>>(Shared.clone<Type>(&expectedType))
    }
    // Slice calls validate the actual loan after conversion in the shared exact unifier. Only a
    // borrowed array literal keeps the slice context, for its element inference.
    if let Option<Shared<Type>>.Some {value: element} = move Type.sliceElement(&expectedType) {
      if let Node.BorrowExpression {operand, ..} = run bodyNode(source, cursor, expression) {
        if let Node.ArrayExpression {..} = run bodyNode(source, cursor, operand) {
          return run callerReferenceType(&expectedType, caller, expression)
        }
      }
      return Option.none<Shared<Type>>()
    }
    if let Node.BorrowExpression {..} = run bodyNode(source, cursor, expression) {
      return run callerReferenceType(&expectedType, caller, expression)
    }
  }
  return Option.none<Shared<Type>>()
}

effect fn callerReferenceType(
  expectedType: &Shared<Type>,
  caller: &DeclarationId,
  expression: HirId,
) -> Option<Shared<Type>> ! OutOfMemoryError ? &mut Allocator {
  let region = run Shared.make<Lifetime>(
    Lifetime.Local {declaration: run DeclarationId.copy(caller), ordinal: expression.index},
  )
  let shape = Shared.with<Type, Option<Type>>(
    expectedType,
    fn(value: &Type) -> Option<Type> {
      return match & value.* {
        Type.Reference {referent, access, ..} => Option.some<Type>(
          Type.Reference {
            referent: Shared.clone<Type>(&referent),
            access: access,
            lifetime: Shared.clone<Lifetime>(&region),
          },
        )
        Type.Slice {element, access, ..} => Option.some<Type>(Type.Slice {
          element: Shared.clone<Type>(&element), access: access, lifetime: Shared.clone<Lifetime>(&region),
        })
        _ => Option.none<Type>()
      }
    },
  )
  if let Option<Type>.Some {value: referenceType} = move shape {
    return Option.some<Shared<Type>>(run Shared.make<Type>(move referenceType))
  }
  return Option.none<Shared<Type>>()
}

fn borrowedArraySlice(actual: &Type) -> Option<Type> {
  if let Type.Reference {referent, access, lifetime} = &actual.* {
    return Shared.with<Type, Option<Type>>(&referent, fn(target: &Type) -> Option<Type> {
      if let Type.Array {element, ..} = &target.* {
        return Option.some<Type>(Type.Slice {
          element: Shared.clone<Type>(&element), access: access,
          lifetime: Shared.clone<Lifetime>(&lifetime),
        })
      }
      return Option.none<Type>()
    })
  }
  return Option.none<Type>()
}

effect fn sliceArgument(nodes: &mut Vector<BodyNode>, node: BodyNodeId, parameter: &Shared<Type>) -> BodyNodeId
! OutOfMemoryError ? &mut Allocator {
  if let Option<Shared<Type>>.None = move Type.sliceElement(parameter) { return node }
  let actual = match move bodyExpressionType(Vector.asSlice<BodyNode>(&nodes.*), &node) {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => { return node }
  }
  let shape = Shared.with<Type, Option<Type>>(&actual, borrowedArraySlice)
  if let Option<Type>.Some {value: candidate} = move shape {
    let source = Shared.with<Type, Option<Shared<Type>>>(&actual, fn(value: &Type) -> Option<Shared<Type>> {
      if let Type.Reference {referent, ..} = &value.* { return Option.some<Shared<Type>>(Shared.clone<Type>(&referent)) }
      return Option.none<Shared<Type>>()
    })
    if let Option<Shared<Type>>.Some {value: arrayType} = move source {
      if let Option<ArrayShape>.Some {value: array} = move Type.arrayShape(&arrayType) {
        let origin = Vector.asSlice<BodyNode>(&nodes.*)[node.index].origin
        let index = Vector.length<BodyNode>(&nodes.*)
        run Vector.append<BodyNode>(&mut nodes.*, BodyNode {origin: origin, kind: BodyNodeKind.Expression {
          ty: run Shared.make<Type>(move candidate), form: BodyExpression.ArraySlice {value: node, count: array.length},
        }})
        return BodyNodeId {index: index}
      }
    }
  }
  return node
}

// Fresh local loans in one inference transaction share one caller-owned region. Reborrows must
// retain their source descriptor's nonlocal lifetime, including a written parameter or Static.
effect fn setBorrowRegion(
  nodes: &mut Vector<BodyNode>, node: BodyNodeId, caller: &DeclarationId, ordinal: usize,
) -> () ! OutOfMemoryError ? &mut Allocator {
  let borrowed = bodyExpressionType(Vector.asSlice<BodyNode>(&nodes.*), &node)
  if let Option<Shared<Type>>.Some {value} = move borrowed {
    let shape = run Type.copy(&value)
    if let Type.Reference {lifetime, ..} = &shape {
      if !callerLocalRegion(&lifetime, caller) { return () }
    }
    let selected = match move shape {
      Type.Reference {referent, access, lifetime: previousLifetime} => Option.some<Type>(Type.Reference {
        referent: move referent,
        access: access,
        lifetime: run Shared.make<Lifetime>(
          Lifetime.Local {declaration: run DeclarationId.copy(caller), ordinal: ordinal},
        ),
      })
      _ => Option.none<Type>()
    }
    if let Option<Type>.Some {value: actualType} = move selected {
      let actual = run Shared.make<Type>(move actualType)
      let previous = Vector.remove<BodyNode>(&mut nodes.*, node.index)
      let form = match move previous.kind {
        BodyNodeKind.Expression {form, ty: previousType} => move form
        _ => { return () }
      }
      run Vector.insert<BodyNode>(&mut nodes.*, node.index, BodyNode {
        origin: previous.origin,
        kind: BodyNodeKind.Expression {ty: move actual, form: move form},
      })
    }
  }
  return ()
}

// Every immediate expected-value boundary retains the actual node before conversion. Fields and
// selected call results use this same path rather than rejecting qualifiers before the common tail.
// A value that differs from its expectation only in covariant regions meets it by lifetime
// subtyping (`admitsRegions`); the boundary node then carries the expected type, and each
// caller-local relation it could not prove stays open on the body as a safety obligation.
effect fn checkExpectedValue(
  resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>, dependencies: &mut Vector<Dependency>,
  module: &ModuleId, caller: &DeclarationId, constraints: &[Constraint], nodes: &mut Vector<BodyNode>, node: BodyNodeId,
  expected: &Option<Shared<Type>>, span: Span,
) -> Result<BodyNodeId, Shared<Rejection>> ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  return run admitExpectedValue(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, caller, constraints,
    &mut nodes.*, node, expected, span, true)
}

// `checkExpectedValue` with the caller choosing whether a caller-local region may meet a region
// the caller does not own as a retained relation. Without `relateUnowned` that relation is a
// mismatch, because no borrow checker enforces it yet.
effect fn admitExpectedValue(
  resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>, dependencies: &mut Vector<Dependency>,
  module: &ModuleId, caller: &DeclarationId, constraints: &[Constraint], nodes: &mut Vector<BodyNode>, node: BodyNodeId,
  expected: &Option<Shared<Type>>, span: Span, relateUnowned: bool,
) -> Result<BodyNodeId, Shared<Rejection>> ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  if let Option<Shared<Type>>.Some {value} = &expected.* {
    let actual = match move bodyExpressionType(Vector.asSlice<BodyNode>(&nodes.*), &node) {
      Option<Shared<Type>>.Some {value: selected} => move selected
      Option<Shared<Type>>.None => { return run bodyRejection(&resolver.*, module, RejectionCode.TypeMismatch, span) }
    }
    if Shared.with<Type, bool>(&actual, neverType) { return Result.succeed<BodyNodeId, Shared<Rejection>>(node) }
    if privateOriginPhase(&resolver.*).phase == usize.ONE && (pendingCallableSelection(&actual) || pendingCallableSelection(&value)) {
      return Result.succeed<BodyNodeId, Shared<Rejection>>(node)
    }
    let wanted = run originComparedType(&resolver.*, &value)
    let offered = run originComparedType(&resolver.*, &actual)
    let publicCallable = Shared.with<Type, bool>(&value, fn(ty: &Type) -> bool {
      return match &ty.* { Type.Callable {..} => true Type.OpaqueRepresentation {..} => true _ => false }
    })
    if publicCallable {
      let declared = Vector.make<Constraint>()
      if run unresolvedLocalCallableContents(&actual, Vector.asSlice<Constraint>(&declared)) {
        return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
      }
    }
    if run Type.equalsShared(&offered, &wanted) { return Result.succeed<BodyNodeId, Shared<Rejection>>(node) }
    let injected = run unionArgument(&mut nodes.*, node, &value)
    if injected.index != node.index { return Result.succeed<BodyNodeId, Shared<Rejection>>(injected) }
    let sliced = run sliceArgument(&mut nodes.*, node, &value)
    let variables = Vector.make<Shared<DeclarationId>>()
    let bindings = Vector.make<Binding>()
    let converted = run pointerArgument(&mut nodes.*, sliced, &value,
      Vector.asSlice<Shared<DeclarationId>>(&variables), Vector.asSlice<Binding>(&bindings))
    let adapted = match move bodyExpressionType(Vector.asSlice<BodyNode>(&nodes.*), &converted) {
      Option<Shared<Type>>.Some {value: selected} => move selected
      Option<Shared<Type>>.None => { return run bodyRejection(&resolver.*, module, RejectionCode.TypeMismatch, span) }
    }
    let compared = run originComparedType(&resolver.*, &adapted)
    if run Type.equalsShared(&compared, &wanted) { return Result.succeed<BodyNodeId, Shared<Rejection>>(converted) }
    // A declared Effect contract stores an exact Effect it admits as itself: a one-alternative
    // join behind that contract (EFF-009, EFF-013).
    let declared = Vector.make<Constraint>()
    if Shared.with<Type, bool>(&value, bareEffect) && Shared.with<Type, bool>(&actual, joinableEffect)
      && run admitsEffect(&actual, &value, Vector.asSlice<Constraint>(&declared)) {
      let joined = run Shared.make<Type>(Type.EffectJoin {contract: Shared.clone<Type>(&value), alternatives: run joinAlternatives(&actual)})
      run retypeNode(&mut nodes.*, node, move joined)
      return Result.succeed<BodyNodeId, Shared<Rejection>>(node)
    }
    let mut deferred = Vector.make<RegionPair>()
    let mut active = Vector.make<DeclarationId>()
    let regions = run admitsRegions(&mut resolver.*, &mut owner.*, &mut dependencies.*, &compared, &wanted, caller, constraints,
      true, &mut deferred, &mut active, span)
    if regions && (relateUnowned || ownedRelations(Vector.asSlice<RegionPair>(&deferred), caller)) {
      let origin = Vector.asSlice<BodyNode>(&nodes.*)[converted.index].origin
      if run retainRegionPairs(&mut resolver.*, origin, Vector.asSlice<RegionPair>(&deferred)) {
        run retypeNode(&mut nodes.*, converted, Shared.clone<Type>(&value))
        return Result.succeed<BodyNodeId, Shared<Rejection>>(converted)
      }
    }
    return run bodyRejection(&resolver.*, module, RejectionCode.TypeMismatch, span)
  }
  return Result.succeed<BodyNodeId, Shared<Rejection>>(node)
}

// Whether every deferred pair relates two regions of the caller's own body.
fn ownedRelations(pairs: &[RegionPair], caller: &DeclarationId) -> bool {
  let mut at = usize.ZERO
  while at < pairs.length {
    if !callerLocalRegion(&pairs[at].wanted, caller) { return false }
    at = at + usize.ONE
  }
  return true
}

// Whether a type retains a region through a reference, slice, `string`, array element or nominal
// argument. `'static` counts only when `countStatic` is set.
effect fn carriesRegion(value: &Shared<Type>, countStatic: bool) -> bool ! OutOfMemoryError ? &mut Allocator {
  match move run Type.copy(value) {
    Type.String {lifetime} => { return countStatic || !Shared.with<Lifetime, bool>(&lifetime, staticLifetime) }
    Type.Reference {referent, lifetime, ..} => {
      return countStatic || !Shared.with<Lifetime, bool>(&lifetime, staticLifetime) || run carriesRegion(&referent, countStatic)
    }
    Type.Slice {element, lifetime, ..} => {
      return countStatic || !Shared.with<Lifetime, bool>(&lifetime, staticLifetime) || run carriesRegion(&element, countStatic)
    }
    Type.Array {element, ..} => { return run carriesRegion(&element, countStatic) }
    Type.Nominal {arguments, ..} => {
      let listed = Vector.asSlice<Argument>(&arguments)
      let mut at = usize.ZERO
      while at < listed.length {
        if let Argument.Lifetime {value: region} = &listed[at] {
          if countStatic || !Shared.with<Lifetime, bool>(&region, staticLifetime) { return true }
        }
        if let Argument.Type {value: argument} = &listed[at] {
          if run carriesRegion(&argument, countStatic) { return true }
        }
        at = at + usize.ONE
      }
    }
    _ => {}
  }
  return false
}

// The common validity of two regions: either one when they are equal, otherwise their meet.
effect fn meetRegion(left: &Shared<Lifetime>, right: &Shared<Lifetime>) -> Shared<Lifetime>
! OutOfMemoryError ? &mut Allocator {
  if Lifetime.equalsShared(left, right) { return Shared.clone<Lifetime>(left) }
  let mut regions = Vector.make<Shared<Lifetime>>()
  run Vector.append<Shared<Lifetime>>(&mut regions, Shared.clone<Lifetime>(left))
  run Vector.append<Shared<Lifetime>>(&mut regions, Shared.clone<Lifetime>(right))
  return run Lifetime.meet(Vector.asSlice<Shared<Lifetime>>(&regions))
}

// `left` with each reference, slice, `string` and nominal lifetime argument region where it differs
// from `right` replaced by their meet; array elements, referents and type arguments meet the same
// way. None when the two differ in anything but regions. The result says nothing about variance:
// the caller proves that both types meet it by covariant subtyping (`admitsRegions`).
effect fn meetRegions(left: &Shared<Type>, right: &Shared<Type>) -> Option<Shared<Type>>
! OutOfMemoryError ? &mut Allocator {
  if run Type.equalsShared(left, right) { return Option.some<Shared<Type>>(Shared.clone<Type>(left)) }
  let other = run Type.copy(right)
  match move run Type.copy(left) {
    Type.String {lifetime} => {
      if let Type.String {lifetime: written} = move other {
        return Option.some<Shared<Type>>(run Shared.make<Type>(Type.String {lifetime: run meetRegion(&lifetime, &written)}))
      }
    }
    Type.Reference {referent, access, lifetime} => {
      if let Type.Reference {referent: written, access: writtenAccess, lifetime: writtenLifetime} = move other {
        if access != writtenAccess { return Option.none<Shared<Type>>() }
        let met = run meetRegions(&referent, &written)
        if let Option<Shared<Type>>.Some {value: inner} = move met {
          return Option.some<Shared<Type>>(run Shared.make<Type>(Type.Reference {referent: move inner, access: access,
            lifetime: run meetRegion(&lifetime, &writtenLifetime)}))
        }
      }
    }
    Type.Slice {element, access, lifetime} => {
      if let Type.Slice {element: written, access: writtenAccess, lifetime: writtenLifetime} = move other {
        if access != writtenAccess { return Option.none<Shared<Type>>() }
        let met = run meetRegions(&element, &written)
        if let Option<Shared<Type>>.Some {value: inner} = move met {
          return Option.some<Shared<Type>>(run Shared.make<Type>(Type.Slice {element: move inner, access: access,
            lifetime: run meetRegion(&lifetime, &writtenLifetime)}))
        }
      }
    }
    Type.Array {element, extent} => {
      if let Type.Array {element: written, extent: writtenExtent} = move other {
        if !same(Bytes.asSlice(&extent), Bytes.asSlice(&writtenExtent)) { return Option.none<Shared<Type>>() }
        let met = run meetRegions(&element, &written)
        if let Option<Shared<Type>>.Some {value: inner} = move met {
          return Option.some<Shared<Type>>(run Shared.make<Type>(Type.Array {element: move inner,
            extent: run Bytes.copy(Bytes.asSlice(&extent))}))
        }
      }
    }
    Type.Nominal {declaration, isPublic, arguments} => {
      if let Type.Nominal {declaration: writtenDeclaration, arguments: writtenArguments, ..} = move other {
        let listed = Vector.asSlice<Argument>(&arguments)
        let writtenListed = Vector.asSlice<Argument>(&writtenArguments)
        if !DeclarationId.equals(&declaration, &writtenDeclaration) || listed.length != writtenListed.length {
          return Option.none<Shared<Type>>()
        }
        let mut met = Vector.make<Argument>()
        let mut at = usize.ZERO
        while at < listed.length {
          let mut next = Option.none<Argument>()
          if let Argument.Lifetime {value: region} = &listed[at] {
            if let Argument.Lifetime {value: writtenRegion} = &writtenListed[at] {
              next = Option.some<Argument>(Argument.Lifetime {value: run meetRegion(&region, &writtenRegion)})
            }
          } else if let Argument.Type {value: argument} = &listed[at] {
            if let Argument.Type {value: writtenArgument} = &writtenListed[at] {
              let inner = run meetRegions(&argument, &writtenArgument)
              if let Option<Shared<Type>>.Some {value: metArgument} = move inner {
                next = Option.some<Argument>(Argument.Type {value: move metArgument})
              }
            }
          } else if run sameExactArgument(&listed[at], &writtenListed[at]) {
            next = Option.some<Argument>(Argument.copy(&listed[at]))
          }
          match move next {
            Option<Argument>.Some {value} => { run Vector.append<Argument>(&mut met, move value) }
            Option<Argument>.None => { return Option.none<Shared<Type>>() }
          }
          at = at + usize.ONE
        }
        return Option.some<Shared<Type>>(run Shared.make<Type>(Type.Nominal {declaration: run DeclarationId.copy(&declaration),
          isPublic: isPublic, arguments: move met}))
      }
    }
    _ => {}
  }
  return Option.none<Shared<Type>>()
}

// The initializer a binding annotation that elides a lifetime describes. The annotation admits
// the initializer's own type, a union member it injects into, or the slice of a borrowed array;
// whichever it admits supplies every lifetime the annotation elides (LIFE-003).
effect fn describedBinding(
  resolver: &Resolver, module: &ModuleId, nodes: &mut Vector<BodyNode>, node: BodyNodeId,
  written: &Shared<Type>, elided: &DeclarationId, span: Span,
) -> Result<BodyNodeId, Shared<Rejection>> ! OutOfMemoryError ? &mut Allocator {
  let actual = match move bodyExpressionType(Vector.asSlice<BodyNode>(&nodes.*), &node) {
    Option<Shared<Type>>.Some {value} => value
    Option<Shared<Type>>.None => { return run bodyRejection(resolver, module, RejectionCode.TypeMismatch, span) }
  }
  if Shared.with<Type, bool>(&actual, neverType) { return Result.succeed<BodyNodeId, Shared<Rejection>>(node) }
  let exact = run inferredAnnotation(written, &actual, elided)
  if let Option<Shared<Type>>.Some {..} = &exact { return Result.succeed<BodyNodeId, Shared<Rejection>>(node) }
  if Shared.with<Type, bool>(written, sourceUnion) {
    let ordered = run UnionProjection.members(written)
    let members = match move ordered {
      Option<Vector<Shared<Type>>>.Some {value} => value
      Option<Vector<Shared<Type>>>.None => { return run bodyRejection(resolver, module, RejectionCode.TypeMismatch, span) }
    }
    let listed = Vector.asSlice<Shared<Type>>(&members)
    let mut variables = Vector.make<Shared<DeclarationId>>()
    run Vector.append<Shared<DeclarationId>>(&mut variables, run Shared.make<DeclarationId>(run DeclarationId.copy(elided)))
    let mut selected = Option.none<Vector<Binding>>()
    let mut at = usize.ZERO
    while at < listed.length {
      let mut bindings = Vector.make<Binding>()
      let unified = run Type.unify(&listed[at], &actual, Vector.asSlice<Shared<DeclarationId>>(&variables),
        Comparison.Exact, &mut bindings)
      let describes = match &unified {
        Unification.Unified => true
        _ => false
      }
      if describes {
        if let Option<Vector<Binding>>.Some {..} = &selected {
          return run bodyRejection(resolver, module, RejectionCode.AmbiguousLifetime, span)
        }
        selected = Option.some<Vector<Binding>>(move bindings)
      }
      at = at + usize.ONE
    }
    let chosen = match move selected {
      Option<Vector<Binding>>.Some {value} => value
      Option<Vector<Binding>>.None => { return run bodyRejection(resolver, module, RejectionCode.TypeMismatch, span) }
    }
    // A lifetime another member elides is described by no part of this initializer.
    let filled = run Type.applyBindings(written, Vector.asSlice<Binding>(&chosen), true)
    if run typeMentionsOwner(&filled, elided) {
      return run bodyRejection(resolver, module, RejectionCode.AmbiguousLifetime, span)
    }
    let injected = run unionArgument(&mut nodes.*, node, &filled)
    if injected.index != node.index { return Result.succeed<BodyNodeId, Shared<Rejection>>(injected) }
    return run bodyRejection(resolver, module, RejectionCode.TypeMismatch, span)
  }
  let sliced = run sliceArgument(&mut nodes.*, node, written)
  if sliced.index != node.index {
    let adapted = match move bodyExpressionType(Vector.asSlice<BodyNode>(&nodes.*), &sliced) {
      Option<Shared<Type>>.Some {value} => value
      Option<Shared<Type>>.None => { return run bodyRejection(resolver, module, RejectionCode.TypeMismatch, span) }
    }
    let converted = run inferredAnnotation(written, &adapted, elided)
    if let Option<Shared<Type>>.Some {..} = &converted { return Result.succeed<BodyNodeId, Shared<Rejection>>(sliced) }
  }
  return run bodyRejection(resolver, module, RejectionCode.TypeMismatch, span)
}

// A producer returns ownership of its exact environment. Reuse the place classification of
// ordinary consuming operands; contract admission cannot make an affine local into a copy.
effect fn transferCallableReturn(resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, module: &ModuleId, cursor: &AuthoredCursor,
  nodes: &mut Vector<BodyNode>, node: BodyNodeId, constraints: &[Constraint], span: Span)
  -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let actual = match move bodyExpressionType(Vector.asSlice<BodyNode>(&nodes.*), &node) {
    Option<Shared<Type>>.Some {value} => move value
    _ => { fail RevisionMismatch {} }
  }
  if Shared.with<Type, bool>(&actual, neverType) { return Result.succeed<BodyNodeId, Shared<Rejection>>(node) }
  let copied = run copyType(&mut resolver.*, &mut owner.*, &mut dependencies.*, &actual, constraints, span)
  let copy = match move copied {
    Result<bool, Shared<Rejection>>.Success {value} => value
    Result<bool, Shared<Rejection>>.Failure {error} => { return Result.failResult<BodyNodeId, Shared<Rejection>>(move error) }
  }
  if copy { return Result.succeed<BodyNodeId, Shared<Rejection>>(node) }
  let nested = match &Vector.asSlice<BodyNode>(&nodes.*)[node.index].kind {
    BodyNodeKind.Expression {form: BodyExpression.Move {value, consumed}, ..} => match &consumed {
      Option<BodyConsumedPlace>.None => Option.some<BodyNodeId>(value)
      _ => Option.none<BodyNodeId>()
    }
    _ => Option.none<BodyNodeId>()
  }
  if let Option<BodyNodeId>.Some {value} = move nested {
    let operandSpan = Vector.asSlice<BodyNode>(&nodes.*)[value.index].origin.span
    let transferred = run transferCallableReturn(&mut resolver.*, &mut owner.*, &mut dependencies.*,
      module, cursor, &mut nodes.*, value, constraints, operandSpan)
    let selected = match move transferred {
      Result<BodyNodeId, Shared<Rejection>>.Success {value: accepted} => accepted
      Result<BodyNodeId, Shared<Rejection>>.Failure {error} => { return Result.failResult<BodyNodeId, Shared<Rejection>>(move error) }
    }
    if selected.index != value.index { run replaceCallableReturnMove(&mut nodes.*, node, selected) }
    return Result.succeed<BodyNodeId, Shared<Rejection>>(node)
  }
  // A match constructs its result on the selected arm. Its being an rvalue does not make
  // an affine place used by an arm copyable; preserve each arm's own transfer metadata.
  let mut armNodes = Vector.make<BodyNodeId>()
  let listedNodes = Vector.asSlice<BodyNode>(&nodes.*)
  if let BodyNodeKind.Expression {form: BodyExpression.Match {arms, ..}, ..} = &listedNodes[node.index].kind {
    let listed = Vector.asSlice<BodyMatchArm>(&arms)
    let mut at = usize.ZERO
    while at < listed.length {
      run Vector.append<BodyNodeId>(&mut armNodes, listed[at].result)
      at = at + usize.ONE
    }
  }
  let returnedArms = Vector.asSlice<BodyNodeId>(&armNodes)
  if returnedArms.length != usize.ZERO {
    let mut at = usize.ZERO
    while at < returnedArms.length {
      let armNode = returnedArms[at]
      let expression = bodyExpressionType(Vector.asSlice<BodyNode>(&nodes.*), &armNode)
      if let Option<Shared<Type>>.Some {..} = move expression {
        let armSpan = Vector.asSlice<BodyNode>(&nodes.*)[armNode.index].origin.span
        let transferred = run transferCallableReturn(&mut resolver.*, &mut owner.*, &mut dependencies.*,
          module, cursor, &mut nodes.*, armNode, constraints, armSpan)
        let selected = match move transferred {
          Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
          Result<BodyNodeId, Shared<Rejection>>.Failure {error} => { return Result.failResult<BodyNodeId, Shared<Rejection>>(move error) }
        }
        if selected.index != armNode.index { run replaceCallableReturnArm(&mut nodes.*, node, at, selected) }
      }
      at = at + usize.ONE
    }
    return Result.succeed<BodyNodeId, Shared<Rejection>>(node)
  }
  let transfer = run consumption(&resolver.source, cursor, Vector.asSlice<BodyNode>(&nodes.*), node)
  let mut code = RejectionCode.ExplicitMoveRequired
  match move transfer {
    Consumption.Rvalue => { return Result.succeed<BodyNodeId, Shared<Rejection>>(node) }
    Consumption.Borrowed => { code = RejectionCode.BorrowedExtraction }
    Consumption.Boundary => { code = RejectionCode.ExtractionBoundary }
    Consumption.Escape {..} => { code = RejectionCode.MatchBorrowEscape }
    Consumption.PlaceBinding => { code = RejectionCode.Unsupported }
    Consumption.Place {..} => {
      let movedPattern = match &Vector.asSlice<BodyNode>(&nodes.*)[node.index].kind {
        BodyNodeKind.Expression {form: BodyExpression.PatternBinding {access, ..}, ..} => access == BodyBindingAccess.Moved
        _ => false
      }
      if movedPattern {
        let selected = run consumedPlace(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor,
          Vector.asSlice<BodyNode>(&nodes.*), node, false, false, span, span, constraints)
        let consumed = match move selected {
          Result<Option<BodyConsumedPlace>, Shared<Rejection>>.Success {value} => move value
          Result<Option<BodyConsumedPlace>, Shared<Rejection>>.Failure {error} => { return Result.failResult<BodyNodeId, Shared<Rejection>>(move error) }
        }
        let origin = Vector.asSlice<BodyNode>(&nodes.*)[node.index].origin
        let moved = BodyNodeId {index: Vector.length<BodyNode>(&nodes.*)}
        run Vector.append<BodyNode>(&mut nodes.*, BodyNode {origin: origin, kind: BodyNodeKind.Expression {
          ty: move actual, form: BodyExpression.Move {value: node, consumed: move consumed}}})
        return Result.succeed<BodyNodeId, Shared<Rejection>>(moved)
      }
      // A raw contract parameter is still a source callable view, requiring retained-view
      // lowering. Its concrete representation must not be guessed to be an owned environment.
      if Shared.with<Type, bool>(&actual, fn(ty: &Type) -> bool { return match &ty.* { Type.Callable {..} => true _ => false } }) {
        return Result.failResult<BodyNodeId, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.Unsupported, span))
      }
    }
  }
  return Result.failResult<BodyNodeId, Shared<Rejection>>(run reject(&resolver.*, module, code, span))
}

effect fn replaceCallableReturnArm(nodes: &mut Vector<BodyNode>, node: BodyNodeId, arm: usize, result: BodyNodeId) -> ()
! RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let previous = Vector.remove<BodyNode>(&mut nodes.*, node.index)
  if let BodyNodeKind.Expression {ty, form} = move previous.kind {
    if let BodyExpression.Match {subject, access, tags, domain, arms, syntax} = move form {
      let mut selected = move arms
      let previousArm = Vector.remove<BodyMatchArm>(&mut selected, arm)
      run Vector.insert<BodyMatchArm>(&mut selected, arm, BodyMatchArm {origin: previousArm.origin,
        pattern: move previousArm.pattern, tests: move previousArm.tests, guard: move previousArm.guard, result: result,
        bindings: move previousArm.bindings})
      run Vector.insert<BodyNode>(&mut nodes.*, node.index, BodyNode {origin: previous.origin,
        kind: BodyNodeKind.Expression {ty: move ty, form: BodyExpression.Match {subject: subject,
          access: move access, tags: tags, domain: domain, arms: move selected, syntax: syntax}}})
      return ()
    }
  }
  fail RevisionMismatch {}
}

effect fn replaceCallableReturnMove(nodes: &mut Vector<BodyNode>, node: BodyNodeId, operand: BodyNodeId) -> ()
! RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let previous = Vector.remove<BodyNode>(&mut nodes.*, node.index)
  if let BodyNodeKind.Expression {ty, form} = move previous.kind {
    if let BodyExpression.Move {consumed, ..} = move form {
      run Vector.insert<BodyNode>(&mut nodes.*, node.index, BodyNode {origin: previous.origin,
        kind: BodyNodeKind.Expression {ty: move ty, form: BodyExpression.Move {value: operand, consumed: move consumed}}})
      return ()
    }
  }
  fail RevisionMismatch {}
}

// Producer-owned contract admission preserves the actual returned environment and target.
effect fn provePlainCallableReturn(resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, module: &ModuleId, nodes: &[BodyNode], node: BodyNodeId,
  contract: &Shared<Type>, declared: &[Constraint], span: Span) -> Option<Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let actual = match move bodyExpressionType(nodes, &node) {
    Option<Shared<Type>>.Some {value} => move value
    _ => { fail RevisionMismatch {} }
  }
  if Shared.with<Type, bool>(&actual, neverType) { return Option.none<Shared<Rejection>>() }
  let rejected = run proveCallableBound(&mut resolver.*, &mut owner.*, &mut dependencies.*, module,
    declared, &actual, contract, span)
  if let Option<Shared<Rejection>>.Some {value} = move rejected {
    let mismatch = Shared.with<Rejection, bool>(&value, fn(diagnostic: &Rejection) -> bool {
      return diagnostic.code == RejectionCode.TypeMismatch || diagnostic.code == RejectionCode.IncompatibleCallableSignature
    })
    if mismatch { return Option.some<Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.ReturnTypeMismatch, span)) }
    return Option.some<Shared<Rejection>>(move value)
  }
  return Option.none<Shared<Rejection>>()
}

effect fn proveOpaqueReturn(resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, module: &ModuleId, producer: &DeclarationId,
  nodes: &[BodyNode], node: BodyNodeId, result: &Shared<Type>, declared: &[Constraint], span: Span)
  -> Option<Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let actual = match move bodyExpressionType(nodes, &node) {
    Option<Shared<Type>>.Some {value} => move value
    _ => { return Option.some<Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.ReturnTypeMismatch, span)) }
  }
  // An operand that exits supplies no outer construction. Its nested returns have their own
  // admission sites and reachable evidence; never is compatible with every result contract.
  if Shared.with<Type, bool>(&actual, neverType) { return Option.none<Shared<Rejection>>() }
  // A returned `effect fn` interface construction is stored rather than run in place; it has no
  // representation until the witness construction exists (named gap).
  if let BodyNodeKind.Expression {form: BodyExpression.InterfaceCall {isEffect, ..}, ..} = &nodes[node.index].kind {
    if isEffect { return Option.some<Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.InterfaceEffectUnavailable, span)) }
  }
  let found = run Type.opaqueEvidence(&actual, result, producer)
  let evidence = match move found {
    Option<Vector<OpaqueEvidence>>.Some {value} => move value
    _ => { return Option.some<Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.ReturnTypeMismatch, span)) }
  }
  let leaves = Vector.asSlice<OpaqueEvidence>(&evidence)
  let mut at = usize.ZERO
  while at < leaves.length {
    let family = run Type.copy(&leaves[at].family)
    if let Type.OpaqueRepresentation {contract, detached, nonParking, ..} = move family {
      let effectContract = Shared.with<Type, bool>(&contract, fn(ty: &Type) -> bool {
        return match &ty.* { Type.Effect {..} => true _ => false }
      })
      if effectContract {
        // An Effect with no exact representation, such as an interface operation's declared
        // `Effect<...>` result, has no storage to realize (named effect-form gap).
        if !Shared.with<Type, bool>(&leaves[at].actual, joinableEffect) && !run representationParameter(&leaves[at].actual, declared) {
          return Option.some<Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.EffectFormUnavailable, span))
        }
        if !run admitsEffect(&leaves[at].actual, &contract, declared) {
          return Option.some<Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.ReturnTypeMismatch, span))
        }
        at = at + usize.ONE
        continue
      }
      let failed = run proveCallableBound(&mut resolver.*, &mut owner.*, &mut dependencies.*, module,
        declared, &leaves[at].actual, &contract, span)
      if let Option<Shared<Rejection>>.Some {value} = move failed {
        let incompatible = Shared.with<Rejection, bool>(&value, fn(diagnostic: &Rejection) -> bool {
          return diagnostic.code == RejectionCode.TypeMismatch || diagnostic.code == RejectionCode.IncompatibleCallableSignature
        })
        if incompatible {
          return Option.some<Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.ReturnTypeMismatch, span))
        }
        return Option.some<Shared<Rejection>>(move value)
      }
      let unknown = run unknownOwnedCallableTypeReturn(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, &leaves[at].actual, span)
      if let Option<Shared<Rejection>>.Some {value} = move unknown { return Option.some<Shared<Rejection>>(move value) }
      // Sealed executable properties still need their own proof; contract admission does not
      // silently discharge them or the body's retained borrow-analysis obligations.
      if detached || nonParking {
        return Option.some<Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.Unsupported, span))
      }
    } else { fail RevisionMismatch {} }
    at = at + usize.ONE
  }
  return Option.none<Shared<Rejection>>()
}

// Whether the Effect contract `wanted` admits the exact Effect `offered` (EFF-009, EFF-013): its
// success converts (an equal type, a member of a wider union, or `never`), its failures and
// requirements are covered, it permits the promised run access, and its environment outlives
// the promised one. A representation parameter offers its bound's contract.
effect fn admitsEffect(offered: &Shared<Type>, wanted: &Shared<Type>, declared: &[Constraint]) -> bool
! OutOfMemoryError ? &mut Allocator {
  let mut given = Shared.with<Type, Option<EffectParts>>(offered, effectParts)
  let missing = match &given { Option<EffectParts>.None => true _ => false }
  if missing {
    let mut at = usize.ZERO
    while at < declared.length {
      if let Constraint.Represents {parameter, contract} = &declared[at] {
        if run Type.equalsShared(offered, &parameter) { given = Shared.with<Type, Option<EffectParts>>(&contract, effectParts) }
      }
      at = at + usize.ONE
    }
  }
  let left = match move given {
    Option<EffectParts>.Some {value} => value
    Option<EffectParts>.None => { return false }
  }
  let right = match move Shared.with<Type, Option<EffectParts>>(wanted, effectParts) {
    Option<EffectParts>.Some {value} => value
    Option<EffectParts>.None => { return false }
  }
  return runStrength(left.mode) <= runStrength(right.mode)
    && (run Type.coversFailure(&right.success, &left.success))
    && (run Type.coversFailure(&right.failure, &left.failure))
    && (run Row.covers(&right.requirements, &left.requirements)) == RowCoverage.Covered
    && (run callableEnvironmentOutlives(&left.environment, &right.environment, declared))
}

// The declared contract of a producer's Effect family, absent for any other type.
fn effectFamilyContract(value: &Type) -> Option<Shared<Type>> {
  if let Type.OpaqueRepresentation {contract, ..} = &value.* {
    if Shared.with<Type, bool>(&contract, bareEffect) { return Option.some<Shared<Type>>(Shared.clone<Type>(&contract)) }
  }
  return Option.none<Shared<Type>>()
}

// Whether a declaration writes an explicit `some<...>` result, which keeps one realization
// (REP-005) rather than joining distinct returned Effects.
effect fn writtenOpaqueResult(resolver: &mut Resolver, module: &ModuleId, ordinal: usize) -> bool
! Cycle | OutOfMemoryError ? &mut Allocator {
  let written = run signatureSyntax(&mut resolver.*, module, ordinal)
  if let Option<WrittenSignature>.Some {value} = move written {
    if let Option<HirId>.Some {value: result} = move value.result {
      let syntax = run typeNode(&mut resolver.*, module, result)
      if let Option<HeaderSyntax>.Some {value: found} = move syntax {
        if let Node.OpaqueResultType {..} = found.header { return true }
      }
    }
  }
  return false
}

// A declared `Effect<...>` result stores whichever Effect a return selects: when the returns
// construct distinct exact Effects, each is injected into their finite join behind the declared
// contract, which every return was proven to satisfy (EFF-013).
effect fn joinEffectReturns(resolver: &Resolver, module: &ModuleId, nodes: &mut Vector<BodyNode>, contract: &Shared<Type>)
  -> Option<Shared<Rejection>> ! OutOfMemoryError ? &mut Allocator {
  let mut returns = Vector.make<usize>()
  let mut alternatives = Vector.make<Shared<Type>>()
  let listed = Vector.asSlice<BodyNode>(&nodes.*)
  let mut at = usize.ZERO
  while at < listed.length {
    let mut returned = usize.MAX
    if let BodyNodeKind.Return {value: written} = &listed[at].kind {
      if let Option<BodyNodeId>.Some {value: node} = &written { returned = node.index }
    }
    if returned != usize.MAX {
      let value = BodyNodeId {index: returned}
      let produced = bodyExpressionType(listed, &value)
      if let Option<Shared<Type>>.Some {value: ty} = move produced {
        if !Shared.with<Type, bool>(&ty, neverType) {
          run Vector.append<usize>(&mut returns, at)
          let stored = run joinAlternatives(&ty)
          let values = Vector.asSlice<Shared<Type>>(&stored)
          let mut item = usize.ZERO
          while item < values.length {
            if (run joinAlternative(Vector.asSlice<Shared<Type>>(&alternatives), &values[item])) == usize.MAX {
              run Vector.append<Shared<Type>>(&mut alternatives, Shared.clone<Type>(&values[item]))
            }
            item = item + usize.ONE
          }
        }
      }
    }
    at = at + usize.ONE
  }
  if Vector.length<Shared<Type>>(&alternatives) < 2 { return Option.none<Shared<Rejection>>() }
  let joined = run Shared.make<Type>(Type.EffectJoin {contract: Shared.clone<Type>(contract), alternatives: move alternatives})
  let sites = Vector.asSlice<usize>(&returns)
  at = usize.ZERO
  while at < sites.length {
    let node = BodyNodeId {index: sites[at]}
    let mut returned = usize.MAX
    if let BodyNodeKind.Return {value: written} = &Vector.asSlice<BodyNode>(&nodes.*)[node.index].kind {
      if let Option<BodyNodeId>.Some {value: selected} = &written { returned = selected.index }
    }
    let value = BodyNodeId {index: returned}
    let span = Vector.asSlice<BodyNode>(&nodes.*)[value.index].origin.span
    let injected = match move run injectJoined(&mut nodes.*, value, &joined) {
      Option<BodyNodeId>.Some {value: selected} => selected
      Option<BodyNodeId>.None => { return Option.some<Shared<Rejection>>(run reject(resolver, module, RejectionCode.NestedEffectJoinUnavailable, span)) }
    }
    let previous = Vector.remove<BodyNode>(&mut nodes.*, node.index)
    run Vector.insert<BodyNode>(&mut nodes.*, node.index, BodyNode {origin: previous.origin,
      kind: BodyNodeKind.Return {value: Option.some<BodyNodeId>(injected)}})
    at = at + usize.ONE
  }
  return Option.none<Shared<Rejection>>()
}

// Whether a value is a representation parameter, whose argument supplies its exact storage.
effect fn representationParameter(value: &Shared<Type>, declared: &[Constraint]) -> bool ! OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < declared.length {
    if let Constraint.Represents {parameter, ..} = &declared[at] {
      if run Type.equalsShared(value, &parameter) { return true }
    }
    at = at + usize.ONE
  }
  return false
}

// Whether a value is an exact Effect a finite join may hold (EFF-013): an `effect fn`
// construction or Effect literal, a composition, a producer's Effect family, or a join.
fn joinableEffect(value: &Type) -> bool {
  return match &value.* {
    Type.CallableValue {contract, ..} => Shared.with<Type, bool>(&contract, bareEffect)
    Type.EffectComposite {..} => true
    Type.EffectJoin {..} => true
    Type.OpaqueRepresentation {contract, ..} => Shared.with<Type, bool>(&contract, bareEffect)
    _ => false
  }
}

// The exact Effects a value stores: a join's alternatives, or the value itself.
effect fn joinAlternatives(value: &Shared<Type>) -> Vector<Shared<Type>> ! OutOfMemoryError ? &mut Allocator {
  let copied = run Type.copy(value)
  if let Type.EffectJoin {alternatives, ..} = move copied { return move alternatives }
  let mut single = Vector.make<Shared<Type>>()
  run Vector.append<Shared<Type>>(&mut single, Shared.clone<Type>(value))
  return move single
}

// Replaces a checked expression's type; its storage is unchanged, as for a join view.
effect fn retypeNode(nodes: &mut Vector<BodyNode>, node: BodyNodeId, ty: Shared<Type>) -> () ! OutOfMemoryError ? &mut Allocator {
  let previous = Vector.remove<BodyNode>(&mut nodes.*, node.index)
  let form = match move previous.kind {
    BodyNodeKind.Expression {form, ..} => move form
    _ => absurd<BodyExpression>()
  }
  run Vector.insert<BodyNode>(&mut nodes.*, node.index, BodyNode {origin: previous.origin,
    kind: BodyNodeKind.Expression {ty: move ty, form: move form}})
  return ()
}

// Whether every value of a type is Copy. Scalars, the unit value, enums and shared references
// always are; a nominal record or union is Copy only when its module declares `impl Copy` for it,
// read through that module's Implementations query so the decision depends on the declaration; a
// structural union or fixed array is Copy when every member is.
effect fn copyType(
  resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, ty: &Shared<Type>, constraints: &[Constraint], span: Span,
) -> Result<bool, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let active = Vector.make<Shared<Type>>()
  return run copyTypeWithin(&mut resolver.*, &mut owner.*, &mut dependencies.*, ty, constraints, span,
    Vector.asSlice<Shared<Type>>(&active))
}

// Discharge each ancestor independently when this edge consumes one of its concrete structural
// parts. A<B> -> B finishes A's obligation even if B later stores A<i32>. Do not discard an entire
// prefix: a descent through X<B<[i32; 1]>> must retain an older B<i32> growth obligation.
effect fn storedPropertyAncestors(ty: &Shared<Type>, active: &[Shared<Type>]) -> Vector<Shared<Type>>
! OutOfMemoryError ? &mut Allocator {
  let mut retained = Vector.make<Shared<Type>>()
  let mut at = usize.ZERO
  while at < active.length {
    if !run Type.strictRuntimeSubterm(ty, &active[at]) {
      run Vector.append<Shared<Type>>(&mut retained, Shared.clone<Type>(&active[at]))
    }
    at = at + usize.ONE
  }
  return move retained
}

fn storedPropertyCycle(ty: &Shared<Type>, active: &[Shared<Type>]) -> bool {
  let mut at = usize.ZERO
  while at < active.length {
    if sameNominal(ty, &active[at]) { return true }
    at = at + usize.ONE
  }
  return false
}

effect fn copyTypeWithin(
  resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, ty: &Shared<Type>, constraints: &[Constraint], span: Span,
  active: &[Shared<Type>],
) -> Result<bool, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  // No sealed core is Copy; no source premise or conformance can make one Copy.
  if let Option<SealedKind>.Some {..} = move SealedCore.coreOf(ty) {
    return Result.succeed<bool, Shared<Rejection>>(false)
  }

  let mut premise = usize.ZERO
  while premise < constraints.length {
    if let Constraint.Copyable {subject} = &constraints[premise] {
      if run Type.equalsShared(ty, &subject) { return Result.succeed<bool, Shared<Rejection>>(true) }
    }
    if let Constraint.Represents {parameter, contract} = &constraints[premise] {
      if (run Type.equalsShared(ty, &parameter)) && Shared.with<Type, bool>(&contract, sharedCallableType) {
        return Result.succeed<bool, Shared<Rejection>>(true)
      }
    }
    premise = premise + usize.ONE
  }
  let simple = Shared.with<Type, bool>(ty, fn(value: &Type) -> bool {
    return match &value.* {
      Type.Unit => true
      Type.Primitive {..} => scalarType(value) || pointerSizedIntegerType(value)
      Type.Reference {access, ..} => access == Access.Shared
      Type.Slice {access, ..} => access == Access.Shared
      // A raw pointer holds no ownership or loan, so every pointee and qualifier is Copy.
      Type.Pointer {..} => true
      // `string` is a Copy view (TEXT-001).
      Type.String {..} => true
      Type.Callable {mode, ..} => mode == CallableMode.Shared
      Type.CallableValue {contract, ..} => Shared.with<Type, CallableMode>(&contract, callableInvocationMode) == CallableMode.Shared
      Type.CallableOrigin {contract, ..} => Shared.with<Type, CallableMode>(&contract, callableInvocationMode) == CallableMode.Shared
      Type.CallableWitnessResult {witness} => {
        let recipe = Shared.with<WitnessRecipe, WitnessRecipe>(&witness, CallableWitness.copy)
        return Shared.with<Type, CallableMode>(&recipe.result, callableInvocationMode) == CallableMode.Shared
      }
      Type.CallableResult {contract, ..} => Shared.with<Type, CallableMode>(&contract, callableInvocationMode) == CallableMode.Shared
      Type.CallableStage {contract, ..} => Shared.with<Type, CallableMode>(&contract, callableInvocationMode) == CallableMode.Shared
      Type.CallableSchema {schema, ..} => Shared.with<Type, CallableMode>(&sectionSchemaContract(&schema), callableInvocationMode) == CallableMode.Shared
      Type.CallableView {contract, ..} => Shared.with<Type, bool>(&contract, sharedCallableType)
      // A producer's Effect family is realized only at layout, so it is never proven Copy.
      Type.OpaqueRepresentation {contract, ..} => Shared.with<Type, bool>(&contract, sharedCallableType)
      Type.Nominal {..} => nominalKind(value) == OwnerKind.Enumeration
      _ => false
    }
  })
  if simple { return Result.succeed<bool, Shared<Rejection>>(true) }
  let mut nested = run storedPropertyAncestors(ty, active)
  let node = run Type.copy(ty)
  let mut members = Vector.make<Shared<Type>>()
  let mut composite = false
  if let Type.Union {members: listedMembers} = &node {
    members = run copyTypes(Vector.asSlice<Shared<Type>>(&listedMembers))
    composite = true
  }
  // A join is Copy only when every alternative it may store is (CAPTURE-002).
  if let Type.EffectJoin {alternatives, ..} = &node {
    members = run copyTypes(Vector.asSlice<Shared<Type>>(&alternatives))
    composite = true
  }
  if let Type.Array {element, ..} = &node {
    run Vector.append<Shared<Type>>(&mut members, Shared.clone<Type>(&element))
    composite = true
  }
  if composite {
    let listed = Vector.asSlice<Shared<Type>>(&members)
    let mut at = usize.ZERO
    while at < listed.length {
      let member = run copyTypeWithin(&mut resolver.*, &mut owner.*, &mut dependencies.*, &listed[at], constraints, span,
        Vector.asSlice<Shared<Type>>(&nested))
      match move member {
        Result<bool, Shared<Rejection>>.Success {value} => { if !value { return Result.succeed<bool, Shared<Rejection>>(false) } }
        Result<bool, Shared<Rejection>>.Failure {error} => { return Result.failResult<bool, Shared<Rejection>>(move error) }
      }
      at = at + usize.ONE
    }
    return Result.succeed<bool, Shared<Rejection>>(true)
  }
  // Growing<i32> -> Growing<[i32; 1]> and exact inline cycles cannot prove Copy. NotCopy
  // makes the selecting implementation reject its field loudly at its own module and impl
  // span, rather than attaching an enclosing span to the repeated type's declaration module.
  if storedPropertyCycle(ty, Vector.asSlice<Shared<Type>>(&nested)) {
    return Result.succeed<bool, Shared<Rejection>>(false)
  }
  run Vector.append<Shared<Type>>(&mut nested, Shared.clone<Type>(ty))
  return run implementsSealedWithin(&mut resolver.*, &mut owner.*, &mut dependencies.*, ty, SealedProperty.Copy,
    constraints, span, Vector.asSlice<Shared<Type>>(&nested))
}

// A selected sealed head retains the exact provider match for its hook application.
struct SealedMatch {
  declaration: Shared<DeclarationId>
  bindings: Vector<Binding>
  span: Span
}

// Bound absence is distinct from missing proof. In particular, unavailable evidence may never
// suppress a potentially applicable Drop hook.
enum BoundProof { Proven, Rejected, Unavailable }

effect fn boundProof(
  resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, bound: &Constraint, declared: &[Constraint],
  context: &DeclarationId, module: &ModuleId, span: Span,
  active: &[Shared<Type>],
) -> Result<BoundProof, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  if let Constraint.Copyable {subject} = &bound.* {
    if let Option<SealedKind>.Some {..} = move SealedCore.coreOf(&subject) {
      return Result.succeed<BoundProof, Shared<Rejection>>(BoundProof.Rejected)
    }
  }

  let mut at = usize.ZERO
  while at < declared.length {
    if run sameConstraint(bound, &declared[at]) {
      return Result.succeed<BoundProof, Shared<Rejection>>(BoundProof.Proven)
    }
    at = at + usize.ONE
  }
  if let Constraint.Copyable {subject} = &bound.* {
    let copied = run copyTypeWithin(&mut resolver.*, &mut owner.*, &mut dependencies.*, &subject, declared, span, active)
    return match move copied {
      Result<bool, Shared<Rejection>>.Success {value} => {
        if value { return Result.succeed<BoundProof, Shared<Rejection>>(BoundProof.Proven) }
        if Type.hasOpenRuntimeParameters(&subject) {
          return Result.succeed<BoundProof, Shared<Rejection>>(BoundProof.Unavailable)
        }
        return Result.succeed<BoundProof, Shared<Rejection>>(BoundProof.Rejected)
      }
      Result<bool, Shared<Rejection>>.Failure {error} => Result.failResult<BoundProof, Shared<Rejection>>(move error)
    }
  }
  if let Constraint.Outlives {longer, shorter} = &bound.* {
    if run knownOutlives(declared, &longer, &shorter) {
      return Result.succeed<BoundProof, Shared<Rejection>>(BoundProof.Proven)
    }
    if Lifetime.anyAtom(&longer, localLifetime) && Shared.with<Lifetime, bool>(&shorter, staticLifetime) {
      return Result.succeed<BoundProof, Shared<Rejection>>(BoundProof.Rejected)
    }
    return Result.succeed<BoundProof, Shared<Rejection>>(BoundProof.Unavailable)
  }
  if let Constraint.Contents {subject, region} = &bound.* {
    let representations = Vector.make<Option<Shared<Type>>>()
    let mut retained = Vector.make<Shared<Lifetime>>()
    if !run Type.retainedRegions(&subject, context, Vector.asSlice<Option<Shared<Type>>>(&representations), &mut retained) {
      return Result.succeed<BoundProof, Shared<Rejection>>(BoundProof.Unavailable)
    }
    let regions = Vector.asSlice<Shared<Lifetime>>(&retained)
    at = usize.ZERO
    while at < regions.length {
      if !run knownOutlives(declared, &regions[at], &region) {
        if Lifetime.anyAtom(&regions[at], localLifetime) && Shared.with<Lifetime, bool>(&region, staticLifetime) {
          return Result.succeed<BoundProof, Shared<Rejection>>(BoundProof.Rejected)
        }
        return Result.succeed<BoundProof, Shared<Rejection>>(BoundProof.Unavailable)
      }
      at = at + usize.ONE
    }
    return Result.succeed<BoundProof, Shared<Rejection>>(BoundProof.Proven)
  }
  if let Constraint.Conforms {provider, contract} = &bound.* {
    let goal = ConformanceGoal {provider: Shared.clone<Type>(&provider), contract: Shared.clone<Type>(&contract)}
    let mut request = Request.make()
    let mut chain = Vector.make<ConformanceGoal>()
    let mut steps = Vector.make<ConformanceStep>()
    let avoid = Option.some<Shared<DeclarationId>>(run Shared.make<DeclarationId>(run DeclarationId.copy(context)))
    let failed = run proveGoal(&mut resolver.*, &mut owner.*, &mut request, &mut dependencies.*,
      true, &avoid, &goal, declared, module, span, &mut chain, &mut steps)
    if let Option<Shared<Rejection>>.Some {value} = move failed {
      let missing = Shared.with<Rejection, bool>(&value, fn(problem: &Rejection) -> bool {
        return problem.code == RejectionCode.MissingConformance
      })
      if missing {
        if !Type.hasOpenParameters(&provider) && !Type.hasOpenParameters(&contract) {
          return Result.succeed<BoundProof, Shared<Rejection>>(BoundProof.Rejected)
        }
        return Result.succeed<BoundProof, Shared<Rejection>>(BoundProof.Unavailable)
      }
      if Shared.with<Rejection, bool>(&value, fn(problem: &Rejection) -> bool {
        return problem.code == RejectionCode.Unsupported
      }) {
        return Result.succeed<BoundProof, Shared<Rejection>>(BoundProof.Unavailable)
      }
      return Result.failResult<BoundProof, Shared<Rejection>>(move value)
    }
    return Result.succeed<BoundProof, Shared<Rejection>>(BoundProof.Proven)
  }
  // Executable property/representation proofs are later-stage facts. Exact lexical evidence above
  // is usable now; lack of a concrete prover remains explicit rather than absence of the head.
  return Result.succeed<BoundProof, Shared<Rejection>>(BoundProof.Unavailable)
}

// Exact applicability and retained substitutions of one sealed-property head.
effect fn sealedHeadMatch(
  resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, head: &Shared<ImplementationHead>,
  ty: &Shared<Type>, property: SealedProperty, declared: &[Constraint], module: &ModuleId, span: Span,
) -> Result<Option<SealedMatch>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let active = Vector.make<Shared<Type>>()
  return run sealedHeadMatchWithin(&mut resolver.*, &mut owner.*, &mut dependencies.*, head, ty, property,
    declared, module, span, Vector.asSlice<Shared<Type>>(&active))
}

effect fn sealedHeadMatchWithin(
  resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, head: &Shared<ImplementationHead>,
  ty: &Shared<Type>, property: SealedProperty, declared: &[Constraint], module: &ModuleId, span: Span,
  active: &[Shared<Type>],
) -> Result<Option<SealedMatch>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let headSpan = Shared.with<ImplementationHead, Span>(head, fn(value: &ImplementationHead) -> Span { return value.span })
  let matchesProperty = Shared.with<ImplementationHead, bool>(head, fn(value: &ImplementationHead) -> bool {
    return match &value.kind {
      ImplementationKind.Sealed {property: found} => found == property
      _ => false
    }
  })
  if !matchesProperty { return Result.succeed<Option<SealedMatch>, Shared<Rejection>>(Option.none<SealedMatch>()) }
  let declaration = Shared.with<ImplementationHead, Shared<DeclarationId>>(
    head, fn(value: &ImplementationHead) -> Shared<DeclarationId> { return Shared.clone<DeclarationId>(&value.declaration) },
  )
  let context = run DeclarationId.copyShared(&declaration)
  let provider = Shared.with<ImplementationHead, Shared<Type>>(
    head, fn(value: &ImplementationHead) -> Shared<Type> { return Shared.clone<Type>(&value.provider) },
  )
  let mut patterns = Vector.make<Shared<Type>>()
  run Vector.append<Shared<Type>>(&mut patterns, move provider)
  let mut instances = Vector.make<Shared<Type>>()
  run Vector.append<Shared<Type>>(&mut instances, Shared.clone<Type>(ty))
  let mut variables = Vector.make<Shared<DeclarationId>>()
  run Vector.append<Shared<DeclarationId>>(&mut variables, Shared.clone<DeclarationId>(&declaration))
  let mut bindings = Vector.make<Binding>()
  let matched = run Type.unifyAll(Vector.asSlice<Shared<Type>>(&patterns), Vector.asSlice<Shared<Type>>(&instances),
    Vector.asSlice<Shared<DeclarationId>>(&variables), Comparison.Exact, &mut bindings)
  if exactHeadUndetermined(&matched) {
    return Result.failResult<Option<SealedMatch>, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.Unsupported, span))
  }
  if !exactHeadMatched(&matched) { return Result.succeed<Option<SealedMatch>, Shared<Rejection>>(Option.none<SealedMatch>()) }
  let count = Shared.with<ImplementationHead, usize>(head, headConstraintCount)
  let mut at = usize.ZERO
  let mut unavailable = false
  while at < count {
    let written = match move Shared.with<ImplementationHead, Option<Constraint>>(
      head, fn(value: &ImplementationHead) -> Option<Constraint> { return headConstraintAt(value, at) },
    ) {
      Option<Constraint>.Some {value} => value
      Option<Constraint>.None => {
        return Result.failResult<Option<SealedMatch>, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.Unsupported, span))
      }
    }
    let applied = run applyConstraintBindings(&written, Vector.asSlice<Binding>(&bindings))
    let mut proofSpan = span
    if property == SealedProperty.Copy { proofSpan = headSpan }
    let proved = run boundProof(&mut resolver.*, &mut owner.*, &mut dependencies.*, &applied, declared, &context, module, proofSpan, active)
    match move proved {
      Result<BoundProof, Shared<Rejection>>.Success {value} => match value {
        BoundProof.Proven => ()
        BoundProof.Rejected => { return Result.succeed<Option<SealedMatch>, Shared<Rejection>>(Option.none<SealedMatch>()) }
        BoundProof.Unavailable => { unavailable = true }
      }
      Result<BoundProof, Shared<Rejection>>.Failure {error} => {
        return Result.failResult<Option<SealedMatch>, Shared<Rejection>>(move error)
      }
    }
    at = at + usize.ONE
  }
  if unavailable {
    // Check every premise first: a disproved bound rules out the head regardless of bound order.
    // Abstract Copy may conservatively be affine; unavailable Drop evidence remains a loud gap.
    if property == SealedProperty.Copy && Type.hasOpenParameters(ty) {
      return Result.succeed<Option<SealedMatch>, Shared<Rejection>>(Option.none<SealedMatch>())
    }
    return Result.failResult<Option<SealedMatch>, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.Unsupported, span))
  }
  return Result.succeed<Option<SealedMatch>, Shared<Rejection>>(Option.some<SealedMatch>(
    SealedMatch {declaration: move declaration, bindings: move bindings, span: headSpan},
  ))
}

// Whether the declaring module of a nominal type implements sealed `property` for exactly it, read
// through that module's Implementations query so the decision depends on the declaration.
effect fn implementsSealed(
  resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, ty: &Shared<Type>, property: SealedProperty, declared: &[Constraint], span: Span,
) -> Result<bool, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let active = Vector.make<Shared<Type>>()
  return run implementsSealedWithin(&mut resolver.*, &mut owner.*, &mut dependencies.*, ty, property,
    declared, span, Vector.asSlice<Shared<Type>>(&active))
}

effect fn implementsSealedWithin(
  resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, ty: &Shared<Type>, property: SealedProperty, declared: &[Constraint], span: Span,
  active: &[Shared<Type>],
) -> Result<bool, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  if !Shared.with<Type, bool>(ty, isNominalType) { return Result.succeed<bool, Shared<Rejection>>(false) }
  let module = declaringModuleOrdinal(&resolver.*, ty)
  if module == usize.MAX { return Result.succeed<bool, Shared<Rejection>>(false) }
  let siteModule = run resolvedModule(&resolver.*, module)
  let listKey = Key {
    family: Family.Implementations, module: module, name: usize.ZERO,
    declaration: usize.ZERO, member: usize.ZERO, external: false,
  }
  let listed = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, listKey, span)
  let failed = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(&listed, answerRejection)
  if let Option<Shared<Rejection>>.Some {value} = move failed { return Result.failResult<bool, Shared<Rejection>>(move value) }
  let count = Shared.with<Result<Answer, NoRejection>, usize>(&listed, implementationCount)
  let mut at = usize.ZERO
  while at < count {
    let candidate = Shared.with<Result<Answer, NoRejection>, Option<Shared<ImplementationHead>>>(
      &listed, fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<ImplementationHead>> {
        return implementationAt(answer, at)
      },
    )
    if let Option<Shared<ImplementationHead>>.Some {value: head} = move candidate {
      let matched = run sealedHeadMatchWithin(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies.*,
        &head,
        ty,
        property,
        declared,
        &siteModule,
        span,
        active,
      )
      match move matched {
        Result<Option<SealedMatch>, Shared<Rejection>>.Success {value} => {
          if let Option<SealedMatch>.Some {value: selected} = move value {
            if property == SealedProperty.Copy {
              let dropping = run implementsSealedWithin(&mut resolver.*, &mut owner.*, &mut dependencies.*, ty,
                SealedProperty.Drop, declared, selected.span, active)
              match move dropping {
                Result<bool, Shared<Rejection>>.Success {value: ownDrop} => {
                  if ownDrop { return Result.failResult<bool, Shared<Rejection>>(run reject(&resolver.*, &siteModule, RejectionCode.InvalidCopyConformance, selected.span)) }
                }
                Result<bool, Shared<Rejection>>.Failure {error} => { return Result.failResult<bool, Shared<Rejection>>(move error) }
              }
              let stored = run nominalParts(&mut resolver.*, &mut owner.*, &mut dependencies.*, ty, selected.span)
              let fields = match move stored {
                Result<Vector<Shared<Type>>, Shared<Rejection>>.Success {value: parts} => parts
                Result<Vector<Shared<Type>>, Shared<Rejection>>.Failure {error} => { return Result.failResult<bool, Shared<Rejection>>(move error) }
              }
              let parts = Vector.asSlice<Shared<Type>>(&fields)
              let mut field = usize.ZERO
              while field < parts.length {
                let copied = run copyTypeWithin(&mut resolver.*, &mut owner.*, &mut dependencies.*, &parts[field], declared, selected.span, active)
                match move copied {
                  Result<bool, Shared<Rejection>>.Success {value: isCopy} => {
                    if !isCopy { return Result.failResult<bool, Shared<Rejection>>(run reject(&resolver.*, &siteModule, RejectionCode.InvalidCopyConformance, selected.span)) }
                  }
                  Result<bool, Shared<Rejection>>.Failure {error} => { return Result.failResult<bool, Shared<Rejection>>(move error) }
                }
                field = field + usize.ONE
              }
            }
            return Result.succeed<bool, Shared<Rejection>>(true)
          }
        }
        Result<Option<SealedMatch>, Shared<Rejection>>.Failure {error} => {
          return Result.failResult<bool, Shared<Rejection>>(move error)
        }
      }
    }
    at = at + usize.ONE
  }
  return Result.succeed<bool, Shared<Rejection>>(false)
}

// Whether dropping a value of this type runs no cleanup: no `impl Drop` anywhere in its owned
// structure (record fields, variant payloads, union members, array elements). Copy types, scalars,
// views and enums are cleanup-free; an unresolved type parameter is free only when a declared
// premise proves it Copy. Revisiting a nominal declaration requires finite structural descent;
// impossible inline cycles retain a loud gap.
effect fn cleanupFree(
  resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, ty: &Shared<Type>, constraints: &[Constraint], visiting: &mut Vector<Shared<Type>>,
  span: Span,
) -> Result<bool, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  // A sealed core's cleanup is its own: allocations release, shared cores count references.
  if let Option<SealedKind>.Some {value: core} = move SealedCore.coreOf(ty) {
    return Result.succeed<bool, Shared<Rejection>>(!SealedCore.ownsCleanup(core))
  }

  let node = run Type.copy(ty)
  let mut active = run storedPropertyAncestors(ty, Vector.asSlice<Shared<Type>>(&visiting.*))
  let mut parts = Vector.make<Shared<Type>>()
  match &node {
    // Only a declared premise proves an abstract parameter Copy, such as `K: Copy` or a shared
    // callable representation; Copy and Drop are exclusive, so such a parameter owns no cleanup.
    Type.Parameter {..} => { return run copyType(&mut resolver.*, &mut owner.*, &mut dependencies.*, ty, constraints, span) }
    Type.OpaqueRepresentation {..} => { return run copyType(&mut resolver.*, &mut owner.*, &mut dependencies.*, ty, constraints, span) }
    Type.Array {element, ..} => { run Vector.append<Shared<Type>>(&mut parts, Shared.clone<Type>(&element)) }
    Type.Union {members} => { parts = run copyTypes(Vector.asSlice<Shared<Type>>(&members)) }
    Type.Anonymous {members, ..} => { parts = run copyTypes(Vector.asSlice<Shared<Type>>(&members)) }
    Type.CallableValue {captures, ..} => { parts = run copyTypes(Vector.asSlice<Shared<Type>>(&captures)) }
    Type.CallableSchema {captures, ..} => { parts = run copyTypes(Vector.asSlice<Shared<Type>>(&captures)) }
    Type.EffectComposite {parts: stored, ..} => { parts = run copyTypes(Vector.asSlice<Shared<Type>>(&stored)) }
    Type.EffectJoin {alternatives, ..} => { parts = run copyTypes(Vector.asSlice<Shared<Type>>(&alternatives)) }
    Type.CallableStage {base, captures, ..} => {
      run Vector.append<Shared<Type>>(&mut parts, Shared.clone<Type>(&base))
      let supplied = Vector.asSlice<Shared<Type>>(&captures)
      let mut at = usize.ZERO
      while at < supplied.length {
        run Vector.append<Shared<Type>>(&mut parts, Shared.clone<Type>(&supplied[at]))
        at = at + usize.ONE
      }
    }
    Type.Nominal {..} => {
      let copied = run copyType(&mut resolver.*, &mut owner.*, &mut dependencies.*, ty, constraints, span)
      match move copied {
        Result<bool, Shared<Rejection>>.Success {value} => { if value { return Result.succeed<bool, Shared<Rejection>>(true) } }
        Result<bool, Shared<Rejection>>.Failure {error} => { return Result.failResult<bool, Shared<Rejection>>(move error) }
      }
      let dropped = run implementsSealed(&mut resolver.*, &mut owner.*, &mut dependencies.*, ty, SealedProperty.Drop, constraints, span)
      match move dropped {
        Result<bool, Shared<Rejection>>.Success {value} => { if value { return Result.succeed<bool, Shared<Rejection>>(false) } }
        Result<bool, Shared<Rejection>>.Failure {error} => { return Result.failResult<bool, Shared<Rejection>>(move error) }
      }
      if storedPropertyCycle(ty, Vector.asSlice<Shared<Type>>(&active)) {
        let declaringModule = run resolvedModule(&resolver.*, declaringModuleOrdinal(&resolver.*, ty))
        let declaration = run ordinalOfProvider(&mut resolver.*, &declaringModule, ty)
        // Derive both parts of the site from this declaration. The incoming span may belong
        // to an imported caller or a different stored nominal declaration.
        let mut declarationSpan = Span.make(usize.ZERO, usize.ZERO)
        if let Option<usize>.Some {value: ordinal} = move declaration {
          let writtenHeader = run header(&mut resolver.*, &declaringModule, ordinal)
          if let Option<HeaderSyntax>.Some {value: written} = move writtenHeader {
            declarationSpan = written.span
          }
        }
        return Result.failResult<bool, Shared<Rejection>>(run reject(&resolver.*, &declaringModule,
          RejectionCode.InlineStorageUnavailable, declarationSpan))
      }
      let gathered = run nominalParts(&mut resolver.*, &mut owner.*, &mut dependencies.*, ty, span)
      parts = match move gathered {
        Result<Vector<Shared<Type>>, Shared<Rejection>>.Success {value} => value
        Result<Vector<Shared<Type>>, Shared<Rejection>>.Failure {error} => { return Result.failResult<bool, Shared<Rejection>>(move error) }
      }
      run Vector.append<Shared<Type>>(&mut active, Shared.clone<Type>(ty))
    }
    _ => { return Result.succeed<bool, Shared<Rejection>>(true) }
  }
  let listed = Vector.asSlice<Shared<Type>>(&parts)
  let mut at = usize.ZERO
  let mut free = true
  while at < listed.length && free {
    let part = run cleanupFree(&mut resolver.*, &mut owner.*, &mut dependencies.*, &listed[at], constraints, &mut active, span)
    match move part {
      Result<bool, Shared<Rejection>>.Success {value} => { free = value }
      Result<bool, Shared<Rejection>>.Failure {error} => { return Result.failResult<bool, Shared<Rejection>>(move error) }
    }
    at = at + usize.ONE
  }
  return Result.succeed<bool, Shared<Rejection>>(free)
}

// Every owned part of a nominal record, tuple record or union: field types in order, then each
// variant's payload types, under the type's own application.
effect fn nominalParts(
  resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, ty: &Shared<Type>, span: Span,
) -> Result<Vector<Shared<Type>>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let mut parts = Vector.make<Shared<Type>>()
  let moduleOrdinal = declaringModuleOrdinal(&resolver.*, ty)
  if moduleOrdinal == usize.MAX { return Result.succeed<Vector<Shared<Type>>, Shared<Rejection>>(move parts) }
  let declaredModule = run resolvedModule(&resolver.*, moduleOrdinal)
  let ordinal = run ordinalOfProvider(&mut resolver.*, &declaredModule, ty)
  let declaration = match move ordinal {
    Option<usize>.Some {value} => value
    Option<usize>.None => { return Result.succeed<Vector<Shared<Type>>, Shared<Rejection>>(move parts) }
  }
  let mut count = usize.ZERO
  let written = run header(&mut resolver.*, &declaredModule, declaration)
  if let Option<HeaderSyntax>.Some {value} = move written {
    match value.header {
      Node.StructHeader {fields, ..} => { count = fields.length }
      Node.TupleHeader {elements, ..} => { count = elements.length }
      Node.UnionHeader {variants, ..} => { count = variants.length }
      _ => ()
    }
  }
  let application = run internApplication(&mut resolver.*, ty)
  let mut member = usize.ZERO
  while member < count {
    let shape = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, Key {
      family: Family.MemberShape, module: moduleOrdinal, name: application,
      declaration: declaration, member: member, external: false,
    }, span)
    let rejected = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(&shape, answerRejection)
    if let Option<Shared<Rejection>>.Some {value} = move rejected {
      return Result.failResult<Vector<Shared<Type>>, Shared<Rejection>>(move value)
    }
    let mut at = usize.ZERO
    while true {
      let part = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(&shape, fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> {
        return shapeTypeAt(answer, at)
      })
      match move part {
        Option<Shared<Type>>.Some {value} => { run Vector.append<Shared<Type>>(&mut parts, move value) }
        Option<Shared<Type>>.None => { break }
      }
      at = at + usize.ONE
    }
    member = member + usize.ONE
  }
  return Result.succeed<Vector<Shared<Type>>, Shared<Rejection>>(move parts)
}

fn zeroDigits(digits: &[u8]) -> bool {
  let mut at = usize.ZERO
  while at < digits.length {
    if digits[at] != '0' { return false }
    at = at + usize.ONE
  }
  return true
}

fn scalarSubject(value: &Type) -> bool {
  return scalarType(value) || pointerSizedIntegerType(value)
}

// Source record identity is valid during abstract body checking. Runtime completeness belongs
// to MIR realization and Layout, never to admission of a caller-owned generic pattern.
effect fn declaredRecord(resolver: &mut Resolver, value: &Shared<Type>) -> bool
! Cycle | OutOfMemoryError ? &mut Allocator {
  let moduleOrdinal = declaringModuleOrdinal(&resolver.*, value)
  if moduleOrdinal == usize.MAX { return false }
  let declaredModule = run resolvedModule(&resolver.*, moduleOrdinal)
  let ordinal = run ordinalOfProvider(&mut resolver.*, &declaredModule, value)
  if let Option<usize>.Some {value: declaration} = move ordinal {
    let written = run header(&mut resolver.*, &declaredModule, declaration)
    if let Option<HeaderSyntax>.Some {value: syntax} = move written {
      if let Node.StructHeader {..} = syntax.header { return true }
    }
  }
  return false
}

// Source members may retain exact callable or generic evidence before monomorphization. A nominal
// member has its own finite identity even while its arguments are open (`Empty<T>` in `Vector<T>`).
// Every physical layout and source ordinal still requires the complete canonical storage map.
fn sourceUnionMember(value: &Shared<Type>) -> bool {
  return Shared.with<Type, bool>(value, scalarSubject)
    || Type.closedCallableStorage(value) || Shared.with<Type, bool>(value, fn(ty: &Type) -> bool {
      return match &ty.* {
        Type.Nominal {..} => true
        Type.Parameter {..} => true
        Type.CallableValue {..} => true
        Type.CallableSchema {..} => true
        Type.CallableView {..} => true
        Type.CallableOrigin {..} => true
        Type.CallableResult {..} => true
        Type.CallableStage {..} => true
        Type.CallableWitnessResult {..} => true
        Type.OpaqueRepresentation {contract, ..} => Shared.with<Type, bool>(&contract, callableType) || Shared.with<Type, bool>(&contract, bareEffect)
        _ => false
      }
    })
}

fn sourceUnion(value: &Type) -> bool {
  if let Type.Union {members} = &value.* {
    let listed = Vector.asSlice<Shared<Type>>(&members)
    let mut at = usize.ZERO
    while at < listed.length {
      if !sourceUnionMember(&listed[at]) { return false }
      at = at + usize.ONE
    }
    return true
  }
  return false
}

// An owned return may inject its original transferred payload at the outer boundary only.
// Nested records and descriptor referents already have their complete source storage shape.
effect fn opaqueUnionArgument(nodes: &mut Vector<BodyNode>, node: BodyNodeId,
  expected: &Shared<Type>, producer: &DeclarationId) -> BodyNodeId
! OutOfMemoryError ? &mut Allocator {
  let actual = match move bodyExpressionType(Vector.asSlice<BodyNode>(&nodes.*), &node) {
    Option<Shared<Type>>.Some {value} => move value
    _ => { return node }
  }
  if Shared.with<Type, bool>(&actual, fn(ty: &Type) -> bool {
    return match &ty.* { Type.Union {..} => true _ => false }
  }) { return node }
  let ordered = match move run UnionProjection.members(expected) {
    Option<Vector<Shared<Type>>>.Some {value} => move value
    _ => { return node }
  }
  let members = Vector.asSlice<Shared<Type>>(&ordered)
  let mut selected = usize.MAX
  let mut at = usize.ZERO
  while at < members.length {
    let own = run Type.containsOpaque(&members[at], producer)
    let exact = run Type.equalsShared(&actual, &members[at])
    if !own && exact {
      selected = at
      break
    }
    at = at + usize.ONE
  }
  if selected == usize.MAX {
    at = usize.ZERO
    while at < members.length {
      let evidence = run Type.opaqueEvidence(&actual, &members[at], producer)
      if let Option<Vector<OpaqueEvidence>>.Some {..} = move evidence {
        selected = at
        break
      }
      at = at + usize.ONE
    }
  }
  if selected == usize.MAX { return node }
  let origin = Vector.asSlice<BodyNode>(&nodes.*)[node.index].origin
  let index = Vector.length<BodyNode>(&nodes.*)
  run Vector.append<BodyNode>(&mut nodes.*, BodyNode {origin: origin,
    kind: BodyNodeKind.Expression {ty: Shared.clone<Type>(expected),
      form: BodyExpression.UnionInject {tag: selected, value: node}},
  })
  return BodyNodeId {index: index}
}

effect fn unionArgument(nodes: &mut Vector<BodyNode>, node: BodyNodeId, expected: &Shared<Type>)
-> BodyNodeId ! OutOfMemoryError ? &mut Allocator {
  if !Shared.with<Type, bool>(expected, sourceUnion) { return node }
  let actual = match move bodyExpressionType(Vector.asSlice<BodyNode>(&nodes.*), &node) {
    Option<Shared<Type>>.Some {value} => value
    Option<Shared<Type>>.None => { return node }
  }
  let ordered = run UnionProjection.members(expected)
  let canonical = match move ordered {
    Option<Vector<Shared<Type>>>.Some {value} => value
    Option<Vector<Shared<Type>>>.None => { return node }
  }
  let members = Vector.asSlice<Shared<Type>>(&canonical)
  let mut at = usize.ZERO
  while at < members.length {
    if run Type.equalsShared(&members[at], &actual) {
      let origin = Vector.asSlice<BodyNode>(&nodes.*)[node.index].origin
      let index = Vector.length<BodyNode>(&nodes.*)
      run Vector.append<BodyNode>(&mut nodes.*, BodyNode {origin: origin,
        kind: BodyNodeKind.Expression {ty: Shared.clone<Type>(expected), form: BodyExpression.UnionInject {tag: at, value: node}},
      })
      return BodyNodeId {index: index}
    }
    at = at + usize.ONE
  }
  return node
}

// The access, nullability and written alignment an expected raw pointer accepts. `aligned` is
// false for the natural alignment requirement, which has no written `alignment`.
struct PointerExpectation {
  access: Access
  nullable: bool
  aligned: bool
  alignment: u64
}

impl Copy for PointerExpectation {}

fn pointerExpectation(value: &Type) -> Option<PointerExpectation> {
  if let Type.Pointer {access, nullable, alignment, ..} = &value.* {
    let mut expected = PointerExpectation {access: access, nullable: nullable, aligned: false, alignment: 0}
    if let Option<u64>.Some {value: written} = &alignment {
      expected.aligned = true
      expected.alignment = written
    }
    return Option.some<PointerExpectation>(expected)
  }
  return Option.none<PointerExpectation>()
}

// Whether an actual alignment requirement weakens to the expected one: any requirement weakens to
// `align(1)`, and a written alignment weakens to a smaller written one. Natural alignment is not
// compared numerically, so it weakens only to `align(1)`.
fn alignmentWeakens(actual: &Option<u64>, expected: PointerExpectation) -> bool {
  if !expected.aligned { return false }
  return match &actual.* {
    Option<u64>.Some {value} => value > expected.alignment
    Option<u64>.None => expected.alignment == 1
  }
}

// An immediate pointer conversion may remove mutation capability, add nullability and weaken
// alignment, preserving every other actual qualifier. Exact comparison of a copied transaction
// proves invariant pointee/extent and prior bindings; ordinary argument matching still owns the
// real transaction.
effect fn pointerArgument(
  nodes: &mut Vector<BodyNode>, node: BodyNodeId, parameter: &Shared<Type>,
  variables: &[Shared<DeclarationId>], bindings: &[Binding],
) -> BodyNodeId ! OutOfMemoryError ? &mut Allocator {
  let expectation = match move Shared.with<Type, Option<PointerExpectation>>(parameter, pointerExpectation) {
    Option<PointerExpectation>.Some {value} => value
    Option<PointerExpectation>.None => { return node }
  }
  let actual = match move bodyExpressionType(Vector.asSlice<BodyNode>(&nodes.*), &node) {
    Option<Shared<Type>>.Some {value} => run Type.copy(&value)
    Option<Shared<Type>>.None => { return node }
  }
  if let Type.Pointer {pointee, access, nullable, multiplicity, alignment} = move actual {
    let weakenAccess = access == Access.Mutable && expectation.access == Access.Shared
    let addNullability = !nullable && expectation.nullable
    let weakenAlignment = alignmentWeakens(&alignment, expectation)
    if !weakenAccess && !addNullability && !weakenAlignment { return node }
    let mut weakenedAccess = access
    if weakenAccess { weakenedAccess = Access.Shared }
    let mut weakenedAlignment = move alignment
    if weakenAlignment { weakenedAlignment = Option.some<u64>(expectation.alignment) }
    let weakened = run Shared.make<Type>(Type.Pointer {
      pointee: move pointee, access: weakenedAccess, nullable: nullable || addNullability,
      multiplicity: multiplicity, alignment: move weakenedAlignment,
    })
    let mut proof = Vector.make<Binding>()
    let mut at = usize.ZERO
    while at < bindings.length {
      run Vector.append<Binding>(&mut proof, Binding {
        declaration: Shared.clone<DeclarationId>(&bindings[at].declaration),
        ordinal: bindings[at].ordinal, value: Argument.copy(&bindings[at].value),
      })
      at = at + usize.ONE
    }
    let proved = run Type.unify(parameter, &weakened, variables, Comparison.Exact, &mut proof)
    match move proved {
      Unification.Unified => {
        let origin = Vector.asSlice<BodyNode>(&nodes.*)[node.index].origin
        let index = Vector.length<BodyNode>(&nodes.*)
        run Vector.append<BodyNode>(&mut nodes.*, BodyNode {origin: origin,
          kind: BodyNodeKind.Expression {ty: move weakened, form: BodyExpression.PointerWeaken {value: node}},
        })
        return BodyNodeId {index: index}
      }
      _ => ()
    }
  }
  return node
}

effect fn unionHasMember(unionType: &Shared<Type>, member: &Shared<Type>) -> bool
! OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while true {
    let candidate = Shared.with<Type, Option<Shared<Type>>>(unionType,
      fn(value: &Type) -> Option<Shared<Type>> {
        if let Type.Union {members} = &value.* {
          let values = Vector.asSlice<Shared<Type>>(&members)
          if at < values.length { return Option.some<Shared<Type>>(Shared.clone<Type>(&values[at])) }
        }
        return Option.none<Shared<Type>>()
      },
    )
    let selected = match move candidate {
      Option<Shared<Type>>.Some {value} => move value
      Option<Shared<Type>>.None => { break }
    }
    if run Type.equalsShared(&selected, member) {
      return true
    }
    at = at + usize.ONE
  }
  return false
}

fn pendingOriginRoot(value: &Type) -> bool {
  return match &value.* {
    Type.CallableOrigin {..} => true
    Type.CallableWitnessResult {..} => true
    Type.CallableResult {..} => true
    Type.CallableStage {..} => true
    Type.CallableView {representation, ..} => Shared.with<Type, bool>(&representation, pendingOriginRoot)
    _ => false
  }
}

effect fn deferredOriginComparison(first: &Shared<Type>, second: &Shared<Type>, declared: &[Constraint]) -> bool
! OutOfMemoryError ? &mut Allocator {
  if run Type.equalsShared(first, second) { return true }
  if !pendingCallableSelection(first) && !pendingCallableSelection(second) { return false }
  if Shared.with<Type, bool>(first, pendingOriginRoot) || Shared.with<Type, bool>(second, pendingOriginRoot) {
    let wanted = run valueCallableContract(first, declared)
    let offered = run valueCallableContract(second, declared)
    if let Option<Shared<Type>>.Some {value: promised} = move wanted {
      if let Option<Shared<Type>>.Some {value: actual} = move offered { return run Type.equalsShared(&promised, &actual) }
    }
    return false
  }
  let children = match move run Type.comparisonChildren(first, second) {
    Option<Vector<ComparisonChild>>.Some {value} => move value
    _ => { return false }
  }
  let pairs = Vector.asSlice<ComparisonChild>(&children)
  let mut at = usize.ZERO
  while at < pairs.length {
    if !run deferredOriginComparison(&pairs[at].left, &pairs[at].right, declared) { return false }
    at = at + usize.ONE
  }
  return true
}

effect fn originComparedType(resolver: &Resolver, value: &Shared<Type>) -> Shared<Type>
! OutOfMemoryError ? &mut Allocator {
  let phase = privateOriginPhase(resolver)
  if phase.phase != 3 { return Shared.clone<Type>(value) }
  let application = run selectedApplicationAt(resolver, phase.application)
  let bindings = run Application.bindings(&application)
  return run Type.applyBindings(value, Vector.asSlice<Binding>(&bindings), true)
}

effect fn matchCallArgument(
  resolver: &Resolver,
  module: &ModuleId,
  span: Span,
  parameter: &Shared<Type>,
  evidence: &Shared<Type>,
  variables: &[Shared<DeclarationId>],
  inferred: &mut Vector<Binding>,
  constraints: &[Constraint],
) -> Option<Shared<Rejection>> ! OutOfMemoryError ? &mut Allocator {
  let phase = privateOriginPhase(resolver)
  if phase.phase == 3 {
    let application = run selectedApplicationAt(resolver, phase.application)
    let applied = run Application.bindings(&application)
    let bindings = Vector.asSlice<Binding>(&applied)
    let assigned = Vector.asMutSlice<Binding>(&mut inferred.*)
    let mut at = usize.ZERO
    while at < assigned.length {
      let old = Argument.copy(&assigned[at].value)
      assigned[at].value = run Argument.applyBindings(&old, bindings, true)
      at = at + usize.ONE
    }
  }
  let wantedType = run originComparedType(resolver, parameter)
  let offeredType = run originComparedType(resolver, evidence)
  let matched = run Type.unify(&wantedType, &offeredType, variables, Comparison.Exact, &mut inferred.*)
  match move matched {
    Unification.Unified => {
      return Option.none<Shared<Rejection>>()
    }
    Unification.Distinct => {
      // A diverging operand has no value, so every parameter accepts it, as at an expected value.
      if Shared.with<Type, bool>(evidence, neverType) { return Option.none<Shared<Rejection>>() }
      if phase.phase == usize.ONE {
        // Earlier operands may have placed the pending recipe inside this inferred parameter.
        let pattern = run Type.applyBindings(parameter, Vector.asSlice<Binding>(&inferred.*), true)
        if (pendingCallableSelection(&pattern) || pendingCallableSelection(evidence))
          && run deferredOriginComparison(&pattern, evidence, constraints) { return Option.none<Shared<Rejection>>() }
      }
      // A source callable contract needs an exact representation binder before it can
      // accept a closure or section value. Deferred callable admission is a gap.
      if Shared.with<Type, bool>(parameter, fn(value: &Type) -> bool {
        return match &value.* { Type.Callable {..} => true _ => false }
      }) && Shared.with<Type, bool>(evidence, fn(value: &Type) -> bool {
        return match &value.* { Type.CallableSchema {..} => true Type.CallableValue {..} => true Type.CallableStage {..} => true _ => false }
      }) { return Option.some<Shared<Rejection>>(run reject(resolver, module, RejectionCode.Unsupported, span)) }
      // Closed-record unions are injected before matching; any other exact member injection is a
      // valid program whose representation is still deferred.
      if !Shared.with<Type, bool>(parameter, sourceUnion) && run unionHasMember(parameter, evidence) {
        return Option.some<Shared<Rejection>>(run reject(resolver, module,
          RejectionCode.UnionFormUnavailable, span))
      }
      return Option.some<Shared<Rejection>>(
        run reject(resolver, module, RejectionCode.TypeMismatch, span),
      )
    }
    Unification.Undetermined {at: undecided} => {
      drop undecided
      return Option.some<Shared<Rejection>>(
        run reject(resolver, module, RejectionCode.Unsupported, span),
      )
    }
  }
}

effect fn bodySpan(source: &SourceIndex, cursor: &AuthoredCursor, id: HirId) -> Span
! RevisionMismatch {
  if let Option<Span>.Some {value} = move SourceIndex.authoredSpan(source, cursor, id) {
    return value
  }
  fail RevisionMismatch {}
}

effect fn bodyArgument(source: &SourceIndex, cursor: &AuthoredCursor, arguments: CallArguments, at: usize) -> HirId
! RevisionMismatch {
  return match arguments {
    CallArguments.Written {range} => run bodyChild(source, cursor, range, at)
    CallArguments.Single {expression} => expression
    CallArguments.Piped {input, range} => {
      if at == usize.ZERO { return input }
      return run bodyChild(source, cursor, range, at - usize.ONE)
    }
  }
}

effect fn bodyChild(source: &SourceIndex, cursor: &AuthoredCursor, range: Range, at: usize) -> HirId
! RevisionMismatch {
  if let Option<HirId>.Some {value} = move SourceIndex.authoredChild(source, cursor, range, at) {
    return value
  }
  fail RevisionMismatch {}
}

// ASSEMBLY-001/002: one checked `Intrinsic.assembly` use writes literal metadata, and its lanes
// and metadata satisfy the selected target's machine contract.
effect fn assemblyAdmitted(resolver: &Resolver, cursor: &AuthoredCursor, nodes: &[BodyNode],
  arguments: &[BodyNodeId], result: &Shared<Type>) -> bool
! RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  if arguments.length != 7 { return false }
  let mut texts = Vector.make<Bytes>()
  let mut at = usize.ZERO
  while at < 4 {
    let mut literal = Option.none<HirId>()
    if let BodyNodeKind.Expression {form, ..} = &nodes[arguments[at].index].kind {
      if let BodyExpression.Text {literal: written} = &form { literal = Option.some<HirId>(written) }
    }
    let syntax = match move literal {
      Option<HirId>.Some {value} => value
      Option<HirId>.None => { return false }
    }
    let written = match run bodyNode(&resolver.source, cursor, syntax) {
      Node.TextLiteral {value} => run bodyText(&resolver.source, cursor, value)
      _ => { return false }
    }
    run Vector.append<Bytes>(&mut texts, move written)
    at = at + usize.ONE
  }
  let mut flags = Vector.make<bool>()
  while at < 6 {
    let mut flag = Option.none<bool>()
    if let BodyNodeKind.Expression {form, ..} = &nodes[arguments[at].index].kind {
      if let BodyExpression.Boolean {value} = &form { flag = Option.some<bool>(value) }
    }
    match move flag {
      Option<bool>.Some {value} => run Vector.append<bool>(&mut flags, value)
      Option<bool>.None => { return false }
    }
    at = at + usize.ONE
  }
  // The operand tuple is a literal: unit, or one positional tuple expression.
  let mut lanes = Vector.make<AssemblyLane>()
  let mut literalTuple = false
  if let BodyNodeKind.Expression {ty, form} = &nodes[arguments[6].index].kind {
    match &form {
      BodyExpression.Unit => { literalTuple = true }
      BodyExpression.Aggregate {..} => {
        literalTuple = true
        let count = Shared.with<Type, usize>(&ty, fn(value: &Type) -> usize {
          return match &value.* {
            Type.Anonymous {members, ..} => Vector.length<Shared<Type>>(&members)
            _ => usize.ZERO
          }
        })
        let mut member = usize.ZERO
        while member < count {
          let lane = Shared.with<Type, AssemblyLane>(&ty, fn(value: &Type) -> AssemblyLane {
            if let Type.Anonymous {members, ..} = &value.* {
              let listed = Vector.asSlice<Shared<Type>>(&members)
              return NativeAssembly.laneOf(&listed[member])
            }
            return AssemblyLane.Unavailable
          })
          run Vector.append<AssemblyLane>(&mut lanes, lane)
          member = member + usize.ONE
        }
      }
      _ => ()
    }
  }
  if !literalTuple { return false }
  let written = Vector.asSlice<Bytes>(&texts)
  let flagged = Vector.asSlice<bool>(&flags)
  return run NativeAssembly.admits(resolver.target.id(), Bytes.asSlice(&written[0]), Bytes.asSlice(&written[1]),
    Bytes.asSlice(&written[2]), Bytes.asSlice(&written[3]), flagged[0], flagged[1], NativeAssembly.laneOf(result),
    Vector.asSlice<AssemblyLane>(&lanes))
}

effect fn bodyText(source: &SourceIndex, cursor: &AuthoredCursor, symbol: Symbol) -> Bytes
! RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  if let Option<&[u8]>.Some {value} = move SourceIndex.authoredText(source, cursor, symbol) {
    return run Bytes.copy(value)
  }
  fail RevisionMismatch {}
}

// A two-segment written path such as `Status.Ready` in a member pattern.
effect fn bodyPathPair(source: &SourceIndex, cursor: &AuthoredCursor, path: HirId) -> Option<QualifiedBodyName>
! RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  if let Node.Path {segments} = run bodyNode(source, cursor, path) {
    if segments.length == 2 {
      let first = run bodyChild(source, cursor, segments, usize.ZERO)
      let second = run bodyChild(source, cursor, segments, usize.ONE)
      if let Node.Name {text: namespaceSymbol} = run bodyNode(source, cursor, first) {
        if let Node.Name {text: memberSymbol} = run bodyNode(source, cursor, second) {
          return Option.some<QualifiedBodyName>(QualifiedBodyName {
            namespace: run bodyText(source, cursor, namespaceSymbol),
            member: run bodyText(source, cursor, memberSymbol),
            subjectSpan: run bodySpan(source, cursor, first),
            application: Option.none<HirId>(),
          })
        }
      }
    }
  }
  return Option.none<QualifiedBodyName>()
}

effect fn bodyQualifiedName(source: &SourceIndex, cursor: &AuthoredCursor, callee: HirId) -> Option<
  QualifiedBodyName,
> ! RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  if let Node.FieldExpression {subject, field} = run bodyNode(source, cursor, callee) {
    if let Node.IdentifierExpression {name, binding} = run bodyNode(source, cursor, subject) {
      if !binding.present {
        if let Node.Name {text: namespaceSymbol} = run bodyNode(source, cursor, name) {
          if let Node.Name {text: memberSymbol} = run bodyNode(source, cursor, field) {
            return Option.some<QualifiedBodyName>(
              QualifiedBodyName {
                namespace: run bodyText(source, cursor, namespaceSymbol),
                member: run bodyText(source, cursor, memberSymbol),
                subjectSpan: run bodySpan(source, cursor, subject),
                application: Option.none<HirId>(),
              },
            )
          }
        }
      }
    }
  }
  // An applied qualifier such as `Make<i32>.make` parses as a field-free member selector.
  if let Node.MemberExpression {selector, fields} = run bodyNode(source, cursor, callee) {
    if fields.present { return Option.none<QualifiedBodyName>() }
    if let Node.MemberSelector {subject, member} = run bodyNode(source, cursor, selector) {
      if let Node.AppliedType {target, ..} = run bodyNode(source, cursor, subject) {
        if let Node.NamedType {path, hasMode, ..} = run bodyNode(source, cursor, target) {
          if !hasMode {
            if let Node.Path {segments} = run bodyNode(source, cursor, path) {
              if segments.length == usize.ONE {
                let first = run bodyChild(source, cursor, segments, usize.ZERO)
                if let Node.Name {text: namespaceSymbol} = run bodyNode(source, cursor, first) {
                  if let Node.Name {text: memberSymbol} = run bodyNode(source, cursor, member) {
                    return Option.some<QualifiedBodyName>(QualifiedBodyName {
                      namespace: run bodyText(source, cursor, namespaceSymbol),
                      member: run bodyText(source, cursor, memberSymbol),
                      subjectSpan: run bodySpan(source, cursor, subject),
                      application: Option.some<HirId>(subject),
                    })
                  }
                }
              }
            }
          }
        }
      }
    }
  }
  return Option.none<QualifiedBodyName>()
}

effect fn unsupportedBody(resolver: &Resolver, module: &ModuleId, span: Span) -> Result<
  PreparedBody,
  Shared<Rejection>,
> ! OutOfMemoryError ? &mut Allocator {
  return Result.failResult<PreparedBody, Shared<Rejection>>(
    run reject(&resolver.*, module, RejectionCode.Unsupported, span),
  )
}

fn functionHeaderContract(hir: &Module, header: HirId) -> Option<HirId> {
  if let Node.CallableContract {..} = Module.node(hir, header) { return Option.some<HirId>(header) }
  if let Node.FunctionHeader {contract, ..} = Module.node(hir, header) {
    return Option.some<HirId>(contract)
  }
  return Option.none<HirId>()
}

fn mutableParameter(hir: &Module, parameter: HirId) -> bool {
  if let Node.Parameter {mode, ..} = Module.node(hir, parameter) {
    return mode == ParameterMode.Mutable
  }
  return false
}

fn staticParameter(hir: &Module, parameter: HirId) -> bool {
  if let Node.Parameter {mode, ..} = Module.node(hir, parameter) {
    return mode == ParameterMode.Static
  }
  return false
}

// Value and mutable runtime parameters have storage identified by their written name.
fn valueParameterName(hir: &Module, parameter: HirId) -> Option<HirId> {
  if let Node.Parameter {name, mode, ..} = Module.node(hir, parameter) {
    if mode == ParameterMode.Value || mode == ParameterMode.Mutable {
      return Option.some<HirId>(name)
    }
  }
  return Option.none<HirId>()
}

fn collidesWithParameter(hir: &Module, locals: &Vector<BodyLocal>, name: HirId) -> bool {
  let earlier = Vector.asSlice<BodyLocal>(locals)
  let mut prior = usize.ZERO
  while prior < earlier.length {
    let earlierId = earlier[prior].origin.syntax
    if let Node.Parameter {name: earlierName, ..} = Module.node(hir, earlierId) {
      if sameBinderName(hir, name, earlierName) {
        return true
      }
    }
    prior = prior + usize.ONE
  }
  return false
}

fn callableBodyBlock(hir: &Module, local: HirId) -> Option<HirId> {
  if let Node.CallableExpression {body, ..} = Module.node(hir, local) {
    if let Node.Block {..} = Module.node(hir, body) { return Option.some<HirId>(body) }
    return Option.none<HirId>()
  }
  let body = match Module.node(hir, local) {
    Node.Declaration {body, ..} => body
    _ => {
      return Option.none<HirId>()
    }
  }
  let writtenBlock = match Module.node(hir, body) {
    Node.CallableBody {block} => block
    _ => {
      return Option.none<HirId>()
    }
  }
  if !writtenBlock.present {
    return Option.none<HirId>()
  }
  if let Node.Block {..} = Module.node(hir, writtenBlock.id) {
    return Option.some<HirId>(writtenBlock.id)
  }
  return Option.none<HirId>()
}

// Copy only the declaration-owned facts needed by the effectful checker. The source-index HIR
// loan ends with this preparation, so later semantic demands can borrow the resolver mutably.
effect fn prepareBody(
  resolver: &Resolver,
  module: &ModuleId,
  indexed: &IndexedSource,
  ordinal: usize,
  signature: &Shared<Result<Answer, NoRejection>>,
  parameterCount: usize,
  contractBody: bool,
  selectedBody: bool,
) -> Result<PreparedBody, Shared<Rejection>> ! OutOfMemoryError ? &mut Allocator {
  let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(indexed))
  if ordinal >= declarations.length {
    return Result.failResult<PreparedBody, Shared<Rejection>>(
      run reject(&resolver.*, module, RejectionCode.Unsupported, Span.make(usize.ZERO, usize.ZERO)),
    )
  }
  let declaration = &declarations[ordinal]
  let hir = IndexedSource.authored(indexed)
  let headerSpan = Module.span(hir, declaration.header)
  let mut staticBody = false
  let contractNode = match move functionHeaderContract(hir, declaration.header) {
    Option<HirId>.Some {value} => value
    Option<HirId>.None => {
      return run unsupportedBody(&resolver.*, module, headerSpan)
    }
  }
  let mut writtenParameters = Range.empty()
  match Module.node(hir, contractNode) {
    Node.CallableContract {parameters, isStatic, ..} => {
      staticBody = isStatic
      writtenParameters = parameters
    }
    _ => {
      return run unsupportedBody(&resolver.*, module, headerSpan)
    }
  }
  if writtenParameters.length != parameterCount {
    return run unsupportedBody(&resolver.*, module, headerSpan)
  }
  let mut locals = Vector.make<BodyLocal>()
  let mut abstractBody = contractBody
  let mut at = usize.ZERO
  while at < parameterCount {
    let parameterId = Module.child(hir, writtenParameters, at)
    let selected = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
      signature,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> {
        return signatureParameter(answer, at)
      },
    )
    let parameterType = match move selected {
      Option<Shared<Type>>.Some {value} => move value
      Option<Shared<Type>>.None => {
        return run unsupportedBody(&resolver.*, module, headerSpan)
      }
    }
    if !Shared.with<Type, bool>(&parameterType, scalarType) {
      abstractBody = true
    }
    // A selected body's static parameter has no storage: its reads are the selection's Embedded
    // values. Only an abstract body would need one, and no abstract body checks static work.
    if selectedBody && staticParameter(hir, parameterId) {
      at = at + usize.ONE
      continue
    }
    let name = match move valueParameterName(hir, parameterId) {
      Option<HirId>.Some {value} => value
      Option<HirId>.None => {
        if let Node.Parameter {mode, ..} = Module.node(hir, parameterId) {
          if mode == ParameterMode.Mutable {
            return Result.failResult<PreparedBody, Shared<Rejection>>(
              run reject(&resolver.*, module, RejectionCode.MutableParameterUnavailable, Module.span(hir, parameterId)),
            )
          }
        }
        return run unsupportedBody(&resolver.*, module, Module.span(hir, parameterId))
      }
    }
    if collidesWithParameter(hir, &locals, name) {
      return Result.failResult<PreparedBody, Shared<Rejection>>(
        run reject(&resolver.*, module, RejectionCode.Collision, Module.span(hir, name)),
      )
    }
    run Vector.append<BodyLocal>(
      &mut locals,
      BodyLocal {
        origin: BodyOrigin {syntax: parameterId, span: Module.span(hir, name)},
        ty: move parameterType,
        mutable: mutableParameter(hir, parameterId),
        meetDepth: Option.none<usize>(),
      },
    )
    at = at + usize.ONE
  }
  let block = match move callableBodyBlock(hir, declaration.local) {
    Option<HirId>.Some {value} => value
    Option<HirId>.None => {
      return run unsupportedBody(&resolver.*, module, headerSpan)
    }
  }
  return Result.succeed<PreparedBody, Shared<Rejection>>(
    PreparedBody {
      block: block,
      identity: run DeclarationId.copy(&declaration.identity),
      locals: move locals,
      contractBody: abstractBody,
      staticBody: staticBody,
    },
  )
}

effect fn checkBlock(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut Vector<Dependency>,
  module: &ModuleId,
  cursor: &AuthoredCursor,
  caller: &DeclarationId,
  locals: &mut Vector<BodyLocal>,
  annotations: &[ResolvedAnnotation],
  calls: &[ResolvedCall],
  nodes: &mut Vector<BodyNode>,
  signatures: &mut Vector<SignatureDependency>,
  requiredBodies: &mut Vector<DeclarationId>,
  block: HirId,
  resultType: &Shared<Type>,
  constraints: &[Constraint],
  contractBody: bool,
  staticBody: bool,
  loopDepth: usize,
  unsafeAllowed: bool,
) -> Result<CheckedControl, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  if let Node.Block {statements: written} = run bodyNode(&resolver.source, cursor, block) {
    let mut bindings = Vector.make<Symbol>()
    let mut statements = Vector.make<BodyNodeId>()
    let checked = run checkStatements(
      &mut resolver.*,
      &mut owner.*,
      &mut request.*,
      &mut dependencies.*,
      module,
      cursor,
      caller,
      &mut locals.*,
      &mut bindings,
      annotations,
      calls,
      &mut nodes.*,
      &mut signatures.*,
      &mut requiredBodies.*,
      &mut statements,
      written,
      resultType,
      constraints,
      contractBody,
      staticBody,
      loopDepth,
      unsafeAllowed,
    )
    let canComplete = match move checked {
      Result<bool, Shared<Rejection>>.Success {value} => value
      Result<bool, Shared<Rejection>>.Failure {error} => {
        return Result.failResult<CheckedControl, Shared<Rejection>>(move error)
      }
    }
    let node = BodyNodeId {index: Vector.length<BodyNode>(&nodes.*)}
    run Vector.append<BodyNode>(
      &mut nodes.*,
      BodyNode {
        origin: BodyOrigin {syntax: block, span: run bodySpan(&resolver.source, cursor, block)},
        kind: BodyNodeKind.Block {statements: move statements, canComplete: canComplete},
      },
    )
    return Result.succeed<CheckedControl, Shared<Rejection>>(
      CheckedControl {node: node, canComplete: canComplete},
    )
  }
  return Result.failResult<CheckedControl, Shared<Rejection>>(
    run reject(
      &resolver.*,
      module,
      RejectionCode.Unsupported,
      run bodySpan(&resolver.source, cursor, block),
    ),
  )
}

effect fn checkConditional(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut Vector<Dependency>,
  module: &ModuleId,
  cursor: &AuthoredCursor,
  caller: &DeclarationId,
  locals: &mut Vector<BodyLocal>,
  annotations: &[ResolvedAnnotation],
  calls: &[ResolvedCall],
  nodes: &mut Vector<BodyNode>,
  signatures: &mut Vector<SignatureDependency>,
  requiredBodies: &mut Vector<DeclarationId>,
  statement: HirId,
  resultType: &Shared<Type>,
  constraints: &[Constraint],
  contractBody: bool,
  staticBody: bool,
  loopDepth: usize,
  unsafeAllowed: bool,
) -> Result<CheckedControl, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  if let Node.ConditionalStatement {condition, thenBranch, elseBranch} = run bodyNode(
    &resolver.source,
    cursor,
    statement,
  ) {
    let checkedCondition = run checkStatementExpression(
      &mut resolver.*,
      &mut owner.*,
      &mut request.*,
      &mut dependencies.*,
      module,
      cursor,
      caller,
      &mut locals.*,
      annotations,
      resultType,
      loopDepth,
      calls,
      &mut nodes.*,
      &mut signatures.*,
      &mut requiredBodies.*,
      condition,
      &Option.none<Shared<Type>>(),
      constraints,
      contractBody,
      staticBody,
      unsafeAllowed, false,
    )
    let conditionNode = match move checkedCondition {
      Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
      Result<BodyNodeId, Shared<Rejection>>.Failure {error} => {
        return Result.failResult<CheckedControl, Shared<Rejection>>(move error)
      }
    }
    let boolType = run primitiveType(b"bool")
    let conditionType = match & Vector.asSlice<BodyNode>(&nodes.*)[conditionNode.index].kind {
      BodyNodeKind.Expression {ty, ..} => Shared.clone<Type>(&ty)
      _ => {
        return Result.failResult<CheckedControl, Shared<Rejection>>(
          run reject(
            &resolver.*,
            module,
            RejectionCode.Unsupported,
            run bodySpan(&resolver.source, cursor, condition),
          ),
        )
      }
    }
    if !run Type.equalsShared(&conditionType, &boolType) {
      return Result.failResult<CheckedControl, Shared<Rejection>>(
        run reject(
          &resolver.*,
          module,
          RejectionCode.ConditionNotBool,
          run bodySpan(&resolver.source, cursor, condition),
        ),
      )
    }
    let checkedThen = run checkBlock(
      &mut resolver.*,
      &mut owner.*,
      &mut request.*,
      &mut dependencies.*,
      module,
      cursor,
      caller,
      &mut locals.*,
      annotations,
      calls,
      &mut nodes.*,
      &mut signatures.*,
      &mut requiredBodies.*,
      thenBranch,
      resultType,
      constraints,
      contractBody,
      staticBody,
      loopDepth,
      unsafeAllowed,
    )
    let thenControl = match move checkedThen {
      Result<CheckedControl, Shared<Rejection>>.Success {value} => value
      Result<CheckedControl, Shared<Rejection>>.Failure {error} => {
        return Result.failResult<CheckedControl, Shared<Rejection>>(move error)
      }
    }
    let mut checkedElse = Option.none<BodyNodeId>()
    let mut elseCanComplete = true
    if elseBranch.present {
      let otherwise = run checkControl(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
        module, cursor, caller, &mut locals.*, annotations, calls, &mut nodes.*, &mut signatures.*,
        &mut requiredBodies.*, elseBranch.id, resultType, constraints, contractBody, staticBody, loopDepth, unsafeAllowed)
      match move otherwise {
        Result<CheckedControl, Shared<Rejection>>.Success {value} => {
          checkedElse = Option.some<BodyNodeId>(value.node)
          elseCanComplete = value.canComplete
        }
        Result<CheckedControl, Shared<Rejection>>.Failure {error} => {
          return Result.failResult<CheckedControl, Shared<Rejection>>(move error)
        }
      }
    }
    let canComplete = thenControl.canComplete || elseCanComplete
    let node = BodyNodeId {index: Vector.length<BodyNode>(&nodes.*)}
    run Vector.append<BodyNode>(
      &mut nodes.*,
      BodyNode {
        origin: BodyOrigin {
          syntax: statement,
          span: run bodySpan(&resolver.source, cursor, statement),
        },
        kind: BodyNodeKind.Branch {
          condition: conditionNode,
          thenBranch: thenControl.node,
          elseBranch: move checkedElse,
          canComplete: canComplete,
        },
      },
    )
    return Result.succeed<CheckedControl, Shared<Rejection>>(
      CheckedControl {node: node, canComplete: canComplete},
    )
  }
  return Result.failResult<CheckedControl, Shared<Rejection>>(
    run reject(
      &resolver.*,
      module,
      RejectionCode.Unsupported,
      run bodySpan(&resolver.source, cursor, statement),
    ),
  )
}

// One statement-level control body: a block, or an `if` / `if let` reached through `else`.
effect fn checkControl(
  resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>, request: &mut Request,
  dependencies: &mut Vector<Dependency>, module: &ModuleId, cursor: &AuthoredCursor, caller: &DeclarationId,
  locals: &mut Vector<BodyLocal>, annotations: &[ResolvedAnnotation], calls: &[ResolvedCall],
  nodes: &mut Vector<BodyNode>, signatures: &mut Vector<SignatureDependency>,
  requiredBodies: &mut Vector<DeclarationId>, statement: HirId, resultType: &Shared<Type>,
  constraints: &[Constraint], contractBody: bool, staticBody: bool, loopDepth: usize, unsafeAllowed: bool,
) -> Result<CheckedControl, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  return match run bodyNode(&resolver.source, cursor, statement) {
    Node.Block {..} => run checkBlock(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
      module, cursor, caller, &mut locals.*, annotations, calls, &mut nodes.*, &mut signatures.*,
      &mut requiredBodies.*, statement, resultType, constraints, contractBody, staticBody, loopDepth, unsafeAllowed)
    Node.ConditionalStatement {..} => run checkConditional(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
      module, cursor, caller, &mut locals.*, annotations, calls, &mut nodes.*, &mut signatures.*,
      &mut requiredBodies.*, statement, resultType, constraints, contractBody, staticBody, loopDepth, unsafeAllowed)
    Node.PatternConditionalStatement {pattern, subject, thenBranch, elseBranch} => run checkPatternStatement(
      &mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module, cursor, caller, &mut locals.*,
      annotations, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*, statement, subject,
      MatchArms.Conditional {pattern: pattern, thenBranch: thenBranch, elseBranch: elseBranch},
      resultType, constraints, contractBody, staticBody, loopDepth, unsafeAllowed)
    _ => Result.failResult<CheckedControl, Shared<Rejection>>(
      run reject(&resolver.*, module, RejectionCode.Unsupported, run bodySpan(&resolver.source, cursor, statement)),
    )
  }
}

// `if let P = e` and `let P = e` check as a statement-position match over `e`, whose written
// syntax chooses the access: `&e` shares, `&mut e` borrows exclusively, `move e` consumes and a
// bare `e` reads one Copy value (PATT-002).
effect fn checkPatternStatement(
  resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>, request: &mut Request,
  dependencies: &mut Vector<Dependency>, module: &ModuleId, cursor: &AuthoredCursor, caller: &DeclarationId,
  locals: &mut Vector<BodyLocal>, annotations: &[ResolvedAnnotation], calls: &[ResolvedCall],
  nodes: &mut Vector<BodyNode>, signatures: &mut Vector<SignatureDependency>,
  requiredBodies: &mut Vector<DeclarationId>, statement: HirId, subject: HirId, arms: MatchArms,
  resultType: &Shared<Type>, constraints: &[Constraint], contractBody: bool, staticBody: bool,
  loopDepth: usize, unsafeAllowed: bool,
) -> Result<CheckedControl, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let span = run bodySpan(&resolver.source, cursor, statement)
  if staticBody {
    return Result.failResult<CheckedControl, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.Unsupported, span))
  }
  let mut access = MatchAccess.Default
  let mut operand = subject
  match run bodyNode(&resolver.source, cursor, subject) {
    Node.BorrowExpression {access: borrowed, operand: borrowedOperand} => {
      access = MatchAccess.Shared
      if borrowed == Access.Mutable { access = MatchAccess.Mutable }
      operand = borrowedOperand
    }
    Node.MoveExpression {operand: movedOperand} => {
      access = MatchAccess.Move
      operand = movedOperand
    }
    _ => ()
  }
  let mut statementScope = StatementScope {locals: &mut locals.*, annotations: annotations, resultType: resultType, loopDepth: loopDepth}
  let checkedSubject = run checkExpression(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module,
    cursor, caller, &mut statementScope, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*,
    operand, &Option.none<Shared<Type>>(), constraints, contractBody, false, unsafeAllowed)
  let subjectNode = match move checkedSubject {
    Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
    Result<BodyNodeId, Shared<Rejection>>.Failure {error} => { return Result.failResult<CheckedControl, Shared<Rejection>>(move error) }
  }
  let subjectType = match move bodyExpressionType(Vector.asSlice<BodyNode>(&nodes.*), &subjectNode) {
    Option<Shared<Type>>.Some {value} => value
    Option<Shared<Type>>.None => {
      return Result.failResult<CheckedControl, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.Unsupported, span))
    }
  }
  let checked = run checkRecordMatch(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module,
    cursor, caller, &mut statementScope, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*,
    statement, subjectNode, &subjectType, access, arms, &Option.none<Shared<Type>>(), constraints, contractBody,
    unsafeAllowed, span)
  let node = match move checked {
    Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
    Result<BodyNodeId, Shared<Rejection>>.Failure {error} => { return Result.failResult<CheckedControl, Shared<Rejection>>(move error) }
  }
  let diverges = match &Vector.asSlice<BodyNode>(&nodes.*)[node.index].kind {
    BodyNodeKind.Expression {ty, ..} => Shared.with<Type, bool>(&ty, neverType)
    _ => false
  }
  return Result.succeed<CheckedControl, Shared<Rejection>>(CheckedControl {node: node, canComplete: !diverges})
}

struct BodyFacts {
  annotations: Vector<ResolvedAnnotation>
  calls: Vector<ResolvedCall>
}

// Lexical premises come from the same ordinary signature that owns the body's type parameters.
// A header-only demand records the dependency without checking any runtime callee body.
effect fn bodySignatureConstraints(
  resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, moduleOrdinal: usize, declaration: usize,
) -> Result<Vector<Constraint>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let mut constraints = Vector.make<Constraint>()
  // An `effect {}` block declares no bounds; its signature is derived from the body being checked.
  let module = run resolvedModule(&resolver.*, moduleOrdinal)
  if run effectBlockHeader(&mut resolver.*, &module, declaration) {
    return Result.succeed<Vector<Constraint>, Shared<Rejection>>(move constraints)
  }
  let signature = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, Key {
    family: Family.Signature, module: moduleOrdinal, name: usize.ZERO,
    declaration: declaration, member: usize.ZERO, external: false,
  }, Span.make(usize.ZERO, usize.ZERO))
  let rejected = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(&signature, answerRejection)
  if let Option<Shared<Rejection>>.Some {value} = move rejected {
    return Result.failResult<Vector<Constraint>, Shared<Rejection>>(move value)
  }
  let count = Shared.with<Result<Answer, NoRejection>, usize>(&signature, signatureConstraintCount)
  let mut at = usize.ZERO
  while at < count {
    let selected = Shared.with<Result<Answer, NoRejection>, Option<Constraint>>(&signature,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Constraint> { return signatureConstraint(answer, at) })
    if let Option<Constraint>.Some {value} = move selected { run Vector.append<Constraint>(&mut constraints, move value) }
    at = at + usize.ONE
  }
  return Result.succeed<Vector<Constraint>, Shared<Rejection>>(move constraints)
}

// Prepare ordinary facts only for syntax reached by the enclosing body or selected static arm.
effect fn resolveBodyFacts(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  module: &ModuleId,
  moduleOrdinal: usize,
  declaration: usize,
  annotationIds: &Vector<HirId>,
  writtenCalls: &Vector<CallSyntax>,
) -> Result<BodyFacts, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let mut annotations = Vector.make<ResolvedAnnotation>()
  let scope = run bodyScope(&mut resolver.*, &mut owner.*, &mut dependencies.*, moduleOrdinal, module, declaration)
  let scoped = match move scope {
    Result<BodyScope, Shared<Rejection>>.Success {value} => move value
    Result<BodyScope, Shared<Rejection>>.Failure {error} => { return Result.failResult<BodyFacts, Shared<Rejection>>(move error) }
  }
  let BodyScope {binders, ..} = move scoped
  let constraints = match move run bodySignatureConstraints(&mut resolver.*, &mut owner.*, &mut dependencies.*, moduleOrdinal, declaration) {
    Result<Vector<Constraint>, Shared<Rejection>>.Success {value} => value
    Result<Vector<Constraint>, Shared<Rejection>>.Failure {error} => { return Result.failResult<BodyFacts, Shared<Rejection>>(move error) }
  }
  // LIFE-003: an omitted lifetime in a body annotation is inferred from the value it describes.
  let declared = run declarationAt(&mut resolver.*, module, declaration)
  let mut elidedOwner = Option.none<DeclarationId>()
  if let Option<DeclarationId>.Some {value: caller} = &declared {
    elidedOwner = Option.some<DeclarationId>(run elidedLifetimeOwner(&caller))
  }
  let mut bodyElision = LifetimeElision {
    owner: move elidedOwner,
    nextOrdinal: usize.ZERO,
    output: false,
    resultDefault: Option.none<Shared<Lifetime>>(),
    generated: Vector.make<Shared<Lifetime>>(),
    invocation: false,
    nested: false,
    renumber: Vector.make<usize>(),
    staticEnvironment: false,
    supplied: Option.none<Vector<Argument>>(),
    assumptions: Option.some<Vector<Constraint>>(run copyConstraints(Vector.asSlice<Constraint>(&constraints))),
  }
  let writtenAnnotations = Vector.asSlice<HirId>(annotationIds)
  let mut annotationAt = usize.ZERO
  while annotationAt < writtenAnnotations.length {
    let id = writtenAnnotations[annotationAt]
    let result = run resolveType(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies.*,
      moduleOrdinal,
      id,
      Vector.asSlice<Binder>(&binders),
      &mut bodyElision,
    )
    run Vector.append<ResolvedAnnotation>(
      &mut annotations,
      ResolvedAnnotation {id: id, result: move result},
    )
    annotationAt = annotationAt + usize.ONE
  }
  let mut resolvedCalls = Vector.make<ResolvedCall>()
  let callSyntax = Vector.asSlice<CallSyntax>(writtenCalls)
  let mut callAt = usize.ZERO
  while callAt < callSyntax.length {
    let result = run callTarget(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies.*,
      module,
      moduleOrdinal,
      &callSyntax[callAt],
      Vector.asSlice<Binder>(&binders),
      Vector.asSlice<Constraint>(&constraints),
    )
    run Vector.append<ResolvedCall>(
      &mut resolvedCalls,
      ResolvedCall {id: callSyntax[callAt].id, result: move result},
    )
    callAt = callAt + usize.ONE
  }
  return Result.succeed<BodyFacts, Shared<Rejection>>(
    BodyFacts {annotations: move annotations, calls: move resolvedCalls},
  )
}

// The selected arm's freshly resolved facts keep the enclosing selection's static facts.
effect fn carrySelectionFacts(calls: &[ResolvedCall], output: &mut Vector<ResolvedCall>) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < calls.length {
    let fact = selectedFact(calls, calls[at].id)
    if let Option<SelectionFact>.Some {value} = move fact {
      if let Result<ResolvedTarget, Shared<Rejection>>.Success {value: ResolvedTarget.Selected {..}} = &calls[at].result {
        run Vector.append<ResolvedCall>(&mut output.*, ResolvedCall {
          id: calls[at].id,
          result: Result.succeed<ResolvedTarget, Shared<Rejection>>(ResolvedTarget.Selected {fact: move value}),
        })
      }
    }
    at = at + usize.ONE
  }
  return ()
}

effect fn checkStaticConditional(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut Vector<Dependency>,
  module: &ModuleId,
  cursor: &AuthoredCursor,
  caller: &DeclarationId,
  locals: &mut Vector<BodyLocal>,
  annotations: &[ResolvedAnnotation],
  calls: &[ResolvedCall],
  nodes: &mut Vector<BodyNode>,
  signatures: &mut Vector<SignatureDependency>,
  requiredBodies: &mut Vector<DeclarationId>,
  statement: HirId,
  resultType: &Shared<Type>,
  constraints: &[Constraint],
  contractBody: bool,
  staticBody: bool,
  loopDepth: usize,
  unsafeAllowed: bool,
) -> Result<CheckedControl, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  if let Node.StaticConditionalStatement {condition, thenBranch, elseBranch} = run bodyNode(
    &resolver.source, cursor, statement,
  ) {
    // A runtime body reads the decision its selection pass evaluated; an unselected runtime body
    // has no decision and cannot check static control. A static function's body is wholly
    // compile-time, so its condition is evaluated here. Either way the inactive arm contributes
    // no body facts or diagnostics.
    let mut chooseThen = false
    if staticBody {
      let evaluated = run staticExpression(
        &mut resolver.*, &mut owner.*, &mut dependencies.*,
        module, Option.none<usize>(), condition, StaticRootExpectation.Boolean,
      )
      let value = match move evaluated {
        Result<Shared<StaticData>, Shared<Rejection>>.Success {value} => value
        Result<Shared<StaticData>, Shared<Rejection>>.Failure {error} => {
          return Result.failResult<CheckedControl, Shared<Rejection>>(move error)
        }
      }
      let flag = Shared.with<StaticData, Option<bool>>(&value, fn(fact: &StaticData) -> Option<bool> {
        return match &fact.* {
          StaticData.Boolean {value: answer} => Option.some<bool>(answer)
          _ => Option.none<bool>()
        }
      })
      chooseThen = match move flag {
        Option<bool>.Some {value: answer} => answer
        Option<bool>.None => {
          return Result.failResult<CheckedControl, Shared<Rejection>>(
            run reject(&resolver.*, module, RejectionCode.ConditionNotBool, run bodySpan(&resolver.source, cursor, condition)),
          )
        }
      }
    } else {
      let decision = selectedFact(calls, condition)
      chooseThen = match move decision {
        Option<SelectionFact>.Some {value: SelectionFact.Condition {selected: chosen}} => chosen
        _ => {
          return Result.failResult<CheckedControl, Shared<Rejection>>(
            run reject(&resolver.*, module, RejectionCode.Unsupported, run bodySpan(&resolver.source, cursor, condition)),
          )
        }
      }
    }
    let mut selectedArm = HirRef.absent()
    if chooseThen { selectedArm = HirRef.of(thenBranch) } else { selectedArm = elseBranch }
    let mut annotationIds = Vector.make<HirId>()
    let mut writtenCalls = Vector.make<CallSyntax>()
    let mut declaration = usize.MAX
    if let Option<&IndexedSource>.Some {value: indexed} = move SourceIndex.sourceAtCursor(&resolver.source, cursor) {
      let hir = IndexedSource.authored(indexed)
      let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(indexed))
      let mut at = usize.ZERO
      while at < declarations.length {
        if DeclarationId.equals(&declarations[at].identity, caller) { declaration = at }
        at = at + usize.ONE
      }
      if selectedArm.present {
        if let Node.Block {statements} = Module.node(hir, selectedArm.id) {
          run collectBodySyntax(hir, statements, &mut annotationIds, &mut writtenCalls)
        }
      }
    }
    if declaration == usize.MAX { fail InvalidModulePath {} }
    let moduleOrdinal = knownModuleOrdinal(&resolver.*, module)
    let resolved = run resolveBodyFacts(
      &mut resolver.*, &mut owner.*, &mut dependencies.*, module,
      moduleOrdinal, declaration, &annotationIds, &writtenCalls,
    )
    let selectedFacts = match move resolved {
      Result<BodyFacts, Shared<Rejection>>.Success {value: preparedFacts} => move preparedFacts
      Result<BodyFacts, Shared<Rejection>>.Failure {error} => {
        return Result.failResult<CheckedControl, Shared<Rejection>>(move error)
      }
    }
    let BodyFacts {annotations: selectedAnnotations, calls: armFacts} = move selectedFacts
    let mut selectedCalls = move armFacts
    run carrySelectionFacts(calls, &mut selectedCalls)
    let mut retained = Vector.make<BodyNodeId>()
    let mut canComplete = true
    if selectedArm.present {
      let checked = match run bodyNode(&resolver.source, cursor, selectedArm.id) {
        Node.Block {..} => run checkBlock(
          &mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
          module, cursor, caller, &mut locals.*, Vector.asSlice<ResolvedAnnotation>(&selectedAnnotations),
          Vector.asSlice<ResolvedCall>(&selectedCalls), &mut nodes.*,
          &mut signatures.*, &mut requiredBodies.*, selectedArm.id, resultType,
          constraints, contractBody, staticBody, loopDepth, unsafeAllowed,
        )
        Node.StaticConditionalStatement {..} => run checkStaticConditional(
          &mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
          module, cursor, caller, &mut locals.*, annotations, calls, &mut nodes.*,
          &mut signatures.*, &mut requiredBodies.*, selectedArm.id, resultType,
          constraints, contractBody, staticBody, loopDepth, unsafeAllowed,
        )
        _ => Result.failResult<CheckedControl, Shared<Rejection>>(
          run reject(
            &resolver.*, module, RejectionCode.Unsupported,
            run bodySpan(&resolver.source, cursor, selectedArm.id),
          ),
        )
      }
      match move checked {
        Result<CheckedControl, Shared<Rejection>>.Success {value: control} => {
          run Vector.append<BodyNodeId>(&mut retained, control.node)
          canComplete = control.canComplete
        }
        Result<CheckedControl, Shared<Rejection>>.Failure {error} => {
          return Result.failResult<CheckedControl, Shared<Rejection>>(move error)
        }
      }
    }
    let node = BodyNodeId {index: Vector.length<BodyNode>(&nodes.*)}
    run Vector.append<BodyNode>(
      &mut nodes.*,
      BodyNode {
        origin: BodyOrigin {syntax: statement, span: run bodySpan(&resolver.source, cursor, statement)},
        kind: BodyNodeKind.Block {statements: move retained, canComplete: canComplete},
      },
    )
    return Result.succeed<CheckedControl, Shared<Rejection>>(
      CheckedControl {node: node, canComplete: canComplete},
    )
  }
  return Result.failResult<CheckedControl, Shared<Rejection>>(
    run reject(
      &resolver.*, module, RejectionCode.Unsupported,
      run bodySpan(&resolver.source, cursor, statement),
    ),
  )
}

/// Whether an earlier binding in the block already uses this interned name.
fn bindingNameCollides(known: &[Symbol], name: usize) -> bool {
  let mut prior = usize.ZERO
  while prior < known.length {
    if name == known[prior].index {
      return true
    }
    prior = prior + usize.ONE
  }
  return false
}

fn indexOfAnnotation(annotations: &[ResolvedAnnotation], id: HirId) -> Option<usize> {
  let mut selected = usize.ZERO
  while selected < annotations.length {
    if annotations[selected].id.index == id.index {
      return Option.some<usize>(selected)
    }
    selected = selected + usize.ONE
  }
  return Option.none<usize>()
}

/// The type written on a binding, rejected when a runtime binding names a non-runtime type.
effect fn bindingAnnotationType(
  resolver: &Resolver,
  module: &ModuleId,
  cursor: &AuthoredCursor,
  annotations: &[ResolvedAnnotation],
  annotation: HirId,
  contractBody: bool,
  staticBody: bool,
) -> Result<Shared<Type>, Shared<Rejection>> ! RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let selected = match move indexOfAnnotation(annotations, annotation) {
    Option<usize>.Some {value} => value
    Option<usize>.None => {
      return Result.failResult<Shared<Type>, Shared<Rejection>>(
        run reject(
          resolver,
          module,
          RejectionCode.Unsupported,
          run bodySpan(&resolver.source, cursor, annotation),
        ),
      )
    }
  }
  match & annotations[selected].result {
    Result<Shared<Type>, Shared<Rejection>>.Success {value} => {
      // A declared Effect contract stores the exact Effect its initializer admits (EFF-013).
      if !contractBody && !staticBody && !Shared.with<Type, bool>(&value, runtimeType) && !Shared.with<Type, bool>(&value, bareEffect) {
        return Result.failResult<Shared<Type>, Shared<Rejection>>(
          run reject(
            resolver,
            module,
            RejectionCode.Unsupported,
            run bodySpan(&resolver.source, cursor, annotation),
          ),
        )
      }
      return Result.succeed<Shared<Type>, Shared<Rejection>>(Shared.clone<Type>(&value))
    }
    Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
      return Result.failResult<Shared<Type>, Shared<Rejection>>(Shared.clone<Rejection>(&error))
    }
  }
}

/// The mutable local an identifier assignment target is bound to, if any.
fn mutableLocalOf(resolver: &Resolver, locals: &[BodyLocal], binding: HirRef) -> Option<BodyLocalId> {
  if !binding.present {
    return Option.none<BodyLocalId>()
  }
  let mut localAt = usize.ZERO
  while localAt < locals.length {
    if locals[localAt].origin.syntax.index == binding.id.index && locals[localAt].mutable && !completedOccurrenceContains(resolver, localAt, true) {
      return Option.some<BodyLocalId>(BodyLocalId {index: localAt})
    }
    localAt = localAt + usize.ONE
  }
  return Option.none<BodyLocalId>()
}

// The local a whole-local assignment target names; none for a field, element or other place.
fn assignedLocal(nodes: &[BodyNode], destination: BodyNodeId) -> Option<BodyLocalId> {
  if let BodyNodeKind.Expression {form: BodyExpression.Local {local}, ..} = &nodes[destination.index].kind {
    return Option.some<BodyLocalId>(local)
  }
  return Option.none<BodyLocalId>()
}

// Admits a value assigned to a local whose type retains a region (LIFE-003). An unannotated
// reassignable binding assigned at its own loop depth meets its regions with the value's: the
// local, its assignment target and every later use take the meet, which both the earlier value
// and the new one outlive. An assignment inside a deeper loop cannot widen the binding, because
// uses earlier in that loop were checked at its previous type, so the value meets the binding's
// type as it stands. Either way a caller-local region that would have to outlive a region the
// body does not own is a mismatch rather than a retained relation.
effect fn assignLocalValue(
  resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>, dependencies: &mut Vector<Dependency>,
  module: &ModuleId, caller: &DeclarationId, constraints: &[Constraint], locals: &mut Vector<BodyLocal>,
  nodes: &mut Vector<BodyNode>, destination: BodyNodeId, node: BodyNodeId, loopDepth: usize, span: Span,
) -> Result<BodyNodeId, Shared<Rejection>> ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let local = match move assignedLocal(Vector.asSlice<BodyNode>(&nodes.*), destination) {
    Option<BodyLocalId>.Some {value} => value
    Option<BodyLocalId>.None => { return run bodyRejection(&resolver.*, module, RejectionCode.TypeMismatch, span) }
  }
  let listed = Vector.asSlice<BodyLocal>(&locals.*)
  let declared = Shared.clone<Type>(&listed[local.index].ty)
  let origin = listed[local.index].origin
  let mutable = listed[local.index].mutable
  let mut meets = false
  if let Option<usize>.Some {value: depth} = &listed[local.index].meetDepth { meets = depth == loopDepth }
  if meets {
    let offeredType = bodyExpressionType(Vector.asSlice<BodyNode>(&nodes.*), &node)
    if let Option<Shared<Type>>.Some {value: offered} = move offeredType {
      let meetType = run meetRegions(&declared, &offered)
      if let Option<Shared<Type>>.Some {value: met} = move meetType {
        let mut deferred = Vector.make<RegionPair>()
        let mut active = Vector.make<DeclarationId>()
        let admitted = run admitsRegions(&mut resolver.*, &mut owner.*, &mut dependencies.*, &declared, &met, caller,
          constraints, true, &mut deferred, &mut active, span)
        if admitted && Vector.length<RegionPair>(&deferred) == usize.ZERO {
          let wanted = Option.some<Shared<Type>>(Shared.clone<Type>(&met))
          let value = run admitExpectedValue(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, caller,
            constraints, &mut nodes.*, node, &wanted, span, false)
          if let Result<BodyNodeId, Shared<Rejection>>.Success {value: accepted} = move value {
            Vector.set<BodyLocal>(&mut locals.*, local.index, BodyLocal {origin: origin, ty: Shared.clone<Type>(&met),
              mutable: mutable, meetDepth: Option.some<usize>(loopDepth)})
            run retypeNode(&mut nodes.*, destination, move met)
            return Result.succeed<BodyNodeId, Shared<Rejection>>(accepted)
          }
        }
      }
    }
  }
  let wanted = Option.some<Shared<Type>>(move declared)
  return run admitExpectedValue(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, caller, constraints,
    &mut nodes.*, node, &wanted, span, false)
}

/// Checks `target = value` in a runtime body, returning the new place-assignment node.
effect fn checkPlaceAssignment(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut Vector<Dependency>,
  module: &ModuleId,
  cursor: &AuthoredCursor,
  caller: &DeclarationId,
  locals: &mut Vector<BodyLocal>,
  annotations: &[ResolvedAnnotation],
  resultType: &Shared<Type>,
  loopDepth: usize,
  calls: &[ResolvedCall],
  nodes: &mut Vector<BodyNode>,
  signatures: &mut Vector<SignatureDependency>,
  requiredBodies: &mut Vector<DeclarationId>,
  statement: HirId,
  span: Span,
  target: HirId,
  value: HirId,
  constraints: &[Constraint],
  contractBody: bool,
  unsafeAllowed: bool,
) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let checked = run checkStatementExpression(
    &mut resolver.*,
    &mut owner.*,
    &mut request.*,
    &mut dependencies.*,
    module,
    cursor,
    caller,
    &mut locals.*,
    annotations,
    resultType,
    loopDepth,
    calls,
    &mut nodes.*,
    &mut signatures.*,
    &mut requiredBodies.*,
    target,
    &Option.none<Shared<Type>>(),
    constraints,
    contractBody,
    false,
    unsafeAllowed, false,
  )
  let destination = match move checked {
    Result<BodyNodeId, Shared<Rejection>>.Success {value: acceptedNode} => acceptedNode
    Result<BodyNodeId, Shared<Rejection>>.Failure {error} => {
      return Result.failResult<BodyNodeId, Shared<Rejection>>(move error)
    }
  }
  if !mutablePlace(
    Vector.asSlice<BodyNode>(&nodes.*),
    Vector.asSlice<BodyLocal>(&locals.*),
    destination,
  ) {
    return Result.failResult<BodyNodeId, Shared<Rejection>>(
      run reject(&resolver.*, module, RejectionCode.TypeMismatch, span),
    )
  }
  let expected = bodyExpressionType(Vector.asSlice<BodyNode>(&nodes.*), &destination)
  // A local whose type retains a region takes the value's own type first, so the assignment can
  // meet the two regions or refuse a relation it cannot prove.
  // An unannotated binding at its own loop depth also meets a `'static` region: an initializer such
  // as `C.defaults()` fixes a lifetime only its result names to `'static`, and a later value with a
  // shorter region narrows the binding rather than being refused (LIFE-003).
  let assigned = assignedLocal(Vector.asSlice<BodyNode>(&nodes.*), destination)
  let mut regioned = false
  if let Option<BodyLocalId>.Some {value: local} = &assigned {
    let mut meets = false
    if let Option<usize>.Some {value: depth} = &Vector.asSlice<BodyLocal>(&locals.*)[local.index].meetDepth { meets = depth == loopDepth }
    if let Option<Shared<Type>>.Some {value: declared} = &expected { regioned = run carriesRegion(&declared, meets) }
  }
  let mut valueExpected = Option.none<Shared<Type>>()
  if !regioned {
    valueExpected = match &expected {
      Option<Shared<Type>>.Some {value: declared} => Option.some<Shared<Type>>(Shared.clone<Type>(&declared))
      Option<Shared<Type>>.None => Option.none<Shared<Type>>()
    }
  }
  let replacement = run checkStatementExpression(
    &mut resolver.*,
    &mut owner.*,
    &mut request.*,
    &mut dependencies.*,
    module,
    cursor,
    caller,
    &mut locals.*,
    annotations,
    resultType,
    loopDepth,
    calls,
    &mut nodes.*,
    &mut signatures.*,
    &mut requiredBodies.*,
    value,
    &valueExpected,
    constraints,
    contractBody,
    false,
    unsafeAllowed, false,
  )
  let mut replacementNode = match move replacement {
    Result<BodyNodeId, Shared<Rejection>>.Success {value: acceptedNode} => acceptedNode
    Result<BodyNodeId, Shared<Rejection>>.Failure {error} => {
      return Result.failResult<BodyNodeId, Shared<Rejection>>(move error)
    }
  }
  if regioned {
    let valueSpan = run bodySpan(&resolver.source, cursor, value)
    let admitted = run assignLocalValue(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, caller, constraints,
      &mut locals.*, &mut nodes.*, destination, replacementNode, loopDepth, valueSpan)
    replacementNode = match move admitted {
      Result<BodyNodeId, Shared<Rejection>>.Success {value: acceptedNode} => acceptedNode
      Result<BodyNodeId, Shared<Rejection>>.Failure {error} => {
        return Result.failResult<BodyNodeId, Shared<Rejection>>(move error)
      }
    }
  }
  let node = BodyNodeId {index: Vector.length<BodyNode>(&nodes.*)}
  run Vector.append<BodyNode>(
    &mut nodes.*,
    BodyNode {
      origin: BodyOrigin {syntax: statement, span: span},
      kind: BodyNodeKind.PlaceAssignment {target: destination, value: replacementNode},
    },
  )
  return Result.succeed<BodyNodeId, Shared<Rejection>>(node)
}

effect fn checkStatements(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut Vector<Dependency>,
  module: &ModuleId,
  cursor: &AuthoredCursor,
  caller: &DeclarationId,
  locals: &mut Vector<BodyLocal>,
  bindings: &mut Vector<Symbol>,
  annotations: &[ResolvedAnnotation],
  calls: &[ResolvedCall],
  nodes: &mut Vector<BodyNode>,
  signatures: &mut Vector<SignatureDependency>,
  requiredBodies: &mut Vector<DeclarationId>,
  statements: &mut Vector<BodyNodeId>,
  written: Range,
  resultType: &Shared<Type>,
  constraints: &[Constraint],
  contractBody: bool,
  staticBody: bool,
  loopDepth: usize,
  unsafeAllowed: bool,
) -> Result<bool, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let mut reachable = true
  let mut at = usize.ZERO
  while at < written.length {
    let statement = run bodyChild(&resolver.source, cursor, written, at)
    let span = run bodySpan(&resolver.source, cursor, statement)
    match run bodyNode(&resolver.source, cursor, statement) {
      Node.StaticForStatement {body, ..} => {
        let checked = run checkStaticFor(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
          module, cursor, caller, &mut locals.*, annotations, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*,
          statement, body, resultType, constraints, contractBody, staticBody, loopDepth, unsafeAllowed)
        match move checked {
          Result<CheckedControl, Shared<Rejection>>.Success {value} => {
            run Vector.append<BodyNodeId>(&mut statements.*, value.node)
            reachable = reachable && value.canComplete
          }
          Result<CheckedControl, Shared<Rejection>>.Failure {error} => { return Result.failResult<bool, Shared<Rejection>>(move error) }
        }
      }
      Node.StaticConditionalStatement {..} => {
        let checked = run checkStaticConditional(
          &mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
          module, cursor, caller, &mut locals.*, annotations, calls, &mut nodes.*,
          &mut signatures.*, &mut requiredBodies.*, statement, resultType,
          constraints, contractBody, staticBody, loopDepth, unsafeAllowed,
        )
        match move checked {
          Result<CheckedControl, Shared<Rejection>>.Success {value} => {
            run Vector.append<BodyNodeId>(&mut statements.*, value.node)
            reachable = reachable && value.canComplete
          }
          Result<CheckedControl, Shared<Rejection>>.Failure {error} => {
            return Result.failResult<bool, Shared<Rejection>>(move error)
          }
        }
      }
      Node.ConditionalStatement {..} => {
        let checked = run checkConditional(
          &mut resolver.*,
          &mut owner.*,
          &mut request.*,
          &mut dependencies.*,
          module,
          cursor,
          caller,
          &mut locals.*,
          annotations,
          calls,
          &mut nodes.*,
          &mut signatures.*,
          &mut requiredBodies.*,
          statement,
          resultType,
          constraints,
          contractBody,
          staticBody,
          loopDepth,
          unsafeAllowed,
        )
        match move checked {
          Result<CheckedControl, Shared<Rejection>>.Success {value} => {
            run Vector.append<BodyNodeId>(&mut statements.*, value.node)
            reachable = reachable && value.canComplete
          }
          Result<CheckedControl, Shared<Rejection>>.Failure {error} => {
            return Result.failResult<bool, Shared<Rejection>>(move error)
          }
        }
      }
      Node.PatternConditionalStatement {..} => {
        let checked = run checkControl(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
          module, cursor, caller, &mut locals.*, annotations, calls, &mut nodes.*, &mut signatures.*,
          &mut requiredBodies.*, statement, resultType, constraints, contractBody, staticBody, loopDepth, unsafeAllowed)
        match move checked {
          Result<CheckedControl, Shared<Rejection>>.Success {value} => {
            run Vector.append<BodyNodeId>(&mut statements.*, value.node)
            reachable = reachable && value.canComplete
          }
          Result<CheckedControl, Shared<Rejection>>.Failure {error} => {
            return Result.failResult<bool, Shared<Rejection>>(move error)
          }
        }
      }
      Node.PatternBindingStatement {pattern, initializer} => {
        // `let _ = e` is not a second discard statement; intentional discard is `drop e` (SEM0087).
        if let Node.UniversalPattern {..} = run bodyNode(&resolver.source, cursor, pattern) {
          return Result.failResult<bool, Shared<Rejection>>(
            run reject(&resolver.*, module, RejectionCode.ExplicitDiscard, run bodySpan(&resolver.source, cursor, pattern)),
          )
        }
        let checked = run checkPatternStatement(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
          module, cursor, caller, &mut locals.*, annotations, calls, &mut nodes.*, &mut signatures.*,
          &mut requiredBodies.*, statement, initializer, MatchArms.Binding {pattern: pattern}, resultType,
          constraints, contractBody, staticBody, loopDepth, unsafeAllowed)
        match move checked {
          Result<CheckedControl, Shared<Rejection>>.Success {value} => {
            run Vector.append<BodyNodeId>(&mut statements.*, value.node)
          }
          Result<CheckedControl, Shared<Rejection>>.Failure {error} => {
            return Result.failResult<bool, Shared<Rejection>>(move error)
          }
        }
      }
      Node.ReturnStatement {value: returned} => {
        if span.start == span.end && returned.present {
          match run bodyNode(&resolver.source, cursor, returned.id) {
            Node.UnitLiteral => {
              at = at + usize.ONE
              continue
            }
            _ => ()
          }
        }
        let mut checked = Option.none<BodyNodeId>()
        // A deriving `effect {}` body's success type is the join of what it returns (EFF-002).
        let deriving = derivingBody(&resolver.*)
        if returned.present {
          // Only this producer may establish its own opaque result. Check the construction at
          // its exact type first; an ordinary expected-value boundary must keep families exact.
          let opaqueResult = run Type.containsOpaque(resultType, caller)
          let callableResult = Shared.with<Type, bool>(resultType, fn(ty: &Type) -> bool {
            return match &ty.* { Type.Callable {..} => true _ => false }
          })
          if opaqueResult {
            let supportedContext = Shared.with<Type, bool>(resultType, fn(ty: &Type) -> bool {
              return match &ty.* { Type.OpaqueRepresentation {..} => true Type.Nominal {..} => true Type.Union {..} => true _ => false }
            })
            if !supportedContext {
              let constructionSpan = run bodySpan(&resolver.source, cursor, returned.id)
              return Result.failResult<bool, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.Unsupported, constructionSpan))
            }
          }
          let mut expected = Option.none<Shared<Type>>()
          let mut opaqueConstruction = false
          if !opaqueResult && !callableResult { expected = Option.some<Shared<Type>>(Shared.clone<Type>(resultType)) }
          if opaqueResult && !deriving {
            let kind = Shared.with<Type, OwnerKind>(resultType, nominalKind)
            let literal = run bodyNode(&resolver.source, cursor, returned.id)
            let contextual = match literal {
              Node.RecordExpression {..} => kind == OwnerKind.Struct
              Node.TupleExpression {..} => kind == OwnerKind.Tuple
              _ => false
            }
            if contextual {
              expected = Option.some<Shared<Type>>(Shared.clone<Type>(resultType))
              opaqueConstruction = true
            }
            // A returned `effect {}` block takes its channels from the declared Effect (EFF-011).
            if let Node.EffectExpression {..} = literal {
              let declared = Shared.with<Type, Option<Shared<Type>>>(resultType, effectFamilyContract)
              if let Option<Shared<Type>>.Some {value: contract} = move declared {
                expected = Option.some<Shared<Type>>(move contract)
              }
            }
          }
          if deriving { expected = Option.none<Shared<Type>>() }
          let expression = run checkStatementExpression(
            &mut resolver.*,
            &mut owner.*,
            &mut request.*,
            &mut dependencies.*,
            module,
            cursor,
            caller,
            &mut locals.*,
            annotations,
            resultType,
            loopDepth,
            calls,
            &mut nodes.*,
            &mut signatures.*,
            &mut requiredBodies.*,
            returned.id,
            &expected,
            constraints,
            contractBody,
            staticBody,
            unsafeAllowed, opaqueConstruction,
          )
          match move expression {
            Result<BodyNodeId, Shared<Rejection>>.Success {value: node} => {
              let mut returnedNode = node
              if opaqueResult || callableResult {
                let returnSpan = Vector.asSlice<BodyNode>(&nodes.*)[node.index].origin.span
                let mut failure = Option.none<Shared<Rejection>>()
                if opaqueResult {
                  failure = run proveOpaqueReturn(&mut resolver.*, &mut owner.*, &mut dependencies.*,
                    module, caller, Vector.asSlice<BodyNode>(&nodes.*), node, resultType, constraints, returnSpan)
                } else {
                  failure = run provePlainCallableReturn(&mut resolver.*, &mut owner.*, &mut dependencies.*,
                    module, Vector.asSlice<BodyNode>(&nodes.*), node, resultType, constraints, returnSpan)
                }
                if let Option<Shared<Rejection>>.Some {value} = move failure {
                  return Result.failResult<bool, Shared<Rejection>>(move value)
                }
                let transferred = run transferCallableReturn(&mut resolver.*, &mut owner.*, &mut dependencies.*,
                  module, cursor, &mut nodes.*, node, constraints, returnSpan)
                match move transferred {
                  Result<BodyNodeId, Shared<Rejection>>.Success {value} => { returnedNode = value }
                  Result<BodyNodeId, Shared<Rejection>>.Failure {error} => { return Result.failResult<bool, Shared<Rejection>>(move error) }
                }
              }
              if opaqueResult || callableResult {
                let returnSpan = Vector.asSlice<BodyNode>(&nodes.*)[returnedNode.index].origin.span
                let unknown = run unknownOwnedCallableReturn(&mut resolver.*, &mut owner.*, &mut dependencies.*,
                  module, Vector.asSlice<BodyNode>(&nodes.*), returnedNode, returnSpan)
                if let Option<Shared<Rejection>>.Some {value} = move unknown {
                  return Result.failResult<bool, Shared<Rejection>>(move value)
                }
              }
              if opaqueResult {
                returnedNode = run opaqueUnionArgument(&mut nodes.*, returnedNode, resultType, caller)
              }
              checked = Option.some<BodyNodeId>(returnedNode)
              if deriving {
                let returnedType = bodyExpressionType(Vector.asSlice<BodyNode>(&nodes.*), &returnedNode)
                run deriveChannels(&mut resolver.*, move returnedType, Option.none<Shared<Type>>(), Option.none<Shared<Type>>(),
                  Option.none<Shared<Row>>())
              }
            }
            Result<BodyNodeId, Shared<Rejection>>.Failure {error} => {
              return Result.failResult<bool, Shared<Rejection>>(move error)
            }
          }
        } else if deriving {
          run deriveChannels(&mut resolver.*, Option.some<Shared<Type>>(run Shared.make<Type>(Type.Unit)), Option.none<Shared<Type>>(),
            Option.none<Shared<Type>>(), Option.none<Shared<Row>>())
        } else if Shared.with<Type, usize>(resultType, scalarCode) != 1 {
          return Result.failResult<bool, Shared<Rejection>>(
            run reject(&resolver.*, module, RejectionCode.TypeMismatch, span),
          )
        }
        let node = BodyNodeId {index: Vector.length<BodyNode>(&nodes.*)}
        run Vector.append<BodyNode>(
          &mut nodes.*,
          BodyNode {
            origin: BodyOrigin {syntax: statement, span: span},
            kind: BodyNodeKind.Return {value: move checked},
          },
        )
        run Vector.append<BodyNodeId>(&mut statements.*, node)
        reachable = false
      }
      Node.ExpressionStatement {expression} => {
        let checked = run checkStatementExpression(
          &mut resolver.*,
          &mut owner.*,
          &mut request.*,
          &mut dependencies.*,
          module,
          cursor,
          caller,
          &mut locals.*,
          annotations,
          resultType,
          loopDepth,
          calls,
          &mut nodes.*,
          &mut signatures.*,
          &mut requiredBodies.*,
          expression,
          &Option.none<Shared<Type>>(),
          constraints,
          contractBody,
          staticBody,
          unsafeAllowed, false,
        )
        match move checked {
          Result<BodyNodeId, Shared<Rejection>>.Success {value: node} => {
            let diverges = match & Vector.asSlice<BodyNode>(&nodes.*)[node.index].kind {
              BodyNodeKind.Expression {ty, ..} => Shared.with<Type, bool>(&ty, neverType)
              _ => false
            }
            run Vector.append<BodyNodeId>(&mut statements.*, node)
            if diverges {
              reachable = false
            }
          }
          Result<BodyNodeId, Shared<Rejection>>.Failure {error} => {
            return Result.failResult<bool, Shared<Rejection>>(move error)
          }
        }
      }
      Node.BindingStatement {name, mutable, isStatic, annotation, initializer} => {
        if isStatic {
          // The selection pass evaluated this binding; its later reads are embedded values and it
          // has no runtime local. An unselected body cannot hold static state.
          if staticBindingFact(calls, statement) {
            at = at + usize.ONE
            continue
          }
          return Result.failResult<bool, Shared<Rejection>>(
            run reject(&resolver.*, module, RejectionCode.Unsupported, span),
          )
        }
        // The block's names belong to one authored string table. Linux matrix samples
        // spent repeated seconds copying HIR/name bytes inside this collision scan.
        let binderName = match run bodyNode(&resolver.source, cursor, name) {
          Node.Name {text} => Option.some<Symbol>(text)
          _ => Option.none<Symbol>()
        }
        if let Option<Symbol>.Some {value: symbol} = &binderName {
          if bindingNameCollides(Vector.asSlice<Symbol>(&bindings.*), symbol.index) {
            return Result.failResult<bool, Shared<Rejection>>(
              run reject(
                &resolver.*,
                module,
                RejectionCode.Collision,
                run bodySpan(&resolver.source, cursor, name),
              ),
            )
          }
        }
        let mut expected = Option.none<Shared<Type>>()
        // An annotation that elides a lifetime describes the initializer's own regions, so the
        // initializer is checked on its own and supplies each elided lifetime (LIFE-003).
        let mut described = Option.none<Shared<Type>>()
        let elided = run elidedLifetimeOwner(caller)
        if annotation.present {
          let declared = run bindingAnnotationType(
            &resolver.*, module, cursor, annotations, annotation.id, contractBody, staticBody,
          )
          match move declared {
            Result<Shared<Type>, Shared<Rejection>>.Success {value} => {
              if run typeMentionsOwner(&value, &elided) {
                described = Option.some<Shared<Type>>(move value)
              } else {
                expected = Option.some<Shared<Type>>(move value)
              }
            }
            Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
              return Result.failResult<bool, Shared<Rejection>>(move error)
            }
          }
        }
        let checked = run checkStatementExpression(
          &mut resolver.*,
          &mut owner.*,
          &mut request.*,
          &mut dependencies.*,
          module,
          cursor,
          caller,
          &mut locals.*,
          annotations,
          resultType,
          loopDepth,
          calls,
          &mut nodes.*,
          &mut signatures.*,
          &mut requiredBodies.*,
          initializer,
          &expected,
          constraints,
          contractBody,
          staticBody,
          unsafeAllowed, false,
        )
        let mut initializerNode = match move checked {
          Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
          Result<BodyNodeId, Shared<Rejection>>.Failure {error} => {
            return Result.failResult<bool, Shared<Rejection>>(move error)
          }
        }
        if let Option<Shared<Type>>.Some {value: annotated} = &described {
          let admitted = run describedBinding(&resolver.*, module, &mut nodes.*, initializerNode, &annotated, &elided,
            run bodySpan(&resolver.source, cursor, initializer))
          initializerNode = match move admitted {
            Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
            Result<BodyNodeId, Shared<Rejection>>.Failure {error} => {
              return Result.failResult<bool, Shared<Rejection>>(move error)
            }
          }
        }
        let checkedNodes = Vector.asSlice<BodyNode>(&nodes.*)
        let ty = match & checkedNodes[initializerNode.index].kind {
          BodyNodeKind.Expression {ty, ..} => Shared.clone<Type>(&ty)
          _ => {
            return Result.failResult<bool, Shared<Rejection>>(
              run reject(&resolver.*, module, RejectionCode.Unsupported, span),
            )
          }
        }
        let mut meetDepth = Option.none<usize>()
        if mutable && !annotation.present { meetDepth = Option.some<usize>(loopDepth) }
        let local = BodyLocalId {index: Vector.length<BodyLocal>(&locals.*)}
        run Vector.append<BodyLocal>(
          &mut locals.*,
          BodyLocal {
            origin: BodyOrigin {
              syntax: statement,
              span: run bodySpan(&resolver.source, cursor, name),
            },
            ty: move ty,
            mutable: mutable,
            meetDepth: move meetDepth,
          },
        )
        if let Option<Symbol>.Some {value: symbol} = move binderName {
          run Vector.append<Symbol>(&mut bindings.*, symbol)
        }
        let node = BodyNodeId {index: Vector.length<BodyNode>(&nodes.*)}
        let mut bindingKind = BodyNodeKind.LocalBinding {local: local, initializer: initializerNode}
        if mutable {
          bindingKind = BodyNodeKind.MutableBinding {local: local, initializer: initializerNode}
        }
        run Vector.append<BodyNode>(
          &mut nodes.*,
          BodyNode {origin: BodyOrigin {syntax: statement, span: span}, kind: move bindingKind},
        )
        run Vector.append<BodyNodeId>(&mut statements.*, node)
      }
      Node.UnsafeStatement {body} => {
        if staticBody {
          return Result.failResult<bool, Shared<Rejection>>(
            run reject(&resolver.*, module, RejectionCode.StaticPhaseViolation, span),
          )
        }
        let checked = run checkBlock(
          &mut resolver.*,
          &mut owner.*,
          &mut request.*,
          &mut dependencies.*,
          module,
          cursor,
          caller,
          &mut locals.*,
          annotations,
          calls,
          &mut nodes.*,
          &mut signatures.*,
          &mut requiredBodies.*,
          body,
          resultType,
          constraints,
          contractBody,
          staticBody,
          loopDepth,
          true,
        )
        match move checked {
          Result<CheckedControl, Shared<Rejection>>.Success {value} => {
            run Vector.append<BodyNodeId>(&mut statements.*, value.node)
            reachable = value.canComplete
          }
          Result<CheckedControl, Shared<Rejection>>.Failure {error} => {
            return Result.failResult<bool, Shared<Rejection>>(move error)
          }
        }
      }
      Node.AssignmentStatement {target, value} => {
        if !staticBody {
          let checked = run checkPlaceAssignment(
            &mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module, cursor,
            caller, &mut locals.*, annotations, resultType, loopDepth, calls, &mut nodes.*,
            &mut signatures.*, &mut requiredBodies.*, statement, span, target, value,
            constraints, contractBody, unsafeAllowed,
          )
          match move checked {
            Result<BodyNodeId, Shared<Rejection>>.Success {value: node} => {
              run Vector.append<BodyNodeId>(&mut statements.*, node)
            }
            Result<BodyNodeId, Shared<Rejection>>.Failure {error} => {
              return Result.failResult<bool, Shared<Rejection>>(move error)
            }
          }
          at = at + usize.ONE
          continue
        }
        let mut selected = Option.none<BodyLocalId>()
        if let Node.IdentifierExpression {binding, ..} = run bodyNode(
          &resolver.source,
          cursor,
          target,
        ) {
          selected = mutableLocalOf(&resolver.*, Vector.asSlice<BodyLocal>(&locals.*), binding)
        }
        let local = match move selected {
          Option<BodyLocalId>.Some {value: found} => found
          Option<BodyLocalId>.None => {
            return Result.failResult<bool, Shared<Rejection>>(
              run reject(
                &resolver.*,
                module,
                RejectionCode.StaticPhaseViolation,
                run bodySpan(&resolver.source, cursor, target),
              ),
            )
          }
        }
        let available = Vector.asSlice<BodyLocal>(&locals.*)
        let expected = Option.some<Shared<Type>>(Shared.clone<Type>(&available[local.index].ty))
        let checked = run checkStatementExpression(
          &mut resolver.*,
          &mut owner.*,
          &mut request.*,
          &mut dependencies.*,
          module,
          cursor,
          caller,
          &mut locals.*,
          annotations,
          resultType,
          loopDepth,
          calls,
          &mut nodes.*,
          &mut signatures.*,
          &mut requiredBodies.*,
          value,
          &expected,
          constraints,
          contractBody,
          staticBody,
          unsafeAllowed, false,
        )
        let replacement = match move checked {
          Result<BodyNodeId, Shared<Rejection>>.Success {value: found} => found
          Result<BodyNodeId, Shared<Rejection>>.Failure {error} => {
            return Result.failResult<bool, Shared<Rejection>>(move error)
          }
        }
        let node = BodyNodeId {index: Vector.length<BodyNode>(&nodes.*)}
        run Vector.append<BodyNode>(
          &mut nodes.*,
          BodyNode {
            origin: BodyOrigin {syntax: statement, span: span},
            kind: BodyNodeKind.Assignment {local: local, value: replacement},
          },
        )
        run Vector.append<BodyNodeId>(&mut statements.*, node)
      }
      Node.WhileStatement {condition, body} => {
        let boolType = Option.some<Shared<Type>>(run primitiveType(b"bool"))
        let checkedCondition = run checkStatementExpression(
          &mut resolver.*,
          &mut owner.*,
          &mut request.*,
          &mut dependencies.*,
          module,
          cursor,
          caller,
          &mut locals.*,
          annotations,
          resultType,
          loopDepth,
          calls,
          &mut nodes.*,
          &mut signatures.*,
          &mut requiredBodies.*,
          condition,
          &boolType,
          constraints,
          contractBody,
          staticBody,
          unsafeAllowed, false,
        )
        let conditionNode = match move checkedCondition {
          Result<BodyNodeId, Shared<Rejection>>.Success {value: found} => found
          Result<BodyNodeId, Shared<Rejection>>.Failure {error} => {
            return Result.failResult<bool, Shared<Rejection>>(move error)
          }
        }
        let checkedBody = run checkBlock(
          &mut resolver.*,
          &mut owner.*,
          &mut request.*,
          &mut dependencies.*,
          module,
          cursor,
          caller,
          &mut locals.*,
          annotations,
          calls,
          &mut nodes.*,
          &mut signatures.*,
          &mut requiredBodies.*,
          body,
          resultType,
          constraints,
          contractBody,
          staticBody,
          loopDepth + usize.ONE,
          unsafeAllowed,
        )
        let bodyNode = match move checkedBody {
          Result<CheckedControl, Shared<Rejection>>.Success {value: found} => found.node
          Result<CheckedControl, Shared<Rejection>>.Failure {error} => {
            return Result.failResult<bool, Shared<Rejection>>(move error)
          }
        }
        let node = BodyNodeId {index: Vector.length<BodyNode>(&nodes.*)}
        run Vector.append<BodyNode>(
          &mut nodes.*,
          BodyNode {
            origin: BodyOrigin {syntax: statement, span: span},
            kind: BodyNodeKind.While {condition: conditionNode, body: bodyNode},
          },
        )
        run Vector.append<BodyNodeId>(&mut statements.*, node)
      }
      Node.FailStatement {isMove, value} => {
        if staticBody {
          return Result.failResult<bool, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.StaticPhaseViolation, span))
        }
        let enclosing = run currentBodyChannels(&resolver.*)
        let deriving = derivingBody(&resolver.*)
        if !enclosing.isEffect {
          return Result.failResult<bool, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.FailOutsideEffect, span))
        }
        let valueSpan = run bodySpan(&resolver.source, cursor, value)
        // An effect fn that declares no failure has no member this payload could inhabit.
        if !deriving && Shared.with<Type, bool>(&enclosing.failure, neverType) {
          return Result.failResult<bool, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.UndeclaredFailure, valueSpan))
        }
        // A moved operand is checked as written; its transfer is then widened into the channel. A
        // deriving body's failure type is the join of what it fails with.
        let mut context = Option.some<Shared<Type>>(Shared.clone<Type>(&enclosing.failure))
        if isMove || deriving { context = Option.none<Shared<Type>>() }
        let checked = run checkStatementExpression(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
          module, cursor, caller, &mut locals.*, annotations, resultType, loopDepth, calls, &mut nodes.*,
          &mut signatures.*, &mut requiredBodies.*, value, &context, constraints,
          contractBody, staticBody, unsafeAllowed, false)
        let mut operand = match move checked {
          Result<BodyNodeId, Shared<Rejection>>.Success {value: node} => node
          Result<BodyNodeId, Shared<Rejection>>.Failure {error} => {
            // Only the payload as a whole missing the channel is undeclared; nested mismatches stay.
            let mismatch = Shared.with<Rejection, bool>(&error, fn(diagnostic: &Rejection) -> bool {
              return diagnostic.code == RejectionCode.TypeMismatch && diagnostic.span.start == valueSpan.start &&
                diagnostic.span.end == valueSpan.end
            })
            if mismatch {
              return Result.failResult<bool, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.UndeclaredFailure, valueSpan))
            }
            return Result.failResult<bool, Shared<Rejection>>(move error)
          }
        }
        // `fail move value` transfers the operand exactly as a `move` expression does (FAIL-002).
        if isMove {
          let operandType = match move bodyExpressionType(Vector.asSlice<BodyNode>(&nodes.*), &operand) {
            Option<Shared<Type>>.Some {value: selected} => selected
            Option<Shared<Type>>.None => { return Result.failResult<bool, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.Unsupported, valueSpan)) }
          }
          let consumed = match move run consumedPlace(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor,
            Vector.asSlice<BodyNode>(&nodes.*), operand, false, false, valueSpan, span, constraints) {
            Result<Option<BodyConsumedPlace>, Shared<Rejection>>.Success {value: place} => place
            Result<Option<BodyConsumedPlace>, Shared<Rejection>>.Failure {error} => { return Result.failResult<bool, Shared<Rejection>>(move error) }
          }
          let moved = BodyNodeId {index: Vector.length<BodyNode>(&nodes.*)}
          run Vector.append<BodyNode>(&mut nodes.*, BodyNode {origin: BodyOrigin {syntax: value, span: valueSpan},
            kind: BodyNodeKind.Expression {ty: move operandType, form: BodyExpression.Move {value: operand, consumed: move consumed}}})
          operand = moved
        }
        if deriving {
          let failedType = match move bodyExpressionType(Vector.asSlice<BodyNode>(&nodes.*), &operand) {
            Option<Shared<Type>>.Some {value: selected} => selected
            Option<Shared<Type>>.None => { return Result.failResult<bool, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.Unsupported, valueSpan)) }
          }
          run deriveChannels(&mut resolver.*, Option.none<Shared<Type>>(), Option.some<Shared<Type>>(move failedType),
            Option.none<Shared<Type>>(), Option.none<Shared<Row>>())
        }
        let mut channel = Option.some<Shared<Type>>(Shared.clone<Type>(&enclosing.failure))
        if deriving { channel = Option.none<Shared<Type>>() }
        let adapted = run checkExpectedValue(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, caller, constraints, &mut nodes.*,
          operand, &channel, valueSpan)
        let failed = match move adapted {
          Result<BodyNodeId, Shared<Rejection>>.Success {value: node} => node
          Result<BodyNodeId, Shared<Rejection>>.Failure {..} => {
            return Result.failResult<bool, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.UndeclaredFailure, valueSpan))
          }
        }
        let node = BodyNodeId {index: Vector.length<BodyNode>(&nodes.*)}
        run Vector.append<BodyNode>(&mut nodes.*, BodyNode {
          origin: BodyOrigin {syntax: statement, span: span}, kind: BodyNodeKind.Fail {value: failed},
        })
        run Vector.append<BodyNodeId>(&mut statements.*, node)
        reachable = false
      }
      Node.DropStatement {value} => {
        if staticBody {
          return Result.failResult<bool, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.Unsupported, span))
        }
        let checked = run checkStatementExpression(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
          module, cursor, caller, &mut locals.*, annotations, resultType, loopDepth, calls, &mut nodes.*,
          &mut signatures.*, &mut requiredBodies.*, value, &Option.none<Shared<Type>>(), constraints,
          contractBody, staticBody, unsafeAllowed, false)
        let operand = match move checked {
          Result<BodyNodeId, Shared<Rejection>>.Success {value: node} => node
          Result<BodyNodeId, Shared<Rejection>>.Failure {error} => {
            return Result.failResult<bool, Shared<Rejection>>(move error)
          }
        }
        let operandType = match move bodyExpressionType(Vector.asSlice<BodyNode>(&nodes.*), &operand) {
          Option<Shared<Type>>.Some {value: selected} => selected
          Option<Shared<Type>>.None => {
            return Result.failResult<bool, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.Unsupported, span))
          }
        }
        let copied = match move run copyType(&mut resolver.*, &mut owner.*, &mut dependencies.*, &operandType, constraints, span) {
          Result<bool, Shared<Rejection>>.Success {value: answer} => answer
          Result<bool, Shared<Rejection>>.Failure {error} => { return Result.failResult<bool, Shared<Rejection>>(move error) }
        }
        let operandSpan = run bodySpan(&resolver.source, cursor, value)
        let consumed = match move run consumedPlace(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor, Vector.asSlice<BodyNode>(&nodes.*), operand, copied, true, operandSpan, span, constraints) {
          Result<Option<BodyConsumedPlace>, Shared<Rejection>>.Success {value: place} => place
          Result<Option<BodyConsumedPlace>, Shared<Rejection>>.Failure {error} => {
            return Result.failResult<bool, Shared<Rejection>>(move error)
          }
        }
        let node = BodyNodeId {index: Vector.length<BodyNode>(&nodes.*)}
        run Vector.append<BodyNode>(&mut nodes.*, BodyNode {
          origin: BodyOrigin {syntax: statement, span: span},
          kind: BodyNodeKind.Drop {value: operand, consumed: move consumed},
        })
        run Vector.append<BodyNodeId>(&mut statements.*, node)
      }
      Node.BreakStatement => {
        if loopDepth == usize.ZERO {
          return Result.failResult<bool, Shared<Rejection>>(
            run reject(&resolver.*, module, RejectionCode.TransferOutsideLoop, span),
          )
        }
        let node = BodyNodeId {index: Vector.length<BodyNode>(&nodes.*)}
        run Vector.append<BodyNode>(
          &mut nodes.*,
          BodyNode {origin: BodyOrigin {syntax: statement, span: span}, kind: BodyNodeKind.Break},
        )
        run Vector.append<BodyNodeId>(&mut statements.*, node)
        reachable = false
      }
      Node.ContinueStatement => {
        if loopDepth == usize.ZERO {
          return Result.failResult<bool, Shared<Rejection>>(
            run reject(&resolver.*, module, RejectionCode.TransferOutsideLoop, span),
          )
        }
        let node = BodyNodeId {index: Vector.length<BodyNode>(&nodes.*)}
        run Vector.append<BodyNode>(
          &mut nodes.*,
          BodyNode {origin: BodyOrigin {syntax: statement, span: span}, kind: BodyNodeKind.Continue},
        )
        run Vector.append<BodyNodeId>(&mut statements.*, node)
        reachable = false
      }
      _ => {
        return Result.failResult<bool, Shared<Rejection>>(
          run reject(&resolver.*, module, RejectionCode.Unsupported, span),
        )
      }
    }
    at = at + usize.ONE
  }
  return Result.succeed<bool, Shared<Rejection>>(reachable)
}

effect fn currentKey(resolver: &mut Resolver, prior: &BodyDependency) -> Option<Key>
! Cycle | OutOfMemoryError
? &mut Allocator {
  let previous = prior.key
  if previous.family == Family.Name || previous.family == Family.ProfileInput {
    return Option.some<Key>(previous)
  }
  let module = run resolvedModule(&resolver.*, previous.module)
  let answer = run source(&mut resolver.*, &module)
  if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(&resolver.*, &answer, &module) {
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(indexed))
    let mut found = Option.none<usize>()
    let mut at = usize.ZERO
    while at < declarations.length {
      let matches = match & prior.declaration {
        Option<Shared<DeclarationId>>.Some {value: old} => Shared.with<DeclarationId, bool>(
          &old,
          fn(previous: &DeclarationId) -> bool {
            return DeclarationId.equals(previous, &declarations[at].identity)
          },
        )
        Option<Shared<DeclarationId>>.None => false
      }
      if !declarations[at].ambiguous && matches {
        if let Option<usize>.Some {value: _} = &found {
          return Option.none<Key>()
        }
        found = Option.some<usize>(at)
      }
      at = at + usize.ONE
    }
    if let Option<usize>.Some {value} = move found {
      return Option.some<Key>(
        Key {
          family: previous.family,
          module: previous.module,
          name: previous.name,
          declaration: value,
          member: previous.member,
          external: previous.external,
        },
      )
    }
  }
  return Option.none<Key>()
}

effect fn reuseBody(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  key: Key,
  candidate: BodyCandidate,
) -> Option<Answer>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let BodyCandidate {body, evidence, directCount} = move candidate
  let module = run resolvedModule(&resolver.*, key.module)
  let sourceAnswer = run source(&mut resolver.*, &module)
  let input = run SourceIndex.bodyInput(&mut resolver.source, &sourceAnswer, &module, key.declaration)
  let validInput = match move input {
    Option<Shared<BodyInput>>.Some {value: current} => Shared.with<TypedBody, bool>(&body, fn(checked: &TypedBody) -> bool {
      return TypedBody.matchesInput(checked, &current)
    })
    Option<Shared<BodyInput>>.None => false
  }
  if !validInput {
    return Option.none<Answer>()
  }
  let count = Shared.with<BodyEvidence, usize>(
    &evidence,
    fn(owned: &BodyEvidence) -> usize {
      return Vector.length<BodyDependency>(&owned.direct)
    },
  )
  if count != directCount {
    return Option.none<Answer>()
  }
  let mut dependencies = Vector.make<Dependency>()
  let mut at = usize.ZERO
  while at < count {
    let prior = Shared.with<BodyEvidence, BodyDependency>(
      &evidence,
      fn(owned: &BodyEvidence) -> BodyDependency {
        return bodyDependencyAt(owned, at)
      },
    )
    let current = run currentKey(&mut resolver.*, &prior)
    let selected = match move current {
      Option<Key>.Some {value} => value
      Option<Key>.None => {
        return Option.none<Answer>()
      }
    }
    let now = run demandChild(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies,
      selected,
      Span.make(usize.ZERO, usize.ZERO),
    )
    if prior.answerId == Shared.with<Result<Answer, NoRejection>, usize>(&now, priorAnswerId) && prior.answerId != usize.ZERO {
      at = at + usize.ONE
      continue
    }
    let previousIdentity = match & prior.identity {
      Option<Shared<Value>>.Some {value} => Option.some<Shared<Value>>(Shared.clone<Value>(&value))
      Option<Shared<Value>>.None => Option.none<Shared<Value>>()
    }
    let currentIdentity = Shared.with<Result<Answer, NoRejection>, Option<Shared<Value>>>(
      &now,
      answerIdentity,
    )
    let matching = match move previousIdentity {
      Option<Shared<Value>>.Some {value: first} => match move currentIdentity {
        Option<Shared<Value>>.Some {value: second} => run sameSharedValue(&first, &second)
        Option<Shared<Value>>.None => false
      }
      Option<Shared<Value>>.None => false
    }
    if !matching {
      return Option.none<Answer>()
    }
    at = at + usize.ONE
  }
  return Option.some<Answer>(
    Answer {
      outcome: Outcome.Success {
        value: Value.Body {
          body: move body,
          source: run Shared.make<Observation>(
            run SourceIndex.captureObservation(&resolver.source, &module),
          ),
        },
      },
      dependencies: move dependencies,
      sources: Vector.make<Shared<Observation>>(),
      footprint: Vector.make<Shared<DemandFootprint>>(),
      answerId: usize.ZERO,
      identity: Option.none<Shared<Value>>(),
      bodyEvidence: Option.none<Shared<BodyEvidence>>(),
    },
  )
}

struct WrittenInitializer {
  expression: Option<HirId>
  span: Span
}

// A schema header must start with an admitted value constructor. Nominal member shapes are
// checked when the concrete schema is assembled, after forward declarations become available.
fn parameterTypeHead(value: &Type) -> bool {
  return match & value.* {
    Type.Primitive {name} => {
      let spelling = Bytes.asSlice(&name)
      return same(spelling, b"bool") || fixedIntegerName(spelling) || pointerSizedIntegerName(
        spelling,
      )
    }
    Type.String {..} => true
    Type.Array {element, ..} => Shared.with<Type, bool>(&element, parameterTypeHead)
    Type.Nominal {declaration, ..} => {
      let kind = DeclarationId.kind(&declaration)
      return kind == OwnerKind.Struct || kind == OwnerKind.Enumeration || kind == OwnerKind.Union
    }
    _ => false
  }
}

fn pointerSized(value: &Type) -> bool {
  return match & value.* {
    Type.Primitive {name} => same(Bytes.asSlice(&name), b"usize") || same(
      Bytes.asSlice(&name),
      b"isize",
    )
    _ => false
  }
}

fn initializerValue(answer: &Result<Answer, NoRejection>) -> Option<Shared<StaticData>> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Initializer {value: found}} => Option.some<
        Shared<StaticData>,
      >(Shared.clone<StaticData>(&found))
      _ => Option.none<Shared<StaticData>>()
    }
    Result<Answer, NoRejection>.Failure {error: _} => Option.none<Shared<StaticData>>()
  }
}

effect fn resolveParameterSchema(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  key: Key,
) -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let module = run resolvedModule(&resolver.*, key.module)
  let mut dependencies = Vector.make<Dependency>()
  let written = run header(&mut resolver.*, &module, key.declaration)
  // MODULE-STATIC-003: configuration precedes module selection, so no package parameter is
  // declared inside a module-level `static if` arm.
  let governing = run armOf(&mut resolver.*, &module, key.declaration)
  if let Option<Arm>.Some {..} = &governing {
    let mut span = Span.make(usize.ZERO, usize.ZERO)
    if let Option<HeaderSyntax>.Some {value: syntax} = &written { span = syntax.span }
    return memberRejected(run reject(&resolver.*, &module, RejectionCode.ConditionalParameter, span), move dependencies)
  }
  if let Option<HeaderSyntax>.Some {value} = move written {
    if let Node.PackageParameterHeader {isPublic, annotation, ..} = value.header {
      let source = run source(&mut resolver.*, &module)
      let mut hasDefault = false
      let mut hasValidation = false
      if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(
        &resolver.*,
        &source,
        &module,
      ) {
        let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(indexed))
        if key.declaration < declarations.length {
          let hir = IndexedSource.authored(indexed)
          if let Node.Declaration {body, ..} = Module.node(hir, declarations[key.declaration].local) {
            if let Node.PackageParameterBody {default, validation} = Module.node(hir, body) {
              hasDefault = default.present
              hasValidation = validation.present
            }
          }
        }
      }
      if !isPublic && !hasDefault {
        return memberRejected(
          run reject(&resolver.*, &module, RejectionCode.InvalidParameterSchema, value.span),
          move dependencies,
        )
      }
      let noBinders = Vector.make<Binder>()
      let mut elision = LifetimeElision {
        owner: Option.none<DeclarationId>(),
        nextOrdinal: usize.ZERO,
        output: true,
        resultDefault: Option.some<Shared<Lifetime>>(run Shared.make<Lifetime>(Lifetime.Static)),
        generated: Vector.make<Shared<Lifetime>>(),
        invocation: false,
        nested: false,
        renumber: Vector.make<usize>(),
        staticEnvironment: false,
        supplied: Option.none<Vector<Argument>>(),
        assumptions: Option.none<Vector<Constraint>>(),
      }
      let resolved = run resolveType(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies,
        key.module,
        annotation,
        Vector.asSlice<Binder>(&noBinders),
        &mut elision,
      )
      return match move resolved {
        Result<Shared<Type>, Shared<Rejection>>.Success {value: ty} => {
          if Type.hasOpenParameters(&ty) || !Shared.with<Type, bool>(&ty, parameterTypeHead) {
            return memberRejected(
              run reject(&resolver.*, &module, RejectionCode.InvalidParameterSchema, value.span),
              move dependencies,
            )
          }
          let identity = run declarationAt(&mut resolver.*, &module, key.declaration)
          if let Option<DeclarationId>.Some {value: declaration} = move identity {
            return memberSuccess(
              Value.ParameterSchema {
                schema: run Shared.make<ParameterSchema>(
                  ParameterSchema {
                    declaration: move declaration,
                    ty: move ty,
                    isPublic: isPublic,
                    hasDefault: hasDefault,
                    hasValidation: hasValidation,
                    span: value.span,
                  },
                ),
              },
              move dependencies,
            )
          }
          return memberRejected(
            run reject(&resolver.*, &module, RejectionCode.InvalidParameterSchema, value.span),
            move dependencies,
          )
        }
        Result<Shared<Type>, Shared<Rejection>>.Failure {error} => memberRejected(
          move error,
          move dependencies,
        )
      }
    }
    return memberRejected(
      run reject(&resolver.*, &module, RejectionCode.InvalidParameterSchema, value.span),
      move dependencies,
    )
  }
  return memberRejected(
    run reject(
      &resolver.*,
      &module,
      RejectionCode.InvalidParameterSchema,
      Span.make(usize.ZERO, usize.ZERO),
    ),
    move dependencies,
  )
}

fn selectedParameterSchema(answer: &Result<Answer, NoRejection>) -> Option<Shared<ParameterSchema>> {
  return match &answer.* {
    Result<Answer, NoRejection>.Success {value} => match &value.outcome {
      Outcome.Success {value: Value.ParameterSchema {schema}} => Option.some<Shared<ParameterSchema>>(
        Shared.clone<ParameterSchema>(&schema),
      )
      _ => Option.none<Shared<ParameterSchema>>()
    }
    Result<Answer, NoRejection>.Failure {error: _} => Option.none<Shared<ParameterSchema>>()
  }
}

struct WrittenDefault {
  expression: Option<HirId>
  span: Span
}

effect fn parameterDefaultSyntax(
  resolver: &mut Resolver,
  module: &ModuleId,
  ordinal: usize,
  fallback: Span,
) -> WrittenDefault ! Cycle | OutOfMemoryError ? &mut Allocator {
  let answer = run source(&mut resolver.*, module)
  if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(&resolver.*, &answer, module) {
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(indexed))
    if ordinal < declarations.length {
      let hir = IndexedSource.authored(indexed)
      if let Node.Declaration {body, ..} = Module.node(hir, declarations[ordinal].local) {
        if let Node.PackageParameterBody {default, ..} = Module.node(hir, body) {
          if default.present {
            return WrittenDefault {
              expression: Option.some<HirId>(default.id),
              span: Module.span(hir, default.id),
            }
          }
        }
      }
    }
  }
  return WrittenDefault {expression: Option.none<HirId>(), span: fallback}
}

effect fn resolveParameterDefault(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  key: Key,
) -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let module = run resolvedModule(&resolver.*, key.module)
  let mut dependencies = Vector.make<Dependency>()
  let declared = run demandChild(
    &mut resolver.*, &mut owner.*, &mut dependencies,
    Key {
      family: Family.ParameterSchema, module: key.module, name: usize.ZERO,
      declaration: key.declaration, member: usize.ZERO, external: false,
    },
    Span.make(usize.ZERO, usize.ZERO),
  )
  let selected = Shared.with<Result<Answer, NoRejection>, Option<Shared<ParameterSchema>>>(
    &declared, selectedParameterSchema,
  )
  let schema = match move selected {
    Option<Shared<ParameterSchema>>.Some {value} => value
    Option<Shared<ParameterSchema>>.None => {
      let rejected = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
        &declared, answerRejection,
      )
      if let Option<Shared<Rejection>>.Some {value} = move rejected {
        return memberRejected(move value, move dependencies)
      }
      return memberRejected(
        run reject(&resolver.*, &module, RejectionCode.InvalidParameterSchema, Span.make(usize.ZERO, usize.ZERO)),
        move dependencies,
      )
    }
  }
  let declaredType = Shared.with<ParameterSchema, Shared<Type>>(
    &schema,
    fn(header: &ParameterSchema) -> Shared<Type> { return Shared.clone<Type>(&header.ty) },
  )
  let fallback = Shared.with<ParameterSchema, Span>(
    &schema,
    fn(header: &ParameterSchema) -> Span { return header.span },
  )
  let written = run parameterDefaultSyntax(&mut resolver.*, &module, key.declaration, fallback)
  let expression = match move written.expression {
    Option<HirId>.Some {value} => value
    Option<HirId>.None => {
      return memberRejected(
        run reject(&resolver.*, &module, RejectionCode.InvalidParameterSchema, written.span),
        move dependencies,
      )
    }
  }
  let evaluated = run staticExpression(
    &mut resolver.*, &mut owner.*, &mut dependencies,
    &module, Option.some<usize>(key.declaration), expression,
    StaticRootExpectation.Resolved {ty: Shared.clone<Type>(&declaredType)},
  )
  return match move evaluated {
    Result<Shared<StaticData>, Shared<Rejection>>.Success {value} => {
      if run StaticValue.matchesType(&value, &declaredType) {
        return memberSuccess(
          Value.ParameterDefault {value: move value, span: written.span},
          move dependencies,
        )
      }
      return memberRejected(
        run reject(&resolver.*, &module, RejectionCode.TypeMismatch, written.span),
        move dependencies,
      )
    }
    Result<Shared<StaticData>, Shared<Rejection>>.Failure {error} => memberRejected(move error, move dependencies)
  }
}

effect fn resolveConstant(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  key: Key,
) -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let module = run resolvedModule(&resolver.*, key.module)
  let mut dependencies = Vector.make<Dependency>()
  let written = run header(&mut resolver.*, &module, key.declaration)
  let mut span = Span.make(usize.ZERO, usize.ZERO)
  if let Option<HeaderSyntax>.Some {value} = move written {
    span = value.span
    if let Node.ConstantHeader {annotation, ..} = value.header {
      if !annotation.present {
        return memberRejected(
          run reject(&resolver.*, &module, RejectionCode.InvalidConstant, value.span),
          move dependencies,
        )
      }
      let noBinders = Vector.make<Binder>()
      // A constant is static data, so an omitted `string` lifetime is `'static`.
      let mut elision = LifetimeElision {
        owner: Option.none<DeclarationId>(),
        nextOrdinal: usize.ZERO,
        output: true,
        resultDefault: Option.some<Shared<Lifetime>>(run Shared.make<Lifetime>(Lifetime.Static)),
        generated: Vector.make<Shared<Lifetime>>(),
        invocation: false,
        nested: false,
        renumber: Vector.make<usize>(),
        staticEnvironment: false,
        supplied: Option.none<Vector<Argument>>(),
        assumptions: Option.none<Vector<Constraint>>(),
      }
      let resolved = run resolveType(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies,
        key.module,
        annotation.id,
        Vector.asSlice<Binder>(&noBinders),
        &mut elision,
      )
      return match move resolved {
        Result<Shared<Type>, Shared<Rejection>>.Success {value: ty} => {
          if Shared.with<Type, bool>(&ty, StaticConstant.typeAllowed) {
            return memberSuccess(Value.Type {resolved: move ty}, move dependencies)
          }
          let mut annotationSpan = value.span
          let annotationSyntax = run typeNode(&mut resolver.*, &module, annotation.id)
          if let Option<HeaderSyntax>.Some {value: typeSyntax} = move annotationSyntax {
            annotationSpan = typeSyntax.span
          }
          return memberRejected(
            run reject(&resolver.*, &module, RejectionCode.InvalidConstant, annotationSpan),
            move dependencies,
          )
        }
        Result<Shared<Type>, Shared<Rejection>>.Failure {error} => memberRejected(
          move error,
          move dependencies,
        )
      }
    }
  }
  // Foreign statics and package parameters are not constants; they stay outside this family.
  return memberRejected(
    run reject(&resolver.*, &module, RejectionCode.Unsupported, span),
    move dependencies,
  )
}

effect fn initializerSyntax(
  resolver: &mut Resolver,
  module: &ModuleId,
  ordinal: usize,
  fallback: Span,
) -> WrittenInitializer ! Cycle | OutOfMemoryError ? &mut Allocator {
  let answer = run source(&mut resolver.*, module)
  if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(&resolver.*, &answer, module) {
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(indexed))
    if ordinal < declarations.length {
      let hir = IndexedSource.authored(indexed)
      if let Node.Declaration {body, ..} = Module.node(hir, declarations[ordinal].local) {
        if let Node.InitializerBody {value} = Module.node(hir, body) {
          if value.present {
            return WrittenInitializer {
              expression: Option.some<HirId>(value.id),
              span: Module.span(hir, value.id),
            }
          }
        }
      }
    }
  }
  return WrittenInitializer {expression: Option.none<HirId>(), span: fallback}
}

effect fn staticSpan(resolver: &mut Resolver, module: &ModuleId, id: HirId) -> Span
! Cycle | OutOfMemoryError
? &mut Allocator {
  let answer = run source(&mut resolver.*, module)
  if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(&resolver.*, &answer, module) {
    return Module.span(IndexedSource.authored(indexed), id)
  }
  return Span.make(usize.ZERO, usize.ZERO)
}

// The type-fact key of one canonical constant, or absence when this store has not indexed the
// constant's module and declaration. Its initializer shares the module and declaration ordinals.
effect fn constantKey(resolver: &mut Resolver, declaration: &Shared<DeclarationId>) -> Option<Key>
! Cycle | OutOfMemoryError
? &mut Allocator {
  let moduleOrdinal = Shared.with<DeclarationId, usize>(declaration, fn(identity: &DeclarationId) -> usize {
    return knownModuleOrdinal(&resolver.*, DeclarationId.moduleId(identity))
  })
  if moduleOrdinal == usize.MAX { return Option.none<Key>() }
  let targetModule = run resolvedModule(&resolver.*, moduleOrdinal)
  let located = run ordinalOfIdentity(&mut resolver.*, &targetModule, declaration)
  return match move located {
    Option<usize>.Some {value} => Option.some<Key>(Key {
      family: Family.Constant, module: moduleOrdinal, name: usize.ZERO,
      declaration: value, member: usize.ZERO, external: false,
    })
    Option<usize>.None => Option.none<Key>()
  }
}

// One constant's published value from its content-keyed initializer answer. Every reader shares
// that answer and records the same value edge; a rejected initializer rejects the reader. `None`
// means the answer published no value.
effect fn constantInitializer(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  constant: Key,
  span: Span,
) -> Result<Option<Shared<StaticData>>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let referenced = run demandChild(
    &mut resolver.*, &mut owner.*, &mut dependencies.*,
    Key {
      family: Family.Initializer, module: constant.module, name: usize.ZERO,
      declaration: constant.declaration, member: usize.ZERO, external: false,
    },
    span,
  )
  let failure = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
    &referenced, answerRejection,
  )
  if let Option<Shared<Rejection>>.Some {value} = move failure {
    return Result.failResult<Option<Shared<StaticData>>, Shared<Rejection>>(move value)
  }
  let value = Shared.with<Result<Answer, NoRejection>, Option<Shared<StaticData>>>(
    &referenced, initializerValue,
  )
  return Result.succeed<Option<Shared<StaticData>>, Shared<Rejection>>(move value)
}

// A runtime body reads a constant as its published value at the declared type. The value has no
// runtime storage, so the read is embedded exactly like a selected static value.
effect fn runtimeConstantRead(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  module: &ModuleId,
  declaration: DeclarationId,
  span: Span,
) -> Result<BodyExpression, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let identity = run Shared.make<DeclarationId>(move declaration)
  let located = run constantKey(&mut resolver.*, &identity)
  let constant = match move located {
    Option<Key>.Some {value} => value
    Option<Key>.None => {
      return Result.failResult<BodyExpression, Shared<Rejection>>(
        run reject(&resolver.*, module, RejectionCode.InvalidConstant, span),
      )
    }
  }
  let published = run constantInitializer(&mut resolver.*, &mut owner.*, &mut dependencies.*, constant, span)
  let selected = match move published {
    Result<Option<Shared<StaticData>>, Shared<Rejection>>.Success {value} => value
    Result<Option<Shared<StaticData>>, Shared<Rejection>>.Failure {error} => {
      return Result.failResult<BodyExpression, Shared<Rejection>>(move error)
    }
  }
  return match move selected {
    Option<Shared<StaticData>>.Some {value} => Result.succeed<BodyExpression, Shared<Rejection>>(
      BodyExpression.Embedded {value: move value},
    )
    Option<Shared<StaticData>>.None => Result.failResult<BodyExpression, Shared<Rejection>>(
      run reject(&resolver.*, module, RejectionCode.InvalidConstant, span),
    )
  }
}

// This loan is short: the machine resumes only after the reached constant's query facts
// have been recorded on the same active provider dependency ledger.
effect fn staticResolveNeeded<'source>(
  port: &mut StaticPort<'source>,
  module: &ModuleId,
  declaration: &Shared<DeclarationId>,
  span: Span,
) -> Result<Option<Shared<StaticData>>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let located = run constantKey(&mut port.resolver.*, declaration)
  let constant = match move located {
    Option<Key>.Some {value} => value
    Option<Key>.None => {
      return Result.failResult<Option<Shared<StaticData>>, Shared<Rejection>>(
        run reject(&port.resolver.*, module, RejectionCode.InvalidConstant, span),
      )
    }
  }
  let declared = run demandChild(&mut port.resolver.*, &mut port.query.*, &mut port.dependencies.*, constant, span)
  let referencedType = Shared.with<Result<Answer, NoRejection>, TypeSelection>(&declared, selectedType)
  if let Option<Shared<Rejection>>.Some {value} = move referencedType.rejected {
    return Result.failResult<Option<Shared<StaticData>>, Shared<Rejection>>(move value)
  }
  return run constantInitializer(&mut port.resolver.*, &mut port.query.*, &mut port.dependencies.*, constant, span)
}

/// Resolves the constant a static evaluation needed and supplies it as a binding. Answers whether
/// a binding was supplied, so the caller can evaluate again.
effect fn supplyNeededConstant<'source>(
  machine: &mut StaticExecution.Machine<'source>,
  bindings: &mut Vector<StaticBinding>,
  reached: StaticNeeded,
  failedSpan: Span,
) -> Result<bool, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let resolved = run staticResolveNeeded(
    StaticExecution.port(&mut machine.*), &reached.module, &reached.declaration, failedSpan,
  )
  let constant = match move resolved {
    Result<Option<Shared<StaticData>>, Shared<Rejection>>.Success {value} => move value
    Result<Option<Shared<StaticData>>, Shared<Rejection>>.Failure {error} => {
      return Result.failResult<bool, Shared<Rejection>>(move error)
    }
  }
  if let Option<Shared<StaticData>>.Some {value: found} = move constant {
    run Vector.append<StaticBinding>(
      &mut bindings.*, StaticBinding {
        module: move reached.module, binder: reached.expression, value: move found,
      },
    )
    return Result.succeed<bool, Shared<Rejection>>(true)
  }
  return Result.succeed<bool, Shared<Rejection>>(false)
}

/// Settles a failed static evaluation. Answers `None` after supplying a needed constant, so the
/// caller can evaluate again, and otherwise the rejection that ends evaluation.
effect fn staticEvaluationRejection<'source>(
  machine: &mut StaticExecution.Machine<'source>,
  bindings: &mut Vector<StaticBinding>,
  module: &ModuleId,
  failure: StaticDiagnostic | OutOfMemoryError,
) -> Option<Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  match move failure {
    StaticDiagnostic {fault, code, span: failedSpan, target: diagnosticTarget, message, origin, byteOffset, rejection, needed, missing, trace} => {
      if let Option<Shared<Rejection>>.Some {value: rejected} = move rejection {
        return Option.some<Shared<Rejection>>(move rejected)
      }
      if let Option<StaticNeeded>.Some {value: reached} = move needed {
        if StaticExecution.steps(&machine.*) >= 10000 {
          let port = StaticExecution.port(&mut machine.*)
          return Option.some<Shared<Rejection>>(
            run rejectStatic(
              &port.resolver.*, module,
              StaticDiagnostic {
                fault: StaticFault.StepLimit, code: b"SEM0179", span: failedSpan,
                target: diagnosticTarget, message: Option.none<Bytes>(), origin: Option.none<Span>(),
                byteOffset: Option.none<u64>(),
                rejection: Option.none<Shared<Rejection>>(),
                needed: Option.none<StaticNeeded>(), missing: Option.none<StaticExecution.MissingFact>(),
                trace: move trace,
              },
            ),
          )
        }
        let supplied = run supplyNeededConstant(&mut machine.*, &mut bindings.*, move reached, failedSpan)
        let bound = match move supplied {
          Result<bool, Shared<Rejection>>.Success {value} => value
          Result<bool, Shared<Rejection>>.Failure {error} => {
            return Option.some<Shared<Rejection>>(move error)
          }
        }
        if bound {
          return Option.none<Shared<Rejection>>()
        }
      }
      let port = StaticExecution.port(&mut machine.*)
      return Option.some<Shared<Rejection>>(
        run rejectStatic(
          &port.resolver.*, module,
          StaticDiagnostic {
            fault: fault, code: code, span: failedSpan, target: diagnosticTarget,
            message: move message, origin: origin, byteOffset: byteOffset,
            rejection: Option.none<Shared<Rejection>>(),
            needed: Option.none<StaticNeeded>(), missing: move missing, trace: move trace,
          },
        ),
      )
    }
    OutOfMemoryError {} => { fail OutOfMemoryError {} }
  }
}

effect fn staticExpression(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  module: &ModuleId,
  declaration: Option<usize>,
  id: HirId,
  expectation: StaticRootExpectation,
) -> Result<Shared<StaticData>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let span = run staticSpan(&mut resolver.*, module, id)
  let binders = Vector.make<StaticRootBinder>()
  let checkedAnswer = Result.succeed<Answer, NoRejection>(run checkedStaticRoot(
    &mut resolver.*, &mut owner.*, &mut dependencies.*,
    module, move declaration, id, move expectation,
    Vector.asSlice<StaticRootBinder>(&binders),
  ))
  let checked = match move StaticExecution.checkedRoot(&checkedAnswer) {
    Option<StaticExecution.CheckedRoot>.Some {value} => value
    Option<StaticExecution.CheckedRoot>.None => {
      if let Option<Shared<Rejection>>.Some {value} = move answerRejection(&checkedAnswer) {
        return Result.failResult<Shared<StaticData>, Shared<Rejection>>(move value)
      }
      return Result.failResult<Shared<StaticData>, Shared<Rejection>>(
        run reject(&resolver.*, module, RejectionCode.InvalidConstant, span),
      )
    }
  }
  let target = resolver.target
  let mut machine = run StaticExecution.make(
    inFlightStaticPort(&mut resolver.*, &mut owner.*, &mut dependencies.*),
    module,
    StaticExecution.Limits {steps: 10000, depth: 64, valueBytes: 1048576},
  )
  let mut bindings = Vector.make<StaticBinding>()
  while StaticExecution.steps(&machine) < 10000 {
    let supplied = Vector.asSlice<StaticBinding>(&bindings)
    let outcome = run Effect.result(StaticExecution.evaluate(
      &mut machine, &checked, supplied, id,
    ))
    match move outcome {
      Result<Shared<StaticData>, StaticDiagnostic | OutOfMemoryError>.Success {value} => {
        return Result.succeed<Shared<StaticData>, Shared<Rejection>>(move value)
      }
      Result<Shared<StaticData>, StaticDiagnostic | OutOfMemoryError>.Failure {error: evaluationFailure} => {
        let ended = run staticEvaluationRejection(
          &mut machine, &mut bindings, module, move evaluationFailure,
        )
        if let Option<Shared<Rejection>>.Some {value: rejected} = move ended {
          return Result.failResult<Shared<StaticData>, Shared<Rejection>>(move rejected)
        }
      }
    }
  }
  let port = StaticExecution.port(&mut machine)
  return Result.failResult<Shared<StaticData>, Shared<Rejection>>(
    run rejectStatic(
      &port.resolver.*, module,
      StaticDiagnostic {
        fault: StaticFault.StepLimit, code: b"SEM0179", span: span,
        target: target, message: Option.none<Bytes>(), origin: Option.none<Span>(),
        byteOffset: Option.none<u64>(),
        rejection: Option.none<Shared<Rejection>>(),
        needed: Option.none<StaticNeeded>(), missing: Option.none<StaticExecution.MissingFact>(),
        trace: Vector.make<StaticExecution.TraceStep>(),
      },
    ),
  )
}

effect fn resolveInitializer(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  key: Key,
) -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let module = run resolvedModule(&resolver.*, key.module)
  let mut dependencies = Vector.make<Dependency>()
  let declared = run demandChild(
    &mut resolver.*, &mut owner.*, &mut dependencies,
    Key {
      family: Family.Constant, module: key.module, name: usize.ZERO,
      declaration: key.declaration, member: usize.ZERO, external: false,
    },
    Span.make(usize.ZERO, usize.ZERO),
  )
  let selected = Shared.with<Result<Answer, NoRejection>, TypeSelection>(&declared, selectedType)
  if let Option<Shared<Rejection>>.Some {value} = move selected.rejected {
    return memberRejected(move value, move dependencies)
  }
  let ty = match move selected.resolved {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => {
      return memberRejected(
        run reject(&resolver.*, &module, RejectionCode.InvalidConstant, Span.make(usize.ZERO, usize.ZERO)),
        move dependencies,
      )
    }
  }
  let mut fallback = Span.make(usize.ZERO, usize.ZERO)
  let declaredHeader = run header(&mut resolver.*, &module, key.declaration)
  if let Option<HeaderSyntax>.Some {value} = move declaredHeader { fallback = value.span }
  let written = run initializerSyntax(&mut resolver.*, &module, key.declaration, fallback)
  let expression = match move written.expression {
    Option<HirId>.Some {value} => value
    Option<HirId>.None => {
      return memberRejected(
        run reject(&resolver.*, &module, RejectionCode.InvalidConstant, written.span),
        move dependencies,
      )
    }
  }
  let attempted = run staticExpression(
    &mut resolver.*, &mut owner.*, &mut dependencies,
    &module, Option.some<usize>(key.declaration), expression,
    StaticRootExpectation.Resolved {ty: Shared.clone<Type>(&ty)},
  )
  match move attempted {
    Result<Shared<StaticData>, Shared<Rejection>>.Success {value} => {
      if StaticConstant.matchesShared(&ty, &value) {
        return memberSuccess(Value.Initializer {value: move value}, move dependencies)
      }
      return memberRejected(
        run reject(&resolver.*, &module, RejectionCode.TypeMismatch, written.span),
        move dependencies,
      )
    }
    Result<Shared<StaticData>, Shared<Rejection>>.Failure {error} => {
      return memberRejected(move error, move dependencies)
    }
  }
}

// MODULE-STATIC-002: a module-level `static if` evaluates its condition as an ordinary static
// `bool` expression. Only arms a demand reaches are selected; inactive declarations stay unchecked.
effect fn resolveCondition(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  key: Key,
) -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let module = run resolvedModule(&resolver.*, key.module)
  let mut dependencies = Vector.make<Dependency>()
  let written = run header(&mut resolver.*, &module, key.declaration)
  let mut condition = Option.none<HirId>()
  let mut span = Span.make(usize.ZERO, usize.ZERO)
  if let Option<HeaderSyntax>.Some {value: syntax} = move written {
    span = syntax.span
    if let Node.ConditionalHeader {condition: expression} = syntax.header {
      condition = Option.some<HirId>(expression)
    }
  }
  let root = match move condition {
    Option<HirId>.Some {value} => value
    Option<HirId>.None => {
      return memberRejected(run reject(&resolver.*, &module, RejectionCode.Unsupported, span), move dependencies)
    }
  }
  let evaluated = run staticExpression(
    &mut resolver.*, &mut owner.*, &mut dependencies,
    &module, Option.some<usize>(key.declaration), root, StaticRootExpectation.Inferred,
  )
  let data = match move evaluated {
    Result<Shared<StaticData>, Shared<Rejection>>.Success {value} => value
    Result<Shared<StaticData>, Shared<Rejection>>.Failure {error} => {
      return memberRejected(move error, move dependencies)
    }
  }
  let flag = Shared.with<StaticData, Option<bool>>(&data, fn(fact: &StaticData) -> Option<bool> {
    return match &fact.* {
      StaticData.Boolean {value: answer} => Option.some<bool>(answer)
      _ => Option.none<bool>()
    }
  })
  if let Option<bool>.Some {value: holds} = move flag {
    return memberSuccess(Value.Condition {holds: holds}, move dependencies)
  }
  let conditionSpan = run staticSpan(&mut resolver.*, &module, root)
  return memberRejected(
    run reject(&resolver.*, &module, RejectionCode.ConditionNotBool, conditionSpan),
    move dependencies,
  )
}

fn checkedRootType(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Body {body, ..}} => Shared.with<TypedBody, Option<Shared<Type>>>(
        &body,
        fn(checked: &TypedBody) -> Option<Shared<Type>> {
          let root = TypedBody.rootNode(checked)
          let nodes = TypedBody.nodeSlice(checked)
          if root.index < nodes.length {
            if let BodyNodeKind.Expression {ty, ..} = &nodes[root.index].kind {
              return Option.some<Shared<Type>>(Shared.clone<Type>(&ty))
            }
          }
          return Option.none<Shared<Type>>()
        },
      )
      _ => Option.none<Shared<Type>>()
    }
    Result<Answer, NoRejection>.Failure {error: _} => Option.none<Shared<Type>>()
  }
}

fn checkedRootMatches(
  answer: &Result<Answer, NoRejection>,
  observed: &Observation,
  declaration: &DeclarationId,
  syntax: HirId,
) -> bool {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Body {body, source}} => {
        let sameSource = Shared.with<Observation, bool>(
          &source,
          fn(saved: &Observation) -> bool { return Observation.equals(saved, observed) },
        )
        if !sameSource {
          return false
        }
        return Shared.with<TypedBody, bool>(&body, fn(checked: &TypedBody) -> bool {
          let root = TypedBody.rootNode(checked)
          let nodes = TypedBody.nodeSlice(checked)
          return DeclarationId.equals(TypedBody.declarationId(checked), declaration) &&
            root.index < nodes.length && nodes[root.index].origin.syntax.index == syntax.index
        })
      }
      _ => false
    }
    Result<Answer, NoRejection>.Failure {error: _} => false
  }
}

fn staticParameterPosition(hir: &Module, header: HirId, syntax: HirId) -> Option<usize> {
  if let Node.FunctionHeader {contract, ..} = Module.node(hir, header) {
    if let Node.CallableContract {parameters, ..} = Module.node(hir, contract) {
      let mut at = usize.ZERO
      while at < parameters.length {
        let parameter = Module.child(hir, parameters, at)
        if parameter.index == syntax.index {
          if let Node.Parameter {mode, ..} = Module.node(hir, parameter) {
            if mode == ParameterMode.Static {
              return Option.some<usize>(at)
            }
          }
          return Option.none<usize>()
        }
        at = at + usize.ONE
      }
    }
  }
  return Option.none<usize>()
}

fn bareExtentTree(hir: &Module, expression: HirId) -> bool {
  return match Module.node(hir, expression) {
    Node.IntegerLiteral {suffix, ..} => !suffix.present
    Node.InfixExpression {operator, left, right, ..} => {
      if operator != InfixOperator.Add && operator != InfixOperator.Subtract &&
        operator != InfixOperator.Multiply && operator != InfixOperator.Divide &&
        operator != InfixOperator.Remainder && operator != InfixOperator.BitAnd &&
        operator != InfixOperator.BitOr && operator != InfixOperator.BitXor {
        return false
      }
      return bareExtentTree(hir, left) && bareExtentTree(hir, right)
    }
    _ => false
  }
}

effect fn staticRootAnnotationType(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  module: &ModuleId,
  moduleOrdinal: usize,
  declarationOrdinal: usize,
  syntax: HirId,
  genericBinders: &[Binder],
) -> Result<Shared<Type>, Shared<Rejection>> ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let mut elision = LifetimeElision {
    owner: run declarationAt(&mut resolver.*, module, declarationOrdinal),
    nextOrdinal: genericBinders.length,
    output: false,
    resultDefault: Option.none<Shared<Lifetime>>(),
    generated: Vector.make<Shared<Lifetime>>(),
    invocation: false,
    nested: false,
    renumber: Vector.make<usize>(),
    staticEnvironment: false,
    supplied: Option.none<Vector<Argument>>(),
    assumptions: Option.none<Vector<Constraint>>(),
  }
  return run resolveType(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies.*,
    moduleOrdinal,
    syntax,
    genericBinders,
    &mut elision,
  )
}

/// Array extents can be checked while their written type is being resolved. The nearest
/// enclosing declaration owns the retained HIR IDs and source observation. Answers `usize.MAX`
/// when no declaration encloses the root.
fn nearestEnclosingDeclaration(hir: &Module, declarations: &[IndexedDeclaration], root: HirId) -> usize {
  let candidateSpan = Module.span(hir, root)
  let mut ordinal = usize.MAX
  let mut at = usize.ZERO
  let mut width = usize.MAX
  while at < declarations.length {
    let span = Module.span(hir, declarations[at].local)
    if span.start <= candidateSpan.start && candidateSpan.end <= span.end && span.end - span.start < width {
      ordinal = at
      width = span.end - span.start
    }
    at = at + usize.ONE
  }
  return ordinal
}

/// Whether a static body may call the declaration, which must itself be `static`.
effect fn staticCallAllowed(resolver: &mut Resolver, calledDeclaration: &DeclarationId) -> bool
! Cycle | OutOfMemoryError
? &mut Allocator {
  let called = run DeclarationId.copy(calledDeclaration)
  let targetModuleOrdinal = knownModuleOrdinal(&resolver.*, DeclarationId.moduleId(&called))
  if targetModuleOrdinal == usize.MAX {
    return false
  }
  let targetModule = run resolvedModule(&resolver.*, targetModuleOrdinal)
  let sharedCalled = run Shared.make<DeclarationId>(move called)
  let selected = run ordinalOfIdentity(&mut resolver.*, &targetModule, &sharedCalled)
  if let Option<usize>.Some {value: position} = move selected {
    let written = run signatureSyntax(&mut resolver.*, &targetModule, position)
    if let Option<WrittenSignature>.Some {value} = move written {
      return value.isStatic
    }
  }
  return false
}

/// The span of the first node a static body may not contain: an interface call, or a call to a
/// declaration that is not `static`.
effect fn staticPhaseViolation(resolver: &mut Resolver, nodes: &[BodyNode]) -> Option<Span>
! Cycle | OutOfMemoryError
? &mut Allocator {
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {form: BodyExpression.InterfaceCall {..}, ..} = &nodes[at].kind {
      return Option.some<Span>(nodes[at].origin.span)
    }
    if let BodyNodeKind.Expression {
      form: BodyExpression.DirectCall {declaration: calledDeclaration, ..},
      ..,
    } = &nodes[at].kind {
      let allowed = run staticCallAllowed(&mut resolver.*, &calledDeclaration)
      if !allowed {
        return Option.some<Span>(nodes[at].origin.span)
      }
    }
    at = at + usize.ONE
  }
  return Option.none<Span>()
}

/// Checks only the expression selected for static evaluation. Inactive arms of a mixed body
/// never enter this checker, so they retain static-if selection silence.
effect fn checkedStaticRoot(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  module: &ModuleId,
  declaration: Option<usize>,
  root: HirId,
  expectation: StaticRootExpectation,
  binders: &[StaticRootBinder],
) -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let sourceAnswer = run source(&mut resolver.*, module)
  let mut writtenCalls = Vector.make<CallSyntax>()
  let mut rootSpan = Span.make(usize.ZERO, usize.ZERO)
  let mut ordinal = usize.MAX
  let mut extentLiteralTree = false
  if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(
    &resolver.*,
    &sourceAnswer,
    module,
  ) {
    let hir = IndexedSource.authored(indexed)
    extentLiteralTree = bareExtentTree(hir, root)
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(indexed))
    if let Option<usize>.Some {value} = &declaration {
      ordinal = value
    } else {
      ordinal = nearestEnclosingDeclaration(hir, declarations, root)
    }
    if ordinal >= declarations.length {
      return rejectedBody(
        run reject(
          &resolver.*,
          module,
          RejectionCode.Unsupported,
          Span.make(usize.ZERO, usize.ZERO),
        ),
        Vector.make<Dependency>(),
      )
    }
    let declarationSpan = Module.span(hir, declarations[ordinal].local)
    rootSpan = Module.span(hir, root)
    if rootSpan.start < declarationSpan.start || rootSpan.end > declarationSpan.end {
      return rejectedBody(
        run reject(&resolver.*, module, RejectionCode.Unsupported, rootSpan),
        Vector.make<Dependency>(),
      )
    }
    let mut rootAnnotations = Vector.make<HirId>()
    run collectCall(hir, root, &mut rootAnnotations, &mut writtenCalls)
  } else {
    return rejectedBody(
      run reject(
        &resolver.*,
        module,
        RejectionCode.MissingModule,
        Span.make(usize.ZERO, usize.ZERO),
      ),
      Vector.make<Dependency>(),
    )
  }
  let template = run templateBinders(&mut resolver.*, module, ordinal)
  let genericBinders = match move template {
    Result<Vector<Binder>, Shared<Rejection>>.Success {value} => value
    Result<Vector<Binder>, Shared<Rejection>>.Failure {error} => {
      return rejectedBody(move error, Vector.make<Dependency>())
    }
  }
  let moduleOrdinal = run internModule(&mut resolver.*, module)
  let mut expected = Option.none<Shared<Type>>()
  match move expectation {
    StaticRootExpectation.Inferred => {}
    StaticRootExpectation.Boolean => {
      expected = Option.some<Shared<Type>>(run primitiveType(b"bool"))
    }
    StaticRootExpectation.IntegerExtent => {
      if extentLiteralTree {
        expected = Option.some<Shared<Type>>(run primitiveType(b"u64"))
      }
    }
    StaticRootExpectation.Resolved {ty} => {
      expected = Option.some<Shared<Type>>(move ty)
    }
    StaticRootExpectation.Annotation {syntax} => {
      let resolved = run staticRootAnnotationType(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies.*,
        module,
        moduleOrdinal,
        ordinal,
        syntax,
        Vector.asSlice<Binder>(&genericBinders),
      )
      expected = match move resolved {
        Result<Shared<Type>, Shared<Rejection>>.Success {value} => Option.some<Shared<Type>>(
          move value,
        )
        Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
          return rejectedBody(move error, Vector.make<Dependency>())
        }
      }
    }
  }
  let mut resolvedCalls = Vector.make<ResolvedCall>()
  let calls = Vector.asSlice<CallSyntax>(&writtenCalls)
  let mut callAt = usize.ZERO
  while callAt < calls.length {
    let result = run callTarget(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies.*,
      module,
      moduleOrdinal,
      &calls[callAt],
      Vector.asSlice<Binder>(&genericBinders),
      Vector.asSlice<Constraint>(&Vector.make<Constraint>()),
    )
    run Vector.append<ResolvedCall>(
      &mut resolvedCalls,
      ResolvedCall {id: calls[callAt].id, result: move result},
    )
    callAt = callAt + usize.ONE
  }
  let available = run SourceIndex.authoredCursor(&mut resolver.source, &sourceAnswer, module)
  let cursor = match move available {
    Option<AuthoredCursor>.Some {value} => value
    Option<AuthoredCursor>.None => {
      return rejectedBody(
        run reject(&resolver.*, module, RejectionCode.Unsupported, rootSpan),
        Vector.make<Dependency>(),
      )
    }
  }
  let mut locals = Vector.make<BodyLocal>()
  let observed = run SourceIndex.captureObservation(&resolver.source, module)
  let identity = run declarationAt(&mut resolver.*, module, ordinal)
  let ownerIdentity = match move identity {
    Option<DeclarationId>.Some {value} => value
    Option<DeclarationId>.None => {
      return rejectedBody(
        run reject(&resolver.*, module, RejectionCode.Unsupported, rootSpan),
        Vector.make<Dependency>(),
      )
    }
  }
  let mut binderAt = usize.ZERO
  while binderAt < binders.length {
    let mut syntax = HirId {index: usize.ZERO}
    let mut selectedType = Option.none<Shared<Type>>()
    match & binders[binderAt] {
      StaticRootBinder.Parameter {syntax: parameter} => {
        syntax = parameter
        let mut position = Option.none<usize>()
        if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(
          &resolver.*,
          &sourceAnswer,
          module,
        ) {
          let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(indexed))
          position = staticParameterPosition(
            IndexedSource.authored(indexed),
            declarations[ordinal].header,
            syntax,
          )
        }
        let parameterAt = match move position {
          Option<usize>.Some {value} => value
          Option<usize>.None => {
            return rejectedBody(
              run reject(
                &resolver.*,
                module,
                RejectionCode.StaticPhaseViolation,
                run bodySpan(&resolver.source, &cursor, syntax),
              ),
              Vector.make<Dependency>(),
            )
          }
        }
        let signature = run demandChild(
          &mut resolver.*,
          &mut owner.*,
          &mut dependencies.*,
          Key {
            family: Family.Signature,
            module: moduleOrdinal,
            name: usize.ZERO,
            declaration: ordinal,
            member: usize.ZERO,
            external: false,
          },
          rootSpan,
        )
        let failure = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
          &signature,
          answerRejection,
        )
        if let Option<Shared<Rejection>>.Some {value: diagnostic} = move failure {
          return rejectedBody(move diagnostic, Vector.make<Dependency>())
        }
        selectedType = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
          &signature,
          fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> {
            return signatureParameter(answer, parameterAt)
          },
        )
      }
      StaticRootBinder.Iteration {syntax: forStatement, evidence} => {
        let written = run bodyNode(&resolver.source, &cursor, forStatement)
        let mut iterable = HirId {index: usize.MAX}
        let mut body = HirId {index: usize.MAX}
        if let Node.StaticForStatement {binding, iterable: expression, body: block} = written {
          syntax = binding
          iterable = expression
          body = block
        }
        if iterable.index == usize.MAX {
          return rejectedBody(run reject(&resolver.*, module, RejectionCode.StaticPhaseViolation, rootSpan), Vector.make<Dependency>())
        }
        let bodyRange = run bodySpan(&resolver.source, &cursor, body)
        if rootSpan.start < bodyRange.start || rootSpan.end > bodyRange.end {
          return rejectedBody(run reject(&resolver.*, module, RejectionCode.StaticPhaseViolation, rootSpan), Vector.make<Dependency>())
        }
        let checked = StaticExecution.iterationChecked(&evidence)
        if !Shared.with<Result<Answer, NoRejection>, bool>(&checked, fn(answer: &Result<Answer, NoRejection>) -> bool {
          return checkedRootMatches(answer, &observed, &ownerIdentity, iterable)
        }) {
          return rejectedBody(run reject(&resolver.*, module, RejectionCode.StaticPhaseViolation, rootSpan), Vector.make<Dependency>())
        }
        selectedType = StaticExecution.iterationType(&evidence)
      }
      StaticRootBinder.Binding {syntax: binding, checked} => {
        syntax = binding
        let mut initializer = HirId {index: usize.MAX}
        let mut annotation = HirId {index: usize.MAX}
        if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(
          &resolver.*,
          &sourceAnswer,
          module,
        ) {
          let hir = IndexedSource.authored(indexed)
          if syntax.index < Vector.length<Node>(&hir.nodes) {
            if let Node.BindingStatement {isStatic, initializer: written, annotation: declared, ..} = Module.node(
              hir,
              syntax,
            ) {
              if isStatic && Module.span(hir, syntax).end <= rootSpan.start {
                initializer = written
                if declared.present {
                  annotation = declared.id
                }
              }
            }
          }
        }
        if initializer.index == usize.MAX {
          return rejectedBody(
            run reject(&resolver.*, module, RejectionCode.StaticPhaseViolation, rootSpan),
            Vector.make<Dependency>(),
          )
        }
        let matches = Shared.with<Result<Answer, NoRejection>, bool>(
          &checked,
          fn(answer: &Result<Answer, NoRejection>) -> bool {
            return checkedRootMatches(answer, &observed, &ownerIdentity, initializer)
          },
        )
        if !matches {
          return rejectedBody(
            run reject(
              &resolver.*,
              module,
              RejectionCode.Unsupported,
              run bodySpan(&resolver.source, &cursor, syntax),
            ),
            Vector.make<Dependency>(),
          )
        }
        selectedType = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
          &checked,
          checkedRootType,
        )
        if annotation.index != usize.MAX {
          let resolved = run staticRootAnnotationType(
            &mut resolver.*,
            &mut owner.*,
            &mut dependencies.*,
            module,
            moduleOrdinal,
            ordinal,
            annotation,
            Vector.asSlice<Binder>(&genericBinders),
          )
          let declaredType = match move resolved {
            Result<Shared<Type>, Shared<Rejection>>.Success {value} => value
            Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
              return rejectedBody(move error, Vector.make<Dependency>())
            }
          }
          let matching = match & selectedType {
            Option<Shared<Type>>.Some {value} => run Type.equalsShared(&value, &declaredType)
            Option<Shared<Type>>.None => false
          }
          if !matching {
            return rejectedBody(
              run reject(
                &resolver.*,
                module,
                RejectionCode.TypeMismatch,
                run bodySpan(&resolver.source, &cursor, annotation),
              ),
              Vector.make<Dependency>(),
            )
          }
        }
      }
    }
    let ty = match move selectedType {
      Option<Shared<Type>>.Some {value} => value
      Option<Shared<Type>>.None => {
        return rejectedBody(
          run reject(&resolver.*, module, RejectionCode.Unsupported, rootSpan),
          Vector.make<Dependency>(),
        )
      }
    }
    run Vector.append<BodyLocal>(
      &mut locals,
      BodyLocal {
        origin: BodyOrigin {syntax: syntax, span: run bodySpan(&resolver.source, &cursor, syntax)},
        ty: move ty,
        mutable: false,
        meetDepth: Option.none<usize>(),
      },
    )
    binderAt = binderAt + usize.ONE
  }
  let mut nodes = Vector.make<BodyNode>()
  let mut signatureDependencies = Vector.make<SignatureDependency>()
  let mut requiredBodies = Vector.make<DeclarationId>()
  let constraints = Vector.make<Constraint>()
  let mut request = Request.make()
  let noAnnotations = Vector.make<ResolvedAnnotation>()
  let unitResult = run Shared.make<Type>(Type.Unit)
  let mut statementScope = StatementScope {locals: &mut locals, annotations: Vector.asSlice<ResolvedAnnotation>(&noAnnotations),
    resultType: &unitResult, loopDepth: usize.ZERO}
  // A static root is its own body outside every Effect; its relations never join an enclosing body.
  run Vector.append<BodyFrame>(&mut resolver.*.bodies, BodyFrame {isEffect: false,
    failure: run Shared.make<Type>(Type.Union {members: Vector.make<Shared<Type>>()}),
    requirements: run Shared.make<Row>(Row.empty()), derived: Option.none<DerivedChannels>(),
    obligations: Vector.make<BodySafetyObligation>(), occurrences: Vector.make<SelectedFact>()})
  let checked = run checkExpression(
    &mut resolver.*,
    &mut owner.*,
    &mut request,
    &mut dependencies.*,
    module,
    &cursor,
    &ownerIdentity,
    &mut statementScope,
    Vector.asSlice<ResolvedCall>(&resolvedCalls),
    &mut nodes,
    &mut signatureDependencies,
    &mut requiredBodies,
    root,
    &expected,
    Vector.asSlice<Constraint>(&constraints),
    false,
    true,
    false,
  )
  let relations = leaveBodyFrame(&mut resolver.*)
  drop statementScope
  let rootNode = match move checked {
    Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
    Result<BodyNodeId, Shared<Rejection>>.Failure {error} => {
      return rejectedBody(move error, Vector.make<Dependency>())
    }
  }
  let violation = run staticPhaseViolation(&mut resolver.*, Vector.asSlice<BodyNode>(&nodes))
  if let Option<Span>.Some {value: violatingSpan} = move violation {
    return rejectedBody(
      run reject(&resolver.*, module, RejectionCode.StaticPhaseViolation, violatingSpan),
      Vector.make<Dependency>(),
    )
  }
  let selectedInput = run SourceIndex.bodyInput(&mut resolver.source, &sourceAnswer, module, ordinal)
  let input = match move selectedInput {
    Option<Shared<BodyInput>>.Some {value: captured} => move captured
    Option<Shared<BodyInput>>.None => {
      return rejectedBody(run reject(&resolver.*, module, RejectionCode.Unsupported, rootSpan), Vector.make<Dependency>())
    }
  }
  let indexed = match move sourceOf(&resolver.*, &sourceAnswer, module) {
    Option<&IndexedSource>.Some {value} => value
    Option<&IndexedSource>.None => {
      return rejectedBody(
        run reject(&resolver.*, module, RejectionCode.Unsupported, rootSpan),
        Vector.make<Dependency>(),
      )
    }
  }
  let mut stage = BodyStage.FullyChecked
  if Vector.length<BodySafetyObligation>(&relations) > usize.ZERO {
    stage = BodyStage.ContractTyped {obligations: move relations}
  }
  let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(indexed))
  let declaration = &declarations[ordinal].identity
  let body = run TypedBody.make(
    declaration,
    move input,
    move locals,
    move nodes,
    rootNode,
    move signatureDependencies,
    Vector.make<DeclarationId>(),
    move stage,
    Vector.make<SelectedFact>(),
  )
  return memberSuccess(
    Value.Body {
      body: run Shared.make<TypedBody>(move body),
      source: run Shared.make<Observation>(
        run Observation.copy(IndexedSource.sourceObservation(indexed)),
      ),
    },
    Vector.make<Dependency>(),
  )
}

effect fn storeMir(resolver: &mut Resolver, function: MirFunction, dependencies: Vector<Dependency>) -> Answer
! OutOfMemoryError
? &mut Allocator {
  let index = Vector.length<MirFunction>(&resolver.mirValues)
  run Vector.append<MirFunction>(&mut resolver.*.mirValues, move function)
  return memberSuccess(Value.Mir {index: index}, move dependencies)
}

// A semantic deferral reached while preparing MIR retains its exact authored diagnostic.
// Genuine errors remain rejected; only the centralized named coverage codes become gaps.
effect fn mirRejection(identity: &Shared<DeclarationId>, diagnostic: Shared<Rejection>, dependencies: Vector<Dependency>) -> Answer
! OutOfMemoryError ? &mut Allocator {
  let code = Shared.with<Rejection, Option<GapCode>>(&diagnostic, fn(value: &Rejection) -> Option<GapCode> {
    return BackendGap.forRejection(value.code)
  })
  if let Option<GapCode>.Some {value} = move code {
    return memberSuccess(Value.Unsupported {
      gap: run Shared.make<BackendGap>(BackendGap.fromRejection(value, identity, &diagnostic)),
    }, move dependencies)
  }
  return memberRejected(move diagnostic, move dependencies)
}

fn bodyCoverageGap(hir: &Module, span: Span) -> GapCode {
  let mut at = usize.ZERO
  while at < Module.length(hir) {
    let id = HirId {index: at}
    let origin = Module.span(hir, id)
    if origin.start == span.start && origin.end == span.end {
      match Module.node(hir, id) {
        // An `effect fn` contract the checker defers (Step 9).
        Node.CallableContract {isEffect, ..} => {
          if isEffect { return GapCode.EffectForm }
        }
        Node.FieldExpression {..} => {
          return GapCode.FieldProjection
        }
        Node.OrdinalExpression {..} => {
          return GapCode.FieldProjection
        }
        Node.IndexExpression {..} => {
          return GapCode.IndexProjection
        }
        _ => ()
      }
    }
    at = at + usize.ONE
  }
  return GapCode.TypedForm
}


// MIR preparation either lacks a lowering form or failed to canonicalize a complete semantic
// region domain. The latter is a source diagnostic, never an invented declaration-level gap.
union PreparationFailure {
  Coverage {code: GapCode},
  Canonicalization {reason: CanonicalizationFailure},
  Rejected {diagnostic: Shared<Rejection>},
}

// Preserve the caller's actual source origin when a complete key cannot be formed.
effect fn preparationAnswer(resolver: &Resolver, identity: &Shared<DeclarationId>, module: &ModuleId,
  span: Span, failure: PreparationFailure, dependencies: Vector<Dependency>) -> Answer
! OutOfMemoryError ? &mut Allocator {
  return match move failure {
    PreparationFailure.Coverage {code} => memberSuccess(Value.Unsupported {
      gap: run Shared.make<BackendGap>(BackendGap.make(code, identity, span))}, move dependencies)
    PreparationFailure.Canonicalization {..} => memberRejected(
      run reject(resolver, module, RejectionCode.Unsupported, span), move dependencies)
    PreparationFailure.Rejected {diagnostic} => memberRejected(move diagnostic, move dependencies)
  }
}

// Generated glue queries cache refusal without a requesting source origin. The actual body or
// worklist caller anchors canonicalization failure when it consumes this completed fact.
// Diagnostics keep the ordinary MIR rule: a backend-category refusal remains a gap carrying it.
effect fn preparationQueryAnswer(identity: &Shared<DeclarationId>, failure: PreparationFailure,
  dependencies: Vector<Dependency>) -> Answer ! OutOfMemoryError ? &mut Allocator {
  return match move failure {
    PreparationFailure.Coverage {code} => memberSuccess(Value.Unsupported {
      gap: run Shared.make<BackendGap>(BackendGap.make(code, identity, Span.make(usize.ZERO, usize.ZERO)))}, move dependencies)
    PreparationFailure.Canonicalization {reason} => memberSuccess(
      Value.CanonicalizationFailed {reason: reason}, move dependencies)
    PreparationFailure.Rejected {diagnostic} => run mirRejection(identity, move diagnostic, move dependencies)
  }
}

// Root requests have no operand span. In that lane only, locate the authentic original header;
// a missing source identity is an invalid module path, never a fabricated zero-span refusal.
effect fn authoredRequestSpan(resolver: &mut Resolver, sourceOwner: &DeclarationId, span: Span) -> Span
! Cycle | InvalidModulePath | OutOfMemoryError ? &mut Allocator {
  if span.start != usize.ZERO || span.end != usize.ZERO { return span }
  let module = DeclarationId.moduleId(sourceOwner)
  let identity = run Shared.make<DeclarationId>(run DeclarationId.copy(sourceOwner))
  let ordinal = match move run ordinalOfIdentity(&mut resolver.*, module, &identity) {
    Option<usize>.Some {value} => value
    _ => { fail InvalidModulePath {} }
  }
  let authored = match move run header(&mut resolver.*, module, ordinal) {
    Option<HeaderSyntax>.Some {value} => value
    _ => { fail InvalidModulePath {} }
  }
  return authored.span
}

effect fn canonicalRejection(resolver: &mut Resolver, sourceOwner: &DeclarationId, span: Span) -> Shared<Rejection>
! Cycle | InvalidModulePath | OutOfMemoryError ? &mut Allocator {
  let anchor = run authoredRequestSpan(&mut resolver.*, sourceOwner, span)
  return run reject(&resolver.*, DeclarationId.moduleId(sourceOwner), RejectionCode.Unsupported, anchor)
}

// The query member that selects an instance's MIR producer: an ordinary or selected body, the C
// entry shim, drop glue, or a C export shim.
fn instanceMember(instance: &InstanceKey) -> usize {
  return match &instance.* {
    InstanceKey.Function {..} => usize.ZERO
    InstanceKey.Entry {..} => usize.MAX
    InstanceKey.DropGlue {..} => usize.MAX - usize.ONE
    InstanceKey.Export {..} => exportMember()
  }
}

// The query member of a C export shim; distinct from the entry, glue and every selected body.
fn exportMember() -> usize { return usize.MAX - 2 }

// One glue child, or absence when its type mentions no declaration that could own cleanup.
effect fn glueChild(index: usize, ty: &Shared<Type>, sourceOwner: &DeclarationId)
-> Result<Option<GlueChild>, PreparationFailure> ! OutOfMemoryError ? &mut Allocator {
  let keyed = match move run InstanceKey.dropGlue(ty, sourceOwner) {
    Result<Option<InstanceKey>, CanonicalizationFailure>.Success {value} => move value
    Result<Option<InstanceKey>, CanonicalizationFailure>.Failure {error: reason} => {
      return Result.failResult<Option<GlueChild>, PreparationFailure>(PreparationFailure.Canonicalization {reason: reason})
    }
  }
  return match move keyed {
    Option<InstanceKey>.Some {value} => Result.succeed<Option<GlueChild>, PreparationFailure>(
      Option.some<GlueChild>(GlueChild {index: index, ty: Shared.clone<Type>(ty), glue: move value}))
    Option<InstanceKey>.None => Result.succeed<Option<GlueChild>, PreparationFailure>(Option.none<GlueChild>())
  }
}

// Whether a glue child of `ty` runs cleanup: its owned structure carries `impl Drop`.
effect fn glueNeeds(resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>, dependencies: &mut Vector<Dependency>,
  ty: &Shared<Type>) -> Result<bool, PreparationFailure>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let mut visiting = Vector.make<Shared<Type>>()
  let premises = Vector.make<Constraint>()
  return match move run cleanupFree(&mut resolver.*, &mut owner.*, &mut dependencies.*, ty, Vector.asSlice<Constraint>(&premises),
    &mut visiting, Span.make(usize.ZERO, usize.ZERO)) {
    Result<bool, Shared<Rejection>>.Success {value} => Result.succeed<bool, PreparationFailure>(!value)
    Result<bool, Shared<Rejection>>.Failure {error} => Result.failResult<bool, PreparationFailure>(PreparationFailure.Rejected {diagnostic: move error})
  }
}

// Appends the children among `types` that need cleanup, keyed by position. Failure without a
// rejection means one has no glue.
effect fn appendGlueChildren(resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>, dependencies: &mut Vector<Dependency>,
  children: &mut Vector<GlueChild>, types: &[Shared<Type>], sourceOwner: &DeclarationId) -> Result<(), PreparationFailure>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < types.length {
    let needed = match move run glueNeeds(&mut resolver.*, &mut owner.*, &mut dependencies.*, &types[at]) {
      Result<bool, PreparationFailure>.Success {value} => value
      Result<bool, PreparationFailure>.Failure {error} => { return Result.failResult<(), PreparationFailure>(move error) }
    }
    if needed {
      let keyedChild = match move run glueChild(at, &types[at], sourceOwner) {
        Result<Option<GlueChild>, PreparationFailure>.Success {value: childKey} => move childKey
        Result<Option<GlueChild>, PreparationFailure>.Failure {error: diagnostic} => {
          return Result.failResult<(), PreparationFailure>(move diagnostic)
        }
      }
      let child = match move keyedChild {
        Option<GlueChild>.Some {value} => value
        Option<GlueChild>.None => { return Result.failResult<(), PreparationFailure>(PreparationFailure.Coverage {code: GapCode.Cleanup}) }
      }
      run Vector.append<GlueChild>(&mut children.*, move child)
    }
    at = at + usize.ONE
  }
  return Result.succeed<(), PreparationFailure>(())
}

// The children a value of `ty` cleans after its Drop hook. Failure without a rejection is a cleanup
// form this backend cannot lower yet: an Effect environment, a generic nominal union, or
// a type whose member shapes have no layout.
effect fn glueChildren(resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>, dependencies: &mut Vector<Dependency>,
  ty: &Shared<Type>, sourceOwner: &DeclarationId) -> Result<GlueChildren, PreparationFailure>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let unsupported = Result.failResult<GlueChildren, PreparationFailure>(PreparationFailure.Coverage {code: GapCode.Cleanup})
  let node = run Type.copy(ty)
  if let Type.Array {element, ..} = &node {
    let count = match move Type.arrayShape(ty) {
      Option<ArrayShape>.Some {value: shape} => shape.length
      Option<ArrayShape>.None => { return move unsupported }
    }
    let needed = match move run glueNeeds(&mut resolver.*, &mut owner.*, &mut dependencies.*, &element) {
      Result<bool, PreparationFailure>.Success {value} => value
      Result<bool, PreparationFailure>.Failure {error} => { return Result.failResult<GlueChildren, PreparationFailure>(move error) }
    }
    if !needed {
      return Result.succeed<GlueChildren, PreparationFailure>(GlueChildren.Fields {fields: Vector.make<GlueChild>()})
    }
    let keyedElement = match move run glueChild(usize.ZERO, &element, sourceOwner) {
      Result<Option<GlueChild>, PreparationFailure>.Success {value: childKey} => move childKey
      Result<Option<GlueChild>, PreparationFailure>.Failure {error: diagnostic} => {
        return Result.failResult<GlueChildren, PreparationFailure>(move diagnostic)
      }
    }
    return match move keyedElement {
      Option<GlueChild>.Some {value} => Result.succeed<GlueChildren, PreparationFailure>(GlueChildren.Elements {element: move value, count: count})
      Option<GlueChild>.None => move unsupported
    }
  }
  if let Type.Union {..} = &node {
    let members = match move run Type.canonicalUnionMembers(ty) {
      Option<Vector<Shared<Type>>>.Some {value} => value
      Option<Vector<Shared<Type>>>.None => { return move unsupported }
    }
    let mut children = Vector.make<GlueChild>()
    let appended = run appendGlueChildren(&mut resolver.*, &mut owner.*, &mut dependencies.*, &mut children, Vector.asSlice<Shared<Type>>(&members), sourceOwner)
    if let Result<(), PreparationFailure>.Failure {error} = move appended {
      return Result.failResult<GlueChildren, PreparationFailure>(move error)
    }
    return Result.succeed<GlueChildren, PreparationFailure>(GlueChildren.Members {
      members: move children, count: Vector.length<Shared<Type>>(&members),
    })
  }
  let recordFields = run Type.recordFields(ty)
  if let Option<Vector<Shared<Type>>>.Some {value: members} = move recordFields {
    let mut children = Vector.make<GlueChild>()
    let appended = run appendGlueChildren(&mut resolver.*, &mut owner.*, &mut dependencies.*, &mut children, Vector.asSlice<Shared<Type>>(&members), sourceOwner)
    if let Result<(), PreparationFailure>.Failure {error} = move appended {
      return Result.failResult<GlueChildren, PreparationFailure>(move error)
    }
    return Result.succeed<GlueChildren, PreparationFailure>(GlueChildren.Fields {fields: move children})
  }
  if !Shared.with<Type, bool>(ty, isNominalType) { return move unsupported }
  let moduleOrdinal = declaringModuleOrdinal(&resolver.*, ty)
  if moduleOrdinal == usize.MAX { return move unsupported }
  let module = run resolvedModule(&resolver.*, moduleOrdinal)
  let declaration = match move run ordinalOfProvider(&mut resolver.*, &module, ty) {
    Option<usize>.Some {value} => value
    Option<usize>.None => { return move unsupported }
  }
  let written = match move run header(&mut resolver.*, &module, declaration) {
    Option<HeaderSyntax>.Some {value} => value
    Option<HeaderSyntax>.None => { return move unsupported }
  }
  // A scalar enum is Copy and never admits a Drop hook (ENUM-003).
  if let Node.EnumHeader {..} = written.header {
    return Result.succeed<GlueChildren, PreparationFailure>(GlueChildren.Fields {fields: Vector.make<GlueChild>()})
  }
  if let Node.UnionHeader {variants, ..} = written.header {
    let nominal = NominalUnion {module: moduleOrdinal, declaration: declaration, count: variants.length}
    let mut listed = Vector.make<GlueVariant>()
    let mut tag = usize.ZERO
    while tag < nominal.count {
      let shape = match move run variantShape(&mut resolver.*, &mut owner.*, &mut dependencies.*, &module, ty, &nominal, tag, written.span) {
        Result<VariantShape, Shared<Rejection>>.Success {value} => value
        Result<VariantShape, Shared<Rejection>>.Failure {error} => {
          return Result.failResult<GlueChildren, PreparationFailure>(PreparationFailure.Rejected {diagnostic: move error})
        }
      }
      let mut fields = Vector.make<GlueChild>()
      let appended = run appendGlueChildren(&mut resolver.*, &mut owner.*, &mut dependencies.*, &mut fields, Vector.asSlice<Shared<Type>>(&shape.types), sourceOwner)
      if let Result<(), PreparationFailure>.Failure {error} = move appended {
        return Result.failResult<GlueChildren, PreparationFailure>(move error)
      }
      if Vector.length<GlueChild>(&fields) > usize.ZERO {
        run Vector.append<GlueVariant>(&mut listed, GlueVariant {tag: tag, fields: move fields})
      }
      tag = tag + usize.ONE
    }
    return Result.succeed<GlueChildren, PreparationFailure>(GlueChildren.Variants {variants: move listed, count: nominal.count})
  }
  let mut count = usize.MAX
  if let Node.StructHeader {fields, ..} = written.header { count = fields.length }
  if let Node.TupleHeader {elements, ..} = written.header { count = elements.length }
  if count == usize.MAX { return move unsupported }
  let application = run internApplication(&mut resolver.*, ty)
  let mut types = Vector.make<Shared<Type>>()
  let mut at = usize.ZERO
  while at < count {
    let shaped = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, Key {
      family: Family.MemberShape, module: moduleOrdinal, name: application, declaration: declaration, member: at, external: false,
    }, written.span)
    let rejected = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(&shaped, answerRejection)
    if let Option<Shared<Rejection>>.Some {value} = move rejected {
      return Result.failResult<GlueChildren, PreparationFailure>(PreparationFailure.Rejected {diagnostic: move value})
    }
    let field = match move Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(&shaped, singleMemberType) {
      Option<Shared<Type>>.Some {value} => value
      Option<Shared<Type>>.None => { return move unsupported }
    }
    run Vector.append<Shared<Type>>(&mut types, move field)
    at = at + usize.ONE
  }
  let mut children = Vector.make<GlueChild>()
  let appended = run appendGlueChildren(&mut resolver.*, &mut owner.*, &mut dependencies.*, &mut children, Vector.asSlice<Shared<Type>>(&types), sourceOwner)
  if let Result<(), PreparationFailure>.Failure {error} = move appended {
    return Result.failResult<GlueChildren, PreparationFailure>(move error)
  }
  return Result.succeed<GlueChildren, PreparationFailure>(GlueChildren.Fields {fields: move children})
}

fn dropMember(answer: &Result<Answer, NoRejection>) -> Option<Shared<DeclarationId>> {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.ImplementationMembers {members}} = &value.outcome {
      let listed = Vector.asSlice<ImplementationMember>(&members)
      let mut at = usize.ZERO
      while at < listed.length {
        if let ImplementationMember.Inline {declaration, ..} = &listed[at] {
          if Shared.with<DeclarationId, bool>(&declaration, fn(value: &DeclarationId) -> bool { return DeclarationId.named(value, b"drop") }) {
            return Option.some<Shared<DeclarationId>>(Shared.clone<DeclarationId>(&declaration))
          }
        }
        at = at + usize.ONE
      }
    }
  }
  return Option.none<Shared<DeclarationId>>()
}

// The provider's sealed `impl Drop` head, found through the implementation query of the module
// that may own it rather than by spelling; absence for a type with no hook (DROP-002).
effect fn dropImplementation(resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>, dependencies: &mut Vector<Dependency>,
  ty: &Shared<Type>, declared: &[Constraint]) -> Result<Option<SealedMatch>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let span = Span.make(usize.ZERO, usize.ZERO)
  if !Shared.with<Type, bool>(ty, isNominalType) { return Result.succeed<Option<SealedMatch>, Shared<Rejection>>(Option.none<SealedMatch>()) }
  let moduleOrdinal = declaringModuleOrdinal(&resolver.*, ty)
  if moduleOrdinal == usize.MAX { return Result.succeed<Option<SealedMatch>, Shared<Rejection>>(Option.none<SealedMatch>()) }
  let siteModule = run resolvedModule(&resolver.*, moduleOrdinal)
  let listed = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, Key {
    family: Family.Implementations, module: moduleOrdinal, name: usize.ZERO, declaration: usize.ZERO, member: usize.ZERO, external: false,
  }, span)
  let failed = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(&listed, answerRejection)
  if let Option<Shared<Rejection>>.Some {value} = move failed {
    return Result.failResult<Option<SealedMatch>, Shared<Rejection>>(move value)
  }
  let count = Shared.with<Result<Answer, NoRejection>, usize>(&listed, implementationCount)
  let mut hookImpl = Option.none<SealedMatch>()
  let mut at = usize.ZERO
  while at < count {
    let candidate = Shared.with<Result<Answer, NoRejection>, Option<Shared<ImplementationHead>>>(&listed,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<ImplementationHead>> { return implementationAt(answer, at) })
    if let Option<Shared<ImplementationHead>>.Some {value: head} = move candidate {
      let applies = run sealedHeadMatch(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies.*,
        &head,
        ty,
        SealedProperty.Drop,
        declared,
        &siteModule,
        span,
      )
      let matched = match move applies {
        Result<Option<SealedMatch>, Shared<Rejection>>.Success {value} => value
        Result<Option<SealedMatch>, Shared<Rejection>>.Failure {error} => {
          return Result.failResult<Option<SealedMatch>, Shared<Rejection>>(move error)
        }
      }
      if let Option<SealedMatch>.Some {value} = move matched {
        hookImpl = Option.some<SealedMatch>(move value)
      }
    }
    at = at + usize.ONE
  }
  return Result.succeed<Option<SealedMatch>, Shared<Rejection>>(move hookImpl)
}

// The instance of the provider's `impl Drop` hook, found through the sealed-property implementation
// query rather than by spelling. The hook's own elided borrow lifetime takes `'static`, which the
// runtime identity erases; the impl's binders come from its exact provider-head match.
effect fn dropHook(resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>, dependencies: &mut Vector<Dependency>,
  ty: &Shared<Type>) -> Result<Option<InstanceKey>, PreparationFailure>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let span = Span.make(usize.ZERO, usize.ZERO)
  let declared = Vector.make<Constraint>()
  let implementation = match move run dropImplementation(&mut resolver.*, &mut owner.*, &mut dependencies.*, ty, Vector.asSlice<Constraint>(&declared)) {
    Result<Option<SealedMatch>, Shared<Rejection>>.Success {value: found} => match move found {
      Option<SealedMatch>.Some {value} => value
      Option<SealedMatch>.None => { return Result.succeed<Option<InstanceKey>, PreparationFailure>(Option.none<InstanceKey>()) }
    }
    Result<Option<SealedMatch>, Shared<Rejection>>.Failure {error} => {
      return Result.failResult<Option<InstanceKey>, PreparationFailure>(PreparationFailure.Rejected {diagnostic: move error})
    }
  }
  let moduleOrdinal = declaringModuleOrdinal(&resolver.*, ty)
  let unsupported = Result.failResult<Option<InstanceKey>, PreparationFailure>(PreparationFailure.Coverage {code: GapCode.Cleanup})
  let module = run resolvedModule(&resolver.*, moduleOrdinal)
  let implOrdinal = match move run ordinalOfIdentity(&mut resolver.*, &module, &implementation.declaration) {
    Option<usize>.Some {value} => value
    Option<usize>.None => { return move unsupported }
  }
  let members = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, Key {
    family: Family.ImplementationMembers, module: moduleOrdinal, name: usize.ZERO, declaration: implOrdinal, member: usize.ZERO, external: false,
  }, span)
  let membersFailed = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(&members, answerRejection)
  if let Option<Shared<Rejection>>.Some {value} = move membersFailed {
    return Result.failResult<Option<InstanceKey>, PreparationFailure>(PreparationFailure.Rejected {diagnostic: move value})
  }
  let hook = match move Shared.with<Result<Answer, NoRejection>, Option<Shared<DeclarationId>>>(&members, dropMember) {
    Option<Shared<DeclarationId>>.Some {value} => run DeclarationId.copyShared(&value)
    Option<Shared<DeclarationId>>.None => { return move unsupported }
  }
  let mut request = Request.make()
  let schema = match move run resolveTargetSchema(&mut resolver.*, &mut owner.*, &mut request, &mut dependencies.*, true, &hook, span) {
    Option<TargetSchema>.Some {value} => value
    Option<TargetSchema>.None => { return move unsupported }
  }
  let slots = Vector.asSlice<ApplicationSlot>(&schema.own)
  let mut arguments = Vector.make<Argument>()
  let mut at = usize.ZERO
  while at < slots.length {
    if slots[at].kind != GenericKind.Lifetime { return move unsupported }
    run Vector.append<Argument>(&mut arguments, Argument.Lifetime {value: run Shared.make<Lifetime>(Lifetime.Static)})
    at = at + usize.ONE
  }
  let mut scopes = Vector.make<ScopeBinding>()
  let expected = Vector.asSlice<ApplicationScope>(&schema.scopes)
  at = usize.ZERO
  while at < expected.length {
    let scopeOwner = run DeclarationId.copyShared(&expected[at].owner)
    let scopeSlots = Vector.asSlice<ApplicationSlot>(&expected[at].slots)
    let mut values = Vector.make<Argument>()
    let mut index = usize.ZERO
    while index < scopeSlots.length {
      let argument = match move bindingArgument(Vector.asSlice<Binding>(&implementation.bindings), &scopeOwner, scopeSlots[index].ordinal) {
        Option<Argument>.Some {value} => value
        Option<Argument>.None => { return move unsupported }
      }
      run Vector.append<Argument>(&mut values, move argument)
      index = index + usize.ONE
    }
    run Vector.append<ScopeBinding>(&mut scopes, ScopeBinding {
      owner: Shared.clone<DeclarationId>(&expected[at].owner), arguments: move values,
      argumentOrdinals: run applicationOrdinals(scopeSlots),
    })
    at = at + usize.ONE
  }
  let application = Application {target: SpecializationTarget.Named {declaration: move hook}, arguments: move arguments,
    argumentOrdinals: run applicationOrdinals(slots), scopes: move scopes, statics: Vector.make<StaticSlot>()}
  if !run TargetSchema.accepts(&schema, &application) { return move unsupported }
  let hookKey = match move run InstanceKey.function(move application) {
    Result<InstanceKey, CanonicalizationFailure>.Success {value: canonicalKey} => move canonicalKey
    Result<InstanceKey, CanonicalizationFailure>.Failure {error: reason} => {
      return Result.failResult<Option<InstanceKey>, PreparationFailure>(PreparationFailure.Canonicalization {reason: reason})
    }
  }
  return Result.succeed<Option<InstanceKey>, PreparationFailure>(Option.some<InstanceKey>(move hookKey))
}

// The root and size of one consuming site whose recorded place is a projection, read under a short
// body borrow: its owner local (or MAX), its match subject node (or MAX), its step count and the
// moved value's type.
struct PartialSite {
  local: usize
  subject: usize
  steps: usize
  moved: Shared<Type>
}

fn consumedOf(kind: &BodyNodeKind) -> Option<&BodyConsumedPlace> {
  return match &kind.* {
    BodyNodeKind.Expression {form, ..} => match &form {
      BodyExpression.Move {consumed, ..} => recordedPlace(&consumed)
      BodyExpression.Match {access, ..} => match &access {
        BodySubjectAccess.Consume {consumed} => recordedPlace(&consumed)
        _ => Option.none<&BodyConsumedPlace>()
      }
      _ => Option.none<&BodyConsumedPlace>()
    }
    BodyNodeKind.Drop {consumed, ..} => recordedPlace(&consumed)
    _ => Option.none<&BodyConsumedPlace>()
  }
}

fn recordedPlace(consumed: &Option<BodyConsumedPlace>) -> Option<&BodyConsumedPlace> {
  return match &consumed.* {
    Option<BodyConsumedPlace>.Some {value} => Option.some<&BodyConsumedPlace>(&value)
    Option<BodyConsumedPlace>.None => Option.none<&BodyConsumedPlace>()
  }
}

fn partialSiteAt(body: &TypedBody, at: usize) -> Option<PartialSite> {
  let nodes = TypedBody.nodeSlice(body)
  let consumed = match move consumedOf(&nodes[at].kind) {
    Option<&BodyConsumedPlace>.Some {value} => value
    Option<&BodyConsumedPlace>.None => { return Option.none<PartialSite>() }
  }
  let steps = Vector.length<BodyPlaceStep>(&consumed.steps)
  let mut local = usize.MAX
  let mut subject = usize.MAX
  match &consumed.root {
    BodyPlaceRoot.Local {local: root} => { local = root.index }
    BodyPlaceRoot.Subject {subject: root} => { subject = root.index }
  }
  if steps == usize.ZERO { return Option.none<PartialSite>() }
  // A drop's moved value is its operand; a move's or match's is the node's own value.
  let mut typed = at
  if let BodyNodeKind.Drop {value, ..} = &nodes[at].kind { typed = value.index }
  if let BodyNodeKind.Expression {form: BodyExpression.Match {subject: matched, ..}, ..} = &nodes[at].kind { typed = matched.index }
  if let BodyNodeKind.Expression {ty, ..} = &nodes[typed].kind {
    return Option.some<PartialSite>(PartialSite {local: local, subject: subject, steps: steps, moved: Shared.clone<Type>(&ty)})
  }
  return Option.none<PartialSite>()
}

// The arms of a consuming match at node `at`, or zero for any other node.
fn consumingArmCount(body: &TypedBody, at: usize) -> usize {
  let nodes = TypedBody.nodeSlice(body)
  return match &nodes[at].kind {
    BodyNodeKind.Expression {form: BodyExpression.Match {access: BodySubjectAccess.Consume {..}, arms, ..}, ..} => Vector.length<BodyMatchArm>(&arms)
    _ => usize.ZERO
  }
}

// A by-value binding declared at node `at` that owns a projection of its consumed subject.
fn bindingSiteAt(body: &TypedBody, at: usize) -> Option<PartialSite> {
  let nodes = TypedBody.nodeSlice(body)
  if let BodyNodeKind.Expression {ty, form: BodyExpression.PatternBinding {subject, path, access}} = &nodes[at].kind {
    let steps = Vector.length<BodyPlaceStep>(&path)
    if access == BodyBindingAccess.Moved && steps != usize.ZERO {
      return Option.some<PartialSite>(PartialSite {local: usize.MAX, subject: subject.index, steps: steps, moved: Shared.clone<Type>(&ty)})
    }
  }
  return Option.none<PartialSite>()
}

fn partialStepAt(body: &TypedBody, at: usize, step: usize) -> Option<BodyPlaceStep> {
  let nodes = TypedBody.nodeSlice(body)
  if let Option<&BodyConsumedPlace>.Some {value: consumed} = move consumedOf(&nodes[at].kind) {
    return copiedStep(Vector.asSlice<BodyPlaceStep>(&consumed.steps), step)
  }
  if let BodyNodeKind.Expression {form: BodyExpression.PatternBinding {path, ..}, ..} = &nodes[at].kind {
    return copiedStep(Vector.asSlice<BodyPlaceStep>(&path), step)
  }
  return Option.none<BodyPlaceStep>()
}

fn copiedStep(steps: &[BodyPlaceStep], step: usize) -> Option<BodyPlaceStep> {
  if step >= steps.length { return Option.none<BodyPlaceStep>() }
  return match &steps[step] {
    BodyPlaceStep.Member {tag, ty, source} => Option.some<BodyPlaceStep>(BodyPlaceStep.Member {tag: tag, ty: Shared.clone<Type>(&ty), source: Shared.clone<Type>(&source)})
    BodyPlaceStep.VariantField {tag, field} => Option.some<BodyPlaceStep>(BodyPlaceStep.VariantField {tag: tag, field: field})
    BodyPlaceStep.Field {index} => Option.some<BodyPlaceStep>(BodyPlaceStep.Field {index: index})
    BodyPlaceStep.Element {index} => Option.some<BodyPlaceStep>(BodyPlaceStep.Element {index: index})
  }
}

fn localTypeAt(body: &TypedBody, local: usize) -> Shared<Type> {
  let locals = TypedBody.localSlice(body)
  return Shared.clone<Type>(&locals[local].ty)
}

fn nodeTypeAt(body: &TypedBody, at: usize) -> Option<Shared<Type>> {
  let nodes = TypedBody.nodeSlice(body)
  if let BodyNodeKind.Expression {ty, ..} = &nodes[at].kind { return Option.some<Shared<Type>>(Shared.clone<Type>(&ty)) }
  return Option.none<Shared<Type>>()
}

// The child type one step selects among the children glue would drop, if that child needs cleanup.
fn steppedChild(children: &GlueChildren, step: &BodyPlaceStep) -> Option<Shared<Type>> {
  let listed = match &children.* {
    GlueChildren.Fields {fields} => match &step.* {
      BodyPlaceStep.Field {index} => childType(&fields, index)
      _ => Option.none<Shared<Type>>()
    }
    GlueChildren.Elements {element, ..} => match &step.* {
      BodyPlaceStep.Element {..} => Option.some<Shared<Type>>(Shared.clone<Type>(&element.ty))
      _ => Option.none<Shared<Type>>()
    }
    GlueChildren.Members {members, ..} => match &step.* {
      BodyPlaceStep.Member {tag, ..} => childType(&members, tag)
      _ => Option.none<Shared<Type>>()
    }
    GlueChildren.Variants {variants, ..} => match &step.* {
      BodyPlaceStep.VariantField {tag, field} => {
        let listed = Vector.asSlice<GlueVariant>(&variants)
        let mut at = usize.ZERO
        while at < listed.length {
          if listed[at].tag == tag { return childType(&listed[at].fields, field) }
          at = at + usize.ONE
        }
        return Option.none<Shared<Type>>()
      }
      _ => Option.none<Shared<Type>>()
    }
  }
  return move listed
}

fn childType(children: &Vector<GlueChild>, index: usize) -> Option<Shared<Type>> {
  let listed = Vector.asSlice<GlueChild>(children)
  let mut at = usize.ZERO
  while at < listed.length {
    if listed[at].index == index { return Option.some<Shared<Type>>(Shared.clone<Type>(&listed[at].ty)) }
    at = at + usize.ONE
  }
  return Option.none<Shared<Type>>()
}

effect fn stepProjection(step: &BodyPlaceStep) -> MirProjection ! OutOfMemoryError ? &mut Allocator {
  return match &step.* {
    BodyPlaceStep.Field {index} => MirProjection.Field {index: index}
    BodyPlaceStep.Element {index} => MirProjection.ConstIndex {index: index}
    BodyPlaceStep.Member {tag, ty, ..} => MirProjection.Payload {index: tag, ty: Shared.clone<Type>(&ty)}
    BodyPlaceStep.VariantField {tag, field} => MirProjection.VariantField {variant: tag, field: field}
  }
}

// Cleanup uses the same complete physical union map as payload access and match tags.
effect fn projectedPartialStep(step: &BodyPlaceStep, bindings: &[Binding], projections: &[RuntimeProjection])
  -> Option<BodyPlaceStep> ! OutOfMemoryError ? &mut Allocator {
  match &step.* {
    BodyPlaceStep.Member {tag, source, ..} => {
      let mapped = run UnionProjection.member(&source, tag, bindings, projections)
      return match move mapped {
        Option<UnionProjection.Member>.Some {value} => Option.some<BodyPlaceStep>(
          BodyPlaceStep.Member {tag: value.tag, ty: move value.ty, source: Shared.clone<Type>(&source)})
        _ => Option.none<BodyPlaceStep>()
      }
    }
    BodyPlaceStep.Field {index} => { return Option.some<BodyPlaceStep>(BodyPlaceStep.Field {index: index}) }
    BodyPlaceStep.Element {index} => { return Option.some<BodyPlaceStep>(BodyPlaceStep.Element {index: index}) }
    BodyPlaceStep.VariantField {tag, field} => {
      return Option.some<BodyPlaceStep>(BodyPlaceStep.VariantField {tag: tag, field: field})
    }
  }
}

// For each consuming site that moves a projection needing cleanup, and each by-value binding of a
// consuming match that owns such a projection of its evaluated subject (MATCH-002), the owners its
// path leaves and the children each would still drop. A site whose owners have no recipe gets
// none, and lowering reports the `cleanup` gap there.
effect fn partialRemainders(resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>, dependencies: &mut Vector<Dependency>,
  module: &ModuleId, sourceOwner: &DeclarationId, typed: &Shared<TypedBody>, bindings: &[Binding], projections: &[RuntimeProjection]) -> Result<Vector<Remainder>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let mut remainders = Vector.make<Remainder>()
  let count = Shared.with<TypedBody, usize>(typed, fn(body: &TypedBody) -> usize { return TypedBody.nodeSlice(body).length })
  let mut at = usize.ZERO
  while at < count {
    let site = Shared.with<TypedBody, Option<PartialSite>>(typed, fn(body: &TypedBody) -> Option<PartialSite> { return partialSiteAt(body, at) })
    if let Option<PartialSite>.Some {value: found} = move site {
      match move run siteRemainder(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, sourceOwner, typed, at, &found, bindings, projections) {
        Result<Option<Remainder>, Shared<Rejection>>.Success {value} => {
          if let Option<Remainder>.Some {value: remainder} = move value { run Vector.append<Remainder>(&mut remainders, move remainder) }
        }
        Result<Option<Remainder>, Shared<Rejection>>.Failure {error} => { return Result.failResult<Vector<Remainder>, Shared<Rejection>>(move error) }
      }
    }
    let arms = Shared.with<TypedBody, usize>(typed, fn(body: &TypedBody) -> usize { return consumingArmCount(body, at) })
    let mut arm = usize.ZERO
    while arm < arms {
      let mut binding = usize.ZERO
      while true {
        let declaration = match move TypedBody.armBinding(typed, BodyNodeId {index: at}, arm, binding) {
          Option<BodyNodeId>.Some {value} => value
          Option<BodyNodeId>.None => { break }
        }
        let bound = Shared.with<TypedBody, Option<PartialSite>>(typed, fn(body: &TypedBody) -> Option<PartialSite> { return bindingSiteAt(body, declaration.index) })
        if let Option<PartialSite>.Some {value: found} = move bound {
          match move run siteRemainder(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, sourceOwner, typed, declaration.index, &found, bindings, projections) {
            Result<Option<Remainder>, Shared<Rejection>>.Success {value} => {
              if let Option<Remainder>.Some {value: remainder} = move value { run Vector.append<Remainder>(&mut remainders, move remainder) }
            }
            Result<Option<Remainder>, Shared<Rejection>>.Failure {error} => { return Result.failResult<Vector<Remainder>, Shared<Rejection>>(move error) }
          }
        }
        binding = binding + usize.ONE
      }
      arm = arm + usize.ONE
    }
    at = at + usize.ONE
  }
  return Result.succeed<Vector<Remainder>, Shared<Rejection>>(move remainders)
}

// The remainder of one site `at` whose moved value needs cleanup, or none when it needs none or its
// owners have no recipe.
effect fn siteRemainder(resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>, dependencies: &mut Vector<Dependency>,
  module: &ModuleId, sourceOwner: &DeclarationId, typed: &Shared<TypedBody>, at: usize, found: &PartialSite, bindings: &[Binding], projections: &[RuntimeProjection])
  -> Result<Option<Remainder>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let declared = Vector.make<Constraint>()
  let moved = run RuntimeType.applyBindings(&found.moved, bindings, projections)
  let mut visiting = Vector.make<Shared<Type>>()
  let free = match move run cleanupFree(&mut resolver.*, &mut owner.*, &mut dependencies.*, &moved, Vector.asSlice<Constraint>(&declared),
    &mut visiting, Span.make(usize.ZERO, usize.ZERO)) {
    Result<bool, Shared<Rejection>>.Success {value} => value
    Result<bool, Shared<Rejection>>.Failure {error} => { return Result.failResult<Option<Remainder>, Shared<Rejection>>(move error) }
  }
  if free { return Result.succeed<Option<Remainder>, Shared<Rejection>>(Option.none<Remainder>()) }
  let local = found.local
  let subject = found.subject
  let mut root = Option.none<Shared<Type>>()
  if local != usize.MAX {
    root = Option.some<Shared<Type>>(Shared.with<TypedBody, Shared<Type>>(typed, fn(body: &TypedBody) -> Shared<Type> { return localTypeAt(body, local) }))
  } else {
    root = Shared.with<TypedBody, Option<Shared<Type>>>(typed, fn(body: &TypedBody) -> Option<Shared<Type>> { return nodeTypeAt(body, subject) })
  }
  let written = match move root {
    Option<Shared<Type>>.Some {value} => value
    Option<Shared<Type>>.None => { return Result.succeed<Option<Remainder>, Shared<Rejection>>(Option.none<Remainder>()) }
  }
  let mut current = run RuntimeType.applyBindings(&written, bindings, projections)
  let mut steps = Vector.make<MirProjection>()
  let mut levels = Vector.make<RemainderLevel>()
  let mut step = usize.ZERO
  while step < found.steps {
    let selected = Shared.with<TypedBody, Option<BodyPlaceStep>>(typed, fn(body: &TypedBody) -> Option<BodyPlaceStep> { return partialStepAt(body, at, step) })
    let path = match move selected {
      Option<BodyPlaceStep>.Some {value} => value
      Option<BodyPlaceStep>.None => { return Result.succeed<Option<Remainder>, Shared<Rejection>>(Option.none<Remainder>()) }
    }
    let span = Shared.with<TypedBody, Span>(typed,
      fn(body: &TypedBody) -> Span { return TypedBody.nodeSlice(body)[at].origin.span })
    let physical = match move run projectedPartialStep(&path, bindings, projections) {
      Option<BodyPlaceStep>.Some {value} => move value
      Option<BodyPlaceStep>.None => {
        return Result.failResult<Option<Remainder>, Shared<Rejection>>(
          run reject(&resolver.*, module, RejectionCode.UnionFormUnavailable, span))
      }
    }
    let hook = match move run dropImplementation(&mut resolver.*, &mut owner.*, &mut dependencies.*, &current, Vector.asSlice<Constraint>(&declared)) {
      Result<Option<SealedMatch>, Shared<Rejection>>.Success {value} => value
      Result<Option<SealedMatch>, Shared<Rejection>>.Failure {error} => { return Result.failResult<Option<Remainder>, Shared<Rejection>>(move error) }
    }
    let hooked = match &hook {
      Option<SealedMatch>.Some {..} => true
      Option<SealedMatch>.None => false
    }
    let children = match move run glueChildren(&mut resolver.*, &mut owner.*, &mut dependencies.*, &current,
      sourceOwner) {
      Result<GlueChildren, PreparationFailure>.Success {value} => value
      Result<GlueChildren, PreparationFailure>.Failure {error} => match move error {
        PreparationFailure.Rejected {diagnostic} => { return Result.failResult<Option<Remainder>, Shared<Rejection>>(move diagnostic) }
        PreparationFailure.Coverage {..} => { return Result.succeed<Option<Remainder>, Shared<Rejection>>(Option.none<Remainder>()) }
        PreparationFailure.Canonicalization {..} => { return Result.failResult<Option<Remainder>, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.Unsupported, span)) }
      }
    }
    let next = match move steppedChild(&children, &physical) {
      Option<Shared<Type>>.Some {value} => value
      Option<Shared<Type>>.None => { return Result.succeed<Option<Remainder>, Shared<Rejection>>(Option.none<Remainder>()) }
    }
    run Vector.append<MirProjection>(&mut steps, run stepProjection(&physical))
    run Vector.append<RemainderLevel>(&mut levels, RemainderLevel {hooked: hooked, children: move children})
    current = run RuntimeType.project(&next, projections)
    step = step + usize.ONE
  }
  return Result.succeed<Option<Remainder>, Shared<Rejection>>(Option.some<Remainder>(Remainder {node: at, steps: move steps, levels: move levels}))
}

// The glue of one sealed core, following the bootstrap's cleanup: an allocation releases its
// system storage through its reclaim context, a raw buffer releases its allocation without
// discovering elements, and a shared core counts references and cleans its value and control block
// with the last handle.
effect fn resolveCoreGlue(resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>, dependencies: Vector<Dependency>,
  instance: InstanceKey, ty: &Shared<Type>, core: SealedKind, observing: bool) -> Answer
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let mut tracked = move dependencies
  let identity = InstanceKey.identity(&instance)
  let gap = Value.Unsupported {gap: run Shared.make<BackendGap>(BackendGap.make(GapCode.Cleanup, &identity, Span.make(usize.ZERO, usize.ZERO)))}
  let anchor = run DeclarationId.copyShared(&identity)
  if core == SealedKind.Allocation {
    let free = run SealedCore.cFunction(&anchor, SealedFunction.Free)
    let function = run DropGlue.lowerCore(move instance, ty, CoreCleanup.Allocation {free: move free}, observing)
    return run storeMir(&mut resolver.*, move function, move tracked)
  }
  let allocationType = run SealedCore.allocationBeside(&anchor)
  if core == SealedKind.RawBuffer {
    let allocationKey = match move run glueChild(SealedCore.ordinal(CoreField.BufferAllocation), &allocationType, &anchor) {
      Result<Option<GlueChild>, PreparationFailure>.Success {value: preparedChild} => move preparedChild
      Result<Option<GlueChild>, PreparationFailure>.Failure {error: failure} => {
        return run preparationQueryAnswer(&identity, move failure, move tracked)
      }
    }
    let allocation = match move allocationKey {
      Option<GlueChild>.Some {value} => value
      Option<GlueChild>.None => { return memberSuccess(move gap, move tracked) }
    }
    let mut fields = Vector.make<GlueChild>()
    run Vector.append<GlueChild>(&mut fields, move allocation)
    let function = run DropGlue.lower(DropGlue {key: move instance, ty: Shared.clone<Type>(ty), hook: Option.none<InstanceKey>(),
      children: GlueChildren.Fields {fields: move fields}}, observing)
    return run storeMir(&mut resolver.*, move function, move tracked)
  }
  // A package drops its body, readiness state and endpoint where they need cleanup, and then its
  // own allocation, which holds the package; the header holds no owned value while Initial.
  if core == SealedKind.ExecutionBlock {
    let listed = match move run SealedCore.fields(ty) {
      Option<Vector<Shared<Type>>>.Some {value} => value
      Option<Vector<Shared<Type>>>.None => { return memberSuccess(move gap, move tracked) }
    }
    let entries = Vector.asSlice<Shared<Type>>(&listed)
    let last = SealedCore.ordinal(CoreField.PackageAllocation)
    let mut fields = Vector.make<GlueChild>()
    let mut field = SealedCore.ordinal(CoreField.PackageBody)
    while field <= last {
      let mut needed = true
      if field < last {
        needed = match move run glueNeeds(&mut resolver.*, &mut owner.*, &mut tracked, &entries[field]) {
          Result<bool, PreparationFailure>.Success {value} => value
          Result<bool, PreparationFailure>.Failure {error} => { return run preparationQueryAnswer(&identity, move error, move tracked) }
        }
      }
      if needed {
        let prepared = match move run glueChild(field, &entries[field], &anchor) {
          Result<Option<GlueChild>, PreparationFailure>.Success {value: preparedChild} => move preparedChild
          Result<Option<GlueChild>, PreparationFailure>.Failure {error: failure} => {
            return run preparationQueryAnswer(&identity, move failure, move tracked)
          }
        }
        match move prepared {
          Option<GlueChild>.Some {value: child} => { run Vector.append<GlueChild>(&mut fields, move child) }
          Option<GlueChild>.None => { if field == last { return memberSuccess(move gap, move tracked) } }
        }
      }
      field = field + usize.ONE
    }
    let function = run DropGlue.lower(DropGlue {key: move instance, ty: Shared.clone<Type>(ty), hook: Option.none<InstanceKey>(),
      children: GlueChildren.Fields {fields: move fields}}, observing)
    return run storeMir(&mut resolver.*, move function, move tracked)
  }
  // An unstarted Execution releases its package through the package's own erased glue.
  if core == SealedKind.Execution {
    let result = match move SealedCore.element(ty) {
      Option<Shared<Type>>.Some {value} => value
      Option<Shared<Type>>.None => { return memberSuccess(move gap, move tracked) }
    }
    let header = run SealedCore.headerBeside(&anchor, &result)
    let function = run DropGlue.lowerCore(move instance, ty, CoreCleanup.Execution {header: move header}, observing)
    return run storeMir(&mut resolver.*, move function, move tracked)
  }
  if core != SealedKind.SharedCore { return memberSuccess(move gap, move tracked) }
  let element = match move SealedCore.element(ty) {
    Option<Shared<Type>>.Some {value} => value
    Option<Shared<Type>>.None => { return memberSuccess(move gap, move tracked) }
  }
  let needed = match move run glueNeeds(&mut resolver.*, &mut owner.*, &mut tracked, &element) {
    Result<bool, PreparationFailure>.Success {value} => value
    Result<bool, PreparationFailure>.Failure {error} => { return run preparationQueryAnswer(&identity, move error, move tracked) }
  }
  let mut value = Option.none<GlueChild>()
  if needed {
    let valueKey = match move run glueChild(SealedCore.ordinal(CoreField.BlockValue), &element, &anchor) {
      Result<Option<GlueChild>, PreparationFailure>.Success {value: preparedChild} => move preparedChild
      Result<Option<GlueChild>, PreparationFailure>.Failure {error: failure} => {
        return run preparationQueryAnswer(&identity, move failure, move tracked)
      }
    }
    value = match move valueKey {
      Option<GlueChild>.Some {value: child} => Option.some<GlueChild>(move child)
      Option<GlueChild>.None => { return memberSuccess(move gap, move tracked) }
    }
  }
  let allocationKey = match move run glueChild(SealedCore.ordinal(CoreField.BlockAllocation), &allocationType, &anchor) {
    Result<Option<GlueChild>, PreparationFailure>.Success {value: preparedChild} => move preparedChild
    Result<Option<GlueChild>, PreparationFailure>.Failure {error: failure} => {
      return run preparationQueryAnswer(&identity, move failure, move tracked)
    }
  }
  let allocation = match move allocationKey {
    Option<GlueChild>.Some {value: child} => child
    Option<GlueChild>.None => { return memberSuccess(move gap, move tracked) }
  }
  let block = match move run SealedCore.fieldType(ty, CoreField.CoreBlock) {
    Option<Shared<Type>>.Some {value: addressed} => addressed
    Option<Shared<Type>>.None => { return memberSuccess(move gap, move tracked) }
  }
  let function = run DropGlue.lowerCore(move instance, ty, CoreCleanup.Shared {block: move block, value: move value,
    allocation: move allocation}, observing)
  return run storeMir(&mut resolver.*, move function, move tracked)
}

// Drop glue reads its type's Drop hook and member shapes, never a function body. A cleanup form
// this backend cannot lower yet is the `cleanup` gap, attributed to the glue's owner declaration.
effect fn resolveGlueMir(resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>, instance: InstanceKey, ty: &Shared<Type>,
  observing: bool) -> Answer
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let mut dependencies = Vector.make<Dependency>()
  let identity = InstanceKey.identity(&instance)
  let gap = Value.Unsupported {gap: run Shared.make<BackendGap>(BackendGap.make(GapCode.Cleanup, &identity, Span.make(usize.ZERO, usize.ZERO)))}
  // A sealed core cleans its own storage; source can install no hook on it.
  if let Option<SealedKind>.Some {value: core} = move SealedCore.coreOf(ty) {
    return run resolveCoreGlue(&mut resolver.*, &mut owner.*, move dependencies, move instance, ty, core, observing)
  }
  let hook = match move run dropHook(&mut resolver.*, &mut owner.*, &mut dependencies, ty) {
    Result<Option<InstanceKey>, PreparationFailure>.Success {value} => value
    Result<Option<InstanceKey>, PreparationFailure>.Failure {error} => { return run preparationQueryAnswer(&identity, move error, move dependencies) }
  }
  let children = match move run glueChildren(&mut resolver.*, &mut owner.*, &mut dependencies, ty,
    &run DeclarationId.copyShared(&identity)) {
    Result<GlueChildren, PreparationFailure>.Success {value} => value
    Result<GlueChildren, PreparationFailure>.Failure {error} => { return run preparationQueryAnswer(&identity, move error, move dependencies) }
  }
  let function = run DropGlue.lower(DropGlue {key: move instance, ty: Shared.clone<Type>(ty), hook: move hook, children: move children}, observing)
  return run storeMir(&mut resolver.*, move function, move dependencies)
}

// An origin demand cannot read a body whose own checking is waiting on that origin. This
// boundary retains a precise unavailable result instead of publishing partial return evidence.
fn activeSemanticKey(resolver: &Resolver, key: Key) -> bool {
  let context = demandContext(resolver, key)
  let origin = originContext(resolver, key)
  let active = Vector.asSlice<Word>(&resolver.active)
  let keys = Vector.asSlice<ScopedKey>(&resolver.keys)
  let mut at = usize.ZERO
  while at < active.length {
    let scoped = &keys[u64.toUsize(active[at].value)]
    if scoped.application == resolver.currentApplication && scoped.profile == resolver.profileSlot
      && scoped.condition == context && sameOriginContext(&scoped.origin, &origin) && sameKey(scoped.key, key) { return true }
    at = at + usize.ONE
  }
  return false
}

// Reconstruct the ordinary specialization path from this origin transaction's scoped query
// frames. Check growth before reading another body, including cached target bodies. Changing
// statics may finish a bounded finite chain; reaching the node limit is a gap, not an infinite
// specialization proof. Abstract source applications keep their declared proof obligations.
effect fn callableOriginAdmission(resolver: &Resolver, application: &Application, context: usize, span: Span)
  -> Option<Shared<Rejection>> ! OutOfMemoryError ? &mut Allocator {
  let active = Vector.asSlice<Word>(&resolver.active)
  let keys = Vector.asSlice<ScopedKey>(&resolver.keys)
  let mut admission = Admission.make()
  let mut count = usize.ZERO
  let mut at = usize.ZERO
  while at <= active.length {
    let mut next = Option.none<Application>()
    if at == active.length { count = count + usize.ONE next = Option.some<Application>(run Application.copy(application)) }
    else {
      let scoped = &keys[u64.toUsize(active[at].value)]
      if scoped.key.family == Family.CallableOrigin { count = count + usize.ONE }
      if scoped.application == resolver.currentApplication && scoped.profile == resolver.profileSlot
        && scoped.condition == context && scoped.key.family == Family.CallableOrigin {
        next = Option.some<Application>(run selectedApplicationAt(resolver, scoped.key.name))
      }
    }
    // Context partitions proof comparisons, but never resets the transaction's depth bound.
    if count > staticClosureNodes {
      let module = DeclarationId.moduleId(Application.bodyDeclaration(application))
      return Option.some<Shared<Rejection>>(run reject(resolver, module, RejectionCode.Unsupported, span))
    }
    if let Option<Application>.Some {value} = move next {
      let module = DeclarationId.moduleId(Application.bodyDeclaration(&value))
      match move run Admission.enter(&mut admission, &value, Edge.Direct) {
        Decision.Rejected {path} => {
          return Option.some<Shared<Rejection>>(run rejectSpecialization(module, span, Option.none<RelatedSite>(), move path))
        }
        Decision.ChangingStatic {..} => { run Admission.enterChain(&mut admission, &value, Edge.Direct) }
        Decision.Open => {}
        Decision.Entered => {}
        Decision.Reused {..} => {}
      }
    }
    at = at + usize.ONE
  }
  return Option.none<Shared<Rejection>>()
}

effect fn callableResultType(resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, application: &Application, declared: &[Constraint], span: Span)
  -> Result<Shared<Type>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let private = privateOriginPhase(&resolver.*)
  if private.phase != usize.ZERO {
    let sourceSignature = run sectionOriginalSignature(&mut resolver.*, &mut owner.*, &mut dependencies.*,
      Application.bodyDeclaration(application), span)
    let writtenResult = match move Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(&sourceSignature, signatureResult) {
      Option<Shared<Type>>.Some {value} => move value
      _ => { return Result.failResult<Shared<Type>, Shared<Rejection>>(run reject(&resolver.*,
        DeclarationId.moduleId(Application.bodyDeclaration(application)), RejectionCode.Unsupported, span)) }
    }
    let sourceBindings = run Application.bindings(application)
    let sourceContract = run Type.applyBindings(&writtenResult, Vector.asSlice<Binding>(&sourceBindings), true)
    let parent = run selectedApplicationAt(&resolver.*, private.application)
    if private.phase != usize.ONE {
      // The solve map contains canonical source applications. A replayed call can still
      // carry a closed result recipe in its selected arguments after owner substitution.
      // Normalize those free channels before lookup, just as an explicit Origin does.
      let substituted = run Shared.make<Application>(run Application.substitute(application, &parent))
      let canonical = match move run normalizeCallableApplication(&mut resolver.*, &mut owner.*, &mut dependencies.*,
        DeclarationId.moduleId(Application.bodyDeclaration(application)), declared, &substituted, span) {
        Result<Application, Shared<Rejection>>.Success {value} => move value
        Result<Application, Shared<Rejection>>.Failure {error} => { return Result.failResult<Shared<Type>, Shared<Rejection>>(move error) }
      }
      let selected = run Shared.make<Application>(move canonical)
      let found = run originSolution(&resolver.*, private.plan, &selected)
      if let Option<Shared<Type>>.Some {value} = move found {
        let exposed = run Type.callableView(move value, move sourceContract)
        return Result.succeed<Shared<Type>, Shared<Rejection>>(run callableResultView(&exposed, declared))
      }
      if private.phase == 3 {
        return Result.failResult<Shared<Type>, Shared<Rejection>>(run reject(&resolver.*,
          DeclarationId.moduleId(Application.bodyDeclaration(application)), RejectionCode.Unsupported, span))
      }
    }
    return Result.succeed<Shared<Type>, Shared<Rejection>>(run Shared.make<Type>(Type.CallableOrigin {
      application: run Shared.make<Application>(run Application.copy(application)), contract: move sourceContract}))
  }
  let identity = run Shared.make<DeclarationId>(run DeclarationId.copy(Application.bodyDeclaration(application)))
  let module = DeclarationId.moduleId(Application.bodyDeclaration(application))
  let ordinal = match move run ordinalOfIdentity(&mut resolver.*, module, &identity) {
    Option<usize>.Some {value} => value
    _ => { return Result.failResult<Shared<Type>, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.Unsupported, span)) }
  }
  let name = run internSelectedApplication(&mut resolver.*, application)
  let key = Key {family: Family.CallableOrigin, module: knownModuleOrdinal(&resolver.*, module),
    name: name, declaration: ordinal, member: usize.ZERO, external: false}
  if activeSemanticKey(&resolver.*, key) {
    return Result.failResult<Shared<Type>, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.Unsupported, span))
  }
  let refusal = run callableOriginAdmission(&resolver.*, application, demandContext(&resolver.*, key), span)
  if let Option<Shared<Rejection>>.Some {value} = move refusal {
    return Result.failResult<Shared<Type>, Shared<Rejection>>(move value)
  }
  let answer = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, key, span)
  let rejected = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(&answer, answerRejection)
  if let Option<Shared<Rejection>>.Some {value} = move rejected { return Result.failResult<Shared<Type>, Shared<Rejection>>(move value) }
  let found = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(&answer, resolvedTypeAnswer)
  if let Option<Shared<Type>>.Some {value} = move found {
    return Result.succeed<Shared<Type>, Shared<Rejection>>(run callableResultView(&value, declared))
  }
  return Result.failResult<Shared<Type>, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.Unsupported, span))
}

// Erase a redundant parameter view only after its exact public contract is proved by the
// current source premises. A weaker Once/Mutable permission remains a distinct view.
effect fn callableResultView(value: &Shared<Type>, declared: &[Constraint]) -> Shared<Type>
! OutOfMemoryError ? &mut Allocator {
  let copied = run Type.copy(value)
  if let Type.CallableView {representation, contract} = move copied {
    let exposed = run valueCallableContract(&representation, declared)
    if let Option<Shared<Type>>.Some {value: originalContract} = move exposed {
      if run Type.equalsShared(&originalContract, &contract) { return move representation }
    }
  }
  return Shared.clone<Type>(value)
}

fn originProducerCount(resolver: &Resolver, plan: usize) -> usize {
  let plans = Vector.asSlice<CallableOrigin.Plan>(&resolver.originPlans)
  return Vector.length<CallableOrigin.Producer>(&plans[plan].producers)
}

fn originProducerApplication(resolver: &Resolver, plan: usize, at: usize) -> Shared<Application> {
  let plans = Vector.asSlice<CallableOrigin.Plan>(&resolver.originPlans)
  let producers = Vector.asSlice<CallableOrigin.Producer>(&plans[plan].producers)
  return Shared.clone<Application>(&producers[at].application)
}

effect fn originRootSolution(resolver: &Resolver, plan: usize) -> Option<Shared<Type>>
! OutOfMemoryError ? &mut Allocator {
  let plans = Vector.asSlice<CallableOrigin.Plan>(&resolver.originPlans)
  return run CallableOrigin.solution(Vector.asSlice<CallableOrigin.Solution>(&plans[plan].solutions), &plans[plan].root)
}

effect fn originSolution(resolver: &Resolver, plan: usize, application: &Shared<Application>) -> Option<Shared<Type>>
! OutOfMemoryError ? &mut Allocator {
  let plans = Vector.asSlice<CallableOrigin.Plan>(&resolver.originPlans)
  return run CallableOrigin.solution(Vector.asSlice<CallableOrigin.Solution>(&plans[plan].solutions), application)
}

fn originPlanIndex(answer: &Result<Answer, NoRejection>) -> Option<usize> {
  return match &answer.* {
    Result<Answer, NoRejection>.Success {value} => match &value.outcome {
      Outcome.Success {value: Value.OriginPlan {index}} => Option.some<usize>(index)
      _ => Option.none<usize>()
    }
    _ => Option.none<usize>()
  }
}

effect fn originBodyKey(resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, module: &ModuleId, key: Key, application: usize) -> Result<Key, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let selected = run selectedApplicationAt(&resolver.*, application)
  let routing = run needsStaticResidualization(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, key.module, key.declaration)
  let mut residual = DeclarationId.kind(Application.bodyDeclaration(&selected)) == OwnerKind.Anonymous
  match move routing {
    Result<bool, Shared<Rejection>>.Success {value} => { residual = residual || value }
    Result<bool, Shared<Rejection>>.Failure {error} => { return Result.failResult<Key, Shared<Rejection>>(move error) }
  }
  let mut member = usize.ZERO
  if residual { member = application + usize.ONE }
  return Result.succeed<Key, Shared<Rejection>>(Key {family: Family.Body, module: key.module,
    name: usize.ZERO, declaration: key.declaration, member: member, external: false})
}

// Draft bodies are query-partitioned source evidence. Their ordinary ownership/contract checks
// remain active; only origin-dependent exact inference is postponed for mandatory exact replay.
effect fn resolveOriginDraft(resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>, key: Key)
  -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let module = run resolvedModule(&resolver.*, key.module)
  let mut dependencies = Vector.make<Dependency>()
  let bodyKey = match move run originBodyKey(&mut resolver.*, &mut owner.*, &mut dependencies, &module, key, key.name) {
    Result<Key, Shared<Rejection>>.Success {value} => value
    Result<Key, Shared<Rejection>>.Failure {error} => { return memberRejected(move error, move dependencies) }
  }
  let answer = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies, bodyKey, Span.make(usize.ZERO, usize.ZERO))
  let rejected = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(&answer, answerRejection)
  if let Option<Shared<Rejection>>.Some {value} = move rejected { return memberRejected(move value, move dependencies) }
  let selected = Shared.with<Result<Answer, NoRejection>, Option<Value>>(&answer, copiedOriginBody)
  if let Option<Value>.Some {value} = move selected { return memberSuccess(move value, move dependencies) }
  return memberRejected(run reject(&resolver.*, &module, RejectionCode.Unsupported, Span.make(usize.ZERO, usize.ZERO)), move dependencies)
}

fn copiedOriginBody(answer: &Result<Answer, NoRejection>) -> Option<Value> {
  return match &answer.* {
    Result<Answer, NoRejection>.Success {value} => match &value.outcome {
      Outcome.Success {value: Value.Body {body, source}} => Option.some<Value>(Value.Body {
        body: Shared.clone<TypedBody>(&body), source: Shared.clone<Observation>(&source)})
      _ => Option.none<Value>()
    }
    _ => Option.none<Value>()
  }
}

effect fn gatherOriginProducer(resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, selected: &Shared<Application>, producers: &mut Vector<CallableOrigin.Producer>,
  admission: &mut Admission, span: Span) -> Option<Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let application = run Application.copyShared(selected)
  let identity = Application.bodyDeclaration(&application)
  let module = DeclarationId.moduleId(identity)
  let mut leave = false
  match move run Admission.enter(&mut admission.*, &application, Edge.Direct) {
    Decision.Entered => { leave = true }
    Decision.ChangingStatic {..} => { run Admission.enterChain(&mut admission.*, &application, Edge.Direct) leave = true }
    Decision.Rejected {path} => { return Option.some<Shared<Rejection>>(run rejectSpecialization(module, span, Option.none<RelatedSite>(), move path)) }
    Decision.Reused {..} => {}
    Decision.Open => {}
  }
  let previous = run CallableOrigin.producerIndex(Vector.asSlice<CallableOrigin.Producer>(&producers.*), selected)
  if let Option<usize>.Some {..} = move previous {
    if leave { Admission.leave(&mut admission.*) }
    return Option.none<Shared<Rejection>>()
  }
  if Vector.length<CallableOrigin.Producer>(&producers.*) >= staticClosureNodes {
    return Option.some<Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.Unsupported, span))
  }
  let declaration = run Shared.make<DeclarationId>(run DeclarationId.copy(identity))
  let ordinal = match move run ordinalOfIdentity(&mut resolver.*, module, &declaration) {
    Option<usize>.Some {value} => value
    _ => { return Option.some<Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.Unsupported, span)) }
  }
  let bindings = run Application.bindings(&application)
  let signature = run sectionOriginalSignature(&mut resolver.*, &mut owner.*, &mut dependencies.*, identity, span)
  let written = match move Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(&signature, signatureResult) {
    Option<Shared<Type>>.Some {value} => move value
    _ => { return Option.some<Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.Unsupported, span)) }
  }
  let contract = run Type.applyBindings(&written, Vector.asSlice<Binding>(&bindings), true)
  if !Shared.with<Type, bool>(&contract, rawCallableType) {
    return Option.some<Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.Unsupported, span))
  }
  let name = run internSelectedApplication(&mut resolver.*, &application)
  let anchor = run resultTypeAnchor(&mut resolver.*, module, ordinal)
  let moduleOrdinal = knownModuleOrdinal(&resolver.*, module)
  let bodyAnswer = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, Key {
    family: Family.OriginDraft, module: moduleOrdinal, name: name,
    declaration: ordinal, member: usize.ZERO, external: false}, anchor)
  let rejected = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(&bodyAnswer, answerRejection)
  if let Option<Shared<Rejection>>.Some {value} = move rejected { return Option.some<Shared<Rejection>>(move value) }
  let body = match move Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(&bodyAnswer, answerTypedBody) {
    Option<Shared<TypedBody>>.Some {value} => move value
    _ => { return Option.some<Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.Unsupported, anchor)) }
  }
  let returned = match move run CallableOrigin.inputs(&body, Vector.asSlice<Binding>(&bindings)) {
    Option<Vector<Shared<Type>>>.Some {value} => move value
    _ => { return Option.some<Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.Unsupported, anchor)) }
  }
  let demands = run CallableOrigin.demands(&body, Vector.asSlice<Binding>(&bindings))
  let values = Vector.asSlice<Shared<Type>>(&demands)
  let mut edges = Vector.make<Shared<Application>>()
  let mut at = usize.ZERO
  while at < values.length {
    let mut found = run Type.callableOriginApplications(&values[at])
    let count = Vector.length<Shared<Application>>(&found)
    let mut item = usize.ZERO
    while item < count {
      run Vector.append<Shared<Application>>(&mut edges, Vector.remove<Shared<Application>>(&mut found, usize.ZERO))
      item = item + usize.ONE
    }
    at = at + usize.ONE
  }
  // Register before following a recursive edge. No provisional ordinary origin answer exists.
  run Vector.append<CallableOrigin.Producer>(&mut producers.*, CallableOrigin.Producer {
    application: Shared.clone<Application>(selected), contract: move contract, returns: move returned, demands: move demands})
  // A selected generic instantiation cannot make an invalid ordinary authored template valid.
  // Collect its symbolic owner schema in the same transaction, and strictly replay that producer
  // as well. Mixed/static bodies intentionally validate their selected residual instead.
  if DeclarationId.kind(identity) != OwnerKind.Anonymous {
    let routing = run needsStaticResidualization(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, moduleOrdinal, ordinal)
    let selectedOnly = match move routing {
      Result<bool, Shared<Rejection>>.Success {value} => value
      Result<bool, Shared<Rejection>>.Failure {error} => { return Option.some<Shared<Rejection>>(move error) }
    }
    if !selectedOnly {
      let source = run CallableOrigin.sourceApplication(&application)
      if !run Application.equals(&source, &application) {
        let symbolic = run Shared.make<Application>(move source)
        let refused = run gatherOriginProducer(&mut resolver.*, &mut owner.*, &mut dependencies.*, &symbolic,
          &mut producers.*, &mut admission.*, anchor)
        if let Option<Shared<Rejection>>.Some {value} = move refused { return Option.some<Shared<Rejection>>(move value) }
      }
    }
  }
  let successors = Vector.asSlice<Shared<Application>>(&edges)
  at = usize.ZERO
  while at < successors.length {
    let refused = run gatherOriginProducer(&mut resolver.*, &mut owner.*, &mut dependencies.*, &successors[at],
      &mut producers.*, &mut admission.*, anchor)
    if let Option<Shared<Rejection>>.Some {value} = move refused { return Option.some<Shared<Rejection>>(move value) }
    at = at + usize.ONE
  }
  if leave { Admission.leave(&mut admission.*) }
  return Option.none<Shared<Rejection>>()
}

effect fn originProducerCopy(resolver: &Resolver, plan: usize, at: usize) -> CallableOrigin.Producer
! OutOfMemoryError ? &mut Allocator {
  let plans = Vector.asSlice<CallableOrigin.Plan>(&resolver.originPlans)
  let producers = Vector.asSlice<CallableOrigin.Producer>(&plans[plan].producers)
  return run CallableOrigin.copyProducer(&producers[at])
}

fn originEvidenceIndex(answer: &Result<Answer, NoRejection>) -> Option<usize> {
  return match &answer.* {
    Result<Answer, NoRejection>.Success {value} => match &value.outcome {
      Outcome.Success {value: Value.OriginEvidence {index}} => Option.some<usize>(index)
      _ => Option.none<usize>()
    }
    _ => Option.none<usize>()
  }
}

effect fn originEvidenceCopy(resolver: &Resolver, index: usize) -> CallableOrigin.Producer
! OutOfMemoryError ? &mut Allocator {
  let evidence = Vector.asSlice<CallableOrigin.Producer>(&resolver.originEvidence)
  return run CallableOrigin.copyProducer(&evidence[index])
}

effect fn originEdges(values: &[Shared<Type>], output: &mut Vector<Shared<Application>>)
  -> () ! OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < values.length {
    let mut edges = run Type.callableOriginApplications(&values[at])
    let count = Vector.length<Shared<Application>>(&edges)
    let mut item = usize.ZERO
    while item < count {
      run Vector.append<Shared<Application>>(&mut output.*, Vector.remove<Shared<Application>>(&mut edges, usize.ZERO))
      item = item + usize.ONE
    }
    at = at + usize.ONE
  }
  return ()
}

// Every solving round has immutable evidence and its own query context. Normalization may reveal
// a higher-order producer or canonicalize an application's free argument channels, so closure is
// tested only after both the candidate map and the producer evidence have reached a fixed point.
effect fn resolveOriginGraph(resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>, key: Key)
  -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let application = run selectedApplicationAt(&resolver.*, key.name)
  let selected = run Shared.make<Application>(run Application.copy(&application))
  let module = DeclarationId.moduleId(Application.bodyDeclaration(&application))
  let anchor = run resultTypeAnchor(&mut resolver.*, module, key.declaration)
  let mut dependencies = Vector.make<Dependency>()
  let mut producers = Vector.make<CallableOrigin.Producer>()
  let mut admission = Admission.make()
  let refused = run gatherOriginProducer(&mut resolver.*, &mut owner.*, &mut dependencies, &selected, &mut producers, &mut admission, anchor)
  if let Option<Shared<Rejection>>.Some {value} = move refused { return memberRejected(move value, move dependencies) }
  let mut root = Shared.clone<Application>(&selected)
  let mut round = usize.ZERO
  while round < staticClosureNodes {
    let solutions = run CallableOrigin.seeds(Vector.asSlice<CallableOrigin.Producer>(&producers))
    let complete = Vector.length<CallableOrigin.Solution>(&solutions) == Vector.length<CallableOrigin.Producer>(&producers)
    let count = Vector.length<CallableOrigin.Producer>(&producers)
    let plan = Vector.length<CallableOrigin.Plan>(&resolver.originPlans)
    run Vector.append<CallableOrigin.Plan>(&mut resolver.originPlans, CallableOrigin.Plan {requested: Shared.clone<Application>(&selected), root: Shared.clone<Application>(&root), producers: move producers, solutions: move solutions})
    let mut next = Vector.make<CallableOrigin.Producer>()
    let mut edges = Vector.make<Shared<Application>>()
    let mut changed = false
    let mut at = usize.ZERO
    while at < count {
      let original = run originProducerCopy(&resolver.*, plan, at)
      let producer = run Application.copyShared(&original.application)
      let identity = run Shared.make<DeclarationId>(run DeclarationId.copy(Application.bodyDeclaration(&producer)))
      let producerModule = DeclarationId.moduleId(Application.bodyDeclaration(&producer))
      let ordinal = match move run ordinalOfIdentity(&mut resolver.*, producerModule, &identity) {
        Option<usize>.Some {value} => value
        _ => { return memberRejected(run reject(&resolver.*, producerModule, RejectionCode.Unsupported, anchor), move dependencies) }
      }
      let interned = run internSelectedApplication(&mut resolver.*, &producer)
      let moduleOrdinal = knownModuleOrdinal(&resolver.*, producerModule)
      let solved = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies, Key {
        family: Family.OriginSolve, module: moduleOrdinal, name: plan, declaration: ordinal,
        member: interned + usize.ONE, external: false}, anchor)
      let rejected = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(&solved, answerRejection)
      if let Option<Shared<Rejection>>.Some {value} = move rejected { return memberRejected(move value, move dependencies) }
      let evidence = match move Shared.with<Result<Answer, NoRejection>, Option<usize>>(&solved, originEvidenceIndex) {
        Option<usize>.Some {value} => value
        _ => { return memberRejected(run reject(&resolver.*, producerModule, RejectionCode.Unsupported, anchor), move dependencies) }
      }
      let normalized = run originEvidenceCopy(&resolver.*, evidence)
      if !run CallableOrigin.sameProducer(&original, &normalized) { changed = true }
      run originEdges(Vector.asSlice<Shared<Type>>(&normalized.demands), &mut edges)
      run originEdges(Vector.asSlice<Shared<Type>>(&normalized.returns), &mut edges)
      let contract = [Shared.clone<Type>(&normalized.contract)]
      run originEdges(&contract, &mut edges)
      if at == usize.ZERO { root = Shared.clone<Application>(&normalized.application) }
      if !run CallableOrigin.appendProducer(&mut next, move normalized) {
        return memberRejected(run reject(&resolver.*, producerModule, RejectionCode.Unsupported, anchor), move dependencies)
      }
      at = at + usize.ONE
    }
    let successors = Vector.asSlice<Shared<Application>>(&edges)
    at = usize.ZERO
    while at < successors.length {
      let refused = run gatherOriginProducer(&mut resolver.*, &mut owner.*, &mut dependencies,
        &successors[at], &mut next, &mut admission, anchor)
      if let Option<Shared<Rejection>>.Some {value} = move refused { return memberRejected(move value, move dependencies) }
      at = at + usize.ONE
    }
    changed = changed || Vector.length<CallableOrigin.Producer>(&next) != count
    if !changed {
      if complete { return memberSuccess(Value.OriginPlan {index: plan}, move dependencies) }
      return memberRejected(run reject(&resolver.*, module, RejectionCode.Unsupported, anchor), move dependencies)
    }
    producers = move next
    round = round + usize.ONE
  }
  return memberRejected(run reject(&resolver.*, module, RejectionCode.Unsupported, anchor), move dependencies)
}

// Solving normalizes already checked source evidence under the producer's own applied premises.
// It does not publish a Body answer or claim that a candidate origin has passed exact replay.
effect fn resolveOriginSolve(resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>, key: Key)
  -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let application = run selectedApplicationAt(&resolver.*, key.member - usize.ONE)
  let selected = run Shared.make<Application>(run Application.copy(&application))
  let module = DeclarationId.moduleId(Application.bodyDeclaration(&application))
  let anchor = run resultTypeAnchor(&mut resolver.*, module, key.declaration)
  let plans = Vector.asSlice<CallableOrigin.Plan>(&resolver.originPlans)
  let found = run CallableOrigin.producerIndex(Vector.asSlice<CallableOrigin.Producer>(&plans[key.name].producers), &selected)
  let index = match move found {
    Option<usize>.Some {value} => value
    _ => { return memberRejected(run reject(&resolver.*, module, RejectionCode.Unsupported, anchor), Vector.make<Dependency>()) }
  }
  let producer = run originProducerCopy(&resolver.*, key.name, index)
  let mut dependencies = Vector.make<Dependency>()
  let bindings = run Application.bindings(&application)
  let declared = match move run closedApplicationBounds(&mut resolver.*, &mut owner.*, &mut dependencies,
    &application, Vector.asSlice<Binding>(&bindings), anchor) {
    Option<Vector<Constraint>>.Some {value} => move value
    _ => { return memberRejected(run reject(&resolver.*, module, RejectionCode.Unsupported, anchor), move dependencies) }
  }
  let premises = Vector.asSlice<Constraint>(&declared)
  let canonical = match move run normalizeCallableApplication(&mut resolver.*, &mut owner.*, &mut dependencies,
    module, premises, &producer.application, anchor) {
    Result<Application, Shared<Rejection>>.Success {value} => move value
    Result<Application, Shared<Rejection>>.Failure {error} => { return memberRejected(move error, move dependencies) }
  }
  let contract = match move run normalizeCallableChildren(&mut resolver.*, &mut owner.*, &mut dependencies,
    module, premises, &producer.contract, anchor) {
    Result<Shared<Type>, Shared<Rejection>>.Success {value} => move value
    Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return memberRejected(move error, move dependencies) }
  }
  let returns = match move run normalizeCallableTypes(&mut resolver.*, &mut owner.*, &mut dependencies,
    module, premises, Vector.asSlice<Shared<Type>>(&producer.returns), anchor) {
    Result<Vector<Shared<Type>>, Shared<Rejection>>.Success {value} => move value
    Result<Vector<Shared<Type>>, Shared<Rejection>>.Failure {error} => { return memberRejected(move error, move dependencies) }
  }
  let demands = match move run normalizeCallableTypes(&mut resolver.*, &mut owner.*, &mut dependencies,
    module, premises, Vector.asSlice<Shared<Type>>(&producer.demands), anchor) {
    Result<Vector<Shared<Type>>, Shared<Rejection>>.Success {value} => move value
    Result<Vector<Shared<Type>>, Shared<Rejection>>.Failure {error} => { return memberRejected(move error, move dependencies) }
  }
  let output = Vector.length<CallableOrigin.Producer>(&resolver.originEvidence)
  run Vector.append<CallableOrigin.Producer>(&mut resolver.originEvidence, CallableOrigin.Producer {
    application: run Shared.make<Application>(move canonical), contract: move contract, returns: move returns, demands: move demands})
  return memberSuccess(Value.OriginEvidence {index: output}, move dependencies)
}

effect fn resolveOriginValidate(resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>, key: Key)
  -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let module = run resolvedModule(&resolver.*, key.module)
  let mut dependencies = Vector.make<Dependency>()
  let application = run selectedApplicationAt(&resolver.*, key.member - usize.ONE)
  let bodyKey = match move run originBodyKey(&mut resolver.*, &mut owner.*, &mut dependencies, &module, key, key.member - usize.ONE) {
    Result<Key, Shared<Rejection>>.Success {value} => value
    Result<Key, Shared<Rejection>>.Failure {error} => { return memberRejected(move error, move dependencies) }
  }
  let checked = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies, bodyKey, Span.make(usize.ZERO, usize.ZERO))
  let rejected = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(&checked, answerRejection)
  if let Option<Shared<Rejection>>.Some {value} = move rejected { return memberRejected(move value, move dependencies) }
  let body = match move Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(&checked, answerTypedBody) {
    Option<Shared<TypedBody>>.Some {value} => move value
    _ => { return memberRejected(run reject(&resolver.*, &module, RejectionCode.Unsupported, Span.make(usize.ZERO, usize.ZERO)), move dependencies) }
  }
  let bindings = run Application.bindings(&application)
  let returned = match move run CallableOrigin.inputs(&body, Vector.asSlice<Binding>(&bindings)) {
    Option<Vector<Shared<Type>>>.Some {value} => move value
    _ => { return memberRejected(run reject(&resolver.*, &module, RejectionCode.Unsupported, Span.make(usize.ZERO, usize.ZERO)), move dependencies) }
  }
  let declared = match move run closedApplicationBounds(&mut resolver.*, &mut owner.*, &mut dependencies,
    &application, Vector.asSlice<Binding>(&bindings), Span.make(usize.ZERO, usize.ZERO)) {
    Option<Vector<Constraint>>.Some {value} => move value
    _ => { return memberRejected(run reject(&resolver.*, &module, RejectionCode.Unsupported, Span.make(usize.ZERO, usize.ZERO)), move dependencies) }
  }
  let mut normalized = Vector.make<Shared<Type>>()
  let inputs = Vector.asSlice<Shared<Type>>(&returned)
  let mut at = usize.ZERO
  while at < inputs.length {
    let resolved = match move run normalizeCallableResult(&mut resolver.*, &mut owner.*, &mut dependencies,
      &module, Vector.asSlice<Constraint>(&declared), &inputs[at], Span.make(usize.ZERO, usize.ZERO)) {
      Result<Shared<Type>, Shared<Rejection>>.Success {value} => move value
      Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return memberRejected(move error, move dependencies) }
    }
    run Vector.append<Shared<Type>>(&mut normalized, move resolved)
    at = at + usize.ONE
  }
  let common = run CallableOrigin.common(Vector.asSlice<Shared<Type>>(&normalized))
  let selected = run Shared.make<Application>(run Application.copy(&application))
  let expected = run originSolution(&resolver.*, key.name, &selected)
  if let Option<Shared<Type>>.Some {value} = move common {
    if let Option<Shared<Type>>.Some {value: candidate} = move expected {
      let values = [move value, move candidate]
      let agreed = run CallableOrigin.common(&values)
      if let Option<Shared<Type>>.Some {..} = move agreed {
        return memberSuccess(Value.OriginPlan {index: key.name}, move dependencies)
      }
    }
  }
  let anchor = run resultTypeAnchor(&mut resolver.*, &module, key.declaration)
  return memberRejected(run reject(&resolver.*, &module, RejectionCode.Unsupported, anchor), move dependencies)
}

effect fn resolveCallableOrigin(resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>, key: Key)
  -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let application = run selectedApplicationAt(&resolver.*, key.name)
  let module = DeclarationId.moduleId(Application.bodyDeclaration(&application))
  let anchor = run resultTypeAnchor(&mut resolver.*, module, key.declaration)
  let mut dependencies = Vector.make<Dependency>()
  let graph = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies, Key {
    family: Family.OriginGraph, module: key.module, name: key.name, declaration: key.declaration, member: usize.ZERO, external: false}, anchor)
  let failed = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(&graph, answerRejection)
  if let Option<Shared<Rejection>>.Some {value} = move failed { return memberRejected(move value, move dependencies) }
  let plan = match move Shared.with<Result<Answer, NoRejection>, Option<usize>>(&graph, originPlanIndex) {
    Option<usize>.Some {value} => value
    _ => { return memberRejected(run reject(&resolver.*, module, RejectionCode.Unsupported, anchor), move dependencies) }
  }
  let count = originProducerCount(&resolver.*, plan)
  let mut at = usize.ZERO
  while at < count {
    let selected = originProducerApplication(&resolver.*, plan, at)
    let producer = run Application.copyShared(&selected)
    let identity = run Shared.make<DeclarationId>(run DeclarationId.copy(Application.bodyDeclaration(&producer)))
    let producerModule = DeclarationId.moduleId(Application.bodyDeclaration(&producer))
    let ordinal = match move run ordinalOfIdentity(&mut resolver.*, producerModule, &identity) {
      Option<usize>.Some {value} => value
      _ => { return memberRejected(run reject(&resolver.*, producerModule, RejectionCode.Unsupported, anchor), move dependencies) }
    }
    let interned = run internSelectedApplication(&mut resolver.*, &producer)
    let moduleOrdinal = knownModuleOrdinal(&resolver.*, producerModule)
    let checked = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies, Key {
      family: Family.OriginValidate, module: moduleOrdinal, name: plan,
      declaration: ordinal, member: interned + usize.ONE, external: false}, anchor)
    let rejected = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(&checked, answerRejection)
    if let Option<Shared<Rejection>>.Some {value} = move rejected { return memberRejected(move value, move dependencies) }
    at = at + usize.ONE
  }
  let found = run originRootSolution(&resolver.*, plan)
  if let Option<Shared<Type>>.Some {value} = move found { return memberSuccess(Value.Type {resolved: move value}, move dependencies) }
  return memberRejected(run reject(&resolver.*, module, RejectionCode.Unsupported, anchor), move dependencies)
}

fn rawCallableType(value: &Type) -> bool {
  return match &value.* { Type.Callable {..} => true _ => false }
}

effect fn resultTypeAnchor(resolver: &mut Resolver, module: &ModuleId, ordinal: usize) -> Span
! Cycle | OutOfMemoryError ? &mut Allocator {
  let written = run signatureSyntax(&mut resolver.*, module, ordinal)
  if let Option<WrittenSignature>.Some {value} = move written {
    if let Option<HirId>.Some {value: result} = move value.result {
      let observed = run source(&mut resolver.*, module)
      if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(&resolver.*, &observed, module) {
        return Module.span(IndexedSource.authored(indexed), result)
      }
    }
  }
  return Span.make(usize.ZERO, usize.ZERO)
}

struct OpaqueReturnEnvelope {
  source: Shared<Type>
  payload: BodyNodeId
  tag: usize
}
fn opaqueReturnEnvelope(body: &TypedBody, node: BodyNodeId) -> Option<OpaqueReturnEnvelope> {
  let nodes = TypedBody.nodeSlice(body)
  if let BodyNodeKind.Expression {ty, form: BodyExpression.UnionInject {value, tag}} = &nodes[node.index].kind {
    return Option.some<OpaqueReturnEnvelope>(OpaqueReturnEnvelope {source: Shared.clone<Type>(&ty), payload: value, tag: tag})
  }
  return Option.none<OpaqueReturnEnvelope>()
}

effect fn opaqueBodyEvidence(body: &Shared<TypedBody>, application: &Application, result: &Shared<Type>,
  family: &Shared<Type>) -> Vector<OpaqueLeaf> ! OutOfMemoryError ? &mut Allocator {
  let bindings = run Application.bindings(application)
  let reached = run ReturnFlow.collect(body)
  let returns = Vector.asSlice<BodyNodeId>(&reached)
  let mut evidence = Vector.make<OpaqueLeaf>()
  let mut at = usize.ZERO
  while at < returns.length {
      let node = returns[at]
      let mut operand = node
      let mut promised = Shared.clone<Type>(result)
      let envelope = Shared.with<TypedBody, Option<OpaqueReturnEnvelope>>(body,
        fn(value: &TypedBody) -> Option<OpaqueReturnEnvelope> { return opaqueReturnEnvelope(value, node) })
      if let Option<OpaqueReturnEnvelope>.Some {value} = move envelope {
        if run Type.containsOpaque(&value.source, Application.bodyDeclaration(application)) {
          operand = value.payload
          let ordered = run UnionProjection.members(&value.source)
          if let Option<Vector<Shared<Type>>>.Some {value: members} = move ordered {
            let listed = Vector.asSlice<Shared<Type>>(&members)
            if value.tag < listed.length {
              promised = run Type.applyBindings(&listed[value.tag], Vector.asSlice<Binding>(&bindings), true)
            }
          }
        }
      }
      let actual = Shared.with<TypedBody, Option<Shared<Type>>>(body,
        fn(value: &TypedBody) -> Option<Shared<Type>> { return bodyExpressionType(TypedBody.nodeSlice(value), &operand) })
      if let Option<Shared<Type>>.Some {value} = move actual {
        let closed = run Type.applyBindings(&value, Vector.asSlice<Binding>(&bindings), true)
        let found = run Type.opaqueEvidence(&closed, &promised, Application.bodyDeclaration(application))
        if let Option<Vector<OpaqueEvidence>>.Some {value: leaves} = move found {
          let listed = Vector.asSlice<OpaqueEvidence>(&leaves)
          let span = Shared.with<TypedBody, Span>(body,
            fn(value: &TypedBody) -> Span { return TypedBody.nodeSlice(value)[node.index].origin.span })
          let mut leaf = usize.ZERO
          while leaf < listed.length {
            if run Type.equalsShared(&listed[leaf].family, family) {
              run Vector.append<OpaqueLeaf>(&mut evidence, OpaqueLeaf {ty: Shared.clone<Type>(&listed[leaf].actual), span: span})
            }
            leaf = leaf + usize.ONE
          }
        }
      }
    at = at + usize.ONE
  }
  return move evidence
}

// Runtime storage follows substituted nominal fields, not phantom arguments or callable proofs.
// Descriptor referents are discovery dependencies, but do not contribute inline size cycles.
effect fn opaqueStoredInputs(resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, value: &Shared<Type>, inlineOnly: bool, span: Span)
  -> Result<Vector<Shared<Type>>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let nominal = Shared.with<Type, bool>(value, isNominalType)
  if nominal { return run nominalParts(&mut resolver.*, &mut owner.*, &mut dependencies.*, value, span) }
  let descriptor = Shared.with<Type, bool>(value, fn(ty: &Type) -> bool {
    return match &ty.* { Type.Reference {..} => true Type.Pointer {..} => true Type.Slice {..} => true _ => false }
  })
  let contract = Shared.with<Type, bool>(value, fn(ty: &Type) -> bool {
    return match &ty.* { Type.Callable {..} => true _ => false }
  })
  if contract || (inlineOnly && descriptor) {
    return Result.succeed<Vector<Shared<Type>>, Shared<Rejection>>(Vector.make<Shared<Type>>())
  }
  return Result.succeed<Vector<Shared<Type>>, Shared<Rejection>>(run RuntimeType.inputs(value))
}

effect fn gatherOpaqueInputs(resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, value: &Shared<Type>, producers: &mut Vector<OpaqueProducer>,
  discovery: &mut Vector<Shared<Type>>, admission: &mut Admission, span: Span) -> Option<Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  if let Option<Shared<Application>>.Some {..} = move Type.opaqueApplication(value) {
    return run gatherOpaqueProducer(&mut resolver.*, &mut owner.*, &mut dependencies.*, value,
      &mut producers.*, &mut discovery.*, &mut admission.*, span)
  }
  let previous = Vector.asSlice<Shared<Type>>(&discovery.*)
  let mut known = usize.ZERO
  while known < previous.length {
    if run Type.equalsShared(&previous[known], value) { return Option.none<Shared<Rejection>>() }
    known = known + usize.ONE
  }
  if previous.length >= staticClosureNodes {
    let families = Vector.asSlice<OpaqueProducer>(&producers.*)
    let application = match move Type.opaqueApplication(&families[usize.ZERO].family) {
      Option<Shared<Application>>.Some {value: root} => run Application.copyShared(&root)
      _ => { fail RevisionMismatch {} }
    }
    return Option.some<Shared<Rejection>>(run reject(&resolver.*,
      DeclarationId.moduleId(Application.bodyDeclaration(&application)), RejectionCode.Unsupported, span))
  }
  run Vector.append<Shared<Type>>(&mut discovery.*, Shared.clone<Type>(value))
  let found = run opaqueStoredInputs(&mut resolver.*, &mut owner.*, &mut dependencies.*, value, false, span)
  let children = match move found { Result<Vector<Shared<Type>>, Shared<Rejection>>.Success {value: inputs} => move inputs
    Result<Vector<Shared<Type>>, Shared<Rejection>>.Failure {error} => { return Option.some<Shared<Rejection>>(move error) } }
  let listed = Vector.asSlice<Shared<Type>>(&children)
  let mut at = usize.ZERO
  while at < listed.length {
    let failure = run gatherOpaqueInputs(&mut resolver.*, &mut owner.*, &mut dependencies.*, &listed[at],
      &mut producers.*, &mut discovery.*, &mut admission.*, span)
    if let Option<Shared<Rejection>>.Some {value: rejected} = move failure { return Option.some<Shared<Rejection>>(move rejected) }
    at = at + usize.ONE
  }
  return Option.none<Shared<Rejection>>()
}

// The complete transaction owns its admission path. No evidence is published until every
// selected body closes; a recursive forwarding edge does not re-enter this query family.
effect fn gatherOpaqueProducer(resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, family: &Shared<Type>, producers: &mut Vector<OpaqueProducer>,
  discovery: &mut Vector<Shared<Type>>, admission: &mut Admission, incoming: Span) -> Option<Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let selected = match move Type.opaqueApplication(family) {
    Option<Shared<Application>>.Some {value} => move value
    _ => { fail RevisionMismatch {} }
  }
  let application = run Application.copyShared(&selected)
  let identity = Application.bodyDeclaration(&application)
  let module = DeclarationId.moduleId(identity)
  let decision = run Admission.enter(&mut admission.*, &application, Edge.Direct)
  let mut leave = false
  match move decision {
    Decision.Entered => { leave = true }
    Decision.Reused {..} => {}
    Decision.ChangingStatic {..} => {
      run Admission.enterChain(&mut admission.*, &application, Edge.Direct)
      leave = true
    }
    Decision.Rejected {path} => {
      return Option.some<Shared<Rejection>>(run rejectSpecialization(module, incoming, Option.none<RelatedSite>(), move path))
    }
    Decision.Open => { return Option.some<Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.Unsupported, incoming)) }
  }
  let previous = run OpaqueRealization.indexOf(Vector.asSlice<OpaqueProducer>(&producers.*), family)
  if let Option<usize>.Some {..} = move previous {
    if leave { Admission.leave(&mut admission.*) }
    return Option.none<Shared<Rejection>>()
  }
  // Changing-static discovery has the same bounded finite-certificate policy as the existing
  // closure transaction. This bound is not a proof that an unfinished graph is infinite.
  if Vector.length<OpaqueProducer>(&producers.*) >= staticClosureNodes {
    return Option.some<Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.Unsupported, incoming))
  }
  let declaration = run Shared.make<DeclarationId>(run DeclarationId.copy(identity))
  let ordinal = match move run ordinalOfIdentity(&mut resolver.*, module, &declaration) {
    Option<usize>.Some {value} => value
    _ => { return Option.some<Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.Unsupported, incoming)) }
  }
  let moduleOrdinal = knownModuleOrdinal(&resolver.*, module)
  let anchor = run resultTypeAnchor(&mut resolver.*, module, ordinal)
  let signature = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, Key {
    family: Family.Signature, module: moduleOrdinal, name: usize.ZERO, declaration: ordinal, member: usize.ZERO, external: false}, anchor)
  let failure = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(&signature, answerRejection)
  if let Option<Shared<Rejection>>.Some {value} = move failure { return Option.some<Shared<Rejection>>(move value) }
  let declared = match move Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(&signature, signatureResult) {
    Option<Shared<Type>>.Some {value} => move value
    _ => { return Option.some<Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.Unsupported, anchor)) }
  }
  let bindings = run Application.bindings(&application)
  let finished = run Type.finishOpaqueApplication(&declared, &application)
  let result = run Type.applyBindings(&finished, Vector.asSlice<Binding>(&bindings), true)
  let staticCount = Shared.with<Result<Answer, NoRejection>, usize>(&signature, signatureStaticCount)
  if staticCount != Vector.length<StaticSlot>(&application.statics) {
    return Option.some<Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.Unsupported, anchor))
  }
  let routing = run needsStaticResidualization(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, moduleOrdinal, ordinal)
  let mut bodyMember = usize.ZERO
  match move routing {
    Result<bool, Shared<Rejection>>.Success {value} => {
      if value {
        let interned = run internSelectedApplication(&mut resolver.*, &application)
        bodyMember = interned + usize.ONE
      }
    }
    Result<bool, Shared<Rejection>>.Failure {error} => { return Option.some<Shared<Rejection>>(move error) }
  }
  let bodyAnswer = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, Key {
    family: Family.Body, module: moduleOrdinal, name: usize.ZERO, declaration: ordinal, member: bodyMember, external: false}, anchor)
  let rejected = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(&bodyAnswer, answerRejection)
  if let Option<Shared<Rejection>>.Some {value} = move rejected { return Option.some<Shared<Rejection>>(move value) }
  let body = match move Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(&bodyAnswer, answerTypedBody) {
    Option<Shared<TypedBody>>.Some {value} => move value
    _ => { return Option.some<Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.Unsupported, anchor)) }
  }
  let evidence = run opaqueBodyEvidence(&body, &application, &result, family)
  // Copy the discovery edges before appending this producer: recursive gathering may grow its
  // vector, and a borrowed evidence slice must not survive that mutation.
  let listed = Vector.asSlice<OpaqueLeaf>(&evidence)
  let mut edges = Vector.make<OpaqueLeaf>()
  let mut at = usize.ZERO
  while at < listed.length {
    run Vector.append<OpaqueLeaf>(&mut edges, OpaqueLeaf {ty: Shared.clone<Type>(&listed[at].ty), span: listed[at].span})
    at = at + usize.ONE
  }
  run Vector.append<OpaqueProducer>(&mut producers.*, OpaqueProducer {family: Shared.clone<Type>(family), anchor: anchor, evidence: move evidence})
  let successors = Vector.asSlice<OpaqueLeaf>(&edges)
  at = usize.ZERO
  while at < successors.length {
    let failed = run gatherOpaqueInputs(&mut resolver.*, &mut owner.*, &mut dependencies.*, &successors[at].ty,
      &mut producers.*, &mut discovery.*, &mut admission.*, successors[at].span)
    if let Option<Shared<Rejection>>.Some {value} = move failed { return Option.some<Shared<Rejection>>(move value) }
    at = at + usize.ONE
  }
  if leave { Admission.leave(&mut admission.*) }
  return Option.none<Shared<Rejection>>()
}

effect fn validateOpaqueStorage(resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, producers: &[OpaqueProducer],
  realized: &[OpaqueRealization.Realization], value: &Shared<Type>, producer: usize,
  active: &mut Vector<usize>, types: &mut Vector<Shared<Type>>) -> Option<Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let selected = run OpaqueRealization.indexOf(producers, value)
  if let Option<usize>.Some {value: index} = move selected {
    let ancestors = Vector.asSlice<usize>(&active.*)
    let mut at = usize.ZERO
    while at < ancestors.length {
      if ancestors[at] == index {
        let application = match move Type.opaqueApplication(&producers[index].family) {
          Option<Shared<Application>>.Some {value: family} => run Application.copyShared(&family)
          _ => { fail RevisionMismatch {} }
        }
        return Option.some<Shared<Rejection>>(run reject(&resolver.*,
          DeclarationId.moduleId(Application.bodyDeclaration(&application)), RejectionCode.InlineOpaqueLayoutCycle,
          producers[index].anchor))
      }
      at = at + usize.ONE
    }
    run Vector.append<usize>(&mut active.*, index)
    // A family boundary starts a new physical leaf. Equal leaves of different families must
    // expose their forwarding captures before ordinary recursive-type ancestry can stop them.
    let mut leafTypes = Vector.make<Shared<Type>>()
    let failure = run validateOpaqueStorage(&mut resolver.*, &mut owner.*, &mut dependencies.*, producers,
      realized, &realized[index].storage, index, &mut active.*, &mut leafTypes)
    let last = Vector.length<usize>(&active.*) - usize.ONE
    drop Vector.remove<usize>(&mut active.*, last)
    return move failure
  }
  let ancestors = Vector.asSlice<Shared<Type>>(&types.*)
  let mut at = usize.ZERO
  let mut exhausted = ancestors.length >= staticClosureNodes
  while at < ancestors.length {
    if run Type.equalsShared(&ancestors[at], value) { exhausted = true }
    at = at + usize.ONE
  }
  if exhausted {
    let application = match move Type.opaqueApplication(&producers[producer].family) {
      Option<Shared<Application>>.Some {value: family} => run Application.copyShared(&family)
      _ => { fail RevisionMismatch {} }
    }
    return Option.some<Shared<Rejection>>(run reject(&resolver.*,
      DeclarationId.moduleId(Application.bodyDeclaration(&application)), RejectionCode.Unsupported, producers[producer].anchor))
  }
  run Vector.append<Shared<Type>>(&mut types.*, Shared.clone<Type>(value))
  let found = run opaqueStoredInputs(&mut resolver.*, &mut owner.*, &mut dependencies.*, value, true, producers[producer].anchor)
  let inputs = match move found { Result<Vector<Shared<Type>>, Shared<Rejection>>.Success {value: fields} => move fields
    Result<Vector<Shared<Type>>, Shared<Rejection>>.Failure {error} => { return Option.some<Shared<Rejection>>(move error) } }
  let fields = Vector.asSlice<Shared<Type>>(&inputs)
  at = usize.ZERO
  while at < fields.length {
    let failure = run validateOpaqueStorage(&mut resolver.*, &mut owner.*, &mut dependencies.*, producers,
      realized, &fields[at], producer, &mut active.*, &mut types.*)
    if let Option<Shared<Rejection>>.Some {value: error} = move failure { return Option.some<Shared<Rejection>>(move error) }
    at = at + usize.ONE
  }
  let last = Vector.length<Shared<Type>>(&types.*) - usize.ONE
  drop Vector.remove<Shared<Type>>(&mut types.*, last)
  return Option.none<Shared<Rejection>>()
}

fn resolvedTypeAnswer(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Type {resolved}} = &value.outcome {
      return Option.some<Shared<Type>>(Shared.clone<Type>(&resolved))
    }
  }
  return Option.none<Shared<Type>>()
}

effect fn resolveOpaqueRealization(resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>, key: Key)
  -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let known = Vector.asSlice<Shared<Type>>(&resolver.applications)
  let root = Shared.clone<Type>(&known[key.name])
  let mut dependencies = Vector.make<Dependency>()
  let mut producers = Vector.make<OpaqueProducer>()
  let mut discovery = Vector.make<Shared<Type>>()
  let mut admission = Admission.make()
  let failed = run gatherOpaqueProducer(&mut resolver.*, &mut owner.*, &mut dependencies, &root, &mut producers,
    &mut discovery, &mut admission, Span.make(usize.ZERO, usize.ZERO))
  if let Option<Shared<Rejection>>.Some {value} = move failed { return memberRejected(move value, move dependencies) }
  let solved = run OpaqueRealization.solve(Vector.asSlice<OpaqueProducer>(&producers))
  match move solved {
    Result<Vector<OpaqueRealization.Realization>, OpaqueRealization.Failure>.Success {value} => {
      let listed = Vector.asSlice<OpaqueRealization.Realization>(&value)
      let families = Vector.asSlice<OpaqueProducer>(&producers)
      let mut at = usize.ZERO
      while at < families.length {
        let mut active = Vector.make<usize>()
        let mut types = Vector.make<Shared<Type>>()
        let refused = run validateOpaqueStorage(&mut resolver.*, &mut owner.*, &mut dependencies, families,
          listed, &families[at].family, at, &mut active, &mut types)
        if let Option<Shared<Rejection>>.Some {value: error} = move refused { return memberRejected(move error, move dependencies) }
        at = at + usize.ONE
      }
      return memberSuccess(Value.Type {resolved: Shared.clone<Type>(&listed[usize.ZERO].storage)}, move dependencies)
    }
    Result<Vector<OpaqueRealization.Realization>, OpaqueRealization.Failure>.Failure {error} => {
      let listed = Vector.asSlice<OpaqueProducer>(&producers)
      let selected = run Type.copy(&listed[error.producer].family)
      let identity = match move selected { Type.OpaqueRepresentation {application, ..} => run Application.copyShared(&application)
        _ => { fail RevisionMismatch {} } }
      let code = match error.kind { OpaqueFailureKind.Divergent => RejectionCode.DivergentOpaqueRealization
        OpaqueFailureKind.Cycle => RejectionCode.OpaqueRealizationCycle OpaqueFailureKind.Missing => RejectionCode.MissingOpaqueRealization }
      let module = DeclarationId.moduleId(Application.bodyDeclaration(&identity))
      let evidence = Vector.asSlice<OpaqueLeaf>(&listed[error.producer].evidence)
      let mut related = Option.none<RelatedSite>()
      if error.kind == OpaqueFailureKind.Divergent && evidence.length != usize.ZERO {
        related = Option.some<RelatedSite>(RelatedSite {module: run ModuleId.copy(module), span: evidence[usize.ZERO].span})
      }
      return memberRejected(run rejectWithRelated(&resolver.*, module, code,
        listed[error.producer].anchor, move related), move dependencies)
    }
  }
}

// Abstract callable parameters can reveal a schema only after ordinary substitution. Resolve
// staging through the same target signature and bound proof as source-visible schema staging.
effect fn stagedRuntimeSchema(resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, caller: &Application, callerBindings: &[Binding],
  base: &Shared<Type>, contract: Shared<Type>, captures: Vector<Shared<Type>>, remaining: usize,
  suffixMode: CallableMode, span: Span)
  -> Result<Shared<Type>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let module = DeclarationId.moduleId(Application.bodyDeclaration(caller))
  let premises = match move run closedApplicationBounds(&mut resolver.*, &mut owner.*, &mut dependencies.*,
    caller, callerBindings, span) {
    Option<Vector<Constraint>>.Some {value} => move value
    _ => { return Result.failResult<Shared<Type>, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.Unsupported, span)) }
  }
  let fields = match move run normalizeCallableTypes(&mut resolver.*, &mut owner.*, &mut dependencies.*, module,
    Vector.asSlice<Constraint>(&premises), Vector.asSlice<Shared<Type>>(&captures), span) {
    Result<Vector<Shared<Type>>, Shared<Rejection>>.Success {value} => move value
    Result<Vector<Shared<Type>>, Shared<Rejection>>.Failure {error} => { return Result.failResult<Shared<Type>, Shared<Rejection>>(move error) }
  }
  let exposed = match move run normalizeCallableChildren(&mut resolver.*, &mut owner.*, &mut dependencies.*, module,
    Vector.asSlice<Constraint>(&premises), &contract, span) {
    Result<Shared<Type>, Shared<Rejection>>.Success {value} => move value
    Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result.failResult<Shared<Type>, Shared<Rejection>>(move error) }
  }
  return run stagedCallableSchema(&mut resolver.*, &mut owner.*, &mut dependencies.*, module,
    Vector.asSlice<Constraint>(&premises), base, move exposed, move fields, remaining, suffixMode, span)
}

// Source provenance and physical projection share the same immutable schema selection.
effect fn stagedCallableSchema(resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, module: &ModuleId, premises: &[Constraint],
  base: &Shared<Type>, contract: Shared<Type>, captures: Vector<Shared<Type>>, remaining: usize,
  suffixMode: CallableMode, span: Span) -> Result<Shared<Type>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let recipe = match move Shared.with<Type, Option<Shared<SectionSchema>>>(base, sectionSchemaOf) {
    Option<Shared<SectionSchema>>.Some {value} => move value
    _ => { return Result.failResult<Shared<Type>, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.Unsupported, span)) }
  }
  let copied = run CallableSchema.copy(&recipe)
  let target = run DeclarationId.copyShared(&copied.target)
  let fresh = run sectionInferenceOwner(&mut resolver.*, &target)
  let mut unheld = Vector.make<Binding>()
  let opened = match move run sectionSchemaSignature(&mut resolver.*, &mut owner.*, &mut dependencies.*,
    &recipe, &fresh, module, span, false, &mut unheld) {
    Result<Shared<Result<Answer, NoRejection>>, Shared<Rejection>>.Success {value} => move value
    Result<Shared<Result<Answer, NoRejection>>, Shared<Rejection>>.Failure {error} => {
      return Result.failResult<Shared<Type>, Shared<Rejection>>(move error)
    }
  }
  let count = Shared.with<Result<Answer, NoRejection>, usize>(&opened, signatureParameterCount)
  let supplied = Vector.asSlice<Shared<Type>>(&captures)
  if remaining + supplied.length != count {
    return Result.failResult<Shared<Type>, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.CallArity, span))
  }
  let mut variables = Vector.make<Shared<DeclarationId>>()
  run Vector.append<Shared<DeclarationId>>(&mut variables, run Shared.make<DeclarationId>(run DeclarationId.copy(&fresh)))
  let mut inferred = Vector.make<Binding>()
  let mut at = usize.ZERO
  while at < supplied.length {
    let pattern = match move Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(&opened,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> { return signatureParameter(answer, remaining + at) }) {
      Option<Shared<Type>>.Some {value} => move value
      _ => { fail RevisionMismatch {} }
    }
    run inferSectionCallableShape(&pattern, &supplied[at], Vector.asSlice<Shared<DeclarationId>>(&variables), &mut inferred)
    at = at + usize.ONE
  }
  let freshIdentity = run Shared.make<DeclarationId>(run DeclarationId.copy(&fresh))
  let inferenceFailure = run inferFromProviderBounds(&mut resolver.*, &mut owner.*, &mut dependencies.*, module,
    &opened, &freshIdentity,
    premises, &mut inferred, span)
  if let Option<Shared<Rejection>>.Some {value} = move inferenceFailure {
    return Result.failResult<Shared<Type>, Shared<Rejection>>(move value)
  }
  // Shape inference may learn variables through a valid access conversion. Prove every fixed
  // suffix after inference instead of treating a discarded unification failure as evidence.
  at = usize.ZERO
  while at < supplied.length {
    let pattern = match move Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(&opened,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> { return signatureParameter(answer, remaining + at) }) {
      Option<Shared<Type>>.Some {value} => move value
      _ => { fail RevisionMismatch {} }
    }
    let selected = run Type.applyBindings(&pattern, Vector.asSlice<Binding>(&inferred), true)
    let required = match move run CallableContract.compareValue(&supplied[at], &selected) {
      Result<CallableContract.ValueRelation, CallableFailure>.Success {value} => move value
      Result<CallableContract.ValueRelation, CallableFailure>.Failure {error} => {
        let code = match error { CallableFailure.Incompatible => RejectionCode.TypeMismatch _ => RejectionCode.Unsupported }
        return Result.failResult<Shared<Type>, Shared<Rejection>>(run reject(&resolver.*, module, code, span))
      }
    }
    if !run proveValueRelation(&required, premises) {
      return Result.failResult<Shared<Type>, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.IncompatibleCallableSignature, span))
    }
    at = at + usize.ONE
  }
  let mut fixedBounds = Vector.make<Constraint>()
  let bounds = Shared.with<Result<Answer, NoRejection>, usize>(&opened, signatureConstraintCount)
  at = usize.ZERO
  while at < bounds {
    let bound = Shared.with<Result<Answer, NoRejection>, Option<Constraint>>(&opened,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Constraint> { return signatureConstraintAt(answer, at) })
    if let Option<Constraint>.Some {value} = move bound {
      let applied = run bindConstraint(&value, Vector.asSlice<Binding>(&inferred))
      if !run constraintMentionsOwner(&applied, &fresh) { run Vector.append<Constraint>(&mut fixedBounds, move applied) }
    }
    at = at + usize.ONE
  }
  let declared = run copyConstraints(premises)
  let refused = run proveAppliedBounds(&mut resolver.*, &mut owner.*, &mut dependencies.*, &declared,
    Vector.asSlice<Constraint>(&fixedBounds), module, span)
  if let Option<Shared<Rejection>>.Some {value} = move refused {
    return Result.failResult<Shared<Type>, Shared<Rejection>>(move value)
  }
  // The source promise determines transport; exact storage retains the actual invocation mode.
  let actual = match move run CallableContract.ofType(&copied.contract) {
    Option<CallableFacts>.Some {value} => move value
    _ => { return absurd<Result<Shared<Type>, Shared<Rejection>>>() }
  }
  let mut mode = actual.mode
  if suffixMode == CallableMode.Once { mode = CallableMode.Once }
  if suffixMode == CallableMode.Mutable && mode == CallableMode.Shared { mode = CallableMode.Mutable }
  let normalized = match move run Type.copy(&contract) {
    Type.Callable {isUnsafe, environment, invocationBinders, invocationUse, invocationBounds, parameters, result, ..} => Type.Callable {
      mode: mode, isUnsafe: isUnsafe, environment: move environment, invocationBinders: invocationBinders, invocationUse: invocationUse,
      invocationBounds: move invocationBounds, parameters: move parameters, result: move result,
    }
    _ => { return absurd<Result<Shared<Type>, Shared<Rejection>>>() }
  }
  return run stagedSectionSchema(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, base,
    &recipe, run Shared.make<Type>(move normalized), &opened, &fresh, Vector.asSlice<Binding>(&inferred), remaining, move captures, premises, true, span)
}

effect fn collectRuntimeProjection(resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, caller: &Application, bindings: &[Binding], value: &Shared<Type>,
  projections: &mut Vector<RuntimeProjection>, visiting: &mut Vector<Shared<Type>>, span: Span)
  -> Option<Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let previous = run RuntimeType.resolved(value, Vector.asSlice<RuntimeProjection>(&projections.*))
  if let Option<Shared<Type>>.Some {..} = move previous {
    return Option.none<Shared<Rejection>>()
  }
  let active = Vector.asSlice<Shared<Type>>(&visiting.*)
  let mut at = usize.ZERO
  while at < active.length {
    if run Type.equalsShared(&active[at], value) {
      return Option.some<Shared<Rejection>>(run reject(&resolver.*, DeclarationId.moduleId(Application.bodyDeclaration(caller)), RejectionCode.Unsupported, span))
    }
    at = at + usize.ONE
  }
  run Vector.append<Shared<Type>>(&mut visiting.*, Shared.clone<Type>(value))
  let result = run collectRuntimeProjectionInputs(&mut resolver.*, &mut owner.*, &mut dependencies.*, caller,
    bindings, value, &mut projections.*, &mut visiting.*, span)
  let last = Vector.length<Shared<Type>>(&visiting.*) - usize.ONE
  drop Vector.remove<Shared<Type>>(&mut visiting.*, last)
  return move result
}

effect fn collectRuntimeProjectionInputs(resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, caller: &Application, bindings: &[Binding], value: &Shared<Type>,
  projections: &mut Vector<RuntimeProjection>, visiting: &mut Vector<Shared<Type>>, span: Span)
  -> Option<Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let children = run RuntimeType.inputs(value)
  let inputs = Vector.asSlice<Shared<Type>>(&children)
  let mut at = usize.ZERO
  while at < inputs.length {
    let refused = run collectRuntimeProjection(&mut resolver.*, &mut owner.*, &mut dependencies.*, caller,
      bindings, &inputs[at], &mut projections.*, &mut visiting.*, span)
    if let Option<Shared<Rejection>>.Some {value: error} = move refused {
      return Option.some<Shared<Rejection>>(move error)
    }
    at = at + usize.ONE
  }
  let copied = run Type.copy(value)
  if let Type.OpaqueRepresentation {application, ..} = &copied {
    let selected = run Application.copyShared(&application)
    let identity = run Shared.make<DeclarationId>(run DeclarationId.copy(Application.bodyDeclaration(&selected)))
    let module = DeclarationId.moduleId(Application.bodyDeclaration(&selected))
    let ordinal = match move run ordinalOfIdentity(&mut resolver.*, module, &identity) {
      Option<usize>.Some {value: found} => found
      _ => { return Option.some<Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.Unsupported, span)) }
    }
    let name = run internApplication(&mut resolver.*, value)
    let moduleOrdinal = knownModuleOrdinal(&resolver.*, module)
    let answer = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, Key {
      family: Family.OpaqueRealization, module: moduleOrdinal, name: name,
      declaration: ordinal, member: usize.ZERO, external: false}, span)
    let refused = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(&answer, answerRejection)
    if let Option<Shared<Rejection>>.Some {value: error} = move refused { return Option.some<Shared<Rejection>>(move error) }
    let storage = match move Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(&answer, resolvedTypeAnswer) {
      Option<Shared<Type>>.Some {value: realized} => move realized
      _ => { return Option.some<Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.Unsupported, span)) }
    }
    let storageFailure = run collectRuntimeProjectionInputs(&mut resolver.*, &mut owner.*, &mut dependencies.*, caller,
      bindings, &storage, &mut projections.*, &mut visiting.*, span)
    if let Option<Shared<Rejection>>.Some {value: error} = move storageFailure { return Option.some<Shared<Rejection>>(move error) }
    let projected = run RuntimeType.project(&storage, Vector.asSlice<RuntimeProjection>(&projections.*))
    run Vector.append<RuntimeProjection>(&mut projections.*, RuntimeProjection {source: Shared.clone<Type>(value), storage: move projected})
    return Option.none<Shared<Rejection>>()
  }
  if let Type.CallableWitnessResult {..} = &copied {
    let module = DeclarationId.moduleId(Application.bodyDeclaration(caller))
    let premises = match move run closedApplicationBounds(&mut resolver.*, &mut owner.*, &mut dependencies.*, caller, bindings, span) {
      Option<Vector<Constraint>>.Some {value: declared} => move declared
      _ => { return Option.some<Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.Unsupported, span)) }
    }
    let storage = match move run normalizeCallableResult(&mut resolver.*, &mut owner.*, &mut dependencies.*, module,
      Vector.asSlice<Constraint>(&premises), value, span) {
      Result<Shared<Type>, Shared<Rejection>>.Success {value: realized} => move realized
      Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Option.some<Shared<Rejection>>(move error) }
    }
    if Type.containsCallableWitness(&storage) {
      return Option.some<Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.Unsupported, span))
    }
    let storageFailure = run collectRuntimeProjection(&mut resolver.*, &mut owner.*, &mut dependencies.*, caller,
      bindings, &storage, &mut projections.*, &mut visiting.*, span)
    if let Option<Shared<Rejection>>.Some {value: error} = move storageFailure { return Option.some<Shared<Rejection>>(move error) }
    let projected = run RuntimeType.project(&storage, Vector.asSlice<RuntimeProjection>(&projections.*))
    run Vector.append<RuntimeProjection>(&mut projections.*, RuntimeProjection {source: Shared.clone<Type>(value), storage: move projected})
    return Option.none<Shared<Rejection>>()
  }
  if let Type.CallableResult {producer, contract, arguments, selected, selectedOrdinals} = &copied {
    let realizedProducer = run RuntimeType.project(&producer, Vector.asSlice<RuntimeProjection>(&projections.*))
    let module = DeclarationId.moduleId(Application.bodyDeclaration(caller))
    let premises = match move run closedApplicationBounds(&mut resolver.*, &mut owner.*, &mut dependencies.*, caller, bindings, span) {
      Option<Vector<Constraint>>.Some {value: declared} => move declared
      _ => { return Option.some<Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.Unsupported, span)) }
    }
    let storage = match move run selectedCallableResult(&mut resolver.*, &mut owner.*, &mut dependencies.*, module,
      bindings, Vector.asSlice<Constraint>(&premises), &realizedProducer, &arguments, &contract, &selected, &selectedOrdinals, span) {
      Result<Shared<Type>, Shared<Rejection>>.Success {value: realized} => move realized
      Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Option.some<Shared<Rejection>>(move error) }
    }
    let storageFailure = run collectRuntimeProjection(&mut resolver.*, &mut owner.*, &mut dependencies.*, caller,
      bindings, &storage, &mut projections.*, &mut visiting.*, span)
    if let Option<Shared<Rejection>>.Some {value: error} = move storageFailure { return Option.some<Shared<Rejection>>(move error) }
    let projected = run RuntimeType.project(&storage, Vector.asSlice<RuntimeProjection>(&projections.*))
    run Vector.append<RuntimeProjection>(&mut projections.*, RuntimeProjection {source: Shared.clone<Type>(value), storage: move projected})
    return Option.none<Shared<Rejection>>()
  }
  if let Type.CallableStage {base, contract, captures, remaining, suffixMode} = move copied {
    let realizedBase = run RuntimeType.project(&base, Vector.asSlice<RuntimeProjection>(&projections.*))
    let storage = match move run stagedRuntimeSchema(&mut resolver.*, &mut owner.*, &mut dependencies.*, caller,
      bindings, &realizedBase, move contract, move captures, remaining, suffixMode, span) {
      Result<Shared<Type>, Shared<Rejection>>.Success {value: realized} => move realized
      Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Option.some<Shared<Rejection>>(move error) }
    }
    let projected = run RuntimeType.project(&storage, Vector.asSlice<RuntimeProjection>(&projections.*))
    run Vector.append<RuntimeProjection>(&mut projections.*, RuntimeProjection {
      source: Shared.clone<Type>(value), storage: move projected})
  }
  return Option.none<Shared<Rejection>>()
}

// Resolve only source invocation recipes. Opaque families, public views and physical capture
// identity remain semantic proof data; MIR preparation performs its separate storage projection.
effect fn normalizeCallableResult(resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, module: &ModuleId, premises: &[Constraint], value: &Shared<Type>, span: Span)
  -> Result<Shared<Type>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  if privateOriginPhase(&resolver.*).phase == usize.ONE {
    return Result.succeed<Shared<Type>, Shared<Rejection>>(Shared.clone<Type>(value))
  }
  // Settled immutable source types have no normalization query or constructor work to perform.
  // Avoid repeated deep copies during finite graph solving and its mandatory whole-body replay.
  if !Type.needsCallableNormalization(value) {
    return Result.succeed<Shared<Type>, Shared<Rejection>>(Shared.clone<Type>(value))
  }
  let copied = run Type.copy(value)
  if let Type.CallableWitnessResult {witness} = &copied {
    return run normalizeCallableWitness(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, premises, &witness, span)
  }
  if let Type.CallableOrigin {application, contract} = &copied {
    let canonical = match move run normalizeCallableApplication(&mut resolver.*, &mut owner.*, &mut dependencies.*,
      module, premises, &application, span) {
      Result<Application, Shared<Rejection>>.Success {value: normalizedApplication} => move normalizedApplication
      Result<Application, Shared<Rejection>>.Failure {error} => { return Result.failResult<Shared<Type>, Shared<Rejection>>(move error) }
    }
    let exposed = match move run normalizeCallableChildren(&mut resolver.*, &mut owner.*, &mut dependencies.*,
      module, premises, &contract, span) {
      Result<Shared<Type>, Shared<Rejection>>.Success {value: normalizedContract} => move normalizedContract
      Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result.failResult<Shared<Type>, Shared<Rejection>>(move error) }
    }
    let selected = move canonical
    let found = match move run callableResultType(&mut resolver.*, &mut owner.*, &mut dependencies.*,
      &selected, premises, span) {
      Result<Shared<Type>, Shared<Rejection>>.Success {value: resolvedOrigin} => move resolvedOrigin
      Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result.failResult<Shared<Type>, Shared<Rejection>>(move error) }
    }
    return Result.succeed<Shared<Type>, Shared<Rejection>>(run Type.callableView(move found, move exposed))
  }
  if let Type.CallableView {representation, contract} = &copied {
    let original = match move run normalizeCallableResult(&mut resolver.*, &mut owner.*, &mut dependencies.*, module,
      premises, &representation, span) {
      Result<Shared<Type>, Shared<Rejection>>.Success {value: normalized} => move normalized
      Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result.failResult<Shared<Type>, Shared<Rejection>>(move error) }
    }
    let exposed = match move run normalizeCallableChildren(&mut resolver.*, &mut owner.*, &mut dependencies.*, module,
      premises, &contract, span) {
      Result<Shared<Type>, Shared<Rejection>>.Success {value: normalized} => move normalized
      Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result.failResult<Shared<Type>, Shared<Rejection>>(move error) }
    }
    return Result.succeed<Shared<Type>, Shared<Rejection>>(run Type.callableView(move original, move exposed))
  }
  if let Type.Reference {access, lifetime, referent} = &copied {
    let normalized = match move run normalizeCallableResult(&mut resolver.*, &mut owner.*, &mut dependencies.*, module,
      premises, &referent, span) {
      Result<Shared<Type>, Shared<Rejection>>.Success {value: original} => move original
      Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result.failResult<Shared<Type>, Shared<Rejection>>(move error) }
    }
    return Result.succeed<Shared<Type>, Shared<Rejection>>(run Shared.make<Type>(Type.Reference {
      access: access, lifetime: Shared.clone<Lifetime>(&lifetime), referent: move normalized}))
  }
  if let Type.CallableStage {base, contract, captures, remaining, suffixMode} = move copied {
    if Type.hasOpenRuntimeParameters(value) { return Result.succeed<Shared<Type>, Shared<Rejection>>(Shared.clone<Type>(value)) }
    let original = match move run normalizeCallableResult(&mut resolver.*, &mut owner.*, &mut dependencies.*, module,
      premises, &base, span) {
      Result<Shared<Type>, Shared<Rejection>>.Success {value: normalized} => move normalized
      Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result.failResult<Shared<Type>, Shared<Rejection>>(move error) }
    }
    let fields = match move run normalizeCallableTypes(&mut resolver.*, &mut owner.*, &mut dependencies.*, module,
      premises, Vector.asSlice<Shared<Type>>(&captures), span) {
      Result<Vector<Shared<Type>>, Shared<Rejection>>.Success {value: normalized} => move normalized
      Result<Vector<Shared<Type>>, Shared<Rejection>>.Failure {error} => { return Result.failResult<Shared<Type>, Shared<Rejection>>(move error) }
    }
    let exposed = match move run normalizeCallableChildren(&mut resolver.*, &mut owner.*, &mut dependencies.*, module,
      premises, &contract, span) {
      Result<Shared<Type>, Shared<Rejection>>.Success {value: normalized} => move normalized
      Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result.failResult<Shared<Type>, Shared<Rejection>>(move error) }
    }
    if privateOriginPhase(&resolver.*).phase == 2 && (pendingCallableSelection(&original) || pendingCallableSelection(&exposed)) {
      return Result.succeed<Shared<Type>, Shared<Rejection>>(run Shared.make<Type>(Type.CallableStage {base: move original, contract: move exposed, captures: move fields, remaining: remaining, suffixMode: suffixMode}))
    }
    let storage = callableProducerStorage(&original)
    let schema = Shared.with<Type, Option<Shared<SectionSchema>>>(&storage, sectionSchemaOf)
    if let Option<Shared<SectionSchema>>.Some {..} = move schema {
      // Target selection computes the physical invocation mode. Retain the producer's weaker
      // public permission independently, just as direct Value/View staging does.
      let publicContract = Shared.clone<Type>(&exposed)
      let staged = match move run stagedCallableSchema(&mut resolver.*, &mut owner.*, &mut dependencies.*, module,
        premises, &storage, move exposed, move fields, remaining, suffixMode, span) {
        Result<Shared<Type>, Shared<Rejection>>.Success {value: normalized} => move normalized
        Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result.failResult<Shared<Type>, Shared<Rejection>>(move error) }
      }
      return Result.succeed<Shared<Type>, Shared<Rejection>>(run Type.callableView(move staged, move publicContract))
    }
    let target = originalCallableApplication(&original)
    if let Option<Shared<Application>>.Some {value: application} = move target {
      let recorded = run Application.copyShared(&application)
      return Result.succeed<Shared<Type>, Shared<Rejection>>(run Type.stagedCallable(move original, move exposed,
        move fields, remaining, suffixMode, Application.bodyDeclaration(&recorded)))
    }
    return Result.failResult<Shared<Type>, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.Unsupported, span))
  }
  let recipe = run Type.copy(value)
  if let Type.CallableResult {producer, contract, arguments, selected, selectedOrdinals} = &recipe {
    if Type.hasOpenRuntimeParameters(value) { return Result.succeed<Shared<Type>, Shared<Rejection>>(Shared.clone<Type>(value)) }
    let original = match move run normalizeCallableResult(&mut resolver.*, &mut owner.*, &mut dependencies.*, module,
      premises, &producer, span) {
      Result<Shared<Type>, Shared<Rejection>>.Success {value: normalized} => move normalized
      Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result.failResult<Shared<Type>, Shared<Rejection>>(move error) }
    }
    let inputs = match move run normalizeCallableTypes(&mut resolver.*, &mut owner.*, &mut dependencies.*, module,
      premises, Vector.asSlice<Shared<Type>>(&arguments), span) {
      Result<Vector<Shared<Type>>, Shared<Rejection>>.Success {value: normalized} => move normalized
      Result<Vector<Shared<Type>>, Shared<Rejection>>.Failure {error} => { return Result.failResult<Shared<Type>, Shared<Rejection>>(move error) }
    }
    let values = match move run normalizeCallableArguments(&mut resolver.*, &mut owner.*, &mut dependencies.*, module,
      premises, Vector.asSlice<Argument>(&selected), span) {
      Result<Vector<Argument>, Shared<Rejection>>.Success {value: normalized} => move normalized
      Result<Vector<Argument>, Shared<Rejection>>.Failure {error} => { return Result.failResult<Shared<Type>, Shared<Rejection>>(move error) }
    }
    let exposed = match move run normalizeCallableChildren(&mut resolver.*, &mut owner.*, &mut dependencies.*, module,
      premises, &contract, span) {
      Result<Shared<Type>, Shared<Rejection>>.Success {value: normalized} => move normalized
      Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result.failResult<Shared<Type>, Shared<Rejection>>(move error) }
    }
    if privateOriginPhase(&resolver.*).phase == 2 && (pendingCallableSelection(&original) || pendingCallableSelection(&exposed)) {
      let mut ordinals = Vector.make<usize>()
      let slots = Vector.asSlice<usize>(&selectedOrdinals)
      let mut at = usize.ZERO
      while at < slots.length { run Vector.append<usize>(&mut ordinals, slots[at]) at = at + usize.ONE }
      return Result.succeed<Shared<Type>, Shared<Rejection>>(run Shared.make<Type>(Type.CallableResult {producer: move original, contract: move exposed, arguments: move inputs, selected: move values, selectedOrdinals: move ordinals}))
    }
    let none = Vector.make<Binding>()
    return run selectedCallableResult(&mut resolver.*, &mut owner.*, &mut dependencies.*, module,
      Vector.asSlice<Binding>(&none), premises, &original, &inputs, &exposed, &values, &selectedOrdinals, span)
  }
  return run normalizeCallableChildren(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, premises, value, span)
}

// All channels are free checked call-site evidence. Original operation and binding owners stay
// fixed while their values normalize; no interface declaration is invented as an executable key.
effect fn normalizeCallableWitness(resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, module: &ModuleId, premises: &[Constraint], witness: &Shared<WitnessRecipe>, span: Span)
  -> Result<Shared<Type>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let original = Shared.with<WitnessRecipe, WitnessRecipe>(witness, CallableWitness.copy)
  let mut channels = Vector.make<Shared<Type>>()
  run Vector.append<Shared<Type>>(&mut channels, Shared.clone<Type>(&original.contract))
  run Vector.append<Shared<Type>>(&mut channels, Shared.clone<Type>(&original.provider))
  run Vector.append<Shared<Type>>(&mut channels, Shared.clone<Type>(&original.result))
  let mut normalized = match move run normalizeCallableTypes(&mut resolver.*, &mut owner.*, &mut dependencies.*,
    module, premises, Vector.asSlice<Shared<Type>>(&channels), span) {
    Result<Vector<Shared<Type>>, Shared<Rejection>>.Success {value} => move value
    Result<Vector<Shared<Type>>, Shared<Rejection>>.Failure {error} => { return Result.failResult<Shared<Type>, Shared<Rejection>>(move error) }
  }
  let contract = Vector.remove<Shared<Type>>(&mut normalized, usize.ZERO)
  let provider = Vector.remove<Shared<Type>>(&mut normalized, usize.ZERO)
  let result = Vector.remove<Shared<Type>>(&mut normalized, usize.ZERO)
  let mut bindings = Vector.make<Binding>()
  let mut at = usize.ZERO
  while at < CallableWitness.bindingCount(&original) {
    let binding = CallableWitness.bindingAt(&original, at)
    let selected = match move run normalizeCallableArgument(&mut resolver.*, &mut owner.*, &mut dependencies.*,
      module, premises, &binding.value, span) {
      Result<Argument, Shared<Rejection>>.Success {value} => move value
      Result<Argument, Shared<Rejection>>.Failure {error} => { return Result.failResult<Shared<Type>, Shared<Rejection>>(move error) }
    }
    run Vector.append<Binding>(&mut bindings, Binding {declaration: move binding.declaration, ordinal: binding.ordinal, value: move selected})
    at = at + usize.ONE
  }
  let mut arguments = Vector.make<Shared<Type>>()
  at = usize.ZERO
  while at < CallableWitness.argumentCount(&original) {
    let selected = match move run normalizeCallableResult(&mut resolver.*, &mut owner.*, &mut dependencies.*,
      module, premises, &CallableWitness.argumentAt(&original, at), span) {
      Result<Shared<Type>, Shared<Rejection>>.Success {value} => move value
      Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result.failResult<Shared<Type>, Shared<Rejection>>(move error) }
    }
    run Vector.append<Shared<Type>>(&mut arguments, move selected)
    at = at + usize.ONE
  }
  let recipe = WitnessRecipe {operation: move original.operation, contract: move contract, provider: move provider, result: move result,
    bindings: run Shared.make<Vector<Binding>>(move bindings), arguments: run Shared.make<Vector<Shared<Type>>>(move arguments),
    loans: move original.loans}
  let exposed = Shared.clone<Type>(&recipe.result)
  let candidate = run Shared.make<Type>(Type.CallableWitnessResult {witness: run Shared.make<WitnessRecipe>(CallableWitness.copy(&recipe))})
  if Type.hasOpenRuntimeParameters(&candidate) {
    return Result.succeed<Shared<Type>, Shared<Rejection>>(move candidate)
  }
  let mut request = Request.make()
  let witnessApplication = match move run completedWitnessApplication(&mut resolver.*, &mut owner.*, &mut request,
    &mut dependencies.*, &recipe, module, span) {
    Result<ResolvedWitness, Shared<Rejection>>.Success {value} => move value
    Result<ResolvedWitness, Shared<Rejection>>.Failure {error} => { return Result.failResult<Shared<Type>, Shared<Rejection>>(move error) }
  }
  let selected = match move run callableResultType(&mut resolver.*, &mut owner.*, &mut dependencies.*,
    &witnessApplication.application, premises, span) {
    Result<Shared<Type>, Shared<Rejection>>.Success {value} => move value
    Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result.failResult<Shared<Type>, Shared<Rejection>>(move error) }
  }
  return Result.succeed<Shared<Type>, Shared<Rejection>>(run Type.callableView(move selected, move exposed))
}

// Source normalization preserves declarations, opaque families and bound schema blueprints.
// Only free selected application channels and semantic child values may reveal closed recipes.
effect fn normalizeCallableChildren(resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, module: &ModuleId, premises: &[Constraint], source: &Shared<Type>, span: Span)
  -> Result<Shared<Type>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  // Direct contract walkers also reach settled trees without the result entry point.
  if !Type.needsCallableNormalization(source) {
    return Result.succeed<Shared<Type>, Shared<Rejection>>(Shared.clone<Type>(source))
  }
  let copied = run Type.copy(source)
  match move copied {
    Type.CallableValue {isPublic, application, contract, captures, fieldInputs, ..} => {
      let selected = match move run normalizeCallableApplication(&mut resolver.*, &mut owner.*, &mut dependencies.*,
        module, premises, &application, span) {
        Result<Application, Shared<Rejection>>.Success {value} => move value
        Result<Application, Shared<Rejection>>.Failure {error} => { return Result.failResult<Shared<Type>, Shared<Rejection>>(move error) }
      }
      let fields = match move run normalizeCallableTypes(&mut resolver.*, &mut owner.*, &mut dependencies.*,
        module, premises, Vector.asSlice<Shared<Type>>(&captures), span) {
        Result<Vector<Shared<Type>>, Shared<Rejection>>.Success {value} => move value
        Result<Vector<Shared<Type>>, Shared<Rejection>>.Failure {error} => { return Result.failResult<Shared<Type>, Shared<Rejection>>(move error) }
      }
      let exposed = match move run normalizeCallableChildren(&mut resolver.*, &mut owner.*, &mut dependencies.*, module,
        premises, &contract, span) {
        Result<Shared<Type>, Shared<Rejection>>.Success {value} => move value
        Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result.failResult<Shared<Type>, Shared<Rejection>>(move error) }
      }
      return Result.succeed<Shared<Type>, Shared<Rejection>>(run Type.callableValue(isPublic,
        run Shared.make<Application>(move selected), move exposed, move fields, move fieldInputs))
    }
    Type.CallableSchema {schema, captures, fieldInputs, ..} => {
      let mut selected = run CallableSchema.copy(&schema)
      let arguments = Vector.asMutSlice<Binding>(&mut selected.selected)
      let mut at = usize.ZERO
      while at < arguments.length {
        let resolved = match move run normalizeCallableArgument(&mut resolver.*, &mut owner.*, &mut dependencies.*,
          module, premises, &arguments[at].value, span) {
          Result<Argument, Shared<Rejection>>.Success {value} => move value
          Result<Argument, Shared<Rejection>>.Failure {error} => { return Result.failResult<Shared<Type>, Shared<Rejection>>(move error) }
        }
        arguments[at].value = move resolved
        at = at + usize.ONE
      }
      let fields = match move run normalizeCallableTypes(&mut resolver.*, &mut owner.*, &mut dependencies.*,
        module, premises, Vector.asSlice<Shared<Type>>(&captures), span) {
        Result<Vector<Shared<Type>>, Shared<Rejection>>.Success {value} => move value
        Result<Vector<Shared<Type>>, Shared<Rejection>>.Failure {error} => { return Result.failResult<Shared<Type>, Shared<Rejection>>(move error) }
      }
      // contract/parameter/result blueprints retain the target's own bound variables unchanged.
      return Result.succeed<Shared<Type>, Shared<Rejection>>(run Type.callableSchema(
        run Shared.make<SectionSchema>(move selected), move fields, move fieldInputs))
    }
    Type.EffectComposite {operation, selector, contract, parts} => {
      let selected = match move run normalizeCallableResult(&mut resolver.*, &mut owner.*, &mut dependencies.*,
        module, premises, &selector, span) {
        Result<Shared<Type>, Shared<Rejection>>.Success {value} => move value
        Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result.failResult<Shared<Type>, Shared<Rejection>>(move error) }
      }
      let exposed = match move run normalizeCallableChildren(&mut resolver.*, &mut owner.*, &mut dependencies.*,
        module, premises, &contract, span) {
        Result<Shared<Type>, Shared<Rejection>>.Success {value} => move value
        Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result.failResult<Shared<Type>, Shared<Rejection>>(move error) }
      }
      let fields = match move run normalizeCallableTypes(&mut resolver.*, &mut owner.*, &mut dependencies.*,
        module, premises, Vector.asSlice<Shared<Type>>(&parts), span) {
        Result<Vector<Shared<Type>>, Shared<Rejection>>.Success {value} => move value
        Result<Vector<Shared<Type>>, Shared<Rejection>>.Failure {error} => { return Result.failResult<Shared<Type>, Shared<Rejection>>(move error) }
      }
      return Result.succeed<Shared<Type>, Shared<Rejection>>(run Shared.make<Type>(Type.EffectComposite {
        operation: operation, selector: move selected, contract: move exposed, parts: move fields}))
    }
    Type.Callable {mode, isUnsafe, environment, invocationBinders, invocationUse, invocationBounds, parameters, result} => {
      let inputs = match move run normalizeCallableTypes(&mut resolver.*, &mut owner.*, &mut dependencies.*, module,
        premises, Vector.asSlice<Shared<Type>>(&parameters), span) {
        Result<Vector<Shared<Type>>, Shared<Rejection>>.Success {value} => move value
        Result<Vector<Shared<Type>>, Shared<Rejection>>.Failure {error} => { return Result.failResult<Shared<Type>, Shared<Rejection>>(move error) }
      }
      let output = match move run normalizeCallableResult(&mut resolver.*, &mut owner.*, &mut dependencies.*, module,
        premises, &result, span) {
        Result<Shared<Type>, Shared<Rejection>>.Success {value} => move value
        Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result.failResult<Shared<Type>, Shared<Rejection>>(move error) }
      }
      return Result.succeed<Shared<Type>, Shared<Rejection>>(run Shared.make<Type>(Type.Callable {
        mode: mode, isUnsafe: isUnsafe, environment: move environment, invocationBinders: invocationBinders, invocationUse: invocationUse,
        invocationBounds: move invocationBounds, parameters: move inputs, result: move output}))
    }
    Type.Nominal {declaration, isPublic, arguments} => {
      let selected = match move run normalizeCallableArguments(&mut resolver.*, &mut owner.*, &mut dependencies.*,
        module, premises, Vector.asSlice<Argument>(&arguments), span) {
        Result<Vector<Argument>, Shared<Rejection>>.Success {value} => move value
        Result<Vector<Argument>, Shared<Rejection>>.Failure {error} => { return Result.failResult<Shared<Type>, Shared<Rejection>>(move error) }
      }
      return Result.succeed<Shared<Type>, Shared<Rejection>>(run Shared.make<Type>(Type.Nominal {
        declaration: move declaration, isPublic: isPublic, arguments: move selected}))
    }
    Type.OpaqueRepresentation {application, contract, detached, nonParking} => {
      let selected = match move run normalizeCallableApplication(&mut resolver.*, &mut owner.*, &mut dependencies.*,
        module, premises, &application, span) {
        Result<Application, Shared<Rejection>>.Success {value} => move value
        Result<Application, Shared<Rejection>>.Failure {error} => { return Result.failResult<Shared<Type>, Shared<Rejection>>(move error) }
      }
      let exposed = match move run normalizeCallableChildren(&mut resolver.*, &mut owner.*, &mut dependencies.*, module,
        premises, &contract, span) {
        Result<Shared<Type>, Shared<Rejection>>.Success {value} => move value
        Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result.failResult<Shared<Type>, Shared<Rejection>>(move error) }
      }
      return Result.succeed<Shared<Type>, Shared<Rejection>>(run Shared.make<Type>(Type.OpaqueRepresentation {
        application: run Shared.make<Application>(move selected), contract: move exposed, detached: detached, nonParking: nonParking}))
    }
    Type.Anonymous {occurrence, members} => {
      let selected = match move run normalizeCallableTypes(&mut resolver.*, &mut owner.*, &mut dependencies.*,
        module, premises, Vector.asSlice<Shared<Type>>(&members), span) {
        Result<Vector<Shared<Type>>, Shared<Rejection>>.Success {value} => move value
        Result<Vector<Shared<Type>>, Shared<Rejection>>.Failure {error} => { return Result.failResult<Shared<Type>, Shared<Rejection>>(move error) }
      }
      return Result.succeed<Shared<Type>, Shared<Rejection>>(run Shared.make<Type>(Type.Anonymous {occurrence: move occurrence, members: move selected}))
    }
    Type.Union {members} => {
      let selected = match move run normalizeCallableTypes(&mut resolver.*, &mut owner.*, &mut dependencies.*,
        module, premises, Vector.asSlice<Shared<Type>>(&members), span) {
        Result<Vector<Shared<Type>>, Shared<Rejection>>.Success {value} => move value
        Result<Vector<Shared<Type>>, Shared<Rejection>>.Failure {error} => { return Result.failResult<Shared<Type>, Shared<Rejection>>(move error) }
      }
      let mut joined = Vector.make<Shared<Type>>()
      let listed = Vector.asSlice<Shared<Type>>(&selected)
      let mut at = usize.ZERO
      while at < listed.length { run Type.joinMember(&mut joined, &listed[at]) at = at + usize.ONE }
      let canonical = Vector.asSlice<Shared<Type>>(&joined)
      if canonical.length == usize.ONE {
        return Result.succeed<Shared<Type>, Shared<Rejection>>(Shared.clone<Type>(&canonical[usize.ZERO]))
      }
      return Result.succeed<Shared<Type>, Shared<Rejection>>(run Shared.make<Type>(Type.Union {members: move joined}))
    }
    Type.Array {element, extent} => {
      let selected = match move run normalizeCallableResult(&mut resolver.*, &mut owner.*, &mut dependencies.*,
        module, premises, &element, span) {
        Result<Shared<Type>, Shared<Rejection>>.Success {value} => move value
        Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result.failResult<Shared<Type>, Shared<Rejection>>(move error) }
      }
      return Result.succeed<Shared<Type>, Shared<Rejection>>(run Shared.make<Type>(Type.Array {element: move selected, extent: move extent}))
    }
    Type.Slice {element, access, lifetime} => {
      let selected = match move run normalizeCallableResult(&mut resolver.*, &mut owner.*, &mut dependencies.*,
        module, premises, &element, span) {
        Result<Shared<Type>, Shared<Rejection>>.Success {value} => move value
        Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result.failResult<Shared<Type>, Shared<Rejection>>(move error) }
      }
      return Result.succeed<Shared<Type>, Shared<Rejection>>(run Shared.make<Type>(Type.Slice {element: move selected, access: access, lifetime: move lifetime}))
    }
    Type.Pointer {pointee, access, nullable, multiplicity, alignment} => {
      let selected = match move run normalizeCallableResult(&mut resolver.*, &mut owner.*, &mut dependencies.*,
        module, premises, &pointee, span) {
        Result<Shared<Type>, Shared<Rejection>>.Success {value} => move value
        Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result.failResult<Shared<Type>, Shared<Rejection>>(move error) }
      }
      return Result.succeed<Shared<Type>, Shared<Rejection>>(run Shared.make<Type>(Type.Pointer {pointee: move selected, access: access, nullable: nullable, multiplicity: multiplicity, alignment: move alignment}))
    }
    Type.TypeDescriptor {owner: described} => {
      let selected = match move run normalizeCallableResult(&mut resolver.*, &mut owner.*, &mut dependencies.*,
        module, premises, &described, span) {
        Result<Shared<Type>, Shared<Rejection>>.Success {value} => move value
        Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result.failResult<Shared<Type>, Shared<Rejection>>(move error) }
      }
      return Result.succeed<Shared<Type>, Shared<Rejection>>(run Shared.make<Type>(Type.TypeDescriptor {owner: move selected}))
    }
    _ => { return Result.succeed<Shared<Type>, Shared<Rejection>>(Shared.clone<Type>(source)) }
  }
}

effect fn normalizeCallableTypes(resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, module: &ModuleId, premises: &[Constraint], values: &[Shared<Type>], span: Span)
  -> Result<Vector<Shared<Type>>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let mut output = Vector.make<Shared<Type>>()
  let mut at = usize.ZERO
  while at < values.length {
    let selected = match move run normalizeCallableResult(&mut resolver.*, &mut owner.*, &mut dependencies.*,
      module, premises, &values[at], span) {
      Result<Shared<Type>, Shared<Rejection>>.Success {value} => move value
      Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result.failResult<Vector<Shared<Type>>, Shared<Rejection>>(move error) }
    }
    run Vector.append<Shared<Type>>(&mut output, move selected)
    at = at + usize.ONE
  }
  return Result.succeed<Vector<Shared<Type>>, Shared<Rejection>>(move output)
}

effect fn normalizeCallableArgument(resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, module: &ModuleId, premises: &[Constraint], source: &Argument, span: Span)
  -> Result<Argument, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  if let Argument.Type {value: ty} = &source.* {
    let selected = match move run normalizeCallableResult(&mut resolver.*, &mut owner.*, &mut dependencies.*,
      module, premises, &ty, span) {
      Result<Shared<Type>, Shared<Rejection>>.Success {value} => move value
      Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result.failResult<Argument, Shared<Rejection>>(move error) }
    }
    return Result.succeed<Argument, Shared<Rejection>>(Argument.Type {value: move selected})
  }
  return Result.succeed<Argument, Shared<Rejection>>(Argument.copy(source))
}

effect fn normalizeCallableArguments(resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, module: &ModuleId, premises: &[Constraint], values: &[Argument], span: Span)
  -> Result<Vector<Argument>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let mut output = Vector.make<Argument>()
  let mut at = usize.ZERO
  while at < values.length {
    let selected = match move run normalizeCallableArgument(&mut resolver.*, &mut owner.*, &mut dependencies.*,
      module, premises, &values[at], span) {
      Result<Argument, Shared<Rejection>>.Success {value} => move value
      Result<Argument, Shared<Rejection>>.Failure {error} => { return Result.failResult<Vector<Argument>, Shared<Rejection>>(move error) }
    }
    run Vector.append<Argument>(&mut output, move selected)
    at = at + usize.ONE
  }
  return Result.succeed<Vector<Argument>, Shared<Rejection>>(move output)
}

effect fn normalizeCallableApplication(resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, module: &ModuleId, premises: &[Constraint], source: &Shared<Application>, span: Span)
  -> Result<Application, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let mut selected = run Application.copyShared(source)
  let arguments = match move run normalizeCallableArguments(&mut resolver.*, &mut owner.*, &mut dependencies.*,
    module, premises, Vector.asSlice<Argument>(&selected.arguments), span) {
    Result<Vector<Argument>, Shared<Rejection>>.Success {value} => move value
    Result<Vector<Argument>, Shared<Rejection>>.Failure {error} => { return Result.failResult<Application, Shared<Rejection>>(move error) }
  }
  selected.arguments = move arguments
  let scopes = Vector.asMutSlice<ScopeBinding>(&mut selected.scopes)
  let mut at = usize.ZERO
  while at < scopes.length {
    let supplied = match move run normalizeCallableArguments(&mut resolver.*, &mut owner.*, &mut dependencies.*,
      module, premises, Vector.asSlice<Argument>(&scopes[at].arguments), span) {
      Result<Vector<Argument>, Shared<Rejection>>.Success {value} => move value
      Result<Vector<Argument>, Shared<Rejection>>.Failure {error} => { return Result.failResult<Application, Shared<Rejection>>(move error) }
    }
    scopes[at].arguments = move supplied
    at = at + usize.ONE
  }
  return Result.succeed<Application, Shared<Rejection>>(move selected)
}

// Target selection reads through public views and storage loans without changing their contracts.
fn callableProducerStorage(value: &Shared<Type>) -> Shared<Type> {
  let nested = Shared.with<Type, Option<Shared<Type>>>(value, fn(node: &Type) -> Option<Shared<Type>> {
    return match &node.* {
      Type.CallableView {representation, ..} => Option.some<Shared<Type>>(Shared.clone<Type>(&representation))
      Type.Reference {referent, ..} => Option.some<Shared<Type>>(Shared.clone<Type>(&referent))
      _ => Option.none<Shared<Type>>()
    }
  })
  if let Option<Shared<Type>>.Some {value: child} = move nested { return callableProducerStorage(&child) }
  return Shared.clone<Type>(value)
}

effect fn selectedCallableResult(resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, module: &ModuleId, bindings: &[Binding], premises: &[Constraint], producer: &Shared<Type>,
  arguments: &Vector<Shared<Type>>, contract: &Shared<Type>, selected: &Vector<Argument>, selectedOrdinals: &Vector<usize>, span: Span)
  -> Result<Shared<Type>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let original = callableProducerStorage(producer)
  let retained = originalCallableApplication(&original)
  let mut application = Option.none<Application>()
  if let Option<Shared<Application>>.Some {value} = move retained {
    let recorded = run Application.copyShared(&value)
    if DeclarationId.kind(Application.bodyDeclaration(&recorded)) == OwnerKind.Anonymous {
      let target = run DeclarationId.copy(Application.bodyDeclaration(&recorded))
      let signature = run sectionOriginalSignature(&mut resolver.*, &mut owner.*, &mut dependencies.*, &target, span)
      let applied = run anonymousInvocationApplication(&recorded, &signature, Vector.asSlice<Argument>(selected), Vector.asSlice<usize>(selectedOrdinals))
      if let Result<Application, PreparationFailure>.Success {value: closed} = move applied { application = Option.some<Application>(move closed) }
    } else { application = Option.some<Application>(move recorded) }
  } else {
    let schema = Shared.with<Type, Option<Shared<SectionSchema>>>(&original, sectionSchemaOf)
    if let Option<Shared<SectionSchema>>.Some {value} = move schema {
      let found = run schemaCallableApplication(&mut resolver.*, &mut owner.*, &mut dependencies.*, module,
        bindings, premises, &value, Vector.asSlice<Shared<Type>>(arguments), span)
      if let Result<Application, PreparationFailure>.Success {value: closed} = move found { application = Option.some<Application>(move closed) }
    }
  }
  let closed = match move application { Option<Application>.Some {value} => move value
    _ => { return Result.failResult<Shared<Type>, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.Unsupported, span)) } }
  let result = match move run callableResultType(&mut resolver.*, &mut owner.*, &mut dependencies.*, &closed, premises, span) {
    Result<Shared<Type>, Shared<Rejection>>.Success {value} => move value
    Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result.failResult<Shared<Type>, Shared<Rejection>>(move error) }
  }
  return Result.succeed<Shared<Type>, Shared<Rejection>>(run Type.callableView(move result, Shared.clone<Type>(contract)))
}

// The authored owner graph is finite even when its concrete pointer applications grow.
// Inspect symbolic fields before substitutions can erase a latent T | Leaf union.
struct UnionStorageBlueprint {
  hasUnion: bool
  changesRepresentation: bool
  unknown: bool
}

fn unionStorageShape(value: &Type) -> bool {
  return match &value.* { Type.Union {..} => true _ => false }
}

fn unionStorageProjectionForm(value: &Type) -> bool {
  return match &value.* {
    Type.OpaqueRepresentation {..} => true
    Type.CallableView {..} => true
    Type.CallableOrigin {..} => true
    Type.CallableResult {..} => true
    Type.CallableWitnessResult {..} => true
    Type.CallableStage {..} => true
    _ => false
  }
}

effect fn unionStorageIdentity(value: &Shared<Type>) -> Option<Shared<Type>>
! OutOfMemoryError ? &mut Allocator {
  let copied = run Type.copy(value)
  if let Type.Nominal {declaration, isPublic, arguments} = move copied {
    let listed = Vector.asSlice<Argument>(&arguments)
    let mut generic = Vector.make<Argument>()
    let mut at = usize.ZERO
    while at < listed.length {
      match &listed[at] {
        Argument.Type {..} => run Vector.append<Argument>(&mut generic, Argument.Type {
          value: run Shared.make<Type>(Type.Parameter {declaration: run DeclarationId.copy(&declaration), ordinal: at})})
        Argument.Lifetime {..} => run Vector.append<Argument>(&mut generic, Argument.Lifetime {
          value: run Shared.make<Lifetime>(Lifetime.Parameter {declaration: run DeclarationId.copy(&declaration), ordinal: at})})
        // A changing static or row family needs its own symbolic storage proof.
        _ => { return Option.none<Shared<Type>>() }
      }
      at = at + usize.ONE
    }
    return Option.some<Shared<Type>>(run Shared.make<Type>(Type.Nominal {
      declaration: move declaration, isPublic: isPublic, arguments: move generic}))
  }
  return Option.none<Shared<Type>>()
}

effect fn unionStorageBlueprint(resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, value: &Shared<Type>, projections: &[RuntimeProjection],
  owners: &mut Vector<Shared<Type>>, facts: &mut UnionStorageBlueprint, span: Span) -> Option<Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  if Shared.with<Type, bool>(value, unionStorageShape) { facts.hasUnion = true }
  if Shared.with<Type, bool>(value, unionStorageProjectionForm) { facts.changesRepresentation = true }
  let projected = run RuntimeType.project(value, projections)
  if !run Type.equalsShared(value, &projected) { facts.changesRepresentation = true }
  // Check actual finite argument trees independently of the nominal-owner cutoff.
  let children = run RuntimeType.inputs(value)
  let listed = Vector.asSlice<Shared<Type>>(&children)
  let mut at = usize.ZERO
  while at < listed.length {
    let rejected = run unionStorageBlueprint(&mut resolver.*, &mut owner.*, &mut dependencies.*,
      &listed[at], projections, &mut owners.*, &mut facts.*, span)
    if let Option<Shared<Rejection>>.Some {value: error} = move rejected { return Option.some<Shared<Rejection>>(move error) }
    at = at + usize.ONE
  }
  if !Shared.with<Type, bool>(value, isNominalType) { return Option.none<Shared<Rejection>>() }
  let earlier = Vector.asSlice<Shared<Type>>(&owners.*)
  at = usize.ZERO
  while at < earlier.length {
    if sameNominal(value, &earlier[at]) { return Option.none<Shared<Rejection>>() }
    at = at + usize.ONE
  }
  run Vector.append<Shared<Type>>(&mut owners.*, Shared.clone<Type>(value))
  let identity = match move run unionStorageIdentity(value) {
    Option<Shared<Type>>.Some {value: symbolic} => move symbolic
    _ => {
      facts.unknown = true
      return Option.none<Shared<Rejection>>()
    }
  }
  let parts = match move run nominalParts(&mut resolver.*, &mut owner.*, &mut dependencies.*, &identity, span) {
    Result<Vector<Shared<Type>>, Shared<Rejection>>.Success {value: fields} => move fields
    Result<Vector<Shared<Type>>, Shared<Rejection>>.Failure {error} => { return Option.some<Shared<Rejection>>(move error) }
  }
  let fields = Vector.asSlice<Shared<Type>>(&parts)
  at = usize.ZERO
  while at < fields.length {
    let rejected = run unionStorageBlueprint(&mut resolver.*, &mut owner.*, &mut dependencies.*,
      &fields[at], projections, &mut owners.*, &mut facts.*, span)
    if let Option<Shared<Rejection>>.Some {value: error} = move rejected { return Option.some<Shared<Rejection>>(move error) }
    at = at + usize.ONE
  }
  return Option.none<Shared<Rejection>>()
}

// A descriptor can carry a union without generating an injection or payload operation.
// Ordinary generic alias collapse precedes this check; only representation projection must
// preserve an injective map. Tag-bearing operations validate their original ordinals separately.
effect fn validateRuntimeUnionMaps(resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, value: &Shared<Type>, bindings: &[Binding], projections: &[RuntimeProjection],
  visited: &mut Vector<Shared<Type>>, active: &mut Vector<Shared<Type>>, module: &ModuleId, span: Span) -> Option<Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let closed = run Type.applyBindings(value, bindings, true)
  let empty = Vector.make<Binding>()
  let noBindings = Vector.asSlice<Binding>(&empty)
  let earlier = Vector.asSlice<Shared<Type>>(&visited.*)
  let mut at = usize.ZERO
  while at < earlier.length {
    if run Type.equalsShared(&closed, &earlier[at]) { return Option.none<Shared<Rejection>>() }
    at = at + usize.ONE
  }
  let storage = run RuntimeType.project(&closed, projections)
  if Shared.with<Type, bool>(&closed, unionStorageShape) && !Shared.with<Type, bool>(&closed, neverType)
    && !run Type.equalsShared(&closed, &storage) {
    let mapped = run UnionProjection.map(&closed, noBindings, projections)
    if let Option<Vector<UnionProjection.Member>>.None = move mapped {
      return Option.some<Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.UnionFormUnavailable, span))
    }
  }
  run Vector.append<Shared<Type>>(&mut visited.*, Shared.clone<Type>(&closed))
  let nominal = Shared.with<Type, bool>(&closed, isNominalType)
  // Finite argument subtrees are checked even when a later field edge repeats its owner.
  let children = run RuntimeType.inputs(&closed)
  let listed = Vector.asSlice<Shared<Type>>(&children)
  at = usize.ZERO
  while at < listed.length {
    let rejected = run validateRuntimeUnionMaps(&mut resolver.*, &mut owner.*, &mut dependencies.*, &listed[at],
      noBindings, projections, &mut visited.*, &mut active.*, module, span)
    if let Option<Shared<Rejection>>.Some {value: error} = move rejected { return Option.some<Shared<Rejection>>(move error) }
    at = at + usize.ONE
  }
  if !nominal { return Option.none<Shared<Rejection>>() }
  // This proof covers ABI changes introduced through projected nominal arguments. An unchanged
  // descriptor referent does not demand unrelated field validity (including elided field binders).
  if run Type.equalsShared(&closed, &storage) { return Option.none<Shared<Rejection>>() }
  let path = Vector.asSlice<Shared<Type>>(&active.*)
  at = usize.ZERO
  while at < path.length {
    if sameNominal(&closed, &path[at]) {
      let mut owners = Vector.make<Shared<Type>>()
      let mut facts = UnionStorageBlueprint {hasUnion: false, changesRepresentation: false, unknown: false}
      let rejected = run unionStorageBlueprint(&mut resolver.*, &mut owner.*, &mut dependencies.*, &closed,
        projections, &mut owners, &mut facts, span)
      if let Option<Shared<Rejection>>.Some {value: error} = move rejected { return Option.some<Shared<Rejection>>(move error) }
      if facts.unknown || (facts.hasUnion && facts.changesRepresentation) {
        return Option.some<Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.UnionFormUnavailable, span))
      }
      return Option.none<Shared<Rejection>>()
    }
    at = at + usize.ONE
  }
  run Vector.append<Shared<Type>>(&mut active.*, Shared.clone<Type>(&closed))
  let parts = match move run nominalParts(&mut resolver.*, &mut owner.*, &mut dependencies.*, &closed, span) {
    Result<Vector<Shared<Type>>, Shared<Rejection>>.Success {value: fields} => move fields
    Result<Vector<Shared<Type>>, Shared<Rejection>>.Failure {error} => { return Option.some<Shared<Rejection>>(move error) }
  }
  let fields = Vector.asSlice<Shared<Type>>(&parts)
  at = usize.ZERO
  while at < fields.length {
    let rejected = run validateRuntimeUnionMaps(&mut resolver.*, &mut owner.*, &mut dependencies.*, &fields[at],
      noBindings, projections, &mut visited.*, &mut active.*, module, span)
    if let Option<Shared<Rejection>>.Some {value: error} = move rejected { return Option.some<Shared<Rejection>>(move error) }
    at = at + usize.ONE
  }
  drop Vector.pop<Shared<Type>>(&mut active.*)
  return Option.none<Shared<Rejection>>()
}

effect fn runtimeProjections(resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, caller: &Application, bindings: &[Binding], body: &Shared<TypedBody>,
  result: &Shared<Type>, parameters: &[Shared<Type>]) -> Result<Vector<RuntimeProjection>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let locals = Shared.with<TypedBody, usize>(body, fn(value: &TypedBody) -> usize { return TypedBody.localSlice(value).length })
  let nodes = Shared.with<TypedBody, usize>(body, fn(value: &TypedBody) -> usize { return TypedBody.nodeSlice(value).length })
  let mut projections = Vector.make<RuntimeProjection>()
  let mut visiting = Vector.make<Shared<Type>>()
  let mut at = usize.ZERO
  while at < locals + nodes + parameters.length + usize.ONE {
    let written = runtimeProjectionType(body, result, parameters, locals, nodes, at)
    if let Option<Shared<Type>>.Some {value} = move written {
      let closed = run Type.applyBindings(&value, bindings, true)
      let span = Shared.with<TypedBody, Span>(body, fn(value: &TypedBody) -> Span {
        return TypedBody.nodeSlice(value)[TypedBody.rootNode(value).index].origin.span
      })
      let refused = run collectRuntimeProjection(&mut resolver.*, &mut owner.*, &mut dependencies.*, caller,
        bindings, &closed, &mut projections, &mut visiting, span)
      if let Option<Shared<Rejection>>.Some {value: error} = move refused {
        return Result.failResult<Vector<RuntimeProjection>, Shared<Rejection>>(move error)
      }
    }
    at = at + usize.ONE
  }
  let span = Shared.with<TypedBody, Span>(body, fn(value: &TypedBody) -> Span {
    return TypedBody.nodeSlice(value)[TypedBody.rootNode(value).index].origin.span
  })
  let mut mapped = Vector.make<Shared<Type>>()
  let mut mappingPath = Vector.make<Shared<Type>>()
  at = usize.ZERO
  while at < locals + nodes + parameters.length + usize.ONE {
    let written = runtimeProjectionType(body, result, parameters, locals, nodes, at)
    if let Option<Shared<Type>>.Some {value} = move written {
      let rejected = run validateRuntimeUnionMaps(&mut resolver.*, &mut owner.*, &mut dependencies.*, &value,
        bindings, Vector.asSlice<RuntimeProjection>(&projections), &mut mapped, &mut mappingPath,
        DeclarationId.moduleId(Application.bodyDeclaration(caller)), span)
      if let Option<Shared<Rejection>>.Some {value: error} = move rejected {
        return Result.failResult<Vector<RuntimeProjection>, Shared<Rejection>>(move error)
      }
    }
    at = at + usize.ONE
  }
  let realized = Vector.asSlice<RuntimeProjection>(&projections)
  at = usize.ZERO
  while at < realized.length {
    let rejected = run validateRuntimeUnionMaps(&mut resolver.*, &mut owner.*, &mut dependencies.*, &realized[at].storage,
      bindings, realized, &mut mapped, &mut mappingPath, DeclarationId.moduleId(Application.bodyDeclaration(caller)), span)
    if let Option<Shared<Rejection>>.Some {value: error} = move rejected {
      return Result.failResult<Vector<RuntimeProjection>, Shared<Rejection>>(move error)
    }
    at = at + usize.ONE
  }
  return Result.succeed<Vector<RuntimeProjection>, Shared<Rejection>>(move projections)
}

fn runtimeProjectionType(body: &Shared<TypedBody>, result: &Shared<Type>, parameters: &[Shared<Type>],
  locals: usize, nodes: usize, at: usize) -> Option<Shared<Type>> {
  if at < locals { return Option.some<Shared<Type>>(Shared.with<TypedBody, Shared<Type>>(body,
    fn(value: &TypedBody) -> Shared<Type> {
      let listed = TypedBody.localSlice(value)
      return Shared.clone<Type>(&listed[at].ty)
    })) }
  if at < locals + nodes { return Shared.with<TypedBody, Option<Shared<Type>>>(body,
    fn(value: &TypedBody) -> Option<Shared<Type>> { return nodeTypeAt(value, at - locals) }) }
  if at < locals + nodes + parameters.length {
    return Option.some<Shared<Type>>(Shared.clone<Type>(&parameters[at - locals - nodes]))
  }
  return Option.some<Shared<Type>>(Shared.clone<Type>(result))
}

// Which locals and node values of a typed body need cleanup under the caller's bindings and the
// body's declared premises.
effect fn cleanupNeeds(
  resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, body: &Shared<TypedBody>, bindings: &[Binding], projections: &[RuntimeProjection],
  constraints: &[Constraint],
) -> Result<CleanupNeeds, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let span = Shared.with<TypedBody, Span>(body, fn(value: &TypedBody) -> Span {
    let nodes = TypedBody.nodeSlice(value)
    return nodes[TypedBody.rootNode(value).index].origin.span
  })
  let localCount = Shared.with<TypedBody, usize>(body, fn(value: &TypedBody) -> usize { return TypedBody.localSlice(value).length })
  let nodeCount = Shared.with<TypedBody, usize>(body, fn(value: &TypedBody) -> usize { return TypedBody.nodeSlice(value).length })
  let mut known = Vector.make<Shared<Type>>()
  let mut verdicts = Vector.make<bool>()
  let mut localNeeds = Vector.make<bool>()
  let mut nodeNeeds = Vector.make<bool>()
  let mut at = usize.ZERO
  while at < localCount + nodeCount {
    let written = Shared.with<TypedBody, Option<Shared<Type>>>(body, fn(value: &TypedBody) -> Option<Shared<Type>> {
      let locals = TypedBody.localSlice(value)
      if at < localCount { return Option.some<Shared<Type>>(Shared.clone<Type>(&locals[at].ty)) }
      let nodes = TypedBody.nodeSlice(value)
      if let BodyNodeKind.Expression {ty, ..} = &nodes[at - localCount].kind {
        return Option.some<Shared<Type>>(Shared.clone<Type>(&ty))
      }
      return Option.none<Shared<Type>>()
    })
    let mut needs = false
    if let Option<Shared<Type>>.Some {value: ty} = move written {
      let closed = run RuntimeType.applyBindings(&ty, bindings, projections)
      let listed = Vector.asSlice<Shared<Type>>(&known)
      let mut scan = usize.ZERO
      while scan < listed.length {
        if run Type.equalsShared(&listed[scan], &closed) { break }
        scan = scan + usize.ONE
      }
      if scan < listed.length {
        needs = Vector.asSlice<bool>(&verdicts)[scan]
      } else {
        let mut visiting = Vector.make<Shared<Type>>()
        let free = run cleanupFree(&mut resolver.*, &mut owner.*, &mut dependencies.*, &closed, constraints, &mut visiting, span)
        needs = match move free {
          Result<bool, Shared<Rejection>>.Success {value} => !value
          Result<bool, Shared<Rejection>>.Failure {error} => { return Result.failResult<CleanupNeeds, Shared<Rejection>>(move error) }
        }
        run Vector.append<Shared<Type>>(&mut known, move closed)
        run Vector.append<bool>(&mut verdicts, needs)
      }
    }
    if at < localCount {
      run Vector.append<bool>(&mut localNeeds, needs)
    } else {
      run Vector.append<bool>(&mut nodeNeeds, needs)
    }
    at = at + usize.ONE
  }
  return Result.succeed<CleanupNeeds, Shared<Rejection>>(CleanupNeeds {locals: move localNeeds, nodes: move nodeNeeds})
}

// A callable retains an ordinary function application. Its hidden environment parameter is
// passed directly; there is no code pointer, adapter declaration, or separate closure key.
effect fn concreteCallableCall(resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, body: &Shared<TypedBody>, node: BodyNodeId,
  caller: &Application, callerBindings: &[Binding], projections: &[RuntimeProjection], inputs: CallableCallInputs, written: &[Shared<Type>]) -> Result<MirCallTarget, PreparationFailure>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let mut receiver = run RuntimeType.applyBindings(&inputs.receiver, callerBindings, projections)
  let mut dereferences = usize.ZERO
  while true {
    let copied = run Type.copy(&receiver)
    if let Type.Reference {referent, ..} = move copied {
      receiver = move referent
      dereferences = dereferences + usize.ONE
    } else { break }
  }
  let selected = run originalCallableCall(&mut resolver.*, &mut owner.*, &mut dependencies.*, body, node,
    caller, callerBindings, projections, move inputs, move receiver, dereferences, written)
  return match move selected {
    Result<MirCallTarget, PreparationFailure>.Success {value} => {
      let mut target = move value
      if dereferences != usize.ZERO {
        if let Option<MirStoredArguments>.Some {value: stored} = &target.stored {
          if stored.consumes { return Result.failResult<MirCallTarget, PreparationFailure>(PreparationFailure.Coverage {code: GapCode.TypedForm}) }
        }
      }
      target.receiverDereferences = dereferences
      return Result.succeed<MirCallTarget, PreparationFailure>(move target)
    }
    Result<MirCallTarget, PreparationFailure>.Failure {error} => Result.failResult<MirCallTarget, PreparationFailure>(error)
  }
}

effect fn originalCallableCall(resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, body: &Shared<TypedBody>, node: BodyNodeId,
  caller: &Application, callerBindings: &[Binding], projections: &[RuntimeProjection], inputs: CallableCallInputs,
  receiver: Shared<Type>, dereferences: usize, written: &[Shared<Type>]) -> Result<MirCallTarget, PreparationFailure>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let exact = run Type.copy(&receiver)
  match move exact {
    Type.CallableSchema {schema, captures, fieldInputs, ..} => {
      if dereferences != usize.ZERO && Shared.with<Type, CallableMode>(&sectionSchemaContract(&schema), callableInvocationMode) == CallableMode.Once {
        return Result.failResult<MirCallTarget, PreparationFailure>(PreparationFailure.Coverage {code: GapCode.TypedForm})
      }
      return run schemaCallableCall(&mut resolver.*, &mut owner.*, &mut dependencies.*, body, node,
        caller, callerBindings, projections, move inputs, move schema, move captures, move fieldInputs, written)
    }
    Type.CallableValue {application, contract, captures, fieldInputs, ..} => {
      let invocationMode = Shared.with<Type, CallableMode>(&contract, callableInvocationMode)
      // A named `effect fn` construction with no written arguments is a section with no fields.
      let named = Shared.with<Application, bool>(&application, fn(value: &Application) -> bool {
        let kind = DeclarationId.kind(Application.bodyDeclaration(value))
        return kind != OwnerKind.Anonymous && kind != OwnerKind.EffectBlock
      })
      if dereferences != usize.ZERO && invocationMode == CallableMode.Once {
        return Result.failResult<MirCallTarget, PreparationFailure>(PreparationFailure.Coverage {code: GapCode.TypedForm})
      }
      if Vector.length<CallableFieldInput>(&fieldInputs) != usize.ZERO || named {
        return run sectionCallableCall(&mut resolver.*, &mut owner.*, &mut dependencies.*, body, node, caller,
          callerBindings, projections, move inputs, invocationMode, move application, move captures, move fieldInputs, written)
      }
      return run anonymousCallableCall(&mut resolver.*, &mut owner.*, &mut dependencies.*, body, node, caller,
        callerBindings, projections, move inputs, invocationMode, move receiver, move application, written, true)
    }
    _ => { return Result.failResult<MirCallTarget, PreparationFailure>(PreparationFailure.Coverage {code: GapCode.TypedForm}) }
  }
}

// ABI admission uses the same tracked original-result evidence as source calls and definitions.
effect fn callableInvocationResult(resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, application: &Application, written: &Shared<Type>, bindings: &[Binding],
  projections: &[RuntimeProjection], span: Span) -> Result<Shared<Type>, PreparationFailure>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let mut result = run Type.applyBindings(written, bindings, true)
  if Shared.with<Type, bool>(&result, rawCallableType) {
    let declared = Vector.make<Constraint>()
    result = match move run callableResultType(&mut resolver.*, &mut owner.*, &mut dependencies.*,
      application, Vector.asSlice<Constraint>(&declared), span) {
      Result<Shared<Type>, Shared<Rejection>>.Success {value} => move value
      Result<Shared<Type>, Shared<Rejection>>.Failure {..} => { return Result.failResult<Shared<Type>, PreparationFailure>(PreparationFailure.Coverage {code: GapCode.TypedForm}) }
    }
  }
  return Result.succeed<Shared<Type>, PreparationFailure>(run RuntimeType.project(&result, projections))
}

fn callableInputParameter(input: &CallableFieldInput, at: usize) -> bool {
  return match &input.* { CallableFieldInput.Argument {parameter} => parameter == at _ => false }
}

effect fn sectionCallableCall(resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, body: &Shared<TypedBody>, node: BodyNodeId, caller: &Application,
  callerBindings: &[Binding], projections: &[RuntimeProjection], inputs: CallableCallInputs, mode: CallableMode,
  recorded: Shared<Application>, captures: Vector<Shared<Type>>, fieldInputs: Vector<CallableFieldInput>,
  written: &[Shared<Type>]) -> Result<MirCallTarget, PreparationFailure>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let recipe = run Application.copyShared(&recorded)
  let application = run Application.substitute(&recipe, caller)
  let key = match move run InstanceKey.function(run Application.copy(&application)) {
    Result<InstanceKey, CanonicalizationFailure>.Success {value: canonicalKey} => move canonicalKey
    Result<InstanceKey, CanonicalizationFailure>.Failure {error: reason} => {
      return Result.failResult<MirCallTarget, PreparationFailure>(PreparationFailure.Canonicalization {reason: reason})
    }
  }
  let location = match move run locationOfInstance(&mut resolver.*, &key) {
    Option<InstanceLocation>.Some {value} => value
    _ => { fail InvalidModulePath {} }
  }
  let signature = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, Key {
    family: Family.Signature, module: location.module, name: usize.ZERO,
    declaration: location.declaration, member: usize.ZERO, external: false,
  }, inputs.origin.span)
  let facts = match move Shared.with<Result<Answer, NoRejection>, Option<SignatureFacts>>(&signature, signatureFacts) {
    Option<SignatureFacts>.Some {value} => value
    _ => { return Result.failResult<MirCallTarget, PreparationFailure>(PreparationFailure.Coverage {code: GapCode.SignatureForm}) }
  }
  let fields = Vector.asSlice<Shared<Type>>(&captures)
  let slots = Vector.asSlice<CallableFieldInput>(&fieldInputs)
  let mut environmentField = usize.MAX
  let mut slotAt = usize.ZERO
  while slotAt < slots.length {
    let isEnvironment = match &slots[slotAt] { CallableFieldInput.Environment => true _ => false }
    if isEnvironment {
      if environmentField != usize.MAX { return Result.failResult<MirCallTarget, PreparationFailure>(PreparationFailure.Coverage {code: GapCode.WitnessOperand}) }
      environmentField = slotAt
    }
    slotAt = slotAt + usize.ONE
  }
  let mut hidden = usize.ZERO
  if environmentField != usize.MAX { hidden = usize.ONE }
  if fields.length != slots.length || facts.parameters + hidden != inputs.count + fields.length {
    return Result.failResult<MirCallTarget, PreparationFailure>(PreparationFailure.Coverage {code: GapCode.WitnessOperand})
  }
  let bindings = run Application.bindings(&application)
  let assigned = Vector.asSlice<Binding>(&bindings)
  let result = match move run callableInvocationResult(&mut resolver.*, &mut owner.*, &mut dependencies.*,
    &application, &facts.result, assigned, projections, inputs.origin.span) {
    Result<Shared<Type>, PreparationFailure>.Success {value} => move value
    Result<Shared<Type>, PreparationFailure>.Failure {error} => { return Result.failResult<MirCallTarget, PreparationFailure>(error) }
  }
  let mut wanted = run RuntimeType.applyBindings(&inputs.result, callerBindings, projections)
  // Invoking an `effect fn` value constructs its Effect; only its run calls the instance (D4). A
  // run already has the instance's result type, which may itself be an Effect, so only a
  // constructed Effect is unwrapped to its success.
  if facts.isEffect && !run Type.runtimeEqualsShared(&wanted, &result) {
    let promised = Shared.with<Type, Option<EffectChannels>>(&wanted, effectChannels)
    if let Option<EffectChannels>.Some {value: channels} = move promised { wanted = move channels.success }
  }
  if !run Type.runtimeEqualsShared(&wanted, &result) { return Result.failResult<MirCallTarget, PreparationFailure>(PreparationFailure.Coverage {code: GapCode.WitnessOperand}) }
  let mut operands = Vector.make<MirCallOperand>()
  let mut environment = Option.none<MirStoredEnvironment>()
  if environmentField != usize.MAX {
    if DeclarationId.kind(Application.bodyDeclaration(&application)) != OwnerKind.Anonymous {
      return Result.failResult<MirCallTarget, PreparationFailure>(PreparationFailure.Coverage {code: GapCode.WitnessOperand})
    }
    let actual = Shared.clone<Type>(&fields[environmentField])
    let environmentMode = Shared.with<Type, CallableMode>(&actual, callableInvocationMode)
    let mut parameter = Shared.clone<Type>(&actual)
    let mut borrow = Option.none<Access>()
    if environmentMode != CallableMode.Once {
      let access = match environmentMode { CallableMode.Mutable => Access.Mutable _ => Access.Shared }
      borrow = Option.some<Access>(access)
      parameter = run Shared.make<Type>(Type.Reference {referent: Shared.clone<Type>(&actual), access: access,
        lifetime: run Shared.make<Lifetime>(Lifetime.Local {
          declaration: run DeclarationId.copy(Application.bodyDeclaration(caller)), ordinal: inputs.origin.syntax.index,
        })})
    }
    environment = Option.some<MirStoredEnvironment>(MirStoredEnvironment {field: environmentField,
      parameter: Shared.clone<Type>(&parameter), borrow: match &borrow { Option<Access>.Some {value} => Option.some<Access>(value) _ => Option.none<Access>() }})
    run Vector.append<MirCallOperand>(&mut operands, MirCallOperand {value: move actual, parameter: move parameter, borrow: move borrow})
  }
  let mut stored = Vector.make<usize>()
  let mut at = usize.ZERO
  while at < facts.parameters {
    let raw = match move Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(&signature,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> { return signatureParameter(answer, at) }) {
      Option<Shared<Type>>.Some {value} => value
      _ => { return Result.failResult<MirCallTarget, PreparationFailure>(PreparationFailure.Coverage {code: GapCode.WitnessOperand}) }
    }
    let parameter = run RuntimeType.applyBindings(&raw, assigned, projections)
    let mut actual = Shared.clone<Type>(&parameter)
    if at < inputs.count {
      if at >= written.length { fail RevisionMismatch {} }
      actual = run RuntimeType.applyBindings(&written[at], callerBindings, projections)
    } else {
      let mut selected = usize.ZERO
      while selected < slots.length && !callableInputParameter(&slots[selected], at) { selected = selected + usize.ONE }
      if selected == slots.length { return Result.failResult<MirCallTarget, PreparationFailure>(PreparationFailure.Coverage {code: GapCode.WitnessOperand}) }
      actual = Shared.clone<Type>(&fields[selected])
      run Vector.append<usize>(&mut stored, selected)
    }
    if !run sectionOperandRuntimeCompatible(&actual, &parameter) { return Result.failResult<MirCallTarget, PreparationFailure>(PreparationFailure.Coverage {code: GapCode.WitnessOperand}) }
    run Vector.append<MirCallOperand>(&mut operands, MirCallOperand {value: move actual, parameter: move parameter, borrow: Option.none<Access>()})
    at = at + usize.ONE
  }
  return Result.succeed<MirCallTarget, PreparationFailure>(MirCallTarget {node: node, receiverDereferences: usize.ZERO, key: move key,
    application: move application, edge: Edge.Direct, operands: move operands,
    stored: Option.some<MirStoredArguments>(MirStoredArguments {environment: move environment, fields: move stored, consumes: mode == CallableMode.Once}),
    providers: Vector.make<MirProviderSource>(), dispatch: Option.none<MirProviderSource>(), witnessFailure: Option.none<Shared<Type>>()})
}

// Typed invocation already proves access and lifetime obligations. Weakening one exclusive
// reference or slice descriptor to shared access preserves its ABI and its exact referent.
effect fn sectionOperandRuntimeCompatible(actual: &Shared<Type>, parameter: &Shared<Type>) -> bool
! OutOfMemoryError ? &mut Allocator {
  if run Type.runtimeEqualsShared(actual, parameter) { return true }
  let source = run Type.copy(actual)
  let target = run Type.copy(parameter)
  return match move source {
    Type.Reference {referent, access, ..} => match move target {
      Type.Reference {referent: wanted, access: other, ..} => {
        if access != Access.Mutable || other != Access.Shared { return false }
        return run Type.runtimeEqualsShared(&referent, &wanted)
      }
      _ => false
    }
    Type.Slice {element, access, ..} => match move target {
      Type.Slice {element: wanted, access: other, ..} => {
        if access != Access.Mutable || other != Access.Shared { return false }
        return run Type.runtimeEqualsShared(&element, &wanted)
      }
      _ => false
    }
    _ => false
  }
}

effect fn anonymousCallableCall(resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, body: &Shared<TypedBody>, node: BodyNodeId, caller: &Application,
  callerBindings: &[Binding], projections: &[RuntimeProjection], inputs: CallableCallInputs, invocationMode: CallableMode, receiver: Shared<Type>,
  recorded: Shared<Application>, written: &[Shared<Type>], selectInvocation: bool) -> Result<MirCallTarget, PreparationFailure>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let abstractTarget = run Application.copyShared(&recorded)
  let closedOwner = run Application.substitute(&abstractTarget, caller)
  if !literalKind(Application.bodyDeclaration(&closedOwner)) {
    return Result.failResult<MirCallTarget, PreparationFailure>(PreparationFailure.Coverage {code: GapCode.TypedForm})
  }
  let signatureOwner = run Shared.make<DeclarationId>(run DeclarationId.copy(Application.bodyDeclaration(&closedOwner)))
  let location = match move run locationOfIdentity(&mut resolver.*, &signatureOwner) {
    Option<InstanceLocation>.Some {value} => value
    _ => { fail InvalidModulePath {} }
  }
  let targetModule = run resolvedModule(&resolver.*, location.module)
  let enclosing = run enclosingIdentity(&mut resolver.*, &targetModule, location.declaration)
  if let Option<DeclarationId>.Some {value: parentIdentity} = move enclosing {
    let parentHandle = run Shared.make<DeclarationId>(move parentIdentity)
    let selectedParent = run ordinalOfIdentity(&mut resolver.*, &targetModule, &parentHandle)
    if let Option<usize>.Some {value: parentOrdinal} = move selectedParent {
      let parentSignature = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, Key {
        family: Family.Signature, module: location.module, name: usize.ZERO, declaration: parentOrdinal,
        member: usize.ZERO, external: false,
      }, inputs.origin.span)
      if Shared.with<Result<Answer, NoRejection>, usize>(&parentSignature, signatureStaticCount) > usize.ZERO {
        return Result.failResult<MirCallTarget, PreparationFailure>(PreparationFailure.Coverage {code: GapCode.StaticResidualization})
      }
    }
  }
  let signature = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, Key {
    family: Family.Signature, module: location.module, name: usize.ZERO, declaration: location.declaration,
    member: usize.ZERO, external: false,
  }, inputs.origin.span)
  let selected = Shared.with<Result<Answer, NoRejection>, Option<SignatureFacts>>(&signature, signatureFacts)
  let target = match move selected {
    Option<SignatureFacts>.Some {value} => value
    _ => { return Result.failResult<MirCallTarget, PreparationFailure>(PreparationFailure.Coverage {code: GapCode.SignatureForm}) }
  }
  if target.parameters != inputs.count { return Result.failResult<MirCallTarget, PreparationFailure>(PreparationFailure.Coverage {code: GapCode.WitnessOperand}) }
  let count = Shared.with<Vector<Binding>, usize>(&inputs.bindings, fn(value: &Vector<Binding>) -> usize { return Vector.length<Binding>(value) })
  let mut invocationValues = Vector.make<Argument>()
  let mut selectedOrdinals = Vector.make<usize>()
  let mut at = usize.ZERO
  while selectInvocation && at < count {
    let recordedBinding = Shared.with<Vector<Binding>, Binding>(&inputs.bindings, fn(value: &Vector<Binding>) -> Binding {
      let current = Vector.asSlice<Binding>(value)
      return Binding {declaration: Shared.clone<DeclarationId>(&current[at].declaration), ordinal: current[at].ordinal, value: Argument.copy(&current[at].value)}
    })
    let freshIdentity = run DeclarationId.copyShared(&inputs.inference)
    if !Shared.with<DeclarationId, bool>(&recordedBinding.declaration, fn(value: &DeclarationId) -> bool { return DeclarationId.equals(value, &freshIdentity) }) {
      return Result.failResult<MirCallTarget, PreparationFailure>(PreparationFailure.Coverage {code: GapCode.WitnessOperand})
    }
    run Vector.append<Argument>(&mut invocationValues, run Argument.applyBindings(&recordedBinding.value, callerBindings, true))
    run Vector.append<usize>(&mut selectedOrdinals, recordedBinding.ordinal)
    at = at + usize.ONE
  }
  let mut application = move closedOwner
  if selectInvocation {
    application = match move run anonymousInvocationApplication(&application, &signature,
      Vector.asSlice<Argument>(&invocationValues), Vector.asSlice<usize>(&selectedOrdinals)) {
      Result<Application, PreparationFailure>.Success {value} => move value
      Result<Application, PreparationFailure>.Failure {error} => { return Result.failResult<MirCallTarget, PreparationFailure>(error) }
    }
  }
  let targetBindings = run Application.bindings(&application)
  let mut wanted = run RuntimeType.applyBindings(&inputs.result, callerBindings, projections)
  let result = match move run callableInvocationResult(&mut resolver.*, &mut owner.*, &mut dependencies.*,
    &application, &target.result, Vector.asSlice<Binding>(&targetBindings), projections, inputs.origin.span) {
    Result<Shared<Type>, PreparationFailure>.Success {value} => move value
    Result<Shared<Type>, PreparationFailure>.Failure {error} => { return Result.failResult<MirCallTarget, PreparationFailure>(error) }
  }
  // Invoking an anonymous `effect fn` constructs its Effect, which this call runs at once (D1).
  let invoked = Shared.with<Type, bool>(&receiver, fn(value: &Type) -> bool {
    return match &value.* { Type.CallableValue {contract, ..} => Shared.with<Type, bool>(&contract, callableType) _ => false }
  })
  if target.isEffect && invoked {
    let promised = Shared.with<Type, Option<EffectChannels>>(&wanted, effectChannels)
    if let Option<EffectChannels>.Some {value: channels} = move promised { wanted = move channels.success }
  }
  if !run Type.runtimeEqualsShared(&wanted, &result) { return Result.failResult<MirCallTarget, PreparationFailure>(PreparationFailure.Coverage {code: GapCode.WitnessOperand}) }
  let mut operands = Vector.make<MirCallOperand>()
  let mut parameter = Shared.clone<Type>(&receiver)
  let mut borrow = Option.none<Access>()
  if invocationMode != CallableMode.Once {
    let access = match invocationMode { CallableMode.Mutable => Access.Mutable _ => Access.Shared }
    borrow = Option.some<Access>(access)
    let calleeOrigin = Shared.with<TypedBody, BodyOrigin>(body, fn(value: &TypedBody) -> BodyOrigin { return TypedBody.nodeSlice(value)[inputs.callee.index].origin })
    parameter = run Shared.make<Type>(Type.Reference {referent: Shared.clone<Type>(&receiver), access: access,
      lifetime: run Shared.make<Lifetime>(Lifetime.Local {declaration: run DeclarationId.copy(Application.bodyDeclaration(caller)), ordinal: calleeOrigin.syntax.index})})
  }
  run Vector.append<MirCallOperand>(&mut operands, MirCallOperand {value: move receiver, parameter: move parameter, borrow: move borrow})
  at = usize.ZERO
  while at < inputs.count {
    if at >= written.length { fail RevisionMismatch {} }
    let actual = run RuntimeType.applyBindings(&written[at], callerBindings, projections)
    let written = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(&signature,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> { return signatureParameter(answer, at) })
    let raw = match move written { Option<Shared<Type>>.Some {value} => value _ => { fail RevisionMismatch {} } }
    let parameter = run RuntimeType.applyBindings(&raw, Vector.asSlice<Binding>(&targetBindings), projections)
    if !run Type.runtimeEqualsShared(&actual, &parameter) { return Result.failResult<MirCallTarget, PreparationFailure>(PreparationFailure.Coverage {code: GapCode.WitnessOperand}) }
    run Vector.append<MirCallOperand>(&mut operands, MirCallOperand {value: move actual, parameter: move parameter, borrow: Option.none<Access>()})
    at = at + usize.ONE
  }
  let calleeKey = match move run InstanceKey.function(run Application.copy(&application)) {
    Result<InstanceKey, CanonicalizationFailure>.Success {value: canonicalKey} => move canonicalKey
    Result<InstanceKey, CanonicalizationFailure>.Failure {error: reason} => {
      return Result.failResult<MirCallTarget, PreparationFailure>(PreparationFailure.Canonicalization {reason: reason})
    }
  }
  return Result.succeed<MirCallTarget, PreparationFailure>(MirCallTarget {node: node, receiverDereferences: usize.ZERO, key: move calleeKey,
    application: move application, edge: Edge.Direct, operands: move operands,
    stored: Option.none<MirStoredArguments>(), providers: Vector.make<MirProviderSource>(), dispatch: Option.none<MirProviderSource>(),
    witnessFailure: Option.none<Shared<Type>>()})
}

// Public invocation regions are numbered independently of the original anonymous header slots.
// The checked ordinal/value evidence maps through that same original header for both uses.
effect fn anonymousInvocationApplication(recorded: &Application, signature: &Shared<Result<Answer, NoRejection>>,
  selected: &[Argument], selectedOrdinals: &[usize]) -> Result<Application, PreparationFailure>
! OutOfMemoryError ? &mut Allocator {
  let slots = run anonymousInvocationSlots(signature, Application.bodyDeclaration(recorded))
  let ordinals = Vector.asSlice<usize>(&slots)
  if selected.length != selectedOrdinals.length { return Result.failResult<Application, PreparationFailure>(PreparationFailure.Coverage {code: GapCode.WitnessOperand}) }
  let mut invocation = Vector.make<Binding>()
  let mut at = usize.ZERO
  while at < selected.length {
    if selectedOrdinals[at] >= ordinals.length { return Result.failResult<Application, PreparationFailure>(PreparationFailure.Coverage {code: GapCode.WitnessOperand}) }
    run Vector.append<Binding>(&mut invocation, Binding {declaration: run Shared.make<DeclarationId>(run DeclarationId.copy(Application.bodyDeclaration(recorded))),
      ordinal: ordinals[selectedOrdinals[at]], value: Argument.copy(&selected[at])})
    at = at + usize.ONE
  }
  return Result.succeed<Application, PreparationFailure>(run Application.applyBindings(recorded, Vector.asSlice<Binding>(&invocation)))
}

// Whether a run expands through a prepared plan: a composition, a finite join, or a producer's
// Effect family realized as either (D4, EFF-013).
fn compositeType(value: &Type) -> bool {
  return match &value.* {
    Type.EffectComposite {..} => true
    Type.EffectJoin {..} => true
    Type.OpaqueRepresentation {..} => true
    _ => false
  }
}

// One alternative a stored join holds: the Effect to run, and its tag and payload type in the
// join's union storage.
struct StoredAlternative {
  alternative: Shared<Type>
  tag: usize
  storage: Shared<Type>
}

// The alternatives of a finite join, or of the union storage a producer's join realizes;
// absent for any other Effect. A join whose storage collapsed has no injective tag map.
effect fn storedAlternatives(ty: &Shared<Type>, projections: &[RuntimeProjection]) -> Option<Result<Vector<StoredAlternative>, PreparationFailure>>
! OutOfMemoryError ? &mut Allocator {
  let mut output = Vector.make<StoredAlternative>()
  let copied = run Type.copy(ty)
  match move copied {
    Type.EffectJoin {alternatives, ..} => {
      let listed = Vector.asSlice<Shared<Type>>(&alternatives)
      if listed.length == usize.ONE {
        run Vector.append<StoredAlternative>(&mut output, StoredAlternative {alternative: Shared.clone<Type>(&listed[usize.ZERO]),
          tag: usize.ZERO, storage: Shared.clone<Type>(&listed[usize.ZERO])})
        return Option.some<Result<Vector<StoredAlternative>, PreparationFailure>>(Result.succeed<Vector<StoredAlternative>, PreparationFailure>(move output))
      }
      let none = Vector.make<Binding>()
      let mapped = match move run UnionProjection.map(ty, Vector.asSlice<Binding>(&none), projections) {
        Option<Vector<UnionProjection.Member>>.Some {value} => value
        Option<Vector<UnionProjection.Member>>.None => {
          return Option.some<Result<Vector<StoredAlternative>, PreparationFailure>>(Result.failResult<Vector<StoredAlternative>, PreparationFailure>(PreparationFailure.Coverage {code: GapCode.UnionForm}))
        }
      }
      let members = Vector.asSlice<UnionProjection.Member>(&mapped)
      let mut at = usize.ZERO
      while at < listed.length {
        run Vector.append<StoredAlternative>(&mut output, StoredAlternative {alternative: Shared.clone<Type>(&listed[at]),
          tag: members[at].tag, storage: Shared.clone<Type>(&members[at].ty)})
        at = at + usize.ONE
      }
    }
    Type.Union {..} => {
      let canonical = match move run Type.canonicalUnionMembers(ty) {
        Option<Vector<Shared<Type>>>.Some {value} => value
        Option<Vector<Shared<Type>>>.None => {
          return Option.some<Result<Vector<StoredAlternative>, PreparationFailure>>(Result.failResult<Vector<StoredAlternative>, PreparationFailure>(PreparationFailure.Coverage {code: GapCode.UnionForm}))
        }
      }
      let listed = Vector.asSlice<Shared<Type>>(&canonical)
      let mut at = usize.ZERO
      while at < listed.length {
        run Vector.append<StoredAlternative>(&mut output, StoredAlternative {alternative: Shared.clone<Type>(&listed[at]),
          tag: at, storage: Shared.clone<Type>(&listed[at])})
        at = at + usize.ONE
      }
    }
    _ => { return Option.none<Result<Vector<StoredAlternative>, PreparationFailure>>() }
  }
  return Option.some<Result<Vector<StoredAlternative>, PreparationFailure>>(Result.succeed<Vector<StoredAlternative>, PreparationFailure>(move output))
}

// Prepares the run of one exact Effect: a construction's or block's runner, or a composition whose
// parts are prepared first. Returns the step's index; the root is the last step (D4).
effect fn compositePlan(resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, body: &Shared<TypedBody>, node: BodyNodeId, caller: &Application,
  callerBindings: &[Binding], projections: &[RuntimeProjection], identity: &Shared<DeclarationId>, ty: &Shared<Type>,
  origin: BodyOrigin, own: &[ProviderEntry], bound: &mut Vector<BoundProvider>, module: &ModuleId,
  steps: &mut Vector<MirRunPlan>) -> Result<usize, PreparationFailure>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  // A producer's Effect family runs through the storage its returns realize (EFF-013).
  if Shared.with<Type, bool>(ty, fn(value: &Type) -> bool { return match &value.* { Type.OpaqueRepresentation {..} => true _ => false } }) {
    let realized = match move run RuntimeType.resolved(ty, projections) {
      Option<Shared<Type>>.Some {value} => value
      Option<Shared<Type>>.None => { return Result.failResult<usize, PreparationFailure>(PreparationFailure.Coverage {code: GapCode.EffectForm}) }
    }
    return run compositePlan(&mut resolver.*, &mut owner.*, &mut dependencies.*, body, node, caller, callerBindings,
      projections, identity, &realized, origin, own, &mut bound.*, module, &mut steps.*)
  }
  // A finite join runs only the selected alternative's own plan (EFF-013, D1).
  let stored = run storedAlternatives(ty, projections)
  if let Option<Result<Vector<StoredAlternative>, PreparationFailure>>.Some {value: found} = move stored {
    let alternatives = match move found {
      Result<Vector<StoredAlternative>, PreparationFailure>.Success {value} => value
      Result<Vector<StoredAlternative>, PreparationFailure>.Failure {error} => { return Result.failResult<usize, PreparationFailure>(error) }
    }
    let listed = Vector.asSlice<StoredAlternative>(&alternatives)
    let mut arms = Vector.make<MirJoinArm>()
    let mut at = usize.ZERO
    while at < listed.length {
      let step = match move run compositePlan(&mut resolver.*, &mut owner.*, &mut dependencies.*, body, node, caller, callerBindings,
        projections, identity, &listed[at].alternative, origin, own, &mut bound.*, module, &mut steps.*) {
        Result<usize, PreparationFailure>.Success {value} => value
        Result<usize, PreparationFailure>.Failure {error} => { return Result.failResult<usize, PreparationFailure>(error) }
      }
      run Vector.append<MirJoinArm>(&mut arms, MirJoinArm {step: step, tag: listed[at].tag, ty: Shared.clone<Type>(&listed[at].storage)})
      at = at + usize.ONE
    }
    run Vector.append<MirRunPlan>(&mut steps.*, MirRunPlan.Join {arms: move arms, tagged: listed.length > usize.ONE})
    return Result.succeed<usize, PreparationFailure>(Vector.length<MirRunPlan>(&steps.*) - usize.ONE)
  }
  let channels = match move Shared.with<Type, Option<EffectChannels>>(ty, effectChannels) {
    Option<EffectChannels>.Some {value} => value
    Option<EffectChannels>.None => { return Result.failResult<usize, PreparationFailure>(PreparationFailure.Coverage {code: GapCode.EffectForm}) }
  }
  let shape = run Type.copy(ty)
  match move shape {
    Type.EffectComposite {operation, selector, parts, ..} => {
      let stored = Vector.asSlice<Shared<Type>>(&parts)
      // A binding serves its selected key with the stored provider for part 0's run only (D2 rule 2).
      if bindingComposition(operation) {
        let owned = operation == Composition.BindOwned
        // ponytail: dropping an owned provider on both exits of the inner run waits for a program that needs it.
        let providerDrop = match move run ownedCleanup(&mut resolver.*, &mut owner.*, &mut dependencies.*, &stored[usize.ONE], origin) {
          Result<Option<Shared<Type>>, PreparationFailure>.Success {value} => value
          Result<Option<Shared<Type>>, PreparationFailure>.Failure {error} => { return Result.failResult<usize, PreparationFailure>(error) }
        }
        if let Option<Shared<Type>>.Some {..} = &providerDrop {
          if owned { return Result.failResult<usize, PreparationFailure>(PreparationFailure.Coverage {code: GapCode.Cleanup}) }
        }
        let mut access = Access.Mutable
        if operation == Composition.BindShared { access = Access.Shared }
        let provider = match move Shared.with<Type, Option<Shared<Type>>>(&stored[usize.ONE], fn(value: &Type) -> Option<Shared<Type>> {
          if owned { return Option.none<Shared<Type>>() }
          return match &value.* { Type.Reference {referent, ..} => Option.some<Shared<Type>>(Shared.clone<Type>(&referent)) _ => Option.none<Shared<Type>>() }
        }) {
          Option<Shared<Type>>.Some {value} => value
          Option<Shared<Type>>.None => Shared.clone<Type>(&stored[usize.ONE])
        }
        let address = run Shared.make<Type>(Type.Reference {referent: Shared.clone<Type>(&provider), access: access,
          lifetime: run Shared.make<Lifetime>(Lifetime.Static)})
        let key = match move run carriedKey(&selector) {
          Option<Requirement>.Some {value} => value
          Option<Requirement>.None => { return Result.failResult<usize, PreparationFailure>(PreparationFailure.Coverage {code: GapCode.EffectForm}) }
        }
        run Vector.append<BoundProvider>(&mut bound.*, BoundProvider {key: move key, owned: owned, access: access,
          provider: move provider, address: move address})
        let inner = run compositePlan(&mut resolver.*, &mut owner.*, &mut dependencies.*, body, node, caller, callerBindings,
          projections, identity, &stored[usize.ZERO], origin, own, &mut bound.*, module, &mut steps.*)
        drop Vector.pop<BoundProvider>(&mut bound.*)
        let innerStep = match move inner {
          Result<usize, PreparationFailure>.Success {value} => value
          Result<usize, PreparationFailure>.Failure {error} => { return Result.failResult<usize, PreparationFailure>(error) }
        }
        run Vector.append<MirRunPlan>(&mut steps.*, MirRunPlan.Bind {inner: innerStep})
        return Result.succeed<usize, PreparationFailure>(Vector.length<MirRunPlan>(&steps.*) - usize.ONE)
      }
      if operation == Composition.Observe {
        // The body runs under this observer; its callback is reached through the observer record (N1).
        let callback = match move run observerTarget(&mut resolver.*, &mut owner.*, &mut dependencies.*, body, node, caller,
          callerBindings, projections, identity, &stored[usize.ONE], &stored[usize.ZERO], origin) {
          Result<MirCallTarget, PreparationFailure>.Success {value} => value
          Result<MirCallTarget, PreparationFailure>.Failure {error} => { return Result.failResult<usize, PreparationFailure>(error) }
        }
        let stateDrop = match move run ownedCleanup(&mut resolver.*, &mut owner.*, &mut dependencies.*, &stored[usize.ZERO], origin) {
          Result<Option<Shared<Type>>, PreparationFailure>.Success {value} => value
          Result<Option<Shared<Type>>, PreparationFailure>.Failure {error} => { return Result.failResult<usize, PreparationFailure>(error) }
        }
        let inner = match move run compositePlan(&mut resolver.*, &mut owner.*, &mut dependencies.*, body, node, caller,
          callerBindings, projections, identity, &stored[2], origin, own, &mut bound.*, module, &mut steps.*) {
          Result<usize, PreparationFailure>.Success {value} => value
          Result<usize, PreparationFailure>.Failure {error} => { return Result.failResult<usize, PreparationFailure>(error) }
        }
        let address = run Shared.make<Type>(Type.Reference {referent: Shared.clone<Type>(&stored[usize.ZERO]), access: Access.Mutable,
          lifetime: run Shared.make<Lifetime>(Lifetime.Static)})
        run Vector.append<MirRunPlan>(&mut steps.*, MirRunPlan.Observe {inner: inner, state: move address, stateDrop: move stateDrop,
          callback: move callback.key})
        return Result.succeed<usize, PreparationFailure>(Vector.length<MirRunPlan>(&steps.*) - usize.ONE)
      }
      if operation == Composition.UseRelease {
        // Both callables receive a fresh exclusive loan of the owned resource (D4).
        let lent = run Shared.make<Type>(Type.Reference {referent: Shared.clone<Type>(&stored[usize.ZERO]), access: Access.Mutable,
          lifetime: run Shared.make<Lifetime>(Lifetime.Local {
            declaration: run DeclarationId.copy(Application.bodyDeclaration(caller)), ordinal: origin.syntax.index})})
        let use = match move run invokedTarget(&mut resolver.*, &mut owner.*, &mut dependencies.*, body, node, caller, callerBindings,
          projections, identity, &stored[usize.ONE], &lent, origin) {
          Result<InvokedTarget, PreparationFailure>.Success {value} => value
          Result<InvokedTarget, PreparationFailure>.Failure {error} => { return Result.failResult<usize, PreparationFailure>(error) }
        }
        let release = match move run invokedTarget(&mut resolver.*, &mut owner.*, &mut dependencies.*, body, node, caller,
          callerBindings, projections, identity, &stored[2], &lent, origin) {
          Result<InvokedTarget, PreparationFailure>.Success {value} => value
          Result<InvokedTarget, PreparationFailure>.Failure {error} => { return Result.failResult<usize, PreparationFailure>(error) }
        }
        // Both callables are invoked on every path; a loaned invocation would leave an owning one undropped.
        if (use.mode != CallableMode.Once && run ownsCleanup(&mut resolver.*, &mut owner.*, &mut dependencies.*, &stored[usize.ONE], origin))
          || (release.mode != CallableMode.Once && run ownsCleanup(&mut resolver.*, &mut owner.*, &mut dependencies.*, &stored[2], origin)) {
          return Result.failResult<usize, PreparationFailure>(PreparationFailure.Coverage {code: GapCode.Cleanup})
        }
        let resourceDrop = match move run ownedCleanup(&mut resolver.*, &mut owner.*, &mut dependencies.*, &stored[usize.ZERO], origin) {
          Result<Option<Shared<Type>>, PreparationFailure>.Success {value} => value
          Result<Option<Shared<Type>>, PreparationFailure>.Failure {error} => { return Result.failResult<usize, PreparationFailure>(error) }
        }
        let InvokedTarget {target: useCall, channels: useChannels, ..} = move use
        let InvokedTarget {target: releaseCall, channels: releaseChannels, ..} = move release
        let useServed = match move run provideCall(&mut resolver.*, &mut owner.*, &mut dependencies.*, move useCall, own,
          Vector.asSlice<BoundProvider>(&bound.*), projections, module, origin.span) {
          Result<MirCallTarget, PreparationFailure>.Success {value} => value
          Result<MirCallTarget, PreparationFailure>.Failure {error} => { return Result.failResult<usize, PreparationFailure>(error) }
        }
        let releaseServed = match move run provideCall(&mut resolver.*, &mut owner.*, &mut dependencies.*, move releaseCall, own,
          Vector.asSlice<BoundProvider>(&bound.*), projections, module, origin.span) {
          Result<MirCallTarget, PreparationFailure>.Success {value} => value
          Result<MirCallTarget, PreparationFailure>.Failure {error} => { return Result.failResult<usize, PreparationFailure>(error) }
        }
        run Vector.append<MirRunPlan>(&mut steps.*, MirRunPlan.UseRelease {lent: move lent, use: move useServed,
          useSuccess: move useChannels.success, useFailure: move useChannels.failure, release: move releaseServed,
          releaseSuccess: move releaseChannels.success, releaseFailure: move releaseChannels.failure, resourceDrop: move resourceDrop})
        return Result.succeed<usize, PreparationFailure>(Vector.length<MirRunPlan>(&steps.*) - usize.ONE)
      }
      // A suspension runs its deferred child at an explicit boundary (SUSP-001).
      if operation == Composition.Suspend {
        let deferred = match move run compositePlan(&mut resolver.*, &mut owner.*, &mut dependencies.*, body, node, caller,
          callerBindings, projections, identity, &stored[usize.ZERO], origin, own, &mut bound.*, module, &mut steps.*) {
          Result<usize, PreparationFailure>.Success {value} => value
          Result<usize, PreparationFailure>.Failure {error} => { return Result.failResult<usize, PreparationFailure>(error) }
        }
        run Vector.append<MirRunPlan>(&mut steps.*, MirRunPlan.Suspend {inner: deferred})
        return Result.succeed<usize, PreparationFailure>(Vector.length<MirRunPlan>(&steps.*) - usize.ONE)
      }
      if operation != Composition.CatchFailure && operation != Composition.Finalize && operation != Composition.FinalizeNonParking {
        return Result.failResult<usize, PreparationFailure>(PreparationFailure.Coverage {code: GapCode.EffectForm})
      }
      let inner = match move run compositePlan(&mut resolver.*, &mut owner.*, &mut dependencies.*, body, node, caller, callerBindings,
        projections, identity, &stored[usize.ZERO], origin, own, &mut bound.*, module, &mut steps.*) {
        Result<usize, PreparationFailure>.Success {value} => value
        Result<usize, PreparationFailure>.Failure {error} => { return Result.failResult<usize, PreparationFailure>(error) }
      }
      let protected = match move Shared.with<Type, Option<EffectChannels>>(&stored[usize.ZERO], effectChannels) {
        Option<EffectChannels>.Some {value} => value
        Option<EffectChannels>.None => { return Result.failResult<usize, PreparationFailure>(PreparationFailure.Coverage {code: GapCode.EffectForm}) }
      }
      if operation != Composition.CatchFailure {
        // The finalizer is itself an exact Effect; NonParking is a compile-time bound only (D4).
        let finalizer = match move run compositePlan(&mut resolver.*, &mut owner.*, &mut dependencies.*, body, node, caller,
          callerBindings, projections, identity, &stored[usize.ONE], origin, own, &mut bound.*, module, &mut steps.*) {
          Result<usize, PreparationFailure>.Success {value} => value
          Result<usize, PreparationFailure>.Failure {error} => { return Result.failResult<usize, PreparationFailure>(error) }
        }
        let cleanup = match move Shared.with<Type, Option<EffectChannels>>(&stored[usize.ONE], effectChannels) {
          Option<EffectChannels>.Some {value} => value
          Option<EffectChannels>.None => { return Result.failResult<usize, PreparationFailure>(PreparationFailure.Coverage {code: GapCode.EffectForm}) }
        }
        run Vector.append<MirRunPlan>(&mut steps.*, MirRunPlan.Finalize {inner: inner, innerFailure: move protected.failure,
          finalizer: finalizer, finalizerSuccess: move cleanup.success})
        return Result.succeed<usize, PreparationFailure>(Vector.length<MirRunPlan>(&steps.*) - usize.ONE)
      }
      let handler = match move run invokedTarget(&mut resolver.*, &mut owner.*, &mut dependencies.*, body, node, caller,
        callerBindings, projections, identity, &stored[usize.ONE], &selector, origin) {
        Result<InvokedTarget, PreparationFailure>.Success {value} => value
        Result<InvokedTarget, PreparationFailure>.Failure {error} => { return Result.failResult<usize, PreparationFailure>(error) }
      }
      let InvokedTarget {target: handlerCall, channels: handlerChannels, mode: handlerMode} = move handler
      let handlerServed = match move run provideCall(&mut resolver.*, &mut owner.*, &mut dependencies.*, move handlerCall, own,
        Vector.asSlice<BoundProvider>(&bound.*), projections, module, origin.span) {
        Result<MirCallTarget, PreparationFailure>.Success {value} => value
        Result<MirCallTarget, PreparationFailure>.Failure {error} => { return Result.failResult<usize, PreparationFailure>(error) }
      }
      // Only the selected path consumes the handler; every other exit drops an owning one.
      let handlerDrop = match move run ownedCleanup(&mut resolver.*, &mut owner.*, &mut dependencies.*, &stored[usize.ONE], origin) {
        Result<Option<Shared<Type>>, PreparationFailure>.Success {value} => value
        Result<Option<Shared<Type>>, PreparationFailure>.Failure {error} => { return Result.failResult<usize, PreparationFailure>(error) }
      }
      if let Option<Shared<Type>>.Some {..} = &handlerDrop {
        if handlerMode != CallableMode.Once { return Result.failResult<usize, PreparationFailure>(PreparationFailure.Coverage {code: GapCode.Cleanup}) }
      }
      run Vector.append<MirRunPlan>(&mut steps.*, MirRunPlan.Catch {selector: move selector, inner: inner,
        innerFailure: move protected.failure, handler: move handlerServed, handlerSuccess: move handlerChannels.success,
        handlerFailure: move handlerChannels.failure, handlerDrop: move handlerDrop})
    }
    Type.CallableValue {contract, ..} => {
      let mode = Shared.with<Type, CallableMode>(&contract, callableInvocationMode)
      // A stored part runs once per exit; a loaned run never consumes, so nothing would drop it.
      if mode != CallableMode.Once {
        if run ownsCleanup(&mut resolver.*, &mut owner.*, &mut dependencies.*, ty, origin) { return Result.failResult<usize, PreparationFailure>(PreparationFailure.Coverage {code: GapCode.Cleanup}) }
      }
      let inputs = CallableCallInputs {receiver: Shared.clone<Type>(ty), inference: Shared.clone<DeclarationId>(identity),
        bindings: run Shared.make<Vector<Binding>>(Vector.make<Binding>()), mode: mode, callee: node,
        result: Shared.clone<Type>(&channels.success), count: usize.ZERO, origin: origin}
      let written = Vector.make<Shared<Type>>()
      let constructed = match move run concreteCallableCall(&mut resolver.*, &mut owner.*, &mut dependencies.*, body, node, caller,
        callerBindings, projections, move inputs, Vector.asSlice<Shared<Type>>(&written)) {
        Result<MirCallTarget, PreparationFailure>.Success {value} => value
        Result<MirCallTarget, PreparationFailure>.Failure {error} => { return Result.failResult<usize, PreparationFailure>(error) }
      }
      let target = match move run provideCall(&mut resolver.*, &mut owner.*, &mut dependencies.*, move constructed, own,
        Vector.asSlice<BoundProvider>(&bound.*), projections, module, origin.span) {
        Result<MirCallTarget, PreparationFailure>.Success {value} => value
        Result<MirCallTarget, PreparationFailure>.Failure {error} => { return Result.failResult<usize, PreparationFailure>(error) }
      }
      run Vector.append<MirRunPlan>(&mut steps.*, MirRunPlan.Runner {target: move target, success: move channels.success,
        failure: move channels.failure})
    }
    _ => { return Result.failResult<usize, PreparationFailure>(PreparationFailure.Coverage {code: GapCode.EffectForm}) }
  }
  return Result.succeed<usize, PreparationFailure>(Vector.length<MirRunPlan>(&steps.*) - usize.ONE)
}

// The target size, alignment and stride of one closed runtime type, demanded through the layout
// query.
effect fn measuredLayout(resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, ty: &Shared<Type>, span: Span) -> Option<LayoutMetrics>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let application = run internLayoutType(&mut resolver.*, ty)
  let layout = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, Key {family: Family.Layout, module: usize.ZERO,
    name: application, declaration: usize.ZERO, member: usize.ZERO, external: false}, span)
  let selected = Shared.with<Result<Answer, NoRejection>, Option<usize>>(&layout, layoutIndex)
  if let Option<usize>.Some {value} = move selected {
    let layouts = Vector.asSlice<Shared<BackendLayout>>(&resolver.layoutValues)
    return Option.some<LayoutMetrics>(Shared.with<BackendLayout, LayoutMetrics>(&layouts[value], BackendLayout.metrics))
  }
  return Option.none<LayoutMetrics>()
}

// One closed written type argument of a storage call.
effect fn storageInstanceType(body: &Shared<TypedBody>, node: BodyNodeId, at: usize, callerBindings: &[Binding],
  projections: &[RuntimeProjection]) -> Shared<Type> ! RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let written = TypedBody.storageTypeArgument(body, node, at)
  return match move written {
    Option<Shared<Type>>.Some {value} => run RuntimeType.applyBindings(&value, callerBindings, projections)
    Option<Shared<Type>>.None => { fail RevisionMismatch {} }
  }
}

// A schema's contract is an original bound blueprint, not its selected invocation result.
// Select from the actual operands and caller premises before checking the storage promise.
effect fn storageInvocationResult(resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, body: &Shared<TypedBody>, caller: &Application,
  callerBindings: &[Binding], projections: &[RuntimeProjection], receiver: &Shared<Type>, contract: &Shared<Type>,
  written: &[Shared<Type>], span: Span) -> Result<Shared<Type>, PreparationFailure>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let mut callable = Shared.clone<Type>(receiver)
  while true {
    let copied = run Type.copy(&callable)
    if let Type.Reference {referent, ..} = move copied { callable = move referent } else { break }
  }
  let schema = Shared.with<Type, Option<Shared<SectionSchema>>>(&callable, sectionSchemaOf)
  if let Option<Shared<SectionSchema>>.Some {value: recipe} = move schema {
    let module = DeclarationId.moduleId(Application.bodyDeclaration(caller))
    let mut premises = match move run closedApplicationBounds(&mut resolver.*, &mut owner.*, &mut dependencies.*,
      caller, callerBindings, span) {
      Option<Vector<Constraint>>.Some {value} => move value
      _ => { return Result.failResult<Shared<Type>, PreparationFailure>(PreparationFailure.Coverage {code: GapCode.TypedForm}) }
    }
    run retainedCallRelations(body, span, callerBindings, &mut premises)
    let selected = match move run schemaCallableApplication(&mut resolver.*, &mut owner.*, &mut dependencies.*,
      module, callerBindings, Vector.asSlice<Constraint>(&premises), &recipe, written, span) {
      Result<Application, PreparationFailure>.Success {value} => move value
      Result<Application, PreparationFailure>.Failure {error} => { return Result.failResult<Shared<Type>, PreparationFailure>(error) }
    }
    let application = run Application.substitute(&selected, caller)
    let signature = run sectionOriginalSignature(&mut resolver.*, &mut owner.*, &mut dependencies.*,
      Application.bodyDeclaration(&application), span)
    let facts = match move Shared.with<Result<Answer, NoRejection>, Option<SignatureFacts>>(&signature, signatureFacts) {
      Option<SignatureFacts>.Some {value} => move value
      _ => { return Result.failResult<Shared<Type>, PreparationFailure>(PreparationFailure.Coverage {code: GapCode.SignatureForm}) }
    }
    // An effect fn invocation constructs an Effect rather than returning its runner's success.
    // Storage does not yet prepare that construction; do not admit the success as its result.
    if facts.isEffect { return Result.failResult<Shared<Type>, PreparationFailure>(PreparationFailure.Coverage {code: GapCode.TypedForm}) }
    let bindings = run Application.bindings(&application)
    return run callableInvocationResult(&mut resolver.*, &mut owner.*, &mut dependencies.*, &application,
      &facts.result, Vector.asSlice<Binding>(&bindings), projections, span)
  }
  let result = match move Shared.with<Type, Option<Shared<Type>>>(contract, callableResult) {
    Option<Shared<Type>>.Some {value} => move value
    _ => { return Result.failResult<Shared<Type>, PreparationFailure>(PreparationFailure.Coverage {code: GapCode.TypedForm}) }
  }
  return Result.succeed<Shared<Type>, PreparationFailure>(run RuntimeType.applyBindings(&result, callerBindings, projections))
}

// The prepared invocation and actual result of one storage callback, independently checked
// against the primitive's promise. Only its conflict policy may diverge instead of producing it.
effect fn storageCallableTarget(resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, body: &Shared<TypedBody>, node: BodyNodeId, argument: BodyNodeId, caller: &Application,
  callerBindings: &[Binding], projections: &[RuntimeProjection], identity: &Shared<DeclarationId>, own: &[ProviderEntry],
  module: &ModuleId, written: Vector<Shared<Type>>, promised: &Shared<Type>, divergent: bool,
  targets: &mut Vector<MirCallTarget>, results: &mut Vector<Shared<Type>>)
-> Option<PreparationFailure> ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let callable = Shared.with<TypedBody, Option<Shared<Type>>>(body, fn(value: &TypedBody) -> Option<Shared<Type>> {
    return nodeTypeAt(value, argument.index)
  })
  let receiver = match move callable {
    Option<Shared<Type>>.Some {value} => value
    Option<Shared<Type>>.None => { return Option.some<PreparationFailure>(PreparationFailure.Coverage {code: GapCode.TypedForm}) }
  }
  let origin = Shared.with<TypedBody, BodyOrigin>(body, fn(value: &TypedBody) -> BodyOrigin { return TypedBody.nodeSlice(value)[argument.index].origin })
  let closed = run RuntimeType.applyBindings(&receiver, callerBindings, projections)
  let none = Vector.make<Constraint>()
  let contract = match move run valueCallableContract(&closed, Vector.asSlice<Constraint>(&none)) {
    Option<Shared<Type>>.Some {value} => value
    Option<Shared<Type>>.None => { return Option.some<PreparationFailure>(PreparationFailure.Coverage {code: GapCode.TypedForm}) }
  }
  let result = match move run storageInvocationResult(&mut resolver.*, &mut owner.*, &mut dependencies.*, body, caller,
    callerBindings, projections, &closed, &contract, Vector.asSlice<Shared<Type>>(&written), origin.span) {
    Result<Shared<Type>, PreparationFailure>.Success {value} => move value
    Result<Shared<Type>, PreparationFailure>.Failure {error} => { return Option.some<PreparationFailure>(error) }
  }
  let exact = run Type.runtimeEqualsShared(&result, promised)
  let diverges = divergent && Shared.with<Type, bool>(&result, neverType)
  if !exact && !diverges { return Option.some<PreparationFailure>(PreparationFailure.Coverage {code: GapCode.WitnessOperand}) }
  let inputs = CallableCallInputs {receiver: move receiver, inference: Shared.clone<DeclarationId>(identity),
    bindings: run Shared.make<Vector<Binding>>(Vector.make<Binding>()), mode: Shared.with<Type, CallableMode>(&contract, callableInvocationMode),
    callee: argument, result: Shared.clone<Type>(&result), count: Vector.length<Shared<Type>>(&written), origin: origin}
  let constructed = match move run concreteCallableCall(&mut resolver.*, &mut owner.*, &mut dependencies.*, body, node, caller,
    callerBindings, projections, move inputs, Vector.asSlice<Shared<Type>>(&written)) {
    Result<MirCallTarget, PreparationFailure>.Success {value} => value
    Result<MirCallTarget, PreparationFailure>.Failure {error} => { return Option.some<PreparationFailure>(error) }
  }
  let unbound = Vector.make<BoundProvider>()
  let target = match move run provideCall(&mut resolver.*, &mut owner.*, &mut dependencies.*, move constructed, own,
    Vector.asSlice<BoundProvider>(&unbound), projections, module, origin.span) {
    Result<MirCallTarget, PreparationFailure>.Success {value} => value
    Result<MirCallTarget, PreparationFailure>.Failure {error} => { return Option.some<PreparationFailure>(error) }
  }
  run Vector.append<MirCallTarget>(&mut targets.*, move target)
  run Vector.append<Shared<Type>>(&mut results.*, move result)
  return Option.none<PreparationFailure>()
}

// What one storage primitive's expansion needs from this instance: the measured layout of its
// element or control block, the sealed C allocator declarations, the element's cleanup verdict
// and `sharedWithMut`'s prepared invocations.
effect fn storagePlan(resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, body: &Shared<TypedBody>, node: BodyNodeId, operation: StorageOperation,
  caller: &Application, callerBindings: &[Binding], projections: &[RuntimeProjection], identity: &Shared<DeclarationId>,
  own: &[ProviderEntry], module: &ModuleId, span: Span) -> Result<MirStoragePlan, PreparationFailure>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let anchor = run SealedCore.identity(SealedKind.Allocation)
  let mut externs = Vector.make<Shared<DeclarationId>>()
  run Vector.append<Shared<DeclarationId>>(&mut externs, run SealedCore.cFunction(&anchor, SealedFunction.Malloc))
  run Vector.append<Shared<DeclarationId>>(&mut externs, run SealedCore.cFunction(&anchor, SealedFunction.Free))
  run Vector.append<Shared<DeclarationId>>(&mut externs, run SealedCore.cFunction(&anchor, SealedFunction.Memmove))
  run Vector.append<Shared<DeclarationId>>(&mut externs, run SealedCore.cFunction(&anchor, SealedFunction.Memset))
  let mut element = run Shared.make<Type>(Type.Unit)
  if StorageOperation.typeArity(operation) > usize.ZERO || operation == StorageOperation.Replace {
    element = run storageInstanceType(body, node, usize.ZERO, callerBindings, projections)
  }
  let mut size = usize.ZERO
  let mut alignment = usize.ONE
  if StorageOperation.measures(operation) {
    let mut measured = Shared.clone<Type>(&element)
    if operation == StorageOperation.SharedLayout || operation == StorageOperation.SharedFromAllocation {
      measured = run SealedCore.applied(SealedKind.SharedBlock, &element)
    }
    // An execution package is measured whole: its header, body, readiness endpoint and allocation.
    if operation == StorageOperation.ExecutionLayout || operation == StorageOperation.ExecutionFromAllocation {
      let mut packaged = Vector.make<Shared<Type>>()
      let mut argument = usize.ZERO
      while argument < StorageOperation.typeArity(operation) {
        run Vector.append<Shared<Type>>(&mut packaged, run storageInstanceType(body, node, argument, callerBindings, projections))
        argument = argument + usize.ONE
      }
      measured = run SealedCore.packageBeside(&anchor, Vector.asSlice<Shared<Type>>(&packaged))
    }
    let facts = match move run measuredLayout(&mut resolver.*, &mut owner.*, &mut dependencies.*, &measured, span) {
      Option<LayoutMetrics>.Some {value} => value
      Option<LayoutMetrics>.None => { return Result.failResult<MirStoragePlan, PreparationFailure>(PreparationFailure.Coverage {code: GapCode.ScalarLayout}) }
    }
    size = facts.size
    alignment = facts.alignment
    // Raw-buffer storage holds consecutive elements one stride apart.
    if operation == StorageOperation.RawBufferFrom || operation == StorageOperation.RawBufferCopy {
      size = match move LayoutMetrics.stride(&facts) {
        Option<usize>.Some {value} => value
        Option<usize>.None => { return Result.failResult<MirStoragePlan, PreparationFailure>(PreparationFailure.Coverage {code: GapCode.ScalarLayout}) }
      }
    }
  }
  let mut cleanup = false
  if operation == StorageOperation.SlotDrop {
    cleanup = match move run glueNeeds(&mut resolver.*, &mut owner.*, &mut dependencies.*, &element) {
      Result<bool, PreparationFailure>.Success {value} => value
      Result<bool, PreparationFailure>.Failure {error} => { return Result.failResult<MirStoragePlan, PreparationFailure>(move error) }
    }
  }
  let mut targets = Vector.make<MirCallTarget>()
  let mut results = Vector.make<Shared<Type>>()
  if operation == StorageOperation.SharedWithMut {
    let promised = run storageInstanceType(body, node, usize.ONE, callerBindings, projections)
    let useArgument = match move TypedBody.storageArgument(body, node, usize.ONE) {
      Option<BodyNodeId>.Some {value} => value
      Option<BodyNodeId>.None => { fail RevisionMismatch {} }
    }
    let conflictArgument = match move TypedBody.storageArgument(body, node, 2) {
      Option<BodyNodeId>.Some {value} => value
      Option<BodyNodeId>.None => { fail RevisionMismatch {} }
    }
    // The value is lent exclusively for the invocation alone.
    let site = Shared.with<TypedBody, BodyOrigin>(body, fn(value: &TypedBody) -> BodyOrigin { return TypedBody.nodeSlice(value)[node.index].origin })
    let mut lent = Vector.make<Shared<Type>>()
    run Vector.append<Shared<Type>>(&mut lent, run Shared.make<Type>(Type.Reference {referent: Shared.clone<Type>(&element),
      access: Access.Mutable, lifetime: run Shared.make<Lifetime>(Lifetime.Local {
        declaration: run DeclarationId.copy(Application.bodyDeclaration(caller)), ordinal: site.syntax.index})}))
    let selected = run storageCallableTarget(&mut resolver.*, &mut owner.*, &mut dependencies.*, body, node, useArgument, caller,
      callerBindings, projections, identity, own, module, move lent, &promised, false, &mut targets, &mut results)
    if let Option<PreparationFailure>.Some {value} = move selected { return Result.failResult<MirStoragePlan, PreparationFailure>(move value) }
    let policy = run storageCallableTarget(&mut resolver.*, &mut owner.*, &mut dependencies.*, body, node, conflictArgument, caller,
      callerBindings, projections, identity, own, module, Vector.make<Shared<Type>>(), &promised, true, &mut targets, &mut results)
    if let Option<PreparationFailure>.Some {value} = move policy { return Result.failResult<MirStoragePlan, PreparationFailure>(move value) }
  }
  return Result.succeed<MirStoragePlan, PreparationFailure>(MirStoragePlan {node: node, size: size, alignment: alignment, externs: move externs,
    cleanup: cleanup, targets: move targets, results: move results})
}

// A stored callable invoked with one argument, and the channels of the Effect its invocation runs.
struct InvokedTarget {
  target: MirCallTarget
  channels: EffectChannels
  mode: CallableMode
}

// The observer callback's direct call `callback(&mut state, event, first, second, identity,
// origin) -> usize` (failure observer note N1). Only a direct function is supported: an
// observed instance passes exactly the written operands.
effect fn observerTarget(resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, body: &Shared<TypedBody>, node: BodyNodeId, caller: &Application,
  callerBindings: &[Binding], projections: &[RuntimeProjection], identity: &Shared<DeclarationId>, callable: &Shared<Type>,
  state: &Shared<Type>, origin: BodyOrigin) -> Result<MirCallTarget, PreparationFailure>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let none = Vector.make<Constraint>()
  let contract = match move run valueCallableContract(callable, Vector.asSlice<Constraint>(&none)) {
    Option<Shared<Type>>.Some {value} => value
    Option<Shared<Type>>.None => { return Result.failResult<MirCallTarget, PreparationFailure>(PreparationFailure.Coverage {code: GapCode.ObserverCallback}) }
  }
  let word = run Shared.make<Type>(Type.Primitive {name: run Bytes.copy(b"usize")})
  let text = run Shared.make<Type>(Type.String {lifetime: run Shared.make<Lifetime>(Lifetime.Static)})
  let mut written = Vector.make<Shared<Type>>()
  run Vector.append<Shared<Type>>(&mut written, run Shared.make<Type>(Type.Reference {referent: Shared.clone<Type>(state),
    access: Access.Mutable, lifetime: run Shared.make<Lifetime>(Lifetime.Static)}))
  run Vector.append<Shared<Type>>(&mut written, run Shared.make<Type>(Type.Primitive {name: run Bytes.copy(b"u8")}))
  run Vector.append<Shared<Type>>(&mut written, Shared.clone<Type>(&word))
  run Vector.append<Shared<Type>>(&mut written, Shared.clone<Type>(&word))
  run Vector.append<Shared<Type>>(&mut written, Shared.clone<Type>(&text))
  run Vector.append<Shared<Type>>(&mut written, move text)
  let inputs = CallableCallInputs {receiver: Shared.clone<Type>(callable), inference: Shared.clone<DeclarationId>(identity),
    bindings: run Shared.make<Vector<Binding>>(Vector.make<Binding>()), mode: Shared.with<Type, CallableMode>(&contract, callableInvocationMode),
    callee: node, result: move word, count: 6, origin: origin}
  let target = match move run concreteCallableCall(&mut resolver.*, &mut owner.*, &mut dependencies.*, body, node, caller,
    callerBindings, projections, move inputs, Vector.asSlice<Shared<Type>>(&written)) {
    Result<MirCallTarget, PreparationFailure>.Success {value} => value
    Result<MirCallTarget, PreparationFailure>.Failure {error} => { return Result.failResult<MirCallTarget, PreparationFailure>(error) }
  }
  let direct = match &target.stored {
    Option<MirStoredArguments>.Some {value: stored} => match &stored.environment {
      Option<MirStoredEnvironment>.None => Vector.length<usize>(&stored.fields) == usize.ZERO
      _ => false
    }
    Option<MirStoredArguments>.None => false
  }
  if !direct || target.receiverDereferences != usize.ZERO { return Result.failResult<MirCallTarget, PreparationFailure>(PreparationFailure.Coverage {code: GapCode.ObserverCallback}) }
  return Result.succeed<MirCallTarget, PreparationFailure>(move target)
}

effect fn invokedTarget(resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, body: &Shared<TypedBody>, node: BodyNodeId, caller: &Application,
  callerBindings: &[Binding], projections: &[RuntimeProjection], identity: &Shared<DeclarationId>, callable: &Shared<Type>,
  argument: &Shared<Type>, origin: BodyOrigin) -> Result<InvokedTarget, PreparationFailure>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let none = Vector.make<Constraint>()
  let contract = match move run valueCallableContract(callable, Vector.asSlice<Constraint>(&none)) {
    Option<Shared<Type>>.Some {value} => value
    Option<Shared<Type>>.None => { return Result.failResult<InvokedTarget, PreparationFailure>(PreparationFailure.Coverage {code: GapCode.EffectForm}) }
  }
  let invoked = match move Shared.with<Type, Option<Shared<Type>>>(&contract, callableResult) {
    Option<Shared<Type>>.Some {value} => value
    Option<Shared<Type>>.None => { return Result.failResult<InvokedTarget, PreparationFailure>(PreparationFailure.Coverage {code: GapCode.EffectForm}) }
  }
  let channels = match move Shared.with<Type, Option<EffectChannels>>(&invoked, effectChannels) {
    Option<EffectChannels>.Some {value} => value
    Option<EffectChannels>.None => { return Result.failResult<InvokedTarget, PreparationFailure>(PreparationFailure.Coverage {code: GapCode.EffectForm}) }
  }
  let mode = Shared.with<Type, CallableMode>(&contract, callableInvocationMode)
  let mut written = Vector.make<Shared<Type>>()
  run Vector.append<Shared<Type>>(&mut written, Shared.clone<Type>(argument))
  let inputs = CallableCallInputs {receiver: Shared.clone<Type>(callable), inference: Shared.clone<DeclarationId>(identity),
    bindings: run Shared.make<Vector<Binding>>(Vector.make<Binding>()), mode: mode, callee: node,
    result: Shared.clone<Type>(&channels.success), count: usize.ONE, origin: origin}
  return match move run concreteCallableCall(&mut resolver.*, &mut owner.*, &mut dependencies.*, body, node, caller,
    callerBindings, projections, move inputs, Vector.asSlice<Shared<Type>>(&written)) {
    Result<MirCallTarget, PreparationFailure>.Success {value} => Result.succeed<InvokedTarget, PreparationFailure>(InvokedTarget {target: move value,
      channels: move channels, mode: mode})
    Result<MirCallTarget, PreparationFailure>.Failure {error} => Result.failResult<InvokedTarget, PreparationFailure>(error)
  }
}

// The prepared invocations of a checked scalar operation's carriers: `present` with the produced
// scalar and `absent` with nothing, both producing the call's result. A carrier that owns cleanup
// would need the unselected one dropped, which is not lowered yet.
effect fn carrierPlan(resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, body: &Shared<TypedBody>, node: BodyNodeId, caller: &Application,
  callerBindings: &[Binding], projections: &[RuntimeProjection], identity: &Shared<DeclarationId>,
  operation: ScalarOperation, result: &Shared<Type>, own: &[ProviderEntry], module: &ModuleId) -> Result<MirCarrierPlan, PreparationFailure>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let start = ScalarOperation.arity(operation)
  let produced = run primitiveType(ScalarOperation.scalarSpelling(ScalarOperation.result(operation)))
  let mut targets = Vector.make<MirCallTarget>()
  let mut at = usize.ZERO
  while at < 2 {
    let argument = match move TypedBody.callArgument(body, node, start + at) {
      Option<CallArgument>.Some {value} => move value
      Option<CallArgument>.None => { fail RevisionMismatch {} }
    }
    let closed = run Type.applyBindings(&argument.ty, callerBindings, true)
    if run ownsCleanup(&mut resolver.*, &mut owner.*, &mut dependencies.*, &closed, argument.origin) {
      return Result.failResult<MirCarrierPlan, PreparationFailure>(PreparationFailure.Coverage {code: GapCode.Cleanup})
    }
    let none = Vector.make<Constraint>()
    let contract = match move run valueCallableContract(&argument.ty, Vector.asSlice<Constraint>(&none)) {
      Option<Shared<Type>>.Some {value} => value
      Option<Shared<Type>>.None => { return Result.failResult<MirCarrierPlan, PreparationFailure>(PreparationFailure.Coverage {code: GapCode.TypedForm}) }
    }
    let mut written = Vector.make<Shared<Type>>()
    if at == usize.ZERO { run Vector.append<Shared<Type>>(&mut written, Shared.clone<Type>(&produced)) }
    let inputs = CallableCallInputs {receiver: Shared.clone<Type>(&argument.ty), inference: Shared.clone<DeclarationId>(identity),
      bindings: run Shared.make<Vector<Binding>>(Vector.make<Binding>()), mode: Shared.with<Type, CallableMode>(&contract, callableInvocationMode),
      callee: node, result: Shared.clone<Type>(result), count: Vector.length<Shared<Type>>(&written), origin: argument.origin}
    let target = match move run concreteCallableCall(&mut resolver.*, &mut owner.*, &mut dependencies.*, body, node, caller,
      callerBindings, projections, move inputs, Vector.asSlice<Shared<Type>>(&written)) {
      Result<MirCallTarget, PreparationFailure>.Success {value} => value
      Result<MirCallTarget, PreparationFailure>.Failure {error} => { return Result.failResult<MirCarrierPlan, PreparationFailure>(error) }
    }
    let unbound = Vector.make<BoundProvider>()
    let served = match move run provideCall(&mut resolver.*, &mut owner.*, &mut dependencies.*, move target, own,
      Vector.asSlice<BoundProvider>(&unbound), projections, module, argument.origin.span) {
      Result<MirCallTarget, PreparationFailure>.Success {value} => value
      Result<MirCallTarget, PreparationFailure>.Failure {error} => { return Result.failResult<MirCarrierPlan, PreparationFailure>(error) }
    }
    run Vector.append<MirCallTarget>(&mut targets, move served)
    at = at + usize.ONE
  }
  let present = Vector.remove<MirCallTarget>(&mut targets, usize.ZERO)
  let absent = Vector.remove<MirCallTarget>(&mut targets, usize.ZERO)
  return Result.succeed<MirCarrierPlan, PreparationFailure>(MirCarrierPlan {node: node, present: move present, absent: move absent})
}

// Whether a stored part owns cleanup; an unanswerable verdict is treated as owning.
effect fn ownsCleanup(resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, part: &Shared<Type>, origin: BodyOrigin) -> bool
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  return match move run ownedCleanup(&mut resolver.*, &mut owner.*, &mut dependencies.*, part, origin) {
    Result<Option<Shared<Type>>, PreparationFailure>.Success {value: Option<Shared<Type>>.None} => false
    _ => true
  }
}

// A stored part's type when an exit that does not consume it must drop it.
effect fn ownedCleanup(resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, part: &Shared<Type>, origin: BodyOrigin) -> Result<Option<Shared<Type>>, PreparationFailure>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let mut visiting = Vector.make<Shared<Type>>()
  let premises = Vector.make<Constraint>()
  let free = match move run cleanupFree(&mut resolver.*, &mut owner.*, &mut dependencies.*, part, Vector.asSlice<Constraint>(&premises),
    &mut visiting, origin.span) {
    Result<bool, Shared<Rejection>>.Success {value} => value
    Result<bool, Shared<Rejection>>.Failure {..} => { return Result.failResult<Option<Shared<Type>>, PreparationFailure>(PreparationFailure.Coverage {code: GapCode.Cleanup}) }
  }
  if free { return Result.succeed<Option<Shared<Type>>, PreparationFailure>(Option.none<Shared<Type>>()) }
  return Result.succeed<Option<Shared<Type>>, PreparationFailure>(Option.some<Shared<Type>>(Shared.clone<Type>(part)))
}

fn constructedEffect(value: &Type) -> bool {
  return match &value.* {
    Type.CallableValue {contract, ..} => Shared.with<Type, bool>(&contract, fn(selected: &Type) -> bool {
      return match &selected.* { Type.Effect {..} => true _ => false }
    })
    _ => false
  }
}

// An effect fn call or `effect fn` value invocation that is not itself run only constructs its
// Effect (D1); its row is served where that value runs, so the call's target is never called here.
fn constructedOnly(body: &TypedBody, node: BodyNodeId) -> bool {
  let nodes = TypedBody.nodeSlice(body)
  let constructs = match &nodes[node.index].kind {
    BodyNodeKind.Expression {ty, form: BodyExpression.DirectCall {..}} => Shared.with<Type, bool>(&ty, constructedEffect)
    BodyNodeKind.Expression {form: BodyExpression.CallableCall {constructs: invoked, ..}, ..} => invoked
    _ => false
  }
  if !constructs { return false }
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {form: BodyExpression.Run {value, ..}, ..} = &nodes[at].kind {
      if value.index == node.index { return false }
    }
    at = at + usize.ONE
  }
  return true
}

// One provider stored by a binding that encloses a composed run, outermost first (D2 rule 2).
struct BoundProvider {
  key: Requirement
  owned: bool
  access: Access
  provider: Shared<Type>
  address: Shared<Type>
}

// The providers serving one callee row, in its canonical key order, and where each comes from.
struct RowProviders {
  sources: Vector<MirProviderSource>
  entries: Vector<ProviderEntry>
}

// Whether a declaration is an operation of a service rather than a function with a body.
fn serviceOperation(id: &DeclarationId) -> bool {
  let count = DeclarationId.ownerCount(id)
  return count > usize.ONE && DeclarationId.ownerKind(id, count - 2) == OwnerKind.Service
}

// The canonical service-role key order (G3): runtime encodings of capability, then role.
effect fn keyEncoding(entry: &Requirement, owner: &DeclarationId) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut encoded = run Type.runtimeEncoding(&entry.capability, owner)
  if let Option<Shared<Type>>.Some {value: roleValue} = &entry.roleType {
    let roleBytes = run Type.runtimeEncoding(&roleValue, owner)
    run Bytes.append(&mut encoded, Bytes.asSlice(&roleBytes))
  }
  return move encoded
}

fn bytesBefore(left: &[u8], right: &[u8]) -> bool {
  let mut at = usize.ZERO
  while at < left.length && at < right.length {
    if left[at] != right[at] { return left[at] < right[at] }
    at = at + usize.ONE
  }
  return left.length < right.length
}

fn encodedBefore(encodings: &Vector<Bytes>, slot: usize) -> bool {
  let listed = Vector.asSlice<Bytes>(encodings)
  return bytesBefore(Bytes.asSlice(&listed[slot]), Bytes.asSlice(&listed[slot - usize.ONE]))
}

// The entries of a closed row in canonical key order, never source order.
effect fn canonicalEntries(row: &Shared<Row>, owner: &DeclarationId) -> Vector<Requirement> ! OutOfMemoryError ? &mut Allocator {
  let mut entries = run Row.entryList(row)
  let mut encodings = Vector.make<Bytes>()
  let listed = Vector.asSlice<Requirement>(&entries)
  let mut at = usize.ZERO
  while at < listed.length {
    run Vector.append<Bytes>(&mut encodings, run keyEncoding(&listed[at], owner))
    at = at + usize.ONE
  }
  // ponytail: insertion sort; rows hold a handful of keys.
  let mut sorted = usize.ONE
  while sorted < Vector.length<Requirement>(&entries) {
    let mut slot = sorted
    while slot > usize.ZERO && encodedBefore(&encodings, slot) {
      let key = Vector.remove<Requirement>(&mut entries, slot)
      run Vector.insert<Requirement>(&mut entries, slot - usize.ONE, move key)
      let bytes = Vector.remove<Bytes>(&mut encodings, slot)
      run Vector.insert<Bytes>(&mut encodings, slot - usize.ONE, move bytes)
      slot = slot - usize.ONE
    }
    sorted = sorted + usize.ONE
  }
  return move entries
}

// The callee's substituted requirement row in canonical key order, each entry served by the
// innermost enclosing binding of its key, else by this instance's own provider (D2).
effect fn rowProviders(resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, application: &Application, own: &[ProviderEntry], bound: &[BoundProvider],
  span: Span) -> Result<RowProviders, PreparationFailure>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let signatureOwner = run Shared.make<DeclarationId>(run DeclarationId.copy(Application.bodyDeclaration(application)))
  let location = match move run locationOfIdentity(&mut resolver.*, &signatureOwner) {
    Option<InstanceLocation>.Some {value} => value
    _ => { fail InvalidModulePath {} }
  }
  let signature = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, Key {
    family: Family.Signature, module: location.module, name: usize.ZERO,
    declaration: location.declaration, member: usize.ZERO, external: false,
  }, span)
  let declared = run signatureRequirements(&signature)
  let bindings = run Application.bindings(application)
  let row = run Row.applyBindings(&declared, Vector.asSlice<Binding>(&bindings), true)
  if Row.hasOpenRuntimeParameters(&row) { return Result.failResult<RowProviders, PreparationFailure>(PreparationFailure.Coverage {code: GapCode.EffectForm}) }
  let ordered = run canonicalEntries(&row, Application.bodyDeclaration(application))
  let listed = Vector.asSlice<Requirement>(&ordered)
  let mut sources = Vector.make<MirProviderSource>()
  let mut entries = Vector.make<ProviderEntry>()
  let mut at = usize.ZERO
  while at < listed.length {
    let mut found = false
    let mut depth = bound.length
    while !found && depth > usize.ZERO {
      depth = depth - usize.ONE
      if run Requirement.keyEquals(&bound[depth].key, &listed[at]) {
        run Vector.append<MirProviderSource>(&mut sources, MirProviderSource.Bound {depth: depth, owned: bound[depth].owned,
          access: bound[depth].access, address: Shared.clone<Type>(&bound[depth].address)})
        run Vector.append<ProviderEntry>(&mut entries, ProviderEntry {key: Requirement.copy(&listed[at]),
          provider: Shared.clone<Type>(&bound[depth].provider)})
        found = true
      }
    }
    let mut ownAt = usize.ZERO
    while !found && ownAt < own.length {
      if run Requirement.keyEquals(&own[ownAt].key, &listed[at]) {
        run Vector.append<MirProviderSource>(&mut sources, MirProviderSource.Own {index: ownAt})
        run Vector.append<ProviderEntry>(&mut entries, ProviderEntry {key: Requirement.copy(&listed[at]),
          provider: Shared.clone<Type>(&own[ownAt].provider)})
        found = true
      }
      ownAt = ownAt + usize.ONE
    }
    // Requirement coverage was proven by the checker (SEM0071); an unserved entry is a gap.
    if !found { return Result.failResult<RowProviders, PreparationFailure>(PreparationFailure.Coverage {code: GapCode.EffectForm}) }
    at = at + usize.ONE
  }
  return Result.succeed<RowProviders, PreparationFailure>(RowProviders {sources: move sources, entries: move entries})
}

// The one row entry naming the service that owns `operation`, by position; absent when the row
// names that service under no role or several (witness checking refuses the latter).
fn dispatchedEntry(entries: &[ProviderEntry], operation: &DeclarationId) -> usize {
  let mut found = usize.MAX
  let mut at = usize.ZERO
  while at < entries.length {
    let owns = Shared.with<Type, bool>(&entries[at].key.capability, fn(value: &Type) -> bool {
      return match &value.* { Type.Nominal {declaration, ..} => DeclarationId.isPrefixOf(&declaration, operation) _ => false }
    })
    if owns {
      if found != usize.MAX { return usize.MAX }
      found = at
    }
    at = at + usize.ONE
  }
  return found
}

// Completes a call target with its callee's providers (D2). A service operation dispatches to the
// witness of its service for the serving provider's type; that witness's own row is served from
// the same environment, and its own declared failure types the call's failure edge (D3).
effect fn provideCall(resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, target: MirCallTarget, own: &[ProviderEntry], bound: &[BoundProvider],
  projections: &[RuntimeProjection], module: &ModuleId, span: Span) -> Result<MirCallTarget, PreparationFailure>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let mut call = move target
  if InstanceKey.isEntry(&call.key) { return Result.succeed<MirCallTarget, PreparationFailure>(move call) }
  // Providers are matched in the call edge's actual regions; the rebuilt key numbers them.
  let application = run Application.copy(&call.application)
  let operation = run DeclarationId.copy(Application.bodyDeclaration(&application))
  let served = match move run rowProviders(&mut resolver.*, &mut owner.*, &mut dependencies.*, &application, own, bound, span) {
    Result<RowProviders, PreparationFailure>.Success {value} => value
    Result<RowProviders, PreparationFailure>.Failure {error} => { return Result.failResult<MirCallTarget, PreparationFailure>(error) }
  }
  if !serviceOperation(&operation) {
    if Vector.length<ProviderEntry>(&served.entries) != usize.ZERO {
      call.key = match move run InstanceKey.withProviders(move application, move served.entries) {
    Result<InstanceKey, CanonicalizationFailure>.Success {value: canonicalKey} => move canonicalKey
    Result<InstanceKey, CanonicalizationFailure>.Failure {error: reason} => {
      return Result.failResult<MirCallTarget, PreparationFailure>(PreparationFailure.Canonicalization {reason: reason})
    }
  }
      call.providers = move served.sources
    }
    return Result.succeed<MirCallTarget, PreparationFailure>(move call)
  }
  // The operation's row names its own service; that entry's provider receives the call.
  let dispatch = dispatchedEntry(Vector.asSlice<ProviderEntry>(&served.entries), &operation)
  if dispatch == usize.MAX { return Result.failResult<MirCallTarget, PreparationFailure>(PreparationFailure.Coverage {code: GapCode.EffectForm}) }
  let mut request = Request.make()
  let servedEntries = Vector.asSlice<ProviderEntry>(&served.entries)
  let capability = Shared.clone<Type>(&servedEntries[dispatch].key.capability)
  let provider = Shared.clone<Type>(&servedEntries[dispatch].provider)
  let selected = run resolveWitnessApplication(&mut resolver.*, &mut owner.*, &mut request, &mut dependencies.*, true,
    &capability, &provider, &operation, module, span)
  let witness = match move selected {
    Result<ResolvedWitness, Shared<Rejection>>.Success {value} => value
    Result<ResolvedWitness, Shared<Rejection>>.Failure {..} => { return Result.failResult<MirCallTarget, PreparationFailure>(PreparationFailure.Coverage {code: GapCode.WitnessOperand}) }
  }
  // Lifetimes lent to the witness are erased at runtime; the caller's loans were already checked.
  let passes = Vector.asSlice<OperandPass>(&witness.operands)
  let mut lent = Vector.make<Binding>()
  let mut at = usize.ZERO
  while at < passes.length {
    if let OperandPass.Borrow {lifetimeOrdinal, ..} = &passes[at] {
      run Vector.append<Binding>(&mut lent, Binding {
        declaration: run Shared.make<DeclarationId>(run DeclarationId.copy(Application.bodyDeclaration(&witness.application))),
        ordinal: lifetimeOrdinal, value: Argument.Lifetime {value: run Shared.make<Lifetime>(Lifetime.Static)},
      })
    }
    at = at + usize.ONE
  }
  let closed = run Application.applyBindings(&witness.application, Vector.asSlice<Binding>(&lent))
  // EFF-009 bounds the witness's failure by the operation's, so it may be narrower (even `never`).
  let signatureOwner = run Shared.make<DeclarationId>(run DeclarationId.copy(Application.bodyDeclaration(&closed)))
  let location = match move run locationOfIdentity(&mut resolver.*, &signatureOwner) {
    Option<InstanceLocation>.Some {value} => value
    Option<InstanceLocation>.None => { fail InvalidModulePath {} }
  }
  let signature = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, Key {family: Family.Signature,
    module: location.module, name: usize.ZERO, declaration: location.declaration, member: usize.ZERO, external: false}, span)
  let facts = match move Shared.with<Result<Answer, NoRejection>, Option<SignatureFacts>>(&signature, signatureFacts) {
    Option<SignatureFacts>.Some {value} => value
    Option<SignatureFacts>.None => { return Result.failResult<MirCallTarget, PreparationFailure>(PreparationFailure.Coverage {code: GapCode.SignatureForm}) }
  }
  let witnessBindings = run Application.bindings(&closed)
  let declaredFailure = run RuntimeType.applyBindings(&facts.failure, Vector.asSlice<Binding>(&witnessBindings), projections)
  let servedSources = Vector.asSlice<MirProviderSource>(&served.sources)
  let receiver = MirProviderSource.copy(&servedSources[dispatch])
  let witnessRow = match move run rowProviders(&mut resolver.*, &mut owner.*, &mut dependencies.*, &closed, own, bound, span) {
    Result<RowProviders, PreparationFailure>.Success {value} => value
    Result<RowProviders, PreparationFailure>.Failure {error} => { return Result.failResult<MirCallTarget, PreparationFailure>(error) }
  }
  call.application = run Application.copy(&closed)
  call.key = match move run InstanceKey.withProviders(move closed, move witnessRow.entries) {
    Result<InstanceKey, CanonicalizationFailure>.Success {value: canonicalKey} => move canonicalKey
    Result<InstanceKey, CanonicalizationFailure>.Failure {error: reason} => {
      return Result.failResult<MirCallTarget, PreparationFailure>(PreparationFailure.Canonicalization {reason: reason})
    }
  }
  call.providers = move witnessRow.sources
  call.dispatch = Option.some<MirProviderSource>(move receiver)
  call.witnessFailure = Option.some<Shared<Type>>(move declaredFailure)
  call.edge = Edge.Witness
  return Result.succeed<MirCallTarget, PreparationFailure>(move call)
}

fn providerEntryCount(values: &Vector<ProviderEntry>) -> usize { return Vector.length<ProviderEntry>(values) }

// This instance's own providers, copied out of its key in canonical key order.
effect fn instanceProviders(instance: &InstanceKey) -> Vector<ProviderEntry> ! OutOfMemoryError ? &mut Allocator {
  let mut copied = Vector.make<ProviderEntry>()
  if let Option<Shared<Vector<ProviderEntry>>>.Some {value: listed} = move InstanceKey.providers(instance) {
    let count = Shared.with<Vector<ProviderEntry>, usize>(&listed, providerEntryCount)
    let mut at = usize.ZERO
    while at < count {
      let entry = Shared.with<Vector<ProviderEntry>, ProviderEntry>(&listed, fn(values: &Vector<ProviderEntry>) -> ProviderEntry {
        let entries = Vector.asSlice<ProviderEntry>(values)
        return ProviderEntry.copy(&entries[at])
      })
      run Vector.append<ProviderEntry>(&mut copied, move entry)
      at = at + usize.ONE
    }
  }
  return move copied
}

// The address type of each own provider, as the hidden parameter's local type.
effect fn providerAddresses(own: &[ProviderEntry]) -> Vector<Shared<Type>> ! OutOfMemoryError ? &mut Allocator {
  let mut addresses = Vector.make<Shared<Type>>()
  let mut at = usize.ZERO
  while at < own.length {
    run Vector.append<Shared<Type>>(&mut addresses, run Shared.make<Type>(Type.Reference {referent: Shared.clone<Type>(&own[at].provider),
      access: own[at].key.access, lifetime: run Shared.make<Lifetime>(Lifetime.Static)}))
    at = at + usize.ONE
  }
  return move addresses
}

fn callableResult(value: &Type) -> Option<Shared<Type>> {
  return match &value.* { Type.Callable {result, ..} => Option.some<Shared<Type>>(Shared.clone<Type>(&result)) _ => Option.none<Shared<Type>>() }
}

// Builds the C ABI shim of one exported definition after classifying every lane. A lane outside
// the immediate scalar and pointer subset keeps its named C ABI gap.
effect fn exportShim(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: Vector<Dependency>,
  identity: &Shared<DeclarationId>,
  key: Key,
  symbol: &Shared<Bytes>,
  written: ForeignHeader,
  observing: bool,
) -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let mut evidence = move dependencies
  let location = InstanceLocation {module: key.module, declaration: key.declaration}
  let classified = run Effect.result(cSignature(&mut resolver.*, &mut owner.*, &mut evidence, identity, location, move written))
  let signature = match move classified {
    Result<CAbi.Signature, BackendGap | Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError>.Success {value} => move value
    Result<CAbi.Signature, BackendGap | Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError>.Failure {error} => match move error {
      BackendGap {code, owner: gapOwner, source} => {
        return memberSuccess(
          Value.Unsupported {gap: run Shared.make<BackendGap>(BackendGap {code: code, owner: move gapOwner, source: move source})},
          move evidence,
        )
      }
      Cycle {} => { fail Cycle {} }
      InvalidModulePath {} => { fail InvalidModulePath {} }
      RevisionMismatch {} => { fail RevisionMismatch {} }
      OutOfMemoryError {} => { fail OutOfMemoryError {} }
    }
  }
  let lanes = Vector.asSlice<CAbi.Lane>(&signature.parameters)
  let mut parameters = Vector.make<Shared<Type>>()
  let mut at = usize.ZERO
  while at < lanes.length {
    run Vector.append<Shared<Type>>(&mut parameters, Shared.clone<Type>(&lanes[at].ty))
    at = at + usize.ONE
  }
  let shim = run MirFunction.cExport(identity, symbol, Vector.asSlice<Shared<Type>>(&parameters), &signature.result.ty, observing)
  return run storeMir(&mut resolver.*, move shim, move evidence)
}

effect fn resolveMir(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  key: Key,
) -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let instances = Vector.asSlice<BackendInstance>(&resolver.backendInstances)
  let instance = InstanceKey.copy(&instances[key.name].key)
  let observing = instances[key.name].observing
  if let Option<Shared<Type>>.Some {value: glued} = move InstanceKey.glueType(&instance) {
    return run resolveGlueMir(&mut resolver.*, &mut owner.*, move instance, &glued, observing)
  }
  let module = run resolvedModule(&resolver.*, key.module)
  let declared = run declarationAt(&mut resolver.*, &module, key.declaration)
  let identity = match move declared {
    Option<DeclarationId>.Some {value} => run Shared.make<DeclarationId>(move value)
    Option<DeclarationId>.None => {
      return memberRejected(
        run reject(
          &resolver.*,
          &module,
          RejectionCode.Unsupported,
          Span.make(usize.ZERO, usize.ZERO),
        ),
        Vector.make<Dependency>(),
      )
    }
  }
  let mut dependencies = Vector.make<Dependency>()
  let signature = run demandChild(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies,
    Key {
      family: Family.Signature,
      module: key.module,
      name: usize.ZERO,
      declaration: key.declaration,
      member: usize.ZERO,
      external: false,
    },
    Span.make(usize.ZERO, usize.ZERO),
  )
  let failure = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
    &signature,
    answerRejection,
  )
  if let Option<Shared<Rejection>>.Some {value} = move failure {
    let code = Shared.with<Rejection, RejectionCode>(
      &value,
      fn(rejection: &Rejection) -> RejectionCode {
        return rejection.code
      },
    )
    let mut coverageGap = BackendGap.forRejection(code)
    if code == RejectionCode.Unsupported { coverageGap = Option.some<GapCode>(GapCode.SignatureForm) }
    if let Option<GapCode>.Some {value: gapCode} = move coverageGap {
      return memberSuccess(
        Value.Unsupported {
          gap: run Shared.make<BackendGap>(BackendGap.fromRejection(gapCode, &identity, &value)),
        },
        move dependencies,
      )
    }
    return memberRejected(move value, move dependencies)
  }
  let selected = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
    &signature,
    signatureResult,
  )
  let mut result = match move selected {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => {
      return memberSuccess(
        Value.Unsupported {
          gap: run Shared.make<BackendGap>(
            BackendGap.make(GapCode.SignatureForm, &identity, Span.make(usize.ZERO, usize.ZERO)),
          ),
        },
        move dependencies,
      )
    }
  }
  let written = run signatureSyntax(&mut resolver.*, &module, key.declaration)
  if let Option<WrittenSignature>.Some {value} = move written {
    if value.isStatic {
      if key.member == usize.MAX {
        return memberRejected(
          run reject(&resolver.*, &module, RejectionCode.StaticPhaseViolation, value.span),
          move dependencies,
        )
      }
      return memberSuccess(
        Value.Unsupported {
          gap: run Shared.make<BackendGap>(
            BackendGap.make(GapCode.StaticResidualization, &identity, value.span),
          ),
        },
        move dependencies,
      )
    }
  }
  let selectedHeader = run header(&mut resolver.*, &module, key.declaration)
  let mut linked = false
  if let Option<HeaderSyntax>.Some {value: syntax} = move selectedHeader {
    if let Node.FunctionHeader {linkage, ..} = syntax.header { linked = linkage.present }
  }
  if linked {
    let foreign = run foreignHeader(&mut resolver.*, &module, key.declaration)
    if !foreign.exported {
      let code = match move foreign.gap {
        Option<GapCode>.Some {value: reason} => reason
        Option<GapCode>.None => GapCode.ForeignContract
      }
      return memberSuccess(
        Value.Unsupported {
          gap: run Shared.make<BackendGap>(BackendGap.make(code, &identity, foreign.span)),
        },
        move dependencies,
      )
    }
    if let Option<Shared<Bytes>>.Some {value: symbol} = move InstanceKey.exportSymbol(&instance) {
      return run exportShim(&mut resolver.*, &mut owner.*, move dependencies, &identity, key, &symbol, move foreign, observing)
    }
    // The exported definition's own body lowers below like any ordinary function.
  }
  if key.member == exportMember() {
    return memberRejected(
      run reject(&resolver.*, &module, RejectionCode.Unsupported, Span.make(usize.ZERO, usize.ZERO)),
      move dependencies,
    )
  }
  if key.member == usize.MAX {
    let parameterCount = Shared.with<Result<Answer, NoRejection>, usize>(
      &signature,
      signatureParameterCount,
    )
    let binderCount = Shared.with<Result<Answer, NoRejection>, usize>(
      &signature,
      signatureBinderCount,
    )
    let returnsExitCode = Shared.with<Type, bool>(
      &result,
      fn(ty: &Type) -> bool {
        return match & ty.* {
          Type.Primitive {name} => same(Bytes.asSlice(&name), b"i32")
          _ => false
        }
      },
    )
    // `effect fn main` has the fallible Effect ABI, not the C entry's; it stays a named gap (D5).
    let effectEntry = Shared.with<Result<Answer, NoRejection>, bool>(&signature, signatureIsEffect)
    if parameterCount != usize.ZERO || binderCount != usize.ZERO || !returnsExitCode || effectEntry {
      return memberSuccess(
        Value.Unsupported {
          gap: run Shared.make<BackendGap>(
            BackendGap.make(GapCode.EntrySignature, &identity, Span.make(usize.ZERO, usize.ZERO)),
          ),
        },
        move dependencies,
      )
    }
    let entry = run MirFunction.entry(&identity, &result, observing)
    return run storeMir(&mut resolver.*, move entry, move dependencies)
  }
  // A function with static work lowers the selected body for this application, never an
  // abstract all-arms body.
  let routing = run needsStaticResidualization(
    &mut resolver.*, &mut owner.*, &mut dependencies, &module, key.module, key.declaration,
  )
  let mut bodyMember = usize.ZERO
  match move routing {
    Result<bool, Shared<Rejection>>.Success {value: routed} => {
      if routed || Shared.with<DeclarationId, bool>(&identity, literalKind) {
        let application = run InstanceKey.selected(&instance)
        let interned = run internSelectedApplication(&mut resolver.*, &application)
        bodyMember = interned + usize.ONE
      }
    }
    Result<bool, Shared<Rejection>>.Failure {error} => {
      return run mirRejection(&identity, move error, move dependencies)
    }
  }
  let bodyAnswer = run demandChild(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies,
    Key {
      family: Family.Body,
      module: key.module,
      name: usize.ZERO,
      declaration: key.declaration,
      member: bodyMember,
      external: false,
    },
    Span.make(usize.ZERO, usize.ZERO),
  )
  let bodyFailure = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
    &bodyAnswer,
    answerRejection,
  )
  if let Option<Shared<Rejection>>.Some {value} = move bodyFailure {
    let coverageGap = Shared.with<Rejection, Option<GapCode>>(&value, fn(rejection: &Rejection) -> Option<GapCode> {
      return BackendGap.forRejection(rejection.code)
    })
    if let Option<GapCode>.Some {value: gapCode} = move coverageGap {
      return memberSuccess(
        Value.Unsupported {
          gap: run Shared.make<BackendGap>(BackendGap.fromRejection(gapCode, &identity, &value)),
        },
        move dependencies,
      )
    }
    let unsupported = Shared.with<Rejection, bool>(
      &value,
      fn(rejection: &Rejection) -> bool {
        return rejection.code == RejectionCode.Unsupported
      },
    )
    if unsupported {
      let span = Shared.with<Rejection, Span>(
        &value,
        fn(rejection: &Rejection) -> Span {
          return rejection.span
        },
      )
      let operationInputs = Shared.with<Rejection, bool>(&value, fn(diagnostic: &Rejection) -> bool {
        return Vector.length<Shared<DeclarationId>>(&diagnostic.path) == usize.ONE
      })
      if operationInputs {
        let operation = Shared.with<Rejection, Shared<DeclarationId>>(&value, fn(diagnostic: &Rejection) -> Shared<DeclarationId> {
          let path = Vector.asSlice<Shared<DeclarationId>>(&diagnostic.path)
          return Shared.clone<DeclarationId>(&path[usize.ZERO])
        })
        let declared = run DeclarationId.copyShared(&operation)
        let operationModule = DeclarationId.moduleId(&declared)
        let ordinal = run ordinalOfIdentity(&mut resolver.*, operationModule, &operation)
        if let Option<usize>.Some {value: at} = move ordinal {
          let parent = run enclosingIdentity(&mut resolver.*, operationModule, at)
          if let Option<DeclarationId>.Some {value: parentIdentity} = move parent {
            if DeclarationId.kind(&parentIdentity) == OwnerKind.Interface {
              return memberSuccess(Value.Unsupported {
                gap: run Shared.make<BackendGap>(BackendGap.fromRejection(GapCode.GenericOperation, &identity, &value)),
              }, move dependencies)
            }
          }
        }
      }
      let authoredOrdinal = rejectionModuleOrdinal(&resolver.*, &value)
      if authoredOrdinal == usize.MAX { return memberRejected(move value, move dependencies) }
      let authoredModule = run resolvedModule(&resolver.*, authoredOrdinal)
      let sourceAnswer = run source(&mut resolver.*, &authoredModule)
      let coverage = match move sourceOf(&resolver.*, &sourceAnswer, &authoredModule) {
        Option<&IndexedSource>.Some {value: indexed} => bodyCoverageGap(
          IndexedSource.authored(indexed),
          span,
        )
        Option<&IndexedSource>.None => {
          return memberRejected(
            run reject(&resolver.*, &authoredModule, RejectionCode.MissingModule, span),
            move dependencies,
          )
        }
      }
      return memberSuccess(
        Value.Unsupported {
          gap: run Shared.make<BackendGap>(BackendGap.fromRejection(coverage, &identity, &value)),
        },
        move dependencies,
      )
    }
    let profileInput = Shared.with<Rejection, bool>(
      &value,
      fn(rejection: &Rejection) -> bool {
        return rejection.code == RejectionCode.ProfileInputUnavailable
      },
    )
    if profileInput {
      return memberSuccess(
        Value.Unsupported {
          gap: run Shared.make<BackendGap>(BackendGap.fromRejection(GapCode.ProfileInput, &identity, &value)),
        },
        move dependencies,
      )
    }
    return memberRejected(move value, move dependencies)
  }
  let body = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(
    &bodyAnswer,
    answerTypedBody,
  )
  let checkedBody = match move body {
    Option<Shared<TypedBody>>.Some {value} => move value
    Option<Shared<TypedBody>>.None => {
      return memberSuccess(
        Value.Unsupported {
          gap: run Shared.make<BackendGap>(
            BackendGap.make(GapCode.TypedForm, &identity, Span.make(usize.ZERO, usize.ZERO)),
          ),
        },
        move dependencies,
      )
    }
  }
  let hasEnvironment = Shared.with<TypedBody, bool>(&checkedBody, fn(value: &TypedBody) -> bool {
    let environment = TypedBody.environmentOf(value)
    return match &environment.* { Option<BodyEnvironment>.Some {..} => true _ => false }
  })
  let typed = move checkedBody
  // Resolve checked call targets before borrowing the caller's authored HIR. Proof queries
  // are MIR children, while target bodies remain deferred to the admitted instance worklist.
  let callerApplication = run InstanceKey.selected(&instance)
  if Shared.with<Type, bool>(&result, rawCallableType) {
    result = match move run callableResultType(&mut resolver.*, &mut owner.*, &mut dependencies,
      &callerApplication, Vector.asSlice<Constraint>(&Vector.make<Constraint>()), Span.make(usize.ZERO, usize.ZERO)) {
      Result<Shared<Type>, Shared<Rejection>>.Success {value} => move value
      Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return run mirRejection(&identity, move error, move dependencies) }
    }
  }
  let callerBindings = run Application.bindings(&callerApplication)
  // Runtime lanes only: a static parameter's value is part of the instance key, not an operand.
  let mut parameters = Vector.make<Shared<Type>>()
  if hasEnvironment {
    run Vector.append<Shared<Type>>(&mut parameters, Shared.with<TypedBody, Shared<Type>>(&typed, fn(value: &TypedBody) -> Shared<Type> {
      let locals = TypedBody.localSlice(value)
      return Shared.clone<Type>(&locals[usize.ZERO].ty)
    }))
  }
  let count = Shared.with<Result<Answer, NoRejection>, usize>(&signature, signatureParameterCount)
  let staticCount = Shared.with<Result<Answer, NoRejection>, usize>(&signature, signatureStaticCount)
  let staticSlots = run signatureStaticSlots(&signature, staticCount)
  let mut at = usize.ZERO
  while at < count {
    if !isStaticIndex(Vector.asSlice<usize>(&staticSlots), at) {
      let selected = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
        &signature,
        fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> {
          return signatureParameterAt(answer, at)
        },
      )
      if let Option<Shared<Type>>.Some {value} = move selected {
        run Vector.append<Shared<Type>>(&mut parameters, move value)
      }
    }
    at = at + usize.ONE
  }
  let projections = match move run runtimeProjections(&mut resolver.*, &mut owner.*, &mut dependencies,
    &callerApplication, Vector.asSlice<Binding>(&callerBindings), &typed, &result, Vector.asSlice<Shared<Type>>(&parameters)) {
    Result<Vector<RuntimeProjection>, Shared<Rejection>>.Success {value} => move value
    Result<Vector<RuntimeProjection>, Shared<Rejection>>.Failure {error} => { return run mirRejection(&identity, move error, move dependencies) }
  }
  let storageProjection = Vector.asSlice<RuntimeProjection>(&projections)
  let own = run instanceProviders(&instance)
  let premiseCount = Shared.with<Result<Answer, NoRejection>, usize>(&signature, signatureConstraintCount)
  let mut premises = Vector.make<Constraint>()
  let mut premiseAt = usize.ZERO
  while premiseAt < premiseCount {
    let premise = Shared.with<Result<Answer, NoRejection>, Option<Constraint>>(&signature,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Constraint> { return signatureConstraint(answer, premiseAt) })
    if let Option<Constraint>.Some {value} = move premise { run Vector.append<Constraint>(&mut premises, move value) }
    premiseAt = premiseAt + usize.ONE
  }
  let needs = match move run cleanupNeeds(&mut resolver.*, &mut owner.*, &mut dependencies, &typed, Vector.asSlice<Binding>(&callerBindings),
    storageProjection, Vector.asSlice<Constraint>(&premises)) {
    Result<CleanupNeeds, Shared<Rejection>>.Success {value} => value
    Result<CleanupNeeds, Shared<Rejection>>.Failure {error} => { return run mirRejection(&identity, move error, move dependencies) }
  }
  let mut calls = Vector.make<MirCallTarget>()
  let mut plans = Vector.make<MirNodePlan>()
  let mut storage = Vector.make<MirStoragePlan>()
  let mut carriers = Vector.make<MirCarrierPlan>()
  let mut witnessIntrinsics = Vector.make<MirWitnessIntrinsic>()
  let reachedCalls = run MirFunction.callNodes(&typed)
  let callNodes = Vector.asSlice<BodyNodeId>(&reachedCalls)
  let mut callAt = usize.ZERO
  let mut callRequest = Request.make()
  while callAt < callNodes.length {
    let node = callNodes[callAt]
    if let Option<StorageOperation>.Some {value: operation} = move TypedBody.storageOperation(&typed, node) {
      let site = Shared.with<TypedBody, Span>(&typed, fn(value: &TypedBody) -> Span { return TypedBody.nodeSlice(value)[node.index].origin.span })
      match move run storagePlan(&mut resolver.*, &mut owner.*, &mut dependencies, &typed, node, operation, &callerApplication,
        Vector.asSlice<Binding>(&callerBindings), storageProjection, &identity, Vector.asSlice<ProviderEntry>(&own), &module, site) {
        Result<MirStoragePlan, PreparationFailure>.Success {value} => { run Vector.append<MirStoragePlan>(&mut storage, move value) }
        Result<MirStoragePlan, PreparationFailure>.Failure {error} => {
          return run preparationAnswer(&resolver.*, &identity, &module, site, move error, move dependencies)
        }
      }
    }
    let direct = TypedBody.directApplication(&typed, node)
    if let Option<Shared<Application>>.Some {value: recordedApplication} = move direct {
      let recorded = run Application.copyShared(&recordedApplication)
      let closed = run Application.substitute(&recorded, &callerApplication)
      let mut operands = Vector.make<MirCallOperand>()
      let mut at = usize.ZERO
      while true {
        let selected = TypedBody.callArgument(&typed, node, at)
        let argument = match move selected { Option<CallArgument>.Some {value} => move value _ => { break } }
        let ty = run RuntimeType.applyBindings(&argument.ty, Vector.asSlice<Binding>(&callerBindings), storageProjection)
        run Vector.append<MirCallOperand>(&mut operands, MirCallOperand {value: Shared.clone<Type>(&ty), parameter: move ty, borrow: Option.none<Access>()})
        at = at + usize.ONE
      }
      let calleeKey = match move run InstanceKey.function(run Application.copy(&closed)) {
        Result<InstanceKey, CanonicalizationFailure>.Success {value: canonicalKey} => move canonicalKey
        Result<InstanceKey, CanonicalizationFailure>.Failure {error: reason} => {
          return run preparationAnswer(&resolver.*, &identity, &module,
            Shared.with<TypedBody, Span>(&typed, fn(value: &TypedBody) -> Span { return TypedBody.nodeSlice(value)[node.index].origin.span }),
            PreparationFailure.Canonicalization {reason: reason}, move dependencies)
        }
      }
      run Vector.append<MirCallTarget>(&mut calls, MirCallTarget {
        node: node, receiverDereferences: usize.ZERO, key: move calleeKey, application: move closed, edge: Edge.Direct, operands: move operands,
        stored: Option.none<MirStoredArguments>(), providers: Vector.make<MirProviderSource>(), dispatch: Option.none<MirProviderSource>(),
        witnessFailure: Option.none<Shared<Type>>(),
      })
    }
    // A stored Effect runs through its exact representation's runner, like a callable with no new
    // arguments: its environment supplies the stored arguments or the block's captures (D1).
    let stored = TypedBody.runOperand(&typed, node)
    let mut composed = Option.none<RunOperand>()
    let mut plain = Option.none<RunOperand>()
    if let Option<RunOperand>.Some {value: operand} = move stored {
      let closed = run Type.applyBindings(&operand.receiver, Vector.asSlice<Binding>(&callerBindings), true)
      if Shared.with<Type, bool>(&closed, compositeType) { composed = Option.some<RunOperand>(move operand) }
      else { plain = Option.some<RunOperand>(move operand) }
    }
    // A composed Effect expands at its run site through a prepared plan of ordinary targets (D4).
    if let Option<RunOperand>.Some {value: operand} = move composed {
      let closed = run Type.applyBindings(&operand.receiver, Vector.asSlice<Binding>(&callerBindings), true)
      let mut steps = Vector.make<MirRunPlan>()
      let mut bound = Vector.make<BoundProvider>()
      let prepared = run compositePlan(&mut resolver.*, &mut owner.*, &mut dependencies, &typed, node, &callerApplication,
        Vector.asSlice<Binding>(&callerBindings), storageProjection, &identity, &closed, operand.origin, Vector.asSlice<ProviderEntry>(&own),
        &mut bound, &module, &mut steps)
      match move prepared {
        Result<usize, PreparationFailure>.Success {..} => { run Vector.append<MirNodePlan>(&mut plans, MirNodePlan {node: node, steps: move steps}) }
        Result<usize, PreparationFailure>.Failure {error} => {
          return run preparationAnswer(&resolver.*, &identity, &module, operand.origin.span, move error, move dependencies)
        }
      }
    }
    if let Option<RunOperand>.Some {value: operand} = move plain {
      // Running an interface call's Effect needs the witness construction, which is not lowered.
      if let Option<InterfaceCallInputs>.Some {value: interfaceInputs} = move TypedBody.interfaceCall(&typed, operand.callee) {
        return memberSuccess(Value.Unsupported {gap: run Shared.make<BackendGap>(BackendGap.make(GapCode.InterfaceEffectWitness,
          &identity, interfaceInputs.origin.span))}, move dependencies)
      }
      let mode = Shared.with<Type, CallableMode>(&operand.receiver, callableInvocationMode)
      let inputs = CallableCallInputs {receiver: move operand.receiver, inference: Shared.clone<DeclarationId>(&identity),
        bindings: run Shared.make<Vector<Binding>>(Vector.make<Binding>()), mode: mode, callee: operand.callee,
        result: move operand.result, count: usize.ZERO, origin: operand.origin}
      let none = Vector.make<Shared<Type>>()
      let selected = run concreteCallableCall(&mut resolver.*, &mut owner.*, &mut dependencies, &typed, node,
        &callerApplication, Vector.asSlice<Binding>(&callerBindings), storageProjection, move inputs, Vector.asSlice<Shared<Type>>(&none))
      match move selected {
        Result<MirCallTarget, PreparationFailure>.Success {value} => { run Vector.append<MirCallTarget>(&mut calls, move value) }
        Result<MirCallTarget, PreparationFailure>.Failure {error} => {
          return run preparationAnswer(&resolver.*, &identity, &module, Shared.with<TypedBody, Span>(&typed, fn(value: &TypedBody) -> Span { return TypedBody.nodeSlice(value)[node.index].origin.span }), move error, move dependencies)
        }
      }
    }
    let callable = TypedBody.callableCall(&typed, node)
    if let Option<CallableCallInputs>.Some {value: inputs} = move callable {
      let mut written = Vector.make<Shared<Type>>()
      let mut writtenAt = usize.ZERO
      while writtenAt < inputs.count {
        let selectedArgument = TypedBody.callArgument(&typed, node, writtenAt)
        let argument = match move selectedArgument { Option<CallArgument>.Some {value} => value _ => { fail RevisionMismatch {} } }
        run Vector.append<Shared<Type>>(&mut written, run Type.applyBindings(&argument.ty, Vector.asSlice<Binding>(&callerBindings), true))
        writtenAt = writtenAt + usize.ONE
      }
      let selected = run concreteCallableCall(&mut resolver.*, &mut owner.*, &mut dependencies, &typed, node,
        &callerApplication, Vector.asSlice<Binding>(&callerBindings), storageProjection, move inputs, Vector.asSlice<Shared<Type>>(&written))
      match move selected {
        Result<MirCallTarget, PreparationFailure>.Success {value} => { run Vector.append<MirCallTarget>(&mut calls, move value) }
        Result<MirCallTarget, PreparationFailure>.Failure {error} => {
          return run preparationAnswer(&resolver.*, &identity, &module, Shared.with<TypedBody, Span>(&typed, fn(value: &TypedBody) -> Span { return TypedBody.nodeSlice(value)[node.index].origin.span }), move error, move dependencies)
        }
      }
    }
    // A checked scalar operation invokes exactly one of its carriers.
    if let Option<IntrinsicCallInputs>.Some {value: intrinsic} = move TypedBody.intrinsicCall(&typed, node) {
      if let IntrinsicMember.Scalar {operation} = intrinsic.member {
        if ScalarOperation.checked(operation) {
          let prepared = run carrierPlan(&mut resolver.*, &mut owner.*, &mut dependencies, &typed, node, &callerApplication,
            Vector.asSlice<Binding>(&callerBindings), storageProjection, &identity, operation, &intrinsic.result,
            Vector.asSlice<ProviderEntry>(&own), &module)
          match move prepared {
            Result<MirCarrierPlan, PreparationFailure>.Success {value} => { run Vector.append<MirCarrierPlan>(&mut carriers, move value) }
            Result<MirCarrierPlan, PreparationFailure>.Failure {error} => {
              return run preparationAnswer(&resolver.*, &identity, &module, intrinsic.origin.span, move error, move dependencies)
            }
          }
        }
      }
    }
    let selectedCall = TypedBody.interfaceCall(&typed, node)
    if let Option<InterfaceCallInputs>.Some {value: inputs} = move selectedCall {
      let operation = run DeclarationId.copyShared(&inputs.operation)
      let contract = run Type.applyBindings(&inputs.contract, Vector.asSlice<Binding>(&callerBindings), true)
      let provider = run Type.applyBindings(&inputs.provider, Vector.asSlice<Binding>(&callerBindings), true)
      let count = Shared.with<Vector<Binding>, usize>(&inputs.bindings, fn(values: &Vector<Binding>) -> usize { return Vector.length<Binding>(values) })
      let mut invocation = Vector.make<Binding>()
      let mut bindingAt = usize.ZERO
      while bindingAt < count {
        let recorded = Shared.with<Vector<Binding>, Binding>(&inputs.bindings, fn(values: &Vector<Binding>) -> Binding {
          let entries = Vector.asSlice<Binding>(values)
          return Binding {declaration: Shared.clone<DeclarationId>(&entries[bindingAt].declaration),
            ordinal: entries[bindingAt].ordinal, value: Argument.copy(&entries[bindingAt].value)}
        })
        run Vector.append<Binding>(&mut invocation, Binding {declaration: move recorded.declaration, ordinal: recorded.ordinal,
          value: run Argument.applyBindings(&recorded.value, Vector.asSlice<Binding>(&callerBindings), true)})
        bindingAt = bindingAt + usize.ONE
      }
      let mut actualArguments = Vector.make<Shared<Type>>()
      let mut actualLoans = Vector.make<WitnessLoan>()
      let mut at = usize.ZERO
      while at < inputs.count {
        let selected = TypedBody.callArgument(&typed, node, at)
        let argument = match move selected { Option<CallArgument>.Some {value} => move value _ => { fail RevisionMismatch {} } }
        run Vector.append<Shared<Type>>(&mut actualArguments, run Type.applyBindings(&argument.ty, Vector.asSlice<Binding>(&callerBindings), true))
        run Vector.append<WitnessLoan>(&mut actualLoans, WitnessLoan {region: Option.some<Shared<Lifetime>>(run Shared.make<Lifetime>(Lifetime.Local {
          declaration: run DeclarationId.copy(Application.bodyDeclaration(&callerApplication)), ordinal: argument.origin.syntax.index}))})
        at = at + usize.ONE
      }
      let recipe = WitnessRecipe {operation: run Shared.make<DeclarationId>(move operation), contract: move contract, provider: move provider,
        result: Shared.clone<Type>(&inputs.result), bindings: run Shared.make<Vector<Binding>>(move invocation),
        arguments: run Shared.make<Vector<Shared<Type>>>(move actualArguments), loans: run Shared.make<Vector<WitnessLoan>>(move actualLoans)}
      // A scalar intrinsic witness lowers in place over the call's operands; it calls no instance.
      let recipeOperation = run DeclarationId.copyShared(&recipe.operation)
      let intrinsicWitness = run resolveWitnessIntrinsic(&mut resolver.*, &mut owner.*, &mut callRequest, &mut dependencies,
        &recipe.contract, &recipe.provider, &recipeOperation, &module, inputs.origin.span)
      if let Option<IntrinsicMember>.Some {value: member} = move intrinsicWitness {
        let mut admitted = inputs.count == intrinsicArity(member)
        at = usize.ZERO
        while admitted && at < inputs.count {
          let selected = TypedBody.callArgument(&typed, node, at)
          let argument = match move selected { Option<CallArgument>.Some {value} => move value _ => { fail RevisionMismatch {} } }
          let actual = run RuntimeType.applyBindings(&argument.ty, Vector.asSlice<Binding>(&callerBindings), storageProjection)
          admitted = match move intrinsicParameterKind(member, at) {
            Option<IntrinsicValueKind>.Some {value: kind} => Shared.with<Type, bool>(&actual, fn(value: &Type) -> bool { return intrinsicMatches(kind, value) })
            Option<IntrinsicValueKind>.None => false
          }
          at = at + usize.ONE
        }
        if admitted {
          let expected = run RuntimeType.applyBindings(&inputs.result, Vector.asSlice<Binding>(&callerBindings), storageProjection)
          admitted = match move intrinsicResultKind(member) {
            Option<IntrinsicValueKind>.Some {value: kind} => Shared.with<Type, bool>(&expected, fn(value: &Type) -> bool { return intrinsicMatches(kind, value) })
            Option<IntrinsicValueKind>.None => false
          }
        }
        if !admitted {
          return memberSuccess(Value.Unsupported {gap: run Shared.make<BackendGap>(BackendGap.make(GapCode.WitnessOperand, &identity, inputs.origin.span))}, move dependencies)
        }
        run Vector.append<MirWitnessIntrinsic>(&mut witnessIntrinsics, MirWitnessIntrinsic {node: node, member: member})
        callAt = callAt + usize.ONE
        continue
      }
      let witness = match move run completedWitnessApplication(&mut resolver.*, &mut owner.*, &mut callRequest,
        &mut dependencies, &recipe, &module, inputs.origin.span) {
        Result<ResolvedWitness, Shared<Rejection>>.Success {value} => move value
        Result<ResolvedWitness, Shared<Rejection>>.Failure {error} => { return run mirRejection(&identity, move error, move dependencies) }
      }
      let application = &witness.application
      let passes = Vector.asSlice<OperandPass>(&witness.operands)
      let targetBindings = run Application.bindings(application)
      let targetKey = match move run InstanceKey.function(run Application.copy(application)) {
        Result<InstanceKey, CanonicalizationFailure>.Success {value: canonicalKey} => move canonicalKey
        Result<InstanceKey, CanonicalizationFailure>.Failure {error: reason} => {
          return run preparationAnswer(&resolver.*, &identity, &module, inputs.origin.span,
            PreparationFailure.Canonicalization {reason: reason}, move dependencies)
        }
      }
      let targetLocation = run locationOfInstance(&mut resolver.*, &targetKey)
      let location = match move targetLocation { Option<InstanceLocation>.Some {value} => value _ => { fail InvalidModulePath {} } }
      let targetSignature = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies,
        Key {family: Family.Signature, module: location.module, name: usize.ZERO, declaration: location.declaration, member: usize.ZERO, external: false}, inputs.origin.span)
      let facts = Shared.with<Result<Answer, NoRejection>, Option<SignatureFacts>>(&targetSignature, signatureFacts)
      let target = match move facts { Option<SignatureFacts>.Some {value} => move value _ => { return memberSuccess(Value.Unsupported {
        gap: run Shared.make<BackendGap>(BackendGap.make(GapCode.SignatureForm, &identity, inputs.origin.span))}, move dependencies) } }
      let mut promisedResult = Shared.clone<Type>(&inputs.result)
      let mut witnessFailure = Option.none<Shared<Type>>()
      // An `effect fn` witness runs as the one call its enclosing `run` executes (Effect note D1).
      // That call's failure edge is typed by the witness's own declared failure, which EFF-009
      // bounds by the promised one (D3). Typing already rejects every construction no `run`
      // executes in place (strandedInterfaceEffect, proveOpaqueReturn); `ranHere` re-checks that
      // invariant instead of lowering a stored construction as a call.
      if target.isEffect {
        let ranHere = Shared.with<TypedBody, bool>(&typed, fn(value: &TypedBody) -> bool {
          return ranInPlace(TypedBody.nodeSlice(value), node.index)
        })
        let promised = match move Shared.with<Type, Option<EffectChannels>>(&inputs.result, effectChannels) {
          Option<EffectChannels>.Some {value} => value
          Option<EffectChannels>.None => { return memberSuccess(Value.Unsupported {gap: run Shared.make<BackendGap>(
            BackendGap.make(GapCode.InterfaceEffectWitness, &identity, inputs.origin.span))}, move dependencies) }
        }
        if !ranHere {
          return memberSuccess(Value.Unsupported {gap: run Shared.make<BackendGap>(BackendGap.make(GapCode.InterfaceEffectWitness,
            &identity, inputs.origin.span))}, move dependencies)
        }
        witnessFailure = Option.some<Shared<Type>>(run RuntimeType.applyBindings(&target.failure, Vector.asSlice<Binding>(&targetBindings),
          storageProjection))
        promisedResult = move promised.success
      }
      let expectedResult = run RuntimeType.applyBindings(&promisedResult, Vector.asSlice<Binding>(&callerBindings), storageProjection)
      let targetResult = match move run callableInvocationResult(&mut resolver.*, &mut owner.*, &mut dependencies,
        application, &target.result, Vector.asSlice<Binding>(&targetBindings), storageProjection, inputs.origin.span) {
        Result<Shared<Type>, PreparationFailure>.Success {value} => move value
        Result<Shared<Type>, PreparationFailure>.Failure {error} => { return run preparationAnswer(&resolver.*, &identity, &module, inputs.origin.span, move error, move dependencies) }
      }
      if target.parameters != passes.length || !run Type.runtimeEqualsShared(&expectedResult, &targetResult) {
        return memberSuccess(Value.Unsupported {gap: run Shared.make<BackendGap>(BackendGap.make(GapCode.WitnessOperand, &identity, inputs.origin.span))}, move dependencies)
      }
      // Header proof already established result/failure/row correspondence. This boundary
      // additionally guards concrete operand storage before any target-neutral call is emitted.
      let mut operands = Vector.make<MirCallOperand>()
      at = usize.ZERO
      while at < passes.length {
        let selected = TypedBody.callArgument(&typed, node, at)
        let argument = match move selected { Option<CallArgument>.Some {value} => move value _ => { fail RevisionMismatch {} } }
        let actual = run RuntimeType.applyBindings(&argument.ty, Vector.asSlice<Binding>(&callerBindings), storageProjection)
        let selectedParameter = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(&targetSignature,
          fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> { return signatureParameter(answer, at) })
        let raw = match move selectedParameter { Option<Shared<Type>>.Some {value} => move value _ => { fail RevisionMismatch {} } }
        let parameter = run RuntimeType.applyBindings(&raw, Vector.asSlice<Binding>(&targetBindings), storageProjection)
        let mut borrow = Option.none<Access>()
        let mut compared = Shared.clone<Type>(&parameter)
        if let OperandPass.Borrow {access, ..} = &passes[at] {
          borrow = Option.some<Access>(access)
          compared = operandTarget(&parameter)
        }
        if !run Type.runtimeEqualsShared(&actual, &compared) {
          return memberSuccess(Value.Unsupported {gap: run Shared.make<BackendGap>(BackendGap.make(GapCode.WitnessOperand, &identity, inputs.origin.span))}, move dependencies)
        }
        run Vector.append<MirCallOperand>(&mut operands, MirCallOperand {value: move actual, parameter: move parameter, borrow: move borrow})
        at = at + usize.ONE
      }
      run Vector.append<MirCallTarget>(&mut calls, MirCallTarget {
        node: node, receiverDereferences: usize.ZERO, key: move targetKey, application: run Application.copy(application),
        edge: Edge.Witness, operands: move operands,
        stored: Option.none<MirStoredArguments>(), providers: Vector.make<MirProviderSource>(), dispatch: Option.none<MirProviderSource>(),
        witnessFailure: move witnessFailure,
      })
    }
    callAt = callAt + usize.ONE
  }
  // Each callee's requirement row is served from this instance's own providers (D2 rule 1).
  let mut provided = Vector.make<MirCallTarget>()
  while Vector.length<MirCallTarget>(&calls) > usize.ZERO {
    let pending = Vector.remove<MirCallTarget>(&mut calls, usize.ZERO)
    let site = Shared.with<TypedBody, Span>(&typed, fn(value: &TypedBody) -> Span { return TypedBody.nodeSlice(value)[pending.node.index].origin.span })
    if Shared.with<TypedBody, bool>(&typed, fn(value: &TypedBody) -> bool { return constructedOnly(value, pending.node) }) {
      run Vector.append<MirCallTarget>(&mut provided, move pending)
      continue
    }
    let none = Vector.make<BoundProvider>()
    match move run provideCall(&mut resolver.*, &mut owner.*, &mut dependencies, move pending, Vector.asSlice<ProviderEntry>(&own),
      Vector.asSlice<BoundProvider>(&none), storageProjection, &module, site) {
      Result<MirCallTarget, PreparationFailure>.Success {value} => { run Vector.append<MirCallTarget>(&mut provided, move value) }
      Result<MirCallTarget, PreparationFailure>.Failure {error} => {
        return run preparationAnswer(&resolver.*, &identity, &module, site, move error, move dependencies)
      }
    }
  }
  let addresses = run providerAddresses(Vector.asSlice<ProviderEntry>(&own))
  let remainders = match move run partialRemainders(&mut resolver.*, &mut owner.*, &mut dependencies, &module, Application.bodyDeclaration(&callerApplication), &typed, Vector.asSlice<Binding>(&callerBindings), storageProjection) {
    Result<Vector<Remainder>, Shared<Rejection>>.Success {value} => value
    Result<Vector<Remainder>, Shared<Rejection>>.Failure {error} => { return run mirRejection(&identity, move error, move dependencies) }
  }
  let failureType = run signatureFailure(&signature)
  let sourceAnswer = run source(&mut resolver.*, &module)
  let lowered = match move sourceOf(&resolver.*, &sourceAnswer, &module) {
    Option<&IndexedSource>.Some {value: indexed} => run Effect.result(
      MirFunction.lower(
        InstanceKey.copy(&instance),
        &typed,
        IndexedSource.authored(indexed),
        &result,
        &failureType,
        Vector.asSlice<Shared<Type>>(&parameters),
        Vector.asSlice<Shared<Type>>(&addresses),
        move provided,
        move plans,
        move storage,
        move carriers,
        move witnessIntrinsics,
        move remainders,
        move needs,
        move projections,
        SourceUnit.bytes(IndexedSource.sourceUnit(indexed)),
        observing,
      ),
    )
    Option<&IndexedSource>.None => {
      return memberRejected(
        run reject(
          &resolver.*,
          &module,
          RejectionCode.Unsupported,
          Span.make(usize.ZERO, usize.ZERO),
        ),
        move dependencies,
      )
    }
  }
  return match move lowered {
    Result<MirFunction, BackendGap | CanonicalizationFailure | OutOfMemoryError>.Success {value} => run storeMir(
      &mut resolver.*,
      move value,
      move dependencies,
    )
    Result<MirFunction, BackendGap | CanonicalizationFailure | OutOfMemoryError>.Failure {error} => match move error {
      BackendGap {code, owner: gapOwner, source} => memberSuccess(
        Value.Unsupported {
          gap: run Shared.make<BackendGap>(
            BackendGap {code: code, owner: move gapOwner, source: move source},
          ),
        },
        move dependencies,
      )
      CanonicalizationFailure reason => memberSuccess(
        Value.CanonicalizationFailed {reason: reason}, move dependencies)
      OutOfMemoryError {} => {
        fail OutOfMemoryError {}
      }
    }
  }
}

fn singleMemberType(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.MemberShape {types}} = &value.outcome {
      let fields = Vector.asSlice<Shared<Type>>(&types)
      if fields.length == usize.ONE { return Option.some<Shared<Type>>(Shared.clone<Type>(&fields[usize.ZERO])) }
    }
  }
  return Option.none<Shared<Type>>()
}

effect fn storeLayout(resolver: &mut Resolver, computed: Option<BackendLayout>, dependencies: Vector<Dependency>) -> Answer
! OutOfMemoryError ? &mut Allocator {
  return match move computed {
    Option<BackendLayout>.Some {value} => {
      let index = Vector.length<Shared<BackendLayout>>(&resolver.layoutValues)
      run Vector.append<Shared<BackendLayout>>(&mut resolver.*.layoutValues, run Shared.make<BackendLayout>(move value))
      return memberSuccess(Value.Layout {index: index}, move dependencies)
    }
    Option<BackendLayout>.None => memberSuccess(Value.LayoutUnsupported, move dependencies)
  }
}

effect fn resolveLayout(resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>, key: Key) -> Answer
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let types = Vector.asSlice<Shared<Type>>(&resolver.layoutTypes)
  if key.name >= types.length {
    return memberSuccess(Value.LayoutUnsupported, Vector.make<Dependency>())
  }
  let ty = Shared.clone<Type>(&types[key.name])
  let scalar = BackendLayout.scalar(&ty, &resolver.target)
  if let Option<BackendLayout>.Some {value} = move scalar {
    return run storeLayout(&mut resolver.*, Option.some<BackendLayout>(move value), Vector.make<Dependency>())
  }
  if Shared.with<Type, bool>(&ty, fn(value: &Type) -> bool { return match &value.* { Type.String {..} => true _ => false } }) {
    let text = run BackendLayout.text(&resolver.target)
    return run storeLayout(&mut resolver.*, move text, Vector.make<Dependency>())
  }
  if let Option<ArrayShape>.Some {value: array} = move Type.arrayShape(&ty) {
    let mut dependencies = Vector.make<Dependency>()
    let elementKey = run internLayoutType(&mut resolver.*, &array.element)
    let child = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies, Key {
      family: Family.Layout, module: key.module, name: elementKey,
      declaration: usize.ZERO, member: usize.ZERO, external: false,
    }, Span.make(usize.ZERO, usize.ZERO))
    let rejected = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(&child, answerRejection)
    if let Option<Shared<Rejection>>.Some {value} = move rejected {
      return memberRejected(move value, move dependencies)
    }
    let selected = Shared.with<Result<Answer, NoRejection>, Option<usize>>(&child, answerLayoutIndex)
    if let Option<usize>.Some {value: index} = move selected {
      let layouts = Vector.asSlice<Shared<BackendLayout>>(&resolver.layoutValues)
      let metrics = Shared.with<BackendLayout, LayoutMetrics>(&layouts[index], BackendLayout.metrics)
      return run storeLayout(&mut resolver.*, BackendLayout.sequence(&array.element, array.length, metrics), move dependencies)
    }
    return memberSuccess(Value.LayoutUnsupported, move dependencies)
  }
  if let Option<Shared<Type>>.Some {value: element} = move Type.sliceElement(&ty) {
    let mut dependencies = Vector.make<Dependency>()
    let elementKey = run internLayoutType(&mut resolver.*, &element)
    let child = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies, Key {
      family: Family.Layout, module: key.module, name: elementKey,
      declaration: usize.ZERO, member: usize.ZERO, external: false,
    }, Span.make(usize.ZERO, usize.ZERO))
    let rejected = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(&child, answerRejection)
    if let Option<Shared<Rejection>>.Some {value} = move rejected {
      return memberRejected(move value, move dependencies)
    }
    let selected = Shared.with<Result<Answer, NoRejection>, Option<usize>>(&child, answerLayoutIndex)
    if let Option<usize>.Some {value: index} = move selected {
      let layouts = Vector.asSlice<Shared<BackendLayout>>(&resolver.layoutValues)
      let metrics = Shared.with<BackendLayout, LayoutMetrics>(&layouts[index], BackendLayout.metrics)
      let computed = BackendLayout.slice(&element, metrics, &resolver.target)
      return run storeLayout(&mut resolver.*, move computed, move dependencies)
    }
    return memberSuccess(Value.LayoutUnsupported, move dependencies)
  }
  // Storage requires a complete canonical member set, independently of source admission.
  let orderedUnion = run Type.canonicalUnionMembers(&ty)
  if let Option<Vector<Shared<Type>>>.Some {value: canonical} = move orderedUnion {
    let mut dependencies = Vector.make<Dependency>()
    let mut inputs = Vector.make<LayoutFieldInput>()
    let listed = Vector.asSlice<Shared<Type>>(&canonical)
    let mut at = usize.ZERO
    while at < listed.length {
      let memberType = Shared.clone<Type>(&listed[at])
      let memberKey = run internLayoutType(&mut resolver.*, &memberType)
      let child = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies, Key {
        family: Family.Layout, module: key.module, name: memberKey,
        declaration: usize.ZERO, member: usize.ZERO, external: false,
      }, Span.make(usize.ZERO, usize.ZERO))
      let rejected = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(&child, answerRejection)
      if let Option<Shared<Rejection>>.Some {value} = move rejected {
        return memberRejected(move value, move dependencies)
      }
      let selected = Shared.with<Result<Answer, NoRejection>, Option<usize>>(&child, answerLayoutIndex)
      let index = match move selected {
        Option<usize>.Some {value} => value
        Option<usize>.None => { return memberSuccess(Value.LayoutUnsupported, move dependencies) }
      }
      let layouts = Vector.asSlice<Shared<BackendLayout>>(&resolver.layoutValues)
      let metrics = Shared.with<BackendLayout, LayoutMetrics>(&layouts[index], BackendLayout.metrics)
      run Vector.append<LayoutFieldInput>(&mut inputs, LayoutFieldInput {ty: move memberType, metrics: metrics})
      at = at + usize.ONE
    }
    let computed = run BackendLayout.tagged(Vector.asSlice<LayoutFieldInput>(&inputs))
    return run storeLayout(&mut resolver.*, move computed, move dependencies)
  }
  // Anonymous aggregates, callable environments and sealed cores have ordinary ordered record
  // storage; a core's fields match the bootstrap's layout (SealedCore).
  let mut structuralFields = run Type.recordFields(&ty)
  let unstructured = match &structuralFields { Option<Vector<Shared<Type>>>.None => true _ => false }
  if unstructured { structuralFields = run SealedCore.fields(&ty) }
  if let Option<Vector<Shared<Type>>>.Some {value: members} = move structuralFields {
    let mut dependencies = Vector.make<Dependency>()
    let mut inputs = Vector.make<LayoutFieldInput>()
    let listed = Vector.asSlice<Shared<Type>>(&members)
    let mut at = usize.ZERO
    while at < listed.length {
      let memberKey = run internLayoutType(&mut resolver.*, &listed[at])
      let child = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies, Key {
        family: Family.Layout, module: key.module, name: memberKey,
        declaration: usize.ZERO, member: usize.ZERO, external: false,
      }, Span.make(usize.ZERO, usize.ZERO))
      let rejected = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(&child, answerRejection)
      if let Option<Shared<Rejection>>.Some {value} = move rejected {
        return memberRejected(move value, move dependencies)
      }
      let selected = Shared.with<Result<Answer, NoRejection>, Option<usize>>(&child, answerLayoutIndex)
      let index = match move selected {
        Option<usize>.Some {value} => value
        Option<usize>.None => { return memberSuccess(Value.LayoutUnsupported, move dependencies) }
      }
      let layouts = Vector.asSlice<Shared<BackendLayout>>(&resolver.layoutValues)
      let metrics = Shared.with<BackendLayout, LayoutMetrics>(&layouts[index], BackendLayout.metrics)
      run Vector.append<LayoutFieldInput>(&mut inputs, LayoutFieldInput {ty: Shared.clone<Type>(&listed[at]), metrics: metrics})
      at = at + usize.ONE
    }
    let computed = run BackendLayout.record(Vector.asSlice<LayoutFieldInput>(&inputs))
    return run storeLayout(&mut resolver.*, move computed, move dependencies)
  }
  let moduleOrdinal = declaringModuleOrdinal(&resolver.*, &ty)
  if moduleOrdinal == usize.MAX {
    return memberSuccess(Value.LayoutUnsupported, Vector.make<Dependency>())
  }
  let module = run resolvedModule(&resolver.*, moduleOrdinal)
  let ordinal = run ordinalOfProvider(&mut resolver.*, &module, &ty)
  let declaration = match move ordinal {
    Option<usize>.Some {value} => value
    Option<usize>.None => { return memberSuccess(Value.LayoutUnsupported, Vector.make<Dependency>()) }
  }
  let written = run header(&mut resolver.*, &module, declaration)
  let writtenHeader = match move written {
    Option<HeaderSyntax>.Some {value} => value
    Option<HeaderSyntax>.None => { return memberSuccess(Value.LayoutUnsupported, Vector.make<Dependency>()) }
  }
  // A scalar enum has exactly its representation's layout (ENUM-003) and keeps nominal identity.
  if let Node.EnumHeader {..} = writtenHeader.header {
    let mut dependencies = Vector.make<Dependency>()
    let selected = run scalarEnumMembers(&mut resolver.*, &mut owner.*, &mut dependencies, moduleOrdinal, declaration, writtenHeader.span)
    let members = match move selected {
      Result<Shared<Result<Answer, NoRejection>>, Shared<Rejection>>.Success {value} => value
      Result<Shared<Result<Answer, NoRejection>>, Shared<Rejection>>.Failure {error} => {
        return memberRejected(move error, move dependencies)
      }
    }
    let representation = Shared.with<Result<Answer, NoRejection>, Option<StaticIntegerType>>(&members, scalarEnumRepresentation)
    if let Option<StaticIntegerType>.Some {value: integer} = move representation {
      let backing = run primitiveType(StaticConstant.integerName(integer))
      let computed = BackendLayout.scalar(&backing, &resolver.target)
      return run storeLayout(&mut resolver.*, move computed, move dependencies)
    }
    return memberSuccess(Value.LayoutUnsupported, move dependencies)
  }
  // A complete nominal-union instance lays out each substituted variant like a record after a
  // declaration-order tag.
  if let Node.UnionHeader {variants, ..} = writtenHeader.header {
    let mut dependencies = Vector.make<Dependency>()
    let nominal = NominalUnion {module: moduleOrdinal, declaration: declaration, count: variants.length}
    let mut records = Vector.make<Shared<BackendLayout>>()
    let mut tag = usize.ZERO
    while tag < nominal.count {
      let shaped = run variantShape(&mut resolver.*, &mut owner.*, &mut dependencies, &module, &ty, &nominal, tag, writtenHeader.span)
      let shape = match move shaped {
        Result<VariantShape, Shared<Rejection>>.Success {value} => value
        Result<VariantShape, Shared<Rejection>>.Failure {error} => { return memberRejected(move error, move dependencies) }
      }
      let fieldTypes = Vector.asSlice<Shared<Type>>(&shape.types)
      let mut inputs = Vector.make<LayoutFieldInput>()
      let mut at = usize.ZERO
      while at < fieldTypes.length {
        let fieldKey = run internLayoutType(&mut resolver.*, &fieldTypes[at])
        let child = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies, Key {
          family: Family.Layout, module: key.module, name: fieldKey,
          declaration: usize.ZERO, member: usize.ZERO, external: false,
        }, writtenHeader.span)
        let rejectedChild = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(&child, answerRejection)
        if let Option<Shared<Rejection>>.Some {value} = move rejectedChild { return memberRejected(move value, move dependencies) }
        let childIndex = Shared.with<Result<Answer, NoRejection>, Option<usize>>(&child, answerLayoutIndex)
        let index = match move childIndex {
          Option<usize>.Some {value} => value
          Option<usize>.None => { return memberSuccess(Value.LayoutUnsupported, move dependencies) }
        }
        let layouts = Vector.asSlice<Shared<BackendLayout>>(&resolver.layoutValues)
        let metrics = Shared.with<BackendLayout, LayoutMetrics>(&layouts[index], BackendLayout.metrics)
        run Vector.append<LayoutFieldInput>(&mut inputs, LayoutFieldInput {ty: Shared.clone<Type>(&fieldTypes[at]), metrics: metrics})
        at = at + usize.ONE
      }
      let record = run BackendLayout.record(Vector.asSlice<LayoutFieldInput>(&inputs))
      match move record {
        Option<BackendLayout>.Some {value} => { run Vector.append<Shared<BackendLayout>>(&mut records, run Shared.make<BackendLayout>(move value)) }
        Option<BackendLayout>.None => { return memberSuccess(Value.LayoutUnsupported, move dependencies) }
      }
      tag = tag + usize.ONE
    }
    let computed = run BackendLayout.variants(Vector.asSlice<Shared<BackendLayout>>(&records), nominal.count)
    return run storeLayout(&mut resolver.*, move computed, move dependencies)
  }
  let mut count = usize.MAX
  if let Node.StructHeader {fields, ..} = writtenHeader.header { count = fields.length }
  if let Node.TupleHeader {elements, ..} = writtenHeader.header { count = elements.length }
  if count == usize.MAX {
    return memberSuccess(Value.LayoutUnsupported, Vector.make<Dependency>())
  }
  let application = run internApplication(&mut resolver.*, &ty)
  let mut dependencies = Vector.make<Dependency>()
  let mut inputs = Vector.make<LayoutFieldInput>()
  let mut at = usize.ZERO
  while at < count {
    let shaped = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies, Key {
      family: Family.MemberShape, module: moduleOrdinal, name: application,
      declaration: declaration, member: at, external: false,
    }, writtenHeader.span)
    let rejected = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(&shaped, answerRejection)
    if let Option<Shared<Rejection>>.Some {value} = move rejected {
      return memberRejected(move value, move dependencies)
    }
    let field = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(&shaped, singleMemberType)
    let fieldType = match move field {
      Option<Shared<Type>>.Some {value} => value
      Option<Shared<Type>>.None => { return memberSuccess(Value.LayoutUnsupported, move dependencies) }
    }
    let fieldKey = run internLayoutType(&mut resolver.*, &fieldType)
    let child = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies, Key {
      family: Family.Layout, module: key.module, name: fieldKey,
      declaration: usize.ZERO, member: usize.ZERO, external: false,
    }, writtenHeader.span)
    let rejectedChild = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(&child, answerRejection)
    if let Option<Shared<Rejection>>.Some {value} = move rejectedChild {
      return memberRejected(move value, move dependencies)
    }
    let childIndex = Shared.with<Result<Answer, NoRejection>, Option<usize>>(&child, answerLayoutIndex)
    let index = match move childIndex {
      Option<usize>.Some {value} => value
      Option<usize>.None => { return memberSuccess(Value.LayoutUnsupported, move dependencies) }
    }
    let layouts = Vector.asSlice<Shared<BackendLayout>>(&resolver.layoutValues)
    let metrics = Shared.with<BackendLayout, LayoutMetrics>(&layouts[index], BackendLayout.metrics)
    run Vector.append<LayoutFieldInput>(&mut inputs, LayoutFieldInput {ty: move fieldType, metrics: metrics})
    at = at + usize.ONE
  }
  let computed = run BackendLayout.record(Vector.asSlice<LayoutFieldInput>(&inputs))
  return run storeLayout(&mut resolver.*, move computed, move dependencies)
}

/// One runtime type needed by a MIR local or projected operand.
pub struct LayoutDemand {
  pub ty: Shared<Type>
  pub span: Span
}

fn dereferencedType(value: &Type) -> Option<Shared<Type>> {
  return match & value.* {
    Type.Reference {referent, ..} => Option.some<Shared<Type>>(Shared.clone<Type>(&referent))
    Type.Pointer {pointee, ..} => Option.some<Shared<Type>>(Shared.clone<Type>(&pointee))
    _ => Option.none<Shared<Type>>()
  }
}

effect fn appendProjectedLayoutDemands(
  function: &MirFunction,
  place: &MirPlace,
  span: Span,
  needed: &mut Vector<LayoutDemand>,
) -> () ! OutOfMemoryError ? &mut Allocator {
  let locals = Vector.asSlice<MirLocal>(&function.locals)
  let mut ty = Shared.clone<Type>(&locals[place.local].ty)
  let projections = Vector.asSlice<MirProjection>(&place.projections)
  let mut at = usize.ZERO
  while at < projections.length {
    match & projections[at] {
      MirProjection.Deref => ()
      _ => {
        return ()
      }
    }
    let pointee = Shared.with<Type, Option<Shared<Type>>>(&ty, dereferencedType)
    ty = match move pointee {
      Option<Shared<Type>>.Some {value} => value
      Option<Shared<Type>>.None => {
        return ()
      }
    }
    run Vector.append<LayoutDemand>(
      &mut needed.*,
      LayoutDemand {ty: Shared.clone<Type>(&ty), span: span},
    )
    at = at + usize.ONE
  }
  return ()
}

effect fn appendOperandLayoutDemands(function: &MirFunction, operand: &MirOperand, span: Span, needed: &mut Vector<LayoutDemand>) -> ()
! OutOfMemoryError ? &mut Allocator {
  match &operand.* {
    MirOperand.Copy {place} => run appendProjectedLayoutDemands(function, &place, span, &mut needed.*)
    MirOperand.Move {place} => run appendProjectedLayoutDemands(function, &place, span, &mut needed.*)
    _ => ()
  }
  return ()
}

// Projected loads, stores, and address formation of an assignment depend on referent layouts.
effect fn appendStatementLayoutDemands(
  function: &MirFunction,
  statement: &MirStatement,
  needed: &mut Vector<LayoutDemand>,
) -> () ! OutOfMemoryError ? &mut Allocator {
  if let MirStatement.Assign {destination, value, origin} = &statement.* {
    run appendProjectedLayoutDemands(function, &destination, origin.span, &mut needed.*)
    match & value {
      MirRvalue.Ref {place, ..} => run appendProjectedLayoutDemands(
        function,
        &place,
        origin.span,
        &mut needed.*,
      )
      MirRvalue.Slice {data, count} => {
        run appendOperandLayoutDemands(function, &data, origin.span, &mut needed.*)
        run appendOperandLayoutDemands(function, &count, origin.span, &mut needed.*)
      }
      MirRvalue.Convert {value: operand, ..} => run appendOperandLayoutDemands(function, &operand, origin.span, &mut needed.*)
      MirRvalue.Fits {value: operand, ..} => run appendOperandLayoutDemands(function, &operand, origin.span, &mut needed.*)
      MirRvalue.ScalarUnary {value: operand, ..} => run appendOperandLayoutDemands(function, &operand, origin.span, &mut needed.*)
      MirRvalue.ScalarBinary {left, right, ..} => {
        run appendOperandLayoutDemands(function, &left, origin.span, &mut needed.*)
        run appendOperandLayoutDemands(function, &right, origin.span, &mut needed.*)
      }
      MirRvalue.AddressIntegerConversion {operand, ..} => run appendOperandLayoutDemands(function, &operand, origin.span, &mut needed.*)
      MirRvalue.SliceLength {place} => run appendProjectedLayoutDemands(function, &place, origin.span, &mut needed.*)
      MirRvalue.SliceData {place} => run appendProjectedLayoutDemands(function, &place, origin.span, &mut needed.*)
      MirRvalue.PointerOffset {element, ..} => run Vector.append<LayoutDemand>(
        &mut needed.*,
        LayoutDemand {ty: Shared.clone<Type>(&element), span: origin.span},
      )
      MirRvalue.Discriminant {place} => run appendProjectedLayoutDemands(function, &place, origin.span, &mut needed.*)
      MirRvalue.AddressOf {place, ..} => run appendProjectedLayoutDemands(
        function,
        &place,
        origin.span,
        &mut needed.*,
      )
      MirRvalue.Use {value: operand} => run appendOperandLayoutDemands(function, &operand, origin.span, &mut needed.*)
      _ => ()
    }
  }
  // A drop forms the address of its place before calling the place type's glue.
  if let MirStatement.Drop {destination, origin, ..} = &statement.* {
    run appendProjectedLayoutDemands(function, &destination, origin.span, &mut needed.*)
  }
  return ()
}

/// Collects complete local and projected-place layout demands for an ordinary MIR body.
pub effect fn mirLayoutDemands(function: &MirFunction) -> Vector<LayoutDemand>
! OutOfMemoryError ? &mut Allocator {
  let locals = Vector.asSlice<MirLocal>(&function.locals)
  let mut copied = Vector.make<LayoutDemand>()
  let mut at = usize.ZERO
  while at < locals.length {
    run Vector.append<LayoutDemand>(
      &mut copied,
      LayoutDemand {ty: Shared.clone<Type>(&locals[at].ty), span: locals[at].origin.span},
    )
    at = at + usize.ONE
  }
  // Projected loads, stores, and address formation also depend on their referent layouts.
  let blocks = Vector.asSlice<MirBlock>(&function.blocks)
  let mut blockAt = usize.ZERO
  while blockAt < blocks.length {
    let statements = Vector.asSlice<MirStatement>(&blocks[blockAt].statements)
    let mut statementAt = usize.ZERO
    while statementAt < statements.length {
      run appendStatementLayoutDemands(function, &statements[statementAt], &mut copied)
      statementAt = statementAt + usize.ONE
    }
    blockAt = blockAt + usize.ONE
  }
  return move copied
}

effect fn copyMirLocalTypes(resolver: &Resolver, index: usize) -> Vector<LayoutDemand>
! OutOfMemoryError ? &mut Allocator {
  let functions = Vector.asSlice<MirFunction>(&resolver.mirValues)
  return run mirLayoutDemands(&functions[index])
}

// The admitted foreign-contract subset narrows only capture: one `Intrinsic.foreign(noCapture:
// (...))` field naming distinct written raw-pointer parameters. It creates no loan, so lowering may
// omit the hint. Every other property remains a foreign-contract gap.
fn admittedForeignProperties(hir: &Module, properties: Range, parameters: Range) -> bool {
  let mut fields = usize.ZERO
  let mut at = usize.ZERO
  while at < properties.length {
    if let Node.PropertyClause {namespace, operation, properties: written} = Module.node(hir, Module.child(hir, properties, at)) {
      if !nameIs(hir, namespace, b"Intrinsic") || !nameIs(hir, operation, b"foreign") { return false }
      let mut field = usize.ZERO
      while field < written.length {
        if let Node.Property {name, value} = Module.node(hir, Module.child(hir, written, field)) {
          if !nameIs(hir, name, b"noCapture") || !capturesPointerParameters(hir, value, parameters) { return false }
        } else {
          return false
        }
        fields = fields + usize.ONE
        field = field + usize.ONE
      }
    } else {
      return false
    }
    at = at + usize.ONE
  }
  return fields <= usize.ONE
}

// A callable header's admitted properties: none, or one field-free `Intrinsic.nonParking()`.
// Before the suspension stage, any parking the body reaches is itself the `suspension` gap at that
// site, so the declaration adds no unchecked obligation (D6). Every other property is a gap.
fn nonParkingProperties(hir: &Module, properties: Range) -> bool {
  if properties.length == usize.ZERO { return true }
  if properties.length != usize.ONE { return false }
  if let Node.PropertyClause {namespace, operation, properties: written} = Module.node(hir, Module.child(hir, properties, usize.ZERO)) {
    return nameIs(hir, namespace, b"Intrinsic") && nameIs(hir, operation, b"nonParking") && written.length == usize.ZERO
  }
  return false
}

fn nameIs(hir: &Module, id: HirId, spelling: &[u8]) -> bool {
  return match Module.node(hir, id) {
    Node.Name {text} => same(Module.text(hir, text), spelling)
    _ => false
  }
}

fn capturesPointerParameters(hir: &Module, value: HirId, parameters: Range) -> bool {
  if let Node.TupleExpression {elements} = Module.node(hir, value) {
    let mut at = usize.ZERO
    while at < elements.length {
      let element = Module.child(hir, elements, at)
      if let Node.TextLiteral {value: text} = Module.node(hir, element) {
        if !pointerParameterNamed(hir, parameters, Module.text(hir, text)) { return false }
        let mut earlier = usize.ZERO
        while earlier < at {
          if let Node.TextLiteral {value: previous} = Module.node(hir, Module.child(hir, elements, earlier)) {
            if same(Module.text(hir, previous), Module.text(hir, text)) { return false }
          }
          earlier = earlier + usize.ONE
        }
      } else {
        return false
      }
      at = at + usize.ONE
    }
    return true
  }
  return false
}

fn pointerParameterNamed(hir: &Module, parameters: Range, spelling: &[u8]) -> bool {
  let mut at = usize.ZERO
  while at < parameters.length {
    if let Node.Parameter {name, annotation, ..} = Module.node(hir, Module.child(hir, parameters, at)) {
      if nameIs(hir, name, spelling) {
        return match Module.node(hir, annotation) {
          Node.PointerType {..} => true
          _ => false
        }
      }
    }
    at = at + usize.ONE
  }
  return false
}

struct ForeignHeader {
  symbol: Bytes
  gap: Option<GapCode>
  span: Span
  /// Whether the linkage defines this declaration for C callers (`export`) rather than importing it.
  exported: bool
  /// Whether the declaration is a C object (`static`) rather than a function.
  global: bool
}

// Classifies one linked function or static header. A function import must be `unsafe`; an export
// is an ordinary definition whose C lanes are checked separately. Both admit only the C ABI, no
// generic, effect or static contract, and no callback lane. Variadic imports have fixed parameters
// followed by integer-only call-local tails. A static admits no
// linkage properties.
effect fn foreignHeader(resolver: &mut Resolver, module: &ModuleId, ordinal: usize) -> ForeignHeader
! Cycle | OutOfMemoryError ? &mut Allocator {
  let observed = run source(&mut resolver.*, module)
  if let Option<&IndexedSource>.Some {value} = move sourceOf(&resolver.*, &observed, module) {
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(value))
    let hir = IndexedSource.authored(value)
    if ordinal < declarations.length {
      let span = Module.span(hir, declarations[ordinal].header)
      if let Node.StaticHeader {name, linkage, properties, ..} = Module.node(hir, declarations[ordinal].header) {
        if let Node.Linkage {direction, abi, symbol} = Module.node(hir, linkage) {
          let mut symbolName = Bytes.make()
          if let Node.Name {text} = Module.node(hir, name) { symbolName = run Bytes.copy(Module.text(hir, text)) }
          if symbol.present {
            if let Node.TextLiteral {value: text} = Module.node(hir, symbol.id) { symbolName = run Bytes.copy(Module.text(hir, text)) }
          }
          let mut gap = Option.none<GapCode>()
          if properties.length > usize.ZERO { gap = Option.some<GapCode>(GapCode.ForeignContract) }
          let mut c = false
          if let Node.TextLiteral {value: text} = Module.node(hir, abi) { c = same(Module.text(hir, text), b"C") }
          if !c { gap = Option.some<GapCode>(GapCode.ForeignAbi) }
          return ForeignHeader {symbol: move symbolName, gap: move gap, span: span, exported: direction == LinkageDirection.Export, global: true}
        }
      }
      if let Node.FunctionHeader {name, contract, linkage, properties, ..} = Module.node(hir, declarations[ordinal].header) {
        if linkage.present {
          if let Node.Linkage {direction, abi, symbol} = Module.node(hir, linkage.id) {
            let exported = direction == LinkageDirection.Export
            let mut symbolName = Bytes.make()
            if let Node.Name {text} = Module.node(hir, name) { symbolName = run Bytes.copy(Module.text(hir, text)) }
            if symbol.present {
              if let Node.TextLiteral {value: text} = Module.node(hir, symbol.id) { symbolName = run Bytes.copy(Module.text(hir, text)) }
            }
            let mut gap = Option.none<GapCode>()
            if let Node.CallableContract {variadic, generics, parameters, result, isEffect, isStatic, isUnsafe, ..} = Module.node(hir, contract) {
              if !admittedForeignProperties(hir, properties, parameters) { gap = Option.some<GapCode>(GapCode.ForeignContract) }
              let mut at = usize.ZERO
              while at < parameters.length {
                if let Node.Parameter {annotation, ..} = Module.node(hir, Module.child(hir, parameters, at)) {
                  if let Node.ForeignFunctionType {..} = Module.node(hir, annotation) {
                    gap = Option.some<GapCode>(GapCode.CAbiCallback)
                  }
                }
                at = at + usize.ONE
              }
              if result.present {
                if let Node.ForeignFunctionType {..} = Module.node(hir, result.id) {
                  gap = Option.some<GapCode>(GapCode.CAbiCallback)
                }
              }
              if variadic && (exported || parameters.length == usize.ZERO) { gap = Option.some<GapCode>(GapCode.CAbiVariadic) }
              if variadic {
                if let Node.Declaration {body: definition, ..} = Module.node(hir, declarations[ordinal].local) {
                  if let Node.CallableBody {block} = Module.node(hir, definition) {
                    if block.present { gap = Option.some<GapCode>(GapCode.CAbiVariadic) }
                  }
                }
              }
              if generics.length > usize.ZERO || isEffect || isStatic || (!isUnsafe && !exported) {
                gap = Option.some<GapCode>(GapCode.ForeignContract)
              }
            }
            let mut c = false
            if let Node.TextLiteral {value: text} = Module.node(hir, abi) { c = same(Module.text(hir, text), b"C") }
            if !c { gap = Option.some<GapCode>(GapCode.ForeignAbi) }
            return ForeignHeader {symbol: move symbolName, gap: move gap, span: span, exported: exported, global: false}
          }
        }
      }
    }
  }
  return ForeignHeader {symbol: Bytes.make(), gap: Option.some<GapCode>(GapCode.ForeignAbi), span: Span.make(usize.ZERO, usize.ZERO), exported: false, global: false}
}

fn backendUnit(layout: LayoutMetrics) -> bool {
  return match layout.abi { BackendAbi.Unit => true
    _ => false
  }
}

fn layoutIndex(answer: &Result<Answer, NoRejection>) -> Option<usize> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Layout {index}} => Option.some<usize>(index)
      _ => Option.none<usize>()
    }
    _ => Option.none<usize>()
  }
}

effect fn foreignLane(resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>, dependencies: &mut Vector<Dependency>, ty: &Shared<Type>, declaration: &Shared<DeclarationId>, span: Span) -> CAbi.Lane
! BackendGap | Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  if !CAbi.supported(&resolver.target) { fail BackendGap.make(GapCode.CAbiTarget, declaration, span) }
  let callback = Shared.with<Type, bool>(ty, fn(value: &Type) -> bool {
    return match & value.* {
      Type.Callable {..} => true
      _ => false
    }
  })
  if callback { fail BackendGap.make(GapCode.CAbiCallback, declaration, span) }
  if !Shared.with<Type, bool>(ty, CAbi.admit) { fail BackendGap.make(GapCode.ForeignContract, declaration, span) }
  let application = run internLayoutType(&mut resolver.*, ty)
  let layout = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, Key {family: Family.Layout, module: usize.ZERO, name: application, declaration: usize.ZERO, member: usize.ZERO, external: false}, span)
  let selected = Shared.with<Result<Answer, NoRejection>, Option<usize>>(&layout, layoutIndex)
  if let Option<usize>.Some {value} = move selected {
    let layouts = Vector.asSlice<Shared<BackendLayout>>(&resolver.layoutValues)
    let facts = Shared.with<BackendLayout, LayoutMetrics>(&layouts[value], BackendLayout.metrics)
    let lane = CAbi.classify(ty, facts, &resolver.target)
    if let Option<CAbi.Lane>.Some {value: classified} = move lane { return move classified }
  }
  fail BackendGap.make(GapCode.CAbiAggregate, declaration, span)
}

effect fn copyMirExterns(resolver: &Resolver, index: usize) -> Vector<Shared<DeclarationId>> ! OutOfMemoryError ? &mut Allocator {
  let functions = Vector.asSlice<MirFunction>(&resolver.mirValues)
  let entries = Vector.asSlice<Shared<DeclarationId>>(&functions[index].externs)
  let mut copied = Vector.make<Shared<DeclarationId>>()
  let mut at = usize.ZERO
  while at < entries.length {
    run Vector.append<Shared<DeclarationId>>(&mut copied, Shared.clone<DeclarationId>(&entries[at]))
    at = at + usize.ONE
  }
  return move copied
}

effect fn foreignSignature(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  declaration: &Shared<DeclarationId>,
) -> CAbi.Signature
! BackendGap | Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  // The C allocator functions the storage primitives expand to have compiler-owned signatures.
  let sealed = Shared.with<DeclarationId, Option<SealedFunction>>(declaration, SealedCore.declarationFunction)
  if let Option<SealedFunction>.Some {value: selected} = move sealed {
    let span = Span.make(usize.ZERO, usize.ZERO)
    let resultType = run SealedCore.cResult(selected)
    let result = run foreignLane(&mut resolver.*, &mut owner.*, &mut dependencies.*, &resultType, declaration, span)
    let written = run SealedCore.cParameters(selected)
    let listed = Vector.asSlice<Shared<Type>>(&written)
    let mut lanes = Vector.make<CAbi.Lane>()
    let mut at = usize.ZERO
    while at < listed.length {
      run Vector.append<CAbi.Lane>(&mut lanes, run foreignLane(&mut resolver.*, &mut owner.*, &mut dependencies.*, &listed[at],
        declaration, span))
      at = at + usize.ONE
    }
    return CAbi.Signature {declaration: Shared.clone<DeclarationId>(declaration), symbol: run Bytes.copy(SealedCore.cSymbol(selected)),
      span: span, result: move result, parameters: move lanes, global: false, variadic: false}
  }
  let key = run InstanceKey.named(declaration)
  let found = run locationOfInstance(&mut resolver.*, &key)
  let location = match move found {
    Option<InstanceLocation>.Some {value} => value
    Option<InstanceLocation>.None => {
      fail BackendGap.make(GapCode.CalleeModule, declaration, Span.make(usize.ZERO, usize.ZERO))
    }
  }
  let module = run resolvedModule(&resolver.*, location.module)
  let written = run foreignHeader(&mut resolver.*, &module, location.declaration)
  // A Silk call to an exported definition is not a C import; it keeps a named gap.
  if written.exported { fail BackendGap.make(GapCode.ForeignExport, declaration, written.span) }
  return run cSignature(&mut resolver.*, &mut owner.*, &mut dependencies.*, declaration, location, move written)
}

// Classifies the C lanes of one linked function whose header admitted the C contract.
effect fn cSignature(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  declaration: &Shared<DeclarationId>,
  location: InstanceLocation,
  written: ForeignHeader,
) -> CAbi.Signature
! BackendGap | Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  if let Option<GapCode>.Some {value} = move written.gap {
    fail BackendGap.make(value, declaration, written.span)
  }
  if written.global {
    // A C object has one lane: the value its address holds.
    let selected = run foreignStaticType(&mut resolver.*, &mut owner.*, &mut dependencies.*, location.module, location.declaration, written.span)
    let objectType = match move selected {
      Result<Shared<Type>, Shared<Rejection>>.Success {value} => value
      Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { fail BackendGap.fromRejection(GapCode.ForeignStatic, declaration, &error) }
    }
    let object = run foreignLane(&mut resolver.*, &mut owner.*, &mut dependencies.*, &objectType, declaration, written.span)
    return CAbi.Signature {
      declaration: Shared.clone<DeclarationId>(declaration),
      symbol: move written.symbol,
      span: written.span,
      result: move object,
      parameters: Vector.make<CAbi.Lane>(),
      global: true,
      variadic: false,
    }
  }
  let signature = run demandChild(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies.*,
    Key {
      family: Family.Signature,
      module: location.module,
      name: usize.ZERO,
      declaration: location.declaration,
      member: usize.ZERO,
      external: false,
    },
    written.span,
  )
  let selected = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
    &signature,
    signatureResult,
  )
  let resultType = match move selected {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => {
      fail BackendGap.make(GapCode.SignatureForm, declaration, written.span)
    }
  }
  let result = run foreignLane(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies.*,
    &resultType,
    declaration,
    written.span,
  )
  let mut parameters = Vector.make<CAbi.Lane>()
  let count = Shared.with<Result<Answer, NoRejection>, usize>(&signature, signatureParameterCount)
  let mut at = usize.ZERO
  while at < count {
    let selected = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
      &signature,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> {
        return signatureParameterAt(answer, at)
      },
    )
    if let Option<Shared<Type>>.Some {value} = move selected {
      let lane = run foreignLane(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies.*,
        &value,
        declaration,
        written.span,
      )
      if backendUnit(lane.layout) {
        fail BackendGap.make(GapCode.UnitParameter, declaration, written.span)
      }
      run Vector.append<CAbi.Lane>(&mut parameters, move lane)
    }
    at = at + usize.ONE
  }
  return CAbi.Signature {
    declaration: Shared.clone<DeclarationId>(declaration),
    symbol: move written.symbol,
    span: written.span,
    result: move result,
    parameters: move parameters,
    global: false,
    variadic: Shared.with<Result<Answer, NoRejection>, bool>(&signature, signatureIsVariadic),
  }
}

struct EmissionInputs {
  mir: usize
  layouts: Vector<TypeLayout>
  foreign: Vector<CAbi.Signature>
  llvm: usize
  /// The instance's own canonical encoding, kept for its definition; callee encodings are content
  /// input only.
  encoding: Bytes
  identities: Vector<InstanceIdentity>
  /// The facts of a suspendable instance, which make its definition a coroutine.
  suspension: Option<CoroutineFacts>
}

// Content subjects retain the latest validated preparation. Successful text answers are immutable;
// gaps retain source evidence so a retry uses current origins after an edit. A subject is named by
// the SHA-256 digest of its exact content encoding; the encoding itself is not retained.
struct LlvmInput {
  digest: [u8; 32]
  emission: usize
  dependencies: Vector<Dependency>
  observations: Vector<Shared<Observation>>
}

fn layoutDemandAt(types: &Vector<LayoutDemand>, index: usize) -> LayoutDemand {
  let entries = Vector.asSlice<LayoutDemand>(types)
  return LayoutDemand {ty: Shared.clone<Type>(&entries[index].ty), span: entries[index].span}
}

effect fn copyEmissionDependencies(values: &[Dependency]) -> Vector<Dependency>
! OutOfMemoryError
? &mut Allocator {
  let mut result = Vector.make<Dependency>()
  run Vector.reserveExact<Dependency>(&mut result, values.length)
  let mut at = usize.ZERO
  while at < values.length {
    run Vector.append<Dependency>(&mut result, values[at])
    at = at + usize.ONE
  }
  return move result
}

effect fn appendSignatureContent(
  output: &mut Bytes,
  signature: &Shared<Result<Answer, NoRejection>>,
  declaration: &DeclarationId,
  coordinates: &mut Coordinates,
) -> () ! OutOfMemoryError ? &mut Allocator {
  let count = Shared.with<Result<Answer, NoRejection>, usize>(signature, signatureParameterCount)
  run RuntimeEncoding.word(&mut output.*, usize.toU64(count))
  let mut at = usize.ZERO
  while at < count {
    let selected = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
      signature,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> {
        return signatureParameterAt(answer, at)
      },
    )
    if let Option<Shared<Type>>.Some {value} = move selected {
      let encoded = run Type.encoding(&value, declaration, true, &mut coordinates.*)
      run RuntimeEncoding.field(&mut output.*, Bytes.asSlice(&encoded))
    }
    at = at + usize.ONE
  }
  let selected = Shared.with<Result<Answer, NoRejection>, Option<SignatureFacts>>(
    signature,
    signatureFacts,
  )
  if let Option<SignatureFacts>.Some {value: facts} = move selected {
    let result = run Type.encoding(&facts.result, declaration, true, &mut coordinates.*)
    let failure = run Type.encoding(&facts.failure, declaration, true, &mut coordinates.*)
    let required = run Row.encoding(&facts.requirements, declaration, true, &mut coordinates.*)
    run RuntimeEncoding.field(&mut output.*, Bytes.asSlice(&result))
    run RuntimeEncoding.field(&mut output.*, Bytes.asSlice(&failure))
    run RuntimeEncoding.field(&mut output.*, Bytes.asSlice(&required))
  }
  return ()
}

// Read headers and signature answers only. This terminates for recursive instance references.
effect fn emissionSignatureContent(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  callees: &[InstanceKey],
  coordinates: &mut Coordinates,
) -> Bytes ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let mut result = Bytes.make()
  let mut at = usize.ZERO
  while at < callees.length {
    if let InstanceKey.Function {..} = &callees[at] {
      let located = run locationOfInstance(&mut resolver.*, &callees[at])
      if let Option<InstanceLocation>.Some {value: location} = move located {
        let signature = run demandChild(
          &mut resolver.*,
          &mut owner.*,
          &mut dependencies.*,
          Key {
            family: Family.Signature,
            module: location.module,
            name: usize.ZERO,
            declaration: location.declaration,
            member: usize.ZERO,
            external: false,
          },
          Span.make(usize.ZERO, usize.ZERO),
        )
        let identityHandle = InstanceKey.identity(&callees[at])
        let identity = run DeclarationId.copyShared(&identityHandle)
        run appendSignatureContent(&mut result, &signature, &identity, &mut coordinates.*)
        // Header syntax also covers written binders, bounds, static slots and Effect channels.
        let module = run resolvedModule(&resolver.*, location.module)
        let loaded = run source(&mut resolver.*, &module)
        if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(
          &resolver.*,
          &loaded,
          &module,
        ) {
          let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(indexed))
          let bytes = run Fingerprint.header(
            IndexedSource.authored(indexed),
            declarations[location.declaration].header,
          )
          run RuntimeEncoding.field(&mut result, Vector.asSlice<u8>(&bytes))
        }
      }
    }
    at = at + usize.ONE
  }
  return move result
}

// Local proof ordinals are module HIR indices. Resolve only their enclosing declaration headers
// and encode relative coordinates, so an earlier sibling body cannot rename these instances.
effect fn resolveInstanceCoordinates(resolver: &mut Resolver, coordinates: &mut Coordinates) -> ()
! Cycle | OutOfMemoryError
? &mut Allocator {
  let mut at = usize.ZERO
  while at < Vector.length<RuntimeEncoding.LocalOrigin>(&coordinates.origins) {
    let entries = Vector.asSlice<RuntimeEncoding.LocalOrigin>(&coordinates.origins)
    let identity = run DeclarationId.copy(&entries[at].owner)
    let module = run ModuleId.copy(DeclarationId.moduleId(&identity))
    let loaded = run source(&mut resolver.*, &module)
    let mut base = Option.none<usize>()
    if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(
      &resolver.*,
      &loaded,
      &module,
    ) {
      let index = IndexedSource.moduleIndex(indexed)
      if let Option<usize>.Some {value: enclosing} = move ModuleIndex.deepestPrefixOf(index, &identity) {
        let declarations = ModuleIndex.listDeclarations(index)
        base = Option.some<usize>(declarations[enclosing].header.index)
      }
    }
    let mut current = Vector.asMutSlice<RuntimeEncoding.LocalOrigin>(&mut coordinates.origins)
    current[at].base = move base
    at = at + usize.ONE
  }
  return ()
}

effect fn internLlvmInput(
  resolver: &mut Resolver,
  emission: usize,
  content: Bytes,
  dependencies: &[Dependency],
) -> usize ! OutOfMemoryError ? &mut Allocator {
  let mut observations = Vector.make<Shared<Observation>>()
  let frames = Vector.asSlice<SourceFrame>(&resolver.frames)
  let source = Vector.asSlice<Shared<Observation>>(&frames[frames.length - usize.ONE].observations)
  let mut at = usize.ZERO
  while at < source.length {
    run Vector.append<Shared<Observation>>(
      &mut observations,
      Shared.clone<Observation>(&source[at]),
    )
    at = at + usize.ONE
  }
  let copied = run copyEmissionDependencies(dependencies)
  let hashed = InternIndex.hashBytes(0, Bytes.asSlice(&content))
  let digest = Sha256.hash(Bytes.asSlice(&content))
  drop content
  let inputs = Vector.asSlice<LlvmInput>(&resolver.llvmInputs)
  at = InternIndex.first(&resolver.llvmInputLookup, hashed)
  while at != usize.MAX {
    if sameDigest(inputs[at].digest, digest) {
      break
    }
    at = InternIndex.after(&resolver.llvmInputLookup, at)
  }
  if at != usize.MAX {
    // Equal successful content keeps its completed answer. A source-validated gap retries
    // with the latest origins and dependency evidence after an edit.
    let current = Vector.asMutSlice<LlvmInput>(&mut resolver.llvmInputs)
    current[at].emission = emission
    current[at].dependencies = move copied
    current[at].observations = move observations
  } else {
    at = Vector.length<LlvmInput>(&resolver.llvmInputs)
    run Vector.append<LlvmInput>(
      &mut resolver.llvmInputs,
      LlvmInput {
        digest: digest,
        emission: emission,
        dependencies: move copied,
        observations: move observations,
      },
    )
    run InternIndex.record(&mut resolver.llvmInputLookup, hashed)
  }
  return at
}

effect fn observeLlvmGap(resolver: &mut Resolver, subject: usize) -> ()
! OutOfMemoryError
? &mut Allocator {
  let inputs = Vector.asSlice<LlvmInput>(&resolver.llvmInputs)
  let observations = Vector.asSlice<Shared<Observation>>(&inputs[subject].observations)
  let mut frames = Vector.asMutSlice<SourceFrame>(&mut resolver.frames)
  let mut frame = &mut frames[frames.length - usize.ONE]
  let mut at = usize.ZERO
  while at < observations.length {
    run appendObservation(&mut frame.*, &observations[at])
    at = at + usize.ONE
  }
  return ()
}

// Pure query over a complete immutable content subject. Its dependency ledger records the
// prepared MIR/layout/signature facts; its validity follows from content, not source revisions.
effect fn resolveLlvmText(resolver: &mut Resolver, key: Key) -> Answer
! OutOfMemoryError
? &mut Allocator {
  let subjects = Vector.asSlice<LlvmInput>(&resolver.llvmInputs)
  let subject = &subjects[key.name]
  let inputs = Vector.asSlice<EmissionInputs>(&resolver.emissionInputs)
  let input = &inputs[subject.emission]
  let functions = Vector.asSlice<MirFunction>(&resolver.mirValues)
  let function = &functions[input.mir]
  let dependencies = run copyEmissionDependencies(Vector.asSlice<Dependency>(&subject.dependencies))
  let emitted = run Effect.result(
    LlvmText.emit(
      function,
      &resolver.target,
      Vector.asSlice<TypeLayout>(&input.layouts),
      Vector.asSlice<CAbi.Signature>(&input.foreign),
      Vector.asSlice<InstanceIdentity>(&input.identities),
      &input.suspension,
    ),
  )
  let text = match move emitted {
    Result<Bytes, BackendGap | OutOfMemoryError>.Success {value} => move value
    Result<Bytes, BackendGap | OutOfMemoryError>.Failure {error} => match move error {
      BackendGap {code, owner, source} => {
        let gap = run Shared.make<BackendGap>(
          BackendGap {code: code, owner: move owner, source: move source},
        )
        run observeLlvmGap(&mut resolver.*, key.name)
        return memberSuccess(Value.Unsupported {gap: move gap}, move dependencies)
      }
      OutOfMemoryError {} => {
        fail OutOfMemoryError {}
      }
    }
  }
  let foreign = run Effect.result(
    LlvmText.foreignDeclarations(Vector.asSlice<CAbi.Signature>(&input.foreign)),
  )
  let declarations = match move foreign {
    Result<Vector<LlvmText.Declaration>, BackendGap | OutOfMemoryError>.Success {value} => move value
    Result<Vector<LlvmText.Declaration>, BackendGap | OutOfMemoryError>.Failure {error} => match move error {
      BackendGap {code, owner, source} => {
        let gap = run Shared.make<BackendGap>(
          BackendGap {code: code, owner: move owner, source: move source},
        )
        run observeLlvmGap(&mut resolver.*, key.name)
        return memberSuccess(Value.Unsupported {gap: move gap}, move dependencies)
      }
      OutOfMemoryError {} => {
        fail OutOfMemoryError {}
      }
    }
  }
  let identities = Vector.asSlice<InstanceIdentity>(&input.identities)
  let value = InstanceDefinition {
    encoding: run Bytes.copy(Bytes.asSlice(&input.encoding)),
    symbol: run Bytes.copy(Bytes.asSlice(&identities[usize.ZERO].symbol)),
    text: move text,
    foreign: move declarations,
    safetyChecked: function.safetyChecked,
  }
  let index = Vector.length<InstanceDefinition>(&resolver.llvmValues)
  run Vector.append<InstanceDefinition>(&mut resolver.llvmValues, move value)
  return memberSuccess(Value.LlvmText {index: index}, move dependencies)
}

effect fn demandPreparedText(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  key: Key,
  prepared: &Shared<Result<Answer, NoRejection>>,
) -> Shared<Result<Answer, NoRejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let index = Shared.with<Result<Answer, NoRejection>, Option<usize>>(
    prepared,
    answerEmissionInputsIndex,
  )
  if let Option<usize>.Some {value} = move index {
    let inputs = Vector.asSlice<EmissionInputs>(&resolver.emissionInputs)
    let content = inputs[value].llvm
    return run demandRaw(
      &mut resolver.*,
      &mut owner.*,
      Key {
        family: Family.LlvmText,
        module: key.module,
        name: content,
        declaration: key.declaration,
        member: key.member,
        external: false,
      },
      Span.make(usize.ZERO, usize.ZERO),
    )
  }
  return Shared.clone<Result<Answer, NoRejection>>(prepared)
}

effect fn resolveEmissionInputs(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  key: Key,
) -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let module = run resolvedModule(&resolver.*, key.module)
  let mut dependencies = Vector.make<Dependency>()
  let variants = Vector.asSlice<BackendInstance>(&resolver.backendInstances)
  let variantKey = InstanceKey.copy(&variants[key.name].key)
  let variantObserving = variants[key.name].observing
  let suspension = run copySuspension(&variants[key.name].suspension)
  let lowered = run internBackendInstance(&mut resolver.*, &variantKey, variantObserving)
  let mir = run demandChild(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies,
    Key {
      family: Family.Mir,
      module: key.module,
      name: lowered,
      declaration: key.declaration,
      member: key.member,
      external: false,
    },
    Span.make(usize.ZERO, usize.ZERO),
  )
  let canonicalFailure = Shared.with<Result<Answer, NoRejection>, Option<CanonicalizationFailure>>(&mir, answerCanonicalizationFailure)
  if let Option<CanonicalizationFailure>.Some {value: reason} = move canonicalFailure {
    return memberSuccess(Value.CanonicalizationFailed {reason: reason}, move dependencies)
  }
  let rejected = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
    &mir,
    answerRejection,
  )
  if let Option<Shared<Rejection>>.Some {value} = move rejected {
    return memberRejected(move value, move dependencies)
  }
  let gap = Shared.with<Result<Answer, NoRejection>, Option<Shared<BackendGap>>>(
    &mir,
    answerBackendGap,
  )
  if let Option<Shared<BackendGap>>.Some {value} = move gap {
    return memberSuccess(Value.Unsupported {gap: move value}, move dependencies)
  }
  let selected = Shared.with<Result<Answer, NoRejection>, Option<usize>>(&mir, answerMirIndex)
  let mirIndex = match move selected {
    Option<usize>.Some {value} => value
    Option<usize>.None => {
      return memberRejected(
        run reject(
          &resolver.*,
          &module,
          RejectionCode.Unsupported,
          Span.make(usize.ZERO, usize.ZERO),
        ),
        move dependencies,
      )
    }
  }
  let externs = run copyMirExterns(&resolver.*, mirIndex)
  let entries = Vector.asSlice<Shared<DeclarationId>>(&externs)
  let mut foreign = Vector.make<CAbi.Signature>()
  let mut foreignAt = usize.ZERO
  while foreignAt < entries.length {
    let classified = run Effect.result(foreignSignature(&mut resolver.*, &mut owner.*, &mut dependencies, &entries[foreignAt]))
    match move classified {
      Result<CAbi.Signature, BackendGap | Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError>.Success {value} => { run Vector.append<CAbi.Signature>(&mut foreign, move value) }
      Result<CAbi.Signature, BackendGap | Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError>.Failure {error} => match move error {
        BackendGap {code, owner: gapOwner, source} => { return memberSuccess(Value.Unsupported {gap: run Shared.make<BackendGap>(BackendGap {code: code, owner: move gapOwner, source: move source})}, move dependencies) }
        Cycle {} => { fail Cycle {} }
        InvalidModulePath {} => { fail InvalidModulePath {} }
        RevisionMismatch {} => { fail RevisionMismatch {} }
        OutOfMemoryError {} => { fail OutOfMemoryError {} }
      }
    }
    foreignAt = foreignAt + usize.ONE
  }
  let mut types = run copyMirLocalTypes(&resolver.*, mirIndex)
  let mut layouts = Vector.make<TypeLayout>()
  let mut at = usize.ZERO
  while at < Vector.length<LayoutDemand>(&types) {
    let needed = layoutDemandAt(&types, at)
    let supplied = Vector.asSlice<TypeLayout>(&layouts)
    let mut present = false
    let mut suppliedAt = usize.ZERO
    while suppliedAt < supplied.length && !present {
      present = run Type.runtimeEqualsShared(&supplied[suppliedAt].ty, &needed.ty)
      suppliedAt = suppliedAt + usize.ONE
    }
    if present {
      at = at + usize.ONE
      continue
    }
    let application = run internLayoutType(&mut resolver.*, &needed.ty)
    let layout = run demandChild(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies,
      Key {
        family: Family.Layout,
        module: key.module,
        name: application,
        declaration: usize.ZERO,
        member: usize.ZERO,
        external: false,
      },
      needed.span,
    )
    let layoutUnsupported = Shared.with<Result<Answer, NoRejection>, bool>(
      &layout,
      answerLayoutUnsupported,
    )
    if layoutUnsupported {
      let functions = Vector.asSlice<MirFunction>(&resolver.mirValues)
      let identity = InstanceKey.identity(&functions[mirIndex].key)
      let mut code = GapCode.ScalarLayout
      if Shared.with<Type, bool>(
        &needed.ty,
        fn(value: &Type) -> bool {
          return match & value.* {
            Type.Slice {..} => true
            _ => false
          }
        },
      ) {
        code = GapCode.SliceLayout
      }
      return memberSuccess(
        Value.Unsupported {
          gap: run Shared.make<BackendGap>(BackendGap.make(code, &identity, needed.span)),
        },
        move dependencies,
      )
    }
    let layoutFailure = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
      &layout,
      answerRejection,
    )
    if let Option<Shared<Rejection>>.Some {value} = move layoutFailure {
      return memberRejected(move value, move dependencies)
    }
    let selectedLayout = Shared.with<Result<Answer, NoRejection>, Option<usize>>(
      &layout,
      answerLayoutIndex,
    )
    let layoutIndex = match move selectedLayout {
      Option<usize>.Some {value} => value
      Option<usize>.None => {
        return memberRejected(
          run reject(&resolver.*, &module, RejectionCode.Unsupported, needed.span),
          move dependencies,
        )
      }
    }
    let resolvedLayouts = Vector.asSlice<Shared<BackendLayout>>(&resolver.layoutValues)
    let facts = Shared.clone<BackendLayout>(&resolvedLayouts[layoutIndex])
    run Vector.append<TypeLayout>(&mut layouts,
      TypeLayout {ty: Shared.clone<Type>(&needed.ty), layout: Shared.clone<BackendLayout>(&facts)},
    )
    let count = Shared.with<BackendLayout, usize>(&facts, BackendLayout.childCount)
    let mut fieldAt = usize.ZERO
    while fieldAt < count {
      let selectedField = Shared.with<BackendLayout, Option<Shared<Type>>>(&facts,
        fn(layout: &BackendLayout) -> Option<Shared<Type>> {
          return BackendLayout.childAt(layout, fieldAt)
        },
      )
      if let Option<Shared<Type>>.Some {value} = move selectedField {
        run Vector.append<LayoutDemand>(&mut types, LayoutDemand {ty: move value, span: needed.span})
      }
      fieldAt = fieldAt + usize.ONE
    }
    at = at + usize.ONE
  }
  let mut coordinates = RuntimeEncoding.coordinates()
  let initialFunctions = Vector.asSlice<MirFunction>(&resolver.mirValues)
  let recipe = run InstanceRecipe.make(&initialFunctions[mirIndex])
  let callees = Vector.asSlice<InstanceKey>(&recipe.callees)
  let collected = run InstanceText.encodings(&recipe, &mut coordinates)
  drop collected
  // Signature facts can also contain local evidence; collect it before assigning coordinates.
  let collectedSignatures = run emissionSignatureContent(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies,
    callees,
    &mut coordinates,
  )
  drop collectedSignatures
  run resolveInstanceCoordinates(&mut resolver.*, &mut coordinates)
  let mut replay = Vector.make<Dependency>()
  let signatures = run emissionSignatureContent(
    &mut resolver.*,
    &mut owner.*,
    &mut replay,
    callees,
    &mut coordinates,
  )
  let encoded = run InstanceText.encodings(&recipe, &mut coordinates)
  let identities = run InstanceText.identities(&recipe, Vector.asSlice<Bytes>(&encoded))
  let content = run InstanceText.contentWith(
    &recipe,
    &resolver.target,
    Vector.asSlice<TypeLayout>(&layouts),
    Vector.asSlice<CAbi.Signature>(&foreign),
    Bytes.asSlice(&signatures),
    Vector.asSlice<Bytes>(&encoded),
    &suspension,
  )
  let encodedSlice = Vector.asSlice<Bytes>(&encoded)
  let own = run Bytes.copy(Bytes.asSlice(&encodedSlice[usize.ZERO]))
  let index = Vector.length<EmissionInputs>(&resolver.emissionInputs)
  run Vector.append<EmissionInputs>(&mut resolver.*.emissionInputs,
    EmissionInputs {
      mir: mirIndex,
      layouts: move layouts,
      foreign: move foreign,
      llvm: usize.MAX,
      encoding: move own,
      identities: move identities,
      suspension: move suspension,
    },
  )
  let llvm = run internLlvmInput(
    &mut resolver.*,
    index,
    move content,
    Vector.asSlice<Dependency>(&dependencies),
  )
  let inputs = Vector.asMutSlice<EmissionInputs>(&mut resolver.emissionInputs)
  inputs[index].llvm = llvm
  return memberSuccess(Value.EmissionInputs {index: index}, move dependencies)
}

// Whether one function body contains static control or static state anywhere in its own
// statements: blocks, conditionals, `if let`, loops, `unsafe` and match-arm blocks alike. The walk
// follows owned children only (`ownedChildren`, the HIR verifier's complete field walk), so a
// node's position or span never bounds it. A nested callable's or Effect's body is a separate body
// and is not entered. Static arms are recognized syntactically and never semantically inspected.
effect fn bodyHasStaticWork(hir: &Module, block: HirId) -> bool ! OutOfMemoryError ? &mut Allocator {
  let mut pending = Vector.make<HirId>()
  run Vector.append<HirId>(&mut pending, block)
  while Vector.length<HirId>(&pending) > usize.ZERO {
    let last = Vector.length<HirId>(&pending) - usize.ONE
    let id = Vector.remove<HirId>(&mut pending, last)
    match Module.node(hir, id) {
      Node.CallableExpression {..} => { continue }
      Node.EffectExpression {..} => { continue }
      Node.StaticConditionalStatement {..} => { return true }
      Node.StaticForStatement {..} => { return true }
      Node.BindingStatement {isStatic, ..} => {
        if isStatic { return true }
      }
      _ => ()
    }
    let owned = run ownedChildren(hir, id)
    let children = Vector.asSlice<HirId>(&owned)
    let mut at = usize.ZERO
    while at < children.length {
      run Vector.append<HirId>(&mut pending, children[at])
      at = at + usize.ONE
    }
  }
  return false
}

// The single routing fact for a runtime function: true when it has static parameters, static
// control or state, or calls a static helper whose result is embedded. Syntactic markers decide
// first; only otherwise are the written callees' headers read. No callee runtime body is demanded
// and no static arm is semantically inspected.
effect fn needsStaticResidualization(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  module: &ModuleId,
  moduleOrdinal: usize,
  declaration: usize,
) -> Result<bool, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let sourceAnswer = run source(&mut resolver.*, module)
  let mut marked = false
  let mut annotationIds = Vector.make<HirId>()
  let mut writtenCalls = Vector.make<CallSyntax>()
  if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(&resolver.*, &sourceAnswer, module) {
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(indexed))
    if declaration < declarations.length {
      let hir = IndexedSource.authored(indexed)
      if let Node.Declaration {header, body, ..} = Module.node(hir, declarations[declaration].local) {
        if let Node.FunctionHeader {contract, ..} = Module.node(hir, header) {
          if let Node.CallableContract {parameters, ..} = Module.node(hir, contract) {
            let mut at = usize.ZERO
            while at < parameters.length {
              if let Node.Parameter {mode, ..} = Module.node(hir, Module.child(hir, parameters, at)) {
                if mode == ParameterMode.Static { marked = true }
              }
              at = at + usize.ONE
            }
          }
        }
        if let Node.CallableBody {block} = Module.node(hir, body) {
          if block.present {
            if let Node.Block {statements} = Module.node(hir, block.id) {
              if !marked { marked = run bodyHasStaticWork(hir, block.id) }
              if !marked { run collectBodySyntax(hir, statements, &mut annotationIds, &mut writtenCalls) }
            }
          }
        }
      }
    }
  }
  if marked { return Result.succeed<bool, Shared<Rejection>>(true) }
  let facts = run resolveBodyFacts(
    &mut resolver.*, &mut owner.*, &mut dependencies.*, module, moduleOrdinal, declaration, &annotationIds, &writtenCalls,
  )
  let resolved = match move facts {
    Result<BodyFacts, Shared<Rejection>>.Success {value} => value
    Result<BodyFacts, Shared<Rejection>>.Failure {error} => { return Result.failResult<bool, Shared<Rejection>>(move error) }
  }
  let calls = Vector.asSlice<ResolvedCall>(&resolved.calls)
  let mut at = usize.ZERO
  while at < calls.length {
    let decided = run resolvedCallPhase(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, &calls[at])
    match move decided {
      Result<CallPhase, Shared<Rejection>>.Success {value: phase} => {
        match move phase {
          CallPhase.Runtime => {}
          _ => { return Result.succeed<bool, Shared<Rejection>>(true) }
        }
      }
      Result<CallPhase, Shared<Rejection>>.Failure {error} => { return Result.failResult<bool, Shared<Rejection>>(move error) }
    }
    at = at + usize.ONE
  }
  return Result.succeed<bool, Shared<Rejection>>(false)
}

/// How a selection pass treats one reached call, read from the callee's tracked header.
pub union CallPhase {
  /// An ordinary runtime call.
  Runtime,
  /// A `static fn`: the selection pass executes it and embeds its result.
  Static,
  /// A runtime function with `static` parameters at these original indices: the selection pass
  /// evaluates those arguments, and the call keeps only its runtime operands. Each slot's closed
  /// declared type is its argument's expected type; a type written in callee binders is absent.
  StaticSlots {pub slots: Vector<usize>, pub types: Vector<Option<Shared<Type>>>},
}

// The phase of one resolved call, read from the callee's tracked Signature. Routing and the
// selection pass share this fact; a fresh store interns the callee module, and an unresolved or
// rejected header is a precise rejection rather than an ordinary runtime call.
effect fn resolvedCallPhase(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  module: &ModuleId,
  call: &ResolvedCall,
) -> Result<CallPhase, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  if let Result<ResolvedTarget, Shared<Rejection>>.Success {value: ResolvedTarget.Function {target}} = &call.result {
    let callSpan = run staticSpan(&mut resolver.*, module, call.id)
    let calleeModule = run ModuleId.copy(DeclarationId.moduleId(&target.declaration))
    let calleeModuleOrdinal = run internModule(&mut resolver.*, &calleeModule)
    let identity = run Shared.make<DeclarationId>(run DeclarationId.copy(&target.declaration))
    let position = run ordinalOfIdentity(&mut resolver.*, &calleeModule, &identity)
    let ordinal = match move position {
      Option<usize>.Some {value} => value
      Option<usize>.None => {
        return Result.failResult<CallPhase, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.UnknownMember, callSpan))
      }
    }
    let header = run demandChild(
      &mut resolver.*, &mut owner.*, &mut dependencies.*,
      Key {family: Family.Signature, module: calleeModuleOrdinal, name: usize.ZERO, declaration: ordinal, member: usize.ZERO, external: false},
      callSpan,
    )
    let facts = Shared.with<Result<Answer, NoRejection>, Option<SignatureFacts>>(&header, signatureFacts)
    return match move facts {
      Option<SignatureFacts>.Some {value: signature} => {
        if signature.isStatic { return Result.succeed<CallPhase, Shared<Rejection>>(CallPhase.Static) }
        if signature.staticSlots == usize.ZERO { return Result.succeed<CallPhase, Shared<Rejection>>(CallPhase.Runtime) }
        let slots = run signatureStaticSlots(&header, signature.staticSlots)
        let mut types = Vector.make<Option<Shared<Type>>>()
        let listed = Vector.asSlice<usize>(&slots)
        let mut slotAt = usize.ZERO
        while slotAt < listed.length {
          let index = listed[slotAt]
          let declared = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(&header,
            fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> { return signatureParameter(answer, index) })
          let mut closedType = Option.none<Shared<Type>>()
          if let Option<Shared<Type>>.Some {value} = move declared {
            if !Type.hasOpenParameters(&value) { closedType = Option.some<Shared<Type>>(move value) }
          }
          run Vector.append<Option<Shared<Type>>>(&mut types, move closedType)
          slotAt = slotAt + usize.ONE
        }
        return Result.succeed<CallPhase, Shared<Rejection>>(CallPhase.StaticSlots {slots: move slots, types: move types})
      }
      Option<SignatureFacts>.None => {
        let refused = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(&header, answerRejection)
        if let Option<Shared<Rejection>>.Some {value: reason} = move refused {
          return Result.failResult<CallPhase, Shared<Rejection>>(move reason)
        }
        return Result.failResult<CallPhase, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.Unsupported, callSpan))
      }
    }
  }
  return Result.succeed<CallPhase, Shared<Rejection>>(CallPhase.Runtime)
}

// Resolves one written call inside a declaration's body and reads its callee's phase.
effect fn writtenCallPhase(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  module: &ModuleId,
  declaration: usize,
  call: HirId,
) -> Result<CallPhase, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let sourceAnswer = run source(&mut resolver.*, module)
  let mut written = Vector.make<CallSyntax>()
  if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(&resolver.*, &sourceAnswer, module) {
    let mut phaseAnnotations = Vector.make<HirId>()
    run collectCall(IndexedSource.authored(indexed), call, &mut phaseAnnotations, &mut written)
  }
  let collected = Vector.asSlice<CallSyntax>(&written)
  let mut at = usize.ZERO
  while at < collected.length {
    if collected[at].id.index == call.index {
      let template = run templateBinders(&mut resolver.*, module, declaration)
      let binders = match move template {
        Result<Vector<Binder>, Shared<Rejection>>.Success {value} => value
        Result<Vector<Binder>, Shared<Rejection>>.Failure {error} => { return Result.failResult<CallPhase, Shared<Rejection>>(move error) }
      }
      let moduleOrdinal = run internModule(&mut resolver.*, module)
      let constraints = match move run bodySignatureConstraints(&mut resolver.*, &mut owner.*, &mut dependencies.*, moduleOrdinal, declaration) {
        Result<Vector<Constraint>, Shared<Rejection>>.Success {value} => value
        Result<Vector<Constraint>, Shared<Rejection>>.Failure {error} => { return Result.failResult<CallPhase, Shared<Rejection>>(move error) }
      }
      let target = run callTarget(
        &mut resolver.*, &mut owner.*, &mut dependencies.*, module, moduleOrdinal, &collected[at],
        Vector.asSlice<Binder>(&binders),
        Vector.asSlice<Constraint>(&constraints),
      )
      let resolved = ResolvedCall {id: call, result: move target}
      return run resolvedCallPhase(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, &resolved)
    }
    at = at + usize.ONE
  }
  return Result.succeed<CallPhase, Shared<Rejection>>(CallPhase.Runtime)
}

// The interned selected application a Body member names.
effect fn selectedApplicationAt(resolver: &Resolver, at: usize) -> Application ! OutOfMemoryError ? &mut Allocator {
  let known = Vector.asSlice<Application>(&resolver.selectedApplications)
  return run Application.copy(&known[at])
}

// Interns one selected body's complete semantic application; equal semantic inputs share it.
effect fn internSelectedApplication(resolver: &mut Resolver, application: &Application) -> usize
! OutOfMemoryError
? &mut Allocator {
  let hashed = Application.hash(application)
  let known = Vector.asSlice<Application>(&resolver.selectedApplications)
  let mut at = InternIndex.first(&resolver.selectedApplicationLookup, hashed)
  while at != usize.MAX {
    if run Application.equals(&known[at], application) {
      return at
    }
    at = InternIndex.after(&resolver.selectedApplicationLookup, at)
  }
  let interned = known.length
  run Vector.append<Application>(&mut resolver.*.selectedApplications, run Application.copy(application))
  run InternIndex.record(&mut resolver.selectedApplicationLookup, hashed)
  return interned
}

fn staticScalarCode(value: &StaticData) -> usize {
  return match & value.* {
    StaticData.Unit => 1
    StaticData.Boolean {..} => 2
    StaticData.Integer {ty, ..} => match ty {
      StaticIntegerType.U8 => 3
      StaticIntegerType.U16 => 4
      StaticIntegerType.U32 => 5
      StaticIntegerType.U64 => 6
      StaticIntegerType.Usize => 7
      StaticIntegerType.I8 => 8
      StaticIntegerType.I16 => 9
      StaticIntegerType.I32 => 10
      StaticIntegerType.I64 => 11
      StaticIntegerType.Isize => 12
    }
    StaticData.Float {ty, ..} => match ty {
      StaticFloatType.F32 => 13
      StaticFloatType.F64 => 14
    }
    _ => 0
  }
}

fn staticScalarName(code: usize) -> &'static [u8] {
  if code == 2 { return b"bool" }
  if code == 3 { return b"u8" }
  if code == 4 { return b"u16" }
  if code == 5 { return b"u32" }
  if code == 6 { return b"u64" }
  if code == 7 { return b"usize" }
  if code == 8 { return b"i8" }
  if code == 9 { return b"i16" }
  if code == 10 { return b"i32" }
  if code == 11 { return b"i64" }
  if code == 12 { return b"isize" }
  if code == 13 { return b"f32" }
  return b"f64"
}

// The exact runtime type of an embedded static value: scalars, scalar enums, and fixed arrays of
// embeddable values, which MIR materializes. An enum's type is the type its declaration's identity
// answer gives, exactly as typing a member does. Character, text and nominal aggregates remain an
// explicit gap.
effect fn embeddedType(
  resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>, dependencies: &mut Vector<Dependency>,
  value: &Shared<StaticData>, span: Span,
) -> Option<Shared<Type>> ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let code = Shared.with<StaticData, usize>(value, staticScalarCode)
  if code == usize.ONE { return Option.some<Shared<Type>>(run Shared.make<Type>(Type.Unit)) }
  if code != usize.ZERO {
    return Option.some<Shared<Type>>(run Shared.make<Type>(Type.Primitive {name: run Bytes.copy(staticScalarName(code))}))
  }
  let enumOwner = Shared.with<StaticData, Option<Shared<DeclarationId>>>(value, fn(data: &StaticData) -> Option<Shared<DeclarationId>> {
    return match & data.* {
      StaticData.Enum {declaration, ..} => Option.some<Shared<DeclarationId>>(Shared.clone<DeclarationId>(&declaration))
      _ => Option.none<Shared<DeclarationId>>()
    }
  })
  if let Option<Shared<DeclarationId>>.Some {value: declaration} = move enumOwner {
    let located = run locationOfIdentity(&mut resolver.*, &declaration)
    let location = match move located {
      Option<InstanceLocation>.Some {value: found} => found
      Option<InstanceLocation>.None => { return Option.none<Shared<Type>>() }
    }
    let identity = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, Key {
      family: Family.Identity, module: location.module, name: usize.ZERO,
      declaration: location.declaration, member: usize.ZERO, external: false,
    }, span)
    let selection = run typeFromAnswer(&identity)
    return move selection.resolved
  }
  let arrayType = Shared.with<StaticData, Option<Shared<Type>>>(value, embeddedArrayType)
  if let Option<Shared<Type>>.Some {value: ty} = move arrayType {
    let count = Shared.with<StaticData, usize>(value, aggregateFieldCount)
    let mut at = usize.ZERO
    while at < count {
      let child = Shared.with<StaticData, Option<Shared<StaticData>>>(value, fn(data: &StaticData) -> Option<Shared<StaticData>> {
        return StaticValue.field(data, at)
      })
      let element = match move child {
        Option<Shared<StaticData>>.Some {value: found} => found
        Option<Shared<StaticData>>.None => { return Option.none<Shared<Type>>() }
      }
      let elementType = run embeddedType(&mut resolver.*, &mut owner.*, &mut dependencies.*, &element, span)
      if let Option<Shared<Type>>.None = move elementType { return Option.none<Shared<Type>>() }
      at = at + usize.ONE
    }
    return Option.some<Shared<Type>>(move ty)
  }
  return Option.none<Shared<Type>>()
}

fn aggregateFieldCount(data: &StaticData) -> usize {
  return match & data.* {
    StaticData.Aggregate {fields, ..} => Vector.length<Shared<StaticData>>(&fields)
    _ => usize.ZERO
  }
}

// The type of a fixed-array static value; a nominal aggregate is not an array.
fn embeddedArrayType(data: &StaticData) -> Option<Shared<Type>> {
  if let StaticData.Aggregate {ty, variant, ..} = &data.* {
    if let Option<usize>.Some {..} = &variant { return Option.none<Shared<Type>>() }
    let isArray = Shared.with<Type, bool>(&ty, fn(shape: &Type) -> bool {
      return match & shape.* {
        Type.Array {..} => true
        _ => false
      }
    })
    if isArray { return Option.some<Shared<Type>>(Shared.clone<Type>(&ty)) }
  }
  return Option.none<Shared<Type>>()
}

effect fn selectionBody(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  module: &ModuleId,
  application: &Application,
) -> MixedSelection ! MixedDiagnostic | StaticDiagnostic | OutOfMemoryError ? &mut Allocator {
  let mut machine = run MixedBody.make(
    inFlightStaticPort(&mut resolver.*, &mut owner.*, &mut dependencies.*), module,
    StaticExecution.Limits {steps: 10000, depth: 64, valueBytes: 1048576}, 4096,
  )
  return run MixedBody.specialize(&mut machine, application)
}

// Runs the single selection pass for one selected application and publishes its static results
// as per-syntax facts. Static parameters have no argument source yet and stay an explicit gap.
effect fn selectionFacts(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  module: &ModuleId,
  application: &Application,
) -> Result<Vector<ResolvedCall>, Shared<Rejection>> ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let attempted = run Effect.result(selectionBody(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, application))
  let selected = match move attempted {
    Result<MixedSelection, MixedDiagnostic | StaticDiagnostic | OutOfMemoryError>.Success {value} => value
    Result<MixedSelection, MixedDiagnostic | StaticDiagnostic | OutOfMemoryError>.Failure {error} => match move error {
      OutOfMemoryError {} => { fail OutOfMemoryError {} }
      MixedDiagnostic {code, span, rejection, occurrence, ..} => {
        if let Option<Shared<Rejection>>.Some {value: reason} = move rejection {
          return Result.failResult<Vector<ResolvedCall>, Shared<Rejection>>(move reason)
        }
        if let Option<MixedBody.IterationOccurrence>.Some {value} = move occurrence {
          let forSpan = run staticSpan(&mut resolver.*, module, value.syntax)
          return Result.failResult<Vector<ResolvedCall>, Shared<Rejection>>(run rejectIteration(&resolver.*, module, code, span, forSpan, value.ordinal))
        }
        return Result.failResult<Vector<ResolvedCall>, Shared<Rejection>>(run reject(&resolver.*, module, code, span))
      }
      StaticDiagnostic {fault, code, span, target, message, origin, byteOffset, rejection, needed, missing, trace} => {
        if let Option<Shared<Rejection>>.Some {value: reason} = move rejection {
          return Result.failResult<Vector<ResolvedCall>, Shared<Rejection>>(move reason)
        }
        return Result.failResult<Vector<ResolvedCall>, Shared<Rejection>>(run rejectStatic(&resolver.*, module, StaticDiagnostic {
          fault: fault, code: move code, span: span, target: move target, message: move message, origin: move origin,
          byteOffset: move byteOffset, rejection: Option.none<Shared<Rejection>>(), needed: move needed,
          missing: move missing, trace: move trace,
        }))
      }
    }
  }
  return run selectionContextFacts(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, &selected)
}

effect fn selectionContextFacts(resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, module: &ModuleId, selected: &MixedSelection) -> Result<Vector<ResolvedCall>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let mut facts = Vector.make<ResolvedCall>()
  let embedded = Vector.asSlice<MixedEmbedded>(&selected.embedded)
  let mut at = usize.ZERO
  while at < embedded.length {
    let embeddedSpan = run staticSpan(&mut resolver.*, module, embedded[at].syntax)
    let ty = run embeddedType(&mut resolver.*, &mut owner.*, &mut dependencies.*, &embedded[at].value, embeddedSpan)
    let exact = match move ty {
      Option<Shared<Type>>.Some {value} => value
      Option<Shared<Type>>.None => {
        let unsupportedSpan = run staticSpan(&mut resolver.*, module, embedded[at].syntax)
        // A reflected descriptor has no runtime representation to embed.
        let phaseOnly = Shared.with<StaticData, bool>(&embedded[at].value, fn(data: &StaticData) -> bool {
          return match &data.* {
            StaticData.Aggregate {ty: described, ..} => Type.mentionsPhaseOnly(&described)
            StaticData.Sequence {..} => true
            _ => false
          }
        })
        let mut code = RejectionCode.Unsupported
        if phaseOnly { code = RejectionCode.StaticPhaseViolation }
        return Result.failResult<Vector<ResolvedCall>, Shared<Rejection>>(
          run reject(&resolver.*, module, code, unsupportedSpan),
        )
      }
    }
    run Vector.append<ResolvedCall>(&mut facts, ResolvedCall {
      id: embedded[at].syntax,
      result: Result.succeed<ResolvedTarget, Shared<Rejection>>(ResolvedTarget.Selected {
        fact: SelectionFact.Embedded {value: Shared.clone<StaticData>(&embedded[at].value), ty: move exact},
      }),
    })
    at = at + usize.ONE
  }
  let decisions = Vector.asSlice<MixedDecision>(&selected.decisions)
  at = usize.ZERO
  while at < decisions.length {
    run Vector.append<ResolvedCall>(&mut facts, ResolvedCall {
      id: decisions[at].condition,
      result: Result.succeed<ResolvedTarget, Shared<Rejection>>(ResolvedTarget.Selected {
        fact: SelectionFact.Condition {selected: decisions[at].selected},
      }),
    })
    at = at + usize.ONE
  }
  let bindings = Vector.asSlice<StaticBinding>(&selected.staticBindings)
  at = usize.ZERO
  while at < bindings.length {
    run Vector.append<ResolvedCall>(&mut facts, ResolvedCall {
      id: bindings[at].binder,
      result: Result.succeed<ResolvedTarget, Shared<Rejection>>(ResolvedTarget.Selected {
        fact: SelectionFact.StaticBinding {value: StaticValue.copy(&bindings[at].value)},
      }),
    })
    at = at + usize.ONE
  }
  let calls = Vector.asSlice<MixedStaticArguments>(&selected.staticArguments)
  at = usize.ZERO
  while at < calls.length {
    run Vector.append<ResolvedCall>(&mut facts, ResolvedCall {
      id: calls[at].call,
      result: Result.succeed<ResolvedTarget, Shared<Rejection>>(ResolvedTarget.Selected {
        fact: SelectionFact.StaticArguments {
          slots: run Shared.make<Vector<StaticSlot>>(run copyStaticSlots(Vector.asSlice<StaticSlot>(&calls[at].slots))),
        },
      }),
    })
    at = at + usize.ONE
  }
  let loops = Vector.asSlice<MixedBody.StaticForSelection>(&selected.iterations)
  at = usize.ZERO
  while at < loops.length {
    let selectedIterations = Vector.asSlice<MixedBody.Iteration>(&loops[at].iterations)
    let mut iterations = Vector.make<IterationFacts>()
    let mut ordinal = usize.ZERO
    while ordinal < selectedIterations.length {
      let child = run MixedBody.copySharedBody(&selectedIterations[ordinal].selection)
      let nested = run selectionContextFacts(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, &child)
      let calls = match move nested {
        Result<Vector<ResolvedCall>, Shared<Rejection>>.Success {value} => value
        Result<Vector<ResolvedCall>, Shared<Rejection>>.Failure {error} => { return Result.failResult<Vector<ResolvedCall>, Shared<Rejection>>(move error) }
      }
      run Vector.append<IterationFacts>(&mut iterations, IterationFacts {ordinal: selectedIterations[ordinal].ordinal, calls: move calls})
      ordinal = ordinal + usize.ONE
    }
    run Vector.append<ResolvedCall>(&mut facts, ResolvedCall {id: loops[at].syntax,
      result: Result.succeed<ResolvedTarget, Shared<Rejection>>(ResolvedTarget.Selected {
        fact: SelectionFact.StaticFor {iterations: run Shared.make<Vector<IterationFacts>>(move iterations)},
      })})
    at = at + usize.ONE
  }
  return Result.succeed<Vector<ResolvedCall>, Shared<Rejection>>(move facts)
}

// Anonymous callables, anonymous `effect fn`s and `effect {}` blocks: literals whose body their
// lexical owner's body retains.
fn literalKind(identity: &DeclarationId) -> bool {
  return DeclarationId.kind(identity) == OwnerKind.Anonymous || DeclarationId.kind(identity) == OwnerKind.EffectBlock
}

struct AnonymousChild {
  body: Shared<TypedBody>
  source: Shared<Observation>
}

// Anonymous bodies are retained by their lexical owner's body query. Following that query
// preserves source validation and cache-hit dependency replay, without a side registration table.
fn anonymousChild(body: &TypedBody, identity: &DeclarationId) -> Option<Shared<TypedBody>> {
  let nodes = TypedBody.nodeSlice(body)
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {form: BodyExpression.Callable {body: child, ..}, ..} = &nodes[at].kind {
      if Shared.with<TypedBody, bool>(&child, fn(value: &TypedBody) -> bool {
        return DeclarationId.equals(TypedBody.declarationId(value), identity)
      }) { return Option.some<Shared<TypedBody>>(Shared.clone<TypedBody>(&child)) }
    }
    at = at + usize.ONE
  }
  return Option.none<Shared<TypedBody>>()
}

fn anonymousChildAnswer(answer: &Result<Answer, NoRejection>, identity: &DeclarationId) -> Option<AnonymousChild> {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Body {body, source}} = &value.outcome {
      let selected = Shared.with<TypedBody, Option<Shared<TypedBody>>>(&body, fn(value: &TypedBody) -> Option<Shared<TypedBody>> {
        return anonymousChild(value, identity)
      })
      if let Option<Shared<TypedBody>>.Some {value: child} = move selected {
        return Option.some<AnonymousChild>(AnonymousChild {body: move child, source: Shared.clone<Observation>(&source)})
      }
    }
  }
  return Option.none<AnonymousChild>()
}

effect fn resolveAnonymousBody(resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>, key: Key,
  identity: &DeclarationId) -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let module = run resolvedModule(&resolver.*, key.module)
  let mut dependencies = Vector.make<Dependency>()
  let enclosing = match move run enclosingIdentity(&mut resolver.*, &module, key.declaration) {
    Option<DeclarationId>.Some {value} => value
    _ => { return rejectedBody(run reject(&resolver.*, &module, RejectionCode.Unsupported, Span.make(usize.ZERO, usize.ZERO)), move dependencies) }
  }
  let handle = run Shared.make<DeclarationId>(run DeclarationId.copy(&enclosing))
  let parent = match move run ordinalOfIdentity(&mut resolver.*, &module, &handle) {
    Option<usize>.Some {value} => value
    _ => { return rejectedBody(run reject(&resolver.*, &module, RejectionCode.Unsupported, Span.make(usize.ZERO, usize.ZERO)), move dependencies) }
  }
  let mut parentMember = usize.ZERO
  if key.member != usize.ZERO {
    let childApplication = run selectedApplicationAt(&resolver.*, key.member - usize.ONE)
    let mut arguments = Vector.make<Argument>()
    let mut ordinals = Vector.make<usize>()
    let mut scopes = Vector.make<ScopeBinding>()
    let childScopes = Vector.asSlice<ScopeBinding>(&childApplication.scopes)
    let mut at = usize.ZERO
    while at < childScopes.length {
      if Shared.with<DeclarationId, bool>(&childScopes[at].owner, fn(value: &DeclarationId) -> bool { return DeclarationId.equals(value, &enclosing) }) {
        let own = run ScopeBinding.copy(&childScopes[at])
        let ScopeBinding {arguments: values, argumentOrdinals: slots, ..} = move own
        arguments = move values
        ordinals = move slots
      } else { run Vector.append<ScopeBinding>(&mut scopes, run ScopeBinding.copy(&childScopes[at])) }
      at = at + usize.ONE
    }
    let routing = run needsStaticResidualization(&mut resolver.*, &mut owner.*, &mut dependencies, &module, key.module, parent)
    let selected = match move routing {
      Result<bool, Shared<Rejection>>.Success {value} => value
      Result<bool, Shared<Rejection>>.Failure {error} => { return rejectedBody(move error, move dependencies) }
    }
    if selected || literalKind(&enclosing) {
      let application = Application {target: SpecializationTarget.Named {declaration: run DeclarationId.copy(&enclosing)},
        arguments: move arguments, argumentOrdinals: move ordinals, scopes: move scopes, statics: Vector.make<StaticSlot>()}
      let selectedParent = run internSelectedApplication(&mut resolver.*, &application)
      parentMember = selectedParent + usize.ONE
    }
  }
  let parentAnswer = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies, Key {
    family: Family.Body, module: key.module, name: usize.ZERO, declaration: parent, member: parentMember, external: false,
  }, Span.make(usize.ZERO, usize.ZERO))
  let rejected = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(&parentAnswer, answerRejection)
  if let Option<Shared<Rejection>>.Some {value} = move rejected { return rejectedBody(move value, move dependencies) }
  let selected = Shared.with<Result<Answer, NoRejection>, Option<AnonymousChild>>(&parentAnswer,
    fn(answer: &Result<Answer, NoRejection>) -> Option<AnonymousChild> { return anonymousChildAnswer(answer, identity) })
  if let Option<AnonymousChild>.Some {value} = move selected {
    return memberSuccess(Value.Body {body: move value.body, source: move value.source}, move dependencies)
  }
  return rejectedBody(run reject(&resolver.*, &module, RejectionCode.Unsupported, Span.make(usize.ZERO, usize.ZERO)), move dependencies)
}

// The bounds of the implementation enclosing member `declaration` become premises of its body, as
// the bootstrap checks `impl<T: Printable> Printable for Box<T>` members with `T: Printable`.
// Specialization proves them for each selected application before the member is reached.
effect fn appendHeadBounds(
  resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>, dependencies: &mut Vector<Dependency>,
  module: &ModuleId, moduleOrdinal: usize, declaration: usize, constraints: &mut Vector<Constraint>,
) -> Option<Shared<Rejection>> ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let enclosing = match move run enclosingIdentity(&mut resolver.*, module, declaration) {
    Option<DeclarationId>.Some {value} => value
    Option<DeclarationId>.None => { return Option.none<Shared<Rejection>>() }
  }
  if DeclarationId.kind(&enclosing) != OwnerKind.Implementation { return Option.none<Shared<Rejection>>() }
  let enclosingShared = run Shared.make<DeclarationId>(move enclosing)
  let parent = match move run ordinalOfIdentity(&mut resolver.*, module, &enclosingShared) {
    Option<usize>.Some {value} => value
    Option<usize>.None => { fail InvalidModulePath {} }
  }
  let answer = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, Key {family: Family.ImplementationHead,
    module: moduleOrdinal, name: usize.ZERO, declaration: parent, member: usize.ZERO, external: false},
    Span.make(usize.ZERO, usize.ZERO))
  let rejected = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(&answer, answerRejection)
  if let Option<Shared<Rejection>>.Some {value} = move rejected { return Option.some<Shared<Rejection>>(move value) }
  let head = match move Shared.with<Result<Answer, NoRejection>, Option<Shared<ImplementationHead>>>(&answer, headOf) {
    Option<Shared<ImplementationHead>>.Some {value} => value
    Option<Shared<ImplementationHead>>.None => { fail InvalidModulePath {} }
  }
  let count = Shared.with<ImplementationHead, usize>(&head,
    fn(value: &ImplementationHead) -> usize { return Vector.length<Constraint>(&value.binders.constraints) })
  let mut at = usize.ZERO
  while at < count {
    let bound = Shared.with<ImplementationHead, Option<Constraint>>(&head, fn(value: &ImplementationHead) -> Option<Constraint> {
      let listed = Vector.asSlice<Constraint>(&value.binders.constraints)
      return Option.some<Constraint>(copyConstraint(&listed[at]))
    })
    if let Option<Constraint>.Some {value} = move bound { run Vector.append<Constraint>(&mut constraints.*, move value) }
    at = at + usize.ONE
  }
  return Option.none<Shared<Rejection>>()
}

effect fn resolveBody(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  key: Key,
  candidate: Option<BodyCandidate>,
) -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let literalModule = run resolvedModule(&resolver.*, key.module)
  let literalIdentity = run declarationAt(&mut resolver.*, &literalModule, key.declaration)
  if let Option<DeclarationId>.Some {value} = move literalIdentity {
    if literalKind(&value) { return run resolveAnonymousBody(&mut resolver.*, &mut owner.*, key, &value) }
  }
  if let Option<BodyCandidate>.Some {value} = move candidate {
    let reused = run reuseBody(&mut resolver.*, &mut owner.*, key, move value)
    if let Option<Answer>.Some {value: answer} = move reused {
      let word = run internKey(&mut resolver.*, key)
      run emit(&mut resolver.*, EventKind.Reuse, word)
      return move answer
    }
    let count = Vector.length<SourceFrame>(&resolver.frames)
    let stale = Vector.remove<SourceFrame>(&mut resolver.frames, count - usize.ONE)
    drop stale
    run Vector.append<SourceFrame>(&mut resolver.frames, emptyFrame())
  }
  let module = run resolvedModule(&resolver.*, key.module)
  let signatureKey = Key {
    family: Family.Signature,
    module: key.module,
    name: usize.ZERO,
    declaration: key.declaration,
    member: usize.ZERO,
    external: false,
  }
  let mut dependencies = Vector.make<Dependency>()
  let signatureAnswer = run demandChild(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies,
    signatureKey,
    Span.make(usize.ZERO, usize.ZERO),
  )
  let signatureFailure = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
    &signatureAnswer,
    answerRejection,
  )
  if let Option<Shared<Rejection>>.Some {value} = move signatureFailure {
    return rejectedBody(move value, move dependencies)
  }
  let selectedResult = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
    &signatureAnswer,
    signatureResult,
  )
  let resultType = match move selectedResult {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => {
      return rejectedBody(
        run reject(
          &resolver.*,
          &module,
          RejectionCode.Unsupported,
          Span.make(usize.ZERO, usize.ZERO),
        ),
        move dependencies,
      )
    }
  }
  let parameterCount = Shared.with<Result<Answer, NoRejection>, usize>(
    &signatureAnswer,
    signatureParameterCount,
  )
  let binderCount = Shared.with<Result<Answer, NoRejection>, usize>(
    &signatureAnswer,
    signatureBinderCount,
  )
  let mut contractBody = binderCount > usize.ZERO || !Shared.with<Type, bool>(
    &resultType,
    scalarType,
  )
  let boundCount = Shared.with<Result<Answer, NoRejection>, usize>(
    &signatureAnswer,
    signatureConstraintCount,
  )
  let mut constraints = Vector.make<Constraint>()
  let mut boundAt = usize.ZERO
  while boundAt < boundCount {
    let bound = Shared.with<Result<Answer, NoRejection>, Option<Constraint>>(
      &signatureAnswer,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Constraint> {
        return signatureConstraint(answer, boundAt)
      },
    )
    if let Option<Constraint>.Some {value} = move bound {
      run Vector.append<Constraint>(&mut constraints, move value)
    }
    boundAt = boundAt + usize.ONE
  }
  // A member body is checked under its implementation head's bounds, so
  // `impl<T: Serialize> Serialize for Vector<T>` may call `Serialize.serialize` on a `T`.
  let headFailure = run appendHeadBounds(&mut resolver.*, &mut owner.*, &mut dependencies, &module, key.module,
    key.declaration, &mut constraints)
  if let Option<Shared<Rejection>>.Some {value} = move headFailure {
    return rejectedBody(move value, move dependencies)
  }
  let sourceAnswer = run source(&mut resolver.*, &module)
  let mut annotationIds = Vector.make<HirId>()
  let mut writtenCalls = Vector.make<CallSyntax>()
  if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(
    &resolver.*,
    &sourceAnswer,
    &module,
  ) {
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(indexed))
    if key.declaration < declarations.length {
      let hir = IndexedSource.authored(indexed)
      if let Node.Declaration {body, ..} = Module.node(hir, declarations[key.declaration].local) {
        if let Node.CallableBody {block} = Module.node(hir, body) {
          if block.present {
            if let Node.Block {statements} = Module.node(hir, block.id) {
              run collectBodySyntax(hir, statements, &mut annotationIds, &mut writtenCalls)
            }
          }
        }
      }
    }
  }
  let facts = run resolveBodyFacts(
    &mut resolver.*, &mut owner.*, &mut dependencies, &module, key.module,
    key.declaration, &annotationIds, &writtenCalls,
  )
  let bodyFacts = match move facts {
    Result<BodyFacts, Shared<Rejection>>.Success {value: preparedFacts} => move preparedFacts
    Result<BodyFacts, Shared<Rejection>>.Failure {error} => {
      return rejectedBody(move error, move dependencies)
    }
  }
  let BodyFacts {annotations, calls: writtenFacts} = move bodyFacts
  let mut resolvedCalls = move writtenFacts
  let mut selectedResults = Vector.make<SelectedFact>()
  // A Body key whose member names a selected application checks only that selection's residual.
  if key.member != usize.ZERO {
    // Selection runs inside the complete semantic application, so generic and scoped bodies
    // reach the static callees their own bindings select.
    let application = run selectedApplicationAt(&resolver.*, key.member - usize.ONE)
    let selection = run selectionFacts(&mut resolver.*, &mut owner.*, &mut dependencies, &module, &application)
    match move selection {
      Result<Vector<ResolvedCall>, Shared<Rejection>>.Success {value: selectedSet} => {
        let selectedFacts = Vector.asSlice<ResolvedCall>(&selectedSet)
        let mut factAt = usize.ZERO
        while factAt < selectedFacts.length {
          let fact = selectedFact(selectedFacts, selectedFacts[factAt].id)
          if let Option<SelectionFact>.Some {value} = move fact {
            match &value {
              SelectionFact.Condition {selected: chosen} => run Vector.append<SelectedFact>(&mut selectedResults,
                SelectedFact.Decision {condition: selectedFacts[factAt].id, selected: chosen})
              SelectionFact.StaticBinding {value: bound} => run Vector.append<SelectedFact>(&mut selectedResults,
                SelectedFact.Binding {binder: selectedFacts[factAt].id, value: StaticValue.copy(&bound)})
              SelectionFact.StaticArguments {slots} => run Vector.append<SelectedFact>(&mut selectedResults,
                SelectedFact.Arguments {call: selectedFacts[factAt].id, slots: Shared.clone<Vector<StaticSlot>>(&slots)})
              SelectionFact.Embedded {..} => {}
              SelectionFact.StaticFor {..} => {}
            }
            run Vector.append<ResolvedCall>(&mut resolvedCalls, ResolvedCall {
              id: selectedFacts[factAt].id,
              result: Result.succeed<ResolvedTarget, Shared<Rejection>>(ResolvedTarget.Selected {fact: move value}),
            })
          }
          factAt = factAt + usize.ONE
        }
      }
      Result<Vector<ResolvedCall>, Shared<Rejection>>.Failure {error} => {
        return rejectedBody(move error, move dependencies)
      }
    }
  }
  let prepared = match move sourceOf(&resolver.*, &sourceAnswer, &module) {
    Option<&IndexedSource>.Some {value: indexed} => run prepareBody(
      &resolver.*,
      &module,
      indexed,
      key.declaration,
      &signatureAnswer,
      parameterCount,
      contractBody,
      key.member != usize.ZERO,
    )
    Option<&IndexedSource>.None => Result.failResult<PreparedBody, Shared<Rejection>>(
      run reject(&resolver.*, &module, RejectionCode.Unsupported, Span.make(usize.ZERO, usize.ZERO)),
    )
  }
  let preparedBody = match move prepared {
    Result<PreparedBody, Shared<Rejection>>.Success {value} => value
    Result<PreparedBody, Shared<Rejection>>.Failure {error} => {
      return rejectedBody(move error, move dependencies)
    }
  }
  let PreparedBody {block, identity, locals: preparedLocals, contractBody: abstractBody, staticBody} = move preparedBody
  let mut locals = move preparedLocals
  let initialLocals = Vector.length<BodyLocal>(&locals)
  let mut nodes = Vector.make<BodyNode>()
  let mut signatureDependencies = Vector.make<SignatureDependency>()
  run Vector.append<SignatureDependency>(
    &mut signatureDependencies,
    SignatureDependency {declaration: run DeclarationId.copy(&identity)},
  )
  let mut requiredBodies = Vector.make<DeclarationId>()
  let available = run SourceIndex.authoredCursor(&mut resolver.source, &sourceAnswer, &module)
  let cursor = match move available {
    Option<AuthoredCursor>.Some {value} => value
    Option<AuthoredCursor>.None => {
      return rejectedBody(
        run reject(
          &resolver.*,
          &module,
          RejectionCode.Unsupported,
          Span.make(usize.ZERO, usize.ZERO),
        ),
        move dependencies,
      )
    }
  }
  let mut operationRequest = Request.make()
  run enterBodyFrame(&mut resolver.*, &signatureAnswer)
  let checked = run checkBlock(
    &mut resolver.*,
    &mut owner.*,
    &mut operationRequest,
    &mut dependencies,
    &module,
    &cursor,
    &identity,
    &mut locals,
    Vector.asSlice<ResolvedAnnotation>(&annotations),
    Vector.asSlice<ResolvedCall>(&resolvedCalls),
    &mut nodes,
    &mut signatureDependencies,
    &mut requiredBodies,
    block,
    &resultType,
    Vector.asSlice<Constraint>(&constraints),
    abstractBody,
    staticBody,
    usize.ZERO,
    false,
  )
  run takeOccurrenceFacts(&mut resolver.*, &mut selectedResults)
  let relations = leaveBodyFrame(&mut resolver.*)
  let control = match move checked {
    Result<CheckedControl, Shared<Rejection>>.Success {value} => value
    Result<CheckedControl, Shared<Rejection>>.Failure {error} => {
      return rejectedBody(move error, move dependencies)
    }
  }
  if let Option<Span>.Some {value: stranded} = move strandedInterfaceEffect(Vector.asSlice<BodyNode>(&nodes)) {
    return rejectedBody(run reject(&resolver.*, &module, RejectionCode.InterfaceEffectUnavailable, stranded), move dependencies)
  }
  let family = Shared.with<Type, Option<Shared<Type>>>(&resultType, effectFamilyContract)
  if !run writtenOpaqueResult(&mut resolver.*, &module, key.declaration) {
    if let Option<Shared<Type>>.Some {value: contract} = move family {
      let refused = run joinEffectReturns(&resolver.*, &module, &mut nodes, &contract)
      if let Option<Shared<Rejection>>.Some {value} = move refused { return rejectedBody(move value, move dependencies) }
    }
  }
  let availability = run captureAvailability(&resolver.*, &module, &cursor, Vector.asSlice<BodyNode>(&nodes), control.node, initialLocals, Vector.asSlice<Constraint>(&constraints))
  if let Option<Shared<Rejection>>.Some {value} = move availability {
    return rejectedBody(move value, move dependencies)
  }
  if staticBody {
    let checkedNodes = Vector.asSlice<BodyNode>(&nodes)
    let mut at = usize.ZERO
    while at < checkedNodes.length {
      if let BodyNodeKind.Expression {form: BodyExpression.InterfaceCall {..}, ..} = &checkedNodes[at].kind {
        return rejectedBody(
          run reject(
            &resolver.*,
            &module,
            RejectionCode.StaticPhaseViolation,
            checkedNodes[at].origin.span,
          ),
          move dependencies,
        )
      }
      if let BodyNodeKind.Expression {form: BodyExpression.DirectCall {declaration, ..}, ..} = &checkedNodes[at].kind {
        let called = run DeclarationId.copy(&declaration)
        let calledModule = DeclarationId.moduleId(&called)
        let targetModuleOrdinal = knownModuleOrdinal(&resolver.*, calledModule)
        if targetModuleOrdinal == usize.MAX {
          return rejectedBody(
            run reject(
              &resolver.*,
              &module,
              RejectionCode.StaticPhaseViolation,
              checkedNodes[at].origin.span,
            ),
            move dependencies,
          )
        }
        let targetModule = run resolvedModule(&resolver.*, targetModuleOrdinal)
        let sharedCalled = run Shared.make<DeclarationId>(move called)
        let ordinal = run ordinalOfIdentity(&mut resolver.*, &targetModule, &sharedCalled)
        let mut allowed = false
        if let Option<usize>.Some {value: position} = move ordinal {
          let written = run signatureSyntax(&mut resolver.*, &targetModule, position)
          if let Option<WrittenSignature>.Some {value} = move written {
            allowed = value.isStatic
          }
        }
        if !allowed {
          return rejectedBody(
            run reject(
              &resolver.*,
              &module,
              RejectionCode.StaticPhaseViolation,
              checkedNodes[at].origin.span,
            ),
            move dependencies,
          )
        }
      }
      at = at + usize.ONE
    }
    requiredBodies = Vector.make<DeclarationId>()
  }
  if control.canComplete && Shared.with<Type, usize>(&resultType, scalarCode) != 1 {
    if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(
      &resolver.*,
      &sourceAnswer,
      &module,
    ) {
      let hir = IndexedSource.authored(indexed)
      let mut returnSpan = Module.span(hir, block)
      if Module.causeRange(hir, block).length == usize.ZERO && returnSpan.end > returnSpan.start {
        returnSpan = Span.make(returnSpan.end - usize.ONE, returnSpan.end)
      }
      return rejectedBody(
        run reject(&resolver.*, &module, RejectionCode.MissingReturn, returnSpan),
        move dependencies,
      )
    }
    return rejectedBody(
      run reject(&resolver.*, &module, RejectionCode.Unsupported, Span.make(usize.ZERO, usize.ZERO)),
      move dependencies,
    )
  }
  let mut stage = BodyStage.FullyChecked
  if abstractBody || Vector.length<BodySafetyObligation>(&relations) > usize.ZERO
    || bodyHasReceiverPass(Vector.asSlice<BodyNode>(&nodes)) || bodyHasLoans(Vector.asSlice<BodyNode>(&nodes)) {
    stage = BodyStage.ContractTyped {
      obligations: run bodySafetyObligations(
        &identity,
        Vector.asSlice<BodyLocal>(&locals),
        Vector.asSlice<BodyNode>(&nodes),
        Vector.asSlice<Constraint>(&constraints),
        move relations,
      ),
    }
  }
  let selectedInput = run SourceIndex.bodyInput(&mut resolver.source, &sourceAnswer, &module, key.declaration)
  let input = match move selectedInput {
    Option<Shared<BodyInput>>.Some {value: captured} => move captured
    Option<Shared<BodyInput>>.None => {
      return rejectedBody(run reject(&resolver.*, &module, RejectionCode.Unsupported, Span.make(usize.ZERO, usize.ZERO)), move dependencies)
    }
  }
  if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(
    &resolver.*,
    &sourceAnswer,
    &module,
  ) {
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(indexed))
    let declaration = &declarations[key.declaration].identity
    let body = run TypedBody.make(
      declaration,
      move input,
      move locals,
      move nodes,
      control.node,
      move signatureDependencies,
      move requiredBodies,
      move stage,
      move selectedResults,
    )
    return Answer {
      outcome: Outcome.Success {
        value: Value.Body {
          body: run Shared.make<TypedBody>(move body),
          source: run Shared.make<Observation>(
            run Observation.copy(IndexedSource.sourceObservation(indexed)),
          ),
        },
      },
      dependencies: move dependencies,
      sources: Vector.make<Shared<Observation>>(),
      footprint: Vector.make<Shared<DemandFootprint>>(),
      answerId: usize.ZERO,
      identity: Option.none<Shared<Value>>(),
      bodyEvidence: Option.none<Shared<BodyEvidence>>(),
    }
  }
  return rejectedBody(
    run reject(&resolver.*, &module, RejectionCode.Unsupported, Span.make(usize.ZERO, usize.ZERO)),
    move dependencies,
  )
}

fn hasRejection(answer: &Result<Answer, NoRejection>) -> bool {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Rejected {diagnostic: _} => true
      Outcome.Success {value: _} => false
    }
    Result<Answer, NoRejection>.Failure {error: _} => false
  }
}

effect fn rejectRoot(
  resolver: &mut Resolver,
  module: &ModuleId,
  bucket: Key,
  code: RejectionCode,
  span: Span,
) -> Shared<Result<Answer, NoRejection>> ! Cycle | OutOfMemoryError ? &mut Allocator {
  let mut dependencies = Vector.make<Dependency>()
  run Vector.append<Dependency>(&mut dependencies, dependency(bucket))
  let mut sources = Vector.make<Shared<Observation>>()
  run Vector.append<Shared<Observation>>(
    &mut sources,
    run Shared.make<Observation>(run SourceIndex.captureObservation(&resolver.source, module)),
  )
  let diagnostic = run reject(&resolver.*, module, code, span)
  return run Shared.make<Result<Answer, NoRejection>>(
    Result.succeed<Answer, NoRejection>(
      Answer {
        outcome: Outcome.Rejected {diagnostic: move diagnostic},
        dependencies: move dependencies,
        sources: move sources,
        footprint: Vector.make<Shared<DemandFootprint>>(),
        answerId: usize.ZERO,
        identity: Option.none<Shared<Value>>(),
        bodyEvidence: Option.none<Shared<BodyEvidence>>(),
      },
    ),
  )
}

effect fn demandNamed(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  module: &ModuleId,
  name: &[u8],
  family: Family,
) -> Shared<Result<Answer, NoRejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let moduleOrdinal = run internModule(&mut resolver.*, module)
  let nameOrdinal = run internName(&mut resolver.*, name)
  let bucketKey = Key {
    family: Family.Name,
    module: moduleOrdinal,
    name: nameOrdinal,
    declaration: usize.ZERO,
    member: usize.ZERO,
    external: false,
  }
  let observed = run demandRaw(
    &mut resolver.*,
    &mut owner.*,
    bucketKey,
    Span.make(usize.ZERO, usize.ZERO),
  )
  if Shared.with<Result<Answer, NoRejection>, bool>(&observed, hasRejection) {
    return move observed
  }
  drop observed
  // A root lookup observes governing conditions without a dependent answer.
  let mut rootConditions = Vector.make<Dependency>()
  let selectedSelection = run select(&mut resolver.*, &mut owner.*, &mut rootConditions, module, name, false)
  let selected = match move selectedSelection {
    Result<Selection, Shared<Rejection>>.Success {value: selectedValue} => selectedValue
    Result<Selection, Shared<Rejection>>.Failure {error} => {
      return run rootRejection(&mut resolver.*, module, move error)
    }
  }
  if selected.count != usize.ONE {
    let mut code = RejectionCode.Collision
    if selected.count == usize.ZERO {
      code = RejectionCode.UnknownName
    }
    return run rejectRoot(&mut resolver.*, module, bucketKey, code, selected.span)
  }
  if selected.kind != CandidateKind.Declaration {
    return run rejectRoot(
      &mut resolver.*,
      module,
      bucketKey,
      RejectionCode.Unsupported,
      selected.span,
    )
  }
  let mut backendName = usize.ZERO
  if family == Family.Mir {
    let declared = run declarationAt(&mut resolver.*, module, selected.declaration)
    let identity = match move declared {
      Option<DeclarationId>.Some {value} => run Shared.make<DeclarationId>(move value)
      Option<DeclarationId>.None => {
        return run rejectRoot(
          &mut resolver.*,
          module,
          bucketKey,
          RejectionCode.UnknownName,
          selected.span,
        )
      }
    }
    let instance = run InstanceKey.named(&identity)
    backendName = run internBackendInstance(&mut resolver.*, &instance, false)
  }
  let key = Key {
    family: family,
    module: moduleOrdinal,
    name: backendName,
    declaration: selected.declaration,
    member: usize.ZERO,
    external: false,
  }
  return run demandRaw(&mut resolver.*, &mut owner.*, key, selected.span)
}

fn copyGoal(goal: &ConformanceGoal) -> ConformanceGoal {
  return ConformanceGoal {
    contract: Shared.clone<Type>(&goal.contract),
    provider: Shared.clone<Type>(&goal.provider),
  }
}

effect fn declaredGoal(constraints: &[Constraint], goal: &ConformanceGoal) -> Option<Constraint>
! OutOfMemoryError
? &mut Allocator {
  // A concrete application must establish real evidence even if its caller supplied a copied
  // constraint. Declared bounds are assumptions only for goals that still contain open binders.
  if !Type.hasOpenParameters(&goal.provider) && !Type.hasOpenParameters(&goal.contract) {
    return Option.none<Constraint>()
  }
  let mut at = usize.ZERO
  while at < constraints.length {
    if let Constraint.Conforms {provider, contract} = &constraints[at] {
      // Exact identity, including lifetimes and all interface arguments, is declared evidence.
      let sameProvider = run Type.equalsShared(&provider, &goal.provider)
      let sameContract = run Type.equalsShared(&contract, &goal.contract)
      if sameProvider && sameContract {
        return Option.some<Constraint>(
          Constraint.Conforms {
            provider: Shared.clone<Type>(&provider),
            contract: Shared.clone<Type>(&contract),
          },
        )
      }
    }
    at = at + usize.ONE
  }
  return Option.none<Constraint>()
}

fn matchedArgument(bindings: &[Binding], owner: &Shared<DeclarationId>, ordinal: usize) -> Option<
  Argument,
> {
  let mut at = usize.ZERO
  while at < bindings.length {
    if bindings[at].ordinal == ordinal && sameDeclarationShared(&bindings[at].declaration, owner) {
      return Option.some<Argument>(copyArgument(&bindings[at].value))
    }
    at = at + usize.ONE
  }
  return Option.none<Argument>()
}

// Re-resolve the written bounds under the exact head bindings. This uses the same canonical type
// resolver as declaration checking, including nested type, lifetime, and requirement-row arguments.
// No second type matcher or partial type substitution is introduced for proof.
effect fn appliedConstraints(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  head: &Shared<ImplementationHead>,
  bindings: &[Binding],
) -> Result<Vector<Constraint>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let identity = Shared.with<ImplementationHead, Shared<DeclarationId>>(
    head,
    fn(value: &ImplementationHead) -> Shared<DeclarationId> {
      return Shared.clone<DeclarationId>(&value.declaration)
    },
  )
  let moduleOrdinal = Shared.with<DeclarationId, usize>(
    &identity,
    fn(value: &DeclarationId) -> usize {
      return knownModuleOrdinal(&resolver.*, DeclarationId.moduleId(value))
    },
  )
  if moduleOrdinal == usize.MAX {
    fail InvalidModulePath {}
  }
  let module = run resolvedModule(&resolver.*, moduleOrdinal)
  let located = run ordinalOfIdentity(&mut resolver.*, &module, &identity)
  let ordinal = match move located {
    Option<usize>.Some {value} => value
    Option<usize>.None => {
      return Result.failResult<Vector<Constraint>, Shared<Rejection>>(
        run reject(
          &resolver.*,
          &module,
          RejectionCode.UnknownMember,
          Span.make(usize.ZERO, usize.ZERO),
        ),
      )
    }
  }
  let written = run header(&mut resolver.*, &module, ordinal)
  let mut generics = Range.empty()
  let mut subject = HirId {index: usize.ZERO}
  let mut target = HirRef.absent()
  let mut span = Span.make(usize.ZERO, usize.ZERO)
  if let Option<HeaderSyntax>.Some {value} = move written {
    span = value.span
    if let Node.ImplHeader {generics: parameters, subject: named, target: provided} = value.header {
      generics = parameters
      subject = named
      target = provided
    }
  }
  if !target.present {
    return Result.failResult<Vector<Constraint>, Shared<Rejection>>(
      run reject(&resolver.*, &module, RejectionCode.Unsupported, span),
    )
  }
  let template = run templateBinders(&mut resolver.*, &module, ordinal)
  let formal = match move template {
    Result<Vector<Binder>, Shared<Rejection>>.Success {value} => move value
    Result<Vector<Binder>, Shared<Rejection>>.Failure {error} => {
      return Result.failResult<Vector<Constraint>, Shared<Rejection>>(move error)
    }
  }
  let mut arguments = Vector.make<Argument>()
  let writtenCount = Vector.length<Binder>(&formal)
  let mut at = usize.ZERO
  while at < writtenCount {
    let found = matchedArgument(bindings, &identity, at)
    let argument = match move found {
      Option<Argument>.Some {value} => move value
      Option<Argument>.None => {
        return Result.failResult<Vector<Constraint>, Shared<Rejection>>(
          run reject(&resolver.*, &module, RejectionCode.Unsupported, span),
        )
      }
    }
    run Vector.append<Argument>(&mut arguments, move argument)
    at = at + usize.ONE
  }
  let applied = run bindArguments(
    Vector.asSlice<Binder>(&formal),
    Vector.asSlice<Argument>(&arguments),
  )
  let declared = run declarationAt(&mut resolver.*, &module, ordinal)
  let implementation = match move declared {
    Option<DeclarationId>.Some {value} => move value
    Option<DeclarationId>.None => {
      return Result.failResult<Vector<Constraint>, Shared<Rejection>>(
        run reject(&resolver.*, &module, RejectionCode.UnknownMember, span),
      )
    }
  }
  let mut elision = LifetimeElision {
    owner: Option.some<DeclarationId>(move implementation),
    nextOrdinal: writtenCount,
    output: false,
    resultDefault: Option.none<Shared<Lifetime>>(),
    generated: Vector.make<Shared<Lifetime>>(),
    invocation: false,
    nested: false,
    renumber: Vector.make<usize>(),
    staticEnvironment: false,
    supplied: Option.none<Vector<Argument>>(),
    assumptions: Option.none<Vector<Constraint>>(),
  }
  let contract = run resolveType(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies.*,
    moduleOrdinal,
    subject,
    Vector.asSlice<Binder>(&applied),
    &mut elision,
  )
  if let Result<Shared<Type>, Shared<Rejection>>.Failure {error} = move contract {
    return Result.failResult<Vector<Constraint>, Shared<Rejection>>(move error)
  }
  let provider = run resolveType(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies.*,
    moduleOrdinal,
    target.id,
    Vector.asSlice<Binder>(&applied),
    &mut elision,
  )
  if let Result<Shared<Type>, Shared<Rejection>>.Failure {error} = move provider {
    return Result.failResult<Vector<Constraint>, Shared<Rejection>>(move error)
  }
  return run resolveConstraints(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies.*,
    moduleOrdinal,
    &module,
    generics,
    Vector.asSlice<Binder>(&applied),
    &mut elision,
    false,
  )
}

// Bound application is a query so named types and aliases in the written header are resolved
// under an active dependency owner. The key includes both normalized goal applications.
effect fn resolveProofBounds(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  key: Key,
) -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let module = run resolvedModule(&resolver.*, key.module)
  let mut dependencies = Vector.make<Dependency>()
  let headAnswer = run demandChild(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies,
    Key {
      family: Family.ImplementationHead,
      module: key.module,
      name: usize.ZERO,
      declaration: key.declaration,
      member: usize.ZERO,
      external: false,
    },
    Span.make(usize.ZERO, usize.ZERO),
  )
  let found = Shared.with<Result<Answer, NoRejection>, Option<Shared<ImplementationHead>>>(
    &headAnswer,
    headOf,
  )
  let head = match move found {
    Option<Shared<ImplementationHead>>.Some {value} => move value
    Option<Shared<ImplementationHead>>.None => {
      let rejected = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
        &headAnswer,
        answerRejection,
      )
      let diagnostic = match move rejected {
        Option<Shared<Rejection>>.Some {value} => move value
        Option<Shared<Rejection>>.None => run reject(
          &resolver.*,
          &module,
          RejectionCode.UnknownMember,
          Span.make(usize.ZERO, usize.ZERO),
        )
      }
      return memberRejected(move diagnostic, move dependencies)
    }
  }
  let applications = Vector.asSlice<Shared<Type>>(&resolver.applications)
  let goal = ConformanceGoal {
    contract: Shared.clone<Type>(&applications[key.name]),
    provider: Shared.clone<Type>(&applications[key.member]),
  }
  let mut bindings = Vector.make<Binding>()
  let matched = run matchConformanceHead(&head, &goal, &mut bindings)
  if !exactHeadMatched(&matched) {
    let span = Shared.with<ImplementationHead, Span>(
      &head,
      fn(value: &ImplementationHead) -> Span {
        return value.span
      },
    )
    return memberRejected(
      run reject(&resolver.*, &module, RejectionCode.Unsupported, span),
      move dependencies,
    )
  }
  let applied = run appliedConstraints(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies,
    &head,
    Vector.asSlice<Binding>(&bindings),
  )
  return match move applied {
    Result<Vector<Constraint>, Shared<Rejection>>.Success {value} => memberSuccess(
      Value.ProofBounds {constraints: move value},
      move dependencies,
    )
    Result<Vector<Constraint>, Shared<Rejection>>.Failure {error} => memberRejected(
      move error,
      move dependencies,
    )
  }
}

fn proofBoundCount(answer: &Result<Answer, NoRejection>) -> usize {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.ProofBounds {constraints}} = &value.outcome {
      return Vector.length<Constraint>(&constraints)
    }
  }
  return usize.MAX
}

fn proofBoundAt(answer: &Result<Answer, NoRejection>, at: usize) -> Option<Constraint> {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.ProofBounds {constraints}} = &value.outcome {
      let written = Vector.asSlice<Constraint>(&constraints)
      if at < written.length {
        return Option.some<Constraint>(copyConstraint(&written[at]))
      }
    }
  }
  return Option.none<Constraint>()
}

effect fn matchConformanceHead(
  head: &Shared<ImplementationHead>,
  goal: &ConformanceGoal,
  bindings: &mut Vector<Binding>,
) -> Unification ! OutOfMemoryError ? &mut Allocator {
  let terms = Shared.with<ImplementationHead, Option<HeadTerms>>(head, headTerms)
  let found = match move terms {
    Option<HeadTerms>.Some {value} => move value
    Option<HeadTerms>.None => {
      return Unification.Distinct
    }
  }
  let mut left = Vector.make<Shared<Type>>()
  run Vector.append<Shared<Type>>(&mut left, Shared.clone<Type>(&found.contract))
  run Vector.append<Shared<Type>>(&mut left, Shared.clone<Type>(&found.provider))
  let mut right = Vector.make<Shared<Type>>()
  run Vector.append<Shared<Type>>(&mut right, Shared.clone<Type>(&goal.contract))
  run Vector.append<Shared<Type>>(&mut right, Shared.clone<Type>(&goal.provider))
  let mut variables = Vector.make<Shared<DeclarationId>>()
  run Vector.append<Shared<DeclarationId>>(&mut variables, move found.declaration)
  return run Type.unifyAll(
    Vector.asSlice<Shared<Type>>(&left),
    Vector.asSlice<Shared<Type>>(&right),
    Vector.asSlice<Shared<DeclarationId>>(&variables),
    Comparison.Exact,
    &mut bindings.*,
  )
}

fn exactHeadMatched(answer: &Unification) -> bool {
  return match & answer.* {
    Unification.Unified => true
    _ => false
  }
}

fn exactHeadUndetermined(answer: &Unification) -> bool {
  return match & answer.* {
    Unification.Undetermined {..} => true
    _ => false
  }
}

effect fn proofFailure(resolver: &Resolver, module: &ModuleId, code: RejectionCode, span: Span) -> Shared<
  Rejection,
> ! OutOfMemoryError ? &mut Allocator {
  return run reject(resolver, &module, code, span)
}

// Root proofs record the demanded fact on their request. A proof made while validating a
// witness instead records each fact as a child of that witness, so edits invalidate the answer.
effect fn proofDemand(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut Vector<Dependency>,
  key: Key,
  span: Span,
  nested: bool,
) -> Shared<Result<Answer, NoRejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  if nested {
    return run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, key, span)
  }
  let family = key.family
  let moduleOrdinal = key.module
  let answer = run demandRaw(&mut resolver.*, &mut owner.*, key, span)
  let module = run resolvedModule(&resolver.*, moduleOrdinal)
  run recordRoot(&mut request.*, family, &module, b"", &answer)
  return move answer
}

effect fn proveGoal(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut Vector<Dependency>,
  nested: bool,
  avoid: &Option<Shared<DeclarationId>>,
  goal: &ConformanceGoal,
  declared: &[Constraint],
  siteModule: &ModuleId,
  siteSpan: Span,
  chain: &mut Vector<ConformanceGoal>,
  steps: &mut Vector<ConformanceStep>,
) -> Option<Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let mark = Vector.length<ConformanceGoal>(&chain.*)
  run Vector.append<ConformanceGoal>(&mut chain.*, copyGoal(goal))
  let assumed = run declaredGoal(declared, goal)
  if let Option<Constraint>.Some {value: bound} = move assumed {
    run Vector.append<ConformanceStep>(
      &mut steps.*,
      ConformanceStep {
        goal: copyGoal(goal),
        evidence: ConformanceEvidence.Declared {bound: move bound},
      },
    )
    Vector.truncate<ConformanceGoal>(&mut chain.*, mark)
    return Option.none<Shared<Rejection>>()
  }
  let contractModuleOrdinal = declaringModuleOrdinal(&resolver.*, &goal.contract)
  if contractModuleOrdinal == usize.MAX {
    fail InvalidModulePath {}
  }
  let contractModule = run resolvedModule(&resolver.*, contractModuleOrdinal)
  let contractOrdinal = run ordinalOfProvider(&mut resolver.*, &contractModule, &goal.contract)
  let contractPosition = match move contractOrdinal {
    Option<usize>.Some {value} => value
    Option<usize>.None => {
      fail InvalidModulePath {}
    }
  }
  let providerApplication = run internApplication(&mut resolver.*, &goal.provider)
  let bucket = run proofDemand(
    &mut resolver.*,
    &mut owner.*,
    &mut request.*,
    &mut dependencies.*,
    Key {
      family: Family.ConformanceHeads,
      module: contractModuleOrdinal,
      name: providerApplication,
      declaration: contractPosition,
      member: usize.ZERO,
      external: false,
    },
    siteSpan,
    nested,
  )
  let failed = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
    &bucket,
    answerRejection,
  )
  if let Option<Shared<Rejection>>.Some {value} = move failed {
    return Option.some<Shared<Rejection>>(move value)
  }
  let count = Shared.with<Result<Answer, NoRejection>, usize>(&bucket, bucketCount)
  let mut heads = Vector.make<Shared<ImplementationHead>>()
  let mut at = usize.ZERO
  while at < count {
    let candidate = Shared.with<Result<Answer, NoRejection>, Option<Shared<ImplementationHead>>>(
      &bucket,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<ImplementationHead>> {
        return bucketAt(answer, at)
      },
    )
    if let Option<Shared<ImplementationHead>>.Some {value: head} = move candidate {
      let identity = Shared.with<ImplementationHead, Shared<DeclarationId>>(
        &head,
        fn(value: &ImplementationHead) -> Shared<DeclarationId> {
          return Shared.clone<DeclarationId>(&value.declaration)
        },
      )
      let moduleOrdinal = Shared.with<DeclarationId, usize>(
        &identity,
        fn(value: &DeclarationId) -> usize {
          return knownModuleOrdinal(&resolver.*, DeclarationId.moduleId(value))
        },
      )
      if moduleOrdinal == usize.MAX {
        fail InvalidModulePath {}
      }
      let module = run resolvedModule(&resolver.*, moduleOrdinal)
      let ordinal = run ordinalOfIdentity(&mut resolver.*, &module, &identity)
      let position = match move ordinal {
        Option<usize>.Some {value} => value
        Option<usize>.None => {
          return Option.some<Shared<Rejection>>(
            run proofFailure(&resolver.*, siteModule, RejectionCode.UnknownMember, siteSpan),
          )
        }
      }
      let implementation = run declarationAt(&mut resolver.*, &module, position)
      if let Option<DeclarationId>.None = move implementation {
        return Option.some<Shared<Rejection>>(
          run proofFailure(&resolver.*, siteModule, RejectionCode.UnknownMember, siteSpan),
        )
      }
      // The entire owner bucket must be coherent before a candidate may become applicable.
      let coherence = run proofDemand(
        &mut resolver.*,
        &mut owner.*,
        &mut request.*,
        &mut dependencies.*,
        Key {
          family: Family.Coherence,
          module: moduleOrdinal,
          name: usize.ZERO,
          declaration: position,
          member: usize.ZERO,
          external: false,
        },
        siteSpan,
        nested,
      )
      let rejected = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
        &coherence,
        answerRejection,
      )
      if let Option<Shared<Rejection>>.Some {value} = move rejected {
        return Option.some<Shared<Rejection>>(move value)
      }
      run Vector.append<Shared<ImplementationHead>>(&mut heads, move head)
    }
    at = at + usize.ONE
  }
  let mut selected = Option.none<Shared<ImplementationHead>>()
  let mut selectedBindings = Vector.make<Binding>()
  let mut undecided = false
  let coherent = Vector.asSlice<Shared<ImplementationHead>>(&heads)
  at = usize.ZERO
  while at < coherent.length {
    let mut bindings = Vector.make<Binding>()
    let answer = run matchConformanceHead(&coherent[at], goal, &mut bindings)
    if exactHeadMatched(&answer) {
      if let Option<Shared<ImplementationHead>>.Some {value: _} = &selected {
        return Option.some<Shared<Rejection>>(
          run proofFailure(&resolver.*, siteModule, RejectionCode.OverlappingConformance, siteSpan),
        )
      }
      selected = Option.some<Shared<ImplementationHead>>(
        Shared.clone<ImplementationHead>(&coherent[at]),
      )
      selectedBindings = move bindings
    }
    if exactHeadUndetermined(&answer) {
      undecided = true
    }
    at = at + usize.ONE
  }
  let head = match move selected {
    Option<Shared<ImplementationHead>>.Some {value} => move value
    Option<Shared<ImplementationHead>>.None => {
      let mut code = RejectionCode.MissingConformance
      if undecided {
        code = RejectionCode.Unsupported
      }
      return Option.some<Shared<Rejection>>(
        run proofFailure(&resolver.*, siteModule, code, siteSpan),
      )
    }
  }
  if undecided {
    return Option.some<Shared<Rejection>>(
      run proofFailure(&resolver.*, siteModule, RejectionCode.Unsupported, siteSpan),
    )
  }
  let identity = Shared.with<ImplementationHead, Shared<DeclarationId>>(
    &head,
    fn(value: &ImplementationHead) -> Shared<DeclarationId> {
      return Shared.clone<DeclarationId>(&value.declaration)
    },
  )
  let moduleOrdinal = Shared.with<DeclarationId, usize>(
    &identity,
    fn(value: &DeclarationId) -> usize {
      return knownModuleOrdinal(&resolver.*, DeclarationId.moduleId(value))
    },
  )
  if moduleOrdinal == usize.MAX {
    fail InvalidModulePath {}
  }
  let module = run resolvedModule(&resolver.*, moduleOrdinal)
  let located = run ordinalOfIdentity(&mut resolver.*, &module, &identity)
  let ordinal = match move located {
    Option<usize>.Some {value} => value
    Option<usize>.None => {
      return Option.some<Shared<Rejection>>(
        run proofFailure(&resolver.*, siteModule, RejectionCode.UnknownMember, siteSpan),
      )
    }
  }
  let contractApplication = run internApplication(&mut resolver.*, &goal.contract)
  let boundProviderApplication = run internApplication(&mut resolver.*, &goal.provider)
  let bounds = run proofDemand(
    &mut resolver.*,
    &mut owner.*,
    &mut request.*,
    &mut dependencies.*,
    Key {
      family: Family.ProofBounds,
      module: moduleOrdinal,
      name: contractApplication,
      declaration: ordinal,
      member: boundProviderApplication,
      external: false,
    },
    siteSpan,
    nested,
  )
  let rejected = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
    &bounds,
    answerRejection,
  )
  if let Option<Shared<Rejection>>.Some {value} = move rejected {
    return Option.some<Shared<Rejection>>(move value)
  }
  let boundCount = Shared.with<Result<Answer, NoRejection>, usize>(&bounds, proofBoundCount)
  if boundCount == usize.MAX {
    return Option.some<Shared<Rejection>>(
      run proofFailure(&resolver.*, siteModule, RejectionCode.Unsupported, siteSpan),
    )
  }
  let mut required = Vector.make<Constraint>()
  let mut bound = usize.ZERO
  while bound < boundCount {
    let found = Shared.with<Result<Answer, NoRejection>, Option<Constraint>>(
      &bounds,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Constraint> {
        return proofBoundAt(answer, bound)
      },
    )
    if let Option<Constraint>.Some {value} = move found {
      run Vector.append<Constraint>(&mut required, move value)
    }
    bound = bound + usize.ONE
  }
  let all = Vector.asSlice<Constraint>(&required)
  at = usize.ZERO
  while at < all.length {
    // The selected head's own outlives premise never chose it; the caller proves it (LIFE-002).
    if let Constraint.Outlives {longer, shorter} = &all[at] {
      if !run knownOutlives(declared, &longer, &shorter) {
        return Option.some<Shared<Rejection>>(
          run proofFailure(&resolver.*, siteModule, unprovedOutlivesCode(&longer, &shorter), siteSpan),
        )
      }
      at = at + usize.ONE
      continue
    }
    if let Constraint.Conforms {provider, contract} = &all[at] {
      let requirement = ConformanceGoal {
        contract: Shared.clone<Type>(&contract),
        provider: Shared.clone<Type>(&provider),
      }
      let failed = run proveGoal(
        &mut resolver.*,
        &mut owner.*,
        &mut request.*,
        &mut dependencies.*,
        nested,
        avoid,
        &requirement,
        declared,
        siteModule,
        siteSpan,
        &mut chain.*,
        &mut steps.*,
      )
      if let Option<Shared<Rejection>>.Some {value} = move failed {
        return Option.some<Shared<Rejection>>(move value)
      }
    } else {
      return Option.some<Shared<Rejection>>(
        run proofFailure(&resolver.*, siteModule, RejectionCode.Unsupported, siteSpan),
      )
    }
    at = at + usize.ONE
  }
  // A coherent head and satisfied bounds still do not prove that its operations implement the
  // contract. Demand the deterministic static witnesses before admitting concrete evidence.
  if let Option<Shared<DeclarationId>>.Some {value: forbidden} = &avoid.* {
    if sameDeclarationShared(&identity, &forbidden) {
      return Option.some<Shared<Rejection>>(
        run proofFailure(&resolver.*, siteModule, RejectionCode.Unsupported, siteSpan),
      )
    }
  }
  let witnesses = run proofDemand(
    &mut resolver.*,
    &mut owner.*,
    &mut request.*,
    &mut dependencies.*,
    Key {
      family: Family.Witnesses,
      module: moduleOrdinal,
      name: usize.ZERO,
      declaration: ordinal,
      member: usize.ZERO,
      external: false,
    },
    siteSpan,
    nested,
  )
  let invalid = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
    &witnesses,
    answerRejection,
  )
  if let Option<Shared<Rejection>>.Some {value} = move invalid {
    return Option.some<Shared<Rejection>>(move value)
  }
  run Vector.append<ConformanceStep>(
    &mut steps.*,
    ConformanceStep {
      goal: copyGoal(goal),
      evidence: ConformanceEvidence.Concrete {head: move head, bindings: move selectedBindings},
    },
  )
  Vector.truncate<ConformanceGoal>(&mut chain.*, mark)
  return Option.none<Shared<Rejection>>()
}

struct ResolvedWitness {
  application: Application
  operands: Vector<OperandPass>
}

effect fn copyBindings(values: &[Binding]) -> Vector<Binding> ! OutOfMemoryError ? &mut Allocator {
  let mut copied = Vector.make<Binding>()
  let mut at = usize.ZERO
  while at < values.length {
    run Vector.append<Binding>(&mut copied, Binding {declaration: Shared.clone<DeclarationId>(&values[at].declaration),
      ordinal: values[at].ordinal, value: Argument.copy(&values[at].value)})
    at = at + usize.ONE
  }
  return move copied
}

// The witnesses of the concrete conformance a proved goal selects, with the head bindings that
// matched both contract and provider.
struct ProvenWitnesses {
  witnesses: Shared<Result<Answer, NoRejection>>
  bindings: Vector<Binding>
}

// Consume the existing proof's root step, whose head matched both contract and provider. Nested
// callers record these same proof facts as children of their MIR answer.
effect fn provenWitnesses(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut Vector<Dependency>,
  nested: bool,
  contract: &Shared<Type>,
  provider: &Shared<Type>,
  siteModule: &ModuleId,
  siteSpan: Span,
) -> Result<Option<ProvenWitnesses>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let goal = ConformanceGoal {
    contract: Shared.clone<Type>(contract), provider: Shared.clone<Type>(provider),
  }
  let mut chain = Vector.make<ConformanceGoal>()
  let mut steps = Vector.make<ConformanceStep>()
  let declared = Vector.make<Constraint>()
  let avoid = Option.none<Shared<DeclarationId>>()
  let failed = run proveGoal(
    &mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, nested, &avoid,
    &goal, Vector.asSlice<Constraint>(&declared), siteModule, siteSpan, &mut chain, &mut steps,
  )
  if let Option<Shared<Rejection>>.Some {value} = move failed {
    return Result.failResult<Option<ProvenWitnesses>, Shared<Rejection>>(move value)
  }
  let complete = Vector.asSlice<ConformanceStep>(&steps)
  if complete.length > usize.ZERO {
    if let ConformanceEvidence.Concrete {head, bindings} = &complete[complete.length - usize.ONE].evidence {
      let identity = Shared.with<ImplementationHead, Shared<DeclarationId>>(&head,
        fn(value: &ImplementationHead) -> Shared<DeclarationId> {
          return Shared.clone<DeclarationId>(&value.declaration)
        })
      let headOwner = run DeclarationId.copyShared(&identity)
      let count = Shared.with<ImplementationHead, usize>(&head, headBinderCount)
      let lent = Vector.make<Shared<Lifetime>>()
      let supplied = run matchedArguments(count, &headOwner, Vector.asSlice<Binding>(&bindings), Vector.asSlice<Shared<Lifetime>>(&lent))
      if let Option<Vector<Argument>>.Some {..} = move supplied {
        let moduleOrdinal = knownModuleOrdinal(&resolver.*, DeclarationId.moduleId(&headOwner))
        if moduleOrdinal == usize.MAX { fail InvalidModulePath {} }
        let module = run resolvedModule(&resolver.*, moduleOrdinal)
        let found = run ordinalOfIdentity(&mut resolver.*, &module, &identity)
        if let Option<usize>.Some {value: ordinal} = move found {
          let witnesses = run proofDemand(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, Key {
            family: Family.Witnesses, module: moduleOrdinal, name: usize.ZERO,
            declaration: ordinal, member: usize.ZERO, external: false,
          }, siteSpan, nested)
          return Result.succeed<Option<ProvenWitnesses>, Shared<Rejection>>(Option.some<ProvenWitnesses>(
            ProvenWitnesses {witnesses: move witnesses, bindings: run copyBindings(Vector.asSlice<Binding>(&bindings))}))
        }
      }
    }
  }
  return Result.succeed<Option<ProvenWitnesses>, Shared<Rejection>>(Option.none<ProvenWitnesses>())
}

// The application of the source function the proved conformance maps `operation` to. No target
// body or invocation-specific inference identity participates in this application.
effect fn resolveWitnessApplication(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut Vector<Dependency>,
  nested: bool,
  contract: &Shared<Type>,
  provider: &Shared<Type>,
  operation: &DeclarationId,
  siteModule: &ModuleId,
  siteSpan: Span,
) -> Result<ResolvedWitness, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let proven = match move run provenWitnesses(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, nested,
    contract, provider, siteModule, siteSpan) {
    Result<Option<ProvenWitnesses>, Shared<Rejection>>.Success {value} => value
    Result<Option<ProvenWitnesses>, Shared<Rejection>>.Failure {error} => { return Result.failResult<ResolvedWitness, Shared<Rejection>>(move error) }
  }
  if let Option<ProvenWitnesses>.Some {value: selected} = move proven {
    let witnesses = Shared.clone<Result<Answer, NoRejection>>(&selected.witnesses)
    let mapped = run mappedWitnessApplication(&witnesses, operation, Vector.asSlice<Binding>(&selected.bindings))
    if let Option<Application>.Some {value} = move mapped {
      let schema = run resolveTargetSchema(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, nested,
        Application.bodyDeclaration(&value), siteSpan)
      if let Option<TargetSchema>.Some {value: targetSchema} = move schema {
        if run TargetSchema.accepts(&targetSchema, &value) {
          let count = Shared.with<Result<Answer, NoRejection>, usize>(&witnesses, fn(answer: &Result<Answer, NoRejection>) -> usize { return witnessOperandsCount(answer, operation) })
          let mut operands = Vector.make<OperandPass>()
          let mut at = usize.ZERO
          while at < count {
            let pass = Shared.with<Result<Answer, NoRejection>, OperandPass>(&witnesses, fn(answer: &Result<Answer, NoRejection>) -> OperandPass { return witnessOperandAt(answer, operation, at) })
            run Vector.append<OperandPass>(&mut operands, pass)
            at = at + usize.ONE
          }
          return Result.succeed<ResolvedWitness, Shared<Rejection>>(ResolvedWitness {application: move value, operands: move operands})
        }
      }
    }
  }
  return Result.failResult<ResolvedWitness, Shared<Rejection>>(
    run reject(&resolver.*, siteModule, RejectionCode.Unsupported, siteSpan),
  )
}

// The scalar intrinsic the proved conformance maps `operation` to, when it maps one. An unproved
// goal selects none here; the source-function path reports it.
effect fn resolveWitnessIntrinsic(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut Vector<Dependency>,
  contract: &Shared<Type>,
  provider: &Shared<Type>,
  operation: &DeclarationId,
  siteModule: &ModuleId,
  siteSpan: Span,
) -> Option<IntrinsicMember>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let proven = run provenWitnesses(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, true,
    contract, provider, siteModule, siteSpan)
  if let Result<Option<ProvenWitnesses>, Shared<Rejection>>.Success {value: Option<ProvenWitnesses>.Some {value: selected}} = move proven {
    let implementation = Shared.with<Result<Answer, NoRejection>, Option<WitnessImplementation>>(&selected.witnesses,
      fn(answer: &Result<Answer, NoRejection>) -> Option<WitnessImplementation> { return witnessFor(answer, operation) })
    if let Option<WitnessImplementation>.Some {value: WitnessImplementation.Intrinsic {member}} = move implementation {
      return Option.some<IntrinsicMember>(member)
    }
  }
  return Option.none<IntrinsicMember>()
}

// Header witness mappings retain original implementation slots. Invocation assignments and
// actual caller loans fill those slots before source origin selection or direct MIR admission.
effect fn completedWitnessApplication(resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  request: &mut Request, dependencies: &mut Vector<Dependency>, recipe: &WitnessRecipe,
  module: &ModuleId, span: Span) -> Result<ResolvedWitness, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let operation = run DeclarationId.copyShared(&recipe.operation)
  let selected = run resolveWitnessApplication(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
    true, &recipe.contract, &recipe.provider, &operation, module, span)
  let witness = match move selected {
    Result<ResolvedWitness, Shared<Rejection>>.Success {value} => move value
    Result<ResolvedWitness, Shared<Rejection>>.Failure {error} => { return Result.failResult<ResolvedWitness, Shared<Rejection>>(move error) }
  }
  let passes = Vector.asSlice<OperandPass>(&witness.operands)
  if passes.length != CallableWitness.argumentCount(recipe) || passes.length != CallableWitness.loanCount(recipe) {
    return Result.failResult<ResolvedWitness, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.Unsupported, span))
  }
  let mut invocation = Vector.make<Binding>()
  let mut at = usize.ZERO
  while at < CallableWitness.bindingCount(recipe) {
    run Vector.append<Binding>(&mut invocation, CallableWitness.bindingAt(recipe, at))
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < passes.length {
    if let OperandPass.Borrow {lifetimeOrdinal, ..} = &passes[at] {
      run Vector.append<Binding>(&mut invocation, Binding {
        declaration: run Shared.make<DeclarationId>(run DeclarationId.copy(Application.bodyDeclaration(&witness.application))),
        ordinal: lifetimeOrdinal, value: Argument.Lifetime {value: match move CallableWitness.loanAt(recipe, at) {
          Option<Shared<Lifetime>>.Some {value} => move value
          _ => { return Result.failResult<ResolvedWitness, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.Unsupported, span)) }
        }}})
    }
    at = at + usize.ONE
  }
  let application = run Application.applyBindings(&witness.application, Vector.asSlice<Binding>(&invocation))
  return Result.succeed<ResolvedWitness, Shared<Rejection>>(ResolvedWitness {application: move application, operands: move witness.operands})
}

struct WitnessEntry {
  value: Argument
  ordinal: usize
}

struct WitnessScope {
  owner: Shared<DeclarationId>
  count: usize
}

fn selectedWitness(answer: &Result<Answer, NoRejection>, operation: &DeclarationId) -> usize {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Witnesses {witnesses}} = &value.outcome {
      let listed = Vector.asSlice<Witness>(&witnesses)
      let mut at = usize.ZERO
      while at < listed.length {
        if Shared.with<DeclarationId, bool>(&listed[at].operation, fn(id: &DeclarationId) -> bool { return DeclarationId.equals(id, operation) }) { return at }
        at = at + usize.ONE
      }
    }
  }
  return usize.MAX
}

fn witnessOperandsCount(answer: &Result<Answer, NoRejection>, operation: &DeclarationId) -> usize {
  let selected = selectedWitness(answer, operation)
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Witnesses {witnesses}} = &value.outcome {
      let listed = Vector.asSlice<Witness>(&witnesses)
      if selected < listed.length { return Vector.length<OperandPass>(&listed[selected].operands) }
    }
  }
  return usize.ZERO
}

fn witnessOperandAt(answer: &Result<Answer, NoRejection>, operation: &DeclarationId, at: usize) -> OperandPass {
  let selected = selectedWitness(answer, operation)
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Witnesses {witnesses}} = &value.outcome {
      let listed = Vector.asSlice<Witness>(&witnesses)
      if selected < listed.length {
        let operands = Vector.asSlice<OperandPass>(&listed[selected].operands)
        if at < operands.length { return operands[at] }
      }
    }
  }
  return absurd<OperandPass>()
}

fn witnessEntry(answer: &Result<Answer, NoRejection>, operation: &DeclarationId, scope: usize, at: usize) -> Option<WitnessEntry> {
  let selected = selectedWitness(answer, operation)
  if selected == usize.MAX { return Option.none<WitnessEntry>() }
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Witnesses {witnesses}} = &value.outcome {
      let listed = Vector.asSlice<Witness>(&witnesses)
      let witness = &listed[selected]
      if scope == usize.MAX {
        let values = Vector.asSlice<Argument>(&witness.arguments)
        let ordinals = Vector.asSlice<usize>(&witness.argumentOrdinals)
        if at < values.length && at < ordinals.length { return Option.some<WitnessEntry>(WitnessEntry {value: Argument.copy(&values[at]), ordinal: ordinals[at]}) }
      } else {
        let scopes = Vector.asSlice<ScopeBinding>(&witness.scopes)
        if scope < scopes.length {
          let values = Vector.asSlice<Argument>(&scopes[scope].arguments)
          let ordinals = Vector.asSlice<usize>(&scopes[scope].argumentOrdinals)
          if at < values.length && at < ordinals.length { return Option.some<WitnessEntry>(WitnessEntry {value: Argument.copy(&values[at]), ordinal: ordinals[at]}) }
        }
      }
    }
  }
  return Option.none<WitnessEntry>()
}

fn witnessScope(answer: &Result<Answer, NoRejection>, operation: &DeclarationId, at: usize) -> Option<WitnessScope> {
  let selected = selectedWitness(answer, operation)
  if selected != usize.MAX {
    if let Result<Answer, NoRejection>.Success {value} = &answer.* {
      if let Outcome.Success {value: Value.Witnesses {witnesses}} = &value.outcome {
        let listed = Vector.asSlice<Witness>(&witnesses)
        let selectedWitness = &listed[selected]
        let scopes = Vector.asSlice<ScopeBinding>(&selectedWitness.scopes)
        if at < scopes.length { return Option.some<WitnessScope>(WitnessScope {owner: Shared.clone<DeclarationId>(&scopes[at].owner), count: Vector.length<Argument>(&scopes[at].arguments)}) }
      }
    }
  }
  return Option.none<WitnessScope>()
}

// Witness.arguments is already ordered by the actual target's binders, including mapped
// implementations whose binder order or arity differs from the conformance head's.
effect fn mappedWitnessApplication(
  answer: &Shared<Result<Answer, NoRejection>>,
  operation: &DeclarationId,
  recipeBindings: &[Binding],
) -> Option<Application> ! OutOfMemoryError ? &mut Allocator {
  let selected = Shared.with<Result<Answer, NoRejection>, Option<WitnessImplementation>>(answer,
    fn(value: &Result<Answer, NoRejection>) -> Option<WitnessImplementation> {
      return witnessFor(value, operation)
    })
  if let Option<WitnessImplementation>.Some {value: WitnessImplementation.Declaration {declaration: target}} = move selected {
    let count = Shared.with<Result<Answer, NoRejection>, usize>(answer,
      fn(value: &Result<Answer, NoRejection>) -> usize { return witnessArgumentsCount(value, operation) })
    let mut arguments = Vector.make<Argument>()
    let mut ordinals = Vector.make<usize>()
    let mut at = usize.ZERO
    while at < count {
      let selected = Shared.with<Result<Answer, NoRejection>, Option<WitnessEntry>>(answer,
        fn(value: &Result<Answer, NoRejection>) -> Option<WitnessEntry> { return witnessEntry(value, operation, usize.MAX, at) })
      if let Option<WitnessEntry>.Some {value} = move selected {
        run Vector.append<Argument>(&mut arguments, run Argument.applyBindings(&value.value, recipeBindings, true))
        run Vector.append<usize>(&mut ordinals, value.ordinal)
      } else { return Option.none<Application>() }
      at = at + usize.ONE
    }
    let mut scopes = Vector.make<ScopeBinding>()
    at = usize.ZERO
    while true {
      let selectedScope = Shared.with<Result<Answer, NoRejection>, Option<WitnessScope>>(answer,
        fn(value: &Result<Answer, NoRejection>) -> Option<WitnessScope> { return witnessScope(value, operation, at) })
      let scope = match move selectedScope { Option<WitnessScope>.Some {value} => move value _ => { break } }
      let mut values = Vector.make<Argument>()
      let mut slots = Vector.make<usize>()
      let mut index = usize.ZERO
      while index < scope.count {
        let entry = Shared.with<Result<Answer, NoRejection>, Option<WitnessEntry>>(answer,
          fn(value: &Result<Answer, NoRejection>) -> Option<WitnessEntry> { return witnessEntry(value, operation, at, index) })
        if let Option<WitnessEntry>.Some {value} = move entry {
          run Vector.append<Argument>(&mut values, run Argument.applyBindings(&value.value, recipeBindings, true))
          run Vector.append<usize>(&mut slots, value.ordinal)
        } else { return Option.none<Application>() }
        index = index + usize.ONE
      }
      run Vector.append<ScopeBinding>(&mut scopes, ScopeBinding {owner: move scope.owner, arguments: move values, argumentOrdinals: move slots})
      at = at + usize.ONE
    }
    return Option.some<Application>(Application {
      target: SpecializationTarget.Named {declaration: run DeclarationId.copyShared(&target)}, arguments: move arguments, argumentOrdinals: move ordinals, scopes: move scopes,
      statics: Vector.make<StaticSlot>(),
    })
  }
  return Option.none<Application>()
}

fn witnessArgumentsCount(answer: &Result<Answer, NoRejection>, operation: &DeclarationId) -> usize {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Witnesses {witnesses}} = &value.outcome {
      let listed = Vector.asSlice<Witness>(&witnesses)
      let mut at = usize.ZERO
      while at < listed.length {
        if Shared.with<DeclarationId, bool>(&listed[at].operation,
          fn(value: &DeclarationId) -> bool { return DeclarationId.equals(value, operation) }) {
          return Vector.length<Argument>(&listed[at].arguments)
        }
        at = at + usize.ONE
      }
    }
  }
  return usize.ZERO
}

struct ReferenceReceiver {
  referent: Shared<Type>
  mode: BodyReceiverPass
}

// A receiver operand is the first parameter taking `Self` by value or by either borrow mode.
// Call arguments and the expected result do not participate in this eligibility check.
effect fn receiverPosition(signature: &Shared<Result<Answer, NoRejection>>, provider: &Shared<Type>) -> Option<
  ReceiverPosition,
> ! OutOfMemoryError ? &mut Allocator {
  let count = Shared.with<Result<Answer, NoRejection>, usize>(signature, signatureParameterCount)
  if count == usize.ZERO {
    return Option.none<ReceiverPosition>()
  }
  let at = usize.ZERO
  let parameter = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
    signature,
    fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> {
      return signatureParameter(answer, at)
    },
  )
  if let Option<Shared<Type>>.Some {value} = move parameter {
    if run Type.equalsShared(&value, provider) {
      return Option.some<ReceiverPosition>(
        ReceiverPosition {ordinal: at, mode: BodyReceiverPass.Take},
      )
    }
    let reference = Shared.with<Type, Option<ReferenceReceiver>>(
      &value,
      fn(parameterType: &Type) -> Option<ReferenceReceiver> {
        return match & parameterType.* {
          Type.Reference {referent, access, ..} => Option.some<ReferenceReceiver>(
            ReferenceReceiver {
              referent: Shared.clone<Type>(&referent),
              mode: match access {
                Access.Shared => BodyReceiverPass.Shared
                Access.Mutable => BodyReceiverPass.Mutable
              },
            },
          )
          _ => Option.none<ReferenceReceiver>()
        }
      },
    )
    if let Option<ReferenceReceiver>.Some {value: borrowed} = move reference {
      if run Type.equalsShared(&borrowed.referent, provider) {
        return Option.some<ReceiverPosition>(ReceiverPosition {ordinal: at, mode: borrowed.mode})
      }
    }
  }
  return Option.none<ReceiverPosition>()
}

// An owner's own names answer before any conformance lookup. A rejected or private inherent
// member, field, or receiver-less associated function is never rescued by an interface operation.
effect fn selectInherentReceiverCall(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut Vector<Dependency>,
  nested: bool,
  provider: &Shared<Type>,
  member: &[u8],
  inferOwner: bool,
  requireReceiver: bool,
  siteModule: &ModuleId,
  siteSpan: Span,
) -> Result<InherentCallChoice, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let moduleOrdinal = declaringModuleOrdinal(&resolver.*, provider)
  if moduleOrdinal == usize.MAX {
    return Result.succeed<InherentCallChoice, Shared<Rejection>>(InherentCallChoice.Missing)
  }
  let module = run resolvedModule(&resolver.*, moduleOrdinal)
  let found = run ordinalOfProvider(&mut resolver.*, &module, provider)
  let ownerOrdinal = match move found {
    Option<usize>.Some {value} => value
    Option<usize>.None => {
      return Result.succeed<InherentCallChoice, Shared<Rejection>>(InherentCallChoice.Missing)
    }
  }
  let own = run proofDemand(
    &mut resolver.*,
    &mut owner.*,
    &mut request.*,
    &mut dependencies.*,
    Key {
      family: Family.InherentMembers,
      module: moduleOrdinal,
      name: usize.ZERO,
      declaration: ownerOrdinal,
      member: usize.ZERO,
      external: false,
    },
    siteSpan,
    nested,
  )
  let failure = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
    &own,
    answerRejection,
  )
  if let Option<Shared<Rejection>>.Some {value} = move failure {
    return Result.failResult<InherentCallChoice, Shared<Rejection>>(move value)
  }
  let lookup = Shared.with<Result<Answer, NoRejection>, InherentLookup>(
    &own,
    fn(answer: &Result<Answer, NoRejection>) -> InherentLookup {
      return inherentLookup(answer, member)
    },
  )
  if let Option<Shared<Rejection>>.Some {value} = move lookup.rejected {
    return Result.failResult<InherentCallChoice, Shared<Rejection>>(move value)
  }
  if let Option<Shared<DeclarationId>>.Some {value: declaration} = move lookup.published {
    let ordinal = run ordinalOfIdentity(&mut resolver.*, &module, &declaration)
    if let Option<usize>.Some {value: position} = move ordinal {
      let written = run header(&mut resolver.*, &module, position)
      let mut published = true
      let mut foreign = false
      if let Option<HeaderSyntax>.Some {value} = move written {
        if let Node.FunctionHeader {isPublic, linkage, ..} = value.header {
          foreign = linkage.present
          published = isPublic
          if !isPublic && !ModuleId.equals(siteModule, &module) {
            return Result.failResult<InherentCallChoice, Shared<Rejection>>(
              run reject(&resolver.*, siteModule, RejectionCode.PrivateMember, siteSpan),
            )
          }
        }
      }
      let mut family = Family.AppliedInherent
      let mut providerKey = run internApplication(&mut resolver.*, provider)
      if inferOwner {
        // An unapplied owner is an inference template, not an application whose declaration-owned
        // arguments are already fixed. Its authored signature keeps the impl binders open.
        family = Family.Signature
        providerKey = usize.ZERO
      }
      let signature = run proofDemand(
        &mut resolver.*,
        &mut owner.*,
        &mut request.*,
        &mut dependencies.*,
        Key {
          family: family,
          module: moduleOrdinal,
          name: providerKey,
          declaration: position,
          member: usize.ZERO,
          external: false,
        },
        siteSpan,
        nested,
      )
      let failure = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
        &signature,
        answerRejection,
      )
      if let Option<Shared<Rejection>>.Some {value} = move failure {
        return Result.failResult<InherentCallChoice, Shared<Rejection>>(move value)
      }
      let receiver = run receiverPosition(&signature, provider)
      let mut validReceiver = !requireReceiver
      if let Option<ReceiverPosition>.Some {value} = &receiver {
        validReceiver = validReceiver || value.ordinal == usize.ZERO
      }
      if validReceiver {
        let identity = run declarationAt(&mut resolver.*, &module, position)
        if let Option<DeclarationId>.Some {value: selected} = move identity {
          let mut scopeArguments = Vector.make<Argument>()
          if !inferOwner { scopeArguments = run typeApplicationArguments(provider) }
          return Result.succeed<InherentCallChoice, Shared<Rejection>>(
            InherentCallChoice.Selected {
              target: CallTarget {
                foreign: foreign,
                declaration: move selected,
                isPublic: published,
                signature: move signature,
                explicit: Vector.make<Argument>(),
                explicitSlots: Vector.make<CallPrefixSlot>(), prefixOwner: Option.none<Shared<DeclarationId>>(), prefixLifetimes: usize.ZERO,
                scopeArguments: move scopeArguments,
                inferOwner: inferOwner,
                explicitSyntax: false,
              },
              receiver: move receiver,
            },
          )
        }
      }
      return Result.failResult<InherentCallChoice, Shared<Rejection>>(
        run reject(&resolver.*, siteModule, RejectionCode.AssociatedFunctionOnValue, siteSpan),
      )
    }
  }
  let claims = run proofDemand(
    &mut resolver.*,
    &mut owner.*,
    &mut request.*,
    &mut dependencies.*,
    Key {
      family: Family.Members,
      module: moduleOrdinal,
      name: usize.ZERO,
      declaration: ownerOrdinal,
      member: usize.ZERO,
      external: false,
    },
    siteSpan,
    nested,
  )
  if Shared.with<Result<Answer, NoRejection>, bool>(
    &claims,
    fn(answer: &Result<Answer, NoRejection>) -> bool {
      return ownerClaims(answer, member)
    },
  ) {
    return Result.succeed<InherentCallChoice, Shared<Rejection>>(InherentCallChoice.Claimed)
  }
  return Result.succeed<InherentCallChoice, Shared<Rejection>>(InherentCallChoice.Missing)
}

// The chosen supplier's operation is proven and called once receiver selection is unambiguous.
effect fn selectedReceiverOperation(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut Vector<Dependency>,
  nested: bool,
  provider: &Shared<Type>,
  declared: &[Constraint],
  siteModule: &ModuleId,
  siteSpan: Span,
  candidates: &[MethodSupplier],
  selected: Option<usize>,
) -> Result<Option<SelectedReceiverOperation>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let index = match move selected {
    Option<usize>.Some {value} => value
    Option<usize>.None => {
      return Result.succeed<Option<SelectedReceiverOperation>, Shared<Rejection>>(
        Option.none<SelectedReceiverOperation>(),
      )
    }
  }
  let chosen = &candidates[index]
  let module = run resolvedModule(&resolver.*, chosen.operationModule)
  let operation = run declarationAt(&mut resolver.*, &module, chosen.operationOrdinal)
  let identity = match move operation {
    Option<DeclarationId>.Some {value} => value
    Option<DeclarationId>.None => {
      return Result.succeed<Option<SelectedReceiverOperation>, Shared<Rejection>>(
        Option.none<SelectedReceiverOperation>(),
      )
    }
  }
  let found = run selectOperationCall(
    &mut resolver.*,
    &mut owner.*,
    &mut request.*,
    &mut dependencies.*,
    nested,
    &chosen.contract,
    provider,
    &identity,
    declared,
    siteModule,
    siteSpan,
  )
  let operationCall = match move found {
    Result<OperationCall, Shared<Rejection>>.Success {value} => value
    Result<OperationCall, Shared<Rejection>>.Failure {error} => {
      return Result.failResult<Option<SelectedReceiverOperation>, Shared<Rejection>>(move error)
    }
  }
  let mut selectedCall = move operationCall
  selectedCall.receiver = Option.some<ReceiverPosition>(chosen.receiver)
  return Result.succeed<Option<SelectedReceiverOperation>, Shared<Rejection>>(
    Option.some<SelectedReceiverOperation>(
      SelectedReceiverOperation {
        contract: Shared.clone<Type>(&chosen.contract),
        call: move selectedCall,
      },
    ),
  )
}

fn isInterfaceHeader(written: Option<HeaderSyntax>) -> bool {
  if let Option<HeaderSyntax>.Some {value} = move written {
    if let Node.InterfaceHeader {..} = value.header {
      return true
    }
  }
  return false
}

// One listed operation of a bound interface supplies the receiver call when its name matches and
// its applied signature takes the provider as receiver.
effect fn appendBoundOperationSupplier(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut Vector<Dependency>,
  nested: bool,
  provider: &Shared<Type>,
  member: &[u8],
  contract: &Shared<Type>,
  contractModule: usize,
  module: &ModuleId,
  listed: &Shared<Result<Answer, NoRejection>>,
  operationAtIndex: usize,
  siteSpan: Span,
  candidates: &mut Vector<MethodSupplier>,
  selection: &mut CallSelection,
) -> Result<(), Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let operation = Shared.with<Result<Answer, NoRejection>, Option<Shared<DeclarationId>>>(
    listed,
    fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<DeclarationId>> {
      return operationAt(answer, operationAtIndex)
    },
  )
  let identity = match move operation {
    Option<Shared<DeclarationId>>.Some {value} => value
    Option<Shared<DeclarationId>>.None => {
      return Result.succeed<(), Shared<Rejection>>(())
    }
  }
  let named = Shared.with<DeclarationId, bool>(
    &identity,
    fn(value: &DeclarationId) -> bool {
      return DeclarationId.named(value, member)
    },
  )
  if !named {
    return Result.succeed<(), Shared<Rejection>>(())
  }
  let sourceOrdinal = run ordinalOfIdentity(&mut resolver.*, module, &identity)
  let operationOrdinal = match move sourceOrdinal {
    Option<usize>.Some {value} => value
    Option<usize>.None => {
      return Result.succeed<(), Shared<Rejection>>(())
    }
  }
  let contractKey = run internApplication(&mut resolver.*, contract)
  let providerKey = run internApplication(&mut resolver.*, provider)
  let signature = run proofDemand(
    &mut resolver.*,
    &mut owner.*,
    &mut request.*,
    &mut dependencies.*,
    Key {
      family: Family.AppliedOperation,
      module: contractModule,
      name: contractKey,
      declaration: operationOrdinal,
      member: providerKey,
      external: false,
    },
    siteSpan,
    nested,
  )
  let failure = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
    &signature,
    answerRejection,
  )
  if let Option<Shared<Rejection>>.Some {value} = move failure {
    return Result.failResult<(), Shared<Rejection>>(move value)
  }
  if Shared.with<Result<Answer, NoRejection>, usize>(
    &signature,
    signatureTypeParameterCount,
  ) != usize.ZERO {
    return Result.succeed<(), Shared<Rejection>>(())
  }
  let receiver = run receiverPosition(&signature, provider)
  let receiverPositionValue = match move receiver {
    Option<ReceiverPosition>.Some {value} => value
    Option<ReceiverPosition>.None => {
      return Result.succeed<(), Shared<Rejection>>(())
    }
  }
  let index = Vector.length<MethodSupplier>(&candidates.*)
  run Vector.append<MethodSupplier>(
    &mut candidates.*,
    MethodSupplier {
      contract: Shared.clone<Type>(contract),
      operationModule: contractModule,
      operationOrdinal: operationOrdinal,
      receiver: receiverPositionValue,
    },
  )
  CallSelection.add(&mut selection.*, index)
  return Result.succeed<(), Shared<Rejection>>(())
}

// The operations of one written interface bound supply receiver methods for the provider.
effect fn appendBoundContractSuppliers(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut Vector<Dependency>,
  nested: bool,
  provider: &Shared<Type>,
  member: &[u8],
  contract: &Shared<Type>,
  siteSpan: Span,
  candidates: &mut Vector<MethodSupplier>,
  selection: &mut CallSelection,
) -> Result<(), Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let contractModule = declaringModuleOrdinal(&resolver.*, contract)
  if contractModule == usize.MAX {
    fail InvalidModulePath {}
  }
  let module = run resolvedModule(&resolver.*, contractModule)
  let contractOrdinal = run ordinalOfProvider(&mut resolver.*, &module, contract)
  let position = match move contractOrdinal {
    Option<usize>.Some {value} => value
    Option<usize>.None => {
      return Result.succeed<(), Shared<Rejection>>(())
    }
  }
  let written = run header(&mut resolver.*, &module, position)
  if !isInterfaceHeader(move written) {
    return Result.succeed<(), Shared<Rejection>>(())
  }
  let listed = run proofDemand(
    &mut resolver.*,
    &mut owner.*,
    &mut request.*,
    &mut dependencies.*,
    Key {
      family: Family.Operations,
      module: contractModule,
      name: usize.ZERO,
      declaration: position,
      member: usize.ZERO,
      external: false,
    },
    siteSpan,
    nested,
  )
  let failure = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
    &listed,
    answerRejection,
  )
  if let Option<Shared<Rejection>>.Some {value} = move failure {
    return Result.failResult<(), Shared<Rejection>>(move value)
  }
  let count = Shared.with<Result<Answer, NoRejection>, usize>(&listed, operationCount)
  let mut operationAtIndex = usize.ZERO
  while operationAtIndex < count {
    let added = run appendBoundOperationSupplier(
      &mut resolver.*,
      &mut owner.*,
      &mut request.*,
      &mut dependencies.*,
      nested,
      provider,
      member,
      contract,
      contractModule,
      &module,
      &listed,
      operationAtIndex,
      siteSpan,
      &mut candidates.*,
      &mut selection.*,
    )
    if let Result<(), Shared<Rejection>>.Failure {error} = move added {
      return Result.failResult<(), Shared<Rejection>>(move error)
    }
    operationAtIndex = operationAtIndex + usize.ONE
  }
  return Result.succeed<(), Shared<Rejection>>(())
}

// Only a conformance bound on exactly this provider can supply receiver methods.
effect fn appendBoundConstraintSuppliers(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut Vector<Dependency>,
  nested: bool,
  provider: &Shared<Type>,
  member: &[u8],
  constraint: &Constraint,
  siteSpan: Span,
  candidates: &mut Vector<MethodSupplier>,
  selection: &mut CallSelection,
) -> Result<(), Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  if let Constraint.Conforms {provider: bounded, contract} = &constraint.* {
    if run Type.equalsShared(provider, &bounded) {
      return run appendBoundContractSuppliers(
        &mut resolver.*,
        &mut owner.*,
        &mut request.*,
        &mut dependencies.*,
        nested,
        provider,
        member,
        &contract,
        siteSpan,
        &mut candidates.*,
        &mut selection.*,
      )
    }
  }
  return Result.succeed<(), Shared<Rejection>>(())
}

// For an abstract provider, only its written interface bounds can supply receiver methods.
// Choose the supplier by name and receiver contract before considering call arguments.
effect fn selectBoundReceiverCall(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut Vector<Dependency>,
  nested: bool,
  provider: &Shared<Type>,
  member: &[u8],
  declared: &[Constraint],
  siteModule: &ModuleId,
  siteSpan: Span,
) -> Result<Option<SelectedReceiverOperation>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let mut candidates = Vector.make<MethodSupplier>()
  let mut selection = CallSelection.make()
  let mut at = usize.ZERO
  while at < declared.length {
    let added = run appendBoundConstraintSuppliers(
      &mut resolver.*,
      &mut owner.*,
      &mut request.*,
      &mut dependencies.*,
      nested,
      provider,
      member,
      &declared[at],
      siteSpan,
      &mut candidates,
      &mut selection,
    )
    if let Result<(), Shared<Rejection>>.Failure {error} = move added {
      return Result.failResult<Option<SelectedReceiverOperation>, Shared<Rejection>>(move error)
    }
    at = at + usize.ONE
  }
  if CallSelection.ambiguous(&selection) {
    return Result.failResult<Option<SelectedReceiverOperation>, Shared<Rejection>>(
      run reject(&resolver.*, siteModule, RejectionCode.AmbiguousBoundMethod, siteSpan),
    )
  }
  let selected = CallSelection.unique(&selection)
  return run selectedReceiverOperation(
    &mut resolver.*,
    &mut owner.*,
    &mut request.*,
    &mut dependencies.*,
    nested,
    provider,
    declared,
    siteModule,
    siteSpan,
    Vector.asSlice<MethodSupplier>(&candidates),
    move selected,
  )
}

fn alreadyVisible(interfaces: &[VisibleInterface], module: usize, ordinal: usize) -> bool {
  let mut at = usize.ZERO
  while at < interfaces.length {
    if interfaces[at].module == module && interfaces[at].ordinal == ordinal {
      return true
    }
    at = at + usize.ONE
  }
  return false
}

// Only declarations the caller can name contribute method suppliers. A namespace import opens
// the imported module's public namespace; it does not activate or hide any conformance head.
effect fn appendInterfaceNames(
  resolver: &mut Resolver,
  module: &ModuleId,
  moduleOrdinal: usize,
  external: bool,
  names: &mut Vector<VisibleName>,
) -> () ! Cycle | OutOfMemoryError ? &mut Allocator {
  let answer = run source(&mut resolver.*, module)
  if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(&resolver.*, &answer, module) {
    let index = IndexedSource.moduleIndex(indexed)
    let candidates = ModuleIndex.listCandidates(index)
    let declarations = ModuleIndex.listDeclarations(index)
    let hir = IndexedSource.authored(indexed)
    let mut at = usize.ZERO
    while at < candidates.length {
      let candidate = &candidates[at]
      if (!external || candidate.isPublic) && candidate.kind != CandidateKind.ImportModule {
        let mut possible = candidate.kind == CandidateKind.ImportMember
        if candidate.kind == CandidateKind.Declaration && candidate.declaration < declarations.length {
          if let Node.InterfaceHeader {..} = Module.node(
            hir,
            declarations[candidate.declaration].header,
          ) {
            possible = true
          }
        }
        if possible {
          run Vector.append<VisibleName>(
            &mut names.*,
            VisibleName {
              module: moduleOrdinal,
              name: run Bytes.copy(Bytes.asSlice(&candidate.name)),
              external: external,
            },
          )
        }
      }
      at = at + usize.ONE
    }
  }
  return ()
}

effect fn visibleInterfaces(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut Vector<Dependency>,
  siteModule: &ModuleId,
  siteSpan: Span,
) -> Result<Vector<VisibleInterface>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let siteOrdinal = run internModule(&mut resolver.*, siteModule)
  let mut names = Vector.make<VisibleName>()
  run appendInterfaceNames(&mut resolver.*, siteModule, siteOrdinal, false, &mut names)
  let mut namespaces = Vector.make<Bytes>()
  let answer = run source(&mut resolver.*, siteModule)
  if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(
    &resolver.*,
    &answer,
    siteModule,
  ) {
    let candidates = ModuleIndex.listCandidates(IndexedSource.moduleIndex(indexed))
    let mut at = usize.ZERO
    while at < candidates.length {
      if candidates[at].kind == CandidateKind.ImportModule {
        run Vector.append<Bytes>(
          &mut namespaces,
          run Bytes.copy(Bytes.asSlice(&candidates[at].name)),
        )
      }
      at = at + usize.ONE
    }
  }
  let imported = Vector.asSlice<Bytes>(&namespaces)
  let mut namespaceAt = usize.ZERO
  while namespaceAt < imported.length {
    // Method syntax names no interface; an invisible namespace contributes none, and a failed
    // governing condition fails the call.
    let scanned = run scannedSelection(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies.*,
      siteModule,
      Bytes.asSlice(&imported[namespaceAt]),
      false,
    )
    let namespaceSelection = match move scanned {
      Result<Option<Selection>, Shared<Rejection>>.Success {value} => value
      Result<Option<Selection>, Shared<Rejection>>.Failure {error} => {
        return Result.failResult<Vector<VisibleInterface>, Shared<Rejection>>(move error)
      }
    }
    let mut selected = emptySelection()
    if let Option<Selection>.Some {value: visibleNamespace} = move namespaceSelection {
      selected = visibleNamespace
    }
    if selected.count == usize.ONE && selected.kind == CandidateKind.ImportModule {
      let answer = run proofDemand(
        &mut resolver.*,
        &mut owner.*,
        &mut request.*,
        &mut dependencies.*,
        Key {
          family: Family.Import,
          module: siteOrdinal,
          name: usize.ZERO,
          declaration: selected.declaration,
          member: usize.MAX,
          external: false,
        },
        siteSpan,
        true,
      )
      let binding = Shared.with<Result<Answer, NoRejection>, ImportSelection>(
        &answer,
        selectedImport,
      )
      if let Option<usize>.Some {value: targetOrdinal} = move binding.module {
        let target = run resolvedModule(&resolver.*, targetOrdinal)
        run appendInterfaceNames(&mut resolver.*, &target, targetOrdinal, true, &mut names)
      }
    }
    namespaceAt = namespaceAt + usize.ONE
  }
  let mut interfaces = Vector.make<VisibleInterface>()
  let candidates = Vector.asSlice<VisibleName>(&names)
  let mut at = usize.ZERO
  while at < candidates.length {
    let candidateModule = run resolvedModule(&resolver.*, candidates[at].module)
    let scannedName = run scannedSelection(
      &mut resolver.*, &mut owner.*, &mut dependencies.*, &candidateModule,
      Bytes.asSlice(&candidates[at].name), candidates[at].external,
    )
    let nameSelection = match move scannedName {
      Result<Option<Selection>, Shared<Rejection>>.Success {value} => value
      Result<Option<Selection>, Shared<Rejection>>.Failure {error} => {
        return Result.failResult<Vector<VisibleInterface>, Shared<Rejection>>(move error)
      }
    }
    if let Option<Selection>.None = move nameSelection {
      at = at + usize.ONE
      continue
    }
    let selected = run selectDeclaration(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies.*,
      candidates[at].module,
      siteModule,
      Bytes.asSlice(&candidates[at].name),
      candidates[at].external,
      siteSpan,
      RejectionCode.NotType,
    )
    if let Result<SelectedDeclaration, Shared<Rejection>>.Success {value: declaration} = move selected {
      if !alreadyVisible(
        Vector.asSlice<VisibleInterface>(&interfaces),
        declaration.module,
        declaration.ordinal,
      ) {
        let module = run resolvedModule(&resolver.*, declaration.module)
        let written = run header(&mut resolver.*, &module, declaration.ordinal)
        if let Option<HeaderSyntax>.Some {value} = move written {
          if let Node.InterfaceHeader {..} = value.header {
            run Vector.append<VisibleInterface>(
              &mut interfaces,
              VisibleInterface {module: declaration.module, ordinal: declaration.ordinal},
            )
          }
        }
      }
    }
    at = at + usize.ONE
  }
  return Result.succeed<Vector<VisibleInterface>, Shared<Rejection>>(move interfaces)
}

// The provider fixes an impl head before its interface arguments are considered. Re-resolve an
// open contract under those exact bindings; call arguments and expected results never infer them.
effect fn appliedHeadContract(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  head: &Shared<ImplementationHead>,
  bindings: &[Binding],
  siteModule: &ModuleId,
  siteSpan: Span,
) -> Result<Shared<Type>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let terms = Shared.with<ImplementationHead, Option<HeadTerms>>(head, headTerms)
  let found = match move terms {
    Option<HeadTerms>.Some {value} => move value
    Option<HeadTerms>.None => {
      return Result.failResult<Shared<Type>, Shared<Rejection>>(
        run reject(&resolver.*, siteModule, RejectionCode.Unsupported, siteSpan),
      )
    }
  }
  if !Type.hasOpenParameters(&found.contract) {
    return Result.succeed<Shared<Type>, Shared<Rejection>>(move found.contract)
  }
  let moduleOrdinal = Shared.with<DeclarationId, usize>(
    &found.declaration,
    fn(value: &DeclarationId) -> usize {
      return knownModuleOrdinal(&resolver.*, DeclarationId.moduleId(value))
    },
  )
  if moduleOrdinal == usize.MAX {
    fail InvalidModulePath {}
  }
  let module = run resolvedModule(&resolver.*, moduleOrdinal)
  let located = run ordinalOfIdentity(&mut resolver.*, &module, &found.declaration)
  let ordinal = match move located {
    Option<usize>.Some {value} => value
    Option<usize>.None => {
      return Result.failResult<Shared<Type>, Shared<Rejection>>(
        run reject(&resolver.*, siteModule, RejectionCode.UnknownMember, siteSpan),
      )
    }
  }
  let written = run header(&mut resolver.*, &module, ordinal)
  let subject = match move written {
    Option<HeaderSyntax>.Some {value} => match value.header {
      Node.ImplHeader {subject, ..} => subject
      _ => {
        return Result.failResult<Shared<Type>, Shared<Rejection>>(
          run reject(&resolver.*, siteModule, RejectionCode.Unsupported, siteSpan),
        )
      }
    }
    Option<HeaderSyntax>.None => {
      return Result.failResult<Shared<Type>, Shared<Rejection>>(
        run reject(&resolver.*, siteModule, RejectionCode.Unsupported, siteSpan),
      )
    }
  }
  let template = run templateBinders(&mut resolver.*, &module, ordinal)
  let formal = match move template {
    Result<Vector<Binder>, Shared<Rejection>>.Success {value} => move value
    Result<Vector<Binder>, Shared<Rejection>>.Failure {error} => {
      return Result.failResult<Shared<Type>, Shared<Rejection>>(move error)
    }
  }
  let mut arguments = Vector.make<Argument>()
  let count = Vector.length<Binder>(&formal)
  let mut at = usize.ZERO
  while at < count {
    let found = matchedArgument(bindings, &found.declaration, at)
    let argument = match move found {
      Option<Argument>.Some {value} => move value
      Option<Argument>.None => {
        return Result.failResult<Shared<Type>, Shared<Rejection>>(
          run reject(&resolver.*, siteModule, RejectionCode.Unsupported, siteSpan),
        )
      }
    }
    run Vector.append<Argument>(&mut arguments, move argument)
    at = at + usize.ONE
  }
  let applied = run bindArguments(
    Vector.asSlice<Binder>(&formal),
    Vector.asSlice<Argument>(&arguments),
  )
  let mut elision = LifetimeElision {
    owner: run declarationAt(&mut resolver.*, &module, ordinal),
    nextOrdinal: count,
    output: false,
    resultDefault: Option.none<Shared<Lifetime>>(),
    generated: Vector.make<Shared<Lifetime>>(),
    invocation: false,
    nested: false,
    renumber: Vector.make<usize>(),
    staticEnvironment: false,
    supplied: Option.none<Vector<Argument>>(),
    assumptions: Option.none<Vector<Constraint>>(),
  }
  return run resolveType(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies.*,
    moduleOrdinal,
    subject,
    Vector.asSlice<Binder>(&applied),
    &mut elision,
  )
}

// Two suppliers of the same operation through the same contract are one candidate.
effect fn hasMethodSupplier(
  existing: &[MethodSupplier],
  operationModule: usize,
  operationOrdinal: usize,
  contract: &Shared<Type>,
) -> bool ! OutOfMemoryError ? &mut Allocator {
  let mut prior = usize.ZERO
  while prior < existing.length {
    if existing[prior].operationModule == operationModule && existing[prior].operationOrdinal == operationOrdinal && run Type.equalsShared(
      &existing[prior].contract,
      contract,
    ) {
      return true
    }
    prior = prior + usize.ONE
  }
  return false
}

// One conformance head of the provider's bucket supplies the receiver call when it matches the
// provider exactly and its applied signature takes the provider as receiver.
effect fn appendConcreteHeadSupplier(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut Vector<Dependency>,
  nested: bool,
  provider: &Shared<Type>,
  providerKey: usize,
  bucket: &Shared<Result<Answer, NoRejection>>,
  headAt: usize,
  visibleInterface: &VisibleInterface,
  operationOrdinal: usize,
  siteModule: &ModuleId,
  siteSpan: Span,
  candidates: &mut Vector<MethodSupplier>,
  selection: &mut CallSelection,
) -> Result<(), Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let candidate = Shared.with<Result<Answer, NoRejection>, Option<Shared<ImplementationHead>>>(
    bucket,
    fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<ImplementationHead>> {
      return bucketAt(answer, headAt)
    },
  )
  let head = match move candidate {
    Option<Shared<ImplementationHead>>.Some {value} => value
    Option<Shared<ImplementationHead>>.None => {
      return Result.succeed<(), Shared<Rejection>>(())
    }
  }
  let terms = Shared.with<ImplementationHead, Option<HeadTerms>>(&head, headTerms)
  let termsValue = match move terms {
    Option<HeadTerms>.Some {value} => value
    Option<HeadTerms>.None => {
      return Result.succeed<(), Shared<Rejection>>(())
    }
  }
  let mut variables = Vector.make<Shared<DeclarationId>>()
  run Vector.append<Shared<DeclarationId>>(
    &mut variables,
    Shared.clone<DeclarationId>(&termsValue.declaration),
  )
  let mut bindings = Vector.make<Binding>()
  let matched = run Type.unify(
    &termsValue.provider,
    provider,
    Vector.asSlice<Shared<DeclarationId>>(&variables),
    Comparison.Exact,
    &mut bindings,
  )
  if exactHeadUndetermined(&matched) {
    return Result.failResult<(), Shared<Rejection>>(
      run reject(&resolver.*, siteModule, RejectionCode.Unsupported, siteSpan),
    )
  }
  if !exactHeadMatched(&matched) {
    return Result.succeed<(), Shared<Rejection>>(())
  }
  let applied = run appliedHeadContract(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies.*,
    &head,
    Vector.asSlice<Binding>(&bindings),
    siteModule,
    siteSpan,
  )
  let contract = match move applied {
    Result<Shared<Type>, Shared<Rejection>>.Success {value: appliedContract} => move appliedContract
    Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
      return Result.failResult<(), Shared<Rejection>>(move error)
    }
  }
  let contractKey = run internApplication(&mut resolver.*, &contract)
  let signature = run proofDemand(
    &mut resolver.*,
    &mut owner.*,
    &mut request.*,
    &mut dependencies.*,
    Key {
      family: Family.AppliedOperation,
      module: visibleInterface.module,
      name: contractKey,
      declaration: operationOrdinal,
      member: providerKey,
      external: false,
    },
    siteSpan,
    nested,
  )
  let failure = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
    &signature,
    answerRejection,
  )
  if let Option<Shared<Rejection>>.Some {value: diagnostic} = move failure {
    return Result.failResult<(), Shared<Rejection>>(move diagnostic)
  }
  if Shared.with<Result<Answer, NoRejection>, usize>(
    &signature,
    signatureTypeParameterCount,
  ) != usize.ZERO {
    return Result.succeed<(), Shared<Rejection>>(())
  }
  let receiver = run receiverPosition(&signature, provider)
  let receiverPositionValue = match move receiver {
    Option<ReceiverPosition>.Some {value} => value
    Option<ReceiverPosition>.None => {
      return Result.succeed<(), Shared<Rejection>>(())
    }
  }
  let duplicate = run hasMethodSupplier(
    Vector.asSlice<MethodSupplier>(&candidates.*),
    visibleInterface.module,
    operationOrdinal,
    &contract,
  )
  if duplicate {
    return Result.succeed<(), Shared<Rejection>>(())
  }
  let index = Vector.length<MethodSupplier>(&candidates.*)
  run Vector.append<MethodSupplier>(
    &mut candidates.*,
    MethodSupplier {
      contract: move contract,
      operationModule: visibleInterface.module,
      operationOrdinal: operationOrdinal,
      receiver: receiverPositionValue,
    },
  )
  CallSelection.add(&mut selection.*, index)
  return Result.succeed<(), Shared<Rejection>>(())
}

// One named operation of a visible interface is a supplier through every conformance head the
// receiver type matches.
effect fn appendConcreteOperationSuppliers(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut Vector<Dependency>,
  nested: bool,
  provider: &Shared<Type>,
  providerKey: usize,
  member: &[u8],
  listed: &Shared<Result<Answer, NoRejection>>,
  operationAtIndex: usize,
  visibleInterface: &VisibleInterface,
  module: &ModuleId,
  siteModule: &ModuleId,
  siteSpan: Span,
  candidates: &mut Vector<MethodSupplier>,
  selection: &mut CallSelection,
) -> Result<(), Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let operation = Shared.with<Result<Answer, NoRejection>, Option<Shared<DeclarationId>>>(
    listed,
    fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<DeclarationId>> {
      return operationAt(answer, operationAtIndex)
    },
  )
  let identity = match move operation {
    Option<Shared<DeclarationId>>.Some {value} => value
    Option<Shared<DeclarationId>>.None => {
      return Result.succeed<(), Shared<Rejection>>(())
    }
  }
  if !Shared.with<DeclarationId, bool>(
    &identity,
    fn(value: &DeclarationId) -> bool {
      return DeclarationId.named(value, member)
    },
  ) {
    return Result.succeed<(), Shared<Rejection>>(())
  }
  let located = run ordinalOfIdentity(&mut resolver.*, module, &identity)
  let operationOrdinal = match move located {
    Option<usize>.Some {value} => value
    Option<usize>.None => {
      return Result.succeed<(), Shared<Rejection>>(())
    }
  }
  let bucket = run proofDemand(
    &mut resolver.*,
    &mut owner.*,
    &mut request.*,
    &mut dependencies.*,
    Key {
      family: Family.ConformanceHeads,
      module: visibleInterface.module,
      name: providerKey,
      declaration: visibleInterface.ordinal,
      member: usize.ZERO,
      external: false,
    },
    siteSpan,
    nested,
  )
  let failure = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
    &bucket,
    answerRejection,
  )
  if let Option<Shared<Rejection>>.Some {value} = move failure {
    return Result.failResult<(), Shared<Rejection>>(move value)
  }
  let count = Shared.with<Result<Answer, NoRejection>, usize>(&bucket, bucketCount)
  let mut headAt = usize.ZERO
  while headAt < count {
    let added = run appendConcreteHeadSupplier(
      &mut resolver.*,
      &mut owner.*,
      &mut request.*,
      &mut dependencies.*,
      nested,
      provider,
      providerKey,
      &bucket,
      headAt,
      visibleInterface,
      operationOrdinal,
      siteModule,
      siteSpan,
      &mut candidates.*,
      &mut selection.*,
    )
    if let Result<(), Shared<Rejection>>.Failure {error} = move added {
      return Result.failResult<(), Shared<Rejection>>(move error)
    }
    headAt = headAt + usize.ONE
  }
  return Result.succeed<(), Shared<Rejection>>(())
}

// Every operation of one visible interface that carries the requested name is a candidate.
effect fn appendVisibleInterfaceSuppliers(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut Vector<Dependency>,
  nested: bool,
  provider: &Shared<Type>,
  providerKey: usize,
  member: &[u8],
  visibleInterface: &VisibleInterface,
  siteModule: &ModuleId,
  siteSpan: Span,
  candidates: &mut Vector<MethodSupplier>,
  selection: &mut CallSelection,
) -> Result<(), Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let module = run resolvedModule(&resolver.*, visibleInterface.module)
  let listed = run proofDemand(
    &mut resolver.*,
    &mut owner.*,
    &mut request.*,
    &mut dependencies.*,
    Key {
      family: Family.Operations,
      module: visibleInterface.module,
      name: usize.ZERO,
      declaration: visibleInterface.ordinal,
      member: usize.ZERO,
      external: false,
    },
    siteSpan,
    nested,
  )
  let failure = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
    &listed,
    answerRejection,
  )
  if let Option<Shared<Rejection>>.Some {value} = move failure {
    return Result.failResult<(), Shared<Rejection>>(move value)
  }
  let operationCountValue = Shared.with<Result<Answer, NoRejection>, usize>(
    &listed,
    operationCount,
  )
  let mut operationAtIndex = usize.ZERO
  while operationAtIndex < operationCountValue {
    let added = run appendConcreteOperationSuppliers(
      &mut resolver.*,
      &mut owner.*,
      &mut request.*,
      &mut dependencies.*,
      nested,
      provider,
      providerKey,
      member,
      &listed,
      operationAtIndex,
      visibleInterface,
      &module,
      siteModule,
      siteSpan,
      &mut candidates.*,
      &mut selection.*,
    )
    if let Result<(), Shared<Rejection>>.Failure {error} = move added {
      return Result.failResult<(), Shared<Rejection>>(move error)
    }
    operationAtIndex = operationAtIndex + usize.ONE
  }
  return Result.succeed<(), Shared<Rejection>>(())
}

// Concrete receiver syntax sees only interfaces nameable at this call site. Heads come from each
// interface/provider owner bucket; the receiver type alone must determine an applicable head.
effect fn selectConcreteReceiverCall(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut Vector<Dependency>,
  nested: bool,
  provider: &Shared<Type>,
  member: &[u8],
  declared: &[Constraint],
  siteModule: &ModuleId,
  siteSpan: Span,
) -> Result<Option<SelectedReceiverOperation>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let scannedInterfaces = run visibleInterfaces(
    &mut resolver.*,
    &mut owner.*,
    &mut request.*,
    &mut dependencies.*,
    siteModule,
    siteSpan,
  )
  let visible = match move scannedInterfaces {
    Result<Vector<VisibleInterface>, Shared<Rejection>>.Success {value} => value
    Result<Vector<VisibleInterface>, Shared<Rejection>>.Failure {error} => {
      return Result.failResult<Option<SelectedReceiverOperation>, Shared<Rejection>>(move error)
    }
  }
  let interfaces = Vector.asSlice<VisibleInterface>(&visible)
  let mut candidates = Vector.make<MethodSupplier>()
  let mut selection = CallSelection.make()
  let providerKey = run internApplication(&mut resolver.*, provider)
  let mut at = usize.ZERO
  while at < interfaces.length {
    let added = run appendVisibleInterfaceSuppliers(
      &mut resolver.*,
      &mut owner.*,
      &mut request.*,
      &mut dependencies.*,
      nested,
      provider,
      providerKey,
      member,
      &interfaces[at],
      siteModule,
      siteSpan,
      &mut candidates,
      &mut selection,
    )
    if let Result<(), Shared<Rejection>>.Failure {error} = move added {
      return Result.failResult<Option<SelectedReceiverOperation>, Shared<Rejection>>(move error)
    }
    at = at + usize.ONE
  }
  if CallSelection.ambiguous(&selection) {
    return Result.failResult<Option<SelectedReceiverOperation>, Shared<Rejection>>(
      run reject(&resolver.*, siteModule, RejectionCode.AmbiguousConformanceMethod, siteSpan),
    )
  }
  let selected = CallSelection.unique(&selection)
  return run selectedReceiverOperation(
    &mut resolver.*,
    &mut owner.*,
    &mut request.*,
    &mut dependencies.*,
    nested,
    provider,
    declared,
    siteModule,
    siteSpan,
    Vector.asSlice<MethodSupplier>(&candidates),
    move selected,
  )
}

fn witnessFor(answer: &Result<Answer, NoRejection>, operation: &DeclarationId) -> Option<WitnessImplementation> {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Witnesses {witnesses}} = &value.outcome {
      let listed = Vector.asSlice<Witness>(&witnesses)
      let mut at = usize.ZERO
      while at < listed.length {
        if Shared.with<DeclarationId, bool>(
          &listed[at].operation,
          fn(found: &DeclarationId) -> bool {
            return DeclarationId.equals(found, operation)
          },
        ) {
          return Option.some<WitnessImplementation>(copyWitnessImplementation(&listed[at].implementation))
        }
        at = at + usize.ONE
      }
    }
  }
  return Option.none<WitnessImplementation>()
}

// Operand inference opens only the operation's own lifetime slots. In particular a recursive
// use keeps the caller's same-declaration parameters rigid, and original ordinals are not dense
// positions in a signature's grouped lifetime list. The private owner never enters a query key.
effect fn inferOperatorOperands(
  resolver: &mut Resolver,
  signature: &Shared<Result<Answer, NoRejection>>,
  operation: &DeclarationId,
  operands: &[Shared<Type>],
) -> Option<Vector<Binding>> ! OutOfMemoryError ? &mut Allocator {
  let count = Shared.with<Result<Answer, NoRejection>, usize>(&signature.*, signatureParameterCount)
  if count != operands.length { return Option.none<Vector<Binding>>() }
  let mut scope = run Bytes.copy(b"\0operator-use")
  run RuntimeEncoding.word(&mut scope, usize.toU64(resolver.nextInferenceId))
  resolver.nextInferenceId = resolver.nextInferenceId + usize.ONE
  let fresh = run DeclarationId.inference(operation, Bytes.asSlice(&scope))
  let mut opening = Vector.make<Binding>()
  let lifetimeCount = Shared.with<Result<Answer, NoRejection>, usize>(signature, signatureLifetimeCount)
  let mut at = usize.ZERO
  while at < lifetimeCount {
    let region = Shared.with<Result<Answer, NoRejection>, Option<Shared<Lifetime>>>(signature,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Lifetime>> { return signatureLifetimeAt(answer, at) })
    if let Option<Shared<Lifetime>>.Some {value} = move region {
      let ordinal = Shared.with<Lifetime, usize>(&value, fn(lifetime: &Lifetime) -> usize {
        return match &lifetime.* {
          Lifetime.Parameter {declaration, ordinal} => {
            if DeclarationId.equals(&declaration, operation) { return ordinal }
            return usize.MAX
          }
          _ => usize.MAX
        }
      })
      if ordinal != usize.MAX {
        run Vector.append<Binding>(&mut opening, Binding {
          declaration: run Shared.make<DeclarationId>(run DeclarationId.copy(operation)), ordinal: ordinal,
          value: Argument.Lifetime {value: run Shared.make<Lifetime>(Lifetime.Parameter {
            declaration: run DeclarationId.copy(&fresh), ordinal: ordinal})}})
      }
    }
    at = at + usize.ONE
  }
  let mut parameters = Vector.make<Shared<Type>>()
  at = usize.ZERO
  while at < count {
    let parameter = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
      &signature.*,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> {
        return signatureParameter(answer, at)
      },
    )
    let parameterType = match move parameter {
      Option<Shared<Type>>.Some {value} => move value
      Option<Shared<Type>>.None => { return Option.none<Vector<Binding>>() }
    }
    run Vector.append<Shared<Type>>(&mut parameters,
      run Type.applyBindings(&parameterType, Vector.asSlice<Binding>(&opening), true))
    at = at + usize.ONE
  }
  let mut variables = Vector.make<Shared<DeclarationId>>()
  run Vector.append<Shared<DeclarationId>>(&mut variables, run Shared.make<DeclarationId>(run DeclarationId.copy(&fresh)))
  let mut learned = Vector.make<Binding>()
  let compared = run Type.unifyAll(Vector.asSlice<Shared<Type>>(&parameters), operands,
    Vector.asSlice<Shared<DeclarationId>>(&variables), Comparison.Exact, &mut learned)
  let unified = match &compared { Unification.Unified => true _ => false }
  if unified {
    let inferred = Vector.asSlice<Binding>(&learned)
    let mut canonical = Vector.make<Binding>()
    at = usize.ZERO
    while at < inferred.length {
      let own = Shared.with<DeclarationId, bool>(&inferred[at].declaration,
        fn(identity: &DeclarationId) -> bool { return DeclarationId.equals(identity, &fresh) })
      let lifetime = match &inferred[at].value { Argument.Lifetime {..} => true _ => false }
      let permitted = Shared.with<Result<Answer, NoRejection>, bool>(signature,
        fn(answer: &Result<Answer, NoRejection>) -> bool { return signatureLifetimeBinder(answer, inferred[at].ordinal) })
      if !own || !lifetime || !permitted { return Option.none<Vector<Binding>>() }
      if run argumentMentionsOwner(&inferred[at].value, &fresh) { return Option.none<Vector<Binding>>() }
      run Vector.append<Binding>(&mut canonical, Binding {
        declaration: run Shared.make<DeclarationId>(run DeclarationId.copy(operation)), ordinal: inferred[at].ordinal,
        value: Argument.copy(&inferred[at].value)})
      at = at + usize.ONE
    }
    // Publication uses the original signature and a single substitution pass. Prove those
    // canonical equations too; a private comparison's success alone is not its call recipe.
    at = usize.ZERO
    while at < operands.length {
      let original = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(signature,
        fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> { return signatureParameter(answer, at) })
      if let Option<Shared<Type>>.Some {value} = move original {
        let applied = run Type.applyBindings(&value, Vector.asSlice<Binding>(&canonical), true)
        if !run Type.equalsShared(&applied, &operands[at]) { return Option.none<Vector<Binding>>() }
      } else { return Option.none<Vector<Binding>>() }
      at = at + usize.ONE
    }
    return Option.some<Vector<Binding>>(move canonical)
  }
  return Option.none<Vector<Binding>>()
}

// Eligibility reads only written operands. Result, witness, obligations and expected expression
// type cannot narrow two suppliers accepting identical operands. Each probe owns its bindings.
effect fn matchesOperatorOperands(resolver: &mut Resolver, signature: &Shared<Result<Answer, NoRejection>>,
  operation: &Shared<DeclarationId>, operands: &[Shared<Type>]) -> bool
! OutOfMemoryError ? &mut Allocator {
  let identity = run DeclarationId.copyShared(operation)
  return match move run inferOperatorOperands(&mut resolver.*, signature, &identity, operands) {
    Option<Vector<Binding>>.Some {..} => true
    Option<Vector<Binding>>.None => false
  }
}

// An open implementation head is outside this concrete candidate path. Only retain an
// Unsupported boundary if its operand pattern can actually accept the written operands.
effect fn openOperatorCouldMatch(
  signature: &Shared<Result<Answer, NoRejection>>,
  operands: &[Shared<Type>],
  head: &Shared<ImplementationHead>,
) -> bool ! OutOfMemoryError ? &mut Allocator {
  let count = Shared.with<Result<Answer, NoRejection>, usize>(&signature.*, signatureParameterCount)
  if count != operands.length {
    return false
  }
  let mut parameters = Vector.make<Shared<Type>>()
  let mut at = usize.ZERO
  while at < count {
    let parameter = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
      &signature.*,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> {
        return signatureParameter(answer, at)
      },
    )
    if let Option<Shared<Type>>.Some {value} = move parameter {
      run Vector.append<Shared<Type>>(&mut parameters, move value)
    } else {
      return false
    }
    at = at + usize.ONE
  }
  let identity = Shared.with<ImplementationHead, Shared<DeclarationId>>(
    head,
    fn(value: &ImplementationHead) -> Shared<DeclarationId> {
      return Shared.clone<DeclarationId>(&value.declaration)
    },
  )
  let mut variables = Vector.make<Shared<DeclarationId>>()
  run Vector.append<Shared<DeclarationId>>(&mut variables, move identity)
  let mut bindings = Vector.make<Binding>()
  let compared = run Type.unifyAll(
    Vector.asSlice<Shared<Type>>(&parameters),
    operands,
    Vector.asSlice<Shared<DeclarationId>>(&variables),
    Comparison.Exact,
    &mut bindings,
  )
  return match move compared {
    Unification.Distinct => false
    _ => true
  }
}

// Without a provider-owned operand, a provider-only implementation module cannot be found from
// an unqualified expression. Keep that unsettled shape explicit when its operand pattern fits.
effect fn unanchoredOperatorCouldMatch(
  signature: &Shared<Result<Answer, NoRejection>>,
  operands: &[Shared<Type>],
  contract: &Shared<DeclarationId>,
  operation: &Shared<DeclarationId>,
  selfOrdinal: usize,
) -> bool ! OutOfMemoryError ? &mut Allocator {
  let count = Shared.with<Result<Answer, NoRejection>, usize>(&signature.*, signatureParameterCount)
  if count != operands.length {
    return false
  }
  let mut parameters = Vector.make<Shared<Type>>()
  let mut at = usize.ZERO
  while at < count {
    let parameter = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
      &signature.*,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> {
        return signatureParameter(answer, at)
      },
    )
    let parameterType = match move parameter {
      Option<Shared<Type>>.Some {value} => value
      Option<Shared<Type>>.None => {
        return false
      }
    }
    let owns = Shared.with<DeclarationId, bool>(
      contract,
      fn(identity: &DeclarationId) -> bool {
        return Type.occurrences(&parameterType, identity, selfOrdinal) > usize.ZERO
      },
    )
    if owns {
      return false
    }
    run Vector.append<Shared<Type>>(&mut parameters, move parameterType)
    at = at + usize.ONE
  }
  let mut variables = Vector.make<Shared<DeclarationId>>()
  run Vector.append<Shared<DeclarationId>>(&mut variables, Shared.clone<DeclarationId>(contract))
  run Vector.append<Shared<DeclarationId>>(&mut variables, Shared.clone<DeclarationId>(operation))
  let mut bindings = Vector.make<Binding>()
  let compared = run Type.unifyAll(
    Vector.asSlice<Shared<Type>>(&parameters),
    operands,
    Vector.asSlice<Shared<DeclarationId>>(&variables),
    Comparison.Exact,
    &mut bindings,
  )
  return match move compared {
    Unification.Distinct => false
    _ => true
  }
}

// The supplier is already fixed before this call. Prove its exact application, then demand the
// same substituted operation signature for qualified, receiver, and operator syntax. A concrete
// proof names the checked witness body; a declared proof leaves that choice to specialization.
effect fn selectOperationCall(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut Vector<Dependency>,
  nested: bool,
  contract: &Shared<Type>,
  provider: &Shared<Type>,
  operation: &DeclarationId,
  declared: &[Constraint],
  siteModule: &ModuleId,
  siteSpan: Span,
) -> Result<OperationCall, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let contractModule = declaringModuleOrdinal(&resolver.*, contract)
  if contractModule == usize.MAX {
    fail InvalidModulePath {}
  }
  let module = run resolvedModule(&resolver.*, contractModule)
  let identity = run Shared.make<DeclarationId>(run DeclarationId.copy(operation))
  let ordinal = run ordinalOfIdentity(&mut resolver.*, &module, &identity)
  let position = match move ordinal {
    Option<usize>.Some {value} => value
    Option<usize>.None => {
      return Result.failResult<OperationCall, Shared<Rejection>>(
        run reject(&resolver.*, siteModule, RejectionCode.UnknownMember, siteSpan),
      )
    }
  }
  let contractOrdinal = run ordinalOfProvider(&mut resolver.*, &module, contract)
  let contractPosition = match move contractOrdinal {
    Option<usize>.Some {value} => value
    Option<usize>.None => {
      return Result.failResult<OperationCall, Shared<Rejection>>(
        run reject(&resolver.*, siteModule, RejectionCode.UnknownMember, siteSpan),
      )
    }
  }
  let operations = run proofDemand(
    &mut resolver.*,
    &mut owner.*,
    &mut request.*,
    &mut dependencies.*,
    Key {
      family: Family.Operations,
      module: contractModule,
      name: usize.ZERO,
      declaration: contractPosition,
      member: usize.ZERO,
      external: false,
    },
    siteSpan,
    nested,
  )
  let invalidOperations = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
    &operations,
    answerRejection,
  )
  if let Option<Shared<Rejection>>.Some {value} = move invalidOperations {
    return Result.failResult<OperationCall, Shared<Rejection>>(move value)
  }
  if Shared.with<Result<Answer, NoRejection>, usize>(
    &operations,
    fn(answer: &Result<Answer, NoRejection>) -> usize {
      return operationIndex(answer, operation)
    },
  ) == usize.MAX {
    return Result.failResult<OperationCall, Shared<Rejection>>(
      run reject(&resolver.*, siteModule, RejectionCode.UnknownMember, siteSpan),
    )
  }
  let goal = ConformanceGoal {
    contract: Shared.clone<Type>(contract),
    provider: Shared.clone<Type>(provider),
  }
  let mut chain = Vector.make<ConformanceGoal>()
  let mut steps = Vector.make<ConformanceStep>()
  let avoid = Option.none<Shared<DeclarationId>>()
  let failed = run proveGoal(
    &mut resolver.*,
    &mut owner.*,
    &mut request.*,
    &mut dependencies.*,
    nested,
    &avoid,
    &goal,
    declared,
    siteModule,
    siteSpan,
    &mut chain,
    &mut steps,
  )
  if let Option<Shared<Rejection>>.Some {value} = move failed {
    return Result.failResult<OperationCall, Shared<Rejection>>(move value)
  }
  let contractKey = run internApplication(&mut resolver.*, contract)
  let providerKey = run internApplication(&mut resolver.*, provider)
  let signature = run proofDemand(
    &mut resolver.*,
    &mut owner.*,
    &mut request.*,
    &mut dependencies.*,
    Key {
      family: Family.AppliedOperation,
      module: contractModule,
      name: contractKey,
      declaration: position,
      member: providerKey,
      external: false,
    },
    siteSpan,
    nested,
  )
  let invalid = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
    &signature,
    answerRejection,
  )
  if let Option<Shared<Rejection>>.Some {value} = move invalid {
    return Result.failResult<OperationCall, Shared<Rejection>>(move value)
  }
  let mut implementation = Option.none<Shared<DeclarationId>>()
  let complete = Vector.asSlice<ConformanceStep>(&steps)
  if complete.length > usize.ZERO {
    if let ConformanceEvidence.Concrete {head, ..} = &complete[complete.length - usize.ONE].evidence {
      let witnessOwner = Shared.with<ImplementationHead, Shared<DeclarationId>>(
        &head,
        fn(value: &ImplementationHead) -> Shared<DeclarationId> {
          return Shared.clone<DeclarationId>(&value.declaration)
        },
      )
      let witnessModule = Shared.with<DeclarationId, usize>(
        &witnessOwner,
        fn(value: &DeclarationId) -> usize {
          return knownModuleOrdinal(&resolver.*, DeclarationId.moduleId(value))
        },
      )
      if witnessModule == usize.MAX {
        fail InvalidModulePath {}
      }
      let witnessSource = run resolvedModule(&resolver.*, witnessModule)
      let found = run ordinalOfIdentity(&mut resolver.*, &witnessSource, &witnessOwner)
      let witnessOrdinal = match move found {
        Option<usize>.Some {value} => value
        Option<usize>.None => {
          return Result.failResult<OperationCall, Shared<Rejection>>(
            run reject(&resolver.*, siteModule, RejectionCode.UnknownMember, siteSpan),
          )
        }
      }
      let witnesses = run proofDemand(
        &mut resolver.*,
        &mut owner.*,
        &mut request.*,
        &mut dependencies.*,
        Key {
          family: Family.Witnesses,
          module: witnessModule,
          name: usize.ZERO,
          declaration: witnessOrdinal,
          member: usize.ZERO,
          external: false,
        },
        siteSpan,
        nested,
      )
      let mapped = Shared.with<Result<Answer, NoRejection>, Option<WitnessImplementation>>(
        &witnesses,
        fn(answer: &Result<Answer, NoRejection>) -> Option<WitnessImplementation> {
          return witnessFor(answer, operation)
        },
      )
      if let Option<WitnessImplementation>.Some {value} = move mapped {
        // A scalar intrinsic witness runs in place and has no body to require.
        if let WitnessImplementation.Declaration {declaration} = move value {
          implementation = Option.some<Shared<DeclarationId>>(move declaration)
        }
      } else {
        return Result.failResult<OperationCall, Shared<Rejection>>(
          run reject(&resolver.*, siteModule, RejectionCode.IncompatibleWitness, siteSpan),
        )
      }
    }
  }
  return Result.succeed<OperationCall, Shared<Rejection>>(
    OperationCall {
      operation: run DeclarationId.copy(operation),
      implementation: move implementation,
      signature: move signature,
      proof: ConformanceProof {steps: move steps},
      receiver: Option.none<ReceiverPosition>(),
    },
  )
}

effect fn appendVisibleOperatorInterface(
  resolver: &mut Resolver,
  location: SelectedDeclaration,
  visible: &mut Vector<Shared<DeclarationId>>,
) -> () ! Cycle | OutOfMemoryError ? &mut Allocator {
  let target = run resolvedModule(&resolver.*, location.module)
  let written = run header(&mut resolver.*, &target, location.ordinal)
  if let Option<HeaderSyntax>.Some {value} = move written {
    if let Node.InterfaceHeader {..} = value.header {
      let sourceAnswer = run source(&mut resolver.*, &target)
      let found = run SourceIndex.sharedIdentity(&mut resolver.source, &sourceAnswer, &target, location.ordinal)
      if let Option<Shared<DeclarationId>>.Some {value: identity} = move found {
        let prior = Vector.asSlice<Shared<DeclarationId>>(&visible.*)
        let mut before = usize.ZERO
        while before < prior.length {
          if sameDeclarationShared(&prior[before], &identity) {
            return ()
          }
          before = before + usize.ONE
        }
        run Vector.append<Shared<DeclarationId>>(&mut visible.*, move identity)
      }
    }
  }
  return ()
}

// Repeated imports spell one lookup. Selection still examines the complete candidate bucket,
// preserving collisions between distinct bindings and the query's source dependencies.
effect fn appendOperatorName(names: &mut Vector<Bytes>, name: &[u8]) -> ()
! OutOfMemoryError ? &mut Allocator {
  let listed = Vector.asSlice<Bytes>(&names.*)
  let mut at = usize.ZERO
  while at < listed.length {
    if same(Bytes.asSlice(&listed[at]), name) {
      return ()
    }
    at = at + usize.ONE
  }
  run Vector.append<Bytes>(&mut names.*, run Bytes.copy(name))
  return ()
}

// An imported member or a declared interface can be named by operator syntax.
fn namesOperatorInterface(
  candidate: &Candidate,
  declarations: &[IndexedDeclaration],
  hir: &Module,
) -> bool {
  if candidate.kind == CandidateKind.ImportMember {
    return true
  }
  if candidate.kind != CandidateKind.Declaration || candidate.declaration >= declarations.length {
    return false
  }
  if let Node.InterfaceHeader {..} = Module.node(hir, declarations[candidate.declaration].header) {
    return true
  }
  return false
}

effect fn publicOperatorInterfaceNames(
  resolver: &Resolver,
  targetSource: &Shared<Result<SourceResult, NoRejection>>,
  target: &ModuleId,
) -> Vector<Bytes> ! OutOfMemoryError ? &mut Allocator {
  let mut publicNames = Vector.make<Bytes>()
  let found = sourceOf(&resolver.*, targetSource, target)
  let indexed = match move found {
    Option<&IndexedSource>.Some {value} => value
    Option<&IndexedSource>.None => {
      return move publicNames
    }
  }
  let candidates = ModuleIndex.listCandidates(IndexedSource.moduleIndex(indexed))
  let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(indexed))
  let hir = IndexedSource.authored(indexed)
  let mut candidateAt = usize.ZERO
  while candidateAt < candidates.length {
    let candidate = &candidates[candidateAt]
    if candidate.isPublic && namesOperatorInterface(candidate, declarations, hir) {
      run appendOperatorName(&mut publicNames, Bytes.asSlice(&candidate.name))
    }
    candidateAt = candidateAt + usize.ONE
  }
  return move publicNames
}

// Whether conditional `conditional` of module `moduleOrdinal` is the condition whose evaluation
// context the running demand belongs to (see `ScopedKey.condition`).
fn evaluatingCondition(resolver: &Resolver, moduleOrdinal: usize, conditional: usize) -> bool {
  let active = Vector.asSlice<Word>(&resolver.active)
  if active.length == usize.ZERO {
    return false
  }
  let runningWord = u64.toUsize(active[active.length - usize.ONE].value)
  let running = Vector.get<ScopedKey>(&resolver.keys, runningWord)
  let mut contextWord = running.condition
  if running.key.family == Family.Condition {
    contextWord = runningWord
  }
  if contextWord == usize.MAX {
    return false
  }
  let context = Vector.get<ScopedKey>(&resolver.keys, contextWord).key
  return context.module == moduleOrdinal && context.declaration == conditional
}

// Whether an enclosing module-level arm of `ordinal` belongs to the condition being evaluated.
fn armChainEvaluated(resolver: &Resolver, moduleOrdinal: usize, declarations: &[IndexedDeclaration], ordinal: usize) -> bool {
  let mut current = ordinal
  while true {
    if let Option<Arm>.Some {value: arm} = &declarations[current].arm {
      if evaluatingCondition(resolver, moduleOrdinal, arm.conditional) { return true }
      current = arm.conditional
    } else {
      return false
    }
  }
  return false
}

// Whether every candidate of `name` sits in an arm of the condition being evaluated.
effect fn guardedByEvaluatedCondition(resolver: &mut Resolver, module: &ModuleId, name: &[u8]) -> bool
! Cycle | OutOfMemoryError
? &mut Allocator {
  let moduleOrdinal = knownModuleOrdinal(&resolver.*, module)
  if moduleOrdinal == usize.MAX {
    return false
  }
  let answer = run source(&mut resolver.*, module)
  if let Option<&IndexedSource>.Some {value} = move sourceOf(&resolver.*, &answer, module) {
    let candidates = ModuleIndex.listCandidates(IndexedSource.moduleIndex(value))
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(value))
    let mut found = false
    let mut at = usize.ZERO
    while at < candidates.length {
      if same(Bytes.asSlice(&candidates[at].name), name) {
        found = true
        if !armChainEvaluated(&resolver.*, moduleOrdinal, declarations, candidates[at].declaration) {
          return false
        }
      }
      at = at + usize.ONE
    }
    return found
  }
  return false
}

// MODULE-STATIC-002: interface scans for operator and method syntax name no declaration, and an
// unrelated declaration is never checked to determine a condition. Inside a condition's evaluation
// context a name whose candidates all sit in that condition's arms is invisible; elsewhere a name
// is visible when a selected arm admits it. `None` means not visible.
effect fn scannedSelection(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  module: &ModuleId,
  name: &[u8],
  external: bool,
) -> Result<Option<Selection>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  if run guardedByEvaluatedCondition(&mut resolver.*, module, name) {
    return Result.succeed<Option<Selection>, Shared<Rejection>>(Option.none<Selection>())
  }
  let outcome = run select(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, name, external)
  return match move outcome {
    Result<Selection, Shared<Rejection>>.Success {value} => {
      if value.count == usize.ZERO {
        return Result.succeed<Option<Selection>, Shared<Rejection>>(Option.none<Selection>())
      }
      return Result.succeed<Option<Selection>, Shared<Rejection>>(Option.some<Selection>(value))
    }
    Result<Selection, Shared<Rejection>>.Failure {error} => Result.failResult<Option<Selection>, Shared<Rejection>>(move error)
  }
}

// An imported module namespace opens the public interfaces of the module it names.
effect fn appendNamespaceOperatorInterfaces(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  module: &ModuleId,
  moduleOrdinal: usize,
  namespace: &[u8],
  span: Span,
  visible: &mut Vector<Shared<DeclarationId>>,
) -> Result<(), Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let scanned = run scannedSelection(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, namespace, false)
  let visibleNamespace = match move scanned {
    Result<Option<Selection>, Shared<Rejection>>.Success {value} => value
    Result<Option<Selection>, Shared<Rejection>>.Failure {error} => {
      return Result.failResult<(), Shared<Rejection>>(move error)
    }
  }
  let selected = match move visibleNamespace {
    Option<Selection>.Some {value} => value
    Option<Selection>.None => {
      return Result.succeed<(), Shared<Rejection>>(())
    }
  }
  if selected.count != usize.ONE || selected.kind != CandidateKind.ImportModule {
    return Result.succeed<(), Shared<Rejection>>(())
  }
  let binding = run demandChild(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies.*,
    Key {
      family: Family.Import,
      module: moduleOrdinal,
      name: usize.ZERO,
      declaration: selected.declaration,
      member: usize.MAX,
      external: false,
    },
    span,
  )
  let importSelection = Shared.with<Result<Answer, NoRejection>, ImportSelection>(
    &binding,
    selectedImport,
  )
  if let Option<Shared<Rejection>>.Some {value} = move importSelection.rejected {
    return Result.failResult<(), Shared<Rejection>>(move value)
  }
  let targetOrdinal = match move importSelection.module {
    Option<usize>.Some {value} => value
    Option<usize>.None => {
      return Result.succeed<(), Shared<Rejection>>(())
    }
  }
  let target = run resolvedModule(&resolver.*, targetOrdinal)
  let targetSource = run source(&mut resolver.*, &target)
  let publicNames = run publicOperatorInterfaceNames(&resolver.*, &targetSource, &target)
  let public = Vector.asSlice<Bytes>(&publicNames)
  let mut publicAt = usize.ZERO
  while publicAt < public.length {
    let scanned = run scannedSelection(&mut resolver.*, &mut owner.*, &mut dependencies.*, &target, Bytes.asSlice(&public[publicAt]), true)
    let scannedName = match move scanned {
      Result<Option<Selection>, Shared<Rejection>>.Success {value} => value
      Result<Option<Selection>, Shared<Rejection>>.Failure {error} => {
        return Result.failResult<(), Shared<Rejection>>(move error)
      }
    }
    if let Option<Selection>.None = move scannedName {
      publicAt = publicAt + usize.ONE
      continue
    }
    let found = run selectDeclaration(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies.*,
      targetOrdinal,
      &target,
      Bytes.asSlice(&public[publicAt]),
      true,
      span,
      RejectionCode.NotType,
    )
    let location = match move found {
      Result<SelectedDeclaration, Shared<Rejection>>.Success {value} => value
      Result<SelectedDeclaration, Shared<Rejection>>.Failure {error} => {
        return Result.failResult<(), Shared<Rejection>>(move error)
      }
    }
    run appendVisibleOperatorInterface(&mut resolver.*, move location, &mut visible.*)
    publicAt = publicAt + usize.ONE
  }
  return Result.succeed<(), Shared<Rejection>>(())
}

// Operator syntax has no written interface name. Local interfaces, selected imports, and public
// interfaces reachable through an imported module namespace are all statically nameable.
effect fn collectOperatorInterfaces(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  module: &ModuleId,
  span: Span,
) -> Result<Vector<Shared<DeclarationId>>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let sourceAnswer = run source(&mut resolver.*, module)
  let mut names = Vector.make<Bytes>()
  let mut namespaces = Vector.make<Bytes>()
  if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(
    &resolver.*,
    &sourceAnswer,
    module,
  ) {
    let candidates = ModuleIndex.listCandidates(IndexedSource.moduleIndex(indexed))
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(indexed))
    let hir = IndexedSource.authored(indexed)
    let mut at = usize.ZERO
    while at < candidates.length {
      let candidate = &candidates[at]
      if namesOperatorInterface(candidate, declarations, hir) {
        run appendOperatorName(&mut names, Bytes.asSlice(&candidate.name))
      } else if candidate.kind == CandidateKind.ImportModule {
        run appendOperatorName(&mut namespaces, Bytes.asSlice(&candidate.name))
      }
      at = at + usize.ONE
    }
  }
  let moduleOrdinal = run internModule(&mut resolver.*, module)
  let mut visible = Vector.make<Shared<DeclarationId>>()
  let listed = Vector.asSlice<Bytes>(&names)
  let mut at = usize.ZERO
  while at < listed.length {
    let scanned = run scannedSelection(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, Bytes.asSlice(&listed[at]), false)
    let scannedName = match move scanned {
      Result<Option<Selection>, Shared<Rejection>>.Success {value} => value
      Result<Option<Selection>, Shared<Rejection>>.Failure {error} => {
        return Result.failResult<Vector<Shared<DeclarationId>>, Shared<Rejection>>(move error)
      }
    }
    if let Option<Selection>.None = move scannedName {
      at = at + usize.ONE
      continue
    }
    let selected = run selectDeclaration(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies.*,
      moduleOrdinal,
      module,
      Bytes.asSlice(&listed[at]),
      false,
      span,
      RejectionCode.NotType,
    )
    let location = match move selected {
      Result<SelectedDeclaration, Shared<Rejection>>.Success {value} => value
      Result<SelectedDeclaration, Shared<Rejection>>.Failure {error} => {
        return Result.failResult<Vector<Shared<DeclarationId>>, Shared<Rejection>>(move error)
      }
    }
    run appendVisibleOperatorInterface(&mut resolver.*, move location, &mut visible)
    at = at + usize.ONE
  }
  let imported = Vector.asSlice<Bytes>(&namespaces)
  let mut namespaceAt = usize.ZERO
  while namespaceAt < imported.length {
    let added = run appendNamespaceOperatorInterfaces(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies.*,
      module,
      moduleOrdinal,
      Bytes.asSlice(&imported[namespaceAt]),
      span,
      &mut visible,
    )
    if let Result<(), Shared<Rejection>>.Failure {error} = move added {
      return Result.failResult<Vector<Shared<DeclarationId>>, Shared<Rejection>>(move error)
    }
    namespaceAt = namespaceAt + usize.ONE
  }
  return Result.succeed<Vector<Shared<DeclarationId>>, Shared<Rejection>>(move visible)
}

// Discovery has one source-validated answer per module and query scope. Its import/name
// dependencies belong to that answer, rather than to every operator expression's body ledger.
effect fn resolveOperatorInterfaces(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  key: Key,
) -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let module = run resolvedModule(&resolver.*, key.module)
  let mut dependencies = Vector.make<Dependency>()
  let discovered = run collectOperatorInterfaces(
    &mut resolver.*, &mut owner.*, &mut dependencies, &module,
    Span.make(usize.ZERO, usize.ZERO),
  )
  let interfaces = match move discovered {
    Result<Vector<Shared<DeclarationId>>, Shared<Rejection>>.Success {value} => value
    Result<Vector<Shared<DeclarationId>>, Shared<Rejection>>.Failure {error} => {
      return memberRejected(move error, move dependencies)
    }
  }
  return memberSuccess(Value.OperatorInterfaces {interfaces: move interfaces}, move dependencies)
}

fn operatorInterfaceCount(answer: &Result<Answer, NoRejection>) -> usize {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.OperatorInterfaces {interfaces}} = &value.outcome {
      return Vector.length<Shared<DeclarationId>>(&interfaces)
    }
  }
  return usize.ZERO
}

fn operatorInterfaceAt(answer: &Result<Answer, NoRejection>, at: usize) -> Option<Shared<DeclarationId>> {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.OperatorInterfaces {interfaces}} = &value.outcome {
      let listed = Vector.asSlice<Shared<DeclarationId>>(&interfaces)
      if at < listed.length { return Option.some<Shared<DeclarationId>>(Shared.clone<DeclarationId>(&listed[at])) }
    }
  }
  return Option.none<Shared<DeclarationId>>()
}

// Name-selection failures have no expression location inside the shared discovery query.
// Import and declaration diagnostics already own their source spans and remain unchanged.
fn operatorDiscoverySiteCode(diagnostic: &Rejection) -> Option<RejectionCode> {
  if diagnostic.span.start == usize.ZERO && diagnostic.span.end == usize.ZERO {
    let code = diagnostic.code
    if code == RejectionCode.UnknownName || code == RejectionCode.UnknownMember ||
      code == RejectionCode.PrivateMember || code == RejectionCode.Collision || code == RejectionCode.NotType {
      return Option.some<RejectionCode>(code)
    }
  }
  return Option.none<RejectionCode>()
}

fn concreteOperatorGoal(head: &ImplementationHead, contractIdentity: &DeclarationId) -> Option<
  ConformanceGoal,
> {
  return match & head.kind {
    ImplementationKind.Conformance => {
      if let Option<Shared<Type>>.Some {value: contract} = &head.contract {
        if Shared.with<Type, bool>(
          &contract,
          fn(value: &Type) -> bool {
            return applicationMatches(value, contractIdentity)
          },
        ) {
          return Option.some<ConformanceGoal>(
            ConformanceGoal {
              contract: Shared.clone<Type>(&contract),
              provider: Shared.clone<Type>(&head.provider),
            },
          )
        }
      }
      return Option.none<ConformanceGoal>()
    }
    _ => Option.none<ConformanceGoal>()
  }
}

effect fn appendOperatorModule(modules: &mut Vector<usize>, ordinal: usize) -> ()
! OutOfMemoryError
? &mut Allocator {
  if ordinal == usize.MAX {
    return ()
  }
  let listed = Vector.asSlice<usize>(&modules.*)
  let mut at = usize.ZERO
  while at < listed.length {
    if listed[at] == ordinal {
      return ()
    }
    at = at + usize.ONE
  }
  run Vector.append<usize>(&mut modules.*, ordinal)
  return ()
}

// One operation of a bound interface supplies the operator when it carries the requested mark
// and its applied signature accepts the operands.
effect fn gatherBoundOperation(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  suppliers: &mut Vector<OperatorCandidate>,
  choice: &mut CallSelection,
  requested: &Operator.Spelling,
  operands: &[Shared<Type>],
  contract: &Shared<Type>,
  provider: &Shared<Type>,
  contractModule: &ModuleId,
  moduleOrdinal: usize,
  listed: &Shared<Result<Answer, NoRejection>>,
  listedAt: usize,
  siteModule: &ModuleId,
  siteSpan: Span,
) -> Result<(), Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let supplied = Shared.with<Result<Answer, NoRejection>, Option<Shared<DeclarationId>>>(
    listed,
    fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<DeclarationId>> {
      return listedOperation(answer, listedAt)
    },
  )
  let operation = match move supplied {
    Option<Shared<DeclarationId>>.Some {value} => value
    Option<Shared<DeclarationId>>.None => {
      return Result.succeed<(), Shared<Rejection>>(())
    }
  }
  let marker = run operationMarks(&mut resolver.*, contractModule, &operation, requested)
  let valueOnly = match move marker {
    Option<bool>.Some {value} => value
    Option<bool>.None => {
      return Result.succeed<(), Shared<Rejection>>(())
    }
  }
  let foundOrdinal = run ordinalOfIdentity(&mut resolver.*, contractModule, &operation)
  let operationOrdinal = match move foundOrdinal {
    Option<usize>.Some {value} => value
    Option<usize>.None => {
      return Result.succeed<(), Shared<Rejection>>(())
    }
  }
  let contractKey = run internApplication(&mut resolver.*, contract)
  let providerKey = run internApplication(&mut resolver.*, provider)
  let signature = run demandChild(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies.*,
    Key {
      family: Family.AppliedOperation,
      module: moduleOrdinal,
      name: contractKey,
      declaration: operationOrdinal,
      member: providerKey,
      external: false,
    },
    siteSpan,
  )
  let invalid = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
    &signature,
    answerRejection,
  )
  if let Option<Shared<Rejection>>.Some {value} = move invalid {
    return Result.failResult<(), Shared<Rejection>>(move value)
  }
  if !run matchesOperatorOperands(&mut resolver.*, &signature, &operation, operands) {
    return Result.succeed<(), Shared<Rejection>>(())
  }
  if !valueOnly {
    return Result.failResult<(), Shared<Rejection>>(
      run reject(&resolver.*, siteModule, RejectionCode.Unsupported, siteSpan),
    )
  }
  run addOperatorCandidate(
    &mut suppliers.*,
    &mut choice.*,
    contract,
    provider,
    moduleOrdinal,
    operationOrdinal,
  )
  return Result.succeed<(), Shared<Rejection>>(())
}

// The operations of one written interface bound can supply the requested operator.
effect fn gatherBoundContract(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  suppliers: &mut Vector<OperatorCandidate>,
  choice: &mut CallSelection,
  requested: &Operator.Spelling,
  operands: &[Shared<Type>],
  provider: &Shared<Type>,
  contract: &Shared<Type>,
  siteModule: &ModuleId,
  siteSpan: Span,
) -> Result<(), Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let moduleOrdinal = declaringModuleOrdinal(&resolver.*, contract)
  if moduleOrdinal == usize.MAX {
    return Result.succeed<(), Shared<Rejection>>(())
  }
  let contractModule = run resolvedModule(&resolver.*, moduleOrdinal)
  let found = run ordinalOfProvider(&mut resolver.*, &contractModule, contract)
  let contractOrdinal = match move found {
    Option<usize>.Some {value} => value
    Option<usize>.None => {
      return Result.succeed<(), Shared<Rejection>>(())
    }
  }
  let listed = run demandChild(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies.*,
    Key {
      family: Family.Operations,
      module: moduleOrdinal,
      name: usize.ZERO,
      declaration: contractOrdinal,
      member: usize.ZERO,
      external: false,
    },
    siteSpan,
  )
  let rejected = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
    &listed,
    answerRejection,
  )
  if let Option<Shared<Rejection>>.Some {value} = move rejected {
    return Result.failResult<(), Shared<Rejection>>(move value)
  }
  let count = Shared.with<Result<Answer, NoRejection>, usize>(&listed, listedOperationCount)
  let mut at = usize.ZERO
  while at < count {
    let gathered = run gatherBoundOperation(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies.*,
      &mut suppliers.*,
      &mut choice.*,
      requested,
      operands,
      contract,
      provider,
      &contractModule,
      moduleOrdinal,
      &listed,
      at,
      siteModule,
      siteSpan,
    )
    if let Result<(), Shared<Rejection>>.Failure {error} = move gathered {
      return Result.failResult<(), Shared<Rejection>>(move error)
    }
    at = at + usize.ONE
  }
  return Result.succeed<(), Shared<Rejection>>(())
}

// A bound whose provider and contract are both closed is proven concretely, not through the bound.
effect fn gatherBoundConstraint(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  suppliers: &mut Vector<OperatorCandidate>,
  choice: &mut CallSelection,
  requested: &Operator.Spelling,
  operands: &[Shared<Type>],
  constraint: &Constraint,
  siteModule: &ModuleId,
  siteSpan: Span,
) -> Result<(), Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  if let Constraint.Conforms {provider, contract} = &constraint.* {
    if Type.hasOpenParameters(&provider) || Type.hasOpenParameters(&contract) {
      return run gatherBoundContract(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies.*,
        &mut suppliers.*,
        &mut choice.*,
        requested,
        operands,
        &provider,
        &contract,
        siteModule,
        siteSpan,
      )
    }
  }
  return Result.succeed<(), Shared<Rejection>>(())
}

effect fn gatherBoundOperator(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  suppliers: &mut Vector<OperatorCandidate>,
  choice: &mut CallSelection,
  requested: &Operator.Spelling,
  operands: &[Shared<Type>],
  declared: &[Constraint],
  siteModule: &ModuleId,
  siteSpan: Span,
) -> Result<(), Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let mut boundAt = usize.ZERO
  while boundAt < declared.length {
    let gathered = run gatherBoundConstraint(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies.*,
      &mut suppliers.*,
      &mut choice.*,
      requested,
      operands,
      &declared[boundAt],
      siteModule,
      siteSpan,
    )
    if let Result<(), Shared<Rejection>>.Failure {error} = move gathered {
      return Result.failResult<(), Shared<Rejection>>(move error)
    }
    boundAt = boundAt + usize.ONE
  }
  return Result.succeed<(), Shared<Rejection>>(())
}

// One conformance head of an operand owner supplies the operator when its applied signature
// accepts the operands. A generic head only reports that it might match, by returning true.
effect fn gatherConcreteHead(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  suppliers: &mut Vector<OperatorCandidate>,
  choice: &mut CallSelection,
  operands: &[Shared<Type>],
  contractIdentity: &DeclarationId,
  moduleOrdinal: usize,
  operationOrdinal: usize,
  operation: &Shared<DeclarationId>,
  valueOnly: bool,
  heads: &Shared<Result<Answer, NoRejection>>,
  headAt: usize,
  siteModule: &ModuleId,
  siteSpan: Span,
) -> Result<bool, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let candidate = Shared.with<Result<Answer, NoRejection>, Option<Shared<ImplementationHead>>>(
    heads,
    fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<ImplementationHead>> {
      return implementationAt(answer, headAt)
    },
  )
  let head = match move candidate {
    Option<Shared<ImplementationHead>>.Some {value} => value
    Option<Shared<ImplementationHead>>.None => {
      return Result.succeed<bool, Shared<Rejection>>(false)
    }
  }
  let goal = Shared.with<ImplementationHead, Option<ConformanceGoal>>(
    &head,
    fn(value: &ImplementationHead) -> Option<ConformanceGoal> {
      return concreteOperatorGoal(value, contractIdentity)
    },
  )
  let applied = match move goal {
    Option<ConformanceGoal>.Some {value} => value
    Option<ConformanceGoal>.None => {
      return Result.succeed<bool, Shared<Rejection>>(false)
    }
  }
  let contractKey = run internApplication(&mut resolver.*, &applied.contract)
  let providerKey = run internApplication(&mut resolver.*, &applied.provider)
  let signature = run demandChild(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies.*,
    Key {
      family: Family.AppliedOperation,
      module: moduleOrdinal,
      name: contractKey,
      declaration: operationOrdinal,
      member: providerKey,
      external: false,
    },
    siteSpan,
  )
  let rejected = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
    &signature,
    answerRejection,
  )
  if let Option<Shared<Rejection>>.Some {value} = move rejected {
    return Result.failResult<bool, Shared<Rejection>>(move value)
  }
  if Type.hasOpenParameters(&applied.contract) || Type.hasOpenParameters(&applied.provider) {
    let couldMatch = run openOperatorCouldMatch(&signature, operands, &head)
    return Result.succeed<bool, Shared<Rejection>>(couldMatch)
  }
  if !run matchesOperatorOperands(&mut resolver.*, &signature, operation, operands) {
    return Result.succeed<bool, Shared<Rejection>>(false)
  }
  if !valueOnly {
    return Result.failResult<bool, Shared<Rejection>>(
      run reject(&resolver.*, siteModule, RejectionCode.Unsupported, siteSpan),
    )
  }
  run addOperatorCandidate(
    &mut suppliers.*,
    &mut choice.*,
    &applied.contract,
    &applied.provider,
    moduleOrdinal,
    operationOrdinal,
  )
  return Result.succeed<bool, Shared<Rejection>>(false)
}

// The implementation heads that one operand owner declares for the operation are candidates.
// Returns whether any generic head might match.
effect fn gatherOwnerHeads(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  suppliers: &mut Vector<OperatorCandidate>,
  choice: &mut CallSelection,
  operands: &[Shared<Type>],
  contractIdentity: &DeclarationId,
  moduleOrdinal: usize,
  operationOrdinal: usize,
  operation: &Shared<DeclarationId>,
  valueOnly: bool,
  ownerModule: usize,
  siteModule: &ModuleId,
  siteSpan: Span,
) -> Result<bool, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let heads = run demandChild(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies.*,
    Key {
      family: Family.Implementations,
      module: ownerModule,
      name: usize.ZERO,
      declaration: usize.ZERO,
      member: usize.ZERO,
      external: false,
    },
    siteSpan,
  )
  let failed = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
    &heads,
    answerRejection,
  )
  if let Option<Shared<Rejection>>.Some {value} = move failed {
    return Result.failResult<bool, Shared<Rejection>>(move value)
  }
  let headCount = Shared.with<Result<Answer, NoRejection>, usize>(&heads, implementationCount)
  let mut openHead = false
  let mut headAt = usize.ZERO
  while headAt < headCount {
    let gathered = run gatherConcreteHead(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies.*,
      &mut suppliers.*,
      &mut choice.*,
      operands,
      contractIdentity,
      moduleOrdinal,
      operationOrdinal,
      operation,
      valueOnly,
      &heads,
      headAt,
      siteModule,
      siteSpan,
    )
    let open = match move gathered {
      Result<bool, Shared<Rejection>>.Success {value} => value
      Result<bool, Shared<Rejection>>.Failure {error} => {
        return Result.failResult<bool, Shared<Rejection>>(move error)
      }
    }
    if open {
      openHead = true
    }
    headAt = headAt + usize.ONE
  }
  return Result.succeed<bool, Shared<Rejection>>(openHead)
}

// One marked operation of the operator interface is gathered through every operand owner.
// Returns whether any generic head might match.
effect fn gatherConcreteOperation(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  suppliers: &mut Vector<OperatorCandidate>,
  choice: &mut CallSelection,
  requested: &Operator.Spelling,
  operands: &[Shared<Type>],
  contractIdentity: &DeclarationId,
  sharedIdentity: &Shared<DeclarationId>,
  contractModule: &ModuleId,
  moduleOrdinal: usize,
  selfOrdinal: usize,
  modules: &[usize],
  listed: &Shared<Result<Answer, NoRejection>>,
  listedAt: usize,
  siteModule: &ModuleId,
  siteSpan: Span,
) -> Result<bool, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let found = Shared.with<Result<Answer, NoRejection>, Option<Shared<DeclarationId>>>(
    listed,
    fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<DeclarationId>> {
      return listedOperation(answer, listedAt)
    },
  )
  let operation = match move found {
    Option<Shared<DeclarationId>>.Some {value} => value
    Option<Shared<DeclarationId>>.None => {
      return Result.succeed<bool, Shared<Rejection>>(false)
    }
  }
  let marker = run operationMarks(&mut resolver.*, contractModule, &operation, requested)
  let valueOnly = match move marker {
    Option<bool>.Some {value} => value
    Option<bool>.None => {
      return Result.succeed<bool, Shared<Rejection>>(false)
    }
  }
  let operationPosition = run ordinalOfIdentity(&mut resolver.*, contractModule, &operation)
  let operationOrdinal = match move operationPosition {
    Option<usize>.Some {value} => value
    Option<usize>.None => {
      return Result.succeed<bool, Shared<Rejection>>(false)
    }
  }
  if selfOrdinal != usize.MAX {
    let rawSignature = run demandChild(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies.*,
      Key {
        family: Family.Signature,
        module: moduleOrdinal,
        name: usize.ZERO,
        declaration: operationOrdinal,
        member: usize.ZERO,
        external: false,
      },
      siteSpan,
    )
    let rawFailure = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
      &rawSignature,
      answerRejection,
    )
    if let Option<Shared<Rejection>>.Some {value} = move rawFailure {
      return Result.failResult<bool, Shared<Rejection>>(move value)
    }
    if run unanchoredOperatorCouldMatch(
      &rawSignature,
      operands,
      sharedIdentity,
      &operation,
      selfOrdinal,
    ) {
      return Result.failResult<bool, Shared<Rejection>>(
        run reject(&resolver.*, siteModule, RejectionCode.Unsupported, siteSpan),
      )
    }
  }
  let mut openOperation = false
  let mut ownerAt = usize.ZERO
  while ownerAt < modules.length {
    let gathered = run gatherOwnerHeads(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies.*,
      &mut suppliers.*,
      &mut choice.*,
      operands,
      contractIdentity,
      moduleOrdinal,
      operationOrdinal,
      &operation,
      valueOnly,
      modules[ownerAt],
      siteModule,
      siteSpan,
    )
    let open = match move gathered {
      Result<bool, Shared<Rejection>>.Success {value} => value
      Result<bool, Shared<Rejection>>.Failure {error} => {
        return Result.failResult<bool, Shared<Rejection>>(move error)
      }
    }
    if open {
      openOperation = true
    }
    ownerAt = ownerAt + usize.ONE
  }
  return Result.succeed<bool, Shared<Rejection>>(openOperation)
}

// Gathers every marked operation of one visible operator interface. Returns whether any generic
// head might match.
effect fn gatherInterfaceOperators(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  suppliers: &mut Vector<OperatorCandidate>,
  choice: &mut CallSelection,
  requested: &Operator.Spelling,
  operands: &[Shared<Type>],
  sharedIdentity: &Shared<DeclarationId>,
  siteModule: &ModuleId,
  siteSpan: Span,
) -> Result<bool, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let contractIdentity = run DeclarationId.copyShared(sharedIdentity)
  let moduleOrdinal = knownModuleOrdinal(&resolver.*, DeclarationId.moduleId(&contractIdentity))
  if moduleOrdinal == usize.MAX {
    fail InvalidModulePath {}
  }
  let contractModule = run resolvedModule(&resolver.*, moduleOrdinal)
  let position = run ordinalOfIdentity(&mut resolver.*, &contractModule, sharedIdentity)
  let interfaceOrdinal = match move position {
    Option<usize>.Some {value} => value
    Option<usize>.None => {
      fail InvalidModulePath {}
    }
  }
  let contractAnswer = run demandChild(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies.*,
    Key {
      family: Family.Contract,
      module: moduleOrdinal,
      name: usize.ZERO,
      declaration: interfaceOrdinal,
      member: usize.ZERO,
      external: false,
    },
    siteSpan,
  )
  let contractFailure = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
    &contractAnswer,
    answerRejection,
  )
  if let Option<Shared<Rejection>>.Some {value} = move contractFailure {
    return Result.failResult<bool, Shared<Rejection>>(move value)
  }
  let providerParameter = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
    &contractAnswer,
    contractProvider,
  )
  let selfOrdinal = match move providerParameter {
    Option<Shared<Type>>.Some {value} => Shared.with<Type, usize>(
      &value,
      fn(ty: &Type) -> usize {
        return Type.parameterOrdinalOf(ty, &contractIdentity)
      },
    )
    Option<Shared<Type>>.None => usize.MAX
  }
  let listed = run demandChild(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies.*,
    Key {
      family: Family.Operations,
      module: moduleOrdinal,
      name: usize.ZERO,
      declaration: interfaceOrdinal,
      member: usize.ZERO,
      external: false,
    },
    siteSpan,
  )
  let invalid = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
    &listed,
    answerRejection,
  )
  if let Option<Shared<Rejection>>.Some {value} = move invalid {
    return Result.failResult<bool, Shared<Rejection>>(move value)
  }
  let mut modules = Vector.make<usize>()
  run appendOperatorModule(&mut modules, moduleOrdinal)
  let mut operandAt = usize.ZERO
  while operandAt < operands.length {
    run appendOperatorModule(
      &mut modules,
      declaringModuleOrdinal(&resolver.*, &operands[operandAt]),
    )
    operandAt = operandAt + usize.ONE
  }
  let count = Shared.with<Result<Answer, NoRejection>, usize>(&listed, listedOperationCount)
  let mut openInterface = false
  let mut listedAt = usize.ZERO
  while listedAt < count {
    let gathered = run gatherConcreteOperation(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies.*,
      &mut suppliers.*,
      &mut choice.*,
      requested,
      operands,
      &contractIdentity,
      sharedIdentity,
      &contractModule,
      moduleOrdinal,
      selfOrdinal,
      Vector.asSlice<usize>(&modules),
      &listed,
      listedAt,
      siteModule,
      siteSpan,
    )
    let open = match move gathered {
      Result<bool, Shared<Rejection>>.Success {value} => value
      Result<bool, Shared<Rejection>>.Failure {error} => {
        return Result.failResult<bool, Shared<Rejection>>(move error)
      }
    }
    if open {
      openInterface = true
    }
    listedAt = listedAt + usize.ONE
  }
  return Result.succeed<bool, Shared<Rejection>>(openInterface)
}

// Concrete candidates come only from the operator interface's own bucket and the operands'
// owner buckets. Their complete conformance proof still runs after one supplier is selected.
effect fn gatherConcreteOperator(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  suppliers: &mut Vector<OperatorCandidate>,
  choice: &mut CallSelection,
  requested: &Operator.Spelling,
  operands: &[Shared<Type>],
  siteModule: &ModuleId,
  siteSpan: Span,
) -> Result<(), Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let moduleOrdinal = run internModule(&mut resolver.*, siteModule)
  let visible = run demandChild(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies.*,
    Key {family: Family.OperatorInterfaces, module: moduleOrdinal, name: usize.ZERO,
      declaration: usize.ZERO, member: usize.ZERO, external: false},
    siteSpan,
  )
  let rejected = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(&visible, answerRejection)
  if let Option<Shared<Rejection>>.Some {value} = move rejected {
    let siteCode = Shared.with<Rejection, Option<RejectionCode>>(&value, operatorDiscoverySiteCode)
    if let Option<RejectionCode>.Some {value: code} = move siteCode {
      return Result.failResult<(), Shared<Rejection>>(run reject(&resolver.*, siteModule, code, siteSpan))
    }
    return Result.failResult<(), Shared<Rejection>>(move value)
  }
  let mut openCandidate = false
  let count = Shared.with<Result<Answer, NoRejection>, usize>(&visible, operatorInterfaceCount)
  let mut interfaceAt = usize.ZERO
  while interfaceAt < count {
    let found = Shared.with<Result<Answer, NoRejection>, Option<Shared<DeclarationId>>>(&visible,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<DeclarationId>> {
        return operatorInterfaceAt(answer, interfaceAt)
      })
    let shared = match move found {
      Option<Shared<DeclarationId>>.Some {value} => value
      Option<Shared<DeclarationId>>.None => { fail InvalidModulePath {} }
    }
    let gathered = run gatherInterfaceOperators(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies.*,
      &mut suppliers.*,
      &mut choice.*,
      requested,
      operands,
      &shared,
      siteModule,
      siteSpan,
    )
    let open = match move gathered {
      Result<bool, Shared<Rejection>>.Success {value} => value
      Result<bool, Shared<Rejection>>.Failure {error} => {
        return Result.failResult<(), Shared<Rejection>>(move error)
      }
    }
    if open {
      openCandidate = true
    }
    interfaceAt = interfaceAt + usize.ONE
  }
  if openCandidate {
    // Generic heads need operand-derived application before candidate comparison (unit 5).
    return Result.failResult<(), Shared<Rejection>>(
      run reject(&resolver.*, siteModule, RejectionCode.Unsupported, siteSpan),
    )
  }
  return Result.succeed<(), Shared<Rejection>>(())
}

// All interface suppliers are collected before proof. The closed scalar table is another
// supplier, so an identical marked operation is ambiguous rather than silently shadowed.
effect fn selectOperator(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut Vector<Dependency>,
  requested: &Operator.Spelling,
  operands: &[Shared<Type>],
  declared: &[Constraint],
  closed: bool,
  siteModule: &ModuleId,
  siteSpan: Span,
) -> Result<Option<SelectedOperator>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let mut suppliers = Vector.make<OperatorCandidate>()
  let mut choice = CallSelection.make()
  let bound = run gatherBoundOperator(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies.*,
    &mut suppliers,
    &mut choice,
    requested,
    operands,
    declared,
    siteModule,
    siteSpan,
  )
  if let Result<(), Shared<Rejection>>.Failure {error} = move bound {
    return Result.failResult<Option<SelectedOperator>, Shared<Rejection>>(move error)
  }
  let mut concreteOperands = true
  let mut operandAt = usize.ZERO
  while operandAt < operands.length {
    // Caller validity regions do not make a concrete provider generic. Preserve those regions
    // in operand matching; only unresolved runtime type/row shape blocks concrete discovery.
    if Type.hasOpenRuntimeParameters(&operands[operandAt]) {
      concreteOperands = false
      break
    }
    operandAt = operandAt + usize.ONE
  }
  if concreteOperands {
    let concrete = run gatherConcreteOperator(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies.*,
      &mut suppliers,
      &mut choice,
      requested,
      operands,
      siteModule,
      siteSpan,
    )
    if let Result<(), Shared<Rejection>>.Failure {error} = move concrete {
      return Result.failResult<Option<SelectedOperator>, Shared<Rejection>>(move error)
    }
  }
  if closed && Vector.length<OperatorCandidate>(&suppliers) > usize.ZERO {
    return Result.failResult<Option<SelectedOperator>, Shared<Rejection>>(
      run reject(&resolver.*, siteModule, RejectionCode.AmbiguousOperator, siteSpan),
    )
  }
  if CallSelection.ambiguous(&choice) {
    return Result.failResult<Option<SelectedOperator>, Shared<Rejection>>(
      run reject(&resolver.*, siteModule, RejectionCode.AmbiguousOperator, siteSpan),
    )
  }
  let selected = match move CallSelection.unique(&choice) {
    Option<usize>.Some {value} => value
    Option<usize>.None => {
      return Result.succeed<Option<SelectedOperator>, Shared<Rejection>>(
        Option.none<SelectedOperator>(),
      )
    }
  }
  let candidate = Vector.remove<OperatorCandidate>(&mut suppliers, selected)
  let module = run resolvedModule(&resolver.*, candidate.operationModule)
  let operation = run declarationAt(&mut resolver.*, &module, candidate.operationOrdinal)
  let identity = match move operation {
    Option<DeclarationId>.Some {value} => value
    Option<DeclarationId>.None => {
      return Result.failResult<Option<SelectedOperator>, Shared<Rejection>>(
        run reject(&resolver.*, siteModule, RejectionCode.MissingOperator, siteSpan),
      )
    }
  }
  let chosen = run selectOperationCall(
    &mut resolver.*,
    &mut owner.*,
    &mut request.*,
    &mut dependencies.*,
    true,
    &candidate.contract,
    &candidate.provider,
    &identity,
    declared,
    siteModule,
    siteSpan,
  )
  match move chosen {
    Result<OperationCall, Shared<Rejection>>.Success {value} => {
      return Result.succeed<Option<SelectedOperator>, Shared<Rejection>>(
        Option.some<SelectedOperator>(
          SelectedOperator {
            contract: move candidate.contract,
            provider: move candidate.provider,
            call: move value,
          },
        ),
      )
    }
    Result<OperationCall, Shared<Rejection>>.Failure {error} => {
      return Result.failResult<Option<SelectedOperator>, Shared<Rejection>>(move error)
    }
  }
}

// A type application or checked call is already inside a semantic query. Proof facts must be
// children of that query so an edited conformance invalidates the completed application.
// A borrow region, or an instance's caller region that numbers one; neither outlives `'static`.
fn localLifetime(value: &Lifetime) -> bool { return match &value.* { Lifetime.Local {..} => true Lifetime.Supplied {..} => true _ => false } }
fn staticLifetime(value: &Lifetime) -> bool { return match &value.* { Lifetime.Static => true _ => false } }
fn namedLifetime(value: &Lifetime) -> bool {
  return match &value.* { Lifetime.Local {..} => true Lifetime.Supplied {..} => true Lifetime.Parameter {..} => true _ => false }
}

// Only a written premise lets a borrow region or a declared binder outlive `'static`. Once the
// caller's premises fail to prove it, the bound is unsatisfied (bootstrap SEM0212). Any other
// unproved relation stays outside the native proof.
fn unprovedOutlivesCode(longer: &Shared<Lifetime>, shorter: &Shared<Lifetime>) -> RejectionCode {
  if Shared.with<Lifetime, bool>(shorter, staticLifetime)
    && (Lifetime.anyAtom(longer, localLifetime) || Lifetime.allAtoms(longer, namedLifetime)) {
    return RejectionCode.UnsatisfiedLifetimeBound
  }
  return RejectionCode.Unsupported
}

// The type a provision's provider must make conform to the selected service: the referent of a
// borrowed provider, otherwise the owned provider itself.
fn providerTarget(provider: &Type) -> Option<Shared<Type>> {
  if let Type.Reference {referent, ..} = &provider.* {
    return Option.some<Shared<Type>>(Shared.clone<Type>(&referent))
  }
  return Option.none<Shared<Type>>()
}

// Whether a provider capture can expose exclusive access: an exclusive borrow or an owned value.
fn providerExclusive(provider: &Type) -> bool {
  return match & provider.* {
    Type.Reference {access, ..} => access == Access.Mutable
    _ => true
  }
}

// Whether `target` supplies `capability`, by identity or by one coherent conformance. A missing
// conformance is `false`; any other proof failure, such as ambiguous witnesses, is a rejection.
effect fn providerConforms(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  target: &Shared<Type>,
  capability: &Shared<Type>,
  declared: &[Constraint],
  module: &ModuleId,
  span: Span,
) -> Result<bool, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  if run Type.equalsShared(target, capability) {
    return Result.succeed<bool, Shared<Rejection>>(true)
  }
  let goal = ConformanceGoal {contract: Shared.clone<Type>(capability), provider: Shared.clone<Type>(target)}
  let mut request = Request.make()
  let mut chain = Vector.make<ConformanceGoal>()
  let mut steps = Vector.make<ConformanceStep>()
  let avoid = Option.none<Shared<DeclarationId>>()
  let failure = run proveGoal(&mut resolver.*, &mut owner.*, &mut request, &mut dependencies.*, true, &avoid,
    &goal, declared, module, span, &mut chain, &mut steps)
  if let Option<Shared<Rejection>>.Some {value} = move failure {
    let missing = Shared.with<Rejection, bool>(&value, fn(problem: &Rejection) -> bool {
      return problem.code == RejectionCode.MissingConformance
    })
    if missing {
      return Result.succeed<bool, Shared<Rejection>>(false)
    }
    return Result.failResult<bool, Shared<Rejection>>(move value)
  }
  return Result.succeed<bool, Shared<Rejection>>(true)
}

// Selects the one source-row entry a provision satisfies (SERV-007). An explicit `selector` names
// its key; otherwise every entry whose service the provider conforms to is a candidate, whatever
// its access. A shared borrow satisfies only a shared entry; any candidate it cannot satisfy is
// reported before ambiguity. The complete candidate set decides, so row order never chooses.
effect fn selectProvided(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  provider: &Shared<Type>,
  selector: &Option<Requirement>,
  source: &Shared<Row>,
  declared: &[Constraint],
  module: &ModuleId,
  span: Span,
) -> Result<Requirement, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let mut target = Shared.clone<Type>(provider)
  let borrowed = Shared.with<Type, Option<Shared<Type>>>(provider, providerTarget)
  if let Option<Shared<Type>>.Some {value: referent} = move borrowed {
    target = move referent
  }
  let exclusive = Shared.with<Type, bool>(provider, providerExclusive)
  let entries = run Row.entryList(source)
  let listed = Vector.asSlice<Requirement>(&entries)
  let mut conforming = usize.ZERO
  let mut weak = false
  let mut chosen = Option.none<Requirement>()
  let mut at = usize.ZERO
  while at < listed.length {
    let mut named = true
    if let Option<Requirement>.Some {value: key} = &selector.* {
      named = run Requirement.keyEquals(&listed[at], &key)
    }
    if named {
      let conformed = run providerConforms(&mut resolver.*, &mut owner.*, &mut dependencies.*, &target,
        &listed[at].capability, declared, module, span)
      let conforms = match move conformed {
        Result<bool, Shared<Rejection>>.Success {value} => value
        Result<bool, Shared<Rejection>>.Failure {error} => {
          return Result.failResult<Requirement, Shared<Rejection>>(move error)
        }
      }
      if conforms {
        conforming = conforming + usize.ONE
        if !exclusive && listed[at].access != Access.Shared {
          weak = true
        }
        chosen = Option.some<Requirement>(Requirement.copy(&listed[at]))
      }
    }
    at = at + usize.ONE
  }
  // Like the bootstrap solver, a surviving candidate's access mismatch is reported before ambiguity.
  let mut code = RejectionCode.MissingProvidedKey
  if conforming > usize.ZERO && weak {
    code = RejectionCode.InsufficientProviderAccess
  } else if conforming > usize.ONE {
    code = RejectionCode.AmbiguousProvidedKey
  } else if conforming == usize.ONE {
    if let Option<Requirement>.Some {value} = move chosen {
      return Result.succeed<Requirement, Shared<Rejection>>(move value)
    }
  }
  return Result.failResult<Requirement, Shared<Rejection>>(run reject(&resolver.*, module, code, span))
}

// The one service-role key a closed selector row names, or `None` for any other cardinality.
effect fn selectorKey(selector: &Shared<Row>) -> Option<Requirement> ! OutOfMemoryError ? &mut Allocator {
  let mut entries = run Row.entryList(selector)
  if Vector.length<Requirement>(&entries) != usize.ONE {
    return Option.none<Requirement>()
  }
  return Option.some<Requirement>(Vector.remove<Requirement>(&mut entries, usize.ZERO))
}

// Proves one applied `provides` bound. A bound still mentioning caller parameters must be one of
// the caller's own declared bounds, which `proveAppliedBounds` accepts before reaching this.
effect fn proveProvides(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  provider: &Shared<Type>,
  selector: &Shared<Row>,
  source: &Shared<Row>,
  declared: &[Constraint],
  module: &ModuleId,
  span: Span,
) -> Option<Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  // An open source row, provider or selector needs the caller's own matching bound; a generic
  // forwarding call with an explicit selector over an open row stays Unsupported here.
  if Row.hasOpenRuntimeParameters(source) || Type.hasOpenRuntimeParameters(provider) || Row.hasOpenRuntimeParameters(selector) {
    return Option.some<Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.Unsupported, span))
  }
  // A selector names exactly one service-role key (SERV-007).
  let key = run selectorKey(selector)
  if let Option<Requirement>.None = &key {
    return Option.some<Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.ProviderSelectorCardinality, span))
  }
  let selected = run selectProvided(&mut resolver.*, &mut owner.*, &mut dependencies.*, provider, &key, source,
    declared, module, span)
  if let Result<Requirement, Shared<Rejection>>.Failure {error} = move selected {
    return Option.some<Shared<Rejection>>(move error)
  }
  return Option.none<Shared<Rejection>>()
}

fn selectorOrdinalIn(row: &Row, fresh: &Shared<DeclarationId>) -> usize {
  return Shared.with<DeclarationId, usize>(
    fresh,
    fn(declaration: &DeclarationId) -> usize {
      return rowParameterOrdinal(row, declaration)
    },
  )
}

// Infers each omitted `provides` selector `?S` of a call (SERV-007): once the provider and source
// row are solved and concrete, `S` binds to the one compatible stored entry, access included.
// A partial source row is never selection evidence; its selector stays uninferred.
effect fn inferProvidedSelectors(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  module: &ModuleId,
  signature: &Shared<Result<Answer, NoRejection>>,
  callOwner: &Shared<DeclarationId>,
  fresh: &DeclarationId,
  declared: &[Constraint],
  inferred: &mut Vector<Binding>,
  span: Span,
) -> Option<Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let count = Shared.with<Result<Answer, NoRejection>, usize>(signature, signatureConstraintCount)
  let mut boundAt = usize.ZERO
  while boundAt < count {
    let bound = Shared.with<Result<Answer, NoRejection>, Option<Constraint>>(
      signature,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Constraint> {
        return signatureConstraint(answer, boundAt)
      },
    )
    boundAt = boundAt + usize.ONE
    if let Option<Constraint>.Some {value: Constraint.Provides {provider, selector, source}} = move bound {
      let ordinal = Shared.with<Row, usize>(
        &selector,
        fn(row: &Row) -> usize {
          return selectorOrdinalIn(row, callOwner)
        },
      )
      if ordinal == usize.MAX {
        continue
      }
      let supplied = bindingArgumentAt(Vector.asSlice<Binding>(&inferred.*), ordinal)
      if let Option<Argument>.Some {..} = move supplied {
        continue
      }
      let appliedProvider = run Type.applyBindings(&provider, Vector.asSlice<Binding>(&inferred.*), true)
      let appliedSource = run Row.applyBindings(&source, Vector.asSlice<Binding>(&inferred.*), true)
      if run typeMentionsOwner(&appliedProvider, fresh) {
        continue
      }
      if run argumentMentionsOwner(&Argument.Row {value: Shared.clone<Row>(&appliedSource)}, fresh) {
        continue
      }
      if Row.hasOpenRuntimeParameters(&appliedSource) || Type.hasOpenRuntimeParameters(&appliedProvider) {
        continue
      }
      let selected = run selectProvided(&mut resolver.*, &mut owner.*, &mut dependencies.*, &appliedProvider,
        &Option.none<Requirement>(), &appliedSource, declared, module, span)
      let entry = match move selected {
        Result<Requirement, Shared<Rejection>>.Success {value} => value
        Result<Requirement, Shared<Rejection>>.Failure {error} => {
          return Option.some<Shared<Rejection>>(move error)
        }
      }
      let mut row = Row.empty()
      run Row.require(&mut row, move entry)
      run Vector.append<Binding>(
        &mut inferred.*,
        Binding {
          declaration: Shared.clone<DeclarationId>(callOwner),
          ordinal: ordinal,
          value: Argument.Row {value: run Shared.make<Row>(move row)},
        },
      )
    }
  }
  return Option.none<Shared<Rejection>>()
}

// A caller's complete contents premise may cover a shorter use region. Only declared caller
// facts enter this proof: the selected operation's applied obligations cannot justify themselves.
effect fn callerContentsCover(declared: &[Constraint], subject: &Shared<Type>, region: &Shared<Lifetime>) -> bool
! OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < declared.length {
    if let Constraint.Contents {subject: premiseSubject, region: premiseRegion} = &declared[at] {
      let sameSubject = run Type.equalsShared(subject, &premiseSubject)
      if sameSubject {
        if run knownOutlives(declared, &premiseRegion, region) { return true }
      }
    }
    at = at + usize.ONE
  }
  return false
}

// Whether an applied type is `Intrinsic.Detached`: it retains no caller lexical or provider loan
// (EXEC-004). A borrow, a borrowed capture and a provided requirement each surface as a region the
// type retains, including through an Effect or callable environment, so every retained region must
// be `'static`. A type parameter stored inside it is detached only through its own declared premise.
effect fn provesDetached(assumptions: &[Constraint], subject: &Shared<Type>, module: &ModuleId) -> bool
! OutOfMemoryError ? &mut Allocator {
  let anchor = run DeclarationId.fromParts(run ModuleId.copy(module), Vector.make<OwnerStep>())
  let mut retained = Vector.make<Shared<Lifetime>>()
  let mut unresolved = Vector.make<Shared<Type>>()
  if !run captureContents(subject, &anchor, assumptions, &mut retained, &mut unresolved) {
    let mut alone = Vector.make<Shared<Type>>()
    run Vector.append<Shared<Type>>(&mut alone, Shared.clone<Type>(subject))
    return run detachedParameters(assumptions, Vector.asSlice<Shared<Type>>(&alone))
  }
  let regions = Vector.asSlice<Shared<Lifetime>>(&retained)
  let mut at = usize.ZERO
  while at < regions.length {
    if !Shared.with<Lifetime, bool>(&regions[at], staticLifetime) { return false }
    at = at + usize.ONE
  }
  return run detachedParameters(assumptions, Vector.asSlice<Shared<Type>>(&unresolved))
}

// Whether each stored type parameter carries a declared Detached or `'static` contents premise.
effect fn detachedParameters(assumptions: &[Constraint], parameters: &[Shared<Type>]) -> bool
! OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < parameters.length {
    let mut premised = false
    let mut premise = usize.ZERO
    while premise < assumptions.length && !premised {
      if let Constraint.Property {subject, property} = &assumptions[premise] {
        premised = property == IntrinsicProperty.Detached && run Type.equalsShared(&subject, &parameters[at])
      }
      if let Constraint.Contents {subject, region} = &assumptions[premise] {
        premised = Shared.with<Lifetime, bool>(&region, staticLifetime) && run Type.equalsShared(&subject, &parameters[at])
      }
      premise = premise + usize.ONE
    }
    if !premised { return false }
    at = at + usize.ONE
  }
  return true
}

effect fn proveAppliedBounds(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  declared: &Vector<Constraint>,
  bounds: &[Constraint],
  module: &ModuleId,
  span: Span,
) -> Option<Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let mut request = Request.make()
  let mut chain = Vector.make<ConformanceGoal>()
  let mut steps = Vector.make<ConformanceStep>()
  let avoid = Option.none<Shared<DeclarationId>>()
  let mut at = usize.ZERO
  while at < bounds.length {
    let assumptions = Vector.asSlice<Constraint>(declared)
    let mut premise = usize.ZERO
    let mut assumed = false
    while premise < assumptions.length && !assumed {
      assumed = run sameConstraint(&bounds[at], &assumptions[premise])
      premise = premise + usize.ONE
    }
    if assumed { at = at + usize.ONE continue }
    // NonParking is a transitive suspension summary. Before the suspension stage, reaching parking
    // is itself the `suspension` gap at that site, so every caller already fails through it (D6).
    if let Constraint.Property {subject, property} = &bounds[at] {
      if property == IntrinsicProperty.NonParking { at = at + usize.ONE continue }
      if !run provesDetached(assumptions, &subject, module) {
        return Option.some<Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.UnsatisfiedExecutableProperty, span))
      }
      at = at + usize.ONE
      continue
    }
    if let Constraint.Copyable {subject} = &bounds[at] {
      let copied = run copyType(&mut resolver.*, &mut owner.*, &mut dependencies.*, &subject, assumptions, span)
      match move copied {
        Result<bool, Shared<Rejection>>.Success {value} => {
          if !value {
            return Option.some<Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.Unsupported, span))
          }
        }
        Result<bool, Shared<Rejection>>.Failure {error} => { return Option.some<Shared<Rejection>>(move error) }
      }
      at = at + usize.ONE
      continue
    }
    if let Constraint.Outlives {longer, shorter} = &bounds[at] {
      if !run knownOutlives(Vector.asSlice<Constraint>(declared), &longer, &shorter) {
        return Option.some<Shared<Rejection>>(run reject(&resolver.*, module, unprovedOutlivesCode(&longer, &shorter), span))
      }
      at = at + usize.ONE
      continue
    }
    if let Constraint.Contents {subject, region} = &bounds[at] {
      if run callerContentsCover(assumptions, &subject, &region) {
        at = at + usize.ONE
        continue
      }
      // A bare type parameter's contents are known only through a declared premise, which
      // `callerContentsCover` already consulted. Without one, only a region local to the checked
      // body is proved: every type its declaration names outlives that body's loans.
      if Shared.with<Type, bool>(&subject, isTypeParameter) {
        if !Lifetime.allAtoms(&region, localLifetime) {
          return Option.some<Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.Unsupported, span))
        }
        at = at + usize.ONE
        continue
      }
      // Every named region the subject retains must cover the bound's region. As in the
      // bootstrap's type-outlives proof, a type parameter stored inside the subject with no
      // declared contents premise names no region here: its generic storage stays a body
      // obligation for the borrow checker.
      let anchor = run DeclarationId.fromParts(run ModuleId.copy(module), Vector.make<OwnerStep>())
      let mut retained = Vector.make<Shared<Lifetime>>()
      let mut unresolved = Vector.make<Shared<Type>>()
      if !run captureContents(&subject, &anchor, assumptions, &mut retained, &mut unresolved) {
        return Option.some<Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.Unsupported, span))
      }
      let regions = Vector.asSlice<Shared<Lifetime>>(&retained)
      let mut regionAt = usize.ZERO
      while regionAt < regions.length {
        if !run knownOutlives(Vector.asSlice<Constraint>(declared), &regions[regionAt], &region) {
          return Option.some<Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.UnsatisfiedLifetimeBound, span))
        }
        regionAt = regionAt + usize.ONE
      }
      at = at + usize.ONE
      continue
    }
    if let Constraint.Represents {parameter, contract} = &bounds[at] {
      let failed = run proveCallableBound(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, Vector.asSlice<Constraint>(declared),
        &parameter, &contract, span)
      if let Option<Shared<Rejection>>.Some {value} = move failed { return Option.some<Shared<Rejection>>(move value) }
      at = at + usize.ONE
      continue
    }
    if let Constraint.Provides {provider, selector, source} = &bounds[at] {
      let failed = run proveProvides(&mut resolver.*, &mut owner.*, &mut dependencies.*, &provider, &selector, &source,
        Vector.asSlice<Constraint>(declared), module, span)
      if let Option<Shared<Rejection>>.Some {value} = move failed { return Option.some<Shared<Rejection>>(move value) }
      at = at + usize.ONE
      continue
    }
    if let Constraint.Conforms {provider, contract} = &bounds[at] {
      let goal = ConformanceGoal {
        contract: Shared.clone<Type>(&contract),
        provider: Shared.clone<Type>(&provider),
      }
      // As in inference, regions alone leave a goal provable from implementation heads.
      if Type.hasOpenRuntimeParameters(&provider) || Type.hasOpenRuntimeParameters(&contract) {
        let assumed = run declaredGoal(Vector.asSlice<Constraint>(declared), &goal)
        if let Option<Constraint>.None = move assumed {
          return Option.some<Shared<Rejection>>(
            run reject(&resolver.*, module, RejectionCode.Unsupported, span),
          )
        }
      }
      let failure = run proveGoal(
        &mut resolver.*,
        &mut owner.*,
        &mut request,
        &mut dependencies.*,
        true,
        &avoid,
        &goal,
        Vector.asSlice<Constraint>(declared),
        module,
        span,
        &mut chain,
        &mut steps,
      )
      if let Option<Shared<Rejection>>.Some {value} = move failure {
        return Option.some<Shared<Rejection>>(move value)
      }
    } else {
      return Option.some<Shared<Rejection>>(
        run reject(&resolver.*, module, RejectionCode.Unsupported, span),
      )
    }
    at = at + usize.ONE
  }
  return Option.none<Shared<Rejection>>()
}

/// Constructs a short loan from an active semantic provider's split state.
fn inFlightStaticPort<'source>(
  resolver: &'source mut Resolver,
  query: &'source mut Query<Word, Answer, NoRejection>,
  dependencies: &'source mut Vector<Dependency>,
) -> StaticPort<'source> {
  return StaticPort {resolver: move resolver, query: move query, dependencies: move dependencies}
}

impl<'source> StaticPort<'source> {
  /// Borrows one exact parsed source from this query port.
  pub fn sourceAtCursor(self: &Self, cursor: &AuthoredCursor) -> Option<&IndexedSource> {
    return SourceIndex.sourceAtCursor(&self.resolver.source, cursor)
  }
  /// Checks that a checked body observed the exact source addressed by this authenticated cursor.
  pub fn matchesObservationAtCursor(self: &Self, cursor: &AuthoredCursor, observed: &Observation) -> bool {
    let indexed = SourceIndex.sourceAtCursor(&self.resolver.source, cursor)
    if let Option<&IndexedSource>.Some {value} = move indexed {
      return Observation.equals(IndexedSource.sourceObservation(value), observed)
    }
    return false
  }
  /// Borrows authored HIR from one authenticated source for the duration of this port loan.
  pub fn authoredAtCursor(self: &Self, cursor: &AuthoredCursor) -> Option<&Module> {
    let indexed = SourceIndex.sourceAtCursor(&self.resolver.source, cursor)
    if let Option<&IndexedSource>.Some {value} = move indexed {
      return Option.some<&Module>(IndexedSource.authored(value))
    }
    return Option.none<&Module>()
  }
  /// The target of the held semantic revision.
  pub fn target(self: &Self) -> MachineTarget {
    return self.resolver.target
  }
  /// The explicit frozen build profile, absent while its defaults are being resolved.
  pub fn profile<'a>(self: &'a Self) -> Option<&'a FinalProfile> {
    return selectedProfile(&self.resolver.*)
  }
  /// Records the active profile input as a logical dependency of the reached static query.
  pub effect fn demandProfile(self: &mut Self, module: &ModuleId, span: Span) -> ()
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator {
    let moduleOrdinal = run internModule(&mut self.resolver.*, module)
    let observed = run demandChild(
      &mut self.resolver.*, &mut self.query.*, &mut self.dependencies.*,
      Key {
        family: Family.ProfileInput, module: moduleOrdinal, name: usize.ZERO,
        declaration: usize.ZERO, member: usize.ZERO, external: false,
      },
      span,
    )
    drop observed
    return ()
  }
  /// Demands one exact authored source on the port's held revision.
  pub effect fn authoredCursor(self: &mut Self, module: &ModuleId) -> Option<AuthoredCursor>
  ! Cycle | OutOfMemoryError
  ? &mut Allocator {
    let answer = run source(&mut self.resolver.*, module)
    return run SourceIndex.authoredCursor(&mut self.resolver.*.source, &answer, module)
  }
  /// Copies a source call's checked identity and arguments without resolving its spelling again.
  pub effect fn copyDirectCall(self: &mut Self, body: &Shared<TypedBody>, syntax: HirId) -> Option<StaticCall>
  ! Cycle | InvalidModulePath | OutOfMemoryError ? &mut Allocator {
    let selected = Shared.with<TypedBody, Option<Shared<Application>>>(body, fn(checked: &TypedBody) -> Option<Shared<Application>> {
      let nodes = TypedBody.nodeSlice(checked)
      let mut at = usize.ZERO
      while at < nodes.length {
        if nodes[at].origin.syntax.index == syntax.index {
          if let BodyNodeKind.Expression {form: BodyExpression.DirectCall {application, ..}, ..} = &nodes[at].kind {
            return Option.some<Shared<Application>>(Shared.clone<Application>(&application))
          }
        }
        at = at + usize.ONE
      }
      return Option.none<Shared<Application>>()
    })
    if let Option<Shared<Application>>.Some {value} = move selected {
      return Option.some<StaticCall>(StaticCall {application: run Application.copyShared(&value)})
    }
    return Option.none<StaticCall>()
  }

  /// Demands the exact reached body through the active query and records its dependency edge.
  pub effect fn demandBody(self: &mut Self, declaration: &DeclarationId, span: Span) -> Option<
    Shared<Result<Answer, NoRejection>>,
  > ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
    let module = DeclarationId.moduleId(declaration)
    let identity = run Shared.make<DeclarationId>(run DeclarationId.copy(declaration))
    let selected = run ordinalOfIdentity(&mut self.resolver.*, module, &identity)
    if let Option<usize>.Some {value: ordinal} = move selected {
      let moduleOrdinal = run internModule(&mut self.resolver.*, module)
      let answer = run demandChild(
        &mut self.resolver.*,
        &mut self.query.*,
        &mut self.dependencies.*,
        Key {
          family: Family.Body,
          module: moduleOrdinal,
          name: usize.ZERO,
          declaration: ordinal,
          member: usize.ZERO,
          external: false,
        },
        span,
      )
      return Option.some<Shared<Result<Answer, NoRejection>>>(move answer)
    }
    return Option.none<Shared<Result<Answer, NoRejection>>>()
  }
  /// Demands the selected declaration's written signature in the active query.
  /// The answer retains any semantic rejection alongside canonical parameter types.
  pub effect fn demandSignature(self: &mut Self, declaration: &DeclarationId, span: Span) -> Option<Shared<Result<Answer, NoRejection>>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator {
    let module = DeclarationId.moduleId(declaration)
    let identity = run Shared.make<DeclarationId>(run DeclarationId.copy(declaration))
    let selected = run ordinalOfIdentity(&mut self.resolver.*, module, &identity)
    if let Option<usize>.Some {value: ordinal} = move selected {
      let moduleOrdinal = run internModule(&mut self.resolver.*, module)
      let answer = run demandChild(
        &mut self.resolver.*,
        &mut self.query.*,
        &mut self.dependencies.*,
        Key {
          family: Family.Signature,
          module: moduleOrdinal,
          name: usize.ZERO,
          declaration: ordinal,
          member: usize.ZERO,
          external: false,
        },
        span,
      )
      return Option.some<Shared<Result<Answer, NoRejection>>>(move answer)
    }
    return Option.none<Shared<Result<Answer, NoRejection>>>()
  }
  /// The module-level ordinal of one declaration in its own module, if it is still indexed.
  pub effect fn declarationOrdinal(self: &mut Self, declaration: &DeclarationId) -> Option<usize>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator {
    let identity = run Shared.make<DeclarationId>(run DeclarationId.copy(declaration))
    return run ordinalOfIdentity(&mut self.resolver.*, DeclarationId.moduleId(declaration), &identity)
  }
  /// MODULE-STATIC-002: whether one indexed declaration is present, demanding each enclosing
  /// module-level arm's condition as a dependency of the active query.
  pub effect fn declarationAvailable(self: &mut Self, module: &ModuleId, declaration: usize, span: Span) -> Result<bool, Shared<Rejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator {
    return run available(&mut self.resolver.*, &mut self.query.*, &mut self.dependencies.*, module, declaration, span)
  }
  /// Whether one reached call in a declaration's body names a static function, read from the
  /// callee's tracked header exactly as body routing reads it.
  pub effect fn callPhase(self: &mut Self, module: &ModuleId, declaration: usize, call: HirId) -> Result<CallPhase, Shared<Rejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator {
    return run writtenCallPhase(&mut self.resolver.*, &mut self.query.*, &mut self.dependencies.*, module, declaration, call)
  }
  /// Checks one reached static expression through the active query, preserving its source IDs.
  /// A mixed body's inactive static arms are never checked by this demand.
  pub effect fn demandCheckedRoot(
    self: &mut Self,
    module: &ModuleId,
    declaration: Option<usize>,
    root: HirId,
    expectation: StaticRootExpectation,
    binders: &[StaticRootBinder],
  ) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator {
    let answer = run checkedStaticRoot(
      &mut self.resolver.*,
      &mut self.query.*,
      &mut self.dependencies.*,
      module,
      move declaration,
      root,
      move expectation,
      binders,
    )
    return run Shared.make<Result<Answer, NoRejection>>(
      Result.succeed<Answer, NoRejection>(move answer),
    )
  }

  /// Selects an unqualified static demand root through the shared declaration query.
  pub effect fn resolveRootDeclaration(
    self: &mut Self,
    module: &ModuleId,
    name: &[u8],
    span: Span,
  ) -> Result<DeclarationId, Shared<Rejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator {
    let caller = run internModule(&mut self.resolver.*, module)
    let chosen = run selectDeclaration(
      &mut self.resolver.*,
      &mut self.query.*,
      &mut self.dependencies.*,
      caller,
      module,
      name,
      false,
      span,
      RejectionCode.NotCallable,
    )
    return match move chosen {
      Result<SelectedDeclaration, Shared<Rejection>>.Success {value} => {
        let selected = run resolvedModule(&self.resolver.*, value.module)
        let declaration = run declarationAt(&mut self.resolver.*, &selected, value.ordinal)
        return match move declaration {
          Option<DeclarationId>.Some {value: identity} => Result.succeed<
            DeclarationId,
            Shared<Rejection>,
          >(move identity)
          Option<DeclarationId>.None => Result.failResult<DeclarationId, Shared<Rejection>>(
            run reject(&self.resolver.*, module, RejectionCode.NotCallable, span),
          )
        }
      }
      Result<SelectedDeclaration, Shared<Rejection>>.Failure {error} => Result.failResult<
        DeclarationId,
        Shared<Rejection>,
      >(move error)
    }
  }
}

// Opens an empty store; a traced one also records every query lifecycle event.
fn openStore(revision: Revision, target: MachineTarget, profile: Option<FinalProfile>, tracing: bool) -> Semantic {
  let profileSlot = match &profile {
    Option<FinalProfile>.Some {..} => usize.ONE
    Option<FinalProfile>.None => usize.ZERO
  }
  let selectedTarget = match &profile {
    Option<FinalProfile>.Some {value} => FinalProfile.target(&value)
    Option<FinalProfile>.None => target
  }
  return Semantic {
    resolver: Resolver {
      source: SourceIndex.make(move revision),
      baseTarget: target,
      target: selectedTarget,
      initialProfile: move profile,
      assemblyFacts: Option.none<InitialProfile>(),
      executionStorage: Option.none<ExecutionStorage>(),
      profiles: Vector.make<FinalProfile>(),
      profileSlot: profileSlot,
      mirValues: Vector.make<MirFunction>(),
      layoutValues: Vector.make<Shared<BackendLayout>>(),
      emissionInputs: Vector.make<EmissionInputs>(),
      llvmInputs: Vector.make<LlvmInput>(),
      llvmValues: Vector.make<InstanceDefinition>(),
      modules: Vector.make<ModuleId>(),
      moduleLookup: InternIndex.make(),
      names: StringTable.make(),
      applications: Vector.make<Shared<Type>>(),
      applicationLookup: InternIndex.make(),
      layoutTypes: Vector.make<Shared<Type>>(),
      layoutTypeLookup: InternIndex.make(),
      backendInstances: Vector.make<BackendInstance>(),
      backendInstanceLookup: InternIndex.make(),
      originPlans: Vector.make<CallableOrigin.Plan>(),
      originEvidence: Vector.make<CallableOrigin.Producer>(),
      selectedApplications: Vector.make<Application>(),
      selectedApplicationLookup: InternIndex.make(),
      llvmInputLookup: InternIndex.make(),
      keys: Vector.make<ScopedKey>(),
      keyLookup: InternIndex.make(),
      currentApplication: usize.MAX,
      active: Vector.make<Word>(),
      frames: Vector.make<SourceFrame>(),
      tracing: tracing,
      events: Vector.make<Event>(),
      nextAnswerId: usize.ONE,
      nextInferenceId: usize.ZERO,
      bodies: Vector.make<BodyFrame>(),
    },
    query: Query.make<Word, Answer, NoRejection>(),
  }
}

impl Semantic {
  /// Borrows the held resolver and query for a static demand outside a running provider.
  pub fn staticPort<'source>(self: &'source mut Self, dependencies: &'source mut Vector<Dependency>) -> StaticPort<
    'source,
  > {
    return StaticPort {
      resolver: &mut self.resolver,
      query: &mut self.query,
      dependencies: move dependencies,
    }
  }
  /// Creates a lazy semantic store for one held revision and explicitly selected target.
  pub fn make(revision: Revision, target: MachineTarget, profile: Option<FinalProfile>) -> Semantic {
    return openStore(move revision, target, move profile, false)
  }
  /// Opens a store that also records every query lifecycle event for `eventLog`.
  pub fn traced(revision: Revision, target: MachineTarget, profile: Option<FinalProfile>) -> Semantic {
    return openStore(move revision, target, move profile, true)
  }

  /// Selects a new immutable source revision and validates completed facts on their next demand.
  ///
  /// # Details
  ///
  /// Selects the execution-storage component a build binds when a reached instance suspends.
  pub fn selectExecutionStorage(self: &mut Self, storage: ExecutionStorage) -> () {
    self.resolver.executionStorage = Option.some<ExecutionStorage>(move storage)
  }
  /// Exact source observations keep unchanged answers reusable. A checked body can keep its typed
  /// payload across another declaration's edit after its own inputs and child results validate.
  /// Changed source positions or incomplete evidence force a new body check.
  pub fn revise(self: &mut Self, revision: Revision) -> () {
    SourceIndex.revise(&mut self.resolver.source, move revision)
    return ()
  }
  /// Freezes one assembly's facts before any registered source default is demanded.
  /// A semantic store accepts only the facts for which its target and cached answers were opened.
  pub effect fn bindAssemblyFacts(self: &mut Self, facts: &InitialProfile) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
    let selectedTarget = InitialProfile.target(facts)
    if MachineTarget.id(selectedTarget) != MachineTarget.id(&self.resolver.target) {
      return false
    }
    if let Option<&FinalProfile>.Some {value: active} = move selectedProfile(&self.resolver) {
      if !InitialProfile.sameIdentity(FinalProfile.facts(active), facts) { return false }
    }
    let mut bound = false
    match &self.resolver.assemblyFacts {
      Option<InitialProfile>.Some {value: previous} => {
        if !InitialProfile.sameIdentity(&previous, facts) { return false }
        bound = true
      }
      Option<InitialProfile>.None => {}
    }
    if !bound { self.resolver.assemblyFacts = Option.some<InitialProfile>(run InitialProfile.copy(facts)) }
    if self.resolver.profileSlot == usize.ZERO { self.resolver.profileSlot = usize.MAX }
    return true
  }
  /// Borrows the current request's profile, including its current value origins.
  pub fn profile<'a>(self: &'a Self) -> Option<&'a FinalProfile> {
    return selectedProfile(&self.resolver)
  }
  /// Selects a complete profile by structural content; equal values reuse the same query scope.
  pub effect fn reviseProfile(self: &mut Self, profile: Option<FinalProfile>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
    let candidate = match move profile {
      Option<FinalProfile>.Some {value} => value
      Option<FinalProfile>.None => {
        self.resolver.profileSlot = usize.ZERO
        self.resolver.target = self.resolver.baseTarget
        return ()
      }
    }
    let selectedTarget = FinalProfile.target(&candidate)
    if run sameStoredProfile(&self.resolver, &candidate, usize.ONE) {
      self.resolver.initialProfile = Option.some<FinalProfile>(move candidate)
      self.resolver.profileSlot = usize.ONE
      self.resolver.target = selectedTarget
      return ()
    }
    let mut at = usize.ZERO
    while at < Vector.length<FinalProfile>(&self.resolver.profiles) {
      if run sameStoredProfile(&self.resolver, &candidate, at + 2) {
        let mut current = Vector.asMutSlice<FinalProfile>(&mut self.resolver.profiles)
        current[at] = move candidate
        self.resolver.profileSlot = at + 2
        self.resolver.target = selectedTarget
        return ()
      }
      at = at + usize.ONE
    }
    let slot = Vector.length<FinalProfile>(&self.resolver.profiles) + 2
    run Vector.append<FinalProfile>(&mut self.resolver.profiles, move candidate)
    self.resolver.profileSlot = slot
    self.resolver.target = selectedTarget
    return ()
  }
  /// Borrows the semantic query lifecycle events in demand order; empty unless the store is traced.
  pub fn eventLog(self: &Self) -> &[Event] {
    return Vector.asSlice<Event>(&self.resolver.events)
  }
  /// Borrows the source index provider starts, source reads and completions in demand order.
  pub fn sourceEvents(self: &Self) -> &[SourceEvent] {
    return SourceIndex.eventLog(&self.resolver.source)
  }
  /// Borrows the module whose namespace or declaration a recorded dependency demanded.
  pub fn dependencyModule(self: &Self, dependency: &Dependency) -> &ModuleId {
    let modules = Vector.asSlice<ModuleId>(&self.resolver.modules)
    return &modules[dependency.module]
  }
  /// Borrows the demanded spelling of a name dependency, absent for other families.
  pub fn dependencyName(self: &Self, dependency: &Dependency) -> Option<&[u8]> {
    if dependency.family != Family.Name {
      return Option.none<&[u8]>()
    }
    return Option.some<&[u8]>(StringTable.get(&self.resolver.names, Symbol {index: dependency.name}))
  }
  /// Copies the canonical declaration a declaration dependency demanded, in the held source
  /// revision. Other families, and an ordinal the held source no longer has, return `None`.
  pub effect fn dependencyDeclaration(self: &mut Self, dependency: &Dependency) -> Option<DeclarationId>
  ! Cycle | OutOfMemoryError
  ? &mut Allocator {
    if dependency.declaration == usize.MAX {
      return Option.none<DeclarationId>()
    }
    let module = run resolvedModule(&self.resolver, dependency.module)
    return run declarationAt(&mut self.resolver, &module, dependency.declaration)
  }
  /// Copies named authored addresses and actual import namespaces from one canonical source.
  /// Syntax does not admit bodies. Absent source and condition/import refusals retain observations.
  pub effect fn demandSourceInventory(self: &mut Self, request: &mut Request, module: &ModuleId) -> SourceInventory
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
    run selectRequest(&mut self.resolver, &request.*)
    let answer = run source(&mut self.resolver, module)
    let observation = run SourceIndex.captureObservation(&self.resolver.source, module)
    let indexed = match move sourceOf(&self.resolver, &answer, module) {
      Option<&IndexedSource>.Some {value} => value
      Option<&IndexedSource>.None => {
        if Observation.isPresent(&observation) { fail RevisionMismatch {} }
        return SourceInventory.Absent {observation: move observation}
      }
    }
    let sourceDigest = Sha256.hash(SourceUnit.bytes(IndexedSource.sourceUnit(indexed)))
    let copied = run ModuleIndex.copyFunctionInventory(IndexedSource.moduleIndex(indexed), IndexedSource.sourceUnit(indexed))
    let mut syntax = match move copied {
      Option<FunctionInventory>.Some {value} => move value
      Option<FunctionInventory>.None => { fail RevisionMismatch {} }
    }
    let authenticated = run SourceIndex.authoredCursor(&mut self.resolver.source, &answer, module)
    let cursor = match move authenticated {
      Option<AuthoredCursor>.Some {value} => move value
      Option<AuthoredCursor>.None => { fail RevisionMismatch {} }
    }
    let owned = Vector.asMutSlice<NamedFunction>(&mut syntax.functions)
    let mut checked = usize.ZERO
    while checked < owned.length {
      let nameSpan = SourceIndex.authoredSpan(&self.resolver.source, &cursor, owned[checked].name)
      owned[checked].nameSpan = match move nameSpan {
        Option<Span>.Some {value} => value
        Option<Span>.None => { fail RevisionMismatch {} }
      }
      checked = checked + usize.ONE
    }
    drop answer
    let mut availability = Vector.make<Result<bool, Shared<Rejection>>>()
    let functions = Vector.asSlice<NamedFunction>(&syntax.functions)
    let mut at = usize.ZERO
    while at < functions.length {
      run Vector.append<Result<bool, Shared<Rejection>>>(&mut availability,
        run requestAvailability(&mut self.resolver, &mut self.query, &mut request.*, module, functions[at].ordinal, functions[at].headerSpan))
      at = at + usize.ONE
    }
    let moduleOrdinal = run internModule(&mut self.resolver, module)
    let mut imports = Vector.make<InventoryImport>()
    let written = Vector.asSlice<IndexedDeclaration>(&syntax.imports)
    at = usize.ZERO
    while at < written.length {
      let identity = run Shared.make<DeclarationId>(run DeclarationId.copy(&written[at].identity))
      let found = run ordinalOfIdentity(&mut self.resolver, module, &identity)
      if let Option<usize>.Some {value: declaration} = move found {
        let target = run demandRaw(&mut self.resolver, &mut self.query, Key {
          family: Family.Import, module: moduleOrdinal, name: usize.ZERO,
          declaration: declaration, member: usize.MAX, external: false,
        }, Span.make(usize.ZERO, usize.ZERO))
        run recordRoot(&mut request.*, Family.Import, module, DeclarationId.spelling(&written[at].identity), &target)
        run Vector.append<InventoryImport>(&mut imports, InventoryImport {
          declaration: run DeclarationId.copy(&written[at].identity), answer: move target,
        })
      } else { fail RevisionMismatch {} }
      at = at + usize.ONE
    }
    return SourceInventory.Present {observation: move observation, sourceDigest: sourceDigest,
      syntax: move syntax, availability: move availability, imports: move imports}
  }
  /// Returns a complete name bucket, including an empty bucket, without resolving imports or types.
  /// Returns an anchored `MissingModule` rejection if the source path is absent.
  pub effect fn demandName(self: &mut Self, request: &mut Request, module: &ModuleId, name: &[u8]) -> Shared<
    Result<Answer, NoRejection>,
  > ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
    run selectRequest(&mut self.resolver, &request.*)
    let moduleOrdinal = run internModule(&mut self.resolver, module)
    let nameOrdinal = run internName(&mut self.resolver, name)
    let key = Key {
      family: Family.Name,
      module: moduleOrdinal,
      name: nameOrdinal,
      declaration: usize.ZERO,
      member: usize.ZERO,
      external: false,
    }
    let answer = run demandRaw(
      &mut self.resolver,
      &mut self.query,
      key,
      Span.make(usize.ZERO, usize.ZERO),
    )
    run recordRoot(&mut request.*, Family.Name, module, name, &answer)
    return move answer
  }
  /// Resolves a nongeneric type alias only when the caller requests its target.
  /// Returns an anchored rejection for an absent name, unsupported target, or alias cycle.
  pub effect fn demandAlias(self: &mut Self, request: &mut Request, module: &ModuleId, name: &[u8]) -> Shared<
    Result<Answer, NoRejection>,
  > ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
    run selectRequest(&mut self.resolver, &request.*)
    let answer = run demandNamed(&mut self.resolver, &mut self.query, module, name, Family.Alias)
    run recordRoot(&mut request.*, Family.Alias, module, name, &answer)
    return move answer
  }
  /// Returns a nongeneric nominal identity without resolving fields, members, or layout.
  /// Returns an anchored rejection if the name does not identify a supported nominal declaration.
  pub effect fn demandIdentity(
    self: &mut Self,
    request: &mut Request,
    module: &ModuleId,
    name: &[u8],
  ) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator {
    run selectRequest(&mut self.resolver, &request.*)
    let answer = run demandNamed(&mut self.resolver, &mut self.query, module, name, Family.Identity)
    run recordRoot(&mut request.*, Family.Identity, module, name, &answer)
    return move answer
  }
  /// Enumerates the written fields, tuple positions, enum cases, or union variants of a nominal.
  /// Member types and target layout remain undemanded.
  pub effect fn demandMembers(
    self: &mut Self,
    request: &mut Request,
    module: &ModuleId,
    name: &[u8],
  ) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator {
    run selectRequest(&mut self.resolver, &request.*)
    let answer = run demandNamed(&mut self.resolver, &mut self.query, module, name, Family.Members)
    run recordRoot(&mut request.*, Family.Members, module, name, &answer)
    return move answer
  }
  /// Resolves only one member's written types under a canonical nominal application.
  /// A struct field or tuple position has one type; a union variant has its ordered payload
  /// types; a scalar enum case has none. The member is selected by its enumeration ordinal.
  pub effect fn demandMemberShape(
    self: &mut Self,
    request: &mut Request,
    module: &ModuleId,
    name: &[u8],
    member: usize,
    application: &Shared<Type>,
  ) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator {
    run selectRequest(&mut self.resolver, &request.*)
    let moduleOrdinal = run internModule(&mut self.resolver, module)
    let nameOrdinal = run internName(&mut self.resolver, name)
    let bucketKey = Key {
      family: Family.Name,
      module: moduleOrdinal,
      name: nameOrdinal,
      declaration: usize.ZERO,
      member: usize.ZERO,
      external: false,
    }
    let observed = run demandRaw(
      &mut self.resolver,
      &mut self.query,
      bucketKey,
      Span.make(usize.ZERO, usize.ZERO),
    )
    if Shared.with<Result<Answer, NoRejection>, bool>(&observed, hasRejection) {
      run recordRoot(&mut request.*, Family.MemberShape, module, name, &observed)
      return move observed
    }
    drop observed
    // A root lookup observes governing conditions without a dependent answer.
    let mut rootConditions = Vector.make<Dependency>()
    let selectedSelection = run select(&mut self.resolver, &mut self.query, &mut rootConditions, module, name, false)
    let selected = match move selectedSelection {
      Result<Selection, Shared<Rejection>>.Success {value: selectedValue} => selectedValue
      Result<Selection, Shared<Rejection>>.Failure {error} => {
        let kept = run rootRejection(&mut self.resolver, module, move error)
        run recordRoot(&mut request.*, Family.MemberShape, module, name, &kept)
        return move kept
      }
    }
    if selected.count != usize.ONE || selected.kind != CandidateKind.Declaration {
      let mut code = RejectionCode.Collision
      if selected.count == usize.ZERO {
        code = RejectionCode.UnknownName
      } else if selected.kind != CandidateKind.Declaration {
        code = RejectionCode.NotType
      }
      let rejected = run rejectRoot(&mut self.resolver, module, bucketKey, code, selected.span)
      run recordRoot(&mut request.*, Family.MemberShape, module, name, &rejected)
      return move rejected
    }
    let applicationOrdinal = run internApplication(&mut self.resolver, application)
    let key = Key {
      family: Family.MemberShape,
      module: moduleOrdinal,
      name: applicationOrdinal,
      declaration: selected.declaration,
      member: member,
      external: false,
    }
    let answer = run demandRaw(&mut self.resolver, &mut self.query, key, selected.span)
    run recordRoot(&mut request.*, Family.MemberShape, module, name, &answer)
    return move answer
  }
  /// Resolves the binders and declared bounds of a type, alias, interface, or service declaration.
  ///
  /// # Details
  ///
  /// This does not demand the declaration's identity or members, and it proves no bound; an
  /// application of a bounded declaration is rejected as unsupported where it is written.
  pub effect fn demandContract(
    self: &mut Self,
    request: &mut Request,
    module: &ModuleId,
    name: &[u8],
  ) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator {
    run selectRequest(&mut self.resolver, &request.*)
    let answer = run demandNamed(&mut self.resolver, &mut self.query, module, name, Family.Contract)
    run recordRoot(&mut request.*, Family.Contract, module, name, &answer)
    return move answer
  }
  /// Enumerates an interface's or service's operation declarations in written order.
  ///
  /// # Details
  ///
  /// Only member headers are read; no operation signature is resolved. A field, an operation body,
  /// a visibility modifier on an operation, or another non-operation member rejects with
  /// `InvalidContractMember`, and a repeated operation name rejects at the later operation.
  pub effect fn demandOperations(
    self: &mut Self,
    request: &mut Request,
    module: &ModuleId,
    name: &[u8],
  ) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator {
    run selectRequest(&mut self.resolver, &request.*)
    let answer = run demandNamed(
      &mut self.resolver,
      &mut self.query,
      module,
      name,
      Family.Operations,
    )
    run recordRoot(&mut request.*, Family.Operations, module, name, &answer)
    return move answer
  }
  /// Resolves the written signature of one interface or service operation without reading a body.
  ///
  /// # Details
  ///
  /// The operation resolves under its contract's binders and implicit `Self` provider, while its
  /// own binders keep the operation's identity. The contract's operation list is demanded first,
  /// so an invalid member list rejects here too. An absent operation rejects with `UnknownMember`.
  pub effect fn demandOperation(
    self: &mut Self,
    request: &mut Request,
    module: &ModuleId,
    contract: &[u8],
    operation: &[u8],
  ) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator {
    run selectRequest(&mut self.resolver, &request.*)
    let listed = run demandNamed(
      &mut self.resolver,
      &mut self.query,
      module,
      contract,
      Family.Operations,
    )
    if Shared.with<Result<Answer, NoRejection>, bool>(&listed, hasRejection) {
      run recordRoot(&mut request.*, Family.Signature, module, operation, &listed)
      return move listed
    }
    drop listed
    // A root lookup observes governing conditions without a dependent answer.
    let mut rootConditions = Vector.make<Dependency>()
    let selectedSelection = run select(&mut self.resolver, &mut self.query, &mut rootConditions, module, contract, false)
    let selected = match move selectedSelection {
      Result<Selection, Shared<Rejection>>.Success {value: selectedValue} => selectedValue
      Result<Selection, Shared<Rejection>>.Failure {error} => {
        let kept = run rootRejection(&mut self.resolver, module, move error)
        run recordRoot(&mut request.*, Family.Signature, module, operation, &kept)
        return move kept
      }
    }
    let lookup = run memberOrdinal(&mut self.resolver, module, selected.declaration, operation)
    if let Option<Span>.Some {value: span} = move lookup.repeated {
      let diagnostic = run reject(&self.resolver, module, RejectionCode.Collision, span)
      let repeated = run rootRejection(&mut self.resolver, module, move diagnostic)
      run recordRoot(&mut request.*, Family.Signature, module, operation, &repeated)
      return move repeated
    }
    if let Option<usize>.Some {value: ordinal} = move lookup.ordinal {
      let answer = run memberSignature(
        &mut self.resolver,
        &mut self.query,
        module,
        ordinal,
        selected.span,
      )
      run recordRoot(&mut request.*, Family.Signature, module, operation, &answer)
      return move answer
    }
    // The contract's name is the nearest written anchor for an absent operation.
    let absent = run rejectAbsent(&mut self.resolver, module, selected.span)
    run recordRoot(&mut request.*, Family.Signature, module, operation, &absent)
    return move absent
  }
  /// Resolves the heads of every top-level conformance and sealed-property `impl` in one module, in
  /// written order.
  ///
  /// # Details
  ///
  /// Each head is the implementation's binders, including lifetimes elided from its heads, with
  /// its applied contract and provider. Only header names and applications are resolved; no member
  /// or body is read. An empty list observes that the module declares none. One rejected head
  /// rejects the list, because the module's membership is then unknown. Inherent `impl`s are
  /// reached through their owner with `demandInherentMembers`.
  pub effect fn demandImplementations(self: &mut Self, request: &mut Request, module: &ModuleId) -> Shared<
    Result<Answer, NoRejection>,
  > ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
    run selectRequest(&mut self.resolver, &request.*)
    let key = Key {
      family: Family.Implementations,
      module: run internModule(&mut self.resolver, module),
      name: usize.ZERO,
      declaration: usize.ZERO,
      member: usize.ZERO,
      external: false,
    }
    let answer = run demandRaw(
      &mut self.resolver,
      &mut self.query,
      key,
      Span.make(usize.ZERO, usize.ZERO),
    )
    run recordRoot(&mut request.*, Family.Implementations, module, b"", &answer)
    return move answer
  }
  /// Lists the conformance heads that implement an applied interface or service for a provider.
  ///
  /// # Details
  ///
  /// Heads are read only from the modules permitted to own them: the contract's module and the
  /// nominal provider's module for an interface, the provider's module for a service. A facade or
  /// alias spelling of either endpoint converges on the same canonical owners. An empty list
  /// observes absence; bodies, members, and applicability are not examined.
  ///
  /// # Gotchas
  ///
  /// Both types must come from answers of this store. A contract whose declaring module this store
  /// has never read fails with `InvalidModulePath`.
  pub effect fn demandConformanceHeads(
    self: &mut Self,
    request: &mut Request,
    contract: &Shared<Type>,
    provider: &Shared<Type>,
  ) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator {
    run selectRequest(&mut self.resolver, &request.*)
    let contractModule = declaringModuleOrdinal(&self.resolver, contract)
    if contractModule == usize.MAX {
      fail InvalidModulePath {}
    }
    let module = run resolvedModule(&self.resolver, contractModule)
    let located = run ordinalOfProvider(&mut self.resolver, &module, contract)
    let declaration = match move located {
      Option<usize>.Some {value} => value
      Option<usize>.None => {
        fail InvalidModulePath {}
      }
    }
    let key = Key {
      family: Family.ConformanceHeads,
      module: contractModule,
      name: run internApplication(&mut self.resolver, provider),
      declaration: declaration,
      member: usize.ZERO,
      external: false,
    }
    let answer = run demandRaw(
      &mut self.resolver,
      &mut self.query,
      key,
      Span.make(usize.ZERO, usize.ZERO),
    )
    run recordRoot(&mut request.*, Family.ConformanceHeads, &module, b"", &answer)
    return move answer
  }
  /// Proves one interface or service application using exact concrete heads and the caller's
  /// declared abstract bounds. Every conditional requirement must finish before proof succeeds.
  /// `siteModule` and `siteSpan` anchor a missing or undecidable goal at the use; declaration-level
  /// coherence and witness failures keep their own source anchors. This selects no runtime provider
  /// and adds no Effect requirement.
  pub effect fn proveConformance(
    self: &mut Self,
    request: &mut Request,
    contract: &Shared<Type>,
    provider: &Shared<Type>,
    declared: &[Constraint],
    siteModule: &ModuleId,
    siteSpan: Span,
  ) -> ConformanceDecision
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator {
    run selectRequest(&mut self.resolver, &request.*)
    let goal = ConformanceGoal {
      contract: Shared.clone<Type>(contract),
      provider: Shared.clone<Type>(provider),
    }
    let mut chain = Vector.make<ConformanceGoal>()
    let mut steps = Vector.make<ConformanceStep>()
    let mut dependencies = Vector.make<Dependency>()
    let avoid = Option.none<Shared<DeclarationId>>()
    let failure = run proveGoal(
      &mut self.resolver,
      &mut self.query,
      &mut request.*,
      &mut dependencies,
      false,
      &avoid,
      &goal,
      declared,
      siteModule,
      siteSpan,
      &mut chain,
      &mut steps,
    )
    if let Option<Shared<Rejection>>.Some {value: diagnostic} = move failure {
      return ConformanceDecision.Rejected {diagnostic: move diagnostic, chain: move chain}
    }
    return ConformanceDecision.Proven {proof: ConformanceProof {steps: move steps}}
  }
  /// Validates a complete application against its target and lexical scope headers.
  /// No body is demanded, and a rejected environment retains the caller's diagnostic site.
  pub effect fn validateApplication(self: &mut Self, request: &mut Request, application: &Application,
    siteModule: &ModuleId, siteSpan: Span) -> Result<Application, Shared<Rejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
    run selectRequest(&mut self.resolver, &request.*)
    // A root application may name a module no earlier demand has interned in this store.
    let targetModule = run internModule(&mut self.resolver, DeclarationId.moduleId(Application.bodyDeclaration(application)))
    let mut dependencies = Vector.make<Dependency>()
    let found = run resolveTargetSchema(&mut self.resolver, &mut self.query, &mut request.*, &mut dependencies, false,
      Application.bodyDeclaration(application), siteSpan)
    if let Option<TargetSchema>.Some {value: schema} = move found {
      if run TargetSchema.accepts(&schema, application) { return Result.succeed<Application, Shared<Rejection>>(run Application.copy(application)) }
    }
    return Result.failResult<Application, Shared<Rejection>>(run reject(&self.resolver, siteModule, RejectionCode.Unsupported, siteSpan))
  }
  /// Resolves a target signature under its complete validated own and enclosing environment.
  /// The lexical Self provider is derived from the head, never stored as an extra argument.
  pub effect fn specializeSignature(self: &mut Self, request: &mut Request, application: &Application,
    siteModule: &ModuleId, siteSpan: Span) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
    let validated = run Semantic.validateApplication(&mut self.*, &mut request.*, application, siteModule, siteSpan)
    let selected = match move validated {
      Result<Application, Shared<Rejection>>.Success {value} => Option.some<Application>(move value)
      Result<Application, Shared<Rejection>>.Failure {error} => {
        return run Shared.make<Result<Answer, NoRejection>>(Result.succeed<Answer, NoRejection>(memberRejected(move error, Vector.make<Dependency>())))
      }
    }
    let identity = Application.bodyDeclaration(application)
    let moduleOrdinal = knownModuleOrdinal(&self.resolver, DeclarationId.moduleId(identity))
    let module = run resolvedModule(&self.resolver, moduleOrdinal)
    let shared = run Shared.make<DeclarationId>(run DeclarationId.copy(identity))
    let found = run ordinalOfIdentity(&mut self.resolver, &module, &shared)
    let ordinal = match move found { Option<usize>.Some {value} => value _ => { fail InvalidModulePath {} } }
    let answer = run resolveSignatureUnder(&mut self.resolver, &mut self.query,
      Key {family: Family.Signature, module: moduleOrdinal, name: usize.ZERO, declaration: ordinal, member: usize.ZERO, external: false},
      Vector.make<Dependency>(), Option.none<Vector<Argument>>(), Option.none<Vector<Argument>>(), &selected)
    return run Shared.make<Result<Answer, NoRejection>>(Result.succeed<Answer, NoRejection>(move answer))
  }
  /// Resolves an interface call under its caller's concrete type and row arguments.
  ///
  /// # Details
  /// Substitutes both contract and provider, proves the concrete goal without declared bounds,
  /// and composes the selected witness's argument mapping in target binder order. The returned
  /// Named application has the same canonical identity as a direct call to that target.
  /// Proof and witness headers are demanded; the target body is never read. Operation-owned
  /// arguments absent from the checked call remain unresolved for the backend to classify.
  pub effect fn specializeInterfaceCall(
    self: &mut Self,
    request: &mut Request,
    contract: &Shared<Type>,
    provider: &Shared<Type>,
    operation: &DeclarationId,
    caller: &Application,
    siteModule: &ModuleId,
    siteSpan: Span,
  ) -> Result<Application, Shared<Rejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator {
    run selectRequest(&mut self.resolver, &request.*)
    let checked = run Semantic.validateApplication(&mut self.*, &mut request.*, caller, siteModule, siteSpan)
    let environment = match move checked {
      Result<Application, Shared<Rejection>>.Success {value} => move value
      Result<Application, Shared<Rejection>>.Failure {error} => { return Result.failResult<Application, Shared<Rejection>>(move error) }
    }
    let bindings = run Application.bindings(&environment)
    let appliedContract = run Type.applyBindings(contract, Vector.asSlice<Binding>(&bindings), true)
    let appliedProvider = run Type.applyBindings(provider, Vector.asSlice<Binding>(&bindings), true)
    let mut dependencies = Vector.make<Dependency>()
    let selected = run resolveWitnessApplication(
      &mut self.resolver, &mut self.query, &mut request.*, &mut dependencies, false,
      &appliedContract, &appliedProvider, operation, siteModule, siteSpan,
    )
    return match move selected {
      Result<ResolvedWitness, Shared<Rejection>>.Success {value} => Result.succeed<Application, Shared<Rejection>>(move value.application)
      Result<ResolvedWitness, Shared<Rejection>>.Failure {error} => Result.failResult<Application, Shared<Rejection>>(move error)
    }
  }
  /// Decides whether one conformance `impl` is coherent before any applicability or bound proof.
  ///
  /// # Details
  ///
  /// Every written parameter must occur in the interface application or the provider, and every
  /// bound must descend through the provider without repeating an open parameter or rewriting a
  /// fixed interface argument (`NonterminatingConformance` with its step). The complete owner
  /// bucket is then read, and no other head may name the same goal once lifetimes are erased:
  /// bounds never make heads distinct and no head wins by source or demand order. Both heads of a
  /// conflict reject with the same diagnostic, anchored at the canonically later head, with `path`
  /// holding that head and then the earliest other conflicting head. `DuplicateConformance` names
  /// two unbounded heads that rename each other exactly; any other conflict is
  /// `OverlappingConformance`. A head the lifetime-erased comparison cannot decide, such as one
  /// whose union member nests a parameter, is `Unsupported`. A success proves no bound and admits
  /// no witness. An identity absent from the current revision rejects with `UnknownMember`.
  pub effect fn demandCoherence(
    self: &mut Self,
    request: &mut Request,
    implementation: &DeclarationId,
  ) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator {
    run selectRequest(&mut self.resolver, &request.*)
    let module = DeclarationId.moduleId(implementation)
    let moduleOrdinal = run internModule(&mut self.resolver, module)
    let identity = run Shared.make<DeclarationId>(run DeclarationId.copy(implementation))
    let found = run ordinalOfIdentity(&mut self.resolver, module, &identity)
    let answer = match move found {
      Option<usize>.Some {value: ordinal} => run demandRaw(
        &mut self.resolver,
        &mut self.query,
        Key {
          family: Family.Coherence,
          module: moduleOrdinal,
          name: usize.ZERO,
          declaration: ordinal,
          member: usize.ZERO,
          external: false,
        },
        Span.make(usize.ZERO, usize.ZERO),
      )
      Option<usize>.None => run rejectAbsent(
        &mut self.resolver,
        module,
        Span.make(usize.ZERO, usize.ZERO),
      )
    }
    run recordRoot(&mut request.*, Family.Coherence, module, b"", &answer)
    return move answer
  }
  /// Lists the written members of a module's `occurrence`th top-level `impl`, which must be a
  /// conformance or sealed-property implementation.
  ///
  /// # Details
  ///
  /// An inline member is its function declaration. A mapped member's path is resolved from headers
  /// only: a function of this module or of an imported namespace, or an inherent member its owner
  /// publishes. A repeated member name rejects with `Collision`; a rejected head publishes no
  /// member. Members are not matched against contract operations here.
  pub effect fn demandImplementationMembers(
    self: &mut Self,
    request: &mut Request,
    module: &ModuleId,
    occurrence: usize,
  ) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator {
    run selectRequest(&mut self.resolver, &request.*)
    let moduleOrdinal = run internModule(&mut self.resolver, module)
    let implementation = run implementationOrdinal(&mut self.resolver, module, occurrence)
    if let Option<usize>.Some {value: ordinal} = move implementation {
      let key = Key {
        family: Family.ImplementationMembers,
        module: moduleOrdinal,
        name: usize.ZERO,
        declaration: ordinal,
        member: usize.ZERO,
        external: false,
      }
      let answer = run demandRaw(
        &mut self.resolver,
        &mut self.query,
        key,
        Span.make(usize.ZERO, usize.ZERO),
      )
      run recordRoot(&mut request.*, Family.ImplementationMembers, module, b"", &answer)
      return move answer
    }
    let absent = run rejectAbsent(&mut self.resolver, module, Span.make(usize.ZERO, usize.ZERO))
    run recordRoot(&mut request.*, Family.ImplementationMembers, module, b"", &absent)
    return move absent
  }
  /// Enumerates the inherent members an owner publishes across its module's inherent `impl`s.
  ///
  /// # Details
  ///
  /// Only the owner's module is read; a rejected head publishes no member, and a deferred head
  /// defers the whole enumeration with its own rejection. A member whose name
  /// repeats another member, or an owner field, variant, enum member, generated operation, or
  /// contract operation, is not published, and its anchored rejection is kept; no winner is chosen
  /// by source order. Member signatures are not resolved.
  pub effect fn demandInherentMembers(
    self: &mut Self,
    request: &mut Request,
    module: &ModuleId,
    name: &[u8],
  ) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator {
    run selectRequest(&mut self.resolver, &request.*)
    let answer = run demandNamed(
      &mut self.resolver,
      &mut self.query,
      module,
      name,
      Family.InherentMembers,
    )
    run recordRoot(&mut request.*, Family.InherentMembers, module, name, &answer)
    return move answer
  }
  /// Resolves the signature of `member`, an inherent member of the owner declaration `owner`.
  ///
  /// # Details
  ///
  /// The owner's published members decide the answer. A member that repeats another member's name
  /// or claims an owner item's name returns its kept rejection; no winner is chosen by source
  /// order. A member of a rejected inherent head is not published. An absent member rejects with
  /// `UnknownMember`.
  pub effect fn demandInherentMember(
    self: &mut Self,
    request: &mut Request,
    module: &ModuleId,
    owner: &[u8],
    member: &[u8],
  ) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator {
    run selectRequest(&mut self.resolver, &request.*)
    let listed = run demandNamed(
      &mut self.resolver,
      &mut self.query,
      module,
      owner,
      Family.InherentMembers,
    )
    if Shared.with<Result<Answer, NoRejection>, bool>(&listed, hasRejection) {
      run recordRoot(&mut request.*, Family.Signature, module, member, &listed)
      return move listed
    }
    let lookup = Shared.with<Result<Answer, NoRejection>, InherentLookup>(
      &listed,
      fn(answer: &Result<Answer, NoRejection>) -> InherentLookup {
        return inherentLookup(answer, member)
      },
    )
    drop listed
    let InherentLookup {published, rejected} = move lookup
    if let Option<Shared<DeclarationId>>.Some {value: declaration} = move published {
      let found = run ordinalOfIdentity(&mut self.resolver, module, &declaration)
      if let Option<usize>.Some {value: ordinal} = move found {
        let answer = run memberSignature(
          &mut self.resolver,
          &mut self.query,
          module,
          ordinal,
          Span.make(usize.ZERO, usize.ZERO),
        )
        run recordRoot(&mut request.*, Family.Signature, module, member, &answer)
        return move answer
      }
    }
    if let Option<Shared<Rejection>>.Some {value: diagnostic} = move rejected {
      let kept = run rootRejection(&mut self.resolver, module, move diagnostic)
      run recordRoot(&mut request.*, Family.Signature, module, member, &kept)
      return move kept
    }
    // The owner's name is the nearest written anchor for an absent member.
    // A root lookup observes governing conditions without a dependent answer.
    let mut rootConditions = Vector.make<Dependency>()
    let selectedSelection = run select(&mut self.resolver, &mut self.query, &mut rootConditions, module, owner, false)
    let selected = match move selectedSelection {
      Result<Selection, Shared<Rejection>>.Success {value: selectedValue} => selectedValue
      Result<Selection, Shared<Rejection>>.Failure {error} => {
        let kept = run rootRejection(&mut self.resolver, module, move error)
        run recordRoot(&mut request.*, Family.Signature, module, member, &kept)
        return move kept
      }
    }
    let absent = run rejectAbsent(&mut self.resolver, module, selected.span)
    run recordRoot(&mut request.*, Family.Signature, module, member, &absent)
    return move absent
  }
  /// Resolves the signature of one function or operation addressed by its declaration identity.
  ///
  /// # Details
  ///
  /// This is the answer the name lookups return for the same declaration, under the same gates: a
  /// contract operation needs its contract's operation list, an `impl` member whose name is written
  /// twice in its block rejects with `Collision`, and an inherent member returns its owner's kept
  /// rejection unless the owner publishes it. An identity absent from the current revision
  /// rejects with `UnknownMember`.
  pub effect fn demandSignatureOf(
    self: &mut Self,
    request: &mut Request,
    declaration: &DeclarationId,
  ) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator {
    run selectRequest(&mut self.resolver, &request.*)
    let module = DeclarationId.moduleId(declaration)
    let identity = run Shared.make<DeclarationId>(run DeclarationId.copy(declaration))
    let found = run ordinalOfIdentity(&mut self.resolver, module, &identity)
    let answer = match move found {
      Option<usize>.Some {value: ordinal} => run requestMemberSignature(
        &mut self.resolver,
        &mut self.query,
        &mut request.*,
        module,
        ordinal,
        Span.make(usize.ZERO, usize.ZERO),
      )
      Option<usize>.None => run rejectAbsent(
        &mut self.resolver,
        module,
        Span.make(usize.ZERO, usize.ZERO),
      )
    }
    run recordRoot(
      &mut request.*,
      Family.Signature,
      module,
      DeclarationId.spelling(declaration),
      &answer,
    )
    return move answer
  }
  /// Resolves a contract operation's written call signature under an applied interface and
  /// provider, without choosing evidence for the application. Qualified calls, method calls, and
  /// operators use this same `Self` substitution after their supplier has been selected. The
  /// caller must separately prove the application or supply a declared bound.
  pub effect fn demandAppliedOperation(
    self: &mut Self,
    request: &mut Request,
    contract: &Shared<Type>,
    provider: &Shared<Type>,
    operation: &DeclarationId,
  ) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator {
    run selectRequest(&mut self.resolver, &request.*)
    let moduleOrdinal = declaringModuleOrdinal(&self.resolver, contract)
    if moduleOrdinal == usize.MAX {
      fail InvalidModulePath {}
    }
    let module = run resolvedModule(&self.resolver, moduleOrdinal)
    let identity = run Shared.make<DeclarationId>(run DeclarationId.copy(operation))
    let found = run ordinalOfIdentity(&mut self.resolver, &module, &identity)
    let ordinal = match move found {
      Option<usize>.Some {value} => value
      Option<usize>.None => {
        let absent = run rejectAbsent(
          &mut self.resolver,
          &module,
          Span.make(usize.ZERO, usize.ZERO),
        )
        run recordRoot(
          &mut request.*,
          Family.AppliedOperation,
          &module,
          DeclarationId.spelling(operation),
          &absent,
        )
        return move absent
      }
    }
    let key = Key {
      family: Family.AppliedOperation,
      module: moduleOrdinal,
      name: run internApplication(&mut self.resolver, contract),
      declaration: ordinal,
      member: run internApplication(&mut self.resolver, provider),
      external: false,
    }
    let answer = run demandRaw(
      &mut self.resolver,
      &mut self.query,
      key,
      Span.make(usize.ZERO, usize.ZERO),
    )
    run recordRoot(
      &mut request.*,
      Family.AppliedOperation,
      &module,
      DeclarationId.spelling(operation),
      &answer,
    )
    return move answer
  }
  /// Resolves a contract operation's signature under one conformance `impl`, with the contract's
  /// binders bound to the head's contract arguments and `Self` to its provider.
  ///
  /// # Details
  ///
  /// The operation keeps its own binders as its parameters. The supplied arguments are not checked
  /// against the contract's bounds. An operation that is not in the head's contract, or a head with
  /// no contract, rejects with `UnknownMember`; a rejected head or operation list rejects with its
  /// diagnostic. No member or body of the implementation is read.
  pub effect fn demandOperationUnder(
    self: &mut Self,
    request: &mut Request,
    implementation: &DeclarationId,
    operation: &DeclarationId,
  ) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator {
    run selectRequest(&mut self.resolver, &request.*)
    let module = DeclarationId.moduleId(implementation)
    let name = DeclarationId.spelling(operation)
    let moduleOrdinal = run internModule(&mut self.resolver, module)
    let identity = run Shared.make<DeclarationId>(run DeclarationId.copy(implementation))
    let found = run ordinalOfIdentity(&mut self.resolver, module, &identity)
    let ordinal = match move found {
      Option<usize>.Some {value} => value
      Option<usize>.None => {
        let absent = run rejectAbsent(&mut self.resolver, module, Span.make(usize.ZERO, usize.ZERO))
        run recordRoot(&mut request.*, Family.OperationUnder, module, name, &absent)
        return move absent
      }
    }
    let position = run operationPosition(
      &mut self.resolver,
      &mut self.query,
      moduleOrdinal,
      ordinal,
      operation,
    )
    let member = match move position {
      Result<usize, Shared<Result<Answer, NoRejection>>>.Success {value} => value
      Result<usize, Shared<Result<Answer, NoRejection>>>.Failure {error} => {
        run recordRoot(&mut request.*, Family.OperationUnder, module, name, &error)
        return move error
      }
    }
    let key = Key {
      family: Family.OperationUnder,
      module: moduleOrdinal,
      name: usize.ZERO,
      declaration: ordinal,
      member: member,
      external: false,
    }
    let answer = run demandRaw(
      &mut self.resolver,
      &mut self.query,
      key,
      Span.make(usize.ZERO, usize.ZERO),
    )
    run recordRoot(&mut request.*, Family.OperationUnder, module, name, &answer)
    return move answer
  }
  /// Pairs every contract operation of one conformance `impl` with the member that implements it,
  /// and checks each member's header against the operation's header under the conformance head.
  ///
  /// # Details
  ///
  /// The witnesses follow the contract's operation order. A missing, unknown, or incompatible
  /// member rejects with `IncompatibleWitness`, which names the failing component, at the member
  /// or, for a missing one, at the `impl`. A narrower implementation keeps the operation's header
  /// as the contract callers see. No member body is read, and a successful answer proves no
  /// conformance: the head's bounds and coherence are separate facts. An inherent or sealed head
  /// rejects with `UnknownMember`.
  pub effect fn demandWitnesses(
    self: &mut Self,
    request: &mut Request,
    implementation: &DeclarationId,
  ) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator {
    run selectRequest(&mut self.resolver, &request.*)
    let module = DeclarationId.moduleId(implementation)
    let moduleOrdinal = run internModule(&mut self.resolver, module)
    let identity = run Shared.make<DeclarationId>(run DeclarationId.copy(implementation))
    let found = run ordinalOfIdentity(&mut self.resolver, module, &identity)
    if let Option<usize>.Some {value: ordinal} = move found {
      let key = Key {
        family: Family.Witnesses,
        module: moduleOrdinal,
        name: usize.ZERO,
        declaration: ordinal,
        member: usize.ZERO,
        external: false,
      }
      let answer = run demandRaw(
        &mut self.resolver,
        &mut self.query,
        key,
        Span.make(usize.ZERO, usize.ZERO),
      )
      run recordRoot(&mut request.*, Family.Witnesses, module, b"", &answer)
      return move answer
    }
    let absent = run rejectAbsent(&mut self.resolver, module, Span.make(usize.ZERO, usize.ZERO))
    run recordRoot(&mut request.*, Family.Witnesses, module, b"", &absent)
    return move absent
  }
  /// Resolves a function's written parameter and result types without reading its body.
  /// Returns an anchored rejection for an unsupported header or referenced type.
  pub effect fn demandSignature(
    self: &mut Self,
    request: &mut Request,
    module: &ModuleId,
    name: &[u8],
  ) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator {
    run selectRequest(&mut self.resolver, &request.*)
    let answer = run demandNamed(
      &mut self.resolver,
      &mut self.query,
      module,
      name,
      Family.Signature,
    )
    run recordRoot(&mut request.*, Family.Signature, module, name, &answer)
    return move answer
  }
  /// Resolves a constant's written type without reading its initializer.
  ///
  /// # Details
  ///
  /// The type is one primitive scalar or `string`, whose omitted lifetime is `'static`. Any other
  /// type is an anchored `InvalidConstant` rejection.
  pub effect fn demandConstant(
    self: &mut Self,
    request: &mut Request,
    module: &ModuleId,
    name: &[u8],
  ) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator {
    run selectRequest(&mut self.resolver, &request.*)
    let answer = run demandNamed(&mut self.resolver, &mut self.query, module, name, Family.Constant)
    run recordRoot(&mut request.*, Family.Constant, module, name, &answer)
    return move answer
  }
  /// Resolves one registered package parameter's header without evaluating its default.
  pub effect fn demandParameterSchema(
    self: &mut Self,
    request: &mut Request,
    module: &ModuleId,
    name: &[u8],
  ) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator {
    run selectRequest(&mut self.resolver, &request.*)
    if !Request.hasRegisteredSchemaModule(&request.*, module) {
      let diagnostic = run reject(
        &self.resolver,
        module,
        RejectionCode.UnregisteredParameter,
        Span.make(usize.ZERO, usize.ZERO),
      )
      let answer = run rootRejection(&mut self.resolver, module, move diagnostic)
      run recordRoot(&mut request.*, Family.ParameterSchema, module, name, &answer)
      return move answer
    }
    let conditional = run conditionalParameterSpan(&mut self.resolver, module, name)
    if let Option<Span>.Some {value: span} = move conditional {
      let diagnostic = run reject(&self.resolver, module, RejectionCode.ConditionalParameter, span)
      let answer = run rootRejection(&mut self.resolver, module, move diagnostic)
      run recordRoot(&mut request.*, Family.ParameterSchema, module, name, &answer)
      return move answer
    }
    let answer = run demandNamed(
      &mut self.resolver,
      &mut self.query,
      module,
      name,
      Family.ParameterSchema,
    )
    run recordRoot(&mut request.*, Family.ParameterSchema, module, name, &answer)
    return move answer
  }
  /// Evaluates one registered parameter's exact source default through the held static machine.
  pub effect fn demandParameterDefault(
    self: &mut Self,
    request: &mut Request,
    identity: &DeclarationId,
  ) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator {
    run selectRequest(&mut self.resolver, &request.*)
    let module = DeclarationId.moduleId(identity)
    let name = DeclarationId.spelling(identity)
    if !Request.hasRegisteredSchemaModule(&request.*, module) {
      let diagnostic = run reject(&self.resolver, module, RejectionCode.UnregisteredParameter, Span.make(usize.ZERO, usize.ZERO))
      let answer = run rootRejection(&mut self.resolver, module, move diagnostic)
      run recordRoot(&mut request.*, Family.ParameterDefault, module, name, &answer)
      return move answer
    }
    let moduleOrdinal = run internModule(&mut self.resolver, module)
    let owned = run Shared.make<DeclarationId>(run DeclarationId.copy(identity))
    let found = run ordinalOfIdentity(&mut self.resolver, module, &owned)
    let ordinal = match move found {
      Option<usize>.Some {value} => value
      Option<usize>.None => {
        let absent = run rejectAbsent(&mut self.resolver, module, Span.make(usize.ZERO, usize.ZERO))
        run recordRoot(&mut request.*, Family.ParameterDefault, module, name, &absent)
        return move absent
      }
    }
    let key = Key {
      family: Family.ParameterDefault, module: moduleOrdinal, name: usize.ZERO,
      declaration: ordinal, member: usize.ZERO, external: false,
    }
    let answer = run demandRaw(&mut self.resolver, &mut self.query, key, Span.make(usize.ZERO, usize.ZERO))
    run recordRoot(&mut request.*, Family.ParameterDefault, module, name, &answer)
    return move answer
  }
  /// Demands every parameter header in each explicitly registered source module.
  /// Imports alone never add schemas. Registered modules are visited in canonical order.
  pub effect fn demandRegisteredParameters(self: &mut Self, request: &mut Request) -> Result<
    Vector<RegisteredParameter>,
    Shared<Rejection>,
  > ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
    let mut results = Vector.make<RegisteredParameter>()
    let mut moduleAt = usize.ZERO
    while moduleAt < Request.registeredSchemaModules(&request.*).length {
      let selected = Request.registeredSchemaModules(&request.*)
      let module = run ModuleId.copy(&selected[moduleAt])
      let loaded = run source(&mut self.resolver, &module)
      let mut names = Vector.make<RegisteredName>()
      if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(
        &self.resolver,
        &loaded,
        &module,
      ) {
        let hir = IndexedSource.authored(indexed)
        let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(indexed))
        let mut at = usize.ZERO
        while at < declarations.length {
          let topLevel = match & declarations[at].parent {
            Option<usize>.None => true
            Option<usize>.Some {value: _} => false
          }
          if topLevel && DeclarationId.kind(&declarations[at].identity) == OwnerKind.PackageParameter {
            if let Node.PackageParameterHeader {name, ..} = Module.node(
              hir,
              declarations[at].header,
            ) {
              if let Node.Name {text} = Module.node(hir, name) {
                run Vector.append<RegisteredName>(&mut names, RegisteredName {
                  name: run Bytes.copy(Module.text(hir, text)),
                  identity: run DeclarationId.copy(&declarations[at].identity),
                })
              }
            }
          }
          at = at + usize.ONE
        }
      } else {
        return Result.failResult<Vector<RegisteredParameter>, Shared<Rejection>>(
          run reject(
            &self.resolver,
            &module,
            RejectionCode.MissingModule,
            Span.make(usize.ZERO, usize.ZERO),
          ),
        )
      }
      while Vector.length<RegisteredName>(&names) > usize.ZERO {
        let listed = Vector.remove<RegisteredName>(&mut names, usize.ZERO)
        let answer = run Semantic.demandParameterSchema(
          &mut self.*, &mut request.*, &module, Bytes.asSlice(&listed.name),
        )
        run Vector.append<RegisteredParameter>(&mut results, RegisteredParameter {
          module: run ModuleId.copy(&module),
          name: move listed.name,
          identity: move listed.identity,
          answer: move answer,
        })
      }
      moduleAt = moduleAt + usize.ONE
    }
    return Result.succeed<Vector<RegisteredParameter>, Shared<Rejection>>(move results)
  }
  /// Publishes a constant's value when its initializer needs no static execution.
  ///
  /// # Details
  ///
  /// The value demand first demands the constant's type. An exact Boolean or integer literal
  /// within its selected target range is the value. A bare name of another constant demands that
  /// constant's type, then its value, so a repeated initializer path is a `Cycle` rejection while
  /// both types stay available.
  ///
  /// # Gotchas
  ///
  /// Every other initializer, including floating-point, text, call, or operator, is an anchored
  /// `Unsupported` rejection rather than a provisional value.
  pub effect fn demandInitializer(
    self: &mut Self,
    request: &mut Request,
    module: &ModuleId,
    name: &[u8],
  ) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator {
    run selectRequest(&mut self.resolver, &request.*)
    let answer = run demandNamed(
      &mut self.resolver,
      &mut self.query,
      module,
      name,
      Family.Initializer,
    )
    run recordRoot(&mut request.*, Family.Initializer, module, name, &answer)
    return move answer
  }
  /// Types one demanded ordinary function body against its written signature.
  ///
  /// # Details
  ///
  /// Scalar bodies retain the existing fully checked result. A generic body is typed once with
  /// symbolic parameters; its `TypedBody.Stage.ContractTyped` result retains safety obligations
  /// for later ownership, lifetime, cleanup, and Effect checking. A direct ordinary call reads
  /// the callee signature and records its required runtime body without checking that body.
  /// Completed answers replay current source and signature evidence into each request. Validated
  /// reuse records a `Reuse` event after the query starts rather than a cache hit.
  ///
  /// # Gotchas
  ///
  /// An unsupported expression or statement produces an anchored rejection. Contract typing does
  /// not establish executable readiness or full body safety.
  pub effect fn demandBody(self: &mut Self, request: &mut Request, module: &ModuleId, name: &[u8]) -> Shared<
    Result<Answer, NoRejection>,
  > ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
    run selectRequest(&mut self.resolver, &request.*)
    let answer = run demandNamed(&mut self.resolver, &mut self.query, module, name, Family.Body)
    run recordRoot(&mut request.*, Family.Body, module, name, &answer)
    return move answer
  }
  /// Types one exact authored function/operation through the same identity gates as SignatureOf.
  /// An inactive declaration or refused membership cannot reuse a previously checked body.
  /// Unsupported and rejection answers remain their actual discriminants; no-body syntax never
  /// gains a fabricated checked body. This is ordinary abstract Body, not selected executable MIR.
  pub effect fn demandBodyOf(self: &mut Self, request: &mut Request, declaration: &DeclarationId) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
    run selectRequest(&mut self.resolver, &request.*)
    let module = DeclarationId.moduleId(declaration)
    let identity = run Shared.make<DeclarationId>(run DeclarationId.copy(declaration))
    let found = run ordinalOfIdentity(&mut self.resolver, module, &identity)
    let span = Span.make(usize.ZERO, usize.ZERO)
    let answer = match move found {
      Option<usize>.None => run rejectAbsent(&mut self.resolver, module, span)
      Option<usize>.Some {value: ordinal} => run requestMemberBody(
        &mut self.resolver, &mut self.query, &mut request.*, module, ordinal, span)
    }
    run recordRoot(&mut request.*, Family.Body, module, DeclarationId.spelling(declaration), &answer)
    return move answer
  }
  /// Demands the drop glue MIR of one type through the `Family.Mir` key the instance worklist
  /// interns for it. A type that mentions no declaration has no glue and answers `LayoutUnsupported`.
  pub effect fn demandGlueMir(self: &mut Self, request: &mut Request, ty: &Shared<Type>, sourceOwner: &DeclarationId) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
    run selectRequest(&mut self.resolver, &request.*)
    let span = Span.make(usize.ZERO, usize.ZERO)
    let glueResult = match move run InstanceKey.dropGlue(ty, sourceOwner) {
      Result<Option<InstanceKey>, CanonicalizationFailure>.Success {value: canonicalGlue} => move canonicalGlue
      Result<Option<InstanceKey>, CanonicalizationFailure>.Failure {..} => {
        return run Shared.make<Result<Answer, NoRejection>>(Result.succeed<Answer, NoRejection>(memberRejected(
          run canonicalRejection(&mut self.resolver, sourceOwner, span), Vector.make<Dependency>())))
      }
    }
    let instance = match move glueResult {
      Option<InstanceKey>.Some {value} => value
      Option<InstanceKey>.None => {
        return run Shared.make<Result<Answer, NoRejection>>(Result.succeed<Answer, NoRejection>(memberSuccess(Value.LayoutUnsupported, Vector.make<Dependency>())))
      }
    }
    let identity = InstanceKey.identity(&instance)
    let owner = run DeclarationId.copyShared(&identity)
    let module = run ModuleId.copy(DeclarationId.moduleId(&owner))
    let location = match move run locationOfInstance(&mut self.resolver, &instance) {
      Option<InstanceLocation>.Some {value} => value
      Option<InstanceLocation>.None => {
        return run Shared.make<Result<Answer, NoRejection>>(Result.succeed<Answer, NoRejection>(memberRejected(
          run reject(&self.resolver, &module, RejectionCode.UnknownMember, span), Vector.make<Dependency>())))
      }
    }
    let name = run internBackendInstance(&mut self.resolver, &instance, false)
    let answer = run demandRaw(&mut self.resolver, &mut self.query, Key {
      family: Family.Mir, module: location.module, name: name, declaration: location.declaration, member: instanceMember(&instance), external: false,
    }, span)
    run recordRoot(&mut request.*, Family.Mir, &module, b"", &answer)
    return run anchorCanonicalAnswer(&mut self.resolver, &answer, sourceOwner, span)
  }
  /// Demands the MIR of one declaration's named instance for diagnostic sweeps. A declaration
  /// with open binders answers its open-instance gap. A declaration with requirements is lowered
  /// only under the providers its callers bind, so a sweep has no instance to demand: none.
  pub effect fn demandMirOf(self: &mut Self, request: &mut Request, declaration: &DeclarationId) -> Option<Shared<Result<Answer, NoRejection>>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
    let signature = run Semantic.demandSignatureOf(&mut self.*, &mut request.*, declaration)
    let requirements = run signatureRequirements(&signature)
    let provided = Shared.with<Row, bool>(&requirements, fn(row: &Row) -> bool {
      return Vector.length<Requirement>(&row.entries) > usize.ZERO || Vector.length<RowParameter>(&row.parameters) > usize.ZERO
        || Vector.length<RowSubtraction>(&row.subtractions) > usize.ZERO
    })
    if provided { return Option.none<Shared<Result<Answer, NoRejection>>>() }
    run selectRequest(&mut self.resolver, &request.*)
    let span = Span.make(usize.ZERO, usize.ZERO)
    let identity = run Shared.make<DeclarationId>(run DeclarationId.copy(declaration))
    let instance = run InstanceKey.named(&identity)
    let module = run ModuleId.copy(DeclarationId.moduleId(declaration))
    let location = match move run locationOfInstance(&mut self.resolver, &instance) {
      Option<InstanceLocation>.Some {value} => value
      Option<InstanceLocation>.None => {
        return Option.some<Shared<Result<Answer, NoRejection>>>(run Shared.make<Result<Answer, NoRejection>>(Result.succeed<Answer, NoRejection>(memberRejected(
          run reject(&self.resolver, &module, RejectionCode.UnknownMember, span), Vector.make<Dependency>()))))
      }
    }
    let name = run internBackendInstance(&mut self.resolver, &instance, false)
    let answer = run demandRaw(&mut self.resolver, &mut self.query, Key {
      family: Family.Mir, module: location.module, name: name, declaration: location.declaration, member: instanceMember(&instance), external: false,
    }, span)
    run recordRoot(&mut request.*, Family.Mir, &module, b"", &answer)
    return Option.some<Shared<Result<Answer, NoRejection>>>(move answer)
  }
  /// Demands MIR for one complete semantic environment before runtime identity can be reused.
  /// Header validation and admission precede the exact-application query cache; target callees
  /// remain body-lazy. The instance key numbers the application's caller regions canonically;
  /// `'static` and region sharing remain exact evidence even when emitted instructions coincide.
  pub effect fn demandApplicationMir(self: &mut Self, request: &mut Request, application: &Application) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
    let declaredModule = Application.bodyDeclaration(application)
    let module = run ModuleId.copy(DeclarationId.moduleId(declaredModule))
    let span = Span.make(usize.ZERO, usize.ZERO)
    let checked = run Semantic.validateApplication(&mut self.*, &mut request.*, application, &module, span)
    let environment = match move checked {
      Result<Application, Shared<Rejection>>.Success {value} => move value
      Result<Application, Shared<Rejection>>.Failure {error} => {
        return run Shared.make<Result<Answer, NoRejection>>(Result.succeed<Answer, NoRejection>(memberRejected(move error, Vector.make<Dependency>())))
      }
    }
    let mut admission = Admission.make()
    let admitted = run Admission.enter(&mut admission, &environment, Edge.Direct)
    let open = match move admitted { Decision.Open => true _ => false }
    if open {
      let identity = run Shared.make<DeclarationId>(run DeclarationId.copy(Application.bodyDeclaration(&environment)))
      return run Shared.make<Result<Answer, NoRejection>>(Result.succeed<Answer, NoRejection>(memberSuccess(
        Value.Unsupported {gap: run Shared.make<BackendGap>(BackendGap.make(GapCode.OpenInstance, &identity, span))}, Vector.make<Dependency>())))
    }
    let instance = match move run InstanceKey.function(move environment) {
      Result<InstanceKey, CanonicalizationFailure>.Success {value: canonicalKey} => move canonicalKey
      Result<InstanceKey, CanonicalizationFailure>.Failure {..} => {
        return run Shared.make<Result<Answer, NoRejection>>(Result.succeed<Answer, NoRejection>(memberRejected(
          run canonicalRejection(&mut self.resolver, declaredModule, span), Vector.make<Dependency>())))
      }
    }
    let found = run locationOfInstance(&mut self.resolver, &instance)
    let location = match move found {
      Option<InstanceLocation>.Some {value} => value
      _ => { return run Shared.make<Result<Answer, NoRejection>>(Result.succeed<Answer, NoRejection>(memberRejected(
        run reject(&self.resolver, &module, RejectionCode.UnknownMember, span), Vector.make<Dependency>()))) }
    }
    let name = run internBackendInstance(&mut self.resolver, &instance, false)
    let answer = run demandRaw(&mut self.resolver, &mut self.query, Key {
      family: Family.Mir, module: location.module, name: name, declaration: location.declaration, member: usize.ZERO, external: false,
    }, span)
    run recordRoot(&mut request.*, Family.Mir, &module, b"", &answer)
    return run anchorCanonicalAnswer(&mut self.resolver, &answer, declaredModule, span)
  }
  /// Demands MIR for one exact reached instance, such as a call's callee key with its providers, for
  /// a program that does or does not observe diagnostics (failure observer note N1).
  /// `sourceOwner` and `span` identify the authentic requester, independently of a generated key.
  /// A zero span requests that actual owner's original header; it is never a published refusal.
  pub effect fn demandInstanceMir(self: &mut Self, request: &mut Request, instance: &InstanceKey, sourceOwner: &DeclarationId, span: Span, observing: bool) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
    let declared = run DeclarationId.copyShared(&InstanceKey.identity(instance))
    let module = run ModuleId.copy(DeclarationId.moduleId(&declared))
    let querySpan = Span.make(usize.ZERO, usize.ZERO)
    let location = match move run locationOfInstance(&mut self.resolver, instance) {
      Option<InstanceLocation>.Some {value} => value
      _ => { return run Shared.make<Result<Answer, NoRejection>>(Result.succeed<Answer, NoRejection>(memberRejected(
        run reject(&self.resolver, &module, RejectionCode.UnknownMember, querySpan), Vector.make<Dependency>()))) }
    }
    let name = run internBackendInstance(&mut self.resolver, instance, observing)
    let answer = run demandRaw(&mut self.resolver, &mut self.query, Key {
      family: Family.Mir, module: location.module, name: name, declaration: location.declaration, member: instanceMember(instance), external: false,
    }, querySpan)
    run recordRoot(&mut request.*, Family.Mir, &module, b"", &answer)
    return run anchorCanonicalAnswer(&mut self.resolver, &answer, sourceOwner, span)
  }
  /// Source-validates one instance and returns its immutable content-keyed LLVM answer.
  /// The source owner/span belong to its requester; generated instance identity is not source.
  /// A zero span asks for the actual requesting owner's authored header.
  pub effect fn demandInstanceText(
    self: &mut Self,
    request: &mut Request,
    instance: &InstanceKey,
    sourceOwner: &DeclarationId,
    span: Span,
    observing: bool,
  ) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator {
    run selectRequest(&mut self.resolver, &request.*)
    let declared = run DeclarationId.copyShared(&InstanceKey.identity(instance))
    let module = run ModuleId.copy(DeclarationId.moduleId(&declared))
    // The glue of a sealed core belongs to no source module.
    let sealed = SealedCore.declarationCore(&declared)
    if let Option<SealedKind>.None = move sealed { drop run internModule(&mut self.resolver, &module) }
    let querySpan = Span.make(usize.ZERO, usize.ZERO)
    let location = match move run locationOfInstance(&mut self.resolver, instance) {
      Option<InstanceLocation>.Some {value} => value
      _ => {
        return run Shared.make<Result<Answer, NoRejection>>(
          Result.succeed<Answer, NoRejection>(
            memberRejected(
              run reject(&self.resolver, &module, RejectionCode.UnknownMember, querySpan),
              Vector.make<Dependency>(),
            ),
          ),
        )
      }
    }
    let name = run internBackendInstance(&mut self.resolver, instance, observing)
    let key = Key {
      family: Family.EmissionInputs,
      module: location.module,
      name: name,
      declaration: location.declaration,
      member: instanceMember(instance),
      external: false,
    }
    let prepared = run demandRaw(&mut self.resolver, &mut self.query, key, querySpan)
    run recordRoot(&mut request.*, Family.EmissionInputs, &module, b"", &prepared)
    let answer = run demandPreparedText(&mut self.resolver, &mut self.query, key, &prepared)
    run recordRoot(&mut request.*, Family.LlvmText, &module, b"", &answer)
    return run anchorCanonicalAnswer(&mut self.resolver, &answer, sourceOwner, span)
  }
  /// Immutable definition arena; positions are published only by completed LLVM text queries.
  pub fn instanceTexts(self: &Self) -> &[InstanceDefinition] {
    return Vector.asSlice<InstanceDefinition>(&self.resolver.llvmValues)
  }
  /// Demands the selected residual body of one function under its complete semantic application.
  ///
  /// # Details
  /// The answer types only the residual its selection pass chose, with static results embedded.
  /// Equal semantic applications share one selected body; the declaration's abstract body is a
  /// different query and is never used for a function with static work.
  pub effect fn demandSelectedBody(self: &mut Self, request: &mut Request, application: &Application) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
    run selectRequest(&mut self.resolver, &request.*)
    let declared = Application.bodyDeclaration(application)
    let module = run ModuleId.copy(DeclarationId.moduleId(declared))
    let moduleOrdinal = run internModule(&mut self.resolver, &module)
    let identity = run Shared.make<DeclarationId>(run DeclarationId.copy(declared))
    let found = run ordinalOfIdentity(&mut self.resolver, &module, &identity)
    let ordinal = match move found {
      Option<usize>.Some {value} => value
      _ => {
        return run Shared.make<Result<Answer, NoRejection>>(Result.succeed<Answer, NoRejection>(memberRejected(
          run reject(&self.resolver, &module, RejectionCode.UnknownMember, Span.make(usize.ZERO, usize.ZERO)), Vector.make<Dependency>())))
      }
    }
    let interned = run internSelectedApplication(&mut self.resolver, application)
    let answer = run demandRaw(&mut self.resolver, &mut self.query, Key {
      family: Family.Body, module: moduleOrdinal, name: usize.ZERO, declaration: ordinal, member: interned + usize.ONE, external: false,
    }, Span.make(usize.ZERO, usize.ZERO))
    run recordRoot(&mut request.*, Family.Body, &module, b"", &answer)
    return move answer
  }
  /// Demands the backend-neutral body graph for one named function.
  pub effect fn demandMir(self: &mut Self, request: &mut Request, module: &ModuleId, name: &[u8]) -> Shared<
    Result<Answer, NoRejection>,
  > ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
    run selectRequest(&mut self.resolver, &request.*)
    let answer = run demandNamed(&mut self.resolver, &mut self.query, module, name, Family.Mir)
    run recordRoot(&mut request.*, Family.Mir, module, name, &answer)
    return move answer
  }
  /// Demands backend-neutral target layout facts for one runtime type.
  pub effect fn demandLayout(self: &mut Self, request: &mut Request, module: &ModuleId, ty: &Shared<Type>) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
    run selectRequest(&mut self.resolver, &request.*)
    let moduleOrdinal = run internModule(&mut self.resolver, module)
    let application = run internLayoutType(&mut self.resolver, ty)
    let answer = run demandRaw(&mut self.resolver, &mut self.query, Key {
      family: Family.Layout, module: moduleOrdinal, name: application,
      declaration: usize.ZERO, member: usize.ZERO, external: false,
    }, Span.make(usize.ZERO, usize.ZERO))
    run recordRoot(&mut request.*, Family.Layout, module, b"", &answer)
    return move answer
  }
  /// Returns an owned handle to one cached layout answer.
  pub fn layoutAt(self: &Self, index: usize) -> Option<Shared<BackendLayout>> {
    let layouts = Vector.asSlice<Shared<BackendLayout>>(&self.resolver.layoutValues)
    if index >= layouts.length { return Option.none<Shared<BackendLayout>>() }
    return Option.some<Shared<BackendLayout>>(Shared.clone<BackendLayout>(&layouts[index]))
  }
  /// Borrows a MIR graph named by a `Value.Mir` answer from this store.
  pub fn mirAt(self: &Self, index: usize) -> Option<&MirFunction> {
    let functions = Vector.asSlice<MirFunction>(&self.resolver.mirValues)
    if index >= functions.length {
      return Option.none<&MirFunction>()
    }
    return Option.some<&MirFunction>(&functions[index])
  }
  /// Builds a finite reachable-key closure rooted at one application, as a build does at a
  /// changing-static edge. Only certified evidence admits such a chain; `limit` bounds its nodes.
  /// The root is validated like any demanded application; its incoming edge is Direct in the
  /// root's module at the authentic original header, with no caller or ancestors.
  pub effect fn closeStaticChain(self: &mut Self, request: &mut Request, root: &Application, limit: usize) -> StaticClosure
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator {
    run selectRequest(&mut self.resolver, &request.*)
    let module = run ModuleId.copy(DeclarationId.moduleId(Application.bodyDeclaration(root)))
    let span = run authoredRequestSpan(&mut self.resolver, Application.bodyDeclaration(root), Span.make(usize.ZERO, usize.ZERO))
    let checked = run Semantic.validateApplication(&mut self.*, &mut request.*, root, &module, span)
    let validated = match move checked {
      Result<Application, Shared<Rejection>>.Success {value} => value
      Result<Application, Shared<Rejection>>.Failure {error} => { return StaticClosure.Rejected {diagnostic: move error} }
    }
    let incoming = ClosureIncoming {caller: Option.none<Application>(), edge: Edge.Direct, module: move module, span: span}
    let ancestors = Admission.make()
    return run closeChain(&mut self.*, &ancestors, &validated, move incoming, limit)
  }
  /// Demands only reached instances, then joins their definitions in content-symbol order.
  /// `closureNodes` bounds each changing-static closure transaction; it is a resource control.
  pub effect fn buildMain(self: &mut Self, request: &mut Request, module: &ModuleId, closureNodes: usize) -> BackendBuild
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator {
    run selectRequest(&mut self.resolver, &request.*)
    // A root lookup observes governing conditions without a dependent answer.
    let mut rootConditions = Vector.make<Dependency>()
    let selectedSelection = run select(&mut self.resolver, &mut self.query, &mut rootConditions, module, b"main", false)
    let selected = match move selectedSelection {
      Result<Selection, Shared<Rejection>>.Success {value: selectedValue} => selectedValue
      Result<Selection, Shared<Rejection>>.Failure {error} => {
        return refusedBuild(move error)
      }
    }
    if selected.count != usize.ONE || selected.kind != CandidateKind.Declaration {
      return refusedBuild(run reject(&self.resolver, module, RejectionCode.UnknownName, selected.span))
    }
    let declared = run declarationAt(&mut self.resolver, module, selected.declaration)
    let main = match move declared {
      Option<DeclarationId>.Some {value} => run Shared.make<DeclarationId>(move value)
      Option<DeclarationId>.None => {
        return refusedBuild(run reject(&self.resolver, module, RejectionCode.UnknownName, selected.span))
      }
    }
    let signature = run demandNamed(
      &mut self.resolver,
      &mut self.query,
      module,
      b"main",
      Family.Signature,
    )
    run recordRoot(&mut request.*, Family.Signature, module, b"main", &signature)
    let failure = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
      &signature,
      answerRejection,
    )
    if let Option<Shared<Rejection>>.Some {value} = move failure {
      let code = Shared.with<Rejection, RejectionCode>(
        &value,
        fn(rejection: &Rejection) -> RejectionCode {
          return rejection.code
        },
      )
      let mut coverageGap = BackendGap.forRejection(code)
      if code == RejectionCode.Unsupported { coverageGap = Option.some<GapCode>(GapCode.SignatureForm) }
      if let Option<GapCode>.Some {value: gapCode} = move coverageGap {
        let mut gaps = Vector.make<Shared<BackendGap>>()
        run Vector.append<Shared<BackendGap>>(
          &mut gaps,
          run Shared.make<BackendGap>(BackendGap.fromRejection(gapCode, &main, &value)),
        )
        return BackendBuild.Unsupported {gaps: move gaps}
      }
      return refusedBuild(move value)
    }
    let mut roots = Vector.make<BuildRoot>()
    run Vector.append<BuildRoot>(&mut roots, BuildRoot {key: InstanceKey.Entry {main: move main}, span: selected.span})
    // The application's own C exports are roots beside `main`, so foreign code can call them.
    let mut gaps = Vector.make<Shared<BackendGap>>()
    let exported = run exportCandidates(&mut self.resolver, module)
    if let Option<Vector<ExportCandidate>>.Some {value: listed} = move exported {
      let refused = run Semantic.rootExports(&mut self.*, &mut request.*, module, &listed, &mut roots, &mut gaps)
      if let Option<Shared<Rejection>>.Some {value} = move refused {
        return refusedBuild(move value)
      }
    }
    if Vector.length<Shared<BackendGap>>(&gaps) > usize.ZERO {
      return BackendBuild.Unsupported {gaps: move gaps}
    }
    return run Semantic.buildFrom(&mut self.*, module, Vector.asSlice<BuildRoot>(&roots), selected.span, closureNodes, false,
      &Option.none<FrameSelection>())
  }
  /// Builds an artifact whose roots are the active C exports of the selected runtime source. The
  /// request's application module is what `import Intrinsic.application` binds inside it.
  /// Demands only reached instances, then joins their definitions in content-symbol order.
  pub effect fn buildRuntime(self: &mut Self, request: &mut Request, runtime: &ModuleId, closureNodes: usize) -> BackendBuild
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator {
    run selectRequest(&mut self.resolver, &request.*)
    let origin = Span.make(usize.ZERO, usize.ZERO)
    let listed = match move run exportCandidates(&mut self.resolver, runtime) {
      Option<Vector<ExportCandidate>>.Some {value} => move value
      Option<Vector<ExportCandidate>>.None => {
        return refusedBuild(run reject(&self.resolver, runtime, RejectionCode.MissingModule, origin))
      }
    }
    let mut roots = Vector.make<BuildRoot>()
    let mut gaps = Vector.make<Shared<BackendGap>>()
    let refused = run Semantic.rootExports(&mut self.*, &mut request.*, runtime, &listed, &mut roots, &mut gaps)
    if let Option<Shared<Rejection>>.Some {value} = move refused {
      return refusedBuild(move value)
    }
    if Vector.length<Shared<BackendGap>>(&gaps) > usize.ZERO {
      return BackendBuild.Unsupported {gaps: move gaps}
    }
    // A runtime whose arms select no export for this target provides no artifact root.
    if Vector.length<BuildRoot>(&roots) == usize.ZERO {
      return refusedBuild(run reject(&self.resolver, runtime, RejectionCode.UnknownName, origin))
    }
    return run Semantic.buildFrom(&mut self.*, runtime, Vector.asSlice<BuildRoot>(&roots), origin, closureNodes, false,
      &Option.none<FrameSelection>())
  }
  // Roots every active C export `module` declares. Signature gaps are collected beside the roots;
  // any other refusal is returned.
  effect fn rootExports(self: &mut Self, request: &mut Request, module: &ModuleId, listed: &Vector<ExportCandidate>,
    roots: &mut Vector<BuildRoot>, gaps: &mut Vector<Shared<BackendGap>>) -> Option<Shared<Rejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator {
    let moduleOrdinal = run internModule(&mut self.resolver, module)
    // Root lookups observe governing conditions without a dependent answer.
    let mut rootConditions = Vector.make<Dependency>()
    let candidates = Vector.asSlice<ExportCandidate>(listed)
    let mut at = usize.ZERO
    while at < candidates.length {
      let candidate = &candidates[at]
      at = at + usize.ONE
      let active = run available(&mut self.resolver, &mut self.query, &mut rootConditions, module, candidate.declaration, candidate.span)
      let present = match move active {
        Result<bool, Shared<Rejection>>.Success {value} => value
        Result<bool, Shared<Rejection>>.Failure {error} => { return Option.some<Shared<Rejection>>(move error) }
      }
      if !present { continue }
      let declared = run declarationAt(&mut self.resolver, module, candidate.declaration)
      let function = match move declared {
        Option<DeclarationId>.Some {value} => run Shared.make<DeclarationId>(move value)
        Option<DeclarationId>.None => {
          return Option.some<Shared<Rejection>>(run reject(&self.resolver, module, RejectionCode.UnknownName, candidate.span))
        }
      }
      let signature = run demandRaw(
        &mut self.resolver,
        &mut self.query,
        Key {family: Family.Signature, module: moduleOrdinal, name: usize.ZERO, declaration: candidate.declaration, member: usize.ZERO, external: false},
        candidate.span,
      )
      run recordRoot(&mut request.*, Family.Signature, module, Bytes.asSlice(&candidate.name), &signature)
      let failure = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(&signature, answerRejection)
      if let Option<Shared<Rejection>>.Some {value} = move failure {
        let code = Shared.with<Rejection, RejectionCode>(&value, fn(rejection: &Rejection) -> RejectionCode {
          return rejection.code
        })
        let mut coverageGap = BackendGap.forRejection(code)
        if code == RejectionCode.Unsupported { coverageGap = Option.some<GapCode>(GapCode.SignatureForm) }
        if let Option<GapCode>.Some {value: gapCode} = move coverageGap {
          run Vector.append<Shared<BackendGap>>(&mut gaps.*, run Shared.make<BackendGap>(BackendGap.fromRejection(gapCode, &function, &value)))
          continue
        }
        return Option.some<Shared<Rejection>>(move value)
      }
      let symbol = run Shared.make<Bytes>(run Bytes.copy(Bytes.asSlice(&candidate.symbol)))
      run Vector.append<BuildRoot>(&mut roots.*, BuildRoot {key: InstanceKey.Export {function: move function, symbol: move symbol}, span: candidate.span})
    }
    return Option.none<Shared<Rejection>>()
  }
  // Walks the instance graph from the roots. A program that runs any `observeDiagnostics` scope is
  // walked again with every function observing diagnostics (failure observer note N1). A program
  // that reaches a suspension boundary is walked again with its closed suspendable set and the
  // selected execution-storage exports as further roots (SUSP private lowering model).
  effect fn buildFrom(self: &mut Self, module: &ModuleId, roots: &[BuildRoot], entrySpan: Span, closureNodes: usize,
    observing: bool, frames: &Option<FrameSelection>) -> BackendBuild
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator {
    let mut pending = Vector.make<BackendVisit>()
    let mut rootAt = roots.length
    // The worklist is a stack: push in reverse so roots are entered in their listed order.
    while rootAt > usize.ZERO {
      rootAt = rootAt - usize.ONE
      run Vector.append<BackendVisit>(
        &mut pending,
        BackendVisit.Enter {
          key: InstanceKey.copy(&roots[rootAt].key),
          edge: Edge.Direct,
          span: roots[rootAt].span,
          module: run ModuleId.copy(module),
          cleanup: Option.none<Shared<Type>>(),
        },
      )
    }
    let mut observes = false
    let mut summaries = Vector.make<SuspensionSummary>()
    let mut admission = Admission.make()
    // Applications admitted by a finite closure certificate during this build.
    let mut certified = Vector.make<Application>()
    let mut certifiedLookup = InternIndex.make()
    let mut visited = Vector.make<InstanceKey>()
    let mut visitedLookup = InternIndex.make()
    let mut emitted = Vector.make<CollectedText>()
    let mut gaps = Vector.make<Shared<BackendGap>>()
    let mut refusals = Vector.make<Shared<Rejection>>()
    // Each cleanup root's owned-structure answers reached during this build.
    let mut cleanupAnswers = Vector.make<CleanupAnswer>()
    while Vector.length<BackendVisit>(&pending) > usize.ZERO {
      let visit = match move Vector.pop<BackendVisit>(&mut pending) {
        Option<BackendVisit>.Some {value} => move value
        Option<BackendVisit>.None => {
          break
        }
      }
      let entered = match move visit {
        BackendVisit.Leave => {
          Admission.leave(&mut admission)
          continue
        }
        BackendVisit.Enter {key: instance, edge, span, module: sourceModule, cleanup} => BackendRequest {
          key: move instance,
          edge: move edge,
          span: span,
          module: move sourceModule,
          cleanup: move cleanup,
        }
      }
      let instance = move entered.key
      let mut leave = false
      // Entry shims and drop glue carry no application to admit; only function instances specialize.
      if let Option<Shared<Application>>.Some {..} = move InstanceKey.application(&instance) {
        let application = run InstanceKey.selected(&instance)
        // A Drop hook drop glue reaches is selected by the cleanup of the value its run started from.
        let mut reaching = move entered.edge
        if let Option<Shared<Type>>.Some {value: owner} = &entered.cleanup {
          reaching = Edge.Cleanup {owner: Shared.clone<Type>(&owner)}
        }
        let enteredEdge = Edge.copy(&reaching)
        let decision = run Admission.enter(&mut admission, &application, move reaching)
        match move decision {
          Decision.Entered => {
            leave = true
          }
          Decision.ChangingStatic {..} => {
            let mut admitted = false
            let known = Vector.asSlice<Application>(&certified)
            let mut knownAt = InternIndex.first(&certifiedLookup, Application.hash(&application))
            while knownAt != usize.MAX {
              if run Application.equals(&known[knownAt], &application) {
                admitted = true
                break
              }
              knownAt = InternIndex.after(&certifiedLookup, knownAt)
            }
            if !admitted {
              let ancestorPath = run Admission.path(&admission)
              let ancestorSlice = Vector.asSlice<Application>(&ancestorPath)
              let mut caller = Option.none<Application>()
              if ancestorSlice.length > usize.ZERO {
                caller = Option.some<Application>(run Application.copy(&ancestorSlice[ancestorSlice.length - usize.ONE]))
              }
              let incoming = ClosureIncoming {caller: move caller, edge: Edge.copy(&enteredEdge), module: run ModuleId.copy(&entered.module), span: entered.span}
              let closure = run closeChain(&mut self.*, &admission, &application, move incoming, closureNodes)
              match move closure {
                StaticClosure.Certified {evidence} => {
                  let reached = Vector.asSlice<Application>(&evidence.nodes)
                  let mut reachedAt = usize.ZERO
                  while reachedAt < reached.length {
                    run Vector.append<Application>(&mut certified, run Application.copy(&reached[reachedAt]))
                    run InternIndex.record(&mut certifiedLookup, Application.hash(&reached[reachedAt]))
                    reachedAt = reachedAt + usize.ONE
                  }
                }
                StaticClosure.NotProven {diagnostic} => {
                  run Vector.append<Shared<Rejection>>(&mut refusals, move diagnostic)
                  continue
                }
                StaticClosure.Rejected {diagnostic} => {
                  run Vector.append<Shared<Rejection>>(&mut refusals, move diagnostic)
                  continue
                }
                StaticClosure.Unsupported {gaps: found} => {
                  let reached = Vector.asSlice<Shared<BackendGap>>(&found)
                  let mut reachedAt = usize.ZERO
                  while reachedAt < reached.length {
                    run Vector.append<Shared<BackendGap>>(&mut gaps, Shared.clone<BackendGap>(&reached[reachedAt]))
                    reachedAt = reachedAt + usize.ONE
                  }
                  continue
                }
              }
            }
            run Admission.enterChain(&mut admission, &application, move enteredEdge)
            leave = true
          }
          Decision.Reused {..} => {}
          Decision.Open => {
            let identity = InstanceKey.identity(&instance)
            let diagnostic = run reject(&self.resolver, &entered.module, RejectionCode.Unsupported, entered.span)
            run Vector.append<Shared<BackendGap>>(
              &mut gaps,
              run Shared.make<BackendGap>(
                BackendGap.fromRejection(GapCode.OpenInstance, &identity, &diagnostic),
              ),
            )
            continue
          }
          Decision.Rejected {path} => {
            if !run cleanupAdmits(&mut self.resolver, &mut self.query, &mut cleanupAnswers, &admission, &application,
              &enteredEdge, Vector.asSlice<Application>(&path)) {
              run Vector.append<Shared<Rejection>>(&mut refusals,
                run rejectSpecialization(&entered.module, entered.span, Option.none<RelatedSite>(), move path))
              continue
            }
            run Admission.enterChain(&mut admission, &application, move enteredEdge)
            leave = true
          }
        }
      }
      if run applicationVisited(Vector.asSlice<InstanceKey>(&visited), &visitedLookup, &instance) {
        if leave {
          Admission.leave(&mut admission)
        }
        continue
      }
      if leave {
        run Vector.append<BackendVisit>(&mut pending, BackendVisit.Leave)
      }
      run Vector.append<InstanceKey>(&mut visited, InstanceKey.copy(&instance))
      run InternIndex.record(&mut visitedLookup, InstanceKey.runtimeHash(&instance))
      let found = run locationOfInstance(&mut self.resolver, &instance)
      let location = match move found {
        Option<InstanceLocation>.Some {value} => value
        Option<InstanceLocation>.None => {
          let identity = InstanceKey.identity(&instance)
          run Vector.append<Shared<BackendGap>>(&mut gaps,
            run Shared.make<BackendGap>(BackendGap.make(GapCode.CalleeModule, &identity, entered.span)))
          continue
        }
      }
      let member = instanceMember(&instance)
      // MIR is lowered once per mode; a suspendable instance's emission adds its frame facts.
      let lowered = run internBackendInstance(&mut self.resolver, &instance, observing)
      let mir = run demandRaw(
        &mut self.resolver,
        &mut self.query,
        Key {
          family: Family.Mir,
          module: location.module,
          name: lowered,
          declaration: location.declaration,
          member: member,
          external: false,
        },
        Span.make(usize.ZERO, usize.ZERO),
      )
      let mirIndex = Shared.with<Result<Answer, NoRejection>, Option<usize>>(&mir, answerMirIndex)
      let mut suspension = Option.none<CoroutineFacts>()
      if let Option<FrameSelection>.Some {value: selection} = &frames.* {
        if let Option<usize>.Some {value: loweredIndex} = &mirIndex {
          if run FrameSelection.contains(&selection, &instance) {
            let functions = Vector.asSlice<MirFunction>(&self.resolver.mirValues)
            suspension = Option.some<CoroutineFacts>(run FrameSelection.facts(&selection, &functions[loweredIndex]))
          }
        }
      }
      let backendName = run internBackendVariant(&mut self.resolver, &instance, observing, &suspension)
      let key = Key {
        family: Family.EmissionInputs,
        module: location.module,
        name: backendName,
        declaration: location.declaration,
        member: member,
        external: false,
      }
      let prepared = run demandRaw(
        &mut self.resolver,
        &mut self.query,
        key,
        Span.make(usize.ZERO, usize.ZERO),
      )
      let answer = run demandPreparedText(&mut self.resolver, &mut self.query, key, &prepared)
      let canonicalFailure = Shared.with<Result<Answer, NoRejection>, Option<CanonicalizationFailure>>(&answer, answerCanonicalizationFailure)
      if let Option<CanonicalizationFailure>.Some {..} = move canonicalFailure {
        run Vector.append<Shared<Rejection>>(&mut refusals, run reject(&self.resolver, &entered.module,
          RejectionCode.Unsupported, entered.span))
        continue
      }
      let rejected = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
        &answer,
        answerRejection,
      )
      if let Option<Shared<Rejection>>.Some {value} = move rejected {
        let code = Shared.with<Rejection, Option<GapCode>>(&value, fn(diagnostic: &Rejection) -> Option<GapCode> {
          return BackendGap.forRejection(diagnostic.code)
        })
        if let Option<GapCode>.Some {value: gapCode} = move code {
          let identity = InstanceKey.identity(&instance)
          run Vector.append<Shared<BackendGap>>(&mut gaps,
            run Shared.make<BackendGap>(BackendGap.fromRejection(gapCode, &identity, &value)))
          continue
        }
        run Vector.append<Shared<Rejection>>(&mut refusals, move value)
        continue
      }
      let gap = Shared.with<Result<Answer, NoRejection>, Option<Shared<BackendGap>>>(
        &answer,
        answerBackendGap,
      )
      // Validate every exact application before collecting its content answer.
      if let Option<Shared<BackendGap>>.Some {value} = move gap {
        run Vector.append<Shared<BackendGap>>(&mut gaps, move value)
        continue
      }
      let index = Shared.with<Result<Answer, NoRejection>, Option<usize>>(
        &answer,
        answerLlvmTextIndex,
      )
      if let Option<usize>.Some {value} = move index {
        run Vector.append<CollectedText>(
          &mut emitted,
          CollectedText {key: InstanceKey.copy(&instance), index: value},
        )
      }
      if let Option<usize>.Some {value: selectedMir} = move mirIndex {
        let functions = Vector.asSlice<MirFunction>(&self.resolver.mirValues)
        if functions[selectedMir].observes { observes = true }
        let callerModule = run resolvedModule(&self.resolver, location.module)
        run Vector.append<SuspensionSummary>(&mut summaries,
          run SuspensionSummary.make(&functions[selectedMir], &instance, &callerModule))
        // Drop glue passes its root on to the child glue and Drop hook it reaches; a function's
        // own references start outside any cleanup.
        let mut passed = Option.none<Shared<Type>>()
        let mut generatedGlue = false
        if let Option<Shared<Type>>.Some {value: glued} = move InstanceKey.glueType(&instance) {
          generatedGlue = true
          passed = Option.some<Shared<Type>>(move glued)
          if let Option<Shared<Type>>.Some {value: root} = &entered.cleanup {
            passed = Option.some<Shared<Type>>(Shared.clone<Type>(&root))
          }
        }
        let references = Vector.asSlice<MirReference>(&functions[selectedMir].references)
        let mut edge = usize.ZERO
        while edge < references.length {
          // Generated glue references have no authored origin. Carry the demand-local cleanup
          // request through every generated descendant instead of publishing its synthetic zero.
          let mut requestSpan = references[edge].origin.span
          let mut requestModule = run ModuleId.copy(&callerModule)
          if generatedGlue {
            requestSpan = entered.span
            requestModule = run ModuleId.copy(&entered.module)
          }
          run Vector.append<BackendVisit>(
            &mut pending,
            BackendVisit.Enter {
              key: InstanceKey.copy(&references[edge].key),
              edge: Edge.copy(&references[edge].edge),
              span: requestSpan,
              module: move requestModule,
              cleanup: copyCleanupRoot(&passed),
            },
          )
          edge = edge + usize.ONE
        }
      }
    }
    if Vector.length<Shared<Rejection>>(&refusals) > usize.ZERO {
      let first = Vector.remove<Shared<Rejection>>(&mut refusals, usize.ZERO)
      return BackendBuild.Rejected {first: move first, further: move refusals, gaps: move gaps}
    }
    if observes && !observing {
      return run Semantic.buildFrom(&mut self.*, module, roots, entrySpan, closureNodes, true, frames)
    }
    if Vector.length<Shared<BackendGap>>(&gaps) > usize.ZERO {
      return BackendBuild.Unsupported {gaps: move gaps}
    }
    let selecting = match &frames.* {
      Option<FrameSelection>.Some {..} => false
      Option<FrameSelection>.None => true
    }
    if selecting {
      let reached = Vector.asSlice<SuspensionSummary>(&summaries)
      let suspendable = run closeSuspendable(reached)
      let marked = Vector.asSlice<bool>(&suspendable)
      let mut first = usize.MAX
      let mut at = usize.ZERO
      while at < marked.length && first == usize.MAX {
        if marked[at] { first = at }
        at = at + usize.ONE
      }
      if first != usize.MAX {
        let mut origin = first
        at = usize.ZERO
        while at < reached.length {
          if let Option<Span>.Some {..} = &reached[at].boundary {
            origin = at
            break
          }
          at = at + usize.ONE
        }
        let boundary = match &reached[origin].boundary {
          Option<Span>.Some {value} => value
          Option<Span>.None => entrySpan
        }
        let storage = match &self.resolver.executionStorage {
          Option<ExecutionStorage>.Some {value} => run ExecutionStorage.copy(&value)
          Option<ExecutionStorage>.None => {
            return refusedBuild(run reject(&self.resolver, &reached[origin].module, RejectionCode.InvalidConfiguration, boundary))
          }
        }
        let mut selection = FrameSelection.make()
        at = usize.ZERO
        while at < marked.length {
          if marked[at] { run FrameSelection.include(&mut selection, &reached[at].key) }
          at = at + usize.ONE
        }
        let mut extended = Vector.make<BuildRoot>()
        at = usize.ZERO
        while at < roots.length {
          run Vector.append<BuildRoot>(&mut extended, BuildRoot {key: InstanceKey.copy(&roots[at].key), span: roots[at].span})
          at = at + usize.ONE
        }
        let exports = run storageExports(&mut self.resolver, &mut self.query, &storage)
        if Vector.length<StorageExport>(&exports) != 4 {
          return refusedBuild(run reject(&self.resolver, &reached[origin].module, RejectionCode.InvalidConfiguration, boundary))
        }
        let selected = Vector.asSlice<StorageExport>(&exports)
        at = usize.ZERO
        while at < selected.length {
          run FrameSelection.bind(&mut selection, run Bytes.copy(Bytes.asSlice(&selected[at].symbol)))
          run Vector.append<BuildRoot>(&mut extended, BuildRoot {key: InstanceKey.copy(&selected[at].key), span: boundary})
          at = at + usize.ONE
        }
        let chosen = Option.some<FrameSelection>(move selection)
        return run Semantic.buildFrom(&mut self.*, module, Vector.asSlice<BuildRoot>(&extended), entrySpan, closureNodes,
          observing, &chosen)
      }
    }
    return run assembleEmission(
      &self.resolver,
      Vector.asSlice<CollectedText>(&emitted),
      module,
      entrySpan,
    )
  }
}

// Whether one candidate lies within one cleanup root's owned structure (GEN-006), answered once
// per build.
struct CleanupAnswer {
  root: Shared<Type>
  candidate: Shared<Type>
  within: bool
}

fn copyCleanupRoot(root: &Option<Shared<Type>>) -> Option<Shared<Type>> {
  return match &root.* {
    Option<Shared<Type>>.Some {value} => Option.some<Shared<Type>>(Shared.clone<Type>(&value))
    Option<Shared<Type>>.None => Option.none<Shared<Type>>()
  }
}

// A re-entry the ordinary recursion guard rejects is admitted while it runs inside a Drop hook's
// cleanup and its type arguments stay within the cleanup root's finite owned structure (GEN-006,
// bootstrap `cleanupPermitsSpecialization`). The measure is replayed along the active path only
// when such a re-entry occurs; every argument other than a type argument stays runtime-equal.
effect fn cleanupAdmits(resolver: &mut Resolver, query: &mut Query<Word, Answer, NoRejection>,
  answers: &mut Vector<CleanupAnswer>, admission: &Admission, application: &Application, edge: &Edge,
  rejected: &[Application]) -> bool
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  if rejected.length == usize.ZERO || !run Application.sameNonTypeArguments(&rejected[usize.ZERO], application) {
    return false
  }
  let path = run Admission.path(admission)
  let edges = run Admission.edges(admission)
  let applications = Vector.asSlice<Application>(&path)
  let reached = Vector.asSlice<Edge>(&edges)
  let mut measure = Option.none<Shared<Type>>()
  let mut at = usize.ZERO
  while at < applications.length {
    let next = run cleanupTransition(&mut resolver.*, &mut query.*, &mut answers.*, &measure, &applications[at], &reached[at])
    measure = move next
    at = at + usize.ONE
  }
  let admitted = run cleanupTransition(&mut resolver.*, &mut query.*, &mut answers.*, &measure, application, edge)
  return match &admitted { Option<Shared<Type>>.Some {..} => true _ => false }
}

// The cleanup measure after one step (bootstrap `cleanupTransition`). A Drop hook selected from an
// unmeasured step starts a measure at the value whose cleanup selected it. Inside a measure, a hook
// keeps the root only while that value lies within the root's owned structure, and every step only
// while each of its type arguments does; otherwise the measure ends and the ordinary guard applies.
effect fn cleanupTransition(resolver: &mut Resolver, query: &mut Query<Word, Answer, NoRejection>,
  answers: &mut Vector<CleanupAnswer>, measure: &Option<Shared<Type>>, application: &Application, edge: &Edge)
  -> Option<Shared<Type>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let root = match &measure.* {
    Option<Shared<Type>>.Some {value} => Shared.clone<Type>(&value)
    Option<Shared<Type>>.None => {
      return match &edge.* {
        Edge.Cleanup {owner} => Option.some<Shared<Type>>(Shared.clone<Type>(&owner))
        _ => Option.none<Shared<Type>>()
      }
    }
  }
  if let Edge.Cleanup {owner} = &edge.* {
    if !run withinCleanup(&mut resolver.*, &mut query.*, &mut answers.*, &root, &owner) {
      return Option.none<Shared<Type>>()
    }
  }
  let bindings = run Application.bindings(application)
  let listed = Vector.asSlice<Binding>(&bindings)
  let mut at = usize.ZERO
  while at < listed.length {
    if let Argument.Type {value} = &listed[at].value {
      if !run withinCleanup(&mut resolver.*, &mut query.*, &mut answers.*, &root, &value) {
        return Option.none<Shared<Type>>()
      }
    }
    at = at + usize.ONE
  }
  return Option.some<Shared<Type>>(move root)
}

// Whether `candidate` is runtime-equal to the root or lies within its owned structure: a
// structural part, or a field of a nominal application within it.
effect fn withinCleanup(resolver: &mut Resolver, query: &mut Query<Word, Answer, NoRejection>,
  answers: &mut Vector<CleanupAnswer>, root: &Shared<Type>, candidate: &Shared<Type>) -> bool
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let known = Vector.asSlice<CleanupAnswer>(&answers.*)
  let mut at = usize.ZERO
  while at < known.length {
    if run Type.runtimeEqualsShared(&known[at].candidate, candidate) {
      if run Type.runtimeEqualsShared(&known[at].root, root) { return known[at].within }
    }
    at = at + usize.ONE
  }
  let mut unfolded = Vector.make<Shared<Type>>()
  let mut path = Vector.make<Shared<Type>>()
  let within = run searchCleanup(&mut resolver.*, &mut query.*, root, candidate, &mut unfolded, &mut path)
  run Vector.append<CleanupAnswer>(&mut answers.*, CleanupAnswer {root: Shared.clone<Type>(root),
    candidate: Shared.clone<Type>(candidate), within: within})
  return within
}

// Searches a value's structural parts and the fields of each nominal application within it. A
// nominal declaration unfolds beneath itself only at a strictly smaller instantiation, and each
// application unfolds once, so the search is finite.
effect fn searchCleanup(resolver: &mut Resolver, query: &mut Query<Word, Answer, NoRejection>, value: &Shared<Type>,
  candidate: &Shared<Type>, unfolded: &mut Vector<Shared<Type>>, path: &mut Vector<Shared<Type>>) -> bool
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  if run Type.runtimeEqualsShared(value, candidate) { return true }
  let children = run RuntimeType.inputs(value)
  let parts = Vector.asSlice<Shared<Type>>(&children)
  let mut at = usize.ZERO
  while at < parts.length {
    if run searchCleanup(&mut resolver.*, &mut query.*, &parts[at], candidate, &mut unfolded.*, &mut path.*) { return true }
    at = at + usize.ONE
  }
  if !Shared.with<Type, bool>(value, isNominalType) { return false }
  if run containsRuntimeType(Vector.asSlice<Shared<Type>>(&unfolded.*), value) { return false }
  let enclosing = Vector.asSlice<Shared<Type>>(&path.*)
  at = enclosing.length
  while at > usize.ZERO {
    at = at - usize.ONE
    if sameNominal(&enclosing[at], value) {
      if !run strictlySmallerNominal(value, &enclosing[at]) { return false }
      break
    }
  }
  run Vector.append<Shared<Type>>(&mut unfolded.*, Shared.clone<Type>(value))
  let mut dependencies = Vector.make<Dependency>()
  let fields = match move run nominalParts(&mut resolver.*, &mut query.*, &mut dependencies, value, Span.make(usize.ZERO, usize.ZERO)) {
    Result<Vector<Shared<Type>>, Shared<Rejection>>.Success {value: found} => move found
    Result<Vector<Shared<Type>>, Shared<Rejection>>.Failure {error} => {
      drop error
      return false
    }
  }
  let depth = Vector.length<Shared<Type>>(&path.*)
  run Vector.append<Shared<Type>>(&mut path.*, Shared.clone<Type>(value))
  let listed = Vector.asSlice<Shared<Type>>(&fields)
  let mut found = false
  at = usize.ZERO
  while at < listed.length && !found {
    found = run searchCleanup(&mut resolver.*, &mut query.*, &listed[at], candidate, &mut unfolded.*, &mut path.*)
    at = at + usize.ONE
  }
  Vector.truncate<Shared<Type>>(&mut path.*, depth)
  return found
}

effect fn containsRuntimeType(values: &[Shared<Type>], value: &Shared<Type>) -> bool ! OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < values.length {
    if run Type.runtimeEqualsShared(&values[at], value) { return true }
    at = at + usize.ONE
  }
  return false
}

// Every type argument of a same-declaration application equals the prior one's or lies strictly
// inside it, and at least one lies strictly inside.
effect fn strictlySmallerNominal(candidate: &Shared<Type>, prior: &Shared<Type>) -> bool ! OutOfMemoryError ? &mut Allocator {
  let next = run RuntimeType.inputs(candidate)
  let previous = run RuntimeType.inputs(prior)
  let second = Vector.asSlice<Shared<Type>>(&next)
  let first = Vector.asSlice<Shared<Type>>(&previous)
  if first.length != second.length { return false }
  let mut strict = false
  let mut at = usize.ZERO
  while at < first.length {
    if !run Type.runtimeEqualsShared(&first[at], &second[at]) {
      if !run Type.strictRuntimeSubterm(&second[at], &first[at]) { return false }
      strict = true
    }
    at = at + usize.ONE
  }
  return strict
}

fn slotCount(slots: &Vector<StaticSlot>) -> usize {
  return Vector.length<StaticSlot>(slots)
}

fn slotAt(slots: &Vector<StaticSlot>, at: usize) -> StaticSlot {
  let listed = Vector.asSlice<StaticSlot>(slots)
  return StaticSlot {ordinal: listed[at].ordinal, value: StaticValue.copy(&listed[at].value)}
}

struct CollectedText {
  key: InstanceKey
  index: usize
}

// Orders positions by their symbol bytes with a stable bottom-up merge, so emission ordering stays
// O(n log n) in the number of collected definitions.
effect fn symbolOrder(symbols: &[Bytes]) -> Vector<usize>
! OutOfMemoryError ? &mut Allocator {
  let mut order = Vector.make<usize>()
  let mut merged = Vector.make<usize>()
  let mut at = usize.ZERO
  while at < symbols.length {
    run Vector.append<usize>(&mut order, at)
    run Vector.append<usize>(&mut merged, at)
    at = at + usize.ONE
  }
  let mut width = usize.ONE
  while width < symbols.length {
    let source = Vector.asSlice<usize>(&order)
    let target = Vector.asMutSlice<usize>(&mut merged)
    let mut low = usize.ZERO
    while low < symbols.length {
      let mut middle = low + width
      if middle > symbols.length { middle = symbols.length }
      let mut high = middle + width
      if high > symbols.length { high = symbols.length }
      let mut left = low
      let mut right = middle
      let mut placed = low
      while placed < high {
        // Take the right run only when strictly earlier, so equal symbols keep their order.
        if right < high && (left == middle || bytesLess(Bytes.asSlice(&symbols[source[right]]),
          Bytes.asSlice(&symbols[source[left]]))) {
          target[placed] = source[right]
          right = right + usize.ONE
        } else {
          target[placed] = source[left]
          left = left + usize.ONE
        }
        placed = placed + usize.ONE
      }
      low = high
    }
    let settled = Vector.asMutSlice<usize>(&mut order)
    let next = Vector.asSlice<usize>(&merged)
    at = usize.ZERO
    while at < next.length {
      settled[at] = next[at]
      at = at + usize.ONE
    }
    width = width + width
  }
  return move order
}

effect fn emissionOrder(plan: &EmissionPlan) -> Vector<usize>
! OutOfMemoryError ? &mut Allocator {
  let entries = Vector.asSlice<EmissionIdentity>(&plan.identities)
  let mut symbols = Vector.make<Bytes>()
  let mut at = usize.ZERO
  while at < entries.length {
    run Vector.append<Bytes>(&mut symbols, run Bytes.copy(Bytes.asSlice(&entries[at].symbol)))
    at = at + usize.ONE
  }
  return run symbolOrder(Vector.asSlice<Bytes>(&symbols))
}

effect fn emissionDeclarations(resolver: &Resolver, reached: &[CollectedText]) -> Option<
  Vector<LlvmText.Declaration>,
> ! BackendGap | OutOfMemoryError ? &mut Allocator {
  let inputs = Vector.asSlice<InstanceDefinition>(&resolver.llvmValues)
  let mut declarations = Vector.make<LlvmText.Declaration>()
  let mut at = usize.ZERO
  while at < reached.length {
    let entries = Vector.asSlice<LlvmText.Declaration>(&inputs[reached[at].index].foreign)
    let mut entry = usize.ZERO
    while entry < entries.length {
      if !run appendDistinctForeignDeclaration(&mut declarations, &entries[entry]) {
        return Option.none<Vector<LlvmText.Declaration>>()
      }
      entry = entry + usize.ONE
    }
    at = at + usize.ONE
  }
  return Option.some<Vector<LlvmText.Declaration>>(move declarations)
}

effect fn appendEmissionDeclarations(text: &mut Bytes, declarations: &Vector<LlvmText.Declaration>) -> ()
! OutOfMemoryError ? &mut Allocator {
  let entries = Vector.asSlice<LlvmText.Declaration>(declarations)
  let mut symbols = Vector.make<Bytes>()
  let mut at = usize.ZERO
  while at < entries.length {
    run Vector.append<Bytes>(&mut symbols, run Bytes.copy(Bytes.asSlice(&entries[at].symbol)))
    at = at + usize.ONE
  }
  let order = run symbolOrder(Vector.asSlice<Bytes>(&symbols))
  run appendOrderedDeclarations(&mut text.*, declarations, Vector.asSlice<usize>(&order))
  return ()
}

effect fn appendOrderedDeclarations(text: &mut Bytes, declarations: &Vector<LlvmText.Declaration>, order: &[usize]) -> ()
! OutOfMemoryError ? &mut Allocator {
  let entries = Vector.asSlice<LlvmText.Declaration>(declarations)
  let mut at = usize.ZERO
  while at < order.length {
    run Bytes.append(&mut text.*, Bytes.asSlice(&entries[order[at]].text))
    at = at + usize.ONE
  }
  return ()
}

effect fn appendResolvedDefinitions(
  resolver: &Resolver,
  reached: &[CollectedText],
  plan: &EmissionPlan,
  order: &[usize],
  text: &mut Bytes,
) -> usize ! BackendGap | OutOfMemoryError ? &mut Allocator {
  let inputs = Vector.asSlice<InstanceDefinition>(&resolver.llvmValues)
  let identities = Vector.asSlice<EmissionIdentity>(&plan.identities)
  let mut unchecked = usize.ZERO
  let mut at = usize.ZERO
  while at < order.length {
    let identity = &identities[order[at]]
    let input = &inputs[reached[identity.representative].index]
    run Bytes.append(&mut text.*, Bytes.asSlice(&input.text))
    run Bytes.append(&mut text.*, b"\n")
    if !identity.safetyChecked { unchecked = unchecked + usize.ONE }
    at = at + usize.ONE
  }
  return unchecked
}

effect fn assembleEmission(
  resolver: &Resolver,
  reached: &[CollectedText],
  module: &ModuleId,
  span: Span,
) -> BackendBuild ! OutOfMemoryError ? &mut Allocator {
  let assembled = run Effect.result(assembleEmissionChecked(resolver, reached, module, span))
  return match move assembled {
    Result<BackendBuild, BackendGap | OutOfMemoryError>.Success {value} => move value
    Result<BackendBuild, BackendGap | OutOfMemoryError>.Failure {error} => match move error {
      BackendGap {code, owner, source} => {
        let mut gaps = Vector.make<Shared<BackendGap>>()
        run Vector.append<Shared<BackendGap>>(&mut gaps,
          run Shared.make<BackendGap>(BackendGap {code: code, owner: move owner, source: move source}))
        return BackendBuild.Unsupported {gaps: move gaps}
      }
      OutOfMemoryError {} => { fail OutOfMemoryError {} }
    }
  }
}

effect fn assembleEmissionChecked(
  resolver: &Resolver,
  reached: &[CollectedText],
  module: &ModuleId,
  span: Span,
) -> BackendBuild ! BackendGap | OutOfMemoryError ? &mut Allocator {
  let mut plan = EmissionPlan.empty()
  let values = Vector.asSlice<InstanceDefinition>(&resolver.llvmValues)
  let mut at = usize.ZERO
  while at < reached.length {
    let value = &values[reached[at].index]
    run EmissionPlan.include(
      &mut plan,
      &reached[at].key,
      Bytes.asSlice(&value.encoding),
      Bytes.asSlice(&value.symbol),
      value.safetyChecked,
    )
    at = at + usize.ONE
  }
  if EmissionPlan.hasSymbolConflict(&plan) {
    return refusedBuild(run reject(resolver, module, RejectionCode.InstanceSymbolConflict, span))
  }
  let foreign = match move run emissionDeclarations(resolver, reached) {
    Option<Vector<LlvmText.Declaration>>.Some {value} => move value
    Option<Vector<LlvmText.Declaration>>.None => {
      return refusedBuild(run reject(resolver, module, RejectionCode.ForeignSymbolConflict, span))
    }
  }
  let mut text = run LlvmText.declarations()
  run appendEmissionDeclarations(&mut text, &foreign)
  let order = run emissionOrder(&plan)
  let unchecked = run appendResolvedDefinitions(
    resolver,
    reached,
    &plan,
    Vector.asSlice<usize>(&order),
    &mut text,
  )
  return BackendBuild.Module {text: move text, uncheckedBodies: unchecked, plan: move plan}
}

effect fn applicationVisited(visited: &[InstanceKey], lookup: &InternIndex, instance: &InstanceKey) -> bool
! OutOfMemoryError
? &mut Allocator {
  let mut at = InternIndex.first(lookup, InstanceKey.runtimeHash(instance))
  while at != usize.MAX {
    if run InstanceKey.sameApplication(&visited[at], instance) {
      return true
    }
    at = InternIndex.after(lookup, at)
  }
  return false
}


// Returns false when a declaration with the same symbol but different text was already collected.
effect fn appendDistinctForeignDeclaration(
  declarations: &mut Vector<LlvmText.Declaration>,
  entry: &LlvmText.Declaration,
) -> bool ! OutOfMemoryError ? &mut Allocator {
  let prior = Vector.asSlice<LlvmText.Declaration>(&declarations.*)
  let mut seen = false
  let mut check = usize.ZERO
  while check < prior.length {
    if same(Bytes.asSlice(&prior[check].symbol), Bytes.asSlice(&entry.symbol)) {
      if !same(Bytes.asSlice(&prior[check].text), Bytes.asSlice(&entry.text)) {
        return false
      }
      seen = true
    }
    check = check + usize.ONE
  }
  if !seen {
    run Vector.append<LlvmText.Declaration>(
      &mut declarations.*,
      LlvmText.Declaration {
        symbol: run Bytes.copy(Bytes.asSlice(&entry.symbol)),
        text: run Bytes.copy(Bytes.asSlice(&entry.text)),
      },
    )
  }
  return true
}

union BackendVisit {
  /// `cleanup` is the root whose cleanup reached this instance through drop glue: the value a
  /// function dropped, carried unchanged through nested glue to the Drop hooks it selects.
  Enter {key: InstanceKey, edge: Edge, span: Span, module: ModuleId, cleanup: Option<Shared<Type>>},
  Leave,
}

// One artifact root: the generated C entry or one selected runtime C export, at its source span.
struct BuildRoot {
  key: InstanceKey
  span: Span
}

// One reached instance's suspension summary: the boundary it runs, if any, and its direct Silk
// callees.
struct SuspensionSummary {
  key: InstanceKey
  module: ModuleId
  boundary: Option<Span>
  callees: Vector<InstanceKey>
}

impl SuspensionSummary {
  effect fn make(function: &MirFunction, instance: &InstanceKey, module: &ModuleId) -> SuspensionSummary
  ! OutOfMemoryError ? &mut Allocator {
    let mut callees = Vector.make<InstanceKey>()
    let blocks = Vector.asSlice<MirBlock>(&function.blocks)
    let mut at = usize.ZERO
    while at < blocks.length {
      if let MirTerminator.Call {callee: MirCallee.Instance {key}, ..} = &blocks[at].terminator {
        run Vector.append<InstanceKey>(&mut callees, InstanceKey.copy(&key))
      }
      at = at + usize.ONE
    }
    let mut boundary = Option.none<Span>()
    if let Option<BodyOrigin>.Some {value: origin} = &function.suspension { boundary = Option.some<Span>(origin.span) }
    return SuspensionSummary {
      key: InstanceKey.copy(instance),
      module: run ModuleId.copy(module),
      boundary: move boundary,
      callees: move callees,
    }
  }
}

// Marks the reached instances that can suspend: each one that runs a boundary, then each one
// that calls a marked instance directly, to a fixed point. Fixed-linkage shims are never marked;
// they call a suspendable instance's ordinary symbol, which drives its frames.
effect fn closeSuspendable(summaries: &[SuspensionSummary]) -> Vector<bool> ! OutOfMemoryError ? &mut Allocator {
  let mut lookup = InternIndex.make()
  let mut marked = Vector.make<bool>()
  let mut at = usize.ZERO
  while at < summaries.length {
    run InternIndex.record(&mut lookup, InstanceKey.runtimeHash(&summaries[at].key))
    let origin = match &summaries[at].boundary {
      Option<Span>.Some {..} => true
      Option<Span>.None => false
    }
    run Vector.append<bool>(&mut marked, origin && !InstanceKey.fixedLinkage(&summaries[at].key))
    at = at + usize.ONE
  }
  // Each summary's callees as summary positions.
  let mut edges = Vector.make<Vector<usize>>()
  at = usize.ZERO
  while at < summaries.length {
    let mut targets = Vector.make<usize>()
    let callees = Vector.asSlice<InstanceKey>(&summaries[at].callees)
    let mut callee = usize.ZERO
    while callee < callees.length {
      let mut found = InternIndex.first(&lookup, InstanceKey.runtimeHash(&callees[callee]))
      while found != usize.MAX {
        if run InstanceKey.sameApplication(&summaries[found].key, &callees[callee]) {
          run Vector.append<usize>(&mut targets, found)
          break
        }
        found = InternIndex.after(&lookup, found)
      }
      callee = callee + usize.ONE
    }
    run Vector.append<Vector<usize>>(&mut edges, move targets)
    at = at + usize.ONE
  }
  let following = Vector.asSlice<Vector<usize>>(&edges)
  let mut changed = true
  while changed {
    changed = false
    at = usize.ZERO
    while at < summaries.length {
      let current = Vector.asSlice<bool>(&marked)
      if !current[at] && !InstanceKey.fixedLinkage(&summaries[at].key) {
        let targets = Vector.asSlice<usize>(&following[at])
        let mut edge = usize.ZERO
        let mut reaches = false
        while edge < targets.length {
          if current[targets[edge]] { reaches = true }
          edge = edge + usize.ONE
        }
        if reaches {
          let updated = Vector.asMutSlice<bool>(&mut marked)
          updated[at] = true
          changed = true
        }
      }
      at = at + usize.ONE
    }
  }
  return move marked
}

// The closed suspendable set of one build and the storage export symbols its frames use.
struct FrameSelection {
  suspendable: Vector<InstanceKey>
  lookup: InternIndex
  symbols: Vector<Bytes>
}

impl FrameSelection {
  fn make() -> FrameSelection {
    return FrameSelection {suspendable: Vector.make<InstanceKey>(), lookup: InternIndex.make(), symbols: Vector.make<Bytes>()}
  }

  effect fn include(self: &mut Self, key: &InstanceKey) -> () ! OutOfMemoryError ? &mut Allocator {
    run Vector.append<InstanceKey>(&mut self.suspendable, InstanceKey.copy(key))
    run InternIndex.record(&mut self.lookup, InstanceKey.runtimeHash(key))
  }

  // Binds the next operation in create, acquire, release, destroy order.
  effect fn bind(self: &mut Self, symbol: Bytes) -> () ! OutOfMemoryError ? &mut Allocator {
    run Vector.append<Bytes>(&mut self.symbols, move symbol)
  }

  effect fn contains(self: &Self, key: &InstanceKey) -> bool ! OutOfMemoryError ? &mut Allocator {
    let listed = Vector.asSlice<InstanceKey>(&self.suspendable)
    let mut at = InternIndex.first(&self.lookup, InstanceKey.runtimeHash(key))
    while at != usize.MAX {
      if run InstanceKey.sameApplication(&listed[at], key) { return true }
      at = InternIndex.after(&self.lookup, at)
    }
    return false
  }

  // The emission facts of one suspendable instance: its suspendable direct callees in first-call
  // order and the storage symbols.
  effect fn facts(self: &Self, function: &MirFunction) -> CoroutineFacts ! OutOfMemoryError ? &mut Allocator {
    let mut callees = Vector.make<InstanceKey>()
    let blocks = Vector.asSlice<MirBlock>(&function.blocks)
    let mut at = usize.ZERO
    while at < blocks.length {
      if let MirTerminator.Call {callee: MirCallee.Instance {key}, ..} = &blocks[at].terminator {
        if run FrameSelection.contains(self, &key) {
          let listed = Vector.asSlice<InstanceKey>(&callees)
          let mut seen = false
          let mut prior = usize.ZERO
          while prior < listed.length && !seen {
            seen = run InstanceKey.sameApplication(&listed[prior], &key)
            prior = prior + usize.ONE
          }
          if !seen { run Vector.append<InstanceKey>(&mut callees, InstanceKey.copy(&key)) }
        }
      }
      at = at + usize.ONE
    }
    let symbols = Vector.asSlice<Bytes>(&self.symbols)
    return CoroutineFacts {
      callees: move callees,
      create: run Bytes.copy(Bytes.asSlice(&symbols[usize.ZERO])),
      acquire: run Bytes.copy(Bytes.asSlice(&symbols[usize.ONE])),
      release: run Bytes.copy(Bytes.asSlice(&symbols[2])),
      destroy: run Bytes.copy(Bytes.asSlice(&symbols[3])),
    }
  }
}

// One selected storage operation's export root and its symbol.
struct StorageExport {
  key: InstanceKey
  symbol: Bytes
}

// The exports of the four storage operations in create, acquire, release, destroy order, stopping
// at the first binding that names no active C export.
effect fn storageExports(resolver: &mut Resolver, query: &mut Query<Word, Answer, NoRejection>, storage: &ExecutionStorage)
  -> Vector<StorageExport>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let mut found = Vector.make<StorageExport>()
  let created = run storageExport(&mut resolver.*, &mut query.*, &storage.create)
  if let Option<StorageExport>.Some {value} = move created { run Vector.append<StorageExport>(&mut found, move value) }
  else { return move found }
  let acquired = run storageExport(&mut resolver.*, &mut query.*, &storage.acquire)
  if let Option<StorageExport>.Some {value} = move acquired { run Vector.append<StorageExport>(&mut found, move value) }
  else { return move found }
  let released = run storageExport(&mut resolver.*, &mut query.*, &storage.release)
  if let Option<StorageExport>.Some {value} = move released { run Vector.append<StorageExport>(&mut found, move value) }
  else { return move found }
  let destroyed = run storageExport(&mut resolver.*, &mut query.*, &storage.destroy)
  if let Option<StorageExport>.Some {value} = move destroyed { run Vector.append<StorageExport>(&mut found, move value) }
  return move found
}

// Finds the active C export a storage binding names, without recognizing its module or name.
effect fn storageExport(resolver: &mut Resolver, query: &mut Query<Word, Answer, NoRejection>, binding: &StorageBinding)
  -> Option<StorageExport>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let exported = run exportCandidates(&mut resolver.*, &binding.module)
  let listed = match move exported {
    Option<Vector<ExportCandidate>>.Some {value} => move value
    Option<Vector<ExportCandidate>>.None => { return Option.none<StorageExport>() }
  }
  let candidates = Vector.asSlice<ExportCandidate>(&listed)
  let mut conditions = Vector.make<Dependency>()
  let mut at = usize.ZERO
  while at < candidates.length {
    let candidate = &candidates[at]
    at = at + usize.ONE
    if !same(Bytes.asSlice(&candidate.name), Bytes.asSlice(&binding.declaration)) { continue }
    let active = run available(&mut resolver.*, &mut query.*, &mut conditions, &binding.module, candidate.declaration, candidate.span)
    let present = match move active {
      Result<bool, Shared<Rejection>>.Success {value} => value
      Result<bool, Shared<Rejection>>.Failure {..} => false
    }
    if !present { continue }
    let declared = run declarationAt(&mut resolver.*, &binding.module, candidate.declaration)
    if let Option<DeclarationId>.Some {value} = move declared {
      let function = run Shared.make<DeclarationId>(move value)
      let symbol = run Shared.make<Bytes>(run Bytes.copy(Bytes.asSlice(&candidate.symbol)))
      return Option.some<StorageExport>(StorageExport {
        key: InstanceKey.Export {function: move function, symbol: move symbol},
        symbol: run Bytes.copy(Bytes.asSlice(&candidate.symbol)),
      })
    }
  }
  return Option.none<StorageExport>()
}

// One module-level C export a runtime source declares, before its arms are evaluated.
struct ExportCandidate {
  declaration: usize
  name: Bytes
  symbol: Bytes
  span: Span
}

// Lists every module-level `export "C" fn` of one source, or absence when the source is missing.
effect fn exportCandidates(resolver: &mut Resolver, module: &ModuleId) -> Option<Vector<ExportCandidate>>
! Cycle | OutOfMemoryError ? &mut Allocator {
  let answer = run source(&mut resolver.*, module)
  if let Option<&IndexedSource>.Some {value} = move sourceOf(&resolver.*, &answer, module) {
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(value))
    let hir = IndexedSource.authored(value)
    let mut found = Vector.make<ExportCandidate>()
    let mut at = usize.ZERO
    while at < declarations.length {
      let topLevel = match &declarations[at].parent {
        Option<usize>.None => true
        Option<usize>.Some {..} => false
      }
      if topLevel {
        if let Node.FunctionHeader {name, linkage, ..} = Module.node(hir, declarations[at].header) {
          if linkage.present {
            if let Node.Linkage {direction, symbol, ..} = Module.node(hir, linkage.id) {
              if direction == LinkageDirection.Export {
                let mut written = Bytes.make()
                if let Node.Name {text} = Module.node(hir, name) { written = run Bytes.copy(Module.text(hir, text)) }
                let mut linked = run Bytes.copy(Bytes.asSlice(&written))
                if symbol.present {
                  if let Node.TextLiteral {value: text} = Module.node(hir, symbol.id) { linked = run Bytes.copy(Module.text(hir, text)) }
                }
                run Vector.append<ExportCandidate>(&mut found, ExportCandidate {
                  declaration: at, name: move written, symbol: move linked, span: Module.span(hir, declarations[at].header),
                })
              }
            }
          }
        }
      }
      at = at + usize.ONE
    }
    return Option.some<Vector<ExportCandidate>>(move found)
  }
  return Option.none<Vector<ExportCandidate>>()
}

struct BackendRequest {
  key: InstanceKey
  edge: Edge
  span: Span
  module: ModuleId
  cleanup: Option<Shared<Type>>
}

// One demand-local finite-closure transaction rooted at a changing-static edge. It follows every
// lowered successor of every reached node, applies the non-static growth guard from the build's
// own ancestors, and certifies only a complete closed node set. Per-node answers are ordinary
// cached queries and never authorize closure on their own.
effect<'owner & 'env> fn closeChain<'owner, 'env>(semantic: &'owner mut Semantic, ancestors: &'env Admission, root: &'env Application, incoming: ClosureIncoming, limit: usize) -> StaticClosure
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let rootKey = match move run InstanceKey.function(run Application.copy(root)) {
    Result<InstanceKey, CanonicalizationFailure>.Success {value: canonicalKey} => move canonicalKey
    Result<InstanceKey, CanonicalizationFailure>.Failure {..} => {
      return StaticClosure.Rejected {diagnostic: run reject(&semantic.resolver,
        &incoming.module, RejectionCode.Unsupported, incoming.span)}
    }
  }
  let mut pending = Vector.make<ClosureVisit>()
  run Vector.append<ClosureVisit>(&mut pending, ClosureVisit.Enter {
    key: move rootKey, from: usize.MAX, edge: Edge.copy(&incoming.edge), module: run ModuleId.copy(&incoming.module), span: incoming.span,
  })
  let ancestorPath = run Admission.path(ancestors)
  let draft = ClosureDraft {
    pending: move pending,
    nodes: Vector.make<Application>(),
    edges: Vector.make<ClosureEdge>(),
    admission: run Admission.copy(ancestors),
  }
  // Semantic stays outside the resource: the transaction owns only its drafts.
  let use = effect fn(resource: &mut ClosureDraft) -> StaticClosure
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator {
    return run walkChain(&mut semantic.*, &mut resource.*, limit, &incoming, Vector.asSlice<Application>(&ancestorPath))
  }
  // Drafts never outlive the transaction: success copies the evidence out first.
  let release = effect fn(resource: &mut ClosureDraft) -> () {
    Vector.clear<ClosureVisit>(&mut resource.pending)
    Vector.clear<Application>(&mut resource.nodes)
    Vector.clear<ClosureEdge>(&mut resource.edges)
    return ()
  }
  return run Effect.useReleaseNonParking(move draft, move use, move release)
}

effect fn copyClosureIncoming(incoming: &ClosureIncoming) -> ClosureIncoming ! OutOfMemoryError ? &mut Allocator {
  let mut caller = Option.none<Application>()
  if let Option<Application>.Some {value} = &incoming.caller { caller = Option.some<Application>(run Application.copy(&value)) }
  return ClosureIncoming {caller: move caller, edge: Edge.copy(&incoming.edge), module: run ModuleId.copy(&incoming.module), span: incoming.span}
}

effect fn closureGap(code: GapCode, application: &Application, span: Span) -> StaticClosure ! OutOfMemoryError ? &mut Allocator {
  let identity = run Shared.make<DeclarationId>(run DeclarationId.copy(Application.bodyDeclaration(application)))
  let mut gaps = Vector.make<Shared<BackendGap>>()
  run Vector.append<Shared<BackendGap>>(&mut gaps, run Shared.make<BackendGap>(BackendGap.make(code, &identity, span)))
  return StaticClosure.Unsupported {gaps: move gaps}
}

// Admits one reached node of a closure transaction: the growth guard, deduplication, the node
// budget, and its complete lowered successors. A returned outcome ends the transaction.
effect fn enterChainNode(semantic: &mut Semantic, draft: &mut ClosureDraft, key: InstanceKey, from: usize, edge: Edge, module: ModuleId, span: Span, incoming: &ClosureIncoming, limit: usize) -> Option<StaticClosure>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  // Drop glue carries no static arguments, so it never extends a changing-static chain; the build
  // worklist reaches it and the hooks it calls.
  if let Option<Shared<Type>>.Some {..} = move InstanceKey.glueType(&key) { return Option.none<StaticClosure>() }
  let application = run InstanceKey.selected(&key)
  let root = RelatedSite {module: run ModuleId.copy(&incoming.module), span: incoming.span}
  let decision = run Admission.enter(&mut draft.admission, &application, Edge.copy(&edge))
  let mut leave = false
  match move decision {
    Decision.Entered => { leave = true }
    Decision.ChangingStatic {..} => {
      run Admission.enterChain(&mut draft.admission, &application, Edge.copy(&edge))
      leave = true
    }
    Decision.Reused {..} => {}
    Decision.Open => { return Option.some<StaticClosure>(run closureGap(GapCode.OpenInstance, &application, span)) }
    Decision.Rejected {path} => {
      return Option.some<StaticClosure>(StaticClosure.Rejected {diagnostic: run rejectSpecialization(&module, span, Option.some<RelatedSite>(move root), move path)})
    }
  }
  let known = Vector.asSlice<Application>(&draft.nodes)
  let mut found = usize.MAX
  let mut at = usize.ZERO
  while at < known.length {
    if run Application.equals(&known[at], &application) {
      found = at
      break
    }
    at = at + usize.ONE
  }
  if found != usize.MAX {
    if from != usize.MAX {
      run Vector.append<ClosureEdge>(&mut draft.edges, ClosureEdge {from: from, to: found, edge: Edge.copy(&edge), module: run ModuleId.copy(&module), span: span})
    }
    if leave { Admission.leave(&mut draft.admission) }
    return Option.none<StaticClosure>()
  }
  if Vector.length<Application>(&draft.nodes) >= limit {
    let mut path = run Admission.path(&draft.admission)
    if !leave { run Vector.append<Application>(&mut path, run Application.copy(&application)) }
    return Option.some<StaticClosure>(StaticClosure.NotProven {diagnostic: run rejectNotProven(&module, span, Option.some<RelatedSite>(move root), move path, limit)})
  }
  let node = Vector.length<Application>(&draft.nodes)
  run Vector.append<Application>(&mut draft.nodes, run Application.copy(&application))
  if from != usize.MAX {
    run Vector.append<ClosureEdge>(&mut draft.edges, ClosureEdge {from: from, to: node, edge: Edge.copy(&edge), module: run ModuleId.copy(&module), span: span})
  }
  let located = run locationOfInstance(&mut semantic.resolver, &key)
  let location = match move located {
    Option<InstanceLocation>.Some {value} => value
    Option<InstanceLocation>.None => { return Option.some<StaticClosure>(run closureGap(GapCode.CalleeModule, &application, span)) }
  }
  let backendName = run internBackendInstance(&mut semantic.resolver, &key, false)
  let instanceAnswer = run demandRaw(&mut semantic.resolver, &mut semantic.query, Key {
    family: Family.EmissionInputs, module: location.module, name: backendName, declaration: location.declaration, member: usize.ZERO, external: false,
  }, Span.make(usize.ZERO, usize.ZERO))
  let instanceCanonicalFailure = Shared.with<Result<Answer, NoRejection>, Option<CanonicalizationFailure>>(&instanceAnswer, answerCanonicalizationFailure)
  if let Option<CanonicalizationFailure>.Some {..} = move instanceCanonicalFailure {
    return Option.some<StaticClosure>(StaticClosure.Rejected {diagnostic: run reject(&semantic.resolver,
      &module, RejectionCode.Unsupported, span)})
  }
  let instanceRejection = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(&instanceAnswer, answerRejection)
  if let Option<Shared<Rejection>>.Some {value} = move instanceRejection { return Option.some<StaticClosure>(StaticClosure.Rejected {diagnostic: move value}) }
  let instanceGap = Shared.with<Result<Answer, NoRejection>, Option<Shared<BackendGap>>>(&instanceAnswer, answerBackendGap)
  if let Option<Shared<BackendGap>>.Some {value} = move instanceGap {
    let mut gaps = Vector.make<Shared<BackendGap>>()
    run Vector.append<Shared<BackendGap>>(&mut gaps, move value)
    return Option.some<StaticClosure>(StaticClosure.Unsupported {gaps: move gaps})
  }
  let mir = run demandRaw(&mut semantic.resolver, &mut semantic.query, Key {
    family: Family.Mir, module: location.module, name: backendName, declaration: location.declaration, member: usize.ZERO, external: false,
  }, Span.make(usize.ZERO, usize.ZERO))
  let canonicalFailure = Shared.with<Result<Answer, NoRejection>, Option<CanonicalizationFailure>>(&mir, answerCanonicalizationFailure)
  if let Option<CanonicalizationFailure>.Some {..} = move canonicalFailure {
    return Option.some<StaticClosure>(StaticClosure.Rejected {diagnostic: run reject(&semantic.resolver,
      &module, RejectionCode.Unsupported, span)})
  }
  let mirRejection = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(&mir, answerRejection)
  if let Option<Shared<Rejection>>.Some {value} = move mirRejection { return Option.some<StaticClosure>(StaticClosure.Rejected {diagnostic: move value}) }
  let mirGap = Shared.with<Result<Answer, NoRejection>, Option<Shared<BackendGap>>>(&mir, answerBackendGap)
  if let Option<Shared<BackendGap>>.Some {value} = move mirGap {
    let mut gaps = Vector.make<Shared<BackendGap>>()
    run Vector.append<Shared<BackendGap>>(&mut gaps, move value)
    return Option.some<StaticClosure>(StaticClosure.Unsupported {gaps: move gaps})
  }
  let mirIndex = Shared.with<Result<Answer, NoRejection>, Option<usize>>(&mir, answerMirIndex)
  let lowered = match move mirIndex {
    Option<usize>.Some {value} => value
    Option<usize>.None => { return Option.some<StaticClosure>(run closureGap(GapCode.TypedForm, &application, span)) }
  }
  if leave { run Vector.append<ClosureVisit>(&mut draft.pending, ClosureVisit.Leave) }
  let callerModule = run resolvedModule(&semantic.resolver, location.module)
  let functions = Vector.asSlice<MirFunction>(&semantic.resolver.mirValues)
  let references = Vector.asSlice<MirReference>(&functions[lowered].references)
  let mut reference = usize.ZERO
  while reference < references.length {
    run Vector.append<ClosureVisit>(&mut draft.pending, ClosureVisit.Enter {
      key: InstanceKey.copy(&references[reference].key), from: node, edge: Edge.copy(&references[reference].edge),
      module: run ModuleId.copy(&callerModule), span: references[reference].origin.span,
    })
    reference = reference + usize.ONE
  }
  return Option.none<StaticClosure>()
}

effect fn walkChain(semantic: &mut Semantic, draft: &mut ClosureDraft, limit: usize, incoming: &ClosureIncoming, ancestors: &[Application]) -> StaticClosure
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  while Vector.length<ClosureVisit>(&draft.pending) > usize.ZERO {
    let last = Vector.length<ClosureVisit>(&draft.pending) - usize.ONE
    let visit = Vector.remove<ClosureVisit>(&mut draft.pending, last)
    match move visit {
      ClosureVisit.Leave => { Admission.leave(&mut draft.admission) }
      ClosureVisit.Enter {key, from, edge, module, span} => {
        let outcome = run enterChainNode(&mut semantic.*, &mut draft.*, key, from, edge, module, span, incoming, limit)
        if let Option<StaticClosure>.Some {value} = move outcome { return move value }
      }
    }
  }
  let mut nodes = Vector.make<Application>()
  let listed = Vector.asSlice<Application>(&draft.nodes)
  let mut at = usize.ZERO
  while at < listed.length {
    run Vector.append<Application>(&mut nodes, run Application.copy(&listed[at]))
    at = at + usize.ONE
  }
  let mut edges = Vector.make<ClosureEdge>()
  let recorded = Vector.asSlice<ClosureEdge>(&draft.edges)
  at = usize.ZERO
  while at < recorded.length {
    run Vector.append<ClosureEdge>(&mut edges, ClosureEdge {
      from: recorded[at].from, to: recorded[at].to, edge: Edge.copy(&recorded[at].edge), module: run ModuleId.copy(&recorded[at].module), span: recorded[at].span,
    })
    at = at + usize.ONE
  }
  let mut path = Vector.make<Application>()
  at = usize.ZERO
  while at < ancestors.length {
    run Vector.append<Application>(&mut path, run Application.copy(&ancestors[at]))
    at = at + usize.ONE
  }
  return StaticClosure.Certified {evidence: FiniteClosureEvidence {
    incoming: run copyClosureIncoming(incoming), ancestors: move path, nodes: move nodes, edges: move edges,
  }}
}

// A closure that the node budget ended before it closed: the pending path, the budget reached, and
// the module and span of the changing-static edge that opened the transaction.
effect fn rejectNotProven(module: &ModuleId, span: Span, related: Option<RelatedSite>, path: Vector<Application>, limit: usize) -> Shared<Rejection>
! OutOfMemoryError ? &mut Allocator {
  return run Shared.make<Rejection>(
    Rejection {
      code: RejectionCode.StaticRecursionNotProven,
      module: run ModuleId.copy(module),
      span: span,
      related: move related,
      path: Vector.make<Shared<DeclarationId>>(),
      expected: limit,
      supplied: limit,
      parameterName: Bytes.make(),
      expectedKind: GenericKind.Type,
      suppliedKind: GenericKind.Type,
      witness: Option.none<WitnessProblem>(),
      termination: TerminationStep.Peer,
      staticFailure: Option.none<StaticDiagnostic>(),
      specialization: move path,
    },
  )
}

// `related` is the site of the changing-static edge whose closure transaction reached the growth.
effect fn rejectSpecialization(module: &ModuleId, span: Span, related: Option<RelatedSite>, path: Vector<Application>) -> Shared<
  Rejection,
> ! OutOfMemoryError ? &mut Allocator {
  return run Shared.make<Rejection>(
    Rejection {
      code: RejectionCode.ExpandingSpecialization,
      module: run ModuleId.copy(module),
      span: span,
      related: move related,
      path: Vector.make<Shared<DeclarationId>>(),
      expected: usize.ZERO,
      supplied: usize.ZERO,
      parameterName: Bytes.make(),
      expectedKind: GenericKind.Type,
      suppliedKind: GenericKind.Type,
      witness: Option.none<WitnessProblem>(),
      termination: TerminationStep.Peer,
      staticFailure: Option.none<StaticDiagnostic>(),
      specialization: move path,
    },
  )
}

fn absurd<T>() -> T {
  let boom = 1 / 0
  return absurd<T>()
}

fn callableInvocationMode(value: &Type) -> CallableMode {
  return match &value.* {
    Type.Callable {mode, ..} => mode
    Type.Effect {mode, ..} => mode
    Type.CallableValue {contract, ..} => Shared.with<Type, CallableMode>(&contract, callableInvocationMode)
    Type.CallableWitnessResult {witness} => {
      let recipe = Shared.with<WitnessRecipe, WitnessRecipe>(&witness, CallableWitness.copy)
      return Shared.with<Type, CallableMode>(&recipe.result, callableInvocationMode)
    }
    Type.CallableResult {contract, ..} => Shared.with<Type, CallableMode>(&contract, callableInvocationMode)
    Type.CallableStage {contract, ..} => Shared.with<Type, CallableMode>(&contract, callableInvocationMode)
    Type.CallableSchema {schema, ..} => Shared.with<Type, CallableMode>(&sectionSchemaContract(&schema), callableInvocationMode)
    Type.EffectComposite {contract, ..} => Shared.with<Type, CallableMode>(&contract, callableInvocationMode)
    Type.EffectJoin {contract, ..} => Shared.with<Type, CallableMode>(&contract, callableInvocationMode)
    Type.OpaqueRepresentation {contract, ..} => Shared.with<Type, CallableMode>(&contract, callableInvocationMode)
    _ => CallableMode.Once
  }
}

// A section blueprint binds target variables; selected values remain separate free evidence.
effect fn sectionContextUndetermined(contract: &Shared<Type>, owner: &DeclarationId) -> bool
! OutOfMemoryError ? &mut Allocator {
  let facts = match move run CallableContract.ofType(contract) {
    Option<CallableFacts>.Some {value} => move value
    _ => { return false }
  }
  let parameters = Vector.asSlice<Shared<Type>>(&facts.parameters)
  let mut at = usize.ZERO
  while at < parameters.length {
    if run typeMentionsOwner(&parameters[at], owner) { return true }
    at = at + usize.ONE
  }
  return run typeMentionsOwner(&facts.result, owner)
}

effect fn sectionInferenceOwner(resolver: &mut Resolver, target: &DeclarationId) -> DeclarationId
! OutOfMemoryError ? &mut Allocator {
  let mut scope = run Bytes.copy(b"\0section-use")
  run RuntimeEncoding.word(&mut scope, usize.toU64(resolver.nextInferenceId))
  resolver.nextInferenceId = resolver.nextInferenceId + usize.ONE
  return run DeclarationId.inference(target, Bytes.asSlice(&scope))
}

// Admission specializes a comparison contract, never the immutable value or its runtime key.
// Target binders are opened before the context is introduced, including recursive owner uses.
// With a pending call owner, positions mentioning its still-open variables are not evidence, and
// a contract those positions leave undetermined is absent rather than rejected.
effect fn contextualCallableContract(resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, module: &ModuleId, declared: &[Constraint], actual: &Shared<Type>,
  promised: &Shared<Type>, pending: &Option<DeclarationId>, span: Span) -> Result<Option<Shared<Type>>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let schema = match move Shared.with<Type, Option<Shared<SectionSchema>>>(actual, sectionSchemaOf) {
    Option<Shared<SectionSchema>>.Some {value} => move value
    _ => { return Result.succeed<Option<Shared<Type>>, Shared<Rejection>>(run valueCallableContract(actual, declared)) }
  }
  let mut wanted = match move run CallableContract.ofType(promised) {
    Option<CallableFacts>.Some {value} => move value
    _ => { return Result.failResult<Option<Shared<Type>>, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.Unsupported, span)) }
  }
  let copied = run CallableSchema.copy(&schema)
  let target = run DeclarationId.copyShared(&copied.target)
  let fresh = run sectionInferenceOwner(&mut resolver.*, &target)
  // Only the offered owner is inferable. A promise's invocation regions remain rigid and
  // cannot acquire the enclosing body's local-loan premises.
  let rigid = run DeclarationId.inference(&fresh, b"\0quantified-promise")
  let quantified = wanted.invocationBinders != usize.ZERO
  let mut premises = run copyConstraints(declared)
  if quantified {
    let original = Vector.asSlice<Shared<Type>>(&wanted.parameters)
    let mut parameters = Vector.make<Shared<Type>>()
    let mut at = usize.ZERO
    while at < original.length {
      if Type.containsInvocationQuantifier(&original[at]) {
        return Result.failResult<Option<Shared<Type>>, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.Unsupported, span))
      }
      run Vector.append<Shared<Type>>(&mut parameters, run Type.openInvocation(&original[at], &rigid))
      at = at + usize.ONE
    }
    if Type.containsInvocationQuantifier(&wanted.result) {
      return Result.failResult<Option<Shared<Type>>, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.Unsupported, span))
    }
    wanted.parameters = move parameters
    wanted.result = run Type.openInvocation(&wanted.result, &rigid)
    let bounds = Vector.asSlice<Outlives>(&wanted.invocationBounds)
    at = usize.ZERO
    while at < bounds.length {
      run Vector.append<Constraint>(&mut premises, Constraint.Outlives {
        longer: run Type.openInvocationLifetime(&bounds[at].longer, &rigid),
        shorter: run Type.openInvocationLifetime(&bounds[at].shorter, &rigid)})
      at = at + usize.ONE
    }
    // A marked `for<use 'call>` promise lends every input for the whole invocation extent.
    run invocationUseConstraints(Vector.asSlice<Shared<Type>>(&wanted.parameters), wanted.invocationUse,
      &Option.some<DeclarationId>(run DeclarationId.copy(&rigid)), &mut premises)
  }
  let mut unheld = Vector.make<Binding>()
  let opened = match move run sectionSchemaSignature(&mut resolver.*, &mut owner.*, &mut dependencies.*, &schema, &fresh, module, span,
    false, &mut unheld) {
    Result<Shared<Result<Answer, NoRejection>>, Shared<Rejection>>.Success {value} => move value
    Result<Shared<Result<Answer, NoRejection>>, Shared<Rejection>>.Failure {error} => { return Result.failResult<Option<Shared<Type>>, Shared<Rejection>>(move error) }
  }
  let facts = match move Shared.with<Result<Answer, NoRejection>, Option<SignatureFacts>>(&opened, signatureFacts) {
    Option<SignatureFacts>.Some {value} => move value
    _ => { return Result.failResult<Option<Shared<Type>>, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.Unsupported, span)) }
  }
  if quantified && (Type.containsInvocationQuantifier(&facts.result) || Type.containsInvocationQuantifier(&facts.failure)) {
    return Result.failResult<Option<Shared<Type>>, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.Unsupported, span))
  }
  let parameters = Vector.asSlice<Shared<Type>>(&wanted.parameters)
  if parameters.length != facts.parameters {
    return Result.failResult<Option<Shared<Type>>, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.IncompatibleCallableSignature, span))
  }
  let mut variables = Vector.make<Shared<DeclarationId>>()
  run Vector.append<Shared<DeclarationId>>(&mut variables, run Shared.make<DeclarationId>(run DeclarationId.copy(&fresh)))
  let mut inferred = Vector.make<Binding>()
  let mut at = usize.ZERO
  while at < parameters.length {
    let pattern = match move Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(&opened,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> { return signatureParameter(answer, at) }) {
      Option<Shared<Type>>.Some {value} => move value
      _ => { fail RevisionMismatch {} }
    }
    if quantified && Type.containsInvocationQuantifier(&pattern) {
      return Result.failResult<Option<Shared<Type>>, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.Unsupported, span))
    }
    if !run mentionsPending(&parameters[at], pending) {
      run inferSectionCallableShape(&pattern, &parameters[at], Vector.asSlice<Shared<DeclarationId>>(&variables), &mut inferred)
    }
    at = at + usize.ONE
  }
  // Invoking an `effect fn` target constructs its Effect, whose channels carry the written result.
  let mut wantedResult = Shared.clone<Type>(&wanted.result)
  if facts.isEffect {
    let delayed = Shared.with<Type, Option<EffectChannels>>(&wanted.result, effectChannels)
    if let Option<EffectChannels>.Some {value: channels} = move delayed {
      if !run mentionsPending(&channels.failure, pending) {
        run inferSectionCallableShape(&facts.failure, &channels.failure, Vector.asSlice<Shared<DeclarationId>>(&variables), &mut inferred)
      }
      wantedResult = move channels.success
    }
  }
  if !run mentionsPending(&wantedResult, pending) {
    run inferSectionCallableShape(&facts.result, &wantedResult, Vector.asSlice<Shared<DeclarationId>>(&variables), &mut inferred)
  }
  let freshIdentity = run Shared.make<DeclarationId>(run DeclarationId.copy(&fresh))
  let inferenceFailure = run inferFromProviderBounds(&mut resolver.*, &mut owner.*, &mut dependencies.*, module,
    &opened, &freshIdentity, Vector.asSlice<Constraint>(&premises), &mut inferred, span)
  if let Option<Shared<Rejection>>.Some {value} = move inferenceFailure {
    return Result.failResult<Option<Shared<Type>>, Shared<Rejection>>(move value)
  }
  let undetermined = match &pending.* { Option<DeclarationId>.Some {..} => true _ => false }
  let mut closing = Vector.make<Binding>()
  if quantified {
    let mut request = Request.make()
    let source = match move run resolveTargetSchema(&mut resolver.*, &mut owner.*, &mut request,
      &mut dependencies.*, true, &target, span) {
      Option<TargetSchema>.Some {value} => move value
      _ => { return Result.failResult<Option<Shared<Type>>, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.Unsupported, span)) }
    }
    let mapped = run quantifiedSectionSlots(&copied, &source, &opened, &fresh, &rigid,
      Vector.asSlice<Binding>(&inferred), wanted.invocationBinders)
    let slots = match move mapped {
      Option<Vector<QuantifiedSectionSlot>>.Some {value} => move value
      // Deferred type/row evidence containing invocation regions needs its own recipe proof.
      _ => { return Result.failResult<Option<Shared<Type>>, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.Unsupported, span)) }
    }
    let retained = Vector.asSlice<QuantifiedSectionSlot>(&slots)
    let mut at = usize.ZERO
    while at < retained.length {
      if sectionInferenceOrdinal(&source, &opened, retained[at].original) != retained[at].dense {
        fail RevisionMismatch {}
      }
      run Vector.append<Binding>(&mut closing, Binding {
        declaration: run Shared.make<DeclarationId>(run DeclarationId.copy(&rigid)), ordinal: retained[at].invocation,
        value: Argument.Lifetime {value: run Shared.make<Lifetime>(Lifetime.Invocation {ordinal: retained[at].invocation})}})
      at = at + usize.ONE
    }
  }
  let mut bounds = Vector.make<Constraint>()
  at = usize.ZERO
  while at < facts.constraints {
    let bound = Shared.with<Result<Answer, NoRejection>, Option<Constraint>>(&opened,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Constraint> { return signatureConstraintAt(answer, at) })
    if let Option<Constraint>.Some {value} = move bound {
      let applied = run bindConstraint(&value, Vector.asSlice<Binding>(&inferred))
      if run constraintMentionsOwner(&applied, &fresh) {
        if undetermined { return Result.succeed<Option<Shared<Type>>, Shared<Rejection>>(Option.none<Shared<Type>>()) }
        return Result.failResult<Option<Shared<Type>>, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.IncompatibleCallableSignature, span))
      }
      run Vector.append<Constraint>(&mut bounds, move applied)
    }
    at = at + usize.ONE
  }
  let failed = run proveAppliedBounds(&mut resolver.*, &mut owner.*, &mut dependencies.*, &premises,
    Vector.asSlice<Constraint>(&bounds), module, span)
  if let Option<Shared<Rejection>>.Some {value} = move failed { return Result.failResult<Option<Shared<Type>>, Shared<Rejection>>(move value) }
  let assigned = Vector.asSlice<Binding>(&inferred)
  let mut result = run Type.applyBindings(&facts.result, assigned, true)
  if facts.isEffect {
    let constructed = match move run effectValueResult(&mut resolver.*, &mut owner.*, &mut dependencies.*, &opened, assigned,
      Shared.clone<Type>(&result), run Type.applyBindings(&facts.failure, assigned, true),
      run Row.applyBindings(&facts.requirements, assigned, true), declared, span) {
      Result<Shared<Type>, Shared<Rejection>>.Success {value} => value
      Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result.failResult<Option<Shared<Type>>, Shared<Rejection>>(move error) }
    }
    result = move constructed
  }
  let mut invocationBounds = Vector.make<Outlives>()
  let obligations = Vector.asSlice<Constraint>(&bounds)
  at = usize.ZERO
  while at < obligations.length {
    if let Constraint.Outlives {longer, shorter} = &obligations[at] {
      run Vector.append<Outlives>(&mut invocationBounds, Outlives {
        longer: run Type.applyLifetimeBindings(&longer, Vector.asSlice<Binding>(&closing)),
        shorter: run Type.applyLifetimeBindings(&shorter, Vector.asSlice<Binding>(&closing))})
    }
    at = at + usize.ONE
  }
  let mut invocationBinders = wanted.invocationBinders
  let mut invocationUse = wanted.invocationUse
  if !quantified {
    let source = match move run CallableContract.ofType(&copied.contract) {
      Option<CallableFacts>.Some {value} => move value
      _ => { fail RevisionMismatch {} }
    }
    invocationBinders = source.invocationBinders
    invocationUse = source.invocationUse
  }
  let contract = run sectionInstantiatedContract(&opened, &copied.contract, assigned, move result,
    invocationBinders, invocationUse, move invocationBounds)
  if run typeMentionsOwner(&contract, &fresh) {
    if undetermined { return Result.succeed<Option<Shared<Type>>, Shared<Rejection>>(Option.none<Shared<Type>>()) }
    return Result.failResult<Option<Shared<Type>>, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.IncompatibleCallableSignature, span))
  }
  if quantified {
    if run quantifiedSectionEnvironment(&contract, &fresh, &rigid) {
      return Result.failResult<Option<Shared<Type>>, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.Unsupported, span))
    }
  }
  let closed = run Type.applyBindings(&contract, Vector.asSlice<Binding>(&closing), true)
  let retainsRigid = run typeMentionsOwner(&closed, &rigid)
  let retainsFresh = run typeMentionsOwner(&closed, &fresh)
  if retainsRigid || retainsFresh {
    return Result.failResult<Option<Shared<Type>>, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.Unsupported, span))
  }
  return Result.succeed<Option<Shared<Type>>, Shared<Rejection>>(Option.some<Shared<Type>>(move closed))
}

// All three coordinates are proof-local. The immutable schema keeps its original ordinals.
struct QuantifiedSectionSlot {
  original: usize
  dense: usize
  invocation: usize
}

effect fn quantifiedSectionSlots(recipe: &SectionSchema, source: &TargetSchema,
  opened: &Shared<Result<Answer, NoRejection>>, fresh: &DeclarationId, rigid: &DeclarationId,
  inferred: &[Binding], count: usize) -> Option<Vector<QuantifiedSectionSlot>>
! OutOfMemoryError ? &mut Allocator {
  let own = Vector.asSlice<ApplicationSlot>(&source.own)
  let mut mapped = Vector.make<QuantifiedSectionSlot>()
  let mut at = usize.ZERO
  while at < inferred.length {
    if run argumentMentionsOwner(&inferred[at].value, rigid) {
      let identity = run DeclarationId.copyShared(&inferred[at].declaration)
      if !DeclarationId.equals(&identity, fresh) { return Option.none<Vector<QuantifiedSectionSlot>>() }
      let invocation = match &inferred[at].value {
        Argument.Lifetime {value} => ownedLifetimeOrdinal(&value, rigid)
        _ => usize.MAX
      }
      if invocation >= count { return Option.none<Vector<QuantifiedSectionSlot>>() }
      let mut found = false
      let mut slot = usize.ZERO
      while slot < own.length {
        if own[slot].kind == GenericKind.Lifetime && containsOrdinal(&recipe.deferred, own[slot].ordinal)
          && sectionInferenceOrdinal(source, opened, own[slot].ordinal) == inferred[at].ordinal {
          run Vector.append<QuantifiedSectionSlot>(&mut mapped, QuantifiedSectionSlot {
            original: own[slot].ordinal, dense: inferred[at].ordinal, invocation: invocation})
          found = true
        }
        slot = slot + usize.ONE
      }
      if !found { return Option.none<Vector<QuantifiedSectionSlot>>() }
    }
    at = at + usize.ONE
  }
  return Option.some<Vector<QuantifiedSectionSlot>>(move mapped)
}

// Retained storage cannot depend on one invocation's private proof or quantifier.
effect fn quantifiedSectionEnvironment(contract: &Shared<Type>, fresh: &DeclarationId, rigid: &DeclarationId) -> bool
! OutOfMemoryError ? &mut Allocator {
  let facts = match move run CallableContract.ofType(contract) {
    Option<CallableFacts>.Some {value} => move value _ => { return true }
  }
  let regions = run callableEnvironmentRegions(&facts.environment)
  let listed = Vector.asSlice<Shared<Lifetime>>(&regions)
  let mut at = usize.ZERO
  while at < listed.length {
    let mut owned = Vector.make<usize>()
    run Type.collectOwnedLifetime(&listed[at], fresh, &mut owned)
    run Type.collectOwnedLifetime(&listed[at], rigid, &mut owned)
    run Type.collectLifetime(&listed[at], &mut owned)
    if Vector.length<usize>(&owned) != usize.ZERO { return true }
    at = at + usize.ONE
  }
  return false
}

// Whether a contextual position still mentions the calling inference's open variables.
effect fn mentionsPending(value: &Shared<Type>, pending: &Option<DeclarationId>) -> bool
! OutOfMemoryError ? &mut Allocator {
  return match &pending.* {
    Option<DeclarationId>.Some {value: caller} => run typeMentionsOwner(value, &caller)
    Option<DeclarationId>.None => false
  }
}

// Learn referent variables even when reference access or validity differs. This is inference
// only: CallableContract.compare proves the direction of access and lifetime conversion.
effect fn inferSectionCallableShape(pattern: &Shared<Type>, actual: &Shared<Type>,
  variables: &[Shared<DeclarationId>], inferred: &mut Vector<Binding>) -> ()
! OutOfMemoryError ? &mut Allocator {
  drop run Type.unify(pattern, actual, variables, Comparison.Exact, &mut inferred.*)
  let left = run Type.copy(pattern)
  let right = run Type.copy(actual)
  match move left {
    Type.Reference {referent, ..} => {
      if let Type.Reference {referent: other, ..} = move right {
        run inferSectionCallableShape(&referent, &other, variables, &mut inferred.*)
      }
    }
    Type.Slice {element, ..} => {
      if let Type.Slice {element: other, ..} = move right {
        run inferSectionCallableShape(&element, &other, variables, &mut inferred.*)
      }
    }
    _ => ()
  }
}

// The section's invocation contract under one use's bindings. The use supplies the instantiated
// result; like the blueprint's, it retains the regions the section captured.
effect fn sectionInstantiatedContract(signature: &Shared<Result<Answer, NoRejection>>, visible: &Shared<Type>, bindings: &[Binding],
  result: Shared<Type>, invocationBinders: usize, invocationUse: usize, invocationBounds: Vector<Outlives>) -> Shared<Type>
! OutOfMemoryError ? &mut Allocator {
  let facts = match move Shared.with<Result<Answer, NoRejection>, Option<SignatureFacts>>(signature, signatureFacts) {
    Option<SignatureFacts>.Some {value} => move value _ => { return absurd<Shared<Type>>() }
  }
  let shape = match move run CallableContract.ofType(visible) {
    Option<CallableFacts>.Some {value} => move value _ => { return absurd<Shared<Type>>() }
  }
  let mut parameters = Vector.make<Shared<Type>>()
  let mut at = usize.ZERO
  while at < facts.parameters {
    let parameter = match move Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(signature,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> { return signatureParameter(answer, at) }) {
      Option<Shared<Type>>.Some {value} => move value _ => { return absurd<Shared<Type>>() }
    }
    run Vector.append<Shared<Type>>(&mut parameters, run Type.applyBindings(&parameter, bindings, true))
    at = at + usize.ONE
  }
  let regions = run callableEnvironmentRegions(&shape.environment)
  return run Shared.make<Type>(Type.Callable {mode: shape.mode, isUnsafe: shape.isUnsafe, environment: move shape.environment,
    invocationBinders: invocationBinders, invocationUse: invocationUse, invocationBounds: move invocationBounds,
    parameters: move parameters, result: run capturedEffectResult(move result, Vector.asSlice<Shared<Lifetime>>(&regions))})
}

union NamedSectionTarget {
  Application {value: Application, isPublic: bool},
  Schema {target: Shared<DeclarationId>, selected: Vector<Binding>, deferred: Vector<usize>},
}

fn genericSectionType(value: &Type) -> bool {
  return match &value.* { Type.CallableSchema {..} => true _ => false }
}

// Lifetime evidence is supplied by the remaining invocation operands, not stored as a capture.
// Effect-valued targets still need the separate row/provider staging recipe. Inspect the selected
// source result contract so a generic representation cannot hide an Effect after substitution.
effect fn sectionLifetimeDeferral(target: &DeclarationId, signature: &Shared<Result<Answer, NoRejection>>,
  inferred: &[Binding], declared: &[Constraint]) -> bool ! OutOfMemoryError ? &mut Allocator {
  if DeclarationId.kind(target) == OwnerKind.Anonymous { return true }
  let facts = match move Shared.with<Result<Answer, NoRejection>, Option<SignatureFacts>>(signature, signatureFacts) {
    Option<SignatureFacts>.Some {value} => move value _ => { return false }
  }
  if facts.isEffect { return false }
  let result = run Type.applyBindings(&facts.result, inferred, true)
  let mut constraints = run copyConstraints(declared)
  let mut at = usize.ZERO
  while at < facts.constraints {
    let bound = Shared.with<Result<Answer, NoRejection>, Option<Constraint>>(signature,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Constraint> { return signatureConstraintAt(answer, at) })
    if let Option<Constraint>.Some {value} = move bound {
      run Vector.append<Constraint>(&mut constraints, run bindConstraint(&value, inferred))
    }
    at = at + usize.ONE
  }
  return !(run sectionResultEffect(&result, Vector.asSlice<Constraint>(&constraints)))
}

// A promised union can select an exact Effect representation in one member. Check each
// selected member's exposed contract, including contracts supplied by caller premises.
effect fn sectionResultEffect(result: &Shared<Type>, constraints: &[Constraint]) -> bool
! OutOfMemoryError ? &mut Allocator {
  if Shared.with<Type, bool>(result, effectStorageType) { return true }
  let selected = run Type.copy(result)
  if let Type.Union {members} = move selected {
    let listed = Vector.asSlice<Shared<Type>>(&members)
    let mut at = usize.ZERO
    while at < listed.length {
      if run sectionResultEffect(&listed[at], constraints) { return true }
      at = at + usize.ONE
    }
    return false
  }
  let exposed = run valueCallableContract(result, constraints)
  if let Option<Shared<Type>>.Some {value} = move exposed {
    return Shared.with<Type, bool>(&value, effectStorageType)
  }
  return false
}

fn anonymousSectionType(value: &Type) -> bool {
  return match &value.* {
    Type.CallableSchema {schema, ..} => Shared.with<SectionSchema, bool>(&schema, anonymousSectionRecipe)
    _ => false
  }
}

fn anonymousSectionRecipe(recipe: &SectionSchema) -> bool {
  return Shared.with<DeclarationId, bool>(&recipe.target,
    fn(identity: &DeclarationId) -> bool { return DeclarationId.kind(identity) == OwnerKind.Anonymous })
}

fn sectionSchemaOf(value: &Type) -> Option<Shared<SectionSchema>> {
  return match &value.* { Type.CallableSchema {schema, ..} => Option.some<Shared<SectionSchema>>(Shared.clone<SectionSchema>(&schema)) _ => Option.none<Shared<SectionSchema>>() }
}

fn sectionSchemaContract(value: &Shared<SectionSchema>) -> Shared<Type> {
  return Shared.with<SectionSchema, Shared<Type>>(value, fn(schema: &SectionSchema) -> Shared<Type> {
    return Shared.clone<Type>(&schema.contract)
  })
}

effect fn bindConstraint(value: &Constraint, bindings: &[Binding]) -> Constraint
! OutOfMemoryError ? &mut Allocator {
  return match &value.* {
    Constraint.Conforms {provider, contract} => Constraint.Conforms {
      provider: run Type.applyBindings(&provider, bindings, true), contract: run Type.applyBindings(&contract, bindings, true)}
    Constraint.Represents {parameter, contract} => Constraint.Represents {
      parameter: run Type.applyBindings(&parameter, bindings, true), contract: run Type.applyBindings(&contract, bindings, true)}
    Constraint.Contents {subject, region} => Constraint.Contents {
      subject: run Type.applyBindings(&subject, bindings, true), region: run Type.applyLifetimeBindings(&region, bindings)}
    Constraint.Outlives {longer, shorter} => Constraint.Outlives {
      longer: run Type.applyLifetimeBindings(&longer, bindings), shorter: run Type.applyLifetimeBindings(&shorter, bindings)}
    Constraint.Copyable {subject} => Constraint.Copyable {subject: run Type.applyBindings(&subject, bindings, true)}
    Constraint.Property {subject, property} => Constraint.Property {subject: run Type.applyBindings(&subject, bindings, true), property: property}
    Constraint.Provides {provider, selector, source} => Constraint.Provides {provider: run Type.applyBindings(&provider, bindings, true),
      selector: run Row.applyBindings(&selector, bindings, true), source: run Row.applyBindings(&source, bindings, true)}
  }
}

struct SectionSelection {
  selected: Vector<Binding>
  deferred: Vector<usize>
}

// Collects the binders a section's still-unsupplied leading parameters mention, including the
// invocation contracts of representation parameters they name. Only these are evidence a later
// invocation supplies; false when the signature lacks one of those parameters.
effect fn sectionEvidence(inference: &Shared<Result<Answer, NoRejection>>, fresh: &DeclarationId, inferred: &[Binding],
  remaining: usize, types: &mut Vector<usize>, lifetimes: &mut Vector<usize>, rows: &mut Vector<usize>) -> bool
! OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < remaining {
    let parameter = match move Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(inference,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> { return signatureParameter(answer, at) }) {
      Option<Shared<Type>>.Some {value} => move value
      _ => { return false }
    }
    let applied = run Type.applyBindings(&parameter, inferred, true)
    run Type.collectOwned(&applied, fresh, &mut types.*, &mut lifetimes.*, &mut rows.*)
    at = at + usize.ONE
  }
  // Both written callable parameters and authored F: fn bounds expose their invocation
  // contract as part of the remaining parameter's source shape.
  let boundCount = Shared.with<Result<Answer, NoRejection>, usize>(inference, signatureConstraintCount)
  let mut expanded = true
  while expanded {
    let before = Vector.length<usize>(&types.*) + Vector.length<usize>(&lifetimes.*) + Vector.length<usize>(&rows.*)
    at = usize.ZERO
    while at < boundCount {
      let bound = Shared.with<Result<Answer, NoRejection>, Option<Constraint>>(inference,
        fn(answer: &Result<Answer, NoRejection>) -> Option<Constraint> { return signatureConstraintAt(answer, at) })
      if let Option<Constraint>.Some {value: Constraint.Represents {parameter, contract}} = move bound {
        let applied = run Type.applyBindings(&parameter, inferred, true)
        if run sectionEligibleRepresentation(&applied, fresh, &types.*) {
          let shape = run Type.applyBindings(&contract, inferred, true)
          run Type.collectOwned(&shape, fresh, &mut types.*, &mut lifetimes.*, &mut rows.*)
        }
      }
      at = at + usize.ONE
    }
    expanded = before != Vector.length<usize>(&types.*) + Vector.length<usize>(&lifetimes.*) + Vector.length<usize>(&rows.*)
  }
  return true
}

// Construction and later staging share the same bound-versus-free binder selection rule.
effect fn sectionSelection(resolver: &Resolver, module: &ModuleId, target: &DeclarationId,
  schema: &TargetSchema, inference: &Shared<Result<Answer, NoRejection>>,
  fresh: &DeclarationId, inferred: &[Binding], remaining: usize, constraints: &[Constraint], contextual: bool, span: Span)
  -> Result<SectionSelection, Shared<Rejection>>
! OutOfMemoryError ? &mut Allocator {
  // Only variables mentioned by still-unsupplied parameters may be deferred. Result-only or
  // unused variables are not evidence available at a later invocation.
  let mut eligibleTypes = Vector.make<usize>()
  let mut eligibleLifetimes = Vector.make<usize>()
  let mut eligibleRows = Vector.make<usize>()
  if !run sectionEvidence(inference, fresh, inferred, remaining, &mut eligibleTypes, &mut eligibleLifetimes, &mut eligibleRows) {
    return Result.failResult<SectionSelection, Shared<Rejection>>(run reject(resolver, module, RejectionCode.Unsupported, span))
  }
  let boundCount = Shared.with<Result<Answer, NoRejection>, usize>(inference, signatureConstraintCount)
  // An omitted provision selector `?S` whose provider or source row waits for a deferred operand
  // is inferred at the invocation (`inferProvidedSelectors`), so it defers with that operand. Any
  // other open selector has no later evidence and stays a named deferral. A written selector is
  // proved once the invocation infers the row.
  let freshIdentity = run Shared.make<DeclarationId>(run DeclarationId.copy(fresh))
  let mut at = usize.ZERO
  while at < boundCount {
    let bound = Shared.with<Result<Answer, NoRejection>, Option<Constraint>>(inference,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Constraint> { return signatureConstraintAt(answer, at) })
    if let Option<Constraint>.Some {value: Constraint.Provides {provider, selector, source}} = move bound {
      let applied = run Row.applyBindings(&selector, inferred, true)
      if run argumentMentionsOwner(&Argument.Row {value: Shared.clone<Row>(&applied)}, fresh) {
        let ordinal = Shared.with<Row, usize>(&selector, fn(row: &Row) -> usize { return selectorOrdinalIn(row, &freshIdentity) })
        let appliedProvider = run Type.applyBindings(&provider, inferred, true)
        let appliedSource = run Row.applyBindings(&source, inferred, true)
        let providerPending = run typeMentionsOwner(&appliedProvider, fresh)
        let sourcePending = run argumentMentionsOwner(&Argument.Row {value: move appliedSource}, fresh)
        if ordinal == usize.MAX || !(providerPending || sourcePending) {
          return Result.failResult<SectionSelection, Shared<Rejection>>(run reject(resolver, module, RejectionCode.ProviderSectionUnavailable, span))
        }
        if !containsOrdinal(&eligibleRows, ordinal) { run Vector.append<usize>(&mut eligibleRows, ordinal) }
      }
    }
    at = at + usize.ONE
  }
  // With an expected callable contract, a binder only the result mentions would be inferred from
  // it; without one it is uninferred.
  let mut resultTypes = Vector.make<usize>()
  let mut resultLifetimes = Vector.make<usize>()
  let mut resultRows = Vector.make<usize>()
  let declaredResult = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(inference, signatureResult)
  if let Option<Shared<Type>>.Some {value: written} = move declaredResult {
    if contextual {
      let applied = run Type.applyBindings(&written, inferred, true)
      run Type.collectOwned(&applied, fresh, &mut resultTypes, &mut resultLifetimes, &mut resultRows)
    }
  }
  let ownSlots = Vector.asSlice<ApplicationSlot>(&schema.own)
  let count = ownSlots.length
  let mut selected = Vector.make<Binding>()
  let mut deferred = Vector.make<usize>()
  at = usize.ZERO
  while at < count {
    let dense = sectionInferenceOrdinal(schema, inference, ownSlots[at].ordinal)
    if dense == usize.MAX { return Result.failResult<SectionSelection, Shared<Rejection>>(run reject(resolver, module, RejectionCode.Unsupported, span)) }
    let supplied = bindingArgument(inferred, fresh, dense)
    if let Option<Argument>.Some {value} = move supplied {
      if run argumentMentionsOwner(&value, fresh) { return Result.failResult<SectionSelection, Shared<Rejection>>(run reject(resolver, module, RejectionCode.UninferredParameter, span)) }
      run Vector.append<Binding>(&mut selected, Binding {declaration: run Shared.make<DeclarationId>(run DeclarationId.copy(target)),
        ordinal: ownSlots[at].ordinal, value: move value})
    } else {
      if !containsOrdinal(&eligibleTypes, dense) && !containsOrdinal(&eligibleLifetimes, dense) && !containsOrdinal(&eligibleRows, dense) {
        if containsOrdinal(&resultTypes, dense) || containsOrdinal(&resultRows, dense) {
          return Result.failResult<SectionSelection, Shared<Rejection>>(run reject(resolver, module, RejectionCode.SectionResultInferenceUnavailable, span))
        }
        return Result.failResult<SectionSelection, Shared<Rejection>>(run reject(resolver, module, RejectionCode.UninferredParameter, span))
      }
      // Rows are inferred at invocation like types. Eligible ordinary lifetime slots reopen
      // under their original schema identity; Effect-valued lifetime recipes remain separate.
      if !containsOrdinal(&eligibleTypes, dense) && !containsOrdinal(&eligibleRows, dense)
        && !(containsOrdinal(&eligibleLifetimes, dense) && (run sectionLifetimeDeferral(target, inference, inferred, constraints))) {
        return Result.failResult<SectionSelection, Shared<Rejection>>(run reject(resolver, module, RejectionCode.Unsupported, span))
      }
      run Vector.append<usize>(&mut deferred, ownSlots[at].ordinal)
    }
    at = at + usize.ONE
  }
  return Result.succeed<SectionSelection, Shared<Rejection>>(SectionSelection {
    selected: move selected, deferred: move deferred})
}

effect fn copyNamedCallableEvidence(value: &NamedCallableEvidence) -> NamedCallableEvidence
! OutOfMemoryError ? &mut Allocator {
  let pending = match &value.pending {
    Option<DeclarationId>.Some {value: owner} => Option.some<DeclarationId>(run DeclarationId.copy(&owner))
    Option<DeclarationId>.None => Option.none<DeclarationId>()
  }
  return NamedCallableEvidence {contract: Shared.clone<Type>(&value.contract), pending: move pending}
}

// A named function used as a value takes the type and row binders no supplied argument fixed
// from the callable contract its use site promises: the offered parameters accept the promised
// ones and the offered result is the promised result (CALLABLE-001). This includes the binders of
// an enclosing generic impl, as in `Option.some` passed as a `once fn(u8) -> Option<u8>`.
// Lifetime binders stay open, so the invocation's operands supply them as for any section.
effect fn inferFromPromisedContract(inference: &Shared<Result<Answer, NoRejection>>, fresh: &DeclarationId,
  promised: &Option<NamedCallableEvidence>, inferred: &mut Vector<Binding>) -> ()
! OutOfMemoryError ? &mut Allocator {
  let evidence = match &promised.* {
    Option<NamedCallableEvidence>.Some {value} => run copyNamedCallableEvidence(&value)
    Option<NamedCallableEvidence>.None => { return () }
  }
  let wanted = match move run CallableContract.ofType(&evidence.contract) {
    Option<CallableFacts>.Some {value} => move value
    Option<CallableFacts>.None => { return () }
  }
  let facts = match move Shared.with<Result<Answer, NoRejection>, Option<SignatureFacts>>(inference, signatureFacts) {
    Option<SignatureFacts>.Some {value} => move value
    Option<SignatureFacts>.None => { return () }
  }
  let parameters = Vector.asSlice<Shared<Type>>(&wanted.parameters)
  if parameters.length != facts.parameters { return () }
  let mut variables = Vector.make<Shared<DeclarationId>>()
  run Vector.append<Shared<DeclarationId>>(&mut variables, run Shared.make<DeclarationId>(run DeclarationId.copy(fresh)))
  let mut learned = Vector.make<Binding>()
  let known = Vector.asSlice<Binding>(&inferred.*)
  let mut at = usize.ZERO
  while at < known.length {
    run Vector.append<Binding>(&mut learned, Binding {declaration: Shared.clone<DeclarationId>(&known[at].declaration),
      ordinal: known[at].ordinal, value: Argument.copy(&known[at].value)})
    at = at + usize.ONE
  }
  let start = known.length
  at = usize.ZERO
  while at < parameters.length {
    let pattern = match move Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(inference,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> { return signatureParameter(answer, at) }) {
      Option<Shared<Type>>.Some {value} => move value
      Option<Shared<Type>>.None => { return () }
    }
    if !run mentionsPending(&parameters[at], &evidence.pending) {
      run inferSectionCallableShape(&pattern, &parameters[at], Vector.asSlice<Shared<DeclarationId>>(&variables), &mut learned)
    }
    at = at + usize.ONE
  }
  // Invoking an `effect fn` constructs an Effect; its written result is the success channel.
  let mut wantedResult = Shared.clone<Type>(&wanted.result)
  if facts.isEffect {
    let delayed = Shared.with<Type, Option<EffectChannels>>(&wanted.result, effectChannels)
    if let Option<EffectChannels>.Some {value: channels} = move delayed {
      if !run mentionsPending(&channels.failure, &evidence.pending) {
        run inferSectionCallableShape(&facts.failure, &channels.failure,
          Vector.asSlice<Shared<DeclarationId>>(&variables), &mut learned)
      }
      wantedResult = move channels.success
    }
  }
  if !run mentionsPending(&wantedResult, &evidence.pending) {
    run inferSectionCallableShape(&facts.result, &wantedResult,
      Vector.asSlice<Shared<DeclarationId>>(&variables), &mut learned)
  }
  // A representation binder needs an exact callable or Effect, which a promised contract is not.
  let mut representations = Vector.make<usize>()
  let bounds = Shared.with<Result<Answer, NoRejection>, usize>(inference, signatureConstraintCount)
  at = usize.ZERO
  while at < bounds {
    let bound = Shared.with<Result<Answer, NoRejection>, Option<Constraint>>(inference,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Constraint> { return signatureConstraintAt(answer, at) })
    if let Option<Constraint>.Some {value: Constraint.Represents {parameter, ..}} = move bound {
      let ordinal = Shared.with<Type, usize>(&parameter, fn(value: &Type) -> usize { return Type.parameterOrdinalOf(value, fresh) })
      if ordinal != usize.MAX { run Vector.append<usize>(&mut representations, ordinal) }
    }
    at = at + usize.ONE
  }
  // A promised region stands for the use site's call, not for this value's invocations, so a
  // binding that lends one is left to the invocation as well, as is a callable or Effect contract.
  let found = Vector.asSlice<Binding>(&learned)
  at = start
  while at < found.length {
    let deferred = match &found[at].value {
      Argument.Lifetime {..} => true
      Argument.Type {value} => Type.containsViewBorrow(&value) || Shared.with<Type, bool>(&value, fn(ty: &Type) -> bool {
        return match &ty.* { Type.Callable {..} => true Type.Effect {..} => true _ => false }
      })
      Argument.Row {..} => false
    }
    let open = match move bindingArgumentAt(Vector.asSlice<Binding>(&inferred.*), found[at].ordinal) {
      Option<Argument>.Some {..} => false
      Option<Argument>.None => true
    }
    let pending = match &evidence.pending {
      Option<DeclarationId>.Some {value} => run argumentMentionsOwner(&found[at].value, &value)
      Option<DeclarationId>.None => false
    }
    if !deferred && !pending && open && !containsOrdinal(&representations, found[at].ordinal) {
      run Vector.append<Binding>(&mut inferred.*, Binding {declaration: Shared.clone<DeclarationId>(&found[at].declaration),
        ordinal: found[at].ordinal, value: Argument.copy(&found[at].value)})
    }
    at = at + usize.ONE
  }
  return ()
}

// A result-only section binder has inference evidence when an expected callable contract is
// present, or when a whole function is used as a value: its consumer proves a contract. A value
// whose use site already knows that contract takes such binders from it before any deferral.
fn sectionContext(expected: &Option<Shared<Type>>, valueConstruction: bool) -> bool {
  return valueConstruction || match &expected.* {
    Option<Shared<Type>>.Some {value} => Shared.with<Type, bool>(&value, callableType)
    _ => false
  }
}

effect fn finishDeferredNamedSection(resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  request: &mut Request, dependencies: &mut Vector<Dependency>, module: &ModuleId, caller: &DeclarationId,
  nodes: &mut Vector<BodyNode>, expression: HirId, span: Span, target: &DeclarationId,
  signature: &Shared<Result<Answer, NoRejection>>, inference: &Shared<Result<Answer, NoRejection>>,
  fresh: &DeclarationId, inferred: &[Binding], remaining: usize, arguments: Vector<BodyNodeId>,
  constraints: &[Constraint], expected: &Option<Shared<Type>>, contractBody: bool, contextual: bool)
  -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let resolved = run resolveTargetSchema(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, true, target, span)
  let schema = match move resolved {
    Option<TargetSchema>.Some {value} => move value
    _ => { return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span) }
  }
  if Shared.with<Result<Answer, NoRejection>, usize>(signature, signatureStaticCount) != usize.ZERO {
    return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
  }

  let mut choice = match move run sectionSelection(&resolver.*, module, target, &schema, inference,
    fresh, inferred, remaining, constraints, contextual, span) {
    Result<SectionSelection, Shared<Rejection>>.Success {value} => move value
    Result<SectionSelection, Shared<Rejection>>.Failure {error} => { return Result.failResult<BodyNodeId, Shared<Rejection>>(move error) }
  }
  let scoped = match move run sectionScopeSelection(&resolver.*, module, &schema, signature, fresh, inferred, span) {
    Result<Vector<Binding>, Shared<Rejection>>.Success {value} => move value
    Result<Vector<Binding>, Shared<Rejection>>.Failure {error} => { return Result.failResult<BodyNodeId, Shared<Rejection>>(move error) }
  }
  let enclosing = Vector.asSlice<Binding>(&scoped)
  let mut scopeAt = usize.ZERO
  while scopeAt < enclosing.length {
    run Vector.append<Binding>(&mut choice.selected, Binding {declaration: Shared.clone<DeclarationId>(&enclosing[scopeAt].declaration),
      ordinal: enclosing[scopeAt].ordinal, value: Argument.copy(&enclosing[scopeAt].value)})
    scopeAt = scopeAt + usize.ONE
  }
  let mut fixedBounds = Vector.make<Constraint>()
  let bounds = Shared.with<Result<Answer, NoRejection>, usize>(inference, signatureConstraintCount)
  let mut at = usize.ZERO
  while at < bounds {
    let found = Shared.with<Result<Answer, NoRejection>, Option<Constraint>>(inference,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Constraint> { return signatureConstraintAt(answer, at) })
    if let Option<Constraint>.Some {value} = move found {
      let applied = run bindConstraint(&value, inferred)
      if !run constraintMentionsOwner(&applied, fresh) { run Vector.append<Constraint>(&mut fixedBounds, move applied) }
    }
    at = at + usize.ONE
  }
  let declared = run copyConstraints(constraints)
  let refused = run proveAppliedBounds(&mut resolver.*, &mut owner.*, &mut dependencies.*, &declared,
    Vector.asSlice<Constraint>(&fixedBounds), module, span)
  if let Option<Shared<Rejection>>.Some {value} = move refused { return Result.failResult<BodyNodeId, Shared<Rejection>>(move value) }
  let mut result = match move Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(signature, signatureResult) {
    Option<Shared<Type>>.Some {value} => move value
    _ => { return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span) }
  }
  let noBindings = Vector.make<Binding>()
  if Shared.with<Result<Answer, NoRejection>, bool>(signature, signatureIsEffect) {
    // Run access is proved with the caller's bounds over the target's open parameters; a Copy
    // proof that needs the target's own bounds fails, which only makes the access stricter.
    let promised = match move run effectValueResult(&mut resolver.*, &mut owner.*, &mut dependencies.*, signature,
      Vector.asSlice<Binding>(&noBindings), Shared.clone<Type>(&result), run signatureFailure(signature), run signatureRequirements(signature),
      constraints, span) {
      Result<Shared<Type>, Shared<Rejection>>.Success {value} => value
      Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result.failResult<BodyNodeId, Shared<Rejection>>(move error) }
    }
    result = move promised
  }
  return run finishNamedSection(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, caller, &mut nodes.*,
    expression, span, signature, Vector.asSlice<Binding>(&noBindings),
    NamedSectionTarget.Schema {target: run Shared.make<DeclarationId>(run DeclarationId.copy(target)),
      selected: move choice.selected, deferred: move choice.deferred}, remaining, move arguments, move result, constraints, expected, contractBody)
}

effect fn sectionEligibleRepresentation(value: &Shared<Type>, owner: &DeclarationId, eligible: &Vector<usize>) -> bool
! OutOfMemoryError ? &mut Allocator {
  let mut types = Vector.make<usize>()
  let mut lifetimes = Vector.make<usize>()
  let mut rows = Vector.make<usize>()
  run Type.collectOwned(value, owner, &mut types, &mut lifetimes, &mut rows)
  let found = Vector.asSlice<usize>(&types)
  let mut at = usize.ZERO
  while at < found.length {
    if containsOrdinal(eligible, found[at]) { return true }
    at = at + usize.ONE
  }
  return false
}

// Open target variables before inserting selected caller evidence. In a recursive owner the
// selected evidence may have the very same declaration/ordinal as a bound blueprint variable.
effect fn sectionOriginalSignature(resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, target: &DeclarationId, span: Span) -> Shared<Result<Answer, NoRejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let targetModuleAt = knownModuleOrdinal(&resolver.*, DeclarationId.moduleId(target))
  if targetModuleAt == usize.MAX { fail InvalidModulePath {} }
  let targetModule = run resolvedModule(&resolver.*, targetModuleAt)
  let identity = run Shared.make<DeclarationId>(run DeclarationId.copy(target))
  let targetAt = match move run ordinalOfIdentity(&mut resolver.*, &targetModule, &identity) {
    Option<usize>.Some {value} => value _ => { fail RevisionMismatch {} }
  }
  return run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, Key {
    family: Family.Signature, module: targetModuleAt, name: usize.ZERO, declaration: targetAt,
    member: usize.ZERO, external: false}, span)
}

// Opening a signature lists participating scope slots first, then every own slot. Selection
// retains original owner/ordinal pairs; the fresh dense ordinal exists only for inference.
fn sectionInferenceOrdinal(schema: &TargetSchema, opened: &Shared<Result<Answer, NoRejection>>, original: usize) -> usize {
  let count = Shared.with<Result<Answer, NoRejection>, usize>(opened, signatureBinderCount)
  let slots = Vector.asSlice<ApplicationSlot>(&schema.own)
  if count < slots.length { return usize.MAX }
  let mut at = usize.ZERO
  while at < slots.length {
    if slots[at].ordinal == original { return count - slots.length + at }
    at = at + usize.ONE
  }
  return usize.MAX
}

effect fn sectionScopeInferenceOrdinal(schema: &TargetSchema, original: &Shared<Result<Answer, NoRejection>>,
  identity: &DeclarationId, ordinal: usize) -> usize ! OutOfMemoryError ? &mut Allocator {
  let scopes = Vector.asSlice<ApplicationScope>(&schema.scopes)
  let mut dense = usize.ZERO
  let mut scopeAt = usize.ZERO
  while scopeAt < scopes.length {
    let owner = run DeclarationId.copyShared(&scopes[scopeAt].owner)
    let slots = Vector.asSlice<ApplicationSlot>(&scopes[scopeAt].slots)
    let mut at = usize.ZERO
    while at < slots.length {
      if Shared.with<Result<Answer, NoRejection>, bool>(original,
        fn(answer: &Result<Answer, NoRejection>) -> bool { return signatureListsSlot(answer, &owner, slots[at]) }) {
        if DeclarationId.equals(identity, &owner) && slots[at].ordinal == ordinal { return dense }
        dense = dense + usize.ONE
      }
      at = at + usize.ONE
    }
    scopeAt = scopeAt + usize.ONE
  }
  return usize.MAX
}

// An enclosing impl's binders are fixed when a section is constructed, by written arguments, the
// supplied suffix or a function value's promised contract, and travel as selected owner evidence.
// Only the target's own binders may wait for the invocation; a schema cannot defer an impl binder,
// and an impl slot the signature does not list has no evidence at construction.
effect fn sectionScopeSelection(resolver: &Resolver, module: &ModuleId, schema: &TargetSchema,
  original: &Shared<Result<Answer, NoRejection>>, fresh: &DeclarationId, inferred: &[Binding], span: Span)
  -> Result<Vector<Binding>, Shared<Rejection>>
! OutOfMemoryError ? &mut Allocator {
  let mut selected = Vector.make<Binding>()
  let scopes = Vector.asSlice<ApplicationScope>(&schema.scopes)
  let mut scopeAt = usize.ZERO
  while scopeAt < scopes.length {
    let owner = run DeclarationId.copyShared(&scopes[scopeAt].owner)
    let slots = Vector.asSlice<ApplicationSlot>(&scopes[scopeAt].slots)
    let mut at = usize.ZERO
    while at < slots.length {
      let dense = run sectionScopeInferenceOrdinal(schema, original, &owner, slots[at].ordinal)
      let mut supplied = Option.none<Argument>()
      if dense != usize.MAX { supplied = bindingArgument(inferred, fresh, dense) }
      let value = match move supplied {
        Option<Argument>.Some {value} => move value
        Option<Argument>.None => { return Result.failResult<Vector<Binding>, Shared<Rejection>>(run reject(resolver, module, RejectionCode.Unsupported, span)) }
      }
      if run argumentMentionsOwner(&value, fresh) {
        return Result.failResult<Vector<Binding>, Shared<Rejection>>(run reject(resolver, module, RejectionCode.UninferredParameter, span))
      }
      run Vector.append<Binding>(&mut selected, Binding {declaration: Shared.clone<DeclarationId>(&scopes[scopeAt].owner),
        ordinal: slots[at].ordinal, value: move value})
      at = at + usize.ONE
    }
    scopeAt = scopeAt + usize.ONE
  }
  return Result.succeed<Vector<Binding>, Shared<Rejection>>(move selected)
}

// Every retained enclosing slot remains free construction evidence, including phantom slots.
effect fn sectionScopeArguments(schema: &TargetSchema, selected: &[Binding]) -> Option<Vector<Argument>>
! OutOfMemoryError ? &mut Allocator {
  let mut output = Vector.make<Argument>()
  let scopes = Vector.asSlice<ApplicationScope>(&schema.scopes)
  let mut scopeAt = usize.ZERO
  while scopeAt < scopes.length {
    let owner = run DeclarationId.copyShared(&scopes[scopeAt].owner)
    let slots = Vector.asSlice<ApplicationSlot>(&scopes[scopeAt].slots)
    let mut at = usize.ZERO
    while at < slots.length {
      let argument = bindingArgument(selected, &owner, slots[at].ordinal)
      if let Option<Argument>.Some {value} = move argument { run Vector.append<Argument>(&mut output, move value) }
      else { return Option.none<Vector<Argument>>() }
      at = at + usize.ONE
    }
    scopeAt = scopeAt + usize.ONE
  }
  return Option.some<Vector<Argument>>(move output)
}

// The target parameters a section already bound, opened onto `fresh` like its invocation signature,
// so a held binder's variance in them is known when the invocation would move it.
effect fn sectionCapturedParameters(resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, schema: &Shared<SectionSchema>, fresh: &DeclarationId,
  module: &ModuleId, span: Span) -> Result<Vector<Shared<Type>>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let copied = run CallableSchema.copy(schema)
  let target = run DeclarationId.copyShared(&copied.target)
  let original = run sectionOriginalSignature(&mut resolver.*, &mut owner.*, &mut dependencies.*, &target, span)
  let mut request = Request.make()
  let resolved = match move run resolveTargetSchema(&mut resolver.*, &mut owner.*, &mut request,
    &mut dependencies.*, true, &target, span) {
    Option<TargetSchema>.Some {value} => move value
    _ => { return Result.failResult<Vector<Shared<Type>>, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.Unsupported, span)) }
  }
  let opened = match move run callInferenceSignature(&resolver.*, &original, &resolved, fresh, module, span) {
    Result<Shared<Result<Answer, NoRejection>>, Shared<Rejection>>.Success {value} => move value
    Result<Shared<Result<Answer, NoRejection>>, Shared<Rejection>>.Failure {error} => { return Result.failResult<Vector<Shared<Type>>, Shared<Rejection>>(move error) }
  }
  let remaining = match move run CallableContract.ofType(&copied.contract) {
    Option<CallableFacts>.Some {value} => Vector.length<Shared<Type>>(&value.parameters)
    _ => { return Result.failResult<Vector<Shared<Type>>, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.Unsupported, span)) }
  }
  let all = run signatureParameterTypes(&opened)
  let listed = Vector.asSlice<Shared<Type>>(&all)
  let mut captured = Vector.make<Shared<Type>>()
  let mut at = remaining
  while at < listed.length {
    run Vector.append<Shared<Type>>(&mut captured, Shared.clone<Type>(&listed[at]))
    at = at + usize.ONE
  }
  return Result.succeed<Vector<Shared<Type>>, Shared<Rejection>>(move captured)
}

// With `holdLifetimes`, selected target lifetimes stay open binders and are appended to `held` as
// inference evidence, so an invocation can tell a lifetime its section bound from a written one.
effect fn sectionSchemaSignature(resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, schema: &Shared<SectionSchema>, fresh: &DeclarationId,
  module: &ModuleId, span: Span, holdLifetimes: bool, held: &mut Vector<Binding>)
  -> Result<Shared<Result<Answer, NoRejection>>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let copied = run CallableSchema.copy(schema)
  let target = run DeclarationId.copyShared(&copied.target)
  let original = run sectionOriginalSignature(&mut resolver.*, &mut owner.*, &mut dependencies.*, &target, span)
  let mut request = Request.make()
  let resolved = match move run resolveTargetSchema(&mut resolver.*, &mut owner.*, &mut request,
    &mut dependencies.*, true, &target, span) {
    Option<TargetSchema>.Some {value} => move value
    _ => { return Result.failResult<Shared<Result<Answer, NoRejection>>, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.Unsupported, span)) }
  }
  let opened = match move run callInferenceSignature(&resolver.*, &original, &resolved, fresh, module, span) {
    Result<Shared<Result<Answer, NoRejection>>, Shared<Rejection>>.Success {value} => move value
    Result<Shared<Result<Answer, NoRejection>>, Shared<Rejection>>.Failure {error} => { return Result.failResult<Shared<Result<Answer, NoRejection>>, Shared<Rejection>>(move error) }
  }
  let facts = match move Shared.with<Result<Answer, NoRejection>, Option<SignatureFacts>>(&opened, signatureFacts) {
    Option<SignatureFacts>.Some {value} => move value
    _ => { return Result.failResult<Shared<Result<Answer, NoRejection>>, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.Unsupported, span)) }
  }
  let mut seed = Vector.make<Binding>()
  let chosen = Vector.asSlice<Binding>(&copied.selected)
  let mut at = usize.ZERO
  while at < chosen.length {
    let identity = run DeclarationId.copyShared(&chosen[at].declaration)
    let own = DeclarationId.equals(&target, &identity)
    let mut dense = run sectionScopeInferenceOrdinal(&resolved, &original, &identity, chosen[at].ordinal)
    if own { dense = sectionInferenceOrdinal(&resolved, &opened, chosen[at].ordinal) }
    if dense != usize.MAX {
      let selected = Binding {declaration: run Shared.make<DeclarationId>(run DeclarationId.copy(fresh)),
        ordinal: dense, value: Argument.copy(&chosen[at].value)}
      let lifetime = match &chosen[at].value { Argument.Lifetime {..} => true _ => false }
      if own && lifetime && holdLifetimes {
        run Vector.append<Binding>(&mut held.*, move selected)
      } else {
        run Vector.append<Binding>(&mut seed, move selected)
      }
    }
    at = at + usize.ONE
  }
  let remaining = match move run CallableContract.ofType(&copied.contract) {
    Option<CallableFacts>.Some {value} => Vector.length<Shared<Type>>(&value.parameters)
    _ => { return Result.failResult<Shared<Result<Answer, NoRejection>>, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.Unsupported, span)) }
  }
  let mut parameters = Vector.make<Shared<Type>>()
  at = usize.ZERO
  while at < remaining {
    let parameter = match move Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(&opened,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> { return signatureParameter(answer, at) }) {
      Option<Shared<Type>>.Some {value} => move value
      _ => { fail RevisionMismatch {} }
    }
    run Vector.append<Shared<Type>>(&mut parameters, run Type.applyBindings(&parameter, Vector.asSlice<Binding>(&seed), true))
    at = at + usize.ONE
  }
  let mut types = Vector.make<Shared<Type>>()
  let mut lifetimes = Vector.make<Shared<Lifetime>>()
  let mut rows = Vector.make<RowParameter>()
  at = usize.ZERO
  while at < facts.binders {
    let binder = Shared.with<Result<Answer, NoRejection>, Option<InferenceBinder>>(&opened,
      fn(answer: &Result<Answer, NoRejection>) -> Option<InferenceBinder> { return inferenceBinderAt(answer, at) })
    match move binder {
      Option<InferenceBinder>.Some {value: InferenceBinder.Type {value}} => { run Vector.append<Shared<Type>>(&mut types, move value) }
      Option<InferenceBinder>.Some {value: InferenceBinder.Lifetime {value}} => { run Vector.append<Shared<Lifetime>>(&mut lifetimes, move value) }
      Option<InferenceBinder>.Some {value: InferenceBinder.Row {value}} => { run Vector.append<RowParameter>(&mut rows, move value) }
      _ => { fail RevisionMismatch {} }
    }
    at = at + usize.ONE
  }
  let mut constraints = Vector.make<Constraint>()
  at = usize.ZERO
  while at < facts.constraints {
    let bound = Shared.with<Result<Answer, NoRejection>, Option<Constraint>>(&opened,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Constraint> { return signatureConstraintAt(answer, at) })
    if let Option<Constraint>.Some {value} = move bound {
      run Vector.append<Constraint>(&mut constraints, run bindConstraint(&value, Vector.asSlice<Binding>(&seed)))
    }
    at = at + usize.ONE
  }
  let value = memberSuccess(Value.Signature {signature: Signature {
    typeParameters: move types, callableParameterStart: facts.callableParameterStart,
    lifetimeParameters: move lifetimes, rowParameters: move rows, parameters: move parameters,
    constraints: move constraints, result: run Type.applyBindings(&facts.result, Vector.asSlice<Binding>(&seed), true),
    failure: run Type.applyBindings(&facts.failure, Vector.asSlice<Binding>(&seed), true),
    requirements: run Row.applyBindings(&facts.requirements, Vector.asSlice<Binding>(&seed), true),
    isEffect: facts.isEffect, isVariadic: facts.isVariadic, isUnsafe: facts.isUnsafe, isStatic: false,
    staticSlots: Vector.make<usize>(), environment: Option.none<Intersection>()}}, Vector.make<Dependency>())
  return Result.succeed<Shared<Result<Answer, NoRejection>>, Shared<Rejection>>(
    run Shared.make<Result<Answer, NoRejection>>(Result.succeed<Answer, NoRejection>(move value)))
}

// Complete immutable construction evidence with this invocation's fresh inference result.
// No application or function key is published while any deferred target slot is absent.
effect fn schemaCallableCall(resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, body: &Shared<TypedBody>, node: BodyNodeId, caller: &Application,
  callerBindings: &[Binding], projections: &[RuntimeProjection], inputs: CallableCallInputs, schema: Shared<SectionSchema>,
  captures: Vector<Shared<Type>>, fieldInputs: Vector<CallableFieldInput>, written: &[Shared<Type>]) -> Result<MirCallTarget, PreparationFailure>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let module = DeclarationId.moduleId(Application.bodyDeclaration(caller))
  let mut premises = match move run closedApplicationBounds(&mut resolver.*, &mut owner.*, &mut dependencies.*,
    caller, callerBindings, inputs.origin.span) {
    Option<Vector<Constraint>>.Some {value} => move value _ => { return Result.failResult<MirCallTarget, PreparationFailure>(PreparationFailure.Coverage {code: GapCode.TypedForm}) }
  }
  run retainedCallRelations(body, inputs.origin.span, callerBindings, &mut premises)
  let application = match move run schemaCallableApplication(&mut resolver.*, &mut owner.*, &mut dependencies.*,
    module, callerBindings, Vector.asSlice<Constraint>(&premises), &schema, written, inputs.origin.span) {
    Result<Application, PreparationFailure>.Success {value} => move value
    Result<Application, PreparationFailure>.Failure {error} => { return Result.failResult<MirCallTarget, PreparationFailure>(error) }
  }
  let mode = Shared.with<Type, CallableMode>(&sectionSchemaContract(&schema), callableInvocationMode)
  if DeclarationId.kind(Application.bodyDeclaration(&application)) == OwnerKind.Anonymous && Vector.length<CallableFieldInput>(&fieldInputs) == usize.ZERO {
    let environment = run Type.callableSchema(move schema, move captures, move fieldInputs)
    return run anonymousCallableCall(&mut resolver.*, &mut owner.*, &mut dependencies.*, body, node, caller,
      callerBindings, projections, move inputs, mode, move environment, run Shared.make<Application>(move application), written, false)
  }
  return run sectionCallableCall(&mut resolver.*, &mut owner.*, &mut dependencies.*, body, node, caller,
    callerBindings, projections, move inputs, mode, run Shared.make<Application>(move application), move captures, move fieldInputs, written)
}

// The region relations a body retained for one call's operands, those whose origin lies within
// the call, are premises of that call's bound proofs at lowering as they were at typing.
effect fn retainedCallRelations(body: &Shared<TypedBody>, span: Span, bindings: &[Binding], premises: &mut Vector<Constraint>) -> ()
! OutOfMemoryError ? &mut Allocator {
  let count = Shared.with<TypedBody, usize>(body, bodyObligationCount)
  let mut at = usize.ZERO
  while at < count {
    let found = Shared.with<TypedBody, Option<RetainedRelation>>(body,
      fn(value: &TypedBody) -> Option<RetainedRelation> { return retainedRelationAt(value, at) })
    if let Option<RetainedRelation>.Some {value: relation} = move found {
      if relation.span.start >= span.start && relation.span.end <= span.end {
        let premise = Constraint.Outlives {longer: Shared.clone<Lifetime>(&relation.offered),
          shorter: Shared.clone<Lifetime>(&relation.wanted)}
        run Vector.append<Constraint>(&mut premises.*, run bindConstraint(&premise, bindings))
      }
    }
    at = at + usize.ONE
  }
  // A region the instance binds to a lifetime parameter is valid for the whole call, so it covers
  // that parameter and, through it, every loan rooted in the body. Lowering proves bounds over
  // the bound regions while a body's own loans stay local, as they were at typing.
  at = usize.ZERO
  while at < bindings.length {
    if let Argument.Lifetime {value: region} = &bindings[at].value {
      let parameter = Lifetime.Parameter {declaration: run DeclarationId.copyShared(&bindings[at].declaration), ordinal: bindings[at].ordinal}
      run Vector.append<Constraint>(&mut premises.*, Constraint.Outlives {longer: Shared.clone<Lifetime>(&region),
        shorter: run Shared.make<Lifetime>(move parameter)})
    }
    at = at + usize.ONE
  }
  return ()
}

// One retained region relation and the source span of the value it admitted.
struct RetainedRelation {
  span: Span
  offered: Shared<Lifetime>
  wanted: Shared<Lifetime>
}

fn bodyObligationCount(body: &TypedBody) -> usize {
  let stage = TypedBody.checkingStage(body)
  if let BodyStage.ContractTyped {obligations} = &stage.* { return Vector.length<BodySafetyObligation>(&obligations) }
  return usize.ZERO
}

fn retainedRelationAt(body: &TypedBody, at: usize) -> Option<RetainedRelation> {
  let stage = TypedBody.checkingStage(body)
  if let BodyStage.ContractTyped {obligations} = &stage.* {
    let entries = Vector.asSlice<BodySafetyObligation>(&obligations)
    if at < entries.length {
      if let BodySafetyObligation.RegionRelation {origin, offered, wanted} = &entries[at] {
        return Option.some<RetainedRelation>(RetainedRelation {span: origin.span, offered: Shared.clone<Lifetime>(&offered),
          wanted: Shared.clone<Lifetime>(&wanted)})
      }
    }
  }
  return Option.none<RetainedRelation>()
}

// Whether a section's bounds hold under its inferred bindings and the caller's premises; a bound
// still naming an unbound binder of the section does not.
effect fn sectionApplicationBounds(resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, opened: &Shared<Result<Answer, NoRejection>>, fresh: &DeclarationId,
  inferred: &[Binding], declared: &Vector<Constraint>, module: &ModuleId, span: Span) -> bool
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let boundsCount = Shared.with<Result<Answer, NoRejection>, usize>(opened, signatureConstraintCount)
  let mut appliedBounds = Vector.make<Constraint>()
  let mut boundAt = usize.ZERO
  while boundAt < boundsCount {
    let bound = Shared.with<Result<Answer, NoRejection>, Option<Constraint>>(opened,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Constraint> { return signatureConstraintAt(answer, boundAt) })
    if let Option<Constraint>.Some {value} = move bound {
      let selected = run bindConstraint(&value, inferred)
      if run constraintMentionsOwner(&selected, fresh) { return false }
      run Vector.append<Constraint>(&mut appliedBounds, move selected)
    }
    boundAt = boundAt + usize.ONE
  }
  let failure = run proveAppliedBounds(&mut resolver.*, &mut owner.*, &mut dependencies.*, declared,
    Vector.asSlice<Constraint>(&appliedBounds), module, span)
  if let Option<Shared<Rejection>>.Some {..} = move failure { return false }
  return true
}

// Selects the original schema application from checked operand types, without replaying transfers.
effect fn schemaCallableApplication(resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, module: &ModuleId, callerBindings: &[Binding], premises: &[Constraint],
  schema: &Shared<SectionSchema>, supplied: &[Shared<Type>], span: Span) -> Result<Application, PreparationFailure>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let copied = run CallableSchema.copy(schema)
  let target = run DeclarationId.copyShared(&copied.target)
  let mut request = Request.make()
  let sourceSchema = match move run resolveTargetSchema(&mut resolver.*, &mut owner.*, &mut request,
    &mut dependencies.*, true, &target, span) {
    Option<TargetSchema>.Some {value} => move value
    _ => { return Result.failResult<Application, PreparationFailure>(PreparationFailure.Coverage {code: GapCode.TypedForm}) }
  }
  let fresh = run sectionInferenceOwner(&mut resolver.*, &target)
  // The section's own lifetimes stay open, held as evidence, so the bounds below can shorten an
  // environment binder exactly as the invocation's checking did (`shortenedEnvironmentBinder`).
  let mut held = Vector.make<Binding>()
  let opened = match move run sectionSchemaSignature(&mut resolver.*, &mut owner.*, &mut dependencies.*, schema, &fresh, module, span,
    true, &mut held) {
    Result<Shared<Result<Answer, NoRejection>>, Shared<Rejection>>.Success {value} => move value
    _ => { return Result.failResult<Application, PreparationFailure>(PreparationFailure.Coverage {code: GapCode.TypedForm}) }
  }
  let mut variables = Vector.make<Shared<DeclarationId>>()
  run Vector.append<Shared<DeclarationId>>(&mut variables, run Shared.make<DeclarationId>(run DeclarationId.copy(&fresh)))
  let mut inferred = Vector.make<Binding>()
  let evidence = Vector.asSlice<Binding>(&held)
  let mut heldAt = usize.ZERO
  while heldAt < evidence.length {
    run Vector.append<Binding>(&mut inferred, Binding {declaration: Shared.clone<DeclarationId>(&evidence[heldAt].declaration),
      ordinal: evidence[heldAt].ordinal, value: run Argument.applyBindings(&evidence[heldAt].value, callerBindings, true)})
    heldAt = heldAt + usize.ONE
  }
  let mut operandAt = usize.ZERO
  while operandAt < supplied.length {
    let pattern = match move Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(&opened,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> { return signatureParameter(answer, operandAt) }) {
      Option<Shared<Type>>.Some {value} => move value
      _ => { return Result.failResult<Application, PreparationFailure>(PreparationFailure.Coverage {code: GapCode.TypedForm}) }
    }
    let actual = run Type.applyBindings(&supplied[operandAt], callerBindings, true)
    run inferSectionCallableShape(&pattern, &actual, Vector.asSlice<Shared<DeclarationId>>(&variables), &mut inferred)
    operandAt = operandAt + usize.ONE
  }
  let freshIdentity = run Shared.make<DeclarationId>(run DeclarationId.copy(&fresh))
  let inferenceFailure = run inferFromProviderBounds(&mut resolver.*, &mut owner.*, &mut dependencies.*, module,
    &opened, &freshIdentity, premises, &mut inferred, span)
  if let Option<Shared<Rejection>>.Some {..} = move inferenceFailure {
    return Result.failResult<Application, PreparationFailure>(PreparationFailure.Coverage {code: GapCode.TypedForm})
  }
  let selectorFailure = run inferProvidedSelectors(&mut resolver.*, &mut owner.*, &mut dependencies.*, module,
    &opened, &freshIdentity, &fresh, premises, &mut inferred, span)
  if let Option<Shared<Rejection>>.Some {..} = move selectorFailure {
    return Result.failResult<Application, PreparationFailure>(PreparationFailure.Coverage {code: GapCode.TypedForm})
  }
  let declared = run copyConstraints(premises)
  let mut shortened = false
  let mut proved = run sectionApplicationBounds(&mut resolver.*, &mut owner.*, &mut dependencies.*, &opened, &fresh,
    Vector.asSlice<Binding>(&inferred), &declared, module, span)
  if !proved {
    // A piped Effect may retain a region the held environment binder does not cover; it shortens
    // to their meet exactly as the invocation's checking did, then the bounds are proved again.
    let captured = match move run sectionCapturedParameters(&mut resolver.*, &mut owner.*, &mut dependencies.*, schema,
      &fresh, module, span) {
      Result<Vector<Shared<Type>>, Shared<Rejection>>.Success {value} => move value
      _ => { return Result.failResult<Application, PreparationFailure>(PreparationFailure.Coverage {code: GapCode.TypedForm}) }
    }
    let noExplicit = Vector.make<usize>()
    let boundsCount = Shared.with<Result<Answer, NoRejection>, usize>(&opened, signatureConstraintCount)
    let mut boundAt = usize.ZERO
    while boundAt < boundsCount {
      let bound = Shared.with<Result<Answer, NoRejection>, Option<Constraint>>(&opened,
        fn(answer: &Result<Answer, NoRejection>) -> Option<Constraint> { return signatureConstraintAt(answer, boundAt) })
      if let Option<Constraint>.Some {value: Constraint.Represents {parameter: representation, contract}} = move bound {
        let source = run Type.applyBindings(&representation, Vector.asSlice<Binding>(&inferred), true)
        if run shortenedEnvironmentBinder(&mut resolver.*, &mut owner.*, &mut dependencies.*, &contract, &source, &opened,
          Vector.asSlice<Shared<Type>>(&captured), &fresh, Vector.asSlice<Shared<DeclarationId>>(&variables), &mut inferred,
          Vector.asSlice<usize>(&noExplicit), premises, span) {
          shortened = true
        }
      }
      boundAt = boundAt + usize.ONE
    }
    if shortened {
      proved = run sectionApplicationBounds(&mut resolver.*, &mut owner.*, &mut dependencies.*, &opened, &fresh,
        Vector.asSlice<Binding>(&inferred), &declared, module, span)
    }
  }
  if !proved { return Result.failResult<Application, PreparationFailure>(PreparationFailure.Coverage {code: GapCode.TypedForm}) }
  let mut bindings = Vector.make<Binding>()
  let selected = Vector.asSlice<Binding>(&copied.selected)
  let mut at = usize.ZERO
  while at < selected.length {
    // A held lifetime that the bounds shortened takes that region; every other selection is as bound.
    let mut value = Argument.copy(&selected[at].value)
    let own = Shared.with<DeclarationId, bool>(&selected[at].declaration,
      fn(declaration: &DeclarationId) -> bool { return DeclarationId.equals(declaration, &target) })
    let lifetime = match &selected[at].value { Argument.Lifetime {..} => true _ => false }
    if shortened && own && lifetime {
      let dense = sectionInferenceOrdinal(&sourceSchema, &opened, selected[at].ordinal)
      if let Option<Argument>.Some {value: settled} = move bindingArgument(Vector.asSlice<Binding>(&inferred), &fresh, dense) {
        value = move settled
      }
    }
    run Vector.append<Binding>(&mut bindings, Binding {declaration: Shared.clone<DeclarationId>(&selected[at].declaration),
      ordinal: selected[at].ordinal, value: move value})
    at = at + usize.ONE
  }
  let deferred = Vector.asSlice<usize>(&copied.deferred)
  at = usize.ZERO
  while at < deferred.length {
    let found = bindingArgument(Vector.asSlice<Binding>(&inferred), &fresh, sectionInferenceOrdinal(&sourceSchema, &opened, deferred[at]))
    let argument = match move found {
      Option<Argument>.Some {value} => run Argument.applyBindings(&value, callerBindings, true)
      _ => { return Result.failResult<Application, PreparationFailure>(PreparationFailure.Coverage {code: GapCode.TypedForm}) }
    }
    if run argumentMentionsOwner(&argument, &fresh) { return Result.failResult<Application, PreparationFailure>(PreparationFailure.Coverage {code: GapCode.TypedForm}) }
    run Vector.append<Binding>(&mut bindings, Binding {declaration: Shared.clone<DeclarationId>(&copied.target),
      ordinal: deferred[at], value: move argument})
    at = at + usize.ONE
  }
  let slots = Vector.asSlice<ApplicationSlot>(&sourceSchema.own)
  let mut arguments = Vector.make<Argument>()
  at = usize.ZERO
  while at < slots.length {
    let argument = match move bindingArgument(Vector.asSlice<Binding>(&bindings), &target, slots[at].ordinal) {
      Option<Argument>.Some {value} => move value
      _ => { return Result.failResult<Application, PreparationFailure>(PreparationFailure.Coverage {code: GapCode.TypedForm}) }
    }
    if run argumentMentionsOwner(&argument, &fresh) { return Result.failResult<Application, PreparationFailure>(PreparationFailure.Coverage {code: GapCode.TypedForm}) }
    run Vector.append<Argument>(&mut arguments, move argument)
    at = at + usize.ONE
  }
  let original = run sectionOriginalSignature(&mut resolver.*, &mut owner.*, &mut dependencies.*, &target, span)
  let scopes = match move run sectionScopeArguments(&sourceSchema, Vector.asSlice<Binding>(&bindings)) {
    Option<Vector<Argument>>.Some {value} => move value
    _ => { return Result.failResult<Application, PreparationFailure>(PreparationFailure.Coverage {code: GapCode.TypedForm}) }
  }
  let application = match move run checkedDirectApplication(&mut resolver.*, &mut owner.*, &mut request,
    &mut dependencies.*, &target, &original, move arguments, &scopes, module, span) {
    Result<Application, Shared<Rejection>>.Success {value} => move value
    _ => { return Result.failResult<Application, PreparationFailure>(PreparationFailure.Coverage {code: GapCode.TypedForm}) }
  }
  return Result.succeed<Application, PreparationFailure>(move application)
}

effect fn closedApplicationBounds(resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, caller: &Application, bindings: &[Binding], span: Span) -> Option<Vector<Constraint>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let signatureOwner = run Shared.make<DeclarationId>(run DeclarationId.copy(Application.bodyDeclaration(caller)))
  let location = match move run locationOfIdentity(&mut resolver.*, &signatureOwner) {
    Option<InstanceLocation>.Some {value} => value _ => { return Option.none<Vector<Constraint>>() }
  }
  let signature = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, Key {
    family: Family.Signature, module: location.module, name: usize.ZERO,
    declaration: location.declaration, member: usize.ZERO, external: false}, span)
  let facts = match move Shared.with<Result<Answer, NoRejection>, Option<SignatureFacts>>(&signature, signatureFacts) {
    Option<SignatureFacts>.Some {value} => move value
    _ => { return Option.none<Vector<Constraint>>() }
  }
  let count = facts.constraints
  let mut output = Vector.make<Constraint>()
  let mut at = usize.ZERO
  while at < count {
    let bound = Shared.with<Result<Answer, NoRejection>, Option<Constraint>>(&signature,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Constraint> { return signatureConstraintAt(answer, at) })
    if let Option<Constraint>.Some {value} = move bound { run Vector.append<Constraint>(&mut output, run bindConstraint(&value, bindings)) }
    at = at + usize.ONE
  }
  return Option.some<Vector<Constraint>>(move output)
}

// The finalized header retains only listed original slots. Optional phantom impl parameters
// remain absent, matching ordinary application admission, while hidden representations are own slots.
effect fn formalOpaqueApplication(resolver: &mut Resolver, module: &ModuleId, declaration: usize,
  producer: &DeclarationId, types: &[Shared<Type>], lifetimes: &[Shared<Lifetime>], rows: &[RowParameter]) -> Application
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let mut own = Vector.make<Argument>()
  let mut ownOrdinals = Vector.make<usize>()
  let mut scopes = Vector.make<ScopeBinding>()
  let mut identity = run DeclarationId.copy(producer)
  let mut ordinal = declaration
  while true {
    let mut selected = Vector.make<ApplicationSlot>()
    let mut at = usize.ZERO
    while at < types.length + lifetimes.length + rows.length {
      if let Option<ApplicationSlot>.Some {value} = move ownedSlot(types, lifetimes, rows, &identity, at) {
        run insertApplicationSlot(&mut selected, value)
      }
      at = at + usize.ONE
    }
    let slots = Vector.asSlice<ApplicationSlot>(&selected)
    let mut arguments = Vector.make<Argument>()
    at = usize.ZERO
    while at < slots.length {
      run Vector.append<Argument>(&mut arguments, run scopeArgument(&identity, slots[at].ordinal, slots[at].kind))
      at = at + usize.ONE
    }
    let ordinals = run applicationOrdinals(slots)
    if DeclarationId.equals(&identity, producer) { own = move arguments ownOrdinals = move ordinals }
    else if slots.length > usize.ZERO {
      run Vector.insert<ScopeBinding>(&mut scopes, usize.ZERO, ScopeBinding {
        owner: run Shared.make<DeclarationId>(run DeclarationId.copy(&identity)),
        arguments: move arguments, argumentOrdinals: move ordinals})
    }
    let parent = run enclosingIdentity(&mut resolver.*, module, ordinal)
    if let Option<DeclarationId>.Some {value} = move parent {
      identity = move value
      let shared = run Shared.make<DeclarationId>(run DeclarationId.copy(&identity))
      let found = run ordinalOfIdentity(&mut resolver.*, module, &shared)
      ordinal = match move found { Option<usize>.Some {value: next} => next _ => { fail RevisionMismatch {} } }
    } else { break }
  }
  return Application {target: SpecializationTarget.Named {declaration: run DeclarationId.copy(producer)},
    arguments: move own, argumentOrdinals: move ownOrdinals, scopes: move scopes, statics: Vector.make<StaticSlot>()}
}


fn nominalTestReferenceRegion(value: &Type) -> Option<Shared<Lifetime>> {
  if let Type.Reference {access, lifetime, ..} = &value.* {
    if access == Access.Shared { return Option.some<Shared<Lifetime>>(Shared.clone<Lifetime>(&lifetime)) }
  }
  return Option.none<Shared<Lifetime>>()
}

fn nominalTestBodyRegion(checked: &TypedBody) -> Option<Shared<Lifetime>> {
  let nodes = TypedBody.nodeSlice(checked)
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {ty, ..} = &nodes[at].kind {
      let borrowed = Shared.with<Type, Option<Shared<Lifetime>>>(&ty, nominalTestReferenceRegion)
      if let Option<Shared<Lifetime>>.Some {value} = move borrowed { return Option.some<Shared<Lifetime>>(move value) }
    }
    at = at + usize.ONE
  }
  return Option.none<Shared<Lifetime>>()
}

fn nominalTestParameterRegion(value: &Type) -> Option<Shared<Lifetime>> {
  if let Type.Nominal {arguments, ..} = &value.* {
    let listed = Vector.asSlice<Argument>(&arguments)
    if listed.length == usize.ONE {
      if let Argument.Lifetime {value: validity} = &listed[usize.ZERO] {
        return Option.some<Shared<Lifetime>>(Shared.clone<Lifetime>(&validity))
      }
    }
  }
  return Option.none<Shared<Lifetime>>()
}

// A caller-owned Local cannot be written as a source generic argument. This private actor test
// uses the real checked loan and source signatures, differing only in explicit-ordinal metadata.
effect fn nominalRegionExplicitOrdinalClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run ModuleId.make(b"memory", b"example", b"nominal-explicit-local.silk")
  let authored = Option.some<Bytes>(run Bytes.copy(b"struct Request<'a> { value: string<'a> }\nfn caller() -> i32 { let value = 1 let loan = &value return 0 }\nfn target<'a>(client: &'a i32, value: Request<'a>) -> i32 { return 42 }\nfn staticValue(value: Request<'static>) -> i32 { return 0 }\n"))
  let revision = run Revision.publish(&Revision.make(), &id, &authored)
  let mut store = Semantic.make(move revision, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu), Option.none<FinalProfile>())
  let mut request = Request.make()
  let inventory = run Semantic.demandSourceInventory(&mut store, &mut request, &id)
  let syntax = match move inventory {
    SourceInventory.Present {syntax, ..} => move syntax
    _ => { run Testing.expect(false, "the actual source census must be present") return () }
  }
  let functions = Vector.asSlice<NamedFunction>(&syntax.functions)
  run Testing.expect(functions.length == 3, "the source supplies exactly the caller and two real signatures")
  let caller = run DeclarationId.copy(&functions[usize.ZERO].declaration.identity)
  let declared = run DeclarationId.copy(&functions[usize.ONE].declaration.identity)
  run Testing.expect(DeclarationId.named(&caller, b"caller") && DeclarationId.named(&declared, b"target"),
    "caller and callee are full source-derived canonical identities")
  let answer = run Semantic.demandBody(&mut store, &mut request, &id, b"caller")
  let body = match move Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(&answer, answerTypedBody) {
    Option<Shared<TypedBody>>.Some {value} => move value
    _ => { run Testing.expect(false, "the loan comes from a genuinely successful checked body") return () }
  }
  let observed = Shared.with<TypedBody, Option<Shared<Lifetime>>>(&body, nominalTestBodyRegion)
  let region = match move observed {
    Option<Shared<Lifetime>>.Some {value} => move value
    _ => { run Testing.expect(false, "the checked caller retains its actual reference lifetime") return () }
  }
  run Testing.expect(callerLocalRegion(&region, &caller), "this is the actual caller's Local, not a foreign loan")
  let signature = run Semantic.demandSignature(&mut store, &mut request, &id, b"target")
  let original = match move Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(&signature,
    fn(value: &Result<Answer, NoRejection>) -> Option<Shared<Type>> { return signatureParameter(value, usize.ONE) }) {
    Option<Shared<Type>>.Some {value} => move value
    _ => { run Testing.expect(false, "the original parameter comes from the checked target header") return () }
  }
  let staticSignature = run Semantic.demandSignature(&mut store, &mut request, &id, b"staticValue")
  let evidence = match move Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(&staticSignature,
    fn(value: &Result<Answer, NoRejection>) -> Option<Shared<Type>> { return signatureParameter(value, usize.ZERO) }) {
    Option<Shared<Type>>.Some {value} => move value
    _ => { run Testing.expect(false, "the Static nominal is actual source signature evidence") return () }
  }
  let writtenRegion = match move Shared.with<Type, Option<Shared<Lifetime>>>(&original, nominalTestParameterRegion) {
    Option<Shared<Lifetime>>.Some {value} => move value
    _ => { run Testing.expect(false, "the original nominal has one actual lifetime slot") return () }
  }
  let ordinal = Shared.with<Lifetime, usize>(&writtenRegion,
    fn(value: &Lifetime) -> usize { return lifetimeOrdinalOf(value, &declared) })
  run Testing.expect(ordinal != usize.MAX, "the explicit slot is the original source callee's actual lifetime ordinal")
  let fresh = run DeclarationId.inference(&declared, b"explicit-local-negative")
  let parameter = run Type.renameParameters(&original, &declared, &fresh)
  let mut variables = Vector.make<Shared<DeclarationId>>()
  let variable = run Shared.make<DeclarationId>(run DeclarationId.copy(&fresh))
  run Vector.append<Shared<DeclarationId>>(&mut variables, Shared.clone<DeclarationId>(&variable))
  let mut bindings = Vector.make<Binding>()
  run Vector.append<Binding>(&mut bindings, Binding {declaration: Shared.clone<DeclarationId>(&variable),
    ordinal: ordinal, value: Argument.Lifetime {value: Shared.clone<Lifetime>(&region)}})
  let pattern = run Type.applyBindings(&parameter, Vector.asSlice<Binding>(&bindings), true)
  let initialSlice = Vector.asSlice<Binding>(&bindings)
  let initialBinding = &initialSlice[usize.ZERO]
  let mut originalProof = Vector.make<Binding>()
  run Vector.append<Binding>(&mut originalProof, Binding {declaration: Shared.clone<DeclarationId>(&initialBinding.declaration),
    ordinal: initialBinding.ordinal, value: Argument.copy(&initialBinding.value)})
  let originalFailure = run Type.unify(&parameter, &evidence, Vector.asSlice<Shared<DeclarationId>>(&variables), Comparison.Exact, &mut originalProof)
  run Testing.expect(match &originalFailure { Unification.Unified => false _ => true }, "the implicit operand starts with a real exact mismatch")
  let mut dependencies = Vector.make<Dependency>()
  let mut explicit = Vector.make<usize>()
  let premises = Vector.make<Constraint>()
  let implicit = run relatedCallArgument(&mut store.resolver, &mut store.query, &mut dependencies,
    &parameter, &pattern, &evidence, &fresh, &caller, Vector.asSlice<Shared<DeclarationId>>(&variables),
    Vector.asSlice<Binding>(&bindings), Vector.asSlice<usize>(&explicit), Vector.asSlice<Constraint>(&premises), Span.make(usize.ZERO, usize.ONE))
  let mut implicitProven = false
  if let Option<RelatedArgument>.Some {value} = &implicit {
    implicitProven = Vector.length<RegionPair>(&value.relations) == usize.ZERO
  }
  run Testing.expect(implicitProven,
    "the implicit slot has a real tracked covariant member proof, and Static storage needs no open relation")
  run Testing.expect(Vector.length<Dependency>(&dependencies) > usize.ZERO, "the proof retains actual member-query dependencies")
  run Vector.append<usize>(&mut explicit, ordinal)
  let fixed = run relatedCallArgument(&mut store.resolver, &mut store.query, &mut dependencies,
    &parameter, &pattern, &evidence, &fresh, &caller, Vector.asSlice<Shared<DeclarationId>>(&variables),
    Vector.asSlice<Binding>(&bindings), Vector.asSlice<usize>(&explicit), Vector.asSlice<Constraint>(&premises), Span.make(usize.ZERO, usize.ONE))
  // A written slot never moves, but Static storage still meets it by proven covariant subtyping.
  let mut fixedProven = false
  if let Option<RelatedArgument>.Some {value} = &fixed {
    fixedProven = Vector.length<RegionPair>(&value.relations) == usize.ZERO && run Type.equalsShared(&value.ty, &pattern)
  }
  run Testing.expect(fixedProven,
    "an explicitly fixed caller-local slot admits Static storage at exactly that slot with no open relation")
  run Testing.expect(Vector.length<Binding>(&bindings) == usize.ONE, "candidate proofs never append real inference bindings")
  let retainedSlice = Vector.asSlice<Binding>(&bindings)
  let retained = &retainedSlice[usize.ZERO]
  let unchanged = match &retained.value {
    Argument.Lifetime {value} => Lifetime.equalsShared(&value, &region)
    _ => false
  }
  run Testing.expect(unchanged, "candidate proofs never replace the real caller-local binding")
  let mut proof = Vector.make<Binding>()
  run Vector.append<Binding>(&mut proof, Binding {declaration: Shared.clone<DeclarationId>(&retained.declaration), ordinal: retained.ordinal,
    value: Argument.copy(&retained.value)})
  let rejected = run Type.unify(&parameter, &evidence, Vector.asSlice<Shared<DeclarationId>>(&variables), Comparison.Exact, &mut proof)
  run Testing.expect(match &rejected { Unification.Unified => false _ => true }, "the original Static operand still fails exact inference")
  return ()
}

test effect fn nominalRegionRelationExcludesExplicitCallerLocal() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run nominalRegionExplicitOrdinalClaims() |> Effect.provideMut<Allocator>(&mut allocator)
  return ()
}

fn iterationFactCount(iterations: &Vector<IterationFacts>) -> usize { return Vector.length<IterationFacts>(iterations) }

effect fn iterationCalls(iterations: &Shared<Vector<IterationFacts>>, ordinal: usize) -> Vector<ResolvedCall>
! OutOfMemoryError ? &mut Allocator {
  let count = Shared.with<Vector<IterationFacts>, usize>(iterations, fn(value: &Vector<IterationFacts>) -> usize {
    let entries = Vector.asSlice<IterationFacts>(value)
    return Vector.length<ResolvedCall>(&entries[ordinal].calls)
  })
  let mut copied = Vector.make<ResolvedCall>()
  let mut at = usize.ZERO
  while at < count {
    // The callback only borrows one stored fact; its owned copy is made outside the borrow.
    let target = Shared.with<Vector<IterationFacts>, Option<SelectionFact>>(iterations, fn(value: &Vector<IterationFacts>) -> Option<SelectionFact> {
      let entries = Vector.asSlice<IterationFacts>(value)
      let calls = Vector.asSlice<ResolvedCall>(&entries[ordinal].calls)
      return selectedFact(calls, calls[at].id)
    })
    let id = Shared.with<Vector<IterationFacts>, HirId>(iterations, fn(value: &Vector<IterationFacts>) -> HirId {
      let entries = Vector.asSlice<IterationFacts>(value)
      return Vector.asSlice<ResolvedCall>(&entries[ordinal].calls)[at].id
    })
    if let Option<SelectionFact>.Some {value} = move target {
      run Vector.append<ResolvedCall>(&mut copied, ResolvedCall {id: id, result: Result.succeed<ResolvedTarget, Shared<Rejection>>(ResolvedTarget.Selected {fact: move value})})
    }
    at = at + usize.ONE
  }
  return move copied
}

// Scope identity is the original for plus ordinal; node/local ranges authenticate all generated
// ordinary operations. No HIR cloning, source-span perturbation, or runtime iteration survives.
effect fn checkStaticFor(resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>, request: &mut Request,
  dependencies: &mut Vector<Dependency>, module: &ModuleId, cursor: &AuthoredCursor, caller: &DeclarationId,
  locals: &mut Vector<BodyLocal>, annotations: &[ResolvedAnnotation], calls: &[ResolvedCall], nodes: &mut Vector<BodyNode>,
  signatures: &mut Vector<SignatureDependency>, requiredBodies: &mut Vector<DeclarationId>, statement: HirId, body: HirId,
  resultType: &Shared<Type>, constraints: &[Constraint], contractBody: bool, staticBody: bool, loopDepth: usize, unsafeAllowed: bool)
-> Result<CheckedControl, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let selected = selectedFact(calls, statement)
  let iterations = match move selected {
    Option<SelectionFact>.Some {value: SelectionFact.StaticFor {iterations}} => iterations
    _ => { return Result.failResult<CheckedControl, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.Unsupported, run bodySpan(&resolver.source, cursor, statement))) }
  }
  let length = Shared.with<Vector<IterationFacts>, usize>(&iterations, iterationFactCount)
  let mut retained = Vector.make<BodyNodeId>()
  let mut ordinal = usize.ZERO
  while ordinal < length {
    let mut annotationIds = Vector.make<HirId>()
    let mut writtenCalls = Vector.make<CallSyntax>()
    let mut declaration = usize.MAX
    if let Option<&IndexedSource>.Some {value: indexed} = move SourceIndex.sourceAtCursor(&resolver.source, cursor) {
      let hir = IndexedSource.authored(indexed)
      let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(indexed))
      let mut at = usize.ZERO
      while at < declarations.length {
        if DeclarationId.equals(&declarations[at].identity, caller) { declaration = at }
        at = at + usize.ONE
      }
      if let Node.Block {statements} = Module.node(hir, body) { run collectBodySyntax(hir, statements, &mut annotationIds, &mut writtenCalls) }
    }
    if declaration == usize.MAX { fail InvalidModulePath {} }
    let moduleOrdinal = knownModuleOrdinal(&resolver.*, module)
    let resolved = run resolveBodyFacts(&mut resolver.*, &mut owner.*, &mut dependencies.*, module,
      moduleOrdinal, declaration, &annotationIds, &writtenCalls)
    let facts = match move resolved {
      Result<BodyFacts, Shared<Rejection>>.Success {value} => value
      Result<BodyFacts, Shared<Rejection>>.Failure {error} => { return Result.failResult<CheckedControl, Shared<Rejection>>(move error) }
    }
    let BodyFacts {annotations: selectedAnnotations, calls: ordinaryCalls} = move facts
    let mut scopedCalls = run iterationCalls(&iterations, ordinal)
    // Copy ordinary targets after the occurrence's selected facts, so selection always wins.
    let targets = Vector.asSlice<ResolvedCall>(&ordinaryCalls)
    let mut at = usize.ZERO
    while at < targets.length {
      let target = match &targets[at].result {
        Result<ResolvedTarget, Shared<Rejection>>.Success {value} => Result.succeed<ResolvedTarget, Shared<Rejection>>(run copyResolvedTarget(&value))
        Result<ResolvedTarget, Shared<Rejection>>.Failure {error} => Result.failResult<ResolvedTarget, Shared<Rejection>>(Shared.clone<Rejection>(&error))
      }
      run Vector.append<ResolvedCall>(&mut scopedCalls, ResolvedCall {id: targets[at].id, result: move target})
      at = at + usize.ONE
    }
    let nodeStart = Vector.length<BodyNode>(&nodes.*)
    let localStart = Vector.length<BodyLocal>(&locals.*)
    let checked = run checkBlock(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module, cursor, caller,
      &mut locals.*, Vector.asSlice<ResolvedAnnotation>(&selectedAnnotations), Vector.asSlice<ResolvedCall>(&scopedCalls),
      &mut nodes.*, &mut signatures.*, &mut requiredBodies.*, body, resultType, constraints, contractBody, staticBody, loopDepth, unsafeAllowed)
    let control = match move checked {
      Result<CheckedControl, Shared<Rejection>>.Success {value} => value
      Result<CheckedControl, Shared<Rejection>>.Failure {error} => { return Result.failResult<CheckedControl, Shared<Rejection>>(move error) }
    }
    let end = Vector.length<BodyNode>(&nodes.*)
    let refusal = run generatedLoan(&nodes.*, nodeStart, end, caller)
    if let Option<Span>.Some {value} = move refusal {
      return Result.failResult<CheckedControl, Shared<Rejection>>(run rejectIteration(&resolver.*, module, RejectionCode.Unsupported, value, run bodySpan(&resolver.source, cursor, statement), ordinal))
    }
    run recordOccurrence(&mut resolver.*, SelectedFact.Iteration {syntax: statement, ordinal: ordinal,
      nodeStart: nodeStart, nodeEnd: end, localStart: localStart, localEnd: Vector.length<BodyLocal>(&locals.*)})
    run Vector.append<BodyNodeId>(&mut retained, control.node)
    ordinal = ordinal + usize.ONE
  }
  let node = BodyNodeId {index: Vector.length<BodyNode>(&nodes.*)}
  run Vector.append<BodyNode>(&mut nodes.*, BodyNode {origin: BodyOrigin {syntax: statement, span: run bodySpan(&resolver.source, cursor, statement)},
    kind: BodyNodeKind.Block {statements: move retained, canComplete: true}})
  return Result.succeed<CheckedControl, Shared<Rejection>>(CheckedControl {node: node, canComplete: true})
}

effect fn recordOccurrence(resolver: &mut Resolver, fact: SelectedFact) -> () ! OutOfMemoryError ? &mut Allocator {
  let popped = Vector.pop<BodyFrame>(&mut resolver.bodies)
  if let Option<BodyFrame>.Some {value} = move popped {
    let mut frame = move value
    run Vector.append<SelectedFact>(&mut frame.occurrences, move fact)
    run Vector.append<BodyFrame>(&mut resolver.bodies, move frame)
  }
  return ()
}

effect fn takeOccurrenceFacts(resolver: &mut Resolver, output: &mut Vector<SelectedFact>) -> () ! OutOfMemoryError ? &mut Allocator {
  let popped = Vector.pop<BodyFrame>(&mut resolver.bodies)
  if let Option<BodyFrame>.Some {value} = move popped {
    let mut frame = move value
    let facts = Vector.asSlice<SelectedFact>(&frame.occurrences)
    let mut at = usize.ZERO
    while at < facts.length {
      if let SelectedFact.Iteration {syntax, ordinal, nodeStart, nodeEnd, localStart, localEnd} = &facts[at] {
        run Vector.append<SelectedFact>(&mut output.*, SelectedFact.Iteration {syntax: syntax, ordinal: ordinal,
          nodeStart: nodeStart, nodeEnd: nodeEnd, localStart: localStart, localEnd: localEnd})
      }
      at = at + usize.ONE
    }
    run Vector.append<BodyFrame>(&mut resolver.bodies, move frame)
  }
  return ()
}

// The supported expansion carries existing outside loans unchanged. A newly generated loan
// still lacks an occurrence-aware region key, so it must refuse before publishing this body.
effect fn generatedLoan(nodes: &Vector<BodyNode>, start: usize, end: usize, caller: &DeclarationId) -> Option<Span>
! OutOfMemoryError ? &mut Allocator {
  let written = Vector.asSlice<BodyNode>(nodes)
  let mut at = start
  while at < end {
    if let BodyNodeKind.Expression {ty, ..} = &written[at].kind {
      let mut regions = Vector.make<Shared<Lifetime>>()
      let representations = Vector.make<Option<Shared<Type>>>()
      let known = run Type.retainedRegions(&ty, caller, Vector.asSlice<Option<Shared<Type>>>(&representations), &mut regions)
      drop known
      let captured = Vector.asSlice<Shared<Lifetime>>(&regions)
      let mut regionAt = usize.ZERO
      while regionAt < captured.length {
        let ordinal = Shared.with<Lifetime, usize>(&captured[regionAt], fn(region: &Lifetime) -> usize {
          return match &region.* {
            Lifetime.Local {declaration, ordinal: localOrdinal} => {
              if DeclarationId.equals(&declaration, caller) { return localOrdinal }
              return usize.MAX
            }
            _ => usize.MAX
          }
        })
        if ordinal != usize.MAX {
          let mut generated = start
          while generated < end {
            if written[generated].origin.syntax.index == ordinal { return Option.some<Span>(written[generated].origin.span) }
            generated = generated + usize.ONE
          }
        }
        regionAt = regionAt + usize.ONE
      }
    }
    at = at + usize.ONE
  }
  return Option.none<Span>()
}

// The diagnostic keeps the authored failure span and original static-for ordinal; generated
// identities are never synthesized as source declarations or encoded by changing byte spans.
effect fn rejectIteration(resolver: &Resolver, module: &ModuleId, code: RejectionCode, span: Span,
  forSpan: Span, ordinal: usize) -> Shared<Rejection> ! OutOfMemoryError ? &mut Allocator {
  let mut arguments = Vector.make<Shared<StaticData>>()
  run Vector.append<Shared<StaticData>>(&mut arguments, run Shared.make<StaticData>(StaticData.Integer {
    ty: StaticIntegerType.Usize, sign: StaticSign.Positive, magnitude: usize.toU64(ordinal),
  }))
  let mut trace = Vector.make<StaticExecution.TraceStep>()
  // The original HIR id is source identity, while the primary diagnostic span stays authored.
  // Static selection owns the for's source observation; it cannot be a synthetic binder.
  run Vector.append<StaticExecution.TraceStep>(&mut trace, StaticExecution.TraceStep {
    name: run Bytes.copy(b"static for"), arguments: move arguments, span: forSpan,
  })
  let failure = StaticDiagnostic {fault: StaticFault.Unsupported, code: b"SEM0176", span: span, target: resolver.target,
    message: Option.none<Bytes>(), origin: Option.none<Span>(), byteOffset: Option.none<u64>(),
    rejection: Option.none<Shared<Rejection>>(), needed: Option.none<StaticNeeded>(),
    missing: Option.none<StaticExecution.MissingFact>(), trace: move trace}
  return run Shared.make<Rejection>(Rejection {
    code: code, module: run ModuleId.copy(module), span: span, related: Option.none<RelatedSite>(),
    path: Vector.make<Shared<DeclarationId>>(), expected: usize.ZERO, supplied: usize.ZERO,
    parameterName: Bytes.make(), expectedKind: GenericKind.Type, suppliedKind: GenericKind.Type,
    witness: Option.none<WitnessProblem>(), termination: TerminationStep.Peer,
    staticFailure: Option.some<StaticDiagnostic>(move failure), specialization: Vector.make<Application>(),
  })
}
